DIFF 2/3 : tools/fs/actionGroups/writeActions.js — add fsWriteBinary action
--------------------------------------------------------------------------------
--- a/geelooy/apps/tunnel/agent/tools/fs/actionGroups/writeActions.js
+++ b/geelooy/apps/tunnel/agent/tools/fs/actionGroups/writeActions.js
@@ const {
 	writeText,
 	normalizeWriteSpecifications,
 	describeWritePayload
 } = require("../readWrite.js");
+const { writeBytes } = require("../readWrite.js");
 const { replaceRange, applyPatch } = require("../searchEdit.js");
 const { writeIfHash, bulkWriteIfHashes } = require("../hashWrite.js");
 const { verifyJsFile, verifyJsRuntime } = require("../jsWriteVerifier.js");
 const Batch = require("../writeBatchTransaction.js");
+
+/**
+ * Per-call raw-byte cap. Agent local-api-limits.js allows 16 MB JSON bodies;
+ * 12 MB raw keeps us under it after ~33% base64 inflation, with headroom.
+ * The tunnel control plane may enforce a smaller limit — clients should
+ * chunk (e.g. 4-8 MB) until the real ceiling is measured (see test plan).
+ */
+const MAX_BINARY_WRITE_BYTES = 12 * 1024 * 1024;
 
 /**
  * @file Routes single and multi-file writes through verified replacement vessels.
@@ - handleBulkWrite(config, payload, action) {
 	}
 }
 
+/**
+ * Native binary write: base64 -> Buffer -> atomic disk write, single request.
+ * Deliberately skips the JS verification pipeline (attachVerification) —
+ * that machinery is for text/JS writes; binary payloads are not JS.
+ * Security posture is IDENTICAL to the existing `write` action: same
+ * fsWrite/allowWrite gates, same safePath(), same assertNotSecret().
+ */
+async function handleWriteBinary(config, payload, action) {
+	if (!config.tools.fsWrite) throw new Error("fsWrite disabled.");
+	const targetPath = payload.path || payload.p;
+	if (!targetPath || typeof targetPath !== "string") {
+		throw new Error("writeBinary_missing_path");
+	}
+	const b64 = payload.contentBase64 ?? payload.content64 ?? payload.base64;
+	if (typeof b64 !== "string" || b64.length === 0) {
+		throw new Error("writeBinary_missing_contentBase64");
+	}
+	let buffer;
+	try {
+		buffer = Buffer.from(b64, "base64");
+	} catch {
+		throw new Error("writeBinary_invalid_base64");
+	}
+	if (buffer.length === 0) throw new Error("writeBinary_empty_content");
+	if (buffer.length > MAX_BINARY_WRITE_BYTES) {
+		throw new Error("writeBinary_too_large");
+	}
+	const wrote = await writeBytes(config, targetPath, buffer);
+	return {
+		ok: true,
+		action,
+		path: targetPath,
+		bytesWritten: wrote.bytesWritten,
+		root: config.root
+	};
+}
+
 async function handleOneWrite(config, payload, action, targetPath) {
 	const content = payload.content !== undefined ? payload.content : payload.text;
 	const wrote = await writeText(config, targetPath, content ?? "");
@@ function buildWriteActions({ config, payload }) {
 	const action = payload.action || "list";
 	const targetPath = payload.path || payload.p || ".";
 	return {
 		write: async () => consolidatedWrite(config, payload, action, targetPath),
 		bulkWrite: async () => handleBulkWrite(config, payload, action),
 		writeIfHash: async () => writeIfHash(config, payload),
 		bulkWriteIfHashes: async () => bulkWriteIfHashes(config, payload),
+		// Native binary write. `writeBinary` matches the existing /^write/i
+		// -> "files" family rule (reachable with zero server change);
+		// `fsWriteBinary` is the requested canonical name (needs the
+		// agent-side family rule in DIFF 3/3, plus the server mirror).
+		writeBinary: async () => handleWriteBinary(config, payload, "writeBinary"),
+		fsWriteBinary: async () => handleWriteBinary(config, payload, "fsWriteBinary"),
 		replaceRange: async () => ({ root: config.root, ...(await replaceRange(config, payload)) }),
 		applyPatch: async () => ({ root: config.root, ...(await applyPatch(config, payload)) })
 	};
 }

