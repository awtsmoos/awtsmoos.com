DIFF 1/3 : tools/fs/readWrite.js  — add writeBytes()
--------------------------------------------------------------------------------
--- a/geelooy/apps/tunnel/agent/tools/fs/readWrite.js
+++ b/geelooy/apps/tunnel/agent/tools/fs/readWrite.js
@@ async function writeText(config, targetPath, content, options = {}) {
 	if (!config.tools.fsWrite) throw new Error("fsWrite disabled.");
 	if (!config.allowWrite) throw new Error("Writes disabled.");
 	const full = safePath(config, targetPath);
 	assertNotSecret(config, full);
 	const proof = await replaceFile(full, String(content ?? ""), options);
 	return {
 		...proof,
 		path: targetPath
 	};
 }
 
+/**
+ * Binary counterpart to writeText: writes a Buffer atomically with the
+ * identical guards (fsWrite tool gate, allowWrite, safePath, assertNotSecret).
+ * replaceFile() already accepts Buffers and does temp-file + fsync +
+ * atomic rename, so this is a thin, safe wrapper — no shell involved.
+ */
+async function writeBytes(config, targetPath, buffer, options = {}) {
+	if (!config.tools.fsWrite) throw new Error("fsWrite disabled.");
+	if (!config.allowWrite) throw new Error("Writes disabled.");
+	if (!Buffer.isBuffer(buffer)) throw new Error("writeBytes_requires_buffer");
+	const full = safePath(config, targetPath);
+	assertNotSecret(config, full);
+	const proof = await replaceFile(full, buffer, options);
+	return {
+		...proof,
+		path: targetPath,
+		bytesWritten: buffer.length
+	};
+}
+
 module.exports = {
 	describeWritePayload: Payload.describeWritePayload,
 	normalizeWrite: Payload.normalizeWrite,
 	normalizeWriteSpecifications: Payload.normalizeWriteSpecifications,
 	normalizeWrites: Payload.normalizeWrites,
 	number: boundedNumber,
 	parseMaybeJson: Payload.parseMaybeJson,
 	readBytesBase64,
 	readText,
 	readTextFromBytes,
 	requestTooLargeGuidance,
+	writeBytes,
 	writeText
 };

