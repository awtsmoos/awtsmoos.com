#!/usr/bin/env bash
# B"H
# Boruch Hashem
# Blessed is He

# The Awtsmoos makes the emergency doorway short while Awtsmoos.com keeps every deeper guard intact.
set -euo pipefail
ROOT="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
NODE_BIN="${AWTSMOOS_NODE_BIN:-}"
if [ -z "$NODE_BIN" ] && [ -x "$ROOT/runtime/node/bin/node" ]; then
	NODE_BIN="$ROOT/runtime/node/bin/node"
fi
if [ -z "$NODE_BIN" ]; then
	NODE_BIN="$(command -v node || true)"
fi
if [ -z "$NODE_BIN" ]; then
	echo "ERROR node_not_found" >&2
	exit 1
fi
exec "$NODE_BIN" "$ROOT/scripts/awt.cjs" "$@"
