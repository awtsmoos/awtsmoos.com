		},
		{
			"level": 2,
			"text": "Lane 1: Simple Tunnel — Poll (BASELINE, permanent)",
			"anchor": "lane-1-simple-tunnel-poll-baseline-permanent"
		},
		{
			"level": 1,
			"text": "1. Queue a command (from anywhere):",
			"anchor": "1-queue-a-command-from-anywhere"
		},
		{
			"level": 1,
			"text": "Returns: {\"ok\":true,\"id\":\"cmd123...\"}",
			"anchor": "returns-ok-true-id-cmd123"
		},
		{
			"level": 1,
			"text": "2. Get the result (after 5 seconds):",
			"anchor": "2-get-the-result-after-5-seconds"
		},
		{
			"level": 1,
			"text": "Returns: {\"ok\":true,\"done\":true,\"output\":\"...\"}",
			"anchor": "returns-ok-true-done-true-output"
		},
		{
			"level": 1,
			"text": "Target a command to a specific agent (by TUNNELAGENTID):",
			"anchor": "target-a-command-to-a-specific-agent-by-tunnelagentid"
		},
		{
			"level": 1,
			"text": "Only the agent with TUNNELAGENTID=my-macbook will pick it up.",
			"anchor": "only-the-agent-with-tunnelagentid-my-macbook-will-pick-it-up"
		},
		{
			"level": 1,
			"text": "If agentId is omitted, any agent can pick it up.",
			"anchor": "if-agentid-is-omitted-any-agent-can-pick-it-up"
		},
		{
			"level": 1,
			"text": "The agent identifies itself with TUNNELAGENTID (defaults to hostname):",
			"anchor": "the-agent-identifies-itself-with-tunnelagentid-defaults-to-hostname"
		},
		{
			"level": 1,
			"text": "Env vars: TUNNELSERVER, TUNNELSECRET, TUNNELAGENTID, TUNNELQUEUEFILE, TUNNELPOLLMS",
			"anchor": "env-vars-tunnelserver-tunnelsecret-tunnelagentid-tunnelqueuefile-tunnelpollms"
		},
		{
			"level": 2,
			"text": "Lane 2: Simple Tunnel — Approval",
			"anchor": "lane-2-simple-tunnel-approval"
		},
		{
			"level": 1,
			"text": "1. Agent requests approval (on target machine):",
			"anchor": "1-agent-requests-approval-on-target-machine"
		},
		{
			"level": 1,
			"text": "Output: \"Waiting for approval...\"",
			"anchor": "output-waiting-for-approval"
		},
		{
			"level": 1,
			"text": "2. Approve (on server, via any command lane):",
			"anchor": "2-approve-on-server-via-any-command-lane"
		},
		{
			"level": 1,
			"text": "3. Agent starts polling. Then use Lane 1 commands.",
			"anchor": "3-agent-starts-polling-then-use-lane-1-commands"
		},
		{
			"level": 2,
			"text": "Lane 3: Simple Tunnel — WebSocket",
			"anchor": "lane-3-simple-tunnel-websocket"
		},
		{
			"level": 1,
			"text": "Tries WebSocket first, falls back to HTTP polling automatically.",
			"anchor": "tries-websocket-first-falls-back-to-http-polling-automatically"
		},
		{
			"level": 2,
			"text": "Lane 4: Simple Tunnel — Pure File (zero HTTP)",
			"anchor": "lane-4-simple-tunnel-pure-file-zero-http"
		},
		{
			"level": 1,
			"text": "1. Write command file (on target machine, or via another lane):",
