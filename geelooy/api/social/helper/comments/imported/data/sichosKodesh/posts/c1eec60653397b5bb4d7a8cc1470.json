desh_5744_57440426_3ce1e3dd_s1_p2","content":"for you are the true soldiers of the House of David,","verseSection":"1","subsectionId":"2","sourceHebrew":"וואס איר זייט די אמת'ע חיילי בית דוד,","dayuh":{"kind":"translation","verseSection":"1","subSection":3,"sourceHebrew":"וואס איר זייט די אמת'ע חיילי בית דוד,","language":"en","documentId":"c12dTB8UMOljS7zDKEKE","sourcePath":"books/Sichos Kodesh/Farbrengens/c12dTB8UMOljS7zDKEKE","productionMappingMethod":"unique-normalized-title"}},{"id":"BH_sk_translation_en_sichosKodesh_5744_57440426_3ce1e3dd_s1_p3","content":"and also \"lamps to illuminate\"<sup>5</sup> to bring down all the lights of all the Rebbes,","verseSection":"1","subsectionId":"3","sourceHebrew":"און אויך \"נרות להאיר\" 5 אויף אראפברענגען די אלע אורות פון אלע רביים,","dayuh":{"kind":"translation","verseSection":"1","subSection":4,"sourceHebrew":"און אויך \"נרות להאיר\" 5 אויף אראפברענגען די אלע אורות פון אלע רביים,","language":"en","documentId":"c12dTB8UMOljS7zDKEKE","sourcePath":"books/Sichos Kodesh/Farbrengens/c12dTB8UMOljS7zDKEKE","productionMappingMethod":"unique-normalized-title"}},{"id":"BH_sk_translation_en_sichosKodesh_5744_57440426_3ce1e3dd_s1_p4","content":"especially from the baal hahillula of 24 Teves,","verseSection":"1","subsectionId":"4","sourceHebrew":"בפרט פון דעם בעל ההילולא פון כ\"ד טבת,","dayuh":{"kind":"translation","verseSection":"1","subSection":5,"sourceHebrew":"בפרט פון דעם בעל ההילולא פון כ\"ד טבת,","language":"en","documentId":"c12dTB8UMOljS7zDKEKE","sourcePath":"books/Sichos Kodesh/Farbrengens/c12dTB8UMOljS7zDKEKE","productionMappingMethod":"unique-normalized-title"}},{"id":"BH_sk_translation_en_sichosKodesh_5744_57440426_3ce1e3dd_s1_p5","content":"and the baal hahillula of the Tenth of Shevat –","verseSection":"1","subsectionId":"5","sourceHebrew":"און דער בעל ההילולא פון עשירי בשבט –","dayuh":{"kind":"translation","verseSection":"1","subSection":6,"sourceHebrew":"און דער בעל ההילולא פון עשירי בשבט –","language":"en","documentI