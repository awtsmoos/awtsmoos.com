Section":3,"sourceHebrew":"און מ'וועט עס איצטער נאכאמאל מאכן שטייענדיק בסוף השנה (וכ\"ק אדמו\"ר שליט\"א אמר נוסח הפרוזבל).","language":"en","documentId":"j1cZbrvaP3Cow4wHZZq2","sourcePath":"books/Sichos Kodesh/Farbrengens/j1cZbrvaP3Cow4wHZZq2","productionMappingMethod":"unique-normalized-title"}},{"id":"BH_sk_translation_en_sichosKodesh_5747_57471329_7439f7e7_s1_p0","content":"Afterwards he said:","verseSection":"1","subsectionId":"0","sourceHebrew":"אח\"כ אמרן:","dayuh":{"kind":"translation","verseSection":"1","subSection":1,"sourceHebrew":"אח\"כ אמרן:","language":"en","documentId":"j1cZbrvaP3Cow4wHZZq2","sourcePath":"books/Sichos Kodesh/Farbrengens/j1cZbrvaP3Cow4wHZZq2","productionMappingMethod":"unique-normalized-title"}},{"id":"BH_sk_translation_en_sichosKodesh_5747_57471329_7439f7e7_s2_p0","content":"Thank you. May it be a good and sweet year,","verseSection":"2","subsectionId":"0","sourceHebrew":"יישר כח. עס זאל זיין א שנה טובה ומתוקה,","dayuh":{"kind":"translation","verseSection":"2","subSection":1,"sourceHebrew":"יישר כח. עס זאל זיין א שנה טובה ומתוקה,","language":"en","documentId":"j1cZbrvaP3Cow4wHZZq2","sourcePath":"books/Sichos Kodesh/Farbrengens/j1cZbrvaP3Cow4wHZZq2","productionMappingMethod":"unique-normalized-title"}},{"id":"BH_sk_translation_en_sichosKodesh_5747_57471329_7439f7e7_s2_p1","content":"and especially since the eve of Rosh Hashanah connects a Shemittah year","verseSection":"2","subsectionId":"1","sourceHebrew":"ובפרט אז דער ערב ראש השנה איז מחבר א שנת השמיטה","dayuh":{"kind":"translation","verseSection":"2","subSection":2,"sourceHebrew":"ובפרט אז דער ערב ראש השנה איז מחבר א שנת השמיטה","language":"en","documentId":"j1cZbrvaP3Cow4wHZZq2","sourcePath":"books/Sichos Kodesh/Farbrengens/j1cZbrvaP3Cow4wHZZq2","productionMappingMethod":"unique-normalized-title"}},{"id":"BH_sk_translation_en_sichosKodesh_5747_57471329_7439f7e7_s2_p2","content":"(last year)","verseSection":"2","subsectionId":"2","sourceHebrew":"(שנה שעברה)","dayuh":{"kind":"translat