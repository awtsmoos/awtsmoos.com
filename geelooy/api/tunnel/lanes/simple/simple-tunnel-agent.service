# B"H
# Use the installer to install this isolated agent with private systemd credentials.
[Unit]
Description=Awtsmoos Secure Simple Tunnel Agent
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/awtsmoos-simple-agent
ExecStart=/usr/bin/node /opt/awtsmoos-simple-agent/agent-resilient.js
Environment=TUNNEL_SERVER=https://awtsmoos.com
Environment=TUNNEL_AGENT_ID=hetzner-prod
Environment=TUNNEL_AGENT_FILE=/opt/awtsmoos-simple-agent/agent-poll.js
LoadCredential=simple-agent.key:/etc/awtsmoos/simple-agent-hetzner-prod.key
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
[Install]
WantedBy=multi-user.target
