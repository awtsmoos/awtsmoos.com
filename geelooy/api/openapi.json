{
 "components": {
  "schemas": {
   "Connections": {
    "description": "Citation graph neighborhood for a post, or reverse-index results for a citation key.",
    "properties": {
     "success": {
      "properties": {
       "citedBy": {
        "description": "Posts citing this post or citation key.",
        "items": {
         "type": "object"
        },
        "type": "array"
       },
       "cites": {
        "description": "Citation keys this post cites.",
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "post": {
        "description": "Echo of ?post= when used.",
        "type": "string"
       },
       "ref": {
        "description": "Echo of ?ref= when used.",
        "type": "string"
       }
      },
      "type": "object"
     }
    },
    "type": "object"
   },
   "Error": {
    "properties": {
     "BH": {
      "example": "B\"H",
      "type": "string"
     },
     "details": {
      "description": "Optional extra context."
     },
     "error": {
      "description": "Stable machine-readable code.",
      "enum": [
       "METHOD_NOT_ALLOWED",
       "MISSING_WORD",
       "MISSING_CORPUS",
       "EXACT_SEARCH_DISABLED_FOR_CORPUS",
       "EXACT_SERIES_WARMING",
       "READ_FAILED",
       "KEYS_FAILED",
       "AUTH_NEEDED",
       "PUBLIC_SITES_FAILED"
      ],
      "type": "string"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   },
   "Post": {
    "description": "A Torah library post. Translated posts carry hebrew + english side by side per unit and per phrase.",
    "properties": {
     "contentType": {
      "type": "string"
     },
     "corpus": {
      "type": "string"
     },
     "heichelId": {
      "example": "ikar",
      "type": "string"
     },
     "postId": {
      "type": "string"
     },
     "seriesId": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "unitCount": {
      "type": "integer"
     },
     "units": {
      "items": {
       "properties": {
        "english": {
         "description": "Present on translated posts.",
         "type": "string"
        },
        "hebrew": {
         "type": "string"
        },
        "phrases": {
         "items": {
          "properties": {
           "english": {
            "type": "string"
           },
           "hebrew": {
            "type": "string"
           }
          },
          "type": "object"
         },
         "type": "array"
        },
        "ref": {
         "example": "1:1#c0",
         "type": "string"
        }
       },
       "type": "object"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "SuccessEnvelope": {
    "properties": {
     "success": {
      "description": "Endpoint payload."
     }
    },
    "required": [
     "success"
    ],
    "type": "object"
   }
  }
 },
 "info": {
  "contact": {
   "name": "Awtsmoos",
   "url": "https://awtsmoos.com/contact/"
  },
  "description": "Public read API for the Awtsmoos Torah library (21,000+ posts: Tanach, Mishnah, Talmud Bavli, Yerushalmi, Rambam, Midrash, Chassidus). All read endpoints are unauthenticated GET. Machine index: https://awtsmoos.com/api.json. Human docs: https://awtsmoos.com/developers/.",
  "license": {
   "name": "All rights reserved — Awtsmoos.com",
   "url": "https://awtsmoos.com/legal/terms/"
  },
  "title": "Awtsmoos Public API",
  "version": "1.0.0"
 },
 "openapi": "3.1.0",
 "paths": {
  "/api/social/heichelos/{heichel}/series/": {
   "get": {
    "description": "Detailed series list for a space. The main Torah library is heichel 'ikar'.",
    "parameters": [
     {
      "example": "ikar",
      "in": "path",
      "name": "heichel",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/SuccessEnvelope"
        }
       }
      },
      "description": "Series list."
     },
     "default": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      },
      "description": "Error envelope."
     }
    },
    "summary": "List series in a heichel",
    "tags": [
     "series"
    ]
   }
  },
  "/api/social/heichelos/{heichel}/series/{series}": {
   "get": {
    "description": "Returns the posts of one series. With ?details=true returns full series metadata instead of the compact listing.",
    "parameters": [
     {
      "example": "ikar",
      "in": "path",
      "name": "heichel",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "example": "tanya",
      "in": "path",
      "name": "series",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "description": "true → full series metadata.",
      "in": "query",
      "name": "details",
      "required": false,
      "schema": {
       "type": "boolean"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/SuccessEnvelope"
        }
       }
      },
      "description": "Series contents or metadata."
     },
     "default": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      },
      "description": "Error envelope."
     }
    },
    "summary": "Series contents or metadata",
    "tags": [
     "series"
    ]
   }
  },
  "/api/social/heichelos/{heichel}/series/{series}/post/{post}": {
   "get": {
    "description": "Reads one post addressed by library position: heichel, series, post ID.",
    "parameters": [
     {
      "example": "ikar",
      "in": "path",
      "name": "heichel",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "example": "tanya",
      "in": "path",
      "name": "series",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "in": "path",
      "name": "post",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Post"
        }
       }
      },
      "description": "Post record."
     },
     "default": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      },
      "description": "Error envelope."
     }
    },
    "summary": "Read a post in series context",
    "tags": [
     "posts"
    ]
   }
  },
  "/api/social/heichelos/{heichel}/series/{series}/posts": {
   "get": {
    "description": "Explicit post listing for one series. /posts/details returns the expanded per-post form.",
    "parameters": [
     {
      "example": "ikar",
      "in": "path",
      "name": "heichel",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "example": "tanya",
      "in": "path",
      "name": "series",
      "required": true,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/SuccessEnvelope"
        }
       }
      },
      "description": "Post list."
     },
     "default": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      },
      "description": "Error envelope."
     }
    },
    "summary": "List posts in a series",
    "tags": [
     "series"
    ]
   }
  },
  "/api/social/packed/connections": {
   "get": {
    "description": "Walk the citation graph. ?post=<postId> returns a post's citations and back-references. ?ref=<citationKey> is the reverse index: every post that references that citation key. Pass exactly one of the two.",
    "parameters": [
     {
      "description": "Post ID.",
      "in": "query",
      "name": "post",
      "required": false,
      "schema": {
       "type": "string"
      }
     },
     {
      "description": "Citation key (verse or source reference).",
      "in": "query",
      "name": "ref",
      "required": false,
      "schema": {
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Connections"
        }
       }
      },
      "description": "Connection graph."
     },
     "default": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      },
      "description": "Error envelope."
     }
    },
    "summary": "Citation connections (forward + reverse)",
    "tags": [
     "connections"
    ]
   }
  },
  "/api/social/packed/keys": {
   "get": {
    "description": "Bounded listing of packed keys beneath an optional prefix.",
    "parameters": [
     {
      "in": "query",
      "name": "shard",
      "required": false,
      "schema": {
       "default": "core",
       "type": "string"
      }
     },
     {
      "in": "query",
      "name": "prefix",
      "required": false,
      "schema": {
       "type": "string"
      }
     },
     {
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
       "default": 200,
       "maximum": 200,
       "type": "integer"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/SuccessEnvelope"
        }
       }
      },
      "description": "Key listing."
     },
     "default": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      },
      "description": "Error envelope."
     }
    },
    "summary": "List packed keys",
    "tags": [
     "posts"
    ]
   }
  },
  "/api/social/packed/read": {
   "get": {
    "description": "Reads one packed key. A bare postId is matched against the stored key suffix, so the full internal path is not required. Optional shard selects the storage shard.",
    "parameters": [
     {
      "description": "Post ID (bare ID works) or full packed key.",
      "in": "query",
      "name": "key",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "description": "Storage shard.",
      "in": "query",
      "name": "shard",
      "required": false,
      "schema": {
       "default": "core",
       "type": "string"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Post"
        }
       }
      },
      "description": "Post record."
     },
     "default": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      },
      "description": "Error envelope."
     }
    },
    "summary": "Read a post by ID",
    "tags": [
     "posts"
    ]
   }
  },
  "/api/social/search/capabilities": {
   "get": {
    "description": "Live engine capabilities: search modes, semantic model + dimensions, indexed lanes, exact-search corpora and exclusions.",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/SuccessEnvelope"
        }
       }
      },
      "description": "Capabilities document."
     }
    },
    "summary": "Search capabilities",
    "tags": [
     "search"
    ]
   }
  },
  "/api/social/search/exact/hebrew": {
   "get": {
    "description": "Word-exact search over prebuilt packed indexes. Prebuilt corpora: tanach, mishnah, talmudBavli. Any other value is treated as an Ikar series ID and searched live. Some series families are excluded (source typos); see /search/exact/hebrew/meta.",
    "parameters": [
     {
      "description": "Hebrew word (aliases: q, term).",
      "in": "query",
      "name": "word",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "description": "tanach | mishnah | talmudBavli | Ikar series ID.",
      "in": "query",
      "name": "corpus",
      "required": false,
      "schema": {
       "default": "tanach",
       "type": "string"
      }
     },
     {
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
       "default": 25,
       "maximum": 200,
       "type": "integer"
      }
     },
     {
      "in": "query",
      "name": "offset",
      "required": false,
      "schema": {
       "default": 0,
       "type": "integer"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/SuccessEnvelope"
        }
       }
      },
      "description": "Exact matches."
     },
     "default": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      },
      "description": "Error envelope."
     }
    },
    "summary": "Exact indexed Hebrew search",
    "tags": [
     "search"
    ]
   }
  },
  "/api/social/search/exact/hebrew/meta": {
   "get": {
    "description": "Prebuilt corpora, excluded series families, index worker status, and storage mode.",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/SuccessEnvelope"
        }
       }
      },
      "description": "Metadata."
     }
    },
    "summary": "Exact-search metadata",
    "tags": [
     "search"
    ]
   }
  },
  "/api/social/search/library/browse": {
   "get": {
    "description": "Browse the indexed library shards backing public search.",
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/SuccessEnvelope"
        }
       }
      },
      "description": "Shard listing."
     }
    },
    "summary": "Browse search shards",
    "tags": [
     "search"
    ]
   }
  },
  "/api/social/search/library/query": {
   "get": {
    "description": "The public search surface the site itself uses: blended lexical + semantic over the reviewed Torah library.",
    "parameters": [
     {
      "description": "Query in Hebrew or English.",
      "in": "query",
      "name": "q",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
       "default": 20,
       "maximum": 50,
       "type": "integer"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/SuccessEnvelope"
        }
       }
      },
      "description": "Blended results."
     },
     "default": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      },
      "description": "Error envelope."
     }
    },
    "summary": "Unified public library search",
    "tags": [
     "search"
    ]
   }
  },
  "/api/social/search/semantic": {
   "get": {
    "description": "Meaning-based English search over verified translated + summarized content (multilingual-e5-small, 384 dimensions, HNSW lanes). Forces vector ranking where vectors exist.",
    "parameters": [
     {
      "description": "English query (aliases: query, text).",
      "in": "query",
      "name": "q",
      "required": true,
      "schema": {
       "type": "string"
      }
     },
     {
      "in": "query",
      "name": "limit",
      "required": false,
      "schema": {
       "default": 20,
       "maximum": 50,
       "type": "integer"
      }
     }
    ],
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/SuccessEnvelope"
        }
       }
      },
      "description": "Ranked results."
     },
     "default": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      },
      "description": "Error envelope."
     }
    },
    "summary": "Semantic vector search",
    "tags": [
     "search"
    ]
   }
  },
