{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "/social-composer/reel-studio/api/ai-movie-schema-v1.json",
	"title": "Awtsmoos AI Movie Envelope v1",
	"type": "object",
	"additionalProperties": false,
	"required": ["schema", "creativeBrief", "project"],
	"properties": {
		"schema": { "const": "awtsmoos.ai-movie.v1" },
		"instructions": {
			"type": "array",
			"maxItems": 24,
			"items": { "type": "string", "maxLength": 500 }
		},
		"creativeBrief": {
			"type": "object",
			"additionalProperties": true,
			"required": ["logline", "visualLanguage", "cameraLanguage", "lighting", "continuity"],
			"properties": {
				"logline": { "type": "string", "maxLength": 1000 },
				"subject": { "type": "string", "maxLength": 1000 },
				"environment": { "type": "string", "maxLength": 1000 },
				"visualLanguage": { "type": "string", "maxLength": 1000 },
				"cameraLanguage": { "type": "string", "maxLength": 1000 },
				"lighting": { "type": "string", "maxLength": 1000 },
				"continuity": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 500 } },
				"sound": { "type": "string", "maxLength": 1000 },
				"assetRequests": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 500 } },
				"negativeConstraints": { "type": "array", "maxItems": 32, "items": { "type": "string", "maxLength": 500 } }
			}
		},
		"project": {
			"type": "object",
			"additionalProperties": true,
			"required": ["version", "title", "duration", "fps", "resolution", "tracks"],
			"properties": {
				"version": { "type": "number", "minimum": 1 },
				"title": { "type": "string", "minLength": 1, "maxLength": 300 },
				"duration": { "type": "number", "exclusiveMinimum": 0, "maximum": 900 },
				"fps": { "type": "number", "minimum": 1, "maximum": 120 },
				"resolution": {
					"type": "object",
					"required": ["width", "height"],
					"properties": {
						"width": { "type": "number", "minimum": 160, "maximum": 4096 },
						"height": { "type": "number", "minimum": 90, "maximum": 2160 }
					}
				},
				"tracks": { "type": "array", "minItems": 1, "maxItems": 128 }
			}
		}
	}
}
