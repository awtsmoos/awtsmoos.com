{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "/social-composer/reel-studio/api/movie-package-schema-v1.json",
	"title": "Awtsmoos Movie Package v1",
	"type": "object",
	"additionalProperties": false,
	"required": ["format", "version", "project", "artifacts", "renderPlan", "validation"],
	"properties": {
		"format": { "const": "awtsmoos.movie-package.v1" },
		"version": { "const": 1 },
		"project": { "type": "object" },
		"request": { "type": ["object", "null"] },
		"artifacts": {
			"type": "object",
			"required": ["assets", "materialGraphs", "nodeGraphs"],
			"properties": {
				"assets": { "type": "array", "maxItems": 256 },
				"materialGraphs": { "type": "array", "maxItems": 32 },
				"nodeGraphs": { "type": "array", "maxItems": 32 }
			}
		},
		"renderPlan": {
			"type": "object",
			"required": ["duration", "fps", "resolution", "fileName"]
		},
		"validation": {
			"type": "object",
			"required": ["valid", "renderReady", "missingAssets"]
		}
	}
}
