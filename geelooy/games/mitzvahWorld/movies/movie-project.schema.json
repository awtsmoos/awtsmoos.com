{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "/games/mitzvahWorld/movies/movie-project.schema.json",
	"title": "Mitzvah World AI Movie Project",
	"type": "object",
	"required": ["title", "duration", "tracks"],
	"properties": {
		"version": { "type": "number", "default": 1 },
		"title": { "type": "string" },
		"duration": { "type": "number", "exclusiveMinimum": 0 },
		"fps": { "type": "number", "minimum": 8, "maximum": 60, "default": 24 },
		"seed": { "type": "number", "default": 613 },
		"resolution": {
			"type": "object",
			"required": ["width", "height"],
			"properties": {
				"width": { "type": "integer", "minimum": 320 },
				"height": { "type": "integer", "minimum": 180 }
			}
		},
		"render": {
			"type": "object",
			"properties": {
				"fileName": { "type": "string" },
				"videoBitsPerSecond": { "type": "integer", "minimum": 100000 }
			}
		},
		"tracks": {
			"type": "array",
			"minItems": 1,
			"items": { "$ref": "#/$defs/track" }
		}
	},
	"$defs": {
		"point": {
			"type": "object",
			"properties": {
				"x": { "type": "number" },
				"y": { "type": "number" },
				"z": { "type": "number" }
			}
		},
		"cameraEndpoint": {
			"type": "object",
			"properties": {
				"position": { "$ref": "#/$defs/point" },
				"target": { "$ref": "#/$defs/point" },
				"targetActor": { "enum": ["player", "npc"] }
			}
		},
		"clip": {
			"type": "object",
			"required": ["start", "duration"],
			"properties": {
				"id": { "type": "string" },
				"start": { "type": "number", "minimum": 0 },
				"duration": { "type": "number", "exclusiveMinimum": 0 },
				"easing": { "enum": ["linear", "easeInQuad", "easeOutQuad", "easeInOutQuad", "easeInOutCubic", "smoothstep", "smootherstep"] },
				"action": { "enum": ["move", "pose", "talk", "jump"] },
				"animation": { "type": "string" },
				"from": { "anyOf": [{ "$ref": "#/$defs/point" }, { "$ref": "#/$defs/cameraEndpoint" }, { "type": "number" }] },
				"to": { "anyOf": [{ "$ref": "#/$defs/point" }, { "$ref": "#/$defs/cameraEndpoint" }, { "type": "number" }] },
				"at": { "$ref": "#/$defs/point" },
				"height": { "type": "number" },
				"face": { "enum": ["player", "npc"] },
				"shot": { "type": "string" },
				"speaker": { "type": "string" },
				"text": { "type": "string" },
				"label": { "type": "string" },
				"grade": { "type": "string" },
				"transition": { "enum": ["cut", "fade", "crossfade"] },
				"visibility": { "type": "object", "additionalProperties": { "type": "boolean" } },
				"kind": { "enum": ["score", "speechTone", "door", "jump"] },
				"frequency": { "type": "number" },
				"volume": { "type": "number", "minimum": 0, "maximum": 1 }
			},
			"additionalProperties": true
		},
		"track": {
			"type": "object",
			"required": ["type", "clips"],
			"properties": {
				"id": { "type": "string" },
				"type": { "enum": ["scene", "actor", "door", "camera", "dialogue", "audio", "event"] },
				"target": { "type": ["string", "null"] },
				"clips": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/clip" } }
			}
		}
	}
}
