		{
			"id": "dialogue",
			"type": "dialogue",
			"clips": [
				{
					"start": 4,
					"duration": 6,
					"speaker": "Narrator",
					"text": "At dawn, Emerald Village awakens beneath the Tree of Life."
				},
				{
					"start": 21,
					"duration": 6,
					"speaker": "Levi",
					"text": "Every path begins with a neighbor and a willing heart."
				},
				{
					"start": 32,
					"duration": 8,
					"speaker": "Reb Mendel",
					"text": "A golden Shlichus waits: gather courage, kindness, and the light of Torah."
				},
				{
					"start": 42,
					"duration": 7,
					"speaker": "Shliach",
					"text": "I accept. I will travel carefully and return with every soul protected."
				},
				{
					"start": 62,
					"duration": 7,
					"speaker": "River Keeper",
					"text": "Cross where the water shines. The forest remembers every footstep."
				},
				{
					"start": 81,
					"duration": 7,
					"speaker": "Ranger",
					"text": "The undergrowth is thick. Watch for the shadow beside the old stones."
				},
				{
					"start": 95,
					"duration": 8,
					"speaker": "Shliach",
					"text": "No darkness stands alone before a word of Torah spoken with truth."
				},
				{
					"start": 116,
					"duration": 7,
					"speaker": "Kitchen Keeper",
					"text": "Warm bread, clean hands, and a shared table restore the travelers."
				},
				{
					"start": 132,
					"duration": 8,
					"speaker": "Teacher",
					"text": "Learn the passage. Its wisdom becomes protection when carried into action."
				},
				{
					"start": 148,
					"duration": 8,
					"speaker": "Reb Mendel",
					"text": "The gate opens only for a Shlichus completed with kindness."
				},
				{
					"start": 164,
					"duration": 8,
					"speaker": "Villagers",
					"text": "Welcome home. One fulfilled mission has brightened the whole valley."
				},
				{
					"start": 174,
					"duration": 6,
					"speaker": "Narrator",
					"text": "The village is only the beginning."
				}
			]
