    "\t\t\tinventoryAndRpg: 'deferred',\n" +
    "\t\t\trichActors: 'deferred',\n" +
    "\t\t\trichRenderer: 'deferred',\n" +
    "\t\t\tworldDiagnostics: 'deferred'\n" +
    '\t\t});\n' +
