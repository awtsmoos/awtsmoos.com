  '// B"H\n' +
    '// Boruch Hashem\n' +
    '// Blessed is He\n' +
    '\n' +
    '/**\n' +
    ' * @file createEretzRuntime.js\n' +
    ' * @description Publishes visible playability before streaming tiny districts in idle slices.\n' +
    ' * The Awtsmoos reveals control, jump, run, valley, and habitation in appointed measures;\n' +
    ' * Awtsmoos.com keeps rich shaders, authored terrain, RPG, and heavy actors explicitly deferred.\n' +
    ' */\n' +
    '\n' +
    'import {\n' +
    '\tmarkRendererHydration,\n' +
    '\tmarkRuntimeFailed,\n' +
    '\tmarkRuntimePlayable,\n' +
    '\tmarkRuntimeStarting\n' +
    "} from './RuntimeStateMarker.js';\n" +
    '\n' +
    'export {\n' +
    '\tstartGameplayTextureStreaming\n' +
    "} from './GameplayTextureStreamingGate.js';\n" +
    '\n' +
    "const STAGED_RUNTIME_URL = './EretzStagedRuntime.js?v=20260723-stream-21';\n" +
    "const TRACKER_URL = './BootPhaseTracker.js?v=20260722-boot-text-01';\n" +
    '\n' +
    'export async function createEretzRuntime(hosts, options = {}) {\n' +
    '\tconst environment = options.environment || globalThis;\n' +
    '\tmarkRuntimeStarting(environment.document);\n' +
    '\tconst { BootPhaseTracker } = await import(TRACKER_URL);\n' +
    '\tconst boot = new BootPhaseTracker(undefined, environment);\n' +
    '\tglobalThis.AwtsmoosBootTracker = boot;\n' +
    '\n' +
    '\ttry {\n' +
    "\t\tboot.begin('staged-webgl-runtime');\n" +
    '\t\tconst { createStagedEretzRuntime } = await import(STAGED_RUNTIME_URL);\n' +
    '\t\tconst core = await createStagedEretzRuntime(hosts, options, boot);\n' +
    '\t\tboot.complete();\n' +
