    "import { applyWorldUvDensity } from './MinimalMeadowWorldUvDensity.js';\n" +
    '\n' +
    'export async function createMinimalMeadowTerrainPackage(options = {}) {\n' +
    '\tconst mobile = Boolean(options.mobile);\n' +
    '\toptions.onProgress?.({\n' +
    "\t\tmessage: 'Loading independent meadow sources…',\n" +
    '\t\tprogress: 0.08\n' +
    '\t});\n' +
    '\tconst textureSources = await loadMinimalMeadowTerrainSources(options);\n' +
