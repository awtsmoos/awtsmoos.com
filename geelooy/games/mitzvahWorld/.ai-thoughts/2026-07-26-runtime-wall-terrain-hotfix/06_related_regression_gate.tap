    '\t\tcomposites.path,\n' +
    "\t\t'',\n" +
    "\t\t'high'\n" +
    '\t);\n' +
    "\tmesh.name = 'Awtsmoos_continuous_meadow_and_road';\n" +
    '\tconst density = configureMinimalTerrainDensity(\n' +
    '\t\tmesh.material,\n' +
    '\t\tcomposites,\n' +
    '\t\tdata.size,\n' +
    '\t\tmobile\n' +
    '\t);\n' +
    '\tconst uvInfo = applyWorldUvDensity(\n' +
    '\t\tmesh.geometry,\n' +
    '\t\tdensity.tileWorld,\n' +
