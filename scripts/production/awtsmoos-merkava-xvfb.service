# B"H
# Boruch Hashem
# Blessed is He
# The Awtsmoos gives an X11 world a locked door, with no open TCP listener.

[Unit]
Description=Awtsmoos Merkava private X11 virtual display
After=network.target

[Service]
Type=simple
User=awtsmoos-merkava
Group=awtsmoos-merkava
WorkingDirectory=/var/lib/awtsmoos-merkava
Environment=HOME=/var/lib/awtsmoos-merkava
UMask=0077
ExecStart=/usr/bin/Xvfb :99 -screen 0 1366x800x24 -auth /var/lib/awtsmoos-merkava/.Xauthority -nolisten tcp -noreset
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/awtsmoos-merkava /tmp

[Install]
WantedBy=multi-user.target
