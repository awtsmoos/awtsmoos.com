# B"H
# Boruch Hashem
# Blessed is He
# The Awtsmoos preserves the same real Chrome garment over a private X11 display.
# Debugging is loopback-only; the owner completes authentication inside real Chrome.

[Unit]
Description=Awtsmoos Merkava interactive sandboxed Chrome
After=network-online.target awtsmoos-merkava-xvfb.service
Requires=awtsmoos-merkava-xvfb.service
Wants=network-online.target

[Service]
Type=simple
User=awtsmoos-merkava
Group=awtsmoos-merkava
WorkingDirectory=/var/lib/awtsmoos-merkava
Environment=HOME=/var/lib/awtsmoos-merkava
Environment=XDG_CONFIG_HOME=/var/lib/awtsmoos-merkava/config
Environment=XDG_CACHE_HOME=/var/lib/awtsmoos-merkava/cache
Environment=DISPLAY=:99
Environment=XAUTHORITY=/var/lib/awtsmoos-merkava/.Xauthority
UMask=0077
ExecStart=/usr/bin/google-chrome-stable --remote-debugging-address=127.0.0.1 --remote-debugging-port=9222 --user-data-dir=/var/lib/awtsmoos-merkava/profiles/primary --window-size=1366,800 --disable-dev-shm-usage --no-first-run --no-default-browser-check about:blank
Restart=on-failure
RestartSec=3
TimeoutStopSec=12
KillMode=control-group
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/awtsmoos-merkava /tmp

[Install]
WantedBy=multi-user.target
