#!/usr/bin/env node
/**
 * B"H
 *
 * A fast search vessel: llama sings the query into a normalized vector, then
 * the sidecar answers with raw Float32 dot-products. No object-by-object DB
 * pilgrimage is needed for ranking; the AwtsmoosDB bento remains the source
 * of truth, and this file is the thunderbolt that finds where to look.
 */
import fs from 'fs';
import path from 'path';
import { createRequire } from 'module';
import { performance } from 'perf_hooks';

const require = createRequire(import.meta.url);
const { embedTextAuto, runnerState } = require('../../ayzarim/DosDB/aiSearch/textEmbedRunner.js');

const RAG = '/Users/awtsmoos/Documents/awtsmoos/dayuhChadash/ai/comment-rag';
const INDEX_DIR = path.join(RAG, 'likkutei-v01-v39-fast-index');
const VECTORS = path.join(INDEX_DIR, 'vectors.f32');
const META = path.join(INDEX_DIR, 'meta.jsonl');
const DIMENSIONS = 384;
const DEFAULT_QUERIES = [
  'Mashiach and redemption of the Jewish people',
  'teshuvah repentance changes the person and removes decree',
  'charity giving repeatedly even one hundred times',
  'the soul and body belong to Hashem not to a person'
];

function normalize(vector) {
  let sum = 0;
  for (const value of vector) sum += value * value;
  const magnitude = Math.sqrt(sum) || 1;
  return vector.map(value => value / magnitude);
}

function topK(queryVector, matrix, meta, k) {
  const best = [];
  const records = meta.length;
  for (let row = 0; row < records; row += 1) {
    let score = 0;
    const offset = row * DIMENSIONS;
    for (let dim = 0; dim < DIMENSIONS; dim += 1) score += queryVector[dim] * matrix[offset + dim];
    if (best.length < k || score > best[best.length - 1].score) {
      const hit = { score, item: meta[row] };
      let inserted = false;
      for (let i = 0; i < best.length; i += 1) {
        if (score > best[i].score) {
          best.splice(i, 0, hit);
          inserted = true;
          break;
        }
      }
      if (!inserted) best.push(hit);
      if (best.length > k) best.pop();
    }
  }
  return best;
}

function loadIndex() {
  const loadStart = performance.now();
  const vectorBuffer = fs.readFileSync(VECTORS);
  const matrix = new Float32Array(vectorBuffer.buffer, vectorBuffer.byteOffset, vectorBuffer.byteLength / 4);
  const meta = fs.readFileSync(META, 'utf8').trim().split(/\n/).map(line => JSON.parse(line));
  const loadMs = Math.round(performance.now() - loadStart);
  if (matrix.length !== meta.length * DIMENSIONS) {
    throw new Error(`Index mismatch vectors=${matrix.length} meta=${meta.length}`);
  }
  return { matrix, meta, loadMs };
}

function compact(hit) {
  const item = hit.item;
  return {
    score: Number(hit.score.toFixed(6)),
    volume: item.volume,
    sourceBand: item.sourceBand,
    id: item.id,
    verses: [item.verseStart, item.verseEnd],
    sample: String(item.text || '').slice(0, 240)
  };
}

async function searchOne(index, query) {
  const start = performance.now();
  const embedded = await embedTextAuto(query, { modelRoot: RAG, noFallback: true, fresh: true });
  const afterEmbed = performance.now();
  const queryVector = normalize(embedded.vector);
  const ranked = topK(queryVector, index.matrix, index.meta, 8);
  const afterSearch = performance.now();
  return {
    query,
    provider: embedded.provider,
    timingMs: {
      embed: Math.round(afterEmbed - start),
      search: Math.round(afterSearch - afterEmbed),
      total: Math.round(afterSearch - start)
    },
    counts: {
      top8FromV01V15: ranked.filter(hit => Number(hit.item.volume) <= 15).length,
      top8FromV16V39: ranked.filter(hit => Number(hit.item.volume) >= 16).length
    },
    results: ranked.map(compact)
  };
}

async function main() {
  const queries = process.argv.slice(2).length ? process.argv.slice(2) : DEFAULT_QUERIES;
  const index = loadIndex();
  const searches = [];
  for (const query of queries) searches.push(await searchOne(index, query));
  console.log(JSON.stringify({
    BH: 'B"H',
    indexDir: INDEX_DIR,
    records: index.meta.length,
    dimensions: DIMENSIONS,
    loadMs: index.loadMs,
    runner: runnerState({ modelRoot: RAG }),
    searchedAt: new Date().toISOString(),
    searches
  }, null, 2));
}

main().catch(error => {
  console.error(error.stack || error);
  process.exit(1);
});
