#!/usr/bin/env node
/**
 * B"H
 *
 * The index is only the lightning map, never the palace.
 * Vectors live here for speed; comments remain in the living DB or archived
 * sidecars. No Hebrew, no English snippets, no baked EN marker are written into
 * meta.jsonl. Every result must walk back to its source before speaking.
 */
import fs from 'fs';
import path from 'path';

const RAG = '/Users/awtsmoos/Documents/awtsmoos/dayuhChadash/ai/comment-rag';
const OLD = path.join(RAG, 'likkutei-v01-v15-llama-work/vectors.jsonl');
const NEW = path.join(RAG, 'likkutei-v16-v39-llama-work/vectors.jsonl');
const OUT_DIR = path.join(RAG, 'likkutei-v01-v39-fast-index');
const META_JSONL = path.join(OUT_DIR, 'meta.jsonl');
const VECTORS_F32 = path.join(OUT_DIR, 'vectors.f32');
const SUMMARY = path.join(OUT_DIR, 'summary.json');
const DIMENSIONS = 384;
const ALIAS = 'likkutei_translation_en';

function readJsonl(file) {
  return fs.readFileSync(file, 'utf8').split(/\n/).filter(Boolean).map(JSON.parse);
}

function normalizeVector(vector) {
  let sum = 0;
  for (const value of vector) sum += value * value;
  const magnitude = Math.sqrt(sum) || 1;
  return vector.map(value => value / magnitude);
}

function commentPathFor(record) {
  if (record.commentPath) return String(record.commentPath).replace(/\.(awtsmoosJSON|json)$/i, '');
  return `/social/heichelos/ikar/comments/atSeries/${record.seriesId}/atPost/${record.postId}/${record.aliasId || ALIAS}`;
}

function compactMeta(record, index) {
  const volume = Number(record.volume);
  return {
    index,
    id: record.id,
    volume,
    seriesId: record.seriesId,
    postId: record.postId,
    aliasId: record.aliasId || ALIAS,
    commentPath: commentPathFor(record),
    archiveFile: record.archiveFile || null,
    verseStart: Number(record.verseStart),
    verseEnd: Number(record.verseEnd),
    commentIds: Array.isArray(record.commentIds) ? record.commentIds : [],
    firstCommentId: record.firstCommentId || '',
    lastCommentId: record.lastCommentId || '',
    commentCount: Number(record.commentCount || 0) || null
  };
}

function validate(records) {
  const ids = new Set();
  const volumes = new Set();
  for (const record of records) {
    const vector = record.vec || record.embedding;
    if (!record.id || !Array.isArray(vector) || vector.length !== DIMENSIONS) {
      throw new Error(`Bad record ${record.id || '(missing-id)'}`);
    }
    if (!record.seriesId || !record.postId || !Number.isFinite(Number(record.volume))) {
      throw new Error(`Missing source reference fields for ${record.id}`);
    }
    if (ids.has(record.id)) throw new Error(`Duplicate id ${record.id}`);
    ids.add(record.id);
    volumes.add(Number(record.volume));
  }
  const expected = Array.from({ length: 39 }, (_, index) => index + 1).join(',');
  const actual = Array.from(volumes).sort((a, b) => a - b).join(',');
  if (actual !== expected) throw new Error(`Volume coverage mismatch ${actual}`);
  return { uniqueIds: ids.size, volumes: Array.from(volumes).sort((a, b) => a - b) };
}

async function main() {
  const oldRecords = readJsonl(OLD);
  const newRecords = readJsonl(NEW);
  const records = [...oldRecords, ...newRecords];
  if (oldRecords.length !== 1823 || newRecords.length !== 11772 || records.length !== 13595) {
    throw new Error(`Unexpected counts old=${oldRecords.length} new=${newRecords.length} total=${records.length}`);
  }
  const valid = validate(records);
  fs.rmSync(OUT_DIR, { recursive: true, force: true });
  fs.mkdirSync(OUT_DIR, { recursive: true });

  const vectors = Buffer.allocUnsafe(records.length * DIMENSIONS * 4);
  const metaLines = [];
  for (let index = 0; index < records.length; index += 1) {
    const record = records[index];
    const vector = normalizeVector(record.vec || record.embedding);
    for (let dim = 0; dim < DIMENSIONS; dim += 1) {
      vectors.writeFloatLE(vector[dim], (index * DIMENSIONS + dim) * 4);
    }
    metaLines.push(JSON.stringify(compactMeta(record, index)));
  }

  fs.writeFileSync(VECTORS_F32, vectors);
  fs.writeFileSync(META_JSONL, metaLines.join('\n') + '\n');

  const metaText = fs.readFileSync(META_JSONL, 'utf8');
  const summary = {
    BH: 'B"H',
    outDir: OUT_DIR,
    vectors: VECTORS_F32,
    meta: META_JSONL,
    records: records.length,
    oldRecords: oldRecords.length,
    newRecords: newRecords.length,
    uniqueIds: valid.uniqueIds,
    dimensions: DIMENSIONS,
    volumes: { first: valid.volumes[0], last: valid.volumes.at(-1), count: valid.volumes.length },
    metaPolicy: 'reference-only: no baked text, no sourceHebrew, no content, no EN markers',
    bakedTextFields: /"text"\s*:|"sample"\s*:|"sampleContent"\s*:|EN:/.test(metaText) ? 'FAILED' : 'none detected',
    bytes: { vectors: fs.statSync(VECTORS_F32).size, meta: fs.statSync(META_JSONL).size },
    finished: new Date().toISOString()
  };
  fs.writeFileSync(SUMMARY, JSON.stringify(summary, null, 2));
  console.log(JSON.stringify(summary, null, 2));
}

main().catch(error => {
  console.error(error.stack || error);
  process.exit(1);
});
