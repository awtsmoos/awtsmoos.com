      "find": "  graphFields() {\r\n    return `<section class=\"automation-graph-panel\">\r\n      <h2>Automation Graph</h2>\r\n      <p class=\"panel-note\">Build rules like: if the last AI message contains text, send this prompt; otherwise stop/archive. JSON is the source of truth and can be pasted or edited.</p>\r\n      <div class=\"graph-toolbar\">\r\n        <button type=\"button\" data-graph-action=\"add-send\">+ Send</button>\r\n        <button type=\"button\" data-graph-action=\"add-condition\">+ Condition</button>\r\n        <button type=\"button\" data-graph-action=\"add-archive\">+ Archive</button>\r\n        <button type=\"button\" data-graph-action=\"add-delay\">+ Delay</button>\r\n        <button type=\"button\" data-graph-action=\"add-jump\">+ Jump</button>\r\n        <button type=\"button\" data-graph-action=\"add-stop\">+ Stop</button>\r\n        <button type=\"button\" data-graph-action=\"reset\">Reset</button>\r\n        <button type=\"button\" data-graph-action=\"save-forms\">Save Forms</button>\r\n        <button type=\"button\" data-graph-action=\"save-json\">Save JSON</button>\r\n        <button type=\"button\" data-graph-action=\"download-json\">Download JSON</button>\r\n      </div>\r\n      <label class=\"automation-field graph-start-field\">Start node <select data-graph-start>${nodeOptions(this.graph.nodes, this.graph.start)}</select></label>\r\n      <div class=\"graph-canvas\">${this.graph.nodes.map(nodeEditor).join(\"\")}</div>\r\n      <label class=\"automation-field graph-json-field\">Graph JSON<textarea data-graph-json rows=\"14\">${text(JSON.stringify(this.graph, null, 2))}</textarea></label>\r\n      <div class=\"automation-status\" id=\"graph-status\">graph ready: ${this.graph.nodes.length} node(s)</div>\r\n    </section>`;\r\n  }",
