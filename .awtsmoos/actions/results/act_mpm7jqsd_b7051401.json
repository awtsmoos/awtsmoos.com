      "content": "// B\"H\r\nimport { createRequire } from 'module';\r\n\r\nconst require = createRequire(import.meta.url);\r\nconst md2 = require('../../merkava-binary/Md2BytecodeApi.js');\r\n\r\nfunction normalizeFiles(files = {}) {\r\n  return md2.normalizeFiles(files || {});\r\n}\r\n\r\nfunction elementSummary(element) {\r\n  if (!element) return null;\r\n  return {\r\n    tagName: element.tagName || element.tag || '',\r\n    id: element.id || '',\r\n    className: element.className || '',\r\n    textContent: element.textContent || '',\r\n    attributes: element.attributes || {},\r\n    children: Array.isArray(element.children)\r\n      ? element.children.slice(0, 20).map(elementSummary)\r\n      : []\r\n  };\r\n}\r\n\r\nfunction summarizeMd2Run(run) {\r\n  const result = run?.result || run;\r\n  const web = result?.web;\r\n  const document = web?.document;\r\n  const ids = {};\r\n  if (document?.byId instanceof Map) {\r\n    for (const [id, element] of document.byId.entries()) ids[id] = elementSummary(element);\r\n  }\r\n  return {\r\n    ok: result?.ok !== false,\r\n    scripts: Array.isArray(result?.scripts)\r\n      ? result.scripts.map(script => ({\r\n        name: script.name || '',\r\n        target: script.target || '',\r\n        event: script.event || '',\r\n        result: script.result && JSON.parse(JSON.stringify(script.result))\r\n      }))\r\n      : [],\r\n    web: document ? {\r\n      root: elementSummary(document.documentElement || document.root || null),\r\n      ids\r\n    } : null\r\n  };\r\n}\r\n\r\nexport async function compileMd2Runtime(options = {}) {\r\n  return md2.compileMd2App({\r\n    files: normalizeFiles(options.files || {}),\r\n    entry: options.entry || 'index.html'\r\n  });\r\n}\r\n\r\nexport function runMd2Runtime(bytecode, options = {}) {\r\n  const run = md2.runMd2App(bytecode, options);\r\n  return { ...run, result: summarizeMd2Run(run) };\r\n}\r\n\r\nexport async function simulateMd2Runtime(options = {}) {\r\n  const compiled = await compileMd2Runtime(options);\r\n  const run = runMd2Runtime(compiled.bytecode, options.runOptions || options);\r\n  return {\r\n    BH: 'B\"H',\r\n    ok: run.ok !== false,\r\n    runtime: options.runtime || 'browser',\r\n    engine: 'md2',\r\n    entry: options.entry || 'index.html',\r\n    bytecode: {\r\n      kind: compiled.kind,\r\n      magic: compiled.magic,\r\n      bytes: compiled.bytecode.length,\r\n      base64: compiled.bytecode64\r\n    },\r\n    result: run.result,\r\n    score: run.ok === false ? 0 : 100,\r\n    suggestions: []\r\n  };\r\n}\r\n\r\nexport async function compileAndRunMd2Js(source = '', options = {}) {\r\n  return md2.compileAndRunMd2Js(source, options);\r\n}\r\n\r\nexport function inspectMd2(bytecode) {\r\n  return md2.inspectMd2(bytecode);\r\n}\r\n",
