      "content": "/* B\"H — live scroll follow covenant */\n#chat-box {\n  scroll-behavior: auto;\n  scrollbar-gutter: stable both-edges;\n}\n#chat-box[data-live-follow=\"paused\"]::after {\n  content: \"Live scroll paused — scroll to bottom to resume\";\n  position: sticky;\n  bottom: .75rem;\n  z-index: 30;\n  display: block;\n  width: fit-content;\n  max-width: min(92%, 34rem);\n  margin: .5rem auto 0;\n  padding: .58rem .9rem;\n  border: 1px solid rgba(250,204,21,.38);\n  border-radius: 999px;\n  background: linear-gradient(135deg, rgba(113,63,18,.72), rgba(2,6,23,.82));\n  color: #fef3c7;\n  font-size: .78rem;\n  font-weight: 900;\n  letter-spacing: .02em;\n  text-align: center;\n  box-shadow: 0 12px 34px rgba(0,0,0,.28), 0 0 24px rgba(250,204,21,.10);\n  backdrop-filter: blur(12px);\n  pointer-events: none;\n}\n#chat-box[data-live-follow=\"active\"]::after {\n  content: \"\";\n  display: none;\n}\n.message-shell:last-of-type {\n  scroll-margin-block-end: 1rem;\n}\n@media (max-width:760px){\n  #chat-box[data-live-follow=\"paused\"]::after{font-size:.72rem;bottom:.45rem;padding:.5rem .7rem}\n}\n",
