      "content": "// B\"H\n'use strict';\n\nconst fs = require('fs');\nconst { buildRuntimeActions } = require('../geelooy/apps/tunnel/agent/tools/fs/actionGroups/runtimeActions.js');\n\n/**\n * Chapter 1: The small vessel enters Merkava.\n * This runner feeds a real geelooy/ai file into simulateRuntime through the\n * Merkava executor parameters: runtime, engine, entry, files, probes, waitMs,\n * timeoutMs, origin, and url. No shell quoting storm is allowed to devour it.\n */\nasync function main() {\n  const promptSource = fs.readFileSync('geelooy/ai/prompt.js', 'utf8');\n  const files = {\n    'index.html': '<main id=\"root\"></main><script type=\"module\" src=\"./prompt-check.js\"></script>',\n    'prompt.js': promptSource,\n    'prompt-check.js': [\n      'import { AwtsmoosPrompt } from \"./prompt.js\";',\n      'globalThis.__promptExportType = typeof AwtsmoosPrompt;',\n      'AwtsmoosPrompt.go({ isAlert: true, headerTxt: \"<p id=\\\\\"bh-probe\\\\\">BH Merkava Prompt Test</p>\" });',\n      'console.log(\"prompt-export\", globalThis.__promptExportType);'\n    ].join('\\n')\n  };\n\n  const payload = {\n    action: 'simulateRuntime',\n    runtime: 'browser',\n    engine: 'merkava',\n    entry: 'index.html',\n    files,\n    probes: [\n      'globalThis.__promptExportType',\n      'document.querySelector(\"#bh-probe\")?.textContent',\n      'document.querySelector(\".awtsmoos-local-prompt-overlay\")?.className'\n    ],\n    waitMs: 700,\n    timeoutMs: 30000,\n    origin: 'http://localhost:8080',\n    url: 'http://localhost:8080'\n  };\n\n  const result = await buildRuntimeActions({ config: { root: process.cwd() }, payload }).simulateRuntime();\n  console.log(JSON.stringify({\n    ok: result.ok !== false,\n    engine: result.engine,\n    runtime: result.runtime,\n    entry: result.entry,\n    score: result.score,\n    errors: result.errors,\n    message: result.message,\n    probes: result.variableSnapshots,\n    domText: result.domSnapshot?.documentElement?.textContent?.slice?.(0, 240),\n    moduleGraph: result.moduleGraph,\n    assetGraph: result.assetGraph\n  }, null, 2));\n}\n\nmain().catch(error => {\n  console.error(error && (error.stack || error.message) || String(error));\n  process.exit(1);\n});\n",
