    "content": "/* B\"H */\r\n/*\r\n  Chapter 42: The Tiny Buttons Became Honest Controls.\r\n  Minimize, maximize, and fullscreen now show state without stealing space from\r\n  the streamed header. Fullscreen becomes a real readable overlay.\r\n*/\r\n.event-panel-actions button {\r\n  transition: transform .12s ease, filter .12s ease, border-color .12s ease, background .12s ease;\r\n}\r\n\r\n.event-panel-actions button[aria-pressed=\"true\"] {\r\n  border-color: rgba(216, 180, 254, .72);\r\n  background: linear-gradient(135deg, rgba(168,85,247,.86), rgba(14,165,233,.72));\r\n  filter: saturate(1.16) brightness(1.08);\r\n}\r\n\r\n.event-panel-actions button:hover {\r\n  transform: translateY(-1px);\r\n}\r\n\r\n.event-panel-actions button:active {\r\n  transform: translateY(1px) scale(.98);\r\n}\r\n\r\nbody.has-event-fullscreen .chat-box,\r\nbody.has-event-fullscreen .input-area,\r\nbody.has-event-fullscreen .transport-status {\r\n  filter: blur(1px) brightness(.72);\r\n}\r\n\r\n.transport-details.is-fullscreen,\r\n.thought-envelope-card.is-fullscreen {\r\n  display: grid;\r\n  grid-template-rows: auto minmax(0, 1fr);\r\n  max-height: calc(100dvh - 32px);\r\n}\r\n\r\n.transport-details.is-fullscreen > summary,\r\n.thought-envelope-card.is-fullscreen > summary {\r\n  position: sticky;\r\n  top: 0;\r\n  z-index: 3;\r\n  background: linear-gradient(135deg, rgba(15,23,42,.98), rgba(8,47,73,.94));\r\n  box-shadow: 0 12px 32px rgba(0,0,0,.34);\r\n}\r\n\r\n.transport-details.is-fullscreen .event-payload,\r\n.thought-envelope-card.is-fullscreen .thought-inner-window {\r\n  max-height: none;\r\n}\r\n\r\n.transport-details[data-panel-state=\"minimized\"],\r\n.thought-envelope-card[data-panel-state=\"minimized\"] {\r\n  opacity: .82;\r\n}\r\n",
