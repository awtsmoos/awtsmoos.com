      "replace": ".audio-player-wrap audio {\r\n  display: none;\r\n}\r\n\r\n.awtsmoos-player {\r\n  display: grid;\r\n  grid-template-columns: auto minmax(120px, 1fr) auto;\r\n  align-items: center;\r\n  gap: .65rem;\r\n  padding: .65rem;\r\n  border-radius: 1rem;\r\n  border: 1px solid rgba(34, 211, 238, .22);\r\n  background: rgba(2, 6, 23, .46);\r\n}\r\n\r\n.player-play {\r\n  width: 2.5rem;\r\n  height: 2.5rem;\r\n  padding: 0 !important;\r\n  display: inline-grid;\r\n  place-items: center;\r\n  font-weight: 900;\r\n}\r\n\r\n.player-meter {\r\n  height: .75rem;\r\n  border-radius: 999px;\r\n  background: rgba(148, 163, 184, .25);\r\n  overflow: hidden;\r\n  cursor: pointer;\r\n  box-shadow: inset 0 1px 4px rgba(0,0,0,.35);\r\n}\r\n\r\n.player-meter span {\r\n  display: block;\r\n  width: 0%;\r\n  height: 100%;\r\n  border-radius: inherit;\r\n  background: linear-gradient(90deg, rgba(34, 211, 238, .95), rgba(129, 140, 248, .95));\r\n  transition: width .12s linear;\r\n}\r\n\r\n.player-time {\r\n  min-width: 5.5rem;\r\n  text-align: end;\r\n  color: var(--ai-muted);\r\n  font-variant-numeric: tabular-nums;\r\n  font-size: .85rem;\r\n}\r\n\r\n.awtsmoos-audio-offer.is-audio-busy .audio-offer-head strong::after {\r\n  content: \"\";\r\n  display: inline-block;\r\n  width: .75rem;\r\n  height: .75rem;\r\n  margin-inline-start: .45rem;\r\n  border: 2px solid rgba(34, 211, 238, .35);\r\n  border-top-color: rgba(34, 211, 238, .95);\r\n  border-radius: 999px;\r\n  animation: awtsmoosAudioSpin .8s linear infinite;\r\n}\r\n\r\n@keyframes awtsmoosAudioSpin { to { transform: rotate(360deg); } }",
