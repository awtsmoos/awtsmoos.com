    "content": "// B\"H\r\nimport { createRequire } from 'module';\r\n\r\nconst require = createRequire(import.meta.url);\r\nconst md2 = require('../../merkava-binary/Md2BytecodeApi.js');\r\n\r\nfunction normalizeFiles(files = {}) {\r\n  return md2.normalizeFiles(files || {});\r\n}\r\n\r\nexport async function compileMd2Runtime(options = {}) {\r\n  return md2.compileMd2App({\r\n    files: normalizeFiles(options.files || {}),\r\n    entry: options.entry || 'index.html'\r\n  });\r\n}\r\n\r\nexport function runMd2Runtime(bytecode, options = {}) {\r\n  return md2.runMd2App(bytecode, options);\r\n}\r\n\r\nexport async function simulateMd2Runtime(options = {}) {\r\n  const compiled = await compileMd2Runtime(options);\r\n  const run = runMd2Runtime(compiled.bytecode, options.runOptions || options);\r\n  return {\r\n    BH: 'B\"H',\r\n    ok: run.ok !== false,\r\n    runtime: options.runtime || 'browser',\r\n    engine: 'md2',\r\n    entry: options.entry || 'index.html',\r\n    bytecode: {\r\n      kind: compiled.kind,\r\n      magic: compiled.magic,\r\n      bytes: compiled.bytecode.length,\r\n      base64: compiled.bytecode64\r\n    },\r\n    result: run.result,\r\n    score: run.ok === false ? 0 : 100,\r\n    suggestions: []\r\n  };\r\n}\r\n\r\nexport async function compileAndRunMd2Js(source = '', options = {}) {\r\n  return md2.compileAndRunMd2Js(source, options);\r\n}\r\n\r\nexport function inspectMd2(bytecode) {\r\n  return md2.inspectMd2(bytecode);\r\n}\r\n",
