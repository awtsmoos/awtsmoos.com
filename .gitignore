.awtsmoos.config.local.json
.Awtsmoos.local.json
.Awtsmoos.config.local.json

# The public Geelooy social application intentionally uses this namespace.
# Reveal the parent, seal every child again, then open only the browser subtree.
!geelooy/scripts/awtsmoos/
geelooy/scripts/awtsmoos/*
!geelooy/scripts/awtsmoos/social/
!geelooy/scripts/awtsmoos/social/**

# The live Mitzvah World runtime is intentionally named Awtsmoos.
# Keep this one revealed directory tracked even though generic local
# tunnel folders named Awtsmoos stay ignored everywhere else.
!geelooy/games/mitzvahWorld/experiments/Awtsmoos/
!geelooy/games/mitzvahWorld/experiments/Awtsmoos/**

