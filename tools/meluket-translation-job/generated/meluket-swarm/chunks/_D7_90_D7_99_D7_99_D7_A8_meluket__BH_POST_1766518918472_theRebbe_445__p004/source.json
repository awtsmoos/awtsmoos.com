{
  "globalIndex": 788,
  "owner": 38,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918472_theRebbe_445__p004",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918472_theRebbe_445__p004",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918472_theRebbe_445",
  "title": "מאמר לה\"ע פסח שני תשל\"ח",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יובן גם הפתגם של כ\"ק מו\"ח אדמו\"ר51"
        },
        {
          "s": 1,
          "text": "שפסח שני שייך לנפש השנית,"
        },
        {
          "s": 2,
          "text": "כי מעלת הדילוג דפסח שני על הדילוג דפסח ראשון הוא,"
        },
        {
          "s": 3,
          "text": "שהדילוג דפסח ראשון הוא מצד ההעלם וההסתר דנפש הבהמית"
        },
        {
          "s": 4,
          "text": "(נפש הראשונה),"
        },
        {
          "s": 5,
          "text": "והדילוג דפסח שני הוא שמתגלה הבל\"ג דנפש השנית שהיא חלק אלוקה ממעל ממש52."
        },
        {
          "s": 6,
          "text": "שגם בהיותה מלובשת בגוף,"
        },
        {
          "s": 7,
          "text": "היא חלק אלוקה ממעל ממש מלשון מישוש53."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ואולי יש להוסיף,"
        },
        {
          "s": 2,
          "text": "שמעלת הדילוג דפסח שני על הדילוג דפסח ראשון הוא באין ערוך,"
        },
        {
          "s": 3,
          "text": "ועד שהוא דילוג גם לגבי הדילוג דפסח"
        },
        {
          "s": 4,
          "text": "(ראשון)."
        },
        {
          "s": 5,
          "text": "וע\"ד מ\"ש54"
        },
        {
          "s": 6,
          "text": "כימי צאתך מארץ מצרים אראנו נפלאות,"
        },
        {
          "s": 7,
          "text": "שהגילויים דגאולה העתידה יהיו נפלאות גם לגבי הנפלאות שהיו ביציאת מצרים55."
        },
        {
          "s": 8,
          "text": "וביאור הענין"
        },
        {
          "s": 9,
          "text": "(השייכות דפסח שני לגאולה העתידה56)"
        },
        {
          "s": 10,
          "text": "בפרטיות יותר,"
        },
        {
          "s": 11,
          "text": "הנה איתא במדרש57"
        },
        {
          "s": 12,
          "text": "שגאולת מצרים"
        },
        {
          "s": 13,
          "text": "[וכן הגאולה מגלות בבל ושאר הגאולות עד להגאולה דלעתיד]"
        },
        {
          "s": 14,
          "text": "היא דוגמת אור הנר,"
        },
        {
          "s": 15,
          "text": "וגאולה העתידה היא כמו אור השמש שאינו נכבה."
        },
        {
          "s": 16,
          "text": "ומבואר בחסידות58,"
        },
        {
          "s": 17,
          "text": "דזה שגאולת מצרים נמשלה לאור הנר,"
        },
        {
          "s": 18,
          "text": "הוא,"
        },
        {
          "s": 19,
          "text": "כי נר הוא בחינת מלכות,"
        },
        {
          "s": 20,
          "text": "והגילוי שהי' בגאולת מצרים,"
        },
        {
          "s": 21,
          "text": "עם היותו גילוי שלמעלה מהשתלשלות,"
        },
        {
          "s": 22,
          "text": "הי' בהתלבשות בבחינת המלכות,"
        },
        {
          "s": 23,
          "text": "כמ\"ש ופסח הוי' על הפתח,"
        },
        {
          "s": 24,
          "text": "דפתח הוא מלכות"
        },
        {
          "s": 25,
          "text": "(כנ\"ל סעיף א)."
        },
        {
          "s": 26,
          "text": "ומזה מובן,"
        },
        {
          "s": 27,
          "text": "דזה שהגאולה העתידה נמשלה לאור השמש הוא כי הגילוי דלמעלה מהשתלשלות שיהי' אז יהי' בבחינת ז\"א59."
        },
        {
          "s": 28,
          "text": "וזוהי השייכות דפסח שני לגאולה העתידה,"
        },
        {
          "s": 29,
          "text": "כי הגילוי דפסח שני הוא ביסוד ז\"א,"
        },
        {
          "s": 30,
          "text": "כנ\"ל."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ויהי רצון,"
        },
        {
          "s": 2,
          "text": "שמעשינו ועבודתינו60,"
        },
        {
          "s": 3,
          "text": "ובפרט בהענינים השייכים לפסח שני,"
        },
        {
          "s": 4,
          "text": "יקרבו וימהרו עוד יותר הגאולה העתידה,"
        },
        {
          "s": 5,
          "text": "שגם הגאולה העתידה תהי' באופן של דילוג,"
        },
        {
          "s": 6,
          "text": "כדאיתא במדרש61"
        },
        {
          "s": 7,
          "text": "דקול דודי גו' מדלג על ההרים זה מלך המשיח,"
        },
        {
          "s": 8,
          "text": "ואדרבא,"
        },
        {
          "s": 9,
          "text": "בגאולה העתידה יהי' דילוג גדול יותר"
        },
        {
          "s": 10,
          "text": "(דוגמת"
        },
        {
          "s": 11,
          "text": "(אבל למעלה מ)"
        },
        {
          "s": 12,
          "text": "הדילוג דפסח שני שהוא דילוג גדול יותר מהדילוג דפסח ראשון),"
        },
        {
          "s": 13,
          "text": "שלא תהי' בסדר והדרגה מדרגא לדרגא כלל62,"
        },
        {
          "s": 14,
          "text": "כהפס\"ד63"
        },
        {
          "s": 15,
          "text": "מיד הן נגאלין,"
        },
        {
          "s": 16,
          "text": "בביאת משיח צדקנו,"
        },
        {
          "s": 17,
          "text": "יבוא ויגאלנו ויוליכנו קוממיות לארצנו,"
        },
        {
          "s": 18,
          "text": "במהרה בימינו ממש."
        }
      ]
    }
  ]
}