{
  "globalIndex": 930,
  "owner": 30,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919272_theRebbe_883__p006",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919272_theRebbe_883__p006",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919272_theRebbe_883",
  "title": "מאמר נתת ליראיך תשל\"ו",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ד)"
        },
        {
          "s": 2,
          "text": "והנה בחי' זו ישנה גם במצוות,"
        },
        {
          "s": 3,
          "text": "והם המצוות שאינן תלויין ברצונו של האדם149."
        },
        {
          "s": 4,
          "text": "והענין הוא דהנה המצוות ענינם המשכת רצון העליון,"
        },
        {
          "s": 5,
          "text": "וכלשון ברכת המצוות אשר קדשנו במצוותיו וציונו,"
        },
        {
          "s": 6,
          "text": "שהמצוות הן ציווי הקב\"ה להאדם,"
        },
        {
          "s": 7,
          "text": "שכן הוא רצון העליון,"
        },
        {
          "s": 8,
          "text": "וע\"י קיום המצוה ה\"ז מקדש את האדם."
        },
        {
          "s": 9,
          "text": "ובזה גופא ישנם ב' אופנים,"
        },
        {
          "s": 10,
          "text": "מ\"ע ומל\"ת."
        },
        {
          "s": 11,
          "text": "דבמ\"ע ההמשכה היא בגילוי משא\"כ במל\"ת,"
        },
        {
          "s": 12,
          "text": "שלכן ברכת המצוות היא רק על מ\"ע,"
        },
        {
          "s": 13,
          "text": "כי ברכה ענינה המשכה וגילוי150."
        },
        {
          "s": 14,
          "text": "אבל גם במל\"ת ישנה המשכת הרצון,"
        },
        {
          "s": 15,
          "text": "אלא שאינה באופן של ברכה והמשכה בגילוי,"
        },
        {
          "s": 16,
          "text": "וע\"ד המבואר בתו\"א151"
        },
        {
          "s": 17,
          "text": "לענין הברכה על תפילין של ראש,"
        },
        {
          "s": 18,
          "text": "דנחלקו הספרדים והאשכנזים אם יברכו עליהם ברכה מיוחדת,"
        },
        {
          "s": 19,
          "text": "ומנהג ספרד שלא לברך דס\"ל שאי אפשר להמשיך המקיף ההוא ע\"י ברכה,"
        },
        {
          "s": 20,
          "text": "כ\"א נמשך מאליו152."
        },
        {
          "s": 21,
          "text": "ועד\"ז מל\"ת שאין מברכין עליהם,"
        },
        {
          "s": 22,
          "text": "כי ההמשכה היא מאלי' ומעצמה153."
        },
        {
          "s": 23,
          "text": "ולמעלה יותר הם המצוות שאינן תלויות כלל ברצון האדם,"
        },
        {
          "s": 24,
          "text": "ע\"ד המצוה דנשיאות דכל הבורח מן הכבוד כו'154,"
        },
        {
          "s": 25,
          "text": "ומצות שכחה."
        },
        {
          "s": 26,
          "text": "והטעם שאינן תלויין כלל ברצונו של האדם הוא לפי ששרשם הוא למעלה מבחי' רצון העליון."
        },
        {
          "s": 27,
          "text": "ובספירות הוא,"
        },
        {
          "s": 28,
          "text": "שהמצוות בכלל הן מבחי' א\"א,"
        },
        {
          "s": 29,
          "text": "רצון העליון,"
        },
        {
          "s": 30,
          "text": "ומצוות שאינן תלויין ברצון האדם שרשם מבחי' עתיק,"
        },
        {
          "s": 31,
          "text": "שנעתק ונבדל מכל סדר השתלשלות,"
        },
        {
          "s": 32,
          "text": "גם מבחי' א\"א,"
        },
        {
          "s": 33,
          "text": "וכמבואר בארוכה בלקו\"ת ס\"פ ברכה155."
        },
        {
          "s": 34,
          "text": "וזוהי בחי' הגורל שבמצוות,"
        },
        {
          "s": 35,
          "text": "שעל ידה נמשך אור נעלה יותר מהאור הנמשך ע\"י מ\"ע ומל\"ת סתם."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "ועד\"ז ישנה בחי' הגורל בכאו\"א מישראל."
        },
        {
          "s": 1,
          "text": "דכמו שנת\"ל בענין הנסיונות,"
        },
        {
          "s": 2,
          "text": "דנתת ליראיך נס להתנוסס גו' קאי על כאו\"א מישראל,"
        },
        {
          "s": 3,
          "text": "הנה כמו\"כ הוא בבחי' הגורל,"
        },
        {
          "s": 4,
          "text": "שישנה בכאו\"א מישראל."
        },
        {
          "s": 5,
          "text": "וכמש\"א156"
        },
        {
          "s": 6,
          "text": "אשרנו מה טוב חלקנו ומה נעים גורלנו,"
        },
        {
          "s": 7,
          "text": "היינו שאצל כאו\"א מישראל ישנם לא רק חלקנו כ\"א גם גורלנו,"
        },
        {
          "s": 8,
          "text": "שעי\"ז הוא מיוחד עם הקב\"ה."
        },
        {
          "s": 9,
          "text": "ועוד זאת,"
        },
        {
          "s": 10,
          "text": "שבחי' זו באה לידי ביטוי בענין של מעשה בפועל."
        },
        {
          "s": 11,
          "text": "וע\"ד המבואר באגה\"ק157"
        },
        {
          "s": 12,
          "text": "בענין המצוה דהוה זהיר בה טפי158,"
        },
        {
          "s": 13,
          "text": "שכאו\"א מישראל יש לו מצוה מיוחדה שצ\"ל זהיר בה טפי,"
        },
        {
          "s": 14,
          "text": "והיא בחי' הגורל ממש."
        },
        {
          "s": 15,
          "text": "ועז\"נ159"
        },
        {
          "s": 16,
          "text": "אתה תומיך גורלי,"
        },
        {
          "s": 17,
          "text": "שבחי' הגורל היא מאתה,"
        },
        {
          "s": 18,
          "text": "עצמותו ומהותו ית'."
        },
        {
          "s": 19,
          "text": "וכנ\"ל דבחי' הגורל"
        },
        {
          "s": 20,
          "text": "(באדם התחתון)"
        },
        {
          "s": 21,
          "text": "היא למעלה מכחות הפנימיים שלו,"
        },
        {
          "s": 22,
          "text": "שהם בחי' השתלשלות שבאדם,"
        },
        {
          "s": 23,
          "text": "ולמעלה גם מבחי' המקיפים שבערך הפנימיים,"
        },
        {
          "s": 24,
          "text": "שהו\"ע הרצון,"
        },
        {
          "s": 25,
          "text": "והוא ע\"ד בחי' עתיק שנעתק גם מבחי' א\"א."
        },
        {
          "s": 26,
          "text": "וזהו אתה תומיך גורלי,"
        },
        {
          "s": 27,
          "text": "שהוא בחי' יחידה שבנפש,"
        },
        {
          "s": 28,
          "text": "הניצוץ נברא שבו מתלבש הניצוץ בורא,"
        },
        {
          "s": 29,
          "text": "שלכן נקראת בשם יחידה"
        },
        {
          "s": 30,
          "text": "(וזה שמה אשר יקראו לה160),"
        },
        {
          "s": 31,
          "text": "כי היא"
        },
        {
          "s": 32,
          "text": "(שם ו)"
        },
        {
          "s": 33,
          "text": "כלי לבחי' יחיד161,"
        },
        {
          "s": 34,
          "text": "שהוא הניצוץ בורא,"
        },
        {
          "s": 35,
          "text": "העצמות של כאו\"א מבנ\"י."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ו)"
        },
        {
          "s": 2,
          "text": "וזהו מה שממשיך בהכתוב162"
        },
        {
          "s": 3,
          "text": "למען יחלצון ידידיך הושיעה ימינך וענני."
        },
        {
          "s": 4,
          "text": "דמזה שאומר למען גו' מובן,"
        },
        {
          "s": 5,
          "text": "שכתוב זה הוא המשך להכתוב הקודם נתת ליראיך נס גו'."
        },
        {
          "s": 6,
          "text": "והיינו דזה שנתת ליראיך נס להתנוסס גו',"
        },
        {
          "s": 7,
          "text": "שהו\"ע עבודת הנסיונות,"
        },
        {
          "s": 8,
          "text": "הוא בכדי"
        },
        {
          "s": 9,
          "text": "(למען)"
        },
        {
          "s": 10,
          "text": "שיהי' יחלצון ידידיך הושיעה ימינך גו'."
        },
        {
          "s": 11,
          "text": "והענין הוא דהנה איתא במדרש163"
        },
        {
          "s": 12,
          "text": "עה\"פ164"
        },
        {
          "s": 13,
          "text": "השיב אחור ימינו,"
        },
        {
          "s": 14,
          "text": "דקאי על ימינו של הקב\"ה,"
        },
        {
          "s": 15,
          "text": "דבזמן הגלות נאמר השיב אחור ימינו,"
        },
        {
          "s": 16,
          "text": "ובעת הגאולה אותה ימין שהיא משועבדת כו' גאלתי את ימיני כו'"
        },
        {
          "s": 17,
          "text": "(ועי\"ז נעשה ג\"כ גאולת ימין של כאו\"א מישראל)."
        },
        {
          "s": 18,
          "text": "וזהו הקשר לענין הנסיונות,"
        },
        {
          "s": 19,
          "text": "כי בחי' ימין נמשכת ע\"י העבודה דגורל,"
        },
        {
          "s": 20,
          "text": "וכמו שמביא במדרש שם"
        },
        {
          "s": 21,
          "text": "(ע\"ז שבעת הגאולה תהי' גאולת ימינו של הקב\"ה)"
        },
        {
          "s": 22,
          "text": "מש\"נ בדניאל165"
        },
        {
          "s": 23,
          "text": "ואתה לך גו' ותעמוד לגורלך לקץ הימין."
        },
        {
          "s": 24,
          "text": "כי ימין שייכת להגורל."
        },
        {
          "s": 25,
          "text": "וביאור הענין הוא166,"
        },
        {
          "s": 26,
          "text": "דאיתא במדרש שם שא\"ל קץ הימים או קץ167"
        },
        {
          "s": 27,
          "text": "הימין,"
        },
        {
          "s": 28,
          "text": "א\"ל קץ167"
        },
        {
          "s": 29,
          "text": "הימין."
        },
        {
          "s": 30,
          "text": "ומבאר בהדרושים168"
        },
        {
          "s": 31,
          "text": "דימין קאי על ימין שבא\"א,"
        },
        {
          "s": 32,
          "text": "ולמעלה יותר,"
        },
        {
          "s": 33,
          "text": "בחי' ימין שלמעלה מא\"א"
        },
        {
          "s": 34,
          "text": "(שהו\"ע הרצון,"
        },
        {
          "s": 35,
          "text": "כ\"א),"
        },
        {
          "s": 36,
          "text": "שהוא עתיק שכולא ימינא דלית שמאלא בהאי עתיקא169."
        },
        {
          "s": 37,
          "text": "דבחי' זו ישנה גם בזמן הגלות וכמש\"נ170"
        },
        {
          "s": 38,
          "text": "ימין ה' רוממה ימין ה' עושה חיל,"
        },
        {
          "s": 39,
          "text": "אלא שבזמן הגלות היא בבחי' העלם שאינה מאירה בגילוי בנפש האדם."
        },
        {
          "s": 40,
          "text": "אבל כאשר האדם עובד עבודתו מצד ימין שבנפשו,"
        },
        {
          "s": 41,
          "text": "העבודה מצד עצם נפשו"
        },
        {
          "s": 42,
          "text": "(שלמעלה מן הרצון,"
        },
        {
          "s": 43,
          "text": "מקיף הקרוב),"
        },
        {
          "s": 44,
          "text": "שהו\"ע הגורל,"
        },
        {
          "s": 45,
          "text": "הנה עי\"ז ותעמוד לגורלך לקץ הימין,"
        },
        {
          "s": 46,
          "text": "שגורל שבאדם ממשיך גורל שלמעלה,"
        },
        {
          "s": 47,
          "text": "דאתה תומיך גורלי כנ\"ל,"
        },
        {
          "s": 48,
          "text": "שהוא בחי' עתיק."
        },
        {
          "s": 49,
          "text": "והנה ע\"י ימין,"
        },
        {
          "s": 50,
          "text": "עתיק,"
        },
        {
          "s": 51,
          "text": "נעשה ג\"כ הושיעה ימינך וענני,"
        },
        {
          "s": 52,
          "text": "שנגאל הימין דהשיב אחור ימינו שהיתה משועבדת."
        },
        {
          "s": 53,
          "text": "וזהו הקישור שבין ב' הענינים שבקץ הימין,"
        },
        {
          "s": 54,
          "text": "הא' ימין עצמה,"
        },
        {
          "s": 55,
          "text": "שהיא עתיק כנ\"ל,"
        },
        {
          "s": 56,
          "text": "והב' קץ הימין דקאי על ספירת המלכות171"
        },
        {
          "s": 57,
          "text": "(שלכן נקרא קץ לשון סוף ותכלית,"
        },
        {
          "s": 58,
          "text": "כי תכלית וסוף ההמשכה דבחי' ימין הוא במלכות172),"
        },
        {
          "s": 59,
          "text": "דספירת המלכות היא למטה מכל הספירות,"
        },
        {
          "s": 60,
          "text": "עד שרגלי' יורדות כו'173,"
        },
        {
          "s": 61,
          "text": "עד לירידה בעולם התחתון שאין תחתון למטה ממנו."
        },
        {
          "s": 62,
          "text": "ודוקא בעבודה זו לגאול קץ הימין מירידתה למטה בא לידי גילוי ימין דותעמוד לגורלך לקץ הימין,"
        },
        {
          "s": 63,
          "text": "עתיק."
        },
        {
          "s": 64,
          "text": "וע\"ד משנת\"ל דדוקא בעבודת הנסיונות,"
        },
        {
          "s": 65,
          "text": "שהיא בענינים תחתונים ביותר,"
        },
        {
          "s": 66,
          "text": "ובעיקר בנסיונות דדרא דעקבתא דמשיחא,"
        },
        {
          "s": 67,
          "text": "שאז חושך הגלות הוא כפול ומכופל,"
        },
        {
          "s": 68,
          "text": "באה לידי גילוי העבודה שמצד יחידה."
        },
        {
          "s": 69,
          "text": "וזהו הקישור בין נתת ליראיך נס להתנוסס גו' ללמען יחלצון ידידיך הושיעה ימינך וענני,"
        },
        {
          "s": 70,
          "text": "כי ע\"י עבודת הנסיונות נגאל הימין."
        }
      ]
    }
  ]
}