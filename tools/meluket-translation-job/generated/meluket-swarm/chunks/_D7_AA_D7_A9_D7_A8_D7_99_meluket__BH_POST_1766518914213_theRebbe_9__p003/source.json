{
  "globalIndex": 90,
  "owner": 40,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914213_theRebbe_9__p003",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914213_theRebbe_9__p003",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914213_theRebbe_9",
  "title": "מאמר בסוכות תשבו תשל\"ח",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וביאור הענין הוא,"
        },
        {
          "s": 2,
          "text": "דהנה כתיב19"
        },
        {
          "s": 3,
          "text": "בכסה ליום חגינו,"
        },
        {
          "s": 4,
          "text": "דיום חגינו קאי על חג הסוכות כמבואר בכ\"מ20."
        },
        {
          "s": 5,
          "text": "וזהו בכסה ליום חגינו,"
        },
        {
          "s": 6,
          "text": "שכל הענינים שהיו בכסה"
        },
        {
          "s": 7,
          "text": "(בכיסוי והעלם)"
        },
        {
          "s": 8,
          "text": "בהימים שלפני יום חגינו,"
        },
        {
          "s": 9,
          "text": "ובפרט הענינים שהיו בכיסוי והעלם בראש השנה"
        },
        {
          "s": 10,
          "text": "[שעליו נאמר בכסה מלשון ליום הכסה יבוא ביתו21,"
        },
        {
          "s": 11,
          "text": "וע\"ז קאי מש\"כ תקעו בחדש שופר"
        },
        {
          "s": 12,
          "text": "(בהקדמה לבכסה ליום חגינו)],"
        },
        {
          "s": 13,
          "text": "מתגלים הם בסוכות."
        },
        {
          "s": 14,
          "text": "וכדאיתא במדרש22"
        },
        {
          "s": 15,
          "text": "דבראש השנה לית אנן ידעין מאן הוא נוצח,"
        },
        {
          "s": 16,
          "text": "וכשישראל יוצאין כו' ולולביהון ואתרוגיהון בידן אנן ידעין דישראל אינון ניצוחיא."
        },
        {
          "s": 17,
          "text": "והיינו,"
        },
        {
          "s": 18,
          "text": "שבסוכות נתגלה דאנן ניצוחיא,"
        },
        {
          "s": 19,
          "text": "ובאופן גלוי לכל יושבי תבל,"
        },
        {
          "s": 20,
          "text": "עד שכל מציאות העולם רואה שאנן ניצוחיא."
        },
        {
          "s": 21,
          "text": "ואע\"פ שהנצחון דישראל כבר הי' בראש השנה,"
        },
        {
          "s": 22,
          "text": "וכמאמר המדרש23"
        },
        {
          "s": 23,
          "text": "איזו אומה כאומה זו שיודעת אופי' של אלקי',"
        },
        {
          "s": 24,
          "text": "שישראל יודעים שהקב\"ה יעשה להם נס ויזכו בדין,"
        },
        {
          "s": 25,
          "text": "וא\"כ דבר פשוט הוא שביום ראש השנה הי' להם כתיבה וחתימה טובה,"
        },
        {
          "s": 26,
          "text": "מ\"מ תכלית הכוונה והשלימות הוא שנצחון זה יהי' בגילוי."
        },
        {
          "s": 27,
          "text": "וזה נעשה בחג הסוכות,"
        },
        {
          "s": 28,
          "text": "בכסה ליום חגינו,"
        },
        {
          "s": 29,
          "text": "שהנצחון שהי' בכסה"
        },
        {
          "s": 30,
          "text": "(בהעלם)"
        },
        {
          "s": 31,
          "text": "בראש השנה נמשך בגלוי ביום חגינו,"
        },
        {
          "s": 32,
          "text": "ועי\"ז באים לתכלית השלימות."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה יום הכפורים נקרא ראש השנה בקרא24"
        },
        {
          "s": 2,
          "text": "כמובא בלקו\"ת25."
        },
        {
          "s": 3,
          "text": "ובסדר הימים הנה יום הכפורים הוא בעשור לחדש השביעי,"
        },
        {
          "s": 4,
          "text": "ובתחלת החדש,"
        },
        {
          "s": 5,
          "text": "באחד לחדש השביעי הוא ראש השנה."
        },
        {
          "s": 6,
          "text": "ויתירה מזו,"
        },
        {
          "s": 7,
          "text": "הנה אמרז\"ל26"
        },
        {
          "s": 8,
          "text": "אלו עשרה ימים שבין ראש השנה ליום הכפורים,"
        },
        {
          "s": 9,
          "text": "היינו שראש השנה ויום הכפורים נכללים באותן עשרת הימים27"
        },
        {
          "s": 10,
          "text": "(וענינם ענין אחד)."
        },
        {
          "s": 11,
          "text": "ומזה מובן שביום הכפורים נמשך ענין מיוחד השייך לההמשכה דראש השנה."
        },
        {
          "s": 12,
          "text": "והענין הוא,"
        },
        {
          "s": 13,
          "text": "כמבואר בלקו\"ת25"
        },
        {
          "s": 14,
          "text": "שביום הכפורים הוא ההמשכה דבחי' נשמה ופנימיות,"
        },
        {
          "s": 15,
          "text": "וכיון שההמשכה בבחי' פנימיות היא בענין עיקרי,"
        },
        {
          "s": 16,
          "text": "מובן שגם בכל שאר הענינים ההמשכה דיום הכפורים היא בבחי' פנימיות."
        },
        {
          "s": 17,
          "text": "אמנם גם המשכה זו שביום הכפורים עדיין היא באופן דבכסה."
        },
        {
          "s": 18,
          "text": "וההמשכה באופן דאנן ניצוחיא ובגלוי"
        },
        {
          "s": 19,
          "text": "[עד שהוא גילוי באופן כזה שנעשה על ידה זמן שמחתנו,"
        },
        {
          "s": 20,
          "text": "ששמחה היא על דבר שבגלוי דוקא,"
        },
        {
          "s": 21,
          "text": "כידוע28]"
        },
        {
          "s": 22,
          "text": "היא ביום חגינו"
        },
        {
          "s": 23,
          "text": "(חג הסוכות)"
        },
        {
          "s": 24,
          "text": "דוקא,"
        },
        {
          "s": 25,
          "text": "בחמשה עשר לחדש,"
        },
        {
          "s": 26,
          "text": "כשקיימא סיהרא באשלמותא,"
        },
        {
          "s": 27,
          "text": "כמבואר בכ\"מ."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ובזה יובן מה שמצינו קשר בין תקיעת שופר לסוכות,"
        },
        {
          "s": 2,
          "text": "וכידוע29"
        },
        {
          "s": 3,
          "text": "שסכך"
        },
        {
          "s": 4,
          "text": "[דכל סוכות הכתוב סכך משמע30,"
        },
        {
          "s": 5,
          "text": "וכמו שמבאר כ\"ק אדמו\"ר הזקן בשו\"ע הל' סוכה31"
        },
        {
          "s": 6,
          "text": "דאין נקרא סוכה אלא הסכך בלבד."
        },
        {
          "s": 7,
          "text": "דהיינו,"
        },
        {
          "s": 8,
          "text": "שלא רק שהסכך הוא עיקר הסוכה אלא עוד זאת שבענין הסכך מתבטא"
        },
        {
          "s": 9,
          "text": "(גיט זיך ארויס)"
        },
        {
          "s": 10,
          "text": "כל ענין הסוכה]"
        },
        {
          "s": 11,
          "text": "בגימט' מאה,"
        },
        {
          "s": 12,
          "text": "כנגד מאה קולות דשופר שנהגו ישראל32"
        },
        {
          "s": 13,
          "text": "לתקוע בראש השנה."
        },
        {
          "s": 14,
          "text": "וטעם הדבר הוא כנ\"ל היות שענין הסוכה נמשך ע\"י התקיעת שופר דראש השנה."
        },
        {
          "s": 15,
          "text": "שבראש השנה ההמשכה"
        },
        {
          "s": 16,
          "text": "(שממשיכים בתקיעת שופר ע\"י המאה קולות)"
        },
        {
          "s": 17,
          "text": "היא באופן דבכסה"
        },
        {
          "s": 18,
          "text": "(בהעלם)"
        },
        {
          "s": 19,
          "text": "ואח\"כ באה לידי גילוי בחג הסוכות"
        },
        {
          "s": 20,
          "text": "(ליום חגינו)"
        },
        {
          "s": 21,
          "text": "בסכך הסוכה."
        },
        {
          "s": 22,
          "text": "ועד\"ז הוא גם בנוגע ליום הכפורים,"
        },
        {
          "s": 23,
          "text": "כידוע שסכך הסוכה הוא דוגמת ענני הכבוד"
        },
        {
          "s": 24,
          "text": "[כהדעה בגמרא33"
        },
        {
          "s": 25,
          "text": "ענני כבוד היו,"
        },
        {
          "s": 26,
          "text": "וכן הובא לפסק הלכה בשו\"ע אדה\"ז בהל' סוכות בתחלתם],"
        },
        {
          "s": 27,
          "text": "והוא נמשך מענן הקטרת דיוה\"כ."
        },
        {
          "s": 28,
          "text": "וביאור הענין הוא,"
        },
        {
          "s": 29,
          "text": "כנ\"ל דתחלה באה ההמשכה דראש השנה בבחי' פנימיות ביום הכפורים."
        },
        {
          "s": 30,
          "text": "והמשכה זו שביום הכפורים היא ע\"י ענין הקטרת שממנו הי' צ\"ל וכסה ענן הקטרת את הכפרת34,"
        },
        {
          "s": 31,
          "text": "ובכללות יותר זהו ע\"י כללות עבודת כהן גדול ביום הכפורים בקדש הקדשים."
        },
        {
          "s": 32,
          "text": "ומענן הקטרת שביום הכפורים נמשך אח\"כ סכך הסוכה"
        },
        {
          "s": 33,
          "text": "(שהסוכה היא ע\"ש ענני הכבוד)."
        }
      ]
    }
  ]
}