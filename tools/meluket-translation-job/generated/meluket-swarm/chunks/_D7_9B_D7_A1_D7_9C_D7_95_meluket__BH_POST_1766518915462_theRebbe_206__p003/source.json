{
  "globalIndex": 296,
  "owner": 46,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915462_theRebbe_206__p003",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915462_theRebbe_206__p003",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915462_theRebbe_206",
  "title": "מאמר א\"ר אושעיא תשל\"ט",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה אף שנקודת היראת שמים שלמעלה מהשכל היא למעלה מהגבלה,"
        },
        {
          "s": 2,
          "text": "מ\"מ,"
        },
        {
          "s": 3,
          "text": "יש בה"
        },
        {
          "s": 4,
          "text": "(בהתגלותה)"
        },
        {
          "s": 5,
          "text": "כו\"כ מדריגות,"
        },
        {
          "s": 6,
          "text": "ואמיתית הבל\"ג שבה יהי' לעתיד לבוא."
        },
        {
          "s": 7,
          "text": "וזהו שלע\"ל"
        },
        {
          "s": 8,
          "text": "(דוקא)"
        },
        {
          "s": 9,
          "text": "יהי' פרזות תשב ירושלים,"
        },
        {
          "s": 10,
          "text": "ופי' רש\"י41"
        },
        {
          "s": 11,
          "text": "שלא יהא לה קצב ושיעור כו'."
        },
        {
          "s": 12,
          "text": "וגם אז יהיו בה עליות לאין קץ,"
        },
        {
          "s": 13,
          "text": "כמ\"ש רש\"י41"
        },
        {
          "s": 14,
          "text": "שתגדל מיום ליום."
        },
        {
          "s": 15,
          "text": "וזהו צדקת פרזונו בישראל כו' צדקה עשה הקב\"ה בישראל שפיזרן לבין האומות,"
        },
        {
          "s": 16,
          "text": "דזה שנאמר בכתוב ענין זה"
        },
        {
          "s": 17,
          "text": "(צדקה כו' שפיזרן כו')"
        },
        {
          "s": 18,
          "text": "בלשון פרזונו הוא,"
        },
        {
          "s": 19,
          "text": "כי הצדקה שעשה הקב\"ה בישראל ע\"י שפיזרן לבין האומות הוא שעי\"ז יגיעו לפרזונו שלמעלה ממדידה והגבלה."
        },
        {
          "s": 20,
          "text": "ושני ענינים בזה."
        },
        {
          "s": 21,
          "text": "שע\"י המניעות ועכובים שבזמן הגלות"
        },
        {
          "s": 22,
          "text": "(פיזרן לבין האומות)"
        },
        {
          "s": 23,
          "text": "מתעוררת ומתגלה נקודת היראת שמים שבכל אחד מישראל"
        },
        {
          "s": 24,
          "text": "(כמבואר בארוכה בהמאמר42)"
        },
        {
          "s": 25,
          "text": "שהיא למעלה ממדידה והגבלה."
        },
        {
          "s": 26,
          "text": "ויתירה מזו,"
        },
        {
          "s": 27,
          "text": "דענין פרזונו רומז"
        },
        {
          "s": 28,
          "text": "(כמובא לעיל סעיף ג מהמאמר)"
        },
        {
          "s": 29,
          "text": "על פרזות תשב ירושלים,"
        },
        {
          "s": 30,
          "text": "שע\"י התעוררות נקודת היראת שמים בזמן הגלות,"
        },
        {
          "s": 31,
          "text": "תהי' אח\"כ הוספה ועלי' בנקודת היראת שמים,"
        },
        {
          "s": 32,
          "text": "הבל\"ג שבה כמו שיהי' לע\"ל."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "דבפרזות תשב ירושלים"
        },
        {
          "s": 3,
          "text": "(נקודת היראת שמים)"
        },
        {
          "s": 4,
          "text": "שני ענינים."
        },
        {
          "s": 5,
          "text": "שנקודת היראת שמים עצמה היא למעלה מהגבלה"
        },
        {
          "s": 6,
          "text": "(כנ\"ל סעיף ה),"
        },
        {
          "s": 7,
          "text": "וגם התפשטותה43"
        },
        {
          "s": 8,
          "text": "היא בלי גבול."
        },
        {
          "s": 9,
          "text": "ובזה גופא שני ענינים."
        },
        {
          "s": 10,
          "text": "שנקודת היראת שמים פועלת בכל כחות הנפש שיהיו בהתאם להנקודה,"
        },
        {
          "s": 11,
          "text": "ושגם הנקודה עצמה מתפשטת בכל כחות הנפש44,"
        },
        {
          "s": 12,
          "text": "עד בהלבושים דמחשבה דיבור ומעשה."
        },
        {
          "s": 13,
          "text": "ובדוגמת פרזות תשב ירושלים כפשוטה,"
        },
        {
          "s": 14,
          "text": "דנוסף לזה שירושלים היא נקודה דאמצעו של העולם ומאבן שתי' שבבית המקדש הושתת כל העולם45,"
        },
        {
          "s": 15,
          "text": "הנה גם ירושלים עצמה תתפשט בכל העולם,"
        },
        {
          "s": 16,
          "text": "דעתידה ירושלים שתתפשט בכל ארץ ישראל ועתידה ארץ ישראל שתתפשט בכל הארצות46."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ולכאורה יש להוסיף,"
        },
        {
          "s": 2,
          "text": "דזה שנאמר פרזונו"
        },
        {
          "s": 3,
          "text": "(ולא פזרונו),"
        },
        {
          "s": 4,
          "text": "ענין פרזות תשב ירושלים,"
        },
        {
          "s": 5,
          "text": "שייך גם להצדקה שפיזרן שמבאר בתחלת המאמר,"
        },
        {
          "s": 6,
          "text": "שעסק התומ\"צ של ישראל הנמצאים במקומות הרווחה נותן כח ועוז לישראל הנמצאים במקום הגזירה שיוכלו ללמוד תורה ולקיים מצוות."
        },
        {
          "s": 7,
          "text": "כי זה שעסק התומ\"צ של אחד נותן כח ועוז לשני הוא לפי שכל ישראל הם מציאות אחת,"
        },
        {
          "s": 8,
          "text": "בפרט מצד נקודת היראת שמים והביטול שבהם,"
        },
        {
          "s": 9,
          "text": "שהיא נקודה המאחדת את כל ישראל."
        },
        {
          "s": 10,
          "text": "ולכן,"
        },
        {
          "s": 11,
          "text": "בכדי שהעסק דתומ\"צ של אחד יתן כח ועוז לאחר"
        },
        {
          "s": 12,
          "text": "(ענין הצדקה בזה שפיזרן)"
        },
        {
          "s": 13,
          "text": "הוא כשעסק התומ\"צ שלו הוא בהנקודה דיראת שמים,"
        },
        {
          "s": 14,
          "text": "פרזות תשב ירושלים,"
        },
        {
          "s": 15,
          "text": "שהיראת שמים שלו"
        },
        {
          "s": 16,
          "text": "(ירושלים)"
        },
        {
          "s": 17,
          "text": "היא באופן דופרצת47"
        },
        {
          "s": 18,
          "text": "ימה וקדמה וצפונה ונגבה,"
        },
        {
          "s": 19,
          "text": "שמתפשטת וחודרת בכל כחות הנפש,"
        },
        {
          "s": 20,
          "text": "עד במחשבה דיבור ומעשה שלו."
        }
      ]
    }
  ]
}