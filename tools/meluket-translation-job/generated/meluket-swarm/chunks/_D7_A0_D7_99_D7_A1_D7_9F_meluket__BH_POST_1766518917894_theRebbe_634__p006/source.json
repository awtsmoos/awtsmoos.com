{
  "globalIndex": 703,
  "owner": 3,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917894_theRebbe_634__p006",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917894_theRebbe_634__p006",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917894_theRebbe_634",
  "title": "מאמר כימי צאתך תשי\"ב",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "שזהו גם מהביאורים בזה שהגילויים דלעתיד לבוא תלויים במעשינו ועבודתינו בזמן הגלות דוקא45,"
        },
        {
          "s": 3,
          "text": "כי אמיתית ענין הביטול הוא בעיקר בהעבודה שבזמן הגלות."
        },
        {
          "s": 4,
          "text": "דבהביטול שהי' בזמן הבית,"
        },
        {
          "s": 5,
          "text": "כיון שהי' אז השגת אלקות ובעלותם לרגל גם ראי' באלקות46,"
        },
        {
          "s": 6,
          "text": "היתה נרגשת גם מציאותו של האדם המשיג והרואה,"
        },
        {
          "s": 7,
          "text": "ובזמן הגלות,"
        },
        {
          "s": 8,
          "text": "ובפרט בדרא דעקבתא דמשיחא,"
        },
        {
          "s": 9,
          "text": "העבודה היא בביטול דקבלת עול,"
        },
        {
          "s": 10,
          "text": "והביטול דקב\"ע הוא לא מצד מציאותו של האדם אלא מצד האלקות."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "וזהו מה שמבואר במאמרי רבותינו נשיאינו47"
        },
        {
          "s": 1,
          "text": "בפירוש הכתוב48"
        },
        {
          "s": 2,
          "text": "והאיש משה עניו מאד מכל האדם אשר על פני האדמה,"
        },
        {
          "s": 3,
          "text": "שבעיקר הי' זה מפני דרא דעקבתא דמשיחא,"
        },
        {
          "s": 4,
          "text": "שגדלו ההעלמות וההסתרים,"
        },
        {
          "s": 5,
          "text": "ובכ\"ז עומדים בתוקף עצום ולומדים תורה ומקיימים מצוות במס\"נ,"
        },
        {
          "s": 6,
          "text": "הנה לכן"
        },
        {
          "s": 7,
          "text": "(בל' המאמר49)"
        },
        {
          "s": 8,
          "text": "איז משה רבינו באַיי זיך אַראָפּ גיפאַלין."
        },
        {
          "s": 9,
          "text": "שהביטול דמשה,"
        },
        {
          "s": 10,
          "text": "ונחנו מה50,"
        },
        {
          "s": 11,
          "text": "הוא הביטול דיחו\"ע,"
        },
        {
          "s": 12,
          "text": "והעבודה שבדרא דעקבתא דמשיחא היא בהביטול דקב\"ע ומס\"נ,"
        },
        {
          "s": 13,
          "text": "וביטול במציאות איז באַ זיך אַראָפּגעפאַלן מפני הביטול דקב\"ע ומס\"נ."
        },
        {
          "s": 14,
          "text": "וזהו שהגילויים דלע\"ל תלויים במעשינו ועבודתינו שבזמן הגלות דוקא,"
        },
        {
          "s": 15,
          "text": "כי עיקר החידוש בהגילויים דלע\"ל הוא שאז יתגלה העילוי דהמשכת אור הבל\"ג בהטבע ובגוף הגשמי,"
        },
        {
          "s": 16,
          "text": "שהביטול שלהם הוא לא מצד מציאותם אלא מצד האלקות,"
        },
        {
          "s": 17,
          "text": "וגילוי זה הוא ע\"י הביטול דקב\"ע ומס\"נ שבזמן הגלות."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "והנה אף שהנסים שהיו ביציאת מצרים היו למעלה מהטבע,"
        },
        {
          "s": 3,
          "text": "וענין אראנו נפלאות"
        },
        {
          "s": 4,
          "text": "[התלבשות הנסים בטבע ושאעפ\"כ הנסים הם בגילוי]"
        },
        {
          "s": 5,
          "text": "יהי' רק בגאולה העתידה,"
        },
        {
          "s": 6,
          "text": "מ\"מ,"
        },
        {
          "s": 7,
          "text": "ע\"פ הידוע51"
        },
        {
          "s": 8,
          "text": "שפתיחת הצנור דכל הגאולות,"
        },
        {
          "s": 9,
          "text": "גם דגאולה העתידה,"
        },
        {
          "s": 10,
          "text": "היתה בהגאולה דיציאת מצרים,"
        },
        {
          "s": 11,
          "text": "יש לומר,"
        },
        {
          "s": 12,
          "text": "שגם ביציאת מצרים הי' הענין דאראנו נפלאות."
        },
        {
          "s": 13,
          "text": "אלא שענין זה הי' אז בהעלם."
        },
        {
          "s": 14,
          "text": "ולעתיד יהי' זה בגילוי."
        },
        {
          "s": 15,
          "text": "וזהו כימי צאתך מארץ מצרים אראנו נפלאות,"
        },
        {
          "s": 16,
          "text": "שהכתוב מדמה הנפלאות שיהיו בגאולה העתידה להנפלאות שהיו ביציאת מצרים,"
        },
        {
          "s": 17,
          "text": "אף שהנסים והנפלאות שבגאולה העתידה יהיו ממנו ית' לבדו"
        },
        {
          "s": 18,
          "text": "(שלא ע\"י בית דינו,"
        },
        {
          "s": 19,
          "text": "כהנסים שהיו ביצי\"מ)52,"
        },
        {
          "s": 20,
          "text": "כי ביציאת מצרים נפתח הצנור והיו אז בהעלם גם הנפלאות דלע\"ל."
        }
      ]
    }
  ]
}