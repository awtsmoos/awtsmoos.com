{
  "globalIndex": 517,
  "owner": 17,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916782_theRebbe_480__p007",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916782_theRebbe_480__p007",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916782_theRebbe_480",
  "title": "מאמר באתי לגני תשכ\"ט",
  "part": 7,
  "sections": [
    {
      "v": 18,
      "items": [
        {
          "s": 0,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 1,
          "text": "דצריך להבין,"
        },
        {
          "s": 2,
          "text": "הרי גם ע\"י העבודה דנפש האלקית מצד עצמה,"
        },
        {
          "s": 3,
          "text": "כמו בעבודת התפלה בהתבוננות באלקות בענינים שאינם שייכים לנה\"ב וכן בעסק התורה,"
        },
        {
          "s": 4,
          "text": "נמשך תוספות אור בנפש האלקית,"
        },
        {
          "s": 5,
          "text": "דכל תוספות אור"
        },
        {
          "s": 6,
          "text": "[ובפרט שהתוספות אור שנמשך ע\"י התפלה ועסק התורה הוא תוספות שמרובה על העיקר]"
        },
        {
          "s": 7,
          "text": "הוא מהאור מקיף,"
        },
        {
          "s": 8,
          "text": "ומהו היתרון שנעשה ע\"י בירור החושך דוקא."
        },
        {
          "s": 9,
          "text": "[ויש לומר,"
        },
        {
          "s": 10,
          "text": "דזה שמביא בהמאמר דוגמא מעבודת התפלה"
        },
        {
          "s": 11,
          "text": "(עבודה)"
        },
        {
          "s": 12,
          "text": "ועסק התורה ולא מקיום המצוות"
        },
        {
          "s": 13,
          "text": "(גמ\"ח),"
        },
        {
          "s": 14,
          "text": "כי המצוות,"
        },
        {
          "s": 15,
          "text": "מכיון שענינם הוא107"
        },
        {
          "s": 16,
          "text": "ציוויים להאדם והכוונה בהם היא בכדי לצרף את הבריות108,"
        },
        {
          "s": 17,
          "text": "בהכרח שהבירור שנעשה על ידם בהגוף ונה\"ב הוא בגילוי קצת"
        },
        {
          "s": 18,
          "text": "(גם כשקיום המצוות שלו היא באופן דעבודת הנשמה מצד עצמה109),"
        },
        {
          "s": 19,
          "text": "משא\"כ עסק התורה,"
        },
        {
          "s": 20,
          "text": "מכיון שהתורה היא דבר ה',"
        },
        {
          "s": 21,
          "text": "חכמתו של הקב\"ה,"
        },
        {
          "s": 22,
          "text": "אלא שירדה למטה ונתלבשה בשכל האדם,"
        },
        {
          "s": 23,
          "text": "לכן אפשר שלא יהי' נרגש הבירור והזיכוך דמוח הגשמי שנעשה עי\"ז,"
        },
        {
          "s": 24,
          "text": "לכן בעסק התורה110"
        },
        {
          "s": 25,
          "text": "שייך יותר שתהי' עסק מצד הנשמה]."
        },
        {
          "s": 26,
          "text": "ומבאר בזה,"
        },
        {
          "s": 27,
          "text": "דבמקיף יש שתי מדריגות."
        },
        {
          "s": 28,
          "text": "כידוע111,"
        },
        {
          "s": 29,
          "text": "שבהעלם"
        },
        {
          "s": 30,
          "text": "[דמקיף הוא בחינת העלם]"
        },
        {
          "s": 31,
          "text": "יש שתי בחינות."
        },
        {
          "s": 32,
          "text": "העלם שישנו במציאות,"
        },
        {
          "s": 33,
          "text": "כמו האש שבתוך הגחלת,"
        },
        {
          "s": 34,
          "text": "שעם היותו נעלם ומכוסה בהגחלת הוא מציאות אש,"
        },
        {
          "s": 35,
          "text": "שלכן ע\"י המים יכבה האש שבהגחלת,"
        },
        {
          "s": 36,
          "text": "והעלם שאינו במציאות,"
        },
        {
          "s": 37,
          "text": "כמו האש שבצור החלמיש שלא יכבה לעולם מפני שאינו במציאות אש."
        },
        {
          "s": 38,
          "text": "והחילוק שבין שתי בחינות אלה הוא גם באופן התגלותם מהעלמם."
        },
        {
          "s": 39,
          "text": "דהוצאת וגילוי האש מהגחלת היא ע\"י נפיחה במפוח,"
        },
        {
          "s": 40,
          "text": "והוצאת האש מהצור היא ע\"י הכאה ביגיעה דוקא."
        },
        {
          "s": 41,
          "text": "וזהו היתרון בהמקיף שנמשך ע\"י בירור החושך דוקא,"
        },
        {
          "s": 42,
          "text": "דהמקיף שנמשך ע\"י העבודה דנפש האלקית הוא מקיף השייך לפנימי,"
        },
        {
          "s": 43,
          "text": "ובכללות – העלם שישנו במציאות,"
        },
        {
          "s": 44,
          "text": "שלכן המשכתו והתגלותו היא ע\"י העבודה דנה\"א מצד עצמה"
        },
        {
          "s": 45,
          "text": "(שאין בזה יגיעה כ\"כ,"
        },
        {
          "s": 46,
          "text": "בדוגמת נפיחה במפוח),"
        },
        {
          "s": 47,
          "text": "משא\"כ המקיף שנמשך ע\"י העבודה דבירור החושך,"
        },
        {
          "s": 48,
          "text": "שהיא יגיעה גדולה,"
        },
        {
          "s": 49,
          "text": "הוא המקיף שאינו שייך לפנימי,"
        },
        {
          "s": 50,
          "text": "ובכללות – העלם שאינו במציאות,"
        },
        {
          "s": 51,
          "text": "העלם העצמי."
        },
        {
          "s": 52,
          "text": "וזהו כד אתכפיא סט\"א אסתלק יקרא דקוב\"ה כו',"
        },
        {
          "s": 53,
          "text": "העלם העצמי שמסולק מבחינת הפנימיות לגמרי."
        }
      ]
    },
    {
      "v": 19,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יובן גדול העילוי דההמשכה שע\"י אתכפיא סט\"א,"
        },
        {
          "s": 1,
          "text": "כי העבודה דאתכפיא סט\"א בעודה בתקפה ובגבורתה"
        },
        {
          "s": 2,
          "text": "[ובפרט האתכפיא בענינים אלו שבאה ע\"י מלחמה עצומה112]"
        },
        {
          "s": 3,
          "text": "היא יגיעה גדולה ועצומה עוד יותר מהיגיעה שבעבודת הבירורים,"
        },
        {
          "s": 4,
          "text": "ולכן,"
        },
        {
          "s": 5,
          "text": "ההעלם שנמשך עי\"ז"
        },
        {
          "s": 6,
          "text": "(אסתלק יקרא דקוב\"ה)"
        },
        {
          "s": 7,
          "text": "הוא נעלה יותר גם מההעלם שנמשך ע\"י עבודת הבירורים"
        },
        {
          "s": 8,
          "text": "(\"אתכפיא\" שבמאמר הנ\"ל)."
        }
      ]
    },
    {
      "v": 20,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ו)"
        },
        {
          "s": 2,
          "text": "והנה מעלה זו בהעבודה דאתכפיא,"
        },
        {
          "s": 3,
          "text": "מכיון שההמשכה היא ע\"י עבודה ויגיעה113"
        },
        {
          "s": 4,
          "text": "(בדוגמת הוצאת האש מהצור ע\"י הכאה114),"
        },
        {
          "s": 5,
          "text": "היא בדוגמת ההמשכה שע\"י היגיעה דעבודת הבירורים,"
        },
        {
          "s": 6,
          "text": "אלא שהיא נעלית יותר."
        },
        {
          "s": 7,
          "text": "אמנם,"
        },
        {
          "s": 8,
          "text": "עיקר המעלה דאתכפיא סט\"א הוא,"
        },
        {
          "s": 9,
          "text": "שהעבודה דאתכפיא סט\"א בעודה בתקפה ובגבורתה היא בדרך נצחון,"
        },
        {
          "s": 10,
          "text": "שעי\"ז הוא התגלות אוצר העליון,"
        },
        {
          "s": 11,
          "text": "דגילוי זה הוא מלמעלה ואין אתעדל\"ת מגעת לשם."
        },
        {
          "s": 12,
          "text": "ועוד ענין בזה,"
        },
        {
          "s": 13,
          "text": "שגילוי זה נמשך בפנימיות"
        },
        {
          "s": 14,
          "text": "(המעלה באתעדל\"ע שנמשכת ע\"י אתעדל\"ת115),"
        },
        {
          "s": 15,
          "text": "וכנ\"ל"
        },
        {
          "s": 16,
          "text": "(סעיף יו\"ד)"
        },
        {
          "s": 17,
          "text": "שהתגלות והמשכת האוצר הוא כמו בהתלבשות במדת הנצח שבאדם."
        },
        {
          "s": 18,
          "text": "אלא שעכשיו,"
        },
        {
          "s": 19,
          "text": "שהנצחון אינו בגילוי עדיין"
        },
        {
          "s": 20,
          "text": "(שהרי נמצאים עדיין באמצע המלחמה),"
        },
        {
          "s": 21,
          "text": "זה שנרגש בהאדם בגילוי הוא לא האוצר עצמו רק התוצאה מזה,"
        },
        {
          "s": 22,
          "text": "שבכחו לנצח את המנגד."
        },
        {
          "s": 23,
          "text": "ובגמר הנצחון,"
        },
        {
          "s": 24,
          "text": "כשהנצחון יהי' בגילוי,"
        },
        {
          "s": 25,
          "text": "אז יהי' נרגש בגילוי האוצר עצמו,"
        },
        {
          "s": 26,
          "text": "בגאולה האמיתית והשלימה ע\"י משיח צדקנו,"
        },
        {
          "s": 27,
          "text": "בקרוב ממש."
        }
      ]
    }
  ]
}