{
  "globalIndex": 911,
  "owner": 11,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919187_theRebbe_149__p005",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919187_theRebbe_149__p005",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919187_theRebbe_149",
  "title": "מאמר וידבר זאת חוקת תשכ\"ט",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וצריך להבין,"
        },
        {
          "s": 2,
          "text": "דלפי הנ\"ל"
        },
        {
          "s": 3,
          "text": "[שתפלתו של משה שיומשך עצמות אוא\"ס במלכות הוא מפני שמשה הוא דעת עליון ולכן ביכלתו להמשיך אור זה במלכות],"
        },
        {
          "s": 4,
          "text": "המשכת הגילוי במלכות ע\"י משה הוא"
        },
        {
          "s": 5,
          "text": "(לכאורה)"
        },
        {
          "s": 6,
          "text": "בדרך מלמעלה למטה48."
        },
        {
          "s": 7,
          "text": "ומהו\"ע תפלה למשה"
        },
        {
          "s": 8,
          "text": "(תפלת עשיר),"
        },
        {
          "s": 9,
          "text": "דתפלה היא מלמטה למעלה."
        },
        {
          "s": 10,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 11,
          "text": "דכשההמשכה במלכות היא בדרך מלמעלה למטה,"
        },
        {
          "s": 12,
          "text": "אזי,"
        },
        {
          "s": 13,
          "text": "גם כשהגילוי הוא עצמות אוא\"ס שלמעלה מענין הצמצום,"
        },
        {
          "s": 14,
          "text": "דבכללות הוא בחינת עצם האור שלא נגע בו הצמצום,"
        },
        {
          "s": 15,
          "text": "מ\"מ,"
        },
        {
          "s": 16,
          "text": "כיון דזה שאין שייך שיסתלק האור מהמלכות הוא מפני שהאור הוא למעלה מענין הצמצום,"
        },
        {
          "s": 17,
          "text": "הרי בנוגע להמלכות,"
        },
        {
          "s": 18,
          "text": "אין זה אמיתית הענין דבנין עדי עד,"
        },
        {
          "s": 19,
          "text": "מכיון שמצד המלכות אפשר שיסתלק ממנה האור."
        },
        {
          "s": 20,
          "text": "ואמיתית הענין דבנין עדי עד הוא כשהמשכת גילוי זה במלכות הוא"
        },
        {
          "s": 21,
          "text": "(לא רק מצד למעלה אלא גם)"
        },
        {
          "s": 22,
          "text": "מצד המלכות49."
        },
        {
          "s": 23,
          "text": "וזהו תפלה למשה,"
        },
        {
          "s": 24,
          "text": "דתפלה היא עבודת הנבראים,"
        },
        {
          "s": 25,
          "text": "ולכן ההמשכה שע\"י תפלה היא באופן ששייכת להמטה עצמו,"
        },
        {
          "s": 26,
          "text": "להנבראים וכן לספירת המלכות שורש הנבראים."
        },
        {
          "s": 27,
          "text": "אלא שההמשכה שע\"י תפלה בכלל,"
        },
        {
          "s": 28,
          "text": "כיון שתפלה היא עבודת הנבראים,"
        },
        {
          "s": 29,
          "text": "לכן ההמשכה שע\"י זה היא המשכה ששייכת לעולמות50,"
        },
        {
          "s": 30,
          "text": "ובההמשכה שע\"י תפלה למשה,"
        },
        {
          "s": 31,
          "text": "שתי המעלות."
        },
        {
          "s": 32,
          "text": "המשכת עצמות אוא\"ס שלמעלה משייכות לעולמות,"
        },
        {
          "s": 33,
          "text": "ואעפ\"כ ההמשכה היא נמשכת במלכות ובאופן שהיא שייכת להמלכות עצמה."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ובעומק יותר יש לומר,"
        },
        {
          "s": 2,
          "text": "שהיתרון בההמשכה שע\"י תפלת משה לגבי ההמשכה בדרך מלמעלה למטה,"
        },
        {
          "s": 3,
          "text": "הוא לא רק באופן ההמשכה"
        },
        {
          "s": 4,
          "text": "(שההמשכה שע\"י תפלת משה שייכת יותר להמטה,"
        },
        {
          "s": 5,
          "text": "כנ\"ל)"
        },
        {
          "s": 6,
          "text": "אלא גם בההמשכה עצמה."
        },
        {
          "s": 7,
          "text": "והענין הוא,"
        },
        {
          "s": 8,
          "text": "דהטעם על זה שכל מה שנברא בששת ימי בראשית צריך תיקון51,"
        },
        {
          "s": 9,
          "text": "הוא,"
        },
        {
          "s": 10,
          "text": "כי כוונת הבריאה היא בשביל עבודת האדם,"
        },
        {
          "s": 11,
          "text": "ולכן נברא העולם באופן שתיקונו יהי' ע\"י עבודת האדם,"
        },
        {
          "s": 12,
          "text": "שעי\"ז נעשה האדם שותף להקב\"ה במעשה בראשית52."
        },
        {
          "s": 13,
          "text": "וזהו גם הטעם על זה שהתהוות העולמות מהמלכות היתה ע\"י הצמצום שנחסר האור מבחינת המלכות"
        },
        {
          "s": 14,
          "text": "[וכמ\"ש53"
        },
        {
          "s": 15,
          "text": "את עשית את השמים גו',"
        },
        {
          "s": 16,
          "text": "את חסר ה',"
        },
        {
          "s": 17,
          "text": "דזה שהמלכות נעשית מקור להוות את העולמות"
        },
        {
          "s": 18,
          "text": "(עשית את השמים גו')"
        },
        {
          "s": 19,
          "text": "הוא ע\"י שנחסרו ממנה ה' פרצופים,"
        },
        {
          "s": 20,
          "text": "את חסר ה'54."
        },
        {
          "s": 21,
          "text": "וי\"ל דהחסרון שהי' בהמלכות שממנה נברא העולם הוא השורש והסיבה להחסרון דהעולם,"
        },
        {
          "s": 22,
          "text": "דכל מה שנברא בששת ימי בראשית צריך תיקון],"
        },
        {
          "s": 23,
          "text": "הוא בכדי שמילוי החסרון דהמלכות יהי' ע\"י עבודת האדם."
        },
        {
          "s": 24,
          "text": "ולהוסיף,"
        },
        {
          "s": 25,
          "text": "דהגם שהצמצום הי' רק בהאור השייך לעולמות,"
        },
        {
          "s": 26,
          "text": "באור הגבול"
        },
        {
          "s": 27,
          "text": "(שורש הממלא)"
        },
        {
          "s": 28,
          "text": "וגם באור הבל\"ג"
        },
        {
          "s": 29,
          "text": "(שורש הסובב),"
        },
        {
          "s": 30,
          "text": "[אלא שפעולת הצמצום באור הגבול הוא55"
        },
        {
          "s": 31,
          "text": "בהאור עצמו,"
        },
        {
          "s": 32,
          "text": "שנעשה בו ירידה והגבלה ועד שנעשה מקור להוות את העולמות,"
        },
        {
          "s": 33,
          "text": "ופעולת הצמצום באור הבל\"ג הוא רק55"
        },
        {
          "s": 34,
          "text": "שלא יאיר במקום החלל56."
        },
        {
          "s": 35,
          "text": "דזהו שבעיגול הגדול"
        },
        {
          "s": 36,
          "text": "(אור הבל\"ג)"
        },
        {
          "s": 37,
          "text": "נגע בו הצמצום,"
        },
        {
          "s": 38,
          "text": "דענין נגיעת הצמצום הוא שהאור יהי' רק שם"
        },
        {
          "s": 39,
          "text": "(בהעיגול)"
        },
        {
          "s": 40,
          "text": "ולא יתגלה לחוץ57]"
        },
        {
          "s": 41,
          "text": "אבל בעצם האור לא הי' הצמצום כלל,"
        },
        {
          "s": 42,
          "text": "היינו שהצמצום גם לא נגע בו"
        },
        {
          "s": 43,
          "text": "[שלכן,"
        },
        {
          "s": 44,
          "text": "מצד אור זה אפשר להיות הגילוי גם בעולמות],"
        },
        {
          "s": 45,
          "text": "מ\"מ,"
        },
        {
          "s": 46,
          "text": "כיון שהכוונה בכל הגילויים"
        },
        {
          "s": 47,
          "text": "(גם בהגילוי דעצם האור שלמעלה מגדר עולמות,"
        },
        {
          "s": 48,
          "text": "למעלה גם מ"
        },
        {
          "s": 49,
          "text": "(השורש ד)"
        },
        {
          "s": 50,
          "text": "סובב כל עלמין)"
        },
        {
          "s": 51,
          "text": "הוא בשביל ישראל,"
        },
        {
          "s": 52,
          "text": "לכן,"
        },
        {
          "s": 53,
          "text": "גם המשכת אור זה היא ע\"י עבודת האדם."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יש לבאר מ\"ש בהמאמר58"
        },
        {
          "s": 2,
          "text": "דהגילויים שלמעלה יש ג' מדריגות בכללות."
        },
        {
          "s": 3,
          "text": "ממלא כל עלמין,"
        },
        {
          "s": 4,
          "text": "סובב כל עלמין ועצמות אוא\"ס שלמעלה מממלא וסובב."
        },
        {
          "s": 5,
          "text": "ובג' מדריגות אלה הם ג' האהבות שבפסוק59"
        },
        {
          "s": 6,
          "text": "ואהבת,"
        },
        {
          "s": 7,
          "text": "בכל לבבך,"
        },
        {
          "s": 8,
          "text": "בכל נפשך ובכל מאדך."
        },
        {
          "s": 9,
          "text": "האהבה דבכל לבבך היא בבחינת ממלא כל עלמין,"
        },
        {
          "s": 10,
          "text": "דכיון שהחיות דבחי' ממכ\"ע הוא מלובש בהנבראים בפנימיותם,"
        },
        {
          "s": 11,
          "text": "לכן,"
        },
        {
          "s": 12,
          "text": "ע\"י ההתבוננות נרגש חיות זה גם בנפש הבהמית,"
        },
        {
          "s": 13,
          "text": "והאהבה היא בכל לבבך בשני יצריך60."
        },
        {
          "s": 14,
          "text": "האהבה דבכל נפשך היא בבחינת סוכ\"ע,"
        },
        {
          "s": 15,
          "text": "דכיון שאור הסובב הוא למעלה מהתלבשות בעולמות,"
        },
        {
          "s": 16,
          "text": "לכן,"
        },
        {
          "s": 17,
          "text": "ע\"י שנרגש בו ההפלאה דאוא\"ס"
        },
        {
          "s": 18,
          "text": "(סובב),"
        },
        {
          "s": 19,
          "text": "אהבתו את הוי' היא באופן דמסירת נפש"
        },
        {
          "s": 20,
          "text": "[בכל נפשך,"
        },
        {
          "s": 21,
          "text": "אפילו נוטל את נפשך60],"
        },
        {
          "s": 22,
          "text": "שרוצה לצאת ממציאותו וליכלל באוא\"ס."
        },
        {
          "s": 23,
          "text": "ואהבה זו היא רק בנפש האלקית."
        },
        {
          "s": 24,
          "text": "כי ההשגה"
        },
        {
          "s": 25,
          "text": "[באופן דהכרה והרגשה,"
        },
        {
          "s": 26,
          "text": "שאז דוקא מביאה ההשגה לאהבה]"
        },
        {
          "s": 27,
          "text": "בההפלאה דאוא\"ס יכולה להיות רק בנפש האלקית,"
        },
        {
          "s": 28,
          "text": "ששרשה הוא בשם הוי'61,"
        },
        {
          "s": 29,
          "text": "סובב."
        },
        {
          "s": 30,
          "text": "והאהבה דבכל מאדך היא בעצמות אוא\"ס שלמעלה גם מסובב."
        },
        {
          "s": 31,
          "text": "כי אמיתית הבל\"ג הוא בעצמות אוא\"ס"
        },
        {
          "s": 32,
          "text": "(משא\"כ אור הסובב יש בו איזה ציור והגבלה),"
        },
        {
          "s": 33,
          "text": "ולכן,"
        },
        {
          "s": 34,
          "text": "האהבה שע\"י גילוי עצמות אוא\"ס היא בכל מאדך,"
        },
        {
          "s": 35,
          "text": "בלי גבול."
        },
        {
          "s": 36,
          "text": "ולאחרי שמבאר השייכות דג' האהבות לג' מדריגות הנ\"ל,"
        },
        {
          "s": 37,
          "text": "מסיים,"
        },
        {
          "s": 38,
          "text": "דמזה מובן ענינם של ג' המדריגות,"
        },
        {
          "s": 39,
          "text": "דממלא הוא מתלבש בעולמות,"
        },
        {
          "s": 40,
          "text": "וסובב הוא למעלה מהתלבשות אבל שייך לעולמות,"
        },
        {
          "s": 41,
          "text": "ועצמות אוא\"ס אינו בגדר עולמות."
        }
      ]
    }
  ]
}