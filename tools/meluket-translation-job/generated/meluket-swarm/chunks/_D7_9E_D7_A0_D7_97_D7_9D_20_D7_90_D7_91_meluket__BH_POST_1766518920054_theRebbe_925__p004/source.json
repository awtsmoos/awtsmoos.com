{
  "globalIndex": 1066,
  "owner": 16,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518920054_theRebbe_925__p004",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518920054_theRebbe_925__p004",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518920054_theRebbe_925",
  "title": "מאמר והי' עקב תשמעון תשט\"ז",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "והענין הוא,"
        },
        {
          "s": 1,
          "text": "דהנה פירוש עושין רצונו של מקום הוא שצריך לעשות"
        },
        {
          "s": 2,
          "text": "(מען דאַרף אויפמאַכן)"
        },
        {
          "s": 3,
          "text": "הרצון במקום."
        },
        {
          "s": 4,
          "text": "דמקום קאי על סדר ההשתלשלות,"
        },
        {
          "s": 5,
          "text": "ואוא\"ס עצמו הוא למעלה מבחי' מקום,"
        },
        {
          "s": 6,
          "text": "כדאיתא במדרש24"
        },
        {
          "s": 7,
          "text": "ע\"פ25"
        },
        {
          "s": 8,
          "text": "הנה מקום אתי,"
        },
        {
          "s": 9,
          "text": "הוא מקומו של עולם ואין העולם מקומו,"
        },
        {
          "s": 10,
          "text": "ולכן צריך לעשות את הרצון במקום,"
        },
        {
          "s": 11,
          "text": "והיינו,"
        },
        {
          "s": 12,
          "text": "שלא רק הרצון בבחי' מקום הוא התחדשות,"
        },
        {
          "s": 13,
          "text": "אלא ענין הרצון גופא הוא התחדשות,"
        },
        {
          "s": 14,
          "text": "שהרי אוא\"ס לאו מכל אילין מדות איהו כלל26,"
        },
        {
          "s": 15,
          "text": "שהוא למעלה מכל הספירות ולמעלה גם מבחי' רצון שבתוכם,"
        },
        {
          "s": 16,
          "text": "ובכדי שיהי' הרצון הרי זה חידוש,"
        },
        {
          "s": 17,
          "text": "וכמ\"ש יהי רצון,"
        },
        {
          "s": 18,
          "text": "דהיינו שיתחדש בחי' הרצון."
        },
        {
          "s": 19,
          "text": "ובכדי שיהי' בחי' הרצון הרי זה ע\"י קיום התומ\"צ,"
        },
        {
          "s": 20,
          "text": "כמאמר27"
        },
        {
          "s": 21,
          "text": "נח\"ר לפני שאמרתי ונעשה רצוני,"
        },
        {
          "s": 22,
          "text": "שע\"י שגורמים נח\"ר לפניו ית' בקיום התומ\"צ,"
        },
        {
          "s": 23,
          "text": "אזי נעשה רצוני,"
        },
        {
          "s": 24,
          "text": "שנתחדש בחי' הרצון."
        },
        {
          "s": 25,
          "text": "וכל זה הוא חידוש הרצון בכלל,"
        },
        {
          "s": 26,
          "text": "שזה נעשה ע\"י קיום התומ\"צ בכלל."
        },
        {
          "s": 27,
          "text": "אמנם בכדי לעשות רצונו של מקום,"
        },
        {
          "s": 28,
          "text": "היינו לחדש את הרצון במקום,"
        },
        {
          "s": 29,
          "text": "לא מספיק קיום התומ\"צ בלבד,"
        },
        {
          "s": 30,
          "text": "אלא צריך לזה האהבה דבכל מאדך,"
        },
        {
          "s": 31,
          "text": "דבכדי לעשות את הרצון בכלל,"
        },
        {
          "s": 32,
          "text": "מספיק גם העבודה כמו שהוא מצד בחי' בכל לבבך ובכל נפשך,"
        },
        {
          "s": 33,
          "text": "אך בכדי לחדש את הרצון במקום,"
        },
        {
          "s": 34,
          "text": "צריך לזה העבודה כמו שהוא מצד בכל מאדך דוקא."
        },
        {
          "s": 35,
          "text": "וזהו דפ' שני' דק\"ש הוא בחי' אין עושין רצונו של מקום,"
        },
        {
          "s": 36,
          "text": "לפי שחסר בזה העבודה דבכל מאדך,"
        },
        {
          "s": 37,
          "text": "וע\"י העבודה דבכל מאדך דוקא עושין רצונו של מקום."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והענין הוא,"
        },
        {
          "s": 2,
          "text": "דהנה ברצון יש ב' מדרגות,"
        },
        {
          "s": 3,
          "text": "רצון התחתון ורצון העליון."
        },
        {
          "s": 4,
          "text": "וב' בחי' רצון אלו ישנם בנה\"ב,"
        },
        {
          "s": 5,
          "text": "ומזה יובן גם בנה\"א,"
        },
        {
          "s": 6,
          "text": "ועד\"ז יובן גם למעלה."
        },
        {
          "s": 7,
          "text": "דהנה,"
        },
        {
          "s": 8,
          "text": "רצון התחתון בנה\"ב הוא ע\"ד מה שרוצה במסחר,"
        },
        {
          "s": 9,
          "text": "שרצון זה נולד מהשכל,"
        },
        {
          "s": 10,
          "text": "דכאשר מבין איך שענין המסחר טוב לפניו,"
        },
        {
          "s": 11,
          "text": "אזי רוצה בזה,"
        },
        {
          "s": 12,
          "text": "ומצד הרצון הרי הוא חושב בהמסחר,"
        },
        {
          "s": 13,
          "text": "ומדבר ועושה בזה,"
        },
        {
          "s": 14,
          "text": "ורצון זה הוא רצון התחתון,"
        },
        {
          "s": 15,
          "text": "מאחר שהוא נולד מהשכל."
        },
        {
          "s": 16,
          "text": "ורצון העליון הוא רצון שלמעלה מהשכל,"
        },
        {
          "s": 17,
          "text": "וכמו מה שרוצה לחיות,"
        },
        {
          "s": 18,
          "text": "שרוצה בקיומו,"
        },
        {
          "s": 19,
          "text": "דרצון זה אינו מצד השכל והטעם."
        },
        {
          "s": 20,
          "text": "ומבחי' רצון זה שרוצה לחיות,"
        },
        {
          "s": 21,
          "text": "נמצא גם הרצון שרוצה במסחר,"
        },
        {
          "s": 22,
          "text": "והיינו דהרצון שרוצה לחיות מצטייר ע\"י השכל ברצונות פרטיים כפי אופני השכל שהשכיל מה שטוב לפניו,"
        },
        {
          "s": 23,
          "text": "דכל הרצונות פרטיים הוא הרצון שרוצה לחיות כמו שהצטייר ע\"י השכל."
        },
        {
          "s": 24,
          "text": "והנה,"
        },
        {
          "s": 25,
          "text": "ההפרש בין רצה\"ת לרצה\"ע הוא,"
        },
        {
          "s": 26,
          "text": "דרצה\"ת הוא בהגבלה,"
        },
        {
          "s": 27,
          "text": "דמאחר שנולד מהשכל,"
        },
        {
          "s": 28,
          "text": "הרי הוא בהגבלה כפי הגבלת השכל."
        },
        {
          "s": 29,
          "text": "וגם רצון זה הוא רק בחיצוניות בהנפש,"
        },
        {
          "s": 30,
          "text": "דלהיותו רק מצד ההתבוננות,"
        },
        {
          "s": 31,
          "text": "הרי הוא מגיע רק באותו מקום בהנפש שהשכל מגיע,"
        },
        {
          "s": 32,
          "text": "משא\"כ רצה\"ע שלמעלה מהשכל הרי הוא בלי גבול,"
        },
        {
          "s": 33,
          "text": "והוא הרצון שמצד פנימיות הנפש."
        },
        {
          "s": 34,
          "text": "ומזה יובן גם בנה\"א,"
        },
        {
          "s": 35,
          "text": "שיש בו רצה\"ת ורצה\"ע,"
        },
        {
          "s": 36,
          "text": "דרצה\"ת הוא מה שרוצה באלקות מצד ההתבוננות,"
        },
        {
          "s": 37,
          "text": "ורצון העליון הוא בחי' לאהבה את ה\"א כי הוא חייך28,"
        },
        {
          "s": 38,
          "text": "שאין זה מצד הטעם,"
        },
        {
          "s": 39,
          "text": "כי אם שזהו חיותו."
        },
        {
          "s": 40,
          "text": "וכמו"
        },
        {
          "s": 41,
          "text": "(בנה\"ב)"
        },
        {
          "s": 42,
          "text": "הרצון שרוצה לחיות."
        },
        {
          "s": 43,
          "text": "והוא בחי' רצה\"ע רעוא דכל רעוין29."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ועד\"ז יובן גם למעלה,"
        },
        {
          "s": 1,
          "text": "דרצה\"ת הוא הרצון כמו שבא בהשתלשלות ע\"י החכמה,"
        },
        {
          "s": 2,
          "text": "ורצה\"ע הוא הרצון שלמעלה מהטעם,"
        },
        {
          "s": 3,
          "text": "שממנו נמשכים כל הרצונות"
        },
        {
          "s": 4,
          "text": "(וכנ\"ל בנה\"ב שכל הרצונות נמשכים מהרצון שרוצה לחיות),"
        },
        {
          "s": 5,
          "text": "רעוא דכל רעוין."
        },
        {
          "s": 6,
          "text": "וזהו ענין עושין רצונו של מקום,"
        },
        {
          "s": 7,
          "text": "דהיינו עשיית הרצון שלמעלה מהשתלשלות,"
        },
        {
          "s": 8,
          "text": "רצון העליון,"
        },
        {
          "s": 9,
          "text": "במקום,"
        },
        {
          "s": 10,
          "text": "בהשתלשלות,"
        },
        {
          "s": 11,
          "text": "דע\"י המשכת הרצון שלמעלה מהשתלשלות בהשתלשלות,"
        },
        {
          "s": 12,
          "text": "אזי תהי' למטה הנהגה דבלי גבול,"
        },
        {
          "s": 13,
          "text": "לפי שגם בהגבול דהשתלשלות מאיר הבל\"ג."
        },
        {
          "s": 14,
          "text": "ולכן הנה בזמן שעושין רצונו של מקום אזי ועמדו זרים ורעו צאנכם,"
        },
        {
          "s": 15,
          "text": "לפי שגם למטה יהי' הנהגה דבלי גבול."
        },
        {
          "s": 16,
          "text": "והוא ע\"ד מ\"ש30"
        },
        {
          "s": 17,
          "text": "ביום ההוא יהי' הוי' אחד,"
        },
        {
          "s": 18,
          "text": "דעכשיו לא כמו שאני נכתב אני נקרא31,"
        },
        {
          "s": 19,
          "text": "היינו דעכשיו הנה הוי' הוא בהעלם,"
        },
        {
          "s": 20,
          "text": "משא\"כ לעתיד הנה הוי' יהי' בגילוי למטה."
        },
        {
          "s": 21,
          "text": "והמשכה זו היא ע\"י האהבה דבכל מאדך24,"
        },
        {
          "s": 22,
          "text": "דבכדי להגיע לבחי' הבל\"ג שלמעלה הרי זה ע\"י העבודה בהבל\"ג שבנפש,"
        },
        {
          "s": 23,
          "text": "דהגם שאין זה אמיתית הבל\"ג,"
        },
        {
          "s": 24,
          "text": "שהרי זה רק מאד שלך32,"
        },
        {
          "s": 25,
          "text": "מ\"מ להיות שבאדם עכ\"פ הרי זה בל\"ג,"
        },
        {
          "s": 26,
          "text": "והוא רצה\"ע שבאדם,"
        },
        {
          "s": 27,
          "text": "הנה עי\"ז הוא ממשיך גם את רצה\"ע שלמעלה,"
        },
        {
          "s": 28,
          "text": "שזהו\"ע עושין רצונו של מקום."
        }
      ]
    }
  ]
}