{
  "globalIndex": 771,
  "owner": 21,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918353_theRebbe_128__p002",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918353_theRebbe_128__p002",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918353_theRebbe_128",
  "title": "מאמר גן נעול תשמ\"ז",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויובן זה ע\"פ מ\"ש בהמאמר,"
        },
        {
          "s": 2,
          "text": "דגן נעול הוא כענין הקידושין."
        },
        {
          "s": 3,
          "text": "ומבאר זה ע\"פ הידוע10"
        },
        {
          "s": 4,
          "text": "בענין קדשנו במצותיך ותן חלקנו בתורתך11,"
        },
        {
          "s": 5,
          "text": "דקדשנו במצותיך הוא מלשון קידושין,"
        },
        {
          "s": 6,
          "text": "דענין הקידושין הוא הזמנה,"
        },
        {
          "s": 7,
          "text": "שהאשה המתקדשת היא מזומנת ומיוחדת לבעלה ועי\"ז היא נאסרת על כל העולם12,"
        },
        {
          "s": 8,
          "text": "ותן חלקנו בתורתך הו\"ע הנישואין,"
        },
        {
          "s": 9,
          "text": "המשכה בפנימיות,"
        },
        {
          "s": 10,
          "text": "ועד שהאדם קולט את ההמשכה,"
        },
        {
          "s": 11,
          "text": "ועד שנעשית חלקנו13"
        },
        {
          "s": 12,
          "text": "(דישראל)."
        },
        {
          "s": 13,
          "text": "וזהו קדשנו במצותיך ותן חלקנו בתורתך,"
        },
        {
          "s": 14,
          "text": "דההמשכה שע\"י המצוות היא בבחינת מקיף,"
        },
        {
          "s": 15,
          "text": "ופעולתה בהאדם המקיים את המצוה היא"
        },
        {
          "s": 16,
          "text": "(בעיקר14)"
        },
        {
          "s": 17,
          "text": "שיהי' מובדל מהתאוות ומכל מדות הרעות,"
        },
        {
          "s": 18,
          "text": "בדוגמת קידושין,"
        },
        {
          "s": 19,
          "text": "דזה שהאשה מתקדשת לבעלה הוא"
        },
        {
          "s": 20,
          "text": "(בעיקר)"
        },
        {
          "s": 21,
          "text": "זה שהיא נאסרת על כל העולם15."
        },
        {
          "s": 22,
          "text": "ועי\"ז הוא נעשה כלי לקלוט אור התורה,"
        },
        {
          "s": 23,
          "text": "ותורתך בתוך מעי16,"
        },
        {
          "s": 24,
          "text": "נישואין."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ויש להוסיף,"
        },
        {
          "s": 1,
          "text": "שהדמיון דמצוות ותורה לאירוסין ונישואין הוא בשני ענינים."
        },
        {
          "s": 2,
          "text": "באופן ההמשכה,"
        },
        {
          "s": 3,
          "text": "שההמשכה דהמצוות בהאדם המקיים את המצוה היא בבחינת מקיף"
        },
        {
          "s": 4,
          "text": "(אירוסין)"
        },
        {
          "s": 5,
          "text": "וההמשכה דתורה בהאדם העוסק בתורה היא בפנימיות"
        },
        {
          "s": 6,
          "text": "(נישואין)"
        },
        {
          "s": 7,
          "text": "כנ\"ל."
        },
        {
          "s": 8,
          "text": "וגם בההמשכה עצמה."
        },
        {
          "s": 9,
          "text": "דההמשכה דתורה היא המשכה נעלית ופנימית יותר מההמשכה דמצוות17"
        },
        {
          "s": 10,
          "text": "[ועד שההמשכה דמצוות היא בחינת אחוריים לגבי ההמשכה דתורה18],"
        },
        {
          "s": 11,
          "text": "ולכן19,"
        },
        {
          "s": 12,
          "text": "ההמשכה דתורה היא דוגמת המשכת הטיפה"
        },
        {
          "s": 13,
          "text": "(נישואין)"
        },
        {
          "s": 14,
          "text": "שהיא המשכה עצמית."
        },
        {
          "s": 15,
          "text": "ויש לומר,"
        },
        {
          "s": 16,
          "text": "שגם ענין זה מרומז בותן חלקנו בתורתך."
        },
        {
          "s": 17,
          "text": "דבלשון חלקנו שני ענינים."
        },
        {
          "s": 18,
          "text": "שהתורה נעשית חלקנו דישראל"
        },
        {
          "s": 19,
          "text": "(כנ\"ל),"
        },
        {
          "s": 20,
          "text": "ושהיא חלק מהקב\"ה13,"
        },
        {
          "s": 21,
          "text": "דכשאתה תופס בחלק מן העצם אתה תופס בכולו20."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ויש להוסיף,"
        },
        {
          "s": 2,
          "text": "דזה שקדשנו במצותיך הוא הקדמה לותן חלקנו בתורתך,"
        },
        {
          "s": 3,
          "text": "הוא מהטעמים על זה שקודם יציאת מצרים נאמרה פרשת החודש21,"
        },
        {
          "s": 4,
          "text": "שיש בה כו\"כ מצוות"
        },
        {
          "s": 5,
          "text": "[שנוהגות לדורות ונמנות במנין המצוות],"
        },
        {
          "s": 6,
          "text": "כי ביציאת מצרים הותחל הענין דמתן תורה22,"
        },
        {
          "s": 7,
          "text": "ולכן לפני יציאת מצרים נצטוו בכמה מצוות,"
        },
        {
          "s": 8,
          "text": "שזה הי' הקדמה להענין דמתן תורה שהתחיל ביציאת מצרים."
        },
        {
          "s": 9,
          "text": "ולאחרי זה נצטוו עשר מצוות במרה23"
        },
        {
          "s": 10,
          "text": "שזה הי' הכנה למתן תורה בפועל."
        },
        {
          "s": 11,
          "text": "ובכללות יותר יש לומר,"
        },
        {
          "s": 12,
          "text": "דזה שהתורה מתחלת בבראשית משום כח24"
        },
        {
          "s": 13,
          "text": "מעשיו הגיד לעמו לתת להם נחלת גוים25"
        },
        {
          "s": 14,
          "text": "הוא ע\"ד ההקדמה דמעשה המצוות לתורה,"
        },
        {
          "s": 15,
          "text": "כי רובם של המצוות תלויות בארץ"
        },
        {
          "s": 16,
          "text": "(נחלת גוים)."
        }
      ]
    }
  ]
}