{
  "globalIndex": 213,
  "owner": 13,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915043_theRebbe_419__p002",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915043_theRebbe_419__p002",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518915043_theRebbe_419",
  "title": "מאמר ואברהם זקן תשל\"ח",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים ביאור הידוע17"
        },
        {
          "s": 2,
          "text": "בזה שהנשמה צריכה להלבושים דתורה ומצוות בכדי שתוכל ליהנות מזיו השכינה,"
        },
        {
          "s": 3,
          "text": "כי להיות שהנשמה היא נברא"
        },
        {
          "s": 4,
          "text": "[וכמבואר בכ\"מ שהנשמה היא כמו שאלקות נעשה בבחי' נברא18,"
        },
        {
          "s": 5,
          "text": "ועד שהדביקות שלה באלקות היא דביקות בלתי ניכרת19]"
        },
        {
          "s": 6,
          "text": "וא\"א לנברא להשיג שום השגה באוא\"ס ב\"ה,"
        },
        {
          "s": 7,
          "text": "לכן בכדי שתוכל הנשמה ליהנות מזיו השכינה שהוא הארה מאוא\"ס ב\"ה"
        },
        {
          "s": 8,
          "text": "[ובפרט לחזות בנועם הוי'20],"
        },
        {
          "s": 9,
          "text": "צריכה היא ללבושים."
        },
        {
          "s": 10,
          "text": "וכמשל אור גדול"
        },
        {
          "s": 11,
          "text": "[ביותר,"
        },
        {
          "s": 12,
          "text": "וכמו אור השמש,"
        },
        {
          "s": 13,
          "text": "בחי' שמש הוי']"
        },
        {
          "s": 14,
          "text": "שאין יכולים להביט בו,"
        },
        {
          "s": 15,
          "text": "וע\"י המסך"
        },
        {
          "s": 16,
          "text": "(שהוא כמו לבוש)"
        },
        {
          "s": 17,
          "text": "יכולים לקבל"
        },
        {
          "s": 18,
          "text": "[ולקלוט]"
        },
        {
          "s": 19,
          "text": "את האור."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "והנה ידוע21"
        },
        {
          "s": 1,
          "text": "שכל ממוצע המחבר ב' דברים,"
        },
        {
          "s": 2,
          "text": "צ\"ל כלול משניהם."
        },
        {
          "s": 3,
          "text": "ומזה מובן גם בענין הלבושים דתומ\"צ"
        },
        {
          "s": 4,
          "text": "[שהם כמו ממוצע המחבר בחי' זיו השכינה"
        },
        {
          "s": 5,
          "text": "(שהוא הארה מאוא\"ס הבל\"ג)"
        },
        {
          "s": 6,
          "text": "עם הנשמה"
        },
        {
          "s": 7,
          "text": "(שהיא נברא ובע\"ג)],"
        },
        {
          "s": 8,
          "text": "שיש בהם מב' הענינים."
        },
        {
          "s": 9,
          "text": "דשרשם"
        },
        {
          "s": 10,
          "text": "(של התומ\"צ)"
        },
        {
          "s": 11,
          "text": "הוא מרצה\"ע וחכמתו ית' שהם מיוחדים בו ית'"
        },
        {
          "s": 12,
          "text": "(שהוא22"
        },
        {
          "s": 13,
          "text": "וחכמתו ורצונו אחד)"
        },
        {
          "s": 14,
          "text": "– ענין הבל\"ג"
        },
        {
          "s": 15,
          "text": "[ועד שרצה\"ע וחכמתו ית'"
        },
        {
          "s": 16,
          "text": "(שרש התומ\"צ)"
        },
        {
          "s": 17,
          "text": "הם למעלה גם מבחי' זיו השכינה23],"
        },
        {
          "s": 18,
          "text": "וע\"י שירדו למטה בעוה\"ז הגשמי ציצית בצמר גשמי ותפילין בקלף גשמי וכן בכל המצוות"
        },
        {
          "s": 19,
          "text": "[ועד\"ז הוא גם בתורה שנתלבשה בשכל אנושי,"
        },
        {
          "s": 20,
          "text": "ועד בטענות של שקר,"
        },
        {
          "s": 21,
          "text": "ונתלבשה בדיו על הספר24]"
        },
        {
          "s": 22,
          "text": "הם בבחי' מדידה והגבלה ועד להמדידה והגבלה דעוה\"ז הגשמי שאין תחתון למטה ממנו25,"
        },
        {
          "s": 23,
          "text": "הנה ע\"י ב' ענינים אלו שבתומ\"צ"
        },
        {
          "s": 24,
          "text": "[ענין הבל\"ג שבהם מצד שרשם,"
        },
        {
          "s": 25,
          "text": "וענין הגבול שבהם מצד ירידתן למטה]"
        },
        {
          "s": 26,
          "text": "הם נעשים לבוש וממוצע המחבר את הנשמה שהיא נברא ובע\"ג"
        },
        {
          "s": 27,
          "text": "(וכמו שהיא מלובשת בגוף גשמי)"
        },
        {
          "s": 28,
          "text": "עם בחי' זיו השכינה ועד עם בחי' נועם הוי' שלמעלה מכל מדידה והגבלה26."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה מצד ההתלבשות דתומ\"צ בעניני עוה\"ז הגשמי שהוא רובו ככולו רע27,"
        },
        {
          "s": 2,
          "text": "צריך לנקותן מכל פסולת הנופל בהן28,"
        },
        {
          "s": 3,
          "text": "וכמו בלימוד התורה,"
        },
        {
          "s": 4,
          "text": "שמצד זה שהתורה נתלבשה בשכל אנושי ובענינים גשמיים הרי אפשר29"
        },
        {
          "s": 5,
          "text": "שהלימוד שלו יהי' שלא לשמה ועד לדרגא הכי תחתונה בשלא לשמה,"
        },
        {
          "s": 6,
          "text": "ועד\"ז במצוות30."
        },
        {
          "s": 7,
          "text": "וזהו מה שהלבושים דתומ\"צ צריכים לרחיצה וכיבוס,"
        },
        {
          "s": 8,
          "text": "שיהי' לבושים נקיים וכו'"
        },
        {
          "s": 9,
          "text": "(ואפילו לא יהיו באופן דמלבושי אגאלתי31),"
        },
        {
          "s": 10,
          "text": "בדוגמת לבוש הגשמי שבכדי שיהי' זך ונקי צריך לרחוץ ולכבס אותו28."
        },
        {
          "s": 11,
          "text": "[וגם לאחרי שהאדם מכבס את הלבושים דתומ\"צ שיהיו נקיים מכל פסולת כו',"
        },
        {
          "s": 12,
          "text": "בכדי שיעלו למעלה,"
        },
        {
          "s": 13,
          "text": "צריכים הם להזדכך ע\"י המלאכים,"
        },
        {
          "s": 14,
          "text": "דגפיף להון ונשיק להון32."
        },
        {
          "s": 15,
          "text": "והענין הוא דהנה כתיב33"
        },
        {
          "s": 16,
          "text": "אין צדיק בארץ אשר יעשה טוב ולא יחטא,"
        },
        {
          "s": 17,
          "text": "שמפני שהאדם נמצא בארץ בעוה\"ז הגשמי לכן יש בו חטא,"
        },
        {
          "s": 18,
          "text": "חטא מל' חסרון34"
        },
        {
          "s": 19,
          "text": "(עכ\"פ)."
        },
        {
          "s": 20,
          "text": "והגם שהחטא"
        },
        {
          "s": 21,
          "text": "(החסרון)"
        },
        {
          "s": 22,
          "text": "הוא לא באשמתו ח\"ו,"
        },
        {
          "s": 23,
          "text": "שהרי ועמך כולם צדיקים35,"
        },
        {
          "s": 24,
          "text": "כי אם כמ\"ש36"
        },
        {
          "s": 25,
          "text": "נורא עלילה על בני אדם שרצון הקב\"ה הוא שבנ\"א נמצא בעולם כזה"
        },
        {
          "s": 26,
          "text": "[ובדוגמת37"
        },
        {
          "s": 27,
          "text": "מלך ששלח את בנו למדינה רחוקה בכדי להראות את חכמת בנו שגם במדינה הרחוקה יכיר את האמת,"
        },
        {
          "s": 28,
          "text": "בחי' ואמת הוי' לעולם38],"
        },
        {
          "s": 29,
          "text": "אעפ\"כ,"
        },
        {
          "s": 30,
          "text": "מכיון שבפועל יש בו"
        },
        {
          "s": 31,
          "text": "(חטא מל')"
        },
        {
          "s": 32,
          "text": "חסרון,"
        },
        {
          "s": 33,
          "text": "וגם התומ\"צ שלו אינם בשלימות,"
        },
        {
          "s": 34,
          "text": "וכמ\"ש אין צדיק בארץ אשר יעשה טוב ולא יחטא,"
        },
        {
          "s": 35,
          "text": "שהחסרון"
        },
        {
          "s": 36,
          "text": "(יחטא)"
        },
        {
          "s": 37,
          "text": "הוא גם בהתומ\"צ"
        },
        {
          "s": 38,
          "text": "(ביעשה טוב)"
        },
        {
          "s": 39,
          "text": "שלו,"
        },
        {
          "s": 40,
          "text": "לכן בכדי שהתומ\"צ שלו יעלו למעלה,"
        },
        {
          "s": 41,
          "text": "צריך הוא לסיוע המלאכים]."
        }
      ]
    }
  ]
}