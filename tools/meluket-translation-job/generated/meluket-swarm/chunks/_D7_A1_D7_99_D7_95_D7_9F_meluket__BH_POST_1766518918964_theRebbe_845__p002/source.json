{
  "globalIndex": 878,
  "owner": 28,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918964_theRebbe_845__p002",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918964_theRebbe_845__p002",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918964_theRebbe_845",
  "title": "מאמר והנה פרח מטה אהרן תשל\"ג",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה עיקר הדין ומשפט באיזה ענין יומשך החסד הוא כשהחסד שנקצב לו בר\"ה וביוהכ\"פ הוא חסד מצומצם ביותר,"
        },
        {
          "s": 2,
          "text": "שאינו מספיק שיומשכו ממנו כל ג' הענינים דבני חיי ומזוני אלא רק שנים מהם או אחד מהם,"
        },
        {
          "s": 3,
          "text": "שאז יש דין ומשפט אם השפעת החסד תהי' בבני או בחיי או במזוני."
        },
        {
          "s": 4,
          "text": "ותפלת הצדיק מועלת להחליף מענין לענין14."
        },
        {
          "s": 5,
          "text": "[וכהסיפור ע\"ד הבעש\"ט,"
        },
        {
          "s": 6,
          "text": "שבאו אליו חשוכי בנים לבקשו שיתפלל לה' שיהי' להם בנים,"
        },
        {
          "s": 7,
          "text": "והאיש ההוא הי' עשיר גדול,"
        },
        {
          "s": 8,
          "text": "ואמר הבעש\"ט שבאם הם מסכימים שיהיו עניים יהי' להם בנים."
        },
        {
          "s": 9,
          "text": "וכשקיבלו עליהם,"
        },
        {
          "s": 10,
          "text": "נולדו להם בנים ונעשו עניים."
        },
        {
          "s": 11,
          "text": "והיינו שהבעש\"ט ראה שהחסד שנקצב להם לא יספיק על בנים ועושר יחד,"
        },
        {
          "s": 12,
          "text": "וע\"י תפלתו פעל להחליף השפעת החסד מעשירות לבנים14]."
        },
        {
          "s": 13,
          "text": "ויש לומר,"
        },
        {
          "s": 14,
          "text": "שאז"
        },
        {
          "s": 15,
          "text": "[כשהחסד הוא מצומצם שאינו מספיק על כל הענינים דבני חיי ומזוני],"
        },
        {
          "s": 16,
          "text": "הדין ומשפט הוא ביותר."
        },
        {
          "s": 17,
          "text": "ובכדי שיוחלף החסד מענין לענין הוא דוקא ע\"י תפלת צדיק."
        },
        {
          "s": 18,
          "text": "אבל בכללות גם כשהחסד מספיק לכל ג' הענינים דבני חיי ומזוני,"
        },
        {
          "s": 19,
          "text": "יש דין ומשפט בכל יום בנוגע לכל השפעה פרטית,"
        },
        {
          "s": 20,
          "text": "ולכן מתפללים בכל יום י\"ב ברכות אמצעיות שיש בהן שאלת כל הדברים."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וצריך להבין,"
        },
        {
          "s": 2,
          "text": "הרי הדין שבר\"ה ויוהכ\"פ הוא על האדם כמו שהוא למטה"
        },
        {
          "s": 3,
          "text": "(נשמה בגוף)"
        },
        {
          "s": 4,
          "text": "[ובפרט לפי המובא בלקו\"ת15"
        },
        {
          "s": 5,
          "text": "מהגהות מיימוני16"
        },
        {
          "s": 6,
          "text": "שאדם נידון בר\"ה בעניני עוה\"ז],"
        },
        {
          "s": 7,
          "text": "והדין ומשפט הוא"
        },
        {
          "s": 8,
          "text": "(לא רק בנוגע להשפעת החסד בכלל,"
        },
        {
          "s": 9,
          "text": "אלא גם)"
        },
        {
          "s": 10,
          "text": "בנוגע להפרטים17"
        },
        {
          "s": 11,
          "text": "[וכדמוכח גם מזה שבהתפלות דר\"ה ויוהכ\"פ מבקשים גם על ענינים פרטיים],"
        },
        {
          "s": 12,
          "text": "ואעפ\"כ אדם נידון בכל יום באיזה ענין יומשך לו החסד שנקצב עליו בר\"ה ויוהכ\"פ,"
        },
        {
          "s": 13,
          "text": "ויתירה מזו,"
        },
        {
          "s": 14,
          "text": "שהוא נידון אם ההשפעה שנקצבה לו תומשך בעוה\"ז או שיוסיפו לו תענוג וכו' למעלה."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ויובן זה ע\"פ מ\"ש בסידור18"
        },
        {
          "s": 2,
          "text": "עה\"פ19"
        },
        {
          "s": 3,
          "text": "יום ליום יביע אומר,"
        },
        {
          "s": 4,
          "text": "שבימי החול ישנם כמה עיכובים בהמשכת ההשפעה למטה,"
        },
        {
          "s": 5,
          "text": "וביום השבת,"
        },
        {
          "s": 6,
          "text": "המשכת ההשפעה היא במהירות,"
        },
        {
          "s": 7,
          "text": "יביע אומר,"
        },
        {
          "s": 8,
          "text": "יביע לשון מהירות20."
        },
        {
          "s": 9,
          "text": "ומבואר שם21,"
        },
        {
          "s": 10,
          "text": "דזה שבימי החול אפשר שההשפעה תתעכב ולא תומשך למטה,"
        },
        {
          "s": 11,
          "text": "הוא כמשל אדם שדן בשכלו על איזה דבר אם ראוי לעשותו אם לאו ובא למסקנא והחלטה שראוי לעשותו,"
        },
        {
          "s": 12,
          "text": "ואעפ\"כ אפשר להיות שזה ישאר בשכלו ולא יבוא במעשה בפועל."
        },
        {
          "s": 13,
          "text": "ויתירה מזו,"
        },
        {
          "s": 14,
          "text": "שכאשר הדבר נוגע למעשה בפועל הוא שוקל בדעתו עוד פעם אם לעשות בפועל כפי שהחליט בשכלו."
        },
        {
          "s": 15,
          "text": "דהגם שההחלטה בשכל היתה שראוי לעשות הדבר,"
        },
        {
          "s": 16,
          "text": "מ\"מ,"
        },
        {
          "s": 17,
          "text": "כיון שהעשי' שנרגשה אצלו בהחלטת שכלו היא עשי' כמו שכלולה בשכל,"
        },
        {
          "s": 18,
          "text": "לכן,"
        },
        {
          "s": 19,
          "text": "כשבא הדבר לידי מעשה בפועל,"
        },
        {
          "s": 20,
          "text": "מעשה כמו שהוא בפ\"ע"
        },
        {
          "s": 21,
          "text": "(נפרד מהשכל),"
        },
        {
          "s": 22,
          "text": "צריך להתייעץ ולדון בשכלו עוד פעם אם לעשות כן בפועל."
        },
        {
          "s": 23,
          "text": "ובפרטיות,"
        },
        {
          "s": 24,
          "text": "שני ענינים בזה22."
        },
        {
          "s": 25,
          "text": "שהחלטת השכל"
        },
        {
          "s": 26,
          "text": "(שראוי לעשות הדבר)"
        },
        {
          "s": 27,
          "text": "אינה מחייבת את המעשה,"
        },
        {
          "s": 28,
          "text": "דכיון שהמעשה הכלול בשכל והמעשה בפועל"
        },
        {
          "s": 29,
          "text": "(כמו שהוא בפ\"ע נפרד מהשכל)"
        },
        {
          "s": 30,
          "text": "הם שני ענינים,"
        },
        {
          "s": 31,
          "text": "לכן אפשר שההחלטה השכלית לא תביא אותו למעשה,"
        },
        {
          "s": 32,
          "text": "היינו שלא יחשוב אפילו בנוגע למעשה בפועל."
        },
        {
          "s": 33,
          "text": "ויתירה מזו,"
        },
        {
          "s": 34,
          "text": "שגם כשיחשוב עד\"ז,"
        },
        {
          "s": 35,
          "text": "אפשר להיות אצלו סברא שלא לעשות,"
        },
        {
          "s": 36,
          "text": "וצריך לדון עוד פעם."
        }
      ]
    }
  ]
}