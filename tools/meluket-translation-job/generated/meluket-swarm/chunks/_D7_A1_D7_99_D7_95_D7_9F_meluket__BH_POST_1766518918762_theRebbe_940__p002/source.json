{
  "globalIndex": 840,
  "owner": 40,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918762_theRebbe_940__p002",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918762_theRebbe_940__p002",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918762_theRebbe_940",
  "title": "מאמר וידבר אלוקים את כל הדברים האלה תשכ\"ט",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ומבאר בהמאמר הטעם על זה שהדיבור דעשרת הדברות הי' באופן דעמי הדיבור מדבר,"
        },
        {
          "s": 1,
          "text": "בלשון יחיד לכאו\"א בפ\"ע"
        },
        {
          "s": 2,
          "text": "[הגם שכל ציוויי התורה הם לכאו\"א מישראל ובכל התורה נאמר אני ה' אלקיכם],"
        },
        {
          "s": 3,
          "text": "ע\"פ מה דאיתא בילקוט שם,"
        },
        {
          "s": 4,
          "text": "דבשעת מ\"ת שיתף הקב\"ה את שמו בכאו\"א מישראל."
        },
        {
          "s": 5,
          "text": "דזהו מ\"ש22"
        },
        {
          "s": 6,
          "text": "רכב אלקים רבותיים גו' אד' בם סיני בקודש,"
        },
        {
          "s": 7,
          "text": "דכמו שאד' בם"
        },
        {
          "s": 8,
          "text": "(בהמלאכים),"
        },
        {
          "s": 9,
          "text": "שבשמו של כל מלאך משותף"
        },
        {
          "s": 10,
          "text": "(בסופו)"
        },
        {
          "s": 11,
          "text": "שמו של הקב\"ה,"
        },
        {
          "s": 12,
          "text": "א-ל"
        },
        {
          "s": 13,
          "text": "(מיכאל גבריאל רפאל),"
        },
        {
          "s": 14,
          "text": "כן במתן תורה,"
        },
        {
          "s": 15,
          "text": "סיני בקודש,"
        },
        {
          "s": 16,
          "text": "שיתף הקב\"ה את שמו בכאו\"א מישראל,"
        },
        {
          "s": 17,
          "text": "אנכי הוי' אלקיך."
        },
        {
          "s": 18,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 19,
          "text": "דע\"י ששמו של הקב\"ה משותף במלאכים,"
        },
        {
          "s": 20,
          "text": "הם בטלים לגבי שמו ית' שמשותף בהם."
        },
        {
          "s": 21,
          "text": "וכמו\"כ הוא בישראל,"
        },
        {
          "s": 22,
          "text": "דע\"י ששיתף הקב\"ה את שמו בישראל,"
        },
        {
          "s": 23,
          "text": "הם בביטול,"
        },
        {
          "s": 24,
          "text": "כמבואר בארוכה בהמאמר."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה23 שמו של הקב\"ה ששיתף בישראל הוא למעלה יותר משמו שמשותף במלאכים."
        },
        {
          "s": 2,
          "text": "דבמלאכים כתיב אד' בם,"
        },
        {
          "s": 3,
          "text": "וכמבואר בתניא24"
        },
        {
          "s": 4,
          "text": "שהמלאכים נק' בשם אלקים,"
        },
        {
          "s": 5,
          "text": "דאלקים ואד' הם"
        },
        {
          "s": 6,
          "text": "(בכללות)"
        },
        {
          "s": 7,
          "text": "ענין אחד25,"
        },
        {
          "s": 8,
          "text": "אבל בישראל כתיב26"
        },
        {
          "s": 9,
          "text": "כי חלק הוי' עמו,"
        },
        {
          "s": 10,
          "text": "חלק משם הוי'27."
        },
        {
          "s": 11,
          "text": "והגם שהענין דחלק הוי' עמו הי' גם קודם מ\"ת,"
        },
        {
          "s": 12,
          "text": "לא האיר זה בגילוי"
        },
        {
          "s": 13,
          "text": "(כ\"כ),"
        },
        {
          "s": 14,
          "text": "כי הענין דחלק הוי' עמו הוא מצד הנשמה,"
        },
        {
          "s": 15,
          "text": "ובירידת הנשמה למטה,"
        },
        {
          "s": 16,
          "text": "הגוף מעלים ומסתיר על הנשמה ועל שם הוי' שבה,"
        },
        {
          "s": 17,
          "text": "ובמתן תורה,"
        },
        {
          "s": 18,
          "text": "ע\"י הדיבור אנכי הוי' אלקיך,"
        },
        {
          "s": 19,
          "text": "נמשך זה בגילוי."
        },
        {
          "s": 20,
          "text": "וכמבואר בלקו\"ת28,"
        },
        {
          "s": 21,
          "text": "דפירוש"
        },
        {
          "s": 22,
          "text": "(אנכי)"
        },
        {
          "s": 23,
          "text": "הוי' אלקיך הוא,"
        },
        {
          "s": 24,
          "text": "שהוי' יהי' מאיר ומתגלה בך כל כך עד שיהי' נקרא על שמך,"
        },
        {
          "s": 25,
          "text": "אלקיך."
        },
        {
          "s": 26,
          "text": "והכח על הוי' אלקיך"
        },
        {
          "s": 27,
          "text": "[שגם לאחרי שהנשמה מתלבשת בגוף יהי' הוי' בו בגילוי ועד שיהי' נקרא על שמו]"
        },
        {
          "s": 28,
          "text": "הוא מעצמות אוא\"ס שלמעלה גם מהוי'."
        },
        {
          "s": 29,
          "text": "דשם הוי'"
        },
        {
          "s": 30,
          "text": "(מצד עצמו),"
        },
        {
          "s": 31,
          "text": "הגילוי שלו הוא למעלה דוקא,"
        },
        {
          "s": 32,
          "text": "ובכדי שיהי' בגילוי למטה בגוף גשמי הוא ע\"י המשכת עצמות אוא\"ס שלמעלה מהוי',"
        },
        {
          "s": 33,
          "text": "דכל הגבוה יותר יורד ומתגלה למטה יותר29."
        },
        {
          "s": 34,
          "text": "וזהו אנכי הוי' אלקיך,"
        },
        {
          "s": 35,
          "text": "שהכח על זה שהוי' יהי' אלקיך,"
        },
        {
          "s": 36,
          "text": "הוא מבחינת אנכי שלמעלה גם מהוי'."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דכיון ששמו של הקב\"ה ששיתף בישראל הוא שם הוי' שלמעלה משם אד' שמשותף במלאכים"
        },
        {
          "s": 2,
          "text": "[ובפרט שהשורש דשיתוף שמו בישראל הוא מבחינת אנכי שלמעלה גם מהוי'],"
        },
        {
          "s": 3,
          "text": "לכן,"
        },
        {
          "s": 4,
          "text": "גם הביטול דישראל שנעשה ע\"י שמו ית' המשותף בהם הוא ביטול גדול יותר מביטול המלאכים."
        }
      ]
    }
  ]
}