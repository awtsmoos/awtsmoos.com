{
  "globalIndex": 361,
  "owner": 11,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915834_theRebbe_708__p002",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915834_theRebbe_708__p002",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915834_theRebbe_708",
  "title": "מאמר שלום רב לאוהבי תורתך תשל\"ח",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדם מארז\"ל14"
        },
        {
          "s": 2,
          "text": "עה\"פ15"
        },
        {
          "s": 3,
          "text": "על מה אבדה הארץ גו' על עזבם את תורתי על שלא ברכו בתורה תחלה,"
        },
        {
          "s": 4,
          "text": "דמזה מובן,"
        },
        {
          "s": 5,
          "text": "שענין ברכו בתורה תחלה הוא ענין עיקרי לא רק בעבודת האדם בכלל"
        },
        {
          "s": 6,
          "text": "(ועד שע\"י זה שלא ברכו בתורה אבדה הארץ)"
        },
        {
          "s": 7,
          "text": "אלא גם בלימוד התורה,"
        },
        {
          "s": 8,
          "text": "שהרי"
        },
        {
          "s": 9,
          "text": "(לא ברכו בתורה תחלה)"
        },
        {
          "s": 10,
          "text": "נקרא בכתוב עזבם את תורתי"
        },
        {
          "s": 11,
          "text": "(עזיבת התורה)."
        },
        {
          "s": 12,
          "text": "אלא שאין זה עזיבת התורה בכלל,"
        },
        {
          "s": 13,
          "text": "כי אם,"
        },
        {
          "s": 14,
          "text": "כלשון הכתוב על עזבם את תורתי"
        },
        {
          "s": 15,
          "text": "(תורתו של הקב\"ה)."
        },
        {
          "s": 16,
          "text": "דהנה ענין ברכו בתורה תחלה הוא להמשיך,"
        },
        {
          "s": 17,
          "text": "המשכת ברכה ושפע בתוך התורה16,"
        },
        {
          "s": 18,
          "text": "וכמובן גם מהלשון ברכו בתורה"
        },
        {
          "s": 19,
          "text": "(דלכאורה הול\"ל ברכו לפני',"
        },
        {
          "s": 20,
          "text": "לפני לימוד התורה,"
        },
        {
          "s": 21,
          "text": "ומהו ברכו בתורה),"
        },
        {
          "s": 22,
          "text": "כי ברכה היא מלשון המשכה וכמו המבריך17"
        },
        {
          "s": 23,
          "text": "את הגפן18"
        },
        {
          "s": 24,
          "text": "[וענין זה"
        },
        {
          "s": 25,
          "text": "(זריעה ונטיעה,"
        },
        {
          "s": 26,
          "text": "כולל המבריך את הגפן)"
        },
        {
          "s": 27,
          "text": "שייך במיוחד לכאן,"
        },
        {
          "s": 28,
          "text": "כי תורה ומצוותי' הו\"ע של זריעה בארץ19],"
        },
        {
          "s": 29,
          "text": "וברכו בתורה הוא ענין המשכת אוא\"ס בתוך התורה20."
        },
        {
          "s": 30,
          "text": "והוא ענין עסק התורה לשמה לשם התורה עצמה,"
        },
        {
          "s": 31,
          "text": "להמשיך בה גילוי אוא\"ס שלמעלה מהחכמה21,"
        },
        {
          "s": 32,
          "text": "וע\"ד מ\"ש בספר הבהיר22"
        },
        {
          "s": 33,
          "text": "ובספר מעין החכמה23"
        },
        {
          "s": 34,
          "text": "שדוד הי' מחבר תורה בהקב\"ה."
        },
        {
          "s": 35,
          "text": "וזהו על עזבם את תורתי על שלא ברכו בתורה תחלה,"
        },
        {
          "s": 36,
          "text": "כי ע\"י שברכו בתורה היא נעשית תורתי"
        },
        {
          "s": 37,
          "text": "[שממשיך בה אוא\"ס],"
        },
        {
          "s": 38,
          "text": "וכשלא ברכו בתורה תחלה הוא עזבם את תורתי,"
        },
        {
          "s": 39,
          "text": "שהתורה אז היא כמו שהיא מצד עצמה ואין נמשך בה גילוי אוא\"ס"
        },
        {
          "s": 40,
          "text": "(שלמעלה מהחכמה)."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "והגם שגם התורה כמו שהיא מצד עצמה היא תורתו של הקב\"ה שהוא וחכמתו אחד24,"
        },
        {
          "s": 1,
          "text": "וגם כאשר לומדה אדם לא טהור היא דבריו של הקב\"ה שלכן25"
        },
        {
          "s": 2,
          "text": "אינה מקבלת טומאה כמרז\"ל26"
        },
        {
          "s": 3,
          "text": "עה\"פ27"
        },
        {
          "s": 4,
          "text": "הלא כה דברי כאש מה אש אינו מקבל טומאה אף דברי תורה אינן מקבלין טומאה28"
        },
        {
          "s": 5,
          "text": "[דהגם שאדם לא טהור הלומד את התורה אינו שייך להעבודה לחבר תורה בהקב\"ה,"
        },
        {
          "s": 6,
          "text": "ואינו שייך גם להעבודה דברכו בתורה תחלה להמשיך אוא\"ס בתורה,"
        },
        {
          "s": 7,
          "text": "ומ\"מ גם התורה שלו היא דבריו של הקב\"ה ונמשלה לאש שבטבעו עולה29"
        },
        {
          "s": 8,
          "text": "למעלה],"
        },
        {
          "s": 9,
          "text": "הרי מובן,"
        },
        {
          "s": 10,
          "text": "דזה שהתורה שנלמדת ע\"י אדם לא טהור היא דבריו וחכמתו של הקב\"ה שהוא וחכמתו אחד,"
        },
        {
          "s": 11,
          "text": "הוא בהעלם,"
        },
        {
          "s": 12,
          "text": "ואין זה בערך להדרגא בתורה שהיא \"תורתי\""
        },
        {
          "s": 13,
          "text": "(תורתו של הקב\"ה)"
        },
        {
          "s": 14,
          "text": "בגילוי."
        },
        {
          "s": 15,
          "text": "ובפרט שענין ברכו בתורה תחלה הוא"
        },
        {
          "s": 16,
          "text": "(כנ\"ל)"
        },
        {
          "s": 17,
          "text": "להמשיך בהתורה גילוי אוא\"ס שלמעלה מהחכמה30."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יובן,"
        },
        {
          "s": 2,
          "text": "דהמעלה שבלימוד התורה שלאחרי התפלה היא לא רק בנוגע להלימוד"
        },
        {
          "s": 3,
          "text": "(דהאדם),"
        },
        {
          "s": 4,
          "text": "שהלימוד שלו שלאחרי הקדמת עבודת התפלה הוא באופן ד\"אוהבי תורתך\""
        },
        {
          "s": 5,
          "text": "(כנ\"ל סעיף ב),"
        },
        {
          "s": 6,
          "text": "אלא גם בנוגע להתורה"
        },
        {
          "s": 7,
          "text": "(שלומד),"
        },
        {
          "s": 8,
          "text": "כי הענין ד\"ברכו בתורה תחלה\","
        },
        {
          "s": 9,
          "text": "המשכת אוא\"ס בתורה,"
        },
        {
          "s": 10,
          "text": "הוא"
        },
        {
          "s": 11,
          "text": "(בעיקר)"
        },
        {
          "s": 12,
          "text": "בלימוד התורה שלאחרי הקדמת עבודת התפלה16."
        },
        {
          "s": 13,
          "text": "והענין,"
        },
        {
          "s": 14,
          "text": "כי בכדי להמשיך אוא\"ס בתורה הוא"
        },
        {
          "s": 15,
          "text": "(בעיקר)"
        },
        {
          "s": 16,
          "text": "כאשר לימוד התורה הוא בביטול31."
        },
        {
          "s": 17,
          "text": "ובכדי שלימוד התורה יהי' בביטול ה\"ז ע\"י הקדמת עבודת התפלה32."
        },
        {
          "s": 18,
          "text": "דהנה תפלה הו\"ע הביטול,"
        },
        {
          "s": 19,
          "text": "שבעת התפלה צריך לעמוד כעבד לפני רבו33,"
        },
        {
          "s": 20,
          "text": "שהוא ביטול נעלה יותר אפילו מהביטול דק\"ש."
        },
        {
          "s": 21,
          "text": "דבק\"ש אף שאסור לרמוז בעיניו ולקרוץ בשפתיו להראות באצבעותיו34"
        },
        {
          "s": 22,
          "text": "מ\"מ יש כמה ענינים שאפשר להפסיק בק\"ש35"
        },
        {
          "s": 23,
          "text": "משא\"כ בתפלה36."
        },
        {
          "s": 24,
          "text": "ועד שק\"ש היא"
        },
        {
          "s": 25,
          "text": "(גם)"
        },
        {
          "s": 26,
          "text": "בישיבה משא\"כ תפלה היא"
        },
        {
          "s": 27,
          "text": "(דוקא)"
        },
        {
          "s": 28,
          "text": "בעמידה ועד שאין עמידה אלא תפלה37,"
        },
        {
          "s": 29,
          "text": "שההפרש בין ישיבה לעמידה הוא שישיבה מורה על ענין ההתיישבות"
        },
        {
          "s": 30,
          "text": "[דזהו מה שפירש רש\"י עה\"פ38"
        },
        {
          "s": 31,
          "text": "וישב יעקב שביקש יעקב לישב בשלוה,"
        },
        {
          "s": 32,
          "text": "כי אמיתית ענין ההתיישבות"
        },
        {
          "s": 33,
          "text": "(וישב)"
        },
        {
          "s": 34,
          "text": "הוא לישב בשלוה],"
        },
        {
          "s": 35,
          "text": "משא\"כ עמידה מורה על ביטול39."
        },
        {
          "s": 36,
          "text": "וע\"י הביטול דתפלה,"
        },
        {
          "s": 37,
          "text": "גם לימוד התורה שלאחרי התפלה הוא בביטול,"
        },
        {
          "s": 38,
          "text": "ונמשך בה גילוי אוא\"ס."
        },
        {
          "s": 39,
          "text": "וי\"ל שזוהי שייכות ב' הפירושים במדרש40"
        },
        {
          "s": 40,
          "text": "עה\"פ41"
        },
        {
          "s": 41,
          "text": "והנה סולם מוצב ארצה וראשו מגיע השמימה,"
        },
        {
          "s": 42,
          "text": "פירוש א' סולם זה הכבש"
        },
        {
          "s": 43,
          "text": "(תפלה42)"
        },
        {
          "s": 44,
          "text": "ופירוש ב' סולם זה סיני"
        },
        {
          "s": 45,
          "text": "(תורה),"
        },
        {
          "s": 46,
          "text": "כי ע\"י הקדמת עבודת התפלה נעשה עילוי"
        },
        {
          "s": 47,
          "text": "(גם)"
        },
        {
          "s": 48,
          "text": "בתורה,"
        },
        {
          "s": 49,
          "text": "שנמשך בה גילוי אוא\"ס."
        }
      ]
    }
  ]
}