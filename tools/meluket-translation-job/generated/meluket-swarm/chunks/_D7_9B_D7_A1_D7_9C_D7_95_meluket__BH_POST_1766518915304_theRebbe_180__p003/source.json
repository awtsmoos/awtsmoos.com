{
  "globalIndex": 257,
  "owner": 7,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915304_theRebbe_180__p003",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915304_theRebbe_180__p003",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915304_theRebbe_180",
  "title": "מאמר ושבתי בשלום תשל\"ח",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר שזהו מה שמובא בתו\"א ותו\"ח תיכף ובהמשך לויצא יעקב מבאר שבע מש\"נ43"
        },
        {
          "s": 1,
          "text": "צוה ישועות יעקב,"
        },
        {
          "s": 2,
          "text": "שהוא המשכת בחי' שע\"ה נהורין דאריך44,"
        },
        {
          "s": 3,
          "text": "כי כמו שענין הישועה בפשטות הוא סיוע ונתינת כח מיוחד שלא ע\"ד הרגיל,"
        },
        {
          "s": 4,
          "text": "ונתינת כח זה הוא דוקא בשביל האדם שמושיעים אותו שהוא במעמד ומצב שפל ביותר שצריך לישועה,"
        },
        {
          "s": 5,
          "text": "עד\"ז הוא גם בפירוש הפנימי דישועות,"
        },
        {
          "s": 6,
          "text": "שענינם הוא שע\"ה נהורין דאריך,"
        },
        {
          "s": 7,
          "text": "שהמשכתן"
        },
        {
          "s": 8,
          "text": "(ליעקב)"
        },
        {
          "s": 9,
          "text": "היא דוקא בשביל המצב דיציאתו מבאר שבע והליכתו חרנה."
        },
        {
          "s": 10,
          "text": "שבכדי שיוכל להמשיך היו\"ד גם בחרן,"
        },
        {
          "s": 11,
          "text": "צריך להיות צוה ישועות יעקב,"
        },
        {
          "s": 12,
          "text": "להמשיך ליעקב שע\"ה נהורין דאריך שלמעלה מהשתלשלות,"
        },
        {
          "s": 13,
          "text": "למעלה גם מהיו\"ד דשם הוי',"
        },
        {
          "s": 14,
          "text": "היו\"ד דיעקב."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ויש להוסיף בדיוק לשון הכתוב צוה ישועות יעקב"
        },
        {
          "s": 1,
          "text": "(צוה דוקא),"
        },
        {
          "s": 2,
          "text": "שהמשכת הישועות"
        },
        {
          "s": 3,
          "text": "(שע\"ה נהורין)"
        },
        {
          "s": 4,
          "text": "ליעקב תהי' באופן דצוה,"
        },
        {
          "s": 5,
          "text": "לשון צותא וחיבור45."
        },
        {
          "s": 6,
          "text": "דהגם שהשע\"ה נהורין הם למעלה מיעקב,"
        },
        {
          "s": 7,
          "text": "למעלה גם מהיו\"ד שבו,"
        },
        {
          "s": 8,
          "text": "מ\"מ,"
        },
        {
          "s": 9,
          "text": "יהיו מחוברים ומיוחדים עמו,"
        },
        {
          "s": 10,
          "text": "אַז זיי ווערן אָפּגעגעבן צו אים בפנימיות."
        },
        {
          "s": 11,
          "text": "וע\"י שנמשך ליעקב בחי' ישועות הנ\"ל"
        },
        {
          "s": 12,
          "text": "(לצורך הליכתו לחרן),"
        },
        {
          "s": 13,
          "text": "הי' בטוח"
        },
        {
          "s": 14,
          "text": "(עוד לפני הליכתו לחרן46)"
        },
        {
          "s": 15,
          "text": "שתתקיים תפלתו,"
        },
        {
          "s": 16,
          "text": "שיהי' ונתן לי לחם לאכול ובגד ללבוש,"
        },
        {
          "s": 17,
          "text": "ויתירה מזו – ושבתי בשלום אל בית אבי,"
        },
        {
          "s": 18,
          "text": "ויתירה מזו – והי' הוי' לי לאלקים,"
        },
        {
          "s": 19,
          "text": "ויתירה מזו – והאבן הזאת אשר שמתי מצבה יהי' בית אלקים."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה תפלתו של יעקב"
        },
        {
          "s": 2,
          "text": "(באופן דנדר47)"
        },
        {
          "s": 3,
          "text": "אם יהי' אלקים עמדי גו' והאבן הזאת גו' יהי' בית אלקים היתה לאחרי העבודה דויקח48"
        },
        {
          "s": 4,
          "text": "מאבני המקום וישם מראשותיו."
        },
        {
          "s": 5,
          "text": "והענין הוא,"
        },
        {
          "s": 6,
          "text": "מקום הוא הגדר דעולם,"
        },
        {
          "s": 7,
          "text": "כדאיתא בתניא49"
        },
        {
          "s": 8,
          "text": "שגדר העולם הוא מקום"
        },
        {
          "s": 9,
          "text": "(וזמן)."
        },
        {
          "s": 10,
          "text": "[והגם שמקום הוא שמו של הקב\"ה שנקרא מקום,"
        },
        {
          "s": 11,
          "text": "לפי שהוא מקומו של עולם50,"
        },
        {
          "s": 12,
          "text": "הרי ענין זה הוא בהעלם,"
        },
        {
          "s": 13,
          "text": "ומה שנרגש בגילוי בהמקום הוא העולם."
        },
        {
          "s": 14,
          "text": "דזהו מה שהוי' ברבוע בגימטריא מקום51,"
        },
        {
          "s": 15,
          "text": "היינו שענין הוי' שנמשך במקום הוא רק באופן דגימטריא שהוא חשבון האותיות,"
        },
        {
          "s": 16,
          "text": "שהחשבון מורה52"
        },
        {
          "s": 17,
          "text": "על מיעוט האור כו' מיעוט אחר מיעוט]."
        },
        {
          "s": 18,
          "text": "ואבני המקום"
        },
        {
          "s": 19,
          "text": "(בחי' דומם)"
        },
        {
          "s": 20,
          "text": "הם סוג היותר תחתון שבעולם."
        },
        {
          "s": 21,
          "text": "ובזה גופא אבני לשון רבים,"
        },
        {
          "s": 22,
          "text": "כמו שהם בבחי' ריבוי ההתחלקות."
        },
        {
          "s": 23,
          "text": "וזהו ויקח מאבני המקום וישם מראשותיו,"
        },
        {
          "s": 24,
          "text": "שיעקב עשה53"
        },
        {
          "s": 25,
          "text": "מאבני המקום"
        },
        {
          "s": 26,
          "text": "(אבני לשון רבים)"
        },
        {
          "s": 27,
          "text": "אבן אחת"
        },
        {
          "s": 28,
          "text": "[שלכן כתיב וישם ולא וישימם54],"
        },
        {
          "s": 29,
          "text": "ולא עוד,"
        },
        {
          "s": 30,
          "text": "אלא שוישם מראשותיו,"
        },
        {
          "s": 31,
          "text": "שהגבי' והעלה את האבן עד שיגבי' את ראשו,"
        },
        {
          "s": 32,
          "text": "וי\"ל עוד יתירה מזה שהאבן למעלה מראשו55"
        },
        {
          "s": 33,
          "text": "של יעקב,"
        },
        {
          "s": 34,
          "text": "היינו למעלה מבחי' היו\"ד דיעקב56"
        },
        {
          "s": 35,
          "text": "(שהוא הראש שלו,"
        },
        {
          "s": 36,
          "text": "כנ\"ל)."
        },
        {
          "s": 37,
          "text": "ועל זה התפלל והאבן הזאת גו' יהי' בית אלקים,"
        },
        {
          "s": 38,
          "text": "שהאבן הזאת"
        },
        {
          "s": 39,
          "text": "(אבן אחת,"
        },
        {
          "s": 40,
          "text": "שעשה מריבוי אבנים)"
        },
        {
          "s": 41,
          "text": "תהי' לא רק למעלה מבחי' הראש"
        },
        {
          "s": 42,
          "text": "(היו\"ד)"
        },
        {
          "s": 43,
          "text": "דיעקב,"
        },
        {
          "s": 44,
          "text": "אלא שתהי' למעלה יותר – בית אלקים,"
        },
        {
          "s": 45,
          "text": "בית"
        },
        {
          "s": 46,
          "text": "(ודירה)"
        },
        {
          "s": 47,
          "text": "לעצמותו ית'."
        }
      ]
    }
  ]
}