{
  "globalIndex": 690,
  "owner": 40,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917817_theRebbe_541__p003",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917817_theRebbe_541__p003",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917817_theRebbe_541",
  "title": "מאמר כימי צאתך תשמ\"ב",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה אף שבחינת אתהפכא היא,"
        },
        {
          "s": 2,
          "text": "בכללות,"
        },
        {
          "s": 3,
          "text": "נעלית הרבה יותר מבחינת אתכפיא,"
        },
        {
          "s": 4,
          "text": "אעפ\"כ יש גם מעלה בבחינת אתכפיא לגבי בחינת אתהפכא53."
        },
        {
          "s": 5,
          "text": "וכמובן ממ\"ש בתניא54"
        },
        {
          "s": 6,
          "text": "דענין עובד אלקים הוא דוקא כשהוא כופה ומשנה הטבע שלו,"
        },
        {
          "s": 7,
          "text": "ומעלה זו אינה בצדיק גמור."
        },
        {
          "s": 8,
          "text": "וע\"י העבודה דאתכפיא דוקא אסתלק יקרא דקוב\"ה בכולהו עלמין55,"
        },
        {
          "s": 9,
          "text": "המשכת וגילוי אור שבבחינת רוממות56,"
        },
        {
          "s": 10,
          "text": "וכמבואר בארוכה בההמשך דיום ההילולא57"
        },
        {
          "s": 11,
          "text": "משל על זה ממלך בו\"ד שבשביל נצחון המלחמה הוא מבזבז את כל אוצרותיו,"
        },
        {
          "s": 12,
          "text": "דבשנים כתיקונן הנה לא רק שאינו משתמש בהם לשום דבר אלא שהם כמוסים וחתומים מעין כל רואה,"
        },
        {
          "s": 13,
          "text": "ודוקא בעת המלחמה הנה לא רק שהוא פותח את כל האוצרות,"
        },
        {
          "s": 14,
          "text": "אלא יתירה מזו שהוא מבזבז אותם בלי שום מדידה והגבלה ונותן אותם לאנשי החיל בכדי לנצח את המלחמה."
        },
        {
          "s": 15,
          "text": "והדוגמא מזה למעלה,"
        },
        {
          "s": 16,
          "text": "שיש בחינת אוצר שכמוס וחתום מעין כל רואה,"
        },
        {
          "s": 17,
          "text": "עין לא ראתה אלקים זולתך58,"
        },
        {
          "s": 18,
          "text": "ובכדי לנצח את המלחמה עם היצר,"
        },
        {
          "s": 19,
          "text": "העבודה דאתכפיא,"
        },
        {
          "s": 20,
          "text": "נותנים גם אוצר זה,"
        },
        {
          "s": 21,
          "text": "ובאופן של בזבוז,"
        },
        {
          "s": 22,
          "text": "ונתינת האוצר היא לאנשי החיל הפשוטים דוקא,"
        },
        {
          "s": 23,
          "text": "דלהיות שעבודתם היא במס\"נ למעלה ממדידת והגבלת השכל לכן גם נתינת האוצר להם היא באופן דבזבוז למעלה מכל מדידה והגבלה."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יובן מה שיזכירו יצי\"מ גם לע\"ל,"
        },
        {
          "s": 1,
          "text": "אף שהגילויים דלע\"ל הם נעלים יותר"
        },
        {
          "s": 2,
          "text": "(נפלאות)"
        },
        {
          "s": 3,
          "text": "מהגילויים שהיו ביצי\"מ,"
        },
        {
          "s": 4,
          "text": "כי מכיון שהמשכת בחינת האוצר הוא דוקא בשביל נצחון המלחמה,"
        },
        {
          "s": 5,
          "text": "ולע\"ל לא תהי' שום מלחמה עם היצר שהרי ואת רוח הטומאה אעביר מן הארץ,"
        },
        {
          "s": 6,
          "text": "לכן,"
        },
        {
          "s": 7,
          "text": "יזכירו יצי\"מ גם אז,"
        },
        {
          "s": 8,
          "text": "בכדי שיהי' גם המעלה שבאתכפיא,"
        },
        {
          "s": 9,
          "text": "המשכת בחינת האוצר."
        },
        {
          "s": 10,
          "text": "וגם המשכה זו תהי' אז בתכלית הגילוי"
        },
        {
          "s": 11,
          "text": "(ככל הענינים דלעתיד),"
        },
        {
          "s": 12,
          "text": "ולא יכנף עוד מוריך."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וזהו כימי צאתך מארץ מצרים אראנו נפלאות,"
        },
        {
          "s": 2,
          "text": "שבגאולה העתידה יהיו ב' המעלות,"
        },
        {
          "s": 3,
          "text": "המעלה דאתכפיא,"
        },
        {
          "s": 4,
          "text": "כימי צאתך מארץ מצרים,"
        },
        {
          "s": 5,
          "text": "והמעלה דאתהפכא,"
        },
        {
          "s": 6,
          "text": "אראנו נפלאות."
        },
        {
          "s": 7,
          "text": "דע\"י מעשינו ועבודתינו בזמן הגלות59,"
        },
        {
          "s": 8,
          "text": "שכללות העבודה דזמן הגלות היא באופן דמס\"נ למעלה ממדוה\"ג60,"
        },
        {
          "s": 9,
          "text": "שהרי בזמן הגלות ובפרט בעקבתא דמשיחא יש מונעים ומעכבים וריבוי נסיונות,"
        },
        {
          "s": 10,
          "text": "ועד להנסיון דלא יתבייש מפני בני אדם המלעיגים עליו61,"
        },
        {
          "s": 11,
          "text": "ואעפ\"כ אין מתחשבים עם כל המניעות,"
        },
        {
          "s": 12,
          "text": "ולומדים תורה ומקיימים מצוות בלי כל חשבונות,"
        },
        {
          "s": 13,
          "text": "ועד שאפילו ריקנים שבך מלאים מצוות כרימון62,"
        },
        {
          "s": 14,
          "text": "דלא רק שהם מקיימים מצוות אלא שהם מלאים מצוות,"
        },
        {
          "s": 15,
          "text": "הנה עי\"ז יוצאים מהגלות ברכוש גדול של מצוות ורכוש גדול של תורה"
        },
        {
          "s": 16,
          "text": "[דגם ת\"ת היא מצוה,"
        },
        {
          "s": 17,
          "text": "ואדרבא,"
        },
        {
          "s": 18,
          "text": "היא שקולה כנגד כל המצוות63],"
        },
        {
          "s": 19,
          "text": "ומכיון שזה"
        },
        {
          "s": 20,
          "text": "(הרכוש גדול דתומ\"צ)"
        },
        {
          "s": 21,
          "text": "מוסיף בהזכות הרי זה מוסיף זירוז גם בהאחישנה64,"
        },
        {
          "s": 22,
          "text": "ובאופן דוארו עם ענני שמיא65,"
        },
        {
          "s": 23,
          "text": "שבקרוב ממש תהי' הגאולה האמיתית והשלימה,"
        },
        {
          "s": 24,
          "text": "ובאופן דכימי צאתך מארץ מצרים אראנו נפלאות היינו שיהיו ב' המעלות."
        },
        {
          "s": 25,
          "text": "דמכיון שהגאולה היא ע\"י מעשינו ועבודתינו בזמן הגלות,"
        },
        {
          "s": 26,
          "text": "ובפרט בעקבתא דמשיחא,"
        },
        {
          "s": 27,
          "text": "לכן תהי' כימי צאתך מארץ מצרים,"
        },
        {
          "s": 28,
          "text": "המעלה דאתכפיא,"
        },
        {
          "s": 29,
          "text": "ויחד עם זה יהי' גם אראנו נפלאות,"
        },
        {
          "s": 30,
          "text": "נפלאות גם בערך הנפלאות"
        },
        {
          "s": 31,
          "text": "(אותות ומופתים)"
        },
        {
          "s": 32,
          "text": "שהיו ביצי\"מ,"
        },
        {
          "s": 33,
          "text": "כולל גם הנפלאות שהיו בעת קריעת ים סוף,"
        },
        {
          "s": 34,
          "text": "דהגם שבקרי\"ס היו גילויים נעלים ביותר,"
        },
        {
          "s": 35,
          "text": "דכאו\"א מראה באצבעו ואומר זה א-לי ואנוהו66,"
        },
        {
          "s": 36,
          "text": "ועד שראתה שפחה על הים מה שלא ראו נביאים67,"
        },
        {
          "s": 37,
          "text": "הנה כל זה הי' על הים,"
        },
        {
          "s": 38,
          "text": "מלובש בבחינת מלכות68"
        },
        {
          "s": 39,
          "text": "[ובדוגמת הגילוי דיצי\"מ"
        },
        {
          "s": 40,
          "text": "(לפני קרי\"ס)"
        },
        {
          "s": 41,
          "text": "שהי' על הפתח],"
        },
        {
          "s": 42,
          "text": "וגם הגילוי דקרי\"ס הי' רק לפי שעה,"
        },
        {
          "s": 43,
          "text": "כי הגילוי אז הי' מצד מלמעלה והמטה לא הי' כלי לזה,"
        },
        {
          "s": 44,
          "text": "דבכללות הוא ענין אתכפיא ולא אתהפכא"
        },
        {
          "s": 45,
          "text": "[בדוגמת יצי\"מ שהיתה באופן דכי ברח העם]."
        },
        {
          "s": 46,
          "text": "מכיון שזה לא בא מצד עבודת המטה."
        },
        {
          "s": 47,
          "text": "אמנם לע\"ל יהי' אראנו נפלאות,"
        },
        {
          "s": 48,
          "text": "נפלאות גם בערך הנפלאות שהיו ביצי\"מ וקרי\"ס,"
        },
        {
          "s": 49,
          "text": "שהגילוי יהי' בלי שום לבוש וגם מצד המטה,"
        },
        {
          "s": 50,
          "text": "ויחד עם זה יהי' גם המעלה דכימי צאתך מארץ מצרים,"
        },
        {
          "s": 51,
          "text": "במהרה בימינו ממש,"
        },
        {
          "s": 52,
          "text": "בביאת משיח צדקנו."
        }
      ]
    }
  ]
}