{
  "globalIndex": 790,
  "owner": 40,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918517_theRebbe_122__p002",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918517_theRebbe_122__p002",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918517_theRebbe_122",
  "title": "מאמר שיר המעלות תשכ\"ב",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ולכאורה7 יש להוסיף,"
        },
        {
          "s": 1,
          "text": "דהביאור שבהמאמר"
        },
        {
          "s": 2,
          "text": "(בשני הענינים דשבת אחים וגם יחד)"
        },
        {
          "s": 3,
          "text": "הוא גם להפירוש8"
        },
        {
          "s": 4,
          "text": "שאחים קאי על בני ישראל,"
        },
        {
          "s": 5,
          "text": "שבהאהבה והאחוה שלהם שתי מדריגות בכללות."
        },
        {
          "s": 6,
          "text": "התקשרות"
        },
        {
          "s": 7,
          "text": "(בדוגמת קישורי תנאים),"
        },
        {
          "s": 8,
          "text": "ועי\"ז באים אח\"כ להתאחדות."
        },
        {
          "s": 9,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 10,
          "text": "דזה שמביא בהמאמר פירוש הזהר דשבת אחים גם יחד קאי על היחוד דקוב\"ה וכנס\"י,"
        },
        {
          "s": 11,
          "text": "הוא,"
        },
        {
          "s": 12,
          "text": "כי בכדי שהאהבה והאחוה דישראל תהי' באופן דיחד"
        },
        {
          "s": 13,
          "text": "(דוגמת היחוד דנשואין),"
        },
        {
          "s": 14,
          "text": "הוא9"
        },
        {
          "s": 15,
          "text": "ע\"י גילוי היחוד דישראל עם קוב\"ה10."
        },
        {
          "s": 16,
          "text": "ועפ\"ז יש לבאר גם מה שהכתוב11"
        },
        {
          "s": 17,
          "text": "ממשיך"
        },
        {
          "s": 18,
          "text": "(דשבת אחים גם יחד הוא)"
        },
        {
          "s": 19,
          "text": "כשמן הטוב על הראש יורד על הזקן זקן אהרן שיורד על פי מדותיו,"
        },
        {
          "s": 20,
          "text": "כי בכדי שהיחוד דקוב\"ה וישראל יפעול בישראל אהבה ואחוה אמיתית עד באופן דיחד,"
        },
        {
          "s": 21,
          "text": "הוא ע\"י ירידת והמשכת שמן הטוב,"
        },
        {
          "s": 22,
          "text": "כדלקמן"
        },
        {
          "s": 23,
          "text": "(סעיף ח)."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים דאיתא בזהר12"
        },
        {
          "s": 2,
          "text": "זמנא חדא הוה צריכא עלמא למיטרא,"
        },
        {
          "s": 3,
          "text": "אתו לקמי' דרשב\"י,"
        },
        {
          "s": 4,
          "text": "וע\"י שאמר דרוש בפסוק הנה מה טוב ומה נעים שבת אחים גם יחד ירד מטר."
        },
        {
          "s": 5,
          "text": "וידוע הדיוק בזה13,"
        },
        {
          "s": 6,
          "text": "הרי מצינו שבכדי לפעול ירידת גשמים היו מוסיפים שש ברכות בשמו\"ע14"
        },
        {
          "s": 7,
          "text": "וגוזרים י\"ג תעניות15,"
        },
        {
          "s": 8,
          "text": "וחוני המעגל עג עוגה ועמד בתוכה והתפלל16,"
        },
        {
          "s": 9,
          "text": "ורשב\"י פעל זה ע\"י אמירת דרוש בלי יגיעה כלל."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ונקודת הביאור בזה"
        },
        {
          "s": 1,
          "text": "(כמובן מהדרושים),"
        },
        {
          "s": 2,
          "text": "דזה שצריך להשתדלות מיוחדה לפעול ירידת גשמים הוא בתפלה."
        },
        {
          "s": 3,
          "text": "דכיון שתפלה היא מלמטה למעלה,"
        },
        {
          "s": 4,
          "text": "לכן בכדי שהעבודה"
        },
        {
          "s": 5,
          "text": "(תפלה)"
        },
        {
          "s": 6,
          "text": "דהתחתונים תעורר ותמשיך גשמים"
        },
        {
          "s": 7,
          "text": "(דשרש הגשמים הוא למעלה מהשתלשלות17)"
        },
        {
          "s": 8,
          "text": "צריכה להיות השתדלות מיוחדה."
        },
        {
          "s": 9,
          "text": "ורשב\"י המשיך ירידת גשמים ע\"י אמירת תורה,"
        },
        {
          "s": 10,
          "text": "דתורה היא מלמעלה למטה,"
        },
        {
          "s": 11,
          "text": "ולכן לא הי' צריך לעבודה וליגיעה."
        }
      ]
    }
  ]
}