{
  "globalIndex": 239,
  "owner": 39,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915193_theRebbe_723__p004",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915193_theRebbe_723__p004",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518915193_theRebbe_723",
  "title": "מאמר ויאמר לו יהונתן תשמ\"ה",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "וזהו27 יצחק בן אברהם אברהם הוליד את יצחק,"
        },
        {
          "s": 1,
          "text": "יצחק בן אברהם"
        },
        {
          "s": 2,
          "text": "(שיצחק עצמו הוא בן אברהם)"
        },
        {
          "s": 3,
          "text": "הוא שההעלאה עצמה באה ע\"י קדימת ההמשכה,"
        },
        {
          "s": 4,
          "text": "ואברהם הוליד את יצחק,"
        },
        {
          "s": 5,
          "text": "הוליד הוא לשון פועל יוצא שנותן את כח התולדה ביצחק,"
        },
        {
          "s": 6,
          "text": "הוא,"
        },
        {
          "s": 7,
          "text": "שהכח שבהעלאת המטה להגיע למעלה נמשך"
        },
        {
          "s": 8,
          "text": "(מתגלה)"
        },
        {
          "s": 9,
          "text": "ע\"י ההמשכה מלמעלה"
        },
        {
          "s": 10,
          "text": "(שלפני ההעלאה)."
        },
        {
          "s": 11,
          "text": "ויש לומר,"
        },
        {
          "s": 12,
          "text": "שעד\"ז הוא בויאמר לו יהונתן מחר חודש,"
        },
        {
          "s": 13,
          "text": "המשכת הנתינת כח מז\"א למלכות על הענין דמחר חודש,"
        },
        {
          "s": 14,
          "text": "שיש בזה שני ענינים,"
        },
        {
          "s": 15,
          "text": "דוגמת שני הענינים שבההמשכה מאברהם ליצחק."
        },
        {
          "s": 16,
          "text": "הנתינת כח על הענין דיפקד מושבך,"
        },
        {
          "s": 17,
          "text": "הביטול וההעלאה דמלכות – ע\"ד יצחק בן אברהם,"
        },
        {
          "s": 18,
          "text": "והנתינת כח שע\"י יפקד מושבך יהי' ונפקדת – ע\"ד אברהם הוליד את יצחק."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה בהמעלה דהעלאה מלמטה למעלה לגבי המשכה מלמעלה למטה,"
        },
        {
          "s": 2,
          "text": "שני ענינים."
        },
        {
          "s": 3,
          "text": "שההעלאה מלמטה למעלה מעוררת וממשכת ממקום נעלה יותר מההמשכה הבאה מלמעלה מצד עצמה."
        },
        {
          "s": 4,
          "text": "[וכמובא לעיל מהדרושים שהמעלה דהעלאה לגבי המשכה היא ע\"ד אשה מזרעת תחלה יולדת זכר,"
        },
        {
          "s": 5,
          "text": "שהולדת האהבה שבבחינת זכר"
        },
        {
          "s": 6,
          "text": "(אהבה רבה)"
        },
        {
          "s": 7,
          "text": "באה מהאתערותא דלעילא28,"
        },
        {
          "s": 8,
          "text": "אלא שזה שהאתערותא דלעילא נמשכת מפנימיות האור"
        },
        {
          "s": 9,
          "text": "(שלכן נולד ממנה אהבה רבה)"
        },
        {
          "s": 10,
          "text": "הוא מפני שהמשכתה הוא על ידי האתערותא דלתתא28]."
        },
        {
          "s": 11,
          "text": "והמעלה דההעלאה עצמה,"
        },
        {
          "s": 12,
          "text": "שהיא נעלית יותר גם מההמשכה שע\"י העלאה."
        },
        {
          "s": 13,
          "text": "וכמבואר בהדרושים29"
        },
        {
          "s": 14,
          "text": "המעלה דאור חוזר"
        },
        {
          "s": 15,
          "text": "(העלאה)"
        },
        {
          "s": 16,
          "text": "שהוא חוזר לקדמות המאציל ממש."
        },
        {
          "s": 17,
          "text": "ולכן לע\"ל יאמר ליצחק דוקא כי אתה אבינו30,"
        },
        {
          "s": 18,
          "text": "לפי שאז יתגלה המעלה שבהעלאה עצמה."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דשני הענינים שייכים זל\"ז."
        },
        {
          "s": 2,
          "text": "דזה שע\"י ההעלאה,"
        },
        {
          "s": 3,
          "text": "ההמשכה היא נעלית יותר,"
        },
        {
          "s": 4,
          "text": "הוא מצד העילוי שבהעלאה עצמה."
        },
        {
          "s": 5,
          "text": "אלא שעכשיו,"
        },
        {
          "s": 6,
          "text": "שעיקר המעלה היא בההמשכה מלמעלה,"
        },
        {
          "s": 7,
          "text": "המעלה דהעלאה היא שההמשכה שעל ידה היא המשכה נעלית יותר,"
        },
        {
          "s": 8,
          "text": "ולע\"ל תתגלה המעלה דהעלאה עצמה31."
        },
        {
          "s": 9,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 10,
          "text": "דענין יצחק"
        },
        {
          "s": 11,
          "text": "[בן אברהם]"
        },
        {
          "s": 12,
          "text": "הוא נעלה יותר מהענין ד"
        },
        {
          "s": 13,
          "text": "[אברהם]"
        },
        {
          "s": 14,
          "text": "הוליד את יצחק."
        },
        {
          "s": 15,
          "text": "דענין הוליד את יצחק,"
        },
        {
          "s": 16,
          "text": "המשכת כח ההולדה ביצחק,"
        },
        {
          "s": 17,
          "text": "הולדת האהבה שבבחינת זכר על ידי העלאת מ\"ן"
        },
        {
          "s": 18,
          "text": "(אשה כי תזריע),"
        },
        {
          "s": 19,
          "text": "הוא מעלת ההמשכה שעל ידי ההעלאה."
        },
        {
          "s": 20,
          "text": "וענין יצחק"
        },
        {
          "s": 21,
          "text": "(בן אברהם)"
        },
        {
          "s": 22,
          "text": "הוא מעלת ההעלאה עצמה."
        },
        {
          "s": 23,
          "text": "וזהו שביצחק בן אברהם נאמר יצחק לפני אברהם,"
        },
        {
          "s": 24,
          "text": "ובאברהם הוליד את יצחק נאמר אברהם לפני יצחק32,"
        },
        {
          "s": 25,
          "text": "כי באברהם הוליד את יצחק,"
        },
        {
          "s": 26,
          "text": "עיקר המעלה היא בההמשכה,"
        },
        {
          "s": 27,
          "text": "ולכן ההתחלה והעיקר הוא אברהם,"
        },
        {
          "s": 28,
          "text": "וביצחק בן אברהם"
        },
        {
          "s": 29,
          "text": "(יצחק עצמו),"
        },
        {
          "s": 30,
          "text": "עיקר המעלה היא בההעלאה,"
        },
        {
          "s": 31,
          "text": "ולכן נאמר תחלה יצחק,"
        },
        {
          "s": 32,
          "text": "כי הוא העיקר"
        },
        {
          "s": 33,
          "text": "(ואח\"כ מבאר שהדרך לבוא לההעלאה דיצחק הוא על ידי המשכה מלמעלה למטה,"
        },
        {
          "s": 34,
          "text": "בן אברהם)."
        }
      ]
    }
  ]
}