{
  "globalIndex": 34,
  "owner": 34,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913852_theRebbe_463__p006",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913852_theRebbe_463__p006",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518913852_theRebbe_463",
  "title": "מאמר זה היום תחילת מעשיך תשמ\"ב",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "והנה ג' ענינים אלו"
        },
        {
          "s": 2,
          "text": "(ממלא סובב ועצמות אוא\"ס)"
        },
        {
          "s": 3,
          "text": "יש כביכול דוגמתם באדם."
        },
        {
          "s": 4,
          "text": "דכיון שאדם הוא אדמה לעליון,"
        },
        {
          "s": 5,
          "text": "לכן יש בו דוגמת כל הענינים שלמעלה."
        },
        {
          "s": 6,
          "text": "דכחות הפנימיים שבאדם,"
        },
        {
          "s": 7,
          "text": "שהם בגילוי באברי הגוף,"
        },
        {
          "s": 8,
          "text": "הם דוגמת אור הממלא שמתלבש ומשפיע בעולמות בבחי' גילוי83."
        },
        {
          "s": 9,
          "text": "וכחות המקיפים שבאדם,"
        },
        {
          "s": 10,
          "text": "וכמו הרצון שפועל בכל הכחות והאברים אלא שאינו בגילוי בהם84,"
        },
        {
          "s": 11,
          "text": "הם דוגמת אור הסובב85"
        },
        {
          "s": 12,
          "text": "שהשפעתו בעולמות הוא בהעלם83."
        },
        {
          "s": 13,
          "text": "ועצם הנפש שלמעלה גם מכחות המקיפים הוא דוגמת עצמות אוא\"ס."
        },
        {
          "s": 14,
          "text": "ומזה מובן,"
        },
        {
          "s": 15,
          "text": "שהעבודות דמלכיות וזכרונות הם בכחות"
        },
        {
          "s": 16,
          "text": "(הפנימיים ומקיפים)"
        },
        {
          "s": 17,
          "text": "הנפש,"
        },
        {
          "s": 18,
          "text": "והעבודה דשופרות היא בעצם הנפש."
        },
        {
          "s": 19,
          "text": "וכנ\"ל,"
        },
        {
          "s": 20,
          "text": "שקול השופר הוא קלא פנימאה שמפנימיות הלב."
        },
        {
          "s": 21,
          "text": "והנה הגם שענין השופר הוא צעקה פנימית שמפנימיות הלב,"
        },
        {
          "s": 22,
          "text": "מ\"מ,"
        },
        {
          "s": 23,
          "text": "צריכה להיות הצעקה ע\"י תקיעה בשופר גשמי דוקא,"
        },
        {
          "s": 24,
          "text": "שופר של כבש ואיל,"
        },
        {
          "s": 25,
          "text": "חי"
        },
        {
          "s": 26,
          "text": "(שלמטה ממדבר),"
        },
        {
          "s": 27,
          "text": "כמבואר בדרוש הנ\"ל דהצ\"צ86,"
        },
        {
          "s": 28,
          "text": "ויתירה מזו,"
        },
        {
          "s": 29,
          "text": "שקרן השופר צ\"ל תלוש"
        },
        {
          "s": 30,
          "text": "(מהכבש והאיל),"
        },
        {
          "s": 31,
          "text": "דומם."
        },
        {
          "s": 32,
          "text": "דמזה מובן גם בעבודה הרוחנית,"
        },
        {
          "s": 33,
          "text": "שהעבודה דשופר עם היותה מפנימיות ועצמות הנפש,"
        },
        {
          "s": 34,
          "text": "צריכה להיות"
        },
        {
          "s": 35,
          "text": "(גם)"
        },
        {
          "s": 36,
          "text": "בהדומם שבאדם."
        },
        {
          "s": 37,
          "text": "ועי\"ז דוקא מתעוררת ומתגלית הצעקה הפנימית שמפנימיות הלב."
        },
        {
          "s": 38,
          "text": "וע\"ד הידוע87"
        },
        {
          "s": 39,
          "text": "בענין דצח\"מ שבאדם שדוקא הדומם שבאדם שייך להמדבר שבו,"
        },
        {
          "s": 40,
          "text": "עד\"ז הוא גם בהמקיפים דאדם שלמעלה מחילוקי דרגות דצח\"מ"
        },
        {
          "s": 41,
          "text": "(בדוגמת הסובב שלמעלה מחילוקי הדרגות דהשתלשלות),"
        },
        {
          "s": 42,
          "text": "וגם בעצם הנפש"
        },
        {
          "s": 43,
          "text": "(שלמעלה גם מכחות המקיפים),"
        },
        {
          "s": 44,
          "text": "שהתעוררותם והתגלותם היא דוקא ע\"י הדומם שבאדם."
        },
        {
          "s": 45,
          "text": "ולכן צריך לתקוע בשופר גשמי דוקא,"
        },
        {
          "s": 46,
          "text": "דומם,"
        },
        {
          "s": 47,
          "text": "כי הגילוי דקלא פנימאה שמפנימיות הלב הוא לא בהרצון שבראש"
        },
        {
          "s": 48,
          "text": "(גלגלתא),"
        },
        {
          "s": 49,
          "text": "ועאכו\"כ שאינו מתגלה ומתלבש בחב\"ד שבמוחין או במדות שבלב,"
        },
        {
          "s": 50,
          "text": "אלא דוקא בהדומם שבו,"
        },
        {
          "s": 51,
          "text": "העבודה דקבלת עול,"
        },
        {
          "s": 52,
          "text": "דומם שבנפש האדם"
        },
        {
          "s": 53,
          "text": "[וע\"ד הידוע88"
        },
        {
          "s": 54,
          "text": "בענין יראה תתאה שבה דוקא מתגלה בחינת יראה עילאה],"
        },
        {
          "s": 55,
          "text": "ולמטה יותר – ענין המעשה"
        },
        {
          "s": 56,
          "text": "(ששייך להדומם דגוף האדם),"
        },
        {
          "s": 57,
          "text": "תקיעה בשופר גשמי."
        },
        {
          "s": 58,
          "text": "ועד שענין זה"
        },
        {
          "s": 59,
          "text": "(תקיעת שופר במעשה)"
        },
        {
          "s": 60,
          "text": "דוקא היא המצוה היחידה – מצות היום דראש השנה,"
        },
        {
          "s": 61,
          "text": "כמארז\"ל89"
        },
        {
          "s": 62,
          "text": "מצות היום בשופר."
        },
        {
          "s": 63,
          "text": "ובזה יובן מאמר כ\"ק מו\"ח אדמו\"ר90"
        },
        {
          "s": 64,
          "text": "בשם אדמו\"ר הזקן"
        },
        {
          "s": 65,
          "text": "(בקשר לראש השנה)"
        },
        {
          "s": 66,
          "text": "\"מען האָט גאָר קיין השגה ניט,"
        },
        {
          "s": 67,
          "text": "ווי עס איז טייער באַ השי\"ת דער גוף פון אַ אידן\","
        },
        {
          "s": 68,
          "text": "דאין הכוונה בזה שאפילו הגוף הוא יקר אצל השי\"ת,"
        },
        {
          "s": 69,
          "text": "אלא שעיקר היוקר הוא בהגוף."
        },
        {
          "s": 70,
          "text": "דזהו שאומר \"מען האָט גאָר קיין השגה ניט\","
        },
        {
          "s": 71,
          "text": "כי יוקר הגוף הוא למעלה מהשגה והבנה,"
        },
        {
          "s": 72,
          "text": "כי יוקר הגוף דישראל"
        },
        {
          "s": 73,
          "text": "(דומם)"
        },
        {
          "s": 74,
          "text": "הוא מצד העצמות91."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "ויש להוסיף,"
        },
        {
          "s": 1,
          "text": "דכיון שנתאוה הקב\"ה להיות לו ית' דירה בתחתונים,"
        },
        {
          "s": 2,
          "text": "שגם העולם הגשמי"
        },
        {
          "s": 3,
          "text": "(שמחוץ להאדם)"
        },
        {
          "s": 4,
          "text": "יהי' דירה לו ית',"
        },
        {
          "s": 5,
          "text": "לכן אין מספיק מה שקלא פנימאה"
        },
        {
          "s": 6,
          "text": "(בחינת פנימיות הלב)"
        },
        {
          "s": 7,
          "text": "מתגלה על ידי הדומם"
        },
        {
          "s": 8,
          "text": "(קבלת עול,"
        },
        {
          "s": 9,
          "text": "ומעשה)"
        },
        {
          "s": 10,
          "text": "שבאדם,"
        },
        {
          "s": 11,
          "text": "אלא צריך שגילוי קול זה"
        },
        {
          "s": 12,
          "text": "(קלא פנימאה,"
        },
        {
          "s": 13,
          "text": "שמבחינת פנימיות הלב)"
        },
        {
          "s": 14,
          "text": "יהי' על ידי שופר של בהמה,"
        },
        {
          "s": 15,
          "text": "ובזה גופא,"
        },
        {
          "s": 16,
          "text": "כמו שהוא נפסק ממקום חיותו,"
        },
        {
          "s": 17,
          "text": "דומם,"
        },
        {
          "s": 18,
          "text": "דעי\"ז דוקא פועל האדם"
        },
        {
          "s": 19,
          "text": "(גם)"
        },
        {
          "s": 20,
          "text": "בהעולם"
        },
        {
          "s": 21,
          "text": "(ובדומם שבו)"
        },
        {
          "s": 22,
          "text": "שיהי' דירה לו ית'."
        },
        {
          "s": 23,
          "text": "בדוגמת כמו שהי' בראש השנה בפעם הראשונה,"
        },
        {
          "s": 24,
          "text": "שאדם הראשון פעל"
        },
        {
          "s": 25,
          "text": "(גם)"
        },
        {
          "s": 26,
          "text": "בהנבראים"
        },
        {
          "s": 27,
          "text": "(שמחוצה לו)"
        },
        {
          "s": 28,
          "text": "שיהי' בהם נשתחוה ונכרעה נברכה לפני ה' עושינו."
        },
        {
          "s": 29,
          "text": "וענין זה דשופר"
        },
        {
          "s": 30,
          "text": "[תקיעת שופר בגשמיות,"
        },
        {
          "s": 31,
          "text": "בשופר של בהמה,"
        },
        {
          "s": 32,
          "text": "וכמו שנעשה דומם]"
        },
        {
          "s": 33,
          "text": "הוא מלשון שפרו מעשיכם,"
        },
        {
          "s": 34,
          "text": "פנימיות התענוג"
        },
        {
          "s": 35,
          "text": "(כנ\"ל),"
        },
        {
          "s": 36,
          "text": "כי עי\"ז דוקא נשלמת הכוונה דנתאוה הקב\"ה."
        },
        {
          "s": 37,
          "text": "וכ\"ה גם בפשטות הענינים שהנח\"ר שלמעלה מזה שנעשה רצוני"
        },
        {
          "s": 38,
          "text": "[דנח\"ר זה הוא פנימיות התענוג,"
        },
        {
          "s": 39,
          "text": "שלמעלה מהתענוג דחפץ חסד"
        },
        {
          "s": 40,
          "text": "(כנ\"ל סעיף ג)]"
        },
        {
          "s": 41,
          "text": "הוא מקיום המצוה כפשוטה בגשמיות"
        },
        {
          "s": 42,
          "text": "(בשופר דומם של בהמה),"
        },
        {
          "s": 43,
          "text": "נעשה רצוני."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "והנה הנח\"ר והתענוג דלמעלה מזה שנעשה רצוני הוא בכל השנה,"
        },
        {
          "s": 3,
          "text": "אלא שבראש השנה הוא עיקר מצות היום וכו',"
        },
        {
          "s": 4,
          "text": "והעילוי שבראש השנה הוא לפי אופן העבודה והנח\"ר שעי\"ז במשך כל השנה."
        },
        {
          "s": 5,
          "text": "דכשישראל מוסיפים"
        },
        {
          "s": 6,
          "text": "(בעבודתם,"
        },
        {
          "s": 7,
          "text": "ובמילא)"
        },
        {
          "s": 8,
          "text": "בהנח\"ר במשך כל השנה,"
        },
        {
          "s": 9,
          "text": "ניתוסף גם בהנח\"ר מזה שנעשה רצוני בראש השנה."
        },
        {
          "s": 10,
          "text": "ומכיון שכל אחד ואחד מישראל פעל בודאי בשנה שעברה כל הענינים,"
        },
        {
          "s": 11,
          "text": "כל ישראל בחזקת כשרות הם92,"
        },
        {
          "s": 12,
          "text": "דענין החזקה הוא עמוד חזק בתורה,"
        },
        {
          "s": 13,
          "text": "ובפרט לאחרי העבודה דחודש אלול,"
        },
        {
          "s": 14,
          "text": "ובאלול גופא לאחרי ח\"י אלול שמכניס חיות בכל הענינים דחודש אלול93"
        },
        {
          "s": 15,
          "text": "[נוסף לזה שהוא יום הבהיר שבו נולדו שני המאורות הגדולים94],"
        },
        {
          "s": 16,
          "text": "שאז החזקת כשרות דכאו\"א מישראל היא ביתר שאת ויתר עוז,"
        },
        {
          "s": 17,
          "text": "ומיום ליום"
        },
        {
          "s": 18,
          "text": "(בהימים שמח\"י אלול ואילך)"
        },
        {
          "s": 19,
          "text": "הכשרות דכאו\"א מישראל היא באופן דהולך ומוסיף ואור,"
        },
        {
          "s": 20,
          "text": "ובפרט בימי הסליחות,"
        },
        {
          "s": 21,
          "text": "הרי ברור שאתם נצבים היום כולכם95,"
        },
        {
          "s": 22,
          "text": "כמ\"ש בהסדרה שקראו בשבת דמיני'96"
        },
        {
          "s": 23,
          "text": "מתברכין כולהו יומין,"
        },
        {
          "s": 24,
          "text": "וכפירוש הבעש\"ט97"
        },
        {
          "s": 25,
          "text": "דהיום קאי על ראש השנה98"
        },
        {
          "s": 26,
          "text": "שהוא יום הדין,"
        },
        {
          "s": 27,
          "text": "ואתם"
        },
        {
          "s": 28,
          "text": "(כאו\"א מישראל,"
        },
        {
          "s": 29,
          "text": "כולכם)"
        },
        {
          "s": 30,
          "text": "נצבים קיימים ועומדים שזוכים בדין,"
        },
        {
          "s": 31,
          "text": "דענין זה"
        },
        {
          "s": 32,
          "text": "(הזכי' בדין)"
        },
        {
          "s": 33,
          "text": "יש כבר בערב ראש השנה,"
        },
        {
          "s": 34,
          "text": "שלכן בערב ראש השנה לובשים לבנים ומתעטפים לבנים99"
        },
        {
          "s": 35,
          "text": "וכו',"
        },
        {
          "s": 36,
          "text": "והולכים בשמחה,"
        },
        {
          "s": 37,
          "text": "ובשמחה גדולה100,"
        },
        {
          "s": 38,
          "text": "להכתיר את המלך בראש השנה,"
        },
        {
          "s": 39,
          "text": "כי כבר בערב ראש השנה ישנם כל ההכנות הדרושות,"
        },
        {
          "s": 40,
          "text": "דשמחה פורצת כל הגדרים101."
        },
        {
          "s": 41,
          "text": "וזה נעשה גם הכנה קרובה ליעלה הפורץ לפנינו בקרוב ממש,"
        },
        {
          "s": 42,
          "text": "שבהכתיבה וחתימה טובה לשנה טובה ומתוקה יהי' ויוכלל ויודגש שהשנה תהי' שנת גאולה,"
        },
        {
          "s": 43,
          "text": "גאולה האמיתית והשלימה ע\"י משיח צדקנו,"
        },
        {
          "s": 44,
          "text": "יעלה הפורץ לפנינו,"
        },
        {
          "s": 45,
          "text": "ובמהרה בימינו ממש."
        }
      ]
    }
  ]
}