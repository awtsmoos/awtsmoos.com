{
  "globalIndex": 421,
  "owner": 21,
  "jobId": "_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916159_theRebbe_933__p003",
  "batchId": "meluket-_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916159_theRebbe_933__p003",
  "seriesId": "טבת_meluket",
  "postId": "BH_POST_1766518916159_theRebbe_933",
  "title": "מאמר ודוד עבדי תשל\"ב",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה מבואר בתו\"א שם,"
        },
        {
          "s": 2,
          "text": "דהטעם על זה שבארץ דוקא יש ענין הביטול"
        },
        {
          "s": 3,
          "text": "[שהארץ היא מדרס תחת כפות רגלי הכל]"
        },
        {
          "s": 4,
          "text": "הוא מפני שבמחשבה ארץ קדמה לשמים."
        },
        {
          "s": 5,
          "text": "ועד\"ז הוא בנוגע להביטול שבדומם,"
        },
        {
          "s": 6,
          "text": "דזה שדומם הוא בביטול"
        },
        {
          "s": 7,
          "text": "[דענין הצומח הוא שהוא גדל בגובה והתנשאות,"
        },
        {
          "s": 8,
          "text": "וענין הביטול הוא בדומם דוקא],"
        },
        {
          "s": 9,
          "text": "הוא מפני ששורש הדומם הוא למעלה משורש הצומח."
        },
        {
          "s": 10,
          "text": "ועד\"ז הוא בז\"א ומלכות"
        },
        {
          "s": 11,
          "text": "[שהם דוגמת שמים וארץ,"
        },
        {
          "s": 12,
          "text": "דומם וצומח],"
        },
        {
          "s": 13,
          "text": "דזה שהמלכות היא בביטול הוא מפני ששרשה הוא בכתר"
        },
        {
          "s": 14,
          "text": "(למעלה מהשורש דז\"א)."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דזה שהמשל על ספירת המלכות בכחות הנפש הוא כח הדיבור,"
        },
        {
          "s": 2,
          "text": "הוא גם בנוגע להביטול דמלכות."
        },
        {
          "s": 3,
          "text": "ויש לומר,"
        },
        {
          "s": 4,
          "text": "דבהביטול שבדיבור,"
        },
        {
          "s": 5,
          "text": "שני ענינים."
        },
        {
          "s": 6,
          "text": "שהדיבור אינו ענין של מעלה."
        },
        {
          "s": 7,
          "text": "דענינם של כל הכחות הוא שהם מגלים את הנפש,"
        },
        {
          "s": 8,
          "text": "ענין של מעלה ושלימות,"
        },
        {
          "s": 9,
          "text": "וכח הדיבור שאינו גילוי הנפש,"
        },
        {
          "s": 10,
          "text": "אינו ענין של מעלה."
        },
        {
          "s": 11,
          "text": "ועוד ענין בהביטול שבדיבור,"
        },
        {
          "s": 12,
          "text": "דענין הדיבור הוא שהאדם המדבר יוצא ממציאותו"
        },
        {
          "s": 13,
          "text": "(מבטל עצמו)"
        },
        {
          "s": 14,
          "text": "בשביל הזולת."
        },
        {
          "s": 15,
          "text": "ועד\"ז הוא בהביטול דמלכות,"
        },
        {
          "s": 16,
          "text": "דנוסף לזה שהמלכות אינה ענין של גילוי,"
        },
        {
          "s": 17,
          "text": "היא יורדת להחיות ולהוות את הנבראים26."
        },
        {
          "s": 18,
          "text": "ויש לומר,"
        },
        {
          "s": 19,
          "text": "דביטול זה שבמלכות מרומז במ\"ש בתו\"א שיהודה"
        },
        {
          "s": 20,
          "text": "(מלכות)"
        },
        {
          "s": 21,
          "text": "הוא לשון הודאה וביטול,"
        },
        {
          "s": 22,
          "text": "שהביטול דהודאה הוא שמבטל את עצמו לזה שהוא מודה אליו."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה ידוע27,"
        },
        {
          "s": 2,
          "text": "דע\"י שאדם מביא את השכל"
        },
        {
          "s": 3,
          "text": "(שהשיג במחשבתו)"
        },
        {
          "s": 4,
          "text": "בדיבור,"
        },
        {
          "s": 5,
          "text": "מיתוסף בהשכל יותר מכמו שהי' תחלה"
        },
        {
          "s": 6,
          "text": "(במחשבה)."
        },
        {
          "s": 7,
          "text": "וכן הוא במדות,"
        },
        {
          "s": 8,
          "text": "דע\"י שמדבר דברי אהבה מיתוסף בהאהבה שלו."
        },
        {
          "s": 9,
          "text": "וכן הוא בשאר המדות."
        },
        {
          "s": 10,
          "text": "והטעם לזה הוא,"
        },
        {
          "s": 11,
          "text": "כי שורש הדיבור הוא בעצם הנפש,"
        },
        {
          "s": 12,
          "text": "ולכן,"
        },
        {
          "s": 13,
          "text": "ע\"י המשכת והתלבשות השכל והמדות בדיבור,"
        },
        {
          "s": 14,
          "text": "המשכתם מהנפש היא ממקום נעלה יותר."
        },
        {
          "s": 15,
          "text": "ויש לומר,"
        },
        {
          "s": 16,
          "text": "שגם דרגת הנפש שמשם נמשכים השכל והמדות ע\"י התלבשותם בדיבור היא למטה מדרגת הנפש שממנה נמשך הדיבור עצמו28."
        },
        {
          "s": 17,
          "text": "כי זה שהשכל והמדות"
        },
        {
          "s": 18,
          "text": "(הגילויים דהנפש)"
        },
        {
          "s": 19,
          "text": "נמשכים ומתלבשים בדיבור הוא ע\"י שנמשך בהם ענין הבל\"ג דנפש שביכלתה לירד למטה מטה."
        },
        {
          "s": 20,
          "text": "דהגם שגם ענין זה שבנפש הוא בדרגת הנפש שהיא למעלה משורש השכל והמדות"
        },
        {
          "s": 21,
          "text": "[שלכן,"
        },
        {
          "s": 22,
          "text": "ע\"י המשכת דרגא זו,"
        },
        {
          "s": 23,
          "text": "מיתוסף בהשכל והמדות],"
        },
        {
          "s": 24,
          "text": "מ\"מ,"
        },
        {
          "s": 25,
          "text": "ענין זה שבנפש"
        },
        {
          "s": 26,
          "text": "(שביכלתה לירד למטה מטה)"
        },
        {
          "s": 27,
          "text": "הוא בחינת הגילוי שלה."
        },
        {
          "s": 28,
          "text": "אבל השורש דכח הדיבור עצמו"
        },
        {
          "s": 29,
          "text": "(שאינו ענין הגילוי),"
        },
        {
          "s": 30,
          "text": "שרשו הוא בעצם הנפש."
        }
      ]
    }
  ]
}