{
  "globalIndex": 982,
  "owner": 32,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919577_theRebbe_550__p003",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919577_theRebbe_550__p003",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919577_theRebbe_550",
  "title": "מאמר הללויה שירו להוי' גו' תשט\"ז",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "והנה ענין זה גופא שיכולים לקבל יניקה ע\"י ב' אופנים אלו,"
        },
        {
          "s": 1,
          "text": "הרי זה תלוי בעבודת האדם."
        },
        {
          "s": 2,
          "text": "דהנה כתיב21"
        },
        {
          "s": 3,
          "text": "יעקב חבל נחלתו,"
        },
        {
          "s": 4,
          "text": "וכמו למשל22"
        },
        {
          "s": 5,
          "text": "החבל שראשו אחד קשור למעלה וראשו א' למטה,"
        },
        {
          "s": 6,
          "text": "הנה כשמתנענע הקצה התחתון מתנענע גם קצה העליון."
        },
        {
          "s": 7,
          "text": "ועד\"ז הוא גם בעבודת נש\"י,"
        },
        {
          "s": 8,
          "text": "שלפי אופן עבודת האדם למטה נעשה ג\"כ למעלה."
        },
        {
          "s": 9,
          "text": "והיינו שכאשר האדם משפיל את עצמו בדברים גשמיים,"
        },
        {
          "s": 10,
          "text": "דתמורת זה שהי' צריך להיות פנימיות רצונו לאלקות בת\"ת ותפלה,"
        },
        {
          "s": 11,
          "text": "הנה תמורת זה משפיל את עצמו בדברים גשמיים,"
        },
        {
          "s": 12,
          "text": "עי\"ז הוא גורם גם למעלה ריבוי הצמצומים עד שיוכל להיות מזה יניקת החיצונים."
        },
        {
          "s": 13,
          "text": "וכן כשאדם מגבי' את עצמו בבחי' התנשאות וגסות,"
        },
        {
          "s": 14,
          "text": "דהגם שיודע בעצמו היטב את הפחיתות שלו,"
        },
        {
          "s": 15,
          "text": "מ\"מ הוא מתנשא בלא טעם ודעת,"
        },
        {
          "s": 16,
          "text": "הנה רוח אייתי רוח23,"
        },
        {
          "s": 17,
          "text": "שגורם יניקת החיצונים ממקום גבוה מאד."
        },
        {
          "s": 18,
          "text": "וזהו ענין פרעה אותיות העורף24,"
        },
        {
          "s": 19,
          "text": "שמקבל מבחי' עורף דאריך,"
        },
        {
          "s": 20,
          "text": "שהוא בחי' גבוה מאד,"
        },
        {
          "s": 21,
          "text": "וענין זה תלוי בעבודה,"
        },
        {
          "s": 22,
          "text": "שכאשר פנו אלי עורף ולא פנים25"
        },
        {
          "s": 23,
          "text": "(כמ\"ש בהפטרה),"
        },
        {
          "s": 24,
          "text": "הנה עי\"ז נמשך בחי' פרעה שיונק מעורף דא\"א,"
        },
        {
          "s": 25,
          "text": "ששם כחשיכה כאורה כו'."
        },
        {
          "s": 26,
          "text": "וזהו ענין חרב של שתי פיות,"
        },
        {
          "s": 27,
          "text": "כדי להכרית יניקתם מב' האופנים."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ולהבין הענין בפרטיות,"
        },
        {
          "s": 2,
          "text": "הנה מבואר בספרי קבלה וחסידות בהדרושים דמצרים ויציאת מצרים,"
        },
        {
          "s": 3,
          "text": "דמצרים הוא מיצר הגרון,"
        },
        {
          "s": 4,
          "text": "שבגרון יש ג' בחי',"
        },
        {
          "s": 5,
          "text": "קנה וושט וורידין,"
        },
        {
          "s": 6,
          "text": "שהו\"ע ג' שרי פרעה26,"
        },
        {
          "s": 7,
          "text": "שר המשקים שר הטבחים ושר האופים."
        },
        {
          "s": 8,
          "text": "והנה,"
        },
        {
          "s": 9,
          "text": "כשם שיש מצרים וג' שרי פרעה בלעו\"ז,"
        },
        {
          "s": 10,
          "text": "כמו\"כ יש מצרים וג' השרים גם בקדושה."
        },
        {
          "s": 11,
          "text": "דשר המשקים הוא המשכת התענוג,"
        },
        {
          "s": 12,
          "text": "שהרי מים מצמיחים כל מיני תענוג27,"
        },
        {
          "s": 13,
          "text": "והו\"ע המשכת התענוג האלקי בכל סדר ההשתלשלות."
        },
        {
          "s": 14,
          "text": "ובגוף האדם הוא הקנה,"
        },
        {
          "s": 15,
          "text": "דבקנה יש גידי המוח וע\"י הגידים נמשך התענוג מהמוח בכל הגוף,"
        },
        {
          "s": 16,
          "text": "כמארז\"ל28"
        },
        {
          "s": 17,
          "text": "תלת קני הוי חד פריש ללבא וחד פריש לריאה וחד פריש לכבדא,"
        },
        {
          "s": 18,
          "text": "שהם אברים כללים,"
        },
        {
          "s": 19,
          "text": "וזהו\"ע הקנה שהוא ממשיך את התענוג מהמוח ע\"י גידי המוח בכל הגוף."
        },
        {
          "s": 20,
          "text": "ובעבודה הוא לימוד התורה בתענוג,"
        },
        {
          "s": 21,
          "text": "שהתענוג הוא הפנימיות שמהתורה,"
        },
        {
          "s": 22,
          "text": "וכמו\"כ התענוג בתפלה,"
        },
        {
          "s": 23,
          "text": "דזהו\"ע שר המשקים."
        },
        {
          "s": 24,
          "text": "ושר הטבחים בעבודה הו\"ע רתיחת הדמים בקדושה,"
        },
        {
          "s": 25,
          "text": "שהוא בחי' אהבה כרשפי אש,"
        },
        {
          "s": 26,
          "text": "דשר המשקים הו\"ע אהבה בתענוגים שהיא אהבה שנמשכת כמים,"
        },
        {
          "s": 27,
          "text": "ושר הטבחים הוא אהבה כרשפי אש."
        },
        {
          "s": 28,
          "text": "ושר האופים הוא תורה,"
        },
        {
          "s": 29,
          "text": "והיינו דהגם שנת\"ל דשר המשקים הוא תורה,"
        },
        {
          "s": 30,
          "text": "הנה זהו התענוג דתורה,"
        },
        {
          "s": 31,
          "text": "אבל תורה סתם הו\"ע שר האופים,"
        },
        {
          "s": 32,
          "text": "דתורה נקראת חטה,"
        },
        {
          "s": 33,
          "text": "בגימטריא כ\"ב29,"
        },
        {
          "s": 34,
          "text": "כ\"ב אתוון דאורייתא,"
        },
        {
          "s": 35,
          "text": "ומהחטה צריך לעשות לחם,"
        },
        {
          "s": 36,
          "text": "כמ\"ש30"
        },
        {
          "s": 37,
          "text": "לכו לחמו בלחמי,"
        },
        {
          "s": 38,
          "text": "ובכדי שמהחטה תהי' לחם הרי זה ע\"י אפי',"
        },
        {
          "s": 39,
          "text": "כמ\"ש31"
        },
        {
          "s": 40,
          "text": "ואפו עשר נשים לחמכם בתנור אחד,"
        },
        {
          "s": 41,
          "text": "דתנור הוא חמימות האהבה כרשפי אש,"
        },
        {
          "s": 42,
          "text": "ואחד הוא יחידו של עולם,"
        },
        {
          "s": 43,
          "text": "ותנור אחד היינו הקאָך והרשפי אש בענין יחידו של עולם,"
        },
        {
          "s": 44,
          "text": "הרי שיש כאן ב' ענינים,"
        },
        {
          "s": 45,
          "text": "ענין התנור שהוא הרשפי אש,"
        },
        {
          "s": 46,
          "text": "וענין יחידו של עולם שהוא נעלה ביותר,"
        },
        {
          "s": 47,
          "text": "וזהו\"ע שר האופים שהוא התורה,"
        },
        {
          "s": 48,
          "text": "שהוא ממוצע בין הב' קוים דשר המשקים ושר הטבחים."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "והנה ג' שרים אלו דקדושה כורתים את החיות מהג' שרים דלעו\"ז."
        },
        {
          "s": 1,
          "text": "דהנה גם בלעו\"ז יש ג' שרי פרעה,"
        },
        {
          "s": 2,
          "text": "דשר המשקים בלעו\"ז הוא התענוג בענינים גשמיים,"
        },
        {
          "s": 3,
          "text": "דהגם שהוא תאות היתר,"
        },
        {
          "s": 4,
          "text": "מ\"מ,"
        },
        {
          "s": 5,
          "text": "השקוע בהם גורם שאינו שייך כלל לענין אלקי."
        },
        {
          "s": 6,
          "text": "ושר הטבחים הוא רתיחת הדמים בדברים גשמיים וגם בדברים חומריים."
        },
        {
          "s": 7,
          "text": "ושר האופים הוא שבכללות ענינו אינו מונח בתורה כי אם בגשמיות."
        },
        {
          "s": 8,
          "text": "וע\"י הג' שרים כמו שהם בקדושה מכריתים את היניקה מהג' שרי פרעה דלעו\"ז."
        },
        {
          "s": 9,
          "text": "דהנה,"
        },
        {
          "s": 10,
          "text": "ע\"י שר המשקים בקדושה שהוא העבודה דאהבה בתענוגים,"
        },
        {
          "s": 11,
          "text": "שענינו הוא המשכת התענוג בהשתלשלות ע\"י ספירת החכמה,"
        },
        {
          "s": 12,
          "text": "שזהו\"ע הקנה,"
        },
        {
          "s": 13,
          "text": "קנה חכמה קנה בינה32,"
        },
        {
          "s": 14,
          "text": "הנה עי\"ז הוא מכרית את היניקה שיונקים ממקום גבוה,"
        },
        {
          "s": 15,
          "text": "דכאשר ההמשכה היא ע\"י החכמה שענינה ביטול,"
        },
        {
          "s": 16,
          "text": "אזי אי אפשר להם לקבל,"
        },
        {
          "s": 17,
          "text": "כי,"
        },
        {
          "s": 18,
          "text": "מה שיונקים ממקום הגבוה,"
        },
        {
          "s": 19,
          "text": "הרי זה כשהוא בבחי' מקיף דוקא,"
        },
        {
          "s": 20,
          "text": "אבל כאשר נמשך בפנימיות,"
        },
        {
          "s": 21,
          "text": "אזי אין יכולים לינק,"
        },
        {
          "s": 22,
          "text": "כמבואר בקונטרס ומעין33"
        },
        {
          "s": 23,
          "text": "בארוכה."
        },
        {
          "s": 24,
          "text": "וזהו\"ע שר המשקים שכורת היניקה ממקום הגבוה."
        },
        {
          "s": 25,
          "text": "וע\"י שר הטבחים בקדושה הוא כורת את היניקה מריבוי צמצומים,"
        },
        {
          "s": 26,
          "text": "שנעשה עי\"ז שהאדם משפיל את עצמו בדברים גשמיים,"
        },
        {
          "s": 27,
          "text": "והיינו שע\"י האהבה כרשפי אש ורתיחת הדמים בקדושה,"
        },
        {
          "s": 28,
          "text": "נכלה רתיחות הדמים שבלעו\"ז,"
        },
        {
          "s": 29,
          "text": "שזהו מה שתרגם ע\"פ שר הטבחים,"
        },
        {
          "s": 30,
          "text": "רב קטוליא,"
        },
        {
          "s": 31,
          "text": "שענינו הוא כדאיתא בגמרא34"
        },
        {
          "s": 32,
          "text": "ע\"פ35"
        },
        {
          "s": 33,
          "text": "זובח תודה יכבדנני,"
        },
        {
          "s": 34,
          "text": "כל הזובח את יצרו כו',"
        },
        {
          "s": 35,
          "text": "והיינו שע\"י רתיחות הדמים שבקדושה הרי הוא מכלה את רתיחות הדמים שבלעו\"ז,"
        },
        {
          "s": 36,
          "text": "ובמילא מתבטלת היניקה שמצד ריבוי הצמצומים."
        }
      ]
    }
  ]
}