{
  "globalIndex": 247,
  "owner": 47,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915244_theRebbe_950__p006",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915244_theRebbe_950__p006",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915244_theRebbe_950",
  "title": "מאמר פדה בשלום תשכ\"ב",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "והענין הוא,"
        },
        {
          "s": 2,
          "text": "דכיון שהכוונה בירידת ונפילת הנצוצות היא בכדי שיתבררו ויחזרו למקורם"
        },
        {
          "s": 3,
          "text": "[שעי\"ז יתעלו למעלה יותר מכמו שהיו קודם ירידתם],"
        },
        {
          "s": 4,
          "text": "הרי אין שייך שיהי' איזה מניעה ועיכוב"
        },
        {
          "s": 5,
          "text": "(מצד הנצוצות)"
        },
        {
          "s": 6,
          "text": "להבירור שלהם."
        },
        {
          "s": 7,
          "text": "דזה שאפשר להיות מניעה ועיכוב הוא רק מצד האדם"
        },
        {
          "s": 8,
          "text": "(המברר),"
        },
        {
          "s": 9,
          "text": "שיש לו בחירה חפשית,"
        },
        {
          "s": 10,
          "text": "אבל מצד הנצוצות – מוכרח שיתבררו."
        },
        {
          "s": 11,
          "text": "[וזהו מ\"ש ואדונירם על המס53,"
        },
        {
          "s": 12,
          "text": "אדונירם הוא אדוני רם,"
        },
        {
          "s": 13,
          "text": "אדוני הוא ע\"ד שם אד'"
        },
        {
          "s": 14,
          "text": "(בחינת שכינתי')"
        },
        {
          "s": 15,
          "text": "ורם מלשון רוממות הוא אור א\"ס שלמעלה מעולמות"
        },
        {
          "s": 16,
          "text": "(קוב\"ה)."
        },
        {
          "s": 17,
          "text": "וע\"פ המבואר לקמן"
        },
        {
          "s": 18,
          "text": "(סעיף יו\"ד)"
        },
        {
          "s": 19,
          "text": "דענין הבירורים הוא ליחדא קוב\"ה ושכינתי',"
        },
        {
          "s": 20,
          "text": "יש לומר,"
        },
        {
          "s": 21,
          "text": "דמס הו\"ע הבירורים."
        },
        {
          "s": 22,
          "text": "ונק' בשם מס,"
        },
        {
          "s": 23,
          "text": "שמס הוא דבר שמוכרח לשלם."
        },
        {
          "s": 24,
          "text": "ובחינת אדונירם הוא המכריח גביית המס,"
        },
        {
          "s": 25,
          "text": "בירור הנצוצות]."
        },
        {
          "s": 26,
          "text": "ויתירה מזה,"
        },
        {
          "s": 27,
          "text": "שהנצוצות רוצים ומשתוקקים להתברר."
        },
        {
          "s": 28,
          "text": "וזהו ברבים היו עמדי,"
        },
        {
          "s": 29,
          "text": "שהנצוצות הנמצאים בבחינת רבים"
        },
        {
          "s": 30,
          "text": "(רשות הרבים,"
        },
        {
          "s": 31,
          "text": "טורי דפרודא54)"
        },
        {
          "s": 32,
          "text": "משתוקקים שיבררו אותם"
        },
        {
          "s": 33,
          "text": "[בדוגמת ענין ברבים היו עמדי בפשטות,"
        },
        {
          "s": 34,
          "text": "שאנשי אבשלום התפללו לנצחונו של דוד55]."
        },
        {
          "s": 35,
          "text": "אלא דכיון שהנצוצות הם בגלות בבחינת רבים,"
        },
        {
          "s": 36,
          "text": "אין זה בגילוי."
        },
        {
          "s": 37,
          "text": "ועד שלפעמים נדמה להאדם שעניני העולם"
        },
        {
          "s": 38,
          "text": "(לא רק שאינם מסייעים,"
        },
        {
          "s": 39,
          "text": "אלא)"
        },
        {
          "s": 40,
          "text": "מונעים אותו מעבודת ה',"
        },
        {
          "s": 41,
          "text": "כי ההעלם דהנצוצות הוא העלם בתכלית,"
        },
        {
          "s": 42,
          "text": "ע\"ד העלם שאינו במציאות."
        },
        {
          "s": 43,
          "text": "וע\"י העבודה דברבים היו עמדי,"
        },
        {
          "s": 44,
          "text": "התעוררות היחידה,"
        },
        {
          "s": 45,
          "text": "עצם הנשמה שלמעלה מהתפשטות"
        },
        {
          "s": 46,
          "text": "(מציאות),"
        },
        {
          "s": 47,
          "text": "מתעורר ומתגלה ההעלם שאינו במציאות דהנצוצות,"
        },
        {
          "s": 48,
          "text": "והתשוקה שלהם להתברר,"
        },
        {
          "s": 49,
          "text": "ענין ברבים היו עמדי,"
        },
        {
          "s": 50,
          "text": "ואזי רואים בגילוי שעניני העולם"
        },
        {
          "s": 51,
          "text": "(לא רק שאינם מונעים,"
        },
        {
          "s": 52,
          "text": "אלא)"
        },
        {
          "s": 53,
          "text": "מסייעים לעבודת ה'."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "וזהו פדה בשלום נפשי מקרב לי כי ברבים היו עמדי,"
        },
        {
          "s": 2,
          "text": "דהשלום של הבירור שע\"י העבודה דברבים היו עמדי"
        },
        {
          "s": 3,
          "text": "(התעוררות היחידה)"
        },
        {
          "s": 4,
          "text": "הוא בשלימות,"
        },
        {
          "s": 5,
          "text": "שכולל שתי המעלות"
        },
        {
          "s": 6,
          "text": "(כנ\"ל סעיף ו),"
        },
        {
          "s": 7,
          "text": "כי ע\"י העבודה דברבים היו עמדי,"
        },
        {
          "s": 8,
          "text": "התעוררות היחידה,"
        },
        {
          "s": 9,
          "text": "מתגלה שהנצוצות שנמצאים בגלות ב"
        },
        {
          "s": 10,
          "text": "(רשות ה)"
        },
        {
          "s": 11,
          "text": "רבים היו עמדי"
        },
        {
          "s": 12,
          "text": "(הרצון והתשוקה שלהם להתברר),"
        },
        {
          "s": 13,
          "text": "ולכן גם הבירור בדרך מלמעלה למטה יש בו מעין המעלה שהבירור הוא מצד התחתון,"
        },
        {
          "s": 14,
          "text": "כי גם בירור זה הוא שהתחתון רוצה להתברר"
        },
        {
          "s": 15,
          "text": "(אלא שהבירור בפועל הוא ע\"י גילוי אור שלמעלה ממנו)."
        },
        {
          "s": 16,
          "text": "ועד\"ז לאידך,"
        },
        {
          "s": 17,
          "text": "שגם הבירור שבדרך מלמטה למעלה הוא באופן שמתבטל ההתנגדות של התחתון."
        },
        {
          "s": 18,
          "text": "דזה שנתבאר לעיל"
        },
        {
          "s": 19,
          "text": "(סעיף ה)"
        },
        {
          "s": 20,
          "text": "שגם לאחרי הבירור דהתחתון"
        },
        {
          "s": 21,
          "text": "(בירור בדרך מלמטה למעלה)"
        },
        {
          "s": 22,
          "text": "נשאר עדיין בהעלם ההתנגדות שלו,"
        },
        {
          "s": 23,
          "text": "הוא,"
        },
        {
          "s": 24,
          "text": "מפני שבירור התחתון הוא ענין שנתוסף בו"
        },
        {
          "s": 25,
          "text": "(ע\"י המברר שנתלבש בו),"
        },
        {
          "s": 26,
          "text": "היפך הטבע דהתחתון."
        },
        {
          "s": 27,
          "text": "וכמו נפש הבהמית שבטבעה נמשכת לענינים גשמיים,"
        },
        {
          "s": 28,
          "text": "והאהבה לאלקות"
        },
        {
          "s": 29,
          "text": "[שנעשה אצלה ע\"י נפש האלקית שנתלבש בה]"
        },
        {
          "s": 30,
          "text": "הוא היפך טבעה."
        },
        {
          "s": 31,
          "text": "ומזה מובן,"
        },
        {
          "s": 32,
          "text": "דכשהתחתון הוא באופן שעוד לפני ההתלבשות של המברר בו"
        },
        {
          "s": 33,
          "text": "(עבודת הבירור)"
        },
        {
          "s": 34,
          "text": "הוא רוצה ומשתוקק"
        },
        {
          "s": 35,
          "text": "(בגילוי)"
        },
        {
          "s": 36,
          "text": "להתברר,"
        },
        {
          "s": 37,
          "text": "אזי,"
        },
        {
          "s": 38,
          "text": "הבירור אינו דבר נוסף עליו,"
        },
        {
          "s": 39,
          "text": "ומכש\"כ שאינו היפך טבעו,"
        },
        {
          "s": 40,
          "text": "ולכן הבירור שלו"
        },
        {
          "s": 41,
          "text": "(גם הבירור שבדרך התלבשות)"
        },
        {
          "s": 42,
          "text": "הוא ע\"ד הענין דאתהפכא."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "והנה ידוע56"
        },
        {
          "s": 3,
          "text": "דכללות ענין העבודה הוא ליחדא קוב\"ה ושכינתי'."
        },
        {
          "s": 4,
          "text": "והו\"ע יחוד סובב וממלא,"
        },
        {
          "s": 5,
          "text": "כי קוב\"ה הוא בחינת סוכ\"ע ושכינתי' הוא בחינת ממכ\"ע57."
        },
        {
          "s": 6,
          "text": "וזהו שאמר יעקב ושבתי בשלום אל בית אבי והי' הוי' לי לאלקים,"
        },
        {
          "s": 7,
          "text": "שע\"י עבודת הבירורים"
        },
        {
          "s": 8,
          "text": "(ושבתי בשלום אל בית אבי,"
        },
        {
          "s": 9,
          "text": "החזרת הנצוצות למקורם)"
        },
        {
          "s": 10,
          "text": "[דעיקר העבודה שבשבילה ירדה הנשמה למטה היא עבודת הבירורים58]"
        },
        {
          "s": 11,
          "text": "יהי' והי' הוי' לי לאלקים,"
        },
        {
          "s": 12,
          "text": "יחוד הוי'"
        },
        {
          "s": 13,
          "text": "(סובב)"
        },
        {
          "s": 14,
          "text": "ואלקים"
        },
        {
          "s": 15,
          "text": "(ממלא)."
        },
        {
          "s": 16,
          "text": "ויש לומר,"
        },
        {
          "s": 17,
          "text": "דע\"י עבודת הבירורים בשני האופנים"
        },
        {
          "s": 18,
          "text": "(בדרך מלמעלה למטה ובדרך מלמטה למעלה),"
        },
        {
          "s": 19,
          "text": "ובאופן שכל אחד מהם כלול משניהם,"
        },
        {
          "s": 20,
          "text": "עי\"ז,"
        },
        {
          "s": 21,
          "text": "היחוד דסובב וממלא הוא בשני האופנים,"
        },
        {
          "s": 22,
          "text": "המשכת סובב בממלא והעלאת ממלא בסובב,"
        },
        {
          "s": 23,
          "text": "ובאופן שכל אחד מהם כלול משניהם."
        },
        {
          "s": 24,
          "text": "ועפ\"ז יש לבאר השייכות דענין זה ליעקב דוקא,"
        },
        {
          "s": 25,
          "text": "כי ההתכללות דשני האופנים שבעבודת הבירורים שבכל אחד מהם ישנם שתי המעלות,"
        },
        {
          "s": 26,
          "text": "הוא ע\"י גילוי בחינת היחידה,"
        },
        {
          "s": 27,
          "text": "למעלה מהגבלה,"
        },
        {
          "s": 28,
          "text": "וזה שביעקב נאמר59"
        },
        {
          "s": 29,
          "text": "ופרצת ימה וקדמה וצפונה ונגבה,"
        },
        {
          "s": 30,
          "text": "נחלה בלי מצרים60,"
        },
        {
          "s": 31,
          "text": "הוא לפי שהי' בו גילוי היחידה"
        },
        {
          "s": 32,
          "text": "(כמו שנתבאר לעיל61)."
        }
      ]
    }
  ]
}