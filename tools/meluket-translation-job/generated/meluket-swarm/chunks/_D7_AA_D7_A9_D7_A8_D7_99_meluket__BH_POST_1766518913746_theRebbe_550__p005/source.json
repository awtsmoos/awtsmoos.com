{
  "globalIndex": 12,
  "owner": 12,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913746_theRebbe_550__p005",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913746_theRebbe_550__p005",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518913746_theRebbe_550",
  "title": "מאמר והיה ביום ההוא תשכ\"ח",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ולהוסיף,"
        },
        {
          "s": 1,
          "text": "דע\"פ מ\"ש כ\"ק מו\"ח אדמו\"ר"
        },
        {
          "s": 2,
          "text": "(בהמאמר ד\"ה והי' ביום ההוא יתקע בשופר גדול54)"
        },
        {
          "s": 3,
          "text": "שהשופר גדול יעורר את נקודת היהדות שבכל אחד מישראל,"
        },
        {
          "s": 4,
          "text": "מובן,"
        },
        {
          "s": 5,
          "text": "דזה שכל ישראל"
        },
        {
          "s": 6,
          "text": "(גם וכולל האובדים והנדחים)"
        },
        {
          "s": 7,
          "text": "ירצו לצאת מהגלות וללכת לירושלים ולהשתחוות לה' הוא שע\"י הגילוי דשופר גדול יתעורר הרצון האמיתי55"
        },
        {
          "s": 8,
          "text": "דישראל."
        },
        {
          "s": 9,
          "text": "דזהו החילוק שבין הגאולה דיציאת מצרים וגאולה העתידה,"
        },
        {
          "s": 10,
          "text": "שביציאת מצרים,"
        },
        {
          "s": 11,
          "text": "חפצם של ישראל לצאת מטומאת מצרים ולדבקה בו ית'56"
        },
        {
          "s": 12,
          "text": "היתה מצד הגילוי דלמעלה57,"
        },
        {
          "s": 13,
          "text": "משכני58,"
        },
        {
          "s": 14,
          "text": "ובגאולה העתידה,"
        },
        {
          "s": 15,
          "text": "הרצון לצאת מהגלות ולבוא לירושלים יהי' הרצון דישראל,"
        },
        {
          "s": 16,
          "text": "והגילוי דלמעלה"
        },
        {
          "s": 17,
          "text": "(שופר גדול)"
        },
        {
          "s": 18,
          "text": "הוא רק סיבה שעל ידו יתגלה הרצון דישראל."
        },
        {
          "s": 19,
          "text": "והעבודה שלהם תהי' מצד עצמם – המעלה דראש השנה,"
        },
        {
          "s": 20,
          "text": "עבודת האדם59."
        },
        {
          "s": 21,
          "text": "אלא שבהאובדים והנדחים כפשוטם,"
        },
        {
          "s": 22,
          "text": "המעלה דעבודת האדם היא לאחרי הגילוי דשופר גדול שעל ידו מתעורר רצונו האמיתי דהאדם,"
        },
        {
          "s": 23,
          "text": "אבל המשכת הגילוי דשופר גדול הוא מצד מלמעלה."
        },
        {
          "s": 24,
          "text": "ועוד אופן ביתקע בשופר גדול,"
        },
        {
          "s": 25,
          "text": "שגם המשכת הגילוי דשופר גדול היא ע\"י עבודה,"
        },
        {
          "s": 26,
          "text": "כנ\"ל."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "וזהו והי' ביום ההוא יתקע בשופר גדול,"
        },
        {
          "s": 2,
          "text": "דההוראה מזה שביום ההוא יתקע בשופר גדול,"
        },
        {
          "s": 3,
          "text": "יתקע מעצמו,"
        },
        {
          "s": 4,
          "text": "היא,"
        },
        {
          "s": 5,
          "text": "שבסוף זמן הגלות שנשארו רק כמה רגעים שקודם ליום ההוא שיתקע בשופר גדול"
        },
        {
          "s": 6,
          "text": "[ויתירה מזה שבנוגע לכמה ענינים התחיל כבר הענין דיתקע בשופר גדול,"
        },
        {
          "s": 7,
          "text": "כמובן ממאמר הנ\"ל דכ\"ק מו\"ח אדמו\"ר60,"
        },
        {
          "s": 8,
          "text": "ובפרט שמעת כתיבת המאמר עד עכשיו כבר עברו כו\"כ שנים,"
        },
        {
          "s": 9,
          "text": "ועאכו\"כ בזמן האחרון שראו במוחש שכו\"כ שהיו תחלה במצב של אובדים ונדחים רח\"ל התעוררו בתשובה ע\"י התקיעה בשופר גדול61]"
        },
        {
          "s": 10,
          "text": "צריכה להיות העבודה בביטול,"
        },
        {
          "s": 11,
          "text": "ההכרה והרגשה שכל הענינים שנפעלו ע\"י עבודתו,"
        },
        {
          "s": 12,
          "text": "הן בנוגע לעצמו והן בנוגע לזולתו,"
        },
        {
          "s": 13,
          "text": "היא לא מצד המעלות שלו אלא מצד הנתינת כח מלמעלה."
        },
        {
          "s": 14,
          "text": "ולהעיר,"
        },
        {
          "s": 15,
          "text": "שהרגש זה אינו פועל חלישות בעבודתו,"
        },
        {
          "s": 16,
          "text": "ואדרבה,"
        },
        {
          "s": 17,
          "text": "ע\"י הרגש זה,"
        },
        {
          "s": 18,
          "text": "עבודתו היא ביתר שאת."
        },
        {
          "s": 19,
          "text": "דכשהעבודה שלו קשורה עם מציאותו,"
        },
        {
          "s": 20,
          "text": "העבודה היא במדידה והגבלה."
        },
        {
          "s": 21,
          "text": "וגם כשהעבודה שלו היא באופן דבכל מאודך,"
        },
        {
          "s": 22,
          "text": "הרי היא מאדך,"
        },
        {
          "s": 23,
          "text": "מאד שלך62,"
        },
        {
          "s": 24,
          "text": "וע\"י ההרגש שהענינים שנעשים ע\"י עבודתו הם לא מצד הכחות שיש לו אלא מצד האלקות,"
        },
        {
          "s": 25,
          "text": "עי\"ז הוא יוצא מהמציאות וההגבלות שלו,"
        },
        {
          "s": 26,
          "text": "והעבודה שלו היא למעלה ממדידה והגבלה63."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "והנה מבואר בהמאמר ד\"ה והי' ביום ההוא יתקע בשופר גדול64"
        },
        {
          "s": 2,
          "text": "בענין שופר דראש השנה,"
        },
        {
          "s": 3,
          "text": "דהגם שעיקר ההמשכה היא ע\"י הצעקה דפנימיות הלב מ\"מ צ\"ל התקיעה בשופר גשמי דוקא,"
        },
        {
          "s": 4,
          "text": "כי עשי' היא לעילא,"
        },
        {
          "s": 5,
          "text": "וגם בכדי שהגילוי דפנימיות רצון העליון"
        },
        {
          "s": 6,
          "text": "[בחינת שופר דלמעלה65]"
        },
        {
          "s": 7,
          "text": "יומשך למטה בגשמיות."
        },
        {
          "s": 8,
          "text": "ומזה מובן,"
        },
        {
          "s": 9,
          "text": "דכמו\"כ הוא בנוגע להתקיעה דשופר גדול ביום ההוא,"
        },
        {
          "s": 10,
          "text": "שאין מספיק הענינים שהיו עד עכשיו,"
        },
        {
          "s": 11,
          "text": "והתקיעה בשופר גדול צריכה להיות באופן שכל ישראל,"
        },
        {
          "s": 12,
          "text": "גם וכולל האובדים והנדחים,"
        },
        {
          "s": 13,
          "text": "יבואו וישתחוו לה' בהר הקודש בירושלים,"
        },
        {
          "s": 14,
          "text": "בירושלים כפשוטה,"
        },
        {
          "s": 15,
          "text": "ע\"י משיח צדקנו שיוליכנו קוממיות לארצנו,"
        },
        {
          "s": 16,
          "text": "בעגלא דידן בקרוב ממש."
        }
      ]
    }
  ]
}