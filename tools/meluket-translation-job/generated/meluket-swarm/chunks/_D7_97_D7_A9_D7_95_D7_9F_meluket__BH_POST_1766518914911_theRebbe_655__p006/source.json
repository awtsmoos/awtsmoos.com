  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914911_theRebbe_655__p006",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518914911_theRebbe_655",
  "title": "מאמר ויהיו חיי שרה תשמ\"א",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "וע\"י השמחה בעשיית המצוה,"
        },
        {
          "s": 3,
          "text": "כולל גם בקיום הציווי94"
        },
        {
          "s": 4,
          "text": "וכל95"
        },
        {
          "s": 5,
          "text": "מעשיך יהיו לשם שמים ובכל96"
        },
        {
          "s": 6,
          "text": "דרכיך דעהו,"
        },
        {
          "s": 7,
          "text": "יפרצו את גדרי הגלות,"
        },
        {
          "s": 8,
          "text": "ואתי מר דא מלכא משיחא,"
        },
        {
          "s": 9,
          "text": "דוד מלך ישראל,"
        },
        {
          "s": 10,
          "text": "יחד עם משה רבינו רעיא מהימנא,"
        },
        {
          "s": 11,
          "text": "שהרי גואל ראשון הוא גואל אחרון97,"
        },
        {
          "s": 12,
          "text": "כולל גם הרעיא מהימנא שבכל דור ודור עד להרעיא מהימנא של דורנו הוא כ\"ק מו\"ח אדמו\"ר נשיא דורנו,"
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "שבקרוב ממש תקויים ההבטחה הקיצו ורננו שוכני עפר98"
        },
        {
          "s": 1,
          "text": "ועמהם יחד נלך לקבל פני משיח צדקנו,"
        },
        {
          "s": 2,
          "text": "ושמחת עולם על ראשם99,"
        },
        {
          "s": 3,
          "text": "במהרה בימינו ממש."
        }
      ]
    }
  ]
}