{
  "globalIndex": 379,
  "owner": 29,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915911_theRebbe_364__p005",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915911_theRebbe_364__p005",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915911_theRebbe_364",
  "title": "מאמר ברוך שעשה נסים תשמ\"ג",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ויש להוסיף,"
        },
        {
          "s": 1,
          "text": "דענין זה בהעלם דשמן"
        },
        {
          "s": 2,
          "text": "(שאינו ראוי לשתי')"
        },
        {
          "s": 3,
          "text": "הוא נעלה יותר גם מההעלם דמים שאין בהם טעם"
        },
        {
          "s": 4,
          "text": "(שנת\"ל סעיף ג-ד)."
        },
        {
          "s": 5,
          "text": "דמים,"
        },
        {
          "s": 6,
          "text": "עם היות שאין בהם טעם,"
        },
        {
          "s": 7,
          "text": "הם ראויים לשתי'."
        },
        {
          "s": 8,
          "text": "ויתירה מזו,"
        },
        {
          "s": 9,
          "text": "שאפשר גם ליהנות מהם"
        },
        {
          "s": 10,
          "text": "(אלא שבכדי ליהנות מהם צ\"ל באדם הרגש דחסר"
        },
        {
          "s": 11,
          "text": "(צמא))."
        },
        {
          "s": 12,
          "text": "משא\"כ שמן"
        },
        {
          "s": 13,
          "text": "(כשהוא בפ\"ע)"
        },
        {
          "s": 14,
          "text": "הנה לא רק שא\"א ליהנות ממנו אלא שאינו ראוי לשתי' כלל,"
        },
        {
          "s": 15,
          "text": "להיותו בחינת העלם שלמעלה מגילוי."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דחילוק זה שבין יין מים ושמן"
        },
        {
          "s": 2,
          "text": "[דיין יש לו טעם,"
        },
        {
          "s": 3,
          "text": "מים אין להם טעם"
        },
        {
          "s": 4,
          "text": "(אבל ראויים לשתי')"
        },
        {
          "s": 5,
          "text": "ושמן אינו ראוי לשתי']"
        },
        {
          "s": 6,
          "text": "הוא בהתאם לענינם ברוחניות."
        },
        {
          "s": 7,
          "text": "דיין הוא בינה,"
        },
        {
          "s": 8,
          "text": "ולכן יש לו טעם"
        },
        {
          "s": 9,
          "text": "(הבנה והשגה),"
        },
        {
          "s": 10,
          "text": "מים הם חכמה"
        },
        {
          "s": 11,
          "text": "(שלמעלה מהבנה והשגה),"
        },
        {
          "s": 12,
          "text": "ולכן אין להם טעם,"
        },
        {
          "s": 13,
          "text": "אבל אעפ\"כ הם ראויים לשתי' ועד ששייך גם ליהנות מהם,"
        },
        {
          "s": 14,
          "text": "להיותם חכמה הגלוי',"
        },
        {
          "s": 15,
          "text": "ושמן הוא חכמה סתימאה שלמעלה מהגילוי דבינה וגם מהגילוי דחכמה,"
        },
        {
          "s": 16,
          "text": "אינו ראוי לשתי'."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "וזהו שחנוכת המזבח היתה ע\"י שמשחו אותו בשמן המשחה,"
        },
        {
          "s": 2,
          "text": "שע\"י שנמשך בו מבחי' חכמה סתימאה"
        },
        {
          "s": 3,
          "text": "(חכמה שבכתר),"
        },
        {
          "s": 4,
          "text": "עי\"ז נמשך גם הכח להלחם דקרבנות ולניסוך היין דבינה ולניסוך המים דחכמה48."
        },
        {
          "s": 5,
          "text": "ומוסיף בהמאמר48,"
        },
        {
          "s": 6,
          "text": "דבשמן המשחה היו בשמים49,"
        },
        {
          "s": 7,
          "text": "ענין הריח,"
        },
        {
          "s": 8,
          "text": "שהוא למעלה גם משמן."
        },
        {
          "s": 9,
          "text": "וי\"ל הביאור בזה,"
        },
        {
          "s": 10,
          "text": "דשמן,"
        },
        {
          "s": 11,
          "text": "עם היותו למעלה מהטעם וההנאה דהאדם ועד שאינו ראוי לשתי',"
        },
        {
          "s": 12,
          "text": "הוא נתפס במישוש."
        },
        {
          "s": 13,
          "text": "משא\"כ ריח אינו נתפס במישוש,"
        },
        {
          "s": 14,
          "text": "ויתירה מזו,"
        },
        {
          "s": 15,
          "text": "דריח הוא50"
        },
        {
          "s": 16,
          "text": "דבר שהנשמה נהנית ממנו ולא הגוף51."
        },
        {
          "s": 17,
          "text": "ומזה מובן גם בהדרגות דחכמת התורה שנמשלו לשמן ולריח,"
        },
        {
          "s": 18,
          "text": "דזה שהתורה נמשלה לשמן קאי כנ\"ל על רזין דרזין,"
        },
        {
          "s": 19,
          "text": "שגם הם"
        },
        {
          "s": 20,
          "text": "(רזין דרזין)"
        },
        {
          "s": 21,
          "text": "באים בגילוי שכלי,"
        },
        {
          "s": 22,
          "text": "ועד שהם מתלבשים באותיות."
        },
        {
          "s": 23,
          "text": "משא\"כ ענין הריח שבתורה הוא למעלה מהשגה לגמרי."
        },
        {
          "s": 24,
          "text": "אלא שאעפ\"כ,"
        },
        {
          "s": 25,
          "text": "כמו שהריח,"
        },
        {
          "s": 26,
          "text": "עם היותו דבר שהנשמה נהנית ממנו ולא הגוף,"
        },
        {
          "s": 27,
          "text": "הרי ידוע52"
        },
        {
          "s": 28,
          "text": "שע\"י ריח חזק משיבים את הנפש שתומשך בגילוי בהגוף,"
        },
        {
          "s": 29,
          "text": "עד\"ז י\"ל בענין הריח דתורה,"
        },
        {
          "s": 30,
          "text": "שהוא נמשך בפסק דין בפועל,"
        },
        {
          "s": 31,
          "text": "ועד שמשיח יהי' מורח ודאין53,"
        },
        {
          "s": 32,
          "text": "דבחינת הריח שבו יומשך בפס\"ד בפועל"
        },
        {
          "s": 33,
          "text": "(מורח ודאין),"
        },
        {
          "s": 34,
          "text": "אלא שהטעם דהפס\"ד הוא למעלה מהשכל לגמרי."
        },
        {
          "s": 35,
          "text": "וי\"ל שהוא ע\"ד שתק רב54"
        },
        {
          "s": 36,
          "text": "ומ\"מ לא הדר בי'55,"
        },
        {
          "s": 37,
          "text": "דהגם שזה הי' אצלו בחי' ראי' דחכמה שלא נתגלה בשכל כלל,"
        },
        {
          "s": 38,
          "text": "מ\"מ,"
        },
        {
          "s": 39,
          "text": "ע\"פ ראי' זו"
        },
        {
          "s": 40,
          "text": "(שלמעלה מהשכל)"
        },
        {
          "s": 41,
          "text": "פסק פס\"ד בפועל."
        }
      ]
    }
  ]
}