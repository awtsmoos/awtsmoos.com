{
  "globalIndex": 1035,
  "owner": 35,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919889_theRebbe_263__p004",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919889_theRebbe_263__p004",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919889_theRebbe_263",
  "title": "מאמר והי' עקב תשמעון תשכ\"ז",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ויש לומר שעד\"ז הוא גם כביכול בהירידה דצמצום הראשון"
        },
        {
          "s": 2,
          "text": "(תחילת הירידה שבכללות ההשתלשלות),"
        },
        {
          "s": 3,
          "text": "שכוונת הצמצום הוא בשביל הגילוי"
        },
        {
          "s": 4,
          "text": "[ומזה נשתלשל כן בכל הירידות שהם לצורך עלי'],"
        },
        {
          "s": 5,
          "text": "שיש בזה דוגמת שני ענינים הנ\"ל56."
        },
        {
          "s": 6,
          "text": "א',"
        },
        {
          "s": 7,
          "text": "שע\"י הצמצום נתחדש שהגילוי דאוא\"ס יהי' גם בעולמות."
        },
        {
          "s": 8,
          "text": "דקודם הצמצום,"
        },
        {
          "s": 9,
          "text": "כשהי' \"אוא\"ס ממלא מקום החלל,"
        },
        {
          "s": 10,
          "text": "לא הי' מקום"
        },
        {
          "s": 11,
          "text": "(אפשר)"
        },
        {
          "s": 12,
          "text": "להיות מציאות העולמות\"57,"
        },
        {
          "s": 13,
          "text": "ובמילא לא הי' הגילוי בעולמות,"
        },
        {
          "s": 14,
          "text": "וע\"י הצמצום נתחדש שהגילוי דאוא\"ס יהי' בעולמות."
        },
        {
          "s": 15,
          "text": "דהחידוש שבענין זה הוא רק לגבי העולמות,"
        },
        {
          "s": 16,
          "text": "ולא לגבי האור,"
        },
        {
          "s": 17,
          "text": "שהרי בהמדריגות שלפני הצמצום הי' אור זה גם מקודם בגילוי."
        },
        {
          "s": 18,
          "text": "וב',"
        },
        {
          "s": 19,
          "text": "שע\"י עבודת הבירורים יהי' גילוי אור חדש שלא האיר קודם הצמצום,"
        },
        {
          "s": 20,
          "text": "ועד שגילוי זה הוא למעלה לא רק מהתפשטות האור,"
        },
        {
          "s": 21,
          "text": "שבבחינת גילוי,"
        },
        {
          "s": 22,
          "text": "אלא גם מעצם האור,"
        },
        {
          "s": 23,
          "text": "ועד גילוי דהעלם העצמי."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "והנה ידוע דשני ענינים אלו,"
        },
        {
          "s": 2,
          "text": "הגילוי דאוא\"ס שהאיר גם קודם הצמצום,"
        },
        {
          "s": 3,
          "text": "והגילוי דהעלם העצמי,"
        },
        {
          "s": 4,
          "text": "יהיו לעתיד לבוא,"
        },
        {
          "s": 5,
          "text": "אלא שאז תהיינה שתי תקופות."
        },
        {
          "s": 6,
          "text": "וזהו ביאור המדרשות החלוקות בענין לע\"ל,"
        },
        {
          "s": 7,
          "text": "דאמרו58"
        },
        {
          "s": 8,
          "text": "עתיד הקב\"ה לעשות סעודה לצדיקים ואמרו59"
        },
        {
          "s": 9,
          "text": "העוה\"ב אין בו לא אכילה ולא שתי',"
        },
        {
          "s": 10,
          "text": "וידוע הביאור60,"
        },
        {
          "s": 11,
          "text": "דב' מאמרים אלו הם בנוגע לזמנים שונים."
        },
        {
          "s": 12,
          "text": "בתחילה יהי' הגילוי דתענוג המורגש"
        },
        {
          "s": 13,
          "text": "(סעודה),"
        },
        {
          "s": 14,
          "text": "והוא הגילוי דאוא\"ס שהאיר גם קודם,"
        },
        {
          "s": 15,
          "text": "ולאח\"ז יהי' הגילוי דתענוג הבלתי מורגש,"
        },
        {
          "s": 16,
          "text": "ועד גילוי העלם העצמי."
        },
        {
          "s": 17,
          "text": "ובכללות הוא החילוק61"
        },
        {
          "s": 18,
          "text": "בין ימות המשיח לתחיית המתים62."
        },
        {
          "s": 19,
          "text": "דארז\"ל63"
        },
        {
          "s": 20,
          "text": "דכל הנביאים כולן לא נתנבאו אלא לימות המשיח אבל לעולם הבא עין לא ראתה אלקים זולתך64,"
        },
        {
          "s": 21,
          "text": "וי\"ל שבימות המשיח יהי' הגילוי דאוא\"ס שהאיר בגילוי גם קודם הצמצום,"
        },
        {
          "s": 22,
          "text": "ובעולם הבא"
        },
        {
          "s": 23,
          "text": "(בתחיית המתים)"
        },
        {
          "s": 24,
          "text": "יהי' הגילוי דבחי' עדן שעליו נאמר עין לא ראתה,"
        },
        {
          "s": 25,
          "text": "העלם העצמי65."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז י\"ל שבפרטיות הגילוי דימות המשיח תלוי במעשינו והגילוי דתחה\"מ תלוי בעבודתינו,"
        },
        {
          "s": 2,
          "text": "כי כיון שהגורם שכר המצוה היא המצוה עצמה66,"
        },
        {
          "s": 3,
          "text": "הרי המצוה"
        },
        {
          "s": 4,
          "text": "(העבודה)"
        },
        {
          "s": 5,
          "text": "צריכה להיות מעין השכר"
        },
        {
          "s": 6,
          "text": "(ההמשכה שנעשית על ידה)."
        },
        {
          "s": 7,
          "text": "ולכן,"
        },
        {
          "s": 8,
          "text": "המשכת הגילוי דאוא\"ס שהאיר גם מקודם נעשית ע\"י היגיעה לגלות הטבע דהנשמה שהי' גם מקודם,"
        },
        {
          "s": 9,
          "text": "מעשינו."
        },
        {
          "s": 10,
          "text": "והמשכת הגילוי דהעלם העצמי,"
        },
        {
          "s": 11,
          "text": "אור חדש,"
        },
        {
          "s": 12,
          "text": "נעשית ע\"י היגיעה שלמעלה מהטבע גם דנפש האלקית"
        },
        {
          "s": 13,
          "text": "(שעי\"ז נעשה אצלו ענין חדש שלא הי' גם מצד נשמתו),"
        },
        {
          "s": 14,
          "text": "עבודתינו."
        }
      ]
    }
  ]
}