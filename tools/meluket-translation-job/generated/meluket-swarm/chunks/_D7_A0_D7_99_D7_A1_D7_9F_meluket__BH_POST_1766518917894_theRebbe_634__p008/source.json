  "globalIndex": 705,
  "owner": 5,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917894_theRebbe_634__p008",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917894_theRebbe_634__p008",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917894_theRebbe_634",
  "title": "מאמר כימי צאתך תשי\"ב",
  "part": 8,
  "sections": [
    {
      "v": 21,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ב)"
        },
        {
          "s": 2,
          "text": "וע\"פ כל הנ\"ל יש לבאר מ\"ש בזהר3"
        },
        {
          "s": 3,
          "text": "דאראנו"
        },
        {
          "s": 4,
          "text": "(נפלאות)"
        },
        {
          "s": 5,
          "text": "לשון נסתר קאי על משה,"
        },
        {
          "s": 6,
          "text": "כי הגאולה דיציאת מצרים היתה ע\"י משה."
        },
        {
          "s": 7,
          "text": "וע\"פ הנ\"ל שבהגאולה דיציאת מצרים נפתח הצנור גם על גאולה העתידה,"
        },
        {
          "s": 8,
          "text": "נמצא,"
        },
        {
          "s": 9,
          "text": "שמשה פתח את הצנור דהנפלאות שיהיו בגאולה העתידה."
        },
        {
          "s": 10,
          "text": "אלא שאעפ\"כ הי' זה אצלו בהעלם."
        },
        {
          "s": 11,
          "text": "וזהו מ\"ש כימי צאתך מארץ מצרים אראנו נפלאות,"
        },
        {
          "s": 12,
          "text": "שלע\"ל יתגלו לו הנפלאות שפתח ביציאת מצרים."
        }
      ]
    },
    {
      "v": 22,
      "items": [
        {
          "s": 0,
          "text": "גם יש לומר,"
        },
        {
          "s": 1,
          "text": "דזה שאראנו"
        },
        {
          "s": 2,
          "text": "(נפלאות)"
        },
        {
          "s": 3,
          "text": "לשון נסתר קאי על משה,"
        },
        {
          "s": 4,
          "text": "הוא הוראה לכאו\"א מישראל,"
        },
        {
          "s": 5,
          "text": "שבכדי לזכות לראיית הנפלאות דלע\"ל הוא ע\"י גילוי בחינת משה שבו60."
        },
        {
          "s": 6,
          "text": "דהגם שהביטול דמשה הוא ביטול דיחו\"ע שמצד הגילויים והמשכת הענין דאראנו נפלאות הוא ע\"י הביטול דקבלת עול"
        },
        {
          "s": 7,
          "text": "(כנ\"ל סעיף ט),"
        },
        {
          "s": 8,
          "text": "מ\"מ,"
        },
        {
          "s": 9,
          "text": "בכדי שההמשכה תהי' בגילוי"
        },
        {
          "s": 10,
          "text": "(אראנו)"
        },
        {
          "s": 11,
          "text": "צ\"ל גם הביטול שמצד הגילויים"
        },
        {
          "s": 12,
          "text": "(ע\"י ההתבוננות שכולא קמי' כלא חשיב,"
        },
        {
          "s": 13,
          "text": "וכדומה),"
        },
        {
          "s": 14,
          "text": "ועי\"ז יהי' אראנו נפלאות,"
        },
        {
          "s": 15,
          "text": "שהנפלאות דלעתיד יהיו בגילוי,"
        },
        {
          "s": 16,
          "text": "בביאת משיח צדקנו בקרוב ממש."
        }
      ]
    }
  ]
}