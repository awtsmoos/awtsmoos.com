{
  "globalIndex": 1040,
  "owner": 40,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919915_theRebbe_134__p004",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919915_theRebbe_134__p004",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919915_theRebbe_134",
  "title": "מאמר ועתה ישראל תשכ\"ז",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 1,
          "text": "דהטעם הפנימי על זה שנמשכו שני הגילויים דסובב וממלא,"
        },
        {
          "s": 2,
          "text": "גילוי העצם וגילוי שלהאיר העולמות,"
        },
        {
          "s": 3,
          "text": "הוא מפני שבתורה וישראל יש דוגמת שני ענינים אלה."
        },
        {
          "s": 4,
          "text": "דשני ענינים אלה בתורה הם תורה ומצוות,"
        },
        {
          "s": 5,
          "text": "ובישראל הם שכל ורצון"
        },
        {
          "s": 6,
          "text": "[דזה שבנפש האדם יש שכל ומדות הוא בעיקר בישראל,"
        },
        {
          "s": 7,
          "text": "אדם אתם אתם קרויין אדם47,"
        },
        {
          "s": 8,
          "text": "ומזה נשתלשל כן גם באוה\"ע]."
        },
        {
          "s": 9,
          "text": "ועפ\"ז יש לומר דזה שמביא בהמאמר משל על סובב וממלא מרצון ושכל שבאדם,"
        },
        {
          "s": 10,
          "text": "ובהמשך לזה ביאור החילוק בין מצוות לתורה,"
        },
        {
          "s": 11,
          "text": "הוא"
        },
        {
          "s": 12,
          "text": "(גם)"
        },
        {
          "s": 13,
          "text": "בכדי לרמז שהשרש דשני הגילויים"
        },
        {
          "s": 14,
          "text": "(גילוי העצם וגילוי שלהאיר העולמות)"
        },
        {
          "s": 15,
          "text": "הוא"
        },
        {
          "s": 16,
          "text": "(דוגמת)"
        },
        {
          "s": 17,
          "text": "שני ענינים אלה שבתורה וישראל."
        },
        {
          "s": 18,
          "text": "וזה מוסיף בהבנת העילוי דשני גילויים הנ\"ל,"
        },
        {
          "s": 19,
          "text": "שיש בהם לא רק ענין הגילוי אלא גם דוגמא להענינים דתורה וישראל ששרשם הוא בהעצמות."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יש לבאר זה שידוע48"
        },
        {
          "s": 2,
          "text": "שהאתערותא דלעילא הנמשכת מעצמה בכדי לעורר אתערותא דלתתא היא ממקום שאין אתערותא דלתתא מגעת לשם."
        },
        {
          "s": 3,
          "text": "דלכאורה צריך ביאור,"
        },
        {
          "s": 4,
          "text": "הרי זה שאין אתעדל\"ת מגעת לשם הוא כי לגבי דרגא זו התתא אינו תופס מקום"
        },
        {
          "s": 5,
          "text": "[ויש להוסיף,"
        },
        {
          "s": 6,
          "text": "דזה שאין תפיסת מקום להנבראים לגבי דרגא זו הוא כי השרש דסובב"
        },
        {
          "s": 7,
          "text": "(שממנו נמשכת אתעדל\"ע זו)"
        },
        {
          "s": 8,
          "text": "הוא האור שענינו הוא לא להאיר את העולמות אלא גילוי העצם],"
        },
        {
          "s": 9,
          "text": "ואיך נמשך משם אתעדל\"ע בכדי לעורר אתערותא דלתתא."
        },
        {
          "s": 10,
          "text": "וע\"פ הנ\"ל יש לומר,"
        },
        {
          "s": 11,
          "text": "דעי\"ז שהאור שהוא גילוי העצם הוא דוגמת ענין זה שבישראל,"
        },
        {
          "s": 12,
          "text": "עי\"ז נרגש שהכוונה בו היא בשביל ישראל."
        },
        {
          "s": 13,
          "text": "ולכן נמשכת ממנו אתעדל\"ע בכדי לעורר אתעדל\"ת."
        },
        {
          "s": 14,
          "text": "ויש להוסיף,"
        },
        {
          "s": 15,
          "text": "דע\"י המשכת האתעדל\"ע לעורר האתעדל\"ת מיתוסף עילוי בהאתעדל\"ע ובהמקום שממנו נמשכת האתעדל\"ע."
        },
        {
          "s": 16,
          "text": "כי49"
        },
        {
          "s": 17,
          "text": "עי\"ז מתגלה בו עוד יותר הכוונה שבו,"
        },
        {
          "s": 18,
          "text": "וגם זה שהוא דוגמת ענין שבישראל ששרשם הוא בהעצמות."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "וזהו ועתה ישראל מה גו' אל תקרי מה אלא מאה,"
        },
        {
          "s": 2,
          "text": "דזה שהכתיב הוא מה והקרי הוא מאה,"
        },
        {
          "s": 3,
          "text": "דכתיב וקרי הם העלם וגילוי50,"
        },
        {
          "s": 4,
          "text": "הוא,"
        },
        {
          "s": 5,
          "text": "כי מאה הוא הסובב,"
        },
        {
          "s": 6,
          "text": "ובשרשו האור דגילוי העצם – גילוי,"
        },
        {
          "s": 7,
          "text": "ומה הוא המ\"ה דהנשמה,"
        },
        {
          "s": 8,
          "text": "שהוא בהעלם."
        },
        {
          "s": 9,
          "text": "דע\"י שהנשמה נעשית נברא51,"
        },
        {
          "s": 10,
          "text": "המ\"ה שבה הוא בהעלם"
        },
        {
          "s": 11,
          "text": "(ובכדי שיבוא לגילוי הוא ע\"י המשכת בחי' מאה,"
        },
        {
          "s": 12,
          "text": "כנ\"ל סעיף ג' וד')."
        },
        {
          "s": 13,
          "text": "והנה העלם זה הוא למטה מגילוי."
        },
        {
          "s": 14,
          "text": "וע\"פ הידוע52"
        },
        {
          "s": 15,
          "text": "שכתיב הוא למעלה מקרי,"
        },
        {
          "s": 16,
          "text": "יש לומר,"
        },
        {
          "s": 17,
          "text": "דההעלם דהמ\"ה דנשמה שמרומז בזה שמה הוא הכתיב,"
        },
        {
          "s": 18,
          "text": "הוא זה שהנשמה מושרשת בהעלם העצמי דהעצמות."
        },
        {
          "s": 19,
          "text": "ויש להוסיף,"
        },
        {
          "s": 20,
          "text": "דזה שמאה הוא הקרי של הכתיב דמה,"
        },
        {
          "s": 21,
          "text": "הוא,"
        },
        {
          "s": 22,
          "text": "כי ע\"י ההמשכה דמאה לעורר המ\"ה,"
        },
        {
          "s": 23,
          "text": "נרגש בו"
        },
        {
          "s": 24,
          "text": "(כנ\"ל סוס\"ח)"
        },
        {
          "s": 25,
          "text": "שהוא דוגמת וגילוי המ\"ה דישראל."
        }
      ]
    }
  ]
}