{
  "globalIndex": 218,
  "owner": 18,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915066_theRebbe_447__p003",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915066_theRebbe_447__p003",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518915066_theRebbe_447",
  "title": "מאמר ואברהם זקן תשמ\"ו",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ויהי רצון,"
        },
        {
          "s": 1,
          "text": "שיקויים בנו"
        },
        {
          "s": 2,
          "text": "(בתוך כבנ\"י)"
        },
        {
          "s": 3,
          "text": "סיום הכתוב,"
        },
        {
          "s": 4,
          "text": "והוי' ברך את אברהם בכל,"
        },
        {
          "s": 5,
          "text": "דברכת בכל מורה על גילוי מעין עולם הבא,"
        },
        {
          "s": 6,
          "text": "כדאיתא בגמרא58"
        },
        {
          "s": 7,
          "text": "שלשה הטעימן הקב\"ה בעולם הזה מעין עולם הבא אלו הן אברהם יצחק ויעקב,"
        },
        {
          "s": 8,
          "text": "אברהם דכתיב בי' בכל יצחק דכתיב בי'59"
        },
        {
          "s": 9,
          "text": "מכל יעקב דכתיב בי'60"
        },
        {
          "s": 10,
          "text": "כל,"
        },
        {
          "s": 11,
          "text": "וג' ענינים אלו שייכים ג\"כ לכאו\"א מישראל,"
        },
        {
          "s": 12,
          "text": "שהרי אומרים בברכת המזון בכל יום"
        },
        {
          "s": 13,
          "text": "(ובפרט ביום השבת,"
        },
        {
          "s": 14,
          "text": "שאז מצוה לאכול סעודה דברהמ\"ז61"
        },
        {
          "s": 15,
          "text": "כו'),"
        },
        {
          "s": 16,
          "text": "הרחמן כו' כמו שברך את אבותינו אברהם יצחק ויעקב בכל מכל כל,"
        },
        {
          "s": 17,
          "text": "ובאופן דואכלת ושבעת וברכת את הוי' אלקיך62,"
        },
        {
          "s": 18,
          "text": "שזה נפעל ע\"י שכאו\"א מגלה את בחי' אברהם שבקרבו"
        },
        {
          "s": 19,
          "text": "(ע\"ד המבואר בתניא63"
        },
        {
          "s": 20,
          "text": "שיש בחי' משה שבכאו\"א מישראל),"
        },
        {
          "s": 21,
          "text": "ונעשה עולמך תראה בחייך64,"
        },
        {
          "s": 22,
          "text": "הטעימן מעין עולם הבא,"
        },
        {
          "s": 23,
          "text": "בברכה בפשטות,"
        },
        {
          "s": 24,
          "text": "שהקב\"ה מברך את כאו\"א בכל,"
        },
        {
          "s": 25,
          "text": "בגשמיות וברוחניות וברוחניות ובגשמיות,"
        },
        {
          "s": 26,
          "text": "בטוב הנראה והנגלה."
        }
      ]
    }
  ]
}