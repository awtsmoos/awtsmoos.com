{
  "globalIndex": 808,
  "owner": 8,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918601_theRebbe_37__p004",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918601_theRebbe_37__p004",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918601_theRebbe_37",
  "title": "מאמר גל עיני ואביטה תשל\"ז",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה כמו שבלימוד התורה"
        },
        {
          "s": 2,
          "text": "(אפילו בנגלה דתורה,"
        },
        {
          "s": 3,
          "text": "ומכש\"כ בפנימיות התורה)"
        },
        {
          "s": 4,
          "text": "יש ריבוי מדריגות עד אין קץ,"
        },
        {
          "s": 5,
          "text": "כמו\"כ הוא בקיום המצוות,"
        },
        {
          "s": 6,
          "text": "אפילו במעשה המצוות ומכש\"כ בכוונת המצוות,"
        },
        {
          "s": 7,
          "text": "שיש בזה ריבוי מדריגות."
        },
        {
          "s": 8,
          "text": "ועפ\"ז יובן מה שידוע36"
        },
        {
          "s": 9,
          "text": "שממעשה המצוות נעשים לבושים להנשמה בג\"ע התחתון ומכוונת המצוות נעשים לבושים בג\"ע העליון,"
        },
        {
          "s": 10,
          "text": "דלכאורה,"
        },
        {
          "s": 11,
          "text": "הרי גם בג\"ע התחתון עצמו,"
        },
        {
          "s": 12,
          "text": "וכן בג\"ע העליון עצמו,"
        },
        {
          "s": 13,
          "text": "יש ריבוי מדריגות37,"
        },
        {
          "s": 14,
          "text": "ואיך אפשר שבכל המדריגות יהיו אותם הלבושים."
        },
        {
          "s": 15,
          "text": "והביאור בזה,"
        },
        {
          "s": 16,
          "text": "דבמעשה המצוות וכן בכוונת המצוות יש ריבוי מדריגות כנ\"ל."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "והנה הגם שכוונת המצוה היא נשמת המצוה ששייכת בכלל לנשמתא דאורייתא,"
        },
        {
          "s": 1,
          "text": "מ\"מ,"
        },
        {
          "s": 2,
          "text": "כו\"כ ענינים דכוונת המצוות הם גם בנגלה דתורה."
        },
        {
          "s": 3,
          "text": "הן בנוגע הכוונה הכללית38"
        },
        {
          "s": 4,
          "text": "דמצוות"
        },
        {
          "s": 5,
          "text": "(שבכל המצוות בשוה)"
        },
        {
          "s": 6,
          "text": "לקיים רצון ה' – דכוונה זו היא גם ע\"פ נגלה דתורה"
        },
        {
          "s": 7,
          "text": "(אלא שע\"י לימוד פנימיות התורה,"
        },
        {
          "s": 8,
          "text": "הכוונה והרצון דהאדם לקיים רצון ה' הוא באופן נעלה יותר39),"
        },
        {
          "s": 9,
          "text": "וגם הכוונות הפרטיות38"
        },
        {
          "s": 10,
          "text": "שבכל מצוה בפרט,"
        },
        {
          "s": 11,
          "text": "הרי הטעם והכוונה דכו\"כ מצוות נתפרש גם בנגלה דתורה,"
        },
        {
          "s": 12,
          "text": "גם ע\"פ דרך הפשט"
        },
        {
          "s": 13,
          "text": "[ועד שהטעם דכו\"כ מצוות מפורש בקרא],"
        },
        {
          "s": 14,
          "text": "ומכש\"כ ע\"פ דרך הרמז והדרוש,"
        },
        {
          "s": 15,
          "text": "אלא שהטעם והכוונה דהמצוות שע\"פ דרך הסוד"
        },
        {
          "s": 16,
          "text": "(פנימיות התורה)"
        },
        {
          "s": 17,
          "text": "הוא נעלה הרבה יותר,"
        },
        {
          "s": 18,
          "text": "ועי\"ז מיתוסף עומק וכו' גם בהטעם שע\"פ נגלה."
        },
        {
          "s": 19,
          "text": "ויש לומר,"
        },
        {
          "s": 20,
          "text": "דכמו שבנוגע לראיית הנפלאות דתורה,"
        },
        {
          "s": 21,
          "text": "הבקשה גל עיני ואביטה נפלאות מתורתך היא שראיית הנפלאות דתורה"
        },
        {
          "s": 22,
          "text": "(נשמתא ונשמתא לנשמתא)"
        },
        {
          "s": 23,
          "text": "תהי' מתורתך,"
        },
        {
          "s": 24,
          "text": "מענינים אלה שבגליא דתורה,"
        },
        {
          "s": 25,
          "text": "מהגוף דתורה וגם מהלבוש דתורה"
        },
        {
          "s": 26,
          "text": "(כנ\"ל סעיף ד),"
        },
        {
          "s": 27,
          "text": "עד\"ז הוא בנוגע לכוונת המצוות,"
        },
        {
          "s": 28,
          "text": "שהנפלאות דכוונת המצוות"
        },
        {
          "s": 29,
          "text": "[כוונות האריז\"ל,"
        },
        {
          "s": 30,
          "text": "ולמעלה יותר]"
        },
        {
          "s": 31,
          "text": "צריכים לראותם מתוך הכוונות שע\"ד הפשט,"
        },
        {
          "s": 32,
          "text": "ויתרה מזה – מתוך הכוונות ע\"ד הפשט המובנים לבן חמש למקרא"
        },
        {
          "s": 33,
          "text": "[שהם דוגמת לבושא דאורייתא,"
        },
        {
          "s": 34,
          "text": "הסיפורים דתורה,"
        },
        {
          "s": 35,
          "text": "שגם תינוקות לומדים אותם]."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ולהוסיף,"
        },
        {
          "s": 2,
          "text": "דבכוונת המצוות,"
        },
        {
          "s": 3,
          "text": "נוגע ענין זה"
        },
        {
          "s": 4,
          "text": "[שענינים הכי נעלים ידעו מענינים אלה כמו שהם בפשטות]"
        },
        {
          "s": 5,
          "text": "עוד יותר מאשר בתורה."
        },
        {
          "s": 6,
          "text": "כי היתרון בזה שידיעת הנפלאות היא מהענינים שבפשטות הוא שעי\"ז תהי' ידיעת הנפלאות דהאדם גם מצד ענינו"
        },
        {
          "s": 7,
          "text": "(כנ\"ל סעיף ד),"
        },
        {
          "s": 8,
          "text": "וכיון שענין המצוות הוא לצרף בהן את הבריות"
        },
        {
          "s": 9,
          "text": "(כנ\"ל סעיף ה),"
        },
        {
          "s": 10,
          "text": "לפעול בירור וזיכוך בהאדם המקיים את המצוה,"
        },
        {
          "s": 11,
          "text": "[דעיקר הבירור והזיכוך הוא ע\"י כוונת המצוות40,"
        },
        {
          "s": 12,
          "text": "וכל שהכוונה היא נעלית יותר,"
        },
        {
          "s": 13,
          "text": "הבירור והזיכוך הוא נעלה יותר],"
        },
        {
          "s": 14,
          "text": "לכן,"
        },
        {
          "s": 15,
          "text": "בענין המצוות נוגע עוד יותר שידיעת הנפלאות דכוונת המצוות תהי' מתוך הכוונות שבפשטות."
        },
        {
          "s": 16,
          "text": "ועפ\"ז יש לבאר מה שמביא הצ\"צ במאמר שרש מצות התפלה41"
        },
        {
          "s": 17,
          "text": "הלשון אני מתפלל לדעת זה התינוק."
        },
        {
          "s": 18,
          "text": "דלכאורה,"
        },
        {
          "s": 19,
          "text": "במאמר שרש מצות התפלה מבאר ענין התפלה"
        },
        {
          "s": 20,
          "text": "[בכלל,"
        },
        {
          "s": 21,
          "text": "וגם כמה ענינים פרטיים דתפלה]"
        },
        {
          "s": 22,
          "text": "ע\"פ קבלה,"
        },
        {
          "s": 23,
          "text": "ועוד יותר – ע\"פ חסידות,"
        },
        {
          "s": 24,
          "text": "ומה מקום במאמר זה להביא הענין דאני מתפלל לדעת זה התינוק."
        },
        {
          "s": 25,
          "text": "ויש לומר,"
        },
        {
          "s": 26,
          "text": "שבזה מרמז,"
        },
        {
          "s": 27,
          "text": "שהכוונות דתפלה בדרגות הכי נעלות צריכות להיות קשורות עם ענין התפלה כמו שהיא לדעת התינוק,"
        },
        {
          "s": 28,
          "text": "הן בנוגע לכללות ענין התפלה – שידיעת ענין התפלה בדרגות הכי נעלות תהי' גם מענין התפלה כמו שתינוק מבין,"
        },
        {
          "s": 29,
          "text": "והן בנוגע לביאור הענינים"
        },
        {
          "s": 30,
          "text": "(הפסוקים,"
        },
        {
          "s": 31,
          "text": "בקשות וכו')"
        },
        {
          "s": 32,
          "text": "שאומרים בתפלה,"
        },
        {
          "s": 33,
          "text": "שהביאורים הכי נעלים צריכים להיות בהתאם"
        },
        {
          "s": 34,
          "text": "[ועד שידיעתם תהי' מתוך]"
        },
        {
          "s": 35,
          "text": "פירוש המילות דתפלה כמו שתינוק מבין."
        },
        {
          "s": 36,
          "text": "והגם שענין זה הוא בכל הענינים שבתורה,"
        },
        {
          "s": 37,
          "text": "מ\"מ,"
        },
        {
          "s": 38,
          "text": "כיון שענין התפלה היא העלאה מלמטה למעלה,"
        },
        {
          "s": 39,
          "text": "בירור וזיכוך האדם,"
        },
        {
          "s": 40,
          "text": "לכן בתפלה ענין זה נוגע יותר"
        },
        {
          "s": 41,
          "text": "(ע\"ד שנתבאר לעיל בנוגע למצוות)."
        },
        {
          "s": 42,
          "text": "ולכן,"
        },
        {
          "s": 43,
          "text": "במאמר שרש מצות התפלה מובא הענין דאני מתפלל לדעת זה התינוק."
        }
      ]
    }
  ]
}