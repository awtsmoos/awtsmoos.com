  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920437_theRebbe_883__p004",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920437_theRebbe_883",
  "title": "מאמר אתם נצבים תשל\"ט",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ומהכריתת ברית בכללות נמשכות ההחלטות טובות בנוגע ללימוד התורה וקיום המצוות ועבודת התפלה,"
        },
        {
          "s": 2,
          "text": "דעי\"ז ישראל וקוב\"ה כולא חד."
        },
        {
          "s": 3,
          "text": "ומזה באה כתיבה וחתימה טובה לשנה טובה ומתוקה,"
        },
        {
          "s": 4,
          "text": "והתחלתה לפנ\"ז בחודש ההכנה הוא חודש אלול שהוא ר\"ת אני לדודי ודודי לי42,"
        },
        {
          "s": 5,
          "text": "ובפרט מח\"י אלול שהוא יום הולדת שני המאורות הגדולים43"
        },
        {
          "s": 6,
          "text": "שאז מזלם גובר44,"
        },
        {
          "s": 7,
          "text": "והרי תכליתם וכוונתם היתה שיהי' יפוצו מעינותיך חוצה,"
        },
        {
          "s": 8,
          "text": "עד להחוצה שאין חוצה מחוץ הימנו."
        },
        {
          "s": 9,
          "text": "ועי\"ז אתי מר45"
        },
        {
          "s": 10,
          "text": "דא מלכא משיחא בקרוב ממש,"
        },
        {
          "s": 11,
          "text": "ובעגלא דידן."
        }
      ]
    }
  ]
}