  "postId": "BH_POST_1766518916627_theRebbe_635",
  "title": "רשימה באתי לגני תשי\"ג",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "[בס\"ד."
        },
        {
          "s": 1,
          "text": "יו\"ד שבט,"
        },
        {
          "s": 2,
          "text": "ה'תשי\"ג*]"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "למע'"
        },
        {
          "s": 1,
          "text": "(קדושה)"
        },
        {
          "s": 2,
          "text": "או למטה"
        },
        {
          "s": 3,
          "text": "(לעו\"ז)"
        },
        {
          "s": 4,
          "text": "נק' שטות1"
        },
        {
          "s": 5,
          "text": "וכשי\"ת2."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "איך אפשר3,"
        },
        {
          "s": 1,
          "text": "וכמאמר הזהר עה\"פ ונפש כי תחטא,"
        },
        {
          "s": 2,
          "text": "דהקב\"ה ואורייתא תווהן איך אפשר כי תחטא,"
        },
        {
          "s": 3,
          "text": "אף שקאי בנפש,"
        },
        {
          "s": 4,
          "text": "שהיא המדר' היותר תחתונה דה' שמות דנשמה,"
        },
        {
          "s": 5,
          "text": "וכמו שמדייק שם בזהר דנפש דוקא ובכ\"ז תווהא."
        },
        {
          "s": 6,
          "text": "וכידוע פתגם אדה\"ז אז אַ איד ניט ער וויל ניט ער קאן זיין אַ נפרד מאלקות,"
        },
        {
          "s": 7,
          "text": "ורק מפני שאינו מרגיש שבדבר העברה נעשה נפרד,"
        },
        {
          "s": 8,
          "text": "ונדמה שעודנו ביהדות,"
        },
        {
          "s": 9,
          "text": "כי באמת,"
        },
        {
          "s": 10,
          "text": "הרי שס\"ה מל\"ת וכל איסורי דרבנן,"
        },
        {
          "s": 11,
          "text": "מאחר4"
        },
        {
          "s": 12,
          "text": "(תניא פכ\"ד כה)"
        },
        {
          "s": 13,
          "text": "שאין מורדין,"
        },
        {
          "s": 14,
          "text": "אלקא דאלקייא,"
        },
        {
          "s": 15,
          "text": "שיש עוד מציאות5."
        }
      ]
    }
  ]
}