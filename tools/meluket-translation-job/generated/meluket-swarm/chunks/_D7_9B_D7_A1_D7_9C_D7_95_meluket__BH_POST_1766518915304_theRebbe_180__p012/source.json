{
  "globalIndex": 266,
  "owner": 16,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915304_theRebbe_180__p012",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915304_theRebbe_180__p012",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915304_theRebbe_180",
  "title": "מאמר ושבתי בשלום תשל\"ח",
  "part": 12,
  "sections": [
    {
      "v": 33,
      "items": [
        {
          "s": 0,
          "text": "כ)"
        },
        {
          "s": 1,
          "text": "ה)"
        },
        {
          "s": 2,
          "text": "ועפ\"ז יובן גם התיווך דב' הפירושים בפדה בשלום נפשי מקרב לי גו'156."
        },
        {
          "s": 3,
          "text": "פירוש הפשוט הוא שפדה והוציא אותו מקרב"
        },
        {
          "s": 4,
          "text": "(מלחמה)."
        },
        {
          "s": 5,
          "text": "היינו שיש מציאות דלעו\"ז שצריך ללחום כנגדו."
        },
        {
          "s": 6,
          "text": "דזוהי השייכות דענין פדה בשלום נפשי לדוד"
        },
        {
          "s": 7,
          "text": "(שבפשטות קאי זה על פדיית דוד189)"
        },
        {
          "s": 8,
          "text": "שהי' לו מנגדים,"
        },
        {
          "s": 9,
          "text": "אלא שנצח אותם."
        },
        {
          "s": 10,
          "text": "וכמו שידוע190"
        },
        {
          "s": 11,
          "text": "החילוק בין הבירורים דדוד להבירורים דשלמה,"
        },
        {
          "s": 12,
          "text": "שהבירורים דדוד היו בדרך מלחמה והבירורים דשלמה היו בדרך מנוחה וכמ\"ש191"
        },
        {
          "s": 13,
          "text": "דם לרוב שפכת ומלחמות גדולות עשית לא תבנה בית לשמי גו' הנה בן נולד לך הוא יהי' איש מנוחה גו' הוא יבנה בית לשמי גו'."
        },
        {
          "s": 14,
          "text": "והיינו דהגם שגם הנצחון דדוד"
        },
        {
          "s": 15,
          "text": "(מה שנצח את כל המנגדים)"
        },
        {
          "s": 16,
          "text": "הי' נצחון בתכלית"
        },
        {
          "s": 17,
          "text": "[שלכן הי' קס\"ד שיבנה את ביהמ\"ק],"
        },
        {
          "s": 18,
          "text": "מ\"מ,"
        },
        {
          "s": 19,
          "text": "מכיון שהבירורים שלו היו בדרך מלחמה,"
        },
        {
          "s": 20,
          "text": "הי' בנין ביהמ\"ק ע\"י שלמה דוקא."
        },
        {
          "s": 21,
          "text": "שמזה מובן,"
        },
        {
          "s": 22,
          "text": "שענין פדה בשלום שנאמר גבי דוד הוא שיש מציאות דלעו\"ז המנגד ורק שמנצחים אותם."
        },
        {
          "s": 23,
          "text": "וכ\"ה גם בענין פדה בשלום נפשי שהי' בהגאולה די\"ט כסלו192"
        },
        {
          "s": 24,
          "text": "והגאולה דיו\"ד כסלו193,"
        },
        {
          "s": 25,
          "text": "שהי' מציאות דלעו\"ז המנגד,"
        },
        {
          "s": 26,
          "text": "אלא שנצחו אותם."
        },
        {
          "s": 27,
          "text": "ועד שגם לאחרי הגאולה הוצרכו לרשיון מהמלכות דמדינה ההיא"
        },
        {
          "s": 28,
          "text": "[אבל כל המלכיות נקראו על שם מצרים על שם שהם מצירות לישראל194]"
        },
        {
          "s": 29,
          "text": "על הפצת תורת החסידות."
        },
        {
          "s": 30,
          "text": "ופירוש הב' הוא כמבואר בד\"ה פדה בשלום נפשי דבעל הגאולה195"
        },
        {
          "s": 31,
          "text": "וכמה דרושים ד\"ה זה"
        },
        {
          "s": 32,
          "text": "(די\"ט כסלו)196,"
        },
        {
          "s": 33,
          "text": "שהפדי' היא בדרך שלום,"
        },
        {
          "s": 34,
          "text": "ועד שאין צריך למלחמה כלל,"
        },
        {
          "s": 35,
          "text": "כמו שהי' בימי שלמה שכל הגוים נתבטלו לפניו שלא ע\"י מלחמה כלל."
        },
        {
          "s": 36,
          "text": "והתיווך דב' פירושים אלו שהם לכאורה מן הקצה אל הקצה,"
        },
        {
          "s": 37,
          "text": "וביותר ע\"פ המבואר בכ\"מ197"
        },
        {
          "s": 38,
          "text": "שענין פדה בשלום נפשי הוא הפדי' בתכלית השלום כמו שיהי' לע\"ל דאז אהפוך אל עמים שפה ברורה גו' לעבדו שכם אחד198,"
        },
        {
          "s": 39,
          "text": "שלמעלה גם מענין השלום שהי' בימי שלמה"
        },
        {
          "s": 40,
          "text": "[אלא שהשלום שבימי שלמה הי' הכנה להשלום דלעתיד,"
        },
        {
          "s": 41,
          "text": "שלכן משיח יהי'"
        },
        {
          "s": 42,
          "text": "(מבית דוד ו)"
        },
        {
          "s": 43,
          "text": "מזרע שלמה בלבד199],"
        },
        {
          "s": 44,
          "text": "שפירוש זה,"
        },
        {
          "s": 45,
          "text": "העילוי"
        },
        {
          "s": 46,
          "text": "[והשלימות]"
        },
        {
          "s": 47,
          "text": "דלעתיד,"
        },
        {
          "s": 48,
          "text": "הוא למעלה מענין הקצוות."
        },
        {
          "s": 49,
          "text": "אך הענין הוא,"
        },
        {
          "s": 50,
          "text": "דלהיות דכל הגילויים דלעתיד תלויים במעשינו ועבודתינו במשך זמן הגלות200,"
        },
        {
          "s": 51,
          "text": "לכן,"
        },
        {
          "s": 52,
          "text": "גם בהענין דפדה בשלום נפשי בזמן הגלות יש מעין ענין הפדי' בשלום שיהי' לע\"ל."
        }
      ]
    },
    {
      "v": 34,
      "items": [
        {
          "s": 0,
          "text": "כ)"
        },
        {
          "s": 1,
          "text": "ו)"
        },
        {
          "s": 2,
          "text": "וביאור שייכות ענין זה"
        },
        {
          "s": 3,
          "text": "(שגם עכשיו יש מעין הפדי' בשלום דלע\"ל)"
        },
        {
          "s": 4,
          "text": "להגאולה די\"ט כסלו ודיו\"ד כסלו"
        },
        {
          "s": 5,
          "text": "[שלכן בהדרושים שנאמרו בזמנים אלו מבואר הפירוש"
        },
        {
          "s": 6,
          "text": "(הב' דלעיל)"
        },
        {
          "s": 7,
          "text": "שפדה בשלום נפשי הו\"ע הפדי' בדרך שלום,"
        },
        {
          "s": 8,
          "text": "ועד כמו שיהי' לע\"ל],"
        },
        {
          "s": 9,
          "text": "הנה נת\"ל"
        },
        {
          "s": 10,
          "text": "(סעיף חי)"
        },
        {
          "s": 11,
          "text": "שהטעם לזה שמקדים בזהר ושבתי בשלום"
        },
        {
          "s": 12,
          "text": "(ענין התשובה)"
        },
        {
          "s": 13,
          "text": "לונתן לי לחם גו' הוא,"
        },
        {
          "s": 14,
          "text": "לפי שבזהר שם מדבר בענין סוף זמן הגלות,"
        },
        {
          "s": 15,
          "text": "שאז עיקר העבודה"
        },
        {
          "s": 16,
          "text": "(גם העבודה דתומ\"צ)"
        },
        {
          "s": 17,
          "text": "היא עבודת התשובה."
        },
        {
          "s": 18,
          "text": "שעי\"ז נעשה הפדי' בדרך שלום"
        },
        {
          "s": 19,
          "text": "(מעין השלום דלע\"ל),"
        },
        {
          "s": 20,
          "text": "מכיון שענין התשובה היא הפיכת הלעו\"ז לקדושה."
        },
        {
          "s": 21,
          "text": "וזוהי גם השייכות דפדה בשלום נפשי לגאולת אדמו\"ר הזקן"
        },
        {
          "s": 22,
          "text": "(י\"ט כסלו)"
        },
        {
          "s": 23,
          "text": "ואדמו\"ר האמצעי"
        },
        {
          "s": 24,
          "text": "(יו\"ד כסלו),"
        },
        {
          "s": 25,
          "text": "כי מהענינים שנתחדשו ע\"י אדמו\"ר הזקן"
        },
        {
          "s": 26,
          "text": "(גם לגבי הרב המגיד)"
        },
        {
          "s": 27,
          "text": "הוא שעשה"
        },
        {
          "s": 28,
          "text": "[הרבה]"
        },
        {
          "s": 29,
          "text": "בעלי תשובה201."
        },
        {
          "s": 30,
          "text": "וענין זה הי' גם עבודתם של רבותינו נשיאינו ממלאי מקומו,"
        },
        {
          "s": 31,
          "text": "ובפרט של בנו אדמו\"ר האמצעי,"
        },
        {
          "s": 32,
          "text": "שעל ידו נתגלה201"
        },
        {
          "s": 33,
          "text": "ענין זה."
        }
      ]
    },
    {
      "v": 35,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ך)"
        },
        {
          "s": 2,
          "text": "והי' הוי' לי לאלקים,"
        },
        {
          "s": 3,
          "text": "שע\"י העבודה דושבתי בשלום,"
        },
        {
          "s": 4,
          "text": "שהו\"ע בירור חלקו בעולם"
        },
        {
          "s": 5,
          "text": "(כנ\"ל סעיף ח),"
        },
        {
          "s": 6,
          "text": "יהי' הגילוי דלע\"ל,"
        },
        {
          "s": 7,
          "text": "שאז יוציא הקב\"ה חמה מנרתיקה202,"
        },
        {
          "s": 8,
          "text": "ויהי' מלאה הארץ דעה את הוי' כמים לים מכסים185,"
        },
        {
          "s": 9,
          "text": "ועד שיהי' גילוי העצמות,"
        },
        {
          "s": 10,
          "text": "ולא יכנף עוד מוריך והיו עיניך רואות את מוריך203."
        },
        {
          "s": 11,
          "text": "וזהו והי' הוי' לי לאלקים,"
        },
        {
          "s": 12,
          "text": "שלגבי גילוי זה הוי' דעכשיו כאלקים יחשב204."
        }
      ]
    }
  ]
}