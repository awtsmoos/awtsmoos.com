{
  "globalIndex": 584,
  "owner": 34,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917104_theRebbe_810__p002",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917104_theRebbe_810__p002",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518917104_theRebbe_810",
  "title": "מאמר באתי לגני תשל\"ו",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "וממשיך כ\"ק מו\"ח אדמו\"ר בהמאמר בפ\"ו24,"
        },
        {
          "s": 2,
          "text": "שבזה יובן גם מה שעצי שטים שבנו מהם את המשכן נקראים בשם קרשים וכמ\"ש25"
        },
        {
          "s": 3,
          "text": "ועשית את הקרשים למשכן עצי שטים עומדים."
        },
        {
          "s": 4,
          "text": "דהשם קרשים"
        },
        {
          "s": 5,
          "text": "[שזה שמו אשר יקראו לו בלה\"ק26]"
        },
        {
          "s": 6,
          "text": "מורה על תוכן ענינם."
        },
        {
          "s": 7,
          "text": "והוא מה שמקשר ושקר דעולם מתברר ונהפך לקרש המשכן,"
        },
        {
          "s": 8,
          "text": "קשר דקדושה"
        },
        {
          "s": 9,
          "text": "(וכמבואר לקמן במאמר ההילולא פ\"י)."
        },
        {
          "s": 10,
          "text": "והוא ע\"ד המבואר לעיל בענין עצי שטים,"
        },
        {
          "s": 11,
          "text": "שזהו מה שמתהפך משטות דלעו\"ז"
        },
        {
          "s": 12,
          "text": "(שקר דעולם)"
        },
        {
          "s": 13,
          "text": "לשטות דקדושה"
        },
        {
          "s": 14,
          "text": "(קרשי המשכן)."
        },
        {
          "s": 15,
          "text": "והנה ענין זה שבקרש"
        },
        {
          "s": 16,
          "text": "(שקודם שנהפך לקדושה מורה על שקר)"
        },
        {
          "s": 17,
          "text": "מרומז הוא לא רק בכללות התיבה אלא גם בהאותיות שבה,"
        },
        {
          "s": 18,
          "text": "ומבאר בהמאמר בפ\"ו24"
        },
        {
          "s": 19,
          "text": "בהקדם מ\"ש בהקדמת הזהר27"
        },
        {
          "s": 20,
          "text": "דאות ק' ור' הן אתוון דאתחזיאו על סטרא בישא,"
        },
        {
          "s": 21,
          "text": "ובגין לאתקיימא נטלי אות ש' בגווייהו"
        },
        {
          "s": 22,
          "text": "(דהא אות ש' את קשוט איהו)."
        },
        {
          "s": 23,
          "text": "והשייכות דאות ק' ור' לסטרא בישא מבאר בהמאמר שם,"
        },
        {
          "s": 24,
          "text": "שק' ור' הן לנגד ד' וה'."
        },
        {
          "s": 25,
          "text": "דד' ור' דומים זל\"ז בדמותן וכן בפירושן,"
        },
        {
          "s": 26,
          "text": "דד' הוא מלשון דלות ועניות וכן רי\"ש הוא מלשון עניות ורישות,"
        },
        {
          "s": 27,
          "text": "אלא שמ\"מ הם מובדלים ומרוחקים זמ\"ז בתכלית,"
        },
        {
          "s": 28,
          "text": "מן הקצה אל הקצה."
        },
        {
          "s": 29,
          "text": "דד' היא אות דקדושה ורי\"ש היא אות דלעו\"ז,"
        },
        {
          "s": 30,
          "text": "שלכן כאשר מחליף אותיות אלו זב\"ז ה\"ז מחריב עולמות ח\"ו."
        },
        {
          "s": 31,
          "text": "ומביא על זה ב' דוגמאות."
        },
        {
          "s": 32,
          "text": "דוגמא אחת מהד' דאחד,"
        },
        {
          "s": 33,
          "text": "הקו דועשה טוב,"
        },
        {
          "s": 34,
          "text": "שאם מחליפה ח\"ו באות ר' ה\"ז מחריב עולמות28,"
        },
        {
          "s": 35,
          "text": "ודוגמא שני' מהר' דלא תשתחווה לא-ל אחר29,"
        },
        {
          "s": 36,
          "text": "הקו דסור מרע,"
        },
        {
          "s": 37,
          "text": "שאם מחליף ח\"ו את הרי\"ש בד' ה\"ז מחריב עולמות28."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "והנה ההפרש שבין אות ד' לאות ר' בתמונתן"
        },
        {
          "s": 1,
          "text": "[שתמונת האותיות מורה על אופן המשכתן30]"
        },
        {
          "s": 2,
          "text": "מבאר בהמאמר שם,"
        },
        {
          "s": 3,
          "text": "שאות ד' יש לה יו\"ד מאחורי',"
        },
        {
          "s": 4,
          "text": "דאות יו\"ד"
        },
        {
          "s": 5,
          "text": "[להיותה אות הכי קטנה מכל האותיות,"
        },
        {
          "s": 6,
          "text": "ועד שהיא נקודה בלבד]"
        },
        {
          "s": 7,
          "text": "מורה על הביטול."
        },
        {
          "s": 8,
          "text": "וזהו נקודת הביאור בהחילוק שבין אות ד' לר'"
        },
        {
          "s": 9,
          "text": "(אף ששתיהן מורות על העניות),"
        },
        {
          "s": 10,
          "text": "שאות רי\"ש,"
        },
        {
          "s": 11,
          "text": "מכיון שאין בה יו\"ד המורה על ביטול,"
        },
        {
          "s": 12,
          "text": "הו\"ע הישות,"
        },
        {
          "s": 13,
          "text": "ולכן היא מאתוון דאתחזיאו על סטרא בישא"
        },
        {
          "s": 14,
          "text": "(וענין העניות דסט\"א הוא מה שאין להם שייכות לאלקות),"
        },
        {
          "s": 15,
          "text": "משא\"כ אות ד',"
        },
        {
          "s": 16,
          "text": "מכיון שיש בה יו\"ד המורה על ביטול,"
        },
        {
          "s": 17,
          "text": "ענין העניות שלה הו\"ע הביטול."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה ענין הביטול"
        },
        {
          "s": 2,
          "text": "(המבואר בהמאמר פ\"ו)"
        },
        {
          "s": 3,
          "text": "בא בהמשך להענין דבאתי לגני לגנוני"
        },
        {
          "s": 4,
          "text": "(התוכן דכללות המאמר)."
        },
        {
          "s": 5,
          "text": "והיינו,"
        },
        {
          "s": 6,
          "text": "שהמשכת השכינה למטה,"
        },
        {
          "s": 7,
          "text": "שיהי' דירה לו ית' בתחתונים,"
        },
        {
          "s": 8,
          "text": "הוא ע\"י העבודה דביטול דוקא."
        },
        {
          "s": 9,
          "text": "ומכיון שעשיית הדירה היא ע\"י התורה,"
        },
        {
          "s": 10,
          "text": "דזהו מה שכל הבריאה הוא בשביל התורה וכמרז\"ל31"
        },
        {
          "s": 11,
          "text": "בשביל התורה שנקראת ראשית,"
        },
        {
          "s": 12,
          "text": "הרי מובן,"
        },
        {
          "s": 13,
          "text": "שההקדמה למ\"ת הו\"ע הביטול."
        },
        {
          "s": 14,
          "text": "וכמו שמבאר כ\"ק אדמו\"ר הזקן32"
        },
        {
          "s": 15,
          "text": "עה\"פ33"
        },
        {
          "s": 16,
          "text": "בחודש השלישי גו' ביום הזה באו מדבר סיני,"
        },
        {
          "s": 17,
          "text": "ודרשו רז\"ל34"
        },
        {
          "s": 18,
          "text": "שקאי על ר\"ח,"
        },
        {
          "s": 19,
          "text": "שאינו מובן,"
        },
        {
          "s": 20,
          "text": "מהי השייכות של ביאתם למדבר סיני"
        },
        {
          "s": 21,
          "text": "(ההקדמה למ\"ת)"
        },
        {
          "s": 22,
          "text": "לר\"ח,"
        },
        {
          "s": 23,
          "text": "וגם למה נקרא ר\"ח בכתוב זה בלשון ביום הזה,"
        },
        {
          "s": 24,
          "text": "ומבאר כ\"ק אדמו\"ר הזקן ע\"פ מארז\"ל35"
        },
        {
          "s": 25,
          "text": "ישראל מונין ללבנה,"
        },
        {
          "s": 26,
          "text": "שהלבנה לית לה מגרמה כלום36,"
        },
        {
          "s": 27,
          "text": "ענין הביטול."
        },
        {
          "s": 28,
          "text": "וזוהי השייכות דר\"ח למ\"ת,"
        },
        {
          "s": 29,
          "text": "דכמו שהלבנה בשעת המולד"
        },
        {
          "s": 30,
          "text": "(ענין ר\"ח)"
        },
        {
          "s": 31,
          "text": "היא נקודה בלבד"
        },
        {
          "s": 32,
          "text": "(שנקודה הו\"ע הביטול),"
        },
        {
          "s": 33,
          "text": "ויתירה מזו,"
        },
        {
          "s": 34,
          "text": "אשר רגע לפני המולד היא בהעלם והסתר לגמרי שאינה בבחינת מציאות כלל"
        },
        {
          "s": 35,
          "text": "(גם לא מציאות דנקודה),"
        },
        {
          "s": 36,
          "text": "עד\"ז גם ההקדמה למ\"ת הו\"ע הביטול."
        },
        {
          "s": 37,
          "text": "וזהו ג\"כ מה שהתורה ניתנה ע\"י משה דוקא,"
        },
        {
          "s": 38,
          "text": "לפי שמשה הי' בתכלית הביטול וכמ\"ש37"
        },
        {
          "s": 39,
          "text": "והאיש משה עניו מאוד מכל האדם אשר על פני האדמה,"
        },
        {
          "s": 40,
          "text": "עניו הוא ענין עני38"
        },
        {
          "s": 41,
          "text": "והו\"ע הביטול דאות דל\"ת מלשון דלות ועניות,"
        },
        {
          "s": 42,
          "text": "ומצד הביטול שלו ניתנה התורה על ידו."
        },
        {
          "s": 43,
          "text": "וזהו ג\"כ מה שכל הנביאים נתנבאו בכה ומשה נתנבא בזה39,"
        },
        {
          "s": 44,
          "text": "זה הוא בחינת חכמה,"
        },
        {
          "s": 45,
          "text": "והמשכת החכמה היא ע\"י הביטול,"
        },
        {
          "s": 46,
          "text": "ולכן נתנבא משה בזה."
        },
        {
          "s": 47,
          "text": "וזהו ג\"כ מה שר\"ח נקרא בכתוב זה בלשון ביום הזה,"
        },
        {
          "s": 48,
          "text": "יום הוא אור וגילוי וזה הוא בחינת חכמה כנ\"ל,"
        },
        {
          "s": 49,
          "text": "ויום הזה הוא הגילוי דבחינת חכמה."
        },
        {
          "s": 50,
          "text": "וע\"י ענין ר\"ח שמורה על הביטול כנ\"ל,"
        },
        {
          "s": 51,
          "text": "נעשה ביום הזה,"
        },
        {
          "s": 52,
          "text": "הגילוי דבחינת חכמה."
        }
      ]
    }
  ]
}