  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518920021_theRebbe_64__p006",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518920021_theRebbe_64__p006",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518920021_theRebbe_64",
  "title": "מאמר ושננתם לבניך תשל\"ח",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "וכן תהי' לנו בקרוב ממש,"
        },
        {
          "s": 1,
          "text": "שע\"י עבודת התשובה בזמן הגלות"
        },
        {
          "s": 2,
          "text": "(כמרומז בפרשה שני' דק\"ש בלשון עתיד),"
        },
        {
          "s": 3,
          "text": "יקויים מ\"ש85"
        },
        {
          "s": 4,
          "text": "ושב הוי' אלקיך את שבותך ורחמך ושב וקבצך מכל העמים גו',"
        },
        {
          "s": 5,
          "text": "היינו,"
        },
        {
          "s": 6,
          "text": "ששכינתא שבגלותא86"
        },
        {
          "s": 7,
          "text": "תשוב מהגלות יחד עם בנ\"י87,"
        },
        {
          "s": 8,
          "text": "ובאופן שאתם תלוקטו לאחד אחד בני ישראל88,"
        },
        {
          "s": 9,
          "text": "שהקב\"ה מלקט את כל אחד ואחד מישראל89"
        },
        {
          "s": 10,
          "text": "– ע\"י ה\"אחד\" שבו,"
        },
        {
          "s": 11,
          "text": "ומוליכו לקבל פני משיח צדקנו,"
        },
        {
          "s": 12,
          "text": "בנערינו ובזקנינו בבנינו ובבנותנו90,"
        },
        {
          "s": 13,
          "text": "וכספם וזהבם אתם91,"
        },
        {
          "s": 14,
          "text": "עם כל הבירורים וכל הניצוצי קדושה,"
        },
        {
          "s": 15,
          "text": "ועד ונצלתם גו'92,"
        },
        {
          "s": 16,
          "text": "שיבררו את הכל,"
        },
        {
          "s": 17,
          "text": "ואת רוח הטומאה אעביר מן הארץ93,"
        },
        {
          "s": 18,
          "text": "ויראו בגלוי ש\"לא היו ימים טובים לישראל כחמשה עשר באב\","
        },
        {
          "s": 19,
          "text": "למטה מעשרה טפחים,"
        },
        {
          "s": 20,
          "text": "בירושלים עיר הקודש ובארץ הקודש בכללה,"
        },
        {
          "s": 21,
          "text": "בקרוב ממש,"
        },
        {
          "s": 22,
          "text": "בביאת משיח צדקנו."
        }
      ]
    }
  ]
}