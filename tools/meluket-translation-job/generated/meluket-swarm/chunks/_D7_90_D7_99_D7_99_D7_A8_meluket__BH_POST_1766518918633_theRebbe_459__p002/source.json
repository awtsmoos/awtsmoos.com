{
  "globalIndex": 812,
  "owner": 12,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918633_theRebbe_459__p002",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918633_theRebbe_459__p002",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918633_theRebbe_459",
  "title": "מאמר בחודש השלישי תשכ\"ט",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "וזהו בחודש השלישי גו' ביום הזה באו מדבר סיני,"
        },
        {
          "s": 1,
          "text": "שבר\"ח סיון היתה ההכנה לקבלת התורה,"
        },
        {
          "s": 2,
          "text": "כי בר\"ח הוא מולד הלבנה,"
        },
        {
          "s": 3,
          "text": "שאז"
        },
        {
          "s": 4,
          "text": "(בעת המולד)"
        },
        {
          "s": 5,
          "text": "היא נקודה בלבד,"
        },
        {
          "s": 6,
          "text": "וזה מורה על הביטול שלה,"
        },
        {
          "s": 7,
          "text": "דלית לה מגרמה כלום19."
        },
        {
          "s": 8,
          "text": "וכן הוא בישראל שדומין ומונין ללבנה20,"
        },
        {
          "s": 9,
          "text": "שבר\"ח הוא זמן המוכשר לגלות כח הביטול שישנו בכ\"א מישראל."
        },
        {
          "s": 10,
          "text": "ולכן בר\"ח סיון הוא ההכנה לקבלת התורה,"
        },
        {
          "s": 11,
          "text": "שלימוד התורה דהאדם יהי' בביטול,"
        },
        {
          "s": 12,
          "text": "כעונה אחר הקורא."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר עוד ביאור בזה שבר\"ח סיון הוא ההכנה לקבלת התורה,"
        },
        {
          "s": 2,
          "text": "דבצאת ישראל ממצרים התחילו לספור ספירת העומר21,"
        },
        {
          "s": 3,
          "text": "שהיא הכנה לקבלת התורה,"
        },
        {
          "s": 4,
          "text": "וז' השבועות דספירת העומר"
        },
        {
          "s": 5,
          "text": "(שבעה שבועות תספר לך22)"
        },
        {
          "s": 6,
          "text": "הם כנגד ז' המדות,"
        },
        {
          "s": 7,
          "text": "ובר\"ח סיון שהוא יום הג' דשבוע הז' ישנם כבר ג' המדות חג\"ת"
        },
        {
          "s": 8,
          "text": "(שהם עיקרי המדות)"
        },
        {
          "s": 9,
          "text": "דספירת המלכות,"
        },
        {
          "s": 10,
          "text": "וכאילו שישנו כבר כל שבוע הז',"
        },
        {
          "s": 11,
          "text": "ולכן בר\"ח סיון באו מדבר סיני כי אז נשלם עיקר ההכנה למ\"ת."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דזה שמבאר בהמאמר שני ביאורים בזה שבר\"ח סיון הוא ההכנה לקבלת התורה,"
        },
        {
          "s": 2,
          "text": "הוא,"
        },
        {
          "s": 3,
          "text": "כי בההכנה לקבלת התורה שני ענינים."
        },
        {
          "s": 4,
          "text": "השלימות דהאדם,"
        },
        {
          "s": 5,
          "text": "שבכדי שיהי' ראוי לקבל התורה צריך להיות בתכלית השלימות23."
        },
        {
          "s": 6,
          "text": "והביטול שלו."
        },
        {
          "s": 7,
          "text": "דכיון שהתורה היא למעלה באין ערוך מהאדם"
        },
        {
          "s": 8,
          "text": "(במכ\"ש מזה שהיא למעלה מעולמות העליונים),"
        },
        {
          "s": 9,
          "text": "לכן,"
        },
        {
          "s": 10,
          "text": "כאשר האדם הוא מציאות,"
        },
        {
          "s": 11,
          "text": "המציאות שלו היא"
        },
        {
          "s": 12,
          "text": "(כמו)"
        },
        {
          "s": 13,
          "text": "היפך התורה24,"
        },
        {
          "s": 14,
          "text": "ובכדי שהאדם יקבל את התורה הוא ע\"י הביטול שלו."
        },
        {
          "s": 15,
          "text": "ולכן מבאר בהמאמר,"
        },
        {
          "s": 16,
          "text": "דזה שבר\"ח סיון באו מדבר סיני והיו מוכנים לקבל התורה,"
        },
        {
          "s": 17,
          "text": "הוא,"
        },
        {
          "s": 18,
          "text": "כי בר\"ח סיון ישנם שני הענינים."
        },
        {
          "s": 19,
          "text": "זה שבר\"ח הוא מולד הלבנה,"
        },
        {
          "s": 20,
          "text": "שאז היא נקודה בלבד,"
        },
        {
          "s": 21,
          "text": "ביטול."
        },
        {
          "s": 22,
          "text": "וזה שבר\"ח סיון נשלמו עיקרי המדות"
        },
        {
          "s": 23,
          "text": "(גם)"
        },
        {
          "s": 24,
          "text": "בספירת המלכות – שלימות האדם."
        },
        {
          "s": 25,
          "text": "ושני ענינים בהשלימות דהאדם שנעשית ע\"י ספירת העומר."
        },
        {
          "s": 26,
          "text": "שספירת העומר הו\"ע בירור וזיכוך המדות,"
        },
        {
          "s": 27,
          "text": "ושע\"י ספירת העומר הוא המשכת מ\"ט שערי בינה25."
        }
      ]
    }
  ]
}