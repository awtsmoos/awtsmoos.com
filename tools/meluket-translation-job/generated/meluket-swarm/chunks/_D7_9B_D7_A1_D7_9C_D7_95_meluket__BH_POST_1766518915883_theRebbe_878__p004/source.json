{
  "globalIndex": 374,
  "owner": 24,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915883_theRebbe_878__p004",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915883_theRebbe_878__p004",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915883_theRebbe_878",
  "title": "מאמר מצותה משתשקע החמה תשל\"ח",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "וע\"פ כל הנ\"ל תובן גם השייכות דשמונת ימי חנוכה לשמונת ימי החג"
        },
        {
          "s": 2,
          "text": "[כמשנת\"ל בארוכה במאמר הקודם"
        },
        {
          "s": 3,
          "text": "(ד\"ה ת\"ר מצות נ\"ח86),"
        },
        {
          "s": 4,
          "text": "מיוסד על מאמרי רבותינו נשיאינו,"
        },
        {
          "s": 5,
          "text": "ששמונת ימי חנוכה הם דוגמת שמונת ימי החג]"
        },
        {
          "s": 6,
          "text": "כי כמו שבחג הסוכות פועלים שיהי' הללו87"
        },
        {
          "s": 7,
          "text": "את הוי' כל גוים שבחוהו כל האומים כי גבר עלינו חסדו"
        },
        {
          "s": 8,
          "text": "[דזה שגבר עלינו חסדו"
        },
        {
          "s": 9,
          "text": "(גילוי תגבורת החסד)"
        },
        {
          "s": 10,
          "text": "פועל גם בהגוים והאומים שיהללו וישבחו את הוי'],"
        },
        {
          "s": 11,
          "text": "עד\"ז הוא גם בחנוכה,"
        },
        {
          "s": 12,
          "text": "שפועלים גם בהגוים והאומים,"
        },
        {
          "s": 13,
          "text": "וכנ\"ל"
        },
        {
          "s": 14,
          "text": "(סוס\"א וסוס\"ז)"
        },
        {
          "s": 15,
          "text": "בענין כליא ריגלא דתרמודאי שהאור דנ\"ח פועל גם בהמורדים שיהיו בבחינת כליון וכלות הנפש."
        },
        {
          "s": 16,
          "text": "והגם שבסוכות ההמשכה דגבר עלינו חסדו"
        },
        {
          "s": 17,
          "text": "(מקיפים עליונים88)"
        },
        {
          "s": 18,
          "text": "היא בגילוי גמור,"
        },
        {
          "s": 19,
          "text": "משא\"כ בחנוכה,"
        },
        {
          "s": 20,
          "text": "שלכן הוצרכו אז למלחמה88,"
        },
        {
          "s": 21,
          "text": "הרי ידועה הכרעת כ\"ק אדמו\"ר הזקן89"
        },
        {
          "s": 22,
          "text": "שגמר נצחון המלחמה הי' בכ\"ד כסלו,"
        },
        {
          "s": 23,
          "text": "משא\"כ בכ\"ה בכסלו הי' כבר יום מנוחה"
        },
        {
          "s": 24,
          "text": "[דזהו פירוש חנוכה,"
        },
        {
          "s": 25,
          "text": "חנו כ\"ה90,"
        },
        {
          "s": 26,
          "text": "שביום זה הי' מנוחה],"
        },
        {
          "s": 27,
          "text": "ואז פינו את היכלך וכו' והדליקו נרות בחצרות קדשך91,"
        },
        {
          "s": 28,
          "text": "ועד שנעשה להודות ולהלל לשמך הגדול91,"
        },
        {
          "s": 29,
          "text": "שהוא בחינה נעלית ביותר,"
        },
        {
          "s": 30,
          "text": "כמבואר בדרושי יציאת מצרים92"
        },
        {
          "s": 31,
          "text": "ענין שמו הגדול."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "והנה כמו שבסוכות זמן שמחתנו לשון רבים,"
        },
        {
          "s": 1,
          "text": "על שם ב' השמחות דישמח93"
        },
        {
          "s": 2,
          "text": "הוי' במעשיו וישמח94"
        },
        {
          "s": 3,
          "text": "ישראל בעושיו95,"
        },
        {
          "s": 4,
          "text": "עם היות שבשניהם נאמר ישמח לשון עתיד לפי שעיקר ענינם יהי' לעת\"ל96,"
        },
        {
          "s": 5,
          "text": "ואעפ\"כ מזה שחג הסוכות נקרא"
        },
        {
          "s": 6,
          "text": "(עכשיו)"
        },
        {
          "s": 7,
          "text": "זמן שמחתנו מובן שב' שמחות אלו ישנם גם עכשיו בחג הסוכות בגילוי,"
        },
        {
          "s": 8,
          "text": "עד\"ז הוא גם בענין כליא ריגלא דתרמודאי,"
        },
        {
          "s": 9,
          "text": "הפעולה באוה\"ע שבימי חנוכה,"
        },
        {
          "s": 10,
          "text": "שעם היות ששלימות ענין זה יהי' לע\"ל,"
        },
        {
          "s": 11,
          "text": "כמ\"ש97"
        },
        {
          "s": 12,
          "text": "אז אהפוך אל עמים שפה ברורה גו' לעבדו שכם אחד,"
        },
        {
          "s": 13,
          "text": "מ\"מ נעשה זה גם עכשיו בחנוכה98."
        },
        {
          "s": 14,
          "text": "וכמו שהי' בימים ההם שנתבטלה שליטת מלכות יון הרשעה,"
        },
        {
          "s": 15,
          "text": "אע\"פ שגם לאח\"ז לא היתה עדיין גאולה שלימה"
        },
        {
          "s": 16,
          "text": "[וכמובן גם מזה שבבית שני חסרו,"
        },
        {
          "s": 17,
          "text": "עוד לפני זה וגם לאחר זה,"
        },
        {
          "s": 18,
          "text": "ה' דברים99],"
        },
        {
          "s": 19,
          "text": "עד\"ז הוא גם בימים ההם בזמן הזה,"
        },
        {
          "s": 20,
          "text": "דהגם שנמצאים עדיין בזמן הגלות"
        },
        {
          "s": 21,
          "text": "(גם לפני אתחלתא דגאולה100),"
        },
        {
          "s": 22,
          "text": "מ\"מ ע\"י מעשיו ועבודתו של כל אחד ואחת"
        },
        {
          "s": 23,
          "text": "(שאף הן היו באותו הנס101)"
        },
        {
          "s": 24,
          "text": "במשך זמן הגלות,"
        },
        {
          "s": 25,
          "text": "ובפרט בהענין שהזמן גרמא – העבודה דימי חנוכה,"
        },
        {
          "s": 26,
          "text": "שעיקרה הוא הדלקת נרות חנוכה על פתח ביתו מבחוץ102,"
        },
        {
          "s": 27,
          "text": "נעשה כליא ריגלא דתרמודאי"
        },
        {
          "s": 28,
          "text": "(בשני הפירושים דלעיל)"
        },
        {
          "s": 29,
          "text": "עוד לפני הגאולה."
        },
        {
          "s": 30,
          "text": "וע\"ד שהי' בהגאולה דיציאת מצרים"
        },
        {
          "s": 31,
          "text": "(שכל הגליות נק' על שם מצרים103),"
        },
        {
          "s": 32,
          "text": "שלכל בני ישראל הי' אור במושבותם עוד בהיותם במצרים104,"
        },
        {
          "s": 33,
          "text": "ועי\"ז וינצלו את מצרים105,"
        },
        {
          "s": 34,
          "text": "כמצודה שאין בה דגן"
        },
        {
          "s": 35,
          "text": "(בירור הניצוצות דעלמא דאתגליא)"
        },
        {
          "s": 36,
          "text": "וכמצולה שאין בה דגים106"
        },
        {
          "s": 37,
          "text": "(בירור הניצוצות דעלמא דאתכסיא),"
        },
        {
          "s": 38,
          "text": "עד\"ז הוא גם עכשיו,"
        },
        {
          "s": 39,
          "text": "שעוד ברגעים האחרונים שלפני הגאולה יהי' לכל בני ישראל אור במושבותם,"
        },
        {
          "s": 40,
          "text": "ומזה באים אח\"כ,"
        },
        {
          "s": 41,
          "text": "ויתירה מזה תיכף ומיד,"
        },
        {
          "s": 42,
          "text": "לגאולה השלימה,"
        },
        {
          "s": 43,
          "text": "שאז יהי'"
        },
        {
          "s": 44,
          "text": "(כנ\"ל)"
        },
        {
          "s": 45,
          "text": "כליא ריגלא דתרמודאי בשלימות."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "וע\"י מעשינו ועבודתינו מקרבים וממהרים את הגאולה עוד יותר,"
        },
        {
          "s": 3,
          "text": "וכפס\"ד הרמב\"ם85"
        },
        {
          "s": 4,
          "text": "שאפילו ע\"י מצוה אחת גורם לכל העולם תשועה והצלה,"
        },
        {
          "s": 5,
          "text": "ועאכו\"כ ע\"י לימוד והפצת פנימיות התורה שנתגלתה בדורות האחרונים דוקא"
        },
        {
          "s": 6,
          "text": "(כידוע בענין טועמי' חיים זכו107),"
        },
        {
          "s": 7,
          "text": "וגדול תלמוד שמביא לידי מעשה108,"
        },
        {
          "s": 8,
          "text": "שזה"
        },
        {
          "s": 9,
          "text": "(לימוד פנימיות התורה)"
        },
        {
          "s": 10,
          "text": "מוסיף גם חיות והידור בקיום המצוות,"
        },
        {
          "s": 11,
          "text": "ועד להידור באופן דמהדרין מן המהדרין"
        },
        {
          "s": 12,
          "text": "(כמנהג הפשוט במצות נ\"ח109),"
        },
        {
          "s": 13,
          "text": "ועי\"ז מקרבים וממהרים עוד יותר את הגאולה,"
        },
        {
          "s": 14,
          "text": "שבקרוב ממש הולכים לקבל פני משיח צדקנו,"
        },
        {
          "s": 15,
          "text": "שילמד תורה את כל העם כולו110"
        },
        {
          "s": 16,
          "text": "(תכלית השלימות בלימוד התורה),"
        },
        {
          "s": 17,
          "text": "ושם נעשה לפניך כמצות רצונך111"
        },
        {
          "s": 18,
          "text": "(תכלית השלימות בקיום המצוות112),"
        },
        {
          "s": 19,
          "text": "וזוכים קהל גדול דישובו הנה113,"
        },
        {
          "s": 20,
          "text": "כולם להודות ולהלל לשמך הגדול,"
        },
        {
          "s": 21,
          "text": "בבית המקדש השלישי,"
        },
        {
          "s": 22,
          "text": "בית הנצחי114,"
        },
        {
          "s": 23,
          "text": "מקדש אד' כוננו ידיך115,"
        },
        {
          "s": 24,
          "text": "ובמהרה בימינו ממש."
        }
      ]
    }
  ]
}