{
  "globalIndex": 1002,
  "owner": 2,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919735_theRebbe_388__p002",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919735_theRebbe_388__p002",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919735_theRebbe_388",
  "title": "מאמר ציון במשפט תפדה תשמ\"א",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה יש עוד פירוש בושבי',"
        },
        {
          "s": 2,
          "text": "דשבי' הוא מלשון השבה,"
        },
        {
          "s": 3,
          "text": "ההשבה מן הגולה20."
        },
        {
          "s": 4,
          "text": "דלשון השבה"
        },
        {
          "s": 5,
          "text": "[ובפרט כאשר הוא בסמיכות לתיבת תפדה שלפנ\"ז]"
        },
        {
          "s": 6,
          "text": "מורה שגם לפני ההשבה אינו בגלות,"
        },
        {
          "s": 7,
          "text": "ורק שהוא נמצא במקום אחר"
        },
        {
          "s": 8,
          "text": "(מקום הגולה)"
        },
        {
          "s": 9,
          "text": "וצריך לחזור ולשוב למקומו."
        },
        {
          "s": 10,
          "text": "ועפ\"ז שבי' הם נעלים יותר מאלו שנאמר עליהם תפדה."
        },
        {
          "s": 11,
          "text": "כי לשון פדי' נופל על מי שהוא בגלות21"
        },
        {
          "s": 12,
          "text": "(משא\"כ בזה שהוא רק נמצא במקום הגולה)"
        },
        {
          "s": 13,
          "text": "וצריך לפדי' מהגלות."
        },
        {
          "s": 14,
          "text": "וצריך להבין,"
        },
        {
          "s": 15,
          "text": "היאך שייך שפדייתם של אלו שהם בגלות היא במשפט"
        },
        {
          "s": 16,
          "text": "(ע\"פ שורת הדין),"
        },
        {
          "s": 17,
          "text": "וההשבה של אלו שנמצאים רק במקום הגולה"
        },
        {
          "s": 18,
          "text": "(שהם נעלים יותר)"
        },
        {
          "s": 19,
          "text": "היא בצדקה."
        },
        {
          "s": 20,
          "text": "וגם צריך להבין,"
        },
        {
          "s": 21,
          "text": "מי הם שני הסוגים שעליהם נאמר תפדה ושבי'."
        },
        {
          "s": 22,
          "text": "הרי תפדה נאמר בנוגע לציון שקאי"
        },
        {
          "s": 23,
          "text": "(כנ\"ל)"
        },
        {
          "s": 24,
          "text": "על ישראל העוסקים בתומ\"צ,"
        },
        {
          "s": 25,
          "text": "ואעפ\"כ הם בגלות וצריכים לפדי',"
        },
        {
          "s": 26,
          "text": "ומהי זכותם של אלו שנק' בשם שבי' שאינם בגלות."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ויובן בהקדים המבואר בהמאמר7,"
        },
        {
          "s": 2,
          "text": "דענין גלות ושבי' שייך דוקא בהכלים,"
        },
        {
          "s": 3,
          "text": "להיותם בבחי' מציאות דבר,"
        },
        {
          "s": 4,
          "text": "משא\"כ בהאור,"
        },
        {
          "s": 5,
          "text": "שהוא בבחי' אין,"
        },
        {
          "s": 6,
          "text": "אין שייך גלות."
        },
        {
          "s": 7,
          "text": "וענין זה"
        },
        {
          "s": 8,
          "text": "(דבאור אין שייך גלות)"
        },
        {
          "s": 9,
          "text": "מובן גם בפשטות."
        },
        {
          "s": 10,
          "text": "שהרי מעט אור דוחה הרבה מן החושך22,"
        },
        {
          "s": 11,
          "text": "והיינו דגם לאחרי ירידת והמשכת האור בבחי' מדידה והגבלה"
        },
        {
          "s": 12,
          "text": "[שאז דוקא שייך לומר מעט או הרבה],"
        },
        {
          "s": 13,
          "text": "גם אז הוא דוחה את החושך,"
        },
        {
          "s": 14,
          "text": "ועד שאפילו מעט אור דוחה הרבה חושך."
        },
        {
          "s": 15,
          "text": "ויתירה מזו,"
        },
        {
          "s": 16,
          "text": "שהחושך נדחה ממילא מפני האור23."
        },
        {
          "s": 17,
          "text": "[דבתחלת הבריאה היו אור וחושך משתמשים בערבוביא24,"
        },
        {
          "s": 18,
          "text": "אבל לאחרי שויבדל אלקים בין האור ובין החושך25,"
        },
        {
          "s": 19,
          "text": "החושך נדחה מפני האור]."
        },
        {
          "s": 20,
          "text": "ומזה מובן גם בפשטות,"
        },
        {
          "s": 21,
          "text": "דבאור אין שייך ענין הגלות,"
        },
        {
          "s": 22,
          "text": "כי החושך"
        },
        {
          "s": 23,
          "text": "(דהגלות)"
        },
        {
          "s": 24,
          "text": "נדחה מפני האור."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "והנה עד\"ז הוא גם בנשמה וגוף,"
        },
        {
          "s": 1,
          "text": "שהם דוגמת אור וכלי26."
        },
        {
          "s": 2,
          "text": "וכידוע מאמר כ\"ק מו\"ח אדמו\"ר27"
        },
        {
          "s": 3,
          "text": "שרק הגוף הוא בגלות ולא הנשמה."
        },
        {
          "s": 4,
          "text": "והיינו,"
        },
        {
          "s": 5,
          "text": "דהגם שהנשמה היא מלובשת בגוף והגוף הוא בגלות,"
        },
        {
          "s": 6,
          "text": "מ\"מ בנוגע להנשמה אין זה ענין של גלות."
        },
        {
          "s": 7,
          "text": "ורק שמצד זה שהגוף הוא בגלות,"
        },
        {
          "s": 8,
          "text": "הנשמה שמלובשת בו היא נמצאת שלא במקומה וצריכה להשבה."
        },
        {
          "s": 9,
          "text": "וכמרז\"ל28"
        },
        {
          "s": 10,
          "text": "אני ישנה בגלותא ולבי ער,"
        },
        {
          "s": 11,
          "text": "דגם כשאני ישנה בגלותא,"
        },
        {
          "s": 12,
          "text": "הנשמה"
        },
        {
          "s": 13,
          "text": "(ולבי29)"
        },
        {
          "s": 14,
          "text": "היא ער."
        },
        {
          "s": 15,
          "text": "דמכיון שהנשמה היא חלק אלוקה ממעל ממש30,"
        },
        {
          "s": 16,
          "text": "דגם כשהיא באופן ד\"ממש\" מלשון ממשות31"
        },
        {
          "s": 17,
          "text": "היינו שהיא מלובשת בגוף גשמי,"
        },
        {
          "s": 18,
          "text": "היא חלק אלוקה ממעל"
        },
        {
          "s": 19,
          "text": "[ועד שהיא חלק אלוקה ממעל ממש],"
        },
        {
          "s": 20,
          "text": "וידוע מאמר הבעש\"ט32"
        },
        {
          "s": 21,
          "text": "שכשאתה תופס במקצת מן העצם אתה תופס בכולו,"
        },
        {
          "s": 22,
          "text": "לכן,"
        },
        {
          "s": 23,
          "text": "גם לאחרי ירידתה והתלבשותה בגוף בכח המפליא לעשות33,"
        },
        {
          "s": 24,
          "text": "ואפילו בזמן הגלות,"
        },
        {
          "s": 25,
          "text": "אינה בגלות וכו'."
        },
        {
          "s": 26,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 27,
          "text": "דהלשון ושבי' קאי לא רק על סוג מיוחד שבישראל,"
        },
        {
          "s": 28,
          "text": "אלא גם על הנשמה דכאו\"א מישראל."
        },
        {
          "s": 29,
          "text": "דמכיון שהנשמה אינה בגלות,"
        },
        {
          "s": 30,
          "text": "אין שייך בה הלשון פדי'."
        },
        {
          "s": 31,
          "text": "אלא שאעפ\"כ צריכה להשבה,"
        },
        {
          "s": 32,
          "text": "כי מכיון שהנשמה מלובשת בהגוף,"
        },
        {
          "s": 33,
          "text": "ועד שהיא מתפעלת ממאורעי הגוף34,"
        },
        {
          "s": 34,
          "text": "ע\"י הגלות דהגוף,"
        },
        {
          "s": 35,
          "text": "גם הנשמה נמצאת במקום הגלות,"
        },
        {
          "s": 36,
          "text": "ולכן צריכה להשבה."
        }
      ]
    }
  ]
}