{
  "globalIndex": 232,
  "owner": 32,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915147_theRebbe_734__p004",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915147_theRebbe_734__p004",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518915147_theRebbe_734",
  "title": "מאמר ויתן לך תשכ\"ח",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ויש להוסיף,"
        },
        {
          "s": 2,
          "text": "דמכיון שבסט\"א הוא במספר י\"א,"
        },
        {
          "s": 3,
          "text": "היינו שגם המקיף נכלל בהמספר,"
        },
        {
          "s": 4,
          "text": "לפי שהוא החיות שמחי' אותם כנ\"ל,"
        },
        {
          "s": 5,
          "text": "לכן,"
        },
        {
          "s": 6,
          "text": "ע\"י בירור הי\"א כתרין דמסאבותא,"
        },
        {
          "s": 7,
          "text": "נעשה עד\"ז גם בקדושה,"
        },
        {
          "s": 8,
          "text": "שגם בחינת עתיק"
        },
        {
          "s": 9,
          "text": "(שהיא לא בחושבן הספירות)"
        },
        {
          "s": 10,
          "text": "נמשכת בהע\"ס בפנימיותם30."
        },
        {
          "s": 11,
          "text": "וענין זה הוא חידוש גדול יותר מההמשכה דעתיק לברר בירורים"
        },
        {
          "s": 12,
          "text": "(שההמשכה למטה היא רק נתינת כח)."
        },
        {
          "s": 13,
          "text": "ומזה מובן,"
        },
        {
          "s": 14,
          "text": "שבענין זה"
        },
        {
          "s": 15,
          "text": "(המשך עתיק בהע\"ס בפנימיותם,"
        },
        {
          "s": 16,
          "text": "שנעשה ע\"י עבודת הבירורים)"
        },
        {
          "s": 17,
          "text": "מתגלה גם העצמות"
        },
        {
          "s": 18,
          "text": "(שאינו מוגדר בשום גדר)"
        },
        {
          "s": 19,
          "text": "עוד יותר31."
        },
        {
          "s": 20,
          "text": "וזהו ויתן לך,"
        },
        {
          "s": 21,
          "text": "יתן ויחזור ויתן32,"
        },
        {
          "s": 22,
          "text": "דנתינה הראשונה היא המשכת העלם העצמי"
        },
        {
          "s": 23,
          "text": "(ויתן לך האלקים)"
        },
        {
          "s": 24,
          "text": "בכדי לברר בירורים,"
        },
        {
          "s": 25,
          "text": "וזה שיחזור ויתן,"
        },
        {
          "s": 26,
          "text": "הוא המשכת וגילוי העצמי שנעשה ע\"י עבודת הבירורים."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "וע\"י ויתן לך האלקים,"
        },
        {
          "s": 1,
          "text": "המשכת העלם העצמי בשני אופנים הנ\"ל"
        },
        {
          "s": 2,
          "text": "(יתן ויחזור ויתן),"
        },
        {
          "s": 3,
          "text": "נמשך גם מטל השמים ומשמני הארץ וגו',"
        },
        {
          "s": 4,
          "text": "מקרא משנה וכו',"
        },
        {
          "s": 5,
          "text": "וגם מטל השמים כפשוטו,"
        },
        {
          "s": 6,
          "text": "דטל לא מיעצר33"
        },
        {
          "s": 7,
          "text": "(ובפרט שמלכתחילה אין סלקא דעתך לעכב ח\"ו),"
        },
        {
          "s": 8,
          "text": "וכן משמני הארץ ורוב דגן ותירוש כפשוטם,"
        },
        {
          "s": 9,
          "text": "ובתכלית ההרחבה,"
        },
        {
          "s": 10,
          "text": "ועד לבנין בית המקדש השלישי,"
        },
        {
          "s": 11,
          "text": "יעקב שקראו בית34,"
        },
        {
          "s": 12,
          "text": "ומשם אורה יוצאת לכל העולם כולו35,"
        },
        {
          "s": 13,
          "text": "שעושים את כל העולם דירה לו יתברך."
        }
      ]
    }
  ]
}