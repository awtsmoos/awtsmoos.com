{
  "globalIndex": 412,
  "owner": 12,
  "jobId": "_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916134_theRebbe_917__p001",
  "batchId": "meluket-_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916134_theRebbe_917__p001",
  "seriesId": "טבת_meluket",
  "postId": "BH_POST_1766518916134_theRebbe_917",
  "title": "מאמר ויגש אליו יהודה תשכ\"ה",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ ויגש,"
        },
        {
          "s": 2,
          "text": "ז' טבת,"
        },
        {
          "s": 3,
          "text": "ה'תשכ\"ה"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "ויגש אליו יהודה גו'1,"
        },
        {
          "s": 1,
          "text": "ובההפטורה דפרשת ויגש נאמר2"
        },
        {
          "s": 2,
          "text": "קח לך עץ אחד וכתוב עליו ליהודה גו' ולקח עץ אחד וכתוב עליו ליוסף גו' וקרב אותם אחד אל אחד לך לעץ אחד והיו לאחדים בידך."
        },
        {
          "s": 3,
          "text": "ולכאורה השייכות דההפטורה להפרשה היא בזה שהתוכן דשניהם הוא חיבור יהודה ויוסף."
        },
        {
          "s": 4,
          "text": "אבל בפרטיות,"
        },
        {
          "s": 5,
          "text": "בהגשת יהודה ליוסף"
        },
        {
          "s": 6,
          "text": "(בפרשה)"
        },
        {
          "s": 7,
          "text": "מודגש שיוסף הי' נעלה יותר מיהודה,"
        },
        {
          "s": 8,
          "text": "ועד שיוסף הי' מלך על כל אחיו,"
        },
        {
          "s": 9,
          "text": "כולל יהודה,"
        },
        {
          "s": 10,
          "text": "ובההפטורה נאמר3"
        },
        {
          "s": 11,
          "text": "ועבדי דוד מלך עליהם."
        },
        {
          "s": 12,
          "text": "[וכמבואר בתו\"א4,"
        },
        {
          "s": 13,
          "text": "דיוסף הוא"
        },
        {
          "s": 14,
          "text": "[יסוד]"
        },
        {
          "s": 15,
          "text": "ז\"א ויהודה הוא מלכות,"
        },
        {
          "s": 16,
          "text": "ולכן עכשיו יוסף הוא למעלה מיהודה,"
        },
        {
          "s": 17,
          "text": "כי בסדר השתלשלות,"
        },
        {
          "s": 18,
          "text": "ז\"א הוא למעלה מהמלכות"
        },
        {
          "s": 19,
          "text": "[ויתירה מזו,"
        },
        {
          "s": 20,
          "text": "ז\"א הוא משפיע למלכות."
        },
        {
          "s": 21,
          "text": "וזהו ויגש אליו יהודה ויאמר בי אדוני,"
        },
        {
          "s": 22,
          "text": "דפירוש בי אדוני הוא שביהודה"
        },
        {
          "s": 23,
          "text": "(בי)"
        },
        {
          "s": 24,
          "text": "יומשך השפע מיוסף הצדיק"
        },
        {
          "s": 25,
          "text": "(אדוני)]."
        },
        {
          "s": 26,
          "text": "ולעתיד לבוא,"
        },
        {
          "s": 27,
          "text": "שאז יתגלה שורש המלכות,"
        },
        {
          "s": 28,
          "text": "שהוא למעלה משורש ז\"א,"
        },
        {
          "s": 29,
          "text": "לכן אז יהי' עבדי דוד מלך עליהם]."
        },
        {
          "s": 30,
          "text": "אבל מזה שגם הפסוק ועבדי דוד מלך עליהם הוא בההפטורה דפרשת ויגש,"
        },
        {
          "s": 31,
          "text": "משמע,"
        },
        {
          "s": 32,
          "text": "שבויגש אליו יהודה ישנה גם המעלה דיהודה לגבי יוסף."
        },
        {
          "s": 33,
          "text": "אלא שזה שמודגש בגילוי בויגש אליו יהודה הוא המעלה דיוסף לגבי יהודה,"
        },
        {
          "s": 34,
          "text": "ובההפטורה המעלה דיהודה לגבי יוסף."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויש לקשר זה עם המבואר בדרושי הצ\"צ5,"
        },
        {
          "s": 2,
          "text": "דזה שסופי תיבות ויגש אליו."
        },
        {
          "s": 3,
          "text": "יהודה."
        },
        {
          "s": 4,
          "text": "הוא שוה6,"
        },
        {
          "s": 5,
          "text": "כי ענין ויגש אליו יהודה הוא שהמלכות"
        },
        {
          "s": 6,
          "text": "(יהודה)"
        },
        {
          "s": 7,
          "text": "וז\"א"
        },
        {
          "s": 8,
          "text": "(יוסף)"
        },
        {
          "s": 9,
          "text": "שניהם שוים."
        },
        {
          "s": 10,
          "text": "ומבאר,"
        },
        {
          "s": 11,
          "text": "דענין שוה הוא ע\"ד מ\"ש בלקו\"ת7"
        },
        {
          "s": 12,
          "text": "בפירוש הכתוב8"
        },
        {
          "s": 13,
          "text": "לעשות הישר בעיני ה',"
        },
        {
          "s": 14,
          "text": "דענין ישר הוא החיבור והיחוד דדעת עליון ודעת תחתון,"
        },
        {
          "s": 15,
          "text": "יחודא עילאה ויחודא תתאה"
        },
        {
          "s": 16,
          "text": "(ששניהם הם בשוה),"
        },
        {
          "s": 17,
          "text": "למהוי אחד באחד9."
        },
        {
          "s": 18,
          "text": "דיוסף ויהודה כמו שהם מצד עצמם,"
        },
        {
          "s": 19,
          "text": "הם"
        },
        {
          "s": 20,
          "text": "(כמו)"
        },
        {
          "s": 21,
          "text": "שני הפכים."
        },
        {
          "s": 22,
          "text": "דביוסף"
        },
        {
          "s": 23,
          "text": "(ז\"א),"
        },
        {
          "s": 24,
          "text": "שהוא מלמעלה למטה,"
        },
        {
          "s": 25,
          "text": "הוא10"
        },
        {
          "s": 26,
          "text": "דעת עליון שלמעלה יש ולמטה אין,"
        },
        {
          "s": 27,
          "text": "וביהודה"
        },
        {
          "s": 28,
          "text": "(מלכות),"
        },
        {
          "s": 29,
          "text": "שהוא מלמטה למעלה,"
        },
        {
          "s": 30,
          "text": "הוא10"
        },
        {
          "s": 31,
          "text": "דעת תחתון שלמטה יש ולמעלה אין,"
        },
        {
          "s": 32,
          "text": "וענין ויגש אליו יהודה הוא החיבור דדעת עליון ודעת תחתון."
        },
        {
          "s": 33,
          "text": "[וזהו שארז\"ל11"
        },
        {
          "s": 34,
          "text": "עה\"פ ויגש אליו יהודה אין ויגש אלא לשון שלום,"
        },
        {
          "s": 35,
          "text": "דענין השלום הוא החיבור דדעת עליון ודעת תחתון12]."
        },
        {
          "s": 36,
          "text": "וע\"ד מ\"ש13"
        },
        {
          "s": 37,
          "text": "ונקבצו בני יהודה ובני ישראל יחדיו ושמו להם ראש אחד,"
        },
        {
          "s": 38,
          "text": "דעכשיו14,"
        },
        {
          "s": 39,
          "text": "העבודה דבני יהודה היא מלמטה למעלה,"
        },
        {
          "s": 40,
          "text": "דעת תחתון,"
        },
        {
          "s": 41,
          "text": "והעבודה דבני ישראל"
        },
        {
          "s": 42,
          "text": "[עשרת השבטים ששייכים ליוסף]"
        },
        {
          "s": 43,
          "text": "היא מלמעלה למטה,"
        },
        {
          "s": 44,
          "text": "דעת עליון,"
        },
        {
          "s": 45,
          "text": "ולע\"ל יתחברו יחד,"
        },
        {
          "s": 46,
          "text": "למהוי אחד באחד."
        }
      ]
    }
  ]
}