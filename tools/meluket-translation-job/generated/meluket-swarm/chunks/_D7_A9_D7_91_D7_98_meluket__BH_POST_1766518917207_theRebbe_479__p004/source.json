{
  "globalIndex": 603,
  "owner": 3,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917207_theRebbe_479__p004",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917207_theRebbe_479__p004",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518917207_theRebbe_479",
  "title": "מאמר ואלה המשפטים תשמ\"א",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ויש לקשר זה עם זה שארז\"ל עה\"פ ואלה המשפטים,"
        },
        {
          "s": 1,
          "text": "ואלה מוסיף על הראשונים,"
        },
        {
          "s": 2,
          "text": "מה הראשונים מסיני אף אלו מסיני,"
        },
        {
          "s": 3,
          "text": "שהכח על החיבור דשני ההפכים שבמשפטים"
        },
        {
          "s": 4,
          "text": "[שהם מובנים בשכל,"
        },
        {
          "s": 5,
          "text": "והלימוד"
        },
        {
          "s": 6,
          "text": "(שלהם49)"
        },
        {
          "s": 7,
          "text": "צריך להיות באופן דאשר תשים לפניהם,"
        },
        {
          "s": 8,
          "text": "טעם המיישב תלמודם,"
        },
        {
          "s": 9,
          "text": "שעי\"ז נעשית התורה תורתו של האדם הלומד."
        },
        {
          "s": 10,
          "text": "וביחד עם זה צריך להיות הלימוד שלהם באופן דכי תקנה,"
        },
        {
          "s": 11,
          "text": "שירגיש שהיא תורת הוי'"
        },
        {
          "s": 12,
          "text": "(תורתך שבאצילות,"
        },
        {
          "s": 13,
          "text": "קנין),"
        },
        {
          "s": 14,
          "text": "ויתירה מזה,"
        },
        {
          "s": 15,
          "text": "שהלימוד שלהם צ\"ל באופן דעבד,"
        },
        {
          "s": 16,
          "text": "עולה של תורה],"
        },
        {
          "s": 17,
          "text": "ניתן מסיני50,"
        },
        {
          "s": 18,
          "text": "שגם בו הוא חיבור דשני ההפכים,"
        },
        {
          "s": 19,
          "text": "מציאות וביטול."
        },
        {
          "s": 20,
          "text": "וכמבואר בלקו\"ת51,"
        },
        {
          "s": 21,
          "text": "דזה שהתורה ניתנה על הר סיני דמכיך מכל טוריא52,"
        },
        {
          "s": 22,
          "text": "הוא מפני שבהר סיני ישנם שני ההפכים."
        },
        {
          "s": 23,
          "text": "הר – הגבהה,"
        },
        {
          "s": 24,
          "text": "ומכיך – ביטול."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "והנה אמרו רז\"ל53"
        },
        {
          "s": 2,
          "text": "גדול תלמוד שמביא לידי מעשה."
        },
        {
          "s": 3,
          "text": "ויש לומר,"
        },
        {
          "s": 4,
          "text": "שע\"י החיבור דשני ההפכים"
        },
        {
          "s": 5,
          "text": "(מציאות וביטול)"
        },
        {
          "s": 6,
          "text": "שבלימוד התורה,"
        },
        {
          "s": 7,
          "text": "נמשך עד\"ז גם במעשה המצוות."
        },
        {
          "s": 8,
          "text": "אלא שבלימוד התורה החידוש הוא הביטול."
        },
        {
          "s": 9,
          "text": "דהגם שלימוד התורה הוא בהבנה והשגה"
        },
        {
          "s": 10,
          "text": "(מציאות)"
        },
        {
          "s": 11,
          "text": "מ\"מ צריך להיות הלימוד בביטול."
        },
        {
          "s": 12,
          "text": "ובקיום המצוות החידוש הוא המציאות."
        },
        {
          "s": 13,
          "text": "דהגם שקיום המצוות צ\"ל מצד ציווי הקב\"ה"
        },
        {
          "s": 14,
          "text": "[כמובן גם מזה שמצוות הוא לשון ציווי],"
        },
        {
          "s": 15,
          "text": "בדרך עבודת עבד54,"
        },
        {
          "s": 16,
          "text": "מ\"מ הביטול שלו צריך להיות באופן שהביטול אינו שולל את מציאותו אלא אדרבה זה גופא הוא מציאותו."
        },
        {
          "s": 17,
          "text": "היינו,"
        },
        {
          "s": 18,
          "text": "דזה שהוא עבדו של הקב\"ה הוא"
        },
        {
          "s": 19,
          "text": "[לא רק מצד ההכרח,"
        },
        {
          "s": 20,
          "text": "אלא]"
        },
        {
          "s": 21,
          "text": "שהוא רוצה להיות עבדו של הקב\"ה ויש לו חיות ותענוג בזה."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דמהטעמים על זה שהתחלת הציווים דפרשת משפטים הוא בפסוק ואלה המשפטים אשר תשים לפניהם שמדבר בלימוד התורה כדרשת חז\"ל,"
        },
        {
          "s": 2,
          "text": "הובאה לעיל סעיף ג"
        },
        {
          "s": 3,
          "text": "[דלא כרוב הציווים שבתורה שבתחילתם הוא דבר אל בני ישראל,"
        },
        {
          "s": 4,
          "text": "צו את בני ישראל,"
        },
        {
          "s": 5,
          "text": "ולא נזכר בהם ענין הלימוד],"
        },
        {
          "s": 6,
          "text": "כי זה שהתחלת הציווים דפרשת משפטים הוא בדיני עבד מרמז שקיום כל המצוות צ\"ל בדרך עבודת עבד"
        },
        {
          "s": 7,
          "text": "(כנ\"ל סעיף ב),"
        },
        {
          "s": 8,
          "text": "וכיון שגם הביטול דקבלת עול"
        },
        {
          "s": 9,
          "text": "(עבודת עבד)"
        },
        {
          "s": 10,
          "text": "צ\"ל בחיות ובתענוג"
        },
        {
          "s": 11,
          "text": "(כנ\"ל),"
        },
        {
          "s": 12,
          "text": "לכן,"
        },
        {
          "s": 13,
          "text": "התחלת הפרשה היא בהענין דלימוד התורה,"
        },
        {
          "s": 14,
          "text": "דמהתענוג והחיות שבלימוד התורה נמשך מעין התענוג וחיות דתורה גם בהעבודה דקבלת עול55."
        }
      ]
    }
  ]
}