{
  "globalIndex": 181,
  "owner": 31,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914830_theRebbe_782__p004",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914830_theRebbe_782__p004",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518914830_theRebbe_782",
  "title": "מאמר וה' אמר המכסה אני מאברהם תשל\"ז",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ויש לקשר זה עם הפסוק"
        },
        {
          "s": 2,
          "text": "(בתהלים קאַפּיטל49"
        },
        {
          "s": 3,
          "text": "קטז,"
        },
        {
          "s": 4,
          "text": "הקאַפּיטל דבעל יום ההולדת50"
        },
        {
          "s": 5,
          "text": "דשנה שעברה51)"
        },
        {
          "s": 6,
          "text": "אתהלך לפני הוי' בארצות החיים52,"
        },
        {
          "s": 7,
          "text": "ארצות לשון רבים,"
        },
        {
          "s": 8,
          "text": "ומבואר בתו\"א53"
        },
        {
          "s": 9,
          "text": "שהם"
        },
        {
          "s": 10,
          "text": "(בכלל)"
        },
        {
          "s": 11,
          "text": "ב' ארצות,"
        },
        {
          "s": 12,
          "text": "עלמא דאתכסיא ועלמא דאתגליא,"
        },
        {
          "s": 13,
          "text": "דב' ארצות אלו הם המשכה מלמעלה למטה והעלאה מלמטה למעלה."
        },
        {
          "s": 14,
          "text": "ויש לבאר זה בב' אופנים."
        },
        {
          "s": 15,
          "text": "א' שעלמא דאתכסיא הו\"ע העלאה מלמטה למעלה"
        },
        {
          "s": 16,
          "text": "(דעלי' למעלה הו\"ע של התעלמות)"
        },
        {
          "s": 17,
          "text": "ועלמא דאתגליא"
        },
        {
          "s": 18,
          "text": "(ענין הגילוי וירידה)"
        },
        {
          "s": 19,
          "text": "הו\"ע המשכה מלמעלה למטה."
        },
        {
          "s": 20,
          "text": "וע\"פ המבואר בתו\"א שם שעלמא דאתכסיא הוא בחי' לאה"
        },
        {
          "s": 21,
          "text": "(מחשבה)"
        },
        {
          "s": 22,
          "text": "ועלמא דאתגליא הוא בחי' רחל"
        },
        {
          "s": 23,
          "text": "(דיבור),"
        },
        {
          "s": 24,
          "text": "יש לומר,"
        },
        {
          "s": 25,
          "text": "שעלמא דאתכסיא בעבודת האדם הוא לימוד התורה,"
        },
        {
          "s": 26,
          "text": "שעיקר ענינה הוא הבנה והשגה"
        },
        {
          "s": 27,
          "text": "(מחשבה)54,"
        },
        {
          "s": 28,
          "text": "ועלמא דאתגליא הוא קיום המצוות בדיבור ומעשה."
        },
        {
          "s": 29,
          "text": "ועפ\"ז,"
        },
        {
          "s": 30,
          "text": "עלמא דאתכסיא הוא המשכה מלמעלה למטה ועלמא דאתגליא הוא העלאה מלמטה למעלה,"
        },
        {
          "s": 31,
          "text": "כנ\"ל בארוכה שתורה היא המשכה מלמעלה למטה ומצוות הם העלאה מלמטה למעלה."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "וע\"י העבודה דאתהלך לפני הוי' בארצות החיים,"
        },
        {
          "s": 2,
          "text": "באים לתוכן הקאַפּיטל דבעל יום ההולדת50"
        },
        {
          "s": 3,
          "text": "דשנה זו55,"
        },
        {
          "s": 4,
          "text": "הללו את הוי' כל גוים גו' כי גבר עלינו חסדו גו',"
        },
        {
          "s": 5,
          "text": "שגם שני ענינים אלו הו\"ע העלאה והמשכה."
        },
        {
          "s": 6,
          "text": "הללו גו' כל גוים גו' הו\"ע בירור זיכוך והעלאת העולם56,"
        },
        {
          "s": 7,
          "text": "עד שגם הגוים והאומים מהללים ומשבחים את הוי'."
        },
        {
          "s": 8,
          "text": "וגבר עלינו חסדו גו' הו\"ע המשכה מלמעלה למטה,"
        },
        {
          "s": 9,
          "text": "דנוסף על זה שחסד"
        },
        {
          "s": 10,
          "text": "(בכלל)"
        },
        {
          "s": 11,
          "text": "הוא המשכה מלמעלה למטה,"
        },
        {
          "s": 12,
          "text": "הנה החסד"
        },
        {
          "s": 13,
          "text": "(ההמשכה)"
        },
        {
          "s": 14,
          "text": "הוא בתוקף ובהתגברות,"
        },
        {
          "s": 15,
          "text": "גבר גו' חסדו."
        },
        {
          "s": 16,
          "text": "והוא,"
        },
        {
          "s": 17,
          "text": "שההמשכה היא מלמעלה מעלה ביותר,"
        },
        {
          "s": 18,
          "text": "קצה הכי עליון,"
        },
        {
          "s": 19,
          "text": "וביחד עם זה באה ההמשכה למטה מטה,"
        },
        {
          "s": 20,
          "text": "עד לתחתון שאין תחתון למטה ממנו,"
        },
        {
          "s": 21,
          "text": "וזהו מה שממשיך בכתוב ואמת הוי' לעולם,"
        },
        {
          "s": 22,
          "text": "דאמת הוי' היא בחינה נעלית ביותר"
        },
        {
          "s": 23,
          "text": "[וי\"ל שזהו\"ע מ\"ש הרמב\"ם57"
        },
        {
          "s": 24,
          "text": "שכל הנמצאים לא נמצאו אלא מאמיתת המצאו,"
        },
        {
          "s": 25,
          "text": "דאמיתת המצאו שייך לשם הוי',"
        },
        {
          "s": 26,
          "text": "שלכן מביא ברמב\"ם"
        },
        {
          "s": 27,
          "text": "(בהמשך הענין שם)58"
        },
        {
          "s": 28,
          "text": "הפסוק59"
        },
        {
          "s": 29,
          "text": "והוי' אלקים אמת],"
        },
        {
          "s": 30,
          "text": "ואעפ\"כ הוא נמשך לעולם,"
        },
        {
          "s": 31,
          "text": "לעולם הזה הגשמי,"
        },
        {
          "s": 32,
          "text": "ובזה גופא גם לגוים ואומים."
        },
        {
          "s": 33,
          "text": "אמנם לאחרי כל העילוי דהמשכה זו,"
        },
        {
          "s": 34,
          "text": "נאמר זה בכתוב"
        },
        {
          "s": 35,
          "text": "(לא בתור ענין בפ\"ע,"
        },
        {
          "s": 36,
          "text": "אלא)"
        },
        {
          "s": 37,
          "text": "בתור טעם"
        },
        {
          "s": 38,
          "text": "(כי)"
        },
        {
          "s": 39,
          "text": "על הללו גו' כל גוים."
        },
        {
          "s": 40,
          "text": "דתכלית הכוונה של ההמשכה היא שעי\"ז יהי' אח\"כ בירור ועליית המטה,"
        },
        {
          "s": 41,
          "text": "שגם הגוים גופא יהללו את הוי'."
        },
        {
          "s": 42,
          "text": "וע\"ד העילוי דלעשות צדקה ומשפט שבא ע\"י קדימת דרך הוי'60."
        },
        {
          "s": 43,
          "text": "וסיום וחותם המזמור הוא הללוי',"
        },
        {
          "s": 44,
          "text": "דאמיתית ההילול יהי' בשירה העשירית61"
        },
        {
          "s": 45,
          "text": "לע\"ל,"
        },
        {
          "s": 46,
          "text": "שאז יתגלה העילוי דהעלאת התחתון,"
        },
        {
          "s": 47,
          "text": "מעשה גדול,"
        },
        {
          "s": 48,
          "text": "בביאת משיח צדקנו במהרה בימינו ממש."
        }
      ]
    }
  ]
}