{
  "globalIndex": 981,
  "owner": 31,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919577_theRebbe_550__p002",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919577_theRebbe_550__p002",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919577_theRebbe_550",
  "title": "מאמר הללויה שירו להוי' גו' תשט\"ז",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ולהבין זה יש להקדים תחלה דאיתא במשנה"
        },
        {
          "s": 2,
          "text": "(שבת פ\"ו מ\"ד)"
        },
        {
          "s": 3,
          "text": "לא יצא האיש"
        },
        {
          "s": 4,
          "text": "(בשבת)"
        },
        {
          "s": 5,
          "text": "לא בסייף7"
        },
        {
          "s": 6,
          "text": "לא בקשת ולא בתריס ולא באלה ולא ברומח כו',"
        },
        {
          "s": 7,
          "text": "רבי אליעזר אומר תכשיטין הן לו,"
        },
        {
          "s": 8,
          "text": "וחכמים אומרים אינו אלא כו' שנאמר וכתתו חרבותם לאתים."
        },
        {
          "s": 9,
          "text": "והנה במשנה זו נימנו חמשה כלי זיין,"
        },
        {
          "s": 10,
          "text": "דסייף הוא חרב שהוא כלי זיין,"
        },
        {
          "s": 11,
          "text": "וכן קשת,"
        },
        {
          "s": 12,
          "text": "וגם תריס שענינו להגן בעד החצים ובליסטראות הוא ג\"כ בכלל הכלי זיין,"
        },
        {
          "s": 13,
          "text": "וכן אלה פי' בגמרא8"
        },
        {
          "s": 14,
          "text": "מאי אלה קולפא,"
        },
        {
          "s": 15,
          "text": "שהוא שבט שמכין בו וראשו עב,"
        },
        {
          "s": 16,
          "text": "וא\"כ הוא ג\"כ כלי זיין."
        },
        {
          "s": 17,
          "text": "ואיתא בירושלמי9"
        },
        {
          "s": 18,
          "text": "ע\"פ10"
        },
        {
          "s": 19,
          "text": "וחמושים עלו בני ישראל מארץ מצרים,"
        },
        {
          "s": 20,
          "text": "שבתיבת וחמושים יש ב' פירושים,"
        },
        {
          "s": 21,
          "text": "פירוש חמש ופירוש מזויינים,"
        },
        {
          "s": 22,
          "text": "והיינו שהיו מזויינים בהחמשה כלי זיין שחושב בהמשנה"
        },
        {
          "s": 23,
          "text": "(דכן הוא הגירסא הנכונה בירושלמי11)."
        },
        {
          "s": 24,
          "text": "וצריך להבין ההפרש בין גאולת מצרים לגאולה העתידה,"
        },
        {
          "s": 25,
          "text": "דבגאולה העתידה כתיב וכתתו חרבותם לאתים,"
        },
        {
          "s": 26,
          "text": "ובגאולת מצרים הי' צריך לכלי זיין,"
        },
        {
          "s": 27,
          "text": "דלכאורה,"
        },
        {
          "s": 28,
          "text": "מאחר שהו\"ע של גאולה,"
        },
        {
          "s": 29,
          "text": "א\"כ למה צריך לכלי זיין."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ולהבין זה,"
        },
        {
          "s": 2,
          "text": "צריך להקדים תחלה ענין החרב ברוחניות."
        },
        {
          "s": 3,
          "text": "דהנה אמרו רז\"ל12"
        },
        {
          "s": 4,
          "text": "כל הקורא ק\"ש כו' כאילו אוחז חרב של שתי פיות,"
        },
        {
          "s": 5,
          "text": "דמשמע מזה שיש איזה מעלה בחרב של שתי פיות דוקא."
        },
        {
          "s": 6,
          "text": "והענין הוא,"
        },
        {
          "s": 7,
          "text": "כדאיתא בזהר13"
        },
        {
          "s": 8,
          "text": "דחרב דא הוי',"
        },
        {
          "s": 9,
          "text": "רישא דחרבא הוא יו\"ד דהוי',"
        },
        {
          "s": 10,
          "text": "גופא דחרבא הוא וא\"ו,"
        },
        {
          "s": 11,
          "text": "ה\"א ה\"א הן תרין פיות דילי',"
        },
        {
          "s": 12,
          "text": "נרתקא דחרבא הוא שם אד'."
        },
        {
          "s": 13,
          "text": "והענין הוא,"
        },
        {
          "s": 14,
          "text": "דהנה כתיב14"
        },
        {
          "s": 15,
          "text": "הוי' יחתו מריביו,"
        },
        {
          "s": 16,
          "text": "היינו,"
        },
        {
          "s": 17,
          "text": "שישנם אלו הלוחמים על הוי',"
        },
        {
          "s": 18,
          "text": "ונצוח המלחמה הוא ע\"י שם הוי' גופא,"
        },
        {
          "s": 19,
          "text": "דחרב דא הוי',"
        },
        {
          "s": 20,
          "text": "וע\"י חרב הוי' מנצחים המלחמה כנגד אלו הלוחמים על הוי'."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "והענין הוא,"
        },
        {
          "s": 1,
          "text": "דהנה יניקת החיצונים יכול להיות משני אופנים."
        },
        {
          "s": 2,
          "text": "אופן א' הוא מריבוי הצמצומים,"
        },
        {
          "s": 3,
          "text": "דכשמאיר אוא\"ס בבחי' גילוי משם אינם יכולים לקבל,"
        },
        {
          "s": 4,
          "text": "לפי שאין השראת אוא\"ס אלא בבחי' ביטול,"
        },
        {
          "s": 5,
          "text": "אבל בבחי' יש אינו יכול להיות גילוי אוא\"ס,"
        },
        {
          "s": 6,
          "text": "כי אין אני והוא יכולים לדור15,"
        },
        {
          "s": 7,
          "text": "ולכן הקליפות שהם יש ודבר נפרד אינם יכולים לקבל מבחי' גילוי,"
        },
        {
          "s": 8,
          "text": "אבל כשנתצמצם בבחי' ריבוי הצמצומים,"
        },
        {
          "s": 9,
          "text": "יכולים הם לקבל יניקה,"
        },
        {
          "s": 10,
          "text": "לפי שעכ\"פ מעט ביטול יש בהם,"
        },
        {
          "s": 11,
          "text": "דקרו לי' אלקא דאלקיא16,"
        },
        {
          "s": 12,
          "text": "אלא שהם מחזיקים גם את עצמם למציאות,"
        },
        {
          "s": 13,
          "text": "אבל מעט ביטול יש בם,"
        },
        {
          "s": 14,
          "text": "ולכן יכולים הם לקבל יניקה מריבוי הצמצומים."
        },
        {
          "s": 15,
          "text": "ואופן הב' הוא שמקבלים יניקתם מהגבהה והתנשאות,"
        },
        {
          "s": 16,
          "text": "היינו מעולם התהו שקדם לתקון,"
        },
        {
          "s": 17,
          "text": "ששם אינו תופס מקום כלל,"
        },
        {
          "s": 18,
          "text": "וכחשיכה כאורה17"
        },
        {
          "s": 19,
          "text": "בשוה,"
        },
        {
          "s": 20,
          "text": "וכמ\"ש18"
        },
        {
          "s": 21,
          "text": "שממית בידים תתפש והיא בהיכלי מלך,"
        },
        {
          "s": 22,
          "text": "דכיון שנמצאת בהיכלי מלך ששם אינו תופס מקום כלל,"
        },
        {
          "s": 23,
          "text": "לכן הנה גם שממית בידים תתפש."
        },
        {
          "s": 24,
          "text": "וזהו מ\"ש19"
        },
        {
          "s": 25,
          "text": "אם תגביה כנשר,"
        },
        {
          "s": 26,
          "text": "שמגביהים את עצמם למעלה מאד,"
        },
        {
          "s": 27,
          "text": "וכמו דרך הנשר בשמים20."
        }
      ]
    }
  ]
}