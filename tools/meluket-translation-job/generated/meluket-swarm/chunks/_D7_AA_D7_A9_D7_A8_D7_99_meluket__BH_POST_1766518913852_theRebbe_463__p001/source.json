{
  "globalIndex": 29,
  "owner": 29,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913852_theRebbe_463__p001",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913852_theRebbe_463__p001",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518913852_theRebbe_463",
  "title": "מאמר זה היום תחילת מעשיך תשמ\"ב",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ליל ערב ראש השנה ה'תשמ\"ב*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "זה היום תחלת מעשיך זכרון ליום ראשון1,"
        },
        {
          "s": 1,
          "text": "ומדייק אדמו\"ר הצ\"צ2"
        },
        {
          "s": 2,
          "text": "[בעל יום ההולדת דערב ראש השנה3],"
        },
        {
          "s": 3,
          "text": "דלכאורה יש כאן סתירה מרישא לסיפא,"
        },
        {
          "s": 4,
          "text": "דפירוש זה היום תחלת מעשיך"
        },
        {
          "s": 5,
          "text": "(תחלה ממש)"
        },
        {
          "s": 6,
          "text": "הוא שבראש השנה"
        },
        {
          "s": 7,
          "text": "(זה היום)"
        },
        {
          "s": 8,
          "text": "הוא התחלת התהוות כל העולמות,"
        },
        {
          "s": 9,
          "text": "היינו שבכל ראש השנה מתהווים כל העולמות מחדש4"
        },
        {
          "s": 10,
          "text": "כמו שהי' בפעם הראשונה,"
        },
        {
          "s": 11,
          "text": "ופירוש זכרון ליום ראשון הוא שראש השנה הוא רק זכרון ליום ראשון."
        },
        {
          "s": 12,
          "text": "ומבאר בזה,"
        },
        {
          "s": 13,
          "text": "דבראש השנה ישנם שני הענינים,"
        },
        {
          "s": 14,
          "text": "שהוא תחלת מעשיך ושהוא זכרון ליום ראשון."
        },
        {
          "s": 15,
          "text": "ומזה שבתחלה אומרים שראש השנה הוא תחלת מעשיך ואח\"כ מוסיפים שהוא זכרון ליום ראשון,"
        },
        {
          "s": 16,
          "text": "מוכח,"
        },
        {
          "s": 17,
          "text": "דזה שראש השנה הוא זכרון ליום ראשון הוא נעלה יותר5"
        },
        {
          "s": 18,
          "text": "מזה שהוא תחלת מעשיך."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים הביאור בזה שאומרים על היום דראש השנה זה היום תחלת מעשיך,"
        },
        {
          "s": 2,
          "text": "דידועה השאלה בזה6,"
        },
        {
          "s": 3,
          "text": "הרי בכ\"ה באלול נברא העולם7,"
        },
        {
          "s": 4,
          "text": "וראש השנה הוא יום ברוא אדם הראשון שהוא יום וא\"ו למע\"ב שבו הי' סוף וגמר הבריאה,"
        },
        {
          "s": 5,
          "text": "ואיך אומרים על יום זה שהוא תחלת מעשיך."
        },
        {
          "s": 6,
          "text": "והביאור בזה,"
        },
        {
          "s": 7,
          "text": "דתכלית הכוונה דבריאת העולם הוא שיהי' בו גילוי אלקות."
        },
        {
          "s": 8,
          "text": "ועד שע\"י כל פרט ופרט שבהבריאה יתגלה כבודו של הקב\"ה,"
        },
        {
          "s": 9,
          "text": "כמארז\"ל"
        },
        {
          "s": 10,
          "text": "(בסיום וחותם דמס' אבות8)"
        },
        {
          "s": 11,
          "text": "כל מה שברא הקב\"ה בעולמו לא בראו אלא לכבודו."
        },
        {
          "s": 12,
          "text": "וגילוי זה נעשה ע\"י עבודת האדם."
        },
        {
          "s": 13,
          "text": "ולכן אומרים על היום דראש השנה זה היום תחלת מעשיך,"
        },
        {
          "s": 14,
          "text": "כי ענין זה"
        },
        {
          "s": 15,
          "text": "(שיהי' גילוי אלקות בעולם),"
        },
        {
          "s": 16,
          "text": "שהוא המכוון דמעשיך,"
        },
        {
          "s": 17,
          "text": "הותחל ביום ברוא האדם9."
        },
        {
          "s": 18,
          "text": "דנוסף לזה שאז דוקא נעשית האפשרות שיהי' גילוי אלקות בעולם,"
        },
        {
          "s": 19,
          "text": "נעשה אז כן גם בפועל,"
        },
        {
          "s": 20,
          "text": "כמארז\"ל10"
        },
        {
          "s": 21,
          "text": "שאדם הראשון"
        },
        {
          "s": 22,
          "text": "(ביום שנברא)"
        },
        {
          "s": 23,
          "text": "הכריז לכל הברואים בואו11"
        },
        {
          "s": 24,
          "text": "נשתחוה ונכרעה נברכה לפני ה' עושינו,"
        },
        {
          "s": 25,
          "text": "וכולם ענו ואמרו ה'12"
        },
        {
          "s": 26,
          "text": "מלך גאות לבש."
        },
        {
          "s": 27,
          "text": "ויש לומר,"
        },
        {
          "s": 28,
          "text": "דזה שאומרים זה היום תחלת מעשיך"
        },
        {
          "s": 29,
          "text": "(הגם שראש השנה הוא לכאורה רק התחלת המכוון דמעשיך),"
        },
        {
          "s": 30,
          "text": "הוא,"
        },
        {
          "s": 31,
          "text": "כי מעשה מורה על השלימות,"
        },
        {
          "s": 32,
          "text": "דכמו שבאדם השלימות דכל ענין הוא כשבא בפועל דוקא,"
        },
        {
          "s": 33,
          "text": "עד\"ז הוא גם למעלה"
        },
        {
          "s": 34,
          "text": "[ואדרבא,"
        },
        {
          "s": 35,
          "text": "מזה נשתלשל כן גם באדם התחתון13,"
        },
        {
          "s": 36,
          "text": "אדם אדמה לעליון14],"
        },
        {
          "s": 37,
          "text": "שהשלימות דכל סדר ההשתלשלות היא בעשי' דוקא."
        },
        {
          "s": 38,
          "text": "וזהו זה היום תחלת מעשיך,"
        },
        {
          "s": 39,
          "text": "דמעשה מורה על השלימות,"
        },
        {
          "s": 40,
          "text": "שהיום דראש השנה יום ברוא אדם הראשון,"
        },
        {
          "s": 41,
          "text": "הוא התחלת שלימות הבריאה."
        },
        {
          "s": 42,
          "text": "ויש לומר דזהו גם הטעם על זה שראש השנה נקרא כאן"
        },
        {
          "s": 43,
          "text": "(בהמשך לתחלת מעשיך)"
        },
        {
          "s": 44,
          "text": "בשם זה היום,"
        },
        {
          "s": 45,
          "text": "דזה היום הוא גילוי בתכלית"
        },
        {
          "s": 46,
          "text": "[זה מורה על גילוי15"
        },
        {
          "s": 47,
          "text": "כמו מראה באצבעו ואומר זה16,"
        },
        {
          "s": 48,
          "text": "ויום מורה על גילוי17"
        },
        {
          "s": 49,
          "text": "כמ\"ש18"
        },
        {
          "s": 50,
          "text": "ויקרא אלקים לאור יום,"
        },
        {
          "s": 51,
          "text": "וזה היום"
        },
        {
          "s": 52,
          "text": "(ב' לשונות של גילוי)"
        },
        {
          "s": 53,
          "text": "הוא תכלית הגילוי],"
        },
        {
          "s": 54,
          "text": "וזהו זה היום תחלת מעשיך,"
        },
        {
          "s": 55,
          "text": "דזה שראש השנה הוא תחלת מעשיך,"
        },
        {
          "s": 56,
          "text": "התחלת שלימות הבריאה,"
        },
        {
          "s": 57,
          "text": "הוא שאז התחיל ענין הגילוי"
        },
        {
          "s": 58,
          "text": "(דע\"י עבודתו של אדם הראשון נעשה גילוי אלקות בעולם,"
        },
        {
          "s": 59,
          "text": "כנ\"ל),"
        },
        {
          "s": 60,
          "text": "ענין זה היום19."
        }
      ]
    }
  ]
}