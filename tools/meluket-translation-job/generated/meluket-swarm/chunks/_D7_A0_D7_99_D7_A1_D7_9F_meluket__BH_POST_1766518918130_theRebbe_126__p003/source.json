{
  "globalIndex": 744,
  "owner": 44,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918130_theRebbe_126__p003",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918130_theRebbe_126__p003",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518918130_theRebbe_126",
  "title": "מאמר לה\"ע תחיית המתים תשמ\"ו",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וביאור הענין"
        },
        {
          "s": 2,
          "text": "(דג' מדריגות אלו,"
        },
        {
          "s": 3,
          "text": "ג\"ע וב' הדרגות בתחיית המתים),"
        },
        {
          "s": 4,
          "text": "דאיתא בגמרא26"
        },
        {
          "s": 5,
          "text": "כל הנביאים כולן לא נתנבאו אלא לימות המשיח אבל לעולם הבא עין27"
        },
        {
          "s": 6,
          "text": "לא ראתה אלקים זולתך."
        },
        {
          "s": 7,
          "text": "ובהמשך הענין שם מאי עין לא ראתה כו' זה עדן שלא שלטה בו עין כל ברי',"
        },
        {
          "s": 8,
          "text": "שמא תאמר אדה\"ר היכן הי' בגן כו',"
        },
        {
          "s": 9,
          "text": "גן לחוד ועדן לחוד."
        },
        {
          "s": 10,
          "text": "והיינו שהחידוש והעילוי דעולם הבא"
        },
        {
          "s": 11,
          "text": "(תחיית המתים)"
        },
        {
          "s": 12,
          "text": "לגבי ימות המשיח הוא שאז יהי' הגילוי דבחינת עדן,"
        },
        {
          "s": 13,
          "text": "עין לא ראתה."
        },
        {
          "s": 14,
          "text": "ומזה מובן,"
        },
        {
          "s": 15,
          "text": "דזה שבעולם הבא יהי' גילוי ההמשכה שנמשכה ע\"י קיום המצוות,"
        },
        {
          "s": 16,
          "text": "מכיון שגילוי זה יהי'"
        },
        {
          "s": 17,
          "text": "(בכללות)"
        },
        {
          "s": 18,
          "text": "גם בימות המשיח,"
        },
        {
          "s": 19,
          "text": "אין זה אמיתית הענין דעוה\"ב."
        },
        {
          "s": 20,
          "text": "ועיקר הענין דעוה\"ב הוא הגילוי דבחינת עדן,"
        },
        {
          "s": 21,
          "text": "והוא התענוג העצמי שמתענג בישראל,"
        },
        {
          "s": 22,
          "text": "שלמעלה גם מהתענוג שמתענג בתומ\"צ28."
        },
        {
          "s": 23,
          "text": "ולהעיר,"
        },
        {
          "s": 24,
          "text": "שבכ\"מ29"
        },
        {
          "s": 25,
          "text": "מבואר החילוק בין תורה למצוות,"
        },
        {
          "s": 26,
          "text": "דבתורה שהיא חכמתו ית' מלובש הארת התענוג ובמצוות שהם רצונו ית' מלובש עצמות התענוג"
        },
        {
          "s": 27,
          "text": "(בחינת עדן)."
        },
        {
          "s": 28,
          "text": "וזהו שבג\"ע כתיב30"
        },
        {
          "s": 29,
          "text": "ונהר יוצא מעדן להשקות את הגן,"
        },
        {
          "s": 30,
          "text": "שהתענוג שנמשך לנשמות בג\"ע"
        },
        {
          "s": 31,
          "text": "(בהשגת התורה)"
        },
        {
          "s": 32,
          "text": "הוא רק המשכה מצומצמת מבחינת עדן שנמשכת ע\"י הנהר שמפסיק בין עדן לגן,"
        },
        {
          "s": 33,
          "text": "משא\"כ בעוה\"ב שהוא מתן שכרן של מצוות הוא הגילוי דבחינת עדן עצמו."
        },
        {
          "s": 34,
          "text": "ויש לומר,"
        },
        {
          "s": 35,
          "text": "שזהו בכללות."
        },
        {
          "s": 36,
          "text": "אבל בפרטיות,"
        },
        {
          "s": 37,
          "text": "כיון שהגילוי דהמצוות יהי'"
        },
        {
          "s": 38,
          "text": "(בכללות)"
        },
        {
          "s": 39,
          "text": "גם בימות המשיח ואעפ\"כ אמרו שבימות המשיח לא יהי' גילוי דבחינת עין לא ראתה"
        },
        {
          "s": 40,
          "text": "(בחינת עדן),"
        },
        {
          "s": 41,
          "text": "וגילוי בחינה זו יהי' רק בעולם הבא,"
        },
        {
          "s": 42,
          "text": "מוכח מזה,"
        },
        {
          "s": 43,
          "text": "שעיקר בחינת עדן שיהי' בעולם הבא הוא שאז יתגלה התענוג העצמי שמתענג בישראל,"
        },
        {
          "s": 44,
          "text": "שלמעלה גם מהתענוג העצמי שבמצוות."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "וביאור העילוי דתחיית המתים לגבי ימות המשיח"
        },
        {
          "s": 2,
          "text": "(ועד\"ז החילוק שבין ב' הדרגות שבתחיית המתים גופא),"
        },
        {
          "s": 3,
          "text": "יובן בהקדים ביאור המעלה דימות המשיח לגבי ג\"ע31."
        },
        {
          "s": 4,
          "text": "שהגילוי דג\"ע הוא דוקא לנשמות בלא גופים,"
        },
        {
          "s": 5,
          "text": "והגילוי דימות המשיח יהי' גם למטה בעוה\"ז הגשמי"
        },
        {
          "s": 6,
          "text": "(וכמו עתידה ארץ ישראל שתוציא גלוסקאות32)."
        },
        {
          "s": 7,
          "text": "והטעם לזה הוא,"
        },
        {
          "s": 8,
          "text": "כי בג\"ע הוא הגילוי דאור הממלא,"
        },
        {
          "s": 9,
          "text": "אור מוגבל,"
        },
        {
          "s": 10,
          "text": "ולכן אינו נמשך למטה,"
        },
        {
          "s": 11,
          "text": "משא\"כ בימות המשיח יהי' גילוי אוא\"ס הבלתי מוגבל,"
        },
        {
          "s": 12,
          "text": "ולכן יהי' הגילוי גם למטה."
        },
        {
          "s": 13,
          "text": "ועוד חילוק,"
        },
        {
          "s": 14,
          "text": "דבג\"ע יש בכללות שתי בחינות,"
        },
        {
          "s": 15,
          "text": "ג\"ע התחתון וג\"ע העליון,"
        },
        {
          "s": 16,
          "text": "ובכל א' מהם יש ריבוי מדריגות עד אין קץ33,"
        },
        {
          "s": 17,
          "text": "כמרז\"ל34"
        },
        {
          "s": 18,
          "text": "ת\"ח אין להם מנוחה כו' ילכו מחיל אל חיל35,"
        },
        {
          "s": 19,
          "text": "שעולים תמיד ממדריגה למדריגה."
        },
        {
          "s": 20,
          "text": "ופירוש אין להם מנוחה הוא שעלייתם ממדריגה למדריגה היא ע\"י עבודה."
        },
        {
          "s": 21,
          "text": "דבעלי' צ\"ל מקודם טבילה בנהר דינור לשכוח ההשגה והתענוג דמדריגה התחתונה36,"
        },
        {
          "s": 22,
          "text": "וגם העלי' עצמה היא דרך העמוד37"
        },
        {
          "s": 23,
          "text": "שבין מדריגה למדריגה,"
        },
        {
          "s": 24,
          "text": "שגם עי\"ז הוא מתבטל מהשגתו הקודמת,"
        },
        {
          "s": 25,
          "text": "אלא שהביטול שע\"י הטבילה בנהר דינור הוא הביטול שמצד התחתון והביטול שע\"י העמוד הוא שמתבטל מצד גילוי אור של מדריגה העליונה שמאיר עליו38."
        },
        {
          "s": 26,
          "text": "וזהו שהעלי' ממדריגה למדריגה היא ע\"י עבודה"
        },
        {
          "s": 27,
          "text": "(אין להם מנוחה),"
        },
        {
          "s": 28,
          "text": "עבודת הביטול,"
        },
        {
          "s": 29,
          "text": "בדוגמת העבודה למטה בעוה\"ז,"
        },
        {
          "s": 30,
          "text": "שכללותה היא לצרף את הבריות39,"
        },
        {
          "s": 31,
          "text": "זיכוך וביטול,"
        },
        {
          "s": 32,
          "text": "עבודה מלשון עיבוד עורות40."
        },
        {
          "s": 33,
          "text": "ויש להוסיף,"
        },
        {
          "s": 34,
          "text": "דכמו שהעבודה למטה היא בשני קוין,"
        },
        {
          "s": 35,
          "text": "סור מרע ועשה טוב,"
        },
        {
          "s": 36,
          "text": "עד\"ז הוא גם בהביטול שבהעליות דג\"ע,"
        },
        {
          "s": 37,
          "text": "שהוא בשני קוין אלו."
        },
        {
          "s": 38,
          "text": "הביטול שע\"י נהר דינור – דוגמת העבודה דסור מרע כביכול,"
        },
        {
          "s": 39,
          "text": "והביטול שע\"י העמוד,"
        },
        {
          "s": 40,
          "text": "שמצד גילוי אור העליון – דוגמת העבודה דועשה טוב."
        },
        {
          "s": 41,
          "text": "דכל זה הוא בגן עדן."
        },
        {
          "s": 42,
          "text": "משא\"כ בהגילוי שיהי' בימות המשיח,"
        },
        {
          "s": 43,
          "text": "הגם שגם אז יהיו כו\"כ עליות,"
        },
        {
          "s": 44,
          "text": "העליות שיהיו אז לא יהיו באופן דילכו מחיל אל חיל,"
        },
        {
          "s": 45,
          "text": "שבכדי להגיע למדריגה נעלית יותר צריך ללכת"
        },
        {
          "s": 46,
          "text": "(לצאת ולהתבטל)"
        },
        {
          "s": 47,
          "text": "ממדריגה הקודמת,"
        },
        {
          "s": 48,
          "text": "אלא שגם בהיותו במדריגתו הקודמת יכול להתעלות למדריגה העליונה"
        },
        {
          "s": 49,
          "text": "(עצ\"ע)."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 2,
          "text": "שההמשכה דאור הממלא להחיות ולהוות את הנבראים היא באופן דהשתלשלות מלמעלה למטה."
        },
        {
          "s": 3,
          "text": "שבתחילה הוא מתלבש בנבראים הרוחניים,"
        },
        {
          "s": 4,
          "text": "ואח\"כ הוא מתלבש בנבראים שלמטה מהם,"
        },
        {
          "s": 5,
          "text": "שהם רק כמו משל לנבראים העליונים,"
        },
        {
          "s": 6,
          "text": "ואח\"כ מתלבש למטה יותר41,"
        },
        {
          "s": 7,
          "text": "וכמו שידוע בענין וידבר שלשת אלפים משל42."
        },
        {
          "s": 8,
          "text": "ויש לומר,"
        },
        {
          "s": 9,
          "text": "דזהו הטעם שהעלי' בג\"ע"
        },
        {
          "s": 10,
          "text": "(שבג\"ע הוא הגילוי דאור הממלא,"
        },
        {
          "s": 11,
          "text": "כנ\"ל)"
        },
        {
          "s": 12,
          "text": "ממדריגה למדריגה היא ע\"י שמתבטל ממדריגה התחתונה,"
        },
        {
          "s": 13,
          "text": "כי כמו שההמשכה מלמעלה למטה היא ע\"י שמתלבש בעוד לבוש ובעוד לבוש,"
        },
        {
          "s": 14,
          "text": "עד\"ז הוא בהעלי' מלמטה למעלה,"
        },
        {
          "s": 15,
          "text": "שהעלי' היא ע\"י הפשטת הלבוש,"
        },
        {
          "s": 16,
          "text": "ביטול מדריגה הקודמת43."
        },
        {
          "s": 17,
          "text": "[ויש לומר,"
        },
        {
          "s": 18,
          "text": "דזהו ג\"כ מה שמובא בכמה דרושים44"
        },
        {
          "s": 19,
          "text": "שגם האבות ומשה רבינו שיושבין בג\"ע העליון יותר מג' אלפים שנה יבואו להתלבש בגופים,"
        },
        {
          "s": 20,
          "text": "כי הגילוי שיהי' בתחיית המתים הוא נעלה הרבה יותר מהגילוי שמאיר בג\"ע,"
        },
        {
          "s": 21,
          "text": "אפילו בג\"ע העליון."
        },
        {
          "s": 22,
          "text": "דזה שמדייקים \"שיושבין בג\"ע העליון יותר מג' אלפים שנה\","
        },
        {
          "s": 23,
          "text": "יש לומר,"
        },
        {
          "s": 24,
          "text": "דג' אלפים שנה הם דוגמת שלשת אלפים משל,"
        },
        {
          "s": 25,
          "text": "שהם כנגד ג' עולמות בי\"ע,"
        },
        {
          "s": 26,
          "text": "דבכל עולם יש אלף מדריגות."
        },
        {
          "s": 27,
          "text": "וזהו שמדייקים \"שיושבין בג\"ע העליון יותר מג' אלפים שנה\","
        },
        {
          "s": 28,
          "text": "דבמשך ג' אלפים שנה מפשיטים כל הלבושים"
        },
        {
          "s": 29,
          "text": "(המשלים)"
        },
        {
          "s": 30,
          "text": "דג' עולמות בי\"ע,"
        },
        {
          "s": 31,
          "text": "וכשיושבים בג\"ע יותר מג' אלפים שנה מתעלים גם באצילות וכו',"
        },
        {
          "s": 32,
          "text": "ואעפ\"כ יבואו להתלבש בגופים,"
        },
        {
          "s": 33,
          "text": "כי הגילוי דתחיית המתים הוא למעלה יותר מהגילוי דג\"ע,"
        },
        {
          "s": 34,
          "text": "גם כשהגילוי דג\"ע הוא לאחרי שמפשיטים כל הלבושים]."
        },
        {
          "s": 35,
          "text": "משא\"כ העליות שיהיו בימות המשיח יהיו באופן שלא יצטרך לצאת ממצבו ומדריגתו,"
        },
        {
          "s": 36,
          "text": "מכיון שאז יהי' הגילוי דאוא\"ס הבל\"ג,"
        },
        {
          "s": 37,
          "text": "והגילוי יהי' גם למטה."
        }
      ]
    }
  ]
}