{
  "globalIndex": 846,
  "owner": 46,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918788_theRebbe_204__p001",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918788_theRebbe_204__p001",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918788_theRebbe_204",
  "title": "מאמר אתה הראת לדעת תשמ\"ו",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "יום ב' דחג השבועות,"
        },
        {
          "s": 2,
          "text": "ה'תשמ\"ו*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "אתה1 הראת לדעת כי ה' הוא האלקים אין עוד מלבדו,"
        },
        {
          "s": 1,
          "text": "כתוב במשנה תורה"
        },
        {
          "s": 2,
          "text": "(שמשה מפי עצמו אמרה2),"
        },
        {
          "s": 3,
          "text": "ומבאר רבינו הזקן בספר התניא3"
        },
        {
          "s": 4,
          "text": "דענין זה הי' בשעת מתן תורה,"
        },
        {
          "s": 5,
          "text": "דאז הי' הגילוי דאתה הראת לדעת גו',"
        },
        {
          "s": 6,
          "text": "כתורת אדמו\"ר הזקן4"
        },
        {
          "s": 7,
          "text": "אתה דו עצמות א\"ס ב\"ה הראת דו האָסט זיך באַוויזן לדעת אַז מען זאָל דיך וויסן,"
        },
        {
          "s": 8,
          "text": "כי הוי' הוא האלקים אין עוד מלבדו,"
        },
        {
          "s": 9,
          "text": "שהם5"
        },
        {
          "s": 10,
          "text": "ב' אופני ועניני השגה בהשגות אלקות,"
        },
        {
          "s": 11,
          "text": "הא' הוא ההשגה דהוי' ואלקים כולא חד והב' הוא ההשגה דאין עוד מלבדו."
        },
        {
          "s": 12,
          "text": "ובזה מבאר בתניא שם,"
        },
        {
          "s": 13,
          "text": "שבשעת מ\"ת הי' גילוי זה"
        },
        {
          "s": 14,
          "text": "(דעצומ\"ה וכו')"
        },
        {
          "s": 15,
          "text": "באופן דהראת"
        },
        {
          "s": 16,
          "text": "(ומוסיף)"
        },
        {
          "s": 17,
          "text": "ממש בראי' חושיית."
        },
        {
          "s": 18,
          "text": "וממשיך בתניא שם,"
        },
        {
          "s": 19,
          "text": "דלכן היו"
        },
        {
          "s": 20,
          "text": "(ישראל)"
        },
        {
          "s": 21,
          "text": "בטלים במציאות ממש כמארז\"ל"
        },
        {
          "s": 22,
          "text": "(בגמרא6)"
        },
        {
          "s": 23,
          "text": "שעל כל דיבור ודיבור פרחה נשמתן כו' והחזירה הקב\"ה להן בטל שעתיד להחיות בו את המתים,"
        },
        {
          "s": 24,
          "text": "וכדאיתא בגמרא שם שזהו מה שאמר דוד המלך7"
        },
        {
          "s": 25,
          "text": "(בעל ההילולא דחג השבועות8)"
        },
        {
          "s": 26,
          "text": "גשם נדבות תניף אלקים נחלתך ונלאה אתה כוננתה,"
        },
        {
          "s": 27,
          "text": "דקאי על טל תחי' שהחי' בו את ישראל,"
        },
        {
          "s": 28,
          "text": "ומבאר בתניא שם,"
        },
        {
          "s": 29,
          "text": "דטל זה הוא טל תורה כו' כמארז\"ל9"
        },
        {
          "s": 30,
          "text": "כל העוסק בתורה טל תורה מחייהו כו'."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה ידוע ביאור מורנו הבעל שם טוב10"
        },
        {
          "s": 2,
          "text": "(בעל ההילולא דחג השבועות11),"
        },
        {
          "s": 3,
          "text": "דכל ענין שבעולם הוא הוראה בעבודת האדם לקונו."
        },
        {
          "s": 4,
          "text": "וכ\"ש וק\"ו כל ענין שבתורה,"
        },
        {
          "s": 5,
          "text": "כמ\"ש12"
        },
        {
          "s": 6,
          "text": "ויצוונו ה' לעשות את כל החוקים האלה ליראה את ה' אלקינו גו',"
        },
        {
          "s": 7,
          "text": "דמפסוק זה מוכח,"
        },
        {
          "s": 8,
          "text": "שכל התורה כולה"
        },
        {
          "s": 9,
          "text": "(כל החוקים האלה)"
        },
        {
          "s": 10,
          "text": "ענינה הוא הוראה בעבודת ה',"
        },
        {
          "s": 11,
          "text": "ליראה את ה\"א גו',"
        },
        {
          "s": 12,
          "text": "עד לקיום המצוות בפשטות."
        },
        {
          "s": 13,
          "text": "ומזה מובן,"
        },
        {
          "s": 14,
          "text": "דגם ענין זה שבתורה,"
        },
        {
          "s": 15,
          "text": "זה שעל כל דיבור ודיבור פרחה נשמתן והחזירה להן בטל כו',"
        },
        {
          "s": 16,
          "text": "הוא הוראה בעבודת האדם לקונו."
        },
        {
          "s": 17,
          "text": "ועוד זאת,"
        },
        {
          "s": 18,
          "text": "דהנה מבאר מורנו הבעש\"ט בכתר שם טוב13"
        },
        {
          "s": 19,
          "text": "במאמר רז\"ל14"
        },
        {
          "s": 20,
          "text": "דע מה למעלה ממך,"
        },
        {
          "s": 21,
          "text": "ר\"ל ממך תדע,"
        },
        {
          "s": 22,
          "text": "איזה מדה שנתעורר בך כך הוא למעלה"
        },
        {
          "s": 23,
          "text": "[ובמ\"א15"
        },
        {
          "s": 24,
          "text": "הובא ע\"ד זה בשם הרב המגיד,"
        },
        {
          "s": 25,
          "text": "ובמקום שלישי16"
        },
        {
          "s": 26,
          "text": "הובא בשם רבינו הזקן,"
        },
        {
          "s": 27,
          "text": "ויש שינויי לשונות ביניהם,"
        },
        {
          "s": 28,
          "text": "ואכ\"מ]."
        },
        {
          "s": 29,
          "text": "ומזה מובן,"
        },
        {
          "s": 30,
          "text": "דכשהאדם רואה ויודע בעצמו"
        },
        {
          "s": 31,
          "text": "(ממך)"
        },
        {
          "s": 32,
          "text": "שאצלו הוא זמן מתן תורתנו"
        },
        {
          "s": 33,
          "text": "(מכיון שכך מפורש בתורת אמת ותורת חיים),"
        },
        {
          "s": 34,
          "text": "הרי מובן מזה,"
        },
        {
          "s": 35,
          "text": "שכן הוא גם למעלה,"
        },
        {
          "s": 36,
          "text": "שלמעלה הוא זמן מתן תורתנו."
        },
        {
          "s": 37,
          "text": "והיינו,"
        },
        {
          "s": 38,
          "text": "שבזמן מתן תורתנו נעשה אתה הראת לדעת כי ה' הוא האלקים אין עוד מלבדו,"
        },
        {
          "s": 39,
          "text": "דו עצמות א\"ס ב\"ה האָסט זיך באַוויזן כו',"
        },
        {
          "s": 40,
          "text": "הראת ממש בראי' חושיית,"
        },
        {
          "s": 41,
          "text": "ויחד עם זה נמשך בישראל גם הטל שעתיד להחיות בו את המתים והוא טל תורה."
        },
        {
          "s": 42,
          "text": "וענין זה נמשך בכל עניני האדם,"
        },
        {
          "s": 43,
          "text": "(ע\"ד מ\"ש17"
        },
        {
          "s": 44,
          "text": "זאת התורה אדם),"
        },
        {
          "s": 45,
          "text": "שהתורה"
        },
        {
          "s": 46,
          "text": "(גם בחי' טל תורה)"
        },
        {
          "s": 47,
          "text": "חודרת במציאותו של אדם עד שנעשית מציאותו האמיתית של כאו\"א מישראל,"
        },
        {
          "s": 48,
          "text": "כולל בכל דרכיך ובכל מעשיך18"
        },
        {
          "s": 49,
          "text": "(כמבואר במ\"א19"
        },
        {
          "s": 50,
          "text": "הענין בזה)."
        },
        {
          "s": 51,
          "text": "ומזה מובן עוד יותר,"
        },
        {
          "s": 52,
          "text": "שענין זה"
        },
        {
          "s": 53,
          "text": "(טל תורה)"
        },
        {
          "s": 54,
          "text": "נוגע בעבודת האדם בזמן הזה."
        }
      ]
    }
  ]
}