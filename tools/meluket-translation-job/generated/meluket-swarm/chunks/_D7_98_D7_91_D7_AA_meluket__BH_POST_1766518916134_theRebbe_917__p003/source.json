{
  "globalIndex": 414,
  "owner": 14,
  "jobId": "_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916134_theRebbe_917__p003",
  "batchId": "meluket-_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916134_theRebbe_917__p003",
  "seriesId": "טבת_meluket",
  "postId": "BH_POST_1766518916134_theRebbe_917",
  "title": "מאמר ויגש אליו יהודה תשכ\"ה",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה מבואר בדרושים הנ\"ל28,"
        },
        {
          "s": 2,
          "text": "שתורה ותפלה הם דוגמת שני הענינים דלמעלה מעלה עד אין קץ ולמטה מטה עד אין תכלית."
        },
        {
          "s": 3,
          "text": "דתורה שהיא המשכה מלמעלה למטה,"
        },
        {
          "s": 4,
          "text": "היא דוגמת הענין דלמטה עד אין תכלית,"
        },
        {
          "s": 5,
          "text": "ותפלה שהיא העלאה מלמטה למעלה היא דוגמת הענין דלמעלה עד אין קץ."
        },
        {
          "s": 6,
          "text": "וע\"פ הידוע29"
        },
        {
          "s": 7,
          "text": "דזה שאוא\"ס הוא למטה עד אין תכלית"
        },
        {
          "s": 8,
          "text": "(השרש דתורה)"
        },
        {
          "s": 9,
          "text": "הוא ענין ההתפשטות והגילוי,"
        },
        {
          "s": 10,
          "text": "שהוא מתפשט ומתגלה למטה מטה עד אין תכלית,"
        },
        {
          "s": 11,
          "text": "וזה שאוא\"ס הוא למעלה עד אין קץ הוא כמו שמתעלה ונכלל בעצמותו למעלה מעלה עד אין קץ,"
        },
        {
          "s": 12,
          "text": "מובן,"
        },
        {
          "s": 13,
          "text": "שתפלה היא למעלה מתורה."
        },
        {
          "s": 14,
          "text": "והבקשה אד' שפתי תפתח ופי יגיד תהלתך היא,"
        },
        {
          "s": 15,
          "text": "שבהתפלה שהיא מלמטה למעלה תהי' גם המעלה דתורה,"
        },
        {
          "s": 16,
          "text": "מלמעלה למטה."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "והענין הוא,"
        },
        {
          "s": 1,
          "text": "דתפלה היא שהאדם מבקש ומתפלל,"
        },
        {
          "s": 2,
          "text": "וגם ההמשכה שע\"י התפלה,"
        },
        {
          "s": 3,
          "text": "זה שהקב\"ה ממלא את בקשתו,"
        },
        {
          "s": 4,
          "text": "היא מצד המעלה דעבודת המטה,"
        },
        {
          "s": 5,
          "text": "למעשה ידיך תכסוף30."
        },
        {
          "s": 6,
          "text": "ויש לומר,"
        },
        {
          "s": 7,
          "text": "דמהטעמים על זה שצריך לעמוד בתפלה כעבד לפני רבו באימה ביראה ובפחד31,"
        },
        {
          "s": 8,
          "text": "הוא,"
        },
        {
          "s": 9,
          "text": "כי זה שעבודת המטה"
        },
        {
          "s": 10,
          "text": "(תפלה)"
        },
        {
          "s": 11,
          "text": "מעוררת למעלה את הרצון למלאות את בקשתו הוא"
        },
        {
          "s": 12,
          "text": "(בעיקר)"
        },
        {
          "s": 13,
          "text": "לפי שבעבודת המטה ישנה המעלה דביטול היש32,"
        },
        {
          "s": 14,
          "text": "ולכן,"
        },
        {
          "s": 15,
          "text": "כל שהתפלה היא בביטול גדול יותר,"
        },
        {
          "s": 16,
          "text": "היא מעוררת יותר למעלה למלאות את בקשתו33."
        },
        {
          "s": 17,
          "text": "וזהו שתפלה היא העלאה מלמטה למעלה,"
        },
        {
          "s": 18,
          "text": "כי הבקשה דתפלה היא בביטול"
        },
        {
          "s": 19,
          "text": "(באופן דעבד המבקש),"
        },
        {
          "s": 20,
          "text": "דענין הביטול הוא שיוצא ממציאותו,"
        },
        {
          "s": 21,
          "text": "העלאה מלמטה למעלה."
        },
        {
          "s": 22,
          "text": "ותורה היא דבר השם"
        },
        {
          "s": 23,
          "text": "[שישנו גם לפני עסק התורה דהאדם],"
        },
        {
          "s": 24,
          "text": "והפעולה שנעשית ע\"י עסק התורה דהאדם היא שהתורה ואוא\"ס המלובש בה נמשכים להאדם."
        },
        {
          "s": 25,
          "text": "ויתירה מזו,"
        },
        {
          "s": 26,
          "text": "שגם המשכת התורה ואוא\"ס המלובש בה בהאדם העוסק בתורה,"
        },
        {
          "s": 27,
          "text": "הוא"
        },
        {
          "s": 28,
          "text": "(לא ע\"י שהאדם מבטל את שכלו,"
        },
        {
          "s": 29,
          "text": "אלא אדרבה)"
        },
        {
          "s": 30,
          "text": "שהתורה נמשכת ומתלבשת בשכלו של האדם כמו שהוא במציאותו,"
        },
        {
          "s": 31,
          "text": "המשכה מלמעלה למטה."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דכמו שבתורה,"
        },
        {
          "s": 2,
          "text": "השייכות שלה להענין דלמטה עד אין תכלית היא לזה שאוא\"ס הוא למטה עד אין תכלית,"
        },
        {
          "s": 3,
          "text": "שהתורה שהיא חכמתו ורצונו של הקב\"ה נמשכת למטה מטה,"
        },
        {
          "s": 4,
          "text": "כמו\"כ הוא בתפלה,"
        },
        {
          "s": 5,
          "text": "שהשייכות דתפלה להענין דלמעלה עד אין קץ היא"
        },
        {
          "s": 6,
          "text": "(לא רק מפני שהתפלה היא העלאה דהאדם,"
        },
        {
          "s": 7,
          "text": "אלא גם)"
        },
        {
          "s": 8,
          "text": "לזה שאוא\"ס הוא למעלה עד אין קץ."
        },
        {
          "s": 9,
          "text": "דזה שע\"י התפלה מתעורר רצון חדש למלאות בקשת המתפלל"
        },
        {
          "s": 10,
          "text": "[גם כשע\"פ חכמת התורה אינו ראוי לזה]34"
        },
        {
          "s": 11,
          "text": "הוא לפי שע\"י התפלה נעשה עלי' בהאור שלמעלה,"
        },
        {
          "s": 12,
          "text": "שהוא מתעלה למעלה מהשתלשלות,"
        },
        {
          "s": 13,
          "text": "ולמעלה גם מהתורה34,"
        },
        {
          "s": 14,
          "text": "עד למעלה מעלה עד אין קץ,"
        },
        {
          "s": 15,
          "text": "ומשם נמשך הרצון חדש למלאות את בקשתו."
        },
        {
          "s": 16,
          "text": "אלא שאעפ\"כ יש יתרון בההמשכה דתורה לגבי ההמשכה שע\"י תפלה."
        },
        {
          "s": 17,
          "text": "דההמשכה שע\"י התפלה,"
        },
        {
          "s": 18,
          "text": "כיון שתפלה היא עבודת המטה,"
        },
        {
          "s": 19,
          "text": "לכן גם ההמשכה מלמעלה שע\"י התפלה היא בנוגע לעניני העולם"
        },
        {
          "s": 20,
          "text": "(מילוי בקשת המתפלל),"
        },
        {
          "s": 21,
          "text": "אלא ששורש ההמשכה היא מלמעלה מעלה עד אין קץ."
        },
        {
          "s": 22,
          "text": "וההמשכה דתורה,"
        },
        {
          "s": 23,
          "text": "שהיא המשכה מלמעלה מצד עצמה,"
        },
        {
          "s": 24,
          "text": "היא המשכת אלקות."
        },
        {
          "s": 25,
          "text": "שגם לאחרי שהתורה ירדה למטה ונתלבשה בשכל אנושי היא חכמתו של הקב\"ה שלמעלה משכל הנבראים."
        }
      ]
    }
  ]
}