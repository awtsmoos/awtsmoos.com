{
  "globalIndex": 996,
  "owner": 46,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919710_theRebbe_549__p001",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919710_theRebbe_549__p001",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919710_theRebbe_549",
  "title": "מאמר ציון במשפט תפדה תשל\"ו",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ דברים,"
        },
        {
          "s": 2,
          "text": "שבת חזון,"
        },
        {
          "s": 3,
          "text": "ד' מנחם-אב ה'תשל\"ו*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "ציון במשפט תפדה ושבי' בצדקה1,"
        },
        {
          "s": 1,
          "text": "ומביא אדמו\"ר הזקן בלקו\"ת ד\"ה זה2"
        },
        {
          "s": 2,
          "text": "בתחלתו מ\"ש3"
        },
        {
          "s": 3,
          "text": "והיו הדברים האלה אשר אנכי מצוך היום,"
        },
        {
          "s": 4,
          "text": "שזה קאי על כל יום,"
        },
        {
          "s": 5,
          "text": "כי בכל יום יהיו בעיניך כחדשים4."
        },
        {
          "s": 6,
          "text": "ומבאר5,"
        },
        {
          "s": 7,
          "text": "שבכדי לבוא לזה"
        },
        {
          "s": 8,
          "text": "(שבכל יום יהיו בעיניך כחדשים),"
        },
        {
          "s": 9,
          "text": "הוא ע\"י ההתבוננות בפסוק זה גופא – והיו הדברים האלה אשר אנכי מצוך היום."
        },
        {
          "s": 10,
          "text": "דהתהוות כל העולמות היא ממדת המלכות שהיא רק הארה בלבד,"
        },
        {
          "s": 11,
          "text": "וע\"י קיום המצוות בעוה\"ז הוא המשכת העצמות."
        },
        {
          "s": 12,
          "text": "דזהו אשר אנכי מצוך היום,"
        },
        {
          "s": 13,
          "text": "אנכי מי שאנכי6."
        },
        {
          "s": 14,
          "text": "ולכן יפה שעה אחת בתשובה ומעשים טובים בעולם הזה מכל חיי העולם הבא7,"
        },
        {
          "s": 15,
          "text": "כי עולם הבא הוא שנהנין מזיו השכינה8,"
        },
        {
          "s": 16,
          "text": "זיו בלבד,"
        },
        {
          "s": 17,
          "text": "וע\"י תשובה ומעשים טובים בעוה\"ז הוא המשכת העצמות9."
        },
        {
          "s": 18,
          "text": "וזהו אשר אנכי מצוך היום,"
        },
        {
          "s": 19,
          "text": "היום דוקא,"
        },
        {
          "s": 20,
          "text": "היום לעשותם ולמחר לקבל שכרם10,"
        },
        {
          "s": 21,
          "text": "דשכר המצוות שבעוה\"ב"
        },
        {
          "s": 22,
          "text": "(למחר)"
        },
        {
          "s": 23,
          "text": "הוא רק זיו,"
        },
        {
          "s": 24,
          "text": "וע\"י קיום המצוות בעוה\"ז,"
        },
        {
          "s": 25,
          "text": "היום לעשותם,"
        },
        {
          "s": 26,
          "text": "ממשיכים העצמות."
        },
        {
          "s": 27,
          "text": "וע\"י ההתבוננות בהענין דאנכי מצוך היום,"
        },
        {
          "s": 28,
          "text": "שע\"י קיום המצוות היום"
        },
        {
          "s": 29,
          "text": "(בעוה\"ז)"
        },
        {
          "s": 30,
          "text": "נמשך העצמות"
        },
        {
          "s": 31,
          "text": "(אנכי),"
        },
        {
          "s": 32,
          "text": "עי\"ז יהיו אצלו המצוות באופן דהיום,"
        },
        {
          "s": 33,
          "text": "שבכל יום יהיו בעיניו כחדשים ממש."
        },
        {
          "s": 34,
          "text": "וממשיך בהמאמר11,"
        },
        {
          "s": 35,
          "text": "דכל זה הוא כפי שצריך להיות,"
        },
        {
          "s": 36,
          "text": "אבל כשאינו כן,"
        },
        {
          "s": 37,
          "text": "והמרירות והשמחה שלו הם מעניני עוה\"ז,"
        },
        {
          "s": 38,
          "text": "אזי,"
        },
        {
          "s": 39,
          "text": "הניצוץ אלקי שבו הוא בגלות בנפשו הבהמית,"
        },
        {
          "s": 40,
          "text": "כרחל לפני גוזזי' נאלמה12,"
        },
        {
          "s": 41,
          "text": "ועל זה כתיב ציון במשפט תפדה גו'"
        },
        {
          "s": 42,
          "text": "(כדלקמן סעיף ט)."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "וצריך להבין,"
        },
        {
          "s": 1,
          "text": "דלכאורה,"
        },
        {
          "s": 2,
          "text": "גם כשהמצוות הם כמו דיוטגמא ישנה13"
        },
        {
          "s": 3,
          "text": "בעיניו,"
        },
        {
          "s": 4,
          "text": "אפשר שיקיים אותם בחיות14,"
        },
        {
          "s": 5,
          "text": "ועד,"
        },
        {
          "s": 6,
          "text": "שזה"
        },
        {
          "s": 7,
          "text": "(קיום התומ\"צ)"
        },
        {
          "s": 8,
          "text": "יהי' אצלו העיקר."
        },
        {
          "s": 9,
          "text": "וממ\"ש בהמאמר אבל כשאינו כן כו',"
        },
        {
          "s": 10,
          "text": "משמע לכאורה15"
        },
        {
          "s": 11,
          "text": "דכאשר המצוות אינם כחדשים בעיניו אז ודאי שהמרירות והשמחה שלו הם מעניני עוה\"ז."
        },
        {
          "s": 12,
          "text": "וגם צריך להבין מ\"ש בהמאמר שבכדי לבוא לבכל יום יהיו בעיניך כחדשים הוא ע\"י ההתבוננות בהענין דאנכי מצוך היום,"
        },
        {
          "s": 13,
          "text": "שע\"י קיום המצוות בעוה\"ז"
        },
        {
          "s": 14,
          "text": "(היום)"
        },
        {
          "s": 15,
          "text": "הוא המשכת העצמות"
        },
        {
          "s": 16,
          "text": "(אנכי),"
        },
        {
          "s": 17,
          "text": "שהוא נעלה הרבה יותר משכר המצוות בעוה\"ב שהוא רק זיו,"
        },
        {
          "s": 18,
          "text": "דלכאורה,"
        },
        {
          "s": 19,
          "text": "מכיון שההנאה"
        },
        {
          "s": 20,
          "text": "(והתענוג)"
        },
        {
          "s": 21,
          "text": "מזיו השכינה בעוה\"ב הוא תענוג גדול ביותר16"
        },
        {
          "s": 22,
          "text": "[ובפרט שהכוונה בעוה\"ב כאן היא לא רק לג\"ע אלא גם לעולם התחי'17,"
        },
        {
          "s": 23,
          "text": "שהגילוי שיהי' בעולם התחי' הוא נעלה הרבה יותר מהגילוי דג\"ע18],"
        },
        {
          "s": 24,
          "text": "הרי גם ע\"י ההתבוננות בהעילוי דשכר המצוות"
        },
        {
          "s": 25,
          "text": "(בעוה\"ב)"
        },
        {
          "s": 26,
          "text": "יהי' לו חיות גדול בקיום המצוות,"
        },
        {
          "s": 27,
          "text": "ובהמאמר אומר,"
        },
        {
          "s": 28,
          "text": "שבכדי שהמצוות יהיו בעיניו כחדשים ולא כדיוטגמא ישנה צ\"ל ההתבוננות דוקא בהענין דאנכי מצוך היום,"
        },
        {
          "s": 29,
          "text": "המעלה דהיום לעשותם שלמעלה מלמחר לקבל שכרם."
        }
      ]
    }
  ]
}