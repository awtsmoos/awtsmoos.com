{
  "globalIndex": 668,
  "owner": 18,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917720_theRebbe_340__p002",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917720_theRebbe_340__p002",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917720_theRebbe_340",
  "title": "מאמר ויקרא אל משה תשל\"ב",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 2,
          "text": "דזה שבהתחלת ספר הקרבנות כתיב אדם כי יקריב,"
        },
        {
          "s": 3,
          "text": "דזה שישראל נק' אדם הוא משום דואתם הדבקים גו',"
        },
        {
          "s": 4,
          "text": "שהוא הדביקות דאורות,"
        },
        {
          "s": 5,
          "text": "הוא,"
        },
        {
          "s": 6,
          "text": "כי הכח שיש בישראל להקריב קרבנות הוא"
        },
        {
          "s": 7,
          "text": "(בעיקר)"
        },
        {
          "s": 8,
          "text": "לפי שדביקותם בהקב\"ה היא בדרגת הדביקות דאורות."
        },
        {
          "s": 9,
          "text": "וזה שאיתא במדרש דהקרבת קרבנות קשורה עם דרגת הדביקות"
        },
        {
          "s": 10,
          "text": "(דאזור)"
        },
        {
          "s": 11,
          "text": "דכלים,"
        },
        {
          "s": 12,
          "text": "יש לומר,"
        },
        {
          "s": 13,
          "text": "כי עיקר הקרבנות הוא שעל ידם הוא קיום העולם,"
        },
        {
          "s": 14,
          "text": "[כדאיתא בירושלמי18"
        },
        {
          "s": 15,
          "text": "עה\"פ19"
        },
        {
          "s": 16,
          "text": "לנטוע שמים וליסוד ארץ אלו הקרבנות,"
        },
        {
          "s": 17,
          "text": "כי ע\"י הקרבנות מתקיימים חוקות שמים וארץ20],"
        },
        {
          "s": 18,
          "text": "אלא שהכח הזה שיש בקרבנות הוא ע\"י שהמקריב את הקרבנות הוא אדם"
        },
        {
          "s": 19,
          "text": "(שלמעלה מעולם),"
        },
        {
          "s": 20,
          "text": "כדאיתא בזהר21"
        },
        {
          "s": 21,
          "text": "דמ\"ש אדם כי יקריב"
        },
        {
          "s": 22,
          "text": "[שבד' השמות אדם גבר אנוש איש22,"
        },
        {
          "s": 23,
          "text": "שם אדם מורה על מדריגה הכי עליונה דכתיב23"
        },
        {
          "s": 24,
          "text": "ויברא אלקים את האדם בצלמו גו']"
        },
        {
          "s": 25,
          "text": "הוא לפי דקיומא דעלמין עילאין ותתאין הוא ע\"י הקרבנות."
        },
        {
          "s": 26,
          "text": "ולכן,"
        },
        {
          "s": 27,
          "text": "גם בעבודתו של אדם המקריב צ\"ל שני ענינים."
        },
        {
          "s": 28,
          "text": "דענין הקרבנות עצמם הוא ע\"י עבודת האדם בדרגת הכלים שבו."
        },
        {
          "s": 29,
          "text": "[דזה שהקרבנות הם קיומא דעלמא הוא ע\"י שיש בהם מכל הסוגים דצח\"מ דעולם,"
        },
        {
          "s": 30,
          "text": "הקרבנות עצמם שבאים מדצ\"ח,"
        },
        {
          "s": 31,
          "text": "והאדם המקריב24]."
        },
        {
          "s": 32,
          "text": "והכח בקרבנות לקיים העולם ע\"י שהמקריב אותם הוא אדם שמובדל מעולם,"
        },
        {
          "s": 33,
          "text": "הוא ע\"י עבודת האדם בדרגת האורות שבו."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "וזהו שענין אדם כי יקריב הוא דוקא בתחלת ספר הקרבנות,"
        },
        {
          "s": 1,
          "text": "כי הקרבנות עצמם הם מן הבהמה וגו',"
        },
        {
          "s": 2,
          "text": "שבזה נכללת גם הבהמה שבאדם,"
        },
        {
          "s": 3,
          "text": "נפש הבהמית25."
        },
        {
          "s": 4,
          "text": "וזה נעשה על ידי בחינת ב\"ן דנפש האלקית26,"
        },
        {
          "s": 5,
          "text": "ב\"ן בגימטריא בהמה27,"
        },
        {
          "s": 6,
          "text": "דבכללות הוא28"
        },
        {
          "s": 7,
          "text": "הנשמה כמו שהיא בדרגת כלים."
        },
        {
          "s": 8,
          "text": "אלא שהכח לזה הוא ע\"י בחינת מ\"ה דנפש האלקית,"
        },
        {
          "s": 9,
          "text": "מ\"ה בגימטריא אדם29,"
        },
        {
          "s": 10,
          "text": "דבכללות הוא28"
        },
        {
          "s": 11,
          "text": "דרגת האורות דהנשמה,"
        },
        {
          "s": 12,
          "text": "ולכן הפתיחה דספר הקרבנות הוא אדם כי יקריב."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה ידוע30"
        },
        {
          "s": 2,
          "text": "דתורה ומצוות הם דוגמת אורות וכלים."
        },
        {
          "s": 3,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 4,
          "text": "דשתי דרגות הנ\"ל בהדביקות דישראל בהקב\"ה,"
        },
        {
          "s": 5,
          "text": "נעשים ע\"י לימוד התורה וקיום המצוות."
        },
        {
          "s": 6,
          "text": "ע\"י קיום המצוות – הדביקות דכלים,"
        },
        {
          "s": 7,
          "text": "וע\"י עסק התורה – הדביקות דאורות."
        },
        {
          "s": 8,
          "text": "ועפ\"ז יש לקשר זה עם מה דאיתא בתיקוני זהר31,"
        },
        {
          "s": 9,
          "text": "שג' התפלות שחרית מנחה וערבית הם כנגד ארי' שור ונשר,"
        },
        {
          "s": 10,
          "text": "וענין אדם כי יקריב דא אורייתא."
        },
        {
          "s": 11,
          "text": "ובגין דא תקינו בצלותא למשמע בה ספר תורה,"
        },
        {
          "s": 12,
          "text": "למהוי בה קרבנא שלים באדם כו' זאת32"
        },
        {
          "s": 13,
          "text": "התורה אדם."
        },
        {
          "s": 14,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 15,
          "text": "דזה שתפלות הם כנגד קרבנות33"
        },
        {
          "s": 16,
          "text": "הוא כנגד הקרבנות עצמם"
        },
        {
          "s": 17,
          "text": "[דענין התפלה הוא בירור נפש הבהמית ע\"ד הקרבת הבהמה],"
        },
        {
          "s": 18,
          "text": "וענין אדם כי יקריב דא אורייתא הוא הכח דישראל להקריב קרבנות להיותם בחינת אדם,"
        },
        {
          "s": 19,
          "text": "דביקות דאורות שנעשית ע\"י עסק התורה."
        }
      ]
    }
  ]
}