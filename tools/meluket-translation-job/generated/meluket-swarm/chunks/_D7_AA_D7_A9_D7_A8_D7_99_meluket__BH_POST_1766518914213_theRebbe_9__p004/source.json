{
  "globalIndex": 91,
  "owner": 41,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914213_theRebbe_9__p004",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914213_theRebbe_9__p004",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914213_theRebbe_9",
  "title": "מאמר בסוכות תשבו תשל\"ח",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וע\"פ הנ\"ל יובן הביאור והנקודה שבכל הענינים האמורים."
        },
        {
          "s": 2,
          "text": "והענין הוא,"
        },
        {
          "s": 3,
          "text": "דהנה עבודת יום הכפורים בקה\"ק היא בהזמן הנק' בכתוב35"
        },
        {
          "s": 4,
          "text": "אחת בשנה."
        },
        {
          "s": 5,
          "text": "וכמו שבזמן הוא בחי' אחת שבזמן,"
        },
        {
          "s": 6,
          "text": "כן הוא גם בנפש ובעולם"
        },
        {
          "s": 7,
          "text": "(במקום)"
        },
        {
          "s": 8,
          "text": "שהיא בבחי' אחת בנפש ובמקום."
        },
        {
          "s": 9,
          "text": "שהעבודה נעשית ע\"י הכהן גדול שהוא המקודש ובחי' אחת שבעם ישראל,"
        },
        {
          "s": 10,
          "text": "וכמ\"ש36"
        },
        {
          "s": 11,
          "text": "ויבדל אהרן להקדישו קדש קדשים,"
        },
        {
          "s": 12,
          "text": "והעבודה היא בקה\"ק,"
        },
        {
          "s": 13,
          "text": "המקום המקודש מכל העולם כולו,"
        },
        {
          "s": 14,
          "text": "גם ממקום הקדש שבביהמ\"ק"
        },
        {
          "s": 15,
          "text": "(ההיכל)."
        },
        {
          "s": 16,
          "text": "והנה על ג' הענינים דעש\"ן מיוסד כל סדר ההשתלשלות כמו שנמשך משרשו ומקורו"
        },
        {
          "s": 17,
          "text": "[ולכן מיוסד ספר יצירה על ג' בחי' אלו],"
        },
        {
          "s": 18,
          "text": "עד לכמו שהבריאה היא מעצומ\"ה ית'."
        },
        {
          "s": 19,
          "text": "וכדאיתא באגה\"ק37"
        },
        {
          "s": 20,
          "text": "שמהותו ועצמותו של המאציל ב\"ה שמציאותו מעצמותו ואינו עלול מאיזה עילה שקדמה לו ח\"ו כו' הוא לבדו בכחו ויכלתו לברוא יש מאין ואפס המוחלט ממש."
        },
        {
          "s": 21,
          "text": "וזהו\"ע בחי' אחת בשנה,"
        },
        {
          "s": 22,
          "text": "בעולם"
        },
        {
          "s": 23,
          "text": "(מקום),"
        },
        {
          "s": 24,
          "text": "ובנפש,"
        },
        {
          "s": 25,
          "text": "שמתאחדות יחד בעבודת כהן גדול ביום הכפורים בקה\"ק,"
        },
        {
          "s": 26,
          "text": "בחי' עצומ\"ה ית' שנמשך בבחי' עש\"ן."
        },
        {
          "s": 27,
          "text": "ובחי' אחת נמשכת בגלוי אח\"כ בסוכות."
        },
        {
          "s": 28,
          "text": "דהנה מבואר במשנה38"
        },
        {
          "s": 29,
          "text": "בסדר עבודת יום הכפורים שהכהן גדול הי' ממתין בקה\"ק עד שהי' הבית מתמלא עשן,"
        },
        {
          "s": 30,
          "text": "ומעשן זה"
        },
        {
          "s": 31,
          "text": "(שמהעבודה דבחי' אחת)"
        },
        {
          "s": 32,
          "text": "נמשך סכך הסוכה בחג הסוכות39."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "והנה,"
        },
        {
          "s": 2,
          "text": "התחלת ההמשכה דבחי' אחת היא בראש השנה,"
        },
        {
          "s": 3,
          "text": "שאז היא העבודה דתמליכוני עליכם,"
        },
        {
          "s": 4,
          "text": "שממשיכים המלוכה מבחי' התנשאות עצמי,"
        },
        {
          "s": 5,
          "text": "דהיינו דכמו שהוא בבחי' עצמי יומשך בגלוי עד שיהי' תמליכוני עליכם,"
        },
        {
          "s": 6,
          "text": "וע\"י שממשיכים להיות מלך ישראל"
        },
        {
          "s": 7,
          "text": "(שתמליכוני עליכם)"
        },
        {
          "s": 8,
          "text": "נמשך אח\"כ להיות מלוך על כל העולם כולו בכבודך."
        },
        {
          "s": 9,
          "text": "ואופן המלוכה היא ברצון,"
        },
        {
          "s": 10,
          "text": "ולא רק שומלכותו בכל משלה."
        },
        {
          "s": 11,
          "text": "דממשלה אפשר להיות גם בהכרח בלא רצון,"
        },
        {
          "s": 12,
          "text": "אבל ישראל ע\"י עבודתם דומלכותו ברצון קבלו עליהם,"
        },
        {
          "s": 13,
          "text": "ממשיכים בכל המציאות כולה,"
        },
        {
          "s": 14,
          "text": "בכל סדר ההשתלשלות,"
        },
        {
          "s": 15,
          "text": "להיות בואו נשתחוה ונכרעה נברכה לפני הוי' עושינו40."
        },
        {
          "s": 16,
          "text": "ואח\"כ בעשור לחודש השביעי באה ההמשכה בבחי' פנימיות."
        },
        {
          "s": 17,
          "text": "ואח\"כ בחג הסוכות באה ההמשכה בגלוי."
        },
        {
          "s": 18,
          "text": "שהנצחון שהי' בראש השנה,"
        },
        {
          "s": 19,
          "text": "החל מהנצחון שממלך ישראל נמשך להיות ומלכותו בכל משלה,"
        },
        {
          "s": 20,
          "text": "ולמעלה יותר,"
        },
        {
          "s": 21,
          "text": "גם מלכותו ברצון קבלו עליהם,"
        },
        {
          "s": 22,
          "text": "הנה נמשך בגלוי עד שנמשך בגלוי גם בעולם וגם בהשבעים אומות,"
        },
        {
          "s": 23,
          "text": "דלכן מקריבים בחג הסוכות ע' פרים כנגד הע' אומות41."
        },
        {
          "s": 24,
          "text": "והנה המשכה זו נמשכת בגלוי"
        },
        {
          "s": 25,
          "text": "(בהד' ימים שבין יום הכפורים לסוכות)"
        },
        {
          "s": 26,
          "text": "תחלה בתורה ומצוותי' ע\"י לימוד הלכות סוכה וע\"י לימוד הלכות נטילת ד\"מ,"
        },
        {
          "s": 27,
          "text": "כי ע\"י הלימוד בזה אף שהוא בגלות,"
        },
        {
          "s": 28,
          "text": "ואפי' שאין שייך קיום כל הפרטים כולם,"
        },
        {
          "s": 29,
          "text": "הנה נעשה כמארז\"ל42"
        },
        {
          "s": 30,
          "text": "מעלה אני עליהם כאילו הם עסוקים כו'."
        },
        {
          "s": 31,
          "text": "וע\"י שפועל תחלה ההמשכה בגלוי בתורה,"
        },
        {
          "s": 32,
          "text": "ואח\"כ ממשיך זה גם במעשה ע\"י קיום המצוות"
        },
        {
          "s": 33,
          "text": "[אלא שזהו עדיין בחי' המעשה שבמצוות עצמן],"
        },
        {
          "s": 34,
          "text": "הנה נמשך אח\"כ בפועל גם בכל העולם כולו,"
        },
        {
          "s": 35,
          "text": "שכל העולם רואה איך שיהודי מקיים המצוה."
        },
        {
          "s": 36,
          "text": "ועד שנמשך באופן כזה,"
        },
        {
          "s": 37,
          "text": "שאיתא במדרש43"
        },
        {
          "s": 38,
          "text": "דאילו הי' אומות העולם יודעים מה הי' המקדש יפה להם קסטריות היו מקיפים אותו כדי לשמרו כו'."
        },
        {
          "s": 39,
          "text": "ופעולה זו דהמקדש על האומות היא בחג הסוכות באופן גלוי ע\"י הקרבת ע' פרים כנגד שבעים אומות,"
        },
        {
          "s": 40,
          "text": "כמבואר בארוכה במדרשי רז\"ל44."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "והנה,"
        },
        {
          "s": 2,
          "text": "ע\"פ הנ\"ל שענין הסוכה שייך לבחי' אחת בשנה,"
        },
        {
          "s": 3,
          "text": "ובעולם"
        },
        {
          "s": 4,
          "text": "(במקום)"
        },
        {
          "s": 5,
          "text": "ובנפש,"
        },
        {
          "s": 6,
          "text": "מובן ג\"כ מה שבנוגע לסוכות"
        },
        {
          "s": 7,
          "text": "(דוקא)"
        },
        {
          "s": 8,
          "text": "נאמר כל האזרח בישראל גו' ועד\"ז דרשו רז\"ל45"
        },
        {
          "s": 9,
          "text": "ראוים כל ישראל לישב בסוכה אחת,"
        },
        {
          "s": 10,
          "text": "כי המשכת בחי' אחת בגלוי היא בחג הסוכות."
        },
        {
          "s": 11,
          "text": "וביאור הענין יובן בהקדם מה שצלה\"ב בזה"
        },
        {
          "s": 12,
          "text": "[וכמבואר דיוק זה גם במאמרי רבותינו נשיאינו2],"
        },
        {
          "s": 13,
          "text": "מפני מה הלימוד הזה דכל ישראל ראוים לישב בסוכה אחת הוא דוקא מכל האזרח בישראל גו',"
        },
        {
          "s": 14,
          "text": "הלא גם מבסוכות תשבו יש ג\"כ ללמוד לימוד זה דתשבו כולכם יחד."
        },
        {
          "s": 15,
          "text": "וכללות הביאור בזה"
        },
        {
          "s": 16,
          "text": "(בל' הקבלה),"
        },
        {
          "s": 17,
          "text": "דהנה בתחלה"
        },
        {
          "s": 18,
          "text": "[היינו קודם הצמצום]"
        },
        {
          "s": 19,
          "text": "הי' אוא\"ס ממלא כל מקום החלל ולא הי' מקום לעמידת העולמות"
        },
        {
          "s": 20,
          "text": "[והיינו שלא הי' אפשריות ומציאות לעולמות],"
        },
        {
          "s": 21,
          "text": "ואח\"כ סילק אורו הגדול על הצד כו' ונמשך"
        },
        {
          "s": 22,
          "text": "(עיגול הגדול ו)"
        },
        {
          "s": 23,
          "text": "הקו,"
        },
        {
          "s": 24,
          "text": "וכל אריכות סדר ההשתלשלות,"
        },
        {
          "s": 25,
          "text": "כמבואר בע\"ח בתחלתו ובמבוא שערים בתחלתו"
        },
        {
          "s": 26,
          "text": "(כמובא בכ\"מ ונתבאר בחסידות)."
        },
        {
          "s": 27,
          "text": "והנה בחי' זו"
        },
        {
          "s": 28,
          "text": "(שהי' ממלא מקום החלל כו' לפני הצמצום)"
        },
        {
          "s": 29,
          "text": "נקראת כבר בשם אוא\"ס,"
        },
        {
          "s": 30,
          "text": "ועד שאפשר להיות שם איזה שייכות למציאות דעולמות,"
        },
        {
          "s": 31,
          "text": "אלא שכיון שהי' אוא\"ס ממלא כל מקום החלל משו\"ז לא הי' אפשרות למציאות העולמות."
        },
        {
          "s": 32,
          "text": "אבל גם שם הרי ישנו חלל,"
        },
        {
          "s": 33,
          "text": "וגם ישנה האפשריות שצריך לשלול ולומר שאאפ\"ל מציאות לעולמות."
        },
        {
          "s": 34,
          "text": "ולמעלה מזה הוא מה שארז\"ל46"
        },
        {
          "s": 35,
          "text": "עד שלא נבה\"ע הי' הוא ושמו בלבד."
        },
        {
          "s": 36,
          "text": "אמנם,"
        },
        {
          "s": 37,
          "text": "גם במדרגה זו"
        },
        {
          "s": 38,
          "text": "(כבר)"
        },
        {
          "s": 39,
          "text": "ישנם פרטים,"
        },
        {
          "s": 40,
          "text": "הוא,"
        },
        {
          "s": 41,
          "text": "ושמו,"
        },
        {
          "s": 42,
          "text": "ובלבד,"
        },
        {
          "s": 43,
          "text": "וגם אומרים שהחידוש שבמדרגה זו היא שהיא באופן דהי\"ה,"
        },
        {
          "s": 44,
          "text": "כמבואר בהמאמר שלפנ\"ז47."
        },
        {
          "s": 45,
          "text": "אמנם מהותו ועצמותו ית' הוא למעלה גם מזה,"
        },
        {
          "s": 46,
          "text": "ועד שאא\"פ לומר עליו שהוא בבחי' סובב"
        },
        {
          "s": 47,
          "text": "(לעולמות)"
        },
        {
          "s": 48,
          "text": "ואפי' גם לא בבחי' מקיף הרחוק וכיו\"ב."
        },
        {
          "s": 49,
          "text": "כי מהותו ועצמותו ית' אינו בגדר כל הענינים כלל,"
        },
        {
          "s": 50,
          "text": "עד שהוא בבחי' אין עוד מלבדו,"
        },
        {
          "s": 51,
          "text": "ולמעלה יותר,"
        },
        {
          "s": 52,
          "text": "דאין עוד."
        },
        {
          "s": 53,
          "text": "דהרי אין עוד מלבדו שייך לומר כשישנו גדר של לבדו,"
        },
        {
          "s": 54,
          "text": "אמנם למעלה מזה הו\"ע אין עוד,"
        },
        {
          "s": 55,
          "text": "כמבואר במקום אחר דיוק זה."
        },
        {
          "s": 56,
          "text": "והנה כיון שישראל מושרשים בעצומ\"ה ית',"
        },
        {
          "s": 57,
          "text": "מובן שיש להם שייכות ואפשר להם להגיע ולפעול בעצומ\"ה ית',"
        },
        {
          "s": 58,
          "text": "גם כמו שהוא למעלה בבחי' אי\"ע אפי' מבחי' הי' הוא ושמו בלבד."
        },
        {
          "s": 59,
          "text": "וזהו משארז\"ל48"
        },
        {
          "s": 60,
          "text": "במי נמלך בנשמותיהן של צדיקים,"
        },
        {
          "s": 61,
          "text": "שענין ההמלכה שייך לומר למעלה מעלה,"
        },
        {
          "s": 62,
          "text": "וגם בהבחי' שלמעלה מגדר מקום."
        },
        {
          "s": 63,
          "text": "כי מכיון שלמעלה כל הענינים הם ברצון ולא בהכרח ח\"ו,"
        },
        {
          "s": 64,
          "text": "מובן שגם במדרגה זו שייך ענין ההמלכה."
        },
        {
          "s": 65,
          "text": "ומזה מובן שענין ההמלכה היא כביכול גם בעצומ\"ה ית'."
        },
        {
          "s": 66,
          "text": "וע\"ז אומרים במי נמלך בנשמותיהן של צדיקים,"
        },
        {
          "s": 67,
          "text": "שזה קאי על נשמות ישראל,"
        },
        {
          "s": 68,
          "text": "ועמך כולם צדיקים49,"
        },
        {
          "s": 69,
          "text": "שמושרשים בעצומ\"ה ית' ולכן גם מגיעים לעצומ\"ה ית'."
        },
        {
          "s": 70,
          "text": "וענין ההמלכה היא גם בהנשמות הקטנות במדרגה לכאו',"
        },
        {
          "s": 71,
          "text": "כמובן ממשל הה\"מ נ\"ע50"
        },
        {
          "s": 72,
          "text": "שמדמה ענין זה לאב ובן קטן,"
        },
        {
          "s": 73,
          "text": "ומכיון שממשיל את הקב\"ה לאב,"
        },
        {
          "s": 74,
          "text": "כביכול,"
        },
        {
          "s": 75,
          "text": "מובן שגדול וקטן שוים לגבי'."
        },
        {
          "s": 76,
          "text": "שכל הענינים הם שלא בערך כלל לעצומ\"ה ית',"
        },
        {
          "s": 77,
          "text": "אלא שכך עלה ברצונו שנשמות ישראל,"
        },
        {
          "s": 78,
          "text": "ועמך כולם צדיקים,"
        },
        {
          "s": 79,
          "text": "יהיו מושרשים בעצומ\"ה אַליין,"
        },
        {
          "s": 80,
          "text": "ומשו\"ז מושרשים נשמות ישראל בעצומ\"ה ית'."
        }
      ]
    }
  ]
}