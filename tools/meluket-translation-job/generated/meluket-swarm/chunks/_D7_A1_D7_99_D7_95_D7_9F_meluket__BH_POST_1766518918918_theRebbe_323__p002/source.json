{
  "globalIndex": 871,
  "owner": 21,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918918_theRebbe_323__p002",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918918_theRebbe_323__p002",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918918_theRebbe_323",
  "title": "מאמר ועתה יגדל נא תשי\"ט",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "וביאור הענין בפרטיות יותר יובן בהקדים דיוק לשון הכתוב ועתה יגדל נא כח אד',"
        },
        {
          "s": 2,
          "text": "דשני פירושים בזה."
        },
        {
          "s": 3,
          "text": "דבכמה דרושים15"
        },
        {
          "s": 4,
          "text": "מבואר דפירוש יגדל כח אד' הוא שיומשך באד' הכח שלו"
        },
        {
          "s": 5,
          "text": "(השרש ומקור דאד')"
        },
        {
          "s": 6,
          "text": "ועי\"ז תהי' ההגדלה שלו."
        },
        {
          "s": 7,
          "text": "והפירוש דיגדל כח אד' בפשטות הוא"
        },
        {
          "s": 8,
          "text": "(וכן מבואר בכמה דרושים16)"
        },
        {
          "s": 9,
          "text": "שתהי' הגדלה"
        },
        {
          "s": 10,
          "text": "(גם)"
        },
        {
          "s": 11,
          "text": "בכח אד'."
        },
        {
          "s": 12,
          "text": "ועפ\"ז יובן"
        },
        {
          "s": 13,
          "text": "(יותר17)"
        },
        {
          "s": 14,
          "text": "השייכות דיגדל נא כח אד' להוי' ארך אפים גו'"
        },
        {
          "s": 15,
          "text": "(י\"ג מדות הרחמים שלמעלה מהשתלשלות),"
        },
        {
          "s": 16,
          "text": "כי בכדי שתהי' ההגדלה בכח אד'"
        },
        {
          "s": 17,
          "text": "(השרש ומקור דאד')"
        },
        {
          "s": 18,
          "text": "הוא ע\"י ההמשכה מבחינה שלמעלה מהשתלשלות,"
        },
        {
          "s": 19,
          "text": "למעלה גם משרש ומקור ההשתלשלות."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והענין הוא,"
        },
        {
          "s": 2,
          "text": "דשם אד' הוא במלכות"
        },
        {
          "s": 3,
          "text": "(כנ\"ל),"
        },
        {
          "s": 4,
          "text": "וכח אד'"
        },
        {
          "s": 5,
          "text": "(השרש ומקור דמלכות)"
        },
        {
          "s": 6,
          "text": "הוא בחכמה,"
        },
        {
          "s": 7,
          "text": "דאבא יסד ברתא18."
        },
        {
          "s": 8,
          "text": "ויובן זה עד\"מ מאותיות הדיבור שבאדם"
        },
        {
          "s": 9,
          "text": "(דמלכות בכלל הוא דיבור19),"
        },
        {
          "s": 10,
          "text": "ששרשם20"
        },
        {
          "s": 11,
          "text": "הוא למעלה מהאור"
        },
        {
          "s": 12,
          "text": "(השכל או המדה)"
        },
        {
          "s": 13,
          "text": "שמלובש בהם."
        },
        {
          "s": 14,
          "text": "דזה שאותה הסברא,"
        },
        {
          "s": 15,
          "text": "כל אחד אומר אותה באותיות ותיבות אחרים,"
        },
        {
          "s": 16,
          "text": "הוא מפני ששרש האותיות הוא מבחינת חכמה,"
        },
        {
          "s": 17,
          "text": "שכל הנעלם וקדמות השכל21"
        },
        {
          "s": 18,
          "text": "שבנפש,"
        },
        {
          "s": 19,
          "text": "שלמעלה משכל הגלוי."
        },
        {
          "s": 20,
          "text": "וזהו הטעם על זה שע\"י שמביא את השכל בדיבור מיתוסף בהשכל יותר מכמו שהי' תחלה"
        },
        {
          "s": 21,
          "text": "(במחשבה),"
        },
        {
          "s": 22,
          "text": "כי ע\"י הדיבור נמשך מבחינת החכמה שרש ומקור השכל."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה זה ששרש הדיבור הוא בחכמה הוא לא רק בנוגע להדיבור עצמו,"
        },
        {
          "s": 2,
          "text": "אלא גם בנוגע להשכל והמדות שמתלבשים בהדיבור."
        },
        {
          "s": 3,
          "text": "כי ע\"י התלבשותם בדיבור,"
        },
        {
          "s": 4,
          "text": "הם מתחלקים לריבוי חלקים."
        },
        {
          "s": 5,
          "text": "דכשמדבר דברי אהבה,"
        },
        {
          "s": 6,
          "text": "הרי האהבה מצד עצמה היא מדה אחת,"
        },
        {
          "s": 7,
          "text": "וכשהיא מתלבשת באותיות ותיבות הדיבור היא נחלקת לכמה תיבות,"
        },
        {
          "s": 8,
          "text": "שבכל תיבה יש חלק מהמדה22."
        },
        {
          "s": 9,
          "text": "ועד\"ז הוא כשמדבר איזו סברא שכלית,"
        },
        {
          "s": 10,
          "text": "שהסברא היא סברא אחת,"
        },
        {
          "s": 11,
          "text": "וכשהיא מתלבשת באותיות ותיבות הדיבור היא נחלקת לכמה חלקים23."
        },
        {
          "s": 12,
          "text": "וזה שהשכל והמדות באים להתחלקות"
        },
        {
          "s": 13,
          "text": "(אף שמצד עצמם הם פשוטים)"
        },
        {
          "s": 14,
          "text": "הוא ע\"י שנמשך בהם מבחינת החכמה,"
        },
        {
          "s": 15,
          "text": "קדמות השכל24."
        }
      ]
    }
  ]
}