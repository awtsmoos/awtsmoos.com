{
  "globalIndex": 46,
  "owner": 46,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913940_theRebbe_399__p003",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913940_theRebbe_399__p003",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518913940_theRebbe_399",
  "title": "מאמר תקעו בחודש שופר תשמ\"ז",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "וביאור ענין"
        },
        {
          "s": 1,
          "text": "(מה שהמשכת מלכותו ית' בראש השנה קשורה עם זמן מסויים דוקא ועם עבודת ישראל דוקא),"
        },
        {
          "s": 2,
          "text": "דהנה ידוע22"
        },
        {
          "s": 3,
          "text": "שתכלית כוונת הבריאה היא לעשות לו ית' דירה בתחתונים,"
        },
        {
          "s": 4,
          "text": "היינו שהגילוי אלקות למטה"
        },
        {
          "s": 5,
          "text": "(הדירה לו ית')"
        },
        {
          "s": 6,
          "text": "יהי' בגדרי התחתונים דוקא,"
        },
        {
          "s": 7,
          "text": "בגדרי הזמן ומקום ועשיית הדירה היא ע\"י ישראל."
        },
        {
          "s": 8,
          "text": "ומטעם זה המשכת המלכות דראש השנה היא בגדרי הזמן דוקא וע\"י עבודת ישראל דוקא23."
        },
        {
          "s": 9,
          "text": "וזהו מ\"ש24"
        },
        {
          "s": 10,
          "text": "את הוי' האמרת היום גו',"
        },
        {
          "s": 11,
          "text": "ומבאר בזה אדמו\"ר הצ\"צ25"
        },
        {
          "s": 12,
          "text": "ואדמו\"ר מהר\"ש"
        },
        {
          "s": 13,
          "text": "(בד\"ה זה דשנת תר\"ל26),"
        },
        {
          "s": 14,
          "text": "לכתחילה אַריבער27,"
        },
        {
          "s": 15,
          "text": "שהאמרת יש בו ג' פירושים,"
        },
        {
          "s": 16,
          "text": "והפירוש הראשון"
        },
        {
          "s": 17,
          "text": "(העיקרי)"
        },
        {
          "s": 18,
          "text": "הוא האמרת לשון שבח ותענוג,"
        },
        {
          "s": 19,
          "text": "והיום קאי על ראש השנה28,"
        },
        {
          "s": 20,
          "text": "והיינו,"
        },
        {
          "s": 21,
          "text": "דהאמרת היום קאי על המשכת התענוג בראש השנה."
        },
        {
          "s": 22,
          "text": "וכמבואר במ\"א29"
        },
        {
          "s": 23,
          "text": "שזהו גם מה ששופר דראש השנה הו\"ע התענוג,"
        },
        {
          "s": 24,
          "text": "שופר מלשון שפרו מעשיכם30."
        },
        {
          "s": 25,
          "text": "דמזה מובן,"
        },
        {
          "s": 26,
          "text": "שעיקר העבודה דראש השנה היא להשלים התענוג והתאוה שלמעלה לעשות לו ית' דירה בתחתונים,"
        },
        {
          "s": 27,
          "text": "וזה נעשה ע\"י עבודת ישראל,"
        },
        {
          "s": 28,
          "text": "האמרת דייקא."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "וממשיך אח\"כ בהמאמרים31,"
        },
        {
          "s": 1,
          "text": "דענין בנין המלכות – שהוא בראש השנה,"
        },
        {
          "s": 2,
          "text": "כמבואר בכתבי האריז\"ל32"
        },
        {
          "s": 3,
          "text": "– שנעשה ע\"י העבודה דתמליכוני עליכם,"
        },
        {
          "s": 4,
          "text": "הנה לזה צ\"ל הסרת כל ההעלמות וההסתרים וכו'."
        },
        {
          "s": 5,
          "text": "ויש לבאר המשך הענינים עם המבואר לפנ\"ז,"
        },
        {
          "s": 6,
          "text": "דמכיון שבראש השנה המלכות מתכסית ומתעלמת,"
        },
        {
          "s": 7,
          "text": "הרי העבודה דתמליכוני עליכם היא ע\"י הקדמת ביטול הכיסוי וההעלם והסתר."
        },
        {
          "s": 8,
          "text": "דזה כולל ביטול כל הענינים המבלבלים"
        },
        {
          "s": 9,
          "text": "[כולל ביטול בלבולי הגוף,"
        },
        {
          "s": 10,
          "text": "שתהי' רפואה קרובה ושלימה וכו'],"
        },
        {
          "s": 11,
          "text": "ואדרבה שיהי' באופן דכפליים לתושי'33."
        },
        {
          "s": 12,
          "text": "והנה לאחרי הקדמת הסרת ההעלמות וההסתרים"
        },
        {
          "s": 13,
          "text": "(שהו\"ע הזדככות הכלי)"
        },
        {
          "s": 14,
          "text": "צריך להיות העבודה ברצון"
        },
        {
          "s": 15,
          "text": "(שעי\"ז נעשה תוקף האור הרבה יותר מההמשכה שע\"י זיכוך הכלי)"
        },
        {
          "s": 16,
          "text": "כמבואר בהמאמר34,"
        },
        {
          "s": 17,
          "text": "די\"ל שזהו ענין קבלת מלכותו ית' בפשטות,"
        },
        {
          "s": 18,
          "text": "שהיא ברצון דוקא,"
        },
        {
          "s": 19,
          "text": "ומלכותו35"
        },
        {
          "s": 20,
          "text": "ברצון קיבלו עליהם36."
        },
        {
          "s": 21,
          "text": "וע\"י העבודה דביטול ההעלמות והסתרים,"
        },
        {
          "s": 22,
          "text": "והעבודה דמלכותו ברצון קיבלו עליהם,"
        },
        {
          "s": 23,
          "text": "נעשה בנין המלכות,"
        },
        {
          "s": 24,
          "text": "ועד להשלימות שבזה,"
        },
        {
          "s": 25,
          "text": "יחוד הוי' ואלקים,"
        },
        {
          "s": 26,
          "text": "יחוד אור ושפע,"
        },
        {
          "s": 27,
          "text": "ועד שגם ההעלם דשם אלקים"
        },
        {
          "s": 28,
          "text": "(בחי' המלכות)"
        },
        {
          "s": 29,
          "text": "עצמו יאיר,"
        },
        {
          "s": 30,
          "text": "דזהו מה שהמלכות נבנית בבחי' פרצוף,"
        },
        {
          "s": 31,
          "text": "דהמעלה בבחי' פרצוף דמלכות"
        },
        {
          "s": 32,
          "text": "(על הנקודה שבה)"
        },
        {
          "s": 33,
          "text": "שהיא בבחי' גילוי אור,"
        },
        {
          "s": 34,
          "text": "כמבואר בהמשך שם בארוכה."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "וממשיך שם37,"
        },
        {
          "s": 1,
          "text": "דזהו גם ביאור נוסח ברכת שופרות,"
        },
        {
          "s": 2,
          "text": "שומע קול תרועת עמו ישראל ברחמים."
        },
        {
          "s": 3,
          "text": "דתרועה הו\"ע שבירת החומריות והישות,"
        },
        {
          "s": 4,
          "text": "שעי\"ז פועלים שהמלכות תהי' בבחי' גילוי אור."
        },
        {
          "s": 5,
          "text": "ולכן יו\"ט של ראש השנה שחל להיות בשבת"
        },
        {
          "s": 6,
          "text": "(כ"
        },
        {
          "s": 7,
          "text": "(יום א' ד)"
        },
        {
          "s": 8,
          "text": "ראש השנה דקביעות שנה זו)"
        },
        {
          "s": 9,
          "text": "אין38"
        },
        {
          "s": 10,
          "text": "תוקעין,"
        },
        {
          "s": 11,
          "text": "לפי שבשבת אין העבודה באופן דשבירה ובירור,"
        },
        {
          "s": 12,
          "text": "דבשבת בורר אסור39."
        },
        {
          "s": 13,
          "text": "דטעם הדבר הוא משום שבשבת הוא שלימות ואמיתיות ענין הגשמיות,"
        },
        {
          "s": 14,
          "text": "ובזה אי\"צ להיות עבודת הבירורים וכו'."
        },
        {
          "s": 15,
          "text": "וממשיך,"
        },
        {
          "s": 16,
          "text": "ומ\"מ במקדש היו תוקעין גם בשבת,"
        },
        {
          "s": 17,
          "text": "לפי שבמקדש הרי היש הוא כתיקונו,"
        },
        {
          "s": 18,
          "text": "שהוא במקום היותר מובחר,"
        },
        {
          "s": 19,
          "text": "והיינו שהגשמי הוא כדבעי,"
        },
        {
          "s": 20,
          "text": "ולזאת במקדש היו תוקעין גם בשבת שאין זה ענין בירור אלא פעולת שלימות נעלית יותר בהגשמי השלם."
        },
        {
          "s": 21,
          "text": "ואולי יש להוסיף בזה,"
        },
        {
          "s": 22,
          "text": "ע\"פ הידוע40"
        },
        {
          "s": 23,
          "text": "דבקדש הקדשים מקום ארון אינו מן המדה,"
        },
        {
          "s": 24,
          "text": "והיינו שהי' בזה ענין של מדידה והגבלה,"
        },
        {
          "s": 25,
          "text": "מודד י' אמות לכל רוח41,"
        },
        {
          "s": 26,
          "text": "ועד\"ז הארון עצמו הי' בו מדידה והגבלה,"
        },
        {
          "s": 27,
          "text": "אמתיים וחצי ארכו ואמה וחצי רחבו ואמה וחצי קומתו42,"
        },
        {
          "s": 28,
          "text": "וביחד עם זה אינו מן המדה,"
        },
        {
          "s": 29,
          "text": "משום שהיש הוא כתקונו,"
        },
        {
          "s": 30,
          "text": "שהמדידה עצמה היא בלי גבול."
        }
      ]
    }
  ]
}