{
  "globalIndex": 37,
  "owner": 37,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913877_theRebbe_326__p003",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913877_theRebbe_326__p003",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518913877_theRebbe_326",
  "title": "מאמר יו\"ט של ר\"ה תשמ\"ג",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה נוסף לזה שע\"י תקיעת שופר נעשה השופר"
        },
        {
          "s": 2,
          "text": "(תענוג)"
        },
        {
          "s": 3,
          "text": "למעלה"
        },
        {
          "s": 4,
          "text": "(בז\"א וכו'),"
        },
        {
          "s": 5,
          "text": "דמה שלמעלה הוא ממך,"
        },
        {
          "s": 6,
          "text": "הנה ע\"י תקיעת שופר ממשיכים התענוג"
        },
        {
          "s": 7,
          "text": "(הבחינה דשופר)"
        },
        {
          "s": 8,
          "text": "בכל העולמות כולם,"
        },
        {
          "s": 9,
          "text": "עד בעולם העשי'."
        },
        {
          "s": 10,
          "text": "וכמו שאומרים בתפלות ראש השנה וידע כל פעול כי אתה פעלתו ויבין כל יצור כי אתה יצרתו ויאמר כל אשר נשמה באפו כו',"
        },
        {
          "s": 11,
          "text": "ואיתא בסידור האריז\"ל42"
        },
        {
          "s": 12,
          "text": "דג' לשונות אלו קאי על ג' עולמות בי\"ע"
        },
        {
          "s": 13,
          "text": "[נשמה באפו קאי בעולם הבריאה,"
        },
        {
          "s": 14,
          "text": "יצור בעולם היצירה ופעול בעולם העשי'],"
        },
        {
          "s": 15,
          "text": "שהם כללות כל העולמות,"
        },
        {
          "s": 16,
          "text": "ולכן אומרים בראש השנה ג' לשונות אלו כי ההמשכה דראש השנה היא בכל העולמות כולם,"
        },
        {
          "s": 17,
          "text": "עד בעולם העשי'."
        },
        {
          "s": 18,
          "text": "וזה שבראש השנה שחל בשבת אין תוקעין הוא לפי שגם ענין זה שנעשה ע\"י תקיעת שופר,"
        },
        {
          "s": 19,
          "text": "המשכת התענוג בכל העולמות עד למטה,"
        },
        {
          "s": 20,
          "text": "בשבת נעשה זה מצד שבת עצמו."
        },
        {
          "s": 21,
          "text": "כידוע שההמשכה דשבת היא בכל העולמות,"
        },
        {
          "s": 22,
          "text": "גם בעשי'."
        },
        {
          "s": 23,
          "text": "וכמבואר בכמה דרושים"
        },
        {
          "s": 24,
          "text": "(ומהם בהדרושים דראש השנה)43"
        },
        {
          "s": 25,
          "text": "שהחיות דכל העולמות,"
        },
        {
          "s": 26,
          "text": "גם דעולם העשי',"
        },
        {
          "s": 27,
          "text": "בשבת הוא נעלה יותר מהחיות שבימי החול."
        },
        {
          "s": 28,
          "text": "דבימי החול החיות דעולמות הוא מאותיות הדיבור,"
        },
        {
          "s": 29,
          "text": "ובשבת החיות שלהם הוא מאותיות המחשבה."
        },
        {
          "s": 30,
          "text": "הרי דשבת פועל בכל העולמות,"
        },
        {
          "s": 31,
          "text": "גם בעולם הגשמי."
        },
        {
          "s": 32,
          "text": "ועד שזה פועל שינוי גם בטבע של עם הארץ44"
        },
        {
          "s": 33,
          "text": "דבשבת"
        },
        {
          "s": 34,
          "text": "(הרי מצד טבעו)"
        },
        {
          "s": 35,
          "text": "אינו יכול לשקר45."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ומה שבמקדש היו תוקעין גם בראש השנה שחל בשבת,"
        },
        {
          "s": 1,
          "text": "הוא לפי שבחינת התענוג"
        },
        {
          "s": 2,
          "text": "(בחינת שופר)"
        },
        {
          "s": 3,
          "text": "שהמשיכו ע\"י תקיעת שופר במקדש היא נעלית יותר46."
        },
        {
          "s": 4,
          "text": "והיינו דהתענוג שממשיכים ע\"י תקיעת שופר במדינה הוא התענוג שיש בשבת מצד עצמו,"
        },
        {
          "s": 5,
          "text": "מצד זה ששבת מקדשא וקיימא,"
        },
        {
          "s": 6,
          "text": "ולכן בראש השנה שחל בשבת אין תוקעין במדינה,"
        },
        {
          "s": 7,
          "text": "משא\"כ ע\"י תקיעת שופר במקדש ממשיכים בחינת תענוג נעלית יותר,"
        },
        {
          "s": 8,
          "text": "שאינה בשבת מצד עצמו"
        },
        {
          "s": 9,
          "text": "(והוא ע\"ד שנת\"ל בענין כל המענג את השבת,"
        },
        {
          "s": 10,
          "text": "שיש בחינה בתענוג שאינה בשבת מצד עצמו ונעשית ע\"י העבודה דישראל),"
        },
        {
          "s": 11,
          "text": "ולכן במקדש היו תוקעין בראש השנה שחל בשבת."
        },
        {
          "s": 12,
          "text": "דבחינה זו היא למעלה יותר מבחינת התענוג גם דכל המענג את השבת"
        },
        {
          "s": 13,
          "text": "(העבודה דשבת)47,"
        },
        {
          "s": 14,
          "text": "ונמשכת רק בראש השנה ע\"י העבודה דתקיעת שופר."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והענין הוא"
        },
        {
          "s": 2,
          "text": "(כמבואר בהמאמר שם48),"
        },
        {
          "s": 3,
          "text": "דהנה בתענוג שבמצוות יש שני אופנים."
        },
        {
          "s": 4,
          "text": "אופן הא' הוא התענוג מזה שקיים ציווי הקב\"ה,"
        },
        {
          "s": 5,
          "text": "אשר קדשנו במצוותיו וצונו,"
        },
        {
          "s": 6,
          "text": "דתענוג זה הוא בכל המצוות בשוה,"
        },
        {
          "s": 7,
          "text": "דמכיון שהרצון הוא שוה בכל המצוות,"
        },
        {
          "s": 8,
          "text": "במילא גם התענוג שמצד הרצון הוא בכולם בשוה."
        },
        {
          "s": 9,
          "text": "ואופן הב' הוא התענוג הפרטי שבכל מצוה,"
        },
        {
          "s": 10,
          "text": "דבכל מצוה יש תענוג מיוחד."
        },
        {
          "s": 11,
          "text": "ומבאר בהמאמר,"
        },
        {
          "s": 12,
          "text": "דהתענוג הפרטי שבכל מצוה הוא נעלה יותר מהתענוג שמצד הרצון שבשוה בכל המצוות."
        },
        {
          "s": 13,
          "text": "דזהו חידוש בדרוש זה."
        },
        {
          "s": 14,
          "text": "דבכ\"מ49"
        },
        {
          "s": 15,
          "text": "מבואר דהכוונה הפרטית שבכל מצוה היא למטה במדריגה מהכוונה הכללית,"
        },
        {
          "s": 16,
          "text": "וכאן מבאר דהתענוג הפרטי הוא נעלה יותר50."
        },
        {
          "s": 17,
          "text": "דהתענוג המלובש בהרצון"
        },
        {
          "s": 18,
          "text": "(שהוא בשוה בכל המצוות)"
        },
        {
          "s": 19,
          "text": "הוא בחינת גילוי התענוג,"
        },
        {
          "s": 20,
          "text": "משא\"כ התענוג הפרטי שבכל מצוה שרשו הוא מבחינת מקור התענוגים שלמעלה מעלה מבחינת גילוי התענוג,"
        },
        {
          "s": 21,
          "text": "ומבחינת מקור התענוגים נמשך הארה לכל בחינה כפי מדריגתה דוקא."
        },
        {
          "s": 22,
          "text": "ועפ\"ז מבאר שם51"
        },
        {
          "s": 23,
          "text": "ענין השופר מה ששופר הוא מלשון תענוג"
        },
        {
          "s": 24,
          "text": "(הנותן אמרי שפר),"
        },
        {
          "s": 25,
          "text": "דלכאורה אינו מובן,"
        },
        {
          "s": 26,
          "text": "הרי ענין התענוג הוא כשיש כמה פרטים דוקא,"
        },
        {
          "s": 27,
          "text": "וכמו\"כ הוא בתענוג שבקול"
        },
        {
          "s": 28,
          "text": "(ניגון וכלי זמר)"
        },
        {
          "s": 29,
          "text": "שהוא דוקא כשיש הרכבה של כמה קולות,"
        },
        {
          "s": 30,
          "text": "ומכיון דשופר הוא קול אחד,"
        },
        {
          "s": 31,
          "text": "איך שייך שיהי' בו תענוג."
        },
        {
          "s": 32,
          "text": "ובפועל אנו רואים,"
        },
        {
          "s": 33,
          "text": "דקול שופר אין בו תענוג,"
        },
        {
          "s": 34,
          "text": "ואדרבה הוא מעורר חרדה כמ\"ש52"
        },
        {
          "s": 35,
          "text": "אם יתקע שופר בעיר ועם לא יחרדו53,"
        },
        {
          "s": 36,
          "text": "וכן במ\"ת כתיב54"
        },
        {
          "s": 37,
          "text": "וקול שופר חזק מאד ויחרד כל העם אשר במחנה וכתיב55"
        },
        {
          "s": 38,
          "text": "וירא העם וינועו ויעמדו מרחוק,"
        },
        {
          "s": 39,
          "text": "דמצד הגילוי הכי גדול ונפלא דבקול שופר עליהם הופעת56"
        },
        {
          "s": 40,
          "text": "היו בביטול"
        },
        {
          "s": 41,
          "text": "(ויעמוד מרחוק),"
        },
        {
          "s": 42,
          "text": "דחרדה וביטול הם היפך התענוג,"
        },
        {
          "s": 43,
          "text": "והיאך אומרים דשופר הוא מלשון וענינו תענוג."
        },
        {
          "s": 44,
          "text": "והענין בזה הוא"
        },
        {
          "s": 45,
          "text": "(כמבואר בהמאמר שם51),"
        },
        {
          "s": 46,
          "text": "דמה ששופר הוא תענוג הוא להיותו בחינת מקור התענוגים שלמעלה מבחינת גילוי התענוג."
        },
        {
          "s": 47,
          "text": "ולכן לא ימצא בקול השופר שום הרגשת תענוג כלל"
        },
        {
          "s": 48,
          "text": "(ואדרבה הוא מטיל חרדה),"
        },
        {
          "s": 49,
          "text": "לפי שהוא למעלה מבחינת תענוג גלוי,"
        },
        {
          "s": 50,
          "text": "כ\"א הוא מבחי' מקור התענוגים."
        },
        {
          "s": 51,
          "text": "ומבחינה זו נמשכים כל פרטי התענוגים."
        },
        {
          "s": 52,
          "text": "דזהו מה ששופר הוא מלשון שפרו מעשיכם,"
        },
        {
          "s": 53,
          "text": "מעשיכם לשון רבים,"
        },
        {
          "s": 54,
          "text": "דע\"י תקיעת שופר נפעל בכל מעשה ומעשה השיפור והתענוג השייך למעשה פרטי זה,"
        },
        {
          "s": 55,
          "text": "כי ההמשכה מבחינת מקור התענוגים היא"
        },
        {
          "s": 56,
          "text": "(כנ\"ל)"
        },
        {
          "s": 57,
          "text": "באופן דהתחלקות פרטים דוקא."
        },
        {
          "s": 58,
          "text": "וזוהי ג\"כ השייכות דשופר למ\"ת,"
        },
        {
          "s": 59,
          "text": "וכמו שאומרים במוסף דראש השנה אתה נגלית כו' ללמד לעמך תורה ומצוות כו' ובקול שופר עליהם הופעת,"
        },
        {
          "s": 60,
          "text": "דבמ\"ת היתה המשכת העצמות,"
        },
        {
          "s": 61,
          "text": "אנא נפשי כתבית יהבית57,"
        },
        {
          "s": 62,
          "text": "המשכת בחינת מקור התענוגים שלמעלה מבחינת גילוי התענוג,"
        },
        {
          "s": 63,
          "text": "ומזה נמשך אח\"כ התענוג בעשרת הדברות,"
        },
        {
          "s": 64,
          "text": "בכל דבור בפרט"
        },
        {
          "s": 65,
          "text": "(על כל דבור ודבור פרחה נשמתן58)"
        },
        {
          "s": 66,
          "text": "התענוג השייך לדבור זה במיוחד,"
        },
        {
          "s": 67,
          "text": "ואח\"כ נמשך זה בפרטיות יותר ללמד לעמך תורה ומצוות,"
        },
        {
          "s": 68,
          "text": "בכל מצוה ומצוה בפרט."
        }
      ]
    }
  ]
}