{
  "globalIndex": 1103,
  "owner": 3,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920390_theRebbe_690__p003",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920390_theRebbe_690__p003",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920390_theRebbe_690",
  "title": "מאמר את הוי' האמרת תש\"ל",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ויש לקשר זה עם תורת הבעש\"ט47"
        },
        {
          "s": 2,
          "text": "ותורת אדמו\"ר הזקן48"
        },
        {
          "s": 3,
          "text": "[אשר ח\"י אלול הוא יום ההולדת שלהם49]"
        },
        {
          "s": 4,
          "text": "על הפסוק50"
        },
        {
          "s": 5,
          "text": "ואתה קדוש יושב תהלות ישראל,"
        },
        {
          "s": 6,
          "text": "שהקב\"ה מצד עצמו הוא קדוש ומובדל,"
        },
        {
          "s": 7,
          "text": "וע\"י תהלות ישראל,"
        },
        {
          "s": 8,
          "text": "זה שישראל מהללים ומשבחים אותו ית',"
        },
        {
          "s": 9,
          "text": "הוא יושב ונמשך למטה."
        },
        {
          "s": 10,
          "text": "וזהו את ה' האמרת,"
        },
        {
          "s": 11,
          "text": "דע\"י שישראל משבחים אותו ית'"
        },
        {
          "s": 12,
          "text": "(תהלות ישראל)"
        },
        {
          "s": 13,
          "text": "עי\"ז נעשה שיהי' הקב\"ה מניח תפילין,"
        },
        {
          "s": 14,
          "text": "שנמשך אור"
        },
        {
          "s": 15,
          "text": "(שלמעלה מאצילות באצילות,"
        },
        {
          "s": 16,
          "text": "ובאצילות גופא מהמוחין במדות)"
        },
        {
          "s": 17,
          "text": "שלא כפי סדר ההשתלשלות,"
        },
        {
          "s": 18,
          "text": "שעי\"ז הוא יושב ונמשך גם למטה."
        },
        {
          "s": 19,
          "text": "דבההמשכה ע\"פ סדר ההשתלשלות,"
        },
        {
          "s": 20,
          "text": "כשהאור נמשך ומשתלשל,"
        },
        {
          "s": 21,
          "text": "הוא מתמעט ומתצמצם,"
        },
        {
          "s": 22,
          "text": "ועד שבעוה\"ז הגשמי,"
        },
        {
          "s": 23,
          "text": "נעשה העלם והסתר לגמרי51,"
        },
        {
          "s": 24,
          "text": "משא\"כ כשההמשכה היא שלא כפי סדר ההשתלשלות"
        },
        {
          "s": 25,
          "text": "[דשרש המשכה זו הוא מפנימיות ועצמות אוא\"ס שלמעלה משייכות לעולמות52,"
        },
        {
          "s": 26,
          "text": "שהמשכה זו היא ע\"י העבודה דישראל דוקא,"
        },
        {
          "s": 27,
          "text": "לפי ששרש נשמות ישראל הוא בעצמות אוא\"ס53],"
        },
        {
          "s": 28,
          "text": "אזי נמשך הגילוי גם למטה51."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה המשכה זו"
        },
        {
          "s": 2,
          "text": "(דהקב\"ה מניח תפילין)"
        },
        {
          "s": 3,
          "text": "היא"
        },
        {
          "s": 4,
          "text": "(בעיקר)"
        },
        {
          "s": 5,
          "text": "על ידי קיום מצות תפילין."
        },
        {
          "s": 6,
          "text": "כמאמר רז\"ל54"
        },
        {
          "s": 7,
          "text": "על הפסוק55"
        },
        {
          "s": 8,
          "text": "מגיד דבריו ליעקב חוקיו ומשפטיו לישראל,"
        },
        {
          "s": 9,
          "text": "מה שהוא עושה הוא אומר לישראל לעשות,"
        },
        {
          "s": 10,
          "text": "וידוע הפירוש בזה56,"
        },
        {
          "s": 11,
          "text": "דע\"י שישראל עושים ומקיימים את המצוות,"
        },
        {
          "s": 12,
          "text": "עי\"ז גורמים שהקב\"ה יעשה מצוות אלו57."
        },
        {
          "s": 13,
          "text": "[וע\"ד תורת הבעש\"ט58"
        },
        {
          "s": 14,
          "text": "עה\"פ59"
        },
        {
          "s": 15,
          "text": "הוי' צלך,"
        },
        {
          "s": 16,
          "text": "דכמו שהצל עושה מה שאדם עושה כך הבורא ב\"ה כביכול עושה מה שאדם עושה]."
        },
        {
          "s": 17,
          "text": "דמזה מובן גם במצות תפילין,"
        },
        {
          "s": 18,
          "text": "והוקשה כל התורה כולה"
        },
        {
          "s": 19,
          "text": "(המצוות)"
        },
        {
          "s": 20,
          "text": "לתפילין60,"
        },
        {
          "s": 21,
          "text": "דזה שהקב\"ה מניח תפילין,"
        },
        {
          "s": 22,
          "text": "נעשה ע\"י הנחת תפילין דישראל."
        },
        {
          "s": 23,
          "text": "ויובן זה ע\"פ הידוע61"
        },
        {
          "s": 24,
          "text": "דכוונת מצות תפילין"
        },
        {
          "s": 25,
          "text": "[וכוונה זו היא חלק דהמצוה62]"
        },
        {
          "s": 26,
          "text": "היא לשעבד הלב והמוח."
        },
        {
          "s": 27,
          "text": "דענין השעבוד,"
        },
        {
          "s": 28,
          "text": "שמשעבד עצמו לאלקות,"
        },
        {
          "s": 29,
          "text": "הוא דוגמת מצות ק\"ש שענינה הוא קבלת עול מלכות שמים"
        },
        {
          "s": 30,
          "text": "(פרשה ראשונה)"
        },
        {
          "s": 31,
          "text": "וקבלת עול מצוות"
        },
        {
          "s": 32,
          "text": "(פרשה שני')63,"
        },
        {
          "s": 33,
          "text": "דענין השעבוד וקב\"ע הוא למעלה מטו\"ד,"
        },
        {
          "s": 34,
          "text": "וביחד עם זה,"
        },
        {
          "s": 35,
          "text": "השעבוד דתפילין הוא בנוגע לכחות פרטים"
        },
        {
          "s": 36,
          "text": "(משא\"כ הקב\"ע דק\"ש הוא כללי),"
        },
        {
          "s": 37,
          "text": "שמשעבד את ד' המוחין"
        },
        {
          "s": 38,
          "text": "(חו\"ב ודעת שנחלק לחו\"ג)"
        },
        {
          "s": 39,
          "text": "שלו64,"
        },
        {
          "s": 40,
          "text": "וזה נמשך גם בהמדות שבלב,"
        },
        {
          "s": 41,
          "text": "שעבוד הלב65."
        },
        {
          "s": 42,
          "text": "ויש לומר דע\"י שמשעבד את המוחין שלו באופן דקב\"ע,"
        },
        {
          "s": 43,
          "text": "שהוא המשכה מעצם הנפש"
        },
        {
          "s": 44,
          "text": "(שהרי ענין הקב\"ע הוא מצד עצם הנפש שלמעלה מהשתל')"
        },
        {
          "s": 45,
          "text": "בכח השכל שלו,"
        },
        {
          "s": 46,
          "text": "עי\"ז נעשה ענין"
        },
        {
          "s": 47,
          "text": "(פירוש)"
        },
        {
          "s": 48,
          "text": "השני דהקב\"ה מניח תפילין,"
        },
        {
          "s": 49,
          "text": "המשכת אוא\"ס66"
        },
        {
          "s": 50,
          "text": "במוחין דלמעלה,"
        },
        {
          "s": 51,
          "text": "וע\"י שזה נמשך מהמוח להלב,"
        },
        {
          "s": 52,
          "text": "עי\"ז נעשה ענין"
        },
        {
          "s": 53,
          "text": "(פירוש)"
        },
        {
          "s": 54,
          "text": "הראשון בהקב\"ה מניח תפילין,"
        },
        {
          "s": 55,
          "text": "המשכת מוחין בז\"א."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ויש להוסיף,"
        },
        {
          "s": 2,
          "text": "דעל ידי ההמשכה דקב\"ע"
        },
        {
          "s": 3,
          "text": "(למעלה מהשתלשלות שבאדם)"
        },
        {
          "s": 4,
          "text": "בהמוח ובהלב,"
        },
        {
          "s": 5,
          "text": "נמשך זה בכל הכחות67,"
        },
        {
          "s": 6,
          "text": "גם בכחות התחתונים."
        },
        {
          "s": 7,
          "text": "דזהו מה שהרצועות דתש\"ר צריכים להיות עד"
        },
        {
          "s": 8,
          "text": "(למטה מן)"
        },
        {
          "s": 9,
          "text": "הטבור68,"
        },
        {
          "s": 10,
          "text": "שגם עניני האדם שמפלגך ולתתא69"
        },
        {
          "s": 11,
          "text": "יהיו משועבדים לאלקות."
        },
        {
          "s": 12,
          "text": "ועי\"ז פועל כן גם בעולם,"
        },
        {
          "s": 13,
          "text": "שגם בענינים התחתונים"
        },
        {
          "s": 14,
          "text": "(דמפלגך ולתתא)70"
        },
        {
          "s": 15,
          "text": "יהי' גילוי אלקות."
        },
        {
          "s": 16,
          "text": "דנוסף לזה שבתפילין נמשך הגילוי דאחד כו' גם בקלף וכו' הגשמי,"
        },
        {
          "s": 17,
          "text": "דבק\"ש הגילוי דהוי' אחד הוא בהאדם הקורא ק\"ש משא\"כ בתפילין71"
        },
        {
          "s": 18,
          "text": "ההמשכה היא גם בקלף וכו' הגשמי72"
        },
        {
          "s": 19,
          "text": "[דזהו שהוקשה כל התורה כולה לתפילין,"
        },
        {
          "s": 20,
          "text": "כי ענין התומ\"צ הוא להמשיך אלקות למטה דוקא,"
        },
        {
          "s": 21,
          "text": "להיות לו דירה בתחתונים73],"
        },
        {
          "s": 22,
          "text": "הנה הגילוי דתפילין פועל גם באלה שמצד עצמם הם מנגדים לקדושה."
        },
        {
          "s": 23,
          "text": "וכמ\"ש74"
        },
        {
          "s": 24,
          "text": "וראו כל עמי הארץ כי שם הוי' נקרא עליך ויראו ממך וארז\"ל75"
        },
        {
          "s": 25,
          "text": "אלו תפילין שבראש,"
        },
        {
          "s": 26,
          "text": "דההמשכה שע\"י הנחת תפילין פועלת גם באלה שצריך לחדש בהם ויראו ממך"
        },
        {
          "s": 27,
          "text": "(להיותם מנגדים)."
        },
        {
          "s": 28,
          "text": "ולא עוד,"
        },
        {
          "s": 29,
          "text": "אלא שוראו גו' כי שם הוי' נקרא עליך."
        },
        {
          "s": 30,
          "text": "דאומות העולם"
        },
        {
          "s": 31,
          "text": "(גם אלה שמודים באלקות),"
        },
        {
          "s": 32,
          "text": "ידיעתם היא רק בשם אלקים"
        },
        {
          "s": 33,
          "text": "(בגימטריא הטבע76),"
        },
        {
          "s": 34,
          "text": "אבל משם הוי'"
        },
        {
          "s": 35,
          "text": "(שלמעלה מהטבע)"
        },
        {
          "s": 36,
          "text": "אינם יודעים,"
        },
        {
          "s": 37,
          "text": "כמו שאמר פרעה לא ידעתי את הוי'77,"
        },
        {
          "s": 38,
          "text": "וע\"י שישראל מניחים תפילין,"
        },
        {
          "s": 39,
          "text": "הגילוי דהוי'"
        },
        {
          "s": 40,
          "text": "(שבישראל המניח תפילין)"
        },
        {
          "s": 41,
          "text": "הוא באופן שגם עמי הארץ"
        },
        {
          "s": 42,
          "text": "(ויתירה מזו,"
        },
        {
          "s": 43,
          "text": "כל עמי הארץ שבזה נכלל אלה שמצד עצמם אינם מודים באלקות78,"
        },
        {
          "s": 44,
          "text": "גם לא בשם אלקים)"
        },
        {
          "s": 45,
          "text": "רואים כי שם הוי' נקרא עליך,"
        },
        {
          "s": 46,
          "text": "וראי' זו פועלת בהם ויראו ממך."
        }
      ]
    }
  ]
}