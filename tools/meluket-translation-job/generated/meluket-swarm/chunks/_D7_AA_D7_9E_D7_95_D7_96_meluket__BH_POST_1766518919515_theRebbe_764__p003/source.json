{
  "globalIndex": 967,
  "owner": 17,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919515_theRebbe_764__p003",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919515_theRebbe_764__p003",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919515_theRebbe_764",
  "title": "מאמר גדול יהי' תשכ\"ב",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וביאור מעלת בית השלישי על בית ראשון ושני"
        },
        {
          "s": 2,
          "text": "(גם על בית שני כמו שהי' ראוי להיות בצורת התבנית דבית שלישי),"
        },
        {
          "s": 3,
          "text": "יובן בהקדים המעלה דבית המקדש"
        },
        {
          "s": 4,
          "text": "(בכלל)30,"
        },
        {
          "s": 5,
          "text": "כולל גם המעלה דמקום המקדש,"
        },
        {
          "s": 6,
          "text": "דמקום המקדש"
        },
        {
          "s": 7,
          "text": "(גם לפני בנין ביהמ\"ק)"
        },
        {
          "s": 8,
          "text": "הוא למעלה יותר מהמקום דכל העולם,"
        },
        {
          "s": 9,
          "text": "כמ\"ש31"
        },
        {
          "s": 10,
          "text": "מה נורא המקום הזה אין זה כי אם בית אלקים ותרגם אונקלוס לית דין אתר הדיוט."
        },
        {
          "s": 11,
          "text": "שהמקום דכל העולם הוא אתר הדיוט לפי שנברא בעשרה מאמרות שנקראים32"
        },
        {
          "s": 12,
          "text": "מילין דהדיוטא,"
        },
        {
          "s": 13,
          "text": "ומקום המקדש אינו אתר הדיוט"
        },
        {
          "s": 14,
          "text": "[אף שגם מקום המקדש נברא בעשרה מאמרות."
        },
        {
          "s": 15,
          "text": "ואדרבה,"
        },
        {
          "s": 16,
          "text": "התחלת ועיקר הבריאה מהעש\"מ היתה בריאת אבן שתי' שבמקדש וממנה הושתת כל העולם33],"
        },
        {
          "s": 17,
          "text": "כי בעשרה מאמרות נאמר ויאמר אלקים,"
        },
        {
          "s": 18,
          "text": "ובמקום המקדש הי' גילוי שם הוי' כמ\"ש34"
        },
        {
          "s": 19,
          "text": "אכן יש הוי' במקום הזה."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "וצריך ביאור,"
        },
        {
          "s": 1,
          "text": "דלכאורה,"
        },
        {
          "s": 2,
          "text": "מעלת מקום המקדש על המקום דכל העולם הוא בהגילוי שהי' בביהמ\"ק ולא בהמקום עצמו,"
        },
        {
          "s": 3,
          "text": "שהרי גם מקום המקדש נברא בעשרה מאמרות"
        },
        {
          "s": 4,
          "text": "(מילין דהדיוטא),"
        },
        {
          "s": 5,
          "text": "ופירוש לית דין אתר הדיוט הוא שהמקום עצמו אינו אתר הדיוט."
        },
        {
          "s": 6,
          "text": "ונקודת הביאור בזה ע\"פ מ\"ש בתניא35"
        },
        {
          "s": 7,
          "text": "שהתהוות העולם היא משם הוי'"
        },
        {
          "s": 8,
          "text": "(הוי' לשון מהווה36),"
        },
        {
          "s": 9,
          "text": "אלא שבאם ההתהוות היתה משם הוי' עצמו הי' העולם בטל במציאות ולכן ההתהוות בפועל היתה ע\"י שם אלקים."
        },
        {
          "s": 10,
          "text": "וההתהוות דמקום המקדש היתה באופן ששם אלקים אינו מסתיר על שם הוי'."
        },
        {
          "s": 11,
          "text": "וזהו לית דין אתר הדיוט כי במקום המקדש הי' נרגש בגילוי ההתהוות כמו שהיא משם הוי'."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "והענין הוא,"
        },
        {
          "s": 1,
          "text": "דההתהוות משם אלקים היא בדרך התלבשות"
        },
        {
          "s": 2,
          "text": "(בראשית ברא אלקים37)"
        },
        {
          "s": 3,
          "text": "וההתהוות משם הוי' היא באופן דבדרך ממילא"
        },
        {
          "s": 4,
          "text": "(יהללו את שם הוי' כי הוא צוה ונבראו38)."
        },
        {
          "s": 5,
          "text": "והחילוק שבאופן ההתהוות"
        },
        {
          "s": 6,
          "text": "(אם ההתהוות היא בדרך ממילא או שהיא בדרך התלבשות)"
        },
        {
          "s": 7,
          "text": "מורה על היחס של הדבר המתהווה להמקור שמהווה אותו."
        },
        {
          "s": 8,
          "text": "דכאשר המתהווה הוא בקירוב להמהווה,"
        },
        {
          "s": 9,
          "text": "התהוותו היא בדרך ממילא39."
        },
        {
          "s": 10,
          "text": "וכמו עילה ועלול,"
        },
        {
          "s": 11,
          "text": "דכיון שהעלול הוא בערך העילה,"
        },
        {
          "s": 12,
          "text": "לכן התהוות העלול מהעילה היא בדרך ממילא"
        },
        {
          "s": 13,
          "text": "[וכמו שכל ומדות,"
        },
        {
          "s": 14,
          "text": "דכיון שהמדה היא בערך השכל,"
        },
        {
          "s": 15,
          "text": "לכן,"
        },
        {
          "s": 16,
          "text": "ע\"י ההתבוננות,"
        },
        {
          "s": 17,
          "text": "באה ממילא המדה שבהתאם לההתבוננות]."
        },
        {
          "s": 18,
          "text": "וכמו\"כ הוא באור ומאור40,"
        },
        {
          "s": 19,
          "text": "דכיון שהאור הוא גילוי המאור,"
        },
        {
          "s": 20,
          "text": "לכן,"
        },
        {
          "s": 21,
          "text": "המצאת האור מהמאור היא בדרך ממילא."
        },
        {
          "s": 22,
          "text": "וכאשר המתהווה הוא בריחוק מהמהווה,"
        },
        {
          "s": 23,
          "text": "התהוותו היא בדרך התלבשות39,"
        },
        {
          "s": 24,
          "text": "שהמהווה מתעסק ומשתדל להוות את הדבר המתהווה."
        }
      ]
    }
  ]
}