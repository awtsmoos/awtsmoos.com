{
  "globalIndex": 35,
  "owner": 35,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913877_theRebbe_326__p001",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913877_theRebbe_326__p001",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518913877_theRebbe_326",
  "title": "מאמר יו\"ט של ר\"ה תשמ\"ג",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ליל ערב ראש-השנה ה'תשמ\"ג*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "יום טוב של ראש השנה שחל להיות בשבת במקדש היו תוקעין אבל לא במדינה1."
        },
        {
          "s": 1,
          "text": "וצריך להבין"
        },
        {
          "s": 2,
          "text": "[כמו שמדייק אדמו\"ר הצ\"צ2"
        },
        {
          "s": 3,
          "text": "במאמרו ד\"ה להבין הטעם3],"
        },
        {
          "s": 4,
          "text": "הרי תקיעת שופר היא מ\"ע דאורייתא כמ\"ש4"
        },
        {
          "s": 5,
          "text": "יום תרועה יהי' לכם,"
        },
        {
          "s": 6,
          "text": "והיאך ביטלו5"
        },
        {
          "s": 7,
          "text": "אותה משום גזירה שמא יעבירנו כו'6."
        },
        {
          "s": 8,
          "text": "וביותר יש לתמוה7,"
        },
        {
          "s": 9,
          "text": "דמזה שבמקדש היו תוקעין גם בראש השנה כשחל בשבת הרי מוכח שמצות תקיעת שופר ישנה גם בפועל גם ביו\"ט של ראש השנה שחל להיות בשבת,"
        },
        {
          "s": 10,
          "text": "ולמה ביטלו אותה בחו\"ל ואפילו במדינה מפני הגזירה שמא יעבירנו."
        },
        {
          "s": 11,
          "text": "וגם צריך להבין8"
        },
        {
          "s": 12,
          "text": "מה שפסוקי שופרות אומרים גם בראש השנה שחל בשבת,"
        },
        {
          "s": 13,
          "text": "דהגם שאמירת הפסוקים קשורה ובאה בהמשך לתקיעת שופר,"
        },
        {
          "s": 14,
          "text": "ובראש השנה שחל בשבת אין תוקעין במדינה,"
        },
        {
          "s": 15,
          "text": "מ\"מ אמירת הפסוקים היא גם בראש השנה שחל בשבת."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ומבאר זה"
        },
        {
          "s": 1,
          "text": "(במאמר הנ\"ל)"
        },
        {
          "s": 2,
          "text": "ע\"פ הידוע דכל המצוות שלנו הוא"
        },
        {
          "s": 3,
          "text": "(בכדי)"
        },
        {
          "s": 4,
          "text": "שע\"י אתעדל\"ת אתעדל\"ע."
        },
        {
          "s": 5,
          "text": "היינו,"
        },
        {
          "s": 6,
          "text": "דמה שישראל מקיימים את המצוות הוא בכדי לפעול עי\"ז המצוות שלמעלה."
        },
        {
          "s": 7,
          "text": "דהנה כל המצוות שלמעלה נעשים הם ע\"י שהאדם שלמטה מקיים את המצוות,"
        },
        {
          "s": 8,
          "text": "וכמ\"ש9"
        },
        {
          "s": 9,
          "text": "ועשיתם אותם,"
        },
        {
          "s": 10,
          "text": "אתם כתיב,"
        },
        {
          "s": 11,
          "text": "מעלה אני עליכם כאילו עשאוני10,"
        },
        {
          "s": 12,
          "text": "רמ\"ח פיקודין אינון רמ\"ח אברין דמלכא11,"
        },
        {
          "s": 13,
          "text": "בחינת ז\"א,"
        },
        {
          "s": 14,
          "text": "והמשכת האור בהכלים דז\"א וכן הגדלת הכלים היא ע\"י קיום המצוות של האדם התחתון דוקא12,"
        },
        {
          "s": 15,
          "text": "כמ\"ש אשר יעשה אותם האדם וחי בהם13,"
        },
        {
          "s": 16,
          "text": "דהמצוות שלמעלה הוא דוקא על ידי אשר יעשה אותם האדם,"
        },
        {
          "s": 17,
          "text": "נשמה בגוף."
        },
        {
          "s": 18,
          "text": "דכמו כן הוא במצות תקיעת שופר,"
        },
        {
          "s": 19,
          "text": "שע\"י שישראל תוקעים בשופר,"
        },
        {
          "s": 20,
          "text": "נעשה עי\"ז תקיעת שופר שלמעלה7."
        }
      ]
    }
  ]
}