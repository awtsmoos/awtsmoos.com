{
  "globalIndex": 270,
  "owner": 20,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915336_theRebbe_861__p003",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915336_theRebbe_861__p003",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915336_theRebbe_861",
  "title": "מאמר פדה בשלום תשל\"ט",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה בהמאמר הנ\"ל דבעל הגאולה בתחלת הענין33"
        },
        {
          "s": 2,
          "text": "מבואר דענין המלחמה"
        },
        {
          "s": 3,
          "text": "(של נה\"א עם נה\"ב)"
        },
        {
          "s": 4,
          "text": "היא בנר\"נ המלובשים בגוף ונה\"ב,"
        },
        {
          "s": 5,
          "text": "משא\"כ בהמקיפים דחי' יחידה לא שייך מלחמה."
        },
        {
          "s": 6,
          "text": "אלא שלאח\"ז בהמשך המאמר34"
        },
        {
          "s": 7,
          "text": "מבאר בפרטיות יותר שגם בבחינת חי' יש ענין המלחמה,"
        },
        {
          "s": 8,
          "text": "וענין השלום הוא ביחידה דוקא."
        },
        {
          "s": 9,
          "text": "ויש לומר,"
        },
        {
          "s": 10,
          "text": "שהוא ע\"ד שאמר הקב\"ה לדוד המלך"
        },
        {
          "s": 11,
          "text": "(כשרצה לבנות בית המקדש)"
        },
        {
          "s": 12,
          "text": "דם לרוב שפכת גו'"
        },
        {
          "s": 13,
          "text": "(ולכן)"
        },
        {
          "s": 14,
          "text": "לא תבנה בית לשמי גו' הנה בן נולד לך הוא יהי' איש מנוחה גו' הוא יבנה בית לשמי גו'35."
        },
        {
          "s": 15,
          "text": "אלא שאעפ\"כ תבנית המקדש נעשה ע\"י דוד"
        },
        {
          "s": 16,
          "text": "(מיד ה' עלי השכיל36),"
        },
        {
          "s": 17,
          "text": "ויתן דויד לשלמה בנו את תבנית האולם וגו'37."
        },
        {
          "s": 18,
          "text": "וצריך להבין,"
        },
        {
          "s": 19,
          "text": "דכיון שביהמ\"ק קשור עם מנוחה38"
        },
        {
          "s": 20,
          "text": "ושלום דוקא,"
        },
        {
          "s": 21,
          "text": "שלכן נאמר לדוד לא תבנה בית לשמי כי איש מלחמות אתה39,"
        },
        {
          "s": 22,
          "text": "למה נעשו ההכנות לביהמ\"ק ע\"י דוד שהי' איש מלחמות."
        },
        {
          "s": 23,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 24,
          "text": "כי אז"
        },
        {
          "s": 25,
          "text": "(כשרצה דוד לבנות ביהמ\"ק,"
        },
        {
          "s": 26,
          "text": "ומכ\"ש כשהכין את התבנית וכו')"
        },
        {
          "s": 27,
          "text": "הי' דוד במצב של מנוחה,"
        },
        {
          "s": 28,
          "text": "וה' הניח לו מסביב מכל אויביו40."
        },
        {
          "s": 29,
          "text": "אלא שכיון שהמנוחה דדוד באה ע\"י המלחמות שעשה,"
        },
        {
          "s": 30,
          "text": "לכן בנין ביהמ\"ק הוצרך להיות ע\"י שלמה,"
        },
        {
          "s": 31,
          "text": "איש מנוחה,"
        },
        {
          "s": 32,
          "text": "מנוחה בעצם."
        },
        {
          "s": 33,
          "text": "ויש לומר,"
        },
        {
          "s": 34,
          "text": "דזה שמבואר בהמאמר"
        },
        {
          "s": 35,
          "text": "(בתחלת הענין)"
        },
        {
          "s": 36,
          "text": "שגם בבחינת חי' לא שייך מלחמה הוא ע\"ד המנוחה דדוד לאחרי שנצח כל המלחמות."
        },
        {
          "s": 37,
          "text": "דבבחינת נר\"נ שמתלבשים בהגוף ונה\"ב,"
        },
        {
          "s": 38,
          "text": "כיון שפעולת נה\"א בנה\"ב היא בדרך התלבשות והתעסקות,"
        },
        {
          "s": 39,
          "text": "דנפש הבהמית ההשגה שלה היא בהטוב דדברים גשמיים,"
        },
        {
          "s": 40,
          "text": "ונפש האלקית מתעסקת עמה לבאר לה הטוב דאלקות,"
        },
        {
          "s": 41,
          "text": "הרי זה ענין של מלחמה ממש."
        },
        {
          "s": 42,
          "text": "משא\"כ בחינת חי',"
        },
        {
          "s": 43,
          "text": "כיון שפעולתה בנה\"ב הוא"
        },
        {
          "s": 44,
          "text": "(לא בדרך התלבשות אלא)"
        },
        {
          "s": 45,
          "text": "שמצד גילוי תוקף הרצון לאלקות דנה\"א מתבטלים במילא הרצונות דנה\"ב,"
        },
        {
          "s": 46,
          "text": "אין זה ענין של מלחמה."
        },
        {
          "s": 47,
          "text": "ובכללות,"
        },
        {
          "s": 48,
          "text": "הו\"ע של מנוחה."
        },
        {
          "s": 49,
          "text": "אלא שמנוחה זו היא"
        },
        {
          "s": 50,
          "text": "(לא מנוחה בעצם,"
        },
        {
          "s": 51,
          "text": "ורק)"
        },
        {
          "s": 52,
          "text": "מצד תגבורת הרצון דנה\"א,"
        },
        {
          "s": 53,
          "text": "בדוגמת המנוחה דדוד לאחרי שה' הניח לו מכל אויביו,"
        },
        {
          "s": 54,
          "text": "שהמנוחה שלו היתה מצד זה שנצח כל המלחמות."
        },
        {
          "s": 55,
          "text": "משא\"כ ביטול הרצונות דנה\"ב ע\"י גילוי היחידה הוא"
        },
        {
          "s": 56,
          "text": "(לא שע\"י גילוי היחידה נעשה ביטול הרצונות,"
        },
        {
          "s": 57,
          "text": "כי אם)"
        },
        {
          "s": 58,
          "text": "שמצד היחידה"
        },
        {
          "s": 59,
          "text": "(שאין כנגדה לעו\"ז)"
        },
        {
          "s": 60,
          "text": "אין מקום מלכתחילה לרצונות זרים,"
        },
        {
          "s": 61,
          "text": "בדוגמת המנוחה דשלמה,"
        },
        {
          "s": 62,
          "text": "שהיתה"
        },
        {
          "s": 63,
          "text": "(לא ע\"י נצחון,"
        },
        {
          "s": 64,
          "text": "אלא)"
        },
        {
          "s": 65,
          "text": "מנוחה בעצם."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה עד\"ז הוא בהעבודה שבדרך מלחמה שיש בה כו\"כ דרגות."
        },
        {
          "s": 2,
          "text": "דהמלחמה שבתפלה,"
        },
        {
          "s": 3,
          "text": "שעת צלותא שעת קרבא,"
        },
        {
          "s": 4,
          "text": "כיון שבעת התפלה הוא מופשט מעניני העולם וההתעסקות שלו היא להתבונן בעניני אלקות ולעורר אהבת ה' ויראת ה',"
        },
        {
          "s": 5,
          "text": "אלא שההתבוננות"
        },
        {
          "s": 6,
          "text": "(והאהוי\"ר)"
        },
        {
          "s": 7,
          "text": "צריכות להיות באופן שיהי' מושג גם בהשכל דנה\"ב,"
        },
        {
          "s": 8,
          "text": "אין זה מלחמה ממש"
        },
        {
          "s": 9,
          "text": "(ונק' זה בשם חרב41"
        },
        {
          "s": 10,
          "text": "של שלום42)."
        },
        {
          "s": 11,
          "text": "והעבודה בדרך מלחמה היא בעיקר בשעת האכילה ושתי',"
        },
        {
          "s": 12,
          "text": "נהמא אפום חרבא ליכול43,"
        },
        {
          "s": 13,
          "text": "ועד\"ז בשאר צרכי הגוף."
        },
        {
          "s": 14,
          "text": "ובזה גופא,"
        },
        {
          "s": 15,
          "text": "עיקר המלחמה היא בשעת העסק במשא ומתן,"
        },
        {
          "s": 16,
          "text": "מסחר."
        },
        {
          "s": 17,
          "text": "כי המלחמה דאכילה"
        },
        {
          "s": 18,
          "text": "(ועד\"ז בשאר צרכי הגוף)"
        },
        {
          "s": 19,
          "text": "היא שאכילתו תהי' לשם שמים ולא למלאות תאות נפשו,"
        },
        {
          "s": 20,
          "text": "היינו שלוחם נגד התאוה והתענוג שבהמאכל"
        },
        {
          "s": 21,
          "text": "(ואינו מלובש בו),"
        },
        {
          "s": 22,
          "text": "משא\"כ ההתעסקות במשא ומתן מוכרחת להיות"
        },
        {
          "s": 23,
          "text": "(ע\"פ תורה)"
        },
        {
          "s": 24,
          "text": "בדרך התלבשות,"
        },
        {
          "s": 25,
          "text": "נשאת ונתת באמונה44."
        },
        {
          "s": 26,
          "text": "[ויש לומר,"
        },
        {
          "s": 27,
          "text": "דזהו גם הטעם על זה שכללות הבירורים נק' בשם כנען,"
        },
        {
          "s": 28,
          "text": "דפירוש כנען הוא סוחר45,"
        },
        {
          "s": 29,
          "text": "כי עיקר הבירורים שבדרך התלבשות הוא במשא ומתן]."
        },
        {
          "s": 30,
          "text": "ונמצא,"
        },
        {
          "s": 31,
          "text": "שהמלחמה דאכילה היא דוגמת המלחמה בחרב"
        },
        {
          "s": 32,
          "text": "(נהמא אפום חרבא ליכול),"
        },
        {
          "s": 33,
          "text": "דעם היות שהמלחמה דחרב היא דוקא כשהוא בקירוב להשונא"
        },
        {
          "s": 34,
          "text": "(דזהו החילוק בין חרב לקשת46),"
        },
        {
          "s": 35,
          "text": "הרי קירוב זה הוא רק במקום."
        },
        {
          "s": 36,
          "text": "משא\"כ המלחמה שבמשא ומתן היא דוגמת המלחמה שנקראת בשם קרב מלשון קירוב,"
        },
        {
          "s": 37,
          "text": "שהקירוב דקרב הוא"
        },
        {
          "s": 38,
          "text": "(לא רק במקום,"
        },
        {
          "s": 39,
          "text": "אלא)"
        },
        {
          "s": 40,
          "text": "ששני הלוחמים מחבקים זה את זה,"
        },
        {
          "s": 41,
          "text": "כנ\"ל"
        },
        {
          "s": 42,
          "text": "(סעיף ב)"
        },
        {
          "s": 43,
          "text": "בארוכה."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וזהו פדה בשלום נפשי מקרב לי,"
        },
        {
          "s": 2,
          "text": "שגם עבודת הבירורים שבדרך קרב"
        },
        {
          "s": 3,
          "text": "(ולא רק בדרך מלחמה אלא בדרך קרב)"
        },
        {
          "s": 4,
          "text": "תהי' באופן דפדה בשלום,"
        },
        {
          "s": 5,
          "text": "שלום בתכלית השלימות כהשלום שהי' בימי שלמה,"
        },
        {
          "s": 6,
          "text": "ולמעלה יותר – כהשלום שיהי' לע\"ל."
        },
        {
          "s": 7,
          "text": "והטעם לזה הוא כההמשך בכתוב כי ברבים היו עמדי."
        },
        {
          "s": 8,
          "text": "שע\"י העבודה דברבים היו עמדי,"
        },
        {
          "s": 9,
          "text": "שהיא התעוררות וגילוי היחידה כמבואר בארוכה בדרוש הנ\"ל דבעל הגאולה47,"
        },
        {
          "s": 10,
          "text": "דכאו\"א מישראל בכחו לעורר ולגלות היחידה שבו,"
        },
        {
          "s": 11,
          "text": "הנה עי\"ז נעשה פדה בשלום נפשי,"
        },
        {
          "s": 12,
          "text": "נפשו של האדם העובד,"
        },
        {
          "s": 13,
          "text": "דהגם שעוסק בעניני העולם בכדי לבררם באופן של קרב,"
        },
        {
          "s": 14,
          "text": "מ\"מ לא יהי' נתפס בזה והפדי' שלו תהי' בשלום,"
        },
        {
          "s": 15,
          "text": "ועד לשלום בתכלית השלימות."
        },
        {
          "s": 16,
          "text": "ויתירה מזו שגם פדיית הניצוצות שבעניני העולם תהי' בשלום,"
        },
        {
          "s": 17,
          "text": "ברבים היו עמדי,"
        },
        {
          "s": 18,
          "text": "שגם הניצוצות שהיו תחלה בבחי' רבים"
        },
        {
          "s": 19,
          "text": "(כי היו בגלות ברשות הרבים טורי דפרודא)48"
        },
        {
          "s": 20,
          "text": "נכללים בנשמתו של האדם המבררם,"
        },
        {
          "s": 21,
          "text": "היו עמדי,"
        },
        {
          "s": 22,
          "text": "ועד שהם נכללים בהיחידה שבו."
        }
      ]
    }
  ]
}