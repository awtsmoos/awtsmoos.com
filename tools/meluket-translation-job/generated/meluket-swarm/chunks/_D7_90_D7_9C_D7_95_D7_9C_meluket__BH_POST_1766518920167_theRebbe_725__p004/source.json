{
  "globalIndex": 1075,
  "owner": 25,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920167_theRebbe_725__p004",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920167_theRebbe_725__p004",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920167_theRebbe_725",
  "title": "מאמר אני לדודי תשכ\"ו",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ויש להוסיף,"
        },
        {
          "s": 1,
          "text": "דענין זה שהגילוי דאלול הוא לא רק נתינת כח אלא גם מעורר23,"
        },
        {
          "s": 2,
          "text": "מובן גם מכללות הענין דמלך בשדה24,"
        },
        {
          "s": 3,
          "text": "דכשהמלך בשדה הרי נוסף שאז יש לכל אחד הרשות והיכולת להקביל את פני המלך,"
        },
        {
          "s": 4,
          "text": "הנה הידיעה של העם שהמלך הוא בשדה,"
        },
        {
          "s": 5,
          "text": "באותו המקום שהם נמצאים,"
        },
        {
          "s": 6,
          "text": "מעורר אצלם את הרצון להקביל את פני המלך25."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 1,
          "text": "שהרצון של העם להקביל את פני המלך הוא מצד עצם מציאותם."
        },
        {
          "s": 2,
          "text": "דכיון שהמלך הוא הלב של כל העם26,"
        },
        {
          "s": 3,
          "text": "לכן התקשרותם להמלך הוא בעצם מציאותם27,"
        },
        {
          "s": 4,
          "text": "אלא שמ\"מ,"
        },
        {
          "s": 5,
          "text": "כאשר המלך והעם הם בריחוק מקום,"
        },
        {
          "s": 6,
          "text": "אפשר שההתקשרות שלהם להמלך,"
        },
        {
          "s": 7,
          "text": "ו"
        },
        {
          "s": 8,
          "text": "(במילא גם)"
        },
        {
          "s": 9,
          "text": "הרצון שלהם להקביל את פניו יהי' בהעלם,"
        },
        {
          "s": 10,
          "text": "וע\"י שהמלך הוא בשדה,"
        },
        {
          "s": 11,
          "text": "באותו המקום שהם נמצאים,"
        },
        {
          "s": 12,
          "text": "הרצון הוא בגילוי."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ועד\"ז הוא בהנמשל,"
        },
        {
          "s": 1,
          "text": "שההתעוררות לתשובה הבאה ע\"י גילוי יגמה\"ר שבאלול הוא שע\"י הגילוי דיגמה\"ר מתגלה הרצון הפנימי דישראל"
        },
        {
          "s": 2,
          "text": "[וכמובן גם מהמבואר בהמשך המאמר28"
        },
        {
          "s": 3,
          "text": "(לאחרי המשל דמלך בשדה),"
        },
        {
          "s": 4,
          "text": "דשם א-ל הוא ראשית כל הי\"ג מדות ומקורן וכללותן."
        },
        {
          "s": 5,
          "text": "וענין שם א-ל הוא אור א\"ס ב\"ה ממש,"
        },
        {
          "s": 6,
          "text": "כמ\"ש29"
        },
        {
          "s": 7,
          "text": "א-ל הוי' ויאר לנו,"
        },
        {
          "s": 8,
          "text": "דאור הוא כמו העצם"
        },
        {
          "s": 9,
          "text": "[וכמבואר בכ\"מ30"
        },
        {
          "s": 10,
          "text": "החילוק בין אור לשפע,"
        },
        {
          "s": 11,
          "text": "דשפע הוא שהמשפיע מצמצם עצמו לפי\"ע המקבל,"
        },
        {
          "s": 12,
          "text": "ואור הוא מעין המאור]."
        },
        {
          "s": 13,
          "text": "ובכל אחד מישראל מאיר גילוי זה,"
        },
        {
          "s": 14,
          "text": "ויתירה מזו שהגילוי דשם א-ל שבכ\"א מישראל הוא השר והמושל שבקרבו,"
        },
        {
          "s": 15,
          "text": "דישראל הוא אותיות יו\"ד31"
        },
        {
          "s": 16,
          "text": "שר א-ל."
        },
        {
          "s": 17,
          "text": "וזהו שהביטול לאלקות שבכל אחד מישראל הוא ביטול שלמעלה מטעם ודעת,"
        },
        {
          "s": 18,
          "text": "כי בישראל הוא גילוי אור א\"ס ב\"ה עצמו ממש שלמעלה מהשתלשלות."
        },
        {
          "s": 19,
          "text": "וע\"י הגילוי די\"ג מדות הרחמים"
        },
        {
          "s": 20,
          "text": "(שבאלול)"
        },
        {
          "s": 21,
          "text": "שראשיתן ומקורן וכללותן הוא א-ל,"
        },
        {
          "s": 22,
          "text": "מתעורר ומתגלה בחינת א-ל שבכל אחד מישראל]."
        },
        {
          "s": 23,
          "text": "וזהו שהעבודה דאלול היא אני לדודי,"
        },
        {
          "s": 24,
          "text": "אף שההתעוררות היא ע\"י הגילוי מלמעלה,"
        },
        {
          "s": 25,
          "text": "כי הגילוי שמלמעלה הוא רק סיבה שעל ידו מתגלה הרצון הפנימי דהאדם."
        }
      ]
    }
  ]
}