{
  "globalIndex": 607,
  "owner": 7,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917230_theRebbe_81__p001",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917230_theRebbe_81__p001",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518917230_theRebbe_81",
  "title": "רשימת מאמר כי תשא תשי\"א",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "[בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ ויקהל,"
        },
        {
          "s": 2,
          "text": "פרשת שקלים,"
        },
        {
          "s": 3,
          "text": "מבה\"ח אדר-שני,"
        },
        {
          "s": 4,
          "text": "ה'תשי\"א*]"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "כי תשא את ראש בנ\"י,"
        },
        {
          "s": 1,
          "text": "מרע\"ה דוקא רע\"מ ורעה אמונה אמונת או\"ה"
        },
        {
          "s": 2,
          "text": "(סידור)"
        },
        {
          "s": 3,
          "text": "בנ\"י,"
        },
        {
          "s": 4,
          "text": "מקיף וצ\"ל רעה,"
        },
        {
          "s": 5,
          "text": "בפנימיות."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "כי תשא את ראש בנ\"י לפקודיהם ונתנו גו'."
        },
        {
          "s": 1,
          "text": "וצ\"ל דהול\"ל כי תפקוד את בנ\"י ומהו תשא ואת ראש דוקא,"
        },
        {
          "s": 2,
          "text": "ולהבין זה הנה תוכן הפרשה הם ב' ענינים: שיקח משה מחה\"ש מכאו\"א לעבודת אוה\"מ."
        },
        {
          "s": 3,
          "text": "מצוה לדורות לתת בכל שנה מחה\"ש ללשכת המקדש ומשם היו מקריבים קרבנות הציבור וכו',"
        },
        {
          "s": 4,
          "text": "וכמפורש במשנה שקלים,"
        },
        {
          "s": 5,
          "text": "והנה ענין הראשון אינו חיוב תמידי כי משה נצטוה למנות את בנ\"י ואינו ציווי לדורות,"
        },
        {
          "s": 6,
          "text": "ואדרבה,"
        },
        {
          "s": 7,
          "text": "וכמאמר יואב שהשתמט ממנין בנ\"י."
        },
        {
          "s": 8,
          "text": "ענין הב' שנלקחו מחה\"ש לאדנים לא הי' אלא פ\"א,"
        },
        {
          "s": 9,
          "text": "כמובן."
        },
        {
          "s": 10,
          "text": "חיוב הג' למדו רז\"ל – ומוכח ג\"כ מדה\"ב כד,"
        },
        {
          "s": 11,
          "text": "ט – חיוב תמידי בכל שנה ושנה לתת מחה\"ש ושיקריבו ממנו קרבנות כו',"
        },
        {
          "s": 12,
          "text": "ומנין בנ\"י בזה אינו נוגע כלל לידע סכומם,"
        },
        {
          "s": 13,
          "text": "ומשמע בכ\"מ דגם לא מנו אותם."
        },
        {
          "s": 14,
          "text": "וא\"כ יקשה דמשטחיות הלשון משמע דלכל עניני הפרשה שייכת ההקדמה דכי תשא את ראש בנ\"י."
        }
      ]
    }
  ]
}