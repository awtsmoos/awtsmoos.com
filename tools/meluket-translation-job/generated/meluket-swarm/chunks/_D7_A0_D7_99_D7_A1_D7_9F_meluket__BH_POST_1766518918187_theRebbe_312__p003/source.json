{
  "globalIndex": 756,
  "owner": 6,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918187_theRebbe_312__p003",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918187_theRebbe_312__p003",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518918187_theRebbe_312",
  "title": "מאמר החודש הזה לכם תשל\"א",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "וכדי להגיע לדרגא זו שלמעלה גם מבחינת אני הוי' לא שניתי,"
        },
        {
          "s": 1,
          "text": "ה\"ז ע\"י עבודה בכח עצמו דוקא."
        },
        {
          "s": 2,
          "text": "דהנה33,"
        },
        {
          "s": 3,
          "text": "אף שאם צדקת מה תתן לו וגו'34,"
        },
        {
          "s": 4,
          "text": "מ\"מ,"
        },
        {
          "s": 5,
          "text": "הרי עבודה היא צורך גבוה35,"
        },
        {
          "s": 6,
          "text": "וכמארז\"ל36"
        },
        {
          "s": 7,
          "text": "שהקב\"ה אמר למשה הי' לך לעזרני,"
        },
        {
          "s": 8,
          "text": "מיד אמר לו ועתה יגדל נא כח אדני37,"
        },
        {
          "s": 9,
          "text": "וכמבואר בדרושים38"
        },
        {
          "s": 10,
          "text": "עה\"פ ועתה יגדל נא וגו',"
        },
        {
          "s": 11,
          "text": "דישנו בחינת כח אדני מצ\"ע,"
        },
        {
          "s": 12,
          "text": "וע\"י העבודה נעשה ההגדלה בכח אדני."
        },
        {
          "s": 13,
          "text": "והענין הוא,"
        },
        {
          "s": 14,
          "text": "כמ\"ש39"
        },
        {
          "s": 15,
          "text": "למעשה ידיך תכסוף,"
        },
        {
          "s": 16,
          "text": "תכסוף הוא מלשון תענוג,"
        },
        {
          "s": 17,
          "text": "וכיון שתענוג תמידי אינו תענוג40,"
        },
        {
          "s": 18,
          "text": "לכן,"
        },
        {
          "s": 19,
          "text": "רק ע\"י העבודה למטה בכח עצמו,"
        },
        {
          "s": 20,
          "text": "שזהו\"ע של חידוש,"
        },
        {
          "s": 21,
          "text": "נעשה אמיתית התענוג למעלה,"
        },
        {
          "s": 22,
          "text": "ולכן עי\"ז דוקא נעשית ההמשכה מבחינת הפנימיות."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "וזהו מה שאמרו רז\"ל כשבחר הקב\"ה בעולמו קבע בו ראשי חדשים ושנים,"
        },
        {
          "s": 1,
          "text": "ומשבחר ביעקב ובניו קבע להם ראש חודש של גאולה."
        },
        {
          "s": 2,
          "text": "כי,"
        },
        {
          "s": 3,
          "text": "תחילת התהוות העולמות היתה מצד עצמו,"
        },
        {
          "s": 4,
          "text": "כי חפץ חסד הוא41,"
        },
        {
          "s": 5,
          "text": "ולא מצד עבודת האדם,"
        },
        {
          "s": 6,
          "text": "וכמ\"ש42"
        },
        {
          "s": 7,
          "text": "ואדם אין לעבוד את האדמה"
        },
        {
          "s": 8,
          "text": "(ורק לאח\"ז נעשה הסדר דאד יעלה מן הארץ והשקה את כל פני האדמה43)."
        },
        {
          "s": 9,
          "text": "ולכן,"
        },
        {
          "s": 10,
          "text": "אף שההתהוות מצד כי חפץ חסד היא מבחינת חסד שלמעלה מהשתלשלות,"
        },
        {
          "s": 11,
          "text": "ועד לבחינת חפץ חסד כמו שהוא לפני הצמצום,"
        },
        {
          "s": 12,
          "text": "ה\"ז רק מבחינת חיצוניות,"
        },
        {
          "s": 13,
          "text": "ומשם נמשכת הנהגה טבעית באופן דלא ישבותו,"
        },
        {
          "s": 14,
          "text": "שבה מתגלה הענין דאני הוי' לא שניתי,"
        },
        {
          "s": 15,
          "text": "בחינת החיצוניות."
        },
        {
          "s": 16,
          "text": "ומשבחר ביעקב ובניו,"
        },
        {
          "s": 17,
          "text": "שאז התחיל ענין העבודה בכח עצמו,"
        },
        {
          "s": 18,
          "text": "שעל ידה פועלים אמיתת התענוג למעלה"
        },
        {
          "s": 19,
          "text": "(למעשה ידיך תכסוף),"
        },
        {
          "s": 20,
          "text": "אזי מגיעים לבחינת הפנימיות שלמעלה גם מבחינת אני הוי' לא שניתי,"
        },
        {
          "s": 21,
          "text": "ומשם נמשכת הנהגה ניסית,"
        },
        {
          "s": 22,
          "text": "ראש חודש של גאולה."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יש לבאר השייכות דהנהגה ניסית לכללות הענין דראש חודש,"
        },
        {
          "s": 2,
          "text": "שהרי ר\"ח ניסן"
        },
        {
          "s": 3,
          "text": "(ר\"ה להנהגה נסית)"
        },
        {
          "s": 4,
          "text": "הוא ראש חדשים."
        },
        {
          "s": 5,
          "text": "ובהקדם הביאור במאמר האבן עזרא אין ללבנה שנה כלל כאשר אין לשמש חודש כלל,"
        },
        {
          "s": 6,
          "text": "דלכאורה,"
        },
        {
          "s": 7,
          "text": "כיון שהילוך שניהם"
        },
        {
          "s": 8,
          "text": "(הלבנה והחמה)"
        },
        {
          "s": 9,
          "text": "הוא באופן שתמיד חוזרים וסובבים כו',"
        },
        {
          "s": 10,
          "text": "מהו החילוק ביניהם ששנה שייכת לחמה וחודש שייך ללבנה דוקא,"
        },
        {
          "s": 11,
          "text": "הרי גם הלבנה סובבת והולכת תמיד כמקודם."
        },
        {
          "s": 12,
          "text": "והביאור הוא בפשטות,"
        },
        {
          "s": 13,
          "text": "שבהילוך החמה אין שום שינוי וחידוש"
        },
        {
          "s": 14,
          "text": "(כי אם שבכל שנה חוזרת וסובבת כמקודם,"
        },
        {
          "s": 15,
          "text": "שנה מלשון משנה),"
        },
        {
          "s": 16,
          "text": "משא\"כ הילוך הלבנה הוא באופן שיש בו שינוי וחידוש,"
        },
        {
          "s": 17,
          "text": "שבמשך ימי החודש משתנית הלבנה מקטנות לגדלות,"
        },
        {
          "s": 18,
          "text": "שבתחילת החודש ה\"ה בקטנות,"
        },
        {
          "s": 19,
          "text": "ומיום ליום הולכת וגדלה עד לאמצע החודש,"
        },
        {
          "s": 20,
          "text": "ואח\"כ הולכת ומתמעטת ועד שבסוף החודש מתעלמת לגמרי,"
        },
        {
          "s": 21,
          "text": "ולאח\"ז נעשה מולד הלבנה מחדש,"
        },
        {
          "s": 22,
          "text": "שלכן נקרא חודש,"
        },
        {
          "s": 23,
          "text": "מלשון התחדשות44,"
        },
        {
          "s": 24,
          "text": "שמקבלת אור חדש מהשמש."
        },
        {
          "s": 25,
          "text": "וזהו\"ע יחוד שמשא וסיהרא שבר\"ח,"
        },
        {
          "s": 26,
          "text": "שהוא יחוד פנימי45,"
        },
        {
          "s": 27,
          "text": "דאף שיחוד שמשא וסיהרא הו\"ע תמידי שישנו בכל החודש,"
        },
        {
          "s": 28,
          "text": "שהרי תמיד מקבלת הלבנה אורה מהשמש,"
        },
        {
          "s": 29,
          "text": "מ\"מ,"
        },
        {
          "s": 30,
          "text": "אין זה אלא יחוד חיצוני,"
        },
        {
          "s": 31,
          "text": "והתחלתו וראשיתו בר\"ח,"
        },
        {
          "s": 32,
          "text": "שאז הוא יחוד שמשא וסיהרא יחוד פנימי"
        },
        {
          "s": 33,
          "text": "[ובנוגע ליחוד פנימי,"
        },
        {
          "s": 34,
          "text": "הנה על זה אמרו רז\"ל46"
        },
        {
          "s": 35,
          "text": "אין הקב\"ה נכנס בירושלים של מטה עד שיכנס בירושלים של מעלה47]."
        },
        {
          "s": 36,
          "text": "וזהו גם החילוק שבין הנהגה טבעית והנהגה ניסית,"
        },
        {
          "s": 37,
          "text": "שהנהגה תמידית נמשכת ע\"י יחוד חיצוני,"
        },
        {
          "s": 38,
          "text": "שהוא יחוד תמידי,"
        },
        {
          "s": 39,
          "text": "והנהגה ניסית נמשכת ע\"י יחוד פנימי,"
        },
        {
          "s": 40,
          "text": "גילוי אור חדש שנמשך מבחינה שלמעלה מהשתלשלות לגמרי."
        },
        {
          "s": 41,
          "text": "ועז\"נ החודש הזה לכם ראש חדשים גו',"
        },
        {
          "s": 42,
          "text": "שראש חודש שענינו יחוד פנימי,"
        },
        {
          "s": 43,
          "text": "שייך להנהגה ניסית,"
        },
        {
          "s": 44,
          "text": "ר\"ח של גאולה."
        }
      ]
    }
  ]
}