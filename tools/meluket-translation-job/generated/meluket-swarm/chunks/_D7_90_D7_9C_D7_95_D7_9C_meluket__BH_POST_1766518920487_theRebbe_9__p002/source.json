{
  "globalIndex": 1118,
  "owner": 18,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920487_theRebbe_9__p002",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920487_theRebbe_9__p002",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920487_theRebbe_9",
  "title": "מאמר לך אמר לבי תש\"כ",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "וממשיך בהמאמר10"
        },
        {
          "s": 1,
          "text": "(לאחרי שמבאר באריכות הענין דמבשרי אחזה אלוקה),"
        },
        {
          "s": 2,
          "text": "שבכדי שתהי' התעוררות המדות שבלב,"
        },
        {
          "s": 3,
          "text": "צריכה להיות הכנה לזה."
        },
        {
          "s": 4,
          "text": "דהגם שהתעוררות המדות שבלב היא ע\"י התבוננות,"
        },
        {
          "s": 5,
          "text": "מ\"מ,"
        },
        {
          "s": 6,
          "text": "בכדי שאור המוחין יאיר בלבו לעורר את המדות,"
        },
        {
          "s": 7,
          "text": "צריך להיות הכנה לזה גם מצד הלב."
        },
        {
          "s": 8,
          "text": "וההכנה לזה היא המרירות שקודם התפלה."
        },
        {
          "s": 9,
          "text": "דע\"י שמתבונן בתכלית ירידת נשמתו למטה שהיא ירידה צורך עלי',"
        },
        {
          "s": 10,
          "text": "שע\"י עבודתה בתומ\"צ תתעלה למדריגה נעלית יותר מכמו שהיתה קודם ירידתה,"
        },
        {
          "s": 11,
          "text": "ואיך שהוא מתנהג בפועל,"
        },
        {
          "s": 12,
          "text": "דלא זו בלבד שאינו עוסק בתומ\"צ כדבעי"
        },
        {
          "s": 13,
          "text": "(שלכן העלי' דהנשמה שע\"י הירידה אינה בשלימות),"
        },
        {
          "s": 14,
          "text": "הנה ע\"י מעשיו הבלתי רצויים הוא מוריד את נשמתו למטה עוד יותר,"
        },
        {
          "s": 15,
          "text": "ובפרט כשמתבונן בהמשל דהאוחז ראשו של מלך כו'11,"
        },
        {
          "s": 16,
          "text": "יבוא למרירות גדולה."
        },
        {
          "s": 17,
          "text": "וע\"י מרירות זו נעשה החרישה בקרקע לבבו,"
        },
        {
          "s": 18,
          "text": "שנעשה מוכן להתעוררות"
        },
        {
          "s": 19,
          "text": "(ע\"י התבוננות)"
        },
        {
          "s": 20,
          "text": "אמיתית במדות שבלב."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "וממשיך בהמאמר10,"
        },
        {
          "s": 1,
          "text": "דכ\"ז הוא גם בכל ימות השנה,"
        },
        {
          "s": 2,
          "text": "ובפרט בחודש אלול שהוא זמן התגלות י\"ג מדות הרחמים12,"
        },
        {
          "s": 3,
          "text": "והגילוי די\"ג מדות הרחמים דחודש אלול הוא לכל,"
        },
        {
          "s": 4,
          "text": "גם להרחוקים ביותר."
        },
        {
          "s": 5,
          "text": "וכהמשל דמלך בשדה13"
        },
        {
          "s": 6,
          "text": "שאז רשאים ויכולים14"
        },
        {
          "s": 7,
          "text": "כל מי שרוצה להקביל פניו"
        },
        {
          "s": 8,
          "text": "(ולמסור לו את בקשותיהם),"
        },
        {
          "s": 9,
          "text": "והוא מקבל את כולם בסבר פנים יפות ומראה פנים שוחקות לכולם."
        },
        {
          "s": 10,
          "text": "[ויש להוסיף,"
        },
        {
          "s": 11,
          "text": "דהגם שהביאור"
        },
        {
          "s": 12,
          "text": "(בהמאמר)"
        },
        {
          "s": 13,
          "text": "בהמעלה דחודש אלול בא בהמשך לענין המרירות,"
        },
        {
          "s": 14,
          "text": "דכיון שבאלול הוא הגילוי די\"ג מדות הרחמים גם להרחוקים לכן הוא זמן מסוגל ביותר לעשות חרישה בקרקע לבבו ע\"י המרירות,"
        },
        {
          "s": 15,
          "text": "הגילוי די\"ג מדות הרחמים שבאלול צריך להוסיף גם בענין השמחה."
        },
        {
          "s": 16,
          "text": "דמכיון שבאלול מראה המלך פנים שוחקות לכולם,"
        },
        {
          "s": 17,
          "text": "ה\"ז צריך לעורר"
        },
        {
          "s": 18,
          "text": "(כמים הפנים לפנים15)"
        },
        {
          "s": 19,
          "text": "תוספות שמחה בעבודת המלך]."
        },
        {
          "s": 20,
          "text": "ומסיים בהמאמר,"
        },
        {
          "s": 21,
          "text": "דהפירוש לך אמר לבי בשבילך ובשליחותך,"
        },
        {
          "s": 22,
          "text": "הוא,"
        },
        {
          "s": 23,
          "text": "שהלב הוא בשבילו ית' להשלים רצונו ית' לעשות את המטה דירה לו ית',"
        },
        {
          "s": 24,
          "text": "והפירוש לך אמר לבי במקומך הוא ענין נקודת היהדות שישנה בכאו\"א מישראל שמקושרת בהעצמות."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ולהבין הביאור בשני הפירושים בלך אמר לבי,"
        },
        {
          "s": 2,
          "text": "והשייכות שלהם להענינים המבוארים בהמאמר"
        },
        {
          "s": 3,
          "text": "[הענין דמבשרי אחזה אלוקה,"
        },
        {
          "s": 4,
          "text": "ושבכדי שתהי' התעוררות מדות שבלב צריכה להיות הכנה לזה,"
        },
        {
          "s": 5,
          "text": "וכו']"
        },
        {
          "s": 6,
          "text": "יש להקדים מ\"ש הרב המגיד16"
        },
        {
          "s": 7,
          "text": "בשם הבעש\"ט שבכל תיבה17"
        },
        {
          "s": 8,
          "text": "מתיבות התפלה ישנם ג' בחינות,"
        },
        {
          "s": 9,
          "text": "עולמות נשמות ואלקות."
        },
        {
          "s": 10,
          "text": "ועפ\"ז יש לומר גם בנוגע לבקשו פני,"
        },
        {
          "s": 11,
          "text": "שהעבודה דבקשו פני היא בתפלה,"
        },
        {
          "s": 12,
          "text": "שהיא בג' בחינות אלו."
        },
        {
          "s": 13,
          "text": "דבתיבת פני"
        },
        {
          "s": 14,
          "text": "(שבפסוק זה),"
        },
        {
          "s": 15,
          "text": "ג' פירושים."
        },
        {
          "s": 16,
          "text": "דלפירוש רש\"י בלך אמר לבי,"
        },
        {
          "s": 17,
          "text": "שהלב אומר בשליחותו או במקומו של הקב\"ה,"
        },
        {
          "s": 18,
          "text": "פני קאי על פניו ית',"
        },
        {
          "s": 19,
          "text": "פנימיות דאלקות."
        },
        {
          "s": 20,
          "text": "ואדמו\"ר הזקן מפרש18,"
        },
        {
          "s": 21,
          "text": "דזה שהלב אומר בקשו פני קאי על הפנימיות שלו,"
        },
        {
          "s": 22,
          "text": "פנימיות הלב,"
        },
        {
          "s": 23,
          "text": "הפנימיות דנשמות."
        },
        {
          "s": 24,
          "text": "ועוד פירוש בבקשו פני19,"
        },
        {
          "s": 25,
          "text": "שפני קאי על אצילות,"
        },
        {
          "s": 26,
          "text": "כי ד' המדריגות פנים ואחור ימין ושמאל הם ד' העולמות אבי\"ע"
        },
        {
          "s": 27,
          "text": "[אחור – עשי',"
        },
        {
          "s": 28,
          "text": "שמאל – יצירה,"
        },
        {
          "s": 29,
          "text": "ימין – בריאה,"
        },
        {
          "s": 30,
          "text": "ופנים – אצילות],"
        },
        {
          "s": 31,
          "text": "פנימיות העולמות."
        }
      ]
    }
  ]
}