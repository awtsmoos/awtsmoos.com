{
  "globalIndex": 664,
  "owner": 14,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917669_theRebbe_390__p002",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917669_theRebbe_390__p002",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917669_theRebbe_390",
  "title": "מאמר החודש הזה לכם תשמ\"ז",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ובכדי לבאר גודל העילוי של הגילויים דתורה,"
        },
        {
          "s": 2,
          "text": "מבאר תחלה העילוי דהגילויים שבעולמות,"
        },
        {
          "s": 3,
          "text": "דהגילוי אשר בעולמות הוא למעלה מהעולמות."
        },
        {
          "s": 4,
          "text": "דעולמות הם במדידה והגבלה,"
        },
        {
          "s": 5,
          "text": "דכמו ששמים וארץ שלמטה"
        },
        {
          "s": 6,
          "text": "(שבעוה\"ז הגשמי)"
        },
        {
          "s": 7,
          "text": "הם במדידה והגבלה,"
        },
        {
          "s": 8,
          "text": "מהארץ לרקיע מהלך ת\"ק שנה עובי כל רקיע וכו'10,"
        },
        {
          "s": 9,
          "text": "כמו\"כ הוא גם בנוגע לשמים וארץ שבעולמות בי\"ע הרוחניים שהם במדידה והגבלה."
        },
        {
          "s": 10,
          "text": "ושרש ההגבלה דבי\"ע הוא מהכלים דאצילות,"
        },
        {
          "s": 11,
          "text": "דמזה מובן שגם הכלים דאצילות,"
        },
        {
          "s": 12,
          "text": "עם היותם אלקות,"
        },
        {
          "s": 13,
          "text": "הם בחינת גבול."
        },
        {
          "s": 14,
          "text": "משא\"כ הגילוי שבעולמות,"
        },
        {
          "s": 15,
          "text": "היינו האור"
        },
        {
          "s": 16,
          "text": "(אור הקו)"
        },
        {
          "s": 17,
          "text": "שנמשך בהם,"
        },
        {
          "s": 18,
          "text": "דשרשו הוא מעצמות אוא\"ס שלפני הצמצום11,"
        },
        {
          "s": 19,
          "text": "הוא בבחינת בלי גבול,"
        },
        {
          "s": 20,
          "text": "אלא שע\"י התלבשותו בכלים הוא בא בציור והתחלקות."
        },
        {
          "s": 21,
          "text": "אבל זה שע\"י התלבשותו בכלים הוא בא בציור וגבול,"
        },
        {
          "s": 22,
          "text": "הוא12"
        },
        {
          "s": 23,
          "text": "מפני שגם מצד עצמו"
        },
        {
          "s": 24,
          "text": "(לפני שנתלבש בכלים)"
        },
        {
          "s": 25,
          "text": "הוא בגדר גבול."
        },
        {
          "s": 26,
          "text": "דמכיון שהמשכתו מאוא\"ס שלפני הצמצום היא ע\"י הפסק הצמצום,"
        },
        {
          "s": 27,
          "text": "הנה עי\"ז הוא נמדד"
        },
        {
          "s": 28,
          "text": "(בכללותו)"
        },
        {
          "s": 29,
          "text": "לפי ערך הכלים והעולמות,"
        },
        {
          "s": 30,
          "text": "ולכן,"
        },
        {
          "s": 31,
          "text": "לאחרי שנמשך"
        },
        {
          "s": 32,
          "text": "(ע\"י כמה מסכים ופרסאות שלפני האצילות13)"
        },
        {
          "s": 33,
          "text": "בהכלים דאצילות,"
        },
        {
          "s": 34,
          "text": "הוא מתלבש בהם14"
        },
        {
          "s": 35,
          "text": "ובא בציור מוגבל,"
        },
        {
          "s": 36,
          "text": "ועי\"ז הוא נמשך ומתלבש"
        },
        {
          "s": 37,
          "text": "(ע\"י הפרסא שבין אצילות לבי\"ע)"
        },
        {
          "s": 38,
          "text": "גם בנבראים,"
        },
        {
          "s": 39,
          "text": "להחיות אותם בחיות מוגבל לפי ערכם."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "דמ\"ש בהמאמר דהגילוי שבעולמות הוא אור הקו"
        },
        {
          "s": 3,
          "text": "(שנמשך בהם),"
        },
        {
          "s": 4,
          "text": "הוא כדי לבאר שגם הגילוי שבעולמות הוא בלי גבול."
        },
        {
          "s": 5,
          "text": "דמכיון שאור הקו הוא דבוק במקורו,"
        },
        {
          "s": 6,
          "text": "באוא\"ס שלפני הצמצום"
        },
        {
          "s": 7,
          "text": "(אף שהדביקות שלו היא ע\"י הפסק הצמצום),"
        },
        {
          "s": 8,
          "text": "ה\"ה מעין מקורו15."
        },
        {
          "s": 9,
          "text": "ולכן גם לאחרי שנתלבש בהכלים"
        },
        {
          "s": 10,
          "text": "(בפנימיותם)"
        },
        {
          "s": 11,
          "text": "ומחי' אותם,"
        },
        {
          "s": 12,
          "text": "אינו נתפס בהם."
        },
        {
          "s": 13,
          "text": "דזה מה שהאור מתלבש בכלים בהתלבשות פנימית,"
        },
        {
          "s": 14,
          "text": "בדוגמת חיות הנפש שמתלבשת בהגוף,"
        },
        {
          "s": 15,
          "text": "הוא"
        },
        {
          "s": 16,
          "text": "(בעיקר)"
        },
        {
          "s": 17,
          "text": "בנוגע להכלים,"
        },
        {
          "s": 18,
          "text": "שהכלים מקבלים חיותם מהאור,"
        },
        {
          "s": 19,
          "text": "חיות פנימי"
        },
        {
          "s": 20,
          "text": "(כמו הגוף שחי מהנפש),"
        },
        {
          "s": 21,
          "text": "אבל בנוגע להאור,"
        },
        {
          "s": 22,
          "text": "גם לאחרי שנתלבש בכלים,"
        },
        {
          "s": 23,
          "text": "הוא מובדל מהם16,"
        },
        {
          "s": 24,
          "text": "ועד\"ז הוא גם בנבראים,"
        },
        {
          "s": 25,
          "text": "דחיות הנבראים שבבחינת אור17,"
        },
        {
          "s": 26,
          "text": "שהוא הארה דהארה דהארה מהקו18,"
        },
        {
          "s": 27,
          "text": "שעם היותו מלובש בהנבראים,"
        },
        {
          "s": 28,
          "text": "הוא קדוש ומובדל מהם19."
        },
        {
          "s": 29,
          "text": "ויתירה מזו,"
        },
        {
          "s": 30,
          "text": "דגם חיות הנבראים20"
        },
        {
          "s": 31,
          "text": "שנמשך בהם מהאור,"
        },
        {
          "s": 32,
          "text": "הוא בלתי מוגבל21"
        },
        {
          "s": 33,
          "text": "[וחיבור החיות שמהאור עם גוף הנבראים"
        },
        {
          "s": 34,
          "text": "(דשרשם מהכלים)"
        },
        {
          "s": 35,
          "text": "הוא חיבור שני הפכים22]."
        },
        {
          "s": 36,
          "text": "דכל זה הוא בנוגע להגילוי שבעולמות"
        },
        {
          "s": 37,
          "text": "(אור הקו)"
        },
        {
          "s": 38,
          "text": "כמו שנמשך בכלים ובעולמות."
        },
        {
          "s": 39,
          "text": "ומכ\"ש האור כמו שהוא לפני שנמשך בכלים ובעולמות"
        },
        {
          "s": 40,
          "text": "(דב\"גילוי שבעולמות\" נכללת גם בחינה זו),"
        },
        {
          "s": 41,
          "text": "הוא בלתי מוגבל."
        },
        {
          "s": 42,
          "text": "ומה שנק' בשם גבול הוא רק מצד זה שע\"י הצמצום נעשה בו המדידה שכשיומשך בעולמות"
        },
        {
          "s": 43,
          "text": "(ע\"י מסכים ופרסאות)"
        },
        {
          "s": 44,
          "text": "תהי' ההמשכה באופן שהעולמות יוכלו לקבל."
        },
        {
          "s": 45,
          "text": "ומזה מובן גודל העילוי דהגילויים דתורה שלמעלה מהגילוי שבעולמות,"
        },
        {
          "s": 46,
          "text": "דע\"י התורה נמשך ומתגלה עצמות אוא\"ס שלפני הצמצום."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר23,"
        },
        {
          "s": 2,
          "text": "דהמדידה שבהקו,"
        },
        {
          "s": 3,
          "text": "עם היותה על ידי הצמצום"
        },
        {
          "s": 4,
          "text": "(כנ\"ל),"
        },
        {
          "s": 5,
          "text": "שרשה הוא באוא\"ס שלפני הצמצום."
        },
        {
          "s": 6,
          "text": "דכשעלה ברצונו ית' לברוא את העולמות,"
        },
        {
          "s": 7,
          "text": "שיער בעצמו בכח"
        },
        {
          "s": 8,
          "text": "(לפני הצמצום)"
        },
        {
          "s": 9,
          "text": "כל מה שיהי' בפועל לאחרי הצמצום,"
        },
        {
          "s": 10,
          "text": "בכדי שהתהוות העולמות תהי' כפי שעלה ברצונו ית'."
        },
        {
          "s": 11,
          "text": "ומבאר,"
        },
        {
          "s": 12,
          "text": "דגם שרש המדידה שלפני הצמצום"
        },
        {
          "s": 13,
          "text": "(ההשערה בכח,"
        },
        {
          "s": 14,
          "text": "וגם עליית הרצון)"
        },
        {
          "s": 15,
          "text": "הוא בכלל הגילויים שבעולמות,"
        },
        {
          "s": 16,
          "text": "דהגם שכללות האור שלפני הצמצום אינו בערך העולמות,"
        },
        {
          "s": 17,
          "text": "ובכדי שיומשך ממנו אור שבבחי' מקור לעולמות"
        },
        {
          "s": 18,
          "text": "(אור הקו)"
        },
        {
          "s": 19,
          "text": "הוצרך להיות סילוק האור,"
        },
        {
          "s": 20,
          "text": "מ\"מ,"
        },
        {
          "s": 21,
          "text": "בעצמותו גופא כביכול הוא גילוי ששייך לעולמות."
        },
        {
          "s": 22,
          "text": "ומזה מובן עוד יותר גודל העילוי של הגילויים דתורה,"
        },
        {
          "s": 23,
          "text": "דעל ידי התורה הוא הגילוי דעצמות אוא\"ס שלמעלה מגדר שייכות לעולמות."
        }
      ]
    }
  ]
}