{
  "globalIndex": 75,
  "owner": 25,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914115_theRebbe_704__p003",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914115_theRebbe_704__p003",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914115_theRebbe_704",
  "title": "מאמר שובה ישראל תשמ\"א",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ויובן זה ע\"פ מאמר רז\"ל50"
        },
        {
          "s": 2,
          "text": "מאן דמחוי במחוג קמי מלכא כו',"
        },
        {
          "s": 3,
          "text": "כי בפני המלך צריך להיות בתכלית הביטול וכשמחוה במחוג קמי מלכא הוא מתראה למציאות בפני המלך51."
        },
        {
          "s": 4,
          "text": "ומזה מובן,"
        },
        {
          "s": 5,
          "text": "שגם כשהוא עובד את הוי' אבל עבודתו היא בבחי' מציאות,"
        },
        {
          "s": 6,
          "text": "הוא דוגמת מחוי במחוג קמי מלכא ח\"ו52."
        },
        {
          "s": 7,
          "text": "ועפ\"ז יובן שגם בצדיקים גמורים צ\"ל"
        },
        {
          "s": 8,
          "text": "(גם)"
        },
        {
          "s": 9,
          "text": "ענין התשובה דסור מרע,"
        },
        {
          "s": 10,
          "text": "כי מכיון שגם כשהוא צדיק גמור עובד ה' ביראה ואהבה בתענוגים אינו בטל במציאות לגמרי רק הוא דבר בפני עצמו ירא ה' ואוהבו"
        },
        {
          "s": 11,
          "text": "(יש מי שאוהב ויש מי שירא53)"
        },
        {
          "s": 12,
          "text": "כמבואר בתניא54,"
        },
        {
          "s": 13,
          "text": "הרי נמצא שהקבלת עול מלכות שמים אינה בתכלית השלימות,"
        },
        {
          "s": 14,
          "text": "ולגבי מדריגתו הוא כמו פריקת עול."
        },
        {
          "s": 15,
          "text": "ולכן גם בצ\"ג צ\"ל התשובה דסור מרע."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "וזהו שובה ישראל עד הוי' אלקיך כי כשלת בעוניך,"
        },
        {
          "s": 1,
          "text": "שהתשובה על הכשלון בעון שבדרגת ישראל"
        },
        {
          "s": 2,
          "text": "(יש מי שאוהב)"
        },
        {
          "s": 3,
          "text": "היא שהוי' יהי' אלקיך."
        },
        {
          "s": 4,
          "text": "כי בכדי לשלול ענין הישות"
        },
        {
          "s": 5,
          "text": "(יש מי שאוהב)"
        },
        {
          "s": 6,
          "text": "הוא ע\"י הגילוי דהוי' דוקא."
        },
        {
          "s": 7,
          "text": "דלגבי שם אלקים,"
        },
        {
          "s": 8,
          "text": "מכיון שההתהוות משם אלקים היא בדרך התלבשות"
        },
        {
          "s": 9,
          "text": "(בראשית ברא אלקים55),"
        },
        {
          "s": 10,
          "text": "הנבראים שמתהווים ממנו הם תופסים מקום,"
        },
        {
          "s": 11,
          "text": "והביטול שלהם הוא רק ביטול היש,"
        },
        {
          "s": 12,
          "text": "משא\"כ לגבי שם הוי',"
        },
        {
          "s": 13,
          "text": "שההתהוות ממנו היא באופן דבדרך ממילא"
        },
        {
          "s": 14,
          "text": "(יהללו את שם הוי' כי הוא צוה ונבראו56),"
        },
        {
          "s": 15,
          "text": "הנבראים אינם תופסים מקום,"
        },
        {
          "s": 16,
          "text": "ביטול במציאות57."
        },
        {
          "s": 17,
          "text": "וזהו שהתשובה על כשלת בעוניך שבדרגת ישראל,"
        },
        {
          "s": 18,
          "text": "יש מי שאוהב,"
        },
        {
          "s": 19,
          "text": "היא שהוי' יהי' אלקיך,"
        },
        {
          "s": 20,
          "text": "דע\"י שמאיר בו הגילוי דהוי',"
        },
        {
          "s": 21,
          "text": "ועד שזה"
        },
        {
          "s": 22,
          "text": "(הוי')"
        },
        {
          "s": 23,
          "text": "נעשה אלקיך כחך וחיותך,"
        },
        {
          "s": 24,
          "text": "הוא בא לביטול במציאות."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "והנה מבואר בלקו\"ת58"
        },
        {
          "s": 2,
          "text": "דפירוש שובה ישראל עד הוי' אלקיך הוא שהתשובה צריכה להיות עד שהוי' יהי' רק בחי' אלקים וצמצום לגבי עצמות אוא\"ס שלמעלה מהוי'."
        },
        {
          "s": 3,
          "text": "וע\"ד הפירוש בהוי' הוא האלקים59"
        },
        {
          "s": 4,
          "text": "שאומרים בנעילת יום הכפורים,"
        },
        {
          "s": 5,
          "text": "שז\"א"
        },
        {
          "s": 6,
          "text": "(הוי')"
        },
        {
          "s": 7,
          "text": "בעלותו לעתיקא כאלקים יחשב60."
        },
        {
          "s": 8,
          "text": "ויובן זה ע\"פ הידוע61"
        },
        {
          "s": 9,
          "text": "שגם לגבי שם הוי',"
        },
        {
          "s": 10,
          "text": "מכיון שהוא מקור לההתהוות,"
        },
        {
          "s": 11,
          "text": "דהוי' הוא לשון מהוה62"
        },
        {
          "s": 12,
          "text": "(אלא שההתהוות היא בדרך ממילא),"
        },
        {
          "s": 13,
          "text": "בהכרח שיש איזה תפיסת מקום להנבראים,"
        },
        {
          "s": 14,
          "text": "ואמיתית הביטול הוא דוקא לגבי עצמות אוא\"ס שלמעלה מהוי' שאינו בגדר מקור לעולמות."
        },
        {
          "s": 15,
          "text": "וזהו שהתשובה על כשלת בעוניך"
        },
        {
          "s": 16,
          "text": "(יש מי שאוהב)"
        },
        {
          "s": 17,
          "text": "היא עד הוי' אלקיך"
        },
        {
          "s": 18,
          "text": "(כהפירוש בלקו\"ת)"
        },
        {
          "s": 19,
          "text": "שהוי' הוא אלקים וצמצום לגבי עצמות אוא\"ס,"
        },
        {
          "s": 20,
          "text": "שע\"י הגילוי דעצמות אוא\"ס"
        },
        {
          "s": 21,
          "text": "[עתיקא,"
        },
        {
          "s": 22,
          "text": "שנבדל ונעתק ומובדל ממציאות העולמות63],"
        },
        {
          "s": 23,
          "text": "מגיעים לתכלית הביטול."
        }
      ]
    }
  ]
}