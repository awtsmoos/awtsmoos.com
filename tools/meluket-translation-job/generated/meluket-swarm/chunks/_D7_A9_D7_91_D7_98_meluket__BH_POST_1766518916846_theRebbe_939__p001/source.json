{
  "globalIndex": 530,
  "owner": 30,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916846_theRebbe_939__p001",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916846_theRebbe_939__p001",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916846_theRebbe_939",
  "title": "מאמר באתי לגני תשל\"א",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"ק ומוצאי ש\"ק פ' בשלח,"
        },
        {
          "s": 2,
          "text": "י\"א שבט,"
        },
        {
          "s": 3,
          "text": "ה'תשל\"א"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "באתי לגני אחותי כלה1,"
        },
        {
          "s": 1,
          "text": "ומביא כ\"ק מו\"ח אדמו\"ר בעל ההילולא בהמאמר דיום ההסתלקות ויום ההילולא שלו2,"
        },
        {
          "s": 2,
          "text": "דאיתא במדרש רבה"
        },
        {
          "s": 3,
          "text": "(במקומו)"
        },
        {
          "s": 4,
          "text": "לגני לגנוני,"
        },
        {
          "s": 5,
          "text": "למקום שהי' עיקרי בתחלה,"
        },
        {
          "s": 6,
          "text": "דעיקר שכינה בתחתונים היתה,"
        },
        {
          "s": 7,
          "text": "אלא שע\"י הענינים הבלתי רצויים"
        },
        {
          "s": 8,
          "text": "(מתחיל מחטא עץ הדעת)"
        },
        {
          "s": 9,
          "text": "נסתלקה השכינה מלמטה למעלה עד לרקיע השביעי,"
        },
        {
          "s": 10,
          "text": "ואח\"כ עמדו צדיקים"
        },
        {
          "s": 11,
          "text": "(מתחיל מאברהם אבינו)"
        },
        {
          "s": 12,
          "text": "והורידו את השכינה מלמעלה למטה,"
        },
        {
          "s": 13,
          "text": "עד שבא משה שהוא השביעי,"
        },
        {
          "s": 14,
          "text": "וכל השביעין חביבין3,"
        },
        {
          "s": 15,
          "text": "והורידה למטה בארץ."
        },
        {
          "s": 16,
          "text": "דענין זה"
        },
        {
          "s": 17,
          "text": "(המשכת וירידת השכינה למטה בארץ)"
        },
        {
          "s": 18,
          "text": "נעשה בעיקר4"
        },
        {
          "s": 19,
          "text": "ע\"י המשכן שעשה משה כמ\"ש5"
        },
        {
          "s": 20,
          "text": "ועשו לי מקדש ושכנתי בתוכם."
        },
        {
          "s": 21,
          "text": "וזהו צדיקים יירשו ארץ וישכנו לעד עלי'6,"
        },
        {
          "s": 22,
          "text": "שצדיקים הם משכינים"
        },
        {
          "s": 23,
          "text": "(ממשיכים7)"
        },
        {
          "s": 24,
          "text": "את השכינה שנק' עד,"
        },
        {
          "s": 25,
          "text": "שוכן עד מרום וקדוש8,"
        },
        {
          "s": 26,
          "text": "שתהי' בגילוי למטה."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ולהעיר,"
        },
        {
          "s": 1,
          "text": "שבמדרש שם מבאר תחלה פירוש הפסוק צדיקים יירשו ארץ גו' ולאח\"ז אומר שעיקר השראת השכינה בארץ היתה ביום שהוקם המשכן,"
        },
        {
          "s": 2,
          "text": "ובהמאמר משנה את סדר הענינים,"
        },
        {
          "s": 3,
          "text": "שהפסוק צדיקים יירשו ארץ גו' מובא בהמאמר לאחרי שאומר שעיקר ההמשכה היתה ע\"י עשיית המשכן."
        },
        {
          "s": 4,
          "text": "ויש לומר,"
        },
        {
          "s": 5,
          "text": "שבזה מרמז,"
        },
        {
          "s": 6,
          "text": "דזה שצדיקים ממשיכים השכינה למטה"
        },
        {
          "s": 7,
          "text": "(וישכנו לעד עלי'),"
        },
        {
          "s": 8,
          "text": "הכוונה בזה היא לא רק לההמשכה שע\"י שבעה הצדיקים שמאברהם עד משה"
        },
        {
          "s": 9,
          "text": "(ע\"י עשיית המשכן),"
        },
        {
          "s": 10,
          "text": "אלא גם לההמשכה שלאחרי ההמשכה שהיתה ע\"י עשיית המשכן."
        },
        {
          "s": 11,
          "text": "שגם לאחרי ההמשכה שהיתה ע\"י עשיית המשכן,"
        },
        {
          "s": 12,
          "text": "אף שהיתה המשכה נעלית ביותר,"
        },
        {
          "s": 13,
          "text": "ממשיכים צדיקים,"
        },
        {
          "s": 14,
          "text": "ועמך כולם צדיקים9,"
        },
        {
          "s": 15,
          "text": "המשכה נעלית עוד יותר."
        },
        {
          "s": 16,
          "text": "דלאחרי ההמשכה שע\"י שבעה הצדיקים,"
        },
        {
          "s": 17,
          "text": "ובפרט ע\"י משה שעל ידו נמשכה השכינה למטה בארץ,"
        },
        {
          "s": 18,
          "text": "עי\"ז ניתן הכח לכאו\"א מישראל להמשיך עוד יותר."
        }
      ]
    }
  ]
}