{
  "globalIndex": 738,
  "owner": 38,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918104_theRebbe_982__p001",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918104_theRebbe_982__p001",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518918104_theRebbe_982",
  "title": "מאמר כל ישראל תשל\"ג",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "כל ישראל יש להם חלק לעולם הבא1,"
        },
        {
          "s": 1,
          "text": "דפירוש2"
        },
        {
          "s": 2,
          "text": "עולם הבא במשנה זו הוא עולם התחי',"
        },
        {
          "s": 3,
          "text": "וכדמוכח מהמשך המשנה ואלו שאין להם חלק לעולם הבא האומר אין תחיית המתים מן התורה,"
        },
        {
          "s": 4,
          "text": "שהטעם על זה הוא כדאיתא בגמרא3"
        },
        {
          "s": 5,
          "text": "הוא כפר בתחיית המתים לפיכך לא יהי' לו חלק בתחיית המתים כו' מדה כנגד מדה."
        },
        {
          "s": 6,
          "text": "וכל ישראל יש להם חלק לעולם הבא,"
        },
        {
          "s": 7,
          "text": "דבגן עדן כתיב4"
        },
        {
          "s": 8,
          "text": "מי יעלה בהר הוי' גו' נקי כפים ובר לבב גו',"
        },
        {
          "s": 9,
          "text": "שישנם כמה תנאים בכדי לעלות לג\"ע,"
        },
        {
          "s": 10,
          "text": "אפילו לג\"ע התחתון5,"
        },
        {
          "s": 11,
          "text": "משא\"כ בנוגע עולם התחי' כל ישראל יש להם חלק לעולם הבא6."
        },
        {
          "s": 12,
          "text": "וצריך להבין,"
        },
        {
          "s": 13,
          "text": "הרי הגילוי שיהי' בעולם התחי' הוא נעלה הרבה יותר מהגילוי דג\"ע7,"
        },
        {
          "s": 14,
          "text": "גם מהגילוי שבג\"ע העליון,"
        },
        {
          "s": 15,
          "text": "גם מדרגא הכי נעלית שבג\"ע"
        },
        {
          "s": 16,
          "text": "[וכמובן גם מהענין דתחיית המתים עצמו,"
        },
        {
          "s": 17,
          "text": "דיקומו לתחי' כל ישראל,"
        },
        {
          "s": 18,
          "text": "גם הנשמות שנמצאים בג\"ע כמה אלפים שנה,"
        },
        {
          "s": 19,
          "text": "וג' פעמים בכל יום הם מתעלים לדרגא נעלית יותר,"
        },
        {
          "s": 20,
          "text": "ואעפ\"כ לע\"ל יתלבשו בגופים,"
        },
        {
          "s": 21,
          "text": "כי הגילוי דעולם התחי' הוא נעלה הרבה יותר מהגילוי דג\"ע,"
        },
        {
          "s": 22,
          "text": "גם מדרגא הכי נעלית דג\"ע8],"
        },
        {
          "s": 23,
          "text": "ואעפ\"כ בכדי לזכות להגילוי דג\"ע צ\"ל כמה תנאים,"
        },
        {
          "s": 24,
          "text": "והגילוי דעולם התחי' יהי' לכל ישראל."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים הביאור דענין זה שהגילוי דעולם התחי' הוא נעלה הרבה יותר מהגילוי דג\"ע."
        },
        {
          "s": 2,
          "text": "דלכאורה,"
        },
        {
          "s": 3,
          "text": "כיון שג\"ע הוא עולם הנשמות"
        },
        {
          "s": 4,
          "text": "(נשמות בלא גופים),"
        },
        {
          "s": 5,
          "text": "ובעולם התחי' יהיו נשמות בגופים,"
        },
        {
          "s": 6,
          "text": "מהו הביאור בזה שבעולם התחי',"
        },
        {
          "s": 7,
          "text": "כשהנשמה תהי' מלובשת בגוף גשמי,"
        },
        {
          "s": 8,
          "text": "יהי' גילוי נעלה יותר מבג\"ע."
        },
        {
          "s": 9,
          "text": "והגם שלע\"ל יהי' הגוף בתכלית הזיכוך,"
        },
        {
          "s": 10,
          "text": "וכמו גופו של אדה\"ר"
        },
        {
          "s": 11,
          "text": "(יציר9"
        },
        {
          "s": 12,
          "text": "כפיו של הקב\"ה)10,"
        },
        {
          "s": 13,
          "text": "שהי' מכהה גלגל חמה11,"
        },
        {
          "s": 14,
          "text": "ויתירה מזו,"
        },
        {
          "s": 15,
          "text": "שלע\"ל יהי' הגוף בתכלית השלימות עוד יותר מכמו של אדה\"ר12,"
        },
        {
          "s": 16,
          "text": "הרי זהו לכאורה ביאור רק על זה שלע\"ל יהיו הנשמות המלובשים בגופים כלים לקבל גילוי נעלה יותר מהגילוי שמתגלה עכשיו לנשמות בלא גופים."
        },
        {
          "s": 17,
          "text": "אבל אין בזה ביאור על זה שהגילוי דלע\"ל יהי' דוקא לנשמות בגופים."
        },
        {
          "s": 18,
          "text": "דהגם שגם לע\"ל,"
        },
        {
          "s": 19,
          "text": "כשהגוף יהי' בתכלית השלימות,"
        },
        {
          "s": 20,
          "text": "יהי' גוף גשמי,"
        },
        {
          "s": 21,
          "text": "דההגבלות שבדבר גשמי הם יותר מההגבלות שבדבר רוחני13,"
        },
        {
          "s": 22,
          "text": "וכמו ההגבלה דזמן ומקום שהיא"
        },
        {
          "s": 23,
          "text": "(בעיקר)"
        },
        {
          "s": 24,
          "text": "בדברים גשמיים14,"
        },
        {
          "s": 25,
          "text": "ואעפ\"כ,"
        },
        {
          "s": 26,
          "text": "בכדי שהנשמה תוכל לקבל הגילוי דלע\"ל,"
        },
        {
          "s": 27,
          "text": "הוא דוקא ע\"י שמתלבשת בגוף גשמי."
        },
        {
          "s": 28,
          "text": "והיינו,"
        },
        {
          "s": 29,
          "text": "שמהחילוקים בין הגילוי דג\"ע והגילוי דלע\"ל הוא שבכדי לקבל הגילוי דג\"ע הוא ע\"י ההפשטה מדברים הגשמיים."
        },
        {
          "s": 30,
          "text": "שקודם עליית הנשמה לג\"ע צריך להיות תחלה הטבילה בנהר דינור לשכוח חיזו דהאי עלמא15."
        },
        {
          "s": 31,
          "text": "[ועד\"ז הוא בהעליות שבג\"ע עצמו,"
        },
        {
          "s": 32,
          "text": "שבכל עלי' צריך תחלה לשכוח ההשגה והתענוג דמדריגה התחתונה15]."
        },
        {
          "s": 33,
          "text": "ובכדי לקבל הגילוי דלע\"ל הוא ע\"י שמתלבשת בגוף גשמי."
        }
      ]
    }
  ]
}