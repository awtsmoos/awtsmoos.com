{
  "globalIndex": 502,
  "owner": 2,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916754_theRebbe_640__p001",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916754_theRebbe_640__p001",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916754_theRebbe_640",
  "title": "מאמר באתי לגני תשכ\"ח",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "מוצש\"ק פ' בשלח,"
        },
        {
          "s": 2,
          "text": "י\"א שבט"
        },
        {
          "s": 3,
          "text": "(מאמר ב),"
        },
        {
          "s": 4,
          "text": "ה'תשכ\"ח"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "באתי לגני אחותי כלה1,"
        },
        {
          "s": 1,
          "text": "ומביא כ\"ק מו\"ח אדמו\"ר בעל ההילולא בהמאמר דיום ההסתלקות ויום ההילולא שלו2,"
        },
        {
          "s": 2,
          "text": "דאיתא במדרש רבה"
        },
        {
          "s": 3,
          "text": "(במקומו)"
        },
        {
          "s": 4,
          "text": "לגני לגנוני,"
        },
        {
          "s": 5,
          "text": "למקום שהי' עיקרי בתחלה,"
        },
        {
          "s": 6,
          "text": "דעיקר שכינה בתחתונים היתה,"
        },
        {
          "s": 7,
          "text": "אלא שע\"י הענינים הבלתי רצויים"
        },
        {
          "s": 8,
          "text": "(מתחיל מחטא עה\"ד)"
        },
        {
          "s": 9,
          "text": "נסתלקה השכינה מלמטה למעלה עד רקיע השביעי,"
        },
        {
          "s": 10,
          "text": "ואח\"כ עמדו צדיקים"
        },
        {
          "s": 11,
          "text": "(מתחיל מאברהם אבינו,"
        },
        {
          "s": 12,
          "text": "אחד הי' אברהם3)"
        },
        {
          "s": 13,
          "text": "והורידו את השכינה מלמעלה למטה,"
        },
        {
          "s": 14,
          "text": "עד שבא משה שהוא השביעי"
        },
        {
          "s": 15,
          "text": "(דכל השביעין חביבין4)"
        },
        {
          "s": 16,
          "text": "והורידה למטה בארץ."
        },
        {
          "s": 17,
          "text": "דענין זה"
        },
        {
          "s": 18,
          "text": "(ירידת והמשכת השכינה למטה בארץ)"
        },
        {
          "s": 19,
          "text": "נעשה בעיקר ע\"י המשכן5"
        },
        {
          "s": 20,
          "text": "שעשה משה כמ\"ש6"
        },
        {
          "s": 21,
          "text": "ועשו לי מקדש ושכנתי בתוכם."
        },
        {
          "s": 22,
          "text": "וזהו7"
        },
        {
          "s": 23,
          "text": "שהמשכן הי' מעצי שטים,"
        },
        {
          "s": 24,
          "text": "כי המשכת עיקר שכינה למטה היא ע\"י העבודה דאתכפיא ואתהפכא,"
        },
        {
          "s": 25,
          "text": "כמאמר8"
        },
        {
          "s": 26,
          "text": "כד אתכפיא סט\"א אסתלק יקרא דקוב\"ה בכולהו עלמין,"
        },
        {
          "s": 27,
          "text": "המשכת וגילוי עצמות אוא\"ס שלמעלה משייכות לעולמות"
        },
        {
          "s": 28,
          "text": "[שלכן נקראת המשכה זו בשם אסתלק,"
        },
        {
          "s": 29,
          "text": "לפי שהוא גילוי האור שבבחינת רוממות9],"
        },
        {
          "s": 30,
          "text": "עיקר שכינה,"
        },
        {
          "s": 31,
          "text": "ומכיון שהמשכה זו היא ע\"י העבודה דאתכפיא ואתהפכא,"
        },
        {
          "s": 32,
          "text": "לכן הי' המשכן מעצי שטים,"
        },
        {
          "s": 33,
          "text": "שטים מלשון שטות10,"
        },
        {
          "s": 34,
          "text": "היינו שטות דלעו\"ז"
        },
        {
          "s": 35,
          "text": "(אין אדם עובר עבירה אא\"כ נכנס בו רוח שטות11),"
        },
        {
          "s": 36,
          "text": "וע\"י העבודה דועשית את הקרשים למשכן עצי שטים עומדים12,"
        },
        {
          "s": 37,
          "text": "שמהפכים השטות דלעו\"ז לשטות דקדושה"
        },
        {
          "s": 38,
          "text": "(עצי שטים עומדים),"
        },
        {
          "s": 39,
          "text": "עי\"ז נעשה ושכנתי בתוכם,"
        },
        {
          "s": 40,
          "text": "המשכת עיקר שכינה בתחתונים."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר13,"
        },
        {
          "s": 2,
          "text": "דזהו גם מה שאחת העבודות"
        },
        {
          "s": 3,
          "text": "[ויש לומר,"
        },
        {
          "s": 4,
          "text": "שפירוש \"אחת העבודות\" הוא העבודה המיוחדת והעיקרית14"
        },
        {
          "s": 5,
          "text": "שבמקדש]"
        },
        {
          "s": 6,
          "text": "היא עבודת הקרבנות15,"
        },
        {
          "s": 7,
          "text": "כי עבודת הקרבנות היא שלוקחים בהמה"
        },
        {
          "s": 8,
          "text": "(שחיותה הוא מקליפת נוגה16)"
        },
        {
          "s": 9,
          "text": "ועושים אותה קרבן להוי',"
        },
        {
          "s": 10,
          "text": "ובפרט לפי פירוש אדמו\"ר הזקן17"
        },
        {
          "s": 11,
          "text": "עה\"פ18"
        },
        {
          "s": 12,
          "text": "אדם כי יקריב מכם גו',"
        },
        {
          "s": 13,
          "text": "דמ\"ש אדם כי יקריב מכם"
        },
        {
          "s": 14,
          "text": "(ולא אדם מכם כי יקריב)"
        },
        {
          "s": 15,
          "text": "הוא לרמז שהקרבן צריך להיות"
        },
        {
          "s": 16,
          "text": "(לא רק מן הבהמה כפשוטה,"
        },
        {
          "s": 17,
          "text": "אלא גם)"
        },
        {
          "s": 18,
          "text": "מכם,"
        },
        {
          "s": 19,
          "text": "פון אייך אַליין,"
        },
        {
          "s": 20,
          "text": "מן הבהמה שבלבו של אדם,"
        },
        {
          "s": 21,
          "text": "דכשעושה מהבהמה שבו"
        },
        {
          "s": 22,
          "text": "(נפש הבהמית)"
        },
        {
          "s": 23,
          "text": "קרבן להוי',"
        },
        {
          "s": 24,
          "text": "הו\"ע אתכפיא ואתהפכא."
        },
        {
          "s": 25,
          "text": "וע\"י שמהפך את הבהמה"
        },
        {
          "s": 26,
          "text": "[הבהמה כפשוטה,"
        },
        {
          "s": 27,
          "text": "והבהמה שבלבו]"
        },
        {
          "s": 28,
          "text": "לקדושה,"
        },
        {
          "s": 29,
          "text": "הנה זה מגיע בעצמות אוא\"ס שלמעלה משייכות לעולמות"
        },
        {
          "s": 30,
          "text": "(עיקר שכינה),"
        },
        {
          "s": 31,
          "text": "דרזא דקורבנא עולה עד רזא דא\"ס19,"
        },
        {
          "s": 32,
          "text": "ואור זה נמשך למטה."
        },
        {
          "s": 33,
          "text": "דבקרבנות כתיב20"
        },
        {
          "s": 34,
          "text": "ריח ניחוח,"
        },
        {
          "s": 35,
          "text": "ריח הוא ההעלאה למעלה וניחוח"
        },
        {
          "s": 36,
          "text": "(מלשון חות דרגא21)"
        },
        {
          "s": 37,
          "text": "הוא ההמשכה למטה22,"
        },
        {
          "s": 38,
          "text": "דע\"י שריח הקרבנות עולה למעלה עד רזא דא\"ס,"
        },
        {
          "s": 39,
          "text": "הנה משם נמשך אח\"כ למטה,"
        },
        {
          "s": 40,
          "text": "באתי לגני לגנוני,"
        },
        {
          "s": 41,
          "text": "המשכת עיקר שכינה בתחתונים."
        }
      ]
    }
  ]
}