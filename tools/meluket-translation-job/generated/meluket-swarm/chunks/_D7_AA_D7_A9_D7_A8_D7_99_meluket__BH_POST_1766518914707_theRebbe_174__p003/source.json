{
  "globalIndex": 164,
  "owner": 14,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914707_theRebbe_174__p003",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914707_theRebbe_174__p003",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914707_theRebbe_174",
  "title": "מאמר להבין ענין שמח\"ת תשמ\"ב",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "וזהו39 החילוק שבין עצרת של פסח לעצרת של חג,"
        },
        {
          "s": 2,
          "text": "דעצרת של פסח הו\"ע מתן תורה"
        },
        {
          "s": 3,
          "text": "(דלוחות הראשונות)"
        },
        {
          "s": 4,
          "text": "שבהמשך ליציאת מצרים,"
        },
        {
          "s": 5,
          "text": "בהוציאך את העם ממצרים תעבדון את האלקים על ההר הזה40,"
        },
        {
          "s": 6,
          "text": "עבודת הצדיקים,"
        },
        {
          "s": 7,
          "text": "דישראל היו אז"
        },
        {
          "s": 8,
          "text": "(בעת יצי\"מ)"
        },
        {
          "s": 9,
          "text": "בבחינת צדיקים,"
        },
        {
          "s": 10,
          "text": "כמו שעשה האלקים את האדם ישר41."
        },
        {
          "s": 11,
          "text": "ולכן,"
        },
        {
          "s": 12,
          "text": "כל הענינים שמיצי\"מ עד מ\"ת הם כמו בסדר והדרגה,"
        },
        {
          "s": 13,
          "text": "בתחלה היציאה ממצרים,"
        },
        {
          "s": 14,
          "text": "אח\"כ הימים דספה\"ע שהם מ\"ט שערי קדושה וגם שער הנו\"ן כמו ששייך למ\"ט השערים,"
        },
        {
          "s": 15,
          "text": "ועד להמשכת שער הנו\"ן כמו שהוא בפני עצמו,"
        },
        {
          "s": 16,
          "text": "כמבואר בהדרושים דמ\"ת42."
        },
        {
          "s": 17,
          "text": "משא\"כ עצרת של חג בא בהמשך להתשובה דחודש אלול ימי הסליחות ר\"ה עשי\"ת ויוהכ\"פ,"
        },
        {
          "s": 18,
          "text": "דזהו גם מה שהשמחה דשמח\"ת"
        },
        {
          "s": 19,
          "text": "(שקבעו בשמע\"צ)"
        },
        {
          "s": 20,
          "text": "היא על לוחות השניות שניתנו43"
        },
        {
          "s": 21,
          "text": "ביוהכ\"פ44,"
        },
        {
          "s": 22,
          "text": "ענין התשובה."
        },
        {
          "s": 23,
          "text": "וזהו גם הטעם על גודל השמחה שבשמע\"צ ושמח\"ת,"
        },
        {
          "s": 24,
          "text": "כי ענין התשובה הוא שלום לרחוק שנעשה קרוב,"
        },
        {
          "s": 25,
          "text": "והשמחה דקירוב שלאחרי הריחוק היא שמחה גדולה ביותר."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וזהו גם מה שבעצרת של פסח יוצאים מחורף לקיץ ובעצרת של חג יוצאים מקיץ לחורף,"
        },
        {
          "s": 2,
          "text": "דזה שההליכה בימי החורף היא קשה יותר מבימי הקיץ הוא לפי שכן הוא ברוחניות הענינים"
        },
        {
          "s": 3,
          "text": "[כמו כל הענינים שבגשמיות שנשתלשלו מהן45]."
        },
        {
          "s": 4,
          "text": "דבקיץ46"
        },
        {
          "s": 5,
          "text": "השמש הוא בתקפו,"
        },
        {
          "s": 6,
          "text": "והוא מפני שכ\"ה גם ברוחניות הענינים,"
        },
        {
          "s": 7,
          "text": "שבחינת שמש הוי'47"
        },
        {
          "s": 8,
          "text": "מאיר אז בגילוי."
        },
        {
          "s": 9,
          "text": "דהגם שגם אז יש המגן ונרתק דשם אלקים48,"
        },
        {
          "s": 10,
          "text": "מ\"מ אינו מעלים ומסתיר כ\"כ,"
        },
        {
          "s": 11,
          "text": "ולכן ההליכה בדרך התומ\"צ אז היא בנקל יותר,"
        },
        {
          "s": 12,
          "text": "נשואות במקום קרוב."
        },
        {
          "s": 13,
          "text": "משא\"כ בימי החורף,"
        },
        {
          "s": 14,
          "text": "המגן ונרתק דשם אלקים הוא מעלים ומסתיר ביותר,"
        },
        {
          "s": 15,
          "text": "ולכן ההליכה בדרך התומ\"צ אז היא קשה יותר,"
        },
        {
          "s": 16,
          "text": "נשואות למקום רחוק."
        },
        {
          "s": 17,
          "text": "וזהו שהיציאה מחורף לקיץ שייכת לעצרת של פסח והיציאה מקיץ לחורף לעצרת של חג,"
        },
        {
          "s": 18,
          "text": "כי פסח"
        },
        {
          "s": 19,
          "text": "(ועצרת של פסח)"
        },
        {
          "s": 20,
          "text": "הו\"ע עבודת הצדיקים,"
        },
        {
          "s": 21,
          "text": "וחג"
        },
        {
          "s": 22,
          "text": "(ועצרת של חג)"
        },
        {
          "s": 23,
          "text": "הו\"ע עבודת התשובה."
        },
        {
          "s": 24,
          "text": "וכידוע הפירוש עה\"פ בכסה ליום חגינו49,"
        },
        {
          "s": 25,
          "text": "דבחגה\"ס הוא הגילוי של הענינים דר\"ה ויוהכ\"פ,"
        },
        {
          "s": 26,
          "text": "ענין התשובה."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "וביאור הענין בפרטיות יותר,"
        },
        {
          "s": 1,
          "text": "הנה העבודה דר\"ה היא שתמליכוני עליכם50,"
        },
        {
          "s": 2,
          "text": "ענין ההתנשאות דמלכות,"
        },
        {
          "s": 3,
          "text": "עד לבחינת התנשאות עצמית51."
        },
        {
          "s": 4,
          "text": "וזה נמשך אח\"כ בהיום אחד דיום הכפורים,"
        },
        {
          "s": 5,
          "text": "אחת בשנה52."
        },
        {
          "s": 6,
          "text": "וזהו שאומר במדרש יום אחד באו כולן לשאול שלום המלך אביהם,"
        },
        {
          "s": 7,
          "text": "שיום אחד קאי על היום דיוהכ\"פ53,"
        },
        {
          "s": 8,
          "text": "אחת בשנה,"
        },
        {
          "s": 9,
          "text": "שבו כל ישראל שוין ולכן באו כולן לשאול שלום המלך אביהם."
        },
        {
          "s": 10,
          "text": "וזהו ג\"כ דיוק הלשון המלך אביהם,"
        },
        {
          "s": 11,
          "text": "שמקדים המלך לאביהם,"
        },
        {
          "s": 12,
          "text": "לפי שאז הוא הסיום דבנין המלכות,"
        },
        {
          "s": 13,
          "text": "העבודה דתמליכוני,"
        },
        {
          "s": 14,
          "text": "המשכת התנשאות עצמית,"
        },
        {
          "s": 15,
          "text": "ולכן מקדים המלך לאביהם,"
        },
        {
          "s": 16,
          "text": "כי עיקר ההדגשה אז הוא ענין המלך,"
        },
        {
          "s": 17,
          "text": "וזה"
        },
        {
          "s": 18,
          "text": "(ענין המלך)"
        },
        {
          "s": 19,
          "text": "נמשך ע\"י בחינת אביהם עד למטה."
        },
        {
          "s": 20,
          "text": "אמנם גם ביוהכ\"פ הוא עדיין בכסה,"
        },
        {
          "s": 21,
          "text": "דזהו מה שיוהכ\"פ הוא למעלה מאכילה ושתי' וישראל דומים למלאכים54"
        },
        {
          "s": 22,
          "text": "[ורק דענין דומים למלאכים,"
        },
        {
          "s": 23,
          "text": "כשבן אדם דומה למלאך,"
        },
        {
          "s": 24,
          "text": "הוא דרגא נעלית יותר ממלאך],"
        },
        {
          "s": 25,
          "text": "שאין זה נמשך בענינים הגשמיים דאכילה ושתי'."
        },
        {
          "s": 26,
          "text": "והגילוי מזה הוא ליום חגינו,"
        },
        {
          "s": 27,
          "text": "דע\"י הסוכה נמשכים בגילוי הענינים שהיו תחלה"
        },
        {
          "s": 28,
          "text": "(בר\"ה ויוהכ\"פ)"
        },
        {
          "s": 29,
          "text": "בכסה,"
        },
        {
          "s": 30,
          "text": "ועד שע\"י בסוכות תשבו שבעת ימים55"
        },
        {
          "s": 31,
          "text": "הגילוי הוא בהתיישבות56."
        },
        {
          "s": 32,
          "text": "אלא שאעפ\"כ אין זה מספיק עדיין,"
        },
        {
          "s": 33,
          "text": "כי סוכה היא דירת עראי57,"
        },
        {
          "s": 34,
          "text": "ותכלית הכוונה הוא שיהי' דירת קבע לו ית',"
        },
        {
          "s": 35,
          "text": "שזה יהי' בבית המקדש השלישי שיהי' דירה נצחית58,"
        },
        {
          "s": 36,
          "text": "הנה על זה הוא מצות נטילת ד' מינים,"
        },
        {
          "s": 37,
          "text": "שעי\"ז נמשך המקיף דסוכה בבחי' פנימיות,"
        },
        {
          "s": 38,
          "text": "וכמבואר בכ\"מ59"
        },
        {
          "s": 39,
          "text": "הטעם על זה שבנענועים הלולב ומיניו צריכים לנגוע בהחזה60,"
        },
        {
          "s": 40,
          "text": "כי ענין נטילת ד' מינים הוא להמשיך בנוקבא שבחזה דז\"א."
        },
        {
          "s": 41,
          "text": "אבל גם זה אינו מספיק עדיין,"
        },
        {
          "s": 42,
          "text": "ותכלית השלימות היא הקליטה,"
        },
        {
          "s": 43,
          "text": "שעי\"ז דוקא נעשה ההולדה,"
        },
        {
          "s": 44,
          "text": "וזה נעשה בשמע\"צ61,"
        },
        {
          "s": 45,
          "text": "עצרת מלשון קליטה,"
        },
        {
          "s": 46,
          "text": "שכל הענינים דחודש תשרי"
        },
        {
          "s": 47,
          "text": "(ר\"ה,"
        },
        {
          "s": 48,
          "text": "עשי\"ת,"
        },
        {
          "s": 49,
          "text": "יוהכ\"פ,"
        },
        {
          "s": 50,
          "text": "ד' ימים שבין יוהכ\"פ לסוכות וסוכות)"
        },
        {
          "s": 51,
          "text": "נמשכים בשמע\"צ בבחינת קליטה בפנימיות,"
        },
        {
          "s": 52,
          "text": "שעי\"ז נעשה ההולדה,"
        },
        {
          "s": 53,
          "text": "גילוי כח הא\"ס,"
        },
        {
          "s": 54,
          "text": "עד למטה מטה."
        }
      ]
    }
  ]
}