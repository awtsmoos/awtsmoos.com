{
  "globalIndex": 1073,
  "owner": 23,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920167_theRebbe_725__p002",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920167_theRebbe_725__p002",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920167_theRebbe_725",
  "title": "מאמר אני לדודי תשכ\"ו",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ובכדי לבאר שני ענינים הנ\"ל בהגילוי דיגמה\"ר שבאלול – שהגילוי דאלול הוא לכאו\"א גם להרחוקים ביותר,"
        },
        {
          "s": 2,
          "text": "ושאעפ\"כ הגילוי אינו מעורר את האדם והוא רק נתינת כח – ממשיך בהמאמר,"
        },
        {
          "s": 3,
          "text": "שהגילוי דיגמה\"ר באלול הוא דוגמת מלך בשדה."
        },
        {
          "s": 4,
          "text": "דמהחילוקים בין מלך בשדה ומלך בהיכלו הם שני הענינים8."
        },
        {
          "s": 5,
          "text": "בנוגע לדרגת הגילוי,"
        },
        {
          "s": 6,
          "text": "עיקר הגילוי דמלך ביפיו"
        },
        {
          "s": 7,
          "text": "(תחזינה עיניך)9"
        },
        {
          "s": 8,
          "text": "הוא בהיכל מלכותו,"
        },
        {
          "s": 9,
          "text": "כשהוא בלבושי מלכות ובכתר מלכות,"
        },
        {
          "s": 10,
          "text": "משא\"כ כשהוא בשדה10."
        },
        {
          "s": 11,
          "text": "אבל הגילוי עצמו הוא בעיקר כשהוא בשדה."
        },
        {
          "s": 12,
          "text": "דבהיותו בהיכל מלכותו אין נכנסים אליו אלא ברשות ורק המובחרים שבעם ויחידי סגולה,"
        },
        {
          "s": 13,
          "text": "ובהיותו בשדה,"
        },
        {
          "s": 14,
          "text": "רשאים"
        },
        {
          "s": 15,
          "text": "[ויכולים11]"
        },
        {
          "s": 16,
          "text": "להקביל פניו כל מי שרוצה,"
        },
        {
          "s": 17,
          "text": "והמלך מקבל את כולם בסבר פנים יפות ומראה פנים שוחקות לכולם."
        },
        {
          "s": 18,
          "text": "ועד\"ז הוא בהנמשל,"
        },
        {
          "s": 19,
          "text": "שהגילוי דר\"ה ויוהכ\"פ ועד\"ז בעשי\"ת בכלל שהוא בדוגמת מלך בהיכלו הוא באופן שהגילוי מעורר את האדם,"
        },
        {
          "s": 20,
          "text": "בדוגמת מלך בהיכלו"
        },
        {
          "s": 21,
          "text": "(בלבושי מלכות ובכתר מלכות),"
        },
        {
          "s": 22,
          "text": "שהוא מטיל אימה ופחד."
        },
        {
          "s": 23,
          "text": "אבל בכדי שהאדם ירגיש הגילוי דר\"ה ויוהכ\"פ,"
        },
        {
          "s": 24,
          "text": "הוא"
        },
        {
          "s": 25,
          "text": "(בעיקר)"
        },
        {
          "s": 26,
          "text": "לאחרי קדימת העבודה בחודש אלול,"
        },
        {
          "s": 27,
          "text": "שעי\"ז הוא נעשה מהמובחרים שבעם והיחידי סגולה שנכנסים להיכל המלך."
        },
        {
          "s": 28,
          "text": "והגילוי דאלול שהוא דוגמת מלך בשדה,"
        },
        {
          "s": 29,
          "text": "הוא באופן שהגילוי אינו מעורר את האדם והוא רק נתינת כח לעבודה,"
        },
        {
          "s": 30,
          "text": "אבל הנתינת כח לעבודה שע\"י גילוי זה הוא לכאו\"א גם להרחוקים ביותר."
        },
        {
          "s": 31,
          "text": "בדוגמת מלך בשדה,"
        },
        {
          "s": 32,
          "text": "דכשהמלך הוא במצב זה אינו מטיל אימה ופחד."
        },
        {
          "s": 33,
          "text": "ובפרט על אלו הנמצאים בשדה,"
        },
        {
          "s": 34,
          "text": "שהם בדרגא נמוכה."
        },
        {
          "s": 35,
          "text": "ויתירה מזו,"
        },
        {
          "s": 36,
          "text": "דכשהמלך הוא במצב זה,"
        },
        {
          "s": 37,
          "text": "אינו מעורר אפילו תשוקה להקביל את פניו12."
        },
        {
          "s": 38,
          "text": "וזהו שמדייק בהמאמר כל מי שרוצה לצאת להקביל פניו,"
        },
        {
          "s": 39,
          "text": "דזה שהם יוצאים להקביל את פני המלך הוא מצד הרצון שלהם13."
        },
        {
          "s": 40,
          "text": "אלא שהנתינת כח להקביל את פני המלך הוא ע\"י שהמלך בשדה."
        },
        {
          "s": 41,
          "text": "שאז"
        },
        {
          "s": 42,
          "text": "(בהיותו בשדה)"
        },
        {
          "s": 43,
          "text": "ישנו הרשות והיכולת לכאו\"א להקביל את פני המלך."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וצריך להבין,"
        },
        {
          "s": 2,
          "text": "דלכאורה בכדי לבאר שהגילוי דאלול"
        },
        {
          "s": 3,
          "text": "(והנתינת כח שע\"י הגילוי)"
        },
        {
          "s": 4,
          "text": "הוא לכאו\"א,"
        },
        {
          "s": 5,
          "text": "נוגע רק שכשהמלך בשדה רשאים ויכולים כל מי שרוצה להקביל פניו,"
        },
        {
          "s": 6,
          "text": "ולמה מוסיף שהמלך מקבל את כולם בסבר פנים יפות ומראה פנים שוחקות לכולם."
        },
        {
          "s": 7,
          "text": "ובפרט דזה שהמלך מקבל את כולם בסבר פנים יפות ומראה להם פנים שוחקות הוא ההמשכה והגילוי מלמעלה שלאחרי העבודה14,"
        },
        {
          "s": 8,
          "text": "ואינו מובן,"
        },
        {
          "s": 9,
          "text": "דההמשכה והגילוי שלאחרי העבודה"
        },
        {
          "s": 10,
          "text": "(ודודי לי)"
        },
        {
          "s": 11,
          "text": "היא בעשי\"ת,"
        },
        {
          "s": 12,
          "text": "והמשל דמלך בשדה הוא ביאור על הגילוי דאלול שהוא"
        },
        {
          "s": 13,
          "text": "(נתינת כח ו)"
        },
        {
          "s": 14,
          "text": "לפני העבודה."
        },
        {
          "s": 15,
          "text": "גם צריך להבין שני הענינים שהוא מקבלם בסבר פנים יפות ושמראה להם פנים שוחקות."
        },
        {
          "s": 16,
          "text": "וגם,"
        },
        {
          "s": 17,
          "text": "שבנוגע למקבלם אומר בסבר פנים יפות ובנוגע למראה להם אומר פנים שוחקות."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר הביאור בזה בהקדים שהחידוש בהגילוי דיגמה\"ר באלול לגבי הגילוי בר\"ה ויוהכ\"פ הוא בשני ענינים."
        },
        {
          "s": 1,
          "text": "שבכדי לקבל הגילוי דר\"ה ויוהכ\"פ הוא ע\"י עבודה נעלית"
        },
        {
          "s": 2,
          "text": "(מובחרים שבעם ויחידי סגולה)"
        },
        {
          "s": 3,
          "text": "ובכדי לקבל הגילוי דאלול צריכה להיות רק הקבלת פני המלך,"
        },
        {
          "s": 4,
          "text": "דבנמשל הוא התעוררות הקבלת עול מלכות שמים15."
        },
        {
          "s": 5,
          "text": "ועוד חידוש בהגילוי דאלול שהגילוי הוא גם לאלה הנמצאים במדבר16"
        },
        {
          "s": 6,
          "text": "דלעו\"ז17."
        },
        {
          "s": 7,
          "text": "וכמובן גם מזה שעיקר הגילוי דיגמה\"ר שבאלול הוא נתינת כח על תשובה18,"
        },
        {
          "s": 8,
          "text": "דתשובה כפשוטה היא על ענינים בלתי רצויים"
        },
        {
          "s": 9,
          "text": "(בחינת מדבר),"
        },
        {
          "s": 10,
          "text": "ועיקר התשובה הוא על פריקת עול19,"
        },
        {
          "s": 11,
          "text": "דמזה מובן,"
        },
        {
          "s": 12,
          "text": "שהגילוי דאלול הוא גם לאלה שהם בתכלית הריחוק."
        },
        {
          "s": 13,
          "text": "ומ\"ש בהמאמר שהגילוי דאלול הוא בשדה"
        },
        {
          "s": 14,
          "text": "(ולא במדבר),"
        },
        {
          "s": 15,
          "text": "הוא,"
        },
        {
          "s": 16,
          "text": "כי הגילוי דיגמה\"ר הוא"
        },
        {
          "s": 17,
          "text": "(לא בהמדבר עצמו,"
        },
        {
          "s": 18,
          "text": "דבענינים שהם היפך רצון ה'17,"
        },
        {
          "s": 19,
          "text": "אין שייך שיהי' בהם גילוי אלקות,"
        },
        {
          "s": 20,
          "text": "אלא)"
        },
        {
          "s": 21,
          "text": "בישראל הנמצאים במדבר,"
        },
        {
          "s": 22,
          "text": "והגילוי בהם הוא הנתינת כח לצאת ממדבר לשדה לקבל פני המלך."
        },
        {
          "s": 23,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 24,
          "text": "דמ\"ש בהמאמר שהמלך מקבל את כולם בסבר פנים יפות,"
        },
        {
          "s": 25,
          "text": "הכוונה בזה שמדגיש את כולם היא,"
        },
        {
          "s": 26,
          "text": "שגם אלה שהם רק רוצים להקביל את פני המלך אלא שהם שבויים בידי יצרם וגם כשמתעורר אצלם רצון לעשות תשובה ולקבל עליהם עול מלכות שמים אין זה בא בפועל,"
        },
        {
          "s": 27,
          "text": "גם אותם הוא מקבל בסבר פנים יפות,"
        },
        {
          "s": 28,
          "text": "וזה מעורר אצלם רצון חזק ותקיף להקביל את פני המלך,"
        },
        {
          "s": 29,
          "text": "וע\"י רצון זה הם מתגברים על המניעות והעיכובים."
        }
      ]
    }
  ]
}