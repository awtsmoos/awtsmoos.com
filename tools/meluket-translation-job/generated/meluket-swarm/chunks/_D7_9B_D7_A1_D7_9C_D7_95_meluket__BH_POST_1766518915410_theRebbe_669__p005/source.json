{
  "globalIndex": 285,
  "owner": 35,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915410_theRebbe_669__p005",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915410_theRebbe_669__p005",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915410_theRebbe_669",
  "title": "מאמר פדה בשלום תשמ\"ו",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה ידוע,"
        },
        {
          "s": 2,
          "text": "דכמו שירידת הנשמה למטה היא ירידה לצורך עלי',"
        },
        {
          "s": 3,
          "text": "עד\"ז הוא בתומ\"צ,"
        },
        {
          "s": 4,
          "text": "שהכוונה בהירידה דתומ\"צ היא לצורך עלי'."
        },
        {
          "s": 5,
          "text": "כי ע\"י ירידתם למטה והתלבשותם בדברים גשמיים נמשך בהם עצמיות כח התומ\"צ42."
        },
        {
          "s": 6,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 7,
          "text": "דענין ההילולא שבקיום התומ\"צ בהאי עלמא דוקא,"
        },
        {
          "s": 8,
          "text": "הוא גם בהתומ\"צ עצמם."
        },
        {
          "s": 9,
          "text": "דנוסף לענין ההילולא בהאדם העוסק בתומ\"צ,"
        },
        {
          "s": 10,
          "text": "המשכת כח הא\"ס שע\"י החיבור והיחוד דנשמה וגוף"
        },
        {
          "s": 11,
          "text": "(כנ\"ל סעיף ה),"
        },
        {
          "s": 12,
          "text": "גם בהתומ\"צ עצמם הו\"ע ההילולא."
        },
        {
          "s": 13,
          "text": "כי תורה ומצוות הם חכמתו ורצונו של הקב\"ה שלמעלה מעולם43,"
        },
        {
          "s": 14,
          "text": "והחיבור שלהם עם הענינים שבהאי עלמא"
        },
        {
          "s": 15,
          "text": "(הדברים הגשמיים שבהם נתלבשו התומ\"צ)"
        },
        {
          "s": 16,
          "text": "הוא חיבור דשני הפכים,"
        },
        {
          "s": 17,
          "text": "וחיבור זה הוא ע\"י המשכת עצמות כח התומ\"צ – ע\"ד יחוד חתן וכלה,"
        },
        {
          "s": 18,
          "text": "ע\"י המשכת כח הא\"ס שלמעלה משניהם ומחבר אותם."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר44"
        },
        {
          "s": 2,
          "text": "עוד פירוש בהאי עלמא דאזלינן מיני',"
        },
        {
          "s": 3,
          "text": "שבשעת פטירתו של אדם,"
        },
        {
          "s": 4,
          "text": "כשהנשמה נפטרת מהגוף ומעולם הזה,"
        },
        {
          "s": 5,
          "text": "דאזלינן מיני',"
        },
        {
          "s": 6,
          "text": "אזי נעשה בה הענין דאזלינן,"
        },
        {
          "s": 7,
          "text": "שהיא נעשית בבחינת מהלך."
        },
        {
          "s": 8,
          "text": "דלהביאור דלעיל"
        },
        {
          "s": 9,
          "text": "(סעיף ה),"
        },
        {
          "s": 10,
          "text": "זה שהנשמה נעשית מהלך,"
        },
        {
          "s": 11,
          "text": "הוא בהיותה למטה בהאי עלמא."
        },
        {
          "s": 12,
          "text": "ופירוש דאזלינן מיני' הוא מחמתו ובסיבתו45,"
        },
        {
          "s": 13,
          "text": "דזה שהנשמה באה לבחינת אזלינן,"
        },
        {
          "s": 14,
          "text": "שהיא נעשית מהלך,"
        },
        {
          "s": 15,
          "text": "הוא מיני',"
        },
        {
          "s": 16,
          "text": "מצד העילוי שבהאי עלמא שהוא כמו הילולא."
        },
        {
          "s": 17,
          "text": "ולפירוש השני,"
        },
        {
          "s": 18,
          "text": "הענין דאזלינן שנעשה בהנשמה"
        },
        {
          "s": 19,
          "text": "(שנעשית מהלך)"
        },
        {
          "s": 20,
          "text": "הוא בעת דאזלינן מיני',"
        },
        {
          "s": 21,
          "text": "כשהיא הולכת ונפטרת מהאי עלמא."
        },
        {
          "s": 22,
          "text": "ונקודת הביאור בזה"
        },
        {
          "s": 23,
          "text": "(בהמאמר)46,"
        },
        {
          "s": 24,
          "text": "דהמצוות כמו שהם למטה,"
        },
        {
          "s": 25,
          "text": "הם במדידה והגבלה47."
        },
        {
          "s": 26,
          "text": "וגם התורה שלמטה היא במדידה והגבלה,"
        },
        {
          "s": 27,
          "text": "כמ\"ש48"
        },
        {
          "s": 28,
          "text": "ארוכה מארץ מדה,"
        },
        {
          "s": 29,
          "text": "היינו שיש מדה להתורה אלא שהמדה היא ארוכה מארץ49."
        },
        {
          "s": 30,
          "text": "ולכן,"
        },
        {
          "s": 31,
          "text": "ההילוך"
        },
        {
          "s": 32,
          "text": "(ענין הבל\"ג)"
        },
        {
          "s": 33,
          "text": "שנעשה בהנשמה ע\"י עסק התומ\"צ שלה בעוה\"ז,"
        },
        {
          "s": 34,
          "text": "הוא בהעלם."
        },
        {
          "s": 35,
          "text": "וגם ההילוך דהנשמה שע\"י מצות פרי' ורבי',"
        },
        {
          "s": 36,
          "text": "אף שבענין ההולדה הוא גילוי כח הא\"ס,"
        },
        {
          "s": 37,
          "text": "מ\"מ,"
        },
        {
          "s": 38,
          "text": "כיון שגילוי כח הא\"ס שבזה הוא בנוגע לענין מוגבל"
        },
        {
          "s": 39,
          "text": "(הולדת בנים,"
        },
        {
          "s": 40,
          "text": "אלא שההולדה היא דור אחר דור עד אין שיעור),"
        },
        {
          "s": 41,
          "text": "לכן,"
        },
        {
          "s": 42,
          "text": "גם ע\"י קיום מצוה זו,"
        },
        {
          "s": 43,
          "text": "ענין ההילוך הוא בהעלם."
        },
        {
          "s": 44,
          "text": "ולאחרי שהנשמה ממלאת את שליחותה בהאי עלמא ובא הזמן דאזלינן מיני',"
        },
        {
          "s": 45,
          "text": "שהיא הולכת"
        },
        {
          "s": 46,
          "text": "(ויוצאת)"
        },
        {
          "s": 47,
          "text": "מההגבלות דהאי עלמא,"
        },
        {
          "s": 48,
          "text": "אזי מתגלה לה הפנימיות דהתומ\"צ שעסקה בעוה\"ז,"
        },
        {
          "s": 49,
          "text": "שהפנימיות דהתומ\"צ הם בלי גבול,"
        },
        {
          "s": 50,
          "text": "ואז נעשה בה הענין דאזלינן"
        },
        {
          "s": 51,
          "text": "(מהלך)"
        },
        {
          "s": 52,
          "text": "גם בגילוי."
        },
        {
          "s": 53,
          "text": "וזהו שיום הסתלקות הצדיקים שעסקו בפנימיות התורה נק' בשם יום הילולא"
        },
        {
          "s": 54,
          "text": "(כמו הילולא דרשב\"י,"
        },
        {
          "s": 55,
          "text": "ועד\"ז הוא בנוגע ליום ההסתלקות דכל הצדיקים שעסקו בפנימיות התורה),"
        },
        {
          "s": 56,
          "text": "כי ע\"י הלימוד והעסק בפנימיות התורה,"
        },
        {
          "s": 57,
          "text": "מתגלית ביום ההסתלקות הפנימיות והבל\"ג,"
        },
        {
          "s": 58,
          "text": "ענין ההילולא וההילוך."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ומבאר בעל הגאולה במאמר הנ\"ל50,"
        },
        {
          "s": 2,
          "text": "שבהילולא"
        },
        {
          "s": 3,
          "text": "(יחוד דכר ונוקבא)"
        },
        {
          "s": 4,
          "text": "ג' ענינים"
        },
        {
          "s": 5,
          "text": "(בכללות)."
        },
        {
          "s": 6,
          "text": "יחוד דכר ונוקבא למעלה."
        },
        {
          "s": 7,
          "text": "דענין דכר ונוקבא הוא גם בהנשמות כמו שהם למעלה קודם ירידתם למטה."
        },
        {
          "s": 8,
          "text": "דישנם נשמות שבבחינת דכר ונשמות שבבחינת נוקבא."
        },
        {
          "s": 9,
          "text": "והיחוד דהנשמות שבבחינת דכר עם הנשמות שבבחינת נוקבא נק' הילולא."
        },
        {
          "s": 10,
          "text": "ויחוד דכר ונוקבא למטה."
        },
        {
          "s": 11,
          "text": "ובזה עצמו שני ענינים."
        },
        {
          "s": 12,
          "text": "יחוד דכר ונוקבא כפשוטם ויחוד הנשמה עם הגוף"
        },
        {
          "s": 13,
          "text": "[שהם דוגמת איש ואשה]."
        },
        {
          "s": 14,
          "text": "וענין הג' בהילולא הוא יחוד הנשמה"
        },
        {
          "s": 15,
          "text": "(דכר)"
        },
        {
          "s": 16,
          "text": "עם הגוף"
        },
        {
          "s": 17,
          "text": "(נוקבא)"
        },
        {
          "s": 18,
          "text": "שיהי' בתחיית המתים."
        },
        {
          "s": 19,
          "text": "דהילולא זו היא דרגא הכי נעלית,"
        },
        {
          "s": 20,
          "text": "שאז יהי' גילוי העצמות."
        }
      ]
    }
  ]
}