{
  "globalIndex": 621,
  "owner": 21,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917370_theRebbe_643__p002",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917370_theRebbe_643__p002",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917370_theRebbe_643",
  "title": "מאמר וקבל היהודים תשל\"ח",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ואחר כ\"ז,"
        },
        {
          "s": 1,
          "text": "הנה במ\"ת הי' רק \"החלו לעשות\","
        },
        {
          "s": 2,
          "text": "ענין של התחלה בלבד,"
        },
        {
          "s": 3,
          "text": "והקיום"
        },
        {
          "s": 4,
          "text": "(דהתורה דמ\"ת),"
        },
        {
          "s": 5,
          "text": "קיימו וקבלו,"
        },
        {
          "s": 6,
          "text": "הי' דוקא בזמן הגלות,"
        },
        {
          "s": 7,
          "text": "ובפרט בזמן המן כשישראל היו בתכלית השפלות דגלות בגשמיות ורוחניות,"
        },
        {
          "s": 8,
          "text": "שזהו ענין נפלא ביותר."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויובן זה"
        },
        {
          "s": 2,
          "text": "(כמבואר בהמאמר20)"
        },
        {
          "s": 3,
          "text": "ע\"פ הביאור במ\"ש21"
        },
        {
          "s": 4,
          "text": "שמן גו' כתית למאור,"
        },
        {
          "s": 5,
          "text": "שמדייק שם22"
        },
        {
          "s": 6,
          "text": "שלא נאמר שמן להאיר כ\"א שמן גו' למאור,"
        },
        {
          "s": 7,
          "text": "ומבאר בזה23"
        },
        {
          "s": 8,
          "text": "דמאור קאי על המאור עצמו,"
        },
        {
          "s": 9,
          "text": "היינו מקור האור."
        },
        {
          "s": 10,
          "text": "וזהו מ\"ש כתית למאור,"
        },
        {
          "s": 11,
          "text": "שכאשר האדם הוא בבחי' כתית,"
        },
        {
          "s": 12,
          "text": "שנשבר ונדכא,"
        },
        {
          "s": 13,
          "text": "הנה אז מגיע למאור."
        },
        {
          "s": 14,
          "text": "וזה שנשבר ונדכא הוא גם כאשר בגשמיות הוא במצב של הרחבה הכי גדולה אלא שמ\"מ חסר ברוחניות,"
        },
        {
          "s": 15,
          "text": "בעבודתו,"
        },
        {
          "s": 16,
          "text": "ויתירה מזו,"
        },
        {
          "s": 17,
          "text": "דאפילו אם גם ברוחניות הוא שלם בקיום התומ\"צ,"
        },
        {
          "s": 18,
          "text": "ועד שהוא בתכלית העילוי וההרחבה שעובד עבודתו כדבעי לי' למיעבד24,"
        },
        {
          "s": 19,
          "text": "מ\"מ כשיתבונן דועמך כולם צדיקים25,"
        },
        {
          "s": 20,
          "text": "וכאו\"א מישראל הוא נצר מטעי מעשה ידי להתפאר"
        },
        {
          "s": 21,
          "text": "(מטעיו ומעשה ידיו של הקב\"ה ושבהם הוא מתפאר),"
        },
        {
          "s": 22,
          "text": "ויתבונן בגדולתו של הקב\"ה,"
        },
        {
          "s": 23,
          "text": "הנה בכה יבכה במר נפשו,"
        },
        {
          "s": 24,
          "text": "כי במה נחשבת כל עבודתו"
        },
        {
          "s": 25,
          "text": "(גם אם היא בשלימות)"
        },
        {
          "s": 26,
          "text": "לגבי ערכו ומדרגתו האמיתי שצ\"ל נצר מטעיו ומעשה ידיו להתפאר של הקב\"ה בגלוי עד שכל רואהו יכיר זה,"
        },
        {
          "s": 27,
          "text": "וא\"כ גם שלימות עבודתו אינה כדבעי למהוי כלל,"
        },
        {
          "s": 28,
          "text": "והרי אפילו מאן דמחוה במחוג קמי מלכא הרי זה היפך החיות והמציאות26,"
        },
        {
          "s": 29,
          "text": "ועאכו\"כ כשעבודתו אינה כדבעי,"
        },
        {
          "s": 30,
          "text": "שאינה בערך למה שהי' צ\"ל לפי\"ע הכחות שנתנו לו."
        },
        {
          "s": 31,
          "text": "והנה כשיתבונן בגודל ירידתו ויבכה במר נפשו,"
        },
        {
          "s": 32,
          "text": "יבא לידי תשובה,"
        },
        {
          "s": 33,
          "text": "ועד שיגיע להיות והרוח תשוב אל האלקים אשר נתנה27"
        },
        {
          "s": 34,
          "text": "ולמעלה יותר,"
        },
        {
          "s": 35,
          "text": "שתשוב הנפש במס\"נ למקורה ושרשה העליון שממנה לוקחה כו'28."
        },
        {
          "s": 36,
          "text": "וזהו מ\"ש כתית למאור,"
        },
        {
          "s": 37,
          "text": "שעי\"ז שהאדם נשבר ונדכא,"
        },
        {
          "s": 38,
          "text": "בבחי' כתית"
        },
        {
          "s": 39,
          "text": "[מתוך הרחבה בגשמיות ומתוך הרחבה ברוחניות,"
        },
        {
          "s": 40,
          "text": "כנ\"ל],"
        },
        {
          "s": 41,
          "text": "הנה אז מגיע למאור עצמו,"
        },
        {
          "s": 42,
          "text": "לבחי' האלקים אשר נתנה כו'."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה עבודה הנ\"ל להיות בביטול בתכלית בבחי' כתית פועלת אח\"כ גם בהמעשה בפועל."
        },
        {
          "s": 2,
          "text": "והענין הוא,"
        },
        {
          "s": 3,
          "text": "כמו שמבאר כ\"ק אדמו\"ר הזקן בתו\"א29"
        },
        {
          "s": 4,
          "text": "שהיהודים מסרו עצמן למות כל השנה כולה ולא עלה להם מחשבת חוץ ח\"ו,"
        },
        {
          "s": 5,
          "text": "דהפירוש בזה הוא שעמדו במס\"נ בכל אופני שינויים שהיו,"
        },
        {
          "s": 6,
          "text": "דזהו שנה לשון שינוי30"
        },
        {
          "s": 7,
          "text": "כי השנה כוללת בתוכה כל השינויים האפשריים31."
        },
        {
          "s": 8,
          "text": "וע\"ד הידוע32"
        },
        {
          "s": 9,
          "text": "במעלת האתרוג שדר באילנו משנה לשנה33"
        },
        {
          "s": 10,
          "text": "שסובל ע\"ע כל שינויי האוירים מד' תקופות השנה ואינו מתפעל מזה כלל ודר באילנו"
        },
        {
          "s": 11,
          "text": "[שחיותו ומקום דירתו הוא באילנו,"
        },
        {
          "s": 12,
          "text": "בשרשו ומקורו],"
        },
        {
          "s": 13,
          "text": "ולא זה בלבד שאינו מתפעל מהשינויים אלא עוד זאת שגדל מהשינויים,"
        },
        {
          "s": 14,
          "text": "כמבואר בהמשך וככה34,"
        },
        {
          "s": 15,
          "text": "הנה עד\"ז הוא בעבודת האדם,"
        },
        {
          "s": 16,
          "text": "דבכל אופני שינויי הדרגות שבעבודה,"
        },
        {
          "s": 17,
          "text": "כל השנה כולה,"
        },
        {
          "s": 18,
          "text": "עבודתו היא בתכלית השלימות,"
        },
        {
          "s": 19,
          "text": "שלא עולה מחשבת חוץ ח\"ו."
        },
        {
          "s": 20,
          "text": "ולזה מגיע דוקא כשהוא בתכלית הביטול בבחי' כתית,"
        },
        {
          "s": 21,
          "text": "כי מכיון שיש אופני עבודה חלוקים מן הקצה אל הקצה כמו חסד וגבורה,"
        },
        {
          "s": 22,
          "text": "לכן גם אם עבודתו בקו החסד היא כדבעי אפשר שיקשה עליו שעבודתו בקו הגבורה תהי' ג\"כ באותה השלימות"
        },
        {
          "s": 23,
          "text": "[ע\"ד שאפילו בנוגע אאע\"ה,"
        },
        {
          "s": 24,
          "text": "כיון שעבודתו היתה בבחי' החסד35,"
        },
        {
          "s": 25,
          "text": "אברהם אוהבי36,"
        },
        {
          "s": 26,
          "text": "נאמר עליו37"
        },
        {
          "s": 27,
          "text": "עתה ידעתי כי ירא אלקים אתה,"
        },
        {
          "s": 28,
          "text": "לאחר שעמד גם בנסיון העשירי38],"
        },
        {
          "s": 29,
          "text": "וע\"י הביטול דכתית הנה שלימות עבודתו היא בלי שינויים בכל חילוקי אופני העבודה39."
        }
      ]
    }
  ]
}