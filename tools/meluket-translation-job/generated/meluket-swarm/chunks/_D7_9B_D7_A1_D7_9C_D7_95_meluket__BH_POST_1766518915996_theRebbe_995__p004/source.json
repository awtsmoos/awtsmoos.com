{
  "globalIndex": 392,
  "owner": 42,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915996_theRebbe_995__p004",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915996_theRebbe_995__p004",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915996_theRebbe_995",
  "title": "מאמר אתה אחד תשל\"ב",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ואח\"כ מבאר בפסוק השני את החלוקה הב',"
        },
        {
          "s": 1,
          "text": "שהיא בבחי' הקטנות."
        },
        {
          "s": 2,
          "text": "ומתחיל בענין טפכם,"
        },
        {
          "s": 3,
          "text": "שהוא בבחי' קטנות הדעת המצומצם מאד בקטנות המדות שהם בחי' אנפי זוטרא,"
        },
        {
          "s": 4,
          "text": "כמו הטף באדם שאינם בני דעה גמורה."
        },
        {
          "s": 5,
          "text": "ונשיכם הוא בחי' הקטנות דבחי' מקבל כו'."
        },
        {
          "s": 6,
          "text": "ואח\"כ אומר וגרך אשר בקרב מחניך מחוטב עציך עד שואב מימיך,"
        },
        {
          "s": 7,
          "text": "שג' מדריגות האלה הן בחי' מדריגות החיצוניות ביותר שהוא הנפש הבהמית והטבעית כו',"
        },
        {
          "s": 8,
          "text": "בדוגמת הגר שנמשך מאוה\"ע כו'"
        },
        {
          "s": 9,
          "text": "(נוסף לכך שענין הגר בפשטות הוא בבחי' הקטנות,"
        },
        {
          "s": 10,
          "text": "וכמארז\"ל47"
        },
        {
          "s": 11,
          "text": "גר שנתגייר כקטן שנולד דמי),"
        },
        {
          "s": 12,
          "text": "שמצד עצמה היא רחוקה מאלקות,"
        },
        {
          "s": 13,
          "text": "ומ\"מ מתקרבת תחת כנפי השכינה כגר שנתגייר ממש."
        },
        {
          "s": 14,
          "text": "ועז\"נ וגרך אשר בקרב מחניך,"
        },
        {
          "s": 15,
          "text": "שנבדל מפנימיות האלקות שבנש\"י שנק' איש ישראל דלעילא,"
        },
        {
          "s": 16,
          "text": "רק נתפס ונגרר בקרב מחניך כטפל לגבי העיקר."
        },
        {
          "s": 17,
          "text": "וזהו מה שעובד עבודה גשמית כמו לחטוב עצים ולשאוב מים,"
        },
        {
          "s": 18,
          "text": "שחטיבת עצים הוא רק כמו הכנה לבישול,"
        },
        {
          "s": 19,
          "text": "וכן שאיבת מים היא רק כמו טפל ומסייע לאכילה,"
        },
        {
          "s": 20,
          "text": "וכמובן מהמבואר במ\"א48"
        },
        {
          "s": 21,
          "text": "דכל ענין השתי' הוא רק כדי שהדם הנוצר ע\"י האכילה יתפשט באברים"
        },
        {
          "s": 22,
          "text": "(וזהו ביאור מארז\"ל49"
        },
        {
          "s": 23,
          "text": "אכל ולא שתה אכילתו דם),"
        },
        {
          "s": 24,
          "text": "וכן הוא לענין האכילה הרוחניות שהם המצוות."
        },
        {
          "s": 25,
          "text": "ונמצא,"
        },
        {
          "s": 26,
          "text": "שג' הדרגות האחרונות המנויות כאן הם כפי שהנה\"א ירד ונתלבש למטה מטה בנה\"ב,"
        },
        {
          "s": 27,
          "text": "למצרים ירדתם וכו'50."
        },
        {
          "s": 28,
          "text": "וגם על מדריגות אלו כתיב אתם נצבים היום כולכם לפני הוי' גו'."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וממשיך שם51,"
        },
        {
          "s": 2,
          "text": "אך הנה לכאורה זהו פלא גדול,"
        },
        {
          "s": 3,
          "text": "דבשלמא הנשמות יכולים לעמוד לפני הוי',"
        },
        {
          "s": 4,
          "text": "אבל גרך אשר בקרב מחניך,"
        },
        {
          "s": 5,
          "text": "איך גם הם יעמדו לפני הוי'."
        },
        {
          "s": 6,
          "text": "ומבאר בזה,"
        },
        {
          "s": 7,
          "text": "דזהו ענין אתם נצבים דייקא,"
        },
        {
          "s": 8,
          "text": "דפירוש נצבים הוא ענין הקמה והגבהה,"
        },
        {
          "s": 9,
          "text": "כמו קמה אלומתי וגם נצבה52,"
        },
        {
          "s": 10,
          "text": "וכמו מצבת אבן שמונחת בארץ שמקים אותה ומציבה למצבה,"
        },
        {
          "s": 11,
          "text": "כמו המצבה דיעקב דכתיב6"
        },
        {
          "s": 12,
          "text": "ויקח את האבן גו' וישם אותה מצבה."
        },
        {
          "s": 13,
          "text": "וכך הענין כאן,"
        },
        {
          "s": 14,
          "text": "דמ\"ש אתם נצבים היום קאי על ראש השנה53,"
        },
        {
          "s": 15,
          "text": "שאז נצבים כולכם היום,"
        },
        {
          "s": 16,
          "text": "וכמ\"ש54"
        },
        {
          "s": 17,
          "text": "ויהי בישורון מלך בהתאסף ראשי עם יחד שבטי ישראל,"
        },
        {
          "s": 18,
          "text": "דבראש השנה הרי נשמות ישראל עולים לשרשם ששם הרי כולכם לאחדים כאחד"
        },
        {
          "s": 19,
          "text": "(כמבואר בלקו\"ת פ' נצבים55),"
        },
        {
          "s": 20,
          "text": "וכמבואר בתניא פל\"ב שבהיותם בשרשם הרי כולם מתאימות ואב אחד לכולנה ומי יודע גדולתן ומעלתן בשרשן ומקורן כו'."
        },
        {
          "s": 21,
          "text": "וממשיך שם56,"
        },
        {
          "s": 22,
          "text": "ועוד יתפרש ענין נצבים לשון ממשלה ושררה,"
        },
        {
          "s": 23,
          "text": "כמו וישם באדום נציבים57,"
        },
        {
          "s": 24,
          "text": "וכמו נציב פלשתים58,"
        },
        {
          "s": 25,
          "text": "שהוא שר המושל על המדינה,"
        },
        {
          "s": 26,
          "text": "וכן המתמנה על העובדים במלאכה נקרא נציב,"
        },
        {
          "s": 27,
          "text": "כמו הנער הנצב על הקוצרים59."
        },
        {
          "s": 28,
          "text": "ובזה יובן איך אפשר שגם גרך וחוטב עציך גו' יהיו נצבים לפני הוי' ממש,"
        },
        {
          "s": 29,
          "text": "דכיון שנש\"י מתעלים במקורם הראשון כו',"
        },
        {
          "s": 30,
          "text": "הרי משם יכול להאיר גם לחלק אור הנשמה אלקית שמלובשת בלבוש גס כו',"
        },
        {
          "s": 31,
          "text": "שגם הם יהיו קמים ועומדים לפני הוי' ממש."
        },
        {
          "s": 32,
          "text": "ויש לומר,"
        },
        {
          "s": 33,
          "text": "שזהו הטעם שמביא בהמאמר פסוקים אלו"
        },
        {
          "s": 34,
          "text": "[ולא הפסוק נציב שנאמר בשלמה60,"
        },
        {
          "s": 35,
          "text": "וגם לא הפסוק נצב מלך61,"
        },
        {
          "s": 36,
          "text": "כרגיל בכ\"מ],"
        },
        {
          "s": 37,
          "text": "בכדי לרמז שהעילוי דנצבים ישנו גם בגרך"
        },
        {
          "s": 38,
          "text": "(נה\"ב הנמשכת מבחי' אוה\"ע),"
        },
        {
          "s": 39,
          "text": "וכמו וישם באדום נציבים ונציב פלשתים,"
        },
        {
          "s": 40,
          "text": "שגם ה\"נצבים\" הם מאדום ופלשתים,"
        },
        {
          "s": 41,
          "text": "ומ\"מ הם נצבים"
        },
        {
          "s": 42,
          "text": "[ולא הביא הפסוק ומלך אין באדום נצב מלך,"
        },
        {
          "s": 43,
          "text": "כי פירושו הוא שהנצב הוא במקום מלך,"
        },
        {
          "s": 44,
          "text": "וזה שולל בהמאמר בנוגע לגרך]."
        },
        {
          "s": 45,
          "text": "וגם בחוטב עציך ושואב מימיך,"
        },
        {
          "s": 46,
          "text": "וכמו הנער הנצב על הקוצרים,"
        },
        {
          "s": 47,
          "text": "שעם היותו גם הוא מהעובדים במלאכה,"
        },
        {
          "s": 48,
          "text": "מ\"מ"
        },
        {
          "s": 49,
          "text": "(להיותו ממונה עליהם)"
        },
        {
          "s": 50,
          "text": "הוא נצב."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וממשיך שם62,"
        },
        {
          "s": 2,
          "text": "דעדיין צריך להבין מ\"ש לשון כולכם,"
        },
        {
          "s": 3,
          "text": "דמשמע שכל ישראל נצבים בהתכללות כולם כאיש אחד,"
        },
        {
          "s": 4,
          "text": "משא\"כ בפסוק ויהי בישורון מלך בהתאסף ראשי עם גו' משמע שעיקר ההתכללות הוא בראשי עם דוקא,"
        },
        {
          "s": 5,
          "text": "שהתאספות היא ע\"י הראשים."
        },
        {
          "s": 6,
          "text": "וגם מהו הלשון בהתאסף,"
        },
        {
          "s": 7,
          "text": "שמשמע שיתאספו ממילא,"
        },
        {
          "s": 8,
          "text": "ולא שצריך לאספם ולחברם יחד."
        },
        {
          "s": 9,
          "text": "ומבאר בזה,"
        },
        {
          "s": 10,
          "text": "דמ\"ש אתם נצבים כולכם,"
        },
        {
          "s": 11,
          "text": "הגם שקאי על ר\"ה שאז מתכללים יחד כללות נש\"י כו',"
        },
        {
          "s": 12,
          "text": "הנה זהו ענין ההתכללות כפי שהוא מצד המקבלים,"
        },
        {
          "s": 13,
          "text": "שמתעלים מלמטה למעלה,"
        },
        {
          "s": 14,
          "text": "ועז\"נ63"
        },
        {
          "s": 15,
          "text": "שמאלו תחת לראשי"
        },
        {
          "s": 16,
          "text": "(דכנס\"י),"
        },
        {
          "s": 17,
          "text": "להגבי' אותם ולהעלותם למעלה."
        },
        {
          "s": 18,
          "text": "אך יש בחי' אחדות הנפעלת מצד הגילוי מלמעלה,"
        },
        {
          "s": 19,
          "text": "באופן דימינו תחבקני63,"
        },
        {
          "s": 20,
          "text": "שזהו ביוהכ\"פ,"
        },
        {
          "s": 21,
          "text": "וכמ\"ש64"
        },
        {
          "s": 22,
          "text": "ביום השלישי יקימנו ונחי' לפניו,"
        },
        {
          "s": 23,
          "text": "שהתאחדות זו היא מצד גילוי המשפיע,"
        },
        {
          "s": 24,
          "text": "שזה פועל בתחילה בראשי עם,"
        },
        {
          "s": 25,
          "text": "וגם בזה כתיב בהתאסף בדרך ממילא,"
        },
        {
          "s": 26,
          "text": "כי נעשה בדרך ממילא מצד גילוי המשפיע."
        },
        {
          "s": 27,
          "text": "ושני ענינים אלו היו גם בשעת מתן תורה,"
        },
        {
          "s": 28,
          "text": "דבתחילה כתיב65"
        },
        {
          "s": 29,
          "text": "ויחן שם ישראל,"
        },
        {
          "s": 30,
          "text": "כאיש אחד בלב אחד,"
        },
        {
          "s": 31,
          "text": "שזהו ענין האחדות שמצד המקבל,"
        },
        {
          "s": 32,
          "text": "שזה הי' בראש חודש סיון66,"
        },
        {
          "s": 33,
          "text": "ואח\"כ הי' ענין האחדות שנפעל ביום מתן תורה עצמו,"
        },
        {
          "s": 34,
          "text": "שאז כתיב67"
        },
        {
          "s": 35,
          "text": "וירד הוי' על הר סיני,"
        },
        {
          "s": 36,
          "text": "שהי' גילוי העצמות68,"
        },
        {
          "s": 37,
          "text": "ומזה נעשה ענין האחדות בתכלית,"
        },
        {
          "s": 38,
          "text": "בהתאסף ראשי עם."
        },
        {
          "s": 39,
          "text": "ועד\"ז הוא ביום הכיפורים שהוא ג\"כ זמן מתן תורה,"
        },
        {
          "s": 40,
          "text": "יום שבו ניתנו לוחות האחרונות69."
        },
        {
          "s": 41,
          "text": "וזהו אמיתית הענין דאתם נצבים כולכם לפני הוי',"
        },
        {
          "s": 42,
          "text": "היינו לפני הוי' ממש,"
        },
        {
          "s": 43,
          "text": "שעז\"נ64"
        },
        {
          "s": 44,
          "text": "ביום השלישי יקימנו ונחי' לפניו."
        }
      ]
    }
  ]
}