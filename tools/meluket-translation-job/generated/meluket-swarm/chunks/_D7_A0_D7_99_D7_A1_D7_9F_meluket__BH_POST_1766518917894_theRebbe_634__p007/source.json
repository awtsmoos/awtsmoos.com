{
  "globalIndex": 704,
  "owner": 4,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917894_theRebbe_634__p007",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917894_theRebbe_634__p007",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917894_theRebbe_634",
  "title": "מאמר כימי צאתך תשי\"ב",
  "part": 7,
  "sections": [
    {
      "v": 18,
      "items": [
        {
          "s": 0,
          "text": "ומדייק הכתוב כימי צאתך מארץ מצרים,"
        },
        {
          "s": 1,
          "text": "כימי לשון רבים,"
        },
        {
          "s": 2,
          "text": "שבזה נכלל גם הנס דקריעת ים סוף שהי' ביום השביעי דיציאת מצרים"
        },
        {
          "s": 3,
          "text": "(כנ\"ל סעיף ב),"
        },
        {
          "s": 4,
          "text": "בכדי להדגיש שבקריעת ים סוף נפתח הצנור ונכלל בה בהעלם גם בקיעת הים שתהי' לע\"ל"
        },
        {
          "s": 5,
          "text": "(והחרים הוי' את לשון ים מצרים גו'),"
        },
        {
          "s": 6,
          "text": "ויתירה מזו – גם בקיעת הנהר שתהי' לע\"ל"
        },
        {
          "s": 7,
          "text": "(והניף ידו על הנהר גו' והכהו לשבעה נחלים)."
        },
        {
          "s": 8,
          "text": "דהגם שבקיעת הנהר הוא למעלה מבקיעת הים,"
        },
        {
          "s": 9,
          "text": "דבקיעת הים הוא חיבור אצילות ובי\"ע ובקיעת הנהר הוא חיבור העולמות"
        },
        {
          "s": 10,
          "text": "(אצילות ובי\"ע)"
        },
        {
          "s": 11,
          "text": "עם אוא\"ס הבל\"ג שלמעלה מאצילות53,"
        },
        {
          "s": 12,
          "text": "מ\"מ,"
        },
        {
          "s": 13,
          "text": "בבקיעת הים שהיתה ביציאת מצרים נכלל בהעלם בקיעת הים דלע\"ל וגם בקיעת הנהר דלע\"ל."
        }
      ]
    },
    {
      "v": 19,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "שהקשר דשני הענינים באראנו נפלאות,"
        },
        {
          "s": 2,
          "text": "שבהנפלאות שיהיו בגאולה העתידה יהי' גם הפלא דבקיעת הים ובקיעת הנהר"
        },
        {
          "s": 3,
          "text": "(כימי לשון רבים)"
        },
        {
          "s": 4,
          "text": "ושהנסים המלובשים בטבע יהיו באופן דאראנו,"
        },
        {
          "s": 5,
          "text": "הוא,"
        },
        {
          "s": 6,
          "text": "כי זה שלע\"ל הטבע לא יעלים על הנסים המלובשים בו הוא לפי שאז יהי' החיבור דאוא\"ס הבל\"ג עם הגבול דטבע העולם,"
        },
        {
          "s": 7,
          "text": "וחיבור זה הוא ע\"י בקיעת הים ובקיעת הנהר."
        },
        {
          "s": 8,
          "text": "ומבאר הכתוב,"
        },
        {
          "s": 9,
          "text": "דזה שלע\"ל יהי' אראנו נפלאות"
        },
        {
          "s": 10,
          "text": "(בנוגע לשני ענינים הנ\"ל)"
        },
        {
          "s": 11,
          "text": "הוא כימי צאתך מארץ מצרים,"
        },
        {
          "s": 12,
          "text": "שפתיחת הצנור על זה היתה ביציאת מצרים."
        }
      ]
    },
    {
      "v": 20,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "ויש לומר,"
        },
        {
          "s": 3,
          "text": "דזה שהכתוב מוסיף"
        },
        {
          "s": 4,
          "text": "(לאחרי שאומר והניף ידו על הנהר גו')"
        },
        {
          "s": 5,
          "text": "והדריך בנעלים,"
        },
        {
          "s": 6,
          "text": "הוא,"
        },
        {
          "s": 7,
          "text": "כי כמו54"
        },
        {
          "s": 8,
          "text": "שנעלים כפשוטם עשויים מעור גס,"
        },
        {
          "s": 9,
          "text": "ובכדי שהעור הגס יהי' ראוי לעשות ממנו נעל"
        },
        {
          "s": 10,
          "text": "(לבוש לרגלי האדם)"
        },
        {
          "s": 11,
          "text": "הוא ע\"י שמרככים את העור מקשיותו,"
        },
        {
          "s": 12,
          "text": "דהעור כמו שהוא מצד עצמו"
        },
        {
          "s": 13,
          "text": "(טרם שמרככין אותו),"
        },
        {
          "s": 14,
          "text": "להיותו קשה וגס א\"א להטות אותו,"
        },
        {
          "s": 15,
          "text": "ודוקא ע\"י שמרככין אותו מקשיותו אז דוקא אפשר להטותו ולעשות ממנו צורת נעל,"
        },
        {
          "s": 16,
          "text": "עד\"ז הוא ברוחניות,"
        },
        {
          "s": 17,
          "text": "דענין והדריך בנעלים הוא שדורך על טבע גופו ונפשו הבהמית,"
        },
        {
          "s": 18,
          "text": "שעי\"ז מרכך אותם מקשיותם שלא יהיו קשים כארז אלא רך כקנה55."
        },
        {
          "s": 19,
          "text": "וזהו שעבודה היא מלשון עיבוד עורות56,"
        },
        {
          "s": 20,
          "text": "כי עיקר ענין העבודה הוא שהאדם לוחם עם טבעו,"
        },
        {
          "s": 21,
          "text": "כמבואר בתניא57"
        },
        {
          "s": 22,
          "text": "בענין עובד אלקים."
        },
        {
          "s": 23,
          "text": "ועי\"ז נעשה זיכוך"
        },
        {
          "s": 24,
          "text": "(לא רק בהטבע של האדם,"
        },
        {
          "s": 25,
          "text": "אלא)"
        },
        {
          "s": 26,
          "text": "גם בהטבע דכללות העולם,"
        },
        {
          "s": 27,
          "text": "דזהו\"ע עובד אלקים,"
        },
        {
          "s": 28,
          "text": "אלקים בגימטריא הטבע58,"
        },
        {
          "s": 29,
          "text": "שנעשה עיבוד ותיקון בכללות הטבע הנמשך משם אלקים59."
        },
        {
          "s": 30,
          "text": "וזהו והניף ידו על הנהר גו' והדריך בנעלים,"
        },
        {
          "s": 31,
          "text": "דזה שלע\"ל יהי' החיבור דטבע העולם עם אוא\"ס הבל\"ג שלמעלה מעולמות,"
        },
        {
          "s": 32,
          "text": "שההכנה לזה היא בקיעת הנהר,"
        },
        {
          "s": 33,
          "text": "הוא ע\"י העבודה בדרך קבלת עול,"
        },
        {
          "s": 34,
          "text": "שכופה עצמו נגד טבעו."
        }
      ]
    }
  ]
}