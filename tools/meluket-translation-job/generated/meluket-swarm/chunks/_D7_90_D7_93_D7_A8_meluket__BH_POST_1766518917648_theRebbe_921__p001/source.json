{
  "globalIndex": 658,
  "owner": 8,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917648_theRebbe_921__p001",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917648_theRebbe_921__p001",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917648_theRebbe_921",
  "title": "מאמר החודש הזה לכם תשל\"ט",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "מוצש\"ק פ' ויקהל-פקודי,"
        },
        {
          "s": 2,
          "text": "פ' החודש,"
        },
        {
          "s": 3,
          "text": "כ\"ה אדר ה'תשל\"ט*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "החודש הזה לכם ראש חדשים ראשון הוא לכם לחדשי השנה1,"
        },
        {
          "s": 1,
          "text": "ומביא כ\"ק מו\"ח אדמו\"ר במאמרו ד\"ה זה"
        },
        {
          "s": 2,
          "text": "(בתחלת בואו לארה\"ב)2"
        },
        {
          "s": 3,
          "text": "דאיתא בתרגום יונתן עה\"פ3"
        },
        {
          "s": 4,
          "text": "בירח האיתנים גו' הוא חודש השביעי"
        },
        {
          "s": 5,
          "text": "(שקאי על חודש תשרי),"
        },
        {
          "s": 6,
          "text": "דעתיקייא קרן לי' ירחא קדמאה כו' וכען הוא ירחא שביעאה,"
        },
        {
          "s": 7,
          "text": "שקודם מתן תורה4"
        },
        {
          "s": 8,
          "text": "הי' נקרא תשרי בשם חודש הראשון לפי שבו נברא העולם5,"
        },
        {
          "s": 9,
          "text": "וכען,"
        },
        {
          "s": 10,
          "text": "לאחרי יציאת מצרים ומתן תורה,"
        },
        {
          "s": 11,
          "text": "ניסן הוא חודש הראשון ותשרי הוא חודש השביעי."
        },
        {
          "s": 12,
          "text": "ומדייק בזה,"
        },
        {
          "s": 13,
          "text": "דמכיון שבתחלה הי' תשרי חודש הראשון למה נשתנה שניסן יהי' הראשון."
        },
        {
          "s": 14,
          "text": "ואם מפני הגאולה שהיתה בניסן,"
        },
        {
          "s": 15,
          "text": "הא גופא צריך ביאור,"
        },
        {
          "s": 16,
          "text": "הרי אתחלתא דגאולה הי' בתשרי,"
        },
        {
          "s": 17,
          "text": "דבר\"ה"
        },
        {
          "s": 18,
          "text": "(אחד בתשרי)"
        },
        {
          "s": 19,
          "text": "בטלה עבודה מאבותינו6,"
        },
        {
          "s": 20,
          "text": "ולמה חודש הגאולה"
        },
        {
          "s": 21,
          "text": "(שלימה)"
        },
        {
          "s": 22,
          "text": "הוא ניסן דוקא."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ולהעיר,"
        },
        {
          "s": 2,
          "text": "שבכמה דרושים7"
        },
        {
          "s": 3,
          "text": "הדיוק בזה שניסן הוא ראש חדשים הוא בזה שאחד בתשרי הוא ראש השנה"
        },
        {
          "s": 4,
          "text": "(דזה שאחד בתשרי הוא ראש השנה הוא גם עכשיו לאחרי יציאת מצרים ומתן תורה),"
        },
        {
          "s": 5,
          "text": "דמכיון שזה שנקרא בשם ראש השנה הוא8"
        },
        {
          "s": 6,
          "text": "לפי שהוא כולל החיות של כל השנה בדוגמת הראש שכולל החיות של כל אברי הגוף,"
        },
        {
          "s": 7,
          "text": "ונחלק אח\"כ לי\"ב ראשי חדשים וכל ר\"ח ללמ\"ד"
        },
        {
          "s": 8,
          "text": "(כ\"ט)"
        },
        {
          "s": 9,
          "text": "יום,"
        },
        {
          "s": 10,
          "text": "הרי נמצא שהחיות דחודש ניסן הוא מתשרי,"
        },
        {
          "s": 11,
          "text": "וכאן נאמר שניסן הוא ראש חדשים וראשון לחדשי השנה"
        },
        {
          "s": 12,
          "text": "(גם לחודש תשרי)."
        },
        {
          "s": 13,
          "text": "ומבארים בזה7,"
        },
        {
          "s": 14,
          "text": "דהחיות שנמשך בתשרי על כל השנה הוא בבחינת גבול ומדה"
        },
        {
          "s": 15,
          "text": "(שבכללות הוא החיות שמלובש בהנבראים בפנימיותם),"
        },
        {
          "s": 16,
          "text": "שהוא השרש דהנהגת הטבע."
        },
        {
          "s": 17,
          "text": "וזה שניסן נק' ראש הוא בנוגע להמשכת אוא\"ס הבל\"ג,"
        },
        {
          "s": 18,
          "text": "שהוא השרש דהנהגה ניסית שלמעלה מהטבע."
        },
        {
          "s": 19,
          "text": "ועפ\"ז מבארים9"
        },
        {
          "s": 20,
          "text": "גם זה שתשרי הוא ראש השנה וניסן ראש חדשים,"
        },
        {
          "s": 21,
          "text": "כי הנהגת הטבע,"
        },
        {
          "s": 22,
          "text": "שהיא תמיד בשוה,"
        },
        {
          "s": 23,
          "text": "היא דוגמת מהלך השמש"
        },
        {
          "s": 24,
          "text": "(שנה מלשון משנה10,"
        },
        {
          "s": 25,
          "text": "שאותו הדבר חוזר ונשנה עוד פעם),"
        },
        {
          "s": 26,
          "text": "והנהגה ניסית שענינה הוא חידוש"
        },
        {
          "s": 27,
          "text": "[שלפעמים הקב\"ה משדד הנהגת הטבע למשך זמן],"
        },
        {
          "s": 28,
          "text": "היא דוגמת מהלך הירח,"
        },
        {
          "s": 29,
          "text": "שהיא מתחדשת בכל חודש"
        },
        {
          "s": 30,
          "text": "(חודש מלשון חידוש11)."
        },
        {
          "s": 31,
          "text": "ויש לומר,"
        },
        {
          "s": 32,
          "text": "דזה שמדייק במאמר זה שלפני יציאת מצרים הי' תשרי ראשון לחדשים,"
        },
        {
          "s": 33,
          "text": "ההדגשה בזה היא,"
        },
        {
          "s": 34,
          "text": "שלפני יציאת מצרים הי' תשרי הראשון והראש גם להמשכת אלקות שלמעלה מהטבע"
        },
        {
          "s": 35,
          "text": "[וכמובן גם מזה שגם התחלת הגאולה דיציאת מצרים היתה בתשרי],"
        },
        {
          "s": 36,
          "text": "ולמה נשתנה עכשיו שניסן הוא הראשון."
        }
      ]
    }
  ]
}