{
  "globalIndex": 1067,
  "owner": 17,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518920054_theRebbe_925__p005",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518920054_theRebbe_925__p005",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518920054_theRebbe_925",
  "title": "מאמר והי' עקב תשמעון תשט\"ז",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "וזהו שמע ישראל הוי' אלקינו הוי' אחד,"
        },
        {
          "s": 2,
          "text": "דהוי' אלקינו הוא הוי' שלמעלה מהשתלשלות כחנו וחיותינו,"
        },
        {
          "s": 3,
          "text": "שהוא בחי' הוי' עילאה,"
        },
        {
          "s": 4,
          "text": "והוי' אחד הוא הוי' תתאה,"
        },
        {
          "s": 5,
          "text": "דהוי' הוא צמצום והתפשטות המשכה והתפשטות33,"
        },
        {
          "s": 6,
          "text": "שעי\"ז"
        },
        {
          "s": 7,
          "text": "(הוי' תתאה)"
        },
        {
          "s": 8,
          "text": "אפשר להיות אחד,"
        },
        {
          "s": 9,
          "text": "היינו התהוות ז' רקיעים וארץ וד' סטרין."
        },
        {
          "s": 10,
          "text": "וזהו שמע ישראל הוי' אלקינו הוי' אחד,"
        },
        {
          "s": 11,
          "text": "דשמע ישראל הוא ההתבוננות,"
        },
        {
          "s": 12,
          "text": "הוי' אלקינו,"
        },
        {
          "s": 13,
          "text": "הוי' עילאה כחנו וחיותינו,"
        },
        {
          "s": 14,
          "text": "ועי\"ז הנה הוי'"
        },
        {
          "s": 15,
          "text": "(תתאה)"
        },
        {
          "s": 16,
          "text": "אחד,"
        },
        {
          "s": 17,
          "text": "היינו הביטול."
        },
        {
          "s": 18,
          "text": "וזהו ענין ירידת הנשמה למטה,"
        },
        {
          "s": 19,
          "text": "לפי שע\"י ההתבוננות למטה דוקא נעשה בה העבודה דתשובה,"
        },
        {
          "s": 20,
          "text": "שהיא העבודה דבל מאדך,"
        },
        {
          "s": 21,
          "text": "שעי\"ז עושין רצונו של מקום,"
        },
        {
          "s": 22,
          "text": "דהיינו המשכת רצה\"ע,"
        },
        {
          "s": 23,
          "text": "שלמעלה גם מבחי' מחשבה עילאה,"
        },
        {
          "s": 24,
          "text": "שרש הנשמות."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וזהו והי' עקב תשמעון גו' ושמרתם ועשיתם,"
        },
        {
          "s": 2,
          "text": "שהו\"ע העבודה דמחדומ\"ע כמו שהוא מצד האהבה דבכל מאדך,"
        },
        {
          "s": 3,
          "text": "הנה ע\"י עבודה זו,"
        },
        {
          "s": 4,
          "text": "אזי ושמר ה\"א לך את הברית ואת החסד ואת השבועה,"
        },
        {
          "s": 5,
          "text": "דברית חסד ושבועה הם ההמשכות שלמעלה מהשתלשלות,"
        },
        {
          "s": 6,
          "text": "והו\"ע עושין רצונו של מקום."
        },
        {
          "s": 7,
          "text": "וזהו מ\"ש ושמר את החסד,"
        },
        {
          "s": 8,
          "text": "שהכוונה היא ע\"ד מ\"ש בזהר34"
        },
        {
          "s": 9,
          "text": "ע\"פ35"
        },
        {
          "s": 10,
          "text": "ואיש כי יקח את אחותו חסד הוא,"
        },
        {
          "s": 11,
          "text": "איש דא קוב\"ה,"
        },
        {
          "s": 12,
          "text": "אשר יקח את אחותו דא כנס\"י"
        },
        {
          "s": 13,
          "text": "(והו\"ע יחוד הקב\"ה וכנס\"י,"
        },
        {
          "s": 14,
          "text": "יחוד קוב\"ה ושכינתי'),"
        },
        {
          "s": 15,
          "text": "וכ\"כ למה חסד הוא חסד הוא ודאי,"
        },
        {
          "s": 16,
          "text": "והיינו שבכדי שתהי' ההמשכה למטה הרי זה ע\"י החסד ממנו ית'."
        },
        {
          "s": 17,
          "text": "וכמ\"ש36"
        },
        {
          "s": 18,
          "text": "זכור רחמיך וחסדיך כי מעולם המה,"
        },
        {
          "s": 19,
          "text": "דענין הזכירה שייך לומר רק על דבר שנופל בו ענין השכחה,"
        },
        {
          "s": 20,
          "text": "והיינו דלהיות שכללות ההשתלשלות אינו תופס מקום לפניו ית',"
        },
        {
          "s": 21,
          "text": "לכן אנו מבקשים זכור רחמיך וחסדיך,"
        },
        {
          "s": 22,
          "text": "דרחמיך הו\"ע יגמה\"ר שלמעלה מהשתלשלות,"
        },
        {
          "s": 23,
          "text": "כמ\"ש37"
        },
        {
          "s": 24,
          "text": "ויעבור הוי' על פניו ויקרא הוי',"
        },
        {
          "s": 25,
          "text": "דמ\"ש ויעבור הוי' הוא הוי' עילאה שלמעלה מהשתלשלות,"
        },
        {
          "s": 26,
          "text": "וחסדיך הוא בחי' רב חסד שלמעלה מהשתלשלות,"
        },
        {
          "s": 27,
          "text": "כי מעולם המה,"
        },
        {
          "s": 28,
          "text": "דעולם הוא לשון העלם38,"
        },
        {
          "s": 29,
          "text": "והיינו שהם בהעלם בשרשן,"
        },
        {
          "s": 30,
          "text": "כענין ע\"ס הגנוזות,"
        },
        {
          "s": 31,
          "text": "ע\"ס דעקודים,"
        },
        {
          "s": 32,
          "text": "וצריך להמשיך בחי' זו בעולם כפשוטו,"
        },
        {
          "s": 33,
          "text": "היינו שגם למטה תהי' ההמשכה דבלי גבול,"
        },
        {
          "s": 34,
          "text": "ועי\"ז הנה ועמדו זרים ורעו צאנכם."
        },
        {
          "s": 35,
          "text": "והמשכה זו היא ע\"י האהבה דבכל מאדך דוקא,"
        },
        {
          "s": 36,
          "text": "והיינו שלא מספיק קיום התומ\"צ במחדומ\"ע בלבד,"
        },
        {
          "s": 37,
          "text": "שהרי מחדומ\"ע הם רק לבושים בלבד שבאין ערוך לכחות הנפש,"
        },
        {
          "s": 38,
          "text": "ובמכ\"ש לבחי' הרצון,"
        },
        {
          "s": 39,
          "text": "כידוע דמחשבה ודיבור הם כעין עילה ועלול,"
        },
        {
          "s": 40,
          "text": "שהמחשבה הוא עילה לגבי הדיבור,"
        },
        {
          "s": 41,
          "text": "וכמו\"כ הדיבור לגבי המעשה,"
        },
        {
          "s": 42,
          "text": "משא\"כ המחדומ\"ע לגבי כחות הנפש ובפרט לגבי הרצון הם באי\"ע,"
        },
        {
          "s": 43,
          "text": "ולכן צ\"ל העבודה דבכל מאדך דוקא,"
        },
        {
          "s": 44,
          "text": "שעי\"ז יהי' המשכת רצה\"ע."
        },
        {
          "s": 45,
          "text": "אמנם בכדי שהאהבה דבכל מאדך תפעל המשכת רצה\"ע דלמעלה,"
        },
        {
          "s": 46,
          "text": "צריך לזה כריתת ברית,"
        },
        {
          "s": 47,
          "text": "דמאחר שאין הנבראים תופסים מקום כלל,"
        },
        {
          "s": 48,
          "text": "איך ימשיכו ע\"י עבודתם,"
        },
        {
          "s": 49,
          "text": "אלא שהוא מצד הכר\"ב שהעבודה דלמטה תמשיך הגילויים מלמעלה."
        },
        {
          "s": 50,
          "text": "ולכן מקדים הכתוב את הברית לחסד ושבועה,"
        },
        {
          "s": 51,
          "text": "לפי שכללות ההמשכה הוא מצד הברית."
        },
        {
          "s": 52,
          "text": "וזהו והי' עקב תשמעון גו',"
        },
        {
          "s": 53,
          "text": "דבהזמן דעקבתא דמשיחא תשמעון ודאי,"
        },
        {
          "s": 54,
          "text": "לפי שהוא דור היותר אחרון,"
        },
        {
          "s": 55,
          "text": "ולא ידח ממנו נדח39,"
        },
        {
          "s": 56,
          "text": "ולכן תשמעון ודאי,"
        },
        {
          "s": 57,
          "text": "בבחי' בכל מאדך,"
        },
        {
          "s": 58,
          "text": "ועי\"ז ושמר את הברית גו',"
        },
        {
          "s": 59,
          "text": "שתהי' הגאולה מהגלות ביד רמה,"
        },
        {
          "s": 60,
          "text": "ע\"י משיח צדקנו,"
        },
        {
          "s": 61,
          "text": "במהרה בימינו."
        }
      ]
    }
  ]
}