{
  "globalIndex": 446,
  "owner": 46,
  "jobId": "_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916328_theRebbe_715__p002",
  "batchId": "meluket-_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916328_theRebbe_715__p002",
  "seriesId": "טבת_meluket",
  "postId": "BH_POST_1766518916328_theRebbe_715",
  "title": "מאמר וארא אל אברהם תשל\"ה",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ועוד ראי' על זה11,"
        },
        {
          "s": 1,
          "text": "דאיתא בגמרא12"
        },
        {
          "s": 2,
          "text": "בן ג' שנים הכיר אברהם את בוראו,"
        },
        {
          "s": 3,
          "text": "וברמב\"ם13"
        },
        {
          "s": 4,
          "text": "איתא בן ארבעים שנה הכיר את בוראו,"
        },
        {
          "s": 5,
          "text": "ועוד דיעה"
        },
        {
          "s": 6,
          "text": "(במדרש14)"
        },
        {
          "s": 7,
          "text": "שבן מ\"ח שנה הכיר את בוראו,"
        },
        {
          "s": 8,
          "text": "ומבואר במק\"א15"
        },
        {
          "s": 9,
          "text": "שאין זה פלוגתא במציאות,"
        },
        {
          "s": 10,
          "text": "כי כמה וכמה דרגות בזה."
        },
        {
          "s": 11,
          "text": "ועפ\"ז,"
        },
        {
          "s": 12,
          "text": "באם נאמר שבאמירת הקב\"ה לאברהם אני א-ל שדי נתגלה לו רק האלקות שבהבריאה"
        },
        {
          "s": 13,
          "text": "(שאמרתי לעולמי די),"
        },
        {
          "s": 14,
          "text": "צריך לומר,"
        },
        {
          "s": 15,
          "text": "דזה שאמר הקב\"ה לאברהם"
        },
        {
          "s": 16,
          "text": "(בהיותו בן צ\"ט שנה)"
        },
        {
          "s": 17,
          "text": "אני א-ל שדי,"
        },
        {
          "s": 18,
          "text": "אף שכו\"כ שנים לפנ\"ז הכיר את בוראו,"
        },
        {
          "s": 19,
          "text": "הוא,"
        },
        {
          "s": 20,
          "text": "שמקודם הכיר את בוראו ע\"פ הכרח השכל וכו',"
        },
        {
          "s": 21,
          "text": "ואין זה דומה להידיעה וההכרה ע\"י שמגלים מלמעלה16."
        },
        {
          "s": 22,
          "text": "אבל מזה שאמר לו הקב\"ה אני א-ל שדי"
        },
        {
          "s": 23,
          "text": "(בלשון חידוש)"
        },
        {
          "s": 24,
          "text": "משמע שבאמירה זו גילה לו הקב\"ה ענין חדש שלא ידע מקודם."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והענין הוא,"
        },
        {
          "s": 2,
          "text": "כמבואר בהדרושים17,"
        },
        {
          "s": 3,
          "text": "דבשם שדי שני פירושים."
        },
        {
          "s": 4,
          "text": "שאמרתי לעולמי די,"
        },
        {
          "s": 5,
          "text": "ושדי באלקותי לכל ברי'18."
        },
        {
          "s": 6,
          "text": "והחילוק בין שני הפירושים"
        },
        {
          "s": 7,
          "text": "(הענינים)"
        },
        {
          "s": 8,
          "text": "הוא,"
        },
        {
          "s": 9,
          "text": "הן בפירוש תיבת \"די\" והן בהענין שתיבת \"די\" מדברת עליו."
        },
        {
          "s": 10,
          "text": "להפירוש ששם שדי הוא שאמרתי לעולמי די,"
        },
        {
          "s": 11,
          "text": "תיבת די מדברת להעולם"
        },
        {
          "s": 12,
          "text": "(שאמרתי לעולמי די),"
        },
        {
          "s": 13,
          "text": "ופירוש די הוא הגבלה,"
        },
        {
          "s": 14,
          "text": "שהעולם יהי' בהגבלה ולא יהי' נמתח והולך."
        },
        {
          "s": 15,
          "text": "ולהפירוש ששם שדי הוא שדי באלקותי לכל ברי',"
        },
        {
          "s": 16,
          "text": "תיבת די מדברת לאלקות"
        },
        {
          "s": 17,
          "text": "(שדי באלקותי לכל ברי'),"
        },
        {
          "s": 18,
          "text": "ופירוש די הוא ריבוי גדול ביותר שהוא די ומספיק לכל ברי'."
        },
        {
          "s": 19,
          "text": "וע\"ד די מחסורו אשר יחסר לו19,"
        },
        {
          "s": 20,
          "text": "ריבוי גדול שממלא כל מחסורו,"
        },
        {
          "s": 21,
          "text": "אפילו סוס לרכוב עליו ועבד לרוץ לפניו20."
        },
        {
          "s": 22,
          "text": "[והגם שגם די מחסורו הוא בהגבלה,"
        },
        {
          "s": 23,
          "text": "די מחסורו ואי אתה מצווה עליו לעשרו20,"
        },
        {
          "s": 24,
          "text": "ההדגשה בדי מחסורו היא לא על ההגבלה אלא על הריבוי שממלא כל מחסורו]."
        },
        {
          "s": 25,
          "text": "וזהו החידוש בוארא אל האבות21"
        },
        {
          "s": 26,
          "text": "בא-ל שדי,"
        },
        {
          "s": 27,
          "text": "מתחיל מאברהם שנאמר לו אני א-ל שדי,"
        },
        {
          "s": 28,
          "text": "לגבי שם שדי שהי' בהבריאה,"
        },
        {
          "s": 29,
          "text": "דשם שדי שהי' בבריאת העולם הוא על שם שאמרתי לעולמי די,"
        },
        {
          "s": 30,
          "text": "ושם שדי שנתגלה לאברהם"
        },
        {
          "s": 31,
          "text": "[וכן ליצחק וליעקב]"
        },
        {
          "s": 32,
          "text": "הוא על שם שדי באלקותי לכל ברי'."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה גם הגילוי דא-ל שדי שנתגלה להאבות,"
        },
        {
          "s": 2,
          "text": "על שם שדי באלקותי לכל ברי',"
        },
        {
          "s": 3,
          "text": "הוא למטה מהגילוי דשם הוי',"
        },
        {
          "s": 4,
          "text": "וארא אל האבות בא-ל שדי ושמי הוי' לא נודעתי להם."
        },
        {
          "s": 5,
          "text": "ומבואר בהדרושים17,"
        },
        {
          "s": 6,
          "text": "שבהגילוי דשם שדי על שם שדי באלקותי לכל ברי' נכלל גם ענין הנסים."
        },
        {
          "s": 7,
          "text": "דכיון שענין די באלקותי לכל ברי' הוא ע\"ד די מחסורו שפירושו הוא כל מה שיחסר לו,"
        },
        {
          "s": 8,
          "text": "הרי מובן,"
        },
        {
          "s": 9,
          "text": "שגם כשהבריות"
        },
        {
          "s": 10,
          "text": "(כל ברי')"
        },
        {
          "s": 11,
          "text": "יצטרכו לנס,"
        },
        {
          "s": 12,
          "text": "די בהאלקות דשם שדי למלאות להם גם חסרון זה."
        },
        {
          "s": 13,
          "text": "אלא שהנסים הנמשכים משם שדי הם נסים המלובשים בטבע,"
        },
        {
          "s": 14,
          "text": "והנסים שלמעלה מהטבע,"
        },
        {
          "s": 15,
          "text": "המשכתם הוא משם הוי'."
        }
      ]
    }
  ]
}