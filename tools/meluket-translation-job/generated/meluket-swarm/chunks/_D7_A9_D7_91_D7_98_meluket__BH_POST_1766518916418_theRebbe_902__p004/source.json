{
  "globalIndex": 463,
  "owner": 13,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916418_theRebbe_902__p004",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916418_theRebbe_902__p004",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916418_theRebbe_902",
  "title": "מאמר לה\"ע כתיבת ספר תורה תש\"ל",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ועד\"ז מבואר ג\"כ בהמשך מים רבים שלו47"
        },
        {
          "s": 1,
          "text": "בענין אין עוד מלבדו48"
        },
        {
          "s": 2,
          "text": "[נוסף על המבואר שם49"
        },
        {
          "s": 3,
          "text": "בענין הגדול הגבור כו'50"
        },
        {
          "s": 4,
          "text": "(ואמרז\"ל51"
        },
        {
          "s": 5,
          "text": "הגדולה52"
        },
        {
          "s": 6,
          "text": "זו מעשה בראשית)"
        },
        {
          "s": 7,
          "text": "המבואר בשער היחוד והאמונה53,"
        },
        {
          "s": 8,
          "text": "שזה בא בהמשך להמבואר שם בתחלת ההמשך,"
        },
        {
          "s": 9,
          "text": "דאע\"פ שהנשמה יורדת למקום שישנם מים רבים ונהרות המבלבלים,"
        },
        {
          "s": 10,
          "text": "הרי אעפ\"כ מים רבים לא יוכלו לכבות את האהבה ונהרות לא ישטפוה54,"
        },
        {
          "s": 11,
          "text": "הנה נוסף לזה מבואר שם55],"
        },
        {
          "s": 12,
          "text": "דאף שהעולם הוא מציאות,"
        },
        {
          "s": 13,
          "text": "בכ\"ז אמיתית ענינו הוא אלקות,"
        },
        {
          "s": 14,
          "text": "ודוקא למטה נראה ענין זה,"
        },
        {
          "s": 15,
          "text": "כמבואר שם בארוכה."
        },
        {
          "s": 16,
          "text": "ועד\"ז מבואר במאמרי כ\"ק אדמו\"ר"
        },
        {
          "s": 17,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 18,
          "text": "נ\"ע56"
        },
        {
          "s": 19,
          "text": "שדוקא למטה בעוה\"ז נראה ונגלה איך שאין ערוך לך,"
        },
        {
          "s": 20,
          "text": "ועי\"ז אנו יודעים שגם העולמות העליונים הם בבחי' אין ערוך לגבי העצמות."
        },
        {
          "s": 21,
          "text": "ועד\"ז הוא גם בענין אין עוד מלבדו."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה אמיתית הענין שהיש הנברא אמיתית מציאותו הוא יש האמיתי,"
        },
        {
          "s": 2,
          "text": "עצמותו ית',"
        },
        {
          "s": 3,
          "text": "קאי על נשמות ישראל כמו שהם למטה,"
        },
        {
          "s": 4,
          "text": "שהרי דוקא עליהם שייך לומר התואר דיש"
        },
        {
          "s": 5,
          "text": "(כי הם בבחי' מציאות),"
        },
        {
          "s": 6,
          "text": "משא\"כ אוה\"ע וכו' אינם בבחי' מציאות57,"
        },
        {
          "s": 7,
          "text": "כי כל ענינם הוא רק מה שהם טפלים לנש\"י58"
        },
        {
          "s": 8,
          "text": "(כמבואר בכ\"מ),"
        },
        {
          "s": 9,
          "text": "ומה שאומרים דהיש הנברא הוא יש האמיתי,"
        },
        {
          "s": 10,
          "text": "קאי על נשמות ישראל למטה ששרשם בעצמותו ית'."
        },
        {
          "s": 11,
          "text": "ואף שכל הנמצאים לא נמצאו אלא מאמיתת המצאו"
        },
        {
          "s": 12,
          "text": "(וזהו יסוד היסודות ועמוד החכמות כו')59,"
        },
        {
          "s": 13,
          "text": "בכ\"ז,"
        },
        {
          "s": 14,
          "text": "הנשמות הם חלק אלוקה ממעל ממש60,"
        },
        {
          "s": 15,
          "text": "וידועה תורת הבעש\"ט61"
        },
        {
          "s": 16,
          "text": "שכשאתה תופס במקצת מן העצם אתה תופס בכולו."
        },
        {
          "s": 17,
          "text": "ובזה יובן גם זה שבהיות הנשמה למטה הנה אַ איד ניט ער וויל און ניט ער קען זיין אָפּגעריסן פון געטליכקייט ח\"ו62,"
        },
        {
          "s": 18,
          "text": "כי גם כמו שהוא נמצא למטה הרי באמיתת מציאותו נרגש בו כביכול אמיתית המציאות דעצמותו ומהותו ית' שמציאותו הוא מעצמותו ואינו עלול מאיזה עילה שקדמה לו ח\"ו."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וזהו ויכתוב משה את מוצאיהם למסעיהם ואלה מסעיהם למוצאיהם,"
        },
        {
          "s": 2,
          "text": "שמשה רבינו המשיך בחינת עצמותו ומהותו ית'"
        },
        {
          "s": 3,
          "text": "(מוצאיהם)"
        },
        {
          "s": 4,
          "text": "בהנשמה למטה"
        },
        {
          "s": 5,
          "text": "(מסעיהם),"
        },
        {
          "s": 6,
          "text": "ועי\"ז נעשה אח\"כ עליית הנשמה,"
        },
        {
          "s": 7,
          "text": "ואלה מסעיהם למוצאיהם."
        },
        {
          "s": 8,
          "text": "וכמבואר בארוכה במאמרי יום ההילולא דיו\"ד שבט63"
        },
        {
          "s": 9,
          "text": "(ובפרט בפרק העשרים שבו64)"
        },
        {
          "s": 10,
          "text": "בענין ירידת הנשמה,"
        },
        {
          "s": 11,
          "text": "דלהיות שהנשמה ירדה למטה מטה,"
        },
        {
          "s": 12,
          "text": "בגוף ונה\"ט,"
        },
        {
          "s": 13,
          "text": "לכן,"
        },
        {
          "s": 14,
          "text": "בכדי שתוכל לעמוד בכל הנסיונות,"
        },
        {
          "s": 15,
          "text": "ותמלא שליחותה ותפקידה,"
        },
        {
          "s": 16,
          "text": "צריכה היא למדת הנצחון דוקא,"
        },
        {
          "s": 17,
          "text": "ומדת הנצחון מביאה המשכת והתגלות אוצר העליון שהוא גילוי פנימיות ועצמות אין סוף ב\"ה."
        },
        {
          "s": 18,
          "text": "ויתירה מזו,"
        },
        {
          "s": 19,
          "text": "דע\"י עבודת האדם נעשה עילוי,"
        },
        {
          "s": 20,
          "text": "כביכול,"
        },
        {
          "s": 21,
          "text": "גם למעלה."
        },
        {
          "s": 22,
          "text": "וכידוע תורת הרב המגיד65"
        },
        {
          "s": 23,
          "text": "בפי' המשנה66"
        },
        {
          "s": 24,
          "text": "דע מה למעלה ממך,"
        },
        {
          "s": 25,
          "text": "פי' דע כל מה שלמעלה,"
        },
        {
          "s": 26,
          "text": "בפרצופים וספירות העליונות,"
        },
        {
          "s": 27,
          "text": "הכל הוא ממך,"
        },
        {
          "s": 28,
          "text": "שתלוי בעבודת האדם."
        },
        {
          "s": 29,
          "text": "ובפרטיות יותר,"
        },
        {
          "s": 30,
          "text": "מבואר בתורתו67"
        },
        {
          "s": 31,
          "text": "עה\"פ68"
        },
        {
          "s": 32,
          "text": "עשה לך שתי חצוצרות כסף"
        },
        {
          "s": 33,
          "text": "[שזה נאמר במשה רבינו רעיא מהימנא],"
        },
        {
          "s": 34,
          "text": "חצוצרות הוא שתי חצאי צורות,"
        },
        {
          "s": 35,
          "text": "שע\"י עבודת האדם למטה הרי הוא פועל שלימות למעלה כביכול שתהי' צורה שלימה."
        }
      ]
    }
  ]
}