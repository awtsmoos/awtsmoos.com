{
  "globalIndex": 299,
  "owner": 49,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915493_theRebbe_561__p001",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915493_theRebbe_561__p001",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915493_theRebbe_561",
  "title": "מאמר וכל בניך תשמ\"א",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ וישלח,"
        },
        {
          "s": 2,
          "text": "י\"ד כסלו ה'תשמ\"א*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "וכל בניך לימודי הוי' ורב שלום בניך1,"
        },
        {
          "s": 1,
          "text": "ומביא כ\"ק מו\"ח אדמו\"ר במאמרו ד\"ה זה2"
        },
        {
          "s": 2,
          "text": "(שבקונטרס דרושי חתונה תרפ\"ט3),"
        },
        {
          "s": 3,
          "text": "דבורב שלום בניך שני פירושים."
        },
        {
          "s": 4,
          "text": "הא',"
        },
        {
          "s": 5,
          "text": "דפירוש ורב שלום בניך הוא שיהי' רוב שלום לבניך,"
        },
        {
          "s": 6,
          "text": "כפירוש המצודת דוד והתרגום."
        },
        {
          "s": 7,
          "text": "והב',"
        },
        {
          "s": 8,
          "text": "דפירוש ורב שלום בניך הוא שע\"י בניך נעשה ריבוי שלום בעולם,"
        },
        {
          "s": 9,
          "text": "כמאמר רז\"ל4"
        },
        {
          "s": 10,
          "text": "תלמידי חכמים מרבים שלום בעולם שנאמר וכל בניך לימודי הוי' ורב שלום בניך אל תקרי בניך אלא בוניך."
        },
        {
          "s": 11,
          "text": "ומבאר בהמאמר,"
        },
        {
          "s": 12,
          "text": "דזה מה שתלמידי חכמים נק' בוניך הוא כמארז\"ל5"
        },
        {
          "s": 13,
          "text": "מאי בנאין אלו תלמידי חכמים שעוסקין בבנינו של עולם."
        },
        {
          "s": 14,
          "text": "ומזה מובן,"
        },
        {
          "s": 15,
          "text": "דזה שתלמידי חכמים מרבים שלום בעולם הוא לא מצד המעלה דתלמידי חכמים"
        },
        {
          "s": 16,
          "text": "(לימוד התורה)"
        },
        {
          "s": 17,
          "text": "כמו שהיא מצד עצמה,"
        },
        {
          "s": 18,
          "text": "אלא עי\"ז שהם עוסקים בבנינו של עולם,"
        },
        {
          "s": 19,
          "text": "שע\"י עסקם בתורה נעשה הבירור דעולם."
        },
        {
          "s": 20,
          "text": "וזהו וכל בניך לימודי הוי' ורב שלום בניך,"
        },
        {
          "s": 21,
          "text": "שמבאר כאן שני ענינים."
        },
        {
          "s": 22,
          "text": "וכל בניך לימודי הוי',"
        },
        {
          "s": 23,
          "text": "דפירוש לימודי הוי' הוא דאלפין באורייתא דהוי'6"
        },
        {
          "s": 24,
          "text": "– המעלה דתלמידי חכמים מצד עצמם,"
        },
        {
          "s": 25,
          "text": "ואח\"כ מוסיף ורב שלום בניך א\"ת בניך אלא בוניך,"
        },
        {
          "s": 26,
          "text": "הבירור דעולם"
        },
        {
          "s": 27,
          "text": "(בוניך)"
        },
        {
          "s": 28,
          "text": "וריבוי השלום בעולם,"
        },
        {
          "s": 29,
          "text": "שנעשה ע\"י עסק התורה."
        },
        {
          "s": 30,
          "text": "ובסיום המאמר7,"
        },
        {
          "s": 31,
          "text": "דע\"י הענין דורב שלום בניך א\"ת בניך אלא בוניך,"
        },
        {
          "s": 32,
          "text": "בנאים העוסקים בבנינו של עולם,"
        },
        {
          "s": 33,
          "text": "עי\"ז יקויים גם בהם ורב שלום בניך,"
        },
        {
          "s": 34,
          "text": "כמ\"ש8"
        },
        {
          "s": 35,
          "text": "וראה בנים לבניך שלום על ישראל,"
        },
        {
          "s": 36,
          "text": "היינו,"
        },
        {
          "s": 37,
          "text": "דע\"י הבירור דעולם שנעשה ע\"י עסק התורה דהתלמידי חכמים,"
        },
        {
          "s": 38,
          "text": "נמשך ריבוי שלום גם להתלמידי חכמים עצמם"
        },
        {
          "s": 39,
          "text": "(כפירוש המצודות והתרגום בורב שלום בניך)."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויש לקשר זה עם מ\"ש בריש פרשתנו9"
        },
        {
          "s": 2,
          "text": "וישלח יעקב מלאכים לפניו אל עשו אחיו גו' כה תאמרון גו' עם לבן גרתי ואחר עד עתה,"
        },
        {
          "s": 3,
          "text": "דמשמעות הכתוב הוא שיעקב צריך לבוא תחלה אל עשו,"
        },
        {
          "s": 4,
          "text": "ולכן נתן טעם על זה שנתאחר לבוא אליו,"
        },
        {
          "s": 5,
          "text": "עם לבן גרתי"
        },
        {
          "s": 6,
          "text": "(ולכן10)"
        },
        {
          "s": 7,
          "text": "ואחר עד עתה."
        },
        {
          "s": 8,
          "text": "וצריך להבין11"
        },
        {
          "s": 9,
          "text": "למה צריך למהר לבוא אל עשו ועד שצריך לטעם על זה שנתאחר."
        },
        {
          "s": 10,
          "text": "וגם צריך להבין12"
        },
        {
          "s": 11,
          "text": "מה שפירש רש\"י גרתי בגימטריא תרי\"ג,"
        },
        {
          "s": 12,
          "text": "עם לבן גרתי ותרי\"ג מצוות שמרתי,"
        },
        {
          "s": 13,
          "text": "הרי יעקב ידע שעשו אינו מייקר ענין קיום המצוות,"
        },
        {
          "s": 14,
          "text": "ומה מודיע לו ששמר תרי\"ג מצוות."
        },
        {
          "s": 15,
          "text": "והנה ידוע הביאור בזה13,"
        },
        {
          "s": 16,
          "text": "דהברכות שברך יצחק את יעקב הן בכדי לברר את עשו,"
        },
        {
          "s": 17,
          "text": "אלא בכדי שיוכל לברר את עשו הי' צ\"ל תחלה עבודתו בבית לבן."
        },
        {
          "s": 18,
          "text": "וזהו מה שאמר יעקב עם לבן גרתי ואחר עד עתה,"
        },
        {
          "s": 19,
          "text": "דהטעם על שנתאחר ללכת לעשו לבררו עד עתה"
        },
        {
          "s": 20,
          "text": "(אף שלכאורה הוצרך לבררו תיכף לאחרי שקיבל הברכות)"
        },
        {
          "s": 21,
          "text": "הוא כי"
        },
        {
          "s": 22,
          "text": "(עד עכשיו)"
        },
        {
          "s": 23,
          "text": "עם לבן גרתי ותרי\"ג מצוות שמרתי,"
        },
        {
          "s": 24,
          "text": "ולאחרי שגמר עבודתו בבית לבן,"
        },
        {
          "s": 25,
          "text": "שלח מיד אל עשו לבררו."
        }
      ]
    }
  ]
}