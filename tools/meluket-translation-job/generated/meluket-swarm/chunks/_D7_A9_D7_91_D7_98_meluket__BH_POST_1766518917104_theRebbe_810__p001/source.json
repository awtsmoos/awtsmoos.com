{
  "globalIndex": 583,
  "owner": 33,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917104_theRebbe_810__p001",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917104_theRebbe_810__p001",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518917104_theRebbe_810",
  "title": "מאמר באתי לגני תשל\"ו",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ בא,"
        },
        {
          "s": 2,
          "text": "ח' שבט,"
        },
        {
          "s": 3,
          "text": "ה'תשל\"ו*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "(הנחה)"
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "באתי1 לגני אחותי כלה2"
        },
        {
          "s": 1,
          "text": "ומביא כ\"ק מו\"ח אדמו\"ר בעל ההילולא"
        },
        {
          "s": 2,
          "text": "[בהמאמר3"
        },
        {
          "s": 3,
          "text": "שניתן על ידו ליום הסתלקותו ש\"פ בא יו\"ד שבט,"
        },
        {
          "s": 4,
          "text": "תש\"י]"
        },
        {
          "s": 5,
          "text": "את מאמר המדרש4"
        },
        {
          "s": 6,
          "text": "לגני לגנוני למקום שהי' עיקרי בתחלה,"
        },
        {
          "s": 7,
          "text": "דעיקר שכינה בתחתונים היתה,"
        },
        {
          "s": 8,
          "text": "אלא שע\"י ענינים בלתי רצויים במשך ז' דורות סילקו את השכינה מלמטה למעלה עד רקיע הז',"
        },
        {
          "s": 9,
          "text": "ואח\"כ עמדו צדיקים והמשיכו את השכינה מלמעלה למטה,"
        },
        {
          "s": 10,
          "text": "והתחלת ההמשכה היתה מאברהם,"
        },
        {
          "s": 11,
          "text": "אחד הי' אברהם5,"
        },
        {
          "s": 12,
          "text": "שהורידה מרקיע הז' לו' וכו' ועד שבא משה שהוא השביעי וכל השביעין חביבין6"
        },
        {
          "s": 13,
          "text": "והורידה למטה בארץ."
        },
        {
          "s": 14,
          "text": "וזהו מה שעשיית המשכן היתה ע\"י משה"
        },
        {
          "s": 15,
          "text": "(דוקא),"
        },
        {
          "s": 16,
          "text": "כי ענין המשכן הוא כמ\"ש7"
        },
        {
          "s": 17,
          "text": "ועשו לי מקדש ושכנתי בתוכם,"
        },
        {
          "s": 18,
          "text": "שע\"י ועשו לי מקדש נעשה ושכנתי למטה בבני ישראל ובעולם,"
        },
        {
          "s": 19,
          "text": "כי מהשראת השכינה שהייתה בבית המקדש נמשך הגילוי ע\"י החלונות שקופים אטומים8"
        },
        {
          "s": 20,
          "text": "בכל העולם."
        },
        {
          "s": 21,
          "text": "וכל זה נעשה ע\"י עבודת ישראל וכמו שדייקו רז\"ל9"
        },
        {
          "s": 22,
          "text": "בתוכו לא נאמר אלא בתוכם בתוך כאו\"א מישראל,"
        },
        {
          "s": 23,
          "text": "שע\"י עבודת ישראל"
        },
        {
          "s": 24,
          "text": "(אשר ועמך כולם צדיקים10)"
        },
        {
          "s": 25,
          "text": "נעשה ושכנתי בהמשכן ועי\"ז בכל העולם."
        },
        {
          "s": 26,
          "text": "וזהו צדיקים יירשו ארץ וישכנו לעד עלי'11,"
        },
        {
          "s": 27,
          "text": "דצדיקים יירשו ארץ שהוא ארצות החיים"
        },
        {
          "s": 28,
          "text": "(ג\"ע)"
        },
        {
          "s": 29,
          "text": "לפי שהם משכינים וממשיכים12"
        },
        {
          "s": 30,
          "text": "בחינת שוכן13"
        },
        {
          "s": 31,
          "text": "עד14,"
        },
        {
          "s": 32,
          "text": "בחינת הסובב,"
        },
        {
          "s": 33,
          "text": "שיהי' בגילוי למטה ע\"י העבודה דתומ\"צ."
        },
        {
          "s": 34,
          "text": "וכמ\"ש15"
        },
        {
          "s": 35,
          "text": "אנכי עשיתי ארץ ואדם עלי' בראתי,"
        },
        {
          "s": 36,
          "text": "דזה16"
        },
        {
          "s": 37,
          "text": "מה שאנכי עשיתי ארץ הוא בשביל האדם ובריאת האדם היא בשביל בראת\"י בגימטריא תרי\"ג17,"
        },
        {
          "s": 38,
          "text": "והיינו שע\"י קיום התרי\"ג מצוות נשלמה כוונת הבריאה דנתאווה הקב\"ה להיות לו ית' דירה בתחתונים18."
        },
        {
          "s": 39,
          "text": "וזהו מה שאחת העבודות שהי' במקדש הו\"ע עבודת הקרבנותא,"
        },
        {
          "s": 40,
          "text": "דעבודת הקרבנות היא עבודה רוחנית שבנפש האדם,"
        },
        {
          "s": 41,
          "text": "וכמו שמדייק כ\"ק אדמו\"ר הזקן19"
        },
        {
          "s": 42,
          "text": "במ\"ש20"
        },
        {
          "s": 43,
          "text": "אדם כי יקריב מכם גו' שהקרבן צ\"ל מכם ממש,"
        },
        {
          "s": 44,
          "text": "מנפש הבהמית שבאדם,"
        },
        {
          "s": 45,
          "text": "ואומר על זה מן הבקר ומן הצאן,"
        },
        {
          "s": 46,
          "text": "הן הפרטי מדריגות שישנם בנה\"ב"
        },
        {
          "s": 47,
          "text": "(וכמבואר בכ\"מ21"
        },
        {
          "s": 48,
          "text": "בענין שור כשב ועז)."
        },
        {
          "s": 49,
          "text": "ועבודה זו הייתה במקדש,"
        },
        {
          "s": 50,
          "text": "כי כל העליות הן ע\"י המקדש."
        },
        {
          "s": 51,
          "text": "דכמו שכל ההמשכות הן ע\"י המקדש,"
        },
        {
          "s": 52,
          "text": "וכנ\"ל שהמשכת השכינה בעולם הייתה ע\"י החלונות שקופים אטומים דמקדש,"
        },
        {
          "s": 53,
          "text": "כן גם העליות מלמטה למעלה הן ע\"י המקדש,"
        },
        {
          "s": 54,
          "text": "שלכן כשמתפלל יכוון כנגד בית המקדש22."
        },
        {
          "s": 55,
          "text": "ועפ\"ז מבאר שם מה שהמשכן הי' מעצי שטים,"
        },
        {
          "s": 56,
          "text": "כי עיקר עבודת האדם הוא הענין דאתכפיא ואתהפכא חשוכא לנהורא,"
        },
        {
          "s": 57,
          "text": "ולכן הי' המשכן מעצי שטים,"
        },
        {
          "s": 58,
          "text": "לשון שטות,"
        },
        {
          "s": 59,
          "text": "הפיכת השטות דלעו\"ז שלמטה מטו\"ד,"
        },
        {
          "s": 60,
          "text": "שאין אדם עובר עבירה אא\"כ נכנס בו רוח שטות23,"
        },
        {
          "s": 61,
          "text": "לשטות דקדושה שלמעלה מטו\"ד."
        }
      ]
    }
  ]
}