{
  "globalIndex": 1012,
  "owner": 12,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919787_theRebbe_472__p001",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919787_theRebbe_472__p001",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919787_theRebbe_472",
  "title": "מאמר איכה ישבה בדד תשל\"א",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד,"
        },
        {
          "s": 1,
          "text": "ש\"פ דברים"
        },
        {
          "s": 2,
          "text": "(ת\"ב,"
        },
        {
          "s": 3,
          "text": "נדחה)"
        },
        {
          "s": 4,
          "text": "תשל\"א"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "איכה ישבה בדד העיר רבתי עם גו' ומבאר1"
        },
        {
          "s": 1,
          "text": "כ\"ק אדמו\"ר הצמח צדק"
        },
        {
          "s": 2,
          "text": "(צמח שמו2)"
        },
        {
          "s": 3,
          "text": "שישבה בדד הוא כמש\"נ3"
        },
        {
          "s": 4,
          "text": "הוי' בדד ינחנו,"
        },
        {
          "s": 5,
          "text": "בטח בדד עין יעקב."
        },
        {
          "s": 6,
          "text": "וזה נעשה ע\"י רבתי עם כו' כמשי\"ת לקמן."
        },
        {
          "s": 7,
          "text": "וצריך להבין והרי איכה הוא לשון תמי' ופליאה,"
        },
        {
          "s": 8,
          "text": "ולפי הפירוש שישבה בדד הוא שישראל יתעלו לבחינת הוי' בדד ינחנו,"
        },
        {
          "s": 9,
          "text": "בחינת בדד"
        },
        {
          "s": 10,
          "text": "(מחוץ למחנה – למעליותא)"
        },
        {
          "s": 11,
          "text": "למעלה מהשתלשלות,"
        },
        {
          "s": 12,
          "text": "מהי התמי' והפליאה בזה."
        },
        {
          "s": 13,
          "text": "גם צריך להבין קישור פירוש זה עם פירוש הפשוט,"
        },
        {
          "s": 14,
          "text": "דפירוש הפשוט באיכה ישבה בדד הוא גודל הירידה כו',"
        },
        {
          "s": 15,
          "text": "שלכן קוראין איכה בת\"ב שאז הי' החורבן,"
        },
        {
          "s": 16,
          "text": "ומהו הקישור של פירוש הפשוט עם פירוש הצ\"צ שישבה בדד הוא למעליותא."
        },
        {
          "s": 17,
          "text": "ויובן זה בהקדים תחלה גודל העילוי"
        },
        {
          "s": 18,
          "text": "(לפי פירוש הצ\"צ עה\"פ)"
        },
        {
          "s": 19,
          "text": "בישבה בדד,"
        },
        {
          "s": 20,
          "text": "שהו\"ע בטח בדד עין יעקב."
        },
        {
          "s": 21,
          "text": "שהדיוק בטח בדד עין יעקב"
        },
        {
          "s": 22,
          "text": "(יעקב דוקא)"
        },
        {
          "s": 23,
          "text": "הוא כמרז\"ל4"
        },
        {
          "s": 24,
          "text": "לא כאברהם שכתוב בו הר כו' ולא כיצחק שכתוב בו שדה כו' אלא כיעקב שקראו בית."
        },
        {
          "s": 25,
          "text": "והיינו שהעילוי דבטח בדד עין יעקב שיהי' לע\"ל,"
        },
        {
          "s": 26,
          "text": "ובפרט בביהמ\"ק השלישי,"
        },
        {
          "s": 27,
          "text": "הוא ענין כיעקב שקראו בית,"
        },
        {
          "s": 28,
          "text": "שנחלת יעקב היא נחלה בלי מצרים5,"
        },
        {
          "s": 29,
          "text": "בחי' רעוא דרעוין,"
        },
        {
          "s": 30,
          "text": "כמרז\"ל6"
        },
        {
          "s": 31,
          "text": "כל המענג את השבת נותנין לו נחלה בלי מצרים כו' נחלת יעקב כו'."
        },
        {
          "s": 32,
          "text": "ועילוי זה שיהי' לעתיד הוא ע\"י קדימת ישבה בדד דהגלות כו'."
        },
        {
          "s": 33,
          "text": "וזהו\"ע מה שדימו רז\"ל7"
        },
        {
          "s": 34,
          "text": "את ענין הגלות לזה שאדם הראשון נידון בגרושין"
        },
        {
          "s": 35,
          "text": "[דכמו שאדה\"ר הוא יציר כפיו של הקב\"ה,"
        },
        {
          "s": 36,
          "text": "כן גם ישראל"
        },
        {
          "s": 37,
          "text": "(שנידונו בגרושין)"
        },
        {
          "s": 38,
          "text": "הם נצר מטעיו מעשה ידיו של הקב\"ה8,"
        },
        {
          "s": 39,
          "text": "חלק אלקה ממעל ממש9],"
        },
        {
          "s": 40,
          "text": "וכמו זה שאדה\"ר נידון בגרושין הוא בשביל העילוי שיהי' אח\"כ,"
        },
        {
          "s": 41,
          "text": "עד העילוי דמתן תורה שזה נעלה עוד יותר מהעילוי דויניחהו בג\"ע לעבדה ולשמרה דאדה\"ר"
        },
        {
          "s": 42,
          "text": "(כמשי\"ת לקמן),"
        },
        {
          "s": 43,
          "text": "והיינו כמו שבמתן תורה היו ז' הדורות שסילקו השכינה ממטלמ\"ע ואח\"כ ז' הדורות שהמשיכו השכינה מלמעלמ\"ט עד שהי' מתן תורה10,"
        },
        {
          "s": 44,
          "text": "עד\"ז הוא גם לאחרי מתן תורה שהי' צריכים לבוא לארץ ישראל11"
        },
        {
          "s": 45,
          "text": "ולבנות הביהמ\"ק,"
        },
        {
          "s": 46,
          "text": "המקום אשר יבחר הוי'12,"
        },
        {
          "s": 47,
          "text": "שלמעלה גם מהמשכן דכתיב בי' ואתהלך באהל13,"
        },
        {
          "s": 48,
          "text": "היו אז כמה הרפתקאות וכו' עד שנבנה ביהמ\"ק,"
        },
        {
          "s": 49,
          "text": "ואח\"כ הי' החורבן דבית ראשון ובאו להעילוי דבית שני,"
        },
        {
          "s": 50,
          "text": "שלמעלה מבית ראשון וכמ\"ש14"
        },
        {
          "s": 51,
          "text": "גדול יהי' כבוד הבית הזה האחרון מן הראשון דקאי על בית שני שהי' גדול מבית ראשון בבנין ובשנים15,"
        },
        {
          "s": 52,
          "text": "ועד\"ז הוא גם בענין החורבן דבית שני,"
        },
        {
          "s": 53,
          "text": "שיגיעו לאח\"ז להעילוי דבית השלישי שיבנה בקרוב ממש ע\"י משיח צדקנו,"
        },
        {
          "s": 54,
          "text": "שהוא נעלה מבית ראשון וגם מבית שני,"
        },
        {
          "s": 55,
          "text": "וכמחז\"ל"
        },
        {
          "s": 56,
          "text": "(שהובא לעיל)"
        },
        {
          "s": 57,
          "text": "לא כאברהם שכתוב בו הר ולא כיצחק שכתוב בו שדה אלא כיעקב שקראו בית."
        },
        {
          "s": 58,
          "text": "וזהו ג\"כ ההמשך בכתוב היתה כאלמנה ולא אלמנה ח\"ו16,"
        },
        {
          "s": 59,
          "text": "כי מכיון שהכוונה בהירידה היא בשביל העלי' שתהי' לאח\"ז,"
        },
        {
          "s": 60,
          "text": "הרי אי\"ז ירידה אמיתית,"
        },
        {
          "s": 61,
          "text": "ולכן היתה כאלמנה בכ\"ף הדמיון."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והענין הוא,"
        },
        {
          "s": 2,
          "text": "כמו שמבאר כ\"ק אדמו\"ר"
        },
        {
          "s": 3,
          "text": "(מהורש\"ב)17"
        },
        {
          "s": 4,
          "text": "שתכלית כוונת הבריאה הוא שנתאוה הקב\"ה להיות לו ית' דירה בתחתונים,"
        },
        {
          "s": 5,
          "text": "שכוונה זו נשלמה ע\"י העבודה דנש\"י,"
        },
        {
          "s": 6,
          "text": "כמאמר במי נמלך"
        },
        {
          "s": 7,
          "text": "(על כל הבריאה כולה)"
        },
        {
          "s": 8,
          "text": "בנשמותיהם של צדיקים18."
        },
        {
          "s": 9,
          "text": "והנה בתחילת הבריאה עולם על מילואו נברא19,"
        },
        {
          "s": 10,
          "text": "עיקר שכינה בתחתונים היתה20,"
        },
        {
          "s": 11,
          "text": "שפירוש עיקר שכינה הוא בחי' אור הסובב."
        },
        {
          "s": 12,
          "text": "דשכינה הוא בחי' אור הממלא,"
        },
        {
          "s": 13,
          "text": "שכינה ע\"ש ששוכנת ומתלבשת21,"
        },
        {
          "s": 14,
          "text": "אבל עיקר שכינה הוא בחי' אור הסובב ועד לאור הסובב שלמעלה מעולמות,"
        },
        {
          "s": 15,
          "text": "וכמבואר בארוכה בהמשך מאמרי ההילולא22."
        },
        {
          "s": 16,
          "text": "והגם שהמשכת אור הסובב נעשה ע\"י עבודת אדה\"ר ונש\"י דוקא כנ\"ל,"
        },
        {
          "s": 17,
          "text": "מ\"מ הנה מיד בתחילת הבריאה עולם על מילואו נברא,"
        },
        {
          "s": 18,
          "text": "פירוש"
        },
        {
          "s": 19,
          "text": "(לא שהי' המשכת עיקר שכינה בפועל,"
        },
        {
          "s": 20,
          "text": "שהרי זה נעשה ע\"י עבודה דוקא23,"
        },
        {
          "s": 21,
          "text": "כ\"א)"
        },
        {
          "s": 22,
          "text": "שנברא באופן שיהי' מוכשר וראוי לגילוי אור דעיקר שכינה,"
        },
        {
          "s": 23,
          "text": "וההמשכה בפועל היא ע\"י העבודה דוקא."
        },
        {
          "s": 24,
          "text": "וזהו\"ע ויניחהו בג\"ע לעבדה ולשמרה,"
        },
        {
          "s": 25,
          "text": "שע\"י עבודת אדה\"ר נעשה תוספות אור בהג\"ע."
        },
        {
          "s": 26,
          "text": "דג\"ע מצד עצמו הוא בחי' אור הממלא"
        },
        {
          "s": 27,
          "text": "(ומה שעולם על מילואו נברא הוא רק שהי' מקום מוכשר לגילוי אור הסובב,"
        },
        {
          "s": 28,
          "text": "כנ\"ל),"
        },
        {
          "s": 29,
          "text": "אלא שבבחי' אור הממלא גופא יש מעלה בג\"ע על כללות העולם בב' דברים,"
        },
        {
          "s": 30,
          "text": "הא' שהאור המתלבש בעולמות הוא מבחי' ז\"ת ובג\"ע מאיר ג\"ר והב' דבעולמות רק ידיעת המציאות ובג\"ע גילוי המהות,"
        },
        {
          "s": 31,
          "text": "אבל כ\"ז הוא רק בחי' ממכ\"ע."
        },
        {
          "s": 32,
          "text": "ויניחהו בג\"ע לעבדה ולשמרה,"
        },
        {
          "s": 33,
          "text": "שעי\"ז ימשיך בחי' אור הסובב,"
        },
        {
          "s": 34,
          "text": "בחי' עיקר שכינה."
        },
        {
          "s": 35,
          "text": "אמנם,"
        },
        {
          "s": 36,
          "text": "גם בחי' לעבדה שהי' בג\"ע אינו בערך להעבודה דלאחרי מתן תורה,"
        },
        {
          "s": 37,
          "text": "וכמרז\"ל24"
        },
        {
          "s": 38,
          "text": "בענין מצות האבות,"
        },
        {
          "s": 39,
          "text": "שריחות היו."
        },
        {
          "s": 40,
          "text": "ואף שאמרו זה בנוגע להאבות,"
        },
        {
          "s": 41,
          "text": "הרי כיון דעד מתן תורה הייתה הגזירה דעליונים לא ירדו למטה ותחתונים לא יעלו למעלה כו'25"
        },
        {
          "s": 42,
          "text": "– הרי גם בנוגע לאדה\"ר הי' כן."
        },
        {
          "s": 43,
          "text": "ואף שנצטווה"
        },
        {
          "s": 44,
          "text": "(ולכן הי' בו המעלה דמצווה ועושה)"
        },
        {
          "s": 45,
          "text": "– עכ\"פ בשש מצות – הציווי כמו שהוא למטה קודם מתן תורה אינו כמו הציווי לאחר מתן תורה כיון שהעליונים לא ירדו עדיין למטה."
        },
        {
          "s": 46,
          "text": "וגם לפי המבואר בהמאמר שם שעבודת אדה\"ר היתה נעלית יותר מעבודת האבות,"
        },
        {
          "s": 47,
          "text": "כי אדה\"ר הי' יציר כפיו ובג\"ע26"
        },
        {
          "s": 48,
          "text": "כו' מ\"מ הרי"
        },
        {
          "s": 49,
          "text": "(כמבואר בהמאמר שם)"
        },
        {
          "s": 50,
          "text": "אי\"ז בערך לבחי' שמן תורק שמך,"
        },
        {
          "s": 51,
          "text": "המשכה עצמית דמתן תורה."
        },
        {
          "s": 52,
          "text": "אמנם,"
        },
        {
          "s": 53,
          "text": "גם העבודה שלאחרי מתן תורה אינה בערך להגילוי שהי' בביהמ\"ק"
        },
        {
          "s": 54,
          "text": "(ובפרט ע\"י לעבדה ולשמרה שבביהמ\"ק),"
        },
        {
          "s": 55,
          "text": "המקום אשר יבחר הוי',"
        },
        {
          "s": 56,
          "text": "שאז דוקא נעשה דירה לו ית',"
        },
        {
          "s": 57,
          "text": "דירת קבע."
        },
        {
          "s": 58,
          "text": "ובביהמ\"ק גופא גדול הענין דדירה לו ית' בבית שני,"
        },
        {
          "s": 59,
          "text": "כי אף שבבית שני חסרו ה' דברים27"
        },
        {
          "s": 60,
          "text": "מ\"מ גדול כו' מבית הראשון בבנין"
        },
        {
          "s": 61,
          "text": "(מקום)"
        },
        {
          "s": 62,
          "text": "ובשנים"
        },
        {
          "s": 63,
          "text": "(זמן)"
        },
        {
          "s": 64,
          "text": "– הגדרת התחתונים – מצד העולם גופא."
        },
        {
          "s": 65,
          "text": "אמנם עיקר הדירה יהי' לע\"ל דוקא,"
        },
        {
          "s": 66,
          "text": "ע\"י התומ\"צ שיקיימו אז,"
        },
        {
          "s": 67,
          "text": "שאז יהי' קיום המצות בתכלית השלימות,"
        },
        {
          "s": 68,
          "text": "כמאמר28"
        },
        {
          "s": 69,
          "text": "ושם נעשה לפניך כמצות רצונך,"
        },
        {
          "s": 70,
          "text": "שם דוקא,"
        },
        {
          "s": 71,
          "text": "וכמו שמבאר בארוכה כ\"ק אדמו\"ר מהר\"ש29."
        }
      ]
    }
  ]
}