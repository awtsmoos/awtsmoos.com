{
  "globalIndex": 959,
  "owner": 9,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919434_theRebbe_712__p001",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919434_theRebbe_712__p001",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919434_theRebbe_712",
  "title": "מאמר וחזקת והיית לאיש תשכ\"ח",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "יום ב' פ' פינחס,"
        },
        {
          "s": 2,
          "text": "י\"ט תמוז ה'תשכ\"ח"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "וחזקת והיית לאיש1,"
        },
        {
          "s": 1,
          "text": "הנה ידוע2"
        },
        {
          "s": 2,
          "text": "שהמאמר שאמר אדמו\"ר"
        },
        {
          "s": 3,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 4,
          "text": "נ\"ע ביום השביעי3"
        },
        {
          "s": 5,
          "text": "דחגיגת הבר מצוה של בנו יחידו כ\"ק מו\"ח אדמו\"ר,"
        },
        {
          "s": 6,
          "text": "י\"ט תמוז4"
        },
        {
          "s": 7,
          "text": "תרנ\"ג"
        },
        {
          "s": 8,
          "text": "[שמאמר זה הוא סיום וחותם ההמשך תפילין דמארי עלמא5"
        },
        {
          "s": 9,
          "text": "שהתחיל לומר בי\"ב תמוז,"
        },
        {
          "s": 10,
          "text": "יום הבר מצוה]"
        },
        {
          "s": 11,
          "text": "היתה התחלתו בפסוק זה."
        },
        {
          "s": 12,
          "text": "– השייכות דפסוק זה"
        },
        {
          "s": 13,
          "text": "(וחזקת והיית לאיש)"
        },
        {
          "s": 14,
          "text": "לבר מצוה בפשטות היא,"
        },
        {
          "s": 15,
          "text": "ע\"פ הידוע6"
        },
        {
          "s": 16,
          "text": "דזה שבן שלש עשרה"
        },
        {
          "s": 17,
          "text": "(דוקא)"
        },
        {
          "s": 18,
          "text": "מחוייב במצוות הוא כי אז דוקא נק' בשם איש."
        },
        {
          "s": 19,
          "text": "וצריך להבין,"
        },
        {
          "s": 20,
          "text": "דמכיון שבן י\"ג שנה נעשה איש"
        },
        {
          "s": 21,
          "text": "(ע\"פ טבע),"
        },
        {
          "s": 22,
          "text": "מהי ההדגשה לומר"
        },
        {
          "s": 23,
          "text": "(בחגיגת בר מצוה)"
        },
        {
          "s": 24,
          "text": "וחזקת והיית לאיש."
        },
        {
          "s": 25,
          "text": "וגם צריך להבין,"
        },
        {
          "s": 26,
          "text": "הרי המעלה דבן י\"ג שנה היא שאז נעשה בר דעת7,"
        },
        {
          "s": 27,
          "text": "דדעת הוא במוחין,"
        },
        {
          "s": 28,
          "text": "ובפרט לפי המבואר בהמאמר ד\"ה איתא במדרש תילים תרנ\"ג"
        },
        {
          "s": 29,
          "text": "[שהוא אחד המאמרים שחזר אותם כ\"ק מו\"ח אדמו\"ר בחגיגת הבר מצוה שלו]8"
        },
        {
          "s": 30,
          "text": "שהמעלה דבן י\"ג שנה היא שאז יש לו עצם המוחין9,"
        },
        {
          "s": 31,
          "text": "ומהו הדיוק בבן י\"ג שנה בהתואר איש שמורה10"
        },
        {
          "s": 32,
          "text": "על המדות."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה בחלק ההמשך שנאמר אז11"
        },
        {
          "s": 2,
          "text": "מבואר מעלת יוסף על יעקב,"
        },
        {
          "s": 3,
          "text": "דההמשכה שע\"י יעקב היא באצילות וע\"י יוסף נמשך הגילוי"
        },
        {
          "s": 4,
          "text": "(גם)"
        },
        {
          "s": 5,
          "text": "בבי\"ע."
        },
        {
          "s": 6,
          "text": "[ויש לומר,"
        },
        {
          "s": 7,
          "text": "דזה שבהמאמר ד\"ה וחזקת והיית לאיש מדבר בשבחו של יוסף,"
        },
        {
          "s": 8,
          "text": "שמו הראשון של הבר מצוה,"
        },
        {
          "s": 9,
          "text": "הוא גם בכדי לעורר אותו על העבודה המיוחדת דיוסף להמשיך הגילוי עד למטה מטה]."
        },
        {
          "s": 10,
          "text": "ובכדי לבאר גודל העילוי של יוסף,"
        },
        {
          "s": 11,
          "text": "מבאר תחלה מעלתו של יעקב,"
        },
        {
          "s": 12,
          "text": "שעי\"ז יובן גודל העילוי דיוסף שהוא נעלה עוד יותר."
        },
        {
          "s": 13,
          "text": "ומבאר זה בהקדים מ\"ש12"
        },
        {
          "s": 14,
          "text": "אתה הוא הוי' לבדך את עשית את השמים גו' ואתה מחי' את כולם,"
        },
        {
          "s": 15,
          "text": "שהם ג' מדריגות13."
        },
        {
          "s": 16,
          "text": "אתה הוא הוי' לבדך קאי על אוא\"ס שלפני הצמצום"
        },
        {
          "s": 17,
          "text": "[ומפרט בזה ג' ענינים,"
        },
        {
          "s": 18,
          "text": "אתה הוא והוי'."
        },
        {
          "s": 19,
          "text": "אתה הוא עצמות המאור,"
        },
        {
          "s": 20,
          "text": "ואומר על זה אתה לשון נוכח,"
        },
        {
          "s": 21,
          "text": "כי העצמות הוא בכל מקום בהתגלות14,"
        },
        {
          "s": 22,
          "text": "דשם שמים שגור בפי כל."
        },
        {
          "s": 23,
          "text": "הוא והוי' הם ב' מדריגות בהאור,"
        },
        {
          "s": 24,
          "text": "עצם האור"
        },
        {
          "s": 25,
          "text": "(הוא),"
        },
        {
          "s": 26,
          "text": "והתפשטות האור"
        },
        {
          "s": 27,
          "text": "(הוי'),"
        },
        {
          "s": 28,
          "text": "כמבואר בהמאמר."
        },
        {
          "s": 29,
          "text": "ואומר על זה לבדך,"
        },
        {
          "s": 30,
          "text": "שאין כאן דבר זולת העצמות,"
        },
        {
          "s": 31,
          "text": "כי כללות האור שלפני הצמצום,"
        },
        {
          "s": 32,
          "text": "גם האור השייך לעולמות"
        },
        {
          "s": 33,
          "text": "(הוי'),"
        },
        {
          "s": 34,
          "text": "הוא כלול בעצמותו ואינו בבחי' מציאות15]."
        },
        {
          "s": 35,
          "text": "את עשית את השמים גו' הוא האור כמו שנעשה מקור להתהוות העולמות."
        },
        {
          "s": 36,
          "text": "ולכן כתיב את עשית,"
        },
        {
          "s": 37,
          "text": "את חסר ה',"
        },
        {
          "s": 38,
          "text": "כי האור,"
        },
        {
          "s": 39,
          "text": "גם האור השייך לעולמות"
        },
        {
          "s": 40,
          "text": "(הוי'),"
        },
        {
          "s": 41,
          "text": "כמו שהוא לפני הצמצום,"
        },
        {
          "s": 42,
          "text": "אינו בערך להיות מקור לעולמות,"
        },
        {
          "s": 43,
          "text": "ובכדי שיהי' מקור לעולמות הוא ע\"י הצמצום,"
        },
        {
          "s": 44,
          "text": "שנתעלם כל האור ונמשך רק קו קצר ומצומצם."
        },
        {
          "s": 45,
          "text": "וזהו את עשית את השמים גו' את חסר ה',"
        },
        {
          "s": 46,
          "text": "דזה שהאור נעשה מקור לעולמות"
        },
        {
          "s": 47,
          "text": "(עשית את השמים גו')"
        },
        {
          "s": 48,
          "text": "הוא ע\"י שנחסר ונתמעט"
        },
        {
          "s": 49,
          "text": "(את חסר ה')."
        },
        {
          "s": 50,
          "text": "ואתה מחי' את כולם הוא הקו שעל ידו נמשך חיות לעולמות,"
        },
        {
          "s": 51,
          "text": "לאחרי שנתהוו."
        },
        {
          "s": 52,
          "text": "והיינו,"
        },
        {
          "s": 53,
          "text": "שבהקו שני ענינים,"
        },
        {
          "s": 54,
          "text": "שהוא קו קצר ומצומצם,"
        },
        {
          "s": 55,
          "text": "ומצד זה הוא מהוה את העולמות"
        },
        {
          "s": 56,
          "text": "(מציאות העולמות),"
        },
        {
          "s": 57,
          "text": "ושהמשכתו היא מהאור שלפני הצמצום,"
        },
        {
          "s": 58,
          "text": "ומצד זה הוא ממשיך חיות בעולמות"
        },
        {
          "s": 59,
          "text": "(גילוי אלקות)16."
        },
        {
          "s": 60,
          "text": "וזהו שאתה זה"
        },
        {
          "s": 61,
          "text": "(ואתה מחי' את כולם)"
        },
        {
          "s": 62,
          "text": "הוא מלא ה' כמו אתה הראשון"
        },
        {
          "s": 63,
          "text": "(אתה הוא הוי' לבדך),"
        },
        {
          "s": 64,
          "text": "כי ענין זה שבהקו שהוא מחי' את כולם,"
        },
        {
          "s": 65,
          "text": "הוא מצד זה שנמשך בו גילוי האור שלפני הצמצום."
        }
      ]
    }
  ]
}