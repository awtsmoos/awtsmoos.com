{
  "globalIndex": 546,
  "owner": 46,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916877_theRebbe_274__p005",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916877_theRebbe_274__p005",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916877_theRebbe_274",
  "title": "מאמר באתי לגני תשל\"ב",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ולהוסיף,"
        },
        {
          "s": 2,
          "text": "דזה שקרבנות הו\"ע ההעלאה,"
        },
        {
          "s": 3,
          "text": "מובן גם מזה שנקראים בשם קרבן."
        },
        {
          "s": 4,
          "text": "[ובפרט ע\"פ תורת הבעש\"ט48"
        },
        {
          "s": 5,
          "text": "(עה\"פ49"
        },
        {
          "s": 6,
          "text": "לעולם ה' דברך נצב בשמים)"
        },
        {
          "s": 7,
          "text": "דשמו של כל דבר אשר יקראו לו בלה\"ק מורה"
        },
        {
          "s": 8,
          "text": "(לא רק על ענינו אלא גם)"
        },
        {
          "s": 9,
          "text": "על החיות אלקי שבו]."
        },
        {
          "s": 10,
          "text": "דקרבן הוא מלשון קירוב50,"
        },
        {
          "s": 11,
          "text": "שמתקרב לאלקות."
        },
        {
          "s": 12,
          "text": "וזה מורה על ענין ההעלאה."
        },
        {
          "s": 13,
          "text": "דבהמשכה מלמעלה למטה,"
        },
        {
          "s": 14,
          "text": "החיבור שלו עם אלקות הוא ע\"י שאלקות נמשך"
        },
        {
          "s": 15,
          "text": "(מתקרב)"
        },
        {
          "s": 16,
          "text": "אליו,"
        },
        {
          "s": 17,
          "text": "וקרבן מלשון קירוב"
        },
        {
          "s": 18,
          "text": "(שהוא מתקרב לאלקות)"
        },
        {
          "s": 19,
          "text": "הוא,"
        },
        {
          "s": 20,
          "text": "שהוא יוצא ממקומו"
        },
        {
          "s": 21,
          "text": "(מציאותו)"
        },
        {
          "s": 22,
          "text": "ונכלל באלקות."
        },
        {
          "s": 23,
          "text": "ויש לקשר זה עם מ\"ש בלקו\"ת51"
        },
        {
          "s": 24,
          "text": "דלהקריב הוא אותיות להרקיב,"
        },
        {
          "s": 25,
          "text": "דרקבון הוא ביטול בתכלית."
        },
        {
          "s": 26,
          "text": "וי\"ל הביאור בזה,"
        },
        {
          "s": 27,
          "text": "שההעלאה דקרבנות היא לאוא\"ס שלמעלה משייכות לעולמות52"
        },
        {
          "s": 28,
          "text": "[ויתירה מזה,"
        },
        {
          "s": 29,
          "text": "שההעלאה דקרבנות היא למעלה עד אין קץ,"
        },
        {
          "s": 30,
          "text": "כמ\"ש בפע\"ח53,"
        },
        {
          "s": 31,
          "text": "דאיתא בזהר54"
        },
        {
          "s": 32,
          "text": "עד היכן סליק רעותא דקורבנין כו' לעילא לעילא עד א\"ס],"
        },
        {
          "s": 33,
          "text": "ולכן הביטול דקרבנות הוא ביטול דרקבון,"
        },
        {
          "s": 34,
          "text": "ביטול בתכלית."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ועד\"ז הוא בעבודת הקרבנות שבנפש האדם55,"
        },
        {
          "s": 1,
          "text": "אדם כי יקריב מכם,"
        },
        {
          "s": 2,
          "text": "דירידת הנשמה למטה היא לצורך עלי',"
        },
        {
          "s": 3,
          "text": "שיהי' ענין ההעלאה מלמטה למעלה,"
        },
        {
          "s": 4,
          "text": "לצאת ממציאותה ולהכלל באוא\"ס."
        },
        {
          "s": 5,
          "text": "והעלי' שלה היא בתפלה,"
        },
        {
          "s": 6,
          "text": "דתפלות כנגד קרבנות תקנום56."
        },
        {
          "s": 7,
          "text": "וכתורת הבעש\"ט57,"
        },
        {
          "s": 8,
          "text": "דזה שאדם חי אחר התפלה אין זה ע\"פ טבע."
        },
        {
          "s": 9,
          "text": "כי מצד הכוונות הגדולות58"
        },
        {
          "s": 10,
          "text": "שבתפלה הי' צריך להיות אצלו כלות הנפש,"
        },
        {
          "s": 11,
          "text": "וזה שנשאר חי אחר התפלה אין זה ע\"פ טבע אלא חסד גדול מהשי\"ת."
        },
        {
          "s": 12,
          "text": "ויש לומר,"
        },
        {
          "s": 13,
          "text": "דזה שמצד הכוונות הגדולות שבתפלה מגיעים"
        },
        {
          "s": 14,
          "text": "(ע\"פ טבע)"
        },
        {
          "s": 15,
          "text": "לכלות הנפש,"
        },
        {
          "s": 16,
          "text": "הוא,"
        },
        {
          "s": 17,
          "text": "כי תפלה הוא ענין ההעלאה לצאת ממציאותו וליכלל באוא\"ס,"
        },
        {
          "s": 18,
          "text": "בדוגמת הקרבן שהי' נשרף ונכלל באש של מעלה."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "וזהו שאמרו רז\"ל59"
        },
        {
          "s": 1,
          "text": "אין עומדין להתפלל אלא מתוך כובד ראש ופירש רש\"י60"
        },
        {
          "s": 2,
          "text": "הכנעה ושפלות,"
        },
        {
          "s": 3,
          "text": "דכיון שענין התפלה הוא שיוצא ממציאותו ונכלל באוא\"ס,"
        },
        {
          "s": 4,
          "text": "ביטול,"
        },
        {
          "s": 5,
          "text": "לכן גם ההכנה לתפלה היא הכנעה ושפלות,"
        },
        {
          "s": 6,
          "text": "ביטול."
        },
        {
          "s": 7,
          "text": "אלא שהביטול דתפלה הוא מצד הקירוב לאלקות,"
        },
        {
          "s": 8,
          "text": "שנרגש בו העילוי וההפלאה דאוא\"ס שלכן רוצה להכלל בו,"
        },
        {
          "s": 9,
          "text": "והביטול שלפני התפלה הוא שמתמרמר על ריחוקו מאלקות."
        },
        {
          "s": 10,
          "text": "ולכן,"
        },
        {
          "s": 11,
          "text": "הביטול דתפלה הוא ביטול דכלות הנפש שהוא נכלל באלקות,"
        },
        {
          "s": 12,
          "text": "והביטול שקודם התפלה הוא הכנעה ושפלות."
        },
        {
          "s": 13,
          "text": "ומבאר אדמו\"ר האמצעי בהמאמר ד\"ה אחרי ה' אלקיכם תלכו61"
        },
        {
          "s": 14,
          "text": "וכן מבאר הצ\"צ במאמרו ד\"ה זה62,"
        },
        {
          "s": 15,
          "text": "דזה שהביטול דהכנעה ושפלות הוא הקדמה לתפלה,"
        },
        {
          "s": 16,
          "text": "הוא כמארז\"ל63"
        },
        {
          "s": 17,
          "text": "כל המשפיל עצמו הקב\"ה מגביהו."
        },
        {
          "s": 18,
          "text": "ויש לומר דמ\"ש בלקו\"ת שלהקריב הוא אותיות להרקיב הוא ע\"ד הביטול שקודם התפלה64,"
        },
        {
          "s": 19,
          "text": "כי הביטול דרקבון הוא שנפסד מציאותו."
        },
        {
          "s": 20,
          "text": "אלא שע\"י הרקבון נעשית אח\"כ הצמיחה – בדוגמת השפלות שקודם התפלה"
        },
        {
          "s": 21,
          "text": "(שעי\"ז הקב\"ה מגביהו בתפלה)."
        }
      ]
    }
  ]
}