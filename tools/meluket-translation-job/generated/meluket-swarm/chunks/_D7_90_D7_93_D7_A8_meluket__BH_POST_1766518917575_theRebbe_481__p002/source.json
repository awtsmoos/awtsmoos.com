{
  "globalIndex": 649,
  "owner": 49,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917575_theRebbe_481__p002",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917575_theRebbe_481__p002",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917575_theRebbe_481",
  "title": "מאמר אלה פקודי תש\"ל",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים המבואר בלקו\"ת19"
        },
        {
          "s": 2,
          "text": "שי\"ה הם נסתרות וו\"ה הם נגלות20."
        },
        {
          "s": 3,
          "text": "והענין הוא21,"
        },
        {
          "s": 4,
          "text": "די\"ה הם מוחין וו\"ה הם מדות"
        },
        {
          "s": 5,
          "text": "(כנ\"ל),"
        },
        {
          "s": 6,
          "text": "ומהחילוקים בין מוחין למדות הוא,"
        },
        {
          "s": 7,
          "text": "דמוחין הם לעצמו ומדות הן לזולתו"
        },
        {
          "s": 8,
          "text": "(כדלקמן בארוכה),"
        },
        {
          "s": 9,
          "text": "ועד\"ז הוא למעלה,"
        },
        {
          "s": 10,
          "text": "שהמדות הן לצורך העולמות והמוחין הם למעלה מעולמות,"
        },
        {
          "s": 11,
          "text": "ולכן22,"
        },
        {
          "s": 12,
          "text": "המדות הם בבחינת גילוי להזולת,"
        },
        {
          "s": 13,
          "text": "נגלות,"
        },
        {
          "s": 14,
          "text": "והמוחין הם בהעלם מהזולת,"
        },
        {
          "s": 15,
          "text": "נסתרות."
        },
        {
          "s": 16,
          "text": "והנה זה שמוחין הם נסתרות ומדות הן נגלות,"
        },
        {
          "s": 17,
          "text": "הכוונה בזה היא,"
        },
        {
          "s": 18,
          "text": "שכללות ענין המדות,"
        },
        {
          "s": 19,
          "text": "גם המדות שבלב"
        },
        {
          "s": 20,
          "text": "(לפני שמגלה אותם לזולתו),"
        },
        {
          "s": 21,
          "text": "הן בחינת נגלות,"
        },
        {
          "s": 22,
          "text": "ועד\"ז לאידך,"
        },
        {
          "s": 23,
          "text": "שכללות ענין המוחין"
        },
        {
          "s": 24,
          "text": "(גם לאחרי שמגלה ההשכלה שלו לזולתו)"
        },
        {
          "s": 25,
          "text": "הם בחינת נסתרות."
        },
        {
          "s": 26,
          "text": "והענין הוא,"
        },
        {
          "s": 27,
          "text": "דזה שמדות שייכים לזולת,"
        },
        {
          "s": 28,
          "text": "הוא לא רק בנוגע לפעולת המדות אלא גם בנוגע להמדות עצמם."
        },
        {
          "s": 29,
          "text": "וכמו מדת החסד שענינה הוא להטיב לזולתו,"
        },
        {
          "s": 30,
          "text": "ובלי זולת,"
        },
        {
          "s": 31,
          "text": "לא שייך ענין החסד."
        },
        {
          "s": 32,
          "text": "והגם שמבואר בכ\"מ23"
        },
        {
          "s": 33,
          "text": "דזה שא\"א למדות בלי זולת הוא דוקא בנוגע לפעולת המדות,"
        },
        {
          "s": 34,
          "text": "משא\"כ התעוררות המדות"
        },
        {
          "s": 35,
          "text": "(ומכש\"כ עצם המדות)"
        },
        {
          "s": 36,
          "text": "אפשר להיות גם בלי זולת,"
        },
        {
          "s": 37,
          "text": "וכמו אברהם אבינו שנצטער על שלא היו אורחים24,"
        },
        {
          "s": 38,
          "text": "דזה שנצטער על זה שאין ביכלתו להשפיע הוא לפי שמדת החסד היתה אצלו בהתעוררות"
        },
        {
          "s": 39,
          "text": "(גם כשלא הי' זולת),"
        },
        {
          "s": 40,
          "text": "הרי זהו דוקא כשיש מציאות בעולם"
        },
        {
          "s": 41,
          "text": "(זולת)"
        },
        {
          "s": 42,
          "text": "על מי להתחסד,"
        },
        {
          "s": 43,
          "text": "אבל באם לא הי' נמצא בעולם זולת למי להשפיע,"
        },
        {
          "s": 44,
          "text": "לא הי' אפשר להיות ההתעוררות דמדת החסד25,"
        },
        {
          "s": 45,
          "text": "ויתירה מזה,"
        },
        {
          "s": 46,
          "text": "שאז לא הי' שייך גם ענין החסד"
        },
        {
          "s": 47,
          "text": "(עצם המדה),"
        },
        {
          "s": 48,
          "text": "כי ענין החסד הוא להיטיב לזולתו."
        },
        {
          "s": 49,
          "text": "ולהוסיף,"
        },
        {
          "s": 50,
          "text": "דמזה גופא שאברהם אבינו הצטער על זה שלא הי' לו למי להשפיע,"
        },
        {
          "s": 51,
          "text": "מוכח,"
        },
        {
          "s": 52,
          "text": "שההשפעה"
        },
        {
          "s": 53,
          "text": "(בפועל)"
        },
        {
          "s": 54,
          "text": "להזולת נוגע גם למדת החסד עצמה."
        },
        {
          "s": 55,
          "text": "דצער הוא כשיש איזה חסרון,"
        },
        {
          "s": 56,
          "text": "וזה שאברהם נצטער על זה שאין ביכלתו להשפיע הוא כי ענין החסד הוא להשפיע,"
        },
        {
          "s": 57,
          "text": "וכשלא ישנה ההשפעה בפועל,"
        },
        {
          "s": 58,
          "text": "חסר בהשלימות דמדת החסד."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה כמו שבמדות,"
        },
        {
          "s": 2,
          "text": "גם המדות עצמם שייכים לזולת,"
        },
        {
          "s": 3,
          "text": "עד\"ז הוא לאידך במוחין,"
        },
        {
          "s": 4,
          "text": "דזה שהמוחין הם לעצמו למעלה משייכות לזולת הוא לא רק בנוגע להמוחין עצמם,"
        },
        {
          "s": 5,
          "text": "דענין השכל הוא לעצמו"
        },
        {
          "s": 6,
          "text": "[ודלא כהמדות,"
        },
        {
          "s": 7,
          "text": "שענינם"
        },
        {
          "s": 8,
          "text": "(גם ענינם דהמדות עצמם)"
        },
        {
          "s": 9,
          "text": "הוא להשפיע לזולתו],"
        },
        {
          "s": 10,
          "text": "אלא שגם בשביל פעולת המוחין אין צריך לזולת,"
        },
        {
          "s": 11,
          "text": "דגם כשהאדם הוא לעצמו"
        },
        {
          "s": 12,
          "text": "(בלי זולת)"
        },
        {
          "s": 13,
          "text": "יכול להשכיל השכלות."
        },
        {
          "s": 14,
          "text": "והגם שע\"י השפעה אל הזולת נעשה הוספה בהשכל,"
        },
        {
          "s": 15,
          "text": "ומתלמידי יותר מכולן26,"
        },
        {
          "s": 16,
          "text": "הרי זהו דוקא בנוגע להוספה בשכל27,"
        },
        {
          "s": 17,
          "text": "אבל עצם ההשכלה"
        },
        {
          "s": 18,
          "text": "(גם השכלה בפועל)"
        },
        {
          "s": 19,
          "text": "אפשר להיות גם בלי זולת."
        },
        {
          "s": 20,
          "text": "דגם כשלא יש למי להשפיע יכול להשכיל השכלות גדולות ועמוקות."
        },
        {
          "s": 21,
          "text": "ואדרבה,"
        },
        {
          "s": 22,
          "text": "בכדי לבוא על דבר שכל ולעמוד על בוריו,"
        },
        {
          "s": 23,
          "text": "לפעמים הזולת מבלבל."
        },
        {
          "s": 24,
          "text": "ולכן רוב החכמים היו מתבודדים."
        },
        {
          "s": 25,
          "text": "וזהו שארז\"ל28"
        },
        {
          "s": 26,
          "text": "שהסנהדרין היו נושאין ונותנין כל הלילה,"
        },
        {
          "s": 27,
          "text": "ופירש רש\"י איש איש לעצמו,"
        },
        {
          "s": 28,
          "text": "כי בכדי לעמוד על אמיתית הסברא הוא כשמעיין לעצמו דוקא29."
        },
        {
          "s": 29,
          "text": "וגם לפירוש הרמב\"ם30"
        },
        {
          "s": 30,
          "text": "שכל אחד הי' נושא ונותן עם בן זוגו31"
        },
        {
          "s": 31,
          "text": "– הרי זה עם בן זוגו דוקא,"
        },
        {
          "s": 32,
          "text": "ולא כולם יחד32."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "וזהו שמוחין הן נסתרות ומדות הן נגלות,"
        },
        {
          "s": 2,
          "text": "דמדות,"
        },
        {
          "s": 3,
          "text": "כיון שענינם הוא להשפיע לזולתו,"
        },
        {
          "s": 4,
          "text": "הם בחינת גילוי,"
        },
        {
          "s": 5,
          "text": "אלא שבהיותם בלב לא בא עדיין הגילוי בפועל."
        },
        {
          "s": 6,
          "text": "ומוחין,"
        },
        {
          "s": 7,
          "text": "כיון שענינם הוא שהם לעצמו למעלה משייכות לזולת,"
        },
        {
          "s": 8,
          "text": "לכן,"
        },
        {
          "s": 9,
          "text": "גם כשמגלה את השכל שלו לזולתו,"
        },
        {
          "s": 10,
          "text": "הוא בחינת העלם."
        },
        {
          "s": 11,
          "text": "ושני ענינים בזה."
        },
        {
          "s": 12,
          "text": "דהשכל שמתגלה להזולת אינו כהשכל שהשכיל בעצמו"
        },
        {
          "s": 13,
          "text": "[וכמבואר בכ\"מ33"
        },
        {
          "s": 14,
          "text": "דהשפעת השכל לזולתו היא ע\"י אמצעות המדות],"
        },
        {
          "s": 15,
          "text": "ונמצא,"
        },
        {
          "s": 16,
          "text": "שעצם השכל"
        },
        {
          "s": 17,
          "text": "(כמו שהוא בעצמו)"
        },
        {
          "s": 18,
          "text": "נשאר בהעלם."
        },
        {
          "s": 19,
          "text": "ועוד ענין בזה,"
        },
        {
          "s": 20,
          "text": "שגם דרגת השכל שמתגלה להזולת,"
        },
        {
          "s": 21,
          "text": "הגילוי שלו להזולת הוא לא לפי שענינו הוא גילוי לזולתו,"
        },
        {
          "s": 22,
          "text": "כי כללות השכל"
        },
        {
          "s": 23,
          "text": "(גם דרגת השכל שמתגלה להזולת)"
        },
        {
          "s": 24,
          "text": "הוא ענין שלעצמו,"
        },
        {
          "s": 25,
          "text": "אלא שהוא מגלה לזולתו הענינים שבעצמו"
        },
        {
          "s": 26,
          "text": "(שלמעלה מגילוי להזולת)."
        }
      ]
    }
  ]
}