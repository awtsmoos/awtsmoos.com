{
  "globalIndex": 408,
  "owner": 8,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518916086_theRebbe_759__p001",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518916086_theRebbe_759__p001",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518916086_theRebbe_759",
  "title": "מאמר אמר ר' אלכסנדרי תשל\"א",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ וישב,"
        },
        {
          "s": 2,
          "text": "כ\"א כסלו,"
        },
        {
          "s": 3,
          "text": "ה'תשל\"א"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "(הנחה בלתי מוגה)"
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "אמר ר' אלכסנדרי כל העוסק בתורה לשמה משים שלום בפמליא של מעלה ובפמליא של מטה1."
        },
        {
          "s": 1,
          "text": "והנה במאמר ד\"ה זה שנאמר לפני שלשים שנה"
        },
        {
          "s": 2,
          "text": "(כ\"א כסלו תש\"א)2"
        },
        {
          "s": 3,
          "text": "מביא גם ג' הדיעות"
        },
        {
          "s": 4,
          "text": "(בענין פעולת עסק התורה לשמה)"
        },
        {
          "s": 5,
          "text": "שלאח\"ז1"
        },
        {
          "s": 6,
          "text": ": כאילו בנה פלטרין של מעלה ושל מטה,"
        },
        {
          "s": 7,
          "text": "אף מגין על כל העולם כולו,"
        },
        {
          "s": 8,
          "text": "אף מקרב את הגאולה."
        },
        {
          "s": 9,
          "text": "ומבאר בהמאמר שם,"
        },
        {
          "s": 10,
          "text": "ששלום הו\"ע ההתחברות"
        },
        {
          "s": 11,
          "text": "(והיינו שישנם ב' ענינים נפרדים ומחולקים זמ\"ז,"
        },
        {
          "s": 12,
          "text": "וישנו שלישי העושה שלום ביניהם),"
        },
        {
          "s": 13,
          "text": "ופמליא ענינו חיילות,"
        },
        {
          "s": 14,
          "text": "ובעבודה הו\"ע המדות,"
        },
        {
          "s": 15,
          "text": "וזהו כל העוסק בתורה לשמה משים שלום בפמליא כו',"
        },
        {
          "s": 16,
          "text": "שע\"י עסק התורה לשמה עושה התחברות בהמדות."
        },
        {
          "s": 17,
          "text": "ומוסיף בהמאמר שם: והיינו המדות שבלב הנולדות מהמדות שבשכל"
        },
        {
          "s": 18,
          "text": "(שהכוונה בזה לבאר ב' הענינים שבפמליא,"
        },
        {
          "s": 19,
          "text": "פמליא של מעלה ופמליא של מטה,"
        },
        {
          "s": 20,
          "text": "דפמליא של מעלה הו\"ע המדות שבשכל,"
        },
        {
          "s": 21,
          "text": "ופמליא של מטה הו\"ע המדות שבלב."
        },
        {
          "s": 22,
          "text": "דהנה,"
        },
        {
          "s": 23,
          "text": "המדות הם שרש ומקור הנבראים,"
        },
        {
          "s": 24,
          "text": "שבעת ימי הבנין,"
        },
        {
          "s": 25,
          "text": "והמוחין הם למעלה מעולמות,"
        },
        {
          "s": 26,
          "text": "כמאמר3"
        },
        {
          "s": 27,
          "text": "אלפיים שנה קדמה תורה לעולם,"
        },
        {
          "s": 28,
          "text": "שלכן בכללות המדות הם בחי' מטה והמוחין הם בחי' מעלה,"
        },
        {
          "s": 29,
          "text": "אמנם בענין המדות"
        },
        {
          "s": 30,
          "text": "(פמליא)"
        },
        {
          "s": 31,
          "text": "גופא,"
        },
        {
          "s": 32,
          "text": "הנה המדות שבלב הן פמליא של מטה והמדות שבשכל הן פמליא של מעלה)."
        },
        {
          "s": 33,
          "text": "וכ\"ז היא פעולה הא' שבעסק התורה לשמה."
        },
        {
          "s": 34,
          "text": "ופעולה הב' כאילו בנה פלטרין כו' הוא"
        },
        {
          "s": 35,
          "text": "(כמו שמבאר בהמאמר שם)"
        },
        {
          "s": 36,
          "text": "ענין המוחין,"
        },
        {
          "s": 37,
          "text": "וגם בזה ישנם ב' בחינות,"
        },
        {
          "s": 38,
          "text": "פלטרין של מעלה ופלטרין של מטה,"
        },
        {
          "s": 39,
          "text": "פלטרין של מעלה הו\"ע השכל שבמוח,"
        },
        {
          "s": 40,
          "text": "ופלטרין של מטה הו\"ע השכל שבמדות,"
        },
        {
          "s": 41,
          "text": "כמבואר בהמאמר שם."
        },
        {
          "s": 42,
          "text": "וזהו ג\"כ מה שבפעולה הא' אמרו משים שלום בפמליא כו'"
        },
        {
          "s": 43,
          "text": "(והיינו שהפמליא ישנו כבר גם לפנ\"ז ורק שמשים שלום בה),"
        },
        {
          "s": 44,
          "text": "ובפעולה הב' אמרו בנה פלטרין שבונה דבר חדש,"
        },
        {
          "s": 45,
          "text": "כי המדות,"
        },
        {
          "s": 46,
          "text": "מכיון שהם שרש ומקור הנבראים,"
        },
        {
          "s": 47,
          "text": "הרי ישנם הם בעולמות מצד עצמם"
        },
        {
          "s": 48,
          "text": "(והפעולה שנעשה בהם ע\"י עסק התורה לשמה הוא ענין השלום),"
        },
        {
          "s": 49,
          "text": "משא\"כ המוחין שהם למעלה מעולמות,"
        },
        {
          "s": 50,
          "text": "הרי המשכת המוחין שע\"י עסק התורה לשמה הו\"ע בנין חדש."
        },
        {
          "s": 51,
          "text": "והנה ידוע4"
        },
        {
          "s": 52,
          "text": "שבריאת העולמות היתה בשביל ישראל ובשביל התורה,"
        },
        {
          "s": 53,
          "text": "דישראל הו\"ע ז\"א,"
        },
        {
          "s": 54,
          "text": "המדות"
        },
        {
          "s": 55,
          "text": "(וכידוע5"
        },
        {
          "s": 56,
          "text": "שישראל הוא ר\"ת יש ששים רבוא אותיות לתורה,"
        },
        {
          "s": 57,
          "text": "וידוע6"
        },
        {
          "s": 58,
          "text": "שהמספר ששים רבוא הוא מצד בחי' המדות,"
        },
        {
          "s": 59,
          "text": "וא\"ו כלול מיו\"ד ויו\"ד מיו\"ד כו')"
        },
        {
          "s": 60,
          "text": "ותורה הו\"ע המוחין,"
        },
        {
          "s": 61,
          "text": "ומזה מובן שע\"י ב' פעולות הנ\"ל הנעשים ע\"י עסק התורה לשמה"
        },
        {
          "s": 62,
          "text": "[משים שלום בפמליא כו',"
        },
        {
          "s": 63,
          "text": "בחי' מדות"
        },
        {
          "s": 64,
          "text": "(ישראל),"
        },
        {
          "s": 65,
          "text": "ובנה פלטרין כו',"
        },
        {
          "s": 66,
          "text": "בחי' מוחין"
        },
        {
          "s": 67,
          "text": "(תורה)],"
        },
        {
          "s": 68,
          "text": "בא אח\"כ גם בהעולם שנברא בשביל ישראל ובשביל התורה."
        },
        {
          "s": 69,
          "text": "וזהו\"ע הג'1"
        },
        {
          "s": 70,
          "text": "אף מגין על כל העולם כולו,"
        },
        {
          "s": 71,
          "text": "וכמ\"ש בהמאמר: שהמוחין ומדות מגינים על העולם שהם הפעולות הנעשות ע\"י השגת המוח והמדות שבלב."
        },
        {
          "s": 72,
          "text": "אמנם פעולה זו שנעשית בהעולם,"
        },
        {
          "s": 73,
          "text": "זה שהמוחין והמדות"
        },
        {
          "s": 74,
          "text": "(בחי' תורה וישראל)"
        },
        {
          "s": 75,
          "text": "מגינים עליו,"
        },
        {
          "s": 76,
          "text": "הוא השלימות דעולם כמו שהוא מצד הבריאה,"
        },
        {
          "s": 77,
          "text": "שהרי תחילת בריאת העולם היתה בשביל ישראל ובשביל התורה כנ\"ל,"
        },
        {
          "s": 78,
          "text": "אמנם פעולה הד' שבעסק התורה לשמה,"
        },
        {
          "s": 79,
          "text": "אף מקרב את הגאולה,"
        },
        {
          "s": 80,
          "text": "הוא ענין השלימות שלמעלה מענין הבריאה,"
        },
        {
          "s": 81,
          "text": "וכמ\"ש בהמאמר: שנשתנה בעצם מהותו כו'."
        },
        {
          "s": 82,
          "text": "וכידוע7"
        },
        {
          "s": 83,
          "text": "בפירוש מחז\"ל8"
        },
        {
          "s": 84,
          "text": "כל תולדות שבמקרא חסרים חוץ משנים אלה תולדות השמים והארץ9"
        },
        {
          "s": 85,
          "text": "ואלה תולדות פרץ10,"
        },
        {
          "s": 86,
          "text": "דהגם ששניהם הם מלאים,"
        },
        {
          "s": 87,
          "text": "מ\"מ יש הפרש גדול ביניהם,"
        },
        {
          "s": 88,
          "text": "שאלה תולדות השמים והארץ הו\"ע בחי' השלימות כמו שהיא מצד הבריאה,"
        },
        {
          "s": 89,
          "text": "משא\"כ ואלה תולדות פרץ,"
        },
        {
          "s": 90,
          "text": "ענין הגאולה,"
        },
        {
          "s": 91,
          "text": "הוא בחי' שלימות שלמעלה מענין הבריאה."
        }
      ]
    }
  ]
}