{
  "globalIndex": 212,
  "owner": 12,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915043_theRebbe_419__p001",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915043_theRebbe_419__p001",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518915043_theRebbe_419",
  "title": "מאמר ואברהם זקן תשל\"ח",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "מוצאי ש\"פ חיי שרה,"
        },
        {
          "s": 2,
          "text": "מבה\"ח כסלו – בחדרו – ה'תשל\"ח"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "ואברהם זקן בא בימים גו'1,"
        },
        {
          "s": 1,
          "text": "ומביא רבינו הזקן בתו\"א בפרשתנו ד\"ה2"
        },
        {
          "s": 2,
          "text": "להבין ענין מה שאמרו רז\"ל3"
        },
        {
          "s": 3,
          "text": "יפה שעה אחת בתשובה ומעשים טובים בעולם הזה מכל חיי עולם הבא"
        },
        {
          "s": 4,
          "text": "(ולפני הדרוש – שהוא \"שייך לפסוק ואברהם זקן בא בימים\")"
        },
        {
          "s": 5,
          "text": "מאמר הזהר4"
        },
        {
          "s": 6,
          "text": "על הפסוק באינון יומין עילאין כו',"
        },
        {
          "s": 7,
          "text": "שהם הלבושים דתורה ומצוות5"
        },
        {
          "s": 8,
          "text": "(תשובה ומעשים טובים)"
        },
        {
          "s": 9,
          "text": "שעל ידם תוכל הנשמה ליהנות מזיו השכינה בעוה\"ב."
        },
        {
          "s": 10,
          "text": "וענין זה שייך גם לימים כפשוטם6,"
        },
        {
          "s": 11,
          "text": "שצריכים להיות כל הימים שלמים,"
        },
        {
          "s": 12,
          "text": "היינו שכל יום יהי' מלא בעשיית מצוה"
        },
        {
          "s": 13,
          "text": "(יומין עילאין)."
        },
        {
          "s": 14,
          "text": "וידוע מאמר הבעל שם טוב7"
        },
        {
          "s": 15,
          "text": "\"לא יניח שום יום מעשיית מצוה כו'\"."
        },
        {
          "s": 16,
          "text": "וזהו בא בימים,"
        },
        {
          "s": 17,
          "text": "שאברהם אבינו עבד את עבודתו בכל יום ויום8,"
        },
        {
          "s": 18,
          "text": "שכל ימיו היו יומין שלימין"
        },
        {
          "s": 19,
          "text": "(ולא חסרין ח\"ו),"
        },
        {
          "s": 20,
          "text": "ועי\"ז \"בא בימים – באינון יומין עילאין\"9."
        },
        {
          "s": 21,
          "text": "וידוע הדיוק בזה10,"
        },
        {
          "s": 22,
          "text": "הרי העיקר הוא לבושי המצוות"
        },
        {
          "s": 23,
          "text": "(יומין עילאין),"
        },
        {
          "s": 24,
          "text": "ומה נוגע בזה ענין הימים"
        },
        {
          "s": 25,
          "text": "(כפשוטם)"
        },
        {
          "s": 26,
          "text": "שלא יניח שום יום מעשיית מצוה כו',"
        },
        {
          "s": 27,
          "text": "הלא יוכל לעשות למחר שתי מצוות."
        },
        {
          "s": 28,
          "text": "דלכאורה גם כשעושה כמה מצוות במשך יום אחד יש לו אותו מספר המצוות כמו כשהי' מקיימם במשך כמה ימים11,"
        },
        {
          "s": 29,
          "text": "וא\"כ,"
        },
        {
          "s": 30,
          "text": "מה נוגע שיקיים מצוה בכל יום דוקא,"
        },
        {
          "s": 31,
          "text": "ועד שכאשר חסר לו יום אחד חסר לו לבוש12."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה מזה שמעלה זו דאברהם"
        },
        {
          "s": 2,
          "text": "(בא בימים)"
        },
        {
          "s": 3,
          "text": "בא בקרא לאחרי כו\"כ מעלות שלו שבפסוקים שלפנ\"ז,"
        },
        {
          "s": 4,
          "text": "ועד שבכתוב זה גופא בתחילה הוא אומר ואברהם זקן ואח\"כ מוסיף בא בימים,"
        },
        {
          "s": 5,
          "text": "מובן שענין בא בימים הוא מעלה גדולה יותר גם מהמעלה דזקן."
        },
        {
          "s": 6,
          "text": "דהגם שואברהם זקן פי' שהי' בעילוי נפלא ביותר,"
        },
        {
          "s": 7,
          "text": "וכמרז\"ל13"
        },
        {
          "s": 8,
          "text": "שאמר לו הקב\"ה לאברהם בא לבוש לבושי"
        },
        {
          "s": 9,
          "text": "(דהקב\"ה שנקרא14"
        },
        {
          "s": 10,
          "text": "עתיק יומין15)"
        },
        {
          "s": 11,
          "text": "שנאמר ואברהם זקן,"
        },
        {
          "s": 12,
          "text": "היינו שואברהם זקן היא מעלת אברהם מה שלובש לבוש הקב\"ה כמו שהקב\"ה הוא בבחי' עתיק יומין,"
        },
        {
          "s": 13,
          "text": "הנה בא בימים נעלה עוד יותר."
        },
        {
          "s": 14,
          "text": "וצריך להבין מהו גודל העילוי דבא בימים,"
        },
        {
          "s": 15,
          "text": "לבושי המצוות"
        },
        {
          "s": 16,
          "text": "[ובפרט בהענין דעשיית מצוה בכל יום דוקא,"
        },
        {
          "s": 17,
          "text": "הגם שאינו מתוסף עי\"ז במספר המצוות],"
        },
        {
          "s": 18,
          "text": "ועד שזה נעלה יותר מענין"
        },
        {
          "s": 19,
          "text": "(ואברהם)"
        },
        {
          "s": 20,
          "text": "זקן שהוא בחי'"
        },
        {
          "s": 21,
          "text": "(הלבוש ד)"
        },
        {
          "s": 22,
          "text": "עתיק יומין16."
        }
      ]
    }
  ]
}