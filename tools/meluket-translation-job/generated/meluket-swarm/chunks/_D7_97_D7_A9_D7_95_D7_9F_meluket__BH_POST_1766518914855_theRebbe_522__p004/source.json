{
  "globalIndex": 185,
  "owner": 35,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914855_theRebbe_522__p004",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914855_theRebbe_522__p004",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518914855_theRebbe_522",
  "title": "מאמר ואשה אחת תשמ\"ו",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דזה שאומר לא נפלאת היא ממך ולא רחוקה היא,"
        },
        {
          "s": 2,
          "text": "הכוונה בזה היא להתומ\"צ כמו שהם בבחינת פלא וריחוק,"
        },
        {
          "s": 3,
          "text": "וגם להתומ\"צ כמו שהם מצד עצמם"
        },
        {
          "s": 4,
          "text": "(קודם ירידתם,"
        },
        {
          "s": 5,
          "text": "שאז אין שייך לומר עליהם גם התואר דפלא וריחוק),"
        },
        {
          "s": 6,
          "text": "שגם דרגא זו דתומ\"צ לא נפלאת היא ממך ולא רחוקה היא."
        },
        {
          "s": 7,
          "text": "כי במתן תורה ניתנו לישראל כל הדרגות דתורה,"
        },
        {
          "s": 8,
          "text": "גם הדרגא דתורה כמו שהיא מצד עצמה"
        },
        {
          "s": 9,
          "text": "(לפני ירידתה להיות שייכת לעולמות),"
        },
        {
          "s": 10,
          "text": "ועד לאורייתא וקוב\"ה כולא חד54."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "והנה עד\"ז הוא להפירוש דהמצוה הזאת קאי על מצות התשובה,"
        },
        {
          "s": 2,
          "text": "דזה שתשובה היא בבחינת פלא וריחוק,"
        },
        {
          "s": 3,
          "text": "הוא כמו שירדה להיות נמשכת למטה,"
        },
        {
          "s": 4,
          "text": "אבל כמו שהיא מצד עצמה,"
        },
        {
          "s": 5,
          "text": "אין שייך בה גם התוארים פלא וריחוק."
        },
        {
          "s": 6,
          "text": "והגם שהפלא והריחוק דתשובה הם באופן נעלה יותר מהפלא והריחוק שבכל המצוות"
        },
        {
          "s": 7,
          "text": "[דהפלא והריחוק שבכל המצוות הו\"ע הרצון והחכמה"
        },
        {
          "s": 8,
          "text": "(כנ\"ל סעיף ו),"
        },
        {
          "s": 9,
          "text": "וכיון שתשובה היא בבעל הרצון"
        },
        {
          "s": 10,
          "text": "(כנ\"ל סעיף ד),"
        },
        {
          "s": 11,
          "text": "מובן,"
        },
        {
          "s": 12,
          "text": "שהפלא והריחוק דתשובה הם באופן נעלה יותר],"
        },
        {
          "s": 13,
          "text": "מ\"מ,"
        },
        {
          "s": 14,
          "text": "מכיון שהתואר פלא"
        },
        {
          "s": 15,
          "text": "(ומכ\"ש התואר דריחוק),"
        },
        {
          "s": 16,
          "text": "גם כמו שהוא בתכלית העילוי,"
        },
        {
          "s": 17,
          "text": "מורה שהדבר המופלא יש לו איזו שייכות להדבר שמופלא ממנו,"
        },
        {
          "s": 18,
          "text": "לכן,"
        },
        {
          "s": 19,
          "text": "בהדרגא דתשובה כמו שהיא מצד עצמה"
        },
        {
          "s": 20,
          "text": "(בעל הרצון),"
        },
        {
          "s": 21,
          "text": "אין שייך לומר לשון פלא וריחוק."
        },
        {
          "s": 22,
          "text": "ומ\"ש שהמצוה הזאת"
        },
        {
          "s": 23,
          "text": "(תשובה)"
        },
        {
          "s": 24,
          "text": "היא נפלאת ורחוקה,"
        },
        {
          "s": 25,
          "text": "הוא,"
        },
        {
          "s": 26,
          "text": "לאחרי ירידתה להיות נמשכת למטה."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דמ\"ש לא נפלאת היא ממך ולא רחוקה היא,"
        },
        {
          "s": 2,
          "text": "הכוונה בזה היא להתשובה כמו שהיא בבחינת פלא וריחוק וגם להתשובה כמו שהיא מצד שרשה בבעל הרצון"
        },
        {
          "s": 3,
          "text": "(שלמעלה מהתואר דפלא וריחוק),"
        },
        {
          "s": 4,
          "text": "שגם דרגא זו דתשובה לא נפלאת היא ממך ולא רחוקה היא."
        },
        {
          "s": 5,
          "text": "וזהו מ\"ש כי המצוה הזאת אשר אנכי מצוך גו',"
        },
        {
          "s": 6,
          "text": "שגם התשובה כמו שהיא מצד אנכי,"
        },
        {
          "s": 7,
          "text": "אנכי מי שאנכי,"
        },
        {
          "s": 8,
          "text": "לא נפלאת היא ממך ולא רחוקה היא."
        }
      ]
    }
  ]
}