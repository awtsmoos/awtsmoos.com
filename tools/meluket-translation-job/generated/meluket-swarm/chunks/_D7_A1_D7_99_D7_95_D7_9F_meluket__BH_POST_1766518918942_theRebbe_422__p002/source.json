{
  "globalIndex": 875,
  "owner": 25,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918942_theRebbe_422__p002",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918942_theRebbe_422__p002",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918942_theRebbe_422",
  "title": "מאמר וישלח יהושוע תשל\"ו",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה התורה היא נצחית."
        },
        {
          "s": 2,
          "text": "ומזה מובן,"
        },
        {
          "s": 3,
          "text": "דזה שמסופר בתורה"
        },
        {
          "s": 4,
          "text": "(גם)"
        },
        {
          "s": 5,
          "text": "שילוח המרגלים"
        },
        {
          "s": 6,
          "text": "(דמשה)"
        },
        {
          "s": 7,
          "text": "לתור את כל הארץ,"
        },
        {
          "s": 8,
          "text": "הוא הוראה נצחית לכאו\"א מישראל."
        },
        {
          "s": 9,
          "text": "ויובן זה בהקדים המבואר בתניא12"
        },
        {
          "s": 10,
          "text": "בענין צדיקים ובינונים,"
        },
        {
          "s": 11,
          "text": "שעבודת הבינונים היא"
        },
        {
          "s": 12,
          "text": "(בעיקר13)"
        },
        {
          "s": 13,
          "text": "בלבושי הנפש,"
        },
        {
          "s": 14,
          "text": "מחשבה דיבור ומעשה,"
        },
        {
          "s": 15,
          "text": "ולכן מדת הבינוני היא מדת כל אדם,"
        },
        {
          "s": 16,
          "text": "שגם כשהלב חומד ומתאוה איזו תאוה ביכלתו להתאפק14"
        },
        {
          "s": 17,
          "text": "ולמשול ברוח תאותו שבלבו שלא למלאותה במעשה דיבור ומחשבה"
        },
        {
          "s": 18,
          "text": "(שלא לחשוב עד\"ז ברצונו15),"
        },
        {
          "s": 19,
          "text": "ועד שביכלתו להסיח דעתו ממנה לגמרי."
        },
        {
          "s": 20,
          "text": "משא\"כ עבודת הצדיקים היא בעיקר במדות שבלב"
        },
        {
          "s": 21,
          "text": "(אהבה ויראה),"
        },
        {
          "s": 22,
          "text": "ואין כל אדם זוכה לזה."
        },
        {
          "s": 23,
          "text": "כי בדבר המסור ללב אין לאדם משפט הבחירה כל כך."
        },
        {
          "s": 24,
          "text": "אלא שאעפ\"כ,"
        },
        {
          "s": 25,
          "text": "משביעין"
        },
        {
          "s": 26,
          "text": "(לכאו\"א מישראל)"
        },
        {
          "s": 27,
          "text": "תהי צדיק16,"
        },
        {
          "s": 28,
          "text": "שכל אחד צריך גם להשתדל בעבודת הצדיקים,"
        },
        {
          "s": 29,
          "text": "כמבואר בארוכה בתניא."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "דזהו שהציווי להרוג שבעה עממין ולכבוש את ארצם הוא נצחי בכל דור17,"
        },
        {
          "s": 3,
          "text": "אף שכיבוש ארץ שבעה עממין הוא הפיכת ז' המדות דנפש הבהמית לקדושה,"
        },
        {
          "s": 4,
          "text": "דענין זה שייך לצדיקים,"
        },
        {
          "s": 5,
          "text": "ואין כל אדם זוכה לזה18,"
        },
        {
          "s": 6,
          "text": "כי כאו\"א מישראל צריך לעשות כל מה שביכלתו לקיים את השבועה שמשביעין אותו תהי צדיק19."
        },
        {
          "s": 7,
          "text": "וזהו מה שגם הסיפור דשילוח המרגלים"
        },
        {
          "s": 8,
          "text": "(דמשה)"
        },
        {
          "s": 9,
          "text": "לתור את כל הארץ נכתב בתורה"
        },
        {
          "s": 10,
          "text": "(מלשון הוראה20),"
        },
        {
          "s": 11,
          "text": "שכ\"א מישראל צריך לתור ולבחון את המדות שלו,"
        },
        {
          "s": 12,
          "text": "שיהיו כולם להוי'."
        },
        {
          "s": 13,
          "text": "אלא שאעפ\"כ,"
        },
        {
          "s": 14,
          "text": "במרגלים דמשה כתיב שלח לך לדעתך,"
        },
        {
          "s": 15,
          "text": "אני איני מצוה לך,"
        },
        {
          "s": 16,
          "text": "כי עיקר הציווי הוא על המחשבה דיבור ומעשה"
        },
        {
          "s": 17,
          "text": "(כיבוש יריחו),"
        },
        {
          "s": 18,
          "text": "שבהם"
        },
        {
          "s": 19,
          "text": "(דוקא)"
        },
        {
          "s": 20,
          "text": "הרשות נתונה לכל אדם,"
        },
        {
          "s": 21,
          "text": "משא\"כ במדות שבלב."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה הטעם לזה"
        },
        {
          "s": 2,
          "text": "(שמחדומ\"ע הם ברשותו של אדם,"
        },
        {
          "s": 3,
          "text": "משא\"כ המדות שבלב)"
        },
        {
          "s": 4,
          "text": "הוא21,"
        },
        {
          "s": 5,
          "text": "כי מחשבה דיבור ומעשה הם לבושי הנפש."
        },
        {
          "s": 6,
          "text": "ולכן,"
        },
        {
          "s": 7,
          "text": "כמו שלבושי הגוף,"
        },
        {
          "s": 8,
          "text": "עם היות שהאדם צריך ללבושים"
        },
        {
          "s": 9,
          "text": "[מצד ענין הצניעות כיון דיתבוששו22,"
        },
        {
          "s": 10,
          "text": "וגם בכדי להגן עליו מקור וחום],"
        },
        {
          "s": 11,
          "text": "מ\"מ ביכלתו לפושטם,"
        },
        {
          "s": 12,
          "text": "ומכש\"כ שאינו מוכרח בלבושים אלו"
        },
        {
          "s": 13,
          "text": "(שלובש עכשיו)"
        },
        {
          "s": 14,
          "text": "וביכלתו להחליפם בלבושים אחרים,"
        },
        {
          "s": 15,
          "text": "עד\"ז הוא בלבושי הנפש,"
        },
        {
          "s": 16,
          "text": "דהלבושים דיבור ומעשה אפשר לפושטם,"
        },
        {
          "s": 17,
          "text": "וגם המחשבה שהיא בתמידות,"
        },
        {
          "s": 18,
          "text": "נחלפת במחשבה אחרת."
        },
        {
          "s": 19,
          "text": "משא\"כ השכל והמדות ה\"ה מהות הנפש23,"
        },
        {
          "s": 20,
          "text": "ולכן,"
        },
        {
          "s": 21,
          "text": "בכדי לשנותם,"
        },
        {
          "s": 22,
          "text": "צריך ליגיעה,"
        },
        {
          "s": 23,
          "text": "ועד לנתינת כח מיוחד מלמעלה."
        }
      ]
    }
  ]
}