{
  "globalIndex": 675,
  "owner": 25,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917741_theRebbe_999__p003",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917741_theRebbe_999__p003",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917741_theRebbe_999",
  "title": "מאמר אשה כי תזריע תשכ\"ה",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יש לבאר הסדר דשני הפירושים באשה מזרעת תחלה יולדת זכר,"
        },
        {
          "s": 2,
          "text": "שבתחלה"
        },
        {
          "s": 3,
          "text": "(לפני שנתגלה ה\"פנימיות\" דעבודת ישראל),"
        },
        {
          "s": 4,
          "text": "העבודה דכנסת ישראל וההמשכה מלמעלה הם שני דברים,"
        },
        {
          "s": 5,
          "text": "ובמילא ההמשכה שבאה על ידה היא מהאור השייך לעולמות"
        },
        {
          "s": 6,
          "text": "(שהאתערותא דלתתא מגעת לשם),"
        },
        {
          "s": 7,
          "text": "והמעלה בהעבודה דישראל אז היא שהעבודה היא סיבה שהאתערותא דלעילא הנמשכת על ידה תהי' מפנימיות האור – פירוש הראשון שזרע האשה היא סיבה להתגברות דזרע האיש"
        },
        {
          "s": 8,
          "text": "(עילאה גבר),"
        },
        {
          "s": 9,
          "text": "ועי\"ז מתגלה הפנימיות דעבודת ישראל,"
        },
        {
          "s": 10,
          "text": "כח העצמות שבה"
        },
        {
          "s": 11,
          "text": "(מצד זה שישראל וקוב\"ה כולא חד),"
        },
        {
          "s": 12,
          "text": "וכל ההמשכות הן ע\"י העבודה גופא"
        },
        {
          "s": 13,
          "text": "(ולא שהעבודה היא רק סיבה לההמשכה)"
        },
        {
          "s": 14,
          "text": "– פירוש השני שלידת הזכר הוא מזרע האשה,"
        },
        {
          "s": 15,
          "text": "ומעלת ההמשכה מלמעלה"
        },
        {
          "s": 16,
          "text": "(לידת הזכר)"
        },
        {
          "s": 17,
          "text": "היא"
        },
        {
          "s": 18,
          "text": "(לא רק המשכת הפנימיות של האור השייך לעולמות,"
        },
        {
          "s": 19,
          "text": "אלא גם)"
        },
        {
          "s": 20,
          "text": "המשכת האור שלמעלה משייכות לעולמות,"
        },
        {
          "s": 21,
          "text": "ועד להמשכת העצמות."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ויש לקשר זה עם יום השני בניסן,"
        },
        {
          "s": 2,
          "text": "דלהדיעה26"
        },
        {
          "s": 3,
          "text": "שבניסן נברא העולם,"
        },
        {
          "s": 4,
          "text": "היינו שבריאת האדם היתה בר\"ח ניסן ובריאת העולם היתה בכ\"ה אדר27,"
        },
        {
          "s": 5,
          "text": "יום השבת הראשון הי' בשני בניסן."
        },
        {
          "s": 6,
          "text": "וע\"פ הידוע28"
        },
        {
          "s": 7,
          "text": "בתיווך ב' הדיעות בזמן הבריאה26,"
        },
        {
          "s": 8,
          "text": "שהבריאה בפועל היתה בתשרי"
        },
        {
          "s": 9,
          "text": "(כ\"ה אלול29)"
        },
        {
          "s": 10,
          "text": "והמחשבה לברוא את העולם היתה בניסן"
        },
        {
          "s": 11,
          "text": "(כ\"ה אדר),"
        },
        {
          "s": 12,
          "text": "יש לומר,"
        },
        {
          "s": 13,
          "text": "שבהבריאה בפועל שהיתה בתשרי נכלל גם הגילוי דחפץ חסד30,"
        },
        {
          "s": 14,
          "text": "וזה שבניסן היתה המחשבה לברוא יש לומר דמחשבה זו היא ע\"ד המחשבה דבמי נמלך,"
        },
        {
          "s": 15,
          "text": "הכוונה והתכלית דהבריאה שלא נמשכה בגילוי בהבריאה31."
        },
        {
          "s": 16,
          "text": "וביום השבת,"
        },
        {
          "s": 17,
          "text": "ב' ניסן,"
        },
        {
          "s": 18,
          "text": "נעשה השלימות דהמחשבה."
        },
        {
          "s": 19,
          "text": "ויש לקשר זה גם עם זה שיום ב' ניסן הוא יום ההילולא של אדמו\"ר"
        },
        {
          "s": 20,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 21,
          "text": "נ\"ע,"
        },
        {
          "s": 22,
          "text": "ויום שבו הוכתר כ\"ק מו\"ח אדמו\"ר"
        },
        {
          "s": 23,
          "text": "(בנו יחידו של בעל ההילולא)"
        },
        {
          "s": 24,
          "text": "בכתר הנשיאות32,"
        },
        {
          "s": 25,
          "text": "כי הכוונה והתכלית דהבריאה היא שיהי' בעולם הגילוי דאוא\"ס שלמעלה משייכות לעולמות"
        },
        {
          "s": 26,
          "text": "(כנ\"ל),"
        },
        {
          "s": 27,
          "text": "דגילוי זה הוא"
        },
        {
          "s": 28,
          "text": "(בעיקר)"
        },
        {
          "s": 29,
          "text": "ע\"י הלימוד וההפצה דפנימיות התורה."
        },
        {
          "s": 30,
          "text": "דפנימיות התורה מצד עצמה היא למעלה מגילוי"
        },
        {
          "s": 31,
          "text": "(סתים דאורייתא),"
        },
        {
          "s": 32,
          "text": "וע\"י הלימוד דפנימיות התורה בהבנה והשגה,"
        },
        {
          "s": 33,
          "text": "ובפרט ע\"י הפצתה חוצה"
        },
        {
          "s": 34,
          "text": "(ועד חוצה בתכלית),"
        },
        {
          "s": 35,
          "text": "ממשיכים האור שלמעלה משייכות לעולמות,"
        },
        {
          "s": 36,
          "text": "ועד לעצם האור שלמעלה מגילוי,"
        },
        {
          "s": 37,
          "text": "שיהי' בגילוי בעולם."
        },
        {
          "s": 38,
          "text": "וזוהי השייכות דב' ניסן,"
        },
        {
          "s": 39,
          "text": "השבת הראשון דמעשה בראשית במחשבה"
        },
        {
          "s": 40,
          "text": "(שבו היתה השלימות דהמחשבה)"
        },
        {
          "s": 41,
          "text": "לבעל ההילולא ולבנו יחידו ממלא מקומו33,"
        },
        {
          "s": 42,
          "text": "כי ע\"י הדרושים של בעל ההילולא שהוא הרמב\"ם דתורת החסידות34"
        },
        {
          "s": 43,
          "text": "(דברים המתבארים ועד שתהא סדורה בפי הכל35),"
        },
        {
          "s": 44,
          "text": "ובפרט,"
        },
        {
          "s": 45,
          "text": "ע\"י ההתייסדות דתומכי תמימים,"
        },
        {
          "s": 46,
          "text": "הותחל שלב חדש בהפצת המעינות,"
        },
        {
          "s": 47,
          "text": "ולאחרי זה,"
        },
        {
          "s": 48,
          "text": "ע\"י כ\"ק מו\"ח אדמו\"ר,"
        },
        {
          "s": 49,
          "text": "נעשה ההפצה עוד ביתר שאת ויתר עוז."
        },
        {
          "s": 50,
          "text": "שזו"
        },
        {
          "s": 51,
          "text": "(הפצת המעינות חוצה)"
        },
        {
          "s": 52,
          "text": "היא ההכנה והכלי לאתי מר דא מלכא משיחא36"
        },
        {
          "s": 53,
          "text": "(שאז תושלם הכוונה37"
        },
        {
          "s": 54,
          "text": "דדירה בתחתונים38),"
        },
        {
          "s": 55,
          "text": "בקרוב ממש."
        }
      ]
    }
  ]
}