{
  "globalIndex": 365,
  "owner": 15,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915834_theRebbe_708__p006",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915834_theRebbe_708__p006",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915834_theRebbe_708",
  "title": "מאמר שלום רב לאוהבי תורתך תשל\"ח",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "ויובן זה בהקדים מה שמבאר רבנו הזקן"
        },
        {
          "s": 3,
          "text": "(בעל הגאולה די\"ט כסלו89)"
        },
        {
          "s": 4,
          "text": "בתו\"א ד\"ה וישב יעקב בארץ מגורי אביו90"
        },
        {
          "s": 5,
          "text": "בענין ההפרש בין תורה למצוות,"
        },
        {
          "s": 6,
          "text": "שבקיום המצוות,"
        },
        {
          "s": 7,
          "text": "האדם המקיים את המצוות הוא בבחי' עבד,"
        },
        {
          "s": 8,
          "text": "כעבד המקיים מצות המלך ועושה דבריו,"
        },
        {
          "s": 9,
          "text": "משא\"כ בלימוד התורה ה\"ה המלך עצמו91,"
        },
        {
          "s": 10,
          "text": "כמאמר92"
        },
        {
          "s": 11,
          "text": "מאן מלכי רבנן."
        },
        {
          "s": 12,
          "text": "שכאשר עסק התורה הוא בבחי' ביטול,"
        },
        {
          "s": 13,
          "text": "אזי ואשים דברי בפיך93,"
        },
        {
          "s": 14,
          "text": "דברי ממש,"
        },
        {
          "s": 15,
          "text": "היינו"
        },
        {
          "s": 16,
          "text": "(שלא האדם הוא המדבר,"
        },
        {
          "s": 17,
          "text": "כי אם)"
        },
        {
          "s": 18,
          "text": "שדבר ה' זו הלכה94"
        },
        {
          "s": 19,
          "text": "היא היא הנגלית בו והיא המדברת מתוך גרונו."
        },
        {
          "s": 20,
          "text": "וזהו מאן מלכי רבנן,"
        },
        {
          "s": 21,
          "text": "כי להיות שלימוד ההלכות שלהם הוא בביטול,"
        },
        {
          "s": 22,
          "text": "הרי לימוד ההלכות שלהם הוא באופן שהמלך עצמו"
        },
        {
          "s": 23,
          "text": "(ממה\"מ הקב\"ה)"
        },
        {
          "s": 24,
          "text": "גוזר ואומר את הפסק דין"
        },
        {
          "s": 25,
          "text": "(ההלכה)."
        },
        {
          "s": 26,
          "text": "וממשיך שם,"
        },
        {
          "s": 27,
          "text": "שזהו מ\"ש וישב יעקב בארץ מגורי אביו,"
        },
        {
          "s": 28,
          "text": "מגורי הוא לשון יראה95"
        },
        {
          "s": 29,
          "text": "וגם לשון אוצר"
        },
        {
          "s": 30,
          "text": "[כמו מגורה מליאה פירות96,"
        },
        {
          "s": 31,
          "text": "שהוא כלי שאוצרין לתוכו],"
        },
        {
          "s": 32,
          "text": "ושניהם עולים בקנה אחד כמ\"ש97"
        },
        {
          "s": 33,
          "text": "יראת ה' היא אוצרו וכן בדברי רז\"ל98"
        },
        {
          "s": 34,
          "text": "אוצר של יראת שמים."
        },
        {
          "s": 35,
          "text": "[ופירוש זה כתבו הרב המגיד99"
        },
        {
          "s": 36,
          "text": "(בעל ההילולא די\"ט כסלו100)"
        },
        {
          "s": 37,
          "text": "באו\"ת101"
        },
        {
          "s": 38,
          "text": "שמגורי אביו היא יראת אביו שבשמים,"
        },
        {
          "s": 39,
          "text": "ובהמשך הענין שם102"
        },
        {
          "s": 40,
          "text": ": מגורי לשון אסיפה וכניסה כמו אוגר103"
        },
        {
          "s": 41,
          "text": "בקייץ]."
        },
        {
          "s": 42,
          "text": "ופירוש מגורי אביו הוא,"
        },
        {
          "s": 43,
          "text": "שהביטול דיראה"
        },
        {
          "s": 44,
          "text": "[ובפרט הביטול דיראה עילאה]"
        },
        {
          "s": 45,
          "text": "הוא כלי קיבול"
        },
        {
          "s": 46,
          "text": "[אוצר]"
        },
        {
          "s": 47,
          "text": "להגילוי דחכמה עילאה"
        },
        {
          "s": 48,
          "text": "[דחכמה עילאה נק' אביו104]."
        },
        {
          "s": 49,
          "text": "וכנ\"ל,"
        },
        {
          "s": 50,
          "text": "דכשעסק התורה הוא בביטול,"
        },
        {
          "s": 51,
          "text": "אזי ואשים דברי בפיך,"
        },
        {
          "s": 52,
          "text": "שדבר ה' זו הלכה היא המדברת מתוך גרונו."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "והנה מהביאור בתו\"א שהביטול דיראה שהוא כלי לח\"ע נק' מגורי אביו,"
        },
        {
          "s": 3,
          "text": "היינו שהקב\"ה נקרא כאן לא בתואר אדון כ\"א בתואר אב"
        },
        {
          "s": 4,
          "text": "[וכלשון הה\"מ שמגורי אביו היא יראת אביו שבשמים],"
        },
        {
          "s": 5,
          "text": "מובן מזה,"
        },
        {
          "s": 6,
          "text": "שביטול זה הוא"
        },
        {
          "s": 7,
          "text": "(לא הביטול דעבד,"
        },
        {
          "s": 8,
          "text": "כ\"א)"
        },
        {
          "s": 9,
          "text": "הביטול דבן,"
        },
        {
          "s": 10,
          "text": "וע\"י ביטול זה"
        },
        {
          "s": 11,
          "text": "(דבן),"
        },
        {
          "s": 12,
          "text": "\"דבר ה' זו הלכה היא היא הנגלית בו והיא המדברת מתוך גרונו\","
        },
        {
          "s": 13,
          "text": "כי בהעבודה דבחי' בן אפשר להיות ביטול אמיתי בתכלית,"
        },
        {
          "s": 14,
          "text": "שאינו מציאות לעצמו כלל וכל מציאותו היא מציאות האב."
        },
        {
          "s": 15,
          "text": "[וכמבואר בלקו\"ת105,"
        },
        {
          "s": 16,
          "text": "דזה שהנשמות נק' בנים אין זה כמו בבן למטה שעם היותו נלקח ממוח האב הוא נפרד ממנו אח\"כ"
        },
        {
          "s": 17,
          "text": "(שלכן אבידתו ואבידת אביו אבידתו קודמת106),"
        },
        {
          "s": 18,
          "text": "כי אם,"
        },
        {
          "s": 19,
          "text": "שהנשמה היא כולא חד ואינה נפרדת ממנו ית' כלל]."
        },
        {
          "s": 20,
          "text": "ולא עוד,"
        },
        {
          "s": 21,
          "text": "אלא שביטול זה נעלה יותר מהביטול דעבד,"
        },
        {
          "s": 22,
          "text": "ויתירה מזה כנ\"ל"
        },
        {
          "s": 23,
          "text": "(מהתו\"א)"
        },
        {
          "s": 24,
          "text": "שע\"י עסק התורה בביטול הוא לא כעבד המקיים מצות המלך אלא הוא המלך עצמו."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ב)"
        },
        {
          "s": 2,
          "text": "וזהו וכל בניך לימודי הוי' ורב שלום בניך א\"ת בניך אלא בוניך"
        },
        {
          "s": 3,
          "text": "(וממשיך)"
        },
        {
          "s": 4,
          "text": "שלום רב לאוהבי תורתך,"
        },
        {
          "s": 5,
          "text": "שעבודת התלמידי חכמים הנק' בנים"
        },
        {
          "s": 6,
          "text": "(בניך)"
        },
        {
          "s": 7,
          "text": "היא כפירוש הרב המגיד102"
        },
        {
          "s": 8,
          "text": "עה\"פ וישב יעקב בארץ מגורי אביו"
        },
        {
          "s": 9,
          "text": "(שהו\"ע העבודה דבחי' בנים,"
        },
        {
          "s": 10,
          "text": "כנ\"ל)"
        },
        {
          "s": 11,
          "text": "\"לאגור ולאסוף הניצוצות הקדושים ולהכניסם ולהעלותם לעילא\"."
        },
        {
          "s": 12,
          "text": "[דזהו ג\"כ מה שממשיך בכתוב בארץ כנען,"
        },
        {
          "s": 13,
          "text": "כנען מלשון סוחר,"
        },
        {
          "s": 14,
          "text": "שתכלית ירידת הנשמה למטה היא \"לקנות לה סחורה וקנינה דוקא בעוה\"ז\"107"
        },
        {
          "s": 15,
          "text": "על ידי הניצוצות שמבררת,"
        },
        {
          "s": 16,
          "text": "וזהו ג\"כ מה שממשיך בפרשה108"
        },
        {
          "s": 17,
          "text": "והנה אנחנו מאלמים אלומים,"
        },
        {
          "s": 18,
          "text": "שקאי על בירור הניצוצות109]."
        },
        {
          "s": 19,
          "text": "ועי\"ז וישב יעקב,"
        },
        {
          "s": 20,
          "text": "(ביקש110"
        },
        {
          "s": 21,
          "text": "יעקב לישב)"
        },
        {
          "s": 22,
          "text": "בשלוה – ענין השלום,"
        },
        {
          "s": 23,
          "text": "הן השלום בעולם כמרז\"ל תלמידי חכמים מרבים שלום בעולם,"
        },
        {
          "s": 24,
          "text": "והן שלום להתלמידי חכמים עצמם,"
        },
        {
          "s": 25,
          "text": "כמו שממשיך שלום רב לאוהבי תורתך,"
        },
        {
          "s": 26,
          "text": "כי כיון שהתלמידי חכמים הנק' בנים הם בתכלית הביטול כנ\"ל,"
        },
        {
          "s": 27,
          "text": "לכן בחי' הנח\"ר דהבורא מזה שמרבים שלום בעולם נמשך גם להתלמידי חכמים עצמם."
        },
        {
          "s": 28,
          "text": "וזהו שלום רב לאוהבי תורתך,"
        },
        {
          "s": 29,
          "text": "שע\"י שעבודתם בתומ\"צ היא"
        },
        {
          "s": 30,
          "text": "(לא בכדי לקבל שכר,"
        },
        {
          "s": 31,
          "text": "אלא)"
        },
        {
          "s": 32,
          "text": "מצד אהבת ה',"
        },
        {
          "s": 33,
          "text": "לעשות נח\"ר לבורא"
        },
        {
          "s": 34,
          "text": "[ויודעים שהשכר שלהם,"
        },
        {
          "s": 35,
          "text": "נח\"ר דנברא,"
        },
        {
          "s": 36,
          "text": "הוא"
        },
        {
          "s": 37,
          "text": "(כנ\"ל סעיף ח)"
        },
        {
          "s": 38,
          "text": "באין ערוך להנח\"ר דבורא],"
        },
        {
          "s": 39,
          "text": "הנה ע\"י ביטול זה נמשך להם בגילוי הנח\"ר והתענוג דהבורא,"
        },
        {
          "s": 40,
          "text": "דכיון שאינם מציאות לעצמם כלל,"
        },
        {
          "s": 41,
          "text": "הרי התענוג דהבורא הוא התענוג שלהם."
        }
      ]
    }
  ]
}