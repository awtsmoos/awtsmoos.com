{
  "globalIndex": 908,
  "owner": 8,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919187_theRebbe_149__p002",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919187_theRebbe_149__p002",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919187_theRebbe_149",
  "title": "מאמר וידבר זאת חוקת תשכ\"ט",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ויש לבאר זה ע\"פ מ\"ש בתניא12"
        },
        {
          "s": 1,
          "text": "דהטעם על זה שציוה משה רבינו לדור שנכנסו לארץ לקרות ק\"ש פעמיים בכל יום לקבל מלכות שמים במס\"נ"
        },
        {
          "s": 2,
          "text": "(אף שהבטיח להם פחדכם ומוראכם יתן ה' וגו'13)"
        },
        {
          "s": 3,
          "text": "הוא מפני שקיום התומ\"צ תלוי בזכירת ענין המס\"נ."
        },
        {
          "s": 4,
          "text": "ויש לומר,"
        },
        {
          "s": 5,
          "text": "דזה שמשה דוקא ציוה זה לדור שנכנסו לארץ הוא,"
        },
        {
          "s": 6,
          "text": "כי מס\"נ הו\"ע הביטול,"
        },
        {
          "s": 7,
          "text": "וכיון שהאדם הוא מציאות"
        },
        {
          "s": 8,
          "text": "(היפך ענין הביטול),"
        },
        {
          "s": 9,
          "text": "לכן,"
        },
        {
          "s": 10,
          "text": "בכדי שענין המס\"נ יהי' אצלו בגילוי"
        },
        {
          "s": 11,
          "text": "[ובאופן שיהי' קבוע בלבו תמיד ממש יומם ולילה לא ימיש מזכרונו14],"
        },
        {
          "s": 12,
          "text": "צריך לזה נתינת כח מיוחדת."
        },
        {
          "s": 13,
          "text": "והנתינת כח הוא ע\"י משה,"
        },
        {
          "s": 14,
          "text": "כי משה הו\"ע הביטול,"
        },
        {
          "s": 15,
          "text": "ונחנו מה15."
        },
        {
          "s": 16,
          "text": "ולכן ע\"י שמשה ציוה16"
        },
        {
          "s": 17,
          "text": "לדור שנכנסו לארץ לקבל עליהם"
        },
        {
          "s": 18,
          "text": "(פעמיים בכל יום)"
        },
        {
          "s": 19,
          "text": "מלכות שמים במס\"נ,"
        },
        {
          "s": 20,
          "text": "עי\"ז ניתן להם הכח לזכור תמיד ענין המס\"נ שלהם."
        },
        {
          "s": 21,
          "text": "וזהו לעולם היא נקראת על שמך,"
        },
        {
          "s": 22,
          "text": "כי קיום התורה ומצוותי'"
        },
        {
          "s": 23,
          "text": "[דפרה אדומה היא כללות התומ\"צ]"
        },
        {
          "s": 24,
          "text": "תלוי בזכירת ענין המס\"נ,"
        },
        {
          "s": 25,
          "text": "והכח לזכור תמיד ענין המס\"נ הוא ע\"י משה,"
        },
        {
          "s": 26,
          "text": "וע\"י האתפשטותא דמשה שבכל דור17,"
        },
        {
          "s": 27,
          "text": "עד לכ\"ק מו\"ח אדמו\"ר נשיא דורנו בעל השמחה והגאולה."
        },
        {
          "s": 28,
          "text": "ויש לומר,"
        },
        {
          "s": 29,
          "text": "דע\"י שעבודתו של נשיא דורנו בכל משך שלושים שנות נשיאותו18"
        },
        {
          "s": 30,
          "text": "היתה במס\"נ בגילוי,"
        },
        {
          "s": 31,
          "text": "לכן הנתינת כח על זכירת המס\"נ מאתפשטותא דמשה שבדורנו הוא בגילוי עוד יותר."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ולהוסיף,"
        },
        {
          "s": 1,
          "text": "דמהביאורים בזה שמצות פרה אדומה היא כללות כל התורה"
        },
        {
          "s": 2,
          "text": "[שלכן נאמר בה זאת חוקת התורה],"
        },
        {
          "s": 3,
          "text": "הוא19,"
        },
        {
          "s": 4,
          "text": "כי היסוד דכל המצוות הוא שהם חוקה."
        },
        {
          "s": 5,
          "text": "היינו שהמצוות הם רצון העליון שלמעלה מהשכל,"
        },
        {
          "s": 6,
          "text": "ולכן,"
        },
        {
          "s": 7,
          "text": "גם קיומם צריך להיות בדרך קבלת עול,"
        },
        {
          "s": 8,
          "text": "חוקה20"
        },
        {
          "s": 9,
          "text": "חקקתי גזירה גזרתי."
        },
        {
          "s": 10,
          "text": "ועפ\"ז יובן עוד יותר21"
        },
        {
          "s": 11,
          "text": "זה שפרה אדומה נקראת על שמו של משה,"
        },
        {
          "s": 12,
          "text": "כי בכדי שקיום כל המצוות"
        },
        {
          "s": 13,
          "text": "(הגם שיש עליהם טעם22)"
        },
        {
          "s": 14,
          "text": "יהי' באופן דזאת חוקת התורה הוא ע\"י שהתורה"
        },
        {
          "s": 15,
          "text": "(ומצותי'),"
        },
        {
          "s": 16,
          "text": "גם לאחרי שנתלבשה בחכמה ושכל,"
        },
        {
          "s": 17,
          "text": "נקראת על שמו של משה,"
        },
        {
          "s": 18,
          "text": "שענינו הוא ביטול,"
        },
        {
          "s": 19,
          "text": "תורת משה עבדי,"
        },
        {
          "s": 20,
          "text": "ועי\"ז ישנה הנתינת כח לכל אחד מישראל"
        },
        {
          "s": 21,
          "text": "(ע\"י בחינת משה שבו23)"
        },
        {
          "s": 22,
          "text": "שקיום המצוות שלו יהי' בביטול דקבלת עול,"
        },
        {
          "s": 23,
          "text": "כקיום מצות פרה אדומה,"
        },
        {
          "s": 24,
          "text": "זאת חוקת התורה."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה איתא במדרש24"
        },
        {
          "s": 2,
          "text": "עה\"פ ויקחו אליך פרה אדומה,"
        },
        {
          "s": 3,
          "text": "א\"ל הקב\"ה למשה,"
        },
        {
          "s": 4,
          "text": "לך אני מגלה טעם פרה אבל לאחר חוקה."
        },
        {
          "s": 5,
          "text": "וצריך להבין דכיון שמשה השיג הטעם דכל המצוות,"
        },
        {
          "s": 6,
          "text": "גם הטעם דמצות פרה אדומה,"
        },
        {
          "s": 7,
          "text": "איך נמשך על ידו הנתינת כח לקיום המצוות באופן דחוקה חקקתי גזירה גזרתי."
        },
        {
          "s": 8,
          "text": "ולכאורה הי' אפשר לבאר ע\"פ מ\"ש במק\"א25,"
        },
        {
          "s": 9,
          "text": "שבכל מצוה ישנם שני הענינים דחוקים ומשפטים."
        },
        {
          "s": 10,
          "text": "כי כל המצוות"
        },
        {
          "s": 11,
          "text": "(גם המצוות דעדות ומשפטים שיש עליהם טעם)"
        },
        {
          "s": 12,
          "text": "הם רצונו ית',"
        },
        {
          "s": 13,
          "text": "ורצון הוא למעלה מטעם,"
        },
        {
          "s": 14,
          "text": "למעלה גם מהטעמים שבחכמתו ית',"
        },
        {
          "s": 15,
          "text": "ולאחרי שהרצון דמצוות"
        },
        {
          "s": 16,
          "text": "(גם המצוות דחוקים,"
        },
        {
          "s": 17,
          "text": "ואפילו מצות פרה אדומה)"
        },
        {
          "s": 18,
          "text": "נמשך ונתלבש בחכמה"
        },
        {
          "s": 19,
          "text": "(דתורה),"
        },
        {
          "s": 20,
          "text": "ניתוסף בהם טעם."
        },
        {
          "s": 21,
          "text": "והחילוק שבין המצוות דעדות ומשפטים להמצוות דחוקים הוא,"
        },
        {
          "s": 22,
          "text": "שבהמצוות דעדות ומשפטים,"
        },
        {
          "s": 23,
          "text": "הטעמים שבחכמתו ית' נמשכו ונתלבשו בשכל הנבראים ועד בשכל אנושי,"
        },
        {
          "s": 24,
          "text": "ובהמצוות דחוקים,"
        },
        {
          "s": 25,
          "text": "הטעמים שלהם לא נתלבשו"
        },
        {
          "s": 26,
          "text": "(כ\"כ)"
        },
        {
          "s": 27,
          "text": "בשכל הנבראים."
        },
        {
          "s": 28,
          "text": "והטעם דמצות פרה אדומה הוא בחכמתו ית'"
        },
        {
          "s": 29,
          "text": "(חכמה דאצילות)"
        },
        {
          "s": 30,
          "text": "ולא נמשך כלל בשכל הנבראים."
        },
        {
          "s": 31,
          "text": "[וזה שמשה השיג טעם פרה הוא לפי שגם בהיותו למטה הי' בחינת חכמה דאצילות בגילוי26]."
        }
      ]
    }
  ]
}