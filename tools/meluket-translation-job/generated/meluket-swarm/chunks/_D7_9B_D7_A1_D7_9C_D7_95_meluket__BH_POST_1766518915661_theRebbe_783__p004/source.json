{
  "globalIndex": 334,
  "owner": 34,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915661_theRebbe_783__p004",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915661_theRebbe_783__p004",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915661_theRebbe_783",
  "title": "מאמר פדה בשלום תשכ\"ו",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 2,
          "text": "דאיתא בגמרא37"
        },
        {
          "s": 3,
          "text": "שצדקה היא לעניים וגמילות חסדים היא בין לעניים בין לעשירים."
        },
        {
          "s": 4,
          "text": "ומזה"
        },
        {
          "s": 5,
          "text": "(שגמילות חסדים היא גם לעשירים)"
        },
        {
          "s": 6,
          "text": "מובן,"
        },
        {
          "s": 7,
          "text": "שההשפעה שמצד החסד היא למעלה ממדריגת עשיר."
        },
        {
          "s": 8,
          "text": "ולהעיר,"
        },
        {
          "s": 9,
          "text": "דלכאורה הי' אפשר לומר דהשפעת החסד לעשיר היא שמשפיעים לו עשירות גדולה יותר מהעשירות שהיתה לו מקודם."
        },
        {
          "s": 10,
          "text": "ומ\"ש בהמאמר שההשפעה שמצד החסד היא למעלה ממדריגת עשיר,"
        },
        {
          "s": 11,
          "text": "יש לומר,"
        },
        {
          "s": 12,
          "text": "דכשההשפעה שמשפיעים לו עכשיו הוא ענין שבערכו,"
        },
        {
          "s": 13,
          "text": "הרי,"
        },
        {
          "s": 14,
          "text": "כיון שמקודם הי' חסר הענין שמשפיעים לו"
        },
        {
          "s": 15,
          "text": "(אף שהענין הוא בערכו),"
        },
        {
          "s": 16,
          "text": "אינו"
        },
        {
          "s": 17,
          "text": "(אמיתית הענין ד)"
        },
        {
          "s": 18,
          "text": "עשיר."
        },
        {
          "s": 19,
          "text": "ולכן מבאר בהמאמר,"
        },
        {
          "s": 20,
          "text": "דגמ\"ח לעשירים היא שהשפע שמצד החסד היא למעלה ממדריגת עשיר,"
        },
        {
          "s": 21,
          "text": "היינו שהוא בסוג אחר לגמרי"
        },
        {
          "s": 22,
          "text": "(וזה שאין לו ענין שאינו בערכו כלל,"
        },
        {
          "s": 23,
          "text": "אינו חסרון בהעשירות שלו)."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ובכדי לבאר ענין החסד שלמעלה מעשירות,"
        },
        {
          "s": 2,
          "text": "מקדים בהמאמר ביאור ענין העשירות שהי' בימי שלמה"
        },
        {
          "s": 3,
          "text": "(דרגא הכי נעלית שבעשירות)."
        },
        {
          "s": 4,
          "text": "ומבאר,"
        },
        {
          "s": 5,
          "text": "דזה שבימי שלמה הוה קיימא סיהרא באשלמותא38,"
        },
        {
          "s": 6,
          "text": "הוא,"
        },
        {
          "s": 7,
          "text": "דנוסף לזה שנמשכו במלכות"
        },
        {
          "s": 8,
          "text": "(לבנה,"
        },
        {
          "s": 9,
          "text": "סיהרא)"
        },
        {
          "s": 10,
          "text": "ה' הפרצופים שנחסרו,"
        },
        {
          "s": 11,
          "text": "נמשך בה גם הגילוי דפנימיות הכתר,"
        },
        {
          "s": 12,
          "text": "עתיק."
        },
        {
          "s": 13,
          "text": "ומהעשירות דמלכות"
        },
        {
          "s": 14,
          "text": "(כנסת ישראל)"
        },
        {
          "s": 15,
          "text": "נמשכה עשירות מופלגה לישראל גם למטה,"
        },
        {
          "s": 16,
          "text": "עשירות מופלגה בגשמיות ועד שאין כסף נחשב בימי שלמה למאומה39,"
        },
        {
          "s": 17,
          "text": "ועשירות מופלגה ברוחניות,"
        },
        {
          "s": 18,
          "text": "שבימי שלמה דוקא נבנה בית המקדש,"
        },
        {
          "s": 19,
          "text": "דהגילוי שהי' בביהמ\"ק הוא גילוי נעלה יותר מהגילוי שהי' במשכן שהי' מקודם."
        },
        {
          "s": 20,
          "text": "ולהוסיף,"
        },
        {
          "s": 21,
          "text": "דזה שבימי שלמה הי' גילוי נעלה ביותר,"
        },
        {
          "s": 22,
          "text": "הוא גם לפני שנבנה ביהמ\"ק."
        },
        {
          "s": 23,
          "text": "שהרי זה שבנין ביהמ\"ק הי' ע\"י שלמה דוקא"
        },
        {
          "s": 24,
          "text": "[אף שתבנית המקדש נעשה ע\"י דוד40]"
        },
        {
          "s": 25,
          "text": "הוא כמ\"ש41"
        },
        {
          "s": 26,
          "text": "הוא"
        },
        {
          "s": 27,
          "text": "(שלמה)"
        },
        {
          "s": 28,
          "text": "יהי' איש מנוחה גו' ושלום ושקט אתן על ישראל בימיו"
        },
        {
          "s": 29,
          "text": "(ולכן)"
        },
        {
          "s": 30,
          "text": "הוא יבנה בית לשמי גו',"
        },
        {
          "s": 31,
          "text": "וידוע,"
        },
        {
          "s": 32,
          "text": "דזה שכל הגוים היו בטלים לשלמה"
        },
        {
          "s": 33,
          "text": "[שלכן הי' בימיו מנוחה ושלום]"
        },
        {
          "s": 34,
          "text": "הוא שהיו בטלים להגילוי דאוא\"ס שהאיר על ידו42."
        },
        {
          "s": 35,
          "text": "ועד\"ז הוא בנוגע לזה שבאו אליו מכל העמים לשמוע את חכמתו43,"
        },
        {
          "s": 36,
          "text": "דהטעם האמיתי על זה שבאו אליו הוא מפני שנמשכו לאלקות"
        },
        {
          "s": 37,
          "text": "(וע\"ד מ\"ש44"
        },
        {
          "s": 38,
          "text": "במשיח45"
        },
        {
          "s": 39,
          "text": "ונהרו אליו כל הגוים,"
        },
        {
          "s": 40,
          "text": "דזה שכולם יהיו נמשכים אליו הוא שיהיו נמשכים לאלקות)."
        },
        {
          "s": 41,
          "text": "כי הגילוי אור שהאיר אז,"
        },
        {
          "s": 42,
          "text": "משך אליו את הנצוצות שבהעמים,"
        },
        {
          "s": 43,
          "text": "בדוגמת אבוקה שמושכת אלי' כל הנצוצות46."
        },
        {
          "s": 44,
          "text": "וכיון שהגילוי שהאיר אז הי' גילוי נעלה ביותר,"
        },
        {
          "s": 45,
          "text": "לכן,"
        },
        {
          "s": 46,
          "text": "גם הנצוצות שבמקומות הרחוקים47"
        },
        {
          "s": 47,
          "text": "נמשכו להגילוי שהאיר ע\"י שלמה,"
        },
        {
          "s": 48,
          "text": "כמ\"ש48"
        },
        {
          "s": 49,
          "text": "ומלכת שבא שמעת את שמע שלמה לשם ה' גו' ותבא ירושלמה גו'."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "והנה זה ששלמה הי' איש מנוחה,"
        },
        {
          "s": 2,
          "text": "דהבירור שבימיו הי' בדרך מנוחה"
        },
        {
          "s": 3,
          "text": "[שלא הי' צריך למלחמה בכדי לברר את הנצוצות,"
        },
        {
          "s": 4,
          "text": "אלא שהנצוצות נמשכו אליו מעצמם,"
        },
        {
          "s": 5,
          "text": "שיתבררו],"
        },
        {
          "s": 6,
          "text": "הי' זה בעיקר ע\"י הגילוי שהאיר בבית המקדש."
        },
        {
          "s": 7,
          "text": "דהבירור ע\"י הגילוי שהאיר במשכן,"
        },
        {
          "s": 8,
          "text": "כולל גם הגילוי שהאיר בהארון שהי' במשכן,"
        },
        {
          "s": 9,
          "text": "הי' בדרך מלחמה,"
        },
        {
          "s": 10,
          "text": "והבירור ע\"י הגילוי שהאיר בביהמ\"ק הי' בדרך מנוחה."
        },
        {
          "s": 11,
          "text": "כדאיתא בזהר49,"
        },
        {
          "s": 12,
          "text": "תרין אינון הוו דאמרו קומה ה',"
        },
        {
          "s": 13,
          "text": "משה ודוד,"
        },
        {
          "s": 14,
          "text": "משה אמר50"
        },
        {
          "s": 15,
          "text": "קומה ה' ויפוצו אויביך,"
        },
        {
          "s": 16,
          "text": "ודוד אמר51"
        },
        {
          "s": 17,
          "text": "קומה ה' למנוחתך."
        },
        {
          "s": 18,
          "text": "ומבואר בהמאמר52,"
        },
        {
          "s": 19,
          "text": "דזה שהמשכן והארון היו מהלכים במדבר בכדי לבטל את הקליפות שהיו במדבר"
        },
        {
          "s": 20,
          "text": "(נחשים שרפים ועקרבים)"
        },
        {
          "s": 21,
          "text": "ולברר ולהעלות את הנצוצות דקדושה שנפלו לשם,"
        },
        {
          "s": 22,
          "text": "הוא בירור בדרך מלחמה."
        },
        {
          "s": 23,
          "text": "כמו מלך שיוצא ממקומו והולך למדינת האויב להלחם בו ולכובשו."
        },
        {
          "s": 24,
          "text": "ולכן אמר משה"
        },
        {
          "s": 25,
          "text": "[בנוגע לנסיעת הארון במדבר – ויהי בנסוע הארון]"
        },
        {
          "s": 26,
          "text": "קומה ה' ויפוצו אויביך,"
        },
        {
          "s": 27,
          "text": "דישנם אויבים שצריך ללחום בהם."
        },
        {
          "s": 28,
          "text": "והבירור ע\"י הגילוי שהאיר בביהמ\"ק הי' בדרך מנוחה,"
        },
        {
          "s": 29,
          "text": "דשלמה הי' במקומו והנצוצות נמשכו אליו מעצמם."
        },
        {
          "s": 30,
          "text": "ולכן אמר דוד קומה ה' למנוחתך."
        },
        {
          "s": 31,
          "text": "ולהעיר,"
        },
        {
          "s": 32,
          "text": "דבכ\"מ53"
        },
        {
          "s": 33,
          "text": "מבואר,"
        },
        {
          "s": 34,
          "text": "דהבירור שהי' ע\"י נסיעת הארון במדבר הוא בירור בדרך מנוחה."
        },
        {
          "s": 35,
          "text": "כי ענין המנוחה שמבואר שם הוא שהבירור הוא בדרך ממילא."
        },
        {
          "s": 36,
          "text": "וכיון דביטול הקליפות ובירור הנצוצות שנפלו בהם ע\"י הגילוי שהאיר במשכן הי' בדרך ממילא,"
        },
        {
          "s": 37,
          "text": "לכן,"
        },
        {
          "s": 38,
          "text": "גם הבירור שע\"י הארון דמשכן נק' בירור בדרך מנוחה."
        },
        {
          "s": 39,
          "text": "אבל אמיתית ענין המנוחה הוא שהמברר אינו יורד למקום המתברר אלא נמצא במקומו,"
        },
        {
          "s": 40,
          "text": "וע\"י הגילוי אור"
        },
        {
          "s": 41,
          "text": "(דהמברר)"
        },
        {
          "s": 42,
          "text": "שמאיר על המתברר,"
        },
        {
          "s": 43,
          "text": "הוא נמשך בעצמו להמברר."
        },
        {
          "s": 44,
          "text": "ומנוחה באופן זה היתה בימי שלמה דוקא."
        },
        {
          "s": 45,
          "text": "[וע\"ד הידוע54"
        },
        {
          "s": 46,
          "text": "בענין הבירור שע\"י תורה,"
        },
        {
          "s": 47,
          "text": "דבכללות,"
        },
        {
          "s": 48,
          "text": "גם הבירור שע\"י גליא דתורה הוא בדרך מנוחה."
        },
        {
          "s": 49,
          "text": "דכיון שהבירור הוא בדרך ממילא"
        },
        {
          "s": 50,
          "text": "(דע\"י שלומדים בתורה שדבר זה מותר ודבר זה אסור,"
        },
        {
          "s": 51,
          "text": "הם מתבררים ממילא."
        },
        {
          "s": 52,
          "text": "ולא כהבירור דתפלה שהוא ע\"י שנפש האלקית מתלבשת בנפש הבהמית),"
        },
        {
          "s": 53,
          "text": "לכן,"
        },
        {
          "s": 54,
          "text": "גם הבירור שע\"י גליא דתורה נק' בירור בדרך מנוחה."
        },
        {
          "s": 55,
          "text": "אבל בפרטיות,"
        },
        {
          "s": 56,
          "text": "כיון שהבירור ע\"י גליא דתורה הוא ע\"י שהיא יורדת ומתלבשת בענינים הגשמיים,"
        },
        {
          "s": 57,
          "text": "הרי זה ענין של מלחמה"
        },
        {
          "s": 58,
          "text": "[ע\"ד יציאת המלך ממקומו והליכתו למקום האויב],"
        },
        {
          "s": 59,
          "text": "ואמיתית הענין דבירור בדרך מנוחה הוא בהבירור שע\"י פנימיות התורה]."
        }
      ]
    }
  ]
}