{
  "globalIndex": 227,
  "owner": 27,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915124_theRebbe_182__p005",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915124_theRebbe_182__p005",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518915124_theRebbe_182",
  "title": "מאמר ויזרע יצחק בארץ תשכ\"ז",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "והטעם לזה"
        },
        {
          "s": 1,
          "text": "(שגם התעוררות מדות הטבעיות הוא דוקא ע\"י השכל)"
        },
        {
          "s": 2,
          "text": "הוא,"
        },
        {
          "s": 3,
          "text": "כי שרש האדם הוא בתיקון"
        },
        {
          "s": 4,
          "text": "[דשרש הבע\"ח הוא בתוהו ושרש האדם הוא בתיקון],"
        },
        {
          "s": 5,
          "text": "ובעולם התיקון העיקר הוא המוחין,"
        },
        {
          "s": 6,
          "text": "וגם המדות דתיקון הם ע\"פ המוחין."
        },
        {
          "s": 7,
          "text": "דהגם שגם בתיקון שרש המדות הוא למעלה משרש המוחין,"
        },
        {
          "s": 8,
          "text": "דאו\"א במזלא אתכלילו וז\"א בעתיקא אחיד ותליא39,"
        },
        {
          "s": 9,
          "text": "מ\"מ,"
        },
        {
          "s": 10,
          "text": "המשכתן הוא ע\"י המוחין."
        },
        {
          "s": 11,
          "text": "דמהחילוקים בין מדות דתהו למדות דתיקון הוא,"
        },
        {
          "s": 12,
          "text": "שבתוהו נתגלו המדות כמו שהן מצד שרשן בכתר"
        },
        {
          "s": 13,
          "text": "[דזהו אחד הביאורים בזה שהספירות דתוהו היו בבחינת כתרים40],"
        },
        {
          "s": 14,
          "text": "ומדות דתיקון הם ע\"פ המוחין41."
        },
        {
          "s": 15,
          "text": "ומזה נשתלשל גם באדם ששרשו הוא בתיקון,"
        },
        {
          "s": 16,
          "text": "שהמדות שלו"
        },
        {
          "s": 17,
          "text": "(גם מדות הטבעיות)"
        },
        {
          "s": 18,
          "text": "הם ע\"פ השכל."
        },
        {
          "s": 19,
          "text": "והחילוק בין מדות טבעיות למדות שכליות הוא,"
        },
        {
          "s": 20,
          "text": "שבמדות שכליות"
        },
        {
          "s": 21,
          "text": "(הגם ששרשן הוא בעצם הנפש למעלה מהשכל)"
        },
        {
          "s": 22,
          "text": "נרגש בעיקר שהם מדות של אדם"
        },
        {
          "s": 23,
          "text": "(מדות דתיקון)"
        },
        {
          "s": 24,
          "text": "שעיקרו הוא מוחין,"
        },
        {
          "s": 25,
          "text": "ובמדות טבעיות"
        },
        {
          "s": 26,
          "text": "(הגם שהתעוררותן הוא ע\"י השכל)"
        },
        {
          "s": 27,
          "text": "נרגש בעיקר השרש שלהם בעצם הנפש שלמעלה משכל."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "שבב' הלשונות לך וכל מרומזים גם שני הסוגים שבמדות"
        },
        {
          "s": 2,
          "text": "(מדות טבעיות ומדות שכליות)."
        },
        {
          "s": 3,
          "text": "והענין הוא,"
        },
        {
          "s": 4,
          "text": "דזה שנתבאר לעיל שהמדות כמו שהן בשרשן הן בביטול,"
        },
        {
          "s": 5,
          "text": "לך,"
        },
        {
          "s": 6,
          "text": "הכוונה היא"
        },
        {
          "s": 7,
          "text": "(בעיקר)"
        },
        {
          "s": 8,
          "text": "לזה ששרש המדות הוא בכתר"
        },
        {
          "s": 9,
          "text": "(ועד\"ז באדם,"
        },
        {
          "s": 10,
          "text": "זה ששרש המדות הוא בעצם הנפש),"
        },
        {
          "s": 11,
          "text": "דכיון שהכתר הוא מובדל מכל הספירות,"
        },
        {
          "s": 12,
          "text": "לכן,"
        },
        {
          "s": 13,
          "text": "כשהספירות"
        },
        {
          "s": 14,
          "text": "(המדות והמוחין)"
        },
        {
          "s": 15,
          "text": "כלולות בכתר,"
        },
        {
          "s": 16,
          "text": "הן בהעדר המציאות."
        },
        {
          "s": 17,
          "text": "משא\"כ בנוגע לזה שהמדות נמשכות מהשכל,"
        },
        {
          "s": 18,
          "text": "כיון שהשכל הוא עילה למדות,"
        },
        {
          "s": 19,
          "text": "לכן גם כשהמדות כלולות בשכל,"
        },
        {
          "s": 20,
          "text": "הן בבחינת מציאות."
        },
        {
          "s": 21,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 22,
          "text": "שמדות הטבעיות,"
        },
        {
          "s": 23,
          "text": "שנרגש בהם ששרשן הוא בעצם הנפש,"
        },
        {
          "s": 24,
          "text": "שייכים ללך,"
        },
        {
          "s": 25,
          "text": "ומדות השכליות שייכים לכל42."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וזהו הקשר והשייכות דוימצא מאה שערים לויזרע יצחק,"
        },
        {
          "s": 2,
          "text": "זריעת הכחות דנפש האלקית בנה\"ב"
        },
        {
          "s": 3,
          "text": "(ועד\"ז בעשיית המצוות),"
        },
        {
          "s": 4,
          "text": "כי המדות דנפש האלקית ששרשה בתיקון הם במדידה והגבלה לפי השכל,"
        },
        {
          "s": 5,
          "text": "והמדות דנפש הבהמית ששרשה בתוהו הם בתוקף בלתי מוגבל,"
        },
        {
          "s": 6,
          "text": "וע\"י זריעת המדות דנה\"א במדות דנה\"ב נמשכים מאה שערים,"
        },
        {
          "s": 7,
          "text": "שתי פעמים חמישים,"
        },
        {
          "s": 8,
          "text": "מדות דתיקון ומדות דתוהו."
        },
        {
          "s": 9,
          "text": "ויש לומר,"
        },
        {
          "s": 10,
          "text": "דמ\"ש וימצא מאה שערים,"
        },
        {
          "s": 11,
          "text": "דמציאה היא שלא לפי ערך העבודה,"
        },
        {
          "s": 12,
          "text": "הוא,"
        },
        {
          "s": 13,
          "text": "כי המדות דהנשמה הם באין ערוך לגבי שרשם43,"
        },
        {
          "s": 14,
          "text": "המדות דתיקון,"
        },
        {
          "s": 15,
          "text": "ומכ\"ש המדות דנה\"ב"
        },
        {
          "s": 16,
          "text": "(שהמדות שלה הם בתאוות עוה\"ז)"
        },
        {
          "s": 17,
          "text": "שהם באין ערוך לגבי שרשם במדות דתוהו."
        },
        {
          "s": 18,
          "text": "ולכן,"
        },
        {
          "s": 19,
          "text": "המשכת המאה שערים,"
        },
        {
          "s": 20,
          "text": "מדות דתיקון ומדות דתוהו,"
        },
        {
          "s": 21,
          "text": "ע\"י שהמדות דנפש האלקית מבררים המדות דנפש הבהמית,"
        },
        {
          "s": 22,
          "text": "הוא מציאה שלא לפי ערך העבודה44."
        }
      ]
    }
  ]
}