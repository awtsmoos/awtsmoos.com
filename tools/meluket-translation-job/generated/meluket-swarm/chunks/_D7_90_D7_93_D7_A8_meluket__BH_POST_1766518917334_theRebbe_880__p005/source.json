{
  "globalIndex": 616,
  "owner": 16,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917334_theRebbe_880__p005",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917334_theRebbe_880__p005",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917334_theRebbe_880",
  "title": "מאמר ואתה תצוה תשמ\"א",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "וצריך להבין,"
        },
        {
          "s": 1,
          "text": "דלפי ביאור הנ\"ל,"
        },
        {
          "s": 2,
          "text": "הענין דכתית למאור שייך לואתה תצוה את בני ישראל,"
        },
        {
          "s": 3,
          "text": "לזה שמשה ואתפשטותא דילי' שבכל דור מקשרים ומחברים את ישראל עם אוא\"ס,"
        },
        {
          "s": 4,
          "text": "ובהכתוב נאמר כתית למאור בהמשך לויקחו אליך שמן זית זך,"
        },
        {
          "s": 5,
          "text": "דענין ויקחו אליך גו'"
        },
        {
          "s": 6,
          "text": "(שישראל מביאים שמן למשה)"
        },
        {
          "s": 7,
          "text": "הוא שישראל מוסיפים תוספות אור במשה"
        },
        {
          "s": 8,
          "text": "(כמובא לעיל ס\"ב מהמאמר)."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "והנה הכתוב וקבל היהודים את אשר החלו לעשות מדבר"
        },
        {
          "s": 2,
          "text": "(בפשטות)"
        },
        {
          "s": 3,
          "text": "בהזמן שלאחרי הנס דפורים."
        },
        {
          "s": 4,
          "text": "ויש לומר,"
        },
        {
          "s": 5,
          "text": "דמ\"ש בהמאמר דפירוש וקבל היהודים את אשר החלו לעשות הוא שבימי אחשורוש קיבלו מה שהחלו במתן תורה,"
        },
        {
          "s": 6,
          "text": "הוא גם לפי פשטות הכתוב שוקבל גו' הי' לאחרי הנס."
        },
        {
          "s": 7,
          "text": "ועפ\"ז,"
        },
        {
          "s": 8,
          "text": "בזה שבימי אחשורוש קיבלו מה שהחלו במתן תורה,"
        },
        {
          "s": 9,
          "text": "שני ענינים."
        },
        {
          "s": 10,
          "text": "הקבלה שהיתה בזמן הגזירה ע\"י המס\"נ שלהם"
        },
        {
          "s": 11,
          "text": "(כמפורש בהמאמר),"
        },
        {
          "s": 12,
          "text": "והקבלה שהיתה לאחרי הנס דפורים,"
        },
        {
          "s": 13,
          "text": "שהיא נעלית יותר גם מהקבלה בזמן הגזירה"
        },
        {
          "s": 14,
          "text": "(כדלקמן)."
        },
        {
          "s": 15,
          "text": "ויש לומר,"
        },
        {
          "s": 16,
          "text": "שעד\"ז הוא בנוגע כתית למאור,"
        },
        {
          "s": 17,
          "text": "שע\"י הענין דכתית שבזמן הגלות מגיעים להמאור,"
        },
        {
          "s": 18,
          "text": "דשני ענינים בזה."
        },
        {
          "s": 19,
          "text": "כשישראל נמצאים במצב של כתית מצד זה שישנם גזירות על קיום התומ\"צ"
        },
        {
          "s": 20,
          "text": "(כמו שהי' בזמן אמירת המאמר),"
        },
        {
          "s": 21,
          "text": "ועי\"ז מגיעים להמאור ע\"י המס\"נ שלהם."
        },
        {
          "s": 22,
          "text": "ועוד ענין בכתית למאור,"
        },
        {
          "s": 23,
          "text": "שגם כשישראל נמצאים במצב של הרחבה,"
        },
        {
          "s": 24,
          "text": "הרחבה בגשמיות וגם הרחבה ברוחניות,"
        },
        {
          "s": 25,
          "text": "אלא שהם נמצאים בגלות41"
        },
        {
          "s": 26,
          "text": "[וע\"ד המצב שהי' לאחרי הנס דפורים,"
        },
        {
          "s": 27,
          "text": "שליהודים היתה אורה ושמחה וששון ויקר42,"
        },
        {
          "s": 28,
          "text": "בפשטות וגם ברוחניות43"
        },
        {
          "s": 29,
          "text": "[ויתירה מזה שגם בית המן ניתן לאסתר44,"
        },
        {
          "s": 30,
          "text": "שהי' אז גם המעלה דאתהפכא],"
        },
        {
          "s": 31,
          "text": "אלא שאכתי עבדי אחשורוש אנן45],"
        },
        {
          "s": 32,
          "text": "הם שבורים ונדכאים"
        },
        {
          "s": 33,
          "text": "(כתית)"
        },
        {
          "s": 34,
          "text": "מזה שהם בגלות."
        },
        {
          "s": 35,
          "text": "וע\"י הכתית דישראל מזה שנמצאים בגלות,"
        },
        {
          "s": 36,
          "text": "מגיעים להמאור."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "והענין הוא,"
        },
        {
          "s": 1,
          "text": "דזה שישראל הם שבורים מזה שהם בגלות"
        },
        {
          "s": 2,
          "text": "(גם כשיש להם הרחבה בגשמיות וברוחניות),"
        },
        {
          "s": 3,
          "text": "הוא,"
        },
        {
          "s": 4,
          "text": "כי רצונו האמיתי של כל אחד מישראל הוא שיהי' גילוי אלקות,"
        },
        {
          "s": 5,
          "text": "ועד שזה"
        },
        {
          "s": 6,
          "text": "(גילוי אלקות)"
        },
        {
          "s": 7,
          "text": "נוגע לעצם מציאותו,"
        },
        {
          "s": 8,
          "text": "ולכן,"
        },
        {
          "s": 9,
          "text": "זה שבזמן הגלות אין מאיר גילוי אלקות כמו שהי' בזמן הבית"
        },
        {
          "s": 10,
          "text": "[ובפרט כשמתבונן בזה שארז\"ל46"
        },
        {
          "s": 11,
          "text": "כל מי שלא נבנה ביהמ\"ק בימיו ה\"ז כאילו נחרב בימיו],"
        },
        {
          "s": 12,
          "text": "הנה מזה עצמו איז ער אינגאַנצן צוטרייסלט,"
        },
        {
          "s": 13,
          "text": "כתית."
        },
        {
          "s": 14,
          "text": "וגם כשהוא בדרגא נעלית ביותר שמאיר אצלו גילוי אלקות בדוגמת הגילוי שהי' בזמן הבית47,"
        },
        {
          "s": 15,
          "text": "מ\"מ,"
        },
        {
          "s": 16,
          "text": "מזה שבכללות העולם אין מאיר הגילוי,"
        },
        {
          "s": 17,
          "text": "מוכח,"
        },
        {
          "s": 18,
          "text": "שגם הגילוי שמאיר אצלו הוא גילוי מוגבל."
        },
        {
          "s": 19,
          "text": "דכשמאיר גילוי אוא\"ס הבל\"ג הגילוי הוא בכל מקום,"
        },
        {
          "s": 20,
          "text": "וכשישנו מקום אחד"
        },
        {
          "s": 21,
          "text": "(אפילו פינה נדחת)"
        },
        {
          "s": 22,
          "text": "שאין מאיר שם גילוי אלקות,"
        },
        {
          "s": 23,
          "text": "הוא מפני שהגילוי"
        },
        {
          "s": 24,
          "text": "(גם בהמקום שהוא מאיר)"
        },
        {
          "s": 25,
          "text": "הוא גילוי מוגבל."
        },
        {
          "s": 26,
          "text": "[וזהו מה שמובא במאמר אדמו\"ר הזקן48"
        },
        {
          "s": 27,
          "text": "דאיתא בתיקונים49"
        },
        {
          "s": 28,
          "text": "שאפילו אם הי' צדיק אחד חוזר בתשובה שלימה בדורו הי' בא משיח,"
        },
        {
          "s": 29,
          "text": "כי ע\"י תשובה שלימה ממשיכים גילוי אוא\"ס הבל\"ג,"
        },
        {
          "s": 30,
          "text": "וגילוי זה הוא בכל מקום]."
        },
        {
          "s": 31,
          "text": "ומזה שאין מאיר אצלו גילוי עצמות אוא\"ס,"
        },
        {
          "s": 32,
          "text": "הוא נשבר ונדכא,"
        },
        {
          "s": 33,
          "text": "כתית."
        },
        {
          "s": 34,
          "text": "[וע\"ד הידוע שחולה בגימטריא מ\"ט,"
        },
        {
          "s": 35,
          "text": "שגם כשמשיג מ\"ט שערי בינה אלא שחסר לו שער הנו\"ן,"
        },
        {
          "s": 36,
          "text": "הוא חולה50]."
        },
        {
          "s": 37,
          "text": "וידוע מ\"ש הצ\"צ51"
        },
        {
          "s": 38,
          "text": "שהי' נשמע ממורינו ורבינו נ\"ע"
        },
        {
          "s": 39,
          "text": "(אדמו\"ר הזקן)"
        },
        {
          "s": 40,
          "text": "איך וויל זע גאָר ניסט איך וויל ניט דאיין ג\"ע איך וויל ניט דאיין עוה\"ב כו' איך וויל מער ניט אַז דיך אַליין."
        },
        {
          "s": 41,
          "text": "וע\"י שהי' נשמע לשון זה מאדמו\"ר הזקן"
        },
        {
          "s": 42,
          "text": "[דפירוש הי' נשמע הוא שזה הי' לא רק בזמנים מיוחדים אלא שזה הי' דבר הרגיל],"
        },
        {
          "s": 43,
          "text": "ובפרט לאחרי שנתפרסם זה ע\"י הצ\"צ,"
        },
        {
          "s": 44,
          "text": "ניתן הכח לכאו\"א מישראל שעיקר רצונו יהי' גילוי העצמות,"
        },
        {
          "s": 45,
          "text": "ועד כדי כך,"
        },
        {
          "s": 46,
          "text": "שכשאין מאיר גילוי זה,"
        },
        {
          "s": 47,
          "text": "ומכש\"כ בזמן הגלות שאין מאיר אפילו הגילוי"
        },
        {
          "s": 48,
          "text": "(גילוי אור)"
        },
        {
          "s": 49,
          "text": "שהי' בזמן הבית,"
        },
        {
          "s": 50,
          "text": "הוא במצב דכתית,"
        },
        {
          "s": 51,
          "text": "ומבקש ג' פעמים בכל יום"
        },
        {
          "s": 52,
          "text": "(או יותר)"
        },
        {
          "s": 53,
          "text": "ותחזינה עינינו בשובך לציון ברחמים,"
        },
        {
          "s": 54,
          "text": "שאז יהי' גילוי אלקות ועד לגילוי העצמות."
        },
        {
          "s": 55,
          "text": "וזהו כתית למאור,"
        },
        {
          "s": 56,
          "text": "שע\"י הענין דכתית מזה שנמצאים בגלות מגיעים להמאור,"
        },
        {
          "s": 57,
          "text": "כי זה שהרצון דכל אחד מישראל הוא גילוי אלקות ועד שזה נוגע לעצם מציאותו"
        },
        {
          "s": 58,
          "text": "[שלכן הוא נשבר ונדכא"
        },
        {
          "s": 59,
          "text": "(כתית)"
        },
        {
          "s": 60,
          "text": "מזה שבזמן הגלות לא יש גילוי אלקות]"
        },
        {
          "s": 61,
          "text": "הוא מצד עצם הנשמה,"
        },
        {
          "s": 62,
          "text": "מאור שבנשמה,"
        },
        {
          "s": 63,
          "text": "שהתקשרותה באלקות היא התקשרות עצמית."
        }
      ]
    }
  ]
}