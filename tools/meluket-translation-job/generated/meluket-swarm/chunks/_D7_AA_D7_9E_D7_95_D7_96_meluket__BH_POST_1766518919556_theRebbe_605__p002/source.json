{
  "globalIndex": 976,
  "owner": 26,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919556_theRebbe_605__p002",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919556_theRebbe_605__p002",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919556_theRebbe_605",
  "title": "מאמר אלה מסעי תשי\"ג",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ולהבין כ\"ז צריך להקדים תחילה ביאור בקשת כנסת ישראל זכור הוי' מה הי' לנו הביטה וראה את חרפתינו4,"
        },
        {
          "s": 2,
          "text": "ופירש הבעש\"ט5"
        },
        {
          "s": 3,
          "text": "געדענק ג-ט וואָס עס איז געוואָרען פון אונזער מ\"ה שבנשמה,"
        },
        {
          "s": 4,
          "text": "קוק זיך צו און מאַך אונז זעענדיק אונזער אייגענע שאַנדע,"
        },
        {
          "s": 5,
          "text": "דזהו בקשת כנסת ישראל מהקב\"ה."
        },
        {
          "s": 6,
          "text": "וכמו כן יש בקשת זכירה מהקב\"ה לישראל,"
        },
        {
          "s": 7,
          "text": "וכדאיתא בזהר ר\"פ בחוקותי ע\"פ זה שהבקשה מלמעלה6"
        },
        {
          "s": 8,
          "text": "מכנסת ישראל היא ג\"כ בלשון זכור,"
        },
        {
          "s": 9,
          "text": "וכמ\"ש7"
        },
        {
          "s": 10,
          "text": "עמי זכר נא מה יעץ בלק מלך מואב ומה ענה אותו בלעם בן בעור גו',"
        },
        {
          "s": 11,
          "text": "ומסיים8"
        },
        {
          "s": 12,
          "text": "מה ה' דורש ממך גו' עשות משפט ואהבת חסד והצנע לכת עם אלקיך,"
        },
        {
          "s": 13,
          "text": "וכתיב9"
        },
        {
          "s": 14,
          "text": "זכור את בוראך בימי בחרותיך גו' עד אשר לא תחשך השמש גו',"
        },
        {
          "s": 15,
          "text": "ואיתא במדרש10"
        },
        {
          "s": 16,
          "text": "אמר להם הנביא לישראל זכרו את בוראכם עד שביהמ\"ק קיים שנקרא בית הבחירה,"
        },
        {
          "s": 17,
          "text": "עד שברית כהונה קיימת,"
        },
        {
          "s": 18,
          "text": "שנאמר11"
        },
        {
          "s": 19,
          "text": "ובחור אותו מכל שבטי ישראל לי לכהן,"
        },
        {
          "s": 20,
          "text": "עד שברית לוי' קיימת,"
        },
        {
          "s": 21,
          "text": "שנאמר12"
        },
        {
          "s": 22,
          "text": "כי בו בחר ה' אלקיך מכל שבטיך13."
        },
        {
          "s": 23,
          "text": "וזהו עד אשר לא תחשך השמש,"
        },
        {
          "s": 24,
          "text": "דתחשך השמש קאי על חורבן ביהמ\"ק,"
        },
        {
          "s": 25,
          "text": "וצ\"ל זכור את בוראיך בימי בחרותיך,"
        },
        {
          "s": 26,
          "text": "בזמן הבית שנקרא בית הבחירה14."
        },
        {
          "s": 27,
          "text": "וכיון שבזמן הבית לא קיימו בנ\"י הבקשה מלמעלה זכור את בוראך גו',"
        },
        {
          "s": 28,
          "text": "זכר נא גו' עשות משפט ואהבת חסד והצנע לכת עם אלקיך,"
        },
        {
          "s": 29,
          "text": "הנה זה הי' סיבת החורבן,"
        },
        {
          "s": 30,
          "text": "ובגלל זה מבקשים אנו בזמן הגלות זכור הוי' מה הי' לנו הביטה וראה את חרפתינו."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "וצריך להבין מהו ענין הזכרון למעלה שעל זה מבקשים זכור הוי' מה הי' לנו."
        },
        {
          "s": 1,
          "text": "דהנה,"
        },
        {
          "s": 2,
          "text": "זכרון ושכחה הוא ענין בלי גבול וגבול,"
        },
        {
          "s": 3,
          "text": "דענין השכחה הוא מצד הגבלה,"
        },
        {
          "s": 4,
          "text": "דכיון שהאדם הוא מוגבל,"
        },
        {
          "s": 5,
          "text": "ומצד זה כל עניניו הם בהגבלה,"
        },
        {
          "s": 6,
          "text": "לכן גם הרושם שעשה עליו הדבר שראה או ששמע הוא בהגבלה ומשום זה נפסק אח\"כ,"
        },
        {
          "s": 7,
          "text": "שזהו\"ע השכחה."
        },
        {
          "s": 8,
          "text": "משא\"כ ענין הזכרון הוא בלי גבול,"
        },
        {
          "s": 9,
          "text": "וכמו שרואים גם באדם,"
        },
        {
          "s": 10,
          "text": "שדבר שנוגע לו תוך תוכו ופנימיות נפשו,"
        },
        {
          "s": 11,
          "text": "היינו,"
        },
        {
          "s": 12,
          "text": "שהוא למעלה מהגבלותיו,"
        },
        {
          "s": 13,
          "text": "הרי הוא זוכר אותו תמיד."
        },
        {
          "s": 14,
          "text": "ולפי זה אינו מובן מהו תוכן הבקשה זכור הוי' גו',"
        },
        {
          "s": 15,
          "text": "הרי למעלה הוא בלי גבול,"
        },
        {
          "s": 16,
          "text": "ולמה צריך לבקש למעלה ענין הזכרון."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "אך הענין הוא,"
        },
        {
          "s": 2,
          "text": "דהנה,"
        },
        {
          "s": 3,
          "text": "זכרון ושכחה הו\"ע פנים ואחור15,"
        },
        {
          "s": 4,
          "text": "פנימיות וחיצוניות,"
        },
        {
          "s": 5,
          "text": "וכמו שהוא באדם למטה,"
        },
        {
          "s": 6,
          "text": "שדבר שנוגע לו בפנימיות הוא זוכר אותו תמיד,"
        },
        {
          "s": 7,
          "text": "משא\"כ דבר שנוגע לו רק בחיצוניות"
        },
        {
          "s": 8,
          "text": "(שהו\"ע אחור)"
        },
        {
          "s": 9,
          "text": "שייך שם ענין השכחה."
        },
        {
          "s": 10,
          "text": "וכמו\"כ יש גם למעלה בחינות פנים ימין שמאל ואחור,"
        },
        {
          "s": 11,
          "text": "כדאיתא ברמ\"ז16"
        },
        {
          "s": 12,
          "text": "שהם כנגד ד' עולמות אבי\"ע."
        },
        {
          "s": 13,
          "text": "דהנה,"
        },
        {
          "s": 14,
          "text": "עולם האצילות נקרא פנים,"
        },
        {
          "s": 15,
          "text": "דכשם שבפנים שבאדם ישנו פנימיות החיות,"
        },
        {
          "s": 16,
          "text": "כמו\"כ באצילות הוא פנימיות אוא\"ס,"
        },
        {
          "s": 17,
          "text": "ועד שאיהו וחיוהי וגרמוהי חד17."
        },
        {
          "s": 18,
          "text": "והיינו,"
        },
        {
          "s": 19,
          "text": "דאף שאצילות הוא לאחר הצמצום,"
        },
        {
          "s": 20,
          "text": "וכללות האור שלאחר הצמצום הוא בבחי' קו קצר ומצומצם,"
        },
        {
          "s": 21,
          "text": "מ\"מ,"
        },
        {
          "s": 22,
          "text": "הרי זה אותו מהות האור."
        },
        {
          "s": 23,
          "text": "וזהו ההפרש בין בי\"ע ואצילות,"
        },
        {
          "s": 24,
          "text": "דהתהוות בי\"ע היא ע\"י הפרסא,"
        },
        {
          "s": 25,
          "text": "משא\"כ התהוות האצילות היא לא ע\"י הפרסא אלא רק ע\"י הצמצום18,"
        },
        {
          "s": 26,
          "text": "כמ\"ש בע\"ח19."
        },
        {
          "s": 27,
          "text": "וההפרש בין צמצום ופרסא הוא כמשל ההפרש שאנו רואים למטה בין האור שמאיר דרך חלון או דרך נקב20,"
        },
        {
          "s": 28,
          "text": "דאף שהאור הוא במיעוט וצמצום,"
        },
        {
          "s": 29,
          "text": "שמאיר רק במדה כזו שהחלון או הנקב יכולים להכיל,"
        },
        {
          "s": 30,
          "text": "מ\"מ הרי הוא אותו מהות האור,"
        },
        {
          "s": 31,
          "text": "משא\"כ כאשר האור מאיר דרך מסך,"
        },
        {
          "s": 32,
          "text": "אזי האור הוא בשינוי המהות,"
        },
        {
          "s": 33,
          "text": "עד שהאור שבא אחרי המסך נקרא אור של תולדה."
        },
        {
          "s": 34,
          "text": "וכמו\"כ הוא למעלה,"
        },
        {
          "s": 35,
          "text": "שהתהוות בי\"ע שע\"י הפרסא הוא בשינוי המהות,"
        },
        {
          "s": 36,
          "text": "משא\"כ התהוות האצי' שע\"י צמצום,"
        },
        {
          "s": 37,
          "text": "הנה אף שהאור שם הוא בצמצום,"
        },
        {
          "s": 38,
          "text": "מ\"מ הרי הוא אותו מהות אור כמו קודם הצמצום."
        },
        {
          "s": 39,
          "text": "ואף שגם באצילות יש פרסאות21,"
        },
        {
          "s": 40,
          "text": "כידוע שיש פרסא בין כתר לחכמה,"
        },
        {
          "s": 41,
          "text": "בין בינה לז\"א ובין ז\"א למל',"
        },
        {
          "s": 42,
          "text": "מ\"מ22,"
        },
        {
          "s": 43,
          "text": "אינו דומה הפרסא שבאצילות להפרסאות דבי\"ע,"
        },
        {
          "s": 44,
          "text": "שהפרסאות דבי\"ע ענינם הוא להעלים והם מעלימים על האור,"
        },
        {
          "s": 45,
          "text": "משא\"כ הפרסאות שבאצילות הם מגלים את האור."
        },
        {
          "s": 46,
          "text": "דהנה,"
        },
        {
          "s": 47,
          "text": "פרסא הוא כמו עור,"
        },
        {
          "s": 48,
          "text": "ואמרו חז\"ל23"
        },
        {
          "s": 49,
          "text": "אלו שעורותיהן כבשרן עור האדם כו'"
        },
        {
          "s": 50,
          "text": "(שאינו כמו עור בהמה שהוא עור גס),"
        },
        {
          "s": 51,
          "text": "ודוגמתו למעלה הו\"ע הפרסאות שמגלים את האור."
        },
        {
          "s": 52,
          "text": "וזהו ההפרש בין אותיות דמ\"ה24"
        },
        {
          "s": 53,
          "text": "לאותיות דב\"ן"
        },
        {
          "s": 54,
          "text": "(וענינם בעבודה הוא ההפרש בין אותיות התורה לאותיות התפילה25),"
        },
        {
          "s": 55,
          "text": "דאותיות דב\"ן הם מעלימים על האור,"
        },
        {
          "s": 56,
          "text": "ומצד זה נעשים הנבראים בבחי' יש ודבר נפרד,"
        },
        {
          "s": 57,
          "text": "משא\"כ אותיות דמ\"ה אינם מעלימים על האור,"
        },
        {
          "s": 58,
          "text": "ואדרבה,"
        },
        {
          "s": 59,
          "text": "מגלים את האור,"
        },
        {
          "s": 60,
          "text": "ולכן הם פועלים ביטול בנבראים."
        },
        {
          "s": 61,
          "text": "וזהו שעורותיהן כבשרן עור האדם,"
        },
        {
          "s": 62,
          "text": "כי אדם בגימטריא מ\"ה26,"
        },
        {
          "s": 63,
          "text": "והו\"ע הפרסאות שמגלים את האור,"
        },
        {
          "s": 64,
          "text": "שהם הפרסאות שבאצילות,"
        },
        {
          "s": 65,
          "text": "שנקרא בשם מ\"ה,"
        },
        {
          "s": 66,
          "text": "כמ\"ש בפתח אלי'27"
        },
        {
          "s": 67,
          "text": "שם מ\"ה דאיהו אורח אצילות."
        },
        {
          "s": 68,
          "text": "וזהו שאצילות נקרא פנים לפי שמאיר שם גילוי אוא\"ס."
        },
        {
          "s": 69,
          "text": "ועיקר בחי' פנים הוא בחי' חכמה,"
        },
        {
          "s": 70,
          "text": "וע\"ד28"
        },
        {
          "s": 71,
          "text": "מ\"ש חכמת אדם תאיר פניו,"
        },
        {
          "s": 72,
          "text": "והיינו,"
        },
        {
          "s": 73,
          "text": "שבאצילות מאיר אור החכמה,"
        },
        {
          "s": 74,
          "text": "כמאמר29"
        },
        {
          "s": 75,
          "text": "אבא עילאה מקננא באצילות,"
        },
        {
          "s": 76,
          "text": "ובחכמה מאיר אוא\"ס,"
        },
        {
          "s": 77,
          "text": "כמ\"ש רבינו הזקן בתניא30"
        },
        {
          "s": 78,
          "text": "בשם מורו הה\"מ שמדריגת החכמה ענינה שהוא לבדו הוא ואין זולתו,"
        },
        {
          "s": 79,
          "text": "ולמעלה יותר,"
        },
        {
          "s": 80,
          "text": "שבאצילות מאיר אור הכתר,"
        },
        {
          "s": 81,
          "text": "שזהו\"ע שם מ\"ה שהוא במילוי אלפין,"
        },
        {
          "s": 82,
          "text": "ואל\"ף הוא ספי' הכתר31."
        },
        {
          "s": 83,
          "text": "וכיון שאצילות הוא בחי' פנים,"
        },
        {
          "s": 84,
          "text": "לא שייך שם ענין השכחה,"
        },
        {
          "s": 85,
          "text": "משא\"כ בבי\"ע שהוא בחי' אחור,"
        },
        {
          "s": 86,
          "text": "שייך שם ענין השכחה."
        },
        {
          "s": 87,
          "text": "והנה,"
        },
        {
          "s": 88,
          "text": "כל זה הוא ההפרש בעולמות,"
        },
        {
          "s": 89,
          "text": "משא\"כ נשמות ישראל הנה גם כמו שהם למטה הם בבחי' פנימיות,"
        },
        {
          "s": 90,
          "text": "דנשמות ישראל עלו במחשבה32,"
        },
        {
          "s": 91,
          "text": "היינו במדריגה היותר עליונה שבמחשבה33,"
        },
        {
          "s": 92,
          "text": "וכתיב34"
        },
        {
          "s": 93,
          "text": "פנים בפנים דיבר הוי' עמכם,"
        },
        {
          "s": 94,
          "text": "דעי\"ז שדיבר הוי' עמכם נעשה הפנימיות דישראל הפנימיות שלמעלה."
        },
        {
          "s": 95,
          "text": "אמנם,"
        },
        {
          "s": 96,
          "text": "כל זה הוא מצד הנשמה עצמה,"
        },
        {
          "s": 97,
          "text": "אבל מצד ירידתה למטה והתלבשותה בגוף ונה\"ב ובפרט בזמן הגלות,"
        },
        {
          "s": 98,
          "text": "הנה בזמן הגלות כתיב35"
        },
        {
          "s": 99,
          "text": "ואנכי הסתר אסתיר פני,"
        },
        {
          "s": 100,
          "text": "והיינו,"
        },
        {
          "s": 101,
          "text": "דכיון שפנו אלי עורף ולא פנים36,"
        },
        {
          "s": 102,
          "text": "היינו,"
        },
        {
          "s": 103,
          "text": "שהעבודה היתה בבחי' אחור,"
        },
        {
          "s": 104,
          "text": "לכן נעשה גם למעלה הסתר אסתיר פני,"
        },
        {
          "s": 105,
          "text": "ומצד זה צריך לבקש על ענין הזכרון,"
        },
        {
          "s": 106,
          "text": "זכור ה' מה הי' לנו."
        }
      ]
    }
  ]
}