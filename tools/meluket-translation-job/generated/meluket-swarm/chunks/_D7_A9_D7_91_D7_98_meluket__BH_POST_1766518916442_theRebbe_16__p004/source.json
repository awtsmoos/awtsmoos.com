  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916442_theRebbe_16__p004",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916442_theRebbe_16__p004",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916442_theRebbe_16",
  "title": "סקירה ע\"ד ס\"ת לקבלת פני משיח צדקנו",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ואכן באותו יום התחילה כתיבת ספר-התורה בחשאי,"
        },
        {
          "s": 1,
          "text": "כאמור במודעה מיוחדת,"
        },
        {
          "s": 2,
          "text": "מטעם \"ועד ספר תורה לקבלת פני משיח\"5,"
        },
        {
          "s": 3,
          "text": "ב\"הקריאה והקדושה\"6"
        },
        {
          "s": 4,
          "text": ": פאָרגעקומען לויט דעם רבי'נס"
        },
        {
          "s": 5,
          "text": "(שליט\"א)"
        },
        {
          "s": 6,
          "text": "[נ\"ע]"
        },
        {
          "s": 7,
          "text": "וואונש אָהן פרסום7."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "כתיבת ספר-התורה היתה ע\"ג קלף מיוחד של עור שחוטות וכשרות8."
        },
        {
          "s": 1,
          "text": "ועוד רצה כ\"ק אדמו\"ר מוהריי\"צ נ\"ע שהקלף יהי' מעובד בארה\"ק,"
        },
        {
          "s": 2,
          "text": "ופנה בבקשה זו במברק למוה\"ר שלמה יהודה ליב אליעזרוב9."
        },
        {
          "s": 3,
          "text": "ובאגרת מפורטת יותר אליו,"
        },
        {
          "s": 4,
          "text": "בב' מ\"ח10"
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "\"שלחתי תלגרמה לידידי שי' על אודות השגת קלף מעורות שחוטות וכשרות מעובדים לשמה – במדת ששה טפחים – בשביל לכתוב בעזה\"י ספר תורה לקבל בה את פני משיח צדקנו בקרוב ממש\"."
        }
      ]
    }
  ]
}