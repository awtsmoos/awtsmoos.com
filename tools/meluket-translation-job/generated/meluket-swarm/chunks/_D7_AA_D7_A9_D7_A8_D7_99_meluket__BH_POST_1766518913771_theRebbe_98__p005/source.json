{
  "globalIndex": 17,
  "owner": 17,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913771_theRebbe_98__p005",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913771_theRebbe_98__p005",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518913771_theRebbe_98",
  "title": "מאמר יו\"ט של ר\"ה תשל\"ג",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ואולי יש להוסיף,"
        },
        {
          "s": 2,
          "text": "דזה שארז\"ל שהטעם על זה שהאדם נברא בסוף הוא כדי שיכנס לסעודה מיד,"
        },
        {
          "s": 3,
          "text": "הכוונה בזה היא,"
        },
        {
          "s": 4,
          "text": "לא רק להעולם שהאדם צריך לעשותו דירה לו ית',"
        },
        {
          "s": 5,
          "text": "אלא גם להנתינת כח להאדם,"
        },
        {
          "s": 6,
          "text": "משביעין אותו מלשון שובע"
        },
        {
          "s": 7,
          "text": "(ענין סעודה),"
        },
        {
          "s": 8,
          "text": "שיוכל לעשות את העולם דירה לו ית'."
        },
        {
          "s": 9,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 10,
          "text": "דזה שהאדם הוא קדם למעשה בראשית והכל נברא בשבילו,"
        },
        {
          "s": 11,
          "text": "נכלל בזה גם השבועה."
        },
        {
          "s": 12,
          "text": "דהכוונה בהשבועה,"
        },
        {
          "s": 13,
          "text": "המשכת בחינת עתיק"
        },
        {
          "s": 14,
          "text": "[וי\"ל יתירה מזו,"
        },
        {
          "s": 15,
          "text": "גם הכוונה בבחינת עתיק עצמה],"
        },
        {
          "s": 16,
          "text": "היא בשביל עבודת האדם."
        },
        {
          "s": 17,
          "text": "וע\"י שהאדם יקיים את השבועה,"
        },
        {
          "s": 18,
          "text": "נעשה בה עילוי,"
        },
        {
          "s": 19,
          "text": "שנשלמת כוונת השבועה."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "והנה זה שנת\"ל"
        },
        {
          "s": 2,
          "text": "(סעיף ז)"
        },
        {
          "s": 3,
          "text": "שבראש השנה נמשכת נתינת כח להאדם לפעול בהעולם ולעשותו דירה לו ית',"
        },
        {
          "s": 4,
          "text": "יש לקשר עם המבואר בכ\"מ54,"
        },
        {
          "s": 5,
          "text": "שבתחלת הבריאה,"
        },
        {
          "s": 6,
          "text": "המשכת הרצון והתענוג בבריאת העולמות היתה מצד עצמו,"
        },
        {
          "s": 7,
          "text": "כי חפץ חסד הוא55,"
        },
        {
          "s": 8,
          "text": "והמשכת הרצון והתענוג בבריאת העולם עכשיו היא ע\"י עבודת האדם,"
        },
        {
          "s": 9,
          "text": "דיש לומר,"
        },
        {
          "s": 10,
          "text": "דחילוק זה הוא לא רק באופן ההמשכה"
        },
        {
          "s": 11,
          "text": "(אם ההמשכה היא מצד עצמה או שההמשכה היא ע\"י עבודת האדם)"
        },
        {
          "s": 12,
          "text": "אלא גם בהרצון והתענוג עצמם."
        },
        {
          "s": 13,
          "text": "דהרצון והתענוג שבבריאת העולמות שמצד חפץ חסד הוא בבריאת העולמות,"
        },
        {
          "s": 14,
          "text": "שעי\"ז מתגלה חסדו ית'56,"
        },
        {
          "s": 15,
          "text": "והרצון והתענוג שבבריאת העולמות שע\"י עבודת האדם הוא זה שנתאוה הקב\"ה להיות לו ית' דירה בתחתונים57"
        },
        {
          "s": 16,
          "text": "ושעשיית הדירה תהי' ע\"י עבודת האדם."
        },
        {
          "s": 17,
          "text": "וע\"י גילוי תענוג זה בבריאת העולמות,"
        },
        {
          "s": 18,
          "text": "שהכוונה דבריאת העולמות היא בשביל ישראל,"
        },
        {
          "s": 19,
          "text": "יש כח בהאדם"
        },
        {
          "s": 20,
          "text": "(אתם קרויין אדם)"
        },
        {
          "s": 21,
          "text": "לפעול בהבריאה ולעשות דירה לו ית'."
        },
        {
          "s": 22,
          "text": "דזה שנת\"ל שהנתינת כח להאדם לפעול בהבריאה הוא גילוי שרש הנשמה"
        },
        {
          "s": 23,
          "text": "(ענין השבועה),"
        },
        {
          "s": 24,
          "text": "הוא בנוגע להאדם."
        },
        {
          "s": 25,
          "text": "והפעולה שנעשית בהעולם ע\"י עבודת האדם"
        },
        {
          "s": 26,
          "text": "(שע\"י עבודת האדם נעשה העולם דירה לו ית')"
        },
        {
          "s": 27,
          "text": "הוא ע\"י גילוי כוונת הבריאה,"
        },
        {
          "s": 28,
          "text": "שבריאת העולם היא בשביל ישראל."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "ועפ\"ז יש לבאר שגם בראש השנה שחל להיות בשבת ישנה מעלת העבודה58,"
        },
        {
          "s": 3,
          "text": "כי הכוונה בהמשכת התענוג"
        },
        {
          "s": 4,
          "text": "[וגם בהתענוג עצמו]"
        },
        {
          "s": 5,
          "text": "היא בשביל האדם,"
        },
        {
          "s": 6,
          "text": "שע\"י התענוג תהי' נתינת כח לאדם לעשות את העולם דירה לו ית'"
        },
        {
          "s": 7,
          "text": "(וע\"ד שנת\"ל סעיף ח בענין השבועה),"
        },
        {
          "s": 8,
          "text": "דהנתינת כח להאדם הוא דוקא כשהמשכת התענוג הוא בגילוי."
        },
        {
          "s": 9,
          "text": "וכיון שגם בראש השנה שחל להיות בשבת גילוי התענוג הוא ע\"י אמירת פסוקי שופרות"
        },
        {
          "s": 10,
          "text": "(כמבואר לעיל סעיף ב מהמשך תרס\"ו),"
        },
        {
          "s": 11,
          "text": "נמצא,"
        },
        {
          "s": 12,
          "text": "שגם העבודה דאמירת פסוקי שופרות היא בנוגע לענין עיקרי."
        }
      ]
    }
  ]
}