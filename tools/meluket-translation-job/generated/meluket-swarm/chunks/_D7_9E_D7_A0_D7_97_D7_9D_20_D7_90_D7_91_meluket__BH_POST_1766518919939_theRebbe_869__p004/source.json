{
  "globalIndex": 1045,
  "owner": 45,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919939_theRebbe_869__p004",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919939_theRebbe_869__p004",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919939_theRebbe_869",
  "title": "מאמר ועתה ישראל תשכ\"ח",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וצריך להבין,"
        },
        {
          "s": 2,
          "text": "דבלימוד הנ\"ל,"
        },
        {
          "s": 3,
          "text": "בכדי שמה"
        },
        {
          "s": 4,
          "text": "(מלכות,"
        },
        {
          "s": 5,
          "text": "ממלא)"
        },
        {
          "s": 6,
          "text": "יהי' מאה"
        },
        {
          "s": 7,
          "text": "(אריך,"
        },
        {
          "s": 8,
          "text": "סובב)"
        },
        {
          "s": 9,
          "text": "הוא ע\"י האל\"ף"
        },
        {
          "s": 10,
          "text": "(עתיק)"
        },
        {
          "s": 11,
          "text": "שמוסיפים בו,"
        },
        {
          "s": 12,
          "text": "אבל מה מצד עצמו אין בו הענין דמאה,"
        },
        {
          "s": 13,
          "text": "גם לא בהעלם,"
        },
        {
          "s": 14,
          "text": "ומלשון רז\"ל אל תקרי מה אלא מאה,"
        },
        {
          "s": 15,
          "text": "שמאה הוא הקרי של הכתיב דמה"
        },
        {
          "s": 16,
          "text": "(דכתיב וקרי הוא העלם וגילוי35),"
        },
        {
          "s": 17,
          "text": "משמע,"
        },
        {
          "s": 18,
          "text": "שבמה עצמו יש הענין דמאה אלא שהוא בהעלם."
        },
        {
          "s": 19,
          "text": "גם צריך להבין מה שבפרשה ראשונה נאמר36"
        },
        {
          "s": 20,
          "text": "בכל לבבך ובכל נפשך ובכל מאדך ובפרשה שני' נאמר37"
        },
        {
          "s": 21,
          "text": "רק בכל לבבכם ובכל נפשכם,"
        },
        {
          "s": 22,
          "text": "דלכאורה,"
        },
        {
          "s": 23,
          "text": "כיון שבפרשה שני' מדבר באלה שצריך להזהיר אותם השמרו38"
        },
        {
          "s": 24,
          "text": "לכם פן יפתה לבבכם גו',"
        },
        {
          "s": 25,
          "text": "הרי בפרשה שני' נוגע יותר ענין המס\"נ,"
        },
        {
          "s": 26,
          "text": "ואעפ\"כ,"
        },
        {
          "s": 27,
          "text": "הענין דבכל מאדך"
        },
        {
          "s": 28,
          "text": "(שלכאורה הו\"ע המס\"נ)"
        },
        {
          "s": 29,
          "text": "נאמר בפרשה ראשונה דוקא."
        },
        {
          "s": 30,
          "text": "וי\"ל הביאור בזה,"
        },
        {
          "s": 31,
          "text": "שהענין דבכל מאדך כמו שהוא בציור דאהבה"
        },
        {
          "s": 32,
          "text": "(ואהבת גו' בכל מאדך),"
        },
        {
          "s": 33,
          "text": "כיון שענין האהבה הוא"
        },
        {
          "s": 34,
          "text": "(ככל המדות)"
        },
        {
          "s": 35,
          "text": "ההרגש שהוא אוהב,"
        },
        {
          "s": 36,
          "text": "אלא שהאהבה היא בלי גבול,"
        },
        {
          "s": 37,
          "text": "הוא הגילוי דעצם הנשמה כמו ששייכת לגילוי"
        },
        {
          "s": 38,
          "text": "(הרגש)."
        },
        {
          "s": 39,
          "text": "דהאהבה שמצד כחות הגלויים"
        },
        {
          "s": 40,
          "text": "(כולל גם האהבה שמצד המקיף דחי')"
        },
        {
          "s": 41,
          "text": "היא בהגבלה,"
        },
        {
          "s": 42,
          "text": "והאהבה דבכל מאדך שהיא בלי גבול היא מצד עצם הנשמה"
        },
        {
          "s": 43,
          "text": "(כמו ששייכת לגילוי)."
        },
        {
          "s": 44,
          "text": "והגילוי דעצם הנשמה שלמעלה משייכות לגילוי,"
        },
        {
          "s": 45,
          "text": "הוא בענין המס\"נ."
        },
        {
          "s": 46,
          "text": "דזה שכל אחד מישראל,"
        },
        {
          "s": 47,
          "text": "גם קל שבקלים,"
        },
        {
          "s": 48,
          "text": "מוסר נפשו על קידוש השם,"
        },
        {
          "s": 49,
          "text": "הוא לא מצד הרגש האהבה,"
        },
        {
          "s": 50,
          "text": "שהרי זה שהוא מוסר נפשו הוא לא מצד הרצון שלו39"
        },
        {
          "s": 51,
          "text": "אלא מפני שאינו יכול להפרד ח\"ו מאחדותו ית'40."
        },
        {
          "s": 52,
          "text": "ועד\"ז הוא בנוגע לקיום כל התרי\"ג מצוות שע\"י זכירת ענין המס\"נ,"
        },
        {
          "s": 53,
          "text": "דלאחרי שמתבונן"
        },
        {
          "s": 54,
          "text": "(ונרגש אצלו)"
        },
        {
          "s": 55,
          "text": "שע\"י כל עבירה נעשה נפרד מאחדותו ית' כמו בע\"ז,"
        },
        {
          "s": 56,
          "text": "זה שאינו עובר העבירה הוא מפני שאינו יכול להפרד ח\"ו מאחדותו ית'."
        },
        {
          "s": 57,
          "text": "ולכן לא נאמר בפרשה שני' דק\"ש בכל מאדך,"
        },
        {
          "s": 58,
          "text": "כי השמירה פן יפתה לבבכם גו' הוא"
        },
        {
          "s": 59,
          "text": "(לא ע\"י האהבה דבכל מאדך,"
        },
        {
          "s": 60,
          "text": "אלא)"
        },
        {
          "s": 61,
          "text": "ע\"י זכירת ענין המס\"נ שמצד זה אינו יכול לעבור על ציווי השם."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "וזהו41 ועתה ישראל מה הוי' אלקיך שואל מעמך,"
        },
        {
          "s": 2,
          "text": "מה הוא ביטול כמו ונחנו מה42,"
        },
        {
          "s": 3,
          "text": "והוא הביטול עצמי שמצד עצם הנשמה."
        },
        {
          "s": 4,
          "text": "ופירוש מה הוי' אלקיך שואל מעמך הוא שה' אלקיך שואל מעמך הביטול דמ\"ה."
        },
        {
          "s": 5,
          "text": "והגם שביטול זה"
        },
        {
          "s": 6,
          "text": "(שמצד עצם הנשמה)"
        },
        {
          "s": 7,
          "text": "הוא תמיד בשלימות,"
        },
        {
          "s": 8,
          "text": "הרי הביטול דמ\"ה שישנו בכאו\"א מישראל הוא בהעלם."
        },
        {
          "s": 9,
          "text": "וההעלם הוא לא רק מפני נפש הבהמית שמעלמת ומסתרת על זה,"
        },
        {
          "s": 10,
          "text": "אלא שגם מצד עצמו הוא נעלם,"
        },
        {
          "s": 11,
          "text": "להיותו למעלה מגילוי43,"
        },
        {
          "s": 12,
          "text": "וה' אלקיך שואל מעמך לגלות את המ\"ה."
        },
        {
          "s": 13,
          "text": "ובבקשה זו"
        },
        {
          "s": 14,
          "text": "(שה' אלקיך שואל לגלות את המ\"ה),"
        },
        {
          "s": 15,
          "text": "שני ענינים."
        },
        {
          "s": 16,
          "text": "לגלות את המ\"ה כמו שהוא ע\"י זכירת ענין המס\"נ."
        },
        {
          "s": 17,
          "text": "וגם לגלות אותו ע\"י מאה ברכות44"
        },
        {
          "s": 18,
          "text": "(כדרשת חז\"ל א\"ת מה אלא מאה),"
        },
        {
          "s": 19,
          "text": "החיבור דבחינת חי' עם בחינת נר\"נ,"
        },
        {
          "s": 20,
          "text": "שעי\"ז מתגלה המ\"ה דבחינת יחידה"
        },
        {
          "s": 21,
          "text": "(כי בכדי שיהי' החיבור דמקיף ופנימי הוא דוקא ע\"י העצם)."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יובן מה שמאה הוא הקרי דמה,"
        },
        {
          "s": 1,
          "text": "כי הביטול דמ\"ה שמצד עצם הנשמה הוא בחינת העלם שלמעלה מגילוי"
        },
        {
          "s": 2,
          "text": "(כתיב),"
        },
        {
          "s": 3,
          "text": "ומאה,"
        },
        {
          "s": 4,
          "text": "החיבור דחי' עם נר\"נ שנעשה ע\"י גילוי עצם הנשמה,"
        },
        {
          "s": 5,
          "text": "הוא הגילוי"
        },
        {
          "s": 6,
          "text": "(קרי)"
        },
        {
          "s": 7,
          "text": "דמה."
        },
        {
          "s": 8,
          "text": "[ויש להוסיף,"
        },
        {
          "s": 9,
          "text": "שגם האל\"ף דמה,"
        },
        {
          "s": 10,
          "text": "בחינת היחידה שעל ידה נעשה החיבור דחי' עם נר\"נ,"
        },
        {
          "s": 11,
          "text": "הוא למטה מבחינת מה."
        },
        {
          "s": 12,
          "text": "כי בחינת היחידה שעל ידה נעשה החיבור דחי' עם נר\"נ"
        },
        {
          "s": 13,
          "text": "(אל\"ף דמאה)"
        },
        {
          "s": 14,
          "text": "הוא העצם ששייך לכחות הגלויים,"
        },
        {
          "s": 15,
          "text": "והביטול דמ\"ה הוא מצד עצם הנשמה שלמעלה משייכות לגילוי]."
        }
      ]
    }
  ]
}