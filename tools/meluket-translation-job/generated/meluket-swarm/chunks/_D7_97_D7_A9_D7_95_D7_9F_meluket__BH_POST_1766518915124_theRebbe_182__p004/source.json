{
  "globalIndex": 226,
  "owner": 26,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915124_theRebbe_182__p004",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915124_theRebbe_182__p004",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518915124_theRebbe_182",
  "title": "מאמר ויזרע יצחק בארץ תשכ\"ז",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר11"
        },
        {
          "s": 2,
          "text": "עוד ביאור בחמישים שערי בינה שתי פעמים,"
        },
        {
          "s": 3,
          "text": "שהם בשני האופנים דמלמטה למעלה ומלמעלה למטה."
        },
        {
          "s": 4,
          "text": "וכמ\"ש30"
        },
        {
          "s": 5,
          "text": "לך הוי' הגדולה והגבורה והתפארת והנצח וההוד כי כל בשמים ובארץ,"
        },
        {
          "s": 6,
          "text": "\"לך\" בגימטריא נו\"ן ו\"כל\" בגימטריא נו\"ן31,"
        },
        {
          "s": 7,
          "text": "וקאי על ה' המדות"
        },
        {
          "s": 8,
          "text": "[גדולה גבורה תפארת נצח והוד שהם עיקרי המדות]"
        },
        {
          "s": 9,
          "text": "שכל אחת מהם כלולה מיו\"ד,"
        },
        {
          "s": 10,
          "text": "אלא שלך הוא מלמטה למעלה וכל מלמעלה למטה."
        },
        {
          "s": 11,
          "text": "דבעליית המדות לשרשם,"
        },
        {
          "s": 12,
          "text": "הם בביטול,"
        },
        {
          "s": 13,
          "text": "שאינם תופסים מקום,"
        },
        {
          "s": 14,
          "text": "לך."
        },
        {
          "s": 15,
          "text": "וכשהם נמשכים מלמעלה למטה"
        },
        {
          "s": 16,
          "text": "[ועד שנמשכים במדת היסוד,"
        },
        {
          "s": 17,
          "text": "כי כל בשמים ובארץ32,"
        },
        {
          "s": 18,
          "text": "שעי\"ז הם נמשכים אח\"כ במלכות,"
        },
        {
          "s": 19,
          "text": "לך ה' הממלכה גו']"
        },
        {
          "s": 20,
          "text": "הם בבחינת מציאות,"
        },
        {
          "s": 21,
          "text": "ויתירה מזו,"
        },
        {
          "s": 22,
          "text": "שהם נרגשים למציאות בשלימות,"
        },
        {
          "s": 23,
          "text": "ע\"ד יש לי כל33."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דכמו שבמוחין"
        },
        {
          "s": 2,
          "text": "(בינה),"
        },
        {
          "s": 3,
          "text": "ענין שתי פעמים חמישים הוא שתי מדריגות,"
        },
        {
          "s": 4,
          "text": "המוחין כמו ששייכים למדות"
        },
        {
          "s": 5,
          "text": "(מסטרא דיובלא)"
        },
        {
          "s": 6,
          "text": "ומוחין מצד עצמם,"
        },
        {
          "s": 7,
          "text": "עד\"ז הוא גם בנוגע לשתי פעמים חמישים דמדות,"
        },
        {
          "s": 8,
          "text": "דנוסף להביאור שהם שני אופנים מלמטה למעלה ומלמעלה למטה,"
        },
        {
          "s": 9,
          "text": "יש לומר,"
        },
        {
          "s": 10,
          "text": "שהם גם ב' מדריגות."
        },
        {
          "s": 11,
          "text": "המדות כמו שהם מצד עצמם,"
        },
        {
          "s": 12,
          "text": "וכמו שהם נמשכים ע\"י השכל."
        },
        {
          "s": 13,
          "text": "ובשתי הלשונות דלך וכל מרומזים שני האופנים שבמדות,"
        },
        {
          "s": 14,
          "text": "העלאה מלמטה למעלה והמשכה מלמעלה למטה"
        },
        {
          "s": 15,
          "text": "(כנ\"ל),"
        },
        {
          "s": 16,
          "text": "וגם ב' המדריגות שבמדות."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "והענין הוא,"
        },
        {
          "s": 1,
          "text": "דשרש המדות הוא בעצם הנפש למעלה משרש השכל,"
        },
        {
          "s": 2,
          "text": "אלא שהמשכתן הוא ע\"י השכל."
        },
        {
          "s": 3,
          "text": "ושני ענינים אלה – ששרש המדות הוא למעלה משרש השכל,"
        },
        {
          "s": 4,
          "text": "ושהמשכת המדות הוא ע\"י השכל – הם בכל המדות."
        },
        {
          "s": 5,
          "text": "והיינו,"
        },
        {
          "s": 6,
          "text": "שגם מדות השכליות,"
        },
        {
          "s": 7,
          "text": "שרשן הוא בעצם הנפש."
        },
        {
          "s": 8,
          "text": "שלכן,"
        },
        {
          "s": 9,
          "text": "גם המדות הנולדים מהשכל,"
        },
        {
          "s": 10,
          "text": "אפשר שיהיו בתוקף גדול הרבה יותר מהשכל המולידם34."
        },
        {
          "s": 11,
          "text": "ועד\"ז לאידך35,"
        },
        {
          "s": 12,
          "text": "שגם מדות הטבעיות שבאדם,"
        },
        {
          "s": 13,
          "text": "הן מתעוררות ע\"י השכל."
        },
        {
          "s": 14,
          "text": "וכידוע הראי' על זה36"
        },
        {
          "s": 15,
          "text": "ממ\"ש37"
        },
        {
          "s": 16,
          "text": "אל ירך לבבכם אל תיראו גו',"
        },
        {
          "s": 17,
          "text": "דלכאורה,"
        },
        {
          "s": 18,
          "text": "הרי היראה במלחמה היא דבר טבעי ואיך שייך ציווי על זה אל תיראו,"
        },
        {
          "s": 19,
          "text": "והביאור בזה,"
        },
        {
          "s": 20,
          "text": "דכיון שהתעוררות מדות הטבעיות הוא ע\"י השכל,"
        },
        {
          "s": 21,
          "text": "לכן,"
        },
        {
          "s": 22,
          "text": "כשישים דעתו ומחשבתו בזה,"
        },
        {
          "s": 23,
          "text": "לא ירך לבבו ולא יראה ויפחד כלל."
        },
        {
          "s": 24,
          "text": "וכמ\"ש הרמב\"ם38"
        },
        {
          "s": 25,
          "text": "וכל המתחיל לחשוב ולהרהר במלחמה ומבהיל עצמו עובר בלא תעשה,"
        },
        {
          "s": 26,
          "text": "שנאמר אל ירך לבבכם אל תיראו גו',"
        },
        {
          "s": 27,
          "text": "דגם יראה טבעית מתעוררת ופועלת כשמחשב ומהרהר בה."
        }
      ]
    }
  ]
}