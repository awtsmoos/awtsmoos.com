{
  "globalIndex": 134,
  "owner": 34,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914464_theRebbe_108__p002",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914464_theRebbe_108__p002",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914464_theRebbe_108",
  "title": "מאמר אתה הראת לדעת תשל\"ז",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה בההתאחדות של כל הסוגים דישראל בר\"ה,"
        },
        {
          "s": 2,
          "text": "שני ענינים20."
        },
        {
          "s": 3,
          "text": "שבכל אחד יש מעלה דילי',"
        },
        {
          "s": 4,
          "text": "ומשלימים זה את זה."
        },
        {
          "s": 5,
          "text": "וזה שיש מעלה בדרגות התחתונות לגבי ראשיכם יש לקשר עם הא דנעוץ סופן בתחילתן21,"
        },
        {
          "s": 6,
          "text": "שדוקא דרגות התחתונות"
        },
        {
          "s": 7,
          "text": "(סופן)"
        },
        {
          "s": 8,
          "text": "הן נעוצות בהתחילה"
        },
        {
          "s": 9,
          "text": "(היינו ששרשם הוא בהתחילה שלפני סדר ההשתלשלות,"
        },
        {
          "s": 10,
          "text": "דהמעלה שבראשיכם הוא שהם ההתחלה והראש דסדר ההשתלשלות,"
        },
        {
          "s": 11,
          "text": "והשרש דדרגות התחתונות"
        },
        {
          "s": 12,
          "text": "(סופן)"
        },
        {
          "s": 13,
          "text": "הוא בתחילה שלפני סדר ההשתלשלות22)."
        },
        {
          "s": 14,
          "text": "ועוד ענין בהאחדות דישראל שבר\"ה,"
        },
        {
          "s": 15,
          "text": "שכל ישראל הם קומה אחת,"
        },
        {
          "s": 16,
          "text": "ענין אחד שלמעלה מהתחלקות,"
        },
        {
          "s": 17,
          "text": "שאין בו ראש וסוף."
        },
        {
          "s": 18,
          "text": "וכמ\"ש23"
        },
        {
          "s": 19,
          "text": "ויהי בישורון מלך,"
        },
        {
          "s": 20,
          "text": "דזה שישראל נק' בשם ישורון מלשון שיר הוא לפי שהם כמו העיגול"
        },
        {
          "s": 21,
          "text": "(שיר הוא דבר עגול24)"
        },
        {
          "s": 22,
          "text": "שאין בו ראש וסוף."
        },
        {
          "s": 23,
          "text": "ועד\"ז הוא בהשמחה והריקודים דהקפות דשמע\"צ ושמח\"ת,"
        },
        {
          "s": 24,
          "text": "שיש בהם דוגמת שני ענינים הנ\"ל."
        },
        {
          "s": 25,
          "text": "דזה שהריקוד הוא ברגלים והרגלים מנשאים ומגביהים את הראש הוא מפני שנעוץ סופן בתחילתן,"
        },
        {
          "s": 26,
          "text": "היינו שיש התחלקות דראש ורגל וברגל יש ענין שהוא למעלה מהראש25."
        },
        {
          "s": 27,
          "text": "וזה שאופן השמחה דשמח\"ת היא"
        },
        {
          "s": 28,
          "text": "(לא ע\"י לימוד ועיון אלא)"
        },
        {
          "s": 29,
          "text": "שלוקחים ספר תורה כפי שהיא כרוכה ומכוסה במפה ומרקדין עמה,"
        },
        {
          "s": 30,
          "text": "הוא מפני שהשמחה דשמח\"ת קשורה עם התורה כפי שהיא למעלה מגילוי,"
        },
        {
          "s": 31,
          "text": "המקיף דתורה"
        },
        {
          "s": 32,
          "text": "(שאינו יכול להתלבש בחכמה),"
        },
        {
          "s": 33,
          "text": "כתר תורה26,"
        },
        {
          "s": 34,
          "text": "דמקיף אין בו ראש וסוף."
        },
        {
          "s": 35,
          "text": "ועפ\"ז יש לבאר השייכות דהפסוק אתה הראת להשמחה דהקפות,"
        },
        {
          "s": 36,
          "text": "כי בפסוק אתה הראת דוגמת שני ענינים אלה,"
        },
        {
          "s": 37,
          "text": "כדלקמן."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים שבהחילוק שבין אתה לשון נוכח"
        },
        {
          "s": 2,
          "text": "(גילוי)"
        },
        {
          "s": 3,
          "text": "והוא לשון נסתר"
        },
        {
          "s": 4,
          "text": "(העלם),"
        },
        {
          "s": 5,
          "text": "שני פירושים."
        },
        {
          "s": 6,
          "text": "שאתה הוא למטה מהוא27."
        },
        {
          "s": 7,
          "text": "דהוא לשון נסתר הוא האור שלמעלה מגילוי"
        },
        {
          "s": 8,
          "text": "[דבכללות הוא אור הסובב שהשפעתו בעולמות אינה בגילוי אלא בהסתר והעלם28]"
        },
        {
          "s": 9,
          "text": "ואתה לשון נוכח"
        },
        {
          "s": 10,
          "text": "(גילוי)"
        },
        {
          "s": 11,
          "text": "הוא אור הממלא שהוא בגילוי בעולמות."
        },
        {
          "s": 12,
          "text": "ואתה הוא למעלה מהוא."
        },
        {
          "s": 13,
          "text": "כידוע בענין אתה29"
        },
        {
          "s": 14,
          "text": "הוא הוי' לבדך30,"
        },
        {
          "s": 15,
          "text": "שהוא קאי על האור שלמעלה מגילוי,"
        },
        {
          "s": 16,
          "text": "ואתה הוא העצמות,"
        },
        {
          "s": 17,
          "text": "שהוא בכל מקום בהתגלות,"
        },
        {
          "s": 18,
          "text": "דשם שמים שגור בפי כל."
        },
        {
          "s": 19,
          "text": "וכן הוא גם באתה הראת לדעת,"
        },
        {
          "s": 20,
          "text": "דשני פירושים בזה."
        },
        {
          "s": 21,
          "text": "דבלקו\"ת ד\"ה וידעת31"
        },
        {
          "s": 22,
          "text": "מבואר דמ\"ש32"
        },
        {
          "s": 23,
          "text": "וידעת היום והשבות אל לבבך כי הוי' הוא האלקים גו',"
        },
        {
          "s": 24,
          "text": "אף שכבר נאמר אתה הראת לדעת כי הוי' הוא האלקים גו',"
        },
        {
          "s": 25,
          "text": "הוא,"
        },
        {
          "s": 26,
          "text": "כי זה שאתה הראת לדעת הוא הידיעה בממלא כל עלמין33,"
        },
        {
          "s": 27,
          "text": "והציווי וידעת גו' הוא שתהי' הידיעה בסובב כל עלמין."
        },
        {
          "s": 28,
          "text": "ובכ\"מ מבואר שאתה הראת לדעת קאי על העצמות."
        },
        {
          "s": 29,
          "text": "וכפירוש אדמו\"ר הזקן34"
        },
        {
          "s": 30,
          "text": "אתה דו עצמות א\"ס ב\"ה הראת האָסט זיך באַוויזן לדעת אַז מען זאָל דיך וויסן."
        },
        {
          "s": 31,
          "text": "דזה שהעצמות הוא בהתגלות"
        },
        {
          "s": 32,
          "text": "(שלכן אומרים עליו אתה לשון נוכח)"
        },
        {
          "s": 33,
          "text": "הוא שהוא בהתגלות כמו שהוא בעצמותו35,"
        },
        {
          "s": 34,
          "text": "וזה שכולם יודעים שיש אלוקה מצוי36"
        },
        {
          "s": 35,
          "text": "אין זה ידיעה והשגה."
        },
        {
          "s": 36,
          "text": "וזה שאפשר להיות ידיעה והשגה באלקות הוא ע\"י שהתגלות העצמות בשעת מ\"ת"
        },
        {
          "s": 37,
          "text": "(אתה הראת)"
        },
        {
          "s": 38,
          "text": "היתה באופן דלדעת,"
        },
        {
          "s": 39,
          "text": "שיוכל להיות ידיעה באלקות בכלל,"
        },
        {
          "s": 40,
          "text": "ויתירה מזו,"
        },
        {
          "s": 41,
          "text": "שעי\"ז יהי' אפשר להיות ידיעה בהעצמות,"
        },
        {
          "s": 42,
          "text": "אַז מען זאָל דיך וויסן."
        },
        {
          "s": 43,
          "text": "וממשיך בכתוב כי הוי' הוא האלקים אין עוד מלבדו,"
        },
        {
          "s": 44,
          "text": "שהידיעה בו ית'"
        },
        {
          "s": 45,
          "text": "(עי\"ז שאתה הראת לדעת)"
        },
        {
          "s": 46,
          "text": "היא בשני ענינים,"
        },
        {
          "s": 47,
          "text": "שהוי' הוא האלקים ושאין עוד מלבדו."
        },
        {
          "s": 48,
          "text": "וצריך להבין,"
        },
        {
          "s": 49,
          "text": "הרי הוי' ואלקים הם שמות,"
        },
        {
          "s": 50,
          "text": "דשם הוא רק הארה,"
        },
        {
          "s": 51,
          "text": "ומהי השייכות של הידיעה שהוי' הוא האלקים לאתה הראת לדעת אַז מען זאָל דיך וויסן."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ויובן זה ע\"פ המבואר בהדרושים עה\"פ אתה הראת37"
        },
        {
          "s": 2,
          "text": "דענין אתה הראת לדעת הוא זה שהוא ית' האציל ענין הידיעה בעצמותו בכדי שעי\"ז יוכל להיות בנבראים ידיעה באלקות."
        },
        {
          "s": 3,
          "text": "והנה בכ\"מ38"
        },
        {
          "s": 4,
          "text": "מבואר שהטעם להאצלת הע\"ס דאצילות הוא בכדי שעל ידם יהי' גילוי אלקות בעולם."
        },
        {
          "s": 5,
          "text": "כי עיקר הגילוי אלקות שבעולם"
        },
        {
          "s": 6,
          "text": "(בפנימיות)"
        },
        {
          "s": 7,
          "text": "הוא בעיקר בהמוחין ומדות שבהנבראים,"
        },
        {
          "s": 8,
          "text": "זה שהנבראים יכולים לידע ולהשיג אלקות ולהתפעל מזה."
        },
        {
          "s": 9,
          "text": "וענין זה נמשך מהע\"ס דאצילות."
        },
        {
          "s": 10,
          "text": "דע\"י שנעשה כביכול באלקות"
        },
        {
          "s": 11,
          "text": "(אצילות)"
        },
        {
          "s": 12,
          "text": "הציור דמוחין ומדות,"
        },
        {
          "s": 13,
          "text": "עי\"ז נמשך גם בהנבראים"
        },
        {
          "s": 14,
          "text": "(ששרשם הוא מהע\"ס דאצילות)"
        },
        {
          "s": 15,
          "text": "הידיעה וההתפעלות באלקות."
        },
        {
          "s": 16,
          "text": "דההתפעלות באלקות שבנבראים נמשך מהמדות דאצילות,"
        },
        {
          "s": 17,
          "text": "והידיעה וההשגה באלקות שבנבראים נמשך מהמוחין דאצילות."
        },
        {
          "s": 18,
          "text": "וזה שמבואר בהדרושים ע\"פ אתה הראת לדעת שבכדי שתהי' בנבראים ידיעה באלקות האציל ענין הידיעה בעצמותו"
        },
        {
          "s": 19,
          "text": "(אף שבכדי שתהי' בנבראים ידיעה באלקות הי' מספיק לכאורה הידיעה בחב\"ד דאצילות),"
        },
        {
          "s": 20,
          "text": "יש לומר,"
        },
        {
          "s": 21,
          "text": "שזהו בכדי שתהי' ידיעה כביכול גם בהעצמות,"
        },
        {
          "s": 22,
          "text": "מען זאָל דיך וויסן."
        },
        {
          "s": 23,
          "text": "דע\"י שהידיעה דחב\"ד דאצילות נמשכה מענין הידיעה בעצמותו,"
        },
        {
          "s": 24,
          "text": "לכן,"
        },
        {
          "s": 25,
          "text": "הידיעה באלקות של הנבראים שנמשכת מחב\"ד דאצילות,"
        },
        {
          "s": 26,
          "text": "היא שייכת גם לאוא\"ס שלמעלה מאצילות,"
        },
        {
          "s": 27,
          "text": "ועד לידיעת העצמות."
        }
      ]
    }
  ]
}