  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917845_theRebbe_238__p003",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917845_theRebbe_238",
  "title": "מאמר מצה זו תשמ\"ט",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ויהי רצון,"
        },
        {
          "s": 2,
          "text": "ובפרט שמסיימים"
        },
        {
          "s": 3,
          "text": "(כנהוג)"
        },
        {
          "s": 4,
          "text": "בנתינת צדקה25,"
        },
        {
          "s": 5,
          "text": "ע\"ד שהסיום דכל ימי הפסח הוא בשביעי של פסח,"
        },
        {
          "s": 6,
          "text": "ויתירה מזו שהסיום דכל ימי הפסח"
        },
        {
          "s": 7,
          "text": "(בחו\"ל)"
        },
        {
          "s": 8,
          "text": "הוא באחרון של פסח שבו מאיר גילוי הארת המשיח26,"
        },
        {
          "s": 9,
          "text": "שלכן גם ההפטרה דאחש\"פ היא בביאת המשיח"
        },
        {
          "s": 10,
          "text": "[ויש לקשר זה גם עם שמיני של פסח,"
        },
        {
          "s": 11,
          "text": "כי בההפטרה כתיב27"
        },
        {
          "s": 12,
          "text": "ביום ההוא יוסיף אד' שנית ידו לקנות את שאר עמו אשר ישאר מז' מקומות של גלות"
        },
        {
          "s": 13,
          "text": "(אשור,"
        },
        {
          "s": 14,
          "text": "מצרים וכו' והשמיני איי הים)"
        },
        {
          "s": 15,
          "text": "ויביאם למצב של שמיני – המצב דגאולה האמיתית והשלימה],"
        },
        {
          "s": 16,
          "text": "ויקויים היעוד28"
        },
        {
          "s": 17,
          "text": "בפשטות ובכל הפרטים וגם בפנימיות מלאה הארץ דעה את הוי' כמים29"
        },
        {
          "s": 18,
          "text": "לים מכסים30."
        }
      ]
    }
  ]
}