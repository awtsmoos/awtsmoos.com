{
  "globalIndex": 829,
  "owner": 29,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918708_theRebbe_155__p005",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918708_theRebbe_155__p005",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918708_theRebbe_155",
  "title": "מאמר בשעה שעלה משה למרום תשכ\"ה",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וביאור הענין דג' מדריגות הנ\"ל באוא\"ס שלמעלה מע\"ס הגנוזות"
        },
        {
          "s": 2,
          "text": "[לאחרי שעלה ברצונו שיהי' תפיסת מקום להעלאת מ\"ן"
        },
        {
          "s": 3,
          "text": "[שגם דרגא זו היא למעלה מע\"ס הגנוזות,"
        },
        {
          "s": 4,
          "text": "כיון שע\"ס הגנוזות הם \"הפנים\" שנעשו באוא\"ס ע\"י"
        },
        {
          "s": 5,
          "text": "(לאחרי)"
        },
        {
          "s": 6,
          "text": "העלאת מ\"ן],"
        },
        {
          "s": 7,
          "text": "כמו שהוא מצד עצמו"
        },
        {
          "s": 8,
          "text": "(לפני עליית רצון הנ\"ל)"
        },
        {
          "s": 9,
          "text": "שבדרגא זו אין שייך העלאת מ\"ן,"
        },
        {
          "s": 10,
          "text": "ועצמות אוא\"ס ששם מושרש הענין דהעלאת מ\"ן]"
        },
        {
          "s": 11,
          "text": "בפרטיות יותר,"
        },
        {
          "s": 12,
          "text": "יובן בהקדים אופן ההעלם דע\"ס הגנוזות47."
        },
        {
          "s": 13,
          "text": "דבהעלם יש שני אופנים48,"
        },
        {
          "s": 14,
          "text": "העלם שישנו במציאות,"
        },
        {
          "s": 15,
          "text": "כמו אש שבתוך הגחלת,"
        },
        {
          "s": 16,
          "text": "שעם היותו נעלם ומכוסה בהגחלת הוא מציאות אש,"
        },
        {
          "s": 17,
          "text": "ולכן בכדי לגלות אותו מהעלמו אין צריך לטירחא"
        },
        {
          "s": 18,
          "text": "(דע\"י שנופחים בהגחלת מתגלה האש)."
        },
        {
          "s": 19,
          "text": "והעלם שאינו במציאות,"
        },
        {
          "s": 20,
          "text": "כמו אש שבצור החלמיש,"
        },
        {
          "s": 21,
          "text": "שאינו מציאות אש ורק כח האש,"
        },
        {
          "s": 22,
          "text": "ולכן,"
        },
        {
          "s": 23,
          "text": "הוצאת אש מהצור היא ע\"י הכאה,"
        },
        {
          "s": 24,
          "text": "בטירחא ויגיעה."
        },
        {
          "s": 25,
          "text": "ובכחות הנפש הוא החילוק בין כחות הנעלמים לכחות הכלולים בנפש."
        },
        {
          "s": 26,
          "text": "שההעלם דכחות הנעלמים,"
        },
        {
          "s": 27,
          "text": "כמו כח המשכיל,"
        },
        {
          "s": 28,
          "text": "הוא העלם שישנו במציאות,"
        },
        {
          "s": 29,
          "text": "וההעלם דכחות הכלולים בנפש,"
        },
        {
          "s": 30,
          "text": "כמו כח השכל ההיולי העצמי,"
        },
        {
          "s": 31,
          "text": "הוא העלם שאינו במציאות."
        },
        {
          "s": 32,
          "text": "וההעלם דע\"ס הגנוזות הוא העלם שאינו במציאות49."
        },
        {
          "s": 33,
          "text": "כי זה שהע\"ס שלמעלה מאצילות הן גנוזות ונעלמות הוא לפי שהן כלולות באוא\"ס,"
        },
        {
          "s": 34,
          "text": "ע\"ד התכללות הכחות בנפש,"
        },
        {
          "s": 35,
          "text": "וההעלם דכחות הכלולים בנפש הוא העלם שאינו במציאות,"
        },
        {
          "s": 36,
          "text": "כנ\"ל."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "והנה גם העלם שאינו במציאות הוא איזה מציאות,"
        },
        {
          "s": 1,
          "text": "אלא שהמציאות שלו היא זה שהוא מקור למציאות."
        },
        {
          "s": 2,
          "text": "וכמו כח האש שבצור החלמיש,"
        },
        {
          "s": 3,
          "text": "שהוא כח ומקור לאש."
        },
        {
          "s": 4,
          "text": "ומזה מובן,"
        },
        {
          "s": 5,
          "text": "דזה שיש בהצור כח האש הוא דבר נוסף על הצור."
        },
        {
          "s": 6,
          "text": "וכמו\"כ הוא בכחות הכלולים בנפש,"
        },
        {
          "s": 7,
          "text": "שהם כחות"
        },
        {
          "s": 8,
          "text": "(ולא נפש),"
        },
        {
          "s": 9,
          "text": "ויתירה מזו,"
        },
        {
          "s": 10,
          "text": "שהם כמו מקור לכחות הגלויים."
        },
        {
          "s": 11,
          "text": "ולכן,"
        },
        {
          "s": 12,
          "text": "המשל דכחות הכלולים בנפש על ע\"ס הגנוזות הוא בע\"ס דעקודים,"
        },
        {
          "s": 13,
          "text": "אבל בהדרגות דע\"ס הגנוזות שלמעלה מעקודים50,"
        },
        {
          "s": 14,
          "text": "אין שייך לומר גם שהם בהעלם שאינו במציאות,"
        },
        {
          "s": 15,
          "text": "אלא שאינם מציאות כלל,"
        },
        {
          "s": 16,
          "text": "כהלשון"
        },
        {
          "s": 17,
          "text": "(המובא בכ\"מ51)"
        },
        {
          "s": 18,
          "text": "אין מציאות לגנוזות."
        },
        {
          "s": 19,
          "text": "כי זה שנתחדש בהענין דע\"ס הגנוזות הוא רק יכולת – שיכול להיות התהוות ע\"ס וכל זמן שלא נתהוו הספירות לא ישנה מציאות דספירות,"
        },
        {
          "s": 20,
          "text": "גם לא מציאות דמקור לספירות."
        },
        {
          "s": 21,
          "text": "והמשל על זה הוא משם האדם52,"
        },
        {
          "s": 22,
          "text": "דזה שנתחדש בהאדם ע\"י שיש לו שם הוא רק שבאם יקראו אותו בשמו יהי' פונה"
        },
        {
          "s": 23,
          "text": "(נמשך)"
        },
        {
          "s": 24,
          "text": "להקוראים אותו."
        },
        {
          "s": 25,
          "text": "דמציאותה של המשכה זו"
        },
        {
          "s": 26,
          "text": "(שנפנה לקוראיו בשמו)"
        },
        {
          "s": 27,
          "text": "מתחילה בעת שקוראין אותו בשמו,"
        },
        {
          "s": 28,
          "text": "ולפני שקוראין אותו בשמו לא ישנה ההמשכה,"
        },
        {
          "s": 29,
          "text": "גם לא מקור לההמשכה,"
        },
        {
          "s": 30,
          "text": "וזה שנתחדש ע\"י שיש לו שם הוא רק יכולת – שיכולה להיות ההמשכה דנפנה לקוראיו בשמו."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "והנה כמו שהוא בנוגע לשם האדם"
        },
        {
          "s": 1,
          "text": "(ראובן,"
        },
        {
          "s": 2,
          "text": "שמעון),"
        },
        {
          "s": 3,
          "text": "עד\"ז הוא בנוגע לשמות התואר והמעלה,"
        },
        {
          "s": 4,
          "text": "דכשקוראין לאדם בשם חכם או חסיד וכיו\"ב,"
        },
        {
          "s": 5,
          "text": "ע\"י שבחים אלה מעוררים את כח החכמה והחסד שבו שיומשכו מההעלם אל הגילוי."
        },
        {
          "s": 6,
          "text": "ומבואר בתו\"א53"
        },
        {
          "s": 7,
          "text": "ובכמה דרושים54,"
        },
        {
          "s": 8,
          "text": "דעשר ספירות הגנוזות הם עשרה שמות,"
        },
        {
          "s": 9,
          "text": "שע\"י הקריאה בהם,"
        },
        {
          "s": 10,
          "text": "תהי' התהוות הספירות."
        },
        {
          "s": 11,
          "text": "והיינו,"
        },
        {
          "s": 12,
          "text": "דכשעלה ברצונו ית' להוות הספירות,"
        },
        {
          "s": 13,
          "text": "האציל תחלה עשרה שמות55,"
        },
        {
          "s": 14,
          "text": "שכל ענינם הוא רק דכאשר יקראו אותו ית' באחד משמות אלה,"
        },
        {
          "s": 15,
          "text": "תתהווה אז"
        },
        {
          "s": 16,
          "text": "(ע\"י הקריאה)"
        },
        {
          "s": 17,
          "text": "אותה הספירה השייכת לשם זה"
        },
        {
          "s": 18,
          "text": "[דע\"י שיקראו אותו בשם חכם,"
        },
        {
          "s": 19,
          "text": "תתהווה ספירת החכמה,"
        },
        {
          "s": 20,
          "text": "וע\"י שיקראו אותו בשם חסיד,"
        },
        {
          "s": 21,
          "text": "תתהווה ספירת החסד]"
        },
        {
          "s": 22,
          "text": "– בדוגמת אדם,"
        },
        {
          "s": 23,
          "text": "שע\"י שקוראין אותו חכם וחסיד,"
        },
        {
          "s": 24,
          "text": "נעשה המשכת החכמה והחסד."
        },
        {
          "s": 25,
          "text": "אלא שבאדם,"
        },
        {
          "s": 26,
          "text": "ההמשכה ע\"י שקוראין אותו חכם וחסיד,"
        },
        {
          "s": 27,
          "text": "היא רק מן ההעלם אל הגילוי,"
        },
        {
          "s": 28,
          "text": "ולמעלה,"
        },
        {
          "s": 29,
          "text": "ע\"י קריאת השמות נעשה עצם מציאות הספירות,"
        },
        {
          "s": 30,
          "text": "דקודם הקריאה לא היו ספירות כלל,"
        },
        {
          "s": 31,
          "text": "גם לא בהעלם."
        },
        {
          "s": 32,
          "text": "ע\"ד ההמשכה שע\"י קריאת שם האדם"
        },
        {
          "s": 33,
          "text": "(שנפנה כשקוראין אותו בשמו),"
        },
        {
          "s": 34,
          "text": "שכל מציאותה נעשית ע\"י הקריאה בשם ולפני הקריאה בשם לא היתה בהעלם"
        },
        {
          "s": 35,
          "text": "(כנ\"ל)."
        }
      ]
    }
  ]
}