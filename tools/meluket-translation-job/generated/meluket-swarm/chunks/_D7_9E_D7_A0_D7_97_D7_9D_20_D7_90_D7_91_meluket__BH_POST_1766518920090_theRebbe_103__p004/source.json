{
  "globalIndex": 1071,
  "owner": 21,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518920090_theRebbe_103__p004",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518920090_theRebbe_103__p004",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518920090_theRebbe_103",
  "title": "מאמר ושמתי כדכד שמשתיך תשט\"ז",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ושרש ההפרש בין ב' בחי' אלו,"
        },
        {
          "s": 2,
          "text": "הנה ידוע שבענין כר\"ב ישנם ב' אופנים."
        },
        {
          "s": 3,
          "text": "אופן א' הוא כמו שכרת אברהם אבינו עם אבימלך ע\"י שבע כבשות30,"
        },
        {
          "s": 4,
          "text": "ששניהם נשתתפו בהכבשות,"
        },
        {
          "s": 5,
          "text": "שלכל אחד מהם הי' חלק בזה,"
        },
        {
          "s": 6,
          "text": "ועי\"ז הם מתייחדים."
        },
        {
          "s": 7,
          "text": "ואופן הב' הוא,"
        },
        {
          "s": 8,
          "text": "שלוקחים דבר א' שלם וחותכים לשנים והכורתים את הברית עוברים בין הבתרים31."
        },
        {
          "s": 9,
          "text": "והנה,"
        },
        {
          "s": 10,
          "text": "כאשר חותכים דבר א' לשנים הרי זה לכאורה היפך השלימות ופירוד כו',"
        },
        {
          "s": 11,
          "text": "אך באמת הנה זהו אמיתית היחוד,"
        },
        {
          "s": 12,
          "text": "היינו שכל אחד לעצמו הוא רק חצי דבר,"
        },
        {
          "s": 13,
          "text": "ואינו שום מציאות מבלעדי השני."
        },
        {
          "s": 14,
          "text": "ועד\"ז יובן גם למעלה,"
        },
        {
          "s": 15,
          "text": "שבחי' הברית דתורה בהעבודה דואספת דגנך גו',"
        },
        {
          "s": 16,
          "text": "הנה אף שנעשה עי\"ז המשכת האור,"
        },
        {
          "s": 17,
          "text": "מ\"מ הרי הוא מציאות לעצמו."
        },
        {
          "s": 18,
          "text": "אמנם התורה שאחרי הקדמת העבודה דרעו\"ד ותשובה,"
        },
        {
          "s": 19,
          "text": "דתשובה הוא ג\"כ ברית,"
        },
        {
          "s": 20,
          "text": "כמ\"ש32"
        },
        {
          "s": 21,
          "text": "לעברך בברית ה\"א,"
        },
        {
          "s": 22,
          "text": "הרי זה באופן נעלה יותר,"
        },
        {
          "s": 23,
          "text": "שאינו שום מציאות לעצמו כו',"
        },
        {
          "s": 24,
          "text": "ועי\"ז הוא המשכת האור שלמעלה מהשתלשלות."
        },
        {
          "s": 25,
          "text": "ובזה יובן ג\"כ בענין הכר\"ב דר\"ה,"
        },
        {
          "s": 26,
          "text": "כמ\"ש33"
        },
        {
          "s": 27,
          "text": "אתם נצבים היום גו' לעברך בברית,"
        },
        {
          "s": 28,
          "text": "דלכאורה אינו מובן,"
        },
        {
          "s": 29,
          "text": "הרי גם בכל השנה יש כר\"ב דאוא\"ס ונש\"י,"
        },
        {
          "s": 30,
          "text": "ומהו\"ע הכר\"ב דר\"ה."
        },
        {
          "s": 31,
          "text": "אך הענין הוא,"
        },
        {
          "s": 32,
          "text": "שהכר\"ב דכל השנה היא ע\"ד הכר\"ב דשבע כבשות,"
        },
        {
          "s": 33,
          "text": "אמנם בר\"ה הוא העבודה דתשובה,"
        },
        {
          "s": 34,
          "text": "שאינו שום מציאות לעצמו כו',"
        },
        {
          "s": 35,
          "text": "והוא היחוד באוא\"ס עצמו בעל הרצון."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ובזה יובן ג\"כ מה שפירש\"י ע\"פ והי' עקב תשמעון,"
        },
        {
          "s": 2,
          "text": "אם המצוות קלות שהאדם דש בעקביו תשמעון."
        },
        {
          "s": 3,
          "text": "וענין זה הוא כמ\"ש בזהר34"
        },
        {
          "s": 4,
          "text": "ע\"פ35"
        },
        {
          "s": 5,
          "text": "למה אירא בימי רע עון עקבי יסובני,"
        },
        {
          "s": 6,
          "text": "שהו\"ע העבירות קלות שהאדם דש בעקביו."
        },
        {
          "s": 7,
          "text": "דהנה,"
        },
        {
          "s": 8,
          "text": "ביעקב כתיב36"
        },
        {
          "s": 9,
          "text": "וידו אוחזת בעקב עשו,"
        },
        {
          "s": 10,
          "text": "דיעקב פירושו יו\"ד עקב37,"
        },
        {
          "s": 11,
          "text": "שהוא מאיר בכל המדריגות עד בחי' העקביים,"
        },
        {
          "s": 12,
          "text": "והו\"ע הזהירות בכל הענינים,"
        },
        {
          "s": 13,
          "text": "גם בקלות שבקלות,"
        },
        {
          "s": 14,
          "text": "שזהו יו\"ד עקב."
        },
        {
          "s": 15,
          "text": "ושרש ההמשכה דיעקב יו\"ד עקב,"
        },
        {
          "s": 16,
          "text": "שתהי' בו הזהירות גם בקלות שבקלות,"
        },
        {
          "s": 17,
          "text": "הוא כמ\"ש38"
        },
        {
          "s": 18,
          "text": "הקל קול יעקב,"
        },
        {
          "s": 19,
          "text": "קלא קדמאה חסר וקלא בתראה מלא,"
        },
        {
          "s": 20,
          "text": "קלא בתראה מלא הוא התורה,"
        },
        {
          "s": 21,
          "text": "וקלא קדמאה חסר הוא קלא דלא אשתמע,"
        },
        {
          "s": 22,
          "text": "והו\"ע העבודה דרעו\"ד."
        },
        {
          "s": 23,
          "text": "וכאשר הקל קול,"
        },
        {
          "s": 24,
          "text": "קלא קדמאה וקלא בתראה,"
        },
        {
          "s": 25,
          "text": "והוא התורה שאחרי העבודה דרעו\"ד,"
        },
        {
          "s": 26,
          "text": "אזי ישנו הענין דיעקב,"
        },
        {
          "s": 27,
          "text": "יו\"ד עקב,"
        },
        {
          "s": 28,
          "text": "שהו\"ע הזהירות גם בקלות שבקלות."
        },
        {
          "s": 29,
          "text": "והיינו שכאשר עבודתו היא ע\"פ טעם ודעת,"
        },
        {
          "s": 30,
          "text": "אזי יש חילוק בין קלות שבקלות וחמורות שבחמורות,"
        },
        {
          "s": 31,
          "text": "אבל כאשר יש בו ההמשכה דתורה אחרי הקדמת העבודה דרעו\"ד שלמעלה מטו\"ד,"
        },
        {
          "s": 32,
          "text": "אזי אין חילוק כלל בין קלות וחמורות,"
        },
        {
          "s": 33,
          "text": "וזהו הקל קול יעקב,"
        },
        {
          "s": 34,
          "text": "וכאשר הקל קול יעקב אזי אין הידים ידי עשו שולטות39."
        },
        {
          "s": 35,
          "text": "וז\"ש למה אירא בימי רע עון עקבי יסובני,"
        },
        {
          "s": 36,
          "text": "לפי שחסר בחי' יעקב יו\"ד עקב,"
        },
        {
          "s": 37,
          "text": "וידו אוחזת כו'."
        },
        {
          "s": 38,
          "text": "וזהו מה שפירש\"י ע\"פ והי' עקב תשמעון,"
        },
        {
          "s": 39,
          "text": "אם המצוות קלות שהאדם דש בעקביו,"
        },
        {
          "s": 40,
          "text": "לפי שפסוק זה מבאר ענין ההמשכה שלמעלה מהשתלשלות,"
        },
        {
          "s": 41,
          "text": "שהוא ע\"י התורה שאחרי הקדמת העבודה דרעו\"ד,"
        },
        {
          "s": 42,
          "text": "ולכן פירש\"י שצ\"ל הזהירות גם במצוות קלות,"
        },
        {
          "s": 43,
          "text": "שזהו הוראה שעבודתו היא למעלה מטו\"ד שלכן נזהר בקלות כמו בחמורות."
        },
        {
          "s": 44,
          "text": "וכיון שעבודתו היא למעלה מטו\"ד,"
        },
        {
          "s": 45,
          "text": "אזי ושמר ה\"א לך את הברית ואת החסד ואת השבועה,"
        },
        {
          "s": 46,
          "text": "שיומשך האור שלמעלה מהשתלשלות."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "והנה40 ב' אופנים אלו בעבודה,"
        },
        {
          "s": 2,
          "text": "העבודה דהקל קול,"
        },
        {
          "s": 3,
          "text": "תפלה ותורה,"
        },
        {
          "s": 4,
          "text": "הוא העבודה שבדרך מלמטלמ\"ע ובדרך מלמעלמ\"ט,"
        },
        {
          "s": 5,
          "text": "וכמבואר בארוכה בכ\"מ."
        },
        {
          "s": 6,
          "text": "ולהיות דבקדושה הוא התכללות והתאחדות,"
        },
        {
          "s": 7,
          "text": "הרי גם בעבודת התפלה עצמה41"
        },
        {
          "s": 8,
          "text": "ישנם ב' אופנים אלו,"
        },
        {
          "s": 9,
          "text": "עבודת הלילה ועבודת היום."
        },
        {
          "s": 10,
          "text": "וי\"ל שעד\"ז הוא ג\"כ החילוק דהעבודה דבכל לבבך ובכל נפשך והעבודה דבכל מאדך8,"
        },
        {
          "s": 11,
          "text": "וגם בהעבודה דבכל מאדך ישנם ב' אופנים אלו,"
        },
        {
          "s": 12,
          "text": "דבכל מאדך יש בחי' רצון ובחי' תענוג."
        },
        {
          "s": 13,
          "text": "וכן בתורה עצמה42"
        },
        {
          "s": 14,
          "text": "ישנם ב' האופנים,"
        },
        {
          "s": 15,
          "text": "והם תושב\"כ ותושבע\"פ,"
        },
        {
          "s": 16,
          "text": "כמבואר במ\"א."
        },
        {
          "s": 17,
          "text": "וע\"י ב' אופנים אלו בעבודתינו בזמן משך הגלות,"
        },
        {
          "s": 18,
          "text": "יהיו לע\"ל ב' האופנים דשהם וישפה."
        },
        {
          "s": 19,
          "text": "כי עכשיו בזמן הגלות הוא בהעלם,"
        },
        {
          "s": 20,
          "text": "דבין העלי' שנעשה בהעולם ובין המשכת האור שבעולם הוא בהעלם,"
        },
        {
          "s": 21,
          "text": "ולע\"ל יתגלה זה שפעלו בהעבודה בזמן הגלות,"
        },
        {
          "s": 22,
          "text": "ושמתי כדכד שהם וישפה,"
        },
        {
          "s": 23,
          "text": "ולהוי כדין וכדין."
        }
      ]
    }
  ]
}