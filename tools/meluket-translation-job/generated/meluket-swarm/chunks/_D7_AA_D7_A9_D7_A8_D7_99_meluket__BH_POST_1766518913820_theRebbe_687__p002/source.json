{
  "globalIndex": 23,
  "owner": 23,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913820_theRebbe_687__p002",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913820_theRebbe_687__p002",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518913820_theRebbe_687",
  "title": "מאמר זה היום תחילת מעשיך תשמ\"א",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "והנה ביום הראשון דמע\"ב"
        },
        {
          "s": 1,
          "text": "(כ\"ה באלול)"
        },
        {
          "s": 2,
          "text": "נבראו השמים והארץ וכל צבאם מאין ליש כמ\"ש12"
        },
        {
          "s": 3,
          "text": "בראשית ברא אלקים את השמים ואת הארץ,"
        },
        {
          "s": 4,
          "text": "שהשמים והארץ וכל צבאיהם"
        },
        {
          "s": 5,
          "text": "(את השמים לרבות תולדותיהם ואת הארץ לרבות תולדותי'13)"
        },
        {
          "s": 6,
          "text": "נבראו אז מאין ליש."
        },
        {
          "s": 7,
          "text": "דגם הנבראים שנתהוו בהימים דמע\"ב שלאחרי היום הראשון הרי אז היתה התגלות שלהם,"
        },
        {
          "s": 8,
          "text": "יצירה ועשי',"
        },
        {
          "s": 9,
          "text": "אבל בריאתם מאין ליש היתה ביום הראשון14."
        },
        {
          "s": 10,
          "text": "וגם האדם,"
        },
        {
          "s": 11,
          "text": "שהמעלה דראש השנה היא"
        },
        {
          "s": 12,
          "text": "(כנ\"ל)"
        },
        {
          "s": 13,
          "text": "שביום זה נברא האדם,"
        },
        {
          "s": 14,
          "text": "הרי כתיב בי' וייצר ה' אלקים את האדם עפר מן האדמה15,"
        },
        {
          "s": 15,
          "text": "והעפר מן האדמה"
        },
        {
          "s": 16,
          "text": "(שממנו נוצר גוף האדם)"
        },
        {
          "s": 17,
          "text": "נתהווה ביום הראשון."
        },
        {
          "s": 18,
          "text": "ובמיוחד ע\"פ הידוע16"
        },
        {
          "s": 19,
          "text": "שהכתוב בראשית גו' מדבר בהתהוות השמים והארץ הגשמיים וגם בהתהוות האצילות,"
        },
        {
          "s": 20,
          "text": "בראשית חכמה,"
        },
        {
          "s": 21,
          "text": "אלקים בינה,"
        },
        {
          "s": 22,
          "text": "את השמים ז\"א ואת הארץ מלכות."
        },
        {
          "s": 23,
          "text": "וכל זה נתהווה ביום הראשון."
        },
        {
          "s": 24,
          "text": "וגם איתא במדרש עה\"פ ויהי ערב ויהי בוקר יום אחד17,"
        },
        {
          "s": 25,
          "text": "דמ\"ש יום אחד"
        },
        {
          "s": 26,
          "text": "(ולא יום ראשון)"
        },
        {
          "s": 27,
          "text": "הוא לפי שבו הי' הקב\"ה יחידי בעולמו."
        },
        {
          "s": 28,
          "text": "והיינו דההתהוות דיום הראשון היתה באופן שהי' אז נראה ונגלה שהוא ית' אחד בעולמו18."
        },
        {
          "s": 29,
          "text": "וענין זה"
        },
        {
          "s": 30,
          "text": "(הקב\"ה יחידי בעולמו)"
        },
        {
          "s": 31,
          "text": "הי' אז מצד למעלה ומצד וכמו שנמשך למטה,"
        },
        {
          "s": 32,
          "text": "והמאמר שנאמר ביום הראשון הי' ויאמר אלקים יהי אור19,"
        },
        {
          "s": 33,
          "text": "שעל ידו יוכלו בנ\"י"
        },
        {
          "s": 34,
          "text": "(ע\"י עבודתם)"
        },
        {
          "s": 35,
          "text": "להאיר את העולם כולו ולגלות את הפנימיות שבו,"
        },
        {
          "s": 36,
          "text": "אוא\"ס שלפני הבריאה והצמצום,"
        },
        {
          "s": 37,
          "text": "ועד לעצמות ומהות,"
        },
        {
          "s": 38,
          "text": "שבהעולם כמו שהוא מצד עצמו"
        },
        {
          "s": 39,
          "text": "(גם כמו שנברא ביום הראשון)"
        },
        {
          "s": 40,
          "text": "הוא בהעלם."
        },
        {
          "s": 41,
          "text": "וי\"ל דזהו שאמרו רז\"ל20"
        },
        {
          "s": 42,
          "text": "אור שנברא ביום ראשון לא הי' העולם כדאי להשתמש בו,"
        },
        {
          "s": 43,
          "text": "והבדילו לעצמו21,"
        },
        {
          "s": 44,
          "text": "כי אור זה הוא למעלה מהעולם,"
        },
        {
          "s": 45,
          "text": "ובפרט ע\"פ המבואר בכ\"מ22"
        },
        {
          "s": 46,
          "text": "הפירוש"
        },
        {
          "s": 47,
          "text": "(וגודל העילוי)"
        },
        {
          "s": 48,
          "text": "דהבדילו לעצמו."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה נוסף על כל העילויים הנ\"ל שהיו ביום הראשון דמע\"ב,"
        },
        {
          "s": 2,
          "text": "הנה ידוע שבכל ו' ימי בראשית,"
        },
        {
          "s": 3,
          "text": "גם ביום הששי דמע\"ב"
        },
        {
          "s": 4,
          "text": "(לפני חטא עה\"ד),"
        },
        {
          "s": 5,
          "text": "הי' כללות העולם בדרגת ג\"ע23."
        },
        {
          "s": 6,
          "text": "דג\"ע"
        },
        {
          "s": 7,
          "text": "(גם כמו שהוא עכשיו)"
        },
        {
          "s": 8,
          "text": "הוא דרגא הכי נעלית,"
        },
        {
          "s": 9,
          "text": "ועאכו\"כ כמו שהי' אז."
        },
        {
          "s": 10,
          "text": "ואעפ\"כ,"
        },
        {
          "s": 11,
          "text": "ע\"י בריאת האדם בראש השנה נתוסף עילוי בהעולם"
        },
        {
          "s": 12,
          "text": "[ועד שע\"י עבודת אדם הראשון נתוסף עילוי גם בג\"ע כמו שהי' אז,"
        },
        {
          "s": 13,
          "text": "כמ\"ש24"
        },
        {
          "s": 14,
          "text": "ויניחהו בג\"ע לעבדה גו',"
        },
        {
          "s": 15,
          "text": "להמשיך אוא\"ס בג\"ע25]."
        },
        {
          "s": 16,
          "text": "דהגם שעולם על מילואו נברא26"
        },
        {
          "s": 17,
          "text": "וכמ\"ש27"
        },
        {
          "s": 18,
          "text": "אלה תולדות השמים והארץ בהבראם תולדות מלא28,"
        },
        {
          "s": 19,
          "text": "הרי שלימות זו דעולם היא כמו שהעולם הוא מצד הבריאה,"
        },
        {
          "s": 20,
          "text": "וכדיוק לשון הכתוב אלה תולדות"
        },
        {
          "s": 21,
          "text": "(מלא)"
        },
        {
          "s": 22,
          "text": "גו' בהבראם,"
        },
        {
          "s": 23,
          "text": "וכן בלשון חז\"ל עולם על מילואו נברא,"
        },
        {
          "s": 24,
          "text": "והשלימות דעולם כמו שהוא מצד הבריאה"
        },
        {
          "s": 25,
          "text": "(מלמעלה)"
        },
        {
          "s": 26,
          "text": "הוא במדידה והגבלה."
        },
        {
          "s": 27,
          "text": "וע\"י עבודת האדם נמשך אור שלמעלה ממדידת והגבלת העולם,"
        },
        {
          "s": 28,
          "text": "אלה תולדות פרץ29"
        },
        {
          "s": 29,
          "text": "תולדות מלא28,"
        },
        {
          "s": 30,
          "text": "שפורצים30"
        },
        {
          "s": 31,
          "text": "כל המדידות וההגבלות דעולם,"
        },
        {
          "s": 32,
          "text": "גם המדידות וההגבלות דעולם כמו שהי' ביום הראשון דמע\"ב,"
        },
        {
          "s": 33,
          "text": "שבו הי' הקב\"ה יחידי בעולמו."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "וזהו מה שראש השנה הוא ביום ברוא אדם הראשון דוקא,"
        },
        {
          "s": 1,
          "text": "כי ענין ראש השנה הוא המשכת בחי' זה"
        },
        {
          "s": 2,
          "text": "(כנ\"ל בפירוש זה היום),"
        },
        {
          "s": 3,
          "text": "היינו31"
        },
        {
          "s": 4,
          "text": "המשכת וגילוי עצמות אוא\"ס שלמעלה מגדר שייכות לעולמות."
        },
        {
          "s": 5,
          "text": "וזה היום תחלת מעשיך,"
        },
        {
          "s": 6,
          "text": "שהגילוי דבחי' זה נמשך גם במעשיך,"
        },
        {
          "s": 7,
          "text": "דגם בהעולם שמצד עצמו הוא בבחי' כה יהי' בו גילוי בחי' זה"
        },
        {
          "s": 8,
          "text": "(ועד שגם בחי' פעול"
        },
        {
          "s": 9,
          "text": "(שבעשי')"
        },
        {
          "s": 10,
          "text": "ידע כי אתה פעלתו,"
        },
        {
          "s": 11,
          "text": "כנ\"ל)."
        },
        {
          "s": 12,
          "text": "ולכן ראש השנה הוא ביום ברוא אדם הראשון דוקא,"
        },
        {
          "s": 13,
          "text": "כי כח זה"
        },
        {
          "s": 14,
          "text": "(להמשיך גילוי עצמות אוא\"ס שלמעלה מהעולמות,"
        },
        {
          "s": 15,
          "text": "ושהמשכה זו תהי' בעולם)"
        },
        {
          "s": 16,
          "text": "הוא בישראל דוקא,"
        },
        {
          "s": 17,
          "text": "אתם קרויים אדם32,"
        },
        {
          "s": 18,
          "text": "על שם אדם הראשון33."
        }
      ]
    }
  ]
}