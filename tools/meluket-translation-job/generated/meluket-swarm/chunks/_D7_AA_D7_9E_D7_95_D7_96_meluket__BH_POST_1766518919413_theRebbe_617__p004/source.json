{
  "globalIndex": 958,
  "owner": 8,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919413_theRebbe_617__p004",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919413_theRebbe_617__p004",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919413_theRebbe_617",
  "title": "מאמר אך בגורל תשל\"ה",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "והנה עד\"ז הוא גם בכללות ענין העבודה,"
        },
        {
          "s": 2,
          "text": "שיש בה ג' אופנים71"
        },
        {
          "s": 3,
          "text": ": העבודה בנוגע לסור מרע ועשה טוב בפועל,"
        },
        {
          "s": 4,
          "text": "שהמעשה הוא העיקר,"
        },
        {
          "s": 5,
          "text": "ועד\"ז לרב תרבה גו' ולמעט תמעיט גו',"
        },
        {
          "s": 6,
          "text": "שעבודתו של כל אחד היא לפי אופן חלקו בעולם שניתן לו שצריך לפעול בו בשני הקווין דסור מרע ועשה טוב."
        },
        {
          "s": 7,
          "text": "למעלה יותר היא העבודה שע\"פ רוח הקודש,"
        },
        {
          "s": 8,
          "text": "ובזה נכללו שני ענינים."
        },
        {
          "s": 9,
          "text": "וכידוע שרוה\"ק הוא בחינת מלכות שהיא ספירה העשירית,"
        },
        {
          "s": 10,
          "text": "ולפעמים מבואר"
        },
        {
          "s": 11,
          "text": "(בד\"ה ושאבתם72"
        },
        {
          "s": 12,
          "text": "מכ\"ק אדמו\"ר"
        },
        {
          "s": 13,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 14,
          "text": "נ\"ע),"
        },
        {
          "s": 15,
          "text": "שרוח הקודש היא בחי' חכמה,"
        },
        {
          "s": 16,
          "text": "שמשם שואבים רוה\"ק דבחי' מלכות,"
        },
        {
          "s": 17,
          "text": "[ודוגמת הידוע בפי' ראשית,"
        },
        {
          "s": 18,
          "text": "ובראשית ב' ראשית,"
        },
        {
          "s": 19,
          "text": "ששתי הבחינות דראשית"
        },
        {
          "s": 20,
          "text": "(חכמה ומלכות)"
        },
        {
          "s": 21,
          "text": "נעשים תיבה אחת],"
        },
        {
          "s": 22,
          "text": "שבזה נכללות כל העשר ספירות,"
        },
        {
          "s": 23,
          "text": "והיינו שהענין דרוה\"ק כולל גם הבחינות והדרגות שבינתיים דחכ' ומל' דבנפש."
        },
        {
          "s": 24,
          "text": "ולמעלה יותר היא העבודה דגורל,"
        },
        {
          "s": 25,
          "text": "שגם בזה שני ענינים,"
        },
        {
          "s": 26,
          "text": "כמו שמבאר כ\"ק אדמו\"ר הצ\"צ73"
        },
        {
          "s": 27,
          "text": "שני פי' בענין הגורל74,"
        },
        {
          "s": 28,
          "text": "א' אמונה,"
        },
        {
          "s": 29,
          "text": "ב' ביטול שלמעלה מהשכל."
        },
        {
          "s": 30,
          "text": "ששני אופנים אלו הם ב' קצוות,"
        },
        {
          "s": 31,
          "text": "דענין האמונה היא בעיקר בספירת המלכות שהיא למטה וסופא דכל דרגין,"
        },
        {
          "s": 32,
          "text": "והביטול שלמעלה מטו\"ד הוא מצד עצם הנשמה שלמעלה מהשכל,"
        },
        {
          "s": 33,
          "text": "שע\"י אמונה זו או ביטול זה לא נשאר שום ספק באיזו דרך מוליכין אותו,"
        },
        {
          "s": 34,
          "text": "ודבר ברור הוא שמוליכין אותו לכל טוב,"
        },
        {
          "s": 35,
          "text": "ועד לתכלית שלימות הטוב,"
        },
        {
          "s": 36,
          "text": "ועד שזוכה לעולמך תראה בחייך75,"
        },
        {
          "s": 37,
          "text": "שמתגלה אצלו בחי' אך בגורל יחלק את הארץ,"
        },
        {
          "s": 38,
          "text": "למטה מעשרה טפחים,"
        },
        {
          "s": 39,
          "text": "נשמה בגוף."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "והנה כמו שבחלוקת א\"י שבהכניסה לא\"י בפעם הראשונה היו ג' הדברים הנ\"ל"
        },
        {
          "s": 2,
          "text": "(אך בגורל יחלק את הארץ,"
        },
        {
          "s": 3,
          "text": "על פי ה' ברוח הקודש,"
        },
        {
          "s": 4,
          "text": "ולרב תרבה גו' ולמעט תמעיט גו'),"
        },
        {
          "s": 5,
          "text": "וע\"י ג' דברים הנ\"ל חלקו את הארץ ובאופן שלכ\"א הי' גפנו ותאנתו,"
        },
        {
          "s": 6,
          "text": "ובני ישראל היו במנוחה ושלוה איש תחת גפנו ותחת תאנתו76,"
        },
        {
          "s": 7,
          "text": "עד\"ז יהי' גם עכשיו ע\"י מעשינו ועבודתינו,"
        },
        {
          "s": 8,
          "text": "ועוד ביתר שאת ויתר עז מכמו שהי' אז,"
        },
        {
          "s": 9,
          "text": "מכיון שהי' ירידה גדולה ביותר בעקבתא דמשיחא,"
        },
        {
          "s": 10,
          "text": "ובפרט המאסר והגלות של נשמות כלליות נשיאי ישראל,"
        },
        {
          "s": 11,
          "text": "ועד להמאסר וגלות של נשיא ישראל דדורנו"
        },
        {
          "s": 12,
          "text": "(לפני יב-יג תמוז),"
        },
        {
          "s": 13,
          "text": "הנה ע\"י הגאולה שלו,"
        },
        {
          "s": 14,
          "text": "אשר לא אותו בלבד גאל הקב\"ה כי אם גם את כל מחבבי תורתינו הק' שומרי מצוה וגם את אשר בשם ישראל יכונה77,"
        },
        {
          "s": 15,
          "text": "הרי גאולה זו היא הכנה קרובה וצנור וכלי להמשיך גאולה הכללית של כל בנ\"י בכל מקום שהם,"
        },
        {
          "s": 16,
          "text": "שיהי' שוב פעם כיבוש א\"י ובאופן דונתתי שלום בארץ גו' ואולך אתכם קוממיות,"
        },
        {
          "s": 17,
          "text": "ע\"י ג' אופני העבודה דגורל רוה\"ק ולרב תרבה גו'."
        },
        {
          "s": 18,
          "text": "והעיקר והיסוד – ע\"י ההחלטה בתוקף ובמס\"נ וכמאמר בעל השמחה78"
        },
        {
          "s": 19,
          "text": "שענין המס\"נ הוא ההחלטה אַזוי און ניט אַנדערש,"
        },
        {
          "s": 20,
          "text": "און אַז אַ איד זאָגט"
        },
        {
          "s": 21,
          "text": "(כאשר יהודי אומר)"
        },
        {
          "s": 22,
          "text": "שהוא מחליט כן,"
        },
        {
          "s": 23,
          "text": "אין נפק\"מ איך הי' מצבו ומעמדו ברגע שלפנ\"ז,"
        },
        {
          "s": 24,
          "text": "וכפסק הרמב\"ם79"
        },
        {
          "s": 25,
          "text": "שמיד כשאומר רוצה אני מתגלה רצונו האמתי מה שכל אחד מישראל רוצה לקיים את רצון הבורא ולעשות כל התלוי בו שיקויים רצון הבורא,"
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "שבזה גם שיקויים רצון הבורא"
        },
        {
          "s": 1,
          "text": "(שהוא עצם הטוב ומטבע הטוב להטיב)"
        },
        {
          "s": 2,
          "text": "להוציא את כאו\"א מישראל מהגלות בכל מקום שהוא,"
        },
        {
          "s": 3,
          "text": "ובאופן דואתם תלוקטו לאחד אחד בני ישראל80,"
        },
        {
          "s": 4,
          "text": "שאופן זה מראה גודל החביבות וגודל האהבה וגודל ההשגחה פרטית על כאו\"א מישראל81,"
        },
        {
          "s": 5,
          "text": "ויוליכנו קוממיות לארצנו82"
        },
        {
          "s": 6,
          "text": "בקרוב ממש83"
        },
        {
          "s": 7,
          "text": "בביאת משיח צדקנו."
        }
      ]
    }
  ]
}