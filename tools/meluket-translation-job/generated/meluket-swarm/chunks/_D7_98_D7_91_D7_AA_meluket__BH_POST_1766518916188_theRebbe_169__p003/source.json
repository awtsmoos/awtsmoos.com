{
  "globalIndex": 427,
  "owner": 27,
  "jobId": "_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916188_theRebbe_169__p003",
  "batchId": "meluket-_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916188_theRebbe_169__p003",
  "seriesId": "טבת_meluket",
  "postId": "BH_POST_1766518916188_theRebbe_169",
  "title": "מאמר ויגש אליו יהודה תשל\"ו",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה מבואר בהדרושים20,"
        },
        {
          "s": 2,
          "text": "דשני ענינים אלה ההמשכה דמ\"ה והבירור דב\"ן הוא ע\"ד תלמוד ומעשה."
        },
        {
          "s": 3,
          "text": "והענין הוא21,"
        },
        {
          "s": 4,
          "text": "דטעם הדעות22"
        },
        {
          "s": 5,
          "text": "אם תלמוד גדול או מעשה גדול,"
        },
        {
          "s": 6,
          "text": "הוא,"
        },
        {
          "s": 7,
          "text": "כי בכל אחד מהם יש מעלה."
        },
        {
          "s": 8,
          "text": "דמעלת התלמוד הוא בענין הגילויים ומעלת המעשה הוא שע\"י קיום המצוות דוקא הוא המשכת העצמות."
        },
        {
          "s": 9,
          "text": "ונמנו וגמרו תלמוד גדול שהתלמוד מביא לידי מעשה22,"
        },
        {
          "s": 10,
          "text": "שגם המעלה דמעשה הוא ע\"י התלמוד."
        },
        {
          "s": 11,
          "text": "ושני ענינים בזה."
        },
        {
          "s": 12,
          "text": "שע\"י לימוד התורה מתגלית המשכת העצמות שבמעשה המצוות23,"
        },
        {
          "s": 13,
          "text": "כי גילוי כל ענין הוא ע\"י התורה,"
        },
        {
          "s": 14,
          "text": "תורה אור24."
        },
        {
          "s": 15,
          "text": "ויתירה מזו,"
        },
        {
          "s": 16,
          "text": "שגם ההמשכה דמעשה המצוות היא ע\"י התלמוד."
        },
        {
          "s": 17,
          "text": "כי זה שע\"י מעשה המצוות הוא המשכת העצמות הוא כאשר העשי' היא בביטול,"
        },
        {
          "s": 18,
          "text": "וזה נעשה ע\"י לימוד התורה שנקראת תושי'25"
        },
        {
          "s": 19,
          "text": "שמתשת הכח דנפש הבהמית ופועלת בו ביטול."
        },
        {
          "s": 20,
          "text": "דזהו גדול תלמוד שמביא לידי מעשה שהמעשה גופא באה ע\"י תלמוד."
        },
        {
          "s": 21,
          "text": "ועד\"ז20"
        },
        {
          "s": 22,
          "text": "הוא בההמשכה דמ\"ה והבירור דב\"ן,"
        },
        {
          "s": 23,
          "text": "דהמשכת העצמות היא ע\"י הבירור דב\"ן,"
        },
        {
          "s": 24,
          "text": "וכנ\"ל שבהבירור דב\"ן דוקא נשלמת הכוונה דדירה בתחתונים,"
        },
        {
          "s": 25,
          "text": "אלא שבכדי לבוא לזה,"
        },
        {
          "s": 26,
          "text": "הוא ע\"י ההמשכה דמ\"ה."
        },
        {
          "s": 27,
          "text": "וכענין תלמוד שמביא לידי מעשה."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "וצריך להבין,"
        },
        {
          "s": 1,
          "text": "דעפ\"ז,"
        },
        {
          "s": 2,
          "text": "דיוק הנ\"ל"
        },
        {
          "s": 3,
          "text": "[דענין סמיכת גאולה לתפלה הוא שגם עכשיו תפלה היא למעלה מגאולה]"
        },
        {
          "s": 4,
          "text": "הוא עוד יותר,"
        },
        {
          "s": 5,
          "text": "דבענין תלמוד ומעשה,"
        },
        {
          "s": 6,
          "text": "עכשיו הוא תלמוד גדול ורק לע\"ל יהי' מעשה גדול26,"
        },
        {
          "s": 7,
          "text": "ובענין גאולה ותפלה גם עכשיו תפלה היא למעלה מגאולה."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 2,
          "text": "שהטעם על זה שעכשיו תלמוד גדול הוא לפי שתלמוד מביא לידי מעשה,"
        },
        {
          "s": 3,
          "text": "דמזה מוכח שהמעשה הוא העיקר27,"
        },
        {
          "s": 4,
          "text": "הוא מסובב מזה שלע\"ל יהי' מעשה גדול."
        },
        {
          "s": 5,
          "text": "אלא שעכשיו,"
        },
        {
          "s": 6,
          "text": "שעיקר המעלה היא בהגילויים,"
        },
        {
          "s": 7,
          "text": "גם הגדלות דמעשה"
        },
        {
          "s": 8,
          "text": "(שעל ידה דוקא הוא המשכת העצמות)"
        },
        {
          "s": 9,
          "text": "כמו שנרגש עכשיו הוא כמו ששייך להגילויים,"
        },
        {
          "s": 10,
          "text": "וכיון שהגילוי דהמשכת העצמות שבמעשה המצוות הוא ע\"י לימוד התורה,"
        },
        {
          "s": 11,
          "text": "לכן עכשיו תלמוד גדול לפי שמביא לידי מעשה28."
        },
        {
          "s": 12,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 13,
          "text": "דמ\"ש בהדרושים שההמשכה דמ\"ה לעורר העלאת מ\"ן דב\"ן הוא כענין תלמוד שמביא לידי מעשה,"
        },
        {
          "s": 14,
          "text": "הוא"
        },
        {
          "s": 15,
          "text": "(גם)"
        },
        {
          "s": 16,
          "text": "ביאור על זה שהענין דסמיכת גאולה לתפלה שמורה על מעלת התפלה הוא ע\"ד שלע\"ל יהי' יהודה למעלה מיוסף."
        },
        {
          "s": 17,
          "text": "דהגם שזה שיהודה הוא למעלה מיוסף יהי' בעיקר לע\"ל,"
        },
        {
          "s": 18,
          "text": "מ\"מ,"
        },
        {
          "s": 19,
          "text": "כיון שגם עכשיו מאיר"
        },
        {
          "s": 20,
          "text": "(קצת)"
        },
        {
          "s": 21,
          "text": "מעלת המלכות"
        },
        {
          "s": 22,
          "text": "[דהטעם על זה שתלמוד גדול עכשיו הוא לפי שמביא לידי מעשה],"
        },
        {
          "s": 23,
          "text": "לכן שייך שבכמה ענינים,"
        },
        {
          "s": 24,
          "text": "תהי' בגילוי המעלה דמלכות עצמה29,"
        },
        {
          "s": 25,
          "text": "המעלה דתפלה לגבי גאולה."
        },
        {
          "s": 26,
          "text": "ועפ\"ז יש לבאר גם מ\"ש בזהר דהגשת יהודה ליוסף הו\"ע סמיכת גאולה לתפלה,"
        },
        {
          "s": 27,
          "text": "אף שהגשת יהודה ליוסף מורה"
        },
        {
          "s": 28,
          "text": "(בכלל)"
        },
        {
          "s": 29,
          "text": "על המעלה דז\"א,"
        },
        {
          "s": 30,
          "text": "כי ישנם ענינים בהגשת יהודה ליוסף שבהם מודגשת מעלת המלכות,"
        },
        {
          "s": 31,
          "text": "כדלקמן."
        }
      ]
    }
  ]
}