{
  "globalIndex": 330,
  "owner": 30,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915617_theRebbe_822__p009",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915617_theRebbe_822__p009",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915617_theRebbe_822",
  "title": "מאמר ברוך שעשה ניסים תשט\"ו",
  "part": 9,
  "sections": [
    {
      "v": 24,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "ומבאר בהמאמר"
        },
        {
          "s": 3,
          "text": "(בסיומו וחותמו)"
        },
        {
          "s": 4,
          "text": "דמ\"ש ברוך שעשה נסים כו' בזמן הזה הוא בקשה שיהיו נסים גם בזמן הזה."
        },
        {
          "s": 5,
          "text": "וע\"פ מ\"ש אדמו\"ר הזקן"
        },
        {
          "s": 6,
          "text": "(בעל השמחה והגאולה די\"ט כסלו)"
        },
        {
          "s": 7,
          "text": "בתניא45"
        },
        {
          "s": 8,
          "text": "בנוגע הבקשה סלח לנו,"
        },
        {
          "s": 9,
          "text": "דכיון שמברכים"
        },
        {
          "s": 10,
          "text": "(לאחרי הבקשה)"
        },
        {
          "s": 11,
          "text": "ברוך אתה ה' חנון המרבה לסלוח,"
        },
        {
          "s": 12,
          "text": "אין בזה שום ספק – מובן,"
        },
        {
          "s": 13,
          "text": "שכמו\"כ הוא בנוגע להבקשה שהקב\"ה יעשה נסים גם בזמן הזה,"
        },
        {
          "s": 14,
          "text": "דכיון שמברכים ברוך כו' שעשה נסים כו' בזמן הזה,"
        },
        {
          "s": 15,
          "text": "אין שום ספק,"
        },
        {
          "s": 16,
          "text": "שבזמן הזה,"
        },
        {
          "s": 17,
          "text": "בעתיד הקרוב,"
        },
        {
          "s": 18,
          "text": "יעשה הקב\"ה נסים לשון רבים,"
        },
        {
          "s": 19,
          "text": "כל ד' סוגים הנ\"ל,"
        },
        {
          "s": 20,
          "text": "כולל גם הנסים דאראנו נפלאות46"
        },
        {
          "s": 21,
          "text": "שיהיו בביאת משיח צדקנו – שגם נסים אלו יהיו בזמן הזה,"
        },
        {
          "s": 22,
          "text": "בעתיד הקרוב ממש,"
        },
        {
          "s": 23,
          "text": "בביאת משיח צדקנו במהרה בימינו ממש."
        }
      ]
    }
  ]
}