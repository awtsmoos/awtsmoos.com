{
  "globalIndex": 240,
  "owner": 40,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915193_theRebbe_723__p005",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915193_theRebbe_723__p005",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518915193_theRebbe_723",
  "title": "מאמר ויאמר לו יהונתן תשמ\"ה",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ועד\"ז הוא ביהונתן ודוד,"
        },
        {
          "s": 2,
          "text": "ז\"א ומלכות,"
        },
        {
          "s": 3,
          "text": "דעכשיו,"
        },
        {
          "s": 4,
          "text": "ז\"א הוא למעלה ממלכות,"
        },
        {
          "s": 5,
          "text": "דז\"א הוא משפיע במלכות."
        },
        {
          "s": 6,
          "text": "ולכן,"
        },
        {
          "s": 7,
          "text": "עיקר המעלה היא בהמשכת ז\"א"
        },
        {
          "s": 8,
          "text": "(למלכות),"
        },
        {
          "s": 9,
          "text": "ונפקדת."
        },
        {
          "s": 10,
          "text": "והמעלה דיפקד מושבך"
        },
        {
          "s": 11,
          "text": "(ביטול ועליית המלכות)"
        },
        {
          "s": 12,
          "text": "הוא שעי\"ז נעשה ונפקדת."
        },
        {
          "s": 13,
          "text": "וכמבואר בהדרושים33"
        },
        {
          "s": 14,
          "text": "שההעלאה דערב ראש חודש היא בכדי שעי\"ז תהי' ההמשכה בראש חודש."
        },
        {
          "s": 15,
          "text": "ולעתיד לבוא תתגלה בחינת המלכות כמו שהיא מצד עצמה34,"
        },
        {
          "s": 16,
          "text": "שתקבל מאוא\"ס עצמו"
        },
        {
          "s": 17,
          "text": "(כמו ז\"א)."
        },
        {
          "s": 18,
          "text": "וכמ\"ש35"
        },
        {
          "s": 19,
          "text": "והי' אור הלבנה כאור החמה,"
        },
        {
          "s": 20,
          "text": "שהלבנה תאיר מעצמה,"
        },
        {
          "s": 21,
          "text": "כמו השמש."
        },
        {
          "s": 22,
          "text": "ויתירה מזה,"
        },
        {
          "s": 23,
          "text": "שאח\"כ יתגלה שורש המלכות שלמעלה מהשורש דז\"א ואז תהי' המלכות למעלה מז\"א,"
        },
        {
          "s": 24,
          "text": "אשת חיל עטרת בעלה36."
        },
        {
          "s": 25,
          "text": "וזהו שנאמר"
        },
        {
          "s": 26,
          "text": "(בההפטורה דמחר חודש37)"
        },
        {
          "s": 27,
          "text": "עד דוד הגדיל,"
        },
        {
          "s": 28,
          "text": "שדוד למעלה מיהונתן38."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "והנה ידוע39"
        },
        {
          "s": 1,
          "text": "שתחלת העלי' דמלכות הוא שהיא מתבטלת ממציאותה ונעשית נקודה תחת היסוד"
        },
        {
          "s": 2,
          "text": "[שבכללות הו\"ע יפקד מושבך],"
        },
        {
          "s": 3,
          "text": "ועי\"ז היא נעשית כלי להעליות שלמעלה מזה,"
        },
        {
          "s": 4,
          "text": "ועד להעלי' דאשת חיל עטרת בעלה."
        },
        {
          "s": 5,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 6,
          "text": "דזה שההעלאה דער\"ח"
        },
        {
          "s": 7,
          "text": "(יפקד מושבך)"
        },
        {
          "s": 8,
          "text": "הוא בכדי שעי\"ז תהי' בר\"ח ההמשכה מז\"א"
        },
        {
          "s": 9,
          "text": "(ונפקדת),"
        },
        {
          "s": 10,
          "text": "הוא עכשיו,"
        },
        {
          "s": 11,
          "text": "אבל לע\"ל,"
        },
        {
          "s": 12,
          "text": "המעלה דיפקד מושבך40"
        },
        {
          "s": 13,
          "text": "היא שעי\"ז נמשך הגילוי דשורש המלכות עצמה."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "והנה זה ששמש וירח הם ז\"א ומלכות הוא כמו ששמש וירח הם בענין הספירות."
        },
        {
          "s": 2,
          "text": "אבל למעלה מזה,"
        },
        {
          "s": 3,
          "text": "שמש וירח הם הקב\"ה"
        },
        {
          "s": 4,
          "text": "(שמש הוי')"
        },
        {
          "s": 5,
          "text": "וישראל"
        },
        {
          "s": 6,
          "text": "(שדומין ללבנה)."
        },
        {
          "s": 7,
          "text": "וכמובא לעיל"
        },
        {
          "s": 8,
          "text": "(בתחלת המאמר)"
        },
        {
          "s": 9,
          "text": "מהדרושים,"
        },
        {
          "s": 10,
          "text": "דיפקד מושבך"
        },
        {
          "s": 11,
          "text": "(דדוד,"
        },
        {
          "s": 12,
          "text": "לבנה)"
        },
        {
          "s": 13,
          "text": "הוא הביטול דישראל,"
        },
        {
          "s": 14,
          "text": "ועי\"ז נעשה ונפקדת,"
        },
        {
          "s": 15,
          "text": "שהקב\"ה נזכר כביכול עליהם ופוקד אותם."
        },
        {
          "s": 16,
          "text": "ויש לומר,"
        },
        {
          "s": 17,
          "text": "דכמו שע\"י יפקד מושבך דמלכות מתגלה ענינה ושרשה דהמלכות עצמה,"
        },
        {
          "s": 18,
          "text": "שאינה צריכה לקבל מז\"א"
        },
        {
          "s": 19,
          "text": "(שמש),"
        },
        {
          "s": 20,
          "text": "ויתירה מזה שעי\"ז תהי' עליית המלכות למעלה מז\"א,"
        },
        {
          "s": 21,
          "text": "עד\"ז הוא בנוגע ליפקד מושבך דישראל,"
        },
        {
          "s": 22,
          "text": "שע\"י הביטול דישראל מתגלה ענינם שלמעלה מהנ\"ל,"
        },
        {
          "s": 23,
          "text": "שישראל וקוב\"ה כולא חד41,"
        },
        {
          "s": 24,
          "text": "שלכן אינם צריכים כביכול לקבל מהקב\"ה,"
        },
        {
          "s": 25,
          "text": "שהרי הם חד ממש,"
        },
        {
          "s": 26,
          "text": "ויתירה מזה,"
        },
        {
          "s": 27,
          "text": "דכיון שלמעשה ידיך תכסוף42,"
        },
        {
          "s": 28,
          "text": "הרי ישראל הם משפיעים כביכול בהקב\"ה,"
        },
        {
          "s": 29,
          "text": "אשת חיל עטרת בעלה."
        },
        {
          "s": 30,
          "text": "וזהו ונפקדת כי יפקד מושבך,"
        },
        {
          "s": 31,
          "text": "דהגם שענין הזכרון הוא בהדרגא דאוא\"ס שכולא קמי' כלא חשיב,"
        },
        {
          "s": 32,
          "text": "אעפ\"כ הביטול דישראל"
        },
        {
          "s": 33,
          "text": "(יפקד מושבך)"
        },
        {
          "s": 34,
          "text": "מעורר בדרגא זו שיהי' ונפקדת,"
        },
        {
          "s": 35,
          "text": "כי זה שבכדי לעורר למעלה הוא ע\"י שהאדם המעורר יש לו ערך וחשיבות,"
        },
        {
          "s": 36,
          "text": "הוא,"
        },
        {
          "s": 37,
          "text": "כשהאדם המעורר הוא מציאות לעצמו,"
        },
        {
          "s": 38,
          "text": "וע\"י הביטול דיפקד מושבך מתגלה ענינם העליון דישראל שהם חד עם קוב\"ה,"
        },
        {
          "s": 39,
          "text": "חד ממש."
        }
      ]
    }
  ]
}