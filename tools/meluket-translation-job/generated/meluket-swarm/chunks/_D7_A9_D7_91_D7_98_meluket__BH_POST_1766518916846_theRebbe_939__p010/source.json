{
  "globalIndex": 539,
  "owner": 39,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916846_theRebbe_939__p010",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916846_theRebbe_939__p010",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916846_theRebbe_939",
  "title": "מאמר באתי לגני תשל\"א",
  "part": 10,
  "sections": [
    {
      "v": 27,
      "items": [
        {
          "s": 0,
          "text": "והנה אף שהאור שלא האיר גם לפני הצמצום הוא אור נעלה יותר מהאור שהי' ממלא מקום החלל,"
        },
        {
          "s": 1,
          "text": "מ\"מ,"
        },
        {
          "s": 2,
          "text": "דיוק הנ\"ל"
        },
        {
          "s": 3,
          "text": "[דהצמצום שממנו נתהוו העולמות וגילוי האור שקודם הצמצום הם שני הפכים],"
        },
        {
          "s": 4,
          "text": "הוא בעיקר בנוגע להאור שהי' ממלא מקום החלל."
        },
        {
          "s": 5,
          "text": "וכמו שמבאר אדמו\"ר"
        },
        {
          "s": 6,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 7,
          "text": "נ\"ע בהמשך תער\"ב108"
        },
        {
          "s": 8,
          "text": "החילוק בין פעולת הצמצום באור הגבול"
        },
        {
          "s": 9,
          "text": "(שרש הממלא)"
        },
        {
          "s": 10,
          "text": "ופעולת הצמצום באור הבל\"ג"
        },
        {
          "s": 11,
          "text": "(שרש הסובב),"
        },
        {
          "s": 12,
          "text": "דפעולת הצמצום באור הגבול היא בהאור עצמו,"
        },
        {
          "s": 13,
          "text": "שע\"י הצמצום בא במדה וגבול,"
        },
        {
          "s": 14,
          "text": "ופעולת הצמצום באור הבל\"ג היא"
        },
        {
          "s": 15,
          "text": "(לא בהאור עצמו,"
        },
        {
          "s": 16,
          "text": "אלא)"
        },
        {
          "s": 17,
          "text": "שלא יאיר במקום החלל."
        },
        {
          "s": 18,
          "text": "וזהו שההתעלמות דאור הבל\"ג היא"
        },
        {
          "s": 19,
          "text": "(לא שנתעלם תוך העלם הצמצום,"
        },
        {
          "s": 20,
          "text": "אלא)"
        },
        {
          "s": 21,
          "text": "שנתעלם ונכלל במקורו,"
        },
        {
          "s": 22,
          "text": "דענין ההתעלמות במקורו הוא זה שאינו מאיר במקום החלל,"
        },
        {
          "s": 23,
          "text": "אבל בהאור עצמו לא נעשה שינוי"
        },
        {
          "s": 24,
          "text": "[וע\"ד המבואר במק\"א109"
        },
        {
          "s": 25,
          "text": "דבאור הבל\"ג לא הי' צמצום ממש ורק נגע בו הצמצום]."
        },
        {
          "s": 26,
          "text": "ויתירה מזו,"
        },
        {
          "s": 27,
          "text": "שגם פעולה זו באור הבל\"ג שאינו מאיר בגילוי במקום החלל,"
        },
        {
          "s": 28,
          "text": "הוא רק בנוגע להעולמות"
        },
        {
          "s": 29,
          "text": "(שאינו נרגש בהם),"
        },
        {
          "s": 30,
          "text": "ולא בנוגע להאור."
        },
        {
          "s": 31,
          "text": "ושני ענינים בזה."
        },
        {
          "s": 32,
          "text": "שבידיעתו ית',"
        },
        {
          "s": 33,
          "text": "גם עכשיו"
        },
        {
          "s": 34,
          "text": "(לאחרי הצמצום)"
        },
        {
          "s": 35,
          "text": "הוא מאיר במקום החלל בגילוי ממש,"
        },
        {
          "s": 36,
          "text": "כמבואר בכ\"מ110."
        },
        {
          "s": 37,
          "text": "ויתירה מזו,"
        },
        {
          "s": 38,
          "text": "דכיון שלגבי אור הבל\"ג אין הצמצום מעלים,"
        },
        {
          "s": 39,
          "text": "הרי מצד האור"
        },
        {
          "s": 40,
          "text": "(הבל\"ג)"
        },
        {
          "s": 41,
          "text": "הוא יכול להיות בגילוי ממש שיורגש גם בהעולמות."
        },
        {
          "s": 42,
          "text": "דאור הגבול,"
        },
        {
          "s": 43,
          "text": "כיון שבו פעל הצמצום שהגילוי שלו בעולמות יהי' לפי ערך העולמות,"
        },
        {
          "s": 44,
          "text": "לכן,"
        },
        {
          "s": 45,
          "text": "קשה כביכול111"
        },
        {
          "s": 46,
          "text": "שיתגלה בעולמות כמו שהוא בשרשו לפני הצמצום,"
        },
        {
          "s": 47,
          "text": "כי שני ענינים אלה"
        },
        {
          "s": 48,
          "text": "(פעולת הצמצום שהיתה בו,"
        },
        {
          "s": 49,
          "text": "והגילוי שלא כפי הסדר שנקבע ע\"י הצמצום)"
        },
        {
          "s": 50,
          "text": "הם שני הפכים."
        },
        {
          "s": 51,
          "text": "משא\"כ אור הבל\"ג,"
        },
        {
          "s": 52,
          "text": "כיון שלגבי' לא היתה פעולת הצמצום,"
        },
        {
          "s": 53,
          "text": "בכדי שיהי' בגילוי שלא כפי הסדר שנקבע ע\"י הצמצום"
        },
        {
          "s": 54,
          "text": "(היינו שהגילוי שלו יהי' באופן שיורגש גם בהעולמות),"
        },
        {
          "s": 55,
          "text": "אין זה דבר קשה112."
        }
      ]
    },
    {
      "v": 28,
      "items": [
        {
          "s": 0,
          "text": "והנה בהמשך הנ\"ל,"
        },
        {
          "s": 1,
          "text": "החילוק שבין אור הגבול ואור הבל\"ג הוא בנוגע להמשכת וגילוי האור."
        },
        {
          "s": 2,
          "text": "דהמשכת גילוי אור הגבול כמו שהוא בשרשו הוא קשה,"
        },
        {
          "s": 3,
          "text": "משא\"כ המשכת גילוי אור הבל\"ג."
        },
        {
          "s": 4,
          "text": "ויש לומר,"
        },
        {
          "s": 5,
          "text": "שעד\"ז הוא גם בנוגע לזה שהעולם מקבל גילוי שאינו בערכו."
        },
        {
          "s": 6,
          "text": "דבנוגע לגילוי אור הבל\"ג,"
        },
        {
          "s": 7,
          "text": "אפשר שהגילוי שלו בעולמות יהי' מצד זה שהאור הוא בל\"ג,"
        },
        {
          "s": 8,
          "text": "הגם שהעולמות"
        },
        {
          "s": 9,
          "text": "(מצד ענינם)"
        },
        {
          "s": 10,
          "text": "אינם כלים להגילוי."
        },
        {
          "s": 11,
          "text": "והדיוק איך אפשר שהעולם יקבל גילוי שאינו בערכו הוא"
        },
        {
          "s": 12,
          "text": "(בעיקר)"
        },
        {
          "s": 13,
          "text": "בנוגע לגילוי אור הגבול."
        },
        {
          "s": 14,
          "text": "דכיון שבאור זה פעל הצמצום שהגילוי שלו בעולמות יהי' לפי\"ע העולמות,"
        },
        {
          "s": 15,
          "text": "צריך להבין,"
        },
        {
          "s": 16,
          "text": "איך אפשר שהעולם יקבל אור שאינו בערכו."
        }
      ]
    },
    {
      "v": 29,
      "items": [
        {
          "s": 0,
          "text": "והענין הוא,"
        },
        {
          "s": 1,
          "text": "כמבואר בהמשך הנ\"ל113,"
        },
        {
          "s": 2,
          "text": "שעל ידי העבודה דאתהפכא חשוכא לנהורא מהפכים את חושך הצמצום לאור,"
        },
        {
          "s": 3,
          "text": "ועי\"ז נעשים העולמות"
        },
        {
          "s": 4,
          "text": "(שנתהוו מהצמצום)"
        },
        {
          "s": 5,
          "text": "כלים לגילוי אור נעלה יותר,"
        },
        {
          "s": 6,
          "text": "הן בנוגע לגילוי אור הגבול114"
        },
        {
          "s": 7,
          "text": "והן בנוגע לגילוי אור הבל\"ג,"
        },
        {
          "s": 8,
          "text": "וגם גילוי אור הבל\"ג מאיר בהם בפנימיות."
        }
      ]
    }
  ]
}