{
  "globalIndex": 317,
  "owner": 17,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915585_theRebbe_828__p004",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915585_theRebbe_828__p004",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915585_theRebbe_828",
  "title": "מאמר פתח אליהו תשט\"ו",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ומבואר בהדרושים,"
        },
        {
          "s": 1,
          "text": "דג' פירושים הנ\"ל הם ג' ענינים."
        },
        {
          "s": 2,
          "text": "דלפירוש החכם צבי שטבע הוא נסים רצופים,"
        },
        {
          "s": 3,
          "text": "שם טבע קאי על הנהגת העולם."
        },
        {
          "s": 4,
          "text": "ולהפירוש שטבע הוא מלשון מטבע שהקב\"ה טבע כל אדם בחותמו של אדה\"ר,"
        },
        {
          "s": 5,
          "text": "ופירש הרמב\"ם25"
        },
        {
          "s": 6,
          "text": "דחותמו של אדה\"ר הוא צורת מין האדם אשר בה האדם אדם,"
        },
        {
          "s": 7,
          "text": "שהכוונה ב\"צורת מין האדם\" היא"
        },
        {
          "s": 8,
          "text": "(בעיקר)"
        },
        {
          "s": 9,
          "text": "לצורה הנפשית שבו26"
        },
        {
          "s": 10,
          "text": "– שם טבע קאי על החיות האלקי שבעולם,"
        },
        {
          "s": 11,
          "text": "שהוא נפש העולם."
        },
        {
          "s": 12,
          "text": "והשייכות דענין זה לטבע כפשוטו היא,"
        },
        {
          "s": 13,
          "text": "כי הציור והטבע דכל נברא הוא כפי אופן החיות האלקי שבו."
        },
        {
          "s": 14,
          "text": "ולהפירוש שטבע הוא שם המושאל לכל דבר שאינו ע\"פ טעם ודעת – שם טבע קאי על הכח האלקי שמהווה כל נברא מאין ליש,"
        },
        {
          "s": 15,
          "text": "דהתהוות מאין ליש היא למעלה מהשכל."
        },
        {
          "s": 16,
          "text": "דזה שהחיות אלקי מחי' את הנבראים,"
        },
        {
          "s": 17,
          "text": "יש לזה מקום בשכל27,"
        },
        {
          "s": 18,
          "text": "וענין טבע"
        },
        {
          "s": 19,
          "text": "(להפירוש שטבע הוא זה שאינו ע\"פ טעם ודעת)"
        },
        {
          "s": 20,
          "text": "הוא בהתהוות הנבראים,"
        },
        {
          "s": 21,
          "text": "דבריאה יש מאין היא למעלה מהשכל."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ומבואר בהדרושים,"
        },
        {
          "s": 2,
          "text": "דשני הפירושים"
        },
        {
          "s": 3,
          "text": "(הענינים)"
        },
        {
          "s": 4,
          "text": "בטבע,"
        },
        {
          "s": 5,
          "text": "שהוא החיות האלקי שמחי' את הנבראים ושהוא הכח האלקי שמהווה את הנבראים מאין ליש,"
        },
        {
          "s": 6,
          "text": "שייכים להפירוש שטבע הוא מלשון טביעה,"
        },
        {
          "s": 7,
          "text": "טובעו28"
        },
        {
          "s": 8,
          "text": "בים סוף29."
        },
        {
          "s": 9,
          "text": "דכמו שבטביעה כפשוטה,"
        },
        {
          "s": 10,
          "text": "כשדבר נטבע במים,"
        },
        {
          "s": 11,
          "text": "המים מכסים על הדבר שנטבע בהם,"
        },
        {
          "s": 12,
          "text": "כמו כן הוא בחיות האלקי שנתלבש בנבראים להחיותם,"
        },
        {
          "s": 13,
          "text": "שהנבראים מכסים על החיות האלקי שמתלבש בהם."
        },
        {
          "s": 14,
          "text": "ועד\"ז הוא בכח האלקי שמהווה את הנבראים מאין ליש,"
        },
        {
          "s": 15,
          "text": "דענין הטבע שבו הוא גם מלשון טביעה,"
        },
        {
          "s": 16,
          "text": "דכיון שההתהוות היא באופן דהעלם והסתר,"
        },
        {
          "s": 17,
          "text": "שהכח המהווה מתעלם ומסתתר בהנבראים,"
        },
        {
          "s": 18,
          "text": "לכן שייך בו הענין דטבע מלשון טביעה והעלם."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ויש"
        }
      ]
    }
  ]
}