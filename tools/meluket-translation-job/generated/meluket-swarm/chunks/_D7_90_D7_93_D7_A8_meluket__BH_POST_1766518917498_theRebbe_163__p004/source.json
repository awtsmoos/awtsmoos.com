{
  "globalIndex": 646,
  "owner": 46,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917498_theRebbe_163__p004",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917498_theRebbe_163__p004",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917498_theRebbe_163",
  "title": "מאמר בלילה ההוא תשד\"מ",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ויובן זה בפרטיות יותר ע\"פ הידוע שהשלימות דמס\"נ הוא כשהמס\"נ"
        },
        {
          "s": 1,
          "text": "(שמצד יחידה)"
        },
        {
          "s": 2,
          "text": "נמשכת ופועלת גם בכחות הפרטיים54,"
        },
        {
          "s": 3,
          "text": "בכל לבבך ובכל נפשך שגם העבודה הפרטית דכל כח וכח תהי' באופן דמס\"נ,"
        },
        {
          "s": 4,
          "text": "למעלה ממדידה והגבלה."
        },
        {
          "s": 5,
          "text": "והמס\"נ היתה אצל כל ישראל,"
        },
        {
          "s": 6,
          "text": "מנער ועד זקן טף ונשים55,"
        },
        {
          "s": 7,
          "text": "די\"ל הכוונה בזה,"
        },
        {
          "s": 8,
          "text": "שגם העבודה הפרטית של כאו\"א"
        },
        {
          "s": 9,
          "text": "(נער,"
        },
        {
          "s": 10,
          "text": "זקן,"
        },
        {
          "s": 11,
          "text": "טף ונשים)"
        },
        {
          "s": 12,
          "text": "היתה חדורה בהתנועה דמס\"נ."
        },
        {
          "s": 13,
          "text": "וי\"ל שזהו עוד ענין במש\"כ בהמאמר שהמס\"נ שלהם היתה במשך כל השנה56,"
        },
        {
          "s": 14,
          "text": "דבמשך השנה ישנם כל שינויי התקופות57"
        },
        {
          "s": 15,
          "text": "[וכמבואר בכמה דרושים58"
        },
        {
          "s": 16,
          "text": "בענין מעלת האתרוג"
        },
        {
          "s": 17,
          "text": "(דאתרוג הוא בחינת מלכות59,"
        },
        {
          "s": 18,
          "text": "ענינה של אסתר60)"
        },
        {
          "s": 19,
          "text": "שדר באילנו משנה לשנה61],"
        },
        {
          "s": 20,
          "text": "ובכל תקופה ישנה עבודה מיוחדת,"
        },
        {
          "s": 21,
          "text": "ועד שגם בכל יום"
        },
        {
          "s": 22,
          "text": "(באותה התקופה גופא)"
        },
        {
          "s": 23,
          "text": "יש עבודה מיוחדת השייכת ליום זה,"
        },
        {
          "s": 24,
          "text": "כמאמר62"
        },
        {
          "s": 25,
          "text": "כל יומא ויומא עביד עבידתי',"
        },
        {
          "s": 26,
          "text": "ומה שעמדו במס\"נ כל השנה,"
        },
        {
          "s": 27,
          "text": "אולי י\"ל עוד כוונה בזה,"
        },
        {
          "s": 28,
          "text": "שגם הענינים דשנה"
        },
        {
          "s": 29,
          "text": "(העבודה הפרטית דכל יום ויום)"
        },
        {
          "s": 30,
          "text": "היו באופן דמס\"נ,"
        },
        {
          "s": 31,
          "text": "למעלה ממדידה והגבלה."
        },
        {
          "s": 32,
          "text": "וזהו מה שענין נדדה שנת מלכו של עולם נעשה ע\"י שעמדו במס\"נ כל השנה דוקא,"
        },
        {
          "s": 33,
          "text": "דע\"י שהמס\"נ שלהם האיר בגילוי גם בכחות הפרטיים"
        },
        {
          "s": 34,
          "text": "(כל השנה),"
        },
        {
          "s": 35,
          "text": "עי\"ז נעשה כן גם למעלה,"
        },
        {
          "s": 36,
          "text": "שהאור שלמעלה מהשתלשלות,"
        },
        {
          "s": 37,
          "text": "נדדה שנת המלך,"
        },
        {
          "s": 38,
          "text": "נמשך בבחינת פנימיות,"
        },
        {
          "s": 39,
          "text": "ועד שויאמר להביא את ספר הזכרונות דברי הימים63,"
        },
        {
          "s": 40,
          "text": "שנמשך גם בספר הזכרונות דברי הימים,"
        },
        {
          "s": 41,
          "text": "שרש הזמן"
        },
        {
          "s": 42,
          "text": "(כמבואר במאמר64),"
        },
        {
          "s": 43,
          "text": "ועד שוימצא כתוב גו'65"
        },
        {
          "s": 44,
          "text": "גם בספר הזכרונות דשושן הבירה כפשוטו,"
        },
        {
          "s": 45,
          "text": "גם בזמן הגלות,"
        },
        {
          "s": 46,
          "text": "גלו לעילם"
        },
        {
          "s": 47,
          "text": "(שושן66)"
        },
        {
          "s": 48,
          "text": "שכינה עמהם67."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וכמו שהי' בגלות עילם,"
        },
        {
          "s": 2,
          "text": "עד\"ז הוא בכל גלות,"
        },
        {
          "s": 3,
          "text": "דבכל מקום שגלו ישראל שכינה עמהם,"
        },
        {
          "s": 4,
          "text": "וגלו לאדום שכינה עמהם68."
        },
        {
          "s": 5,
          "text": "שע\"י שישראל עומדים במס\"נ,"
        },
        {
          "s": 6,
          "text": "שאינם מתביישים מפני המלעיגים,"
        },
        {
          "s": 7,
          "text": "שזה קשור עם תנועה דמס\"נ69,"
        },
        {
          "s": 8,
          "text": "ותנועת המס\"נ דאל יתבייש מפני המלעיגים נמשכת אצלו בענינים הפרטיים דתומ\"צ במשך כל היום,"
        },
        {
          "s": 9,
          "text": "דזהו מה שענין זה"
        },
        {
          "s": 10,
          "text": "(אל יתבייש מפני המלעיגים)"
        },
        {
          "s": 11,
          "text": "הוא ההתחלה של כל ד' חלקי השו\"ע,"
        },
        {
          "s": 12,
          "text": "ועד שהתנועה דמס\"נ מביאה אותו גם לידי הוספה בלימוד התורה ובהידור בקיום המצוות,"
        },
        {
          "s": 13,
          "text": "ועד שההוספה היא למעלה ממדידה מכיון שהיא באה מצד מס\"נ,"
        },
        {
          "s": 14,
          "text": "ועד שניכר בלימוד התורה ובקיום המצוות שלו שהם נעשים במס\"נ,"
        },
        {
          "s": 15,
          "text": "ועאכו\"כ בדחילו ורחימו70,"
        },
        {
          "s": 16,
          "text": "שבלימוד התורה הוא זוכר את נותן התורה71"
        },
        {
          "s": 17,
          "text": "וקיום המצוות שלו חדור עם ההרגש של מצַוה המצוות,"
        },
        {
          "s": 18,
          "text": "אשר קדשנו במצוותיו וצונו,"
        },
        {
          "s": 19,
          "text": "וכמבואר בארוכה בדרושי אדמו\"ר האמצעי72"
        },
        {
          "s": 20,
          "text": "שבכל המצוות צריכה להיות הכוונה הכללית"
        },
        {
          "s": 21,
          "text": "(שהיא שוה בכל המצוות)"
        },
        {
          "s": 22,
          "text": "שמקיים את הציווי של מלכו של עולם."
        },
        {
          "s": 23,
          "text": "וע\"י העבודה דמס\"נ,"
        },
        {
          "s": 24,
          "text": "ובפרט שהמס\"נ נמשכת ופועלת בענינים הפרטיים דתומ\"צ,"
        },
        {
          "s": 25,
          "text": "הנה עי\"ז נדדה שנת המלך,"
        },
        {
          "s": 26,
          "text": "שנמשך האור שלמעלה מהשתלשלות ועד בספר הזכרונות דברי הימים,"
        },
        {
          "s": 27,
          "text": "שרש הזמן והזמן,"
        },
        {
          "s": 28,
          "text": "ועד שויהיו נקראים לפני המלך63,"
        },
        {
          "s": 29,
          "text": "גם לפני המלך אחשורוש כפשוטו בעוה\"ז הגשמי כשאכתי עבדי אחשורוש אנן73,"
        },
        {
          "s": 30,
          "text": "שגם כשנמצאים עדיין בזמן הגלות ודינא דמלכותא דינא74"
        },
        {
          "s": 31,
          "text": "(ומרדכי הוא רק המשנה למלך75),"
        },
        {
          "s": 32,
          "text": "הנה גם אז והיו76"
        },
        {
          "s": 33,
          "text": "מלכים אומניך77,"
        },
        {
          "s": 34,
          "text": "וגוזרים על אלו שבתחילה היו מנגדים ליהודים ויהדות שיסייעו ליהודים וליהדות,"
        },
        {
          "s": 35,
          "text": "ועד שאתהפכא חשוכא לנהורא ומרירו למיתקא,"
        },
        {
          "s": 36,
          "text": "בדוגמת שהי' בימי מרדכי ואסתר,"
        },
        {
          "s": 37,
          "text": "שהמלך אחשורוש גזר על המנגד שילך ויכריז לפני מרדכי היהודי ככה יעשה לאיש אשר המלך חפץ ביקרו78,"
        },
        {
          "s": 38,
          "text": "מלכו של עולם וגם להבדיל כו' המלך אחשורוש כפשוטו."
        },
        {
          "s": 39,
          "text": "ועד אשר ליהודים היתה אורה ושמחה וששון ויקר79"
        },
        {
          "s": 40,
          "text": "וכן תהי' לנו80,"
        },
        {
          "s": 41,
          "text": "אורה81"
        },
        {
          "s": 42,
          "text": "זו תורה"
        },
        {
          "s": 43,
          "text": "[ובתורה גופא,"
        },
        {
          "s": 44,
          "text": "אורה לשון נקבה דקאי על תושבע\"פ82,"
        },
        {
          "s": 45,
          "text": "תורה בפירושה83,"
        },
        {
          "s": 46,
          "text": "שממנה יוצאת אורה לכל העולם כולו]"
        },
        {
          "s": 47,
          "text": "ושמחה זה יו\"ט וששון זו מילה ויקר אלו תפילין,"
        },
        {
          "s": 48,
          "text": "דהוקשה כל התורה כולה לתפילין84,"
        },
        {
          "s": 49,
          "text": "וי\"ל דכולל גם תפילין דמארי עלמא דכתיב בהו ומי85"
        },
        {
          "s": 50,
          "text": "כעמך ישראל גוי אחד בארץ86,"
        },
        {
          "s": 51,
          "text": "היינו שניכר בגילוי המעלה דישראל,"
        },
        {
          "s": 52,
          "text": "נדדה שנת המלך."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ומיסמך גאולה לגאולה87,"
        },
        {
          "s": 2,
          "text": "שמגאולה זו דליהודים היתה אורה ושמחה וששון ויקר בזמן שנמצאים עדיין ברגעים האחרונים של הגלות,"
        },
        {
          "s": 3,
          "text": "יבואו בסמיכות מיד לגאולה האמיתית והשלימה,"
        },
        {
          "s": 4,
          "text": "שמלכים אומניך יביאו את בני ישראל כאשר יביאו בני ישראל את המנחה בכלי טהור88"
        },
        {
          "s": 5,
          "text": "אל ארץ הקודש,"
        },
        {
          "s": 6,
          "text": "ארץ אשר גו' תמיד עיני ה' אלקיך בה מרשית השנה ועד אחרית שנה89,"
        },
        {
          "s": 7,
          "text": "ושם גופא בירושלים קרית מלך רב90"
        },
        {
          "s": 8,
          "text": "דוד מלכא משיחא,"
        },
        {
          "s": 9,
          "text": "ושם גופא בהר הקודש,"
        },
        {
          "s": 10,
          "text": "ובמקדש אד' כוננו ידיך91."
        },
        {
          "s": 11,
          "text": "וכל זה יהי' באופן של זריזות,"
        },
        {
          "s": 12,
          "text": "ועד לזריזות בתכלית למעלה מכל מדידה והגבלה ועד באופן"
        },
        {
          "s": 13,
          "text": "(של עד)"
        },
        {
          "s": 14,
          "text": "דלא ידע92,"
        },
        {
          "s": 15,
          "text": "אַז מ'טאַנצט אַריין בשמחה רבה שלמעלה מכל מדידה והגבלה אין דער גאולה האמיתית והשלימה במהרה בימינו ממש."
        },
        {
          "s": 16,
          "text": "שכל היהודים שבמשך כל הדורות,"
        },
        {
          "s": 17,
          "text": "ובראשם נשיא דורנו וכו' ומרדכי היהודי ואסתר המלכה,"
        },
        {
          "s": 18,
          "text": "כולם יגאלו מהגלות – שלימות הגאולה,"
        },
        {
          "s": 19,
          "text": "ביחד עם שלימות העם ושלימות התורה ושלימות הארץ,"
        },
        {
          "s": 20,
          "text": "ובאופן דירחיב ה' אלקיך את גבולך93,"
        },
        {
          "s": 21,
          "text": "גם ארץ קני קניזי וקדמוני94,"
        },
        {
          "s": 22,
          "text": "ואין מקרא יוצא מידי פשוטו95,"
        },
        {
          "s": 23,
          "text": "ואדרבא,"
        },
        {
          "s": 24,
          "text": "עולם הפשט שהוא96"
        },
        {
          "s": 25,
          "text": "עוה\"ז התחתון ועולם המעשה – הוא העיקר והיסוד שכל סדר ההשתלשלות נצב עליו,"
        },
        {
          "s": 26,
          "text": "וכפירוש הידוע בוהנה הוי' נצב עליו97."
        }
      ]
    }
  ]
}