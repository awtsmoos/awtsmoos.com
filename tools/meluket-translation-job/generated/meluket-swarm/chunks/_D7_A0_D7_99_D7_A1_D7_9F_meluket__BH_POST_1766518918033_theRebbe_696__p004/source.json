{
  "globalIndex": 731,
  "owner": 31,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918033_theRebbe_696__p004",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918033_theRebbe_696__p004",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518918033_theRebbe_696",
  "title": "מאמר כימי צאתך תשל\"ט",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "וע\"י העבודה שבזמן הגלות בכלל,"
        },
        {
          "s": 1,
          "text": "ובפרט ע\"י העבודה שבסיום הגלות,"
        },
        {
          "s": 2,
          "text": "שהעבודה אז היא מצד פנימיות הנשמה,"
        },
        {
          "s": 3,
          "text": "עי\"ז ממשיכים הפנימיות דלמעלה,"
        },
        {
          "s": 4,
          "text": "ועד פנימיות עתיק,"
        },
        {
          "s": 5,
          "text": "ועי\"ז יהי' חידוש גם בתורה"
        },
        {
          "s": 6,
          "text": "(תורה חדשה מאתי תצא),"
        },
        {
          "s": 7,
          "text": "שיומשך בה מנותן התורה באופן חדש."
        },
        {
          "s": 8,
          "text": "[ויש לומר,"
        },
        {
          "s": 9,
          "text": "שגם ענין זה נעשה ע\"י העבודה שבסיום הגלות,"
        },
        {
          "s": 10,
          "text": "דכאשר העבודה היא באופן דמס\"נ אזי לימוד התורה הוא לשמה41]."
        },
        {
          "s": 11,
          "text": "ועי\"ז נעשה חידוש גם בהבריאה"
        },
        {
          "s": 12,
          "text": "(אסתכל באורייתא וברא עלמא)"
        },
        {
          "s": 13,
          "text": "שיהיו שמים חדשים וארץ חדשה."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ויהי רצון,"
        },
        {
          "s": 1,
          "text": "שכל זה יהי' בקרוב ממש,"
        },
        {
          "s": 2,
          "text": "שע\"י מעשינו ועבודתינו42"
        },
        {
          "s": 3,
          "text": "עכשיו נלך בקרוב ממש לקבל פני משיח צדקנו,"
        },
        {
          "s": 4,
          "text": "שאז יקויים בפועל ממש כימי צאתך מארץ מצרים אראנו נפלאות,"
        },
        {
          "s": 5,
          "text": "ומיד נגאלין."
        }
      ]
    }
  ]
}