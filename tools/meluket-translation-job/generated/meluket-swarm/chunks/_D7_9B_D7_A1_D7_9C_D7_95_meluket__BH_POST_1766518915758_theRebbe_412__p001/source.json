{
  "globalIndex": 345,
  "owner": 45,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915758_theRebbe_412__p001",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915758_theRebbe_412__p001",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915758_theRebbe_412",
  "title": "מאמר להבין ענין נרות חנוכה תשכ\"ו",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ וישב,"
        },
        {
          "s": 2,
          "text": "ערב חנוכה,"
        },
        {
          "s": 3,
          "text": "ה'תשכ\"ו"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "להבין ענין נרות חנוכה,"
        },
        {
          "s": 1,
          "text": "דהגם שנרות חנוכה תקנום מפני הנס שהי' בנרות המקדש,"
        },
        {
          "s": 2,
          "text": "וכל דתקון רבנן כעין דאורייתא תקון1,"
        },
        {
          "s": 3,
          "text": "מ\"מ ה\"ה חלוקים בכמה ענינים."
        },
        {
          "s": 4,
          "text": "במספרם2"
        },
        {
          "s": 5,
          "text": "– דבהמנורה שבמקדש היו ז' נרות,"
        },
        {
          "s": 6,
          "text": "ונרות חנוכה הם שמונה."
        },
        {
          "s": 7,
          "text": "במקום עמידתם3"
        },
        {
          "s": 8,
          "text": "– דהמנורה היתה בפנים"
        },
        {
          "s": 9,
          "text": "(בתוך הקודש4)"
        },
        {
          "s": 10,
          "text": "ובדרום"
        },
        {
          "s": 11,
          "text": "(ימין),"
        },
        {
          "s": 12,
          "text": "ונרות חנוכה מצוה להניחם מבחוץ5"
        },
        {
          "s": 13,
          "text": "ובשמאל6."
        },
        {
          "s": 14,
          "text": "ובזמן הדלקתם7"
        },
        {
          "s": 15,
          "text": "– דנרות המקדש הדליקו מפלג המנחה,"
        },
        {
          "s": 16,
          "text": "משך זמן"
        },
        {
          "s": 17,
          "text": "(שעה ורביע8)"
        },
        {
          "s": 18,
          "text": "קודם שתשקע החמה,"
        },
        {
          "s": 19,
          "text": "ונר חנוכה מצותה היא משתשקע החמה9."
        },
        {
          "s": 20,
          "text": "ומוסיף כ\"ק מו\"ח אדמו\"ר"
        },
        {
          "s": 21,
          "text": "(בהמשך פדה בשלום ה'תש\"ד10)"
        },
        {
          "s": 22,
          "text": "עוד דיוק בזה שנר חנוכה מצוה להניחה מבחוץ,"
        },
        {
          "s": 23,
          "text": "דלא מצינו מצוה"
        },
        {
          "s": 24,
          "text": "(מלבד פרה אדומה11)"
        },
        {
          "s": 25,
          "text": "שצריכה להיות בחוץ"
        },
        {
          "s": 26,
          "text": "(רשות הרבים12)"
        },
        {
          "s": 27,
          "text": "דוקא."
        },
        {
          "s": 28,
          "text": "ומבאר בההמשך,"
        },
        {
          "s": 29,
          "text": "דהטעם בפשטות על זה שנר חנוכה הוא מבחוץ הוא בשביל פרסומי ניסא13."
        },
        {
          "s": 30,
          "text": "אבל לכאורה טעם זה אינו מספיק,"
        },
        {
          "s": 31,
          "text": "שהרי גם הנס דפורים מפרסמים ע\"י משתה של שמחה ומשלוח מנות ומתנות לאביונים,"
        },
        {
          "s": 32,
          "text": "ואעפ\"כ אין עושים זה ברה\"ר."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ונקודת הביאור בזה הוא"
        },
        {
          "s": 2,
          "text": "(כמבואר בהדרושים14),"
        },
        {
          "s": 3,
          "text": "שענינם של נרות חנוכה הוא להאיר את החושך."
        },
        {
          "s": 4,
          "text": "דע\"י מלחמת היונים להשכיחם תורתך ולהעבירם מחוקי רצונך15"
        },
        {
          "s": 5,
          "text": "[ובפרט לאחרי שנכנסו להיכל וטמאו כל השמנים שבהיכל16],"
        },
        {
          "s": 6,
          "text": "נעשה התגברות החושך דלעו\"ז,"
        },
        {
          "s": 7,
          "text": "ולכן,"
        },
        {
          "s": 8,
          "text": "כשגברה מלכות בית חשמונאי ונצחו את היונים תיקנו נרות חנוכה,"
        },
        {
          "s": 9,
          "text": "בכדי להאיר את החושך."
        },
        {
          "s": 10,
          "text": "וזהו שזמן הדלקתם הוא משתשקע החמה,"
        },
        {
          "s": 11,
          "text": "כי ענינם של נרות חנוכה הוא להאיר את החושך."
        },
        {
          "s": 12,
          "text": "ומקום עמידתם הוא בחוץ"
        },
        {
          "s": 13,
          "text": "(רשות הרבים17)"
        },
        {
          "s": 14,
          "text": "ובשמאל,"
        },
        {
          "s": 15,
          "text": "בכדי להאיר גם את החושך דרשות הרבים,"
        },
        {
          "s": 16,
          "text": "טורי דפרודא,"
        },
        {
          "s": 17,
          "text": "שיניקתם הוא מקו השמאל."
        },
        {
          "s": 18,
          "text": "וזהו שנרות חנוכה הם שמונה נרות,"
        },
        {
          "s": 19,
          "text": "כי זה שנרות חנוכה מאירים את החושך"
        },
        {
          "s": 20,
          "text": "(גם החושך דרה\"ר)"
        },
        {
          "s": 21,
          "text": "הוא מפני שהאור דנרות חנוכה הוא אור שלמעלה מהשתלשלות,"
        },
        {
          "s": 22,
          "text": "ולכן הם שמונה נרות,"
        },
        {
          "s": 23,
          "text": "דמספר שמונה מורה על בחינה שלמעלה מהשתלשלות18."
        },
        {
          "s": 24,
          "text": "ועד\"ז הוא בנוגע להיו\"ט דחנוכה,"
        },
        {
          "s": 25,
          "text": "דזה שהיו\"ט דחנוכה הוא במספר שמונה"
        },
        {
          "s": 26,
          "text": "(יומי דחנוכה תמניא אינון16),"
        },
        {
          "s": 27,
          "text": "הוא,"
        },
        {
          "s": 28,
          "text": "כי הגילוי שמאיר בימי חנוכה הוא גילוי שלמעלה מהשתלשלות."
        }
      ]
    }
  ]
}