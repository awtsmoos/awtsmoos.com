{
  "globalIndex": 914,
  "owner": 14,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919187_theRebbe_149__p008",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919187_theRebbe_149__p008",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919187_theRebbe_149",
  "title": "מאמר וידבר זאת חוקת תשכ\"ט",
  "part": 8,
  "sections": [
    {
      "v": 21,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דזהו שהגאולה"
        },
        {
          "s": 2,
          "text": "(די\"ט כסלו ודי\"ב תמוז)"
        },
        {
          "s": 3,
          "text": "היתה נס גלוי שלמעלה מהטבע,"
        },
        {
          "s": 4,
          "text": "ואעפ\"כ הי' הנס מלובש בטבע,"
        },
        {
          "s": 5,
          "text": "והגם שהנס נתלבש בטבע הי' זה באופן שהטבע לא העלים והסתיר על הנס,"
        },
        {
          "s": 6,
          "text": "ועד שראו כל אפסי ארץ שזהו נס גלוי,"
        },
        {
          "s": 7,
          "text": "כי שורש הטבע הוא משם אלקים,"
        },
        {
          "s": 8,
          "text": "ממלא,"
        },
        {
          "s": 9,
          "text": "ושורש הנסים הוא משם הוי',"
        },
        {
          "s": 10,
          "text": "סובב,"
        },
        {
          "s": 11,
          "text": "וכיון שבהגאולה הי' הגילוי דעצמות אוא\"ס שלמעלה מסובב וממלא,"
        },
        {
          "s": 12,
          "text": "הכולל ומחבר את שניהם,"
        },
        {
          "s": 13,
          "text": "לכן היתה הגאולה באופן שהנס והטבע נתחברו יחד,"
        },
        {
          "s": 14,
          "text": "יחוד הוי' ואלקים."
        }
      ]
    },
    {
      "v": 22,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "שהגילוי דאוא\"ס שלמעלה מסובב וממלא בהחיבור דנס"
        },
        {
          "s": 2,
          "text": "(ששרשו מסובב)"
        },
        {
          "s": 3,
          "text": "וטבע"
        },
        {
          "s": 4,
          "text": "(ששרשו מממלא)"
        },
        {
          "s": 5,
          "text": "הוא רק שנרגש בהם ענין שלמעלה משניהם,"
        },
        {
          "s": 6,
          "text": "שעי\"ז הם מתחברים."
        },
        {
          "s": 7,
          "text": "אבל זה שהטבע עצמו הי' אז באופן שלא העלים והסתיר על הנס,"
        },
        {
          "s": 8,
          "text": "ועד שגם המנגדים"
        },
        {
          "s": 9,
          "text": "[שנשארו אז בתקפם]"
        },
        {
          "s": 10,
          "text": "ומ\"מ הוכרחו לסייע"
        },
        {
          "s": 11,
          "text": "[וע\"י התוקף שלהם]"
        },
        {
          "s": 12,
          "text": "בהשחרור והגאולה,"
        },
        {
          "s": 13,
          "text": "הוא ע\"י שבהמלכות עצמה"
        },
        {
          "s": 14,
          "text": "(שורש הנבראים)"
        },
        {
          "s": 15,
          "text": "נתגלה שרשה האמיתי."
        },
        {
          "s": 16,
          "text": "ועפ\"ז יובן עוד יותר הקשר והשייכות דהגאולה להמזמור תפלה למשה,"
        },
        {
          "s": 17,
          "text": "תפלת עשיר,"
        },
        {
          "s": 18,
          "text": "דענין תפלת עשיר הוא מדינה פלונית כו' גזור שתיבנה,"
        },
        {
          "s": 19,
          "text": "המשכת גילוי עצמות אוא\"ס במלכות."
        }
      ]
    },
    {
      "v": 23,
      "items": [
        {
          "s": 0,
          "text": "ולהוסיף,"
        },
        {
          "s": 1,
          "text": "שע\"י החיבור דנס וטבע שהי' בהגאולה,"
        },
        {
          "s": 2,
          "text": "ניתן הכח לכל ההולכים באורחותיו של בעל הגאולה,"
        },
        {
          "s": 3,
          "text": "שהאמונה שלמעלה מהשכל"
        },
        {
          "s": 4,
          "text": "(נס)"
        },
        {
          "s": 5,
          "text": "תומשך גם בשכל"
        },
        {
          "s": 6,
          "text": "(טבע),"
        },
        {
          "s": 7,
          "text": "ושהשכל לא יעלים ויסתיר על האמונה."
        },
        {
          "s": 8,
          "text": "ועד\"ז הוא בנוגע להענין דיפוצו מעינותיך חוצה"
        },
        {
          "s": 9,
          "text": "[שהותחל בהגאולה די\"ט כסלו71,"
        },
        {
          "s": 10,
          "text": "וניתוסף עוד יותר בהגאולה די\"ב תמוז]"
        },
        {
          "s": 11,
          "text": "שע\"י החיבור דנס וטבע שהי' בהגאולה ניתן הכח להפיץ המעיינות דפנימיות התורה"
        },
        {
          "s": 12,
          "text": "(שלמעלה מהעולם,"
        },
        {
          "s": 13,
          "text": "נס)"
        },
        {
          "s": 14,
          "text": "חוצה,"
        },
        {
          "s": 15,
          "text": "ובאופן שגם כשהם נמצאים חוצה נראה בגלוי שהם המעיינות דפנימיות התורה."
        },
        {
          "s": 16,
          "text": "וזה שגם כשהם נמצאים חוצה הם באופן שרואים בגלוי שהם מעיינות,"
        },
        {
          "s": 17,
          "text": "הוא לא רק מפני שהמעיינות הם בגילוי אלא גם מפני שהחוצה נעשה באופן שאינו מעלים ומסתיר על המעיינות,"
        },
        {
          "s": 18,
          "text": "ויתירה מזו,"
        },
        {
          "s": 19,
          "text": "שהוא כלי להמעיינות."
        },
        {
          "s": 20,
          "text": "וזה נעשה הכנה קרובה לקיום היעוד ונגלה כבוד הוי' וראו כל בשר יחדו כי פי הוי' דיבר72,"
        },
        {
          "s": 21,
          "text": "שהבשר יראה אלקות"
        },
        {
          "s": 22,
          "text": "(לא רק מצד הגילוי דכבוד הוי',"
        },
        {
          "s": 23,
          "text": "אלא גם)"
        },
        {
          "s": 24,
          "text": "מצד הבשר עצמו."
        }
      ]
    }
  ]
}