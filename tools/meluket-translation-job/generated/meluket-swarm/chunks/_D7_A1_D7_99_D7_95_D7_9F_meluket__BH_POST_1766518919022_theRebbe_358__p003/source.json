{
  "globalIndex": 888,
  "owner": 38,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518919022_theRebbe_358__p003",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518919022_theRebbe_358__p003",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518919022_theRebbe_358",
  "title": "מאמר ואהי אצלו אמון תשכ\"א",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה חילוק הנ\"ל בין שני המקיפים"
        },
        {
          "s": 2,
          "text": "(מקיף הקרוב ומקיף הרחוק)"
        },
        {
          "s": 3,
          "text": "הוא בנוגע לכחות הפנימיים"
        },
        {
          "s": 4,
          "text": "(מקבל)."
        },
        {
          "s": 5,
          "text": "והחילוק דשני המקיפים מצד המשפיע הוא,"
        },
        {
          "s": 6,
          "text": "שמקיף הקרוב הוא מקיף הישר,"
        },
        {
          "s": 7,
          "text": "ומקיף הרחוק הוא מקיף החוזר."
        },
        {
          "s": 8,
          "text": "והענין בזה,"
        },
        {
          "s": 9,
          "text": "דמקיף הישר ענינו הוא גילוי,"
        },
        {
          "s": 10,
          "text": "שנמשך ביושר להתגלות."
        },
        {
          "s": 11,
          "text": "והיינו,"
        },
        {
          "s": 12,
          "text": "שעם היותו בחינת מקיף,"
        },
        {
          "s": 13,
          "text": "מ\"מ ענינו הוא גילוי."
        },
        {
          "s": 14,
          "text": "וכשם שענינו של הכח פנימי הוא שיתגלה בפנימיות,"
        },
        {
          "s": 15,
          "text": "כמו\"כ ענינו של המקיף הוא שיתגלה בבחינת מקיף,"
        },
        {
          "s": 16,
          "text": "אבל ענינו הוא גילוי."
        },
        {
          "s": 17,
          "text": "משא\"כ מקיף החוזר,"
        },
        {
          "s": 18,
          "text": "אין ענינו ענין הגילוי כלל,"
        },
        {
          "s": 19,
          "text": "אלא אדרבה,"
        },
        {
          "s": 20,
          "text": "שחוזר ועולה בעצמותו כו'."
        },
        {
          "s": 21,
          "text": "וענין ב' בחינות אלו למעלה בענין הספירות,"
        },
        {
          "s": 22,
          "text": "הנה החכמה היא ראשית הכחות פנימיים,"
        },
        {
          "s": 23,
          "text": "והכתר היא בחינת מקיף,"
        },
        {
          "s": 24,
          "text": "אלא שבכתר גופא ישנו עתיק ואריך,"
        },
        {
          "s": 25,
          "text": "שהם ב' בחינות מקיף הנ\"ל."
        },
        {
          "s": 26,
          "text": "אריך הוא בחינת מקיף הקרוב,"
        },
        {
          "s": 27,
          "text": "מקיף דאור ישר,"
        },
        {
          "s": 28,
          "text": "שזהו שנקרא בשם אריך,"
        },
        {
          "s": 29,
          "text": "היינו ששייך לבחינת ז\"א,"
        },
        {
          "s": 30,
          "text": "אלא שז\"א הוא בבחינת קטנות,"
        },
        {
          "s": 31,
          "text": "ואריך הוא באריכות,"
        },
        {
          "s": 32,
          "text": "משא\"כ בחינת עתיק הוא שנעתק ונבדל."
        },
        {
          "s": 33,
          "text": "וכמו\"כ ישנם ב' בחינות אלו גם בהאור שקודם הצמצום,"
        },
        {
          "s": 34,
          "text": "והוא בחינת עצם האור והתפשטות האור."
        },
        {
          "s": 35,
          "text": "דהתפשטות האור,"
        },
        {
          "s": 36,
          "text": "עם היותו קודם הצמצום,"
        },
        {
          "s": 37,
          "text": "מ\"מ,"
        },
        {
          "s": 38,
          "text": "זה עצמו שנקרא בשם התפשטות האור,"
        },
        {
          "s": 39,
          "text": "מורה שענינו הוא ענין הגילוי,"
        },
        {
          "s": 40,
          "text": "וע\"י הצמצום יהי' ממנו גילויים בסדר השתלשלות."
        },
        {
          "s": 41,
          "text": "משא\"כ האור שהבדילו לעצמו,"
        },
        {
          "s": 42,
          "text": "ומכש\"כ עצם האור,"
        },
        {
          "s": 43,
          "text": "הרי זה למעלה מגדר גילוי כלל,"
        },
        {
          "s": 44,
          "text": "והו\"ע המקיף דאור חוזר,"
        },
        {
          "s": 45,
          "text": "שחוזר ומתעלם בעצמותו."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "והנה המקיף דאור ישר,"
        },
        {
          "s": 1,
          "text": "עם היותו בגדר גילוי,"
        },
        {
          "s": 2,
          "text": "מ\"מ אינו דומה אופן הגילוי שלו לאופן הגילוי דאור פנימי."
        },
        {
          "s": 3,
          "text": "כי,"
        },
        {
          "s": 4,
          "text": "הגילוי דאור פנימי הוא במיעוט ובהתלבשות ובהעלם,"
        },
        {
          "s": 5,
          "text": "והיינו,"
        },
        {
          "s": 6,
          "text": "שמה שנמשך ומתגלה מאור פנימי לכח התחתון ממנו,"
        },
        {
          "s": 7,
          "text": "הוא רק בחינה האחרונה שבהכח עליון כנ\"ל,"
        },
        {
          "s": 8,
          "text": "שהוא ענין המיעוט,"
        },
        {
          "s": 9,
          "text": "וגם אופן התגלותו הוא שמתלבש בכח התחתון ממנו ומתעלם בו."
        },
        {
          "s": 10,
          "text": "משא\"כ הגילוי דאור מקיף הוא באופן שנמשך בריבוי אור,"
        },
        {
          "s": 11,
          "text": "ואינו בא בהתלבשות והעלם."
        },
        {
          "s": 12,
          "text": "ויובן זה36"
        },
        {
          "s": 13,
          "text": "ממה שמצינו שלפעמים איתא37"
        },
        {
          "s": 14,
          "text": "או\"א יונקים ממזלא,"
        },
        {
          "s": 15,
          "text": "שאבא יונק ממזל ונוצר,"
        },
        {
          "s": 16,
          "text": "ואימא יונק ממזל ונקה,"
        },
        {
          "s": 17,
          "text": "ולפעמים איתא38"
        },
        {
          "s": 18,
          "text": "שאבא ואימא מלבישים לזרועות דאריך."
        },
        {
          "s": 19,
          "text": "ולכאורה,"
        },
        {
          "s": 20,
          "text": "היניקה דאבא ואימא ממזלא היא בחינה תחתונה יותר מזה שמלבישים לזרועות דאריך,"
        },
        {
          "s": 21,
          "text": "שהרי היניקה מהמזלות שהם בחי' שערות היא המשכת הארה בלבד,"
        },
        {
          "s": 22,
          "text": "וע\"י הפסק הגולגולת,"
        },
        {
          "s": 23,
          "text": "משא\"כ מה שאבא ואימא מלבישים זרועות דאריך,"
        },
        {
          "s": 24,
          "text": "הרי ענין התלבשות הוא שמלבישים את עצם המהות כו'."
        },
        {
          "s": 25,
          "text": "ומ\"מ,"
        },
        {
          "s": 26,
          "text": "לאידך גיסא,"
        },
        {
          "s": 27,
          "text": "ענין ההתלבשות הוא באופן שהאור מתלבש ומתעלם,"
        },
        {
          "s": 28,
          "text": "משא\"כ ענין היניקה ממזלא,"
        },
        {
          "s": 29,
          "text": "עם היות שזהו יניקת הארה בלבד,"
        },
        {
          "s": 30,
          "text": "מ\"מ הרי זה ריבוי אור,"
        },
        {
          "s": 31,
          "text": "ואינו מתלבש ומתעלם כלל."
        },
        {
          "s": 32,
          "text": "ולכן בכדי שיהי' יחוד אבא ואימא,"
        },
        {
          "s": 33,
          "text": "הרי זה דוקא ע\"י יניקתם מהמזל."
        },
        {
          "s": 34,
          "text": "דההמשכה שנמשכת לאו\"א מזרועות דאריך"
        },
        {
          "s": 35,
          "text": "(ע\"י שאו\"א מלבישים אותם),"
        },
        {
          "s": 36,
          "text": "היא באופן שעי\"ז נעשה ההתחלקות דחו\"ב,"
        },
        {
          "s": 37,
          "text": "שמבחינת חסד דאריך נמשך החכמה,"
        },
        {
          "s": 38,
          "text": "ומבחינת גבורה דאריך נמשך הבינה,"
        },
        {
          "s": 39,
          "text": "והם בהתחלקות זה מזה,"
        },
        {
          "s": 40,
          "text": "משא\"כ ההמשכה שנמשכת לאו\"א ע\"י שיונקים ממזלא,"
        },
        {
          "s": 41,
          "text": "היא באופן שהם בהתאחדות ובהתכללות."
        },
        {
          "s": 42,
          "text": "והיינו שלא זו בלבד שלא נעשה בהם התחלקות ע\"י ההמשכה מהמזל,"
        },
        {
          "s": 43,
          "text": "אלא שמצד יניקתם ממזלא דאריך נעשה יחוד והתכללות גם בהתחלקות שהיתה בהם מקודם."
        },
        {
          "s": 44,
          "text": "ועד שמצד יניקתם ממזלא דאריך,"
        },
        {
          "s": 45,
          "text": "נעשה ענין ההולדה להוליד בדומה לו."
        },
        {
          "s": 46,
          "text": "וטעם הדבר הוא,"
        },
        {
          "s": 47,
          "text": "לפי שזרועות דאריך,"
        },
        {
          "s": 48,
          "text": "אף שהם באריך שלמעלה מהשתלשלות,"
        },
        {
          "s": 49,
          "text": "מ\"מ באריך גופא הוא בחינת סדר ההשתלשלות,"
        },
        {
          "s": 50,
          "text": "היינו אור פנימי,"
        },
        {
          "s": 51,
          "text": "ולכן אופן התגלותם הוא בהתלבשות והעלם."
        },
        {
          "s": 52,
          "text": "משא\"כ כשההמשכה היא מאריך עצמו"
        },
        {
          "s": 53,
          "text": "(שבאריך גופא הוא מקיף שלמעלה מהשתלשלות),"
        },
        {
          "s": 54,
          "text": "הנה הגם שההמשכה היא באופן של יניקה,"
        },
        {
          "s": 55,
          "text": "הארה לבד"
        },
        {
          "s": 56,
          "text": "(מזלות ושערות),"
        },
        {
          "s": 57,
          "text": "מ\"מ,"
        },
        {
          "s": 58,
          "text": "אין זה באופן דהתלבשות והעלם."
        },
        {
          "s": 59,
          "text": "אלא שמ\"מ גם אריך עצמו,"
        },
        {
          "s": 60,
          "text": "הוא מקיף הקרוב,"
        },
        {
          "s": 61,
          "text": "מקיף הישר,"
        },
        {
          "s": 62,
          "text": "ולכן התגלותו היא באופן של יניקת הארה לבד,"
        },
        {
          "s": 63,
          "text": "משא\"כ עתיק הוא מקיף הרחוק,"
        },
        {
          "s": 64,
          "text": "מקיף דאור חוזר שאינו בגדר גילוי כלל,"
        },
        {
          "s": 65,
          "text": "וכאשר נמשך אזי הוא נמשך בכל עצמותו."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "וזהו החילוק שבין מדלג ומקפץ,"
        },
        {
          "s": 1,
          "text": "שההמשכה דמדלג היא רק רגל אחת"
        },
        {
          "s": 2,
          "text": "(ואינו נמשך כמו שהוא בעצמותו)"
        },
        {
          "s": 3,
          "text": "– דוגמתא"
        },
        {
          "s": 4,
          "text": "או\"א יונקים ממזלא,"
        },
        {
          "s": 5,
          "text": "וההמשכה דמקפץ בשתי רגליו27"
        },
        {
          "s": 6,
          "text": "שעי\"ז נעתק כל גופו היא ההמשכה ממקיף הרחוק,"
        },
        {
          "s": 7,
          "text": "שכאשר נמשך אזי נמשך בכל עצמותוב."
        },
        {
          "s": 8,
          "text": "וזהו שמדלג על ההרים קאי על יציאת מצרים"
        },
        {
          "s": 9,
          "text": "(כמארז\"ל39"
        },
        {
          "s": 10,
          "text": "עה\"פ מדלג על ההרים דלג על הקץ),"
        },
        {
          "s": 11,
          "text": "ומקפץ על הגבעות קאי על מתן תורה,"
        },
        {
          "s": 12,
          "text": "כי הגילוי דיצי\"מ הוא הגילוי דבחינת מקיף הישר,"
        },
        {
          "s": 13,
          "text": "והגילוי דמ\"ת הוא הגילוי דמקיף החוזר,"
        },
        {
          "s": 14,
          "text": "ועד להגילוי דאנכי מי שאנכי,"
        },
        {
          "s": 15,
          "text": "עצמות."
        }
      ]
    }
  ]
}