{
  "globalIndex": 858,
  "owner": 8,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918840_theRebbe_178__p005",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918840_theRebbe_178__p005",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918840_theRebbe_178",
  "title": "מאמר רני ושמחי תשכ\"ז",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ומדייק הכתוב רני ושמחי בת ציון,"
        },
        {
          "s": 2,
          "text": "שקיום התומ\"צ"
        },
        {
          "s": 3,
          "text": "(ציון34)"
        },
        {
          "s": 4,
          "text": "צ\"ל לא רק בביטול,"
        },
        {
          "s": 5,
          "text": "בת,"
        },
        {
          "s": 6,
          "text": "אלא גם בשמחה,"
        },
        {
          "s": 7,
          "text": "רני ושמחי."
        },
        {
          "s": 8,
          "text": "וצריך להבין,"
        },
        {
          "s": 9,
          "text": "דכאשר האדם הוא במצב שאין לו תענוג וחיות בתומ\"צ,"
        },
        {
          "s": 10,
          "text": "וקיום התומ\"צ שלו הוא רק בדרך קבלת עול"
        },
        {
          "s": 11,
          "text": "[ויתירה מזו,"
        },
        {
          "s": 12,
          "text": "שגם הקב\"ע שלו היא לא באופן שרוצה לקבל עליו עומ\"ש ורק שאינו יכול לפרוק ממנו עול מלכות שמים מפני שבחירת הקב\"ה בישראל להיות לו לעבדים מכריחה אותו],"
        },
        {
          "s": 13,
          "text": "איך יכול לפעול בעצמו שקיום התומ\"צ שלו יהי' בשמחה."
        },
        {
          "s": 14,
          "text": "והענין הוא,"
        },
        {
          "s": 15,
          "text": "דיש עוד פירוש בבת ציון,"
        },
        {
          "s": 16,
          "text": "דציון הם הצדיקים,"
        },
        {
          "s": 17,
          "text": "ובת ציון הוא התקשרות עם הצדיקים35."
        },
        {
          "s": 18,
          "text": "וע\"י ההתקשרות להצדיקים,"
        },
        {
          "s": 19,
          "text": "ובפרט לנשיאי ישראל שענינם הוא להמשיך גילוי אלקות לכל ישראל ובפרט להמקושרים ושייכים אליהם,"
        },
        {
          "s": 20,
          "text": "עי\"ז נמשך לו נתינת כח שקיום התומ\"צ שלו יהי' בשמחה,"
        },
        {
          "s": 21,
          "text": "רני ושמחי."
        },
        {
          "s": 22,
          "text": "ובכלל זה הוא גם שלא יהיו לו בלבולים מענינים גשמיים36,"
        },
        {
          "s": 23,
          "text": "רני ושמחי גם בנוגע לבני חיי ומזוני רויחי."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "וע\"י ההתקשרות להצדיקים ולהנשיאים שבכל דור,"
        },
        {
          "s": 1,
          "text": "ומה שנוגע לנו במיוחד הוא ההתקשרות לכ\"ק מו\"ח אדמו\"ר נשיא דורנו,"
        },
        {
          "s": 2,
          "text": "יבטלו כל ההעלמות וההסתרים,"
        },
        {
          "s": 3,
          "text": "כולל גם ביטול"
        },
        {
          "s": 4,
          "text": "(ההעלם ד)"
        },
        {
          "s": 5,
          "text": "הגלות37,"
        },
        {
          "s": 6,
          "text": "וכ\"ק מו\"ח אדמו\"ר יוליכנו קוממיות לארצנו,"
        },
        {
          "s": 7,
          "text": "בגאולה האמיתית והשלימה,"
        },
        {
          "s": 8,
          "text": "בקרוב ממש."
        }
      ]
    }
  ]
}