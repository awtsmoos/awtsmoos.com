{
  "globalIndex": 695,
  "owner": 45,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917870_theRebbe_730__p002",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917870_theRebbe_730__p002",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917870_theRebbe_730",
  "title": "מאמר אשרי תבחר ותקרב תשט\"ז",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ויש לבאר זה ע\"פ מה דאיתא בגמרא9"
        },
        {
          "s": 1,
          "text": "בהמה שנבראת מן היבשה הכשרה בשני סימנים כו' עוף שנברא מן הרקק הכשרו בסימן אחד."
        },
        {
          "s": 2,
          "text": "ומבואר במק\"א10,"
        },
        {
          "s": 3,
          "text": "דבהמה שנבראת מן העפר"
        },
        {
          "s": 4,
          "text": "(יבשה)"
        },
        {
          "s": 5,
          "text": "שלכן יש לה חיות בריא וחזק11,"
        },
        {
          "s": 6,
          "text": "רומז על נפש הבהמית כמו שהיא בתוקף הגסות."
        },
        {
          "s": 7,
          "text": "ולכן הכשרה הוא בשני סימנים."
        },
        {
          "s": 8,
          "text": "ועוף שנברא מן הרקק,"
        },
        {
          "s": 9,
          "text": "מים ועפר,"
        },
        {
          "s": 10,
          "text": "רומז על נפש הבהמית כמו שהיא בדקות."
        },
        {
          "s": 11,
          "text": "ולכן הכשרו בסימן אחד."
        },
        {
          "s": 12,
          "text": "ובפרטיות יותר,"
        },
        {
          "s": 13,
          "text": "בהמה היא נפש הבהמית"
        },
        {
          "s": 14,
          "text": "(עצמה),"
        },
        {
          "s": 15,
          "text": "שהיא ממדריגות תחתונות דנוגה12"
        },
        {
          "s": 16,
          "text": "(גסות שלה),"
        },
        {
          "s": 17,
          "text": "ועוף הוא נפש השכלית שהיא ממדריגות עליונות דנוגה12"
        },
        {
          "s": 18,
          "text": "(דקות שלה),"
        },
        {
          "s": 19,
          "text": "שלכן היא ממוצע13"
        },
        {
          "s": 20,
          "text": "בין נפש הבהמית ונפש האלקית12."
        },
        {
          "s": 21,
          "text": "וזהו שהעוף פורח באויר"
        },
        {
          "s": 22,
          "text": "(מזמן לזמן),"
        },
        {
          "s": 23,
          "text": "דיש לבאר זה בשני אופנים."
        },
        {
          "s": 24,
          "text": "שהפריחה באויר"
        },
        {
          "s": 25,
          "text": "(דהעוף)"
        },
        {
          "s": 26,
          "text": "היא מצד נפש השכלית עצמה."
        },
        {
          "s": 27,
          "text": "כי טבע השכל"
        },
        {
          "s": 28,
          "text": "(גם השכל דנפש השכלית הגם שהוא שכל טבעי,"
        },
        {
          "s": 29,
          "text": "שכל דנוגה,"
        },
        {
          "s": 30,
          "text": "מ\"מ,"
        },
        {
          "s": 31,
          "text": "כיון שהוא שכל,"
        },
        {
          "s": 32,
          "text": "טבעו)"
        },
        {
          "s": 33,
          "text": "הוא להיות נמשך למה שלמעלה ממנו14."
        },
        {
          "s": 34,
          "text": "ועוד ענין בזה,"
        },
        {
          "s": 35,
          "text": "שע\"י ההתלבשות דנפש האלקית בנפש השכלית,"
        },
        {
          "s": 36,
          "text": "יכולה היא להשיג עניני אלקות שלמעלה מעולם."
        },
        {
          "s": 37,
          "text": "אלא שגם אז היא רק מסכימה לההשגה דנפש האלקית אבל היא נשארת במהותה – שכל אנושי15."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דזה ששמירת בהמות הוא גם בחצר שאינו מקורה ושמירת העופות הוא דוקא בחצר מקורה"
        },
        {
          "s": 2,
          "text": "(אף שעופות הם בדקות יותר),"
        },
        {
          "s": 3,
          "text": "כי דקות דנוגה אינו ניכר כ\"כ,"
        },
        {
          "s": 4,
          "text": "ולכן צריך לשמירה יתירה."
        },
        {
          "s": 5,
          "text": "ולהוסיף,"
        },
        {
          "s": 6,
          "text": "דכמו שבגשמיות,"
        },
        {
          "s": 7,
          "text": "הטעם על זה שהעופות אינם נשמרים בחצר שאינו מקורה הוא לפי שיכולים לפרוח"
        },
        {
          "s": 8,
          "text": "(ע\"ג המחיצות),"
        },
        {
          "s": 9,
          "text": "עד\"ז הוא ברוחניות,"
        },
        {
          "s": 10,
          "text": "דזה שנפש השכלית צריכה לשמירה יתירה הוא לפי שיש בה התכונה דפריחה באויר."
        },
        {
          "s": 11,
          "text": "והיינו,"
        },
        {
          "s": 12,
          "text": "דכיון שהשכל דנפש השכלית נמשך למה שלמעלה ממנו"
        },
        {
          "s": 13,
          "text": "[ויתירה מזו,"
        },
        {
          "s": 14,
          "text": "שהוא משיג"
        },
        {
          "s": 15,
          "text": "(ע\"י התלבשות נה\"א בנפש השכלית)"
        },
        {
          "s": 16,
          "text": "עניני אלקות שלמעלה מעולם],"
        },
        {
          "s": 17,
          "text": "לכן,"
        },
        {
          "s": 18,
          "text": "בכדי למצוא הרע שבשכל הוא דוקא ע\"י ההתבוננות שאלקות הוא מופלא משכל אנושי"
        },
        {
          "s": 19,
          "text": "[היינו שגם הענינים דאלקות המושגים בשכל אנושי,"
        },
        {
          "s": 20,
          "text": "אין השכל משיג אותם כמו שהם לאמיתתם,"
        },
        {
          "s": 21,
          "text": "כי כיון שהם אלקות,"
        },
        {
          "s": 22,
          "text": "הרי הם בלי גבול,"
        },
        {
          "s": 23,
          "text": "וכמו שהשכל תופס אותם,"
        },
        {
          "s": 24,
          "text": "בהכרח שהוא מגבילם16],"
        },
        {
          "s": 25,
          "text": "וע\"י שנפש השכלית"
        },
        {
          "s": 26,
          "text": "(עוף)"
        },
        {
          "s": 27,
          "text": "מרגישה הפלאת אלקות שלמעלה מהשכל,"
        },
        {
          "s": 28,
          "text": "מקורה בגג,"
        },
        {
          "s": 29,
          "text": "עי\"ז נתברר דקות הרע שבה17,"
        },
        {
          "s": 30,
          "text": "נשמרת."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יש לבאר זה שהדין שחצר שאינו מקורה הוא ככרמלית הוא מדברי סופרים,"
        },
        {
          "s": 2,
          "text": "כי שמירת הבהמה"
        },
        {
          "s": 3,
          "text": "(בעבודת האדם)"
        },
        {
          "s": 4,
          "text": "היא בעיקר בנוגע למחשבה דיבור ומעשה,"
        },
        {
          "s": 5,
          "text": "שמצד התאוות דנפש הבהמית אפשר שיכשל באיזה איסור ח\"ו,"
        },
        {
          "s": 6,
          "text": "ושמירת הבהמה היא ע\"י שגודר את החצר"
        },
        {
          "s": 7,
          "text": "(המקום שבו נמצאת הבהמה)"
        },
        {
          "s": 8,
          "text": "במחיצות,"
        },
        {
          "s": 9,
          "text": "היינו שלא לעשות מה שהוא רוצה ורק מה שצריך לעשות18."
        },
        {
          "s": 10,
          "text": "ושמירת העוף"
        },
        {
          "s": 11,
          "text": "(בעבודת האדם)"
        },
        {
          "s": 12,
          "text": "שהוא בנוגע לדקות דנוגה"
        },
        {
          "s": 13,
          "text": "(כנ\"ל)"
        },
        {
          "s": 14,
          "text": "הוא בעיקר בנוגע לכחות הפנימיים,"
        },
        {
          "s": 15,
          "text": "שכל ומדות."
        },
        {
          "s": 16,
          "text": "שמצד הישות והגאוה שבו19"
        },
        {
          "s": 17,
          "text": "(מזה שהוא בעל שכל,"
        },
        {
          "s": 18,
          "text": "ראית איש חכם בעיניו20),"
        },
        {
          "s": 19,
          "text": "אין מספיק שגודר את החצר במחיצות,"
        },
        {
          "s": 20,
          "text": "כי גם כשהוא מוגדר בהמחשבה דיבור ומעשה שלו,"
        },
        {
          "s": 21,
          "text": "ועד שהוא בדרגת בינוני שלא עבר עבירה מימיו21,"
        },
        {
          "s": 22,
          "text": "מ\"מ,"
        },
        {
          "s": 23,
          "text": "מצד הגאוה והגסות שבו,"
        },
        {
          "s": 24,
          "text": "השכל והמדות שבו הם בגסות,"
        },
        {
          "s": 25,
          "text": "ולכן צריך שהחצר שלו יהי' מקורה בגג,"
        },
        {
          "s": 26,
          "text": "שיורגש בו הפלאת האלקות כנ\"ל."
        },
        {
          "s": 27,
          "text": "וכיון שהעיקר הוא המעשה22,"
        },
        {
          "s": 28,
          "text": "לכן,"
        },
        {
          "s": 29,
          "text": "מדאורייתא גם חצר שאינו מקורה הוא רשות היחיד,"
        },
        {
          "s": 30,
          "text": "יחידו של עולם,"
        },
        {
          "s": 31,
          "text": "אלא שמדברי סופרים"
        },
        {
          "s": 32,
          "text": "[שענינם הוא להגבי' ולהעלות את האדם,"
        },
        {
          "s": 33,
          "text": "שיהי' כלי לאלקות גם מצד שכלו ומדותיו23],"
        },
        {
          "s": 34,
          "text": "בכדי שהאדם יהי' רשות היחיד ליחודו ית' הוא ע\"י שמקורה בגג."
        }
      ]
    }
  ]
}