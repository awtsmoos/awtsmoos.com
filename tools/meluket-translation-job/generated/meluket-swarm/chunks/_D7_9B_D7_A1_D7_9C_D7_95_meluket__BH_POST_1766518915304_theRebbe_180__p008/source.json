{
  "globalIndex": 262,
  "owner": 12,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915304_theRebbe_180__p008",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915304_theRebbe_180__p008",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915304_theRebbe_180",
  "title": "מאמר ושבתי בשלום תשל\"ח",
  "part": 8,
  "sections": [
    {
      "v": 21,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ד)"
        },
        {
          "s": 2,
          "text": "וביאור הענין"
        },
        {
          "s": 3,
          "text": "(דעיקר העבודה שבשבילה ירדה הנשמה למטה היא ויקח מאבני המקום גו')"
        },
        {
          "s": 4,
          "text": "בעומק יותר,"
        },
        {
          "s": 5,
          "text": "יובן בהקדים שהיתרון בהעבודה דכל מעשיך לשם שמים ובכל דרכיך דעהו על העבודה דלימוד התורה וקיום המצוות הוא לא רק בנוגע להפעולה בעולם,"
        },
        {
          "s": 6,
          "text": "שע\"י העבודה בכל מעשיך לשם שמים מתברר גם התחתון דעולם"
        },
        {
          "s": 7,
          "text": "(כנ\"ל סעיף ט),"
        },
        {
          "s": 8,
          "text": "אלא גם בנוגע להאדם."
        },
        {
          "s": 9,
          "text": "והענין הוא124,"
        },
        {
          "s": 10,
          "text": "דהנה ידוע שירידת הנשמה למטה היא ירידה צורך עלי',"
        },
        {
          "s": 11,
          "text": "דע\"י ירידתה למטה היא מתעלית יותר גם מכפי שהיתה קודם הירידה."
        },
        {
          "s": 12,
          "text": "וענין העלי' הוא,"
        },
        {
          "s": 13,
          "text": "שבאה לענין התשובה."
        },
        {
          "s": 14,
          "text": "שקודם ירידתה למטה היתה בבחי' צדיק"
        },
        {
          "s": 15,
          "text": "(גמור),"
        },
        {
          "s": 16,
          "text": "וע\"י עבודתה בירידתה למטה נעשית בבחי' בעל תשובה125."
        },
        {
          "s": 17,
          "text": "והגם שיש יתרון בעבודת הצדיקים על עבודת הבעלי תשובה"
        },
        {
          "s": 18,
          "text": "[שלכן התמידים היו מכבשים ולא מעזים,"
        },
        {
          "s": 19,
          "text": "אימרא יאי126],"
        },
        {
          "s": 20,
          "text": "וכמרז\"ל127"
        },
        {
          "s": 21,
          "text": "במי נמלך בנשמותיהן של צדיקים,"
        },
        {
          "s": 22,
          "text": "הנה היתרון דעבודת הצדיקים הוא מצד הרצון שבו שייך ענין ההמלכה"
        },
        {
          "s": 23,
          "text": "(במי נמלך),"
        },
        {
          "s": 24,
          "text": "משא\"כ מצד עצמותו ית'"
        },
        {
          "s": 25,
          "text": "(בחי' בעל הרצון),"
        },
        {
          "s": 26,
          "text": "עיקר הכוונה הוא בענין התשובה דוקא."
        },
        {
          "s": 27,
          "text": "וזהו מה שארז\"ל128"
        },
        {
          "s": 28,
          "text": "מקום שבעלי תשובה עומדין אין צדיקים גמורין יכולין לעמוד בו"
        },
        {
          "s": 29,
          "text": "[לא רק שאינם עומדין שם129,"
        },
        {
          "s": 30,
          "text": "אלא יתירה מזו שאין יכולין לעמוד שם,"
        },
        {
          "s": 31,
          "text": "כהגירסא המובאת בהדרושים עה\"פ ושבתי בשלום130],"
        },
        {
          "s": 32,
          "text": "והיינו שמעלת הבע\"ת היא למעלה גם מיכולת הצד\"ג,"
        },
        {
          "s": 33,
          "text": "שענין היכולת הוא131"
        },
        {
          "s": 34,
          "text": "למעלה מבחי' כח גם מכחות המקיפים,"
        },
        {
          "s": 35,
          "text": "לפי שענין התשובה מגיע בעצמותו ית',"
        },
        {
          "s": 36,
          "text": "שכל הגילויים"
        },
        {
          "s": 37,
          "text": "(שרש עבודת הצדיקים)"
        },
        {
          "s": 38,
          "text": "הם באין ערוך אליו כלל."
        }
      ]
    },
    {
      "v": 22,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ו)"
        },
        {
          "s": 2,
          "text": "וע\"פ הנ\"ל יובן מ\"ש ושבתי בשלום אל בית אבי,"
        },
        {
          "s": 3,
          "text": "דצריך להבין,"
        },
        {
          "s": 4,
          "text": "הרי ענין ושבתי הוא"
        },
        {
          "s": 5,
          "text": "(לכאורה)"
        },
        {
          "s": 6,
          "text": "שיחזור להמקום שהי' בתחילה,"
        },
        {
          "s": 7,
          "text": "וא\"כ,"
        },
        {
          "s": 8,
          "text": "מכיון שביציאת יעקב נאמר ויצא יעקב מבאר שבע,"
        },
        {
          "s": 9,
          "text": "הול\"ל ושבתי בשלום אל באר שבע ולמה אומר אל בית אבי."
        },
        {
          "s": 10,
          "text": "וי\"ל הענין בזה,"
        },
        {
          "s": 11,
          "text": "כי מכיון שע\"י עבודת התשובה מתעלית הנשמה לבחינה נעלית יותר מכמו שהיתה לפני ירידתה"
        },
        {
          "s": 12,
          "text": "(כנ\"ל),"
        },
        {
          "s": 13,
          "text": "לכן ענין ושבתי הוא"
        },
        {
          "s": 14,
          "text": "(לא לבאר שבע,"
        },
        {
          "s": 15,
          "text": "הדרגא של הנשמה כמו שהיתה קודם ירידתה132,"
        },
        {
          "s": 16,
          "text": "כי אם)"
        },
        {
          "s": 17,
          "text": "אל בית אבי,"
        },
        {
          "s": 18,
          "text": "שלמעלה מבחי' באר שבע133."
        },
        {
          "s": 19,
          "text": "ויש להוסיף,"
        },
        {
          "s": 20,
          "text": "דענין זה שייך גם לבית אבי כפשוטו שקאי על יצחק."
        },
        {
          "s": 21,
          "text": "דיצחק הוא מלשון שמחה ותענוג134,"
        },
        {
          "s": 22,
          "text": "וידוע135"
        },
        {
          "s": 23,
          "text": "שתענוג זה"
        },
        {
          "s": 24,
          "text": "(התענוג שבצחוק)"
        },
        {
          "s": 25,
          "text": "הוא מדבר חידוש136"
        },
        {
          "s": 26,
          "text": "דוקא."
        },
        {
          "s": 27,
          "text": "ומכיון שענין התשובה הוא דבר חידוש137"
        },
        {
          "s": 28,
          "text": "[וע\"ד מ\"ש הרמב\"ם138"
        },
        {
          "s": 29,
          "text": "בענין התשובה כפשוטה"
        },
        {
          "s": 30,
          "text": "(על עבירות),"
        },
        {
          "s": 31,
          "text": "שמעלת התשובה היא מצד זה שאמש הי' זה מובדל כו' והיום הוא מודבק בשכינה],"
        },
        {
          "s": 32,
          "text": "לכן,"
        },
        {
          "s": 33,
          "text": "ע\"י עבודת התשובה נעשה תענוג וצחוק למעלה."
        },
        {
          "s": 34,
          "text": "שתענוג זה הוא נעלה יותר מהתענוג דעבודת הצדיקים,"
        },
        {
          "s": 35,
          "text": "דזהו מה שבע\"ת הוא אהוב וחביב יותר מצדיק139,"
        },
        {
          "s": 36,
          "text": "לפי שעיקר התענוג שלמעלה הוא בעבודת התשובה."
        },
        {
          "s": 37,
          "text": "וזהו ג\"כ מה שבע\"ת צועק ונענה מיד140,"
        },
        {
          "s": 38,
          "text": "ועד141"
        },
        {
          "s": 39,
          "text": "אשר והי'142"
        },
        {
          "s": 40,
          "text": "טרם יקראו ואני אענה140"
        },
        {
          "s": 41,
          "text": "(הגם שע\"פ סדר מענה בא לאחרי קריאה),"
        },
        {
          "s": 42,
          "text": "כי התענוג שלמעלה הבא מהחידוש דעבודת התשובה פועל חידוש"
        },
        {
          "s": 43,
          "text": "(היפך הסדר)"
        },
        {
          "s": 44,
          "text": "גם למעלה – טרם יקראו ואני אענה143."
        }
      ]
    },
    {
      "v": 23,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ז)"
        },
        {
          "s": 2,
          "text": "והנה עיקר החידוש הגורם התענוג והצחוק שלמעלה הוא החידוש שנעשה בגוף ונפש הבהמית144"
        },
        {
          "s": 3,
          "text": "גופא."
        },
        {
          "s": 4,
          "text": "והיינו,"
        },
        {
          "s": 5,
          "text": "שהתשובה דנפש האלקית"
        },
        {
          "s": 6,
          "text": "[מה שגם בירידתה למטה"
        },
        {
          "s": 7,
          "text": "(גם בזמן הגלות)"
        },
        {
          "s": 8,
          "text": "היא עוסקת בתומ\"צ,"
        },
        {
          "s": 9,
          "text": "ואפילו זה שגם עשייתה עניני הרשות היא לש\"ש ועד באופן דדעהו145]"
        },
        {
          "s": 10,
          "text": "אינו חידוש כ\"כ146,"
        },
        {
          "s": 11,
          "text": "מכיון שהיא אלקות בעצם מהותה."
        },
        {
          "s": 12,
          "text": "ובמילא אין בזה תענוג כ\"כ."
        },
        {
          "s": 13,
          "text": "ועיקר התענוג שלמעלה הוא בהחידוש שנעשה בהגוף ונפש הבהמית גופא147,"
        },
        {
          "s": 14,
          "text": "הן באופן דאתהפכא"
        },
        {
          "s": 15,
          "text": "(ע\"י עבודת הצדיקים)"
        },
        {
          "s": 16,
          "text": "והן באופן דאתכפיא"
        },
        {
          "s": 17,
          "text": "(ע\"י עבודת הבינונים),"
        },
        {
          "s": 18,
          "text": "שהם שני מיני נחת רוח,"
        },
        {
          "s": 19,
          "text": "מטעמים לשון רבים148."
        },
        {
          "s": 20,
          "text": "ותענוג זה הוא נעלה יותר מהתענוג שבעבודת הנשמה"
        },
        {
          "s": 21,
          "text": "(גם מעבודת התשובה של הנשמה),"
        },
        {
          "s": 22,
          "text": "וכמאמר הזהר149"
        },
        {
          "s": 23,
          "text": "כד אתכפיא"
        },
        {
          "s": 24,
          "text": "(ואתהפכא150)"
        },
        {
          "s": 25,
          "text": "סט\"א אסתלק יקרא דקוב\"ה בכולהו עלמין,"
        },
        {
          "s": 26,
          "text": "שהאור הנמשך ע\"י אתכפיא ואתהפכא הוא אור שלמעלה מכלים,"
        },
        {
          "s": 27,
          "text": "שלכן נקרא בשם אסתלק151."
        },
        {
          "s": 28,
          "text": "וזהו מה שמבואר בתו\"א152"
        },
        {
          "s": 29,
          "text": "ובתו\"ח153"
        },
        {
          "s": 30,
          "text": "בפירוש ושבתי בשלום אל בית אבי שהוא"
        },
        {
          "s": 31,
          "text": "(לא ענין התשובה דנה\"א,"
        },
        {
          "s": 32,
          "text": "כ\"א)"
        },
        {
          "s": 33,
          "text": "התשובה דאתכפיא ואתהפכא סט\"א מחשוכא לנהורא,"
        },
        {
          "s": 34,
          "text": "כי הצחוק והתענוג שלמעלה"
        },
        {
          "s": 35,
          "text": "(אל בית אבי יצחק מלשון צחוק ותענוג)"
        },
        {
          "s": 36,
          "text": "נעשה בעיקר ע\"י אתכפיא ואתהפכא."
        }
      ]
    }
  ]
}