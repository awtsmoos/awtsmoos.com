{
  "globalIndex": 439,
  "owner": 39,
  "jobId": "_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916270_theRebbe_968__p001",
  "batchId": "meluket-_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916270_theRebbe_968__p001",
  "seriesId": "טבת_meluket",
  "postId": "BH_POST_1766518916270_theRebbe_968",
  "title": "מאמר היושבת בגנים תשי\"ג",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ שמות,"
        },
        {
          "s": 2,
          "text": "כ\"ג טבת*,"
        },
        {
          "s": 3,
          "text": "מבה\"ח שבט,"
        },
        {
          "s": 4,
          "text": "ה'תשי\"ג**"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "היושבת בגנים גו' ברח דודי גו' על הרי בשמים1,"
        },
        {
          "s": 1,
          "text": "ומבאר אדמו\"ר"
        },
        {
          "s": 2,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 3,
          "text": "נ\"ע במאמרו ד\"ה זה2"
        },
        {
          "s": 4,
          "text": "שאמרו בכ\"ד טבת3"
        },
        {
          "s": 5,
          "text": "(יום ההילולא דאדמו\"ר הזקן),"
        },
        {
          "s": 6,
          "text": "שהיושבת בגנים מדבר בהגילוי דג\"ע4,"
        },
        {
          "s": 7,
          "text": "גנים"
        },
        {
          "s": 8,
          "text": "(לשון רבים)"
        },
        {
          "s": 9,
          "text": "הם5"
        },
        {
          "s": 10,
          "text": "ג\"ע התחתון וג\"ע העליון שהם בבי\"ע"
        },
        {
          "s": 11,
          "text": "(געה\"ת בעשי' וגעה\"ע בבריאה6)"
        },
        {
          "s": 12,
          "text": "והיושבת בגנים היינו7"
        },
        {
          "s": 13,
          "text": "מלכות דאצילות שמצמצמת עצמה לישב בהגנים,"
        },
        {
          "s": 14,
          "text": "וברח דודי גו' על הרי בשמים מדבר בהגילוי דלע\"ל,"
        },
        {
          "s": 15,
          "text": "שהוא נעלה הרבה יותר ועד באין ערוך מהגילוי דג\"ע,"
        },
        {
          "s": 16,
          "text": "דהגילוי דג\"ע הוא אור הממלא והגילוי דלע\"ל הוא אור הסובב."
        },
        {
          "s": 17,
          "text": "דזהו מ\"ש ברח גו' על הרי בשמים"
        },
        {
          "s": 18,
          "text": "(ברח דוקא),"
        },
        {
          "s": 19,
          "text": "שהעלי' מהגילוי דג\"ע להגילוי דלע\"ל היא בדרך בריחה ודילוג שלא בסדר והדרגה."
        },
        {
          "s": 20,
          "text": "ואעפ\"כ,"
        },
        {
          "s": 21,
          "text": "בכדי לקבל גילוי אור הסובב דלע\"ל,"
        },
        {
          "s": 22,
          "text": "הוא דוקא ע\"י קדימת הגילוי דאור הממלא שבג\"ע."
        },
        {
          "s": 23,
          "text": "וזהו היושבת בגנים"
        },
        {
          "s": 24,
          "text": "(ואח\"כ)"
        },
        {
          "s": 25,
          "text": "ברח דודי גו' על הרי בשמים,"
        },
        {
          "s": 26,
          "text": "שבתחילה צ\"ל הגילוי דהיושבת בגנים ועי\"ז דוקא מגיעים"
        },
        {
          "s": 27,
          "text": "(בדרך בריחה ודילוג)"
        },
        {
          "s": 28,
          "text": "להגילוי דהרי בשמים."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "וביאור הענין,"
        },
        {
          "s": 2,
          "text": "הנה החילוק בין אור הממלא לאור הסובב הוא,"
        },
        {
          "s": 3,
          "text": "דאור הסובב הוא אור פשוט,"
        },
        {
          "s": 4,
          "text": "ואור הממלא בא בהתחלקות,"
        },
        {
          "s": 5,
          "text": "אור החכמה אור החסד וכו'."
        },
        {
          "s": 6,
          "text": "ומבואר במאמר הנ\"ל,"
        },
        {
          "s": 7,
          "text": "דמזה שאור הממלא בא בהתחלקות,"
        },
        {
          "s": 8,
          "text": "אף שההתחלקות בפועל היא ע\"י שמתלבש בהכלים,"
        },
        {
          "s": 9,
          "text": "הכרח לומר,"
        },
        {
          "s": 10,
          "text": "שגם בהאור עצמו"
        },
        {
          "s": 11,
          "text": "(לפני התלבשותו בכלים)"
        },
        {
          "s": 12,
          "text": "יש שייכות להתחלקות."
        },
        {
          "s": 13,
          "text": "דהנה בפרדס8"
        },
        {
          "s": 14,
          "text": "מבואר,"
        },
        {
          "s": 15,
          "text": "דההתחלקות שנעשה באור ע\"י התלבשותו בכלים,"
        },
        {
          "s": 16,
          "text": "הוא רק בנוגע לפעולתו"
        },
        {
          "s": 17,
          "text": "(באיזה אופן הוא פועל בנבראים,"
        },
        {
          "s": 18,
          "text": "דכשמתלבש בכלי החסד הוא פועל פעולת החסד,"
        },
        {
          "s": 19,
          "text": "ועד\"ז בכל הספירות),"
        },
        {
          "s": 20,
          "text": "אבל האור עצמו נשאר בפשיטות שלו."
        },
        {
          "s": 21,
          "text": "ועפ\"ז הי' אפשר לומר,"
        },
        {
          "s": 22,
          "text": "שהאור מצד עצמו"
        },
        {
          "s": 23,
          "text": "(לפני התלבשותו בכלים)"
        },
        {
          "s": 24,
          "text": "הוא פשוט לגמרי"
        },
        {
          "s": 25,
          "text": "(שאין לו כל שייכות להתחלקות),"
        },
        {
          "s": 26,
          "text": "וכמשל אור השמש"
        },
        {
          "s": 27,
          "text": "(המובא בפרדס8),"
        },
        {
          "s": 28,
          "text": "דעם היות שמצד עצמו הוא אור פשוט"
        },
        {
          "s": 29,
          "text": "(שהרי אור הוא מעין המאור ודבוק בהמאור),"
        },
        {
          "s": 30,
          "text": "מ\"מ כשמאיר ע\"י זכוכית לבנה אדומה או ירוקה,"
        },
        {
          "s": 31,
          "text": "הוא נראה"
        },
        {
          "s": 32,
          "text": "(ופועל)"
        },
        {
          "s": 33,
          "text": "כפי גוון הכלי."
        },
        {
          "s": 34,
          "text": "אמנם לכאורה ביאור זה אינו מספיק9."
        },
        {
          "s": 35,
          "text": "שהרי ידוע10,"
        },
        {
          "s": 36,
          "text": "דאור הסובב,"
        },
        {
          "s": 37,
          "text": "גם כשמאיר בתוך הכלים,"
        },
        {
          "s": 38,
          "text": "אין הכלי פועל בו שינוי,"
        },
        {
          "s": 39,
          "text": "אפילו שיהי' רק נראה כפי אופן הכלי"
        },
        {
          "s": 40,
          "text": "[וכמובא גם במאמר הנ\"ל,"
        },
        {
          "s": 41,
          "text": "שהאור דעתיק11,"
        },
        {
          "s": 42,
          "text": "גם כמו שהוא נמשך בז\"א,"
        },
        {
          "s": 43,
          "text": "הוא בבחינת פשיטות]."
        },
        {
          "s": 44,
          "text": "ומזה מוכח10,"
        },
        {
          "s": 45,
          "text": "דזה שבאור הממלא נעשה"
        },
        {
          "s": 46,
          "text": "(ע\"י הכלים)"
        },
        {
          "s": 47,
          "text": "ציור והתחלקות"
        },
        {
          "s": 48,
          "text": "(בנוגע לפעולתו עכ\"פ)"
        },
        {
          "s": 49,
          "text": "הוא מפני שאור זה"
        },
        {
          "s": 50,
          "text": "(גם לפני התלבשותו בכלים)"
        },
        {
          "s": 51,
          "text": "הוא בגדר התחלקות."
        }
      ]
    }
  ]
}