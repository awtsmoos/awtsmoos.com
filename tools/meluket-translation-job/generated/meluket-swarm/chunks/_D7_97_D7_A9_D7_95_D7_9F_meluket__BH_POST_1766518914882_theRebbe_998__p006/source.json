{
  "globalIndex": 192,
  "owner": 42,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914882_theRebbe_998__p006",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914882_theRebbe_998__p006",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518914882_theRebbe_998",
  "title": "מאמר ויהיו חיי שרה תש\"ל",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "ולהוסיף,"
        },
        {
          "s": 1,
          "text": "דע\"י המשכת בחינת מאה שנה"
        },
        {
          "s": 2,
          "text": "(מלך עילאה)"
        },
        {
          "s": 3,
          "text": "בחיצוניות המלכות ובפרט בבי\"ע,"
        },
        {
          "s": 4,
          "text": "נעשה בו עלי'."
        },
        {
          "s": 5,
          "text": "דמלך עילאה מצד עצמו הוא אור"
        },
        {
          "s": 6,
          "text": "(אלא שהוא אור שלמעלה מהמשכה וגילוי),"
        },
        {
          "s": 7,
          "text": "וע\"י המשכתו למטה,"
        },
        {
          "s": 8,
          "text": "מתגלית בו כוונת העצמות."
        },
        {
          "s": 9,
          "text": "ועפ\"ז,"
        },
        {
          "s": 10,
          "text": "סדר הענינים שבכתוב הוא מלמטה למעלה,"
        },
        {
          "s": 11,
          "text": "הן בנוגע לשרה,"
        },
        {
          "s": 12,
          "text": "דכל מה שנתעלתה לדרגא עליונה יותר המשיכה בחינת מאה שנה למטה יותר,"
        },
        {
          "s": 13,
          "text": "וגם בנוגע להענין דמאה שנה עצמו,"
        },
        {
          "s": 14,
          "text": "שע\"י המשכתו למטה נעשה בו עלי'."
        },
        {
          "s": 15,
          "text": "וזהו שני חיי שרה כולן שוין לטובה40,"
        },
        {
          "s": 16,
          "text": "דהאור מצד עצמו הוא בחינת מאה שנה,"
        },
        {
          "s": 17,
          "text": "מאה הו\"ע התחלקות פרטים אלא שכולם הם מתאחדים כאחד,"
        },
        {
          "s": 18,
          "text": "שנה לשון יחיד,"
        },
        {
          "s": 19,
          "text": "ולאח\"ז נאמר שני חיי שרה ולא נזכר מספר,"
        },
        {
          "s": 20,
          "text": "למעלה מגדר התחלקות."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "וממשיך הכתוב בקרית ארבע היא חברון,"
        },
        {
          "s": 1,
          "text": "דלאחרי המשכת בחינת מאה שנה בבי\"ע,"
        },
        {
          "s": 2,
          "text": "נמשך גילוי זה בגוף הגשמי שמחובר"
        },
        {
          "s": 3,
          "text": "(חברון)"
        },
        {
          "s": 4,
          "text": "מארבע יסודות41,"
        },
        {
          "s": 5,
          "text": "ועי\"ז מיתוסף בהחיבור דהנשמה והגוף42"
        },
        {
          "s": 6,
          "text": "לאריכות ימים ושנים טובות,"
        },
        {
          "s": 7,
          "text": "תורה ומצוות יאָרן43,"
        },
        {
          "s": 8,
          "text": "חסידישע יאָרן,"
        },
        {
          "s": 9,
          "text": "ובאופן דהרחבה עד למרחב העצמי,"
        },
        {
          "s": 10,
          "text": "והולכים לקראת משיח צדקנו,"
        },
        {
          "s": 11,
          "text": "ובאופן דשמחת עולם על ראשם44."
        }
      ]
    }
  ]
}