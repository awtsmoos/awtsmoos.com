{
  "globalIndex": 856,
  "owner": 6,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918840_theRebbe_178__p003",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918840_theRebbe_178__p003",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918840_theRebbe_178",
  "title": "מאמר רני ושמחי תשכ\"ז",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ויש להוסיף,"
        },
        {
          "s": 1,
          "text": "שהמעלה דהעבודה דבתי על העבודה דאחותי ואמי היא גם בנוגע להאדם העובד."
        },
        {
          "s": 2,
          "text": "שבהעבודה דאחותי ואמי נרגש בדקות מציאותו של האדם העובד,"
        },
        {
          "s": 3,
          "text": "גודל העילוי דהעבודה שלו"
        },
        {
          "s": 4,
          "text": "[העילוי דהעבודה עצמה"
        },
        {
          "s": 5,
          "text": "(העבודה דעסק התורה,"
        },
        {
          "s": 6,
          "text": "ומכש\"כ העבודה דמס\"נ),"
        },
        {
          "s": 7,
          "text": "והעילוי שנעשה ע\"י עבודתו,"
        },
        {
          "s": 8,
          "text": "שנעשה אח להקב\"ה ויתירה מזו שמשפיע כביכול בהקב\"ה],"
        },
        {
          "s": 9,
          "text": "ובהעבודה דבתי"
        },
        {
          "s": 10,
          "text": "(קיום המצוות)"
        },
        {
          "s": 11,
          "text": "נרגש הביטול שלו23,"
        },
        {
          "s": 12,
          "text": "הן בנוגע להעבודה עצמה,"
        },
        {
          "s": 13,
          "text": "שכל עבודתו היא רק לקיים ציווי הקב\"ה,"
        },
        {
          "s": 14,
          "text": "והן בנוגע לההמשכה שע\"י עבודתו,"
        },
        {
          "s": 15,
          "text": "דזה שע\"י קיום המצוות נמשך עצמות אוא\"ס הוא לא מצד ענינו של האדם המקיים את המצוות אלא מפני שהמצוות הם רצון וציווי העצמות."
        },
        {
          "s": 16,
          "text": "ויש לומר,"
        },
        {
          "s": 17,
          "text": "דע\"י הביטול הוא נעשה כלי להאור שנמשך ע\"י המצוות."
        },
        {
          "s": 18,
          "text": "וזהו כי הנני בא ושכנתי בתוכך,"
        },
        {
          "s": 19,
          "text": "שההמשכה דהנני בא,"
        },
        {
          "s": 20,
          "text": "אני בעצמי כביכול,"
        },
        {
          "s": 21,
          "text": "היא בתוכך,"
        },
        {
          "s": 22,
          "text": "בפנימיות."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וצריך להבין,"
        },
        {
          "s": 2,
          "text": "דכיון שאמי היא העבודה דמס\"נ,"
        },
        {
          "s": 3,
          "text": "דמס\"נ הו\"ע הביטול,"
        },
        {
          "s": 4,
          "text": "ובפרט לפי המובא לעיל"
        },
        {
          "s": 5,
          "text": "(סעיף ב)"
        },
        {
          "s": 6,
          "text": "דהעטרה שעטרה כנס\"י"
        },
        {
          "s": 7,
          "text": "(אמו)"
        },
        {
          "s": 8,
          "text": "להקב\"ה הוא ע\"י שהקדימו נעשה לנשמע,"
        },
        {
          "s": 9,
          "text": "שהביטול דהקדמת נעשה לנשמע הוא הביטול לבעל הרצון24,"
        },
        {
          "s": 10,
          "text": "מהי המעלה בהביטול דבתי על הביטול דאמי."
        },
        {
          "s": 11,
          "text": "ויש לומר בזה,"
        },
        {
          "s": 12,
          "text": "שהביטול דהקדמת נעשה לנשמע,"
        },
        {
          "s": 13,
          "text": "הוא שישראל קיבלו עליהם עול מלכות שמים."
        },
        {
          "s": 14,
          "text": "ולכן,"
        },
        {
          "s": 15,
          "text": "אף שהביטול דקבלת עול מלכות שמים הוא"
        },
        {
          "s": 16,
          "text": "(לא רק בנוגע לכח המעשה שלו,"
        },
        {
          "s": 17,
          "text": "שיעשה כל מה שיצטווה,"
        },
        {
          "s": 18,
          "text": "אלא גם)"
        },
        {
          "s": 19,
          "text": "בעצם מציאותו25,"
        },
        {
          "s": 20,
          "text": "שכל מציאותו הוא זה שהוא עבדו של המלך,"
        },
        {
          "s": 21,
          "text": "מלך מלכי המלכים הקב\"ה,"
        },
        {
          "s": 22,
          "text": "מ\"מ,"
        },
        {
          "s": 23,
          "text": "כיון שהקבלת עול מלכות שמים באה מצד האדם,"
        },
        {
          "s": 24,
          "text": "שהוא קיבל עליו להיות עבדו של המלך,"
        },
        {
          "s": 25,
          "text": "הרי בביטול זה מעורבת גם מציאותו של האדם"
        },
        {
          "s": 26,
          "text": "[ועד\"ז הוא בנוגע להמס\"נ דבחי' אמי,"
        },
        {
          "s": 27,
          "text": "שהמס\"נ היא מצד טבע הנשמה26]."
        },
        {
          "s": 28,
          "text": "ואמיתית הביטול הוא כשהביטול הוא מצד האדון."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דזהו מ\"ש27"
        },
        {
          "s": 2,
          "text": "כי לי בני ישראל עבדים עבדי הם אשר הוצאתי אותם מארץ מצרים,"
        },
        {
          "s": 3,
          "text": "דזה שישראל הם עבדים של הקב\"ה הוא"
        },
        {
          "s": 4,
          "text": "(לא רק מפני שהם קיבלו עול מלכותו ית',"
        },
        {
          "s": 5,
          "text": "אלא גם)"
        },
        {
          "s": 6,
          "text": "מפני שהקב\"ה הוציא אותם מארץ מצרים,"
        },
        {
          "s": 7,
          "text": "שעי\"ז הם מוכרחים להיות עבדים28."
        },
        {
          "s": 8,
          "text": "וענין זה נמשך בעיקר בשעת מתן תורה29."
        }
      ]
    }
  ]
}