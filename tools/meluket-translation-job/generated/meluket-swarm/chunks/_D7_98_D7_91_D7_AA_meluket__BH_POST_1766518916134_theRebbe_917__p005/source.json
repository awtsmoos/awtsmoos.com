{
  "globalIndex": 416,
  "owner": 16,
  "jobId": "_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916134_theRebbe_917__p005",
  "batchId": "meluket-_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916134_theRebbe_917__p005",
  "seriesId": "טבת_meluket",
  "postId": "BH_POST_1766518916134_theRebbe_917",
  "title": "מאמר ויגש אליו יהודה תשכ\"ה",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 1,
          "text": "דזה שלפעמים המשכת השפע היא בהעלם הוא מפני ריבוי המסכים המבדילים."
        },
        {
          "s": 2,
          "text": "והיינו,"
        },
        {
          "s": 3,
          "text": "דזה שהשפע הוא בהעלם הוא לא מצד אופן ההמשכה"
        },
        {
          "s": 4,
          "text": "(שההמשכה היא בדרגא דהעלם שלמעלה מגילוי49),"
        },
        {
          "s": 5,
          "text": "אלא,"
        },
        {
          "s": 6,
          "text": "שההעלם הוא מצד המסכים המעלימים."
        },
        {
          "s": 7,
          "text": "ובדוגמת נתינת מתנה בכלי סגור,"
        },
        {
          "s": 8,
          "text": "שהמתנה היא בשלימות בהכלי,"
        },
        {
          "s": 9,
          "text": "אלא שמצד המסך דהכלי אי אפשר לקחת אותה בגלוי."
        },
        {
          "s": 10,
          "text": "ומוסיף בהמאמר,"
        },
        {
          "s": 11,
          "text": "שההשפעות שנמשכו ע\"י כל התפלות,"
        },
        {
          "s": 12,
          "text": "לא רק שישנם בשלימות בהעלם אלא שסוף סוף יהיו גם בגילוי."
        },
        {
          "s": 13,
          "text": "דכשיתעוררו כל ישראל בתשובה שלימה ויבטלו כל המסכים,"
        },
        {
          "s": 14,
          "text": "יתגלו אז כל ההמשכות דכל התפלות שבמשך כל הדורות."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וצריך להבין,"
        },
        {
          "s": 2,
          "text": "דהטעם שע\"י תפלה נמשך אור שלמעלה מהשתלשלות שעל ידו נעשה שינוי בהנבראים"
        },
        {
          "s": 3,
          "text": "(לרפאות החולים ולברך השנים)"
        },
        {
          "s": 4,
          "text": "הוא מצד ההעלאת מ\"ן שבתפלה42,"
        },
        {
          "s": 5,
          "text": "דענין העלאת מ\"ן שבתפלה הוא לכאורה כשהתפלה היא בכוונה ובביטול,"
        },
        {
          "s": 6,
          "text": "ובהמאמר מבואר שע\"י כל תפלה נעשה שינוי בהנבראים"
        },
        {
          "s": 7,
          "text": "(אלא שהוא בהעלם)."
        },
        {
          "s": 8,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 9,
          "text": "דבעת שישראל מתפלל"
        },
        {
          "s": 10,
          "text": "(גם כשאינו מכוון בתפלתו),"
        },
        {
          "s": 11,
          "text": "בפנימיותו הוא כעומד לפני המלך,"
        },
        {
          "s": 12,
          "text": "אלא שזהו בהעלם."
        },
        {
          "s": 13,
          "text": "ולכן,"
        },
        {
          "s": 14,
          "text": "כל תפלה דישראל היא העלאת מ\"ן שמעוררת וממשכת האור שלמעלה מהשתלשלות לשנות את הנבראים."
        },
        {
          "s": 15,
          "text": "אלא שההמשכה והשינוי למטה"
        },
        {
          "s": 16,
          "text": "(מילוי הבקשה)"
        },
        {
          "s": 17,
          "text": "שע\"י העלאת מ\"ן זה הוא בהעלם."
        },
        {
          "s": 18,
          "text": "וכל שהכוונה והביטול שבתפלה הם בגילוי יותר,"
        },
        {
          "s": 19,
          "text": "מילוי הבקשה הוא בגילוי יותר."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר43,"
        },
        {
          "s": 2,
          "text": "שעפ\"ז יובן מה דאיתא בגמרא50"
        },
        {
          "s": 3,
          "text": "שכששמע רבי מאליהו הנביא שר' חייא ובניו הם דוגמת האבות,"
        },
        {
          "s": 4,
          "text": "העמיד אותם רבי לפני התיבה,"
        },
        {
          "s": 5,
          "text": "אמר משיב הרוח ונשיב זיקא,"
        },
        {
          "s": 6,
          "text": "מוריד הגשם ואתא מיטרא,"
        },
        {
          "s": 7,
          "text": "כי מטי למימר מחי' המתים רגש עלמא."
        },
        {
          "s": 8,
          "text": "וצריך להבין,"
        },
        {
          "s": 9,
          "text": "דר\"ח ובניו היו מתפללים בכל יום,"
        },
        {
          "s": 10,
          "text": "ואעפ\"כ ההמשכה שע\"י תפלתם"
        },
        {
          "s": 11,
          "text": "(נשיב זיקא,"
        },
        {
          "s": 12,
          "text": "אתא מיטרא,"
        },
        {
          "s": 13,
          "text": "רגש עלמא)"
        },
        {
          "s": 14,
          "text": "היתה דוקא כשהעמיד אותם רבי לפני התיבה."
        },
        {
          "s": 15,
          "text": "ולכאורה הי' אפשר לומר,"
        },
        {
          "s": 16,
          "text": "דע\"י שהתפללו לפני התיבה והיו שלוחי ציבור,"
        },
        {
          "s": 17,
          "text": "הי' בתפלתם כח הציבור,"
        },
        {
          "s": 18,
          "text": "ותפלת ציבור היא רצוי' ומקובלת לעולם,"
        },
        {
          "s": 19,
          "text": "דגם כשישנם מסכים ההמשכה היא בגילוי51."
        },
        {
          "s": 20,
          "text": "אבל ביאור זה אינו מספיק,"
        },
        {
          "s": 21,
          "text": "כי גם תפלת ציבור,"
        },
        {
          "s": 22,
          "text": "גם כשהשליח ציבור הוא אדם גדול ביותר,"
        },
        {
          "s": 23,
          "text": "אין בכחה לפעול בגילוי שינוי גדול בהבריאה,"
        },
        {
          "s": 24,
          "text": "ובפרט השינוי דתחיית המתים,"
        },
        {
          "s": 25,
          "text": "כשישנם מסכים המעלימים."
        },
        {
          "s": 26,
          "text": "ומבאר בהמאמר,"
        },
        {
          "s": 27,
          "text": "דע\"י שהעמיד אותם רבי לפני התיבה ונעשו שלוחי ציבור דכלל ישראל,"
        },
        {
          "s": 28,
          "text": "שברו"
        },
        {
          "s": 29,
          "text": "(ע\"י תפלתם)"
        },
        {
          "s": 30,
          "text": "את המסכים."
        },
        {
          "s": 31,
          "text": "דנוסף לזה שהציבור שהיו בשעת תפלתם כולם התעוררו מאד,"
        },
        {
          "s": 32,
          "text": "הנה גם המסכים מצד אלו שלא היו שם ולא נתעוררו,"
        },
        {
          "s": 33,
          "text": "שברו ר\"ח ובניו ע\"י תפלתם,"
        },
        {
          "s": 34,
          "text": "מכיון שתפלתם היתה בתור שלוחי ציבור דכל ישראל,"
        },
        {
          "s": 35,
          "text": "גם של אלו שלא נתעוררו."
        }
      ]
    }
  ]
}