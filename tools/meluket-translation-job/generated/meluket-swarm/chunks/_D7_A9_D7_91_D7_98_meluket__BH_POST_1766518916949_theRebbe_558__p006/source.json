  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916949_theRebbe_558__p006",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916949_theRebbe_558",
  "title": "מאמר באתי לגני תש\"מ",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "וזה נותן כח על עבודת הבירורים בזמן הגלות,"
        },
        {
          "s": 1,
          "text": "און מיטנעמען כל הענינים,"
        },
        {
          "s": 2,
          "text": "כלי כסף וכלי זהב ושמלות75,"
        },
        {
          "s": 3,
          "text": "בגאולה העתידה שתהי' ביד רמה"
        },
        {
          "s": 4,
          "text": "(כמו שהיתה הגאולה דיציאת מצרים,"
        },
        {
          "s": 5,
          "text": "כמ\"ש76"
        },
        {
          "s": 6,
          "text": "כימי צאתך מארץ מצרים אראנו נפלאות)"
        },
        {
          "s": 7,
          "text": "שע\"י מעשינו ועבודתינו במשך זמן הגלות77"
        },
        {
          "s": 8,
          "text": "ובפרט בעקבתא דמשיחא יהי' ובני ישראל יוצאים ביד רמה לקבל פני משיח צדקנו,"
        },
        {
          "s": 9,
          "text": "במהרה בימינו ממש."
        }
      ]
    }
  ]
}