  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914964_theRebbe_974__p006",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914964_theRebbe_974__p006",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518914964_theRebbe_974",
  "title": "מאמר ויהיו חיי שרה תשמ\"ה",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "ולהוסיף,"
        },
        {
          "s": 1,
          "text": "דע\"פ הידוע59"
        },
        {
          "s": 2,
          "text": "בביאור לשון חז\"ל60"
        },
        {
          "s": 3,
          "text": "תשובה ומעשים טובים,"
        },
        {
          "s": 4,
          "text": "שעל ידי התשובה המעשים"
        },
        {
          "s": 5,
          "text": "(דהמצוות)"
        },
        {
          "s": 6,
          "text": "הם טובים ומאירים,"
        },
        {
          "s": 7,
          "text": "יש לומר,"
        },
        {
          "s": 8,
          "text": "דעל ידי שהתשובה היא בשמחה שאז התשובה היא בשלימות,"
        },
        {
          "s": 9,
          "text": "עי\"ז מיתוסף בהשמחה ובהשלימות דלימוד התורה וקיום המצוות שלאחרי התשובה."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "וענין זה"
        },
        {
          "s": 1,
          "text": "[פעולת התשובה בהתומ\"צ"
        },
        {
          "s": 2,
          "text": "(עבודת הצדיקים)"
        },
        {
          "s": 3,
          "text": "שלאחרי התשובה]"
        },
        {
          "s": 4,
          "text": "הוא הכנה קרובה לגאולה האמיתית והשלימה ע\"י משיח צדקנו,"
        },
        {
          "s": 5,
          "text": "שאתא לאתבא צדיקייא בתיובתא61."
        },
        {
          "s": 6,
          "text": "ועד\"ז הוא בנוגע לגאולה העתידה שיהיו בה שני הענינים,"
        },
        {
          "s": 7,
          "text": "כמ\"ש62"
        },
        {
          "s": 8,
          "text": "בשובה ונחת תושעון,"
        },
        {
          "s": 9,
          "text": "בשובה הו\"ע עבודת התשובה63,"
        },
        {
          "s": 10,
          "text": "ובנחת הו\"ע עבודת הצדיקים64."
        },
        {
          "s": 11,
          "text": "ובפשטות,"
        },
        {
          "s": 12,
          "text": "שכל ישראל,"
        },
        {
          "s": 13,
          "text": "בנערינו ובזקנינו גו' בבנינו ובבנותינו65"
        },
        {
          "s": 14,
          "text": "[שלימות העם],"
        },
        {
          "s": 15,
          "text": "ישובו לארצנו הקדושה,"
        },
        {
          "s": 16,
          "text": "וכמו שהיא ארץ טובה ורחבה"
        },
        {
          "s": 17,
          "text": "[שלימות הארץ],"
        },
        {
          "s": 18,
          "text": "ביחד עם התורה ומצוות"
        },
        {
          "s": 19,
          "text": "(עבודת הצדיקים)."
        },
        {
          "s": 20,
          "text": "וע\"י שהתומ\"צ הם ע\"י קדימת התשובה,"
        },
        {
          "s": 21,
          "text": "גם התומ\"צ הם בשלימות"
        },
        {
          "s": 22,
          "text": "[שלימות התורה ומצוותי']."
        },
        {
          "s": 23,
          "text": "וכל זה – כלשון הידוע בנוגע לתשובה – בשעתא חדא וברגעא חדא66."
        }
      ]
    }
  ]
}