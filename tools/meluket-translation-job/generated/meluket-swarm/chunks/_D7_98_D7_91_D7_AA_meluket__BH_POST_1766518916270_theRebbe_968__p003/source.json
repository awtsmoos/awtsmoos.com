{
  "globalIndex": 441,
  "owner": 41,
  "jobId": "_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916270_theRebbe_968__p003",
  "batchId": "meluket-_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916270_theRebbe_968__p003",
  "seriesId": "טבת_meluket",
  "postId": "BH_POST_1766518916270_theRebbe_968",
  "title": "מאמר היושבת בגנים תשי\"ג",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 2,
          "text": "דע\"פ המבואר במ\"א34"
        },
        {
          "s": 3,
          "text": "דאלקינו אלוקה שלנו הוא שם הוי' שבכאו\"א מישראל,"
        },
        {
          "s": 4,
          "text": "חלק הוי' עמו35,"
        },
        {
          "s": 5,
          "text": "מובן עוד יותר דאלקינו מחבר ב' השמות,"
        },
        {
          "s": 6,
          "text": "דע\"י העבודה דישראל בד' אותיות הוי' שבנפש,"
        },
        {
          "s": 7,
          "text": "נעשה החיבור דב' השמות,"
        },
        {
          "s": 8,
          "text": "שבהוי' דלתתא מאיר הגילוי דהוי' דלעילא."
        },
        {
          "s": 9,
          "text": "ומבאר שם,"
        },
        {
          "s": 10,
          "text": "דענין היו\"ד דשם הוי' שבנפש הוא הנחת עצמותו,"
        },
        {
          "s": 11,
          "text": "אז ער לייגט זיך אוועק לגמרי צו אלקות ואינו מתחשב עם שכלו."
        },
        {
          "s": 12,
          "text": "דלא זו בלבד דגם כשהשכל שלו מחייב באופן אחר אינו מתחשב עם זה"
        },
        {
          "s": 13,
          "text": "(כולל גם זה שאינו מתחשב עם זה שיאמרו עליו שהנהגתו היא היפך השכל),"
        },
        {
          "s": 14,
          "text": "אלא יתירה מזו,"
        },
        {
          "s": 15,
          "text": "דזה שמניח את עצמו לאלקות הוא לא מצד זה ששכלו מחייב כן"
        },
        {
          "s": 16,
          "text": "(כמבואר במ\"א36"
        },
        {
          "s": 17,
          "text": "שהשכל עצמו מחייב שישנם ענינים שלמעלה מהשכל),"
        },
        {
          "s": 18,
          "text": "כי אם,"
        },
        {
          "s": 19,
          "text": "שמניח את עצמו לאלקות בלי שום חשבונות."
        },
        {
          "s": 20,
          "text": "וענין הה' ראשונה הוא ההתבוננות איך שכל הגילויים שבעולמות,"
        },
        {
          "s": 21,
          "text": "אפילו הגילוי דסוכ\"ע ומכ\"ש הגילוי דממכ\"ע,"
        },
        {
          "s": 22,
          "text": "הם רק הארה בלבד שנמשכה ע\"י כמה וכמה צמצומים37."
        },
        {
          "s": 23,
          "text": "ועי\"ז נעשה לו צר ביותר,"
        },
        {
          "s": 24,
          "text": "עס ווערט אים זייער ענג,"
        },
        {
          "s": 25,
          "text": "ובפרט כשמתבונן במעמדו ומצבו הפרטי איך שהוא מרוחק מאלקות"
        },
        {
          "s": 26,
          "text": "[שהסיבה לזה שהוא נמצא במצב כזה היא מפני שהאור והגילוי שמאיר בכללות העולמות הוא רק הארה מצומצמת,"
        },
        {
          "s": 27,
          "text": "שכל שההארה נמשכת למטה יותר היא מתצמצמת יותר38,"
        },
        {
          "s": 28,
          "text": "שזוהי הסיבה לזה שבא למצב כזה],"
        },
        {
          "s": 29,
          "text": "שמזה נעשה לו צר עוד יותר,"
        },
        {
          "s": 30,
          "text": "עס ווערט אים אזוי ענג ביז ער געפינט זיך קיין אָרט ניט."
        },
        {
          "s": 31,
          "text": "ויש לומר,"
        },
        {
          "s": 32,
          "text": "שבכדי שיונח אצלו"
        },
        {
          "s": 33,
          "text": "(עס זאָל זיך אָפּלייגן)"
        },
        {
          "s": 34,
          "text": "באמת הבנה והשגה זו צריך להיות תחילה הביטול דהנחת עצמותו."
        },
        {
          "s": 35,
          "text": "דמכיון שהשכל הוא מציאות,"
        },
        {
          "s": 36,
          "text": "הנה מצד השכל גופא אי אפשר שיונח אצלו באמת"
        },
        {
          "s": 37,
          "text": "(ועד באופן שיהי' לו צר מזה)"
        },
        {
          "s": 38,
          "text": "איך שכל המציאות דכל ההשתלשלות רחוק כו',"
        },
        {
          "s": 39,
          "text": "ולכן צריך להיות תחילה הביטול דהנחת עצמותו שלמעלה מהשכל,"
        },
        {
          "s": 40,
          "text": "ענין היו\"ד,"
        },
        {
          "s": 41,
          "text": "נקודה בלבד,"
        },
        {
          "s": 42,
          "text": "וזה פועל גם על השכל שיתאים להנקודה,"
        },
        {
          "s": 43,
          "text": "נקודה בהיכלא39."
        },
        {
          "s": 44,
          "text": "וענין הוא\"ו דשם הוי' שבנפש הו\"ע עסק התורה40."
        },
        {
          "s": 45,
          "text": "דלאחרי ההתבוננות"
        },
        {
          "s": 46,
          "text": "(העבודה דה' ראשונה)"
        },
        {
          "s": 47,
          "text": "שכללות הגילויים שבעולמות הם רק הארה מצומצמת,"
        },
        {
          "s": 48,
          "text": "שמזה נעשה צר לו מאד"
        },
        {
          "s": 49,
          "text": "(כנ\"ל),"
        },
        {
          "s": 50,
          "text": "הנה ויצעקו אל הוי' בצר להם41,"
        },
        {
          "s": 51,
          "text": "שצועק"
        },
        {
          "s": 52,
          "text": "(ומתפלל)"
        },
        {
          "s": 53,
          "text": "אל הוי' שיהי' הגילוי דעצמות אוא\"ס שלמעלה מהצמצום,"
        },
        {
          "s": 54,
          "text": "וזה מביא אותו לעסק התורה,"
        },
        {
          "s": 55,
          "text": "שעי\"ז מאיר לו הגילוי דעצמות אוא\"ס."
        },
        {
          "s": 56,
          "text": "דהגם שאורייתא מחכמה נפקת42,"
        },
        {
          "s": 57,
          "text": "הרי ידוע הדיוק דבעל ההילולא"
        },
        {
          "s": 58,
          "text": "(דכ\"ד טבת)43,"
        },
        {
          "s": 59,
          "text": "דמלשון זה עצמו"
        },
        {
          "s": 60,
          "text": "(אורייתא מחכמה נפקת,"
        },
        {
          "s": 61,
          "text": "נפקת דוקא)"
        },
        {
          "s": 62,
          "text": "מובן ששרש התורה הוא רצון העליון וכו' שלמעלה מהחכמה,"
        },
        {
          "s": 63,
          "text": "ורק שאח\"כ באה בחכמה ומשם היא נפקת בבחי' גילוי."
        },
        {
          "s": 64,
          "text": "וענין ה' אחרונה דשם הוי' שבנפש הוא מעשה המצוות40,"
        },
        {
          "s": 65,
          "text": "שזה בא לאחרי העבודה דוא\"ו,"
        },
        {
          "s": 66,
          "text": "תורה,"
        },
        {
          "s": 67,
          "text": "כי בכדי לקיים המצוות כדבעי,"
        },
        {
          "s": 68,
          "text": "צריך לידע את המעשה אשר יעשה."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "והנה אף שהעבודה דמעשה המצוות היא ה' אחרונה שלמטה מעסק התורה שהוא הוא\"ו,"
        },
        {
          "s": 2,
          "text": "הרי מזה גופא מובן44"
        },
        {
          "s": 3,
          "text": "דיש מעלה במצוות לגבי תורה."
        },
        {
          "s": 4,
          "text": "וכמבואר בארוכה במאמר הנ\"ל,"
        },
        {
          "s": 5,
          "text": "שהתורה,"
        },
        {
          "s": 6,
          "text": "עם היות ששרשה הוא רצון העליון וכו' שלמעלה מהחכמה"
        },
        {
          "s": 7,
          "text": "(כנ\"ל),"
        },
        {
          "s": 8,
          "text": "הרי הרצון דתורה נתלבש בחכמה,"
        },
        {
          "s": 9,
          "text": "דמזה מוכח45"
        },
        {
          "s": 10,
          "text": "שרצון זה"
        },
        {
          "s": 11,
          "text": "(גם לפני התלבשותו בחכמה)"
        },
        {
          "s": 12,
          "text": "הוא רצון שמורכב באיזה דבר,"
        },
        {
          "s": 13,
          "text": "משא\"כ הרצון דמצוות הוא רצון שאינו מורכב בשום דבר."
        },
        {
          "s": 14,
          "text": "שהרצון דמצוות הוא בעשי' בפועל דוקא,"
        },
        {
          "s": 15,
          "text": "כי העשי' בפועל"
        },
        {
          "s": 16,
          "text": "(בגשמיות)"
        },
        {
          "s": 17,
          "text": "אינה בערך כלל,"
        },
        {
          "s": 18,
          "text": "ובמילא אין שייך לומר שהרצון נתלבש בהמעשה"
        },
        {
          "s": 19,
          "text": "(כי ענין ההתלבשות הוא בדבר שבערך דוקא),"
        },
        {
          "s": 20,
          "text": "ולכן הרצון שבמעשה הוא רצון שאינו מלובש ואינו מורכב בשום דבר46."
        },
        {
          "s": 21,
          "text": "וע\"י מעשה המצוות מיתוסף עילוי גם בההבנה וההשגה דתורה,"
        },
        {
          "s": 22,
          "text": "כמ\"ש47"
        },
        {
          "s": 23,
          "text": "טוב טעם ודעת למדני כי במצוותיך האמנתי,"
        },
        {
          "s": 24,
          "text": "דעל ידי קיום המצוות"
        },
        {
          "s": 25,
          "text": "(במצוותיך),"
        },
        {
          "s": 26,
          "text": "ובפרט כשקיום המצוות הוא לא מצד הטעם והכוונה ורק מצד אמונה פשוטה"
        },
        {
          "s": 27,
          "text": "(האמנתי),"
        },
        {
          "s": 28,
          "text": "מגיעים לטוב טעם ודעת שבתורה48."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "וזהו היושבת בגנים גו' ברח דודי גו' על הרי בשמים,"
        },
        {
          "s": 2,
          "text": "דהנה ידוע49"
        },
        {
          "s": 3,
          "text": "שהגילוי שבג\"ע הוא"
        },
        {
          "s": 4,
          "text": "(בעיקר)"
        },
        {
          "s": 5,
          "text": "זה שמתגלה להנשמות הפנימיות והאלקות של התורה שלמדו למטה,"
        },
        {
          "s": 6,
          "text": "משא\"כ הגילוי דאוא\"ס שנמשך ע\"י המצוות,"
        },
        {
          "s": 7,
          "text": "זה יתגלה בעיקר לע\"ל,"
        },
        {
          "s": 8,
          "text": "דשכר מצוות בהאי עלמא ליכא50,"
        },
        {
          "s": 9,
          "text": "שאז יהי' הגילוי דאור הסובב,"
        },
        {
          "s": 10,
          "text": "ועוד למעלה יותר שיהי' גילוי העצמות."
        },
        {
          "s": 11,
          "text": "וזהו שהגילויים דלע\"ל נק' הרי בשמים,"
        },
        {
          "s": 12,
          "text": "היינו הרים שבשמים51,"
        },
        {
          "s": 13,
          "text": "שמים הם מקיפים כל עלמין,"
        },
        {
          "s": 14,
          "text": "והרים שבשמים"
        },
        {
          "s": 15,
          "text": "(שגם בשמים הם הרים,"
        },
        {
          "s": 16,
          "text": "בולטים)"
        },
        {
          "s": 17,
          "text": "הו\"ע גילוי העצמות שלמעלה גם מסובב52."
        },
        {
          "s": 18,
          "text": "ואומר על זה ברח גו' על הרי בשמים,"
        },
        {
          "s": 19,
          "text": "כי הגילוי דממלא"
        },
        {
          "s": 20,
          "text": "(שבג\"ע)"
        },
        {
          "s": 21,
          "text": "לגבי גילוי הסובב"
        },
        {
          "s": 22,
          "text": "(שמים)"
        },
        {
          "s": 23,
          "text": "ומכ\"ש לגבי גילוי העצמות"
        },
        {
          "s": 24,
          "text": "(הרי בשמים)"
        },
        {
          "s": 25,
          "text": "הוא באין ערוך כלל"
        },
        {
          "s": 26,
          "text": "[דלגבי העצמות,"
        },
        {
          "s": 27,
          "text": "גם הסובב הוא אין ערוך."
        },
        {
          "s": 28,
          "text": "וכמ\"ש53"
        },
        {
          "s": 29,
          "text": "רבות עשית גו' נפלאותיך ומחשבותיך אלינו אין ערוך אליך גו',"
        },
        {
          "s": 30,
          "text": "רבות הם כללות כל הגילויים דסובב וממלא,"
        },
        {
          "s": 31,
          "text": "שנק' רבות ע\"ד מ\"ש בזהר54"
        },
        {
          "s": 32,
          "text": "מאי רבות גדולות עילאין ורברבין,"
        },
        {
          "s": 33,
          "text": "ועל זה אומר רבות עשית,"
        },
        {
          "s": 34,
          "text": "דכל הגילויים,"
        },
        {
          "s": 35,
          "text": "עם היותם רבות"
        },
        {
          "s": 36,
          "text": "(עילאין ורברבין),"
        },
        {
          "s": 37,
          "text": "הם כמו עשי' לגבי' ית'."
        },
        {
          "s": 38,
          "text": "וממשיך בכתוב נפלאותיך ומחשבותיך גו',"
        },
        {
          "s": 39,
          "text": "נפלאותיך הם הגילויים דסובב"
        },
        {
          "s": 40,
          "text": "(פלא,"
        },
        {
          "s": 41,
          "text": "שלמעלה מהשתלשלות)"
        },
        {
          "s": 42,
          "text": "ומחשבותיך הם הגילויים דממלא,"
        },
        {
          "s": 43,
          "text": "ואומר שכל הגילוי דנפלאותיך ומחשבותיך הוא רק אלינו,"
        },
        {
          "s": 44,
          "text": "אבל לגבי' ית' הם אין ערוך,"
        },
        {
          "s": 45,
          "text": "אין ערוך אליך."
        },
        {
          "s": 46,
          "text": "והמשכתם,"
        },
        {
          "s": 47,
          "text": "אגידה ואדברה"
        },
        {
          "s": 48,
          "text": "(הגדה ודיבור הו\"ע המשכה),"
        },
        {
          "s": 49,
          "text": "מעצמות אוא\"ס,"
        },
        {
          "s": 50,
          "text": "היא ע\"י ריבוי צמצומים,"
        },
        {
          "s": 51,
          "text": "עצמו מספר]."
        },
        {
          "s": 52,
          "text": "וכיון שהסובב ומכ\"ש העצמות הם למעלה מגילוי,"
        },
        {
          "s": 53,
          "text": "לכן הגילוי שלהם לע\"ל הוא ע\"י קדימת אור הממלא"
        },
        {
          "s": 54,
          "text": "(שמאיר בג\"ע)"
        },
        {
          "s": 55,
          "text": "שענינו"
        },
        {
          "s": 56,
          "text": "(דאור הממלא)"
        },
        {
          "s": 57,
          "text": "הוא גילוי,"
        },
        {
          "s": 58,
          "text": "ולכן על ידו דוקא,"
        },
        {
          "s": 59,
          "text": "גם הענינים שמצד עצמם הם בגדר העלם,"
        },
        {
          "s": 60,
          "text": "נמשכים בגילוי55."
        }
      ]
    }
  ]
}