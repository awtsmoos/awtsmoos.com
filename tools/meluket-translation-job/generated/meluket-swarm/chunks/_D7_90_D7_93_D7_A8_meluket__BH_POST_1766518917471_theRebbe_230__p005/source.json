{
  "globalIndex": 642,
  "owner": 42,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917471_theRebbe_230__p005",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917471_theRebbe_230__p005",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917471_theRebbe_230",
  "title": "מאמר בלילה ההוא תשכ\"ה",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ויש לקשר זה עם המבואר בהמאמר53"
        },
        {
          "s": 2,
          "text": "דע\"י שנדדה שנת המלך נעשה חיבור המקיף עם הפנימי,"
        },
        {
          "s": 3,
          "text": "שגם האור שלמעלה מהשתלשלות"
        },
        {
          "s": 4,
          "text": "(מקיף)"
        },
        {
          "s": 5,
          "text": "נמשך בפנימיות,"
        },
        {
          "s": 6,
          "text": "כי השרש דמקיף ופנימי הוא גילוי והעלם"
        },
        {
          "s": 7,
          "text": "[דמקיף הוא מצד הגילוי,"
        },
        {
          "s": 8,
          "text": "והפנימי שנמשך ע\"י צמצום הוא מצד ההעלם],"
        },
        {
          "s": 9,
          "text": "וע\"י המשכת העצמות שהיתה אז,"
        },
        {
          "s": 10,
          "text": "שעי\"ז נתחבר ההעלם והגילוי,"
        },
        {
          "s": 11,
          "text": "נעשה גם החיבור דמקיף ופנימי."
        },
        {
          "s": 12,
          "text": "ועי\"ז נמשך ישועה כללית לכלל ישראל54,"
        },
        {
          "s": 13,
          "text": "דבבחינת המקיף,"
        },
        {
          "s": 14,
          "text": "יש שייכות יותר להקליפות לקבל משם,"
        },
        {
          "s": 15,
          "text": "דזהו שעשה המן את העץ גבוה חמישים אמה55"
        },
        {
          "s": 16,
          "text": "שהגבי' עצמו לקבל משער הנו\"ן שלמעלה מהשתלשלות"
        },
        {
          "s": 17,
          "text": "(מקיף),"
        },
        {
          "s": 18,
          "text": "וע\"י שנמשך המקיף בפנימיות,"
        },
        {
          "s": 19,
          "text": "נעשה ליהודים היתה אורה ושמחה וששון ויקר56,"
        },
        {
          "s": 20,
          "text": "כן תהי' לנו57."
        }
      ]
    }
  ]
}