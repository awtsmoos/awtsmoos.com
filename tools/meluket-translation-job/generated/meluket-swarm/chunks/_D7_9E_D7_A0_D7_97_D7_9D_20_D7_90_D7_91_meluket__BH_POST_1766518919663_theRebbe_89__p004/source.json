{
  "globalIndex": 991,
  "owner": 41,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919663_theRebbe_89__p004",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919663_theRebbe_89__p004",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919663_theRebbe_89",
  "title": "מאמר ציון במשפט תפדה תשל\"ה",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ועד\"ז גם בבחי' עולם,"
        },
        {
          "s": 2,
          "text": "מקום,"
        },
        {
          "s": 3,
          "text": "שישנם בו שני ענינים הנ\"ל."
        },
        {
          "s": 4,
          "text": "דעולם האצי' הוא מבורר65"
        },
        {
          "s": 5,
          "text": "ועולמות בי\"ע עליהם נאמר ומשם יפרד ודוקא בעלמא דפרודא עולם העשי' העבודה דמצוות מעשיות."
        },
        {
          "s": 6,
          "text": "ועד\"ז א\"י אשר עיני ה\"א בה מרשית השנה ועד אחרית שנה66,"
        },
        {
          "s": 7,
          "text": "משא\"כ ארץ העמים שגושה טמא ואוירה טמא67,"
        },
        {
          "s": 8,
          "text": "הנה בכדי לעשות ארץ העמים לארץ ישראל68"
        },
        {
          "s": 9,
          "text": "צ\"ל העבודה הגדולה יותר דושבי' בצדקה."
        },
        {
          "s": 10,
          "text": "ועד\"ז הוא גם בבחי' שנה,"
        },
        {
          "s": 11,
          "text": "זמן,"
        },
        {
          "s": 12,
          "text": "שיש בו ג\"כ שני סוגים הנ\"ל."
        },
        {
          "s": 13,
          "text": "שבכללות הוא החילוק שבין זמן הקיץ לזמן החורף,"
        },
        {
          "s": 14,
          "text": "כמבואר במ\"א69"
        },
        {
          "s": 15,
          "text": "שבזמן הקיץ העבודה היא בנקל יותר מבזמן החורף,"
        },
        {
          "s": 16,
          "text": "שבימות החמה השמש זורח70"
        },
        {
          "s": 17,
          "text": "והוא בחי' שם הוי'"
        },
        {
          "s": 18,
          "text": "(והיו\"ט שבקיץ הם בתכיפות יותר)."
        },
        {
          "s": 19,
          "text": "וכדאיתא במדרש71"
        },
        {
          "s": 20,
          "text": "ע\"י שהן יוצאים מן הקיץ לחורף כו' למקום רחוק כו' לית בעונתה ליזיל ולמיתי."
        },
        {
          "s": 21,
          "text": "והיינו שהעבודה בזמן החורף היא רחוקה,"
        },
        {
          "s": 22,
          "text": "קשה יותר מבזמן הקיץ."
        },
        {
          "s": 23,
          "text": "ועד\"ז הוא החילוק שבין יומין זכאין לימים שהם היפך הזכות72."
        },
        {
          "s": 24,
          "text": "שהעבודה בימים דהיפך הזכות ה\"ה ע\"ד ושבי' בצדקה,"
        },
        {
          "s": 25,
          "text": "מה שישראל"
        },
        {
          "s": 26,
          "text": "(על ידי עבודתם)"
        },
        {
          "s": 27,
          "text": "מהפכים הימים האלה לששון ולשמחה,"
        },
        {
          "s": 28,
          "text": "בגאולה העתידה לבוא בקרוב ממש."
        },
        {
          "s": 29,
          "text": "וענין זה"
        },
        {
          "s": 30,
          "text": "(הפיכת ימים אלו לששון ולשמחה)"
        },
        {
          "s": 31,
          "text": "נעשה ע\"י העבודה דקו התשובה דוקא,"
        },
        {
          "s": 32,
          "text": "כי ענין התשובה הוא אתהפכא חשוכא לנהורא,"
        },
        {
          "s": 33,
          "text": "שזוהי מעלת עבודת הבע\"ת על עבודת הצדיקים."
        },
        {
          "s": 34,
          "text": "וזוהי גם השייכות דגאולה העתידה לענין התשובה דוקא"
        },
        {
          "s": 35,
          "text": "[שישראל עושין תשובה"
        },
        {
          "s": 36,
          "text": "(ועי\"ז דוקא)"
        },
        {
          "s": 37,
          "text": "ומיד הן נגאלין73,"
        },
        {
          "s": 38,
          "text": "ועד שהעילוי דגאולה העתידה74"
        },
        {
          "s": 39,
          "text": "הוא מה שמשיח אתא לאתבא צדיקייא בתיובתא75],"
        },
        {
          "s": 40,
          "text": "כי החידוש שבגאולה העתידה הוא הענין דאתהפכא."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "וע\"פ הנ\"ל יובן מה שבפסוק זה מדובר רק ע\"ד שני הענינים דתורה"
        },
        {
          "s": 2,
          "text": "(משפט)"
        },
        {
          "s": 3,
          "text": "וצדקה,"
        },
        {
          "s": 4,
          "text": "אף שישנם ג' קוין,"
        },
        {
          "s": 5,
          "text": "כי הכוונה בענין התורה"
        },
        {
          "s": 6,
          "text": "(משפט)"
        },
        {
          "s": 7,
          "text": "וצדקה"
        },
        {
          "s": 8,
          "text": "(בפסוק זה)"
        },
        {
          "s": 9,
          "text": "היא לשני סוגים הכללים שבכל הבחינות דעולם שנה ונפש"
        },
        {
          "s": 10,
          "text": "(עד\"ז – הענין דאורות וכלים,"
        },
        {
          "s": 11,
          "text": "שם הוי' ושם אלקים וכו')."
        },
        {
          "s": 12,
          "text": "ובכל א' – צ\"ל העבודה בכל ג' הקוין."
        },
        {
          "s": 13,
          "text": "כי הפדי' מהגלות"
        },
        {
          "s": 14,
          "text": "[הן בענינים אלו"
        },
        {
          "s": 15,
          "text": "[מארי תורה וצדיקים"
        },
        {
          "s": 16,
          "text": "(נפש),"
        },
        {
          "s": 17,
          "text": "ארץ ישראל"
        },
        {
          "s": 18,
          "text": "(עולם),"
        },
        {
          "s": 19,
          "text": "ויומין זכאין"
        },
        {
          "s": 20,
          "text": "(שנה)]"
        },
        {
          "s": 21,
          "text": "שפדייתם מהגלות היא באופן דציון במשפט"
        },
        {
          "s": 22,
          "text": "(תורה)"
        },
        {
          "s": 23,
          "text": "תפדה."
        },
        {
          "s": 24,
          "text": "והן בענינים אלו"
        },
        {
          "s": 25,
          "text": "[מארי עובדין טבין ובע\"ת,"
        },
        {
          "s": 26,
          "text": "ארץ העמים,"
        },
        {
          "s": 27,
          "text": "וימים שהם היפך הזכות]"
        },
        {
          "s": 28,
          "text": "שפדייתם היא באופן דושבי' בצדקה],"
        },
        {
          "s": 29,
          "text": "היא ע\"י העבודה בכל ג' הקוין דוקא."
        },
        {
          "s": 30,
          "text": "וכמרז\"ל76"
        },
        {
          "s": 31,
          "text": "כל העוסק בתורה וגמ\"ח ומתפלל עם הצבור כו' כאילו פדאני לי ולבני מבין אומות העולם,"
        },
        {
          "s": 32,
          "text": "שפדיית הקב\"ה וישראל מבין אוה\"ע היא ע\"י העבודה בכל ג' הקוין"
        },
        {
          "s": 33,
          "text": "(ובאופן של צבור77)."
        },
        {
          "s": 34,
          "text": "וכמו שנת\"ל בענין בחי' ציון,"
        },
        {
          "s": 35,
          "text": "דזה מה שישראל הם בחי' ציון הוא ע\"י עבודתם בכל ג' הקוין"
        },
        {
          "s": 36,
          "text": "[ויתירה מזו,"
        },
        {
          "s": 37,
          "text": "עי\"ז שכל ג' הקוין הם בשלימות]."
        },
        {
          "s": 38,
          "text": "ומ\"ש ציון במשפט"
        },
        {
          "s": 39,
          "text": "(תורה)"
        },
        {
          "s": 40,
          "text": "תפדה הוא לפי שהפדי' דבחי' ציון"
        },
        {
          "s": 41,
          "text": "(בכל ג' הבחי' דעש\"ן)"
        },
        {
          "s": 42,
          "text": "היא בעיקר ע\"י התורה,"
        },
        {
          "s": 43,
          "text": "עד\"ז הוא גם בענין ושבי' בצדקה,"
        },
        {
          "s": 44,
          "text": "שהפדי' דשבי'"
        },
        {
          "s": 45,
          "text": "(בכל ג' הבחינות דעש\"ן)"
        },
        {
          "s": 46,
          "text": "היא ע\"י העבודה בכל ג' הקוין דוקא."
        },
        {
          "s": 47,
          "text": "ומ\"ש ושבי' בצדקה"
        },
        {
          "s": 48,
          "text": "(דוקא)"
        },
        {
          "s": 49,
          "text": "הוא לפי שפדייתם"
        },
        {
          "s": 50,
          "text": "(של שבי')"
        },
        {
          "s": 51,
          "text": "היא בעיקר ע\"י הצדקה."
        },
        {
          "s": 52,
          "text": "ונוסף לזה,"
        },
        {
          "s": 53,
          "text": "גם בענין המצוות גופא"
        },
        {
          "s": 54,
          "text": "(דצדקה היא כללות המצוות,"
        },
        {
          "s": 55,
          "text": "כנ\"ל)"
        },
        {
          "s": 56,
          "text": "יש כל ג' הקוין,"
        },
        {
          "s": 57,
          "text": "ההלכה בזה שהוא ענין התורה,"
        },
        {
          "s": 58,
          "text": "העשי' בדבר הגשמי שהוא הקו דגמ\"ח,"
        },
        {
          "s": 59,
          "text": "העלאת הגשמי"
        },
        {
          "s": 60,
          "text": "(שעושים בו המצוה)"
        },
        {
          "s": 61,
          "text": "שהוא קו העבודה,"
        },
        {
          "s": 62,
          "text": "דבקרבנות נאמר ריח ניחוח שריח הו\"ע ההעלאה מלמטלמ\"ע78,"
        },
        {
          "s": 63,
          "text": "וכן תפלה"
        },
        {
          "s": 64,
          "text": "(שכנגד קרבנות)"
        },
        {
          "s": 65,
          "text": "עז\"נ79"
        },
        {
          "s": 66,
          "text": "סולם מוצב ארצה וראשו מגיע השמימה."
        },
        {
          "s": 67,
          "text": "נוסף על הידוע שבכל מצוה יש ג' הענינים דמחשבה דיבור ומעשה שהם ג' הקוין80."
        },
        {
          "s": 68,
          "text": "וע\"פ הנ\"ל יובן גם סדרן של ג' דברים אלו"
        },
        {
          "s": 69,
          "text": "(במרז\"ל הנ\"ל),"
        },
        {
          "s": 70,
          "text": "תורה גמ\"ח ותפלה"
        },
        {
          "s": 71,
          "text": "(לא כסדר הרגיל),"
        },
        {
          "s": 72,
          "text": "כי בכללות הענין דפדאני לי ולבני מבין האומות הוא ע\"י העסק בתורה וגמ\"ח,"
        },
        {
          "s": 73,
          "text": "ציון במשפט תפדה ושבי' בצדקה,"
        },
        {
          "s": 74,
          "text": "אלא שבכל ענין"
        },
        {
          "s": 75,
          "text": "(ובפרט בענין הפדי' מהגלות81)"
        },
        {
          "s": 76,
          "text": "צ\"ל כל ג' הקוין,"
        },
        {
          "s": 77,
          "text": "ומתפלל עם הצבור82."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "וזהו ציון במשפט תפדה ושבי' בצדקה,"
        },
        {
          "s": 2,
          "text": "שפסוק זה נקבע בההפטורה דשבת שלפני ת\"ב"
        },
        {
          "s": 3,
          "text": "(דשבת מיני' מתברכין כולהו יומין83"
        },
        {
          "s": 4,
          "text": "– כולל ת\"ב),"
        },
        {
          "s": 5,
          "text": "שזהו בדוגמת הנהגתו של הקב\"ה שמקדים רפואה למכה84,"
        },
        {
          "s": 6,
          "text": "שרפואתו של הקב\"ה היא באופן שמלכתחילה לא אשים עליך85,"
        },
        {
          "s": 7,
          "text": "ועי\"ז פועלים הפדי' דכאו\"א מישראל הן בנשמתו והן בגופו ונפשו הבהמית,"
        },
        {
          "s": 8,
          "text": "שפדיית הנשמה היא"
        },
        {
          "s": 9,
          "text": "(בכללות)"
        },
        {
          "s": 10,
          "text": "באופן דציון במשפט תפדה,"
        },
        {
          "s": 11,
          "text": "ופדיית הגוף ונה\"ב היא באופן דושבי' בצדקה"
        },
        {
          "s": 12,
          "text": "[כמובן מהמבואר בתניא86,"
        },
        {
          "s": 13,
          "text": "שהנשמה עצמה אינה צריכה תיקון כלל וירידתה למטה הוא רק בכדי לתקן את הגוף ונה\"ב]."
        },
        {
          "s": 14,
          "text": "ובכדי שהתורה והצדקה"
        },
        {
          "s": 15,
          "text": "(יעלו למעלה,"
        },
        {
          "s": 16,
          "text": "שעי\"ז)"
        },
        {
          "s": 17,
          "text": "יפעלו הפדי' בפועל,"
        },
        {
          "s": 18,
          "text": "הוא ע\"י התפלה,"
        },
        {
          "s": 19,
          "text": "קו העבודה,"
        },
        {
          "s": 20,
          "text": "כנ\"ל87."
        }
      ]
    }
  ]
}