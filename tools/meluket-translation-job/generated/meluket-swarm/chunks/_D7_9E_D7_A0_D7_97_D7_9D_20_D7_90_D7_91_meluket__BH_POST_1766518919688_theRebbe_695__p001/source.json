{
  "globalIndex": 993,
  "owner": 43,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919688_theRebbe_695__p001",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919688_theRebbe_695__p001",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919688_theRebbe_695",
  "title": "מאמר ציון במשפט תפדה תשל\"ה",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ דברים,"
        },
        {
          "s": 2,
          "text": "שבת חזון,"
        },
        {
          "s": 3,
          "text": "תשל\"ה*."
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "ציון במשפט תפדה ושבי' בצדקה1,"
        },
        {
          "s": 1,
          "text": "ומבאר כ\"ק אדמו\"ר הזקן2"
        },
        {
          "s": 2,
          "text": "וכ\"ק אדמו\"ר הצ\"צ3"
        },
        {
          "s": 3,
          "text": "(ורבותינו נשיאינו שלאח\"ז),"
        },
        {
          "s": 4,
          "text": "דציון קאי על בחי' פנימיות הלב."
        },
        {
          "s": 5,
          "text": "ונק' ציון לשון סימן,"
        },
        {
          "s": 6,
          "text": "כי בחי' פנימיות הלב היא ציון וסימן ללמעלה."
        },
        {
          "s": 7,
          "text": "ובבחי' זו אא\"פ להיות שבי' ח\"ו,"
        },
        {
          "s": 8,
          "text": "רק שהיא צריכה לפדי' בלבד,"
        },
        {
          "s": 9,
          "text": "והפדי' היא במשפט היינו תורה,"
        },
        {
          "s": 10,
          "text": "כתרגומו ע\"פ כמשפט הראשון4"
        },
        {
          "s": 11,
          "text": "כהלכתא קדמיתא."
        },
        {
          "s": 12,
          "text": "ושבי' הם כחות הגלויים של הנשמה שבבחי' התלבשות בגוף,"
        },
        {
          "s": 13,
          "text": "בחי' רגל שבנשמה,"
        },
        {
          "s": 14,
          "text": "שהם בבחי' שבי' ממש,"
        },
        {
          "s": 15,
          "text": "ופדייתם מן השבי' היא בצדקה דוקא,"
        },
        {
          "s": 16,
          "text": "שהוא מעשה המצוות,"
        },
        {
          "s": 17,
          "text": "כמשנת\"ל"
        },
        {
          "s": 18,
          "text": "(בד\"ה ציון במשפט5)"
        },
        {
          "s": 19,
          "text": "בארוכה."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ב)"
        },
        {
          "s": 2,
          "text": "והנה לפי פירוש זה,"
        },
        {
          "s": 3,
          "text": "ציון במשפט תפדה"
        },
        {
          "s": 4,
          "text": "(פדי' שע\"י תורה)"
        },
        {
          "s": 5,
          "text": "הוא למעלה מושבי' בצדקה"
        },
        {
          "s": 6,
          "text": "(פדי' שע\"י מצוות),"
        },
        {
          "s": 7,
          "text": "וע\"פ משנ\"ת בכ\"מ שתורה היא למעלה ממצוות."
        },
        {
          "s": 8,
          "text": "אמנם ברשימות הצ\"צ לנ\"ך6"
        },
        {
          "s": 9,
          "text": "עה\"פ ציון במשפט תפדה ושבי' בצדקה,"
        },
        {
          "s": 10,
          "text": "מביא פירוש,"
        },
        {
          "s": 11,
          "text": "שושבי' הו\"ע לאתבא צדיקייא בתיובתא."
        },
        {
          "s": 12,
          "text": "דציון קאי על צדיקים7,"
        },
        {
          "s": 13,
          "text": "ושבי' דציון הו\"ע לאתבא צדיקייא בתיובתא8,"
        },
        {
          "s": 14,
          "text": "ופדיית הצדיקים היא ע\"י התורה,"
        },
        {
          "s": 15,
          "text": "משא\"כ לאתבא צדיקייא בתיובתא נעשה ע\"י צדקה דוקא."
        },
        {
          "s": 16,
          "text": "ולפי פירוש זה ושבי' בצדקה הוא למעלה מציון במשפט תפדה,"
        },
        {
          "s": 17,
          "text": "ולא עוד אלא שהוא עילוי שלא בערך."
        },
        {
          "s": 18,
          "text": "וכמובן גם מזה שלאתבא צדיקייא בתיובתא הוא ע\"י משיח דוקא,"
        },
        {
          "s": 19,
          "text": "וכמאמר9"
        },
        {
          "s": 20,
          "text": "משיח אתא לאתבא צדיקייא בתיובתא,"
        },
        {
          "s": 21,
          "text": "שדרגת נשמת משיח היא באין ערוך מדרגות שאר הנשמות,"
        },
        {
          "s": 22,
          "text": "וכידוע בכתבי האריז\"ל10,"
        },
        {
          "s": 23,
          "text": "שדרגת הנשמה שזכו אלי' גדולי ישראל שעד משיח היא רק בהבחינות נרנ\"ח,"
        },
        {
          "s": 24,
          "text": "ואדם הראשון זכה לחי',"
        },
        {
          "s": 25,
          "text": "משא\"כ משיח יזכה ליחידה,"
        },
        {
          "s": 26,
          "text": "יחידה הכללית של כלל ישראל."
        },
        {
          "s": 27,
          "text": "והרי העילוי דבחי' יחידה על הבחינות נרנ\"ח הוא עילוי שבאין ערוך."
        },
        {
          "s": 28,
          "text": "וכמובן גם מזה שנקראת יחידה מלשון יחיד,"
        },
        {
          "s": 29,
          "text": "שתואר זה מורה אשר אין לה ערך להבחינות דנרנ\"ח."
        },
        {
          "s": 30,
          "text": "וכידוע11"
        },
        {
          "s": 31,
          "text": "ההפרש בין יחיד לאחד,"
        },
        {
          "s": 32,
          "text": "דאחד מורה שיש לו ערך לעוד דבר"
        },
        {
          "s": 33,
          "text": "[דהגם שהתואר אחד אינו כהתואר ראשון,"
        },
        {
          "s": 34,
          "text": "שראשון מכריח שיש שני,"
        },
        {
          "s": 35,
          "text": "משא\"כ אחד הרי יש אחד ואין שני גו' לו12,"
        },
        {
          "s": 36,
          "text": "מ\"מ,"
        },
        {
          "s": 37,
          "text": "מזה גופא שצריך לומר ואין שני הרי מוכח שאפשר שיהי' שני לו,"
        },
        {
          "s": 38,
          "text": "בערך לו כו'],"
        },
        {
          "s": 39,
          "text": "משא\"כ התואר יחיד,"
        },
        {
          "s": 40,
          "text": "הרי זה גופא מורה שאין שני לו."
        },
        {
          "s": 41,
          "text": "ומזה מובן גודל העילוי דלאתבא צדיקייא בתיובתא,"
        },
        {
          "s": 42,
          "text": "מכיון שזהו אחד הענינים שיתחדשו ע\"י משיח דוקא,"
        },
        {
          "s": 43,
          "text": "בחי' יחידה."
        }
      ]
    }
  ]
}