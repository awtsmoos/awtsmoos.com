{
  "globalIndex": 1087,
  "owner": 37,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920245_theRebbe_641__p002",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920245_theRebbe_641__p002",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920245_theRebbe_641",
  "title": "מאמר לכה דודי תשי\"ד",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ומשל הב' הוא מבן יניק וקטן שאביו רוצה להשתעשע עמו פא\"פ והרי התינוק הוא קטן,"
        },
        {
          "s": 2,
          "text": "צריך האב להשפיל את ידיו כו' להרים בנו הקטן בכדי שיוכל להשתעשע עמו בקירוב פא\"פ."
        },
        {
          "s": 3,
          "text": "דהגבהת התינוק הוא רק ענין חיצוני,"
        },
        {
          "s": 4,
          "text": "והוא רק הקדמה להקירוב פנימי שלאח\"ז"
        },
        {
          "s": 5,
          "text": "(השעשועים כו')."
        },
        {
          "s": 6,
          "text": "והנה מקור משל זה הוא באו\"ת להה\"מ15,"
        },
        {
          "s": 7,
          "text": "ושם ישנה הוספה"
        },
        {
          "s": 8,
          "text": "(שלא נעתקה בהמאמר16),"
        },
        {
          "s": 9,
          "text": "שהקטן \"משתעשע בזקן שלו\""
        },
        {
          "s": 10,
          "text": "(של האב)."
        },
        {
          "s": 11,
          "text": "וי\"ל שבזה מרומז,"
        },
        {
          "s": 12,
          "text": "שהמשכת המקיף"
        },
        {
          "s": 13,
          "text": "(שקודם ההשפעה פנימית17)"
        },
        {
          "s": 14,
          "text": "היא למעלה מהשתלשלות,"
        },
        {
          "s": 15,
          "text": "דזקן הוא י\"ג תיקוני דיקנא,"
        },
        {
          "s": 16,
          "text": "י\"ג מדה\"ר שלמעלה מהשתלשלות."
        },
        {
          "s": 17,
          "text": "אלא מ\"מ יש להם איזו שייכות להשתלשלות,"
        },
        {
          "s": 18,
          "text": "כמש\"נ18"
        },
        {
          "s": 19,
          "text": "זכור רחמיך גו' כי מעולם המה"
        },
        {
          "s": 20,
          "text": "[שלכן נק' בשם \"מדות\" מלשון מדידה19]."
        },
        {
          "s": 21,
          "text": "גם ידוע בענין השערות שהוא הארה בלבד."
        },
        {
          "s": 22,
          "text": "אמנם ע\"י ההשפעה פנימית שלאח\"ז"
        },
        {
          "s": 23,
          "text": "(אף שהיא למטה מבחי' מקיף)"
        },
        {
          "s": 24,
          "text": "נמשך העצם שלמעלה מהמקיף"
        },
        {
          "s": 25,
          "text": "(ע\"ד הנ\"ל סעיף א' במעלת יחוד זו\"ן"
        },
        {
          "s": 26,
          "text": "(שהוא יחוד פנימי)"
        },
        {
          "s": 27,
          "text": "על יחוד או\"א כביאור אדמו\"ר הצ\"צ בכ\"מ20"
        },
        {
          "s": 28,
          "text": "בזה)."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ועד\"ז הוא בעבודה"
        },
        {
          "s": 2,
          "text": "(כמו שמבאר בהמאמר21),"
        },
        {
          "s": 3,
          "text": "שהתחלת עבודת האדם בכל יום היא עבודת התפלה,"
        },
        {
          "s": 4,
          "text": "כמש\"נ22"
        },
        {
          "s": 5,
          "text": "חדלו לכם מן האדם אשר נשמה באפו כי במה נחשב הוא,"
        },
        {
          "s": 6,
          "text": "אל תקרי במה אלא במה23,"
        },
        {
          "s": 7,
          "text": "ובי' אדה\"ז ואדמו\"ר מהר\"ש24"
        },
        {
          "s": 8,
          "text": "דקודם התפלה נחשב האדם כמו במה."
        },
        {
          "s": 9,
          "text": "ותפלה הוא לשון התחברות25,"
        },
        {
          "s": 10,
          "text": "שע\"י התפלה מתקשר האדם באלקות."
        },
        {
          "s": 11,
          "text": "וסדר התפלה הוא,"
        },
        {
          "s": 12,
          "text": "שמקודם צ\"ל הקירוב כללי"
        },
        {
          "s": 13,
          "text": "(המשכה חיצונית)"
        },
        {
          "s": 14,
          "text": "[כמו שמבאר ענינו בהמאמר21],"
        },
        {
          "s": 15,
          "text": "ואח\"כ נעשה הקירוב פנימי,"
        },
        {
          "s": 16,
          "text": "שהאדם מתקשר לאלקות באופן כזה שממשיך אלקות בכל עניניו הגשמיים."
        },
        {
          "s": 17,
          "text": "ויובן זה"
        },
        {
          "s": 18,
          "text": "[מה שע\"י התפלה בתחילת היום ביכלתו לקשר כל הענינים הגשמיים ולעשותם כלים לאלקות]"
        },
        {
          "s": 19,
          "text": "ע\"פ מה שביאר הבעש\"ט26"
        },
        {
          "s": 20,
          "text": "ענין איסור שאילת שלום קודם התפלה27,"
        },
        {
          "s": 21,
          "text": "שהוא ע\"ד מ\"ש בכתבי האריז\"ל28"
        },
        {
          "s": 22,
          "text": "בענין כיבוד אח הגדול29,"
        },
        {
          "s": 23,
          "text": "שהוא מפני דרוחא הוא דשבק בגוי',"
        },
        {
          "s": 24,
          "text": "שבבן הא' יש רוח האב יותר משאר הבנים,"
        },
        {
          "s": 25,
          "text": "וכל שאר הבנים נוטלים מרוחא דאב ע\"י בן הראשון."
        },
        {
          "s": 26,
          "text": "ומצד רוח האב שבאח הגדול מחוייבים הם לכבדו כמו שהם מחוייבים בכבוד האב"
        },
        {
          "s": 27,
          "text": "[שלכן למדין29"
        },
        {
          "s": 28,
          "text": "דין זה מהפסוק30"
        },
        {
          "s": 29,
          "text": "כבד את אביך דוקא,"
        },
        {
          "s": 30,
          "text": "כי כבוד אח הגדול נכלל בכיבוד אב]."
        },
        {
          "s": 31,
          "text": "וכמו\"כ הוא בנוגע למחדו\"מ של האדם במשך כל היום,"
        },
        {
          "s": 32,
          "text": "שכולם מסתעפין ונמשכין אחר הדבור הראשון,"
        },
        {
          "s": 33,
          "text": "ולכן דבור"
        },
        {
          "s": 34,
          "text": "[וכן מחשבה ומעשה]"
        },
        {
          "s": 35,
          "text": "הראשון של האדם בקומו משינתו צ\"ל בעבודת ה',"
        },
        {
          "s": 36,
          "text": "שעי\"ז ממשיך קדושה בכל המחדו\"מ שלו במשך כל היום כולו."
        },
        {
          "s": 37,
          "text": "והנה דוקא עי\"ז שהקירוב פנימי שלו לאלקות"
        },
        {
          "s": 38,
          "text": "(בעת התפלה)"
        },
        {
          "s": 39,
          "text": "הוא באופן כזה שממשיך אור אלקי בעניניו הגשמיים עד שעושה אותם כלים לאלקות מגיעים למעלה יותר,"
        },
        {
          "s": 40,
          "text": "כידוע31"
        },
        {
          "s": 41,
          "text": "בענין ורב32"
        },
        {
          "s": 42,
          "text": "תבואות בכח שור."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "וכמו כן יובן גם בענין המשכת הז\"א במלכות"
        },
        {
          "s": 2,
          "text": "(יחוד זו\"ן),"
        },
        {
          "s": 3,
          "text": "שהסדר בזה הוא"
        },
        {
          "s": 4,
          "text": "(כנ\"ל ס\"א)"
        },
        {
          "s": 5,
          "text": "אשר מקודם צ\"ל ההמשכה חיצונית ואח\"כ ההמשכה פנימית."
        },
        {
          "s": 6,
          "text": "דגם ההמשכה חיצונית היא המשכה נעלית ביותר"
        },
        {
          "s": 7,
          "text": "(ע\"ד הנ\"ל ס\"ב-ג),"
        },
        {
          "s": 8,
          "text": "שהיא בחי' מקיף שלמעלה מהשתלשלות וכלים"
        },
        {
          "s": 9,
          "text": "(ולכן אינה נקלטת בספירת המלכות בפנימיותה לפי שהיא למעלה מהגבלת הכלים שלה)."
        },
        {
          "s": 10,
          "text": "אבל מ\"מ,"
        },
        {
          "s": 11,
          "text": "המשכה זו היא בחי' חיצונית,"
        },
        {
          "s": 12,
          "text": "שהיא רק הארה בלבד."
        },
        {
          "s": 13,
          "text": "משא\"כ ע\"י ההמשכה פנימית,"
        },
        {
          "s": 14,
          "text": "שמתקבלת במלכות בפנימיותה,"
        },
        {
          "s": 15,
          "text": "מגיעים למעלה יותר"
        },
        {
          "s": 16,
          "text": "(מבחי' המקיף)."
        },
        {
          "s": 17,
          "text": "והענין הוא,"
        },
        {
          "s": 18,
          "text": "דשרש המלכות הוא למעלה משרש ז\"א33."
        },
        {
          "s": 19,
          "text": "דשרש הז\"א הוא מחיצוניות הכתר ושרש המלכות הוא מפנימיות הכתר."
        },
        {
          "s": 20,
          "text": "והגם שגם בז\"א איתמר34"
        },
        {
          "s": 21,
          "text": "ז\"א בעתיקא אחיד ותליא,"
        },
        {
          "s": 22,
          "text": "הרי ידוע שאין הכוונה בזה על עתיק ממש"
        },
        {
          "s": 23,
          "text": "(רק חיצוניות עתיק)."
        },
        {
          "s": 24,
          "text": "משא\"כ שרש המלכות היא בפנימיות עתיק,"
        },
        {
          "s": 25,
          "text": "רדל\"א33."
        },
        {
          "s": 26,
          "text": "אבל מ\"מ,"
        },
        {
          "s": 27,
          "text": "מצד ירידתה למטה הרי שרשה הוא בהעלם,"
        },
        {
          "s": 28,
          "text": "וגילוי שרש המלכות הוא ע\"י ז\"א דוקא35,"
        },
        {
          "s": 29,
          "text": "ועי\"ז גופא ספירת המלכות מתעלית למעלה מז\"א."
        },
        {
          "s": 30,
          "text": "וזהו\"ע סדר ההמשכה,"
        },
        {
          "s": 31,
          "text": "דתחילה צ\"ל המשכת הז\"א במלכות באופן שיורגש ענין הז\"א שלמעלה ממלכות"
        },
        {
          "s": 32,
          "text": "(שדוקא ע\"י הוא גילוי שרש המלכות)."
        },
        {
          "s": 33,
          "text": "אבל מ\"מ,"
        },
        {
          "s": 34,
          "text": "מכיון שההמשכה היא מצד"
        },
        {
          "s": 35,
          "text": "(מעלת)"
        },
        {
          "s": 36,
          "text": "ז\"א,"
        },
        {
          "s": 37,
          "text": "יש לה שייכות להשתלשלות"
        },
        {
          "s": 38,
          "text": "[ע\"ד הנ\"ל"
        },
        {
          "s": 39,
          "text": "(ס\"ג)"
        },
        {
          "s": 40,
          "text": "בענין י\"ג ת\"ד]."
        },
        {
          "s": 41,
          "text": "ודוקא ע\"י ההמשכה פנימית שמתקבלת במלכות בפנימיותה,"
        },
        {
          "s": 42,
          "text": "הרי מכיון שהמשכה זו היא מצד"
        },
        {
          "s": 43,
          "text": "(מעלת)"
        },
        {
          "s": 44,
          "text": "המלכות,"
        },
        {
          "s": 45,
          "text": "הרי מגיעים עי\"ז לשרש המלכות שלמעלה משרש ז\"א,"
        },
        {
          "s": 46,
          "text": "ועד שהמלכות משפיע בז\"א,"
        },
        {
          "s": 47,
          "text": "אשת חיל עטרת בעלה36."
        }
      ]
    }
  ]
}