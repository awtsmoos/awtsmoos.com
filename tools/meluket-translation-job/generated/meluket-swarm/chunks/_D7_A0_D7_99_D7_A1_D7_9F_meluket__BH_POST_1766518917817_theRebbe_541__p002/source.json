{
  "globalIndex": 689,
  "owner": 39,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917817_theRebbe_541__p002",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917817_theRebbe_541__p002",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917817_theRebbe_541",
  "title": "מאמר כימי צאתך תשמ\"ב",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "אמנם עפ\"ז צריך להבין מ\"ש כימי צאתך מארץ מצרים אראנו נפלאות,"
        },
        {
          "s": 2,
          "text": "מדוע מדמה הכתוב הנפלאות דגאולה העתידה להנפלאות שהיו בימי צאתך מארץ מצרים."
        },
        {
          "s": 3,
          "text": "וביותר אינו מובן21"
        },
        {
          "s": 4,
          "text": "לפי הדיעה שמזכירין יצי\"מ גם לימות המשיח,"
        },
        {
          "s": 5,
          "text": "דלכאורה,"
        },
        {
          "s": 6,
          "text": "מכיון שהגילויים דלע\"ל יהיו נעלים הרבה יותר מהגילויים שהיו ביצי\"מ,"
        },
        {
          "s": 7,
          "text": "למה יזכירו יצי\"מ גם אז."
        },
        {
          "s": 8,
          "text": "וידוע הביאור בזה"
        },
        {
          "s": 9,
          "text": "(כמ\"ש בד\"ה כימי צאתך לכ\"ק מו\"ח אדמו\"ר22),"
        },
        {
          "s": 10,
          "text": "דבגאולת מצרים נתחדש כללות ענין הגאולה ונפתח הצינור על כל הגאולות"
        },
        {
          "s": 11,
          "text": "(מהגלויות,"
        },
        {
          "s": 12,
          "text": "שלאחרי גלות מצרים),"
        },
        {
          "s": 13,
          "text": "גם על גאולה העתידה,"
        },
        {
          "s": 14,
          "text": "הגם שתהי' גאולה נעלית יותר."
        },
        {
          "s": 15,
          "text": "וע\"ד הידוע שיצי\"מ היתה הכנה למתן תורה,"
        },
        {
          "s": 16,
          "text": "כמ\"ש23"
        },
        {
          "s": 17,
          "text": "בהוציאך את העם ממצרים תעבדון את האלקים על ההר הזה,"
        },
        {
          "s": 18,
          "text": "דהגם שעיקר ענין הגאולה והחירות הי' בשעת מ\"ת דוקא,"
        },
        {
          "s": 19,
          "text": "כי מכיון שלפני מ\"ת היתה עדיין הגזירה דעליונים לא ירדו לתחתונים ותחתונים לא יעלו לעליונים24,"
        },
        {
          "s": 20,
          "text": "הרי מובן שעד מ\"ת"
        },
        {
          "s": 21,
          "text": "(גם לאחרי יצי\"מ)"
        },
        {
          "s": 22,
          "text": "לא היתה עדיין אמיתית הגאולה והחירות דתחתונים,"
        },
        {
          "s": 23,
          "text": "ואעפ\"כ,"
        },
        {
          "s": 24,
          "text": "בעת הגאולה דיצי\"מ ניתן הכח גם על הגאולה"
        },
        {
          "s": 25,
          "text": "(ביטול הגזירה)"
        },
        {
          "s": 26,
          "text": "שנעשה במ\"ת,"
        },
        {
          "s": 27,
          "text": "הנה עד\"ז הוא גם בנוגע לגאולה העתידה,"
        },
        {
          "s": 28,
          "text": "שבהגאולה דיצי\"מ ניתן הכח גם על גאולה העתידה,"
        },
        {
          "s": 29,
          "text": "מכיון שבשעת מ\"ת הי' כבר מעין הגילוי דלע\"ל25,"
        },
        {
          "s": 30,
          "text": "אלא שבשעת מ\"ת הי' הגילוי רק לפי שעה ולע\"ל יהי' הגילוי באופן תמידי ונצחי,"
        },
        {
          "s": 31,
          "text": "כי הגילוי אז יהי' לא רק מצד מלמעלה כבשעת מ\"ת,"
        },
        {
          "s": 32,
          "text": "אלא גם מצד המטה26,"
        },
        {
          "s": 33,
          "text": "כי הנבראים יהיו אז בתכלית הבירור והזיכוך ויהיו כלים לגילוי אלקות,"
        },
        {
          "s": 34,
          "text": "להשיג דעת בוראם כפי כח האדם27,"
        },
        {
          "s": 35,
          "text": "וזה נעשה אתר שלים28"
        },
        {
          "s": 36,
          "text": "להשראת אוא\"ס שלמעלה מכח האדם."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וזהו ג\"כ מ\"ש כימי צאתך מארץ מצרים,"
        },
        {
          "s": 2,
          "text": "ימי לשון רבים,"
        },
        {
          "s": 3,
          "text": "דכל הימים מימי גאולה הראשונה מגלות מצרים עד הגאולה העתידה בב\"א הם ימי צאתך מארץ מצרים,"
        },
        {
          "s": 4,
          "text": "כמבואר בהמאמר שם29."
        },
        {
          "s": 5,
          "text": "והיינו,"
        },
        {
          "s": 6,
          "text": "דמה שביצי\"מ נפתח הצינור גם על הגאולה העתידה,"
        },
        {
          "s": 7,
          "text": "הסדר בזה הוא,"
        },
        {
          "s": 8,
          "text": "שבכל יום ויום"
        },
        {
          "s": 9,
          "text": "(מעת יצי\"מ עד גאולה העתידה)"
        },
        {
          "s": 10,
          "text": "נעשה ענין יציאת מצרים באופן נעלה יותר,"
        },
        {
          "s": 11,
          "text": "ועד לתכלית העילוי בזה בגאולה העתידה."
        },
        {
          "s": 12,
          "text": "והענין הוא,"
        },
        {
          "s": 13,
          "text": "דהנה ארז\"ל30"
        },
        {
          "s": 14,
          "text": "בכל דור ודור וכל יום ויום31"
        },
        {
          "s": 15,
          "text": "חייב אדם לראות את עצמו כאילו הוא יצא היום31"
        },
        {
          "s": 16,
          "text": "ממצרים."
        },
        {
          "s": 17,
          "text": "דבכל יום ויום צריך להיות היציאה ממצרים,"
        },
        {
          "s": 18,
          "text": "ובפרט בשעת ק\"ש,"
        },
        {
          "s": 19,
          "text": "כמ\"ש אדמו\"ר הזקן32"
        },
        {
          "s": 20,
          "text": "דמה שתיקנו פ' יציאת מצרים בשעת ק\"ש דוקא הוא מפני שהן"
        },
        {
          "s": 21,
          "text": "(ק\"ש ויצי\"מ)"
        },
        {
          "s": 22,
          "text": "דבר אחד,"
        },
        {
          "s": 23,
          "text": "וענין זה"
        },
        {
          "s": 24,
          "text": "(שבק\"ש צ\"ל העבודה דיצי\"מ)"
        },
        {
          "s": 25,
          "text": "הוא גם בק\"ש של ערבית,"
        },
        {
          "s": 26,
          "text": "וכמ\"ש הרמב\"ם33"
        },
        {
          "s": 27,
          "text": "דמה שקורין פרשת ציצית גם בק\"ש של ערבית,"
        },
        {
          "s": 28,
          "text": "אע\"פ שאין מצות ציצית נוהגת בלילה,"
        },
        {
          "s": 29,
          "text": "הוא מפני שיש בה זכרון יציאת מצרים."
        },
        {
          "s": 30,
          "text": "וזהו כימי צאתך מארץ מצרים,"
        },
        {
          "s": 31,
          "text": "ימי לשון רבים,"
        },
        {
          "s": 32,
          "text": "אף שיצי\"מ היתה ביום אחד,"
        },
        {
          "s": 33,
          "text": "כי ע\"י שמזכירין בכל יום יצי\"מ"
        },
        {
          "s": 34,
          "text": "(שהיתה בפעם הראשונה,"
        },
        {
          "s": 35,
          "text": "ביום אחד)"
        },
        {
          "s": 36,
          "text": "הנה עי\"ז נעשה ימי צאתך מארץ מצרים ימי לשון רבים,"
        },
        {
          "s": 37,
          "text": "שבכל יום ויום יוצאים ממיצרים וגבולים נעלים יותר,"
        },
        {
          "s": 38,
          "text": "און מען שטעלט זיך אַוועק במצב של ופרצת למעלה ממדידה והגבלה,"
        },
        {
          "s": 39,
          "text": "ועד שבאים לופרצת בתכלית השלימות בגאולה האמיתית והשלימה ע\"י משיח צדקנו דכתיב בי'34"
        },
        {
          "s": 40,
          "text": "עלה הפורץ לפניהם."
        },
        {
          "s": 41,
          "text": "דזהו מה שמשיח הוא בן דוד,"
        },
        {
          "s": 42,
          "text": "וגם הסימן על משיח הוא שהוא הוגה בתורה ועוסק במצוות כדוד אביו כו' ולוחם מלחמות ה'35,"
        },
        {
          "s": 43,
          "text": "דדוד הוא מבני פרץ36"
        },
        {
          "s": 44,
          "text": "דכתיב בי'37"
        },
        {
          "s": 45,
          "text": "מה פרצת עליך פרץ,"
        },
        {
          "s": 46,
          "text": "פריצת כל הגדרים והמדידות וההגבלות."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה סדר זה דגאולה"
        },
        {
          "s": 2,
          "text": "[שמתחיל מיצי\"מ כפשוטה,"
        },
        {
          "s": 3,
          "text": "ועד שבאים ע\"י העבודה דזכירת יצי\"מ בכל יום לגאולה השלימה ע\"י יעלה הפורץ לפנינו]"
        },
        {
          "s": 4,
          "text": "יש דוגמתו בכל יום ויום38."
        },
        {
          "s": 5,
          "text": "דהנה בתחלת היום קודם התפלה נמצא האדם במצרים,"
        },
        {
          "s": 6,
          "text": "בהמיצרים והגבולים של הגוף,"
        },
        {
          "s": 7,
          "text": "וכמ\"ש39"
        },
        {
          "s": 8,
          "text": "חדלו לכם מן האדם אשר נשמה באפו כי במה נחשב הוא,"
        },
        {
          "s": 9,
          "text": "אל תקרי במה אלא במה,"
        },
        {
          "s": 10,
          "text": "שבתחלת היום הנשמה היא רק באפו ואינה מתפשטת בהגוף ולכן הוא נחשב אז כמו במה,"
        },
        {
          "s": 11,
          "text": "שהוא תוקף המיצרים והגבולים דחומריות הגוף."
        },
        {
          "s": 12,
          "text": "ולכן תחלת העבודה היא בבחינת אתכפיא,"
        },
        {
          "s": 13,
          "text": "שהוא מתגבר על חומריות הגוף ונה\"ב ועל הלעו\"ז,"
        },
        {
          "s": 14,
          "text": "ועד שפועל שגם הגוף ונה\"ב יענו אמן בעל כרחן ויסייעו לעבוד את ה',"
        },
        {
          "s": 15,
          "text": "אבל גם זה הוא רק בדרך אתכפיא40."
        },
        {
          "s": 16,
          "text": "ועד שאח\"כ הוא בא לבחינת אתהפכא,"
        },
        {
          "s": 17,
          "text": "ובזה גופא הוא בתחלה באופן דולבי חלל בקרבי41,"
        },
        {
          "s": 18,
          "text": "ואח\"כ הוא מגיע לואהבת את ה' אלקיך בכל לבבך בשני יצריך42,"
        },
        {
          "s": 19,
          "text": "שגם היצה\"ר גופא נהפך לטוב,"
        },
        {
          "s": 20,
          "text": "בדוגמת תשובה שלימה"
        },
        {
          "s": 21,
          "text": "(תשובה מאהבה)"
        },
        {
          "s": 22,
          "text": "שזדונות נעשים כזכיות43"
        },
        {
          "s": 23,
          "text": "ועד שנעשים לזכיות ממש."
        },
        {
          "s": 24,
          "text": "דשני ענינים אלו שבכל יום"
        },
        {
          "s": 25,
          "text": "(אתכפיא ואתהפכא)"
        },
        {
          "s": 26,
          "text": "הם בדוגמת הגאולה דיצי\"מ וגאולה העתידה."
        },
        {
          "s": 27,
          "text": "דביצי\"מ כתיב כי ברח העם44,"
        },
        {
          "s": 28,
          "text": "שהרע הי' בתקפו והוצרכו לברוח מהרע45,"
        },
        {
          "s": 29,
          "text": "בחינת אתכפיא."
        },
        {
          "s": 30,
          "text": "ולע\"ל יהי' ואת רוח הטומאה אעביר מן הארץ46"
        },
        {
          "s": 31,
          "text": "(דוגמת ולבי חלל בקרבי),"
        },
        {
          "s": 32,
          "text": "ויתירה מזו שגם הרע גופא יהפך לטוב"
        },
        {
          "s": 33,
          "text": "(בדוגמת בכל לבבך בשני יצריך),"
        },
        {
          "s": 34,
          "text": "וכמ\"ש47"
        },
        {
          "s": 35,
          "text": "אז אהפוך אל עמים שפה ברורה לקרוא כולם בשם ה' לעבדו שכם אחד,"
        },
        {
          "s": 36,
          "text": "שגם העמים גופא יהפכו לעבדו ית',"
        },
        {
          "s": 37,
          "text": "ועמדו זרים ורעו צאנכם48."
        },
        {
          "s": 38,
          "text": "ועד\"ז יהי' גם בבעלי חיים,"
        },
        {
          "s": 39,
          "text": "והשבתי חי' רעה מן הארץ,"
        },
        {
          "s": 40,
          "text": "משביתן שלא יזיקו49,"
        },
        {
          "s": 41,
          "text": "דהגם שגם אז תהי' המציאות דחיות רעות מ\"מ לא יזיקו,"
        },
        {
          "s": 42,
          "text": "ולא עוד אלא שיהיו מסייעים ומשמשים לעבודת ה',"
        },
        {
          "s": 43,
          "text": "וכמ\"ש50"
        },
        {
          "s": 44,
          "text": "וגר זאב עם כבש גו' וארי' כבקר גו',"
        },
        {
          "s": 45,
          "text": "שיהי' תועלת מהזאב כמו מכבש ומהארי' כמו מבקר,"
        },
        {
          "s": 46,
          "text": "ועד שגם הנחש"
        },
        {
          "s": 47,
          "text": "(פתן,"
        },
        {
          "s": 48,
          "text": "צפעוני51)"
        },
        {
          "s": 49,
          "text": "יהי' שמש גדול52,"
        },
        {
          "s": 50,
          "text": "דלא רק שגם הנחש ישמש לעבודת ה',"
        },
        {
          "s": 51,
          "text": "אלא יתירה מזו,"
        },
        {
          "s": 52,
          "text": "שהשימוש שלו יהי' באופן דגדלות,"
        },
        {
          "s": 53,
          "text": "שמש גדול."
        }
      ]
    }
  ]
}