{
  "globalIndex": 571,
  "owner": 21,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917024_theRebbe_166__p002",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917024_theRebbe_166__p002",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518917024_theRebbe_166",
  "title": "מאמר בחודש השלישי תשל\"ד",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה במעלה ומטה"
        },
        {
          "s": 2,
          "text": "(עליונים ותחתונים)"
        },
        {
          "s": 3,
          "text": "שני פירושים"
        },
        {
          "s": 4,
          "text": "(ענינים)."
        },
        {
          "s": 5,
          "text": "מעלה ומטה במקום"
        },
        {
          "s": 6,
          "text": "(מקום גשמי או מקום רוחני),"
        },
        {
          "s": 7,
          "text": "וענין זה דמעלה ומטה שרשו הוא מהקו."
        },
        {
          "s": 8,
          "text": "דבאם היתה ההמשכה מאוא\"ס"
        },
        {
          "s": 9,
          "text": "(שלא ע\"י הקו)"
        },
        {
          "s": 10,
          "text": "היו כל העולמות בשוה23."
        },
        {
          "s": 11,
          "text": "ועוד פירוש במעלה ומטה,"
        },
        {
          "s": 12,
          "text": "שכללות ענין ההתחלקות"
        },
        {
          "s": 13,
          "text": "(מעלה ומטה דמקום)"
        },
        {
          "s": 14,
          "text": "נק' בשם מטה,"
        },
        {
          "s": 15,
          "text": "כי מעלה הוא למעלה מהתחלקות."
        },
        {
          "s": 16,
          "text": "וכידוע24"
        },
        {
          "s": 17,
          "text": "בפירוש המאמר25"
        },
        {
          "s": 18,
          "text": "אוא\"ס למעלה מעלה עד אין קץ ולמטה מטה עד אין תכלית,"
        },
        {
          "s": 19,
          "text": "דלמטה מטה הוא האור שבבחינת גבול,"
        },
        {
          "s": 20,
          "text": "שרש הקו"
        },
        {
          "s": 21,
          "text": "(שיש בו בהעלם ההתחלקות דמעלה ומטה,"
        },
        {
          "s": 22,
          "text": "שהם השרש דמעלה ומטה שבעולמות),"
        },
        {
          "s": 23,
          "text": "ולמעלה מעלה הוא אור הבלי גבול,"
        },
        {
          "s": 24,
          "text": "שרש הסובב שלמעלה מהתחלקות."
        },
        {
          "s": 25,
          "text": "ויש לומר,"
        },
        {
          "s": 26,
          "text": "דזה שבמ\"ת נעשה החיבור דמעלה ומטה,"
        },
        {
          "s": 27,
          "text": "הוא בשני הענינים."
        },
        {
          "s": 28,
          "text": "החיבור דמעלה ומטה שבעולמות"
        },
        {
          "s": 29,
          "text": "(מקום),"
        },
        {
          "s": 30,
          "text": "דבכללות הוא החיבור דאצילות ובי\"ע26,"
        },
        {
          "s": 31,
          "text": "וגם החיבור דאור הבל\"ג שלמעלה מעולמות עם האור שבערך העולמות,"
        },
        {
          "s": 32,
          "text": "וכידוע27"
        },
        {
          "s": 33,
          "text": "שענין המצוות"
        },
        {
          "s": 34,
          "text": "(שלאחרי מ\"ת)"
        },
        {
          "s": 35,
          "text": "הוא שעל ידם נעשה יחוד קוב\"ה ושכינתי',"
        },
        {
          "s": 36,
          "text": "יחוד סובב וממלא."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה ענין זה שבהחיבור דמעלה ומטה שבמ\"ת נכלל גם המעלה שלמעלה מהגדר דמעלה ומטה שבעולמות,"
        },
        {
          "s": 2,
          "text": "הוא הן בנוגע להנתינת כח שהיתה במ\"ת על העבודה דתומ\"צ שלאחרי מ\"ת"
        },
        {
          "s": 3,
          "text": "(התחתונים יעלו לעליונים),"
        },
        {
          "s": 4,
          "text": "שע\"י עבודת התחתונים יומשך"
        },
        {
          "s": 5,
          "text": "(אור האצילות ו)"
        },
        {
          "s": 6,
          "text": "אור הסובב ועד לאור הבל\"ג שלפני הצמצום"
        },
        {
          "s": 7,
          "text": "(השרש דאור הסובב),"
        },
        {
          "s": 8,
          "text": "והן בהחיבור דמעלה ומטה"
        },
        {
          "s": 9,
          "text": "(העליונים ירדו לתחתונים)"
        },
        {
          "s": 10,
          "text": "שהי' בשעת מ\"ת גופא."
        },
        {
          "s": 11,
          "text": "והענין הוא,"
        },
        {
          "s": 12,
          "text": "דהנה ידוע28"
        },
        {
          "s": 13,
          "text": "שהתורה היא למעלה מזמן ומקום,"
        },
        {
          "s": 14,
          "text": "שלכן כל העוסק בתורת עולה כאילו הקריב עולה29"
        },
        {
          "s": 15,
          "text": "אף שאינו בזמן ומקום ההקרבה30."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה אף שירידת העליונים למטה ועליית התחתונים למעלה הם שני ענינים,"
        },
        {
          "s": 2,
          "text": "ועד שהיו בשני זמנים,"
        },
        {
          "s": 3,
          "text": "דירידת העליונים למטה היתה בשעת מ\"ת ועליית התחתונים למעלה היתה לאחרי מ\"ת,"
        },
        {
          "s": 4,
          "text": "מ\"מ,"
        },
        {
          "s": 5,
          "text": "כיון שירידת העליונים למטה היתה"
        },
        {
          "s": 6,
          "text": "(גם)"
        },
        {
          "s": 7,
          "text": "ההתחלה"
        },
        {
          "s": 8,
          "text": "(והנתינת כח)"
        },
        {
          "s": 9,
          "text": "על עליית התחתונים,"
        },
        {
          "s": 10,
          "text": "וכמרז\"ל ואני המתחיל דכ\"ז,"
        },
        {
          "s": 11,
          "text": "לכן,"
        },
        {
          "s": 12,
          "text": "היתה הירידה באופן שבשעת מעשה פעלה בהתחתונים."
        },
        {
          "s": 13,
          "text": "ועפ\"ז יש לבאר מה דאיתא31"
        },
        {
          "s": 14,
          "text": "שהקול דעשרת הדברות הי' נשמע מכל ד' רוחות העולם ומלמעלה ומלמטה,"
        },
        {
          "s": 15,
          "text": "כי הגילוי דאוא\"ס שלמעלה מגדר מקום"
        },
        {
          "s": 16,
          "text": "(למעלה גם מהגדר דמקום כמו שהוא בהקו)"
        },
        {
          "s": 17,
          "text": "שבהקול דעשרת הדברות פעל בהמקום"
        },
        {
          "s": 18,
          "text": "(שבו נשמע הקול)"
        },
        {
          "s": 19,
          "text": "שיהי' למעלה מהמקום32."
        },
        {
          "s": 20,
          "text": "ולכן,"
        },
        {
          "s": 21,
          "text": "אף שהמקום שבו הי' הקול הי' מקום מסויים,"
        },
        {
          "s": 22,
          "text": "נכללו בו כל הששה קצוות."
        },
        {
          "s": 23,
          "text": "ויש לומר,"
        },
        {
          "s": 24,
          "text": "שעד\"ז הוא בנוגע לזמן,"
        },
        {
          "s": 25,
          "text": "שהזמן שבו ניתנה תורה הי' למעלה מהזמן,"
        },
        {
          "s": 26,
          "text": "ונכלל בו כל המשך הזמן."
        },
        {
          "s": 27,
          "text": "ויש לומר דזהו מהטעמים על זה שמתן תורה הי' רק פעם אחת ולא יהי' עוד פעם33,"
        },
        {
          "s": 28,
          "text": "כי בהזמן דמ\"ת נכלל כל המשך הזמן כולו."
        },
        {
          "s": 29,
          "text": "ועד\"ז הוא בנוגע לר\"ח סיון שאז נשלמה ההכנה למ\"ת34,"
        },
        {
          "s": 30,
          "text": "שביום זה נכלל כל משך הזמן שלאח\"ז."
        },
        {
          "s": 31,
          "text": "וזהו הקשר דשני הפירושים דביום הזה,"
        },
        {
          "s": 32,
          "text": "שקאי על ראש חודש סיון ושקאי על כל יום,"
        },
        {
          "s": 33,
          "text": "כי בר\"ח סיון דשנת מ\"ת נכללו כל הימים שלאח\"ז."
        }
      ]
    }
  ]
}