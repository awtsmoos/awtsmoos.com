  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919223_theRebbe_96__p009",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919223_theRebbe_96__p009",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919223_theRebbe_96",
  "title": "מאמר תפלה למשה תשכ\"ט",
  "part": 9,
  "sections": [
    {
      "v": 24,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר דזהו שהתחלת המזמור הוא אד' מעון אתה גו',"
        },
        {
          "s": 1,
          "text": "וסיום המזמור הוא ויהי נועם אד' גו',"
        },
        {
          "s": 2,
          "text": "דבתחלת המזמור מדבר בענין המלכות כמו שעולה בשרשה בעתיק,"
        },
        {
          "s": 3,
          "text": "ולכן נאמר מעון שקאי על המלכות"
        },
        {
          "s": 4,
          "text": "(כנ\"ל סעיף ב)"
        },
        {
          "s": 5,
          "text": "אלא שמעון הוא אותיות נועם שמורה על עליית המלכות בעתיק,"
        },
        {
          "s": 6,
          "text": "ובסיום המזמור מדבר בענין עתיק"
        },
        {
          "s": 7,
          "text": "(נועם)"
        },
        {
          "s": 8,
          "text": "שנמשך במלכות,"
        },
        {
          "s": 9,
          "text": "וע\"י המלכות – בעולמות בי\"ע עד בעוה\"ז הגשמי."
        },
        {
          "s": 10,
          "text": "ונאמר ויהי נועם אד' אלקינו עלינו,"
        },
        {
          "s": 11,
          "text": "כי עיקר הגילוי הוא לישראל,"
        },
        {
          "s": 12,
          "text": "ועי\"ז יומשך מעין גילוי זה בכל העולם71,"
        },
        {
          "s": 13,
          "text": "בגאולה האמיתית והשלימה ע\"י משיח צדקינו,"
        },
        {
          "s": 14,
          "text": "בקרוב ממש."
        }
      ]
    }
  ]
}