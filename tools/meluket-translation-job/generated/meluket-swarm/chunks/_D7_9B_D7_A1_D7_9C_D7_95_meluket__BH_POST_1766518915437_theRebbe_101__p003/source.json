{
  "globalIndex": 291,
  "owner": 41,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915437_theRebbe_101__p003",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915437_theRebbe_101__p003",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915437_theRebbe_101",
  "title": "מאמר אשר ברא תשל\"ט",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ומדייק בהמאמר38"
        },
        {
          "s": 2,
          "text": "למה מקדים ששון ושמחה לפני חתן וכלה,"
        },
        {
          "s": 3,
          "text": "והרי השמחה"
        },
        {
          "s": 4,
          "text": "(שבברכה זו)"
        },
        {
          "s": 5,
          "text": "היא מה שמשמחים את החתן ואת הכלה וכמאמר39"
        },
        {
          "s": 6,
          "text": "כיצד מרקדין לפני הכלה."
        },
        {
          "s": 7,
          "text": "גם אינו מובן40"
        },
        {
          "s": 8,
          "text": "מ\"ש אשר ברא כו' חתן וכלה,"
        },
        {
          "s": 9,
          "text": "דכיון שהתחלת הענין דחתן וכלה הוא חתן וכלה שלמעלה,"
        },
        {
          "s": 10,
          "text": "איך שייך לומר על זה אשר ברא,"
        },
        {
          "s": 11,
          "text": "לשון בריאה."
        },
        {
          "s": 12,
          "text": "והרי אפילו כלה"
        },
        {
          "s": 13,
          "text": "(שלמעלה),"
        },
        {
          "s": 14,
          "text": "ספירת המלכות,"
        },
        {
          "s": 15,
          "text": "היא בכלל הספירות דאצילות"
        },
        {
          "s": 16,
          "text": "[עשר ולא תשע41,"
        },
        {
          "s": 17,
          "text": "כי המלכות משלימה הספירות,"
        },
        {
          "s": 18,
          "text": "אנכי42"
        },
        {
          "s": 19,
          "text": "שלומי אמוני ישראל43],"
        },
        {
          "s": 20,
          "text": "ועאכו\"כ בחתן שלמעלה שהוא ז\"א,"
        },
        {
          "s": 21,
          "text": "איך שייך לומר בו הלשון בריאה."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ומבאר44 בהקדם מ\"ש45"
        },
        {
          "s": 1,
          "text": "לפני לא נוצר א-ל,"
        },
        {
          "s": 2,
          "text": "שאינו מובן46"
        },
        {
          "s": 3,
          "text": "איך שייך לשון יצירה על שם א-ל שהוא משמותיו של הקב\"ה,"
        },
        {
          "s": 4,
          "text": "מז' השמות שאינם נמחקים47."
        },
        {
          "s": 5,
          "text": "והדיוק בפסוק זה הוא עוד יותר מהדיוק בברכת אשר ברא,"
        },
        {
          "s": 6,
          "text": "כיון שיצירה"
        },
        {
          "s": 7,
          "text": "(\"נוצר\")"
        },
        {
          "s": 8,
          "text": "היא למטה מבריאה"
        },
        {
          "s": 9,
          "text": "(\"ברא\")."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "והענין הוא,"
        },
        {
          "s": 1,
          "text": "שמבאר בהמאמר44,"
        },
        {
          "s": 2,
          "text": "דשם א-ל שייך לעולמות."
        },
        {
          "s": 3,
          "text": "דשם א-ל הוא בחסד48,"
        },
        {
          "s": 4,
          "text": "ובענין החסד כתיב49"
        },
        {
          "s": 5,
          "text": "כי אמרתי עולם חסד יבנה,"
        },
        {
          "s": 6,
          "text": "שהכוונה בזה היא שבנין העולם הוא ע\"י ספירת החסד ושבנין ספירת החסד הוא בשביל התהוות העולמות50."
        },
        {
          "s": 7,
          "text": "ולכן שייך בשם א-ל לשון יצירה להיותו מקור לעולמות."
        },
        {
          "s": 8,
          "text": "ועד\"ז51"
        },
        {
          "s": 9,
          "text": "הוא גם בנוגע לבחי' חתן"
        },
        {
          "s": 10,
          "text": "(ששייך בו לשון בריאה),"
        },
        {
          "s": 11,
          "text": "כי חתן הוא מלשון חות דרגא52"
        },
        {
          "s": 12,
          "text": "[דהגם שהחילוק בין ז\"א"
        },
        {
          "s": 13,
          "text": "(חתן)"
        },
        {
          "s": 14,
          "text": "למלכות"
        },
        {
          "s": 15,
          "text": "(כלה)"
        },
        {
          "s": 16,
          "text": "הוא שהמלכות גם כמו שהיא באצילות היא השרש ומקור דבי\"ע משא\"כ ז\"א הוא סוף עולמות הא\"ס"
        },
        {
          "s": 17,
          "text": "(כמבואר בתו\"א53"
        },
        {
          "s": 18,
          "text": "ב\"כי\"ק אדמו\"ר נ\"ע\"),"
        },
        {
          "s": 19,
          "text": "מ\"מ חתן הוא מלשון חות דרגא],"
        },
        {
          "s": 20,
          "text": "ירידה,"
        },
        {
          "s": 21,
          "text": "ולכן שייך בו לשון בריאה."
        }
      ]
    }
  ]
}