{
  "globalIndex": 785,
  "owner": 35,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918472_theRebbe_445__p001",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918472_theRebbe_445__p001",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918472_theRebbe_445",
  "title": "מאמר לה\"ע פסח שני תשל\"ח",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד*."
        },
        {
          "s": 1,
          "text": "מוצאי ש\"ק פ' אמור,"
        },
        {
          "s": 2,
          "text": "י\"ג אייר*"
        },
        {
          "s": 3,
          "text": "*,"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "אור לי\"ד אייר,"
        },
        {
          "s": 1,
          "text": "פסח שני,"
        },
        {
          "s": 2,
          "text": "ה'תשל\"ח"
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "להבין ענין פסח שני,"
        },
        {
          "s": 1,
          "text": "ומבאר אדמו\"ר הצ\"צ במאמרו ד\"ה זה1,"
        },
        {
          "s": 2,
          "text": "דענין פסח שני יובן ע\"פ שלשה הקדמות."
        },
        {
          "s": 3,
          "text": "הקדמה הא' היא ההפרש בין חודש הראשון"
        },
        {
          "s": 4,
          "text": "(ניסן)"
        },
        {
          "s": 5,
          "text": "וחודש השני"
        },
        {
          "s": 6,
          "text": "(אייר)"
        },
        {
          "s": 7,
          "text": "בעבודת האדם."
        },
        {
          "s": 8,
          "text": "דבחודש ניסן,"
        },
        {
          "s": 9,
          "text": "שהנקודה בו היא יציאת מצרים,"
        },
        {
          "s": 10,
          "text": "היא העבודה דסור מרע,"
        },
        {
          "s": 11,
          "text": "היינו שהרע הוא בתקפו והעבודה היא להיות סור מרע,"
        },
        {
          "s": 12,
          "text": "לצאת ולברוח מהרע,"
        },
        {
          "s": 13,
          "text": "אתכפיא2."
        },
        {
          "s": 14,
          "text": "והעבודה דחודש אייר"
        },
        {
          "s": 15,
          "text": "[דענינו המיוחד של חודש זה שבו הוא נבדל משאר החדשים הוא שבכל יום בו ישנה מצוה מיוחדה"
        },
        {
          "s": 16,
          "text": "(דספירת העומר)3]"
        },
        {
          "s": 17,
          "text": "היא העבודה דספירת העומר,"
        },
        {
          "s": 18,
          "text": "שענינה הוא4"
        },
        {
          "s": 19,
          "text": "בירור המדות והפיכתם לקדושה,"
        },
        {
          "s": 20,
          "text": "אתהפכא."
        },
        {
          "s": 21,
          "text": "וזהו מ\"ש5"
        },
        {
          "s": 22,
          "text": "באחד לחודש השני גו' לצאתם מארץ מצרים,"
        },
        {
          "s": 23,
          "text": "דעבודה הראשונה דיציאת מצרים,"
        },
        {
          "s": 24,
          "text": "חודש הראשון,"
        },
        {
          "s": 25,
          "text": "היא אתכפיא סט\"א,"
        },
        {
          "s": 26,
          "text": "ולאח\"ז באה העבודה דאתהפכא,"
        },
        {
          "s": 27,
          "text": "עבודה שני' ביציאת מצרים,"
        },
        {
          "s": 28,
          "text": "חודש השני6."
        },
        {
          "s": 29,
          "text": "והקדמה הב' היא החילוק בין שני חדשים אלו בענין הספירות."
        },
        {
          "s": 30,
          "text": "דחודש הראשון הוא במלכות,"
        },
        {
          "s": 31,
          "text": "ספירה הראשונה מלמטה למעלה,"
        },
        {
          "s": 32,
          "text": "וחודש השני הוא ביסוד,"
        },
        {
          "s": 33,
          "text": "ספירה השני'7."
        },
        {
          "s": 34,
          "text": "ומבאר בהמאמר,"
        },
        {
          "s": 35,
          "text": "דשני הקדמות אלו"
        },
        {
          "s": 36,
          "text": "[ענינם של ניסן ואייר בעבודת האדם,"
        },
        {
          "s": 37,
          "text": "וענינם בספירות]"
        },
        {
          "s": 38,
          "text": "שייכים זה לזה,"
        },
        {
          "s": 39,
          "text": "כמבואר בתו\"א ד\"ה והנה אנחנו מאלמים אלומים8"
        },
        {
          "s": 40,
          "text": "דהבירור שע\"י השבטים"
        },
        {
          "s": 41,
          "text": "(שהיו מרכבה לבחינת המלכות),"
        },
        {
          "s": 42,
          "text": "בירור ראשון,"
        },
        {
          "s": 43,
          "text": "הוא רק ביטול היש"
        },
        {
          "s": 44,
          "text": "(דוגמת אתכפיא9),"
        },
        {
          "s": 45,
          "text": "והבירור שע\"י יוסף הצדיק,"
        },
        {
          "s": 46,
          "text": "בחינת יסוד,"
        },
        {
          "s": 47,
          "text": "בירור שני,"
        },
        {
          "s": 48,
          "text": "הוא שיהי' נכלל באלקות,"
        },
        {
          "s": 49,
          "text": "ביטול במציאות"
        },
        {
          "s": 50,
          "text": "(דוגמת אתהפכא9)."
        },
        {
          "s": 51,
          "text": "והקדמה הג' היא,"
        },
        {
          "s": 52,
          "text": "דענין פסח,"
        },
        {
          "s": 53,
          "text": "פסח מלשון דילוג וקפיצה10,"
        },
        {
          "s": 54,
          "text": "הוא המשכה נעלית ביותר שאינה יכולה לבוא בדרך השתלשלות ורק בדרך דילוג,"
        },
        {
          "s": 55,
          "text": "כמבואר בלקו\"ת11."
        },
        {
          "s": 56,
          "text": "ומבאר בהמאמר,"
        },
        {
          "s": 57,
          "text": "דמזה מובן,"
        },
        {
          "s": 58,
          "text": "שגם ענינו של פסח שני12"
        },
        {
          "s": 59,
          "text": "הוא דילוג,"
        },
        {
          "s": 60,
          "text": "המשכה שלמעלה מהשתלשלות."
        },
        {
          "s": 61,
          "text": "והחילוק בין פסח ראשון ופסח שני הוא בהמקום ובהענין שבו נמשכת המשכה זו."
        },
        {
          "s": 62,
          "text": "דבפסח ראשון כתיב13"
        },
        {
          "s": 63,
          "text": "ופסח הוי' על הפתח,"
        },
        {
          "s": 64,
          "text": "שההמשכה שבדרך דילוג"
        },
        {
          "s": 65,
          "text": "(ופסח)"
        },
        {
          "s": 66,
          "text": "היתה בפתח,"
        },
        {
          "s": 67,
          "text": "ספירת המלכות14,"
        },
        {
          "s": 68,
          "text": "ובנפש האדם – ביראה תתאה"
        },
        {
          "s": 69,
          "text": "(זה השער להוי'15)"
        },
        {
          "s": 70,
          "text": "שהיא השורש דסור מרע16,"
        },
        {
          "s": 71,
          "text": "וההמשכה שבדרך דילוג שבפסח שני היא בספירת היסוד,"
        },
        {
          "s": 72,
          "text": "שענינה בנפש האדם הוא ההתקשרות והאהבה17,"
        },
        {
          "s": 73,
          "text": "שעי\"ז נהפכים המדות שלו לקדושה,"
        },
        {
          "s": 74,
          "text": "אתהפכא."
        }
      ]
    }
  ]
}