{
  "globalIndex": 295,
  "owner": 45,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915462_theRebbe_206__p002",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915462_theRebbe_206__p002",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915462_theRebbe_206",
  "title": "מאמר א\"ר אושעיא תשל\"ט",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ומדייק בהמאמר22,"
        },
        {
          "s": 2,
          "text": "דלפי פירוש זה בצדקת פרזונו"
        },
        {
          "s": 3,
          "text": "(צדקה כו' שפיזרן כו')"
        },
        {
          "s": 4,
          "text": "הול\"ל צדקת פזרונו ולמה נאמר פרזונו."
        },
        {
          "s": 5,
          "text": "ומבאר23,"
        },
        {
          "s": 6,
          "text": "שפרזונו הוא ע\"ד מ\"ש24"
        },
        {
          "s": 7,
          "text": "פרזות תשב ירושלים."
        },
        {
          "s": 8,
          "text": "והיינו,"
        },
        {
          "s": 9,
          "text": "שהצדקה שעשה הקב\"ה בישראל בזה שפיזרן לבין האומות הוא בכדי שעי\"ז יגיעו למדריגה נעלית יותר מכמו שהיו לפני הירידה דפיזרן,"
        },
        {
          "s": 10,
          "text": "ועד לבחי' פרזות תשב ירושלים"
        },
        {
          "s": 11,
          "text": "(פרזונו)."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ויובן זה ע\"פ מארז\"ל25"
        },
        {
          "s": 2,
          "text": "שכל מה שיש בעולם יש באדם"
        },
        {
          "s": 3,
          "text": "[שלכן נקרא האדם עולם קטן26,"
        },
        {
          "s": 4,
          "text": "וכאו\"א חייב לומר בשבילי נברא העולם27]."
        },
        {
          "s": 5,
          "text": "ומזה מובן,"
        },
        {
          "s": 6,
          "text": "שבאדם,"
        },
        {
          "s": 7,
          "text": "אתם קרויין אדם28,"
        },
        {
          "s": 8,
          "text": "יש בחי' ירושלים."
        },
        {
          "s": 9,
          "text": "והיינו,"
        },
        {
          "s": 10,
          "text": "שגם בזמן הגלות כשמפני חטאינו גלינו מארצנו ונתרחקנו מעל אדמתנו29"
        },
        {
          "s": 11,
          "text": "[שענין זה"
        },
        {
          "s": 12,
          "text": "(גלינו מארצנו ונתרחקנו מעל אדמתנו)"
        },
        {
          "s": 13,
          "text": "הוא גם בבנ\"י הנמצאים בארץ הקודש תובב\"א30],"
        },
        {
          "s": 14,
          "text": "מ\"מ,"
        },
        {
          "s": 15,
          "text": "ענין ירושלים ברוחניות הוא נצחי גם עכשיו,"
        },
        {
          "s": 16,
          "text": "בכאו\"א מישראל."
        },
        {
          "s": 17,
          "text": "והענין הוא,"
        },
        {
          "s": 18,
          "text": "דהנה ידוע31"
        },
        {
          "s": 19,
          "text": "שירושלים פירושו הוא יראה שלם"
        },
        {
          "s": 20,
          "text": "[וענין זה הוא גם בנוגע לעיר ירושלים כפשוטה,"
        },
        {
          "s": 21,
          "text": "כדאיתא בתוספות32"
        },
        {
          "s": 22,
          "text": "בשם המדרש33"
        },
        {
          "s": 23,
          "text": "ששם ירושלים הוא על שם שלם שקראה מלכי צדק מלך שלם ועל שם יראה שקראה אברהם],"
        },
        {
          "s": 24,
          "text": "שהוא שלימות היראה."
        },
        {
          "s": 25,
          "text": "וזהו שירושלים הרוחנית היא נצחית גם עכשיו בזמן הגלות,"
        },
        {
          "s": 26,
          "text": "כי בכאו\"א מישראל גם בזמן הגלות יש"
        },
        {
          "s": 27,
          "text": "(בהעלם עכ\"פ)"
        },
        {
          "s": 28,
          "text": "שלימות היראה,"
        },
        {
          "s": 29,
          "text": "כדלקמן."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ויובן זה בהקדים,"
        },
        {
          "s": 1,
          "text": "דבענינה של ירושלים"
        },
        {
          "s": 2,
          "text": "(שלימות היראה)"
        },
        {
          "s": 3,
          "text": "בעבודת האדם,"
        },
        {
          "s": 4,
          "text": "שני פירושים."
        },
        {
          "s": 5,
          "text": "דבכ\"מ34"
        },
        {
          "s": 6,
          "text": "מבואר שירושלים היא היראה כמו שבאה בציור דיראה,"
        },
        {
          "s": 7,
          "text": "וזהו\"ע ירושלים של מטה וירושלים של מעלה,"
        },
        {
          "s": 8,
          "text": "כי ביראה יש בכללות שתי מדריגות,"
        },
        {
          "s": 9,
          "text": "יראה תתאה – ירושלים של מטה,"
        },
        {
          "s": 10,
          "text": "ויראה עילאה – ירושלים של מעלה."
        },
        {
          "s": 11,
          "text": "וזהו אמר הקב\"ה לא אבוא בירושלים של מעלה עד שאבוא לירושלים של מטה35,"
        },
        {
          "s": 12,
          "text": "דהגם שמצד הגילויים יראה תתאה היא למטה מטה לגבי יראה עילאה,"
        },
        {
          "s": 13,
          "text": "מ\"מ,"
        },
        {
          "s": 14,
          "text": "כיון שיראה תתאה שרשה מיראה עילאה36,"
        },
        {
          "s": 15,
          "text": "ועד ששניהם חד הוא37,"
        },
        {
          "s": 16,
          "text": "לכן,"
        },
        {
          "s": 17,
          "text": "ע\"י יראה תתאה"
        },
        {
          "s": 18,
          "text": "(ירושלים של מטה)"
        },
        {
          "s": 19,
          "text": "מגיעים ליראה עילאה"
        },
        {
          "s": 20,
          "text": "(ירושלים של מעלה)38."
        },
        {
          "s": 21,
          "text": "ומהמשך הענינים שבמאמר זה מובן39,"
        },
        {
          "s": 22,
          "text": "דירושלים הוא נקודת היראת שמים שלמעלה מהשכל,"
        },
        {
          "s": 23,
          "text": "נקודה שלמעלה מציור,"
        },
        {
          "s": 24,
          "text": "שישנה בכאו\"א מישראל,"
        },
        {
          "s": 25,
          "text": "מצד עצם הנשמה שבו שלמעלה מגילויים40."
        },
        {
          "s": 26,
          "text": "ויש לומר,"
        },
        {
          "s": 27,
          "text": "דמהטעמים על זה שנקודה זו נקראת בשם ירושלים,"
        },
        {
          "s": 28,
          "text": "שלימות היראה,"
        },
        {
          "s": 29,
          "text": "הוא,"
        },
        {
          "s": 30,
          "text": "כי אמיתית ענין השלימות הוא שאין שייך שיהי' בו חסרון."
        },
        {
          "s": 31,
          "text": "ולכן,"
        },
        {
          "s": 32,
          "text": "היראה כמו שבאה בגילוי"
        },
        {
          "s": 33,
          "text": "(בציור דיראה),"
        },
        {
          "s": 34,
          "text": "כיון שאפשר שיהי' בה חסרון,"
        },
        {
          "s": 35,
          "text": "אין בה אמיתית השלימות,"
        },
        {
          "s": 36,
          "text": "ואמיתית השלימות היא בנקודת היראת שמים שלמעלה מגילוי,"
        },
        {
          "s": 37,
          "text": "דנקודה זו ישנה תמיד בכאו\"א מישראל."
        }
      ]
    }
  ]
}