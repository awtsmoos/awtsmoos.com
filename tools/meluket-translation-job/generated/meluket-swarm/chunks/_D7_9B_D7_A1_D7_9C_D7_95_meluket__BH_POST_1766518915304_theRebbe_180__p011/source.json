{
  "globalIndex": 265,
  "owner": 15,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915304_theRebbe_180__p011",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915304_theRebbe_180__p011",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915304_theRebbe_180",
  "title": "מאמר ושבתי בשלום תשל\"ח",
  "part": 11,
  "sections": [
    {
      "v": 30,
      "items": [
        {
          "s": 0,
          "text": "כ)"
        },
        {
          "s": 1,
          "text": "ג)"
        },
        {
          "s": 2,
          "text": "וזוהי ג\"כ השייכות דענין ושבתי בשלום אל בית אבי כמו שהוא בעבודת האדם בהיותו בחרן"
        },
        {
          "s": 3,
          "text": "(בזמן הגלות)"
        },
        {
          "s": 4,
          "text": "לענין ושבתי בשלום אל בית אבי"
        },
        {
          "s": 5,
          "text": "(כמו שהוא בפשטות)"
        },
        {
          "s": 6,
          "text": "שקאי על ההשבה והחזרה מחרן לבית אביו שתהי' בהגאולה לע\"ל"
        },
        {
          "s": 7,
          "text": "[וכמובן גם מזה שיצחק"
        },
        {
          "s": 8,
          "text": "(אבי)"
        },
        {
          "s": 9,
          "text": "הוא לשון עתיד,"
        },
        {
          "s": 10,
          "text": "כי ענין הצחוק והתענוג יהי' לע\"ל,"
        },
        {
          "s": 11,
          "text": "כמ\"ש182"
        },
        {
          "s": 12,
          "text": "אז"
        },
        {
          "s": 13,
          "text": "(דוקא)"
        },
        {
          "s": 14,
          "text": "ימלא שחוק פינו."
        },
        {
          "s": 15,
          "text": "דזהו ג\"כ מה שלעתיד דוקא יאמרו183"
        },
        {
          "s": 16,
          "text": "ליצחק כי אתה אבינו184],"
        },
        {
          "s": 17,
          "text": "כי ע\"י העבודה דושבתי בשלום,"
        },
        {
          "s": 18,
          "text": "אתכפיא ואתהפכא חשוכא לנהורא"
        },
        {
          "s": 19,
          "text": "[ענין השלום,"
        },
        {
          "s": 20,
          "text": "שגם המנגד נהפך לקדושה],"
        },
        {
          "s": 21,
          "text": "ולא רק בגופו ונפשו הבהמית אלא גם בחלקו בעולם,"
        },
        {
          "s": 22,
          "text": "עי\"ז יהי' הגילוי דלעתיד,"
        },
        {
          "s": 23,
          "text": "שאז יהי' אמיתית ענין השלום,"
        },
        {
          "s": 24,
          "text": "לא ירעו ולא ישחיתו גו' כי מלאה הארץ דעה את הוי' כמים לים מכסים185."
        }
      ]
    },
    {
      "v": 31,
      "items": [
        {
          "s": 0,
          "text": "כ)"
        },
        {
          "s": 1,
          "text": "ד)"
        },
        {
          "s": 2,
          "text": "והנה הגם שיצחק הוא לשון עתיד לפי שהצחוק והתענוג שלמעלה יהי' לע\"ל"
        },
        {
          "s": 3,
          "text": "(כנ\"ל),"
        },
        {
          "s": 4,
          "text": "מ\"מ,"
        },
        {
          "s": 5,
          "text": "מזה שנקרא עכשיו בשם יצחק,"
        },
        {
          "s": 6,
          "text": "מובן,"
        },
        {
          "s": 7,
          "text": "שגם עכשיו יש תענוג וצחוק זה"
        },
        {
          "s": 8,
          "text": "[וכמ\"ש186"
        },
        {
          "s": 9,
          "text": "צחוק עשה לי אלקים,"
        },
        {
          "s": 10,
          "text": "עשה כבר],"
        },
        {
          "s": 11,
          "text": "שהרי הצחוק והתענוג נעשה מהעבודה דאתכפיא ואתהפכא עכשיו,"
        },
        {
          "s": 12,
          "text": "ורק שגילוי התענוג יהי' לע\"ל"
        },
        {
          "s": 13,
          "text": "(כשיושלמו כל הבירורים)."
        },
        {
          "s": 14,
          "text": "[וכ\"ה גם בנוגע לזה שלע\"ל יאמרו ליצחק כי אתה אבינו מצד זה שיציל את ישראל מהגלות183,"
        },
        {
          "s": 15,
          "text": "שמעין ענין זה יש גם עכשיו."
        },
        {
          "s": 16,
          "text": "שגם בזמן הגלות הוא מגין על ישראל,"
        },
        {
          "s": 17,
          "text": "שהגנה זו תהי' אח\"כ באופן דהצלה מהגלות187]."
        }
      ]
    },
    {
      "v": 32,
      "items": [
        {
          "s": 0,
          "text": "ועד\"ז הוא גם בענין השלום,"
        },
        {
          "s": 1,
          "text": "דהגם שאמיתית ענין השלום"
        },
        {
          "s": 2,
          "text": "(באופן דלא ירעו ולא ישחיתו גו')"
        },
        {
          "s": 3,
          "text": "יהי' לע\"ל"
        },
        {
          "s": 4,
          "text": "(כנ\"ל סו\"ס כג),"
        },
        {
          "s": 5,
          "text": "הנה מעין זה אפשר להיות גם עכשיו בזמן הגלות,"
        },
        {
          "s": 6,
          "text": "שהדברים המונעים ומעכבים וכו' לא רק שלא ינגדו,"
        },
        {
          "s": 7,
          "text": "אלא אדרבה יסייעו לעבודת ה'."
        },
        {
          "s": 8,
          "text": "ועפ\"ז מובן"
        },
        {
          "s": 9,
          "text": "(נוסף להביאור דלעיל שם)"
        },
        {
          "s": 10,
          "text": "השייכות דענין ושבתי בשלום אל בית אבי כמו שהוא בזמן הגלות לענין ושבתי בשלום אל בית אבי שיהי' בגאולה העתידה,"
        },
        {
          "s": 11,
          "text": "כי גם בזמן הגלות כשישנם מונעים ומעכבים"
        },
        {
          "s": 12,
          "text": "[ועד שצריך לבקשה שיהי' ושבתי בשלום גו' שלום ושלילת שפיכות דמים188],"
        },
        {
          "s": 13,
          "text": "הנה גם אז,"
        },
        {
          "s": 14,
          "text": "ע\"י התוקף דמס\"נ שמצד בחי' יחידה,"
        },
        {
          "s": 15,
          "text": "מתבטלים כל המונעים ומעכבים,"
        },
        {
          "s": 16,
          "text": "ולא עוד אלא שהם גופא מסייעים בעבודת ה',"
        },
        {
          "s": 17,
          "text": "בדוגמת ומעין השלום שיהי' לע\"ל."
        }
      ]
    }
  ]
}