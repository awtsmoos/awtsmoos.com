{
  "globalIndex": 13,
  "owner": 13,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913771_theRebbe_98__p001",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913771_theRebbe_98__p001",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518913771_theRebbe_98",
  "title": "מאמר יו\"ט של ר\"ה תשל\"ג",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "כ\"ט אלול ה'תשל\"ב,"
        },
        {
          "s": 2,
          "text": "ליל ערב ראש השנה ה'תשל\"ג"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "יום טוב של ראש השנה שחל להיות בשבת במקדש היו תוקעין אבל לא במדינה1,"
        },
        {
          "s": 1,
          "text": "ומפרש בגמרא2"
        },
        {
          "s": 2,
          "text": "דרבנן הוא דגזור בי',"
        },
        {
          "s": 3,
          "text": "דהכל חייבין בתקיעת שופר ואין הכל בקיאין בתקיעת שופר,"
        },
        {
          "s": 4,
          "text": "גזירה שמא יטלנו בידו וילך אצל הבקי ללמוד ויעבירנו ד' אמות ברשות הרבים."
        },
        {
          "s": 5,
          "text": "וידוע הדיוק בזה3,"
        },
        {
          "s": 6,
          "text": "מה ראו חז\"ל לדחות מ\"ע דאורייתא,"
        },
        {
          "s": 7,
          "text": "ובפרט מצות שופר שהיא מצוה רמה ונישאה מאד4,"
        },
        {
          "s": 8,
          "text": "משום גזירה בעלמא"
        },
        {
          "s": 9,
          "text": "[ובפרט עכשיו,"
        },
        {
          "s": 10,
          "text": "שאין מצוי שיהי' רה\"ר מה\"ת5,"
        },
        {
          "s": 11,
          "text": "והגזירה שמא יעבירנו הוא רק שלא יבוא לאיסור דרבנן]."
        },
        {
          "s": 12,
          "text": "וגם6,"
        },
        {
          "s": 13,
          "text": "הרי החשש הוא להדיוטים וקלי הדעת7,"
        },
        {
          "s": 14,
          "text": "ואיך מנעו בשביל זה המצוה מכמה צדיקים גדולים וטובים."
        },
        {
          "s": 15,
          "text": "וידוע הביאור בזה8,"
        },
        {
          "s": 16,
          "text": "דזה שבראש השנה צריך לתקוע בשופר הוא בכדי לעורר עי\"ז למעלה התענוג בבריאת העולמות,"
        },
        {
          "s": 17,
          "text": "וכיון שבשבת מצד עצמו ישנו התענוג,"
        },
        {
          "s": 18,
          "text": "לכן,"
        },
        {
          "s": 19,
          "text": "בראש השנה שחל להיות בשבת המצוה דתקיעת שופר אינה בתוקף כ\"כ"
        },
        {
          "s": 20,
          "text": "(עם כל השטורעם)"
        },
        {
          "s": 21,
          "text": "כמו בראש השנה שחל בימות השבוע9,"
        },
        {
          "s": 22,
          "text": "ולכן היא נדחית מפני החשש שמא יעבירנו ד' אמות ברשות הרבים."
        },
        {
          "s": 23,
          "text": "וזה שבמקדש היו תוקעין גם בראש השנה שחל בשבת,"
        },
        {
          "s": 24,
          "text": "הוא,"
        },
        {
          "s": 25,
          "text": "כי בתענוג כמה מדריגות,"
        },
        {
          "s": 26,
          "text": "ודרגת התענוג שהמשיכו ע\"י תקיעת שופר במקדש היא נעלית יותר מדרגת התענוג דשבת."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "וצריך להבין,"
        },
        {
          "s": 2,
          "text": "הרי ידוע10"
        },
        {
          "s": 3,
          "text": "דזה שבראש השנה צריך לעורר התענוג ע\"י עבודת האדם"
        },
        {
          "s": 4,
          "text": "(תקיעת שופר),"
        },
        {
          "s": 5,
          "text": "אף שבתחלת הבריאה היתה ההמשכה מעצמה,"
        },
        {
          "s": 6,
          "text": "הוא,"
        },
        {
          "s": 7,
          "text": "כי ע\"י שהתעוררות התענוג דלמעלה"
        },
        {
          "s": 8,
          "text": "(עכשיו)"
        },
        {
          "s": 9,
          "text": "היא ע\"י עבודתם של ישראל,"
        },
        {
          "s": 10,
          "text": "שהשרש דישראל הוא בהעצמות,"
        },
        {
          "s": 11,
          "text": "התענוג שנמשך עכשיו הוא נעלה יותר מהתענוג שנמשך מצד עצמו"
        },
        {
          "s": 12,
          "text": "(בתחלת הבריאה)."
        },
        {
          "s": 13,
          "text": "ועפ\"ז,"
        },
        {
          "s": 14,
          "text": "בראש השנה שחל להיות בשבת,"
        },
        {
          "s": 15,
          "text": "שהתענוג הוא מצד הזמן דשבת"
        },
        {
          "s": 16,
          "text": "(שבת מיקדשא וקיימא11),"
        },
        {
          "s": 17,
          "text": "חסר לכאורה מעלת התענוג שמתעורר ע\"י עבודת האדם."
        },
        {
          "s": 18,
          "text": "ואף שגם בראש השנה שחל להיות בשבת ישנה העבודה דאמירת פסוקי שופרות,"
        },
        {
          "s": 19,
          "text": "הרי אמירת הפסוקים היא בכדי שההמשכה תהי' בגילוי."
        },
        {
          "s": 20,
          "text": "וכמבואר בהמשך יום טוב של ראש השנה תרס\"ו12,"
        },
        {
          "s": 21,
          "text": "דההמשכה שע\"י המצוות אינה בגילוי כ\"כ,"
        },
        {
          "s": 22,
          "text": "והגילוי הוא ע\"י התורה,"
        },
        {
          "s": 23,
          "text": "תורה אור13."
        },
        {
          "s": 24,
          "text": "ולכן,"
        },
        {
          "s": 25,
          "text": "בכדי שהמשכת התענוג שע\"י קיום מצות תקיעת שופר תהי' בגילוי הוא ע\"י אמירת פסוקי שופרות."
        },
        {
          "s": 26,
          "text": "וזהו הטעם שגם בראש השנה שחל להיות בשבת אומרים פסוקי שופרות,"
        },
        {
          "s": 27,
          "text": "אף שהמשכת התענוג אז הוא מצד עצמו,"
        },
        {
          "s": 28,
          "text": "כי ההמשכה שמצד השבת עצמו היא למעלה,"
        },
        {
          "s": 29,
          "text": "ובכדי שיהי' הגילוי למטה הוא ע\"י אמירת פסוקי שופרות."
        },
        {
          "s": 30,
          "text": "וכיון שע\"י אמירת הפסוקים הוא רק גילוי ההמשכה,"
        },
        {
          "s": 31,
          "text": "וההמשכה עצמה היא מצד השבת עצמו,"
        },
        {
          "s": 32,
          "text": "הרי בראש השנה שחל להיות בשבת חסר לכאורה העילוי שנעשה ע\"י עבודה."
        }
      ]
    }
  ]
}