{
  "globalIndex": 936,
  "owner": 36,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919310_theRebbe_548__p004",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919310_theRebbe_548__p004",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919310_theRebbe_548",
  "title": "מאמר זה היום עשה ה' תשל\"ח",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וזהו אומרו אין אנו יודעים במה לשמוח אם ביום או בהקב\"ה,"
        },
        {
          "s": 2,
          "text": "דבכל נס יש שני הענינים דיום ודהקב\"ה."
        },
        {
          "s": 3,
          "text": "דהרמת הטבע שע\"י הנס הוא יום."
        },
        {
          "s": 4,
          "text": "וכנ\"ל"
        },
        {
          "s": 5,
          "text": "(סעיף ב' וג')"
        },
        {
          "s": 6,
          "text": "דע\"י הנס נעשה הרמה ועלי' בהזמן"
        },
        {
          "s": 7,
          "text": "(היום)"
        },
        {
          "s": 8,
          "text": "שבו נעשה הנס."
        },
        {
          "s": 9,
          "text": "והנס עצמו,"
        },
        {
          "s": 10,
          "text": "שענינו הוא למעלה מהטבע,"
        },
        {
          "s": 11,
          "text": "שרש המשכתו הוא מאוא\"ס שלמעלה מעולמות"
        },
        {
          "s": 12,
          "text": "(אור הסובב)"
        },
        {
          "s": 13,
          "text": "כמו שמאיר ומתגלה בעולם32"
        },
        {
          "s": 14,
          "text": "באופן דסובב ומקיף,"
        },
        {
          "s": 15,
          "text": "הקדוש ברוך הוא."
        },
        {
          "s": 16,
          "text": "וכמבואר בכ\"מ33"
        },
        {
          "s": 17,
          "text": "דזה שקוראים אותו ית' בשם הקדוש ברוך הוא,"
        },
        {
          "s": 18,
          "text": "קאי על עצמות אוא\"ס שקדוש ומובדל מעולמות כמו שהוא נמשך"
        },
        {
          "s": 19,
          "text": "(ברוך מלשון המשכה)"
        },
        {
          "s": 20,
          "text": "בעולמות באופן דסובב ומקיף."
        },
        {
          "s": 21,
          "text": "ואין אנו יודעים במה לשמוח אם ביום או בהקב\"ה,"
        },
        {
          "s": 22,
          "text": "כי בכל אחד מהם יש מעלה שאינה בהשני."
        },
        {
          "s": 23,
          "text": "דבדרגת האור,"
        },
        {
          "s": 24,
          "text": "הנס עצמו"
        },
        {
          "s": 25,
          "text": "(הענין דשידוד הטבע)"
        },
        {
          "s": 26,
          "text": "הוא נעלה הרבה יותר מהרמת הטבע שע\"י הנס."
        },
        {
          "s": 27,
          "text": "דהנס עצמו"
        },
        {
          "s": 28,
          "text": "(שידוד הטבע)"
        },
        {
          "s": 29,
          "text": "הוא הגילוי דאור הסובב שלמעלה מעולמות,"
        },
        {
          "s": 30,
          "text": "משא\"כ הרמת הטבע שע\"י הנס הוא הגילוי דאור הסובב כמו שמתלבש בעולמות."
        },
        {
          "s": 31,
          "text": "אבל בהגילוי,"
        },
        {
          "s": 32,
          "text": "הענין דהרמת הטבע הוא נעלה יותר."
        },
        {
          "s": 33,
          "text": "דבהנס עצמו,"
        },
        {
          "s": 34,
          "text": "הגילוי דאור הסובב,"
        },
        {
          "s": 35,
          "text": "אין לאדם השגה בזה."
        },
        {
          "s": 36,
          "text": "שלכן נק' הנסים בשם נפלאות,"
        },
        {
          "s": 37,
          "text": "דפלא הוא שאינו מושג בשכל."
        },
        {
          "s": 38,
          "text": "ולא עוד,"
        },
        {
          "s": 39,
          "text": "אלא שכשאדם רואה דבר פלא הוא משתומם על זה,"
        },
        {
          "s": 40,
          "text": "דהשתוממות הו\"ע הביטול34."
        },
        {
          "s": 41,
          "text": "וכמבואר בכ\"מ35"
        },
        {
          "s": 42,
          "text": "בענין ארבעה שצריכים להודות36,"
        },
        {
          "s": 43,
          "text": "דהודאה"
        },
        {
          "s": 44,
          "text": "(על הנס)"
        },
        {
          "s": 45,
          "text": "הו\"ע הביטול."
        },
        {
          "s": 46,
          "text": "דכמו שבעולם,"
        },
        {
          "s": 47,
          "text": "ענין הנס הוא שהטבע מתבטל"
        },
        {
          "s": 48,
          "text": "[דכיון שהנס בא מהגילוי דעצמות אוא\"ס שלמעלה מהעולמות,"
        },
        {
          "s": 49,
          "text": "שהעולם אינו יכול לקבלו,"
        },
        {
          "s": 50,
          "text": "נעשה עי\"ז ביטול הטבע דעולם],"
        },
        {
          "s": 51,
          "text": "עד\"ז הוא בנוגע להאדם,"
        },
        {
          "s": 52,
          "text": "דע\"י הנס הוא בא להודאה וביטול."
        },
        {
          "s": 53,
          "text": "משא\"כ הענין דהרמת הטבע,"
        },
        {
          "s": 54,
          "text": "שהגילוי דשם הוי' שלמעלה מהטבע נתלבש בהטבע גופא,"
        },
        {
          "s": 55,
          "text": "על זה כתיב37"
        },
        {
          "s": 56,
          "text": "דעו כי הוי' הוא אלקים,"
        },
        {
          "s": 57,
          "text": "ידיעה והשגה."
        },
        {
          "s": 58,
          "text": "וכיון ששמחה היא בבינה דוקא,"
        },
        {
          "s": 59,
          "text": "משא\"כ בחכמה שלמעלה מהשגה אין שייך שמחה38"
        },
        {
          "s": 60,
          "text": "[אף שגם החכמה היא שכל,"
        },
        {
          "s": 61,
          "text": "אלא שהיא נקודה כללית ואינה בהתיישבות."
        },
        {
          "s": 62,
          "text": "דמזה מובן במכ\"ש בנוגע לפלא שלמעלה מהשכל],"
        },
        {
          "s": 63,
          "text": "לכן יש קס\"ד לשמוח ביום."
        },
        {
          "s": 64,
          "text": "ויש להוסיף,"
        },
        {
          "s": 65,
          "text": "דיום הוא אור וגילוי"
        },
        {
          "s": 66,
          "text": "(כמבואר בארוכה בהמאמר דבעל הגאולה בתחלתו)."
        },
        {
          "s": 67,
          "text": "וזהו לשמוח ביום,"
        },
        {
          "s": 68,
          "text": "דהטעם על הקס\"ד לשמוח בהיום שנעשה בו הנס"
        },
        {
          "s": 69,
          "text": "(הענין דהרמת הטבע)"
        },
        {
          "s": 70,
          "text": "הוא,"
        },
        {
          "s": 71,
          "text": "כי ענין זה הוא יום,"
        },
        {
          "s": 72,
          "text": "אור וגילוי"
        },
        {
          "s": 73,
          "text": "(שבא בידיעה והשגה)."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ובא שלמה ופירש נגילה ונשמחה בך בהקב\"ה בך ביראתך כו',"
        },
        {
          "s": 2,
          "text": "דפירוש בך בהקב\"ה"
        },
        {
          "s": 3,
          "text": "(שפירש שלמה)"
        },
        {
          "s": 4,
          "text": "הוא בהקב\"ה עצמו שלמעלה גם מסובב."
        },
        {
          "s": 5,
          "text": "וכמבואר בכ\"מ39"
        },
        {
          "s": 6,
          "text": "דפירוש בך הוא בך בעצמותך."
        },
        {
          "s": 7,
          "text": "דהחידוש של שלמה"
        },
        {
          "s": 8,
          "text": "(החכם מכל אדם40)"
        },
        {
          "s": 9,
          "text": "הוא דשרש הנסים הוא מהעצמות."
        },
        {
          "s": 10,
          "text": "דזה שהגילוי דשם הוי' שלמעלה מהטבע נתלבש בשם אלקים בגימטריא הטבע"
        },
        {
          "s": 11,
          "text": "(דענין זה הוא בכל הנסים,"
        },
        {
          "s": 12,
          "text": "גם בהנסים שלמעלה מהטבע,"
        },
        {
          "s": 13,
          "text": "כנ\"ל סעיף ו),"
        },
        {
          "s": 14,
          "text": "וגם לאחרי התלבשותו בטבע ניכר בגילוי"
        },
        {
          "s": 15,
          "text": "(גם בהנסים המלובשים בטבע,"
        },
        {
          "s": 16,
          "text": "כהנסים דחנוכה ופורים)"
        },
        {
          "s": 17,
          "text": "שהוא נס"
        },
        {
          "s": 18,
          "text": "(הגילוי דשם הוי')"
        },
        {
          "s": 19,
          "text": "שלמעלה מהטבע,"
        },
        {
          "s": 20,
          "text": "הוא בכח העצמות שמחבר ומאחד שני הפכים."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "וזהו הקשר דשני הפירושים בנגילה ונשמחה בך,"
        },
        {
          "s": 1,
          "text": "בך בהקב\"ה"
        },
        {
          "s": 2,
          "text": "(כפירוש המדרש)"
        },
        {
          "s": 3,
          "text": "ובך בעצמותך,"
        },
        {
          "s": 4,
          "text": "כי החיבור והיחוד דקדוש וברוך"
        },
        {
          "s": 5,
          "text": "(סובב וממלא)"
        },
        {
          "s": 6,
          "text": "הוא בכח העצמות."
        },
        {
          "s": 7,
          "text": "וכיון שהפסוק נגילה ונשמחה בך מובא במדרש בהמשך לשתי הסברות"
        },
        {
          "s": 8,
          "text": "(בענין השמחה בהנסים),"
        },
        {
          "s": 9,
          "text": "אם לשמוח בהקב\"ה"
        },
        {
          "s": 10,
          "text": "(בהנס עצמו שנמשך מאור הסובב)"
        },
        {
          "s": 11,
          "text": "או לשמוח בהיום"
        },
        {
          "s": 12,
          "text": "(מהתלבשות הסובב בממלא,"
        },
        {
          "s": 13,
          "text": "שעי\"ז מתלבש הנס בטבע),"
        },
        {
          "s": 14,
          "text": "והחידוש דשלמה הוא שהשמחה צריכה להיות בך בעצמותך שמחבר שני הענינים,"
        },
        {
          "s": 15,
          "text": "לכן אומר בך בהקדוש ברוך הוא"
        },
        {
          "s": 16,
          "text": "(ולא בך בעצמותך),"
        },
        {
          "s": 17,
          "text": "כי כח העצמות שמתגלה בנסים הוא בזה שמאחד ב' הבחינות דקדוש וברוך."
        }
      ]
    }
  ]
}