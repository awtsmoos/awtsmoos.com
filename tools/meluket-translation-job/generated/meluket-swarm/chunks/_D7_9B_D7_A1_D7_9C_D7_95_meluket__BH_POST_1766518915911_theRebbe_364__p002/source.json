{
  "globalIndex": 376,
  "owner": 26,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915911_theRebbe_364__p002",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915911_theRebbe_364__p002",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915911_theRebbe_364",
  "title": "מאמר ברוך שעשה נסים תשמ\"ג",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "דזה שמבאר בארוכה בהמאמר"
        },
        {
          "s": 3,
          "text": "(דחנוכה)"
        },
        {
          "s": 4,
          "text": "הטעם לזה שחנוכת המזבח היתה ע\"י שמן המשחה הוא לא רק בתור הקדמה,"
        },
        {
          "s": 5,
          "text": "שעי\"ז יובן יותר גודל העילוי דשמן למאור"
        },
        {
          "s": 6,
          "text": "(שלמעלה יותר גם משמן המשחה)"
        },
        {
          "s": 7,
          "text": "שבו הי' הנס דחנוכה,"
        },
        {
          "s": 8,
          "text": "אלא,"
        },
        {
          "s": 9,
          "text": "שגם ענין זה"
        },
        {
          "s": 10,
          "text": "(חנוכת המזבח בשמן המשחה)"
        },
        {
          "s": 11,
          "text": "שייך לחנוכה12."
        },
        {
          "s": 12,
          "text": "שהרי הטעם על זה שנקרא בשם חנוכה הוא על שם חנוכת המזבח שהיתה13"
        },
        {
          "s": 13,
          "text": "אז14."
        },
        {
          "s": 14,
          "text": "וזהו גם מהטעמים על זה שבחנוכה קורין קרבנות הנשיאים15."
        },
        {
          "s": 15,
          "text": "דעפ\"ז יש לומר,"
        },
        {
          "s": 16,
          "text": "שגם בחנוכת המזבח שהיתה בחנוכה הי' הענין דשמן המשחה ברוחניות16."
        },
        {
          "s": 17,
          "text": "אלא שיש בו ענין נעלה יותר – הנס שהי' בשמן למאור,"
        },
        {
          "s": 18,
          "text": "שהוא נעלה יותר"
        },
        {
          "s": 19,
          "text": "(כנ\"ל)"
        },
        {
          "s": 20,
          "text": "משמן המשחה."
        },
        {
          "s": 21,
          "text": "וזהו גם מה שסיום הקריאה דימי החנוכה"
        },
        {
          "s": 22,
          "text": "(לאחרי שקוראין הקרבנות דהנשיאים,"
        },
        {
          "s": 23,
          "text": "וגם זאת חנוכת המזבח ביום המשח אותו)"
        },
        {
          "s": 24,
          "text": "הוא בהעלותך את הנרות שרומז"
        },
        {
          "s": 25,
          "text": "(גם)"
        },
        {
          "s": 26,
          "text": "על נרות חנוכה17,"
        },
        {
          "s": 27,
          "text": "דיש לומר,"
        },
        {
          "s": 28,
          "text": "שהוא בסדר דמלמטה למעלה,"
        },
        {
          "s": 29,
          "text": "בתחילה חנוכת המזבח ע\"י שמן המשחה,"
        },
        {
          "s": 30,
          "text": "ולאח\"ז הענין דשמן למאור והנס שנעשה בו."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "וביאור הענין,"
        },
        {
          "s": 2,
          "text": "הנה הקרבנות שהקריבו ע\"ג המזבח,"
        },
        {
          "s": 3,
          "text": "וכן הנסכים שהיו מנסכים עליו,"
        },
        {
          "s": 4,
          "text": "הם המשכת בחי' פנימיות18."
        },
        {
          "s": 5,
          "text": "שלכן נק' קרבנות ונסכים בשם אכילה ושתי'19,"
        },
        {
          "s": 6,
          "text": "כי ההמשכה שע\"י הקרבנות והנסכים היא בחי' פנימיות"
        },
        {
          "s": 7,
          "text": "(בדוגמת אכילה ושתי' בגשמיות שנעשים דם ובשר כבשרו)."
        },
        {
          "s": 8,
          "text": "וההמשכה שע\"י הנסכים היא נעלית יותר מההמשכה שע\"י הקרבנות."
        },
        {
          "s": 9,
          "text": "דכמו שבאכילה ושתי' בגשמיות,"
        },
        {
          "s": 10,
          "text": "ע\"י הלחם מתגלה רק חיצוניות החיות דהנפש וע\"י היין מתגלה פנימיות הנפש,"
        },
        {
          "s": 11,
          "text": "כמו\"כ הוא באכילה ושתי' דמזבח,"
        },
        {
          "s": 12,
          "text": "דההמשכה שע\"י הקרבנות שנק' בשם לחם20"
        },
        {
          "s": 13,
          "text": "הוא"
        },
        {
          "s": 14,
          "text": "(רק)"
        },
        {
          "s": 15,
          "text": "\"התפשטות החיות להחיות כל העולמות\""
        },
        {
          "s": 16,
          "text": "(ממלא כל עלמין),"
        },
        {
          "s": 17,
          "text": "וע\"י הנסכים הוא המשכת וגילוי הפנימיות"
        },
        {
          "s": 18,
          "text": "(שלמעלה מהחיות דעולמות),"
        },
        {
          "s": 19,
          "text": "סובב כל עלמין21."
        },
        {
          "s": 20,
          "text": "ובנסכים גופא,"
        },
        {
          "s": 21,
          "text": "הנה בחג הסוכות הי' גם ניסוך המים22"
        },
        {
          "s": 22,
          "text": "(נוסף על ניסוך היין שהי' גם בכל ימי השנה),"
        },
        {
          "s": 23,
          "text": "שהוא למעלה גם מניסוך היין,"
        },
        {
          "s": 24,
          "text": "וכמבואר בלקו\"ת23,"
        },
        {
          "s": 25,
          "text": "דזהו מה שניסוך היין מפורש בתושב\"כ משא\"כ ניסוך המים הוא הלכה למשה מסיני24"
        },
        {
          "s": 26,
          "text": "ורק דרבנן סמכוה אקראי25,"
        },
        {
          "s": 27,
          "text": "כי בחינת חכמה"
        },
        {
          "s": 28,
          "text": "(ניסוך המים)"
        },
        {
          "s": 29,
          "text": "\"אינה יכולה להיות כתוב בתושב\"כ,"
        },
        {
          "s": 30,
          "text": "שתתפשט בבחי' כתב אותיות\"."
        },
        {
          "s": 31,
          "text": "ולכן,"
        },
        {
          "s": 32,
          "text": "ניסוך המים הוא בתושבע\"פ דוקא,"
        },
        {
          "s": 33,
          "text": "ע\"ד ערבים עלי דברי סופרים יותר מיינה של תורה26."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ויש להוסיף,"
        },
        {
          "s": 1,
          "text": "שהשייכות דענין זה"
        },
        {
          "s": 2,
          "text": "(שיין הוא בינה ומים הם חכמה)"
        },
        {
          "s": 3,
          "text": "ליין ומים כפשוטם בגשמיות היא,"
        },
        {
          "s": 4,
          "text": "שיין יש בו טעם והוא דבר המשמח,"
        },
        {
          "s": 5,
          "text": "ועד שאין אומרים שירה אלא על היין27,"
        },
        {
          "s": 6,
          "text": "משא\"כ מים אין בהם טעם28,"
        },
        {
          "s": 7,
          "text": "שלכן אין מברכים על המים אלא כששותה לצמאו29,"
        },
        {
          "s": 8,
          "text": "לפי שאין הנאה לאדם בשתיית המים אלא בשעה שהוא צמא30."
        },
        {
          "s": 9,
          "text": "דחילוק זה שבין יין למים הוא"
        },
        {
          "s": 10,
          "text": "(בהתאם לענינם ברוחניות)"
        },
        {
          "s": 11,
          "text": "כי יין הוא בינה,"
        },
        {
          "s": 12,
          "text": "טעם"
        },
        {
          "s": 13,
          "text": "(הבנה והשגה),"
        },
        {
          "s": 14,
          "text": "ומים הם חכמה,"
        },
        {
          "s": 15,
          "text": "למעלה מהטעם31."
        }
      ]
    }
  ]
}