{
  "globalIndex": 816,
  "owner": 16,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918633_theRebbe_459__p006",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918633_theRebbe_459__p006",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918633_theRebbe_459",
  "title": "מאמר בחודש השלישי תשכ\"ט",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "ועד\"ז הוא בשני הענינים שבר\"ח סיון,"
        },
        {
          "s": 3,
          "text": "הביטול דיום הזה והביטול דמדבר57,"
        },
        {
          "s": 4,
          "text": "שהמעלה דהביטול דיום הזה על הביטול דמדבר הוא בשני ענינים."
        },
        {
          "s": 5,
          "text": "שהביטול דיום הזה"
        },
        {
          "s": 6,
          "text": "(שהאהבה היא בביטול)"
        },
        {
          "s": 7,
          "text": "הוא גם בהמציאות דהאדם."
        },
        {
          "s": 8,
          "text": "ושעי\"ז דוקא נשלמת הכוונה דדירה בתחתונים."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "ויש להוסיף,"
        },
        {
          "s": 1,
          "text": "דזה שהביטול דיום הזה נמשך גם בהמציאות דהאדם"
        },
        {
          "s": 2,
          "text": "[וגם לאחרי הביטול שנמשך בהמציאות הוא"
        },
        {
          "s": 3,
          "text": "(לא ביטול היש,"
        },
        {
          "s": 4,
          "text": "אלא)"
        },
        {
          "s": 5,
          "text": "ביטול במציאות],"
        },
        {
          "s": 6,
          "text": "הוא ע\"י המשכת העצמות,"
        },
        {
          "s": 7,
          "text": "שבכח העצמות הוא לחבר שני הפכים"
        },
        {
          "s": 8,
          "text": "(ביטול ומציאות)."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר שזה מרומז גם בלשון הכתוב ביום הזה."
        },
        {
          "s": 1,
          "text": "דהנה מבואר בלקו\"ת58,"
        },
        {
          "s": 2,
          "text": "שלשון \"זה\","
        },
        {
          "s": 3,
          "text": "שהוא דבר שאפשר להראות עליו באצבע ולומר זה,"
        },
        {
          "s": 4,
          "text": "הוא רק בהקב\"ה,"
        },
        {
          "s": 5,
          "text": "כמ\"ש59"
        },
        {
          "s": 6,
          "text": "זה א-לי ואנוהו,"
        },
        {
          "s": 7,
          "text": "כי מלוא כל הארץ כבודו60."
        },
        {
          "s": 8,
          "text": "ומבואר במק\"א61"
        },
        {
          "s": 9,
          "text": "דאמיתית הענין ד\"זה\" הוא רק בהעצמות."
        },
        {
          "s": 10,
          "text": "כי פירוש \"זה\" הוא שהדבר שאומרים עליו \"זה\","
        },
        {
          "s": 11,
          "text": "הוא מציאותו של הדבר,"
        },
        {
          "s": 12,
          "text": "וכיון שכל הנמצאים,"
        },
        {
          "s": 13,
          "text": "כולל גם הגילויים הכי נעלים,"
        },
        {
          "s": 14,
          "text": "מציאותם אינה מצד עצמם ותלוי' ברצון העצמות62,"
        },
        {
          "s": 15,
          "text": "א\"א לומר עליהם בשלימות זה הדבר,"
        },
        {
          "s": 16,
          "text": "ואמיתית הענין ד\"זה\" הוא רק בהעצמות."
        },
        {
          "s": 17,
          "text": "וזהו ביום הזה,"
        },
        {
          "s": 18,
          "text": "שגם המציאות דהתפשטות"
        },
        {
          "s": 19,
          "text": "(יום)"
        },
        {
          "s": 20,
          "text": "הוא בביטול"
        },
        {
          "s": 21,
          "text": "(הזה),"
        },
        {
          "s": 22,
          "text": "הוא ע\"י גילוי כח העצמות,"
        },
        {
          "s": 23,
          "text": "יום"
        },
        {
          "s": 24,
          "text": "(גילוי)"
        },
        {
          "s": 25,
          "text": "הזה."
        }
      ]
    }
  ]
}