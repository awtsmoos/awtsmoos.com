{
  "globalIndex": 652,
  "owner": 2,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917575_theRebbe_481__p005",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917575_theRebbe_481__p005",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917575_theRebbe_481",
  "title": "מאמר אלה פקודי תש\"ל",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ויש להוסיף,"
        },
        {
          "s": 2,
          "text": "דזה שמביא בלקו\"ת ראי' על זה שהיחוד נק' פקידה מזה שארז\"ל חייב אדם לפקוד את אשתו55,"
        },
        {
          "s": 3,
          "text": "הוא,"
        },
        {
          "s": 4,
          "text": "כי במארז\"ל זה מדבר בהחיוב לפקוד את אשתו בשעה שהוא יוצא לדרך,"
        },
        {
          "s": 5,
          "text": "ובזה מרמז,"
        },
        {
          "s": 6,
          "text": "דנוסף להענין דפקודי המשכן,"
        },
        {
          "s": 7,
          "text": "שהכוונה בזה שהמקדש נתמשכן היא בכדי שע\"י התשובה יהי' אח\"כ"
        },
        {
          "s": 8,
          "text": "(לע\"ל)"
        },
        {
          "s": 9,
          "text": "היחוד"
        },
        {
          "s": 10,
          "text": "(פקידה)"
        },
        {
          "s": 11,
          "text": "באופן נעלה יותר,"
        },
        {
          "s": 12,
          "text": "גם בשעה זו עצמה"
        },
        {
          "s": 13,
          "text": "(כשנתמשכן המקדש)"
        },
        {
          "s": 14,
          "text": "הי' היחוד."
        },
        {
          "s": 15,
          "text": "וכמבואר במק\"א56"
        },
        {
          "s": 16,
          "text": "מה שארז\"ל57"
        },
        {
          "s": 17,
          "text": "בשעה שנכנסו נכרים להיכל ראו כרובים המעורין זה בזה,"
        },
        {
          "s": 18,
          "text": "דלכאורה תמוה58,"
        },
        {
          "s": 19,
          "text": "הרי כרובין מעורין זה בזה מורה על גודל החיבה דהקב\"ה וישראל כחיבת איש ואשה59,"
        },
        {
          "s": 20,
          "text": "ובשעה שנכנסו נכרים להיכל הרי הי' לכאורה היפך החיבה."
        },
        {
          "s": 21,
          "text": "והביאור בזה,"
        },
        {
          "s": 22,
          "text": "דכיון שבזמן הגלות כנסת ישראל היא כאשה שהלך בעלה למדינת הים60,"
        },
        {
          "s": 23,
          "text": "לכן,"
        },
        {
          "s": 24,
          "text": "לפני יציאתו של הבעל"
        },
        {
          "s": 25,
          "text": "(הקב\"ה)"
        },
        {
          "s": 26,
          "text": "לדרך,"
        },
        {
          "s": 27,
          "text": "היתה הפקידה,"
        },
        {
          "s": 28,
          "text": "ולכן היו אז הכרובים כמער61"
        },
        {
          "s": 29,
          "text": "איש ולויות."
        },
        {
          "s": 30,
          "text": "אלא שהפקידה שהיתה אז היתה בהעלם,"
        },
        {
          "s": 31,
          "text": "ובגילוי הי' החורבן והגלות,"
        },
        {
          "s": 32,
          "text": "והכוונה בזה היא שע\"י העבודה שבזמן הגלות,"
        },
        {
          "s": 33,
          "text": "ובפרט ע\"י עבודת התשובה,"
        },
        {
          "s": 34,
          "text": "תהי' הפקידה בגילוי בבנין ביהמ\"ק השלישי,"
        },
        {
          "s": 35,
          "text": "ואז יוחזר גם המשכון,"
        },
        {
          "s": 36,
          "text": "המשכן ומשכן העדות,"
        },
        {
          "s": 37,
          "text": "בביאת משיח צדקנו בקרוב ממש."
        }
      ]
    }
  ]
}