{
  "globalIndex": 1052,
  "owner": 2,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919986_theRebbe_397__p001",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919986_theRebbe_397__p001",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919986_theRebbe_397",
  "title": "מאמר לא היו ימים טובים לישראל תשל\"ה",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "יום ד',"
        },
        {
          "s": 2,
          "text": "חמשה עשר באב ה'תשל\"ה*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "לא היו ימים טובים לישראל כחמשה עשר באב וכיום הכפורים1,"
        },
        {
          "s": 1,
          "text": "וצריך להבין מהו טעם הדמיון והצד השוה שבין ט\"ו באב ליוהכ\"פ2."
        },
        {
          "s": 2,
          "text": "גם צריך להבין מה שמאמר זה"
        },
        {
          "s": 3,
          "text": "(לא היו יו\"ט כו')"
        },
        {
          "s": 4,
          "text": "הוא בסיום וחותם3"
        },
        {
          "s": 5,
          "text": "מס' תענית,"
        },
        {
          "s": 6,
          "text": "והרי ימים טובים הו\"ע השמחה,"
        },
        {
          "s": 7,
          "text": "היפך ענין התענית."
        },
        {
          "s": 8,
          "text": "ובפרט שמהלשון לא היו יו\"ט לישראל כחמשה עשר באב כו' מוכח שהשמחה שבט\"ו באב"
        },
        {
          "s": 9,
          "text": "(ויוהכ\"פ)"
        },
        {
          "s": 10,
          "text": "היא ביותר מהשמחה שביו\"ט אף שהיא מ\"ע מה\"ת,"
        },
        {
          "s": 11,
          "text": "ושמחת בחגיך4,"
        },
        {
          "s": 12,
          "text": "ולפי\"ז תוקשה יותר השייכות דענין זה ל"
        },
        {
          "s": 13,
          "text": "(סיום וחותם)"
        },
        {
          "s": 14,
          "text": "מס' תענית דוקא."
        },
        {
          "s": 15,
          "text": "והנה השייכות דט\"ו באב לענין תענית מוכח ג\"כ ממה שמקשר"
        },
        {
          "s": 16,
          "text": "(במשנה)"
        },
        {
          "s": 17,
          "text": "חמשה עשר באב ויום הכפורים,"
        },
        {
          "s": 18,
          "text": "שיוהכ\"פ הוא התענית היחידי שמן התורה,"
        },
        {
          "s": 19,
          "text": "ותענית זה הוא מיוחד ושונה משאר התעניות גם בזה שד' הצומות"
        },
        {
          "s": 20,
          "text": "(וכן הצומות שנמנו במגילת תענית,"
        },
        {
          "s": 21,
          "text": "וכמה מהם הובאו בטור5)"
        },
        {
          "s": 22,
          "text": "יהפכו לששון ולשמחה6,"
        },
        {
          "s": 23,
          "text": "משא\"כ התענית דיוהכ\"פ שיהי' גם לעתיד."
        },
        {
          "s": 24,
          "text": "ומזה שמקשר"
        },
        {
          "s": 25,
          "text": "(במשנה)"
        },
        {
          "s": 26,
          "text": "ט\"ו באב עם יוהכ\"פ,"
        },
        {
          "s": 27,
          "text": "מוכח,"
        },
        {
          "s": 28,
          "text": "שהיו\"ט דט\"ו באב שייך הוא לא רק לענין התענית שבמס' תענית"
        },
        {
          "s": 29,
          "text": "[שלכן המאמר לא היו יו\"ט לישראל כט\"ו באב הוא בסיום וחותם מס' תענית],"
        },
        {
          "s": 30,
          "text": "אלא גם להתענית דיוהכ\"פ."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "והנה הטעם מה שט\"ו באב הוא יו\"ט"
        },
        {
          "s": 1,
          "text": "[דלכאורה אינו מובן,"
        },
        {
          "s": 2,
          "text": "וכמו שמקשה בגמרא7"
        },
        {
          "s": 3,
          "text": ": בשלמא יום הכפורים משום דאית בי' סליחה ומחילה,"
        },
        {
          "s": 4,
          "text": "יום שניתנו בו לוחות האחרונות,"
        },
        {
          "s": 5,
          "text": "אלא ט\"ו באב מאי היא],"
        },
        {
          "s": 6,
          "text": "מובא בדרושים8"
        },
        {
          "s": 7,
          "text": "מפע\"ח9,"
        },
        {
          "s": 8,
          "text": "לפי שאז הוא מילוי הלבנה."
        },
        {
          "s": 9,
          "text": "ומקשה על זה בהדרושים,"
        },
        {
          "s": 10,
          "text": "והרי בכל חודש יש יום ט\"ו"
        },
        {
          "s": 11,
          "text": "(שאז הוא מילוי הלבנה),"
        },
        {
          "s": 12,
          "text": "ומהי המעלה דט\"ו באב דוקא,"
        },
        {
          "s": 13,
          "text": "וממ\"ש לא היו יו\"ט כו' כחמשה עשר באב משמע שהוא למעלה גם מט\"ו בניסן"
        },
        {
          "s": 14,
          "text": "(פסח)"
        },
        {
          "s": 15,
          "text": "וט\"ו בתשרי"
        },
        {
          "s": 16,
          "text": "(סוכות)."
        },
        {
          "s": 17,
          "text": "והנה אחד הטעמים בגמרא שם10"
        },
        {
          "s": 18,
          "text": "(על מה שט\"ו באב הוא יו\"ט)"
        },
        {
          "s": 19,
          "text": "הוא,"
        },
        {
          "s": 20,
          "text": "מפני שאז תשש כוחה של חמה."
        },
        {
          "s": 21,
          "text": "ואינו מובן,"
        },
        {
          "s": 22,
          "text": "הרי תשישת כוחה של חמה הו\"ע שבמאורות השמים ואינו נוגע לעניני ופעולות האדם"
        },
        {
          "s": 23,
          "text": "(כשאר הטעמים שבגמרא שם),"
        },
        {
          "s": 24,
          "text": "וא\"כ מהו היו\"ט כשתשש כוחה של חמה."
        },
        {
          "s": 25,
          "text": "והגם שמזה שתשש כוחה של חמה"
        },
        {
          "s": 26,
          "text": "(אף שהו\"ע שבמאורות השמים)"
        },
        {
          "s": 27,
          "text": "ישנן תוצאות בנוגע לענינים ופעולות שבארץ,"
        },
        {
          "s": 28,
          "text": "וכדאיתא בגמרא שם ולא היו כורתין עצים למערכה כו',"
        },
        {
          "s": 29,
          "text": "הרי מלשון הגמרא"
        },
        {
          "s": 30,
          "text": "(מחמשה עשר באב ואילך תשש כוחה של חמה)"
        },
        {
          "s": 31,
          "text": "משמע שהיו\"ט"
        },
        {
          "s": 32,
          "text": "(והשמחה)"
        },
        {
          "s": 33,
          "text": "דחמשה עשר באב הוא מצד זה גופא שתשש כוחה של חמה"
        },
        {
          "s": 34,
          "text": "(ולא רק מצד התוצאות שעי\"ז),"
        },
        {
          "s": 35,
          "text": "וא\"כ צ\"ל,"
        },
        {
          "s": 36,
          "text": "שגם זה דתשש כוחה של חמה שייך הוא לעבודת האדם."
        },
        {
          "s": 37,
          "text": "שזהו ההשתוות דט\"ו באב ויוהכ\"פ,"
        },
        {
          "s": 38,
          "text": "דכמו שהכפרה דיוהכ\"פ נעשית ע\"י עבודת האדם"
        },
        {
          "s": 39,
          "text": "[דהגם שעיצומו של יום מכפר11,"
        },
        {
          "s": 40,
          "text": "מ\"מ,"
        },
        {
          "s": 41,
          "text": "ע\"י עבודת האדם הכפרה היא ביתר שאת וביתר עוז12."
        },
        {
          "s": 42,
          "text": "ויתרה מזו,"
        },
        {
          "s": 43,
          "text": "שגם הכפרה הבאה מצד עיצומו של יום היא דוקא כאשר האדם מקיים"
        },
        {
          "s": 44,
          "text": "(האַלט זיך אָן)"
        },
        {
          "s": 45,
          "text": "עיצומו של יום,"
        },
        {
          "s": 46,
          "text": "שהרי אכרת דיומא יו\"כ אינו מכפר13],"
        },
        {
          "s": 47,
          "text": "עד\"ז הוא גם בנוגע לתשש כוחה של חמה שבט\"ו באב"
        },
        {
          "s": 48,
          "text": "[שגם לאחרי שתשש כו' יש כוחה של חמה,"
        },
        {
          "s": 49,
          "text": "ורק שתשש כוחה],"
        },
        {
          "s": 50,
          "text": "הו\"ע השייך לעבודת האדם."
        }
      ]
    }
  ]
}