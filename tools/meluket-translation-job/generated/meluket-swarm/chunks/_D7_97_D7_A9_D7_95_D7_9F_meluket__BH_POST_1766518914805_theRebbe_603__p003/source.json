{
  "globalIndex": 177,
  "owner": 27,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914805_theRebbe_603__p003",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914805_theRebbe_603__p003",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518914805_theRebbe_603",
  "title": "מאמר ויאמר ה' אל אברם תשל\"ח",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה הגם שב' פירושים הנ\"ל ב\"לך לך\" הם שני פירושים שונים והפכיים,"
        },
        {
          "s": 2,
          "text": "מ\"מ,"
        },
        {
          "s": 3,
          "text": "מכיון שב' הפירושים הם באותה התיבה"
        },
        {
          "s": 4,
          "text": "(תיבת לך),"
        },
        {
          "s": 5,
          "text": "מוכח מזה49,"
        },
        {
          "s": 6,
          "text": "שענין \"לך לך\""
        },
        {
          "s": 7,
          "text": "[וההוראה לכאו\"א מישראל שבפרשה זו]"
        },
        {
          "s": 8,
          "text": "כולל ב' האופנים יחד,"
        },
        {
          "s": 9,
          "text": "הילוך מלמעלה למטה והילוך מלמטה למעלה."
        },
        {
          "s": 10,
          "text": "ובדוגמת \"והתהלכתי בתוככם\"50"
        },
        {
          "s": 11,
          "text": "ש\"והתהלכתי\""
        },
        {
          "s": 12,
          "text": "(לשון רבים)"
        },
        {
          "s": 13,
          "text": "כולל51"
        },
        {
          "s": 14,
          "text": "ב' בחינות הילוך הנ\"ל52."
        },
        {
          "s": 15,
          "text": "וכ\"ה גם בענין ואולך אתכם קוממיות53,"
        },
        {
          "s": 16,
          "text": "ש\"קוממיות\""
        },
        {
          "s": 17,
          "text": "(לשון רבים54)"
        },
        {
          "s": 18,
          "text": "מורה על ב' קומות55"
        },
        {
          "s": 19,
          "text": "[קומה דאור ישר וקומה דאור חוזר,"
        },
        {
          "s": 20,
          "text": "שהם דוגמת ב' בחינות הילוך הנ\"ל56],"
        },
        {
          "s": 21,
          "text": "הכוונה בזה היא ש\"קוממיות\" כולל ב' הקומות יחד."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ויש לקשר זה עם שנה זו"
        },
        {
          "s": 1,
          "text": "(ביחוד),"
        },
        {
          "s": 2,
          "text": "שהיא שנת העיבור,"
        },
        {
          "s": 3,
          "text": "ויתירה מזו שהיא שנת העיבור דסיום מחזור קטן,"
        },
        {
          "s": 4,
          "text": "שבה נעשה ההתאמה דשנת החמה עם שנת הלבנה"
        },
        {
          "s": 5,
          "text": "(בתכלית השלימות)57."
        },
        {
          "s": 6,
          "text": "דהנה שמש הוא בחי' משפיע – דוגמת ענין ההילוך מלמעלמ\"ט,"
        },
        {
          "s": 7,
          "text": "ולבנה"
        },
        {
          "s": 8,
          "text": "(דלית לה מגרמה כלום58)"
        },
        {
          "s": 9,
          "text": "הוא בחי' מקבל – דוגמת ענין ההילוך מלמטלמ\"ע."
        },
        {
          "s": 10,
          "text": "וענין שנת העיבור"
        },
        {
          "s": 11,
          "text": "(ובפרט שנת העיבור דסיום מחזור קטן)"
        },
        {
          "s": 12,
          "text": "הוא צירוף וחיבור ב' העבודות"
        },
        {
          "s": 13,
          "text": "[העבודה דשמש"
        },
        {
          "s": 14,
          "text": "(בחי' משפיע,"
        },
        {
          "s": 15,
          "text": "הילוך מלמעלמ\"ט,"
        },
        {
          "s": 16,
          "text": "שבכללות הוא59"
        },
        {
          "s": 17,
          "text": "עבודת הצדיקים),"
        },
        {
          "s": 18,
          "text": "והעבודה דלבנה"
        },
        {
          "s": 19,
          "text": "(בחי' מקבל,"
        },
        {
          "s": 20,
          "text": "הילוך מלמטה למעלה,"
        },
        {
          "s": 21,
          "text": "שבכללות הוא59"
        },
        {
          "s": 22,
          "text": "עבודת הבעלי תשובה)],"
        },
        {
          "s": 23,
          "text": "שייעשו ענין אחד"
        },
        {
          "s": 24,
          "text": "(שנה תמימה),"
        },
        {
          "s": 25,
          "text": "כמשנ\"ת לעיל60"
        },
        {
          "s": 26,
          "text": "בארוכה."
        },
        {
          "s": 27,
          "text": "וכמ\"ש61"
        },
        {
          "s": 28,
          "text": "ועינינו מאירות כשמש וכירח,"
        },
        {
          "s": 29,
          "text": "שהכוונה בזה היא"
        },
        {
          "s": 30,
          "text": "[לא רק שיהיו ב' המעלות,"
        },
        {
          "s": 31,
          "text": "המעלה דשמש והמעלה דירח אלא גם]"
        },
        {
          "s": 32,
          "text": "שב' הענינים"
        },
        {
          "s": 33,
          "text": "(והמעלות)"
        },
        {
          "s": 34,
          "text": "יהיו כאחד."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "וענין זה"
        },
        {
          "s": 1,
          "text": "[צירוף ואיחוד ב' ענינים הנ\"ל]"
        },
        {
          "s": 2,
          "text": "הוא הכנה וכלי"
        },
        {
          "s": 3,
          "text": "[ובאופן דאבר,"
        },
        {
          "s": 4,
          "text": "שהוא לא רק מקבל אלא גם ממשיך62]"
        },
        {
          "s": 5,
          "text": "להמשכת אוא\"ס שלמעלה מגדר \"מעלה ומטה\"."
        },
        {
          "s": 6,
          "text": "[וע\"ד הידוע63"
        },
        {
          "s": 7,
          "text": "שלאחרי השלימות דאתערותא דלתתא"
        },
        {
          "s": 8,
          "text": "(בחי' לבנה)"
        },
        {
          "s": 9,
          "text": "וגילוי אתערותא דלעילא"
        },
        {
          "s": 10,
          "text": "(בחי' שמש)"
        },
        {
          "s": 11,
          "text": "(הנמשכת ע\"י אתערותא דלתתא)"
        },
        {
          "s": 12,
          "text": "נמשך אח\"כ בחי' אתערותא דלעילא ממקום שאין אתערותא דלתתא מגעת שם כלל]."
        },
        {
          "s": 13,
          "text": "ששלימות העבודה"
        },
        {
          "s": 14,
          "text": "[בצירוף ב' ענינים הנ\"ל,"
        },
        {
          "s": 15,
          "text": "שנה תמימה]"
        },
        {
          "s": 16,
          "text": "הוא האתר שלים,"
        },
        {
          "s": 17,
          "text": "שהוא כלי להשראת אוא\"ס,"
        },
        {
          "s": 18,
          "text": "דקוב\"ה שריא באתר שלים64."
        },
        {
          "s": 19,
          "text": "ועד שעי\"ז נעשה המשכת העצמות שהוא אמיתית ותכלית השלימות."
        },
        {
          "s": 20,
          "text": "ונעשים ישראל וקוב\"ה"
        },
        {
          "s": 21,
          "text": "(ע\"י אורייתא)"
        },
        {
          "s": 22,
          "text": "כולא חד65,"
        },
        {
          "s": 23,
          "text": "ובאופן שאין שייך לחלק ביניהם,"
        },
        {
          "s": 24,
          "text": "מכיון שתורת אמת מעידה שהם חד."
        }
      ]
    }
  ]
}