{
  "globalIndex": 1120,
  "owner": 20,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920487_theRebbe_9__p004",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920487_theRebbe_9__p004",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920487_theRebbe_9",
  "title": "מאמר לך אמר לבי תש\"כ",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש לומר שעד\"ז הוא בשתי המדריגות דפנימיות הלב,"
        },
        {
          "s": 1,
          "text": "דזה שהארת נקודת הלב אינה בבחינת פנימיות כ\"כ כהפנימיות דעצמות נקודת הלב הוא גם כמו שהיא בעצמותה,"
        },
        {
          "s": 2,
          "text": "לפני שהיא מאירה בחיצוניות הלב36."
        },
        {
          "s": 3,
          "text": "דמזה שממנה נמשך להאיר בחיצוניות הלב,"
        },
        {
          "s": 4,
          "text": "מוכח,"
        },
        {
          "s": 5,
          "text": "שאינה אמיתית ענין הפנימיות."
        },
        {
          "s": 6,
          "text": "ואמיתית ענין הפנימיות הוא בעצמות נקודת הלב שהיא מובדלת מחיצוניות הלב."
        },
        {
          "s": 7,
          "text": "וע\"ד שנת\"ל בענין פניך הוי',"
        },
        {
          "s": 8,
          "text": "שהוא למעלה גם מהוי' שלמעלה מהתלבשות באלקים."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ויש להוסיף ביאור בהשייכות דשתי הדרגות שבפנימיות הלב"
        },
        {
          "s": 2,
          "text": "(הארת נקודת הלב ועצמות נקודת הלב)"
        },
        {
          "s": 3,
          "text": "לשתי הדרגות בהפנימיות שלמעלה"
        },
        {
          "s": 4,
          "text": "(הוי' ואוא\"ס שלמעלה מהוי'),"
        },
        {
          "s": 5,
          "text": "ע\"פ המבואר בלקו\"ת שם בפירוש הכתוב37"
        },
        {
          "s": 6,
          "text": "כי תצא למלחמה על אויביך,"
        },
        {
          "s": 7,
          "text": "דכי תצא למלחמה קאי על מלחמת נפש האלקית עם נפש הבהמית38,"
        },
        {
          "s": 8,
          "text": "דמלחמה זו היא בכחות הנשמה המלובשים בגוף"
        },
        {
          "s": 9,
          "text": "(שכל ומדות),"
        },
        {
          "s": 10,
          "text": "משא\"כ פנימיות הלב"
        },
        {
          "s": 11,
          "text": "(הארת נקודת הלב)"
        },
        {
          "s": 12,
          "text": "הוא על אויביך,"
        },
        {
          "s": 13,
          "text": "למעלה מאויביך,"
        },
        {
          "s": 14,
          "text": "שאין להאויב שליטה ואחיזה שם."
        },
        {
          "s": 15,
          "text": "וע\"י הגילוי דהארת נקודת הלב,"
        },
        {
          "s": 16,
          "text": "על אויביך,"
        },
        {
          "s": 17,
          "text": "עי\"ז ושבית שביו37,"
        },
        {
          "s": 18,
          "text": "שנהפך הרע לטוב."
        },
        {
          "s": 19,
          "text": "אלא שהפיכת הרע לטוב שע\"י גילוי הארת נקודת הלב הוא רק בהלבושים מחשבה דיבור ומעשה,"
        },
        {
          "s": 20,
          "text": "ובכדי להפוך המדות מרע לטוב הוא ע\"י גילוי עצמות נקודת הלב39."
        },
        {
          "s": 21,
          "text": "וזהו וראית בשבי' אשת יפת תואר40,"
        },
        {
          "s": 22,
          "text": "אשת יפת תואר היא הנשמה המלובשת בגוף,"
        },
        {
          "s": 23,
          "text": "ובכדי להוציא אותה"
        },
        {
          "s": 24,
          "text": "[את עצמותה ומהותה,"
        },
        {
          "s": 25,
          "text": "היינו השכל והמדות שלה]"
        },
        {
          "s": 26,
          "text": "מהשבי',"
        },
        {
          "s": 27,
          "text": "הוא ע\"י גילוי עצמות נקודת הלב41."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דזה שבנוגע להפיכת הלבושים"
        },
        {
          "s": 2,
          "text": "(שע\"י גילוי הארת נקודת הלב)"
        },
        {
          "s": 3,
          "text": "כתיב ושבית שביו,"
        },
        {
          "s": 4,
          "text": "ובנוגע להפיכת המדות"
        },
        {
          "s": 5,
          "text": "(שע\"י גילוי עצמות נקודת הלב)"
        },
        {
          "s": 6,
          "text": "כתיב וראית בשבי' וגו',"
        },
        {
          "s": 7,
          "text": "הוא,"
        },
        {
          "s": 8,
          "text": "כי לגבי הארת נקודת הלב ישנו מנגד."
        },
        {
          "s": 9,
          "text": "וזהו שבנוגע לדרגא זו כתיב על אויביך,"
        },
        {
          "s": 10,
          "text": "כי לגבי הארת נקודת הלב ישנו מציאות האויב,"
        },
        {
          "s": 11,
          "text": "אלא שהוא באופן דעל אויביך,"
        },
        {
          "s": 12,
          "text": "למעלה מאויביך,"
        },
        {
          "s": 13,
          "text": "שאין להאויב שליטה ואחיזה."
        },
        {
          "s": 14,
          "text": "ולכן,"
        },
        {
          "s": 15,
          "text": "הוצאת הענינים דקדושה"
        },
        {
          "s": 16,
          "text": "(מחשבה דיבור ומעשה דהנשמה)"
        },
        {
          "s": 17,
          "text": "מהשבי',"
        },
        {
          "s": 18,
          "text": "שע\"י גילוי הארת נקודת הלב,"
        },
        {
          "s": 19,
          "text": "היא באופן של פעולה,"
        },
        {
          "s": 20,
          "text": "ושבית שביו"
        },
        {
          "s": 21,
          "text": "[אלא שהפעולה אינה באופן דמלחמה,"
        },
        {
          "s": 22,
          "text": "כי לגבי דרגא זו אין להאויב שליטה]."
        },
        {
          "s": 23,
          "text": "משא\"כ עצמות נקודת הלב הוא"
        },
        {
          "s": 24,
          "text": "[ע\"ד]"
        },
        {
          "s": 25,
          "text": "בחינת היחידה42"
        },
        {
          "s": 26,
          "text": "שאין כנגדה לעומת זה,"
        },
        {
          "s": 27,
          "text": "בבואה דבבואה לית להו43."
        },
        {
          "s": 28,
          "text": "ולכן הביטול דלעו\"ז שע\"י גילוי עצמות נקודת הלב הוא"
        },
        {
          "s": 29,
          "text": "(לא שע\"י גילוי עצמות נקודת הלב נעשה ביטול הלעו\"ז,"
        },
        {
          "s": 30,
          "text": "כי אם)"
        },
        {
          "s": 31,
          "text": "שע\"י גילוי זה,"
        },
        {
          "s": 32,
          "text": "אין מקום מלכתחילה להמציאות דלעו\"ז44."
        },
        {
          "s": 33,
          "text": "וזהו וראית בשבי' אשת יפת תואר,"
        },
        {
          "s": 34,
          "text": "דכאשר ישנו הגילוי דעצמות נקודת הלב,"
        },
        {
          "s": 35,
          "text": "אזי הדרגא דהנשמה"
        },
        {
          "s": 36,
          "text": "(אשת יפת תואר)"
        },
        {
          "s": 37,
          "text": "שהיתה תחלה בשבי',"
        },
        {
          "s": 38,
          "text": "מתגלית מעצמה,"
        },
        {
          "s": 39,
          "text": "וראית"
        },
        {
          "s": 40,
          "text": "(ואין צריך להוציא אותה מהשבי')."
        }
      ]
    }
  ]
}