{
  "globalIndex": 41,
  "owner": 41,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913912_theRebbe_602__p003",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913912_theRebbe_602__p003",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518913912_theRebbe_602",
  "title": "מאמר אדון עולם תשמ\"ג",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה שני האופנים הנ\"ל בקיום המצוות"
        },
        {
          "s": 2,
          "text": "[מפני ובאופן הציווי דלמעלה,"
        },
        {
          "s": 3,
          "text": "והחידוש שנעשה ע\"י ישראל]"
        },
        {
          "s": 4,
          "text": "הם,"
        },
        {
          "s": 5,
          "text": "כמובן,"
        },
        {
          "s": 6,
          "text": "גם במצות תקיעת שופר."
        },
        {
          "s": 7,
          "text": "דהגם שגם ענין הפרטי דשופר"
        },
        {
          "s": 8,
          "text": "(שמצד הציווי)"
        },
        {
          "s": 9,
          "text": "הוא למעלה ממדידה והגבלה."
        },
        {
          "s": 10,
          "text": "דאף שגם במצות תקיעת שופר יש שיעור ומדה"
        },
        {
          "s": 11,
          "text": "(כברוב המצוות37)"
        },
        {
          "s": 12,
          "text": "בנוגע למספר הקולות ואופני הקולות38"
        },
        {
          "s": 13,
          "text": "וכיו\"ב,"
        },
        {
          "s": 14,
          "text": "הרי ענינה"
        },
        {
          "s": 15,
          "text": "(התוכן והכוונה)"
        },
        {
          "s": 16,
          "text": "דמצוה זו הוא העבודה שלמעלה ממדידה והגבלה,"
        },
        {
          "s": 17,
          "text": "וכידוע39"
        },
        {
          "s": 18,
          "text": "שענין תקיעת שופר הוא הצעקה מעומקא דלבא שלמעלה ממדידת והגבלת השכל,"
        },
        {
          "s": 19,
          "text": "בחינת בכל מאדך."
        },
        {
          "s": 20,
          "text": "ועד\"ז"
        },
        {
          "s": 21,
          "text": "(ובמכ\"ש)"
        },
        {
          "s": 22,
          "text": "הוא בבחינת השופר שלמעלה"
        },
        {
          "s": 23,
          "text": "(שנעשה ע\"י תקיעת שופר דהאדם),"
        },
        {
          "s": 24,
          "text": "שהוא למעלה ממדידה והגבלה,"
        },
        {
          "s": 25,
          "text": "שהרי השופר שלמעלה הוא בחינת מקור התענוגים שלמעלה מתענוג פרטי כמבואר בארוכה בדרוש הנ\"ל דאדמו\"ר הצ\"צ."
        },
        {
          "s": 26,
          "text": "ונמצא,"
        },
        {
          "s": 27,
          "text": "דהגם שהענין דתקיעת שופר כמו שהוא מצד הציווי מלמעלה הוא בבחינת בלי גבול"
        },
        {
          "s": 28,
          "text": "[והציווי מלמעלה הוא האתעדל\"ע והנתינת כח על זה שהעבודה דתקיעת שופר תהי' באופן דבכל מאדך],"
        },
        {
          "s": 29,
          "text": "אעפ\"כ,"
        },
        {
          "s": 30,
          "text": "מכיון שישראל מושרשים בעצמות,"
        },
        {
          "s": 31,
          "text": "יש ביכולתם לעשות רצון וענין חדש,"
        },
        {
          "s": 32,
          "text": "המשכת רצון המוחלט בעצמותו שהוא כמובן למעלה גם מבחי' מקור התענוגים הנ\"ל."
        },
        {
          "s": 33,
          "text": "וכנ\"ל"
        },
        {
          "s": 34,
          "text": "(בתחלת המאמר)"
        },
        {
          "s": 35,
          "text": "דענין תמליכוני עליכם שע\"י תקיעת שופר היא ההמשכה"
        },
        {
          "s": 36,
          "text": "(גם)"
        },
        {
          "s": 37,
          "text": "מרצון המוחלט בעצמותו."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ויש לומר שזהו ג\"כ זה שתקיעת שופר מתחיל בקול פשוט דוקא כמבואר בארוכה בסידור ד\"ה להבין ענין תקיעת שופר ע\"פ כוונת הבעש\"ט ז\"ל,"
        },
        {
          "s": 2,
          "text": "דקול פשוט זה מעורר הפשטות"
        },
        {
          "s": 3,
          "text": "(והפשיטות)"
        },
        {
          "s": 4,
          "text": "דישראל,"
        },
        {
          "s": 5,
          "text": "והפשטות דישראל הוא חד עם פשיטות העצמות40."
        },
        {
          "s": 6,
          "text": "וי\"ל שזהו ג\"כ מהטעמים דגודל ההשתדלות דהבעש\"ט"
        },
        {
          "s": 7,
          "text": "[ועוד לפני התגלותו כבעש\"ט]"
        },
        {
          "s": 8,
          "text": "שאנשים פשוטים וגם קטנים וקטנות יאמרו ברוך השם וכיו\"ב"
        },
        {
          "s": 9,
          "text": "[וסיפור פרט זה"
        },
        {
          "s": 10,
          "text": "(דהנהגת הבעש\"ט)"
        },
        {
          "s": 11,
          "text": "נמסר לנו ע\"י רבותינו נשיאינו41,"
        },
        {
          "s": 12,
          "text": "היינו שזוהי הוראה ונתינת כח לכאו\"א],"
        },
        {
          "s": 13,
          "text": "כי כאשר איש פשוט אומר ברוך השם וכיו\"ב,"
        },
        {
          "s": 14,
          "text": "כוונתו בזה היא להעצמות42"
        },
        {
          "s": 15,
          "text": "(כידוע43"
        },
        {
          "s": 16,
          "text": "דמה ששם שמים שגור בפי כל הוא העצמות)."
        },
        {
          "s": 17,
          "text": "ועד\"ז הוא גם בקיום המצוות,"
        },
        {
          "s": 18,
          "text": "דקיום המצוות דאיש פשוט הוא לא מפני שע\"י קיומו המצוות נעשים הענינים למעלה,"
        },
        {
          "s": 19,
          "text": "דאיש פשוט אינו יודע"
        },
        {
          "s": 20,
          "text": "(עדיין)"
        },
        {
          "s": 21,
          "text": "מה למעלה ומה למטה ומה בד' סטרין,"
        },
        {
          "s": 22,
          "text": "אלא מפני הציווי,"
        },
        {
          "s": 23,
          "text": "אשר קדשנו במצוותיו וצונו."
        },
        {
          "s": 24,
          "text": "וזהו\"ע קול פשוט דתקיעת שופר,"
        },
        {
          "s": 25,
          "text": "דלאחרי כל ההשגות בהעילוי שנעשה ע\"י קיום המצוות,"
        },
        {
          "s": 26,
          "text": "דע\"י קיום המצוות דהאדם נעשים המצוות שלמעלה,"
        },
        {
          "s": 27,
          "text": "וכמו במצות תקיעת שופר דעי\"ז נעשה שופר שלמעלה,"
        },
        {
          "s": 28,
          "text": "הנה תכלית השלימות הוא לקיים המצוה בפשטות"
        },
        {
          "s": 29,
          "text": "[וי\"ל שהוא ע\"ד נעוץ תחלתן בסופן44."
        },
        {
          "s": 30,
          "text": "דכמו שתחילת העבודה"
        },
        {
          "s": 31,
          "text": "(לפני ששייך לכוונות)"
        },
        {
          "s": 32,
          "text": "היא בפשטות,"
        },
        {
          "s": 33,
          "text": "עד\"ז הוא גם בגמר וחותם"
        },
        {
          "s": 34,
          "text": "(שלימות)"
        },
        {
          "s": 35,
          "text": "העבודה],"
        },
        {
          "s": 36,
          "text": "ועי\"ז דוקא ממשיכים ונעשים דבר אחד עם פשיטות העצמות."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יובן גם מה שמבואר בדרושי אדמו\"ר מהר\"ש45"
        },
        {
          "s": 2,
          "text": "(שענינו הוא מלכתחילה אַריבער46)"
        },
        {
          "s": 3,
          "text": "שני משלים על תקיעת שופר."
        },
        {
          "s": 4,
          "text": "משל א' בשם הבעש\"ט ז\"ל מבן מלך שהלך בדרך רחוקה וכו' ועד ששכח גם לשון מדינתו והתחיל לצעוק בקול פשוט"
        },
        {
          "s": 5,
          "text": "(בהמשל שם אומר הלשון בקול גדול,"
        },
        {
          "s": 6,
          "text": "אבל בהנמשל אומר הלשון בקול פשוט47)"
        },
        {
          "s": 7,
          "text": "שאביו יכירו בטביעת עין דקלא."
        },
        {
          "s": 8,
          "text": "ומשל ב' מהרה\"ג החסיד מהרלי\"צ ז\"ל מבאַרדיטשוב48"
        },
        {
          "s": 9,
          "text": "מענין לבושים כשהמלך הי' ביער"
        },
        {
          "s": 10,
          "text": "(שאינם בגדי מלכות כלל49),"
        },
        {
          "s": 11,
          "text": "כמבואר שם בארוכה הפרטים שבזה."
        },
        {
          "s": 12,
          "text": "דלכאורה תמוה,"
        },
        {
          "s": 13,
          "text": "הרי ידוע שבראש השנה צריך ליזהר מלהזכיר ענינים ותוארים בלתי רצויים,"
        },
        {
          "s": 14,
          "text": "שלכן אין אומרים וידוי וכו' בראש השנה50,"
        },
        {
          "s": 15,
          "text": "וצריך לדבר אז רק במעלתם ושבחם של ישראל,"
        },
        {
          "s": 16,
          "text": "וכאן מבאר תקיעת שופר דראש השנה במשלים אלו שרוב הפרטים שבהם הם לכאורה ענינים דהיפך השבח51"
        },
        {
          "s": 17,
          "text": "[ודייקתי מטעם זה בהמאמר דערב ראש השנה להזכיר ולדבר רק נקודת התוכן דשני משלים אלו,"
        },
        {
          "s": 18,
          "text": "ולא הפרטים]."
        },
        {
          "s": 19,
          "text": "והגם שמאמר הנ\"ל"
        },
        {
          "s": 20,
          "text": "(שבו נתבארו בפרטיות שני משלים אלו)"
        },
        {
          "s": 21,
          "text": "נאמר בש\"פ תבוא ולא בראש השנה52,"
        },
        {
          "s": 22,
          "text": "אעפ\"כ,"
        },
        {
          "s": 23,
          "text": "הרי משלים אלו הם ביאור על ענין תקיעת שופר דראש השנה."
        },
        {
          "s": 24,
          "text": "וגודל התמי' שבזה,"
        },
        {
          "s": 25,
          "text": "זה גופא מוכיח דכל הפרטים שבמשלים אלו הם"
        },
        {
          "s": 26,
          "text": "(בפנימיות הענינים)"
        },
        {
          "s": 27,
          "text": "לשבח53."
        }
      ]
    }
  ]
}