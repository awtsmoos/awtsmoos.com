{
  "globalIndex": 358,
  "owner": 8,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915808_theRebbe_726__p006",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915808_theRebbe_726__p006",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915808_theRebbe_726",
  "title": "מאמר פדה בשלום תשל\"ח",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יובן התיווך דב' הפירושים בפדה בשלום נפשי"
        },
        {
          "s": 1,
          "text": "[פירוש הפשוט שפדה גו' קאי על הקב\"ה ופירוש חז\"ל שפדה גו' קאי על האדם העוסק בתורה ובגמ\"ח ומתפלל עם הצבור],"
        },
        {
          "s": 2,
          "text": "כי זה שהקב\"ה פודה את ישראל"
        },
        {
          "s": 3,
          "text": "[ועד להענין כפשוטו,"
        },
        {
          "s": 4,
          "text": "שגם בזמן הגלות הנה לא ינום ולא יישן שומר ישראל86,"
        },
        {
          "s": 5,
          "text": "שהקב\"ה שומר את ישראל הן ברוחניות והן בגשמיות,"
        },
        {
          "s": 6,
          "text": "אַז קיין זאַך זאָל זיי ניט קענען אָנרירן ח\"ו,"
        },
        {
          "s": 7,
          "text": "וכמבואר בפרטיות בהמזמור יושב בסתר87."
        },
        {
          "s": 8,
          "text": "ועד ש"
        },
        {
          "s": 9,
          "text": "(אח\"כ)"
        },
        {
          "s": 10,
          "text": "יפדה את ישראל מהגלות]"
        },
        {
          "s": 11,
          "text": "נעשה זה ע\"י האדם"
        },
        {
          "s": 12,
          "text": "(ע\"י עבודתו בג' הקוין),"
        },
        {
          "s": 13,
          "text": "פדאני לי ולבני."
        },
        {
          "s": 14,
          "text": "ועי\"ז,"
        },
        {
          "s": 15,
          "text": "הפדי' שמלמעלה"
        },
        {
          "s": 16,
          "text": "(פירוש הא' בפדה בשלום)"
        },
        {
          "s": 17,
          "text": "היא באופן נעלה יותר מכמו שהיא מצד עצמה."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "ומדייק בזה כל העוסק בתורה כו',"
        },
        {
          "s": 3,
          "text": "שעבודתו בתורה"
        },
        {
          "s": 4,
          "text": "(וגמ\"ח ותפלה)"
        },
        {
          "s": 5,
          "text": "היא באופן דעסק88."
        },
        {
          "s": 6,
          "text": "דכמו בעל עסק הוא טרוד ועסוק בזה כל היום,"
        },
        {
          "s": 7,
          "text": "גם בשעה שאינו עוסק בגוף ועצם מסחרו,"
        },
        {
          "s": 8,
          "text": "כ\"ה גם ענין העוסק בתורה,"
        },
        {
          "s": 9,
          "text": "שהוא עסוק בזה במשך כל היום"
        },
        {
          "s": 10,
          "text": "(גם שלא בזמן לימודו),"
        },
        {
          "s": 11,
          "text": "היינו שגם כשעוסק בעניני הרשות עושה זאת לשם שמים89"
        },
        {
          "s": 12,
          "text": "ועד באופן דדעהו90,"
        },
        {
          "s": 13,
          "text": "שגם בעת עסקו בענינים גשמיים הוא עסוק בעניני ד"
        },
        {
          "s": 14,
          "text": "(ידיעת הוי')"
        },
        {
          "s": 15,
          "text": "תורה91."
        },
        {
          "s": 16,
          "text": "ועי\"ז נעשה פדה בשלום נפשי,"
        },
        {
          "s": 17,
          "text": "שלום בכל עניני"
        },
        {
          "s": 18,
          "text": "(וכחות)"
        },
        {
          "s": 19,
          "text": "נפשו,"
        },
        {
          "s": 20,
          "text": "שלום בפמליא של מעלה ושלום בפמליא של מטה92"
        },
        {
          "s": 21,
          "text": "שב' ענינים אלה ישנם גם בנפש האדם93"
        },
        {
          "s": 22,
          "text": "[ועד שנעשה שלום בשלימותו בין נברא לבורא,"
        },
        {
          "s": 23,
          "text": "שנעשה ישראל"
        },
        {
          "s": 24,
          "text": "(ע\"י אורייתא)"
        },
        {
          "s": 25,
          "text": "וקוב\"ה כולא חד94],"
        },
        {
          "s": 26,
          "text": "וגם בחלקו בעולם."
        },
        {
          "s": 27,
          "text": "דנוסף על שעניני העולם אינם מונעים אותו מעבודת ה',"
        },
        {
          "s": 28,
          "text": "אלא שהם עצמם מסכימים ומסייעים,"
        },
        {
          "s": 29,
          "text": "כי ברבים היו עמדי,"
        },
        {
          "s": 30,
          "text": "שגם הניצוצות קדושה עומדים בתשוקה עצומה"
        },
        {
          "s": 31,
          "text": "(ומתפללים)"
        },
        {
          "s": 32,
          "text": "שיבררו אותם,"
        },
        {
          "s": 33,
          "text": "בדוגמת ענין כי ברבים היו עמדי בפשטות,"
        },
        {
          "s": 34,
          "text": "שגם אנשי אבשלום התפללו95"
        },
        {
          "s": 35,
          "text": "לנצחונו של דוד."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "ואומר פדה בשלום,"
        },
        {
          "s": 1,
          "text": "בשלום הוא ב' שלום"
        },
        {
          "s": 2,
          "text": "(ע\"ד המבואר בתו\"א ד\"ה ושבתי בשלום אל בית אבי96),"
        },
        {
          "s": 3,
          "text": "שלום מלמעלה למטה,"
        },
        {
          "s": 4,
          "text": "ההמשכה מלמעלמ\"ט ע\"י תומ\"צ,"
        },
        {
          "s": 5,
          "text": "ושלום מלמטה למעלה,"
        },
        {
          "s": 6,
          "text": "עבודת התשובה,"
        },
        {
          "s": 7,
          "text": "עד להתשובה דוהרוח תשוב אל האלקים אשר נתנה – נשמה בגוף"
        },
        {
          "s": 8,
          "text": "(לאריכות ימים ושנים טובות),"
        },
        {
          "s": 9,
          "text": "וגם בהיותו בגוף הוא בבחינת והרוח תשוב גו',"
        },
        {
          "s": 10,
          "text": "וע\"ד עולמך תראה בחייך97."
        },
        {
          "s": 11,
          "text": "וב' אופנים אלה שייכים לג' הקוין דתורה וגמ\"ח ותפלה"
        },
        {
          "s": 12,
          "text": "(בצבור),"
        },
        {
          "s": 13,
          "text": "תורה וגמ\"ח הם המשכה מלמעלמ\"ט,"
        },
        {
          "s": 14,
          "text": "ותפלה היא העלאה מלמטלמ\"ע."
        }
      ]
    }
  ]
}