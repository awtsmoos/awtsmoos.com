{
  "globalIndex": 522,
  "owner": 22,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916815_theRebbe_81__p005",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916815_theRebbe_81__p005",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916815_theRebbe_81",
  "title": "מאמר באתי לגני תש\"ל",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ומבאר בהמאמר,"
        },
        {
          "s": 2,
          "text": "דזה שהנשמה אינה צריכה תיקון,"
        },
        {
          "s": 3,
          "text": "הוא,"
        },
        {
          "s": 4,
          "text": "כי כל נשמתא ונשמתא הוה קיימא בדיוקנאה קמי מלכא קדישא63,"
        },
        {
          "s": 5,
          "text": "ומוסיף,"
        },
        {
          "s": 6,
          "text": "שהנשמה קודם שירדה למטה היתה בתכלית הדביקות במקור חוצבה באלקים חיים,"
        },
        {
          "s": 7,
          "text": "בדביקות אמיתי ודביקות תמידי בלי שום פירוד כלל."
        },
        {
          "s": 8,
          "text": "דשני ענינים אלה"
        },
        {
          "s": 9,
          "text": "(הוה קיימא בדיוקנאה קמי מלכא קדישא ושהיתה בתכלית הדביקות)"
        },
        {
          "s": 10,
          "text": "הם שתי דרגות בהביטול דהנשמה."
        },
        {
          "s": 11,
          "text": "קיימא כו' קמי מלכא קדישא הוא כעומד לפני המלך."
        },
        {
          "s": 12,
          "text": "דהגם שכשעומד לפני המלך הוא בטל בתכלית,"
        },
        {
          "s": 13,
          "text": "דמאן דמחוי במחוג קמי מלכא נעשה אצלו היפך חיותו64,"
        },
        {
          "s": 14,
          "text": "מ\"מ,"
        },
        {
          "s": 15,
          "text": "מצד עצמו הוא מציאות והביטול שלו הוא רק מפני שעומד לפני המלך."
        },
        {
          "s": 16,
          "text": "וזה שהנשמה היא בתכלית הדביקות כו' הוא65"
        },
        {
          "s": 17,
          "text": "שאינה מציאות לעצמה."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ומוסיף בהמאמר לאחרי שאומר שהנשמה קודם ירידתה היתה בתכלית הדביקות וכו',"
        },
        {
          "s": 1,
          "text": "שהיתה ברצון אחד להוי' לבדו ואין זר אתו."
        },
        {
          "s": 2,
          "text": "וצריך להבין,"
        },
        {
          "s": 3,
          "text": "דלאחרי שאומר שהיא בתכלית הדביקות,"
        },
        {
          "s": 4,
          "text": "מה מוסיף ומחדש שאין לה רצון זר."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ויש לבאר זה ע\"פ מה דאיתא בגמרא66"
        },
        {
          "s": 1,
          "text": "ביקש יעקב לגלות לבניו קץ הימין ונסתלקה ממנו שכינה,"
        },
        {
          "s": 2,
          "text": "אמר,"
        },
        {
          "s": 3,
          "text": "שמא חס ושלום יש במטתי פסול כו',"
        },
        {
          "s": 4,
          "text": "אמרו לו בניו כו' כשם שאין בלבך אלא אחד כך אין בלבנו אלא אחד."
        },
        {
          "s": 5,
          "text": "וצריך להבין,"
        },
        {
          "s": 6,
          "text": "הרי הביטול דהשבטים"
        },
        {
          "s": 7,
          "text": "(אין בלבנו אלא אחד)"
        },
        {
          "s": 8,
          "text": "הוא למטה במדריגה מהביטול דיעקב"
        },
        {
          "s": 9,
          "text": "[וכמובן מזה עצמו שיעקב"
        },
        {
          "s": 10,
          "text": "(מדת האמת67)"
        },
        {
          "s": 11,
          "text": "בספק הי' שמא יש במטתו פסול],"
        },
        {
          "s": 12,
          "text": "והלשון כשם כו' כך מורה ששני הענינים הם בשוה."
        },
        {
          "s": 13,
          "text": "גם צריך להבין,"
        },
        {
          "s": 14,
          "text": "מה שאמרו שאין בלבך אלא אחד,"
        },
        {
          "s": 15,
          "text": "הרי הביטול של האבות הן הן המרכבה68"
        },
        {
          "s": 16,
          "text": "[ועאכו\"כ של יעקב,"
        },
        {
          "s": 17,
          "text": "בחיר שבאבות69]"
        },
        {
          "s": 18,
          "text": "הי' בכל אברי הגוף70,"
        },
        {
          "s": 19,
          "text": "ולמה אמרו שאין בלבך אלא אחד."
        },
        {
          "s": 20,
          "text": "וביותר אינו מובן,"
        },
        {
          "s": 21,
          "text": "דפירוש ב."
        },
        {
          "s": 22,
          "text": "לבך"
        },
        {
          "s": 23,
          "text": "(בבי\"ת)"
        },
        {
          "s": 24,
          "text": "הוא מה שבתוך לבך71"
        },
        {
          "s": 25,
          "text": "[ע\"ד הפירוש דבקול72],"
        },
        {
          "s": 26,
          "text": "דמזה משמע שאפילו בהלב דיעקב,"
        },
        {
          "s": 27,
          "text": "הענין דאלא אחד הוא רק בפנימיות הלב."
        }
      ]
    }
  ]
}