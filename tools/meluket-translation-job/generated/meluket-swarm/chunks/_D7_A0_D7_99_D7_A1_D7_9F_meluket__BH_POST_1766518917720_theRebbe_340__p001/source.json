{
  "globalIndex": 667,
  "owner": 17,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917720_theRebbe_340__p001",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917720_theRebbe_340__p001",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917720_theRebbe_340",
  "title": "מאמר ויקרא אל משה תשל\"ב",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ ויקרא,"
        },
        {
          "s": 2,
          "text": "ג' ניסן ה'תשל\"ב"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "ויקרא אל משה וידבר הוי' אליו מאוהל מועד גו' אדם כי יקריב מכם גו'1,"
        },
        {
          "s": 1,
          "text": "וצריך להבין,"
        },
        {
          "s": 2,
          "text": "הרי לכל דיברות ולכל אמירות ולכל ציוויים קדמה קריאה לשון חיבה2,"
        },
        {
          "s": 3,
          "text": "ולמה נאמרה הקריאה"
        },
        {
          "s": 4,
          "text": "(בפירוש)"
        },
        {
          "s": 5,
          "text": "בפרשת קרבנות דוקא3."
        },
        {
          "s": 6,
          "text": "והנה בפשטות יש לומר,"
        },
        {
          "s": 7,
          "text": "דמ\"ש ויקרא בפרשת קרבנות הוא,"
        },
        {
          "s": 8,
          "text": "לפי שתחלת הדיבור מאוהל מועד היתה פרשה זו4."
        },
        {
          "s": 9,
          "text": "אבל זה גופא צריך ביאור,"
        },
        {
          "s": 10,
          "text": "מה שהתחלת הדיבור מאוהל מועד היתה פרשת הקרבנות דוקא3."
        },
        {
          "s": 11,
          "text": "ומזה משמע,"
        },
        {
          "s": 12,
          "text": "שהגילוי דתורה"
        },
        {
          "s": 13,
          "text": "(ענינו של אוהל מועד)"
        },
        {
          "s": 14,
          "text": "הוא בעיקר בדיני קרבנות."
        },
        {
          "s": 15,
          "text": "ויש לומר,"
        },
        {
          "s": 16,
          "text": "דזהו גם מה שספר ויקרא"
        },
        {
          "s": 17,
          "text": "(ספר הקרבנות5)"
        },
        {
          "s": 18,
          "text": "הוא החמור שבספרים6."
        },
        {
          "s": 19,
          "text": "וזהו גם מה שהוא ספר השלישי דה' הספרים שבתורה,"
        },
        {
          "s": 20,
          "text": "דמעלת התורה שהיא אוריאן תליתאי7"
        },
        {
          "s": 21,
          "text": "הוא בגילוי יותר בדיני הקרבנות דתורה."
        },
        {
          "s": 22,
          "text": "וזהו גם שזה שלכל הדיברות דתורה קדמה קריאה לשון חיבה למידין ממ\"ש בפרשת הקרבנות,"
        },
        {
          "s": 23,
          "text": "כי גם מעלה זו דתורה עיקר הגילוי שלה הוא בדיני הקרבנות."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויש לבאר זה ע\"פ מ\"ש אדמו\"ר"
        },
        {
          "s": 2,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 3,
          "text": "נ\"ע בעל ההילולא דב' ניסן במאמרו ד\"ה אדם כי יקריב8,"
        },
        {
          "s": 4,
          "text": "דלכאורה הול\"ל כי תקריבו9"
        },
        {
          "s": 5,
          "text": "ומבלי להזכיר מי הוא המקריב."
        },
        {
          "s": 6,
          "text": "ומביא בהמאמר10,"
        },
        {
          "s": 7,
          "text": "דאיתא בזהר11"
        },
        {
          "s": 8,
          "text": "זכאין אינון ישראל דקוב\"ה קרא לון אדם כו' אדם כי יקריב מכם,"
        },
        {
          "s": 9,
          "text": "מאי טעמא קרא לון אדם משום דכתיב12"
        },
        {
          "s": 10,
          "text": "ואתם הדבקים בהוי' אלקיכם גו'."
        },
        {
          "s": 11,
          "text": "ועפ\"ז מבאר מ\"ש אדם כי יקריב"
        },
        {
          "s": 12,
          "text": "(אדם דוקא),"
        },
        {
          "s": 13,
          "text": "כי הכח שיש בישראל13"
        },
        {
          "s": 14,
          "text": "להקריב קרבנות הוא לפי שהם בחינת אדם,"
        },
        {
          "s": 15,
          "text": "שהם דבוקים בהקב\"ה."
        },
        {
          "s": 16,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 17,
          "text": "שעד\"ז איתא במדרש14,"
        },
        {
          "s": 18,
          "text": "דזה שהקב\"ה צוה את ישראל להקריב קרבנות הוא מפני שהן דבוקין לי,"
        },
        {
          "s": 19,
          "text": "הדא הוא דכתיב15"
        },
        {
          "s": 20,
          "text": "כי כאשר ידבק האזור אל מתני איש גו'."
        },
        {
          "s": 21,
          "text": "ומבאר בהמאמר16,"
        },
        {
          "s": 22,
          "text": "שבמדרש מדבר בענין הדביקות דכלים,"
        },
        {
          "s": 23,
          "text": "שהכלים הם17"
        },
        {
          "s": 24,
          "text": "בבחינת מציאות והיחוד"
        },
        {
          "s": 25,
          "text": "(הדביקות)"
        },
        {
          "s": 26,
          "text": "שלהם אינו יחוד עצמי,"
        },
        {
          "s": 27,
          "text": "וכמו כאשר ידבק האזור גו' שהאזור הוא מציאות לעצמו אלא שדבוק להאדם,"
        },
        {
          "s": 28,
          "text": "ובזהר מדבר בענין הדביקות דאורות,"
        },
        {
          "s": 29,
          "text": "שהדביקות והיחוד דאורות הוא יחוד עצמי17,"
        },
        {
          "s": 30,
          "text": "ולכן מביא הכתוב ואתם הדבקים בהוי' אלקיכם,"
        },
        {
          "s": 31,
          "text": "דביקות ממש."
        }
      ]
    }
  ]
}