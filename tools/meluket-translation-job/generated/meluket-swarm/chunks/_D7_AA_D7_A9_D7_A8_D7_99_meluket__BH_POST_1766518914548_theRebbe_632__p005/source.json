{
  "globalIndex": 150,
  "owner": 0,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914548_theRebbe_632__p005",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914548_theRebbe_632__p005",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914548_theRebbe_632",
  "title": "מאמר ביום השמיני תשמ\"א",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ויש להוסיף,"
        },
        {
          "s": 1,
          "text": "שגם החידוש שבתשובה דהחזרת הניצוצות"
        },
        {
          "s": 2,
          "text": "(שבדברים הגשמיים)"
        },
        {
          "s": 3,
          "text": "למקורם,"
        },
        {
          "s": 4,
          "text": "הוא ע\"י נשמות ישראל דוקא63"
        },
        {
          "s": 5,
          "text": "(ע\"י שמקיימים מצוות בדברים הגשמיים,"
        },
        {
          "s": 6,
          "text": "או ע\"י שמשתמשים בהם לשם שמים)."
        },
        {
          "s": 7,
          "text": "ויש לומר שזהו ע\"ד המבואר במקום אחר64"
        },
        {
          "s": 8,
          "text": "דזה שהכח לעשות לו ית' דירה בתחתונים הוא בנש\"י דוקא הוא כי מכיון שעולם הוא מלשון העלם והסתר65,"
        },
        {
          "s": 9,
          "text": "הרי זה שהעולם נעשה כלי לאלקות"
        },
        {
          "s": 10,
          "text": "(היפך הטבע והגדר דעולם)"
        },
        {
          "s": 11,
          "text": "הוא התחדשות66,"
        },
        {
          "s": 12,
          "text": "וע\"ד החידוש דבריאה יש מאין שהוא בכח העצמות67,"
        },
        {
          "s": 13,
          "text": "ולכן עשיית דירה בתחתונים היא ע\"י נשמות ישראל דוקא,"
        },
        {
          "s": 14,
          "text": "דלהיות שהנשמות מושרשות בהעצמות,"
        },
        {
          "s": 15,
          "text": "לכן ניתן להם כח זה."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יש לתווך שני הפירושים ביפה שעה אחת בתשובה ומעשים טובים,"
        },
        {
          "s": 2,
          "text": "דלפי פירוש אחד תשובה היא נעלית יותר ממעשים טובים,"
        },
        {
          "s": 3,
          "text": "ולפי פירוש אחד התשובה היא הקדמה למעשים טובים,"
        },
        {
          "s": 4,
          "text": "כי זה שהתשובה היא נעלית יותר ממעשים טובים הוא זה שהתענוג דתשובה"
        },
        {
          "s": 5,
          "text": "(דהנשמה)"
        },
        {
          "s": 6,
          "text": "הוא תענוג עצמי כנ\"ל,"
        },
        {
          "s": 7,
          "text": "אלא שאעפ\"כ יש מעלה במעשים טובים לגבי תשובה מצד החידוש שבזה"
        },
        {
          "s": 8,
          "text": "(כנ\"ל),"
        },
        {
          "s": 9,
          "text": "וגם מפני שעי\"ז דוקא נשלמת הכוונה דדירה בתחתונים68."
        },
        {
          "s": 10,
          "text": "והתשובה היא הקדמה למעשים טובים,"
        },
        {
          "s": 11,
          "text": "דמכיון שהכח לעשות לו ית' דירה בתחתונים הוא בנשמות דוקא"
        },
        {
          "s": 12,
          "text": "(כנ\"ל),"
        },
        {
          "s": 13,
          "text": "לכן,"
        },
        {
          "s": 14,
          "text": "בכדי שהדירה שנעשית ע\"י מעשה המצוות תהי' בשלימות ובגילוי,"
        },
        {
          "s": 15,
          "text": "מעשים טובים ומאירים,"
        },
        {
          "s": 16,
          "text": "הוא ע\"י קדימת התשובה,"
        },
        {
          "s": 17,
          "text": "הגילוי דשרש הנשמה ועד כמו שמושרשת בהעצמות."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "והנה שני ענינים הנ\"ל שבתשובה,"
        },
        {
          "s": 2,
          "text": "שהיא ענין בפ\"ע ושהיא הקדמה למעשים טובים,"
        },
        {
          "s": 3,
          "text": "הם בדוגמת התשובה דראש השנה והתשובה דעשי\"ת."
        },
        {
          "s": 4,
          "text": "דהתשובה דראש השנה,"
        },
        {
          "s": 5,
          "text": "המרומזת בתקיעת שופר69,"
        },
        {
          "s": 6,
          "text": "עיקרה הוא"
        },
        {
          "s": 7,
          "text": "(לא התשובה על ענינים פרטיים,"
        },
        {
          "s": 8,
          "text": "כי אם)"
        },
        {
          "s": 9,
          "text": "ההשבה למקורו ושרשו70."
        },
        {
          "s": 10,
          "text": "וענין המיצר דשופר הוא"
        },
        {
          "s": 11,
          "text": "(לא מיצר של ועל עוונות,"
        },
        {
          "s": 12,
          "text": "כי אם)"
        },
        {
          "s": 13,
          "text": "זה שהוא \"עם\" ולא המרחב ששם מושרש71."
        },
        {
          "s": 14,
          "text": "דזהו הקשר דשופר עם תמליכוני עליכם,"
        },
        {
          "s": 15,
          "text": "דענין תמליכוני עליכם הוא המשכת המלכות משרשה ומקורה."
        },
        {
          "s": 16,
          "text": "והתשובה דעשרת ימי תשובה"
        },
        {
          "s": 17,
          "text": "[שאז הוא בנין הי\"ס דמלכות72,"
        },
        {
          "s": 18,
          "text": "הפרטים דמלכות]"
        },
        {
          "s": 19,
          "text": "שייכת לפרטים."
        },
        {
          "s": 20,
          "text": "והיא הקדמה להתורה ומצוות"
        },
        {
          "s": 21,
          "text": "(מעשים טובים)"
        },
        {
          "s": 22,
          "text": "שהתחלתם היא בד' הימים שבין יום הכפורים לסוכות,"
        },
        {
          "s": 23,
          "text": "כדאיתא במדרש73"
        },
        {
          "s": 24,
          "text": "שבימים אלו זה עוסק בסוכתו וזה בלולבו,"
        },
        {
          "s": 25,
          "text": "סוכה שהיא מקיף הו\"ע המצוות,"
        },
        {
          "s": 26,
          "text": "לבושים74,"
        },
        {
          "s": 27,
          "text": "ולולב שענינו הוא ההמשכה בפנימיות"
        },
        {
          "s": 28,
          "text": "[כידוע75"
        },
        {
          "s": 29,
          "text": "שע\"י נטילת ד' מינים נמשך המקיף דסוכה בפנימיות],"
        },
        {
          "s": 30,
          "text": "הו\"ע התורה,"
        },
        {
          "s": 31,
          "text": "ותורתך בתוך מעי76."
        },
        {
          "s": 32,
          "text": "ובפרט שבד' המינים עצמם,"
        },
        {
          "s": 33,
          "text": "והגבוה בהם הוא הלולב שיש בו טעם רומז על תורה77."
        },
        {
          "s": 34,
          "text": "ושני ענינים אלו,"
        },
        {
          "s": 35,
          "text": "שבד' הימים שלפני סוכות הם בתור הכנה"
        },
        {
          "s": 36,
          "text": "(עוסק בסוכתו ובלולבו),"
        },
        {
          "s": 37,
          "text": "בחג הסוכות הם בפועל78."
        }
      ]
    }
  ]
}