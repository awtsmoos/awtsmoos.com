{
  "globalIndex": 876,
  "owner": 26,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918942_theRebbe_422__p003",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918942_theRebbe_422__p003",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918942_theRebbe_422",
  "title": "מאמר וישלח יהושוע תשל\"ו",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "דענין זה"
        },
        {
          "s": 3,
          "text": "(שמחדומ\"ע הם לבושים)"
        },
        {
          "s": 4,
          "text": "הוא גם מהטעמים על זה שהענין דמחשבה דיבור ומעשה נוגע יותר מהמדות."
        },
        {
          "s": 5,
          "text": "והיינו,"
        },
        {
          "s": 6,
          "text": "דזה מה שעיקר הענין שדורשים מכאו\"א היא העבודה במחשבה דיבור ומעשה,"
        },
        {
          "s": 7,
          "text": "הוא"
        },
        {
          "s": 8,
          "text": "(לא רק מפני שהם ברשותו כנ\"ל,"
        },
        {
          "s": 9,
          "text": "אלא גם)"
        },
        {
          "s": 10,
          "text": "לפי שזה נוגע יותר."
        },
        {
          "s": 11,
          "text": "ויובן זה בהקדים המבואר בכ\"מ24"
        },
        {
          "s": 12,
          "text": "בענין הלבושים,"
        },
        {
          "s": 13,
          "text": "דשרש הלבושים הוא למעלה משרש האדם המלובש בהם."
        },
        {
          "s": 14,
          "text": "ומעלה זו שמצד שרשם,"
        },
        {
          "s": 15,
          "text": "ניכרת בהם גם לאחרי שנמשכו למטה."
        },
        {
          "s": 16,
          "text": "דזהו מה שהלבושים הם מקיפים על האדם,"
        },
        {
          "s": 17,
          "text": "ומוסיפים בו יופי ותפארת,"
        },
        {
          "s": 18,
          "text": "ר' יוחנן קארי למאני מכבדותא25,"
        },
        {
          "s": 19,
          "text": "לפי שבשרשם הם למעלה מהאדם."
        },
        {
          "s": 20,
          "text": "ועד\"ז הוא גם בלבושי הנפש מחשבה דיבור ומעשה,"
        },
        {
          "s": 21,
          "text": "דשרש הלבושים הוא למעלה מהנפש."
        },
        {
          "s": 22,
          "text": "ולכן,"
        },
        {
          "s": 23,
          "text": "ע\"י המחשבה דיבור ומעשה דתרי\"ג מצוות,"
        },
        {
          "s": 24,
          "text": "שהם הלבושים דנפש האלקית,"
        },
        {
          "s": 25,
          "text": "נעשה עלי' בהנשמה,"
        },
        {
          "s": 26,
          "text": "למעלה יותר מכמו שהיא מצד עצמה26"
        },
        {
          "s": 27,
          "text": "[דזהו גם מה שהמצוות הם לבושים להנשמה שעל ידם דוקא יכולה ליהנות מזיו השכינה,"
        },
        {
          "s": 28,
          "text": "כמבואר בארוכה בכ\"מ27"
        },
        {
          "s": 29,
          "text": "וגם בלקו\"ת ד\"ה זה28],"
        },
        {
          "s": 30,
          "text": "וע\"י המחשבה דיבור ומעשה בעניני העולם שאינם לשם שמים,"
        },
        {
          "s": 31,
          "text": "הלבושים דנפש הבהמית,"
        },
        {
          "s": 32,
          "text": "נעשה ירידה בנפש הבהמית למטה יותר מכמו שהיא מצד עצמה29."
        },
        {
          "s": 33,
          "text": "ומכיון שנפש האלקית מלובשת בנפש הבהמית,"
        },
        {
          "s": 34,
          "text": "ע\"י הירידה בנפש הבהמית,"
        },
        {
          "s": 35,
          "text": "נעשה ירידה גם בנפש האלקית,"
        },
        {
          "s": 36,
          "text": "שנפש הבהמית מורידה גם את נפש האלקית"
        },
        {
          "s": 37,
          "text": "(המלובשת בה)"
        },
        {
          "s": 38,
          "text": "למטה מטה30."
        },
        {
          "s": 39,
          "text": "וזהו מה שעיקר עבודת האדם היא סור מרע ועשה טוב בפועל ממש במחשבה דיבור ומעשה31,"
        },
        {
          "s": 40,
          "text": "כי הכוונה בירידת הנשמה למטה היא בכדי שע\"י עבודתה למטה תתעלה למעלה יותר מכמו שהיא מצד עצמה"
        },
        {
          "s": 41,
          "text": "(כמו שהיתה קודם ירידתה),"
        },
        {
          "s": 42,
          "text": "ועלי' זו נעשית דוקא ע\"י העבודה בהלבושים דמחדומ\"ע,"
        },
        {
          "s": 43,
          "text": "דוגמת הלבושים כפשוטם שעל ידם דוקא מיתוסף יופי ותפארת בהאדם הלובשם וכו'."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "וזהו גם מה שיריחו היא מנעולה של ארץ ישראל,"
        },
        {
          "s": 1,
          "text": "שע\"י העבודה דסור מרע ועשה טוב במחשבה דיבור ומעשה"
        },
        {
          "s": 2,
          "text": "[ומכש\"כ כשישנה גם העבודה דשילוח המרגלים ליריחו,"
        },
        {
          "s": 3,
          "text": "לתור ולבחון את המחדומ\"ע שיהיו כולם להוי'],"
        },
        {
          "s": 4,
          "text": "עי\"ז מגיעים32"
        },
        {
          "s": 5,
          "text": "לבירור והפיכת המדות – כיבוש ארץ ז' עממין,"
        },
        {
          "s": 6,
          "text": "ועד לירחיב ה' אלקיך את גבולך33,"
        },
        {
          "s": 7,
          "text": "כיבוש דגם ארץ קני קניזי וקדמוני34"
        },
        {
          "s": 8,
          "text": "– ג' מוחין35,"
        },
        {
          "s": 9,
          "text": "בביאת משיח צדקנו,"
        },
        {
          "s": 10,
          "text": "בקרוב ממש."
        }
      ]
    }
  ]
}