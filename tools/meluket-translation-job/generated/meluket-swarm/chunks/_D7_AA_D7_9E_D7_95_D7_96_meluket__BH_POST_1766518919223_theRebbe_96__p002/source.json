{
  "globalIndex": 917,
  "owner": 17,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919223_theRebbe_96__p002",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919223_theRebbe_96__p002",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919223_theRebbe_96",
  "title": "מאמר תפלה למשה תשכ\"ט",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש לבאר מה שמביא בהשיחה מאמר המדרש אחד עשר מזמורים אמר משה,"
        },
        {
          "s": 1,
          "text": "שבזה מרמז השייכות דהמזמור תפלה למשה לגאולה העתידה,"
        },
        {
          "s": 2,
          "text": "שענינו של מזמור זה"
        },
        {
          "s": 3,
          "text": "[שהוא הראש והתחילה20"
        },
        {
          "s": 4,
          "text": "דאחד עשר המזמורים]"
        },
        {
          "s": 5,
          "text": "הוא המשכת אחד"
        },
        {
          "s": 6,
          "text": "(חד ולא בחושבן)"
        },
        {
          "s": 7,
          "text": "בעשר"
        },
        {
          "s": 8,
          "text": "(בכל העשר ספירות,"
        },
        {
          "s": 9,
          "text": "עד במלכות)."
        },
        {
          "s": 10,
          "text": "ועפ\"ז יש לבאר מה שממשיך בהשיחה דמעון הוא אותיות נועם21,"
        },
        {
          "s": 11,
          "text": "דמבואר בהדרושים ד\"ה תפלה למשה22"
        },
        {
          "s": 12,
          "text": "דמעון הוא מלכות"
        },
        {
          "s": 13,
          "text": "[ונקראת בשם מעון,"
        },
        {
          "s": 14,
          "text": "מלשון דירה ובית ע\"ד ביתו זו אשתו23]"
        },
        {
          "s": 15,
          "text": "ונועם"
        },
        {
          "s": 16,
          "text": "(תענוג)"
        },
        {
          "s": 17,
          "text": "הוא עתיק,"
        },
        {
          "s": 18,
          "text": "ומעון אותיות נועם הוא ששורש המלכות הוא בעתיק24."
        },
        {
          "s": 19,
          "text": "ויש לומר,"
        },
        {
          "s": 20,
          "text": "דזה שמביא בהשיחה בהמשך להענין דאחד עשר שמעון הוא אותיות נועם,"
        },
        {
          "s": 21,
          "text": "הוא לרמז,"
        },
        {
          "s": 22,
          "text": "שהגילוי דאחד"
        },
        {
          "s": 23,
          "text": "(חד ולא בחושבן)"
        },
        {
          "s": 24,
          "text": "בעשר"
        },
        {
          "s": 25,
          "text": "(עשר ספירות)"
        },
        {
          "s": 26,
          "text": "יהי' בעיקר במלכות,"
        },
        {
          "s": 27,
          "text": "כי שורש המלכות הוא בעתיק."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "וביאור הענין בפרטיות יותר,"
        },
        {
          "s": 2,
          "text": "יובן ע\"פ מ\"ש אדמו\"ר"
        },
        {
          "s": 3,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 4,
          "text": "נ\"ע במאמר ד\"ה זה25,"
        },
        {
          "s": 5,
          "text": "דאיתא בזהר26"
        },
        {
          "s": 6,
          "text": "שתפלה למשה היא תפלת עשיר27."
        },
        {
          "s": 7,
          "text": "דזהו החילוק בין תפלה לדוד28"
        },
        {
          "s": 8,
          "text": "לתפלה למשה,"
        },
        {
          "s": 9,
          "text": "דתפלה לדוד היא תפלת עני ותפלה למשה היא תפלת עשיר."
        },
        {
          "s": 10,
          "text": "ומדייק בהמאמר,"
        },
        {
          "s": 11,
          "text": "הרי ענין התפלה הוא שמתפלל להקב\"ה שימלא את מחסורו29,"
        },
        {
          "s": 12,
          "text": "וכיון שהעשיר אינו חסר שום דבר30,"
        },
        {
          "s": 13,
          "text": "מהו ענין תפלת עשיר."
        },
        {
          "s": 14,
          "text": "וביותר צריך ביאור ע\"פ מה שארז\"ל31"
        },
        {
          "s": 15,
          "text": "עה\"פ32"
        },
        {
          "s": 16,
          "text": "די מחסורו אשר יחסר לו,"
        },
        {
          "s": 17,
          "text": "די מחסורו ואי אתה מצווה לעשרו,"
        },
        {
          "s": 18,
          "text": "אשר יחסר לו אפילו סוס לרכוב עליו ועבד לרוץ לפניו."
        },
        {
          "s": 19,
          "text": "דמזה מובן שענין העשירות הוא לא רק שאינו חסר שום דבר"
        },
        {
          "s": 20,
          "text": "(אפילו סוס לרכוב עליו ועבד לרוץ לפניו)"
        },
        {
          "s": 21,
          "text": "אלא שהוא מושפע בריבוי השפע33."
        },
        {
          "s": 22,
          "text": "ועפ\"ז צריך להבין עוד יותר מהו ענין תפלת עשיר."
        },
        {
          "s": 23,
          "text": "ומבואר בכ\"מ34"
        },
        {
          "s": 24,
          "text": "וגם במאמר הנ\"ל35,"
        },
        {
          "s": 25,
          "text": "דתפלת עשיר היא לא בשביל עצמו."
        },
        {
          "s": 26,
          "text": "וכדאיתא במדרש36"
        },
        {
          "s": 27,
          "text": "עה\"פ תפלה למשה,"
        },
        {
          "s": 28,
          "text": "משל למה הדבר דומה לשלשה שבאו ליטול כו' מאת המלך כו',"
        },
        {
          "s": 29,
          "text": "בא השלישי,"
        },
        {
          "s": 30,
          "text": "אמר לו המלך מה אתה מבקש,"
        },
        {
          "s": 31,
          "text": "אמר לו,"
        },
        {
          "s": 32,
          "text": "איני מבקש על עצמי דבר,"
        },
        {
          "s": 33,
          "text": "אלא מדינה פלונית היא חרבה והיא שלך,"
        },
        {
          "s": 34,
          "text": "גזור שתיבנה כו',"
        },
        {
          "s": 35,
          "text": "כך משה לא ביקש לעצמו אלא בשביל ישראל."
        },
        {
          "s": 36,
          "text": "ולכאורה ביאור זה צריך לביאור נוסף."
        },
        {
          "s": 37,
          "text": "דכיון שתפלה היא עבודה שבלב37,"
        },
        {
          "s": 38,
          "text": "הרי מובן,"
        },
        {
          "s": 39,
          "text": "שגם כשמתפלל עבור אחרים התפלה שלו היא באופן שהחסרון שלהם נוגע ללבו"
        },
        {
          "s": 40,
          "text": "(של האדם המתפלל)"
        },
        {
          "s": 41,
          "text": "וכאילו שהוא עצמו הוא החסר"
        },
        {
          "s": 42,
          "text": "(וכל שהחסרון שלהם נוגע לו יותר,"
        },
        {
          "s": 43,
          "text": "תפלתו היא גדולה יותר),"
        },
        {
          "s": 44,
          "text": "הרי,"
        },
        {
          "s": 45,
          "text": "שגם התפלה עבור אחרים היא מצד זה שהוא חסר,"
        },
        {
          "s": 46,
          "text": "ולמה נק' בשם תפלת עשיר."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ונקודת הביאור בזה הוא,"
        },
        {
          "s": 1,
          "text": "דענין העשירות הוא לא רק שיש לו די צרכיו בהרחבה,"
        },
        {
          "s": 2,
          "text": "ועוד יותר מדי צרכיו,"
        },
        {
          "s": 3,
          "text": "אלא שהוא עשיר בעצם."
        },
        {
          "s": 4,
          "text": "והענין הוא,"
        },
        {
          "s": 5,
          "text": "דעשיר ועני הוא משפיע ומקבל38."
        },
        {
          "s": 6,
          "text": "דמזה מובן,"
        },
        {
          "s": 7,
          "text": "שגם כשיש לו שפע מרובה אבל השפע שיש לו הוא לא משל עצמו אלא שקיבל מאחרים,"
        },
        {
          "s": 8,
          "text": "הוא עני,"
        },
        {
          "s": 9,
          "text": "מקבל."
        },
        {
          "s": 10,
          "text": "וענין העשיר הוא,"
        },
        {
          "s": 11,
          "text": "שמצד עצמו יש לו הכל"
        },
        {
          "s": 12,
          "text": "[ויש לקשר זה עם מארז\"ל39"
        },
        {
          "s": 13,
          "text": "אין עני אלא בדעת ואין עשיר אלא בדעת,"
        },
        {
          "s": 14,
          "text": "כי דעת הוא הכרה והרגשה40,"
        },
        {
          "s": 15,
          "text": "ומהמעלות שבהכרה והרגשה על השכלה והשגה"
        },
        {
          "s": 16,
          "text": "(חכמה ובינה),"
        },
        {
          "s": 17,
          "text": "הוא,"
        },
        {
          "s": 18,
          "text": "דכשאדם משכיל ומבין איזה דבר אין זה שהוא בעצמו יודע את הדבר41"
        },
        {
          "s": 19,
          "text": "ורק שמקבל41"
        },
        {
          "s": 20,
          "text": "את הידיעה מהשכל שהשפיע לו ידיעה זו."
        },
        {
          "s": 21,
          "text": "וענין ההכרה וההרגשה הוא,"
        },
        {
          "s": 22,
          "text": "שהוא בעצמו מכיר ומרגיש את הדבר42."
        },
        {
          "s": 23,
          "text": "וזהו שענין העניות והעשירות הוא בעיקר בדעת,"
        },
        {
          "s": 24,
          "text": "דכיון שהידיעה שמצד ההשכלה וההבנה היא כמו ידיעה נקנית אבל הוא בעצמו אינו יודע,"
        },
        {
          "s": 25,
          "text": "לכן,"
        },
        {
          "s": 26,
          "text": "גם לאחרי שיש לו השכלה והבנה הוא נשאר עני"
        },
        {
          "s": 27,
          "text": "(חסר),"
        },
        {
          "s": 28,
          "text": "וע\"י הדעת דוקא הוא יוצא מעניותו ונעשה עשיר."
        },
        {
          "s": 29,
          "text": "והנה ידוע43"
        },
        {
          "s": 30,
          "text": "דענין התוקף הוא בדעת."
        },
        {
          "s": 31,
          "text": "דכשאדם מחליט לעשות איזה דבר מפני שמכיר ומרגיש שכן צריך לעשות,"
        },
        {
          "s": 32,
          "text": "ההחלטה היא בתוקף גדול הרבה יותר מההחלטה שמצד ההבנה וההשגה."
        },
        {
          "s": 33,
          "text": "והטעם על זה הוא,"
        },
        {
          "s": 34,
          "text": "דהשגה היא בדרך שקו\"ט,"
        },
        {
          "s": 35,
          "text": "שנותנת מקום להשגה אחרת."
        },
        {
          "s": 36,
          "text": "ולכן ההחלטה שמצד ההשגה אינה בתוקף כ\"כ44."
        },
        {
          "s": 37,
          "text": "וההכרה וההרגשה היא בעצם הסברא,"
        },
        {
          "s": 38,
          "text": "דבעצם הסברא אין נתינת מקום לסברא הפכית,"
        },
        {
          "s": 39,
          "text": "ולכן ההחלטה שמצד ההכרה אינה משתנית."
        },
        {
          "s": 40,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 41,
          "text": "דזה שהחו\"ב עצמם"
        },
        {
          "s": 42,
          "text": "(בלי דעת)"
        },
        {
          "s": 43,
          "text": "הם בחינת עניות,"
        },
        {
          "s": 44,
          "text": "הוא לא רק בנוגע להאדם"
        },
        {
          "s": 45,
          "text": "[כי הידיעה שמצד חו\"ב היא דבר נוסף על האדם והאדם עצמו הוא חסר הידיעה,"
        },
        {
          "s": 46,
          "text": "עני],"
        },
        {
          "s": 47,
          "text": "אלא גם בנוגע לההשכלה וההשגה עצמם,"
        },
        {
          "s": 48,
          "text": "כיון שבההשגה דחו\"ב יש נתינת מקום להשגה הפכית]."
        },
        {
          "s": 49,
          "text": "וכיון שהוא עשיר בעצם,"
        },
        {
          "s": 50,
          "text": "הרי מובן,"
        },
        {
          "s": 51,
          "text": "שאין שייך בו חסרון45."
        },
        {
          "s": 52,
          "text": "ולכן,"
        },
        {
          "s": 53,
          "text": "הגם שהחסרון של אלה שהתפלל עבורם נוגע לו ביותר,"
        },
        {
          "s": 54,
          "text": "והתפלה שמתפלל עבורם היא כאילו שהוא עצמו הי' החסר,"
        },
        {
          "s": 55,
          "text": "מ\"מ,"
        },
        {
          "s": 56,
          "text": "לא נעשה עי\"ז חסרון בו,"
        },
        {
          "s": 57,
          "text": "ותפלתו היא תפלת עשיר."
        }
      ]
    }
  ]
}