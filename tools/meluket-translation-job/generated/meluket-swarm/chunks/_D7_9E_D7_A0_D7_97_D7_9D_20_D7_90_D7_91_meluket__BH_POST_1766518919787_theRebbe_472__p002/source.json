{
  "globalIndex": 1013,
  "owner": 13,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919787_theRebbe_472__p002",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919787_theRebbe_472__p002",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919787_theRebbe_472",
  "title": "מאמר איכה ישבה בדד תשל\"א",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה גודל העילוי שיהי' לע\"ל יובן מגודל הפלאת העבודה שבזה\"ג שלפני זה – הכנה והקדמה לזה30."
        },
        {
          "s": 2,
          "text": "דהנה ידוע31"
        },
        {
          "s": 3,
          "text": "מאמר כ\"ק אדמו\"ר הזקן בשם הבעש\"ט עה\"פ32"
        },
        {
          "s": 4,
          "text": "כן בקודש חזיתיך הלואי בזמן הבית חזיתיך,"
        },
        {
          "s": 5,
          "text": "וכידוע33"
        },
        {
          "s": 6,
          "text": "בפי' והאיש משה עניו מאד מכל האדם אשר על פני האדמה34,"
        },
        {
          "s": 7,
          "text": "שביותר הוא כשראה משה את הדור דעקבתא דמשיחא,"
        },
        {
          "s": 8,
          "text": "שיהיו אז ריבוי העלמות והסתרים וכו' ובכל זה ילמדו תורה ויקיימו מצות ובאופן דמוסיף והולך מוסיף ואור,"
        },
        {
          "s": 9,
          "text": "הנה עבודה זו פעלה ענוה וביטול אצל משה."
        },
        {
          "s": 10,
          "text": "ומשה אמת35"
        },
        {
          "s": 11,
          "text": "וארז\"ל36"
        },
        {
          "s": 12,
          "text": "מדת אמת ראה,"
        },
        {
          "s": 13,
          "text": "הרי מובן מזה,"
        },
        {
          "s": 14,
          "text": "שכ\"ה באמת,"
        },
        {
          "s": 15,
          "text": "שישנה מעלה בהעבודה דזה\"ג37"
        },
        {
          "s": 16,
          "text": "לגבי עבודת משה."
        },
        {
          "s": 17,
          "text": "ומזה מובן גודל העילוי שיהי' לע\"ל,"
        },
        {
          "s": 18,
          "text": "מכיון שהגילוי יהי' לאחרי וע\"י עבודה נעלית כזו."
        },
        {
          "s": 19,
          "text": "ובזה יובן ג\"כ הטעם לאריכות הגלות הזה,"
        },
        {
          "s": 20,
          "text": "כי מכיון שגלות זה הוא הקדמה לגילוי נעלה ביותר,"
        },
        {
          "s": 21,
          "text": "שלמעלה יותר מויניחהו בג\"ע דאדה\"ר,"
        },
        {
          "s": 22,
          "text": "ממתן תורה,"
        },
        {
          "s": 23,
          "text": "מבית ראשון ומבית שני,"
        },
        {
          "s": 24,
          "text": "לכן הגלות הוא באריכות גדולה כזו,"
        },
        {
          "s": 25,
          "text": "בכדי שע\"י עבודת בנ\"י במשך זמן הגלות יגיעו בקרוב ממש לבית השלישי,"
        },
        {
          "s": 26,
          "text": "שהוא גילוי נעלה ביותר,"
        },
        {
          "s": 27,
          "text": "בטח בדד עין יעקב,"
        },
        {
          "s": 28,
          "text": "נחלה בלי מצרים."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה בכדי שבחינת בדד יומשך למטה ובאופן דישבה – התיישבות,"
        },
        {
          "s": 2,
          "text": "צריכה להיות ההמשכה בהמדריגות דסדר השתלשלות."
        },
        {
          "s": 3,
          "text": "וזהו מ\"ש איכה ישבה בדד,"
        },
        {
          "s": 4,
          "text": "שהמשכת בחי' בדד למטה,"
        },
        {
          "s": 5,
          "text": "ובאופן דישבה"
        },
        {
          "s": 6,
          "text": "(בהתיישבות),"
        },
        {
          "s": 7,
          "text": "הוא ע\"י איכה."
        },
        {
          "s": 8,
          "text": "דהנה א' רומזת לכמה דרגות זעג\"ז."
        },
        {
          "s": 9,
          "text": "וכמו א' דאחד – א' שלמעלה מח' וד',"
        },
        {
          "s": 10,
          "text": "ז\"ר וארץ וד' רוחות העולם – א' – אלופו של עולם,"
        },
        {
          "s": 11,
          "text": "אבל א' דאיכה,"
        },
        {
          "s": 12,
          "text": "א' למעלה מי' – למעלה מענין ע\"ס,"
        },
        {
          "s": 13,
          "text": "(וי\"ל למעלה גם מע\"ס הגנוזות38),"
        },
        {
          "s": 14,
          "text": "והאל\"ף,"
        },
        {
          "s": 15,
          "text": "נמשך בהיו\"ד"
        },
        {
          "s": 16,
          "text": "(שבאיכה)"
        },
        {
          "s": 17,
          "text": "הרומז לע\"ס דאצילות,"
        },
        {
          "s": 18,
          "text": "ואח\"כ – ב\"כה\""
        },
        {
          "s": 19,
          "text": "(דאיכה)"
        },
        {
          "s": 20,
          "text": "שקאי על בחי' המלכות ובפרט – מל' כמו ששייכת כבר או גם – כמו שירדה ומתלבשת בבי\"ע39."
        },
        {
          "s": 21,
          "text": "וכידוע40"
        },
        {
          "s": 22,
          "text": "ההפרש שבין זה לכה,"
        },
        {
          "s": 23,
          "text": "שזה הו\"ע מראה באצבעו ואומר זה,"
        },
        {
          "s": 24,
          "text": "ועד\"ז הוא גם לשון זאת"
        },
        {
          "s": 25,
          "text": "(שהיא ג\"כ ע\"ד בחי' זה,"
        },
        {
          "s": 26,
          "text": "אלא שזאת הוא בחי' נוקבא41),"
        },
        {
          "s": 27,
          "text": "שהוא בחי' המלכות כמו שהיא באצילות42,"
        },
        {
          "s": 28,
          "text": "ובחי' כה הוא בחי' המלכות ובפרט – כמו שהיא מתלבשת בבי\"ע,"
        },
        {
          "s": 29,
          "text": "בחי' כדמותנו."
        },
        {
          "s": 30,
          "text": "וזהו\"ע איכה ישבה בדד,"
        },
        {
          "s": 31,
          "text": "שבדד הוא בחי' יחיד שלמעלה גם מבחי' אחד,"
        },
        {
          "s": 32,
          "text": "כי האל\"ף דכאן"
        },
        {
          "s": 33,
          "text": "(דאיכה)"
        },
        {
          "s": 34,
          "text": "הוא – אחד ואין שני גם בן ואח אין לו43,"
        },
        {
          "s": 35,
          "text": "בחי' עתיק שאין בו התחלקות כלל,"
        },
        {
          "s": 36,
          "text": "וכידוע בקבלה44"
        },
        {
          "s": 37,
          "text": "שזווג"
        },
        {
          "s": 38,
          "text": "(מ\"ד ומ\"ן)"
        },
        {
          "s": 39,
          "text": "שבעתיק הוא מיני' ובי',"
        },
        {
          "s": 40,
          "text": "הנה לע\"ל יומשך גם בחי' בדד בגילוי למטה ובהתיישבות45."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה ידוע תורת הרב המגיד46"
        },
        {
          "s": 2,
          "text": "שבדד ב' דלתי\"ן."
        },
        {
          "s": 3,
          "text": "ד' דמשפיע וד' דמקבל."
        },
        {
          "s": 4,
          "text": "ולכאורה,"
        },
        {
          "s": 5,
          "text": "הרי דל\"ת הוא ענין דלות,"
        },
        {
          "s": 6,
          "text": "דלותי,"
        },
        {
          "s": 7,
          "text": "ואיך שייך דל\"ת דמשפיע."
        },
        {
          "s": 8,
          "text": "ומבואר שם שהוא כמרז\"ל47"
        },
        {
          "s": 9,
          "text": "יותר משהעגל רוצה לינק הפרה רוצה להניק,"
        },
        {
          "s": 10,
          "text": "והיינו שיש כוסף ותשוקה בהמשפיע להשפיע להמקבל,"
        },
        {
          "s": 11,
          "text": "וזהו דל\"ת דהמשפיע."
        },
        {
          "s": 12,
          "text": "ואולי יש לקשר זה עם משנ\"ת בענין למעשה ידיך תכסוף."
        },
        {
          "s": 13,
          "text": "והנה כמו שרצון"
        },
        {
          "s": 14,
          "text": "(הדל\"ת)"
        },
        {
          "s": 15,
          "text": "דהמשפיע הוא שיתמלא חסרון דהמקבל,"
        },
        {
          "s": 16,
          "text": "כן רצון"
        },
        {
          "s": 17,
          "text": "(דל\"ת)"
        },
        {
          "s": 18,
          "text": "המקבל צ\"ל שיתמלא החסרון,"
        },
        {
          "s": 19,
          "text": "כביכול,"
        },
        {
          "s": 20,
          "text": "דהמשפיע,"
        },
        {
          "s": 21,
          "text": "וכידוע בפירוש הרב המגיד במשנה אין עומדין להתפלל אלא מתוך כובד ראש48,"
        },
        {
          "s": 22,
          "text": "שהתפלה צריכה להיות על הכובד ראש שלמעלה,"
        },
        {
          "s": 23,
          "text": "ששכינה אומרת49"
        },
        {
          "s": 24,
          "text": "קלני מראשי קלני מזרועי."
        },
        {
          "s": 25,
          "text": "וכן משמע פירוש הבעש\"ט50"
        },
        {
          "s": 26,
          "text": "עה\"פ51"
        },
        {
          "s": 27,
          "text": "זאת אשיב אל לבי על כן אוחיל,"
        },
        {
          "s": 28,
          "text": "זאת – השכינה."
        }
      ]
    }
  ]
}