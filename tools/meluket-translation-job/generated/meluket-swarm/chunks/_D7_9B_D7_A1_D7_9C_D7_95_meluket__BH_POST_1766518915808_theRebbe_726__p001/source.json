{
  "globalIndex": 353,
  "owner": 3,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915808_theRebbe_726__p001",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915808_theRebbe_726__p001",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915808_theRebbe_726",
  "title": "מאמר פדה בשלום תשל\"ח",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "י\"ט כסלו ה'תשל\"ח*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "פדה בשלום נפשי מקרב לי כי ברבים היו עמדי1,"
        },
        {
          "s": 1,
          "text": "וידוע מ\"ש כ\"ק אדמו\"ר הזקן בעל הגאולה באגרת הקודש שלו2"
        },
        {
          "s": 2,
          "text": "(בנוגע להגאולה די\"ט כסלו),"
        },
        {
          "s": 3,
          "text": "כשקריתי בס' תהלים בפסוק פדה בשלום נפשי,"
        },
        {
          "s": 4,
          "text": "קודם שהתחלתי פסוק שלאחריו,"
        },
        {
          "s": 5,
          "text": "יצאתי בשלום מה' שלום,"
        },
        {
          "s": 6,
          "text": "שהגאולה שלו שייכת לענין פדה בשלום נפשי."
        },
        {
          "s": 7,
          "text": "ומזה מובן גם בנוגע להגאולה של בנו וממלא מקומו כ\"ק אדמו\"ר האמצעי"
        },
        {
          "s": 8,
          "text": "(ביו\"ד כסלו),"
        },
        {
          "s": 9,
          "text": "שהיא שייכת להענין דפדה בשלום נפשי3,"
        },
        {
          "s": 10,
          "text": "שהרי פסוק זה הוא בשיעור תהלים החדשי דיום העשירי לחודש4."
        },
        {
          "s": 11,
          "text": "[ויש לקשר זה גם עם אריכות הביאור וכו' בהדרוש ד\"ה פדה בשלום נפשי שלו5]."
        },
        {
          "s": 12,
          "text": "וגם הגאולה די\"ב וי\"ג תמוז של כ\"ק מו\"ח אדמו\"ר,"
        },
        {
          "s": 13,
          "text": "ממלא מקומם"
        },
        {
          "s": 14,
          "text": "(דאדמו\"ר הזקן ואדמו\"ר האמצעי),"
        },
        {
          "s": 15,
          "text": "שייכת לענין פדה בשלום נפשי6,"
        },
        {
          "s": 16,
          "text": "כדמוכח גם מזה שכמה ממאמרי י\"ב וי\"ג תמוז7"
        },
        {
          "s": 17,
          "text": "מתחילים בפסוק זה."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דענין זה"
        },
        {
          "s": 2,
          "text": "[השייכות דהגאולה לפדה בשלום נפשי]"
        },
        {
          "s": 3,
          "text": "שייך גם לזה שהגאולה די\"ט כסלו היתה ביום השלישי שהוכפל8"
        },
        {
          "s": 4,
          "text": "בו כי טוב9"
        },
        {
          "s": 5,
          "text": "ובחודש השלישי"
        },
        {
          "s": 6,
          "text": "(דחדשי החורף)10"
        },
        {
          "s": 7,
          "text": "[וגם הגאולה דיו\"ד כסלו ודי\"ב תמוז היו בשלישי,"
        },
        {
          "s": 8,
          "text": "הגאולה דיו\"ד כסלו – בחודש השלישי,"
        },
        {
          "s": 9,
          "text": "והגאולה די\"ב תמוז – ביום השלישי שהוכפל בו כי טוב],"
        },
        {
          "s": 10,
          "text": "כי עיקר החידוש בהכתוב פדה בשלום נפשי הוא"
        },
        {
          "s": 11,
          "text": "(לא כ\"כ ענין הפדי',"
        },
        {
          "s": 12,
          "text": "כ\"א)"
        },
        {
          "s": 13,
          "text": "שהפדי' היא בשלום11"
        },
        {
          "s": 14,
          "text": "ושלישי12"
        },
        {
          "s": 15,
          "text": "הו\"ע השלום13."
        }
      ]
    }
  ]
}