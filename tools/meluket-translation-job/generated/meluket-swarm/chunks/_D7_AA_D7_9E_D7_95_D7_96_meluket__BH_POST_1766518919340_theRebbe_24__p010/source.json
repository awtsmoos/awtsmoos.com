  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919340_theRebbe_24__p010",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919340_theRebbe_24",
  "title": "מאמר עשרה שיושבין תשמ\"ב",
  "part": 10,
  "sections": [
    {
      "v": 27,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ב)"
        },
        {
          "s": 2,
          "text": "ויש להוסיף,"
        },
        {
          "s": 3,
          "text": "דע\"י המאמר עשרה שיושבין ועוסקין בתורה שניתן מבעל הגאולה ללמדו בחג הגאולה,"
        },
        {
          "s": 4,
          "text": "עשה את כל אחד לשלוחו של בעל הגאולה לעסוק בענין זה,"
        },
        {
          "s": 5,
          "text": "ונתן לו נתינת כח מיוחדת להצליח בזה,"
        },
        {
          "s": 6,
          "text": "הצלחה בהתייסדות שיעורים ברבים,"
        },
        {
          "s": 7,
          "text": "והצלחה בכל הענינים"
        },
        {
          "s": 8,
          "text": "(המבוארים בהמאמר)"
        },
        {
          "s": 9,
          "text": "הנמשכים ע\"י עסק התורה דרבים."
        }
      ]
    },
    {
      "v": 28,
      "items": [
        {
          "s": 0,
          "text": "וכל זה באופן דברכת כהנים,"
        },
        {
          "s": 1,
          "text": "שהמשכת הברכה היא באופן דמהירות,"
        },
        {
          "s": 2,
          "text": "כמבואר בלקו\"ת ד\"ה והנה פרח מטה אהרן גו' ויגמול שקדים74,"
        },
        {
          "s": 3,
          "text": "ועל ידי השקדים הטובים דמטה אהרן יהפכו השקדים המרים75"
        },
        {
          "s": 4,
          "text": "דג' השבועות76"
        },
        {
          "s": 5,
          "text": "לששון ולשמחה,"
        },
        {
          "s": 6,
          "text": "בגאולה האמיתית והשלימה ע\"י משיח צדקנו,"
        },
        {
          "s": 7,
          "text": "במהרה בימינו ממש."
        }
      ]
    }
  ]
}