{
  "globalIndex": 1098,
  "owner": 48,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920368_theRebbe_469__p006",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920368_theRebbe_469__p006",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920368_theRebbe_469",
  "title": "מאמר השקיפה ממעון קדשך תשכ\"ז",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "וזהו הנותן שלג כצמר,"
        },
        {
          "s": 3,
          "text": "כי בכ\"א מהם יש יתרון."
        },
        {
          "s": 4,
          "text": "היתרון דשלג הוא שתיקון ומילוי הפגמים שע\"י י\"ג תיקוני דיקנא"
        },
        {
          "s": 5,
          "text": "(שלג)"
        },
        {
          "s": 6,
          "text": "היא בפנימיות"
        },
        {
          "s": 7,
          "text": "(בהציור דכחות הגלויים),"
        },
        {
          "s": 8,
          "text": "אבל הוא במדידה והגבלה,"
        },
        {
          "s": 9,
          "text": "דכיון שהוא בדרך פעולה"
        },
        {
          "s": 10,
          "text": "[שהעצם השייך לכחות הגלויים פועל בהם]"
        },
        {
          "s": 11,
          "text": "יש בזה כמה חילוקי דרגות."
        },
        {
          "s": 12,
          "text": "והיתרון דצמר הוא,"
        },
        {
          "s": 13,
          "text": "דתיקון הפגמים שע\"י שער רישי' הוא שמתגלה בהם שבפנימיות"
        },
        {
          "s": 14,
          "text": "(מצד העצם שלהם)"
        },
        {
          "s": 15,
          "text": "אין שייך כלל שיהי' בהם פגם."
        },
        {
          "s": 16,
          "text": "וענין הנותן שלג כצמר,"
        },
        {
          "s": 17,
          "text": "שגם בשלג יומשך בחינת צמר,"
        },
        {
          "s": 18,
          "text": "הוא – שיהיו שתי המעלות."
        },
        {
          "s": 19,
          "text": "היינו,"
        },
        {
          "s": 20,
          "text": "דזה שמצד העצם אין שייך בהם פגם,"
        },
        {
          "s": 21,
          "text": "יפעול גם בהציור שלהם."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "ובכדי שיהי' החיבור דצמר ושלג הוא ע\"י המשכה ממקום הגבוה משניהם"
        },
        {
          "s": 1,
          "text": "[כמובא לעיל"
        },
        {
          "s": 2,
          "text": "(סעיף ח)"
        },
        {
          "s": 3,
          "text": "מהמאמר]."
        },
        {
          "s": 4,
          "text": "וי\"ל הביאור בזה,"
        },
        {
          "s": 5,
          "text": "דזה שעצם הנשמה והציור דכחות הם"
        },
        {
          "s": 6,
          "text": "(דוגמת)"
        },
        {
          "s": 7,
          "text": "שני ענינים,"
        },
        {
          "s": 8,
          "text": "הוא לפי שגם עצם הנשמה היא מוגדרת בגדר,"
        },
        {
          "s": 9,
          "text": "והגדר שלה הוא למעלה מציור דכחות."
        },
        {
          "s": 10,
          "text": "אבל מצד עצם הנשמה כמו שהיא מושרשת בהעצמות,"
        },
        {
          "s": 11,
          "text": "הפשיטות דהנשמה והציור דשכל ומדות שבה הם כולא חד65."
        },
        {
          "s": 12,
          "text": "וע\"י גילוי בחינה זו דהנשמה,"
        },
        {
          "s": 13,
          "text": "גם הכחות דהנשמה"
        },
        {
          "s": 14,
          "text": "(הציור דהכחות)"
        },
        {
          "s": 15,
          "text": "הם באופן שאין שייך שיהיו שלא כפי הכוונה."
        },
        {
          "s": 16,
          "text": "וע\"י ההמשכה דעצם הנשמה"
        },
        {
          "s": 17,
          "text": "(צמר)"
        },
        {
          "s": 18,
          "text": "בכחות הפרטיים"
        },
        {
          "s": 19,
          "text": "(שלג)"
        },
        {
          "s": 20,
          "text": "נעשה עילוי גם בעצם הנשמה,"
        },
        {
          "s": 21,
          "text": "כי עי\"ז מתגלה בה שרשה כמו שהיא מושרשת בהעצמות."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש לבאר השייכות דענין הנותן שלג כצמר לענין כי חזק בריחי שעריך,"
        },
        {
          "s": 1,
          "text": "דצמר ושלג הם דוגמת מקיף ופנימי."
        },
        {
          "s": 2,
          "text": "וע\"י החיבור דצמר ושלג,"
        },
        {
          "s": 3,
          "text": "דעצם הנשמה שלמעלה מכחות הגלויים"
        },
        {
          "s": 4,
          "text": "(צמר,"
        },
        {
          "s": 5,
          "text": "מקיף)"
        },
        {
          "s": 6,
          "text": "נמשכת בכחות הגלויים"
        },
        {
          "s": 7,
          "text": "(שלג,"
        },
        {
          "s": 8,
          "text": "פנימי),"
        },
        {
          "s": 9,
          "text": "עי\"ז נעשה עד\"ז בהגילויים דלמעלה,"
        },
        {
          "s": 10,
          "text": "שגם המקיפים נמשכים בפנימיות."
        }
      ]
    }
  ]
}