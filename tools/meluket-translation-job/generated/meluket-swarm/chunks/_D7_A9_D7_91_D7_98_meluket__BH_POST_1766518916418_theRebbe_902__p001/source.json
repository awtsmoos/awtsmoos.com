  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916418_theRebbe_902",
  "title": "מאמר לה\"ע כתיבת ספר תורה תש\"ל",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "יום ו' ערב שבת קודש פ' בא,"
        },
        {
          "s": 2,
          "text": "יו\"ד שבט,"
        },
        {
          "s": 3,
          "text": "אחרי חצות,"
        },
        {
          "s": 4,
          "text": "תש\"ל"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "– סיום כתיבת ספר תורה לקבלת פני משיח צדקנו –"
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "– שעורר בזה והותחל בכתיבתה – בפני כ\"ק מו\"ח אדמו\"ר נשיא דורנו –"
        }
      ]
    }
  ]
}