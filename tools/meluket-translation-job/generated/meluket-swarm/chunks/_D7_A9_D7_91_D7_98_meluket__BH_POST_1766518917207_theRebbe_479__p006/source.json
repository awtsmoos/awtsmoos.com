{
  "globalIndex": 605,
  "owner": 5,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917207_theRebbe_479__p006",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917207_theRebbe_479__p006",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518917207_theRebbe_479",
  "title": "מאמר ואלה המשפטים תשמ\"א",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "והנה ידוע70"
        },
        {
          "s": 1,
          "text": "שההמשכה שעל ידי העבודה דאתכפיא היא המשכה נעלית יותר מההמשכה שעל ידי העבודה דאתהפכא."
        },
        {
          "s": 2,
          "text": "כמאמר71"
        },
        {
          "s": 3,
          "text": "כד אתכפיא סט\"א אסתלק יקרא דקוב\"ה בכולהו עלמין,"
        },
        {
          "s": 4,
          "text": "שע\"י העבודה דאתכפיא הוא המשכת האור שבבחינת רוממות,"
        },
        {
          "s": 5,
          "text": "אסתלק."
        },
        {
          "s": 6,
          "text": "ויש לומר,"
        },
        {
          "s": 7,
          "text": "דההמשכה שע\"י אתכפיא דצדיקים"
        },
        {
          "s": 8,
          "text": "(שהאתכפיא גופא היא התענוג שלהם),"
        },
        {
          "s": 9,
          "text": "היא המשכה נעלית עוד יותר."
        },
        {
          "s": 10,
          "text": "והענין הוא,"
        },
        {
          "s": 11,
          "text": "דמהטעמים על זה שהמשכה זו היא ע\"י אתכפיא דוקא,"
        },
        {
          "s": 12,
          "text": "הוא72,"
        },
        {
          "s": 13,
          "text": "דע\"י שהאדם כופה את עצמו לעשות כנגד רצונו וטבעו,"
        },
        {
          "s": 14,
          "text": "המשכת הגילויים דלמעלה היא לא כפי הטבע שלהם."
        },
        {
          "s": 15,
          "text": "שגם האור שבבחינת רוממות,"
        },
        {
          "s": 16,
          "text": "שמצד \"טבעו\" הוא למעלה מגילוי,"
        },
        {
          "s": 17,
          "text": "נמשך בגילוי."
        },
        {
          "s": 18,
          "text": "ויש לומר דכאשר האתכפיא דהאדם היא בדרך הכרח,"
        },
        {
          "s": 19,
          "text": "היפך התענוג שלו,"
        },
        {
          "s": 20,
          "text": "זה שנמשך בגילוי האור שלמעלה מגילוי"
        },
        {
          "s": 21,
          "text": "(היפך הטבע שלו),"
        },
        {
          "s": 22,
          "text": "הוא כמו בדרך הכרח כביכול73,"
        },
        {
          "s": 23,
          "text": "היינו שההמשכה היא מבחינת חיצוניות הרצון,"
        },
        {
          "s": 24,
          "text": "וע\"י שהאתכפיא דהאדם הוא באופן שזהו התענוג שלו,"
        },
        {
          "s": 25,
          "text": "ההמשכה היא מבחינת פנימיות הרצון והתענוג."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "וזהו ואלה המשפטים אשר תשים לפניהם וארז\"ל ואלה מוסיף על הראשונים,"
        },
        {
          "s": 3,
          "text": "דירידת והמשכת התורה במשפטים שהם מובנים גם בשכל האדם,"
        },
        {
          "s": 4,
          "text": "ובפרט שעי\"ז ניתן הכח לאדם שיוכל ללמוד תורה באופן דאשר תשים לפניהם"
        },
        {
          "s": 5,
          "text": "(בהבנה והסברה ועד שהתורה נקראת על שמו),"
        },
        {
          "s": 6,
          "text": "היא הוספה על הראשונים,"
        },
        {
          "s": 7,
          "text": "כי ע\"י ירידה זו מתגלה שורש התורה באוא\"ס הבל\"ג"
        },
        {
          "s": 8,
          "text": "(כנ\"ל סעיף ג)."
        },
        {
          "s": 9,
          "text": "ולהוסיף,"
        },
        {
          "s": 10,
          "text": "דע\"י לימוד התורה דהאדם באופן שהתורה נקראת על שמו,"
        },
        {
          "s": 11,
          "text": "מיתוסף בהתורה עוד יותר."
        },
        {
          "s": 12,
          "text": "כי בירידת והמשכת התורה במשפטים,"
        },
        {
          "s": 13,
          "text": "מה שנמשך בגילוי למטה הוא חכמתו של הקב\"ה"
        },
        {
          "s": 14,
          "text": "(חכמה דאצילות),"
        },
        {
          "s": 15,
          "text": "אלא שהחיבור דחכמתו של הקב\"ה שלמעלה משכל הנבראים עם שכל האדם הוא ע\"י ההמשכה מאוא\"ס הבל\"ג שלמעלה מחכמה"
        },
        {
          "s": 16,
          "text": "[היינו שהגילוי דאוא\"ס הבל\"ג הוא רק נתינת כח לבחי' החכמה דאצילות שתתחבר עם שכל האדם,"
        },
        {
          "s": 17,
          "text": "ולא שמתגלה אוא\"ס הבל\"ג עצמו],"
        },
        {
          "s": 18,
          "text": "וע\"י עסק התורה דהאדם באופן שהתורה היא תורתו,"
        },
        {
          "s": 19,
          "text": "נמשך בתורה הגילוי דאוא\"ס הבל\"ג עצמו."
        },
        {
          "s": 20,
          "text": "וכמבואר בהדרושים74"
        },
        {
          "s": 21,
          "text": "דזה שהתורה נקראת תורתו"
        },
        {
          "s": 22,
          "text": "(דהאדם),"
        },
        {
          "s": 23,
          "text": "הוא לפי שע\"י עסק התורה לשמה"
        },
        {
          "s": 24,
          "text": "(לשם התורה)"
        },
        {
          "s": 25,
          "text": "הוא ממשיך בה הגילוי דאוא\"ס הבל\"ג,"
        },
        {
          "s": 26,
          "text": "ולכן נקראת התורה על שמו,"
        },
        {
          "s": 27,
          "text": "לפי שהוא המשיך בה גילוי זה."
        },
        {
          "s": 28,
          "text": "ויש לומר,"
        },
        {
          "s": 29,
          "text": "דזהו שואלה הוא וא\"ו אלה,"
        },
        {
          "s": 30,
          "text": "וא\"ו המוסיף הוא ההוספה שנעשית בתורה,"
        },
        {
          "s": 31,
          "text": "אלה הוא לשון גילוי,"
        },
        {
          "s": 32,
          "text": "ופירוש ואלה"
        },
        {
          "s": 33,
          "text": "(וא\"ו אלה)"
        },
        {
          "s": 34,
          "text": "הוא,"
        },
        {
          "s": 35,
          "text": "שההוספה בתורה"
        },
        {
          "s": 36,
          "text": "(שנמשך בה אוא\"ס הבל\"ג)"
        },
        {
          "s": 37,
          "text": "היא בגילוי."
        },
        {
          "s": 38,
          "text": "היינו,"
        },
        {
          "s": 39,
          "text": "דזה שנמשך בה אוא\"ס הבל\"ג הוא לא רק באופן דנתינת כח אלא שהאור עצמו מאיר בגילוי."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ב)"
        },
        {
          "s": 2,
          "text": "וממשיך בכתוב אשר תשים לפניהם,"
        },
        {
          "s": 3,
          "text": "ויש לומר,"
        },
        {
          "s": 4,
          "text": "שאשר הוא"
        },
        {
          "s": 5,
          "text": "(גם)"
        },
        {
          "s": 6,
          "text": "מלשון אושר ותענוג."
        },
        {
          "s": 7,
          "text": "היינו,"
        },
        {
          "s": 8,
          "text": "שהענין דואלה"
        },
        {
          "s": 9,
          "text": "(וא\"ו אלה),"
        },
        {
          "s": 10,
          "text": "ההוספה שנמשכת בתורה בבחינת גילוי מעצמות אוא\"ס,"
        },
        {
          "s": 11,
          "text": "היא מבחינת התענוג."
        },
        {
          "s": 12,
          "text": "דזה שלימוד התורה שלו הוא באופן דעול תורה,"
        },
        {
          "s": 13,
          "text": "ביטול דעבד"
        },
        {
          "s": 14,
          "text": "(כנ\"ל סעיף ו-ז),"
        },
        {
          "s": 15,
          "text": "הוא דוגמת הענין דאתכפיא,"
        },
        {
          "s": 16,
          "text": "וזה שהביטול שלו הוא באופן"
        },
        {
          "s": 17,
          "text": "(שהביטול אינו שולל את מציאותו אלא אדרבה)"
        },
        {
          "s": 18,
          "text": "שמצד הביטול גופא הוא מרגיש שהתורה היא תורתו"
        },
        {
          "s": 19,
          "text": "(כנ\"ל סעיף ז)"
        },
        {
          "s": 20,
          "text": "הוא ע\"ד האתכפיא דצדיקים שהאתכפיא עצמה היא התענוג שלהם,"
        },
        {
          "s": 21,
          "text": "ולכן,"
        },
        {
          "s": 22,
          "text": "ההמשכה שעי\"ז היא מבחינת אשר,"
        },
        {
          "s": 23,
          "text": "תענוג."
        }
      ]
    }
  ]
}