{
  "globalIndex": 56,
  "owner": 6,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914005_theRebbe_415__p003",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914005_theRebbe_415__p003",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914005_theRebbe_415",
  "title": "מאמר שובה ישראל תשל\"ו",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "וממשיך בכתוב קחו עמכם דברים גו',"
        },
        {
          "s": 1,
          "text": "כי בכדי לתקן כדבעי את המכשול"
        },
        {
          "s": 2,
          "text": "(מה שנתקל ברגלו)"
        },
        {
          "s": 3,
          "text": "אינו מספיק ענין התשובה דביטול המציאות שנעשה עי\"ז – שזה פועל ע\"י וידוי דברים,"
        },
        {
          "s": 4,
          "text": "ענין האותיות כמבואר בסהמ\"צ להצ\"צ34,"
        },
        {
          "s": 5,
          "text": "כי תכלית התשובה הוא העבודה דתומ\"צ"
        },
        {
          "s": 6,
          "text": "(וכנ\"ל בענין תשובה ומעשים טובים),"
        },
        {
          "s": 7,
          "text": "ולזה מוסיף קחו עמכם דברים דתומ\"צ כמבואר בלקו\"ת עה\"פ35."
        },
        {
          "s": 8,
          "text": "ודברים אלו הם במדידה דוקא."
        },
        {
          "s": 9,
          "text": "דלא מיבעי בתושבע\"פ דמכיון שלימוד תושבע\"פ צ\"ל בהבנה והשגה דוקא36"
        },
        {
          "s": 10,
          "text": "הרי מוכרח שיהי' במדידה,"
        },
        {
          "s": 11,
          "text": "אלא גם תושב\"כ הגם שבתושב\"כ אינו נוגע כ\"כ ענין ההשגה36,"
        },
        {
          "s": 12,
          "text": "מ\"מ גם בתושב\"כ צריך להיות מדידה,"
        },
        {
          "s": 13,
          "text": "ואדרבה,"
        },
        {
          "s": 14,
          "text": "המדידה דתושב\"כ היא יותר מהמדידה דתושבע\"פ,"
        },
        {
          "s": 15,
          "text": "שהרי בתושב\"כ האותיות והתגין והטעמים צ\"ל בתכלית הדיוק."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "וממשיך בכתוב אמרו אליו כל תשא עון."
        },
        {
          "s": 1,
          "text": "והענין הוא,"
        },
        {
          "s": 2,
          "text": "כי תכלית ענין התשובה הוא לא רק שימחלו העונות אלא שהזדונות גופא יהפכו לזכיות,"
        },
        {
          "s": 3,
          "text": "וזהו מה שגם לאחרי שובה ישראל צ\"ל אמרו אליו כל תשא עון,"
        },
        {
          "s": 4,
          "text": "תשא עון הו\"ע נושא עון37,"
        },
        {
          "s": 5,
          "text": "דלא רק שהוא יכבוש עונותינו ותשליך במצולות ים כל חטאתם38,"
        },
        {
          "s": 6,
          "text": "אלא שהוא גם נושא עון,"
        },
        {
          "s": 7,
          "text": "שנושא ומגבי' את העון,"
        },
        {
          "s": 8,
          "text": "שהעונות נעשים לזכיות כמבואר בארוכה באוה\"ת39."
        },
        {
          "s": 9,
          "text": "וענין זה"
        },
        {
          "s": 10,
          "text": "(תשא עון)"
        },
        {
          "s": 11,
          "text": "נעשה ע\"י אמרו אליו כל,"
        },
        {
          "s": 12,
          "text": "כל הוא מה שהוא ית' הוא כל וכולל את הכל,"
        },
        {
          "s": 13,
          "text": "ולכן תשא עון,"
        },
        {
          "s": 14,
          "text": "שנושא גם את העון ומהפכו לזכיות."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "וממשיך בכתוב ונשלמה פרים שפתינו,"
        },
        {
          "s": 1,
          "text": "היינו שע\"י שלימות התשובה דשובה ישראל וגו' פועלים שלימות בענין הקרבנות שלאחרי כשלת בעונך,"
        },
        {
          "s": 2,
          "text": "דפירוש ונשלמה פרים שפתינו הוא לא רק ששפתינו הוא תשלומין לפרים כ\"א ששפתינו פועל שלימות בה\"פרים\","
        },
        {
          "s": 3,
          "text": "דשפתינו הו\"ע התפלה,"
        },
        {
          "s": 4,
          "text": "ענין הקרבנות ברוחניות,"
        },
        {
          "s": 5,
          "text": "שהוא למעלה מענין הקרבנת בגשמיות40,"
        },
        {
          "s": 6,
          "text": "וע\"ד שגם בזמן הבית שהי' אז הקרבת הקרבנות כפשוטה הנה גם אז הוצרך להיות הענין דישראל במעמדם לויים בדוכנם וכהנים בעבודתם ובפרט עבודת הכהנים ה\"ה \"בחשאי וברעותא דלבא\"41."
        },
        {
          "s": 7,
          "text": "וזהו מ\"ש ונשלמה פרים שפתינו לאחרי שובה ישראל וגו',"
        },
        {
          "s": 8,
          "text": "כי ענין זה"
        },
        {
          "s": 9,
          "text": "(ונשלמה פרים שפתינו)"
        },
        {
          "s": 10,
          "text": "הוא העילוי שנעשה ע\"י התשובה,"
        },
        {
          "s": 11,
          "text": "מה שמגיע בעילוי אחר עילוי,"
        },
        {
          "s": 12,
          "text": "למעלה גם מענין הקרבנות,"
        },
        {
          "s": 13,
          "text": "עד שמגיע לבחינת פני הוי'."
        },
        {
          "s": 14,
          "text": "וכמ\"ש42"
        },
        {
          "s": 15,
          "text": "בקשו פני את פניך הוי' אבקש,"
        },
        {
          "s": 16,
          "text": "שע\"י בקשו פני הו\"ע התשובה,"
        },
        {
          "s": 17,
          "text": "עי\"ז את פניך הוי' אבקש."
        },
        {
          "s": 18,
          "text": "דבאופן דהמשכה מלמעלה למטה כתיב43"
        },
        {
          "s": 19,
          "text": "וראית את אחורי ופני לא יראו,"
        },
        {
          "s": 20,
          "text": "משא\"כ באופן דהעלאה,"
        },
        {
          "s": 21,
          "text": "מגיעים לבחינת פניך הוי'44."
        }
      ]
    }
  ]
}