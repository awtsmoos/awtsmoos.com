{
  "globalIndex": 1107,
  "owner": 7,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920412_theRebbe_962__p002",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920412_theRebbe_962__p002",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920412_theRebbe_962",
  "title": "מאמר קומי אורי תשל\"ג",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה בכדי לבאר העילוי דאורך,"
        },
        {
          "s": 2,
          "text": "שעי\"ז יובן גודל מעלת האור שנראה ע\"י אורך"
        },
        {
          "s": 3,
          "text": "(שהוא למעלה גם מאורך),"
        },
        {
          "s": 4,
          "text": "יובן זה בהקדים הביאור דבחי' מקור חיים,"
        },
        {
          "s": 5,
          "text": "שיש בזה שני פירושים."
        },
        {
          "s": 6,
          "text": "דזה שנק' בשם מקור חיים הוא,"
        },
        {
          "s": 7,
          "text": "כי גם אור הסובב,"
        },
        {
          "s": 8,
          "text": "להיותו הארה בלבד,"
        },
        {
          "s": 9,
          "text": "הוא מקור"
        },
        {
          "s": 10,
          "text": "(עכ\"פ)"
        },
        {
          "s": 11,
          "text": "(לאור הממלא ועי\"ז,"
        },
        {
          "s": 12,
          "text": "גם)"
        },
        {
          "s": 13,
          "text": "להחיות המתלבש בעולמות7."
        },
        {
          "s": 14,
          "text": "ושמקור חיים קאי על האור שלמעלה מבחי' מקור להחיות דממכ\"ע,"
        },
        {
          "s": 15,
          "text": "וזה שנק' בשם מקור חיים הוא כי ממנו נמצא החיות"
        },
        {
          "s": 16,
          "text": "[וע\"ד מ\"ש בלקו\"ת8"
        },
        {
          "s": 17,
          "text": "בענין מה שהקב\"ה נקרא צור חיינו,"
        },
        {
          "s": 18,
          "text": "דפירוש צור הוא מקור ושרש כל שרשי ההתהוות9,"
        },
        {
          "s": 19,
          "text": "דאין הכוונה בזה שהוא מקור ח\"ו לההתהוות,"
        },
        {
          "s": 20,
          "text": "אלא שכל שרשי ההתהוות נמצאו ממנו10]."
        },
        {
          "s": 21,
          "text": "וזהו מ\"ש כי עמך מקור חיים,"
        },
        {
          "s": 22,
          "text": "דבתיבת עמך שני פירושים11."
        },
        {
          "s": 23,
          "text": "שההדגשה בעמך היא שהוא רק עמך ולא אתה,"
        },
        {
          "s": 24,
          "text": "דבר הטפל ובטל לך."
        },
        {
          "s": 25,
          "text": "ושההדגשה בעמך היא שאינו ענין לעצמו אלא עמך,"
        },
        {
          "s": 26,
          "text": "מיוחד עמו ית'."
        },
        {
          "s": 27,
          "text": "וע\"ד מ\"ש במדרש12"
        },
        {
          "s": 28,
          "text": "עה\"פ13"
        },
        {
          "s": 29,
          "text": "אם כסף תלוה את עמי,"
        },
        {
          "s": 30,
          "text": "אם כסף תלוה כו' את עמי,"
        },
        {
          "s": 31,
          "text": "מה אני כו' אף אתה כו'."
        },
        {
          "s": 32,
          "text": "ויש לומר,"
        },
        {
          "s": 33,
          "text": "דשני פירושים אלו הם בהתאם לשני הפירושים"
        },
        {
          "s": 34,
          "text": "(דלעיל)"
        },
        {
          "s": 35,
          "text": "במקור חיים."
        },
        {
          "s": 36,
          "text": "דלהפירוש שמקור חיים הוא בחי' מקור לחיים,"
        },
        {
          "s": 37,
          "text": "הפירוש דכי עמך מקור חיים הוא שענין מקור חיים הוא רק עמך ולא אתה,"
        },
        {
          "s": 38,
          "text": "טפל ובטל לך."
        },
        {
          "s": 39,
          "text": "ולהפירוש שמקור חיים הוא שהחיים נמצאים ממנו"
        },
        {
          "s": 40,
          "text": "(אבל לא שהוא בחי' מקור),"
        },
        {
          "s": 41,
          "text": "פירוש כי עמך מקור חיים הוא שהמשכת החיים היא רק מעמך,"
        },
        {
          "s": 42,
          "text": "מבחינת האור שמיוחד עמו ית'14."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה גם להפירוש שהכוונה במקור חיים היא שממנו נמצאו החיים"
        },
        {
          "s": 2,
          "text": "(ולא שהוא בבחי' מקור להם),"
        },
        {
          "s": 3,
          "text": "מ\"מ,"
        },
        {
          "s": 4,
          "text": "מזה שנקרא בשם מקור חיים"
        },
        {
          "s": 5,
          "text": "(חיות העולמות),"
        },
        {
          "s": 6,
          "text": "מוכח שיש לו שייכות לעולמות."
        },
        {
          "s": 7,
          "text": "וזהו מה שלאחרי שאומר כי עמך מקור חיים מוסיף באורך גו'"
        },
        {
          "s": 8,
          "text": "(שסדר הענינים שבהפסוק הוא מלמטה למעלה,"
        },
        {
          "s": 9,
          "text": "כנ\"ל),"
        },
        {
          "s": 10,
          "text": "דאורך הוא למעלה משייכות לעולמות."
        },
        {
          "s": 11,
          "text": "ולכן נקרא בשם אור"
        },
        {
          "s": 12,
          "text": "(אורך),"
        },
        {
          "s": 13,
          "text": "דענין האור הוא שהוא דבוק בהמאור ומעין המאור15."
        },
        {
          "s": 14,
          "text": "היינו,"
        },
        {
          "s": 15,
          "text": "שאינו בבחי' מציאות,"
        },
        {
          "s": 16,
          "text": "ובמילא אין שייך שיהי' מקור לאיזה דבר,"
        },
        {
          "s": 17,
          "text": "וכל ענינו הוא שהוא גילוי המאור."
        },
        {
          "s": 18,
          "text": "ומדייק באורך,"
        },
        {
          "s": 19,
          "text": "דנוסף על זה שאור בכלל"
        },
        {
          "s": 20,
          "text": "(גם כמו שהוא מתפשט מחוץ להמאור)"
        },
        {
          "s": 21,
          "text": "כל ענינו הוא התפשטות וגילוי המאור כנ\"ל,"
        },
        {
          "s": 22,
          "text": "הנה באור גופא הוא אורך,"
        },
        {
          "s": 23,
          "text": "אור שלך,"
        },
        {
          "s": 24,
          "text": "אור הכלול בעצמותו."
        },
        {
          "s": 25,
          "text": "דבכללות הוא אוא\"ס שלפני הצמצום"
        },
        {
          "s": 26,
          "text": "(כמבואר בכ\"מ16"
        },
        {
          "s": 27,
          "text": "דכללות האור שלפני הצמצום הוא אור הכלול בעצמותו)."
        },
        {
          "s": 28,
          "text": "דאור זה הוא למעלה משייכות לעולמות,"
        },
        {
          "s": 29,
          "text": "ולכן,"
        },
        {
          "s": 30,
          "text": "בכדי שתהי' התהוות העולמות צ\"ל סילוק האור17."
        },
        {
          "s": 31,
          "text": "ועל זה ארז\"ל18"
        },
        {
          "s": 32,
          "text": "עד שלא נברא העולם הי' הוא ושמו בלבד,"
        },
        {
          "s": 33,
          "text": "דהאור שלפני הצמצום"
        },
        {
          "s": 34,
          "text": "(דהתחלת הבריאה היא הצמצום,"
        },
        {
          "s": 35,
          "text": "ועד שלא נברא העולם הוא לפני הצמצום19)"
        },
        {
          "s": 36,
          "text": "נקרא שמו,"
        },
        {
          "s": 37,
          "text": "דכמו ששמו של האדם אינו מציאות כלל"
        },
        {
          "s": 38,
          "text": "(גם לא כהמציאות דאור)"
        },
        {
          "s": 39,
          "text": "וכל ענינו הוא מה שהאדם פונה להקוראים אותו בשמו20,"
        },
        {
          "s": 40,
          "text": "עד\"ז הוא בהאור שלפני הצמצום,"
        },
        {
          "s": 41,
          "text": "שאינו בבחי' מציאות וכל ענינו הוא רק שהוא שמו,"
        },
        {
          "s": 42,
          "text": "הוא ושמו בלבד21."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה ידוע22"
        },
        {
          "s": 2,
          "text": "דבאוא\"ס שלפני הצמצום יש"
        },
        {
          "s": 3,
          "text": "(בכללות)"
        },
        {
          "s": 4,
          "text": "ב' מדריגות."
        },
        {
          "s": 5,
          "text": "עצם האור והתפשטות האור."
        },
        {
          "s": 6,
          "text": "ובהתפשטות האור גופא ישנן ב' מדריגות בכללות."
        },
        {
          "s": 7,
          "text": "גילוי לעצמו,"
        },
        {
          "s": 8,
          "text": "והוא השרש דאור הסובב23."
        },
        {
          "s": 9,
          "text": "והגילוי השייך לעולמות"
        },
        {
          "s": 10,
          "text": "(דעם היות שכללות האור שלפני הצמצום הוא כלול בעצמותו כנ\"ל,"
        },
        {
          "s": 11,
          "text": "הנה בעצמותו גופא הוא גילוי השייך לעולמות),"
        },
        {
          "s": 12,
          "text": "והוא השרש דאור הממלא23."
        },
        {
          "s": 13,
          "text": "וע\"פ הידוע,"
        },
        {
          "s": 14,
          "text": "דהמשכת האור למעלה אינה בדרך הכרח ח\"ו24,"
        },
        {
          "s": 15,
          "text": "וגם המשכת האור שלפני הצמצום"
        },
        {
          "s": 16,
          "text": "(גם הגילוי לעצמו שלמעלה מהגילוי השייך לעולמות)"
        },
        {
          "s": 17,
          "text": "הוא בשביל איזו כוונה לצורך העולמות25,"
        },
        {
          "s": 18,
          "text": "נמצא,"
        },
        {
          "s": 19,
          "text": "דזה שב' הבחינות דסובב וממלא שלאחרי הצמצום נמשכים מב' הגילויים"
        },
        {
          "s": 20,
          "text": "(גילוי לעצמו וגילוי השייך לעולמות)"
        },
        {
          "s": 21,
          "text": "שלפני הצמצום הוא באופן שהגילויים שלפני הצמצום שייכים26"
        },
        {
          "s": 22,
          "text": "להבחינות שלאחרי הצמצום."
        },
        {
          "s": 23,
          "text": "ומזה מובן,"
        },
        {
          "s": 24,
          "text": "שגם האור שלפני הצמצום נכלל במקור חיים27,"
        },
        {
          "s": 25,
          "text": "ואורך"
        },
        {
          "s": 26,
          "text": "(שהוא למעלה ממקור חיים)"
        },
        {
          "s": 27,
          "text": "הוא נעלה יותר גם מהאור שקודם הצמצום."
        },
        {
          "s": 28,
          "text": "וי\"ל שזהו מה שמבאר בהמאמר דאורך קאי על תורה"
        },
        {
          "s": 29,
          "text": "(תורה אור),"
        },
        {
          "s": 30,
          "text": "דהתורה אינה בשביל העולמות,"
        },
        {
          "s": 31,
          "text": "אדרבא,"
        },
        {
          "s": 32,
          "text": "התהוות כל העולמות"
        },
        {
          "s": 33,
          "text": "(כולל גם הגילויים שלפני הצמצום,"
        },
        {
          "s": 34,
          "text": "שהוא לצורך העולמות)"
        },
        {
          "s": 35,
          "text": "הוא בשביל התורה28."
        }
      ]
    }
  ]
}