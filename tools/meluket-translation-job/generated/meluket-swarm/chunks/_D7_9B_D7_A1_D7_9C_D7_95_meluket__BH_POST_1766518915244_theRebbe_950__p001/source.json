{
  "globalIndex": 242,
  "owner": 42,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915244_theRebbe_950__p001",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915244_theRebbe_950__p001",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915244_theRebbe_950",
  "title": "מאמר פדה בשלום תשכ\"ב",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ ויצא,"
        },
        {
          "s": 2,
          "text": "יו\"ד כסלו מאמר ג,"
        },
        {
          "s": 3,
          "text": "ה'תשכ\"ב*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "פדה בשלום נפשי מקרב לי כי ברבים היו עמדי1,"
        },
        {
          "s": 1,
          "text": "ומבאר בעל הגאולה במאמרו ד\"ה זה"
        },
        {
          "s": 2,
          "text": "(שנדפס בספרו שערי תשובה2),"
        },
        {
          "s": 3,
          "text": "דהטעם על זה שמלחמה נקראת בשם קרב מלשון קירוב"
        },
        {
          "s": 4,
          "text": "(אף שמלחמה היא היפך ענין הקירוב),"
        },
        {
          "s": 5,
          "text": "הוא,"
        },
        {
          "s": 6,
          "text": "כי ענין המלחמה הוא שכל אחד משני הלוחמים רוצה לנצח את השני ולהכניע אותו שיוכלל בו,"
        },
        {
          "s": 7,
          "text": "ובכדי לפעול בזה שלוחם כנגדו שיוכלל בו,"
        },
        {
          "s": 8,
          "text": "הוא דוקא ע\"י הקירוב שמתקרב אליו,"
        },
        {
          "s": 9,
          "text": "קרב מלשון קירוב."
        },
        {
          "s": 10,
          "text": "ועד\"ז הוא בהמלחמה דנפש האלקית ונפש הבהמית,"
        },
        {
          "s": 11,
          "text": "דעיקר המלחמה היא בשעת התפלה"
        },
        {
          "s": 12,
          "text": "(שעת צלותא שעת קרבא3),"
        },
        {
          "s": 13,
          "text": "שבכדי שהעבודה"
        },
        {
          "s": 14,
          "text": "(תפלה)"
        },
        {
          "s": 15,
          "text": "דנפש האלקית תפעול בנפש הבהמית שתוכלל בנפש האלקית"
        },
        {
          "s": 16,
          "text": "[היינו שגם נה\"ב תהי' לה אהבת ה',"
        },
        {
          "s": 17,
          "text": "בכל לבבך בשני יצריך4],"
        },
        {
          "s": 18,
          "text": "הוא ע\"י שנפש האלקית מתלבשת בנפש הבהמית,"
        },
        {
          "s": 19,
          "text": "שההתבוננות של נפש האלקית היא בענינים כאלו ובאופן שגם נפש הבהמית יכולה להשיג5."
        },
        {
          "s": 20,
          "text": "משא\"כ כשהתפלה היא מצד הנשמה עצמה,"
        },
        {
          "s": 21,
          "text": "אינה פועלת בנפש הבהמית,"
        },
        {
          "s": 22,
          "text": "כמבואר בהמאמר."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה6 בירור נה\"ב ע\"י שנה\"א מתלבשת בנה\"ב,"
        },
        {
          "s": 2,
          "text": "הו\"ע של מלחמה,"
        },
        {
          "s": 3,
          "text": "כנ\"ל."
        },
        {
          "s": 4,
          "text": "דענין המלחמה הוא,"
        },
        {
          "s": 5,
          "text": "שיש מנגד וצריך ללחום עמו7."
        },
        {
          "s": 6,
          "text": "וענין פדה בשלום נפשי הוא שהפדי' דנפש האלקית מהגלות דנה\"ב אינה באופן דמלחמה,"
        },
        {
          "s": 7,
          "text": "כי אם,"
        },
        {
          "s": 8,
          "text": "שע\"י גילוי אור עליון מתבטלים הרצונות דנה\"ב,"
        },
        {
          "s": 9,
          "text": "שלכן אין צריך למלחמה כלל."
        },
        {
          "s": 10,
          "text": "וכמבואר בכ\"מ8,"
        },
        {
          "s": 11,
          "text": "וגם במאמר הנ\"ל9,"
        },
        {
          "s": 12,
          "text": "בענין הבירור שע\"י עסק התורה,"
        },
        {
          "s": 13,
          "text": "שהוא לא בדרך מלחמה"
        },
        {
          "s": 14,
          "text": "(היינו שיש מנגד אלא שמנצחים אותו ע\"י מלחמה,"
        },
        {
          "s": 15,
          "text": "כי אם)"
        },
        {
          "s": 16,
          "text": "שע\"י גילוי אור התורה הוא ביטול הרע בעצם10"
        },
        {
          "s": 17,
          "text": "."
        },
        {
          "s": 18,
          "text": "ועד\"ז הוא בתפלה,"
        },
        {
          "s": 19,
          "text": "שע\"י האהבה שלמעלה מטעם ודעת שמצד בחי' חי' יחידה מתבטלים הרצונות דנפש הבהמית,"
        },
        {
          "s": 20,
          "text": "והפדי' דנפש האלקית מהגלות דנה\"ב היא באופן דשלום,"
        },
        {
          "s": 21,
          "text": "פדה בשלום נפשי."
        }
      ]
    }
  ]
}