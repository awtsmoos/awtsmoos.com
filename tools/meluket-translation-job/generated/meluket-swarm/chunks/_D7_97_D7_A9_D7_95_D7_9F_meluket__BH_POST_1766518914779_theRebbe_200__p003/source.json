{
  "globalIndex": 174,
  "owner": 24,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914779_theRebbe_200__p003",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914779_theRebbe_200__p003",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518914779_theRebbe_200",
  "title": "מאמר מים רבים תשל\"ח",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ויש לקשר זה עם ענין ד\"ויעקב הלך לדרכו\""
        },
        {
          "s": 2,
          "text": "(שבמוצאי שבת פרשת נח49),"
        },
        {
          "s": 3,
          "text": "דהגם שלאחרי חודש תשרי הוא הולך לדרכו"
        },
        {
          "s": 4,
          "text": "(גם)"
        },
        {
          "s": 5,
          "text": "בעניני הרשות ובעובדין דחול,"
        },
        {
          "s": 6,
          "text": "ועד לבחינת מים רבים הנ\"ל,"
        },
        {
          "s": 7,
          "text": "מ\"מ עי\"ז גופא הוא מתעלה יותר,"
        },
        {
          "s": 8,
          "text": "שנעשה בבחינת מהלך50,"
        },
        {
          "s": 9,
          "text": "וכלשון הכתוב51"
        },
        {
          "s": 10,
          "text": "ויעקב הלך לדרכו."
        },
        {
          "s": 11,
          "text": "וידיעה זו"
        },
        {
          "s": 12,
          "text": "[שהירידה"
        },
        {
          "s": 13,
          "text": "(לדרכו בעניני הרשות וכו')"
        },
        {
          "s": 14,
          "text": "היא צורך עלי']"
        },
        {
          "s": 15,
          "text": "פועלת שההליכה תהי' בשמחה ובטוב לבב"
        },
        {
          "s": 16,
          "text": "[וע\"ד מ\"ש52"
        },
        {
          "s": 17,
          "text": "גבי יעקב וישא יעקב רגליו גו' משנתבשר בשורה טובה כו']."
        },
        {
          "s": 18,
          "text": "וזה פועל שעבודתו תהי' בתכלית השלימות ולמעלה ממדידה והגבלה"
        },
        {
          "s": 19,
          "text": "(בחי' בכל מאדך53),"
        },
        {
          "s": 20,
          "text": "כי שמחה פורץ54"
        },
        {
          "s": 21,
          "text": "כל הגדרים."
        },
        {
          "s": 22,
          "text": "וע\"י שעובד עבודתו"
        },
        {
          "s": 23,
          "text": "[בכל הג' קוין"
        },
        {
          "s": 24,
          "text": "(ג' בני נח55)"
        },
        {
          "s": 25,
          "text": "דתורה עבודה וגמ\"ח]"
        },
        {
          "s": 26,
          "text": "בתכלית השלימות ובשמחה ובטוב לבב,"
        },
        {
          "s": 27,
          "text": "נמשך לו גם ברכת הוי' בכל המצטרך לו"
        },
        {
          "s": 28,
          "text": "[בג' הענינים דבני חיי ומזוני56]"
        },
        {
          "s": 29,
          "text": "בתכלית השלימות ובשמחה ובטוב לבב,"
        },
        {
          "s": 30,
          "text": "הן ברוחניות והן בגשמיות,"
        },
        {
          "s": 31,
          "text": "וברוחניות ובגשמיות גם יחד."
        }
      ]
    }
  ]
}