{
  "globalIndex": 1100,
  "owner": 0,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920368_theRebbe_469__p008",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920368_theRebbe_469__p008",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920368_theRebbe_469",
  "title": "מאמר השקיפה ממעון קדשך תשכ\"ז",
  "part": 8,
  "sections": [
    {
      "v": 21,
      "items": [
        {
          "s": 0,
          "text": "ומביא בהמאמר ג' הענינים,"
        },
        {
          "s": 1,
          "text": "גם הענין דולא אבה שהוא ע\"ד עבודת הצדיקים,"
        },
        {
          "s": 2,
          "text": "אף שעיקר הענין דמעלת התחתון"
        },
        {
          "s": 3,
          "text": "(עמך)"
        },
        {
          "s": 4,
          "text": "הוא בעבודת התשובה"
        },
        {
          "s": 5,
          "text": "(כנ\"ל),"
        },
        {
          "s": 6,
          "text": "כי הענין והעילוי בתשובה"
        },
        {
          "s": 7,
          "text": "(שפועל שינוי)"
        },
        {
          "s": 8,
          "text": "הוא גם בקיום המצוות"
        },
        {
          "s": 9,
          "text": "(דצדיקים),"
        },
        {
          "s": 10,
          "text": "כמובא בהמאמר מירושלמי כמה גדול כחן של עושי מצוה."
        },
        {
          "s": 11,
          "text": "אלא שבעבודת התשובה הוא בגילוי."
        },
        {
          "s": 12,
          "text": "ובתשובה עצמה ישנם שני אופנים,"
        },
        {
          "s": 13,
          "text": "ויהפוך גו' וכי אהבך גו',"
        },
        {
          "s": 14,
          "text": "שבכל אחד מהם יש יתרון כנ\"ל סעיף יו\"ד."
        }
      ]
    },
    {
      "v": 22,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ג)"
        },
        {
          "s": 2,
          "text": "ויש להוסיף,"
        },
        {
          "s": 3,
          "text": "דזה שאומר את עמך את ישראל"
        },
        {
          "s": 4,
          "text": "(ולא את עמך ו."
        },
        {
          "s": 5,
          "text": "ישראל,"
        },
        {
          "s": 6,
          "text": "שגם בלשון זה מודגש שעמך וישראל הם שני ענינים)"
        },
        {
          "s": 7,
          "text": "הוא בכדי לרמז שהם שתי ברכות,"
        },
        {
          "s": 8,
          "text": "ברכה לעמך וברכה לישראל"
        },
        {
          "s": 9,
          "text": "(כנ\"ל סעיף ב)."
        },
        {
          "s": 10,
          "text": "דנוסף לזה שוברך את עמך נמשכת אח\"כ על ידם לכל ישראל,"
        },
        {
          "s": 11,
          "text": "ישנה עוד ברכה – את ישראל."
        },
        {
          "s": 12,
          "text": "ויש לומר,"
        },
        {
          "s": 13,
          "text": "דוברך את עמך,"
        },
        {
          "s": 14,
          "text": "אנשים פשוטים שמקיימים תומ\"צ בתמימות ובפשטות היא ההמשכה מצד העצם"
        },
        {
          "s": 15,
          "text": "(צמר),"
        },
        {
          "s": 16,
          "text": "דענין הפשטות הוא מצד הפשיטות דעצם הנשמה."
        },
        {
          "s": 17,
          "text": "וברך את ישראל"
        },
        {
          "s": 18,
          "text": "(יודעי תורה)"
        },
        {
          "s": 19,
          "text": "היא המשכה ששייכת לענין הגילויים"
        },
        {
          "s": 20,
          "text": "(שלג)."
        },
        {
          "s": 21,
          "text": "ואעפ\"כ אומר וברך פעם אחת,"
        },
        {
          "s": 22,
          "text": "בכדי לרמז,"
        },
        {
          "s": 23,
          "text": "שהם ענין אחד."
        },
        {
          "s": 24,
          "text": "שוברך את עמך,"
        },
        {
          "s": 25,
          "text": "היא הברכה שנמשכת לישראל,"
        },
        {
          "s": 26,
          "text": "היינו,"
        },
        {
          "s": 27,
          "text": "המשכת העצם בכחות הפנימיים,"
        },
        {
          "s": 28,
          "text": "שכחות הפנימיים"
        },
        {
          "s": 29,
          "text": "(גם מצד הציור שלהם)"
        },
        {
          "s": 30,
          "text": "יהיו כפי העצם,"
        },
        {
          "s": 31,
          "text": "כנ\"ל סעיף ט' ויו\"ד."
        }
      ]
    },
    {
      "v": 23,
      "items": [
        {
          "s": 0,
          "text": "ואין מקרא יוצא מידי פשוטו67,"
        },
        {
          "s": 1,
          "text": "ויהי' ובמהרה בימינו ממש וברך את עמך את ישראל כפשוטו,"
        },
        {
          "s": 2,
          "text": "הן בענינים הרוחניים והן בענינים הגשמיים,"
        },
        {
          "s": 3,
          "text": "בבני חיי ומזוני רויחי,"
        },
        {
          "s": 4,
          "text": "מידו המלאה הפתוחה הקדושה והרחבה."
        }
      ]
    }
  ]
}