{
  "globalIndex": 370,
  "owner": 20,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915857_theRebbe_394__p005",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915857_theRebbe_394__p005",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915857_theRebbe_394",
  "title": "מאמר ת\"ר מצות נר חנוכה תשל\"ח",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "והנה הענין דמשתשקע החמה קאי ביחוד על חושך הגלות73,"
        },
        {
          "s": 2,
          "text": "ובפרט החושך כפול ומכופל דעקבתא דמשיחא."
        },
        {
          "s": 3,
          "text": "וזוהי ההוראה דנ\"ח לכאו\"א בזמן הגלות,"
        },
        {
          "s": 4,
          "text": "שהכוונה דחושך הגלות הוא בכדי לעורר העבודה דמס\"נ,"
        },
        {
          "s": 5,
          "text": "ועי\"ז מתברר החושך ונהפך לאור."
        },
        {
          "s": 6,
          "text": "וע\"י צירוף עבודת כאו\"א מבנ\"י יחד,"
        },
        {
          "s": 7,
          "text": "עכ\"פ רובם"
        },
        {
          "s": 8,
          "text": "(דרובו ככולו74),"
        },
        {
          "s": 9,
          "text": "ואפילו ע\"י מצוה אחת של אחד מישראל,"
        },
        {
          "s": 10,
          "text": "הן במעשה הן בדיבור והן במחשבה,"
        },
        {
          "s": 11,
          "text": "הוא מכריע את עצמו ואת כל העולם כולו לכף זכות וגורם לו ולהם תשועה והצלה75."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "ועאכו\"כ ע\"י ההוספה בקיום מצות נר חנוכה,"
        },
        {
          "s": 3,
          "text": "שמצוה זו שייכת במיוחד להישועה וההצלה,"
        },
        {
          "s": 4,
          "text": "הגאולה שתהי' ע\"י משיח,"
        },
        {
          "s": 5,
          "text": "מכיון שמשיח,"
        },
        {
          "s": 6,
          "text": "וכן אליהו מבשר הגאולה76,"
        },
        {
          "s": 7,
          "text": "הם מהשמונה נסיכי אדם77,"
        },
        {
          "s": 8,
          "text": "ענין שמונה נרות דחנוכה78."
        },
        {
          "s": 9,
          "text": "ועוד ענין בהשייכות המיוחדת דנרות חנוכה לגאולה העתידה,"
        },
        {
          "s": 10,
          "text": "דכמו שנרות חנוכה אין בטלין לעולם79,"
        },
        {
          "s": 11,
          "text": "כן גם גאולה העתידה תהי' גאולה נצחית שאין שייך שיהי' אחרי' גלות80,"
        },
        {
          "s": 12,
          "text": "וכן בית המקדש השלישי הוא בית נצחי81"
        },
        {
          "s": 13,
          "text": "שאינו בטל לעולם,"
        },
        {
          "s": 14,
          "text": "בביאת משיח צדקנו,"
        },
        {
          "s": 15,
          "text": "יבוא ויגאלנו ויוליכנו קוממיות לארצנו,"
        },
        {
          "s": 16,
          "text": "ובקרוב ממש."
        }
      ]
    }
  ]
}