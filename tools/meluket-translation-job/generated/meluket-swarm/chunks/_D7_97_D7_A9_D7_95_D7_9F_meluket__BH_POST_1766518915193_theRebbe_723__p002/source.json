{
  "globalIndex": 237,
  "owner": 37,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915193_theRebbe_723__p002",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915193_theRebbe_723__p002",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518915193_theRebbe_723",
  "title": "מאמר ויאמר לו יהונתן תשמ\"ה",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "וביאור גודל העילוי דונפקדת"
        },
        {
          "s": 2,
          "text": "(שנמשך ע\"י יפקד מושבך)"
        },
        {
          "s": 3,
          "text": "בפרטיות יותר,"
        },
        {
          "s": 4,
          "text": "יובן ע\"פ המבואר בלקו\"ת11"
        },
        {
          "s": 5,
          "text": "שבאתערותא דלעילא יש ג' בחינות."
        },
        {
          "s": 6,
          "text": "אתערותא דלעילא שמצד עצמה,"
        },
        {
          "s": 7,
          "text": "אתערותא דלעילא שמתעוררת ונמשכת ע\"י אתערותא דלתתא"
        },
        {
          "s": 8,
          "text": "(עבודת האדם),"
        },
        {
          "s": 9,
          "text": "ואתערותא דלעילא הבאה במתנה מלמעלה אלא שהמשכתה היא דוקא לאחרי שלימות העבודה."
        },
        {
          "s": 10,
          "text": "ומבואר שם,"
        },
        {
          "s": 11,
          "text": "שהאתערותא דלעילא שמצד עצמה היא ממקום שאין אתערותא דלתתא מגעת לשם"
        },
        {
          "s": 12,
          "text": "[היינו,"
        },
        {
          "s": 13,
          "text": "שהמשכת אתערותא דלעילא זו היא מאוא\"ס שלמעלה מעולמות,"
        },
        {
          "s": 14,
          "text": "שלגבי',"
        },
        {
          "s": 15,
          "text": "אתערותא דלתתא אינה נחשבת למאומה12],"
        },
        {
          "s": 16,
          "text": "והאתערותא דלעילא שנמשכת ע\"י אתערותא דלתתא היא ממקום שהאתערותא דלתתא מגעת לשם"
        },
        {
          "s": 17,
          "text": "[היינו,"
        },
        {
          "s": 18,
          "text": "שבמקום זה יש ערך להנבראים,"
        },
        {
          "s": 19,
          "text": "ועד שהעבודה שלהם"
        },
        {
          "s": 20,
          "text": "(אתערותא דלתתא)"
        },
        {
          "s": 21,
          "text": "מעוררת וממשכת אתערותא דלעילא],"
        },
        {
          "s": 22,
          "text": "והאתערותא דלעילא שבדרך מתנה,"
        },
        {
          "s": 23,
          "text": "המשכתה היא ממקום שאין אתערותא דלתתא מגעת לשם,"
        },
        {
          "s": 24,
          "text": "אלא שאינה שורה ומתגלית אלא לאחרי שלימות העבודה"
        },
        {
          "s": 25,
          "text": "[והאתערותא דלעילא שנמשכת על ידה]."
        },
        {
          "s": 26,
          "text": "דהגם שאתערותא דלעילא זו באה במתנה מלמעלה,"
        },
        {
          "s": 27,
          "text": "מ\"מ צ\"ל איזה כלי לזה,"
        },
        {
          "s": 28,
          "text": "דקוב\"ה לא שריא אלא באתר שלים13,"
        },
        {
          "s": 29,
          "text": "ולכן14,"
        },
        {
          "s": 30,
          "text": "בכדי שיהי' הגילוי של אתערותא דלעילא זו"
        },
        {
          "s": 31,
          "text": "(הבאה בדרך מתנה)"
        },
        {
          "s": 32,
          "text": "צ\"ל השלימות דמעשה התחתונים"
        },
        {
          "s": 33,
          "text": "[אתערותא דלתתא ואתערותא דלעילא שמתעוררת ונמשכת על ידה]."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "שהגילוי דונפקדת הוא נעלה יותר"
        },
        {
          "s": 2,
          "text": "(גם)"
        },
        {
          "s": 3,
          "text": "מהאתערותא דלעילא שלאחרי שלימות העבודה15."
        },
        {
          "s": 4,
          "text": "כי זה שהשלימות דעבודת האדם"
        },
        {
          "s": 5,
          "text": "(מעשה התחתונים)"
        },
        {
          "s": 6,
          "text": "היא כמו כלי לגילוי האתערותא דלעילא,"
        },
        {
          "s": 7,
          "text": "מורה שעבודת האדם יש לה איזה ערך ושייכות להאתערותא דלעילא."
        },
        {
          "s": 8,
          "text": "דבאוא\"ס שלמעלה משייכות לעולמות שכולא קמי' כלא חשיב,"
        },
        {
          "s": 9,
          "text": "אין שייך לומר שהשלימות דמעשה התחתונים היא מקום מוכשר"
        },
        {
          "s": 10,
          "text": "(אתר שלים)"
        },
        {
          "s": 11,
          "text": "להגילוי דאוא\"ס,"
        },
        {
          "s": 12,
          "text": "דכיון שכולא קמי' כלא חשיב,"
        },
        {
          "s": 13,
          "text": "הרי לגבי גילוי זה,"
        },
        {
          "s": 14,
          "text": "אין זה אתר שלים."
        },
        {
          "s": 15,
          "text": "וענין הזכרון"
        },
        {
          "s": 16,
          "text": "(ונפקדת)"
        },
        {
          "s": 17,
          "text": "הוא בהדרגא דאוא\"ס שכולא קמי' כלא חשיב,"
        },
        {
          "s": 18,
          "text": "בדוגמת ענין הזכרון שאינו שייך אלא בדבר שאינו נחשב בעיניו"
        },
        {
          "s": 19,
          "text": "(כנ\"ל)."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "וצריך להבין,"
        },
        {
          "s": 2,
          "text": "שבהדרגא דאוא\"ס שכולא קמי' כלא חשיב,"
        },
        {
          "s": 3,
          "text": "גם הביטול של האדם הוא לכאורה כלא חשיב,"
        },
        {
          "s": 4,
          "text": "והיאך שייך שביטול האדם"
        },
        {
          "s": 5,
          "text": "(יפקד מושבך)"
        },
        {
          "s": 6,
          "text": "יעורר כביכול בדרגא זו שיהי' ונפקדת."
        },
        {
          "s": 7,
          "text": "ולהוסיף,"
        },
        {
          "s": 8,
          "text": "שהאתערותא דלעילא שנמשכת לאחרי שלימות העבודה,"
        },
        {
          "s": 9,
          "text": "הגם שלגבי דרגא זו יש איזה ערך לעבודת האדם"
        },
        {
          "s": 10,
          "text": "(כנ\"ל סעיף ב),"
        },
        {
          "s": 11,
          "text": "מ\"מ אינה נמשכת ע\"י עבודת האדם אלא מצד למעלה"
        },
        {
          "s": 12,
          "text": "(מצד חסדו ית',"
        },
        {
          "s": 13,
          "text": "כי חפץ חסד הוא16),"
        },
        {
          "s": 14,
          "text": "וזה שאינה נמשכת ומתגלית להאדם אלא לאחרי שלימות העבודה הוא בכדי שהאדם יהי' מוכשר לקבל את הגילוי"
        },
        {
          "s": 15,
          "text": "(אבל לא שהעבודה ממשכת את הגילוי,"
        },
        {
          "s": 16,
          "text": "ומכ\"ש שאינה מעוררת אותו),"
        },
        {
          "s": 17,
          "text": "והענין דונפקדת,"
        },
        {
          "s": 18,
          "text": "שהוא בהדרגא דאוא\"ס שכולא קמי' כלא חשיב,"
        },
        {
          "s": 19,
          "text": "הוא מתעורר כביכול ע\"י עבודת האדם"
        },
        {
          "s": 20,
          "text": "(ביטול),"
        },
        {
          "s": 21,
          "text": "שע\"י יפקד מושבך"
        },
        {
          "s": 22,
          "text": "(דהאדם)"
        },
        {
          "s": 23,
          "text": "נעשה שיהי' ונפקדת."
        }
      ]
    }
  ]
}