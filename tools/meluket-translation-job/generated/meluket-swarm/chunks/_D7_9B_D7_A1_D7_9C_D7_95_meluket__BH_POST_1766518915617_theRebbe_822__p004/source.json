{
  "globalIndex": 325,
  "owner": 25,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915617_theRebbe_822__p004",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915617_theRebbe_822__p004",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915617_theRebbe_822",
  "title": "מאמר ברוך שעשה ניסים תשט\"ו",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "והענין הוא19,"
        },
        {
          "s": 1,
          "text": "דזה שהחכמה היא אין,"
        },
        {
          "s": 2,
          "text": "הוא כמו שנעשית מקור לבינה,"
        },
        {
          "s": 3,
          "text": "דכיון שהתהוות הבינה מהחכמה היא ע\"י שהחכמה מתעלמת מהבינה,"
        },
        {
          "s": 4,
          "text": "לכן היא נקראת אז בשם אין"
        },
        {
          "s": 5,
          "text": "(שאינו מושג)."
        },
        {
          "s": 6,
          "text": "אבל החכמה עצמה היא בחינת יש,"
        },
        {
          "s": 7,
          "text": "וזה שהחכמה היא מקור לבינה"
        },
        {
          "s": 8,
          "text": "(ומכ\"ש הבינה עצמה)"
        },
        {
          "s": 9,
          "text": "הוא אין לגבי עצם החכמה,"
        },
        {
          "s": 10,
          "text": "אין דכלא חשיב."
        },
        {
          "s": 11,
          "text": "ועפ\"ז,"
        },
        {
          "s": 12,
          "text": "בבחינת החכמה שנעשית מקור לבינה – הוא ע\"ד הדיעה דדעת תחתון שלמעלה אין ולמטה יש,"
        },
        {
          "s": 13,
          "text": "ובבחינת עצם החכמה שלמעלה ממקור לבינה – הוא ע\"ד הדיעה דדעת עליון שלמעלה יש ולמטה אין."
        },
        {
          "s": 14,
          "text": "[ויש לומר,"
        },
        {
          "s": 15,
          "text": "שגם בחכמה שלמעלה ממקור לבינה שתי דרגות."
        },
        {
          "s": 16,
          "text": "עצם החכמה והארת החכמה."
        },
        {
          "s": 17,
          "text": "כי ענין זה שבחכמה"
        },
        {
          "s": 18,
          "text": "(ההרגש שמקור לבינה הוא אין דכלא חשיב)"
        },
        {
          "s": 19,
          "text": "הוא הארת החכמה ולא עצמותה20,"
        },
        {
          "s": 20,
          "text": "אלא שהארה זו היא דבוקה בהעצם,"
        },
        {
          "s": 21,
          "text": "ולכן נרגש בה שכל הענינים שאינם עצם החכמה21"
        },
        {
          "s": 22,
          "text": "הם כלא חשיב."
        },
        {
          "s": 23,
          "text": "דהארת החכמה שנעשית מקור לבינה היא הארה נבדלת,"
        },
        {
          "s": 24,
          "text": "ולכן היא מקור לבינה – בדוגמת אין של יש הנברא,"
        },
        {
          "s": 25,
          "text": "והארת החכמה שדבוקה בעצם החכמה,"
        },
        {
          "s": 26,
          "text": "נרגש בה שהיא אין דכלא חשיב לגבי עצם החכמה – בדוגמת אין של יש האמיתי]."
        },
        {
          "s": 27,
          "text": "ומהחילוקים שבין זיווג פנימי דחו\"ב וזיווג חיצוני דחו\"ב הוא,"
        },
        {
          "s": 28,
          "text": "דבזיווג חיצוני ההמשכה היא מחיצוניות החכמה,"
        },
        {
          "s": 29,
          "text": "היינו מבחינת החכמה כמו שנעשית מקור לבינה"
        },
        {
          "s": 30,
          "text": "(וגם בחינה זו דחכמה מתעלמת מהבינה,"
        },
        {
          "s": 31,
          "text": "אין שאינו מושג),"
        },
        {
          "s": 32,
          "text": "ובזיווג פנימי ההמשכה היא מפנימיות החכמה,"
        },
        {
          "s": 33,
          "text": "והמשכה זו היא בגילוי בהבינה,"
        },
        {
          "s": 34,
          "text": "וכיון שלגבי פנימיות החכמה המקור לבינה ומכ\"ש הבינה עצמה הם כלא חשיב,"
        },
        {
          "s": 35,
          "text": "לכן,"
        },
        {
          "s": 36,
          "text": "ע\"י שבבינה מתגלית פנימיות החכמה,"
        },
        {
          "s": 37,
          "text": "היא נכללת בחכמה."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה זה שנתבאר לעיל שעצם החכמה הוא יש והארת החכמה הוא אין דכלא חשיב לגבי עצם החכמה,"
        },
        {
          "s": 2,
          "text": "הם שני הענינים דיש ואין שבחכמה עצמה,"
        },
        {
          "s": 3,
          "text": "אבל בכללות,"
        },
        {
          "s": 4,
          "text": "ענין יש שבחכמה הוא שבהחכמה שורה אוא\"ס יש האמיתי,"
        },
        {
          "s": 5,
          "text": "והאין שבחכמה הוא,"
        },
        {
          "s": 6,
          "text": "שכללות החכמה"
        },
        {
          "s": 7,
          "text": "(גם עצם החכמה)"
        },
        {
          "s": 8,
          "text": "היא בביטול לאוא\"ס שנרגש בה שלמעלה יש ולמטה אין,"
        },
        {
          "s": 9,
          "text": "והוא האין דיש האמיתי."
        },
        {
          "s": 10,
          "text": "אבל זה שהחכמה נעשית מקור לבינה הוא האין דיש הנברא."
        },
        {
          "s": 11,
          "text": "ועפ\"ז,"
        },
        {
          "s": 12,
          "text": "זה שבזיווג חיצוני דחו\"ב הוא דעת תחתון,"
        },
        {
          "s": 13,
          "text": "הוא גם מצד החכמה."
        },
        {
          "s": 14,
          "text": "דזה שנתבאר לעיל"
        },
        {
          "s": 15,
          "text": "(סעיף ג)"
        },
        {
          "s": 16,
          "text": "שבחכמה היא דעת עליון"
        },
        {
          "s": 17,
          "text": "(ודוקא בבינה הוא דעת תחתון לפי שבבינה נמשך רק השכל דחכמה)"
        },
        {
          "s": 18,
          "text": "הוא בכללות,"
        },
        {
          "s": 19,
          "text": "אבל בפרטיות,"
        },
        {
          "s": 20,
          "text": "הענין דדעת תחתון שבזיווג חיצוני דחו\"ב הוא גם מצד החכמה22,"
        },
        {
          "s": 21,
          "text": "מכיון שהחכמה"
        },
        {
          "s": 22,
          "text": "(בזיווג חיצוני)"
        },
        {
          "s": 23,
          "text": "הוא האין דיש הנברא,"
        },
        {
          "s": 24,
          "text": "ועיקר הענין דדעת עליון הוא בזיווג פנימי דחו\"ב,"
        },
        {
          "s": 25,
          "text": "דהחכמה"
        },
        {
          "s": 26,
          "text": "(שבזיווג זה)"
        },
        {
          "s": 27,
          "text": "היא אין של יש האמיתי,"
        },
        {
          "s": 28,
          "text": "וגם הבינה נכללת בחכמה."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש לבאר מ\"ש ברוך שעשה נסים לאבותינו"
        },
        {
          "s": 1,
          "text": "(לשון רבים),"
        },
        {
          "s": 2,
          "text": "שההרמה והעלי'"
        },
        {
          "s": 3,
          "text": "(שממנה נמשכים הנסים)"
        },
        {
          "s": 4,
          "text": "היא גם בחכמה,"
        },
        {
          "s": 5,
          "text": "כי החכמה מצד עצמה"
        },
        {
          "s": 6,
          "text": "(כמו שהיא בזיווג חיצוני)"
        },
        {
          "s": 7,
          "text": "היא מקור לבינה – אין של יש הנברא,"
        },
        {
          "s": 8,
          "text": "והמשכת הנסים היא מבחינת עצם החכמה שלמעלה ממקור לבינה – אין של יש האמיתי."
        }
      ]
    }
  ]
}