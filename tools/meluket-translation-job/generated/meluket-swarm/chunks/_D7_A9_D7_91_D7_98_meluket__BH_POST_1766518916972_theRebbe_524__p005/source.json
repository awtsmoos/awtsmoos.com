{
  "globalIndex": 564,
  "owner": 14,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916972_theRebbe_524__p005",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916972_theRebbe_524__p005",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916972_theRebbe_524",
  "title": "מאמר באתי לגני תשמ\"ח",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ב)"
        },
        {
          "s": 2,
          "text": "והנה,"
        },
        {
          "s": 3,
          "text": "כאמור לעיל,"
        },
        {
          "s": 4,
          "text": "דע\"י שהנשיאים גילו לנו כל זה,"
        },
        {
          "s": 5,
          "text": "ניתוסף עוד יותר בהנתינת כח לכאו\"א מהצבאות הוי'"
        },
        {
          "s": 6,
          "text": "[ובפרט צבאות הוי' דדורנו זה,"
        },
        {
          "s": 7,
          "text": "דור השביעי מאדמו\"ר הזקן,"
        },
        {
          "s": 8,
          "text": "ודור התשיעי מהבעש\"ט,"
        },
        {
          "s": 9,
          "text": "ומיד נעשה דור זה"
        },
        {
          "s": 10,
          "text": "(דור האחרון דהגלות)"
        },
        {
          "s": 11,
          "text": "דור הגאולה,"
        },
        {
          "s": 12,
          "text": "דור העשירי שהולך לקראת משיח צדקנו],"
        },
        {
          "s": 13,
          "text": "שעבודתו תהי' בתוקף בלי שינויים"
        },
        {
          "s": 14,
          "text": "(מכיון שכאו\"א מישראל שייך לעתיק שאין שייך בו שינוי),"
        },
        {
          "s": 15,
          "text": "דהגם שעבודת האדם צריכה להיות בג' קוין"
        },
        {
          "s": 16,
          "text": "(סור מרע ועשה טוב בקש שלום)"
        },
        {
          "s": 17,
          "text": "מ\"מ צריך שיהי' בזה התוקף שמצד עתיק שלמעלה מקוין"
        },
        {
          "s": 18,
          "text": "(ע\"ד שנת\"ל בענין החיבור דאדם עם לא אדם)."
        },
        {
          "s": 19,
          "text": "ובפרט ביום ההילולא,"
        },
        {
          "s": 20,
          "text": "שאז,"
        },
        {
          "s": 21,
          "text": "כל מעשיו ותורתו ועבודתו"
        },
        {
          "s": 22,
          "text": "(של בעל ההילולא)"
        },
        {
          "s": 23,
          "text": "הם בגילוי,"
        },
        {
          "s": 24,
          "text": "ובאופן דפועל ישועות בקרב הארץ64,"
        },
        {
          "s": 25,
          "text": "שגם בקרב הארץ"
        },
        {
          "s": 26,
          "text": "(בערות הארץ)65"
        },
        {
          "s": 27,
          "text": "נמשכים ומתגלים הישועות שלמעלה מהשתלשלות,"
        },
        {
          "s": 28,
          "text": "ובפרט שמיום ההילולא באים תיכף לש\"ק ונמצאים עתה בזמן דמנחת שבת,"
        },
        {
          "s": 29,
          "text": "רעוא דכל רעוין"
        },
        {
          "s": 30,
          "text": "(בחי' עתיק),"
        },
        {
          "s": 31,
          "text": "שאז מיתוסף עוד יותר בהנתינת כח לכאו\"א מבנ\"י,"
        },
        {
          "s": 32,
          "text": "צבאות הוי',"
        },
        {
          "s": 33,
          "text": "לעבוד עבודתו בתוקף בלי שינויים,"
        },
        {
          "s": 34,
          "text": "שעי\"ז נמשך עיקר שכינה בתחתונים,"
        },
        {
          "s": 35,
          "text": "כמו שהי' בתחלת הבריאה,"
        },
        {
          "s": 36,
          "text": "ועוד יותר,"
        },
        {
          "s": 37,
          "text": "דהגם שגם בתחלת הבריאה כתיב66"
        },
        {
          "s": 38,
          "text": "תולדות מלא67,"
        },
        {
          "s": 39,
          "text": "עולם על מילואו נברא68,"
        },
        {
          "s": 40,
          "text": "הרי אלה תולדות פרץ69,"
        },
        {
          "s": 41,
          "text": "תולדות מלא67,"
        },
        {
          "s": 42,
          "text": "הוא למעלה יותר מתולדות מלא שבתחלת הבריאה,"
        },
        {
          "s": 43,
          "text": "ועד שיהי' גם הגילוי דפנימיות עתיק,"
        },
        {
          "s": 44,
          "text": "שזה יהי' דוקא לע\"ל70,"
        },
        {
          "s": 45,
          "text": "בגאולה האמיתית והשלימה ע\"י משיח צדקנו,"
        },
        {
          "s": 46,
          "text": "בקרוב ממש."
        }
      ]
    }
  ]
}