{
  "globalIndex": 1008,
  "owner": 8,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919765_theRebbe_137__p004",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919765_theRebbe_137__p004",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919765_theRebbe_137",
  "title": "מאמר קץ שם לחושך תשכ\"ד",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה ג' מדריגות הנ\"ל בהביטול דאור,"
        },
        {
          "s": 2,
          "text": "יש"
        },
        {
          "s": 3,
          "text": "(דוגמתם)"
        },
        {
          "s": 4,
          "text": "גם בעבודת האדם30."
        },
        {
          "s": 5,
          "text": "וע\"פ המובא לעיל מהמאמר שג' מדריגות הנ\"ל בהביטול דאור הם בבינה חכמה וכתר,"
        },
        {
          "s": 6,
          "text": "יש לומר,"
        },
        {
          "s": 7,
          "text": "שג' ביטולים הנ\"ל בעבודת האדם הם הביטול דהשגה המיוסדת על אמונה,"
        },
        {
          "s": 8,
          "text": "הביטול דאמונה והביטול דמסירת נפש."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ויובן זה ע\"פ המבואר במק\"א31"
        },
        {
          "s": 1,
          "text": "בענין מקיף ופנימי,"
        },
        {
          "s": 2,
          "text": "שגם כשהמקיף נמשך ומתלבש בפנימי,"
        },
        {
          "s": 3,
          "text": "הוא נשאר במהותו,"
        },
        {
          "s": 4,
          "text": "מקיף."
        },
        {
          "s": 5,
          "text": "[וכמו\"כ הוא בנוגע להתלבשות האור בכלים"
        },
        {
          "s": 6,
          "text": "(שהאור מצד עצמו הוא מקיף וע\"י התלבשותו בכלים נעשה אור פנימי),"
        },
        {
          "s": 7,
          "text": "שגם לאחרי שהאור מתלבש בכלים הוא נשאר במהותו,"
        },
        {
          "s": 8,
          "text": "אור32]."
        },
        {
          "s": 9,
          "text": "וע\"ד הרצון,"
        },
        {
          "s": 10,
          "text": "שגם לאחרי שנמשך ומתלבש בשכל ועד שהוא מטה את השכל שיהי' כפי הרצון ונעשה טעם להרצון,"
        },
        {
          "s": 11,
          "text": "מ\"מ הוא נשאר במהותו,"
        },
        {
          "s": 12,
          "text": "רצון שלמעלה מטעם."
        },
        {
          "s": 13,
          "text": "וכמו\"כ הוא בהתלבשות אמונה בשכל,"
        },
        {
          "s": 14,
          "text": "דכשמתבונן בשכלו בענין שהוא מאמין בו"
        },
        {
          "s": 15,
          "text": "(באמונה פשוטה שלמעלה משכל)"
        },
        {
          "s": 16,
          "text": "בכדי שגם בשכלו יבין את הענין,"
        },
        {
          "s": 17,
          "text": "שגם לאחרי שהוא מבין את הענין בשכלו,"
        },
        {
          "s": 18,
          "text": "האמונה שלו היא אמונה שלמעלה משכל."
        },
        {
          "s": 19,
          "text": "והחילוק שבין שני המשלים הוא,"
        },
        {
          "s": 20,
          "text": "שבהמשל דהתלבשות הרצון בשכל,"
        },
        {
          "s": 21,
          "text": "זה שהשכל מבין כפי הרצון הוא לא מצד השכל אלא מצד הרצון שמטה את השכל ומשנה אותו."
        },
        {
          "s": 22,
          "text": "וכיון שהתלבשות הרצון בשכל היא באופן שהשכל מתבטל"
        },
        {
          "s": 23,
          "text": "(משתנה)"
        },
        {
          "s": 24,
          "text": "מפני הרצון,"
        },
        {
          "s": 25,
          "text": "לכן,"
        },
        {
          "s": 26,
          "text": "זה שההתלבשות אינה פועלת שינוי בהרצון"
        },
        {
          "s": 27,
          "text": "(שגם לאחרי התלבשותו בשכל הוא נשאר במציאותו),"
        },
        {
          "s": 28,
          "text": "אינו חידוש כ\"כ."
        },
        {
          "s": 29,
          "text": "ובהתלבשות האמונה בשכל,"
        },
        {
          "s": 30,
          "text": "זה שהשכל בא למסקנא שהענין שמאמין בו הוא אמת גם מצד השכל,"
        },
        {
          "s": 31,
          "text": "הוא מצד השכל"
        },
        {
          "s": 32,
          "text": "[דכשמתבונן בשכלו בכדי שגם השכל שלו יהי' כפי האמת,"
        },
        {
          "s": 33,
          "text": "הוא משתדל שההתבוננות והשקו\"ט שלו יהיו ע\"פ אמיתית השכל33],"
        },
        {
          "s": 34,
          "text": "ואעפ\"כ ההתלבשות אינה פועלת שינוי בהאמונה,"
        },
        {
          "s": 35,
          "text": "וגם לאחרי שמבין את הענין בשכלו"
        },
        {
          "s": 36,
          "text": "(מצד השכל),"
        },
        {
          "s": 37,
          "text": "האמונה שלו היא אמונה שלמעלה מהשכל."
        },
        {
          "s": 38,
          "text": "ועוד חילוק בין שני המשלים,"
        },
        {
          "s": 39,
          "text": "דבהתלבשות הרצון בשכל,"
        },
        {
          "s": 40,
          "text": "זה שהרצון מתלבש בשכל ופועל עליו שיהי' כפי הרצון הוא מפני שהרצון שולט על השכל"
        },
        {
          "s": 41,
          "text": "(ולא שזה נוגע להרצון)."
        },
        {
          "s": 42,
          "text": "וכיון דזה שהרצון שולט על השכל הוא"
        },
        {
          "s": 43,
          "text": "(לא הרצון עצמו,"
        },
        {
          "s": 44,
          "text": "אלא)"
        },
        {
          "s": 45,
          "text": "היחס שלו לשאר הכחות,"
        },
        {
          "s": 46,
          "text": "לכן ירידת הרצון והתלבשותו בשכל היא ירידה אמיתית"
        },
        {
          "s": 47,
          "text": "(יציאה מרצון לשכל)."
        },
        {
          "s": 48,
          "text": "ובהתלבשות האמונה בשכל,"
        },
        {
          "s": 49,
          "text": "זה שמתבונן בשכלו בכדי להבין את הענין הוא בשביל האמונה,"
        },
        {
          "s": 50,
          "text": "בכדי שהאמונה שלו תהי' גם בפנימיות."
        },
        {
          "s": 51,
          "text": "ולכן ירידת האמונה והתלבשותה בשכל אינה ירידה אמיתית."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "וע\"פ הידוע34"
        },
        {
          "s": 1,
          "text": "שאמונה היא ביטול ושכל הוא מציאות,"
        },
        {
          "s": 2,
          "text": "מובן,"
        },
        {
          "s": 3,
          "text": "דענין התלבשות האמונה בשכל הוא שהביטול נמשך במציאות."
        },
        {
          "s": 4,
          "text": "וכיון שההתבוננות"
        },
        {
          "s": 5,
          "text": "(וההשגה)"
        },
        {
          "s": 6,
          "text": "שלו היא בשביל האמונה"
        },
        {
          "s": 7,
          "text": "[וגם זה שהשכל נשאר במציאותו ואינו מתבטל לגבי האמונה"
        },
        {
          "s": 8,
          "text": "(כמו שהוא מתבטל לגבי הרצון)"
        },
        {
          "s": 9,
          "text": "הוא בשביל האמונה,"
        },
        {
          "s": 10,
          "text": "בכדי שגם השכל כמו שהוא במציאותו יהי' כפי האמונה],"
        },
        {
          "s": 11,
          "text": "לכן גם לאחרי שהביטול דאמונה נמשך בהמציאות דשכל,"
        },
        {
          "s": 12,
          "text": "הביטול הוא בתקפו."
        },
        {
          "s": 13,
          "text": "והחילוק שבין הביטול דאמונה שמתלבשת בשכל והביטול דאמונה שלמעלה מהשכל הוא,"
        },
        {
          "s": 14,
          "text": "שהביטול דאמונה המתלבשת בשכל בא בציור דגילוי"
        },
        {
          "s": 15,
          "text": "(שהביטול מתגלה בשכל),"
        },
        {
          "s": 16,
          "text": "מציאות."
        },
        {
          "s": 17,
          "text": "דנוסף לזה שהשכל"
        },
        {
          "s": 18,
          "text": "(שבו מתלבשת האמונה)"
        },
        {
          "s": 19,
          "text": "הוא מציאות,"
        },
        {
          "s": 20,
          "text": "גם הגילוי דהאמונה"
        },
        {
          "s": 21,
          "text": "(זה שהאמונה היא בגילוי באופן שהיא נרגשת בהשכל)"
        },
        {
          "s": 22,
          "text": "הוא מציאות35."
        },
        {
          "s": 23,
          "text": "והביטול דאמונה שלמעלה מהשכל הוא למעלה מהמציאות דגילוי."
        },
        {
          "s": 24,
          "text": "[בדוגמת החילוק בין הביטול דאור המתלבש בכלים והביטול דאור שלמעלה מהתלבשות,"
        },
        {
          "s": 25,
          "text": "שגם האור המתלבש בכלים אינו מציאות לעצמו וכל ענינו הוא גילוי המאור."
        },
        {
          "s": 26,
          "text": "אלא שהביטול דאור המתלבש הוא בציור דגילוי,"
        },
        {
          "s": 27,
          "text": "מציאות."
        },
        {
          "s": 28,
          "text": "דנוסף לזה שהכלים שבהם מתלבש האור הם מציאות,"
        },
        {
          "s": 29,
          "text": "גם הגילוי דהאור"
        },
        {
          "s": 30,
          "text": "(שמתגלה בהכלים)"
        },
        {
          "s": 31,
          "text": "הוא מציאות."
        },
        {
          "s": 32,
          "text": "והביטול דאור שלמעלה מהתלבשות הוא שאין בו גם המציאות דגילוי]."
        }
      ]
    }
  ]
}