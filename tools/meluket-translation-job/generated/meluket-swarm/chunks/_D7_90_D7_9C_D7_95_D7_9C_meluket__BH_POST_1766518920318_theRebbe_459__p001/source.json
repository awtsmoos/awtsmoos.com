{
  "globalIndex": 1089,
  "owner": 39,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920318_theRebbe_459__p001",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920318_theRebbe_459__p001",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920318_theRebbe_459",
  "title": "מאמר שמח תשמח תשמ\"א",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ תצא,"
        },
        {
          "s": 2,
          "text": "י\"ג אלול ה'תשמ\"א*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "שמח תשמח רעים האהובים כשמחך יצירך בגן עדן מקדם1,"
        },
        {
          "s": 1,
          "text": "ומבואר בד\"ה זה"
        },
        {
          "s": 2,
          "text": "(שנאמר בעת חתונת כ\"ק מו\"ח אדמו\"ר ביום ועש\"ק,"
        },
        {
          "s": 3,
          "text": "י\"ג אלול תרנ\"ז)2"
        },
        {
          "s": 4,
          "text": "דרעים האהובים הם בחי' חו\"ב שנק' תרין ריעין דלא מתפרשין3,"
        },
        {
          "s": 5,
          "text": "והבקשה שמח תשמח רעים האהובים היא שתומשך שמחה בחו\"ב."
        },
        {
          "s": 6,
          "text": "וצריך להבין4,"
        },
        {
          "s": 7,
          "text": "הרי בינה היא מקום השמחה כמ\"ש5"
        },
        {
          "s": 8,
          "text": "אם הבנים שמחה,"
        },
        {
          "s": 9,
          "text": "וידוע6"
        },
        {
          "s": 10,
          "text": "דאם הבנים קאי על בינה שהיא האם המולדת את המדות,"
        },
        {
          "s": 11,
          "text": "וכמו שרואים גם בחוש דכשאדם משיג בשכלו איזו השגה יש לו שמחה מזה,"
        },
        {
          "s": 12,
          "text": "וגם בחכמה שאין שייך בה שמחה,"
        },
        {
          "s": 13,
          "text": "כי שמחה היא מצד הגילוי דוקא וחכמה"
        },
        {
          "s": 14,
          "text": "(כמו ברק המבריק)"
        },
        {
          "s": 15,
          "text": "היא למעלה מגילוי,"
        },
        {
          "s": 16,
          "text": "הרי בחכמה מאיר גילוי העונג,"
        },
        {
          "s": 17,
          "text": "וכמו צהבו7"
        },
        {
          "s": 18,
          "text": "פניו של רבי אבהו שמצא תוספתא חדתא8,"
        },
        {
          "s": 19,
          "text": "דצהיבת הפנים הוא מגילוי העונג,"
        },
        {
          "s": 20,
          "text": "וידוע דעונג הוא למעלה משמחה,"
        },
        {
          "s": 21,
          "text": "ומהי הבקשה שמח תשמח רעים האהובים,"
        },
        {
          "s": 22,
          "text": "מאחר שבלאו הכי יש שמחה בבינה,"
        },
        {
          "s": 23,
          "text": "ועאכו\"כ בחכמה שיש בה עונג שלמעלה משמחה."
        },
        {
          "s": 24,
          "text": "וגם צריך להבין,"
        },
        {
          "s": 25,
          "text": "הרי רעים האהובים"
        },
        {
          "s": 26,
          "text": "(בפשטות)"
        },
        {
          "s": 27,
          "text": "קאי על חתן וכלה9,"
        },
        {
          "s": 28,
          "text": "וידוע דחתן וכלה הם זו\"ן,"
        },
        {
          "s": 29,
          "text": "ומהו הקשר דפירוש זה"
        },
        {
          "s": 30,
          "text": "(שרעים האהובים קאי על חתן וכלה,"
        },
        {
          "s": 31,
          "text": "זו\"ן)"
        },
        {
          "s": 32,
          "text": "עם פירוש הנ\"ל דרעים"
        },
        {
          "s": 33,
          "text": "(האהובים)"
        },
        {
          "s": 34,
          "text": "הם חו\"ב10."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויש לומר דיובן זה"
        },
        {
          "s": 2,
          "text": "(הקשר דשני הפירושים)"
        },
        {
          "s": 3,
          "text": "ע\"פ מ\"ש בספר אמת ליעקב11"
        },
        {
          "s": 4,
          "text": "(הובא במאמר הנ\"ל12)"
        },
        {
          "s": 5,
          "text": "דאהובים בגימטריא דודים והם ז\"א ונוקבא"
        },
        {
          "s": 6,
          "text": "(וכידוע13,"
        },
        {
          "s": 7,
          "text": "שרעים הם חו\"ב ודודים הם זו\"ן)."
        },
        {
          "s": 8,
          "text": "ומ\"ש רעים האהובים,"
        },
        {
          "s": 9,
          "text": "דתיבת אהובים היא בהמשך ותואר של רעים שקאי"
        },
        {
          "s": 10,
          "text": "(כנ\"ל)"
        },
        {
          "s": 11,
          "text": "על חו\"ב,"
        },
        {
          "s": 12,
          "text": "יש לבאר בשני אופנים."
        },
        {
          "s": 13,
          "text": "א',"
        },
        {
          "s": 14,
          "text": "ע\"פ הידוע14"
        },
        {
          "s": 15,
          "text": "באופן לידת המדות"
        },
        {
          "s": 16,
          "text": "(זו\"ן)"
        },
        {
          "s": 17,
          "text": "מהמוחין"
        },
        {
          "s": 18,
          "text": "(חו\"ב),"
        },
        {
          "s": 19,
          "text": "שבתחילה הם כלולים בהמוחין ואח\"כ הם נמשכים בגילוי."
        },
        {
          "s": 20,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 21,
          "text": "דרעים האהובים קאי על זו\"ן"
        },
        {
          "s": 22,
          "text": "(אהובים)"
        },
        {
          "s": 23,
          "text": "כמו שהם כלולים בחו\"ב"
        },
        {
          "s": 24,
          "text": "(רעים),"
        },
        {
          "s": 25,
          "text": "משא\"כ אהובים"
        },
        {
          "s": 26,
          "text": "(סתם)"
        },
        {
          "s": 27,
          "text": "קאי על זו\"ן כמו שנמשכים בגילוי,"
        },
        {
          "s": 28,
          "text": "אהובים בגימטריא דודים."
        },
        {
          "s": 29,
          "text": "ועפ\"ז יובן גם זה שהענין דזו\"ן"
        },
        {
          "s": 30,
          "text": "(דודים)"
        },
        {
          "s": 31,
          "text": "מרומז בהגימטריא דאהובים"
        },
        {
          "s": 32,
          "text": "(אהובים בגימטריא דודים),"
        },
        {
          "s": 33,
          "text": "דגימטריא מורה על מיעוט האור והחיות מיעוט אחר מיעוט15,"
        },
        {
          "s": 34,
          "text": "כי ההמשכה מהמדות שבמוחין"
        },
        {
          "s": 35,
          "text": "(רעים האהובים)"
        },
        {
          "s": 36,
          "text": "למדות שבלב"
        },
        {
          "s": 37,
          "text": "(אהובים בגימטריא דודים)"
        },
        {
          "s": 38,
          "text": "היא ע\"י כמה צמצומים16."
        },
        {
          "s": 39,
          "text": "וב',"
        },
        {
          "s": 40,
          "text": "דמכיון שהמדות הם תולדות המוחין,"
        },
        {
          "s": 41,
          "text": "דחו\"ב הם אב ואם וזו\"ן הם בן ובת"
        },
        {
          "s": 42,
          "text": "[כדאיתא בקבלה17"
        },
        {
          "s": 43,
          "text": "שאב ואם הם י\"ה"
        },
        {
          "s": 44,
          "text": "(חו\"ב),"
        },
        {
          "s": 45,
          "text": "ובן ובת הם ו\"ה"
        },
        {
          "s": 46,
          "text": "(זו\"ן)],"
        },
        {
          "s": 47,
          "text": "הם מתדמין להמוחין"
        },
        {
          "s": 48,
          "text": "(גם לאחרי שנמשכו ונתגלו),"
        },
        {
          "s": 49,
          "text": "כי האב מוריש לבנו כו' ועד שהיורש הוא במקום המוריש18,"
        },
        {
          "s": 50,
          "text": "ועד\"ז הוא בנוגע לבת"
        },
        {
          "s": 51,
          "text": "(כשהיא יורשת,"
        },
        {
          "s": 52,
          "text": "במקום שאין בן)"
        },
        {
          "s": 53,
          "text": "[ובפרטיות,"
        },
        {
          "s": 54,
          "text": "הבן הוא במקום האב,"
        },
        {
          "s": 55,
          "text": "והבת היא במקום האם כמ\"ש19"
        },
        {
          "s": 56,
          "text": "כאמה בתה]."
        },
        {
          "s": 57,
          "text": "דעפ\"ז יש לומר,"
        },
        {
          "s": 58,
          "text": "שגם לאחרי שנמשכו ונתגלו,"
        },
        {
          "s": 59,
          "text": "נק' הם בשם רעים האהובים"
        },
        {
          "s": 60,
          "text": "(וכנ\"ל,"
        },
        {
          "s": 61,
          "text": "דרעים האהובים בפשטות קאי על חתן וכלה,"
        },
        {
          "s": 62,
          "text": "זו\"ן שבגילוי),"
        },
        {
          "s": 63,
          "text": "מכיון שגם אז"
        },
        {
          "s": 64,
          "text": "(לאחרי המשכתן והתגלותן)"
        },
        {
          "s": 65,
          "text": "הם דומין לחו\"ב."
        }
      ]
    }
  ]
}