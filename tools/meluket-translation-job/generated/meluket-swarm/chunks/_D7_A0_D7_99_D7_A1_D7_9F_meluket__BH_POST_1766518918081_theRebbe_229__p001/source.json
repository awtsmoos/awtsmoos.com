{
  "globalIndex": 735,
  "owner": 35,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918081_theRebbe_229__p001",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918081_theRebbe_229__p001",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518918081_theRebbe_229",
  "title": "מאמר והחרים ה' תשמ\"ט",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "אחרון של פסח ה'תשמ\"ט*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "והחרים הוי' את לשון ים מצרים והניף ידו על הנהר בעים רוחו וגו'1,"
        },
        {
          "s": 1,
          "text": "ומבאר בזה אדמו\"ר מהר\"ש"
        },
        {
          "s": 2,
          "text": "(מלכתחילה אַריבער)"
        },
        {
          "s": 3,
          "text": "בארוכה בהמשך והחרים,"
        },
        {
          "s": 4,
          "text": "דנוסף שלע\"ל יהי' והחרים גו' את לשון ים מצרים דוגמת קריעת ים סוף שהיתה ביציאת מצרים,"
        },
        {
          "s": 5,
          "text": "יהי' גם והניף ידו על הנהר גו',"
        },
        {
          "s": 6,
          "text": "דבקיעת הנהר היא למעלה יותר מבקיעת הים,"
        },
        {
          "s": 7,
          "text": "כמבואר שם בארוכה2."
        },
        {
          "s": 8,
          "text": "ועיקר החידוש דלע\"ל הוא שאז יהי' בקיעת הנהר."
        },
        {
          "s": 9,
          "text": "וכמ\"ש3"
        },
        {
          "s": 10,
          "text": "הפך ים ליבשה בנהר יעברו ברגל,"
        },
        {
          "s": 11,
          "text": "הפך ים ליבשה לשון עבר דקאי על קי\"ס שהיתה בהגאולה דיציאת מצרים,"
        },
        {
          "s": 12,
          "text": "בנהר יעברו ברגל לשון עתיד דקאי על בקיעת הנהר שתהי' בגאולה העתידה4,"
        },
        {
          "s": 13,
          "text": "ובנהר יעברו ברגל זהו עיקר החידוש שיהי' בגאולה העתידה."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "דזה שוהחרים גו' ים מצרים ממשיך לזה ותיכף והניף ידו על הנהר גו' הוא להורות שמקי\"ס וענינו שהיו בהגאולה דיציאת מצרים אפשר לבוא מיד"
        },
        {
          "s": 3,
          "text": "(בלי שום הפסק)"
        },
        {
          "s": 4,
          "text": "לוהניף ידו על הנהר גו' שיהי' לע\"ל."
        },
        {
          "s": 5,
          "text": "ובפרט באחרון של פסח,"
        },
        {
          "s": 6,
          "text": "שבו אומרים ההפטרה בענין גאולה העתידה,"
        },
        {
          "s": 7,
          "text": "ואוכלים סעודת משיח,"
        },
        {
          "s": 8,
          "text": "וזה בא בהמשך לשביעי של פסח5,"
        },
        {
          "s": 9,
          "text": "קי\"ס,"
        },
        {
          "s": 10,
          "text": "שעי\"ז נעשה עוד יותר החיבור דקי\"ס עם הגילוי דגאולה העתידה."
        },
        {
          "s": 11,
          "text": "ומכיון שסמיכות זו היא חלק מתורה שהיא ירושה לכאו\"א מישראל כמ\"ש6"
        },
        {
          "s": 12,
          "text": "תורה צוה לנו משה מורשה קהלת יעקב,"
        },
        {
          "s": 13,
          "text": "ישנו הכח לכאו\"א מישראל,"
        },
        {
          "s": 14,
          "text": "אנשים נשים וטף,"
        },
        {
          "s": 15,
          "text": "לבוא מקי\"ס,"
        },
        {
          "s": 16,
          "text": "תיכף ומיד ממש לגאולה העתידה,"
        },
        {
          "s": 17,
          "text": "ללא עיכוב אפילו כהרף עין7."
        },
        {
          "s": 18,
          "text": "וזה שבכחו של כאו\"א מישראל לבוא תיכף להגילוי דגאולה העתידה מודגש גם במ\"ש"
        },
        {
          "s": 19,
          "text": "(בההפטרה דאחרון של פסח)"
        },
        {
          "s": 20,
          "text": "ונחה עליו רוח הוי' וגו'8,"
        },
        {
          "s": 21,
          "text": "דעליו קאי על משיח"
        },
        {
          "s": 22,
          "text": "(ויצא חוטר מגזע ישי גו'9),"
        },
        {
          "s": 23,
          "text": "ואעפ\"כ תקנו שכל אחד מישראל יאמר ביו\"ט"
        },
        {
          "s": 24,
          "text": "(בהתפלה שאומרים בעת פתיחת הארון)"
        },
        {
          "s": 25,
          "text": "ויתקיים בנו מקרא שכתוב ונחה עליו רוח הוי' וגו',"
        },
        {
          "s": 26,
          "text": "היינו שבכ\"א מישראל"
        },
        {
          "s": 27,
          "text": "(בתור פרט)"
        },
        {
          "s": 28,
          "text": "יהי' הגילוי ובאופן דונחה עליו רוח הוי' וגו' עם כל הפרטים שבכתובים אלה,"
        },
        {
          "s": 29,
          "text": "כולל גם והניף ידו על הנהר וגו'."
        }
      ]
    }
  ]
}