{
  "globalIndex": 157,
  "owner": 7,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914597_theRebbe_351__p004",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914597_theRebbe_351__p004",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914597_theRebbe_351",
  "title": "מאמר אלה תולדות נח תנש\"א",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דהטעם שענין זה נאמר גבי נח,"
        },
        {
          "s": 2,
          "text": "הוא,"
        },
        {
          "s": 3,
          "text": "כי נח שייך לתשובה"
        },
        {
          "s": 4,
          "text": "[דעבודתו של נח גרמה לאמירת ה' לא אוסיף גו' לא ישבותו47],"
        },
        {
          "s": 5,
          "text": "דע\"י התשובה הוא גילוי עצם הנשמה48."
        },
        {
          "s": 6,
          "text": "ולכן נאמר בו נח נח שתי פעמים,"
        },
        {
          "s": 7,
          "text": "ענין אחד שכולל שני הענינים דנייחא לעליונים ונייחא לתחתונים."
        },
        {
          "s": 8,
          "text": "ויש לקשר זה עם פירוש הידוע49"
        },
        {
          "s": 9,
          "text": "בלשון רז\"ל50"
        },
        {
          "s": 10,
          "text": "תשובה ומעשים טובים,"
        },
        {
          "s": 11,
          "text": "שע\"י התשובה נעשים המעשים"
        },
        {
          "s": 12,
          "text": "(מעשה המצוות)"
        },
        {
          "s": 13,
          "text": "מעשים טובים ומאירים51,"
        },
        {
          "s": 14,
          "text": "דמעשים הוא גוף המצוה וטובים הוא האור והחיות דהמצוה"
        },
        {
          "s": 15,
          "text": "(כוונת המצוות),"
        },
        {
          "s": 16,
          "text": "וע\"י התשובה,"
        },
        {
          "s": 17,
          "text": "שעל ידה הוא גילוי עצם הנשמה,"
        },
        {
          "s": 18,
          "text": "המעשים"
        },
        {
          "s": 19,
          "text": "(דהמצוות)"
        },
        {
          "s": 20,
          "text": "עצמם הם טובים ומאירים,"
        },
        {
          "s": 21,
          "text": "שמאיר בהם בגילוי הכוונה שמצד עצם הנשמה."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ויהי רצון,"
        },
        {
          "s": 2,
          "text": "דכיון שנמצאים כעת בסעודה שלישית דשבת ששייכת למנחת שבת,"
        },
        {
          "s": 3,
          "text": "ובפרט שהקריאה בתורה דמנחת שבת זה היא אלה תולדות נח נח,"
        },
        {
          "s": 4,
          "text": "תהי' מנוחה מכל הענינים המבלבלים לעבודת ה',"
        },
        {
          "s": 5,
          "text": "הן בנוגע לעניני הגוף והן בנוגע לעניני הנשמה,"
        },
        {
          "s": 6,
          "text": "וכנ\"ל"
        },
        {
          "s": 7,
          "text": "(סעיף ג)"
        },
        {
          "s": 8,
          "text": "שהמנוחה דמנחת שבת כוללת שני הענינים."
        },
        {
          "s": 9,
          "text": "וכיון שאת העולם נתן בלבו של האדם52,"
        },
        {
          "s": 10,
          "text": "עי\"ז תומשך המנוחה גם בכל העולמות,"
        },
        {
          "s": 11,
          "text": "נייחא לעליונים ונייחא לתחתונים"
        },
        {
          "s": 12,
          "text": "(כנ\"ל סעיף א)."
        },
        {
          "s": 13,
          "text": "ויתירה מזו,"
        },
        {
          "s": 14,
          "text": "דכמו שנח ראה עולם חדש53"
        },
        {
          "s": 15,
          "text": "(דנוסף לזה שהי' נייחא בכל העולמות,"
        },
        {
          "s": 16,
          "text": "נעשה גם חידוש בעולם),"
        },
        {
          "s": 17,
          "text": "כן נזכה בקרוב ממש לעולם חדש,"
        },
        {
          "s": 18,
          "text": "השמים החדשים והארץ החדשה54,"
        },
        {
          "s": 19,
          "text": "ובפרט לאחרי הקריאה בתורה"
        },
        {
          "s": 20,
          "text": "(בשחרית)"
        },
        {
          "s": 21,
          "text": "בראשית ברא אלקים את השמים ואת הארץ55,"
        },
        {
          "s": 22,
          "text": "שעי\"ז פועלים שהקב\"ה בורא מחדש את השמים ואת הארץ וכל צבאיהם."
        },
        {
          "s": 23,
          "text": "ובקרוב ממש יהי' בנין בית המקדש השלישי שכנגד יעקב56,"
        },
        {
          "s": 24,
          "text": "שבו נכללים גם ביהמ\"ק הראשון והשני57"
        },
        {
          "s": 25,
          "text": "שכנגד אברהם ויצחק56"
        },
        {
          "s": 26,
          "text": "– בדוגמת מנחת שבת וסעודה השלישית דשבת,"
        },
        {
          "s": 27,
          "text": "נחלת יעקב58,"
        },
        {
          "s": 28,
          "text": "הכוללת גם שתי השבתות דמעלי שבתא ודיומא דשבתא."
        },
        {
          "s": 29,
          "text": "ועוד ועיקר,"
        },
        {
          "s": 30,
          "text": "שכל זה יהי' בקרוב ממש,"
        },
        {
          "s": 31,
          "text": "ממש."
        }
      ]
    }
  ]
}