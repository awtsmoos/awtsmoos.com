{
  "globalIndex": 172,
  "owner": 22,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914779_theRebbe_200__p001",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914779_theRebbe_200__p001",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518914779_theRebbe_200",
  "title": "מאמר מים רבים תשל\"ח",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "מוצאי ש\"פ נח – בחדרו – ה'תשל\"ח"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "מים רבים לא יוכלו לכבות את האהבה ונהרות לא ישטפוה גו'1,"
        },
        {
          "s": 1,
          "text": "ואיתא בדרושי רבותינו נשיאינו2,"
        },
        {
          "s": 2,
          "text": "שמים רבים הם כל טרדות הפרנסה והמחשבות שבעניני עולם הזה,"
        },
        {
          "s": 3,
          "text": "ועכ\"ז לא יוכלו לכבות את האהבה המסותרת שיש בכל נפש מישראל,"
        },
        {
          "s": 4,
          "text": "ונהרות לא ישטפוה,"
        },
        {
          "s": 5,
          "text": "שגם כאשר מחשבות הנ\"ל הם מטרידות ביותר,"
        },
        {
          "s": 6,
          "text": "עד שהן משוטטות במרוצה בתמידות בלי הפסק כלל,"
        },
        {
          "s": 7,
          "text": "כמו הנהרות3"
        },
        {
          "s": 8,
          "text": "שנובעים תמיד בלי הפסק וניידי ואזלי בשטף גדול4,"
        },
        {
          "s": 9,
          "text": "מ\"מ לא ישטפוה להאהבה"
        },
        {
          "s": 10,
          "text": "(ולא יוכלו לכבותה5)."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "וביאור דיוק הלשון \"טרדות הפרנסה\","
        },
        {
          "s": 2,
          "text": "הנה כתיב6"
        },
        {
          "s": 3,
          "text": "יגיע כפיך כי תאכל גו',"
        },
        {
          "s": 4,
          "text": "וידוע הדיוק בזה7,"
        },
        {
          "s": 5,
          "text": "יגיע כפיך דוקא אבל לא יגיעת המוח והלב."
        },
        {
          "s": 6,
          "text": "והיינו דהגם אשר"
        },
        {
          "s": 7,
          "text": "(מצד זה שהשפע בעוה\"ז נמשכת דרך לבוש הטבע8)"
        },
        {
          "s": 8,
          "text": "צריך להיות עשי' שבזה תתלבש השפע שלמעלה,"
        },
        {
          "s": 9,
          "text": "וכמ\"ש9"
        },
        {
          "s": 10,
          "text": "וברכך הוי' אלקיך בכל אשר תעשה"
        },
        {
          "s": 11,
          "text": "(דוקא),"
        },
        {
          "s": 12,
          "text": "ועד שלפעמים"
        },
        {
          "s": 13,
          "text": "(מצד גודל ההעלם וההסתר10)"
        },
        {
          "s": 14,
          "text": "צריכים גם ליגיעה,"
        },
        {
          "s": 15,
          "text": "מ\"מ אין צריך להעסיק בעשי' זו כ\"א רק את כחות החיצונים שלו,"
        },
        {
          "s": 16,
          "text": "יגיע כפיך"
        },
        {
          "s": 17,
          "text": "[כפים ושארי אברים החיצונים11],"
        },
        {
          "s": 18,
          "text": "אבל לא את כחות הפנימיים והנעלים"
        },
        {
          "s": 19,
          "text": "(שבמוח ולב),"
        },
        {
          "s": 20,
          "text": "כי כחות אלו צריכים להיות מוקדשים לשמש את קונו,"
        },
        {
          "s": 21,
          "text": "שזהו תכלית בריאתו12."
        },
        {
          "s": 22,
          "text": "והגם שמכיון שהשפע מתעלם ומסתתר בלבושי הטבע צריך להשתמש גם בשכלו לצורך העסק,"
        },
        {
          "s": 23,
          "text": "הוא רק מה שמוכרח להעשי',"
        },
        {
          "s": 24,
          "text": "אבל לא באופן דיגיעה בהתחכמות ותחבולות."
        },
        {
          "s": 25,
          "text": "ובפרט שברכת הוי' היא תעשיר13,"
        },
        {
          "s": 26,
          "text": "והעסק אינו אלא לבוש לברכת הוי'"
        },
        {
          "s": 27,
          "text": "(ולא שהעסק הוא מקור פרנסתו ח\"ו),"
        },
        {
          "s": 28,
          "text": "הרי מובן14,"
        },
        {
          "s": 29,
          "text": "שבדוגמת הלבושים בפשטות \"המרבה בלבושים לא העדיף מאומה,"
        },
        {
          "s": 30,
          "text": "ואדרבה15"
        },
        {
          "s": 31,
          "text": "מקלקל יותר\"16."
        },
        {
          "s": 32,
          "text": "וזהו דיוק הלשון \"טרדות הפרנסה\","
        },
        {
          "s": 33,
          "text": "דהגם שהוא במצב נמוך שיש לו טרדות הפרנסה"
        },
        {
          "s": 34,
          "text": "[שזה מראה אשר אינו מתבונן כדבעי אליבי' דנפשי' שברכת הוי' היא תעשיר17],"
        },
        {
          "s": 35,
          "text": "מ\"מ,"
        },
        {
          "s": 36,
          "text": "הנה גם הטרדות לא יוכלו לכבות ח\"ו את האהבה המסותרת שבכ\"א מישראל."
        }
      ]
    }
  ]
}