{
  "globalIndex": 573,
  "owner": 23,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917024_theRebbe_166__p004",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917024_theRebbe_166__p004",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518917024_theRebbe_166",
  "title": "מאמר בחודש השלישי תשל\"ד",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "וזהו43 בחודש השלישי גו' ביום הזה באו מדבר סיני,"
        },
        {
          "s": 2,
          "text": "מדבר מלשון דיבור,"
        },
        {
          "s": 3,
          "text": "ונק' מדבר בתוספת מ' להורות שהדיבור הוא בביטול כעונה אחר הקורא"
        },
        {
          "s": 4,
          "text": "(כמבואר בארוכה בהדרושים),"
        },
        {
          "s": 5,
          "text": "ועי\"ז נעשה סיני שירדה שנאה לאומות העולם44."
        },
        {
          "s": 6,
          "text": "דכשלימוד התורה הוא בביטול אזי היא נעשית"
        },
        {
          "s": 7,
          "text": "(עוז לנפש האלקית ו)"
        },
        {
          "s": 8,
          "text": "תושי' לנפש הבהמית,"
        },
        {
          "s": 9,
          "text": "דבירדה שנאה לאומות העולם נכללים גם הגוף ונפש הבהמית45."
        },
        {
          "s": 10,
          "text": "[ולהעיר מתורת הבעש\"ט46"
        },
        {
          "s": 11,
          "text": "עה\"פ47"
        },
        {
          "s": 12,
          "text": "כי תראה חמור שונאך,"
        },
        {
          "s": 13,
          "text": "כאשר תסתכל בעיון טוב בהחומר שלך הוא הגוף,"
        },
        {
          "s": 14,
          "text": "תראה שהוא שונאך,"
        },
        {
          "s": 15,
          "text": "שהוא שונא את הנשמה]."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ולאח\"ז48 אומר ויסעו מרפידים,"
        },
        {
          "s": 2,
          "text": "רפידים הוא על שם שרפו ידיהם מדברי תורה49,"
        },
        {
          "s": 3,
          "text": "שאינו מנגד לתורה ואדרבא הוא לומד תורה,"
        },
        {
          "s": 4,
          "text": "אלא שהלימוד שלו הוא ברפיון וחלישות,"
        },
        {
          "s": 5,
          "text": "וע\"י העבודה דמדבר הוא מסיע את עצמו"
        },
        {
          "s": 6,
          "text": "(גם)"
        },
        {
          "s": 7,
          "text": "מהרפיון והחלישות בדברי תורה ועושה תשובה50"
        },
        {
          "s": 8,
          "text": "על זה."
        },
        {
          "s": 9,
          "text": "וממשיך בכתוב"
        },
        {
          "s": 10,
          "text": "(לאחרי שאומר ויסעו מרפידים)"
        },
        {
          "s": 11,
          "text": "ויבואו מדבר סיני גו' נגד ההר,"
        },
        {
          "s": 12,
          "text": "דזה שהי' תחלה ברפידים מביא אותו להתחזק51"
        },
        {
          "s": 13,
          "text": "בדברי תורה עוד יותר."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "ויש לומר,"
        },
        {
          "s": 3,
          "text": "דע\"י שלומדים בתורה פסוק זה עכשיו,"
        },
        {
          "s": 4,
          "text": "הנתינת כח על ויסעו מרפידים הוא עוד יותר."
        },
        {
          "s": 5,
          "text": "דבפעם הראשונה,"
        },
        {
          "s": 6,
          "text": "הנתינת כח על ויסעו מרפידים היתה ע\"י שבר\"ח סיון נשלמה ההכנה למ\"ת,"
        },
        {
          "s": 7,
          "text": "ועכשיו,"
        },
        {
          "s": 8,
          "text": "יש גם הנתינת כח ממתן תורה שבשנים שעברו,"
        },
        {
          "s": 9,
          "text": "ומלימוד התורה שלאחרי מתן תורה שעי\"ז מיתוסף בענין דמ\"ת"
        },
        {
          "s": 10,
          "text": "(כנ\"ל סעיף ו)."
        },
        {
          "s": 11,
          "text": "ובפרט שנמצאים ביום הט\"ו לחודש שבו קיימא סיהרא באשלימותא,"
        },
        {
          "s": 12,
          "text": "ובזה גופא – בט\"ו בשבט,"
        },
        {
          "s": 13,
          "text": "ראש השנה לאילן52,"
        },
        {
          "s": 14,
          "text": "ששייך לארץ טובה ורחבה – ישנה נתינת כח מיוחדת להוסיף בלימוד התורה ובקיום המצוות באופן דארץ טובה ורחבה,"
        },
        {
          "s": 15,
          "text": "ועד\"ז בנוגע לתשובה"
        },
        {
          "s": 16,
          "text": "(ויסעו מרפידים)"
        },
        {
          "s": 17,
          "text": "שתהי' באופן דארץ טובה ורחבה,"
        },
        {
          "s": 18,
          "text": "היינו תשובה עילאה שהיא בשמחה רבה53,"
        },
        {
          "s": 19,
          "text": "וכשישראל עושין תשובה מיד הן נגאלין54,"
        },
        {
          "s": 20,
          "text": "ואתם תלוקטו לאחד אחד בני ישראל55,"
        },
        {
          "s": 21,
          "text": "שהקב\"ה בעצמו56"
        },
        {
          "s": 22,
          "text": "מביאם לארץ טובה ורחבה כפשוטה,"
        },
        {
          "s": 23,
          "text": "בגאולה האמיתית והשלימה ע\"י משיח צדקנו,"
        },
        {
          "s": 24,
          "text": "בקרוב ממש."
        }
      ]
    }
  ]
}