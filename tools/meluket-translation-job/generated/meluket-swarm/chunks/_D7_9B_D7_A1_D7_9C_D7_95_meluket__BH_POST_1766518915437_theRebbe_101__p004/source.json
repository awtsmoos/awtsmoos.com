{
  "globalIndex": 292,
  "owner": 42,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915437_theRebbe_101__p004",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915437_theRebbe_101__p004",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915437_theRebbe_101",
  "title": "מאמר אשר ברא תשל\"ט",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וביאור הענין,"
        },
        {
          "s": 2,
          "text": "הנה ידוע שהסיבה לבריאת העולם וכל סדר ההשתלשלות הוא החסד שבאוא\"ס,"
        },
        {
          "s": 3,
          "text": "כמבואר בארוכה בד\"ה אתה אחד לאדמו\"ר האמצעי54"
        },
        {
          "s": 4,
          "text": "ובכמה דרושים שלו."
        },
        {
          "s": 5,
          "text": "וענין החסד שבאוא\"ס הוא כללות ענין הגילוי,"
        },
        {
          "s": 6,
          "text": "וכמו שמבאר אדמו\"ר הצ\"צ ברשימותיו לתהלים55"
        },
        {
          "s": 7,
          "text": "עה\"פ56"
        },
        {
          "s": 8,
          "text": "א-ל אלקים הוי' דיבר ויקרא ארץ,"
        },
        {
          "s": 9,
          "text": "ששמות אלה ישנם גם לפני הצמצום,"
        },
        {
          "s": 10,
          "text": "א-ל"
        },
        {
          "s": 11,
          "text": "(חסד)"
        },
        {
          "s": 12,
          "text": "מורה על התחלת גילוי האור"
        },
        {
          "s": 13,
          "text": "(מה שהי' ממלא מקום החלל57)."
        },
        {
          "s": 14,
          "text": "ולכן שם א-ל קדם לשם אלקים,"
        },
        {
          "s": 15,
          "text": "כי תחלה הו\"ע הגילוי והוא שרש וסיבת ההתהוות,"
        },
        {
          "s": 16,
          "text": "ולאח\"ז"
        },
        {
          "s": 17,
          "text": "(בכדי שיהי' אפשר להיות התהוותם בפועל)"
        },
        {
          "s": 18,
          "text": "הי' הצמצום,"
        },
        {
          "s": 19,
          "text": "אלקים."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "וגם בההתהוות עצמה שבה קדם הצמצום וכמרז\"ל58"
        },
        {
          "s": 1,
          "text": "בתחלה עלה במחשבה לברוא את העולם במדת הדין,"
        },
        {
          "s": 2,
          "text": "הנה נוסף לזה שהצמצום הוא בשביל הגילוי"
        },
        {
          "s": 3,
          "text": "(כמבואר בהמשך תער\"ב59"
        },
        {
          "s": 4,
          "text": "ובכ\"מ),"
        },
        {
          "s": 5,
          "text": "הנה גם הצמצום גופא הוא מצד החסד,"
        },
        {
          "s": 6,
          "text": "וכמו שמבאר הרב המגיד60"
        },
        {
          "s": 7,
          "text": "שהצמצום שלמעלה הוא כמו אב המצמצם את שכלו כו' בשביל בנו הקטן כו' האהבה גרמה את הצמצום."
        },
        {
          "s": 8,
          "text": "היינו שהצמצום הוא בכדי שהאור יומשך ויתקבל בהתחתונים,"
        },
        {
          "s": 9,
          "text": "ועד שיומשך בהם גילוי אור נעלה יותר מהאור שהאיר בגילוי קודם הצמצום61."
        },
        {
          "s": 10,
          "text": "ועד שיהי' דירה לו ית',"
        },
        {
          "s": 11,
          "text": "לו לעצמותו"
        },
        {
          "s": 12,
          "text": "[בדוגמת דירת האדם,"
        },
        {
          "s": 13,
          "text": "שעצמות האדם דר בהדירה]62,"
        },
        {
          "s": 14,
          "text": "ושהעצמות יהי' בהם בגילוי כמ\"ש63"
        },
        {
          "s": 15,
          "text": "ולא יכנף עוד מוריך."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה הסיבה לבנין החסד"
        },
        {
          "s": 2,
          "text": "(בכדי שיהי' התהוות העולם)"
        },
        {
          "s": 3,
          "text": "היא כי חפץ חסד הוא64."
        },
        {
          "s": 4,
          "text": "והענין דחפץ חסד הוא למעלה מחסד"
        },
        {
          "s": 5,
          "text": "(לא רק מחסד כמו שהוא במדות אלא למעלה גם משרשו כמו שהוא במוחין וכו'),"
        },
        {
          "s": 6,
          "text": "כי ענינו הוא חפץ,"
        },
        {
          "s": 7,
          "text": "רצון ותענוג,"
        },
        {
          "s": 8,
          "text": "אלא שהחפץ הוא שיהי' חסד65."
        },
        {
          "s": 9,
          "text": "וחפץ זה הוא הסיבה לבנין החסד שממנו נבנה העולם."
        },
        {
          "s": 10,
          "text": "ויש לומר,"
        },
        {
          "s": 11,
          "text": "דחתן מלשון חות דרגא הוא בחי' חפץ"
        },
        {
          "s": 12,
          "text": "(חסד)"
        },
        {
          "s": 13,
          "text": "שלמעלה מחסד."
        },
        {
          "s": 14,
          "text": "דזה שנתעורר ברצון וחפץ שיהי' חסד הוא ירידה"
        },
        {
          "s": 15,
          "text": "(חות דרגא)"
        },
        {
          "s": 16,
          "text": "לגבי עצמות אוא\"ס."
        },
        {
          "s": 17,
          "text": "[ויש לומר דזהו מ\"ש בהמאמר66"
        },
        {
          "s": 18,
          "text": "שחתן הוא התקשרות,"
        },
        {
          "s": 19,
          "text": "והוא מה שאוא\"ס התקשר כביכול לברוא את העולם,"
        },
        {
          "s": 20,
          "text": "דיש לומר,"
        },
        {
          "s": 21,
          "text": "שזה שאוא\"ס התקשר כביכול לברוא את העולם הו\"ע הרצון והחפץ]."
        },
        {
          "s": 22,
          "text": "וכיון שהירידה להיות חפץ חסד היא ירידה באין ערוך,"
        },
        {
          "s": 23,
          "text": "לכן שייך בזה לשון בריאה,"
        },
        {
          "s": 24,
          "text": "אשר ברא כו' חתן."
        },
        {
          "s": 25,
          "text": "ועפ\"ז יובן גם מה שבחתן נאמר לשון בריאה,"
        },
        {
          "s": 26,
          "text": "ובשם א-ל נאמר לשון יצירה"
        },
        {
          "s": 27,
          "text": "(לפני לא נוצר א-ל),"
        },
        {
          "s": 28,
          "text": "כי חפץ חסד"
        },
        {
          "s": 29,
          "text": "(שאינו אלא חפץ ורצון שיהי' חסד)"
        },
        {
          "s": 30,
          "text": "הוא למעלה מציור,"
        },
        {
          "s": 31,
          "text": "ולכן שייך בו רק הלשון בריאה,"
        },
        {
          "s": 32,
          "text": "משא\"כ בחסד"
        },
        {
          "s": 33,
          "text": "(שם א-ל בחסד),"
        },
        {
          "s": 34,
          "text": "גם כמו שהוא לפני הצמצום,"
        },
        {
          "s": 35,
          "text": "מכיון שהוא ציור"
        },
        {
          "s": 36,
          "text": "(של חסד),"
        },
        {
          "s": 37,
          "text": "שייך בזה לשון יצירה."
        }
      ]
    }
  ]
}