{
  "globalIndex": 747,
  "owner": 47,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918160_theRebbe_102__p002",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918160_theRebbe_102__p002",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518918160_theRebbe_102",
  "title": "מאמר ויאמר לו יהונתן תשכ\"ח",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר14,"
        },
        {
          "s": 2,
          "text": "דיהונתן הוא יה\"ו נתן,"
        },
        {
          "s": 3,
          "text": "ואיתא במאורי אור15"
        },
        {
          "s": 4,
          "text": "שנתן בגימטריא ת\"ק הוא ה' אחרונה דשם הוי',"
        },
        {
          "s": 5,
          "text": "כי ה' בהכאה בגימטריא ת\"ק."
        },
        {
          "s": 6,
          "text": "ומדייק בהמאמר,"
        },
        {
          "s": 7,
          "text": "דלהפירוש שברוב המקומות שיהונתן הוא יה\"ו"
        },
        {
          "s": 8,
          "text": "[ונתן"
        },
        {
          "s": 9,
          "text": "(שביהונתן)"
        },
        {
          "s": 10,
          "text": "הוא שהיה\"ו הם בבחינת נתינה והמשכה16]"
        },
        {
          "s": 11,
          "text": "מובן מ\"ש ויאמר לו."
        },
        {
          "s": 12,
          "text": "יהונתן,"
        },
        {
          "s": 13,
          "text": "ההמשכה מיהונתן לדוד,"
        },
        {
          "s": 14,
          "text": "שהיה\"ו דיהונתן נמשכו למלכות,"
        },
        {
          "s": 15,
          "text": "דוד."
        },
        {
          "s": 16,
          "text": "אבל לפירוש המאו\"א דנתן שביהונתן הוא ה' אחרונה,"
        },
        {
          "s": 17,
          "text": "היא המלכות,"
        },
        {
          "s": 18,
          "text": "מהו\"ע ויאמר לו."
        },
        {
          "s": 19,
          "text": "יהונתן"
        },
        {
          "s": 20,
          "text": "(המשכת יהונתן לדוד),"
        },
        {
          "s": 21,
          "text": "הרי נתן דיהונתן ודוד הם לכאורה היינו הך."
        },
        {
          "s": 22,
          "text": "ומבאר,"
        },
        {
          "s": 23,
          "text": "דבמלכות שתי מדריגות."
        },
        {
          "s": 24,
          "text": "כמו שהיא סוף האצילות"
        },
        {
          "s": 25,
          "text": "(זנב לאריות17),"
        },
        {
          "s": 26,
          "text": "וכמו שהיא מקור לבי\"ע"
        },
        {
          "s": 27,
          "text": "(ראש לשועלים17)."
        },
        {
          "s": 28,
          "text": "וזהו החילוק בין נתן"
        },
        {
          "s": 29,
          "text": "(דיהונתן)"
        },
        {
          "s": 30,
          "text": "לדוד,"
        },
        {
          "s": 31,
          "text": "דנתן שהוא ה' אחרונה דשם הוי'"
        },
        {
          "s": 32,
          "text": "(כנ\"ל)"
        },
        {
          "s": 33,
          "text": "הוא המלכות כמו שהיא סוף האצילות,"
        },
        {
          "s": 34,
          "text": "ודוד הוא המלכות כמו שהיא מקור לבי\"ע."
        },
        {
          "s": 35,
          "text": "וענין ויאמר לו יהונתן הוא המשכת המלכות כמו שהיא באצילות"
        },
        {
          "s": 36,
          "text": "(נתן,"
        },
        {
          "s": 37,
          "text": "ה' אחרונה."
        },
        {
          "s": 38,
          "text": "ועי\"ז – גם המשכת יה\"ו)"
        },
        {
          "s": 39,
          "text": "בהמלכות שהיא מקור לבי\"ע"
        },
        {
          "s": 40,
          "text": "(דוד)."
        },
        {
          "s": 41,
          "text": "ומוסיף בהמאמר,"
        },
        {
          "s": 42,
          "text": "דשתי הבחינות שבמלכות נק' בשם ים וארץ."
        },
        {
          "s": 43,
          "text": "ים18"
        },
        {
          "s": 44,
          "text": "הוא המלכות כמו שהיא באצילות,"
        },
        {
          "s": 45,
          "text": "שבה נמשכים הספירות דז\"א שלמעלה מהמלכות – כל הנחלים הולכים אל הים19."
        },
        {
          "s": 46,
          "text": "וע\"י שהמלכות מקבלת וכונסת בתוכה את הספירות שלמעלה ממנה – היא מעלמת עליהם,"
        },
        {
          "s": 47,
          "text": "כדוגמת הים שהוא מכסה על מה שבתוכו."
        },
        {
          "s": 48,
          "text": "ועי\"ז20"
        },
        {
          "s": 49,
          "text": "נמשכת המלכות להיות מקור להוות הנבראים – בחינת ארץ,"
        },
        {
          "s": 50,
          "text": "תדשא הארץ גו' תצא הארץ גו'21."
        },
        {
          "s": 51,
          "text": "ומבאר,"
        },
        {
          "s": 52,
          "text": "דענין ויאמר לו יהונתן הוא כענין הפך ים ליבשה22"
        },
        {
          "s": 53,
          "text": "שהי' בקריעת ים סוף."
        },
        {
          "s": 54,
          "text": "היינו,"
        },
        {
          "s": 55,
          "text": "דנוסף להמשכת המלכות כמו שהיא באצילות"
        },
        {
          "s": 56,
          "text": "(נתן,"
        },
        {
          "s": 57,
          "text": "ה' אחרונה)"
        },
        {
          "s": 58,
          "text": "שנמשכה בבחינת המלכות כמו שהיא מקור לבי\"ע"
        },
        {
          "s": 59,
          "text": "(דוד),"
        },
        {
          "s": 60,
          "text": "הי' גם הענין דהפיכת ים ליבשה,"
        },
        {
          "s": 61,
          "text": "שנבקע ההעלם"
        },
        {
          "s": 62,
          "text": "(ים)"
        },
        {
          "s": 63,
          "text": "ונתגלו האורות דהספירות דאצילות"
        },
        {
          "s": 64,
          "text": "(שבמלכות)"
        },
        {
          "s": 65,
          "text": "כמו שהם בעצמותם."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "וממשיך בהמאמר14,"
        },
        {
          "s": 1,
          "text": "דלאחרי שדוד קיבל מאמר ודברי יהונתן"
        },
        {
          "s": 2,
          "text": "(היינו שנמשכו בו עצמיות האורות דאצילות),"
        },
        {
          "s": 3,
          "text": "אז23"
        },
        {
          "s": 4,
          "text": "אמר לו24"
        },
        {
          "s": 5,
          "text": "ושלשת תרד מאד,"
        },
        {
          "s": 6,
          "text": "ושלשת הוא25"
        },
        {
          "s": 7,
          "text": "שתיעשה בחינת סגול"
        },
        {
          "s": 8,
          "text": "(שיש בו ג' נקודות)"
        },
        {
          "s": 9,
          "text": "שרומז על עבודת הבירורים26"
        },
        {
          "s": 10,
          "text": "(היינו ירידת המלכות למטה לברר בירורים),"
        },
        {
          "s": 11,
          "text": "ועי\"ז יהי' ושלשת,"
        },
        {
          "s": 12,
          "text": "בחינת סגולתא"
        },
        {
          "s": 13,
          "text": "(שגם בסגולתא יש ג' נקודות),"
        },
        {
          "s": 14,
          "text": "בחינת סגולה."
        },
        {
          "s": 15,
          "text": "כמ\"ש27"
        },
        {
          "s": 16,
          "text": "והייתם לי סגולה מכל העמים,"
        },
        {
          "s": 17,
          "text": "דע\"י הבירור שמבררים מכל העמים,"
        },
        {
          "s": 18,
          "text": "עי\"ז והייתם לי סגולה."
        },
        {
          "s": 19,
          "text": "ולכאורה,"
        },
        {
          "s": 20,
          "text": "זה שאמר יהונתן לדוד ושלשת תרד מאד"
        },
        {
          "s": 21,
          "text": "[שע\"י הירידה לבחינת סגול לברר בירורים28"
        },
        {
          "s": 22,
          "text": "יתעלה לבחינת סגולתא וסגולה],"
        },
        {
          "s": 23,
          "text": "הוא בכללות ענין אחד עם זה שאמר לו תחלה ונפקדת כי יפקד מושבך,"
        },
        {
          "s": 24,
          "text": "דע\"י שיפקד מושבך"
        },
        {
          "s": 25,
          "text": "(ירידה והסתר)"
        },
        {
          "s": 26,
          "text": "יהי' ונפקדת."
        },
        {
          "s": 27,
          "text": "[אלא שבתחילה אמר לו הענין בכללות,"
        },
        {
          "s": 28,
          "text": "ואח\"כ הוסיף בזה פרטים,"
        },
        {
          "s": 29,
          "text": "הן בנוגע להירידה – ושלשת תרד מאד גו' וישבת אצל האבן האזל,"
        },
        {
          "s": 30,
          "text": "הירידה בעולם העשי'29,"
        },
        {
          "s": 31,
          "text": "והן בנוגע להעלי' שע\"י הירידה – ושלשת,"
        },
        {
          "s": 32,
          "text": "שיתעלה לבחינת סגולתא וסגולה]."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "וצריך להבין מה שהתחלת ההפטורה דמחר חודש הוא ויאמר לו יהונתן,"
        },
        {
          "s": 2,
          "text": "דלכאורה,"
        },
        {
          "s": 3,
          "text": "הרי תוכן ההפטורה דמחר חודש הוא,"
        },
        {
          "s": 4,
          "text": "שבכדי שיהי' מולד הלבנה"
        },
        {
          "s": 5,
          "text": "(מלכות)"
        },
        {
          "s": 6,
          "text": "צריך להיות תחלה"
        },
        {
          "s": 7,
          "text": "(בערב ר\"ח)"
        },
        {
          "s": 8,
          "text": "הירידה וההסתר"
        },
        {
          "s": 9,
          "text": "(יפקד מושבך,"
        },
        {
          "s": 10,
          "text": "תרד מאד גו' אצל האבן האזל),"
        },
        {
          "s": 11,
          "text": "וענין ויאמר לו יהונתן שבתחילת ההפטורה הוא"
        },
        {
          "s": 12,
          "text": "(אדרבה)"
        },
        {
          "s": 13,
          "text": "תכלית השלימות דהמלכות"
        },
        {
          "s": 14,
          "text": "(מקור דבי\"ע),"
        },
        {
          "s": 15,
          "text": "שמאיר בה בגילוי בחינת המלכות דאצילות וגם המדות דז\"א"
        },
        {
          "s": 16,
          "text": "(כנ\"ל סעיף ב)."
        },
        {
          "s": 17,
          "text": "ונקודת הביאור בזה,"
        },
        {
          "s": 18,
          "text": "שבכדי שיהי' הענין דיפקד מושבך"
        },
        {
          "s": 19,
          "text": "[ובאופן שעי\"ז יהי' ונפקדת]"
        },
        {
          "s": 20,
          "text": "הוא על ידי המשכה מלמעלה."
        },
        {
          "s": 21,
          "text": "וזהו שהתחלת ההפטורה"
        },
        {
          "s": 22,
          "text": "[עוד לפני שאומרים התיבות מחר חודש]"
        },
        {
          "s": 23,
          "text": "היא ויאמר לו יהונתן,"
        },
        {
          "s": 24,
          "text": "שבתחילה נמשך במלכות"
        },
        {
          "s": 25,
          "text": "(מקור דבי\"ע)"
        },
        {
          "s": 26,
          "text": "האורות דאצילות,"
        },
        {
          "s": 27,
          "text": "ועי\"ז30"
        },
        {
          "s": 28,
          "text": "אפשר להיות אח\"כ ענין מחר חודש31"
        },
        {
          "s": 29,
          "text": "– הירידה וההסתר דהלבנה,"
        },
        {
          "s": 30,
          "text": "יפקד מושבך"
        },
        {
          "s": 31,
          "text": "(ענין ערב ראש חודש,"
        },
        {
          "s": 32,
          "text": "מחר חודש),"
        },
        {
          "s": 33,
          "text": "ולאחרי זה"
        },
        {
          "s": 34,
          "text": "(בראש חודש)"
        },
        {
          "s": 35,
          "text": "– ונפקדת."
        }
      ]
    }
  ]
}