{
  "globalIndex": 274,
  "owner": 24,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915360_theRebbe_171__p003",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915360_theRebbe_171__p003",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915360_theRebbe_171",
  "title": "מאמר פדה בשלום תשמ\"א",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וע\"פ כל הנ\"ל יש לבאר,"
        },
        {
          "s": 2,
          "text": "דהגם שענין פדה בשלום הי' גם בימי שלמה,"
        },
        {
          "s": 3,
          "text": "מ\"מ,"
        },
        {
          "s": 4,
          "text": "השלימות שבזה יהי' בימות המשיח,"
        },
        {
          "s": 5,
          "text": "ובימות המשיח גופא בתקופה הב',"
        },
        {
          "s": 6,
          "text": "דיש לומר,"
        },
        {
          "s": 7,
          "text": "שג' דרגות אלו בשלום"
        },
        {
          "s": 8,
          "text": "(בימי שלמה,"
        },
        {
          "s": 9,
          "text": "בתקופה הא' דימות המשיח ובתקופה הב')"
        },
        {
          "s": 10,
          "text": "הם דוגמת ג' הדרגות הנ\"ל שבתורה."
        },
        {
          "s": 11,
          "text": "והענין הוא,"
        },
        {
          "s": 12,
          "text": "דזה שמלכת שבא שמעה את שמע שלמה הוא ע\"י ששמו"
        },
        {
          "s": 13,
          "text": "(דשם הוא הארה)"
        },
        {
          "s": 14,
          "text": "נמשך ונתפשט למרחקים עד לארץ שבא,"
        },
        {
          "s": 15,
          "text": "ששלמה עצמו הי' במקומו והשם שלו"
        },
        {
          "s": 16,
          "text": "(שמע שלמה)"
        },
        {
          "s": 17,
          "text": "נמשך והגיע לשבא,"
        },
        {
          "s": 18,
          "text": "וכל מה שההמשכה נמשכה למקום רחוק יותר היא מתקטנת יותר."
        },
        {
          "s": 19,
          "text": "ועד\"ז גם בנוגע להבירור גופא,"
        },
        {
          "s": 20,
          "text": "דגם לאחרי שמלכת שבא שמעה את שמע שלמה,"
        },
        {
          "s": 21,
          "text": "הוצרך להיות ותבוא ירושלמה35"
        },
        {
          "s": 22,
          "text": "(שההליכה משבא לירושלים לוקח משך זמן וטרחא כו'),"
        },
        {
          "s": 23,
          "text": "ורק אז נעשה הבירור"
        },
        {
          "s": 24,
          "text": "(בדוגמת הבירור שע\"י גליא דתורה)."
        },
        {
          "s": 25,
          "text": "משא\"כ הבירור שיהי' בימות המשיח,"
        },
        {
          "s": 26,
          "text": "כיון שאז36"
        },
        {
          "s": 27,
          "text": "יהי' הגילוי דאוא\"ס הבל\"ג שקודם הצמצום,"
        },
        {
          "s": 28,
          "text": "דאור זה הוא בכל מקום בשוה37,"
        },
        {
          "s": 29,
          "text": "לכן יהי' אז הבירור"
        },
        {
          "s": 30,
          "text": "(לא באופן של המשכת וירידת האור למטה,"
        },
        {
          "s": 31,
          "text": "והעלאת המתברר למעלה,"
        },
        {
          "s": 32,
          "text": "כי אם)"
        },
        {
          "s": 33,
          "text": "שהאור כמו שהוא יאיר בכל מקום,"
        },
        {
          "s": 34,
          "text": "שלכן אז38"
        },
        {
          "s": 35,
          "text": "אהפוך אל עמים"
        },
        {
          "s": 36,
          "text": "(כמו שהם במציאותם ובמקומם)"
        },
        {
          "s": 37,
          "text": "גו' כולם גו' לעבדו שכם אחד."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "אלא שבזה גופא יש חילוק בין תקופה ראשונה לתקופה השני'."
        },
        {
          "s": 1,
          "text": "דבתקופה הראשונה לא יהי' חידוש במע\"ב,"
        },
        {
          "s": 2,
          "text": "הגילוי אלקות שיהי' בהעולם יהי' מצד גילוי אוא\"ס הבל\"ג שמאיר בכל מקום,"
        },
        {
          "s": 3,
          "text": "אבל לא מצד העולם גופא,"
        },
        {
          "s": 4,
          "text": "מכיון שעולם כמנהגו נוהג."
        },
        {
          "s": 5,
          "text": "ולכן יהי' אז הגילוי דהנבראים"
        },
        {
          "s": 6,
          "text": "(והביטול שלהם)"
        },
        {
          "s": 7,
          "text": "כמו דבר נוסף על מציאותם."
        },
        {
          "s": 8,
          "text": "[וע\"ד39"
        },
        {
          "s": 9,
          "text": "ההבנה וההשגה דפנימיות התורה,"
        },
        {
          "s": 10,
          "text": "שהיא כמו דבר נוסף על האדם,"
        },
        {
          "s": 11,
          "text": "שלכן שייך בזה שינוי או חלישות עכ\"פ,"
        },
        {
          "s": 12,
          "text": "כנ\"ל]."
        },
        {
          "s": 13,
          "text": "משא\"כ בתקופה השני' דימות המשיח שיהי' שינוי וחידוש במע\"ב,"
        },
        {
          "s": 14,
          "text": "יש לומר,"
        },
        {
          "s": 15,
          "text": "שהגילוי בעולם"
        },
        {
          "s": 16,
          "text": "(והביטול בהנבראים)"
        },
        {
          "s": 17,
          "text": "יהי' גם מצד טבע וגדר העולם גופא."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "והנה ג' פירושים"
        },
        {
          "s": 2,
          "text": "(ודרגות)"
        },
        {
          "s": 3,
          "text": "הנ\"ל דפדה בשלום נפשי,"
        },
        {
          "s": 4,
          "text": "כיון שכל הפירושים הם באותו הפסוק,"
        },
        {
          "s": 5,
          "text": "הם שייכים זל\"ז40,"
        },
        {
          "s": 6,
          "text": "ובאים בהמשך אחד."
        },
        {
          "s": 7,
          "text": "דנוסף על זה שכל הדרגות הם תורה"
        },
        {
          "s": 8,
          "text": "[דכמו שבתפלה,"
        },
        {
          "s": 9,
          "text": "גם התפלה דשבת,"
        },
        {
          "s": 10,
          "text": "עם היות שהבירור דשבת הוא בדרך מנוחה41,"
        },
        {
          "s": 11,
          "text": "מ\"מ,"
        },
        {
          "s": 12,
          "text": "גם התפלה דשבת ענינה הוא תפלה,"
        },
        {
          "s": 13,
          "text": "עד\"ז הוא גם בנוגע לתורה,"
        },
        {
          "s": 14,
          "text": "שגם גליא דתורה שבבחי' התלבשות,"
        },
        {
          "s": 15,
          "text": "ענינה הוא תורה],"
        },
        {
          "s": 16,
          "text": "הנה כל הדרגות דתורה הם ענין אחד42,"
        },
        {
          "s": 17,
          "text": "תורה אחת."
        },
        {
          "s": 18,
          "text": "שלכן,"
        },
        {
          "s": 19,
          "text": "ע\"י לימוד התורה עכשיו"
        },
        {
          "s": 20,
          "text": "(גם הלימוד דנגלה שבתורה)"
        },
        {
          "s": 21,
          "text": "יזכו לתורתו של משיח דבחי' ראי',"
        },
        {
          "s": 22,
          "text": "כידוע בענין ותלמודו43"
        },
        {
          "s": 23,
          "text": "בידו44."
        }
      ]
    }
  ]
}