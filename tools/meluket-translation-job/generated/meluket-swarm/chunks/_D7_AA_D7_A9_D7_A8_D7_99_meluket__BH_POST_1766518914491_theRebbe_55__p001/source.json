{
  "globalIndex": 138,
  "owner": 38,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914491_theRebbe_55__p001",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914491_theRebbe_55__p001",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914491_theRebbe_55",
  "title": "מאמר להבין ענין שמח\"ת תשל\"ח",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "מוצאי שמחת תורה – בחדרו – ה'תשל\"ח"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "להבין ענין שמחת תורה,"
        },
        {
          "s": 1,
          "text": "וידוע הדיוק בזה1"
        },
        {
          "s": 2,
          "text": "מה שאופן השמחה"
        },
        {
          "s": 3,
          "text": "(דשמחת תורה)"
        },
        {
          "s": 4,
          "text": "הוא שלוקחים ספר תורה כפי שהיא כרוכה ומכוסה במפה2"
        },
        {
          "s": 5,
          "text": "ומרקדין עמה."
        },
        {
          "s": 6,
          "text": "דעם היות שבתורה כתיב3"
        },
        {
          "s": 7,
          "text": "כי היא חכמתכם ובינתכם גו' מ\"מ אופן שמחה זו הוא לא ע\"י לימוד ועיון כ\"א ע\"י ריקוד דוקא."
        },
        {
          "s": 8,
          "text": "שלכן השמחה דשמחת תורה היא אצל כל ישראל,"
        },
        {
          "s": 9,
          "text": "גם אצל פשוטים ביותר שאין שייכים להשגה והבנה"
        },
        {
          "s": 10,
          "text": "[ויתירה מזו,"
        },
        {
          "s": 11,
          "text": "שבעת השמחה וריקודים דהקפות נמשכים"
        },
        {
          "s": 12,
          "text": "(ווערן צוגעצויגן)"
        },
        {
          "s": 13,
          "text": "גם כאלו שבשאר ימי השנה אין ניכר הקשר וההתאחדות שלהם עם"
        },
        {
          "s": 14,
          "text": "[עניני]"
        },
        {
          "s": 15,
          "text": "התורה,"
        },
        {
          "s": 16,
          "text": "כמו שרואים במוחש]."
        },
        {
          "s": 17,
          "text": "וענין זה"
        },
        {
          "s": 18,
          "text": "(שהשמחה דשמחת תורה היא בכל אחד מישראל)"
        },
        {
          "s": 19,
          "text": "מתבטא גם בזה שמרקדין עם ספר תורה – תורה שבכתב דוקא,"
        },
        {
          "s": 20,
          "text": "שאפילו זה שלא ידע מאי קאמר מברך ברכת התורה כשקורא בתושב\"כ4."
        },
        {
          "s": 21,
          "text": "ומכיון שזה מה שמברך ברכת התורה הוא ע\"פ ציווי תורת אמת,"
        },
        {
          "s": 22,
          "text": "הרי פשוט שכן היא המציאות,"
        },
        {
          "s": 23,
          "text": "שגם זה שלא ידע מאי קאמר ממשיך אוא\"ס ועד עצמות ומהות"
        },
        {
          "s": 24,
          "text": "(נותן התורה)"
        },
        {
          "s": 25,
          "text": "בהתורה שלומד."
        },
        {
          "s": 26,
          "text": "גם ידוע5"
        },
        {
          "s": 27,
          "text": "הדיוק למה עושין שמחת תורה בשמיני עצרת"
        },
        {
          "s": 28,
          "text": "(ובחו\"ל ביו\"ט שני דשמיני עצרת),"
        },
        {
          "s": 29,
          "text": "דלכאורה הי' צ\"ל בחג השבועות זמן מתן תורתינו."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ומובא הביאור בזה6"
        },
        {
          "s": 2,
          "text": "ע\"פ מה דאיתא במדרש7"
        },
        {
          "s": 3,
          "text": "ראוי' היתה העצרת של חג שתהא רחוקה חמשים יום כנגד העצרת של פסח אלא עצרת של חג ע\"י שהן יוצאין מן הקיץ לחורף לית ביומייהו דיזלון וייתון,"
        },
        {
          "s": 4,
          "text": "משל למה\"ד למלך שהיו לו בנות הרבה,"
        },
        {
          "s": 5,
          "text": "מהן נשואות למקום קרוב ומהן נשואות למקום רחוק,"
        },
        {
          "s": 6,
          "text": "יום אחד באו כולן לשאול שלום המלך אביהם,"
        },
        {
          "s": 7,
          "text": "אמר המלך אלו שנשואות במקום קרוב אית בעונתן למיזל ולמיתי,"
        },
        {
          "s": 8,
          "text": "ואילין שנשואות במקום רחוק לית בעונתן למיזל ולמיתי,"
        },
        {
          "s": 9,
          "text": "עד דאינון כולן אצלי הכא נעביד כולן חד יו\"ט ונחדי עמן,"
        },
        {
          "s": 10,
          "text": "כך עצרת של פסח עד דאינון נפקין מחורף לקיץ אמר הקב\"ה אית ביומא למיזל ולמיתי,"
        },
        {
          "s": 11,
          "text": "אבל עצרת של חג ע\"י שהן יוצאין מהקיץ לחורף כו' אמר הקב\"ה לית ביומא למיזל ולמיתי אלא עד דאינון הכא נעביד כולן חד יו\"ט ונחדי."
        },
        {
          "s": 12,
          "text": "וזהו מה שעושין שמחת תורה בשמיני עצרת,"
        },
        {
          "s": 13,
          "text": "כי ה\"יום אחד\" שבו באים כל הבנות"
        },
        {
          "s": 14,
          "text": "[בנות ציון וירושלים,"
        },
        {
          "s": 15,
          "text": "היינו נשמות ישראל8]"
        },
        {
          "s": 16,
          "text": "לשאול שלום המלך אביהם קאי9"
        },
        {
          "s": 17,
          "text": "על יום הכפורים,"
        },
        {
          "s": 18,
          "text": "ולאח\"ז אומר נעביד כולן חד יו\"ט ונחדי,"
        },
        {
          "s": 19,
          "text": "הוא9"
        },
        {
          "s": 20,
          "text": "שמחת תורה"
        },
        {
          "s": 21,
          "text": "(שנקבע בשמיני עצרת),"
        },
        {
          "s": 22,
          "text": "שהוא \"חד יו\"ט\" בדוגמת ה\"יום אחד\" דיום הכפורים."
        }
      ]
    }
  ]
}