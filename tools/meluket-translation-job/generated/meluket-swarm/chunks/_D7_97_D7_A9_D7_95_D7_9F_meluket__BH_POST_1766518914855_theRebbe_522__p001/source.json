{
  "globalIndex": 182,
  "owner": 32,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914855_theRebbe_522__p001",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914855_theRebbe_522__p001",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518914855_theRebbe_522",
  "title": "מאמר ואשה אחת תשמ\"ו",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "אור ליום ב' פ' חיי שרה,"
        },
        {
          "s": 2,
          "text": "כ\"ף מרחשון ה'תשמ\"ו"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "ואשה אחת מנשי בני הנביאים צעקה אל אלישע גו'1,"
        },
        {
          "s": 1,
          "text": "וידוע מאמר אדמו\"ר הזקן עה\"פ2"
        },
        {
          "s": 2,
          "text": "דאשה היא הנשמה,"
        },
        {
          "s": 3,
          "text": "ונק' אשה אחת כי היא אחת עם הוי',"
        },
        {
          "s": 4,
          "text": "מנשי בני הנביאים,"
        },
        {
          "s": 5,
          "text": "כי נביאים מלשון ניב שפתיים3"
        },
        {
          "s": 6,
          "text": "הוא שמקבלים מבחי' דבר הוי' והנשמה היא כלי קיבול לקבל השגות וגילוי אלקות."
        },
        {
          "s": 7,
          "text": "ואלישע אותיות אלי שע הוא הקב\"ה."
        },
        {
          "s": 8,
          "text": "וזהו ואשה אחת גו' צעקה אל אלישע,"
        },
        {
          "s": 9,
          "text": "שהנשמה צועקת להקב\"ה,"
        },
        {
          "s": 10,
          "text": "עבדך אישי מת,"
        },
        {
          "s": 11,
          "text": "אישי הוא אש יו\"ד,"
        },
        {
          "s": 12,
          "text": "דהאהבה כרשפי אש שהי' אצלי להכלל ולהבטל בבחי' יו\"ד חכמה עילאה – מת,"
        },
        {
          "s": 13,
          "text": "שעכשיו אין לי אהבה זו."
        },
        {
          "s": 14,
          "text": "והנושה בא לקחת את שני ילדי לו לעבדים,"
        },
        {
          "s": 15,
          "text": "והנושה מלשון כי נשני אלקים4"
        },
        {
          "s": 16,
          "text": "קאי על נפש הבהמית שמשכחת אותי מאלקות,"
        },
        {
          "s": 17,
          "text": "ושני ילדי הם האהבה והיראה"
        },
        {
          "s": 18,
          "text": "[וכמבואר בתניא5"
        },
        {
          "s": 19,
          "text": "שהמדות נקראים בשם תולדות,"
        },
        {
          "s": 20,
          "text": "ועיקרי המדות הם אהבה ויראה6],"
        },
        {
          "s": 21,
          "text": "וזהו והנושה בא לקחת את שני ילדי לו לעבדים,"
        },
        {
          "s": 22,
          "text": "לאהבות זרות וליראות זרות."
        },
        {
          "s": 23,
          "text": "[דנוסף לזה שנה\"ב משכחת אותי מאלקות ורוצה לבטל ח\"ו את האהוי\"ר באלקות,"
        },
        {
          "s": 24,
          "text": "היא רוצה לקחת את האהוי\"ר דנפש האלקית שיהיו עבדים לנה\"ב]."
        },
        {
          "s": 25,
          "text": "ויאמר אלי' אלישע גו' מה יש לך בבית,"
        },
        {
          "s": 26,
          "text": "איזה כחות נשארו לך שאין לנה\"ב שליטה עליהם7,"
        },
        {
          "s": 27,
          "text": "ותאמר אין לשפחתך גו' כי אם אסוך שמן,"
        },
        {
          "s": 28,
          "text": "שלא נשאר אצלה שום דבר מלבד עצם נקודת הנשמה."
        },
        {
          "s": 29,
          "text": "[ויש לומר8,"
        },
        {
          "s": 30,
          "text": "דשמן הוא חכמה9,"
        },
        {
          "s": 31,
          "text": "ואסוך שמן הוא בחינת החכמה שבנפש,"
        },
        {
          "s": 32,
          "text": "שאין לנה\"ב שליטה עלי'10]."
        },
        {
          "s": 33,
          "text": "ויאמר לכי שאלי לך כלים מן החוץ גו' כלים ריקים אל תמעיטי,"
        },
        {
          "s": 34,
          "text": "שתעסוק בתורה ובמצוות11"
        },
        {
          "s": 35,
          "text": "שהם כלים לאור הוי'12,"
        },
        {
          "s": 36,
          "text": "ואף שהתומ\"צ שעוסקת בהם עכשיו הם כלים ריקים"
        },
        {
          "s": 37,
          "text": "(בלי אהבה ויראה13)"
        },
        {
          "s": 38,
          "text": "מ\"מ אל תמעיטי בהם,"
        },
        {
          "s": 39,
          "text": "ויצקת על כל הכלים האלה,"
        },
        {
          "s": 40,
          "text": "להמשיך בהם הגילוי דעצם הנשמה"
        },
        {
          "s": 41,
          "text": "[וע\"ד המבואר בתניא14"
        },
        {
          "s": 42,
          "text": "שקיום התורה ומצוותי' תלוי בזה שיזכור תמיד ענין מסירת נפשו לה',"
        },
        {
          "s": 43,
          "text": "דמס\"נ הוא מצד עצם הנשמה15]."
        },
        {
          "s": 44,
          "text": "וכשתעשה כן אזי את ובנייך תחיי בנותר,"
        },
        {
          "s": 45,
          "text": "כיתרון האור הבא מן החושך16."
        },
        {
          "s": 46,
          "text": "ועוד פירוש בכלים ריקים אל תמעיטי,"
        },
        {
          "s": 47,
          "text": "שיתבונן הרבה17"
        },
        {
          "s": 48,
          "text": "איך שהוא כלי ריקן בלי דעת במוח ובלי דחילו ורחימו,"
        },
        {
          "s": 49,
          "text": "ויתמרמר מאד על ריחוקו,"
        },
        {
          "s": 50,
          "text": "ועי\"ז יאיר בו אור הנשמה."
        },
        {
          "s": 51,
          "text": "וכמאמר רב מתיבתא בג\"ע18"
        },
        {
          "s": 52,
          "text": "אעא דלא סליק בי' נהורא מבטשין לי' כו' גופא דלא סליק בי' נהורא דנשמתא מבטשין לי' וסליק בי' נהורא."
        },
        {
          "s": 53,
          "text": "ויתירה מזה שאור זה"
        },
        {
          "s": 54,
          "text": "(שמאיר ע\"י המרירות מזה שהוא כלי ריקן)"
        },
        {
          "s": 55,
          "text": "יש לו יתרון על האור כמו שהוא מצד עצמו,"
        },
        {
          "s": 56,
          "text": "כיתרון האור הבא מן החושך דוקא."
        },
        {
          "s": 57,
          "text": "וזהו ואת ובנייך תחיי בנותר,"
        },
        {
          "s": 58,
          "text": "את הוא עצם הנשמה ובנייך הם דחילו ורחימו שבכל נשמה – תחיי בנותר,"
        },
        {
          "s": 59,
          "text": "כיתרון האור הבא מן החושך."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "דיתרון האור הבא מן החושך"
        },
        {
          "s": 3,
          "text": "(ואת ובנייך תחיי בנותר)"
        },
        {
          "s": 4,
          "text": "להפירוש בכלים ריקים אל תמעיטי שיתבונן הרבה איך שהוא כלי ריקן,"
        },
        {
          "s": 5,
          "text": "הוא נעלה יותר מיתרון האור"
        },
        {
          "s": 6,
          "text": "(נותר)"
        },
        {
          "s": 7,
          "text": "להפירוש בכלים ריקים אל תמעיטי שיעסוק בתורה ומצוות אף שהם בלי אהוי\"ר."
        },
        {
          "s": 8,
          "text": "דהנה ביתרון האור מן החושך,"
        },
        {
          "s": 9,
          "text": "שני ענינים."
        },
        {
          "s": 10,
          "text": "יתרון האור בכדי להאיר את החושך."
        },
        {
          "s": 11,
          "text": "שבכדי להאיר במקום רחוק וחשוך ביותר,"
        },
        {
          "s": 12,
          "text": "צריך לאור גדול ביותר19."
        },
        {
          "s": 13,
          "text": "דכמו\"כ הוא גם בנוגע להיתרון"
        },
        {
          "s": 14,
          "text": "(תחיי בנותר)"
        },
        {
          "s": 15,
          "text": "שע\"י עסק התומ\"צ בלי אהוי\"ר,"
        },
        {
          "s": 16,
          "text": "דזה שהוא עוסק בתומ\"צ הגם שאין לו אהוי\"ר,"
        },
        {
          "s": 17,
          "text": "הוא מפני תוקף ההתקשרות שלו באלקות שמצד עצם הנשמה,"
        },
        {
          "s": 18,
          "text": "שלמעלה מכחות הגלויים."
        },
        {
          "s": 19,
          "text": "ועוד ענין ביתרון האור מן החושך,"
        },
        {
          "s": 20,
          "text": "שע\"י המרירות מהחושך המסתיר אורו ית',"
        },
        {
          "s": 21,
          "text": "נמשך מבחינת ישת חושך סתרו20,"
        },
        {
          "s": 22,
          "text": "חושך שלמעלה מאור21"
        },
        {
          "s": 23,
          "text": "(למעלה גם מאור גדול שמאיר גם במקום חשוך ביותר)."
        },
        {
          "s": 24,
          "text": "וזהו היתרון"
        },
        {
          "s": 25,
          "text": "(תחיי בנותר)"
        },
        {
          "s": 26,
          "text": "שע\"י ההתבוננות איך שהוא כלי ריקן,"
        },
        {
          "s": 27,
          "text": "דע\"י המרירות מזה שהוא כלי ריקן"
        },
        {
          "s": 28,
          "text": "(חושך),"
        },
        {
          "s": 29,
          "text": "הוא מגיע לבחינת חושך שלמעלה מאור."
        }
      ]
    }
  ]
}