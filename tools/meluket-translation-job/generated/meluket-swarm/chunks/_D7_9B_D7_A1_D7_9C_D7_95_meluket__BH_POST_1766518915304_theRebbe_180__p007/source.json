{
  "globalIndex": 261,
  "owner": 11,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915304_theRebbe_180__p007",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915304_theRebbe_180__p007",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915304_theRebbe_180",
  "title": "מאמר ושבתי בשלום תשל\"ח",
  "part": 7,
  "sections": [
    {
      "v": 18,
      "items": [
        {
          "s": 0,
          "text": "וזוהי השייכות דשני הפירושים בויקח מאבני המקום גו'"
        },
        {
          "s": 1,
          "text": "[העבודה בבחי' הדומם שבאדם,"
        },
        {
          "s": 2,
          "text": "והעבודה דבירור דברים הגשמיים שבעולם שיהיו דירה לו ית'],"
        },
        {
          "s": 3,
          "text": "כי הכח שיש בישראל לעשות מהעולם דירה לו ית',"
        },
        {
          "s": 4,
          "text": "ליחידו של עולם"
        },
        {
          "s": 5,
          "text": "[ע\"י שעושה מאבני המקום דעולם"
        },
        {
          "s": 6,
          "text": "(אבני לשון רבים)"
        },
        {
          "s": 7,
          "text": "שיהיו אבן אחת."
        },
        {
          "s": 8,
          "text": "שהו\"ע המשכת הוי' אחד,"
        },
        {
          "s": 9,
          "text": "שגם בשמים ובארץ ובד' רוחות העולם"
        },
        {
          "s": 10,
          "text": "(ח' וד'101),"
        },
        {
          "s": 11,
          "text": "עם היותם בחינת התחלקות ופירוד,"
        },
        {
          "s": 12,
          "text": "מ\"מ ע\"י גילוי אלופו של עולם"
        },
        {
          "s": 13,
          "text": "(א'101)"
        },
        {
          "s": 14,
          "text": "מתייחדים באחד ממש102,"
        },
        {
          "s": 15,
          "text": "שאחד זה"
        },
        {
          "s": 16,
          "text": "(דהוי' אחד)"
        },
        {
          "s": 17,
          "text": "הוא כמו יחיד103],"
        },
        {
          "s": 18,
          "text": "הוא מצד בחי' היחידה שבו,"
        },
        {
          "s": 19,
          "text": "שמקבלת104"
        },
        {
          "s": 20,
          "text": "מיחיד."
        }
      ]
    },
    {
      "v": 19,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ג)"
        },
        {
          "s": 2,
          "text": "והנה הגם שהתעוררות היחידה וכח המס\"נ הוא"
        },
        {
          "s": 3,
          "text": "(בדרך כלל)"
        },
        {
          "s": 4,
          "text": "ע\"י העבודה דבחי' דומם,"
        },
        {
          "s": 5,
          "text": "היינו כשהאדם הוא במצב דעניות"
        },
        {
          "s": 6,
          "text": "(בדעת105),"
        },
        {
          "s": 7,
          "text": "שכחות הפנימיים דנה\"א הם בהעלם ואין לו השגה והרגש באלקות"
        },
        {
          "s": 8,
          "text": "(כנ\"ל סעיף יב),"
        },
        {
          "s": 9,
          "text": "מ\"מ,"
        },
        {
          "s": 10,
          "text": "לאחרי שמעורר את כח המס\"נ בהיותו במצב דעניות,"
        },
        {
          "s": 11,
          "text": "הנה זה פועל גם גילוי כחות הפנימיים דנה\"א106."
        },
        {
          "s": 12,
          "text": "וע\"ד הבטחת חז\"ל107"
        },
        {
          "s": 13,
          "text": "כל המקיים את התורה מעוני סופה לקיימה מעושר,"
        },
        {
          "s": 14,
          "text": "עשירות בדעת,"
        },
        {
          "s": 15,
          "text": "וגם עשירות"
        },
        {
          "s": 16,
          "text": "(והרחבה)"
        },
        {
          "s": 17,
          "text": "בענינים הגשמיים,"
        },
        {
          "s": 18,
          "text": "בבני חיי ומזוני"
        },
        {
          "s": 19,
          "text": "(ובכולם)"
        },
        {
          "s": 20,
          "text": "רויחי"
        },
        {
          "s": 21,
          "text": "[ועד שהעשירות וההרחבה בעניניו הגשמיים היא בריבוי ושופי למעלה ממדידה והגבלה,"
        },
        {
          "s": 22,
          "text": "שאז עשירות זו גופא מביאה לעשירות בדעת,"
        },
        {
          "s": 23,
          "text": "כי גם השכל דנה\"ב משיג שעשירות גדולה כזו"
        },
        {
          "s": 24,
          "text": "(למעלה ממדידה והגבלה)"
        },
        {
          "s": 25,
          "text": "יכולה לבוא רק מה' מקור כל הברכות],"
        },
        {
          "s": 26,
          "text": "וגם אז אופן עבודתו היא במס\"נ למעלה מהשכל."
        },
        {
          "s": 27,
          "text": "דזהו פירוש כל המקיים את התורה מעוני סופה לקיימה מעושר,"
        },
        {
          "s": 28,
          "text": "שמקיימה מעושר באותו העילוי"
        },
        {
          "s": 29,
          "text": "(מס\"נ שלמעלה מהגבלה)"
        },
        {
          "s": 30,
          "text": "כמו שקיימה מעוני."
        },
        {
          "s": 31,
          "text": "דזהו\"ע בכל מאדך108"
        },
        {
          "s": 32,
          "text": "שלאחרי בכל לבבך ובכל נפשך108,"
        },
        {
          "s": 33,
          "text": "היינו,"
        },
        {
          "s": 34,
          "text": "שענין המס\"נ"
        },
        {
          "s": 35,
          "text": "(למעלה מהשכל)"
        },
        {
          "s": 36,
          "text": "בבכל מאדך הוא לא מצד שחסר ח\"ו בהשגת השכל שלו,"
        },
        {
          "s": 37,
          "text": "כי אם,"
        },
        {
          "s": 38,
          "text": "שהגם שעבודתו היא בכל כחות נפשו"
        },
        {
          "s": 39,
          "text": "(בכל נפשך)"
        },
        {
          "s": 40,
          "text": "שראשיתם הוא כח השכל,"
        },
        {
          "s": 41,
          "text": "ועד שזה מושג גם בהשכל דנה\"ב שלו"
        },
        {
          "s": 42,
          "text": "(בכל לבבך בשני יצריך109),"
        },
        {
          "s": 43,
          "text": "מ\"מ עבודתו היא במס\"נ שלמעלה מהגבלת השכל,"
        },
        {
          "s": 44,
          "text": "בכל מאדך."
        }
      ]
    },
    {
      "v": 20,
      "items": [
        {
          "s": 0,
          "text": "וזהו ג\"כ מ\"ש ביעקב"
        },
        {
          "s": 1,
          "text": "[שמזה מובן,"
        },
        {
          "s": 2,
          "text": "שכ\"ה גם בכ\"א מישראל],"
        },
        {
          "s": 3,
          "text": "לאחרי עבודתו בהבירור דצאן לבן"
        },
        {
          "s": 4,
          "text": "(שעיקר הבירור הוא בהצאן110),"
        },
        {
          "s": 5,
          "text": "ויפרוץ האיש מאד מאד גו'111"
        },
        {
          "s": 6,
          "text": "[מאד סתם,"
        },
        {
          "s": 7,
          "text": "שלמעלה מבחי' מאד שלך112],"
        },
        {
          "s": 8,
          "text": "כי ע\"י העבודה דבחי' בכל מאדך"
        },
        {
          "s": 9,
          "text": "(מאד שלך)"
        },
        {
          "s": 10,
          "text": "מגיעים לבחי' מאד האמיתי113."
        },
        {
          "s": 11,
          "text": "ונאמר מאד מאד"
        },
        {
          "s": 12,
          "text": "(ב' פעמים)114,"
        },
        {
          "s": 13,
          "text": "דע\"י שהעבודה דבכל מאדך היא נוסף על מצד המקיף דחי' גם מצד המקיף דיחידה,"
        },
        {
          "s": 14,
          "text": "עי\"ז גם ההמשכה שלמעלה היא מאד מאד ב' פעמים,"
        },
        {
          "s": 15,
          "text": "בחי' אריך וגם בחי' עתיק."
        },
        {
          "s": 16,
          "text": "ואין מקרא יוצא מידי פשוטו115,"
        },
        {
          "s": 17,
          "text": "שויפרוץ האיש מאד מאד"
        },
        {
          "s": 18,
          "text": "(ויהי לו צאן רבות וגו')"
        },
        {
          "s": 19,
          "text": "הוא"
        },
        {
          "s": 20,
          "text": "(גם)"
        },
        {
          "s": 21,
          "text": "בגשמיות,"
        },
        {
          "s": 22,
          "text": "כי ע\"י העבודה דבכל מאדך,"
        },
        {
          "s": 23,
          "text": "הוא עושה רצונו של מקום116,"
        },
        {
          "s": 24,
          "text": "היינו שהוא"
        },
        {
          "s": 25,
          "text": "(למעלה מבחי' רצונו של מקום)"
        },
        {
          "s": 26,
          "text": "עושה את הרצון117,"
        },
        {
          "s": 27,
          "text": "כולל גם הפירוש דעושה מלשון מעשין על הצדקה118,"
        },
        {
          "s": 28,
          "text": "שהוא מכריח כביכול את הרצון119,"
        },
        {
          "s": 29,
          "text": "צדיק גוזר והקב\"ה מקיים כמ\"ש120"
        },
        {
          "s": 30,
          "text": "ותגזר אומר ויקם לך121"
        },
        {
          "s": 31,
          "text": "[ויתירה מזו הקב\"ה גוזר וצדיק מבטל122],"
        },
        {
          "s": 32,
          "text": "שנעשה בעה\"ב על כל חלקו בעולם,"
        },
        {
          "s": 33,
          "text": "שיהי' לו הרחבה בכל עניניו,"
        },
        {
          "s": 34,
          "text": "הן בענינים הרוחניים והן בענינים הגשמיים,"
        },
        {
          "s": 35,
          "text": "טוב בריבוי ברכה בריבוי ושלום בריבוי123,"
        },
        {
          "s": 36,
          "text": "עשירות ברוחניות ועשירות בגשמיות,"
        },
        {
          "s": 37,
          "text": "ובגשמיות וברוחניות גם יחד."
        }
      ]
    }
  ]
}