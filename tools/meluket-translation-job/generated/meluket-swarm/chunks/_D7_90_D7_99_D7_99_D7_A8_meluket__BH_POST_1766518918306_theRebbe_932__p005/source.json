  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918306_theRebbe_932__p005",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918306_theRebbe_932__p005",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918306_theRebbe_932",
  "title": "מאמר השמים כסאי תשל\"ו",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ויש להוסיף,"
        },
        {
          "s": 2,
          "text": "דע\"י שהעבודה דשנה הרביעית"
        },
        {
          "s": 3,
          "text": "(שמצד עצמה היא בסדר והדרגה)"
        },
        {
          "s": 4,
          "text": "באה לאחרי וע\"י קדימת העבודה דג' שנים הראשונות,"
        },
        {
          "s": 5,
          "text": "נעשה ענין של קפיצה ודילוג גם בהעבודה דשנה הרביעית."
        },
        {
          "s": 6,
          "text": "דזהו גם הטעם על זה שמהעבודה דשנה הרביעית באים להגילוי דלמעלה מהשתלשלות בשנה החמישית63."
        },
        {
          "s": 7,
          "text": "ויש לקשר זה עם ההוראה של בעל יום ההולדת דתפארת שבתפארת64,"
        },
        {
          "s": 8,
          "text": "שצריך להיות \"מלכתחילה אַריבער\"65."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ויהי רצון,"
        },
        {
          "s": 1,
          "text": "שע\"י מעשינו ועבודתינו,"
        },
        {
          "s": 2,
          "text": "ובפרט באופן ד\"מלכתחילה אַריבער\","
        },
        {
          "s": 3,
          "text": "יהי' קול דודי הנה זה בא מדלג על ההרים מקפץ על הגבעות66,"
        },
        {
          "s": 4,
          "text": "כפירוש המדרש67"
        },
        {
          "s": 5,
          "text": "שקאי על מלך המשיח,"
        },
        {
          "s": 6,
          "text": "יבוא ויגאלנו ויוליכנו קוממיות לארצנו,"
        },
        {
          "s": 7,
          "text": "בקרוב ממש."
        }
      ]
    }
  ]
}