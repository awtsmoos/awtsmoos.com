{
  "globalIndex": 942,
  "owner": 42,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919340_theRebbe_24__p004",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919340_theRebbe_24__p004",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919340_theRebbe_24",
  "title": "מאמר עשרה שיושבין תשמ\"ב",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "וצריך להבין,"
        },
        {
          "s": 1,
          "text": "דגם בהביאור"
        },
        {
          "s": 2,
          "text": "(שבתחלת המאמר)"
        },
        {
          "s": 3,
          "text": "שהאתעדל\"ת דרבים ממשכת אור נעלה יותר,"
        },
        {
          "s": 4,
          "text": "מבאר שההמשכה שע\"י אתעדל\"ת דרבים היא י\"ג מדה\"ר,"
        },
        {
          "s": 5,
          "text": "דיגמה\"ר הם למעלה מהשתלשלות,"
        },
        {
          "s": 6,
          "text": "והמשכה שלמעלה מהשתלשלות היא שלא לפי ערך האתעדל\"ת,"
        },
        {
          "s": 7,
          "text": "ואעפ\"כ מוסיף אח\"כ"
        },
        {
          "s": 8,
          "text": "(עוד ענין)"
        },
        {
          "s": 9,
          "text": "שההמשכה שע\"י רבים היא שלא לפי ערך האתעדל\"ת דהרבים."
        },
        {
          "s": 10,
          "text": "ונקודת הביאור בזה,"
        },
        {
          "s": 11,
          "text": "שהכוונה בזה שמוסיף שההמשכה שע\"י רבים היא שלא לפי ערך האתעדל\"ת שלהם היא,"
        },
        {
          "s": 12,
          "text": "שההמשכה שע\"י רבים היא לא רק שההמשכה היא יותר מהעבודה"
        },
        {
          "s": 13,
          "text": "[דענין זה הוא בכל המשכה שלמעלה מהשתלשלות]"
        },
        {
          "s": 14,
          "text": "אלא גם שההמשכה היא"
        },
        {
          "s": 15,
          "text": "(בעיקר)"
        },
        {
          "s": 16,
          "text": "מצד למעלה35,"
        },
        {
          "s": 17,
          "text": "ע\"ד36"
        },
        {
          "s": 18,
          "text": "אתערותא דלעילא מצד עצמה שנמשכת37"
        },
        {
          "s": 19,
          "text": "ממקום שאין אתערותא דלתתא מגעת לשם38."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר שהוא ע\"ד הענין דיגעתי ומצאתי39,"
        },
        {
          "s": 1,
          "text": "שהידיעה הבאה ע\"י היגיעה היא באופן דמציאה"
        },
        {
          "s": 2,
          "text": "(מצאתי)"
        },
        {
          "s": 3,
          "text": "שלא לפי ערך היגיעה,"
        },
        {
          "s": 4,
          "text": "ושני אופנים בזה."
        },
        {
          "s": 5,
          "text": "ההצלחה בידיעת והבנת הענין שהתייגע בו – ע\"ד המעלה דתפלת רבים,"
        },
        {
          "s": 6,
          "text": "שההמשכה היא למעלה מהשתלשלות"
        },
        {
          "s": 7,
          "text": "(למעלה מסדר והדרגה),"
        },
        {
          "s": 8,
          "text": "אבל"
        },
        {
          "s": 9,
          "text": "(רק)"
        },
        {
          "s": 10,
          "text": "ממקום זה שלשם הגיעה האתעדל\"ת."
        },
        {
          "s": 11,
          "text": "ושההצלחה בידיעת התורה הבאה ע\"י יגיעת האדם היא במקום שלא התייגע בו כלל,"
        },
        {
          "s": 12,
          "text": "הוא עמל במקום זה ותורתו עומלת לו ממקום אחר40"
        },
        {
          "s": 13,
          "text": "– ע\"ד ענין השני דתפלת רבים,"
        },
        {
          "s": 14,
          "text": "שההמשכה שע\"י העבודה"
        },
        {
          "s": 15,
          "text": "(תפלה),"
        },
        {
          "s": 16,
          "text": "היא ע\"ד אתערותא דלעילא מצד עצמה שאתערותא דלתתא"
        },
        {
          "s": 17,
          "text": "(גם האתעדל\"ת דתפלת רבים)"
        },
        {
          "s": 18,
          "text": "אינה מגעת לשם."
        },
        {
          "s": 19,
          "text": "אלא שמ\"מ המשכה זו באה ע\"י תפלת רבים,"
        },
        {
          "s": 20,
          "text": "בדוגמת שגם שתורתו עומלת לו במקום אחר הוא ע\"י העמל דהאדם41."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ויש לומר שהחילוק דשני ענינים אלה הוא גם בשרשם,"
        },
        {
          "s": 2,
          "text": "בי\"ג מדות הרחמים."
        },
        {
          "s": 3,
          "text": "והענין הוא,"
        },
        {
          "s": 4,
          "text": "דמספר42"
        },
        {
          "s": 5,
          "text": "י\"ג"
        },
        {
          "s": 6,
          "text": "(תיקוני דיקנא)"
        },
        {
          "s": 7,
          "text": "הוא י\"ב עם אחד."
        },
        {
          "s": 8,
          "text": "די\"ב הוא י\"ב בקר"
        },
        {
          "s": 9,
          "text": "(שבבריאה),"
        },
        {
          "s": 10,
          "text": "והא'"
        },
        {
          "s": 11,
          "text": "(המיתוסף על י\"ב)"
        },
        {
          "s": 12,
          "text": "הוא הים שעומד עליהם"
        },
        {
          "s": 13,
          "text": "(מלכות דאצילות)."
        },
        {
          "s": 14,
          "text": "ולמעלה יותר,"
        },
        {
          "s": 15,
          "text": "י\"ב הוא י\"ב גבולי אלכסון שבאצילות,"
        },
        {
          "s": 16,
          "text": "והא'"
        },
        {
          "s": 17,
          "text": "(המיתוסף על י\"ב)"
        },
        {
          "s": 18,
          "text": "הוא למעלה מאצילות."
        },
        {
          "s": 19,
          "text": "ויש לומר דזה שי\"ג הוא למעלה מהשתלשלות,"
        },
        {
          "s": 20,
          "text": "הוא,"
        },
        {
          "s": 21,
          "text": "כי ע\"י הא' שמיתוסף בהי\"ב,"
        },
        {
          "s": 22,
          "text": "גם הי\"ב הם למעלה מהשתלשלות."
        },
        {
          "s": 23,
          "text": "ויש לומר,"
        },
        {
          "s": 24,
          "text": "דשני אופנים"
        },
        {
          "s": 25,
          "text": "(מדריגות)"
        },
        {
          "s": 26,
          "text": "בזה."
        },
        {
          "s": 27,
          "text": "שהא' נמשך בהי\"ב כמו שהם במקומם,"
        },
        {
          "s": 28,
          "text": "דבאופן זה,"
        },
        {
          "s": 29,
          "text": "גם לאחרי שנמשך בהם הא',"
        },
        {
          "s": 30,
          "text": "הם גבול"
        },
        {
          "s": 31,
          "text": "(גבולי אלכסון),"
        },
        {
          "s": 32,
          "text": "אלא שע\"י שנמשך בהם הא' שלמעלה מהשתלשלות יש בהם כח בלתי מוגבל."
        },
        {
          "s": 33,
          "text": "ועוד אופן,"
        },
        {
          "s": 34,
          "text": "שהי\"ב מתעלים ונכללים בהא',"
        },
        {
          "s": 35,
          "text": "שעי\"ז הם יוצאים מהגבלתם ונעשים בבחי' בל\"ג."
        },
        {
          "s": 36,
          "text": "ויש לומר דזהו שאחד בגימטריא י\"ג,"
        },
        {
          "s": 37,
          "text": "שכל הי\"ג הם אחד."
        }
      ]
    }
  ]
}