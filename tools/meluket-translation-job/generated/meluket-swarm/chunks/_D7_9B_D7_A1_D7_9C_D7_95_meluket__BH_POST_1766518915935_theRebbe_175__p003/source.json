{
  "globalIndex": 383,
  "owner": 33,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915935_theRebbe_175__p003",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915935_theRebbe_175__p003",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915935_theRebbe_175",
  "title": "מאמר ואתה ברחמיך הרבים תשמ\"ח",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 2,
          "text": "דהגם שנרות חנוכה תקנום מפני הנס שהי' בנרות המקדש,"
        },
        {
          "s": 3,
          "text": "וכל דתקון רבנן כעין דאורייתא תקון27,"
        },
        {
          "s": 4,
          "text": "מ\"מ הם חלוקים בכמה ענינים."
        },
        {
          "s": 5,
          "text": "דבהמנורה"
        },
        {
          "s": 6,
          "text": "(שבמקדש)"
        },
        {
          "s": 7,
          "text": "היו ז' נרות ומקום עמידתה בדרום"
        },
        {
          "s": 8,
          "text": "(ימין),"
        },
        {
          "s": 9,
          "text": "ונרות חנוכה הם שמונה ומקום עמידתם הוא בשמאל."
        },
        {
          "s": 10,
          "text": "והענין הוא"
        },
        {
          "s": 11,
          "text": "(כמבואר בהמאמר),"
        },
        {
          "s": 12,
          "text": "דמלחמת היונים היתה מלחמה רוחנית להשכיחם תורתך ולהעבירם מחוקי רצוניך1,"
        },
        {
          "s": 13,
          "text": "ועי\"ז נעשה התגברות החושך דלעו\"ז,"
        },
        {
          "s": 14,
          "text": "שעיקר יניקתו הוא מקו השמאל,"
        },
        {
          "s": 15,
          "text": "ולכן כשגברה מלכות בית חשמונאי ונצחו את היונים תקנו נרות חנוכה,"
        },
        {
          "s": 16,
          "text": "בכדי להאיר את החושך."
        },
        {
          "s": 17,
          "text": "ולכן תיקנו שמונה נרות,"
        },
        {
          "s": 18,
          "text": "דשמונה הוא למעלה מהשתלשלות"
        },
        {
          "s": 19,
          "text": "(כנ\"ל),"
        },
        {
          "s": 20,
          "text": "כי בכדי להאיר את החושך הוא דוקא ע\"י האור שלמעלה מהשתלשלות,"
        },
        {
          "s": 21,
          "text": "והוי'28"
        },
        {
          "s": 22,
          "text": "(בתוס' וא\"ו)"
        },
        {
          "s": 23,
          "text": "יגי' חשכי29."
        },
        {
          "s": 24,
          "text": "ואור זה"
        },
        {
          "s": 25,
          "text": "(שלמעלה מהשתלשלות)"
        },
        {
          "s": 26,
          "text": "נמשך ע\"י המס\"נ דמתתיהו ובניו."
        },
        {
          "s": 27,
          "text": "והיינו,"
        },
        {
          "s": 28,
          "text": "שהשייכות דאור זה עם החושך שהי' אז היא בשני ענינים,"
        },
        {
          "s": 29,
          "text": "מלמטה למעלה ומלמעלה למטה."
        },
        {
          "s": 30,
          "text": "מלמטה למעלה,"
        },
        {
          "s": 31,
          "text": "שמצד גודל החושך שהי' אז נתעורר אצלם כח המס\"נ שלמעלה מהשתלשלות שבאדם ועי\"ז המשיכו מעצמות אוא\"ס שלמעלה מהשתלשלות,"
        },
        {
          "s": 32,
          "text": "ומלמעלה למטה,"
        },
        {
          "s": 33,
          "text": "שע\"י אור זה מאירים גם את החושך,"
        },
        {
          "s": 34,
          "text": "והוי' יגי' חשכי."
        },
        {
          "s": 35,
          "text": "וזהו שבחנוכת המקדש היו ז' נרות ומקומה בדרום,"
        },
        {
          "s": 36,
          "text": "שהאור שהאיר במקדש"
        },
        {
          "s": 37,
          "text": "(כיון שהמשכתו היתה לא ע\"י מס\"נ)"
        },
        {
          "s": 38,
          "text": "הי' גילוי דהשתלשלות,"
        },
        {
          "s": 39,
          "text": "ז' נרות,"
        },
        {
          "s": 40,
          "text": "ולכן מקום המנורה הי' בדרום"
        },
        {
          "s": 41,
          "text": "(ימין),"
        },
        {
          "s": 42,
          "text": "כי באם היתה עמידתה בצפון"
        },
        {
          "s": 43,
          "text": "(שמאל)"
        },
        {
          "s": 44,
          "text": "הי' אפשר להיות יניקת החיצונים,"
        },
        {
          "s": 45,
          "text": "ונרות חנוכה"
        },
        {
          "s": 46,
          "text": "(שלאחרי המס\"נ)"
        },
        {
          "s": 47,
          "text": "הם ח' נרות,"
        },
        {
          "s": 48,
          "text": "אור שלמעלה מהשתלשלות,"
        },
        {
          "s": 49,
          "text": "שמתקן גם את קו השמאל."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "וע\"פ המבואר בהמאמר שע\"י המס\"נ דמתתיהו ובניו המשיכו האור שלמעלה מהשתלשלות"
        },
        {
          "s": 2,
          "text": "(הוי' דלעילא),"
        },
        {
          "s": 3,
          "text": "יש לומר,"
        },
        {
          "s": 4,
          "text": "שגם שרש הנס דנצחון המלחמה הוא בהוי' דלעילא שלמעלה מהשתלשלות."
        },
        {
          "s": 5,
          "text": "כי המס\"נ של מתתיהו ובניו היתה שהגם שהיו חלשים ומעטים מ\"מ לחמו נגד גבורים ורבים,"
        },
        {
          "s": 6,
          "text": "וכיון שעל ידי המס\"נ שלהם"
        },
        {
          "s": 7,
          "text": "(למעלה מהשתלשלות שבאדם)"
        },
        {
          "s": 8,
          "text": "המשיכו האור שלמעלה מהשתלשלות,"
        },
        {
          "s": 9,
          "text": "מובן,"
        },
        {
          "s": 10,
          "text": "שהנס דמסרת גבורים ביד חלשים ורבים ביד מעטים שנמשך ע\"י המס\"נ שלהם,"
        },
        {
          "s": 11,
          "text": "הוא מהוי' דלעילא."
        },
        {
          "s": 12,
          "text": "וזה שמבואר בהמאמר"
        },
        {
          "s": 13,
          "text": "(הובא לעיל סעיף ג)"
        },
        {
          "s": 14,
          "text": "שרק הנס דהספקת השמן לשמונה ימים נמשך מהוי' דלעילא,"
        },
        {
          "s": 15,
          "text": "משא\"כ הנס דנצחון המלחמה וגם הנס דמציאת פך השמן הם מבחינת השתלשלות,"
        },
        {
          "s": 16,
          "text": "יש לומר,"
        },
        {
          "s": 17,
          "text": "שבנסים אלו,"
        },
        {
          "s": 18,
          "text": "ההמשכה היתה בלבושים דהשתלשלות"
        },
        {
          "s": 19,
          "text": "(כדלקמן סעיף ו),"
        },
        {
          "s": 20,
          "text": "אבל שרשם הוא מהוי' דלעילא."
        },
        {
          "s": 21,
          "text": "ויש לומר,"
        },
        {
          "s": 22,
          "text": "שזהו גם מהטעמים על זה שבמאמר זה קאי להשיטה שהיו\"ט דחנוכה נקבע גם על הנס דנצחון המלחמה,"
        },
        {
          "s": 23,
          "text": "בכדי לרמז,"
        },
        {
          "s": 24,
          "text": "שגם הנס דנצחון המלחמה שייך להוי' דלעילא."
        },
        {
          "s": 25,
          "text": "כי זה שהיו\"ט דחנוכה הוא במספר שמונה"
        },
        {
          "s": 26,
          "text": "(יומי דחנוכה תמניא אינון4)"
        },
        {
          "s": 27,
          "text": "הוא לפי שמספר זה מורה"
        },
        {
          "s": 28,
          "text": "(כנ\"ל סעיף ג)"
        },
        {
          "s": 29,
          "text": "על אור שלמעלה מהשתלשלות,"
        },
        {
          "s": 30,
          "text": "וזה שהיו\"ט דחנוכה נקבע גם על הנס דנצחון המלחמה הוא לפי שגם השרש דנס זה הוא בהאור שלמעלה מהשתלשלות."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והענין הוא,"
        },
        {
          "s": 2,
          "text": "דהמס\"נ של מתתיהו ובניו היתה זה שלחמו נגד היונים."
        },
        {
          "s": 3,
          "text": "ויש לומר,"
        },
        {
          "s": 4,
          "text": "דזה שגם לאחרי המס\"נ"
        },
        {
          "s": 5,
          "text": "(הבאה ע\"י גילוי היחידה)"
        },
        {
          "s": 6,
          "text": "נרגש אצלם שישנו מנגד שצריך ללחום נגדו הוא לפי שגילוי היחידה הי' באופן ששייך לכחות הגלויים דהנשמה."
        },
        {
          "s": 7,
          "text": "דכאשר גילוי היחידה הוא כמו שהיא במקומה,"
        },
        {
          "s": 8,
          "text": "מכיון שבחינת היחידה אין כנגדה לעומת זה30,"
        },
        {
          "s": 9,
          "text": "המס\"נ היא באופן שאינו חושב כלל אודות המנגד,"
        },
        {
          "s": 10,
          "text": "וזה שהמס\"נ דמתתיהו ובניו היתה באופן שלחמו נגד המנגדים31"
        },
        {
          "s": 11,
          "text": "הוא לפי שגילוי היחידה הי' באופן כמו ששייך לכחות הגלויים32."
        },
        {
          "s": 12,
          "text": "ולכן גם האור שלמעלה מהשתלשלות שנמשך ע\"י המס\"נ שלהם,"
        },
        {
          "s": 13,
          "text": "הנס דמסרת גבורים ביד חלשים ורבים ביד מעטים,"
        },
        {
          "s": 14,
          "text": "הי' מלובש בטבע,"
        },
        {
          "s": 15,
          "text": "ויתירה מזו – בטבע דעוה\"ז התחתון שהקליפות גוברים בו33,"
        },
        {
          "s": 16,
          "text": "שהמנגדים הם גבורים ורבים"
        },
        {
          "s": 17,
          "text": "(וצריך ללחום כנגדם)."
        },
        {
          "s": 18,
          "text": "ויש לומר,"
        },
        {
          "s": 19,
          "text": "דזהו מ\"ש בהמאמר שהנס דנצחון המלחמה הוא יחו\"ת,"
        },
        {
          "s": 20,
          "text": "אף שגם נס זה נמשך מהאור שלמעלה מהשתלשלות,"
        },
        {
          "s": 21,
          "text": "כי האור שלמעלה מהשתלשלות שנמשך בנס זה הי' בלבוש שנותן מקום למציאות וישות,"
        },
        {
          "s": 22,
          "text": "יחודא תתאה"
        },
        {
          "s": 23,
          "text": "(וע\"ד המס\"נ דחנוכה,"
        },
        {
          "s": 24,
          "text": "שהגילוי דיחידה הי' בהתלבשות בכחות הגלויים)34."
        },
        {
          "s": 25,
          "text": "ולאח\"ז נמשך האור באופן נעלה יותר,"
        },
        {
          "s": 26,
          "text": "שמצאו פך אחד חתום בחותמו של כהן גדול,"
        },
        {
          "s": 27,
          "text": "שאינו נותן מקום למנגד,"
        },
        {
          "s": 28,
          "text": "דכשהפך הוא חתום בחותם אינם יכולים לנגוע בהשמן שבו ולטמאו."
        },
        {
          "s": 29,
          "text": "ומכ\"ש הענין דחתום בחותמו של כהן גדול בפנימיות הענינים שהוא אור כזה שאין החיצונים יכולים ליגע שם כלל35."
        },
        {
          "s": 30,
          "text": "אבל גם נס זה הי' בלבושי הטבע,"
        },
        {
          "s": 31,
          "text": "דזה שמצאו הפך,"
        },
        {
          "s": 32,
          "text": "אין זה נס שיוצא מדרך הטבע."
        },
        {
          "s": 33,
          "text": "ויש לומר,"
        },
        {
          "s": 34,
          "text": "דזהו מ\"ש בהמאמר שהנס דמציאת פך השמן הוא יחודא עילאה,"
        },
        {
          "s": 35,
          "text": "הוי' דלתתא,"
        },
        {
          "s": 36,
          "text": "כי לגבי שם הוי',"
        },
        {
          "s": 37,
          "text": "אין נתינת מקום למנגד,"
        },
        {
          "s": 38,
          "text": "אבל מ\"מ,"
        },
        {
          "s": 39,
          "text": "גם שם הוי'"
        },
        {
          "s": 40,
          "text": "(דלתתא)"
        },
        {
          "s": 41,
          "text": "הוא מקור להתהוות36."
        },
        {
          "s": 42,
          "text": "ולאחרי זה נמשך האור באופן נעלה יותר,"
        },
        {
          "s": 43,
          "text": "שהדליקו ממנו שמונה ימים,"
        },
        {
          "s": 44,
          "text": "דנס זה אינו מלובש בטבע,"
        },
        {
          "s": 45,
          "text": "גילוי הוי' דלעילא כמו שהוא למעלה מהתלבשות."
        }
      ]
    }
  ]
}