{
  "globalIndex": 344,
  "owner": 44,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915689_theRebbe_467__p006",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915689_theRebbe_467__p006",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915689_theRebbe_467",
  "title": "הוספה משיחות ש\"פ וישב-מקץ תשכ\"ו",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "ועפי\"ז יובן מה שאומר כאן כל העוסק כו',"
        },
        {
          "s": 1,
          "text": "שמדבר בנוגע להאדם,"
        },
        {
          "s": 2,
          "text": "כי בחי' יחידה שבנפש היא למעלה מבחי' עולם."
        },
        {
          "s": 3,
          "text": "ולכן,"
        },
        {
          "s": 4,
          "text": "אינו מדבר כאן בנוגע לתורה גמ\"ח ותפלה בצבור עצמם,"
        },
        {
          "s": 5,
          "text": "וואָס זיי דאַרפן זיך אָפּטאָן און אויפטאָן אין עולם,"
        },
        {
          "s": 6,
          "text": "כ\"א בנוגע להאדם העוסק,"
        },
        {
          "s": 7,
          "text": "בחי' יחידה שלו,"
        },
        {
          "s": 8,
          "text": "שלמעלה מענין העולם."
        },
        {
          "s": 9,
          "text": "(משא\"כ במשנה דאבות שמדבר בענין עמידת העולם,"
        },
        {
          "s": 10,
          "text": "על שלשה דברים העולם עומד,"
        },
        {
          "s": 11,
          "text": "הנה שם נוגע ענין ג' קוין אלה כמו ששייכים לעולם)."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "* * *"
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "ועפי\"ז תומתק יותר השייכות דפדה בשלום כו' וכל העוסק בתורה ובגמ\"ח ומתפלל עם הצבור לגאולת רבינו הזקן שענינה הוא הפצת מעינות תורת החסידות כנ\"ל."
        },
        {
          "s": 1,
          "text": "דהנה ענינה של תורת החסידות היא בחי' יחידה."
        },
        {
          "s": 2,
          "text": "וכמו שנת\"ל"
        },
        {
          "s": 3,
          "text": "(בשיחת י\"ט כסלו22)"
        },
        {
          "s": 4,
          "text": "דלהיות שחסידות היא בחי' יחידה,"
        },
        {
          "s": 5,
          "text": "לכן היא נותנת חיות בכל ד' חלקי התורה,"
        },
        {
          "s": 6,
          "text": "פשט רמז דרוש סוד,"
        },
        {
          "s": 7,
          "text": "שהם בחי' נרנ\"ח."
        },
        {
          "s": 8,
          "text": "ולכן,"
        },
        {
          "s": 9,
          "text": "ההכנה להנתינת רשות מלמעלה על הפצת המעינות,"
        },
        {
          "s": 10,
          "text": "גילוי יחידה דתורה,"
        },
        {
          "s": 11,
          "text": "היתה עבודת רבינו הזקן בבחי' יחידה שלו,"
        },
        {
          "s": 12,
          "text": "ובחי' יחידה שלו האירה בכל ג' הקוין תורה גמילות חסדים ותפלה,"
        },
        {
          "s": 13,
          "text": "שהם כללות עבודת האדם."
        },
        {
          "s": 14,
          "text": "ועל ידי עבודה זו – גילוי היחידה והתגלותה בכל ג' הקוין – ניתן הרשות מלמעלה לגלות את המעינות,"
        },
        {
          "s": 15,
          "text": "בחי' יחידה דתורה,"
        },
        {
          "s": 16,
          "text": "ושתאיר ותכניס חיות בכל ד' חלקי התורה,"
        },
        {
          "s": 17,
          "text": "נרנ\"ח שבתורה,"
        },
        {
          "s": 18,
          "text": "עד לבחי' נרנ\"ח שבעולם,"
        },
        {
          "s": 19,
          "text": "עד לבחינה היותר תחתונה שבעולם,"
        },
        {
          "s": 20,
          "text": "עד אשר גם כח הפועל בנפעל וגם הנפעל עצמו"
        },
        {
          "s": 21,
          "text": "(בחי' חוצה)"
        },
        {
          "s": 22,
          "text": "יכיר וירגיש אשר אין עוד מלבדו."
        }
      ]
    }
  ]
}