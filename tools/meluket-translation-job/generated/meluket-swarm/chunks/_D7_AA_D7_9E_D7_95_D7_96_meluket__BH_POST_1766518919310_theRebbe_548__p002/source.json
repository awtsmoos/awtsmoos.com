{
  "globalIndex": 934,
  "owner": 34,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919310_theRebbe_548__p002",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919310_theRebbe_548__p002",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919310_theRebbe_548",
  "title": "מאמר זה היום עשה ה' תשל\"ח",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דהחילוק בהזמן שבו נעשה הנס,"
        },
        {
          "s": 2,
          "text": "יום או לילה,"
        },
        {
          "s": 3,
          "text": "הוא בהתאם לדרגת ואופן הנס,"
        },
        {
          "s": 4,
          "text": "אם הנס באופן של אור וגילוי"
        },
        {
          "s": 5,
          "text": "(יום)"
        },
        {
          "s": 6,
          "text": "או שהוא באופן דהעלם"
        },
        {
          "s": 7,
          "text": "(לילה)."
        },
        {
          "s": 8,
          "text": "ועפ\"ז יומתק גם זה שהנס הוא באופן של יום,"
        },
        {
          "s": 9,
          "text": "אור וגילוי12."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "וביאור הענין"
        },
        {
          "s": 2,
          "text": "(השייכות דהזמן שבו נעשה הנס להנס)"
        },
        {
          "s": 3,
          "text": "יובן בהקדים הידוע דנס הוא מלשון הרמה13."
        },
        {
          "s": 4,
          "text": "דע\"י הנס נעשה הרמה ועלי' בהטבע14."
        },
        {
          "s": 5,
          "text": "דזהו מה שאומרים ברוך שעשה לי נס במקום הזה15,"
        },
        {
          "s": 6,
          "text": "דגם המקום שהוא גבול וטבע מתעלה בהבל\"ג דהנס שלמעלה מהטבע."
        },
        {
          "s": 7,
          "text": "ומזה מובן שעד\"ז הוא בנוגע לזמן שנעשה בו הנס,"
        },
        {
          "s": 8,
          "text": "וכמו שאומרים בברכת הנסים"
        },
        {
          "s": 9,
          "text": "(דחנוכה ודפורים)"
        },
        {
          "s": 10,
          "text": "שעשה נסים לאבותינו בימים ההם בזמן הזה."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וביאור הענין בפרטיות יותר,"
        },
        {
          "s": 2,
          "text": "הנה ידוע16"
        },
        {
          "s": 3,
          "text": "דבנסים יש"
        },
        {
          "s": 4,
          "text": "(בכללות)"
        },
        {
          "s": 5,
          "text": "שני סוגים."
        },
        {
          "s": 6,
          "text": "נסים שלמעלה מהטבע"
        },
        {
          "s": 7,
          "text": "[כהנסים שהיו ביציאת מצרים,"
        },
        {
          "s": 8,
          "text": "הפיכת מים לדם וכו' ועד להנס דקריעת ים סוף שנהפך ים ליבשה],"
        },
        {
          "s": 9,
          "text": "ונסים המלובשים בדרכי הטבע."
        },
        {
          "s": 10,
          "text": "ובהם גופא ישנם שני אופנים."
        },
        {
          "s": 11,
          "text": "שלבושי הטבע הם באופן שניכר בהם שהם רק לבוש להנס שמתלבש בהם."
        },
        {
          "s": 12,
          "text": "כהנסים דחנוכה ופורים"
        },
        {
          "s": 13,
          "text": "(ועד\"ז הנסים של הגאולה די\"ט כסלו17"
        },
        {
          "s": 14,
          "text": "ודי\"ב תמוז),"
        },
        {
          "s": 15,
          "text": "דעם היותם מלובשים בדרכי הטבע,"
        },
        {
          "s": 16,
          "text": "מ\"מ הי' ניכר בגילוי"
        },
        {
          "s": 17,
          "text": "(ועד שראו כל אפסי ארץ18)"
        },
        {
          "s": 18,
          "text": "הנס שבהם19."
        },
        {
          "s": 19,
          "text": "ושלבושי הטבע מעלימים ומסתירים על הנס שמלובש בהם."
        },
        {
          "s": 20,
          "text": "ועד שלפעמים הם מעלימים ומסתירים לגמרי,"
        },
        {
          "s": 21,
          "text": "שאין ניכר כלל שהוא נס,"
        },
        {
          "s": 22,
          "text": "אין בעל הנס מכיר בנסו20."
        }
      ]
    }
  ]
}