{
  "globalIndex": 676,
  "owner": 26,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917769_theRebbe_254__p001",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917769_theRebbe_254__p001",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917769_theRebbe_254",
  "title": "מאמר ביום עשתי עשר תשל\"א",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "י\"א ניסן ה'תשל\"א"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "ביום עשתי עשר יום נשיא לבני אשר1,"
        },
        {
          "s": 1,
          "text": "ואיתא במדרש2"
        },
        {
          "s": 2,
          "text": "כל השבטים לשם גאולתן של ישראל ולשם שבחן נקראו שמותם,"
        },
        {
          "s": 3,
          "text": "ואשר נקרא שמו לשם גאולתן של ישראל כמה דתימא3"
        },
        {
          "s": 4,
          "text": "ואשרו אתכם כל הגוים כי תהיו אתם ארץ חפץ אמר ה' צבאות,"
        },
        {
          "s": 5,
          "text": "ולשם שבחן כמה דתימא4"
        },
        {
          "s": 6,
          "text": "אשרי העם שככה לו אשרי העם שה' אלקיו,"
        },
        {
          "s": 7,
          "text": "אין אישורן של ישראל אלא על שבחרו בהקב\"ה להיות להם לאלקים5"
        },
        {
          "s": 8,
          "text": "והקב\"ה בחר בהם להיות לו לעם סגולה,"
        },
        {
          "s": 9,
          "text": "ולפיכך כשבא נשיא אשר להקריב,"
        },
        {
          "s": 10,
          "text": "הקריב קרבנו ע\"ש הבחירה שבחר הקב\"ה בישראל מכל האומות,"
        },
        {
          "s": 11,
          "text": "כמה דתימא6"
        },
        {
          "s": 12,
          "text": "ובך בחר ה' אלקיך להיות לו לעם סגולה."
        },
        {
          "s": 13,
          "text": "וצריך להבין,"
        },
        {
          "s": 14,
          "text": "דבתחלת הענין אומר דאישורן של ישראל הוא שבחרו בהקב\"ה"
        },
        {
          "s": 15,
          "text": "(וזה שממשיך שהקב\"ה בחר בהם הוא לכאורה כמו דבר נוסף)7,"
        },
        {
          "s": 16,
          "text": "ולאח\"ז אומר דאשר"
        },
        {
          "s": 17,
          "text": "(על שם אישורן של ישראל)"
        },
        {
          "s": 18,
          "text": "הקריב קרבנו על שם הבחירה שבחר הקב\"ה בישראל."
        },
        {
          "s": 19,
          "text": "גם צריך להבין,"
        },
        {
          "s": 20,
          "text": "דבחירה שייך דוקא בשני דברים ששניהם שוים,"
        },
        {
          "s": 21,
          "text": "או שבכל אחד מהם יש מעלה שאין בזולתו,"
        },
        {
          "s": 22,
          "text": "אבל בנוגע להקב\"ה ולהבדיל אלקי הנכר8,"
        },
        {
          "s": 23,
          "text": "האיך שייך לומר שישראל בחרו בהקב\"ה."
        },
        {
          "s": 24,
          "text": "ועד\"ז בזה שהקב\"ה בחר בישראל,"
        },
        {
          "s": 25,
          "text": "הרי ישראל הם נעלים באין ערוך מכל האומות,"
        },
        {
          "s": 26,
          "text": "ומהו שהקב\"ה בחר בישראל."
        },
        {
          "s": 27,
          "text": "גם מ\"ש בתניא9"
        },
        {
          "s": 28,
          "text": "דבנו בחרת מכל עם ולשון הוא הגוף החומרי הנדמה בחומריותו לגופי אומות העולם,"
        },
        {
          "s": 29,
          "text": "צריך ביאור,"
        },
        {
          "s": 30,
          "text": "דזה שהגוף דישראל נדמה"
        },
        {
          "s": 31,
          "text": "(בחיצוניות)"
        },
        {
          "s": 32,
          "text": "לגופי אומות העולם אין זה ביאור"
        },
        {
          "s": 33,
          "text": "(לכאורה)"
        },
        {
          "s": 34,
          "text": "בנוגע להקב\"ה."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים מ\"ש10"
        },
        {
          "s": 2,
          "text": "חלקי הוי' אמרה נפשי,"
        },
        {
          "s": 3,
          "text": "ואיתא במדרש11"
        },
        {
          "s": 4,
          "text": "משל למלך שנכנס למדינה והיו עמו דוכסין ואיפרכין ואיסטרטילוטין כו',"
        },
        {
          "s": 5,
          "text": "חד אמר אנא נסיב דוכסין לגבי חד אמר אנא נסיב איפרכין לגבי וחד אמר אנא נסיב איסטרטילוטין לגבי,"
        },
        {
          "s": 6,
          "text": "הי' פקח אחד לשם אמר אנא נסיב מלכא דכולהו מתחלפין ומלכא אינו מתחלף,"
        },
        {
          "s": 7,
          "text": "כן אוה\"ע מהן עובדין לחמה ומהן עובדין ללבנה כו' אבל ישראל אינן עובדין אלא להקב\"ה,"
        },
        {
          "s": 8,
          "text": "הה\"ד חלקי הוי' אמרה נפשי."
        },
        {
          "s": 9,
          "text": "וידוע הדיוק בזה12,"
        },
        {
          "s": 10,
          "text": "דלכאורה,"
        },
        {
          "s": 11,
          "text": "הרי גם מי שאינו פקח ואפילו תינוק קטן13"
        },
        {
          "s": 12,
          "text": "יודע שהמלך הוא גדול יותר מהדוכסין וכו',"
        },
        {
          "s": 13,
          "text": "ומה צריכים לפקחות בכדי לבחור בהמלך."
        },
        {
          "s": 14,
          "text": "וגם,"
        },
        {
          "s": 15,
          "text": "הרי גם אם הדוכסין וכו' לא היו מתחלפין הי' מובן בפשטות שהמלך הוא גדול מהם"
        },
        {
          "s": 16,
          "text": "[ובפרט לפי הידוע14"
        },
        {
          "s": 17,
          "text": "בפירוש הכתוב15"
        },
        {
          "s": 18,
          "text": "משכמו ומעלה גבוה מכל העם,"
        },
        {
          "s": 19,
          "text": "שגם שכמו של המלך,"
        },
        {
          "s": 20,
          "text": "היינו המדות שנמשכים מהשכל שבראש ולמטה ממנו,"
        },
        {
          "s": 21,
          "text": "הוא גבוה יותר מהראש"
        },
        {
          "s": 22,
          "text": "(השכל)"
        },
        {
          "s": 23,
          "text": "של כל העם,"
        },
        {
          "s": 24,
          "text": "שבזה"
        },
        {
          "s": 25,
          "text": "(כל העם)"
        },
        {
          "s": 26,
          "text": "נכללים גם השרים הכי גדולים],"
        },
        {
          "s": 27,
          "text": "ולמה16"
        },
        {
          "s": 28,
          "text": "צריך להטעם דכולהו מתחלפין."
        }
      ]
    }
  ]
}