{
  "globalIndex": 691,
  "owner": 41,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917845_theRebbe_238__p001",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917845_theRebbe_238__p001",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917845_theRebbe_238",
  "title": "מאמר מצה זו תשמ\"ט",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד*."
        },
        {
          "s": 1,
          "text": "י\"ג ניסן1,"
        },
        {
          "s": 2,
          "text": "אור לי\"ד ניסן2"
        },
        {
          "s": 3,
          "text": "תשמ\"ט."
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "מצה זו שאנו אוכלים על שום מה על שום שלא הספיק בצקת של אבותינו להחמיץ עד שנגלה עליהם ממה\"מ הקב\"ה וגאלם3,"
        },
        {
          "s": 1,
          "text": "ומבואר בדרושי רבותינו נשיאינו4,"
        },
        {
          "s": 2,
          "text": "דזה שאומר שהטעם על אכילת מצה בפסח הוא משום שלא הספיק להחמיץ,"
        },
        {
          "s": 3,
          "text": "אף שהציווי על אכילת מצה הי' לפני זה,"
        },
        {
          "s": 4,
          "text": "כי בהציווי על אכילת מצה כתיב5"
        },
        {
          "s": 5,
          "text": "בערב תאכלו מצת,"
        },
        {
          "s": 6,
          "text": "מצת חסר וא\"ו,"
        },
        {
          "s": 7,
          "text": "ובפסוק ויאפו את הבצק אשר הוציאו ממצרים עגת מצות גו'6"
        },
        {
          "s": 8,
          "text": "כתיב מצות מלא וא\"ו."
        },
        {
          "s": 9,
          "text": "דהציווי על אכילת מצה הוא קודם חצות7,"
        },
        {
          "s": 10,
          "text": "ומכיון שקודם חצות היו עדיין במצרים,"
        },
        {
          "s": 11,
          "text": "לפני שנגלה עליהם ממה\"מ הקב\"ה,"
        },
        {
          "s": 12,
          "text": "לכן במצה זו כתיב מצת חסר וא\"ו,"
        },
        {
          "s": 13,
          "text": "משא\"כ בפסוק ויאפו את הבצק אשר הוציאו ממצרים עגת מצות גו' מדבר בהמצה שאפו"
        },
        {
          "s": 14,
          "text": "(ואכלו)"
        },
        {
          "s": 15,
          "text": "לאחרי שיצאו ממצרים"
        },
        {
          "s": 16,
          "text": "(את הבצק אשר הוציאו ממצרים)"
        },
        {
          "s": 17,
          "text": "שזה הי' לאחרי חצות,"
        },
        {
          "s": 18,
          "text": "לאחרי שנגלה עליהם ממה\"מ הקב\"ה וגאלם,"
        },
        {
          "s": 19,
          "text": "לכן במצה זו כתיב מצות מלא וא\"ו."
        },
        {
          "s": 20,
          "text": "וזהו גם מה שבהמצה שקודם חצות כתיב8"
        },
        {
          "s": 21,
          "text": "ושמרתם את המצות,"
        },
        {
          "s": 22,
          "text": "שצריכה שימור שלא תבוא לידי חימוץ,"
        },
        {
          "s": 23,
          "text": "ובהמצה שאחרי חצות כתיב ויאפו את הבצק גו' מצות כי לא חמץ,"
        },
        {
          "s": 24,
          "text": "שמעצמה לא באה לידי חימוץ,"
        },
        {
          "s": 25,
          "text": "כי המצה שאחרי חצות היא בחי' מצות מלא וא\"ו,"
        },
        {
          "s": 26,
          "text": "הגילוי דנגלה עליהם ממה\"מ הקב\"ה,"
        },
        {
          "s": 27,
          "text": "ולכן אין צריכה שימור מחימוץ."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "והנה חילוק זה שבין קודם חצות ולאחרי חצות הי' רק בפסח הראשון,"
        },
        {
          "s": 1,
          "text": "לפני מתן תורה."
        },
        {
          "s": 2,
          "text": "משא\"כ לאחרי מתן תורה,"
        },
        {
          "s": 3,
          "text": "אף שהמצה שאוכלים בליל הפסח היא לפני חצות9,"
        },
        {
          "s": 4,
          "text": "היא בחי' מצות מלא וא\"ו10,"
        },
        {
          "s": 5,
          "text": "שיש בה"
        },
        {
          "s": 6,
          "text": "(גם11)"
        },
        {
          "s": 7,
          "text": "העילוי דנגלה עליהם ממה\"מ הקב\"ה."
        },
        {
          "s": 8,
          "text": "וז\"ש בהגדה מצה זו שאנו אוכלים על שום מה על שום שלא הספיק כו' להחמיץ"
        },
        {
          "s": 9,
          "text": "(שמעצמה לא באה לידי חימוץ)"
        },
        {
          "s": 10,
          "text": "עד שנגלה עליהם ממה\"מ הקב\"ה וגאלם12."
        }
      ]
    }
  ]
}