{
  "globalIndex": 418,
  "owner": 18,
  "jobId": "_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916134_theRebbe_917__p007",
  "batchId": "meluket-_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916134_theRebbe_917__p007",
  "seriesId": "טבת_meluket",
  "postId": "BH_POST_1766518916134_theRebbe_917",
  "title": "מאמר ויגש אליו יהודה תשכ\"ה",
  "part": 7,
  "sections": [
    {
      "v": 18,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "ועפ\"ז יש לבאר השייכות דויגש אליו יהודה להחיבור דשתי הדיעות,"
        },
        {
          "s": 3,
          "text": "דעת עליון ודעת תחתון,"
        },
        {
          "s": 4,
          "text": "כי שני הענינים דתורה ותפלה הם ע\"ד דעת עליון ודעת תחתון."
        },
        {
          "s": 5,
          "text": "דנוסף לזה שתורה היא מלמעלה למטה ותפלה היא מלמטה למעלה"
        },
        {
          "s": 6,
          "text": "(דדעת עליון הוא מלמעלה למטה ודעת תחתון הוא מלמטה למעלה53),"
        },
        {
          "s": 7,
          "text": "זה שהתורה נמשכת בשכלו של האדם כמו שהוא במציאותו"
        },
        {
          "s": 8,
          "text": "(דהגם ששכל האדם הוא באין ערוך להתורה,"
        },
        {
          "s": 9,
          "text": "מ\"מ בכדי ששכל האדם יבין וישיג התורה שלומד אינו צריך לצאת ממציאותו)"
        },
        {
          "s": 10,
          "text": "וגם אז היא דבר השם54,"
        },
        {
          "s": 11,
          "text": "היינו שהמשכת התורה למטה היא לא כפי גדרי המטה אלא מצד ענין התורה"
        },
        {
          "s": 12,
          "text": "(שלהיותה בלי גבול היא נמשכת בכל מקום),"
        },
        {
          "s": 13,
          "text": "מורה שבההמשכה דתורה אין הנבראים תופסים מקום – דעת עליון ש"
        },
        {
          "s": 14,
          "text": "(למעלה יש ו)"
        },
        {
          "s": 15,
          "text": "למטה אין."
        },
        {
          "s": 16,
          "text": "וזה שההמשכה דתפלה היא מצד המעלה דעבודת המטה"
        },
        {
          "s": 17,
          "text": "(למעשה ידיך תכסוף),"
        },
        {
          "s": 18,
          "text": "וכן זה שענינה של המשכה זו הוא לשנות את הנבראים,"
        },
        {
          "s": 19,
          "text": "מורה שבהמשכה זו המטה תופס מקום – דעת תחתון שלמטה יש."
        },
        {
          "s": 20,
          "text": "וע\"י בקשת יהודה בי אדוני,"
        },
        {
          "s": 21,
          "text": "שהוא כענין קדימת פסוק אד' שפתי תפתח ופי יגיד תהלתך קודם התפלה"
        },
        {
          "s": 22,
          "text": "(כנ\"ל סעיף ג),"
        },
        {
          "s": 23,
          "text": "שהתפלה שלו"
        },
        {
          "s": 24,
          "text": "(תפלת האדם)"
        },
        {
          "s": 25,
          "text": "היתה באופן שעל ידה תומשך תפלתו של הקב\"ה,"
        },
        {
          "s": 26,
          "text": "גם ההמשכה שע\"י תפלתו,"
        },
        {
          "s": 27,
          "text": "שענינה הוא לעשות שינוי בהמטה,"
        },
        {
          "s": 28,
          "text": "היתה באופן שהי' נרגש בה בגילוי ההמשכה מלמעלה"
        },
        {
          "s": 29,
          "text": "(שלמעלה מהשתלשלות),"
        },
        {
          "s": 30,
          "text": "חיבור שתי הדיעות."
        }
      ]
    },
    {
      "v": 19,
      "items": [
        {
          "s": 0,
          "text": "וע\"פ המבואר לעיל"
        },
        {
          "s": 1,
          "text": "(סעיף ד)"
        },
        {
          "s": 2,
          "text": "שתפלה היא למעלה מתורה"
        },
        {
          "s": 3,
          "text": "[דתורה היא דוגמת הענין דלמטה מטה כו' ותפלה דוגמת הענין דלמעלה מעלה כו'],"
        },
        {
          "s": 4,
          "text": "והיתרון דתורה לגבי תפלה הוא שההמשכה דתורה הוא המשכת אלקות,"
        },
        {
          "s": 5,
          "text": "יש לומר,"
        },
        {
          "s": 6,
          "text": "דכשהתפלה היא באופן שיש בה גם המעלה דתורה,"
        },
        {
          "s": 7,
          "text": "התפלה היא למעלה מתורה."
        },
        {
          "s": 8,
          "text": "ועד\"ז הוא בדעת עליון ודעת תחתון,"
        },
        {
          "s": 9,
          "text": "דכשדעת תחתון הוא באופן שמאיר בו גם הגילוי דדעת עליון,"
        },
        {
          "s": 10,
          "text": "אזי הוא למעלה מדעת עליון."
        },
        {
          "s": 11,
          "text": "ועד\"ז הוא בז\"א ומלכות,"
        },
        {
          "s": 12,
          "text": "שהם דעת עליון ודעת תחתון"
        },
        {
          "s": 13,
          "text": "(כנ\"ל סעיף ב),"
        },
        {
          "s": 14,
          "text": "דע\"י שהמלכות נעשית כמו הז\"א"
        },
        {
          "s": 15,
          "text": "(שניהם שוים),"
        },
        {
          "s": 16,
          "text": "הוא הקדמה להגילוי דשרש המלכות שלמעלה משרש הז\"א."
        },
        {
          "s": 17,
          "text": "ולכן בהחיבור דשתי הדיעות שבויגש אליו יהודה יש בהעלם גם העלי' דמלכות שיהי' לע\"ל,"
        },
        {
          "s": 18,
          "text": "שהמלכות תהי' למעלה מז\"א,"
        },
        {
          "s": 19,
          "text": "אשת חיל עטרת בעלה."
        }
      ]
    }
  ]
}