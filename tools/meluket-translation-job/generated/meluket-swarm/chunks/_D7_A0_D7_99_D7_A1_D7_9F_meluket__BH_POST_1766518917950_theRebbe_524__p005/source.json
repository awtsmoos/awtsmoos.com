{
  "globalIndex": 714,
  "owner": 14,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917950_theRebbe_524__p005",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917950_theRebbe_524__p005",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917950_theRebbe_524",
  "title": "מאמר על שלושה דברים תשי\"ד",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "וביאור הענין בפרטיות יותר,"
        },
        {
          "s": 1,
          "text": "יובן ע\"פ מה דאיתא בגמרא48"
        },
        {
          "s": 2,
          "text": "שכששמע רבי מאלי' הנביא שר' חייא ובניו הם דוגמת האבות,"
        },
        {
          "s": 3,
          "text": "העמיד אותם רבי לפני התיבה,"
        },
        {
          "s": 4,
          "text": "אמר משיב הרוח ונשיב זיקא,"
        },
        {
          "s": 5,
          "text": "מוריד הגשם ואתא מיטרא,"
        },
        {
          "s": 6,
          "text": "כי מטי למימר מחי' המתים רגש עלמא."
        },
        {
          "s": 7,
          "text": "וכתב האלשי\"ך49"
        },
        {
          "s": 8,
          "text": "שהבקשה אד' שפתי תפתח ופי יגיד תהלתך שבהתחלת תפלת שמו\"ע היא,"
        },
        {
          "s": 9,
          "text": "שתפלתינו תהי' כמו תפלת ר\"ח ובניו."
        },
        {
          "s": 10,
          "text": "ואינו מובן,"
        },
        {
          "s": 11,
          "text": "איך שייך לומר שתפלתינו תהי' כתפלת ר\"ח ובניו"
        },
        {
          "s": 12,
          "text": "[ובפרט ע\"פ מה דאיתא בגמרא שם שר\"ח ובניו היו כמו האבות]."
        },
        {
          "s": 13,
          "text": "גם צריך להבין,"
        },
        {
          "s": 14,
          "text": "דר\"ח ובניו היו מתפללים בכל יום,"
        },
        {
          "s": 15,
          "text": "ואעפ\"כ ההמשכה שע\"י תפלת ר\"ח ובניו"
        },
        {
          "s": 16,
          "text": "(נשיב זיקא,"
        },
        {
          "s": 17,
          "text": "אתא מיטרא,"
        },
        {
          "s": 18,
          "text": "רגש עלמא)"
        },
        {
          "s": 19,
          "text": "היתה דוקא כשהעמיד אותם רבי לפני התיבה."
        },
        {
          "s": 20,
          "text": "דע\"י שהתפללו לפני התיבה והיו שלוחי ציבור,"
        },
        {
          "s": 21,
          "text": "הי' בתפלתם כח הציבור,"
        },
        {
          "s": 22,
          "text": "דבתפלת רבים"
        },
        {
          "s": 23,
          "text": "(תפלת ציבור)"
        },
        {
          "s": 24,
          "text": "כתיב50"
        },
        {
          "s": 25,
          "text": "הן א-ל כביר ולא ימאס."
        },
        {
          "s": 26,
          "text": "והגם שתפלת ציבור ישנה בכל יום,"
        },
        {
          "s": 27,
          "text": "וזה שע\"י תפלה זו דוקא נשיב זיקא וכו' הוא מפני מעלת ר\"ח ובניו שהיו דוגמת האבות,"
        },
        {
          "s": 28,
          "text": "מ\"מ,"
        },
        {
          "s": 29,
          "text": "גם בתפלת ר\"ח ובניו בכדי שיהי' נשיב זיקא וכו' הוא דוקא כשהיו שלוחי ציבור."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ולכאורה הי' אפשר לבאר זה ע\"פ הידוע51,"
        },
        {
          "s": 1,
          "text": "דמזה שבכל בקשה שבשמו\"ע חותמין ברוך אתה ה',"
        },
        {
          "s": 2,
          "text": "מוכח,"
        },
        {
          "s": 3,
          "text": "שגם בתפלת יחיד אין שום ספק כלל שהקב\"ה ממלא את בקשתו."
        },
        {
          "s": 4,
          "text": "אלא שבתפלת יחיד אפשר להיות שההשפעה תומשך לו למעלה,"
        },
        {
          "s": 5,
          "text": "או שתומשך"
        },
        {
          "s": 6,
          "text": "(גם למטה,"
        },
        {
          "s": 7,
          "text": "אבל רק)"
        },
        {
          "s": 8,
          "text": "ברוחניות52,"
        },
        {
          "s": 9,
          "text": "והמעלה דתפלת ציבור"
        },
        {
          "s": 10,
          "text": "(שהיא רצוי' ומקובלת לעולם53)"
        },
        {
          "s": 11,
          "text": "היא,"
        },
        {
          "s": 12,
          "text": "שההשפעה נמשכת גם למטה בגשמיות."
        },
        {
          "s": 13,
          "text": "והנה בתפלת ציבור,"
        },
        {
          "s": 14,
          "text": "יש כמה חילוקי דרגות,"
        },
        {
          "s": 15,
          "text": "וכל שהבקשה היא גדולה יותר,"
        },
        {
          "s": 16,
          "text": "ובפרט כשהציבור המתפללים אינם כלים ראויים לזה,"
        },
        {
          "s": 17,
          "text": "צריך לתפלה גדולה יותר,"
        },
        {
          "s": 18,
          "text": "וגם שהשליח ציבור יהי' זקן"
        },
        {
          "s": 19,
          "text": "(או המופלג שבציבור)"
        },
        {
          "s": 20,
          "text": "בכדי שתהי' תפלתו נשמעת54."
        },
        {
          "s": 21,
          "text": "ועפ\"ז הי' אפשר לבאר לכאורה בנוגע לר\"ח ובניו,"
        },
        {
          "s": 22,
          "text": "דזה שע\"י תפלתם כשהיו שלוחי ציבור נשיב זיקא ואתא מיטרא"
        },
        {
          "s": 23,
          "text": "(בגשמיות)"
        },
        {
          "s": 24,
          "text": "הוא"
        },
        {
          "s": 25,
          "text": "(בעיקר)"
        },
        {
          "s": 26,
          "text": "מצד המעלה דתפלת רבים,"
        },
        {
          "s": 27,
          "text": "אלא שגם בתפלת ציבור"
        },
        {
          "s": 28,
          "text": "(ובפרט בבקשה גדולה שאין הציבור ראוי לזה),"
        },
        {
          "s": 29,
          "text": "צריך שהשליח ציבור יהי' מי שתפלתו נשמעת."
        },
        {
          "s": 30,
          "text": "אבל ביאור זה אינו מספיק,"
        },
        {
          "s": 31,
          "text": "דמזה שאמרו שר\"ח ובניו היו דוגמת האבות,"
        },
        {
          "s": 32,
          "text": "משמע,"
        },
        {
          "s": 33,
          "text": "דזה שע\"י תפלתם נשיב זיקא ואתא מיטרא הוא מפני גודל העילוי שלהם"
        },
        {
          "s": 34,
          "text": "(שתפלתם נשמעת כתפלת האבות),"
        },
        {
          "s": 35,
          "text": "ואעפ\"כ,"
        },
        {
          "s": 36,
          "text": "זה שנשיב זיקא וכו' הי' דוקא כשהיו שלוחי ציבור."
        },
        {
          "s": 37,
          "text": "והענין הוא,"
        },
        {
          "s": 38,
          "text": "דזה שההמשכה שע\"י תפלה היא בגשמיות"
        },
        {
          "s": 39,
          "text": "[ועד שע\"י ההמשכה נעשה שינוי בהנבראים,"
        },
        {
          "s": 40,
          "text": "לרפאות החולים ולברך השנים,"
        },
        {
          "s": 41,
          "text": "ודלא כההמשכה שע\"י תורה ומצוות שהיא"
        },
        {
          "s": 42,
          "text": "(בעיקר)"
        },
        {
          "s": 43,
          "text": "למעלה55]"
        },
        {
          "s": 44,
          "text": "הוא כשההמשכה בגשמיות היא משאלות צרכיו דהמתפלל"
        },
        {
          "s": 45,
          "text": "[אלא שגם אז ישנם כו\"כ חילוקי דרגות."
        },
        {
          "s": 46,
          "text": "דנוסף להחילוק שבין תפלת יחיד ותפלת רבים,"
        },
        {
          "s": 47,
          "text": "יש חילוק גם בדרגת האדם המתפלל"
        },
        {
          "s": 48,
          "text": "(היחיד,"
        },
        {
          "s": 49,
          "text": "או השליח ציבור),"
        },
        {
          "s": 50,
          "text": "דיש מי שתפלתו נשמעת יותר]."
        },
        {
          "s": 51,
          "text": "וכיון שההמשכות דמשיב הרוח וכו' לא היו משאלות צרכיהם דר\"ח ובניו,"
        },
        {
          "s": 52,
          "text": "לכן,"
        },
        {
          "s": 53,
          "text": "ע\"י תפלתם"
        },
        {
          "s": 54,
          "text": "(שהתפללו בפני עצמם)"
        },
        {
          "s": 55,
          "text": "המשיכו ענינים אלה ברוחניות"
        },
        {
          "s": 56,
          "text": "(בדוגמת ההמשכה שע\"י תומ\"צ),"
        },
        {
          "s": 57,
          "text": "וכשהעמיד אותם רבי לפני התיבה ונעשו שלוחי ציבור דכלל ישראל,"
        },
        {
          "s": 58,
          "text": "עי\"ז נכללו ענינים אלה במשאלות צרכיהם"
        },
        {
          "s": 59,
          "text": "[נוסף שע\"י שהתפללו בתור שלוחי ציבור דכלל ישראל ניתוסף בתפלתם גם המעלה דכח הרבים],"
        },
        {
          "s": 60,
          "text": "ולכן,"
        },
        {
          "s": 61,
          "text": "ע\"י תפלתם אז נמשכו הענינים גם בגשמיות."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ועוד ענין בזה,"
        },
        {
          "s": 1,
          "text": "דזה שע\"י תפלתם של ר\"ח ובניו"
        },
        {
          "s": 2,
          "text": "[גם כשהיו שלוחי ציבור והענינים דמשיב הרוח וכו' נעשו משאלות צרכיהם]"
        },
        {
          "s": 3,
          "text": "נשיב זיקא וכו' הוא לפי שרבי שהי' שר התורה56"
        },
        {
          "s": 4,
          "text": "העמיד אותם לפני התיבה,"
        },
        {
          "s": 5,
          "text": "ועי\"ז הי' בתפלתם גם ענין התורה."
        },
        {
          "s": 6,
          "text": "והענין הוא,"
        },
        {
          "s": 7,
          "text": "דבההמשכה שע\"י תפלה שהיא עבודת התחתון,"
        },
        {
          "s": 8,
          "text": "נוגע מצב התחתון,"
        },
        {
          "s": 9,
          "text": "ובכדי שיומשך השפע להתחתון הוא דוקא כשהוא"
        },
        {
          "s": 10,
          "text": "(קצת)"
        },
        {
          "s": 11,
          "text": "כלי לההמשכה57."
        },
        {
          "s": 12,
          "text": "וההמשכה שע\"י תורה,"
        },
        {
          "s": 13,
          "text": "כיון שהיא מלמעלה,"
        },
        {
          "s": 14,
          "text": "היא נמשכת למטה מטה,"
        },
        {
          "s": 15,
          "text": "גם כשהמטה אינו כלי"
        },
        {
          "s": 16,
          "text": "(כלל)"
        },
        {
          "s": 17,
          "text": "לההמשכה58."
        },
        {
          "s": 18,
          "text": "ולכן,"
        },
        {
          "s": 19,
          "text": "זה שע\"י תפלת ר\"ח ובניו היתה ההמשכה בעולם"
        },
        {
          "s": 20,
          "text": "(אף שהעולם אז לא הי' כלי לזה)"
        },
        {
          "s": 21,
          "text": "הוא עי\"ז שבתפלתם הי'"
        },
        {
          "s": 22,
          "text": "(גם)"
        },
        {
          "s": 23,
          "text": "ענין התורה"
        },
        {
          "s": 24,
          "text": "(ע\"י שרבי העמיד אותם לפני התיבה)."
        },
        {
          "s": 25,
          "text": "וזה שההמשכה היתה דוקא ע\"י תפלתם של ר\"ח ובניו"
        },
        {
          "s": 26,
          "text": "(ולא ע\"י רבי),"
        },
        {
          "s": 27,
          "text": "הוא,"
        },
        {
          "s": 28,
          "text": "כי בכדי שיהי' שינוי בהגשמי הוא על ידי המשכת אוא\"ס שלמעלה מהשתלשלות,"
        },
        {
          "s": 29,
          "text": "דהמשכת אור זה הוא דוקא ע\"י העלאת מ\"ן דתפלה55."
        },
        {
          "s": 30,
          "text": "ובענין זה,"
        },
        {
          "s": 31,
          "text": "היו ר\"ח ובניו גדולים מרבי."
        },
        {
          "s": 32,
          "text": "כי המעלה דתפלה,"
        },
        {
          "s": 33,
          "text": "שהיא העלאת מ\"ן להמשיך אוא\"ס שלמעלה מהשתלשלות,"
        },
        {
          "s": 34,
          "text": "הוא הביטול שבתפלה,"
        },
        {
          "s": 35,
          "text": "שהאדם המתפלל הוא כעבד בפני רבו59,"
        },
        {
          "s": 36,
          "text": "ור\"ח ובניו היו דוגמת האבות,"
        },
        {
          "s": 37,
          "text": "שהיו מרכבה לאלקות60,"
        },
        {
          "s": 38,
          "text": "דמרכבה הוא ביטול בתכלית."
        },
        {
          "s": 39,
          "text": "ולכן,"
        },
        {
          "s": 40,
          "text": "תפלתם של ר\"ח ובניו היתה העלאת מ\"ן להמשיך אור נעלה ביותר,"
        },
        {
          "s": 41,
          "text": "שע\"י המשכה זו נעשה שינוי בהנבראים,"
        },
        {
          "s": 42,
          "text": "עד להשינוי דתחיית המתים."
        },
        {
          "s": 43,
          "text": "אלא שבכדי שתהי' ההמשכה בעולם"
        },
        {
          "s": 44,
          "text": "(אף שהעולם אינו כלי לזה)"
        },
        {
          "s": 45,
          "text": "הוא ע\"י שבתפלתם הי'"
        },
        {
          "s": 46,
          "text": "(גם)"
        },
        {
          "s": 47,
          "text": "ענין התורה,"
        },
        {
          "s": 48,
          "text": "המשכה מלמעלה."
        }
      ]
    }
  ]
}