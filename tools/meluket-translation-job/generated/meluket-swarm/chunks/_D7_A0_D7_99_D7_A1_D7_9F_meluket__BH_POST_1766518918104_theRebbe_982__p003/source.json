{
  "globalIndex": 740,
  "owner": 40,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918104_theRebbe_982__p003",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918104_theRebbe_982__p003",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518918104_theRebbe_982",
  "title": "מאמר כל ישראל תשל\"ג",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה ידוע29"
        },
        {
          "s": 2,
          "text": "דזה שבהחיוב דקיום המצוות כל ישראל הם שוים ובהחיוב דלימוד התורה יש כו\"כ מדריגות,"
        },
        {
          "s": 3,
          "text": "דביושבי אהל שיש להם פנאי החיוב דוהגית30"
        },
        {
          "s": 4,
          "text": "בו יומם ולילה הוא כפשוטו,"
        },
        {
          "s": 5,
          "text": "ובעלי עסקים יוצאים ידי חובתם בפרק אחד שחרית ופרק אחד ערבית31,"
        },
        {
          "s": 6,
          "text": "הוא,"
        },
        {
          "s": 7,
          "text": "כי המצוות הם רצון העליון"
        },
        {
          "s": 8,
          "text": "(כנ\"ל),"
        },
        {
          "s": 9,
          "text": "ורצון הוא למעלה מהתחלקות,"
        },
        {
          "s": 10,
          "text": "והתורה היא חכמתו ית',"
        },
        {
          "s": 11,
          "text": "ובחכמה יש התחלקות."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "שעד\"ז הוא בנוגע ללימוד התורה וקיום המצוות בפועל,"
        },
        {
          "s": 2,
          "text": "דזה שקיום המצוות הוא בכל ישראל,"
        },
        {
          "s": 3,
          "text": "דאפילו פושעי ישראל מלאים מצוות כרימון32,"
        },
        {
          "s": 4,
          "text": "משא\"כ בלימוד התורה,"
        },
        {
          "s": 5,
          "text": "הוא,"
        },
        {
          "s": 6,
          "text": "כי אפשר להיות איזה חסרון בישראל רק בהגילויים33,"
        },
        {
          "s": 7,
          "text": "וכיון שהמצוות הם רצון העליון ושייכים להגוף שבו הוא בחירת העצמות,"
        },
        {
          "s": 8,
          "text": "לכן ענין זה"
        },
        {
          "s": 9,
          "text": "(בקיום המצוות)"
        },
        {
          "s": 10,
          "text": "הוא בכל ישראל."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "וזהו34 כל ישראל יש להם חלק לעולם הבא,"
        },
        {
          "s": 2,
          "text": "דהגם שהגילוי דעולם הבא"
        },
        {
          "s": 3,
          "text": "(עולם התחי')"
        },
        {
          "s": 4,
          "text": "הוא נעלה יותר מהגילוי דג\"ע ומ\"מ גילוי זה יהי' לכל ישראל,"
        },
        {
          "s": 5,
          "text": "כי בג\"ע הוא הגילוי דהתורה שלומדים בעוה\"ז,"
        },
        {
          "s": 6,
          "text": "ולע\"ל בעולם התחי' יהי' הגילוי דהמצוות שמקיימים עכשיו."
        },
        {
          "s": 7,
          "text": "וכיון שקיום המצוות הוא בכל ישראל כנ\"ל,"
        },
        {
          "s": 8,
          "text": "לכן,"
        },
        {
          "s": 9,
          "text": "כל ישראל יש להם חלק לעולם הבא."
        },
        {
          "s": 10,
          "text": "וזהו שהגילוי דעולם התחי' יהי' לנשמות בגופים דוקא,"
        },
        {
          "s": 11,
          "text": "כי קיום המצוות שייך בעיקר להגוף,"
        },
        {
          "s": 12,
          "text": "כנ\"ל."
        },
        {
          "s": 13,
          "text": "ויש לומר,"
        },
        {
          "s": 14,
          "text": "דזה שהגילוי דעולם התחי' יהי' גם להנשמות"
        },
        {
          "s": 15,
          "text": "(שיתלבשו אז בהגוף),"
        },
        {
          "s": 16,
          "text": "הוא ע\"ד מאמר רז\"ל35"
        },
        {
          "s": 17,
          "text": "גדול תלמוד שמביא לידי מעשה,"
        },
        {
          "s": 18,
          "text": "דע\"י שהתלמוד מביא לידי מעשה נעשה גדלות בתלמוד."
        },
        {
          "s": 19,
          "text": "[וע\"ד המבואר בהמשך תרס\"ו36,"
        },
        {
          "s": 20,
          "text": "דכאשר הלימוד הוא בנוגע לפסק דין בפועל ממש,"
        },
        {
          "s": 21,
          "text": "אז הוא מייגע עצמו יותר ובא לעמקות יתירה בהענין]."
        }
      ]
    }
  ]
}