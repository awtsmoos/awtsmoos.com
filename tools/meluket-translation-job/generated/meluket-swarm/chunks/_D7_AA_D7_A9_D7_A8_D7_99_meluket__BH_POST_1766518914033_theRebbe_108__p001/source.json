{
  "globalIndex": 58,
  "owner": 8,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914033_theRebbe_108__p001",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914033_theRebbe_108__p001",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914033_theRebbe_108",
  "title": "מאמר שובה ישראל תשל\"ז",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "יום ה',"
        },
        {
          "s": 2,
          "text": "וא\"ו תשרי ה'תשל\"ז*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "שובה ישראל עד הוי' אלקיך1,"
        },
        {
          "s": 1,
          "text": "וידוע הדיוק בזה שאומר עד הוי' אלקיך,"
        },
        {
          "s": 2,
          "text": "דלכאורה הול\"ל להוי' אלקיך2."
        },
        {
          "s": 3,
          "text": "וגם מה שמזכיר כאן ב' השמות הוי' ואלקים3."
        },
        {
          "s": 4,
          "text": "גם צלה\"ב מה שממשיך בכתוב כי כשלת בעוניך,"
        },
        {
          "s": 5,
          "text": "הרי זה שתשובה"
        },
        {
          "s": 6,
          "text": "(שובה)"
        },
        {
          "s": 7,
          "text": "היא על חטא ועון מובן מעצמו,"
        },
        {
          "s": 8,
          "text": "ומה מחדש הכתוב בכי כשלת בעוניך4."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והענין הוא,"
        },
        {
          "s": 2,
          "text": "דבעבודת האדם שני ענינים בכללות."
        },
        {
          "s": 3,
          "text": "סור מרע ועשה טוב5."
        },
        {
          "s": 4,
          "text": "וידוע6"
        },
        {
          "s": 5,
          "text": "שהעבודה דסור מרע שייכת"
        },
        {
          "s": 6,
          "text": "(בעיקר)"
        },
        {
          "s": 7,
          "text": "לשם אלקים,"
        },
        {
          "s": 8,
          "text": "והעבודה דעשה טוב לשם הוי'."
        },
        {
          "s": 9,
          "text": "והענין הוא,"
        },
        {
          "s": 10,
          "text": "כדאיתא בשו\"ע7"
        },
        {
          "s": 11,
          "text": "שכשמזכירים שם הוי' צריך לכוין שהוא הי' הוה ויהי',"
        },
        {
          "s": 12,
          "text": "וכשמזכירים שם אלקים צריך לכוין שהוא תקיף ואמיץ אשר לו היכולת בעליונים ובתחתונים."
        },
        {
          "s": 13,
          "text": "ומהחילוק שבין שני ענינים אלה הוא,"
        },
        {
          "s": 14,
          "text": "דזה שלו היכולת בעליונים ובתחתונים הוא בהאלקות שבערך העולמות,"
        },
        {
          "s": 15,
          "text": "דבכללות הוא ממלא כל עלמין,"
        },
        {
          "s": 16,
          "text": "וזה שהוא הי' הוה ויהי' כאחד8"
        },
        {
          "s": 17,
          "text": "הוא בהאלקות שלמעלה מעולמות,"
        },
        {
          "s": 18,
          "text": "סובב כל עלמין."
        },
        {
          "s": 19,
          "text": "והענין הוא,"
        },
        {
          "s": 20,
          "text": "דגדר העולם הוא מקום וזמן9,"
        },
        {
          "s": 21,
          "text": "דכמו כן הוא גם בעולמות הרוחניים שהם מוגדרים בגדר דמקום וזמן,"
        },
        {
          "s": 22,
          "text": "אלא שהמקום והזמן שבהם הוא מקום וזמן רוחני10."
        },
        {
          "s": 23,
          "text": "וכיון שאור הממלא הוא אור שבערך העולמות,"
        },
        {
          "s": 24,
          "text": "מובן,"
        },
        {
          "s": 25,
          "text": "שגם באור הממלא יש דוגמת מקום וזמן,"
        },
        {
          "s": 26,
          "text": "[וכידוע11"
        },
        {
          "s": 27,
          "text": "שבאור הקו,"
        },
        {
          "s": 28,
          "text": "שבכללות הוא אור הממלא,"
        },
        {
          "s": 29,
          "text": "ישנם הענינים דמעלה ומטה"
        },
        {
          "s": 30,
          "text": "(מקום)"
        },
        {
          "s": 31,
          "text": "קדימה ואיחור"
        },
        {
          "s": 32,
          "text": "(זמן)],"
        },
        {
          "s": 33,
          "text": "שהוא השרש דמקום וזמן שבעולמות."
        },
        {
          "s": 34,
          "text": "וזה שהוי' הוא הי' הוה ויהי' כאחד למעלה מהתחלקות הזמן,"
        },
        {
          "s": 35,
          "text": "הוא,"
        },
        {
          "s": 36,
          "text": "כי הוי' הוא האור שלמעלה מעולמות."
        },
        {
          "s": 37,
          "text": "אלא שאעפ\"כ,"
        },
        {
          "s": 38,
          "text": "מזה שאומרים שהוי' הוא הי' הוה ויהי' כאחד"
        },
        {
          "s": 39,
          "text": "[דהי' הוה ויהי' הו\"ע הזמן,"
        },
        {
          "s": 40,
          "text": "אלא שהוא למעלה מהתחלקות],"
        },
        {
          "s": 41,
          "text": "מובן,"
        },
        {
          "s": 42,
          "text": "שגם הוי' שייך לזמן12"
        },
        {
          "s": 43,
          "text": "(עולמות),"
        },
        {
          "s": 44,
          "text": "דזהו גם מה שהוי' הוא לשון מהוה13,"
        },
        {
          "s": 45,
          "text": "דהתהוות כל העולמות היא משם הוי'."
        },
        {
          "s": 46,
          "text": "אלא שהעולמות כמו שמתהווים משם הוי' אינם מוגבלים כ\"כ,"
        },
        {
          "s": 47,
          "text": "ולכן,"
        },
        {
          "s": 48,
          "text": "העבר ההוה והעתיד הם כאחד."
        },
        {
          "s": 49,
          "text": "וזהו שהוי' ואלקים הוא סובב כל עלמין וממלא כל עלמין14,"
        },
        {
          "s": 50,
          "text": "דההתהוות שמאור הממלא,"
        },
        {
          "s": 51,
          "text": "מכיון שהוא בערך העולמות ומקור אליהם,"
        },
        {
          "s": 52,
          "text": "היא בדרך התלבשות."
        },
        {
          "s": 53,
          "text": "ולכן העולמות שנתהוו ממנו הם מציאות15,"
        },
        {
          "s": 54,
          "text": "כי ענין ההתלבשות הוא שהוא מתלבש להוות את העולמות,"
        },
        {
          "s": 55,
          "text": "וההתהוות שמאור הסובב,"
        },
        {
          "s": 56,
          "text": "מכיון שאין להעולמות ערך אליו,"
        },
        {
          "s": 57,
          "text": "היא באופן דבדרך ממילא,"
        },
        {
          "s": 58,
          "text": "בדוגמת פעולה הבאה מהרצון16"
        },
        {
          "s": 59,
          "text": "(דרצון הוא משל על סובב),"
        },
        {
          "s": 60,
          "text": "שהרצון הוא רק סיבה להפעולה ואינו מתלבש בה17."
        },
        {
          "s": 61,
          "text": "ולכן העולמות שנתהוו מאור הסובב אינם בבחי' מציאות15,"
        },
        {
          "s": 62,
          "text": "כי כמו שהרצון עצמו אינו מציאות והוא רק גילוי העצם"
        },
        {
          "s": 63,
          "text": "[וע\"ד הרצון שבנפש האדם שהוא רק הטיית והמשכת הנפש],"
        },
        {
          "s": 64,
          "text": "עד\"ז הוא גם בנוגע לההתהוות שמהרצון18,"
        },
        {
          "s": 65,
          "text": "שענינה הוא"
        },
        {
          "s": 66,
          "text": "(לא זה שמתהווים עולמות,"
        },
        {
          "s": 67,
          "text": "אלא)"
        },
        {
          "s": 68,
          "text": "זה שע\"י ההתהוות נשלם הרצון."
        },
        {
          "s": 69,
          "text": "וזוהי השייכות דאור הסובב ואור הממלא להשמות הוי' ואלקים,"
        },
        {
          "s": 70,
          "text": "דאור הממלא נקרא בשם אלקים מלשון כח19,"
        },
        {
          "s": 71,
          "text": "כי הוא בדוגמת כח שענינו הוא לפעול20."
        },
        {
          "s": 72,
          "text": "אלא שמכיון שמציאות העולמות הוא עי\"ז שכח האלקי מהווה אותם בכל רגע ורגע מאין ליש21,"
        },
        {
          "s": 73,
          "text": "לכן הכוונה בשם אלקים היא אשר לו היכולת בעליונים ותחתונים,"
        },
        {
          "s": 74,
          "text": "שהממשלה והשליטה שלו"
        },
        {
          "s": 75,
          "text": "(אלקים מלשון שררה22)"
        },
        {
          "s": 76,
          "text": "על העליונים והתחתונים היא גם לאחר שנתהוו,"
        },
        {
          "s": 77,
          "text": "והשליטה עליהם היא גם בנוגע לעצם מציאותם"
        },
        {
          "s": 78,
          "text": "(אם להוות אותם אם לאו)."
        },
        {
          "s": 79,
          "text": "ואור הסובב נקרא בשם הוי',"
        },
        {
          "s": 80,
          "text": "הי' הוה ויהי' כאחד,"
        },
        {
          "s": 81,
          "text": "דמכיון שההתהוות שמאור הסובב ענינה הוא זה שע\"י ההתהוות נשלם הרצון,"
        },
        {
          "s": 82,
          "text": "הרי אין חילוק בזה בין עבר הוה ועתיד23,"
        },
        {
          "s": 83,
          "text": "הי' הוה ויהי' כאחד."
        }
      ]
    }
  ]
}