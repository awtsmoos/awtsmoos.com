{
  "globalIndex": 77,
  "owner": 27,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914115_theRebbe_704__p005",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914115_theRebbe_704__p005",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914115_theRebbe_704",
  "title": "מאמר שובה ישראל תשמ\"א",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ומזה מובן,"
        },
        {
          "s": 1,
          "text": "שבכדי שהעבודה דסור מרע"
        },
        {
          "s": 2,
          "text": "(בחי' נפש)"
        },
        {
          "s": 3,
          "text": "ודועשה טוב"
        },
        {
          "s": 4,
          "text": "(בחי' רוח)"
        },
        {
          "s": 5,
          "text": "תהי' כדבעי,"
        },
        {
          "s": 6,
          "text": "הוא ע\"י עסק התורה"
        },
        {
          "s": 7,
          "text": "(בחי' נשמה),"
        },
        {
          "s": 8,
          "text": "ובפרט ע\"י העסק בפנימיות התורה,"
        },
        {
          "s": 9,
          "text": "ברזין דאורייתא וברזין דרזין,"
        },
        {
          "s": 10,
          "text": "דבחי' פנימיות התורה הנק' סתים דאורייתא הוא המקשר ומחבר בחי' סתים דישראל לבחי' סתים דקוב\"ה84."
        },
        {
          "s": 11,
          "text": "והגם דהמשכת העצמות שבתורה הוא בכל חלקי התורה,"
        },
        {
          "s": 12,
          "text": "גם בנגלה דתורה,"
        },
        {
          "s": 13,
          "text": "וגם בקריאת אותיות התורה"
        },
        {
          "s": 14,
          "text": "(אפילו כשלא ידע מאי קאמר)"
        },
        {
          "s": 15,
          "text": "כמבואר בהמשך תער\"ב85,"
        },
        {
          "s": 16,
          "text": "הרי מבואר שם שגילוי העצמות הוא דוקא בפנימיות התורה"
        },
        {
          "s": 17,
          "text": "[כי פנימיות אבא פנימיות עתיק86,"
        },
        {
          "s": 18,
          "text": "ולכן הגילוי דפנימיות עתיק הוא דוקא בפנימיות אבא]."
        },
        {
          "s": 19,
          "text": "ובפרט בפנימיות התורה כמו שנתגלתה בתורת החסידות ע\"י הבעש\"ט,"
        },
        {
          "s": 20,
          "text": "ועאכו\"כ כמו שנתגלתה ע\"י אדמו\"ר הזקן בתורת חסידות חב\"ד,"
        },
        {
          "s": 21,
          "text": "באופן דיתפרנסון87."
        },
        {
          "s": 22,
          "text": "וע\"י העסק בתורה,"
        },
        {
          "s": 23,
          "text": "ובפרט בפנימיות התורה,"
        },
        {
          "s": 24,
          "text": "נעשה עילוי גם בהעבודה דסור מרע ודועשה טוב."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "והנה כמו שהתשובה דשובה גו' כי כשלת בעוניך אינה על עוונות כפשוטם ח\"ו,"
        },
        {
          "s": 2,
          "text": "שהרי כל ישראל בחזקת כשרות הם88,"
        },
        {
          "s": 3,
          "text": "ובפרט לאחרי התשובה דחודש אלול ודימי הסליחות,"
        },
        {
          "s": 4,
          "text": "ובפרט לאחרי ראש השנה שכל ישראל זוכין בדין,"
        },
        {
          "s": 5,
          "text": "ועד שגם בערב ראש השנה יודעים כבר בבירור שיזכו בדין89,"
        },
        {
          "s": 6,
          "text": "כי ועמך כולם צדיקים90,"
        },
        {
          "s": 7,
          "text": "ובפרט לאחרי תק\"ש שאז נעשה ענין העשירות"
        },
        {
          "s": 8,
          "text": "[וכידוע דזה שארז\"ל91"
        },
        {
          "s": 9,
          "text": "מתעשרת בסופה הוא מיד לאחרי תק\"ש],"
        },
        {
          "s": 10,
          "text": "והתשובה דשבת תשובה"
        },
        {
          "s": 11,
          "text": "(לאחרי ראש השנה)"
        },
        {
          "s": 12,
          "text": "היא רק על הישות דיש מי שאוהב"
        },
        {
          "s": 13,
          "text": "(ובזה גופא – בתכלית הדקות),"
        },
        {
          "s": 14,
          "text": "כנ\"ל"
        },
        {
          "s": 15,
          "text": "(סעיף ז),"
        },
        {
          "s": 16,
          "text": "עד\"ז הוא גם בהתשובה דועשה טוב ודבקש שלום,"
        },
        {
          "s": 17,
          "text": "דהגם שעשו גם ענינים אלו גם מקודם,"
        },
        {
          "s": 18,
          "text": "התשובה דשבת תשובה היא שקיום המצוות תהי' בהידור עוד יותר,"
        },
        {
          "s": 19,
          "text": "ועד\"ז בעסק התורה ובפרט בפנימיות התורה כמו שנתגלתה בתורת החסידות ובפרט בתורת חסידות חב\"ד,"
        },
        {
          "s": 20,
          "text": "כולל גם הענין דיפוצו מעינותיך חוצה92,"
        },
        {
          "s": 21,
          "text": "ועד שיהי' מלאה הארץ דעה את הוי' כמים לים מכסים93,"
        },
        {
          "s": 22,
          "text": "שתהי' שנת תורה שנת תשובה ושנת תפלה,"
        },
        {
          "s": 23,
          "text": "וכן גם כל הברכות שבכל האותיות,"
        },
        {
          "s": 24,
          "text": "שנת אורה שנת ברכה שנת גאולה וכו',"
        },
        {
          "s": 25,
          "text": "ובפרט – הברכה העיקרית,"
        },
        {
          "s": 26,
          "text": "גאולה שלימה ע\"י משיח צדקנו בקרוב ממש."
        }
      ]
    }
  ]
}