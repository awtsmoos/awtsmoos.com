{
  "globalIndex": 1038,
  "owner": 38,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919915_theRebbe_134__p002",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919915_theRebbe_134__p002",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919915_theRebbe_134",
  "title": "מאמר ועתה ישראל תשכ\"ז",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה14 מבואר בדרושי הצ\"צ15"
        },
        {
          "s": 2,
          "text": "בפירוש הכתוב מה ה\"א שואל מעמך,"
        },
        {
          "s": 3,
          "text": "דמה הוא ביטול,"
        },
        {
          "s": 4,
          "text": "כמו ונחנו מה16,"
        },
        {
          "s": 5,
          "text": "והוא הביטול עצמי שלמעלה מהשכל שמצד עצם הנשמה."
        },
        {
          "s": 6,
          "text": "ופירוש מה ה\"א שואל מעמך הוא שה\"א שואל מעמך הביטול דמ\"ה."
        },
        {
          "s": 7,
          "text": "דזה שהביטול דמ\"ה יש בכאו\"א מישראל מצד עצם הנשמה,"
        },
        {
          "s": 8,
          "text": "הוא בהעלם"
        },
        {
          "s": 9,
          "text": "[והעלם זה הוא לא רק מפני שנפש הבהמית מעלמת ומסתרת על ביטול זה,"
        },
        {
          "s": 10,
          "text": "אלא שגם מצד עצמו הוא נעלם,"
        },
        {
          "s": 11,
          "text": "להיותו למעלה מגילוי],"
        },
        {
          "s": 12,
          "text": "וה\"א שואל מעמך"
        },
        {
          "s": 13,
          "text": "(מכאו\"א מישראל)"
        },
        {
          "s": 14,
          "text": "שהמ\"ה שבו יהי' בגילוי."
        },
        {
          "s": 15,
          "text": "וזהו גם מה שממשיך בכתוב ליראה את הוי',"
        },
        {
          "s": 16,
          "text": "כי שרש הביטול דיראה,"
        },
        {
          "s": 17,
          "text": "גם דיראה תתאה,"
        },
        {
          "s": 18,
          "text": "הוא הביטול עצמי שמצד עצם הנשמה,"
        },
        {
          "s": 19,
          "text": "ביטול דמ\"ה."
        },
        {
          "s": 20,
          "text": "וכידוע17"
        },
        {
          "s": 21,
          "text": "החילוק בין יראה לאהבה,"
        },
        {
          "s": 22,
          "text": "דאהבה להיותה מציאות שרשה הוא בהגילויים דהנשמה,"
        },
        {
          "s": 23,
          "text": "ויראה להיותה ביטול שרשה הוא בעצם הנשמה."
        },
        {
          "s": 24,
          "text": "וזהו מה שהקשו בגמרא אטו יראה מילתא זוטרתי היא,"
        },
        {
          "s": 25,
          "text": "אף שהיראה שבפסוק זה היא היראה המביאה לקיום המצוות"
        },
        {
          "s": 26,
          "text": "(כמפורש בכתוב ליראה את ה' אלקיך ללכת בכל דרכיו18),"
        },
        {
          "s": 27,
          "text": "ובנוגע לאהבה המביאה לידי קיום המצוות מבואר בתניא19"
        },
        {
          "s": 28,
          "text": "שזה בנקל לכל אדם,"
        },
        {
          "s": 29,
          "text": "כי אהבה תלוי' בהשגה20,"
        },
        {
          "s": 30,
          "text": "ולכן,"
        },
        {
          "s": 31,
          "text": "ע\"י התבוננות,"
        },
        {
          "s": 32,
          "text": "בנקל לכל אדם להגיע לאהבה המביאה לקיום המצוות."
        },
        {
          "s": 33,
          "text": "משא\"כ יראה,"
        },
        {
          "s": 34,
          "text": "מכיון שהיא באה מהביטול דעצם הנשמה שלמעלה מהשכל,"
        },
        {
          "s": 35,
          "text": "א\"א להגיע אלי'21"
        },
        {
          "s": 36,
          "text": "ע\"י התבוננות22,"
        },
        {
          "s": 37,
          "text": "אטו יראה מילתא זוטרתי היא."
        },
        {
          "s": 38,
          "text": "ובכדי לגלות המ\"ה דהנשמה,"
        },
        {
          "s": 39,
          "text": "שרש היראה,"
        },
        {
          "s": 40,
          "text": "הוא ע\"י נתינת כח מלמעלה,"
        },
        {
          "s": 41,
          "text": "המשכה מלמעלה מהשתלשלות שעבודת האדם אינה מגעת לשם."
        },
        {
          "s": 42,
          "text": "וזהו שע\"י מאה ברכות מגיעים ליראה,"
        },
        {
          "s": 43,
          "text": "כי מאה הוא בכתר23,"
        },
        {
          "s": 44,
          "text": "וע\"י המאה ברכות,"
        },
        {
          "s": 45,
          "text": "ובפרט ע\"י ברכת המצוות,"
        },
        {
          "s": 46,
          "text": "הוא המשכת האתעדל\"ע שאין אתעדל\"ת מגעת לשם,"
        },
        {
          "s": 47,
          "text": "שע\"י המשכה זו מתגלה המ\"ה דהנשמה"
        },
        {
          "s": 48,
          "text": "[אל תקרי מה אלא מאה],"
        },
        {
          "s": 49,
          "text": "ועי\"ז באים ליראה24."
        },
        {
          "s": 50,
          "text": "וזהו לגבי משה מילתא זוטרתי היא,"
        },
        {
          "s": 51,
          "text": "כי המשכת האתעדל\"ע שאין האתעדל\"ת מגעת לשם היא"
        },
        {
          "s": 52,
          "text": "(בעיקר)"
        },
        {
          "s": 53,
          "text": "ע\"י משה25."
        },
        {
          "s": 54,
          "text": "וכידוע26,"
        },
        {
          "s": 55,
          "text": "שתורה,"
        },
        {
          "s": 56,
          "text": "תורת משה,"
        },
        {
          "s": 57,
          "text": "היא אתעדל\"ע שלמעלה מאתעדל\"ת."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ויש להוסיף,"
        },
        {
          "s": 1,
          "text": "שיש יתרון בהמשכת האתעדל\"ע שע\"י משה,"
        },
        {
          "s": 2,
          "text": "תורה,"
        },
        {
          "s": 3,
          "text": "לגבי ההמשכה שע\"י מאה ברכות."
        },
        {
          "s": 4,
          "text": "כי תורה היא בחי' פנימיות."
        },
        {
          "s": 5,
          "text": "ולכן גם המשכת האתערותא דלעילא שע\"י התורה,"
        },
        {
          "s": 6,
          "text": "היא נמשכת בפנימיות"
        },
        {
          "s": 7,
          "text": "(בדוגמת אתעדל\"ע שנמשכת ע\"י עבודה27)."
        },
        {
          "s": 8,
          "text": "ולכן,"
        },
        {
          "s": 9,
          "text": "גם היראה שנמשכת עי\"ז,"
        },
        {
          "s": 10,
          "text": "היא הרגש פנימי יותר28."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 2,
          "text": "דמה ומאה,"
        },
        {
          "s": 3,
          "text": "יש בכל אחד מהם מעלה."
        },
        {
          "s": 4,
          "text": "דזה שהמ\"ה הוא בהעלם29"
        },
        {
          "s": 5,
          "text": "ובכדי שיבוא לגילוי הוא ע\"י המשכת בחינת מאה,"
        },
        {
          "s": 6,
          "text": "אור שלמעלה מהשתלשלות – הוא מפני המעלה שבמאה לגבי מה."
        },
        {
          "s": 7,
          "text": "ולכן,"
        },
        {
          "s": 8,
          "text": "לשון מה מורה על דבר קטן,"
        },
        {
          "s": 9,
          "text": "ומאה הוא שלימות המספר"
        },
        {
          "s": 10,
          "text": "(כנ\"ל סעיף ב)."
        },
        {
          "s": 11,
          "text": "אבל לאידך,"
        },
        {
          "s": 12,
          "text": "זה שהאור שלמעלה מהשתלשלות"
        },
        {
          "s": 13,
          "text": "(מאה)"
        },
        {
          "s": 14,
          "text": "בא בגילוי למטה בכדי לעורר ולגלות המ\"ה דהנשמה – הוא מצד המעלה שבמה לגבי מאה."
        },
        {
          "s": 15,
          "text": "וע\"י המשכת בחי' מאה לעורר המ\"ה,"
        },
        {
          "s": 16,
          "text": "מיתוסף עילוי גם בבחינת מאה"
        },
        {
          "s": 17,
          "text": "(כדלקמן סעיף ח-ט)."
        }
      ]
    }
  ]
}