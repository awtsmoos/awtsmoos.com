{
  "globalIndex": 953,
  "owner": 3,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919374_theRebbe_640__p005",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919374_theRebbe_640__p005",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919374_theRebbe_640",
  "title": "מאמר עשרה שיושבין תשמ\"ב",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ונקודת הביאור בזה"
        },
        {
          "s": 1,
          "text": "(בהמאמר),"
        },
        {
          "s": 2,
          "text": "דעוזרי קאי על הניצוצות המתבררים ע\"י עבודת האדם,"
        },
        {
          "s": 3,
          "text": "שהם העוזרים של האדם."
        },
        {
          "s": 4,
          "text": "והבקשה הוי' לי בעוזרי היא,"
        },
        {
          "s": 5,
          "text": "שע\"י העבודה דבירור הניצוצות"
        },
        {
          "s": 6,
          "text": "(עוזרי)"
        },
        {
          "s": 7,
          "text": "יהי' הוי' לי,"
        },
        {
          "s": 8,
          "text": "שיומשך לו גילוי שם הוי' שלמעלה מהשתלשלות."
        },
        {
          "s": 9,
          "text": "ויש לומר,"
        },
        {
          "s": 10,
          "text": "דע\"י שהמשכת הגילוי דשם הוי' להאדם"
        },
        {
          "s": 11,
          "text": "(הוי' לי)"
        },
        {
          "s": 12,
          "text": "הוא ע\"י בירור הניצוצות"
        },
        {
          "s": 13,
          "text": "(בעוזרי),"
        },
        {
          "s": 14,
          "text": "הגילוי הוא בפנימיות."
        },
        {
          "s": 15,
          "text": "דהגילוי שנמשך לו מלמעלה בדרך אתערותא דלעילא מצד עצמה,"
        },
        {
          "s": 16,
          "text": "הוא בבחינת מקיף,"
        },
        {
          "s": 17,
          "text": "ולכן אין לו קיום70."
        },
        {
          "s": 18,
          "text": "ועד\"ז הוא בנוגע לההמשכה שנמשכת לו ע\"י בקשתו בתפלה."
        },
        {
          "s": 19,
          "text": "ולכן אומר הוי' לי בעוזרי,"
        },
        {
          "s": 20,
          "text": "שהמשכת הגילוי דשם הוי' אליו היא לא בדרך נהמא דכסופא71"
        },
        {
          "s": 21,
          "text": "אלא שזה"
        },
        {
          "s": 22,
          "text": "(כאילו)"
        },
        {
          "s": 23,
          "text": "מגיע לו עבור עבודתו בעבודת הבירורים,"
        },
        {
          "s": 24,
          "text": "תכלית כוונת הבריאה."
        },
        {
          "s": 25,
          "text": "ועי\"ז נעשה הוי' לי,"
        },
        {
          "s": 26,
          "text": "שהוא מתאחד עם הגילוי,"
        },
        {
          "s": 27,
          "text": "שלכן הגילוי הוא דבר קיים לעולם,"
        },
        {
          "s": 28,
          "text": "דכל מקום שנאמר לי אינו זז לעולם72."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "וממשיך בהכתוב ואני אראה בשונאי,"
        },
        {
          "s": 2,
          "text": "דבבירור הניצוצות שני ענינים בכללות."
        },
        {
          "s": 3,
          "text": "בירור הניצוצות שבק\"נ ע\"י עבודת הצדיקים,"
        },
        {
          "s": 4,
          "text": "ובירור הניצוצות שבגקה\"ט ע\"י עבודת התשובה."
        },
        {
          "s": 5,
          "text": "ולכן במקום שבעלי תשובה עומדין אין צדיקים גמורין יכולים לעמוד בו73,"
        },
        {
          "s": 6,
          "text": "כי שורש הניצוצות שנפלו בגקה\"ט שמתבררים ע\"י הבע\"ת הוא למעלה יותר משורש הניצוצות שנפלו בק\"נ שמתבררים ע\"י הצדיקים74."
        },
        {
          "s": 7,
          "text": "ועד\"ז הוא בעבודת הצדיקים"
        },
        {
          "s": 8,
          "text": "(ועמך כולם צדיקים75),"
        },
        {
          "s": 9,
          "text": "שיש יתרון בהבירור דדברי הרשות ע\"י העבודה דכל מעשיך יהיו לשם שמים76"
        },
        {
          "s": 10,
          "text": "על הבירור דדברים הגשמיים שע\"י קיום המצוות."
        },
        {
          "s": 11,
          "text": "דכיון שדברי הרשות,"
        },
        {
          "s": 12,
          "text": "גם כשעושה אותם לשם שמים הם נשארים דברי הרשות"
        },
        {
          "s": 13,
          "text": "(מעשיך),"
        },
        {
          "s": 14,
          "text": "לכן,"
        },
        {
          "s": 15,
          "text": "ע\"י הבירור דדברי הרשות נשלמת יותר הכוונה דדירה בתחתונים,"
        },
        {
          "s": 16,
          "text": "תחתון77"
        },
        {
          "s": 17,
          "text": "שאין תחתון למטה ממנו78."
        },
        {
          "s": 18,
          "text": "ולכן,"
        },
        {
          "s": 19,
          "text": "העלי' שנעשית בהנשמה ע\"י ירידתה למטה"
        },
        {
          "s": 20,
          "text": "[שעיקר העלי' היא עי\"ז שבירידתה למטה היא משלימה הכוונה דדירה בתחתונים79]"
        },
        {
          "s": 21,
          "text": "היא בעיקר ע\"י הבירור דדברי הרשות."
        },
        {
          "s": 22,
          "text": "וזהו ואני אראה בשונאי,"
        },
        {
          "s": 23,
          "text": "שע\"י בירור הניצוצות שבשונאי – הניצוצות שבדברים האסורים,"
        },
        {
          "s": 24,
          "text": "ועד\"ז הניצוצות שבדברי הרשות,"
        },
        {
          "s": 25,
          "text": "שגם הם נכללים ב\"שונאי\" כתורת הבעש\"ט הידועה80"
        },
        {
          "s": 26,
          "text": "עה\"פ81"
        },
        {
          "s": 27,
          "text": "כי תראה חמור שונאך – באים לראי' באלקות,"
        },
        {
          "s": 28,
          "text": "ואני אראה82."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "והנה מבואר בכ\"מ83"
        },
        {
          "s": 3,
          "text": "שהצדיקים עבודתם היא בעצמם וענין התשובה הוא שהאדם פועל גם בדבר שחוץ ממנו ומאיר את העולם."
        },
        {
          "s": 4,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 5,
          "text": "שהענין ד\"אני אראה\" בכללות הוא נוסף על בירור דברי הרשות"
        },
        {
          "s": 6,
          "text": "(בשונאי),"
        },
        {
          "s": 7,
          "text": "אלא גם ע\"י לימוד התורה עם זולתו."
        },
        {
          "s": 8,
          "text": "וכדמשמע בהמאמר"
        },
        {
          "s": 9,
          "text": "(די\"ב תמוז תרפ\"ז)"
        },
        {
          "s": 10,
          "text": "דזה שאמרו רז\"ל84"
        },
        {
          "s": 11,
          "text": "הבא לטהר מסייעין לו,"
        },
        {
          "s": 12,
          "text": "דמשמעות לשון לטהר"
        },
        {
          "s": 13,
          "text": "(ולא ליטהר)"
        },
        {
          "s": 14,
          "text": "הוא לטהר אחרים,"
        },
        {
          "s": 15,
          "text": "הוא,"
        },
        {
          "s": 16,
          "text": "כי העזר והסיוע דניצוצות המתבררים"
        },
        {
          "s": 17,
          "text": "(מסייעין לשון רבים,"
        },
        {
          "s": 18,
          "text": "ע\"ד בעוזרי)"
        },
        {
          "s": 19,
          "text": "כשבא לטהר אחרים הוא באופן נעלה יותר."
        }
      ]
    }
  ]
}