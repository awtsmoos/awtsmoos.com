{
  "globalIndex": 393,
  "owner": 43,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915996_theRebbe_995__p005",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915996_theRebbe_995__p005",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915996_theRebbe_995",
  "title": "מאמר אתה אחד תשל\"ב",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז70 י\"ל השייכות דאתה אחד לתפלת מנחה דשבת רעוא דרעוין,"
        },
        {
          "s": 2,
          "text": "דהנה ידוע71"
        },
        {
          "s": 3,
          "text": "בענין ג' הסעודות דשבת,"
        },
        {
          "s": 4,
          "text": "דסעודה השלישית דשבת היא בחי' תענוג העצמי שאין לו אחיזה בשום דבר,"
        },
        {
          "s": 5,
          "text": "שלכן נאמר בה72"
        },
        {
          "s": 6,
          "text": "היום לא,"
        },
        {
          "s": 7,
          "text": "דוגמת הבחי' דעוה\"ב שאין בו לא אכילה ולא שתי'73."
        },
        {
          "s": 8,
          "text": "ועפ\"ז יובן מה שאומרים אז דוקא אתה אחד כו' ומי כעמך כישראל גוי אחד בארץ,"
        },
        {
          "s": 9,
          "text": "כי ע\"י המשכת בחי' תענוג העצמי,"
        },
        {
          "s": 10,
          "text": "דוגמת בחי' לפני הוי',"
        },
        {
          "s": 11,
          "text": "נעשה אמיתית ענין ההתכללות בנש\"י,"
        },
        {
          "s": 12,
          "text": "ועי\"ז ממשיכים בחי' אחד גם בארץ."
        },
        {
          "s": 13,
          "text": "וזהו ג\"כ מ\"ש וישם אותה מצבה ויצק שמן על ראשה,"
        },
        {
          "s": 14,
          "text": "דהנה נת\"ל"
        },
        {
          "s": 15,
          "text": "(בד\"ה אתם נצבים לעיל74"
        },
        {
          "s": 16,
          "text": "פ\"ו)"
        },
        {
          "s": 17,
          "text": "שבענין ההתכללות ישנם ב' אופנים,"
        },
        {
          "s": 18,
          "text": "מלמטה למעלה ומלמעלה למטה."
        },
        {
          "s": 19,
          "text": "וזהו ויקח את האבן גו' וישם אותה מצבה,"
        },
        {
          "s": 20,
          "text": "ויקח גו' וישם אותה מצבה הוא בדרך העלאה75"
        },
        {
          "s": 21,
          "text": "מלמטלמ\"ע"
        },
        {
          "s": 22,
          "text": "(בדוגמת אתם נצבים שבר\"ה),"
        },
        {
          "s": 23,
          "text": "דלאחרי זה שמאבני המקום ל' רבים נעשית אבן אחת,"
        },
        {
          "s": 24,
          "text": "העלה אותה מלמטלמ\"ע עד שנעשית מצבה,"
        },
        {
          "s": 25,
          "text": "ואח\"כ ויצק שמן על ראשה,"
        },
        {
          "s": 26,
          "text": "המשכה מלמעלמ\"ט"
        },
        {
          "s": 27,
          "text": "(בדוגמת ההתכללות שמצד העילוי דיוהכ\"פ),"
        },
        {
          "s": 28,
          "text": "שעי\"ז נמשכת בחי' האחדות וההתכללות גם למטה מטה ביותר76,"
        },
        {
          "s": 29,
          "text": "דזהו\"ע ויצק שמן על ראשה,"
        },
        {
          "s": 30,
          "text": "ששמן מפעפע בכולו77."
        },
        {
          "s": 31,
          "text": "וע\"י המשכת האחדות גם למקום התחתון ביותר,"
        },
        {
          "s": 32,
          "text": "והיינו בירור הניצוצות שבדברים התחתונים"
        },
        {
          "s": 33,
          "text": "[שזהו ג\"כ ענין התנאי,"
        },
        {
          "s": 34,
          "text": "אם יהי' אלקים עמדי וגו',"
        },
        {
          "s": 35,
          "text": "שכ\"ז נוגע לענין הבירורים,"
        },
        {
          "s": 36,
          "text": "כמבואר בתו\"ח שם פ\"ט],"
        },
        {
          "s": 37,
          "text": "הנה עי\"ז והאבן הזאת גו' יהי' בית אלקים,"
        },
        {
          "s": 38,
          "text": "שבירורים אלו יוסיפו עילוי ושלימות בשם אלקים,"
        },
        {
          "s": 39,
          "text": "וגם בשם הוי' כמו שיהי' לו לאלקים,"
        },
        {
          "s": 40,
          "text": "כי עי\"ז תושלם הכוונה דנתאווה הקב\"ה להיות לו ית' דירה בתחתונים78."
        },
        {
          "s": 41,
          "text": "ולהיות שכוונה זו היא בעצמותו ית'"
        },
        {
          "s": 42,
          "text": "[דזהו מה שאמר כ\"ק אדמו\"ר הזקן אויף אַ תאוה איז קיין קשיא79,"
        },
        {
          "s": 43,
          "text": "כי בעצמותו ית' אינו שייך ענין הטעם כו'],"
        },
        {
          "s": 44,
          "text": "לכן השלמת כוונה זו מוסיפה גם בבחי' הוי' כמו שיהי' לו לאלקים."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז י\"ל השייכות של אתה אחד כו' לט' ויו\"ד כסלו80."
        },
        {
          "s": 2,
          "text": "דהנה ידועים81"
        },
        {
          "s": 3,
          "text": "דברי הצ\"צ בנוגע להסתלקות כ\"ק אדמו\"ר האמצעי \"שהסתלקות כזו לא מצינו מיום פטירת הרשב\"י ע\"ה\","
        },
        {
          "s": 4,
          "text": "וכמסופר בהקדמה לתו\"ח מבנו של כ\"ק אדמו\"ר האמצעי ש\"דרש כשעה ויותר עד שהגיע לפסוק82"
        },
        {
          "s": 5,
          "text": "כי עמך מקור חיים ..."
        },
        {
          "s": 6,
          "text": "לא סיים בוצינא קדישא למימר חיים\""
        },
        {
          "s": 7,
          "text": "(כמו שנאמר83"
        },
        {
          "s": 8,
          "text": "בהסתלקות הרשב\"י)."
        },
        {
          "s": 9,
          "text": "והנה ידוע84"
        },
        {
          "s": 10,
          "text": "בפי' הכתוב כי עמך מקור חיים,"
        },
        {
          "s": 11,
          "text": "שבחי' מקור חיים הוא רק עמך,"
        },
        {
          "s": 12,
          "text": "טפל ובטל לך."
        },
        {
          "s": 13,
          "text": "דמזה מובן שמה שאמר אז בעל ההילולא הפסוק כי עמך מקור חיים הוא בדוגמת בחד קטירא אתקטרנא85,"
        },
        {
          "s": 14,
          "text": "שלגבי בחינה זו,"
        },
        {
          "s": 15,
          "text": "הבחי' דמקור חיים היא טפל ובטל."
        },
        {
          "s": 16,
          "text": "ועפ\"ז יובן השייכות דאתה אחד כו' גוי אחד בארץ לט' כסלו,"
        },
        {
          "s": 17,
          "text": "כי הכח להמשכת בחי' אחד גם בעניני ארץ,"
        },
        {
          "s": 18,
          "text": "הוא מבחי' לפני הוי'"
        },
        {
          "s": 19,
          "text": "(כנ\"ל בד\"ה אתם נצבים),"
        },
        {
          "s": 20,
          "text": "וגם עניני ארץ המתבררים ונכללים בבחי' אחד מגיעים בעצמותו ית'"
        },
        {
          "s": 21,
          "text": "(כנ\"ל בפי' והאבן הזאת גו' יהי' בית אלקים)."
        },
        {
          "s": 22,
          "text": "וזהו ג\"כ השייכות דאתה אחד כו' לענין הגאולה,"
        },
        {
          "s": 23,
          "text": "כידוע86"
        },
        {
          "s": 24,
          "text": "\"שהבשורה מהגאולה באה בשבת ט' כסלו לעת המנחה בעת שאמר כ\"ק אדמו\"ר האמצעי דא\"ח ד\"ה אתה אחד\","
        },
        {
          "s": 25,
          "text": "כי ע\"י"
        },
        {
          "s": 26,
          "text": "(אמירת דרוש זה בשבת לעת המנחה,"
        },
        {
          "s": 27,
          "text": "רעוא דרעוין)"
        },
        {
          "s": 28,
          "text": "שפועל המשכת אחד בארץ,"
        },
        {
          "s": 29,
          "text": "בחי' ברבים היו עמדי,"
        },
        {
          "s": 30,
          "text": "הנה עי\"ז נעשה פדה בשלום נפשי."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "וזהו ג\"כ הוראה לכאו\"א ההולכים באורחותיו,"
        },
        {
          "s": 2,
          "text": "ובפרט לאלו העוסקים בהעבודה דיפוצו מעינותיך חוצה,"
        },
        {
          "s": 3,
          "text": "שזה הי' ענינו של כ\"ק אדמו\"ר האמצעי,"
        },
        {
          "s": 4,
          "text": "וכידוע87"
        },
        {
          "s": 5,
          "text": "שאדמו\"ר האמצעי – הו\"ע ספירת הבינה,"
        },
        {
          "s": 6,
          "text": "שלכן אמר דא\"ח באופן של התפשטות והתרחבות,"
        },
        {
          "s": 7,
          "text": "רחובות הנהר דבינה88,"
        },
        {
          "s": 8,
          "text": "וגילוי עתיק הוא בבינה89."
        },
        {
          "s": 9,
          "text": "ומצד ההתרחבות דבינה"
        },
        {
          "s": 10,
          "text": "(ובפרט מצד גילוי עתיק שבבינה),"
        },
        {
          "s": 11,
          "text": "נמשך הגילוי גם למטה90,"
        },
        {
          "s": 12,
          "text": "הפצת המעינות חוצה,"
        },
        {
          "s": 13,
          "text": "המשכת בחי' אחד בארץ"
        },
        {
          "s": 14,
          "text": "[ועפ\"ז יש לבאר בדא\"פ מה שבעת שאמר אדמו\"ר האמצעי הדרוש אתה אחד הנ\"ל,"
        },
        {
          "s": 15,
          "text": "הפסיק באמירתו ואמר \"שַא,"
        },
        {
          "s": 16,
          "text": "פנו מקום דער טאַטע איז דאָ\"86,"
        },
        {
          "s": 17,
          "text": "כי אדמו\"ר הזקן הו\"ע ספירת החכמה91,"
        },
        {
          "s": 18,
          "text": "והחכמה ובינה הן תרין רעין דלא מתפרשין92,"
        },
        {
          "s": 19,
          "text": "לכן בעת שאמר הדרוש אתה אחד כו' אחד בארץ,"
        },
        {
          "s": 20,
          "text": "ענין ההתרחבות דבינה,"
        },
        {
          "s": 21,
          "text": "הי' אז גם אדמו\"ר הזקן,"
        },
        {
          "s": 22,
          "text": "ספירת החכמה],"
        },
        {
          "s": 23,
          "text": "הנה ע\"י העבודה דיפוצו מעינותיך חוצה,"
        },
        {
          "s": 24,
          "text": "וכידוע93"
        },
        {
          "s": 25,
          "text": "אַז דער מיטעלער רבי האָט געוואָלט,"
        },
        {
          "s": 26,
          "text": "אַז ווען צוויי יונגעלייט טרעפן זיך זאָלן זיי ריידן בענין אריך ועתיק כו',"
        },
        {
          "s": 27,
          "text": "שזהו ענין הפצת המעיינות חוצה,"
        },
        {
          "s": 28,
          "text": "שגם כשהמעיינות באים חוצה בלייבן זיי \"מעיינות\","
        },
        {
          "s": 29,
          "text": "הנה עי\"ז נעשה פדה בשלום נפשי,"
        },
        {
          "s": 30,
          "text": "גאולה פרטית,"
        },
        {
          "s": 31,
          "text": "ומזה באים אח\"כ גם לגאולה כללית,"
        },
        {
          "s": 32,
          "text": "ועד לגאולה האמיתית והשלימה,"
        },
        {
          "s": 33,
          "text": "שאז יהי' אמיתית האחדות וההתכללות,"
        },
        {
          "s": 34,
          "text": "וכמ\"ש94"
        },
        {
          "s": 35,
          "text": "ולא ילמדו עוד איש את רעהו"
        },
        {
          "s": 36,
          "text": "(וכמבואר בד\"ה אתם נצבים הנ\"ל95),"
        },
        {
          "s": 37,
          "text": "כי מלאה הארץ דיעה את הוי' כמים לים מכסים."
        }
      ]
    }
  ]
}