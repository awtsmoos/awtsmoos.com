{
  "globalIndex": 93,
  "owner": 43,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914213_theRebbe_9__p006",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914213_theRebbe_9__p006",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914213_theRebbe_9",
  "title": "מאמר בסוכות תשבו תשל\"ח",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ג)"
        },
        {
          "s": 2,
          "text": "ועד\"ז הו\"ע סדר העבודות דראש השנה יום הכפורים וסוכות"
        },
        {
          "s": 3,
          "text": "(שתחלת ההמשכה היא באופן של כלל ואח\"כ נמשכת בפרטים)."
        },
        {
          "s": 4,
          "text": "דהנה על ראש השנה"
        },
        {
          "s": 5,
          "text": "(שאז הוא בבחי' כללות ביותר)"
        },
        {
          "s": 6,
          "text": "ארז\"ל68"
        },
        {
          "s": 7,
          "text": "דמצות היום בשופר."
        },
        {
          "s": 8,
          "text": "דאע\"פ שיום זה הוא נורא ואיום וקדוש,"
        },
        {
          "s": 9,
          "text": "מ\"מ מצותו רק מצוה אחת,"
        },
        {
          "s": 10,
          "text": "ובהמצוה עצמה הנה כל הקולות כשרים בשופר69."
        },
        {
          "s": 11,
          "text": "כי מצות ראש השנה הוא אך ורק ענין אחד."
        },
        {
          "s": 12,
          "text": "ואפי' בשכל וסברת המצוה הנה היא למעלה מפרטים,"
        },
        {
          "s": 13,
          "text": "וכל' הרמב\"ם70"
        },
        {
          "s": 14,
          "text": "שתקיעת שופר בראש השנה גזירת הכתוב היא היינו למעלה מתפיסת והשגת השכל."
        },
        {
          "s": 15,
          "text": "דבתפיסה והשגה צ\"ל מדידה וקצוות,"
        },
        {
          "s": 16,
          "text": "כמובן ופשוט,"
        },
        {
          "s": 17,
          "text": "אמנם תקיעת שופר שהיא למעלה מתפיסה והשגה"
        },
        {
          "s": 18,
          "text": "(גזירת הכתוב)"
        },
        {
          "s": 19,
          "text": "היא למעלה ממדידה וקצוות."
        },
        {
          "s": 20,
          "text": "ועד\"ז הוא ג\"כ בענין עבודת יום הכפורים,"
        },
        {
          "s": 21,
          "text": "דאע\"פ שיש בו ריבוי עבודות,"
        },
        {
          "s": 22,
          "text": "מ\"מ העבודה המיוחדת שבו היא העבודה דוכסה ענן הקטורת,"
        },
        {
          "s": 23,
          "text": "כנ\"ל."
        },
        {
          "s": 24,
          "text": "דעבודה זו היא בקה\"ק,"
        },
        {
          "s": 25,
          "text": "בחי' אחת במקום,"
        },
        {
          "s": 26,
          "text": "ובהזמן דאחת בשנה,"
        },
        {
          "s": 27,
          "text": "וע\"י הכהן גדול בחי' אחת בנפש."
        },
        {
          "s": 28,
          "text": "ועוד זאת,"
        },
        {
          "s": 29,
          "text": "שהקטורת צ\"ל אז באופן דדקה מן הדקה71."
        },
        {
          "s": 30,
          "text": "ואע\"פ שעבודת הקטורת בכלל היתה צ\"ל מן הדקה,"
        },
        {
          "s": 31,
          "text": "מ\"מ אי\"ז כמעלת הקטורת ביום הקדוש,"
        },
        {
          "s": 32,
          "text": "אחת בשנה,"
        },
        {
          "s": 33,
          "text": "שאז הקטורת היא באופן של דקה מן הדקה,"
        },
        {
          "s": 34,
          "text": "שזה מראה שמגיעים אל נקודת המציאות."
        },
        {
          "s": 35,
          "text": "ואח\"ז באה ההמשכה בפרטיות,"
        },
        {
          "s": 36,
          "text": "ובהפרטים עצמם אופן ההמשכה היא מדרגה לדרגה."
        },
        {
          "s": 37,
          "text": "דתחלת ההמשכה היא בהסוכה"
        },
        {
          "s": 38,
          "text": "(דסוכה ע\"ש סככה נקראת)."
        },
        {
          "s": 39,
          "text": "דהמשכה זו היא למעלה מהתחלקות עדיין,"
        },
        {
          "s": 40,
          "text": "שהרי בהסכך אינו שייך לחלק,"
        },
        {
          "s": 41,
          "text": "משא\"כ בהדפנות וכיו\"ב."
        },
        {
          "s": 42,
          "text": "ואופן ההמשכה שבהסכך היא כשמה,"
        },
        {
          "s": 43,
          "text": "סכך ע\"ש שסוכך על האדם מלמעלה,"
        },
        {
          "s": 44,
          "text": "עד שזה גופא"
        },
        {
          "s": 45,
          "text": "(שסוכך מלמעלה)"
        },
        {
          "s": 46,
          "text": "הוא באופן של צל דוקא ולא של אור נגלה."
        },
        {
          "s": 47,
          "text": "ודוקא אז,"
        },
        {
          "s": 48,
          "text": "כשצלתה מרובה כו'72"
        },
        {
          "s": 49,
          "text": "מקיים מצות סוכה."
        },
        {
          "s": 50,
          "text": "אמנם אח\"כ צריך להמשיך המשכה זו גם בפרטים."
        },
        {
          "s": 51,
          "text": "וזהו ענין המצוה דתשבו כעין תדורו,"
        },
        {
          "s": 52,
          "text": "שצריך להכניס תחת צל הסוכה כל עניני חייו בכל פרטיהם ופרטי פרטיהם,"
        },
        {
          "s": 53,
          "text": "ועי\"ז עושים מכל פרט ענין של מצוה."
        },
        {
          "s": 54,
          "text": "והיינו,"
        },
        {
          "s": 55,
          "text": "דהגם שבמשך כל השנה כולה צריכים לעבודה גדולה עד שיהי' בכל דרכיך דעהו73,"
        },
        {
          "s": 56,
          "text": "והחכם74"
        },
        {
          "s": 57,
          "text": "יהי' ניכר באכילתו ובשתייתו ובמשאו ומתנו כו'75,"
        },
        {
          "s": 58,
          "text": "אמנם בחג הסוכות,"
        },
        {
          "s": 59,
          "text": "מצד עצם קיום המצוה"
        },
        {
          "s": 60,
          "text": "(גם בלא העבודה דבכל דרכיך דעהו),"
        },
        {
          "s": 61,
          "text": "כשעושה דברים אלו בסוכה ה\"ה מקיים המצוה דבסוכות תשבו"
        },
        {
          "s": 62,
          "text": "(אף שהם ענינים של אכילה ושתי' ומשא ומתן כו',"
        },
        {
          "s": 63,
          "text": "כנזכר ברמב\"ם הנ\"ל)."
        },
        {
          "s": 64,
          "text": "ולאח\"ז צריך להמשיך המשכה זו"
        },
        {
          "s": 65,
          "text": "(בחי' אחת שבהסוכה אחת שיאיר בגלוי לע\"ל,"
        },
        {
          "s": 66,
          "text": "כנ\"ל במ\"ש כל האזרח בישראל ישבו בסוכות)"
        },
        {
          "s": 67,
          "text": "בעומק יותר,"
        },
        {
          "s": 68,
          "text": "שיהי' נמשך בפנימיות הנפש"
        },
        {
          "s": 69,
          "text": "(גם עתה)."
        },
        {
          "s": 70,
          "text": "וזהו\"ע המצוה דולקחתם לכם גו'"
        },
        {
          "s": 71,
          "text": "(מצות ד' מינים),"
        },
        {
          "s": 72,
          "text": "שצ\"ל ענין של לקיחה,"
        },
        {
          "s": 73,
          "text": "והלקיחה צ\"ל לכם,"
        },
        {
          "s": 74,
          "text": "להגיע אל החזה,"
        },
        {
          "s": 75,
          "text": "ועי\"ז נמשכת ההמשכה בלבו פנימה,"
        },
        {
          "s": 76,
          "text": "או כלשון הידוע76"
        },
        {
          "s": 77,
          "text": "שממשיך בנוקבא דז\"א העומדת בחזה דז\"א כמבואר בארוכה בהדרושים77"
        },
        {
          "s": 78,
          "text": "ובפרט בדרושי בעל ההילולא39."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ד)"
        },
        {
          "s": 2,
          "text": "והנה,"
        },
        {
          "s": 3,
          "text": "ע\"פ הנ\"ל שע\"י נטילת הד\"מ נמשך בפנימיות בחי' אחת"
        },
        {
          "s": 4,
          "text": "(שנמשכה תחלה ביום הכפורים ע\"י העבודה בהג' בחי' אחת בעש\"ן,"
        },
        {
          "s": 5,
          "text": "ואח\"כ בהסוכה אחת),"
        },
        {
          "s": 6,
          "text": "מובן שגם כשההמשכה באה בפרטים"
        },
        {
          "s": 7,
          "text": "(במצות ד\"מ),"
        },
        {
          "s": 8,
          "text": "ה\"ז פרטים שבהם ניכר ונגלה ומודגש הענין דאחת."
        },
        {
          "s": 9,
          "text": "והענין הוא,"
        },
        {
          "s": 10,
          "text": "כמבואר בארוכה בהמשך וככה דבעל ההילולא78"
        },
        {
          "s": 11,
          "text": "שבד\"מ אלו ניכר ענין האחדות."
        },
        {
          "s": 12,
          "text": "דבהלולב כפות תמרים חסר כתיב ודרז\"ל79"
        },
        {
          "s": 13,
          "text": "שצ\"ל כפות."
        },
        {
          "s": 14,
          "text": "דאע\"פ שבהלולב צ\"ל כו\"כ עלים מ\"מ בכדי לקיים המצוה צריך לכפותם זל\"ז."
        },
        {
          "s": 15,
          "text": "וגם כל עלה כפול מב' שג\"ז מורה על היותם באחדות כו',"
        },
        {
          "s": 16,
          "text": "וגם מורה על השלימות."
        },
        {
          "s": 17,
          "text": "וזהו שבהלולב נראה בגלוי ענין האחדות."
        },
        {
          "s": 18,
          "text": "וכן הוא בההדסים שנק' ענף עץ עבות,"
        },
        {
          "s": 19,
          "text": "עבות דוקא,"
        },
        {
          "s": 20,
          "text": "להיות שצ\"ל תלתא בחד קינא80,"
        },
        {
          "s": 21,
          "text": "דהיינו שצ\"ל ג' לכה\"פ אבל בחד קינא דוקא."
        },
        {
          "s": 22,
          "text": "שזה מורה ג\"כ על האחדות."
        },
        {
          "s": 23,
          "text": "ולכן נק' ענף ל' יחיד,"
        },
        {
          "s": 24,
          "text": "וגם עבות,"
        },
        {
          "s": 25,
          "text": "שמורה על אחדות."
        },
        {
          "s": 26,
          "text": "וכן הערבה"
        },
        {
          "s": 27,
          "text": "(ערבי נחל)"
        },
        {
          "s": 28,
          "text": "נק' ג\"כ אחוינא בגמרא81"
        },
        {
          "s": 29,
          "text": "ע\"ש שגדלים באחוה אגודות אגודות."
        },
        {
          "s": 30,
          "text": "דאע\"פ שהם ערבי"
        },
        {
          "s": 31,
          "text": "(נחל),"
        },
        {
          "s": 32,
          "text": "ל' רבים,"
        },
        {
          "s": 33,
          "text": "מ\"מ גם כמו שכל ערבה צומחת בפני עצמה,"
        },
        {
          "s": 34,
          "text": "היא מתאחדת עם האחרות באחוינא,"
        },
        {
          "s": 35,
          "text": "מל' איחוי."
        },
        {
          "s": 36,
          "text": "שזה מורה על ענין האחדות."
        },
        {
          "s": 37,
          "text": "ויתירה מזו ועולה על כולנה היא האחדות שבאתרוג,"
        },
        {
          "s": 38,
          "text": "ומשו\"ז נזכר ראשון בקרא,"
        },
        {
          "s": 39,
          "text": "ולקחתם גו' פרי עץ הדר."
        },
        {
          "s": 40,
          "text": "והענין הוא,"
        },
        {
          "s": 41,
          "text": "דהנה בגמרא82"
        },
        {
          "s": 42,
          "text": "דרשו דמ\"ש פרי עץ הדר קאי על אתרוג משום שדר באילנו משנה לשנה."
        },
        {
          "s": 43,
          "text": "דבשנה שלימה יש חילוף הזמנים מן הקצה אל הקצה,"
        },
        {
          "s": 44,
          "text": "והאתרוג סובל את כולם."
        },
        {
          "s": 45,
          "text": "ומוסיף ע\"ז בעל ההילולא דיוק נוסף83,"
        },
        {
          "s": 46,
          "text": "שלא רק שהאתרוג סובל שינויי הזמנים84"
        },
        {
          "s": 47,
          "text": "כ\"א עוד זאת שהוא גדל מהם."
        },
        {
          "s": 48,
          "text": "ומביא כהוכחה ע\"ז דבר נפלא,"
        },
        {
          "s": 49,
          "text": "כי היותו דר בלתי גידול זה אי אפשר,"
        },
        {
          "s": 50,
          "text": "שהי' מתקלקל ח\"ו"
        },
        {
          "s": 51,
          "text": "[היות שהאתרוג הוא צומח]."
        },
        {
          "s": 52,
          "text": "ומזה הוכחה שאדרבה,"
        },
        {
          "s": 53,
          "text": "האתרוג גדל מזה גופא שעוברים עליו ד' זמני השנה."
        },
        {
          "s": 54,
          "text": "וזהו\"ע האחדות שבהאתרוג,"
        },
        {
          "s": 55,
          "text": "שבו מתאחדים כל שינויי זמני השנה באופן כזה עד שדוקא ע\"י כולם הוא גדל עד שנעשה פרי עץ הדר"
        },
        {
          "s": 56,
          "text": "[ועד שמההדר שנאמר באתרוג למדים ההידור בשאר הג' מינים]."
        },
        {
          "s": 57,
          "text": "ועד\"ז ישנה האחדות בהד\"מ בענינם בעבודה רוחנית בנפש."
        },
        {
          "s": 58,
          "text": "דהנה ידוע מה דאיתא במדרש85"
        },
        {
          "s": 59,
          "text": "שהד\"מ שבלולב הם כנגד הד' סוגים שבישראל,"
        },
        {
          "s": 60,
          "text": "החל מהסוג שכנגד האתרוג שיש בו טעם וריח"
        },
        {
          "s": 61,
          "text": "(תורה ומע\"ט)"
        },
        {
          "s": 62,
          "text": "עד להסוג שכנגד הערבה שאין בו לא טעם ולא ריח."
        },
        {
          "s": 63,
          "text": "וצריך לאחד את כל הסוגים,"
        },
        {
          "s": 64,
          "text": "ודוקא עי\"ז שויעשו כולם אגודה אחת אז נעשה לעשות רצונך בלבב שלם,"
        },
        {
          "s": 65,
          "text": "וכמו שהוא בפשטות שדוקא ע\"י התאחדות כל המינים אפשר לקיים מצות ד\"מ,"
        },
        {
          "s": 66,
          "text": "ועי\"ז הוא התחלת יום חגינו באופן דושמחתם לפני ה\"א7,"
        },
        {
          "s": 67,
          "text": "ומזה ממשיך האדם אח\"כ בעבודתו בכל השנה כולה."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ו)"
        },
        {
          "s": 2,
          "text": "והנה ע\"פ הנ\"ל מובנים פרטים הנ\"ל,"
        },
        {
          "s": 3,
          "text": "ושייכות מצות לקיחת ד\"מ למצות ישיבה בסוכה,"
        },
        {
          "s": 4,
          "text": "וגם הסדר שבמצות אלו."
        },
        {
          "s": 5,
          "text": "שלאחר שקיים המצוה דבסוכות תשבו,"
        },
        {
          "s": 6,
          "text": "דהיינו שנמשכה אצלו באופן של התיישבות בחי' הסוכה אחת כמו שמאירה ונותנת כח עד שנמשכת גם בזה\"ז עוד לפני שיהי' המשכת העצמות לעת\"ל"
        },
        {
          "s": 7,
          "text": "(שעז\"נ כל האזרח גו',"
        },
        {
          "s": 8,
          "text": "ל' עתיד),"
        },
        {
          "s": 9,
          "text": "הנה לאח\"ז ע\"י לקיחת הד\"מ ממשיכים המשכה זו בבחי' פנימיות."
        },
        {
          "s": 10,
          "text": "וע\"י ההמשכה בפנימיות שע\"י הד\"מ הנה בא לענין שמחת בית השואבה."
        },
        {
          "s": 11,
          "text": "וכמבואר בארוכה ע\"י בעל ההילולא86"
        },
        {
          "s": 12,
          "text": "שע\"י הד\"מ הנה פועלים שמחה באופן דושאבתם מים בששון87,"
        },
        {
          "s": 13,
          "text": "שגם במים יש שמחה."
        },
        {
          "s": 14,
          "text": "דאע\"פ שאין שמחה אלא ביין88,"
        },
        {
          "s": 15,
          "text": "מ\"מ יהודי על ידי עבודתו בלקיחת הד\"מ פועל בהמים שיהי' ענין ניסוך המים ועי\"ז נעשה ענין השמחה,"
        },
        {
          "s": 16,
          "text": "ושאבתם מים בששון,"
        },
        {
          "s": 17,
          "text": "ועד שמי שלא ראה שמחת בית השואבה לא ראה שמחה מימיו89."
        },
        {
          "s": 18,
          "text": "ואדרבה,"
        },
        {
          "s": 19,
          "text": "בכדי שיראה שמחה בימיו צריך לראות ולקחת כח והסברה,"
        },
        {
          "s": 20,
          "text": "וגם הסברה בשכל,"
        },
        {
          "s": 21,
          "text": "משמחת בית השואבה."
        }
      ]
    }
  ]
}