{
  "globalIndex": 104,
  "owner": 4,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914293_theRebbe_757__p001",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914293_theRebbe_757__p001",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914293_theRebbe_757",
  "title": "מאמר בסוכות תשבו תש\"מ",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "אור לי\"ג תשרי,"
        },
        {
          "s": 2,
          "text": "הילולא דכ\"ק אדמו\"ר מהר\"ש,"
        },
        {
          "s": 3,
          "text": "ה'תש\"מ"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "בסוכות תשבו שבעת ימים כל האזרח בישראל ישבו בסוכות"
        },
        {
          "s": 1,
          "text": "(והטעם על זה)"
        },
        {
          "s": 2,
          "text": "למען ידעו דורותיכם כי בסוכות הושבתי את בנ\"י בהוציאי אותם מארץ מצרים גו'1."
        },
        {
          "s": 3,
          "text": "ומלשון הכתוב"
        },
        {
          "s": 4,
          "text": "(למען ידעו גו')"
        },
        {
          "s": 5,
          "text": "למדים2"
        },
        {
          "s": 6,
          "text": "שידיעה זו היא"
        },
        {
          "s": 7,
          "text": "(לא רק ענין בכוונת המצוה,"
        },
        {
          "s": 8,
          "text": "אלא)"
        },
        {
          "s": 9,
          "text": "חלק בקיום המצוה"
        },
        {
          "s": 10,
          "text": "(כדמוכח גם מלשון כ\"ק אדמו\"ר הזקן בשולחנו3)."
        },
        {
          "s": 11,
          "text": "וידועים דיוקי רבותינו נשיאינו בזה,"
        },
        {
          "s": 12,
          "text": "מה נוגע כ\"כ ידיעה זו4"
        },
        {
          "s": 13,
          "text": "עד שהיא חלק מהמצוה."
        },
        {
          "s": 14,
          "text": "וגם מהו בסוכות תשבו,"
        },
        {
          "s": 15,
          "text": "הרי סוכה הוא בחי' מקיף וענין ההתיישבות"
        },
        {
          "s": 16,
          "text": "(דתשבו כולל גם הפירוש דהתיישבות)"
        },
        {
          "s": 17,
          "text": "שייך בבחי' פנימי דוקא5,"
        },
        {
          "s": 18,
          "text": "ומזה שאומר בסוכות תשבו מוכח שגם לאחרי הישיבה נשאר הוא בחי' מקיף6,"
        },
        {
          "s": 19,
          "text": "וענין ההתיישבות צ\"ל בבחי' המקיף."
        },
        {
          "s": 20,
          "text": "גם צריך להבין מ\"ש כל האזרח בישראל ישבו בסוכות,"
        },
        {
          "s": 21,
          "text": "הרי הציווי בסוכות תשבו הוא לכל ישראל ומה מוסיף דכל האזרח בישראל ישבו בסוכות7"
        },
        {
          "s": 22,
          "text": "ובהציווי בסוכות תשבו אומר שבעת ימים משא\"כ בהציווי כל האזרח גו' אומר ישבו בסוכות סתם6."
        },
        {
          "s": 23,
          "text": "והנה מפסוק זה"
        },
        {
          "s": 24,
          "text": "(כל האזרח בישראל ישבו בסוכות)"
        },
        {
          "s": 25,
          "text": "למדים8"
        },
        {
          "s": 26,
          "text": "דכל ישראל ראוים לישב בסוכה אחת."
        },
        {
          "s": 27,
          "text": "וצ\"ל,"
        },
        {
          "s": 28,
          "text": "הרי ענין האחדות דכל ישראל"
        },
        {
          "s": 29,
          "text": "(ענין אתם נצבים היום כולכם9)"
        },
        {
          "s": 30,
          "text": "הוא גם במשך כל השנה,"
        },
        {
          "s": 31,
          "text": "ועד שמצות אהבת ישראל"
        },
        {
          "s": 32,
          "text": "[שהטעם לזה הוא לפי שכולם מתאימות ואב אחד לכולנה"
        },
        {
          "s": 33,
          "text": "(ענין האחדות)"
        },
        {
          "s": 34,
          "text": "כמבואר בתניא10]"
        },
        {
          "s": 35,
          "text": "היא כל התורה כולה ואידך פירושה הוא11,"
        },
        {
          "s": 36,
          "text": "היינו שכל מצוה היא כמו פירוש ופרט בענין האחדות דכל ישראל12,"
        },
        {
          "s": 37,
          "text": "ולמה מודגש זה במצות סוכה דוקא."
        },
        {
          "s": 38,
          "text": "וגם צריך להבין מ\"ש"
        },
        {
          "s": 39,
          "text": "(לפנ\"ז13)"
        },
        {
          "s": 40,
          "text": "ולקחתם לכם ביום הראשון פרי עץ הדר כפות תמרים וענף עץ עבות וערבי נחל,"
        },
        {
          "s": 41,
          "text": "וידוע14"
        },
        {
          "s": 42,
          "text": "שמצוה זו יש לה שייכות לענין הסוכה,"
        },
        {
          "s": 43,
          "text": "שלכן מצוה מן המובחר שנטילת ד' מינים תהי' בסוכה15."
        },
        {
          "s": 44,
          "text": "דזהו גם השייכות דנטילת ד' מינים לבחי' הדעת"
        },
        {
          "s": 45,
          "text": "(בדוגמת למען ידעו דסוכה),"
        },
        {
          "s": 46,
          "text": "כדאיתא בכתבי האריז\"ל16"
        },
        {
          "s": 47,
          "text": "שענין כוונת הנענועים דלולב הוא להמשיך דעת לנוק' דז\"א העומדת בחזה דז\"א"
        },
        {
          "s": 48,
          "text": "(שלכן צריך שהלולב ומיניו יגעו בחזה)."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדם ענין המשכת המקיף בהתיישבות"
        },
        {
          "s": 2,
          "text": "(בסוכות תשבו)"
        },
        {
          "s": 3,
          "text": "בעבודת ה' כמו שהוא במשך חיי האדם בכלל,"
        },
        {
          "s": 4,
          "text": "ועד\"ז בכל יום ויום."
        },
        {
          "s": 5,
          "text": "דהגם שענין זה בעיקרו הוא בחג הסוכות,"
        },
        {
          "s": 6,
          "text": "בסוכות תשבו,"
        },
        {
          "s": 7,
          "text": "מ\"מ התורה כללות ופרטות נאמרה17,"
        },
        {
          "s": 8,
          "text": "ויש מעין ענין זה גם במשך כל השנה."
        },
        {
          "s": 9,
          "text": "והענין הוא,"
        },
        {
          "s": 10,
          "text": "הנה ב' הענינים דמקיף ופנימי בעבודת ה' בכלל הם אמונה והשגה."
        },
        {
          "s": 11,
          "text": "ותחלה צ\"ל ענין המקיף דסוכה,"
        },
        {
          "s": 12,
          "text": "ואח\"כ צ\"ל בסוכות תשבו,"
        },
        {
          "s": 13,
          "text": "כי תחלת העבודה היא בבחי' אמונה."
        },
        {
          "s": 14,
          "text": "דכל אחד ואחד מישראל,"
        },
        {
          "s": 15,
          "text": "מיד שיצא לאויר העולם,"
        },
        {
          "s": 16,
          "text": "יש בו בחי' אמונה,"
        },
        {
          "s": 17,
          "text": "כמארז\"ל18"
        },
        {
          "s": 18,
          "text": "שישראל הם מאמינים בני מאמינים."
        },
        {
          "s": 19,
          "text": "דזהו תואר אמיתי ע\"פ תורת אמת של כאו\"א מישראל."
        },
        {
          "s": 20,
          "text": "ולאחרי שהגיע לחינוך וכו' ובא לכלל דיעה,"
        },
        {
          "s": 21,
          "text": "הנה מה שתחלה הי' אצלו בבחי' אמונה ומקיף,"
        },
        {
          "s": 22,
          "text": "נמשך בבחי' פנימיות והתיישבות,"
        },
        {
          "s": 23,
          "text": "ועד שזה נעשה כל מציאותו."
        },
        {
          "s": 24,
          "text": "ומ\"מ גם אז יש לו בחי' אמונה,"
        },
        {
          "s": 25,
          "text": "כי לאחרי וע\"י המשכת המקיף"
        },
        {
          "s": 26,
          "text": "(מה שמקודם הי' בבחי' מקיף)"
        },
        {
          "s": 27,
          "text": "בפנימיות,"
        },
        {
          "s": 28,
          "text": "נמשך בחי' מקיף עליון יותר19,"
        },
        {
          "s": 29,
          "text": "ומקיף זה הוא בבחי' אמונה."
        },
        {
          "s": 30,
          "text": "ועד\"ז הוא במשך כל ימי חייו,"
        },
        {
          "s": 31,
          "text": "דכל מה שמתעלה יותר בעבודתו ובהשגתו,"
        },
        {
          "s": 32,
          "text": "הנה מה שבתחלה הי' אצלו בבחי' אמונה,"
        },
        {
          "s": 33,
          "text": "נמשך בהבנה והשגה,"
        },
        {
          "s": 34,
          "text": "והאמונה שלו היא בבחי' נעלית יותר"
        },
        {
          "s": 35,
          "text": "[ובדוגמת כללות בנ\"י,"
        },
        {
          "s": 36,
          "text": "שבתחלה היו בכלל אוה\"ע,"
        },
        {
          "s": 37,
          "text": "שהאמונה שלהם היא רק בבחי' כח הפועל בנפעל,"
        },
        {
          "s": 38,
          "text": "ואח\"כ נתעלו כו' להיות אמונתם בבחי' סוכ\"ע,"
        },
        {
          "s": 39,
          "text": "וכמבואר בסידור שער חג המצות בתחלתו]."
        },
        {
          "s": 40,
          "text": "ועד שארז\"ל20"
        },
        {
          "s": 41,
          "text": "יאמין לכל דבר זה משה רבינו,"
        },
        {
          "s": 42,
          "text": "הגם שמשה הי' תכלית שלימות החכמה,"
        },
        {
          "s": 43,
          "text": "הרי גם לאחרי שלימות ההשגה יש ענינים שהם בבחי' אמונה למעלה מהשגה."
        },
        {
          "s": 44,
          "text": "ואדרבה,"
        },
        {
          "s": 45,
          "text": "כל מה שמשיג יותר הנה ההשגה גופא מחייבת יותר שיש ענינים שהם למעלה מהשכל,"
        },
        {
          "s": 46,
          "text": "ועד כהמאמר21"
        },
        {
          "s": 47,
          "text": "תכלית הידיעה שלא נדעך."
        }
      ]
    }
  ]
}