{
  "globalIndex": 117,
  "owner": 17,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914390_theRebbe_977__p003",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914390_theRebbe_977__p003",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914390_theRebbe_977",
  "title": "מאמר בסוכות תשבו תשכ\"ג",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "והנה הפירוש דכל האזרח בישראל ישבו בסוכות"
        },
        {
          "s": 1,
          "text": "(בפשטות)"
        },
        {
          "s": 2,
          "text": "הוא,"
        },
        {
          "s": 3,
          "text": "שישראל למטה"
        },
        {
          "s": 4,
          "text": "(נשמות בגופים)"
        },
        {
          "s": 5,
          "text": "צריכים לישב בסוכה"
        },
        {
          "s": 6,
          "text": "(כפשוטה)."
        },
        {
          "s": 7,
          "text": "וע\"פ הידוע10"
        },
        {
          "s": 8,
          "text": "שכל הפירושים שבאותו הפסוק שייכים זה לזה,"
        },
        {
          "s": 9,
          "text": "מובן,"
        },
        {
          "s": 10,
          "text": "שגם הענין דישבו בסוכות במקיף הרחוק הוא ע\"י הישיבה בסוכה כפשוטה."
        },
        {
          "s": 11,
          "text": "ועפ\"ז,"
        },
        {
          "s": 12,
          "text": "ע\"י שישראל יושבים בסוכה,"
        },
        {
          "s": 13,
          "text": "נעשה שינוי גם במקיף הרחוק."
        },
        {
          "s": 14,
          "text": "וצריך להבין,"
        },
        {
          "s": 15,
          "text": "דמבואר בכ\"מ11"
        },
        {
          "s": 16,
          "text": "עה\"פ12"
        },
        {
          "s": 17,
          "text": "כי לא אדם הוא להנחם,"
        },
        {
          "s": 18,
          "text": "דענין ניחומין וחרטה"
        },
        {
          "s": 19,
          "text": "(שינוי)"
        },
        {
          "s": 20,
          "text": "שייך רק בבחינת אדם,"
        },
        {
          "s": 21,
          "text": "אבל בבחינת לא אדם,"
        },
        {
          "s": 22,
          "text": "אין שייך ניחומין,"
        },
        {
          "s": 23,
          "text": "שינוי."
        },
        {
          "s": 24,
          "text": "והטעם על זה הוא,"
        },
        {
          "s": 25,
          "text": "כי ענין השינוי הוא"
        },
        {
          "s": 26,
          "text": "(בעיקר)"
        },
        {
          "s": 27,
          "text": "בשכל,"
        },
        {
          "s": 28,
          "text": "כי בשכל יש סברא לכאן וסברא לכאן,"
        },
        {
          "s": 29,
          "text": "וכיון שאדם הוא מוחין ומדות,"
        },
        {
          "s": 30,
          "text": "היינו שגם המדות שבאדם הם ע\"פ השכל,"
        },
        {
          "s": 31,
          "text": "לכן,"
        },
        {
          "s": 32,
          "text": "כשנעשה שינוי בשכל משתנים גם המדות."
        },
        {
          "s": 33,
          "text": "משא\"כ רצון שלמעלה מהשכל,"
        },
        {
          "s": 34,
          "text": "היינו רצון עצמי שאין לו טעם,"
        },
        {
          "s": 35,
          "text": "גם לא טעם כמוס,"
        },
        {
          "s": 36,
          "text": "אינו משתנה."
        },
        {
          "s": 37,
          "text": "ועד\"ז למעלה,"
        },
        {
          "s": 38,
          "text": "שבספירות דאצילות וגם בחיצוניות הכתר"
        },
        {
          "s": 39,
          "text": "(שגם חיצוניות הכתר נכלל בבחינת אדם),"
        },
        {
          "s": 40,
          "text": "שייך שינוי,"
        },
        {
          "s": 41,
          "text": "אבל בפנימיות הכתר"
        },
        {
          "s": 42,
          "text": "(לא אדם)"
        },
        {
          "s": 43,
          "text": "אין שייך שינוי."
        },
        {
          "s": 44,
          "text": "ועפ\"ז צריך להבין בזה דמשמע מהמאמר שע\"י שישראל יושבים בסוכה נמשך בפנימיות גם מקיף הרחוק,"
        },
        {
          "s": 45,
          "text": "דלכאורה,"
        },
        {
          "s": 46,
          "text": "איך שייך שינוי במקיף הרחוק."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 2,
          "text": "דזה שמקיף הוא מוגדר בזה שאינו בא בהתיישבות הוא כמו שהוא מצד עצמו,"
        },
        {
          "s": 3,
          "text": "אבל מצד עצמות אוא\"ס,"
        },
        {
          "s": 4,
          "text": "שלגבי' אין חילוק בין מקיף לפנימי,"
        },
        {
          "s": 5,
          "text": "גם המקיף יכול לבוא בהתיישבות."
        },
        {
          "s": 6,
          "text": "וע\"י שישראל יושבים בסוכה ממשיכים הם מעצמות אוא\"ס,"
        },
        {
          "s": 7,
          "text": "ועי\"ז גם אורות המקיפים נעשים אורות מתיישבים."
        },
        {
          "s": 8,
          "text": "ויובן זה ע\"פ הידוע13"
        },
        {
          "s": 9,
          "text": "בפירוש הכתוב14"
        },
        {
          "s": 10,
          "text": "בכסה ליום חגינו,"
        },
        {
          "s": 11,
          "text": "דהענינים ש"
        },
        {
          "s": 12,
          "text": "(בראש השנה ו)"
        },
        {
          "s": 13,
          "text": "ביום הכפורים הם בכסה"
        },
        {
          "s": 14,
          "text": "(כיסוי והעלם),"
        },
        {
          "s": 15,
          "text": "מתגלים הם בסוכות."
        },
        {
          "s": 16,
          "text": "דמזה מובן,"
        },
        {
          "s": 17,
          "text": "שהעבודה דבסוכות תשבו היא גילוי התשובה דיום הכפורים15,"
        },
        {
          "s": 18,
          "text": "שעל ידה היא ההמשכה מעצמות אוא\"ס"
        },
        {
          "s": 19,
          "text": "(כדלקמן)."
        },
        {
          "s": 20,
          "text": "וע\"י העבודה דבסוכות תשבו,"
        },
        {
          "s": 21,
          "text": "ההמשכה מעצמות אוא\"ס שע\"י התשובה דיום הכפורים היא בגילוי."
        },
        {
          "s": 22,
          "text": "ועי\"ז,"
        },
        {
          "s": 23,
          "text": "גם אורות המקיפים נעשים אורות מתיישבים."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "וע\"פ הידוע16"
        },
        {
          "s": 1,
          "text": "שעבודת האדם"
        },
        {
          "s": 2,
          "text": "(אתערותא דלתתא)"
        },
        {
          "s": 3,
          "text": "שעל ידה נעשית ההמשכה"
        },
        {
          "s": 4,
          "text": "(אתערותא דלעילא)"
        },
        {
          "s": 5,
          "text": "צריכה להיות מעין ההמשכה,"
        },
        {
          "s": 6,
          "text": "יש להוסיף,"
        },
        {
          "s": 7,
          "text": "דזה שע\"י העבודה דבסוכות תשבו נעשה שינוי למעלה"
        },
        {
          "s": 8,
          "text": "(שאורות המקיפים נעשים אורות מתיישבים)"
        },
        {
          "s": 9,
          "text": "הוא לפי שהעבודה דבסוכות תשבו שייכת"
        },
        {
          "s": 10,
          "text": "(גם)"
        },
        {
          "s": 11,
          "text": "לענין השינוי."
        },
        {
          "s": 12,
          "text": "ויובן זה בהקדים,"
        },
        {
          "s": 13,
          "text": "דהטעם"
        },
        {
          "s": 14,
          "text": "(בפשטות)"
        },
        {
          "s": 15,
          "text": "לזה שע\"י התשובה מתתקנים כל הפגמים הוא לפי שע\"י התשובה משתנה האדם ונעשה מציאות חדשה17."
        },
        {
          "s": 16,
          "text": "ובלשון הרמב\"ם18"
        },
        {
          "s": 17,
          "text": "אני אחר ואיני אותו האיש שעשה אותן המעשים."
        },
        {
          "s": 18,
          "text": "דענין זה הוא בעיקר בתשובה כפשוטה."
        },
        {
          "s": 19,
          "text": "דבצדיקים19,"
        },
        {
          "s": 20,
          "text": "גם עבודת התשובה שלהם שענינה הוא שיוצאים ממצבם וממציאותם הקודמת,"
        },
        {
          "s": 21,
          "text": "אסורה מכאן20,"
        },
        {
          "s": 22,
          "text": "מ\"מ כיון שצדיקים רוצים לעשות את רצון קונם,"
        },
        {
          "s": 23,
          "text": "והכוונה שלמעלה"
        },
        {
          "s": 24,
          "text": "(רצון קונם)"
        },
        {
          "s": 25,
          "text": "בירידת הנשמה בגוף היא לבוא לתשובה,"
        },
        {
          "s": 26,
          "text": "הרי בהרצון דהצדיקים"
        },
        {
          "s": 27,
          "text": "(גם לפני התשובה שלהם)"
        },
        {
          "s": 28,
          "text": "נכלל"
        },
        {
          "s": 29,
          "text": "(בהעלם)"
        },
        {
          "s": 30,
          "text": "גם היציאה ממציאותם שע\"י התשובה."
        },
        {
          "s": 31,
          "text": "משא\"כ בבעל תשובה כפשוטו,"
        },
        {
          "s": 32,
          "text": "כיון שקודם"
        },
        {
          "s": 33,
          "text": "(לפני התשובה)"
        },
        {
          "s": 34,
          "text": "הי' במצב כזה שלא עשה רצון הקב\"ה,"
        },
        {
          "s": 35,
          "text": "שהרי עשה עבירות במזיד,"
        },
        {
          "s": 36,
          "text": "הרי זה שעושה אח\"כ תשובה,"
        },
        {
          "s": 37,
          "text": "אין זה המשך ממצבו הקודם,"
        },
        {
          "s": 38,
          "text": "וע\"י התשובה נעשה מציאות חדשה לגמרי."
        }
      ]
    }
  ]
}