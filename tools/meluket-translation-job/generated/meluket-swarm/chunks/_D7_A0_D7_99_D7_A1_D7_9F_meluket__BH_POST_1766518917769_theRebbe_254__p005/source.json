{
  "globalIndex": 680,
  "owner": 30,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917769_theRebbe_254__p005",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917769_theRebbe_254__p005",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917769_theRebbe_254",
  "title": "מאמר ביום עשתי עשר תשל\"א",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "ועפ\"ז יש לבאר גם המעלה בזה דבחירת ישראל בהקב\"ה היא לא רק מצד הרצון דהנשמה שלמעלה מהשכל אלא גם מצד השכל"
        },
        {
          "s": 3,
          "text": "(כנ\"ל סעיף ז),"
        },
        {
          "s": 4,
          "text": "כי זה שהשרש דישראל הוא בפנימיות המקיף"
        },
        {
          "s": 5,
          "text": "(פנימיות הרצון)"
        },
        {
          "s": 6,
          "text": "הוא מפני שישראל הם בחינת פנימי,"
        },
        {
          "s": 7,
          "text": "וכידוע דשרש הפנימי הוא בפנימיות המקיף,"
        },
        {
          "s": 8,
          "text": "ולכן,"
        },
        {
          "s": 9,
          "text": "עיקר העילוי דבחירת ישראל בהקב\"ה הוא כשהרצון דהנשמה שלמעלה מהשכל"
        },
        {
          "s": 10,
          "text": "(מקיף)"
        },
        {
          "s": 11,
          "text": "נמשך ופועל גם בהשכל"
        },
        {
          "s": 12,
          "text": "(פנימי),"
        },
        {
          "s": 13,
          "text": "שעי\"ז דוקא נמשך מעצם הנשמה"
        },
        {
          "s": 14,
          "text": "(פנימיות המקיף),"
        },
        {
          "s": 15,
          "text": "שלמעלה גם מהרצון שלמעלה מהשכל"
        },
        {
          "s": 16,
          "text": "(חיצוניות המקיף)."
        },
        {
          "s": 17,
          "text": "ויש לומר,"
        },
        {
          "s": 18,
          "text": "דזהו גם מ\"ש10"
        },
        {
          "s": 19,
          "text": "חלקי הוי' אמרה נפשי"
        },
        {
          "s": 20,
          "text": "(חלקי דוקא),"
        },
        {
          "s": 21,
          "text": "דחלק הוא בחינת פנימי"
        },
        {
          "s": 22,
          "text": "(כידוע76"
        },
        {
          "s": 23,
          "text": "בענין מה טוב חלקנו ומה נעים גורלנו ומה יפה ירושתנו),"
        },
        {
          "s": 24,
          "text": "והעילוי דבחירת ישראל בהקב\"ה הוא כשהבחירה דהנשמה נמשכת בפנימיות,"
        },
        {
          "s": 25,
          "text": "בהבנה והשגה,"
        },
        {
          "s": 26,
          "text": "ובאופן שזה פועל במחשבה דיבור ומעשה,"
        },
        {
          "s": 27,
          "text": "שעי\"ז הוא ההמשכה דפנימיות המקיף."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ב)"
        },
        {
          "s": 2,
          "text": "ויש לקשר זה עם מ\"ש במדרש תהלים עה\"פ77"
        },
        {
          "s": 3,
          "text": "למנצח לדוד להזכיר,"
        },
        {
          "s": 4,
          "text": "משל למלך שהי' לו צאן וכעס עליהם גירש את הצאן והתיר את הדיר והעביר את הרועה,"
        },
        {
          "s": 5,
          "text": "אחר זמן כנס הצאן ובנה את הדיר ולרועה לא הזכיר,"
        },
        {
          "s": 6,
          "text": "אמר הרועה הרי הצאן מכונסות והדיר בנוי ואני איני נזכר."
        },
        {
          "s": 7,
          "text": "כך אמר דוד למעלה מן המזמור78"
        },
        {
          "s": 8,
          "text": "כי אלקים יושיע ציון ויבנה ערי יהודה,"
        },
        {
          "s": 9,
          "text": "הרי הדיר בנוי,"
        },
        {
          "s": 10,
          "text": "וישבו שם וירשוה וזרע עבדיו ינחלוה ואוהבי שמו ישכנו בה,"
        },
        {
          "s": 11,
          "text": "הרי הצאן מכונסות,"
        },
        {
          "s": 12,
          "text": "ואני איני נזכר,"
        },
        {
          "s": 13,
          "text": "לכך למנצח לדוד להזכיר."
        },
        {
          "s": 14,
          "text": "וצריך להבין,"
        },
        {
          "s": 15,
          "text": "הרי זה שכנס הצאן לאחרי שכעס עליהם"
        },
        {
          "s": 16,
          "text": "(ולא היו מרוצים לפניו)"
        },
        {
          "s": 17,
          "text": "הוא מפני שנתעורר שוב הרצון אליהם,"
        },
        {
          "s": 18,
          "text": "ולמה לא הזכיר"
        },
        {
          "s": 19,
          "text": "(מעצמו)"
        },
        {
          "s": 20,
          "text": "להרועה,"
        },
        {
          "s": 21,
          "text": "וצריך לבקשה מיוחדת על זה."
        },
        {
          "s": 22,
          "text": "והענין הוא,"
        },
        {
          "s": 23,
          "text": "דרצון הוא מקיף,"
        },
        {
          "s": 24,
          "text": "ואפשר שהמשכת הרצון יהי' בחיצוניות."
        },
        {
          "s": 25,
          "text": "וזהו שבקש דוד שהרועה יהי' נזכר,"
        },
        {
          "s": 26,
          "text": "דרועה הו\"ע השפעה פנימית"
        },
        {
          "s": 27,
          "text": "(כידוע79"
        },
        {
          "s": 28,
          "text": "החילוק בין רועים לנסיכים)."
        },
        {
          "s": 29,
          "text": "וכל זמן שלא ישנה ההשפעה פנימית"
        },
        {
          "s": 30,
          "text": "(הרועה),"
        },
        {
          "s": 31,
          "text": "חסר העיקר."
        },
        {
          "s": 32,
          "text": "כי המשכת המקיף עצמו היא מחיצוניות המקיף,"
        },
        {
          "s": 33,
          "text": "ושרש הפנימי הוא מפנימיות המקיף."
        },
        {
          "s": 34,
          "text": "והגם שכשהצאן מכונסות נותנים להם כל צרכיהם,"
        },
        {
          "s": 35,
          "text": "והאיך שייך לומר שאין להם רועה,"
        },
        {
          "s": 36,
          "text": "יש לומר,"
        },
        {
          "s": 37,
          "text": "דההמשכה פנימית שע\"י הרועה הוא לימוד התורה79,"
        },
        {
          "s": 38,
          "text": "ומכיון שהתורה דעכשיו היא הבל לגבי תורתו של משיח80,"
        },
        {
          "s": 39,
          "text": "נמצא שחסר עדיין אמיתית הענין דרועה"
        },
        {
          "s": 40,
          "text": "(פנימיות)."
        },
        {
          "s": 41,
          "text": "והגם שהמדובר כאן הוא לאחרי שאלקים יושיע ציון ויבנה ערי יהודה וגו' שזה יהי' בגאולה העתידה,"
        },
        {
          "s": 42,
          "text": "הרי עיקר הגילוי שיהי' בגאולה העתידה הוא הגילוי דעצמות אוא\"ס שלמעלה מהשגה,"
        },
        {
          "s": 43,
          "text": "וזו היתה בקשתו של דוד"
        },
        {
          "s": 44,
          "text": "(דוד מלכא משיחא),"
        },
        {
          "s": 45,
          "text": "וע\"י בקשתו נעשה זה,"
        },
        {
          "s": 46,
          "text": "שיהי' גם הענין דרועה,"
        },
        {
          "s": 47,
          "text": "הבנת והשגת התורה בתכלית השלימות."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ג)"
        },
        {
          "s": 2,
          "text": "וע\"פ כל הנ\"ל יש לבאר הקשר והשייכות דבחירת ישראל בהקב\"ה ובחירת הקב\"ה בישראל,"
        },
        {
          "s": 3,
          "text": "דבחירת הקב\"ה בישראל להיות לו לעם סגולה,"
        },
        {
          "s": 4,
          "text": "שרצונו הפנימי דהקב\"ה הוא בישראל"
        },
        {
          "s": 5,
          "text": "(ולא שהם אמצעי לענין אחר),"
        },
        {
          "s": 6,
          "text": "הוא השרש והנתינת כח לבחירת ישראל בהקב\"ה,"
        },
        {
          "s": 7,
          "text": "כנ\"ל בארוכה דזה שישראל בוחרים בהקב\"ה הוא מפני ששרשם הוא בפנימיות הרצון."
        },
        {
          "s": 8,
          "text": "[ויש לומר,"
        },
        {
          "s": 9,
          "text": "דזה שהבחירה בישראל הוא בהגוף,"
        },
        {
          "s": 10,
          "text": "מזה נמשך להם הכח,"
        },
        {
          "s": 11,
          "text": "שגם בענינים הגשמיים יהי' הגילוי דפנימיות הרצון,"
        },
        {
          "s": 12,
          "text": "שעי\"ז נרגש בהם שגם הגשמיות הוא בשביל עבודת ה']."
        },
        {
          "s": 13,
          "text": "ועפ\"ז יש לבאר זה שהקרבנות של אשר היו על שם הבחירה שבחר הקב\"ה בישראל,"
        },
        {
          "s": 14,
          "text": "אף שאין אישורן של ישראל אלא על שבחרו בהקב\"ה,"
        },
        {
          "s": 15,
          "text": "כי עיקר העילוי דישראל הוא"
        },
        {
          "s": 16,
          "text": "(לא זה שיש בהם מצד למעלה,"
        },
        {
          "s": 17,
          "text": "אלא)"
        },
        {
          "s": 18,
          "text": "זה שפועלים ע\"י עבודתם,"
        },
        {
          "s": 19,
          "text": "ובזה דוקא"
        },
        {
          "s": 20,
          "text": "(מה שפועלים ע\"י עבודתם)"
        },
        {
          "s": 21,
          "text": "הוא עיקר הנחת רוח והתענוג דהקב\"ה,"
        },
        {
          "s": 22,
          "text": "אלא שבכדי שיהי' להם הנתינת כח על זה הוא ע\"י ההמשכה והגילוי דבחירת הקב\"ה בישראל,"
        },
        {
          "s": 23,
          "text": "וגילוי זה נמשך ע\"י הקרבנות שהקריב אשר."
        },
        {
          "s": 24,
          "text": "דנוסף להכח שבכ\"א מישראל מצד שרשו בפנימיות הרצון,"
        },
        {
          "s": 25,
          "text": "הנה ע\"י הקרבנות דאשר,"
        },
        {
          "s": 26,
          "text": "נמשך כח זה בגילוי יותר."
        },
        {
          "s": 27,
          "text": "ויש לומר דע\"י שאמר אדמו\"ר הזקן איך וויל מער ניט אַז דיך אַליין,"
        },
        {
          "s": 28,
          "text": "ובפרט לאחרי שנתפרסם זה ע\"י הצ\"צ,"
        },
        {
          "s": 29,
          "text": "ניתן הכח"
        },
        {
          "s": 30,
          "text": "(עוד יותר)"
        },
        {
          "s": 31,
          "text": "לכאו\"א מישראל,"
        },
        {
          "s": 32,
          "text": "ובפרט לההולכים בעקבותיו ובדרכיו,"
        },
        {
          "s": 33,
          "text": "דהגם שיש לו ריבוי רצונות,"
        },
        {
          "s": 34,
          "text": "ועד לרצונות שמצד נה\"ב,"
        },
        {
          "s": 35,
          "text": "שכל הרצונות שלו יהיו בלא לב ולב,"
        },
        {
          "s": 36,
          "text": "ועיקר רצונו יהי' להשלים כוונת העצמות לעשות לו ית' דירה בתחתונים"
        },
        {
          "s": 37,
          "text": "(ע\"ד ומעין שהי' אצל אדמו\"ר הזקן שלא רצה מער ניט אַז דיך אַליין),"
        },
        {
          "s": 38,
          "text": "וגם רצונו בגשמיות יהי'"
        },
        {
          "s": 39,
          "text": "(בעיקר)"
        },
        {
          "s": 40,
          "text": "בכדי לעשות את הגשמיות כלי לאלקות."
        },
        {
          "s": 41,
          "text": "ועי\"ז יומשך לו גם ריבוי השפעה בגשמיות,"
        },
        {
          "s": 42,
          "text": "כמאמר אדמו\"ר הזקן81"
        },
        {
          "s": 43,
          "text": "אַז דער אויבערשטער גיט אידן גשמיות און אידן מאַכן פון די גשמיות רוחניות,"
        },
        {
          "s": 44,
          "text": "דמזה מובן,"
        },
        {
          "s": 45,
          "text": "דכשהקב\"ה נותן לישראל ריבוי גשמיות עושים ישראל ריבוי רוחניות,"
        },
        {
          "s": 46,
          "text": "ריבוי בכמות וריבוי באיכות,"
        },
        {
          "s": 47,
          "text": "ועד לתכלית השלימות,"
        },
        {
          "s": 48,
          "text": "ועד שמתקשרים ומתאחדים בהקב\"ה,"
        },
        {
          "s": 49,
          "text": "ישראל"
        },
        {
          "s": 50,
          "text": "(אורייתא)"
        },
        {
          "s": 51,
          "text": "וקוב\"ה כולא חד82."
        },
        {
          "s": 52,
          "text": "וכל זה נעשה מתוך שמחה וטוב לבב,"
        },
        {
          "s": 53,
          "text": "בימי ההכנה לזמן חירותנו,"
        },
        {
          "s": 54,
          "text": "וזה מביא גם את זמן חירותנו בפועל,"
        },
        {
          "s": 55,
          "text": "גאולה האמיתית והשלימה ע\"י משיח צדקנו,"
        },
        {
          "s": 56,
          "text": "בקרוב ממש."
        }
      ]
    }
  ]
}