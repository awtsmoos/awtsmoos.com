{
  "globalIndex": 1117,
  "owner": 17,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920487_theRebbe_9__p001",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920487_theRebbe_9__p001",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920487_theRebbe_9",
  "title": "מאמר לך אמר לבי תש\"כ",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ליל ג' דסליחות,"
        },
        {
          "s": 2,
          "text": "ה'תש\"כ*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "לך אמר לבי בקשו פני גו'1,"
        },
        {
          "s": 1,
          "text": "ומביא כ\"ק מו\"ח אדמו\"ר במאמרו ד\"ה זה2"
        },
        {
          "s": 2,
          "text": "פירוש רש\"י עה\"פ,"
        },
        {
          "s": 3,
          "text": "דבלך שני פירושים."
        },
        {
          "s": 4,
          "text": "בשבילך בשליחותך ובמקומך."
        },
        {
          "s": 5,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 6,
          "text": "שגם בבקשו פני שני פירושים."
        },
        {
          "s": 7,
          "text": "שבקשו הוא בקשה ותחינה,"
        },
        {
          "s": 8,
          "text": "ושבקשו הוא בקשה וחיפוש."
        },
        {
          "s": 9,
          "text": "ומבאר,"
        },
        {
          "s": 10,
          "text": "דשני ענינים אלה"
        },
        {
          "s": 11,
          "text": "(בקשה ותחינה,"
        },
        {
          "s": 12,
          "text": "בקשה וחיפוש)"
        },
        {
          "s": 13,
          "text": "הם בתפלה."
        },
        {
          "s": 14,
          "text": "דתפלה היא בקשה ותחינה,"
        },
        {
          "s": 15,
          "text": "והבקשה היא שיצליח בעבודתו לחפש ולמצוא דרכי התיקון בכל עניניו."
        },
        {
          "s": 16,
          "text": "וזהו מ\"ש לך אמר לבי בקשו פני"
        },
        {
          "s": 17,
          "text": "(לבי דוקא),"
        },
        {
          "s": 18,
          "text": "כי שני הענינים דבקשו פני הם בתפלה"
        },
        {
          "s": 19,
          "text": "(כנ\"ל),"
        },
        {
          "s": 20,
          "text": "ותפלה היא עבודה שבלב3."
        },
        {
          "s": 21,
          "text": "ומוסיף בהמאמר,"
        },
        {
          "s": 22,
          "text": "דבעבודה שבלב שני ענינים."
        },
        {
          "s": 23,
          "text": "בתוך הלב ועם הלב."
        },
        {
          "s": 24,
          "text": "ויש לומר,"
        },
        {
          "s": 25,
          "text": "דשני ענינים אלה הם בהתאם לשני הפירושים"
        },
        {
          "s": 26,
          "text": "(דלעיל)"
        },
        {
          "s": 27,
          "text": "בבקשו פני."
        },
        {
          "s": 28,
          "text": "דהבקשה ותחינה שבתפלה באה ע\"י העבודה בתוך הלב,"
        },
        {
          "s": 29,
          "text": "שבכדי שהבקשה והתחינה שלו תהי' באמת,"
        },
        {
          "s": 30,
          "text": "הוא ע\"י שמעורר את לבו,"
        },
        {
          "s": 31,
          "text": "עבודה בהלב עצמו."
        },
        {
          "s": 32,
          "text": "והחיפוש שבתפלה"
        },
        {
          "s": 33,
          "text": "(איך לתקן כל עניניו)"
        },
        {
          "s": 34,
          "text": "הוא עבודה עם הלב."
        },
        {
          "s": 35,
          "text": "היינו,"
        },
        {
          "s": 36,
          "text": "שהעבודה היא"
        },
        {
          "s": 37,
          "text": "(לא בהלב,"
        },
        {
          "s": 38,
          "text": "אלא)"
        },
        {
          "s": 39,
          "text": "בכל עניניו,"
        },
        {
          "s": 40,
          "text": "אלא שעבודה זו היא ע\"י הלב4."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ולבאר זה,"
        },
        {
          "s": 2,
          "text": "מקדים בהמאמר מ\"ש5"
        },
        {
          "s": 3,
          "text": "ומבשרי אחזה אלוקה,"
        },
        {
          "s": 4,
          "text": "דצריך להבין הרי העיקר הוא הנפש ולמה אומר ומבשרי אחזה."
        },
        {
          "s": 5,
          "text": "ומבאר,"
        },
        {
          "s": 6,
          "text": "דבראי' ישנם שני אופנים,"
        },
        {
          "s": 7,
          "text": "ראי' שכלית וראי' מוחשית."
        },
        {
          "s": 8,
          "text": "דראי' שכלית מתייחסת יותר אל הנפש,"
        },
        {
          "s": 9,
          "text": "וראי' מוחשית מתייחסת יותר אל הגוף."
        },
        {
          "s": 10,
          "text": "וחילוק זה הוא גם בנוגע להדבר הנראה."
        },
        {
          "s": 11,
          "text": "דבכל דבר יש גוף ונפש."
        },
        {
          "s": 12,
          "text": "שגם בדברים גשמיים יש הנפש שבהם6,"
        },
        {
          "s": 13,
          "text": "וגם בדברים רוחניים יש הגוף שבהם."
        },
        {
          "s": 14,
          "text": "ולכן אומר ומבשרי אחזה אלוקה,"
        },
        {
          "s": 15,
          "text": "כי הכוונה באחזה אלוקה היא לראי' מוחשית באלקות,"
        },
        {
          "s": 16,
          "text": "דישנם עניני אלקות,"
        },
        {
          "s": 17,
          "text": "כמו השגחה פרטית,"
        },
        {
          "s": 18,
          "text": "שאפשר לראותם במוחש."
        },
        {
          "s": 19,
          "text": "וממשיך בהמאמר7"
        },
        {
          "s": 20,
          "text": "בפירוש הכתוב ומבשרי אחזה אלוקה,"
        },
        {
          "s": 21,
          "text": "דכחות נפש האדם משתלשלות מהספירות שלמעלה8"
        },
        {
          "s": 22,
          "text": "כמ\"ש9"
        },
        {
          "s": 23,
          "text": "נעשה אדם בצלמנו כדמותנו,"
        },
        {
          "s": 24,
          "text": "ולכן,"
        },
        {
          "s": 25,
          "text": "מכחות נפש האדם אפשר להבין הספירות שלמעלה."
        }
      ]
    }
  ]
}