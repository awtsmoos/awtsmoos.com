{
  "globalIndex": 990,
  "owner": 40,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919663_theRebbe_89__p003",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919663_theRebbe_89__p003",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919663_theRebbe_89",
  "title": "מאמר ציון במשפט תפדה תשל\"ה",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "אמנם,"
        },
        {
          "s": 2,
          "text": "כאשר חסר בהעבודה בג' קוין הנ\"ל,"
        },
        {
          "s": 3,
          "text": "מפני חטאינו,"
        },
        {
          "s": 4,
          "text": "הנה הגם שענין החטא הוא מצד בחי' הנשמה המתלבשת בגוף,"
        },
        {
          "s": 5,
          "text": "מ\"מ זה פועל גם בעצם הנשמה."
        },
        {
          "s": 6,
          "text": "וכמ\"ש35"
        },
        {
          "s": 7,
          "text": "שובה ישראל עד ה\"א כי כשלת בעונך,"
        },
        {
          "s": 8,
          "text": "דנכשל בפועל הוא הרגל וישראל הוא אותיות לי ראש,"
        },
        {
          "s": 9,
          "text": "ראש שבנשמה,"
        },
        {
          "s": 10,
          "text": "ואומר שובה ישראל,"
        },
        {
          "s": 11,
          "text": "לפי שהכשלון דרגל הנשמה פועל גם בבחי' הנשמה שלמעלה."
        },
        {
          "s": 12,
          "text": "וכמשל אדם הנכשל ברגלו,"
        },
        {
          "s": 13,
          "text": "שעי\"ז נופל גם ראשו."
        },
        {
          "s": 14,
          "text": "וזהו\"ע ציון במשפט תפדה,"
        },
        {
          "s": 15,
          "text": "שבחי' ציון,"
        },
        {
          "s": 16,
          "text": "עצם הנשמה הנק' ציון,"
        },
        {
          "s": 17,
          "text": "צריך להיות בה הפדי' מהדברים המכסים עלי',"
        },
        {
          "s": 18,
          "text": "שמונעים הגילוי בהנשמה שבגוף."
        },
        {
          "s": 19,
          "text": "והיינו שהפדי' שצ\"ל בבחי' ציון היא לא פדי' מהשבי',"
        },
        {
          "s": 20,
          "text": "כי בעצם הנשמה אין שייך ענין השבי' ח\"ו,"
        },
        {
          "s": 21,
          "text": "וכמ\"ש36"
        },
        {
          "s": 22,
          "text": "וכבודי לאחר לא אתן,"
        },
        {
          "s": 23,
          "text": "שוכבודי37"
        },
        {
          "s": 24,
          "text": "קאי על בחי' פנימיות המלכות,"
        },
        {
          "s": 25,
          "text": "ובאדם הו\"ע פנימיות הלב,"
        },
        {
          "s": 26,
          "text": "פנימיות הנשמה ועד לבחי' עצם הנשמה,"
        },
        {
          "s": 27,
          "text": "שבחי' זו לאחר לא אתן,"
        },
        {
          "s": 28,
          "text": "ומה שצ\"ל ענין הפדי' בבחי' ציון הוא רק היציאה מהדברים המכסים עלי' כנ\"ל"
        },
        {
          "s": 29,
          "text": "[ועיין בהמבואר באגה\"ק38"
        },
        {
          "s": 30,
          "text": "ובהדרושים עה\"פ39"
        },
        {
          "s": 31,
          "text": "פדה בשלום נפשי בענין פדיית השכינה הכללית מהגלות ובענין פדיית כל ניצוץ פרטי מהשכינה שבנפש כל אחד מישראל ובשלום דוקא]."
        },
        {
          "s": 32,
          "text": "ופדי' זו היא במשפט,"
        },
        {
          "s": 33,
          "text": "היינו ע\"י התורה,"
        },
        {
          "s": 34,
          "text": "שע\"י עסק התורה מתגלה בחי' פנימיות הלב."
        },
        {
          "s": 35,
          "text": "אבל בכדי לפדות מהגלות הכחות של הנשמה"
        },
        {
          "s": 36,
          "text": "(שבהתלבשות בגוף)"
        },
        {
          "s": 37,
          "text": "שהם שבויים ממש,"
        },
        {
          "s": 38,
          "text": "צריך לצדקה דוקא,"
        },
        {
          "s": 39,
          "text": "ושבי' בצדקה."
        },
        {
          "s": 40,
          "text": "וע\"י שפודים אותם מהשבי',"
        },
        {
          "s": 41,
          "text": "נעשה עי\"ז יתרון האור בתכלית השלימות40,"
        },
        {
          "s": 42,
          "text": "וכמשל בן מלך שכאשר הוא נמצא תמיד בבית אביו,"
        },
        {
          "s": 43,
          "text": "אין השמחה בתוקף כ\"כ,"
        },
        {
          "s": 44,
          "text": "משא\"כ כאשר בן המלך הי' בשבי' וטוחן בבית האסורים כו' ויצא לחפשי אל בית אביו המלך,"
        },
        {
          "s": 45,
          "text": "הנה אז דוקא תתגדל השמחה מאד וישמחו שניהם שמחה רבה ועצומה41."
        },
        {
          "s": 46,
          "text": "ובדוגמת הידוע42"
        },
        {
          "s": 47,
          "text": "בענין גודל השמחה שתהי' לע\"ל בהזמן דג' שבועות,"
        },
        {
          "s": 48,
          "text": "ובפרט בהט' ימים,"
        },
        {
          "s": 49,
          "text": "ובפרט בימי שבעה עשר בתמוז ות\"ב,"
        },
        {
          "s": 50,
          "text": "שהשמחה דמועדים אלו"
        },
        {
          "s": 51,
          "text": "[מה שימים אלו יהפכו לששון ולשמחה ולמועדים טובים43]"
        },
        {
          "s": 52,
          "text": "תהי' שמחה גדולה ביתר שאת ויתר עז מהשמחה שבמועדים ע\"ד הרגיל."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה עצם הענין ומהטעמים שהפדי' דבחי' עצם הנשמה היא במשפט שהוא התורה,"
        },
        {
          "s": 2,
          "text": "והפדי' דבחי' כחות הנשמה שבאו בשבי' היא ע\"י צדקה שהיא כללות המצוות,"
        },
        {
          "s": 3,
          "text": "הוא לפי שהתורה והמצוות גופא הן ג\"כ דוגמת ב' ענינים אלו."
        },
        {
          "s": 4,
          "text": "דהנה התורה גם כמו שירדה למטה,"
        },
        {
          "s": 5,
          "text": "ואפילו בעת שנלמדת ע\"י אדם שאינו טהור,"
        },
        {
          "s": 6,
          "text": "היא כמו שהיא למעלה,"
        },
        {
          "s": 7,
          "text": "דבר הקב\"ה,"
        },
        {
          "s": 8,
          "text": "וכדרשת רז\"ל44"
        },
        {
          "s": 9,
          "text": "עה\"פ45"
        },
        {
          "s": 10,
          "text": "הלא כה דברי כאש."
        },
        {
          "s": 11,
          "text": "ומכיון שהתורה אינה בבחי' התלבשות46,"
        },
        {
          "s": 12,
          "text": "הרי אין שייך בה ענין השבי' ח\"ו47."
        },
        {
          "s": 13,
          "text": "אלא שמ\"מ שייך בה ענין הפדי',"
        },
        {
          "s": 14,
          "text": "כי מצד הדברים שבהם ירדה"
        },
        {
          "s": 15,
          "text": "(אף שאינה בהם בהתלבשות),"
        },
        {
          "s": 16,
          "text": "אפשר שתהי' בהעלם48."
        },
        {
          "s": 17,
          "text": "אמנם המצוות,"
        },
        {
          "s": 18,
          "text": "מכיון שנתלבשו בדברים גשמיים,"
        },
        {
          "s": 19,
          "text": "ציצית בצמר גשמי ותפלין בקלף גשמי וכו' וגם המצוות דחובות הלבבות צ\"ל נרגשות במוח ולב הגשמי,"
        },
        {
          "s": 20,
          "text": "לכן שייך בהן ענין השבי'49,"
        },
        {
          "s": 21,
          "text": "וכמשנ\"ת במ\"א בענין מ\"ש50"
        },
        {
          "s": 22,
          "text": "שש אנכי על אמרתיך כמוצא שלל רב,"
        },
        {
          "s": 23,
          "text": "שבמצוות הו\"ע השלל,"
        },
        {
          "s": 24,
          "text": "היינו ששוללים ומוציאים מהלעו\"ז."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "והנה ב' ענינים הנ\"ל"
        },
        {
          "s": 2,
          "text": "(בחי' ציון במשפט תפדה ובחי' ושבי' בצדקה)"
        },
        {
          "s": 3,
          "text": "ישנם בכל ג' הבחינות דעולם שנה ונפש51."
        },
        {
          "s": 4,
          "text": "ובבחי' נפש ישנם הן,"
        },
        {
          "s": 5,
          "text": "הן בכאו\"א מישראל והן בכללות ישראל"
        },
        {
          "s": 6,
          "text": "[כי מכיון שכאו\"א מישראל הוא עולם מלא52,"
        },
        {
          "s": 7,
          "text": "הרי מובן שהענינים שבכ\"א מישראל ישנם גם בכללות ישראל והענינים שבכללות ישראל ישנם גם בכאו\"א מישראל]."
        },
        {
          "s": 8,
          "text": "דכאו\"א מישראל53,"
        },
        {
          "s": 9,
          "text": "מצד עבודתו בקו התורה הוא בבחי' ציון במשפט תפדה,"
        },
        {
          "s": 10,
          "text": "ומצד עבודתו בקו המצוות הוא בבחי' ושבי' בצדקה."
        },
        {
          "s": 11,
          "text": "ועד\"ז הוא גם בכללות ישראל,"
        },
        {
          "s": 12,
          "text": "שנחלקים לב' סוגים יששכר וזבולון,"
        },
        {
          "s": 13,
          "text": "מארי תורה ומארי עובדין טבין."
        },
        {
          "s": 14,
          "text": "דמארי תורה הם בבחי' ציון במשפט תפדה,"
        },
        {
          "s": 15,
          "text": "ומארי עובדין טבין הם בבחי' ושבי' בצדקה."
        },
        {
          "s": 16,
          "text": "ובכללות יותר,"
        },
        {
          "s": 17,
          "text": "הוא החילוק שבין צדיקים לבעלי תשובה54."
        },
        {
          "s": 18,
          "text": "דבצדיקים אין שייך ענין השבי' ח\"ו שהרי לא יאונה לצדיק כל און55,"
        },
        {
          "s": 19,
          "text": "ועאכו\"כ בצדיקים שהם בבחי' ולבי חלל בקרבי56."
        },
        {
          "s": 20,
          "text": "אלא שאעפ\"כ גם בהם שייך ענין הפדי',"
        },
        {
          "s": 21,
          "text": "וע\"ד שלפעמים הצדיק נתפס בעון הדור57,"
        },
        {
          "s": 22,
          "text": "או ע\"ד מ\"ש גבי משה לך רד כי שחת עמך,"
        },
        {
          "s": 23,
          "text": "שמצד שחת עמך נעשה ירידה58"
        },
        {
          "s": 24,
          "text": "גם בו59,"
        },
        {
          "s": 25,
          "text": "אבל מ\"מ מכיון שהירידה"
        },
        {
          "s": 26,
          "text": "(וגם כאשר הוא נתפס בעון הדור)"
        },
        {
          "s": 27,
          "text": "היא רק מצד ענינים שמחוץ ממנו,"
        },
        {
          "s": 28,
          "text": "הרי גם אז אינו בשבי' ח\"ו כי ענינו של הצדיק הוא סימנא"
        },
        {
          "s": 29,
          "text": "(דאלקות)"
        },
        {
          "s": 30,
          "text": "בעלמא,"
        },
        {
          "s": 31,
          "text": "כביכול,"
        },
        {
          "s": 32,
          "text": "כמו שאלקות הוא למטה60,"
        },
        {
          "s": 33,
          "text": "דמציאותו"
        },
        {
          "s": 34,
          "text": "(של הצדיק)"
        },
        {
          "s": 35,
          "text": "היא זה שהוא שלוחו של אדם העליון,"
        },
        {
          "s": 36,
          "text": "ושלוחו של אדם הוא כמותו ממש61."
        },
        {
          "s": 37,
          "text": "ולכן,"
        },
        {
          "s": 38,
          "text": "גם כשהוא בבחי' ירידה וכו',"
        },
        {
          "s": 39,
          "text": "הפדי' שלו היא ע\"י התורה."
        },
        {
          "s": 40,
          "text": "לפי שבתורה,"
        },
        {
          "s": 41,
          "text": "ענין זה"
        },
        {
          "s": 42,
          "text": "(שגם למטה היא אלקות בגילוי,"
        },
        {
          "s": 43,
          "text": "כנ\"ל בענין הלא כה דברי כאש)"
        },
        {
          "s": 44,
          "text": "הוא בגלוי יותר."
        },
        {
          "s": 45,
          "text": "משא\"כ הבע\"ת,"
        },
        {
          "s": 46,
          "text": "שעבודתם היא להוציא את הניצוצות שנפלו ונשבו בלעו\"ז"
        },
        {
          "s": 47,
          "text": "(ובדוגמת – בקדושה – מ\"ש וישב ממנו שבי62),"
        },
        {
          "s": 48,
          "text": "לכן גם הגאולה צ\"ל בדוגמת זה."
        },
        {
          "s": 49,
          "text": "וזהו ושבי' בצדקה,"
        },
        {
          "s": 50,
          "text": "שגאולתם בקו הצדקה,"
        },
        {
          "s": 51,
          "text": "שהיא כללות המצוות"
        },
        {
          "s": 52,
          "text": "[דכל הגוף נכלל בימין63],"
        },
        {
          "s": 53,
          "text": "שהעבודה דקו המצוות היא באופן דשבי ושלל."
        },
        {
          "s": 54,
          "text": "וע\"ד המבואר באגה\"ק64,"
        },
        {
          "s": 55,
          "text": "שעיקר עבודת ה' בעתים הללו בעקבות משיחא היא עבודת הצדקה"
        },
        {
          "s": 56,
          "text": "(ודלא כבזמן הש\"ס,"
        },
        {
          "s": 57,
          "text": "שת\"ת הי' עיקר העבודה שלהם),"
        },
        {
          "s": 58,
          "text": "כי בכדי להעלות את סוכת דוד שנפלה עד בחי' רגלים ועקביים שהיא בחי' עשי' צ\"ל גם העבודה בבחי' עשי' דוקא,"
        },
        {
          "s": 59,
          "text": "שהיא מעשה הצדקה."
        }
      ]
    }
  ]
}