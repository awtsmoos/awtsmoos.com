{
  "globalIndex": 1011,
  "owner": 11,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919765_theRebbe_137__p007",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919765_theRebbe_137__p007",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919765_theRebbe_137",
  "title": "מאמר קץ שם לחושך תשכ\"ד",
  "part": 7,
  "sections": [
    {
      "v": 18,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "וצריך להבין,"
        },
        {
          "s": 2,
          "text": "דלכאורה,"
        },
        {
          "s": 3,
          "text": "כיון שמצד האור דלהאיר את העולמות אי אפשר שיתבטל החושך"
        },
        {
          "s": 4,
          "text": "(ורק שנדחה מפני האור),"
        },
        {
          "s": 5,
          "text": "וזה שבגאולה העתידה יתבטל חושך הגלות,"
        },
        {
          "s": 6,
          "text": "הוא מפני שאז יהי' גילוי אור חדש שלמעלה משייכות לעולמות,"
        },
        {
          "s": 7,
          "text": "הרי העולם עצמו"
        },
        {
          "s": 8,
          "text": "(כמו שהוא מצד הגדרים שלו,"
        },
        {
          "s": 9,
          "text": "כולל גם הגילויים השייכים לעולם)"
        },
        {
          "s": 10,
          "text": "יהי' נשאר בגלות ח\"ו."
        },
        {
          "s": 11,
          "text": "ונקודת הביאור בזה,"
        },
        {
          "s": 12,
          "text": "דמהטעמים43"
        },
        {
          "s": 13,
          "text": "על זה שהבריאה היתה באופן שבתחלה נמצא האור שלמעלה משייכות לעולמות וממנו דוקא נמשך האור דלהאיר את העולמות"
        },
        {
          "s": 14,
          "text": "(אף שלכאורה הי' צריך להיות מלכתחילה המשכת האור ששייך לעולמות),"
        },
        {
          "s": 15,
          "text": "הוא,"
        },
        {
          "s": 16,
          "text": "בכדי שהאור השייך לעולמות יהי' בו"
        },
        {
          "s": 17,
          "text": "(בהעלם עכ\"פ)"
        },
        {
          "s": 18,
          "text": "מהאור שלמעלה משייכות לעולמות."
        },
        {
          "s": 19,
          "text": "ועפ\"ז מובן,"
        },
        {
          "s": 20,
          "text": "דהגם שביטול חושך הגלות יהי' ע\"י גילוי עצם האור שלמעלה מהאור דלהאיר את העולמות,"
        },
        {
          "s": 21,
          "text": "מ\"מ תהי' הגאולה"
        },
        {
          "s": 22,
          "text": "(גם)"
        },
        {
          "s": 23,
          "text": "בגדרי העולם,"
        },
        {
          "s": 24,
          "text": "כי גילוי עצם האור שיהי' בגאולה העתידה יאיר בגילוי גם בהאור שלהאיר את העולמות,"
        },
        {
          "s": 25,
          "text": "ועי\"ז – בהעולם."
        }
      ]
    },
    {
      "v": 19,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש לבאר השייכות דהענינים שבהמאמר לביטול חושך הגלות,"
        },
        {
          "s": 1,
          "text": "דזה שמאריך בהמאמר בענין התכללות האור במקורו,"
        },
        {
          "s": 2,
          "text": "יש לומר,"
        },
        {
          "s": 3,
          "text": "שהוא מפני שביטול חושך הגלות הוא ע\"י גילוי אור הכלול"
        },
        {
          "s": 4,
          "text": "(כנ\"ל סעיף ח)."
        },
        {
          "s": 5,
          "text": "וזה שמבאר שטבע הרצוא וההתכללות הוא גם בהאור שבגדר התלבשות וגם בהאור המלובש בכלים,"
        },
        {
          "s": 6,
          "text": "הוא,"
        },
        {
          "s": 7,
          "text": "כי בכדי שביטול חושך הגלות"
        },
        {
          "s": 8,
          "text": "(שמצד גילוי אור הכלול)"
        },
        {
          "s": 9,
          "text": "יהי' בגדר העולם,"
        },
        {
          "s": 10,
          "text": "הוא ע\"י שענין התכללות האור במקורו הוא גם בהאור המלובש בכלים."
        }
      ]
    },
    {
      "v": 20,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "וזהו קץ שם לחושך,"
        },
        {
          "s": 3,
          "text": "דיש לומר,"
        },
        {
          "s": 4,
          "text": "שפירוש תיבת קץ בפסוק זה הוא"
        },
        {
          "s": 5,
          "text": "(גם)"
        },
        {
          "s": 6,
          "text": "קץ"
        },
        {
          "s": 7,
          "text": "(וגבול)"
        },
        {
          "s": 8,
          "text": "לראשיתו44."
        },
        {
          "s": 9,
          "text": "היינו,"
        },
        {
          "s": 10,
          "text": "שענין החושך יש לו נתינת מקום רק בהאור שלהאיר את העולמות,"
        },
        {
          "s": 11,
          "text": "ולא בעצם האור."
        },
        {
          "s": 12,
          "text": "ונאמר קץ שם לחושך"
        },
        {
          "s": 13,
          "text": "(דזה שיש קץ לחושך הוא מפני ששם לו קץ,"
        },
        {
          "s": 14,
          "text": "אבל מצד עצמו אין לו קץ),"
        },
        {
          "s": 15,
          "text": "כי זה שהחושך אין לו נתינת מקום בעצם האור שאינו בגדר עולמות,"
        },
        {
          "s": 16,
          "text": "אין זה שייך להעולם."
        },
        {
          "s": 17,
          "text": "וכיון שמצד הגדר דעולם אין לו קץ בראשו"
        },
        {
          "s": 18,
          "text": "(כיון שיש לו נתינת מקום בכל הדרגות השייכים לעולמות),"
        },
        {
          "s": 19,
          "text": "הרי גם הקץ שבסופו,"
        },
        {
          "s": 20,
          "text": "מה שלע\"ל יתבטל החושך,"
        },
        {
          "s": 21,
          "text": "לא יהי' ח\"ו בגדר העולם."
        },
        {
          "s": 22,
          "text": "ולכן קץ שם לחושך,"
        },
        {
          "s": 23,
          "text": "קץ בראשו,"
        },
        {
          "s": 24,
          "text": "שהאור שאינו בגדר עולמות,"
        },
        {
          "s": 25,
          "text": "ששם אין נתינת מקום לחושך,"
        },
        {
          "s": 26,
          "text": "יהי' שייך להעולם45."
        },
        {
          "s": 27,
          "text": "ועי\"ז,"
        },
        {
          "s": 28,
          "text": "גם הקץ שבסופו,"
        },
        {
          "s": 29,
          "text": "ביטול החושך שיהי' בגאולה העתידה,"
        },
        {
          "s": 30,
          "text": "יהי' בהעולם בפנימיותו."
        },
        {
          "s": 31,
          "text": "דהגם שביטול החושך שיהי' לע\"ל הוא ע\"י שיהי' אז גילוי אור חדש שלמעלה משייכות לעולמות,"
        },
        {
          "s": 32,
          "text": "מ\"מ,"
        },
        {
          "s": 33,
          "text": "יהי' העולם כלי גם לאור זה,"
        },
        {
          "s": 34,
          "text": "ועי\"ז תושלם הכוונה דדירה לו ית' בתחתונים46,"
        },
        {
          "s": 35,
          "text": "שהתחתון"
        },
        {
          "s": 36,
          "text": "(מצד הגדרים שלו)"
        },
        {
          "s": 37,
          "text": "יהי' דירה לו ית',"
        },
        {
          "s": 38,
          "text": "לו לעצמותו47."
        }
      ]
    }
  ]
}