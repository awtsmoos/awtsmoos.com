{
  "globalIndex": 133,
  "owner": 33,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914464_theRebbe_108__p001",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914464_theRebbe_108__p001",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914464_theRebbe_108",
  "title": "מאמר אתה הראת לדעת תשל\"ז",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "יום שמחת תורה ה'תשל\"ז"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "אתה הראת לדעת כי הוי' הוא האלקים אין עוד מלבדו1,"
        },
        {
          "s": 1,
          "text": "הנה פסוק זה הוא פסוק הראשון של י\"ז הפסוקים2"
        },
        {
          "s": 2,
          "text": "שאומרים קודם ההקפות."
        },
        {
          "s": 3,
          "text": "ויש לומר,"
        },
        {
          "s": 4,
          "text": "דפסוק זה הוא גם הראש של כל י\"ז הפסוקים שכולל אותם,"
        },
        {
          "s": 5,
          "text": "בדוגמת הראש שכולל את כל אברי הגוף."
        },
        {
          "s": 6,
          "text": "וצריך להבין השייכות דאתה הראת גו' להקפות."
        },
        {
          "s": 7,
          "text": "וביותר צריך ביאור ע\"פ מ\"ש כ\"ק מו\"ח אדמו\"ר3"
        },
        {
          "s": 8,
          "text": "דענין אמירת הפסוקים קודם הקפות הוא שמביאים טעמים4"
        },
        {
          "s": 9,
          "text": "על השמחה דשמע\"צ ושמח\"ת"
        },
        {
          "s": 10,
          "text": "[וע\"ד פסוקי מלכיות זכרונות ושופרות5],"
        },
        {
          "s": 11,
          "text": "דלכאורה,"
        },
        {
          "s": 12,
          "text": "מהי השייכות דאתה הראת לדעת גו' להשמחה דשמע\"צ ושמח\"ת."
        },
        {
          "s": 13,
          "text": "ובפרט שאתה הראת לדעת הי' בשעת מ\"ת,"
        },
        {
          "s": 14,
          "text": "שהוא בחג השבועות."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים המבואר במק\"א6"
        },
        {
          "s": 2,
          "text": "בענין אמירת פסוקי מלכיות זכרונות ושופרות,"
        },
        {
          "s": 3,
          "text": "דזה שצריך להביא ראי' מן התורה על ענינים אלו7,"
        },
        {
          "s": 4,
          "text": "הוא,"
        },
        {
          "s": 5,
          "text": "כי הם ענינים נעלים ביותר8."
        },
        {
          "s": 6,
          "text": "ומזה מובן גם בנוגע לאמירת הפסוקים קודם ההקפות,"
        },
        {
          "s": 7,
          "text": "דזה שצריך להביא ראי' מן התורה על ענין ההקפות הוא מפני שהוא ענין נעלה ביותר."
        },
        {
          "s": 8,
          "text": "וכמבואר בלקו\"ת9,"
        },
        {
          "s": 9,
          "text": "דזה שבתורה כתוב רק ניסוך היין משא\"כ ניסוך המים הוא רק הלכה למשה מסיני10,"
        },
        {
          "s": 10,
          "text": "הוא,"
        },
        {
          "s": 11,
          "text": "כי ניסוך המים הוא ענין נעלה ביותר שאינו יכול להתלבש באותיות דתורה שבכתב,"
        },
        {
          "s": 12,
          "text": "וזה שענין ההקפות לא נתפרש אפילו בתורה שבע\"פ והוא רק מנהג הוא מפני שענין ההקפות הוא נעלה יותר גם מניסוך המים."
        },
        {
          "s": 13,
          "text": "וזהו גם11"
        },
        {
          "s": 14,
          "text": "שהשמחה דשמחת בית השואבה,"
        },
        {
          "s": 15,
          "text": "עם היותה שמחה גדולה ביותר,"
        },
        {
          "s": 16,
          "text": "ועד שמי שלא ראה שמחת בית השואבה לא ראה שמחה מימיו12,"
        },
        {
          "s": 17,
          "text": "מ\"מ,"
        },
        {
          "s": 18,
          "text": "היא במדידה והגבלה."
        },
        {
          "s": 19,
          "text": "כמובן גם מזה שבהשמחה דשמחת בית השואבה,"
        },
        {
          "s": 20,
          "text": "רק חסידים ואנשי מעשה היו מרקדין,"
        },
        {
          "s": 21,
          "text": "וכל העם באים לראות ולשמוע13,"
        },
        {
          "s": 22,
          "text": "דזה שיש הגבלה בנוגע לאלו השמחים בשמחה זו הוא מפני שכללות שמחה זו"
        },
        {
          "s": 23,
          "text": "(גם בהחסידים ואנשי מעשה)"
        },
        {
          "s": 24,
          "text": "היא במדידה והגבלה."
        },
        {
          "s": 25,
          "text": "משא\"כ בשמח\"ת,"
        },
        {
          "s": 26,
          "text": "ובפרט בהקפות,"
        },
        {
          "s": 27,
          "text": "מנהג ישראל"
        },
        {
          "s": 28,
          "text": "(שתורה היא14)"
        },
        {
          "s": 29,
          "text": "שכל ישראל"
        },
        {
          "s": 30,
          "text": "(אנשים נשים וטף)"
        },
        {
          "s": 31,
          "text": "שמחים בה15,"
        },
        {
          "s": 32,
          "text": "לפי ששמחה זו היא למעלה ממדידה והגבלה."
        },
        {
          "s": 33,
          "text": "[ולהוסיף,"
        },
        {
          "s": 34,
          "text": "שההקפות בפעם השני'"
        },
        {
          "s": 35,
          "text": "(בליל שמח\"ת)"
        },
        {
          "s": 36,
          "text": "מנהגן להיות בשמחה גדולה יותר מבפעם הראשונה"
        },
        {
          "s": 37,
          "text": "(בליל שמע\"צ),"
        },
        {
          "s": 38,
          "text": "כי כאשר השמחה היא באותה המדה שבהקפות הקודמות,"
        },
        {
          "s": 39,
          "text": "בלי הוספה וריבוי,"
        },
        {
          "s": 40,
          "text": "אינה שמחה בשלימות,"
        },
        {
          "s": 41,
          "text": "כיון שנתיישנה."
        },
        {
          "s": 42,
          "text": "ואדמו\"ר הזקן כותב בסידורו16,"
        },
        {
          "s": 43,
          "text": "שגם כשערך את ההקפות בשמחה בבית הכנסת שלו,"
        },
        {
          "s": 44,
          "text": "כשבא לבית הכנסת אחר שלא גמרו ההקפות ירנן וישמח גם עמהם]."
        },
        {
          "s": 45,
          "text": "וי\"ל שדוגמתו העבודה דתמליכוני עליכם שבר\"ה17,"
        },
        {
          "s": 46,
          "text": "שבה שוים כל ישראל,"
        },
        {
          "s": 47,
          "text": "כמ\"ש18"
        },
        {
          "s": 48,
          "text": "אתם נצבים היום כולכם גו',"
        },
        {
          "s": 49,
          "text": "שבהיום דר\"ה כל עשרה הסוגים דישראל"
        },
        {
          "s": 50,
          "text": "(מראשיכם שבטיכם עד חוטב עציך ושואב מימיך)"
        },
        {
          "s": 51,
          "text": "הם לאחדים כאחד19."
        }
      ]
    }
  ]
}