{
  "globalIndex": 852,
  "owner": 2,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918811_theRebbe_734__p003",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918811_theRebbe_734__p003",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918811_theRebbe_734",
  "title": "מאמר ביום השני הקריב תשל\"ב",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "וכמו31 שהוא בענין ההשפעה עד\"ז הוא בכל עשי',"
        },
        {
          "s": 1,
          "text": "דסופן הוא העשי' עצמה,"
        },
        {
          "s": 2,
          "text": "עשיית ופעולת האדם,"
        },
        {
          "s": 3,
          "text": "ונקראת בשם סופן,"
        },
        {
          "s": 4,
          "text": "כי כח המעשה הוא כח היותר אחרון,"
        },
        {
          "s": 5,
          "text": "וגם פעולת המעשה באה בסוף."
        },
        {
          "s": 6,
          "text": "דבתחילה הוא התענוג,"
        },
        {
          "s": 7,
          "text": "ומזה נמשכים הרצון והשכל והמדות,"
        },
        {
          "s": 8,
          "text": "והמדות מתלבשים במחשבה ודיבור,"
        },
        {
          "s": 9,
          "text": "ולאח\"ז באה המעשה32."
        },
        {
          "s": 10,
          "text": "ונעוץ סופן בתחלתן ותחלתן בסופן,"
        },
        {
          "s": 11,
          "text": "דשורש המעשה הוא בהתענוג,"
        },
        {
          "s": 12,
          "text": "שהוא ה\"תחילה\","
        },
        {
          "s": 13,
          "text": "סיבת הרצון ושאר הכחות."
        },
        {
          "s": 14,
          "text": "וכן נעוץ תחלתן בסופן,"
        },
        {
          "s": 15,
          "text": "שגילוי התענוג הוא בהמעשה דוקא."
        },
        {
          "s": 16,
          "text": "וסוף מעשה הוא"
        },
        {
          "s": 17,
          "text": "(לא העשי' עצמה,"
        },
        {
          "s": 18,
          "text": "אלא)"
        },
        {
          "s": 19,
          "text": "המעשה שנעשתה ע\"י עשיית ופעולת האדם."
        },
        {
          "s": 20,
          "text": "ועיקר ענין סוף מעשה הוא בהמעשה הבאה ע\"י עשייתו שאינה תלוי' ברצון האדם."
        },
        {
          "s": 21,
          "text": "וכמו אומן העושה מלאכה,"
        },
        {
          "s": 22,
          "text": "דזה שהאומן אינו יכול לקבל על עצמו שהמלאכה תהי' בהצלחה"
        },
        {
          "s": 23,
          "text": "[דענין זה אינו תלוי בהאומן."
        },
        {
          "s": 24,
          "text": "וע\"ד המבואר לעיל בענין קבלת ההשפעה,"
        },
        {
          "s": 25,
          "text": "שזה תלוי בהמקבל ולא בהנותן]."
        },
        {
          "s": 26,
          "text": "וסוף מעשה במחשבה תחלה,"
        },
        {
          "s": 27,
          "text": "שהתענוג של האומן מזה שהמלאכה נעשתה בתכלית ההידור והיופי"
        },
        {
          "s": 28,
          "text": "(באופן דהצלחה)"
        },
        {
          "s": 29,
          "text": "הוא תענוג נעלה יותר מהתענוג שבעשיית המלאכה."
        },
        {
          "s": 30,
          "text": "דהתענוג שנעשית המלאכה הוא תענוג המורכב"
        },
        {
          "s": 31,
          "text": "(תענוג מעשיית המלאכה),"
        },
        {
          "s": 32,
          "text": "וע\"י שרואה שהמלאכה נעשתה בהידור וביופי,"
        },
        {
          "s": 33,
          "text": "מתגלה תענוג הפשוט"
        },
        {
          "s": 34,
          "text": "(כמבואר בהמשך הנ\"ל)."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה ידוע33"
        },
        {
          "s": 2,
          "text": "שמעלת האדם מתחילה מכח הדיבור שבו34"
        },
        {
          "s": 3,
          "text": "(משא\"כ מעשה ישנו גם בבע\"ח)."
        },
        {
          "s": 4,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 5,
          "text": "דשני הענינים שבמעשה – עשיית ופעולת האדם"
        },
        {
          "s": 6,
          "text": "(סופן),"
        },
        {
          "s": 7,
          "text": "והמעשה הבאה ע\"י העשי' שלו"
        },
        {
          "s": 8,
          "text": "(סוף מעשה)"
        },
        {
          "s": 9,
          "text": "– יש"
        },
        {
          "s": 10,
          "text": "(דוגמתם)"
        },
        {
          "s": 11,
          "text": "גם בהעשי' דהאדם."
        },
        {
          "s": 12,
          "text": "דזה שהכחות דהאדם"
        },
        {
          "s": 13,
          "text": "(שכל ומדות מחשבה ודיבור)"
        },
        {
          "s": 14,
          "text": "נמשכים ומתלבשים בהמעשה,"
        },
        {
          "s": 15,
          "text": "הוא ע\"ד עשיית ופעולת האדם,"
        },
        {
          "s": 16,
          "text": "והמעשה עצמה"
        },
        {
          "s": 17,
          "text": "(כמו שהיא נבדלת מהכחות שלמעלה ממנה,"
        },
        {
          "s": 18,
          "text": "שהם עיקר האדם)"
        },
        {
          "s": 19,
          "text": "הוא ע\"ד המעשה"
        },
        {
          "s": 20,
          "text": "(שמחוץ להאדם)"
        },
        {
          "s": 21,
          "text": "שנעשה ע\"י עשיית ופעולת האדם."
        },
        {
          "s": 22,
          "text": "והחילוק דשני הענינים בשרשם בנפש הוא,"
        },
        {
          "s": 23,
          "text": "דשורש המעשה ששייך להכחות שלמעלה ממנו"
        },
        {
          "s": 24,
          "text": "(היינו ההתלבשות דהכחות בהמעשה)"
        },
        {
          "s": 25,
          "text": "הוא בבחינת הגילוי דהנפש."
        },
        {
          "s": 26,
          "text": "והיינו35,"
        },
        {
          "s": 27,
          "text": "שגם השורש דענין זה שבמעשה הוא בהנפש שלמעלה מהכחות."
        },
        {
          "s": 28,
          "text": "כי הכחות מצד עצמם הם מובדלים ואין ביכלתם לירד למטה כ\"כ ולהתלבש במעשה,"
        },
        {
          "s": 29,
          "text": "וזה שאפשר להם לירד ולהתלבש במעשה הוא ע\"י שנמשך בהם מהנפש"
        },
        {
          "s": 30,
          "text": "(שלמעלה מהכחות),"
        },
        {
          "s": 31,
          "text": "שהיא נמצאת בכל הכחות והאיברים בשוה."
        },
        {
          "s": 32,
          "text": "אבל ענין זה שבנפש"
        },
        {
          "s": 33,
          "text": "(שביכלתה לירד למטה מטה)"
        },
        {
          "s": 34,
          "text": "הוא בחינת הגילוי שלה – ע\"ד נעוץ סופן בתחלתן,"
        },
        {
          "s": 35,
          "text": "שהשורש דסופן"
        },
        {
          "s": 36,
          "text": "(עשיית האדם)"
        },
        {
          "s": 37,
          "text": "הוא בה\"תחילה\","
        },
        {
          "s": 38,
          "text": "שורש ההשפעה."
        },
        {
          "s": 39,
          "text": "והשורש דהמעשה עצמו"
        },
        {
          "s": 40,
          "text": "(כמו שהוא נבדל מהכחות שלמעלה ממנו)"
        },
        {
          "s": 41,
          "text": "הוא בעצם הנפש35"
        },
        {
          "s": 42,
          "text": "– ע\"ד סוף מעשה במחשבה תחלה,"
        },
        {
          "s": 43,
          "text": "שהשורש דסוף מעשה"
        },
        {
          "s": 44,
          "text": "(שמחוץ להאדם)"
        },
        {
          "s": 45,
          "text": "הוא בהתחילה שלפני תחלת המחשבה,"
        },
        {
          "s": 46,
          "text": "למעלה משורש ההשפעה."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דבמעלת המעשה בזה שעל ידה מתגלה הבל\"ג דהנפש שלמעלה מהכחות – השכל והמדות וכו' הם לפני"
        },
        {
          "s": 2,
          "text": "[ולמעלה מ]"
        },
        {
          "s": 3,
          "text": "המעשה."
        },
        {
          "s": 4,
          "text": "דכיון שגילוי הבל\"ג דהנפש הוא שהשכל והמדות נמשכים ומתלבשים בהמעשה,"
        },
        {
          "s": 5,
          "text": "הרי השכל והמדות קודמים להמעשה."
        },
        {
          "s": 6,
          "text": "וגם למעלה מהמעשה."
        },
        {
          "s": 7,
          "text": "שהרי המעלה דמעשה"
        },
        {
          "s": 8,
          "text": "(בבחינה זו)"
        },
        {
          "s": 9,
          "text": "היא לא בהמעשה עצמו אלא בזה שהשכל והמדות מתלבשים בהמעשה"
        },
        {
          "s": 10,
          "text": "[ועפ\"ז יש לבאר מה שאמרו תלמוד גדול שמביא לידי מעשה"
        },
        {
          "s": 11,
          "text": "(דלכאורה,"
        },
        {
          "s": 12,
          "text": "מזה עצמו שהגדלות דתלמוד הוא שמביא למעשה מוכח שהמעשה הוא העיקר,"
        },
        {
          "s": 13,
          "text": "ואעפ\"כ תלמוד גדול ממעשה),"
        },
        {
          "s": 14,
          "text": "כי היתרון דמעשה לגבי תלמוד בדרגא זו היא שהתלמוד מביא למעשה"
        },
        {
          "s": 15,
          "text": "(דזה שהתלמוד מביא לידי מעשה הוא ע\"י שנמשך בו ענין הבל\"ג שלמעלה מהתלמוד עצמו),"
        },
        {
          "s": 16,
          "text": "ולכן תלמוד גדול]."
        },
        {
          "s": 17,
          "text": "ובמעלת המעשה מצד זה ששורש המעשה עצמו הוא בעצם הנפש – המעשה הוא לפני"
        },
        {
          "s": 18,
          "text": "(ולמעלה מ)"
        },
        {
          "s": 19,
          "text": "כל הכחות,"
        },
        {
          "s": 20,
          "text": "וזהו שלפני מתן תורה הקדימו נעשה לנשמע,"
        },
        {
          "s": 21,
          "text": "ועד\"ז בחנוכת המשכן הקריב יהודה"
        },
        {
          "s": 22,
          "text": "(מעשה)"
        },
        {
          "s": 23,
          "text": "לפני יששכר"
        },
        {
          "s": 24,
          "text": "(תלמוד),"
        },
        {
          "s": 25,
          "text": "כי במתן תורה ובהקמת המשכן היתה המשכת העצמות,"
        },
        {
          "s": 26,
          "text": "ושם – המעשה קודם לתלמוד."
        }
      ]
    }
  ]
}