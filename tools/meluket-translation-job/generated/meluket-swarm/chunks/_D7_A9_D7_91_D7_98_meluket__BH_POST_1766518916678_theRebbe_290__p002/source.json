  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916678_theRebbe_290__p002",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916678_theRebbe_290__p002",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916678_theRebbe_290",
  "title": "הערות לד\"ה באתי לגני תשי\"ג",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ולכאורה קשה:"
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "א)"
        },
        {
          "s": 1,
          "text": "הרי מצינו מאו\"ה עוברים על שבע מצות ב\"נ שנצטוו עליהם."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "והתירוץ פשוט,"
        },
        {
          "s": 1,
          "text": "שהוא,"
        },
        {
          "s": 2,
          "text": "ע\"ד המבואר בנוגע לבנ\"י,"
        },
        {
          "s": 3,
          "text": "מפני רוח שטות שנכנס בו ומכסה ומסתיר על האמת שזהו בסתירה למה דקרי לי' אלקא דאלקיא."
        },
        {
          "s": 4,
          "text": "אבל מצד עצמם כמו שנשפעו מהקליפות וסט\"א הם באופן שלא יעברו ולא ימרדו,"
        },
        {
          "s": 5,
          "text": "וכמו בלעם שאמר לא אוכל לעבור את פי ה'"
        },
        {
          "s": 6,
          "text": "(עיין תניא פכ\"ד),"
        },
        {
          "s": 7,
          "text": "אף שבא על אתונו"
        },
        {
          "s": 8,
          "text": "(<a href=\"/library/article_cdo/aid/5458666/jewish/page."
        },
        {
          "s": 9,
          "text": "htm\" data-book-id=\"17216-5458666\" title=\"סנהדרין קה,"
        },
        {
          "s": 10,
          "text": "ב\" target=\"_blank\">סנהדרין קה,"
        },
        {
          "s": 11,
          "text": "ב."
        },
        {
          "s": 12,
          "text": "זהר ח\"א קכח,"
        },
        {
          "s": 13,
          "text": "ב),"
        },
        {
          "s": 14,
          "text": "שזהו מז' מצוות ב\"נ."
        },
        {
          "s": 15,
          "text": "או1"
        },
        {
          "s": 16,
          "text": "\"שמפני גודל ועוצם עוונם\" לבם שליט על מוחם"
        },
        {
          "s": 17,
          "text": "(ע\"ד משנ\"ת בנוגע לבנ\"י – תניא פי\"ז),"
        },
        {
          "s": 18,
          "text": "אף שהוא היפך התולדה גם בב\"נ"
        },
        {
          "s": 19,
          "text": "(ראה תניא פנ\"א)."
        }
      ]
    }
  ]
}