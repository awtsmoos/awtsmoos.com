{
  "globalIndex": 488,
  "owner": 38,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916658_theRebbe_485__p001",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916658_theRebbe_485__p001",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916658_theRebbe_485",
  "title": "מאמר באתי לגני תשי\"ג",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד,"
        },
        {
          "s": 1,
          "text": "יו\"ד שבט,"
        },
        {
          "s": 2,
          "text": "ה'תשי\"ג*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "באתי לגניא"
        },
        {
          "s": 1,
          "text": "אחותי כלה1,"
        },
        {
          "s": 2,
          "text": "ואיתא במדרש רבה"
        },
        {
          "s": 3,
          "text": "(במקומו2)"
        },
        {
          "s": 4,
          "text": "לגני לגנוני למקום שהי' עיקרי בתחילה,"
        },
        {
          "s": 5,
          "text": "דעיקר שכינה בתחתונים היתה,"
        },
        {
          "s": 6,
          "text": "וע\"י חטא עץ הדעת והחטאים שלאחריו סילקו השכינה מלמטה למעלה עד רקיע הז',"
        },
        {
          "s": 7,
          "text": "והצדיקים שאח\"כ עד משה רבינו,"
        },
        {
          "s": 8,
          "text": "שהוא השביעי וכל השביעין חביבין3,"
        },
        {
          "s": 9,
          "text": "המשיכו השכינה מלמעלה למטה עד בארץ הגשמית ממש,"
        },
        {
          "s": 10,
          "text": "ועל המשכה זו נאמר4"
        },
        {
          "s": 11,
          "text": "ועשו לי מקדש ושכנתי בתוכם,"
        },
        {
          "s": 12,
          "text": "בתוכו לא נאמר אלא בתוכם,"
        },
        {
          "s": 13,
          "text": "בתוך כל אחד ואחד מישראל5,"
        },
        {
          "s": 14,
          "text": "והיינו שע\"י שהצדיקים עושים כל הענינים בעצמם ופועלים זה באנשי דורם"
        },
        {
          "s": 15,
          "text": "(טוען דורך די ענינים אין זיך אַליין און פּועל'ן דאָס אין דעם דור),"
        },
        {
          "s": 16,
          "text": "על ידי זה הם ממשיכים את השכינה בתחתונים כמו שהי' בתחילה."
        },
        {
          "s": 17,
          "text": "ועוד יותר – שהם ממשיכים גם עיקר השכינה בתחתונים,"
        },
        {
          "s": 18,
          "text": "כמ\"ש בהמאמר6"
        },
        {
          "s": 19,
          "text": "דיום ההסתלקות ויום היאָרצייט בביאור מאמר הזהר7,"
        },
        {
          "s": 20,
          "text": "כד אתכפיא סטרא אחרא אסתלק יקרא דקוב\"ה בכולהו עלמין,"
        },
        {
          "s": 21,
          "text": "דפירושו האור שמאיר בכולהו עלמין בשוה,"
        },
        {
          "s": 22,
          "text": "וההמשכה היא ע\"י העבודה דאתכפיא סט\"א,"
        },
        {
          "s": 23,
          "text": "שבהעבודות דמקדש היא עבודת הקרבנות ובפרט מעשה הקטרת8."
        },
        {
          "s": 24,
          "text": "וזהו ג\"כ הטעם8"
        },
        {
          "s": 25,
          "text": "מה שהמשכן הי' מעצי שטים9"
        },
        {
          "s": 26,
          "text": "דוקא,"
        },
        {
          "s": 27,
          "text": "דהנה10"
        },
        {
          "s": 28,
          "text": "שטה פי' נטי' וכן פי' שטות11,"
        },
        {
          "s": 29,
          "text": "דהיינו שיש דבר שהוא אמצעי,"
        },
        {
          "s": 30,
          "text": "וההטי' לאיזה צד,"
        },
        {
          "s": 31,
          "text": "למעלה או למטה,"
        },
        {
          "s": 32,
          "text": "נקרא שטה,"
        },
        {
          "s": 33,
          "text": "דההטי' למעלה הוא שטות דקדושה וההטי' למטה הוא שטות דלעומת זה."
        },
        {
          "s": 34,
          "text": "דרך התומ\"צ בכלל,"
        },
        {
          "s": 35,
          "text": "הוא דרך האמצעית וכמ\"ש הרמב\"ם בהלכות דעות12,"
        },
        {
          "s": 36,
          "text": "וההטי' למעלה מדרך האמצעית הוא שטות דקדושה,"
        },
        {
          "s": 37,
          "text": "שצריך להיות גם שטות דקדושה,"
        },
        {
          "s": 38,
          "text": "ובפרט כאשר צריך להזהר"
        },
        {
          "s": 39,
          "text": "(באַוואָרענען)"
        },
        {
          "s": 40,
          "text": "שלא יהי' השטות דלעו\"ז,"
        },
        {
          "s": 41,
          "text": "הוא ע\"י שטות דקדושה דוקא,"
        },
        {
          "s": 42,
          "text": "וכמאמר13"
        },
        {
          "s": 43,
          "text": "אהני לי' שטותי' לסבא,"
        },
        {
          "s": 44,
          "text": "שהשטות דקדושה אהני ומתקן את השטות דלעו\"ז,"
        },
        {
          "s": 45,
          "text": "וכמש\"נ על לעתיד לבוא והשקה את נחל השטים14,"
        },
        {
          "s": 46,
          "text": "שעי\"ז אסתלק יקרא דקוב\"ה בכולהו עלמיןב."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה10 להבין כללות ענין השטות דלעו\"ז שמשום זה מוכרח להיות השטות דקדושה ועי\"ז אסתלק יקרא דקוב\"ה בכולהו עלמין,"
        },
        {
          "s": 2,
          "text": "הנה כתיב15"
        },
        {
          "s": 3,
          "text": "כי תשטה אשתו ופירש\"י תט מדרכי צניעות,"
        },
        {
          "s": 4,
          "text": "וכתיב16"
        },
        {
          "s": 5,
          "text": "וישב ישראל בשטים ואיתא במדרשג"
        },
        {
          "s": 6,
          "text": "דשטים הוא מקום הגורם לשטות שעי\"ז באים לידי עבירה לזנות וכמו שארז\"ל17"
        },
        {
          "s": 7,
          "text": "ע\"פ כי תשטה אשתו,"
        },
        {
          "s": 8,
          "text": "אין אדם עובר עבירה אלא אם כן נכנס בו רוח שטות,"
        },
        {
          "s": 9,
          "text": "כי איש הישראלי מצד עצמו"
        },
        {
          "s": 10,
          "text": "(אַ איד מצד עצמו)"
        },
        {
          "s": 11,
          "text": "א\"א כלל שיעבור איזה עבירה וכמ\"ש בזהרד"
        },
        {
          "s": 12,
          "text": "ע\"פ18"
        },
        {
          "s": 13,
          "text": "נפש כי תחטא דאורייתא וקוב\"ה תווהן עלי' ואמרי נפש כי תחטא"
        },
        {
          "s": 14,
          "text": "(בתמי'),"
        },
        {
          "s": 15,
          "text": "והיינו דגם במדריגת נפש19,"
        },
        {
          "s": 16,
          "text": "שאין זה עצם הנשמה,"
        },
        {
          "s": 17,
          "text": "ולא עוד אלא שגם בהחמשה שמות שנקראו להה"
        },
        {
          "s": 18,
          "text": "היא מדריגה היותר תחתונה שבהשמות,"
        },
        {
          "s": 19,
          "text": "וכמו שמדייק בזהר שם דענין החטא שייך בנפש דוקא,"
        },
        {
          "s": 20,
          "text": "דבמדריגת נשמה וגם במדריגת רוח אין שייך שיהי' חטא,"
        },
        {
          "s": 21,
          "text": "ומ\"מ הנה גם אם במדריגה זו יהי' חטא אומר על זה תווהא,"
        },
        {
          "s": 22,
          "text": "ועוד יותר שאפילו אם הוא רק בשוגג,"
        },
        {
          "s": 23,
          "text": "שהרי הכתוב מדבר בענין חטא בשוגג,"
        },
        {
          "s": 24,
          "text": "הנה זה גם א\"א להיות כ\"א מצד הרוח שטות שנכנס בו."
        },
        {
          "s": 25,
          "text": "דמצד עצמו,"
        },
        {
          "s": 26,
          "text": "הרי בטבע כל ישראל שאינו רוצה ואינו יכול להיות נפרד מאלקות20,"
        },
        {
          "s": 27,
          "text": "אלא שע\"י הרוח שטות שמכסה על האמת ונדמה לו דגם כאשר הוא עובר עבירה עודנו ביהדותו,"
        },
        {
          "s": 28,
          "text": "מצד זה אפשר שיעבור עבירה."
        },
        {
          "s": 29,
          "text": "אבל כאשר יאיר בו האמת,"
        },
        {
          "s": 30,
          "text": "בחינת ואמת הוי' לעולם21,"
        },
        {
          "s": 31,
          "text": "אז הוא מרגיש שע\"י העבירה ואפילו באיסור דרבנן ודקדוק קל של דברי סופרים נפרד בתכלית מאלקות,"
        },
        {
          "s": 32,
          "text": "יותר גם מהקליפות וסט\"א."
        },
        {
          "s": 33,
          "text": "וכמ\"ש כ\"ק אדמו\"ר הזקן בתניאו"
        },
        {
          "s": 34,
          "text": "שהאדם העובר על רצונו ית' גרוע ופחות מבעלי חיים הטמאים כו' שאינם משנים תפקידם22"
        },
        {
          "s": 35,
          "text": "ואע\"ג דאיהו לא חזי מזלייהו חזי23"
        },
        {
          "s": 36,
          "text": "ולכן הנה באדם שהצלם אלקים אין מסתלק מעל פניו אין שולטים בו,"
        },
        {
          "s": 37,
          "text": "דפקודתו ית' שמרה רוחם24"
        },
        {
          "s": 38,
          "text": "וכמש\"נ25"
        },
        {
          "s": 39,
          "text": "ומוראכם וחתכם יהי' על כל חית גו',"
        },
        {
          "s": 40,
          "text": "ורק בזה שאין נראה בו הבצלמינו כדמותינו26"
        },
        {
          "s": 41,
          "text": "הם שולטים כו',"
        },
        {
          "s": 42,
          "text": "ועד\"ז או\"ה וקליפות וסט\"א אין עוברים רצונו ית',"
        },
        {
          "s": 43,
          "text": "אלא דקרו לי' אלקא דאלקייא27,"
        },
        {
          "s": 44,
          "text": "דהם אומרים שגם להם יש שליטה וממשלה,"
        },
        {
          "s": 45,
          "text": "אבל מ\"מ אין מורדים בו ית'28,"
        },
        {
          "s": 46,
          "text": "שהרי קרו לי' אלקא דאלקייא,"
        },
        {
          "s": 47,
          "text": "ואין עוברים על רצונו ית' לעולם,"
        },
        {
          "s": 48,
          "text": "והאדם העובר עבירה שהוא מורד ברצונו ית' הרי הוא גרוע יותר מהקליפות וסט\"א ומדברים המושפעים מהם שהם בעלי חיים הטמאים וחיות רעות,"
        },
        {
          "s": 49,
          "text": "עד אשר אף יתוש,"
        },
        {
          "s": 50,
          "text": "שמכניס ואינו מוציא29,"
        },
        {
          "s": 51,
          "text": "קדמך30."
        }
      ]
    }
  ]
}