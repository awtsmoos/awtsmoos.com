  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920191_theRebbe_834__p006",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920191_theRebbe_834",
  "title": "מאמר אני לדודי תשל\"ב",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "וכיון שבאלול מקבל המלך את כולם בסבר פנים יפות ומראה פנים שוחקות לכולם,"
        },
        {
          "s": 1,
          "text": "הרי בודאי שהמלך ממלא הבקשה של כאו\"א מישראל,"
        },
        {
          "s": 2,
          "text": "שתהי' לו כתיבה וחתימה טובה לשנה טובה ומתוקה בטוב הנראה והנגלה,"
        },
        {
          "s": 3,
          "text": "הן בענינים הרוחניים בלימוד התורה וקיום המצוות,"
        },
        {
          "s": 4,
          "text": "והן בענינים הגשמיים בבני חיי ומזוני רויחי,"
        },
        {
          "s": 5,
          "text": "ועאכו\"כ בנוגע לבקשה העיקרית – גאולה האמיתית והשלימה ע\"י משיח צדקנו,"
        },
        {
          "s": 6,
          "text": "יבוא ויגאלנו ויוליכנו קוממיות לארצנו,"
        },
        {
          "s": 7,
          "text": "בקרוב ממש."
        }
      ]
    }
  ]
}