{
  "globalIndex": 223,
  "owner": 23,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915124_theRebbe_182__p001",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915124_theRebbe_182__p001",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518915124_theRebbe_182",
  "title": "מאמר ויזרע יצחק בארץ תשכ\"ז",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ תולדות,"
        },
        {
          "s": 2,
          "text": "מבה\"ח כסלו ה'תשכ\"ז"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "ויזרע יצחק בארץ ההיא וימצא בשנה ההיא מאה שערים ויברכהו ה'1,"
        },
        {
          "s": 1,
          "text": "וצריך להבין,"
        },
        {
          "s": 2,
          "text": "דמזה שנאמר ויברכהו ה' לאחרי וימצא גו' מאה שערים,"
        },
        {
          "s": 3,
          "text": "משמע שויברכהו ה' הוא ענין נוסף על זה שמצא מאה שערים,"
        },
        {
          "s": 4,
          "text": "וצריך ביאור מה שאומר ויברכהו סתם ואינו מפרש במה ברכו."
        },
        {
          "s": 5,
          "text": "גם צריך להבין,"
        },
        {
          "s": 6,
          "text": "הרי גם זה שמצא מאה שערים"
        },
        {
          "s": 7,
          "text": "(מאה פעמים מכפי ששיערו)"
        },
        {
          "s": 8,
          "text": "הוא לא ע\"פ דרכי הטבע אלא ברכת ה',"
        },
        {
          "s": 9,
          "text": "ולאידך,"
        },
        {
          "s": 10,
          "text": "גם הברכה דויברכהו ה' שלאחרי מציאת המאה שערים היא שיצחק נתברך בברכה זו"
        },
        {
          "s": 11,
          "text": "(ויברכהו ה'),"
        },
        {
          "s": 12,
          "text": "ואעפ\"כ מציאת המאה שערים מייחס הכתוב ליצחק"
        },
        {
          "s": 13,
          "text": "(וימצא גו' מאה שערים),"
        },
        {
          "s": 14,
          "text": "ובהברכה שנתברך יצחק לאחרי שמצא מאה שערים אומר ויברכהו ה'."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים מה שממשיך הכתוב2"
        },
        {
          "s": 2,
          "text": "ויגדל האיש וילך הלוך וגדל עד כי גדל מאד,"
        },
        {
          "s": 3,
          "text": "שע\"י ויזרע יצחק גו' נעשה הגדלה ביצחק עצמו,"
        },
        {
          "s": 4,
          "text": "ויגדל האיש גו'."
        },
        {
          "s": 5,
          "text": "דשני הענינים שבפסוק ויזרע יצחק גו',"
        },
        {
          "s": 6,
          "text": "וימצא גו' מאה שערים וויברכהו ה',"
        },
        {
          "s": 7,
          "text": "הם בנוגע להתבואה3,"
        },
        {
          "s": 8,
          "text": "וימצא מאה שערים הוא ריבוי מופלג בהתבואה עצמה,"
        },
        {
          "s": 9,
          "text": "ויברכהו ה' הוא שמכר תבואתו בדמים יקרים4."
        },
        {
          "s": 10,
          "text": "והגם שכל עניני האבות"
        },
        {
          "s": 11,
          "text": "[ובפרט עניני האבות האמורים בתורה]"
        },
        {
          "s": 12,
          "text": "הם ענינים רוחניים5,"
        },
        {
          "s": 13,
          "text": "דמזה מובן שבהתבואה דיצחק הי'"
        },
        {
          "s": 14,
          "text": "(גם)"
        },
        {
          "s": 15,
          "text": "ענין רוחני,"
        },
        {
          "s": 16,
          "text": "ושני הענינים דוימצא מאה שערים וויברכהו ה' הם גם בנוגע לענין הרוחני דתבואת יצחק,"
        },
        {
          "s": 17,
          "text": "מ\"מ,"
        },
        {
          "s": 18,
          "text": "הם רק בנוגע לענין פרטי"
        },
        {
          "s": 19,
          "text": "(תבואה)."
        },
        {
          "s": 20,
          "text": "ובהפסוק שלאח\"ז מוסיף שע\"י העבודה דויזרע יצחק גו' נעשה הגדלה גם בכללות ענינו,"
        },
        {
          "s": 21,
          "text": "ויגדל האיש גו'."
        }
      ]
    }
  ]
}