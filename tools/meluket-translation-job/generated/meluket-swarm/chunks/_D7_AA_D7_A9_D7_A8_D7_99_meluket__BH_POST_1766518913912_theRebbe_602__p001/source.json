{
  "globalIndex": 39,
  "owner": 39,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913912_theRebbe_602__p001",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913912_theRebbe_602__p001",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518913912_theRebbe_602",
  "title": "מאמר אדון עולם תשמ\"ג",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "יום ב' דראש-השנה ה'תשמ\"ג*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "אדון עולם אשר מלך בטרם כל יצור נברא1,"
        },
        {
          "s": 1,
          "text": "ומדייק בזה כ\"ק מו\"ח אדמו\"ר במאמרו ד\"ה זה2"
        },
        {
          "s": 2,
          "text": "[בהמשך המתחיל יו\"ט של ראש השנה שחל להיות בשבת,"
        },
        {
          "s": 3,
          "text": "שבו מבאר"
        },
        {
          "s": 4,
          "text": "(במאמר הראשון3)"
        },
        {
          "s": 5,
          "text": "דהכתרת המלך היא בשמחה גדולה],"
        },
        {
          "s": 6,
          "text": "דצריך להבין,"
        },
        {
          "s": 7,
          "text": "איך תתכן המלוכה בטרם כל יצור נברא,"
        },
        {
          "s": 8,
          "text": "והרי המלוכה היא על הזולת דוקא כמאמר4"
        },
        {
          "s": 9,
          "text": "אין מלך בלא עם,"
        },
        {
          "s": 10,
          "text": "ויתירה מזו,"
        },
        {
          "s": 11,
          "text": "דמלוכה היא דוקא על מי שבערכו,"
        },
        {
          "s": 12,
          "text": "היינו שהעם הוא בדומה להמלך,"
        },
        {
          "s": 13,
          "text": "דלא זו בלבד שענין המלוכה"
        },
        {
          "s": 14,
          "text": "(באדם)"
        },
        {
          "s": 15,
          "text": "הוא דוקא על בני אדם ולא על בעלי חיים"
        },
        {
          "s": 16,
          "text": "(דגם כשיהי' לאדם אלף אלפים בעלי חיים אין שייך שיהי' מלך עליהם),"
        },
        {
          "s": 17,
          "text": "הנה גם בבני אדם גופא צריך שיהי' להעם איזה שייכות ודמיון להמלך,"
        },
        {
          "s": 18,
          "text": "כידוע5"
        },
        {
          "s": 19,
          "text": "שעם"
        },
        {
          "s": 20,
          "text": "(אין מלך בלא עם)"
        },
        {
          "s": 21,
          "text": "הוא מלשון עמו,"
        },
        {
          "s": 22,
          "text": "ואיך יתכן ענין המלוכה בטרם כל יצור נברא."
        },
        {
          "s": 23,
          "text": "ומבאר זה בהקדים מ\"ש בשל\"ה6"
        },
        {
          "s": 24,
          "text": "(ובכמה ספרים7)"
        },
        {
          "s": 25,
          "text": "גודל השבח דאדון עולם,"
        },
        {
          "s": 26,
          "text": "ועד שאדון עולם בגימטריא אין סוף8,"
        },
        {
          "s": 27,
          "text": "דענין אין סוף הוא דרגא הכי נעלית באלקות,"
        },
        {
          "s": 28,
          "text": "ויתירה מזו שהוא למעלה מענין הדרגות,"
        },
        {
          "s": 29,
          "text": "דאמיתית ענין אין סוף הוא9"
        },
        {
          "s": 30,
          "text": "בעצמותו ית'."
        },
        {
          "s": 31,
          "text": "ועפ\"ז מבאר ענין אדון עולם אשר מלך בטרם כל יצור נברא,"
        },
        {
          "s": 32,
          "text": "דמכיון שאדון עולם הוא"
        },
        {
          "s": 33,
          "text": "(בגימט')"
        },
        {
          "s": 34,
          "text": "אין סוף,"
        },
        {
          "s": 35,
          "text": "הרי מובן,"
        },
        {
          "s": 36,
          "text": "דענין אדון עולם אשר מלך כו' הוא בחינת המלכות כמו שמושרשת כביכול בעצמותו ית'"
        },
        {
          "s": 37,
          "text": "(אמיתית ענין א\"ס),"
        },
        {
          "s": 38,
          "text": "ומכיון שעצמותו ית' הוא כל יכול,"
        },
        {
          "s": 39,
          "text": "שייך שיהי' מלך גם בלא עם,"
        },
        {
          "s": 40,
          "text": "בטרם כל יצור נברא."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה מאמר זה בא,"
        },
        {
          "s": 2,
          "text": "כנ\"ל,"
        },
        {
          "s": 3,
          "text": "בהמשך להמאמר ד\"ה יו\"ט של ראש השנה שחל להיות בשבת,"
        },
        {
          "s": 4,
          "text": "שבו מבאר בארוכה הענין דתקיעת שופר בראש השנה,"
        },
        {
          "s": 5,
          "text": "שהעבודה דתקיעת שופר היא ענין כללי שכולל כל פרטי העבודות דכל השנה."
        },
        {
          "s": 6,
          "text": "כי ענין תקיעת שופר הוא כמארז\"ל10"
        },
        {
          "s": 7,
          "text": "אמרו לפני בראש השנה כו' מלכיות כדי שתמליכוני עליכם כו' ובמה בשופר,"
        },
        {
          "s": 8,
          "text": "ומכיון דכל הציוויים שלמעלה"
        },
        {
          "s": 9,
          "text": "(מצוות)"
        },
        {
          "s": 10,
          "text": "שייכים דוקא לאחרי שהוא ית' נעשה מלך,"
        },
        {
          "s": 11,
          "text": "כמאמר11"
        },
        {
          "s": 12,
          "text": "קבלו מלכותי תחלה ואח\"כ אגזור עליכם גזירות,"
        },
        {
          "s": 13,
          "text": "הרי,"
        },
        {
          "s": 14,
          "text": "שהעבודה דתקיעת שופר שענינה הוא שתמליכוני עליכם היא השורש לכל המצוות"
        },
        {
          "s": 15,
          "text": "(העבודות)"
        },
        {
          "s": 16,
          "text": "שבמשך כל השנה."
        },
        {
          "s": 17,
          "text": "ומבאר שם,"
        },
        {
          "s": 18,
          "text": "דענין שתמליכוני עליכם שע\"י תקיעת שופר הוא המשכת הרצון למלוכה"
        },
        {
          "s": 19,
          "text": "(בדוגמת הכתרת מלך בו\"ד,"
        },
        {
          "s": 20,
          "text": "שבאה בשמחה גדולה ובביטול עצום אל המלך,"
        },
        {
          "s": 21,
          "text": "שעי\"ז מתעורר המלך ברצון לחפוץ במלוכה)."
        },
        {
          "s": 22,
          "text": "והטעם מה שעבודתם של ישראל מעוררת אצלו ית' הרצון למלוכה הוא לפי שגם לפנ\"ז יש לו רצון לזה,"
        },
        {
          "s": 23,
          "text": "אלא שרצון זה הוא בהעלם,"
        },
        {
          "s": 24,
          "text": "והעבודה דישראל ממשיכה את הרצון מההעלם אל הגילוי."
        },
        {
          "s": 25,
          "text": "והסיבה לזה שיש רצון נעלם למלוכה היא,"
        },
        {
          "s": 26,
          "text": "לפי שענין הרצון למלוכה ישנו גם לפנ\"ז"
        },
        {
          "s": 27,
          "text": "(לפני הרצון הנעלם),"
        },
        {
          "s": 28,
          "text": "והוא הרצון המוחלט בעצמותו."
        },
        {
          "s": 29,
          "text": "ובאמת לא יתכן לומר על זה דהרצון למלוכה יש גם מקודם"
        },
        {
          "s": 30,
          "text": "(כמו שאומרים בנוגע לרצון הנעלם,"
        },
        {
          "s": 31,
          "text": "דגם טרם שנתעורר ברצון הגלוי יש כבר הרצון בהעלם),"
        },
        {
          "s": 32,
          "text": "כי בעצמותו ית' אין שייך לומר שיש שם איזה ענין שהוא בהעלם,"
        },
        {
          "s": 33,
          "text": "והכל שם הוא בבחינת אחדות הפשוטה בתכלית הפשיטות."
        },
        {
          "s": 34,
          "text": "וענין תמליכוני עליכם שע\"י תקיעת שופר הוא לא רק להמשיך הרצון למלוכה מההעלם אל הגילוי,"
        },
        {
          "s": 35,
          "text": "מבחינת הרצון כמו שהוא כלול בהעלם באוא\"ס שלפני הצמצום"
        },
        {
          "s": 36,
          "text": "(בהבחינה דגילוי לעצמו),"
        },
        {
          "s": 37,
          "text": "כי אם,"
        },
        {
          "s": 38,
          "text": "שעי\"ז נמשך גם מרצון המוחלט בעצמותו,"
        },
        {
          "s": 39,
          "text": "דרצון זה הוא כביכול העצמות גופא"
        },
        {
          "s": 40,
          "text": "(ואין שייך לומר עליו שהוא כלול בהעלם)."
        },
        {
          "s": 41,
          "text": "והמשכה זו בראש השנה היא ע\"י תמליכוני עליכם,"
        },
        {
          "s": 42,
          "text": "רצון למלוכה,"
        },
        {
          "s": 43,
          "text": "ומזה נמשך אח\"כ הרצון דמצוות"
        },
        {
          "s": 44,
          "text": "(גזירות),"
        },
        {
          "s": 45,
          "text": "דעיקר ענין המצוות הוא הרצון למעלה."
        },
        {
          "s": 46,
          "text": "וכמבואר בכ\"מ12,"
        },
        {
          "s": 47,
          "text": "דמה שקיום המצוות צריך להיות דוקא בפרטיות ובדיוק"
        },
        {
          "s": 48,
          "text": "(כפי שנצטוינו),"
        },
        {
          "s": 49,
          "text": "הוא,"
        },
        {
          "s": 50,
          "text": "כי ברצון נוגע שכל פרט ופרט יהי' כפי הרצון."
        }
      ]
    }
  ]
}