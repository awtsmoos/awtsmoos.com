{
  "globalIndex": 1036,
  "owner": 36,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919889_theRebbe_263__p005",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919889_theRebbe_263__p005",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919889_theRebbe_263",
  "title": "מאמר והי' עקב תשמעון תשכ\"ז",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "וזהו והי' עקב תשמעון גו' תשמעון ודאי,"
        },
        {
          "s": 2,
          "text": "שדבר ודאי הוא שתושלם הכוונה דנתאוה הקב\"ה להיות לו ית' דירה בתחתונים67,"
        },
        {
          "s": 3,
          "text": "בשני ענינים הנ\"ל."
        },
        {
          "s": 4,
          "text": "הן הגילוי דאוא\"ס שהאיר גם קודם הצמצום"
        },
        {
          "s": 5,
          "text": "(הגילוי דימות המשיח)"
        },
        {
          "s": 6,
          "text": "והן הגילוי דהעלם העצמי"
        },
        {
          "s": 7,
          "text": "(הגילוי דתחיית המתים)."
        },
        {
          "s": 8,
          "text": "והגם שגילויים אלו תלויים במעשינו ועבודתינו והרשות נתונה לכל אדם68,"
        },
        {
          "s": 9,
          "text": "הנה על זה הובטחנו69"
        },
        {
          "s": 10,
          "text": "שלא ידח ממנו נדח70,"
        },
        {
          "s": 11,
          "text": "וכאו\"א מישראל ישלים את הכוונה במעשינו,"
        },
        {
          "s": 12,
          "text": "היגיעה דתומ\"צ יותר מהטבע דנפש הבהמית,"
        },
        {
          "s": 13,
          "text": "וגם בעבודתינו,"
        },
        {
          "s": 14,
          "text": "היגיעה בתומ\"צ יותר גם מהטבע דנפש האלקית."
        },
        {
          "s": 15,
          "text": "וזהו והי' עקב תשמעון דעקב קאי"
        },
        {
          "s": 16,
          "text": "(כנ\"ל)"
        },
        {
          "s": 17,
          "text": "על עקבתא דמשיחא,"
        },
        {
          "s": 18,
          "text": "כי"
        },
        {
          "s": 19,
          "text": "(נוסף אשר אז מתקיימת ההבטחה תשמעון ודאי)"
        },
        {
          "s": 20,
          "text": "שלימות עבודתינו"
        },
        {
          "s": 21,
          "text": "(הוספת ענין חדש גם לגבי נפש האלקית)"
        },
        {
          "s": 22,
          "text": "הוא"
        },
        {
          "s": 23,
          "text": "(בעיקר)"
        },
        {
          "s": 24,
          "text": "ע\"י הבירור דחושך הגלות ובפרט החושך דעקבתא דמשיחא."
        },
        {
          "s": 25,
          "text": "[ובפרט לפי מ\"ש הצ\"צ71"
        },
        {
          "s": 26,
          "text": "שוהי' עקב הו\"ע וידו72"
        },
        {
          "s": 27,
          "text": "אוחזת בעקב עשו ומפרש"
        },
        {
          "s": 28,
          "text": "(בפירוש הראשון)"
        },
        {
          "s": 29,
          "text": "דקאי על עקב דעשו ממש]."
        },
        {
          "s": 30,
          "text": "וגם בצדיקים שחושך הגלות אינו מחשיך לגבם כ\"כ,"
        },
        {
          "s": 31,
          "text": "ומכ\"ש שאין בהם העבודה דהפיכת זדונות לזכיות,"
        },
        {
          "s": 32,
          "text": "וגם העילוי שנעשה ע\"י בירור וזיכוך נפש הבהמית אינו אצלם בתוקף כ\"כ"
        },
        {
          "s": 33,
          "text": "(כי נה\"ב שלהם אינה בחומריות כ\"כ גם לפני העבודה),"
        },
        {
          "s": 34,
          "text": "הרי ע\"י הנסיונות,"
        },
        {
          "s": 35,
          "text": "ובפרט ע\"י המס\"נ בפו\"מ,"
        },
        {
          "s": 36,
          "text": "מתבררים הניצוצות גם שבגקה\"ט כנ\"ל."
        },
        {
          "s": 37,
          "text": "ולאחרי שבכו\"כ צדיקים הי' גם העילוי דבירור הניצוצות שבגקה\"ט ע\"י המס\"נ שלהם,"
        },
        {
          "s": 38,
          "text": "הנה עילוי זה נמשך גם לבניהם"
        },
        {
          "s": 39,
          "text": "[וכמ\"ש ושמר ה' אלקיך לך גו' אשר נשבע לאבותיך],"
        },
        {
          "s": 40,
          "text": "כולל גם בנים אלו התלמידים73"
        },
        {
          "s": 41,
          "text": "שלמדו תורתם,"
        },
        {
          "s": 42,
          "text": "שלכן אין צריכים יותר לנסיונות,"
        },
        {
          "s": 43,
          "text": "ומכ\"ש למס\"נ כפשוטה אלא למסירת הרצון74,"
        },
        {
          "s": 44,
          "text": "ויהי' אצלם ואצל כל בנ\"י \"מעשינו ועבודתינו\" מתוך מנוחה והרחבה כפשוטן ואמיתיים,"
        },
        {
          "s": 45,
          "text": "בשמחה ובטוב לבב,"
        },
        {
          "s": 46,
          "text": "ויקויים היעוד75"
        },
        {
          "s": 47,
          "text": "והקיצו ורננו שוכני עפר ובעל ההילולא בתוכם,"
        },
        {
          "s": 48,
          "text": "ונלך כולנו מהרה קוממיות לארצנו בביאת משיח צדקנו,"
        },
        {
          "s": 49,
          "text": "בעגלא דידן ממש."
        }
      ]
    }
  ]
}