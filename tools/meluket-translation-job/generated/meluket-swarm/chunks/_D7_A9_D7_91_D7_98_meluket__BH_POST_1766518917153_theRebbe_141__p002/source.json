{
  "globalIndex": 594,
  "owner": 44,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917153_theRebbe_141__p002",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917153_theRebbe_141__p002",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518917153_theRebbe_141",
  "title": "מאמר ואלה המשפטים תשל\"ח",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "וממשיך הכתוב לבאר פרטי העבודה ובסדר מן הקל אל הכבד,"
        },
        {
          "s": 2,
          "text": "דהרי העבודה צ\"ל באופן דמעט מעט אגרשנו16."
        },
        {
          "s": 3,
          "text": "והתחלת העבודה היא במ\"ש17"
        },
        {
          "s": 4,
          "text": "כי תקנה עבד עברי גו',"
        },
        {
          "s": 5,
          "text": "דבזה כלולים ב' בחינות בעבודה,"
        },
        {
          "s": 6,
          "text": "בחי' עבד כנעני ובחי' עבד עברי,"
        },
        {
          "s": 7,
          "text": "כמובן ממה דאיתא במכילתא18"
        },
        {
          "s": 8,
          "text": "והובא בפרש\"י עה\"ת18"
        },
        {
          "s": 9,
          "text": "(דמזה מובן שזהו גם ע\"פ פשש\"מ19)"
        },
        {
          "s": 10,
          "text": "דעבד עברי היינו עבד שהוא עברי או אינו אלא עבדו של עברי"
        },
        {
          "s": 11,
          "text": "(עבד כנעני שלקחתו מישראל)"
        },
        {
          "s": 12,
          "text": "ת\"ל כו',"
        },
        {
          "s": 13,
          "text": "דהמסקנה היא שקאי על עבד שהוא עברי,"
        },
        {
          "s": 14,
          "text": "אך מ\"מ ישנו קס\"ד"
        },
        {
          "s": 15,
          "text": "(גם בפשש\"מ כנ\"ל)"
        },
        {
          "s": 16,
          "text": "שהוא עבד כנעני וצריכים לימוד מיוחד"
        },
        {
          "s": 17,
          "text": "(ת\"ל)"
        },
        {
          "s": 18,
          "text": "לשלול סברה זו,"
        },
        {
          "s": 19,
          "text": "דמזה מובן שיש מקום לומר"
        },
        {
          "s": 20,
          "text": "(בתור קס\"ד)"
        },
        {
          "s": 21,
          "text": "דקאי גם על עבד כנעני."
        },
        {
          "s": 22,
          "text": "ובזה"
        },
        {
          "s": 23,
          "text": "(בבחי' עבד כנעני)"
        },
        {
          "s": 24,
          "text": "הוא תחלת העבודה20,"
        },
        {
          "s": 25,
          "text": "ואח\"כ מתעלה בעבודתו ומגיע לבחי' עבד עברי,"
        },
        {
          "s": 26,
          "text": "ועד שמגיע לבחי' אמה העברי',"
        },
        {
          "s": 27,
          "text": "וכדלקמן."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והענין הוא,"
        },
        {
          "s": 2,
          "text": "כמבואר בהדרושים21"
        },
        {
          "s": 3,
          "text": "בארוכה"
        },
        {
          "s": 4,
          "text": "[ובפרט בהדרוש שכותב עליו כ\"ק אדמו\"ר הצ\"צ באוה\"ת22"
        },
        {
          "s": 5,
          "text": "שהדרוש הזה מרבינו הגדול נ\"ע כו' והוא דרוש נכבד מאד וכו' והוא מענין מדריגת צדיק ורשע ובינוני הנזכר בתניא]"
        },
        {
          "s": 6,
          "text": "דיש ג' מדריגות בנפש האדם,"
        },
        {
          "s": 7,
          "text": "עבד כנעני,"
        },
        {
          "s": 8,
          "text": "עבד עברי ואמה העברי',"
        },
        {
          "s": 9,
          "text": "וענינם הוא ג' המדריגות נר\"ן,"
        },
        {
          "s": 10,
          "text": "ומבואר שם שהם ענין צדיק ורשע ובינוני."
        },
        {
          "s": 11,
          "text": "ובזה הוא סדר העבודה דתחלה הוא העבודה דבחי' עבד כנעני ואח\"כ עבד עברי ואמה העברי',"
        },
        {
          "s": 12,
          "text": "וכדאיתא בזהר בסבא דמשפטים23"
        },
        {
          "s": 13,
          "text": "דב\"נ כד אתיליד יהבין לי' נפשא כו' זכה יתיר יהבין לי' רוחא כו' זכה יתיר יהבין לי' נשמתא,"
        },
        {
          "s": 14,
          "text": "דמיד בשעת הלידה נמשך לכל אחד בחי' נפש"
        },
        {
          "s": 15,
          "text": "(שבמדריגות הנשמה),"
        },
        {
          "s": 16,
          "text": "שמצד בחי' זו העבודה היא בבחי' נפש,"
        },
        {
          "s": 17,
          "text": "ואח\"כ ע\"י עבודתו עולה לבחי' רוח שהיא נעלית יותר,"
        },
        {
          "s": 18,
          "text": "ועד שמגיע לבחי' נשמה"
        },
        {
          "s": 19,
          "text": "(ולהעבודה שמצד בחינות אלו),"
        },
        {
          "s": 20,
          "text": "כמבואר פרטי החילוקים שבהעבודה דנר\"ן בקונטרס העבודה24."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה בביאור ענין עבד כנעני שקו\"ט בהגהות והערות וביאורי כ\"ק אדמו\"ר הצ\"צ שבאוה\"ת25"
        },
        {
          "s": 2,
          "text": "אם זהו בחי' רשע וטוב לו או בינוני הנזכר בתניא,"
        },
        {
          "s": 3,
          "text": "ומסיים שם26"
        },
        {
          "s": 4,
          "text": "דשניהם אמת."
        },
        {
          "s": 5,
          "text": "ולפ\"ז,"
        },
        {
          "s": 6,
          "text": "בחי' עבד כנעני קאי הן על רשע והן על בינוני."
        },
        {
          "s": 7,
          "text": "ולכאורה צלה\"ב,"
        },
        {
          "s": 8,
          "text": "דאיך אפשר שגם מי שהוא בבחי' עבד,"
        },
        {
          "s": 9,
          "text": "דעבדא בהפקירא ניחא לי'27"
        },
        {
          "s": 10,
          "text": "[שעיקר רצונו ונחת רוח שלו הוא בהפקירא כו' וילך אחר שרירות לבו,"
        },
        {
          "s": 11,
          "text": "ומה שעושה ועובד הוא רק בע\"כ מצד אימת הדין שלא יכהו בשבט,"
        },
        {
          "s": 12,
          "text": "כמבואר בארוכה בהדרושים28],"
        },
        {
          "s": 13,
          "text": "יהי' בבחי' בינוני"
        },
        {
          "s": 14,
          "text": "[ויקיים השבועה להיות בינוני29],"
        },
        {
          "s": 15,
          "text": "שהרי הבינוני לא עבר עבירה מימיו ולא יעבור לעולם כמבואר בתניא30,"
        },
        {
          "s": 16,
          "text": "וכידוע פתגם חסידים הראשונים דהלואי בינוני."
        },
        {
          "s": 17,
          "text": "אך הענין הוא,"
        },
        {
          "s": 18,
          "text": "שלהיות בינוני הוא ביכלתו של כאו\"א"
        },
        {
          "s": 19,
          "text": "(כולל זה דבהפקירא ניחא לי'31)"
        },
        {
          "s": 20,
          "text": "כמובן מזה שבהשער ד\"ספר של בינונים\""
        },
        {
          "s": 21,
          "text": "(שענינו תוכן הספר)"
        },
        {
          "s": 22,
          "text": "כותב כ\"ק אדה\"ז"
        },
        {
          "s": 23,
          "text": "[וכידוע32"
        },
        {
          "s": 24,
          "text": "שגם השער כתבו אדה\"ז]"
        },
        {
          "s": 25,
          "text": "דקרוב אליך הדבר מאוד33"
        },
        {
          "s": 26,
          "text": "בפיך ובלבבך לעשותו34,"
        },
        {
          "s": 27,
          "text": "ובפנים התניא35"
        },
        {
          "s": 28,
          "text": "כותב עוד דמדת הבינוני היא מדת כל אדם"
        },
        {
          "s": 29,
          "text": "[והיינו דגם מצד מדידה והגבלה"
        },
        {
          "s": 30,
          "text": "(דענין המדה"
        },
        {
          "s": 31,
          "text": "(מדת)"
        },
        {
          "s": 32,
          "text": "שייך לומר רק כשישנו גדר מדוה\"ג)"
        },
        {
          "s": 33,
          "text": "הנה בחי' הבינוני היא לפי\"ע ומדידת כל אדם,"
        },
        {
          "s": 34,
          "text": "כי יהי' מי שיהי' מישראל"
        },
        {
          "s": 35,
          "text": "(כל אדם)"
        },
        {
          "s": 36,
          "text": "הוא בכלל אתם קרויין אדם36"
        },
        {
          "s": 37,
          "text": "ע\"ש אדמה לעליון37."
        },
        {
          "s": 38,
          "text": "ויתירה מזו"
        },
        {
          "s": 39,
          "text": "(כמו שממשיך בתניא שם)"
        },
        {
          "s": 40,
          "text": "ד]"
        },
        {
          "s": 41,
          "text": "ואחרי' כל אדם38"
        },
        {
          "s": 42,
          "text": "ימשוך"
        },
        {
          "s": 43,
          "text": "[דבזה"
        },
        {
          "s": 44,
          "text": "(בתיבת ימשוך)"
        },
        {
          "s": 45,
          "text": "ב' פירושים –כמו בואהבת39"
        },
        {
          "s": 46,
          "text": "– ציווי והבטחה לעתיד]."
        },
        {
          "s": 47,
          "text": "וטעם הדבר הוא,"
        },
        {
          "s": 48,
          "text": "כי אף זה דבהפקירא ניחא לי'"
        },
        {
          "s": 49,
          "text": "(כנ\"ל)"
        },
        {
          "s": 50,
          "text": "זהו רק בחיצוניות,"
        },
        {
          "s": 51,
          "text": "אבל פנימיותו – מדת כל אדם ואחרי' כל אדם ימשוך – הוא מה שהוא חלק אלוקה ממעל ממש40,"
        },
        {
          "s": 52,
          "text": "וכפס\"ד הרמב\"ם הידוע41"
        },
        {
          "s": 53,
          "text": "דכשכופין אותו"
        },
        {
          "s": 54,
          "text": "(כי לי' ניחא בענין אחר)"
        },
        {
          "s": 55,
          "text": "ואומר רוצה אני הרי\"ז רצונו האמיתי"
        },
        {
          "s": 56,
          "text": "[כי מה דבהפקירא ניחא לי' איז דאָס ניט ער כ\"א יצרו אנסו],"
        },
        {
          "s": 57,
          "text": "ובודאי תבוא"
        },
        {
          "s": 58,
          "text": "(הפנימיות שלו)"
        },
        {
          "s": 59,
          "text": "בפועל כנ\"ל"
        },
        {
          "s": 60,
          "text": "(דימשוך הוא לשון עתיד והבטחה)"
        },
        {
          "s": 61,
          "text": "בפיך ובלבבך לעשותו,"
        },
        {
          "s": 62,
          "text": "במחדו\"מ,"
        },
        {
          "s": 63,
          "text": "כולל קיום השבועה דמשביעין אותו42"
        },
        {
          "s": 64,
          "text": "(עכ\"פ אל תהי רשע"
        },
        {
          "s": 65,
          "text": "(כ\"א בינוני29))"
        },
        {
          "s": 66,
          "text": "כבתניא"
        },
        {
          "s": 67,
          "text": "[דזהו ג\"כ הפי' בואחרי' כל אדם ימשוך,"
        },
        {
          "s": 68,
          "text": "שהאדם"
        },
        {
          "s": 69,
          "text": "(מצד נשמתו)"
        },
        {
          "s": 70,
          "text": "נמשך להיות בינוני,"
        },
        {
          "s": 71,
          "text": "וואָס דאָס נעמט אים אַרויס מאיזה מעמד ומצב שיהי' בעבודתו],"
        },
        {
          "s": 72,
          "text": "כי בודאי ש"
        },
        {
          "s": 73,
          "text": "(גם אם צריך לעשות תשובה43)"
        },
        {
          "s": 74,
          "text": "סופו לעשות תשובה וכההבטחה44"
        },
        {
          "s": 75,
          "text": "כי לא ידח ממנו נדח45"
        },
        {
          "s": 76,
          "text": "[ואדרבה,"
        },
        {
          "s": 77,
          "text": "ע\"י התשובה יבוא לדרגא נעלית יותר,"
        },
        {
          "s": 78,
          "text": "כמאמר46"
        },
        {
          "s": 79,
          "text": "במקום שבע\"ת עומדין אין צדיקים גמורין יכולין לעמוד בו]."
        },
        {
          "s": 80,
          "text": "ועד אשר מצד הפנימיות שלו,"
        },
        {
          "s": 81,
          "text": "הנה תמיד קרוב הוא לזה"
        },
        {
          "s": 82,
          "text": "(שיהי' בפיך ובלבבך לעשותו,"
        },
        {
          "s": 83,
          "text": "במחדו\"מ – כבינוני)"
        },
        {
          "s": 84,
          "text": "מאוד."
        },
        {
          "s": 85,
          "text": "ועפ\"ז יובן גם בנדו\"ז דאף שעבד כנעני בהפקירא ניחא לי' מ\"מ מדריגתו היא בחי' הבינוני,"
        },
        {
          "s": 86,
          "text": "כי סו\"ס בודאי יאמר רוצה אני"
        },
        {
          "s": 87,
          "text": "(מצד הפנימיות שלו)"
        },
        {
          "s": 88,
          "text": "כי לא ידח כו'."
        }
      ]
    }
  ]
}