{
  "globalIndex": 231,
  "owner": 31,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915147_theRebbe_734__p003",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915147_theRebbe_734__p003",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518915147_theRebbe_734",
  "title": "מאמר ויתן לך תשכ\"ח",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "והנה הסט\"א היא לעומת זה דקדושה."
        },
        {
          "s": 1,
          "text": "ומזה מובן,"
        },
        {
          "s": 2,
          "text": "דזה שבלעו\"ז יש בחינה הי\"א שמובדלת מהעשר,"
        },
        {
          "s": 3,
          "text": "יש גם בקדושה לעו\"ז,"
        },
        {
          "s": 4,
          "text": "שישנה מדריגה שלמעלה מהע\"ס ומובדלת מהם."
        },
        {
          "s": 5,
          "text": "[אלא שבקדושה,"
        },
        {
          "s": 6,
          "text": "בחינה זו אינה החיות של הע\"ס"
        },
        {
          "s": 7,
          "text": "[דהחיות של הע\"ס מתלבש בתוכם ומתאחד עמהם כנ\"ל."
        },
        {
          "s": 8,
          "text": "ובחינת המקיף שלמעלה מהע\"ס הוא ענין לעצמו19]"
        },
        {
          "s": 9,
          "text": "ולכן אינה נמנית עמהם,"
        },
        {
          "s": 10,
          "text": "אנת הוא חד ולא בחושבן20,"
        },
        {
          "s": 11,
          "text": "משא\"כ בסט\"א,"
        },
        {
          "s": 12,
          "text": "שבחינת המקיף הוא החיות שלהם,"
        },
        {
          "s": 13,
          "text": "צריך לכלול גם את המקיף במספרם"
        },
        {
          "s": 14,
          "text": "(כי בלי המקיף אין להם חיות21),"
        },
        {
          "s": 15,
          "text": "ולכן הם במספר י\"א]."
        },
        {
          "s": 16,
          "text": "ועפ\"ז מובן,"
        },
        {
          "s": 17,
          "text": "שהבירור די\"א כתרין דמסאבותא הוא ע\"י המשכת המקיף שלמעלה מע\"ס,"
        },
        {
          "s": 18,
          "text": "שאינו נמנה עמהם"
        },
        {
          "s": 19,
          "text": "(בחינת עתיק22),"
        },
        {
          "s": 20,
          "text": "דוגמת בחינה הי\"א שבסט\"א שהיא מובדלת מהם כנ\"ל."
        },
        {
          "s": 21,
          "text": "וזהו ויתן לך האלקים מטל השמים,"
        },
        {
          "s": 22,
          "text": "דענין הראשון שבברכת יצחק הוא טל,"
        },
        {
          "s": 23,
          "text": "טלא דעתיקא23,"
        },
        {
          "s": 24,
          "text": "כי בכדי לברר הניצוצות שבעשו הוא ע\"י המשכת בחינת עתיק,"
        },
        {
          "s": 25,
          "text": "כנ\"ל."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה בכדי שתהי' המשכת עתיק למטה ועד שעי\"ז יהי' בירור הניצוצות שבסט\"א,"
        },
        {
          "s": 2,
          "text": "הוא דוקא ע\"י המשכת עצמות אוא\"ס שלמעלה גם מעתיק."
        },
        {
          "s": 3,
          "text": "דעתיק מצד עצמו,"
        },
        {
          "s": 4,
          "text": "מכיון שענינו הוא שהוא נעתק ומובדל מהשתלשלות"
        },
        {
          "s": 5,
          "text": "(עתיק מלשון נעתק24),"
        },
        {
          "s": 6,
          "text": "אא\"פ שיומשך למטה,"
        },
        {
          "s": 7,
          "text": "ובכדי שיומשך למטה הוא דוקא ע\"י עצמות אוא\"ס שאינו מוגדר בשום גדר."
        },
        {
          "s": 8,
          "text": "ועפ\"ז יובן העילוי והחידוש דברכת יצחק ויתן לך האלקים גו' על ויברך אלקים את יצחק,"
        },
        {
          "s": 9,
          "text": "כי הברכה ויתן לך האלקים היא שתהי' ההמשכה למטה לברר את הניצוצות שבעשו,"
        },
        {
          "s": 10,
          "text": "והמשכה זו היא מעצמות אוא\"ס,"
        },
        {
          "s": 11,
          "text": "כנ\"ל."
        },
        {
          "s": 12,
          "text": "וזהו ויתן לך האלקים"
        },
        {
          "s": 13,
          "text": "(האלקים בה' הידיעה),"
        },
        {
          "s": 14,
          "text": "בחינת העלם העצמי דא\"ס,"
        },
        {
          "s": 15,
          "text": "שמשם הוא כח הבירורים25."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "וזהו26 מה דאיתא במדרש27"
        },
        {
          "s": 1,
          "text": "מטל השמים זו מקרא ומשמני הארץ זו משנה דגן זה תלמוד וכו',"
        },
        {
          "s": 2,
          "text": "דלכאורה אינו מובן,"
        },
        {
          "s": 3,
          "text": "הרי גם לולי ברכת יצחק היתה התורה ניתנת לישראל,"
        },
        {
          "s": 4,
          "text": "שהרי כוונת הבריאה היתה בשביל שישראל יקבלו את התורה ותנאי התנה הקב\"ה עם מעשה בראשית כו' אם ישראל מקבלים התורה כו'28,"
        },
        {
          "s": 5,
          "text": "ומהו שברכו בתורה."
        },
        {
          "s": 6,
          "text": "וידוע הביאור בזה,"
        },
        {
          "s": 7,
          "text": "דברכת יצחק היתה על ענין היגיעה בתורה שעי\"ז מגיעים למעלה מבחינת התורה כמו שהיא מצד עצמה."
        },
        {
          "s": 8,
          "text": "דהתורה מצד עצמה היא חכמתו של הקב\"ה,"
        },
        {
          "s": 9,
          "text": "ולמעלה יותר – חכמה סתימאה,"
        },
        {
          "s": 10,
          "text": "וע\"י היגיעה בתורה,"
        },
        {
          "s": 11,
          "text": "יגיעה בדרך אור חוזר,"
        },
        {
          "s": 12,
          "text": "מגיעים להעלם העצמי"
        },
        {
          "s": 13,
          "text": "(דתורה),"
        },
        {
          "s": 14,
          "text": "עין29"
        },
        {
          "s": 15,
          "text": "לא ראתה אלקים זולתך."
        }
      ]
    }
  ]
}