  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919515_theRebbe_764__p010",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919515_theRebbe_764__p010",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919515_theRebbe_764",
  "title": "מאמר גדול יהי' תשכ\"ב",
  "part": 10,
  "sections": [
    {
      "v": 27,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ב)"
        },
        {
          "s": 2,
          "text": "וזהו גדול יהי' כבוד הבית הזה האחרון מן הראשון,"
        },
        {
          "s": 3,
          "text": "דהגם שבגאולה העתידה יהיו כו\"כ ענינים ועד לתחה\"מ שהוא אחרון שבכולם,"
        },
        {
          "s": 4,
          "text": "מ\"מ,"
        },
        {
          "s": 5,
          "text": "עיקר ההדגשה היא בכבוד הבית הזה האחרון,"
        },
        {
          "s": 6,
          "text": "כי שורש דכל הענינים יהי' בביהמ\"ק,"
        },
        {
          "s": 7,
          "text": "וממנו יומשכו בעולם"
        },
        {
          "s": 8,
          "text": "(כנ\"ל סעיף ב)."
        }
      ]
    },
    {
      "v": 28,
      "items": [
        {
          "s": 0,
          "text": "וזהו גם מהטעמים שהפעולה הראשונה של משיח"
        },
        {
          "s": 1,
          "text": "(לאחרי שיהי' בחזקת משיח)"
        },
        {
          "s": 2,
          "text": "הוא בנין ביהמ\"ק74,"
        },
        {
          "s": 3,
          "text": "כי זהו השורש דכל הענינים שלאח\"ז."
        },
        {
          "s": 4,
          "text": "ויהי רצון ועיקר שכל זה יהי' בקרוב ממש."
        }
      ]
    }
  ]
}