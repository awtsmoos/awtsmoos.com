{
  "globalIndex": 1095,
  "owner": 45,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920368_theRebbe_469__p003",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920368_theRebbe_469__p003",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920368_theRebbe_469",
  "title": "מאמר השקיפה ממעון קדשך תשכ\"ז",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים מ\"ש אדמו\"ר מהר\"ש במאמרו ד\"ה שבחי25"
        },
        {
          "s": 2,
          "text": "ירושלים את הוי' הללי אלקיך ציון"
        },
        {
          "s": 3,
          "text": "(דש\"פ תבוא לפני מאה שנה26),"
        },
        {
          "s": 4,
          "text": "דצריך להבין27,"
        },
        {
          "s": 5,
          "text": "הרי ציון הוא למעלה מירושלים"
        },
        {
          "s": 6,
          "text": "[דציון היא הפנימיות דירושלים28],"
        },
        {
          "s": 7,
          "text": "ואעפ\"כ,"
        },
        {
          "s": 8,
          "text": "בירושלים נאמר הוי' ובציון אלקים."
        },
        {
          "s": 9,
          "text": "והנה ישראל נק' בשם ציון כמ\"ש29"
        },
        {
          "s": 10,
          "text": "לאמר לציון עמי אתה."
        },
        {
          "s": 11,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 12,
          "text": "שציון וירושלים הם שתי דרגות בישראל."
        },
        {
          "s": 13,
          "text": "וע\"פ מ\"ש במאמר הנ\"ל שירושלים היא יראה תתאה,"
        },
        {
          "s": 14,
          "text": "יש לומר,"
        },
        {
          "s": 15,
          "text": "שציון היא יראה עילאה30."
        },
        {
          "s": 16,
          "text": "ויש לומר הרמז דיראה עילאה בציון,"
        },
        {
          "s": 17,
          "text": "כי הביטול דיראה עילאה הוא ביטול במציאות31,"
        },
        {
          "s": 18,
          "text": "וביטול זה נרמז בציון מלשון סימן שאינו מציאות לעצמו והוא רק סימן על למעלה."
        },
        {
          "s": 19,
          "text": "וזהו כי מציון תצא תורה ודבר ה' מירושלים32,"
        },
        {
          "s": 20,
          "text": "שבציון נאמר תורה ובירושלים נאמר דבר ה',"
        },
        {
          "s": 21,
          "text": "כי מהחילוקים בין יראה תתאה ויראה עילאה הוא31,"
        },
        {
          "s": 22,
          "text": "שיראה תתאה היא מגדולתו ית' בבריאת והתהוות העולמות,"
        },
        {
          "s": 23,
          "text": "שהביטול דיראה זו הוא ביטול היש."
        },
        {
          "s": 24,
          "text": "ויראה עילאה היא מגדולתו ורוממותו ית' שלמעלה מעולמות,"
        },
        {
          "s": 25,
          "text": "דכולא קמי' כלא חשיב33,"
        },
        {
          "s": 26,
          "text": "דהביטול שביראה זו הוא ביטול במציאות."
        },
        {
          "s": 27,
          "text": "וזהו מ\"ש34"
        },
        {
          "s": 28,
          "text": "ויצונו ה' לעשות את כל החוקים האלה ליראה את הוי',"
        },
        {
          "s": 29,
          "text": "שבכדי לבוא ליראה את הוי',"
        },
        {
          "s": 30,
          "text": "יראה עילאה,"
        },
        {
          "s": 31,
          "text": "הבאה ע\"י הרגש הרוממות דאוא\"ס שלמעלה מעולמות,"
        },
        {
          "s": 32,
          "text": "הוא ע\"י תורה ומצוות"
        },
        {
          "s": 33,
          "text": "(החוקים האלה)."
        },
        {
          "s": 34,
          "text": "כי ע\"י התבוננות אפשר להשיג רק האלקות שבערך העולמות,"
        },
        {
          "s": 35,
          "text": "ובכדי שיורגש הרוממות דאוא\"ס שלמעלה מעולמות,"
        },
        {
          "s": 36,
          "text": "הוא דוקא ע\"י גילוי מלמעלה שנמשך ע\"י לימוד התורה וקיום המצוות."
        },
        {
          "s": 37,
          "text": "וזוהי השייכות דציון לתורה ודירושלים לדבר ה',"
        },
        {
          "s": 38,
          "text": "כי יראה תתאה"
        },
        {
          "s": 39,
          "text": "(ירושלים)"
        },
        {
          "s": 40,
          "text": "היא מדבר ה' שמהווה את העולמות,"
        },
        {
          "s": 41,
          "text": "בדבר ה' שמים נעשו35,"
        },
        {
          "s": 42,
          "text": "ויראה עילאה"
        },
        {
          "s": 43,
          "text": "(ציון)"
        },
        {
          "s": 44,
          "text": "היא מגילוי הרוממות דאוא\"ס שלמעלה מעולמות שנמשך ע\"י תורה ומצוות."
        },
        {
          "s": 45,
          "text": "ועפ\"ז,"
        },
        {
          "s": 46,
          "text": "הדיוק בהכתוב שבחי ירושלים את הוי' הללי אלקיך ציון"
        },
        {
          "s": 47,
          "text": "(שבירושלים נאמר הוי' ובציון אלקים)"
        },
        {
          "s": 48,
          "text": "הוא גם בהענין דירושלים וציון שבעבודת האדם."
        },
        {
          "s": 49,
          "text": "דהנה ידוע36"
        },
        {
          "s": 50,
          "text": "בענין הוי' ואלקים,"
        },
        {
          "s": 51,
          "text": "דאלקים הוא אור הממלא"
        },
        {
          "s": 52,
          "text": "(אור שבערך העולמות)"
        },
        {
          "s": 53,
          "text": "והוי' הוא אור הסובב"
        },
        {
          "s": 54,
          "text": "(אור שלמעלה מעולמות)."
        },
        {
          "s": 55,
          "text": "ומזה מובן,"
        },
        {
          "s": 56,
          "text": "שיראה תתאה שייכת לאלקים ויראה עילאה להוי',"
        },
        {
          "s": 57,
          "text": "ואעפ\"כ,"
        },
        {
          "s": 58,
          "text": "בירושלים"
        },
        {
          "s": 59,
          "text": "(יראה תתאה)"
        },
        {
          "s": 60,
          "text": "נאמר הוי' ובציון"
        },
        {
          "s": 61,
          "text": "(יראה עילאה)"
        },
        {
          "s": 62,
          "text": "נאמר אלקים."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וביאור העילוי דיראה עילאה"
        },
        {
          "s": 2,
          "text": "(ציון)"
        },
        {
          "s": 3,
          "text": "בפרטיות יותר,"
        },
        {
          "s": 4,
          "text": "יובן בהקדים המבואר בהמאמר ד\"ה שבחי הנ\"ל,"
        },
        {
          "s": 5,
          "text": "שבההתבוננות המביאה ליראה תתאה"
        },
        {
          "s": 6,
          "text": "(ירושלים)"
        },
        {
          "s": 7,
          "text": "שני ענינים37."
        },
        {
          "s": 8,
          "text": "ההתבוננות בגדולתו ית' שבהבריאה עצמה,"
        },
        {
          "s": 9,
          "text": "הן בהענין דמה38"
        },
        {
          "s": 10,
          "text": "רבו מעשיך הוי' והן בהענין דמה39"
        },
        {
          "s": 11,
          "text": "גדלו מעשיך הוי'."
        },
        {
          "s": 12,
          "text": "וההתבוננות שכל ההתהוות"
        },
        {
          "s": 13,
          "text": "(דריבוי הנבראים וגדולי הנבראים)"
        },
        {
          "s": 14,
          "text": "היא רק מבחינה הכי אחרונה."
        },
        {
          "s": 15,
          "text": "כמ\"ש40"
        },
        {
          "s": 16,
          "text": "גדול הוי' ומהולל מאד בעיר אלקינו ואמרו רז\"ל41"
        },
        {
          "s": 17,
          "text": "אימתי הוא גדול כשהוא בעיר אלקינו,"
        },
        {
          "s": 18,
          "text": "שגדולתו ית' כמו שהיא מצד עצמה היא למעלה מהשגתינו,"
        },
        {
          "s": 19,
          "text": "וזה שאנו יודעים גדולתו ית' ע\"י בריאת העולמות הוא כמו שהיא בעיר אלקינו שהוא עולם הדיבור."
        },
        {
          "s": 20,
          "text": "דכמו שעיר כפשוטה היא קיבוץ מריבוי בתים ובית הוא מריבוי אבנים,"
        },
        {
          "s": 21,
          "text": "עד\"ז הוא ברוחניות,"
        },
        {
          "s": 22,
          "text": "שאותיות נק' אבנים והתיבות שנעשות מצירוף כמה אותיות נק' בתים"
        },
        {
          "s": 23,
          "text": "[כדאיתא בספר יצירה42"
        },
        {
          "s": 24,
          "text": "שתי אבנים בונות שני בתים שלש אבנים ששה בתים]"
        },
        {
          "s": 25,
          "text": "ועולם הדיבור"
        },
        {
          "s": 26,
          "text": "(בכללותו)"
        },
        {
          "s": 27,
          "text": "נק' עיר אלקינו."
        },
        {
          "s": 28,
          "text": "וכמו שאבנים"
        },
        {
          "s": 29,
          "text": "[וכן הבתים והעיר שנעשים מהאבנים]"
        },
        {
          "s": 30,
          "text": "הם דומם,"
        },
        {
          "s": 31,
          "text": "בחינה היותר אחרונה שבדצח\"מ,"
        },
        {
          "s": 32,
          "text": "עד\"ז הוא בנוגע לעולם הדיבור שממנו נתהוו כל העולמות,"
        },
        {
          "s": 33,
          "text": "שהוא בחינה היותר אחרונה."
        },
        {
          "s": 34,
          "text": "וזהו ודבר ה' מירושלים,"
        },
        {
          "s": 35,
          "text": "שדבר ה' שמהווה ומחי' ומקיים את כל הנבראים הוא מירושלים,"
        },
        {
          "s": 36,
          "text": "עיר אלקינו,"
        },
        {
          "s": 37,
          "text": "בחינת דומם."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דהמבואר בהמאמר שההתבוננות המביאה ליראה תתאה"
        },
        {
          "s": 2,
          "text": "(ירושלים)"
        },
        {
          "s": 3,
          "text": "היא"
        },
        {
          "s": 4,
          "text": "(לא רק בהגדלות שבהבריאה,"
        },
        {
          "s": 5,
          "text": "אלא גם)"
        },
        {
          "s": 6,
          "text": "בזה שההתהוות היא רק מבחינה היותר אחרונה,"
        },
        {
          "s": 7,
          "text": "הוא,"
        },
        {
          "s": 8,
          "text": "כי ירושלים הוא יראה שלם43,"
        },
        {
          "s": 9,
          "text": "שלימות היראה44."
        },
        {
          "s": 10,
          "text": "ובכדי שהיראה"
        },
        {
          "s": 11,
          "text": "(הביטול)"
        },
        {
          "s": 12,
          "text": "תהי' בשלימות,"
        },
        {
          "s": 13,
          "text": "הוא ע\"י ההתבוננות שהנבראים אינם תופסים מקום45."
        },
        {
          "s": 14,
          "text": "וזהו הקשר דשני הפירושים"
        },
        {
          "s": 15,
          "text": "(הענינים)"
        },
        {
          "s": 16,
          "text": "בירושלים – שירושלים הוא עולם הדיבור ושירושלים היא שלימות היראה – שע\"י ההתבוננות בודבר ה' מירושלים,"
        },
        {
          "s": 17,
          "text": "שהתהוות כל העולמות היא"
        },
        {
          "s": 18,
          "text": "(רק)"
        },
        {
          "s": 19,
          "text": "מבחינת ירושלים"
        },
        {
          "s": 20,
          "text": "(עולם הדיבור)"
        },
        {
          "s": 21,
          "text": "שהיא בחינת דומם לגבי המדריגות שלמעלה ממנה,"
        },
        {
          "s": 22,
          "text": "עי\"ז יבוא לשלימות היראה."
        }
      ]
    }
  ]
}