{
  "globalIndex": 390,
  "owner": 40,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915996_theRebbe_995__p002",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915996_theRebbe_995__p002",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915996_theRebbe_995",
  "title": "מאמר אתה אחד תשל\"ב",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה בפרשת השבוע"
        },
        {
          "s": 2,
          "text": "(פ' ויצא4)"
        },
        {
          "s": 3,
          "text": "נאמר5"
        },
        {
          "s": 4,
          "text": "והאבן הזאת אשר שמתי מצבה יהי' בית אלקים גו',"
        },
        {
          "s": 5,
          "text": "דמ\"ש והאבן הזאת קאי אמ\"ש לפני זה6"
        },
        {
          "s": 6,
          "text": "ויקח את האבן אשר שם מראשותיו וישם אותה מצבה ויצק שמן על ראשה."
        },
        {
          "s": 7,
          "text": "וידוע הדקדוקים בזה"
        },
        {
          "s": 8,
          "text": "(וראה גם כן מאמר בעל ההילולא ד\"ה וידר יעקב נדר שבתורת חיים7),"
        },
        {
          "s": 9,
          "text": "מהו החידוש ועילוי בזה ששם את האבן מצבה ובזה שיצק שמן על ראשה."
        },
        {
          "s": 10,
          "text": "גם צריך להבין מ\"ש8"
        },
        {
          "s": 11,
          "text": "וידר יעקב נדר לאמר אם גו' והאבן הזאת אשר שמתי מצבה יהי' בית אלקים,"
        },
        {
          "s": 12,
          "text": "והיינו דכאשר יתקיימו כל התנאים שמונה לפני זה – יהי' אלקים עמדי וגו',"
        },
        {
          "s": 13,
          "text": "הנה אז דוקא יהי' האבן בית אלקים,"
        },
        {
          "s": 14,
          "text": "דנוסף על העילוי שמאבני המקום"
        },
        {
          "s": 15,
          "text": "(לשון רבים)"
        },
        {
          "s": 16,
          "text": "נעשית אבן אחת9,"
        },
        {
          "s": 17,
          "text": "ונוסף להעילוי דוישם אותה מצבה והעילוי דויצק שמן על ראשה,"
        },
        {
          "s": 18,
          "text": "הנה נוסף על כל עילויים הנ\"ל,"
        },
        {
          "s": 19,
          "text": "תהי' עלי' גדולה יותר בהאבן,"
        },
        {
          "s": 20,
          "text": "אשר יהי' בית אלקים."
        },
        {
          "s": 21,
          "text": "והנה פירוש והאבן גו' יהי' בית אלקים הוא,"
        },
        {
          "s": 22,
          "text": "דכמו שבית כפשוטו מוסיף עילוי ושלימות בהאדם הדר בהבית"
        },
        {
          "s": 23,
          "text": "(כמבואר בכמה דרושים,"
        },
        {
          "s": 24,
          "text": "ובפרט בהדרושים המבארים ענין ביהמ\"ק,"
        },
        {
          "s": 25,
          "text": "ד\"ה מזמור שיר חנוכת הבית לדוד10),"
        },
        {
          "s": 26,
          "text": "כן גם האבן הזאת גו' תוסיף עילוי ושלימות כביכול באלקים."
        },
        {
          "s": 27,
          "text": "וצריך להבין,"
        },
        {
          "s": 28,
          "text": "איך שייך שהאבן תוסיף עילוי באלקים."
        },
        {
          "s": 29,
          "text": "והנה כיון שוהאבן גו' יהי' בית אלקים בא בהמשך למ\"ש לפנ\"ז11"
        },
        {
          "s": 30,
          "text": "והי' הוי' לי לאלקים,"
        },
        {
          "s": 31,
          "text": "מובן,"
        },
        {
          "s": 32,
          "text": "שהכוונה היא שהאבן יהי' בית"
        },
        {
          "s": 33,
          "text": "(לא לבחי' אלקים סתם,"
        },
        {
          "s": 34,
          "text": "כ\"א)"
        },
        {
          "s": 35,
          "text": "לבחי' אלקים,"
        },
        {
          "s": 36,
          "text": "כמו שהוי' יהי' לאלקים."
        },
        {
          "s": 37,
          "text": "והיינו שהאבן תוסיף שלימות גם בבחי' הוי' שיהי' לאלקים."
        },
        {
          "s": 38,
          "text": "וגם צריך להבין"
        },
        {
          "s": 39,
          "text": "(כמו שמקשה בתו\"ח שם)"
        },
        {
          "s": 40,
          "text": "מ\"ש והאבן הזאת לשון נקבה,"
        },
        {
          "s": 41,
          "text": "ואח\"כ יהי' בית כו',"
        },
        {
          "s": 42,
          "text": "דהול\"ל תהי' בית גו',"
        },
        {
          "s": 43,
          "text": "ואם אבן לשון זכר,"
        },
        {
          "s": 44,
          "text": "הול\"ל האבן הזה כו'."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה יום ההילולא"
        },
        {
          "s": 2,
          "text": "(ט' כסלו)"
        },
        {
          "s": 3,
          "text": "הוא ערב יום הגאולה12"
        },
        {
          "s": 4,
          "text": "(יו\"ד כסלו13)."
        },
        {
          "s": 5,
          "text": "וידוע שהגאולה שייכת להענין דפדה בשלום נפשי14,"
        },
        {
          "s": 6,
          "text": "וכמ\"ש כ\"ק אדמו\"ר הזקן באגה\"ק שלו15"
        },
        {
          "s": 7,
          "text": "(בנוגע להגאולה די\"ט כסלו)"
        },
        {
          "s": 8,
          "text": "כשקראתי כו' פדה בשלום נפשי כו' יצאתי בשלום."
        },
        {
          "s": 9,
          "text": "דמזה מובן16"
        },
        {
          "s": 10,
          "text": "גם בנוגע להגאולה של כ\"ק אדמו\"ר האמצעי17,"
        },
        {
          "s": 11,
          "text": "שהגאולה שייכת להענין דפדה בשלום נפשי שאומרים זה בשיעור תהלים החדשי"
        },
        {
          "s": 12,
          "text": "(ביום העשירי לחודש)."
        },
        {
          "s": 13,
          "text": "ובפרט לפי הידוע18,"
        },
        {
          "s": 14,
          "text": "שהסדר המסודר אצל כ\"ק רבותינו נשיאינו הי' שהיו אומרים שיעור תהלים כפי שנחלק לימי החודש,"
        },
        {
          "s": 15,
          "text": "ובזמנים ידועים היו אומרים תהלים בשופי19,"
        },
        {
          "s": 16,
          "text": "היינו שהיו מוסיפים לומר גם שיעור תהלים השבועי – שעפ\"ז מבאר כ\"ק מו\"ח אדמו\"ר13"
        },
        {
          "s": 17,
          "text": "מה שאדמו\"ר הזקן אמר בי\"ט כסלו הפסוק פדה בשלום נפשי,"
        },
        {
          "s": 18,
          "text": "אף שפסוק זה אינו בשיעור החדשי דיום יט בחודש כ\"א במזמורי תהלים דיום השלישי בשבוע"
        },
        {
          "s": 19,
          "text": "(ויט\"כ חל אז ביום השלישי),"
        },
        {
          "s": 20,
          "text": "כי בהיות אדמו\"ר הזקן במאסר הוסיף לומר גם שיעור תהלים השבועי."
        },
        {
          "s": 21,
          "text": "הרי מזה מובנת עוד יותר השייכות של הגאולה לענין פדה בשלום נפשי."
        },
        {
          "s": 22,
          "text": "דהרי השיעור הקבוע הוא שיעור תהלים החדשי,"
        },
        {
          "s": 23,
          "text": "והשיעור של יום יט בחודש הוא תפלה למשה,"
        },
        {
          "s": 24,
          "text": "שגם ענין זה שייך להגאולה20,"
        },
        {
          "s": 25,
          "text": "ומ\"מ מקשר כ\"ק אדמו\"ר הזקן הגאולה שלו להפסוק פדה בשלום נפשי דוקא,"
        },
        {
          "s": 26,
          "text": "הרי זה מכריח עוד יותר שייכות ענין הגאולה לפסוק זה."
        },
        {
          "s": 27,
          "text": "ומזה מובן שכ\"ה גם בנוגע להגאולה דיו\"ד כסלו,"
        },
        {
          "s": 28,
          "text": "כנ\"ל."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "והענין הוא,"
        },
        {
          "s": 1,
          "text": "דהנה עיקר החידוש בהכתוב פדה בשלום נפשי הוא"
        },
        {
          "s": 2,
          "text": "(לא עצם ענין הפדי',"
        },
        {
          "s": 3,
          "text": "כ\"א כמו שמבאר בעל ההילולא בד\"ה פדה בשלום נפשי21"
        },
        {
          "s": 4,
          "text": "(שבספרו שערי תשובה))"
        },
        {
          "s": 5,
          "text": "בזה שהפדי' היא בשלום."
        },
        {
          "s": 6,
          "text": "דאפשר להיות פדי' בדרך מלחמה,"
        },
        {
          "s": 7,
          "text": "והחידוש שבפדי' זו היא אשר"
        },
        {
          "s": 8,
          "text": "(אף שהיא מקרב לי,"
        },
        {
          "s": 9,
          "text": "מ\"מ)"
        },
        {
          "s": 10,
          "text": "פדה בשלום"
        },
        {
          "s": 11,
          "text": "(דוקא)"
        },
        {
          "s": 12,
          "text": "נפשי."
        },
        {
          "s": 13,
          "text": "וזהו ג\"כ פי' המשך הכתוב כי ברבים היו עמדי,"
        },
        {
          "s": 14,
          "text": "דתיבת כי היא נתינת טעם לתחלת דבריו שאמר פדה בשלום נפשי,"
        },
        {
          "s": 15,
          "text": "שהטעם שפדה בשלום דוקא ולא במלחמה הוא – זה שברבים היו עמדי22."
        },
        {
          "s": 16,
          "text": "דעי\"ז שגם אלו שהם בחי' רבים היו עמדי23,"
        },
        {
          "s": 17,
          "text": "וע\"ד מרז\"ל24"
        },
        {
          "s": 18,
          "text": "שגם אנשי אבשלום התפללו עבור דוד,"
        },
        {
          "s": 19,
          "text": "הנה עי\"ז פדה בשלום נפשי."
        }
      ]
    }
  ]
}