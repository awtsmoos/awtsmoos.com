{
  "globalIndex": 547,
  "owner": 47,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916877_theRebbe_274__p006",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916877_theRebbe_274__p006",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916877_theRebbe_274",
  "title": "מאמר באתי לגני תשל\"ב",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "והנה בההתבוננות המביאה להכנעה ושפלות,"
        },
        {
          "s": 3,
          "text": "שני אופנים."
        },
        {
          "s": 4,
          "text": "דבדרוש הנ\"ל של אדמו\"ר האמצעי65"
        },
        {
          "s": 5,
          "text": "מבואר,"
        },
        {
          "s": 6,
          "text": "שבכדי לבוא להכנעה ושפלות הוא ע\"י שיתבונן בעוצם פחיתותו וגודל ריחוקו כו',"
        },
        {
          "s": 7,
          "text": "ושההתבוננות תהי' בחשבון טוב ומדוקדק הנק' מארי דחושבנא."
        },
        {
          "s": 8,
          "text": "[ויש לומר,"
        },
        {
          "s": 9,
          "text": "דזה שאומר שההתבוננות צריכה להיות בחשבון טוב ומדוקדק הוא ע\"ד שמבאר בארוכה בשער היחוד66,"
        },
        {
          "s": 10,
          "text": "דכשההתבוננות היא בדרך כלל,"
        },
        {
          "s": 11,
          "text": "השגתו בהענין היא רק בבחינת מקיף,"
        },
        {
          "s": 12,
          "text": "וגם יכול להטעות את עצמו."
        },
        {
          "s": 13,
          "text": "ובכדי שתהי' אצלו השגה אמיתית ופנימית הוא ע\"י ההתבוננות בדרך פרט."
        },
        {
          "s": 14,
          "text": "אלא שלאחרי שמתבונן בהפרטים צריך לעיין ולהתבונן בהכלל."
        },
        {
          "s": 15,
          "text": "[ואומר שם67,"
        },
        {
          "s": 16,
          "text": "שכן קיבל אביו"
        },
        {
          "s": 17,
          "text": "(אדמו\"ר הזקן)"
        },
        {
          "s": 18,
          "text": "מהה\"מ בפי' גמור]."
        },
        {
          "s": 19,
          "text": "ויש לומר,"
        },
        {
          "s": 20,
          "text": "דזה שאומר שההתבוננות צריכה להיות בחשבון טוב ומדוקדק הוא שיתבונן בהפרטים."
        },
        {
          "s": 21,
          "text": "דנוסף לזה שחשבון"
        },
        {
          "s": 22,
          "text": "(בכלל)"
        },
        {
          "s": 23,
          "text": "הוא חשבון דהפרטים,"
        },
        {
          "s": 24,
          "text": "הרי חשבון מדוקדק הוא שמדייק בכל פרט]."
        },
        {
          "s": 25,
          "text": "ובדרוש הנ\"ל דהצ\"צ מוסיף68,"
        },
        {
          "s": 26,
          "text": "דענין מארי דחושבנא הוא ע\"ד מארז\"ל69"
        },
        {
          "s": 27,
          "text": "עה\"פ70"
        },
        {
          "s": 28,
          "text": "בואו חשבון,"
        },
        {
          "s": 29,
          "text": "בואו ונחשוב חשבונו של עולם."
        },
        {
          "s": 30,
          "text": "החשבון דתכלית הירידה דבריאת העולם והתכלית דירידת נשמתו לעולם הזה,"
        },
        {
          "s": 31,
          "text": "שהירידה היא צורך עלי'."
        },
        {
          "s": 32,
          "text": "וכשיתבונן שהוא אינו משלים הכוונה שבשבילה ירדה נשמתו למטה,"
        },
        {
          "s": 33,
          "text": "יבוא לידי שפלות."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "והחילוק דשני הענינים הוא,"
        },
        {
          "s": 1,
          "text": "דלהביאור שהשפלות"
        },
        {
          "s": 2,
          "text": "(הכובד ראש שקודם התפלה)"
        },
        {
          "s": 3,
          "text": "היא ע\"י ההתבוננות בעוצם פחיתותו וגודל ריחוקו,"
        },
        {
          "s": 4,
          "text": "זה שהשפלות"
        },
        {
          "s": 5,
          "text": "(כובד ראש)"
        },
        {
          "s": 6,
          "text": "היא הכנה לתפלה,"
        },
        {
          "s": 7,
          "text": "הוא מפני שע\"י הביטול מגיעים לדרגות הכי נעלות,"
        },
        {
          "s": 8,
          "text": "דכל המשפיל עצמו הקב\"ה מגביהו."
        },
        {
          "s": 9,
          "text": "ולהביאור שהשפלות היא ע\"י ההתבוננות שכוונת הירידה היא לצורך עלי',"
        },
        {
          "s": 10,
          "text": "זה שהשפלות היא הכנה לתפלה הוא"
        },
        {
          "s": 11,
          "text": "(לא רק מצד מעלת הביטול,"
        },
        {
          "s": 12,
          "text": "אלא גם)"
        },
        {
          "s": 13,
          "text": "שענינה דשפלות זו עצמה שייכת לתפלה."
        },
        {
          "s": 14,
          "text": "כי בכדי שיורגש אצלו הירידה"
        },
        {
          "s": 15,
          "text": "(ושהכוונה דהירידה היא לצורך עלי')"
        },
        {
          "s": 16,
          "text": "הוא ע\"י ההרגש דעילוי והפלאת האלקות."
        },
        {
          "s": 17,
          "text": "וכל שירגיש יותר העילוי דאלקות ירגיש יותר גודל הירידה."
        },
        {
          "s": 18,
          "text": "וכיון שהשפלות שלו היא מזה שלא השלים כוונת הירידה,"
        },
        {
          "s": 19,
          "text": "הרי בהשפלות שלו נרגש קצת העילוי דאלקות."
        },
        {
          "s": 20,
          "text": "ולהעיר ממ\"ש אדמו\"ר הזקן בשו\"ע שלו71,"
        },
        {
          "s": 21,
          "text": "שקודם התפלה צריך לחשוב מרוממות הא-ל יתברך ושפלות האדם,"
        },
        {
          "s": 22,
          "text": "דיש לומר,"
        },
        {
          "s": 23,
          "text": "שהמחשבה בשפלות האדם אינה ענין בפ\"ע אלא המשך ותוצאה מהמחשבה ברוממות הא-ל72."
        },
        {
          "s": 24,
          "text": "ועפ\"ז,"
        },
        {
          "s": 25,
          "text": "זה שהכובד ראש הוא הכנה לתפלה הוא לא רק מצד מעלת הביטול אלא גם מפני שבהכובד ראש נרגש רוממות הא-ל,"
        },
        {
          "s": 26,
          "text": "ענין התפלה."
        },
        {
          "s": 27,
          "text": "אלא שההתבוננות ברוממות הא-ל היא בנוגע לשפלות האדם,"
        },
        {
          "s": 28,
          "text": "ולכן,"
        },
        {
          "s": 29,
          "text": "ע\"י התבוננות זו בא להכנעה ושפלות."
        },
        {
          "s": 30,
          "text": "וההתבוננות שבתפלה היא ברוממות הא-ל עצמה,"
        },
        {
          "s": 31,
          "text": "והביטול שע\"י התבוננות זו הוא"
        },
        {
          "s": 32,
          "text": "(לא הכנעה ושפלות,"
        },
        {
          "s": 33,
          "text": "אלא)"
        },
        {
          "s": 34,
          "text": "שנכלל באלקות"
        },
        {
          "s": 35,
          "text": "(כנ\"ל סעיף ט)."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "ולהוסיף,"
        },
        {
          "s": 3,
          "text": "שהחילוק בין ההתבוננות שקודם התפלה וההתבוננות שבתפלה הוא גם בהענין דרוממות הא-ל עצמו."
        },
        {
          "s": 4,
          "text": "דזה שהביטול בתפלה הוא שמתבטל לגמרי"
        },
        {
          "s": 5,
          "text": "(בדוגמת הקרבן שהי' נשרף באש שלמעלה),"
        },
        {
          "s": 6,
          "text": "ביטול דכלות הנפש"
        },
        {
          "s": 7,
          "text": "(כמובא לעיל ס\"ט מהבעש\"ט),"
        },
        {
          "s": 8,
          "text": "הוא,"
        },
        {
          "s": 9,
          "text": "לפי שההתבוננות דתפלה"
        },
        {
          "s": 10,
          "text": "(ק\"ש)"
        },
        {
          "s": 11,
          "text": "היא באוא\"ס שלמעלה משייכות לעולמות,"
        },
        {
          "s": 12,
          "text": "דכולא קמי' כלא חשיב73,"
        },
        {
          "s": 13,
          "text": "ההתבוננות73"
        },
        {
          "s": 14,
          "text": "דהוי' אחד."
        },
        {
          "s": 15,
          "text": "ומבאר אדמו\"ר מהר\"ש74,"
        },
        {
          "s": 16,
          "text": "דענין"
        },
        {
          "s": 17,
          "text": "(בחינת)"
        },
        {
          "s": 18,
          "text": "אחד הוא כמו אנת75"
        },
        {
          "s": 19,
          "text": "הוא חד ולא בחושבן."
        },
        {
          "s": 20,
          "text": "ומבאר,"
        },
        {
          "s": 21,
          "text": "דבענינים שהם בערך זל\"ז"
        },
        {
          "s": 22,
          "text": "(אלא שאחד גדול ונעלה מהשני)"
        },
        {
          "s": 23,
          "text": "שייך ענין החשבון בכמות ואיכות העילוי דאחד לגבי השני."
        },
        {
          "s": 24,
          "text": "וכמו אצילות ובי\"ע,"
        },
        {
          "s": 25,
          "text": "שיש ביניהם איזה ערך"
        },
        {
          "s": 26,
          "text": "[דהגם שיש פרסא בין אצילות ובי\"ע,"
        },
        {
          "s": 27,
          "text": "מ\"מ התהוות חכמה דבריאה מחכמה דאצילות היא על ידי שהחכמה דאצילות עצמה מתלבשת בהפרסא וגורמת התהוות חכמה דבריאה76],"
        },
        {
          "s": 28,
          "text": "לכן,"
        },
        {
          "s": 29,
          "text": "שייך חשבון בגודל העילוי דאצילות לגבי בי\"ע."
        },
        {
          "s": 30,
          "text": "אבל לגבי אוא\"ס שכל העולמות"
        },
        {
          "s": 31,
          "text": "(גם עולם האצילות)"
        },
        {
          "s": 32,
          "text": "הם באין ערוך לגבי'"
        },
        {
          "s": 33,
          "text": "[והתהוותם היא על ידי הצמצום,"
        },
        {
          "s": 34,
          "text": "דענין הצמצום הוא התעלמות האור76],"
        },
        {
          "s": 35,
          "text": "אין שייך שם ענין החשבון,"
        },
        {
          "s": 36,
          "text": "אנת הוא חד ולא בחושבן."
        },
        {
          "s": 37,
          "text": "ועל ידי התבוננות זו יבוא להאהבה דמי77"
        },
        {
          "s": 38,
          "text": "לי בשמים ועמך לא חפצתי בארץ,"
        },
        {
          "s": 39,
          "text": "שלא יהי' לו חפץ לא בגן עדן התחתון"
        },
        {
          "s": 40,
          "text": "(ארץ)"
        },
        {
          "s": 41,
          "text": "וגם לא בגן עדן העליון"
        },
        {
          "s": 42,
          "text": "(שמים)"
        },
        {
          "s": 43,
          "text": "אלא לו לבדו."
        },
        {
          "s": 44,
          "text": "וע\"ד מ\"ש אדמו\"ר הזקן78"
        },
        {
          "s": 45,
          "text": "איך וויל זע גאָר ניסט איך וויל ניט דאיין ג\"ע איך וויל ניט דאיין עוה\"ב כו' איך וויל מער ניט אַז דיך אַליין."
        }
      ]
    }
  ]
}