{
  "globalIndex": 580,
  "owner": 30,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917075_theRebbe_40__p002",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917075_theRebbe_40__p002",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518917075_theRebbe_40",
  "title": "מאמר באתי לגני תשל\"ח",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה ידוע שבמתן תורה ניתן הכח על כללות ענין העבודה."
        },
        {
          "s": 2,
          "text": "דהגם שההמשכה שע\"י עבודה,"
        },
        {
          "s": 3,
          "text": "ומכש\"כ שע\"י העבודה דהפיכת החושך לאור,"
        },
        {
          "s": 4,
          "text": "יש לה יתרון על ההמשכה שהיתה"
        },
        {
          "s": 5,
          "text": "(בפועל)"
        },
        {
          "s": 6,
          "text": "במתן תורה,"
        },
        {
          "s": 7,
          "text": "זה גופא שע\"י עבודה יוכלו להמשיך המשכות אלו,"
        },
        {
          "s": 8,
          "text": "הוא בכח ההמשכה שהיתה במתן תורה."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דזה שבההמשכה דמתן תורה הי'"
        },
        {
          "s": 2,
          "text": "(בכח)"
        },
        {
          "s": 3,
          "text": "גם העילוי דההמשכה שע\"י עבודה וגם העילוי דיתרון האור הבא מן החושך,"
        },
        {
          "s": 4,
          "text": "הוא,"
        },
        {
          "s": 5,
          "text": "כי ההמשכה דמתן תורה היתה לאחרי שאמר יתרו12"
        },
        {
          "s": 6,
          "text": "עתה ידעתי כי גדול הוי' מכל האלקים,"
        },
        {
          "s": 7,
          "text": "כדאיתא בזהר13,"
        },
        {
          "s": 8,
          "text": "שע\"י שהודה יתרו ואמר עתה ידעתי כי גדול הוי' גו' אסתלק ואתייקר14"
        },
        {
          "s": 9,
          "text": "קוב\"ה ביקרי' עילא ותתא ולבתר יהיב אורייתא,"
        },
        {
          "s": 10,
          "text": "ועי\"ז"
        },
        {
          "s": 11,
          "text": "(שההמשכה דמתן תורה היתה לאחרי הודאת יתרו)"
        },
        {
          "s": 12,
          "text": "נעשה יתרון"
        },
        {
          "s": 13,
          "text": "(כביכול)"
        },
        {
          "s": 14,
          "text": "בהתורה שניתנה במתן תורה"
        },
        {
          "s": 15,
          "text": "(אף שניתנה מצד מלמעלה)"
        },
        {
          "s": 16,
          "text": "בדוגמת יתרון האור הבא מן החושך."
        },
        {
          "s": 17,
          "text": "אלא שבמתן תורה,"
        },
        {
          "s": 18,
          "text": "כיון שנתינת התורה היתה מצד למעלה"
        },
        {
          "s": 19,
          "text": "(והודאת יתרו היתה רק הקדמה למתן תורה),"
        },
        {
          "s": 20,
          "text": "היתרון"
        },
        {
          "s": 21,
          "text": "(כביכול)"
        },
        {
          "s": 22,
          "text": "בהתורה שנעשה ע\"י הודאת יתרו הי' רק בכח,"
        },
        {
          "s": 23,
          "text": "ועי\"ז נמשכה הנתינת כח,"
        },
        {
          "s": 24,
          "text": "שע\"י העבודה דהפיכת החושך לאור יהי' יתרון בהאור"
        },
        {
          "s": 25,
          "text": "(גם)"
        },
        {
          "s": 26,
          "text": "בפועל."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יש לבאר מ\"ש בכמה דרושים15"
        },
        {
          "s": 2,
          "text": "שבכדי לבאר מה שקודם מ\"ת הוצרכה להיות הודאת יתרו,"
        },
        {
          "s": 3,
          "text": "יובן זה בהקדים מ\"ש16"
        },
        {
          "s": 4,
          "text": "וראיתי אני שיש יתרון לחכמה מן הסכלות כיתרון האור מן החושך"
        },
        {
          "s": 5,
          "text": "[דלכאורה אינו מובן,"
        },
        {
          "s": 6,
          "text": "וכמו שמדייק בזהר17"
        },
        {
          "s": 7,
          "text": "אמאי אמר וראיתי אני"
        },
        {
          "s": 8,
          "text": "[שלמה המלך,"
        },
        {
          "s": 9,
          "text": "החכם מכל אדם18],"
        },
        {
          "s": 10,
          "text": "והלא כו\"ע ידעי דא שיש יתרון לחכמה מן הסכלות."
        },
        {
          "s": 11,
          "text": "והביאור בזה19],"
        },
        {
          "s": 12,
          "text": "שהכוונה בסכלות"
        },
        {
          "s": 13,
          "text": "(כאן)"
        },
        {
          "s": 14,
          "text": "היא"
        },
        {
          "s": 15,
          "text": "(לא לשטות כפשוטה,"
        },
        {
          "s": 16,
          "text": "אלא)"
        },
        {
          "s": 17,
          "text": "לחכמות חיצוניות שהם סכלות לגבי חכמת התורה."
        },
        {
          "s": 18,
          "text": "ועל זה אומר וראיתי אני שיש יתרון לחכמה מן הסכלות כיתרון האור מן החושך,"
        },
        {
          "s": 19,
          "text": "דכמו שיתרון האור הוא מן החושך דוקא,"
        },
        {
          "s": 20,
          "text": "דע\"י שהחושך נהפך לאור נעשה יתרון בהאור"
        },
        {
          "s": 21,
          "text": "(כמבואר בארוכה בההמשך דההילולא),"
        },
        {
          "s": 22,
          "text": "עד\"ז הוא בחכמה"
        },
        {
          "s": 23,
          "text": "(חכמת התורה)"
        },
        {
          "s": 24,
          "text": "וסכלות"
        },
        {
          "s": 25,
          "text": "(חכמות חיצוניות),"
        },
        {
          "s": 26,
          "text": "שע\"י בירור והפיכת החכמה דלעו\"ז לקדושה,"
        },
        {
          "s": 27,
          "text": "נעשה יתרון והוספה בחכמה דקדושה."
        },
        {
          "s": 28,
          "text": "וזהו מה שקודם מתן תורה הוצרכה להיות הודאת יתרו,"
        },
        {
          "s": 29,
          "text": "כי יתרו הי' חכם גדול בחכמות חיצוניות,"
        },
        {
          "s": 30,
          "text": "ועל ידי שהודה יתרו כי גדול הוי' מכל האלקים נעשה הבירור של חכמה דלעו\"ז שנהפכה לחכמה דקדושה,"
        },
        {
          "s": 31,
          "text": "ועי\"ז נעשה יתרון והוספה בחכמה דקדושה,"
        },
        {
          "s": 32,
          "text": "למעלה יותר מכמו שהיא מצד עצמה."
        },
        {
          "s": 33,
          "text": "[ועפ\"ז יש לבאר מה שארז\"ל20"
        },
        {
          "s": 34,
          "text": "דהטעם שנקרא בשם יתרו הוא לפי שיתר פרשה אחת בתורה,"
        },
        {
          "s": 35,
          "text": "דלכאורה הרי גם השם יתר הוא מלשון יתרון,"
        },
        {
          "s": 36,
          "text": "ולמה נקרא בשם יתר לפני שיתר פרשה בתורה."
        },
        {
          "s": 37,
          "text": "וע\"פ הנ\"ל יש לומר21,"
        },
        {
          "s": 38,
          "text": "דהשם יתר"
        },
        {
          "s": 39,
          "text": "(מלשון יתרון)"
        },
        {
          "s": 40,
          "text": "שהי' נקרא בו מקודם הוא מצד יתרון ומעלת השכל,"
        },
        {
          "s": 41,
          "text": "דיתרון ומעלת השכל"
        },
        {
          "s": 42,
          "text": "(על המדות)"
        },
        {
          "s": 43,
          "text": "הוא גם בחכמה דלעו\"ז."
        },
        {
          "s": 44,
          "text": "אלא שבחכמה דלעו\"ז,"
        },
        {
          "s": 45,
          "text": "להיותה תכלית הישות,"
        },
        {
          "s": 46,
          "text": "והנפילה שע\"י המוחין דלעו\"ז היא נפילה גדולה יותר מהנפילה שע\"י המדות דלעו\"ז22,"
        },
        {
          "s": 47,
          "text": "היתרון שבה הוא ע\"ד שאמרו23"
        },
        {
          "s": 48,
          "text": "כל יתר כנטול דמי."
        },
        {
          "s": 49,
          "text": "ולאחרי שנתגייר ויתר פרשה אחת בתורה נקרא בשם יתרו בתוספות וא\"ו,"
        },
        {
          "s": 50,
          "text": "דוא\"ו מורה על תורה24"
        },
        {
          "s": 51,
          "text": "כדאיתא בזהר25"
        },
        {
          "s": 52,
          "text": "שוא\"ו הוא אות אמת ואין26"
        },
        {
          "s": 53,
          "text": "אמת אלא תורה,"
        },
        {
          "s": 54,
          "text": "להורות שהיתרון שבו הוא"
        },
        {
          "s": 55,
          "text": "(לא בחכמה דלעו\"ז אלא)"
        },
        {
          "s": 56,
          "text": "בחכמת התורה]."
        }
      ]
    }
  ]
}