{
  "globalIndex": 264,
  "owner": 14,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915304_theRebbe_180__p010",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915304_theRebbe_180__p010",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915304_theRebbe_180",
  "title": "מאמר ושבתי בשלום תשל\"ח",
  "part": 10,
  "sections": [
    {
      "v": 27,
      "items": [
        {
          "s": 0,
          "text": "כ)"
        },
        {
          "s": 1,
          "text": "אלא שאעפ\"כ,"
        },
        {
          "s": 2,
          "text": "הכוונה בירידת הנשמה למטה היא לא בשביל העלי' דהנשמה,"
        },
        {
          "s": 3,
          "text": "שע\"י ירידתה למטה נעשית בחי' בעל תשובה,"
        },
        {
          "s": 4,
          "text": "כי אם,"
        },
        {
          "s": 5,
          "text": "בשביל הבירור והזיכוך דהגוף ודנה\"ב וחלקו בעולם."
        },
        {
          "s": 6,
          "text": "ויש לבאר זה,"
        },
        {
          "s": 7,
          "text": "דהחידוש שבהתשובה דהנשמה,"
        },
        {
          "s": 8,
          "text": "מכיון שהנשמה היא חלק אלוקה ממעל ממש165,"
        },
        {
          "s": 9,
          "text": "הרי זה שהנשמה מתגברת על הדברים המעלימים,"
        },
        {
          "s": 10,
          "text": "וגם זה שהיא מתגלית ופועלת בעניני הגוף ונה\"ב גופא,"
        },
        {
          "s": 11,
          "text": "אין זה חידוש אמיתי."
        },
        {
          "s": 12,
          "text": "משא\"כ הבירור והזיכוך דהגוף ונה\"ב וחלקו בעולם,"
        },
        {
          "s": 13,
          "text": "הרי זה שנעשים כלים לאלקות הוא חידוש אמיתי."
        },
        {
          "s": 14,
          "text": "ולכן התענוג שלמעלה"
        },
        {
          "s": 15,
          "text": "(שהוא מדבר חידוש,"
        },
        {
          "s": 16,
          "text": "כנ\"ל)"
        },
        {
          "s": 17,
          "text": "מבירור הגוף וכו' הוא תענוג גדול יותר מהתענוג הבא בתשובה דהנשמה."
        },
        {
          "s": 18,
          "text": "[ויתירה מזו,"
        },
        {
          "s": 19,
          "text": "שגם כשהפעולה דנה\"ב היא באופן של דחי',"
        },
        {
          "s": 20,
          "text": "אתכפיא סט\"א,"
        },
        {
          "s": 21,
          "text": "יש בזה נח\"ר גדול למעלה,"
        },
        {
          "s": 22,
          "text": "כמבואר בתניא148]."
        },
        {
          "s": 23,
          "text": "ובזה גופא,"
        },
        {
          "s": 24,
          "text": "עיקר החידוש"
        },
        {
          "s": 25,
          "text": "(והנח\"ר דלמעלה)"
        },
        {
          "s": 26,
          "text": "הוא בהבירור דחלקו בעולם,"
        },
        {
          "s": 27,
          "text": "שהבירור דגוף ונה\"ב,"
        },
        {
          "s": 28,
          "text": "מכיון שזה נפש וגוף של ישראל"
        },
        {
          "s": 29,
          "text": "[שגם נפש הבהמית והגוף דישראל הוא לא כבאוה\"ע],"
        },
        {
          "s": 30,
          "text": "אין זה חידוש כ\"כ,"
        },
        {
          "s": 31,
          "text": "ועיקר העילוי הוא בהבירור דחלקו בעולם ובפרט בבירור הניצוצות שבגקה\"ט"
        },
        {
          "s": 32,
          "text": "(ע\"י תשובה כפשוטה שזדונות נעשים כזכיות166,"
        },
        {
          "s": 33,
          "text": "וכן ע\"י נסיונות167"
        },
        {
          "s": 34,
          "text": "וכיו\"ב)."
        },
        {
          "s": 35,
          "text": "[ועפ\"ז יובן גם מה שמבואר בכ\"מ168"
        },
        {
          "s": 36,
          "text": "שבכדי לבוא לבחי' בכל מאדך הוא ע\"י אתהפכא חשוכא לנהורא"
        },
        {
          "s": 37,
          "text": "[החושך של הענינים הגשמיים שעוסק בהם במשך היום],"
        },
        {
          "s": 38,
          "text": "הגם שגם בהעבודה דבכל לבבך בשני יצריך מהפך היצה\"ר לקדושה,"
        },
        {
          "s": 39,
          "text": "כי עיקר העילוי הוא בהבירור דחלקו בעולם"
        },
        {
          "s": 40,
          "text": "(שמחוצה לו)]."
        },
        {
          "s": 41,
          "text": "וזהו גם ושבתי בשלום אל בית אבי,"
        },
        {
          "s": 42,
          "text": "שהעבודה דאתכפיא ואתהפכא חשוכא לנהורא העושה את הצחוק והתענוג שלמעלה"
        },
        {
          "s": 43,
          "text": "(ענין \"אבי\" – יצחק)"
        },
        {
          "s": 44,
          "text": "היא באופן דבית,"
        },
        {
          "s": 45,
          "text": "היינו שעבודתו זו היא בקביעות169"
        },
        {
          "s": 46,
          "text": "בכל עניניו,"
        },
        {
          "s": 47,
          "text": "לא רק בגופו ובנפשו הבהמית כ\"א גם בחלקו בעולם."
        }
      ]
    },
    {
      "v": 28,
      "items": [
        {
          "s": 0,
          "text": "כ)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "וע\"פ כל הנ\"ל יובן בעומק יותר זה שעיקר העבודה שבשביל זה ירדה הנשמה למטה"
        },
        {
          "s": 3,
          "text": "(ויצא יעקב גו' חרנה)"
        },
        {
          "s": 4,
          "text": "הוא ויקח מאבני המקום גו',"
        },
        {
          "s": 5,
          "text": "שקאי"
        },
        {
          "s": 6,
          "text": "(כנ\"ל סעיף ט)"
        },
        {
          "s": 7,
          "text": "על הבירור דעניני העולם,"
        },
        {
          "s": 8,
          "text": "דנוסף על היתרון שבהעבודה דכל מעשיך לשם שמים על העבודה דתומ\"צ"
        },
        {
          "s": 9,
          "text": "(כנ\"ל שם),"
        },
        {
          "s": 10,
          "text": "הנה גם בהעבודה דכל מעשיך לשם שמים גופא שני ענינים,"
        },
        {
          "s": 11,
          "text": "עליית האדם שנעשית עי\"ז"
        },
        {
          "s": 12,
          "text": "(תשובה דהנשמה),"
        },
        {
          "s": 13,
          "text": "וההעלאה של הדברים הגשמיים."
        },
        {
          "s": 14,
          "text": "ובשני ענינים אלו,"
        },
        {
          "s": 15,
          "text": "עיקר העבודה היא ויקח מאבני המקום,"
        },
        {
          "s": 16,
          "text": "הבירור דדברים הגשמיים,"
        },
        {
          "s": 17,
          "text": "אבני המקום."
        },
        {
          "s": 18,
          "text": "וזהו ג\"כ מ\"ש והי' הוי' לי לאלקים והאבן הזאת אשר שמתי מצבה יהי' בית אלקים,"
        },
        {
          "s": 19,
          "text": "והי' הוי' לי לאלקים הוא העילוי שנעשה בהאדם ע\"י עבודת הבירורים,"
        },
        {
          "s": 20,
          "text": "ולאח\"ז מוסיף והאבן הזאת אשר שמתי מצבה יהי' בית אלקים,"
        },
        {
          "s": 21,
          "text": "שגם האבן הזאת,"
        },
        {
          "s": 22,
          "text": "הדברים הגשמיים עצמם שהיו בתחילה אבני המקום לשון רבים וע\"י עבודת האדם נעשו אבן אחת"
        },
        {
          "s": 23,
          "text": "[ובאופן דשמתי מצבה מלשון נצב170"
        },
        {
          "s": 24,
          "text": "מלך,"
        },
        {
          "s": 25,
          "text": "שנעשה בעה\"ב"
        },
        {
          "s": 26,
          "text": "(מלך)"
        },
        {
          "s": 27,
          "text": "על כל עניניו דחלקו בעולם."
        },
        {
          "s": 28,
          "text": "וגם פירוש מצבה מלשון נצב מלך,"
        },
        {
          "s": 29,
          "text": "שממשיך בהם גילוי מלכותו ית',"
        },
        {
          "s": 30,
          "text": "בחינת מלכותו ברצון קבלו עליהם"
        },
        {
          "s": 31,
          "text": "(שלמעלה מבחי' ממשלה שבהכרח)171],"
        },
        {
          "s": 32,
          "text": "יהיו בית אלקים,"
        },
        {
          "s": 33,
          "text": "שיהיו בית ודירה לאלקים שלמעלה מהוי'"
        },
        {
          "s": 34,
          "text": "(גם מוהי' הוי' לי לאלקים172"
        },
        {
          "s": 35,
          "text": "שמצד התשובה דנה\"א173),"
        },
        {
          "s": 36,
          "text": "להעלם העצמי דעצמותו ית'."
        }
      ]
    },
    {
      "v": 29,
      "items": [
        {
          "s": 0,
          "text": "כ)"
        },
        {
          "s": 1,
          "text": "ב)"
        },
        {
          "s": 2,
          "text": "ובכדי שהאבן הזאת יהי' בית אלקים הוא ע\"י העבודה דויקח את האבן גו' וישם אותה מצבה ויצוק שמן על ראשה174."
        },
        {
          "s": 3,
          "text": "ויקח את האבן לשון יחיד,"
        },
        {
          "s": 4,
          "text": "היינו,"
        },
        {
          "s": 5,
          "text": "דגם לאחרי שעשה מאבני המקום"
        },
        {
          "s": 6,
          "text": "(לשון רבים)"
        },
        {
          "s": 7,
          "text": "אבן אחת,"
        },
        {
          "s": 8,
          "text": "בדוגמת יו\"ד דשם הוי' בחי' חכמה,"
        },
        {
          "s": 9,
          "text": "הגבי' אותה למעלה יותר"
        },
        {
          "s": 10,
          "text": "(וישם אותה מצבה,"
        },
        {
          "s": 11,
          "text": "כענין קמה175"
        },
        {
          "s": 12,
          "text": "אלומתי וגם נצבה176)"
        },
        {
          "s": 13,
          "text": "לבחי' י\"ג מדות רחמים העליונים שהן בחי' יודי\"ן ווי\"ן177."
        },
        {
          "s": 14,
          "text": "דיש וא\"ו שלמטה מהיו\"ד ויש וא\"ו שלמעלה מהיו\"ד"
        },
        {
          "s": 15,
          "text": "[שלכן מובא בתו\"א"
        },
        {
          "s": 16,
          "text": "(בתחילת הענין177)"
        },
        {
          "s": 17,
          "text": "שהשערה עצמה הוא בחי' ו' ומקום יניקתה הוא בחי' יו\"ד – הגם שבסיום הענין178"
        },
        {
          "s": 18,
          "text": "מסיק שם שהו' הוא למעלה מיו\"ד – כי יש ב' ענינים בזה179]."
        },
        {
          "s": 19,
          "text": "ואח\"כ ויצוק שמן על ראשה,"
        },
        {
          "s": 20,
          "text": "שהמשיך בה מבחינה שלמעלה מי\"ג ת\"ד178."
        },
        {
          "s": 21,
          "text": "ועי\"ז והאבן הזאת גו' יהי' בית אלקים,"
        },
        {
          "s": 22,
          "text": "יהי' לשון זכר"
        },
        {
          "s": 23,
          "text": "(הגם שאמר והאבן הזאת לשון נקבה180),"
        },
        {
          "s": 24,
          "text": "כי קאי על הגילוי דגאולה העתידה שאז יהי' שיר חדש לשון זכר"
        },
        {
          "s": 25,
          "text": "(גאולה שאין אחרי' גלות)181."
        }
      ]
    }
  ]
}