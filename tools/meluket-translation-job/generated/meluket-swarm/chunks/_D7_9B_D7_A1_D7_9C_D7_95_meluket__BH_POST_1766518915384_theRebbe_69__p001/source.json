{
  "globalIndex": 277,
  "owner": 27,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915384_theRebbe_69__p001",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915384_theRebbe_69__p001",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915384_theRebbe_69",
  "title": "מאמר אתה אחד תשמ\"ב",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ ויצא,"
        },
        {
          "s": 2,
          "text": "ט' כסלו,"
        },
        {
          "s": 3,
          "text": "ערב יו\"ד כסלו,"
        },
        {
          "s": 4,
          "text": "ה'תשמ\"ב*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "אתה אחד1"
        },
        {
          "s": 1,
          "text": "ושמך אחד ומי כעמך כישראל2"
        },
        {
          "s": 2,
          "text": "גוי אחד בארץ כו',"
        },
        {
          "s": 3,
          "text": "ומבאר כ\"ק אדמו\"ר האמצעי בעל ההילולא דט' כסלו"
        },
        {
          "s": 4,
          "text": "(ובעל הגאולה דיו\"ד כסלו3)"
        },
        {
          "s": 5,
          "text": "במאמרו ד\"ה זה4"
        },
        {
          "s": 6,
          "text": "[שכנראה הוא הדרוש אתה אחד שאמרו בש\"ק האחרון בשבתו במאסר"
        },
        {
          "s": 7,
          "text": "(ש\"פ ויצא,"
        },
        {
          "s": 8,
          "text": "ט' כסלו,"
        },
        {
          "s": 9,
          "text": "תקפ\"ז5)"
        },
        {
          "s": 10,
          "text": "קודם תפלת המנחה6],"
        },
        {
          "s": 11,
          "text": "שבכללות נוסח זה נתבארו ג' הקוין חג\"ת ד' פעמים,"
        },
        {
          "s": 12,
          "text": "בד' המדריגות הכוללים כל סדר ההשתלשלות,"
        },
        {
          "s": 13,
          "text": "מתחיל מלפני הצמצום."
        },
        {
          "s": 14,
          "text": "אתה אחד ושמך אחד ומי כעמך כישראל גוי אחד בארץ הם ג' הקוין חג\"ת כמו שהם לפני הצמצום,"
        },
        {
          "s": 15,
          "text": "דגם לפני הצמצום יש ההתחלקות דג' קוין,"
        },
        {
          "s": 16,
          "text": "באופן ששייך ענין ההתחלקות לפני הצמצום."
        },
        {
          "s": 17,
          "text": "תפארת גדולה ועטרת ישועה יום מנוחה וקדושה לעמך נתת הו\"ע ג' הקוין כמו שהם לאחרי הצמצום,"
        },
        {
          "s": 18,
          "text": "אבל בעולמות הא\"ס שלמעלה מאצילות ואינם בבחינת הגבלה ממש"
        },
        {
          "s": 19,
          "text": "(כבאצילות,"
        },
        {
          "s": 20,
          "text": "שיש שם כלים המגבילים),"
        },
        {
          "s": 21,
          "text": "ולכן אומר על זה לעמך נתת,"
        },
        {
          "s": 22,
          "text": "דנתינה הוא שניתן מיד ליד בלי שינוי"
        },
        {
          "s": 23,
          "text": "(בין קודם הצמצום ללאחר הצמצום)."
        },
        {
          "s": 24,
          "text": "ולאחרי זה"
        },
        {
          "s": 25,
          "text": "(אברהם יגל כו' מנוחת אהבה ונדבה כו')"
        },
        {
          "s": 26,
          "text": "מדבר בהג' קוין כמו שהם באצילות,"
        },
        {
          "s": 27,
          "text": "דבאצילות הם בבחינת הגבלה,"
        },
        {
          "s": 28,
          "text": "עשר ולא תשע עשר ולא אחד עשר7."
        },
        {
          "s": 29,
          "text": "ובזה גופא יש ב' מדריגות,"
        },
        {
          "s": 30,
          "text": "אברהם יגל יצחק ירנן יעקב ובניו ינוחו בו קאי על חג\"ת דאצילות,"
        },
        {
          "s": 31,
          "text": "מנוחת אהבה ונדבה מנוחת אמת ואמונה מנוחת שלום השקט ובטח קאי על נה\"י דאצילות."
        },
        {
          "s": 32,
          "text": "וכמבואר בארוכה בדרוש הנ\"ל."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה ע\"פ הידוע הדיוק בדרושי רבותינו נשיאינו,"
        },
        {
          "s": 2,
          "text": "שכל הענינים שבהם,"
        },
        {
          "s": 3,
          "text": "כולל גם זמן אמירתם,"
        },
        {
          "s": 4,
          "text": "הם בדיוק,"
        },
        {
          "s": 5,
          "text": "יש לקשר ד' מדריגות הנ\"ל עם הפסוק"
        },
        {
          "s": 6,
          "text": "(שבפרשת ויצא8,"
        },
        {
          "s": 7,
          "text": "דיש לומר שזהו מהטעמים על זה שמאמר זה נאמר בש\"פ ויצא9)"
        },
        {
          "s": 8,
          "text": "והנה סולם מוצב ארצה וראשו מגיע השמימה,"
        },
        {
          "s": 9,
          "text": "שקאי על הסולם דתפלה,"
        },
        {
          "s": 10,
          "text": "סולם דא צלותא10,"
        },
        {
          "s": 11,
          "text": "שבהסולם דתפלה יש ד' שליבות11."
        },
        {
          "s": 12,
          "text": "דיש לומר,"
        },
        {
          "s": 13,
          "text": "שד' השליבות דתפלה הרי נוסף על הביאור שהם כנגד ד' העולמות אבי\"ע"
        },
        {
          "s": 14,
          "text": "(כמבואר בכ\"מ11),"
        },
        {
          "s": 15,
          "text": "הם בכללות כנגד ד' דרגות הנ\"ל,"
        },
        {
          "s": 16,
          "text": "כללות סדר ההשתלשלות,"
        },
        {
          "s": 17,
          "text": "מתחיל מלפני הצמצום12."
        }
      ]
    }
  ]
}