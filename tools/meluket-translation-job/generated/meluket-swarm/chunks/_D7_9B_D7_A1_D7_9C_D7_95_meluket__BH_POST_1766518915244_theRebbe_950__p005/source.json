{
  "globalIndex": 246,
  "owner": 46,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915244_theRebbe_950__p005",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915244_theRebbe_950__p005",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915244_theRebbe_950",
  "title": "מאמר פדה בשלום תשכ\"ב",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ומהמשך הענינים שבהמאמר מובן,"
        },
        {
          "s": 1,
          "text": "דכשלימוד התורה אינו באופן זה,"
        },
        {
          "s": 2,
          "text": "אז,"
        },
        {
          "s": 3,
          "text": "(נוסף לזה שאינו מביא שלום בעולם)"
        },
        {
          "s": 4,
          "text": "אפשר שיביא לפירוד הלבבות,"
        },
        {
          "s": 5,
          "text": "היפך השלום."
        },
        {
          "s": 6,
          "text": "כי כשחסר אצלו ההרגש שהתורה היא תורת הוי',"
        },
        {
          "s": 7,
          "text": "אזי,"
        },
        {
          "s": 8,
          "text": "הוא מחזיק טובה לעצמו שלמד תורה הרבה43"
        },
        {
          "s": 9,
          "text": "ונעשה מציאות יש שמחזיק את עצמו לאיש המעלה ואדם חשוב,"
        },
        {
          "s": 10,
          "text": "וזה גורם לפירוד הלבבות,"
        },
        {
          "s": 11,
          "text": "כי מצד הישות שלו הוא חושב שכל מה שהזולת אומר או עושה הוא בכדי לנגד אליו."
        },
        {
          "s": 12,
          "text": "וכהסיפור"
        },
        {
          "s": 13,
          "text": "(המובא בהמאמר44),"
        },
        {
          "s": 14,
          "text": "שאחד"
        },
        {
          "s": 15,
          "text": "(בר דעת גדול בהשכלה)"
        },
        {
          "s": 16,
          "text": "בא להצ\"צ על יחידות והתאונן אַז מ'טרעט אויף מיר אין בית מדרש,"
        },
        {
          "s": 17,
          "text": "וענה לו הצ\"צ,"
        },
        {
          "s": 18,
          "text": "דו ביסט זיך מתפשט איבער דעם גאַנצן בית מדרש,"
        },
        {
          "s": 19,
          "text": "איז וואו יענער טרעט איז אַלץ אויף דיר."
        },
        {
          "s": 20,
          "text": "ויש לומר,"
        },
        {
          "s": 21,
          "text": "דזה שמביא בהמאמר שהטענה שלו היתה שדורסים עליו בבית מדרש,"
        },
        {
          "s": 22,
          "text": "דהגם שבית מדרש הוא מקדש מעט45,"
        },
        {
          "s": 23,
          "text": "דהשראת השכינה שבמקדש מעט היא מעין השראת השכינה שבבית המקדש46,"
        },
        {
          "s": 24,
          "text": "מ\"מ,"
        },
        {
          "s": 25,
          "text": "גם שם היתה התפשטות הישות שלו."
        },
        {
          "s": 26,
          "text": "ומדייק בהמאמר,"
        },
        {
          "s": 27,
          "text": "דזה שהתאונן לפני הצ\"צ שדורסים עליו הי' בהיותו ביחידות,"
        },
        {
          "s": 28,
          "text": "דענין היחידות הוא התקשרות היחידה של זה הנכנס ליחידות עם היחידה של האדמו\"ר שאליו נכנס47,"
        },
        {
          "s": 29,
          "text": "ואעפ\"כ,"
        },
        {
          "s": 30,
          "text": "גם בהיותו ביחידות הי' אצלו ההרגש שדורסים עליו."
        },
        {
          "s": 31,
          "text": "ולכן מביא בהמאמר פרטים הנ\"ל דהסיפור,"
        },
        {
          "s": 32,
          "text": "בכדי להדגיש שע\"י השכלה לבד,"
        },
        {
          "s": 33,
          "text": "בלי עבודה,"
        },
        {
          "s": 34,
          "text": "אפשר להיות התפשטות הישות גם במקדש מעט ואפילו כשנכנסים ליחידות,"
        },
        {
          "s": 35,
          "text": "דמזה מובן ההכרח בענין העבודה."
        },
        {
          "s": 36,
          "text": "ולאח\"ז אמר לו הצ\"צ פירוש הכתוב48"
        },
        {
          "s": 37,
          "text": "יעזוב רשע דרכו ואיש און מחשבותיו,"
        },
        {
          "s": 38,
          "text": "און"
        },
        {
          "s": 39,
          "text": "(בחולם)"
        },
        {
          "s": 40,
          "text": "הוא כח ועוז49,"
        },
        {
          "s": 41,
          "text": "ופירוש איש און הוא איש חזק בדעת עצמו."
        },
        {
          "s": 42,
          "text": "וזהו יעזוב רשע דרכו ואיש און מחשבותיו,"
        },
        {
          "s": 43,
          "text": "דכשם שיעזוב רשע דרכו הוא דבר שמוכרח,"
        },
        {
          "s": 44,
          "text": "דבלי תשובה א\"א לגשת אל הקודש,"
        },
        {
          "s": 45,
          "text": "כן מוכרח שהאיש און יעזוב את מחשבותיו"
        },
        {
          "s": 46,
          "text": "(המחשבות דישות)."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דמ\"ש מחשבותיו לשון רבים,"
        },
        {
          "s": 2,
          "text": "הוא,"
        },
        {
          "s": 3,
          "text": "כי בהמחשבה דישות ישנם כו\"כ דרגות,"
        },
        {
          "s": 4,
          "text": "ולכן נאמר יעזוב גו' מחשבותיו לשון רבים,"
        },
        {
          "s": 5,
          "text": "שצריך לעזוב את מחשבה שבדקות,"
        },
        {
          "s": 6,
          "text": "ואפילו שבדקות דדקות."
        },
        {
          "s": 7,
          "text": "ולהעיר,"
        },
        {
          "s": 8,
          "text": "ממאמר רז\"ל50"
        },
        {
          "s": 9,
          "text": "בענין רבב שעל בגד שחוצץ לענין טבילה,"
        },
        {
          "s": 10,
          "text": "של בנאין"
        },
        {
          "s": 11,
          "text": "[אלו תלמידי חכמים שעוסקים בבנינו של עולם]"
        },
        {
          "s": 12,
          "text": "מצד אחד ושל בּוּר משני צדדין."
        },
        {
          "s": 13,
          "text": "דמזה מובן גם בנוגע לרבב רוחני,"
        },
        {
          "s": 14,
          "text": "שבתלמיד חכם גם מחשבה שבדקות חוצצת,"
        },
        {
          "s": 15,
          "text": "ולכן הכרח שיעזוב מחשבותיו לשון רבים."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ומבואר בהמאמר51,"
        },
        {
          "s": 1,
          "text": "שהתחלת העבודה הוא הביטול."
        },
        {
          "s": 2,
          "text": "כי בכדי להתקרב לאלקות,"
        },
        {
          "s": 3,
          "text": "הן בבחינת קירוב מלמטה למעלה לעלות מדרגא לדרגא בתפלה והן בבחינת קירוב מלמעלה למטה בהשגת אלקות בנפשו בתורה,"
        },
        {
          "s": 4,
          "text": "הוא ע\"י ענוה ושפלות."
        },
        {
          "s": 5,
          "text": "ויש לומר,"
        },
        {
          "s": 6,
          "text": "דזה שמפרט בהמאמר שני האופנים דקירוב לאלקות,"
        },
        {
          "s": 7,
          "text": "הגם שבכדי לבאר לשון התרגום אלפין באורייתא דהוי' נוגע לכאורה רק הקירוב שע\"י תורה,"
        },
        {
          "s": 8,
          "text": "הוא בכדי לרמז שע\"י קדימת הביטול,"
        },
        {
          "s": 9,
          "text": "השלום דבניך,"
        },
        {
          "s": 10,
          "text": "ת\"ח העוסקים בתורה"
        },
        {
          "s": 11,
          "text": "(מלמעלה למטה),"
        },
        {
          "s": 12,
          "text": "הוא בשלימות,"
        },
        {
          "s": 13,
          "text": "שכולל גם מעלת השלום דתפלה"
        },
        {
          "s": 14,
          "text": "(מלמטה למעלה)52."
        }
      ]
    }
  ]
}