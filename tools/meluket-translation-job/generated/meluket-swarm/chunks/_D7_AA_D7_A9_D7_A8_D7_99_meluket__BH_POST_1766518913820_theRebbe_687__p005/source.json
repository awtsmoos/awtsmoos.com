{
  "globalIndex": 26,
  "owner": 26,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913820_theRebbe_687__p005",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913820_theRebbe_687__p005",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518913820_theRebbe_687",
  "title": "מאמר זה היום תחילת מעשיך תשמ\"א",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 1,
          "text": "דזה שבראש השנה הוא בנין המלכות,"
        },
        {
          "s": 2,
          "text": "שייך זה"
        },
        {
          "s": 3,
          "text": "(בעיקר)"
        },
        {
          "s": 4,
          "text": "לזה שראש השנה הוא זה היום,"
        },
        {
          "s": 5,
          "text": "המשכת עצמות אוא\"ס,"
        },
        {
          "s": 6,
          "text": "בחינת זה."
        },
        {
          "s": 7,
          "text": "[ויש לקשר זה גם עם הביאור"
        },
        {
          "s": 8,
          "text": "(כמו שמשמע בכ\"מ)"
        },
        {
          "s": 9,
          "text": "דהשייכות דראש השנה לבנין המלכות היא כי בראש השנה הוא חידוש מע\"ב."
        },
        {
          "s": 10,
          "text": "דהנה ידוע מה שמבואר בסידור"
        },
        {
          "s": 11,
          "text": "(בשער התקיעות ד\"ה להבין ענין תק\"ש ע\"פ כוונת הבעש\"ט ז\"ל88),"
        },
        {
          "s": 12,
          "text": "דזה שבראש השנה נעשה החידוש דכל סדר ההשתלשלות,"
        },
        {
          "s": 13,
          "text": "הוא"
        },
        {
          "s": 14,
          "text": "(בעיקר)"
        },
        {
          "s": 15,
          "text": "בפנימיות העולמות,"
        },
        {
          "s": 16,
          "text": "אלא שעי\"ז נעשה חידוש גם בחיצוניות העולמות,"
        },
        {
          "s": 17,
          "text": "שלא יהי' באופן דרפיון ידים."
        },
        {
          "s": 18,
          "text": "ועפ\"ז יש לקשר שני הביאורים בענין השייכות דבנין המלכות לראש השנה"
        },
        {
          "s": 19,
          "text": "(שבראש השנה הוא החידוש דמע\"ב ושבראש השנה הוא המשכת בחינת זה),"
        },
        {
          "s": 20,
          "text": "כי החידוש שבפנימיות העולמות שייך להמשכת בחינת זה]."
        },
        {
          "s": 21,
          "text": "וזהו שההדגשה בראש השנה היא על ענין המלוכה שבמלכות"
        },
        {
          "s": 22,
          "text": "(ולא על הדיבור דמלכות),"
        },
        {
          "s": 23,
          "text": "כי הענין דבנין המלכות"
        },
        {
          "s": 24,
          "text": "(המשכת המלכות משרשה)"
        },
        {
          "s": 25,
          "text": "שייך להמשכת עצמות אוא\"ס."
        },
        {
          "s": 26,
          "text": "דהגם שכל הספירות המשכתם היא מעצמות אוא\"ס כמ\"ש89"
        },
        {
          "s": 27,
          "text": "כי ממך הכל"
        },
        {
          "s": 28,
          "text": "[ומכ\"ש הדיבור דמלכות,"
        },
        {
          "s": 29,
          "text": "העשרה מאמרות שבהם נברא העולם מאין ליש,"
        },
        {
          "s": 30,
          "text": "וכידוע דבריאה יש מאין היא בכח העצמות,"
        },
        {
          "s": 31,
          "text": "דהוא לבדו בכחו ויכלתו לברוא יש מאין ואפס המוחלט90],"
        },
        {
          "s": 32,
          "text": "אעפ\"כ,"
        },
        {
          "s": 33,
          "text": "ענין ההמשכה דעצמות אוא\"ס"
        },
        {
          "s": 34,
          "text": "(בחינת זה),"
        },
        {
          "s": 35,
          "text": "שזהו הענין דראש השנה כנ\"ל,"
        },
        {
          "s": 36,
          "text": "שייך בעיקר לבנין המלכות דוקא."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ויובן זה ע\"פ המבואר בדרושי רבותינו נשיאינו בענין ההפרש שבין מדת המלכות לשאר המדות,"
        },
        {
          "s": 2,
          "text": "די\"ל דנקודת ביאורים אלו היא כמ\"ש כ\"ק מו\"ח אדמו\"ר בד\"ה שופר של ראש השנה91,"
        },
        {
          "s": 3,
          "text": "שמדת המלכות חלוקה מכל המדות בשרשה,"
        },
        {
          "s": 4,
          "text": "במהותה ובאופן"
        },
        {
          "s": 5,
          "text": "(במציאות)"
        },
        {
          "s": 6,
          "text": "מהותה,"
        },
        {
          "s": 7,
          "text": "בהתעוררותה ובאופן התעוררותה,"
        },
        {
          "s": 8,
          "text": "בהתגלותה ובאופן התגלותה."
        },
        {
          "s": 9,
          "text": "החילוק בשרשה הוא,"
        },
        {
          "s": 10,
          "text": "דכל המדות וספירות כלולים באריך אנפין ומדת המלכות מושרשת ברדל\"א92."
        },
        {
          "s": 11,
          "text": "החילוק במהותה ובמציאות"
        },
        {
          "s": 12,
          "text": "(אופן)"
        },
        {
          "s": 13,
          "text": "מהותה הוא,"
        },
        {
          "s": 14,
          "text": "שכל המדות וספירות,"
        },
        {
          "s": 15,
          "text": "גם כמו שהם בשרשם בבחי' אריך,"
        },
        {
          "s": 16,
          "text": "הם ט' נהורין29,"
        },
        {
          "s": 17,
          "text": "ומדת המלכות היא רק נקודה ובבחי' לא מציאות."
        },
        {
          "s": 18,
          "text": "החילוק בהתעוררותה ובאופן התעוררותה ובהתגלותה הוא,"
        },
        {
          "s": 19,
          "text": "דכל המדות והספירות מתעוררים גם מעצמם,"
        },
        {
          "s": 20,
          "text": "ולכן אופן התעוררותם הוא גם מדבר שאינו מערכם וכן התגלותם היא גם על מה שאינו מערכם כלל,"
        },
        {
          "s": 21,
          "text": "משא\"כ מדת המלכות התעוררותה היא רק ע\"י הזולת,"
        },
        {
          "s": 22,
          "text": "ולכן אופן התעוררותה הוא רק ממי שבערכה,"
        },
        {
          "s": 23,
          "text": "וגם התגלות המלכות הוא רק על מי שבערכה."
        },
        {
          "s": 24,
          "text": "והחילוק באופן התגלותה הוא,"
        },
        {
          "s": 25,
          "text": "שכל המדות ההשפעה"
        },
        {
          "s": 26,
          "text": "(והגילוי)"
        },
        {
          "s": 27,
          "text": "שלהם היא בקירוב"
        },
        {
          "s": 28,
          "text": "[וכמו ההשפעה דמדת החסד,"
        },
        {
          "s": 29,
          "text": "שהיא מצד הרגש הקירוב דהמשפיע להמקבל,"
        },
        {
          "s": 30,
          "text": "וכן הוא בההשפעה דכל המדות,"
        },
        {
          "s": 31,
          "text": "ואפילו בההשפעה דמדת הגבורה,"
        },
        {
          "s": 32,
          "text": "שהיא מצד הרגש השייכות והקירוב],"
        },
        {
          "s": 33,
          "text": "משא\"כ מדת המלכות ההשפעה"
        },
        {
          "s": 34,
          "text": "(והגילוי)"
        },
        {
          "s": 35,
          "text": "שלה היא בריחוק והבדלה,"
        },
        {
          "s": 36,
          "text": "רוממות והתנשאות."
        },
        {
          "s": 37,
          "text": "והנה הסיבה לכל חילוקים אלו שבין מדת המלכות לשאר המדות הוא החילוק שביניהם בשרשם."
        },
        {
          "s": 38,
          "text": "דלהיות93"
        },
        {
          "s": 39,
          "text": "ששרש המלכות הוא ברדל\"א,"
        },
        {
          "s": 40,
          "text": "דבחי' רדל\"א הוא לא רק רישא דלא אתיידע אלא גם רישא דלא ידע94,"
        },
        {
          "s": 41,
          "text": "שאינו במהות ידוע גם לעצמו,"
        },
        {
          "s": 42,
          "text": "לכן,"
        },
        {
          "s": 43,
          "text": "גם כמו שבאה בבחי' המשכה"
        },
        {
          "s": 44,
          "text": "(מהותה ומציאות מהותה)"
        },
        {
          "s": 45,
          "text": "היא בבחי' לא מציאות95,"
        },
        {
          "s": 46,
          "text": "ובכדי שתבוא בבחי' התעוררות,"
        },
        {
          "s": 47,
          "text": "הוא ע\"י הזולת דוקא."
        },
        {
          "s": 48,
          "text": "ולכן גם באופן התעוררותה ובהתגלותה צריך להיות זולת השייך,"
        },
        {
          "s": 49,
          "text": "שבערכה דוקא."
        },
        {
          "s": 50,
          "text": "והיינו,"
        },
        {
          "s": 51,
          "text": "דכל המדות,"
        },
        {
          "s": 52,
          "text": "מכיון שעצם המדה וגם התעוררותה היא מהאדם עצמו,"
        },
        {
          "s": 53,
          "text": "וכמו מדת החסד והרחמים ששייכים"
        },
        {
          "s": 54,
          "text": "(גם ההתעוררות שלהם)"
        },
        {
          "s": 55,
          "text": "גם בלי זולת,"
        },
        {
          "s": 56,
          "text": "לכן אינו מעכב בזה מה הוא הדבר שמתחסד עמו ומרחם עליו,"
        },
        {
          "s": 57,
          "text": "ושייכים גם על בעלי חיים96"
        },
        {
          "s": 58,
          "text": "אף שאינם בערך האדם."
        },
        {
          "s": 59,
          "text": "משא\"כ מדת המלכות,"
        },
        {
          "s": 60,
          "text": "מכיון שהיא באה מהזולת דוקא,"
        },
        {
          "s": 61,
          "text": "לכן צ\"ל שהזולת"
        },
        {
          "s": 62,
          "text": "(המעורר את מדת המלכות,"
        },
        {
          "s": 63,
          "text": "ושמדת המלכות מתגלית עליו)"
        },
        {
          "s": 64,
          "text": "יהי' בערכו דוקא,"
        },
        {
          "s": 65,
          "text": "דמלוכה שייכת רק על מין האדם ולא על בע\"ח,"
        },
        {
          "s": 66,
          "text": "וגם צ\"ל שהזולת יהי' נפרד דוקא,"
        },
        {
          "s": 67,
          "text": "אין מלך בלא עם97,"
        },
        {
          "s": 68,
          "text": "משא\"כ על בנים לא שייך ענין המלוכה."
        },
        {
          "s": 69,
          "text": "וענין זה שייך גם לאופן התגלות המלכות,"
        },
        {
          "s": 70,
          "text": "זה שההשפעה דמלכות היא בבחי' ריחוק דוקא98."
        },
        {
          "s": 71,
          "text": "וגם ענין זה"
        },
        {
          "s": 72,
          "text": "(זה שההשפעה דמלכות היא בבחי' ריחוק והבדלה,"
        },
        {
          "s": 73,
          "text": "רוממות והתנשאות)"
        },
        {
          "s": 74,
          "text": "שייך לזה ששרש המלכות הוא ברדל\"א,"
        },
        {
          "s": 75,
          "text": "כי ענין ההתנשאות על עם בא מצד ההתנשאות העצמית."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "וע\"פ הנ\"ל"
        },
        {
          "s": 3,
          "text": "(דענין המלוכה הוא דוקא על עם,"
        },
        {
          "s": 4,
          "text": "משא\"כ על בנים)"
        },
        {
          "s": 5,
          "text": "יובן,"
        },
        {
          "s": 6,
          "text": "דזה שישראל הם עמו ית' יש בזה יתרון על בנים אתם,"
        },
        {
          "s": 7,
          "text": "מכיון שעי\"ז דוקא"
        },
        {
          "s": 8,
          "text": "(שהם עמו)"
        },
        {
          "s": 9,
          "text": "הקב\"ה הוא מלך ישראל."
        },
        {
          "s": 10,
          "text": "והגם דזה שהוא מלך ישראל הוא מה שהוא מרומם ומנושא מהם"
        },
        {
          "s": 11,
          "text": "(לכאורה ריחוק והבדלה),"
        },
        {
          "s": 12,
          "text": "הרי ההתנשאות על עם קשורה"
        },
        {
          "s": 13,
          "text": "(כנ\"ל)"
        },
        {
          "s": 14,
          "text": "עם זה שהוא מרומם ומנושא בעצם."
        },
        {
          "s": 15,
          "text": "וזהו מ\"ש99"
        },
        {
          "s": 16,
          "text": "ואנחנו עמך וצאן מרעיתך,"
        },
        {
          "s": 17,
          "text": "ואיתא במדרש עה\"פ100"
        },
        {
          "s": 18,
          "text": "דודי לי ואני לו הרועה בשושנים,"
        },
        {
          "s": 19,
          "text": "הוא לי לאב ואני לו לבן הוא לי לרועה ואני לו לצאן,"
        },
        {
          "s": 20,
          "text": "דמזה שבתחלה אומר הוא לי לאב ואני לו לבן ואח\"כ מוסיף הוא לי לרועה ואני לו לצאן,"
        },
        {
          "s": 21,
          "text": "מובן,"
        },
        {
          "s": 22,
          "text": "דענין הוא לי לרועה כו' הוא למעלה יותר מענין הוא לי לאב וכו',"
        },
        {
          "s": 23,
          "text": "וכידוע101"
        },
        {
          "s": 24,
          "text": "דענין הוא לי לרועה ואני לו לצאן הוא בבחינת גם102"
        },
        {
          "s": 25,
          "text": "בן ואח אין לו."
        },
        {
          "s": 26,
          "text": "ומזה מובן גם בהתואר עמך"
        },
        {
          "s": 27,
          "text": "(שבהמשך אחד עם וצאן מרעיתך)"
        },
        {
          "s": 28,
          "text": "שהוא נעלה יותר מזה שישראל הם בניו ית'."
        },
        {
          "s": 29,
          "text": "דמכיון שאין מלך בלא עם,"
        },
        {
          "s": 30,
          "text": "הרי נמצא,"
        },
        {
          "s": 31,
          "text": "דזה שהקב\"ה הוא מלך ישראל103"
        },
        {
          "s": 32,
          "text": "הוא דוקא מצד זה שישראל הם עמו ית'."
        },
        {
          "s": 33,
          "text": "כי ענין הרוממות וההתנשאות הוא"
        },
        {
          "s": 34,
          "text": "(כנ\"ל)"
        },
        {
          "s": 35,
          "text": "מצד זה שהוא מרומם ומנושא בעצם."
        },
        {
          "s": 36,
          "text": "וזהו שעיקר ההדגשה בראש השנה"
        },
        {
          "s": 37,
          "text": "(ובהתפלות דראש השנה)"
        },
        {
          "s": 38,
          "text": "הוא בענין המלכות,"
        },
        {
          "s": 39,
          "text": "כי החידוש דראש השנה"
        },
        {
          "s": 40,
          "text": "(על כ\"ה באלול),"
        },
        {
          "s": 41,
          "text": "זה היום,"
        },
        {
          "s": 42,
          "text": "הוא"
        },
        {
          "s": 43,
          "text": "(כנ\"ל)"
        },
        {
          "s": 44,
          "text": "שנש\"י"
        },
        {
          "s": 45,
          "text": "[ששרשם הוא מבחי' צור,"
        },
        {
          "s": 46,
          "text": "העלם שאינו במציאות]"
        },
        {
          "s": 47,
          "text": "ממשיכים גילוי עצמות אוא\"ס,"
        },
        {
          "s": 48,
          "text": "ושרש המלכות הוא ברדל\"א"
        },
        {
          "s": 49,
          "text": "(בחי' העלם שאינו במציאות),"
        },
        {
          "s": 50,
          "text": "ולמעלה יותר בבחי' רוממות העצמות."
        }
      ]
    }
  ]
}