{
  "globalIndex": 670,
  "owner": 20,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917720_theRebbe_340__p004",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917720_theRebbe_340__p004",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917720_theRebbe_340",
  "title": "מאמר ויקרא אל משה תשל\"ב",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יש לבאר מ\"ש בתניא39,"
        },
        {
          "s": 2,
          "text": "לאחרי שאומר שצמצם הקב\"ה רצונו וחכמתו והורידם למטה,"
        },
        {
          "s": 3,
          "text": "שלכן נמשלה התורה למים40,"
        },
        {
          "s": 4,
          "text": "כי מה מים יורדים ממקום גבוה למקום נמוך כך התורה ירדה ממקום כבודה שהיא רצונו וחכמתו ית' דלית מחשבה תפיסא בי' כלל41,"
        },
        {
          "s": 5,
          "text": "ומשם נסעה וירדה עד שנתלבשה בדברים גשמיים ועניני עוה\"ז."
        },
        {
          "s": 6,
          "text": "דלכאורה צריך ביאור,"
        },
        {
          "s": 7,
          "text": "הרי זה שהתורה ירדה מלמעלה למטה מובן גם בלי המשל דמים,"
        },
        {
          "s": 8,
          "text": "ומה מיתוסף בהבנת הענין דירידת התורה מלמעלה למטה ע\"י המשל דמים."
        },
        {
          "s": 9,
          "text": "ויש לומר הכוונה בזה,"
        },
        {
          "s": 10,
          "text": "דכמו שמים,"
        },
        {
          "s": 11,
          "text": "זה שיורדים ממקום גבוה למקום נמוך הוא לפי שגם כשהיו במקום גבוה אין להם שייכות להמקום"
        },
        {
          "s": 12,
          "text": "(הגבוה)"
        },
        {
          "s": 13,
          "text": "שנמצאו שם,"
        },
        {
          "s": 14,
          "text": "ואדרבה זה שבטבעם הם נמשכים למקום נמוך דוקא מורה על שייכותן דהמים"
        },
        {
          "s": 15,
          "text": "(גם בהיותן במקום גבוה)"
        },
        {
          "s": 16,
          "text": "למקום הנמוך,"
        },
        {
          "s": 17,
          "text": "כמו\"כ הוא בתורה שנמשלה למים,"
        },
        {
          "s": 18,
          "text": "דזה שירדה מלמעלה למטה אין זה שמקומה הוא למעלה42"
        },
        {
          "s": 19,
          "text": "ובירידתה למטה היא נמצאת שלא במקומה,"
        },
        {
          "s": 20,
          "text": "כי אם,"
        },
        {
          "s": 21,
          "text": "שמקומה האמיתי"
        },
        {
          "s": 22,
          "text": "(גם בהיותה למעלה)"
        },
        {
          "s": 23,
          "text": "הוא למטה."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ויש להוסיף,"
        },
        {
          "s": 1,
          "text": "דזהו מה שאומר בתניא שם בסוף הפרק43,"
        },
        {
          "s": 2,
          "text": "דמ\"ש44"
        },
        {
          "s": 3,
          "text": "וימינו תחבקני קאי על התורה שהיא בחינת חסד ומים,"
        },
        {
          "s": 4,
          "text": "שמדייק חסד ומים"
        },
        {
          "s": 5,
          "text": "(אף שבכדי לבאר הטעם על זה שהתורה נק' ימינו הי' די לכאורה לומר שהיא בחינת חסד),"
        },
        {
          "s": 6,
          "text": "הוא,"
        },
        {
          "s": 7,
          "text": "כי ההמשכה מלמעלה למטה שבחסד היא באופן שהמעלה תופס מקום."
        },
        {
          "s": 8,
          "text": "וכמו ההשפעה של איש החסד,"
        },
        {
          "s": 9,
          "text": "דבזה שהוא משפיע לזולתו"
        },
        {
          "s": 10,
          "text": "(המשכה למטה)"
        },
        {
          "s": 11,
          "text": "נרגש החסד דהמשפיע."
        },
        {
          "s": 12,
          "text": "משא\"כ ההמשכה שמלמעלה למטה דמים היא באופן שהם מניחין מקום גבוה והולכין"
        },
        {
          "s": 13,
          "text": "(דוקא)"
        },
        {
          "s": 14,
          "text": "למקום נמוך45."
        },
        {
          "s": 15,
          "text": "וזהו שמוסיף שהתורה היא בחינת"
        },
        {
          "s": 16,
          "text": "(חסד ו)"
        },
        {
          "s": 17,
          "text": "מים,"
        },
        {
          "s": 18,
          "text": "דזה שהתורה ירדה מלמעלה למטה הוא בדוגמת ירידת המים46"
        },
        {
          "s": 19,
          "text": "שמניחין מקום גבוה,"
        },
        {
          "s": 20,
          "text": "שעיקר התורה הוא דוקא למטה."
        },
        {
          "s": 21,
          "text": "וכמבואר במ\"א47"
        },
        {
          "s": 22,
          "text": "דזה שהתורה היא בכל מקום,"
        },
        {
          "s": 23,
          "text": "למעלה ולמטה48,"
        },
        {
          "s": 24,
          "text": "היא התורה כמו שהיא בבחינת הגילויים,"
        },
        {
          "s": 25,
          "text": "והתורה כמו שמושרשת בהעצמות ניתנה למטה דוקא."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וזהו זאת התורה אדם,"
        },
        {
          "s": 2,
          "text": "שהתורה נמשלה לאדם,"
        },
        {
          "s": 3,
          "text": "כי באדם שני ענינים."
        },
        {
          "s": 4,
          "text": "זה שנקרא אדם על שם אדמה לעליון49,"
        },
        {
          "s": 5,
          "text": "וזה שנקרא אדם על שם שנוצר מן האדמה,"
        },
        {
          "s": 6,
          "text": "כדאיתא במדרש50"
        },
        {
          "s": 7,
          "text": "שאמר אדה\"ר אני נאה להקרא אדם שנבראתי מן האדמה."
        },
        {
          "s": 8,
          "text": "ומבואר בחסידות51,"
        },
        {
          "s": 9,
          "text": "דזה שקרא אדה\"ר שמו על שם החומר"
        },
        {
          "s": 10,
          "text": "(גוף)"
        },
        {
          "s": 11,
          "text": "ולא על שם הצורה"
        },
        {
          "s": 12,
          "text": "(נפש),"
        },
        {
          "s": 13,
          "text": "כי אדה\"ר בחכמתו השיג דזה שגופו נוצר מן האדמה"
        },
        {
          "s": 14,
          "text": "[דומם,"
        },
        {
          "s": 15,
          "text": "ולא כשאר הנבראים שגופם הי' צומח52],"
        },
        {
          "s": 16,
          "text": "יש בזה יתרון גם לגבי מעלת נשמתו,"
        },
        {
          "s": 17,
          "text": "כי כל53"
        },
        {
          "s": 18,
          "text": "הגבוה גבוה יותר נופל למטה מטה יותר."
        },
        {
          "s": 19,
          "text": "וזהו זאת התורה אדם,"
        },
        {
          "s": 20,
          "text": "כי גם בתורה דוגמת שני ענינים אלה."
        },
        {
          "s": 21,
          "text": "דזה שהתורה היא למעלה מהעולם,"
        },
        {
          "s": 22,
          "text": "ועד שכל העולמות הם לא חשיב לגבה,"
        },
        {
          "s": 23,
          "text": "הוא ע\"ד שם אדם על שם אדמה לעליון,"
        },
        {
          "s": 24,
          "text": "וזה שהתורה ירדה למטה דוקא מצד זה ששרשה הוא בהעצמות,"
        },
        {
          "s": 25,
          "text": "הוא ע\"ד שם אדם על שם שנוצר מן האדמה מצד זה ששרשו הוא בהגבוה גבוה יותר."
        }
      ]
    }
  ]
}