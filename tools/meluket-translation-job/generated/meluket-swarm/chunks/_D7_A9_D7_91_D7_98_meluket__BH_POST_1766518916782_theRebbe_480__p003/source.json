{
  "globalIndex": 513,
  "owner": 13,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916782_theRebbe_480__p003",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916782_theRebbe_480__p003",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916782_theRebbe_480",
  "title": "מאמר באתי לגני תשכ\"ט",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "והנה מבואר בלקו\"ת שם39,"
        },
        {
          "s": 1,
          "text": "דע\"י שהתשובה מגעת לבחינת פניך הוי'"
        },
        {
          "s": 2,
          "text": "(בחינת הפנים שלמעלה מהוי'),"
        },
        {
          "s": 3,
          "text": "נמשך משם להיות גילוי בחינת הוי'"
        },
        {
          "s": 4,
          "text": "[שבכדי להמשיך שם הוי' מחדש,"
        },
        {
          "s": 5,
          "text": "לאחרי שפגם בהוי',"
        },
        {
          "s": 6,
          "text": "צ\"ל ההמשכה מבחינת הפנים שלמעלה מהוי'40]."
        },
        {
          "s": 7,
          "text": "ומבואר שם,"
        },
        {
          "s": 8,
          "text": "דמ\"ש ופני לא יראו הוא שהפנים בעצמן אין באים לידי גילוי,"
        },
        {
          "s": 9,
          "text": "אבל הגילוי נמשך משם."
        },
        {
          "s": 10,
          "text": "ועפ\"ז הי' אפשר לומר לכאורה בנוגע לעניננו,"
        },
        {
          "s": 11,
          "text": "דמ\"ש בהמאמר \"דהתגלות והמשכת אוצר העליון הוא במדת הנצח\","
        },
        {
          "s": 12,
          "text": "הכוונה בזה היא שבמדת הנצח נמשך גילוי מאוצר העליון,"
        },
        {
          "s": 13,
          "text": "דגילוי זה הוא נתינת כח לנצח את המלחמה."
        },
        {
          "s": 14,
          "text": "אמנם,"
        },
        {
          "s": 15,
          "text": "מלשון המאמר41"
        },
        {
          "s": 16,
          "text": "\"וכל הון יקר שבהאוצרות ניתן לאנשי החיל\" משמע שנותנים להם את האוצרות עצמם"
        },
        {
          "s": 17,
          "text": "(וכל הון יקר שבהם),"
        },
        {
          "s": 18,
          "text": "ולא רק גילוי מהאוצרות."
        },
        {
          "s": 19,
          "text": "וכן מובן גם ממ\"ש בהמאמר42"
        },
        {
          "s": 20,
          "text": "שבשביל הנצחון מבזבזים כל האוצרות."
        },
        {
          "s": 21,
          "text": "דמכיון שבזבוז הוא למעלה מכל מדידה והגבלה,"
        },
        {
          "s": 22,
          "text": "א\"א לומר שישנה הגבלה בההמשכה,"
        },
        {
          "s": 23,
          "text": "ובהכרח לומר שבמדת הנצחון נמשך ומתגלה"
        },
        {
          "s": 24,
          "text": "(גם)"
        },
        {
          "s": 25,
          "text": "האוצר עצמו."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ולכאורה הי' אפשר לומר,"
        },
        {
          "s": 2,
          "text": "דזה שבמדת הנצח מתגלה ונמשך אוצר העליון הוא ע\"ד הידוע43"
        },
        {
          "s": 3,
          "text": "בענין אתערותא דלעילא שאין אתערותא דלתתא מגעת לשם ובאה בדרך מתנה מלמעלה,"
        },
        {
          "s": 4,
          "text": "שאינה שורה ומתגלה אלא לאחרי האתעדל\"ת והאתעדל\"ע שמתעוררת ונמשכת ע\"י האתעדל\"ת."
        },
        {
          "s": 5,
          "text": "דהגם שאתעדל\"ע זו באה במתנה מלמעלה,"
        },
        {
          "s": 6,
          "text": "מ\"מ,"
        },
        {
          "s": 7,
          "text": "צ\"ל איזה כלי לזה,"
        },
        {
          "s": 8,
          "text": "דקוב\"ה לא שריא אלא באתר שלים44,"
        },
        {
          "s": 9,
          "text": "ולכן,"
        },
        {
          "s": 10,
          "text": "בכדי שיהי' הגילוי של אתעדל\"ע זו"
        },
        {
          "s": 11,
          "text": "(הבאה בדרך מתנה)"
        },
        {
          "s": 12,
          "text": "צ\"ל השלימות דמעשה התחתונים"
        },
        {
          "s": 13,
          "text": "[אתעדל\"ת ואתעדל\"ע שמתעוררת ונמשכת על ידה]."
        },
        {
          "s": 14,
          "text": "ועפ\"ז הי' אפשר לומר,"
        },
        {
          "s": 15,
          "text": "דמ\"ש בהמאמר שהתגלות והמשכת אוצר העליון הוא מדת הנצח,"
        },
        {
          "s": 16,
          "text": "הוא,"
        },
        {
          "s": 17,
          "text": "שהנצח הוא דוגמת השלימות"
        },
        {
          "s": 18,
          "text": "(אתר שלים)"
        },
        {
          "s": 19,
          "text": "שבו הוא המשכת וגילוי האוצר."
        },
        {
          "s": 20,
          "text": "אבל ממ\"ש בהמאמר ש\"במדת הנצח יכולים להגיע לאוצר העליון פירוש דהתגלות והמשכת אוצר העליון הוא במדת הנצח\","
        },
        {
          "s": 21,
          "text": "מוכח,"
        },
        {
          "s": 22,
          "text": "דזה שבמדת הנצח מתגלה ונמשך אוצר העליון הוא"
        },
        {
          "s": 23,
          "text": "(לא מפני שהנצח הוא כמו אתר שלים,"
        },
        {
          "s": 24,
          "text": "אלא)"
        },
        {
          "s": 25,
          "text": "מצד זה שהנצח מגיע באוצר העליון45."
        },
        {
          "s": 26,
          "text": "וצריך להבין,"
        },
        {
          "s": 27,
          "text": "והרי אוצר העליון הוא למעלה מגדר גילוי,"
        },
        {
          "s": 28,
          "text": "והיאך שייך שע\"י מדת הנצח יגיעו להאוצר באופן שעי\"ז יבוא האוצר עצמו בהמשכה וגילוי."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ויש לומר הביאור בזה בהקדים מ\"ש אדמו\"ר הזקן בתו\"א ד\"ה פתח אליהו46,"
        },
        {
          "s": 2,
          "text": "שהצמצום הי' רק בהאור ולא בהמאור."
        },
        {
          "s": 3,
          "text": "ומ\"ש בכתבי האריז\"ל47"
        },
        {
          "s": 4,
          "text": "שע\"י הצמצום נעשה חלל ומקום פנוי לעמידת העולמות,"
        },
        {
          "s": 5,
          "text": "הכוונה בזה היא שהוא חלל וריק מן האור שלא נשאר בו אור וגילוי,"
        },
        {
          "s": 6,
          "text": "שבכדי שיוכל להיות התהוות העולמות,"
        },
        {
          "s": 7,
          "text": "גם עולמות הכי עליונים,"
        },
        {
          "s": 8,
          "text": "עלה ברצונו ית' שהמקום שבו יהי' עמידת העולמות יהי' פנוי מן האור,"
        },
        {
          "s": 9,
          "text": "אבל המאור נמצא בכל מקום."
        },
        {
          "s": 10,
          "text": "ומוסיף בתו\"א,"
        },
        {
          "s": 11,
          "text": "שבהמאור לא שייך צמצום ח\"ו."
        },
        {
          "s": 12,
          "text": "היינו,"
        },
        {
          "s": 13,
          "text": "דלא רק שלא הי' בו צמצום בפועל,"
        },
        {
          "s": 14,
          "text": "אלא יתירה מזו שאין שייך בו צמצום."
        },
        {
          "s": 15,
          "text": "ואדרבא המאור הוא בהתגלות."
        },
        {
          "s": 16,
          "text": "דלא רק שע\"י הצמצום לא נעשה העלם בהמאור"
        },
        {
          "s": 17,
          "text": "[מכיון שהצמצום הי' רק בהאור ולא בהמאור,"
        },
        {
          "s": 18,
          "text": "כנ\"ל],"
        },
        {
          "s": 19,
          "text": "אלא אדרבא,"
        },
        {
          "s": 20,
          "text": "ע\"י הצמצום הוא התגלות המאור48."
        },
        {
          "s": 21,
          "text": "וממשיך שם,"
        },
        {
          "s": 22,
          "text": "דזהו הטעם שאפילו תינוקות יודעים שיש שם אלוקה מצוי"
        },
        {
          "s": 23,
          "text": "[או כהלשון המובא במק\"א49,"
        },
        {
          "s": 24,
          "text": "ששם שמים שגור בפי כל],"
        },
        {
          "s": 25,
          "text": "כי המאור הוא בהתגלות למטה כמו למעלה"
        },
        {
          "s": 26,
          "text": "(ואדרבא,"
        },
        {
          "s": 27,
          "text": "עיקר התגלותו הוא למטה48)."
        }
      ]
    }
  ]
}