{
  "globalIndex": 435,
  "owner": 35,
  "jobId": "_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916230_theRebbe_919__p002",
  "batchId": "meluket-_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916230_theRebbe_919__p002",
  "seriesId": "טבת_meluket",
  "postId": "BH_POST_1766518916230_theRebbe_919",
  "title": "מאמר הבאים ישרש יעקב תשמ\"ח",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "והנה ע\"פ הידוע הדיוק במאמרי רבותינו נשיאינו גם בסדר הענינים10,"
        },
        {
          "s": 1,
          "text": "צריך להבין,"
        },
        {
          "s": 2,
          "text": "הרי הגילוי דשרש הנשמה שיהי' לעתיד בא לאחרי וע\"י קיום המצוות עכשיו,"
        },
        {
          "s": 3,
          "text": "והסדר דשני הענינים"
        },
        {
          "s": 4,
          "text": "(פירושים)"
        },
        {
          "s": 5,
          "text": "בהמאמר הוא,"
        },
        {
          "s": 6,
          "text": "שבתחלה בא הפירוש שישרש יעקב הוא גילוי שרש הנשמה שיהי' לעתיד,"
        },
        {
          "s": 7,
          "text": "ולאח\"ז בא הפירוש שישרש יעקב קאי על קיום המצוות עכשיו."
        },
        {
          "s": 8,
          "text": "גם צריך להבין,"
        },
        {
          "s": 9,
          "text": "שבפירוש הראשון"
        },
        {
          "s": 10,
          "text": "(שישרש יעקב קאי על הגאולה)"
        },
        {
          "s": 11,
          "text": "מפרש"
        },
        {
          "s": 12,
          "text": "(גם)"
        },
        {
          "s": 13,
          "text": "תיבת הבאים,"
        },
        {
          "s": 14,
          "text": "ובפירוש השני"
        },
        {
          "s": 15,
          "text": "(שישרש יעקב קאי על קיום המצוות עכשיו)"
        },
        {
          "s": 16,
          "text": "אין פי' תיבת הבאים."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה בהפירוש שישרש יעקב קאי על קיום המצוות,"
        },
        {
          "s": 2,
          "text": "שני אופנים11."
        },
        {
          "s": 3,
          "text": "שההשרשה דיעקב היא בקיום המצוות"
        },
        {
          "s": 4,
          "text": "(כנ\"ל),"
        },
        {
          "s": 5,
          "text": "ושההשרשה דמצוות היא ביעקב."
        },
        {
          "s": 6,
          "text": "כמ\"ש אדמו\"ר הזקן"
        },
        {
          "s": 7,
          "text": "(בעל ההילולא דכ\"ד טבת)"
        },
        {
          "s": 8,
          "text": "בתו\"א ד\"ה זה12,"
        },
        {
          "s": 9,
          "text": "דכמו שהזריעה כפשוטה צריכה להיות בארץ דוקא,"
        },
        {
          "s": 10,
          "text": "כמו\"כ הוא בהזריעה דמצוות"
        },
        {
          "s": 11,
          "text": "(אור13"
        },
        {
          "s": 12,
          "text": "זרוע לצדיק14),"
        },
        {
          "s": 13,
          "text": "שצריכה להיות בישראל דוקא דכתיב בהו15"
        },
        {
          "s": 14,
          "text": "כי תהיו אתם"
        },
        {
          "s": 15,
          "text": "[לי16]"
        },
        {
          "s": 16,
          "text": "ארץ חפץ."
        },
        {
          "s": 17,
          "text": "וזהו ישרש יעקב יציץ ופרח גו',"
        },
        {
          "s": 18,
          "text": "דישרש יעקב קאי על קיום המצוות עכשיו,"
        },
        {
          "s": 19,
          "text": "שהמצוות נזרעים ונשרשים ביעקב,"
        },
        {
          "s": 20,
          "text": "ועי\"ז יהי' לע\"ל הצמיחה,"
        },
        {
          "s": 21,
          "text": "יציץ ופרח."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ומבאר בתו\"א שם17,"
        },
        {
          "s": 1,
          "text": "דפירוש הבאים ישרש יעקב הוא,"
        },
        {
          "s": 2,
          "text": "שבכדי שיהי' ישרש יעקב,"
        },
        {
          "s": 3,
          "text": "ההשרשה דתומ\"צ בישראל,"
        },
        {
          "s": 4,
          "text": "הוא ע\"י הבאים,"
        },
        {
          "s": 5,
          "text": "הביאה למצרים,"
        },
        {
          "s": 6,
          "text": "וכידוע18"
        },
        {
          "s": 7,
          "text": "שגלות מצרים הי' הכנה לקבלת התורה."
        },
        {
          "s": 8,
          "text": "וממשיך שם18,"
        },
        {
          "s": 9,
          "text": "דכמו שגלות מצרים היתה הכנה לקבלת התורה,"
        },
        {
          "s": 10,
          "text": "עד\"ז גלות זה האחרון הוא הכנה לקבל פנימיות התורה שיתגלה לעתיד."
        },
        {
          "s": 11,
          "text": "ויש לומר,"
        },
        {
          "s": 12,
          "text": "דזה שמוסיף בתו\"א שם ענין זה"
        },
        {
          "s": 13,
          "text": "(שהגלות האחרון הוא הכנה לקבל פנימיות התורה שיתגלה לע\"ל),"
        },
        {
          "s": 14,
          "text": "הוא,"
        },
        {
          "s": 15,
          "text": "כי עפ\"ז יומתק השייכות דהבאים לישרש יעקב,"
        },
        {
          "s": 16,
          "text": "דמשמעות הכתוב הוא שההשרשה היא בהגלות עצמו19."
        },
        {
          "s": 17,
          "text": "דבנוגע לגלות מצרים,"
        },
        {
          "s": 18,
          "text": "הבאים הוא רק הקדמה לישרש יעקב."
        },
        {
          "s": 19,
          "text": "שע\"י גלות מצרים,"
        },
        {
          "s": 20,
          "text": "כור הברזל20,"
        },
        {
          "s": 21,
          "text": "נצרפו ישראל להיות בחינת ארץ חפץ21,"
        },
        {
          "s": 22,
          "text": "ועי\"ז קיום התומ\"צ שלהם שלאחרי היציאה ממצרים ולאחרי קבלת התורה היא באופן דישרש יעקב."
        },
        {
          "s": 23,
          "text": "ולכן מוסיף שגלות האחרון הוא הכנה להגילוי דלע\"ל,"
        },
        {
          "s": 24,
          "text": "שעפ\"ז,"
        },
        {
          "s": 25,
          "text": "הבאים קאי גם על הגלויות שלאחרי גלות מצרים22"
        },
        {
          "s": 26,
          "text": "ועד לגלות זה האחרון,"
        },
        {
          "s": 27,
          "text": "דלפי פירוש זה,"
        },
        {
          "s": 28,
          "text": "הבאים וישרש יעקב הם ענין אחד."
        },
        {
          "s": 29,
          "text": "שההשרשה דמצוות בישראל"
        },
        {
          "s": 30,
          "text": "(שעי\"ז תהי' הצמיחה לע\"ל)"
        },
        {
          "s": 31,
          "text": "היא בעיקר בהמצוות שישראל מקיימים בזמן הגלות."
        },
        {
          "s": 32,
          "text": "כמ\"ש בתניא23,"
        },
        {
          "s": 33,
          "text": "שכל הגילויים דלע\"ל תלויים במעשינו ועבודתינו בזמן משך הגלות."
        }
      ]
    }
  ]
}