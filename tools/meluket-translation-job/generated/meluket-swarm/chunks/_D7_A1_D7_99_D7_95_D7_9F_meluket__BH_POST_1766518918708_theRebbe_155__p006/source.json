{
  "globalIndex": 830,
  "owner": 30,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918708_theRebbe_155__p006",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918708_theRebbe_155__p006",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918708_theRebbe_155",
  "title": "מאמר בשעה שעלה משה למרום תשכ\"ה",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "והנה מבואר לעיל"
        },
        {
          "s": 2,
          "text": "(סעיף ד-ה)"
        },
        {
          "s": 3,
          "text": "בפירוש הכתוב כמים הפנים לפנים,"
        },
        {
          "s": 4,
          "text": "דכמו שבמים כפשוטם,"
        },
        {
          "s": 5,
          "text": "ע\"י ההסתכלות בהם,"
        },
        {
          "s": 6,
          "text": "נראית בהם דמות הפנים שמסתכלת בהם,"
        },
        {
          "s": 7,
          "text": "עד\"ז הוא במים העליונים,"
        },
        {
          "s": 8,
          "text": "פשיטות דאוא\"ס,"
        },
        {
          "s": 9,
          "text": "שע\"י העלאת מ\"ן דהספירות"
        },
        {
          "s": 10,
          "text": "(פנים)"
        },
        {
          "s": 11,
          "text": "לאוא\"ס,"
        },
        {
          "s": 12,
          "text": "נעשה בו ענין הספירות – ע\"ס הגנוזות."
        },
        {
          "s": 13,
          "text": "וזה שע\"י העלאת מ\"ן נעשה ספירות באוא\"ס הוא מפני שגם לפנ\"ז יש לו שייכות לספירות"
        },
        {
          "s": 14,
          "text": "[בדוגמת מים,"
        },
        {
          "s": 15,
          "text": "דזה שנראית בהם דמות הפנים שמסתכלת בהם הוא לפי שהמים והפנים הם באותו סוג המציאות],"
        },
        {
          "s": 16,
          "text": "וצריך ביאור,"
        },
        {
          "s": 17,
          "text": "דכיון שגם ע\"ס הגנוזות"
        },
        {
          "s": 18,
          "text": "(הפנים הנראים בהמים)"
        },
        {
          "s": 19,
          "text": "הם רק יכולת לספירות"
        },
        {
          "s": 20,
          "text": "(כנ\"ל סעיף ז),"
        },
        {
          "s": 21,
          "text": "ולאידך,"
        },
        {
          "s": 22,
          "text": "גם האוא\"ס שלמעלה מע\"ס הגנוזות"
        },
        {
          "s": 23,
          "text": "(המים שבהם נראים הפנים)"
        },
        {
          "s": 24,
          "text": "יש לו שייכות לספירות,"
        },
        {
          "s": 25,
          "text": "מהו החילוק שבין שני הענינים."
        },
        {
          "s": 26,
          "text": "וי\"ל הביאור בזה,"
        },
        {
          "s": 27,
          "text": "דענין היכולת על איזה דבר הוא – שהדבר יכול להיות."
        },
        {
          "s": 28,
          "text": "דהגם שיכולת אינו מקור להדבר וענינו הוא זה שהעצם הוא יכול"
        },
        {
          "s": 29,
          "text": "[כידוע החילוק בין כח ליכולת56],"
        },
        {
          "s": 30,
          "text": "מ\"מ,"
        },
        {
          "s": 31,
          "text": "זה שהעצם הוא יכול,"
        },
        {
          "s": 32,
          "text": "הוא – שביכולת העצם הוא שיהי' כך וכך."
        },
        {
          "s": 33,
          "text": "והשייכות דאוא\"ס לספירות"
        },
        {
          "s": 34,
          "text": "(דמים לפנים)"
        },
        {
          "s": 35,
          "text": "הוא"
        },
        {
          "s": 36,
          "text": "(לא שמצד האוא\"ס יכול להיות ספירות,"
        },
        {
          "s": 37,
          "text": "אלא אדרבה)"
        },
        {
          "s": 38,
          "text": "שציור הספירות יכול להיות באוא\"ס."
        },
        {
          "s": 39,
          "text": "והגם שגם ענין זה הוא ירידה לגבי אוא\"ס כמו שהוא מצד עצמו,"
        },
        {
          "s": 40,
          "text": "דבאוא\"ס מצד עצמו אין יחס כלל לענין הספירות"
        },
        {
          "s": 41,
          "text": "[וכנ\"ל סעיף ה שהוא ע\"ד סברא שכלית שאין לה שום שייכות עם גוונים,"
        },
        {
          "s": 42,
          "text": "לובן ואודם],"
        },
        {
          "s": 43,
          "text": "אלא שלאחרי שעלה ברצונו שיהי' תפיסת מקום להעלאת מ\"ן דהספירות עי\"ז נעשה לו שייכות להספירות"
        },
        {
          "s": 44,
          "text": "(כנ\"ל),"
        },
        {
          "s": 45,
          "text": "מ\"מ,"
        },
        {
          "s": 46,
          "text": "התפיסת מקום דהעלאת מ\"ן דהספירות הוא שהמ\"ן שלהם יתפוס מקום אצלו,"
        },
        {
          "s": 47,
          "text": "שעל ידי ההעלאה תהי' המשכת אוא\"ס,"
        },
        {
          "s": 48,
          "text": "ולכן,"
        },
        {
          "s": 49,
          "text": "השייכות דאוא\"ס לספירות שנעשית ע\"י שהעלאת מ\"ן דהספירות תופסת מקום אצלו,"
        },
        {
          "s": 50,
          "text": "היא זה שבאוא\"ס אפשר להיות ציור הספירות."
        },
        {
          "s": 51,
          "text": "ולכן,"
        },
        {
          "s": 52,
          "text": "היכולת לספירות,"
        },
        {
          "s": 53,
          "text": "כיון שענינה היא שיכול להיות ספירות,"
        },
        {
          "s": 54,
          "text": "נקרא בשם ספירות,"
        },
        {
          "s": 55,
          "text": "עשר ספירות הגנוזות,"
        },
        {
          "s": 56,
          "text": "ונאמר בזה לשון האצלה"
        },
        {
          "s": 57,
          "text": "[וכמובא לעיל סעיף ז מהדרושים האציל עשרה שמות],"
        },
        {
          "s": 58,
          "text": "ויתירה מזה,"
        },
        {
          "s": 59,
          "text": "דזה שנעשה באוא\"ס היכולת לספירות הוא לא מצד האוא\"ס אלא ע\"י העלאת מ\"ן דהספירות."
        },
        {
          "s": 60,
          "text": "והירידה כביכול באוא\"ס שיהי' באופן שע\"י העלאת מ\"ן נראים בו הפנים דהספירות,"
        },
        {
          "s": 61,
          "text": "אין זה שנאצל בו איזה ענין,"
        },
        {
          "s": 62,
          "text": "אלא הוא האוא\"ס עצמו,"
        },
        {
          "s": 63,
          "text": "דוגמת המים שהם באופן כזה שנראית בהם הפנים המסתכלת בהם."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "והנה מבואר בהדרושים57,"
        },
        {
          "s": 2,
          "text": "שהפנים הנראים בהמים,"
        },
        {
          "s": 3,
          "text": "מכיון שהם מצד הפנים המסתכלים ולא מצד המים,"
        },
        {
          "s": 4,
          "text": "לכן הם לא דבר נבדל מהמים אלא המים עצמם."
        },
        {
          "s": 5,
          "text": "דבאם הפנים הנראים היו נמשכים מהמים,"
        },
        {
          "s": 6,
          "text": "אזי היו דבר מובדל שנתהווה מהמים"
        },
        {
          "s": 7,
          "text": "(וע\"ד דגים שבים)."
        },
        {
          "s": 8,
          "text": "אבל כיון שהפנים הנראים הם לא מצד המים,"
        },
        {
          "s": 9,
          "text": "אינם דבר נבדל שנתהווה מהמים אלא המים עצמם."
        },
        {
          "s": 10,
          "text": "– ועד\"ז הוא בהנמשל,"
        },
        {
          "s": 11,
          "text": "דכיון דזה שבאוא\"ס ישנם עשר ספירות הגנוזות הוא ע\"י העלאת מ\"ן דהספירות"
        },
        {
          "s": 12,
          "text": "(ולא שנתהוו מאוא\"ס),"
        },
        {
          "s": 13,
          "text": "לכן אינם דבר נבדל מאוא\"ס אלא הוא אוא\"ס עצמו."
        },
        {
          "s": 14,
          "text": "ועפ\"ז,"
        },
        {
          "s": 15,
          "text": "בע\"ס הגנוזות שני ענינים."
        },
        {
          "s": 16,
          "text": "דבחיצוניות,"
        },
        {
          "s": 17,
          "text": "ענינם הוא – יכולת לספירות,"
        },
        {
          "s": 18,
          "text": "ובפנימיות,"
        },
        {
          "s": 19,
          "text": "הם – אוא\"ס."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "והנה מבואר לעיל סעיף ד' דבמים הפנים לפנים,"
        },
        {
          "s": 1,
          "text": "שני ענינים."
        },
        {
          "s": 2,
          "text": "שדמות הפנים המסתכלת בהמים נראית בהמים,"
        },
        {
          "s": 3,
          "text": "ושדמות זו נראית אח\"כ להאדם המסתכל בהם."
        },
        {
          "s": 4,
          "text": "היינו,"
        },
        {
          "s": 5,
          "text": "שהדמות הנראית להאדם היא הדמות הנראית בהמים."
        },
        {
          "s": 6,
          "text": "ועד\"ז הוא בהנמשל,"
        },
        {
          "s": 7,
          "text": "שע\"י העלאת מ\"ן דפנים התחתונים,"
        },
        {
          "s": 8,
          "text": "ע\"ס דאצילות,"
        },
        {
          "s": 9,
          "text": "נעשים פנים"
        },
        {
          "s": 10,
          "text": "(ע\"ס הגנוזות)"
        },
        {
          "s": 11,
          "text": "בהמים"
        },
        {
          "s": 12,
          "text": "(פשיטות דאוא\"ס),"
        },
        {
          "s": 13,
          "text": "ואח\"כ נמשכים ומתגלים הפנים העליונים שבהמים"
        },
        {
          "s": 14,
          "text": "(ע\"ס הגנוזות)"
        },
        {
          "s": 15,
          "text": "מלמעלה למטה ומזה נעשים פנים התחתונים,"
        },
        {
          "s": 16,
          "text": "ע\"ס דאצילות."
        },
        {
          "s": 17,
          "text": "היינו שענינם דע\"ס הגלויות"
        },
        {
          "s": 18,
          "text": "(בפנימיות)"
        },
        {
          "s": 19,
          "text": "הוא – הגילוי דע\"ס הגנוזות,"
        },
        {
          "s": 20,
          "text": "בדוגמת דמות הפנים הנראית לאדם המסתכל בהמים שהיא הדמות הנראית בהמים"
        },
        {
          "s": 21,
          "text": "(ע\"ס הגנוזות)."
        },
        {
          "s": 22,
          "text": "וע\"פ הנ\"ל שהדמות הנראית בהמים היא המים עצמם,"
        },
        {
          "s": 23,
          "text": "מובן,"
        },
        {
          "s": 24,
          "text": "שגם הפנים התחתונים"
        },
        {
          "s": 25,
          "text": "(ע\"ס דאצילות),"
        },
        {
          "s": 26,
          "text": "שהם הגילוי דפנים העליונים,"
        },
        {
          "s": 27,
          "text": "ענינם הפנימי הוא – מים,"
        },
        {
          "s": 28,
          "text": "פשיטות דאוא\"ס."
        },
        {
          "s": 29,
          "text": "ועפ\"ז יובן מ\"ש כמים הפנים לפנים כן לב האדם לאדם,"
        },
        {
          "s": 30,
          "text": "דכמו שבמים"
        },
        {
          "s": 31,
          "text": "(פשיטות דאוא\"ס),"
        },
        {
          "s": 32,
          "text": "ע\"י העלאת מ\"ן נעשה בהם פנים"
        },
        {
          "s": 33,
          "text": "(ספירות),"
        },
        {
          "s": 34,
          "text": "כמו\"כ הוא באדם העליון,"
        },
        {
          "s": 35,
          "text": "שע\"י העלאת מ\"ן דאדם התחתון נעשה הציור והדמות דאדם התחתון באדם העליון."
        },
        {
          "s": 36,
          "text": "דלכאורה,"
        },
        {
          "s": 37,
          "text": "הרי הטעם על זה שבמים נראית דמות הפנים המסתכלת בהם הוא לפי שמים הם פשוטים,"
        },
        {
          "s": 38,
          "text": "משא\"כ כשמסתכלים בדבר שיש בו ציור,"
        },
        {
          "s": 39,
          "text": "הציור של הדבר הוא סותר לצורת הפנים המסתכלת בו"
        },
        {
          "s": 40,
          "text": "(כנ\"ל סעיף ה),"
        },
        {
          "s": 41,
          "text": "וכיון שאדם העליון"
        },
        {
          "s": 42,
          "text": "(ע\"ס דאצילות)"
        },
        {
          "s": 43,
          "text": "הוא בחינת ציור,"
        },
        {
          "s": 44,
          "text": "איך שייך שיהי' בו הציור דאדם התחתון."
        },
        {
          "s": 45,
          "text": "והביאור בזה,"
        },
        {
          "s": 46,
          "text": "דע\"י העבודה של אדם התחתון מתגלית הפנימיות דאדם העליון,"
        },
        {
          "s": 47,
          "text": "ע\"ס דאצילות,"
        },
        {
          "s": 48,
          "text": "שענינם הוא – הגילוי דע\"ס הגנוזות"
        },
        {
          "s": 49,
          "text": "(פנים הנראים בהמים),"
        },
        {
          "s": 50,
          "text": "ועד שהם המים"
        },
        {
          "s": 51,
          "text": "(פשיטות דאוא\"ס)"
        },
        {
          "s": 52,
          "text": "עצמם."
        },
        {
          "s": 53,
          "text": "וע\"י שמתגלה"
        },
        {
          "s": 54,
          "text": "(ע\"י העבודה דאדם התחתון)"
        },
        {
          "s": 55,
          "text": "הפנימיות דאדם העליון,"
        },
        {
          "s": 56,
          "text": "שהוא הפשיטות דאוא\"ס,"
        },
        {
          "s": 57,
          "text": "אפשר להיות בו הציור דאדם התחתון58."
        },
        {
          "s": 58,
          "text": "ועפ\"ז יש לומר דכמים הפנים לפנים הוא גם טעם וביאור על כן לב האדם לאדם."
        },
        {
          "s": 59,
          "text": "דענין מים הפנים לפנים הוא שהפנים התחתונים הנראים מחוץ להמים"
        },
        {
          "s": 60,
          "text": "(ע\"ס הגלויות)"
        },
        {
          "s": 61,
          "text": "הם חד עם הפנים העליונים הנראים בהמים"
        },
        {
          "s": 62,
          "text": "(ע\"ס הגנוזות)"
        },
        {
          "s": 63,
          "text": "ועד שהם חד עם המים עצמם"
        },
        {
          "s": 64,
          "text": "(פשיטות דאוא\"ס),"
        },
        {
          "s": 65,
          "text": "וזהו הטעם על לב האדם לאדם,"
        },
        {
          "s": 66,
          "text": "שבאדם העליון נעשה הציור דאדם התחתון."
        }
      ]
    }
  ]
}