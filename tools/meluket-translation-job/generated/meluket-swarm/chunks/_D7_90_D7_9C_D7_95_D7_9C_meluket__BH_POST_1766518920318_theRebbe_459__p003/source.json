{
  "globalIndex": 1091,
  "owner": 41,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920318_theRebbe_459__p003",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920318_theRebbe_459__p003",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920318_theRebbe_459",
  "title": "מאמר שמח תשמח תשמ\"א",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וזהו41 שמח תשמח רעים האהובים שצריך להמשיך השמחה בחו\"ב,"
        },
        {
          "s": 2,
          "text": "הגם שמקום השמחה הוא בבינה,"
        },
        {
          "s": 3,
          "text": "ובחכמה יש עונג שלמעלה מהשמחה,"
        },
        {
          "s": 4,
          "text": "כי השמחה שבבינה וכן העונג שבחכמה הוא"
        },
        {
          "s": 5,
          "text": "(דוגמת)"
        },
        {
          "s": 6,
          "text": "השמחה והעונג שמצד כחות הגלויים,"
        },
        {
          "s": 7,
          "text": "ובמילא יש בזה מדידה והגבלה."
        },
        {
          "s": 8,
          "text": "והגם שפנימיות אבא הוא פנימיות עתיק42,"
        },
        {
          "s": 9,
          "text": "ובפרט שהכוונה היא לא רק לבחי' פנימיות עתיק לבד אלא עד שרש הראשון דבחי' פנימיות ועצמות א\"ס43,"
        },
        {
          "s": 10,
          "text": "הרי ענין זה שייך ליחוד פנימי דאו\"א,"
        },
        {
          "s": 11,
          "text": "ויחוד זה צריך לעורר ולהמשיך"
        },
        {
          "s": 12,
          "text": "(שהרי יחוד פנימי דאו\"א הוא רק לפרקים44)."
        },
        {
          "s": 13,
          "text": "וזהו שמבקשים שמח תשמח רעים האהובים,"
        },
        {
          "s": 14,
          "text": "שתומשך בחו\"ב השמחה העצמית"
        },
        {
          "s": 15,
          "text": "(ועד מפנימיות ועצמות א\"ס)"
        },
        {
          "s": 16,
          "text": "שלמעלה מגדר הגבלה לגמרי,"
        },
        {
          "s": 17,
          "text": "ששמחה זו פורצת כל הגדרים"
        },
        {
          "s": 18,
          "text": "(כנ\"ל),"
        },
        {
          "s": 19,
          "text": "ועי\"ז נעשה יחוד פנימי דחו\"ב,"
        },
        {
          "s": 20,
          "text": "וגם יחוד זה יהי' יחוד תמידי."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ועיקר המכוון בזה"
        },
        {
          "s": 1,
          "text": "(ביחוד פנימי דחו\"ב)"
        },
        {
          "s": 2,
          "text": "הוא בכדי שעי\"ז יהי' יחוד זו\"ן,"
        },
        {
          "s": 3,
          "text": "\"שזהו העיקר\"45."
        },
        {
          "s": 4,
          "text": "וכמבואר בארוכה בהמאמר46"
        },
        {
          "s": 5,
          "text": "שביחוד זו\"ן דוקא הוא המשכת העצם,"
        },
        {
          "s": 6,
          "text": "שלכן מיחוד זו\"ן דוקא נעשה התהוות חדשה"
        },
        {
          "s": 7,
          "text": "(לידת הנשמות),"
        },
        {
          "s": 8,
          "text": "אלא שבכדי שיהי' יחוד זו\"ן,"
        },
        {
          "s": 9,
          "text": "צריך להיות תחילה יחוד פנימי דחו\"ב."
        },
        {
          "s": 10,
          "text": "וזהו שמח תשמח רעים האהובים"
        },
        {
          "s": 11,
          "text": "(אהובים בגימטריא דודים,"
        },
        {
          "s": 12,
          "text": "זו\"ן),"
        },
        {
          "s": 13,
          "text": "כי הבקשה שתהי' המשכת שמחה בחו\"ב שעי\"ז יהי' יחוד פנימי דחו\"ב,"
        },
        {
          "s": 14,
          "text": "הוא בשביל יחוד זו\"ן47."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז תובן גם השייכות דבקשה זו לשמחת נשואין."
        },
        {
          "s": 2,
          "text": "דהנה ידוע48"
        },
        {
          "s": 3,
          "text": "שהבריאה יש מאין היא בכח העצמות דוקא."
        },
        {
          "s": 4,
          "text": "דכל האורות והגילויים,"
        },
        {
          "s": 5,
          "text": "מכיון שיש להם עילה או סיבה עכ\"פ,"
        },
        {
          "s": 6,
          "text": "אין ביכלתם להוות דבר"
        },
        {
          "s": 7,
          "text": "(\"יש\")"
        },
        {
          "s": 8,
          "text": "שאין לו"
        },
        {
          "s": 9,
          "text": "(בהרגשתו)"
        },
        {
          "s": 10,
          "text": "עילה וסיבה,"
        },
        {
          "s": 11,
          "text": "דא\"א לשום נמצא להשפיע מה שאין בכחו49,"
        },
        {
          "s": 12,
          "text": "והתהוות היש הוא רק בכח העצמות שמציאותו מעצמותו ואין לו שום עילה וסיבה שקדמה לו ח\"ו."
        },
        {
          "s": 13,
          "text": "והנה \"המשכת\" העצמות לברוא יש מאין"
        },
        {
          "s": 14,
          "text": "(בששת ימי בראשית)"
        },
        {
          "s": 15,
          "text": "היתה מצד כי50"
        },
        {
          "s": 16,
          "text": "חפץ חסד הוא."
        },
        {
          "s": 17,
          "text": "אבל לאחרי מתן תורה בכדי שתהי' המשכה זו הוא על ידי העבודה דתומ\"צ51,"
        },
        {
          "s": 18,
          "text": "וי\"ל שבפרט"
        },
        {
          "s": 19,
          "text": "(ובגלוי)"
        },
        {
          "s": 20,
          "text": "היא ע\"י המצוות ששייכים לענין של בל\"ג,"
        },
        {
          "s": 21,
          "text": "וכמו מצות פו\"ר,"
        },
        {
          "s": 22,
          "text": "כידוע52"
        },
        {
          "s": 23,
          "text": "דבענין ההולדה"
        },
        {
          "s": 24,
          "text": "(להוליד דור אחר דור)"
        },
        {
          "s": 25,
          "text": "הוא גילוי כח הא\"ס,"
        },
        {
          "s": 26,
          "text": "ובפרט שענין ההולדה הוא"
        },
        {
          "s": 27,
          "text": "(גם)"
        },
        {
          "s": 28,
          "text": "דוגמת בריאה יש מאין53"
        },
        {
          "s": 29,
          "text": "שהיא בכח העצמות."
        },
        {
          "s": 30,
          "text": "וזהו54"
        },
        {
          "s": 31,
          "text": "מה שמבקשים בשמחת נשואין שמח תשמח רעים האהובים,"
        },
        {
          "s": 32,
          "text": "כי תכלית ענין הנשואין הוא שתהי' הולדה55,"
        },
        {
          "s": 33,
          "text": "פרו ורבו ומלאו את הארץ56,"
        },
        {
          "s": 34,
          "text": "ולכן מבקשים אז שמח תשמח רעים האהובים,"
        },
        {
          "s": 35,
          "text": "שתהי' המשכת השמחה העצמית דעצמות אוא\"ס."
        },
        {
          "s": 36,
          "text": "וזהו גם מה שאומרים"
        },
        {
          "s": 37,
          "text": "(בהמשך הברכה)"
        },
        {
          "s": 38,
          "text": "כשמחך יצירך בגן עדן מקדם,"
        },
        {
          "s": 39,
          "text": "דהמשכת השמחה בגן עדן מקדם"
        },
        {
          "s": 40,
          "text": "(בתחלת הבריאה)"
        },
        {
          "s": 41,
          "text": "היתה מצד כי חפץ חסד הוא."
        },
        {
          "s": 42,
          "text": "וזה מבקשים שגם עכשיו ע\"י עבודתינו בתומ\"צ,"
        },
        {
          "s": 43,
          "text": "ובפרט ע\"י שמחת נשואין,"
        },
        {
          "s": 44,
          "text": "תהי' המשכה זו."
        }
      ]
    }
  ]
}