{
  "globalIndex": 337,
  "owner": 37,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915661_theRebbe_783__p007",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915661_theRebbe_783__p007",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915661_theRebbe_783",
  "title": "מאמר פדה בשלום תשכ\"ו",
  "part": 7,
  "sections": [
    {
      "v": 18,
      "items": [
        {
          "s": 0,
          "text": "ולכאורה משמע,"
        },
        {
          "s": 1,
          "text": "שההמשכה דפנימיות עתיק הוא ע\"י הביטול דחסידיך,"
        },
        {
          "s": 2,
          "text": "וזה שע\"י המשכת פנימיות עתיק יהי' אהפוך אל עמים הוא ע\"י שהכחות הטבעיים דהחסידים נעשים כחות אלקיים."
        },
        {
          "s": 3,
          "text": "וצריך להבין,"
        },
        {
          "s": 4,
          "text": "דלכאורה,"
        },
        {
          "s": 5,
          "text": "זה שע\"י המשכת גילוי פנימיות עתיק יהי' אהפוך אל עמים,"
        },
        {
          "s": 6,
          "text": "אין זה ענין נוסף על הגילוי אלא נכלל בהגילוי עצמו,"
        },
        {
          "s": 7,
          "text": "דכיון שאמיתת המצאו ית' היא המציאות של כל הנמצאים לכן ע\"י הגילוי דפנימיות עתיק יהי' נרגש בכל דבר שמציאותו היא אלקות"
        },
        {
          "s": 8,
          "text": "(כנ\"ל סעיף יא),"
        },
        {
          "s": 9,
          "text": "וכיון שע\"י הביטול דחסידיך נמשך הגילוי,"
        },
        {
          "s": 10,
          "text": "למה צריך גם להאתהפכא דכחות הטבעיים שלהם."
        },
        {
          "s": 11,
          "text": "ויש לומר,"
        },
        {
          "s": 12,
          "text": "שהאתהפכא דכחות הטבעיים היא גם בשביל המשכת פנימיות עתיק."
        },
        {
          "s": 13,
          "text": "והענין הוא,"
        },
        {
          "s": 14,
          "text": "דכיון שאמיתת המצאו ית' היא היא אמיתית המציאות דכל הנמצאים,"
        },
        {
          "s": 15,
          "text": "לכן,"
        },
        {
          "s": 16,
          "text": "כשישנה מציאות"
        },
        {
          "s": 17,
          "text": "(בהאדם)"
        },
        {
          "s": 18,
          "text": "שאינה אלקות,"
        },
        {
          "s": 19,
          "text": "הוא סתירה להגילוי דהמשכת העצמות"
        },
        {
          "s": 20,
          "text": "(פנימיות עתיק),"
        },
        {
          "s": 21,
          "text": "וע\"י שכחות הטבעיים שלו נעשים כחות אלקיים"
        },
        {
          "s": 22,
          "text": "(דיש לומר,"
        },
        {
          "s": 23,
          "text": "שזה נעשה ע\"י שנרגש בו"
        },
        {
          "s": 24,
          "text": "(בהעלם עכ\"פ)"
        },
        {
          "s": 25,
          "text": "שאמיתת המצאו ית' היא היא המציאות שלו)"
        },
        {
          "s": 26,
          "text": "הוא המשכת הגילוי דפנימיות עתיק."
        }
      ]
    },
    {
      "v": 19,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש לבאר הדגשת הכתוב וחסידיך יברכוכה,"
        },
        {
          "s": 1,
          "text": "שההמשכה שע\"י חסידיך היא לא בדרך תפלה אלא בדרך ברכה,"
        },
        {
          "s": 2,
          "text": "כי בתפלה שהיא בקשת האדם שישפיעו לו מלמעלה,"
        },
        {
          "s": 3,
          "text": "נרגש שהאדם המתפלל אינו אלקות,"
        },
        {
          "s": 4,
          "text": "ובברכה שהיא בדרך ציווי,"
        },
        {
          "s": 5,
          "text": "הכח שלו לצוות הוא האלקות שבו."
        },
        {
          "s": 6,
          "text": "ויש לומר,"
        },
        {
          "s": 7,
          "text": "דזהו שירידת הגשמים שנמשכה ע\"י רשב\"י היתה לא ע\"י ציווי אלא ע\"י אמירת תורה,"
        },
        {
          "s": 8,
          "text": "כי ענין הציווי שייך דוקא כשזה שמצווים לו הוא מציאות נבדל מהמצַוה,"
        },
        {
          "s": 9,
          "text": "דמזה מובן,"
        },
        {
          "s": 10,
          "text": "דהפעולות בגילוי שנעשו ע\"י ציווי הצדיקים"
        },
        {
          "s": 11,
          "text": "(כמו רפב\"י שצוה להנהר שיחלוק את מימיו),"
        },
        {
          "s": 12,
          "text": "דהגם שרצון הצדיקים הוא רצון הקב\"ה ומ\"מ היו צריכים לצוות שיהי' כרצונם,"
        },
        {
          "s": 13,
          "text": "הוא מפני שהעולם"
        },
        {
          "s": 14,
          "text": "(בהרגשתו)"
        },
        {
          "s": 15,
          "text": "הוא מציאות לעצמו."
        },
        {
          "s": 16,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 17,
          "text": "שע\"י שרשב\"י אמר דרוש בפנימיות התורה,"
        },
        {
          "s": 18,
          "text": "נמשך גילוי העצמות,"
        },
        {
          "s": 19,
          "text": "דאמיתת המצאו ית' היא המציאות דכל הנמצאים,"
        },
        {
          "s": 20,
          "text": "ולכן ע\"י אמירת הדרוש ירדו הגשמים מעצמם,"
        },
        {
          "s": 21,
          "text": "בלי ציווי."
        },
        {
          "s": 22,
          "text": "ועד\"ז הוא בנוגע לההמשכה שע\"י הברכה דחסידיך יברכוכה,"
        },
        {
          "s": 23,
          "text": "שאין צריכים לצוות שתהי' ההמשכה"
        },
        {
          "s": 24,
          "text": "(כנ\"ל סעיף ד),"
        },
        {
          "s": 25,
          "text": "כי הברכה דחסידיך יברכוכה"
        },
        {
          "s": 26,
          "text": "(יברכו כה)"
        },
        {
          "s": 27,
          "text": "הוא המשכת פנימיות עתיק במלכות,"
        },
        {
          "s": 28,
          "text": "ובדרגא זו אין שייך ציווי."
        }
      ]
    },
    {
      "v": 20,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ג)"
        },
        {
          "s": 2,
          "text": "וזהו פדה בשלום נפשי,"
        },
        {
          "s": 3,
          "text": "בשלום דוקא,"
        },
        {
          "s": 4,
          "text": "והיינו שהפדי' היא בתכלית השלום והשלימות,"
        },
        {
          "s": 5,
          "text": "שלא נשאר שום מנגד כלל."
        },
        {
          "s": 6,
          "text": "לא כמו שהי' בנסיעת הארון דמשה שנאמר על זה קומה הוי' ויפוצו אויביך וינוסו משנאיך מפניך,"
        },
        {
          "s": 7,
          "text": "שהבירור הי' בדרך מלחמה ולכן נשאר מציאות של אויבים ושונאים אלא שהיו באופן דיפוצו וינוסו,"
        },
        {
          "s": 8,
          "text": "וגם לא כמו שהי' בימי שלמה,"
        },
        {
          "s": 9,
          "text": "דאף שהבירור הי' בדרך ממילא,"
        },
        {
          "s": 10,
          "text": "מ\"מ נתבררו רק נצוצות אלו שהי' בהם איזה ענין של אור,"
        },
        {
          "s": 11,
          "text": "כי אם שגם הנצוצות שנחשכו יוכללו בקדושה,"
        },
        {
          "s": 12,
          "text": "ויתירה מזה,"
        },
        {
          "s": 13,
          "text": "שגם הנברא,"
        },
        {
          "s": 14,
          "text": "הנפעל עצמו"
        },
        {
          "s": 15,
          "text": "(לא רק כח הפועל שבו)"
        },
        {
          "s": 16,
          "text": "יהי' בתכלית ההתאחדות,"
        },
        {
          "s": 17,
          "text": "וכמו שיהי' לעתיד67."
        },
        {
          "s": 18,
          "text": "וזהו מ\"ש כי ברבים היו עמדי,"
        },
        {
          "s": 19,
          "text": "שגם בחי' רבים,"
        },
        {
          "s": 20,
          "text": "אלו שנמצאים בבחי' רשות הרבים,"
        },
        {
          "s": 21,
          "text": "כמרז\"ל68"
        },
        {
          "s": 22,
          "text": "על הפסוק69"
        },
        {
          "s": 23,
          "text": "נעשה לשון רבים,"
        },
        {
          "s": 24,
          "text": "כתוב והרוצה לטעות יטעה,"
        },
        {
          "s": 25,
          "text": "היו עמדי,"
        },
        {
          "s": 26,
          "text": "שמתאחדים בתכלית ההתאחדות."
        },
        {
          "s": 27,
          "text": "וזהו שכי ברבים היו עמדי הוא נתינת טעם על פדה בשלום,"
        },
        {
          "s": 28,
          "text": "שהפדי' בשלום היא דוקא עי\"ז שגם בחי' רבים,"
        },
        {
          "s": 29,
          "text": "לא רק הנצוצות דקדושה כ\"א גם אלו שהם בבחי' רבים,"
        },
        {
          "s": 30,
          "text": "היו עמדי."
        },
        {
          "s": 31,
          "text": "וע\"ד מרז\"ל70"
        },
        {
          "s": 32,
          "text": "שגם אנשי אבשלום התפללו עבור דוד."
        }
      ]
    }
  ]
}