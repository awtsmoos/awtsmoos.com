{
  "globalIndex": 395,
  "owner": 45,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518916037_theRebbe_540__p002",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518916037_theRebbe_540__p002",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518916037_theRebbe_540",
  "title": "מאמר וישב יעקב תשכ\"ז",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויובן כ\"ז בהקדים מ\"ש6"
        },
        {
          "s": 2,
          "text": "פדה בשלום נפשי מקרב לי כי ברבים היו עמדי,"
        },
        {
          "s": 3,
          "text": "וידוע הדיוק מ\"ש פדה בשלום,"
        },
        {
          "s": 4,
          "text": "שמלשון זה משמע שאפשר להיות פדי' שאינה באופן של שלום,"
        },
        {
          "s": 5,
          "text": "ולכן אומר כאן פדה בשלום דוקא,"
        },
        {
          "s": 6,
          "text": "שפדי' זו היא בשלום."
        },
        {
          "s": 7,
          "text": "וגם צריך להבין מ\"ש מקרב לי,"
        },
        {
          "s": 8,
          "text": "דאומר מקרב ולא השם מלחמה,"
        },
        {
          "s": 9,
          "text": "כלשון הרגיל בכמה מקומות."
        },
        {
          "s": 10,
          "text": "דהנה לשון הקודש אינה לשון הסכמי7,"
        },
        {
          "s": 11,
          "text": "כ\"א הוא הלשון שבו נברא העולם8,"
        },
        {
          "s": 12,
          "text": "והיינו ששמו של כל דבר מורה על תוכנו וענינו הפנימי של הדבר,"
        },
        {
          "s": 13,
          "text": "שזו היא חכמתו של אדם הראשון,"
        },
        {
          "s": 14,
          "text": "ויתירה מזו,"
        },
        {
          "s": 15,
          "text": "אשר השם מורה על החיות אלקי של הדבר הנקרא בשם זה,"
        },
        {
          "s": 16,
          "text": "כמ\"ש רבינו הזקן בעל הגאולה והשמחה בשער היחוד והאמונה9."
        },
        {
          "s": 17,
          "text": "דמזה מובן בענין שמות הנרדפים שבלה\"ק,"
        },
        {
          "s": 18,
          "text": "אשר עם היות שכל השמות מורים,"
        },
        {
          "s": 19,
          "text": "בכללות,"
        },
        {
          "s": 20,
          "text": "לאותו הדבר,"
        },
        {
          "s": 21,
          "text": "מ\"מ כל שם ושם,"
        },
        {
          "s": 22,
          "text": "מורה און בריינגט אַרויס תוכן אחר."
        },
        {
          "s": 23,
          "text": "דכן הוא גם בהשמות קרב ומלחמה,"
        },
        {
          "s": 24,
          "text": "שעם היות אשר גם קרב פירושו מלחמה,"
        },
        {
          "s": 25,
          "text": "מ\"מ הנה בהכרח לומר,"
        },
        {
          "s": 26,
          "text": "אשר תיבת קרב מורה על אופן מיוחד במלחמה,"
        },
        {
          "s": 27,
          "text": "שמלחמה כזו דוקא נקראת בשם קרב."
        },
        {
          "s": 28,
          "text": "וצריך להבין מ\"ש כאן מקרב דוקא."
        },
        {
          "s": 29,
          "text": "וביותר אינו מובן עפ\"י מ\"ש בירושלמי10"
        },
        {
          "s": 30,
          "text": "שפדה בשלום נפשי מקרב לי קאי על מלחמות אבשלום,"
        },
        {
          "s": 31,
          "text": "והרי מלחמה זו נקראת בתנ\"ך בשם מלחמה,"
        },
        {
          "s": 32,
          "text": "ולמה קורא אותה כאן בשם קרב דוקא."
        },
        {
          "s": 33,
          "text": "והנה במ\"ש מקרב לי,"
        },
        {
          "s": 34,
          "text": "ישנם שני פירושים."
        },
        {
          "s": 35,
          "text": "פי' א' הוא,"
        },
        {
          "s": 36,
          "text": "דכאשר דוד הי' במצב של קרב,"
        },
        {
          "s": 37,
          "text": "הנה אז,"
        },
        {
          "s": 38,
          "text": "פדה בשלום נפשי."
        },
        {
          "s": 39,
          "text": "ופירוש הב' הוא,"
        },
        {
          "s": 40,
          "text": "שפדה והוציא אותו מהקרב,"
        },
        {
          "s": 41,
          "text": "דזהו מ\"ש מקרב במ\"ם"
        },
        {
          "s": 42,
          "text": "(וכמו ממצרים פדיתנו,"
        },
        {
          "s": 43,
          "text": "שפירושו הוא,"
        },
        {
          "s": 44,
          "text": "הפדי' והיציאה ממצרים)."
        },
        {
          "s": 45,
          "text": "וצריך להבין מהו\"ע ב\"פ אלו."
        },
        {
          "s": 46,
          "text": "והנה בסיום הענין אומר,"
        },
        {
          "s": 47,
          "text": "כי ברבים היו עמדי."
        },
        {
          "s": 48,
          "text": "דכי הוא נתינת טעם,"
        },
        {
          "s": 49,
          "text": "דמה שפדה בשלום גו' הוא לפי שרבים היו עמדי,"
        },
        {
          "s": 50,
          "text": "וכמ\"ש בירושלמי10"
        },
        {
          "s": 51,
          "text": "שגם אנשי אבשלום התפללו עבור דוד,"
        },
        {
          "s": 52,
          "text": "עי\"ז פדה בשלום נפשי."
        },
        {
          "s": 53,
          "text": "ועוד יש לפרש,"
        },
        {
          "s": 54,
          "text": "שכי הוא מלשון אשר11,"
        },
        {
          "s": 55,
          "text": "והיינו שברבים היו עמדי הוא הפי' דפדה בשלום נפשי גו',"
        },
        {
          "s": 56,
          "text": "שענין הפדי' בשלום הוא זה אשר ברבים היו עמדי,"
        },
        {
          "s": 57,
          "text": "וממוצא דבר"
        },
        {
          "s": 58,
          "text": "[משני פירושים אלו]"
        },
        {
          "s": 59,
          "text": "מובן בפירוש כי ברבים היו עמדי,"
        },
        {
          "s": 60,
          "text": "שע\"י אשר ברבים היו עמדי,"
        },
        {
          "s": 61,
          "text": "הנה עי\"ז נעשה הפדי' בשלום גו' ושברבים היו עמדי."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ולהבין כל זה,"
        },
        {
          "s": 2,
          "text": "יש להקדים מ\"ש12"
        },
        {
          "s": 3,
          "text": "ואלה המלכים אשר מלכו בארץ אדום לפני מלך מלך לבני ישראל13,"
        },
        {
          "s": 4,
          "text": "ואיתא14"
        },
        {
          "s": 5,
          "text": "במד\"ר15"
        },
        {
          "s": 6,
          "text": "א\"ל הקב\"ה ליעקב אתה השפלת עצמך וקראת לעשו אדוני ח' פעמים,"
        },
        {
          "s": 7,
          "text": "חייך שאני מעמיד מבניו ח' מלכים קודם לבניך,"
        },
        {
          "s": 8,
          "text": "שנאמר ואלה המלכים כו' לפני מלך מלך לבנ\"י כו'."
        },
        {
          "s": 9,
          "text": "וצריך להבין,"
        },
        {
          "s": 10,
          "text": "דהנה ידוע ומפורסם בקבלה ובחסידות שמלכין דתהו הן ז' מלכין,"
        },
        {
          "s": 11,
          "text": "ובמדרש חשיב שמונה מלכים."
        },
        {
          "s": 12,
          "text": "וגם צריך להבין מה שבכתוב חשיב שמונה מלכים."
        },
        {
          "s": 13,
          "text": "וידוע הביאור בזה,"
        },
        {
          "s": 14,
          "text": "שמלך השמיני,"
        },
        {
          "s": 15,
          "text": "הדר,"
        },
        {
          "s": 16,
          "text": "לא נאמר בו וימת,"
        },
        {
          "s": 17,
          "text": "שלא הי' בו ענין השבירה,"
        },
        {
          "s": 18,
          "text": "ואדרבה,"
        },
        {
          "s": 19,
          "text": "ממנו הוא התחלת שורש התיקון16."
        },
        {
          "s": 20,
          "text": "אבל צריך להבין,"
        },
        {
          "s": 21,
          "text": "שהרי בדברי הימים17"
        },
        {
          "s": 22,
          "text": "נאמר וימת גם בהדר."
        },
        {
          "s": 23,
          "text": "וידוע הביאור בזה,"
        },
        {
          "s": 24,
          "text": "כדאיתא בזהר הרקיע18"
        },
        {
          "s": 25,
          "text": "שבכתובים שהו\"ע המלכות,"
        },
        {
          "s": 26,
          "text": "ובפרט דברי הימים שקשור עם זמן,"
        },
        {
          "s": 27,
          "text": "ספירת המלכות19,"
        },
        {
          "s": 28,
          "text": "מדובר בבחי' מלכים דנוקבא,"
        },
        {
          "s": 29,
          "text": "היינו כמו שהספירות הם במלכות,"
        },
        {
          "s": 30,
          "text": "ששם הי' ענין השבירה גם במלך השמיני,"
        },
        {
          "s": 31,
          "text": "משא\"כ בתורה שהיא בחי' ז\"א,"
        },
        {
          "s": 32,
          "text": "מדובר אודות מלכין דדכורא,"
        },
        {
          "s": 33,
          "text": "שבבחי' זו לא הי' ענין השבירה במלך השמיני,"
        },
        {
          "s": 34,
          "text": "בחי' יסוד20,"
        },
        {
          "s": 35,
          "text": "ואדרבה,"
        },
        {
          "s": 36,
          "text": "ממנו הוא התחלת שורש התיקון."
        },
        {
          "s": 37,
          "text": "והנה,"
        },
        {
          "s": 38,
          "text": "המלך הראשון"
        },
        {
          "s": 39,
          "text": "(שבו היא התחלת השבירה)"
        },
        {
          "s": 40,
          "text": "הוא בלע בן בעור,"
        },
        {
          "s": 41,
          "text": "שהוא בחי' הדעת21"
        },
        {
          "s": 42,
          "text": "(ואין זה סתירה להמבואר במ\"א22"
        },
        {
          "s": 43,
          "text": "שההתחלה היא מן החסד,"
        },
        {
          "s": 44,
          "text": "כמ\"ש באוצ\"ח23)."
        },
        {
          "s": 45,
          "text": "ולכאורה צריך להבין,"
        },
        {
          "s": 46,
          "text": "שהרי מבואר שכל ענין השבירה הי' בהמדות24."
        },
        {
          "s": 47,
          "text": "אבל מ\"מ צריך לומר שהשבירה היא מצד בחי' הדעת,"
        },
        {
          "s": 48,
          "text": "וכמובן בפשטות מזה שענין השבירה למטה הו\"ע החטא דאדה\"ר שאכל מעץ הדעת,"
        },
        {
          "s": 49,
          "text": "ענין הדעת דוקא."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וביאור הענין הוא25,"
        },
        {
          "s": 2,
          "text": "דהנה,"
        },
        {
          "s": 3,
          "text": "חטא עה\"ד ענינו הוא שהי' ההרגש בגשמיות,"
        },
        {
          "s": 4,
          "text": "וכמ\"ש26"
        },
        {
          "s": 5,
          "text": "ותרא גו' כי טוב העץ למאכל וכי תאוה הוא לעינים,"
        },
        {
          "s": 6,
          "text": "והיינו,"
        },
        {
          "s": 7,
          "text": "שלפני חטא עה\"ד הי' החיך של אדה\"ר מרגיש טעם רוחני,"
        },
        {
          "s": 8,
          "text": "והחטא הי' שהרגיש טעם גשמי."
        },
        {
          "s": 9,
          "text": "והענין הוא,"
        },
        {
          "s": 10,
          "text": "דהנה ידוע שלפני החטא הי' אדה\"ר כלול מבי\"ע,"
        },
        {
          "s": 11,
          "text": "ראשו בבריאה וגופו ביצירה ורגליו בעשי'27,"
        },
        {
          "s": 12,
          "text": "ומובן,"
        },
        {
          "s": 13,
          "text": "שגם רגליו היו במדריגה נעלית יותר,"
        },
        {
          "s": 14,
          "text": "שהרי הרגלים קשורים עם שאר הגוף,"
        },
        {
          "s": 15,
          "text": "שהוא גוף אחד."
        },
        {
          "s": 16,
          "text": "ועוד זאת,"
        },
        {
          "s": 17,
          "text": "שבתחלת הבריאה עולם על מילואו נברא28."
        },
        {
          "s": 18,
          "text": "ולכן גם במדריגת רגליו של אדה\"ר הי' החיך הגשמי שלו מרגיש טעם רוחני."
        },
        {
          "s": 19,
          "text": "וזהו שאמרו רז\"ל29"
        },
        {
          "s": 20,
          "text": "שעקבו של אדה\"ר מכהה גלגל חמה,"
        },
        {
          "s": 21,
          "text": "דעקב הוא מדריגה התחתונה שברגל,"
        },
        {
          "s": 22,
          "text": "ואעפ\"כ הי' מכהה גלגל חמה,"
        },
        {
          "s": 23,
          "text": "שזהו\"ע המזלות,"
        },
        {
          "s": 24,
          "text": "והיינו,"
        },
        {
          "s": 25,
          "text": "שעקבו של אדה\"ר הי' למעלה מהמזלות."
        },
        {
          "s": 26,
          "text": "וענין המזלות הוא כמארז\"ל30"
        },
        {
          "s": 27,
          "text": "אין לך עשב מלמטה שאין לו מזל מלמעלה המכה בו ואומר לו גדל,"
        },
        {
          "s": 28,
          "text": "וכפי שמדייק אדה\"ז31"
        },
        {
          "s": 29,
          "text": "הלשון אומר לו גדל,"
        },
        {
          "s": 30,
          "text": "שאין הכוונה שעצם ההתהוות נעשה מהמזל,"
        },
        {
          "s": 31,
          "text": "אלא שלאחר שנתהווה המציאות,"
        },
        {
          "s": 32,
          "text": "אזי נעשה ע\"י המזל הגדלות שלו,"
        },
        {
          "s": 33,
          "text": "בטעם ומתיקות ובשאר הענינים."
        },
        {
          "s": 34,
          "text": "ומובן שכיון שהמזל הוא רוחני,"
        },
        {
          "s": 35,
          "text": "הרי לא שייך בו מתיקות גשמי."
        },
        {
          "s": 36,
          "text": "ועד\"ז יובן באדה\"ר שעקבו הי' מכהה גלגל חמה,"
        },
        {
          "s": 37,
          "text": "שהי' למעלה מהמזלות,"
        },
        {
          "s": 38,
          "text": "שהחיך שלו הי' טועם טעם רוחני."
        },
        {
          "s": 39,
          "text": "והחטא הי' שטעם טעם גשמי,"
        },
        {
          "s": 40,
          "text": "והפירוש בזה,"
        },
        {
          "s": 41,
          "text": "שרצונו הי' לטעום טעם גשמי,"
        },
        {
          "s": 42,
          "text": "ולכן הרגיש את הטעם הגשמי."
        },
        {
          "s": 43,
          "text": "ואין הכוונה שעי\"ז נעשה הטעם הגשמי,"
        },
        {
          "s": 44,
          "text": "שהרי גם כפי שעולם על מילואו נברא הי' הטעם גשמי,"
        },
        {
          "s": 45,
          "text": "אלא שלפני החטא טעם אדה\"ר את הטעם הרוחני,"
        },
        {
          "s": 46,
          "text": "ואילו הטעם הגשמי הי' נבלע ונכלל בתוך הרוחני,"
        },
        {
          "s": 47,
          "text": "שלא הי' מציאות בפ\"ע."
        },
        {
          "s": 48,
          "text": "וענין החטא הי' שרצה להרגיש את הגשמי כמו שהוא מצד עצמו."
        },
        {
          "s": 49,
          "text": "וזהו שקודם החטא הי' גופו ביצירה,"
        },
        {
          "s": 50,
          "text": "ששם הי' טועם מתיקות התורה,"
        },
        {
          "s": 51,
          "text": "ובמדרגת רגליו בעשי',"
        },
        {
          "s": 52,
          "text": "הי' הרגש המתיקות רק מתיקות רוחני,"
        },
        {
          "s": 53,
          "text": "והגשמי הי' נגרר אחר הרוחני."
        },
        {
          "s": 54,
          "text": "והחטא הי' שרצה להרגיש את הגשמי."
        },
        {
          "s": 55,
          "text": "וזהו גם הפירוש במ\"ש32"
        },
        {
          "s": 56,
          "text": "וידעו כי ערומים הם,"
        },
        {
          "s": 57,
          "text": "שאין הכוונה שמתחלה לא ידעו,"
        },
        {
          "s": 58,
          "text": "דא\"כ מהו החידוש שלא יתבוששו33,"
        },
        {
          "s": 59,
          "text": "אלא מ\"ש וידעו הו\"ע ההכרה וההרגשה,"
        },
        {
          "s": 60,
          "text": "והיינו,"
        },
        {
          "s": 61,
          "text": "שבתחילה לא הי' בענין זה ההרגש והתאוה,"
        },
        {
          "s": 62,
          "text": "וכמ\"ש בראשית חכמה34"
        },
        {
          "s": 63,
          "text": "שקודם החטא הי' ההרגש שכשם שע\"י היד מקיימים מצות תפילין"
        },
        {
          "s": 64,
          "text": "(שהוקשה כל התורה כולה לתפילין35),"
        },
        {
          "s": 65,
          "text": "כמו\"כ ע\"י אבר זה מקיימים מצות פרו ורבו,"
        },
        {
          "s": 66,
          "text": "שהיא מצוה רמה ונשאה,"
        },
        {
          "s": 67,
          "text": "וכמ\"ש36"
        },
        {
          "s": 68,
          "text": "לא תהו בראה לשבת יצרה,"
        },
        {
          "s": 69,
          "text": "והחטא פעל שנעשה אצלם ההרגש והתאוה בענין זה."
        },
        {
          "s": 70,
          "text": "ולכן הי' צריך להיות הענין של כתנות37,"
        },
        {
          "s": 71,
          "text": "ומזה נשתלשל להלכה בפועל שצריכים ענין הלבושים."
        },
        {
          "s": 72,
          "text": "וכמו\"כ הוא בענין חטא עה\"ד,"
        },
        {
          "s": 73,
          "text": "שסיבתו הוא הדעת וההרגשה,"
        },
        {
          "s": 74,
          "text": "והיינו שהחטא הי' מה שנעשה אצלו ההרגש של הדבר הגשמי כפי שהוא מצד עצמו,"
        },
        {
          "s": 75,
          "text": "ולא כמו שהוא נגרר אחר הרוחני."
        },
        {
          "s": 76,
          "text": "ומזה מובן גם למעלה,"
        },
        {
          "s": 77,
          "text": "שסיבת השבירה בהמדות הו\"ע ההרגש,"
        },
        {
          "s": 78,
          "text": "בחי' הדעת."
        }
      ]
    }
  ]
}