{
  "globalIndex": 315,
  "owner": 15,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915585_theRebbe_828__p002",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915585_theRebbe_828__p002",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915585_theRebbe_828",
  "title": "מאמר פתח אליהו תשט\"ו",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ולכאורה הי' אפ\"ל,"
        },
        {
          "s": 1,
          "text": "דכיון דזה שהקב\"ה מנהיג את העולם ע\"פ טבע הוא תמיד בשוה"
        },
        {
          "s": 2,
          "text": "[דבכל יום ויום השמש זורחת במזרח ושוקעת במערב,"
        },
        {
          "s": 3,
          "text": "ועד\"ז בכל עניני הטבע],"
        },
        {
          "s": 4,
          "text": "לכן אין ניכר בגילוי שהקב\"ה הוא המנהיג את העולם ויש מקום לטעות שהעולם מתנהג מעצמו9,"
        },
        {
          "s": 5,
          "text": "וע\"י הנסים שלפעמים הקב\"ה משנה את הנהגת הטבע,"
        },
        {
          "s": 6,
          "text": "זה מוכיח שגם הנהגת הטבע10"
        },
        {
          "s": 7,
          "text": "היא מהקב\"ה."
        },
        {
          "s": 8,
          "text": "אבל לפי זה,"
        },
        {
          "s": 9,
          "text": "השלימות דטבע היא שיהי' ניכר בגלוי שהטבע הוא אלקות,"
        },
        {
          "s": 10,
          "text": "ובהמאמר אומר שע\"י העבודה"
        },
        {
          "s": 11,
          "text": "(דמס\"נ)"
        },
        {
          "s": 12,
          "text": "נמשך בטבע הגילוי דלמעלה מהטבע."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ומבואר בכמה דרושים11"
        },
        {
          "s": 2,
          "text": "דשרש הטבע הוא משם אלקים"
        },
        {
          "s": 3,
          "text": "(אלקים בגימטריא הטבע12),"
        },
        {
          "s": 4,
          "text": "ושורש הנסים הוא משם הוי'."
        },
        {
          "s": 5,
          "text": "ומבאר שם,"
        },
        {
          "s": 6,
          "text": "דבשם הוי' הוא דעת עליון,"
        },
        {
          "s": 7,
          "text": "שלמעלה יש ולמטה אין,"
        },
        {
          "s": 8,
          "text": "היינו שכל ההתהוות היא אין ואפס וכולא קמי' כלא חשיב,"
        },
        {
          "s": 9,
          "text": "ובשם אלקים הוא דעת תחתון,"
        },
        {
          "s": 10,
          "text": "שהבריאה היא מאין ליש,"
        },
        {
          "s": 11,
          "text": "היינו שהנבראים הם מציאות יש"
        },
        {
          "s": 12,
          "text": "[והכח האלקי שמהווה אותם נקרא בשם אין,"
        },
        {
          "s": 13,
          "text": "אין שאינו מושג]."
        },
        {
          "s": 14,
          "text": "[ויש לומר,"
        },
        {
          "s": 15,
          "text": "שהוא ע\"ד המבואר במק\"א13"
        },
        {
          "s": 16,
          "text": "דההתהוות שמשם אלקים היא בדרך התלבשות"
        },
        {
          "s": 17,
          "text": "(בראשית ברא אלקים14),"
        },
        {
          "s": 18,
          "text": "דזה מורה שהוא מקור לענין ההתהוות."
        },
        {
          "s": 19,
          "text": "ולכן הנבראים שמתהווים ממנו הם תופסים מקום לגבי',"
        },
        {
          "s": 20,
          "text": "והביטול שלהם הוא רק ביטול היש – דעת תחתון שלמטה יש."
        },
        {
          "s": 21,
          "text": "וההתהוות שמשם הוי' היא באופן דבדרך ממילא"
        },
        {
          "s": 22,
          "text": "(יהללו את שם הוי' כי הוא צוה ונבראו15),"
        },
        {
          "s": 23,
          "text": "שזה מורה שהוא מופלא מענין ההתהוות,"
        },
        {
          "s": 24,
          "text": "ולכן הנבראים שמתהווים ממנו אינם תופסים מקום לגבי',"
        },
        {
          "s": 25,
          "text": "ביטול במציאות – דעת עליון שלמטה אין]."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ומבואר בהדרושים11,"
        },
        {
          "s": 1,
          "text": "דכמו שהוא בענין השמות,"
        },
        {
          "s": 2,
          "text": "דבשם הוי' הוא דעת עליון ובשם אלקים הוא דעת תחתון,"
        },
        {
          "s": 3,
          "text": "עד\"ז הוא גם בענין נס וטבע"
        },
        {
          "s": 4,
          "text": "(הנמשכים מהוי' ואלקים),"
        },
        {
          "s": 5,
          "text": "דהנהגת הטבע היא מצד דעת תחתון,"
        },
        {
          "s": 6,
          "text": "והנסים שלמעלה מהטבע הם מבחינת דעת עליון."
        },
        {
          "s": 7,
          "text": "[ויש לומר,"
        },
        {
          "s": 8,
          "text": "שהשייכות דנס וטבע לדעת עליון ודעת תחתון היא לא רק מצד שרשם,"
        },
        {
          "s": 9,
          "text": "דשרש הנסים הוא מהוי' ושרש הטבע הוא מאלקים,"
        },
        {
          "s": 10,
          "text": "אלא גם מצד הענין דנס וטבע עצמם."
        },
        {
          "s": 11,
          "text": "והענין הוא,"
        },
        {
          "s": 12,
          "text": "דהנהגת הטבע היא שהקב\"ה מנהיג את כל נברא לפי ענינו,"
        },
        {
          "s": 13,
          "text": "דזה מורה שבהנהגה זו,"
        },
        {
          "s": 14,
          "text": "הנבראים תופסים מקום,"
        },
        {
          "s": 15,
          "text": "למטה יש."
        },
        {
          "s": 16,
          "text": "והנהגה נסית היא שהקב\"ה מנהיג את העולם כפי רצונו ולא כפי תכונת וטבע הנבראים,"
        },
        {
          "s": 17,
          "text": "כי בהנהגה זו,"
        },
        {
          "s": 18,
          "text": "הנבראים אינם תופסים מקום,"
        },
        {
          "s": 19,
          "text": "למטה אין]."
        },
        {
          "s": 20,
          "text": "וע\"י הנסים הנמשכים בעולם,"
        },
        {
          "s": 21,
          "text": "שגם בהטבע נמשך הגילוי דלמעלה מהטבע,"
        },
        {
          "s": 22,
          "text": "נעשה החיבור דדעת תחתון ודעת עליון,"
        },
        {
          "s": 23,
          "text": "למהוי אחד באחד16,"
        },
        {
          "s": 24,
          "text": "שגם בדעת תחתון מאיר הגילוי דדעת עליון."
        }
      ]
    }
  ]
}