{
  "globalIndex": 641,
  "owner": 41,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917471_theRebbe_230__p004",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917471_theRebbe_230__p004",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917471_theRebbe_230",
  "title": "מאמר בלילה ההוא תשכ\"ה",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש להוסיף ביאור בזה ששני הענינים דלילה"
        },
        {
          "s": 1,
          "text": "(לילה ההוא ולילה הזה)"
        },
        {
          "s": 2,
          "text": "כמו שהם למטה הם באופן הפוך מכמו שהם בשרשם,"
        },
        {
          "s": 3,
          "text": "דלמעלה לילה ההוא הוא למעלה מלילה הזה וכמו שהם נמשכים למטה ההסתר"
        },
        {
          "s": 4,
          "text": "(לגריעותא)"
        },
        {
          "s": 5,
          "text": "דלילה ההוא הוא הסתר גדול יותר מההסתר דלילה הזה,"
        },
        {
          "s": 6,
          "text": "כי שני הענינים דלילה שלמעלה,"
        },
        {
          "s": 7,
          "text": "יש לומר,"
        },
        {
          "s": 8,
          "text": "שהם שתי דרגות הנ\"ל בכח ההעלם דאוא\"ס,"
        },
        {
          "s": 9,
          "text": "לילה הזה הוא כח ההעלם"
        },
        {
          "s": 10,
          "text": "(לילה)"
        },
        {
          "s": 11,
          "text": "ששייך לגילוי"
        },
        {
          "s": 12,
          "text": "(הזה),"
        },
        {
          "s": 13,
          "text": "וכיון שהצמצום שנמשך מדרגא זו הוא בשביל הגילוי,"
        },
        {
          "s": 14,
          "text": "לכן,"
        },
        {
          "s": 15,
          "text": "הלילה"
        },
        {
          "s": 16,
          "text": "(ההעלם וההסתר שלמטה)"
        },
        {
          "s": 17,
          "text": "הוא באופן דזה,"
        },
        {
          "s": 18,
          "text": "שנרגש בגילוי שהוא לילה."
        },
        {
          "s": 19,
          "text": "כי זה שההעלם מביא לגילוי הוא דוקא כשנרגש ההעלם"
        },
        {
          "s": 20,
          "text": "[וע\"ד הצמאון לאלקות שבזמן הגלות"
        },
        {
          "s": 21,
          "text": "(לילה)"
        },
        {
          "s": 22,
          "text": "שהוא יותר מבזמן הבית45,"
        },
        {
          "s": 23,
          "text": "שהוא הגילוי הבא ע\"י ההעלם,"
        },
        {
          "s": 24,
          "text": "שזהו דוקא ע\"י שנרגש ההעלם וההסתר דהגלות]."
        },
        {
          "s": 25,
          "text": "ולילה ההוא הוא עצם כח ההעלם שלמעלה משייכות לגילוי,"
        },
        {
          "s": 26,
          "text": "דהצמצום שנמשך מדרגא זו הוא"
        },
        {
          "s": 27,
          "text": "(לא בשביל הגילוי,"
        },
        {
          "s": 28,
          "text": "אלא)"
        },
        {
          "s": 29,
          "text": "שבו מתגלה כח ההעלם,"
        },
        {
          "s": 30,
          "text": "ולכן הלילה שלמטה הנמשך מענין זה דהצמצום הוא באופן דהוא שאין נרגש שהוא העלם והסתר."
        },
        {
          "s": 31,
          "text": "והחילוק שבין שני ענינים אלה בעבודת האדם,"
        },
        {
          "s": 32,
          "text": "הוא,"
        },
        {
          "s": 33,
          "text": "שהעבודה בלילה"
        },
        {
          "s": 34,
          "text": "(חושך הגלות,"
        },
        {
          "s": 35,
          "text": "ועד\"ז החושך דכללות עוה\"ז)"
        },
        {
          "s": 36,
          "text": "מצד הצמצום שבשביל הגילוי היא התשוקה והצמאון לצאת מחושך הלילה."
        },
        {
          "s": 37,
          "text": "והעבודה בלילה מצד זה שבהצמצום מתגלה כח ההעלם היא ההתבוננות וכו' בהשרש דחושך הלילה עצמו,"
        },
        {
          "s": 38,
          "text": "ששרשו הוא בהעלם העצמי."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וזהו בלילה ההוא נדדה שנת המלך זה מלכו של עולם,"
        },
        {
          "s": 2,
          "text": "דלילה ההוא הוא שגרם להיות נדדה שנת המלך,"
        },
        {
          "s": 3,
          "text": "כי השרש דלילה ההוא שלמטה הוא מבחינת לילה ההוא דלמעלה,"
        },
        {
          "s": 4,
          "text": "שלמעלה מההעלם דיום ההוא ואפילו מההעלם דלילה הזה."
        },
        {
          "s": 5,
          "text": "וע\"י שישראל עמדו אז במס\"נ במשך כל השנה,"
        },
        {
          "s": 6,
          "text": "שהמס\"נ שלהם היתה מצד ההסתר46"
        },
        {
          "s": 7,
          "text": "[וע\"ד המבואר במק\"א47"
        },
        {
          "s": 8,
          "text": "שבזמן הגלות גילוי כח המס\"נ הוא יותר מבזמן הבית],"
        },
        {
          "s": 9,
          "text": "נמשך"
        },
        {
          "s": 10,
          "text": "(בגילוי)"
        },
        {
          "s": 11,
          "text": "בחינת לילה ההוא דלמעלה בלילה ההוא דלמטה."
        },
        {
          "s": 12,
          "text": "וזהו הקשר דשני הפירושים בבלילה ההוא נדדה שנת המלך,"
        },
        {
          "s": 13,
          "text": "שלילה ההוא גורם ענין השינה"
        },
        {
          "s": 14,
          "text": "(ומ\"ש בלילה ההוא נדדה שנת המלך הוא להדגיש הנס,"
        },
        {
          "s": 15,
          "text": "דהגם שהי' בלילה ההוא מ\"מ נדדה שנת המלך)"
        },
        {
          "s": 16,
          "text": "ושלילה ההוא גרם להיות נדדה שנת המלך,"
        },
        {
          "s": 17,
          "text": "כי זה שלילה ההוא גורם ענין השינה הוא כמו שהוא מצד עצמו,"
        },
        {
          "s": 18,
          "text": "אבל ע\"י שנמשך בו שרשו,"
        },
        {
          "s": 19,
          "text": "בחינת לילה ההוא דלמעלה,"
        },
        {
          "s": 20,
          "text": "הרי אדרבה,"
        },
        {
          "s": 21,
          "text": "הוא גורם להיות נדדה שנת המלך."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ויש להוסיף,"
        },
        {
          "s": 2,
          "text": "דנדדה שנת המלך הוא למעלה יותר גם מלילה ההוא שלמעלה"
        },
        {
          "s": 3,
          "text": "[ולילה ההוא הוא רק גורם להמשכת נדדה שנת המלך]."
        },
        {
          "s": 4,
          "text": "והענין הוא,"
        },
        {
          "s": 5,
          "text": "דיום ולילה,"
        },
        {
          "s": 6,
          "text": "כח ההעלם וכח הגילוי שבאוא\"ס,"
        },
        {
          "s": 7,
          "text": "הם שני ענינים,"
        },
        {
          "s": 8,
          "text": "ולכן,"
        },
        {
          "s": 9,
          "text": "גם לאחרי המשכת בחינת לילה ההוא דלמעלה בלילה ההוא דלמטה,"
        },
        {
          "s": 10,
          "text": "הוא נשאר לילה"
        },
        {
          "s": 11,
          "text": "[ועוד יותר,"
        },
        {
          "s": 12,
          "text": "לילה ההוא],"
        },
        {
          "s": 13,
          "text": "כי זה שנמשך בו הוא כח ההעלם ולא כח הגילוי."
        },
        {
          "s": 14,
          "text": "ועד\"ז הוא בנוגע לזה שעמדו במס\"נ במשך כל השנה,"
        },
        {
          "s": 15,
          "text": "דכיון שהמס\"נ שלהם באה מצד ההסתר"
        },
        {
          "s": 16,
          "text": "(כנ\"ל סעיף ז),"
        },
        {
          "s": 17,
          "text": "שע\"י ההסתר מתעורר ההעלם דנשמה שלמעלה מגילוי48,"
        },
        {
          "s": 18,
          "text": "אין זה שייך"
        },
        {
          "s": 19,
          "text": "(כ\"כ)"
        },
        {
          "s": 20,
          "text": "לכחות הגלויים,"
        },
        {
          "s": 21,
          "text": "ובנוגע לכחות הגלויים היו"
        },
        {
          "s": 22,
          "text": "(גם לאחרי המס\"נ)"
        },
        {
          "s": 23,
          "text": "במצב דלילה ההוא49."
        },
        {
          "s": 24,
          "text": "וע\"ד המבואר בהמאמר50"
        },
        {
          "s": 25,
          "text": "דזה שבעת השינה אין ניכר מעלת הכחות זה על זה הוא בדוגמת הכחות כמו שהם כלולים בעצם הנפש,"
        },
        {
          "s": 26,
          "text": "ששם כל הכחות הם בהשוואה."
        },
        {
          "s": 27,
          "text": "ומזה מובן,"
        },
        {
          "s": 28,
          "text": "שיש מעלה בשינה,"
        },
        {
          "s": 29,
          "text": "שאז דוקא מתעלים הכחות למקורם,"
        },
        {
          "s": 30,
          "text": "אלא שמעלה זו אינה שייכת לכחות הגלויים"
        },
        {
          "s": 31,
          "text": "(גילויים),"
        },
        {
          "s": 32,
          "text": "ואדרבה,"
        },
        {
          "s": 33,
          "text": "בכחות הגלויים נעשה גרעון וחסרון."
        },
        {
          "s": 34,
          "text": "וזה שבלילה ההוא נדדה שנת המלך,"
        },
        {
          "s": 35,
          "text": "דנדדה שנת המלך הו\"ע הגילויים הנמשכים מזה שאוא\"ס הוא למטה מטה עד אין תכלית"
        },
        {
          "s": 36,
          "text": "(קו הגילוי),"
        },
        {
          "s": 37,
          "text": "הוא החיבור דהעלם וגילוי."
        },
        {
          "s": 38,
          "text": "וכמבואר בדרוש הנ\"ל לאדמו\"ר האמצעי דזה שבלילה ההוא נדדה שנת המלך הוא כמשל הצבי שעינו אחת פתוחה ועינו אחת קמוצה51,"
        },
        {
          "s": 39,
          "text": "גילוי והעלם ביחד."
        },
        {
          "s": 40,
          "text": "ומבאר שם,"
        },
        {
          "s": 41,
          "text": "דזה שהי' אז החיבור דשני ההפכים דהעלם וגילוי הוא לפי שאז הי' גילוי העצמות,"
        },
        {
          "s": 42,
          "text": "שלגבי העצמות,"
        },
        {
          "s": 43,
          "text": "ההעלם והגילוי אינם הפכים."
        },
        {
          "s": 44,
          "text": "וכמבואר במק\"א52"
        },
        {
          "s": 45,
          "text": "דזה שהעצמות ביכלתו להאיר וביכלתו שלא להאיר,"
        },
        {
          "s": 46,
          "text": "שניהם הם ענין אחד."
        },
        {
          "s": 47,
          "text": "ויש לומר דמ\"ש בהמאמר דזה שנדדה שנת המלך נעשה על ידי המס\"נ דישראל במשך כל השנה,"
        },
        {
          "s": 48,
          "text": "הכוונה היא גם להמשכת העצמות שהיתה אז,"
        },
        {
          "s": 49,
          "text": "כי מס\"נ באה מעצם הנשמה,"
        },
        {
          "s": 50,
          "text": "ולכן,"
        },
        {
          "s": 51,
          "text": "ע\"י המס\"נ המשיכו העצמות."
        }
      ]
    }
  ]
}