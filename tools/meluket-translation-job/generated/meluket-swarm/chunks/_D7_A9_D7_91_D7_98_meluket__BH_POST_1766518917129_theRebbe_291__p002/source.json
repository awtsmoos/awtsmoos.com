{
  "globalIndex": 589,
  "owner": 39,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917129_theRebbe_291__p002",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917129_theRebbe_291__p002",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518917129_theRebbe_291",
  "title": "מאמר כי תשא תשל\"א",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ולהעיר,"
        },
        {
          "s": 1,
          "text": "דבלקו\"ת ד\"ה שובה ישראל גו' כי כשלת בעוניך7"
        },
        {
          "s": 2,
          "text": "מבואר שהוא כמשל אדם הכושל רגלו שעי\"ז נופל ראשו למטה."
        },
        {
          "s": 3,
          "text": "ועפ\"ז הי' אפשר לומר דפירוש כי תשא את ראש בני ישראל הוא להגבי' את הראש מנפילתו למטה."
        },
        {
          "s": 4,
          "text": "ויש לומר הטעם על זה שבדרושים הנ\"ל אינו מפרש כן,"
        },
        {
          "s": 5,
          "text": "כי פרשה זו נאמרה לאחרי יוהכ\"פ8"
        },
        {
          "s": 6,
          "text": "לאחרי שנתרצה הקב\"ה לישראל בשמחה ובלב שלם ואמר לו למשה סלחתי כדברך9."
        },
        {
          "s": 7,
          "text": "והרושם מהחטא שנשאר אחר יוהכ\"פ הוא"
        },
        {
          "s": 8,
          "text": "(בעיקר)"
        },
        {
          "s": 9,
          "text": "רק בנוגע לזה שהרצון שלמעלה מהשכל לא האיר בגילוי בכחות הפנימיים,"
        },
        {
          "s": 10,
          "text": "ולכן נאמר כי תשא את ראש בני ישראל."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה כתיב10"
        },
        {
          "s": 2,
          "text": "גדע בחרי אף כל קרן ישראל,"
        },
        {
          "s": 3,
          "text": "שע\"י העוונות נעשה ירידה גם בבחינת הקרן שלמעלה מהראש."
        },
        {
          "s": 4,
          "text": "ולכן אמר משה במה תרום קרן ישראל,"
        },
        {
          "s": 5,
          "text": "שצריך להגבי' ולרומם את הקרן שלמעלה מהראש."
        },
        {
          "s": 6,
          "text": "ומבואר בלקו\"ת11,"
        },
        {
          "s": 7,
          "text": "דקרן היא בחינת כתר."
        },
        {
          "s": 8,
          "text": "וצריך ביאור,"
        },
        {
          "s": 9,
          "text": "הרי זה שהקרן הוא למעלה מהראש הוא"
        },
        {
          "s": 10,
          "text": "(לא רק מהמוח שבראש אלא)"
        },
        {
          "s": 11,
          "text": "גם מהגולגולת,"
        },
        {
          "s": 12,
          "text": "וע\"פ הידוע שגלגלתא"
        },
        {
          "s": 13,
          "text": "(הגולגולת שחופה על המוח)"
        },
        {
          "s": 14,
          "text": "היא בחינת כתר,"
        },
        {
          "s": 15,
          "text": "מהו מעלת הקרן על הראש."
        },
        {
          "s": 16,
          "text": "ויש לומר,"
        },
        {
          "s": 17,
          "text": "דגלגלתא הוא מקיף ששייך לפנימי,"
        },
        {
          "s": 18,
          "text": "בדוגמת הגולגולת שבאדם שמקיף את המוח אבל שייך אליו12,"
        },
        {
          "s": 19,
          "text": "וקרן הוא מקיף שלמעלה משייכות לפנימי."
        },
        {
          "s": 20,
          "text": "וכמבואר בכ\"מ13"
        },
        {
          "s": 21,
          "text": "בפירוש הכתוב14"
        },
        {
          "s": 22,
          "text": "וירם קרן לעמו,"
        },
        {
          "s": 23,
          "text": "שקאי על עצמות אוא\"ס שלמעלה מסובב."
        },
        {
          "s": 24,
          "text": "וכמו\"כ הוא בנשמה,"
        },
        {
          "s": 25,
          "text": "שקרן הנשמה הוא עצם הנשמה15."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "וצריך להבין מה שאמר משה במה תרום קרן ישראל,"
        },
        {
          "s": 1,
          "text": "דלכאורה,"
        },
        {
          "s": 2,
          "text": "איך שייך שתהי' ירידה בעצם הנשמה."
        },
        {
          "s": 3,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 4,
          "text": "דהכוונה בירידת הנשמה למטה היא בכדי לפעול בהגוף,"
        },
        {
          "s": 5,
          "text": "ולכן,"
        },
        {
          "s": 6,
          "text": "כשאינה משלמת הכוונה נעשה ירידה בכל הדרגות שבה,"
        },
        {
          "s": 7,
          "text": "גם בהעצם שלה"
        },
        {
          "s": 8,
          "text": "(שירדה למטה)."
        },
        {
          "s": 9,
          "text": "ועפ\"ז,"
        },
        {
          "s": 10,
          "text": "הירידה שע\"י החטא בדרגת הראש דהנשמה,"
        },
        {
          "s": 11,
          "text": "היא מפני שלגבי דרגא זו יש ערך לכחות הגלויים"
        },
        {
          "s": 12,
          "text": "(מכיון שהיא מקיף השייך לפנימי),"
        },
        {
          "s": 13,
          "text": "ולכן הענינים דכחות הגלויים פועלים בה שינוי"
        },
        {
          "s": 14,
          "text": "(אלא שהשינוי הוא רק בנוגע להגילוי שלה,"
        },
        {
          "s": 15,
          "text": "כנ\"ל סעיף ב),"
        },
        {
          "s": 16,
          "text": "והירידה שנעשית ע\"י החטא בעצם הנשמה היא לא שהענינים דכחות הגלויים פועלים בה שינוי,"
        },
        {
          "s": 17,
          "text": "אלא לפי שלא נשלמה הכוונה שבשבילה ירדה למטה."
        },
        {
          "s": 18,
          "text": "ויש לומר,"
        },
        {
          "s": 19,
          "text": "דזהו מ\"ש גדע גו' קרן ישראל,"
        },
        {
          "s": 20,
          "text": "דכמו שבקרן כפשוטו,"
        },
        {
          "s": 21,
          "text": "השינוי שנעשה בקרן ע\"י שנגדע מהראש"
        },
        {
          "s": 22,
          "text": "(שאין בו התוקף שהי' בו תחילה)"
        },
        {
          "s": 23,
          "text": "הוא לא שהראש פועל שינוי בקרן אלא אדרבה מפני שנגדע מהראש,"
        },
        {
          "s": 24,
          "text": "עד\"ז הוא בהקרן דהנשמה,"
        },
        {
          "s": 25,
          "text": "שהשינוי שנעשה בה ע\"י החטא הוא מצד זה שאינה פועלת בכחות הגלויים"
        },
        {
          "s": 26,
          "text": "(ואינה משלמת כוונת ירידתה למטה)."
        }
      ]
    }
  ]
}