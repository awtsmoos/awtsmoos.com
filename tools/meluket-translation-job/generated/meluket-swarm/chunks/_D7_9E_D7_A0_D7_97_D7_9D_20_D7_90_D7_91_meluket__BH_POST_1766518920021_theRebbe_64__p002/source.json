{
  "globalIndex": 1058,
  "owner": 8,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518920021_theRebbe_64__p002",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518920021_theRebbe_64__p002",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518920021_theRebbe_64",
  "title": "מאמר ושננתם לבניך תשל\"ח",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויש לבאר זה בהקדם ביאור ענין חמשה עשר באב"
        },
        {
          "s": 2,
          "text": "(שזהו\"ע שהזמן גרמא),"
        },
        {
          "s": 3,
          "text": "דאיתא במשנה9"
        },
        {
          "s": 4,
          "text": "לא היו ימים טובים לישראל כחמשה עשר באב וכיום הכפורים"
        },
        {
          "s": 5,
          "text": "(כמבואר בגמרא10"
        },
        {
          "s": 6,
          "text": "פרטי הדברים בארוכה)."
        },
        {
          "s": 7,
          "text": "ומבואר בדרושי רבותינו נשיאינו11,"
        },
        {
          "s": 8,
          "text": "שמלשון חז\"ל לא היו ימים טובים כו',"
        },
        {
          "s": 9,
          "text": "משמע,"
        },
        {
          "s": 10,
          "text": "שט\"ו באב הוא למעלה גם מהימים טובים שהם פסח שבועות וסוכות."
        },
        {
          "s": 11,
          "text": "ולכאורה12,"
        },
        {
          "s": 12,
          "text": "אפילו את\"ל הביאור במעלת חמשה עשר באב לגבי שבועות,"
        },
        {
          "s": 13,
          "text": "שזהו מצד העילוי דיום חמשה עשר בחודש13,"
        },
        {
          "s": 14,
          "text": "שבו קיימא סיהרא באשלמותא14,"
        },
        {
          "s": 15,
          "text": "עדיין צריך ביאור והסבר במעלת חמשה עשר באב על חמשה עשר בניסן"
        },
        {
          "s": 16,
          "text": "(פסח)"
        },
        {
          "s": 17,
          "text": "וחמשה עשר בתשרי"
        },
        {
          "s": 18,
          "text": "(סוכות),"
        },
        {
          "s": 19,
          "text": "אע\"פ שבשלשתם ישנו העילוי דיום חמשה עשר בחודש שבו קיימא סיהרא באשלמותא."
        },
        {
          "s": 20,
          "text": "וידוע הביאור בזה15,"
        },
        {
          "s": 21,
          "text": "שמעלת חמשה עשר באב היא להיותו בחודש אב שהתחלתו היא באופן של ירידה גדולה,"
        },
        {
          "s": 22,
          "text": "ועד לירידה אחר ירידה,"
        },
        {
          "s": 23,
          "text": "שזהו\"ע לקו בכפלים,"
        },
        {
          "s": 24,
          "text": "בגלל הירידה במצב הרוחני באופן שחטאו בכפלים16."
        },
        {
          "s": 25,
          "text": "ולכן הנה גם העלי' שלאח\"ז – שבאה לאחרי עבודת התשובה באופן דבכה תבכה17,"
        },
        {
          "s": 26,
          "text": "בכי' בכפלים18"
        },
        {
          "s": 27,
          "text": "– היא באופן דנחמה בכפלים,"
        },
        {
          "s": 28,
          "text": "ועד לעלי' הכי נעלית19,"
        },
        {
          "s": 29,
          "text": "שלא בערך מהעלי' דחמשה עשר בניסן וחמשה עשר בתשרי."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ובפרטיות יותר,"
        },
        {
          "s": 2,
          "text": "הנה גם חמשה עשר בתשרי הוא עלי' שלאחרי הירידה."
        },
        {
          "s": 3,
          "text": "וכידוע20"
        },
        {
          "s": 4,
          "text": "החילוק בין ניסן לתשרי,"
        },
        {
          "s": 5,
          "text": "שענינו של ניסן הוא עבודת הצדיקים,"
        },
        {
          "s": 6,
          "text": "שהרי בצאתם ממצרים היו בנ\"י בדרגא של צדיקים,"
        },
        {
          "s": 7,
          "text": "דגר21"
        },
        {
          "s": 8,
          "text": "שנתגייר כקטן שנולד דמי22."
        },
        {
          "s": 9,
          "text": "וזהו שחג הפסח הוא כנגד אברהם אבינו23,"
        },
        {
          "s": 10,
          "text": "שמדתו מדת החסד24,"
        },
        {
          "s": 11,
          "text": "ועבודתו היתה באופן של השפעה מלמעלה למטה,"
        },
        {
          "s": 12,
          "text": "כמ\"ש25"
        },
        {
          "s": 13,
          "text": "ויקרא שם בשם ה' א-ל עולם,"
        },
        {
          "s": 14,
          "text": "והיינו,"
        },
        {
          "s": 15,
          "text": "שהמשיך אלקות בעולם להיות לו ית' דירה בתחתונים26,"
        },
        {
          "s": 16,
          "text": "לא רק באופן שהקב\"ה הוא א-ל העולם,"
        },
        {
          "s": 17,
          "text": "אלא באופן שאלקות והעולם נעשה כולא חד27,"
        },
        {
          "s": 18,
          "text": "שזהו כללות ענין עבודת הצדיקים."
        },
        {
          "s": 19,
          "text": "משא\"כ תשרי,"
        },
        {
          "s": 20,
          "text": "הרי השם תשרי עצמו הוא בסדר תשר\"ק שהוא מלמטה למעלה28,"
        },
        {
          "s": 21,
          "text": "וגם העבודה דחודש תשרי היא עבודת התשובה,"
        },
        {
          "s": 22,
          "text": "שלכן באה לאחרי הקדמת העבודה דחודש אלול,"
        },
        {
          "s": 23,
          "text": "בחרטה על העבר ואח\"כ קבלה טובה על להבא,"
        },
        {
          "s": 24,
          "text": "ועד שבאים לחמשה עשר בתשרי,"
        },
        {
          "s": 25,
          "text": "שקיימא סיהרא באשלמותא,"
        },
        {
          "s": 26,
          "text": "שאז הוא היו\"ט דסוכות,"
        },
        {
          "s": 27,
          "text": "עד להסיום וחותם שלו בשמע\"צ ושמח\"ת29"
        },
        {
          "s": 28,
          "text": "(כמבואר בארוכה בהדרושים בענין החילוק שבין ניסן לתשרי)."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "אמנם ענין זה שגם חודש תשרי הוא עלי' שלאחרי הירידה,"
        },
        {
          "s": 1,
          "text": "מצד עבודת התשובה שבו,"
        },
        {
          "s": 2,
          "text": "הוא רק בערך ולגבי חודש ניסן,"
        },
        {
          "s": 3,
          "text": "משא\"כ בערך ולגבי חודש אב"
        },
        {
          "s": 4,
          "text": "(שרק בו אב היתה הירידה שלא בערך – חורבן ביהמ\"ק וגלות וכו' – בכל הפרטים),"
        },
        {
          "s": 5,
          "text": "הרי גם העבודה דחודש תשרי שענינה עבודת התשובה היא ע\"ד עבודת הצדיקים."
        },
        {
          "s": 6,
          "text": "והענין בזה,"
        },
        {
          "s": 7,
          "text": "דהנה,"
        },
        {
          "s": 8,
          "text": "עבודת התשובה שבחודש תשרי היא באופן של הליכה דרגא אחר דרגא,"
        },
        {
          "s": 9,
          "text": "שלכן צ\"ל ההקדמה ד\"ירח ימים\"30,"
        },
        {
          "s": 10,
          "text": "כמבואר בלקוטי תורה להאריז\"ל31"
        },
        {
          "s": 11,
          "text": "ולקו\"ת לאדמו\"ר הזקן32"
        },
        {
          "s": 12,
          "text": "שקאי על העבודה דחודש אלול,"
        },
        {
          "s": 13,
          "text": "שעי\"ז נעשית ההליכה דרגא אחר דרגא עד שבאים להדרגא דראש השנה"
        },
        {
          "s": 14,
          "text": "(שהוא גם הראש דחודש תשרי),"
        },
        {
          "s": 15,
          "text": "ועד שלאח\"ז באים להשלימות דקיימא סיהרא באשלמותא,"
        },
        {
          "s": 16,
          "text": "בימי הסוכות,"
        },
        {
          "s": 17,
          "text": "שהתחלתם בחמשה עשר בחודש."
        },
        {
          "s": 18,
          "text": "משא\"כ בחודש אב,"
        },
        {
          "s": 19,
          "text": "אין זה באופן של הליכה מדרגא לדרגא,"
        },
        {
          "s": 20,
          "text": "אלא העלי' היא תיכף לאחרי תכלית הירידה דתשעה באב,"
        },
        {
          "s": 21,
          "text": "מן הקצה אל הקצה,"
        },
        {
          "s": 22,
          "text": "ועד שענין הנחמה ישנו כבר בת\"ב עצמו,"
        },
        {
          "s": 23,
          "text": "שזהו שאומרים בתפלת מנחה מנחם ציון ובונה ירושלים,"
        },
        {
          "s": 24,
          "text": "לפי שאז נולד משיח,"
        },
        {
          "s": 25,
          "text": "מושיען של ישראל33,"
        },
        {
          "s": 26,
          "text": "שענינו הוא הנקודה והעיקר והעצם דתשובה34."
        },
        {
          "s": 27,
          "text": "והיינו,"
        },
        {
          "s": 28,
          "text": "שהענין דלידת משיח מתחיל באותו היום תומ\"יא"
        },
        {
          "s": 29,
          "text": "ובאותו הרגעב"
        },
        {
          "s": 30,
          "text": "של תכלית הירידה,"
        },
        {
          "s": 31,
          "text": "ובאופן שנמשך בגלוי בכמה ענינים שמתחילים לאחרי חצות היום דת\"ב37,"
        },
        {
          "s": 32,
          "text": "שהסיבה לכך היא בגלל שזהו זמן לידת משיח."
        },
        {
          "s": 33,
          "text": "ורק כדי שהגילוי יהי' בשלימות,"
        },
        {
          "s": 34,
          "text": "צריכים להמתין עד חמשה עשר באב38."
        },
        {
          "s": 35,
          "text": "וע\"ד שמצינו בסיבת היו\"ט דחמשה עשר באב להיותו יום שכלו בו מתי מדבר39,"
        },
        {
          "s": 36,
          "text": "שעד חמשה עשר באב הי' ספק בדבר,"
        },
        {
          "s": 37,
          "text": "וכאשר קיימא סיהרא באשלמותא,"
        },
        {
          "s": 38,
          "text": "אזי נתברר שכבר כלו מתי מדבר בת\"ב40,"
        },
        {
          "s": 39,
          "text": "והם עדה שלימה41,"
        },
        {
          "s": 40,
          "text": "שכתוב בהן42"
        },
        {
          "s": 41,
          "text": "ואתם הדבקים בהוי' אלקיכם חיים כולכם היום,"
        },
        {
          "s": 42,
          "text": "ועומדים להיכנס לארץ43,"
        },
        {
          "s": 43,
          "text": "בגאולה האמיתית והשלימה44"
        },
        {
          "s": 44,
          "text": "ע\"י גואל ראשון,"
        },
        {
          "s": 45,
          "text": "הקשורה עם הגאולה ע\"י משיח צדקנו,"
        },
        {
          "s": 46,
          "text": "שהוא גואל אחרון45"
        },
        {
          "s": 47,
          "text": "[כידוע שכל הגלויות נקראו ע\"ש מצרים46,"
        },
        {
          "s": 48,
          "text": "לפי שיש בהם הענין דגלות מצרים,"
        },
        {
          "s": 49,
          "text": "ועד\"ז ישנה גאולת מצרים בכל הגאולות47,"
        },
        {
          "s": 50,
          "text": "ועל שמה נקראים כל הגאולות48,"
        },
        {
          "s": 51,
          "text": "עד לגאולה האחרונה,"
        },
        {
          "s": 52,
          "text": "גאולה האמיתית והשלימה מן גלות זה האחרון,"
        },
        {
          "s": 53,
          "text": "שאין אחרי' גלות49,"
        },
        {
          "s": 54,
          "text": "עלי' נאמר50"
        },
        {
          "s": 55,
          "text": "כימי צאתך מארץ מצרים אראנו נפלאות]."
        },
        {
          "s": 56,
          "text": "ולהעיר,"
        },
        {
          "s": 57,
          "text": "שכן הוא גם בנוגע לפרשת השבוע,"
        },
        {
          "s": 58,
          "text": "שתשעה באב והעילוי שבו הוא בפרשת ואתחנן"
        },
        {
          "s": 59,
          "text": "(ובכו\"כ שנים חל גם ט\"ו באב בפרשת ואתחנן),"
        },
        {
          "s": 60,
          "text": "הבאה ברגעא חדא לפ' דברים וחזון."
        },
        {
          "s": 61,
          "text": "וזהו העילוי דחודש אב אפילו לגבי העבודה דחודש תשרי"
        },
        {
          "s": 62,
          "text": "(ועאכו\"כ לגבי העבודה דחודש ניסן),"
        },
        {
          "s": 63,
          "text": "כי,"
        },
        {
          "s": 64,
          "text": "העבודה דחודש תשרי היא באופן של הליכה מדרגא לדרגא,"
        },
        {
          "s": 65,
          "text": "שתנועה זו שייכת לעבודת הצדיקים,"
        },
        {
          "s": 66,
          "text": "ואילו העלי' דחודש אב היא מן הקצה אל הקצה,"
        },
        {
          "s": 67,
          "text": "שזוהי התנועה דעבודת בעלי תשובה,"
        },
        {
          "s": 68,
          "text": "שהרי ענין התשובה הוא בשעתא חדא וברגע חדא51."
        }
      ]
    }
  ]
}