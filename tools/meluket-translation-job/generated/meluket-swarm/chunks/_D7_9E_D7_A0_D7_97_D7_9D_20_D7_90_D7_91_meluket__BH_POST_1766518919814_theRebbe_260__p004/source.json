{
  "globalIndex": 1019,
  "owner": 19,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919814_theRebbe_260__p004",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919814_theRebbe_260__p004",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919814_theRebbe_260",
  "title": "מאמר לא היו ימים טובים לישראל תשל\"ה",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה מבואר בהמאמר32,"
        },
        {
          "s": 2,
          "text": "דבשדה אשר ברכו הוי'34,"
        },
        {
          "s": 3,
          "text": "שני פירושים."
        },
        {
          "s": 4,
          "text": "פירוש רש\"י שהוא ג\"ע,"
        },
        {
          "s": 5,
          "text": "ופירוש הת\"י שהוא בית המקדש."
        },
        {
          "s": 6,
          "text": "וכמבואר בכ\"מ35,"
        },
        {
          "s": 7,
          "text": "דביהמ\"ק הוא כמו ג\"ע."
        },
        {
          "s": 8,
          "text": "וכמו36"
        },
        {
          "s": 9,
          "text": "שבג\"ע יש ב' מדריגות,"
        },
        {
          "s": 10,
          "text": "ג\"ע מצד עצמו והתוספות אור שנמשך בו ע\"י עבודה,"
        },
        {
          "s": 11,
          "text": "עד\"ז הוא בביהמ\"ק,"
        },
        {
          "s": 12,
          "text": "דנוסף על הגילוי שהי' בביהמ\"ק מצד עצמו,"
        },
        {
          "s": 13,
          "text": "הרי ע\"י העבודה בביהמ\"ק"
        },
        {
          "s": 14,
          "text": "(עבודת הקרבנות)"
        },
        {
          "s": 15,
          "text": "האיר בו גילוי נעלה יותר."
        },
        {
          "s": 16,
          "text": "וע\"פ מ\"ש בהמאמר שהענין דקיימא סיהרא באשלמותא הוא"
        },
        {
          "s": 17,
          "text": "(בעיקר)"
        },
        {
          "s": 18,
          "text": "ע\"י העבודה בשדה"
        },
        {
          "s": 19,
          "text": "(מלך לשדה נעבד),"
        },
        {
          "s": 20,
          "text": "מובן,"
        },
        {
          "s": 21,
          "text": "דכמו\"כ הוא גם בנוגע לביהמ\"ק,"
        },
        {
          "s": 22,
          "text": "שהענין דקיימא סיהרא באשלמותא שהי' בביהמ\"ק מצד עצמו,"
        },
        {
          "s": 23,
          "text": "הן המקום דביהמ\"ק שלית דין אתר הדיוט37,"
        },
        {
          "s": 24,
          "text": "וכן הזמן דבנין ביהמ\"ק שנבנה ע\"י שלמה דור הט\"ו לאברהם שאז קיימא סיהרא באשלמותא38,"
        },
        {
          "s": 25,
          "text": "הוא דוגמת הגילוי שבג\"ע מצד עצמו39,"
        },
        {
          "s": 26,
          "text": "שדה,"
        },
        {
          "s": 27,
          "text": "ועיקר קיימא סיהרא באשלמותא שהי' בביהמ\"ק הוא שע\"י העבודה בביהמ\"ק נמשך בו תוספות אור שלמעלה מהשתלשלות,"
        },
        {
          "s": 28,
          "text": "מלך לשדה נעבד."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 1,
          "text": "דהגילוי שהי' בביהמ\"ק מצד עצמו,"
        },
        {
          "s": 2,
          "text": "היתה המשכתו רק בזמן הבית."
        },
        {
          "s": 3,
          "text": "וכמבואר בהמאמר40,"
        },
        {
          "s": 4,
          "text": "שהחילוק בין זמן הבית לזמן הגלות הוא בדוגמת החילוק שבין חצי כדור העליון דהלבנה לחצי כדור התחתון שבה."
        },
        {
          "s": 5,
          "text": "ולכן,"
        },
        {
          "s": 6,
          "text": "כיון שהגילוי שהי' בביהמ\"ק מצד עצמו הוא אור מוגבל שמאיר רק41"
        },
        {
          "s": 7,
          "text": "בהדרגא דמלכות שמקבלת מז\"א"
        },
        {
          "s": 8,
          "text": "(חצי כדור העליון דהלבנה),"
        },
        {
          "s": 9,
          "text": "היתה המשכתו רק בזמן הבית."
        },
        {
          "s": 10,
          "text": "והאור שניתוסף בביהמ\"ק ע\"י העבודה"
        },
        {
          "s": 11,
          "text": "[עבודת הקרבנות,"
        },
        {
          "s": 12,
          "text": "ועד\"ז העבודה דועשו לי מקדש42],"
        },
        {
          "s": 13,
          "text": "כיון שאור זה הוא בל\"ג שאין שייך בו הפסק,"
        },
        {
          "s": 14,
          "text": "המשכתו הוא גם בזמן הגלות."
        },
        {
          "s": 15,
          "text": "אלא שמצד הירידה שבזמן הגלות,"
        },
        {
          "s": 16,
          "text": "אין האור נרגש בהעולם"
        },
        {
          "s": 17,
          "text": "(כדלקמן סעיף ו)."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 2,
          "text": "שיש עוד פירוש בזהר43"
        },
        {
          "s": 3,
          "text": "במלך לשדה נעבד,"
        },
        {
          "s": 4,
          "text": "שהוא לגריעותא."
        },
        {
          "s": 5,
          "text": "דשדה הוא שדה דלעו\"ז"
        },
        {
          "s": 6,
          "text": "[בשדה מצאה44],"
        },
        {
          "s": 7,
          "text": "ומלך לשדה נעבד הוא שהמלכות דקדושה נעבדת לשדה דלעו\"ז."
        },
        {
          "s": 8,
          "text": "ויש לומר,"
        },
        {
          "s": 9,
          "text": "דזה שפירוש זה במלך לשדה נעבד בא לאחרי ובהמשך להפירוש דמלך לשדה נעבד הוא למעליותא,"
        },
        {
          "s": 10,
          "text": "הוא,"
        },
        {
          "s": 11,
          "text": "כי זה שישנו הענין דמלך לשדה נעבד לגריעותא הוא בכדי שהענין דמלך לשדה נעבד למעליותא,"
        },
        {
          "s": 12,
          "text": "המשכת מלך עילאה"
        },
        {
          "s": 13,
          "text": "(כתר),"
        },
        {
          "s": 14,
          "text": "תהי' באופן נעלה יותר."
        },
        {
          "s": 15,
          "text": "ויש לומר דהעילוי שניתוסף בהמשכת הכתר ע\"י הירידה"
        },
        {
          "s": 16,
          "text": "(דמלך לשדה נעבד לגריעותא)"
        },
        {
          "s": 17,
          "text": "לגבי ההמשכה שקודם הירידה,"
        },
        {
          "s": 18,
          "text": "הוא הוספה שבאין ערוך."
        },
        {
          "s": 19,
          "text": "ועד שלגבי ההמשכה שלאחר הירידה,"
        },
        {
          "s": 20,
          "text": "ההמשכה שהיתה מקודם היא בכלל הסדר השתלשלות."
        },
        {
          "s": 21,
          "text": "וזהו שארז\"ל45"
        },
        {
          "s": 22,
          "text": "דזה שעלה ארי' במזל ארי' והחריב את אריאל כו' הוא על מנת שיבוא ארי' במזל ארי' ויבנה אריאל,"
        },
        {
          "s": 23,
          "text": "וידוע46"
        },
        {
          "s": 24,
          "text": "דיבוא ארי'"
        },
        {
          "s": 25,
          "text": "[זה הקב\"ה,"
        },
        {
          "s": 26,
          "text": "דכתיב בי'47"
        },
        {
          "s": 27,
          "text": "ארי' שאג מי לא יירא]"
        },
        {
          "s": 28,
          "text": "הוא התגלות הכתר שלמעלה מהשתלשלות."
        },
        {
          "s": 29,
          "text": "ומזה שבכדי שיהי' יבוא ארי'"
        },
        {
          "s": 30,
          "text": "(התגלות הכתר שלמעלה מהשתלשלות)"
        },
        {
          "s": 31,
          "text": "הי' צריך להיות עלה ארי' כו' והחריב אריאל,"
        },
        {
          "s": 32,
          "text": "אף שהענין דמלך לשדה נעבד"
        },
        {
          "s": 33,
          "text": "(למעליותא)"
        },
        {
          "s": 34,
          "text": "הי' גם קודם,"
        },
        {
          "s": 35,
          "text": "מובן,"
        },
        {
          "s": 36,
          "text": "שהמשכת הכתר"
        },
        {
          "s": 37,
          "text": "(מלך עילאה)"
        },
        {
          "s": 38,
          "text": "שהיתה מקודם,"
        },
        {
          "s": 39,
          "text": "לגבי ההמשכה שלאחרי הירידה,"
        },
        {
          "s": 40,
          "text": "היא בכלל סדר ההשתלשלות."
        }
      ]
    }
  ]
}