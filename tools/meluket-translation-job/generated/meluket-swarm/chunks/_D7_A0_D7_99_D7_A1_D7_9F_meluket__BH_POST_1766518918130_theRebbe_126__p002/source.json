{
  "globalIndex": 743,
  "owner": 43,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918130_theRebbe_126__p002",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918130_theRebbe_126__p002",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518918130_theRebbe_126",
  "title": "מאמר לה\"ע תחיית המתים תשמ\"ו",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ונקודת אחד הביאורים בזה הוא,"
        },
        {
          "s": 2,
          "text": "כמבואר בכמה דרושים12,"
        },
        {
          "s": 3,
          "text": "שהשכר דג\"ע הוא על עסק התורה,"
        },
        {
          "s": 4,
          "text": "והשכר דתחיית המתים הוא על קיום המצוות."
        },
        {
          "s": 5,
          "text": "וזהו שג\"ע הוא עולם הנשמות"
        },
        {
          "s": 6,
          "text": "(נשמות בלא גופים)"
        },
        {
          "s": 7,
          "text": "ובעולם התחי' יהיו נשמות בגופים,"
        },
        {
          "s": 8,
          "text": "כי עסק התורה שייך בעיקר להנשמה וקיום המצוות להגוף13."
        },
        {
          "s": 9,
          "text": "וכיון שקיום המצוות הוא בכל ישראל,"
        },
        {
          "s": 10,
          "text": "דאפילו פושעי ישראל מלאים מצוות כרמון14,"
        },
        {
          "s": 11,
          "text": "לכן כל ישראל יש להם חלק לעולם הבא."
        },
        {
          "s": 12,
          "text": "ויש לומר,"
        },
        {
          "s": 13,
          "text": "דזהו גם מה שממשיך במשנה שנאמר15"
        },
        {
          "s": 14,
          "text": "ועמך כולם צדיקים לעולם יירשו ארץ כו',"
        },
        {
          "s": 15,
          "text": "דיש לומר,"
        },
        {
          "s": 16,
          "text": "שכוונת המשנה בשנאמר כו' היא לא רק להביא ראי' על זה שכל ישראל יש להם חלק לעולם הבא אלא גם לבאר הטעם על זה."
        },
        {
          "s": 17,
          "text": "דמי שמקיים מצוות נק' בשם צדיק"
        },
        {
          "s": 18,
          "text": "[דכל המצוות נק' בשם צדקה16,"
        },
        {
          "s": 19,
          "text": "ומקיימי המצוות נק' בשם צדיקים17],"
        },
        {
          "s": 20,
          "text": "וכיון שועמך כולם צדיקים,"
        },
        {
          "s": 21,
          "text": "שכל ישראל"
        },
        {
          "s": 22,
          "text": "(אפילו הפושעים שבהם)"
        },
        {
          "s": 23,
          "text": "מקיימים מצוות,"
        },
        {
          "s": 24,
          "text": "ויתירה מזו שהם מלאים מצוות,"
        },
        {
          "s": 25,
          "text": "דהמצוות שמקיימים ממלאים את כל מציאותם,"
        },
        {
          "s": 26,
          "text": "לכן לעולם יירשו ארץ,"
        },
        {
          "s": 27,
          "text": "ארץ החיים18"
        },
        {
          "s": 28,
          "text": "שקאי על חיי עולם הבא."
        },
        {
          "s": 29,
          "text": "אמנם,"
        },
        {
          "s": 30,
          "text": "עפ\"ז צריך להבין מה שמביא במשנה גם המשך הכתוב נצר מטעי מעשה ידי להתפאר,"
        },
        {
          "s": 31,
          "text": "והרי זה שישראל הם נצר מטעי ומעשה ידיו של הקב\"ה הוא מצד עצם מציאותם"
        },
        {
          "s": 32,
          "text": "(עוד לפני שמקיימים מצוות),"
        },
        {
          "s": 33,
          "text": "ובהמשנה דכל ישראל יש להם חלק לעולם הבא מביא גם סיום הכתוב נצר מטעי מעשה ידי להתפאר,"
        },
        {
          "s": 34,
          "text": "דמזה משמע,"
        },
        {
          "s": 35,
          "text": "דזה שכל ישראל יש להם חלק לעולם הבא הוא"
        },
        {
          "s": 36,
          "text": "(גם)"
        },
        {
          "s": 37,
          "text": "מצד המעלה שבהם מצד עצמם."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "שבהגילוי שיהי' בתחיית המתים שני ענינים."
        },
        {
          "s": 3,
          "text": "השכר על העבודה דקיום המצוות"
        },
        {
          "s": 4,
          "text": "(ועמך כולם צדיקים),"
        },
        {
          "s": 5,
          "text": "שההמשכות שהמשיכו ישראל ע\"י המצוות שקיימו עכשיו תהי' אז בגילוי,"
        },
        {
          "s": 6,
          "text": "ועי\"ז יתעלו"
        },
        {
          "s": 7,
          "text": "(אח\"כ19)"
        },
        {
          "s": 8,
          "text": "למדריגה נעלית יותר,"
        },
        {
          "s": 9,
          "text": "שתתגלה מעלתן של ישראל מצד עצמם,"
        },
        {
          "s": 10,
          "text": "שהם נצר מטעי מעשה ידי להתפאר,"
        },
        {
          "s": 11,
          "text": "שהוא למעלה יותר גם מההמשכה שנמשכת ע\"י קיום המצוות."
        },
        {
          "s": 12,
          "text": "ויש להוסיף,"
        },
        {
          "s": 13,
          "text": "שעיקר החידוש והעילוי דתחיית המתים הוא שאז תתגלה מעלת ישראל עצמם."
        },
        {
          "s": 14,
          "text": "דגילוי ההמשכה שנמשכת ע\"י המצוות,"
        },
        {
          "s": 15,
          "text": "יהי' גם בימות המשיח"
        },
        {
          "s": 16,
          "text": "(קודם זמן התחי'),"
        },
        {
          "s": 17,
          "text": "וכמבואר בתניא20"
        },
        {
          "s": 18,
          "text": "שע\"י מעשינו ועבודתינו עכשיו ממשיכים אוא\"ס למטה והגילוי דהמשכה זו יהי' בימות המשיח ובתחיית המתים"
        },
        {
          "s": 19,
          "text": "(אלא שבתחיית המתים,"
        },
        {
          "s": 20,
          "text": "גם הגילוי דהמשכה זו יהי' באופן נעלה יותר21),"
        },
        {
          "s": 21,
          "text": "ועיקר החידוש והעילוי דתחיית המתים הוא שאז יתגלה השורש דישראל כמו שהם מושרשים בהעצמות22."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דמ\"ש בכמה דרושים"
        },
        {
          "s": 2,
          "text": "(הובא לעיל)"
        },
        {
          "s": 3,
          "text": "שבתחיית המתים יהי' גילוי ההמשכה שנמשכת ע\"י קיום המצוות,"
        },
        {
          "s": 4,
          "text": "הוא,"
        },
        {
          "s": 5,
          "text": "כי שם מדובר בהשכר לישראל שיהי' בעולם הבא עבור עבודתם בתומ\"צ בעולם הזה23,"
        },
        {
          "s": 6,
          "text": "ושלימות השכר הוא שיאיר להם בגילוי ההמשכה שהמשיכו ע\"י קיום המצוות."
        },
        {
          "s": 7,
          "text": "ולכן מבואר בדרושים אלו ששכר הנשמות בג\"ע הוא שמשיגים האלקות דהתורה שלמדו בעוה\"ז,"
        },
        {
          "s": 8,
          "text": "דתורה היא חכמתו של הקב\"ה,"
        },
        {
          "s": 9,
          "text": "אור הממלא,"
        },
        {
          "s": 10,
          "text": "והשכר דתחיית המתים הוא שאז יראו עינינו גילוי אלקותו הבלתי בע\"ג24"
        },
        {
          "s": 11,
          "text": "שנמשך ע\"י קיום המצוות,"
        },
        {
          "s": 12,
          "text": "רצונו ית'"
        },
        {
          "s": 13,
          "text": "(שלמעלה מחכמתו),"
        },
        {
          "s": 14,
          "text": "אור הסובב."
        },
        {
          "s": 15,
          "text": "אמנם,"
        },
        {
          "s": 16,
          "text": "כל זה הוא השכר לישראל עבור עבודתם בתומ\"צ25."
        },
        {
          "s": 17,
          "text": "ועיקר החידוש והעילוי שיהי' בעולם הבא הוא הגילוי דמעלת ישראל עצמם,"
        },
        {
          "s": 18,
          "text": "נצר מטעי מעשה ידי להתפאר."
        }
      ]
    }
  ]
}