{
  "globalIndex": 410,
  "owner": 10,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518916086_theRebbe_759__p003",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518916086_theRebbe_759__p003",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518916086_theRebbe_759",
  "title": "מאמר אמר ר' אלכסנדרי תשל\"א",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה מה שנוגע בהמאמר לבאר שבכל עולם ישנם ג' הבחינות חב\"ד חג\"ת ונה\"י"
        },
        {
          "s": 2,
          "text": "(בפשטות)"
        },
        {
          "s": 3,
          "text": "הוא,"
        },
        {
          "s": 4,
          "text": "לפי שבלאה\"כ אינו מובן ענין המספר למ\"ד כלים."
        },
        {
          "s": 5,
          "text": "דלכאורה,"
        },
        {
          "s": 6,
          "text": "מכיון שבבריאה נמשך רק מבחי' חב\"ד שבכלים דאצילות,"
        },
        {
          "s": 7,
          "text": "ביצירה רק מבחי' חג\"ת,"
        },
        {
          "s": 8,
          "text": "ובעשי' רק מבחי' נה\"י,"
        },
        {
          "s": 9,
          "text": "הרי ישנם רק ג' פעמים ג',"
        },
        {
          "s": 10,
          "text": "ומהו\"ע ל' כלים."
        },
        {
          "s": 11,
          "text": "ולכן מבאר,"
        },
        {
          "s": 12,
          "text": "שבכל עולם ישנם כל ג' הבחינות כו'."
        },
        {
          "s": 13,
          "text": "אמנם בעומק יותר,"
        },
        {
          "s": 14,
          "text": "הנה ענין זה שבכל עולם ישנם כל הבחי',"
        },
        {
          "s": 15,
          "text": "נוגע לכללות תוכן המאמר."
        },
        {
          "s": 16,
          "text": "דהנה,"
        },
        {
          "s": 17,
          "text": "מה שבעולם הבריאה ישנם גם חג\"ת ונה\"י,"
        },
        {
          "s": 18,
          "text": "וכן בחי' חב\"ד ונה\"י ביצירה,"
        },
        {
          "s": 19,
          "text": "חב\"ד וחג\"ת בעשי',"
        },
        {
          "s": 20,
          "text": "הוא דוגמת ההתכללות דדצח\"מ שמבאר בהמאמר להלן22,"
        },
        {
          "s": 21,
          "text": "שהשינוי והחילוק שבין ד' הסוגים דצח\"מ הוא רק מצד בחי' הגילוי,"
        },
        {
          "s": 22,
          "text": "אבל מצד בחי' ההעלם,"
        },
        {
          "s": 23,
          "text": "כולם שוין."
        },
        {
          "s": 24,
          "text": "ועפ\"ז מבאר23"
        },
        {
          "s": 25,
          "text": "ענין ההשגחה פרטית בכל חלקי דצח\"מ דעשי'"
        },
        {
          "s": 26,
          "text": "[ועד\"ז בד' עולמות אבי\"ע שנמשלים לדצח\"מ24],"
        },
        {
          "s": 27,
          "text": "כי ההשגחה שמצד עצמות אוא\"ס שבבחי' העלם,"
        },
        {
          "s": 28,
          "text": "היא בשוה בכולם."
        },
        {
          "s": 29,
          "text": "והיינו שבחי' ההתכללות דדצח\"מ,"
        },
        {
          "s": 30,
          "text": "שבכל אחד מד' סוגים אלו כלולים בהעלם גם שאר ג' הסוגים,"
        },
        {
          "s": 31,
          "text": "הנה העלם זה שייך לבחי' העלם העצמי"
        },
        {
          "s": 32,
          "text": "[דבחי' עקודים ולמעלה יותר,"
        },
        {
          "s": 33,
          "text": "שלמעלה מענין ההתחלקות]."
        },
        {
          "s": 34,
          "text": "ועפ\"ז מובן מה שמבאר בהמאמר"
        },
        {
          "s": 35,
          "text": "(בהענין דל' כלים דאצילות נעשים נר\"נ לבי\"ע)"
        },
        {
          "s": 36,
          "text": "שבכל עולם מהג' עולמות בי\"ע ישנם כל ג' הבחינות חב\"ד חג\"ת נה\"י,"
        },
        {
          "s": 37,
          "text": "כי ההתכללות דבחי' חג\"ת ונה\"י בבריאה,"
        },
        {
          "s": 38,
          "text": "וכן חב\"ד ונה\"י ביצירה,"
        },
        {
          "s": 39,
          "text": "חב\"ד וחג\"ת בעשי',"
        },
        {
          "s": 40,
          "text": "הוא מצד בחי' ההעלם שבבי\"ע,"
        },
        {
          "s": 41,
          "text": "השייך לבחי' העלם העצמי"
        },
        {
          "s": 42,
          "text": "(בדוגמת ההתכללות דדצח\"מ,"
        },
        {
          "s": 43,
          "text": "כנ\"ל)."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יובן גם שלאחרי שמבאר הענין דלמ\"ד כלים דאצילות נעשים נר\"נ לבי\"ע,"
        },
        {
          "s": 2,
          "text": "וענין ההתכללות שבבי\"ע,"
        },
        {
          "s": 3,
          "text": "מקשה בהמאמר25"
        },
        {
          "s": 4,
          "text": ": אך הנה מעתה יש להבין איך יוכל להיות התהוות בע\"ג מאור א\"ס שהוא בלתי בע\"ג."
        },
        {
          "s": 5,
          "text": "דלכאורה הרי קושיא זו היא גם בנוגע לאצילות,"
        },
        {
          "s": 6,
          "text": "שהרי גם אצילות הוא הגבלה,"
        },
        {
          "s": 7,
          "text": "וגם בנוגע לבי\"ע,"
        },
        {
          "s": 8,
          "text": "הרי הקושיא לכאורה הוא מצד עצם ענין ההגבלה שבבי\"ע,"
        },
        {
          "s": 9,
          "text": "ולא מצד ענין ההתכללות כו',"
        },
        {
          "s": 10,
          "text": "ולמה כותב מעתה יש להבין כו'."
        },
        {
          "s": 11,
          "text": "אך הענין הוא,"
        },
        {
          "s": 12,
          "text": "כי אמיתית ענין ההגבלה הוא מצד ענין ההתכללות דוקא."
        },
        {
          "s": 13,
          "text": "דבאצילות,"
        },
        {
          "s": 14,
          "text": "להיות שהע\"ס הם מחולקים זמ\"ז,"
        },
        {
          "s": 15,
          "text": "הרי ההגבלה דאצילות היא בחי' גילוי"
        },
        {
          "s": 16,
          "text": "(ואינה אמיתית ענין דהגבלה),"
        },
        {
          "s": 17,
          "text": "משא\"כ כאשר ל' כלים דאצילות נעשים נר\"נ לבי\"ע,"
        },
        {
          "s": 18,
          "text": "שבכל עולם נמשכים כל היו\"ד ספירות באופן של העלם כנ\"ל,"
        },
        {
          "s": 19,
          "text": "הנה זהו אמיתית ענין ההגבלה."
        },
        {
          "s": 20,
          "text": "ולכן מקשה מעתה יש להבין איך יוכל להיות התהוות בע\"ג מאור א\"ס שהוא בלתי בע\"ג."
        },
        {
          "s": 21,
          "text": "ועל זה מתרץ,"
        },
        {
          "s": 22,
          "text": "שזהו מצד עצמות אוא\"ס שנמצא למטה כמו למעלה בשוה ממש,"
        },
        {
          "s": 23,
          "text": "והיינו שדוקא בההגבלה דבי\"ע,"
        },
        {
          "s": 24,
          "text": "בחי' העלם שלמטה מבחי' גילוי,"
        },
        {
          "s": 25,
          "text": "מתבטא בחי' העלם העצמי שלמעלה מהגדרים דהעלם וגילוי."
        },
        {
          "s": 26,
          "text": "וכידוע26"
        },
        {
          "s": 27,
          "text": "שיש הנברא הוא בחי' יש האמיתי."
        },
        {
          "s": 28,
          "text": "וזהו ג\"כ מה שמסיים בהמאמר27"
        },
        {
          "s": 29,
          "text": "בענין מרום וקדוש אשכון את דכא ושפל רוח דוקא28."
        },
        {
          "s": 30,
          "text": "ואח\"כ מבאר שההגבלה וההעלם שלמטה,"
        },
        {
          "s": 31,
          "text": "שהוא בבחי' העדר ההתחלקות,"
        },
        {
          "s": 32,
          "text": "היא דוגמת בחי' עקודים בכלי אחד,"
        },
        {
          "s": 33,
          "text": "בחי' מקיף הכללי שלמעלה מהתחלקות."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ובזה29 יובן ג\"כ מה שאמרו כל העוסק בתורה לשמה כו',"
        },
        {
          "s": 2,
          "text": "דלכאורה הרי עסק התורה לשמה היא מדריגה נעלית,"
        },
        {
          "s": 3,
          "text": "והרי תורה על הרוב תדבר30,"
        },
        {
          "s": 4,
          "text": "ואיך שייך ענין העסק בתורה לשמה אצל אלו שהם במדריגה נמוכה,"
        },
        {
          "s": 5,
          "text": "אך הענין הוא,"
        },
        {
          "s": 6,
          "text": "דלהיות שעסק התורה לשמה הו\"ע המשכת בחי' העלם העצמי,"
        },
        {
          "s": 7,
          "text": "הנה בזה כולם שוין,"
        },
        {
          "s": 8,
          "text": "אף שיש בזה חילוקים בענין ההתגלות."
        },
        {
          "s": 9,
          "text": "וע\"ד המבואר בתו\"א31"
        },
        {
          "s": 10,
          "text": "שישנו מי שדי לו בפ\"א שחרית ופ\"א ערבית,"
        },
        {
          "s": 11,
          "text": "ויש מי שצריך לקיים והגית בו יומם ולילה כפשוטו,"
        },
        {
          "s": 12,
          "text": "שההפרש הוא רק בענין ההתגלות כו'."
        },
        {
          "s": 13,
          "text": "ועד שכהסיום בתו\"א שם בהחצע\"ג שסו\"ס נמשך גם בגילוי"
        },
        {
          "s": 14,
          "text": "(כבהברכה הנ\"ל)"
        },
        {
          "s": 15,
          "text": "דישלים לו הקב\"ה כו'."
        }
      ]
    }
  ]
}