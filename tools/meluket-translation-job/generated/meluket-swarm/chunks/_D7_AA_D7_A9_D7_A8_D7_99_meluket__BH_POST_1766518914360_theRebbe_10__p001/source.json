{
  "globalIndex": 111,
  "owner": 11,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914360_theRebbe_10__p001",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914360_theRebbe_10__p001",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914360_theRebbe_10",
  "title": "מאמר וחג האסיף תשמ\"ג",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "אור לי\"ג תשרי"
        },
        {
          "s": 2,
          "text": "(הילולא דאדמו\"ר מהר\"ש נ\"ע),"
        },
        {
          "s": 3,
          "text": "ה'תשמ\"ג"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "וחג האסיף גו' באספך את מעשיך מן השדה1,"
        },
        {
          "s": 1,
          "text": "ומבאר בעל ההילולא2,"
        },
        {
          "s": 2,
          "text": "דמה שהרגלים נקבעו בזמני התבואה,"
        },
        {
          "s": 3,
          "text": "המכוון הוא"
        },
        {
          "s": 4,
          "text": "(בעיקר)"
        },
        {
          "s": 5,
          "text": "לתבואה ברוחניות3."
        },
        {
          "s": 6,
          "text": "וזהו מה שנקבע חג הסוכות בזמן אסיפת התבואה,"
        },
        {
          "s": 7,
          "text": "ועד שנקרא בשם חג האסיף4,"
        },
        {
          "s": 8,
          "text": "מפני שענינו של חג הסוכות קשור ובא לאחרי העבודה דאסיפת התבואה"
        },
        {
          "s": 9,
          "text": "(ואספת5"
        },
        {
          "s": 10,
          "text": "דגנך ותירושך ויצהרך6)"
        },
        {
          "s": 11,
          "text": "ברוחניות."
        },
        {
          "s": 12,
          "text": "וכמו שאסיפת התבואה כפשוטה בגשמיות היא לפני כניסת החג,"
        },
        {
          "s": 13,
          "text": "דביו\"ט מי שרי7,"
        },
        {
          "s": 14,
          "text": "כ\"ה גם ברוחניות,"
        },
        {
          "s": 15,
          "text": "שלאחרי העבודה דבאספכם את תבואת הארץ"
        },
        {
          "s": 16,
          "text": "(הנה אז)"
        },
        {
          "s": 17,
          "text": "תחוגו את חג ה' שבעת ימים8."
        },
        {
          "s": 18,
          "text": "וצריך להבין השייכות דחג הסוכות,"
        },
        {
          "s": 19,
          "text": "דשמו"
        },
        {
          "s": 20,
          "text": "(חג הסוכות)"
        },
        {
          "s": 21,
          "text": "הוא על שם בסוכות9"
        },
        {
          "s": 22,
          "text": "תשבו שבעת ימים10,"
        },
        {
          "s": 23,
          "text": "לבאספכם את תבואת הארץ."
        },
        {
          "s": 24,
          "text": "וגם צריך להבין"
        },
        {
          "s": 25,
          "text": "(כהדיוק בכמה דרושים11)"
        },
        {
          "s": 26,
          "text": "מ\"ש9"
        },
        {
          "s": 27,
          "text": "בסוכות תשבו שבעת ימים כל האזרח בישראל ישבו בסוכות,"
        },
        {
          "s": 28,
          "text": "דלכאורה,"
        },
        {
          "s": 29,
          "text": "הרי הציווי בסוכות תשבו גו' הוא לכללות ישראל ולכל אחד מישראל,"
        },
        {
          "s": 30,
          "text": "ומה מוסיף במ\"ש כל האזרח בישראל ישבו בסוכות."
        },
        {
          "s": 31,
          "text": "וגם צריך להבין12"
        },
        {
          "s": 32,
          "text": "מה שבהציווי בסוכות תשבו אומר תשבו שבעת ימים משא\"כ בהציווי כל האזרח גו' אומר ישבו סתם"
        },
        {
          "s": 33,
          "text": "(ואינו אומר שבעת ימים)."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "והנה בהמשך לתחוגו את חג ה' שבעת ימים ממשיך הכתוב13"
        },
        {
          "s": 1,
          "text": "ולקחתם לכם ביום הראשון פרי עץ הדר כפות תמרים וענף עץ עבות וערבי נחל גו',"
        },
        {
          "s": 2,
          "text": "שגם מצוה זו קשורה עם חג האסיף14,"
        },
        {
          "s": 3,
          "text": "דזמנה של מצוה זו הוא דוקא ביום הראשון,"
        },
        {
          "s": 4,
          "text": "ביום הראשון של החג שמצד באספכם גו'."
        },
        {
          "s": 5,
          "text": "ועם היות שמצות נטילת ד' מינים אינה קשורה כ\"כ עם עצם החג כהמצוה דישיבה בסוכה15"
        },
        {
          "s": 6,
          "text": "[וכמובן גם מזה שהחיוב דמצות ישיבה בסוכה הוא בכל שבעת ימי החג"
        },
        {
          "s": 7,
          "text": "(בסוכות תשבו שבעת ימים),"
        },
        {
          "s": 8,
          "text": "משקידש החג,"
        },
        {
          "s": 9,
          "text": "משא\"כ החיוב דמצות נטילת ד' מינים מתחיל בבוקר"
        },
        {
          "s": 10,
          "text": "(בעלות השחר,"
        },
        {
          "s": 11,
          "text": "ולכתחילה מנץ החמה16)"
        },
        {
          "s": 12,
          "text": "וביום הראשון17],"
        },
        {
          "s": 13,
          "text": "מ\"מ,"
        },
        {
          "s": 14,
          "text": "הרי גם מצוה זו קשורה"
        },
        {
          "s": 15,
          "text": "(כנ\"ל)"
        },
        {
          "s": 16,
          "text": "עם יום הראשון דחג האסיף."
        }
      ]
    }
  ]
}