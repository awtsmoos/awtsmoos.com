{
  "globalIndex": 229,
  "owner": 29,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915147_theRebbe_734__p001",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915147_theRebbe_734__p001",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518915147_theRebbe_734",
  "title": "מאמר ויתן לך תשכ\"ח",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ תולדות,"
        },
        {
          "s": 2,
          "text": "מבה\"ח וער\"ח כסלו,"
        },
        {
          "s": 3,
          "text": "ה'תשכ\"ח"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "ויתן לך האלקים מטל השמים ומשמני הארץ וגו'1,"
        },
        {
          "s": 1,
          "text": "וידוע הדיוק בזה2,"
        },
        {
          "s": 2,
          "text": "הרי כל הברכות הם משם הוי',"
        },
        {
          "s": 3,
          "text": "דשם אלקים הוא מדת הדין והצמצום והברכות שענינם הוא המשכה והשפעה הם משם הוי',"
        },
        {
          "s": 4,
          "text": "וכמו ברכת כהנים שבכל ג' הפסוקים3"
        },
        {
          "s": 5,
          "text": "נזכר שם הוי',"
        },
        {
          "s": 6,
          "text": "ובברכה זו אומר ויתן לך האלקים."
        },
        {
          "s": 7,
          "text": "ויש להוסיף,"
        },
        {
          "s": 8,
          "text": "שדיוק זה"
        },
        {
          "s": 9,
          "text": "(שגבי ברכה נזכר שם אלקים)"
        },
        {
          "s": 10,
          "text": "הוא גם בברכה הראשונה שנתברך יצחק אחרי מות אברהם דכתיב בה4"
        },
        {
          "s": 11,
          "text": "ויברך אלקים את יצחק בנו."
        },
        {
          "s": 12,
          "text": "דבכל הברכות שברך הקב\"ה את אברהם5"
        },
        {
          "s": 13,
          "text": "[וגם בהברכות שברך את יצחק שלאח\"ז6]"
        },
        {
          "s": 14,
          "text": "נאמר שם הוי',"
        },
        {
          "s": 15,
          "text": "ומזה משמע,"
        },
        {
          "s": 16,
          "text": "דברכה הראשונה שברך את יצחק שנאמר בה ויברך אלקים והברכה שברך יצחק ויתן לך האלקים שייכות זל\"ז."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויש לומר נקודת הביאור בזה ע\"פ המבואר בסידור"
        },
        {
          "s": 2,
          "text": "(עם דא\"ח)"
        },
        {
          "s": 3,
          "text": "שער התקיעות7,"
        },
        {
          "s": 4,
          "text": "שההשפעה הנמשכת מהגבורות היא גדולה יותר מההשפעה הנמשכת מהחסדים."
        },
        {
          "s": 5,
          "text": "כי חסדים הם בטבע הקרירות ולכן ההשפעה מהם היא בהגבלה,"
        },
        {
          "s": 6,
          "text": "משא\"כ הגבורות שהם בחמימות,"
        },
        {
          "s": 7,
          "text": "ההשפעה מהם היא באופן של תגבורת,"
        },
        {
          "s": 8,
          "text": "ועד לריבוי בלי גבול."
        },
        {
          "s": 9,
          "text": "ועפ\"ז מבאר שם שדוקא יצחק ברך ברכות נעלות כאלו"
        },
        {
          "s": 10,
          "text": "(מטל השמים ומשמני הארץ וגו'),"
        },
        {
          "s": 11,
          "text": "שלא מצינו ברכות כאלה לא באברהם ולא ביעקב,"
        },
        {
          "s": 12,
          "text": "כי יצחק הוא גבורה8,"
        },
        {
          "s": 13,
          "text": "ולכן הברכות דיצחק הם בריבוי גדול."
        },
        {
          "s": 14,
          "text": "ועפ\"ז יש לומר פירוש הכתוב4"
        },
        {
          "s": 15,
          "text": "ויהי אחרי מות אברהם ויברך אלקים את יצחק בנו,"
        },
        {
          "s": 16,
          "text": "דבחיי אברהם"
        },
        {
          "s": 17,
          "text": "(בחינת חסד8)"
        },
        {
          "s": 18,
          "text": "האיר בחינת החסד דלמעלה,"
        },
        {
          "s": 19,
          "text": "ולאחרי מות אברהם,"
        },
        {
          "s": 20,
          "text": "שאז היתה ההנהגה"
        },
        {
          "s": 21,
          "text": "(כולל ההנהגה דלמעלה)"
        },
        {
          "s": 22,
          "text": "ע\"פ מדתו של יצחק,"
        },
        {
          "s": 23,
          "text": "גבורה,"
        },
        {
          "s": 24,
          "text": "נמשכו הברכות מהגבורות דשם אלקים9"
        },
        {
          "s": 25,
          "text": "שהם ברכות נעלות יותר מהברכות הנמשכות מהחסדים."
        },
        {
          "s": 26,
          "text": "וזהו גם שבברכת יצחק ליעקב כתיב ויתן לך האלקים,"
        },
        {
          "s": 27,
          "text": "שההשפעה תהי' בריבוי ובתגבורת."
        }
      ]
    }
  ]
}