{
  "globalIndex": 648,
  "owner": 48,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917575_theRebbe_481__p001",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917575_theRebbe_481__p001",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917575_theRebbe_481",
  "title": "מאמר אלה פקודי תש\"ל",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ פקודי,"
        },
        {
          "s": 2,
          "text": "וא\"ו אדר שני,"
        },
        {
          "s": 3,
          "text": "ה'תש\"ל"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "אלה פקודי המשכן משכן העדות אשר פוקד על פי משה גו'1,"
        },
        {
          "s": 1,
          "text": "וידוע הדיוק מ\"ש המשכן משכן ב' פעמים2."
        },
        {
          "s": 2,
          "text": "גם צריך להבין,"
        },
        {
          "s": 3,
          "text": "שבמשכן הא' נאמר משכן סתם ובמשכן הב' נאמר משכן העדות3."
        },
        {
          "s": 4,
          "text": "גם צריך להבין מ\"ש אשר פוקד על פי משה,"
        },
        {
          "s": 5,
          "text": "דשני פירושים בזה."
        },
        {
          "s": 6,
          "text": "שקאי אדסמיך לי',"
        },
        {
          "s": 7,
          "text": "על משכן העדות4."
        },
        {
          "s": 8,
          "text": "ולכן נאמר פוקד לשון יחיד,"
        },
        {
          "s": 9,
          "text": "כי רק משכן אחד פוקד על פי משה,"
        },
        {
          "s": 10,
          "text": "בחינת משכן העדות."
        },
        {
          "s": 11,
          "text": "ועוד פירוש,"
        },
        {
          "s": 12,
          "text": "שאשר פוקד על פי משה קאי על כללות המשכן,"
        },
        {
          "s": 13,
          "text": "גם על בחינת משכן סתם."
        },
        {
          "s": 14,
          "text": "ואדרבה,"
        },
        {
          "s": 15,
          "text": "הפירוש הפשוט"
        },
        {
          "s": 16,
          "text": "(דאין מקרא יוצא מפשוטו5)"
        },
        {
          "s": 17,
          "text": "באשר פוקד על פי משה הוא שקאי על אלה פקודי המשכן"
        },
        {
          "s": 18,
          "text": "(שבתחלה אומר פקודי סתם ואח\"כ מפרש שזה הי' על פי משה)."
        },
        {
          "s": 19,
          "text": "וצריך להבין הקשר דשני הפירושים."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ונקודת הביאור בזה הוא,"
        },
        {
          "s": 2,
          "text": "כדאיתא בלקו\"ת6,"
        },
        {
          "s": 3,
          "text": "דענין המשכן הוא השראת השכינה כמ\"ש7"
        },
        {
          "s": 4,
          "text": "ועשו לי מקדש ושכנתי בתוכם,"
        },
        {
          "s": 5,
          "text": "ושני הענינים שבמשכן"
        },
        {
          "s": 6,
          "text": "[משכן סתם ומשכן העדות]"
        },
        {
          "s": 7,
          "text": "הם ב' דרגות בשכינה,"
        },
        {
          "s": 8,
          "text": "שכינתא תתאה ושכינתא עילאה8."
        },
        {
          "s": 9,
          "text": "וע\"פ הידוע שכל אחד מישראל הוא משכן ומקדש לו ית'"
        },
        {
          "s": 10,
          "text": "[כמארז\"ל9"
        },
        {
          "s": 11,
          "text": "עה\"פ7"
        },
        {
          "s": 12,
          "text": "ועשו לי מקדש ושכנתי בתוכם,"
        },
        {
          "s": 13,
          "text": "בתוכו לא נאמר אלא בתוכם,"
        },
        {
          "s": 14,
          "text": "בתוך כל אחד ואחד מישראל],"
        },
        {
          "s": 15,
          "text": "מובן,"
        },
        {
          "s": 16,
          "text": "דשני הענינים שבמשכן"
        },
        {
          "s": 17,
          "text": "[משכן סתם ומשכן העדות]"
        },
        {
          "s": 18,
          "text": "הם גם בהמשכן דישראל."
        },
        {
          "s": 19,
          "text": "וע\"פ מאמר רז\"ל10"
        },
        {
          "s": 20,
          "text": "עה\"פ משכן העדות,"
        },
        {
          "s": 21,
          "text": "עדות היא לכל באי עולם שהקב\"ה נתרצה לישראל,"
        },
        {
          "s": 22,
          "text": "יש לומר,"
        },
        {
          "s": 23,
          "text": "דזה שישראל הם משכן"
        },
        {
          "s": 24,
          "text": "(סתם)"
        },
        {
          "s": 25,
          "text": "הוא ע\"י העבודה דתומ\"צ,"
        },
        {
          "s": 26,
          "text": "וזה שהם משכן העדות הוא ע\"י עבודת התשובה."
        },
        {
          "s": 27,
          "text": "ויש לקשר זה עם המובא לעיל מלקו\"ת דמשכן סתם ומשכן העדות הם שכינתא תתאה ושכינתא עילאה,"
        },
        {
          "s": 28,
          "text": "כי שכינתא תתאה היא מלכות ושכינתא עילאה היא בינה11,"
        },
        {
          "s": 29,
          "text": "ועד\"ז הוא החילוק בין העבודה דתומ\"צ להעבודה דתשובה,"
        },
        {
          "s": 30,
          "text": "שקיום המצוות,"
        },
        {
          "s": 31,
          "text": "מצוות המלך,"
        },
        {
          "s": 32,
          "text": "הוא במלכות12,"
        },
        {
          "s": 33,
          "text": "ותשובה היא בבינה13."
        },
        {
          "s": 34,
          "text": "גם יש לומר,"
        },
        {
          "s": 35,
          "text": "דכיון שהמשכן"
        },
        {
          "s": 36,
          "text": "(כללות המשכן)"
        },
        {
          "s": 37,
          "text": "הי' כפרה על חטא העגל14,"
        },
        {
          "s": 38,
          "text": "לכן,"
        },
        {
          "s": 39,
          "text": "גם במשכן סתם נכללת גם עבודת התשובה,"
        },
        {
          "s": 40,
          "text": "והחילוק בין משכן סתם למשכן העדות הוא,"
        },
        {
          "s": 41,
          "text": "שמשכן סתם הוא תשובה תתאה ומשכן העדות הוא תשובה עילאה."
        },
        {
          "s": 42,
          "text": "וזה מתאים עוד יותר עם המובא לעיל מלקו\"ת שמשכן סתם ומשכן העדות הם שכינתא תתאה"
        },
        {
          "s": 43,
          "text": "(מלכות)"
        },
        {
          "s": 44,
          "text": "ושכינתא עילאה"
        },
        {
          "s": 45,
          "text": "(בינה),"
        },
        {
          "s": 46,
          "text": "כי תשובה תתאה היא תשוב ה' תתאה"
        },
        {
          "s": 47,
          "text": "(מלכות)"
        },
        {
          "s": 48,
          "text": "ותשובה עילאה היא תשוב ה' עילאה"
        },
        {
          "s": 49,
          "text": "(בינה)15."
        },
        {
          "s": 50,
          "text": "וע\"פ הדיעה16"
        },
        {
          "s": 51,
          "text": "שהציווי ועשו לי מקדש וגם נדבת המשכן היו קודם חטא העגל,"
        },
        {
          "s": 52,
          "text": "שאז היו כל ישראל במדריגת צדיקים,"
        },
        {
          "s": 53,
          "text": "יש לומר,"
        },
        {
          "s": 54,
          "text": "דשתי הבחינות שבמשכן"
        },
        {
          "s": 55,
          "text": "(משכן סתם ומשכן העדות)"
        },
        {
          "s": 56,
          "text": "הם שתי בחינות בעבודת הצדיקים."
        },
        {
          "s": 57,
          "text": "וכמבואר בלקו\"ת17,"
        },
        {
          "s": 58,
          "text": "דזה שישראל הם משכן סתם הוא ע\"י קיום מ\"ע וזה שהם משכן העדות הוא ע\"י קיום מל\"ת."
        },
        {
          "s": 59,
          "text": "ואולי יש לומר,"
        },
        {
          "s": 60,
          "text": "ששני הענינים דמשכן בעבודת הצדיקים הם גם בהעבודה דכחות הפנימיים."
        },
        {
          "s": 61,
          "text": "משכן סתם הוא עבודת הלב,"
        },
        {
          "s": 62,
          "text": "ומשכן העדות הוא עבודת המוח."
        },
        {
          "s": 63,
          "text": "ויש לקשר זה עם המבואר בלקו\"ת ששני הענינים דמשכן הם מ\"ע ומל\"ת,"
        },
        {
          "s": 64,
          "text": "כי מ\"ע הם בו\"ה – מדות"
        },
        {
          "s": 65,
          "text": "(וא\"ו ז\"א,"
        },
        {
          "s": 66,
          "text": "וה\"א אחרונה – מלכות18),"
        },
        {
          "s": 67,
          "text": "ומל\"ת הם בי\"ה – מוחין"
        },
        {
          "s": 68,
          "text": "(יו\"ד – חכמה,"
        },
        {
          "s": 69,
          "text": "ה\"א – בינה18)."
        }
      ]
    }
  ]
}