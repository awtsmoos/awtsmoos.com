{
  "globalIndex": 989,
  "owner": 39,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919663_theRebbe_89__p002",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919663_theRebbe_89__p002",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919663_theRebbe_89",
  "title": "מאמר ציון במשפט תפדה תשל\"ה",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה מבואר בהדרושים ד\"ה ציון במשפט תפדה ושבי' בצדקה"
        },
        {
          "s": 2,
          "text": "(לכ\"ק אדמו\"ר הזקן ורבותינו נשיאינו ממלאי מקומו8),"
        },
        {
          "s": 3,
          "text": "שבפסוק זה מדובר ע\"ד שתי בחי'."
        },
        {
          "s": 4,
          "text": "ציון,"
        },
        {
          "s": 5,
          "text": "שבחי' ציון עם היותה בגלות שלכן צריכה פדי',"
        },
        {
          "s": 6,
          "text": "מ\"מ אינה בבחי' שבי',"
        },
        {
          "s": 7,
          "text": "ולכן פדייתה מהגלות הוא במשפט."
        },
        {
          "s": 8,
          "text": "ובחי' ושבי',"
        },
        {
          "s": 9,
          "text": "שהם שבויים ממש,"
        },
        {
          "s": 10,
          "text": "ופדייתם מהשבי' הוא בצדקה דוקא."
        },
        {
          "s": 11,
          "text": "וביאור הענין דשתי בחי' אלו באדם,"
        },
        {
          "s": 12,
          "text": "היינו בהנשמה שהיא עיקר האדם"
        },
        {
          "s": 13,
          "text": "(כדאיתא בתניא פל\"ב),"
        },
        {
          "s": 14,
          "text": "דאתם קרויים אדם9"
        },
        {
          "s": 15,
          "text": "על שם אדמה לעליון10,"
        },
        {
          "s": 16,
          "text": "הנה הנשמה11"
        },
        {
          "s": 17,
          "text": "ישנה כפי שהיא למעלה מהתלבשות בגוף,"
        },
        {
          "s": 18,
          "text": "עצם הנשמה,"
        },
        {
          "s": 19,
          "text": "פנימיות הלב וכו',"
        },
        {
          "s": 20,
          "text": "וחלק הנשמה המתלבש בגוף,"
        },
        {
          "s": 21,
          "text": "שבכללות הם כחות הגלויים של הנשמה שהם בבחי' התלבשות,"
        },
        {
          "s": 22,
          "text": "הנקרא רגל שבנשמה."
        },
        {
          "s": 23,
          "text": "וע\"ז נאמר ציון במשפט תפדה ושבי' בצדקה,"
        },
        {
          "s": 24,
          "text": "ציון קאי על עצם הנשמה בחי' פנימיות הלב,"
        },
        {
          "s": 25,
          "text": "ובבחי' זו אין שייך ענין השבי' והשעבוד בלעו\"ז ח\"ו,"
        },
        {
          "s": 26,
          "text": "ורק ענין הגלות."
        },
        {
          "s": 27,
          "text": "משא\"כ בכחות הנשמה שבבחי' התלבשות בגוף שייך ענין השבי',"
        },
        {
          "s": 28,
          "text": "וע\"ז אומר ושבי' בצדקה,"
        },
        {
          "s": 29,
          "text": "שגם כחות הנשמה"
        },
        {
          "s": 30,
          "text": "(שבבחי' התלבשות בגוף)"
        },
        {
          "s": 31,
          "text": "שהם שבויים ממש בלעו\"ז,"
        },
        {
          "s": 32,
          "text": "יפדו ע\"י הצדקה."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ולבאר הענין דבחי' פנימיות הלב"
        },
        {
          "s": 2,
          "text": "(הנקראת בשם ציון),"
        },
        {
          "s": 3,
          "text": "מביא בדרושים הנ\"ל12"
        },
        {
          "s": 4,
          "text": "מ\"ש13"
        },
        {
          "s": 5,
          "text": "והיו הדברים האלה אשר אנכי מצוך היום וארז\"ל14"
        },
        {
          "s": 6,
          "text": "בכל יום יהיו בעיניך כחדשים."
        },
        {
          "s": 7,
          "text": "דצריך להבין איך אפשר להיות כן"
        },
        {
          "s": 8,
          "text": "[שהרי זה דבכל יום יהיו בעיניך כחדשים צ\"ל"
        },
        {
          "s": 9,
          "text": "(ככל הענינים שבתורת אמת)"
        },
        {
          "s": 10,
          "text": "באמת15,"
        },
        {
          "s": 11,
          "text": "ומכיון שאין הקב\"ה מבקש אלא לפי כחן16,"
        },
        {
          "s": 12,
          "text": "הרי מוכח שבכחו של האדם הוא להגיע לזה,"
        },
        {
          "s": 13,
          "text": "ולכאורה מכיון שהאדם הוא מוגבל ובעל שינויים,"
        },
        {
          "s": 14,
          "text": "איך יכול לבוא לזה שבכ\"י יהיו בעיניו כחדשים]."
        },
        {
          "s": 15,
          "text": "והביאור בזה"
        },
        {
          "s": 16,
          "text": "(כמובן מדרושים הנ\"ל),"
        },
        {
          "s": 17,
          "text": "שזהו מצד בחי' פנימיות הלב שהיא למעלה מענין השינויים17,"
        },
        {
          "s": 18,
          "text": "ולכן,"
        },
        {
          "s": 19,
          "text": "כאשר פנימיות הלב היא כדבעי"
        },
        {
          "s": 20,
          "text": "(היינו שהיא בגילוי),"
        },
        {
          "s": 21,
          "text": "פועלת היא גם על כחות הנשמה שבהתלבשות בגוף,"
        },
        {
          "s": 22,
          "text": "וגם על לבושי הנשמה מחשבה דיבור ומעשה,"
        },
        {
          "s": 23,
          "text": "שגם בהם יהיו ד\"ת כחדשים,"
        },
        {
          "s": 24,
          "text": "כי ע\"י הגילוי דבחי' פנימיות הלב,"
        },
        {
          "s": 25,
          "text": "גם כחות הגלויים של הנשמה הם בשלימותן."
        },
        {
          "s": 26,
          "text": "וזהו מה שישראל נקראים"
        },
        {
          "s": 27,
          "text": "(בפסוק זה)"
        },
        {
          "s": 28,
          "text": "בשם ציון"
        },
        {
          "s": 29,
          "text": "[כמ\"ש אדמו\"ר הצ\"צ18"
        },
        {
          "s": 30,
          "text": "שהפירוש"
        },
        {
          "s": 31,
          "text": "(דבציון במשפט תפדה)"
        },
        {
          "s": 32,
          "text": "דציון קאי על העיר"
        },
        {
          "s": 33,
          "text": "(או על כללות א\"י)"
        },
        {
          "s": 34,
          "text": "הוא דוחק קצת."
        },
        {
          "s": 35,
          "text": "ומפרש שציון קאי על עם ישראל],"
        },
        {
          "s": 36,
          "text": "כי ציון הוא לשון סימן,"
        },
        {
          "s": 37,
          "text": "וכאשר מאיר באדם"
        },
        {
          "s": 38,
          "text": "(גילוי ד)"
        },
        {
          "s": 39,
          "text": "בחי' פנימיות הלב,"
        },
        {
          "s": 40,
          "text": "אז הוא בבחי' ציון לשון סימן,"
        },
        {
          "s": 41,
          "text": "(אנא סימנא בעלמא19)"
        },
        {
          "s": 42,
          "text": "שכל מציאותו הוא רק סימן דהענינים שלמעלה."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה פירוש הנ\"ל"
        },
        {
          "s": 2,
          "text": "(של הצ\"צ)"
        },
        {
          "s": 3,
          "text": "שציון קאי על עם ישראל,"
        },
        {
          "s": 4,
          "text": "מובן שם שהוא ע\"פ מאמר הירושלמי20"
        },
        {
          "s": 5,
          "text": "ע\"פ21"
        },
        {
          "s": 6,
          "text": "ואשים דברי בפיך ובצל ידי כסיתיך לנטוע שמים וליסוד ארץ ולאמר לציון עמי אתה,"
        },
        {
          "s": 7,
          "text": "חזרנו על כל המקרא ולא מצאנו שנקראו ישראל ציון אלא זה"
        },
        {
          "s": 8,
          "text": "(שנאמר)"
        },
        {
          "s": 9,
          "text": "ולאמר לציון עמי אתה."
        },
        {
          "s": 10,
          "text": "ומבאר כ\"ק אדמו\"ר הצ\"צ22,"
        },
        {
          "s": 11,
          "text": "שע\"י ג' הדברים שבפסוק זה"
        },
        {
          "s": 12,
          "text": "(לפי פירוש הירושלמי שם)"
        },
        {
          "s": 13,
          "text": "ואשים דברי בפיך זו תורה"
        },
        {
          "s": 14,
          "text": "[דבר הוי' זו הלכה23"
        },
        {
          "s": 15,
          "text": "דהיינו תורה24],"
        },
        {
          "s": 16,
          "text": "ובצל ידי כסיתיך זו גמ\"ח"
        },
        {
          "s": 17,
          "text": "[שהוא כללות כל המצוות25,"
        },
        {
          "s": 18,
          "text": "והמצוות הם בחי' לבושים26,"
        },
        {
          "s": 19,
          "text": "כסיתיך27],"
        },
        {
          "s": 20,
          "text": "לנטוע שמים וליסוד ארץ אלו הקרבנות"
        },
        {
          "s": 21,
          "text": "[כי ע\"י הקרבנות מתקיימים חוקות שמים וארץ28."
        },
        {
          "s": 22,
          "text": "וע\"י הקרבנות"
        },
        {
          "s": 23,
          "text": "(ותפלה)"
        },
        {
          "s": 24,
          "text": "נעשה יחוד זו\"נ הנק' שמים וארץ29],"
        },
        {
          "s": 25,
          "text": "ע\"י קיום ג' דברים אלו ישראל הם בבחי' ציון."
        },
        {
          "s": 26,
          "text": "והיינו,"
        },
        {
          "s": 27,
          "text": "דכאשר ג' דברים אלו הם בשלימות"
        },
        {
          "s": 28,
          "text": "(וכפי שהם נרמזים בפסוק זה),"
        },
        {
          "s": 29,
          "text": "שלימוד התורה הוא בתכלית הביטול עד שאין הדיבור בא מצד עצמו אלא שנדבר בו דבר הוי' וע\"ד שכינה מדברת מתוך גרונו"
        },
        {
          "s": 30,
          "text": "(של משה)30,"
        },
        {
          "s": 31,
          "text": "דזהו ואשים דברי בפיך שדבר ה' הוא המדבר בפיו31,"
        },
        {
          "s": 32,
          "text": "וכן קיום המצוות שלו הוא בבחי' ביטול,"
        },
        {
          "s": 33,
          "text": "שמציאותו אינה נרגשת כ\"א הוא מכוסה"
        },
        {
          "s": 34,
          "text": "(כסיתיך)"
        },
        {
          "s": 35,
          "text": "בצל ידי"
        },
        {
          "s": 36,
          "text": "(ידו של הקב\"ה)"
        },
        {
          "s": 37,
          "text": "היינו בחי' המצוות כמו שהם מצוות הוי'32."
        },
        {
          "s": 38,
          "text": "ועאכו\"כ שכן הוא בקו העבודה,"
        },
        {
          "s": 39,
          "text": "שעבודתו היא לנטוע שמים וליסוד ארץ33."
        },
        {
          "s": 40,
          "text": "(וע\"ד דאיתא בזהר34"
        },
        {
          "s": 41,
          "text": "שע\"י שמשתדל במילי דאורייתא אתעביד מההוא מלה שמים חדשים וארץ חדשה,"
        },
        {
          "s": 42,
          "text": "והיינו שדיבור התורה שלו הוא דוגמת דיבורו של הקב\"ה,"
        },
        {
          "s": 43,
          "text": "מה אנא במלולא דילי עבדית שמים וארץ כו' אוף הכי את)."
        },
        {
          "s": 44,
          "text": "הנה ע\"י קיום ג' דברים הנ\"ל באופן כזה,"
        },
        {
          "s": 45,
          "text": "נקראים כנס\"י בשם ציון,"
        },
        {
          "s": 46,
          "text": "שאינם בבחי' מציאות בפ\"ע כ\"א מציאותם היא שהם סימן דהענינים שלמעלה."
        }
      ]
    }
  ]
}