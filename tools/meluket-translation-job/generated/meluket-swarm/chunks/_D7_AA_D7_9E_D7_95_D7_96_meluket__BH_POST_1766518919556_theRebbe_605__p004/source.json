{
  "globalIndex": 978,
  "owner": 28,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919556_theRebbe_605__p004",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919556_theRebbe_605__p004",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919556_theRebbe_605",
  "title": "מאמר אלה מסעי תשי\"ג",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "וביאור הענין,"
        },
        {
          "s": 2,
          "text": "דהנה,"
        },
        {
          "s": 3,
          "text": "כשם שיש בחי' מ\"ה בקדושה כמו\"כ יש בחי' מ\"ה בלעו\"ז,"
        },
        {
          "s": 4,
          "text": "והוא ענין ופלגשו ושמה ראומה58,"
        },
        {
          "s": 5,
          "text": "ראו מ\"ה59."
        },
        {
          "s": 6,
          "text": "והענין בזה,"
        },
        {
          "s": 7,
          "text": "דהנה,"
        },
        {
          "s": 8,
          "text": "האפשרות לענינים דלעו\"ז היא מפני שיש להם נתינת מקום בקדושה,"
        },
        {
          "s": 9,
          "text": "וכמו שרואים בעבודה בנפש,"
        },
        {
          "s": 10,
          "text": "דכאשר עובד עבודתו בביטול,"
        },
        {
          "s": 11,
          "text": "אבל באופן שמרגיש את הביטול,"
        },
        {
          "s": 12,
          "text": "הרי זה נתינת מקום שיבוא מזה לבחי' ישות,"
        },
        {
          "s": 13,
          "text": "והיינו,"
        },
        {
          "s": 14,
          "text": "שתחילה יהי' הביטול באופן של ישות,"
        },
        {
          "s": 15,
          "text": "שזהו\"ע קליפת ראומה,"
        },
        {
          "s": 16,
          "text": "ראו מ\"ה,"
        },
        {
          "s": 17,
          "text": "ואח\"כ יבוא לישות לגמרי,"
        },
        {
          "s": 18,
          "text": "שהוא רע גמור."
        },
        {
          "s": 19,
          "text": "וכמו\"כ הוא גם בהשתלשלות העולמות,"
        },
        {
          "s": 20,
          "text": "דע\"י קליפת ראו מה שהיא כנגד עולם האצילות,"
        },
        {
          "s": 21,
          "text": "הנה בריבוי השתלשלות מסתעף מזה רע גמור,"
        },
        {
          "s": 22,
          "text": "בחי' מ\"ה דלעו\"ז."
        },
        {
          "s": 23,
          "text": "ועז\"נ60"
        },
        {
          "s": 24,
          "text": "שופך61"
        },
        {
          "s": 25,
          "text": "דם האדם באדם,"
        },
        {
          "s": 26,
          "text": "דאדם בגימטריא מ\"ה,"
        },
        {
          "s": 27,
          "text": "הנה ע\"י העוונות הוא שופך דם האדם דקדושה,"
        },
        {
          "s": 28,
          "text": "בחי' מ\"ה דקדושה,"
        },
        {
          "s": 29,
          "text": "באדם בליעל,"
        },
        {
          "s": 30,
          "text": "שהוא בחי' מ\"ה דלעו\"ז."
        },
        {
          "s": 31,
          "text": "והענין בזה,"
        },
        {
          "s": 32,
          "text": "דהנה,"
        },
        {
          "s": 33,
          "text": "רמ\"ח מ\"ע ושס\"ה מל\"ת הם כנגד רמ\"ח אברים ושס\"ה גידים62,"
        },
        {
          "s": 34,
          "text": "דענין האברים הוא שהם ממשיכים את החיות,"
        },
        {
          "s": 35,
          "text": "ומגבילים את החיות שלא יומשך לחוץ,"
        },
        {
          "s": 36,
          "text": "וכאשר חותכים את האבר אזי נמשך החיות לחוץ,"
        },
        {
          "s": 37,
          "text": "ועד\"ז בנוגע לגידים שעל ידם הוא הילוך הדם,"
        },
        {
          "s": 38,
          "text": "וכמו\"כ כשעובר על מ\"ע או על מל\"ת אזי גורם שנמשך החיות והדם דקדושה לחוץ."
        },
        {
          "s": 39,
          "text": "וזהו מ\"ש63"
        },
        {
          "s": 40,
          "text": "ונוקב שם הוי',"
        },
        {
          "s": 41,
          "text": "דהנה כל המצוות תלוים בשם הוי'64,"
        },
        {
          "s": 42,
          "text": "וכשחטא ופגם והעביר את הדרך עי\"ז שעובר על א' ממצוות הוי',"
        },
        {
          "s": 43,
          "text": "הרי הוא נוקב את שם הוי',"
        },
        {
          "s": 44,
          "text": "ועי\"ז שופך דם האדם דקדושה באדם בליעל."
        },
        {
          "s": 45,
          "text": "וזהו ג\"כ מה שאמרו רז\"ל65"
        },
        {
          "s": 46,
          "text": "גידר טיטוס את הפרוכת ויצא ממנו דם,"
        },
        {
          "s": 47,
          "text": "והיינו,"
        },
        {
          "s": 48,
          "text": "שהראו לו איך אפשר להיות ענין החורבן,"
        },
        {
          "s": 49,
          "text": "שאין זה בכח עצמו,"
        },
        {
          "s": 50,
          "text": "אלא רק ע\"י הפגם שנעשה עי\"ז ששפכו הדם,"
        },
        {
          "s": 51,
          "text": "פנימיות החיות,"
        },
        {
          "s": 52,
          "text": "דאדם דקדושה,"
        },
        {
          "s": 53,
          "text": "באדם בליעל."
        },
        {
          "s": 54,
          "text": "ועפ\"ז יש לפרש עוד פירוש במ\"ש זכור הוי' מ\"ה הי' לנו,"
        },
        {
          "s": 55,
          "text": "אַז אונזער מ\"ה איז געוואָרן מ\"ה דלעו\"ז."
        },
        {
          "s": 56,
          "text": "וענין זה נעשה ע\"י פירוש הא' במה הי' לנו,"
        },
        {
          "s": 57,
          "text": "שבחי' מ\"ה דקדושה הוא בהעלם והסתר,"
        },
        {
          "s": 58,
          "text": "ומזה נשתלשל למטה יותר,"
        },
        {
          "s": 59,
          "text": "שבחי' מ\"ה דקדושה נעשה בחי' מ\"ה דלעו\"ז,"
        },
        {
          "s": 60,
          "text": "ע\"ד הענין דשופך דם האדם באדם."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וממשיך בכתוב הביטה וראה את חרפתינו."
        },
        {
          "s": 2,
          "text": "והענין בזה,"
        },
        {
          "s": 3,
          "text": "דהנה כתיב66"
        },
        {
          "s": 4,
          "text": "חרפת אלמנותיך לא תזכרי עוד,"
        },
        {
          "s": 5,
          "text": "דבזמן הגלות נקראת כנס\"י בשם אלמנה,"
        },
        {
          "s": 6,
          "text": "כמ\"ש67"
        },
        {
          "s": 7,
          "text": "היתה כאלמנה,"
        },
        {
          "s": 8,
          "text": "ואמרו רז\"ל68"
        },
        {
          "s": 9,
          "text": "כאלמנה ולא אלמנה ממש,"
        },
        {
          "s": 10,
          "text": "כאשה שהלך בעלה למדינת הים."
        },
        {
          "s": 11,
          "text": "דהנה,"
        },
        {
          "s": 12,
          "text": "אשה היא כנס\"י ובעלה זה הקב\"ה,"
        },
        {
          "s": 13,
          "text": "ואשה שהלך בעלה למדינת הים היינו שחסר היחוד דכנס\"י עם הקב\"ה,"
        },
        {
          "s": 14,
          "text": "ובענין הספירות הוא יחוד זו\"ן,"
        },
        {
          "s": 15,
          "text": "דאשה היא בחי' מלכות,"
        },
        {
          "s": 16,
          "text": "ובעלה הוא בחי' ז\"א,"
        },
        {
          "s": 17,
          "text": "ואשה שהלך בעלה למדינת הים היינו,"
        },
        {
          "s": 18,
          "text": "שבחי' ז\"א"
        },
        {
          "s": 19,
          "text": "(אינו נמשך למלכות,"
        },
        {
          "s": 20,
          "text": "אלא)"
        },
        {
          "s": 21,
          "text": "נסתלק לבחי' ים החכמה,"
        },
        {
          "s": 22,
          "text": "וזהו שבזמן הגלות קוב\"ה סליק לעילא ולעילא69,"
        },
        {
          "s": 23,
          "text": "קוב\"ה הוא בחי' ז\"א,"
        },
        {
          "s": 24,
          "text": "ובזמן הגלות סליק לעילא ולעילא,"
        },
        {
          "s": 25,
          "text": "לעילא בחי' בינה ולעילא בחי' חכמה."
        },
        {
          "s": 26,
          "text": "וזהו\"ע אלמנה,"
        },
        {
          "s": 27,
          "text": "כמ\"ש בפרדס70"
        },
        {
          "s": 28,
          "text": "שאלמנה הוא אל מנה,"
        },
        {
          "s": 29,
          "text": "מנה הוא מאה זוזי,"
        },
        {
          "s": 30,
          "text": "ב\"פ נו\"ן,"
        },
        {
          "s": 31,
          "text": "והיינו נו\"ן שערי בינה כפי שהם מלמטה למעלה ומלמעלה למטה,"
        },
        {
          "s": 32,
          "text": "שעל ידם נעשית העלאת המדות והמשכת אוא\"ס בבחי' המדות,"
        },
        {
          "s": 33,
          "text": "שעי\"ז יומשך למטה בבחי' המלכות."
        },
        {
          "s": 34,
          "text": "וזהו ג\"כ ענין המסעות,"
        },
        {
          "s": 35,
          "text": "מוצאיהם למסעיהם גו' מסעיהם למוצאיהם71,"
        },
        {
          "s": 36,
          "text": "שהו\"ע העלאה והמשכה72."
        },
        {
          "s": 37,
          "text": "אך בזמן הגלות הוא אל מנה,"
        },
        {
          "s": 38,
          "text": "שחסר ענין ההעלאה וההמשכה שע\"י הנו\"ן שערים,"
        },
        {
          "s": 39,
          "text": "ולכן לא נמשך מבחי' ז\"א למלכות להיות יחוד זו\"ן,"
        },
        {
          "s": 40,
          "text": "שזהו\"ע אלמנה."
        },
        {
          "s": 41,
          "text": "ועוד פירוש באלמנה,"
        },
        {
          "s": 42,
          "text": "כמ\"ש בספר השרשים73"
        },
        {
          "s": 43,
          "text": "דאלמנה הוא מלשון אלם."
        },
        {
          "s": 44,
          "text": "דהנה74,"
        },
        {
          "s": 45,
          "text": "להפירוש שאלמנה הוא מלשון אל מנה,"
        },
        {
          "s": 46,
          "text": "שכתובתה מנה,"
        },
        {
          "s": 47,
          "text": "אינו מובן למה גם לזכר קוראים אלמן,"
        },
        {
          "s": 48,
          "text": "ועכצ\"ל שלפי שאשה נקראת אלמנה,"
        },
        {
          "s": 49,
          "text": "לכן גם זכר נקרא אלמן75."
        },
        {
          "s": 50,
          "text": "אך להפירוש שאלמנה הוא מלשון אלם,"
        },
        {
          "s": 51,
          "text": "אתי שפיר שגם זכר נקרא אלמן,"
        },
        {
          "s": 52,
          "text": "לפי שחסר השמחה דיחוד בעל עם אשתו."
        },
        {
          "s": 53,
          "text": "והענין בזה,"
        },
        {
          "s": 54,
          "text": "דכאשר מאיר גילוי הקול בדיבור אזי הדיבור מאיר בגילוי,"
        },
        {
          "s": 55,
          "text": "וכאשר הדיבור מאיר בגילוי אזי ידבר עמים תחתינו76"
        },
        {
          "s": 56,
          "text": "(דע\"י ידבר מלשון דיבור נעשה גם ידבר מלשון הנהגה),"
        },
        {
          "s": 57,
          "text": "שישראל הם במעלה העליונה כו',"
        },
        {
          "s": 58,
          "text": "אבל כאשר אין הקול בגילוי אזי הדיבור הוא בהעלם בגלות,"
        },
        {
          "s": 59,
          "text": "וזהו\"ע אלמנה מלשון אלם."
        },
        {
          "s": 60,
          "text": "ועל זה אנו מבקשים הביטה וראה את חרפתינו,"
        },
        {
          "s": 61,
          "text": "דאף שהבטה הוא בחי' מקיף,"
        },
        {
          "s": 62,
          "text": "מ\"מ,"
        },
        {
          "s": 63,
          "text": "הרי זה מועיל גם בפנימיות,"
        },
        {
          "s": 64,
          "text": "כמ\"ש77"
        },
        {
          "s": 65,
          "text": "כי הוי' אלקיך מתהלך בקרב מחניך להצילך גו',"
        },
        {
          "s": 66,
          "text": "להצילך היינו להיות צל על ראשך78"
        },
        {
          "s": 67,
          "text": "שהוא בחי' מקיף,"
        },
        {
          "s": 68,
          "text": "ומ\"מ נעשה עי\"ז להצילך כפשוטו,"
        },
        {
          "s": 69,
          "text": "מלשון הצלה,"
        },
        {
          "s": 70,
          "text": "ובפרט בנוגע לפעולה על הקליפות,"
        },
        {
          "s": 71,
          "text": "הרי אור מקיף מסמא עיני החיצונים"
        },
        {
          "s": 72,
          "text": "(כנ\"ל)."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "וזהו מ\"ש זכור הוי' מה הי' לנו וגו',"
        },
        {
          "s": 1,
          "text": "דהנה,"
        },
        {
          "s": 2,
          "text": "הקב\"ה תובע מישראל זכור את בוראך בימי בחרותיך,"
        },
        {
          "s": 3,
          "text": "עד שביהמ\"ק קיים שנקרא בית הבחירה,"
        },
        {
          "s": 4,
          "text": "עד שברית כהונה קיימת,"
        },
        {
          "s": 5,
          "text": "ועד שברית לוי' קיימת,"
        },
        {
          "s": 6,
          "text": "והתביעה היא עשות משפט ואהבת חסד והצנע לכת עם אלקיך,"
        },
        {
          "s": 7,
          "text": "אך כאשר חסרה העבודה דהצנע לכת,"
        },
        {
          "s": 8,
          "text": "שהיא היפך הענין דראו מ\"ה,"
        },
        {
          "s": 9,
          "text": "אזי נעשה מ\"ה דלעו\"ז."
        },
        {
          "s": 10,
          "text": "ולזה אנו מבקשים זכור ה' מה הי' לנו,"
        },
        {
          "s": 11,
          "text": "שהמ\"ה דקדושה הוא בהעלם והסתר,"
        },
        {
          "s": 12,
          "text": "ועד שעי\"ז נעשה המ\"ה דלעו\"ז,"
        },
        {
          "s": 13,
          "text": "ולכן הביטה וראה את חרפתינו,"
        },
        {
          "s": 14,
          "text": "עד שחרפת אלמנותיך לא תזכרי עוד."
        }
      ]
    }
  ]
}