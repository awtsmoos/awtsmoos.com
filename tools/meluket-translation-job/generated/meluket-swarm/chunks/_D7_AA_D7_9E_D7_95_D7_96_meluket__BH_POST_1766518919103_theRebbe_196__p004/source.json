{
  "globalIndex": 894,
  "owner": 44,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919103_theRebbe_196__p004",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919103_theRebbe_196__p004",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919103_theRebbe_196",
  "title": "מאמר השם נפשנו בחיים תשח\"י",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "שהסיבה לזה שקרח טעה וחשב שהכוונה ברקיע המבדיל היא ההבדלה עצמה,"
        },
        {
          "s": 3,
          "text": "היא,"
        },
        {
          "s": 4,
          "text": "מפני שלא הי' בו ענין הביטול."
        },
        {
          "s": 5,
          "text": "והענין הוא,"
        },
        {
          "s": 6,
          "text": "דזה שנת\"ל"
        },
        {
          "s": 7,
          "text": "(סעיף ג)"
        },
        {
          "s": 8,
          "text": "שהכוונה בזה שמים התחתונים נבדלו ממים העליונים וירדו למטה היא בכדי שיהי' בהם התשוקה והצמאון לעלות למעלה,"
        },
        {
          "s": 9,
          "text": "הוא חיבור והתכללות דשני מדות הפכיות."
        },
        {
          "s": 10,
          "text": "כי מצד החסדים"
        },
        {
          "s": 11,
          "text": "(מעלת הגילויים),"
        },
        {
          "s": 12,
          "text": "המעלה היא במים העליונים ולא הי' צריך שמים התחתונים יובדלו ממים העליונים וירדו למטה,"
        },
        {
          "s": 13,
          "text": "ומצד הגבורות,"
        },
        {
          "s": 14,
          "text": "המעלה היא בגילוי השרש דמים התחתונים עצמם,"
        },
        {
          "s": 15,
          "text": "ואין צריך שבמים התחתונים יהי' תשוקה וצמאון לצאת ממציאותם ולעלות למעלה."
        },
        {
          "s": 16,
          "text": "וזה שהכוונה בהירידה דמים התחתונים למטה היא שיהי' בהם הצמאון לעלות למעלה הוא מצד הת\"ת,"
        },
        {
          "s": 17,
          "text": "קו האמצעי,"
        },
        {
          "s": 18,
          "text": "שמחבר ההפכים דחסד וגבורה,"
        },
        {
          "s": 19,
          "text": "שיהי' לאכללא שמאלא בימינא48."
        },
        {
          "s": 20,
          "text": "ולהיות דענין ההתכללות הוא מצד הביטול49,"
        },
        {
          "s": 21,
          "text": "לכן קרח שלא הי' בביטול,"
        },
        {
          "s": 22,
          "text": "לא הונח אצלו ענין זה."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "שעד\"ז הוא בנוגע להעבודה דכל מעשיך לשם שמים,"
        },
        {
          "s": 2,
          "text": "דזה שהגם שיודע גודל העילוי דבכל דרכיך דעהו,"
        },
        {
          "s": 3,
          "text": "ידיעת אלקות בעניני העולם עצמם,"
        },
        {
          "s": 4,
          "text": "ומ\"מ יהי' כל עסקו בעניני העולם רק אמצעי בשביל קיום התומ\"צ,"
        },
        {
          "s": 5,
          "text": "הוא ע\"י הביטול לקיים רצון העליון."
        },
        {
          "s": 6,
          "text": "דמכיון שעבודתו היא לא לרוות את צמאונו שיהי' גילוי אלקות בנפשו,"
        },
        {
          "s": 7,
          "text": "אלא שהוא מסור ונתון לקיים רצון הקב\"ה,"
        },
        {
          "s": 8,
          "text": "לכן אין נוגע לו הגילוי שידע אלקות"
        },
        {
          "s": 9,
          "text": "(גם)"
        },
        {
          "s": 10,
          "text": "בעניני העולם,"
        },
        {
          "s": 11,
          "text": "וכל רצונו הוא בקיום התומ\"צ,"
        },
        {
          "s": 12,
          "text": "קיום רצון הקב\"ה."
        },
        {
          "s": 13,
          "text": "[ועי\"ז יהי' לו גם הגילוי אלקות שבעניני העולם,"
        },
        {
          "s": 14,
          "text": "וכנ\"ל"
        },
        {
          "s": 15,
          "text": "(סעיף ה),"
        },
        {
          "s": 16,
          "text": "שע\"י העבודה דכל מעשיך לשם שמים מגיעים לבכל דרכיך דעהו]."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "וזהו השם נפשנו בחיים ולא נתן למוט רגלנו,"
        },
        {
          "s": 2,
          "text": "דכשהאדם עוסק בתומ\"צ הוא בבחינת ראש וכשהוא עוסק בעניני העולם הוא בבחינת רגל,"
        },
        {
          "s": 3,
          "text": "והכח על זה שהרגלים שלו"
        },
        {
          "s": 4,
          "text": "(העסק בעניני העולם)"
        },
        {
          "s": 5,
          "text": "לא יהיו למוט,"
        },
        {
          "s": 6,
          "text": "הוא מהחיים שבהם שם נפשנו,"
        },
        {
          "s": 7,
          "text": "החיים שלמעלה מהטבע,"
        },
        {
          "s": 8,
          "text": "שלמעלה מחיי הנפש עצמה,"
        },
        {
          "s": 9,
          "text": "גם מבחינת חי בעצם,"
        },
        {
          "s": 10,
          "text": "כי מצד הדרגא דחיי הנפש עצמה"
        },
        {
          "s": 11,
          "text": "(כולל גם בחינת חי בעצם),"
        },
        {
          "s": 12,
          "text": "אפשר שירצה בהגילוי אלקות שבעניני העולם,"
        },
        {
          "s": 13,
          "text": "וכאשר עסקו בעניני העולם יהי' בשביל"
        },
        {
          "s": 14,
          "text": "(הגילוי שב)"
        },
        {
          "s": 15,
          "text": "עניני העולם עצמם,"
        },
        {
          "s": 16,
          "text": "ולא לשם שמים בשביל קיום התומ\"צ,"
        },
        {
          "s": 17,
          "text": "אז הרגלים שבו"
        },
        {
          "s": 18,
          "text": "(התעסקותו בעניני הרשות)"
        },
        {
          "s": 19,
          "text": "יהיו למוט,"
        },
        {
          "s": 20,
          "text": "ובכדי שהרגלים שלו לא יהיו למוט,"
        },
        {
          "s": 21,
          "text": "ע\"י שעסקו בדברי הרשות הוא לשם שמים כנ\"ל,"
        },
        {
          "s": 22,
          "text": "הוא ע\"י החיים שלמעלה מהטבע"
        },
        {
          "s": 23,
          "text": "(די\"ל שהכלי לזה הוא הביטול),"
        },
        {
          "s": 24,
          "text": "שלהיותם למעלה מהגבלה הם מחברים שני ההפכים דחסד וגבורה,"
        },
        {
          "s": 25,
          "text": "דהגם שיודע העילוי שבבירור דברי הרשות,"
        },
        {
          "s": 26,
          "text": "מ\"מ כוונתו בעשיית דברי הרשות היא בשביל קיום התומ\"צ."
        }
      ]
    }
  ]
}