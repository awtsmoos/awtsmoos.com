{
  "globalIndex": 831,
  "owner": 31,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918708_theRebbe_155__p007",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918708_theRebbe_155__p007",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918708_theRebbe_155",
  "title": "מאמר בשעה שעלה משה למרום תשכ\"ה",
  "part": 7,
  "sections": [
    {
      "v": 18,
      "items": [
        {
          "s": 0,
          "text": "ולהוסיף,"
        },
        {
          "s": 1,
          "text": "דע\"פ המבואר לעיל"
        },
        {
          "s": 2,
          "text": "(סעיף ו)"
        },
        {
          "s": 3,
          "text": "דזה שעלה ברצונו שההמשכה דלמעלה תהי' ע\"י אתעדל\"ת הוא כי שורש האתעדל\"ת הוא בעצמות אוא\"ס שלמעלה גם מהאור כמו שהוא מצד עצמו קודם שעלה ברצונו ענין האתעדל\"ת,"
        },
        {
          "s": 4,
          "text": "יש לומר,"
        },
        {
          "s": 5,
          "text": "דנוסף לזה שע\"י העבודה דאדם התחתון מתגלה הפנימיות דאדם העליון שהוא חד עם הפשיטות דאוא\"ס כמו שהוא בבחינת מים"
        },
        {
          "s": 6,
          "text": "[האור שיש לו שייכות לציור,"
        },
        {
          "s": 7,
          "text": "דוגמת מים כפשוטם שגם לפני שמסתכלים בהם הם באופן שאפשר להיות נראה בהם הפנים שמסתכלת בהם],"
        },
        {
          "s": 8,
          "text": "הנה ע\"י העבודה דאדם התחתון נמשך גם גילוי עצמות אוא\"ס שלמעלה גם מהאור כמו שהוא מצד עצמו."
        }
      ]
    },
    {
      "v": 19,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "והנה59 העבודה שעל ידה מתגלה הפנימיות דאדם העליון היא בכללות העבודה דבירור נפש הבהמית."
        },
        {
          "s": 3,
          "text": "כי זה שע\"ס הגלויות הם"
        },
        {
          "s": 4,
          "text": "(בחיצוניות)"
        },
        {
          "s": 5,
          "text": "כמו דבר נבדל שנתהוו מע\"ס הגנוזות הוא מצד הפרסא בין ע\"ס הגנוזות לע\"ס הגלויות."
        },
        {
          "s": 6,
          "text": "וע\"י זיכוך נפש הבהמית נעשה זיכוך הפרסא שבין למעלה מאצילות"
        },
        {
          "s": 7,
          "text": "(ע\"ס הגנוזות)"
        },
        {
          "s": 8,
          "text": "ואצילות"
        },
        {
          "s": 9,
          "text": "(ע\"ס הגלויות),"
        },
        {
          "s": 10,
          "text": "ועי\"ז נרגש בגילוי בהע\"ס דאצילות שהם הגילוי דע\"ס הגנוזות,"
        },
        {
          "s": 11,
          "text": "וכנ\"ל שהפנים שבמים הם הנראים להאדם."
        },
        {
          "s": 12,
          "text": "ולהוסיף,"
        },
        {
          "s": 13,
          "text": "דע\"י בירור וזיכוך נה\"ב נעשה זיכוך כל הפרסאות,"
        },
        {
          "s": 14,
          "text": "וגם הזיכוך דצמצום הראשון,"
        },
        {
          "s": 15,
          "text": "ועי\"ז,"
        },
        {
          "s": 16,
          "text": "החיבור דע\"ס הגלויות עם ע\"ס הגנוזות הוא עם כל הדרגות שבע\"ס הגנוזות,"
        },
        {
          "s": 17,
          "text": "כולל גם ע\"ס הגנוזות שלפני הצמצום."
        },
        {
          "s": 18,
          "text": "ועד\"ז הוא לאידך,"
        },
        {
          "s": 19,
          "text": "שע\"י זיכוך נפש הבהמית מזדככת גם הפרסא שבין אצילות לבי\"ע"
        },
        {
          "s": 20,
          "text": "[דעיקר ההעלם הוא ע\"י פרסא זו],"
        },
        {
          "s": 21,
          "text": "ועי\"ז נעשה החיבור דאדם התחתון עם אדם העליון."
        },
        {
          "s": 22,
          "text": "והעבודה שעל ידה נמשך הגילוי דעצמות אוא\"ס היא העבודה שמצד הנשמה"
        },
        {
          "s": 23,
          "text": "(שלמעלה מהתלבשות בגוף ונה\"ב),"
        },
        {
          "s": 24,
          "text": "דבכללות הוא העבודה דרעותא דלבא."
        },
        {
          "s": 25,
          "text": "כי זה שע\"י העבודה דישראל נמשך גילוי עצמות אוא\"ס הוא מצד מעלת הנשמות,"
        },
        {
          "s": 26,
          "text": "דעלו במחשבה"
        },
        {
          "s": 27,
          "text": "(כנ\"ל סעיף ו),"
        },
        {
          "s": 28,
          "text": "ולכן המשכת גילוי זה הוא ע\"י רעותא דלבא."
        }
      ]
    },
    {
      "v": 20,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "והנה בהחידוש שנתחדש במתן תורה"
        },
        {
          "s": 3,
          "text": "[בפעם הראשונה,"
        },
        {
          "s": 4,
          "text": "ועד\"ז במתן תורה שבכל שנה],"
        },
        {
          "s": 5,
          "text": "שני ענינים."
        },
        {
          "s": 6,
          "text": "המשכת וגילוי עצמות אוא\"ס לישראל – אנכי הוי' אלקיך,"
        },
        {
          "s": 7,
          "text": "והמשכת גילוי זה הוא ע\"י רעותא דלבא."
        },
        {
          "s": 8,
          "text": "וביטול הגזירה והמחיצה בין עליונים ותחתונים60,"
        },
        {
          "s": 9,
          "text": "בכל העולמות."
        },
        {
          "s": 10,
          "text": "והמשכת גילוי זה הוא ע\"י בירור נפש הבהמית."
        },
        {
          "s": 11,
          "text": "ולכן בספירת העומר,"
        },
        {
          "s": 12,
          "text": "שהיא ההכנה למתן תורה,"
        },
        {
          "s": 13,
          "text": "צ\"ל שני הענינים,"
        },
        {
          "s": 14,
          "text": "בירור המדות דנפש הבהמית,"
        },
        {
          "s": 15,
          "text": "והאהבה דבכל מאדך"
        },
        {
          "s": 16,
          "text": "(רעותא דלבא)."
        }
      ]
    }
  ]
}