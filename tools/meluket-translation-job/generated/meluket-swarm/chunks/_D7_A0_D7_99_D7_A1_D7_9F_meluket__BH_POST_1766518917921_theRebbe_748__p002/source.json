{
  "globalIndex": 707,
  "owner": 7,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917921_theRebbe_748__p002",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917921_theRebbe_748__p002",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917921_theRebbe_748",
  "title": "מאמר ונחה עליו רוח ה' תשי\"ד",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "וביאור הענין"
        },
        {
          "s": 2,
          "text": "(שע\"ס דאצילות נק' גופין ובי\"ע לבושים)"
        },
        {
          "s": 3,
          "text": "בעומק יותר,"
        },
        {
          "s": 4,
          "text": "יובן בהקדים דהחילוק שבין לבוש המיוחד ללבוש הנפרד הוא לא רק אם אפשר לפושטו או לאו,"
        },
        {
          "s": 5,
          "text": "אלא ועיקר שהם חלוקים בענינם."
        },
        {
          "s": 6,
          "text": "דפירוש לבוש המיוחד הוא שאינו ענין לעצמו."
        },
        {
          "s": 7,
          "text": "דכאשר יש לו ענין לעצמו,"
        },
        {
          "s": 8,
          "text": "הנה גם כשמצד סיבות שונות א\"א לפושטו,"
        },
        {
          "s": 9,
          "text": "הרי זה גופא שיש לו ענין לעצמו הוא נפרד,"
        },
        {
          "s": 10,
          "text": "ופירוש"
        },
        {
          "s": 11,
          "text": "(לבוש ה)"
        },
        {
          "s": 12,
          "text": "מיוחד הוא שכל ענינו הוא להיות לבוש וכלי לזה שמתלבש בו21."
        },
        {
          "s": 13,
          "text": "וזהו עיקר החילוק שבין גוף האדם להלבושים שלו,"
        },
        {
          "s": 14,
          "text": "דהלבושים הם מציאות לעצמם,"
        },
        {
          "s": 15,
          "text": "ולכן הם מכסים ומעלימים על גוף האדם המלובש בתוכם,"
        },
        {
          "s": 16,
          "text": "משא\"כ הגוף כל ענינו הוא להיות לבוש וכלי להנפש שמלובשת בו,"
        },
        {
          "s": 17,
          "text": "ולכן אינו מעלים על חיות הנפש המלובש בו,"
        },
        {
          "s": 18,
          "text": "דבהגוף ניכר שהוא חי22."
        },
        {
          "s": 19,
          "text": "וזהו גם הטעם על זה שאברי הגוף נשמעים ממילא לרצון הנפש,"
        },
        {
          "s": 20,
          "text": "דכשעולה ברצון הנפש שתהי' איזו פעולה דאברי הגוף אין הרצון צריך לצַוות על האברים שיעשו כן אלא שנעשה בהם כן ממילא23,"
        },
        {
          "s": 21,
          "text": "כי מכיון שכל ענינו של הגוף הוא להיות כלי להנפש"
        },
        {
          "s": 22,
          "text": "(כנ\"ל),"
        },
        {
          "s": 23,
          "text": "לכן פעולת"
        },
        {
          "s": 24,
          "text": "(רצון)"
        },
        {
          "s": 25,
          "text": "הנפש בהגוף היא באופן דממילא24."
        },
        {
          "s": 26,
          "text": "ועד\"ז הוא בהחילוק שבין שכל ומדות למחשבה דיבור ומעשה,"
        },
        {
          "s": 27,
          "text": "דעיקר החילוק שביניהם הוא,"
        },
        {
          "s": 28,
          "text": "שמחשבה דיבור ומעשה הם מציאות לעצמם"
        },
        {
          "s": 29,
          "text": "(והתלבשות השכל והמדות שבהם היא דבר נוסף על מציאותם),"
        },
        {
          "s": 30,
          "text": "ולכן הם מעלימים על השכל והמדות שמלובשים בהם,"
        },
        {
          "s": 31,
          "text": "משא\"כ השכל והמדות ענינם הוא שהם כלים להנפש שמתלבשת בהם,"
        },
        {
          "s": 32,
          "text": "ונרגש בהם בגילוי שהנפש פועלת על ידם"
        },
        {
          "s": 33,
          "text": "(שהנפש משכלת ע\"י כח השכל,"
        },
        {
          "s": 34,
          "text": "מתחסדת ע\"י כח החסד וכו')19."
        },
        {
          "s": 35,
          "text": "ועפ\"ז יובן בעומק יותר מה שע\"ס דאצילות נק' גופין ובי\"ע לבושים,"
        },
        {
          "s": 36,
          "text": "כי בי\"ע"
        },
        {
          "s": 37,
          "text": "(גם הכלים דע\"ס דבי\"ע)"
        },
        {
          "s": 38,
          "text": "הם יש,"
        },
        {
          "s": 39,
          "text": "משא\"כ ע\"ס דאצילות"
        },
        {
          "s": 40,
          "text": "(גם הכלים)"
        },
        {
          "s": 41,
          "text": "הם אלקות."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה חילוק הנ\"ל שבין אצילות לבי\"ע,"
        },
        {
          "s": 2,
          "text": "שאצילות הוא אלקות ובי\"ע הם נפרדים,"
        },
        {
          "s": 3,
          "text": "הוא גם מצד שרש התהוותם."
        },
        {
          "s": 4,
          "text": "דהתהוות האצילות היא מבחי' אור והתהוות בי\"ע היא מבחי' כח."
        },
        {
          "s": 5,
          "text": "והענין הוא25,"
        },
        {
          "s": 6,
          "text": "דהנה ידוע שבספרי המחקר נק' המשכת אלקות בשם שפע"
        },
        {
          "s": 7,
          "text": "(דלשון שפע נופל הן על דבר גשמי כמו שפעת מים26,"
        },
        {
          "s": 8,
          "text": "וגם על דבר רוחני כמו השפעת שכל),"
        },
        {
          "s": 9,
          "text": "ובספרי הקבלה נאמר לשון אור."
        },
        {
          "s": 10,
          "text": "דטעמם של החוקרים שכינו להמשכת אלקות בלשון שפע הוא מפני שהשם שפע אינו מתאר את הדבר הנשפע,"
        },
        {
          "s": 11,
          "text": "ולכן כינו להמשכת אלקות בשם שפע בכדי שלא לתאר בו ית' ציור מוגבל."
        },
        {
          "s": 12,
          "text": "ומהטעמים על זה שהמקובלים קראו להמשכת אלקות בשם אור,"
        },
        {
          "s": 13,
          "text": "אף שאור הוא תואר,"
        },
        {
          "s": 14,
          "text": "כי אור הוא דבוק תמיד במקורו27"
        },
        {
          "s": 15,
          "text": "וכשנפרד בטל"
        },
        {
          "s": 16,
          "text": "(משא\"כ שפע יש לו קיום גם אחרי שנפרד ממקורו,"
        },
        {
          "s": 17,
          "text": "כמו שפע מים שהמים שנשפעו יש להם קיום גם לאחרי שנפרדו מהמעין,"
        },
        {
          "s": 18,
          "text": "וכמו\"כ הוא בשפע שכל,"
        },
        {
          "s": 19,
          "text": "דהשכל הנשפע להתלמיד יש לו קיום גם לאחרי שנפרד מהרב),"
        },
        {
          "s": 20,
          "text": "ולכן קראו להמשכת אלקות בשם אור להורות שההמשכה דבוקה תמיד בו ית'."
        },
        {
          "s": 21,
          "text": "אך לפ\"ז צריך להבין מ\"ש28"
        },
        {
          "s": 22,
          "text": "אתה עשית את השמים ואת הארץ בכחך הגדול,"
        },
        {
          "s": 23,
          "text": "והרי גם כח יכול להתקיים"
        },
        {
          "s": 24,
          "text": "(מעט)"
        },
        {
          "s": 25,
          "text": "זמן גם כשנפרד ממקורו,"
        },
        {
          "s": 26,
          "text": "וכמו כח הזריקה,"
        },
        {
          "s": 27,
          "text": "שהכח שנמשך בהאבן ונושאו הוא נפרד מכח היד,"
        },
        {
          "s": 28,
          "text": "ומכיון שהחיות האלקי שמהווה ומחי' את הנבראים הוא דבוק תמיד במקורו,"
        },
        {
          "s": 29,
          "text": "מהו אומרו בכחך הגדול."
        },
        {
          "s": 30,
          "text": "והביאור בזה,"
        },
        {
          "s": 31,
          "text": "דבכדי שהנבראים"
        },
        {
          "s": 32,
          "text": "(השמים והארץ)"
        },
        {
          "s": 33,
          "text": "יהיו בבחי' יש ודבר נפרד,"
        },
        {
          "s": 34,
          "text": "הי' צריך להיות צמצום בהאור האלקי שמהווה אותם,"
        },
        {
          "s": 35,
          "text": "שיהי' באופן של כח,"
        },
        {
          "s": 36,
          "text": "שהוא נבדל ממקורו."
        },
        {
          "s": 37,
          "text": "דהגם שבאמת גם הכח שמהווה את הנבראים הוא דבוק תמיד במקורו"
        },
        {
          "s": 38,
          "text": "[שהרי אפילו הנבראים אינם מציאות לעצמם ומתחדשים תמיד מהכח האלקי שמהווה אותם29,"
        },
        {
          "s": 39,
          "text": "ומכ\"ש שהכח האלקי שמהווה אותם הוא דבוק תמיד במקורו30],"
        },
        {
          "s": 40,
          "text": "מ\"מ,"
        },
        {
          "s": 41,
          "text": "לגבי הנבראים הוא נראה שהוא נבדל ממקורו31,"
        },
        {
          "s": 42,
          "text": "ועי\"ז הם נעשים ליש ודבר נפרד."
        },
        {
          "s": 43,
          "text": "ונמצא שהחילוק שבין אצילות לבי\"ע"
        },
        {
          "s": 44,
          "text": "(שבי\"ע הם יש ודבר נפרד ואצילות הוא עולם האחדות)"
        },
        {
          "s": 45,
          "text": "הוא מצד שרש התהוותם,"
        },
        {
          "s": 46,
          "text": "לפי שההתהוות דבי\"ע היא מבחי' כח,"
        },
        {
          "s": 47,
          "text": "והתהוות האצילות היא מבחי' אור."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה ידוע32"
        },
        {
          "s": 2,
          "text": "שבאצילות הוא הביטול דיחודא עילאה,"
        },
        {
          "s": 3,
          "text": "ביטול דכלא חשיב33."
        },
        {
          "s": 4,
          "text": "והיינו דביטול הנאצלים להמאציל הוא לא רק שאינם מציאות לעצמם"
        },
        {
          "s": 5,
          "text": "(כהנבראים דבי\"ע שהם יש ודבר נפרד),"
        },
        {
          "s": 6,
          "text": "אלא יתירה מזו,"
        },
        {
          "s": 7,
          "text": "שאינם תופסים מקום לגבי המאציל,"
        },
        {
          "s": 8,
          "text": "כלא חשיב."
        },
        {
          "s": 9,
          "text": "ויובן זה בהקדים הידוע34"
        },
        {
          "s": 10,
          "text": "החילוק בין אור לשפע,"
        },
        {
          "s": 11,
          "text": "דשפע הוא מהות דבר,"
        },
        {
          "s": 12,
          "text": "ולכן המשכת השפע פועל שינוי בהמשפיע,"
        },
        {
          "s": 13,
          "text": "משא\"כ אור הוא הארה בלבד שבאין ערוך להמאור,"
        },
        {
          "s": 14,
          "text": "ולכן אין האור פועל שינוי בהמאור."
        },
        {
          "s": 15,
          "text": "ומהטעמים על זה שהמקובלים קראו להמשכת אלקות בשם אור הוא בכדי להדגיש דזה שהוא ית' מהווה ומחי' את כל העולמות אין זה פועל שינוי בו ית',"
        },
        {
          "s": 16,
          "text": "כי החיות דכל העולמות הוא הארה בלבד שבאין ערוך אליו כלל."
        },
        {
          "s": 17,
          "text": "וענין זה"
        },
        {
          "s": 18,
          "text": "(שהאור הוא באין ערוך לגבי המאור)"
        },
        {
          "s": 19,
          "text": "נרגש גם בהאור."
        },
        {
          "s": 20,
          "text": "דמכיון שהאור דבוק במקורו ונרגש בו מקורו,"
        },
        {
          "s": 21,
          "text": "הרי זה שהוא באין ערוך ואין לו תפיסת מקום לגבי המקור,"
        },
        {
          "s": 22,
          "text": "נרגש זה גם בהאור35."
        },
        {
          "s": 23,
          "text": "ועפ\"ז יובן מה שביטול הנאצלים להמאציל הוא"
        },
        {
          "s": 24,
          "text": "(לא רק שאינם מציאות לעצמם אלא גם)"
        },
        {
          "s": 25,
          "text": "שאינם תופסים מקום כלל,"
        },
        {
          "s": 26,
          "text": "דמכיון שהתהוות האצילות היא מבחי' אור"
        },
        {
          "s": 27,
          "text": "(כנ\"ל סעיף ד)"
        },
        {
          "s": 28,
          "text": "שמצד דביקותו בהמאור נרגש בו"
        },
        {
          "s": 29,
          "text": "(כנ\"ל)"
        },
        {
          "s": 30,
          "text": "שאינו תופס מקום,"
        },
        {
          "s": 31,
          "text": "לכן גם בהנאצלים מאיר גילוי דעת עליון שעצמות אוא\"ס הוא יש האמיתי והכל הוא אין לגבי'36."
        }
      ]
    }
  ]
}