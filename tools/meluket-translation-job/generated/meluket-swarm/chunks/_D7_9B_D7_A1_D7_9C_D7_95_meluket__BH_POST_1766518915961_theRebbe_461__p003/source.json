{
  "globalIndex": 387,
  "owner": 37,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915961_theRebbe_461__p003",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915961_theRebbe_461__p003",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915961_theRebbe_461",
  "title": "מאמר ביום השמיני תשמ\"ו",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה כמו שבכחות הנפש השרש דכח המעשה הוא למעלה משרש כל הכחות,"
        },
        {
          "s": 2,
          "text": "עד\"ז הוא גם בעבודת הוי',"
        },
        {
          "s": 3,
          "text": "שעיקר המעלה היא במעשה דוקא."
        },
        {
          "s": 4,
          "text": "דזה שתלמוד גדול22"
        },
        {
          "s": 5,
          "text": "הוא רק עכשיו,"
        },
        {
          "s": 6,
          "text": "אבל לע\"ל יהי' מעשה גדול23."
        },
        {
          "s": 7,
          "text": "וגם עכשיו שתלמוד גדול,"
        },
        {
          "s": 8,
          "text": "הטעם לזה הוא לפי שתלמוד מביא לידי מעשה24,"
        },
        {
          "s": 9,
          "text": "דמזה מוכח שהעיקר הוא המעשה25."
        },
        {
          "s": 10,
          "text": "וזה שלע\"ל דוקא יהי' מעשה גדול הוא כי במעלת המעשה על תלמוד שני ענינים בכללות26"
        },
        {
          "s": 11,
          "text": "[דוגמת שני הענינים דלעיל סעיף ד בהמעלה דכח המעשה לגבי שאר הכחות]."
        },
        {
          "s": 12,
          "text": "זה שהמעשה מעורר וממשיך את אור הבל\"ג שלמעלה מהתלבשות בחכמה"
        },
        {
          "s": 13,
          "text": "(תלמוד),"
        },
        {
          "s": 14,
          "text": "שלכן ההמשכה שע\"י המעשה היא למטה יותר."
        },
        {
          "s": 15,
          "text": "וזה שהמעשה מגיע בהעלם העצמי,"
        },
        {
          "s": 16,
          "text": "שלמעלה גם מאור הבל\"ג."
        },
        {
          "s": 17,
          "text": "ויש לומר,"
        },
        {
          "s": 18,
          "text": "דמעלת המעשה עכשיו"
        },
        {
          "s": 19,
          "text": "(שגם עכשיו העיקר הוא המעשה,"
        },
        {
          "s": 20,
          "text": "והגדלות דתלמוד הוא שמביא לידי מעשה,"
        },
        {
          "s": 21,
          "text": "כנ\"ל)"
        },
        {
          "s": 22,
          "text": "הוא זה שע\"י המעשה הוא המשכת אור הבל\"ג,"
        },
        {
          "s": 23,
          "text": "שלימות בענין הגילויים."
        },
        {
          "s": 24,
          "text": "וזהו גדול תלמוד שמביא לידי מעשה,"
        },
        {
          "s": 25,
          "text": "שמעלה זו דמעשה נכללת בהגדלות דתלמוד."
        },
        {
          "s": 26,
          "text": "דזה שההמשכה דתלמוד היא באופן שמביאה למעשה,"
        },
        {
          "s": 27,
          "text": "שההמשכה באה למטה,"
        },
        {
          "s": 28,
          "text": "הוא הגדלות דתלמוד,"
        },
        {
          "s": 29,
          "text": "שנמשך בו אור הבל\"ג שעי\"ז הוא נמשך למטה ומביא למעשה."
        },
        {
          "s": 30,
          "text": "וזה שלע\"ל יהי' מעשה גדול הוא העילוי דהמעשה עצמו,"
        },
        {
          "s": 31,
          "text": "שמגיע בהעלם העצמי שלמעלה מהגילויים."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה ידוע27"
        },
        {
          "s": 2,
          "text": "שבחנוכה,"
        },
        {
          "s": 3,
          "text": "לאחרי התגברות החושך דהיונים,"
        },
        {
          "s": 4,
          "text": "היתה המשכה נעלית יותר מההמשכה שהיתה בבית המקדש לפני זה,"
        },
        {
          "s": 5,
          "text": "דלגבי ההמשכה שהיתה לפנ\"ז הי' אפשר להיות התגברות החושך דהיונים,"
        },
        {
          "s": 6,
          "text": "וההמשכה דחנוכה היא מהוי' דלעילא שלמעלה מהשתלשלות,"
        },
        {
          "s": 7,
          "text": "דאור זה מאיר גם את החושך,"
        },
        {
          "s": 8,
          "text": "והוי'"
        },
        {
          "s": 9,
          "text": "(בתוס' וא\"ו)"
        },
        {
          "s": 10,
          "text": "יגי' חשכי28,"
        },
        {
          "s": 11,
          "text": "שהחושך עצמו מאיר29,"
        },
        {
          "s": 12,
          "text": "בדוגמת הגילוי דלע\"ל30."
        },
        {
          "s": 13,
          "text": "ועפ\"ז יש לבאר החילוק בין יום השמיני דחנוכה ליום השמיני למילואים,"
        },
        {
          "s": 14,
          "text": "דזה ששמיני למילואים הוא במלכות"
        },
        {
          "s": 15,
          "text": "(שמיני שלמטה משבעה)"
        },
        {
          "s": 16,
          "text": "הוא שההמשכה מלמעלה נמשכה עד המלכות,"
        },
        {
          "s": 17,
          "text": "וזה ששמיני דחנוכה הוא במלכות הוא שע\"י ההמשכה דחנוכה נעשה עלי' במלכות עצמה."
        },
        {
          "s": 18,
          "text": "וזהו שבהדרושים שמבארים ענין שמונת ימי המילואים מובאים שני הפירושים דשמיני"
        },
        {
          "s": 19,
          "text": "(שהוא למעלה משבעה ושהוא למטה משבעה),"
        },
        {
          "s": 20,
          "text": "ובדרוש הנ\"ל שמבאר ענין שמיני דחנוכה מובא רק הפירוש ששמיני הוא למטה משבעה,"
        },
        {
          "s": 21,
          "text": "כי זה שההמשכה מלמעלה נמשכת גם למטה"
        },
        {
          "s": 22,
          "text": "(שמיני למילואים)"
        },
        {
          "s": 23,
          "text": "הוא מצד המעלה דשרש ההמשכה"
        },
        {
          "s": 24,
          "text": "(ע\"ד מעלת המעשה עכשיו),"
        },
        {
          "s": 25,
          "text": "שמיני שלמעלה משבעה31."
        },
        {
          "s": 26,
          "text": "והכח שיהי' זיכוך ועלי' בהמטה עצמו"
        },
        {
          "s": 27,
          "text": "(שמיני דחנוכה)"
        },
        {
          "s": 28,
          "text": "הוא מהעלם העצמי שלמעלה משרש הגילוי"
        },
        {
          "s": 29,
          "text": "(ע\"ד32"
        },
        {
          "s": 30,
          "text": "מעשה גדול שיהי' לע\"ל)."
        },
        {
          "s": 31,
          "text": "ולכן ההדגשה של יום השמיני דחנוכה היא שהוא במלכות"
        },
        {
          "s": 32,
          "text": "[שלכן נקרא בשם זאת חנוכה],"
        },
        {
          "s": 33,
          "text": "הענין דזיכוך המטה33."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "והנה ענין זה שלע\"ל יהי' מעשה גדול נתגלה"
        },
        {
          "s": 2,
          "text": "(ככל הענינים דתורת החסידות)"
        },
        {
          "s": 3,
          "text": "בדורות האחרונים דוקא."
        },
        {
          "s": 4,
          "text": "והטעם שגילו לנו זה"
        },
        {
          "s": 5,
          "text": "(אף שעכשיו ההלכה היא שתלמוד גדול),"
        },
        {
          "s": 6,
          "text": "הוא,"
        },
        {
          "s": 7,
          "text": "כי כל הגילויים דלעתיד תלויים במעשינו ועבודתינו עכשיו34."
        },
        {
          "s": 8,
          "text": "וזה שלע\"ל יהי' מעשה גדול הוא ע\"י ההשתדלות והזירוז בענין המעשה עכשיו."
        },
        {
          "s": 9,
          "text": "ולכן בדרא דעקבתא דמשיחא גילו שלע\"ל יהי' מעשה גדול,"
        },
        {
          "s": 10,
          "text": "בכדי לעורר עי\"ז עוד יותר ההשתדלות והזירוז בענין המעשה,"
        },
        {
          "s": 11,
          "text": "ועי\"ז יהי' לע\"ל מעשה גדול."
        }
      ]
    }
  ]
}