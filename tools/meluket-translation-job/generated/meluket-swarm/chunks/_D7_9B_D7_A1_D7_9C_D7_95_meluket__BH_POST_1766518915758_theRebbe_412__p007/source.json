{
  "globalIndex": 351,
  "owner": 1,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915758_theRebbe_412__p007",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915758_theRebbe_412__p007",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915758_theRebbe_412",
  "title": "מאמר להבין ענין נרות חנוכה תשכ\"ו",
  "part": 7,
  "sections": [
    {
      "v": 18,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ב)"
        },
        {
          "s": 2,
          "text": "ועד\"ז הוא הגילוי דחנוכה,"
        },
        {
          "s": 3,
          "text": "ובפרט הגילוי דנרות חנוכה שתקנום מפני הנס שהי' בשמן,"
        },
        {
          "s": 4,
          "text": "שהוא הגילוי דפנימיות עתיק."
        },
        {
          "s": 5,
          "text": "וזה שמבואר בהדרושים"
        },
        {
          "s": 6,
          "text": "(הובאו לעיל סעיף ב)"
        },
        {
          "s": 7,
          "text": "שהמעלה דנרות חנוכה"
        },
        {
          "s": 8,
          "text": "(לגבי נרות המקדש)"
        },
        {
          "s": 9,
          "text": "הוא שהגילוי דנרות חנוכה הוא למעלה מהשתלשלות,"
        },
        {
          "s": 10,
          "text": "אף שכללות הכתר"
        },
        {
          "s": 11,
          "text": "(גם אריך ומכ\"ש חיצוניות עתיק)"
        },
        {
          "s": 12,
          "text": "הוא למעלה מהשתלשלות,"
        },
        {
          "s": 13,
          "text": "יש לומר,"
        },
        {
          "s": 14,
          "text": "כי הענין דלמעלה מהשתלשלות הוא שהוא בכל מקום"
        },
        {
          "s": 15,
          "text": "(למעלה ולמטה)"
        },
        {
          "s": 16,
          "text": "בשוה,"
        },
        {
          "s": 17,
          "text": "וענין זה הוא בעיקר בפנימיות עתיק."
        },
        {
          "s": 18,
          "text": "שהגילוי דחיצוניות עתיק הוא"
        },
        {
          "s": 19,
          "text": "(בעיקר)"
        },
        {
          "s": 20,
          "text": "למעלה,"
        },
        {
          "s": 21,
          "text": "אלא שנמשך ופועל גם למטה."
        },
        {
          "s": 22,
          "text": "וכנ\"ל"
        },
        {
          "s": 23,
          "text": "(סעיף יו\"ד)"
        },
        {
          "s": 24,
          "text": "בענין הגילוי שהאיר ע\"י שלמה"
        },
        {
          "s": 25,
          "text": "(הגילוי דחיצוניות עתיק),"
        },
        {
          "s": 26,
          "text": "שעיקר הגילוי הי' בירושלים,"
        },
        {
          "s": 27,
          "text": "אלא שנמשך ופעל גם בשבא."
        },
        {
          "s": 28,
          "text": "ועיקר הענין דלמעלה מהשתלשלות"
        },
        {
          "s": 29,
          "text": "(שהוא בכל מקום בשוה),"
        },
        {
          "s": 30,
          "text": "הוא בפנימיות עתיק,"
        },
        {
          "s": 31,
          "text": "שהוא עצמו נמצא גם למטה."
        },
        {
          "s": 32,
          "text": "ויתירה מזה,"
        },
        {
          "s": 33,
          "text": "שלגבי הגילוי דפנימיות עתיק לא ישנו החילוק דמעלה ומטה75,"
        },
        {
          "s": 34,
          "text": "כי ע\"י הגילוי דפנימיות עתיק נרגש בכל דבר שהמציאות שלו גופא היא אלקות."
        }
      ]
    },
    {
      "v": 19,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ג)"
        },
        {
          "s": 2,
          "text": "וזהו שנר חנוכה מצוה להניחה על פתח ביתו מבחוץ,"
        },
        {
          "s": 3,
          "text": "לרשות הרבים"
        },
        {
          "s": 4,
          "text": "[לא כנרות המקדש שהיו בפנים ומשם האירו לחוץ],"
        },
        {
          "s": 5,
          "text": "כי זה שהאור דנרות חנוכה מאיר את החושך דרשות הרבים הוא באופן שהוא עצמו נמצא"
        },
        {
          "s": 6,
          "text": "(גם)"
        },
        {
          "s": 7,
          "text": "ברשות הרבים."
        },
        {
          "s": 8,
          "text": "וזהו גם שזמן הדלקתם הוא משתשקע החמה,"
        },
        {
          "s": 9,
          "text": "כי זה שהאור דנרות חנוכה מאיר את חושך הלילה הוא"
        },
        {
          "s": 10,
          "text": "(לא באופן שעיקרו של האור הוא ביום אלא שנמשך ומאיר גם בלילה,"
        },
        {
          "s": 11,
          "text": "אלא)"
        },
        {
          "s": 12,
          "text": "שגם בזמן החושך ישנו האור עצמו."
        },
        {
          "s": 13,
          "text": "ויתירה מזה,"
        },
        {
          "s": 14,
          "text": "דע\"י שהאור דנ\"ח הוא גם במקום וזמן החושך"
        },
        {
          "s": 15,
          "text": "(רשות הרבים ולילה),"
        },
        {
          "s": 16,
          "text": "החושך עצמו נהפך לאור."
        }
      ]
    },
    {
      "v": 20,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ד)"
        },
        {
          "s": 2,
          "text": "ועפ\"ז יש לבאר הטעם על זה שהמשכת גילוי זה היתה דוקא ע\"י המס\"נ דמתתי' ובניו"
        },
        {
          "s": 3,
          "text": "[ולא ע\"י המס\"נ דפורים],"
        },
        {
          "s": 4,
          "text": "כי המס\"נ דמתתי' ובניו היתה שהגם שהיו חלשים ומעטים מ\"מ לחמו נגד גבורים ורבים."
        },
        {
          "s": 5,
          "text": "דזה שעשו פעולה בדרכי הטבע"
        },
        {
          "s": 6,
          "text": "(מלחמה)"
        },
        {
          "s": 7,
          "text": "בכדי לנצח את היונים,"
        },
        {
          "s": 8,
          "text": "הגם שע\"פ טבע אין מקום שחלשים ומעטים ינצחו גבורים ורבים,"
        },
        {
          "s": 9,
          "text": "הוא,"
        },
        {
          "s": 10,
          "text": "כי הי' מונח אצלם"
        },
        {
          "s": 11,
          "text": "(אָפּגעלייגט)"
        },
        {
          "s": 12,
          "text": "שגם הטבע"
        },
        {
          "s": 13,
          "text": "[דעוה\"ז התחתון שהקליפות גוברים בו76,"
        },
        {
          "s": 14,
          "text": "ואפילו כשהעולם הוא במצב כזה שהמנגדים הם גבורים ורבים],"
        },
        {
          "s": 15,
          "text": "הוא אלקות,"
        },
        {
          "s": 16,
          "text": "דהנחה זו היא77"
        },
        {
          "s": 17,
          "text": "מצד ההרגש שאמיתת המצאו ית' הוא המציאות דכל הנמצאים."
        },
        {
          "s": 18,
          "text": "ולכן,"
        },
        {
          "s": 19,
          "text": "עי\"ז המשיכו הגילוי דפנימיות עתיק."
        }
      ]
    }
  ]
}