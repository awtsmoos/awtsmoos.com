{
  "globalIndex": 282,
  "owner": 32,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915410_theRebbe_669__p002",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915410_theRebbe_669__p002",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915410_theRebbe_669",
  "title": "מאמר פדה בשלום תשמ\"ו",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה ידוע הביאור דבעל הגאולה במאמרו ד\"ה זה"
        },
        {
          "s": 2,
          "text": "(שנדפס בספרו שערי תשובה9),"
        },
        {
          "s": 3,
          "text": "שההדגשה בהכתוב פדה בשלום נפשי היא"
        },
        {
          "s": 4,
          "text": "(נוסף על ענין הפדי',"
        },
        {
          "s": 5,
          "text": "גם)"
        },
        {
          "s": 6,
          "text": "באופן הפדי',"
        },
        {
          "s": 7,
          "text": "שהפדי' היא בשלום בלא מלחמה כלל וכלל10."
        },
        {
          "s": 8,
          "text": "ומבאר שם11,"
        },
        {
          "s": 9,
          "text": "שאמיתית ענין השלום הוא שאין לו מנגד כלל."
        },
        {
          "s": 10,
          "text": "וע\"ד שהי' בימי שלמה,"
        },
        {
          "s": 11,
          "text": "שכל הגוים היו בטלים אליו."
        },
        {
          "s": 12,
          "text": "ולכאורה הכוונה,"
        },
        {
          "s": 13,
          "text": "דכל זמן שיש לו מנגדים,"
        },
        {
          "s": 14,
          "text": "גם כשבפועל אינם לוחמים עמו"
        },
        {
          "s": 15,
          "text": "(מפני שנפל עליהם אימתו ופחדו12"
        },
        {
          "s": 16,
          "text": "וכיו\"ב),"
        },
        {
          "s": 17,
          "text": "אין זה אמיתית ענין השלום13."
        },
        {
          "s": 18,
          "text": "כי כשישנם מנגדים יש אפשרות ונתינת מקום למלחמה,"
        },
        {
          "s": 19,
          "text": "ואמיתית ענין השלום הוא"
        },
        {
          "s": 20,
          "text": "(לא רק שבפועל לא ישנה מלחמה,"
        },
        {
          "s": 21,
          "text": "אלא)"
        },
        {
          "s": 22,
          "text": "שאין"
        },
        {
          "s": 23,
          "text": "(גם)"
        },
        {
          "s": 24,
          "text": "אפשרות ונתינת מקום למלחמה."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "וזהו שענין השלום הי' בימי שלמה דוקא,"
        },
        {
          "s": 1,
          "text": "שלכן נקרא בשם שלמה כי שלום הי' בימיו14,"
        },
        {
          "s": 2,
          "text": "כי כל הגוים נתבטלו לגבי שלמה"
        },
        {
          "s": 3,
          "text": "(מצד עוצם גדולתו),"
        },
        {
          "s": 4,
          "text": "וכשהמנגד מתבטל"
        },
        {
          "s": 5,
          "text": "(שאז אין נתינת מקום שילחום),"
        },
        {
          "s": 6,
          "text": "אז הוא אמיתית ענין השלום."
        },
        {
          "s": 7,
          "text": "וזהו שאמר הקב\"ה לדוד המלך"
        },
        {
          "s": 8,
          "text": "(כשרצה לבנות בית המקדש)"
        },
        {
          "s": 9,
          "text": "לא תבנה בית לשמי כי איש מלחמות אתה15,"
        },
        {
          "s": 10,
          "text": "הגם שאז"
        },
        {
          "s": 11,
          "text": "(כשרצה דוד לבנות ביהמ\"ק)"
        },
        {
          "s": 12,
          "text": "הי' במצב של מנוחה,"
        },
        {
          "s": 13,
          "text": "וה' הניח לו מסביב מכל אויביו16,"
        },
        {
          "s": 14,
          "text": "כי המנוחה דדוד באה ע\"י שנצח כל המלחמות,"
        },
        {
          "s": 15,
          "text": "ולא שאויביו נתבטלו17."
        },
        {
          "s": 16,
          "text": "וכיון שבימיו נשארו עדיין מנגדים"
        },
        {
          "s": 17,
          "text": "(ויש נתינת מקום שילחמו),"
        },
        {
          "s": 18,
          "text": "אין זה אמיתית הענין דמנוחה ושלום."
        },
        {
          "s": 19,
          "text": "וזהו פדה בשלום נפשי,"
        },
        {
          "s": 20,
          "text": "דענין הפדי' בשלום הוא שהמנגד מתבטל,"
        },
        {
          "s": 21,
          "text": "כמו שהי' בימי שלמה."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "וממשיך בהמאמר18,"
        },
        {
          "s": 1,
          "text": "שאמיתית הענין דפדה בשלום נפשי הוא,"
        },
        {
          "s": 2,
          "text": "שאלו שהיו מקודם שונאים ומנגדים הם נעשים אוהבים."
        },
        {
          "s": 3,
          "text": "דענין זה הוא למעלה גם מהשלום שהי' בימי שלמה19,"
        },
        {
          "s": 4,
          "text": "שהשלום שהי' בימי שלמה הוא שכולם נתבטלו מצד הגילוי אור"
        },
        {
          "s": 5,
          "text": "(אבל לא נהפכו לקדושה)20,"
        },
        {
          "s": 6,
          "text": "ואמיתית ענין השלום"
        },
        {
          "s": 7,
          "text": "(שגם המנגד נהפך לקדושה)"
        },
        {
          "s": 8,
          "text": "יהי' לעתיד לבוא,"
        },
        {
          "s": 9,
          "text": "כמ\"ש21"
        },
        {
          "s": 10,
          "text": "אז אהפוך אל עמים שפה ברורה גו' לעבדו שכם אחד."
        },
        {
          "s": 11,
          "text": "ומה שאמר דוד פדה בשלום נפשי"
        },
        {
          "s": 12,
          "text": "[הגם שבימיו לא נתבטלו המנגדים ומכ\"ש שלא נהפכו לקדושה,"
        },
        {
          "s": 13,
          "text": "דענין זה לא הי' אפילו בימי שלמה ויהי' רק לע\"ל],"
        },
        {
          "s": 14,
          "text": "מבואר בהמאמר דבעל הגאולה22,"
        },
        {
          "s": 15,
          "text": "שזה קאי על נפש דוד כמו שיהי' לע\"ל."
        }
      ]
    }
  ]
}