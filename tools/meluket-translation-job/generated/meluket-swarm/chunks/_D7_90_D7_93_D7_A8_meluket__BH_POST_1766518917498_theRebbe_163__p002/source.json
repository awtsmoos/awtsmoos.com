{
  "globalIndex": 644,
  "owner": 44,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917498_theRebbe_163__p002",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917498_theRebbe_163__p002",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917498_theRebbe_163",
  "title": "מאמר בלילה ההוא תשד\"מ",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 2,
          "text": "דביאור ענין השינה למעלה יובן מענין השינה באדם למטה,"
        },
        {
          "s": 3,
          "text": "מבשרי אחזה אלקה18."
        },
        {
          "s": 4,
          "text": "והנה החילוק בין ער לישן באדם התחתון אינו בנוגע לעצם מציאותו,"
        },
        {
          "s": 5,
          "text": "שהרי גם בעת השינה מציאותו היא בשלימות."
        },
        {
          "s": 6,
          "text": "שבעת השינה ישנם כל אבריו וגידיו"
        },
        {
          "s": 7,
          "text": "(וגם החיות שבהם),"
        },
        {
          "s": 8,
          "text": "וישנם אז כל כחות הנפש,"
        },
        {
          "s": 9,
          "text": "ופועלים פעולתם."
        },
        {
          "s": 10,
          "text": "וכמו שרואים במוחש בענין החלומות,"
        },
        {
          "s": 11,
          "text": "שיש בהם הפעולה דכל הכחות,"
        },
        {
          "s": 12,
          "text": "שכל ומדות וכו' וגם רצון ותענוג19."
        },
        {
          "s": 13,
          "text": "ועד דכאשר הוא זוכה,"
        },
        {
          "s": 14,
          "text": "השכל שמשכיל בחלום הוא שכל אמיתי20,"
        },
        {
          "s": 15,
          "text": "וכן הוא גם בנוגע לתענוג21"
        },
        {
          "s": 16,
          "text": "ורצון."
        },
        {
          "s": 17,
          "text": "אבל גם מי שאינו בדרגא זו,"
        },
        {
          "s": 18,
          "text": "הרי רואים במוחש שגם בהחלומות שלו ישנם מדות שכל רצון ותענוג בנוגע לענינים שישנם במציאות"
        },
        {
          "s": 19,
          "text": "(משא\"כ ענינים דנמנעות,"
        },
        {
          "s": 20,
          "text": "כמו פילא דעייל בקופא דמחטא,"
        },
        {
          "s": 21,
          "text": "א\"א להיות גם בחלום22)."
        },
        {
          "s": 22,
          "text": "והחילוק שבין ער לישן הוא,"
        },
        {
          "s": 23,
          "text": "דבעת שהוא ער,"
        },
        {
          "s": 24,
          "text": "כל עניניו הם באופן מסודר,"
        },
        {
          "s": 25,
          "text": "ומכש\"כ שאין שייך שיהיו שני ענינים הפכיים בבת אחת ובחיבור אחד ואפילו לא בהמשך אחד."
        },
        {
          "s": 26,
          "text": "וכאשר כל הענינים והכחות הם באופן מסודר,"
        },
        {
          "s": 27,
          "text": "ניכר אז החילוק שביניהם ומעלת הכחות זה על זה."
        },
        {
          "s": 28,
          "text": "משא\"כ בעת השינה,"
        },
        {
          "s": 29,
          "text": "בחלום,"
        },
        {
          "s": 30,
          "text": "יכול להיות חיבור שני כחות הפכיים"
        },
        {
          "s": 31,
          "text": "(כח היותר עליון עם כח היותר תחתון),"
        },
        {
          "s": 32,
          "text": "ועד לחיבור כמה וכמה כחות יחד באופן בלתי מסודר,"
        },
        {
          "s": 33,
          "text": "ומכש\"כ שאין ניכר המעלה והיתרון שבכחות הנעלים על הכחות שלמטה מהם."
        },
        {
          "s": 34,
          "text": "והדוגמא מזה יובן למעלה,"
        },
        {
          "s": 35,
          "text": "דענין השינה הוא שאין ניכר כביכול המעלה והיתרון של ענינים הנעלים."
        },
        {
          "s": 36,
          "text": "וזהו מהקשר דענין הגלות עם ענין השינה"
        },
        {
          "s": 37,
          "text": "(וכנ\"ל שבזמן הגלות הו\"ע השינה למעלה),"
        },
        {
          "s": 38,
          "text": "כי סיבת הגלות היא ע\"י זה שאין ניכרת אז המעלה דישראל."
        },
        {
          "s": 39,
          "text": "דישראל הם בנים למקום כמ\"ש23"
        },
        {
          "s": 40,
          "text": "בנים אתם לה' אלקיכם24,"
        },
        {
          "s": 41,
          "text": "ועכ\"פ עבדיו של הקב\"ה25,"
        },
        {
          "s": 42,
          "text": "כמאמר26"
        },
        {
          "s": 43,
          "text": "אם כבנים אם כעבדים,"
        },
        {
          "s": 44,
          "text": "שגם עבד מלך הוא מלך27"
        },
        {
          "s": 45,
          "text": "(לא רק כמלך28"
        },
        {
          "s": 46,
          "text": "(בכ\"ף הדמיון)"
        },
        {
          "s": 47,
          "text": "אלא מלך),"
        },
        {
          "s": 48,
          "text": "ובנים צריכים להיות סמוכים על שולחן אביהם וכן עבדים על שולחן אדונם,"
        },
        {
          "s": 49,
          "text": "והסיבה לזה שגלו מעל שולחן אביהם29"
        },
        {
          "s": 50,
          "text": "ואדונם,"
        },
        {
          "s": 51,
          "text": "הו\"ע השינה,"
        },
        {
          "s": 52,
          "text": "שאין ניכר,"
        },
        {
          "s": 53,
          "text": "כביכול,"
        },
        {
          "s": 54,
          "text": "למעלה העילוי דישראל,"
        },
        {
          "s": 55,
          "text": "ומזה נעשה ענין הגלות."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר30,"
        },
        {
          "s": 2,
          "text": "דזה שבעת השינה אין ניכר מעלת הכחות זה על זה הוא בדוגמת הכחות כמו שהם כלולים בעצם הנפש,"
        },
        {
          "s": 3,
          "text": "ששם כל הכחות הם בהשוואה."
        },
        {
          "s": 4,
          "text": "והיינו דענין התעלמות הכחות שבעת השינה הוא מה שהכחות מתעלים ומסתלקים לשרשם,"
        },
        {
          "s": 5,
          "text": "עצם הנפש."
        },
        {
          "s": 6,
          "text": "ומזה מובן גם בהנמשל31,"
        },
        {
          "s": 7,
          "text": "דענין ההתעלמות שבזמן הגלות"
        },
        {
          "s": 8,
          "text": "(שינה)"
        },
        {
          "s": 9,
          "text": "הוא מה שהגילויים מתעלים למקורם,"
        },
        {
          "s": 10,
          "text": "ועד להעצמות."
        },
        {
          "s": 11,
          "text": "וכידוע מאמר הזהר32"
        },
        {
          "s": 12,
          "text": "עה\"פ33"
        },
        {
          "s": 13,
          "text": "כי איננו,"
        },
        {
          "s": 14,
          "text": "דקוב\"ה סליק לעילא,"
        },
        {
          "s": 15,
          "text": "שעלה למקומו,"
        },
        {
          "s": 16,
          "text": "חדר לפנים מחדר34."
        },
        {
          "s": 17,
          "text": "והיינו,"
        },
        {
          "s": 18,
          "text": "דענין ההתעלמות שבזמן הגלות הוא רק לגבי למטה,"
        },
        {
          "s": 19,
          "text": "שבזמן הגלות מסתלק האור למעלה ואינו מאיר למטה"
        },
        {
          "s": 20,
          "text": "(שלכן נעשה גלות),"
        },
        {
          "s": 21,
          "text": "אבל לגבי האור עצמו,"
        },
        {
          "s": 22,
          "text": "הרי אדרבא,"
        },
        {
          "s": 23,
          "text": "דוקא בזמן הגלות הוא סליק לעילא."
        },
        {
          "s": 24,
          "text": "ובדוגמת הסילוק דשינה באדם התחתון,"
        },
        {
          "s": 25,
          "text": "שהסילוק הוא רק לגבי הגוף"
        },
        {
          "s": 26,
          "text": "(שאור הנפש מסתלק מהגוף),"
        },
        {
          "s": 27,
          "text": "אבל לגבי הנפש,"
        },
        {
          "s": 28,
          "text": "הרי אדרבא,"
        },
        {
          "s": 29,
          "text": "דוקא בעת השינה הנפש עולה למעלה ושואבת לה חיים35."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "וביאור הענין,"
        },
        {
          "s": 1,
          "text": "הנה כללות סדר ההשתלשלות הוא בדוגמת הדרגות דכחות הנפש."
        },
        {
          "s": 2,
          "text": "דכמו שבכחות הנפש,"
        },
        {
          "s": 3,
          "text": "התחלת מציאות הכחות היא כמו שהם כלולים בנפש ששם הם כולם בהשוואה,"
        },
        {
          "s": 4,
          "text": "ואח\"כ הם נמשכים בגילוי להתלבש באברי הגוף ואז דוקא נעשה בהם ענין ההתחלקות,"
        },
        {
          "s": 5,
          "text": "ובכחות הגלויים גופא יש כמה אופנים,"
        },
        {
          "s": 6,
          "text": "כמו שהם בגילוי באופן מסודר"
        },
        {
          "s": 7,
          "text": "(בעת שהאדם ער)"
        },
        {
          "s": 8,
          "text": "וכמו שהם בהעלם,"
        },
        {
          "s": 9,
          "text": "במצב של שינה,"
        },
        {
          "s": 10,
          "text": "ועד שלפעמים הם במצב של התעלפות ר\"ל,"
        },
        {
          "s": 11,
          "text": "עד\"ז גם למעלה ישנם כל דרגות אלו,"
        },
        {
          "s": 12,
          "text": "כמרז\"ל36"
        },
        {
          "s": 13,
          "text": "מה הנשמה ממלאה את הגוף כך הקב\"ה ממלא את העולם,"
        },
        {
          "s": 14,
          "text": "דהתחלת הספירות הוא כמו שהם כלולים באוא\"ס ב\"ה,"
        },
        {
          "s": 15,
          "text": "ושם הם למעלה מהתחלקות,"
        },
        {
          "s": 16,
          "text": "ולאחרי שנמשכים באצילות,"
        },
        {
          "s": 17,
          "text": "עם היות שאצילות הוא עולם האחדות,"
        },
        {
          "s": 18,
          "text": "נעשה בהם ענין ההגבלה וההתחלקות,"
        },
        {
          "s": 19,
          "text": "עשר ולא תשע עשר ולא אחד עשר37,"
        },
        {
          "s": 20,
          "text": "ואז דוקא ניכרת מעלת הספירות זו על זו,"
        },
        {
          "s": 21,
          "text": "ומכש\"כ כשהם נמשכים בעולמות בי\"ע שלמטה מעולם האחדות,"
        },
        {
          "s": 22,
          "text": "שאז הם בהתחלקות יותר."
        },
        {
          "s": 23,
          "text": "ומזה משתלשל ההתחלקות בעוה\"ז,"
        },
        {
          "s": 24,
          "text": "דבית המקדש הוא מקום הכי מובחר שבעולם וממנו אורה יוצאת לכל העולם38,"
        },
        {
          "s": 25,
          "text": "דהעולם מצד עצמו הוא עולם מלשון העלם והסתר39"
        },
        {
          "s": 26,
          "text": "ונמשך בו אור מביהמ\"ק שהוא נשמת העולם"
        },
        {
          "s": 27,
          "text": "(בדוגמת ענין ההשתלשלות בספירות,"
        },
        {
          "s": 28,
          "text": "דספירה התחתונה מקבלת מהספירה שלמעלה ממנה),"
        },
        {
          "s": 29,
          "text": "ואז ניכר גם המעלה דישראל,"
        },
        {
          "s": 30,
          "text": "המעלה דבנים אתם להוי' אלקיכם והמעלה דעבדי הם,"
        },
        {
          "s": 31,
          "text": "עבדים נאמנים להשם אדונם."
        },
        {
          "s": 32,
          "text": "דכ\"ז הוא דוגמת כחות הגלויים דנפש האדם בעת שהוא ער,"
        },
        {
          "s": 33,
          "text": "משא\"כ בזמן הגלות,"
        },
        {
          "s": 34,
          "text": "הענינים שלמעלה"
        },
        {
          "s": 35,
          "text": "(שנמשכו בבחינת ההשתלשלות,"
        },
        {
          "s": 36,
          "text": "באצילות ובבי\"ע)"
        },
        {
          "s": 37,
          "text": "הם בדוגמת כחות הגלויים דנפש האדם בעת השינה,"
        },
        {
          "s": 38,
          "text": "שאז אפשר להיות חיבור הפכים,"
        },
        {
          "s": 39,
          "text": "ומזה נעשה ענין הגלות."
        }
      ]
    }
  ]
}