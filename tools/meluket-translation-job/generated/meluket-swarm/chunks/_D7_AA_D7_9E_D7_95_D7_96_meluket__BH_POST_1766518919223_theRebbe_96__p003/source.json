{
  "globalIndex": 918,
  "owner": 18,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919223_theRebbe_96__p003",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919223_theRebbe_96__p003",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919223_theRebbe_96",
  "title": "מאמר תפלה למשה תשכ\"ט",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים,"
        },
        {
          "s": 2,
          "text": "דענין העשירות בפשטות הוא,"
        },
        {
          "s": 3,
          "text": "כמובא לעיל"
        },
        {
          "s": 4,
          "text": "(סעיף ג)"
        },
        {
          "s": 5,
          "text": "מהמאמר,"
        },
        {
          "s": 6,
          "text": "שהעשיר יש לו לא רק די צרכיו אלא שהוא מושפע בריבוי השפע."
        },
        {
          "s": 7,
          "text": "ועפ\"ז,"
        },
        {
          "s": 8,
          "text": "החילוק בין עני גם כשיש לו די מחסורו לעשיר הוא בשני ענינים."
        },
        {
          "s": 9,
          "text": "שגם באותם הדברים שישנם גם להעני,"
        },
        {
          "s": 10,
          "text": "אינו דומה להעשיר."
        },
        {
          "s": 11,
          "text": "דהעני מצד עצמו הוא חסר גם דברים אלה"
        },
        {
          "s": 12,
          "text": "(כנ\"ל שם),"
        },
        {
          "s": 13,
          "text": "ורק שבפועל ישנם לו דברים אלה."
        },
        {
          "s": 14,
          "text": "ושהעשיר הוא מושפע בריבוי השפע – ריבוי שפע שלא ישנו כלל לעני."
        },
        {
          "s": 15,
          "text": "ולכאורה צריך לומר,"
        },
        {
          "s": 16,
          "text": "דברוחניות,"
        },
        {
          "s": 17,
          "text": "שני הענינים תלויים זה בזה."
        },
        {
          "s": 18,
          "text": "שבכדי שהענינים שהוא מוכרח בהם"
        },
        {
          "s": 19,
          "text": "(די מחסורו)"
        },
        {
          "s": 20,
          "text": "יהיו אצלו לא באופן שמקבל אותם משל אחרים אלא מצד עצמו,"
        },
        {
          "s": 21,
          "text": "הוא דוקא ע\"י ריבוי השפע שלמעלה ממילוי החסרון."
        },
        {
          "s": 22,
          "text": "והענין בעבודה הוא,"
        },
        {
          "s": 23,
          "text": "דכשהעבודה של האדם היא רק כפי השגת השכל שלו,"
        },
        {
          "s": 24,
          "text": "אזי,"
        },
        {
          "s": 25,
          "text": "נוסף לזה שהעבודה היא במדידה והגבלה"
        },
        {
          "s": 26,
          "text": "(די מחסורו),"
        },
        {
          "s": 27,
          "text": "הוא חסר"
        },
        {
          "s": 28,
          "text": "(בפנימיות)"
        },
        {
          "s": 29,
          "text": "גם עבודה זו,"
        },
        {
          "s": 30,
          "text": "כיון שמצד ההשגה יש נתינת מקום לההיפך."
        },
        {
          "s": 31,
          "text": "ובכדי שתהי' עבודתו את ה' באופן שלא ישאר בו שום נתינת מקום לההיפך הוא דוקא ע\"י העבודה שלמעלה ממדידה והגבלה – עשירות."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ובכדי לבאר ענין העשירות שלמעלה ממילוי החסרון,"
        },
        {
          "s": 1,
          "text": "מקדים בהמאמר46,"
        },
        {
          "s": 2,
          "text": "שגם במילוי החסרון יש שני ענינים,"
        },
        {
          "s": 3,
          "text": "כמ\"ש די מחסורו אשר יחסר לו ואמרו רז\"ל אשר יחסר לו אפילו סוס לרכוב עליו ועבד לרוץ לפניו."
        },
        {
          "s": 4,
          "text": "והיינו שדי מחסורו הוא שצריך לספק לו כל הדברים הנצרכים לכל אחד,"
        },
        {
          "s": 5,
          "text": "ולאח\"ז מוסיף אשר יחסר לו,"
        },
        {
          "s": 6,
          "text": "שצריך לספק לו גם זה אשר יחסר לו."
        },
        {
          "s": 7,
          "text": "(סוס לרכוב עליו ועבד לרוץ לפניו)"
        },
        {
          "s": 8,
          "text": "מצד זה שדרכו בכך47."
        },
        {
          "s": 9,
          "text": "ועשירות הוא ריבוי שפע,"
        },
        {
          "s": 10,
          "text": "למעלה גם מאשר יחסר לו."
        },
        {
          "s": 11,
          "text": "ומבאר,"
        },
        {
          "s": 12,
          "text": "דג' ענינים אלה"
        },
        {
          "s": 13,
          "text": "[שני הענינים שבמילוי החסרון ועשירות]"
        },
        {
          "s": 14,
          "text": "ישנם גם למעלה"
        },
        {
          "s": 15,
          "text": "[וכידוע48"
        },
        {
          "s": 16,
          "text": "שכל הענינים שלמטה משתלשלים מענינם למעלה]."
        },
        {
          "s": 17,
          "text": "והענין הוא,"
        },
        {
          "s": 18,
          "text": "דבהגילויים שלמעלה יש ג' מדריגות בכללות."
        },
        {
          "s": 19,
          "text": "ממלא כל עלמין,"
        },
        {
          "s": 20,
          "text": "סובב כל עלמין ועצמות אוא\"ס שלמעלה מממלא וסובב."
        },
        {
          "s": 21,
          "text": "ממכ\"ע הוא האור המתלבש בעולמות ובהנבראים להחיות אותם לפי ערכם."
        },
        {
          "s": 22,
          "text": "וכמרז\"ל49"
        },
        {
          "s": 23,
          "text": "מה הנפש ממלאה את הגוף כך הקב\"ה ממלא את העולם,"
        },
        {
          "s": 24,
          "text": "דכמו שחיות הנפש המתלבש בהגוף הוא לפי אופן אברי הגוף,"
        },
        {
          "s": 25,
          "text": "דבכל אבר החיות הוא לפי ערכו,"
        },
        {
          "s": 26,
          "text": "עד\"ז הוא בהחיות דממלא כל עלמין,"
        },
        {
          "s": 27,
          "text": "שהוא מחי' כל עולם וכל נברא לפי ערכו50."
        },
        {
          "s": 28,
          "text": "וסוכ\"ע הוא האור שלמעלה מהתלבשות בעולמות,"
        },
        {
          "s": 29,
          "text": "שלכן הוא סובב ומקיף את העולמות בשוה,"
        },
        {
          "s": 30,
          "text": "אבל שייך לעולמות"
        },
        {
          "s": 31,
          "text": "(שלכן נקרא בשם סובב כל עלמין)."
        },
        {
          "s": 32,
          "text": "והוא ע\"ד חיות הנפש עצמה,"
        },
        {
          "s": 33,
          "text": "מה שהנפש היא חי בעצם,"
        },
        {
          "s": 34,
          "text": "דהגם שהוא למעלה באין ערוך מהחיות המתפשט ומתלבש בגוף,"
        },
        {
          "s": 35,
          "text": "מ\"מ הוא כמו מקור שממנו נמשך החיות המתפשט ומתלבש בהגוף."
        },
        {
          "s": 36,
          "text": "ובחינה זו נקראת בשם חַי עולמים"
        },
        {
          "s": 37,
          "text": "(חַי בפתח)."
        },
        {
          "s": 38,
          "text": "דהחילוק בין חַי"
        },
        {
          "s": 39,
          "text": "(בפתח)"
        },
        {
          "s": 40,
          "text": "לחֵי"
        },
        {
          "s": 41,
          "text": "(בצירי)"
        },
        {
          "s": 42,
          "text": "הוא,"
        },
        {
          "s": 43,
          "text": "דבחֵי עולמים בצירי,"
        },
        {
          "s": 44,
          "text": "תיבת חֵי דבוקה לעולמים,"
        },
        {
          "s": 45,
          "text": "היינו החיות של העולמות – ממלא,"
        },
        {
          "s": 46,
          "text": "ובחַי עולמים בפתח,"
        },
        {
          "s": 47,
          "text": "תיבת חַי אינה דבוקה לעולמים,"
        },
        {
          "s": 48,
          "text": "היינו בחינת חי בעצם – סובב."
        },
        {
          "s": 49,
          "text": "ויש לומר,"
        },
        {
          "s": 50,
          "text": "דזה שגם בחינת חי בעצם"
        },
        {
          "s": 51,
          "text": "(סובב)"
        },
        {
          "s": 52,
          "text": "נק' חי עולמים הוא לפי שהוא כמו מקור שממנו נמשך החיות דהעולמות."
        },
        {
          "s": 53,
          "text": "ומוסיף בהמאמר51,"
        },
        {
          "s": 54,
          "text": "דבחינת הסובב נק' גם בשם חיי החיים."
        },
        {
          "s": 55,
          "text": "דחיים הוא החיות המתפשט ומתלבש בעולמות"
        },
        {
          "s": 56,
          "text": "(ממלא),"
        },
        {
          "s": 57,
          "text": "ובחינת הסובב שממנו נמשך החיות דהעולמות נק' חיי החיים."
        },
        {
          "s": 58,
          "text": "וזהו שארז\"ל52"
        },
        {
          "s": 59,
          "text": "מחי' חיים יתן לך חיים,"
        },
        {
          "s": 60,
          "text": "דמחי' חיים"
        },
        {
          "s": 61,
          "text": "(בחינת חיי החיים)"
        },
        {
          "s": 62,
          "text": "הוא המקור שמשם נמשכים חיים."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "וזהו שארז\"ל53"
        },
        {
          "s": 1,
          "text": "ע\"פ54"
        },
        {
          "s": 2,
          "text": "מזמור שיר ליום השבת,"
        },
        {
          "s": 3,
          "text": "מזמור שיר לעתיד לבוא ליום שכולו שבת ומנוחה לחי העולמים,"
        },
        {
          "s": 4,
          "text": "חַי העולמים בפתח55"
        },
        {
          "s": 5,
          "text": "הוא בחינת הסובב,"
        },
        {
          "s": 6,
          "text": "ולע\"ל תהי' שביתה ומנוחה גם מבחינת חי העולמים,"
        },
        {
          "s": 7,
          "text": "כי אז יהי' גילוי עצמות אוא\"ס שלמעלה משייכות לעולמות"
        },
        {
          "s": 8,
          "text": "(למעלה גם מסובב)."
        },
        {
          "s": 9,
          "text": "וכמ\"ש56"
        },
        {
          "s": 10,
          "text": "יחיינו מיומיים ביום השלישי יקימנו ונחי' לפניו,"
        },
        {
          "s": 11,
          "text": "ואיתא בלקו\"ת57"
        },
        {
          "s": 12,
          "text": "דיומיים הם שני הגילויים דממכ\"ע וסוכ\"ע ויום השלישי הוא גילוי עצמות אוא\"ס שלמעלה משייכות לעולמות."
        },
        {
          "s": 13,
          "text": "דזהו ביום השלישי יקימנו ונחי' לפניו – פנימיות ועצמות א\"ס."
        },
        {
          "s": 14,
          "text": "[ולהעיר,"
        },
        {
          "s": 15,
          "text": "דפירוש הפשוט ביומיים ויום השלישי הוא שהם ג' זמנים."
        },
        {
          "s": 16,
          "text": "יומיים הם עולם הזה וגן עדן או עולם הזה וימות המשיח ויום השלישי הוא תחיית המתים58."
        },
        {
          "s": 17,
          "text": "והקשר דשני הפירושים הוא59,"
        },
        {
          "s": 18,
          "text": "שבשני הזמנים דיומיים הם הגילויים דממלא וסובב,"
        },
        {
          "s": 19,
          "text": "ובתחה\"מ יהי' גילוי העצמות]."
        }
      ]
    }
  ]
}