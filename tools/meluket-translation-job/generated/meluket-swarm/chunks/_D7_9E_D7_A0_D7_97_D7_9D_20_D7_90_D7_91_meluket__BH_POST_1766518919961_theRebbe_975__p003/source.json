{
  "globalIndex": 1049,
  "owner": 49,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919961_theRebbe_975__p003",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919961_theRebbe_975__p003",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919961_theRebbe_975",
  "title": "מאמר ועתה ישראל תשל\"ז",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "אך עדיין צריך להבין,"
        },
        {
          "s": 2,
          "text": "מהי השייכות דמה ה' אלקיך שואל מעמך למאה ברכות דוקא."
        },
        {
          "s": 3,
          "text": "ויובן זה בהקדים מ\"ש"
        },
        {
          "s": 4,
          "text": "(בתחלת הכתוב)"
        },
        {
          "s": 5,
          "text": "ועתה ישראל,"
        },
        {
          "s": 6,
          "text": "ועתה דוקא,"
        },
        {
          "s": 7,
          "text": "ומבאר הצ\"צ36"
        },
        {
          "s": 8,
          "text": "שועתה קאי על ימי שנותינו בעולם הזה,"
        },
        {
          "s": 9,
          "text": "וע\"ד מ\"ש בסיום פרשה הקודמת37"
        },
        {
          "s": 10,
          "text": "אשר אנכי מצוך היום לעשותם,"
        },
        {
          "s": 11,
          "text": "וארז\"ל38"
        },
        {
          "s": 12,
          "text": "היום לעשותם ולא למחר לעשותם."
        },
        {
          "s": 13,
          "text": "דהגם שקיום המצוות יהי' גם בימות המשיח39"
        },
        {
          "s": 14,
          "text": "(ואדרבה,"
        },
        {
          "s": 15,
          "text": "אז דוקא יהי' כמצות רצונך40),"
        },
        {
          "s": 16,
          "text": "מ\"מ,"
        },
        {
          "s": 17,
          "text": "קיום המצוות באופן דלעשותם,"
        },
        {
          "s": 18,
          "text": "עשי' מלשון כפי'41,"
        },
        {
          "s": 19,
          "text": "הוא דוקא היום,"
        },
        {
          "s": 20,
          "text": "כי לע\"ל יהי' ואת רוח הטומאה אעביר מן הארץ42"
        },
        {
          "s": 21,
          "text": "ובמילא לא תהי' העבודה דאתכפיא43."
        },
        {
          "s": 22,
          "text": "וזהו ועתה ישראל44,"
        },
        {
          "s": 23,
          "text": "ישראל הוא על שם כי שרית עם אלקים45,"
        },
        {
          "s": 24,
          "text": "ההשתררות על כל ההעלמות וההסתרים הנמשכים משם אלקים,"
        },
        {
          "s": 25,
          "text": "עד לההעלמות וההסתרים דנה\"ב ויצה\"ר המפתים את האדם לעשות ההיפך ח\"ו,"
        },
        {
          "s": 26,
          "text": "וענין ישראל הוא שהוא משתרר על הרצונות דנה\"ב,"
        },
        {
          "s": 27,
          "text": "ועד אשר ותוכל45."
        },
        {
          "s": 28,
          "text": "דבתחלה הם מנגדים והוא משתרר עליהם"
        },
        {
          "s": 29,
          "text": "(אתכפיא),"
        },
        {
          "s": 30,
          "text": "ואח\"כ ותוכל,"
        },
        {
          "s": 31,
          "text": "שהוא מנצח אותם"
        },
        {
          "s": 32,
          "text": "(אתהפכא)."
        },
        {
          "s": 33,
          "text": "וזהו ועתה ישראל,"
        },
        {
          "s": 34,
          "text": "שדוקא עתה שישנה מציאות הסט\"א נק' בשם ישראל על שם כי שרית גו' ותוכל,"
        },
        {
          "s": 35,
          "text": "אתכפיא סט\"א ואתהפכא סט\"א,"
        },
        {
          "s": 36,
          "text": "משא\"כ לע\"ל,"
        },
        {
          "s": 37,
          "text": "כיון שאת רוח הטומאה אעביר מן הארץ,"
        },
        {
          "s": 38,
          "text": "לא יקראו בשם ישראל"
        },
        {
          "s": 39,
          "text": "(שרית)"
        },
        {
          "s": 40,
          "text": "אלא בשם ישורון,"
        },
        {
          "s": 41,
          "text": "או בשם"
        },
        {
          "s": 42,
          "text": "(אחר)"
        },
        {
          "s": 43,
          "text": "אשר פי ה' יקבנו46,"
        },
        {
          "s": 44,
          "text": "כמבואר בארוכה בדרושי הצ\"צ47."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ואומר ועתה ישראל מה,"
        },
        {
          "s": 1,
          "text": "דזה שגם עתה כשישנה מציאות הסט\"א,"
        },
        {
          "s": 2,
          "text": "וגם בזמן הגלות ואפילו בעקבתא דמשיחא"
        },
        {
          "s": 3,
          "text": "(עתה ממש),"
        },
        {
          "s": 4,
          "text": "ביכלתו של כאו\"א מישראל להשתרר על כל המונעים ומעכבים ולנצחם"
        },
        {
          "s": 5,
          "text": "(שרית גו' ותוכל),"
        },
        {
          "s": 6,
          "text": "הוא מצד המ\"ה שבו,"
        },
        {
          "s": 7,
          "text": "בחינת יחידה."
        },
        {
          "s": 8,
          "text": "כי כיון שבחינת היחידה אין כנגדה לעומת זה48,"
        },
        {
          "s": 9,
          "text": "לכן,"
        },
        {
          "s": 10,
          "text": "ע\"י שמעורר היחידה שבו,"
        },
        {
          "s": 11,
          "text": "ביכלתו עתה להשתרר על כל המנגדים ולנצחם."
        },
        {
          "s": 12,
          "text": "וזהו מה שארז\"ל49"
        },
        {
          "s": 13,
          "text": "ישראל אע\"פ שחטא ישראל הוא"
        },
        {
          "s": 14,
          "text": "[שהוא לא רק יעקב אלא גם ישראל,"
        },
        {
          "s": 15,
          "text": "שם המעלה],"
        },
        {
          "s": 16,
          "text": "כי בכאו\"א מישראל,"
        },
        {
          "s": 17,
          "text": "גם כשחטא,"
        },
        {
          "s": 18,
          "text": "היחידה היא בשלימות"
        },
        {
          "s": 19,
          "text": "[וכפס\"ד הרמב\"ם הידוע50,"
        },
        {
          "s": 20,
          "text": "שכאו\"א מישראל,"
        },
        {
          "s": 21,
          "text": "גם כשיצרו תקפו לבטל מצוה"
        },
        {
          "s": 22,
          "text": "(ועד שבכדי שיקיים המצוה צריך לכופו ע\"י גוים),"
        },
        {
          "s": 23,
          "text": "הוא רוצה לעשות כל המצוות],"
        },
        {
          "s": 24,
          "text": "ולכן ישראל הוא,"
        },
        {
          "s": 25,
          "text": "שיש לו הכח להיות שרית גו' ותוכל."
        },
        {
          "s": 26,
          "text": "ומה שאמרו51"
        },
        {
          "s": 27,
          "text": "איזהו שוטה המאבד מה שנותנים לו,"
        },
        {
          "s": 28,
          "text": "ואיתא בלקו\"ת52"
        },
        {
          "s": 29,
          "text": "שקאי על המ\"ה שבנפש"
        },
        {
          "s": 30,
          "text": "[דע\"י53"
        },
        {
          "s": 31,
          "text": "שהוא שוטה,"
        },
        {
          "s": 32,
          "text": "אינו לוחם כנגד הרוח שטות שנכנס בו54,"
        },
        {
          "s": 33,
          "text": "הוא מאבד ח\"ו את המ\"ה שבו],"
        },
        {
          "s": 34,
          "text": "הכוונה בזה היא,"
        },
        {
          "s": 35,
          "text": "שהמ\"ה שבו הוא בהעלם ביותר."
        },
        {
          "s": 36,
          "text": "וכמובן גם מהלשון איזהו שוטה המאבד כו',"
        },
        {
          "s": 37,
          "text": "שהוא בדוגמת דבר האבוד,"
        },
        {
          "s": 38,
          "text": "שגם לאחרי שנאבד הוא בשלימות,"
        },
        {
          "s": 39,
          "text": "אלא שצריך למצאו55,"
        },
        {
          "s": 40,
          "text": "וע\"י החיפוש כדבעי – בודאי ימצאנו."
        },
        {
          "s": 41,
          "text": "וזהו מה ה' אלקיך שואל מעמך,"
        },
        {
          "s": 42,
          "text": "שה' אלקיך שואל ומבקש מעמך"
        },
        {
          "s": 43,
          "text": "(מכאו\"א מישראל)"
        },
        {
          "s": 44,
          "text": "שהמ\"ה שבו יהי' בגילוי."
        },
        {
          "s": 45,
          "text": "שלא יאבד ח\"ו את המ\"ה שנותנים לו,"
        },
        {
          "s": 46,
          "text": "וגם אם איבד ח\"ו – לחפש עד לגלות את המ\"ה ע\"י עשיית תשובה."
        },
        {
          "s": 47,
          "text": "ומדייק מעמך,"
        },
        {
          "s": 48,
          "text": "שגילוי המ\"ה יהי' ע\"י עבודתו דוקא56."
        },
        {
          "s": 49,
          "text": "דגם כשהתעוררות התשובה היא ע\"י הכרוזים שמכריזים מלמעלה57,"
        },
        {
          "s": 50,
          "text": "או ע\"י שמסבבים סיבות שונות לזה כמ\"ש58"
        },
        {
          "s": 51,
          "text": "וחשב מחשבות לבלתי ידח ממנו נדח,"
        },
        {
          "s": 52,
          "text": "הנה זהו רק ההכנה לתשובה,"
        },
        {
          "s": 53,
          "text": "אבל התשובה עצמה נעשית ע\"י עבודתו דוקא,"
        },
        {
          "s": 54,
          "text": "מעמך."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "והנה זה שמה ה' אלקיך שואל מעמך הוא עתה דוקא"
        },
        {
          "s": 2,
          "text": "(היום לעשותם),"
        },
        {
          "s": 3,
          "text": "אף שהשלימות דקיום המצוות"
        },
        {
          "s": 4,
          "text": "(כמצות רצונך)"
        },
        {
          "s": 5,
          "text": "תהי' דוקא בימות המשיח,"
        },
        {
          "s": 6,
          "text": "הוא,"
        },
        {
          "s": 7,
          "text": "בכדי שתהי' העבודה דאתכפיא סט\"א ואתהפכא סט\"א"
        },
        {
          "s": 8,
          "text": "(פי' ישראל),"
        },
        {
          "s": 9,
          "text": "שעי\"ז דוקא נשלמת הכוונה דנתאוה הקב\"ה להיות לו ית' דירה בתחתונים59."
        },
        {
          "s": 10,
          "text": "ואף שתכלית השלימות תהי' לע\"ל דוקא"
        },
        {
          "s": 11,
          "text": "(כנ\"ל),"
        },
        {
          "s": 12,
          "text": "הרי תכלית השלימות דלע\"ל הוא שאז יהי' גילוי עצמות אוא\"ס בעוה\"ז הגשמי,"
        },
        {
          "s": 13,
          "text": "תחתון שאין תחתון למטה ממנו60,"
        },
        {
          "s": 14,
          "text": "ושלימות זו נעשית ע\"י מעשינו ועבודתינו עכשיו61,"
        },
        {
          "s": 15,
          "text": "ע\"י בירור וזיכוך העולם כמו שהוא עכשיו דוקא."
        },
        {
          "s": 16,
          "text": "ובשביל זה ירדה הנשמה למטה,"
        },
        {
          "s": 17,
          "text": "שעיקר הכוונה בזה הוא לא בשביל עליית הנשמה שנעשית ע\"י הירידה,"
        },
        {
          "s": 18,
          "text": "אלא בכדי לברר ולזכך את הגוף ונה\"ב וחלקו בעולם62,"
        },
        {
          "s": 19,
          "text": "שעי\"ז יהי' הגילוי בעוה\"ז הגשמי ותושלם הכוונה דדירה בתחתונים,"
        },
        {
          "s": 20,
          "text": "כמבואר כל זה בארוכה בתניא63."
        }
      ]
    }
  ]
}