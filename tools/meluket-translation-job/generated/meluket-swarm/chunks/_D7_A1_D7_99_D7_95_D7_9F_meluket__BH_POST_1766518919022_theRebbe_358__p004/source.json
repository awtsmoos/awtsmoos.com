{
  "globalIndex": 889,
  "owner": 39,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518919022_theRebbe_358__p004",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518919022_theRebbe_358__p004",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518919022_theRebbe_358",
  "title": "מאמר ואהי אצלו אמון תשכ\"א",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "וביאור הענין,"
        },
        {
          "s": 2,
          "text": "הנה נת\"ל שג' הענינים דיציאת מצרים ספירת העומר ומתן תורה,"
        },
        {
          "s": 3,
          "text": "נקראים בשם שבת,"
        },
        {
          "s": 4,
          "text": "ובענין השבת ישנם ב' בחינות,"
        },
        {
          "s": 5,
          "text": "שביתה ומנוחה שאחרי העבודה ויגיעה,"
        },
        {
          "s": 6,
          "text": "ומנוחה בעצם."
        },
        {
          "s": 7,
          "text": "ענין המנוחה שאחרי העבודה ויגיעה הוא כמ\"ש ששת ימים תעבוד גו' ויום השביעי גו'40,"
        },
        {
          "s": 8,
          "text": "שש שנים תזרע גו' ובשנה השביעית גו'41,"
        },
        {
          "s": 9,
          "text": "דלכאורה אינו מובן מהו ענין הציווי על העבודה בששת ימים ובששת השנים."
        },
        {
          "s": 10,
          "text": "וידוע פירוש הפנימי בזה,"
        },
        {
          "s": 11,
          "text": "שקאי על עבודת הבירורים,"
        },
        {
          "s": 12,
          "text": "שענין הבירורים הוא ענין נעלה ביותר,"
        },
        {
          "s": 13,
          "text": "שבשביל זה הי' כדאי כל ענין ירידת הנשמה למטה מאיגרא רמה לבירא עמיקתא42,"
        },
        {
          "s": 14,
          "text": "ובשביל זה הי' כדאי כל ענין נתינת התורה."
        },
        {
          "s": 15,
          "text": "אמנם,"
        },
        {
          "s": 16,
          "text": "בשעת הבירור צריכה להיות הירידה למטה בל\"ט מלאכות עובדין דחול,"
        },
        {
          "s": 17,
          "text": "ואח\"כ צריכה להיות העלי' למעלה,"
        },
        {
          "s": 18,
          "text": "שהו\"ע השביתה ומנוחה דשבת שאחרי העבודה,"
        },
        {
          "s": 19,
          "text": "שמצד זה הוא גילוי התענוג."
        },
        {
          "s": 20,
          "text": "ועד\"מ באדם למטה,"
        },
        {
          "s": 21,
          "text": "שבעת עשיית המלאכה יורד כח העשי' שלו ומתלבש בהמלאכה,"
        },
        {
          "s": 22,
          "text": "ואח\"כ כאשר נח מעשיית המלאכה,"
        },
        {
          "s": 23,
          "text": "אזי כח העשי' שלו עולה ונכלל בנפשו,"
        },
        {
          "s": 24,
          "text": "ומזה הוא מתמלא תענוג."
        },
        {
          "s": 25,
          "text": "ועד\"ז יובן למעלה,"
        },
        {
          "s": 26,
          "text": "דהגם שלא בעמל ולא ביגיעה ברא הקב\"ה את עולמו43,"
        },
        {
          "s": 27,
          "text": "מ\"מ כתיב44"
        },
        {
          "s": 28,
          "text": "בדבר הוי' שמים נעשו,"
        },
        {
          "s": 29,
          "text": "ודיבורו של הקב\"ה חשיב מעשה45,"
        },
        {
          "s": 30,
          "text": "ולכן צריך להיות ענין השביתה ומנוחה,"
        },
        {
          "s": 31,
          "text": "שהוא ענין העלי' למעלה,"
        },
        {
          "s": 32,
          "text": "ומזה הוא המשכת התענוג."
        },
        {
          "s": 33,
          "text": "ובאמת צריך להיות ענין השביתה והעלי' לא רק בכח המעשה בלבד,"
        },
        {
          "s": 34,
          "text": "אלא גם בכחות הנעלים יותר."
        },
        {
          "s": 35,
          "text": "ועד\"מ באדם כשעושה איזה מלאכה,"
        },
        {
          "s": 36,
          "text": "הרי בשעת מעשה יש ירידה לא רק בכח המעשה שלו בלבד,"
        },
        {
          "s": 37,
          "text": "אלא גם בשאר הכחות,"
        },
        {
          "s": 38,
          "text": "שהרי עשיית המלאכה היא מפני שהוא נמצא בתנועה של קירוב לכללות הענין,"
        },
        {
          "s": 39,
          "text": "שזהו ענין המדות,"
        },
        {
          "s": 40,
          "text": "וגם כח השכל צריך להיות מלובש בשעת מעשה בכדי שהעשי' תהי' באופן המתאים."
        },
        {
          "s": 41,
          "text": "והגם שהשכל שבזה הוא שכל השייך למעשה בלבד,"
        },
        {
          "s": 42,
          "text": "מ\"מ,"
        },
        {
          "s": 43,
          "text": "בשעת מעשה הרי כל שכלו טרוד בזה."
        },
        {
          "s": 44,
          "text": "וגם בהכרח שיש לו רצון בהמלאכה,"
        },
        {
          "s": 45,
          "text": "וגם תענוג,"
        },
        {
          "s": 46,
          "text": "שמצד זה הוא עושה המלאכה."
        },
        {
          "s": 47,
          "text": "ונמצא,"
        },
        {
          "s": 48,
          "text": "שבשעת עשיית המלאכה הרי כל כחות נפשו הם בירידה,"
        },
        {
          "s": 49,
          "text": "ואח\"כ בשעת השביתה והמנוחה,"
        },
        {
          "s": 50,
          "text": "עולים כל כוחותיו."
        },
        {
          "s": 51,
          "text": "והדוגמא מזה יובן למעלה,"
        },
        {
          "s": 52,
          "text": "שענין השביתה דשבת הוא לא רק בכח הפועל שבנפעל שמצד שם אלקים,"
        },
        {
          "s": 53,
          "text": "אלא גם בשם הוי',"
        },
        {
          "s": 54,
          "text": "כמ\"ש40"
        },
        {
          "s": 55,
          "text": "שבת להוי'."
        },
        {
          "s": 56,
          "text": "והיינו,"
        },
        {
          "s": 57,
          "text": "דעם היות שההתהוות בפועל היא משם אלקים,"
        },
        {
          "s": 58,
          "text": "מ\"מ,"
        },
        {
          "s": 59,
          "text": "אמיתית ההתהוות היא משם הוי',"
        },
        {
          "s": 60,
          "text": "כדכתיב בדבר הוי' שמים נעשו44,"
        },
        {
          "s": 61,
          "text": "כי הוא צוה ונבראו46,"
        },
        {
          "s": 62,
          "text": "והוי' לשון מהוה47."
        },
        {
          "s": 63,
          "text": "ולכן צריך להיות ענין השביתה גם בשם הוי',"
        },
        {
          "s": 64,
          "text": "בכל הד' אותיות דשם הוי',"
        },
        {
          "s": 65,
          "text": "כי ההתהוות היא מכל ד' האותיות,"
        },
        {
          "s": 66,
          "text": "היינו,"
        },
        {
          "s": 67,
          "text": "לא רק מבחינת ה' אחרונה ספירת המלכות,"
        },
        {
          "s": 68,
          "text": "כמ\"ש48"
        },
        {
          "s": 69,
          "text": "בהבראם,"
        },
        {
          "s": 70,
          "text": "בה'"
        },
        {
          "s": 71,
          "text": "(אחרונה דשם הוי')"
        },
        {
          "s": 72,
          "text": "בראם49,"
        },
        {
          "s": 73,
          "text": "אלא גם מבחינת הוא\"ו שהוא ענין המדות,"
        },
        {
          "s": 74,
          "text": "וכמ\"ש50"
        },
        {
          "s": 75,
          "text": "ששת ימים עשה גו',"
        },
        {
          "s": 76,
          "text": "בששת לא כתיב,"
        },
        {
          "s": 77,
          "text": "אלא ששת כו'51."
        },
        {
          "s": 78,
          "text": "וכן יש ענין ההתהוות מבחי' המוחין חכמה"
        },
        {
          "s": 79,
          "text": "(יו\"ד)"
        },
        {
          "s": 80,
          "text": "ובינה"
        },
        {
          "s": 81,
          "text": "(ה\"א),"
        },
        {
          "s": 82,
          "text": "כמ\"ש בזהר52"
        },
        {
          "s": 83,
          "text": "ע\"פ ויאמר אלקים אבא אמר לאימא,"
        },
        {
          "s": 84,
          "text": "ואמרו רז\"ל53"
        },
        {
          "s": 85,
          "text": "כולם54"
        },
        {
          "s": 86,
          "text": "בחכמה עשית בבינה,"
        },
        {
          "s": 87,
          "text": "ועד שעיקר ההתהוות הוא מהיו\"ד,"
        },
        {
          "s": 88,
          "text": "שמורה על תמידות הפעולה,"
        },
        {
          "s": 89,
          "text": "כמ\"ש55"
        },
        {
          "s": 90,
          "text": "ככה יעשה איוב כל הימים,"
        },
        {
          "s": 91,
          "text": "והוא ענין המחדש בכל יום תמיד מעשה בראשית56."
        },
        {
          "s": 92,
          "text": "ולכן השביתה היא בכל ד' האותיות דשם הוי'."
        },
        {
          "s": 93,
          "text": "וענין השביתה בכל ד' האותיות דשם הוי' הוא לא רק בהתלבשותן בבי\"ע,"
        },
        {
          "s": 94,
          "text": "אלא גם בבחינת האצילות,"
        },
        {
          "s": 95,
          "text": "שהרי כתיב כולם בחכמה עשית,"
        },
        {
          "s": 96,
          "text": "שגם האצילות הוא כמו העשי'."
        },
        {
          "s": 97,
          "text": "ולפי מ\"ש בעץ חיים57"
        },
        {
          "s": 98,
          "text": "שחכמה דא\"ק מתלבש בחכמה דאצילות כו',"
        },
        {
          "s": 99,
          "text": "השביתה היא גם בבחינת החכמה דא\"ק."
        },
        {
          "s": 100,
          "text": "ובאמת,"
        },
        {
          "s": 101,
          "text": "הנה בבחינות הנעלות יותר,"
        },
        {
          "s": 102,
          "text": "גדול ביותר התענוג מהשביתה."
        },
        {
          "s": 103,
          "text": "והיינו,"
        },
        {
          "s": 104,
          "text": "דעם היות שבבחינות הנעלות אין הירידה למטה כ\"כ כמו הירידה בכח המעשה,"
        },
        {
          "s": 105,
          "text": "מ\"מ,"
        },
        {
          "s": 106,
          "text": "בכח נעלה יותר גם ירידה קטנה היא ירידה גדולה ביותר,"
        },
        {
          "s": 107,
          "text": "הרבה יותר מירידת כח הפועל בנפעל,"
        },
        {
          "s": 108,
          "text": "ולכן התענוג מהשביתה הוא תענוג גדול ביותר."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "אמנם כל זה הוא ענין השביתה והמנוחה שאחרי היגיעה."
        },
        {
          "s": 1,
          "text": "ובחינת המנוחה בעצם הוא ע\"ד מ\"ש58"
        },
        {
          "s": 2,
          "text": "גבי שלמה הוא יהי' איש מנוחה,"
        },
        {
          "s": 3,
          "text": "שאין הכוונה שיהיו לו מלחמות ואח\"כ יהי' לו מנוחה מהמלחמות,"
        },
        {
          "s": 4,
          "text": "כי אם שיהי' אצלו מצב של מנוחה בעצם."
        },
        {
          "s": 5,
          "text": "והתענוג שישנו בענין המנוחה בעצם הוא תענוג נעלה יותר מהתענוג שבמנוחה לאחרי היגיעה,"
        },
        {
          "s": 6,
          "text": "והוא בחינת תענוג הבלתי מורגש."
        },
        {
          "s": 7,
          "text": "והנה,"
        },
        {
          "s": 8,
          "text": "אמרו רז\"ל59"
        },
        {
          "s": 9,
          "text": "שבכל שבת ישנם ב' שבתות,"
        },
        {
          "s": 10,
          "text": "מעלי שבתא ויומא דשבתא,"
        },
        {
          "s": 11,
          "text": "מעלי דשבתא הוא ענין העלי' מלמטה למעלה,"
        },
        {
          "s": 12,
          "text": "ויומא דשבתא הוא ענין ההמשכה מלמעלה למטה."
        },
        {
          "s": 13,
          "text": "ובפרטיות ישנו בכל אחד מהם ב' הענינים,"
        },
        {
          "s": 14,
          "text": "ובכל אחד מהם – מנוחה שאחרי היגיעה ומנוחה בעצם,"
        },
        {
          "s": 15,
          "text": "שהרי ידוע60"
        },
        {
          "s": 16,
          "text": "ההפרש בין התפלות דשבת להסעודות דשבת,"
        },
        {
          "s": 17,
          "text": "שהתפלות הוא ענין העלי' מלמטה למעלה וגם – עונג הפשוט,"
        },
        {
          "s": 18,
          "text": "והסעודות הוא ענין ההמשכה מלמעלה למטה וגם עונג המורגש,"
        },
        {
          "s": 19,
          "text": "והרי הן במעלי דשבתא והן ביומא דשבתא,"
        },
        {
          "s": 20,
          "text": "ישנם ב' הענינים סעודה ותפלה."
        },
        {
          "s": 21,
          "text": "ועיקר ענין הגילוי דמנוחה בעצם יהי' לעתיד ביום שכולו שבת ומנוחה61."
        },
        {
          "s": 22,
          "text": "ומעין זה מאיר במיוחד עכשיו בסעודה השלישית דשבת,"
        },
        {
          "s": 23,
          "text": "רעוא דכל רעוין62,"
        },
        {
          "s": 24,
          "text": "בחינת תענוג הבלתי מורגש,"
        },
        {
          "s": 25,
          "text": "ולכן כתיב63"
        },
        {
          "s": 26,
          "text": "היום לא."
        },
        {
          "s": 27,
          "text": "וזהו שאומרים במנחה דשבת כי מאתך היא מנוחתם,"
        },
        {
          "s": 28,
          "text": "מנוחה שלימה שאתה רוצה בה,"
        },
        {
          "s": 29,
          "text": "ופירוש מאתך מנוחה שלימה הוא ענין מנוחה בעצם."
        },
        {
          "s": 30,
          "text": "והנה,"
        },
        {
          "s": 31,
          "text": "שורש ב' בחינות אלו במנוחה,"
        },
        {
          "s": 32,
          "text": "הוא בבחינת מקיף הישר ומקיף החוזר."
        },
        {
          "s": 33,
          "text": "דמקיף הישר שהוא אור שבגדר גילוי,"
        },
        {
          "s": 34,
          "text": "שייך בו ענין הצמצום והעלם,"
        },
        {
          "s": 35,
          "text": "שהוא דוגמת העמל ויגיעה,"
        },
        {
          "s": 36,
          "text": "ולכן מצד אור זה הוא המנוחה שאחרי היגיעה."
        },
        {
          "s": 37,
          "text": "ומקיף דאור חוזר שהוא למעלה מגדר גילוי,"
        },
        {
          "s": 38,
          "text": "אין שייך בו ענין הצמצום והעלם כלל,"
        },
        {
          "s": 39,
          "text": "ולכן,"
        },
        {
          "s": 40,
          "text": "מצד אור זה הוא המשכת מנוחה בעצם,"
        },
        {
          "s": 41,
          "text": "תענוג הבלתי מורגש."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יובן ההפרש בין יציאת מצרים למתן תורה,"
        },
        {
          "s": 2,
          "text": "שיציאת מצרים הוא בחינת מדלג,"
        },
        {
          "s": 3,
          "text": "ומתן תורה הוא בחינת מקפץ."
        },
        {
          "s": 4,
          "text": "דהנה,"
        },
        {
          "s": 5,
          "text": "ביציאת מצרים,"
        },
        {
          "s": 6,
          "text": "הגם שהיו אז גילויים שלמעלה מסדר ההשתלשלות,"
        },
        {
          "s": 7,
          "text": "וכמ\"ש64"
        },
        {
          "s": 8,
          "text": "ועברתי בארץ מצרים אני ולא מלאך ולא שרף ולא שליח ולא אחר65,"
        },
        {
          "s": 9,
          "text": "מ\"מ,"
        },
        {
          "s": 10,
          "text": "כל גילויים אלו היו"
        },
        {
          "s": 11,
          "text": "(בעיקר)"
        },
        {
          "s": 12,
          "text": "בכדי לדחות ולבטל את הרע,"
        },
        {
          "s": 13,
          "text": "וכמש\"נ66"
        },
        {
          "s": 14,
          "text": "וידעו"
        },
        {
          "s": 15,
          "text": "(לשון שבירה)"
        },
        {
          "s": 16,
          "text": "מצרים,"
        },
        {
          "s": 17,
          "text": "ודחיית וביטול הרע לגמרי הי' בשעת מכת בכורות,"
        },
        {
          "s": 18,
          "text": "שאז הי' צריך להיות ועברתי גו' אני ולא כו'."
        },
        {
          "s": 19,
          "text": "והגילוי שהי' לבנ\"י הוא מפני שהוצרך להיות הגנה לישראל ממכות מצרים,"
        },
        {
          "s": 20,
          "text": "ושמתי פדות גו'67,"
        },
        {
          "s": 21,
          "text": "וביחוד במכת בכורות,"
        },
        {
          "s": 22,
          "text": "שאף שנגוף למצרים יהי' רפוא לישראל68."
        },
        {
          "s": 23,
          "text": "והענין בזה,"
        },
        {
          "s": 24,
          "text": "דלכאורה אינו מובן למה הוצרך לגילוי נעלה כזה,"
        },
        {
          "s": 25,
          "text": "והרי גם בסדר השתלשלות אמרו הושיט הקב\"ה אצבעו הקטנה ביניהם ושרפם69,"
        },
        {
          "s": 26,
          "text": "דכאשר הי' גילוי אור יותר מן הקצוב להם,"
        },
        {
          "s": 27,
          "text": "הגם שהי' הגילוי דאצבעו הקטנה"
        },
        {
          "s": 28,
          "text": "(מלכות),"
        },
        {
          "s": 29,
          "text": "מ\"מ נתבטלו,"
        },
        {
          "s": 30,
          "text": "ולמה הוצרך להיות הגילוי דועברתי,"
        },
        {
          "s": 31,
          "text": "דבענין הספירות הוא המשכת הכתר,"
        },
        {
          "s": 32,
          "text": "עד לבחינת כתר היותר עליון,"
        },
        {
          "s": 33,
          "text": "ולמה לא הספיק גילוי דסדר השתלשלות."
        },
        {
          "s": 34,
          "text": "אך הענין,"
        },
        {
          "s": 35,
          "text": "שכל סדר השתלשלות הוא במדידה והגבלה,"
        },
        {
          "s": 36,
          "text": "ושורש המדידה הוא מבחינת קו המדה שמודד את מדידת הספירות ומדידת העולמות."
        },
        {
          "s": 37,
          "text": "והטעם הוא,"
        },
        {
          "s": 38,
          "text": "לפי שבהקו עצמו יש בו מעלה ומטה,"
        },
        {
          "s": 39,
          "text": "דכיון שבראשו הוא דבוק ובסופו אינו דבוק70,"
        },
        {
          "s": 40,
          "text": "לכן יש בו מעלה ומטה,"
        },
        {
          "s": 41,
          "text": "ומצד זה נעשה מעלה ומטה גם בספירות ובעולמות70,"
        },
        {
          "s": 42,
          "text": "שהעולמות הקרובים יותר לראשיתו הם בבחינת מעלה."
        },
        {
          "s": 43,
          "text": "וכללות ההתהוות"
        },
        {
          "s": 44,
          "text": "(גם התהוות העולמות והספירות שהם בבחינת מעלה)"
        },
        {
          "s": 45,
          "text": "מהקו הוא מפני שבראשו הוא דבוק ובסופו אינו דבוק,"
        },
        {
          "s": 46,
          "text": "היינו,"
        },
        {
          "s": 47,
          "text": "שהדביקות שבראשו אינה מאירה בסופו,"
        },
        {
          "s": 48,
          "text": "שעי\"ז יש מקום להשתלשלות,"
        },
        {
          "s": 49,
          "text": "משא\"כ אם הדביקות שבראשו היתה מאירה גם בסופו,"
        },
        {
          "s": 50,
          "text": "לא הי' אפשר להיות ממנו ההתהוות."
        },
        {
          "s": 51,
          "text": "ויובן זה ממה שנת\"ל"
        },
        {
          "s": 52,
          "text": "(ס\"ג)"
        },
        {
          "s": 53,
          "text": "בענין חכמה ובינה,"
        },
        {
          "s": 54,
          "text": "שמבחי' החכמה עצמה שהיא ראיית המהות אי אפשר להיות התהוות הבינה,"
        },
        {
          "s": 55,
          "text": "ורק כאשר בחינת הראי' היא בהעלם ונשאר רק בחינת הנחה,"
        },
        {
          "s": 56,
          "text": "אזי נעשית הנחה שכלית,"
        },
        {
          "s": 57,
          "text": "וממנה נעשית הבנה שכלית,"
        },
        {
          "s": 58,
          "text": "בחי' הבינה,"
        },
        {
          "s": 59,
          "text": "אבל כאשר יאיר בחינת ראיית המהות שהיא ראשית החכמה,"
        },
        {
          "s": 60,
          "text": "לא יהי' אפשר להיות התהוות הבינה."
        },
        {
          "s": 61,
          "text": "ועד\"ז בהקו,"
        },
        {
          "s": 62,
          "text": "שצריך להיות באופן שבסופו לא יהי' דבוק,"
        },
        {
          "s": 63,
          "text": "היינו,"
        },
        {
          "s": 64,
          "text": "שהדביקות שבראשו לא יהי' נרגש בסופו."
        },
        {
          "s": 65,
          "text": "ומזה מובן שמצד הקו אי אפשר לשנות את מציאות העולמות,"
        },
        {
          "s": 66,
          "text": "דמאחר שהקו עצמו הוא במדידה והגבלה,"
        },
        {
          "s": 67,
          "text": "שראשיתו דבוק וסופו אינו דבוק,"
        },
        {
          "s": 68,
          "text": "הרי מצד זה מוכרח להיות המעלה ומטה דעולמות."
        },
        {
          "s": 69,
          "text": "ויתירה מזה,"
        },
        {
          "s": 70,
          "text": "גם בחינת האור שקודם הצמצום שבו הוא דביקות הקו,"
        },
        {
          "s": 71,
          "text": "הנה גם מצד אור זה ישנו כבר המדידה שרק ראשית הקו יהי' דבוק בו,"
        },
        {
          "s": 72,
          "text": "ולכן גם מצד אור זה ישנו שורש ומקור לעולמות."
        },
        {
          "s": 73,
          "text": "ולכן במכת בכורות שהוצרך אז להיות דחיית וביטול הקליפות לגמריג,"
        },
        {
          "s": 74,
          "text": "הי' צריך להיות הגילוי דאוא\"ס שלמעלה משורש ומקור הקוד."
        },
        {
          "s": 75,
          "text": "אמנם,"
        },
        {
          "s": 76,
          "text": "אחרי כל זה,"
        },
        {
          "s": 77,
          "text": "הרי הגילוי שהי' ביציאת מצרים הוא בשביל לדחות את הקליפות,"
        },
        {
          "s": 78,
          "text": "והרי זה ענין המנוחה שאחרי העבודה ויגיעה,"
        },
        {
          "s": 79,
          "text": "דבשרשו הוא בבחינת מקיף הישר כנ\"ל."
        },
        {
          "s": 80,
          "text": "משא\"כ הגילוי דמתן תורה הוא מבחינת מקיף החוזר,"
        },
        {
          "s": 81,
          "text": "עצם האור שלמעלה מגדר גילוי."
        },
        {
          "s": 82,
          "text": "והגם שענין התורה הוא להבדיל בין הטמא ובין הטהור71,"
        },
        {
          "s": 83,
          "text": "אין הכוונה בזה דחיית הרע,"
        },
        {
          "s": 84,
          "text": "כי אם בירור הניצוצות והעלאתם לקדושה."
        },
        {
          "s": 85,
          "text": "ועוד,"
        },
        {
          "s": 86,
          "text": "דלא זהו הכוונה פנימית דתורה,"
        },
        {
          "s": 87,
          "text": "כי אם תוס' אור בפנימיות ישראל"
        },
        {
          "s": 88,
          "text": "(ועל ידם בסדר ההשתלשלות)."
        }
      ]
    }
  ]
}