{
  "globalIndex": 1009,
  "owner": 9,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919765_theRebbe_137__p005",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919765_theRebbe_137__p005",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919765_theRebbe_137",
  "title": "מאמר קץ שם לחושך תשכ\"ד",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה גם הביטול דאמונה שלמעלה מהשכל אינו ביטול בתכלית."
        },
        {
          "s": 2,
          "text": "כי הביטול דאמונה הוא זה שהוא מאמין באלקות הגם שמצד שכלו"
        },
        {
          "s": 3,
          "text": "(המציאות שלו)"
        },
        {
          "s": 4,
          "text": "אין לו הוכחות על זה."
        },
        {
          "s": 5,
          "text": "וכיון שהטעם לזה שהוא מאמין באלקות"
        },
        {
          "s": 6,
          "text": "(הגם שאין לו הוכחות על זה)"
        },
        {
          "s": 7,
          "text": "הוא מפני שהאלקות נרגש בנפשו"
        },
        {
          "s": 8,
          "text": "[אלא שהרגש זה הוא למעלה מהמציאות"
        },
        {
          "s": 9,
          "text": "(השגה)"
        },
        {
          "s": 10,
          "text": "שלו],"
        },
        {
          "s": 11,
          "text": "לכן,"
        },
        {
          "s": 12,
          "text": "הביטול דאמונה אינו ביטול בתכלית,"
        },
        {
          "s": 13,
          "text": "כיון דזה שמאמין הוא מפני שנרגש בו אלקות."
        },
        {
          "s": 14,
          "text": "ובדוגמת הביטול דאור ע\"י שנרגש בו מקורו"
        },
        {
          "s": 15,
          "text": "(מהות המאור),"
        },
        {
          "s": 16,
          "text": "דהגם שזה שנרגש בו מקורו הוא למעלה ממציאותו"
        },
        {
          "s": 17,
          "text": "[דמהות המאור אינו מתגלה בהאור],"
        },
        {
          "s": 18,
          "text": "מ\"מ,"
        },
        {
          "s": 19,
          "text": "נרגש זה בהאור כמו שהוא במציאותו,"
        },
        {
          "s": 20,
          "text": "מציאות שמחוץ להמקור"
        },
        {
          "s": 21,
          "text": "[שלכן,"
        },
        {
          "s": 22,
          "text": "זה שנרגש בו מקורו אינו פועל עליו שירצה ליכלל במקורו]."
        },
        {
          "s": 23,
          "text": "והביטול דמס\"נ,"
        },
        {
          "s": 24,
          "text": "שמוסר את נפשו בשביל האלקות"
        },
        {
          "s": 25,
          "text": "(יציאה ממציאותו),"
        },
        {
          "s": 26,
          "text": "הוא דוגמת הביטול דאור מצד הרצוא שלו ליכלל במקורו."
        },
        {
          "s": 27,
          "text": "וכמובן גם מהמשך הענינים בתניא36,"
        },
        {
          "s": 28,
          "text": "דכח המס\"נ שבישראל הוא דוגמת הרצון דהנשמה ליפרד ולצאת מן הגוף ולידבק בשרשה ומקורה,"
        },
        {
          "s": 29,
          "text": "הגם שתהי' אין ואפס ותתבטל שם במציאות לגמרי37."
        },
        {
          "s": 30,
          "text": "ולהוסיף,"
        },
        {
          "s": 31,
          "text": "שבהרצון דהנשמה ליכלל באוא\"ס ישנם ב' דרגות."
        },
        {
          "s": 32,
          "text": "שהיא רוצה ליכלל,"
        },
        {
          "s": 33,
          "text": "ושהיא בבחינת כליון בדרך ממילא."
        },
        {
          "s": 34,
          "text": "ויש לומר,"
        },
        {
          "s": 35,
          "text": "דכיון שהביטול"
        },
        {
          "s": 36,
          "text": "(דאור)"
        },
        {
          "s": 37,
          "text": "שמצד הרצון ליכלל במקורו הוא ביטול לגמרי"
        },
        {
          "s": 38,
          "text": "(ע\"ד הביטול דאור הכלול במאור כנ\"ל סעיף ג),"
        },
        {
          "s": 39,
          "text": "לכן מתבטל גם הרצון."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר38,"
        },
        {
          "s": 2,
          "text": "דכיון שהרצוא דאור ליכלל במקורו הוא מפני שדבוק במקורו,"
        },
        {
          "s": 3,
          "text": "לכן,"
        },
        {
          "s": 4,
          "text": "הרצוא דאור"
        },
        {
          "s": 5,
          "text": "[וכן הביטול שמצד הרצוא]"
        },
        {
          "s": 6,
          "text": "הוא בכל הדרגות דאור,"
        },
        {
          "s": 7,
          "text": "גם בהאור המלובש בכלים"
        },
        {
          "s": 8,
          "text": "(שהרי זה שהאור הוא דבוק במקורו הוא בכל הדרגות שבו),"
        },
        {
          "s": 9,
          "text": "אלא שעיקר הרצוא"
        },
        {
          "s": 10,
          "text": "[והביטול שמצד הרצוא]"
        },
        {
          "s": 11,
          "text": "הוא בעצם האור שלמעלה מגדר התלבשות בכלים."
        },
        {
          "s": 12,
          "text": "ויש לומר,"
        },
        {
          "s": 13,
          "text": "דבטבע הרצוא שבאור ליכלל במקורו,"
        },
        {
          "s": 14,
          "text": "שני ענינים."
        },
        {
          "s": 15,
          "text": "הרצון להיות כלול במקורו,"
        },
        {
          "s": 16,
          "text": "והרצון לא להיות חוץ למקורו."
        },
        {
          "s": 17,
          "text": "וזה שעיקר הרצוא הוא בעצם האור,"
        },
        {
          "s": 18,
          "text": "הוא,"
        },
        {
          "s": 19,
          "text": "שבהאור המתלבש בכלים ושבגדר התלבשות,"
        },
        {
          "s": 20,
          "text": "הוא הרצון לא להיות חוץ למקורו,"
        },
        {
          "s": 21,
          "text": "ובעצם האור הרצון להיות כלול במקורו."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "והענין הוא,"
        },
        {
          "s": 1,
          "text": "דשני רצונות הנ\"ל יש בכל אחד מהם מעלה שאינה בזולתו."
        },
        {
          "s": 2,
          "text": "הרצון להיות כלול במקורו הוא נעלה יותר,"
        },
        {
          "s": 3,
          "text": "כי רצון זה שבאור הוא מפני שנרגש בו המקור – וגילוי המקור הוא בעיקר בעצם האור."
        },
        {
          "s": 4,
          "text": "והרצון לא להיות חוץ למקורו הוא בפנימיות יותר"
        },
        {
          "s": 5,
          "text": "(טיפער)"
        },
        {
          "s": 6,
          "text": "בהאור,"
        },
        {
          "s": 7,
          "text": "ועד שרצון זה הוא בעצם מציאותו – ולכן הוא בכל הדרגות שבו."
        },
        {
          "s": 8,
          "text": "וע\"ד החילוק שבין הרצון דנשמה ליכלל באוא\"ס וכח המס\"נ39,"
        },
        {
          "s": 9,
          "text": "שהרצון ליכלל באוא\"ס הוא בגילוי רק ביחידי סגולה,"
        },
        {
          "s": 10,
          "text": "וענין המס\"נ שלא להיות נפרד ח\"ו מאלקות הוא בגילוי בכאו\"א."
        }
      ]
    }
  ]
}