{
  "globalIndex": 121,
  "owner": 21,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914390_theRebbe_977__p007",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914390_theRebbe_977__p007",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914390_theRebbe_977",
  "title": "מאמר בסוכות תשבו תשכ\"ג",
  "part": 7,
  "sections": [
    {
      "v": 18,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "וזהו בסוכות תשבו גו' כל האזרח בישראל ישבו בסוכות גו' כי בסוכות הושבתי גו',"
        },
        {
          "s": 2,
          "text": "דכל האזרח בישראל ישבו בסוכות וכי בסוכות הושבתי גו' הם שני טעמים על בסוכות תשבו"
        },
        {
          "s": 3,
          "text": "(כמבואר בהמאמר דהמשך ראש השנה תש\"ג,"
        },
        {
          "s": 4,
          "text": "הובא לעיל סעיף ב)."
        },
        {
          "s": 5,
          "text": "והענין הוא,"
        },
        {
          "s": 6,
          "text": "דבסוכות תשבו הוא גילוי התשובה דיום הכפורים,"
        },
        {
          "s": 7,
          "text": "ובהתשובה דיום הכפורים,"
        },
        {
          "s": 8,
          "text": "ג' ענינים."
        },
        {
          "s": 9,
          "text": "התשובה עצמה,"
        },
        {
          "s": 10,
          "text": "ושני ענינים בשרש וסיבת התשובה."
        },
        {
          "s": 11,
          "text": "דהתשובה עצמה"
        },
        {
          "s": 12,
          "text": "(גם התשובה דיום הכפורים)"
        },
        {
          "s": 13,
          "text": "היא שהאדם משנה את עצמו,"
        },
        {
          "s": 14,
          "text": "שיוצא ממציאותו הקודמת ונעשה מציאות חדשה."
        },
        {
          "s": 15,
          "text": "דשינוי זה הוא בכחות הגלויים דהנשמה."
        },
        {
          "s": 16,
          "text": "ושינוי זה שבכחות הגלויים דהאדם הוא ע\"י שמעורר ומגלה עצם הנשמה שבו,"
        },
        {
          "s": 17,
          "text": "היינו עצם הנשמה ששייכת לכחות הגלויים."
        },
        {
          "s": 18,
          "text": "[ועד\"ז הוא בנוגע למעלה,"
        },
        {
          "s": 19,
          "text": "דזה שהאדם נעשה מרוצה לפניו ית' כמו קודם החטא42"
        },
        {
          "s": 20,
          "text": "הוא,"
        },
        {
          "s": 21,
          "text": "כי ע\"י התשובה נמשך רצון חדש מאוא\"ס בעל הרצון]."
        },
        {
          "s": 22,
          "text": "ועוד ענין בהתשובה דיום הכפורים,"
        },
        {
          "s": 23,
          "text": "שנרגש בה בגילוי,"
        },
        {
          "s": 24,
          "text": "שהשורש והסיבה האמיתית דתשובה הוא ההתקשרות דעצם הנשמה"
        },
        {
          "s": 25,
          "text": "(שלמעלה משייכות לכחות הגלויים)"
        },
        {
          "s": 26,
          "text": "עם העצמות"
        },
        {
          "s": 27,
          "text": "(שלמעלה מבעל הרצון)."
        },
        {
          "s": 28,
          "text": "ולכן,"
        },
        {
          "s": 29,
          "text": "גם בהענין דבסוכות תשבו"
        },
        {
          "s": 30,
          "text": "(שהוא הגילוי דהתשובה דיום הכפורים),"
        },
        {
          "s": 31,
          "text": "ג' הענינים."
        },
        {
          "s": 32,
          "text": "הענין דבסוכות תשבו עצמו – השינוי במקיף הקרוב,"
        },
        {
          "s": 33,
          "text": "שנעשה אור מתיישב."
        },
        {
          "s": 34,
          "text": "והטעם על זה הוא – כי בסוכות הושבתי גו' בדרך אתערותא דלעילא."
        },
        {
          "s": 35,
          "text": "ויש לומר,"
        },
        {
          "s": 36,
          "text": "שהוא ע\"ד המובא לעיל סעיף ו דזה שע\"י אתעדל\"ת מתעורר הרצון גלוי"
        },
        {
          "s": 37,
          "text": "(אף שהאתעדל\"ת היא באין ערוך לגבי הרצון)"
        },
        {
          "s": 38,
          "text": "הוא לא מצד הרצון הגלוי עצמו"
        },
        {
          "s": 39,
          "text": "(דכיון שרצון הגלוי שייך לעולמות הוא מוגדר בזה שהנבראים הם באין ערוך לגבי' ואין ביכלתם לעורר אותו),"
        },
        {
          "s": 40,
          "text": "אלא לפי שכן הוחלט ברצון המוחלט."
        },
        {
          "s": 41,
          "text": "ועד\"ז הוא בהענין דבסוכות תשבו,"
        },
        {
          "s": 42,
          "text": "שהשינוי כביכול שנעשה במקיף הקרוב להיות אור מתיישב הוא,"
        },
        {
          "s": 43,
          "text": "כי בסוכות הושבתי בדרך אתערותא דלעילא,"
        },
        {
          "s": 44,
          "text": "המשכה מעצמות אוא\"ס שלגבי' אין חילוק בין מקיף לפנימי וגם המקיף יכול לבוא בהתיישבות."
        },
        {
          "s": 45,
          "text": "[ע\"ד שע\"י התשובה נמשך רצון"
        },
        {
          "s": 46,
          "text": "(חדש)"
        },
        {
          "s": 47,
          "text": "מאוא\"ס בעל הרצון]."
        },
        {
          "s": 48,
          "text": "ועוד טעם על בסוכות תשבו – כל האזרח בישראל ישבו בסוכות,"
        },
        {
          "s": 49,
          "text": "במקיף הרחוק."
        },
        {
          "s": 50,
          "text": "דענין הישיבה"
        },
        {
          "s": 51,
          "text": "(התיישבות)"
        },
        {
          "s": 52,
          "text": "במקיף הרחוק אינו באופן דפעולה"
        },
        {
          "s": 53,
          "text": "[כי במקיף הרחוק,"
        },
        {
          "s": 54,
          "text": "בחינת לא אדם,"
        },
        {
          "s": 55,
          "text": "אין שייך שיהי' בו פעולה ושינוי,"
        },
        {
          "s": 56,
          "text": "כנ\"ל סעיף ג],"
        },
        {
          "s": 57,
          "text": "אלא שכל האזרח בישראל,"
        },
        {
          "s": 58,
          "text": "ישבו בסוכות"
        },
        {
          "s": 59,
          "text": "(מקיף הרחוק)"
        },
        {
          "s": 60,
          "text": "מצד עצמם,"
        },
        {
          "s": 61,
          "text": "לפי שהם מושרשים בהעצמות."
        },
        {
          "s": 62,
          "text": "[וזהו שאמרו רז\"ל43"
        },
        {
          "s": 63,
          "text": "עה\"פ כל האזרח בישראל ישבו בסוכות מלמד שכל ישראל ראויים לישב בסוכה אחת,"
        },
        {
          "s": 64,
          "text": "כי בדרגא זו כל ישראל שוים]."
        },
        {
          "s": 65,
          "text": "והוא ע\"ד הענין דעיצומו של יום הכפורים,"
        },
        {
          "s": 66,
          "text": "שמצד ההתקשרות העצמית דעצם הנשמה עם העצמות אין פגם מלכתחילה."
        },
        {
          "s": 67,
          "text": "וכמו שביום הכפורים,"
        },
        {
          "s": 68,
          "text": "הענין דעיצומו מאיר בגילוי גם בהתשובה דיום הכפורים,"
        },
        {
          "s": 69,
          "text": "שבהתשובה דיום הכפורים נרגש"
        },
        {
          "s": 70,
          "text": "(כנ\"ל)"
        },
        {
          "s": 71,
          "text": "שהיא נמשכת מההתקשרות העצמית דעצם הנשמה עם העצמות,"
        },
        {
          "s": 72,
          "text": "עד\"ז הוא בסוכות,"
        },
        {
          "s": 73,
          "text": "שכל האזרח בישראל ישבו בסוכות הוא טעם על בסוכות תשבו,"
        },
        {
          "s": 74,
          "text": "דזה שמקיף הקרוב נמשך בפנימיות ונעשה אור מתיישב,"
        },
        {
          "s": 75,
          "text": "נרגש בו,"
        },
        {
          "s": 76,
          "text": "שהטעם על זה הוא כל האזרח בישראל ישבו בסוכות,"
        },
        {
          "s": 77,
          "text": "במקיף הרחוק,"
        },
        {
          "s": 78,
          "text": "התקשרות העצמית דעצם הנשמה עם העצמות."
        }
      ]
    }
  ]
}