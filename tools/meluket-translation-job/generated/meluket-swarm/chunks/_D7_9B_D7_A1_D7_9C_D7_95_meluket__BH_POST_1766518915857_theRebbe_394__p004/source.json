{
  "globalIndex": 369,
  "owner": 19,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915857_theRebbe_394__p004",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915857_theRebbe_394__p004",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915857_theRebbe_394",
  "title": "מאמר ת\"ר מצות נר חנוכה תשל\"ח",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "וזהו גם הטעם שנרות חנוכה חלוקים מנרות המקדש גם בזמן הדלקתם,"
        },
        {
          "s": 1,
          "text": "מה שמצותה של נ\"ח היא משתשקע החמה,"
        },
        {
          "s": 2,
          "text": "כי דוקא ע\"י הגילוי"
        },
        {
          "s": 3,
          "text": "(דבחינת יחידה)"
        },
        {
          "s": 4,
          "text": "שלמעלה מהשתלשלות"
        },
        {
          "s": 5,
          "text": "(שבאדם),"
        },
        {
          "s": 6,
          "text": "מאירים גם את החושך."
        },
        {
          "s": 7,
          "text": "דלא רק שלגבי אור זה החושך אינו מעלים,"
        },
        {
          "s": 8,
          "text": "אלא יתירה מזו,"
        },
        {
          "s": 9,
          "text": "שהחושך נהפך לאור."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "וזהו גם מה שזמנה של נ\"ח הוא עד שתכלה רגל מן השוק עד דכליא ריגלא דתרמודאי1,"
        },
        {
          "s": 1,
          "text": "תרמודאי הם המורדים במלכות שמים"
        },
        {
          "s": 2,
          "text": "(תרמוד אותיות מורדת60)"
        },
        {
          "s": 3,
          "text": "והם מתעכבים בשוק61"
        },
        {
          "s": 4,
          "text": "בחינת רה\"ר טורי דפרודא62,"
        },
        {
          "s": 5,
          "text": "וע\"י נ\"ח נעשה כליא ריגלא דתרמודאי,"
        },
        {
          "s": 6,
          "text": "דשני פירושים בזה."
        },
        {
          "s": 7,
          "text": "שהאור דנ\"ח מכלה ומבטל את ריגלא דתרמודאי63,"
        },
        {
          "s": 8,
          "text": "ושהאור דנ\"ח פועל הכליון"
        },
        {
          "s": 9,
          "text": "(כליא מלשון כליון וכלות הנפש)"
        },
        {
          "s": 10,
          "text": "גם בריגלא דתרמודאי,"
        },
        {
          "s": 11,
          "text": "שגם המורדים יבואו לבחינת כלות הנפש64."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "וע\"פ כל הנ\"ל יובן הפערגליַיך דנרות חנוכה לסוכות ולפרי החג,"
        },
        {
          "s": 2,
          "text": "כי ענין סוכות"
        },
        {
          "s": 3,
          "text": "(וגם ענין פרי החג)"
        },
        {
          "s": 4,
          "text": "הוא התגלות המקיפים65,"
        },
        {
          "s": 5,
          "text": "בדוגמת סוכה כפשוטה שמקפת על האדם."
        },
        {
          "s": 6,
          "text": "ובשמיני דסוכות נמשכים המקיפים ונעצרים גם בפנימיות,"
        },
        {
          "s": 7,
          "text": "בדוגמת העבודה דמס\"נ"
        },
        {
          "s": 8,
          "text": "(דחנוכה)"
        },
        {
          "s": 9,
          "text": "שפועלת"
        },
        {
          "s": 10,
          "text": "(כנ\"ל)"
        },
        {
          "s": 11,
          "text": "וחודרת בכל כחות הנפש."
        },
        {
          "s": 12,
          "text": "וזהו מה ששניהם"
        },
        {
          "s": 13,
          "text": "(סוכות וחנוכה)"
        },
        {
          "s": 14,
          "text": "שמונה ימים,"
        },
        {
          "s": 15,
          "text": "דמספר שמונה הוא א' ז',"
        },
        {
          "s": 16,
          "text": "שהא'"
        },
        {
          "s": 17,
          "text": "(שלמעלה מהשתלשלות)"
        },
        {
          "s": 18,
          "text": "נמשך בז'"
        },
        {
          "s": 19,
          "text": "(השתלשלות)66."
        },
        {
          "s": 20,
          "text": "וכמו שנ\"ח פועל גם בריגלא דתרמודאי בשני הענינים,"
        },
        {
          "s": 21,
          "text": "שבתחילה הוא מכלה ומבטל אותם ואח\"כ פועל בהם שגם הם יהפכו לקדושה,"
        },
        {
          "s": 22,
          "text": "עד\"ז הוא גם בהקרבת ע' פרי החג שכנגד שבעים אומות העולם67,"
        },
        {
          "s": 23,
          "text": "שבתחילה פועלת ההקרבה שהאומות יהיו פוחתים והולכים,"
        },
        {
          "s": 24,
          "text": "ואח\"כ פועלת בהם שגם הם יסייעו לישראל,"
        },
        {
          "s": 25,
          "text": "כמאמר רז\"ל68"
        },
        {
          "s": 26,
          "text": "אילו היו אומות העולם יודעים מה הי' המקדש יפה להם קסטריות69"
        },
        {
          "s": 27,
          "text": "היו מקיפים אותו כדי לשומרו כו'."
        },
        {
          "s": 28,
          "text": "דע\"י שפועלים בהם הענין דאתהפכא,"
        },
        {
          "s": 29,
          "text": "מיתוסף על ידם סיוע"
        },
        {
          "s": 30,
          "text": "(גם)"
        },
        {
          "s": 31,
          "text": "בקדושה,"
        },
        {
          "s": 32,
          "text": "שמירת המקדש70."
        },
        {
          "s": 33,
          "text": "וע\"ד שיהי' לע\"ל,"
        },
        {
          "s": 34,
          "text": "כאשר אז אהפוך אל עמים גו' לעבדו שכם אחד71,"
        },
        {
          "s": 35,
          "text": "הנה אז ועמדו זרים ורעו צאנכם72."
        },
        {
          "s": 36,
          "text": "וע\"ד הקרבת הע' פרים שכנגד ע' האומות,"
        },
        {
          "s": 37,
          "text": "ועד שע\"י ומצד האומות ניתוסף"
        },
        {
          "s": 38,
          "text": "(בשמיני)"
        },
        {
          "s": 39,
          "text": "קרבן לבני ישראל בבית המקדש."
        }
      ]
    }
  ]
}