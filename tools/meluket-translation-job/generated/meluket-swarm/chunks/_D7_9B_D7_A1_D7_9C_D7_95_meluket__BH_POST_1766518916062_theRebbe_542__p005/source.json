{
  "globalIndex": 406,
  "owner": 6,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518916062_theRebbe_542__p005",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518916062_theRebbe_542__p005",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518916062_theRebbe_542",
  "title": "מאמר פדה בשלום תשל\"א",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר34"
        },
        {
          "s": 2,
          "text": "לבאר ענין זה בתוספת ביאור"
        },
        {
          "s": 3,
          "text": "(שמבחי' העקודים ששם נמצאים כל הענינים בהעלם,"
        },
        {
          "s": 4,
          "text": "כמו בבחי' היחידה,"
        },
        {
          "s": 5,
          "text": "נמשכים ובאים כל הענינים בגילוי,"
        },
        {
          "s": 6,
          "text": "באופן שיש חילוק בין עולם האצילות לעולמות שלמטה ממנו עד לעולם העשי'),"
        },
        {
          "s": 7,
          "text": "שיובן ממה שמצינו בעולם"
        },
        {
          "s": 8,
          "text": "(כנ\"ל שמבשרי אחזה אלקה)"
        },
        {
          "s": 9,
          "text": "שיש ד' מדריגות דצח\"מ,"
        },
        {
          "s": 10,
          "text": "שכל אחד מהם כלול מזולתו,"
        },
        {
          "s": 11,
          "text": "היינו,"
        },
        {
          "s": 12,
          "text": "שהמדבר יש בו ג\"כ ג' המדריגות דחי וצומח ודומם,"
        },
        {
          "s": 13,
          "text": "ומזה מובן שגם החי כלול בו לא רק בחי' צומח ודומם,"
        },
        {
          "s": 14,
          "text": "אלא גם בחי' מדבר,"
        },
        {
          "s": 15,
          "text": "ועד שיכול להיות דם ובשר מבשרו של המדבר,"
        },
        {
          "s": 16,
          "text": "שאז מתגלה מה שהי' תחילה בהעלם."
        },
        {
          "s": 17,
          "text": "ומה שכל אחד מהם נקרא בשם בפ\"ע,"
        },
        {
          "s": 18,
          "text": "הרי זה ע\"ש ההתגלות,"
        },
        {
          "s": 19,
          "text": "שבנברא זה מתגלה בחי' המדבר,"
        },
        {
          "s": 20,
          "text": "ובנברא זה מתגלה בחי' החי,"
        },
        {
          "s": 21,
          "text": "ועד\"ז בצומח ובדומם,"
        },
        {
          "s": 22,
          "text": "אבל מצד ההעלם,"
        },
        {
          "s": 23,
          "text": "הנה כשם שבבחי' המדבר כלולים חי צומח ודומם,"
        },
        {
          "s": 24,
          "text": "כן הוא גם בשאר הסוגים,"
        },
        {
          "s": 25,
          "text": "שגם בסוג הדומם כלולים צומח חי ומדבר."
        },
        {
          "s": 26,
          "text": "והיינו,"
        },
        {
          "s": 27,
          "text": "שהחילוק הוא רק בהגילוי שבהם,"
        },
        {
          "s": 28,
          "text": "ולא בההעלם שלהם."
        },
        {
          "s": 29,
          "text": "ועד\"ז הוא גם בעולמות אבי\"ע שהם כנגד דצח\"מ35,"
        },
        {
          "s": 30,
          "text": "שהתחלקות שביניהם היא רק מצד הגילוי,"
        },
        {
          "s": 31,
          "text": "אבל כפי שהם כלולים בתכלית ההעלם בבחי' העקודים,"
        },
        {
          "s": 32,
          "text": "הרי הם בשוה ממש."
        },
        {
          "s": 33,
          "text": "ומבחי' זו יכול להיות הגילוי בבת אחת ובשוה בעולם האצילות ובעולם העשי',"
        },
        {
          "s": 34,
          "text": "ע\"ד התגלות בחי' היחידה שבנפש בריבוי השכל ובריקוד שברגל בבת אחת,"
        },
        {
          "s": 35,
          "text": "ולכן יכול להיות ענין ההשגחה בכל פרט ופרט,"
        },
        {
          "s": 36,
          "text": "כיון שנמשך מעולם העקודים ולמעלה יותר."
        },
        {
          "s": 37,
          "text": "ומזה מובן,"
        },
        {
          "s": 38,
          "text": "שזה שבחי' היחידה וכן עולם העקודים הו\"ע של מקיף,"
        },
        {
          "s": 39,
          "text": "אין הכוונה שמקיף וסובב מבחוץ,"
        },
        {
          "s": 40,
          "text": "שהרי אדרבה,"
        },
        {
          "s": 41,
          "text": "מזה נמשך ענין ההשגחה פרטית על כל פרט ופרט,"
        },
        {
          "s": 42,
          "text": "וכמבואר בתניא36"
        },
        {
          "s": 43,
          "text": "שהענין דהשגח\"פ קשור עם חיות והתהוות הנברא,"
        },
        {
          "s": 44,
          "text": "ואתה מחי' את כולם37,"
        },
        {
          "s": 45,
          "text": "א\"ת מחי' אלא מהווה38,"
        },
        {
          "s": 46,
          "text": "שזהו אמיתית ענינו שנמצא בתוכו ותוך תוכו,"
        },
        {
          "s": 47,
          "text": "אלא שנמצא בו בהעלם."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ומסיים המאמר39"
        },
        {
          "s": 2,
          "text": "בדבר טוב,"
        },
        {
          "s": 3,
          "text": "שזהו ענין הברכות שאומרים ברוך אתה,"
        },
        {
          "s": 4,
          "text": "לשון נוכח,"
        },
        {
          "s": 5,
          "text": "ואומרים זה אפילו תינוקות ונשים."
        },
        {
          "s": 6,
          "text": "דלכאורה,"
        },
        {
          "s": 7,
          "text": "כיון שאמירה זו היא לעתיקא קדישא"
        },
        {
          "s": 8,
          "text": "(כמבואר בזהר40)"
        },
        {
          "s": 9,
          "text": "ועד לעצמותו ית',"
        },
        {
          "s": 10,
          "text": "אמיתית המציאות,"
        },
        {
          "s": 11,
          "text": "שרק הוא יכול להקרא בשם אתה,"
        },
        {
          "s": 12,
          "text": "א\"כ,"
        },
        {
          "s": 13,
          "text": "איך אפשר לומר עליו ברוך שהוא לשון המשכה41,"
        },
        {
          "s": 14,
          "text": "ועד שאפילו תינוק אומר זה."
        },
        {
          "s": 15,
          "text": "אך הענין הוא,"
        },
        {
          "s": 16,
          "text": "שזהו לפי שמצד בחי' היחידה,"
        },
        {
          "s": 17,
          "text": "וכן בחי' היחידה למעלה בעולם הנקודים ולמעלה מזה,"
        },
        {
          "s": 18,
          "text": "נמצאים כל הענינים בשוה,"
        },
        {
          "s": 19,
          "text": "ואדרבה,"
        },
        {
          "s": 20,
          "text": "מרום וקדוש"
        },
        {
          "s": 21,
          "text": "(את מי)"
        },
        {
          "s": 22,
          "text": "אשכון את דכא ושפל רוח42"
        },
        {
          "s": 23,
          "text": "(דוקא)."
        },
        {
          "s": 24,
          "text": "והיינו,"
        },
        {
          "s": 25,
          "text": "שאף שלכאורה אין חילוק,"
        },
        {
          "s": 26,
          "text": "מ\"מ,"
        },
        {
          "s": 27,
          "text": "כאשר ישנו ענין של יש ומציאות,"
        },
        {
          "s": 28,
          "text": "הרי זה מעלים ועד לאופן שגם מסתיר ח\"ו,"
        },
        {
          "s": 29,
          "text": "משא\"כ מי שהוא דכא ושפל רוח,"
        },
        {
          "s": 30,
          "text": "ששם אין דבר המעלים,"
        },
        {
          "s": 31,
          "text": "אזי מרום וקדוש אשכון בגלוי43."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ועל44 פי זה יובן מ\"ש בהמאמר ד\"ה פדה בשלום הנ\"ל שמצד העבודה דיחידה הפדי' היא בשלום,"
        },
        {
          "s": 2,
          "text": "דמכיון שמצד עצמות אוא\"ס,"
        },
        {
          "s": 3,
          "text": "ועד\"ז מצד בחינת יחידה שבנפש,"
        },
        {
          "s": 4,
          "text": "הרי כל הענינים הם בהשוואה,"
        },
        {
          "s": 5,
          "text": "לזאת הנה גם כשישנו בחי' רבים,"
        },
        {
          "s": 6,
          "text": "עד לריבוי גדול ביותר,"
        },
        {
          "s": 7,
          "text": "שמצד זה נעשה ענין של קרב ומלחמה,"
        },
        {
          "s": 8,
          "text": "כי ענין הריבוי הוא שישנם לא רק נפרדים זה מזה אלא גם סותרים זה את זה,"
        },
        {
          "s": 9,
          "text": "מ\"מ מצד העבודה דבחי' יחידה,"
        },
        {
          "s": 10,
          "text": "שהיא העבודה דבכל מאדך45,"
        },
        {
          "s": 11,
          "text": "וכמבואר בד\"ה פדה בשלום הנ\"ל שבחי' בכל מאדך הו\"ע מסירת הנפש עצמה שהיא למעלה ממסירת הרצון,"
        },
        {
          "s": 12,
          "text": "שהוא מצד בחי' היחידה דנפש האלקית,"
        },
        {
          "s": 13,
          "text": "הנה אז הוא מהפך בחי' היחידה דנה\"ב,"
        },
        {
          "s": 14,
          "text": "שכל העצמיות שלה מתבטלת בבחי' היחידה דנה\"א,"
        },
        {
          "s": 15,
          "text": "וכאשר העצם שלה מתהפך הרי במילא אין לה שייכות לענינים של היפך ח\"ו"
        },
        {
          "s": 16,
          "text": "(וכמבואר בהמאמר שם,"
        },
        {
          "s": 17,
          "text": "שכאשר העצמיות שלה מתהפך כו' הרי במילא נלקח גם מקור החיות של כל רצון זר כו'),"
        },
        {
          "s": 18,
          "text": "ובמילא לא יתכן אז ענין המלחמה כלל,"
        },
        {
          "s": 19,
          "text": "והפדי' היא בשלום."
        }
      ]
    }
  ]
}