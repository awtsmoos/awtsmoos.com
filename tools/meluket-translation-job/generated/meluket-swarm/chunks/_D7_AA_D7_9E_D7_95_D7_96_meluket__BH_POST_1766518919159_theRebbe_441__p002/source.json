{
  "globalIndex": 902,
  "owner": 2,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919159_theRebbe_441__p002",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919159_theRebbe_441__p002",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919159_theRebbe_441",
  "title": "מאמר ה' לי בעוזרי תשי\"ז",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והענין הוא,"
        },
        {
          "s": 2,
          "text": "דזמירות הוא גם ענין שבח14."
        },
        {
          "s": 3,
          "text": "כדאיתא בתניא15,"
        },
        {
          "s": 4,
          "text": "דמה שדוד קרא דברי תורה בשם זמירות הו\"ע שבחא דאורייתא."
        },
        {
          "s": 5,
          "text": "שדוד הי' משבח את התורה בזה שחיות כל העולמות תלוי בדקדוק אחד מדקדוקי התורה."
        },
        {
          "s": 6,
          "text": "והשייכות דפירוש זה לפירוש הפשוט בזמירות היו לי חוקיך גו',"
        },
        {
          "s": 7,
          "text": "הוא,"
        },
        {
          "s": 8,
          "text": "דע\"י ההתבוננות במעלת ושבח התורה שכל העולמות בטלים במציאות לגבי דקדוק אחד מדקדוקי תורה,"
        },
        {
          "s": 9,
          "text": "עי\"ז פעל בעצמו שכל עניני העולם לא יתפסו מקום אצלו,"
        },
        {
          "s": 10,
          "text": "וגם כשהי' לא-טוב לו בגשמיות,"
        },
        {
          "s": 11,
          "text": "הי' עוסק בתורה בשמחה גדולה16."
        },
        {
          "s": 12,
          "text": "ובהמאמר דבעל הגאולה17"
        },
        {
          "s": 13,
          "text": "מבאר עוד פירוש בזמירות היו לי חוקיך,"
        },
        {
          "s": 14,
          "text": "זמירות הוא מלשון חיתוך וכריתה,"
        },
        {
          "s": 15,
          "text": "כמו לזמר עריצים18."
        },
        {
          "s": 16,
          "text": "דע\"י עסק התורה של דוד המלך,"
        },
        {
          "s": 17,
          "text": "נתבטלו כל שונאיו ורודפיו."
        },
        {
          "s": 18,
          "text": "וכמארז\"ל19"
        },
        {
          "s": 19,
          "text": "השכם והערב עליהן לבית המדרש והן כלין מאיליהן."
        },
        {
          "s": 20,
          "text": "ויש לקשר שני הפירושים,"
        },
        {
          "s": 21,
          "text": "דע\"י עסק התורה באופן דזמירות כהפירוש בתניא,"
        },
        {
          "s": 22,
          "text": "שהי' נרגש אצלו שחיות כל העולמות תלוי ב"
        },
        {
          "s": 23,
          "text": "(דקדוק אחד של)"
        },
        {
          "s": 24,
          "text": "תורה,"
        },
        {
          "s": 25,
          "text": "עי\"ז נעשה,"
        },
        {
          "s": 26,
          "text": "דמה שאינו מתאים לתורה,"
        },
        {
          "s": 27,
          "text": "ומכ\"ש מה שמנגד לתורה,"
        },
        {
          "s": 28,
          "text": "לא יהי' לו חיות,"
        },
        {
          "s": 29,
          "text": "זמירות מלשון לזמר עריצים."
        },
        {
          "s": 30,
          "text": "ועפ\"ז יובן גם מ\"ש זמירות היו לי חוקיך"
        },
        {
          "s": 31,
          "text": "(חוקיך דוקא),"
        },
        {
          "s": 32,
          "text": "כי שני ענינים הנ\"ל שבזמירות דתורה"
        },
        {
          "s": 33,
          "text": "(שבחא דאורייתא,"
        },
        {
          "s": 34,
          "text": "ולזמר עריצים),"
        },
        {
          "s": 35,
          "text": "הם,"
        },
        {
          "s": 36,
          "text": "בעיקר,"
        },
        {
          "s": 37,
          "text": "מצד ענין החוקים שבתורה."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והענין הוא,"
        },
        {
          "s": 2,
          "text": "דשתי חלוקות הכלליות שבמצוות20,"
        },
        {
          "s": 3,
          "text": "מצוות דעדות ומשפטים שיש עליהם טעם ומצוות דחוקים שלמעלה מהטעם,"
        },
        {
          "s": 4,
          "text": "הם שני ענינים כלליים בעבודת ה',"
        },
        {
          "s": 5,
          "text": "העבודה דטעם ודעת"
        },
        {
          "s": 6,
          "text": "(משפטים)"
        },
        {
          "s": 7,
          "text": "והעבודה דקבלת עול"
        },
        {
          "s": 8,
          "text": "(חוקים),"
        },
        {
          "s": 9,
          "text": "שצריכים להיות בכל מצוה ומצוה."
        },
        {
          "s": 10,
          "text": "והענין הוא,"
        },
        {
          "s": 11,
          "text": "דבמצוות יש שני ענינים21."
        },
        {
          "s": 12,
          "text": "א',"
        },
        {
          "s": 13,
          "text": "שהמצוות הם רצונו ית',"
        },
        {
          "s": 14,
          "text": "רצון שלמעלה מטעם."
        },
        {
          "s": 15,
          "text": "דענין זה הוא בכל המצוות בשוה."
        },
        {
          "s": 16,
          "text": "וב',"
        },
        {
          "s": 17,
          "text": "דלאחרי שהרצון נתלבש בחכמה"
        },
        {
          "s": 18,
          "text": "(דתורה),"
        },
        {
          "s": 19,
          "text": "הנה עי\"ז נוסף טעם לכל מצוה,"
        },
        {
          "s": 20,
          "text": "וג\"ז שע\"י כל מצוה נמשך אור וגילוי פרטי."
        },
        {
          "s": 21,
          "text": "דזהו מה שרמ\"ח פיקודין הם רמ\"ח אברים דמלכא22,"
        },
        {
          "s": 22,
          "text": "דכל אבר הוא כלי לכח פרטי23."
        },
        {
          "s": 23,
          "text": "וטעמים אלו הם מצד חכמה דתורה כמו שהיא למעלה."
        },
        {
          "s": 24,
          "text": "ומזה נמשכו"
        },
        {
          "s": 25,
          "text": "(ע\"י ריבוי השתלשלות)"
        },
        {
          "s": 26,
          "text": "טעמי המצוות שבגליא דתורה"
        },
        {
          "s": 27,
          "text": "(הטעמים דעדות ומשפטים כמו שהם בפשטות)24."
        },
        {
          "s": 28,
          "text": "וזהו מה שבקיום המצוות צריך להיות שתי כוונות,"
        },
        {
          "s": 29,
          "text": "כוונה כללית וכוונה פרטית25,"
        },
        {
          "s": 30,
          "text": "שמצד הרצון"
        },
        {
          "s": 31,
          "text": "(שלמעלה מטעם)"
        },
        {
          "s": 32,
          "text": "צ\"ל הכוונה כללית"
        },
        {
          "s": 33,
          "text": "(קב\"ע)"
        },
        {
          "s": 34,
          "text": "לקיים רצון ה',"
        },
        {
          "s": 35,
          "text": "ומצד הענין דטעמי המצוות צ\"ל הכוונה פרטית השייכת לאותה המצוה."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "וזהו מה ששני הענינים דחוקים ומשפטים הם שני ענינים כלליים שבכל מצוה ומצוה."
        },
        {
          "s": 2,
          "text": "שגם המצוות דעדות ומשפטים שיש עליהם טעם צריך לקיים"
        },
        {
          "s": 3,
          "text": "(בעיקר)"
        },
        {
          "s": 4,
          "text": "מפני שהם רצון ה',"
        },
        {
          "s": 5,
          "text": "כמו החוקים26."
        },
        {
          "s": 6,
          "text": "וכן לאידך,"
        },
        {
          "s": 7,
          "text": "שגם בהמצוות דחוקים יש הטעם והכוונה פרטית שבהם,"
        },
        {
          "s": 8,
          "text": "מה שע\"י כל מצוה"
        },
        {
          "s": 9,
          "text": "(גם המצוות דחוקים27)"
        },
        {
          "s": 10,
          "text": "נמשך אור וגילוי פרטי."
        },
        {
          "s": 11,
          "text": "ויתירה מזו,"
        },
        {
          "s": 12,
          "text": "דכל אחד משני ענינים אלו"
        },
        {
          "s": 13,
          "text": "(חוקים ומשפטים)"
        },
        {
          "s": 14,
          "text": "הו\"ע כללי בעבודת האדם,"
        },
        {
          "s": 15,
          "text": "לא רק בקיום המצוות אלא גם בכללות הנהגת האדם."
        },
        {
          "s": 16,
          "text": "דענין המשפטים הוא"
        },
        {
          "s": 17,
          "text": "(כמבואר בהמאמר28)"
        },
        {
          "s": 18,
          "text": "לשפוט כל דבר,"
        },
        {
          "s": 19,
          "text": "אם זה מתאים ע\"פ שכל וחכמת התורה,"
        },
        {
          "s": 20,
          "text": "וגם כשהדבר מצד עצמו אין בו שום שמץ איסור,"
        },
        {
          "s": 21,
          "text": "צריך לשקול היטב אם זה לא יגרום חלישות באיזה מצוה או מנהג ישראל,"
        },
        {
          "s": 22,
          "text": "שאז צריך לדחות את הדבר מכל וכל."
        },
        {
          "s": 23,
          "text": "וענין חוקים הוא העבודה דקבלת עול מלכות שמים,"
        },
        {
          "s": 24,
          "text": "שצריכה להיות לא רק בעת קיום מצוה אלא במשך כל היום29."
        }
      ]
    }
  ]
}