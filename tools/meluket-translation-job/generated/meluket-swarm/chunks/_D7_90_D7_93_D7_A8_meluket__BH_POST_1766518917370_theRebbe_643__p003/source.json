{
  "globalIndex": 622,
  "owner": 22,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917370_theRebbe_643__p003",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917370_theRebbe_643__p003",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917370_theRebbe_643",
  "title": "מאמר וקבל היהודים תשל\"ח",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה,"
        },
        {
          "s": 2,
          "text": "עוד זאת מפעולות ביטול הנ\"ל,"
        },
        {
          "s": 3,
          "text": "דזה שמכיר שהוא בתכלית הירידה וכו' פועל עליו שגם אם עבודתו היא כדבעי מ\"מ יחנך א\"ע דוגמת החינוך דתשב\"ר כפשוטו,"
        },
        {
          "s": 4,
          "text": "כי הוא מרגיש עצמו בבחי' תינוק בעבודתו"
        },
        {
          "s": 5,
          "text": "(וכנ\"ל דבמה נחשב הוא לגבי אמיתיות ערכו)."
        },
        {
          "s": 6,
          "text": "וענין החינוך צ\"ל במס\"נ"
        },
        {
          "s": 7,
          "text": "(כנ\"ל),"
        },
        {
          "s": 8,
          "text": "וכמו שמבאר בהמאמר הנ\"ל40"
        },
        {
          "s": 9,
          "text": "המס\"נ שהי' בזה בזמן מרדכי,"
        },
        {
          "s": 10,
          "text": "והרי התורה היא נצחית41,"
        },
        {
          "s": 11,
          "text": "שבזה ישנה הוראה"
        },
        {
          "s": 12,
          "text": "[תורה מלשון הוראה,"
        },
        {
          "s": 13,
          "text": "כדאיתא בזהר42]"
        },
        {
          "s": 14,
          "text": "נצחית לכאו\"א בכל זמן ובכל מקום,"
        },
        {
          "s": 15,
          "text": "שצריך למסור נפשו על ענין החינוך,"
        },
        {
          "s": 16,
          "text": "הן על חינוך עצמו,"
        },
        {
          "s": 17,
          "text": "כמאמר המשנה43"
        },
        {
          "s": 18,
          "text": "איזהו חכם הלומד מכל אדם,"
        },
        {
          "s": 19,
          "text": "דחינוך זה צ\"ל בכל יום ויום במשך כל ימי חייו,"
        },
        {
          "s": 20,
          "text": "שהרי בכל יום צריך לעלות בעבודתו כמאמר44"
        },
        {
          "s": 21,
          "text": "מעלין בקודש,"
        },
        {
          "s": 22,
          "text": "שגם כשהוא בבחי' קודש,"
        },
        {
          "s": 23,
          "text": "דקודש מלה בגרמי'45"
        },
        {
          "s": 24,
          "text": "הוא בחי' החכמה46"
        },
        {
          "s": 25,
          "text": "[שהוא בדרגת חכם כי אתמול כבר למד מכל אדם],"
        },
        {
          "s": 26,
          "text": "הנה גם אז צ\"ל עלי',"
        },
        {
          "s": 27,
          "text": "שבהגיע יום חדש יהי' עביד עבידתי'45"
        },
        {
          "s": 28,
          "text": "ויוסיף ללמוד מכל אדם ויתעלה בדרגת החכמה שלו,"
        },
        {
          "s": 29,
          "text": "היינו שבכל יום ויום צ\"ל חינוך עצמו."
        },
        {
          "s": 30,
          "text": "וכן מובן גם מתורת הבעש\"ט הידועה47"
        },
        {
          "s": 31,
          "text": "שבכל ענין שיהודי רואה או שומע צריך לראות ולשמוע"
        },
        {
          "s": 32,
          "text": "(דערזעהן און דערהערן)"
        },
        {
          "s": 33,
          "text": "ההוראה שבזה בעבודתו לקונו,"
        },
        {
          "s": 34,
          "text": "היינו שבכל ענין שרואה או שומע צריך לחנך את עצמו."
        },
        {
          "s": 35,
          "text": "ועאכו\"כ שצריך למסור נפשו על ענין החינוך דתשב\"ר כפשוטו."
        },
        {
          "s": 36,
          "text": "ובמיוחד יש בזה חוב על הצעירים והצעירות כמו שמוסיף כ\"ק מו\"ח אדמו\"ר במכתבו בקשר למאמרו הנ\"ל48"
        },
        {
          "s": 37,
          "text": "דהעת אומרת,"
        },
        {
          "s": 38,
          "text": "אשר כל אחד ואחד מהצעירים והצעירות יחיו,"
        },
        {
          "s": 39,
          "text": "הנה לא זו בלבד שהם בעצמם בחייהם הפרטים,"
        },
        {
          "s": 40,
          "text": "צריכים להיות איתן וחזק בשמירת קיום המצוות מעשיות בכל הידורן כו'"
        },
        {
          "s": 41,
          "text": "[ועי\"ז להיות דוגמא חי']"
        },
        {
          "s": 42,
          "text": "אלא עוד זאת"
        },
        {
          "s": 43,
          "text": "[וגם זה עיקר]"
        },
        {
          "s": 44,
          "text": "לעשות סביבה של לומדי תורה ושומרי מצוה,"
        },
        {
          "s": 45,
          "text": "ועד שיראו אצלם בגלוי שהם נצר מטעי מעשה ידי להתפאר."
        },
        {
          "s": 46,
          "text": "ובכללות,"
        },
        {
          "s": 47,
          "text": "חובה זו היא על כאו\"א,"
        },
        {
          "s": 48,
          "text": "דהרי כאו\"א הוא בכלל דצעירים וצעירות כשנזכר שבכל יום ויום נעשה כברי' חדשה49."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "והנה ע\"י החינוך דתשב\"ר נעשה מפי עוללים ויונקים יסדת עוז גו' להשבית אויב ומתנקם50,"
        },
        {
          "s": 1,
          "text": "וכמו שמבאר בהמאמר הנ\"ל51"
        },
        {
          "s": 2,
          "text": "דהאויב הוא שונא הגלוי,"
        },
        {
          "s": 3,
          "text": "והנוקם הוא שונא נסתר ועולל עלילות כו'"
        },
        {
          "s": 4,
          "text": "[ובעבודה הו\"ע מה שאמר יעקב52"
        },
        {
          "s": 5,
          "text": "אשר לקחתי מיד האמורי בחרבי ובקשתי,"
        },
        {
          "s": 6,
          "text": "דההפרש בין חרב לקשת הוא שהחרב הורג את השונא שעומד אצלו בקרוב,"
        },
        {
          "s": 7,
          "text": "והקשת יכול להרוג גם את השונא שעומד מרחוק53,"
        },
        {
          "s": 8,
          "text": "דהשונא הקרוב קאי על"
        },
        {
          "s": 9,
          "text": "(גסות)"
        },
        {
          "s": 10,
          "text": "הרע שהאדם יודע ומבין שהוא רע,"
        },
        {
          "s": 11,
          "text": "והשונא שעומד מרחוק הוא דקות הרע שאינו יודע ממנו כו'."
        },
        {
          "s": 12,
          "text": "והעברת האויב ומתנקם הוא ע\"י העבודה דחרבי וקשתי,"
        },
        {
          "s": 13,
          "text": "כמבואר בהמאמרים54"
        },
        {
          "s": 14,
          "text": "בענין החמשה כלי זיין המנויים במשנה דשבת55]."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה הכח לעבודה הנ\"ל הוא ע\"י משה רבינו."
        },
        {
          "s": 2,
          "text": "כמבואר בהמאמר הנ\"ל56"
        },
        {
          "s": 3,
          "text": "דזהו מ\"ש ואתה תצוה את בני ישראל גו',"
        },
        {
          "s": 4,
          "text": "דתצוה הוא לשון צוותא וחיבור,"
        },
        {
          "s": 5,
          "text": "ואתה קאי"
        },
        {
          "s": 6,
          "text": "(בפשש\"מ)"
        },
        {
          "s": 7,
          "text": "על משה,"
        },
        {
          "s": 8,
          "text": "ואתפשטותא דמשה בכל דרא ודרא,"
        },
        {
          "s": 9,
          "text": "שבכל א' מישראל ישנו מבחי' משה כדאיתא בתיקוני זהר57"
        },
        {
          "s": 10,
          "text": "והובא באגרת הקודש לכ\"ק אדמו\"ר הזקן58,"
        },
        {
          "s": 11,
          "text": "ובכל א' הנה בחי' משה שבו היא בגלוי עד שמשו\"ז יראה מילתא זוטרתי היא59"
        },
        {
          "s": 12,
          "text": "לגבי' כדאיתא בתניא חלק ראשון60,"
        },
        {
          "s": 13,
          "text": "ובחינת משה שבכל אחד מישראל מחברת באופן דצוותא וחיבור"
        },
        {
          "s": 14,
          "text": "(תצוה)"
        },
        {
          "s": 15,
          "text": "את61"
        },
        {
          "s": 16,
          "text": "שרש הנשמה62"
        },
        {
          "s": 17,
          "text": "להנשמה המלובשת בגוף ועם נה\"ב וגופו וחלקו בעולם,"
        },
        {
          "s": 18,
          "text": "ונותנת כח שיהי' כתית למאור,"
        },
        {
          "s": 19,
          "text": "שמזה שנדכא ונשבר מצד ירידת הנשמה לעוה\"ז התחתון שאין תחתון למטה ממנו63,"
        },
        {
          "s": 20,
          "text": "שזהו ירידה עצומה,"
        },
        {
          "s": 21,
          "text": "כי אפילו כשעוה\"ז הוא בתכלית השלימות נקרא בירא עמיקתא64,"
        },
        {
          "s": 22,
          "text": "דמזה מובן שעצם הדבר שהנשמה ירדה לעוה\"ז הוא ירידה גדולה."
        },
        {
          "s": 23,
          "text": "ומצד הירידה,"
        },
        {
          "s": 24,
          "text": "אף שהוא במצב של תכלית ההרחבה בגשמיות וגם ברוחניות מ\"מ במה נחשב הוא לגבי מעמדו ומצבו האמיתי"
        },
        {
          "s": 25,
          "text": "(שלפני הירידה)"
        },
        {
          "s": 26,
          "text": "שהוא בבחי' בנו65"
        },
        {
          "s": 27,
          "text": "יחידו של ממה\"מ הקב\"ה"
        },
        {
          "s": 28,
          "text": "(כידוע המשל בזה בהמשך תרס\"ו66),"
        },
        {
          "s": 29,
          "text": "הנה מהכתית"
        },
        {
          "s": 30,
          "text": "(שנשבר ונדכא)"
        },
        {
          "s": 31,
          "text": "נעשה למאור שמגיע להמאור עצמו כנ\"ל."
        }
      ]
    }
  ]
}