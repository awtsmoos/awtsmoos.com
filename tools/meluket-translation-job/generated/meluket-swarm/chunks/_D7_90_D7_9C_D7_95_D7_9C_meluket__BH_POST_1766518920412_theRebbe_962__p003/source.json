{
  "globalIndex": 1108,
  "owner": 8,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920412_theRebbe_962__p003",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920412_theRebbe_962__p003",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920412_theRebbe_962",
  "title": "מאמר קומי אורי תשל\"ג",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וממשיך בכתוב נראה אור,"
        },
        {
          "s": 2,
          "text": "שהוא למעלה גם מאורך,"
        },
        {
          "s": 3,
          "text": "ועד שאורך אינו אלא הכנה להאור הנראה על ידו"
        },
        {
          "s": 4,
          "text": "(כנ\"ל מהמאמר)."
        },
        {
          "s": 5,
          "text": "ויש לומר הביאור בזה ע\"פ הידוע29"
        },
        {
          "s": 6,
          "text": "בענין תורה ונש\"י,"
        },
        {
          "s": 7,
          "text": "דשרש ישראל הוא למעלה משרש התורה30,"
        },
        {
          "s": 8,
          "text": "כדאיתא בתדב\"א31"
        },
        {
          "s": 9,
          "text": "שני דברים קדמו לעולם תורה וישראל,"
        },
        {
          "s": 10,
          "text": "ואיני יודע איזה מהם קודם,"
        },
        {
          "s": 11,
          "text": "כשהוא אומר צו את בני ישראל דבר אל בני ישראל,"
        },
        {
          "s": 12,
          "text": "אומר אני ישראל קדמו."
        },
        {
          "s": 13,
          "text": "אלא שנש\"י נמשכו וירדו בבחינת מציאות בפ\"ע,"
        },
        {
          "s": 14,
          "text": "כמו הבן"
        },
        {
          "s": 15,
          "text": "(בנים אתם לה' אלקיכם32)"
        },
        {
          "s": 16,
          "text": "שעם היותו מעצמות האב,"
        },
        {
          "s": 17,
          "text": "הוא מציאות נבדל33,"
        },
        {
          "s": 18,
          "text": "והתורה גם כמו שנמשכה למטה היא מיוחדת עמו ית',"
        },
        {
          "s": 19,
          "text": "אורייתא וקוב\"ה כולא חד34."
        },
        {
          "s": 20,
          "text": "וזהו הטעם שמעלתן של ישראל"
        },
        {
          "s": 21,
          "text": "(שקדמו לתורה)"
        },
        {
          "s": 22,
          "text": "נתגלתה ע\"י התורה"
        },
        {
          "s": 23,
          "text": "(שבתורה נאמר צו את בני ישראל,"
        },
        {
          "s": 24,
          "text": "דבר אל בני ישראל),"
        },
        {
          "s": 25,
          "text": "כי הנשמות,"
        },
        {
          "s": 26,
          "text": "כמו שהן מצד עצמן,"
        },
        {
          "s": 27,
          "text": "להיותן מציאות נבדל,"
        },
        {
          "s": 28,
          "text": "השרש שלהם הוא בהעלם,"
        },
        {
          "s": 29,
          "text": "משא\"כ תורה,"
        },
        {
          "s": 30,
          "text": "שהיא חד עם הקב\"ה,"
        },
        {
          "s": 31,
          "text": "היא בחי' גילוי"
        },
        {
          "s": 32,
          "text": "(ותורה אור),"
        },
        {
          "s": 33,
          "text": "וע\"י התורה מתגלה"
        },
        {
          "s": 34,
          "text": "(גם)"
        },
        {
          "s": 35,
          "text": "השרש דישראל."
        },
        {
          "s": 36,
          "text": "ועפ\"ז יש לומר ששני הענינים דבאורך נראה אור הם תורה וישראל."
        },
        {
          "s": 37,
          "text": "אורך היא תורה"
        },
        {
          "s": 38,
          "text": "(כנ\"ל),"
        },
        {
          "s": 39,
          "text": "והאור שנראה ע\"י אורך הוא השרש דישראל שמתגלה ע\"י התורה35."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וזהו קומי אורי כי בא אורך,"
        },
        {
          "s": 2,
          "text": "דשני ענינים אלו"
        },
        {
          "s": 3,
          "text": "(אורי ואורך)"
        },
        {
          "s": 4,
          "text": "הם דוגמת שני הענינים דבאורך נראה אור"
        },
        {
          "s": 5,
          "text": "(כנ\"ל בתחלת המאמר)."
        },
        {
          "s": 6,
          "text": "אורך,"
        },
        {
          "s": 7,
          "text": "האור של ישראל עצמם,"
        },
        {
          "s": 8,
          "text": "הוא ע\"ד באורך"
        },
        {
          "s": 9,
          "text": "(אור שלך),"
        },
        {
          "s": 10,
          "text": "וקומי אורי,"
        },
        {
          "s": 11,
          "text": "האור שישראל מאירים,"
        },
        {
          "s": 12,
          "text": "הוא ע\"ד האור שנראה ע\"י אורך"
        },
        {
          "s": 13,
          "text": "(שלמעלה מאורך)."
        },
        {
          "s": 14,
          "text": "ויובן זה ע\"פ המבואר במק\"א36"
        },
        {
          "s": 15,
          "text": "בענין נשמה וגוף,"
        },
        {
          "s": 16,
          "text": "דבנשמות כתיב32"
        },
        {
          "s": 17,
          "text": "בנים אתם להוי' אלקיכם37,"
        },
        {
          "s": 18,
          "text": "ולכן,"
        },
        {
          "s": 19,
          "text": "האהבה וההתקשרות דהקב\"ה לישראל מצד נשמתם היא כמו אהבה טבעית כביכול"
        },
        {
          "s": 20,
          "text": "(ע\"ד אהבת אב לבנו)."
        },
        {
          "s": 21,
          "text": "היינו,"
        },
        {
          "s": 22,
          "text": "ששרש אהבה זו היא ממדריגה ששייכת שם תפיסת מקום דהנאהב,"
        },
        {
          "s": 23,
          "text": "ואינה מעצמותו ממש."
        },
        {
          "s": 24,
          "text": "משא\"כ האהבה וההתקשרות דהקב\"ה לישראל מצד הגוף שלהם,"
        },
        {
          "s": 25,
          "text": "היא"
        },
        {
          "s": 26,
          "text": "(לא מצד מעלת הגוף,"
        },
        {
          "s": 27,
          "text": "גם לא המעלה ד\"בן\","
        },
        {
          "s": 28,
          "text": "מעלה עצמית,"
        },
        {
          "s": 29,
          "text": "אלא)"
        },
        {
          "s": 30,
          "text": "מצד זה שהקב\"ה בחר בהגוף דישראל38,"
        },
        {
          "s": 31,
          "text": "בבחירתו חפשית,"
        },
        {
          "s": 32,
          "text": "שבחירה זו היא מעצמותו ממש."
        },
        {
          "s": 33,
          "text": "אלא,"
        },
        {
          "s": 34,
          "text": "שמעלת הנשמה"
        },
        {
          "s": 35,
          "text": "(שהיא בן להקב\"ה)"
        },
        {
          "s": 36,
          "text": "היא בגילוי,"
        },
        {
          "s": 37,
          "text": "משא\"כ מעלת הגוף"
        },
        {
          "s": 38,
          "text": "(שבו הוא בחירת העצמות)"
        },
        {
          "s": 39,
          "text": "היא בהעלם."
        },
        {
          "s": 40,
          "text": "וע\"י שהנשמה עובדת עם הגוף,"
        },
        {
          "s": 41,
          "text": "מתגלה בו מעלתו,"
        },
        {
          "s": 42,
          "text": "בחירת העצמות."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש לומר פירוש קומי אורי כי בא אורך,"
        },
        {
          "s": 1,
          "text": "שאורך הוא האור דהנשמה,"
        },
        {
          "s": 2,
          "text": "וקומי אורי הוא שע\"י האור דהנשמה"
        },
        {
          "s": 3,
          "text": "(בא אורך)"
        },
        {
          "s": 4,
          "text": "היא צריכה לעבוד בהגוף ולהאיר אותו,"
        },
        {
          "s": 5,
          "text": "שעי\"ז נתגלה ענין נעלה יותר מהאור של הנשמה"
        },
        {
          "s": 6,
          "text": "(אורך),"
        },
        {
          "s": 7,
          "text": "ע\"ד שנת\"ל"
        },
        {
          "s": 8,
          "text": "(סעיף ב)"
        },
        {
          "s": 9,
          "text": "בענין באורך נראה אור,"
        },
        {
          "s": 10,
          "text": "דהאור שנראה ע\"י אורך הוא נעלה יותר מאורך."
        }
      ]
    }
  ]
}