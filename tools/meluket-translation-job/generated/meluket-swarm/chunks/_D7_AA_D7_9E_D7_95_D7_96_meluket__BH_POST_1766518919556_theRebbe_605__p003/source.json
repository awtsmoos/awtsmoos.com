{
  "globalIndex": 977,
  "owner": 27,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919556_theRebbe_605__p003",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919556_theRebbe_605__p003",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919556_theRebbe_605",
  "title": "מאמר אלה מסעי תשי\"ג",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ולהבין בעומק יותר מה שנשמות ישראל הם בבחי' פנימיות,"
        },
        {
          "s": 2,
          "text": "הנה כתיב37"
        },
        {
          "s": 3,
          "text": "ועתה ישראל מה הוי' אלקיך שואל מעמך כי אם ליראה גו',"
        },
        {
          "s": 4,
          "text": "ואמרו רז\"ל38"
        },
        {
          "s": 5,
          "text": "אטו יראה מילתא זוטרתי היא,"
        },
        {
          "s": 6,
          "text": "אין לגבי משה מילתא זוטרתי היא."
        },
        {
          "s": 7,
          "text": "והנה,"
        },
        {
          "s": 8,
          "text": "מ\"ש כי אם ליראה,"
        },
        {
          "s": 9,
          "text": "קאי על יראה תתאה,"
        },
        {
          "s": 10,
          "text": "שזהו אומרו כי אם ליראה,"
        },
        {
          "s": 11,
          "text": "היינו שהיא יראה היותר פחותה,"
        },
        {
          "s": 12,
          "text": "ולכן לגבי משה מילתא זוטרתי היא."
        },
        {
          "s": 13,
          "text": "והענין בזה,"
        },
        {
          "s": 14,
          "text": "דהנה כתיב39"
        },
        {
          "s": 15,
          "text": "כי א-ל דעות הוי',"
        },
        {
          "s": 16,
          "text": "ב' דעות40,"
        },
        {
          "s": 17,
          "text": "דעת עליון ודעת תחתון41."
        },
        {
          "s": 18,
          "text": "דעת עליון הוא שלמעלה יש ולמטה אין,"
        },
        {
          "s": 19,
          "text": "היינו,"
        },
        {
          "s": 20,
          "text": "שרואים בראי' חושית שלמעלה הוא היש האמיתי ולמטה אין,"
        },
        {
          "s": 21,
          "text": "ודעת תחתון הוא שהבריאה היא יש מאין,"
        },
        {
          "s": 22,
          "text": "היינו שלמטה יש ולמעלה אין,"
        },
        {
          "s": 23,
          "text": "דכיון שהוא רואה רק את היש הנברא,"
        },
        {
          "s": 24,
          "text": "לכן קורא להמטה בשם יש ולהמעלה בשם אין."
        },
        {
          "s": 25,
          "text": "ומצד ההפרש בין ב' דעות אלו יש הפרש גם בביטולם,"
        },
        {
          "s": 26,
          "text": "שהביטול שמצד דעת תחתון הוא ביטול היש בלבד,"
        },
        {
          "s": 27,
          "text": "דכיון שהוא רואה את היש,"
        },
        {
          "s": 28,
          "text": "הרי הוא במציאות,"
        },
        {
          "s": 29,
          "text": "אלא שאעפ\"כ יש בו גם ענין של ביטול,"
        },
        {
          "s": 30,
          "text": "ביטול היש,"
        },
        {
          "s": 31,
          "text": "משא\"כ הביטול שמצד דעת עליון הוא ביטול במציאות,"
        },
        {
          "s": 32,
          "text": "דכיון שרואה שלמטה הוא אין,"
        },
        {
          "s": 33,
          "text": "לכן הביטול הוא ביטול במציאות."
        },
        {
          "s": 34,
          "text": "וזהו שלגבי משה יראה תתאה מילתא זוטרתי היא,"
        },
        {
          "s": 35,
          "text": "דהנה משה הוא בבחי' דעת עליון,"
        },
        {
          "s": 36,
          "text": "כמאמר רז\"ל42"
        },
        {
          "s": 37,
          "text": "כל הנביאים נתנבאו בכה ומשה נתנבא בזה,"
        },
        {
          "s": 38,
          "text": "דזה הוא ראיית המהות,"
        },
        {
          "s": 39,
          "text": "בחי' דעת עליון,"
        },
        {
          "s": 40,
          "text": "שמצד זה הי' בבחינת ביטול במציאות,"
        },
        {
          "s": 41,
          "text": "ולכן לגבי משה שהוא בבחי' דעת עליון,"
        },
        {
          "s": 42,
          "text": "ביטול במציאות,"
        },
        {
          "s": 43,
          "text": "הנה יראה תתאה שהיא בבחי' ביטול היש בלבד,"
        },
        {
          "s": 44,
          "text": "מילתא זוטרתי היא."
        },
        {
          "s": 45,
          "text": "והנה43,"
        },
        {
          "s": 46,
          "text": "אף שיראה תתאה היא מדריגה תחתונה,"
        },
        {
          "s": 47,
          "text": "מילתא זוטרתי,"
        },
        {
          "s": 48,
          "text": "שעל זה אמרו כי אם ליראה,"
        },
        {
          "s": 49,
          "text": "מ\"מ,"
        },
        {
          "s": 50,
          "text": "תובעים"
        },
        {
          "s": 51,
          "text": "(מאָנט מען)"
        },
        {
          "s": 52,
          "text": "יראה תתאה דוקא,"
        },
        {
          "s": 53,
          "text": "לפי שתכלית המכוון ועיקר התענוג הוא ביראה תתאה יותר מאשר ביראה עילאה,"
        },
        {
          "s": 54,
          "text": "וכמ\"ש44"
        },
        {
          "s": 55,
          "text": "צחוק עשה לי אלקים,"
        },
        {
          "s": 56,
          "text": "שדוקא עי\"ז שפועלים ענין הביטול בהדברים שבאים משם אלקים דוקא שהם בבחי' יש,"
        },
        {
          "s": 57,
          "text": "ביטול היש לאין,"
        },
        {
          "s": 58,
          "text": "אזי נעשה עיקר ענין הצחוק והתענוג למעלה,"
        },
        {
          "s": 59,
          "text": "וכמו\"כ כתיב45"
        },
        {
          "s": 60,
          "text": "לויתן זה יצרת לשחק בו,"
        },
        {
          "s": 61,
          "text": "דלויתן הוא מלשון חבור,"
        },
        {
          "s": 62,
          "text": "כמ\"ש46"
        },
        {
          "s": 63,
          "text": "ילוה אישי,"
        },
        {
          "s": 64,
          "text": "וענין החבור שייך דוקא כאשר יש ב' דברים נבדלים זה מזה,"
        },
        {
          "s": 65,
          "text": "וענין זה הוא בהעבודה דביטול היש דוקא,"
        },
        {
          "s": 66,
          "text": "שהיש והאין הם ב' דברים נבדלים זמ\"ז,"
        },
        {
          "s": 67,
          "text": "ומ\"מ פועלים ביטול היש לאין,"
        },
        {
          "s": 68,
          "text": "ועי\"ז דוקא נעשה ענין השחוק,"
        },
        {
          "s": 69,
          "text": "לשחק בו."
        },
        {
          "s": 70,
          "text": "והיינו,"
        },
        {
          "s": 71,
          "text": "דעם היות שהעבודה דאתהפכא היא למעלה יותר מהעבודה דאתכפיא,"
        },
        {
          "s": 72,
          "text": "הנה זהו רק בענין הגילויים,"
        },
        {
          "s": 73,
          "text": "אבל עיקר התענוג הוא בעבודה דאתכפיא דוקא."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "אך עדיין צריך להבין מ\"ש אין לגבי משה מילתא זוטרתי היא,"
        },
        {
          "s": 1,
          "text": "דלכאורה אינו מובן,"
        },
        {
          "s": 2,
          "text": "הרי שואל מעמך כתיב."
        },
        {
          "s": 3,
          "text": "אך הענין הוא,"
        },
        {
          "s": 4,
          "text": "כמבואר בתניא47"
        },
        {
          "s": 5,
          "text": "שכל נפש ונפש מבית ישראל יש בה מבחי' משה רבינו,"
        },
        {
          "s": 6,
          "text": "ניצוץ מנשמת משה,"
        },
        {
          "s": 7,
          "text": "והוא בחי' מ\"ה שבכל אחד מישראל,"
        },
        {
          "s": 8,
          "text": "שהו\"ע ביטול במציאות"
        },
        {
          "s": 9,
          "text": "(כנ\"ל),"
        },
        {
          "s": 10,
          "text": "והיינו לפי ששרש הנשמות הוא מבחי' חכמה,"
        },
        {
          "s": 11,
          "text": "כמ\"ש48"
        },
        {
          "s": 12,
          "text": "בנים אתם להוי' אלקיכם,"
        },
        {
          "s": 13,
          "text": "וכתיב49"
        },
        {
          "s": 14,
          "text": "בני בכורי ישראל,"
        },
        {
          "s": 15,
          "text": "וכמו הבן שנמשך מעצמות מוח האב,"
        },
        {
          "s": 16,
          "text": "כמו\"כ הנשמות הם מעצמות בחי' החכמה,"
        },
        {
          "s": 17,
          "text": "שהיא בחי' מ\"ה."
        },
        {
          "s": 18,
          "text": "ולכן הנשמות הם בתכלית הביטול,"
        },
        {
          "s": 19,
          "text": "ביטול במציאות,"
        },
        {
          "s": 20,
          "text": "כמ\"ש50"
        },
        {
          "s": 21,
          "text": "חי הוי' אלקי ישראל אשר עמדתי לפניו,"
        },
        {
          "s": 22,
          "text": "שזה קאי על כל הנשמות,"
        },
        {
          "s": 23,
          "text": "שהם באופן של עמידה,"
        },
        {
          "s": 24,
          "text": "שהו\"ע הביטול."
        },
        {
          "s": 25,
          "text": "וזהו ועתה ישראל מ\"ה הוי' אלקיך שואל מעמך כי אם ליראה,"
        },
        {
          "s": 26,
          "text": "דכיון שכל ישראל הם בבחי' מ\"ה,"
        },
        {
          "s": 27,
          "text": "מצד הניצוץ משה שבכל אחד מישראל,"
        },
        {
          "s": 28,
          "text": "הנה מה הוי' אלקיך שואל מעמך כי אם ליראה,"
        },
        {
          "s": 29,
          "text": "שיראה היא מילתא זוטרתי לגבי הניצוץ משה שבכל אחד מישראל."
        },
        {
          "s": 30,
          "text": "ובכדי לגלות בחי' מ\"ה שבנפש,"
        },
        {
          "s": 31,
          "text": "הנה על זה תקנו מאה ברכות,"
        },
        {
          "s": 32,
          "text": "כמאמר רז\"ל51"
        },
        {
          "s": 33,
          "text": "אל תקרי מה אלא מאה,"
        },
        {
          "s": 34,
          "text": "שמזה למדו שחייב אדם לברך מאה ברכות בכל יום,"
        },
        {
          "s": 35,
          "text": "דמאה ברכות הוא ע\"ד מ\"ש52"
        },
        {
          "s": 36,
          "text": "ויזרע יצחק בארץ ההיא וימצא גו' מאה שערים ויברכהו ה',"
        },
        {
          "s": 37,
          "text": "והיינו,"
        },
        {
          "s": 38,
          "text": "שע\"י עבודת הצדקה,"
        },
        {
          "s": 39,
          "text": "זורע צדקות53,"
        },
        {
          "s": 40,
          "text": "נעשית הברכה וההמשכה מלמעלה שנתגלה בחי' מ\"ה שבנפש."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "אמנם בזמן הגלות אין העבודה בבחי' מ\"ה שהיא פנימיות הנפש,"
        },
        {
          "s": 1,
          "text": "כי אם בבחי' חיצוניות ואחוריים בלבד,"
        },
        {
          "s": 2,
          "text": "שלכן נעשה גם למעלה הסתר אסתיר פני"
        },
        {
          "s": 3,
          "text": "(כנ\"ל),"
        },
        {
          "s": 4,
          "text": "ולכן אנו מבקשים זכור ה' מה הי' לנו,"
        },
        {
          "s": 5,
          "text": "וואָס איז געוואָרען מיט אונזער מ\"ה,"
        },
        {
          "s": 6,
          "text": "שהמ\"ה הוא בהעלם והסתר."
        },
        {
          "s": 7,
          "text": "ועם היותו בהעלם,"
        },
        {
          "s": 8,
          "text": "מ\"מ שייך ענין הזכירה,"
        },
        {
          "s": 9,
          "text": "שהרי סוכ\"ס עיקרה שרשה ועצמותה של הנשמה היא בבחי' מ\"ה."
        },
        {
          "s": 10,
          "text": "וממשיך בכתוב הביטה גו',"
        },
        {
          "s": 11,
          "text": "דהנה,"
        },
        {
          "s": 12,
          "text": "ההפרש בין ראי' והבטה הוא54"
        },
        {
          "s": 13,
          "text": "שראי' היא בקירוב,"
        },
        {
          "s": 14,
          "text": "כמ\"ש55"
        },
        {
          "s": 15,
          "text": "וירא כי לא יכול לו,"
        },
        {
          "s": 16,
          "text": "והבטה הוא בריחוק,"
        },
        {
          "s": 17,
          "text": "כמ\"ש56"
        },
        {
          "s": 18,
          "text": "הבט משמים וראה,"
        },
        {
          "s": 19,
          "text": "ולכן,"
        },
        {
          "s": 20,
          "text": "ענין הראי' שבקירוב אי אפשר להיות בזמן הגלות,"
        },
        {
          "s": 21,
          "text": "ולזה אנו מבקשים הביטה,"
        },
        {
          "s": 22,
          "text": "שזהו הגילוי שבבחי' מקיף,"
        },
        {
          "s": 23,
          "text": "ועם היותו בבחי' מקיף,"
        },
        {
          "s": 24,
          "text": "הרי זה פועל גם בפנימיות,"
        },
        {
          "s": 25,
          "text": "ובפרט בנוגע לפעולה על הקליפות,"
        },
        {
          "s": 26,
          "text": "דאור מקיף מסמא עיני החיצונים57."
        }
      ]
    }
  ]
}