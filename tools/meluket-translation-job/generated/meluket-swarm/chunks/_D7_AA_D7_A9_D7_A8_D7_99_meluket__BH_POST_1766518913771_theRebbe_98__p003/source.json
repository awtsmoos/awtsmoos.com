{
  "globalIndex": 15,
  "owner": 15,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913771_theRebbe_98__p003",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913771_theRebbe_98__p003",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518913771_theRebbe_98",
  "title": "מאמר יו\"ט של ר\"ה תשל\"ג",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "וזהו32 משביעין אותו תהי צדיק,"
        },
        {
          "s": 1,
          "text": "דזה שצריך להשביע את הנשמה תהי צדיק,"
        },
        {
          "s": 2,
          "text": "הגם שזה"
        },
        {
          "s": 3,
          "text": "(להיות צדיק)"
        },
        {
          "s": 4,
          "text": "הוא רצון הנשמה,"
        },
        {
          "s": 5,
          "text": "כי ע\"י התלבשותה בגוף ונפש הבהמית,"
        },
        {
          "s": 6,
          "text": "אפשר שהגוף ונה\"ב יעלימו ויסתירו על הנשמה."
        },
        {
          "s": 7,
          "text": "ובפרט ששרש נה\"א הוא בתיקון ושרש נה\"ב הוא בתוהו שקדם לתיקון."
        },
        {
          "s": 8,
          "text": "ולכן משביעין את הנשמה תהי צדיק,"
        },
        {
          "s": 9,
          "text": "דענין השבועה הוא המשכת שרש הנשמה כמו שהיא מושרשת בעצמות אוא\"ס"
        },
        {
          "s": 10,
          "text": "(למעלה מהענין דתוהו ותיקון),"
        },
        {
          "s": 11,
          "text": "ועי\"ז תוכל להתגבר על נה\"ב."
        },
        {
          "s": 12,
          "text": "וזהו שמשביעין אותו הוא גם מלשון שובע,"
        },
        {
          "s": 13,
          "text": "דשובע הוא נתינת כח."
        },
        {
          "s": 14,
          "text": "וע\"י השבועה,"
        },
        {
          "s": 15,
          "text": "המשכת שרש הנשמה כמו שהיא מושרשת בעצמות אוא\"ס"
        },
        {
          "s": 16,
          "text": "[שהוא בדוגמת שרש הבן כמו שהוא במוח האב עצמו טרם שנמשך33],"
        },
        {
          "s": 17,
          "text": "נותנים כח להנשמה כמו שהיא בגילוי למעלה"
        },
        {
          "s": 18,
          "text": "[שהוא בדוגמת הבן כמו שנמשך ממוח האב33],"
        },
        {
          "s": 19,
          "text": "וגם להנשמה כמו שהיא מלובשת בגוף ונה\"ב,"
        },
        {
          "s": 20,
          "text": "לעבוד עבודתה בסור מרע"
        },
        {
          "s": 21,
          "text": "(אל תהי רשע)"
        },
        {
          "s": 22,
          "text": "ובועשה טוב"
        },
        {
          "s": 23,
          "text": "(תהי צדיק)."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה מדייק הצ\"צ34"
        },
        {
          "s": 2,
          "text": "במ\"ש משביעין אותו תהי צדיק,"
        },
        {
          "s": 3,
          "text": "איך מהני השבועה לנשמה על הגוף ונה\"ב,"
        },
        {
          "s": 4,
          "text": "שזהו דבר שאינו ברשותה,"
        },
        {
          "s": 5,
          "text": "והלא אין אדם מקנה דבר שאינו ברשותו."
        },
        {
          "s": 6,
          "text": "ומבאר,"
        },
        {
          "s": 7,
          "text": "דזה שמשביעין אותו תהי צדיק למדו רז\"ל ממ\"ש35"
        },
        {
          "s": 8,
          "text": "כי לי תכרע כל ברך תשבע כל לשון,"
        },
        {
          "s": 9,
          "text": "כי לי תכרע כל ברך זה יום המיתה,"
        },
        {
          "s": 10,
          "text": "תשבע כל לשון זה יום הלידה."
        },
        {
          "s": 11,
          "text": "והתחלת כתוב זה הוא בי נשבעתי,"
        },
        {
          "s": 12,
          "text": "דבי קאי על עתיק36"
        },
        {
          "s": 13,
          "text": "(כנ\"ל)."
        },
        {
          "s": 14,
          "text": "וזה שתשבע כל לשון בא בהמשך לבי נשבעתי,"
        },
        {
          "s": 15,
          "text": "הוא,"
        },
        {
          "s": 16,
          "text": "כי בהשבועה שמשביעין אותו תהי צדיק נמשך כח מבחינת בי נשבעתי."
        },
        {
          "s": 17,
          "text": "ובכח זה,"
        },
        {
          "s": 18,
          "text": "ביכולת הנשמה לשלוט על נה\"ב37."
        },
        {
          "s": 19,
          "text": "ויש לומר,"
        },
        {
          "s": 20,
          "text": "דהביאור איך מהני השבועה לנשמה על הגוף ונה\"ב שזה דבר שאינו ברשותה,"
        },
        {
          "s": 21,
          "text": "הוא,"
        },
        {
          "s": 22,
          "text": "כי מצד הדרגא דבי נשבעתי,"
        },
        {
          "s": 23,
          "text": "גם הגוף ונה\"ב הם ברשות הנשמה."
        },
        {
          "s": 24,
          "text": "דבבחינת הגילויים,"
        },
        {
          "s": 25,
          "text": "הנשמה והגוף ונה\"ב הם שני ענינים."
        },
        {
          "s": 26,
          "text": "דשרש הנשמה הוא בתיקון ושרש הגוף ונה\"ב הוא בתוהו."
        },
        {
          "s": 27,
          "text": "אבל באוא\"ס שלמעלה מתוהו ותיקון,"
        },
        {
          "s": 28,
          "text": "מכיון שהכוונה מלכתחילה בבנין וסתירת התוהו היתה שיהי' בירור התוהו"
        },
        {
          "s": 29,
          "text": "(שרש הגוף ונה\"ב)"
        },
        {
          "s": 30,
          "text": "ע\"י התיקון"
        },
        {
          "s": 31,
          "text": "(שרש נה\"א)38,"
        },
        {
          "s": 32,
          "text": "לכן ע\"י גילוי אוא\"ס,"
        },
        {
          "s": 33,
          "text": "גם הגוף ונה\"ב נעשים ברשותה של הנשמה,"
        },
        {
          "s": 34,
          "text": "כי כוונת התהוותם מלכתחילה היא שיתבררו ע\"י הנשמה."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "שהחילוק בין שני הענינים דמשביעין אותו,"
        },
        {
          "s": 3,
          "text": "משביעין מלשון שבועה ומשביעין מלשון שובע,"
        },
        {
          "s": 4,
          "text": "הוא,"
        },
        {
          "s": 5,
          "text": "שמשביעין מלשון שבועה הוא המשכת שרש הנשמה,"
        },
        {
          "s": 6,
          "text": "ומשביעין מלשון שובע הוא שהמשכה זו תהי' בגילוי בהנשמה כמו שבאה בהמשכה"
        },
        {
          "s": 7,
          "text": "(כולל הנשמה כמו שהיא מלובשת בגוף ונה\"ב),"
        },
        {
          "s": 8,
          "text": "בדוגמת שביעה כפשוטה,"
        },
        {
          "s": 9,
          "text": "שהמאכל משביע את האדם."
        },
        {
          "s": 10,
          "text": "וזהו דמשביעין אותו מלשון שובע הוא נתינת כח"
        },
        {
          "s": 11,
          "text": "(כמבואר בכ\"מ39),"
        },
        {
          "s": 12,
          "text": "דע\"י שההמשכה דהשבועה היא בגילוי בהנשמה שבהגוף,"
        },
        {
          "s": 13,
          "text": "יש לה הכח להתגבר על נפש הבהמית"
        },
        {
          "s": 14,
          "text": "(כנ\"ל סעיף ד),"
        },
        {
          "s": 15,
          "text": "וגם לפעול בו הבירור והזיכוך"
        },
        {
          "s": 16,
          "text": "(כנ\"ל סעיף ה),"
        },
        {
          "s": 17,
          "text": "שבשביל זה ירדה למטה."
        },
        {
          "s": 18,
          "text": "וכמבואר בתניא40,"
        },
        {
          "s": 19,
          "text": "דתכלית הכוונה בירידת הנשמה למטה הוא"
        },
        {
          "s": 20,
          "text": "(לא בשביל הנשמה,"
        },
        {
          "s": 21,
          "text": "אלא)"
        },
        {
          "s": 22,
          "text": "בכדי לברר ולזכך את הגוף ונה\"ב וחלקו בעולם."
        }
      ]
    }
  ]
}