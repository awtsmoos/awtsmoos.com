{
  "globalIndex": 538,
  "owner": 38,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916846_theRebbe_939__p009",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916846_theRebbe_939__p009",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916846_theRebbe_939",
  "title": "מאמר באתי לגני תשל\"א",
  "part": 9,
  "sections": [
    {
      "v": 24,
      "items": [
        {
          "s": 0,
          "text": "ויש להוסיף100,"
        },
        {
          "s": 1,
          "text": "דמזה שכתיב ועבדתם את הוי'"
        },
        {
          "s": 2,
          "text": "(אלקיכם)"
        },
        {
          "s": 3,
          "text": "מובן שהעבודה"
        },
        {
          "s": 4,
          "text": "(השירות)"
        },
        {
          "s": 5,
          "text": "היא לא רק לשם אלקים,"
        },
        {
          "s": 6,
          "text": "אור הממלא101,"
        },
        {
          "s": 7,
          "text": "אלא גם להוי',"
        },
        {
          "s": 8,
          "text": "אור הסובב101."
        },
        {
          "s": 9,
          "text": "ולהוסיף,"
        },
        {
          "s": 10,
          "text": "דע\"פ מ\"ש הרמב\"ן102"
        },
        {
          "s": 11,
          "text": "שהתורה נכתבה בסגנון דשלישי המדבר"
        },
        {
          "s": 12,
          "text": "[כמו וידבר הוי' אל משה103],"
        },
        {
          "s": 13,
          "text": "וידוע דשלישי המדבר הוא עצמות אוא\"ס שלמעלה גם מהוי',"
        },
        {
          "s": 14,
          "text": "יש לומר,"
        },
        {
          "s": 15,
          "text": "דזה שהמצוה ועבדתם את הוי' הוא שלישי המדבר הוא מפני שענין העבודה נוגע גם לעצמות אוא\"ס."
        },
        {
          "s": 16,
          "text": "ועפ\"ז פירוש ועבדתם את הוי' אלקיכם הוא,"
        },
        {
          "s": 17,
          "text": "שע\"י ועבדתם,"
        },
        {
          "s": 18,
          "text": "אתכפיא,"
        },
        {
          "s": 19,
          "text": "נמשך גילוי הוי',"
        },
        {
          "s": 20,
          "text": "אור הסובב."
        },
        {
          "s": 21,
          "text": "והמשכת הגילוי דהוי' היא בפנימיות,"
        },
        {
          "s": 22,
          "text": "ועד שהוי' הוא אלקיכם,"
        },
        {
          "s": 23,
          "text": "כחכם וחיותכם104,"
        },
        {
          "s": 24,
          "text": "יחוד סובב וממלא."
        },
        {
          "s": 25,
          "text": "ועי\"ז נמשך גם הגילוי דעצמות אוא\"ס"
        },
        {
          "s": 26,
          "text": "(שלישי המדבר)"
        },
        {
          "s": 27,
          "text": "שלמעלה גם מהוי'"
        },
        {
          "s": 28,
          "text": "(סובב)."
        },
        {
          "s": 29,
          "text": "ויש לומר,"
        },
        {
          "s": 30,
          "text": "דהוי' שהוא בגדר גילוי אלא שהוא למעלה מעולם105"
        },
        {
          "s": 31,
          "text": "הוא בכללות האור שלפני הצמצום שהאיר בגילוי,"
        },
        {
          "s": 32,
          "text": "ושלישי המדבר שלמעלה מהוי' הוא"
        },
        {
          "s": 33,
          "text": "(בכללות)"
        },
        {
          "s": 34,
          "text": "עצם האור שגם לפני הצמצום לא הי' בגילוי."
        }
      ]
    },
    {
      "v": 25,
      "items": [
        {
          "s": 0,
          "text": "וביאור הענין"
        },
        {
          "s": 1,
          "text": "(שע\"י העבודה דאתכפיא,"
        },
        {
          "s": 2,
          "text": "שינוי הרגילות והטבע,"
        },
        {
          "s": 3,
          "text": "נמשך הגילוי דהוי' וגם הגילוי דבחינת שלישי המדבר)"
        },
        {
          "s": 4,
          "text": "יש לומר ע\"פ מ\"ש בתורת הה\"מ הנ\"ל בפירוש הכתוב89"
        },
        {
          "s": 5,
          "text": "(ועל דמות הכסא דמות)"
        },
        {
          "s": 6,
          "text": "כמראה אדם,"
        },
        {
          "s": 7,
          "text": "שהקב\"ה הוא כמו מראה אדם,"
        },
        {
          "s": 8,
          "text": "כמו שנתעורר בו"
        },
        {
          "s": 9,
          "text": "(בהאדם)"
        },
        {
          "s": 10,
          "text": "כן נתעורר אצלו ית'"
        },
        {
          "s": 11,
          "text": "[וכמ\"ש106"
        },
        {
          "s": 12,
          "text": "ה' צלך,"
        },
        {
          "s": 13,
          "text": "שה' הוא כמו הצל שלך107]."
        },
        {
          "s": 14,
          "text": "ולכן,"
        },
        {
          "s": 15,
          "text": "ע\"י שהאדם כופה את עצמו לעשות כנגד רצונו וטבעו,"
        },
        {
          "s": 16,
          "text": "המשכת הגילויים דלמעלה היא לא כפי הטבע שלהם."
        },
        {
          "s": 17,
          "text": "שגם האור שהגילוי שלו מצד \"טבעו\" הוא לפני הצמצום"
        },
        {
          "s": 18,
          "text": "(למעלה מעולמות),"
        },
        {
          "s": 19,
          "text": "מאיר בעולם,"
        },
        {
          "s": 20,
          "text": "ויתירה מזו,"
        },
        {
          "s": 21,
          "text": "שגם האור שמצד \"טבעו\" הוא למעלה מגילוי"
        },
        {
          "s": 22,
          "text": "(גם מגילוי לפני הצמצום)"
        },
        {
          "s": 23,
          "text": "נמשך בגילוי בעולם."
        }
      ]
    },
    {
      "v": 26,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "והנה ענין הנ\"ל הוא ביאור על זה שהגילויים נמשכים בעולם."
        },
        {
          "s": 3,
          "text": "אבל צריך להבין איך יכול העולם לקבל גילויים נעלים שלמעלה ממנו באין ערוך ולא יתבטל ממציאותו."
        },
        {
          "s": 4,
          "text": "וביותר אינו מובן,"
        },
        {
          "s": 5,
          "text": "דמציאות העולמות וגילוי האור שלפני הצמצום"
        },
        {
          "s": 6,
          "text": "(גם גילוי האור שהי' ממלא מקום החלל)"
        },
        {
          "s": 7,
          "text": "הם שני הפכים,"
        },
        {
          "s": 8,
          "text": "כמובן מזה שההתהוות דמציאות העולמות היא דוקא מסילוק האור,"
        },
        {
          "s": 9,
          "text": "ואיך יכולים הם לקבל גילוי האור שקודם הצמצום."
        }
      ]
    }
  ]
}