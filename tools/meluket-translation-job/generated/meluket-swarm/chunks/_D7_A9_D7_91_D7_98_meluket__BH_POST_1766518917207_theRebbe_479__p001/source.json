{
  "globalIndex": 600,
  "owner": 0,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917207_theRebbe_479__p001",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917207_theRebbe_479__p001",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518917207_theRebbe_479",
  "title": "מאמר ואלה המשפטים תשמ\"א",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ משפטים,"
        },
        {
          "s": 2,
          "text": "מבה\"ח אדר ראשון ה'תשמ\"א*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "ואלה המשפטים אשר תשים לפניהם כי תקנה עבד עברי גו'1,"
        },
        {
          "s": 1,
          "text": "וידוע הדיוק בזה2,"
        },
        {
          "s": 2,
          "text": "דלפניהם הוא לשון רבים ולשון נסתר ותקנה הוא לשון יחיד ולשון נוכח."
        },
        {
          "s": 3,
          "text": "גם צריך להבין מה דאיתא בירושלמי3"
        },
        {
          "s": 4,
          "text": "עה\"פ ואלה המשפטים אשר תשים לפניהם,"
        },
        {
          "s": 5,
          "text": "דתשים הוא מלשון סימה"
        },
        {
          "s": 6,
          "text": "(אוצר)"
        },
        {
          "s": 7,
          "text": "שאינה נגלית כו',"
        },
        {
          "s": 8,
          "text": "רזי תורה."
        },
        {
          "s": 9,
          "text": "וצריך להבין,"
        },
        {
          "s": 10,
          "text": "הרי משפטים הם הדינים שמובנים גם בשכל אנושי4"
        },
        {
          "s": 11,
          "text": "[ואפילו בשכל דאומות העולם5],"
        },
        {
          "s": 12,
          "text": "ומהי השייכות דמשפטים לתשים מלשון סימה,"
        },
        {
          "s": 13,
          "text": "רזי תורה."
        },
        {
          "s": 14,
          "text": "גם צריך להבין6"
        },
        {
          "s": 15,
          "text": "מה שמתחיל המשפטים בדין עבד עברי7."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה מבואר באוה\"ת8,"
        },
        {
          "s": 2,
          "text": "דענין עבד עברי ברוחניות הוא,"
        },
        {
          "s": 3,
          "text": "שעבודתו את השם היא בדרך קבלת עול,"
        },
        {
          "s": 4,
          "text": "עבודת עבד."
        },
        {
          "s": 5,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 6,
          "text": "דזה שהתחלת המשפטים הוא בדין עבד עברי,"
        },
        {
          "s": 7,
          "text": "הוא לרמז,"
        },
        {
          "s": 8,
          "text": "שגם קיום המצוות דמשפטים,"
        },
        {
          "s": 9,
          "text": "שהם מובנים בשכל,"
        },
        {
          "s": 10,
          "text": "צריך לקיימם מצד קבלת עול,"
        },
        {
          "s": 11,
          "text": "בדרך עבודת עבד9."
        },
        {
          "s": 12,
          "text": "דהגם שמזה שמצוות אלו נקראים בתורת אמת בשם משפטים מובן שמצוות אלה צריך לקיימם גם מצד הטעם10,"
        },
        {
          "s": 13,
          "text": "מ\"מ,"
        },
        {
          "s": 14,
          "text": "עיקר קיומם צ\"ל בדרך קבלת עול,"
        },
        {
          "s": 15,
          "text": "הן מצד האדם המקיים את המצוות,"
        },
        {
          "s": 16,
          "text": "שקיום המצוות שלו צריך להיות בדרך עבודת עבד11,"
        },
        {
          "s": 17,
          "text": "וגם מצד המצוות,"
        },
        {
          "s": 18,
          "text": "כי כל המצוות"
        },
        {
          "s": 19,
          "text": "(גם המצוות דמשפטים)"
        },
        {
          "s": 20,
          "text": "עיקרם הוא שהם רצון הקב\"ה,"
        },
        {
          "s": 21,
          "text": "רצון שלמעלה מטעם,"
        },
        {
          "s": 22,
          "text": "אלא שכך גזר הקב\"ה שהרצון דמצוות אלו יתלבש גם בטעם12."
        },
        {
          "s": 23,
          "text": "ולהוסיף,"
        },
        {
          "s": 24,
          "text": "דזה שגם קיום המצוות דמשפטים צ\"ל בדרך קבלת עול,"
        },
        {
          "s": 25,
          "text": "הוא גם בענין המשפטים שבהם."
        },
        {
          "s": 26,
          "text": "היינו דזה שמצוות אלו צריך לקיימם גם מצד הטעם הוא מפני שכך הוא ציווי הקב\"ה שקיום מצוות אלו יהי' גם מצד הטעם13."
        },
        {
          "s": 27,
          "text": "ויש לומר,"
        },
        {
          "s": 28,
          "text": "דזהו שארז\"ל14"
        },
        {
          "s": 29,
          "text": "עה\"פ ואלה המשפטים,"
        },
        {
          "s": 30,
          "text": "ואלה מוסיף על הראשונים,"
        },
        {
          "s": 31,
          "text": "מה הראשונים מסיני אף אלו מסיני,"
        },
        {
          "s": 32,
          "text": "דבמתן תורה"
        },
        {
          "s": 33,
          "text": "(סיני)"
        },
        {
          "s": 34,
          "text": "נעשו ישראל עבדים להקב\"ה15,"
        },
        {
          "s": 35,
          "text": "והרמז אף אלו מסיני הוא,"
        },
        {
          "s": 36,
          "text": "שגם קיום המצוות דמשפטים,"
        },
        {
          "s": 37,
          "text": "כולל גם ענין זה שצריך לקיימם גם מצד הטעם"
        },
        {
          "s": 38,
          "text": "[אף אלו,"
        },
        {
          "s": 39,
          "text": "משפטים],"
        },
        {
          "s": 40,
          "text": "צריך להיות בדרך עבודת עבד."
        },
        {
          "s": 41,
          "text": "ולכן התחלת המשפטים הוא בדין עבד עברי,"
        },
        {
          "s": 42,
          "text": "בכדי לרמז,"
        },
        {
          "s": 43,
          "text": "שגם המצוות דמשפטים,"
        },
        {
          "s": 44,
          "text": "הגישה הראשונה"
        },
        {
          "s": 45,
          "text": "(דער ערשטער צוגאַנג)"
        },
        {
          "s": 46,
          "text": "ללימודם וקיומם הוא קבלת עול,"
        },
        {
          "s": 47,
          "text": "עבודת עבד16."
        },
        {
          "s": 48,
          "text": "וביאור נוסף,"
        },
        {
          "s": 49,
          "text": "דכיון שעיקר ענין העבדות הוא בעבד כנעני"
        },
        {
          "s": 50,
          "text": "[דנוסף לזה שעבד עברי עובד רק שש שנים17"
        },
        {
          "s": 51,
          "text": "(וגם עבד נרצע יוצא ביובל18)"
        },
        {
          "s": 52,
          "text": "ובעבד כנעני כתיב19"
        },
        {
          "s": 53,
          "text": "לעולם בהם תעבודו,"
        },
        {
          "s": 54,
          "text": "השעבוד"
        },
        {
          "s": 55,
          "text": "(העבדות)"
        },
        {
          "s": 56,
          "text": "דעבד עברי"
        },
        {
          "s": 57,
          "text": "(גם בהיותו עבד)"
        },
        {
          "s": 58,
          "text": "אינו כהשעבוד"
        },
        {
          "s": 59,
          "text": "(עבדות)"
        },
        {
          "s": 60,
          "text": "דעבד כנעני20],"
        },
        {
          "s": 61,
          "text": "הרי בכדי לרמז ענין הנ\"ל"
        },
        {
          "s": 62,
          "text": "(שקיום המצוות דמשפטים צ\"ל בדרך עבודת עבד)"
        },
        {
          "s": 63,
          "text": "הי' צריך לכאורה להתחיל המשפטים בדין עבד כנעני."
        }
      ]
    }
  ]
}