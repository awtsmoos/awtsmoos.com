{
  "globalIndex": 834,
  "owner": 34,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918734_theRebbe_176__p002",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918734_theRebbe_176__p002",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918734_theRebbe_176",
  "title": "מאמר וידבר אלוקים את כל הדברים האלה תשכ\"ח",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "והנה כמו שהוא בעשרה מאמרות כפי שנמשכו בפועל ובגילוי"
        },
        {
          "s": 1,
          "text": "(בספירת המלכות19),"
        },
        {
          "s": 2,
          "text": "שהמאמר דבראשית הוא מאמר כללי שכולל כל המאמרות,"
        },
        {
          "s": 3,
          "text": "עד\"ז הוא בשרשם,"
        },
        {
          "s": 4,
          "text": "בהעשר ספירות,"
        },
        {
          "s": 5,
          "text": "שהמאמר דבראשית הוא כלל,"
        },
        {
          "s": 6,
          "text": "ויש בזה כמה דרגות20."
        },
        {
          "s": 7,
          "text": "דבתרגום ירושלמי איתא בראשית בחוכמתא21,"
        },
        {
          "s": 8,
          "text": "שהחכמה22"
        },
        {
          "s": 9,
          "text": "היא כלל שכוללת כל הספירות."
        },
        {
          "s": 10,
          "text": "ובתרגום אונקלוס איתא בראשית בקדמין,"
        },
        {
          "s": 11,
          "text": "והיינו הרצון דכתר שלמעלה מהחכמה22,"
        },
        {
          "s": 12,
          "text": "ועד למחשבה הקדומה דא\"ק שהוא הרצון הכללי על כללות ההשתלשלות,"
        },
        {
          "s": 13,
          "text": "ולמעלה יותר הרצון לברוא עולמות כמו שהוא לפני הצמצום,"
        },
        {
          "s": 14,
          "text": "שהוא בחינת כלל גם לגבי מחשבה הקדומה דא\"ק."
        },
        {
          "s": 15,
          "text": "ולפני הצמצום גופא יש ג\"כ כלל ופרט,"
        },
        {
          "s": 16,
          "text": "דלאחרי שעלה ברצונו שיער בעצמו בכח כל מה שעתיד להיות בפועל,"
        },
        {
          "s": 17,
          "text": "דהרצון וההשערה הם בחינת כלל ופרט23."
        },
        {
          "s": 18,
          "text": "ונמצא,"
        },
        {
          "s": 19,
          "text": "דכמו שההמשכה דתורה היא בבחינת כלל ופרט בכו\"כ דרגות,"
        },
        {
          "s": 20,
          "text": "כנ\"ל,"
        },
        {
          "s": 21,
          "text": "עד\"ז הוא בההמשכה דעולמות שהיא בבחינת כלל ופרט בכו\"כ דרגות."
        },
        {
          "s": 22,
          "text": "וגם בזה צריך להבין,"
        },
        {
          "s": 23,
          "text": "הרי הכוונה בבריאת העולמות היא שיהיו נבראים פרטיים בהתחלקות,"
        },
        {
          "s": 24,
          "text": "וכוונה זו היא הסיבה להתעוררות הרצון לפני הצמצום בכדי שימשך ממנו אח\"כ"
        },
        {
          "s": 25,
          "text": "(ע\"י ריבוי השתלשלות)"
        },
        {
          "s": 26,
          "text": "עשרה מאמרות פרטיים שמהם יתהוו נבראים פרטיים,"
        },
        {
          "s": 27,
          "text": "וא\"כ הי' צריך להיות לכאורה התעוררות הרצון מלכתחילה בבחינת פרט באופן שיהי' אפשר להיות ממנו התהוות נבראים פרטיים כפי הכוונה,"
        },
        {
          "s": 28,
          "text": "ולמה הי' התעוררות הרצון בתחילה בבחינת כלל."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ויובן זה ע\"פ משל דהשפעת שכל מרב לתלמיד,"
        },
        {
          "s": 2,
          "text": "דאמרו חז\"ל24"
        },
        {
          "s": 3,
          "text": "לעולם ישנה אדם לתלמידו בדרך קצרה,"
        },
        {
          "s": 4,
          "text": "וידוע25"
        },
        {
          "s": 5,
          "text": "הדיוק בהלשון דרך קצרה"
        },
        {
          "s": 6,
          "text": "(ולא שכל קצר),"
        },
        {
          "s": 7,
          "text": "שצריך להשפיע להתלמיד כל העומק והפרטים שבהשכל,"
        },
        {
          "s": 8,
          "text": "אלא שכל זה צריך ללמדו בדרך קצרה,"
        },
        {
          "s": 9,
          "text": "בדיבורים קצרים,"
        },
        {
          "s": 10,
          "text": "שמהם יוכל התלמיד להבין כל הפרטים."
        },
        {
          "s": 11,
          "text": "וכמו המשנה ששנה לנו רבינו הקדוש,"
        },
        {
          "s": 12,
          "text": "שבלשון המשנה ישנם"
        },
        {
          "s": 13,
          "text": "(בהעלם)"
        },
        {
          "s": 14,
          "text": "כל הפרטים,"
        },
        {
          "s": 15,
          "text": "האורך הרוחב והעומק,"
        },
        {
          "s": 16,
          "text": "שנתבאר אח\"כ בגמרא,"
        },
        {
          "s": 17,
          "text": "אלא שבמשנה הם בקיצור נמרץ26."
        },
        {
          "s": 18,
          "text": "והטעם על זה"
        },
        {
          "s": 19,
          "text": "(שההשפעה צריכה להיות בדרך קצרה דוקא)"
        },
        {
          "s": 20,
          "text": "הוא,"
        },
        {
          "s": 21,
          "text": "כי באם ישפיע לו"
        },
        {
          "s": 22,
          "text": "(בתחילה)"
        },
        {
          "s": 23,
          "text": "כל הפרטים בגילוי,"
        },
        {
          "s": 24,
          "text": "יתבלבלו חושי התלמיד,"
        },
        {
          "s": 25,
          "text": "וגם אפשר שמצד ריבוי ההתפשטות ילך בדרך עקלתון,"
        },
        {
          "s": 26,
          "text": "ולכן צריך ללמדו בדרך קצרה דוקא,"
        },
        {
          "s": 27,
          "text": "שעי\"ז בא השכל בציור מוגבל"
        },
        {
          "s": 28,
          "text": "(שהוא יודע את הענין בכללותו),"
        },
        {
          "s": 29,
          "text": "ועי\"ז,"
        },
        {
          "s": 30,
          "text": "הנה גם לאחרי שמעיין בהפרטים,"
        },
        {
          "s": 31,
          "text": "בריבוי סברות,"
        },
        {
          "s": 32,
          "text": "תהי' ההתפשטות לפי אופן הציור של הדיבורים הקצרים ולא ילך בדרך עקלתון."
        },
        {
          "s": 33,
          "text": "וכמו שהוא בההשפעה להתלמיד בפועל,"
        },
        {
          "s": 34,
          "text": "דתחילת ההשפעה צריכה להיות בדרך קצרה דוקא,"
        },
        {
          "s": 35,
          "text": "עד\"ז הוא גם בהמצאת השכל השייך להתלמיד בהרב עצמו,"
        },
        {
          "s": 36,
          "text": "דתחילת המשכת"
        },
        {
          "s": 37,
          "text": "(והמצאת)"
        },
        {
          "s": 38,
          "text": "השכל היא בבחינת נקודה."
        },
        {
          "s": 39,
          "text": "דהנה ידוע27"
        },
        {
          "s": 40,
          "text": "שבשכל הרב כלול גם חיצוניות השכל ששייך להתלמיד,"
        },
        {
          "s": 41,
          "text": "אלא,"
        },
        {
          "s": 42,
          "text": "שבהיותו כלול בשכל הרב,"
        },
        {
          "s": 43,
          "text": "הנה נוסף לזה שאינו ניכר שם בפ\"ע"
        },
        {
          "s": 44,
          "text": "(להיותו כלול ומעורב עם הפנימיות),"
        },
        {
          "s": 45,
          "text": "הנה גם חיצוניות השכל"
        },
        {
          "s": 46,
          "text": "(השייך להתלמיד)"
        },
        {
          "s": 47,
          "text": "הוא בריבוי אור,"
        },
        {
          "s": 48,
          "text": "ולכן צריך הרב לצמצם את שכלו,"
        },
        {
          "s": 49,
          "text": "היינו להעלים את שכלו העצמי שלא יאיר כלל,"
        },
        {
          "s": 50,
          "text": "שעי\"ז נבדל החיצוניות מהפנימיות וניכר בפ\"ע,"
        },
        {
          "s": 51,
          "text": "וגם החיצוניות שנמצא אצלו אז הוא בבחינת נקודה בלבד,"
        },
        {
          "s": 52,
          "text": "ורק לאחרי זה"
        },
        {
          "s": 53,
          "text": "(לפני שמשפיע בפועל)"
        },
        {
          "s": 54,
          "text": "הוא משער בעצמו את הפרטים שישפיע אל המקבל."
        },
        {
          "s": 55,
          "text": "והטעם על זה שבתחילה בא השכל בבחינת נקודה הוא,"
        },
        {
          "s": 56,
          "text": "כי באם השכל ששייך להתלמיד הי' נמצא מלכתחילה באופן דהתפשטות בריבוי פרטים,"
        },
        {
          "s": 57,
          "text": "יהיו אז הפרטים באופן כמו שהם נובעים משכל הרב,"
        },
        {
          "s": 58,
          "text": "בריבוי אור,"
        },
        {
          "s": 59,
          "text": "ולא יהיו מכוונים ומתאימים לחושי התלמיד."
        },
        {
          "s": 60,
          "text": "ולכן,"
        },
        {
          "s": 61,
          "text": "המצאת השכל בתחילה הוא בבחינת נקודה"
        },
        {
          "s": 62,
          "text": "(ענין של התעלמות),"
        },
        {
          "s": 63,
          "text": "שעי\"ז נגבל השכל."
        },
        {
          "s": 64,
          "text": "דעם היות שבהנקודה כלולים כל הפרטים שישפיע אח\"כ להתלמיד"
        },
        {
          "s": 65,
          "text": "[ויתירה מזו,"
        },
        {
          "s": 66,
          "text": "שיש בהנקודה בהעלם גם מפנימיות השכל28],"
        },
        {
          "s": 67,
          "text": "מ\"מ,"
        },
        {
          "s": 68,
          "text": "מכיון שכל זה הוא בהעלם,"
        },
        {
          "s": 69,
          "text": "הנה עי\"ז נעשה הגבלה וציור"
        },
        {
          "s": 70,
          "text": "(כללית)"
        },
        {
          "s": 71,
          "text": "בהשכל שיהי' באופן ששייך להשפיע אותו להתלמיד,"
        },
        {
          "s": 72,
          "text": "ולאחרי שנעשה בו הגבלה זו,"
        },
        {
          "s": 73,
          "text": "הנה גם לאחרי שנמשך ברוחב והתפשטות"
        },
        {
          "s": 74,
          "text": "(כשמפרט את הפרטים),"
        },
        {
          "s": 75,
          "text": "יהי' הרוחב כפי אופן ההגבלה והציור של הנקודה."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנמשל מזה יובן למעלה,"
        },
        {
          "s": 2,
          "text": "דבכדי שהאור שמהווה את העולמות יהי' לפי ערך הנבראים,"
        },
        {
          "s": 3,
          "text": "באופן שיוכל להאיר בהם בפנימיות,"
        },
        {
          "s": 4,
          "text": "הוצרך להיות תחילה ההמשכה באופן דכלל ופרט."
        },
        {
          "s": 5,
          "text": "כי מכיון שהעולמות הם באין ערוך לגבי אוא\"ס,"
        },
        {
          "s": 6,
          "text": "לכן,"
        },
        {
          "s": 7,
          "text": "באם ההמשכה מאוא\"ס היתה מלכתחילה בריבוי פרטים,"
        },
        {
          "s": 8,
          "text": "היו אז הפרטים בבלי גבול"
        },
        {
          "s": 9,
          "text": "(כמו שהם מצד אוא\"ס),"
        },
        {
          "s": 10,
          "text": "ולכן הוצרך להיות תחילה ההמשכה באופן דכלל,"
        },
        {
          "s": 11,
          "text": "שעי\"ז נעשה ציור כללי בהאור שיהי' לפי ערך העולמות,"
        },
        {
          "s": 12,
          "text": "ועי\"ז,"
        },
        {
          "s": 13,
          "text": "גם הפרטים שנמשכו אח\"כ הם לפי ציור זה."
        }
      ]
    }
  ]
}