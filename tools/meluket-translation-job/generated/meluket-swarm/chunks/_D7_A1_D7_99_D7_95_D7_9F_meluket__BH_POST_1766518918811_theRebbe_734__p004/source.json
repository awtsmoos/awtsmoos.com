{
  "globalIndex": 853,
  "owner": 3,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918811_theRebbe_734__p004",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918811_theRebbe_734__p004",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918811_theRebbe_734",
  "title": "מאמר ביום השני הקריב תשל\"ב",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ויש לקשר ביאור זה"
        },
        {
          "s": 2,
          "text": "[דזה שיהודה הקריב הראשון הוא מצד מעלת המעשה]"
        },
        {
          "s": 3,
          "text": "עם הביאור"
        },
        {
          "s": 4,
          "text": "(הובא לעיל סעיף ב)"
        },
        {
          "s": 5,
          "text": "דזה שיהודה הקריב ראשון הוא כי יהודה הוא בחינת ביטול,"
        },
        {
          "s": 6,
          "text": "כי ענין הביטול הוא במעשה."
        },
        {
          "s": 7,
          "text": "דהכחות שלמעלה ממעשה,"
        },
        {
          "s": 8,
          "text": "כיון שענינם הוא מעלה ושלימות,"
        },
        {
          "s": 9,
          "text": "וכנ\"ל"
        },
        {
          "s": 10,
          "text": "(סעיף ה)"
        },
        {
          "s": 11,
          "text": "שהתחלת מעלת האדם הוא כח הדיבור שבו,"
        },
        {
          "s": 12,
          "text": "הביטול שלהם להנפש אינו ביטול בתכלית,"
        },
        {
          "s": 13,
          "text": "ודוקא כח המעשה שאינו ממעלת האדם,"
        },
        {
          "s": 14,
          "text": "הביטול שלו להנפש הוא ביטול בתכלית36"
        },
        {
          "s": 15,
          "text": "[ובמעשה עצמו,"
        },
        {
          "s": 16,
          "text": "עיקר הביטול הוא בהדרגא דמעשה כמו שהוא מובדל מהכחות שלמעלה ממנו."
        },
        {
          "s": 17,
          "text": "דבדרגת המעשה שבו מתלבשים הכחות שלמעלה ממנו,"
        },
        {
          "s": 18,
          "text": "יש בו העילוי שעל ידו נתגלה הבל\"ג דהנפש,"
        },
        {
          "s": 19,
          "text": "ולכן הוא \"מציאות\"."
        },
        {
          "s": 20,
          "text": "ועיקר הביטול הוא בהמעשה עצמו"
        },
        {
          "s": 21,
          "text": "(שנבדל מהכחות שלמעלה ממנו),"
        },
        {
          "s": 22,
          "text": "דכיון שאין בו עילוי,"
        },
        {
          "s": 23,
          "text": "לכן נרגש בו שכל מציאותו הוא רק מצד הנפש]."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ויש לקשר זה עם זה ששורש המעשה הוא בעצם הנפש,"
        },
        {
          "s": 1,
          "text": "דבעצם הנפש אין נתינת מקום למציאות שמחוץ להנפש."
        },
        {
          "s": 2,
          "text": "ומזה מובן,"
        },
        {
          "s": 3,
          "text": "דזה ששורש המעשה הוא בעצם הנפש הוא לפי שכל מציאותו היא רק מצד עצם הנפש37."
        },
        {
          "s": 4,
          "text": "ועד\"ז הוא למעלה"
        },
        {
          "s": 5,
          "text": "(בהחילוק בין תורה ומצוות),"
        },
        {
          "s": 6,
          "text": "דזה שהרצון דמצוות הוא במעשה המצוות"
        },
        {
          "s": 7,
          "text": "(ובדברים גשמיים),"
        },
        {
          "s": 8,
          "text": "אף שהמעשה אין לו ערך,"
        },
        {
          "s": 9,
          "text": "הוא לפי ששורש המצוות הוא בהעצמות38,"
        },
        {
          "s": 10,
          "text": "ולכן,"
        },
        {
          "s": 11,
          "text": "עיקר הביטול הוא במעשה המצוות."
        },
        {
          "s": 12,
          "text": "ויש לומר,"
        },
        {
          "s": 13,
          "text": "שגם הרצון בכוונת המצוות,"
        },
        {
          "s": 14,
          "text": "הוא לא מצד המעלה שבכוונת המצוות אלא מפני שכן עלה ברצונו ית'."
        },
        {
          "s": 15,
          "text": "אלא שגילוי ענין זה הוא במעשה המצוות,"
        },
        {
          "s": 16,
          "text": "ועי\"ז מתגלה שכן הוא גם בכוונת המצוות."
        },
        {
          "s": 17,
          "text": "ועד\"ז הוא בתורה,"
        },
        {
          "s": 18,
          "text": "דהגם שהתורה היא חכמה"
        },
        {
          "s": 19,
          "text": "[וגם למעלה,"
        },
        {
          "s": 20,
          "text": "התורה היא חכמתו של הקב\"ה],"
        },
        {
          "s": 21,
          "text": "זה שאורייתא וקוב\"ה כולא חד הוא לא מצד מעלת התורה אלא לפי שכן עלה ברצונו ית'."
        },
        {
          "s": 22,
          "text": "אלא שגילוי ענין זה הוא במצוות וע\"י המצוות מתגלה שכן הוא גם בתורה."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וזהו ביום השני הקריב נתנאל בן צוער לשון מצער,"
        },
        {
          "s": 2,
          "text": "דלאחרי הביטול דיהודה בענין המצוות המשיך נתנאל בן צוער ביטול זה גם בעסק התורה."
        },
        {
          "s": 3,
          "text": "ולכן העלה עליו הכתוב כאילו הוא הקריב תחלה"
        },
        {
          "s": 4,
          "text": "[אף שיהודה הוא למעלה מיששכר,"
        },
        {
          "s": 5,
          "text": "וכנ\"ל"
        },
        {
          "s": 6,
          "text": "(סעיף ב)"
        },
        {
          "s": 7,
          "text": "שיהודה הוא בכתר ויששכר הוא בחכמה],"
        },
        {
          "s": 8,
          "text": "דענין הקריב תחלה הוא שהמשיך הביטול דכתר"
        },
        {
          "s": 9,
          "text": "(בחינת תחלה)"
        },
        {
          "s": 10,
          "text": "בחכמה."
        },
        {
          "s": 11,
          "text": "ויש לומר דבהלשון כאילו הקריב תחלה"
        },
        {
          "s": 12,
          "text": "(ולא כאילו הקריב ביום הראשון)"
        },
        {
          "s": 13,
          "text": "מרומז גם הביטול שמצד בחינת תחלה – תחלה שלפני תחלת המחשבה,"
        },
        {
          "s": 14,
          "text": "שבו עלה סוף מעשה"
        },
        {
          "s": 15,
          "text": "(מעשה המצוות)"
        },
        {
          "s": 16,
          "text": "ונתנאל המשיך ביטול זה גם בתורה"
        },
        {
          "s": 17,
          "text": "[גם יש לומר דפירוש כאילו הקריב תחלה הוא תחלה לפני יהודה."
        },
        {
          "s": 18,
          "text": "כי המשכת הביטול בתורה הוא חידוש גדול יותר ובמילא נעלה יותר מהביטול שבמעשה המצוות]."
        },
        {
          "s": 19,
          "text": "וע\"י הביטול דצוער שהי' בו נעשה נתנאל39,"
        },
        {
          "s": 20,
          "text": "אותיות נתן א-ל,"
        },
        {
          "s": 21,
          "text": "שניתנה לו התורה במתנה."
        }
      ]
    }
  ]
}