{
  "globalIndex": 294,
  "owner": 44,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915462_theRebbe_206__p001",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915462_theRebbe_206__p001",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915462_theRebbe_206",
  "title": "מאמר א\"ר אושעיא תשל\"ט",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "י\"ט כסלו ה'תשל\"ט*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "אמר ר' אושעיא מאי דכתיב1"
        },
        {
          "s": 1,
          "text": "צדקת פרזונו בישראל גו' צדקה עשה הקב\"ה בישראל שפיזרן לבין האומות2,"
        },
        {
          "s": 2,
          "text": "ומבאר כ\"ק מו\"ח אדמו\"ר במאמרו ד\"ה זה"
        },
        {
          "s": 3,
          "text": "[שנאמר בי\"ט כסלו3"
        },
        {
          "s": 4,
          "text": "תרפ\"ט בסעודה,"
        },
        {
          "s": 5,
          "text": "ונדפס בקונטרס דרושי חתונה תרפ\"ט4],"
        },
        {
          "s": 6,
          "text": "דע\"י שישראל מפוזרים בכמה מדינות,"
        },
        {
          "s": 7,
          "text": "הנה גם כשבמדינה אחת דוחקים ולוחצים את בנ\"י ואין נותנים להם ללמוד תורה ולקיים מצוות,"
        },
        {
          "s": 8,
          "text": "ועד שבכמה מצוות הם אנוסים ממש5"
        },
        {
          "s": 9,
          "text": "שאין להם אפשרות כלל לקיים אותם אפילו ע\"י מס\"נ6"
        },
        {
          "s": 10,
          "text": "[ולדוגמא,"
        },
        {
          "s": 11,
          "text": "כשיש גזירת המלכות שלא להכניס להמדינה ד' מינים,"
        },
        {
          "s": 12,
          "text": "שאז גם ע\"י מס\"נ א\"א לקיים המצוה],"
        },
        {
          "s": 13,
          "text": "הנה ע\"י שישראל הנמצאים בשאר המדינות עוסקים בתומ\"צ,"
        },
        {
          "s": 14,
          "text": "הם נותנים כח ועוז גם לאלו הנמצאים בהמקום שיש שם גזירות,"
        },
        {
          "s": 15,
          "text": "שיוכלו ללמוד תורה ולקיים מצוות."
        },
        {
          "s": 16,
          "text": "ומן הקל אל הכבד,"
        },
        {
          "s": 17,
          "text": "בתחלה שיוכלו לקיים את המצוות ע\"י מס\"נ עכ\"פ"
        },
        {
          "s": 18,
          "text": "[וכידוע שיש דעה בפוסקים7"
        },
        {
          "s": 19,
          "text": "שגם בהמצוות שעליהם אמרו יעבור ואל יהרג רשאי לקדש את השם ולמסור עצמו],"
        },
        {
          "s": 20,
          "text": "ועד שאח\"כ לא יצטרכו למס\"נ כלל8,"
        },
        {
          "s": 21,
          "text": "ועד שלא יהי' להם נסיונות ואפילו לא מניעות ועיכובים,"
        },
        {
          "s": 22,
          "text": "כי יצאו לחירות ויוכלו לעסוק בתומ\"צ מתוך הרחבה,"
        },
        {
          "s": 23,
          "text": "כמארז\"ל9"
        },
        {
          "s": 24,
          "text": "כל המקיים את התורה מעוני סופו לקיימה מעושר."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה כיון שהתורה היא נצחית בכל עת וזמן ובכל מקום"
        },
        {
          "s": 2,
          "text": "(כמבואר בהמאמר10),"
        },
        {
          "s": 3,
          "text": "מובן שצדקה זו היא גם בהמקומות שאין שם גזירות על תומ\"צ."
        },
        {
          "s": 4,
          "text": "ויובן זה ע\"פ מ\"ש כ\"ק מו\"ח אדמו\"ר"
        },
        {
          "s": 5,
          "text": "(בדרושי חתונה הנ\"ל11)"
        },
        {
          "s": 6,
          "text": "בענין מצות פדיון שבויים שישנה גם ברוחניות."
        },
        {
          "s": 7,
          "text": "דכמו שהשבוי בגשמיות"
        },
        {
          "s": 8,
          "text": "(היושב במאסר)"
        },
        {
          "s": 9,
          "text": "אינו יכול לצאת משם,"
        },
        {
          "s": 10,
          "text": "עד\"ז הוא גם ברוחניות,"
        },
        {
          "s": 11,
          "text": "שלפעמים האדם שבוי רח\"ל בידי יצרו"
        },
        {
          "s": 12,
          "text": "[וע\"ד בעלי עסקים הטרודים ומוטרדים ביותר בטרדות עסקיהם,"
        },
        {
          "s": 13,
          "text": "שהם קשורים"
        },
        {
          "s": 14,
          "text": "(שבויים)"
        },
        {
          "s": 15,
          "text": "בהמחשבות המבלבלות ואינם יכולים לצאת מהם],"
        },
        {
          "s": 16,
          "text": "ועד שלפעמים הוא כמו אנוס12,"
        },
        {
          "s": 17,
          "text": "ובלשון הרמב\"ם13"
        },
        {
          "s": 18,
          "text": "(בנוגע להלכה)"
        },
        {
          "s": 19,
          "text": "יצרו הוא שתקפו."
        },
        {
          "s": 20,
          "text": "וזהו\"ע הצדקה ע\"י שפיזרן לבין האומות גם בנוגע למקומות הרווחה,"
        },
        {
          "s": 21,
          "text": "דכאשר מי שהוא מישראל שבוי בידי יצרו רח\"ל"
        },
        {
          "s": 22,
          "text": "(בנוגע לענין פרטי),"
        },
        {
          "s": 23,
          "text": "יציאתו מהשבי' היא"
        },
        {
          "s": 24,
          "text": "[לא בכח עצמו,"
        },
        {
          "s": 25,
          "text": "כיון שאין חבוש מתיר עצמו14,"
        },
        {
          "s": 26,
          "text": "כ\"א]"
        },
        {
          "s": 27,
          "text": "ע\"י יהודי שאינו נתון בשבי' בנוגע לענין זה."
        },
        {
          "s": 28,
          "text": "והיינו,"
        },
        {
          "s": 29,
          "text": "דגם כאשר גם הפודה אותו מהשבי' הוא שבוי בידי יצרו,"
        },
        {
          "s": 30,
          "text": "ועד שהוא כמו אנוס"
        },
        {
          "s": 31,
          "text": "(יצרו הוא שתקפו)"
        },
        {
          "s": 32,
          "text": "בנוגע למצוה אחרת,"
        },
        {
          "s": 33,
          "text": "מ\"מ,"
        },
        {
          "s": 34,
          "text": "כיון שבנוגע לכו\"כ מצוות אינו שבוי בידי יצרו,"
        },
        {
          "s": 35,
          "text": "כי התנגדות היצה\"ר אצל כ\"א היא"
        },
        {
          "s": 36,
          "text": "(בעיקר)"
        },
        {
          "s": 37,
          "text": "בענין אחר"
        },
        {
          "s": 38,
          "text": "[דכמו15"
        },
        {
          "s": 39,
          "text": "שבכל זמן יש עבודה מיוחדת השייכת ביותר לזמן זה,"
        },
        {
          "s": 40,
          "text": "ועיקר הפיתויים וההתנגדות של היצה\"ר הם למנוע עבודה זו16,"
        },
        {
          "s": 41,
          "text": "שלכן הנסיונות שבדור אחד שונים מהנסיונות בדורות אחרים"
        },
        {
          "s": 42,
          "text": "[וכמו בזמנו של מנשה שאז הי' שולט היצר דע\"ז17"
        },
        {
          "s": 43,
          "text": "משא\"כ בהדורות שלאחריו,"
        },
        {
          "s": 44,
          "text": "עאכו\"כ לאחר שקטלוהו ליצרא דע\"ז18],"
        },
        {
          "s": 45,
          "text": "עד\"ז הוא גם בזמן אחד גופא,"
        },
        {
          "s": 46,
          "text": "שלכל אחד מישראל יש ענין מיוחד"
        },
        {
          "s": 47,
          "text": "(מצוה או מנהג וכיו\"ב)"
        },
        {
          "s": 48,
          "text": "שנוגע אליו ביותר,"
        },
        {
          "s": 49,
          "text": "כידוע19"
        },
        {
          "s": 50,
          "text": "בביאור מארז\"ל20"
        },
        {
          "s": 51,
          "text": "אבוך במאי הוה זהיר טפי,"
        },
        {
          "s": 52,
          "text": "ועיקר הפיתויים וההתנגדות של היצה\"ר שלו הם בנוגע לענין זה],"
        },
        {
          "s": 53,
          "text": "וע\"י שמקיים את המצוות שאין יצרו לוחם כנגדם"
        },
        {
          "s": 54,
          "text": "(כ\"כ),"
        },
        {
          "s": 55,
          "text": "הוא פודה מהשבי' את זה שיצרו תקפו במצוות אלו."
        },
        {
          "s": 56,
          "text": "וזהו צדקה עשה הקב\"ה בישראל שפיזרן לבין האומות,"
        },
        {
          "s": 57,
          "text": "דפדיון שבויים הוא צדקה הכי נעלית,"
        },
        {
          "s": 58,
          "text": "וכמבואר במאמר הנ\"ל11"
        },
        {
          "s": 59,
          "text": "שבמצות צדקה פדיון שבויים הוא קודם לכל דבר ואין מצוה גדולה כפדיון שבויים21,"
        },
        {
          "s": 60,
          "text": "וע\"י שפיזרן לבין האומות,"
        },
        {
          "s": 61,
          "text": "שיצרו של אחד שונה מיצרו של השני,"
        },
        {
          "s": 62,
          "text": "עי\"ז מתקיימת הצדקה דפדיון שבויים,"
        },
        {
          "s": 63,
          "text": "כנ\"ל."
        }
      ]
    }
  ]
}