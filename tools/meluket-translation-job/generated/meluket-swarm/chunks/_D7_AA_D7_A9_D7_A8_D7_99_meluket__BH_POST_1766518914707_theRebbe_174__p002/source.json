{
  "globalIndex": 163,
  "owner": 13,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914707_theRebbe_174__p002",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914707_theRebbe_174__p002",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914707_theRebbe_174",
  "title": "מאמר להבין ענין שמח\"ת תשמ\"ב",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ונקודת הביאור בזה הוא,"
        },
        {
          "s": 2,
          "text": "דקרוב ורחוק קאי על צדיקים ובעלי תשובה."
        },
        {
          "s": 3,
          "text": "וכמ\"ש16"
        },
        {
          "s": 4,
          "text": "שלום שלום לרחוק ולקרוב,"
        },
        {
          "s": 5,
          "text": "וידוע17"
        },
        {
          "s": 6,
          "text": "דשלום לקרוב קאי על צדיקים,"
        },
        {
          "s": 7,
          "text": "ושלום לרחוק קאי על בעלי תשובה,"
        },
        {
          "s": 8,
          "text": "לרחוק שנעשה קרוב18."
        },
        {
          "s": 9,
          "text": "וע\"י התשובה,"
        },
        {
          "s": 10,
          "text": "קירוב שלאחרי הריחוק,"
        },
        {
          "s": 11,
          "text": "הנה עי\"ז דוקא ממשיכים מבחינה עליונה יותר,"
        },
        {
          "s": 12,
          "text": "בחינת רחוק"
        },
        {
          "s": 13,
          "text": "(שלמעלה מהשתלשלות),"
        },
        {
          "s": 14,
          "text": "בחינת העלם שאינו במציאות."
        },
        {
          "s": 15,
          "text": "ולכן במקום שבעלי תשובה עומדין אין צדיקים גמורין יכולין לעמוד בו19."
        },
        {
          "s": 16,
          "text": "דהגם שגם בצדיקים יש עבודת התשובה,"
        },
        {
          "s": 17,
          "text": "שהרי תשובה היא מצוה"
        },
        {
          "s": 18,
          "text": "(לכל אחד ואחת)20,"
        },
        {
          "s": 19,
          "text": "יש לומר,"
        },
        {
          "s": 20,
          "text": "דמעלת התשובה היא שתשובה היא בדרך דילוג21,"
        },
        {
          "s": 21,
          "text": "וענין זה הוא בתשובה כפשוטה."
        },
        {
          "s": 22,
          "text": "דכאשר עשיית התשובה היא מפני שמצוה לעשות תשובה,"
        },
        {
          "s": 23,
          "text": "התשובה שלו היא בסדר והדרגה,"
        },
        {
          "s": 24,
          "text": "וענין הדילוג שבתשובה הוא בעיקר בתשובה כפשוטה,"
        },
        {
          "s": 25,
          "text": "באלו שהיו תחלה במקום רחוק."
        },
        {
          "s": 26,
          "text": "והגם שגם אצל צדיקים יש הרגש הריחוק,"
        },
        {
          "s": 27,
          "text": "שהרי גם אצלם יש ההתבוננות"
        },
        {
          "s": 28,
          "text": "(ברוממות הא-ל ית' ו)"
        },
        {
          "s": 29,
          "text": "בשפלות האדם22,"
        },
        {
          "s": 30,
          "text": "הרי מובן,"
        },
        {
          "s": 31,
          "text": "דהרגש הריחוק שמצד התבוננות זו אינו בערך להרגש הריחוק דרע23"
        },
        {
          "s": 32,
          "text": "ומר עזבך את ה' אלקיך."
        },
        {
          "s": 33,
          "text": "ומכיון שהבעלי תשובה היו"
        },
        {
          "s": 34,
          "text": "(תחלה)"
        },
        {
          "s": 35,
          "text": "במקום רחוק ביותר,"
        },
        {
          "s": 36,
          "text": "למטה מטה ביותר,"
        },
        {
          "s": 37,
          "text": "לכן עבודתם היא בתוקף יותר און מיט אַ שטורעם,"
        },
        {
          "s": 38,
          "text": "בחילא יתיר24,"
        },
        {
          "s": 39,
          "text": "ועי\"ז הם מגיעים למקום נעלה ביותר."
        },
        {
          "s": 40,
          "text": "ובפרט לפי תורת האריז\"ל הידועה25,"
        },
        {
          "s": 41,
          "text": "דזה שאדם צריך לדצ\"ח הוא לפי שהניצוצות שבדצ\"ח הם נעלים יותר מהניצוצות שבמדבר,"
        },
        {
          "s": 42,
          "text": "דכל הגבוה גבוה ביותר כשהוא יורד הוא יורד למטה מטה ביותר."
        },
        {
          "s": 43,
          "text": "שמזה מובן במכ\"ש בנוגע להענינים"
        },
        {
          "s": 44,
          "text": "(עבירות)"
        },
        {
          "s": 45,
          "text": "שעליהם הוא ענין התשובה כפשוטה,"
        },
        {
          "s": 46,
          "text": "שהניצוצות שבהם הם גבוהים ביותר,"
        },
        {
          "s": 47,
          "text": "שלכן ירדו למטה מטה ביותר26."
        },
        {
          "s": 48,
          "text": "דזהו גם מהטעמים על זה שתשובה כפשוטה היא בכחות הפנימיים והנעלמים שבנפש,"
        },
        {
          "s": 49,
          "text": "עד לקלא פנימאה דלא אשתמע27,"
        },
        {
          "s": 50,
          "text": "כי בכדי לברר ולהעלות ניצוצות אלו שגבוהים ביותר ונפלו למטה ביותר,"
        },
        {
          "s": 51,
          "text": "הוא דוקא ע\"י כחות הפנימיים והנעלמים,"
        },
        {
          "s": 52,
          "text": "בחינת העלם שאינו במציאות."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וזהו משל למה הדבר דומה למלך שהיו לו בנות הרבה,"
        },
        {
          "s": 2,
          "text": "מהן נשואות במקום קרוב ומהן נשואות למקום רחוק,"
        },
        {
          "s": 3,
          "text": "בנות הן הנשמות המלובשות בגוף28."
        },
        {
          "s": 4,
          "text": "והבנות הן נשואות,"
        },
        {
          "s": 5,
          "text": "דענין ירידת הנשמות למטה להתלבש בגוף הוא בכדי לעשות לו ית' דירה בתחתונים29,"
        },
        {
          "s": 6,
          "text": "ע\"י קיום התומ\"צ,"
        },
        {
          "s": 7,
          "text": "מתחיל ממצוה הראשונה פרו ורבו ומלאו את הארץ וכבשוה30,"
        },
        {
          "s": 8,
          "text": "ענין פרו ורבו ברוחניות"
        },
        {
          "s": 9,
          "text": "(תוספת אור כו' ע\"י העבודה דתומ\"צ בכלל31),"
        },
        {
          "s": 10,
          "text": "וגם ענין פרו ורבו כפשוטו,"
        },
        {
          "s": 11,
          "text": "לשבת יצרה32,"
        },
        {
          "s": 12,
          "text": "שעי\"ז נעשה העולם דירה לו ית'."
        },
        {
          "s": 13,
          "text": "וזהו\"ע בנות נשואות,"
        },
        {
          "s": 14,
          "text": "דענין הנשואין הוא בשביל פו\"ר33"
        },
        {
          "s": 15,
          "text": "ברוחניות ובגשמיות,"
        },
        {
          "s": 16,
          "text": "שיהי' המשכת וגילוי כח הא\"ס למטה34."
        },
        {
          "s": 17,
          "text": "אלא שבזה גופא יש נשואות במקום קרוב,"
        },
        {
          "s": 18,
          "text": "והו\"ע עבודת הצדיקים העוסקים בתומ\"צ,"
        },
        {
          "s": 19,
          "text": "ויש נשואות למקום רחוק,"
        },
        {
          "s": 20,
          "text": "והו\"ע עבודת הבירורים שבדברי הרשות ובפרט עבודת התשובה28."
        },
        {
          "s": 21,
          "text": "וזהו שאומר שהנשואות במקום קרוב אית בעונתן למיזל ולמיתי משא\"כ הנשואות למקום רחוק לית בעונתן למיזל ולמיתי,"
        },
        {
          "s": 22,
          "text": "דהצדיקים,"
        },
        {
          "s": 23,
          "text": "כיון שלא ירדו למטה כ\"כ ונמצאים במקום קרוב,"
        },
        {
          "s": 24,
          "text": "לכן אין צריך בזה השתדלות מיוחדת וזריזות מיוחדת,"
        },
        {
          "s": 25,
          "text": "וזה יכול לקחת זמן"
        },
        {
          "s": 26,
          "text": "(אית בעונתן),"
        },
        {
          "s": 27,
          "text": "היינו שעבודתם היא בסדר והדרגה."
        },
        {
          "s": 28,
          "text": "משא\"כ הבעלי תשובה,"
        },
        {
          "s": 29,
          "text": "כיון שירדו למטה ביותר והיו במקום רחוק,"
        },
        {
          "s": 30,
          "text": "ועד שגם לאחרי התשובה יש חשש שיחזרו לסורם ח\"ו35,"
        },
        {
          "s": 31,
          "text": "לכן צריך בזה השתדלות וזריזות וא\"א לחכות"
        },
        {
          "s": 32,
          "text": "(לית בעונתן),"
        },
        {
          "s": 33,
          "text": "היינו שעבודתם היא בדרך דילוג דוקא למעלה מסדר והדרגה,"
        },
        {
          "s": 34,
          "text": "וגם בנוגע לזמן כפשוטו הרי עבודת התשובה היא בשעתא חדא וברגעא חדא36,"
        },
        {
          "s": 35,
          "text": "קונה עולמו בשעה אחת37."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "והגם דזה שבעלי תשובה צריכים להשתדלות וזריזות מיוחדת הוא מצד החסרון שבהם,"
        },
        {
          "s": 1,
          "text": "לפי שהיו במקום רחוק"
        },
        {
          "s": 2,
          "text": "(וא\"א לחכות,"
        },
        {
          "s": 3,
          "text": "לית בעונתן),"
        },
        {
          "s": 4,
          "text": "מ\"מ,"
        },
        {
          "s": 5,
          "text": "הנה זה גופא"
        },
        {
          "s": 6,
          "text": "(שהיו במקום רחוק)"
        },
        {
          "s": 7,
          "text": "מעורר אצלם גם ענין הריחוק למעליותא."
        },
        {
          "s": 8,
          "text": "דהצדיקים שהיו במקום קרוב,"
        },
        {
          "s": 9,
          "text": "עבודתם היא בכחות הקרובים שבנפש"
        },
        {
          "s": 10,
          "text": "(כחות הגלויים),"
        },
        {
          "s": 11,
          "text": "וגם העבודה עצמה,"
        },
        {
          "s": 12,
          "text": "העלי' שלהם בכל יום ויום"
        },
        {
          "s": 13,
          "text": "(דבכל יום ויום צריך להיות מעלין בקודש38),"
        },
        {
          "s": 14,
          "text": "היא בקירוב,"
        },
        {
          "s": 15,
          "text": "בסדר והדרגה"
        },
        {
          "s": 16,
          "text": "(היינו שכל דרגא ודרגא היא בערך וקירוב להדרגא שהיו בה תחלה),"
        },
        {
          "s": 17,
          "text": "וגם המקום"
        },
        {
          "s": 18,
          "text": "(הבחינה שלמעלה)"
        },
        {
          "s": 19,
          "text": "שמגיעים לשם ע\"י עבודתם הוא בחינת מקום קרוב,"
        },
        {
          "s": 20,
          "text": "העלם שישנו במציאות."
        },
        {
          "s": 21,
          "text": "משא\"כ הבעלי תשובה שהיו במקום רחוק,"
        },
        {
          "s": 22,
          "text": "עבודתם היא בכחות הרחוקים והנעלמים שבנפש עד לכחות העצמיים,"
        },
        {
          "s": 23,
          "text": "כי זה שהיו תחלה במקום רחוק,"
        },
        {
          "s": 24,
          "text": "הנה ריחוק זה מעורר את הכחות הרחוקים שבנפש,"
        },
        {
          "s": 25,
          "text": "וגם העבודה גופא"
        },
        {
          "s": 26,
          "text": "(העלי' שלהם)"
        },
        {
          "s": 27,
          "text": "היא בבחינת ריחוק ודילוג שלא בסדר והדרגה"
        },
        {
          "s": 28,
          "text": "(היינו שהדרגא שעולים בה היא בריחוק ושלא בערך כלל לגבי הדרגות שהיו בה תחלה),"
        },
        {
          "s": 29,
          "text": "וגם המקום"
        },
        {
          "s": 30,
          "text": "(הבחינה שלמעלה)"
        },
        {
          "s": 31,
          "text": "שמגיעים לשם הוא בחינת מקום רחוק,"
        },
        {
          "s": 32,
          "text": "העלם שאינו במציאות."
        }
      ]
    }
  ]
}