  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916678_theRebbe_290__p003",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916678_theRebbe_290",
  "title": "הערות לד\"ה באתי לגני תשי\"ג",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "הרי מצינו או\"ה מכחישים מציאות אלוקה לגמרי."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "והנה קושיא זו אינה על המאמר,"
        },
        {
          "s": 1,
          "text": "כי אם על מרז\"ל"
        },
        {
          "s": 2,
          "text": "(מנחות בסופה)"
        },
        {
          "s": 3,
          "text": "דקרו לי' אלקא דאלקיא"
        },
        {
          "s": 4,
          "text": "(ונלמד שם מקרא – ממזרח שמש ועד מבואו גו'),"
        },
        {
          "s": 5,
          "text": "אשר מרז\"ל זה הוא יסוד המבואר במאמר."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "והביאור בזה מובן ממש\"כ בס' המצות להצמח צדק סוף מצות אחדות ה' עיי\"ש."
        },
        {
          "s": 1,
          "text": "ואכ\"מ."
        }
      ]
    }
  ]
}