{
  "globalIndex": 83,
  "owner": 33,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914186_theRebbe_341__p001",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914186_theRebbe_341__p001",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914186_theRebbe_341",
  "title": "מאמר בסוכות תשבו תשל\"ו",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "י\"ג תשרי"
        },
        {
          "s": 2,
          "text": "(הילולא דכ\"ק אדמו\"ר מהר\"ש),"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "אור לערב חג הסוכות,"
        },
        {
          "s": 1,
          "text": "ה'תשל\"ו*"
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "בסוכות תשבו שבעת ימים"
        },
        {
          "s": 1,
          "text": "(ומוסיף עוד ציווי)"
        },
        {
          "s": 2,
          "text": "כל האזרח בישראל ישבו בסוכות"
        },
        {
          "s": 3,
          "text": "(והטעם על זה)"
        },
        {
          "s": 4,
          "text": "למען ידעו דורותיכם כי בסוכות הושבתי את בנ\"י בהוציאי אותם מארץ מצרים גו'1."
        },
        {
          "s": 5,
          "text": "וידועים הדיוקים בזה במאמרי רבותינו נשיאינו,"
        },
        {
          "s": 6,
          "text": "ובהקדים מ\"ש בעל ההילולא2"
        },
        {
          "s": 7,
          "text": "שסוכה הו\"ע השלום כמ\"ש3"
        },
        {
          "s": 8,
          "text": "ופרושׂ עלינו סוכת שלומך,"
        },
        {
          "s": 9,
          "text": "וצריך להבין מהי השייכות דסוכה לשלום."
        },
        {
          "s": 10,
          "text": "והנה בז' ימי הסוכות ישנם כמה ענינים,"
        },
        {
          "s": 11,
          "text": "השייכים לבסוכות תשבו שבעת ימים."
        },
        {
          "s": 12,
          "text": "וכמו מצות נטילת ד' מינים"
        },
        {
          "s": 13,
          "text": "(ולקחתם4"
        },
        {
          "s": 14,
          "text": "לכם ביום הראשון גו')"
        },
        {
          "s": 15,
          "text": "שיש לה שייכות לענין הסוכה."
        },
        {
          "s": 16,
          "text": "וכידוע5"
        },
        {
          "s": 17,
          "text": "שמצוה מן המובחר שנטילת ד' מינים תהי' בסוכה."
        },
        {
          "s": 18,
          "text": "וגם יש בז' ימי הסוכות הענין דהקרבת ע' פרים שהם כנגד שבעים אומות כדאיתא במדרש6."
        },
        {
          "s": 19,
          "text": "וענין זה יש גם עכשיו כמ\"ש ונשלמה פרים שפתינו7,"
        },
        {
          "s": 20,
          "text": "ובפרט ע\"פ המבואר8"
        },
        {
          "s": 21,
          "text": "דונשלמה הוא לא רק הענין דתשלומין אלא גם מלשון שלימות,"
        },
        {
          "s": 22,
          "text": "היינו שגם בזמן הגלות,"
        },
        {
          "s": 23,
          "text": "ע\"י אמירת פסוקי הקרבנות דע' פרים הענין הוא בשלימותו,"
        },
        {
          "s": 24,
          "text": "ואף שבזמן הגלות,"
        },
        {
          "s": 25,
          "text": "מכיון שהפעולה היא רק ע\"י \"שפתינו\","
        },
        {
          "s": 26,
          "text": "אי\"ז ניכר בגלוי בגשמיות ועאכו\"כ בחומריות העולם,"
        },
        {
          "s": 27,
          "text": "מ\"מ,"
        },
        {
          "s": 28,
          "text": "מכיון שעקימת שפתיו הוי מעשה9,"
        },
        {
          "s": 29,
          "text": "וכמבואר בארוכה בתניא10,"
        },
        {
          "s": 30,
          "text": "הרי גם עכשיו הפעולה בשלימותה ברוחניות"
        },
        {
          "s": 31,
          "text": "(ובמעשה זוטא עכ\"פ)."
        },
        {
          "s": 32,
          "text": "וצריך להבין,"
        },
        {
          "s": 33,
          "text": "מהי השייכות דענינים אלו"
        },
        {
          "s": 34,
          "text": "(נטילת ד' מינים והקרבת ע' פרים)"
        },
        {
          "s": 35,
          "text": "לענין הסוכה."
        },
        {
          "s": 36,
          "text": "והנה כאשר יו\"ט ראשון של חג חל להיות בשבת"
        },
        {
          "s": 37,
          "text": "[כקביעות שנה זו]"
        },
        {
          "s": 38,
          "text": "יש חילוק בין זמן הבית לזמן הגלות"
        },
        {
          "s": 39,
          "text": "[ובדוגמת11"
        },
        {
          "s": 40,
          "text": "תקיעת שופר ביו\"ט של ראש השנה שחל להיות בשבת,"
        },
        {
          "s": 41,
          "text": "שבמקדש היו תוקעין אבל לא במדינה],"
        },
        {
          "s": 42,
          "text": "שבזמן הבית ביו\"ט ראשון של חג לולב דוחה שבת אף בגבולין,"
        },
        {
          "s": 43,
          "text": "ומשחרב בית המקדש אין לולב דוחה שבת גם ביו\"ט ראשון,"
        },
        {
          "s": 44,
          "text": "כמבואר במשנה וגמרא12."
        }
      ]
    }
  ]
}