{
  "globalIndex": 478,
  "owner": 28,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916474_theRebbe_113__p003",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916474_theRebbe_113__p003",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916474_theRebbe_113",
  "title": "מאמר באתי לגני תשי\"א",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "והנה זה תובעים מכאו\"א מאתנו דור השביעי,"
        },
        {
          "s": 1,
          "text": "דכל השביעין חביבין,"
        },
        {
          "s": 2,
          "text": "דעם היות שזה שאנחנו בדור השביעי הוא לא עפ\"י בחירתנו ולא ע\"י עבודתנו,"
        },
        {
          "s": 3,
          "text": "ובכמה ענינים אפשר שלא כפי רצוננו,"
        },
        {
          "s": 4,
          "text": "מ\"מ הנה כל השביעין חביבין,"
        },
        {
          "s": 5,
          "text": "שנמצאים אנחנו בעיקבתא דמשיחא,"
        },
        {
          "s": 6,
          "text": "בסיומא דעקבתא,"
        },
        {
          "s": 7,
          "text": "והעבודה – לגמור המשכת השכינה,"
        },
        {
          "s": 8,
          "text": "ולא רק שכינה כ\"א עיקר שכינה,"
        },
        {
          "s": 9,
          "text": "ובתחתונים דוקא."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה אחרי שמבאר בהמאמר דעיקר שכינה בתחתונים היתה וגם אח\"כ המשיכה משה"
        },
        {
          "s": 2,
          "text": "(השביעי)"
        },
        {
          "s": 3,
          "text": "לארץ דוקא אומר: ועיקר גילוי אלקות הי' בבית המקדש"
        },
        {
          "s": 4,
          "text": "(ומביא ע\"ז הפסוק)"
        },
        {
          "s": 5,
          "text": "דכתיב4"
        },
        {
          "s": 6,
          "text": "ועשו לי מקדש ושכנתי בתוכם,"
        },
        {
          "s": 7,
          "text": "בתוכו לא נאמר אלא בתוכם בתוך כאו\"א מישראל14,"
        },
        {
          "s": 8,
          "text": "וזהו"
        },
        {
          "s": 9,
          "text": "(ג\"כ מש\"כ15)"
        },
        {
          "s": 10,
          "text": "צדיקים יירשו ארץ וישכנו לעד עלי' דצדיקים יירשו ארץ שהוא ג\"ע,"
        },
        {
          "s": 11,
          "text": "מפני שהם משכינים"
        },
        {
          "s": 12,
          "text": "(היינו ממשיכים16)"
        },
        {
          "s": 13,
          "text": "בחינת שוכן עד מרום וקדוש17"
        },
        {
          "s": 14,
          "text": "(הענין הזה דשוכן עד אינו מבאר בהמאמר,"
        },
        {
          "s": 15,
          "text": "ומבואר הוא בלקו\"ת18"
        },
        {
          "s": 16,
          "text": "עפ\"י מאמר הזהר19)"
        },
        {
          "s": 17,
          "text": "שיהי' בגילוי למטה,"
        },
        {
          "s": 18,
          "text": "וזהו באתי לגני לגנוני למקום שהי' עיקרו בתחילה דעיקר שכינה בתחתונים היתה."
        },
        {
          "s": 19,
          "text": "והענין הוא"
        },
        {
          "s": 20,
          "text": "(ביאור הענין להבין מפני מה היתה עיקר שכינה בתחתונים דוקא)"
        },
        {
          "s": 21,
          "text": "דהנה תכלית הכוונה בבריאת והשתלשלות העולמות,"
        },
        {
          "s": 22,
          "text": "דנתאוה הקב\"ה להיות לו ית' דירה בתחתונים20."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "והנה רבנו הזקן מבאר בזהט"
        },
        {
          "s": 1,
          "text": "אשר תכלית השתלשלות העולמות וירידתם אינו בשביל עולמות העליונים,"
        },
        {
          "s": 2,
          "text": "הואיל ולהם ירידה מאור פניו ית',"
        },
        {
          "s": 3,
          "text": "ואא\"ל שהכוונה הוא בשביל הירידה."
        },
        {
          "s": 4,
          "text": "דהנה ידוע דהבריאה הוא רק בכח העצמות,"
        },
        {
          "s": 5,
          "text": "וכמ\"ש באגה\"ק ד\"ה איהו וחיוהי21"
        },
        {
          "s": 6,
          "text": "אשר מהותו ועצמותו שמציאותו הוא מעצמותו ואין לו עילה קודמת ח\"ו,"
        },
        {
          "s": 7,
          "text": "הוא לבדו בכחו ויכלתו לברוא יש מאין ואפס המוחלט ממש."
        },
        {
          "s": 8,
          "text": "היינו שההתהוות אינה מהגילוים כי אם מהעצמות,"
        },
        {
          "s": 9,
          "text": "וא\"כ א\"א לומר שתכלית ההתהוות היא בשביל עולמות העליונים,"
        },
        {
          "s": 10,
          "text": "שהרי גם עולם האצי' הוא גילוי ההעלם22"
        },
        {
          "s": 11,
          "text": "וא\"כ זהו ירידה מאור פניו ית',"
        },
        {
          "s": 12,
          "text": "כי כשהיו אורות האצי' בהעלמם היו במדרי' גבוה הרבה יותר."
        },
        {
          "s": 13,
          "text": "ועוד שכיון שזהו רק גילוים הרי אא\"ל שהעצמות הוא בשביל גילוים,"
        },
        {
          "s": 14,
          "text": "אלא שהתכלית הוא עוה\"ז התחתון."
        },
        {
          "s": 15,
          "text": "וכמ\"ש אדמו\"ר האמצעי בפרשה זוי"
        },
        {
          "s": 16,
          "text": "(פ' בשלח)"
        },
        {
          "s": 17,
          "text": "בענין ההפרש בין עולמות העליונים לעוה\"ז,"
        },
        {
          "s": 18,
          "text": "דבעוה\"ז נרגש שמציאותו מעצמותו"
        },
        {
          "s": 19,
          "text": "(וכמבואר בההמשך דר\"ה דהאי שתא23,"
        },
        {
          "s": 20,
          "text": "ההפרש בין נברא ואור,"
        },
        {
          "s": 21,
          "text": "דאור הוא ראי' על המאור,"
        },
        {
          "s": 22,
          "text": "דכשאנו רואים אור,"
        },
        {
          "s": 23,
          "text": "האור עצמו מראה ומגלה שיש מאור,"
        },
        {
          "s": 24,
          "text": "משא\"כ יש הנברא הנה לא זו בלבד שאינו מגלה בורא,"
        },
        {
          "s": 25,
          "text": "אלא עוד זאת שהוא מעלים ומסתיר על זה,"
        },
        {
          "s": 26,
          "text": "ואדרבה נרגש שמציאותו מעצמותו"
        },
        {
          "s": 27,
          "text": "(אלא שמצד השכל מוכרח שאינו כן))24."
        },
        {
          "s": 28,
          "text": "ואף שזהו רק בהרגשתו,"
        },
        {
          "s": 29,
          "text": "מ\"מ הנה זה גופא שיהי' נדמה עכ\"פ שמציאותו מעצמותו זהו מפני ששרשו מהעצמות שמציאותו מעצמותו."
        },
        {
          "s": 30,
          "text": "נמצא מובן שהכוונה בהבריאה וההשתלשלות אינה בשביל עולמות העליונים שענינם גילוים,"
        },
        {
          "s": 31,
          "text": "כ\"א הכוונה הוא עוה\"ז התחתון,"
        },
        {
          "s": 32,
          "text": "שנדמה לו שאינו גילוי כ\"א עצמי,"
        },
        {
          "s": 33,
          "text": "היינו מציאותו מעצמותו,"
        },
        {
          "s": 34,
          "text": "וע\"י העבודה בו,"
        },
        {
          "s": 35,
          "text": "ע\"י אתכפיא ואתהפכא,"
        },
        {
          "s": 36,
          "text": "נתגלה העצמות,"
        },
        {
          "s": 37,
          "text": "בשבילו הי' בריאת והשתלשלות העולמות."
        }
      ]
    }
  ]
}