{
  "globalIndex": 168,
  "owner": 18,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914734_theRebbe_896__p003",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914734_theRebbe_896__p003",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914734_theRebbe_896",
  "title": "מאמר בורא ניב שפתיים תשמ\"ח",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה ענין זה דוהרוח תשוב אל האלקים אשר נתנה"
        },
        {
          "s": 2,
          "text": "[שגם כשהנשמה היא למטה תהי' מיוחדת בו ית' כמו שהיתה כלולה בעצמות אוא\"ס]"
        },
        {
          "s": 3,
          "text": "הוא בעיקר ע\"י עבודת התשובה."
        },
        {
          "s": 4,
          "text": "ויש לומר,"
        },
        {
          "s": 5,
          "text": "שזה מרומז גם בלשון הכתוב והרוח תשוב גו',"
        },
        {
          "s": 6,
          "text": "תשוב מלשון תשובה,"
        },
        {
          "s": 7,
          "text": "כי עיקר השבת הנשמה לשרשה"
        },
        {
          "s": 8,
          "text": "(אל האלקים אשר נתנה)"
        },
        {
          "s": 9,
          "text": "הוא ע\"י עבודת התשובה."
        },
        {
          "s": 10,
          "text": "והענין הוא"
        },
        {
          "s": 11,
          "text": "(כמבואר בהמאמר),"
        },
        {
          "s": 12,
          "text": "דעבודת הצדיקים"
        },
        {
          "s": 13,
          "text": "(תורה עבודה וגמ\"ח)"
        },
        {
          "s": 14,
          "text": "היא במדידה והגבלה,"
        },
        {
          "s": 15,
          "text": "ועבודת התשובה היא למעלה ממדידה והגבלה."
        },
        {
          "s": 16,
          "text": "דזהו שתשובה היא בשעתא חדא וברגעא חדא21."
        },
        {
          "s": 17,
          "text": "ולכן השבת הנשמה לשרשה שע\"י התשובה היא השבה נעלית יותר מההשבה שע\"י תורה עבודה וגמ\"ח"
        },
        {
          "s": 18,
          "text": "(עבודת הצדיקים)."
        },
        {
          "s": 19,
          "text": "וזהו שלום שלום לרחוק ולקרוב,"
        },
        {
          "s": 20,
          "text": "לרחוק ברישא והדר לקרוב,"
        },
        {
          "s": 21,
          "text": "שהשלום שנעשה ע\"י עבודת התשובה"
        },
        {
          "s": 22,
          "text": "(רחוק שנתקרב)"
        },
        {
          "s": 23,
          "text": "הוא נעלה יותר מהשלום שע\"י עבודת הצדיקים"
        },
        {
          "s": 24,
          "text": "(קרוב)."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "וזהו גם מה שממשיך בכתוב אמר הוי' ורפאתיו,"
        },
        {
          "s": 1,
          "text": "כי המעלה דעבודת התשובה"
        },
        {
          "s": 2,
          "text": "(שלום לרחוק)"
        },
        {
          "s": 3,
          "text": "הוא שתשובה היא כמו רפואה22"
        },
        {
          "s": 4,
          "text": "(ורפאתיו)."
        },
        {
          "s": 5,
          "text": "והענין הוא"
        },
        {
          "s": 6,
          "text": "(כמבואר בהמאמר23),"
        },
        {
          "s": 7,
          "text": "דבאכילה ושתי' צריך לכמות גדולה של מזון בכדי לפעול חיזוק התקשרות הנפש באברי הגוף,"
        },
        {
          "s": 8,
          "text": "משא\"כ ברפואה,"
        },
        {
          "s": 9,
          "text": "גם טיפה אחת מסממני רפואה יש בה כח לחזק התקשרות הנפש בהגוף."
        },
        {
          "s": 10,
          "text": "והטעם לזה הוא,"
        },
        {
          "s": 11,
          "text": "כי הכח שבסממני רפואה אינו מוגבל כ\"כ כהכח שבמזון,"
        },
        {
          "s": 12,
          "text": "ולכן אינו תלוי כ\"כ בהכמות."
        },
        {
          "s": 13,
          "text": "ועד\"ז הוא בתשובה שנמשלה לרפואה22,"
        },
        {
          "s": 14,
          "text": "דהטעם על זה שתשובה היא בשעתא חדא וברגעא חדא,"
        },
        {
          "s": 15,
          "text": "ועד שע\"י הרהור תשובה אחד הוא מתהפך מרשע גמור לצדיק גמור24,"
        },
        {
          "s": 16,
          "text": "הוא,"
        },
        {
          "s": 17,
          "text": "כי תשובה היא למעלה מהגבלה."
        },
        {
          "s": 18,
          "text": "ועפ\"ז יש לבאר מ\"ש אמר הוי' ורפאתיו,"
        },
        {
          "s": 19,
          "text": "דזה שברפואה ותשובה נאמר אמר הוי'"
        },
        {
          "s": 20,
          "text": "(אף שפעולת כל הדברים היא לא בכח עצמם אלא בכח הקב\"ה),"
        },
        {
          "s": 21,
          "text": "הוא,"
        },
        {
          "s": 22,
          "text": "כי ברפואה ובתשובה ישנו ענין שלמעלה מהגבלה"
        },
        {
          "s": 23,
          "text": "[שלכן,"
        },
        {
          "s": 24,
          "text": "תשובה היא בשעתא חדא וברגעא חדא,"
        },
        {
          "s": 25,
          "text": "ועד\"ז רפואה כפשוטה שיכולה להיות גם ע\"י טיפה אחת],"
        },
        {
          "s": 26,
          "text": "וענין זה הוא ע\"י נתינת כח מיוחד מלמעלה,"
        },
        {
          "s": 27,
          "text": "אמר הוי'."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ויש להוסיף"
        },
        {
          "s": 2,
          "text": "[ובפרט שענין זה"
        },
        {
          "s": 3,
          "text": "(דלקמן)"
        },
        {
          "s": 4,
          "text": "הוא דבר שהדור צריך לו וכמה צריכים לו],"
        },
        {
          "s": 5,
          "text": "דפירוש ורפאתיו הוא שאני"
        },
        {
          "s": 6,
          "text": "(הוי')"
        },
        {
          "s": 7,
          "text": "ארפא25."
        },
        {
          "s": 8,
          "text": "היינו,"
        },
        {
          "s": 9,
          "text": "דנוסף לזה שרפואה בכלל"
        },
        {
          "s": 10,
          "text": "(גם כשהרפואה היא ע\"י שליח,"
        },
        {
          "s": 11,
          "text": "בו\"ד)"
        },
        {
          "s": 12,
          "text": "היא ע\"י אמר הוי',"
        },
        {
          "s": 13,
          "text": "הנה רפואה זו נמשכת מהקב\"ה עצמו,"
        },
        {
          "s": 14,
          "text": "אני הוי' רופאיך26."
        },
        {
          "s": 15,
          "text": "ולכן היא באופן דכל המחלה גו' לא אשים עליך"
        },
        {
          "s": 16,
          "text": "(מלכתחילה)27."
        },
        {
          "s": 17,
          "text": "ולהוסיף,"
        },
        {
          "s": 18,
          "text": "דגם כשהרפואה דאני הוי' רופאיך באה לאחרי שמצד סיבות שונות הי' דבר בלתי רצוי,"
        },
        {
          "s": 19,
          "text": "הרפואה היא באופן שלא נשאר שום רושם,"
        },
        {
          "s": 20,
          "text": "ועד שנעקר למפרע."
        },
        {
          "s": 21,
          "text": "דרפואה שע\"י בו\"ד,"
        },
        {
          "s": 22,
          "text": "נוסף לזה שאינה מרפאת אלא מכאן ולהבא28,"
        },
        {
          "s": 23,
          "text": "גם לאח\"ז נשאר רושם29."
        },
        {
          "s": 24,
          "text": "וע\"י הרפואה דאני הוי' רופאיך נעקר מתחלתו."
        }
      ]
    }
  ]
}