{
  "globalIndex": 319,
  "owner": 19,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915585_theRebbe_828__p006",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915585_theRebbe_828__p006",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915585_theRebbe_828",
  "title": "מאמר פתח אליהו תשט\"ו",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "והענין הוא,"
        },
        {
          "s": 1,
          "text": "דכתיב37"
        },
        {
          "s": 2,
          "text": "כל אשר חפץ הוי' עשה"
        },
        {
          "s": 3,
          "text": "(שההתהוות היא מבחינת חפץ ורצון),"
        },
        {
          "s": 4,
          "text": "וכתיב38"
        },
        {
          "s": 5,
          "text": "בדבר הוי' שמים נעשו"
        },
        {
          "s": 6,
          "text": "(שההתהוות היא מבחינת הדיבור),"
        },
        {
          "s": 7,
          "text": "והביאור בזה39,"
        },
        {
          "s": 8,
          "text": "דהתהוות החומר של כל דבר היא מבחינת הדיבור."
        },
        {
          "s": 9,
          "text": "וזהו שאמרו רז\"ל40"
        },
        {
          "s": 10,
          "text": "בעשרה מאמרות נברא העולם,"
        },
        {
          "s": 11,
          "text": "שבהמאמר יהי אור נתהווה האור ובמאמר יהי רקיע נתהווה הרקיע,"
        },
        {
          "s": 12,
          "text": "ועד\"ז הוא בכל הנבראים."
        },
        {
          "s": 13,
          "text": "והתהוות הצורה שבכל דבר היא מבחינת הרצון."
        },
        {
          "s": 14,
          "text": "דצורת הנבראים לא נתפרשה בהעשרה מאמרות,"
        },
        {
          "s": 15,
          "text": "וזה שכל נברא יש לו צורה"
        },
        {
          "s": 16,
          "text": "[הן הציור הגשמי שלו,"
        },
        {
          "s": 17,
          "text": "והן הטבע והתכונות שלו]"
        },
        {
          "s": 18,
          "text": "הוא מבחינת הרצון."
        },
        {
          "s": 19,
          "text": "ומ\"ש41"
        },
        {
          "s": 20,
          "text": "כולם בחכמה עשית,"
        },
        {
          "s": 21,
          "text": "הוא,"
        },
        {
          "s": 22,
          "text": "כי המשכת הרצון היא ע\"י החכמה."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "והטעם42 על זה שההתהוות היא משני הענינים,"
        },
        {
          "s": 1,
          "text": "מבחינת הדיבור ומבחינת הרצון,"
        },
        {
          "s": 2,
          "text": "הוא,"
        },
        {
          "s": 3,
          "text": "כי תכלית הכוונה בבריאת העולם היא שהעולם"
        },
        {
          "s": 4,
          "text": "(מצד עצמו)"
        },
        {
          "s": 5,
          "text": "יהי' יש וע\"י עבודת האדם"
        },
        {
          "s": 6,
          "text": "(דוקא)"
        },
        {
          "s": 7,
          "text": "יומשך בו הביטול,"
        },
        {
          "s": 8,
          "text": "ועד לביטול כזה שהעולם יהי' דירה לו ית'."
        },
        {
          "s": 9,
          "text": "ושני הענינים שבהעולם – שמצד עצמו הוא יש,"
        },
        {
          "s": 10,
          "text": "ושאעפ\"כ אפשר להמשיך בו ביטול43"
        },
        {
          "s": 11,
          "text": "– הם ע\"י שהתהוותו היא מבחינת הרצון ומבחינת הדיבור."
        },
        {
          "s": 12,
          "text": "דבאם כל ההתהוות"
        },
        {
          "s": 13,
          "text": "(גם ההתהוות דחומר הנבראים)"
        },
        {
          "s": 14,
          "text": "היתה מבחינת הרצון הי' העולם בטל במציאות,"
        },
        {
          "s": 15,
          "text": "ובכדי שיהי' העולם במציאות יש הוא ע\"י שנברא בדבר ה'."
        },
        {
          "s": 16,
          "text": "ובאם כל ההתהוות"
        },
        {
          "s": 17,
          "text": "(גם ההתהוות דצורת הנבראים)"
        },
        {
          "s": 18,
          "text": "היתה מבחינת הדיבור,"
        },
        {
          "s": 19,
          "text": "לא הי' העולם שייך לענין הביטול."
        },
        {
          "s": 20,
          "text": "וע\"י שהתהוות צורת הנבראים היא מבחינת הרצון,"
        },
        {
          "s": 21,
          "text": "כמו שנמשך בבחינת הדיבור"
        },
        {
          "s": 22,
          "text": "[דזה שצורת הנבראים היא הציור דהחומר הוא לפי שהרצון נמשך בהדיבור],"
        },
        {
          "s": 23,
          "text": "עי\"ז אפשר להמשיך"
        },
        {
          "s": 24,
          "text": "(ע\"י עבודה)"
        },
        {
          "s": 25,
          "text": "שגם היש שנתהווה מהדיבור יהי' בביטול."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "דהטעם על זה שהביטול דהנבראים נמשך מבחינת הרצון והישות דהנבראים מבחינת הדיבור,"
        },
        {
          "s": 3,
          "text": "הוא,"
        },
        {
          "s": 4,
          "text": "כי הרצון אינו מציאות והוא רק גילוי העצם"
        },
        {
          "s": 5,
          "text": "(ע\"ד הרצון שבנפש האדם,"
        },
        {
          "s": 6,
          "text": "שהוא רק הטיית והמשכת הנפש),"
        },
        {
          "s": 7,
          "text": "ולכן גם ההתהוות שמהרצון,"
        },
        {
          "s": 8,
          "text": "ענינה הוא"
        },
        {
          "s": 9,
          "text": "(לא זה שמתהווים נבראים,"
        },
        {
          "s": 10,
          "text": "אלא)"
        },
        {
          "s": 11,
          "text": "זה שע\"י ההתהוות נשלם הרצון44."
        },
        {
          "s": 12,
          "text": "והדיבור הוא לבוש הנפרד."
        },
        {
          "s": 13,
          "text": "דנוסף לזה שהדיבור הוא מציאות,"
        },
        {
          "s": 14,
          "text": "כיון שענינו הוא שמדבר לזולתו,"
        },
        {
          "s": 15,
          "text": "הרי בזה עצמו הוא נפרד מהאדם המדבר,"
        },
        {
          "s": 16,
          "text": "ועד שהדיבור יוצא ונפרד מהאדם גם בפועל."
        },
        {
          "s": 17,
          "text": "ולכן45"
        },
        {
          "s": 18,
          "text": "ההתהוות שמהדיבור היא מציאות יש."
        }
      ]
    }
  ]
}