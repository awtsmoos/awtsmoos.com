{
  "globalIndex": 1057,
  "owner": 7,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518920021_theRebbe_64__p001",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518920021_theRebbe_64__p001",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518920021_theRebbe_64",
  "title": "מאמר ושננתם לבניך תשל\"ח",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "אור ליום ועש\"ק פ' ואתחנן,"
        },
        {
          "s": 2,
          "text": "ט\"ו באב ה'תשל\"ח*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "(הנחה."
        },
        {
          "s": 1,
          "text": "בלתי מוגה)"
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ושננתם לבניך ודברת בם1,"
        },
        {
          "s": 1,
          "text": "ולאח\"ז נאמר וקשרתם לאות על ידך גו'2,"
        },
        {
          "s": 2,
          "text": "מצות תפילין,"
        },
        {
          "s": 3,
          "text": "עלי' אמרו רז\"ל3"
        },
        {
          "s": 4,
          "text": "הוקשה כל התורה כולה לתפילין,"
        },
        {
          "s": 5,
          "text": "שהכוונה בזה היא להמצוות שבתורה4,"
        },
        {
          "s": 6,
          "text": "והיינו,"
        },
        {
          "s": 7,
          "text": "שהכתוב מקדים ענין התורה לענין המצוות."
        },
        {
          "s": 8,
          "text": "וידוע דיוק רבותינו נשיאינו5,"
        },
        {
          "s": 9,
          "text": "שבפרשה שני' דק\"ש נאמר6"
        },
        {
          "s": 10,
          "text": "וקשרתם אותם לאות על ידכם גו' ולמדתם אותם את בניכם גו',"
        },
        {
          "s": 11,
          "text": "שכתוב זה הוא בסדר הפוך,"
        },
        {
          "s": 12,
          "text": "שמקדים ענין המצוות"
        },
        {
          "s": 13,
          "text": "(מצות תפילין)"
        },
        {
          "s": 14,
          "text": "לענין התורה."
        },
        {
          "s": 15,
          "text": "גם צריך להבין מהו הטעם שהסדר שתורה קודמת למצוות הוא בפרשה ראשונה דק\"ש,"
        },
        {
          "s": 16,
          "text": "והסדר שמצוות קודמים לתורה הוא בפרשה שני' דק\"ש דוקא."
        },
        {
          "s": 17,
          "text": "גם צריך להבין דיוק הלשון בנוגע לענין התורה,"
        },
        {
          "s": 18,
          "text": "שבפרשה ראשונה נאמר ושננתם גו',"
        },
        {
          "s": 19,
          "text": "כפירוש רש\"י"
        },
        {
          "s": 20,
          "text": "(ממדרשי רז\"ל7)"
        },
        {
          "s": 21,
          "text": "שהוא לשון חדוד,"
        },
        {
          "s": 22,
          "text": "שיהיו מחודדים בפיך שאם ישאלך אדם דבר"
        },
        {
          "s": 23,
          "text": "(הלכה8)"
        },
        {
          "s": 24,
          "text": "לא תהא צריך לגמגם בו אלא אמור לו מיד"
        },
        {
          "s": 25,
          "text": "(ורק אח\"כ נאמר ודברת בם),"
        },
        {
          "s": 26,
          "text": "ואילו בפרשה שני' נאמר ולמדתם גו',"
        },
        {
          "s": 27,
          "text": "שלשון זה כולל כל אופני הלימוד"
        },
        {
          "s": 28,
          "text": "(גם אם הלימוד אינו באופן דמחודד בפיך כו')."
        }
      ]
    }
  ]
}