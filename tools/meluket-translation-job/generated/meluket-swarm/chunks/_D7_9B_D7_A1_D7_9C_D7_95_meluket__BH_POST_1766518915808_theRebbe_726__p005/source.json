{
  "globalIndex": 357,
  "owner": 7,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915808_theRebbe_726__p005",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915808_theRebbe_726__p005",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915808_theRebbe_726",
  "title": "מאמר פדה בשלום תשל\"ח",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "והנה הבירור דעולם בפועל הוא ע\"י העבודה בג' הקוין דתורה עבודה וגמ\"ח"
        },
        {
          "s": 2,
          "text": "[אלא שהעבודה בכל ג' הקוין צריכה להיות ביראה,"
        },
        {
          "s": 3,
          "text": "ראשית העבודה ועיקרה ושרשה77]."
        },
        {
          "s": 4,
          "text": "דכמו שהתהוות העולם היתה ע\"י ג' הקוין חג\"ת,"
        },
        {
          "s": 5,
          "text": "כן הבירור דהעולם"
        },
        {
          "s": 6,
          "text": "(ועד שהעולם יהי' דירה לו ית')"
        },
        {
          "s": 7,
          "text": "הוא ע\"י העבודה בכל ג' הקוין."
        },
        {
          "s": 8,
          "text": "וזהו וישב יעקב בארץ מגורי אביו,"
        },
        {
          "s": 9,
          "text": "דענין מגורי אביו"
        },
        {
          "s": 10,
          "text": "(הבירור דעולם)"
        },
        {
          "s": 11,
          "text": "הוא ע\"י יעקב,"
        },
        {
          "s": 12,
          "text": "השלישי והמשולש שבאבות78,"
        },
        {
          "s": 13,
          "text": "בחיר שבאבות79,"
        },
        {
          "s": 14,
          "text": "להיותו כלול מכל הג' קוין"
        },
        {
          "s": 15,
          "text": "(כי יעקב הוא ת\"ת הכולל גם המדות חו\"ג),"
        },
        {
          "s": 16,
          "text": "כמ\"ש80"
        },
        {
          "s": 17,
          "text": "אלקי אבי אברהם ופחד יצחק הי' לי,"
        },
        {
          "s": 18,
          "text": "שהי' בו גם ממדת החסד"
        },
        {
          "s": 19,
          "text": "(אברהם)"
        },
        {
          "s": 20,
          "text": "והגבורה"
        },
        {
          "s": 21,
          "text": "(פחד יצחק)81."
        },
        {
          "s": 22,
          "text": "וזהו גם מה שהתורה היא אוריאן תליתאי,"
        },
        {
          "s": 23,
          "text": "וגם כו\"כ ענינים במ\"ת שייכים לענין תליתאי82,"
        },
        {
          "s": 24,
          "text": "כי התכלית דמ\"ת הוא לפעול הבירור בעולם"
        },
        {
          "s": 25,
          "text": "(כמרז\"ל83"
        },
        {
          "s": 26,
          "text": "שהתורה ניתנה לעשות שלום בעולם),"
        },
        {
          "s": 27,
          "text": "וזה נעשה ע\"י עבודה בג' הקוין,"
        },
        {
          "s": 28,
          "text": "ענין תליתאי."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "וזהו גם מה שארז\"ל"
        },
        {
          "s": 1,
          "text": "(עה\"פ פדה בשלום נפשי)"
        },
        {
          "s": 2,
          "text": "כל העוסק בתורה ובגמ\"ח ומתפלל עם הצבור כאילו פדאני כו',"
        },
        {
          "s": 3,
          "text": "שפדיית הניצוצות שבעוה\"ז הגשמי"
        },
        {
          "s": 4,
          "text": "[שעי\"ז נעשה פדאני לי ולבני מבין אומות העולם כפשוטו]"
        },
        {
          "s": 5,
          "text": "היא ע\"י העסק בג' הקוין84"
        },
        {
          "s": 6,
          "text": "דתורה עבודה וגמ\"ח85."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "והנה מכיון שתכלית הכוונה בירידת הנשמה למטה הוא"
        },
        {
          "s": 2,
          "text": "(לא בשביל העילוי דתשובה שנעשה בהנשמה,"
        },
        {
          "s": 3,
          "text": "כי אם)"
        },
        {
          "s": 4,
          "text": "בכדי לפעול בירור והעלאת הניצוצות שבעולם"
        },
        {
          "s": 5,
          "text": "(כנ\"ל סעיף ו),"
        },
        {
          "s": 6,
          "text": "יש לומר,"
        },
        {
          "s": 7,
          "text": "דזה שע\"י עבודת האדם בג' הקוין דתורה עבודה וגמ\"ח נעשה עילוי בג' הקוין חג\"ת דלמעלה"
        },
        {
          "s": 8,
          "text": "(כנ\"ל סעיף ג),"
        },
        {
          "s": 9,
          "text": "הוא בעיקר מצד זה שע\"י העבודה בג' קוין אלה נעשה הבירור דעולם,"
        },
        {
          "s": 10,
          "text": "שזהו תכלית הכוונה."
        }
      ]
    }
  ]
}