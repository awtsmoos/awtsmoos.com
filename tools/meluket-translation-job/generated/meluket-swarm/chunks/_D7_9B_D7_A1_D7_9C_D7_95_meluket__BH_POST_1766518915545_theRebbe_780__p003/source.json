{
  "globalIndex": 312,
  "owner": 12,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915545_theRebbe_780__p003",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915545_theRebbe_780__p003",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915545_theRebbe_780",
  "title": "מאמר פדה בשלום תשמ\"א",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה הפדי' יכולה להיות באופן של ריחוק או של קירוב כנ\"ל,"
        },
        {
          "s": 2,
          "text": "ומבאר ומחדש שפדי' זו היא מקרב לי,"
        },
        {
          "s": 3,
          "text": "באופן של קירוב."
        },
        {
          "s": 4,
          "text": "ויובן זה ע\"פ ביאור כ\"ק אדמו\"ר הזקן21"
        },
        {
          "s": 5,
          "text": "במארז\"ל22"
        },
        {
          "s": 6,
          "text": "המתפלל צריך שיתן עיניו למטה ולבו למעלה,"
        },
        {
          "s": 7,
          "text": "שצ\"ל שייך ורואה גם את המטה,"
        },
        {
          "s": 8,
          "text": "היינו שגם בהיות לבו למעלה,"
        },
        {
          "s": 9,
          "text": "קשור למעלה,"
        },
        {
          "s": 10,
          "text": "צ\"ל רואה את המטה,"
        },
        {
          "s": 11,
          "text": "העולם ועניניו."
        },
        {
          "s": 12,
          "text": "ועד\"ז יובן בלימוד התורה,"
        },
        {
          "s": 13,
          "text": "שלימוד התורה צריך להיות באופן כזה שיביא לידי מעשה,"
        },
        {
          "s": 14,
          "text": "וכמארז\"ל23"
        },
        {
          "s": 15,
          "text": "גדול לימוד שמביא לידי מעשה."
        },
        {
          "s": 16,
          "text": "ועוד,"
        },
        {
          "s": 17,
          "text": "שלימודו הוא לאסוקי שמעתתא אליבא דהלכתא,"
        },
        {
          "s": 18,
          "text": "המסקנא להלכה למעשה בעניני העולם,"
        },
        {
          "s": 19,
          "text": "אשר דוקא אז"
        },
        {
          "s": 20,
          "text": "(ע\"י הלימוד באופן כזה)"
        },
        {
          "s": 21,
          "text": "הוא בא אל אמיתית הבנת הלימוד והכוונה"
        },
        {
          "s": 22,
          "text": "(כמבואר בארוכה בהמשך תרס\"ו24)."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "וממשיך בכתוב כי ברבים היו עמדי."
        },
        {
          "s": 2,
          "text": "פירוש הא' בזה,"
        },
        {
          "s": 3,
          "text": "שכ\"ז נעשה ע\"י תפלת הרבים,"
        },
        {
          "s": 4,
          "text": "כי אפילו כאשר אדם מישראל הוא בתכלית השלימות בעבודתו,"
        },
        {
          "s": 5,
          "text": "מ\"מ גם אז יש מעלה בתפלתו"
        },
        {
          "s": 6,
          "text": "(ושלא בערך)"
        },
        {
          "s": 7,
          "text": "כשמתפלל עם הציבור,"
        },
        {
          "s": 8,
          "text": "תפלת הרבים25."
        },
        {
          "s": 9,
          "text": "וכמובן גם מתפלת עשרת ימי תשובה שאמרו רז\"ל26"
        },
        {
          "s": 10,
          "text": "התם ביחיד הכא בציבור,"
        },
        {
          "s": 11,
          "text": "שתפלת היחיד בעשי\"ת היא כמו תפלת הרבים בשאר ימות השנה,"
        },
        {
          "s": 12,
          "text": "ומ\"מ אינה דומה תפלת היחיד בעשי\"ת לתפלת הרבים בעשי\"ת."
        },
        {
          "s": 13,
          "text": "והפירוש הב' בפסוק זה,"
        },
        {
          "s": 14,
          "text": "שכולל את הרבים את כל ישראל עמדו,"
        },
        {
          "s": 15,
          "text": "מובן ע\"פ מה שמביא בעל הגאולה בסידורו27"
        },
        {
          "s": 16,
          "text": "(מהאריז\"ל28),"
        },
        {
          "s": 17,
          "text": "שנכון לומר קודם התפלה הריני מקבל עלי מצות עשה של ואהבת לרעך כמוך."
        },
        {
          "s": 18,
          "text": "דאמירה זו היא לפני מה טובו וכו',"
        },
        {
          "s": 19,
          "text": "ונמשכת בכל דרגות ושלבי התפלה,"
        },
        {
          "s": 20,
          "text": "מה טובו,"
        },
        {
          "s": 21,
          "text": "הודו לה' וכו',"
        },
        {
          "s": 22,
          "text": "תפלת העמידה,"
        },
        {
          "s": 23,
          "text": "ועד לתפלת עלינו לשבח כו' ועל כן נקוה כו',"
        },
        {
          "s": 24,
          "text": "שאמרה יהושע בן נון29"
        },
        {
          "s": 25,
          "text": "כשכבש את ארץ ישראל בפעם הראשונה ובאופן דנחלת עולם."
        },
        {
          "s": 26,
          "text": "דכל פרטים ודרגות אלה בתפלה הם בשלימותם ע\"י קבלת מ\"ע של אהבת ישראל."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ויהי רצון שכל אחד ואחת יעשה את כל התלוי בו לקיים את הבקשה והנתינת כח של בעל הגאולה,"
        },
        {
          "s": 2,
          "text": "להפיץ את המעינות חוצה."
        },
        {
          "s": 3,
          "text": "אשר ידוע30"
        },
        {
          "s": 4,
          "text": "שעיקר ענין יפוצו מעינותיך חוצה התחיל אחרי פטרבורג,"
        },
        {
          "s": 5,
          "text": "וי\"ל דהיינו לא רק אחרי"
        },
        {
          "s": 6,
          "text": "(ומסובב מ)"
        },
        {
          "s": 7,
          "text": "הגאולה מפ\"ב,"
        },
        {
          "s": 8,
          "text": "אלא גם מסובב מהמאסר,"
        },
        {
          "s": 9,
          "text": "כי הזית הזה כשכותשין אותו הוא מוציא שמנו31."
        },
        {
          "s": 10,
          "text": "ויש לומר"
        },
        {
          "s": 11,
          "text": "(בדא\"פ)"
        },
        {
          "s": 12,
          "text": "יתירה מזו,"
        },
        {
          "s": 13,
          "text": "דלכן הי' רבינו הזקן במאסר במשך נ\"ג"
        },
        {
          "s": 14,
          "text": "(ג\"ן)"
        },
        {
          "s": 15,
          "text": "ימים32,"
        },
        {
          "s": 16,
          "text": "כדי שאח\"כ יהי' ענין הפצת המעינות בגנו של הקב\"ה,"
        },
        {
          "s": 17,
          "text": "עוה\"ז33."
        },
        {
          "s": 18,
          "text": "ומזה מובן גודל זכות ההתעסקות בהפצת המעינות,"
        },
        {
          "s": 19,
          "text": "להפיצם בכל תפוצות ישראל,"
        },
        {
          "s": 20,
          "text": "האנשים והנשים"
        },
        {
          "s": 21,
          "text": "[וכמ\"ש כ\"ק מו\"ח אדמו\"ר34"
        },
        {
          "s": 22,
          "text": "שגם הנשים מחוייבות בלימוד תורת החסידות,"
        },
        {
          "s": 23,
          "text": "שהרי תורה זו מביאה לקיום מצות אהוי\"ר וכיו\"ב,"
        },
        {
          "s": 24,
          "text": "שגם הנשים מחוייבות בהן"
        },
        {
          "s": 25,
          "text": "(וחיובן תמידי,"
        },
        {
          "s": 26,
          "text": "כמובא בהקדמת ספר החינוך)]"
        },
        {
          "s": 27,
          "text": "והטף,"
        },
        {
          "s": 28,
          "text": "למען ישמעו ולמען ילמדו גו' ושמרו לעשות את כל דברי התורה הזאת35."
        }
      ]
    }
  ]
}