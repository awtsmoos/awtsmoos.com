{
  "globalIndex": 49,
  "owner": 49,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913974_theRebbe_325__p002",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913974_theRebbe_325__p002",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518913974_theRebbe_325",
  "title": "מאמר וכל אדם תשכ\"ג",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויובן זה ע\"פ המבואר בהמאמר9"
        },
        {
          "s": 2,
          "text": "דתשובה"
        },
        {
          "s": 3,
          "text": "(וכפרה10)"
        },
        {
          "s": 4,
          "text": "הם בבחינת שמיני שלמעלה מהשתלשלות."
        },
        {
          "s": 5,
          "text": "דגדולה תשובה שמביאה רפואה לעולם11,"
        },
        {
          "s": 6,
          "text": "ורפואה קבעוה בשמינית12"
        },
        {
          "s": 7,
          "text": "דזה שרפואה קבעוה בשמינית הוא ע\"ד13"
        },
        {
          "s": 8,
          "text": "מילה שניתנה בשמינית."
        },
        {
          "s": 9,
          "text": "וזהו ששבעה ימים קודם יום הכפורים מפרישין כהן גדול מביתו14"
        },
        {
          "s": 10,
          "text": "וכל שבעת הימים מרגילין אותו בעבודות15,"
        },
        {
          "s": 11,
          "text": "כי שבעת הימים הם בחינת השתלשלות,"
        },
        {
          "s": 12,
          "text": "ויום הכפורים,"
        },
        {
          "s": 13,
          "text": "יום השמיני"
        },
        {
          "s": 14,
          "text": "(שלאחרי שבעת הימים)"
        },
        {
          "s": 15,
          "text": "הוא למעלה מהשתלשלות."
        },
        {
          "s": 16,
          "text": "וזהו גם ענין שמונה ההזיות ביום הכפורים אחת למעלה ושבע למטה16,"
        },
        {
          "s": 17,
          "text": "שהאחת שלמעלה מהשבע היא בחינת אחת שאלתי17,"
        },
        {
          "s": 18,
          "text": "אחת היא יונתי18."
        },
        {
          "s": 19,
          "text": "ומזה מובן,"
        },
        {
          "s": 20,
          "text": "דבשמיני שלמעלה מהשתלשלות כמה דרגות."
        },
        {
          "s": 21,
          "text": "שמיני דמילה ועד\"ז19"
        },
        {
          "s": 22,
          "text": "דקודש הקדשים שהכניסה לקודש הקדשים היא ע\"י זכות המילה."
        },
        {
          "s": 23,
          "text": "שמיני דתשובה שנעלה יותר משמיני דמילה,"
        },
        {
          "s": 24,
          "text": "(דמילה היא מצוה,"
        },
        {
          "s": 25,
          "text": "ותשובה שמכפרת על הענינים שפגמו בתורה ומצוות היא למעלה מתורה ומצוות"
        },
        {
          "s": 26,
          "text": "(כדלקמן סעיף ח))."
        },
        {
          "s": 27,
          "text": "שמיני דיום הכפורים,"
        },
        {
          "s": 28,
          "text": "שהתשובה דיום הכפורים היא נעלית יותר מהתשובה דכל השנה"
        },
        {
          "s": 29,
          "text": "(גם מהתשובה דעשרת ימי תשובה20),"
        },
        {
          "s": 30,
          "text": "שלכן יום הכפורים הוא זמן תשובה לכל21,"
        },
        {
          "s": 31,
          "text": "וביום הכפורים עצמו – שמונה ההזיות שבקודש הקדשים אחת למעלה ושבע למטה,"
        },
        {
          "s": 32,
          "text": "שהאחת היא לפני השבע22."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דשמיני שלאחרי שבעה הוא גילוי שלמעלה מהשתלשלות שנמשך לאחרי וע\"י הענינים דהשתלשלות,"
        },
        {
          "s": 2,
          "text": "ומזה שהמשכת גילוי זה הוא ע\"י הענינים דהשתלשלות מוכח שגילוי זה שייך להשתלשלות,"
        },
        {
          "s": 3,
          "text": "ואחת שלפני השבע הוא גילוי שלמעלה מהשתלשלות שלמעלה משייכות להשתלשלות23,"
        },
        {
          "s": 4,
          "text": "[אלא שלאח\"ז נמשך הגילוי בהשתלשלות,"
        },
        {
          "s": 5,
          "text": "שבע שלאחרי האחת,"
        },
        {
          "s": 6,
          "text": "כדלקמן סעיף ז]."
        },
        {
          "s": 7,
          "text": "ועפ\"ז יובן הטעם על זה שוכל אדם לא יהי' גו' הוא דוקא בבואו לכפר בקודש,"
        },
        {
          "s": 8,
          "text": "כי לגבי הגילוי שהי' בקדה\"ק מצד עצמו"
        },
        {
          "s": 9,
          "text": "[שהוא ע\"ד שמיני דמילה,"
        },
        {
          "s": 10,
          "text": "שמיני שאחרי שבעה],"
        },
        {
          "s": 11,
          "text": "למעלה מהשתלשלות ששייך להשתלשלות,"
        },
        {
          "s": 12,
          "text": "יש נתינת מקום למציאות."
        },
        {
          "s": 13,
          "text": "וע\"י העבודה דכהן גדול ביום הכפורים בקודש הקדשים נמשך הגילוי דלמעלה מהשתלשלות שלמעלה משייכות להשתלשלות,"
        },
        {
          "s": 14,
          "text": "ולגבי גילוי זה כל אדם לא יהי',"
        },
        {
          "s": 15,
          "text": "אפילו אותן שדמות פניהם פני אדם."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים מ\"ש24"
        },
        {
          "s": 2,
          "text": "כי המצוה הזאת אשר אנכי מצוך,"
        },
        {
          "s": 3,
          "text": "ומבואר בלקו\"ת25"
        },
        {
          "s": 4,
          "text": "דכל המצוות נקראים מצוות הוי',"
        },
        {
          "s": 5,
          "text": "והמצוה הזאת שהיא מצות התשובה,"
        },
        {
          "s": 6,
          "text": "אנכי מצוך,"
        },
        {
          "s": 7,
          "text": "אנכי מי שאנכי"
        },
        {
          "s": 8,
          "text": "(שלמעלה מהוי')."
        },
        {
          "s": 9,
          "text": "והענין הוא26,"
        },
        {
          "s": 10,
          "text": "דענין המצוות הוא להמשיך גילוי שם הוי' בעולם."
        },
        {
          "s": 11,
          "text": "דבריאת העולם היא משם אלקים,"
        },
        {
          "s": 12,
          "text": "אלקים בגימטריא הטבע27,"
        },
        {
          "s": 13,
          "text": "וע\"י המצוות נמשך בעולם גילוי שם הוי' שלמעלה מהטבע."
        },
        {
          "s": 14,
          "text": "ועיקר הגילוי דהוי' שע\"י קיום המצוות הוא בהאדם שמקיים את המצוות"
        },
        {
          "s": 15,
          "text": "(ועי\"ז נמשך הגילוי גם בעולם)."
        },
        {
          "s": 16,
          "text": "וזהו שהדבור הראשון דמתן תורה הוא אנכי28"
        },
        {
          "s": 17,
          "text": "הוי' אלקיך,"
        },
        {
          "s": 18,
          "text": "שענין המצוות שניתנו במ\"ת הוא שהוי' יהי' אלקיך."
        }
      ]
    }
  ]
}