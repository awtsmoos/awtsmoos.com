{
  "globalIndex": 50,
  "owner": 0,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913974_theRebbe_325__p003",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913974_theRebbe_325__p003",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518913974_theRebbe_325",
  "title": "מאמר וכל אדם תשכ\"ג",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "והנה זה שע\"י המצוות אפשר להמשיך בעולם גילוי שם הוי',"
        },
        {
          "s": 1,
          "text": "הגם שהתהוות העולם היא ע\"י שם אלקים שמעלים ומסתיר על שם הוי',"
        },
        {
          "s": 2,
          "text": "הוא,"
        },
        {
          "s": 3,
          "text": "לפי שכוונת ההעלם דשם אלקים"
        },
        {
          "s": 4,
          "text": "(מלכתחילה)"
        },
        {
          "s": 5,
          "text": "היא בכדי שע\"י התומ\"צ יומשך הגילוי דהוי'."
        },
        {
          "s": 6,
          "text": "וכמ\"ש29"
        },
        {
          "s": 7,
          "text": "אשר עשה האלקים את האדם ישר,"
        },
        {
          "s": 8,
          "text": "שהכוונה בההתהוות שמשם אלקים"
        },
        {
          "s": 9,
          "text": "(האלקים עשה)"
        },
        {
          "s": 10,
          "text": "היא שהאדם ע\"י קיום המצוות ימשיך להיות ישר יחזו פנימו30,"
        },
        {
          "s": 11,
          "text": "שלמטה יהי' הגילוי כמו למעלה."
        },
        {
          "s": 12,
          "text": "וכאשר המה בקשו חשבונות רבים31"
        },
        {
          "s": 13,
          "text": "(היפך כוונת הבריאה),"
        },
        {
          "s": 14,
          "text": "הנה בכדי שיומשך הגילוי דשם הוי' באדם ועל ידו בעולם,"
        },
        {
          "s": 15,
          "text": "צריכה להיות ההמשכה מאנכי שלמעלה מהוי',"
        },
        {
          "s": 16,
          "text": "דהמשכה זו היא ע\"י התשובה שלמעלה מהמצוות."
        },
        {
          "s": 17,
          "text": "וכמ\"ש32"
        },
        {
          "s": 18,
          "text": "שובה ישראל עד הוי' אלקיך כי כשלת בעוניך,"
        },
        {
          "s": 19,
          "text": "שבכדי שיהי' הוי' אלקיך לאחרי שכשלת בעוניך אין מספיק קיום המצוות שמכאן ולהבא וצריך להיות שובה ישראל."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וביאור הענין בפרטיות יותר יובן בהקדים מה שאמרו רז\"ל33"
        },
        {
          "s": 2,
          "text": "שאלו לחכמה הנפש החוטאת במה תתכפר34"
        },
        {
          "s": 3,
          "text": "ואמרה הנפש35"
        },
        {
          "s": 4,
          "text": "החוטאת היא תמות36,"
        },
        {
          "s": 5,
          "text": "שאלו לנבואה ואמרה חטאים37"
        },
        {
          "s": 6,
          "text": "תרדף רעה36,"
        },
        {
          "s": 7,
          "text": "שאלו לתורה ואמרה יביא אשם ויתכפר לו,"
        },
        {
          "s": 8,
          "text": "שאלו להקב\"ה ואמר יעשה תשובה ויתכפר לו."
        },
        {
          "s": 9,
          "text": "הדא הוא דכתיב38"
        },
        {
          "s": 10,
          "text": "טוב וישר הוי' על כן יורה חטאים בדרך."
        },
        {
          "s": 11,
          "text": "ויש לומר,"
        },
        {
          "s": 12,
          "text": "דזה שהחכמה אמרה שע\"י מיתה תהי' כפרה לנפש החוטאת הוא לפי שגם החכמה היא למעלה מהאור שמתלבש בעולם."
        },
        {
          "s": 13,
          "text": "שמצד האור שמתלבש בעולם,"
        },
        {
          "s": 14,
          "text": "מכיון שהחטא הוא היפך כוונת בריאת העולם,"
        },
        {
          "s": 15,
          "text": "א\"א להיות כפרה על זה,"
        },
        {
          "s": 16,
          "text": "וזה שמצד החכמה ישנה כפרה לנפש החוטאת הוא כי החכמה היא למעלה מעולם."
        },
        {
          "s": 17,
          "text": "[דהגם שהכוונה בחכמה כאן היא לחכמה תתאה39,"
        },
        {
          "s": 18,
          "text": "חכמה שבמלכות,"
        },
        {
          "s": 19,
          "text": "הרי גם החכמה שבמלכות היא למעלה מהמלכות עצמה]."
        },
        {
          "s": 20,
          "text": "אלא שמצד החכמה,"
        },
        {
          "s": 21,
          "text": "הכפרה היא ע\"י מיתה,"
        },
        {
          "s": 22,
          "text": "פירוד הנפש מהגוף."
        },
        {
          "s": 23,
          "text": "[ויש לומר,"
        },
        {
          "s": 24,
          "text": "שהוא מדה כנגד מדה."
        },
        {
          "s": 25,
          "text": "דענין המצוות הוא להמשיך הוי' באלקים,"
        },
        {
          "s": 26,
          "text": "דאלקים הוא שרש הכלים שהם דוגמת הגוף והאור דהוי' שנמשך בהם הוא דוגמת חיות הנפש שמחי' את הגוף40."
        },
        {
          "s": 27,
          "text": "וכיון שע\"י החטאים גרם שלא יומשך הגילוי דהוי' באלקים,"
        },
        {
          "s": 28,
          "text": "לכן ענשו"
        },
        {
          "s": 29,
          "text": "(שעי\"ז הוא כפרתו)"
        },
        {
          "s": 30,
          "text": "הוא פירוד הנפש מהגוף,"
        },
        {
          "s": 31,
          "text": "מדה כנגד מדה]."
        },
        {
          "s": 32,
          "text": "ומצד הנבואה שהיא בנו\"ה41"
        },
        {
          "s": 33,
          "text": "(למעלה מחכמה תתאה)39,"
        },
        {
          "s": 34,
          "text": "נפש החוטאת מתכפרת גם ע\"י יסורים."
        },
        {
          "s": 35,
          "text": "והחידוש במענה התורה ומכ\"ש במענה הקב\"ה,"
        },
        {
          "s": 36,
          "text": "שהכפרה היא ע\"י קרבן ותשובה,"
        },
        {
          "s": 37,
          "text": "ואין צריך ליסורים."
        },
        {
          "s": 38,
          "text": "והחילוק שבין מענה התורה למענה הקב\"ה,"
        },
        {
          "s": 39,
          "text": "אף שגם מענה התורה יביא אשם ויתכפר לו הו\"ע התשובה"
        },
        {
          "s": 40,
          "text": "(שאז דוקא מכפר הקרבן),"
        },
        {
          "s": 41,
          "text": "מבאר הצ\"צ במאמר הנ\"ל42,"
        },
        {
          "s": 42,
          "text": "שמצד התורה,"
        },
        {
          "s": 43,
          "text": "חכמתו של הקב\"ה,"
        },
        {
          "s": 44,
          "text": "ע\"י התשובה נעשים הזדונות"
        },
        {
          "s": 45,
          "text": "(רק)"
        },
        {
          "s": 46,
          "text": "כשגגות"
        },
        {
          "s": 47,
          "text": "(וע\"י הקרבן מתכפר שוגג זה),"
        },
        {
          "s": 48,
          "text": "ומצד הקב\"ה שלמעלה מתורה,"
        },
        {
          "s": 49,
          "text": "ע\"י התשובה מתכפרים הזדונות,"
        },
        {
          "s": 50,
          "text": "ויתירה מזו,"
        },
        {
          "s": 51,
          "text": "שנהפכים לזכיות."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "וע\"פ המובא לעיל"
        },
        {
          "s": 1,
          "text": "(סעיף ג)"
        },
        {
          "s": 2,
          "text": "דתשובה היא באור אין סוף שלמעלה מהשתלשלות,"
        },
        {
          "s": 3,
          "text": "יש לומר,"
        },
        {
          "s": 4,
          "text": "דהטעם על זה שגם מצד התורה מועלת תשובה"
        },
        {
          "s": 5,
          "text": "(שהזדונות יהיו כשגגות),"
        },
        {
          "s": 6,
          "text": "אף שתורה היא בחכמה"
        },
        {
          "s": 7,
          "text": "(השתלשלות),"
        },
        {
          "s": 8,
          "text": "הוא,"
        },
        {
          "s": 9,
          "text": "כי בחכמה שורה אוא\"ס שלמעלה מהחכמה43,"
        },
        {
          "s": 10,
          "text": "ועד\"ז הוא בנוגע לתורה כמו שנמשכה בהמדות חג\"ת,"
        },
        {
          "s": 11,
          "text": "שהתורה היא בתפארת44,"
        },
        {
          "s": 12,
          "text": "קו האמצעי,"
        },
        {
          "s": 13,
          "text": "ות\"ת עולה עד הכתר."
        },
        {
          "s": 14,
          "text": "אלא שהאור שלמעלה מהשתלשלות שבתורה,"
        },
        {
          "s": 15,
          "text": "כיון שהוא נמשך בהשתלשלות"
        },
        {
          "s": 16,
          "text": "(בחכמה ובת\"ת)"
        },
        {
          "s": 17,
          "text": "הוא במדידה והגבלה."
        },
        {
          "s": 18,
          "text": "ולכן הכח שבתשובה מצד אוא\"ס שבתורה הוא רק שיהיו כשגגות."
        },
        {
          "s": 19,
          "text": "ומענה הקב\"ה הוא המשכת אוא\"ס שלמעלה מהשתלשלות כמו שהוא בעצמותו"
        },
        {
          "s": 20,
          "text": "(שלמעלה מהמשכה בהשתלשלות),"
        },
        {
          "s": 21,
          "text": "דהמשכה זו היא למעלה ממדידה והגבלה."
        },
        {
          "s": 22,
          "text": "ולכן ע\"י התשובה שמצד מענה הקב\"ה מתכפרים הזדונות"
        },
        {
          "s": 23,
          "text": "(ולא רק נעשים כשגגות),"
        },
        {
          "s": 24,
          "text": "ויתירה מזו שנהפכים לזכיות."
        }
      ]
    }
  ]
}