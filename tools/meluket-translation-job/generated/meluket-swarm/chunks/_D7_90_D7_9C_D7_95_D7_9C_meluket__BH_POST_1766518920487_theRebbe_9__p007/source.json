{
  "globalIndex": 1123,
  "owner": 23,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920487_theRebbe_9__p007",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920487_theRebbe_9__p007",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920487_theRebbe_9",
  "title": "מאמר לך אמר לבי תש\"כ",
  "part": 7,
  "sections": [
    {
      "v": 18,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "שעד\"ז הוא בנוגע למלך בשדה"
        },
        {
          "s": 2,
          "text": "(אלול),"
        },
        {
          "s": 3,
          "text": "דהגם שזוהי ירידה לגבי כמו שהוא בהיכל מלכותו"
        },
        {
          "s": 4,
          "text": "(ר\"ה ויוהכ\"פ),"
        },
        {
          "s": 5,
          "text": "דבהיותו בהיכל מלכותו הוא בכתר מלכות ולבושי מלכות משא\"כ בהיותו בשדה,"
        },
        {
          "s": 6,
          "text": "הנה עי\"ז נעשה עלי' כביכול בהמלך65,"
        },
        {
          "s": 7,
          "text": "כי ע\"י ירידתו לשדה נעשה ענין חדש,"
        },
        {
          "s": 8,
          "text": "שגם הרחוקים ביותר באים להקביל את פניו."
        },
        {
          "s": 9,
          "text": "אלא שאעפ\"כ,"
        },
        {
          "s": 10,
          "text": "מכיון שבענין הגילויים,"
        },
        {
          "s": 11,
          "text": "זה שנמצא בשדה הוא ירידה לגבי כמו שהוא בהיכל מלכותו,"
        },
        {
          "s": 12,
          "text": "צריכה להיות העבודה בשדה באופן דללכת"
        },
        {
          "s": 13,
          "text": "(אח\"כ)"
        },
        {
          "s": 14,
          "text": "אחרי המלך להיכל מלכותו66,"
        },
        {
          "s": 15,
          "text": "וכמ\"ש בהמאמר67"
        },
        {
          "s": 16,
          "text": "שהעבודה דאלול היא הקדמה להעבודה דר\"ה ויוהכ\"פ."
        },
        {
          "s": 17,
          "text": "וזהו גם הקשר דשני הפירושים68"
        },
        {
          "s": 18,
          "text": "בלך אמר לבי בקשו פני,"
        },
        {
          "s": 19,
          "text": "שהעבודה דלך אמר לבי להפירוש שלך הוא בשבילך בשליחותך,"
        },
        {
          "s": 20,
          "text": "להשלים רצונו ית' לעשות את המטה דירה לו ית',"
        },
        {
          "s": 21,
          "text": "צריכה להיות באופן שעי\"ז יגיעו להפירוש שלך הוא במקומך,"
        },
        {
          "s": 22,
          "text": "גילוי נקודת היהדות שמקושרת בהעצמות."
        }
      ]
    },
    {
      "v": 19,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ב)"
        },
        {
          "s": 2,
          "text": "וממשיך בהמאמר"
        },
        {
          "s": 3,
          "text": "(בסיום וחותם המאמר),"
        },
        {
          "s": 4,
          "text": "שע\"י התעוררות נקודת הלב נעשה כלי טהורה לקבל השפע ברכה על כל השנה."
        },
        {
          "s": 5,
          "text": "ויש לומר,"
        },
        {
          "s": 6,
          "text": "שבזה ישנם ב' המעלות,"
        },
        {
          "s": 7,
          "text": "המעלה דלך בשליחותך והמעלה דלך במקומך."
        },
        {
          "s": 8,
          "text": "דכאשר המשכת השפע הוא ע\"פ סדר ההשתלשלות,"
        },
        {
          "s": 9,
          "text": "מעיינים בדינו אם הוא ראוי לזה,"
        },
        {
          "s": 10,
          "text": "וישנם מקטריגים שמקטרגים ואומרים שאינו ראוי לזה."
        },
        {
          "s": 11,
          "text": "ויש לומר,"
        },
        {
          "s": 12,
          "text": "דענין זה הוא גם כשההמשכה היא משם הוי'"
        },
        {
          "s": 13,
          "text": "(כיון שגם שם הוי' הוא מקור להתהוות,"
        },
        {
          "s": 14,
          "text": "כנ\"ל סעיף ה),"
        },
        {
          "s": 15,
          "text": "כמ\"ש69"
        },
        {
          "s": 16,
          "text": "ויבואו בני האלקים להתייצב על הוי'."
        },
        {
          "s": 17,
          "text": "וזה שנמשך שפע ברכה"
        },
        {
          "s": 18,
          "text": "(בריבוי מופלג)"
        },
        {
          "s": 19,
          "text": "הוא לפי שע\"י גילוי עצמות נקודת הלב ההמשכה היא מאוא\"ס שלמעלה מהוי',"
        },
        {
          "s": 20,
          "text": "ואין שייך שם הקטרוג דבני האלקים"
        },
        {
          "s": 21,
          "text": "(וכנ\"ל סוף סעיף ו בפירוש הכתוב לא יהי' לך אלקים אחרים על פני),"
        },
        {
          "s": 22,
          "text": "ויתירה מזו,"
        },
        {
          "s": 23,
          "text": "שאין שם גם המדידות וההגבלות דשם אלקים"
        },
        {
          "s": 24,
          "text": "(דקדושה),"
        },
        {
          "s": 25,
          "text": "ולכן השפע שנמשך משם הוא בריבוי מופלג."
        },
        {
          "s": 26,
          "text": "וזה שהמשכת השפע הוא בענינים גשמיים,"
        },
        {
          "s": 27,
          "text": "ומכש\"כ זה שהמשכת השפע הוא לא רק מצד למעלה אלא"
        },
        {
          "s": 28,
          "text": "(כנ\"ל מהמאמר)"
        },
        {
          "s": 29,
          "text": "שהאדם נעשה כלי מתאימה לקבל השפע,"
        },
        {
          "s": 30,
          "text": "הוא לפי שע\"י העבודה בהארת נקודת הלב וחיצוניות הלב לעשות את המטה דירה לו ית',"
        },
        {
          "s": 31,
          "text": "נרגש מעלת הגשמיות"
        },
        {
          "s": 32,
          "text": "(כנ\"ל סעיף י בענין מבשרי אחזה אלוקה)"
        },
        {
          "s": 33,
          "text": "ומעלתן של ישראל העושים את הדירה."
        }
      ]
    },
    {
      "v": 20,
      "items": [
        {
          "s": 0,
          "text": "ומכיון שבהעבודה דאלול ישנם שני הענינים,"
        },
        {
          "s": 1,
          "text": "שהעבודה"
        },
        {
          "s": 2,
          "text": "(עצמה)"
        },
        {
          "s": 3,
          "text": "היא בשדה ובאופן דללכת אחרי המלך להיכל מלכותו"
        },
        {
          "s": 4,
          "text": "(כנ\"ל סעיף יא),"
        },
        {
          "s": 5,
          "text": "לכן,"
        },
        {
          "s": 6,
          "text": "גם בהמשכת השפע שני הענינים,"
        },
        {
          "s": 7,
          "text": "שנמשך רב טוב"
        },
        {
          "s": 8,
          "text": "(במלופם70)"
        },
        {
          "s": 9,
          "text": "שלמעלה ממדידה והגבלה,"
        },
        {
          "s": 10,
          "text": "וזה בא בטוב הנראה והנגלה"
        },
        {
          "s": 11,
          "text": "(גם)"
        },
        {
          "s": 12,
          "text": "בענינים הגשמיים,"
        },
        {
          "s": 13,
          "text": "לשנה טובה ומתוקה,"
        },
        {
          "s": 14,
          "text": "בבני חיי ומזוני כפשוטם,"
        },
        {
          "s": 15,
          "text": "ובכולם – רויחי."
        }
      ]
    }
  ]
}