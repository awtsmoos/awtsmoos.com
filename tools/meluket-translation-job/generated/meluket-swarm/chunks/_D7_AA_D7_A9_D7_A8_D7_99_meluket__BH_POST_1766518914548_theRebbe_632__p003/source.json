{
  "globalIndex": 148,
  "owner": 48,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914548_theRebbe_632__p003",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914548_theRebbe_632__p003",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914548_theRebbe_632",
  "title": "מאמר ביום השמיני תשמ\"א",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה הכוונה בבריאת האדם היא שיהי' באופן דעשה האלקים את האדם ישר35,"
        },
        {
          "s": 2,
          "text": "שילך כל ימיו בדרך הישרה,"
        },
        {
          "s": 3,
          "text": "כדיוק לשון רז\"ל36"
        },
        {
          "s": 4,
          "text": "במי נמלך בנשמותיהן של צדיקים,"
        },
        {
          "s": 5,
          "text": "צדיקים דייקא37."
        },
        {
          "s": 6,
          "text": "ואף שבמקום שבעלי תשובה עומדין אין צדיקים גמורין יכולים לעמוד בו,"
        },
        {
          "s": 7,
          "text": "הרי ידוע38"
        },
        {
          "s": 8,
          "text": "דענין התשובה הוא"
        },
        {
          "s": 9,
          "text": "(לא רק על עבירות,"
        },
        {
          "s": 10,
          "text": "כי אם גם)"
        },
        {
          "s": 11,
          "text": "השבת הנפש למקורה ושרשה,"
        },
        {
          "s": 12,
          "text": "דתשובה זו היא גם בצדיקים גמורים."
        },
        {
          "s": 13,
          "text": "דזה גופא שנשמתו נמצאת למטה ולא במקורה ושרשה,"
        },
        {
          "s": 14,
          "text": "שזהו מקומה האמיתי"
        },
        {
          "s": 15,
          "text": "[ובפרט דזה שהנשמה היא למטה בעוה\"ז,"
        },
        {
          "s": 16,
          "text": "הוא \"בחי' גלות ממש\"39],"
        },
        {
          "s": 17,
          "text": "הרי צריך להשיבה למקומה."
        },
        {
          "s": 18,
          "text": "ומעלת הבעלי תשובה על צדיקים גמורים,"
        },
        {
          "s": 19,
          "text": "דבמקום שבעלי תשובה עומדין אין צדיקים גמורין יכולים לעמוד בו,"
        },
        {
          "s": 20,
          "text": "הוא גם בתשובה זו"
        },
        {
          "s": 21,
          "text": "(דצדיקים)."
        },
        {
          "s": 22,
          "text": "ותכלית ירידת הנשמה לעוה\"ז הגשמי הוא בשביל תשובה זו40."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "והענין הוא,"
        },
        {
          "s": 1,
          "text": "דג' מעלות הנ\"ל שבבעלי תשובה על צדיקים גמורים,"
        },
        {
          "s": 2,
          "text": "הם גם בהנשמה כשנעשית בעל תשובה ע\"י ירידתה למטה לגבי כמו שהיתה קודם הירידה"
        },
        {
          "s": 3,
          "text": "(בחי' צדיק)."
        },
        {
          "s": 4,
          "text": "דמכיון שגם הריחוק שמצד ירידת הנשמה למטה"
        },
        {
          "s": 5,
          "text": "(גם כשלא עבר עבירה מימיו)"
        },
        {
          "s": 6,
          "text": "הוא ריחוק עצום ביותר,"
        },
        {
          "s": 7,
          "text": "ועד שהירידה למטה היא \"בחי' גלות ממש\""
        },
        {
          "s": 8,
          "text": "(כנ\"ל),"
        },
        {
          "s": 9,
          "text": "הרי ריחוק זה מעורר אצלו צמאון גדול,"
        },
        {
          "s": 10,
          "text": "וגם התענוג והשמחה שבקירוב שלאחרי הריחוק הוא תענוג גדול ביותר."
        },
        {
          "s": 11,
          "text": "ועד\"ז הוא בענין החידוש שבתשובה,"
        },
        {
          "s": 12,
          "text": "דמכיון שענין התשובה"
        },
        {
          "s": 13,
          "text": "(גם תשובה דצדיקים)"
        },
        {
          "s": 14,
          "text": "הוא שמתמרמר על מצבו"
        },
        {
          "s": 15,
          "text": "(שהוא מרוחק מאלקות)41"
        },
        {
          "s": 16,
          "text": "ורוצה לצאת ממצבו ומציאותו42,"
        },
        {
          "s": 17,
          "text": "אסורה מכאן43,"
        },
        {
          "s": 18,
          "text": "הרי זה ענין של חידוש."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "אלא שאעפ\"כ,"
        },
        {
          "s": 1,
          "text": "מכיון שי\"ל שאין מרז\"ל זה יוצא מידי פשוטו,"
        },
        {
          "s": 2,
          "text": "הרי זה שאמרו במקום שבעלי תשובה עומדין אין צדיקים גמורין יכולים לעמוד בו,"
        },
        {
          "s": 3,
          "text": "הוא בעיקר בבעלי תשובה כפשוטם44."
        },
        {
          "s": 4,
          "text": "ויש לומר,"
        },
        {
          "s": 5,
          "text": "דזה שעיקר המעלה דבעלי תשובה הוא בבעלי תשובה כפשוטם,"
        },
        {
          "s": 6,
          "text": "הוא במעלת החידוש שבתשובה."
        },
        {
          "s": 7,
          "text": "דבמעלת הצמאון,"
        },
        {
          "s": 8,
          "text": "ובהמעלה דקירוב שלאחרי הריחוק,"
        },
        {
          "s": 9,
          "text": "אין חילוק"
        },
        {
          "s": 10,
          "text": "(כ\"כ)"
        },
        {
          "s": 11,
          "text": "ביניהם,"
        },
        {
          "s": 12,
          "text": "וזה שעיקר העילוי דתשובה הוא בתשובה כפשוטה הוא במעלת החידוש שבתשובה."
        },
        {
          "s": 13,
          "text": "והענין הוא,"
        },
        {
          "s": 14,
          "text": "דבצדיקים,"
        },
        {
          "s": 15,
          "text": "מכיון שנשמתם מאירה אצלם בגילוי,"
        },
        {
          "s": 16,
          "text": "הרי המרירות שלהם על ריחוקם מאלקות,"
        },
        {
          "s": 17,
          "text": "ועד שהמרירות נוגעת עד הנפש,"
        },
        {
          "s": 18,
          "text": "אין זה פלא וחידוש"
        },
        {
          "s": 19,
          "text": "(כ\"כ)."
        },
        {
          "s": 20,
          "text": "והגם דענין התשובה הוא שיוצא ממציאות שלו,"
        },
        {
          "s": 21,
          "text": "מ\"מ,"
        },
        {
          "s": 22,
          "text": "מכיון שהנשמה בטבעה רוצה למלאות רצון קונה,"
        },
        {
          "s": 23,
          "text": "והכוונה שלמעלה"
        },
        {
          "s": 24,
          "text": "(רצון קונה)"
        },
        {
          "s": 25,
          "text": "בירידת הנשמה בגוף היא לבוא לתשובה,"
        },
        {
          "s": 26,
          "text": "הרי בהרצון"
        },
        {
          "s": 27,
          "text": "(שמצד טבע הנשמה)"
        },
        {
          "s": 28,
          "text": "למלאות רצון קונו,"
        },
        {
          "s": 29,
          "text": "נכלל גם היציאה ממציאותו שע\"י התשובה45."
        },
        {
          "s": 30,
          "text": "משא\"כ בתשובה כפשוטה,"
        },
        {
          "s": 31,
          "text": "מכיון שמקודם"
        },
        {
          "s": 32,
          "text": "(לפני התשובה)"
        },
        {
          "s": 33,
          "text": "הי' במצב כזה שלא עשה רצון הקב\"ה46,"
        },
        {
          "s": 34,
          "text": "שהרי עשה עבירות במזיד,"
        },
        {
          "s": 35,
          "text": "הרי זה שעושה אח\"כ תשובה,"
        },
        {
          "s": 36,
          "text": "אין זה המשך ממצבו הקודם,"
        },
        {
          "s": 37,
          "text": "ועל ידי התשובה נעשה מציאות חדשה לגמרי."
        }
      ]
    }
  ]
}