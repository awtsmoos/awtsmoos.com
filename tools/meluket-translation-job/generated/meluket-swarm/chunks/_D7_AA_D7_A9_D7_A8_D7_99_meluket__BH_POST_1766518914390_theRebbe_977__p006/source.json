{
  "globalIndex": 120,
  "owner": 20,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914390_theRebbe_977__p006",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914390_theRebbe_977__p006",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914390_theRebbe_977",
  "title": "מאמר בסוכות תשבו תשכ\"ג",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דבמאמר הזהר וההוא עמיקא דעמיקתא אקרי תשובה,"
        },
        {
          "s": 2,
          "text": "מדבר בענין התשובה המשכת ההחלט שברצון הנעלם וברצון המוחלט שע\"י האתעדל\"ת יתעורר הרצון גלוי,"
        },
        {
          "s": 3,
          "text": "שע\"י התשובה דראש השנה ודעשי\"ת."
        },
        {
          "s": 4,
          "text": "וכיון שההחלט שברצון הנעלם וברצון המוחלט הוא בנוגע לרצון הגלוי,"
        },
        {
          "s": 5,
          "text": "לכן,"
        },
        {
          "s": 6,
          "text": "גם העבודה שעל ידה הוא המשכת ההחלט היא בהדרגא דעצם הנשמה ששייכת לכחות הגלויים,"
        },
        {
          "s": 7,
          "text": "דבכללות הם המקיפים דחי' ויחידה."
        },
        {
          "s": 8,
          "text": "ובהמאמר שיר המעלות סתם כו'"
        },
        {
          "s": 9,
          "text": "(שאין מזכיר שם ענין התשובה)"
        },
        {
          "s": 10,
          "text": "מדבר בענין המשכת רצון המוחלט עצמו"
        },
        {
          "s": 11,
          "text": "(פנימיות ועצמות א\"ס,"
        },
        {
          "s": 12,
          "text": "עיקרא דכל עיקרין),"
        },
        {
          "s": 13,
          "text": "דהמשכה זו היא ע\"י העבודה שמצד עצם הנשמה"
        },
        {
          "s": 14,
          "text": "(פנימיות ועצמות הנפש)."
        },
        {
          "s": 15,
          "text": "וזהו שבמאמר זה"
        },
        {
          "s": 16,
          "text": "(דוקא)"
        },
        {
          "s": 17,
          "text": "אומר שיר המעלות סתם כו' דזמינין כל בני עלמא למימר,"
        },
        {
          "s": 18,
          "text": "כי העבודה שמצד עצם הנשמה היא בכולם בשוה."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "דבראש השנה ויום הכפורים העבודה דממעמקים היא נעלית יותר מהעבודה דממעמקים שבהימים שבין ראש השנה ליום הכפורים."
        },
        {
          "s": 3,
          "text": "דבעשרת ימי תשובה,"
        },
        {
          "s": 4,
          "text": "שענינם הוא"
        },
        {
          "s": 5,
          "text": "(כשמם)"
        },
        {
          "s": 6,
          "text": "ימי תשובה"
        },
        {
          "s": 7,
          "text": "(והענין דתמליכוני עליכם אינו בגילוי כ\"כ בימים אלה),"
        },
        {
          "s": 8,
          "text": "העבודה דממעמקים"
        },
        {
          "s": 9,
          "text": "(שבגילוי)"
        },
        {
          "s": 10,
          "text": "היא"
        },
        {
          "s": 11,
          "text": "(בעיקר)"
        },
        {
          "s": 12,
          "text": "בהעומק דעצם הנשמה ששייכת לכוחות הגלויים,"
        },
        {
          "s": 13,
          "text": "ובראש השנה שעיקר ענינו הוא תמליכוני עליכם"
        },
        {
          "s": 14,
          "text": "[דענין זה הוא בעיקר מצד עצם הנשמה],"
        },
        {
          "s": 15,
          "text": "העבודה דממעמקים היא בהעומק דעצם הנשמה שלמעלה משייכות לכחות הגלויים."
        },
        {
          "s": 16,
          "text": "ועד\"ז ביום הכפורים,"
        },
        {
          "s": 17,
          "text": "דכיון שעיקר ענינו הוא הכפרה שמצד עיצומו של יום,"
        },
        {
          "s": 18,
          "text": "גילוי ההתקשרות העצמית דעצם הנשמה עם העצמות,"
        },
        {
          "s": 19,
          "text": "לכן,"
        },
        {
          "s": 20,
          "text": "גם העבודה דיום הכפורים היא מצד העומק דעצם הנשמה שלמעלה משייכות לכחות הגלויים."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "שהעבודה שמצד העומק דעצם הנשמה ביום הכפורים היא בהתשובה דיום הכפורים,"
        },
        {
          "s": 2,
          "text": "שהיא נעלית יותר מהתשובה דכל ימי השנה וגם מהתשובה דעשרת ימי תשובה39."
        },
        {
          "s": 3,
          "text": "והענין הוא,"
        },
        {
          "s": 4,
          "text": "דבתשובה בכלל,"
        },
        {
          "s": 5,
          "text": "ההתקשרות העצמית דעצם הנשמה עם העצמות היא רק הסיבה שמביאה לתשובה,"
        },
        {
          "s": 6,
          "text": "אבל התשובה עצמה"
        },
        {
          "s": 7,
          "text": "[שענינה הוא חרטה על שעשה היפך הרצון וקבלה לקיים רצונו ית']"
        },
        {
          "s": 8,
          "text": "היא מצד עצם הנשמה ששייכת לכחות הגלויים שמגעת בבעל הרצון,"
        },
        {
          "s": 9,
          "text": "והתשובה דיום הכפורים היא"
        },
        {
          "s": 10,
          "text": "(בעיקר)"
        },
        {
          "s": 11,
          "text": "להיות מקושר עם העצמות,"
        },
        {
          "s": 12,
          "text": "ולכן נרגש בה בגילוי ההתקשרות דעצם הנשמה"
        },
        {
          "s": 13,
          "text": "(שלמעלה משייכות לכחות הגלויים)"
        },
        {
          "s": 14,
          "text": "עם העצמות"
        },
        {
          "s": 15,
          "text": "(שלמעלה מבעל הרצון)40."
        },
        {
          "s": 16,
          "text": "ויש לומר,"
        },
        {
          "s": 17,
          "text": "דזהו מ\"ש הרמב\"ם41"
        },
        {
          "s": 18,
          "text": "שיום הכפורים הוא זמן תשובה לכל,"
        },
        {
          "s": 19,
          "text": "שהכוונה ב\"לכל\" היא"
        },
        {
          "s": 20,
          "text": "(גם)"
        },
        {
          "s": 21,
          "text": "לכל בשוה."
        },
        {
          "s": 22,
          "text": "דבהתשובה שבכל ימי השנה"
        },
        {
          "s": 23,
          "text": "(כולל גם התשובה דעשי\"ת)"
        },
        {
          "s": 24,
          "text": "שהיא מצד הדרגא דעצם הנשמה ששייכת לכחות הגלויים,"
        },
        {
          "s": 25,
          "text": "ישנם כו\"כ חילוקי דרגות."
        },
        {
          "s": 26,
          "text": "והתשובה דיום הכפורים שהיא מצד עצם הנשמה שלמעלה משייכות לכחות הגלויים,"
        },
        {
          "s": 27,
          "text": "היא בכולם בשוה."
        }
      ]
    }
  ]
}