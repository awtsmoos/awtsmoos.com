  "jobId": "_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916188_theRebbe_169__p005",
  "batchId": "meluket-_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916188_theRebbe_169__p005",
  "seriesId": "טבת_meluket",
  "postId": "BH_POST_1766518916188_theRebbe_169",
  "title": "מאמר ויגש אליו יהודה תשל\"ו",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "וזהו הקשר דהגשת יהודה ליוסף לסמיכת גאולה לתפלה,"
        },
        {
          "s": 1,
          "text": "כי בהגשת יהודה ליוסף מודגשת המעלה דמלכות לגבי ז\"א,"
        },
        {
          "s": 2,
          "text": "שע\"י שהז\"א משפיע למלכות מיתוסף עילוי בז\"א."
        },
        {
          "s": 3,
          "text": "וע\"ד גדול תלמוד שמביא לידי מעשה,"
        },
        {
          "s": 4,
          "text": "דעי\"ז נעשה הגדלה בתלמוד."
        },
        {
          "s": 5,
          "text": "ועפ\"ז יובן גם הקשר דויגש אליו יהודה עם ההפטורה דפרשת ויגש שתוכנה הוא שלע\"ל יהי' יהודה למעלה מיוסף,"
        },
        {
          "s": 6,
          "text": "כי העילוי שנעשה בז\"א ע\"י השפעתו למלכות הוא הקדמה לזה ש"
        },
        {
          "s": 7,
          "text": "(לע\"ל)"
        },
        {
          "s": 8,
          "text": "תתגלה מעלת המלכות עצמה,"
        },
        {
          "s": 9,
          "text": "ועבדי דוד מלך עליהם גו' ודוד עבדי נשיא להם לעולם,"
        },
        {
          "s": 10,
          "text": "בביאת משיח צדקנו בקרוב ממש."
        }
      ]
    }
  ]
}