{
  "globalIndex": 739,
  "owner": 39,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918104_theRebbe_982__p002",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918104_theRebbe_982__p002",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518918104_theRebbe_982",
  "title": "מאמר כל ישראל תשל\"ג",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה כתיב16"
        },
        {
          "s": 2,
          "text": "זאת התורה אדם,"
        },
        {
          "s": 3,
          "text": "שהתורה היא בדוגמת אדם."
        },
        {
          "s": 4,
          "text": "דכמו שהאדם מורכב מגוף ונשמה,"
        },
        {
          "s": 5,
          "text": "עד\"ז הוא בתורה שיש בה גוף ונשמה."
        },
        {
          "s": 6,
          "text": "ובכללות הוא החילוק בין תורה למצוות17."
        },
        {
          "s": 7,
          "text": "דרמ\"ח מצוות הם רמ\"ח אברים דמלכא18,"
        },
        {
          "s": 8,
          "text": "ע\"ד אברי הגוף,"
        },
        {
          "s": 9,
          "text": "והתורה היא הדם הוא הנפש19"
        },
        {
          "s": 10,
          "text": "שממשכת חיות בהאברים דהמצוות20."
        },
        {
          "s": 11,
          "text": "וזהו שהמצוות הם בזמן ומקום והתורה היא למעלה מזמן ומקום"
        },
        {
          "s": 12,
          "text": "[שלכן כל העוסק בתורת עולה כאילו הקריב עולה21,"
        },
        {
          "s": 13,
          "text": "גם כשאינו בזמן ומקום ההקרבה]20,"
        },
        {
          "s": 14,
          "text": "כי הגוף שהוא גשמי הוא מוגדר בזמן ומקום,"
        },
        {
          "s": 15,
          "text": "והנשמה שהיא רוחנית היא למעלה מזמן ומקום."
        },
        {
          "s": 16,
          "text": "וכמו שהוא בתורה ומצוות עצמם,"
        },
        {
          "s": 17,
          "text": "עד\"ז הוא בנוגע לשייכותם דהתורה והמצוות להאדם הלומד ומקיים המצוות."
        },
        {
          "s": 18,
          "text": "דלימוד התורה שייך בעיקר להנשמה וקיום המצוות להגוף22."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "והנה ידוע23"
        },
        {
          "s": 1,
          "text": "דזה שהתורה היא למעלה מהמצוות הוא כמו שהתומ\"צ נמשכו בגילוי,"
        },
        {
          "s": 2,
          "text": "אבל בשרשם,"
        },
        {
          "s": 3,
          "text": "המצוות הם נעלים יותר."
        },
        {
          "s": 4,
          "text": "דהתורה היא חכמתו ית' והמצוות הם רצונו ית',"
        },
        {
          "s": 5,
          "text": "רצון שלמעלה מחכמה24."
        },
        {
          "s": 6,
          "text": "ויתירה מזו,"
        },
        {
          "s": 7,
          "text": "דגם לאחרי שהתומ\"צ באו בהמשכה ניכר בגילוי מעלת המצוות,"
        },
        {
          "s": 8,
          "text": "דהתורה היא פירוש וביאור המצוות25."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ומזה מובן,"
        },
        {
          "s": 1,
          "text": "שעד\"ז הוא בנשמה וגוף שבאדם"
        },
        {
          "s": 2,
          "text": "[שהם בדוגמת תורה ומצוות],"
        },
        {
          "s": 3,
          "text": "דהגם שחיות הגוף הוא מהנשמה,"
        },
        {
          "s": 4,
          "text": "שורש הגוף הוא למעלה משורש הנשמה"
        },
        {
          "s": 5,
          "text": "[וכמבואר במק\"א26,"
        },
        {
          "s": 6,
          "text": "שהאהבה וההתקשרות דהקב\"ה לישראל מצד נשמתם,"
        },
        {
          "s": 7,
          "text": "בנים אתם להוי' אלקיכם27,"
        },
        {
          "s": 8,
          "text": "היא כמו אהבה טבעית כביכול,"
        },
        {
          "s": 9,
          "text": "ע\"ד אהבת אב לבנו."
        },
        {
          "s": 10,
          "text": "היינו,"
        },
        {
          "s": 11,
          "text": "ששורש אהבה זו הוא ממדריגה ששייכת שם תפיסת מקום דהנאהב,"
        },
        {
          "s": 12,
          "text": "ואינה מעצמותו ממש."
        },
        {
          "s": 13,
          "text": "משא\"כ האהבה וההתקשרות דהקב\"ה לישראל מצד הגוף שלהם,"
        },
        {
          "s": 14,
          "text": "היא"
        },
        {
          "s": 15,
          "text": "(לא מצד מעלת הגוף,"
        },
        {
          "s": 16,
          "text": "גם לא המעלה דבן,"
        },
        {
          "s": 17,
          "text": "מעלה עצמית,"
        },
        {
          "s": 18,
          "text": "אלא)"
        },
        {
          "s": 19,
          "text": "מצד זה שהקב\"ה בחר בהגוף דישראל28,"
        },
        {
          "s": 20,
          "text": "בבחירה חפשית,"
        },
        {
          "s": 21,
          "text": "שבחירה זו היא מעצמותו]."
        },
        {
          "s": 22,
          "text": "וזה גופא שהנשמה נמשכת להחיות את הגוף הוא מפני העילוי של הגוף מצד שרשו"
        },
        {
          "s": 23,
          "text": "(בדוגמת זה שהתורה מפרשת ומבארת המצוות,"
        },
        {
          "s": 24,
          "text": "מפני שהמצוות הם למעלה מהתורה)."
        }
      ]
    }
  ]
}