{
  "globalIndex": 1034,
  "owner": 34,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919889_theRebbe_263__p003",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919889_theRebbe_263__p003",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919889_theRebbe_263",
  "title": "מאמר והי' עקב תשמעון תשכ\"ז",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ויובן זה ע\"פ המבואר במקום אחר30,"
        },
        {
          "s": 2,
          "text": "דבמעלת הבעלי תשובה על צדיקים גמורים,"
        },
        {
          "s": 3,
          "text": "שני ענינים."
        },
        {
          "s": 4,
          "text": "א',"
        },
        {
          "s": 5,
          "text": "שע\"י התשובה מתגלה תוקף ההתקשרות של נשמתו עם הקב\"ה,"
        },
        {
          "s": 6,
          "text": "שגם ההבדלה שנעשה ע\"י החטאים"
        },
        {
          "s": 7,
          "text": "(עוונותיכם מבדילים31)"
        },
        {
          "s": 8,
          "text": "הוא רק בהגילויים ולא בעצם הנשמה,"
        },
        {
          "s": 9,
          "text": "שלכן,"
        },
        {
          "s": 10,
          "text": "גם לאחרי החטאים וכו',"
        },
        {
          "s": 11,
          "text": "בשעתא חדא וברגעא חדא32,"
        },
        {
          "s": 12,
          "text": "נעשה צדיק גמור33."
        },
        {
          "s": 13,
          "text": "דעילוי זה שבבע\"ת לגבי צדיק הוא זה שבבע\"ת מתגלה תוקף ההתקשרות בהנשמה שישנו"
        },
        {
          "s": 14,
          "text": "(בהעלם)"
        },
        {
          "s": 15,
          "text": "גם בצדיק."
        },
        {
          "s": 16,
          "text": "וב',"
        },
        {
          "s": 17,
          "text": "דע\"י התשובה באופן שזדונות נהפכים לזכיות34,"
        },
        {
          "s": 18,
          "text": "מיתוסף בו עילוי חדש שאינו בצדיקים גם בהעלם,"
        },
        {
          "s": 19,
          "text": "כידוע35"
        },
        {
          "s": 20,
          "text": "שזכיות אלו נעלים יותר מזכיות דצדיקים."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ועד\"ז הוא גם בהעילוי דתשובה שנעשה בהנשמה ע\"י ירידתה למטה,"
        },
        {
          "s": 1,
          "text": "וכידוע36"
        },
        {
          "s": 2,
          "text": "שהנשמות קודם ירידתם למטה הם בבחי' צדיקים גמורים והיתרון שנעשה בהם ע\"י ירידתם בגוף הוא שנעשים בבחי' בעלי תשובה,"
        },
        {
          "s": 3,
          "text": "שיש בזה דוגמת שני ענינים הנ\"ל."
        },
        {
          "s": 4,
          "text": "א',"
        },
        {
          "s": 5,
          "text": "דע\"י שהגוף ונה\"ב מעלימים ומסתירים על אור הנשמה,"
        },
        {
          "s": 6,
          "text": "עי\"ז מתעוררים כחות הנעלמים שלה,"
        },
        {
          "s": 7,
          "text": "ועד לכחות העצמיים שלמעלה גם מכחות הנעלמים37."
        },
        {
          "s": 8,
          "text": "וב',"
        },
        {
          "s": 9,
          "text": "שע\"י עבודת הנשמה למטה נעשה ענין חדש,"
        },
        {
          "s": 10,
          "text": "הבירור והזיכוך דגוף ודנה\"ב וחלקו בעולם."
        },
        {
          "s": 11,
          "text": "דענין זה מכיון שהוא התחדשות"
        },
        {
          "s": 12,
          "text": "(ולא גילוי ההעלם)"
        },
        {
          "s": 13,
          "text": "הוא נעלה יותר מגילוי כחות הנעלמים דהנשמה"
        },
        {
          "s": 14,
          "text": "[נוסף שעי\"ז דוקא"
        },
        {
          "s": 15,
          "text": "(בירור וזיכוך הגוף וכו')"
        },
        {
          "s": 16,
          "text": "נשלמת הכוונה דירידת הנשמה למטה ודדירה בתחתונים38]."
        },
        {
          "s": 17,
          "text": "ומכיון דגם עילוי זה"
        },
        {
          "s": 18,
          "text": "(החידוש דזיכוך הגוף ודנה\"ב וחלקו בעולם)"
        },
        {
          "s": 19,
          "text": "נעשה ע\"י עבודת הנשמה,"
        },
        {
          "s": 20,
          "text": "לכן,"
        },
        {
          "s": 21,
          "text": "גם העלי' דהנשמה שע\"י עבודתה למטה היא"
        },
        {
          "s": 22,
          "text": "(לא רק שמתגלים כחות הפנימיים והעצמיים שלה,"
        },
        {
          "s": 23,
          "text": "אלא)"
        },
        {
          "s": 24,
          "text": "באופן דהתחדשות."
        },
        {
          "s": 25,
          "text": "וכמבואר בכ\"מ39"
        },
        {
          "s": 26,
          "text": "בענין היתרון דאהבת ה' שנה\"א פועלת בנה\"ב על האהבה דנפש האלקית,"
        },
        {
          "s": 27,
          "text": "שהאהבה דנה\"א,"
        },
        {
          "s": 28,
          "text": "היא בבחי' מציאות."
        },
        {
          "s": 29,
          "text": "דגם האהבה דהנשמה מה שהיא רוצה לידבק בשרשה ומקורה הגם שתהי' אין ואפס ותתבטל שם במציאות לגמרי40,"
        },
        {
          "s": 30,
          "text": "מ\"מ,"
        },
        {
          "s": 31,
          "text": "מכיון שרצון זה הוא מצד טבעה,"
        },
        {
          "s": 32,
          "text": "הרי ע\"י רצון זה אינה בטלה צורתה העצמית."
        },
        {
          "s": 33,
          "text": "משא\"כ האהבה דנה\"ב,"
        },
        {
          "s": 34,
          "text": "מכיון שבטבעה היא נמשכת לענינים גשמיים,"
        },
        {
          "s": 35,
          "text": "והאהבה לאלקות היא היפך טבעה41,"
        },
        {
          "s": 36,
          "text": "הרי ע\"י האהבה לאלקות"
        },
        {
          "s": 37,
          "text": "(שנתחדש בה ע\"י העבודה דנה\"א),"
        },
        {
          "s": 38,
          "text": "נפסד צורתה ובטלה לגמרי,"
        },
        {
          "s": 39,
          "text": "ביטול המציאות."
        },
        {
          "s": 40,
          "text": "וזה פועל גם ביטול הצורה דנה\"א42,"
        },
        {
          "s": 41,
          "text": "שהאהבה שלה תהי' בבחי' ביטול43,"
        },
        {
          "s": 42,
          "text": "לא מצד הטבע ומציאות דהאוהב"
        },
        {
          "s": 43,
          "text": "(נשמה),"
        },
        {
          "s": 44,
          "text": "כי אם,"
        },
        {
          "s": 45,
          "text": "אהבה מצד הנאהב"
        },
        {
          "s": 46,
          "text": "(אלקות)."
        },
        {
          "s": 47,
          "text": "ועד\"ז הוא בהבירור והזיכוך דחלקו בעולם,"
        },
        {
          "s": 48,
          "text": "דכיון שזה פועל שעניני העולם יהיו כלים לאלקות,"
        },
        {
          "s": 49,
          "text": "הו\"ע של התחדשות,"
        },
        {
          "s": 50,
          "text": "היפך הטבע דעולם מלשון העלם והסתר44,"
        },
        {
          "s": 51,
          "text": "הרי ענין זה"
        },
        {
          "s": 52,
          "text": "(שהעולם נעשה כלי לאלקות)"
        },
        {
          "s": 53,
          "text": "הוא לא מצד העולם כ\"א מצד האלקות,"
        },
        {
          "s": 54,
          "text": "מצד זה שאחדותו ית' אין לה כל הגבלה,"
        },
        {
          "s": 55,
          "text": "עד שגם המציאות דעולם מיוחד עמו ית'45,"
        },
        {
          "s": 56,
          "text": "ועי\"ז נעשה גם בהאדם"
        },
        {
          "s": 57,
          "text": "(שפעל הבירור וזיכוך דחלקו בעולם)"
        },
        {
          "s": 58,
          "text": "שעבודתו את קונו תהי' בתכלית הביטול,"
        },
        {
          "s": 59,
          "text": "לא רק מצד מציאותו של האדם אלא מצד האלקות46."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "וע\"פ הנ\"ל יש לבאר גם גודל העילוי של אלו שזכו למס\"נ בפו\"מ על קידוש השם47"
        },
        {
          "s": 2,
          "text": "[ולהעיר מהמפורסם \"ברבים\" שאאמו\"ר בעל ההילולא נאסר והוגלה לעיירה נדחת במדינה רחוקה עבור עבודתו בהחזקת והפצת היהדות וסבל שם"
        },
        {
          "s": 3,
          "text": "(בהמאסר ולאח\"כ בהיותו בגלות48)"
        },
        {
          "s": 4,
          "text": "יסורים ועינויים קשים וכו' וכו',"
        },
        {
          "s": 5,
          "text": "ועד שיסורים ועינויים אלו גרמו"
        },
        {
          "s": 6,
          "text": "(ע\"פ טבע)"
        },
        {
          "s": 7,
          "text": "שנפטר לפני זמנו],"
        },
        {
          "s": 8,
          "text": "דלכאורה צ\"ע,"
        },
        {
          "s": 9,
          "text": "הרי ענין המס\"נ הוא דבר טבעי אצל כל אחד מישראל שאי אפשר כלל לכפור בה' אחד ומוכן למסור נפשו על זה וסובלים עינויים כו'49"
        },
        {
          "s": 10,
          "text": "(וזה שלא הי' להם מס\"נ בפועל,"
        },
        {
          "s": 11,
          "text": "הוא מפני שלא הוצרכו לזה),"
        },
        {
          "s": 12,
          "text": "ומהו גודל העילוי כ\"כ דאלו שהי' להם מס\"נ בפועל."
        },
        {
          "s": 13,
          "text": "וביותר צ\"ע מה שאמר ר\"ע50"
        },
        {
          "s": 14,
          "text": "כל ימי הייתי מצטער על פסוק זה51"
        },
        {
          "s": 15,
          "text": "בכל נפשך כו' מתי יבוא לידי ואקיימנו,"
        },
        {
          "s": 16,
          "text": "דלכאורה,"
        },
        {
          "s": 17,
          "text": "זה גופא שכל ימיו השתוקק בפועל לקיים פסוק זה,"
        },
        {
          "s": 18,
          "text": "ה\"ז גילוי כח המס\"נ שלו שהאיר אצלו,"
        },
        {
          "s": 19,
          "text": "ומה חסר כ\"כ בענין המס\"נ שלו"
        },
        {
          "s": 20,
          "text": "(כל זמן שזה לא בא לידי פועל,"
        },
        {
          "s": 21,
          "text": "מצד סיבה שאינה תלוי' בו)"
        },
        {
          "s": 22,
          "text": "עד שהצטער על זה."
        },
        {
          "s": 23,
          "text": "וי\"ל הביאור בזה52,"
        },
        {
          "s": 24,
          "text": "דזה מה שכ\"א מישראל מוכן למסור נפשו שלא לכפור ח\"ו הוא מצד הנשמה,"
        },
        {
          "s": 25,
          "text": "וגם כשמעורר את כח המס\"נ שלו בגילוי"
        },
        {
          "s": 26,
          "text": "(שאם יצטרך לזה ח\"ו,"
        },
        {
          "s": 27,
          "text": "ימסור את נפשו בפועל),"
        },
        {
          "s": 28,
          "text": "הוא שכח המס\"נ דהנשמה בא בגילוי."
        },
        {
          "s": 29,
          "text": "והמס\"נ דהנשמה הוא מצד הטבע שלה,"
        },
        {
          "s": 30,
          "text": "ואין בזה חידוש."
        },
        {
          "s": 31,
          "text": "משא\"כ במס\"נ בפו\"מ נתחדש ענין שלא הי' מקודם."
        },
        {
          "s": 32,
          "text": "דנוסף שזה בא ע\"י ההעלם וההסתר וההתנגדות של אלו המכריחים אותו לכפור ח\"ו,"
        },
        {
          "s": 33,
          "text": "וע\"י שמוסר נפשו ומסכים לסבול מהם הוא מוציא את הניצוצות שבהם ומעלה אותם לקדושה53,"
        },
        {
          "s": 34,
          "text": "דענין זה"
        },
        {
          "s": 35,
          "text": "(העלאת הניצוצות שנפלו למטה כ\"כ)"
        },
        {
          "s": 36,
          "text": "הוא חידוש54,"
        },
        {
          "s": 37,
          "text": "הנה החידוש במס\"נ בפועל הוא גם בנוגע להאדם שעומד במס\"נ,"
        },
        {
          "s": 38,
          "text": "כי כשמוסר נפשו בפועל ממש,"
        },
        {
          "s": 39,
          "text": "אזי,"
        },
        {
          "s": 40,
          "text": "המס\"נ היא"
        },
        {
          "s": 41,
          "text": "(גם)"
        },
        {
          "s": 42,
          "text": "בנפש הטבעית."
        },
        {
          "s": 43,
          "text": "דלא רק שאין מניעה מצדה למס\"נ אלא שהיא רוצה למסור נפשה בפו\"מ55."
        },
        {
          "s": 44,
          "text": "ומכיון שנפש הטבעית"
        },
        {
          "s": 45,
          "text": "(מצד עצמה)"
        },
        {
          "s": 46,
          "text": "רוצה לחיות,"
        },
        {
          "s": 47,
          "text": "הרי המס\"נ שנפעל בה"
        },
        {
          "s": 48,
          "text": "(ע\"י נפש האלקית)"
        },
        {
          "s": 49,
          "text": "הוא התחדשות והיפך טבעה."
        },
        {
          "s": 50,
          "text": "וזהו גודל העילוי שבמס\"נ בפועל ממש דוקא,"
        },
        {
          "s": 51,
          "text": "דהמס\"נ שמצד הנשמה,"
        },
        {
          "s": 52,
          "text": "מכיון שהיא מצד טבעה,"
        },
        {
          "s": 53,
          "text": "ה\"ז בחי' מציאות,"
        },
        {
          "s": 54,
          "text": "משא\"כ המס\"נ בפו\"מ,"
        },
        {
          "s": 55,
          "text": "מכיון שהיא היפך הטבע דנפש הטבעית,"
        },
        {
          "s": 56,
          "text": "הרי ע\"י המס\"נ שלה היא מתבטלת ממציאותה,"
        },
        {
          "s": 57,
          "text": "ועי\"ז נעשה עלי' גם בנפש האלקית"
        },
        {
          "s": 58,
          "text": "(שפעלה המס\"נ בנה\"ט),"
        },
        {
          "s": 59,
          "text": "שגם המס\"נ שלה היא בבחי' ביטול."
        }
      ]
    }
  ]
}