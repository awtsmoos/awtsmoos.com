{
  "globalIndex": 1042,
  "owner": 42,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919939_theRebbe_869__p001",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919939_theRebbe_869__p001",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919939_theRebbe_869",
  "title": "מאמר ועתה ישראל תשכ\"ח",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ עקב,"
        },
        {
          "s": 2,
          "text": "מבה\"ח אלול,"
        },
        {
          "s": 3,
          "text": "כ\"ג מנחם-אב ה'תשכ\"ח"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "ועתה ישראל מה הוי' אלקיך שואל מעמך כי אם ליראה גו'1,"
        },
        {
          "s": 1,
          "text": "ואיתא בגמרא2"
        },
        {
          "s": 2,
          "text": "חייב אדם לברך מאה ברכות בכל יום שנאמר ועתה ישראל מה ה' אלקיך שואל מעמך,"
        },
        {
          "s": 3,
          "text": "אל תקרי מה אלא מאה3."
        },
        {
          "s": 4,
          "text": "וצריך להבין,"
        },
        {
          "s": 5,
          "text": "הרי מה ומאה הם שני ענינים שונים,"
        },
        {
          "s": 6,
          "text": "ויתירה מזו,"
        },
        {
          "s": 7,
          "text": "שהם הפכים,"
        },
        {
          "s": 8,
          "text": "דלשון מה מורה שהענין"
        },
        {
          "s": 9,
          "text": "(המדובר)"
        },
        {
          "s": 10,
          "text": "הוא דבר קטן4,"
        },
        {
          "s": 11,
          "text": "ומאה הוא5"
        },
        {
          "s": 12,
          "text": "מספר גדול ועד לשלימות המספר6"
        },
        {
          "s": 13,
          "text": "[ובפרט לפי המבואר בחסידות7,"
        },
        {
          "s": 14,
          "text": "דזה שניתוסף,"
        },
        {
          "s": 15,
          "text": "במאה על מה הוא אות אל\"ף אותיות פלא,"
        },
        {
          "s": 16,
          "text": "אור הסובב שלמעלה מהשתלשלות]."
        },
        {
          "s": 17,
          "text": "גם צריך להבין מ\"ש הטור8"
        },
        {
          "s": 18,
          "text": "בשם רב נטרונאי גאון,"
        },
        {
          "s": 19,
          "text": "דזה שצריך לברך מאה ברכות בכל יום הוא תקנת דוד המלך,"
        },
        {
          "s": 20,
          "text": "כמ\"ש9"
        },
        {
          "s": 21,
          "text": "נאום הגבר הוקם על,"
        },
        {
          "s": 22,
          "text": "על בגימטריא ק',"
        },
        {
          "s": 23,
          "text": "והדרשה אל תקרי מה אלא מאה היא אסמכתא10."
        },
        {
          "s": 24,
          "text": "והטעם שתיקן דוד לברך מאה ברכות הוא"
        },
        {
          "s": 25,
          "text": "(כמ\"ש הטור שם)"
        },
        {
          "s": 26,
          "text": "כי בכל יום היו מתים מאה נפשות מישראל ולא היו יודעים על מה היו מתים עד שחקר והבין ברוח הקודש ותיקן מאה ברכות בכל יום."
        },
        {
          "s": 27,
          "text": "וצריך להבין,"
        },
        {
          "s": 28,
          "text": "דמזה שהחיוב לברך מאה ברכות בכל יום למדו"
        },
        {
          "s": 29,
          "text": "(באופן דאסמכתא)"
        },
        {
          "s": 30,
          "text": "מהכתוב מה ה' אלקיך שואל מעמך שנאמר בו"
        },
        {
          "s": 31,
          "text": "(בהמשך הפסוק)"
        },
        {
          "s": 32,
          "text": "ליראה את ה' אלקיך גו' ולאהבה אותו,"
        },
        {
          "s": 33,
          "text": "מובן,"
        },
        {
          "s": 34,
          "text": "שבכדי לבוא ליראה את ה' ולאהבה אותו הוא ע\"י מאה ברכות11,"
        },
        {
          "s": 35,
          "text": "ואעפ\"כ במשך כו\"כ דורות"
        },
        {
          "s": 36,
          "text": "(כל זמן שלא מתו בכל יום מאה נפשות)"
        },
        {
          "s": 37,
          "text": "לא תיקנו לברך מאה ברכות בכל יום."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויובן זה ע\"פ המבואר בהדרושים המבארים ענין הברכות12"
        },
        {
          "s": 2,
          "text": "בפירוש הכתוב13"
        },
        {
          "s": 3,
          "text": "ברוך גו' מן העולם ועד העולם,"
        },
        {
          "s": 4,
          "text": "דענין הברכה הוא המשכה מעלמא דאתכסיא לעלמא דאתגליא,"
        },
        {
          "s": 5,
          "text": "דבענין הספירות הוא ההמשכה מבינה"
        },
        {
          "s": 6,
          "text": "(עלמא דאתכסיא)"
        },
        {
          "s": 7,
          "text": "למלכות"
        },
        {
          "s": 8,
          "text": "(עלמא דאתגליא)."
        },
        {
          "s": 9,
          "text": "ובענין השמות הוא המשכת הוי' דלעילא בהוי' דלתתא."
        },
        {
          "s": 10,
          "text": "והשייכות דבינה ומלכות לב' השמות הוי' הוא,"
        },
        {
          "s": 11,
          "text": "כי הוי' דלעילא הוא סובב,"
        },
        {
          "s": 12,
          "text": "ובבינה הוא גילוי הכתר"
        },
        {
          "s": 13,
          "text": "(סובב),"
        },
        {
          "s": 14,
          "text": "והוי' דלתתא הוא ממלא,"
        },
        {
          "s": 15,
          "text": "ז\"א שמאיר במלכות."
        },
        {
          "s": 16,
          "text": "וענין הברכה הוא המשכת גילוי הוי' דלעילא בהוי' דלתתא."
        },
        {
          "s": 17,
          "text": "ומבואר בהדרושים,"
        },
        {
          "s": 18,
          "text": "שהמשכת הוי' דלעילא בהוי' דלתתא שנעשית ע\"י הברכה היא באופן שב' השמות מתחברים יחד."
        },
        {
          "s": 19,
          "text": "והגם דהוי' הוי' פסיק טעמא בגווייהו14,"
        },
        {
          "s": 20,
          "text": "הפסיק טעמא אינו הפסק גמור"
        },
        {
          "s": 21,
          "text": "(כשאר הפרסאות),"
        },
        {
          "s": 22,
          "text": "ויתירה מזו איתא בפרדס15"
        },
        {
          "s": 23,
          "text": "שהפסיק טעמא שבין ב' השמות הוי' הוא מיחדם ומחברם,"
        },
        {
          "s": 24,
          "text": "ע\"י הברכה,"
        },
        {
          "s": 25,
          "text": "החיבור דב' השמות הוא חיבור ויחוד גמור."
        }
      ]
    }
  ]
}