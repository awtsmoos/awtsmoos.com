  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915265_theRebbe_887__p001",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915265_theRebbe_887__p001",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915265_theRebbe_887",
  "title": "מאמר אתה אחד תשכ\"ט",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ ויצא,"
        },
        {
          "s": 2,
          "text": "ט' כסלו,"
        },
        {
          "s": 3,
          "text": "ה'תשכ\"ט"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "אתה אחד1"
        },
        {
          "s": 1,
          "text": "ושמך אחד ומי כעמך כישראל2"
        },
        {
          "s": 2,
          "text": "גוי אחד בארץ,"
        },
        {
          "s": 3,
          "text": "ומדייק כ\"ק מו\"ח אדמו\"ר במאמרו ד\"ה זה דט' כסלו3,"
        },
        {
          "s": 4,
          "text": "דלשון אחד הוא גם באחד המנוי"
        },
        {
          "s": 5,
          "text": "[וכמו ויהי ערב ויהי בוקר יום אחד4"
        },
        {
          "s": 6,
          "text": "ואח\"כ5"
        },
        {
          "s": 7,
          "text": "כתיב יום שני יום שלישי וכו'],"
        },
        {
          "s": 8,
          "text": "וכיון שהוא ית' הוא יחיד ומיוחד שאין בדומה אליו וכן ישראל הם גוי אחד יחיד ומיוחד שאין דוגמתם,"
        },
        {
          "s": 9,
          "text": "הול\"ל אתה יחיד ושמך יחיד ומי כעמך כישראל גוי יחיד."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 1,
          "text": "דזה שישראל הם גוי יחיד הוא בדוגמת אב ואם שאין להם אלא בן אחד בלבד שנקרא בשם בן יחיד."
        },
        {
          "s": 2,
          "text": "דאהבת ההורים לבנם כשיש להם רק בן יחיד היא אהבה גדולה יותר מאהבת ההורים לבניהם כשיש להם עוד ילדים."
        },
        {
          "s": 3,
          "text": "וכן אהבת הבן יחיד להורים היא גדולה יותר מכשהם יותר מבן יחיד."
        },
        {
          "s": 4,
          "text": "וכן הוא גם בישראל,"
        },
        {
          "s": 5,
          "text": "מכיון שישראל הם בן יחיד ליחידו של עולם,"
        },
        {
          "s": 6,
          "text": "לכן,"
        },
        {
          "s": 7,
          "text": "האהבה דהקב\"ה לישראל,"
        },
        {
          "s": 8,
          "text": "וכן אהבת ישראל להקב\"ה,"
        },
        {
          "s": 9,
          "text": "היא אהבה גדולה ביותר."
        },
        {
          "s": 10,
          "text": "ומסיים שם,"
        },
        {
          "s": 11,
          "text": "שעפ\"ז צריך להבין מה שנאמר ומי כעמך כישראל גוי אחד ולא גוי יחיד."
        }
      ]
    }
  ]
}