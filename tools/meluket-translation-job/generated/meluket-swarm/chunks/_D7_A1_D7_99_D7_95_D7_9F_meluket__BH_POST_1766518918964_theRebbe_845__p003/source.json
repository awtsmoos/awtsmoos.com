{
  "globalIndex": 879,
  "owner": 29,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918964_theRebbe_845__p003",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918964_theRebbe_845__p003",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918964_theRebbe_845",
  "title": "מאמר והנה פרח מטה אהרן תשל\"ג",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "והנה הסדר דשלשה לבושי הנפש הוא מחשבה דיבור ומעשה23."
        },
        {
          "s": 1,
          "text": "ובכדי שתהי' ההמשכה מהשכל"
        },
        {
          "s": 2,
          "text": "(או מהמדות)"
        },
        {
          "s": 3,
          "text": "למעשה הוא ע\"י המחשבה והדיבור24."
        },
        {
          "s": 4,
          "text": "והמחשבה שעל ידה נמשך ל"
        },
        {
          "s": 5,
          "text": "(הדיבור ו)"
        },
        {
          "s": 6,
          "text": "המעשה היא שחושב איך לעשות."
        },
        {
          "s": 7,
          "text": "וכיון שמחשבה זו היא נפרדת מהשכל"
        },
        {
          "s": 8,
          "text": "[שהמחשבה שהיתה אצלו תחלה,"
        },
        {
          "s": 9,
          "text": "כשדן בשכלו והחליט שראוי לעשות,"
        },
        {
          "s": 10,
          "text": "היתה בטילה להשכל"
        },
        {
          "s": 11,
          "text": "(לדיון השכל ולהחלטתו),"
        },
        {
          "s": 12,
          "text": "וענינה של המחשבה הוא רק שעל ידה נרגש השכל."
        },
        {
          "s": 13,
          "text": "משא\"כ המחשבה איך לעשות הוא מהות בפ\"ע שנפרד מהשכל],"
        },
        {
          "s": 14,
          "text": "לכן,"
        },
        {
          "s": 15,
          "text": "ההמשכה25"
        },
        {
          "s": 16,
          "text": "מהחלטת השכל להמחשבה לעשות היא ע\"י עיכוב,"
        },
        {
          "s": 17,
          "text": "בשני ענינים הנ\"ל."
        },
        {
          "s": 18,
          "text": "שהחלטת השכל אינה מחייבת את המחשבה,"
        },
        {
          "s": 19,
          "text": "ויתירה מזו,"
        },
        {
          "s": 20,
          "text": "שבכדי להמשיך הענין במחשבה,"
        },
        {
          "s": 21,
          "text": "צריך לדון עוד פעם."
        },
        {
          "s": 22,
          "text": "ועד\"ז הוא בההמשכה ממחשבה לדיבור,"
        },
        {
          "s": 23,
          "text": "דכיון שהדיבור הוא למטה ממחשבה,"
        },
        {
          "s": 24,
          "text": "דמחשבה היא לעצמו והדיבור הוא לזולתו,"
        },
        {
          "s": 25,
          "text": "לכן,"
        },
        {
          "s": 26,
          "text": "ההמשכה שממחשבה לדיבור היא ע\"י עיכוב."
        },
        {
          "s": 27,
          "text": "וגם בזה שני ענינים הנ\"ל."
        },
        {
          "s": 28,
          "text": "דהמחשבה"
        },
        {
          "s": 29,
          "text": "(מצד עצמה)"
        },
        {
          "s": 30,
          "text": "אינה מחייבת את הדיבור,"
        },
        {
          "s": 31,
          "text": "שאפשר שישאר הענין במחשבתו ולא יחשוב אפילו אם לדבר בזה,"
        },
        {
          "s": 32,
          "text": "ויתירה מזו,"
        },
        {
          "s": 33,
          "text": "שבנוגע לדיבור"
        },
        {
          "s": 34,
          "text": "(גם כשחושב אם לדבר)"
        },
        {
          "s": 35,
          "text": "יש אצלו ספק והוא צריך להתייעץ ולדון על זה."
        },
        {
          "s": 36,
          "text": "דכיון שמחשבה היא לעצמו ודיבור הוא לזולתו,"
        },
        {
          "s": 37,
          "text": "לכן,"
        },
        {
          "s": 38,
          "text": "גם לאחרי שהחליט בנוגע למחשבה,"
        },
        {
          "s": 39,
          "text": "הוא מסופק עדיין אם להביא זה גם בדיבור,"
        },
        {
          "s": 40,
          "text": "לגלות לזולתו."
        },
        {
          "s": 41,
          "text": "ועד\"ז הוא בההמשכה מדיבור למעשה,"
        },
        {
          "s": 42,
          "text": "דכיון שהמעשה נפרד יותר מהדיבור,"
        },
        {
          "s": 43,
          "text": "לכן ההמשכה מדיבור למעשה היא ע\"י עיכוב,"
        },
        {
          "s": 44,
          "text": "בשני ענינים הנ\"ל."
        },
        {
          "s": 45,
          "text": "שהדיבור אינו מחייב את המעשה,"
        },
        {
          "s": 46,
          "text": "ושבכדי להמשיך מדיבור למעשה,"
        },
        {
          "s": 47,
          "text": "צריך להתייעץ ולדון עוד פעם."
        },
        {
          "s": 48,
          "text": "וע\"פ הידוע26"
        },
        {
          "s": 49,
          "text": "שמחשבה ודיבור שייכים זל\"ז,"
        },
        {
          "s": 50,
          "text": "דאותם האותיות שהיו תחלה במחשבה נמשכים אח\"כ בדיבור,"
        },
        {
          "s": 51,
          "text": "משא\"כ המעשה הוא ענין בפ\"ע,"
        },
        {
          "s": 52,
          "text": "יש לומר,"
        },
        {
          "s": 53,
          "text": "שהעיכוב בההמשכה מדיבור למעשה"
        },
        {
          "s": 54,
          "text": "(בנוגע לשני ענינים הנ\"ל)"
        },
        {
          "s": 55,
          "text": "הוא עיכוב גדול יותר מהעיכוב בההמשכה ממחשבה לדיבור."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ועד\"ז הוא בהנמשל למעלה,"
        },
        {
          "s": 2,
          "text": "דהדין ומשפט שבר\"ה ויוהכ\"פ הוא המשכת החסד במלכות דאצילות"
        },
        {
          "s": 3,
          "text": "(כנ\"ל סעיף ב),"
        },
        {
          "s": 4,
          "text": "וידוע27"
        },
        {
          "s": 5,
          "text": "שאצילות ובי\"ע הם דוגמת כחות הפנימיים"
        },
        {
          "s": 6,
          "text": "(שכל ומדות)"
        },
        {
          "s": 7,
          "text": "וג' הלבושים מחשבה דיבור ומעשה,"
        },
        {
          "s": 8,
          "text": "ולכן,"
        },
        {
          "s": 9,
          "text": "אף שהדין ומשפט שבר\"ה ויוהכ\"פ הוא בנוגע לההשפעה בעוה\"ז הגשמי,"
        },
        {
          "s": 10,
          "text": "מ\"מ,"
        },
        {
          "s": 11,
          "text": "כיון שכללות האצילות"
        },
        {
          "s": 12,
          "text": "(גם המלכות דאצילות)"
        },
        {
          "s": 13,
          "text": "הוא דוגמת כחות הפנימיים שלמעלה ממחדומ\"ע,"
        },
        {
          "s": 14,
          "text": "הכתיבה וחתימה טובה שבר\"ה ויוהכ\"פ שיומשך שפע גשמי היא דוגמת החלטת השכל שראוי הדבר לעשותו,"
        },
        {
          "s": 15,
          "text": "שהמעשה"
        },
        {
          "s": 16,
          "text": "(כמו שהוא בהחלטת השכל)"
        },
        {
          "s": 17,
          "text": "כלול בהשכל,"
        },
        {
          "s": 18,
          "text": "ובכדי שתומשך ההשפעה בעולם העשי'"
        },
        {
          "s": 19,
          "text": "[ובפרט בעוה\"ז הגשמי]"
        },
        {
          "s": 20,
          "text": "צריכה להיות תחלה ההמשכה בעולם המחשבה"
        },
        {
          "s": 21,
          "text": "(בריאה)"
        },
        {
          "s": 22,
          "text": "ועולם הדיבור"
        },
        {
          "s": 23,
          "text": "(יצירה)."
        },
        {
          "s": 24,
          "text": "וההמשכה ממלכות דאצילות לבריאה,"
        },
        {
          "s": 25,
          "text": "ועד\"ז מבריאה ליצירה,"
        },
        {
          "s": 26,
          "text": "ומכש\"כ מיצירה לעשי',"
        },
        {
          "s": 27,
          "text": "הוא ע\"י עיכוב,"
        },
        {
          "s": 28,
          "text": "בשני ענינים הנ\"ל,"
        },
        {
          "s": 29,
          "text": "כנ\"ל."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש לבאר,"
        },
        {
          "s": 1,
          "text": "שיכול להיות שהשפע שנקצב בר\"ה ויוהכ\"פ יומשך ברוחניות ועד שאפשר שההמשכה ברוחניות תהי' בג\"ע,"
        },
        {
          "s": 2,
          "text": "אף שהדין דר\"ה ויוהכ\"פ הוא בנוגע להשפעה גשמית,"
        },
        {
          "s": 3,
          "text": "כי באצילות,"
        },
        {
          "s": 4,
          "text": "ועד\"ז בבריאה ויצירה,"
        },
        {
          "s": 5,
          "text": "גם ענינים הגשמיים שדנים עליהם הם כלולים ברוחניות,"
        },
        {
          "s": 6,
          "text": "בדוגמת המעשה שבהחלטת השכל,"
        },
        {
          "s": 7,
          "text": "ועד\"ז במחשבה ודיבור,"
        },
        {
          "s": 8,
          "text": "שהמעשה כלול בהשכל."
        },
        {
          "s": 9,
          "text": "וזהו גם שבכל יום יש דין ומשפט באיזה ענין יומשך החסד,"
        },
        {
          "s": 10,
          "text": "אף שהדין ומשפט שבר\"ה ויוהכ\"פ הוא בנוגע לכל הפרטים,"
        },
        {
          "s": 11,
          "text": "כי הענינים דעשי' כמו שהם בשרשם באצילות,"
        },
        {
          "s": 12,
          "text": "ועד\"ז בבריאה ויצירה,"
        },
        {
          "s": 13,
          "text": "הם מופשטים מציור גשמי,"
        },
        {
          "s": 14,
          "text": "ולכן,"
        },
        {
          "s": 15,
          "text": "יש דין ומשפט באיזה אופן תצטייר ההשפעה בגשמיות."
        }
      ]
    }
  ]
}