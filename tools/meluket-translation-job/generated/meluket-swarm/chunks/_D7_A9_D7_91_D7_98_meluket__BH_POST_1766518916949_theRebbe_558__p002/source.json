{
  "globalIndex": 555,
  "owner": 5,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916949_theRebbe_558__p002",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916949_theRebbe_558__p002",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916949_theRebbe_558",
  "title": "מאמר באתי לגני תש\"מ",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה מכיון שהתורה היא נצחית12,"
        },
        {
          "s": 2,
          "text": "הרי מובן,"
        },
        {
          "s": 3,
          "text": "שענין זה"
        },
        {
          "s": 4,
          "text": "(ועשו לי מקדש ושכנתי בתוכם)"
        },
        {
          "s": 5,
          "text": "הוא נצחי במשך כל הדורות,"
        },
        {
          "s": 6,
          "text": "גם בזמן הגלות,"
        },
        {
          "s": 7,
          "text": "כאשר מפני חטאינו גלינו מארצנו ונתרחקנו מעל אדמתנו,"
        },
        {
          "s": 8,
          "text": "שגם אז ישנם"
        },
        {
          "s": 9,
          "text": "(ברוחניות)"
        },
        {
          "s": 10,
          "text": "כל ההוראות והמצוות"
        },
        {
          "s": 11,
          "text": "(דכתיב בהו וחי בהם13)"
        },
        {
          "s": 12,
          "text": "התלויות במשכן ומקדש."
        },
        {
          "s": 13,
          "text": "ועד\"ז הוא גם בנוגע לכל הפרטים שהיו ביציאת מצרים,"
        },
        {
          "s": 14,
          "text": "וגם לפנ\"ז בגלות מצרים,"
        },
        {
          "s": 15,
          "text": "שהם הוראות נצחיות בכל דור ודור,"
        },
        {
          "s": 16,
          "text": "עד היום הזה."
        },
        {
          "s": 17,
          "text": "וכמו שידוע14"
        },
        {
          "s": 18,
          "text": "בענין וימררו את חייהם בעבודה קשה בחומר ובלבנים גו'15,"
        },
        {
          "s": 19,
          "text": "שגם עכשיו בגלות האחרון ישנה העבודה בחומר ובלבנים"
        },
        {
          "s": 20,
          "text": "(כמו שהיא ברוחניות),"
        },
        {
          "s": 21,
          "text": "בחומר דא ק\"ו ובלבנים דא לבון הלכתא16,"
        },
        {
          "s": 22,
          "text": "ועי\"ז יזכו אח\"כ לגאולה העתידה,"
        },
        {
          "s": 23,
          "text": "בדוגמת הגאולה דיציאת מצרים"
        },
        {
          "s": 24,
          "text": "(לאחרי העבודה קשה בחומר ובלבנים גו'),"
        },
        {
          "s": 25,
          "text": "ובני ישראל יוצאים ביד רמה17."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה גודל העילוי דעסק התורה בזמן הגלות,"
        },
        {
          "s": 2,
          "text": "מבאר בעל ההילולא בסעיף העשירי"
        },
        {
          "s": 3,
          "text": "[העשירי יהי' קודש18]"
        },
        {
          "s": 4,
          "text": "דהמשך המאמרים דיום ההילולא,"
        },
        {
          "s": 5,
          "text": "שסעיף זה הוא הסיום והחותם של מאמר השני דההמשך,"
        },
        {
          "s": 6,
          "text": "ד\"ה היושבת בגנים חברים מקשיבים לקולך השמיעני19"
        },
        {
          "s": 7,
          "text": "(ע\"פ פרש\"י על הפסוק),"
        },
        {
          "s": 8,
          "text": "אמר הקב\"ה לכנסת ישראל את הפזורה בגולה ורועה בגנים של אחרים כו' ובכ\"ז יושבת בבתי כנסיות ובתי מדרשות לעסוק בתורה,"
        },
        {
          "s": 9,
          "text": "הנה החברים שהם מלאכי השרת"
        },
        {
          "s": 10,
          "text": "(וגם הקב\"ה,"
        },
        {
          "s": 11,
          "text": "כביכול20)"
        },
        {
          "s": 12,
          "text": "מקשיבים לקולך."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 1,
          "text": "דעש\"ז נקראים ישראל צבאות הוי' כמ\"ש21"
        },
        {
          "s": 2,
          "text": "ויהי בעצם היום הזה יצאו כל צבאות הוי' מארץ מצרים."
        },
        {
          "s": 3,
          "text": "דשם זה"
        },
        {
          "s": 4,
          "text": "(צבאות הוי')"
        },
        {
          "s": 5,
          "text": "ניתן לישראל ביציאתם ממצרים דוקא22."
        },
        {
          "s": 6,
          "text": "ויש לבאר קישור הענינים,"
        },
        {
          "s": 7,
          "text": "כי מה שבזמן יציאת מצרים נקראו ישראל צבאות הוי' הוא מצד הניצוצות"
        },
        {
          "s": 8,
          "text": "(הצבאות)"
        },
        {
          "s": 9,
          "text": "שנתבררו בגלות מצרים"
        },
        {
          "s": 10,
          "text": "(כמשי\"ת לקמן23)."
        },
        {
          "s": 11,
          "text": "וזהו הקשר דענין מה שישראל נקראים צבאות הוי' לענין היושבת בגנים,"
        },
        {
          "s": 12,
          "text": "כי ע\"י העבודה דכנס\"י בעסק התורה וקיום מצוותי' כשהיא פזורה בגולה ורועה בגנים של אחרים,"
        },
        {
          "s": 13,
          "text": "עי\"ז מבררים את הניצוצות שבגלות,"
        },
        {
          "s": 14,
          "text": "בדוגמת וינצלו24"
        },
        {
          "s": 15,
          "text": "את מצרים."
        }
      ]
    }
  ]
}