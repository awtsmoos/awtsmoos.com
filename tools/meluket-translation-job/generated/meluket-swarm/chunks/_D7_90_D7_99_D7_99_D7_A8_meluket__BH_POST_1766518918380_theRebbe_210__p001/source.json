{
  "globalIndex": 774,
  "owner": 24,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918380_theRebbe_210__p001",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918380_theRebbe_210__p001",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918380_theRebbe_210",
  "title": "מאמר דבר אל..קדושים תהיו תשכ\"א",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ אחרי-קדושים,"
        },
        {
          "s": 2,
          "text": "י\"ג אייר ה'תשכ\"א*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "– בבוקר לפני התפלה,"
        },
        {
          "s": 1,
          "text": "בחדרו –"
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "דבר אל כל עדת בני ישראל גו' קדושים תהיו כי קדוש אני1,"
        },
        {
          "s": 1,
          "text": "ואיתא במדרש2"
        },
        {
          "s": 2,
          "text": "יכול כמוני,"
        },
        {
          "s": 3,
          "text": "תלמוד לומר כי קדוש אני,"
        },
        {
          "s": 4,
          "text": "קדושתי למעלה מקדושתכם,"
        },
        {
          "s": 5,
          "text": "וצריך להבין3"
        },
        {
          "s": 6,
          "text": "איך שייך אפילו קס\"ד שיהיו כמוני."
        },
        {
          "s": 7,
          "text": "ולכאורה יש לומר,"
        },
        {
          "s": 8,
          "text": "דהטעם להקס\"ד יכול כמוני"
        },
        {
          "s": 9,
          "text": "(אף שנברא הוא באין ערוך לבורא)"
        },
        {
          "s": 10,
          "text": "הוא,"
        },
        {
          "s": 11,
          "text": "כי מלשון הכתוב קדושים תהיו כי קדוש אני"
        },
        {
          "s": 12,
          "text": "(שקדוש אני הוא הטעם וההסברה על קדושים תהיו)"
        },
        {
          "s": 13,
          "text": "משמע,"
        },
        {
          "s": 14,
          "text": "שהציווי קדושים תהיו הוא שקדושתם של ישראל צריכה להיות בדומה לקדושתו ית' – יכול כמוני"
        },
        {
          "s": 15,
          "text": "[ויש לומר ההסברה בזה,"
        },
        {
          "s": 16,
          "text": "דכיון שישראל וקוב\"ה כולא חד4,"
        },
        {
          "s": 17,
          "text": "לכן שייכים ישראל לכל הענינים דלמעלה]."
        },
        {
          "s": 18,
          "text": "אבל עפ\"ז צריך להבין"
        },
        {
          "s": 19,
          "text": "(לאידך גיסא)"
        },
        {
          "s": 20,
          "text": "מסקנת המדרש קדושתי למעלה מקדושתכם,"
        },
        {
          "s": 21,
          "text": "איך זה מתאים עם לשון הכתוב כי קדוש אני."
        },
        {
          "s": 22,
          "text": "ומבואר בלקו\"ת5,"
        },
        {
          "s": 23,
          "text": "דקדושתכם היא הקדושה שנמשכת ע\"י אתערותא דלתתא"
        },
        {
          "s": 24,
          "text": "(מעשה המצוות),"
        },
        {
          "s": 25,
          "text": "וקדושתי שלמעלה מקדושתכם היא קדושה נעלית ביותר שאין אתערותא דלתתא"
        },
        {
          "s": 26,
          "text": "(דמעשה המצוות)"
        },
        {
          "s": 27,
          "text": "מגעת שם,"
        },
        {
          "s": 28,
          "text": "ונמשכת ע\"י התשובה."
        },
        {
          "s": 29,
          "text": "וצריך ביאור,"
        },
        {
          "s": 30,
          "text": "הרי גם תשובה היא עבודת האדם,"
        },
        {
          "s": 31,
          "text": "אתערותא דלתתא,"
        },
        {
          "s": 32,
          "text": "ולמה נקראת קדושתי שלמעלה מקדושתכם."
        }
      ]
    }
  ]
}