{
  "globalIndex": 579,
  "owner": 29,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917075_theRebbe_40__p001",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917075_theRebbe_40__p001",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518917075_theRebbe_40",
  "title": "מאמר באתי לגני תשל\"ח",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "יום ב' פ' יתרו,"
        },
        {
          "s": 2,
          "text": "ט\"ו בשבט,"
        },
        {
          "s": 3,
          "text": "ה'תשל\"ח*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "באתי לגני אחותי כלה1,"
        },
        {
          "s": 1,
          "text": "ומביא כ\"ק מו\"ח אדמו\"ר"
        },
        {
          "s": 2,
          "text": "[בעל ההילולא דיו\"ד שבט,"
        },
        {
          "s": 3,
          "text": "שהשלימות דכל ימי החודש היא ביום הט\"ו,"
        },
        {
          "s": 4,
          "text": "שבו קיימא סיהרא באשלמותא2]"
        },
        {
          "s": 5,
          "text": "במאמרו הידוע ד\"ה זה3,"
        },
        {
          "s": 6,
          "text": "דאיתא במדרש4"
        },
        {
          "s": 7,
          "text": "דפירוש באתי לגני הוא המשכת וירידת עיקר שכינה למטה בארץ."
        },
        {
          "s": 8,
          "text": "ועיקר המשכה זו היתה כשהוקם המשכן,"
        },
        {
          "s": 9,
          "text": "כדאיתא במדרש שם ואימת שרתה שכינה עלי'"
        },
        {
          "s": 10,
          "text": "(בארץ)"
        },
        {
          "s": 11,
          "text": "ביום שהוקם המשכן."
        },
        {
          "s": 12,
          "text": "וכמ\"ש5"
        },
        {
          "s": 13,
          "text": "ועשו לי מקדש"
        },
        {
          "s": 14,
          "text": "(ואז)"
        },
        {
          "s": 15,
          "text": "ושכנתי בתוכם."
        },
        {
          "s": 16,
          "text": "והגם שגם במתן תורה היתה המשכת וירידת השכינה למטה בארץ כמ\"ש6"
        },
        {
          "s": 17,
          "text": "וירד הוי' על הר סיני,"
        },
        {
          "s": 18,
          "text": "יש לומר7,"
        },
        {
          "s": 19,
          "text": "שעיקר הענין דהמשכת וירידת השכינה למטה בארץ הוא כשההמשכה למטה היא בפנימיות"
        },
        {
          "s": 20,
          "text": "(באופן שהמטה מזדכך ומתעלה עי\"ז8),"
        },
        {
          "s": 21,
          "text": "שזהו דוקא כשההמשכה היא ע\"י עבודת המטה,"
        },
        {
          "s": 22,
          "text": "ולכן אומר שעיקר המשכת השכינה בארץ הי' כשהוקם המשכן,"
        },
        {
          "s": 23,
          "text": "כי ההמשכה שהיתה במתן תורה היתה מצד למעלה,"
        },
        {
          "s": 24,
          "text": "שלכן הי' הגילוי לפי שעה,"
        },
        {
          "s": 25,
          "text": "והעילוי דהמשכת השכינה במשכן היא שההמשכה"
        },
        {
          "s": 26,
          "text": "(ושכנתי בתוכם)"
        },
        {
          "s": 27,
          "text": "היא ע\"י עבודה ועשי',"
        },
        {
          "s": 28,
          "text": "ועשו לי מקדש."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ויש להוסיף,"
        },
        {
          "s": 1,
          "text": "דמעלת ההמשכה במשכן ומקדש"
        },
        {
          "s": 2,
          "text": "(על ההמשכה שהיתה במתן תורה)"
        },
        {
          "s": 3,
          "text": "היא לא רק מצד זה שההמשכה היא ע\"י עבודה"
        },
        {
          "s": 4,
          "text": "(בכלל),"
        },
        {
          "s": 5,
          "text": "אלא גם מצד זה שהעבודה דועשו לי מקדש היא העבודה דאתכפיא ואתהפכא"
        },
        {
          "s": 6,
          "text": "(הפיכת השטות דלעו\"ז לשטות דקדושה)9."
        },
        {
          "s": 7,
          "text": "דגם בהמשכה שבאה ע\"י עבודה,"
        },
        {
          "s": 8,
          "text": "ההמשכה שע\"י העבודה דאתכפיא ואתהפכא היא נעלית יותר מההמשכה שע\"י עבודה בעניני קדושה10,"
        },
        {
          "s": 9,
          "text": "כי יתרון האור הוא מן החושך דוקא,"
        },
        {
          "s": 10,
          "text": "דע\"י שהחושך נהפך לאור נעשה יתרון בהאור,"
        },
        {
          "s": 11,
          "text": "כמבואר בארוכה בהמאמר11."
        }
      ]
    }
  ]
}