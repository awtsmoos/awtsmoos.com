{
  "globalIndex": 892,
  "owner": 42,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919103_theRebbe_196__p002",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919103_theRebbe_196__p002",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919103_theRebbe_196",
  "title": "מאמר השם נפשנו בחיים תשח\"י",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ויש להוסיף,"
        },
        {
          "s": 1,
          "text": "דשני ענינים אלו שבואתפלג קרח"
        },
        {
          "s": 2,
          "text": "(מחלוקת,"
        },
        {
          "s": 3,
          "text": "וזה שחלק על אהרן)"
        },
        {
          "s": 4,
          "text": "שייכים זה לזה."
        },
        {
          "s": 5,
          "text": "דהנה זה שבריאת המחלוקת"
        },
        {
          "s": 6,
          "text": "(רקיע המבדיל)"
        },
        {
          "s": 7,
          "text": "היתה ביום השני דוקא הוא,"
        },
        {
          "s": 8,
          "text": "כי יום הראשון הוא מדת החסד"
        },
        {
          "s": 9,
          "text": "(ימין)"
        },
        {
          "s": 10,
          "text": "ויום השני הוא מדת הגבורה"
        },
        {
          "s": 11,
          "text": "(שמאל),"
        },
        {
          "s": 12,
          "text": "ומצד הגבורה יש נתינת מקום למחלוקת12."
        },
        {
          "s": 13,
          "text": "וכדאיתא בזהר שם ימינא איהו שלימא דכולא כו' בי' תליא כל שלימו,"
        },
        {
          "s": 14,
          "text": "כד אתער שמאלא אתער מחלוקת."
        },
        {
          "s": 15,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 16,
          "text": "שעיקר ענינו של קרח הוא מחלוקת"
        },
        {
          "s": 17,
          "text": "[כמובן גם מזה שארז\"ל13"
        },
        {
          "s": 18,
          "text": "כל המחזיק במחלוקת עובר בלאו14"
        },
        {
          "s": 19,
          "text": "שנאמר15"
        },
        {
          "s": 20,
          "text": "ולא יהי' כקרח וכעדתו,"
        },
        {
          "s": 21,
          "text": "דמזה שהמחזיק במחלוקת"
        },
        {
          "s": 22,
          "text": "(איזו מחלוקת שתהי')"
        },
        {
          "s": 23,
          "text": "הוא כקרח ועדתו,"
        },
        {
          "s": 24,
          "text": "מוכח,"
        },
        {
          "s": 25,
          "text": "שעיקר ענינו של קרח הוא מחלוקת],"
        },
        {
          "s": 26,
          "text": "וזה שחלק על אהרן"
        },
        {
          "s": 27,
          "text": "(חסד)"
        },
        {
          "s": 28,
          "text": "ורצה לעשות הגבורות עיקר16,"
        },
        {
          "s": 29,
          "text": "הוא שעי\"ז יהי' חיזוק למחלוקת."
        },
        {
          "s": 30,
          "text": "וצריך להבין,"
        },
        {
          "s": 31,
          "text": "הרי קרח פיקח הי'17,"
        },
        {
          "s": 32,
          "text": "ומסתבר לומר שהמחלוקת שלו על כהונת אהרן היתה מפני שטעה בדרכי העבודה18,"
        },
        {
          "s": 33,
          "text": "ואינו מובן,"
        },
        {
          "s": 34,
          "text": "למה רצה במחלוקת."
        },
        {
          "s": 35,
          "text": "דזה שחלק על אהרן,"
        },
        {
          "s": 36,
          "text": "אפשר לבאר,"
        },
        {
          "s": 37,
          "text": "שקרח סבר שעבודת ה' צריכה להיות בקו הגבורה,"
        },
        {
          "s": 38,
          "text": "ולכן חלק על אהרן שהיתה עבודתו בקו החסד."
        },
        {
          "s": 39,
          "text": "אבל לפי הנ\"ל דזה שקרח רצה לעשות הגבורות עיקר הוא בכדי שיהי' חיזוק למחלוקת,"
        },
        {
          "s": 40,
          "text": "אינו מובן,"
        },
        {
          "s": 41,
          "text": "האיך חשב קרח שמחלוקת הוא דרך בעבודת ה'."
        },
        {
          "s": 42,
          "text": "וגם צריך להבין מה שמתרגם ואתפלג קרח,"
        },
        {
          "s": 43,
          "text": "דואתפלג הוא ע\"ד רקיע המבדיל,"
        },
        {
          "s": 44,
          "text": "דלכאורה,"
        },
        {
          "s": 45,
          "text": "הרי גם שמו של קרח עצמו רומז על רקיע המבדיל19,"
        },
        {
          "s": 46,
          "text": "כמ\"ש הצ\"צ עה\"פ ויקח קרח8"
        },
        {
          "s": 47,
          "text": "שקרח רומז על רקיע המבדיל כמ\"ש20"
        },
        {
          "s": 48,
          "text": "רקיע כעין הקרח,"
        },
        {
          "s": 49,
          "text": "ומהי ההוספה דואתפלג קרח."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים הידוע בענין רקיע המבדיל בין מים למים21,"
        },
        {
          "s": 2,
          "text": "דמים הם תענוג,"
        },
        {
          "s": 3,
          "text": "דזה שהמים מצמיחים כל מיני תענוג22"
        },
        {
          "s": 4,
          "text": "הוא לפי שבהם יש ענין התענוג23."
        },
        {
          "s": 5,
          "text": "והרקיע המבדיל בין מים עליונים למים תחתונים היא הפרסא שעל ידה נעשית ההבדלה בין התענוגים בענינים הרוחניים"
        },
        {
          "s": 6,
          "text": "(מים עליונים)"
        },
        {
          "s": 7,
          "text": "ותענוגי עוה\"ז"
        },
        {
          "s": 8,
          "text": "(מים תחתונים)."
        },
        {
          "s": 9,
          "text": "והכוונה ברקיע המבדיל בין מים עליונים למים תחתונים היא בכדי שעי\"ז יתעלו מים התחתונים למעלה יותר מכמו שהיו קודם ירידתם."
        },
        {
          "s": 10,
          "text": "דע\"י ירידתם למטה,"
        },
        {
          "s": 11,
          "text": "נעשה בהם התשוקה והצמאון לעלות למעלה,"
        },
        {
          "s": 12,
          "text": "מים תחתונים בוכין אנן בעינן למהוי קמי' מלכא24,"
        },
        {
          "s": 13,
          "text": "ועי\"ז הם מתעלים למעלה יותר מכמו שהיו קודם ירידתם,"
        },
        {
          "s": 14,
          "text": "ולמעלה יותר גם ממים העליונים."
        },
        {
          "s": 15,
          "text": "וזהו מה שארז\"ל25"
        },
        {
          "s": 16,
          "text": "דזה שביום השלישי נאמר שני פעמים כי טוב הוא אחד למלאכת המים ואחד למלאכתו של יום,"
        },
        {
          "s": 17,
          "text": "דלכאורה,"
        },
        {
          "s": 18,
          "text": "הרי מלאכת המים הו\"ע של מחלוקת ואיך נאמר על זה כי טוב."
        },
        {
          "s": 19,
          "text": "והביאור בזה,"
        },
        {
          "s": 20,
          "text": "שע\"י עבודת האדם נעשה הבירור והעלי' דמים התחתונים26,"
        },
        {
          "s": 21,
          "text": "ולכן,"
        },
        {
          "s": 22,
          "text": "ביום השלישי כשהי' יקוו המים מתחת השמים אל מקום אחד ותראה היבשה27,"
        },
        {
          "s": 23,
          "text": "דיבשה היא מקומו של האדם,"
        },
        {
          "s": 24,
          "text": "נשלמה הכוונה דמלאכת המים,"
        },
        {
          "s": 25,
          "text": "שע\"י הבדלת מים התחתונים ממים העליונים וירידתם למטה הם מתעלים למעלה יותר מכמו שהיו קודם ירידתם,"
        },
        {
          "s": 26,
          "text": "ואז"
        },
        {
          "s": 27,
          "text": "(לאחרי שנעשית האפשריות דעלי' זו),"
        },
        {
          "s": 28,
          "text": "גם מלאכת המים היא טוב."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יובן מה שקרח רצה במחלוקת,"
        },
        {
          "s": 2,
          "text": "כי קרח חשב שהכוונה בזה שמים התחתונים נבדלו ממים העליונים וירדו למטה הוא בשביל המעלה שישנה בהתענוגים הגשמיים עצמם,"
        },
        {
          "s": 3,
          "text": "דשרש הגשמיות הוא למעלה יותר משרש הרוחניות."
        },
        {
          "s": 4,
          "text": "[וע\"ד המבואר בתו\"א28"
        },
        {
          "s": 5,
          "text": "דבעולמות העליונים נאמר29"
        },
        {
          "s": 6,
          "text": "מה גדלו מעשיך,"
        },
        {
          "s": 7,
          "text": "וענין מה רבו מעשיך30"
        },
        {
          "s": 8,
          "text": "הוא בעולמות התחתונים דוקא,"
        },
        {
          "s": 9,
          "text": "וענין הריבוי מורה על השלימות דא\"ס,"
        },
        {
          "s": 10,
          "text": "שעם היותו יחיד,"
        },
        {
          "s": 11,
          "text": "הוא נושא גם ריבוי פרטים31]."
        },
        {
          "s": 12,
          "text": "ולכן רצה שהגבורות יהיו העיקר,"
        },
        {
          "s": 13,
          "text": "כי זה שמים התחתונים בוכין אנן בעינן למהוי קמי' מלכא הוא מפני שנרגש בהם העילוי דענין הגילויים"
        },
        {
          "s": 14,
          "text": "(חסד,"
        },
        {
          "s": 15,
          "text": "ימין),"
        },
        {
          "s": 16,
          "text": "וכיון שהגילויים הם בעיקר בעולמות העליונים,"
        },
        {
          "s": 17,
          "text": "לכן מים התחתונים"
        },
        {
          "s": 18,
          "text": "(שאין בהם גילויים)"
        },
        {
          "s": 19,
          "text": "רוצים לצאת ממציאותם ולעלות למעלה."
        },
        {
          "s": 20,
          "text": "אבל לפי טעותו של קרח שהכוונה היא בתענוגים הגשמיים עצמם,"
        },
        {
          "s": 21,
          "text": "שיתגלה בהם שרש הגשמיות,"
        },
        {
          "s": 22,
          "text": "הרי אדרבא,"
        },
        {
          "s": 23,
          "text": "עיקר המעלה היא בהצמצומים והגבורות,"
        },
        {
          "s": 24,
          "text": "שמהם מתהוים הדברים הגשמיים32."
        },
        {
          "s": 25,
          "text": "אבל קרח טעה בזה,"
        },
        {
          "s": 26,
          "text": "כי גילוי השרש דמים התחתונים"
        },
        {
          "s": 27,
          "text": "(גשמיים)"
        },
        {
          "s": 28,
          "text": "עצמם יהי' לע\"ל,"
        },
        {
          "s": 29,
          "text": "ובכדי שיהי' גילוי השרש דמים התחתונים עצמם,"
        },
        {
          "s": 30,
          "text": "צריך להיות בהם תחלה ההרגש דמעלת הגילויים,"
        },
        {
          "s": 31,
          "text": "שע\"י הרגש זה יש בהם הצמאון והתשוקה לעלות למעלה,"
        },
        {
          "s": 32,
          "text": "ועי\"ז יהי' גילוי השרש דמים התחתונים עצמם33."
        },
        {
          "s": 33,
          "text": "וזהו שלא נאמר כי טוב במלאכת המים עד ליום השלישי,"
        },
        {
          "s": 34,
          "text": "אף שישנה מעלה גם במלאכת המים כמו שהיתה ביום השני,"
        },
        {
          "s": 35,
          "text": "בזה שנבדלו מים התחתונים ממים העליונים וירדו למטה,"
        },
        {
          "s": 36,
          "text": "כי הגילוי דמעלה זו יהי' רק לע\"ל,"
        },
        {
          "s": 37,
          "text": "ועכשיו,"
        },
        {
          "s": 38,
          "text": "הכוונה בירידת המים למטה היא בכדי שיעלו למעלה"
        },
        {
          "s": 39,
          "text": "(כנ\"ל),"
        },
        {
          "s": 40,
          "text": "דענין זה נעשה ביום השלישי דוקא."
        },
        {
          "s": 41,
          "text": "ועד\"ז הוא בכללות הענין דגילוי"
        },
        {
          "s": 42,
          "text": "(שרש החסד)"
        },
        {
          "s": 43,
          "text": "וצמצום"
        },
        {
          "s": 44,
          "text": "(שרש הגבורה),"
        },
        {
          "s": 45,
          "text": "דהמעלה שבהצמצום עצמו יתגלה רק לע\"ל,"
        },
        {
          "s": 46,
          "text": "והכוונה בהצמצום כמו שהוא עכשיו הוא בשביל הגילוי34."
        }
      ]
    }
  ]
}