{
  "globalIndex": 997,
  "owner": 47,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919710_theRebbe_549__p002",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919710_theRebbe_549__p002",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919710_theRebbe_549",
  "title": "מאמר ציון במשפט תפדה תשל\"ו",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים שבכדי שבכל יום יהיו בעיניך כחדשים הוא ע\"י גילוי בחינה שלמעלה משינויים."
        },
        {
          "s": 2,
          "text": "ומכיון שגדר עולם הוא"
        },
        {
          "s": 3,
          "text": "(מקום ו)"
        },
        {
          "s": 4,
          "text": "זמן19,"
        },
        {
          "s": 5,
          "text": "שזמן הוא שינוי,"
        },
        {
          "s": 6,
          "text": "לכן,"
        },
        {
          "s": 7,
          "text": "בכדי שבכל יום יהיו בעיניך כחדשים הוא ע\"י הגילוי דאוא\"ס שלמעלה מהתלבשות בעולמות,"
        },
        {
          "s": 8,
          "text": "אור הסובב20."
        },
        {
          "s": 9,
          "text": "דהאור המתלבש בעולמות,"
        },
        {
          "s": 10,
          "text": "אור הממלא,"
        },
        {
          "s": 11,
          "text": "הוא בא בציור מוגבל להחיות את הנבראים לפי ערכם."
        },
        {
          "s": 12,
          "text": "וכמרז\"ל21"
        },
        {
          "s": 13,
          "text": "מה הנפש ממלאה את הגוף כך הקב\"ה ממלא את עולמו,"
        },
        {
          "s": 14,
          "text": "דכמו שחיות הנפש המתלבש בהגוף הוא לפי אופן אברי הגוף,"
        },
        {
          "s": 15,
          "text": "דבכל אבר החיות הוא לפי ערכו,"
        },
        {
          "s": 16,
          "text": "עד\"ז הוא בהחיות דהעולם שנמשך בו אור הממלא"
        },
        {
          "s": 17,
          "text": "(זה שהקב\"ה ממלא את עולמו),"
        },
        {
          "s": 18,
          "text": "שהחיות דכל נברא הוא לפי ערכו22."
        },
        {
          "s": 19,
          "text": "ומזה מובן במכ\"ש23"
        },
        {
          "s": 20,
          "text": "בנוגע לגדר העולם בכללותו"
        },
        {
          "s": 21,
          "text": "(מקום וזמן),"
        },
        {
          "s": 22,
          "text": "שמצד אור הממלא,"
        },
        {
          "s": 23,
          "text": "א\"א שיהי' בהעולם ענין שלמעלה מזמן ומקום."
        },
        {
          "s": 24,
          "text": "והגם שגם האור שמתלבש בעולם אינו נתפס בגדרי העולם,"
        },
        {
          "s": 25,
          "text": "וכמ\"ש24"
        },
        {
          "s": 26,
          "text": "אין קדוש כהוי' ואיתא בזהר25"
        },
        {
          "s": 27,
          "text": "כמה קדישין אינון ולית קדוש כהוי',"
        },
        {
          "s": 28,
          "text": "דהחידוש בקדוש הוי' הוא שהגם שהוא מלובש26"
        },
        {
          "s": 29,
          "text": "בהנבראים27"
        },
        {
          "s": 30,
          "text": "ומחי' אותם"
        },
        {
          "s": 31,
          "text": "(בפנימיותם)"
        },
        {
          "s": 32,
          "text": "מ\"מ הוא קדוש ומובדל מהם ואינו נתפס בהם"
        },
        {
          "s": 33,
          "text": "[וי\"ל דזהו פירוש הוא מקומו של עולם ואין העולם מקומו28,"
        },
        {
          "s": 34,
          "text": "דהוא מקומו של עולם קאי על אור הממלא29,"
        },
        {
          "s": 35,
          "text": "שהוא מחי' את העולם,"
        },
        {
          "s": 36,
          "text": "ואעפ\"כ אין העולם מקומו,"
        },
        {
          "s": 37,
          "text": "שאינו נתפס בזה30],"
        },
        {
          "s": 38,
          "text": "הנה זה שהאור נשאר בפשיטותו"
        },
        {
          "s": 39,
          "text": "(גם לאחרי שמתלבש בהעולם)"
        },
        {
          "s": 40,
          "text": "הוא בנוגע להאור,"
        },
        {
          "s": 41,
          "text": "אבל בנוגע להעולם,"
        },
        {
          "s": 42,
          "text": "החיות דהעולם המתלבש הוא מדוד ומוגבל בגדרי העולם."
        },
        {
          "s": 43,
          "text": "ולכן,"
        },
        {
          "s": 44,
          "text": "בכדי שבכל יום יהיו בעיניך כחדשים"
        },
        {
          "s": 45,
          "text": "(ענין שלמעלה מזמן)"
        },
        {
          "s": 46,
          "text": "הוא ע\"י גילוי אור הסובב."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה מכיון שגדר העולם הוא מקום וזמן,"
        },
        {
          "s": 2,
          "text": "מובן,"
        },
        {
          "s": 3,
          "text": "דזה שע\"י גילוי אור הסובב נמשך בעולם ענין שלמעלה מזמן ומקום הוא שגדרי העולם בטלים מפני הגילוי דאור הבל\"ג שלמעלה מהעולם."
        },
        {
          "s": 4,
          "text": "וע\"ד הרצון"
        },
        {
          "s": 5,
          "text": "(דרצון הוא משל על סובב),"
        },
        {
          "s": 6,
          "text": "דזה שהרצון מושל ושולט על האברים שיעשו היפך טבעם הוא מפני שהם בטלים להרצון31."
        },
        {
          "s": 7,
          "text": "ומכיון שהענין דבכל יום יהיו בעיניך כחדשים הוא שיהי' לו חיות בהמצוות"
        },
        {
          "s": 8,
          "text": "(כבדברים חדשים),"
        },
        {
          "s": 9,
          "text": "דחיות הוא פנימי,"
        },
        {
          "s": 10,
          "text": "לכן,"
        },
        {
          "s": 11,
          "text": "הענין דלמעלה מהזמן שמאיר בהאדם"
        },
        {
          "s": 12,
          "text": "(שעי\"ז יהיו בעיניך כחדשים)"
        },
        {
          "s": 13,
          "text": "צריך להיות אצלו בפנימיות."
        },
        {
          "s": 14,
          "text": "ולכן,"
        },
        {
          "s": 15,
          "text": "הנתינת כח על זה שבכל יום יהיו בעיניך כחדשים הוא זה שאנכי מצוך היום,"
        },
        {
          "s": 16,
          "text": "אנכי מי שאנכי,"
        },
        {
          "s": 17,
          "text": "שלמעלה גם מסובב."
        },
        {
          "s": 18,
          "text": "והענין הוא,"
        },
        {
          "s": 19,
          "text": "דאור הבל\"ג"
        },
        {
          "s": 20,
          "text": "(השרש דאור הסובב),"
        },
        {
          "s": 21,
          "text": "הוא מוגדר בהגדר דבל\"ג,"
        },
        {
          "s": 22,
          "text": "ולכן,"
        },
        {
          "s": 23,
          "text": "זה שא\"ס להתפשטותו והוא נמצא בגילוי בכל מקום,"
        },
        {
          "s": 24,
          "text": "גם בעוה\"ז הגשמי32,"
        },
        {
          "s": 25,
          "text": "הוא מצד זה שהאור הוא א\"ס,"
        },
        {
          "s": 26,
          "text": "אבל אין זה שייך להעולם."
        },
        {
          "s": 27,
          "text": "ושני אופנים בזה."
        },
        {
          "s": 28,
          "text": "או שבעולם אינו נרגש כלל האור32,"
        },
        {
          "s": 29,
          "text": "או שנרגש בו האור,"
        },
        {
          "s": 30,
          "text": "שעי\"ז נמשך בו ענין שלמעלה מזמן ומקום,"
        },
        {
          "s": 31,
          "text": "אבל הוא באופן שגדר העולם בטל מפני האור."
        },
        {
          "s": 32,
          "text": "ובכדי שהגילוי דאור הבל\"ג בעולם יהי' בפנימיותו,"
        },
        {
          "s": 33,
          "text": "הוא ע\"י העצמות33"
        },
        {
          "s": 34,
          "text": "שאינו מוגדר בשום גדר,"
        },
        {
          "s": 35,
          "text": "לא בגדר הגבול ולא בגדר הבל\"ג."
        },
        {
          "s": 36,
          "text": "ולכן,"
        },
        {
          "s": 37,
          "text": "ע\"י גילוי כח העצמות,"
        },
        {
          "s": 38,
          "text": "נעשה החיבור דבל\"ג וגבול,"
        },
        {
          "s": 39,
          "text": "יחוד סובב וממלא,"
        },
        {
          "s": 40,
          "text": "והגילוי דלמעלה מהזמן"
        },
        {
          "s": 41,
          "text": "(שנמשך מהסובב)"
        },
        {
          "s": 42,
          "text": "בעולם"
        },
        {
          "s": 43,
          "text": "(שחיותו הוא מאור הממלא)"
        },
        {
          "s": 44,
          "text": "הוא בפנימיותו."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ויש להוסיף,"
        },
        {
          "s": 2,
          "text": "דזה שהענין דבכל יום יהיו בעיניך כחדשים הוא ע\"י יחוד סובב וממלא הוא לא רק בכדי שהענין דלמעלה מהזמן"
        },
        {
          "s": 3,
          "text": "(סובב)"
        },
        {
          "s": 4,
          "text": "יורגש בהאדם בפנימיות,"
        },
        {
          "s": 5,
          "text": "אלא גם מפני שבהענין דבכל יום כחדשים עצמו ישנם שני ההפכים דלמעלה מהזמן וזמן."
        },
        {
          "s": 6,
          "text": "שהרי הענין דחדשים"
        },
        {
          "s": 7,
          "text": "(והיוקר והחביבות שבזה)"
        },
        {
          "s": 8,
          "text": "הוא השינוי34,"
        },
        {
          "s": 9,
          "text": "שבתחלה לא הי' הדבר ונתחדש רק עכשיו."
        },
        {
          "s": 10,
          "text": "וזה שבכל יום הם בעיניו כחדשים הוא שהחידוש"
        },
        {
          "s": 11,
          "text": "(השינוי)"
        },
        {
          "s": 12,
          "text": "הוא באופן תמידי שאינו משתנה."
        },
        {
          "s": 13,
          "text": "ונמצא דזה שהענין דבכל יום כחדשים הוא ע\"י יחוד סובב וממלא הוא לא רק שהגילוי דסובב"
        },
        {
          "s": 14,
          "text": "(דלמעלה מהזמן)"
        },
        {
          "s": 15,
          "text": "נרגש אצלו בפנימיות"
        },
        {
          "s": 16,
          "text": "(שעי\"ז יש לו חיות בהמצוות כבדברים חדשים),"
        },
        {
          "s": 17,
          "text": "אלא יתירה מזו,"
        },
        {
          "s": 18,
          "text": "שהזמן עצמו"
        },
        {
          "s": 19,
          "text": "(שמצד אור הממלא)"
        },
        {
          "s": 20,
          "text": "הוא באופן דלמעלה מזמן ושינוי"
        },
        {
          "s": 21,
          "text": "(גילוי הסובב)."
        }
      ]
    }
  ]
}