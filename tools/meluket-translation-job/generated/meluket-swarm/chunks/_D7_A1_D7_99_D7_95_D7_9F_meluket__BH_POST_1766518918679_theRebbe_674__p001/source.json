{
  "globalIndex": 819,
  "owner": 19,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918679_theRebbe_674__p001",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918679_theRebbe_674__p001",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918679_theRebbe_674",
  "title": "מאמר אנכי הוי' אלוקיך תשמ\"ט",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "אור לה' סיון,"
        },
        {
          "s": 2,
          "text": "ערב חג השבועות,"
        },
        {
          "s": 3,
          "text": "ה'תשמ\"ט*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "אנכי הוי' אלקיך אשר הוצאתיך מארץ מצרים1,"
        },
        {
          "s": 1,
          "text": "דפסוק זה הוא דיבור הראשון דעשרת הדברות שניתנו במתן תורה בו' סיון2,"
        },
        {
          "s": 2,
          "text": "לאחרי שהקדימו ישראל נעשה לנשמע"
        },
        {
          "s": 3,
          "text": "[ובאו מלאכי השרת וקשרו לכל אחד מישראל שני כתרים אחד כנגד נעשה ואחד כנגד נשמע3]"
        },
        {
          "s": 4,
          "text": "בחמישי בסיון4."
        },
        {
          "s": 5,
          "text": "ומובא בכמה דרושים דרבותינו נשיאינו5"
        },
        {
          "s": 6,
          "text": "השאלה הידועה דגדולי ישראל6,"
        },
        {
          "s": 7,
          "text": "הרי בריאת שמים וארץ הוא פלא גדול יותר מיצי\"מ."
        },
        {
          "s": 8,
          "text": "דביצי\"מ,"
        },
        {
          "s": 9,
          "text": "אף שהיו כמה נסים,"
        },
        {
          "s": 10,
          "text": "הרי נוסף לזה שאין זה ביאור מספיק על זה שאומר אשר הוצאתיך מארץ מצרים דוקא,"
        },
        {
          "s": 11,
          "text": "מכיון שגם קודם יצי\"מ וכן לאחרי יצי\"מ היו כו\"כ נסים7,"
        },
        {
          "s": 12,
          "text": "הנה ענין הנס הוא שינוי מיש ליש,"
        },
        {
          "s": 13,
          "text": "ובריאת שמים וארץ הוא יש מאין."
        },
        {
          "s": 14,
          "text": "ונוסף לזה שבריאה יש מאין הוא פלא גדול יותר,"
        },
        {
          "s": 15,
          "text": "הנה גם הכח האלקי שבבריאה יש מאין הוא כח נעלה יותר,"
        },
        {
          "s": 16,
          "text": "כידוע8"
        },
        {
          "s": 17,
          "text": "שבריאה יש מאין היא רק בכח העצמות שמציאותו מעצמותו."
        },
        {
          "s": 18,
          "text": "[ויש לומר,"
        },
        {
          "s": 19,
          "text": "דזה שהמציאות דיש הנברא היא מציאות אמיתית9,"
        },
        {
          "s": 20,
          "text": "הוא מפני שהתהוותו היא מהעצמות,"
        },
        {
          "s": 21,
          "text": "יש האמיתי10]."
        },
        {
          "s": 22,
          "text": "ולמה אומר אשר הוצאתיך מארץ מצרים,"
        },
        {
          "s": 23,
          "text": "דלכאורה הול\"ל אשר בראתי שמים וארץ."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויש להוסיף,"
        },
        {
          "s": 2,
          "text": "דזה שלכאורה הול\"ל אשר בראתי שמים וארץ,"
        },
        {
          "s": 3,
          "text": "הוא גם לפי שבריאת שמים וארץ ומתן תורה"
        },
        {
          "s": 4,
          "text": "(דאנכי הוי' אלקיך הוא הפתיחה דמ\"ת)"
        },
        {
          "s": 5,
          "text": "שייכים זל\"ז."
        },
        {
          "s": 6,
          "text": "דבריאת שמים וארץ מתחדשת בכל רגע ורגע,"
        },
        {
          "s": 7,
          "text": "כתורת הבעש\"ט עה\"פ11"
        },
        {
          "s": 8,
          "text": "לעולם הוי' דברך נצב בשמים"
        },
        {
          "s": 9,
          "text": "(הובא בספר תניא קדישא12)"
        },
        {
          "s": 10,
          "text": "שכח האלקי מהוה תמיד את הנברא מאין ליש."
        },
        {
          "s": 11,
          "text": "ומכיון שבריאה והתהוות יש מאין היא בכח העצמות,"
        },
        {
          "s": 12,
          "text": "מובן,"
        },
        {
          "s": 13,
          "text": "שהבריאה שבכל רגע ורגע היא יש מאין ממש מהעצמות."
        },
        {
          "s": 14,
          "text": "ועד\"ז הוא בתורה13,"
        },
        {
          "s": 15,
          "text": "שנתינתה"
        },
        {
          "s": 16,
          "text": "(והמשכתה)"
        },
        {
          "s": 17,
          "text": "היא מהעצמות"
        },
        {
          "s": 18,
          "text": "(אנכי),"
        },
        {
          "s": 19,
          "text": "והמשכתה מהעצמות היא בכל רגע14"
        },
        {
          "s": 20,
          "text": "כמ\"ש15"
        },
        {
          "s": 21,
          "text": "נותן התורה לשון הוה,"
        },
        {
          "s": 22,
          "text": "שלכן ארז\"ל16"
        },
        {
          "s": 23,
          "text": "בכל יום17"
        },
        {
          "s": 24,
          "text": "יהיו בעיניך חדשים,"
        },
        {
          "s": 25,
          "text": "חדשים ממש."
        }
      ]
    }
  ]
}