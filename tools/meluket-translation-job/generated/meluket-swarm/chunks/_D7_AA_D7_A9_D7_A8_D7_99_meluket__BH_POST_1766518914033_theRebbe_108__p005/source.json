  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914033_theRebbe_108__p005",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914033_theRebbe_108__p005",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914033_theRebbe_108",
  "title": "מאמר שובה ישראל תשל\"ז",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "והנה ידוע מ\"ש באגרת התשובה61"
        },
        {
          "s": 2,
          "text": "שתשובה עילאה היא בשמחה רבה."
        },
        {
          "s": 3,
          "text": "ומזה מובן במכ\"ש בנוגע להתשובה דשבת תשובה,"
        },
        {
          "s": 4,
          "text": "שבתשובה עילאה עצמה היא דרגא נעלית ביותר,"
        },
        {
          "s": 5,
          "text": "ועד שגם הוי' אד' כאלקים יחשב,"
        },
        {
          "s": 6,
          "text": "שצריכה להיות בשמחה רבה ועצומה."
        },
        {
          "s": 7,
          "text": "וכיון ששמחה פורצת גדר62,"
        },
        {
          "s": 8,
          "text": "הנה ע\"י השמחה בעשרת ימי תשובה,"
        },
        {
          "s": 9,
          "text": "ובפרט בשבת תשובה,"
        },
        {
          "s": 10,
          "text": "פורצים כל המדידות וההגבלות,"
        },
        {
          "s": 11,
          "text": "ענני במרחב י\"ה63,"
        },
        {
          "s": 12,
          "text": "וזה נמשך על ובכל השנה,"
        },
        {
          "s": 13,
          "text": "בענינים הרוחניים,"
        },
        {
          "s": 14,
          "text": "שהעבודה בתומ\"צ תהי' בהרחבה ובאופן דופרצת64,"
        },
        {
          "s": 15,
          "text": "וגם בענינים הגשמיים בבני חיי ומזוני רויחי,"
        },
        {
          "s": 16,
          "text": "ועד להרחבה האמיתית שתהי' בביאת משיח צדקנו,"
        },
        {
          "s": 17,
          "text": "ורחבה גו' למעלה עתידה ירושלים להיות מורחבת כו'65,"
        },
        {
          "s": 18,
          "text": "עתידה ירושלים שתתפשט בכל ארץ ישראל ועתידה ארץ ישראל שתתפשט בכל הארצות66,"
        },
        {
          "s": 19,
          "text": "בביאת משיח צדקנו בקרוב ממש."
        }
      ]
    }
  ]
}