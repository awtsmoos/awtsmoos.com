{
  "globalIndex": 194,
  "owner": 44,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914911_theRebbe_655__p002",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914911_theRebbe_655__p002",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518914911_theRebbe_655",
  "title": "מאמר ויהיו חיי שרה תשמ\"א",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ויהיו חיי שרה מאה שנה ועשרים שנה ושבע שנים שני חיי שרה1,"
        },
        {
          "s": 1,
          "text": "ומדייק כ\"ק אדמו\"ר"
        },
        {
          "s": 2,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 3,
          "text": "נ\"ע בעל יום ההולדת במאמרו ד\"ה זה דשנת עטר\"ת2,"
        },
        {
          "s": 4,
          "text": "מהו אומרו שני חיי שרה,"
        },
        {
          "s": 5,
          "text": "הרי כבר נאמר ויהיו חיי שרה"
        },
        {
          "s": 6,
          "text": "[ומפרט שנותי' במאות עשיריות ואחדות],"
        },
        {
          "s": 7,
          "text": "ולמה כפל עוד לומר שני חיי שרה."
        },
        {
          "s": 8,
          "text": "וגם צ\"ל"
        },
        {
          "s": 9,
          "text": "(כמו שמדייק בזהר3)"
        },
        {
          "s": 10,
          "text": "מפני מה בשרה דוקא נאמר ימי שני חיי'"
        },
        {
          "s": 11,
          "text": "[ועד שכל הפרשה"
        },
        {
          "s": 12,
          "text": "(חיי שרה)"
        },
        {
          "s": 13,
          "text": "נקראת על שם זה,"
        },
        {
          "s": 14,
          "text": "שמזה משמע4"
        },
        {
          "s": 15,
          "text": "שזהו תוכן כל הסדרה],"
        },
        {
          "s": 16,
          "text": "שלא נאמר זה בשארי אמהות5."
        },
        {
          "s": 17,
          "text": "ומביא בזה מאמר הזהר6,"
        },
        {
          "s": 18,
          "text": "אתת חוה לעלמא ואתדבקת בחויא7"
        },
        {
          "s": 19,
          "text": "כו' אתא נח8"
        },
        {
          "s": 20,
          "text": "לעלמא מה כתיב בי'9"
        },
        {
          "s": 21,
          "text": "וישת מן היין וישכר כו' אתת שרה ונחתת וסלקת"
        },
        {
          "s": 22,
          "text": "[ולא אתדבקת בי'10]"
        },
        {
          "s": 23,
          "text": "כד\"א11"
        },
        {
          "s": 24,
          "text": "ויעל אברם ממצרים הוא ואשתו ובגין כך זכתה לחיין עילאין."
        },
        {
          "s": 25,
          "text": "ומסיים"
        },
        {
          "s": 26,
          "text": "(בזהר שם)"
        },
        {
          "s": 27,
          "text": "ועל דא דילה הוו חיין."
        },
        {
          "s": 28,
          "text": "ועפ\"ז מבאר כ\"ק אדמו\"ר"
        },
        {
          "s": 29,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 30,
          "text": "נ\"ע במאמרו הנ\"ל12"
        },
        {
          "s": 31,
          "text": "שני דיוקים הנ\"ל,"
        },
        {
          "s": 32,
          "text": "שדוקא בשרה נאמר ימי שני חיי'"
        },
        {
          "s": 33,
          "text": "(שלא נאמר בשאר אמהות)"
        },
        {
          "s": 34,
          "text": "לפי שדוקא שרה,"
        },
        {
          "s": 35,
          "text": "ע\"י שנחתת וסלקת,"
        },
        {
          "s": 36,
          "text": "זכתה לחיין עילאין."
        },
        {
          "s": 37,
          "text": "ומה שכפל עוד פעם לאמר שני חיי שרה,"
        },
        {
          "s": 38,
          "text": "אף שכבר נאמר בתחלה ויהיו חיי שרה,"
        },
        {
          "s": 39,
          "text": "הוא כי \"ויהיו חיי שרה\" הוא מה שזכתה לחיין עילאין,"
        },
        {
          "s": 40,
          "text": "ו\"שני חיי שרה\" הו\"ע \"דילה הוו חיין\","
        },
        {
          "s": 41,
          "text": "דלא רק שזכתה לחיין עילאין אלא גם שהחיין נעשו שלה,"
        },
        {
          "s": 42,
          "text": "\"דילה הוו\"."
        },
        {
          "s": 43,
          "text": "וצריך להבין תוכן שני ענינים אלו."
        },
        {
          "s": 44,
          "text": "וגם צריך להבין,"
        },
        {
          "s": 45,
          "text": "דמלשון הזהר אתת חוה אתא נח אתת שרה מובן,"
        },
        {
          "s": 46,
          "text": "שיש שייכות בין ג' ענינים אלו."
        },
        {
          "s": 47,
          "text": "היינו דחוה ונח רצו לפעול אותו הענין שפעלה שרה,"
        },
        {
          "s": 48,
          "text": "אלא שלא עלתה בידם,"
        },
        {
          "s": 49,
          "text": "ולא עוד אלא שעי\"ז נעשית אצלם ירידה"
        },
        {
          "s": 50,
          "text": "(אתדבקת בחויא,"
        },
        {
          "s": 51,
          "text": "וישכר)."
        },
        {
          "s": 52,
          "text": "משא\"כ שרה,"
        },
        {
          "s": 53,
          "text": "אף שגם אצלה היתה"
        },
        {
          "s": 54,
          "text": "(בתחלה)"
        },
        {
          "s": 55,
          "text": "ירידה,"
        },
        {
          "s": 56,
          "text": "ע\"י ירידה זו הי' אח\"כ העלי',"
        },
        {
          "s": 57,
          "text": "נחתת וסלקת."
        },
        {
          "s": 58,
          "text": "וצריך להבין השייכות דג' ענינים אלו."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה מעשה אבות סימן לבנים13,"
        },
        {
          "s": 2,
          "text": "וידוע שהכוונה בסימן כאן היא לא רק סימן והוראה אלא גם נתינת כח14."
        },
        {
          "s": 3,
          "text": "וע\"ד הידוע15"
        },
        {
          "s": 4,
          "text": "בענין פתח ר' פלוני וכו',"
        },
        {
          "s": 5,
          "text": "דלאחרי שפתח את הצינור והדרך,"
        },
        {
          "s": 6,
          "text": "ועאכו\"כ כאשר סלל את הדרך,"
        },
        {
          "s": 7,
          "text": "הרי עי\"ז ניתן הכח לכאו\"א שיוכל לעשות עבודה זו,"
        },
        {
          "s": 8,
          "text": "ואינו צריך ליגיעה גדולה כ\"כ"
        },
        {
          "s": 9,
          "text": "(כבפעם הראשונה)16."
        },
        {
          "s": 10,
          "text": "ועאכו\"כ שכן הוא במעשה אבות,"
        },
        {
          "s": 11,
          "text": "מכיון שהם האבות של כאו\"א מישראל,"
        },
        {
          "s": 12,
          "text": "והענינים והעבודות שלהם נמשכים בירושה לכאו\"א מישראל17."
        },
        {
          "s": 13,
          "text": "וכן הוא גם בנוגע לאמהות18,"
        },
        {
          "s": 14,
          "text": "ובפרט בנוגע לשרה אמנו,"
        },
        {
          "s": 15,
          "text": "הראשונה שבד' אמהות,"
        },
        {
          "s": 16,
          "text": "וכתיב בה19"
        },
        {
          "s": 17,
          "text": "כל אשר תאמר אליך שרה שמע בקולה."
        },
        {
          "s": 18,
          "text": "ומזה מובן דענין הנ\"ל,"
        },
        {
          "s": 19,
          "text": "אתת שרה ונחתת וסלקת,"
        },
        {
          "s": 20,
          "text": "הוא"
        },
        {
          "s": 21,
          "text": "(ככל מעשה אבות ואמהות)"
        },
        {
          "s": 22,
          "text": "הוראה וגם נתינת כח בעבודתו של כאו\"א מישראל20."
        },
        {
          "s": 23,
          "text": "וצריך להבין ההוראה דנחתת וסלקת בהעבודה דבנים לאחרי מ\"ת."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ונקודת הענין בזה הוא כמו שמבאר בעל יום ההולדת במאמרו הנ\"ל21,"
        },
        {
          "s": 2,
          "text": "דעבודת ה' צריכה להיות בשמחה דוקא כמ\"ש22"
        },
        {
          "s": 3,
          "text": "עבדו את ה' בשמחה."
        },
        {
          "s": 4,
          "text": "ועד שהשמחה בעבודת ה' היא עיקר גדול,"
        },
        {
          "s": 5,
          "text": "וכידוע פירוש האריז\"ל23"
        },
        {
          "s": 6,
          "text": "והובא בתניא24"
        },
        {
          "s": 7,
          "text": "עה\"פ25"
        },
        {
          "s": 8,
          "text": "תחת אשר לא עבדת את ה' אלקיך בשמחה וגו',"
        },
        {
          "s": 9,
          "text": "ואיתא בתו\"א26"
        },
        {
          "s": 10,
          "text": "דמה שהאריז\"ל זכה לרוה\"ק27"
        },
        {
          "s": 11,
          "text": "הוא ע\"י שמחה של מצוה"
        },
        {
          "s": 12,
          "text": "[ומכיון שזהו סיפור בתורה"
        },
        {
          "s": 13,
          "text": "(שבעל פה)"
        },
        {
          "s": 14,
          "text": "מלשון הוראה28,"
        },
        {
          "s": 15,
          "text": "הרי זה הוראה לכאו\"א מישראל],"
        },
        {
          "s": 16,
          "text": "דכאשר העבודה היא בשמחה,"
        },
        {
          "s": 17,
          "text": "אז העבודה היא בשלימות"
        },
        {
          "s": 18,
          "text": "[ועי\"ז נעשה שלימות גם בהעולם."
        },
        {
          "s": 19,
          "text": "שהרי תכלית הבריאה היא בשביל ישראל שנקראים ראשית29,"
        },
        {
          "s": 20,
          "text": "ופירוש בשביל ישראל הוא בשביל העבודה דישראל"
        },
        {
          "s": 21,
          "text": "[שזהו עיקר מציאותם,"
        },
        {
          "s": 22,
          "text": "כמארז\"ל30"
        },
        {
          "s": 23,
          "text": "אני לא נבראתי אלא לשמש את קוני],"
        },
        {
          "s": 24,
          "text": "היינו שישראל ע\"י עבודתם פועלים שהעולם יהי' בתכלית השלימות."
        },
        {
          "s": 25,
          "text": "דהגם שעולם על מילואו נברא31,"
        },
        {
          "s": 26,
          "text": "ובפרט ע\"פ הידוע32"
        },
        {
          "s": 27,
          "text": "שמהטעמים על בריאת העולם הוא לפי שעלה ברצונו ית' להטיב לברואיו,"
        },
        {
          "s": 28,
          "text": "שטבע הטוב להטיב33,"
        },
        {
          "s": 29,
          "text": "שמזה מובן שבריאת העולם"
        },
        {
          "s": 30,
          "text": "(מלכתחילה)"
        },
        {
          "s": 31,
          "text": "הי' בשלימות,"
        },
        {
          "s": 32,
          "text": "מ\"מ,"
        },
        {
          "s": 33,
          "text": "ענין זה גופא דלהטיב לברואיו,"
        },
        {
          "s": 34,
          "text": "הוא אחד הטעמים על זה שעלה ברצונו ית' שהבריאה תהי' בשביל29"
        },
        {
          "s": 35,
          "text": "ישראל ובשביל התורה,"
        },
        {
          "s": 36,
          "text": "שעי\"ז יושפע להנבראים שלימות הטוב,"
        },
        {
          "s": 37,
          "text": "ע\"י שישראל ע\"י עבודתם יוסיפו שלימות בהעולם,"
        },
        {
          "s": 38,
          "text": "שלימות נעלית יותר מהשלימות דעולם כמו שהוא מצד הבריאה."
        },
        {
          "s": 39,
          "text": "ומכיון ששלימות העבודה היא כאשר היא בשמחה,"
        },
        {
          "s": 40,
          "text": "לכן עי\"ז מתוסף גם בהשלימות דעולם,"
        },
        {
          "s": 41,
          "text": "שנעשה ע\"י עבודת ישראל]."
        },
        {
          "s": 42,
          "text": "ולא זו בלבד ששלימות העבודה היא כאשר היא בשמחה,"
        },
        {
          "s": 43,
          "text": "אלא שהשמחה בעבודת ה' היא גם הכרח בעבודת ה',"
        },
        {
          "s": 44,
          "text": "שלכן כאשר חסר השמחה בעבודת ה' מגיע על זה עונש ח\"ו כמ\"ש25"
        },
        {
          "s": 45,
          "text": "תחת אשר לא עבדת את ה' אלקיך בשמחה וגו',"
        },
        {
          "s": 46,
          "text": "כי ענין העבודה הוא להמשיך גילוי אלקות למטה וזה נעשה ע\"י השמחה."
        }
      ]
    }
  ]
}