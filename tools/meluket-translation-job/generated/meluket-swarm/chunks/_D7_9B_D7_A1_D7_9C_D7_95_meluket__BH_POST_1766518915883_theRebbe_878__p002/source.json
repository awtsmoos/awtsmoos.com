{
  "globalIndex": 372,
  "owner": 22,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915883_theRebbe_878__p002",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915883_theRebbe_878__p002",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915883_theRebbe_878",
  "title": "מאמר מצותה משתשקע החמה תשל\"ח",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יובן מה שמובא28"
        },
        {
          "s": 2,
          "text": "בענין משתשקע החמה מאמר הזהר29"
        },
        {
          "s": 3,
          "text": "עה\"פ30"
        },
        {
          "s": 4,
          "text": "ואל מקומו שואף זורח הוא שם,"
        },
        {
          "s": 5,
          "text": "כד אזיל שמשא למערב האי מערב אקרי מקומו דשמשא כו'."
        },
        {
          "s": 6,
          "text": "וידוע הביאור בזה31,"
        },
        {
          "s": 7,
          "text": "מערב הוא מלכות32"
        },
        {
          "s": 8,
          "text": "(כמאמר33"
        },
        {
          "s": 9,
          "text": "שכינה במערב),"
        },
        {
          "s": 10,
          "text": "וכד אזיל שמשא למערב הוא המשכת וירידת ז\"א"
        },
        {
          "s": 11,
          "text": "(שמש)"
        },
        {
          "s": 12,
          "text": "במלכות,"
        },
        {
          "s": 13,
          "text": "עד בהמלכות כמו שנעשית מקור לבי\"ע ועד ש\"נשקע אור האצילות\","
        },
        {
          "s": 14,
          "text": "ואעפ\"כ האי מערב אקרי מקומו דשמשא כו',"
        },
        {
          "s": 15,
          "text": "שזה הוא מקומו האמיתי"
        },
        {
          "s": 16,
          "text": "(כי הכוונה האמיתית בהאצלת האצילות היא בשביל התהוות בי\"ע),"
        },
        {
          "s": 17,
          "text": "ועד ששם דוקא זורח הוא,"
        },
        {
          "s": 18,
          "text": "שעיקר ואמיתית ענין הזריחה הוא בבי\"ע דוקא."
        },
        {
          "s": 19,
          "text": "וכמבואר בספר תניא קדישא34,"
        },
        {
          "s": 20,
          "text": "שעולמות העליונים הם בבחי' ירידה מאור פניו ית',"
        },
        {
          "s": 21,
          "text": "משא\"כ עולמות בי\"ע,"
        },
        {
          "s": 22,
          "text": "ובפרט עוה\"ז התחתון שאין תחתון למטה ממנו,"
        },
        {
          "s": 23,
          "text": "נעשים דירה לו ית',"
        },
        {
          "s": 24,
          "text": "דירה לעצמותו"
        },
        {
          "s": 25,
          "text": "(בדוגמת דירת האדם שעצמות האדם דר בהדירה35),"
        },
        {
          "s": 26,
          "text": "ועד שכידוע36,"
        },
        {
          "s": 27,
          "text": "יש הנברא"
        },
        {
          "s": 28,
          "text": "(שבהרגשתו מציאותו מעצמותו)"
        },
        {
          "s": 29,
          "text": "הוא דוגמת יש האמיתי."
        },
        {
          "s": 30,
          "text": "וזהו מה שנ\"ח מצותה משתשקע החמה,"
        },
        {
          "s": 31,
          "text": "כי ענין נ\"ח הוא להאיר החושך דבי\"ע"
        },
        {
          "s": 32,
          "text": "(שקיעת השמש הוי' דאצילות),"
        },
        {
          "s": 33,
          "text": "שעי\"ז דוקא נעשה הזריחה,"
        },
        {
          "s": 34,
          "text": "ועד לגילוי ודירת העצמות,"
        },
        {
          "s": 35,
          "text": "כנ\"ל."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ויש לומר דענין משתשקע החמה למטה יותר קאי על התהוות הקליפות,"
        },
        {
          "s": 2,
          "text": "שקיעה שלא בערך דאור הקדושה."
        },
        {
          "s": 3,
          "text": "ומכיון שכל הגבוה גבוה יותר יורד למטה מטה יותר"
        },
        {
          "s": 4,
          "text": "(כנ\"ל ס\"ב),"
        },
        {
          "s": 5,
          "text": "הנה הזריחה שע\"י שקיעה זו היא זריחת אור נעלה יותר גם מהזריחה שע\"י שקיעה הנ\"ל דשמש הוי' דאצילות."
        },
        {
          "s": 6,
          "text": "[ובדוגמת העילוי שבהתהוות היש דבי\"ע הפרטיים"
        },
        {
          "s": 7,
          "text": "(שקיעת אצילות הפרטית)"
        },
        {
          "s": 8,
          "text": "על העילוי דהתהוות בי\"ע הכלליים"
        },
        {
          "s": 9,
          "text": "(שקיעת אצילות הכללית),"
        },
        {
          "s": 10,
          "text": "שבהתהוות היש דבי\"ע"
        },
        {
          "s": 11,
          "text": "(הפרטיים)"
        },
        {
          "s": 12,
          "text": "דוקא מתגלה כח העצמות,"
        },
        {
          "s": 13,
          "text": "ובבי\"ע גופא עיקר גילוי כח העצמות הוא בהתהוות היש הגשמי דוקא37]."
        },
        {
          "s": 14,
          "text": "וכמאמר38"
        },
        {
          "s": 15,
          "text": "כד אתכפיא סט\"א אסתלק יקרא דקוב\"ה בכולהו עלמין,"
        },
        {
          "s": 16,
          "text": "דעי\"ז שיש מציאות דסט\"א"
        },
        {
          "s": 17,
          "text": "(ע\"י שקיעת שמש דקדושה),"
        },
        {
          "s": 18,
          "text": "ואתכפיא סט\"א ואתהפכא סט\"א,"
        },
        {
          "s": 19,
          "text": "נמשך גילוי אור נעלה ביותר,"
        },
        {
          "s": 20,
          "text": "אור שלמעלה מגדר גילוי,"
        },
        {
          "s": 21,
          "text": "שלכן נקרא בשם אסתלק39."
        },
        {
          "s": 22,
          "text": "ועי\"ז דוקא נשלמת הכוונה שנתאוה הקב\"ה להיות לו ית' דירה בתחתונים40."
        },
        {
          "s": 23,
          "text": "ובכדי שתושלם כוונה זו נתהווה מציאות הרע41"
        },
        {
          "s": 24,
          "text": "(כמרז\"ל42"
        },
        {
          "s": 25,
          "text": "עה\"פ43"
        },
        {
          "s": 26,
          "text": "נורא עלילה על בני אדם),"
        },
        {
          "s": 27,
          "text": "דזהו שהי' הקב\"ה בונה עולמות ומחריבן44"
        },
        {
          "s": 28,
          "text": "שקאי על בנין עולם התוהו ושבירתו45,"
        },
        {
          "s": 29,
          "text": "בכדי שהאדם"
        },
        {
          "s": 30,
          "text": "[אתם קרויין אדם46"
        },
        {
          "s": 31,
          "text": "אדמה לעליון47]"
        },
        {
          "s": 32,
          "text": "יברר את הניצוצות"
        },
        {
          "s": 33,
          "text": "(שלא נתבררו ע\"י הבירור שלמעלה)"
        },
        {
          "s": 34,
          "text": "ויתקנם ויעלם ע\"י עבודתו,"
        },
        {
          "s": 35,
          "text": "ועי\"ז דוקא נשלמת הכוונה דדירה בתחתונים."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "וזהו פי' עד שתכלה רגל מן השוק: פירוש א',"
        },
        {
          "s": 2,
          "text": "שהו\"ע בקדושה,"
        },
        {
          "s": 3,
          "text": "שוק,"
        },
        {
          "s": 4,
          "text": "שוקיו עמודי שש48"
        },
        {
          "s": 5,
          "text": "זה העולם שנשתוקק49"
        },
        {
          "s": 6,
          "text": "הקב\"ה לבראותו50."
        },
        {
          "s": 7,
          "text": "ורגל"
        },
        {
          "s": 8,
          "text": "(מן השוק)"
        },
        {
          "s": 9,
          "text": "הו\"ע ג' רגלים51,"
        },
        {
          "s": 10,
          "text": "דרגא הכי נעלית בקדושה כמרז\"ל52"
        },
        {
          "s": 11,
          "text": "כשם שבא לראות כך בא ליראות וכשם שבא ליראות כך בא לראות."
        },
        {
          "s": 12,
          "text": "ופירוש הב' הוא,"
        },
        {
          "s": 13,
          "text": "שוק ורה\"ר,"
        },
        {
          "s": 14,
          "text": "רה\"ר טורי דפרודא,"
        },
        {
          "s": 15,
          "text": "ועד שבשוק זה ישנם תרמודאי המורדים במלכות שמים"
        },
        {
          "s": 16,
          "text": "(תרמוד אותיות מורדת13),"
        },
        {
          "s": 17,
          "text": "ורגל מן השוק הוא ריגלא דתרמודאי,"
        },
        {
          "s": 18,
          "text": "היינו שבהשוק נמצאים מורדים והם גם מהלכים בו"
        },
        {
          "s": 19,
          "text": "(כי רגל מורה53"
        },
        {
          "s": 20,
          "text": "על הליכה54),"
        },
        {
          "s": 21,
          "text": "ומן וע\"י השוק."
        },
        {
          "s": 22,
          "text": "ושני פירושים אלו שייכים זל\"ז,"
        },
        {
          "s": 23,
          "text": "כי זה שנשתוקק הקב\"ה לברוא את העולם"
        },
        {
          "s": 24,
          "text": "(פירוש הא' בשוק)"
        },
        {
          "s": 25,
          "text": "הוא כדי שיהי' לו ית' דירה בתחתונים,"
        },
        {
          "s": 26,
          "text": "בעוה\"ז התחתון שאין תחתון למטה ממנו בענין הסתר אורו ית'55,"
        },
        {
          "s": 27,
          "text": "ולכן היתה ההתהוות באופן דנעשה56"
        },
        {
          "s": 28,
          "text": "לשון רבים"
        },
        {
          "s": 29,
          "text": "[רשות הרבים"
        },
        {
          "s": 30,
          "text": "(פירוש הב' בשוק)]"
        },
        {
          "s": 31,
          "text": "והרוצה לטעות יטעה57,"
        },
        {
          "s": 32,
          "text": "כי בכדי שיהי' ובחרת בחיים58"
        },
        {
          "s": 33,
          "text": "(ענין הבחירה)"
        },
        {
          "s": 34,
          "text": "צריך להיות נתינת מקום לטעות."
        },
        {
          "s": 35,
          "text": "ודוקא עי\"ז שהתהוות העולם היתה באופן דנעשה לשון רבים,"
        },
        {
          "s": 36,
          "text": "ענין רשות הרבים,"
        },
        {
          "s": 37,
          "text": "והאדם בעבודתו מהפך את העולם שיהי' רשות היחיד ליחידו של עולם59,"
        },
        {
          "s": 38,
          "text": "עי\"ז נשלמת כביכול שוקיו תשוקתו של הקב\"ה בבריאת העולם שיהי' לו ית' דירה בתחתונים."
        }
      ]
    }
  ]
}