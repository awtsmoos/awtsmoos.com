{
  "globalIndex": 327,
  "owner": 27,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915617_theRebbe_822__p006",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915617_theRebbe_822__p006",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915617_theRebbe_822",
  "title": "מאמר ברוך שעשה ניסים תשט\"ו",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "שעד\"ז הוא בדעת עליון,"
        },
        {
          "s": 2,
          "text": "שיש בו שני אופנים."
        },
        {
          "s": 3,
          "text": "דבחיצוניות נראה דזה שלמטה אין הוא מפני שהמטה מצד עצמו הוא אין דכלא חשיב,"
        },
        {
          "s": 4,
          "text": "ובפנימיות הוא דזה שלמטה אין הוא בכדי לגלות שאוא\"ס הוא למטה מטה עד אין תכלית."
        },
        {
          "s": 5,
          "text": "וע\"י שדעת עליון נמשך בדעת תחתון ומתחבר עמו מתגלה הפנימיות שלו."
        },
        {
          "s": 6,
          "text": "ועד\"ז הוא בנוגע לנסים וטבע,"
        },
        {
          "s": 7,
          "text": "שע\"י המשכת הנסים בהעולם26"
        },
        {
          "s": 8,
          "text": "(טבע)"
        },
        {
          "s": 9,
          "text": "מתגלה הפנימיות שלהם,"
        },
        {
          "s": 10,
          "text": "דזה שבההנהגה דלמעלה מהטבע הנבראים אינם תופסים מקום הוא מפני שכך עלה ברצונו ית'."
        },
        {
          "s": 11,
          "text": "וזהו ברוך שעשה נסים לאבותינו,"
        },
        {
          "s": 12,
          "text": "לאבותינו לשון רבים,"
        },
        {
          "s": 13,
          "text": "דההרמה והעלי' שע\"י עשיית הנסים27"
        },
        {
          "s": 14,
          "text": "היא הן בבינה"
        },
        {
          "s": 15,
          "text": "(שרש הטבע)"
        },
        {
          "s": 16,
          "text": "והן בחכמה"
        },
        {
          "s": 17,
          "text": "(השרש דלמעלה מהטבע),"
        },
        {
          "s": 18,
          "text": "ששני הענינים הם לא מצד עצמם אלא בכדי לגלות שאוא\"ס הוא למעלה עד אין קץ ולמטה עד אין תכלית."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "והנה בכדי שיוכל להיות החיבור דשני הענינים,"
        },
        {
          "s": 2,
          "text": "שבהטבע דעולם"
        },
        {
          "s": 3,
          "text": "[שבו מודגש שהעולם הוא מציאות,"
        },
        {
          "s": 4,
          "text": "דזה שהקב\"ה מנהיג את כל נברא כפי ענינו מורה שבהנהגה זו הנבראים תופסים מקום]"
        },
        {
          "s": 5,
          "text": "יהי' הגילוי דלמעלה מהטבע"
        },
        {
          "s": 6,
          "text": "[שבו מודגש הביטול דעולם,"
        },
        {
          "s": 7,
          "text": "דזה שהקב\"ה מנהיג את העולם כפי רצונו ולא כפי תכונת וטבע הנבראים מורה שבהנהגה זו הנבראים אינם תופסים מקום],"
        },
        {
          "s": 8,
          "text": "הוא ע\"י שבהטבע עצמו יש ענין הביטול."
        },
        {
          "s": 9,
          "text": "וכמו שנתבאר לעיל"
        },
        {
          "s": 10,
          "text": "(בד\"ה פתח אלי'28),"
        },
        {
          "s": 11,
          "text": "דזה שצורת הנבראים לא נתפרשה בהעשרה מאמרות,"
        },
        {
          "s": 12,
          "text": "והתהוות הצורה שבכל נברא היא מבחינת הרצון,"
        },
        {
          "s": 13,
          "text": "מורה על הביטול דעולם,"
        },
        {
          "s": 14,
          "text": "דההתהוות שמהרצון,"
        },
        {
          "s": 15,
          "text": "ענינה הוא"
        },
        {
          "s": 16,
          "text": "(לא זה שמתהווים נבראים אלא)"
        },
        {
          "s": 17,
          "text": "זה שע\"י ההתהוות נשלם הרצון."
        },
        {
          "s": 18,
          "text": "וע\"י שהתהוות הצורה שבכל נברא,"
        },
        {
          "s": 19,
          "text": "שהכוונה בצורת הנברא היא"
        },
        {
          "s": 20,
          "text": "(הן לציור הגשמי שלו ו)"
        },
        {
          "s": 21,
          "text": "גם להטבע והתכונות שלו,"
        },
        {
          "s": 22,
          "text": "היתה מבחינת הרצון,"
        },
        {
          "s": 23,
          "text": "הרי זה מדגיש שענינו של הטבע"
        },
        {
          "s": 24,
          "text": "(בפנימיות)"
        },
        {
          "s": 25,
          "text": "הוא שעל ידו נשלם רצון הקב\"ה."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "והנה נתבאר לעיל"
        },
        {
          "s": 1,
          "text": "(בד\"ה פתח אלי'29)"
        },
        {
          "s": 2,
          "text": "דלהפירוש שטבע הוא מלשון מטבע שהקב\"ה טבע כל אדם בחותמו של אדה\"ר30,"
        },
        {
          "s": 3,
          "text": "שם טבע קאי על החיות דעולם,"
        },
        {
          "s": 4,
          "text": "ולהפירוש שטבע הוא שם המושאל לכל דבר שאינו ע\"פ טעם ודעת31,"
        },
        {
          "s": 5,
          "text": "שם טבע קאי על התהוות העולם מאין ליש,"
        },
        {
          "s": 6,
          "text": "דבריאה יש מאין"
        },
        {
          "s": 7,
          "text": "(משא\"כ ענין החיות)"
        },
        {
          "s": 8,
          "text": "היא למעלה מהשכל."
        },
        {
          "s": 9,
          "text": "ויש לומר,"
        },
        {
          "s": 10,
          "text": "דהביטול שבטבע הוא בנוגע לשני הענינים."
        },
        {
          "s": 11,
          "text": "דהביטול ששייך לחיות העולם מתגלה בהביטול דצורת הנבראים כי צורת הנבראים היא כלי להחיות והנפש שבהם"
        },
        {
          "s": 12,
          "text": "(כנ\"ל בד\"ה פתח אלי'28),"
        },
        {
          "s": 13,
          "text": "והביטול ששייך להתהוות העולם מתגלה בזה שהתהוות יש מאין אין לה מקום בשכל32."
        },
        {
          "s": 14,
          "text": "דזה שאין מקום בשכל להתהוות יש מאין,"
        },
        {
          "s": 15,
          "text": "מורה שמצד גדר העולם אין מקום להתהוותו,"
        },
        {
          "s": 16,
          "text": "וזה שנתהווה העולם הוא רק מצד רצון הקב\"ה."
        }
      ]
    }
  ]
}