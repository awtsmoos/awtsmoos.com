{
  "globalIndex": 568,
  "owner": 18,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916998_theRebbe_249__p004",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916998_theRebbe_249__p004",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916998_theRebbe_249",
  "title": "מאמר ארבעה ראשי שנים תשל\"א",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "והענין הוא,"
        },
        {
          "s": 2,
          "text": "דאיתא באגה\"ק ד\"ה דוד זמירות קרית להו59,"
        },
        {
          "s": 3,
          "text": "שכל העולמות עליונים ותחתונים תלויים בדקדוק מצוה,"
        },
        {
          "s": 4,
          "text": "ומביא שתי דוגמאות לזה,"
        },
        {
          "s": 5,
          "text": "קרבן ותפילין."
        },
        {
          "s": 6,
          "text": "ומבאר אאמו\"ר בהערותיו לתניא60,"
        },
        {
          "s": 7,
          "text": "דהטעם שתפס ב' מצוות אלו"
        },
        {
          "s": 8,
          "text": "(קרבן ותפילין)"
        },
        {
          "s": 9,
          "text": "הוא,"
        },
        {
          "s": 10,
          "text": "כי כלל ענין המצוות הוא העלאה והמשכה,"
        },
        {
          "s": 11,
          "text": "רצוא ושוב"
        },
        {
          "s": 12,
          "text": "(כמ\"ש בלקו\"ת בד\"ה זאת חוקת התורה61),"
        },
        {
          "s": 13,
          "text": "ולכן תפס ב' מצוות אלו,"
        },
        {
          "s": 14,
          "text": "כי קרבן הוא העלאה,"
        },
        {
          "s": 15,
          "text": "רצוא,"
        },
        {
          "s": 16,
          "text": "ותפילין הוא המשכה,"
        },
        {
          "s": 17,
          "text": "שוב"
        },
        {
          "s": 18,
          "text": "(כמ\"ש בלקו\"ת בדרושי הנסכים62)."
        },
        {
          "s": 19,
          "text": "וצריך להבין,"
        },
        {
          "s": 20,
          "text": "מה נוגע להענין המבואר באגה\"ק הנ\"ל"
        },
        {
          "s": 21,
          "text": "[שכל העולמות תלויים בדקדוק מצוה]"
        },
        {
          "s": 22,
          "text": "לרמז שענין המצוות הוא העלאה והמשכה."
        },
        {
          "s": 23,
          "text": "ויש לומר,"
        },
        {
          "s": 24,
          "text": "דזה שמבאר באגה\"ק שכל העולמות תלויים בדקדוק מצוה הוא הקדמה למ\"ש שם לאח\"ז שכל העולמות בטלים במציאות לגבי דקדוק אחד מדקדוקי תורה."
        },
        {
          "s": 25,
          "text": "דזה שאמר דוד63"
        },
        {
          "s": 26,
          "text": "זמירות היו לי חוקיך גו' הוא שבחא דאורייתא"
        },
        {
          "s": 27,
          "text": "(כמ\"ש באגה\"ק הנ\"ל בתחלתה),"
        },
        {
          "s": 28,
          "text": "והשבח הוא שכל העולמות בטלים במציאות"
        },
        {
          "s": 29,
          "text": "(ולא רק תלויים)64"
        },
        {
          "s": 30,
          "text": "לגבי דקדוק אחד מדקדוקי תורה,"
        },
        {
          "s": 31,
          "text": "אלא שגילוי ענין זה דתורה הוא ע\"י שכל העולמות תלויים בדקדוק מצוה."
        },
        {
          "s": 32,
          "text": "והיינו,"
        },
        {
          "s": 33,
          "text": "דלגבי המצוות שהם ציוויים להאדם איך שיתנהג בעולם,"
        },
        {
          "s": 34,
          "text": "בהכרח שיש איזה ערך ותפיסת מקום להעולמות,"
        },
        {
          "s": 35,
          "text": "וזה שהעולמות הם בטלים במציאות הוא"
        },
        {
          "s": 36,
          "text": "(דוקא)"
        },
        {
          "s": 37,
          "text": "לגבי"
        },
        {
          "s": 38,
          "text": "(דקדוק אחד מדקדוקי)"
        },
        {
          "s": 39,
          "text": "תורה."
        },
        {
          "s": 40,
          "text": "וההוכחה על זה היא מזה שכל העולמות תלויים בדקדוק מצוה."
        },
        {
          "s": 41,
          "text": "דזה שהעולמות תלויים בדקדוק מצוה"
        },
        {
          "s": 42,
          "text": "(אפילו בדקדוק קל)"
        },
        {
          "s": 43,
          "text": "הוא מפני שהוא דקדוק תורה,"
        },
        {
          "s": 44,
          "text": "שלגבה העולמות בטלים במציאות,"
        },
        {
          "s": 45,
          "text": "ולכן,"
        },
        {
          "s": 46,
          "text": "גם לאחרי שנמשך במצוות ונעשה \"דקדוק מצוה\","
        },
        {
          "s": 47,
          "text": "כל העולמות תלויים בו."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ובכדי לבאר שגם לאחרי המשכת דקדוקי תורה בהמצוות מאיר בהם בגילוי ענין התורה,"
        },
        {
          "s": 1,
          "text": "מרמז באגה\"ק"
        },
        {
          "s": 2,
          "text": "(ע\"י הבאת הדוגמאות דקרבן ותפילין)"
        },
        {
          "s": 3,
          "text": "שענין המצוות הוא העלאה והמשכה,"
        },
        {
          "s": 4,
          "text": "רצוא ושוב."
        },
        {
          "s": 5,
          "text": "דיש לומר,"
        },
        {
          "s": 6,
          "text": "שענין ההעלאה והרצוא שבמצוות הוא שנרגש בהם מקורם כמו שהם בתורה שלמעלה מהעולם,"
        },
        {
          "s": 7,
          "text": "וענין ההמשכה והשוב שבהם הוא שהם נמשכים להיות ציוויים להאדם,"
        },
        {
          "s": 8,
          "text": "וגם אז נרגש בהם שהמקור שלהם הוא בתורה שלמעלה מעולמות"
        },
        {
          "s": 9,
          "text": "[כי ענין רצוא ושוב הוא שגם לאחרי השוב ניכר רישומו של הרצוא65]."
        },
        {
          "s": 10,
          "text": "ולהעיר מזה שאומרים בברכת המצוות אשר קדשנו במצוותיו וצונו,"
        },
        {
          "s": 11,
          "text": "דיש לומר,"
        },
        {
          "s": 12,
          "text": "שקדשנו במצוותיו הו\"ע ההעלאה,"
        },
        {
          "s": 13,
          "text": "שהעלנו למעלת קודש העליון ב\"ה שהיא קדושתו של הקב\"ה בכבודו ובעצמו66,"
        },
        {
          "s": 14,
          "text": "וצונו הו\"ע ההמשכה,"
        },
        {
          "s": 15,
          "text": "שציוה אותנו."
        },
        {
          "s": 16,
          "text": "והטעם לזה שאומרים בברכת המצוות"
        },
        {
          "s": 17,
          "text": "(בנוגע להמצוות שניתנו לנו)"
        },
        {
          "s": 18,
          "text": "קדשנו במצוותיו,"
        },
        {
          "s": 19,
          "text": "הוא,"
        },
        {
          "s": 20,
          "text": "כי גם לאחרי שצונו"
        },
        {
          "s": 21,
          "text": "(ונעשו ציוויים להאדם)"
        },
        {
          "s": 22,
          "text": "הם מצוותיו דהקב\"ה כמו שהוא קדוש ומובדל מענין הציווי לאדם."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "וזהו שע\"י התורה הוא המשכת התענוג גם בעבודה דקבלת עול שבקיום המצוות."
        },
        {
          "s": 2,
          "text": "כי זה שקיום המצוות הוא באופן דקבלת עול כעבד המקיים מצות המלך"
        },
        {
          "s": 3,
          "text": "[שהעבד הוא לא האדון אלא שהוא בטל להאדון]"
        },
        {
          "s": 4,
          "text": "הוא מפני שהכוונה בענין המצוות"
        },
        {
          "s": 5,
          "text": "(ציוויים להאדם)"
        },
        {
          "s": 6,
          "text": "היא שהאדם יהי' מציאות שחוץ ממנו"
        },
        {
          "s": 7,
          "text": "(שאין לו תענוג באלקות)"
        },
        {
          "s": 8,
          "text": "ואעפ\"כ יהי' בטל אליו."
        },
        {
          "s": 9,
          "text": "וע\"י המשכת התורה"
        },
        {
          "s": 10,
          "text": "(שלמעלה מציווי לאדם)"
        },
        {
          "s": 11,
          "text": "בהמצוות ובהעבודה דקבלת עול"
        },
        {
          "s": 12,
          "text": "(שהתורה אמרה ועבדתם),"
        },
        {
          "s": 13,
          "text": "נרגש,"
        },
        {
          "s": 14,
          "text": "דזה שהאדם הוא מציאות שחוץ ממנו ית' הוא בכדי להשלים הכוונה העליונה."
        },
        {
          "s": 15,
          "text": "ועי\"ז,"
        },
        {
          "s": 16,
          "text": "הביטול דקב\"ע הוא בכל מציאותו,"
        },
        {
          "s": 17,
          "text": "היינו שגם זה שנעשה כמו מציאות לעצמו הוא בכדי להשלים הכוונה."
        },
        {
          "s": 18,
          "text": "ולכן המציאות שלו אינה סתירה להתענוג שיש לו בעבודתו"
        },
        {
          "s": 19,
          "text": "(היינו לתענוג האדון שנמשכת בו),"
        },
        {
          "s": 20,
          "text": "לפי שגם המציאות שלו היא בכדי להשלים הכוונה."
        }
      ]
    }
  ]
}