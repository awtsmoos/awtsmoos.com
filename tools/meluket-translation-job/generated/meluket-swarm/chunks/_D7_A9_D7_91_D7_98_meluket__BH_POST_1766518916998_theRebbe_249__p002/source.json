{
  "globalIndex": 566,
  "owner": 16,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916998_theRebbe_249__p002",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916998_theRebbe_249__p002",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916998_theRebbe_249",
  "title": "מאמר ארבעה ראשי שנים תשל\"א",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה מבואר בהדרושים21"
        },
        {
          "s": 2,
          "text": "השייכות דג' הרגלים לזמני בישול התבואות,"
        },
        {
          "s": 3,
          "text": "כי אז"
        },
        {
          "s": 4,
          "text": "(בג' רגלים)"
        },
        {
          "s": 5,
          "text": "הוא צמיחת התבואה הרוחניית שע\"י הזריעה."
        },
        {
          "s": 6,
          "text": "והענין הוא,"
        },
        {
          "s": 7,
          "text": "דכתיב22"
        },
        {
          "s": 8,
          "text": "וזרעתי' לי בארץ,"
        },
        {
          "s": 9,
          "text": "וידוע23"
        },
        {
          "s": 10,
          "text": "שזה קאי על ירידת הנשמות"
        },
        {
          "s": 11,
          "text": "(תבואה הרוחניית)"
        },
        {
          "s": 12,
          "text": "למטה להתלבש בגוף ונפש הבהמית"
        },
        {
          "s": 13,
          "text": "(ארץ)24,"
        },
        {
          "s": 14,
          "text": "ובפרטיות יותר על הירידה דהגלות25."
        },
        {
          "s": 15,
          "text": "שהכוונה בזה היא לצורך עלי',"
        },
        {
          "s": 16,
          "text": "בדוגמת זריעה בארץ"
        },
        {
          "s": 17,
          "text": "(כפשוטה)"
        },
        {
          "s": 18,
          "text": "שהיא בשביל הצמיחה בריבוי יותר מכמו שהי' בתחילה26."
        },
        {
          "s": 19,
          "text": "והצמיחה"
        },
        {
          "s": 20,
          "text": "(העלי')"
        },
        {
          "s": 21,
          "text": "היא ע\"י קיום התומ\"צ שנקרא ג\"כ בשם זריעה."
        },
        {
          "s": 22,
          "text": "דנוסף להזריעה דירידת הנשמה למטה"
        },
        {
          "s": 23,
          "text": "(שהקב\"ה הוריד את הנשמה למטה),"
        },
        {
          "s": 24,
          "text": "צריכה להיות גם עבודת הזריעה דישראל,"
        },
        {
          "s": 25,
          "text": "קיום התומ\"צ."
        },
        {
          "s": 26,
          "text": "דע\"י שהנשמות ירדו למטה,"
        },
        {
          "s": 27,
          "text": "ובפרט בזמן הגלות,"
        },
        {
          "s": 28,
          "text": "ומ\"מ הם מקיימים תומ\"צ"
        },
        {
          "s": 29,
          "text": "(באתכפיא ואתהפכא27),"
        },
        {
          "s": 30,
          "text": "עי\"ז נעשה הצמיחה – המשכת גילוי נעלה יותר באין ערוך מהגילוי שהי' להנשמה קודם ירידתה למטה."
        },
        {
          "s": 31,
          "text": "ועיקר גילוי הצמיחה יהי' לעתיד לבוא."
        },
        {
          "s": 32,
          "text": "והארה מזה מאיר גם עכשיו,"
        },
        {
          "s": 33,
          "text": "בג' רגלים."
        },
        {
          "s": 34,
          "text": "ברגל הראשון"
        },
        {
          "s": 35,
          "text": "(חג המצות)"
        },
        {
          "s": 36,
          "text": "שהוא צמיחת בישול שעורים,"
        },
        {
          "s": 37,
          "text": "הו\"ע היראה,"
        },
        {
          "s": 38,
          "text": "שהיא שער הראשון28"
        },
        {
          "s": 39,
          "text": "שעל ידו נכנסים לדבקה בו ית'."
        },
        {
          "s": 40,
          "text": "וזהו ששעורה היא אותיות שעור ה'29,"
        },
        {
          "s": 41,
          "text": "שעור הוא מלשון שער והה' היא ה' תתאה"
        },
        {
          "s": 42,
          "text": "(מלכות)."
        },
        {
          "s": 43,
          "text": "וברגל השני"
        },
        {
          "s": 44,
          "text": "(חג השבועות)"
        },
        {
          "s": 45,
          "text": "הוא צמיחת חטים שהם מאכל אדם,"
        },
        {
          "s": 46,
          "text": "הוא התורה דכתיב בה30"
        },
        {
          "s": 47,
          "text": "זאת התורה אדם."
        },
        {
          "s": 48,
          "text": "וזהו שחטה בגימטריא כ\"ב שרומז על כ\"ב אותיות התורה31."
        },
        {
          "s": 49,
          "text": "ומבואר בדרושים הנ\"ל,"
        },
        {
          "s": 50,
          "text": "שזוהי השייכות דעצרת לפירות האילן"
        },
        {
          "s": 51,
          "text": "(בעצרת על פירות האילן32),"
        },
        {
          "s": 52,
          "text": "כי חטה היא מין אילן"
        },
        {
          "s": 53,
          "text": "(לדיעה אחת33),"
        },
        {
          "s": 54,
          "text": "שרומז על אדם כמ\"ש כי האדם עץ השדה,"
        },
        {
          "s": 55,
          "text": "ובחג השבועות"
        },
        {
          "s": 56,
          "text": "(עצרת)"
        },
        {
          "s": 57,
          "text": "ניתנה תורה,"
        },
        {
          "s": 58,
          "text": "זאת התורה אדם."
        },
        {
          "s": 59,
          "text": "ויש לומר,"
        },
        {
          "s": 60,
          "text": "דכיון דזה שחטה היא מין אילן הוא רק לדיעה אחת,"
        },
        {
          "s": 61,
          "text": "וגם לדיעה זו הוא רק מין אילן34,"
        },
        {
          "s": 62,
          "text": "לכן ענין התורה המרומזת בחטים היא דרגת התורה כמו ששייכת למצוות."
        },
        {
          "s": 63,
          "text": "והתורה עצמה שלמעלה מענין המצוות,"
        },
        {
          "s": 64,
          "text": "עיקר ענין האדם"
        },
        {
          "s": 65,
          "text": "(זאת התורה אדם),"
        },
        {
          "s": 66,
          "text": "מרומזת בפירות האילן."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והענין הוא,"
        },
        {
          "s": 2,
          "text": "דזה שקיום התומ\"צ נקרא בשם זריעה הוא מצד שני ענינים35."
        },
        {
          "s": 3,
          "text": "לפי שע\"י קיום התומ\"צ נעשה בירור הגוף ונפש הבהמית,"
        },
        {
          "s": 4,
          "text": "ועי\"ז מתגלה השרש דהגוף ונה\"ב שלמעלה מהשרש דנפש האלקית – בדוגמת הזריעה כפשוטה,"
        },
        {
          "s": 5,
          "text": "שע\"י זריעת התבואה והגרעין בארץ מתעורר ומתגלה כח הצומח שבארץ36."
        },
        {
          "s": 6,
          "text": "וגם,"
        },
        {
          "s": 7,
          "text": "לפי שקיום התומ\"צ צריך להיות"
        },
        {
          "s": 8,
          "text": "(לא מצד הטעם אלא)"
        },
        {
          "s": 9,
          "text": "בכדי לקיים ציווי הקב\"ה37,"
        },
        {
          "s": 10,
          "text": "כהלשון בברכת המצוות אשר קדשנו במצוותיו וצונו,"
        },
        {
          "s": 11,
          "text": "ביטול דקבלת עול – בדוגמת הזריעה כפשוטה,"
        },
        {
          "s": 12,
          "text": "דהשרשת הגרעין בארץ היא ע\"י רקבון הגרעין."
        },
        {
          "s": 13,
          "text": "וזהו הטעם על זה שעיקר הצמיחה היא ע\"י קיום התומ\"צ בזמן הגלות,"
        },
        {
          "s": 14,
          "text": "כי בזמן הבית,"
        },
        {
          "s": 15,
          "text": "כשהי' גילוי אלקות"
        },
        {
          "s": 16,
          "text": "(כולל גם הגילוי שע\"י קיום המצוות),"
        },
        {
          "s": 17,
          "text": "לא הי' נרגש כ\"כ הביטול דקבלת עול,"
        },
        {
          "s": 18,
          "text": "מכיון שנרגש אז הגילוי שע\"י המצוות."
        },
        {
          "s": 19,
          "text": "ועיקר הביטול דקבלת עול הוא בזמן הגלות,"
        },
        {
          "s": 20,
          "text": "ובפרט בדרא דעקבתא דמשיחא,"
        },
        {
          "s": 21,
          "text": "ועד שקיום המצוות אז הוא באופן דהזורעים בדמעה38,"
        },
        {
          "s": 22,
          "text": "ועי\"ז דוקא ברנה יקצורו38."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה ידוע39"
        },
        {
          "s": 2,
          "text": "החילוק בין תורה למצוות,"
        },
        {
          "s": 3,
          "text": "דהמצוות הם ציוויים להאדם,"
        },
        {
          "s": 4,
          "text": "והתורה היא דבר השם,"
        },
        {
          "s": 5,
          "text": "חכמתו של הקב\"ה,"
        },
        {
          "s": 6,
          "text": "אלא שירדה למטה ונתלבשה בשכל האדם40."
        },
        {
          "s": 7,
          "text": "ומזה מובן,"
        },
        {
          "s": 8,
          "text": "דשני ענינים הנ\"ל שבזריעה"
        },
        {
          "s": 9,
          "text": "(בירור הגוף ונה\"ב וביטול דקב\"ע)"
        },
        {
          "s": 10,
          "text": "הם בעיקר בקיום המצוות,"
        },
        {
          "s": 11,
          "text": "משא\"כ בתורה."
        },
        {
          "s": 12,
          "text": "דבמצוות שהם ציוויים להאדם,"
        },
        {
          "s": 13,
          "text": "שייך לומר שהכוונה בהם הוא בכדי לצרף בהם את הבריות41,"
        },
        {
          "s": 14,
          "text": "בשביל הבירור והזיכוך של הגוף ונה\"ב דהאדם שמקיים את המצוה ובשביל הבירור והזיכוך של הדברים שבעולם שבהם מקיימים את המצוה."
        },
        {
          "s": 15,
          "text": "משא\"כ התורה שהיא חכמתו של הקב\"ה,"
        },
        {
          "s": 16,
          "text": "אין שייך לומר שהיא אמצעי ח\"ו בכדי לפעול בהאדם ובהעולם."
        },
        {
          "s": 17,
          "text": "והפעולה שנעשית על ידה בהאדם הלומדה,"
        },
        {
          "s": 18,
          "text": "הוא,"
        },
        {
          "s": 19,
          "text": "שע\"י לימוד התורה שלו נמשכת בו חכמתו של הקב\"ה שלמעלה מעולם"
        },
        {
          "s": 20,
          "text": "[והמשכת התורה בהאדם הלומדה היא באופן שהוא מתאחד עמה42]."
        },
        {
          "s": 21,
          "text": "ועד\"ז הוא בנוגע להביטול דקב\"ע"
        },
        {
          "s": 22,
          "text": "(ענין השני דזריעה),"
        },
        {
          "s": 23,
          "text": "דבמצוות שהם ציוויים להאדם"
        },
        {
          "s": 24,
          "text": "(שזה מורה שבהדרגא דמצוות יש להאדם תפיסת מקום),"
        },
        {
          "s": 25,
          "text": "האדם הוא מציאות43."
        },
        {
          "s": 26,
          "text": "וזה שמקיים את הציווי הוא מצד הביטול דקבלת עול,"
        },
        {
          "s": 27,
          "text": "כעבד44"
        },
        {
          "s": 28,
          "text": "המקיים מצות המלך."
        },
        {
          "s": 29,
          "text": "ובתורה שהיא חכמתו של הקב\"ה,"
        },
        {
          "s": 30,
          "text": "אין שם נתינת מקום למציאות שחוץ ממנו,"
        },
        {
          "s": 31,
          "text": "גם לא למציאות דעבד,"
        },
        {
          "s": 32,
          "text": "ולכן השלימות דעסק התורה היא כשהלימוד שלו הוא באופן שדבר ה' מדבר בפיו."
        },
        {
          "s": 33,
          "text": "וזהו שארז\"ל45"
        },
        {
          "s": 34,
          "text": "מאן מלכי רבנן,"
        },
        {
          "s": 35,
          "text": "כי לימוד התורה שלהם היא באופן שדבר ה' מדבר על ידם,"
        },
        {
          "s": 36,
          "text": "ולכן הם בתכלית הביטול שלמעלה גם מהביטול דעבד,"
        },
        {
          "s": 37,
          "text": "ועד שכל מציאותם היא המלך עצמו44,"
        },
        {
          "s": 38,
          "text": "שע\"י אורייתא ישראל וקוב\"ה כולא חד46."
        },
        {
          "s": 39,
          "text": "וגם מי שאינו בדרגא זו שלימוד התורה שלו יהי' באופן זה שדבר ה' מדבר בפיו47,"
        },
        {
          "s": 40,
          "text": "מ\"מ,"
        },
        {
          "s": 41,
          "text": "עיקר ההדגשה בעסק התורה הוא לא על ענין הביטול והאתכפיא,"
        },
        {
          "s": 42,
          "text": "אלא אדרבה,"
        },
        {
          "s": 43,
          "text": "על זה שהמציאות שלו"
        },
        {
          "s": 44,
          "text": "(ההבנה וההשגה)"
        },
        {
          "s": 45,
          "text": "תהי' חד עם התורה."
        }
      ]
    }
  ]
}