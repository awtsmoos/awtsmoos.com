{
  "globalIndex": 332,
  "owner": 32,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915661_theRebbe_783__p002",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915661_theRebbe_783__p002",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915661_theRebbe_783",
  "title": "מאמר פדה בשלום תשכ\"ו",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים מ\"ש8"
        },
        {
          "s": 2,
          "text": "יודוך ה' כל מעשיך וחסידיך יברכוכה,"
        },
        {
          "s": 3,
          "text": "ואיתא בזהר9"
        },
        {
          "s": 4,
          "text": "דפירוש יברכוכה הוא יברכו כה."
        },
        {
          "s": 5,
          "text": "ומבאר אדמו\"ר"
        },
        {
          "s": 6,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 7,
          "text": "נ\"ע"
        },
        {
          "s": 8,
          "text": "(במאמרו ד\"ה פדה בשלום העת\"ר10),"
        },
        {
          "s": 9,
          "text": "דכה הוא מלכות11,"
        },
        {
          "s": 10,
          "text": "ויברכו כה הוא להמשיך גילוי אור במלכות."
        },
        {
          "s": 11,
          "text": "ונאמר וחסידיך יברכוכה,"
        },
        {
          "s": 12,
          "text": "דהמשכה זו היא בכח חסידיך דוקא."
        },
        {
          "s": 13,
          "text": "והענין הוא,"
        },
        {
          "s": 14,
          "text": "דזה שחסידיך יברכוכה הוא בסמיכות ובהמשך ליודוך ה' כל מעשיך,"
        },
        {
          "s": 15,
          "text": "הוא,"
        },
        {
          "s": 16,
          "text": "כי ההמשכה במלכות"
        },
        {
          "s": 17,
          "text": "(שע\"י חסידיך)"
        },
        {
          "s": 18,
          "text": "היא ממקום נעלה מאד"
        },
        {
          "s": 19,
          "text": "(אוא\"ס שלמעלה מהשתלשלות)"
        },
        {
          "s": 20,
          "text": "שאין שייך בו השגה אלא הודאה בלבד,"
        },
        {
          "s": 21,
          "text": "יודוך."
        },
        {
          "s": 22,
          "text": "וההמשכה משם"
        },
        {
          "s": 23,
          "text": "(באופן דברכה)"
        },
        {
          "s": 24,
          "text": "היא בכח חסידיך דוקא."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ובכדי להבין גודל העילוי דהמשכה באופן דברכה מהמקום שבו היא ההודאה,"
        },
        {
          "s": 1,
          "text": "מקדים בהמאמר החילוק בין ברכה לתפלה,"
        },
        {
          "s": 2,
          "text": "שבכל אחד מהם יש מעלה לגבי זולתו."
        },
        {
          "s": 3,
          "text": "והענין הוא12,"
        },
        {
          "s": 4,
          "text": "דתפלה היא מלמטה למעלה,"
        },
        {
          "s": 5,
          "text": "היינו שהמתפלל הוא למטה ומבקש שישפיעו לו מלמעלה,"
        },
        {
          "s": 6,
          "text": "וברכה היא מלמעלה למטה,"
        },
        {
          "s": 7,
          "text": "שהמברך הוא למעלה מהשורש שממנו נמשכת הברכה וממשיך אותה מלמעלה למטה."
        },
        {
          "s": 8,
          "text": "וזהו שברכה היא בדרך ציווי,"
        },
        {
          "s": 9,
          "text": "דכיון שהמברך הוא למעלה מהשורש שממנו נמשכת הברכה,"
        },
        {
          "s": 10,
          "text": "לכן בכחו לצוות."
        },
        {
          "s": 11,
          "text": "וזהו שברכה היא דוקא במי שבכחו לברך"
        },
        {
          "s": 12,
          "text": "(כמו אברהם אבינו שאמר לו הקב\"ה הברכות נתונות לך13),"
        },
        {
          "s": 13,
          "text": "[ודלא כתפלה שכל אחד יכול להתפלל,"
        },
        {
          "s": 14,
          "text": "ויתירה מזה שכל אחד נצטווה להתפלל14],"
        },
        {
          "s": 15,
          "text": "כי בכדי לברך,"
        },
        {
          "s": 16,
          "text": "צריך המברך להיות למעלה מהשורש שממנו נמשכת הברכה."
        },
        {
          "s": 17,
          "text": "ומזה מובנת המעלה בברכה לגבי תפלה,"
        },
        {
          "s": 18,
          "text": "דבתפלה,"
        },
        {
          "s": 19,
          "text": "שהיא בקשה שימשיכו את ההשפעה,"
        },
        {
          "s": 20,
          "text": "אין ודאות שתתמלא הבקשה."
        },
        {
          "s": 21,
          "text": "ובברכה שהיא בדרך ציווי – ודאי שתומשך ההשפעה15,"
        },
        {
          "s": 22,
          "text": "כיון שהמברך בכחו לצוות."
        },
        {
          "s": 23,
          "text": "והמעלה בתפלה לגבי ברכה היא בההמשכה עצמה,"
        },
        {
          "s": 24,
          "text": "דההמשכה שע\"י תפלה היא נעלית יותר."
        },
        {
          "s": 25,
          "text": "דענין הברכה הוא להמשיך מה שכבר נמצא בהמקור ולא דבר חדש,"
        },
        {
          "s": 26,
          "text": "וענין התפלה הוא בקשה מהקב\"ה שגם באם לא ישנה ח\"ו ההשפעה גם בהמקור,"
        },
        {
          "s": 27,
          "text": "ולא עוד אלא שנגזר עליו שיהי' חולה ח\"ו וכיו\"ב,"
        },
        {
          "s": 28,
          "text": "מ\"מ,"
        },
        {
          "s": 29,
          "text": "תומשך לו השפעה חדשה מאוא\"ס שלמעלה מהשתלשלות."
        },
        {
          "s": 30,
          "text": "דזהו שאומרים בכמה תפלות יהי רצון,"
        },
        {
          "s": 31,
          "text": "דפירוש יהי רצון הוא שיהי' רצון חדש."
        },
        {
          "s": 32,
          "text": "והטעם על זה שהמשכת אור חדש הוא ע\"י התפלה דוקא,"
        },
        {
          "s": 33,
          "text": "כי למעשה ידיך תכסוף16,"
        },
        {
          "s": 34,
          "text": "ולכן,"
        },
        {
          "s": 35,
          "text": "ע\"י התפלה,"
        },
        {
          "s": 36,
          "text": "עבודת המטה,"
        },
        {
          "s": 37,
          "text": "מגיעים לאוא\"ס שלמעלה מהשתלשלות."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז מובן גודל עילוי הברכה"
        },
        {
          "s": 1,
          "text": "(דחסידיך)"
        },
        {
          "s": 2,
          "text": "שהמשכתה היא מהמקום שבו היא ההודאה,"
        },
        {
          "s": 3,
          "text": "דבברכה זו שתי המעלות."
        },
        {
          "s": 4,
          "text": "שההמשכה היא מאוא\"ס שלמעלה מהשתלשלות,"
        },
        {
          "s": 5,
          "text": "היינו שע\"י ברכה זו נעשה רצון חדש – המעלה דתפלה."
        },
        {
          "s": 6,
          "text": "ואעפ\"כ היא"
        },
        {
          "s": 7,
          "text": "(לא תפלה,"
        },
        {
          "s": 8,
          "text": "בקשה,"
        },
        {
          "s": 9,
          "text": "אלא)"
        },
        {
          "s": 10,
          "text": "ברכה,"
        },
        {
          "s": 11,
          "text": "בדרך ציווי."
        },
        {
          "s": 12,
          "text": "והוא ע\"ד דאיתא בירושלמי17"
        },
        {
          "s": 13,
          "text": "עה\"פ18"
        },
        {
          "s": 14,
          "text": "ותגזר אומר ויקם לך,"
        },
        {
          "s": 15,
          "text": "אפילו הוא"
        },
        {
          "s": 16,
          "text": "(הקב\"ה)"
        },
        {
          "s": 17,
          "text": "אומר הכין ואת אמר הכין,"
        },
        {
          "s": 18,
          "text": "דידך קיימא דידי לא קיימא."
        },
        {
          "s": 19,
          "text": "דזה שהקב\"ה מבטל את גזירתו מפני גזירת הצדיק,"
        },
        {
          "s": 20,
          "text": "הוא,"
        },
        {
          "s": 21,
          "text": "כי הצדיק ממשיך רצון חדש – המעלה דתפלה,"
        },
        {
          "s": 22,
          "text": "ואופן ביטול הגזירה הוא"
        },
        {
          "s": 23,
          "text": "(לא ע\"י בקשה,"
        },
        {
          "s": 24,
          "text": "אלא)"
        },
        {
          "s": 25,
          "text": "ע\"י גזירת הצדיק – מעלת הברכה שהיא בדרך ציווי."
        }
      ]
    }
  ]
}