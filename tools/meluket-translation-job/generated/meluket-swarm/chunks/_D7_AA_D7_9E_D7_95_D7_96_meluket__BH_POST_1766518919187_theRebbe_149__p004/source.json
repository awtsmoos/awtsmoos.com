{
  "globalIndex": 910,
  "owner": 10,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919187_theRebbe_149__p004",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919187_theRebbe_149__p004",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919187_theRebbe_149",
  "title": "מאמר וידבר זאת חוקת תשכ\"ט",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "וממשיך בהמאמר37,"
        },
        {
          "s": 1,
          "text": "דענין העשיר הוא לא רק שאינו חסר שום דבר אלא שהוא מושפע בריבוי השפע."
        },
        {
          "s": 2,
          "text": "וכמאמר רז\"ל38"
        },
        {
          "s": 3,
          "text": "עה\"פ39"
        },
        {
          "s": 4,
          "text": "די מחסורו אשר יחסר לו,"
        },
        {
          "s": 5,
          "text": "די מחסורו ואי אתה מצווה לעשרו."
        },
        {
          "s": 6,
          "text": "וכיון שבדי מחסורו אשר יחסר לו נכלל גם החסרון דסוס לרכוב עליו ועבד לרוץ לפניו,"
        },
        {
          "s": 7,
          "text": "ואעפ\"כ אמרו ואי אתה מצווה לעשרו,"
        },
        {
          "s": 8,
          "text": "הרי מובן,"
        },
        {
          "s": 9,
          "text": "שגם כשיש לו כל צרכיו"
        },
        {
          "s": 10,
          "text": "(כולל גם סוס לרכוב עליו ועבד לרוץ לפניו),"
        },
        {
          "s": 11,
          "text": "אינו"
        },
        {
          "s": 12,
          "text": "(עדיין)"
        },
        {
          "s": 13,
          "text": "עשיר,"
        },
        {
          "s": 14,
          "text": "כי ענין העשיר הוא"
        },
        {
          "s": 15,
          "text": "(דלא רק שיש לו כל צרכיו,"
        },
        {
          "s": 16,
          "text": "אלא)"
        },
        {
          "s": 17,
          "text": "שהוא מושפע בריבוי השפע."
        },
        {
          "s": 18,
          "text": "וע\"פ מ\"ש לעיל דזה שמשה הי' עשיר בגשמיות הוא לפי שהי' עשיר ברוחניות,"
        },
        {
          "s": 19,
          "text": "מובן,"
        },
        {
          "s": 20,
          "text": "דנוסף לזה שבמשה לא הי' שום חסרון ח\"ו"
        },
        {
          "s": 21,
          "text": "(גם לא חסרון שבדוגמת סוס לרכוב עליו וכו'),"
        },
        {
          "s": 22,
          "text": "כי האירו בו בגילוי כל הגילויים השייכים לעולמות,"
        },
        {
          "s": 23,
          "text": "הנכללים בשני הענינים דממלא כל עלמין וסובב כל עלמין,"
        },
        {
          "s": 24,
          "text": "שהגילוי דענינים אלה הוא מילוי החסרון"
        },
        {
          "s": 25,
          "text": "[דאור הממלא,"
        },
        {
          "s": 26,
          "text": "כיון שהוא מקור לעולמות,"
        },
        {
          "s": 27,
          "text": "לכן,"
        },
        {
          "s": 28,
          "text": "כשאור זה אינו בגילוי בעולם,"
        },
        {
          "s": 29,
          "text": "העולם הוא חסר ממש."
        },
        {
          "s": 30,
          "text": "ואור הסובב,"
        },
        {
          "s": 31,
          "text": "שהוא למעלה ממקור לעולמות ורק שייך לעולמות,"
        },
        {
          "s": 32,
          "text": "לכן,"
        },
        {
          "s": 33,
          "text": "כשאינו מתגלה בעולם אור זה,"
        },
        {
          "s": 34,
          "text": "החסרון דעולם הוא דוגמת החסרון דסוס לרכוב עליו ועבד לרוץ לפניו."
        },
        {
          "s": 35,
          "text": "וכמאמר רז\"ל40"
        },
        {
          "s": 36,
          "text": "עה\"פ41"
        },
        {
          "s": 37,
          "text": "ויכל אלקים ביום השביעי מה הי' העולם חסר מנוחה בא שבת בא מנוחה,"
        },
        {
          "s": 38,
          "text": "מנוחה היא בחינת סובב שלמעלה מהאור המתלבש בעולם,"
        },
        {
          "s": 39,
          "text": "ואעפ\"כ כשלא הי' גילוי זה בעולם,"
        },
        {
          "s": 40,
          "text": "הי' העולם חסר,"
        },
        {
          "s": 41,
          "text": "אלא שחסרון זה הוא לא שהי' חסר איזה פרט בהעולם עצמו,"
        },
        {
          "s": 42,
          "text": "כי כל הפרטים דהעולם נתהוו ע\"י מלאכת הבריאה"
        },
        {
          "s": 43,
          "text": "(אור המתלבש בעולם)"
        },
        {
          "s": 44,
          "text": "שנשלמה לפני שבת,"
        },
        {
          "s": 45,
          "text": "וזה שהעולם הי' חסר מנוחה הוא דוגמת החסרון דסוס לרכוב עליו"
        },
        {
          "s": 46,
          "text": "(שאין זה דבר הכרחי לצורך קיום חיותו),"
        },
        {
          "s": 47,
          "text": "וכשבא שבת ונמשך ונתגלה אור הסובב,"
        },
        {
          "s": 48,
          "text": "נתמלא גם חסרון זה."
        },
        {
          "s": 49,
          "text": "וענין העשירות דמשה הוא,"
        },
        {
          "s": 50,
          "text": "דנוסף על זה שהאירו בו בגילוי הגילויים דממלא וסובב],"
        },
        {
          "s": 51,
          "text": "האיר אצלו בגילוי גם הגילוי דאוא\"ס שלמעלה משייכות לעולמות."
        },
        {
          "s": 52,
          "text": "וכמבואר בהמאמר42,"
        },
        {
          "s": 53,
          "text": "דזה שמשה נקרא עשיר הוא לפי שמשה הוא בחינת דעת עליון."
        },
        {
          "s": 54,
          "text": "ומהמעלות שבדעת עליון על דעת תחתון הוא,"
        },
        {
          "s": 55,
          "text": "שדעת תחתון מקבל מחיצוניות הכתר,"
        },
        {
          "s": 56,
          "text": "אריך – סובב,"
        },
        {
          "s": 57,
          "text": "ודעת עליון מקבל מפנימיות הכתר,"
        },
        {
          "s": 58,
          "text": "עתיק – אוא\"ס שלמעלה מגדר עולמות."
        },
        {
          "s": 59,
          "text": "ועפ\"ז צריך להבין עוד יותר הענין דתפלה למשה,"
        },
        {
          "s": 60,
          "text": "תפלת עשיר,"
        },
        {
          "s": 61,
          "text": "הרי ענין התפלה הוא שהקב\"ה ימלא את מחסורו,"
        },
        {
          "s": 62,
          "text": "וכיון שמשה הי' עשיר הן בגשמיות והן ברוחניות,"
        },
        {
          "s": 63,
          "text": "הרי לא רק שלא הי' חסר"
        },
        {
          "s": 64,
          "text": "(בפועל)"
        },
        {
          "s": 65,
          "text": "שום דבר אלא שלא הי' שייך אצלו ענין החסרון43,"
        },
        {
          "s": 66,
          "text": "ומהו\"ע התפלה שלו."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ונקודת הביאור בזה"
        },
        {
          "s": 2,
          "text": "(בהמאמר44),"
        },
        {
          "s": 3,
          "text": "דתפלת עשיר היא לא בשביל עצמו אלא בשביל כנסת ישראל."
        },
        {
          "s": 4,
          "text": "כדאיתא במדרש45"
        },
        {
          "s": 5,
          "text": "עה\"פ תפלה למשה,"
        },
        {
          "s": 6,
          "text": "משל למה הדבר דומה לשלשה שבאו ליטול כו' מאת המלך כו' בא השלישי,"
        },
        {
          "s": 7,
          "text": "אמר לו המלך מה אתה מבקש,"
        },
        {
          "s": 8,
          "text": "אמר לו,"
        },
        {
          "s": 9,
          "text": "איני מבקש על עצמי דבר,"
        },
        {
          "s": 10,
          "text": "אלא מדינה פלונית היא חרבה והיא שלך,"
        },
        {
          "s": 11,
          "text": "גזור שתיבנה כו',"
        },
        {
          "s": 12,
          "text": "כך משה לא ביקש לעצמו אלא בשביל ישראל."
        },
        {
          "s": 13,
          "text": "ולכאורה,"
        },
        {
          "s": 14,
          "text": "ביאור זה צריך לביאור נוסף."
        },
        {
          "s": 15,
          "text": "דלפי הנ\"ל התפלה שהעשיר מתפלל"
        },
        {
          "s": 16,
          "text": "(בשביל אחרים)"
        },
        {
          "s": 17,
          "text": "אינה שייכת להעשירות שלו"
        },
        {
          "s": 18,
          "text": "[דזה שהוא מתפלל בשביל אחרים הוא מפני שהוא רוצה בטובתם],"
        },
        {
          "s": 19,
          "text": "ופירוש תפלת עשיר"
        },
        {
          "s": 20,
          "text": "(בפשטות)"
        },
        {
          "s": 21,
          "text": "הוא שהתפלה שלו היא מפני שהוא עשיר46."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ויובן זה ע\"פ המבואר בהמאמר44"
        },
        {
          "s": 1,
          "text": "דכנסת ישראל היא בחינת מלכות,"
        },
        {
          "s": 2,
          "text": "ובקשת משה עבור כנסת ישראל היתה"
        },
        {
          "s": 3,
          "text": "(בשביל ישראל כפשוטם,"
        },
        {
          "s": 4,
          "text": "וגם)"
        },
        {
          "s": 5,
          "text": "בשביל ספירת המלכות."
        },
        {
          "s": 6,
          "text": "ולכן47"
        },
        {
          "s": 7,
          "text": "אומר במדרש שבקשת משה עבור כנסת ישראל היא ע\"ד הבקשה מדינה פלונית כו',"
        },
        {
          "s": 8,
          "text": "דמדינה היא מלכות,"
        },
        {
          "s": 9,
          "text": "והיא חריבה הוא החסרון שנעשה במלכות"
        },
        {
          "s": 10,
          "text": "(ענין מיעוט הירח),"
        },
        {
          "s": 11,
          "text": "והבקשה גזור שתיבנה היא שיומשך גילוי עצמות אוא\"ס במלכות שעי\"ז תיבנה בבחינת בנין עדי עד."
        },
        {
          "s": 12,
          "text": "דכשנתמלא החסרון דמלכות ע\"י שנמשך בה הגילוי ששייך למלכות,"
        },
        {
          "s": 13,
          "text": "שאז היא מתעלית להדרגא כמו שהיתה קודם שנסתלק ונחסר ממנה האור,"
        },
        {
          "s": 14,
          "text": "אזי אפשר שהאור שנמשך בה יסתלק עוד פעם,"
        },
        {
          "s": 15,
          "text": "ובכדי שהבנין שלה יהי' בבחינת בנין עדי עד"
        },
        {
          "s": 16,
          "text": "(שאין שייך שתיחרב ח\"ו)"
        },
        {
          "s": 17,
          "text": "הוא ע\"י שנמשך בה גילוי עצמות אוא\"ס שלמעלה מהאור השייך לעולמות"
        },
        {
          "s": 18,
          "text": "(מלכות),"
        },
        {
          "s": 19,
          "text": "דבאור זה אין שייך צמצום וסילוק."
        },
        {
          "s": 20,
          "text": "וזהו שתפלת משה נקראת תפלת עשיר דפירוש תפלת עשיר הוא שהתפלה שלו היא מפני שהוא עשיר"
        },
        {
          "s": 21,
          "text": "(כנ\"ל),"
        },
        {
          "s": 22,
          "text": "כי זה שמשה התפלל שיומשך במלכות גילוי עצמות אוא\"ס"
        },
        {
          "s": 23,
          "text": "(שעי\"ז דוקא תיבנה בבחינת בנין עדי עד)"
        },
        {
          "s": 24,
          "text": "הוא מפני שהי' עשיר,"
        },
        {
          "s": 25,
          "text": "בחינת דעת עליון שמקבל מעתיק,"
        },
        {
          "s": 26,
          "text": "עצמות אוא\"ס שלמעלה מגדר עולמות."
        }
      ]
    }
  ]
}