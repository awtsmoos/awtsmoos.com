{
  "globalIndex": 1114,
  "owner": 14,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920460_theRebbe_154__p001",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920460_theRebbe_154__p001",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920460_theRebbe_154",
  "title": "מאמר אתם נצבים תשל\"ט",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ נצבים-וילך,"
        },
        {
          "s": 2,
          "text": "כ\"ג אלול ה'תשל\"ט*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "אתם נצבים היום כולכם לפני הוי' אלקיכם ראשיכם שבטיכם גו' מחוטב עציך עד שואב מימיך1."
        },
        {
          "s": 1,
          "text": "ואיתא בלקו\"ת2"
        },
        {
          "s": 2,
          "text": "דפרשה זו קורין לעולם קודם ר\"ה3"
        },
        {
          "s": 3,
          "text": "ומרומז במלת היום דקאי על ר\"ה4"
        },
        {
          "s": 4,
          "text": "כי זה5"
        },
        {
          "s": 5,
          "text": "היום תחלת מעשיך זכרון ליום ראשון."
        },
        {
          "s": 6,
          "text": "וזהו מ\"ש אתם נצבים היום כולכם גו',"
        },
        {
          "s": 7,
          "text": "שכל בני ישראל מראשיכם שבטיכם גו' עד חוטב עציך ושואב מימיך הם מתאחדים יחד להיות לאחדים כאחד6,"
        },
        {
          "s": 8,
          "text": "כי הכלי להברכות וההמשכות שלמעלה הוא ענין האחדות,"
        },
        {
          "s": 9,
          "text": "כמ\"ש7"
        },
        {
          "s": 10,
          "text": "ברכנו אבינו"
        },
        {
          "s": 11,
          "text": "(כאשר)"
        },
        {
          "s": 12,
          "text": "כולנו כאחד דוקא"
        },
        {
          "s": 13,
          "text": "(כמבואר בארוכה בתניא פרק לב,"
        },
        {
          "s": 14,
          "text": "לקו\"ת ד\"ה החלצו8,"
        },
        {
          "s": 15,
          "text": "ובסהמ\"צ להצ\"צ מצות אהבת ישראל)."
        },
        {
          "s": 16,
          "text": "ובהיות שבר\"ה היא המשכת החיות על כל השנה,"
        },
        {
          "s": 17,
          "text": "כידוע"
        },
        {
          "s": 18,
          "text": "(ומבואר בארוכה בעט\"ר9,"
        },
        {
          "s": 19,
          "text": "וברמז בלקו\"ת10)"
        },
        {
          "s": 20,
          "text": "דנקרא ראש השנה"
        },
        {
          "s": 21,
          "text": "(ולא תחלת השנה)"
        },
        {
          "s": 22,
          "text": "כי הוא בדוגמת הראש שכולל בתוכו כל אברי הגוף,"
        },
        {
          "s": 23,
          "text": "וגם כמו שהאברים הם במקומם נמצא בהם הראש ועד שהוא המנהיג אותם"
        },
        {
          "s": 24,
          "text": "(שכל האברים נשמעים לרצונו),"
        },
        {
          "s": 25,
          "text": "עד\"ז הוא בהיום דר\"ה,"
        },
        {
          "s": 26,
          "text": "שבו נמשך כל החיות של כל ימי השנה,"
        },
        {
          "s": 27,
          "text": "וגם הנהגתם אח\"כ היא כפי אופן המשכתם בר\"ה"
        },
        {
          "s": 28,
          "text": "(ועד\"ז הוא בעבודת האדם,"
        },
        {
          "s": 29,
          "text": "שהנהגתו בכל ימי השנה היא כפי אופן ההחלטות בר\"ה)."
        },
        {
          "s": 30,
          "text": "וזהו אתם נצבים היום כולכם גו',"
        },
        {
          "s": 31,
          "text": "כי ההכנה והכלי להמשכה זו הוא כולכם,"
        },
        {
          "s": 32,
          "text": "ההתאחדות דבני ישראל להיות לאחדים כאחד,"
        },
        {
          "s": 33,
          "text": "שעי\"ז הם כלים להשראת יחודו ית'."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ומפרט הכתוב עשר מדריגות"
        },
        {
          "s": 2,
          "text": "(ראשיכם שבטיכם גו' מחוטב עציך עד שואב מימיך),"
        },
        {
          "s": 3,
          "text": "שכמו שיש עשר מדריגות בנפש האדם דהיינו ג' שכלים וז' מדות,"
        },
        {
          "s": 4,
          "text": "כך כל ישראל הם קומה אחת שלימה שנחלקת לעשר מדריגות11."
        },
        {
          "s": 5,
          "text": "והענין הוא,"
        },
        {
          "s": 6,
          "text": "שהאחדות דבני ישראל מה שהם מתאחדים להיות לאחדים כאחד שעי\"ז הם נעשים כלים להשראת יחודו ית',"
        },
        {
          "s": 7,
          "text": "הוא לא באופן שאין בהם חילוקי מדריגות"
        },
        {
          "s": 8,
          "text": "(גם לא שמצד הגילוי דבחינת יחיד הם מתבטלים ממציאותם),"
        },
        {
          "s": 9,
          "text": "כי אם,"
        },
        {
          "s": 10,
          "text": "דכמו שהם בבחינת מציאות ונחלקים לעשר מדריגות,"
        },
        {
          "s": 11,
          "text": "מכל מקום הם מתאחדים בהתאחדות גמורה."
        },
        {
          "s": 12,
          "text": "דהתאחדות זו"
        },
        {
          "s": 13,
          "text": "(התאחדות של פרטים)"
        },
        {
          "s": 14,
          "text": "היא כמו ההתאחדות דבחינת אחד"
        },
        {
          "s": 15,
          "text": "(שלמטה מבחינת יחיד)."
        },
        {
          "s": 16,
          "text": "וכידוע12"
        },
        {
          "s": 17,
          "text": "ההפרש בין אחד ליחיד,"
        },
        {
          "s": 18,
          "text": "דיחיד הוא למעלה מהתחלקות משא\"כ אחד הוא שישנם דברים מחולקים אלא שהם מתאחדים."
        },
        {
          "s": 19,
          "text": "וכמרומז גם בהאותיות דתיבת אחד,"
        },
        {
          "s": 20,
          "text": "שהח' והד' מורים לז' רקיעים וארץ וד' רוחות העולם13,"
        },
        {
          "s": 21,
          "text": "והם בטלים להאל\"ף."
        },
        {
          "s": 22,
          "text": "והאל\"ף אינו שולל את מציאות העולם,"
        },
        {
          "s": 23,
          "text": "שהאל\"ף עצמו פירושו אלופו של עולם13,"
        },
        {
          "s": 24,
          "text": "והאל\"ף הוא הראש דתיבת אחד שכולל14"
        },
        {
          "s": 25,
          "text": "(כנ\"ל בענין ראש)"
        },
        {
          "s": 26,
          "text": "את הח'"
        },
        {
          "s": 27,
          "text": "(ז' רקיעים וארץ)"
        },
        {
          "s": 28,
          "text": "והד'"
        },
        {
          "s": 29,
          "text": "(ד' רוחות העולם),"
        },
        {
          "s": 30,
          "text": "וע\"י התאחדות זו דבני ישראל"
        },
        {
          "s": 31,
          "text": "[שהם בבחינת מציאות ונחלקים לעשר מדריגות וביחד ע\"ז לאחדים כאחד]"
        },
        {
          "s": 32,
          "text": "הם נעשים רשות היחיד ליחודו ית',"
        },
        {
          "s": 33,
          "text": "היינו לבחינת יחיד"
        },
        {
          "s": 34,
          "text": "(שלמעלה מבחינת אחד)15,"
        },
        {
          "s": 35,
          "text": "גילוי דבחינת יחיד שנמשך בבחינת חי העולמים מלך,"
        },
        {
          "s": 36,
          "text": "ועד להמציאות והתחלקות המדריגות16"
        },
        {
          "s": 37,
          "text": "עד לבחינת חוטב עציך ושואב מימיך."
        },
        {
          "s": 38,
          "text": "ואדרבה,"
        },
        {
          "s": 39,
          "text": "ע\"י ההתאחדות דבני ישראל גם כמו שהם נחלקים לעשר מדריגות עד לבחינת חוטב עציך ושואב מימיך,"
        },
        {
          "s": 40,
          "text": "עי\"ז נעשים חד עם עצמותו ית'."
        }
      ]
    }
  ]
}