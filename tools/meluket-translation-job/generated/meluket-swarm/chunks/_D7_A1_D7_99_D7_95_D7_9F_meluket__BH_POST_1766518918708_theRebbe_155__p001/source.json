{
  "globalIndex": 825,
  "owner": 25,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918708_theRebbe_155__p001",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918708_theRebbe_155__p001",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918708_theRebbe_155",
  "title": "מאמר בשעה שעלה משה למרום תשכ\"ה",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ליל א' דחג השבועות"
        },
        {
          "s": 2,
          "text": "(לפנות בוקר),"
        },
        {
          "s": 3,
          "text": "ה'תשכ\"ה"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "בשעה1 שעלה משה למרום אמרו מלאכי השרת לפני הקב\"ה,"
        },
        {
          "s": 1,
          "text": "רבש\"ע,"
        },
        {
          "s": 2,
          "text": "מה לילוד אשה בינינו,"
        },
        {
          "s": 3,
          "text": "אמר להן לקבל תורה בא,"
        },
        {
          "s": 4,
          "text": "אמרו לפניו,"
        },
        {
          "s": 5,
          "text": "חמדה2"
        },
        {
          "s": 6,
          "text": "גנוזה כו' אתה מבקש ליתנה לבשר ודם כו' תנה הודך על השמים3,"
        },
        {
          "s": 7,
          "text": "אמר לו הקב\"ה למשה החזיר להן תשובה כו',"
        },
        {
          "s": 8,
          "text": "אמר לפניו,"
        },
        {
          "s": 9,
          "text": "רבש\"ע,"
        },
        {
          "s": 10,
          "text": "תורה שאתה נותן לי מה כתיב בה4"
        },
        {
          "s": 11,
          "text": "אנכי ה' אלקיך אשר הוצאתיך מארץ מצרים כו',"
        },
        {
          "s": 12,
          "text": "למצרים ירדתם כו' תורה למה תהא לכם,"
        },
        {
          "s": 13,
          "text": "שוב מה כתיב בה5"
        },
        {
          "s": 14,
          "text": "לא יהי' לך אלקים אחרים,"
        },
        {
          "s": 15,
          "text": "בין עמים אתם שרויין שעובדין ע\"ז,"
        },
        {
          "s": 16,
          "text": "שוב מה כתיב בה6"
        },
        {
          "s": 17,
          "text": "זכור את יום השבת לקדשו,"
        },
        {
          "s": 18,
          "text": "כלום אתם עושים מלאכה שאתם צריכין שבות,"
        },
        {
          "s": 19,
          "text": "שוב מה כתיב בה7"
        },
        {
          "s": 20,
          "text": "לא תשא,"
        },
        {
          "s": 21,
          "text": "משא ומתן יש ביניכם,"
        },
        {
          "s": 22,
          "text": "שוב מה כתיב בה8"
        },
        {
          "s": 23,
          "text": "כבד את אביך ואת אמך,"
        },
        {
          "s": 24,
          "text": "אב ואם יש לכם,"
        },
        {
          "s": 25,
          "text": "שוב מה כתיב בה9"
        },
        {
          "s": 26,
          "text": "לא תרצח לא תנאף לא תגנוב,"
        },
        {
          "s": 27,
          "text": "קנאה יש ביניכם יצה\"ר יש ביניכם."
        },
        {
          "s": 28,
          "text": "[ויש לומר,"
        },
        {
          "s": 29,
          "text": "שבהתשובה דמשה רבינו על טענת המלאכים,"
        },
        {
          "s": 30,
          "text": "שני ענינים בכללות."
        },
        {
          "s": 31,
          "text": "למצרים ירדתם היא תשובה בנוגע לכללות התורה,"
        },
        {
          "s": 32,
          "text": "דכיון שהטעם על כללות הענין דמתן תורה הוא אנכי ה' אלקיך אשר הוצאתיך מארץ מצרים,"
        },
        {
          "s": 33,
          "text": "לכן,"
        },
        {
          "s": 34,
          "text": "כיון שלמצרים ירדתם"
        },
        {
          "s": 35,
          "text": "(בתמי')"
        },
        {
          "s": 36,
          "text": "תורה למה תהא לכם,"
        },
        {
          "s": 37,
          "text": "ולאח\"ז מוסיף שוב מה כתיב בה,"
        },
        {
          "s": 38,
          "text": "שגם הציוויים הפרטים שבתורה"
        },
        {
          "s": 39,
          "text": "(לא יהי' לך,"
        },
        {
          "s": 40,
          "text": "זכור את יום השבת,"
        },
        {
          "s": 41,
          "text": "וכו')"
        },
        {
          "s": 42,
          "text": "שייכים לישראל ולא למלאכים]."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "וצריך להבין,"
        },
        {
          "s": 1,
          "text": "דבקשת המלאכים תנה הודך על השמים היתה שתנתן להם תורה כמו שהיא ברוחניות,"
        },
        {
          "s": 2,
          "text": "ומה השיב להם משה כלום אתם עושים מלאכה וכו'."
        },
        {
          "s": 3,
          "text": "גם צריך להבין מה שהשיב משה בנוגע להמצוות לא תרצח לא תנאף לא תגנוב קנאה יש ביניכם יצה\"ר יש ביניכם,"
        },
        {
          "s": 4,
          "text": "דכיון שהמלאכים אין קנאה ביניהם ואין להם יצה\"ר לכן אין צריך לצוות ולהזהיר אותם על מצוות אלו,"
        },
        {
          "s": 5,
          "text": "דלכאורה עדיפא הוה לי' למימר,"
        },
        {
          "s": 6,
          "text": "שגם המצוות עצמם"
        },
        {
          "s": 7,
          "text": "(כמו שהם בגשמיות)"
        },
        {
          "s": 8,
          "text": "אינם שייכים למלאכים"
        },
        {
          "s": 9,
          "text": "(כמו שאמר לפנ\"ז בנוגע למצות שבת,"
        },
        {
          "s": 10,
          "text": "לא תשא,"
        },
        {
          "s": 11,
          "text": "וכיבוד אב ואם)."
        }
      ]
    }
  ]
}