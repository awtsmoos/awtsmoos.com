{
  "globalIndex": 623,
  "owner": 23,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917370_theRebbe_643__p004",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917370_theRebbe_643__p004",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917370_theRebbe_643",
  "title": "מאמר וקבל היהודים תשל\"ח",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וע\"פ הנ\"ל יובן מ\"ש וקבל היהודים את אשר החלו לעשות,"
        },
        {
          "s": 2,
          "text": "דהגם שבשעת מ\"ת היו ישראל בתכלית המעלה"
        },
        {
          "s": 3,
          "text": "(ואז כבר ניתן הכל,"
        },
        {
          "s": 4,
          "text": "כנ\"ל),"
        },
        {
          "s": 5,
          "text": "מ\"מ הי' אז רק החלו לעשות,"
        },
        {
          "s": 6,
          "text": "התחלה בלבד,"
        },
        {
          "s": 7,
          "text": "כי זה הי' רק מלמעלה למטה."
        },
        {
          "s": 8,
          "text": "ואח\"כ בהעבודה שבזמן הגלות,"
        },
        {
          "s": 9,
          "text": "בזמן מרדכי ואסתר,"
        },
        {
          "s": 10,
          "text": "כאשר הוא תוקף הגלות בחושך כפול ומכופל"
        },
        {
          "s": 11,
          "text": "(וכמו שהי' בפשטות)"
        },
        {
          "s": 12,
          "text": "הנה אז העבודה היא מצד התחתונים,"
        },
        {
          "s": 13,
          "text": "וקבל היהודים,"
        },
        {
          "s": 14,
          "text": "שזה לא הי' בשעת מ\"ת."
        },
        {
          "s": 15,
          "text": "ועוד זאת,"
        },
        {
          "s": 16,
          "text": "שבהעבודה שבזמן הגלות ישנו עילוי לגבי שעת מ\"ת,"
        },
        {
          "s": 17,
          "text": "שדוקא אז נעשה הקיום בהתורה שקבלו במ\"ת שהיא בבחי' החלו לעשות בלבד,"
        },
        {
          "s": 18,
          "text": "כי דוקא בזמן הגלות"
        },
        {
          "s": 19,
          "text": "[כפשוטו,"
        },
        {
          "s": 20,
          "text": "וכן בדקות הענינים,"
        },
        {
          "s": 21,
          "text": "כשמתבונן"
        },
        {
          "s": 22,
          "text": "(ע\"ד הנ\"ל)"
        },
        {
          "s": 23,
          "text": "שגם לאחר כל הענינים שפעל בעבודתו,"
        },
        {
          "s": 24,
          "text": "אפילו כשהם בתכלית השלימות,"
        },
        {
          "s": 25,
          "text": "מ\"מ עדיין הוא בבחי' גלות"
        },
        {
          "s": 26,
          "text": "(ברוחניות),"
        },
        {
          "s": 27,
          "text": "כי מכיון שהקב\"ה עוזרו67"
        },
        {
          "s": 28,
          "text": "ביכולתו הוא להגיע לדרגא נעלית יותר ועד לאין ערוך,"
        },
        {
          "s": 29,
          "text": "ע\"ד לשון חז\"ל68"
        },
        {
          "s": 30,
          "text": "(יגעת)"
        },
        {
          "s": 31,
          "text": "ומצאת שהמציאה היא שלא בערך יגיעתו והשתדלותו69]"
        },
        {
          "s": 32,
          "text": "דאז הנה כאו\"א נשבר ונדכא,"
        },
        {
          "s": 33,
          "text": "הנה אז מגיעים למאור עצמו."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ויש לקשר מה שנת\"ל בגודל העילוי שבעבודת התחתונים,"
        },
        {
          "s": 2,
          "text": "שע\"י דוקא נעשה הקיום דמה שהחלו לעשות,"
        },
        {
          "s": 3,
          "text": "עם פרשת השבוע"
        },
        {
          "s": 4,
          "text": "[ובזה גופא עם השיעור דהיום דיום השלישי"
        },
        {
          "s": 5,
          "text": "[שענינו הוא שהוכפל בו כי טוב70,"
        },
        {
          "s": 6,
          "text": "טוב לשמים וטוב לבריות71]"
        },
        {
          "s": 7,
          "text": "– ע\"פ תקנת כ\"ק מו\"ח אדמו\"ר ללמוד בכל יום מימות השבוע פרשה אחת בפרשת השבוע]"
        },
        {
          "s": 8,
          "text": "ע\"פ המבואר בהמאמרים72"
        },
        {
          "s": 9,
          "text": "ובפרט במאמר כ\"ק אדמו\"ר"
        },
        {
          "s": 10,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 11,
          "text": "נ\"ע שלפני ששים שנה73"
        },
        {
          "s": 12,
          "text": "בפרשתנו עה\"פ74"
        },
        {
          "s": 13,
          "text": "ועתה אם נא מצאתי חן בעיניך גו' למען אמצא חן בעיניך גו' כי מצאתי חן בעיניך גו' כי מצאת חן בעיני"
        },
        {
          "s": 14,
          "text": "[דעי\"ז יהי' ונפלינו אני ועמך מכל העם אשר על פני האדמה"
        },
        {
          "s": 15,
          "text": "(דונפלינו הוא כענין נפלא שנת\"ל)]"
        },
        {
          "s": 16,
          "text": "דצריך להבין מהי המעלה בענין החן שמשה רבינו ביקש והפציר כ\"כ ע\"ז ועד שזה הי' תכלית השלימות דבקשתו,"
        },
        {
          "s": 17,
          "text": "וע\"י החן יהי' אח\"כ ונפלינו אני ועמך,"
        },
        {
          "s": 18,
          "text": "דהלא כתיב75"
        },
        {
          "s": 19,
          "text": "שקר החן גו',"
        },
        {
          "s": 20,
          "text": "והוא מפני שהחן הוא בחי' אתעדל\"ע מצ\"ע,"
        },
        {
          "s": 21,
          "text": "ויש יתרון גדול במה שבא באתעדל\"ת."
        },
        {
          "s": 22,
          "text": "ומבאר שם בזה דישנה בחי' אתעדל\"ע הנמשך לאחר האתעדל\"ת שזהו המשכה מבחי' עצמות א\"ס שאין אתעדל\"ת מגעת לשם כלל והוא רק בבחי' מתנה"
        },
        {
          "s": 23,
          "text": "(והוא הנק' מתנת חנם שהוא לשון חן כו')"
        },
        {
          "s": 24,
          "text": "רק שזה נמשך לאחרי שלימות האתעדל\"ת,"
        },
        {
          "s": 25,
          "text": "וכמו גבי מתנה דאמרז\"ל76"
        },
        {
          "s": 26,
          "text": "אי לאו דעביד לי' נייחא לנפשי' כו' הגם שהיא בבחי' מתנה."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "והנה העבודה שבזה היא"
        },
        {
          "s": 1,
          "text": "[כמובן ע\"פ המבואר בהמאמר שם77],"
        },
        {
          "s": 2,
          "text": "דישנו78"
        },
        {
          "s": 3,
          "text": "ענין האמונה שבבחי' ממכ\"ע אך בבחי' זו שייך שיהי' מעין זה גם בחסידי אוה\"ע ועד שבישראל אפשר שבחי' ממכ\"ע תהי' בבחי' ידיעה."
        },
        {
          "s": 4,
          "text": "ועיקר האמונה דנש\"י הוא במדריגת סוכ\"ע,"
        },
        {
          "s": 5,
          "text": "דאמונה זו שייכת רק בישראל79,"
        },
        {
          "s": 6,
          "text": "דזהו מ\"ש80"
        },
        {
          "s": 7,
          "text": "שמע ישראל ה' אלקינו ה' אחד שזהו\"ע הקבלה והאמונה בבחי' סוכ\"ע ובזה נאמר שמע ישראל דוקא שאמונה זו היא רק בנש\"י"
        },
        {
          "s": 8,
          "text": "[משא\"כ מ\"ש ברוך שם כבוד מלכותו לעולם ועד קאי על ההתבוננות דבחי' ממכ\"ע]81."
        },
        {
          "s": 9,
          "text": "וזהו ג\"כ מה דאיתא בזהר82"
        },
        {
          "s": 10,
          "text": "דהע' דשמע והד' דאחד הן אותיות רבתי וע\"י צירופם נעשה תיבת עד,"
        },
        {
          "s": 11,
          "text": "ומבואר בכ\"מ83"
        },
        {
          "s": 12,
          "text": "דעל דבר הנגלה אין צריך ואין שייך עדות,"
        },
        {
          "s": 13,
          "text": "ואפילו על מילתא דעביד לאגלויי כו' לא הצריכה התורה עדות84,"
        },
        {
          "s": 14,
          "text": "כ\"א דוקא על דבר הנעלם לגמרי,"
        },
        {
          "s": 15,
          "text": "בחי' סוכ\"ע."
        },
        {
          "s": 16,
          "text": "וזהו מ\"ש שמע ישראל וגו' אחד,"
        },
        {
          "s": 17,
          "text": "דקאי על כאו\"א מישראל שהם דוקא העדים המעידים85"
        },
        {
          "s": 18,
          "text": "דהוי' אחד"
        },
        {
          "s": 19,
          "text": "[עד שבכל מעמד ומצב שיהי' בעבודתו הנה כאו\"א מישראל אומר שמע ישראל,"
        },
        {
          "s": 20,
          "text": "כמבואר בשיחות כ\"ק מו\"ח אדמו\"ר86],"
        },
        {
          "s": 21,
          "text": "דהח' וד' דאחד מרמזים על ז' רקיעים וארץ וד' רוחות העולם והאל\"ף מרמזת לאלופו של עולם87,"
        },
        {
          "s": 22,
          "text": "וישראל בעבודתם פועלים להיות אחד,"
        },
        {
          "s": 23,
          "text": "היינו שממשיכים בעולם"
        },
        {
          "s": 24,
          "text": "(בח' וד')"
        },
        {
          "s": 25,
          "text": "את אלופו של עולם"
        },
        {
          "s": 26,
          "text": "(הא'),"
        },
        {
          "s": 27,
          "text": "עד שיתאחדו בדוגמא לתיבת אחד שהא' היא תיבה א' עם הח' וד'"
        },
        {
          "s": 28,
          "text": "(ותוכן התיבה עצמה הו\"ע האחדות),"
        },
        {
          "s": 29,
          "text": "ובאופן כזה שהא' דאלופו של עולם יהי' ראש88"
        },
        {
          "s": 30,
          "text": "והתחלת התיבה."
        },
        {
          "s": 31,
          "text": "והנה ע\"י אתעדל\"ת זו דעבודת ישראל בבחי' סוכ\"ע"
        },
        {
          "s": 32,
          "text": "(הוי' אחד),"
        },
        {
          "s": 33,
          "text": "הנה ממשיכים בחי' אתעדל\"ע שלפי ערך האתעדל\"ת ואח\"כ נמשך בחי' אתעדל\"ע שלמעלה מבחי' אתעדל\"ע שע\"י אתעדל\"ת."
        },
        {
          "s": 34,
          "text": "דבחי' אתעדל\"ע הנמשכת על ידי האתעדל\"ת היא בחי' שבערך לסדר ההשתלשלות,"
        },
        {
          "s": 35,
          "text": "וי\"ל דגם על זה קאי מ\"ש89"
        },
        {
          "s": 36,
          "text": "הנה מלאכי ילך לפניך,"
        },
        {
          "s": 37,
          "text": "אך בקשת משה הי' שיהי' המשכת בחי' אתעדל\"ע שלמעלה מזה שמצ\"ע,"
        },
        {
          "s": 38,
          "text": "ועתה אם נא מצאתי חן בעיניך,"
        },
        {
          "s": 39,
          "text": "ענין החן,"
        },
        {
          "s": 40,
          "text": "עד שיהי' ונפלינו אני ועמך,"
        },
        {
          "s": 41,
          "text": "דקאי"
        },
        {
          "s": 42,
          "text": "(בספירות)"
        },
        {
          "s": 43,
          "text": "על ספירת הכתר,"
        },
        {
          "s": 44,
          "text": "פנימיות הכתר ועד לעצומ\"ה ית'."
        },
        {
          "s": 45,
          "text": "דהגם דבחי' אתעדל\"ע זו נמשכת מצ\"ע היינו שאין אתעדל\"ת מגיע לשם,"
        },
        {
          "s": 46,
          "text": "מ\"מ הרי קוב\"ה לא שריא אלא באתר שלים90,"
        },
        {
          "s": 47,
          "text": "דצ\"ל תחלה עבודת התחתונים באתעדל\"ת והמשכת האתעדל\"ע שלפי ערך האתעדל\"ת ואז בהאתר שלים נמשך להיות קוב\"ה שריא כמבואר בלקו\"ת שה\"ש91."
        }
      ]
    }
  ]
}