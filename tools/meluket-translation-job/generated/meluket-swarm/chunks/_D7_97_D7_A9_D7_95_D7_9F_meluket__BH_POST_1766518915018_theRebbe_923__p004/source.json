{
  "globalIndex": 211,
  "owner": 11,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915018_theRebbe_923__p004",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915018_theRebbe_923__p004",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518915018_theRebbe_923",
  "title": "מאמר ואברהם זקן תשל\"ז",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "והנה זה שמסופר בתורה שבע\"פ שאברהם זכה לבחינת כל ע\"י שעמד בעשר נסיונות הוא"
        },
        {
          "s": 2,
          "text": "(ככל הענינים שבתורה מלשון הוראה60)"
        },
        {
          "s": 3,
          "text": "הוראה שצריך להיות"
        },
        {
          "s": 4,
          "text": "(דוגמת61)"
        },
        {
          "s": 5,
          "text": "העבודה דנסיונות,"
        },
        {
          "s": 6,
          "text": "היינו,"
        },
        {
          "s": 7,
          "text": "שהעבודה צריכה להיות ביגיעה גדולה,"
        },
        {
          "s": 8,
          "text": "יגיעה שלא ע\"ד הרגיל,"
        },
        {
          "s": 9,
          "text": "בדוגמת העבודה דנסיונות."
        },
        {
          "s": 10,
          "text": "וזהו דאיתא בזהר שם עה\"פ62"
        },
        {
          "s": 11,
          "text": "עין לא ראתה גו' יעשה למחכה לו,"
        },
        {
          "s": 12,
          "text": "מאי למחכה לו כו' אינון דדחקין למלה דחוכמתא כו'"
        },
        {
          "s": 13,
          "text": "[וענין זה שבזהר בא בהמשך להפירוש מאי בכל,"
        },
        {
          "s": 14,
          "text": "כמובא בהמאמר],"
        },
        {
          "s": 15,
          "text": "שע\"י היגיעה בתורה,"
        },
        {
          "s": 16,
          "text": "יגיעה שלא ע\"ד הרגיל"
        },
        {
          "s": 17,
          "text": "[וכמבואר בהמאמר דדחקין למלה דחוכמתא הוא יגיעה בדרך אור חוזר],"
        },
        {
          "s": 18,
          "text": "ומזה נמשך שגם קיום המצוות יהי' ביגיעה גדולה"
        },
        {
          "s": 19,
          "text": "(ע\"ד מרז\"ל63"
        },
        {
          "s": 20,
          "text": "גדול לימוד שמביא לידי מעשה),"
        },
        {
          "s": 21,
          "text": "כולל גם היגיעה בהפצת המעינות חוצה,"
        },
        {
          "s": 22,
          "text": "דנוסף להיגיעה שצריכה להיות בלימוד והבנת המעינות"
        },
        {
          "s": 23,
          "text": "(דחקין למלה דחוכמתא),"
        },
        {
          "s": 24,
          "text": "צריכה להיות יגיעה מיוחדת להפיץ את המעינות חוצה,"
        },
        {
          "s": 25,
          "text": "להביא את המעינות גם לאלו שנמצאים חוצה,"
        },
        {
          "s": 26,
          "text": "\"בין החוחים\","
        },
        {
          "s": 27,
          "text": "ועי\"ז יהי' אתי מר דא מלכא משיחא64,"
        },
        {
          "s": 28,
          "text": "שאז יהי' גילוי העלם העצמי,"
        },
        {
          "s": 29,
          "text": "עין לא ראתה,"
        },
        {
          "s": 30,
          "text": "במהרה בימינו ממש."
        }
      ]
    }
  ]
}