{
  "globalIndex": 601,
  "owner": 1,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917207_theRebbe_479__p002",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917207_theRebbe_479__p002",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518917207_theRebbe_479",
  "title": "מאמר ואלה המשפטים תשמ\"א",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ויובן בהקדים דרשת רז\"ל21"
        },
        {
          "s": 2,
          "text": "עה\"פ ואלה המשפטים אשר תשים לפניהם,"
        },
        {
          "s": 3,
          "text": "דמזה שנאמר אשר תשים לפניהם"
        },
        {
          "s": 4,
          "text": "(ולא אשר תלמדם וכיו\"ב)"
        },
        {
          "s": 5,
          "text": "למדין שאין מספיק שהרב שונה לתלמידיו ההלכות כמה פעמים עד שיהיו סדורים בפיהם אלא צריך גם לשום לפניהם טעם המיישב תלמודם."
        },
        {
          "s": 6,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 7,
          "text": "דמ\"ש לאח\"ז כי תקנה לשון יחיד הוא לרמז,"
        },
        {
          "s": 8,
          "text": "דכי תקנה קאי"
        },
        {
          "s": 9,
          "text": "(גם)"
        },
        {
          "s": 10,
          "text": "על אשר תשים22,"
        },
        {
          "s": 11,
          "text": "שהרב צריך לשנות לתלמידיו באופן שענין הנלמד יהי' הקנין שלהם."
        },
        {
          "s": 12,
          "text": "וכמארז\"ל23"
        },
        {
          "s": 13,
          "text": "עה\"פ24"
        },
        {
          "s": 14,
          "text": "בתורת ה' חפצו ובתורתו יהגה יומם ולילה,"
        },
        {
          "s": 15,
          "text": "שבתחלה נקראת התורה על שמו של הקב\"ה"
        },
        {
          "s": 16,
          "text": "(תורת ה')"
        },
        {
          "s": 17,
          "text": "ואח\"כ נקראת על שמו"
        },
        {
          "s": 18,
          "text": "(תורתו),"
        },
        {
          "s": 19,
          "text": "תורה דילי' היא25."
        },
        {
          "s": 20,
          "text": "וזה שהתורה נעשית קנינו של האדם העוסק בתורה"
        },
        {
          "s": 21,
          "text": "(תורה דילי' היא)"
        },
        {
          "s": 22,
          "text": "הוא דוקא כשיודע טעמי ההלכות26."
        },
        {
          "s": 23,
          "text": "וזהו אשר תשים לפניהם כי תקנה,"
        },
        {
          "s": 24,
          "text": "דע\"י הלימוד באופן דתשים לפניהם,"
        },
        {
          "s": 25,
          "text": "עי\"ז נעשית התורה קנינו של האדם הלומד,"
        },
        {
          "s": 26,
          "text": "כי תקנה."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "גם יש לומר,"
        },
        {
          "s": 1,
          "text": "דזה שלאחרי אומרו אשר תשים לפניהם ממשיך כי תקנה,"
        },
        {
          "s": 2,
          "text": "הוא לפי שכי תקנה הוא ציווי נוסף על הציווי דתשים לפניהם."
        },
        {
          "s": 3,
          "text": "ויובן זה בהקדים שלכאורה אינו מובן,"
        },
        {
          "s": 4,
          "text": "הרי זה שהתורה מתלבשת בשכלו של האדם הלומד עד שנעשית תורתו הוא ירידה"
        },
        {
          "s": 5,
          "text": "(לכאורה)"
        },
        {
          "s": 6,
          "text": "לגבי התורה כמו שהיא תורת הוי',"
        },
        {
          "s": 7,
          "text": "וממארז\"ל הנ\"ל"
        },
        {
          "s": 8,
          "text": "(ואח\"כ נקראת על שמו)"
        },
        {
          "s": 9,
          "text": "משמע דזה שהתורה נעשית תורתו"
        },
        {
          "s": 10,
          "text": "(של האדם הלומד)"
        },
        {
          "s": 11,
          "text": "הוא מעלה."
        },
        {
          "s": 12,
          "text": "ונקודת הביאור בזה,"
        },
        {
          "s": 13,
          "text": "דירידת והמשכת התורה למטה היא באופן שגם לאחרי שירדה למטה ונתלבשה בשכל אנושי היא חכמתו של הקב\"ה שלמעלה משכל הנבראים."
        },
        {
          "s": 14,
          "text": "וזה שהיא מובנת גם בשכל אנושי הוא מפני ששרשה הוא באוא\"ס הבל\"ג שאינו מוגבל בהגדרים דמעלה ומטה,"
        },
        {
          "s": 15,
          "text": "ולכן ביכלתה להיות גם למטה27."
        },
        {
          "s": 16,
          "text": "והיינו,"
        },
        {
          "s": 17,
          "text": "דנוסף לזה שגם בירידתה למטה היא נשארת במהותה – חכמתו של הקב\"ה,"
        },
        {
          "s": 18,
          "text": "הנה אדרבה,"
        },
        {
          "s": 19,
          "text": "ע\"י ירידתה למטה נעשה בה יתרון לגבי דרגת התורה כמו שהיתה למעלה לפני ירידתה למטה."
        },
        {
          "s": 20,
          "text": "כי ע\"י ירידתה למטה מתגלה בה שרשה באוא\"ס הבל\"ג28."
        },
        {
          "s": 21,
          "text": "ועד\"ז הוא בנוגע לזה שע\"י לימוד התורה בהבנה והשגה נעשית תורתו של האדם הלומד,"
        },
        {
          "s": 22,
          "text": "שגם לאחרי שהיא נעשית תורתו של האדם הלומד היא נשארת במהותה תורת הוי',"
        },
        {
          "s": 23,
          "text": "ויתירה מזה,"
        },
        {
          "s": 24,
          "text": "דע\"י שתורת הוי' נעשית תורתו של האדם,"
        },
        {
          "s": 25,
          "text": "נעשה בה יתרון לגבי דרגת התורה כמו שהיא מצד עצמה,"
        },
        {
          "s": 26,
          "text": "תורת הוי'29."
        },
        {
          "s": 27,
          "text": "כי זה שתורת הוי' נעשית תורתו של האדם30"
        },
        {
          "s": 28,
          "text": "[ובאופן שגם לאחרי שנעשית תורתו של האדם היא נשארת במהותה,"
        },
        {
          "s": 29,
          "text": "תורת הוי'31,"
        },
        {
          "s": 30,
          "text": "ואעפ\"כ היא תורתו של האדם],"
        },
        {
          "s": 31,
          "text": "הוא ע\"י גילוי אוא\"ס"
        },
        {
          "s": 32,
          "text": "(שלמעלה מהוי'),"
        },
        {
          "s": 33,
          "text": "שמחבר ומאחד את האדם עם הוי',"
        },
        {
          "s": 34,
          "text": "ישראל וקוב\"ה כולא חד."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה שני ענינים הנ\"ל שבתורה,"
        },
        {
          "s": 2,
          "text": "כמו שהיא תורת הוי' וכמו שהיא תורתו"
        },
        {
          "s": 3,
          "text": "(של האדם הלומדה),"
        },
        {
          "s": 4,
          "text": "הם"
        },
        {
          "s": 5,
          "text": "(בדרך כלל)"
        },
        {
          "s": 6,
          "text": "התורה כמו שהיא באצילות וכמו שהיא בבריאה."
        },
        {
          "s": 7,
          "text": "כדאיתא בל\"ת להאריז\"ל32,"
        },
        {
          "s": 8,
          "text": "דהטעם על זה שהתורה מתחלת בבי\"ת הוא כי האל\"ף דתורה הוא התורה שבאצילות והתורה שאנו לומדים בהבנה והשגה היא התורה כמו שהיא בבריאה,"
        },
        {
          "s": 9,
          "text": "הבי\"ת דתורה."
        },
        {
          "s": 10,
          "text": "ומבואר בחסידות33"
        },
        {
          "s": 11,
          "text": "דזהו מ\"ש34"
        },
        {
          "s": 12,
          "text": "ועל תורתך שלמדתנו,"
        },
        {
          "s": 13,
          "text": "ועל תורתך באצילות שלמדתנו בבריאה."
        },
        {
          "s": 14,
          "text": "והנה ידוע35"
        },
        {
          "s": 15,
          "text": "שאצילות נקרא בשם קנין."
        },
        {
          "s": 16,
          "text": "כמ\"ש36"
        },
        {
          "s": 17,
          "text": "ברוך עושך ברוך יוצרך ברוך בוראך ברוך קונך,"
        },
        {
          "s": 18,
          "text": "דעושך יוצרך ובוראך הם ג' העולמות עשי' יצירה ובריאה,"
        },
        {
          "s": 19,
          "text": "וקונך הוא אצילות."
        },
        {
          "s": 20,
          "text": "דכמו שקנין אינו הוויית דבר חדש אלא גילוי ההעלם"
        },
        {
          "s": 21,
          "text": "[דגם קודם הקנין הי' הדבר,"
        },
        {
          "s": 22,
          "text": "אלא שקודם הקנין,"
        },
        {
          "s": 23,
          "text": "כשהדבר הי' ברשות המוכר,"
        },
        {
          "s": 24,
          "text": "הי' בהעלם לגבי הלוקח,"
        },
        {
          "s": 25,
          "text": "וע\"י הקנין בא הדבר אליו בגילוי],"
        },
        {
          "s": 26,
          "text": "כן האצילות הוא גילוי ההעלם."
        },
        {
          "s": 27,
          "text": "וזהו שלאחרי אומרו אשר תשים לפניהם מוסיף כי תקנה,"
        },
        {
          "s": 28,
          "text": "דהגם שלימוד התורה צריך להיות בהבנה והשגה"
        },
        {
          "s": 29,
          "text": "(אשר תשים לפניהם),"
        },
        {
          "s": 30,
          "text": "ועד שנקראת על שמו,"
        },
        {
          "s": 31,
          "text": "תורתו"
        },
        {
          "s": 32,
          "text": "(של האדם הלומדה),"
        },
        {
          "s": 33,
          "text": "מ\"מ צריך להיות הלימוד באופן שיהי' נרגש אצלו שהתורה שלומד"
        },
        {
          "s": 34,
          "text": "(גם לאחרי שנעשית חכמתו)"
        },
        {
          "s": 35,
          "text": "היא תורת הוי',"
        },
        {
          "s": 36,
          "text": "תורתך שבאצילות,"
        },
        {
          "s": 37,
          "text": "תקנה."
        },
        {
          "s": 38,
          "text": "ועפ\"ז יש לבאר מה דאיתא בירושלמי דתשים הוא מלשון סימה שאינה נגלית,"
        },
        {
          "s": 39,
          "text": "רזי תורה,"
        },
        {
          "s": 40,
          "text": "כי בכדי שבהתורה שהאדם לומד ומבין בשכלו"
        },
        {
          "s": 41,
          "text": "(שכל אנושי)"
        },
        {
          "s": 42,
          "text": "יהי' נרגש שהיא תורת הוי',"
        },
        {
          "s": 43,
          "text": "תורתך שבאצילות"
        },
        {
          "s": 44,
          "text": "(כי תקנה),"
        },
        {
          "s": 45,
          "text": "הוא ע\"י גילוי הנשמה כמו שהיא באצילות,"
        },
        {
          "s": 46,
          "text": "בחינת טהורה37"
        },
        {
          "s": 47,
          "text": "היא"
        },
        {
          "s": 48,
          "text": "(שלמעלה מבחינת אתה37"
        },
        {
          "s": 49,
          "text": "בראתה)38,"
        },
        {
          "s": 50,
          "text": "וגילוי בחינה זו דהנשמה"
        },
        {
          "s": 51,
          "text": "(סתים דנשמה)"
        },
        {
          "s": 52,
          "text": "הוא ע\"י לימוד פנימיות התורה,"
        },
        {
          "s": 53,
          "text": "סתים דאורייתא39."
        },
        {
          "s": 54,
          "text": "וזהו אשר תשים לפניהם כי תקנה,"
        },
        {
          "s": 55,
          "text": "דע\"י תשים מלשון סימה,"
        },
        {
          "s": 56,
          "text": "לימוד פנימיות התורה,"
        },
        {
          "s": 57,
          "text": "נעשה הגילוי דפנימיות הנשמה40"
        },
        {
          "s": 58,
          "text": "– לפניהם לפנימיותם40,"
        },
        {
          "s": 59,
          "text": "ועי\"ז גם בהתורה שלומד באופן דתשים לפניהם"
        },
        {
          "s": 60,
          "text": "[הבנה והסברה,"
        },
        {
          "s": 61,
          "text": "טעם שמיישב תלמודו],"
        },
        {
          "s": 62,
          "text": "נרגש תורתך שבאצילות,"
        },
        {
          "s": 63,
          "text": "כי תקנה."
        }
      ]
    }
  ]
}