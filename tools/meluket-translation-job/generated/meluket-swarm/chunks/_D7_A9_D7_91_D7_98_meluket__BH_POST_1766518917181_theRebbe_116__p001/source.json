{
  "globalIndex": 597,
  "owner": 47,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917181_theRebbe_116__p001",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917181_theRebbe_116__p001",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518917181_theRebbe_116",
  "title": "מאמר זה יתנו תש\"מ",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ משפטים,"
        },
        {
          "s": 2,
          "text": "פ' שקלים,"
        },
        {
          "s": 3,
          "text": "מבה\"ח וער\"ח אדר ה'תש\"מ*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "זה יתנו כל העובר על הפקודים מחצית השקל בשקל הקודש עשרים גרה השקל מחצית השקל תרומה לה' וגו'1"
        },
        {
          "s": 1,
          "text": "ומסיים2"
        },
        {
          "s": 2,
          "text": "לכפר על נפשותיכם."
        },
        {
          "s": 3,
          "text": "ומדייק בהמאמר דש\"פ משפטים ופ' שקלים תר\"פ"
        },
        {
          "s": 4,
          "text": "(פר\"ת)3,"
        },
        {
          "s": 5,
          "text": "דצלה\"ב מהו\"ע ב\"פ מחצית בשקל,"
        },
        {
          "s": 6,
          "text": "שאומר מחצית השקל בשקל הקודש,"
        },
        {
          "s": 7,
          "text": "וכופל עוד מחצית השקל תרומה לה'."
        },
        {
          "s": 8,
          "text": "גם מהו\"ע עשרים גרה השקל,"
        },
        {
          "s": 9,
          "text": "שהרי צריך ליתן רק מחצית השקל."
        },
        {
          "s": 10,
          "text": "גם צלה\"ב מ\"ש לכפר על נפשותיכם,"
        },
        {
          "s": 11,
          "text": "וכמו שממשיך ומבאר שם דענין מחצית השקל הוא לכפר על חטא העגל4,"
        },
        {
          "s": 12,
          "text": "וצלה\"ב מהו מעלת מחצית השקל כ\"כ שמכפר על החטא."
        },
        {
          "s": 13,
          "text": "ויש להוסיף בזה"
        },
        {
          "s": 14,
          "text": "(בתור הערה בדא\"פ),"
        },
        {
          "s": 15,
          "text": "דחטא העגל הוא חטא כללי והוא המקור והשורש לכל החטאים ועונות ופשעים."
        },
        {
          "s": 16,
          "text": "וכדאיתא בגמרא5"
        },
        {
          "s": 17,
          "text": "דבשעת מ\"ת פסקה זוהמתן"
        },
        {
          "s": 18,
          "text": "(שהטיל נחש בחוה),"
        },
        {
          "s": 19,
          "text": "ואחרי חטא העגל חזרה6."
        },
        {
          "s": 20,
          "text": "והגם שלא חזרה לגמרי כמו שהיתה לפני זה7,"
        },
        {
          "s": 21,
          "text": "שהרי גם אחרי חטא העגל נשאר ענין הבחירה בעם ישראל,"
        },
        {
          "s": 22,
          "text": "ובנו בחרת8,"
        },
        {
          "s": 23,
          "text": "בהגוף החומרי הנדמה בחומריותו לגופות אומות העולם9"
        },
        {
          "s": 24,
          "text": "(וראה בגמרא שם10"
        },
        {
          "s": 25,
          "text": "מפני מה עכו\"ם מזוהמים כו'),"
        },
        {
          "s": 26,
          "text": "מ\"מ הרי חטא העגל הוא החטא הכללי,"
        },
        {
          "s": 27,
          "text": "ועליו כתיב11"
        },
        {
          "s": 28,
          "text": "וביום פקדי"
        },
        {
          "s": 29,
          "text": "(על כל חטא)"
        },
        {
          "s": 30,
          "text": "ופקדתי וכו'."
        },
        {
          "s": 31,
          "text": "ולפי זה דרוש ביאור ביותר מהי מעלת מחצית השקל שמכפר על חטא זה."
        },
        {
          "s": 32,
          "text": "והנה מתרומה זו"
        },
        {
          "s": 33,
          "text": "(דמחצית השקל)"
        },
        {
          "s": 34,
          "text": "קנו את הקרבנות ציבור במשך כל השנה,"
        },
        {
          "s": 35,
          "text": "דענין הקרבנות עתה הוא ענין התפלה,"
        },
        {
          "s": 36,
          "text": "וכמרז\"ל12"
        },
        {
          "s": 37,
          "text": "תפלות במקום קרבנות תקנום,"
        },
        {
          "s": 38,
          "text": "ומזה מובן,"
        },
        {
          "s": 39,
          "text": "דענין מחצית השקל ישנו ג\"כ בעבודת התפלה."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ולהבין כ\"ז ממשיך לבאר בהמאמר13"
        },
        {
          "s": 2,
          "text": "ענין התפלה,"
        },
        {
          "s": 3,
          "text": "ומביא ע\"ז מארז\"ל14"
        },
        {
          "s": 4,
          "text": "אין עומדין להתפלל אלא מתוך כובד ראש."
        },
        {
          "s": 5,
          "text": "ויש להוסיף בזה,"
        },
        {
          "s": 6,
          "text": "ע\"פ מ\"ש בתוס' במס' מנחות15"
        },
        {
          "s": 7,
          "text": "שהלשון אין כו' אלא כו' בא למעט שפסול בדיעבד."
        },
        {
          "s": 8,
          "text": "וכן הוא פירוש הענין בפשטות,"
        },
        {
          "s": 9,
          "text": "דאין עומדין להתפלל,"
        },
        {
          "s": 10,
          "text": "היינו שאינו שייך ענין התפלה,"
        },
        {
          "s": 11,
          "text": "אלא מתוך כובד ראש."
        },
        {
          "s": 12,
          "text": "ומביא ע\"ז את פירוש הרב המגיד נ\"ע16"
        },
        {
          "s": 13,
          "text": "שהתפלה תהי' על הכובד שבראש,"
        },
        {
          "s": 14,
          "text": "דכאשר מתפלל על החסרון לא יתפלל על החסרון שלו כ\"א על החסרון שלמעלה,"
        },
        {
          "s": 15,
          "text": "כי לא יש חסרון למטה שלא יש חסרון למעלה."
        },
        {
          "s": 16,
          "text": "ומבאר,"
        },
        {
          "s": 17,
          "text": "דענין החסרון שלמעלה הוא כמרז\"ל17"
        },
        {
          "s": 18,
          "text": "בזמן שהאדם מצטער השכינה מה לשון אומרת כבי' קלני מראשי קלני מזרועי,"
        },
        {
          "s": 19,
          "text": "דשכינה היא בחי' המלכות שיש בה עליות וירידות וכו'."
        },
        {
          "s": 20,
          "text": "וזהו\"ע הכובד ראש דשכינה,"
        },
        {
          "s": 21,
          "text": "וזהו אין עומדין להתפלל אלא מתוך כובד ראש,"
        },
        {
          "s": 22,
          "text": "היינו על הכובד והחסרון שבראש."
        },
        {
          "s": 23,
          "text": "ואח\"כ מביא את פירוש רבינו הזקן"
        },
        {
          "s": 24,
          "text": "(וכ\"ה גם בד\"ה אין עומדין להתפלל לכ\"ק מו\"ח אדמו\"ר18)"
        },
        {
          "s": 25,
          "text": "דראש קאי על נשמות ישראל."
        },
        {
          "s": 26,
          "text": "ישראל לי ראש,"
        },
        {
          "s": 27,
          "text": "ובזה ישנו ענין הכובד ראש שע\"י העונות,"
        },
        {
          "s": 28,
          "text": "וכמ\"ש19"
        },
        {
          "s": 29,
          "text": "כי עונותי עברו ראשי כמשא כבד יכבדו ממני."
        }
      ]
    }
  ]
}