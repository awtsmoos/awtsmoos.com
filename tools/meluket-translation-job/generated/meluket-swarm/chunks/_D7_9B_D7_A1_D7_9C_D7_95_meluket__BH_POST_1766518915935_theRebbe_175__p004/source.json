{
  "globalIndex": 384,
  "owner": 34,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915935_theRebbe_175__p004",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915935_theRebbe_175__p004",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915935_theRebbe_175",
  "title": "מאמר ואתה ברחמיך הרבים תשמ\"ח",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ויש להוסיף,"
        },
        {
          "s": 1,
          "text": "דזה שגם הנסים דנצחון המלחמה ומציאת פך השמן הם מהוי' דלעילא שלמעלה מהשתלשלות"
        },
        {
          "s": 2,
          "text": "(אלא שנתלבשו בדרגות דהשתלשלות,"
        },
        {
          "s": 3,
          "text": "יחו\"ת ויחו\"ע),"
        },
        {
          "s": 4,
          "text": "הוא"
        },
        {
          "s": 5,
          "text": "(בעיקר)"
        },
        {
          "s": 6,
          "text": "מפני שהם היו הכנה להנס דהספקת השמן לשמונה ימים,"
        },
        {
          "s": 7,
          "text": "נס שאינו מלובש בטבע."
        },
        {
          "s": 8,
          "text": "דנסים אלו מצד עצמם הם"
        },
        {
          "s": 9,
          "text": "(בעיקר)"
        },
        {
          "s": 10,
          "text": "הענינים דיחו\"ת ויחו\"ע."
        },
        {
          "s": 11,
          "text": "וע\"י שהנס דנצחון המלחמה הי' סיבה להנס דמציאת פך השמן"
        },
        {
          "s": 12,
          "text": "(כנ\"ל בתחילת המאמר),"
        },
        {
          "s": 13,
          "text": "הנה לאחרי שנעשה בו"
        },
        {
          "s": 14,
          "text": "(בהפך שמצאו)"
        },
        {
          "s": 15,
          "text": "נס והדליקו ממנו שמונה ימים,"
        },
        {
          "s": 16,
          "text": "עי\"ז נמשך גילוי הוי' דלעילא שלמעלה מהשתלשלות גם בהנס דמציאת פך השמן וגם בהנס דנצחון המלחמה."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וזהו שקבעו התחלת ימי חנוכה בכ\"ה בכסלו שבו הי' נס הנרות,"
        },
        {
          "s": 2,
          "text": "כי השלימות של הנס דנצחון המלחמה37"
        },
        {
          "s": 3,
          "text": "שהי' בכ\"ד בכסלו"
        },
        {
          "s": 4,
          "text": "(יחו\"ת)"
        },
        {
          "s": 5,
          "text": "הוא,"
        },
        {
          "s": 6,
          "text": "שמגלים בו ע\"י נס השמן שגם הוא"
        },
        {
          "s": 7,
          "text": "(הנס דנצחון המלחמה)"
        },
        {
          "s": 8,
          "text": "שרשו הוא למעלה מהשתלשלות."
        },
        {
          "s": 9,
          "text": "ואף שיש מעלה ביחו\"ת על יחו\"ע"
        },
        {
          "s": 10,
          "text": "[ויש לומר,"
        },
        {
          "s": 11,
          "text": "דזהו מה שהנס דנצחון המלחמה הי' הסיבה לנס השמן,"
        },
        {
          "s": 12,
          "text": "דהסיבה היא למעלה מהמסובב38],"
        },
        {
          "s": 13,
          "text": "מ\"מ,"
        },
        {
          "s": 14,
          "text": "הרי השלימות דיחו\"ת הוא שיהי' בו האור והגילוי דיחו\"ע,"
        },
        {
          "s": 15,
          "text": "כמבואר בהמאמר39."
        },
        {
          "s": 16,
          "text": "והטעם על זה שביום כ\"ו בכסלו לא חידשו דבר40,"
        },
        {
          "s": 17,
          "text": "הוא,"
        },
        {
          "s": 18,
          "text": "כמבואר בהמאמר39,"
        },
        {
          "s": 19,
          "text": "לפי שעיקר הגילוי דהוי' דלעילא יהי' לעתיד לבוא,"
        },
        {
          "s": 20,
          "text": "כנור של ימות המשיח של ח' נימין41,"
        },
        {
          "s": 21,
          "text": "משא\"כ בבית המקדש האיר רק הגילוי דהוי' דלתתא,"
        },
        {
          "s": 22,
          "text": "שלכן כנור של ביהמ\"ק הי' של ז' נימין41,"
        },
        {
          "s": 23,
          "text": "והגילוי דהוי' דלעילא שהי' בהנס דהספקת השמן הי' רק לפי שעה"
        },
        {
          "s": 24,
          "text": "(בהשנה שבה הי' הנס),"
        },
        {
          "s": 25,
          "text": "ולכן לא קבעו שבכ\"ו בכסלו יחדשו איזה דבר42."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ויהי רצון,"
        },
        {
          "s": 2,
          "text": "שיקויים בנו ענין זה דעמדת להם בעת צרתם,"
        },
        {
          "s": 3,
          "text": "דקאי על כללות ענין הגלות שהוא הצרה הכי גדולה."
        },
        {
          "s": 4,
          "text": "[דהגם שכבר עברו כל השמדות ולא יהיו עוד כמ\"ש אדמו\"ר האמצעי43,"
        },
        {
          "s": 5,
          "text": "ולא תקום פעמיים גו'44,"
        },
        {
          "s": 6,
          "text": "כיון שכבר די במה שעברנו עד עתה,"
        },
        {
          "s": 7,
          "text": "ועכשיו הכל הוא בטוב,"
        },
        {
          "s": 8,
          "text": "ואדרבא,"
        },
        {
          "s": 9,
          "text": "עוד בזמן הגלות מתקיים בכאו\"א מישראל והיו מלכים אומניך ושרותיהם מניקותיך45,"
        },
        {
          "s": 10,
          "text": "וכדאיתא בגמרא46"
        },
        {
          "s": 11,
          "text": "שענין זה כבר הי' בפועל בזמן הש\"ס,"
        },
        {
          "s": 12,
          "text": "ובפרט כשהמלכות עוזרת לישראל בעסק התומ\"צ,"
        },
        {
          "s": 13,
          "text": "וגם כשנדמה שיש איזה בלבול הרי הולכים בדרכו של אברהם אבינו,"
        },
        {
          "s": 14,
          "text": "היהודי הראשון,"
        },
        {
          "s": 15,
          "text": "שבראותו נהר המעכבו מלקיים ציווי השם,"
        },
        {
          "s": 16,
          "text": "עמד בתוקף ולא נתפעל,"
        },
        {
          "s": 17,
          "text": "ואז נתגלה שלא הי' לזה שום מציאות אלא הוא דמיון בלבד47,"
        },
        {
          "s": 18,
          "text": "מ\"מ,"
        },
        {
          "s": 19,
          "text": "המצב דגלות"
        },
        {
          "s": 20,
          "text": "(באיזה אופן שיהי')"
        },
        {
          "s": 21,
          "text": "הוא צרה]."
        },
        {
          "s": 22,
          "text": "והבקשה היא שבקרוב ממש יהי' עמדת להם בעת צרתם."
        },
        {
          "s": 23,
          "text": "וכיון שבכל צרתם לו צר48"
        },
        {
          "s": 24,
          "text": "(לו בו'49),"
        },
        {
          "s": 25,
          "text": "הרי בודאי שבקרוב ממש מוציא הקב\"ה את ישראל מהגלות,"
        },
        {
          "s": 26,
          "text": "כמ\"ש50"
        },
        {
          "s": 27,
          "text": "ושב ה' אלקיך את שבותך,"
        },
        {
          "s": 28,
          "text": "והשיב לא נאמר אלא ושב,"
        },
        {
          "s": 29,
          "text": "ועד שבאים להודות ולהלל לשמך הגדול,"
        },
        {
          "s": 30,
          "text": "והדליקו נרות בחצרות קדשך1,"
        },
        {
          "s": 31,
          "text": "בבית המקדש השלישי,"
        },
        {
          "s": 32,
          "text": "מקדש אד' כוננו ידיך51."
        }
      ]
    }
  ]
}