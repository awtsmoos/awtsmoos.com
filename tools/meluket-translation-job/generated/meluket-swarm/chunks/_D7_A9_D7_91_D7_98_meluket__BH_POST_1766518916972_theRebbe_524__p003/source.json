{
  "globalIndex": 562,
  "owner": 12,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916972_theRebbe_524__p003",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916972_theRebbe_524__p003",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916972_theRebbe_524",
  "title": "מאמר באתי לגני תשמ\"ח",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר בפרק ח\"י"
        },
        {
          "s": 2,
          "text": "(הפרק שלומדים בשנה זו23"
        },
        {
          "s": 3,
          "text": "בפעם השני',"
        },
        {
          "s": 4,
          "text": "כפלים לתושי'24),"
        },
        {
          "s": 5,
          "text": "דביאור הענין"
        },
        {
          "s": 6,
          "text": "(ששרש הנצח הוא בפנימיות הכתר)"
        },
        {
          "s": 7,
          "text": "יובן ע\"פ מ\"ש25"
        },
        {
          "s": 8,
          "text": "וגם נצח ישראל לא ישקר ולא ינחם כי לא אדם הוא להנחם,"
        },
        {
          "s": 9,
          "text": "דזה שנצח ישראל לא ינחם הוא לפי ששרש הנצח הוא בבחי' לא אדם."
        },
        {
          "s": 10,
          "text": "דענין ניחומין וחרטה שייך רק בבחי' אדם."
        },
        {
          "s": 11,
          "text": "והטעם על זה הוא,"
        },
        {
          "s": 12,
          "text": "כי אדם הוא מוחין ומדות,"
        },
        {
          "s": 13,
          "text": "היינו מדות שע\"פ שכל ושכל השייך למדות,"
        },
        {
          "s": 14,
          "text": "ולכן שייך בו שינוי,"
        },
        {
          "s": 15,
          "text": "דמכיון שהמדות דאדם הם ע\"פ שכל,"
        },
        {
          "s": 16,
          "text": "לכן,"
        },
        {
          "s": 17,
          "text": "כשנעשה שינוי בהשכל משתנים המדות."
        },
        {
          "s": 18,
          "text": "ועד\"ז הוא גם ברצון שלמעלה מהשכל,"
        },
        {
          "s": 19,
          "text": "שגם הוא בכלל ציור אדם,"
        },
        {
          "s": 20,
          "text": "מוחין ומדות."
        },
        {
          "s": 21,
          "text": "דברצון יש המדות שבו והטעם שבו,"
        },
        {
          "s": 22,
          "text": "טעם כמוס."
        },
        {
          "s": 23,
          "text": "ומכיון ששכל"
        },
        {
          "s": 24,
          "text": "(גם טעם כמוס)"
        },
        {
          "s": 25,
          "text": "הוא דבר המשתנה,"
        },
        {
          "s": 26,
          "text": "לכן,"
        },
        {
          "s": 27,
          "text": "כשנעשה,"
        },
        {
          "s": 28,
          "text": "שינוי בטעם הכמוס,"
        },
        {
          "s": 29,
          "text": "משתנה הרצון"
        },
        {
          "s": 30,
          "text": "(מדות שברצון)."
        },
        {
          "s": 31,
          "text": "דכל זה הוא בחיצוניות הרצון,"
        },
        {
          "s": 32,
          "text": "שדוגמתו למעלה הוא חיצוניות הכתר."
        },
        {
          "s": 33,
          "text": "משא\"כ בפנימיות הכתר,"
        },
        {
          "s": 34,
          "text": "דאין שם בחי' מדות ולא טעם כמוס,"
        },
        {
          "s": 35,
          "text": "אין שייך שם ענין הניחומין וחרטה."
        },
        {
          "s": 36,
          "text": "ויש לומר,"
        },
        {
          "s": 37,
          "text": "דזה שמוסיף בהמאמר דאין שם בחי' מדות"
        },
        {
          "s": 38,
          "text": "[אף שענין הניחומין וחרטה הוא ע\"י השינוי שנעשה בהטעם,"
        },
        {
          "s": 39,
          "text": "וזה שבפנימיות הרצון"
        },
        {
          "s": 40,
          "text": "(הכתר)"
        },
        {
          "s": 41,
          "text": "אין שייך ניחומין וחרטה הוא,"
        },
        {
          "s": 42,
          "text": "לכאורה,"
        },
        {
          "s": 43,
          "text": "מצד זה דאין שם טעם כמוס]"
        },
        {
          "s": 44,
          "text": "הוא,"
        },
        {
          "s": 45,
          "text": "כי עי\"ז מובן יותר הענין דלא אדם הוא להנחם."
        },
        {
          "s": 46,
          "text": "דלא רק שבפנימיות הכתר אין סיבה לענין הנחמה והשינוי"
        },
        {
          "s": 47,
          "text": "[דברצון שיש לו טעם,"
        },
        {
          "s": 48,
          "text": "מכיון שטעם הוא דבר המשתנה,"
        },
        {
          "s": 49,
          "text": "הרי שינוי הטעם הוא סיבה לשינוי הרצון,"
        },
        {
          "s": 50,
          "text": "משא\"כ רצון שלמעלה מהטעם אין סיבה שישתנה],"
        },
        {
          "s": 51,
          "text": "אלא יתירה מזו,"
        },
        {
          "s": 52,
          "text": "שאינו גם בגדר שינוי."
        },
        {
          "s": 53,
          "text": "דבבחינת המדות,"
        },
        {
          "s": 54,
          "text": "מכיון שבמדות ישנם ב' קוין,"
        },
        {
          "s": 55,
          "text": "חסד ודין,"
        },
        {
          "s": 56,
          "text": "שייך שיהי' שינוי מחסד לדין ומדין לחסד,"
        },
        {
          "s": 57,
          "text": "משא\"כ בפנימיות הכתר,"
        },
        {
          "s": 58,
          "text": "דאין שם בחי' מדות,"
        },
        {
          "s": 59,
          "text": "היינו שהוא למעלה מציור קוין,"
        },
        {
          "s": 60,
          "text": "דלית שמאלא בהאי עתיקא26"
        },
        {
          "s": 61,
          "text": "(כמובא בהמאמר),"
        },
        {
          "s": 62,
          "text": "הרי אין שייך כלל שישתנה לדין"
        },
        {
          "s": 63,
          "text": "(שמאל),"
        },
        {
          "s": 64,
          "text": "מכיון דשם לית שמאלא27,"
        },
        {
          "s": 65,
          "text": "וכולא ימין26."
        },
        {
          "s": 66,
          "text": "וזהו מ\"ש וגם נצח ישראל גו' לא ינחם כי לא אדם הוא להנחם,"
        },
        {
          "s": 67,
          "text": "דנצח ישראל הוא בבחי' לא אדם,"
        },
        {
          "s": 68,
          "text": "פנימיות הכתר28."
        },
        {
          "s": 69,
          "text": "וכדאיתא בזהר29"
        },
        {
          "s": 70,
          "text": "עה\"פ30"
        },
        {
          "s": 71,
          "text": "הנה לא ינום ולא יישן שומר ישראל,"
        },
        {
          "s": 72,
          "text": "שהוא בחינת עין אחת"
        },
        {
          "s": 73,
          "text": "(שלמעלה משתי עינים31),"
        },
        {
          "s": 74,
          "text": "עין אחת דעתיקא,"
        },
        {
          "s": 75,
          "text": "דבבחינה זו אין שייך שינה,"
        },
        {
          "s": 76,
          "text": "עינא פקיחא דלא נאים."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "והנה הגם שעתיק הוא למעלה מציור אדם"
        },
        {
          "s": 2,
          "text": "(למעלה מקוין),"
        },
        {
          "s": 3,
          "text": "מ\"מ,"
        },
        {
          "s": 4,
          "text": "מזה שהענין דעתיק"
        },
        {
          "s": 5,
          "text": "(למעלה מקוין)"
        },
        {
          "s": 6,
          "text": "בא בהמאמר בהמשך למה שמבואר לפנ\"ז"
        },
        {
          "s": 7,
          "text": "(באותו הפרק)"
        },
        {
          "s": 8,
          "text": "הענין דאדם"
        },
        {
          "s": 9,
          "text": "(שאדם הוא מוחין ומדות),"
        },
        {
          "s": 10,
          "text": "היינו,"
        },
        {
          "s": 11,
          "text": "דענין עתיק"
        },
        {
          "s": 12,
          "text": "(עתיק מלשון נעתק ונבדל32)"
        },
        {
          "s": 13,
          "text": "הוא שנעתק מציור אדם,"
        },
        {
          "s": 14,
          "text": "מובן מזה שגם עתיק יש לו שייכות לבחי' אדם."
        },
        {
          "s": 15,
          "text": "ויתירה מזו,"
        },
        {
          "s": 16,
          "text": "דמזה שמבאר"
        },
        {
          "s": 17,
          "text": "(בתחלת הפרק)"
        },
        {
          "s": 18,
          "text": "הענין דאדם גם באדם התחתון,"
        },
        {
          "s": 19,
          "text": "מובן,"
        },
        {
          "s": 20,
          "text": "דענין עתיק שייך גם לאדם התחתון,"
        },
        {
          "s": 21,
          "text": "דהגם שעתיק הוא דרגא תחתונה שבא\"ס,"
        },
        {
          "s": 22,
          "text": "כדאיתא בע\"ח33,"
        },
        {
          "s": 23,
          "text": "מ\"מ,"
        },
        {
          "s": 24,
          "text": "הוא שייך גם לאדם התחתון כנ\"ל."
        },
        {
          "s": 25,
          "text": "וענין זה"
        },
        {
          "s": 26,
          "text": "(שעתיק שייך גם לאדם התחתון)"
        },
        {
          "s": 27,
          "text": "הוא לא רק בבחי' עתיק יומין,"
        },
        {
          "s": 28,
          "text": "אלא גם בעתיק"
        },
        {
          "s": 29,
          "text": "(סתם)."
        },
        {
          "s": 30,
          "text": "דהגם שעתיק"
        },
        {
          "s": 31,
          "text": "(סתם)"
        },
        {
          "s": 32,
          "text": "הוא למעלה מעתיק יומין34,"
        },
        {
          "s": 33,
          "text": "דפירוש עתיק יומין הוא שנעתק מיומין,"
        },
        {
          "s": 34,
          "text": "היינו שיש לו שייכות ליומין אלא שנעתק מהם,"
        },
        {
          "s": 35,
          "text": "משא\"כ עתיק"
        },
        {
          "s": 36,
          "text": "(סתם)"
        },
        {
          "s": 37,
          "text": "הוא למעלה מיומין35,"
        },
        {
          "s": 38,
          "text": "מ\"מ,"
        },
        {
          "s": 39,
          "text": "מכיון שנקרא בשם עתיק,"
        },
        {
          "s": 40,
          "text": "דפירוש עתיק הוא שנעתק,"
        },
        {
          "s": 41,
          "text": "בהכרח לומר,"
        },
        {
          "s": 42,
          "text": "שישנו ענין שממנו הוא נעתק."
        },
        {
          "s": 43,
          "text": "ולהעיר מהמבואר בלקוטי לוי\"צ36"
        },
        {
          "s": 44,
          "text": "שקו\"ט בענין בחינות אלו עתיק יומין ועתיקא דעתיקין וכו',"
        },
        {
          "s": 45,
          "text": "דהשקו\"ט שם שייך להמבואר לעיל."
        },
        {
          "s": 46,
          "text": "עיי\"ש."
        },
        {
          "s": 47,
          "text": "ומזה שמבאר בהמאמר הענין דאדם גם באדם התחתון,"
        },
        {
          "s": 48,
          "text": "מובן,"
        },
        {
          "s": 49,
          "text": "שהענין שעתיק נעתק ממנו,"
        },
        {
          "s": 50,
          "text": "היינו שיש לו איזו שייכות אליו,"
        },
        {
          "s": 51,
          "text": "הוא גם באדם התחתון."
        },
        {
          "s": 52,
          "text": "ויתירה מזו,"
        },
        {
          "s": 53,
          "text": "דענין זה"
        },
        {
          "s": 54,
          "text": "(שעתיק שייך גם לאדם התחתון)"
        },
        {
          "s": 55,
          "text": "הוא בכל הדרגות דעתיק,"
        },
        {
          "s": 56,
          "text": "גם בפנימיות עתיק,"
        },
        {
          "s": 57,
          "text": "דהגם שבנוגע לפנימיות עתיק מבאר הצ\"צ שהוא בחי' א\"ס ממש37,"
        },
        {
          "s": 58,
          "text": "ו\"עד שהוא נקרא עצמותו ית'\"38,"
        },
        {
          "s": 59,
          "text": "מ\"מ מכיון שנקרא בשם עתיק שפירושו נעתק,"
        },
        {
          "s": 60,
          "text": "בהכרח שיש ענין שממנו הוא נעתק,"
        },
        {
          "s": 61,
          "text": "שבענין זה נכלל"
        },
        {
          "s": 62,
          "text": "(כנ\"ל)"
        },
        {
          "s": 63,
          "text": "גם אדם התחתון."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "וכן מובן גם ממ\"ש אדמו\"ר האמצעי בתורת חיים39"
        },
        {
          "s": 2,
          "text": "בביאור הענין דעתיק שלמעלה מקוין"
        },
        {
          "s": 3,
          "text": "(עין אחת שלמעלה מהתחלקות חו\"ג),"
        },
        {
          "s": 4,
          "text": "שמקדים40"
        },
        {
          "s": 5,
          "text": "ענין התחלקות חו\"ג שמצד המוחין"
        },
        {
          "s": 6,
          "text": "(הקוין דחו\"ג שבבחי' אדם),"
        },
        {
          "s": 7,
          "text": "ושמצד המוחין אפשר שאותה הסברא תשתנה ותתהפך"
        },
        {
          "s": 8,
          "text": "(וכמה פעמים)"
        },
        {
          "s": 9,
          "text": "מזכות לחוב ומחוב לזכות"
        },
        {
          "s": 10,
          "text": "(ענין נחמה ושינוי שבבחי' אדם),"
        },
        {
          "s": 11,
          "text": "ושענין זה שבבחי' אדם"
        },
        {
          "s": 12,
          "text": "(ענין ההתחלקות דחו\"ג וענין הנחמה ושינוי)"
        },
        {
          "s": 13,
          "text": "הוא גם באדם התחתון,"
        },
        {
          "s": 14,
          "text": "ויתירה מזו,"
        },
        {
          "s": 15,
          "text": "שכל זה מבואר שם עה\"פ41"
        },
        {
          "s": 16,
          "text": "ויאמר ה' גו' ארדה נא ואראה הכצעקתה"
        },
        {
          "s": 17,
          "text": "(דסדום),"
        },
        {
          "s": 18,
          "text": "הירידה דאדם העליון לראות צעקתה דסדום"
        },
        {
          "s": 19,
          "text": "[שמזה מובן,"
        },
        {
          "s": 20,
          "text": "שגם הדוגמא לזה מאדם התחתון הוא גם כמו שהוא נמצא במצב ירוד ביותר],"
        },
        {
          "s": 21,
          "text": "ולאחרי הקדמה זו בא הביאור בענין עתיק,"
        },
        {
          "s": 22,
          "text": "היינו דענין עתיק הוא שנעתק מבחינה זו דאדם שמבאר לפנ\"ז,"
        },
        {
          "s": 23,
          "text": "דמזה מובן,"
        },
        {
          "s": 24,
          "text": "שענין עתיק שייך גם לאדם התחתון,"
        },
        {
          "s": 25,
          "text": "גם כמו שהוא במצב ירוד ביותר."
        },
        {
          "s": 26,
          "text": "וכן מובן גם ממה שמבאר אדמו\"ר מהר\"ש בהמשך מים רבים42"
        },
        {
          "s": 27,
          "text": "בענין השינוי שנעשה ע\"י וירח את ריח הניחוח אחר המבול43,"
        },
        {
          "s": 28,
          "text": "וענין עתיק הוא שנעתק מזה."
        },
        {
          "s": 29,
          "text": "ועוד ענין בזה,"
        },
        {
          "s": 30,
          "text": "שבמים רבים שם,"
        },
        {
          "s": 31,
          "text": "בהמשך הענין דעתיק,"
        },
        {
          "s": 32,
          "text": "מבואר"
        },
        {
          "s": 33,
          "text": "(לא רק בענין קוצו של יו\"ד,"
        },
        {
          "s": 34,
          "text": "ואפילו לא רק בענין יו\"ד,"
        },
        {
          "s": 35,
          "text": "אלא גם)"
        },
        {
          "s": 36,
          "text": "בענין ה' דשם הוי'."
        },
        {
          "s": 37,
          "text": "וכן מובן ממ\"ש אדמו\"ר"
        },
        {
          "s": 38,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 39,
          "text": "נ\"ע בהמשך תער\"ב44"
        },
        {
          "s": 40,
          "text": "דעתיק לשון זקן45"
        },
        {
          "s": 41,
          "text": "לפי שבחי' עתיק"
        },
        {
          "s": 42,
          "text": "(שאין בו שינויים)"
        },
        {
          "s": 43,
          "text": "הוא דוגמת זקן כפשוטו"
        },
        {
          "s": 44,
          "text": "[דכמו שזקן אינו מתפעל"
        },
        {
          "s": 45,
          "text": "(ומשתנה)"
        },
        {
          "s": 46,
          "text": "מדבר שנגד רצונו,"
        },
        {
          "s": 47,
          "text": "עד\"ז הוא בעתיק,"
        },
        {
          "s": 48,
          "text": "שאין שייך בו התפעלות ושינוי],"
        },
        {
          "s": 49,
          "text": "דמזה שמדמה עתיק לזקן כפשוטו"
        },
        {
          "s": 50,
          "text": "(שבאדם התחתון),"
        },
        {
          "s": 51,
          "text": "מובן שזהו ענין טבעי שעתיק שייך באדם התחתון."
        },
        {
          "s": 52,
          "text": "ויתירה מזו,"
        },
        {
          "s": 53,
          "text": "דזה שעתיק שייך לאדם התחתון הוא גם לנער"
        },
        {
          "s": 54,
          "text": "(וגם לפני זה),"
        },
        {
          "s": 55,
          "text": "מכיון שאז בכחו להיות זקן"
        },
        {
          "s": 56,
          "text": "[ועד שע\"י אופן ההנהגה בנערותו,"
        },
        {
          "s": 57,
          "text": "תהי' כן"
        },
        {
          "s": 58,
          "text": "(במילא)"
        },
        {
          "s": 59,
          "text": "גם ההנהגה בזקנותו,"
        },
        {
          "s": 60,
          "text": "כמ\"ש46"
        },
        {
          "s": 61,
          "text": "חנוך לנער גו' גם כי יזקין לא יסור ממנה],"
        },
        {
          "s": 62,
          "text": "ואינו אלא מחוסר זמן."
        }
      ]
    }
  ]
}