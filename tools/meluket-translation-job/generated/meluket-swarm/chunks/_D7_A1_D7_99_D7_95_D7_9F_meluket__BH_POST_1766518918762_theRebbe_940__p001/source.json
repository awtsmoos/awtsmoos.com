{
  "globalIndex": 839,
  "owner": 39,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918762_theRebbe_940__p001",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918762_theRebbe_940__p001",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918762_theRebbe_940",
  "title": "מאמר וידבר אלוקים את כל הדברים האלה תשכ\"ט",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "יום ב' דחג השבועות,"
        },
        {
          "s": 2,
          "text": "ה'תשכ\"ט"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "וידבר אלקים את כל הדברים האלה לאמר1,"
        },
        {
          "s": 1,
          "text": "וידוע הדיוק2"
        },
        {
          "s": 2,
          "text": "במ\"ש לאמר,"
        },
        {
          "s": 3,
          "text": "דמאחר שכל ישראל"
        },
        {
          "s": 4,
          "text": "(הנשמות שבכל הדורות3)"
        },
        {
          "s": 5,
          "text": "היו במעמד הר סיני ושמעו את הדברות מהקב\"ה בעצמו,"
        },
        {
          "s": 6,
          "text": "מהו פירוש לאמר,"
        },
        {
          "s": 7,
          "text": "לאמר לאחרים4."
        },
        {
          "s": 8,
          "text": "ונקודת הביאור בזה,"
        },
        {
          "s": 9,
          "text": "שבזה מבאר הכתוב את החידוש דמתן תורה."
        },
        {
          "s": 10,
          "text": "דלכאורה הרי גם קודם מתן תורה למדו כל התורה"
        },
        {
          "s": 11,
          "text": "[כמובן גם מזה שקיים אברהם אבינו את כל התורה כולה עד שלא ניתנה5,"
        },
        {
          "s": 12,
          "text": "שבכדי לקיים את התורה צריך ללמוד אותה,"
        },
        {
          "s": 13,
          "text": "ובודאי6"
        },
        {
          "s": 14,
          "text": "שאברהם לימד את כל התורה כולה ליצחק בנו ויצחק לימדה ליעקב ובניו7],"
        },
        {
          "s": 15,
          "text": "ומהו החידוש דמתן תורה8."
        },
        {
          "s": 16,
          "text": "ומבאר הכתוב,"
        },
        {
          "s": 17,
          "text": "שהחידוש דוידבר אלקים את כל הדברים האלה במתן תורה הוא,"
        },
        {
          "s": 18,
          "text": "שעי\"ז ניתן הכח לכאו\"א מישראל שבכל הדורות,"
        },
        {
          "s": 19,
          "text": "שלימוד התורה שלו יהי' באופן דלאמר."
        },
        {
          "s": 20,
          "text": "ושני פירושים בזה."
        },
        {
          "s": 21,
          "text": "שע\"י לימוד התורה שלו הוא גורם שהקב\"ה יאמר דיבורים אלה9,"
        },
        {
          "s": 22,
          "text": "דכל הקורא ושונה הקב\"ה קורא ושונה כנגדו10,"
        },
        {
          "s": 23,
          "text": "דעפ\"ז פירוש לאמר"
        },
        {
          "s": 24,
          "text": "(לאמר לאחרים)"
        },
        {
          "s": 25,
          "text": "הוא,"
        },
        {
          "s": 26,
          "text": "שהאדם הלומד תורה אומר להקב\"ה11"
        },
        {
          "s": 27,
          "text": "כביכול שיחזור על הדיבורים שלו."
        },
        {
          "s": 28,
          "text": "ועוד,"
        },
        {
          "s": 29,
          "text": "שלימוד התורה של האדם יהי' באופן דלאמר,"
        },
        {
          "s": 30,
          "text": "לחזור הדברים שהקב\"ה אומר,"
        },
        {
          "s": 31,
          "text": "כמ\"ש12"
        },
        {
          "s": 32,
          "text": "תען לשוני אמרתך,"
        },
        {
          "s": 33,
          "text": "שהדיבורים דתורה שהאדם אומר הם אמרתך ולשוני תען כעונה אחר הקורא13."
        },
        {
          "s": 34,
          "text": "ועוד פירוש בוידבר גו' לאמר,"
        },
        {
          "s": 35,
          "text": "שוידבר אלקים את כל הדברים האלה,"
        },
        {
          "s": 36,
          "text": "עשרת הדברות שהם כללות כל התורה14,"
        },
        {
          "s": 37,
          "text": "הוא לאמר,"
        },
        {
          "s": 38,
          "text": "שעשרת הדברות"
        },
        {
          "s": 39,
          "text": "(תורה שלמעלה מעולם)"
        },
        {
          "s": 40,
          "text": "יומשכו בהעשרה מאמרות שבהם נברא15"
        },
        {
          "s": 41,
          "text": "העולם16."
        },
        {
          "s": 42,
          "text": "ועד\"ז הוא בלימוד התורה דהאדם,"
        },
        {
          "s": 43,
          "text": "שהוא באופן דוידבר גו' לאמר,"
        },
        {
          "s": 44,
          "text": "שמדיבור התורה שלו נעשה אמירה,"
        },
        {
          "s": 45,
          "text": "המשכת ההשפעה למטה17."
        },
        {
          "s": 46,
          "text": "וצריך להבין הקשר והשייכות דכל ענינים הנ\"ל בלאמר."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה בהמאמר של אדמו\"ר מהר\"ש ד\"ה זה שנאמר לפני מאה שנה18"
        },
        {
          "s": 2,
          "text": "(לאחרי הדיוק שלכאורה תיבת לאמר הוא מיותר),"
        },
        {
          "s": 3,
          "text": "מביא מ\"ש בילקוט19,"
        },
        {
          "s": 4,
          "text": "כשהי' הקב\"ה מדבר הי' כל אחד מישראל אומר עמי הדיבור מדבר שנאמר20"
        },
        {
          "s": 5,
          "text": "אנכי הוי' אלקיך לשון יחיד."
        },
        {
          "s": 6,
          "text": "ומבאר,"
        },
        {
          "s": 7,
          "text": "דזהו מה דאיתא במדרש21"
        },
        {
          "s": 8,
          "text": "עה\"פ אנכי הוי' אלקיך,"
        },
        {
          "s": 9,
          "text": "שהקול ששמעו בעשרת הדברות הי' לפי כחו של כל אחד,"
        },
        {
          "s": 10,
          "text": "הבחורים לפי כחן והזקנים לפי כחן והקטנים לפי כחן."
        },
        {
          "s": 11,
          "text": "ויש לומר,"
        },
        {
          "s": 12,
          "text": "דמהטעמים על זה שמביא גם מאמר המדרש,"
        },
        {
          "s": 13,
          "text": "הוא,"
        },
        {
          "s": 14,
          "text": "לפי שעי\"ז מובן שהענין דעמי הדיבור מדבר"
        },
        {
          "s": 15,
          "text": "(לכאו\"א בפ\"ע)"
        },
        {
          "s": 16,
          "text": "הוא לא רק בנוגע להנשמה אלא גם בנוגע להגוף,"
        },
        {
          "s": 17,
          "text": "שהרי החילוק דבחורים זקנים וקטנים הוא מצד הגוף."
        }
      ]
    }
  ]
}