{
  "globalIndex": 447,
  "owner": 47,
  "jobId": "_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916328_theRebbe_715__p003",
  "batchId": "meluket-_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916328_theRebbe_715__p003",
  "seriesId": "טבת_meluket",
  "postId": "BH_POST_1766518916328_theRebbe_715",
  "title": "מאמר וארא אל אברהם תשל\"ה",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "וצריך להבין,"
        },
        {
          "s": 1,
          "text": "דלכאורה,"
        },
        {
          "s": 2,
          "text": "זה שהבריות צריכים לנס הוא"
        },
        {
          "s": 3,
          "text": "(לא רק בכדי להושיע להם בעת צרתם וכיו\"ב אלא גם)"
        },
        {
          "s": 4,
          "text": "בכדי שיהי' גילוי אלקות בעולם,"
        },
        {
          "s": 5,
          "text": "וכיון שבנסים המלובשים בטבע יש מקום לטעות שהם טבע,"
        },
        {
          "s": 6,
          "text": "ועיקר הענין דגילוי אלקות הוא בנסים שלמעלה מהטבע,"
        },
        {
          "s": 7,
          "text": "הרי בדי מחסורו נכללים"
        },
        {
          "s": 8,
          "text": "(לכאורה)"
        },
        {
          "s": 9,
          "text": "גם הנסים שלמעלה מהטבע,"
        },
        {
          "s": 10,
          "text": "ואעפ\"כ,"
        },
        {
          "s": 11,
          "text": "המשכת הנסים שלמעלה מהטבע היא דוקא ע\"י גילוי שם הוי'."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים,"
        },
        {
          "s": 2,
          "text": "שג' ענינים הנ\"ל – שם שדי על שם שאמרתי לעולמי די,"
        },
        {
          "s": 3,
          "text": "שם שדי על שם שדי באלקותי לכל ברי',"
        },
        {
          "s": 4,
          "text": "ושם הוי' – הם בכלים,"
        },
        {
          "s": 5,
          "text": "באור השייך לכלים,"
        },
        {
          "s": 6,
          "text": "ובאור שלמעלה משייכות לכלים."
        },
        {
          "s": 7,
          "text": "והענין הוא,"
        },
        {
          "s": 8,
          "text": "דזה שהתהוות העולם היא במדה וגבול"
        },
        {
          "s": 9,
          "text": "(שאמרתי לעולמי די)"
        },
        {
          "s": 10,
          "text": "הוא לפי שההתהוות היא ע\"י הכלים."
        },
        {
          "s": 11,
          "text": "דההתהוות עצמה"
        },
        {
          "s": 12,
          "text": "(הבריאה מאין ליש)"
        },
        {
          "s": 13,
          "text": "היא מהאור"
        },
        {
          "s": 14,
          "text": "[דהגם שההתהוות היא בכח העצמות,"
        },
        {
          "s": 15,
          "text": "שהוא לבדו בכחו ויכלתו לברוא יש מאין,"
        },
        {
          "s": 16,
          "text": "מ\"מ,"
        },
        {
          "s": 17,
          "text": "כיון שהאור הוא כעין המאור,"
        },
        {
          "s": 18,
          "text": "לכן גם האור יש בו כח ההתהוות22],"
        },
        {
          "s": 19,
          "text": "אלא שההתהוות כמו שהיא מצד האור היא בבחי' בלי גבול,"
        },
        {
          "s": 20,
          "text": "ובכדי שההתהוות תהי' במדה וגבול הוא ע\"י התלבשות האור בהכלים23."
        },
        {
          "s": 21,
          "text": "וזהו ששם שדי שאמרתי לעולמי די הוא בהכלים,"
        },
        {
          "s": 22,
          "text": "כי ענין ההגבלה שבעולם הוא ע\"י הכלים שמגבילים את"
        },
        {
          "s": 23,
          "text": "(התפשטות)"
        },
        {
          "s": 24,
          "text": "האור."
        },
        {
          "s": 25,
          "text": "וענין שם שדי על שם שדי באלקותי לכל ברי' הוא בהאור,"
        },
        {
          "s": 26,
          "text": "שההתפשטות והגילוי דאלקות,"
        },
        {
          "s": 27,
          "text": "ענין האור,"
        },
        {
          "s": 28,
          "text": "הוא די ומספיק לכל ברי'."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "שהכוונה בכל ברי' היא,"
        },
        {
          "s": 2,
          "text": "הן לנבראים הכי נעלים,"
        },
        {
          "s": 3,
          "text": "שההתפשטות והגילוי דאלקות מספיקה וממלאת גם את מחסורם של נבראים הכי עליונים,"
        },
        {
          "s": 4,
          "text": "והן לנבראים הכי תחתונים,"
        },
        {
          "s": 5,
          "text": "כולל אלו שאין בהם שום מעלה והם רק בריות בעלמא24,"
        },
        {
          "s": 6,
          "text": "שההתפשטות והגילוי נמשכת גם בהם."
        },
        {
          "s": 7,
          "text": "ויש לומר,"
        },
        {
          "s": 8,
          "text": "דמהלשון שדי באלקותי לכל ברי',"
        },
        {
          "s": 9,
          "text": "משמע שעיקר ההדגשה בדי באלקותי לכל ברי' היא שהוא די גם לנבראים הכי פחותים שהם בריות בעלמא."
        },
        {
          "s": 10,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 11,
          "text": "דזה שהוא די באלקותו גם לנבראים הכי נעלים,"
        },
        {
          "s": 12,
          "text": "אין זה חידוש ועילוי כ\"כ."
        },
        {
          "s": 13,
          "text": "דכיון שגם הנבראים הכי עליונים הם מוגבלים,"
        },
        {
          "s": 14,
          "text": "הרי גם הגילוי שהוא די ומספיק להנבראים הכי נעלים,"
        },
        {
          "s": 15,
          "text": "הוא גילוי מוגבל."
        },
        {
          "s": 16,
          "text": "ועיקר החידוש והעילוי הוא שהוא די באלקותו גם להנבראים הכי תחתונים,"
        },
        {
          "s": 17,
          "text": "דזה שהאור"
        },
        {
          "s": 18,
          "text": "(ההתפשטות והגילוי דאלקות)"
        },
        {
          "s": 19,
          "text": "נמשך גם בנבראים הכי תחתונים שאין תחתון למטה מהם,"
        },
        {
          "s": 20,
          "text": "מורה שהוא אין סוף ובלי גבול,"
        },
        {
          "s": 21,
          "text": "שלכן הוא נמשך למטה מטה עד אין תכלית."
        }
      ]
    }
  ]
}