{
  "globalIndex": 52,
  "owner": 2,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913974_theRebbe_325__p005",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913974_theRebbe_325__p005",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518913974_theRebbe_325",
  "title": "מאמר וכל אדם תשכ\"ג",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "והנה זה שע\"י תשובה מתכפרים הזדונות ועד שנהפכים לזכיות הוא גם בכל השנה."
        },
        {
          "s": 2,
          "text": "ועאכו\"כ בעשרת ימי תשובה,"
        },
        {
          "s": 3,
          "text": "שאז התשובה היא נעלית יותר57."
        },
        {
          "s": 4,
          "text": "ומעלת התשובה דיום הכפורים היא שהכפרה דיום הכפורים היא מצד עיצומו של יום58,"
        },
        {
          "s": 5,
          "text": "שכפרה זו היא נעלית יותר מהכפרה שע\"י התשובה."
        },
        {
          "s": 6,
          "text": "וזה שיום הכפורים אין מכפר אלא לשבים הוא,"
        },
        {
          "s": 7,
          "text": "שהמשכת הענין דעיצומו של יום להאדם היא ע\"י התשובה."
        },
        {
          "s": 8,
          "text": "והענין הוא59,"
        },
        {
          "s": 9,
          "text": "דזה שע\"י התשובה מתכפרים הענינים שעשו היפך הרצון הוא לפי שע\"י התשובה נמשך מעצמות אוא\"ס בעל הרצון שאינו מוכרח בהרצון."
        },
        {
          "s": 10,
          "text": "דזה שבעל הרצון אינו מוכרח בהרצון הו\"ע ההפלאה דאוא\"ס ולא עצמות אוא\"ס ממש60."
        },
        {
          "s": 11,
          "text": "וכיון שענין ההפלאה דבעל הרצון הוא שהוא מופלא מהרצון,"
        },
        {
          "s": 12,
          "text": "הרי זה מוכיח שיש להרצון שייכות אליו"
        },
        {
          "s": 13,
          "text": "[וכדמוכח גם מזה שנקרא בשם בעל הרצון],"
        },
        {
          "s": 14,
          "text": "לכן צריכה להיות סליחה וכפרה על זה שעשו היפך הרצון."
        },
        {
          "s": 15,
          "text": "משא\"כ לגבי עצמות אוא\"ס שלמעלה גם מבעל הרצון,"
        },
        {
          "s": 16,
          "text": "אין שייך פגם מלכתחילה."
        },
        {
          "s": 17,
          "text": "וזהו\"ע עיצומו של יום מכפר,"
        },
        {
          "s": 18,
          "text": "שהכפרה מצד עיצומו של יום היא"
        },
        {
          "s": 19,
          "text": "(לא באופן של פעולה,"
        },
        {
          "s": 20,
          "text": "אלא)"
        },
        {
          "s": 21,
          "text": "שביום זה מתגלה ההתקשרות של עצם הנשמה עם העצמות"
        },
        {
          "s": 22,
          "text": "(שלמעלה מבעל הרצון),"
        },
        {
          "s": 23,
          "text": "שלגבי דרגא זו אין פגם מלכתחילה."
        },
        {
          "s": 24,
          "text": "והטעם שהמשכת הענין דעיצומו של יום היא ע\"י התשובה,"
        },
        {
          "s": 25,
          "text": "הוא,"
        },
        {
          "s": 26,
          "text": "כי תיקון הפגמים ע\"י הגילוי דעצם הנשמה"
        },
        {
          "s": 27,
          "text": "(שמצד עצם הנשמה אין שייך פגם מלכתחילה),"
        },
        {
          "s": 28,
          "text": "אין שייך"
        },
        {
          "s": 29,
          "text": "(כ\"כ)"
        },
        {
          "s": 30,
          "text": "לענינם של כחות הגלויים עצמם61,"
        },
        {
          "s": 31,
          "text": "ובכדי שהכפרה שע\"י גילוי עצם הנשמה תהי' בפנימיות,"
        },
        {
          "s": 32,
          "text": "הוא ע\"י התשובה."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "[ויש להוסיף,"
        },
        {
          "s": 1,
          "text": "שהמשכת הכפרה דעיצומו של יום בכחות הגלויים ע\"י התשובה,"
        },
        {
          "s": 2,
          "text": "כיון שענין התשובה הוא שהאדם יוצא מההגבלות שלו,"
        },
        {
          "s": 3,
          "text": "לכן ההמשכה שע\"י התשובה היא בהכחות כמו שהם בתנועה דהעלאה."
        },
        {
          "s": 4,
          "text": "ובכדי שהכפרה דעיצומו של יום תומשך גם בכחות הגלויים כמו שהם בהציור שלהם,"
        },
        {
          "s": 5,
          "text": "הוא ע\"י מצות התשובה,"
        },
        {
          "s": 6,
          "text": "דביום הכפורים חייבים הכל לעשות תשובה62."
        },
        {
          "s": 7,
          "text": "ולהעיר,"
        },
        {
          "s": 8,
          "text": "דג' ענינים אלה שביום הכפורים הם דוגמת ג' הענינים שבתק\"ש."
        },
        {
          "s": 9,
          "text": "המצוה דתק\"ש,"
        },
        {
          "s": 10,
          "text": "ענין התשובה המרומז בתק\"ש,"
        },
        {
          "s": 11,
          "text": "והביטול פנימי שמצד עצם הנשמה63]."
        },
        {
          "s": 12,
          "text": "ויש לומר,"
        },
        {
          "s": 13,
          "text": "שזהו\"ע שמונה ההזיות שהיו בקודש הקדשים,"
        },
        {
          "s": 14,
          "text": "אחת למעלה ושבע למטה,"
        },
        {
          "s": 15,
          "text": "אחת למעלה היא גילוי היחידה64,"
        },
        {
          "s": 16,
          "text": "שהיא מיוחדת עם העצמות,"
        },
        {
          "s": 17,
          "text": "ושבע למטה"
        },
        {
          "s": 18,
          "text": "(שלאחרי האחת)"
        },
        {
          "s": 19,
          "text": "הוא שגילוי היחידה"
        },
        {
          "s": 20,
          "text": "(למעלה מהשתלשלות שבאדם)"
        },
        {
          "s": 21,
          "text": "יומשך בכחות הגלויים,"
        },
        {
          "s": 22,
          "text": "השתלשלות שבאדם65."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יש לבאר החילוק שבין ג' הענינים דשמיני,"
        },
        {
          "s": 2,
          "text": "שמיני דמילה ושמיני דתשובה ושמיני דיום הכפורים,"
        },
        {
          "s": 3,
          "text": "דמילה היא מצוה,"
        },
        {
          "s": 4,
          "text": "וכיון שכוונת הבריאה מלכתחילה היא שישראל יקיימו את כל המצוות וימשיכו הגילויים שנמשכים על ידם,"
        },
        {
          "s": 5,
          "text": "לכן הגילויים שנמשכים ע\"י המצוות"
        },
        {
          "s": 6,
          "text": "(כולל גם מצות מילה)"
        },
        {
          "s": 7,
          "text": "אינם אור חדש ממש66,"
        },
        {
          "s": 8,
          "text": "מכיון שכוונת הבריאה מלכתחילה היא שישראל ימשיכו גילויים אלו."
        },
        {
          "s": 9,
          "text": "ואף שהגילוי שנמשך ע\"י כל המצוות הוא הגילוי דהוי' והגילוי שנמשך ע\"י המילה הוא למעלה מהוי',"
        },
        {
          "s": 10,
          "text": "וכמבואר בתו\"א67"
        },
        {
          "s": 11,
          "text": "דמי יעלה לנו השמימה68"
        },
        {
          "s": 12,
          "text": "הוא ר\"ת מילה וס\"ת הוי'69"
        },
        {
          "s": 13,
          "text": "שזה מורה שמילה היא למעלה מהוי',"
        },
        {
          "s": 14,
          "text": "מ\"מ,"
        },
        {
          "s": 15,
          "text": "כיון שבריאת העולמות מלכתחילה היא שע\"י מצות מילה ימשיכו אור זה,"
        },
        {
          "s": 16,
          "text": "הוא אור שיש לו שייכות לעולמות."
        },
        {
          "s": 17,
          "text": "[ויש לומר,"
        },
        {
          "s": 18,
          "text": "שבכללות,"
        },
        {
          "s": 19,
          "text": "גם אור זה נכלל בהוי'."
        },
        {
          "s": 20,
          "text": "כי בהוי' לשון מהווה70"
        },
        {
          "s": 21,
          "text": "שתי דרגות."
        },
        {
          "s": 22,
          "text": "המקור שממנו נעשה התהוות העולם,"
        },
        {
          "s": 23,
          "text": "והרצון להוות את העולם71."
        },
        {
          "s": 24,
          "text": "וכיון שהרצון להוות הוא שיומשך גם הגילוי שע\"י המילה,"
        },
        {
          "s": 25,
          "text": "הרי גילוי זה נכלל בהוי'."
        },
        {
          "s": 26,
          "text": "וזה שהגילוי שע\"י המילה הוא למעלה מהוי' הוא שגילוי זה הוא למעלה ממקור ההתהוות]."
        },
        {
          "s": 27,
          "text": "ושמיני דתשובה הוא גילוי אור חדש."
        },
        {
          "s": 28,
          "text": "דע\"י שחטא ופגם והעביר את הדרך"
        },
        {
          "s": 29,
          "text": "(היפך הכוונה דבריאת האדם שהי' באופן דעשה האלקים את האדם ישר)"
        },
        {
          "s": 30,
          "text": "ואח\"כ מתקן זה ע\"י התשובה,"
        },
        {
          "s": 31,
          "text": "עי\"ז נמשך אור חדש שלא הי'"
        },
        {
          "s": 32,
          "text": "(כביכול)"
        },
        {
          "s": 33,
          "text": "גם בכוונת הבריאה."
        },
        {
          "s": 34,
          "text": "אלא שאור זה הוא מבעל הרצון,"
        },
        {
          "s": 35,
          "text": "שיש לו שייכות להרצון והכוונה דהבריאה."
        },
        {
          "s": 36,
          "text": "ושמיני דיום הכפורים,"
        },
        {
          "s": 37,
          "text": "שעיצומו של יום מכפר,"
        },
        {
          "s": 38,
          "text": "הוא גילוי עצמות אוא\"ס שלמעלה גם מבעל הרצון."
        },
        {
          "s": 39,
          "text": "אלא שגילוי ענין זה הוא בעיקר בעת כניסת הכה\"ג לקודש הקדשים."
        },
        {
          "s": 40,
          "text": "ולכן,"
        },
        {
          "s": 41,
          "text": "גם השמיני דיום הכפורים הוא שמיני שלאחרי שבעת הימים שלפני יום הכפורים,"
        },
        {
          "s": 42,
          "text": "כי בכללות,"
        },
        {
          "s": 43,
          "text": "גם השמיני דיום הכפורים הוא למעלה מהשתלשלות ששייך להשתלשלות"
        },
        {
          "s": 44,
          "text": "(בעל הרצון),"
        },
        {
          "s": 45,
          "text": "משא\"כ הסדר בשמונה ההזיות שבקודש הקדשים,"
        },
        {
          "s": 46,
          "text": "הוא שהאחת היא לפני השבעה."
        }
      ]
    }
  ]
}