{
  "globalIndex": 1127,
  "owner": 27,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920519_theRebbe_475__p004",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920519_theRebbe_475__p004",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920519_theRebbe_475",
  "title": "מאמר אתם נצבים תשט\"ז",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ובזה יובן מ\"ש ישפוט תבל בצדק,"
        },
        {
          "s": 2,
          "text": "דהנה,"
        },
        {
          "s": 3,
          "text": "מבואר בלקו\"ת52"
        },
        {
          "s": 4,
          "text": "שתבל הוא ב\"פ ארי',"
        },
        {
          "s": 5,
          "text": "והיינו שבאופן העבודה דארי' שהו\"ע עבודת האהבה53"
        },
        {
          "s": 6,
          "text": "(כללות העבודה,"
        },
        {
          "s": 7,
          "text": "כמאמר54"
        },
        {
          "s": 8,
          "text": "לית פולחנא כפולחנא דרחימותא)"
        },
        {
          "s": 9,
          "text": "יש ב' בחינות,"
        },
        {
          "s": 10,
          "text": "ובכללות הרי זה ההפרש שבין שרפים לאופנים,"
        },
        {
          "s": 11,
          "text": "שהשרפים אומרים קדוש לפי שמשיגים איך שהוא ית' קדוש ומובדל מגדר עולמות ולכן הם רוצים ליכלל וליבטל אליו ית',"
        },
        {
          "s": 12,
          "text": "וזהו מחמת הטעם וההשגה בגדולת אוא\"ס ב\"ה,"
        },
        {
          "s": 13,
          "text": "אבל האופנים הם ברעש גדול מחמת העדר ההשגה."
        },
        {
          "s": 14,
          "text": "וכמו\"כ ישנם ב' בחי' אלו בנש\"י,"
        },
        {
          "s": 15,
          "text": "יש בעלי דעה המשיגים גדולת הבורא ית',"
        },
        {
          "s": 16,
          "text": "והם רוצים להכלל מחמת ההשגה"
        },
        {
          "s": 17,
          "text": "(שזוהי עבודה שבבחי' ראי'),"
        },
        {
          "s": 18,
          "text": "ויש בחי' המון עם שאינם משיגים כלל,"
        },
        {
          "s": 19,
          "text": "ועכ\"ז הם רוצים ליכלל כו',"
        },
        {
          "s": 20,
          "text": "כדמיון האופנים"
        },
        {
          "s": 21,
          "text": "(שזוהי עבודה שבבחי' שמיעה,"
        },
        {
          "s": 22,
          "text": "קבלת עול),"
        },
        {
          "s": 23,
          "text": "כי כאו\"א מישראל יכול לבוא לבחי' ארי'."
        },
        {
          "s": 24,
          "text": "ולכן נאמר ישפוט תבל דוקא,"
        },
        {
          "s": 25,
          "text": "כי בבחי' תבל מרומזים ב' הבחי' שבנש\"י."
        },
        {
          "s": 26,
          "text": "וזהו גם מש\"נ ישפוט תבל בצדק,"
        },
        {
          "s": 27,
          "text": "ב' צדק,"
        },
        {
          "s": 28,
          "text": "שהם ב' הבחי' דצדק,"
        },
        {
          "s": 29,
          "text": "צדק דצדקה ותפלה,"
        },
        {
          "s": 30,
          "text": "וצדק דתורה"
        },
        {
          "s": 31,
          "text": "(כנ\"ל)."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "אמנם ענין המשפט"
        },
        {
          "s": 2,
          "text": "(ישפוט תבל בצדק)"
        },
        {
          "s": 3,
          "text": "אינו ענין של דין בלבד,"
        },
        {
          "s": 4,
          "text": "אלא הכוונה היא שעי\"ז יומשך גילוי אור נעלה ביותר."
        },
        {
          "s": 5,
          "text": "והענין בזה,"
        },
        {
          "s": 6,
          "text": "שכללות ענין הדין למעלה הוא בשביל שעי\"ז יהי' גילוי אור נעלה יותר,"
        },
        {
          "s": 7,
          "text": "וכפי שמצינו גבי ר\"ה וסוכות"
        },
        {
          "s": 8,
          "text": "[שמרומזים בתיבת ארי'"
        },
        {
          "s": 9,
          "text": "(שזהו\"ע תבל,"
        },
        {
          "s": 10,
          "text": "ב\"פ ארי'),"
        },
        {
          "s": 11,
          "text": "כידוע55"
        },
        {
          "s": 12,
          "text": "שארי' ר\"ת אלול ראש השנה יום הכיפורים הושענא רבה],"
        },
        {
          "s": 13,
          "text": "שעז\"נ56"
        },
        {
          "s": 14,
          "text": "שמאלו תחת לראשי וימינו תחבקני,"
        },
        {
          "s": 15,
          "text": "היינו,"
        },
        {
          "s": 16,
          "text": "שבחי' שמאלו שהוא הדין דר\"ה הרי זה רק בשביל להיות הגילוי דימינו תחבקני בחג הסוכות."
        },
        {
          "s": 17,
          "text": "ויתירה מזה,"
        },
        {
          "s": 18,
          "text": "שלא זו בלבד שענין הדין הוא בשביל שעי\"ז יהי' גילוי אור נעלה יותר,"
        },
        {
          "s": 19,
          "text": "אלא שמלכתחילה אין זה ענין של דין כלל,"
        },
        {
          "s": 20,
          "text": "כי אם,"
        },
        {
          "s": 21,
          "text": "ע\"ד שנתבאר בזהר57"
        },
        {
          "s": 22,
          "text": "על הפסוק58"
        },
        {
          "s": 23,
          "text": "שמים לא זכו בעיניו,"
        },
        {
          "s": 24,
          "text": "שענין זה הוא למעליותא,"
        },
        {
          "s": 25,
          "text": "שמפני חביבותן לכן לא זכו בעיניו,"
        },
        {
          "s": 26,
          "text": "וכמשל האדם שיש לו כלי נאה או בנין נאה,"
        },
        {
          "s": 27,
          "text": "שכל מה שהכלי חביב עליו יותר הוא מתקנה יותר ודומה לו שעדיין לא ניתקנה היטב וצריכה תיקון עדיין."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "וזהו ג\"כ מש\"נ59"
        },
        {
          "s": 1,
          "text": "והוא ישפוט תבל בצדק,"
        },
        {
          "s": 2,
          "text": "והוא דייקא,"
        },
        {
          "s": 3,
          "text": "וידוע מארז\"ל60"
        },
        {
          "s": 4,
          "text": "חמשה הוא לטובה כו' אית לן חד הוא טבא מן כולהון,"
        },
        {
          "s": 5,
          "text": "הוא ה' אלקינו61,"
        },
        {
          "s": 6,
          "text": "שמדת רחמיו לעולם."
        },
        {
          "s": 7,
          "text": "והענין בזה,"
        },
        {
          "s": 8,
          "text": "דהנה,"
        },
        {
          "s": 9,
          "text": "ענין הדין ומשפט הוא מצד שם אלקים,"
        },
        {
          "s": 10,
          "text": "כמ\"ש14"
        },
        {
          "s": 11,
          "text": "כי המשפט לאלקים הוא,"
        },
        {
          "s": 12,
          "text": "ומ\"מ נאמר כאן לפני הוי' כי בא לשפוט."
        },
        {
          "s": 13,
          "text": "אך הענין הוא,"
        },
        {
          "s": 14,
          "text": "כידוע שיש62"
        },
        {
          "s": 15,
          "text": "ב' בחי' שמות אלקים,"
        },
        {
          "s": 16,
          "text": "הא',"
        },
        {
          "s": 17,
          "text": "כמ\"ש63"
        },
        {
          "s": 18,
          "text": "וידעת גו' כי הוי' הוא האלקים."
        },
        {
          "s": 19,
          "text": "והב',"
        },
        {
          "s": 20,
          "text": "ששם הוי' בעלותו לעתיק כאלקים יחשב."
        },
        {
          "s": 21,
          "text": "וזהו מש\"נ לפני הוי' כי בא לשפוט,"
        },
        {
          "s": 22,
          "text": "למעלה משם הוי',"
        },
        {
          "s": 23,
          "text": "והיינו לפי ששם הוי' עולה לעתיק,"
        },
        {
          "s": 24,
          "text": "שלכן כאלקים יחשב,"
        },
        {
          "s": 25,
          "text": "ששם הו\"ע הדין ומשפט."
        },
        {
          "s": 26,
          "text": "וזהו גם מ\"ש והוא ישפוט תבל בצדק,"
        },
        {
          "s": 27,
          "text": "והוא דייקא,"
        },
        {
          "s": 28,
          "text": "הוא דא עתיקא64,"
        },
        {
          "s": 29,
          "text": "ובבחי' זו הנה גם הדין הו\"ע של רחמים,"
        },
        {
          "s": 30,
          "text": "היינו שענינו הוא צחצוח הכלי."
        }
      ]
    }
  ]
}