{
  "globalIndex": 598,
  "owner": 48,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917181_theRebbe_116__p002",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917181_theRebbe_116__p002",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518917181_theRebbe_116",
  "title": "מאמר זה יתנו תש\"מ",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "וזהו אין עומדין להתפלל אלא מתוך כובד ראש,"
        },
        {
          "s": 1,
          "text": "וע\"י התפלה הנה לא זו בלבד שמבטל את הכובד ראש,"
        },
        {
          "s": 2,
          "text": "אלא עוד זאת שנעשה שאו את ראש גו' בני ישראל גו' לגולגלותם20"
        },
        {
          "s": 3,
          "text": "(כמבואר בלקו\"ת ר\"פ במדבר),"
        },
        {
          "s": 4,
          "text": "שמגבי' את ראש עד לבחי' גולגלותם,"
        },
        {
          "s": 5,
          "text": "שלמעלה מהראש."
        },
        {
          "s": 6,
          "text": "והוא ע\"י העבודה בבירור נה\"ב,"
        },
        {
          "s": 7,
          "text": "שעי\"ז מגבי' את הראש דנה\"א,"
        },
        {
          "s": 8,
          "text": "כי שרש נה\"ב הוא מבחי' התוהו שקדם לתיקון,"
        },
        {
          "s": 9,
          "text": "כי עשו הוא בנה הגדול21,"
        },
        {
          "s": 10,
          "text": "והאורות מרובים דתוהו מעלים את האורות דתיקון."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "וזהו ענין מחצית השקל,"
        },
        {
          "s": 2,
          "text": "שהנתינה מלמטה היא רק מחצית22,"
        },
        {
          "s": 3,
          "text": "וכתורת הה\"מ23"
        },
        {
          "s": 4,
          "text": "עשה לך שתי חצוצרות24,"
        },
        {
          "s": 5,
          "text": "שתי חצאי צורות,"
        },
        {
          "s": 6,
          "text": "שהקב\"ה וכנס\"י הם ב' חצאי צורות המשלימים זא\"ז כביכול,"
        },
        {
          "s": 7,
          "text": "וכמרז\"ל25"
        },
        {
          "s": 8,
          "text": "תמתי תאומתי."
        },
        {
          "s": 9,
          "text": "היינו,"
        },
        {
          "s": 10,
          "text": "שע\"י עבודתו בעשר הכחות שלו ה\"ה פועל עלי' גם למעלה."
        },
        {
          "s": 11,
          "text": "ובעבודתו גופא ענין מחצית השקל הוא,"
        },
        {
          "s": 12,
          "text": "שמעלה את עשר הכחות דנה\"ב,"
        },
        {
          "s": 13,
          "text": "ועי\"ז פועל עלי' בנה\"א,"
        },
        {
          "s": 14,
          "text": "וכנ\"ל דהאורות מרובים דתוהו מעלים את האורות דתיקון."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דזהו גם הקישור26"
        },
        {
          "s": 2,
          "text": "דב' הפירושים בכובד ראש,"
        },
        {
          "s": 3,
          "text": "ראש שלמעלה וראש דנשמה"
        },
        {
          "s": 4,
          "text": "(נה\"א)."
        },
        {
          "s": 5,
          "text": "כי כשם שע\"י בירור עשר כחות דנה\"ב,"
        },
        {
          "s": 6,
          "text": "עשר גרה,"
        },
        {
          "s": 7,
          "text": "מעלים את המחצית העליון,"
        },
        {
          "s": 8,
          "text": "עשר כחות דנה\"א,"
        },
        {
          "s": 9,
          "text": "עד\"ז הוא להפי' דקאי על ראש שלמעלה,"
        },
        {
          "s": 10,
          "text": "כי ע\"י ש"
        },
        {
          "s": 11,
          "text": "(הקב\"ה עוזרו ה\"ה)"
        },
        {
          "s": 12,
          "text": "מעלה את עשר כחות נפשו,"
        },
        {
          "s": 13,
          "text": "שהנשמה ירדה למטה,"
        },
        {
          "s": 14,
          "text": "והרשות והיכולת נתונה לכל אדם27"
        },
        {
          "s": 15,
          "text": "וכו',"
        },
        {
          "s": 16,
          "text": "ועי\"ז פועל עלי' כביכול גם בשכינה וכו'."
        }
      ]
    }
  ]
}