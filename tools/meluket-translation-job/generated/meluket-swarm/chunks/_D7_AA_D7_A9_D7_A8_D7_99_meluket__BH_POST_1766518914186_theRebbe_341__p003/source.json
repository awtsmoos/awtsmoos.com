{
  "globalIndex": 85,
  "owner": 35,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914186_theRebbe_341__p003",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914186_theRebbe_341__p003",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914186_theRebbe_341",
  "title": "מאמר בסוכות תשבו תשל\"ו",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה הכוונה בהמשכת המקיפים דסוכה היא שיומשכו ויפעלו גם בפנימיות."
        },
        {
          "s": 2,
          "text": "וזהו\"ע נטילת ד' מינים הבאה בהמשך לבסוכות תשבו"
        },
        {
          "s": 3,
          "text": "[דמצות ישיבה בסוכה היא מהתחלת שבעת ימי הסוכות,"
        },
        {
          "s": 4,
          "text": "ולאחרי זה בבוקר"
        },
        {
          "s": 5,
          "text": "(בעלות השחר או מנץ החמה38)"
        },
        {
          "s": 6,
          "text": "מתחילה מצות נטילת ד' מינים],"
        },
        {
          "s": 7,
          "text": "דהנה ענין נטילת ד' מינים הוא להמשיך המקיף"
        },
        {
          "s": 8,
          "text": "(דסוכה)"
        },
        {
          "s": 9,
          "text": "בפנימיות,"
        },
        {
          "s": 10,
          "text": "וכמבואר בקבלה"
        },
        {
          "s": 11,
          "text": "(מ\"ח)"
        },
        {
          "s": 12,
          "text": "ובחסידות39"
        },
        {
          "s": 13,
          "text": "שענין הנענועים הוא להמשיך בחי' הדעת בנוקבא דז\"א העומדת בחזה דז\"א"
        },
        {
          "s": 14,
          "text": "[שלכן צריך שהלולב ומיניו יגעו בחזה],"
        },
        {
          "s": 15,
          "text": "דענין ההמשכה בנוקבא הוא שההמשכה תהי' גם בעניני העולם,"
        },
        {
          "s": 16,
          "text": "עד לעניני עוה\"ז התחתון שאין תחתון למטה ממנו."
        },
        {
          "s": 17,
          "text": "ולכן גם פעולת השלום שע\"י המשכת הדעת היא גם למטה בעוה\"ז התחתון,"
        },
        {
          "s": 18,
          "text": "בדוגמת לע\"ל שלא ירעו ולא ישחיתו גו' כי מלאה הארץ דעה את הוי'."
        },
        {
          "s": 19,
          "text": "והשייכות דמלאה הארץ דעה גו' ללא ירעו ולא ישחיתו הוא40"
        },
        {
          "s": 20,
          "text": "לפי שהקטטות והמריבות הם מצד קטנות הדעת."
        },
        {
          "s": 21,
          "text": "וידוע המשל על זה,"
        },
        {
          "s": 22,
          "text": "שהקטן שאין לו דעת,"
        },
        {
          "s": 23,
          "text": "כאשר אין ממלאים רצונו,"
        },
        {
          "s": 24,
          "text": "מיד הוא מתרגז כו'"
        },
        {
          "s": 25,
          "text": "(וכמבואר בספר תניא קדישא41"
        },
        {
          "s": 26,
          "text": "שהקטן מתכעס כו' מדברים קטנים),"
        },
        {
          "s": 27,
          "text": "משא\"כ הגדול שיש לו דעת,"
        },
        {
          "s": 28,
          "text": "יכול הוא לסבול גם היפוכו."
        },
        {
          "s": 29,
          "text": "ועד\"ז הוא גם בענין השלום דסוכה,"
        },
        {
          "s": 30,
          "text": "דמכיון שענין הסוכה הוא כמ\"ש למען ידעו,"
        },
        {
          "s": 31,
          "text": "לכן ע\"י הדעת הנמשך ע\"י הסוכה,"
        },
        {
          "s": 32,
          "text": "נעשה השלום,"
        },
        {
          "s": 33,
          "text": "סוכת שלומך."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "אמנם בכדי להמשיך המקיף דסוכה בבחי' פנימיות,"
        },
        {
          "s": 2,
          "text": "ועד שיהי' בבחי' התיישבות כמ\"ש בסוכות תשבו"
        },
        {
          "s": 3,
          "text": "[ועד שע\"י נטילת ד' מינים יומשך זה גם בבחי' נוקבא דז\"א],"
        },
        {
          "s": 4,
          "text": "דהגם שהמקיף דסוכה הוא נעלה ביותר"
        },
        {
          "s": 5,
          "text": "[וכנ\"ל שהמקיף דסוכה הוא למעלה אפילו מהתחלקות של לבושי הראש לבושי הגוף ולבושי הרגל,"
        },
        {
          "s": 6,
          "text": "ועאכו\"כ שאין בו ההתחלקות דראש גוף ורגל],"
        },
        {
          "s": 7,
          "text": "מ\"מ יהי' בזה ענין ההתיישבות,"
        },
        {
          "s": 8,
          "text": "בא הביאור כי בסוכות הושבתי את בנ\"י בהוציאי אותם מארץ מצרים,"
        },
        {
          "s": 9,
          "text": "ההתחלה הי' מהקב\"ה,"
        },
        {
          "s": 10,
          "text": "אני המתחיל42."
        },
        {
          "s": 11,
          "text": "וע\"י זה שבסוכות הושבתי,"
        },
        {
          "s": 12,
          "text": "נמשכה נתינת הכח שיהי' בסוכות תשבו."
        },
        {
          "s": 13,
          "text": "ואומר על זה למען ידעו,"
        },
        {
          "s": 14,
          "text": "שענין הישיבה בסוכה צ\"ל לא באופן דחוקה חקקתי גזירה גזרתי,"
        },
        {
          "s": 15,
          "text": "כ\"א שיומשך ויבוא בדעת,"
        },
        {
          "s": 16,
          "text": "בפנימיות,"
        },
        {
          "s": 17,
          "text": "ויומשך גם בבחי' הזמן,"
        },
        {
          "s": 18,
          "text": "דזהו בסוכות תשבו שבעת ימים,"
        },
        {
          "s": 19,
          "text": "דשבעת ימים כוללים כל משך הזמן וכל השינויים שבהם."
        },
        {
          "s": 20,
          "text": "וכמבואר בכ\"מ43"
        },
        {
          "s": 21,
          "text": "עה\"פ44"
        },
        {
          "s": 22,
          "text": "נער הייתי גם זקנתי,"
        },
        {
          "s": 23,
          "text": "שבכל יום ראשון בשבוע מתחיל מחדש הענין דשבעת ימי בראשית."
        },
        {
          "s": 24,
          "text": "והוא ע\"ד משנת\"ל שע\"י הנענועים ממשיכים בבחי' הנוקבא,"
        },
        {
          "s": 25,
          "text": "(בחי' מלכות)"
        },
        {
          "s": 26,
          "text": "שהיא התחלת45"
        },
        {
          "s": 27,
          "text": "ענין הזמן."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וממשיך בכתוב כל האזרח בישראל ישבו בסוכות."
        },
        {
          "s": 2,
          "text": "וצריך להבין,"
        },
        {
          "s": 3,
          "text": "הרי הציווי בסוכות תשבו גו' הוא לכל ישראל,"
        },
        {
          "s": 4,
          "text": "ומה מוסיף בכל האזרח בישראל גו'."
        },
        {
          "s": 5,
          "text": "והענין בזה,"
        },
        {
          "s": 6,
          "text": "דאזרח קאי על הבחינה שתזרח לעתיד,"
        },
        {
          "s": 7,
          "text": "ולכן תיבת אזרח מתחלת באל\"ף,"
        },
        {
          "s": 8,
          "text": "שהיא מהאותיות המשמשות על עתיד46."
        },
        {
          "s": 9,
          "text": "וזהו כל האזרח בישראל ישבו בסוכות,"
        },
        {
          "s": 10,
          "text": "שיש בזה ב' פי',"
        },
        {
          "s": 11,
          "text": "שמצד בחי' האזרח בישראל שתהי' לעתיד,"
        },
        {
          "s": 12,
          "text": "יש כח גם עכשיו שיהי' בסוכות תשבו,"
        },
        {
          "s": 13,
          "text": "שגם בבחי' האזרח בישראל,"
        },
        {
          "s": 14,
          "text": "וגם כמו שתהי' לע\"ל,"
        },
        {
          "s": 15,
          "text": "גם בבחי' זו מיתוסף ע\"י הישיבה בסוכה."
        },
        {
          "s": 16,
          "text": "וי\"ל דזהו הטעם שמצות סוכה תהי' לע\"ל ביתר שאת ויתר עז,"
        },
        {
          "s": 17,
          "text": "כמבואר בנבואת זכרי'47"
        },
        {
          "s": 18,
          "text": "(שמפטירין בימי הסוכות)."
        }
      ]
    }
  ]
}