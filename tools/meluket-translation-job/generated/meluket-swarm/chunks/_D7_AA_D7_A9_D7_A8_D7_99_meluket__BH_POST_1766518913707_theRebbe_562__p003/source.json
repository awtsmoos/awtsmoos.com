{
  "globalIndex": 2,
  "owner": 2,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913707_theRebbe_562__p003",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913707_theRebbe_562__p003",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518913707_theRebbe_562",
  "title": "מאמר יבחר לנו את נחלתינו תשכ\"ג",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה במק\"א31"
        },
        {
          "s": 2,
          "text": "מבואר הטעם על זה שבכדי שיהי' בנין המלכות הוא ע\"י ההמשכה מעצמות אוא\"ס,"
        },
        {
          "s": 3,
          "text": "כי מלכות ענינה הוא גילוי."
        },
        {
          "s": 4,
          "text": "וגם המלכות שבכל ספירה ענינה הוא כח הגילוי של הספירה32."
        },
        {
          "s": 5,
          "text": "אלא שהגילוי ע\"י המלכות דהספירות הוא באצילות33,"
        },
        {
          "s": 6,
          "text": "ובכדי שיהי' הגילוי בבי\"ע הוא ע\"י המלכות כמו שהיא פרצוף בפ\"ע."
        },
        {
          "s": 7,
          "text": "ע\"ד הדיבור שבאדם"
        },
        {
          "s": 8,
          "text": "(מלכות הו\"ע הדיבור,"
        },
        {
          "s": 9,
          "text": "מלכות פה34)"
        },
        {
          "s": 10,
          "text": "שהוא גילוי לזולתו."
        },
        {
          "s": 11,
          "text": "וענין בנין המלכות שבר\"ה הוא35,"
        },
        {
          "s": 12,
          "text": "שהגילוי יהי' לא רק בנבראים דבי\"ע הרוחניים אלא גם בעשי' הגשמית,"
        },
        {
          "s": 13,
          "text": "ובזה עצמו – למטה מטה,"
        },
        {
          "s": 14,
          "text": "עד בהדומם,"
        },
        {
          "s": 15,
          "text": "כמו שאומרים בתפלות ר\"ה וידע כל פעול כי אתה פעלתו,"
        },
        {
          "s": 16,
          "text": "שגם הדומם"
        },
        {
          "s": 17,
          "text": "(שבעשי')36"
        },
        {
          "s": 18,
          "text": "ידע כי אתה פעלתו."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "וזהו אמרו לפני מלכיות כדי שתמליכוני עליכם כו' ובמה בשופר,"
        },
        {
          "s": 1,
          "text": "דמהטעמים על זה שאין מספיק אמירת מלכיות וצריך גם לתקוע בשופר,"
        },
        {
          "s": 2,
          "text": "הוא37,"
        },
        {
          "s": 3,
          "text": "כי הענין דתמליכוני שבר\"ה הוא שיומשך הגילוי בעשי',"
        },
        {
          "s": 4,
          "text": "וזה נעשה ע\"י תקיעת שופר במעשה."
        },
        {
          "s": 5,
          "text": "וע\"י שהמעשה דתקיעת שופר הוא שתוקעין בשופר של בהמה,"
        },
        {
          "s": 6,
          "text": "נמשך הגילוי גם בענינים הגשמיים,"
        },
        {
          "s": 7,
          "text": "בהמה שבאדם."
        },
        {
          "s": 8,
          "text": "ובכדי שיומשך הגילוי למטה יותר עד בהדומם,"
        },
        {
          "s": 9,
          "text": "צריך שקרן השופר שבו תוקעין יהי' תלוש"
        },
        {
          "s": 10,
          "text": "(ולא מחובר להבהמה),"
        },
        {
          "s": 11,
          "text": "דומם."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "והנה כל שההמשכה היא למטה יותר,"
        },
        {
          "s": 1,
          "text": "הוא ע\"י ששורש ההמשכה הוא למעלה יותר."
        },
        {
          "s": 2,
          "text": "וכמובא38"
        },
        {
          "s": 3,
          "text": "הדוגמא לזה מכח ההפלאה שבחכמה,"
        },
        {
          "s": 4,
          "text": "שהירידה היא כפי אופן ההפלאה."
        },
        {
          "s": 5,
          "text": "שבכדי להוריד את השכל ולהלבישו במשל"
        },
        {
          "s": 6,
          "text": "(ושהמשל יהי' מכוון)"
        },
        {
          "s": 7,
          "text": "הוא דוקא כשיודע את עצם הענין."
        },
        {
          "s": 8,
          "text": "ולהעיר,"
        },
        {
          "s": 9,
          "text": "שבכח הירידה דשכל שני ענינים."
        },
        {
          "s": 10,
          "text": "שביכלתו לצמצם את השכל שיהי' לפי ערך התלמיד,"
        },
        {
          "s": 11,
          "text": "ושביכלתו להעלים את השכל ע\"י שמלבישו במשל."
        },
        {
          "s": 12,
          "text": "וגם בכדי לצמצם את השכל צריך לכח עליון יותר."
        },
        {
          "s": 13,
          "text": "ויש לומר,"
        },
        {
          "s": 14,
          "text": "דהטעם שמביא בהמאמר ענין הירידה דהתלבשות במשל,"
        },
        {
          "s": 15,
          "text": "הוא,"
        },
        {
          "s": 16,
          "text": "כי מדבר כאן בכח ההפלאה"
        },
        {
          "s": 17,
          "text": "(הפשטה)"
        },
        {
          "s": 18,
          "text": "שבחכמה,"
        },
        {
          "s": 19,
          "text": "ובענין זה נוגע יותר הירידה דהתלבשות במשל."
        },
        {
          "s": 20,
          "text": "דהגם שענין ההתלבשות במשל"
        },
        {
          "s": 21,
          "text": "(משא\"כ הירידה דצמצום)"
        },
        {
          "s": 22,
          "text": "הוא לכאורה היפך ענין ההפלאה,"
        },
        {
          "s": 23,
          "text": "מ\"מ,"
        },
        {
          "s": 24,
          "text": "בזה שמלביש את השכל במשל ניכר ומתגלה כח ההפלאה דחכמה."
        },
        {
          "s": 25,
          "text": "דזה שהתלבשות במשל הוא היפך ההפלאה הוא כשההפלאה היא מוגדרת ומצויירת בהציור דלמעלה מהתלבשות במשל,"
        },
        {
          "s": 26,
          "text": "אבל מצד אמיתית ענין ההפלאה,"
        },
        {
          "s": 27,
          "text": "אפשר להיות גם התלבשות במשל."
        }
      ]
    }
  ]
}