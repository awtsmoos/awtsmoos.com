{
  "globalIndex": 504,
  "owner": 4,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916754_theRebbe_640__p003",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916754_theRebbe_640__p003",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916754_theRebbe_640",
  "title": "מאמר באתי לגני תשכ\"ח",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "וממשיך בהמאמר39,"
        },
        {
          "s": 1,
          "text": "דכמו שבמלחמה בגשמיות,"
        },
        {
          "s": 2,
          "text": "בכדי לנצח את המלחמה מבזבזים כל האוצרות40,"
        },
        {
          "s": 3,
          "text": "דהגם שע\"ד הרגיל הנה לא רק שאין משתמשים בהם"
        },
        {
          "s": 4,
          "text": "(אפילו לצורך גדול)"
        },
        {
          "s": 5,
          "text": "אלא יתירה מזו שהם כמוסים וחתומים מעין כל רואה,"
        },
        {
          "s": 6,
          "text": "ומ\"מ בכדי לנצח את המנגד מבזבזים כל האוצרות41,"
        },
        {
          "s": 7,
          "text": "דלא רק שמשתמשים בהאוצרות אלא שגם מבזבזים אותם,"
        },
        {
          "s": 8,
          "text": "דבזבוז הוא למעלה מחשבון מדידה והגבלה,"
        },
        {
          "s": 9,
          "text": "והטעם לזה הוא כי הנצח מושרש בעצם הנפש דשם"
        },
        {
          "s": 10,
          "text": "(בעצם הנפש)"
        },
        {
          "s": 11,
          "text": "אין שייך שום חשבונות,"
        },
        {
          "s": 12,
          "text": "עד\"ז הוא גם למעלה,"
        },
        {
          "s": 13,
          "text": "דשרש הנצח הוא בפנימיות הכתר,"
        },
        {
          "s": 14,
          "text": "ולכן,"
        },
        {
          "s": 15,
          "text": "בכדי שהצבאות ה' ינצחו את המלחמה,"
        },
        {
          "s": 16,
          "text": "נותנים להם,"
        },
        {
          "s": 17,
          "text": "ובאופן דבזבוז,"
        },
        {
          "s": 18,
          "text": "בחי' האוצר שלמעלה"
        },
        {
          "s": 19,
          "text": "(שלמעלה מאור וגילוי),"
        },
        {
          "s": 20,
          "text": "שעליו נאמר עין לא ראתה42"
        },
        {
          "s": 21,
          "text": "בכדי לנצח את המלחמה ולעשות את העולם דירה לו ית'."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דזה שמבאר בהמאמר שהטעם על זה הוא לפי דשרש הנצח הוא בפנימיות הכתר,"
        },
        {
          "s": 2,
          "text": "הוא בעיקר על זה שנתינת האוצר היא באופן דבזבוז."
        },
        {
          "s": 3,
          "text": "דזה שנותנים האוצר בכדי לעשות את העולם לדירה לו ית',"
        },
        {
          "s": 4,
          "text": "יש לומר,"
        },
        {
          "s": 5,
          "text": "שזהו מפני שהכוונה דדירה בתחתונים היא בעצמותו ית',"
        },
        {
          "s": 6,
          "text": "כמאמר רבינו הזקן43"
        },
        {
          "s": 7,
          "text": "בדיוק לשון רז\"ל30"
        },
        {
          "s": 8,
          "text": "נתאוה כו' דירה בתחתונים,"
        },
        {
          "s": 9,
          "text": "דענין \"נתאוה\" הוא למעלה מהטעם,"
        },
        {
          "s": 10,
          "text": "לכן,"
        },
        {
          "s": 11,
          "text": "הנתינת כח להשלים כוונה זו היא מעצמותו ית',"
        },
        {
          "s": 12,
          "text": "בחי' אוצר שלמעלה מאור וגילוי."
        },
        {
          "s": 13,
          "text": "והטעם דשרש הנצח הוא בפנימיות הכתר,"
        },
        {
          "s": 14,
          "text": "הוא"
        },
        {
          "s": 15,
          "text": "(בעיקר)"
        },
        {
          "s": 16,
          "text": "על זה שנתינת האוצר הוא באופן דבזבוז."
        },
        {
          "s": 17,
          "text": "ויש להוסיף,"
        },
        {
          "s": 18,
          "text": "דנתינת האוצר באופן של בזבוז להצבאות הוי' לנצח את המלחמה הוא לא רק מצד מלמעלה"
        },
        {
          "s": 19,
          "text": "(לפי דשרש הנצח הוא בפנימיות הכתר),"
        },
        {
          "s": 20,
          "text": "אלא שזה שייך גם להצבאות הוי'."
        },
        {
          "s": 21,
          "text": "דמכיון שעבודה שלהם היא באופן דבזבוז"
        },
        {
          "s": 22,
          "text": "(למעלה מחשבונות),"
        },
        {
          "s": 23,
          "text": "שטות דקדושה שלמעלה מטו\"ד,"
        },
        {
          "s": 24,
          "text": "לכן הם מתאימים וכלים שיומשך להם האוצר שלמעלה באופן דבזבוז."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר בפרק ח\"י"
        },
        {
          "s": 2,
          "text": "(הפרק השייך לשנה זו44),"
        },
        {
          "s": 3,
          "text": "דביאור הענין"
        },
        {
          "s": 4,
          "text": "(ששרש הנצח הוא בפנימיות הכתר)"
        },
        {
          "s": 5,
          "text": "יובן ע\"פ מ\"ש45"
        },
        {
          "s": 6,
          "text": "וגם נצח ישראל לא ישקר ולא ינחם כי לא אדם הוא להנחם."
        },
        {
          "s": 7,
          "text": "דזה שנצח ישראל לא ינחם הוא לפי ששרש הנצח הוא בבחינת לא אדם"
        },
        {
          "s": 8,
          "text": "(פנימיות הכתר),"
        },
        {
          "s": 9,
          "text": "ובבחינת לא אדם אין שייך ניחומין וחרטה."
        },
        {
          "s": 10,
          "text": "והענין הוא,"
        },
        {
          "s": 11,
          "text": "דפסוק זה"
        },
        {
          "s": 12,
          "text": "(וגם נצח ישראל גו' לא ינחם גו')"
        },
        {
          "s": 13,
          "text": "הוא מענה שמואל לשאול על בקשתו שתחזור לו המלוכה,"
        },
        {
          "s": 14,
          "text": "דלאחרי שהקב\"ה נתן את המלוכה לדוד"
        },
        {
          "s": 15,
          "text": "(\"ונתנה לרעך הטוב ממך\"46)"
        },
        {
          "s": 16,
          "text": "אין שייך דיחזור בו ויטול ממנו המלוכה,"
        },
        {
          "s": 17,
          "text": "כי לא אדם הוא להנחם."
        },
        {
          "s": 18,
          "text": "ומדייק בזה אדמו\"ר הזקן בתורה אור47,"
        },
        {
          "s": 19,
          "text": "הרי מזה גופא שבתחילה ניתנה המלוכה לשאול,"
        },
        {
          "s": 20,
          "text": "וכשחטא ניטלה ממנו המלוכה,"
        },
        {
          "s": 21,
          "text": "מוכח,"
        },
        {
          "s": 22,
          "text": "שגם למעלה שייך נחמה,"
        },
        {
          "s": 23,
          "text": "וכמפורש בקרא48"
        },
        {
          "s": 24,
          "text": "נחמתי כי המלכתי את שאול למלך גו',"
        },
        {
          "s": 25,
          "text": "ומהו אומרו"
        },
        {
          "s": 26,
          "text": "(בנוגע למלכות דוד)"
        },
        {
          "s": 27,
          "text": "כי לא אדם הוא להנחם."
        },
        {
          "s": 28,
          "text": "ונקודת הביאור בזה,"
        },
        {
          "s": 29,
          "text": "דכוונת הכתוב בכי לא אדם הוא גו' היא לא רק שהקב\"ה אינו כמו אדם התחתון להבדיל,"
        },
        {
          "s": 30,
          "text": "כי אם,"
        },
        {
          "s": 31,
          "text": "בעיקר,"
        },
        {
          "s": 32,
          "text": "שאינו גם בגדר ציור אדם העליון."
        },
        {
          "s": 33,
          "text": "וזהו שבמלכות שאול כתיב48"
        },
        {
          "s": 34,
          "text": "נחמתי כי המלכתי את שאול למלך גו' ובנוגע למלכות דוד כתיב כי לא אדם הוא להנחם,"
        },
        {
          "s": 35,
          "text": "כי המלוכה דשאול היתה מבחי' אדם,"
        },
        {
          "s": 36,
          "text": "דבבחינה זו שייך נחמה,"
        },
        {
          "s": 37,
          "text": "משא\"כ המלוכה דדוד היא מבחי' לא אדם,"
        },
        {
          "s": 38,
          "text": "דבבחינה זו אין שייך נחמה ושינוי,"
        },
        {
          "s": 39,
          "text": "כמבואר בתו\"א."
        }
      ]
    }
  ]
}