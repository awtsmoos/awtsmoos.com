{
  "globalIndex": 1004,
  "owner": 4,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919735_theRebbe_388__p004",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919735_theRebbe_388__p004",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919735_theRebbe_388",
  "title": "מאמר ציון במשפט תפדה תשמ\"א",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וזהו ציון במשפט תפדה ושבי' בצדקה,"
        },
        {
          "s": 2,
          "text": "דזה שישראל נק' בשם ציון הוא ע\"י שעוסקים בתורה עבודה וגמ\"ח,"
        },
        {
          "s": 3,
          "text": "שהם כללות כל התומ\"צ,"
        },
        {
          "s": 4,
          "text": "שעי\"ז הם נעשים בבחי' ציון מלשון סימן,"
        },
        {
          "s": 5,
          "text": "דגם כשנמצאים בגלות אינם נאבדים ח\"ו בין האומות"
        },
        {
          "s": 6,
          "text": "(ובדוגמת דבר שיש לו סימן כפשוטו,"
        },
        {
          "s": 7,
          "text": "שע\"י הסימן מחזירים אותו לבעליו)."
        },
        {
          "s": 8,
          "text": "ויתירה מזו,"
        },
        {
          "s": 9,
          "text": "שע\"י עבודתם בתומ\"צ בזמן הגלות נעשה בהם יתרון ועלי',"
        },
        {
          "s": 10,
          "text": "למעלה יותר מכמו שהיו בזמן הבית."
        },
        {
          "s": 11,
          "text": "והיתרון הוא בשני ענינים."
        },
        {
          "s": 12,
          "text": "א',"
        },
        {
          "s": 13,
          "text": "שע\"י העבודה בזמן הגלות מתגלה"
        },
        {
          "s": 14,
          "text": "(כנ\"ל סעיף ה)"
        },
        {
          "s": 15,
          "text": "התוקף והבל\"ג דהאור,"
        },
        {
          "s": 16,
          "text": "שגם חושך הכי גדול"
        },
        {
          "s": 17,
          "text": "(חושך הגלות,"
        },
        {
          "s": 18,
          "text": "כולל גם החושך כפול ומכופל שבדרא דעקבתא דמשיחא)"
        },
        {
          "s": 19,
          "text": "אינו מעלים לגבי'."
        },
        {
          "s": 20,
          "text": "דבכללות הוא האור שלמעלה מהכלים"
        },
        {
          "s": 21,
          "text": "(האור שבהבדלה48),"
        },
        {
          "s": 22,
          "text": "שהוא בלי גבול."
        },
        {
          "s": 23,
          "text": "אבל אעפ\"כ הוא מוגדר בגדר אור."
        },
        {
          "s": 24,
          "text": "וב',"
        },
        {
          "s": 25,
          "text": "שע\"י הפיכת החושך לאור מתגלה העצמות שלמעלה מהגדרים דאור וחושך"
        },
        {
          "s": 26,
          "text": "(כנ\"ל)."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "והנה בפסוק זה,"
        },
        {
          "s": 1,
          "text": "הסיום והחותם49"
        },
        {
          "s": 2,
          "text": "של ההפטורה חזון ישעיהו"
        },
        {
          "s": 3,
          "text": "[דענינו של ישעי' הוא"
        },
        {
          "s": 4,
          "text": "(כשמו)"
        },
        {
          "s": 5,
          "text": "ישועה50,"
        },
        {
          "s": 6,
          "text": "ועד לישועה אמיתית שהיא הגאולה שלימה שאין אחרי' גלות51."
        },
        {
          "s": 7,
          "text": "דזהו גם מה שממשיך בכתוב52"
        },
        {
          "s": 8,
          "text": "אשר חזה גו' בימי גו' יחזקיהו,"
        },
        {
          "s": 9,
          "text": "שביקש הקב\"ה לעשות חזקיהו משיח53],"
        },
        {
          "s": 10,
          "text": "מדבר בהעילוי שיהי' בגאולה העתידה."
        },
        {
          "s": 11,
          "text": "ובזה גופא – בעילוי הב',"
        },
        {
          "s": 12,
          "text": "שהוא עיקר התכלית דהגלות."
        },
        {
          "s": 13,
          "text": "וזהו אומרו תפדה ושבי',"
        },
        {
          "s": 14,
          "text": "שעילוי זה הוא הן בהגוף שיפדה מהגלות"
        },
        {
          "s": 15,
          "text": "(תפדה)"
        },
        {
          "s": 16,
          "text": "והן בהנשמה שתשוב ממקום הגולה"
        },
        {
          "s": 17,
          "text": "(ושבי')."
        },
        {
          "s": 18,
          "text": "וזהו גם תפדה במשפט ושבי' בצדקה,"
        },
        {
          "s": 19,
          "text": "דהעילוי שיהי' בהגוף"
        },
        {
          "s": 20,
          "text": "(תפדה)"
        },
        {
          "s": 21,
          "text": "הוא במשפט,"
        },
        {
          "s": 22,
          "text": "דכיון שהגוף הי' בגלות ממש והי' בו הענין דהפיכת החושך לאור,"
        },
        {
          "s": 23,
          "text": "לכן,"
        },
        {
          "s": 24,
          "text": "היתרון והעילוי שנעשה עי\"ז,"
        },
        {
          "s": 25,
          "text": "מגיע לו ע\"פ שורת הדין,"
        },
        {
          "s": 26,
          "text": "במשפט."
        },
        {
          "s": 27,
          "text": "משא\"כ זה שהנשמה שהיתה רק במקום הגולה"
        },
        {
          "s": 28,
          "text": "(ושבי')"
        },
        {
          "s": 29,
          "text": "תתעלה לבחינה זו,"
        },
        {
          "s": 30,
          "text": "הוא"
        },
        {
          "s": 31,
          "text": "(לא ע\"פ שורת הדין,"
        },
        {
          "s": 32,
          "text": "אלא)"
        },
        {
          "s": 33,
          "text": "בצדקה."
        },
        {
          "s": 34,
          "text": "ולכאורה יש להוסיף,"
        },
        {
          "s": 35,
          "text": "שבפרט אחד יש יתרון בהעלי' דהנשמה על העלי' דהגוף."
        },
        {
          "s": 36,
          "text": "שהעלי' דהגוף,"
        },
        {
          "s": 37,
          "text": "שהיא במשפט"
        },
        {
          "s": 38,
          "text": "(היינו שהעלי' היא ע\"פ חשבון דטעם ודעת),"
        },
        {
          "s": 39,
          "text": "יש בזה איזו מדידה והגבלה,"
        },
        {
          "s": 40,
          "text": "משא\"כ העלי' דהנשמה,"
        },
        {
          "s": 41,
          "text": "שהיא בצדקה,"
        },
        {
          "s": 42,
          "text": "היא למעלה מכל מדידה והגבלה."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ואין מקרא יוצא מידי פשוטו54,"
        },
        {
          "s": 1,
          "text": "ועד שדוקא על ידי לימוד הפשט מתגלה העצם דתורה,"
        },
        {
          "s": 2,
          "text": "כי פשט הוא בעולם העשי'55,"
        },
        {
          "s": 3,
          "text": "שבו דוקא נשלמת הכוונה דדירה בתחתונים."
        },
        {
          "s": 4,
          "text": "ולכאורה י\"ל דזהו גם הטעם"
        },
        {
          "s": 5,
          "text": "(בפנימיות הענינים)"
        },
        {
          "s": 6,
          "text": "דזה שהלימוד עם תשב\"ר,"
        },
        {
          "s": 7,
          "text": "הבל שאין בו חטא56,"
        },
        {
          "s": 8,
          "text": "הוא דוקא ע\"פ הפשט."
        },
        {
          "s": 9,
          "text": "וי\"ל שכן הוא גם בנוגע לעניננו – הפסוק ציון במשפט תפדה ושבי' בצדקה,"
        },
        {
          "s": 10,
          "text": "שעיקר הענין בזה הוא פירוש הפסוק כפשוטו,"
        },
        {
          "s": 11,
          "text": "הפדי' והיציאה מהגלות בפשטות בגאולה האמיתית והשלימה ע\"י משיח צדקנו,"
        },
        {
          "s": 12,
          "text": "בקרוב ממש בעגלא דידן."
        }
      ]
    }
  ]
}