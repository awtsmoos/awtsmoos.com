{
  "globalIndex": 542,
  "owner": 42,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916877_theRebbe_274__p001",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916877_theRebbe_274__p001",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916877_theRebbe_274",
  "title": "מאמר באתי לגני תשל\"ב",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "יו\"ד שבט,"
        },
        {
          "s": 2,
          "text": "ה'תשל\"ב"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "באתי לגני אחותי כלה1,"
        },
        {
          "s": 1,
          "text": "ומביא כ\"ק מו\"ח אדמו\"ר בעל ההילולא בהמאמר דיום ההסתלקות ויום ההילולא שלו2,"
        },
        {
          "s": 2,
          "text": "דאיתא במדרש רבה"
        },
        {
          "s": 3,
          "text": "(במקומו)"
        },
        {
          "s": 4,
          "text": "לגני לגנוני,"
        },
        {
          "s": 5,
          "text": "למקום שהי' עיקרי בתחלה,"
        },
        {
          "s": 6,
          "text": "דעיקר שכינה בתחתונים היתה,"
        },
        {
          "s": 7,
          "text": "אלא שע\"י הענינים הבלתי רצויים"
        },
        {
          "s": 8,
          "text": "(מתחיל מחטא עץ הדעת)"
        },
        {
          "s": 9,
          "text": "נסתלקה השכינה מלמטה למעלה עד לרקיע השביעי,"
        },
        {
          "s": 10,
          "text": "ואח\"כ עמדו צדיקים"
        },
        {
          "s": 11,
          "text": "(מתחיל מאברהם אבינו,"
        },
        {
          "s": 12,
          "text": "אחד הי' אברהם3)"
        },
        {
          "s": 13,
          "text": "והורידו את השכינה מלמעלה למטה,"
        },
        {
          "s": 14,
          "text": "עד שבא משה שהוא השביעי,"
        },
        {
          "s": 15,
          "text": "וכל השביעין חביבין4,"
        },
        {
          "s": 16,
          "text": "והורידה למטה בארץ."
        },
        {
          "s": 17,
          "text": "וענין זה"
        },
        {
          "s": 18,
          "text": "(המשכת וירידת השכינה למטה בארץ,"
        },
        {
          "s": 19,
          "text": "שהיתה ע\"י משה)"
        },
        {
          "s": 20,
          "text": "הי' בעיקר5"
        },
        {
          "s": 21,
          "text": "בבית המקדש6,"
        },
        {
          "s": 22,
          "text": "כמ\"ש7"
        },
        {
          "s": 23,
          "text": "ועשו לי מקדש ושכנתי בתוכם."
        },
        {
          "s": 24,
          "text": "ולהעיר,"
        },
        {
          "s": 25,
          "text": "שבמדרש שם מדבר בנוגע להזמן שבו היתה המשכת השכינה למטה,"
        },
        {
          "s": 26,
          "text": "שעיקר השראת השכינה בארץ היתה ביום שהוקם המשכן,"
        },
        {
          "s": 27,
          "text": "ובהמאמר מדבר בנוגע להמקום שבו נמשכה השכינה,"
        },
        {
          "s": 28,
          "text": "דעיקר ההמשכה הוא במשכן ומקדש,"
        },
        {
          "s": 29,
          "text": "ועי\"ז נמשך גילוי אלקות גם בכללות העולם."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר דיוק לשון הכתוב ושכנתי בתוכם,"
        },
        {
          "s": 2,
          "text": "בתוכו לא נאמר אלא בתוכם,"
        },
        {
          "s": 3,
          "text": "בתוך כל אחד ואחד מישראל8."
        },
        {
          "s": 4,
          "text": "וזהו צדיקים יירשו ארץ וישכנו לעד עלי'9,"
        },
        {
          "s": 5,
          "text": "שצדיקים הם משכינים"
        },
        {
          "s": 6,
          "text": "(ממשיכים10)"
        },
        {
          "s": 7,
          "text": "את השכינה שנק' עד,"
        },
        {
          "s": 8,
          "text": "שוכן עד מרום וקדוש11,"
        },
        {
          "s": 9,
          "text": "שתהי' בגילוי למטה."
        },
        {
          "s": 10,
          "text": "ויש לומר,"
        },
        {
          "s": 11,
          "text": "דזה שמביא בהמאמר פירוש הפסוק צדיקים יירשו ארץ גו' לאחרי שמבאר שעיקר ההמשכה היתה במשכן12"
        },
        {
          "s": 12,
          "text": "ולאחרי שמבאר דבתוכם לשון רבים הוא בתוך כל אחד ואחד מישראל,"
        },
        {
          "s": 13,
          "text": "הוא לרמז,"
        },
        {
          "s": 14,
          "text": "דזה שצדיקים ממשיכים את השכינה למטה"
        },
        {
          "s": 15,
          "text": "(וישכנו לעד עלי'),"
        },
        {
          "s": 16,
          "text": "הכוונה בזה היא לא רק לשבעה הצדיקים שמאברהם עד משה,"
        },
        {
          "s": 17,
          "text": "אלא לכאו\"א מישראל,"
        },
        {
          "s": 18,
          "text": "ועמך כולם צדיקים13."
        },
        {
          "s": 19,
          "text": "היינו,"
        },
        {
          "s": 20,
          "text": "דבזה שנאמר ושכנתי בתוכם"
        },
        {
          "s": 21,
          "text": "(לשון רבים)"
        },
        {
          "s": 22,
          "text": "שקאי"
        },
        {
          "s": 23,
          "text": "(גם)"
        },
        {
          "s": 24,
          "text": "על כאו\"א מישראל,"
        },
        {
          "s": 25,
          "text": "שני ענינים."
        },
        {
          "s": 26,
          "text": "שבכחו של כאו\"א מישראל להיות משכן ומקדש לו ית',"
        },
        {
          "s": 27,
          "text": "שיהי' שוכן בו עיקר שכינה"
        },
        {
          "s": 28,
          "text": "[באותו האופן ממש כמו שהי' בבית המקדש]"
        },
        {
          "s": 29,
          "text": "– ושכנתי בתוכם."
        },
        {
          "s": 30,
          "text": "וגם,"
        },
        {
          "s": 31,
          "text": "שעי\"ז יומשך גילוי אלקות בעולם – וישכנו לעד עלי'"
        },
        {
          "s": 32,
          "text": "(בארץ)."
        }
      ]
    }
  ]
}