{
  "globalIndex": 821,
  "owner": 21,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918679_theRebbe_674__p003",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918679_theRebbe_674__p003",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918679_theRebbe_674",
  "title": "מאמר אנכי הוי' אלוקיך תשמ\"ט",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והימים האלה נזכרים ונעשים32,"
        },
        {
          "s": 2,
          "text": "שבכל שנה ושנה חוזרים ונמשכים אותם הענינים כמו שהיו בפעם הראשונה,"
        },
        {
          "s": 3,
          "text": "ויתירה מזו,"
        },
        {
          "s": 4,
          "text": "שבכל שנה הם בדרגא נעלית יותר,"
        },
        {
          "s": 5,
          "text": "דמעלין בקודש33."
        },
        {
          "s": 6,
          "text": "וכיון שכל הענינים תלויים במעשינו ועבודתינו34,"
        },
        {
          "s": 7,
          "text": "לכן,"
        },
        {
          "s": 8,
          "text": "בכל שנה צריך להוסיף ולהעלות בקודש גם בההכנות למתן תורה,"
        },
        {
          "s": 9,
          "text": "הוספה בהענין דויחן לשון יחיד כאיש אחד בלב אחד שהי' בר\"ח סיון35,"
        },
        {
          "s": 10,
          "text": "וכן בההכנות שהיו לאחרי ר\"ח סיון"
        },
        {
          "s": 11,
          "text": "(שמיד אחר ר\"ח התחיל משה להתעסק עמהם בענין קבלת התורה36),"
        },
        {
          "s": 12,
          "text": "ועאכו\"כ בההכנה דהקדמת נעשה לנשמע,"
        },
        {
          "s": 13,
          "text": "שהיא ההכנה העיקרית למתן תורה כמובן גם מזה שהכנה זו דהקדמת נעשה לנשמע היא בחמישי בסיון שהוא הערב של ששי בסיון שבו ניתנה התורה."
        },
        {
          "s": 14,
          "text": "והוא,"
        },
        {
          "s": 15,
          "text": "שבמשך היום יתבוננו בהענין דהקדמת נעשה לנשמע,"
        },
        {
          "s": 16,
          "text": "התבוננות המתאימה שמביאה לידי פועל,"
        },
        {
          "s": 17,
          "text": "שבכל ענין דעבודת ה',"
        },
        {
          "s": 18,
          "text": "צריך לכל לראש לקיימו בפועל"
        },
        {
          "s": 19,
          "text": "(נעשה),"
        },
        {
          "s": 20,
          "text": "ולאחרי זה להבין את הענין בחב\"ד שלו"
        },
        {
          "s": 21,
          "text": "(נשמע)."
        },
        {
          "s": 22,
          "text": "ואף שיום זה"
        },
        {
          "s": 23,
          "text": "(חמישי בסיון)"
        },
        {
          "s": 24,
          "text": "הוא ערב יו\"ט שישנם בו כמה טרדות דהכנות צרכי החג,"
        },
        {
          "s": 25,
          "text": "הרי ידועה תורת כ\"ק מו\"ח אדמו\"ר37"
        },
        {
          "s": 26,
          "text": "שבחג השבועות ועד\"ז בערב"
        },
        {
          "s": 27,
          "text": "(ומעין)"
        },
        {
          "s": 28,
          "text": "חגה\"ש אין שליטה"
        },
        {
          "s": 29,
          "text": "(כ\"כ)"
        },
        {
          "s": 30,
          "text": "להצד שכנגד,"
        },
        {
          "s": 31,
          "text": "ולכן הוא זמן המוכשר לעשות הכל לטובת לימוד התורה והעבודה כו'."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ומובן בפשטות,"
        },
        {
          "s": 1,
          "text": "דנוסף להכנות הנ\"ל ששייכים להימים שלפני חגה\"ש,"
        },
        {
          "s": 2,
          "text": "מתחיל מר\"ח סיון,"
        },
        {
          "s": 3,
          "text": "צריך להיות ובמכ\"ש השתדלות מיוחדת בנוגע להענינים השייכים לחגה\"ש עצמו,"
        },
        {
          "s": 4,
          "text": "מתחיל מההשתדלות שכאו\"א מישראל,"
        },
        {
          "s": 5,
          "text": "אנשים נשים וטף,"
        },
        {
          "s": 6,
          "text": "יהיו בבית הכנסת בעת קריאת עשרת הדברות,"
        },
        {
          "s": 7,
          "text": "וכמדובר כמה פעמים38,"
        },
        {
          "s": 8,
          "text": "דזה שבכל שנה בחגה\"ש ניתנה התורה מחדש ע\"ד כמו שהי' בפעם הראשונה מתגלה בעיקר בהקריאה דעשרת הדברות,"
        },
        {
          "s": 9,
          "text": "כמאמר רז\"ל39"
        },
        {
          "s": 10,
          "text": "אמר הקב\"ה לישראל בני היו קורין את הפרשה הזאת בכל שנה ואני מעלה עליכם כאילו אתם עומדין לפני הר סיני ומקבלין את התורה,"
        },
        {
          "s": 11,
          "text": "שלכן צריך לשמוע פרשה זו באימה וביראה וכו' כאילו עומדים לפני הר סיני,"
        },
        {
          "s": 12,
          "text": "וזהו גם מהטעמים על גודל ההשתדלות שכל בני ישראל,"
        },
        {
          "s": 13,
          "text": "גם הקטני קטנים"
        },
        {
          "s": 14,
          "text": "(ות)"
        },
        {
          "s": 15,
          "text": "יהיו בבית הכנסת בעת קריאת עשרת הדברות,"
        },
        {
          "s": 16,
          "text": "כמדובר כמה פעמים בארוכה"
        },
        {
          "s": 17,
          "text": "[ולהוסיף,"
        },
        {
          "s": 18,
          "text": "שההשתדלות שהטף יהיו בביהכ\"נ בעת קריאת עשה\"ד שייך גם לההכנה דבנינו עורבים אותנו40,"
        },
        {
          "s": 19,
          "text": "שי\"ל שכולל גם הפירוש דעורבים מלשון תערובת שכל ישראל מעורבים זה בזה,"
        },
        {
          "s": 20,
          "text": "ועורבים מלשון עריבות ומתיקות שכל ישראל ערבים ומתוקים זה לזה41]."
        },
        {
          "s": 21,
          "text": "ועד\"ז החלטות טובות להוסיף בלימוד התורה,"
        },
        {
          "s": 22,
          "text": "נגלה דתורה ופנימיות התורה,"
        },
        {
          "s": 23,
          "text": "ועד שיפוצו מעינותיך חוצה,"
        },
        {
          "s": 24,
          "text": "כולל גם ההשתדלות לארגן כינוסי תורה באסרו חג השבועות זמן מתן תורתנו או בימים הסמוכים לזה42."
        },
        {
          "s": 25,
          "text": "וכאמור לעיל,"
        },
        {
          "s": 26,
          "text": "שבכל שנה צריך להוסיף בכל ענינים אלו ביתר שאת וביתר עוז,"
        },
        {
          "s": 27,
          "text": "הן בנוגע לההכנות השייכים להימים שלפני זמן מתן תורתנו,"
        },
        {
          "s": 28,
          "text": "והן בנוגע להחלטות טובות"
        },
        {
          "s": 29,
          "text": "(וההשתדלות)"
        },
        {
          "s": 30,
          "text": "בנוגע להענינים השייכים לזמן מתן תורתנו והימים שלאחריו."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "וכאמור לעיל,"
        },
        {
          "s": 1,
          "text": "שבכל שנה צריך להוסיף בההכנות למ\"ת ובפרט בההכנה דהקדמת נעשה לנשמע"
        },
        {
          "s": 2,
          "text": "(בערב חג השבועות),"
        },
        {
          "s": 3,
          "text": "ועי\"ז גם הענין דמתן תורה וקבלת התורה בחג השבועות הוא בדרגא נעלית יותר,"
        },
        {
          "s": 4,
          "text": "ועד באין ערוך."
        },
        {
          "s": 5,
          "text": "ועד שבכל שנה,"
        },
        {
          "s": 6,
          "text": "כל ענינים אלו"
        },
        {
          "s": 7,
          "text": "(מ\"ת וקבלת התורה,"
        },
        {
          "s": 8,
          "text": "וכן ההכנות לזה)"
        },
        {
          "s": 9,
          "text": "הם חדשים ממש."
        },
        {
          "s": 10,
          "text": "ובפרט בשנה זו"
        },
        {
          "s": 11,
          "text": "(תשמ\"ט),"
        },
        {
          "s": 12,
          "text": "ערב שנת תש\"נ שי\"ל – רמז ר\"ת תהא שנת נסים"
        },
        {
          "s": 13,
          "text": "(וגם בשנה זו,"
        },
        {
          "s": 14,
          "text": "ערב תש\"נ,"
        },
        {
          "s": 15,
          "text": "טועמים כבר מהנסים בתש\"נ43),"
        },
        {
          "s": 16,
          "text": "צריכה להיות ההכנה ביתר שאת וביתר עוז."
        },
        {
          "s": 17,
          "text": "וע\"י ההוספה מדי שנה בשנה בההכנות למתן תורה,"
        },
        {
          "s": 18,
          "text": "מיתוסף גם בהענין דמתן תורה,"
        },
        {
          "s": 19,
          "text": "ועד להוספה שבאין ערוך ובאופן של חידוש."
        },
        {
          "s": 20,
          "text": "דהגם שהענין דמתן תורה,"
        },
        {
          "s": 21,
          "text": "ובאופן של חידוש,"
        },
        {
          "s": 22,
          "text": "הוא במשך כל ימי השנה"
        },
        {
          "s": 23,
          "text": "(כנ\"ל ס\"ב),"
        },
        {
          "s": 24,
          "text": "הרי עיקר הענין דמתן תורה"
        },
        {
          "s": 25,
          "text": "(באופן חדש לגמרי)"
        },
        {
          "s": 26,
          "text": "הוא בחגה\"ש זמן מתן תורתנו."
        }
      ]
    }
  ]
}