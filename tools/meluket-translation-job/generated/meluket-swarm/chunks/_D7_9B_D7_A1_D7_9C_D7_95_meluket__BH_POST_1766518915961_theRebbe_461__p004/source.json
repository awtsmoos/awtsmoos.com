{
  "globalIndex": 388,
  "owner": 38,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915961_theRebbe_461__p004",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915961_theRebbe_461__p004",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915961_theRebbe_461",
  "title": "מאמר ביום השמיני תשמ\"ו",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "וכיון שלע\"ל יהי' מעשה גדול,"
        },
        {
          "s": 1,
          "text": "הרי מובן,"
        },
        {
          "s": 2,
          "text": "שכל הענינים דגאולה העתידה,"
        },
        {
          "s": 3,
          "text": "ומכ\"ש הגאולה עצמה,"
        },
        {
          "s": 4,
          "text": "צריכים להיות במעשה בפועל."
        },
        {
          "s": 5,
          "text": "וכל זמן שהגאולה לא ישנה עדיין בפועל,"
        },
        {
          "s": 6,
          "text": "חסר העיקר."
        },
        {
          "s": 7,
          "text": "וכסיפור הידוע35"
        },
        {
          "s": 8,
          "text": "דהצ\"צ ואדמו\"ר מהר\"ש,"
        },
        {
          "s": 9,
          "text": "שכשאמר הצ\"צ בנוגע להקץ שהי' על שנת תר\"ח שזה נתקיים ע\"י הלקו\"ת36,"
        },
        {
          "s": 10,
          "text": "ענה אדמו\"ר מהר\"ש \"מען דאַרף האָבן משיח'ן למטה מעשרה טפחים\"."
        },
        {
          "s": 11,
          "text": "ויש לומר,"
        },
        {
          "s": 12,
          "text": "דזה שאמר הצ\"צ שנדפס הלקו\"ת,"
        },
        {
          "s": 13,
          "text": "הוא,"
        },
        {
          "s": 14,
          "text": "כי ע\"י יפוצו מעינותיך חוצה נעשה אתי מר דא מלכא משיחא37,"
        },
        {
          "s": 15,
          "text": "וכיון שפנימיות התורה"
        },
        {
          "s": 16,
          "text": "(מעינותיך)"
        },
        {
          "s": 17,
          "text": "היא למעלה מהגבלת הזמן38,"
        },
        {
          "s": 18,
          "text": "הרי מובן,"
        },
        {
          "s": 19,
          "text": "דכשישנה הפצת המעיינות,"
        },
        {
          "s": 20,
          "text": "הסיבה לאתי מר,"
        },
        {
          "s": 21,
          "text": "ישנו מיד גם המסובב,"
        },
        {
          "s": 22,
          "text": "אתי מר."
        },
        {
          "s": 23,
          "text": "דבענינים שהם בגדר זמן,"
        },
        {
          "s": 24,
          "text": "הסיבה והמסובב הם באופן דקדימה ואיחור,"
        },
        {
          "s": 25,
          "text": "שהמסובב משתלשל מהסיבה."
        },
        {
          "s": 26,
          "text": "ובהמשכה זו"
        },
        {
          "s": 27,
          "text": "(שהמסובב נמשך ומשתלשל מהסיבה)"
        },
        {
          "s": 28,
          "text": "אפשר להיות כמה אופנים."
        },
        {
          "s": 29,
          "text": "שההמשכה תהי' באופן דעד מהרה ירוץ דברו39,"
        },
        {
          "s": 30,
          "text": "באופן דאחישנה40"
        },
        {
          "s": 31,
          "text": "ובאופן דבעתה40."
        },
        {
          "s": 32,
          "text": "אבל בענינים שלמעלה מגדר זמן,"
        },
        {
          "s": 33,
          "text": "אין שייך שיהי' הפסק בין הסיבה והמסובב,"
        },
        {
          "s": 34,
          "text": "וכשישנה הסיבה,"
        },
        {
          "s": 35,
          "text": "ישנו תומ\"י גם המסובב."
        },
        {
          "s": 36,
          "text": "אלא שענין זה הוא כמו שהסיבה"
        },
        {
          "s": 37,
          "text": "(הפצת המעיינות)"
        },
        {
          "s": 38,
          "text": "והמסובב"
        },
        {
          "s": 39,
          "text": "(ביאת המשיח)"
        },
        {
          "s": 40,
          "text": "הם למעלה מהזמן,"
        },
        {
          "s": 41,
          "text": "והשלימות דהפצת המעיינות וביאת המשיח הוא שיומשכו בזמן ומקום,"
        },
        {
          "s": 42,
          "text": "ובמעשה בפועל למטה מעשרה טפחים."
        },
        {
          "s": 43,
          "text": "ובפשטות,"
        },
        {
          "s": 44,
          "text": "שע\"י מעשינו ועבודתינו בהפצת המעיינות חוצה במעשה בפועל,"
        },
        {
          "s": 45,
          "text": "עי\"ז אתי מר דא מלכא משיחא במעשה בפועל."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "וכיון דזה שצריך לחכות לביאת המשיח"
        },
        {
          "s": 1,
          "text": "(נוסף על להאמין בביאת המשיח – לחכות לזה)"
        },
        {
          "s": 2,
          "text": "הוא הלכה41,"
        },
        {
          "s": 3,
          "text": "דענינה של הלכה הוא"
        },
        {
          "s": 4,
          "text": "(לכל לראש)"
        },
        {
          "s": 5,
          "text": "קיום הענין כמו שהוא בפשטות,"
        },
        {
          "s": 6,
          "text": "ובמעשה בפועל – לכן,"
        },
        {
          "s": 7,
          "text": "בהסכם כל הקהל \"ווי וואָנט משיח נאַו\"42,"
        },
        {
          "s": 8,
          "text": "במהרה בימינו ממש."
        }
      ]
    }
  ]
}