{
  "globalIndex": 214,
  "owner": 14,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915043_theRebbe_419__p003",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915043_theRebbe_419__p003",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518915043_theRebbe_419",
  "title": "מאמר ואברהם זקן תשל\"ח",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה זה מה שהתומ\"צ שבעוה\"ז הגשמי צריכים וזקוקים לסיוע המלאכים הוא לא רק מפני שעוה\"ז הגשמי הוא רובו ככולו רע,"
        },
        {
          "s": 2,
          "text": "אלא"
        },
        {
          "s": 3,
          "text": "(גם39)"
        },
        {
          "s": 4,
          "text": "מצד הגשמיות דעוה\"ז40."
        },
        {
          "s": 5,
          "text": "שלהיותו גשמי הוא באין ערוך לעולמות העליונים"
        },
        {
          "s": 6,
          "text": "(הרוחניים)."
        },
        {
          "s": 7,
          "text": "וע\"ד הידוע בנוגע לנשמת האדם,"
        },
        {
          "s": 8,
          "text": "שאפילו צדיק גמור כשעולה לג\"ע צריך טבילה בנהר דינור בכדי לשכוח על חיזו דהאי עלמא,"
        },
        {
          "s": 9,
          "text": "כי מצד האין ערוך דעוה\"ז הגשמי לג\"ע הרי אפילו מקצת מעניני עוה\"ז מונע מלעלות לג\"ע41"
        },
        {
          "s": 10,
          "text": "[ובדוגמת העליות שבדרגות דג\"ע שמגעה\"ת לגעה\"ע וכו',"
        },
        {
          "s": 11,
          "text": "שמכיון שהעליות הם באין ערוך,"
        },
        {
          "s": 12,
          "text": "צריך להיות תחילה ביטול ההשגה דגעה\"ת41."
        },
        {
          "s": 13,
          "text": "וכידוע המשל מענין השגת השכל,"
        },
        {
          "s": 14,
          "text": "שבכדי לבוא להשגה עליונה שבאין ערוך להשגה הקודמת"
        },
        {
          "s": 15,
          "text": "(אע\"פ שגם השגה העליונה היא בעוה\"ז הגשמי)"
        },
        {
          "s": 16,
          "text": "צריך להיות תחילה ביטול השגה הקודמת."
        },
        {
          "s": 17,
          "text": "וכמו ר\"ז כי סליק לארעא דישראל יתיב42"
        },
        {
          "s": 18,
          "text": "מאה תעניתא"
        },
        {
          "s": 19,
          "text": "(או מ' תעניות43)"
        },
        {
          "s": 20,
          "text": "לשכוח תלמוד בבלי בכדי שיוכל ללמוד תלמוד ירושלמי44],"
        },
        {
          "s": 21,
          "text": "עד\"ז הוא גם בנוגע להתומ\"צ של האדם,"
        },
        {
          "s": 22,
          "text": "שמצד היותן מלובשות בענינים גשמיים,"
        },
        {
          "s": 23,
          "text": "צ\"ל תחלה שיזדככו ויתפשטו מגשמיותן ע\"י המלאכים."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ויש לומר בדרך אפשר דהגם שהזדככות התומ\"צ והעלאתן למעלה נעשה ע\"י המלאכים,"
        },
        {
          "s": 2,
          "text": "מ\"מ,"
        },
        {
          "s": 3,
          "text": "מכיון שתכלית השלימות דכל ענין הוא כאשר הוא נעשה ע\"י עבודת האדם"
        },
        {
          "s": 4,
          "text": "(ולכן אדם רוצה בקב שלו דוקא45),"
        },
        {
          "s": 5,
          "text": "לכן גם ענין הזדככות התומ\"צ,"
        },
        {
          "s": 6,
          "text": "ההתחלה בזה הוא ע\"י עבודת האדם."
        },
        {
          "s": 7,
          "text": "וזהו מה שאיתא בתו\"א46"
        },
        {
          "s": 8,
          "text": "שכיבוס וזיכוך התומ\"צ הוא ע\"י עבודת התפלה,"
        },
        {
          "s": 9,
          "text": "שהכוונה בזה היא"
        },
        {
          "s": 10,
          "text": "(לא רק שע\"י התפלה הוא מנקה את התומ\"צ מכל פסולת,"
        },
        {
          "s": 11,
          "text": "שלא יהיו באופן דשלא לשמה וכיו\"ב,"
        },
        {
          "s": 12,
          "text": "כי אם),"
        },
        {
          "s": 13,
          "text": "שע\"י התפלה נעשה גם"
        },
        {
          "s": 14,
          "text": "(התחלת47"
        },
        {
          "s": 15,
          "text": "ה)"
        },
        {
          "s": 16,
          "text": "זיכוך שלהם,"
        },
        {
          "s": 17,
          "text": "מה שמזדככות מגשמיותן ועולות למעלה."
        },
        {
          "s": 18,
          "text": "דהנה תפלה היא סולם מוצב ארצה וראשו מגיע השמימה48,"
        },
        {
          "s": 19,
          "text": "היינו שהתפלה היא מקשרת את ב' הקצוות דארץ ושמים"
        },
        {
          "s": 20,
          "text": "(מטה ומעלה49),"
        },
        {
          "s": 21,
          "text": "ובפרט ע\"פ הידוע50"
        },
        {
          "s": 22,
          "text": "שארצה"
        },
        {
          "s": 23,
          "text": "(בתוס' ה')"
        },
        {
          "s": 24,
          "text": "הוא מדריגה היותר תחתונה שבארץ הלזו הגשמית גופא,"
        },
        {
          "s": 25,
          "text": "ושמימה"
        },
        {
          "s": 26,
          "text": "(בתוס' ה')"
        },
        {
          "s": 27,
          "text": "הוא מדריגה היותר נעלית שבשמים"
        },
        {
          "s": 28,
          "text": "(שמי השמים),"
        },
        {
          "s": 29,
          "text": "והשמימה"
        },
        {
          "s": 30,
          "text": "(בתוס' ה' גם בתחילה)"
        },
        {
          "s": 31,
          "text": "הוא למעלה גם משמימה."
        },
        {
          "s": 32,
          "text": "וזהו סולם מוצב ארצה וראשו מגיע השמימה,"
        },
        {
          "s": 33,
          "text": "שע\"י התפלה \"יוכל להיות עליית גם"
        },
        {
          "s": 34,
          "text": "(האדם)"
        },
        {
          "s": 35,
          "text": "הנמצא ארצה במדריגות היותר תחתונות שבארץ הלזו הגשמית להשמימה להמדרגות היותר נעלות ונפלאות\"51."
        },
        {
          "s": 36,
          "text": "הנה כמו שהתפלה פועלת בהאדם,"
        },
        {
          "s": 37,
          "text": "שגם כשהוא נמצא ארצה יכול הוא להתעלות להשמימה"
        },
        {
          "s": 38,
          "text": "(אלא שצ\"ל גם סיוע המלאכים דחביק לה כו'),"
        },
        {
          "s": 39,
          "text": "עד\"ז פועלת היא גם בכל עניני האדם52"
        },
        {
          "s": 40,
          "text": "ובפרט בהתומ\"צ53"
        },
        {
          "s": 41,
          "text": "שלו,"
        },
        {
          "s": 42,
          "text": "שע\"י ד' השליבות דתפלה"
        },
        {
          "s": 43,
          "text": "(שהם כנגד ד' עולמות)"
        },
        {
          "s": 44,
          "text": "עולות הן מעולם לעולם,"
        },
        {
          "s": 45,
          "text": "ועד שהן עולות בבחי' השמימה שלמעלה מהעולמות,"
        },
        {
          "s": 46,
          "text": "ועד שהן עולות למהותו ועצמותו ית' ממש."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וזהו אחד הביאורים בהשייכות דלבושי המצוות לענין הימים"
        },
        {
          "s": 2,
          "text": "(כפשוטם),"
        },
        {
          "s": 3,
          "text": "כי עליית המצוות הוא ע\"י התפלה,"
        },
        {
          "s": 4,
          "text": "והתפלה הרי היא \"ענין עבודת היום\""
        },
        {
          "s": 5,
          "text": "[כמובן גם ממרז\"ל54"
        },
        {
          "s": 6,
          "text": "תפלות כנגד תמידין תקנום,"
        },
        {
          "s": 7,
          "text": "עולת תמיד העשוי' בכל יום,"
        },
        {
          "s": 8,
          "text": "שנים ליום55],"
        },
        {
          "s": 9,
          "text": "שהתפלה בכל יום מבררת ומעלה את הניצוצות שנתחדשו ביום זה56,"
        },
        {
          "s": 10,
          "text": "לכן המצוות"
        },
        {
          "s": 11,
          "text": "[שעלייתן הוא ע\"י התפלה]"
        },
        {
          "s": 12,
          "text": "זקוקים ל\"עבודת היום\"57."
        }
      ]
    }
  ]
}