{
  "globalIndex": 987,
  "owner": 37,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919633_theRebbe_834__p003",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919633_theRebbe_834__p003",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919633_theRebbe_834",
  "title": "מאמר בלע המוות לנצח תשכ\"ה",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה ידוע שכל הגילויים דלע\"ל תלויים במעשינו ועבודתינו עכשיו24."
        },
        {
          "s": 2,
          "text": "דמזה מובן,"
        },
        {
          "s": 3,
          "text": "דזה שלע\"ל יהי' גילוי זה שאינו נותן מקום ליניקת החיצונים"
        },
        {
          "s": 4,
          "text": "(בלע המות לנצח)"
        },
        {
          "s": 5,
          "text": "הוא,"
        },
        {
          "s": 6,
          "text": "כמבואר בהמאמר22,"
        },
        {
          "s": 7,
          "text": "דע\"י שישראל שונאים את הרע בתכלית השנאה,"
        },
        {
          "s": 8,
          "text": "עי\"ז נעשה למעלה ואת עשו שנאתי25"
        },
        {
          "s": 9,
          "text": "בתכלית השנאה,"
        },
        {
          "s": 10,
          "text": "ומצד שנאה זו יהי' ואת רוח הטומאה אעביר מן הארץ,"
        },
        {
          "s": 11,
          "text": "בלע המות לנצח."
        },
        {
          "s": 12,
          "text": "והנה מכיון דראה הקב\"ה בצדיקים שהם מועטים26"
        },
        {
          "s": 13,
          "text": "(ובפרט ששנאת הרע בתכלית היא דרגת צדיק גמור),"
        },
        {
          "s": 14,
          "text": "ואפילו בנוגע לדרגת הבינוני ידוע הפתגם27"
        },
        {
          "s": 15,
          "text": "הלואי בינוני,"
        },
        {
          "s": 16,
          "text": "והענין דבלע המות לנצח יהי' בכל ישראל,"
        },
        {
          "s": 17,
          "text": "מובן מזה,"
        },
        {
          "s": 18,
          "text": "שעבודה זו"
        },
        {
          "s": 19,
          "text": "(לשנוא את הרע בתכלית השנאה)"
        },
        {
          "s": 20,
          "text": "יכולה להיות גם בבינונים,"
        },
        {
          "s": 21,
          "text": "ואפילו באלה שלמטה מדרגת בינוני."
        },
        {
          "s": 22,
          "text": "דבכאו\"א מישראל ישנם זמנים מיוחדים – בשעת התפלה,"
        },
        {
          "s": 23,
          "text": "או בשעת עסק התורה,"
        },
        {
          "s": 24,
          "text": "או בשעה שהוא מקיים מצוה דהוה זהיר בה טפי28,"
        },
        {
          "s": 25,
          "text": "או אפילו בשעה שעוסק בדברי הרשות לשם שמים29"
        },
        {
          "s": 26,
          "text": "ועאכו\"כ30"
        },
        {
          "s": 27,
          "text": "באופן דבכל דרכיך דעהו31"
        },
        {
          "s": 28,
          "text": "– שבשעה זו הוא מוסר את כל מציאותו"
        },
        {
          "s": 29,
          "text": "(ער גיט זיך איבער אינגאַנצן)"
        },
        {
          "s": 30,
          "text": "לאלקות,"
        },
        {
          "s": 31,
          "text": "ועי\"ז אינו שייך לבגדים הצואים32,"
        },
        {
          "s": 32,
          "text": "כמו צדיק גמור."
        },
        {
          "s": 33,
          "text": "ומכיון שיחוד זה למעלה הוא נצחי לעולם ועד33,"
        },
        {
          "s": 34,
          "text": "לכן נמשך עי\"ז הגילוי שאינו נותן מקום כלל ליניקת החיצונים,"
        },
        {
          "s": 35,
          "text": "בלע המות לנצח."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "וזהו בלע המות לנצח,"
        },
        {
          "s": 2,
          "text": "דכל זמן שלא נשלמו עדיין הבירורים והטוב והרע מעורבים זב\"ז"
        },
        {
          "s": 3,
          "text": "(כולל גם בזמן שביהמ\"ק הי' קיים,"
        },
        {
          "s": 4,
          "text": "ואפילו בימי שלמה דקיימא סיהרא באשלמותא)"
        },
        {
          "s": 5,
          "text": "יש ענין המיתה,"
        },
        {
          "s": 6,
          "text": "בכדי שלא יהי' קיום להרע,"
        },
        {
          "s": 7,
          "text": "כנ\"ל."
        },
        {
          "s": 8,
          "text": "וזהו גם הטעם שגם צדיקים יחזרו לעפרן שעה אחת קודם תחיית המתים34"
        },
        {
          "s": 9,
          "text": "[דהגם שאין רימה שולטת בהם35"
        },
        {
          "s": 10,
          "text": "ועד לשעה זו"
        },
        {
          "s": 11,
          "text": "(שקודם תחה\"מ)"
        },
        {
          "s": 12,
          "text": "הי' גופן קיים מאות ואלפים שנים,"
        },
        {
          "s": 13,
          "text": "ומ\"מ,"
        },
        {
          "s": 14,
          "text": "קודם תחה\"מ יחזרו לעפרן],"
        },
        {
          "s": 15,
          "text": "כי מכיון שע\"י חטא עה\"ד נעשה תערובות רע בכל העולם,"
        },
        {
          "s": 16,
          "text": "לכן,"
        },
        {
          "s": 17,
          "text": "גם גופות הצדיקים יצטרכו לזיכוך36."
        },
        {
          "s": 18,
          "text": "משא\"כ לע\"ל"
        },
        {
          "s": 19,
          "text": "(לאחרי התחי'),"
        },
        {
          "s": 20,
          "text": "כשיהי' ואת רוח הטומאה אעביר מן הארץ,"
        },
        {
          "s": 21,
          "text": "לא תהי' אז מיתה וגם הגוף יחי' בחיים נצחיים."
        },
        {
          "s": 22,
          "text": "דגם להדיעה37"
        },
        {
          "s": 23,
          "text": "דמ\"ש38"
        },
        {
          "s": 24,
          "text": "כי הנער בן מאה שנה ימות הוא כפשוטו,"
        },
        {
          "s": 25,
          "text": "הוא רק בנוגע לב\"נ,"
        },
        {
          "s": 26,
          "text": "משא\"כ בנוגע לישראל יהי' בלע המות לנצח."
        },
        {
          "s": 27,
          "text": "ויתירה מזו,"
        },
        {
          "s": 28,
          "text": "דגם המיתה שתהי'"
        },
        {
          "s": 29,
          "text": "(לדיעה זו)"
        },
        {
          "s": 30,
          "text": "בב\"נ היא לא מיתה ממש,"
        },
        {
          "s": 31,
          "text": "אלא נפילה,"
        },
        {
          "s": 32,
          "text": "דמאן דנפיל מדרגי' אקרי מית39."
        },
        {
          "s": 33,
          "text": "וכמבואר בהמאמר40,"
        },
        {
          "s": 34,
          "text": "דע\"י שניצוצות הקדושה שנבלעו בהם יתבררו מהם ויעלו למעלה,"
        },
        {
          "s": 35,
          "text": "הרע שבהם"
        },
        {
          "s": 36,
          "text": "(היינו גוף הגשמי שלהם שנקרא בשם רע בערך לניצוצות הקדושה שבו)"
        },
        {
          "s": 37,
          "text": "יפול למטה."
        },
        {
          "s": 38,
          "text": "דזהו באוה\"ע,"
        },
        {
          "s": 39,
          "text": "משא\"כ בישראל יתעלה גם הגוף,"
        },
        {
          "s": 40,
          "text": "שגם הגוף יזון מרוחניות כמו הנשמה,"
        },
        {
          "s": 41,
          "text": "ולא עוד אלא שאז יהי' הגוף למעלה מהנשמה,"
        },
        {
          "s": 42,
          "text": "נקבה תסובב גבר41."
        },
        {
          "s": 43,
          "text": "וכל זה יהי' בפועל ובגילוי למטה מעשרה טפחים,"
        },
        {
          "s": 44,
          "text": "בגאולה האמיתית והשלימה ע\"י משיח צדקנו,"
        },
        {
          "s": 45,
          "text": "בקרוב ממש."
        }
      ]
    }
  ]
}