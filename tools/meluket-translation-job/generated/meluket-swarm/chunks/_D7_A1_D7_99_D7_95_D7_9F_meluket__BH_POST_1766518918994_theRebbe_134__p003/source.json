{
  "globalIndex": 884,
  "owner": 34,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918994_theRebbe_134__p003",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918994_theRebbe_134__p003",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918994_theRebbe_134",
  "title": "מאמר בשעה שעלה משה למרום תשכ\"א",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה הכח לתקן ולהעלות גם גוף הגשמי בו\"ד אינו בכח המלאכים כי אם בכח הנשמות דוקא."
        },
        {
          "s": 2,
          "text": "והענין הוא34,"
        },
        {
          "s": 3,
          "text": "דהנה,"
        },
        {
          "s": 4,
          "text": "כללות הבריאה נחלקת לד' סוגים דומם צומח חי מדבר,"
        },
        {
          "s": 5,
          "text": "שבהם נכללים גם המלאכים ונשמות."
        },
        {
          "s": 6,
          "text": "וד' סוגים אלו הם כנגד ד' אותיות שם הוי'35."
        },
        {
          "s": 7,
          "text": "והגם שלפעמים מבואר36"
        },
        {
          "s": 8,
          "text": "ההפרש בין מלאכים ונשמות,"
        },
        {
          "s": 9,
          "text": "שמלאכים שרשם משם אלקים,"
        },
        {
          "s": 10,
          "text": "כמ\"ש37"
        },
        {
          "s": 11,
          "text": "הודו לאלקי האלקים,"
        },
        {
          "s": 12,
          "text": "ונשמות שרשם משם הוי',"
        },
        {
          "s": 13,
          "text": "כמ\"ש38"
        },
        {
          "s": 14,
          "text": "כי חלק הוי' עמו,"
        },
        {
          "s": 15,
          "text": "מ\"מ,"
        },
        {
          "s": 16,
          "text": "בכללות יותר,"
        },
        {
          "s": 17,
          "text": "גם המלאכים שרשם משם הוי',"
        },
        {
          "s": 18,
          "text": "דהוי' לשון מהוה39,"
        },
        {
          "s": 19,
          "text": "והוא מהוה את כללות כל ההויות."
        },
        {
          "s": 20,
          "text": "ולכן הד' סוגים שבהבריאה נכללים בשם הוי',"
        },
        {
          "s": 21,
          "text": "שיש בו ד' אותיות,"
        },
        {
          "s": 22,
          "text": "שכנגדם הם ד' הסוגים."
        },
        {
          "s": 23,
          "text": "ה\"א אחרונה,"
        },
        {
          "s": 24,
          "text": "בחי' המלכות,"
        },
        {
          "s": 25,
          "text": "הו\"ע סוג הדומם."
        },
        {
          "s": 26,
          "text": "וא\"ו,"
        },
        {
          "s": 27,
          "text": "בחי' המדות,"
        },
        {
          "s": 28,
          "text": "הו\"ע סוג הצומח,"
        },
        {
          "s": 29,
          "text": "שהרי המדות צומחים מקטנות לגדלות."
        },
        {
          "s": 30,
          "text": "ה\"א ראשונה,"
        },
        {
          "s": 31,
          "text": "בחי' הבינה,"
        },
        {
          "s": 32,
          "text": "הו\"ע סוג החי,"
        },
        {
          "s": 33,
          "text": "כמ\"ש בחוה40"
        },
        {
          "s": 34,
          "text": "היא היתה אם כל חי,"
        },
        {
          "s": 35,
          "text": "דקאי על ספירת הבינה,"
        },
        {
          "s": 36,
          "text": "ולמעלה יותר קאי גם על בחינת חיצוניות החכמה,"
        },
        {
          "s": 37,
          "text": "שגם חיצוניות החכמה נכללת בסוג החי,"
        },
        {
          "s": 38,
          "text": "כמ\"ש41"
        },
        {
          "s": 39,
          "text": "והחכמה תחי'"
        },
        {
          "s": 40,
          "text": "(והיינו,"
        },
        {
          "s": 41,
          "text": "שבחכמה יש ב' מדריגות,"
        },
        {
          "s": 42,
          "text": "יו\"ד וקוצו של יו\"ד,"
        },
        {
          "s": 43,
          "text": "ומשנ\"ת שגם חכמה היא בסוג החי,"
        },
        {
          "s": 44,
          "text": "כמ\"ש והחכמה תחי',"
        },
        {
          "s": 45,
          "text": "היינו בחינת חיצוניות החכמה)."
        },
        {
          "s": 46,
          "text": "וגם המלאכים נקראים בשם צומח וחי,"
        },
        {
          "s": 47,
          "text": "וכמ\"ש42"
        },
        {
          "s": 48,
          "text": "אז ירננו כל עצי יער,"
        },
        {
          "s": 49,
          "text": "וכן נקראים בשם בהמות חיות ועופות43,"
        },
        {
          "s": 50,
          "text": "וכמ\"ש44"
        },
        {
          "s": 51,
          "text": "פני ארי' גו' ופני שור מהשמאל גו' ופני נשר גו'."
        },
        {
          "s": 52,
          "text": "ואות יו\"ד וקוצו של יו\"ד,"
        },
        {
          "s": 53,
          "text": "בחינת פנימיות החכמה,"
        },
        {
          "s": 54,
          "text": "קאי על נפש השכלית,"
        },
        {
          "s": 55,
          "text": "נפש המדברת."
        },
        {
          "s": 56,
          "text": "והנה,"
        },
        {
          "s": 57,
          "text": "האותיות וא\"ו וה\"א ראשונה יש להם חיבור זה עם זה,"
        },
        {
          "s": 58,
          "text": "וכמו בצומח וחי שהם בקירוב זה לזה,"
        },
        {
          "s": 59,
          "text": "שהחי יש בו ענין הצמיחה."
        },
        {
          "s": 60,
          "text": "וכן הוא גם בענין המדות והשכל שהם בקירוב זה לזה."
        },
        {
          "s": 61,
          "text": "משא\"כ ה\"א אחרונה,"
        },
        {
          "s": 62,
          "text": "בחי' המלכות,"
        },
        {
          "s": 63,
          "text": "אין לה קירוב עם הוא\"ו וה\"א ראשונה,"
        },
        {
          "s": 64,
          "text": "והתהוותה הוא מהחכמה,"
        },
        {
          "s": 65,
          "text": "פנימיות החכמה,"
        },
        {
          "s": 66,
          "text": "כמאמר45"
        },
        {
          "s": 67,
          "text": "אבא יסד ברתא,"
        },
        {
          "s": 68,
          "text": "אלא שהתהוות זו הוא בדרך ריחוק."
        },
        {
          "s": 69,
          "text": "וכמו שהתהוות החכמה עצמה היא בדרך ריחוק,"
        },
        {
          "s": 70,
          "text": "וכמ\"ש46"
        },
        {
          "s": 71,
          "text": "והחכמה מאין תמצא,"
        },
        {
          "s": 72,
          "text": "כידוע שהתהוות החכמה מלמעלה מהחכמה אינו דומה להתהוות הספירות שלמטה מהחכמה,"
        },
        {
          "s": 73,
          "text": "כמו התהוות בינה מהחכמה,"
        },
        {
          "s": 74,
          "text": "וכן מדות מהבינה,"
        },
        {
          "s": 75,
          "text": "וכן פנימיות המלכות מהמדות,"
        },
        {
          "s": 76,
          "text": "שהתהוותם היא בדרך עילה ועלול,"
        },
        {
          "s": 77,
          "text": "משא\"כ התהוות החכמה מלמעלה מהחכמה היא בדרך יש מאין,"
        },
        {
          "s": 78,
          "text": "והיינו שפנימיות החכמה שייכת להאין שממנה היא נמצאת"
        },
        {
          "s": 79,
          "text": "(דמ\"ש והחכמה תחי' הוא בבחינת חיצוניות החכמה,"
        },
        {
          "s": 80,
          "text": "ומ\"ש והחכמה מאין תמצא הוא בבחינת פנימיות החכמה,"
        },
        {
          "s": 81,
          "text": "מ\"ה שבחכמה),"
        },
        {
          "s": 82,
          "text": "וכמ\"ש בתניא47"
        },
        {
          "s": 83,
          "text": "שמדריגת החכמה הוא ההרגש שהוא לבדו הוא ואין זולתו,"
        },
        {
          "s": 84,
          "text": "וכמו\"כ הוא גם בענין אבא יסד ברתא45,"
        },
        {
          "s": 85,
          "text": "שהתהוות המלכות"
        },
        {
          "s": 86,
          "text": "(חיצוניות המלכות,"
        },
        {
          "s": 87,
          "text": "דיבור דמלכות)"
        },
        {
          "s": 88,
          "text": "מפנימיות החכמה היא בדרך ריחוק."
        },
        {
          "s": 89,
          "text": "והענין הוא,"
        },
        {
          "s": 90,
          "text": "דחיצוניות המלכות הוא בחינת האותיות,"
        },
        {
          "s": 91,
          "text": "והתהוות האותיות אינה מהמדות ומהשכל בדרך עילה ועלול,"
        },
        {
          "s": 92,
          "text": "וכידוע הראיות על זה,"
        },
        {
          "s": 93,
          "text": "דאם נאמר שהתהוות האותיות היא מהמדות או מהשכל,"
        },
        {
          "s": 94,
          "text": "הי' צריך ששכל של חסד ושכל של דין יהיו באותיות שונות,"
        },
        {
          "s": 95,
          "text": "ובפועל אנו רואים שבאותם האותיות עצמם מתלבש הן שכל של חסד והן שכל של דין,"
        },
        {
          "s": 96,
          "text": "ורק צירוף האותיות מתחלף אבל האותיות עצמם הם בשניהם בשוה."
        },
        {
          "s": 97,
          "text": "ויתרה מזה,"
        },
        {
          "s": 98,
          "text": "דאיתא בזהר48"
        },
        {
          "s": 99,
          "text": "ובמק\"מ שישנם אותיות של חסד ואותיות של דין,"
        },
        {
          "s": 100,
          "text": "וא\"כ,"
        },
        {
          "s": 101,
          "text": "בודאי הי' צריך להיות ששכל של חסד יתלבש באותיות של חסד דוקא,"
        },
        {
          "s": 102,
          "text": "וכן להיפך,"
        },
        {
          "s": 103,
          "text": "והרי אנו רואים שאינו כן."
        },
        {
          "s": 104,
          "text": "ומזה מוכח שהתהוות האותיות אינו מהשכל ומכ\"ש שאינו מהמדות,"
        },
        {
          "s": 105,
          "text": "אלא יש להם שורש לעצמם,"
        },
        {
          "s": 106,
          "text": "ומצד עצם שרשם ישנם אותיות של חסד ואותיות של דין,"
        },
        {
          "s": 107,
          "text": "והשורש שלהם הוא בקדמות השכל49"
        },
        {
          "s": 108,
          "text": "(שלמעלה מהשכל),"
        },
        {
          "s": 109,
          "text": "וכידוע בענין אבא יסד ברתא,"
        },
        {
          "s": 110,
          "text": "שהמשכת האותיות"
        },
        {
          "s": 111,
          "text": "(ברתא)"
        },
        {
          "s": 112,
          "text": "מהחכמה"
        },
        {
          "s": 113,
          "text": "(אבא)"
        },
        {
          "s": 114,
          "text": "היא מבחינת קדמות השכל."
        },
        {
          "s": 115,
          "text": "והתהוות האותיות מקדמות השכל הוא בדרך ריחוק50."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ועד\"ז הוא גם ההפרש בין צומח וחי למדבר,"
        },
        {
          "s": 1,
          "text": "שבצומח וחי הנה גופם ונפשם הם בערך זה לזה ונתהוו"
        },
        {
          "s": 2,
          "text": "(הגוף והנפש)"
        },
        {
          "s": 3,
          "text": "יחד,"
        },
        {
          "s": 4,
          "text": "וכמ\"ש תדשא הארץ גו'51"
        },
        {
          "s": 5,
          "text": "תוצא הארץ גו'52,"
        },
        {
          "s": 6,
          "text": "וגם בנבראים דעלמא דאתכסיא כתיב ישרצו המים גו'53,"
        },
        {
          "s": 7,
          "text": "שנבראו כולם כמו שהם עתה,"
        },
        {
          "s": 8,
          "text": "וכמרז\"ל54"
        },
        {
          "s": 9,
          "text": "בקומתן נבראו ובצביונן נבראו."
        },
        {
          "s": 10,
          "text": "וכן הוא במלאכים שגופם ונפשם נתהוו כאחד."
        },
        {
          "s": 11,
          "text": "משא\"כ בבריאת האדם שנעשה גופו תחילה בפ\"ע בלי שום נפש חיונית בתוכו,"
        },
        {
          "s": 12,
          "text": "וכמ\"ש55"
        },
        {
          "s": 13,
          "text": "וייצר ה' אלקים את האדם עפר מן האדמה,"
        },
        {
          "s": 14,
          "text": "וכמרז\"ל56"
        },
        {
          "s": 15,
          "text": "שעה ראשונה הוצבר עפרו שני' נעשה גולם"
        },
        {
          "s": 16,
          "text": "(כמ\"ש57"
        },
        {
          "s": 17,
          "text": "גלמי ראו עיניך),"
        },
        {
          "s": 18,
          "text": "ורק אח\"כ ויפח באפיו נשמת חיים55."
        },
        {
          "s": 19,
          "text": "דלכאורה הרי זה פחיתות שבמשך זמן הי' גוף האדם גולם,"
        },
        {
          "s": 20,
          "text": "אך באמת,"
        },
        {
          "s": 21,
          "text": "הנה מזה גופא רואים את המעלה שבסוג המדבר,"
        },
        {
          "s": 22,
          "text": "שנשמת האדם שהיא למעלה מנפש המלאכים,"
        },
        {
          "s": 23,
          "text": "מתלבשת דוקא בגוף האדם,"
        },
        {
          "s": 24,
          "text": "שהוא גוף היותר תחתון,"
        },
        {
          "s": 25,
          "text": "וע\"ד שהתהוות האותיות הוא מפנימיות החכמה דוקא,"
        },
        {
          "s": 26,
          "text": "דנעוץ תחילתן בסופן וסופן בתחילתן58."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וביאור מעלת נשמת אדם על נשמת המלאכים,"
        },
        {
          "s": 2,
          "text": "הנה נתבאר לעיל דמלאכים שרשם משם אלקים,"
        },
        {
          "s": 3,
          "text": "ונשמות שרשם משם הוי'."
        },
        {
          "s": 4,
          "text": "ומזה יובן בתוספת ביאור הטעם ששירת המלאכים נשמעת באזני הנביא ולא שירת הנשמות,"
        },
        {
          "s": 5,
          "text": "לפי שהמלאכים שרשם משם אלקים36,"
        },
        {
          "s": 6,
          "text": "בחינת הכלים,"
        },
        {
          "s": 7,
          "text": "והכלים הם במדידה והגבלה,"
        },
        {
          "s": 8,
          "text": "משא\"כ הנשמות ששרשם משם הוי'36,"
        },
        {
          "s": 9,
          "text": "בחינת האורות,"
        },
        {
          "s": 10,
          "text": "והאורות אינם במדידה והגבלה,"
        },
        {
          "s": 11,
          "text": "עד שלפעמים מבואר59"
        },
        {
          "s": 12,
          "text": "שהאורות הם פשוטים."
        },
        {
          "s": 13,
          "text": "וגם לפי המבואר במק\"א60"
        },
        {
          "s": 14,
          "text": "שגם הנשמות שרשם מהכלים,"
        },
        {
          "s": 15,
          "text": "הרי ידוע ששורש הנשמות הוא מפנימיות הכלים61."
        },
        {
          "s": 16,
          "text": "וההפרש בין פנימיות הכלים לחיצוניות הכלים הוא כמו שאנו רואים גם בכלים למטה,"
        },
        {
          "s": 17,
          "text": "שפנימיות הכלי מיוחדת עם המשקה שבתוכה,"
        },
        {
          "s": 18,
          "text": "משא\"כ חיצוניות הכלי,"
        },
        {
          "s": 19,
          "text": "הרי דופן הפנימי של הכלי מפסיק בין המשקה לחיצוניות הכלי."
        },
        {
          "s": 20,
          "text": "וגם כללות ענין חיצוניות הכלי הוא בכדי להביא את המשקה למקום שרוצה,"
        },
        {
          "s": 21,
          "text": "היינו שענינו הוא בשביל הזולת,"
        },
        {
          "s": 22,
          "text": "היינו בשביל הגילוי."
        },
        {
          "s": 23,
          "text": "וזהו בענין הכלים שמחוץ להאדם."
        },
        {
          "s": 24,
          "text": "וכמו\"כ בהכלים שבאדם עצמו שהם האברים,"
        },
        {
          "s": 25,
          "text": "הרי אינו דומה חיצוניות הכלי לפנימיות הכלי,"
        },
        {
          "s": 26,
          "text": "ועד\"מ בכלי המוח,"
        },
        {
          "s": 27,
          "text": "שחיצוניות המוח ענינו להשפיע לזולתו,"
        },
        {
          "s": 28,
          "text": "הנה מלבד זה שכללות ענין ההשפעה הוא רק חיצוניות,"
        },
        {
          "s": 29,
          "text": "דתוונא דלבא לא כתבי אינשי62,"
        },
        {
          "s": 30,
          "text": "ולא קאי אדעתא דרבי'63,"
        },
        {
          "s": 31,
          "text": "הנה גם החיצוניות עצמו,"
        },
        {
          "s": 32,
          "text": "הרי כאשר השומע לא יהי' בר שכל לא תועיל לו ההשפעה מאומה,"
        },
        {
          "s": 33,
          "text": "וכמאמר אַ קאָפּ קען מען ניט אַרוף שטעלן64,"
        },
        {
          "s": 34,
          "text": "ורק כאשר הוא בעל שכל בעצמו אזי יקבל את ההשפעה מרבו."
        },
        {
          "s": 35,
          "text": "וטעם הדבר הוא,"
        },
        {
          "s": 36,
          "text": "לפי שכללות ענין ההשפעה שמחיצוניות הכלי הוא חיצוניות בלבד,"
        },
        {
          "s": 37,
          "text": "היינו הארה בלבד,"
        },
        {
          "s": 38,
          "text": "ולא באופן שנותן לו את העצם."
        },
        {
          "s": 39,
          "text": "משא\"כ בענין השפעת הטיפה שהיא מפנימיות המוח,"
        },
        {
          "s": 40,
          "text": "הרי עי\"ז מוליד בדומה לו,"
        },
        {
          "s": 41,
          "text": "לפי שהיא השפעה עצמית."
        },
        {
          "s": 42,
          "text": "והיינו לפי שפנימיות המוח מיוחד עם פנימיות האור."
        },
        {
          "s": 43,
          "text": "וטעם הדבר שכן הוא למטה,"
        },
        {
          "s": 44,
          "text": "הרי זה לפי שכן הוא גם למעלה,"
        },
        {
          "s": 45,
          "text": "דחיצוניות הכלים הוא הארה בלבד,"
        },
        {
          "s": 46,
          "text": "ופנימיות הכלים מיוחד עם פנימיות האור,"
        },
        {
          "s": 47,
          "text": "עד עם בחינת עצם האור,"
        },
        {
          "s": 48,
          "text": "שהוא אין סוף."
        },
        {
          "s": 49,
          "text": "ומזה מובן מעלת הנשמות על המלאכים,"
        },
        {
          "s": 50,
          "text": "שהנשמות ששרשם מפנימיות הכלים שמיוחדים עם עצם האור,"
        },
        {
          "s": 51,
          "text": "אין בהם שום הגבלות כלל."
        },
        {
          "s": 52,
          "text": "דהנה,"
        },
        {
          "s": 53,
          "text": "מלאך מוגבל במקום,"
        },
        {
          "s": 54,
          "text": "כמאמר מלאך בשליש עולם עומד65,"
        },
        {
          "s": 55,
          "text": "וכמו\"כ הוא מוגבל בזמן,"
        },
        {
          "s": 56,
          "text": "שהרי זמן ומקום שייכים זה לזה66."
        },
        {
          "s": 57,
          "text": "משא\"כ נשמות אינם מוגבלים לא במקום ולא בזמן,"
        },
        {
          "s": 58,
          "text": "שזהו מה שאומרים67"
        },
        {
          "s": 59,
          "text": "וקדושים בכל יום יהללוך סלה,"
        },
        {
          "s": 60,
          "text": "ואילו לפנ\"ז,"
        },
        {
          "s": 61,
          "text": "באמירת קדוש ברוך ימלוך68,"
        },
        {
          "s": 62,
          "text": "לא נאמר סלה,"
        },
        {
          "s": 63,
          "text": "והיינו לפי שקדוש ברוך ימלוך קאי על שירת השרפים חיות ואופנים,"
        },
        {
          "s": 64,
          "text": "שהשיר שלהם הוא בהגבלה,"
        },
        {
          "s": 65,
          "text": "שישנו הפסק בהשירה שלהם,"
        },
        {
          "s": 66,
          "text": "משא\"כ וקדושים בכל יום יהללוך סלה קאי על שירת הנשמות,"
        },
        {
          "s": 67,
          "text": "שהשירה שלהם היא בכל יום,"
        },
        {
          "s": 68,
          "text": "ויתרה מזה,"
        },
        {
          "s": 69,
          "text": "שהשירה היא סלה,"
        },
        {
          "s": 70,
          "text": "דכל מקום שנאמר נצח סלה ועד אין לו הפסק69."
        }
      ]
    }
  ]
}