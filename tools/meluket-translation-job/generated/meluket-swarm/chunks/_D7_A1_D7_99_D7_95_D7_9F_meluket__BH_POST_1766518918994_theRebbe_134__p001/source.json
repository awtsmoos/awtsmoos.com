{
  "globalIndex": 882,
  "owner": 32,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918994_theRebbe_134__p001",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918994_theRebbe_134__p001",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918994_theRebbe_134",
  "title": "מאמר בשעה שעלה משה למרום תשכ\"א",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ליל א' דחג השבועות,"
        },
        {
          "s": 2,
          "text": "לפנות-בוקר,"
        },
        {
          "s": 3,
          "text": "ה'תשכ\"א*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "(הנחה)"
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "בשעה שעלה משה למרום אמרו מלאכי השרת לפני הקב\"ה כו' מה לילוד אשה בינינו אמר להן לקבל תורה בא"
        },
        {
          "s": 1,
          "text": "(עבור כל ישראל,"
        },
        {
          "s": 2,
          "text": "וכמאמר1"
        },
        {
          "s": 3,
          "text": "משה קבל תורה מסיני ומסרה ליהושע ויהושע לזקנים וזקנים לנביאים ונביאים מסרוה לאנשי כנסת הגדולה,"
        },
        {
          "s": 4,
          "text": "ומהם לכל ישראל עד סוף כל הדורות),"
        },
        {
          "s": 5,
          "text": "אמרו לפניו"
        },
        {
          "s": 6,
          "text": "(המלאכים)"
        },
        {
          "s": 7,
          "text": "חמדה גנוזה שגנוזה לך כו' קודם שנברא העולם אתה מבקש ליתנה לבשר ודם,"
        },
        {
          "s": 8,
          "text": "מה2"
        },
        {
          "s": 9,
          "text": "אנוש כי תזכרנו גו' תנה הודך על השמים."
        },
        {
          "s": 10,
          "text": "אמר לו הקב\"ה למשה החזיר להן תשובה כו',"
        },
        {
          "s": 11,
          "text": "והתשובה שהשיב להם מרע\"ה היתה כלום למצרים ירדתם כו' כלום יצה\"ר יש ביניכם וכו'3."
        },
        {
          "s": 12,
          "text": "ובמדרש תהלים עה\"כ4"
        },
        {
          "s": 13,
          "text": "איתא בשלשה מקומות היו המלאכים מדיינין כנגד הקדוש ברוך הוא,"
        },
        {
          "s": 14,
          "text": "בבריאת האדם,"
        },
        {
          "s": 15,
          "text": "במתן תורה ובמשכן."
        },
        {
          "s": 16,
          "text": "כשביקש הקדוש ברוך הוא לברוא את האדם אמרו מה אנוש כי תזכרנו,"
        },
        {
          "s": 17,
          "text": "והראה להם הקדוש ברוך הוא שחכמתו גדולה משלכם,"
        },
        {
          "s": 18,
          "text": "כשבא הקדוש ברוך הוא ליתן תורה לישראל אמרו מה אנוש כי תזכרנו כו' תנה הודך על השמים,"
        },
        {
          "s": 19,
          "text": "וכן טענו גם כשהי' הציווי ועשו לי מקדש ושכנתי בתוכם5."
        },
        {
          "s": 20,
          "text": "והיינו,"
        },
        {
          "s": 21,
          "text": "שמאמר הגמרא שטענת המלאכים היתה במתן תורה,"
        },
        {
          "s": 22,
          "text": "מבואר במדרש בפרטיות יותר,"
        },
        {
          "s": 23,
          "text": "שבשלשה מקומות היו המלאכים מדיינין."
        },
        {
          "s": 24,
          "text": "ובהקדם,"
        },
        {
          "s": 25,
          "text": "דהנה כתיב6"
        },
        {
          "s": 26,
          "text": "עשרה עשרה הכף בשקל הקודש,"
        },
        {
          "s": 27,
          "text": "שעשרה מאמרות הם מכוונים כנגד עשרת הדברות7,"
        },
        {
          "s": 28,
          "text": "היינו שעשרת הדברות נותנים קיום בהעשרה מאמרות,"
        },
        {
          "s": 29,
          "text": "שע\"י התורה נשלם כוונת ותכלית בריאת העולם,"
        },
        {
          "s": 30,
          "text": "שתכלית בריאת העולם הוא לעשות מהעולם משכן ומקדש לו יתברך,"
        },
        {
          "s": 31,
          "text": "וכוונה זו נשלמת ע\"י התורה."
        },
        {
          "s": 32,
          "text": "וזהו שטענת המלאכים היתה בשלשה מקומות,"
        },
        {
          "s": 33,
          "text": "בעת הבריאה,"
        },
        {
          "s": 34,
          "text": "במשכן"
        },
        {
          "s": 35,
          "text": "(תכלית הכוונה דבריאת העולם8),"
        },
        {
          "s": 36,
          "text": "ובמתן תורה"
        },
        {
          "s": 37,
          "text": "(שע\"י התורה נשלמת כוונה זו8)."
        }
      ]
    }
  ]
}