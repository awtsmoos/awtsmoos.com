{
  "globalIndex": 655,
  "owner": 5,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917627_theRebbe_329__p003",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917627_theRebbe_329__p003",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917627_theRebbe_329",
  "title": "מאמר החודש הזה לכם תשל\"ה",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ויובן זה ע\"פ מה דאיתא במדרש33"
        },
        {
          "s": 2,
          "text": "משל למלך כו' לא זז מחבבה34"
        },
        {
          "s": 3,
          "text": "עד שקראה בתי כו' לא זז מחבבה עד שקראה אחותי כו' לא זז מחבבה עד שקראה אמי,"
        },
        {
          "s": 4,
          "text": "ומבואר בהדרושים35,"
        },
        {
          "s": 5,
          "text": "דג' ענינים אלה"
        },
        {
          "s": 6,
          "text": "(בתי אחותי אמי)"
        },
        {
          "s": 7,
          "text": "הם כנגד ג' רגלים."
        },
        {
          "s": 8,
          "text": "דביציאת מצרים"
        },
        {
          "s": 9,
          "text": "(פסח)"
        },
        {
          "s": 10,
          "text": "שאז היו ישראל במצב דערום וערי'36"
        },
        {
          "s": 11,
          "text": "והגאולה היתה ע\"י הגילוי מלמעלה,"
        },
        {
          "s": 12,
          "text": "נגלה עליהם מלך מלכי המלכים הקב\"ה בכבודו ובעצמו וגאלם37,"
        },
        {
          "s": 13,
          "text": "נקראו בשם בתי,"
        },
        {
          "s": 14,
          "text": "דבת היא בחי' מקבל,"
        },
        {
          "s": 15,
          "text": "שאין לו משל עצמו כלום והוא רק מקבל זה שנותנים לו מלמעלה."
        },
        {
          "s": 16,
          "text": "ובמתן תורה"
        },
        {
          "s": 17,
          "text": "(שבועות)"
        },
        {
          "s": 18,
          "text": "נק' בשם אחותי,"
        },
        {
          "s": 19,
          "text": "דע\"י התורה נעשים אחים ורעים להקב\"ה."
        },
        {
          "s": 20,
          "text": "ובכללות הוא,"
        },
        {
          "s": 21,
          "text": "שע\"י התורה נעשים ישראל חד עם הקב\"ה"
        },
        {
          "s": 22,
          "text": "[כידוע בפירוש המאמר38"
        },
        {
          "s": 23,
          "text": "ישראל אורייתא וקוב\"ה כולא חד,"
        },
        {
          "s": 24,
          "text": "דע\"י שישראל הם חד עם אורייתא עי\"ז הם נעשים חד עם קוב\"ה]."
        },
        {
          "s": 25,
          "text": "וע\"י התשובה"
        },
        {
          "s": 26,
          "text": "(שלמעלה מתורה)"
        },
        {
          "s": 27,
          "text": "נק' בשם אמי,"
        },
        {
          "s": 28,
          "text": "שהם משפיעים כביכול בהקב\"ה."
        },
        {
          "s": 29,
          "text": "כמ\"ש39"
        },
        {
          "s": 30,
          "text": "צאינה וראינה בנות ציון במלך שלמה בעטרה שעטרה לו אמו ביום חתונתו ואיתא במשנה40"
        },
        {
          "s": 31,
          "text": "דיום חתונתו הוא יום הכפורים,"
        },
        {
          "s": 32,
          "text": "דע\"י התשובה דיוהכ\"פ"
        },
        {
          "s": 33,
          "text": "(דביוהכ\"פ הוא שלימות התשובה41)"
        },
        {
          "s": 34,
          "text": "מעטרת כנס\"י עטרה להקב\"ה."
        },
        {
          "s": 35,
          "text": "וכיון שהגילוי דהתשובה והכפרה דיוהכ\"פ הוא בחג הסוכות42,"
        },
        {
          "s": 36,
          "text": "לכן עיקר הענין דאמי הוא בסוכות."
        },
        {
          "s": 37,
          "text": "ומבואר בהדרושים43,"
        },
        {
          "s": 38,
          "text": "דזה שגאולה העתידה תהי' בניסן,"
        },
        {
          "s": 39,
          "text": "אף שניסן הוא בחי' בתי"
        },
        {
          "s": 40,
          "text": "(למטה מאחותי ואמי),"
        },
        {
          "s": 41,
          "text": "הוא,"
        },
        {
          "s": 42,
          "text": "כי המעלה דאחותי ואמי קשורה עם מציאותו של האדם העובד"
        },
        {
          "s": 43,
          "text": "(שע\"י העבודה שלו נעשה אח להקב\"ה,"
        },
        {
          "s": 44,
          "text": "ויתירה מזו שהוא משפיע כביכול להקב\"ה)."
        },
        {
          "s": 45,
          "text": "ולכן,"
        },
        {
          "s": 46,
          "text": "ע\"י העבודה דאחותי ואמי הוא מגיע"
        },
        {
          "s": 47,
          "text": "(ונעשה אח ואם)"
        },
        {
          "s": 48,
          "text": "רק לדרגת האור ששייך להשתלשלות"
        },
        {
          "s": 49,
          "text": "(מציאות האדם)44."
        },
        {
          "s": 50,
          "text": "והמעלה דבתי"
        },
        {
          "s": 51,
          "text": "(שאין לו משל עצמו כלום והוא רק מקבל מלמעלה)"
        },
        {
          "s": 52,
          "text": "היא בענין הביטול."
        },
        {
          "s": 53,
          "text": "ועי\"ז הוא מגיע בעצמות אוא\"ס44."
        },
        {
          "s": 54,
          "text": "וזהו שבניסן עתידין ליגאל,"
        },
        {
          "s": 55,
          "text": "כי בגאולה העתידה יהי' גילוי עצמות אוא\"ס,"
        },
        {
          "s": 56,
          "text": "דגילוי זה הוא ע\"י הביטול"
        },
        {
          "s": 57,
          "text": "[דזהו שבמשיח כתיב45"
        },
        {
          "s": 58,
          "text": "עני ורוכב על חמור,"
        },
        {
          "s": 59,
          "text": "עני דוקא],"
        },
        {
          "s": 60,
          "text": "בחי' בתי."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "שמהטעמים על זה שהגילויים דלע\"ל תלויים במעשינו ועבודתינו בזמן הגלות דוקא,"
        },
        {
          "s": 3,
          "text": "הוא,"
        },
        {
          "s": 4,
          "text": "כי ענין הביטול הוא בעיקר בהעבודה שבזמן הגלות."
        },
        {
          "s": 5,
          "text": "וכמבואר במק\"א46,"
        },
        {
          "s": 6,
          "text": "דבהעבודה שבזמן הבית,"
        },
        {
          "s": 7,
          "text": "מכיון שהי' אז השגת אלקות ובעלותם לרגל גם ראי' באלקות47,"
        },
        {
          "s": 8,
          "text": "היתה נרגשת גם מציאותו של האדם המשיג והרואה,"
        },
        {
          "s": 9,
          "text": "ובזמן הגלות,"
        },
        {
          "s": 10,
          "text": "ובפרט בדרא דעקבתא דמשיחא,"
        },
        {
          "s": 11,
          "text": "העבודה היא בביטול,"
        },
        {
          "s": 12,
          "text": "לא מצד מציאותו של האדם ורק מצד האלקות."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דהכח שישנו בדורות אלו לעמוד בכל הנסיונות שלא היו"
        },
        {
          "s": 2,
          "text": "(כ\"כ)"
        },
        {
          "s": 3,
          "text": "בדורות הקודמים,"
        },
        {
          "s": 4,
          "text": "כולל הנסיון דאל יבוש מפני המלעיגים48"
        },
        {
          "s": 5,
          "text": "שהוא נסיון גדול ביותר49,"
        },
        {
          "s": 6,
          "text": "הוא,"
        },
        {
          "s": 7,
          "text": "כי כשהאדם עומד בנסיון ע\"י שמגביר הכחות שלו,"
        },
        {
          "s": 8,
          "text": "כיון שכחותיו הם במדידה והגבלה,"
        },
        {
          "s": 9,
          "text": "ישנם דברים שאין ביכלתו להתגבר עליהם,"
        },
        {
          "s": 10,
          "text": "משא\"כ בדרא דעקבתא דמשיחא,"
        },
        {
          "s": 11,
          "text": "שהעבודה היא בבחי' בת,"
        },
        {
          "s": 12,
          "text": "לא מצד הכחות שיש לו אלא מצד ביטולו לאלקות,"
        },
        {
          "s": 13,
          "text": "הרי מובן,"
        },
        {
          "s": 14,
          "text": "שלגבי אלקות אין שום הגבלות."
        },
        {
          "s": 15,
          "text": "ויש לומר,"
        },
        {
          "s": 16,
          "text": "דענין זה"
        },
        {
          "s": 17,
          "text": "(המעלה דבחינת בת שבזמן הגלות)"
        },
        {
          "s": 18,
          "text": "מרומז בזה שמבואר בהדרושים"
        },
        {
          "s": 19,
          "text": "(הובאו לעיל)"
        },
        {
          "s": 20,
          "text": "שג' הענינים דבתי אחותי ואמי הם כנגד ג' רגלים."
        },
        {
          "s": 21,
          "text": "שהסדר בג' ענינים אלה שבתי הוא למטה מאחותי ואמי,"
        },
        {
          "s": 22,
          "text": "הוא כמו שהם כנגד ג' רגלים,"
        },
        {
          "s": 23,
          "text": "זמן הבית."
        },
        {
          "s": 24,
          "text": "אבל בחי' בתי שבזמן הגלות,"
        },
        {
          "s": 25,
          "text": "שהוא הביטול שמצד עצם הנשמה,"
        },
        {
          "s": 26,
          "text": "אינה בכלל ג' ענינים אלה50"
        },
        {
          "s": 27,
          "text": "והיא למעלה מהם."
        }
      ]
    }
  ]
}