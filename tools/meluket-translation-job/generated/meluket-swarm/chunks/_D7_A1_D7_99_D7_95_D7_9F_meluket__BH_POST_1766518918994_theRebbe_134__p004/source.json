{
  "globalIndex": 885,
  "owner": 35,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918994_theRebbe_134__p004",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918994_theRebbe_134__p004",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918994_theRebbe_134",
  "title": "מאמר בשעה שעלה משה למרום תשכ\"א",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "וביאור הענין,"
        },
        {
          "s": 1,
          "text": "הנה נתבאר לעיל שהמלאכים נתהוו בגופם ונפשם כאחד,"
        },
        {
          "s": 2,
          "text": "ומזה מובן שכשם שגופם בערך לנפשם,"
        },
        {
          "s": 3,
          "text": "כמו\"כ גם נפשם בערך לגופם."
        },
        {
          "s": 4,
          "text": "והענין בזה,"
        },
        {
          "s": 5,
          "text": "שגופם של המלאכים הוא בערך לנפשם,"
        },
        {
          "s": 6,
          "text": "ולכן כשהמלאך אומר שירה,"
        },
        {
          "s": 7,
          "text": "שהוא מצד הנפש,"
        },
        {
          "s": 8,
          "text": "אזי נעשה ביטול גם בגופו,"
        },
        {
          "s": 9,
          "text": "וכמ\"ש70"
        },
        {
          "s": 10,
          "text": "וצבא השמים לך משתחוים,"
        },
        {
          "s": 11,
          "text": "דקאי על הגלגלים שמסבבים ממזרח למערב,"
        },
        {
          "s": 12,
          "text": "כידוע71"
        },
        {
          "s": 13,
          "text": "שזהו ההשתחוואה והביטול שלהם להשכינה,"
        },
        {
          "s": 14,
          "text": "דשכינה במערב72,"
        },
        {
          "s": 15,
          "text": "שענין זה הוא מצד השירה שאומרת נפש הגלגלים,"
        },
        {
          "s": 16,
          "text": "והיינו,"
        },
        {
          "s": 17,
          "text": "שאמירת השירה מצד נפשם פועלת שנעשה גם ההשתחוואה בגופם,"
        },
        {
          "s": 18,
          "text": "שמסבבים למערב."
        },
        {
          "s": 19,
          "text": "וזהו73"
        },
        {
          "s": 20,
          "text": "שמצינו ביהושע תלמידו של משה"
        },
        {
          "s": 21,
          "text": "(כמאמר1"
        },
        {
          "s": 22,
          "text": "משה קבל תורה מסיני ומסרה ליהושע),"
        },
        {
          "s": 23,
          "text": "שכאשר רצה להעמיד את השמש,"
        },
        {
          "s": 24,
          "text": "אמר שמש בגבעון דום74,"
        },
        {
          "s": 25,
          "text": "שלא אמר עמוד,"
        },
        {
          "s": 26,
          "text": "אלא אמר דום,"
        },
        {
          "s": 27,
          "text": "דום מלומר שירה75,"
        },
        {
          "s": 28,
          "text": "ועי\"ז עמד השמש מלכת."
        },
        {
          "s": 29,
          "text": "והיינו לפי שהילוך השמש הוא מצד שירת נפש המלאך שפועל גם על גוף המלאך,"
        },
        {
          "s": 30,
          "text": "שמזה נמשך גם הליכת גלגל השמש,"
        },
        {
          "s": 31,
          "text": "וכשפסק נפש המלאך לומר שירה,"
        },
        {
          "s": 32,
          "text": "אזי נפסק במילא הליכת השמש."
        },
        {
          "s": 33,
          "text": "ומכל זה מובן שגוף המלאך הוא בערך לנפשו."
        },
        {
          "s": 34,
          "text": "וכמו\"כ לאידך גיסא,"
        },
        {
          "s": 35,
          "text": "שנפש המלאך הוא בערך לגופו,"
        },
        {
          "s": 36,
          "text": "דכשם שהגוף הוא מוגבל,"
        },
        {
          "s": 37,
          "text": "כך הנפש היא מוגבלת,"
        },
        {
          "s": 38,
          "text": "ולכן יש הגבלה והפסק בשירת המלאכים כנ\"ל,"
        },
        {
          "s": 39,
          "text": "דהגם שהשירה היא מצד נפשם,"
        },
        {
          "s": 40,
          "text": "מ\"מ יש בזה הגבלה והפסק."
        },
        {
          "s": 41,
          "text": "משא\"כ הנשמות אינם מוגבלים כלל."
        },
        {
          "s": 42,
          "text": "ונשמת האדם שאינה מוגבלת כלל,"
        },
        {
          "s": 43,
          "text": "נתלבשה בגוף בשר ודם דוקא,"
        },
        {
          "s": 44,
          "text": "לתקנו ולהעלותו ע\"י התורה,"
        },
        {
          "s": 45,
          "text": "שבזה נשלם כללות כוונת הבריאה,"
        },
        {
          "s": 46,
          "text": "וכנ\"ל במשל הבנין שצריך להגביהו מתחתיתו דוקא,"
        },
        {
          "s": 47,
          "text": "לעשות את העולם משכן לו ית',"
        },
        {
          "s": 48,
          "text": "לפי שנעוץ תחילתן בסופן וסופן בתחילתן."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "וזהו בשעה שעלה משה למרום והמלאכים טענו מה אנוש כי תזכרנו תנה הודך על השמים,"
        },
        {
          "s": 2,
          "text": "אמר הקב\"ה למשה רבינו החזר להם תשובה,"
        },
        {
          "s": 3,
          "text": "והיינו שהתשובה היתה צריכה להיות מנשמה בגוף דוקא,"
        },
        {
          "s": 4,
          "text": "שנשמה בגוף הראה להם את המעלה שבגוף גשמי דוקא,"
        },
        {
          "s": 5,
          "text": "ואז הודו המלאכים,"
        },
        {
          "s": 6,
          "text": "שנאמר76"
        },
        {
          "s": 7,
          "text": "ה' אדונינו מה אדיר שמך וגו' ואילו תנה הודך על השמים לא כתיב3,"
        },
        {
          "s": 8,
          "text": "וכל אחד ואחד נעשה לו אוהב ומסר לו דבר,"
        },
        {
          "s": 9,
          "text": "שנאמר77"
        },
        {
          "s": 10,
          "text": "עלית למרום שבית שבי לקחת מתנות באדם,"
        },
        {
          "s": 11,
          "text": "ואחר כך נתנו מתנות לכל ישראל,"
        },
        {
          "s": 12,
          "text": "שזהו שירדו ששים רבוא מלאכי השרת וקשרו להם שני כתרים78,"
        },
        {
          "s": 13,
          "text": "שהוא ענין סיוע המלאכים על עבודת האדם,"
        },
        {
          "s": 14,
          "text": "והיינו,"
        },
        {
          "s": 15,
          "text": "דתמורת זה שבתחילה קטרגו,"
        },
        {
          "s": 16,
          "text": "הנה הם עצמם הודו וסייעו לעבודת האדם"
        },
        {
          "s": 17,
          "text": "(והוא ע\"ד משנת\"ל"
        },
        {
          "s": 18,
          "text": "(ס\"ב)"
        },
        {
          "s": 19,
          "text": "בפירוש סור מרע ועשה טוב)."
        },
        {
          "s": 20,
          "text": "והודאה זו היתה בשעה שהקדימו ישראל נעשה לנשמע78,"
        },
        {
          "s": 21,
          "text": "דשמיעה ענינה הבנה והשגה,"
        },
        {
          "s": 22,
          "text": "שענין זה ישנו גם במלאכים,"
        },
        {
          "s": 23,
          "text": "אמנם ישראל הקדימו נעשה לנשמע,"
        },
        {
          "s": 24,
          "text": "שהראו את מעלת העשי',"
        },
        {
          "s": 25,
          "text": "מעלת דומם דוקא,"
        },
        {
          "s": 26,
          "text": "ואז הודו המלאכים על נתינת התורה לישראל למטה דוקא."
        },
        {
          "s": 27,
          "text": "ובכלל זה היתה גם הודאתם על עשיית המשכן"
        },
        {
          "s": 28,
          "text": "(שזהו אחד משלשה המקומות שהיו המלאכים מדיינים כנגד הקב\"ה),"
        },
        {
          "s": 29,
          "text": "דעשיית המשכן הוא תכלית כוונת הבריאה,"
        },
        {
          "s": 30,
          "text": "ועיקר התכלית אינו בהמשכן שהי' במדבר,"
        },
        {
          "s": 31,
          "text": "כי אם במשכן שילה,"
        },
        {
          "s": 32,
          "text": "ובעיקר בבית עולמים,"
        },
        {
          "s": 33,
          "text": "וכמ\"ש79"
        },
        {
          "s": 34,
          "text": "כי לא באתם עד עתה אל המנוחה ואל הנחלה,"
        },
        {
          "s": 35,
          "text": "ואילו המשכן הי' עראי,"
        },
        {
          "s": 36,
          "text": "והיינו לפי שהמשכן הי' מעצי שטים עומדים80,"
        },
        {
          "s": 37,
          "text": "שהוא דוגמת81"
        },
        {
          "s": 38,
          "text": "שרפים עומדים82,"
        },
        {
          "s": 39,
          "text": "ובמשכן שילה ניתוסף גם אבנים83,"
        },
        {
          "s": 40,
          "text": "והבית המקדש הי' מאבנים"
        },
        {
          "s": 41,
          "text": "(דומם)"
        },
        {
          "s": 42,
          "text": "דוקא84,"
        },
        {
          "s": 43,
          "text": "הנה זה הי' העיקר"
        },
        {
          "s": 44,
          "text": "[ומזה מובן שאם בהמשכן שהאדם למטה עושה העיקר הוא בדומם ולא בצומח,"
        },
        {
          "s": 45,
          "text": "הרי עאכו\"כ שהעיקר אינו במלאכים]."
        },
        {
          "s": 46,
          "text": "ועוד זאת,"
        },
        {
          "s": 47,
          "text": "שבכלל הודאתם על עשיית המשכן נכללת גם ההודאה על ביהמ\"ק השלישי,"
        },
        {
          "s": 48,
          "text": "שהרי בהמשכן כתיב85"
        },
        {
          "s": 49,
          "text": "וכן תעשו,"
        },
        {
          "s": 50,
          "text": "ואמרו רז\"ל86"
        },
        {
          "s": 51,
          "text": "(תעשו)"
        },
        {
          "s": 52,
          "text": "לדורות,"
        },
        {
          "s": 53,
          "text": "שעיקר התכלית בזה הוא ביהמ\"ק השלישי שיהי' נעלה יותר גם מבית עולמים שהי' קודם,"
        },
        {
          "s": 54,
          "text": "דהגם שגם הוא הי' באופן של קבע,"
        },
        {
          "s": 55,
          "text": "ולא באופן של עראי כהמשכן,"
        },
        {
          "s": 56,
          "text": "מ\"מ,"
        },
        {
          "s": 57,
          "text": "הי' אחריו חורבן וגלות,"
        },
        {
          "s": 58,
          "text": "ורק בביהמ\"ק השלישי87"
        },
        {
          "s": 59,
          "text": "שלא יהי' אחריו גלות88,"
        },
        {
          "s": 60,
          "text": "יהי' עיקר הענין דדירת קבע,"
        },
        {
          "s": 61,
          "text": "ובאופן של דירה,"
        },
        {
          "s": 62,
          "text": "כמשל דירת מלך בשר ודם שדר בהדירה בכל עצמותו89."
        },
        {
          "s": 63,
          "text": "וגם ענין זה הי' כלול בשעת מתן תורה,"
        },
        {
          "s": 64,
          "text": "דכשם שבשעת מתן תורה הי' הדיבור אנכי נשמע מכל ו' הקצוות90,"
        },
        {
          "s": 65,
          "text": "כמו\"כ לעתיד ונגלה כבוד הוי' וראו כל בשר91,"
        },
        {
          "s": 66,
          "text": "שבכל רוח מו' הקצוות יראו אלקות."
        },
        {
          "s": 67,
          "text": "ובהודאת המלאכים על נתינת התורה למטה נכלל גם הודאתם על בנין בית המקדש השלישי,"
        },
        {
          "s": 68,
          "text": "שאז יהי' ונגלה כבוד הוי' וראו כל בשר יחדיו כי פי הוי' דיבר,"
        },
        {
          "s": 69,
          "text": "ויהי' הוי' אחד ושמו אחד92."
        }
      ]
    }
  ]
}