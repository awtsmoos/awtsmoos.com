{
  "globalIndex": 258,
  "owner": 8,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915304_theRebbe_180__p004",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915304_theRebbe_180__p004",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915304_theRebbe_180",
  "title": "מאמר ושבתי בשלום תשל\"ח",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "והנה ג' ענינים הנ\"ל שהיו ביעקב –"
        },
        {
          "s": 2,
          "text": "(א)"
        },
        {
          "s": 3,
          "text": "יציאתו מבאר שבע לחרן,"
        },
        {
          "s": 4,
          "text": "(ב)"
        },
        {
          "s": 5,
          "text": "עבודתו"
        },
        {
          "s": 6,
          "text": "(לאחרי היציאה מבאר שבע)"
        },
        {
          "s": 7,
          "text": "ויקח מאבני המקום גו',"
        },
        {
          "s": 8,
          "text": "(ג)"
        },
        {
          "s": 9,
          "text": "(שע\"י התפלה שלו)"
        },
        {
          "s": 10,
          "text": "נעשתה האבן הזאת"
        },
        {
          "s": 11,
          "text": "(שלקח מאבני המקום)"
        },
        {
          "s": 12,
          "text": "בית אלקים – ישנם גם בכאו\"א מישראל."
        },
        {
          "s": 13,
          "text": "דמעשה אבות סימן ונתינת כח לבנים"
        },
        {
          "s": 14,
          "text": "(כנ\"ל סעיף ב),"
        },
        {
          "s": 15,
          "text": "ובפרט הענינים דיעקב."
        },
        {
          "s": 16,
          "text": "דמכיון ששופרי' דיעקב מעין שופרי' דאדה\"ר57,"
        },
        {
          "s": 17,
          "text": "ונשמתו כלולה מכל הנשמות שבישראל"
        },
        {
          "s": 18,
          "text": "(כנשמת אדה\"ר58)59,"
        },
        {
          "s": 19,
          "text": "הרי עבודתו של יעקב"
        },
        {
          "s": 20,
          "text": "(ויקח מאבני המקום גו')"
        },
        {
          "s": 21,
          "text": "היא נתינת כח לבנים ביתר שאת וביתר עוז."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "והענין הוא,"
        },
        {
          "s": 1,
          "text": "דויצא יעקב מבאר שבע וילך חרנה קאי60"
        },
        {
          "s": 2,
          "text": "על ירידת הנשמה בגוף,"
        },
        {
          "s": 3,
          "text": "שירדה מאיגרא61"
        },
        {
          "s": 4,
          "text": "רמה"
        },
        {
          "s": 5,
          "text": "(באר שבע)"
        },
        {
          "s": 6,
          "text": "לבירא עמיקתא"
        },
        {
          "s": 7,
          "text": "(חרנה)."
        },
        {
          "s": 8,
          "text": "וכמו שיעקב,"
        },
        {
          "s": 9,
          "text": "בכדי שיוכל ללכת לחרן נמשך לו כח נעלה יותר – ענין צוה ישועות יעקב"
        },
        {
          "s": 10,
          "text": "(כנ\"ל סעיף ה),"
        },
        {
          "s": 11,
          "text": "עד\"ז הוא גם בוילך חרנה שבכאו\"א מישראל,"
        },
        {
          "s": 12,
          "text": "שלפני ירידת הנשמה למטה לבירא עמיקתא,"
        },
        {
          "s": 13,
          "text": "שזהו\"ע וילך חרנה,"
        },
        {
          "s": 14,
          "text": "נותנים לה כח במיוחד שתוכל לעבוד עבודתה בבירור הגוף ונפש הבהמית וחלקה בעולם."
        },
        {
          "s": 15,
          "text": "וכידוע62"
        },
        {
          "s": 16,
          "text": "בענין משביעין אותו תהי צדיק ואל תהי רשע63."
        },
        {
          "s": 17,
          "text": "וזהו מ\"ש ויצא יעקב מבאר שבע גו',"
        },
        {
          "s": 18,
          "text": "שפירוש מבאר שבע הוא64"
        },
        {
          "s": 19,
          "text": "מה שמשביעין אותו תהי צדיק כו'"
        },
        {
          "s": 20,
          "text": "[שיש בזה ג' פירושים,"
        },
        {
          "s": 21,
          "text": "שבועה,"
        },
        {
          "s": 22,
          "text": "שובע ושבע,"
        },
        {
          "s": 23,
          "text": "כמבואר בכ\"מ65]"
        },
        {
          "s": 24,
          "text": "שהוא נתינת כח במיוחד על עבודת הנשמה בירידתה למטה."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "והנה עבודת הנשמה בירידתה למטה היא"
        },
        {
          "s": 2,
          "text": "(בכללות)"
        },
        {
          "s": 3,
          "text": "בשני ענינים."
        },
        {
          "s": 4,
          "text": "א',"
        },
        {
          "s": 5,
          "text": "לימוד התורה וקיום המצוות,"
        },
        {
          "s": 6,
          "text": "דע\"י לימוד התורה וקיום המצוות למטה דוקא מתעלית הנשמה למעלה יותר מכמו שהיתה קודם ירידתה."
        },
        {
          "s": 7,
          "text": "וכידוע66"
        },
        {
          "s": 8,
          "text": "דהתורה והמצוות שלמטה דוקא נעשים לבוש להנשמה בג\"ע שעל ידם היא משגת ונהנית מאוא\"ס."
        },
        {
          "s": 9,
          "text": "וב',"
        },
        {
          "s": 10,
          "text": "הבירור דגוף ודנפש הבהמית וחלקו בעולם."
        },
        {
          "s": 11,
          "text": "שזה נעשה ע\"י קיום המצוות67,"
        },
        {
          "s": 12,
          "text": "וי\"ל עוד יותר – ע\"י העבודה דכל מעשיך יהיו לשם שמים68,"
        },
        {
          "s": 13,
          "text": "ובפרט ע\"י בכל דרכיך דעהו69,"
        },
        {
          "s": 14,
          "text": "דלא רק שעשייתו דברי הרשות תהי' לשם שמים,"
        },
        {
          "s": 15,
          "text": "אלא שגם בהם גופא"
        },
        {
          "s": 16,
          "text": "(בכל דרכיך)"
        },
        {
          "s": 17,
          "text": "יהי' דעהו70"
        },
        {
          "s": 18,
          "text": "[דעת באלקות,"
        },
        {
          "s": 19,
          "text": "שדעת הוא למעלה גם מחכמה,"
        },
        {
          "s": 20,
          "text": "כמבואר בארוכה בהמשך עת\"ר71"
        },
        {
          "s": 21,
          "text": "ובכ\"מ]."
        },
        {
          "s": 22,
          "text": "וזהו ונתן לי לחם לאכול ובגד ללבוש ושבתי בשלום אל בית אבי,"
        },
        {
          "s": 23,
          "text": "לחם לאכול ובגד ללבוש הוא לימוד התורה וקיום המצוות72"
        },
        {
          "s": 24,
          "text": "כידוע73"
        },
        {
          "s": 25,
          "text": "שתורה היא לחם ומזון הנשמה והמצוות הם לבושים דהנשמה,"
        },
        {
          "s": 26,
          "text": "ושבתי בשלום הו\"ע עבודת הבירורים."
        }
      ]
    }
  ]
}