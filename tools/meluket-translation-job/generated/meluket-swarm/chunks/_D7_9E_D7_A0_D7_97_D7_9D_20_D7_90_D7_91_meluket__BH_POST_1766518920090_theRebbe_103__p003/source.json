{
  "globalIndex": 1070,
  "owner": 20,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518920090_theRebbe_103__p003",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518920090_theRebbe_103__p003",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518920090_theRebbe_103",
  "title": "מאמר ושמתי כדכד שמשתיך תשט\"ז",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "והנה כמו\"כ המצוות נקראים ברית,"
        },
        {
          "s": 1,
          "text": "לפי שבהמצוות יש ג\"כ ב' בחי',"
        },
        {
          "s": 2,
          "text": "שהרי הם עצמן נעשים מדברים גשמיים,"
        },
        {
          "s": 3,
          "text": "ובהם הוא המשכת רצון העליון,"
        },
        {
          "s": 4,
          "text": "דרצון הוא למעלה מחכמה."
        },
        {
          "s": 5,
          "text": "וב' בחי' אלו בהמצוות אינם ב' ענינים נבדלים,"
        },
        {
          "s": 6,
          "text": "אלא הו\"ע אחד,"
        },
        {
          "s": 7,
          "text": "שהרי המצוות המתלבשים בדברים גשמיים,"
        },
        {
          "s": 8,
          "text": "הן הן עצמם הוא רצון העליון,"
        },
        {
          "s": 9,
          "text": "שכך עלה ברצונו לקיים המצוות בגשמיות דוקא."
        },
        {
          "s": 10,
          "text": "ולפי שהוא רצה\"ע שלמעלה גם מהחכמה,"
        },
        {
          "s": 11,
          "text": "לכן הוא יורד למטה בדברים גשמיים דוקא."
        },
        {
          "s": 12,
          "text": "אמנם זה גופא שע\"י תומ\"צ יהי' אפשר להיות היחוד דנש\"י עם אוא\"ס,"
        },
        {
          "s": 13,
          "text": "דלכאורה,"
        },
        {
          "s": 14,
          "text": "כיון שאוא\"ס לאו מכל אלין מדות איהו כלל,"
        },
        {
          "s": 15,
          "text": "איך יהי' תופס מקום מעשה התחתונים שיהי' יחוד פב\"פ,"
        },
        {
          "s": 16,
          "text": "דמאחר שלאו מכל אלין מדות איהו כלל,"
        },
        {
          "s": 17,
          "text": "אי אפשר שיהי' יחוד פב\"פ,"
        },
        {
          "s": 18,
          "text": "הן מצד אוא\"ס והן מצד נש\"י,"
        },
        {
          "s": 19,
          "text": "הנה עז\"נ אנכי עומד בין הוי' וביניכם להגיד לכם את דבר הוי',"
        },
        {
          "s": 20,
          "text": "דאנכי מי שאנכי הוא בחי' הכתר שלמעלה משניהם,"
        },
        {
          "s": 21,
          "text": "ובכח הכתר נעשה היחוד ע\"י התורה."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "וזהו והי' עקב תשמעון את המשפטים האלה,"
        },
        {
          "s": 2,
          "text": "דהנה,"
        },
        {
          "s": 3,
          "text": "התרגום דמשפט הוא הלכתא17,"
        },
        {
          "s": 4,
          "text": "שהו\"ע הלכות התורה,"
        },
        {
          "s": 5,
          "text": "והיינו דכיון שבפסוק זה מבאר היחוד דנש\"י עם הקב\"ה כנ\"ל,"
        },
        {
          "s": 6,
          "text": "לכן נאמר את המשפטים האלה,"
        },
        {
          "s": 7,
          "text": "שהיחוד הוא ע\"י הלכות התורה."
        },
        {
          "s": 8,
          "text": "ותשמעון היינו לשון אסיפה,"
        },
        {
          "s": 9,
          "text": "כמו וישמע שאול כו'18,"
        },
        {
          "s": 10,
          "text": "והענין הוא לקבץ ולאסוף כל פזורי ניצוצי נפשו האלקית שנתקשרה ברצונות זרות,"
        },
        {
          "s": 11,
          "text": "ע\"י ריבוי המחשבות ופיזור הנפש,"
        },
        {
          "s": 12,
          "text": "דהגם דכתיב19"
        },
        {
          "s": 13,
          "text": "וברכך הוי' אלקיך בכל אשר תעשה דוקא,"
        },
        {
          "s": 14,
          "text": "שצריך להיות העשי' בגשמיות,"
        },
        {
          "s": 15,
          "text": "מ\"מ,"
        },
        {
          "s": 16,
          "text": "המחשבה אינה צריכה להיות שקועה בזה,"
        },
        {
          "s": 17,
          "text": "וכמ\"ש20"
        },
        {
          "s": 18,
          "text": "יגיע כפיך כי תאכל,"
        },
        {
          "s": 19,
          "text": "שצריך להיות יגיע כפים בלבד,"
        },
        {
          "s": 20,
          "text": "אבל לא יגיעת המוח והלב,"
        },
        {
          "s": 21,
          "text": "ולכן צריך לקבץ את הניצוצות שנתפזרו בפיזור הנפש,"
        },
        {
          "s": 22,
          "text": "וכמ\"ש21"
        },
        {
          "s": 23,
          "text": "אם יהי' נדחך בקצה השמים משם יקבצך."
        },
        {
          "s": 24,
          "text": "וכשם שצריך לאסוף פזורי ניצוצי נפשו,"
        },
        {
          "s": 25,
          "text": "כך צריך להיות האסיפה גם בהלכות התורה,"
        },
        {
          "s": 26,
          "text": "דמצד הפיזור שנעשה בנפשו,"
        },
        {
          "s": 27,
          "text": "נעשה אצלו העלם והסתר גם בהתורה,"
        },
        {
          "s": 28,
          "text": "שאינו יכול לברר ולפסוק הלכה לאמיתתה,"
        },
        {
          "s": 29,
          "text": "ועז\"נ תשמעון את המשפטים,"
        },
        {
          "s": 30,
          "text": "אלו ההלכות,"
        },
        {
          "s": 31,
          "text": "דתשמעון הוא אסיפה,"
        },
        {
          "s": 32,
          "text": "שצריך להיות האסיפה בנפשו והאסיפה בהלכות התורה."
        },
        {
          "s": 33,
          "text": "וזהו ג\"כ מ\"ש22"
        },
        {
          "s": 34,
          "text": "ואספת דגנך ותירושך ויצהרך,"
        },
        {
          "s": 35,
          "text": "דנש\"י נקראים בשם דגנך ותירושך ויצהרך,"
        },
        {
          "s": 36,
          "text": "והם ג' חלוקי דרגות בנש\"י,"
        },
        {
          "s": 37,
          "text": "כהנים לויים וישראלים."
        },
        {
          "s": 38,
          "text": "דגנך אלו ישראלים,"
        },
        {
          "s": 39,
          "text": "דכמו שבגשמיות הרי הלחם הוא העיקר,"
        },
        {
          "s": 40,
          "text": "דלחם לבב אנוש יסעד23,"
        },
        {
          "s": 41,
          "text": "ושאר המאכלים הם רק תוספות על הלחם,"
        },
        {
          "s": 42,
          "text": "כמו\"כ גם בנש\"י העיקר הוא ישראלים,"
        },
        {
          "s": 43,
          "text": "דגם כהנים ולויים הם ישראלים,"
        },
        {
          "s": 44,
          "text": "אלא שיש בהם תוספת מעלה דכהנים ולויים,"
        },
        {
          "s": 45,
          "text": "ולכן ישראלים נקראים דגנך."
        },
        {
          "s": 46,
          "text": "תירושך אלו לויים,"
        },
        {
          "s": 47,
          "text": "דעבודת הלויים הוא באמירת שירה,"
        },
        {
          "s": 48,
          "text": "ואין אומרים שירה אלא על היין24."
        },
        {
          "s": 49,
          "text": "ויצהרך אלו כהנים,"
        },
        {
          "s": 50,
          "text": "שעבודתם היא בבחי' שמן,"
        },
        {
          "s": 51,
          "text": "בחשאי וברעותא דלבא25."
        },
        {
          "s": 52,
          "text": "וזהו ואספת דגנך ותירושך ויצהרך,"
        },
        {
          "s": 53,
          "text": "שהו\"ע אסיפת פזורי הניצוצים בכל הג' סוגים שבנש\"י."
        },
        {
          "s": 54,
          "text": "גם פירוש ואספת דגנך תירושך ויצהרך הו\"ע האסיפה שצריך להיות בהתורה,"
        },
        {
          "s": 55,
          "text": "דהתורה נקראת ג\"כ בשם דגנך תירושך ויצהרך,"
        },
        {
          "s": 56,
          "text": "והם חילוקי המדריגות שיש בתורה."
        },
        {
          "s": 57,
          "text": "דגנך הוא גליא דתורה,"
        },
        {
          "s": 58,
          "text": "תירושך הוא פנימיות התורה,"
        },
        {
          "s": 59,
          "text": "רזין דאורייתא,"
        },
        {
          "s": 60,
          "text": "ויצהרך הוא רזין דרזין,"
        },
        {
          "s": 61,
          "text": "וכמו שמן שצף ע\"ג היין26,"
        },
        {
          "s": 62,
          "text": "כמבואר באמרי בינה27"
        },
        {
          "s": 63,
          "text": "באריכות."
        },
        {
          "s": 64,
          "text": "וזהו ואספת דגנך גו',"
        },
        {
          "s": 65,
          "text": "שהו\"ע האסיפה שצריך להיות בכל חלקי התורה."
        },
        {
          "s": 66,
          "text": "וזהו והי' עקב תשמעון את המשפטים האלה,"
        },
        {
          "s": 67,
          "text": "שכאשר יהי' האסיפה דפזורי ניצוצי נפשו והאסיפה בהתורה,"
        },
        {
          "s": 68,
          "text": "ובכללות הוא העבודה דתשמעון ושמרתם ועשיתם שהם מחדומ\"ע,"
        },
        {
          "s": 69,
          "text": "עי\"ז יומשך גם המחדומ\"ע מלמעלמ\"ט,"
        },
        {
          "s": 70,
          "text": "שיהי' יחוד פב\"פ דנש\"י ואוא\"ס ב\"ה."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "אמנם כל זה הוא בעבודה דמחדומ\"ע כמו שהיא מצד רצון התחתון הנולד מהשכל."
        },
        {
          "s": 2,
          "text": "אמנם בהעבודה כמו שהיא מצד רצון העליון,"
        },
        {
          "s": 3,
          "text": "דהיינו העבודה דרעו\"ד שלמעלה מטעם ודעת,"
        },
        {
          "s": 4,
          "text": "דבכללות הוא האהבה דבכל מאדך שנאמרה בפ' ראשונה דק\"ש,"
        },
        {
          "s": 5,
          "text": "הנה בפ' זו לא נזכר הפסוק ואספת דגנך תירושך ויצהרך"
        },
        {
          "s": 6,
          "text": "(שנעשה מצד הענין דאם יהי' נדחך גו')"
        },
        {
          "s": 7,
          "text": "כמו בפ' שני' דק\"ש,"
        },
        {
          "s": 8,
          "text": "לפי שמצד האהבה דבכל מאדך,"
        },
        {
          "s": 9,
          "text": "שהו\"ע עושין רצונו של מקום,"
        },
        {
          "s": 10,
          "text": "כנ\"ל28"
        },
        {
          "s": 11,
          "text": "בשם המגיד שהו\"ע המשכת רצה\"ע שלמעלה מהשתלשלות,"
        },
        {
          "s": 12,
          "text": "הנה מצד המשכת בחי' זו אין צריך להיות העבודה דואספת,"
        },
        {
          "s": 13,
          "text": "כי אם כמ\"ש29"
        },
        {
          "s": 14,
          "text": "וברך גו' דגנך ותירושך ויצהרך,"
        },
        {
          "s": 15,
          "text": "שלא יהי' בהם בחי' פיזור הנפש ברצונות זרות כו',"
        },
        {
          "s": 16,
          "text": "שענין זה שייך בהשתלשלות דוקא,"
        },
        {
          "s": 17,
          "text": "אבל מצד האהבה דבכל מאדך שממשיכים הרצון שלמעלה מהשתלשלות,"
        },
        {
          "s": 18,
          "text": "אין שייך ענין זה."
        },
        {
          "s": 19,
          "text": "וזהו אמיתית ענין הברית דתורה,"
        },
        {
          "s": 20,
          "text": "דתורה ענינה המשכה מלמעלה למטה,"
        },
        {
          "s": 21,
          "text": "היינו המשכת האור עליון כמו שהוא"
        },
        {
          "s": 22,
          "text": "(שלא לפי ערך הנבראים),"
        },
        {
          "s": 23,
          "text": "והוא האור שלמעלה מהשתלשלות,"
        },
        {
          "s": 24,
          "text": "דתפלה היא העלאה מלמטה למעלה,"
        },
        {
          "s": 25,
          "text": "ואספת דגנך גו',"
        },
        {
          "s": 26,
          "text": "אבל התורה היא המשכה מלמעלה למטה,"
        },
        {
          "s": 27,
          "text": "המשכת האור שלמעלה מהשתלשלות,"
        },
        {
          "s": 28,
          "text": "והוא ע\"י הקדמת העבודה דרעו\"ד,"
        },
        {
          "s": 29,
          "text": "בחי' בכל מאדך,"
        },
        {
          "s": 30,
          "text": "שאז נמשך ע\"י התורה האור שלמעלה מהשתלשלות,"
        },
        {
          "s": 31,
          "text": "וזהו אמיתית ענין הברית דתורה,"
        },
        {
          "s": 32,
          "text": "שהתורה הוא המחבר ומייחד נש\"י בהבחי' שלמעלה מהשתלשלות."
        }
      ]
    }
  ]
}