{
  "globalIndex": 3,
  "owner": 3,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913707_theRebbe_562__p004",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913707_theRebbe_562__p004",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518913707_theRebbe_562",
  "title": "מאמר יבחר לנו את נחלתינו תשכ\"ג",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דהגילוי שע\"י המלכות כמו שהיא בהספירות דז\"א,"
        },
        {
          "s": 2,
          "text": "גילוי באצילות,"
        },
        {
          "s": 3,
          "text": "הוא ע\"ד הירידה דצמצום,"
        },
        {
          "s": 4,
          "text": "והגילוי שע\"י המלכות כמו שהיא פרצוף בפ\"ע,"
        },
        {
          "s": 5,
          "text": "גילוי בבי\"ע,"
        },
        {
          "s": 6,
          "text": "הוא ע\"ד הירידה דהתלבשות במשלים39."
        },
        {
          "s": 7,
          "text": "ומזה מובן גודל העילוי דההמשכה שעל ידה נעשה בנין המלכות"
        },
        {
          "s": 8,
          "text": "(ובפרט בנין המלכות דר\"ה)"
        },
        {
          "s": 9,
          "text": "שאינה מוגדרת בהגדר והציור דלמעלה מהתלבשות,"
        },
        {
          "s": 10,
          "text": "שלכן,"
        },
        {
          "s": 11,
          "text": "ע\"י המשכה זו,"
        },
        {
          "s": 12,
          "text": "נמשך ומתלבש הגילוי גם בבי\"ע,"
        },
        {
          "s": 13,
          "text": "ובבי\"ע עצמם – אפילו בדומם,"
        },
        {
          "s": 14,
          "text": "שגם הדומם ידע כי אתה פעלתו."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "דלפי ביאור זה,"
        },
        {
          "s": 3,
          "text": "שהטעם שבכדי שיהי' בנין המלכות הוא ע\"י המשכה מעצמות אוא\"ס הוא כי בכדי שתהי' ירידה למטה מטה"
        },
        {
          "s": 4,
          "text": "(ובאופן דהתלבשות)"
        },
        {
          "s": 5,
          "text": "הוא ע\"י המשכת כח מופלא שאינו מוגדר,"
        },
        {
          "s": 6,
          "text": "הירידה"
        },
        {
          "s": 7,
          "text": "(הגילוי דמלכות)"
        },
        {
          "s": 8,
          "text": "יש לה יחס לגבי כח המופלא."
        },
        {
          "s": 9,
          "text": "דכיון שההפלאה שלו הוא שאינו מוגדר בהציור דלמעלה דוקא וביכלתו גם לירד למטה,"
        },
        {
          "s": 10,
          "text": "הרי הירידה למטה הוא גילוי ההפלאה שלו."
        },
        {
          "s": 11,
          "text": "ויתירה מזו,"
        },
        {
          "s": 12,
          "text": "שגילוי ההפלאה שלו הוא גם באופן הירידה."
        },
        {
          "s": 13,
          "text": "דכל שהוא מופלא יותר ביכלתו לירד למטה יותר."
        },
        {
          "s": 14,
          "text": "ומזה מובן,"
        },
        {
          "s": 15,
          "text": "דמ\"ש בהדרושים"
        },
        {
          "s": 16,
          "text": "(שמבואר בהם ביאור זה)"
        },
        {
          "s": 17,
          "text": "שבר\"ה צ\"ל ההמשכה מעצמות אוא\"ס,"
        },
        {
          "s": 18,
          "text": "הכוונה בזה היא לההפלאה דאוא\"ס"
        },
        {
          "s": 19,
          "text": "(שאינו מוגדר),"
        },
        {
          "s": 20,
          "text": "ולא להעצמות ממש."
        },
        {
          "s": 21,
          "text": "משא\"כ להביאור דלעיל"
        },
        {
          "s": 22,
          "text": "(סעיף ג)"
        },
        {
          "s": 23,
          "text": "דהטעם שהמשכת המלכות בר\"ה צריכה להיות מעצמות אוא\"ס הוא לפי שעליית וסילוק המלכות היא בכל הדרגות"
        },
        {
          "s": 24,
          "text": "(ולכן צריכה להיות ההמשכה ממקום נעלה ביותר),"
        },
        {
          "s": 25,
          "text": "ההמשכה היא מעצמות אוא\"ס ממש."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה ידוע40"
        },
        {
          "s": 2,
          "text": "שבר\"ה שני ענינים."
        },
        {
          "s": 3,
          "text": "עיקר ענין ר\"ה"
        },
        {
          "s": 4,
          "text": "(א' בתשרי)"
        },
        {
          "s": 5,
          "text": "הוא שביום זה נברא האדם,"
        },
        {
          "s": 6,
          "text": "ובכל שנה ביום זה מתחדש הענין דבריאת האדם,"
        },
        {
          "s": 7,
          "text": "אתם41"
        },
        {
          "s": 8,
          "text": "קרויין אדם42."
        },
        {
          "s": 9,
          "text": "ועוד ענין בר\"ה,"
        },
        {
          "s": 10,
          "text": "דכיון שהאדם הוא תכלית הבריאה,"
        },
        {
          "s": 11,
          "text": "לכן,"
        },
        {
          "s": 12,
          "text": "בכל שנה,"
        },
        {
          "s": 13,
          "text": "ביום בריאת האדם,"
        },
        {
          "s": 14,
          "text": "מתחדשת גם כללות הבריאה שנבראה בכ\"ה באלול43."
        },
        {
          "s": 15,
          "text": "וי\"ל דזהו מ\"ש זה היום תחלת מעשיך זכרון ליום ראשון,"
        },
        {
          "s": 16,
          "text": "דזה היום תחלת מעשיך קאי על האדם44"
        },
        {
          "s": 17,
          "text": "(עיקר מעשיך)"
        },
        {
          "s": 18,
          "text": "שנברא ביום זה עצמו,"
        },
        {
          "s": 19,
          "text": "וזכרון ליום ראשון הוא שבר\"ה הוא זכרון ליום ראשון דהבריאה"
        },
        {
          "s": 20,
          "text": "(כ\"ה באלול)"
        },
        {
          "s": 21,
          "text": "שבו נברא העולם."
        },
        {
          "s": 22,
          "text": "וזה שבר\"ה הוא בנין המלכות הוא בשביל ב' הענינים."
        },
        {
          "s": 23,
          "text": "בכדי שע\"י המלכות יתהוו העולמות מחדש"
        },
        {
          "s": 24,
          "text": "(כנ\"ל סעיף ג),"
        },
        {
          "s": 25,
          "text": "ועיקר ענין בנין המלכות הוא בשביל תולדת הנשמות"
        },
        {
          "s": 26,
          "text": "(בריאת האדם),"
        },
        {
          "s": 27,
          "text": "דנשמות ומלכות הם ענין אחד45"
        },
        {
          "s": 28,
          "text": "כמובן גם מזה שהמלכות נקראת כנסת ישראל."
        }
      ]
    }
  ]
}