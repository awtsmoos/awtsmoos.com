{
  "globalIndex": 617,
  "owner": 17,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917334_theRebbe_880__p006",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917334_theRebbe_880__p006",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917334_theRebbe_880",
  "title": "מאמר ואתה תצוה תשמ\"א",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "ויש לומר,"
        },
        {
          "s": 3,
          "text": "שבחינת המאור דהנשמה המתגלית ע\"י הענין דכתית מזה שנמצאים בגלות,"
        },
        {
          "s": 4,
          "text": "היא נעלית יותר מבחינת המאור דהנשמה שמתגלית ע\"י מס\"נ."
        },
        {
          "s": 5,
          "text": "והענין הוא,"
        },
        {
          "s": 6,
          "text": "דמהטעמים על זה שבמתן תורה היתה רק ההתחלה"
        },
        {
          "s": 7,
          "text": "(החלו לעשות)"
        },
        {
          "s": 8,
          "text": "ובימי אחשורוש היתה הקבלה"
        },
        {
          "s": 9,
          "text": "(וקבל היהודים)"
        },
        {
          "s": 10,
          "text": "הוא,"
        },
        {
          "s": 11,
          "text": "כי זה שהקדימו נעשה לנשמע במתן תורה הי' מפני שכפה עליהם הר כגיגית52,"
        },
        {
          "s": 12,
          "text": "גילוי מלמעלה53,"
        },
        {
          "s": 13,
          "text": "ובימי אחשורוש היתה הקבלה מצד עצמם."
        },
        {
          "s": 14,
          "text": "ויש לומר,"
        },
        {
          "s": 15,
          "text": "שהאמונה דישראל מצד זה שהנשמה שלמעלה רואה אלקות"
        },
        {
          "s": 16,
          "text": "(אמונה שמצד סיבה)"
        },
        {
          "s": 17,
          "text": "הוא ע\"ד שהקדימו נעשה לנשמע"
        },
        {
          "s": 18,
          "text": "(במ\"ת)"
        },
        {
          "s": 19,
          "text": "מצד הגילוי דלמעלה54,"
        },
        {
          "s": 20,
          "text": "וזה שבימי אחשורוש היתה הקבלה מצד עצמם,"
        },
        {
          "s": 21,
          "text": "הוא,"
        },
        {
          "s": 22,
          "text": "כי אז נתגלה ההתקשרות באלקות שמצד עצם הנשמה,"
        },
        {
          "s": 23,
          "text": "התקשרות עצמית שמצד עצם מציאותם."
        },
        {
          "s": 24,
          "text": "ובפרטיות יותר יש לומר,"
        },
        {
          "s": 25,
          "text": "שגם בגילוי עצם הנשמה,"
        },
        {
          "s": 26,
          "text": "ישנם"
        },
        {
          "s": 27,
          "text": "(דוגמת)"
        },
        {
          "s": 28,
          "text": "שני ענינים הנ\"ל."
        },
        {
          "s": 29,
          "text": "דגילוי עצם הנשמה בענין המס\"נ,"
        },
        {
          "s": 30,
          "text": "יש לומר,"
        },
        {
          "s": 31,
          "text": "שבנוגע לכחות הגלויים הוא כמו דבר נוסף."
        },
        {
          "s": 32,
          "text": "וכמו שרואים בפועל בכמה אנשים,"
        },
        {
          "s": 33,
          "text": "שבהיותם במקום שהיו שם גזירות על תומ\"צ,"
        },
        {
          "s": 34,
          "text": "הי' להם מס\"נ בפועל משך כו\"כ שנים,"
        },
        {
          "s": 35,
          "text": "וכשבאו אח\"כ למדינות שאפשר לעסוק בתומ\"צ מתוך הרחבה,"
        },
        {
          "s": 36,
          "text": "אין ניכר בהם"
        },
        {
          "s": 37,
          "text": "(כ\"כ)"
        },
        {
          "s": 38,
          "text": "המס\"נ שהי' להם מקודם."
        },
        {
          "s": 39,
          "text": "כי זה שעמדו במס\"נ משך כו\"כ שנים הוא לפי שהאיר בהם גילוי עצם הנשמה שלמעלה מכחות הגלויים ולא נעשה עי\"ז שינוי בכחות הגלויים עצמם55."
        },
        {
          "s": 40,
          "text": "[דזה שעצם הנשמה היא העצם"
        },
        {
          "s": 41,
          "text": "(גם)"
        },
        {
          "s": 42,
          "text": "דכחות הגלויים"
        },
        {
          "s": 43,
          "text": "(כנ\"ל סעיף ה),"
        },
        {
          "s": 44,
          "text": "הוא,"
        },
        {
          "s": 45,
          "text": "שעצם הנשמה הוא העצם שלהם ואין זה שייך לענינם של כחות הגלויים עצמם,"
        },
        {
          "s": 46,
          "text": "להציור שלהם]."
        },
        {
          "s": 47,
          "text": "והגילוי דעצם הנשמה בזה שהוא נשבר ונדכא מזה שהוא נמצא בגלות הוא שגם כחות הגלויים שלו"
        },
        {
          "s": 48,
          "text": "(הציור דכחות הגלויים)"
        },
        {
          "s": 49,
          "text": "הם כמו חד עם העצם56."
        },
        {
          "s": 50,
          "text": "ויש לומר,"
        },
        {
          "s": 51,
          "text": "דזה שעצם הנשמה והציור דהכחות הם"
        },
        {
          "s": 52,
          "text": "(דוגמת)"
        },
        {
          "s": 53,
          "text": "שני ענינים,"
        },
        {
          "s": 54,
          "text": "הוא לפי שגם עצם הנשמה היא מוגדרת בגדר,"
        },
        {
          "s": 55,
          "text": "והגדר שלה היא למעלה מהציור דהכחות."
        },
        {
          "s": 56,
          "text": "אבל מצד עצם הנשמה כמו שהיא מושרשת בהעצמות,"
        },
        {
          "s": 57,
          "text": "הפשיטות דהנשמה והציור דהכחות שלה הם כולא חד57."
        },
        {
          "s": 58,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 59,
          "text": "דבחינת המאור דהנשמה שמתגלית ע\"י מס\"נ היא עצם הנשמה כמו שהיא מוגדרת בענין הפשיטות שלמעלה מציור דכחות,"
        },
        {
          "s": 60,
          "text": "ובחינת המאור דהנשמה שמתגלית ע\"י הענין דכתית מזה שנמצאים בגלות,"
        },
        {
          "s": 61,
          "text": "הוא גילוי עצם הנשמה כמו שהיא מושרשת בהעצמות."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "ויש לקשר זה עם המבואר בהמאמר58"
        },
        {
          "s": 3,
          "text": "בפי' הכתוב ואתה תצוה את בני ישראל ויקחו אליך שמן זית גו',"
        },
        {
          "s": 4,
          "text": "דלאחרי שמשה יצַוה ויקשר את בני ישראל אזי יביאו ישראל למשה שמן זית גו',"
        },
        {
          "s": 5,
          "text": "שישראל ע\"י עבודתם יוסיפו גילוי אור במדריגת משה."
        },
        {
          "s": 6,
          "text": "ויש לומר מהביאורים בזה בעבודת האדם,"
        },
        {
          "s": 7,
          "text": "דזה שמשה מצוה ומקשר את בני ישראל,"
        },
        {
          "s": 8,
          "text": "הוא,"
        },
        {
          "s": 9,
          "text": "שהוא זן ומפרנס את האמונה,"
        },
        {
          "s": 10,
          "text": "שהאמונה תהי' נוסף על כמו שהיא מצד הגילויים דהנשמה"
        },
        {
          "s": 11,
          "text": "(מצד זה שהנשמה שלמעלה רואה אלקות)"
        },
        {
          "s": 12,
          "text": "גם מצד עצם הנשמה."
        },
        {
          "s": 13,
          "text": "[ויש לומר,"
        },
        {
          "s": 14,
          "text": "דזהו מ\"ש ואתה תצוה את בני ישראל,"
        },
        {
          "s": 15,
          "text": "דלשון ואתה תצוה את בני ישראל משמע שמשה מצַוה"
        },
        {
          "s": 16,
          "text": "(מקשר ומחבר)"
        },
        {
          "s": 17,
          "text": "את בני ישראל עצמם,"
        },
        {
          "s": 18,
          "text": "כי מצד עצם הנשמה,"
        },
        {
          "s": 19,
          "text": "כל ישראל הם חד59]."
        },
        {
          "s": 20,
          "text": "וע\"י העבודה דישראל"
        },
        {
          "s": 21,
          "text": "(לאחרי שנמשך בישראל גילוי עצם הנשמה ע\"י משה),"
        },
        {
          "s": 22,
          "text": "שגם כחות הגלויים שלהם"
        },
        {
          "s": 23,
          "text": "(הציור דהכחות)"
        },
        {
          "s": 24,
          "text": "יהיו מתאימים לעצם הנשמה,"
        },
        {
          "s": 25,
          "text": "עי\"ז נעשה יתרון והוספה בבחינת עצם הנשמה שנמשכה ונתגלתה בהם ע\"י משה"
        },
        {
          "s": 26,
          "text": "(ויקחו אליך),"
        },
        {
          "s": 27,
          "text": "כי עי\"ז מתגלה בה שרשה האמיתי כמו שהיא מושרשת בהעצמות."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "[ולהעיר,"
        },
        {
          "s": 1,
          "text": "שעי\"ז ניתוסף גם בהאחדות דישראל."
        },
        {
          "s": 2,
          "text": "שהאחדות דישראל ע\"י עצם הנשמה שמתגלית בהם היא כמו דבר נוסף על מציאותם."
        },
        {
          "s": 3,
          "text": "ולכן,"
        },
        {
          "s": 4,
          "text": "אחדות זו היא ע\"י שעושים נפשם עיקר וגופם טפל60."
        },
        {
          "s": 5,
          "text": "וע\"י גילוי עצם הנשמה כמו שהיא מושרשת בהעצמות,"
        },
        {
          "s": 6,
          "text": "שעי\"ז גם הציור דכחות הגלויים הוא חד עם העצם,"
        },
        {
          "s": 7,
          "text": "האחדות דישראל היא בכל הענינים שלהם,"
        },
        {
          "s": 8,
          "text": "גם בענינים השייכים להגוף]."
        }
      ]
    }
  ]
}