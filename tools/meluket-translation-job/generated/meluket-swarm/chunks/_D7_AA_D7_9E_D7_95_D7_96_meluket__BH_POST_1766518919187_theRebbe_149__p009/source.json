{
  "globalIndex": 915,
  "owner": 15,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919187_theRebbe_149__p009",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919187_theRebbe_149__p009",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919187_theRebbe_149",
  "title": "מאמר וידבר זאת חוקת תשכ\"ט",
  "part": 9,
  "sections": [
    {
      "v": 24,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ד)"
        },
        {
          "s": 2,
          "text": "וזהו וידבר ה' אל משה גו' דבר אל בני ישראל ויקחו אליך פרה אדומה גו',"
        },
        {
          "s": 3,
          "text": "דזה שהפרה נקראת על שמו של משה – הגם שענין המיוחד שבמצות פרה אדומה הוא שהחוקה שבה"
        },
        {
          "s": 4,
          "text": "(רצון שלמעלה מחכמה)"
        },
        {
          "s": 5,
          "text": "הוא בגילוי,"
        },
        {
          "s": 6,
          "text": "וכיון שמשה ידע טעם פרה הרי לגבי' אין חילוק בין מצות פרה אדומה לכל המצוות – כי ע\"י שמצות פרה אדומה היא חוקה לגבי ישראל,"
        },
        {
          "s": 7,
          "text": "היא חוקה גם לגבי משה."
        },
        {
          "s": 8,
          "text": "וזהו דבר אל בני ישראל ויקחו אליך גו',"
        },
        {
          "s": 9,
          "text": "דע\"י דבר אל בני ישראל – עי\"ז הוא ויקחו אליך,"
        },
        {
          "s": 10,
          "text": "הענין דזאת חוקת התורה בנוגע למשה."
        },
        {
          "s": 11,
          "text": "אלא שענין זה"
        },
        {
          "s": 12,
          "text": "(שמישראל נמשך למשה)"
        },
        {
          "s": 13,
          "text": "הוא בנוגע להמצוה עצמה,"
        },
        {
          "s": 14,
          "text": "דזה שהיא חוקה"
        },
        {
          "s": 15,
          "text": "(בלי טעם)"
        },
        {
          "s": 16,
          "text": "הוא בעיקר בישראל."
        },
        {
          "s": 17,
          "text": "אבל בנוגע לקיום המצוה,"
        },
        {
          "s": 18,
          "text": "בכדי שישראל יוכלו לקיים המצוה דפרה אדומה ועד\"ז כל המצוות בביטול דקבלת עול"
        },
        {
          "s": 19,
          "text": "(באופן דחוקה חקקתי גזירה גזרתי),"
        },
        {
          "s": 20,
          "text": "הנתינת כח על זה הוא ממשה,"
        },
        {
          "s": 21,
          "text": "שענינו הוא ביטול,"
        },
        {
          "s": 22,
          "text": "ונחנו מה."
        },
        {
          "s": 23,
          "text": "ויש לומר,"
        },
        {
          "s": 24,
          "text": "דע\"י שמשה ידע טעם פרה,"
        },
        {
          "s": 25,
          "text": "והביטול דקבלת עול נמשך גם בההשגה שלו,"
        },
        {
          "s": 26,
          "text": "ניתן הכח לכל אחד מישראל שהאמונה והקבלת עול יונח"
        },
        {
          "s": 27,
          "text": "(זאָל זיך אָפּלייגן)"
        },
        {
          "s": 28,
          "text": "גם בהשכל שלו."
        }
      ]
    },
    {
      "v": 25,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דזהו שארז\"ל חוקה20"
        },
        {
          "s": 2,
          "text": "חקקתי גזירה גזרתי ואין לך רשות להרהר אחרי'73,"
        },
        {
          "s": 3,
          "text": "שהקבלת עול שלו היא באופן שלא רק שהוא מקיים בפועל ציווי הקב\"ה"
        },
        {
          "s": 4,
          "text": "(גם כשאינו מבין),"
        },
        {
          "s": 5,
          "text": "אלא שאינו מהרהר כלל,"
        },
        {
          "s": 6,
          "text": "כי גם בשכלו מונח הענין דקבלת עול."
        },
        {
          "s": 7,
          "text": "ויש לקשר זה עם מאמר המדרש74"
        },
        {
          "s": 8,
          "text": "שפרה אדומה רומזת על הגלויות,"
        },
        {
          "s": 9,
          "text": "פרה זו מצרים אדומה זו בבל תמימה זו מדי אשר אין בה מום זה יון,"
        },
        {
          "s": 10,
          "text": "כי ע\"י זה שהשכל הוא באופן שמונח אצלו הענין דקבלת עול שלמעלה מהשכל,"
        },
        {
          "s": 11,
          "text": "הוא הכנה קרובה לגאולה העתידה,"
        },
        {
          "s": 12,
          "text": "שהגילוי אלקות בעולם יהי' גם מצד העולם."
        },
        {
          "s": 13,
          "text": "וזוהי השייכות דזאת חוקת התורה לשריפת הפרה,"
        },
        {
          "s": 14,
          "text": "דע\"י שהקבלת עול הוא באופן שאינו מהרהר,"
        },
        {
          "s": 15,
          "text": "כי גם בשכלו מונח הענין דקבלת עול,"
        },
        {
          "s": 16,
          "text": "נעשה שריפת"
        },
        {
          "s": 17,
          "text": "(הפרה שרומזת על)"
        },
        {
          "s": 18,
          "text": "הגלות,"
        },
        {
          "s": 19,
          "text": "כפתגם הידוע דבעל הגאולה75,"
        },
        {
          "s": 20,
          "text": "והולכים כולנו יחד עם נשיאינו בעל הגאולה בראשנו להגאולה האמיתית והשלימה בביאת משיח צדקנו,"
        },
        {
          "s": 21,
          "text": "בקרוב ממש."
        }
      ]
    }
  ]
}