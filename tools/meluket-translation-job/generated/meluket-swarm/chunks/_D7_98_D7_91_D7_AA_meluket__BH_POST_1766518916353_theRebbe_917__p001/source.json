{
  "globalIndex": 453,
  "owner": 3,
  "jobId": "_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916353_theRebbe_917__p001",
  "batchId": "meluket-_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916353_theRebbe_917__p001",
  "seriesId": "טבת_meluket",
  "postId": "BH_POST_1766518916353_theRebbe_917",
  "title": "מאמר ואלה שמות תשל\"ז",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ שמות,"
        },
        {
          "s": 2,
          "text": "כ\"ה טבת,"
        },
        {
          "s": 3,
          "text": "מבה\"ח שבט,"
        },
        {
          "s": 4,
          "text": "ה'תשל\"ז*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "(הנחה בלתי מוגה)"
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ואלה שמות בני ישראל הבאים מצרימה גו' ראובן שמעון לוי ויהודה גו'1."
        },
        {
          "s": 1,
          "text": "וידוע דיוק בעל ההילולא"
        },
        {
          "s": 2,
          "text": "[דכ\"ד טבת – כ\"ק אדמו\"ר הזקן]"
        },
        {
          "s": 3,
          "text": "בספרו תורה אור בד\"ה זה2,"
        },
        {
          "s": 4,
          "text": "דבפרשת ויגש3"
        },
        {
          "s": 5,
          "text": "נאמר ג\"כ ואלה שמות בני ישראל הבאים מצרימה גו',"
        },
        {
          "s": 6,
          "text": "וצריך להבין למה הוכפל בתורה ענין בואם מצרימה."
        },
        {
          "s": 7,
          "text": "וכ\"ק אדמו\"ר האמצעי מוסיף עוד"
        },
        {
          "s": 8,
          "text": "[בד\"ה זה שבתורת חיים4,"
        },
        {
          "s": 9,
          "text": "שהוא ביאור על מאמר הנ\"ל מכ\"ק אדמו\"ר הזקן וביאורו5]"
        },
        {
          "s": 10,
          "text": "דידוע6"
        },
        {
          "s": 11,
          "text": "שהתורה היא נצחית ומדברת בכל זמן ובכל דור,"
        },
        {
          "s": 12,
          "text": "דהיינו שגם ענין הביאה למצרים וכו' ישנו בכל דור,"
        },
        {
          "s": 13,
          "text": "וכן ישנה הוראה מזה לכאו\"א מישראל בכל זמן ובכל מקום,"
        },
        {
          "s": 14,
          "text": "דתורה היא מלשון הוראה7,"
        },
        {
          "s": 15,
          "text": "וא\"כ ההוראה היא נצחית."
        },
        {
          "s": 16,
          "text": "והנה,"
        },
        {
          "s": 17,
          "text": "כיון שהתורה היא נצחית מובן שגם פרטי הענינים דגלות מצרים וכו' ישנם בכל דור,"
        },
        {
          "s": 18,
          "text": "ולכן גם פרטי הענינים דוימררו את חייהם בעבודה קשה ובלבנים גו' את כל עבודתם אשר עבדו בהם בפרך8,"
        },
        {
          "s": 19,
          "text": "ישנם ג\"כ בכל הזמנים."
        },
        {
          "s": 20,
          "text": "ואין הכוונה בהענין דוימררו את חייהם גו' בשביל עצמו ח\"ו,"
        },
        {
          "s": 21,
          "text": "כ\"א זה שישנו ענין זה הוא רק בשביל הגאולה וכו' שלאח\"ז."
        },
        {
          "s": 22,
          "text": "וכמ\"ש9"
        },
        {
          "s": 23,
          "text": "אנכי ארד עמך מצרימה ואנכי אעלך גם עלה גו',"
        },
        {
          "s": 24,
          "text": "והיינו דכל הכוונה בהירידה למצרים וכו' הוא רק בשביל שיהי' אח\"כ ואנכי אעלך גם עלה."
        }
      ]
    }
  ]
}