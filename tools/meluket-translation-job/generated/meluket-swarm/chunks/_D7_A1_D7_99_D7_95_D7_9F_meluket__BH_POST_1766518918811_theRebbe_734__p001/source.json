{
  "globalIndex": 850,
  "owner": 0,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918811_theRebbe_734__p001",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918811_theRebbe_734__p001",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918811_theRebbe_734",
  "title": "מאמר ביום השני הקריב תשל\"ב",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ נשא,"
        },
        {
          "s": 2,
          "text": "י\"ד סיון ה'תשל\"ב"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "ביום השני הקריב נתנאל בן צוער נשיא יששכר הקריב את קרבנו גו'1,"
        },
        {
          "s": 1,
          "text": "ופרש\"י מהו הקריב הקריב ב' פעמים שבשביל שני דברים זכה להקריב שני לשבטים,"
        },
        {
          "s": 2,
          "text": "אחת שהיו יודעים בתורה שנאמר2"
        },
        {
          "s": 3,
          "text": "ומבני יששכר יודעי בינה לעתים ואחת שהם נתנו עצה לנשיאים להתנדב קרבנות הללו,"
        },
        {
          "s": 4,
          "text": "וצריך להבין,"
        },
        {
          "s": 5,
          "text": "דמצד שני טעמים אלו הי' ראוי לכאורה שיקריב ראשון לשבטים."
        },
        {
          "s": 6,
          "text": "וביותר אינו מובן,"
        },
        {
          "s": 7,
          "text": "דאיתא במדרש3,"
        },
        {
          "s": 8,
          "text": "למה נאמר בו הקריב כו' לפי שזכה בעצת נשיאים העלה עליו הכתוב כאילו הוא הקריב תחלה."
        },
        {
          "s": 9,
          "text": "ועפ\"ז צריך להבין עוד יותר הטעם על זה שבפועל הקריב יהודה תחלה ויששכר הקריב ביום השני."
        },
        {
          "s": 10,
          "text": "גם צריך להבין מ\"ש נתנאל בן צוער נשיא יששכר,"
        },
        {
          "s": 11,
          "text": "שמקדים את שמו"
        },
        {
          "s": 12,
          "text": "(נתנאל בן צוער)"
        },
        {
          "s": 13,
          "text": "לפני שאומר שהי' נשיא יששכר,"
        },
        {
          "s": 14,
          "text": "דלכאורה,"
        },
        {
          "s": 15,
          "text": "מכיון דזה שהקריב את קרבנו הוא לפי שהי' נשיא יששכר,"
        },
        {
          "s": 16,
          "text": "הי' צריך לומר נשיא יששכר"
        },
        {
          "s": 17,
          "text": "(ואח\"כ)"
        },
        {
          "s": 18,
          "text": "נתנאל בן צוער,"
        },
        {
          "s": 19,
          "text": "וכמ\"ש גבי שאר הנשיאים שהקריבו לאחרי יום השני שבתחלה נאמר נשיא לבני גו' ואח\"כ נאמר שמו של הנשיא4."
        },
        {
          "s": 20,
          "text": "וכן בהנשיא שהקריב ביום הראשון נאמר5"
        },
        {
          "s": 21,
          "text": "נחשון בן עמינדב למטה יהודה,"
        },
        {
          "s": 22,
          "text": "בתחלה נחשון בן עמינדב ואח\"כ למטה יהודה6."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויש לבאר ע\"פ מה שאיתא במדרש7"
        },
        {
          "s": 2,
          "text": "עה\"פ נחשון בן עמינדב למטה יהודה,"
        },
        {
          "s": 3,
          "text": "למה נקרא שמו נחשון על שם שירד תחלה לנחשול שבים כו' מי שקידש את שמי בים הוא יקריב תחלה."
        },
        {
          "s": 4,
          "text": "ויש לומר,"
        },
        {
          "s": 5,
          "text": "דזה שמדייק במדרש למה נקרא שמו נחשון"
        },
        {
          "s": 6,
          "text": "(שאינו מדייק כן בשאר הנשיאים),"
        },
        {
          "s": 7,
          "text": "הוא,"
        },
        {
          "s": 8,
          "text": "כי מלשון הכתוב נחשון בן עמינדב למטה יהודה"
        },
        {
          "s": 9,
          "text": "(ולא נשיא יהודה)"
        },
        {
          "s": 10,
          "text": "משמע דזה שהוא הי' המקריב ביום הראשון הוא"
        },
        {
          "s": 11,
          "text": "(לא רק מפני המעלה דשבט יהודה,"
        },
        {
          "s": 12,
          "text": "אלא גם)"
        },
        {
          "s": 13,
          "text": "מצד מעלת עצמו8,"
        },
        {
          "s": 14,
          "text": "וכיון ששמו של אדם רומז על ענינו9"
        },
        {
          "s": 15,
          "text": "(ומעלתו),"
        },
        {
          "s": 16,
          "text": "לכן מדייק למה נקרא שמו נחשון."
        },
        {
          "s": 17,
          "text": "ומבאר דמעלתו של נחשון"
        },
        {
          "s": 18,
          "text": "(המרומזת בשמו)"
        },
        {
          "s": 19,
          "text": "היא שקידש את שמי"
        },
        {
          "s": 20,
          "text": "(של הקב\"ה)"
        },
        {
          "s": 21,
          "text": "ולכן הקריב תחלה."
        },
        {
          "s": 22,
          "text": "ויש לומר עד\"ז בנוגע נתנאל בן צוער נשיא יששכר,"
        },
        {
          "s": 23,
          "text": "שהכתוב מקדים נתנאל בן צוער לפני נשיא יששכר,"
        },
        {
          "s": 24,
          "text": "הוא,"
        },
        {
          "s": 25,
          "text": "לרמז,"
        },
        {
          "s": 26,
          "text": "דזה שהקריב ביום השני"
        },
        {
          "s": 27,
          "text": "(מיד לאחרי יהודה),"
        },
        {
          "s": 28,
          "text": "ויתירה מזה שהעלה עליו הכתוב כאילו הוא הקריב תחלה"
        },
        {
          "s": 29,
          "text": "(לפני יהודה),"
        },
        {
          "s": 30,
          "text": "הוא מפני המעלה שבו המרומזת בשמו."
        },
        {
          "s": 31,
          "text": "והגם שנאמר בו נשיא יששכר"
        },
        {
          "s": 32,
          "text": "[דלא כנחשון שנאמר בו למטה יהודה]"
        },
        {
          "s": 33,
          "text": "שמזה מוכח דזה שהקריב ביום השני"
        },
        {
          "s": 34,
          "text": "[וגם זה שהעלה עליו הכתוב כאילו הוא הקריב תחלה]"
        },
        {
          "s": 35,
          "text": "הוא מצד המעלה דשבט יששכר,"
        },
        {
          "s": 36,
          "text": "מ\"מ נאמר נתנאל בן צוער לפני נשיא יששכר,"
        },
        {
          "s": 37,
          "text": "כי מעלה זו דשבט יששכר"
        },
        {
          "s": 38,
          "text": "[שבשבילה הקריב ביום השני וכאילו הוא הקריב תחלה]"
        },
        {
          "s": 39,
          "text": "מרומזת בהשם נתנאל בן צוער."
        }
      ]
    }
  ]
}