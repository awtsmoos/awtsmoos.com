{
  "globalIndex": 651,
  "owner": 1,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917575_theRebbe_481__p004",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917575_theRebbe_481__p004",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917575_theRebbe_481",
  "title": "מאמר אלה פקודי תש\"ל",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "והנה גם בתשובה עצמה ישנם שני הענינים דמדות ומוחין"
        },
        {
          "s": 1,
          "text": "(משכן סתם ומשכן העדות),"
        },
        {
          "s": 2,
          "text": "דתשובה תתאה,"
        },
        {
          "s": 3,
          "text": "תשוב ה' תתאה"
        },
        {
          "s": 4,
          "text": "(להוא\"ו46),"
        },
        {
          "s": 5,
          "text": "היא במדות,"
        },
        {
          "s": 6,
          "text": "ותשובה עילאה,"
        },
        {
          "s": 7,
          "text": "תשוב ה' עילאה"
        },
        {
          "s": 8,
          "text": "(להיו\"ד46),"
        },
        {
          "s": 9,
          "text": "היא במוחין."
        },
        {
          "s": 10,
          "text": "ויש לומר הביאור בזה בעבודת האדם,"
        },
        {
          "s": 11,
          "text": "דתשובה תתאה היא בעיקר בנוגע להעבודה דתומ\"צ"
        },
        {
          "s": 12,
          "text": "(סור מרע ועשה טוב)47,"
        },
        {
          "s": 13,
          "text": "היינו שהדילוג שבתשובה תתאה הוא בנוגע להמציאות שלו48,"
        },
        {
          "s": 14,
          "text": "ולכן היא נכללת בבחינת המדות"
        },
        {
          "s": 15,
          "text": "(מציאות),"
        },
        {
          "s": 16,
          "text": "ותשובה עילאה היא להשיב את נפשו למקורה כמו שהיתה מיוחדת בו ית' בתכלית היחוד בטרם שנפחה49,"
        },
        {
          "s": 17,
          "text": "שעי\"ז הוא יוצא ומתבטל ממציאותו,"
        },
        {
          "s": 18,
          "text": "ולכן היא במוחין,"
        },
        {
          "s": 19,
          "text": "בינה."
        },
        {
          "s": 20,
          "text": "ועפ\"ז,"
        },
        {
          "s": 21,
          "text": "שני הענינים שבמשכן הם גם בתשובה עצמה."
        },
        {
          "s": 22,
          "text": "משכן סתם הוא תשובה תתאה ומשכן העדות הוא תשובה עילאה."
        },
        {
          "s": 23,
          "text": "והביאור דשני הפירושים באשר פוקד על פי משה יש לומר,"
        },
        {
          "s": 24,
          "text": "שעיקר הענין דפוקד ע\"פ משה"
        },
        {
          "s": 25,
          "text": "(ביטול במציאות)"
        },
        {
          "s": 26,
          "text": "הוא בתשובה עילאה,"
        },
        {
          "s": 27,
          "text": "משכן העדות."
        },
        {
          "s": 28,
          "text": "אלא שמ\"מ שייך זה גם לאלה פקודי המשכן,"
        },
        {
          "s": 29,
          "text": "כי ע\"י תשובה עילאה,"
        },
        {
          "s": 30,
          "text": "גם התשובה תתאה היא באופן נעלה יותר50."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יש לבאר מ\"ש בלקו\"ת בפירוש הכתוב אלה פקודי המשכן,"
        },
        {
          "s": 2,
          "text": "דפקודי הוא"
        },
        {
          "s": 3,
          "text": "(גם)"
        },
        {
          "s": 4,
          "text": "מלשון פקידה ויחוד,"
        },
        {
          "s": 5,
          "text": "כמו חייב אדם לפקוד את אשתו51."
        },
        {
          "s": 6,
          "text": "ומבואר במק\"א52"
        },
        {
          "s": 7,
          "text": "בענין שארה כסותה ועונתה,"
        },
        {
          "s": 8,
          "text": "דשארה"
        },
        {
          "s": 9,
          "text": "(מזון)"
        },
        {
          "s": 10,
          "text": "הוא המשכה שמתלבשת בכלי המקבל,"
        },
        {
          "s": 11,
          "text": "כסותה"
        },
        {
          "s": 12,
          "text": "(לבוש)"
        },
        {
          "s": 13,
          "text": "הוא ההמשכה שבבחינת מקיף שלמעלה מפנימיות,"
        },
        {
          "s": 14,
          "text": "ועונתה הוא המשכת העצם שלמעלה גם מהמקיף דלבוש."
        },
        {
          "s": 15,
          "text": "ולהוסיף,"
        },
        {
          "s": 16,
          "text": "שהמעלה דעונתה היא לא רק בנוגע לההמשכה דלמעלה"
        },
        {
          "s": 17,
          "text": "(שעונתה הוא המשכת העצם)"
        },
        {
          "s": 18,
          "text": "אלא גם בנוגע לישראל,"
        },
        {
          "s": 19,
          "text": "שהם מקבלים המשכה זו שלא ע\"י לבוש."
        },
        {
          "s": 20,
          "text": "ויש לומר דזהו שארז\"ל53"
        },
        {
          "s": 21,
          "text": "האומר כו' אני בבגדי והיא בבגדה יוציא ויתן כתובה,"
        },
        {
          "s": 22,
          "text": "דשלילת אני בבגדי הוא שההמשכה דלמעלה היא בלי לבוש,"
        },
        {
          "s": 23,
          "text": "ושלילת היא בבגדה הוא שקבלת הגילוי הוא שלא ע\"י לבוש."
        },
        {
          "s": 24,
          "text": "וצריך להבין,"
        },
        {
          "s": 25,
          "text": "דפירוש זה"
        },
        {
          "s": 26,
          "text": "(שבלקו\"ת)"
        },
        {
          "s": 27,
          "text": "באלה פקודי המשכן"
        },
        {
          "s": 28,
          "text": "(שפקודי הוא מלשון פקידה ויחוד)"
        },
        {
          "s": 29,
          "text": "בא בהמשך להמבואר שם שמשכן העדות הוא ההמשכה"
        },
        {
          "s": 30,
          "text": "(שע\"י מל\"ת)"
        },
        {
          "s": 31,
          "text": "שלמעלה מהתלבשות בכלים,"
        },
        {
          "s": 32,
          "text": "ופקודי המשכן הוא ההמשכה"
        },
        {
          "s": 33,
          "text": "(שע\"י מ\"ע)"
        },
        {
          "s": 34,
          "text": "שמתלבשת בכלים"
        },
        {
          "s": 35,
          "text": "(בחינת שארה שלמטה גם מבחינת כסותה),"
        },
        {
          "s": 36,
          "text": "ואעפ\"כ נאמר בה אלה פקודי המשכן מלשון פקידה ויחוד."
        },
        {
          "s": 37,
          "text": "גם צריך להבין הקשר דפירוש רש\"י שמשכן משכן שני פעמים הוא רמז למקדש שנתמשכן בשני חורבנין על עונותיהן של ישראל עם הפירוש בלקו\"ת שהמשכן משכן שני פעמים הם המשכות נעלות ביותר"
        },
        {
          "s": 38,
          "text": "(המשכה שע\"י מ\"ע והמשכה שע\"י מל\"ת),"
        },
        {
          "s": 39,
          "text": "ועד לפקודי המשכן,"
        },
        {
          "s": 40,
          "text": "פקודי מלשון פקידה ויחוד."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 1,
          "text": "שע\"י המשכן שהי' כפרה על חטא העגל,"
        },
        {
          "s": 2,
          "text": "נתגלה,"
        },
        {
          "s": 3,
          "text": "שהכוונה"
        },
        {
          "s": 4,
          "text": "(דלמעלה)"
        },
        {
          "s": 5,
          "text": "במעשה העגל מלכתחילה היתה בכדי שעי\"ז יגיעו למעלת התשובה."
        },
        {
          "s": 6,
          "text": "ועד\"ז הוא בנוגע לזה שהמקדש שנתמשכן שני פעמים ע\"י עונותיהן של ישראל,"
        },
        {
          "s": 7,
          "text": "שהכוונה בזה היא בכדי שיגיעו למעלת התשובה,"
        },
        {
          "s": 8,
          "text": "ועי\"ז יוחזר אח\"כ המשכון לישראל באופן נעלה יותר מכמו שהי' קודם החורבן."
        },
        {
          "s": 9,
          "text": "והנה מהמעלות שבתשובה לגבי העבודה דקיום התומ\"צ הוא,"
        },
        {
          "s": 10,
          "text": "דזה שישראל עושה תשובה גם לאחרי ההבדלה שנעשה ע\"י החטאים"
        },
        {
          "s": 11,
          "text": "(עונותיכם מבדילים54)"
        },
        {
          "s": 12,
          "text": "הוא לפי שהתשובה באה מעצם הנשמה שהיא מקושרת תמיד עם העצמות."
        },
        {
          "s": 13,
          "text": "וכיון שעצם הנשמה היא ה\"עצם\""
        },
        {
          "s": 14,
          "text": "(גם)"
        },
        {
          "s": 15,
          "text": "דכחות הגלויים,"
        },
        {
          "s": 16,
          "text": "לכן,"
        },
        {
          "s": 17,
          "text": "ע\"י התשובה,"
        },
        {
          "s": 18,
          "text": "גם קיום התומ\"צ שמצד כחות הגלויים דהנשמה היא למעלה ממדידה והגבלה."
        },
        {
          "s": 19,
          "text": "וזהו הקשר דשני הענינים באלה פקודי המשכן,"
        },
        {
          "s": 20,
          "text": "פקודי מלשון פקידה ויחוד,"
        },
        {
          "s": 21,
          "text": "ומשכן מלשון משכון,"
        },
        {
          "s": 22,
          "text": "כי ע\"י התשובה הבאה ע\"י שנתמשכן המקדש מתגלית עצם הנשמה,"
        },
        {
          "s": 23,
          "text": "ועי\"ז גם קיום התומ\"צ היא למעלה מהגבלה,"
        },
        {
          "s": 24,
          "text": "ועד באופן דפקודי מלשון פקידה ויחוד,"
        },
        {
          "s": 25,
          "text": "ישראל וקוב\"ה כולא חד."
        }
      ]
    }
  ]
}