{
  "globalIndex": 456,
  "owner": 6,
  "jobId": "_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916353_theRebbe_917__p004",
  "batchId": "meluket-_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916353_theRebbe_917__p004",
  "seriesId": "טבת_meluket",
  "postId": "BH_POST_1766518916353_theRebbe_917",
  "title": "מאמר ואלה שמות תשל\"ז",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה בהירידה עצמה ב' מדריגות,"
        },
        {
          "s": 2,
          "text": "וע\"ד דוגמא שישנו ירידת השכל באותיות המחשבה,"
        },
        {
          "s": 3,
          "text": "ולמטה יותר מה שהשכל בא גם באותיות הדיבור47."
        },
        {
          "s": 4,
          "text": "וכמו\"כ גם בעבודה דתורה ותפלה ישנם ב' בחינות אלו."
        },
        {
          "s": 5,
          "text": "דישנו ענין מחשבת התורה וגם הדיבור שבתורה48,"
        },
        {
          "s": 6,
          "text": "וכמ\"ש49"
        },
        {
          "s": 7,
          "text": "חיים הם למוצאיהם ודרז\"ל50"
        },
        {
          "s": 8,
          "text": "למוציאיהם בפה,"
        },
        {
          "s": 9,
          "text": "ועוד יותר בכל רמ\"ח אבריו,"
        },
        {
          "s": 10,
          "text": "כמרז\"ל50"
        },
        {
          "s": 11,
          "text": "אם ערוכה ברמ\"ח אברים שלך משתמרת."
        },
        {
          "s": 12,
          "text": "ועד\"ז גם בתפלה,"
        },
        {
          "s": 13,
          "text": "דאע\"פ שתפלה היא עבודה שבלב51,"
        },
        {
          "s": 14,
          "text": "וכדאיתא בגמרא52"
        },
        {
          "s": 15,
          "text": "איזו היא עבודה שהיא בלב הוי אומר זו תפלה,"
        },
        {
          "s": 16,
          "text": "מ\"מ צ\"ל ג\"כ הדיבור דאותיות התפלה,"
        },
        {
          "s": 17,
          "text": "שעי\"ז מסירים המונעים ומעכבים."
        },
        {
          "s": 18,
          "text": "וע\"ד מה שמבאר כ\"ק אדמו\"ר הצ\"צ בספר המצוות שלו במצות וידוי תשובה53"
        },
        {
          "s": 19,
          "text": "בענין אמירת הכ\"ב אותיות בהוידוי."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "וזהו ענין הגאולה שהו\"ע ההמשכה"
        },
        {
          "s": 1,
          "text": "(דשמו הגדול)"
        },
        {
          "s": 2,
          "text": "בב' המדריגות,"
        },
        {
          "s": 3,
          "text": "בעלמין סתימין דלא אתגליין,"
        },
        {
          "s": 4,
          "text": "עלמא דאתכסיא,"
        },
        {
          "s": 5,
          "text": "שהוא בדוגמת אותיות המחשבה,"
        },
        {
          "s": 6,
          "text": "ובעלמא דאתגליא,"
        },
        {
          "s": 7,
          "text": "שהוא בדוגמא לאותיות הדיבור,"
        },
        {
          "s": 8,
          "text": "דההמשכה בהב' בחינות דעלמא דאתכסיא ועלמא דאתגליא הו\"ע מן העולם ועד העולם"
        },
        {
          "s": 9,
          "text": "[וכמבואר בתו\"א שם54]."
        },
        {
          "s": 10,
          "text": "ע\"י גואל ראשון הוא גואל אחרון55"
        },
        {
          "s": 11,
          "text": "בקרוב ממש."
        }
      ]
    }
  ]
}