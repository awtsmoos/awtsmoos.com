{
  "globalIndex": 640,
  "owner": 40,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917471_theRebbe_230__p003",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917471_theRebbe_230__p003",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917471_theRebbe_230",
  "title": "מאמר בלילה ההוא תשכ\"ה",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "[ולהעיר,"
        },
        {
          "s": 1,
          "text": "דבהדרושים הנ\"ל מבואר הענין דלילה הזה ולילה ההוא באופן אחר."
        },
        {
          "s": 2,
          "text": "דענין יום הוא שישנה ראי' באלקות או עכ\"פ השגה באלקות32,"
        },
        {
          "s": 3,
          "text": "משא\"כ כשישנה רק אמונה נק' בשם לילה."
        },
        {
          "s": 4,
          "text": "וענין לילה הזה הוא שהאמונה היא בתוקף גדול ובתכלית ההתאמתות,"
        },
        {
          "s": 5,
          "text": "בדוגמת ההתאמתות דראי'."
        },
        {
          "s": 6,
          "text": "וזהו שכתוב33"
        },
        {
          "s": 7,
          "text": "ליל שימורים גו' הוא הלילה הזה,"
        },
        {
          "s": 8,
          "text": "דהגילוי שהי' אז"
        },
        {
          "s": 9,
          "text": "(זה)"
        },
        {
          "s": 10,
          "text": "לא הי' באופן שנתבטל חושך הלילה,"
        },
        {
          "s": 11,
          "text": "שהרי עדיין היו בגלות34,"
        },
        {
          "s": 12,
          "text": "אלא שהאמונה שלהם אז היתה בוודאות גמורה,"
        },
        {
          "s": 13,
          "text": "כהוודאי דראי'."
        },
        {
          "s": 14,
          "text": "[ומבואר שם,"
        },
        {
          "s": 15,
          "text": "דזה שהגיעו לבחינת לילה הזה הוא ע\"י עבודתם במצרים בחומר ובלבנים."
        },
        {
          "s": 16,
          "text": "ועד\"ז הוא עכשיו,"
        },
        {
          "s": 17,
          "text": "שבכדי שיהי' לילה הזה,"
        },
        {
          "s": 18,
          "text": "שגם בזמן הגלות יהי' בחינת זה,"
        },
        {
          "s": 19,
          "text": "הוא ע\"י העמל והיגיעה בעסק התורה,"
        },
        {
          "s": 20,
          "text": "בחומר דא קל וחומר ובלבנים דא ליבון הלכתא35,"
        },
        {
          "s": 21,
          "text": "ועד\"ז ע\"י העמל והיגיעה בטרדות הפרנסה בזיעת אפיך תאכל לחם36,"
        },
        {
          "s": 22,
          "text": "וכמו לילה הזה דיציאת מצרים שהגיעו לזה ע\"י עבודתם בחומר ובלבנים,"
        },
        {
          "s": 23,
          "text": "חומר ולבנים כפשוטם."
        },
        {
          "s": 24,
          "text": "וזהו שאמרו37"
        },
        {
          "s": 25,
          "text": "כל המקבל עליו עול תורה מעבירין ממנו עול דרך ארץ38"
        },
        {
          "s": 26,
          "text": "וכל הפורק ממנו עול תורה נותנין עליו עול דרך ארץ,"
        },
        {
          "s": 27,
          "text": "כי גם ע\"י עול דרך ארץ מגיעים לבחינת לילה הזה]."
        },
        {
          "s": 28,
          "text": "וע\"פ פירוש זה"
        },
        {
          "s": 29,
          "text": "(שבהדרושים)"
        },
        {
          "s": 30,
          "text": "בלילה הזה,"
        },
        {
          "s": 31,
          "text": "צריך לומר,"
        },
        {
          "s": 32,
          "text": "דלילה ההוא הוא שחסר גם בוודאות האמונה."
        },
        {
          "s": 33,
          "text": "ויש לומר עוד פירוש בלילה הזה ולילה ההוא,"
        },
        {
          "s": 34,
          "text": "שהלשון זה והוא קאי על הלילה."
        },
        {
          "s": 35,
          "text": "אם הלילה הוא בגילוי"
        },
        {
          "s": 36,
          "text": "(זה)"
        },
        {
          "s": 37,
          "text": "שנרגש שהוא לילה,"
        },
        {
          "s": 38,
          "text": "או שהלילה הוא בהסתר"
        },
        {
          "s": 39,
          "text": "(הוא)"
        },
        {
          "s": 40,
          "text": "שאין נרגש שהוא לילה]."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ויובן זה ע\"פ המבואר בכ\"מ39"
        },
        {
          "s": 2,
          "text": "בפירוש המאמר40"
        },
        {
          "s": 3,
          "text": "אוא\"ס למעלה מעלה עד אין קץ ולמטה מטה עד אין תכלית,"
        },
        {
          "s": 4,
          "text": "דלמטה מטה כו' הו\"ע ההתפשטות והגילוי דאוא\"ס,"
        },
        {
          "s": 5,
          "text": "שהוא מתפשט ומתגלה עד למטה מטה,"
        },
        {
          "s": 6,
          "text": "ולמעלה מעלה כו' הו\"ע ההתעלמות והעלי' שבאוא\"ס,"
        },
        {
          "s": 7,
          "text": "שהוא מתעלה ומתעלם בהעלם אחר העלם ובעילוי אחר עילוי,"
        },
        {
          "s": 8,
          "text": "למעלה מעלה."
        },
        {
          "s": 9,
          "text": "והנה גם הענין דלמטה מטה כו' כמו שהוא באוא\"ס הוא בחי' העלם."
        },
        {
          "s": 10,
          "text": "שהרי כללות האור שלפני הצמצום הוא אור הכלול בעצמותו41,"
        },
        {
          "s": 11,
          "text": "ואור הכלול במאור הוא למעלה מגילוי42."
        },
        {
          "s": 12,
          "text": "וזה שהוא מתפשט ומתגלה עד למטה מטה,"
        },
        {
          "s": 13,
          "text": "הרי הגילוי שנמשך ממנו לאחרי הצמצום"
        },
        {
          "s": 14,
          "text": "(אור הקו,"
        },
        {
          "s": 15,
          "text": "ואפילו אור הסובב)"
        },
        {
          "s": 16,
          "text": "הוא רק הארה מהאור שלפני הצמצום."
        },
        {
          "s": 17,
          "text": "אבל מ\"מ,"
        },
        {
          "s": 18,
          "text": "כיון דזה שאוא\"ס הוא למטה מטה כו' הוא כח ההתפשטות והגילוי דאוא\"ס,"
        },
        {
          "s": 19,
          "text": "הרי גם כמו שהוא בשרשו,"
        },
        {
          "s": 20,
          "text": "הו\"ע הגילוי."
        },
        {
          "s": 21,
          "text": "וכמבואר בהמשך ההילולא43,"
        },
        {
          "s": 22,
          "text": "שבעצמותו גופא הוא בבחינת גילוי."
        },
        {
          "s": 23,
          "text": "משא\"כ זה שאוא\"ס הוא למעלה מעלה כו' הוא שגם בעצמותו אינו בגדר גילוי."
        },
        {
          "s": 24,
          "text": "ויש לומר,"
        },
        {
          "s": 25,
          "text": "שהשרש דשני הענינים דיום,"
        },
        {
          "s": 26,
          "text": "יום ההוא ויום הזה,"
        },
        {
          "s": 27,
          "text": "הוא בהענין דלמטה מטה כו'."
        },
        {
          "s": 28,
          "text": "שהגילוי בפועל"
        },
        {
          "s": 29,
          "text": "(לאחרי הצמצום)"
        },
        {
          "s": 30,
          "text": "הוא השרש דיום הזה,"
        },
        {
          "s": 31,
          "text": "וכח הגילוי דאוא\"ס"
        },
        {
          "s": 32,
          "text": "(לפני הצמצום)"
        },
        {
          "s": 33,
          "text": "הוא השרש דיום ההוא."
        },
        {
          "s": 34,
          "text": "והשרש דלילה"
        },
        {
          "s": 35,
          "text": "(שלמעלה גם מיום ההוא)"
        },
        {
          "s": 36,
          "text": "הוא בהענין דלמעלה מעלה כו'."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה ידוע דבצמצום שני ענינים."
        },
        {
          "s": 2,
          "text": "זה שהצמצום הוא בשביל הגילוי"
        },
        {
          "s": 3,
          "text": "[ובזה גופא שני ענינים."
        },
        {
          "s": 4,
          "text": "זה שע\"י הצמצום דוקא יהי' לע\"ל הגילוי דאוא\"ס גם בעולמות,"
        },
        {
          "s": 5,
          "text": "וזה שע\"י הצמצום יהי' הגילוי דפנימיות ועצמות אוא\"ס שלמעלה גם מהאור שהאיר לפני הצמצום]44,"
        },
        {
          "s": 6,
          "text": "וזה שבהצמצום עצמו מתגלה השלימות דאוא\"ס שאינו מוגבל ח\"ו בענין הגילוי ויש לו גם כח ההעלם."
        },
        {
          "s": 7,
          "text": "ויש לומר,"
        },
        {
          "s": 8,
          "text": "דזה שבצמצום ישנם שני ענינים,"
        },
        {
          "s": 9,
          "text": "הוא,"
        },
        {
          "s": 10,
          "text": "כי בכח ההעלם דאוא\"ס,"
        },
        {
          "s": 11,
          "text": "שרש הצמצום,"
        },
        {
          "s": 12,
          "text": "שתי מדריגות."
        },
        {
          "s": 13,
          "text": "כח ההעלם כמו ששייך לענין הגילוי"
        },
        {
          "s": 14,
          "text": "[שגם דרגא זו בכח ההעלם דאוא\"ס היא למעלה מכח הגילוי,"
        },
        {
          "s": 15,
          "text": "אבל מ\"מ היא שייכת לגילוי],"
        },
        {
          "s": 16,
          "text": "דהצמצום שנמשך מדרגא זו הוא בשביל הגילוי."
        },
        {
          "s": 17,
          "text": "ועצם כח ההעלם"
        },
        {
          "s": 18,
          "text": "(שלמעלה מגילוי),"
        },
        {
          "s": 19,
          "text": "דהצמצום שנמשך מדרגא זו הוא"
        },
        {
          "s": 20,
          "text": "(לא בשביל הגילוי,"
        },
        {
          "s": 21,
          "text": "אלא)"
        },
        {
          "s": 22,
          "text": "זה שבהצמצום עצמו מתגלה כח ההעלם."
        }
      ]
    }
  ]
}