{
  "globalIndex": 835,
  "owner": 35,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918734_theRebbe_176__p003",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918734_theRebbe_176__p003",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918734_theRebbe_176",
  "title": "מאמר וידבר אלוקים את כל הדברים האלה תשכ\"ח",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "וכמו שבהשפעת השכל מרב לתלמיד,"
        },
        {
          "s": 1,
          "text": "קדימת הכלל להפרטים היא הן בההשפעה בפועל,"
        },
        {
          "s": 2,
          "text": "שההשפעה היא בדרך קצרה,"
        },
        {
          "s": 3,
          "text": "דיבורים קצרים שכוללים כל הפרטים שהתלמיד יבין אח\"כ,"
        },
        {
          "s": 4,
          "text": "והן בהמשכת השכל"
        },
        {
          "s": 5,
          "text": "(השייך להתלמיד)"
        },
        {
          "s": 6,
          "text": "בהרב עצמו,"
        },
        {
          "s": 7,
          "text": "שתחילת המשכתו היא בבחינת נקודה,"
        },
        {
          "s": 8,
          "text": "שכוללת כל הפרטים שנמשכים אח\"כ"
        },
        {
          "s": 9,
          "text": "(אצל הרב,"
        },
        {
          "s": 10,
          "text": "לפני ההשפעה בפועל),"
        },
        {
          "s": 11,
          "text": "עד\"ז הוא גם למעלה,"
        },
        {
          "s": 12,
          "text": "שקדימת הכלל להפרטים היא הן בהמשכת האור שלצורך התהוות העולמות,"
        },
        {
          "s": 13,
          "text": "שבתחילה היתה ההמשכה בבחינת כלל ואח\"כ דוקא נמשכו הפרטים"
        },
        {
          "s": 14,
          "text": "[וענין זה דקדימת הכלל להפרטים הי' בכל דרגא ודרגא,"
        },
        {
          "s": 15,
          "text": "כנ\"ל"
        },
        {
          "s": 16,
          "text": "(סעיף ב)"
        },
        {
          "s": 17,
          "text": "בארוכה],"
        },
        {
          "s": 18,
          "text": "והן בההתהוות בפועל,"
        },
        {
          "s": 19,
          "text": "שבתחילה נברא העולם במאמר אחד,"
        },
        {
          "s": 20,
          "text": "המאמר דבראשית,"
        },
        {
          "s": 21,
          "text": "ורק לאח\"ז היתה ההתהוות בכל מאמרות פרטיים."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "אך צריך להבין,"
        },
        {
          "s": 2,
          "text": "דלכאורה,"
        },
        {
          "s": 3,
          "text": "המשל דרב ותלמיד אינו דומה להנמשל."
        },
        {
          "s": 4,
          "text": "דבהמשל,"
        },
        {
          "s": 5,
          "text": "הרי זה שישנו שכל הרב שלמעלה מגדר השפעה להתלמיד,"
        },
        {
          "s": 6,
          "text": "הוא ענין שמצד הרב עצמו ולא בשביל ההשפעה להתלמיד."
        },
        {
          "s": 7,
          "text": "משא\"כ בהנמשל,"
        },
        {
          "s": 8,
          "text": "הרי כל הגילויים,"
        },
        {
          "s": 9,
          "text": "גם הגילויים הכי נעלים,"
        },
        {
          "s": 10,
          "text": "כולל גם האור שבבחינת גילוי העצם שלמעלה גם מהכלל הראשון השייך לעולמות"
        },
        {
          "s": 11,
          "text": "(עליית הרצון),"
        },
        {
          "s": 12,
          "text": "הוא בכדי29"
        },
        {
          "s": 13,
          "text": "שאח\"כ יומשכו ממנו"
        },
        {
          "s": 14,
          "text": "(ע\"י ריבוי צמצומים)"
        },
        {
          "s": 15,
          "text": "העשרה מאמרות שבהם נברא העולם."
        },
        {
          "s": 16,
          "text": "ועפ\"ז צריך להבין,"
        },
        {
          "s": 17,
          "text": "מדוע לא נמשכו מלכתחילה עשרה מאמרות."
        },
        {
          "s": 18,
          "text": "דביאור הנ\"ל על הצורך דקדימת הכלל להפרטים הוא לאחרי שהוקבע שבתחילה יהי' האור שלמעלה משייכות לעולמות וממנו דוקא תהי' המשכת האור שלפי ערך העולמות"
        },
        {
          "s": 19,
          "text": "[דכיון שהאור שלפי ערך העולמות נמשך מהאור שלמעלה משייכות לעולמות,"
        },
        {
          "s": 20,
          "text": "לכן הי' צריך להיות תחילה ההמשכה בבחינת כלל,"
        },
        {
          "s": 21,
          "text": "שעי\"ז נעשה הגבלה בהאור,"
        },
        {
          "s": 22,
          "text": "כנ\"ל],"
        },
        {
          "s": 23,
          "text": "אבל אינו מובן,"
        },
        {
          "s": 24,
          "text": "דכיון שהכוונה בהמצאת האור שלמעלה משייכות לעולמות היא בכדי שאח\"כ יומשך ממנו האור שלפי ערך העולמות עד לעשרה המאמרות שבהם נברא העולם,"
        },
        {
          "s": 25,
          "text": "הרי לכאורה הי' צריך להיות מלכתחילה המשכת"
        },
        {
          "s": 26,
          "text": "(המצאת)"
        },
        {
          "s": 27,
          "text": "העשרה מאמרות30."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "אך הענין הוא,"
        },
        {
          "s": 2,
          "text": "דבכדי שתושלם כוונת הבריאה,"
        },
        {
          "s": 3,
          "text": "שהנבראים ע\"י עבודתם יהיו בטלים לאלקות,"
        },
        {
          "s": 4,
          "text": "היתה הבריאה31"
        },
        {
          "s": 5,
          "text": "באופן כזה שגם קודם העבודה תהי' בהנבראים כעין הכנה והכשרה להביטול שיפעלו ע\"י עבודתם."
        },
        {
          "s": 6,
          "text": "ולכן היתה הבריאה באופן שבתחילה נמצא האור שלמעלה משייכות לעולמות,"
        },
        {
          "s": 7,
          "text": "וממנו דוקא נמשך האור שלפי ערך העולמות,"
        },
        {
          "s": 8,
          "text": "שעי\"ז נעשה ההכשרה בהעולם להיות דירה לו ית'."
        }
      ]
    }
  ]
}