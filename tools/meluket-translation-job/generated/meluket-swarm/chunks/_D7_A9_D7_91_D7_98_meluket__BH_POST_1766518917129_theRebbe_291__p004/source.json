{
  "globalIndex": 591,
  "owner": 41,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917129_theRebbe_291__p004",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917129_theRebbe_291__p004",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518917129_theRebbe_291",
  "title": "מאמר כי תשא תשל\"א",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה איתא בילקוט36"
        },
        {
          "s": 2,
          "text": "עה\"פ כי חסד חפצתי ולא זבח,"
        },
        {
          "s": 3,
          "text": "פעם אחת הי' רבן יוחנן בן זכאי מהלך בירושלים,"
        },
        {
          "s": 4,
          "text": "והי' רבי יהושע מהלך אחריו,"
        },
        {
          "s": 5,
          "text": "ראה בית המקדש שהוא חרב,"
        },
        {
          "s": 6,
          "text": "אמר,"
        },
        {
          "s": 7,
          "text": "אוי לנו על הבית שחרב מקום שמתכפרין בו עונותינו,"
        },
        {
          "s": 8,
          "text": "א\"ל,"
        },
        {
          "s": 9,
          "text": "בני אל ירע לך,"
        },
        {
          "s": 10,
          "text": "שיש לנו כפרה אחרת שהיא כמותה,"
        },
        {
          "s": 11,
          "text": "ואי זה,"
        },
        {
          "s": 12,
          "text": "זה גמילות חסדים,"
        },
        {
          "s": 13,
          "text": "לכך נאמר כי חסד חפצתי ולא זבח,"
        },
        {
          "s": 14,
          "text": "ואומר37"
        },
        {
          "s": 15,
          "text": "אמרתי עולם חסד יבנה."
        },
        {
          "s": 16,
          "text": "ומדייק בהדרושים34,"
        },
        {
          "s": 17,
          "text": "הרי גמילות חסדים היתה גם בזמן שבית המקדש הי' קיים,"
        },
        {
          "s": 18,
          "text": "ומהלשון יש לנו כפרה אחרת משמע שכפרה זו נתחדשה בזמן הגלות."
        },
        {
          "s": 19,
          "text": "ומבאר שם,"
        },
        {
          "s": 20,
          "text": "ע\"פ מה דאיתא בגמרא38"
        },
        {
          "s": 21,
          "text": "א\"ר יוחנן,"
        },
        {
          "s": 22,
          "text": "ששה דברים אדם אוכל פירותיהן בעולם הזה והקרן קיימת לו לעולם הבא"
        },
        {
          "s": 23,
          "text": "(ועיון תפלה הוא מהששה דברים),"
        },
        {
          "s": 24,
          "text": "ומקשה בגמרא,"
        },
        {
          "s": 25,
          "text": "והא תנן35"
        },
        {
          "s": 26,
          "text": "אלו דברים שאדם עושה אותם ואוכל פירותיהן בעוה\"ז כו' וקא חשיב שם רק שלשה דברים,"
        },
        {
          "s": 27,
          "text": "ומתרץ,"
        },
        {
          "s": 28,
          "text": "הני נמי בהני שייכי,"
        },
        {
          "s": 29,
          "text": "ופירש רש\"י39"
        },
        {
          "s": 30,
          "text": "שעיון תפלה הוא בכלל גמ\"ח דכתיב40"
        },
        {
          "s": 31,
          "text": "גומל נפשו איש חסד"
        },
        {
          "s": 32,
          "text": "[ונפש היינו תפלה דכתיב גבי חנה41"
        },
        {
          "s": 33,
          "text": "ואשפוך את נפשי לפני ה'42]."
        },
        {
          "s": 34,
          "text": "ומבאר בהדרושים,"
        },
        {
          "s": 35,
          "text": "דזה שאמר ריב\"ז יש לנו כפרה אחרת כו' גמילות חסדים,"
        },
        {
          "s": 36,
          "text": "כוונתו היא לעיון תפלה שהיא בכלל גמ\"ח"
        },
        {
          "s": 37,
          "text": "[דעיקר התפלה"
        },
        {
          "s": 38,
          "text": "(ג' תפלות בכל יום ונוסח התפלה)"
        },
        {
          "s": 39,
          "text": "נתקנה בזמן הגלות43]."
        },
        {
          "s": 40,
          "text": "והגם שתפלות הם במקום קרבנות וקרבנות הם העלאה מלמטה למעלה,"
        },
        {
          "s": 41,
          "text": "מבואר בהדרושים,"
        },
        {
          "s": 42,
          "text": "דתפלות כנגד תמידין ומוספין תקנום44,"
        },
        {
          "s": 43,
          "text": "והתמידין ומוספין,"
        },
        {
          "s": 44,
          "text": "קרבנות צבור,"
        },
        {
          "s": 45,
          "text": "הם בחינת המשכה."
        },
        {
          "s": 46,
          "text": "כדאיתא במדרש45"
        },
        {
          "s": 47,
          "text": "דזה שישראל נק' בשם רעיתי46"
        },
        {
          "s": 48,
          "text": "הוא לפי שהיו מקריבין שני תמידין ע\"ג המזבח,"
        },
        {
          "s": 49,
          "text": "ועי\"ז הם רעיתי,"
        },
        {
          "s": 50,
          "text": "פרנסתי,"
        },
        {
          "s": 51,
          "text": "ישראל מפרנסין לאביהם שבשמים47,"
        },
        {
          "s": 52,
          "text": "שממשיכים אוא\"ס בע\"ס."
        },
        {
          "s": 53,
          "text": "ומ\"ש כי חסד חפצתי ולא זבח קאי על קרבנות יחיד,"
        },
        {
          "s": 54,
          "text": "שהם בחי' העלאה,"
        },
        {
          "s": 55,
          "text": "אבל קרבנות צבור,"
        },
        {
          "s": 56,
          "text": "תמידין ומוספין,"
        },
        {
          "s": 57,
          "text": "הם בחי' המשכה."
        },
        {
          "s": 58,
          "text": "וכמ\"ש הש\"ך בפירושו עה\"ת16"
        },
        {
          "s": 59,
          "text": "עה\"פ48"
        },
        {
          "s": 60,
          "text": "מלבד עולת הבוקר,"
        },
        {
          "s": 61,
          "text": "שמלבד הוא ר\"ת מ."
        },
        {
          "s": 62,
          "text": "לוה ל."
        },
        {
          "s": 63,
          "text": "עני ב."
        },
        {
          "s": 64,
          "text": "שעת ד."
        },
        {
          "s": 65,
          "text": "חקו,"
        },
        {
          "s": 66,
          "text": "ופירוש מלבד עולת הבוקר הוא,"
        },
        {
          "s": 67,
          "text": "שהמלוה לעני בשעת דחקו הוא כעולת הבוקר,"
        },
        {
          "s": 68,
          "text": "קרבן תמיד,"
        },
        {
          "s": 69,
          "text": "שהוא המשכה מלמעלה למטה."
        },
        {
          "s": 70,
          "text": "ומזה שתפלות כנגד תמידין תקנום,"
        },
        {
          "s": 71,
          "text": "מובן,"
        },
        {
          "s": 72,
          "text": "שהתפלות הם המשכה מלמעלה למטה."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "והנה מזה שגמילות חסדים"
        },
        {
          "s": 2,
          "text": "(כפשוטה)"
        },
        {
          "s": 3,
          "text": "היתה גם בזמן הבית,"
        },
        {
          "s": 4,
          "text": "משא\"כ הגמ\"ח דתפלה"
        },
        {
          "s": 5,
          "text": "(גומל נפשו איש חסד)"
        },
        {
          "s": 6,
          "text": "נתקנה דוקא לאחרי חורבן ביהמ\"ק,"
        },
        {
          "s": 7,
          "text": "בכדי שתהי' גם עכשיו הכפרה שבדומה להכפרה שהיתה ע\"י ביהמ\"ק,"
        },
        {
          "s": 8,
          "text": "מקום שמתכפרין בו עונותינו,"
        },
        {
          "s": 9,
          "text": "מובן,"
        },
        {
          "s": 10,
          "text": "דיש יתרון בהכפרה שנעשית ע\"י גמ\"ח דתפלה לגבי הכפרה שע\"י גמ\"ח כפשוטה."
        },
        {
          "s": 11,
          "text": "והענין הוא,"
        },
        {
          "s": 12,
          "text": "דתפלה"
        },
        {
          "s": 13,
          "text": "(בכלל)"
        },
        {
          "s": 14,
          "text": "היא העלאה מלמטה למעלה,"
        },
        {
          "s": 15,
          "text": "וכמובן גם ממ\"ש ואשפוך את נפשי לפני הוי'"
        },
        {
          "s": 16,
          "text": "[דמפסוק זה מביאים ראי' שתפלה היא המשכה],"
        },
        {
          "s": 17,
          "text": "דשפיכת הנפש היא העלאה,"
        },
        {
          "s": 18,
          "text": "אלא שהמבוקש דהעלאה זו הוא שתהי' המשכה למטה49."
        },
        {
          "s": 19,
          "text": "[ולהוסיף,"
        },
        {
          "s": 20,
          "text": "דמבואר בהדרושים,"
        },
        {
          "s": 21,
          "text": "דבגומל נפשו איש חסד,"
        },
        {
          "s": 22,
          "text": "שני פירושים."
        },
        {
          "s": 23,
          "text": "גומל מלשון הפרשה"
        },
        {
          "s": 24,
          "text": "(כמו ויגדל הילד ויגמל50),"
        },
        {
          "s": 25,
          "text": "וגומל מלשון השפעה"
        },
        {
          "s": 26,
          "text": "(כמו גמילות חסדים)."
        },
        {
          "s": 27,
          "text": "גומל נפשו מלשון השפעה הוא בהעבודה דתפלה שמצד נפש האלקית,"
        },
        {
          "s": 28,
          "text": "שההעלאה"
        },
        {
          "s": 29,
          "text": "(שפיכת נפש)"
        },
        {
          "s": 30,
          "text": "היא בשביל ההמשכה."
        },
        {
          "s": 31,
          "text": "וגומל נפשו מלשון הפרשה הוא בהקרבת נפש הבהמית שבתפלה,"
        },
        {
          "s": 32,
          "text": "לפרוש ולצאת מעניני העולם ולהיות בביטול,"
        },
        {
          "s": 33,
          "text": "העלאה."
        },
        {
          "s": 34,
          "text": "ובהעבודה שמצד נפש הבהמית,"
        },
        {
          "s": 35,
          "text": "ההעלאה היא לא בשביל המשכה אלא שזה עצמו הוא המבוקש שלו49."
        },
        {
          "s": 36,
          "text": "ויש לומר,"
        },
        {
          "s": 37,
          "text": "דזה שהתפלה דנפש האלקית נקראת בשם גומל נפשו,"
        },
        {
          "s": 38,
          "text": "שגומל הוא גם לשון הפרשה,"
        },
        {
          "s": 39,
          "text": "מורה,"
        },
        {
          "s": 40,
          "text": "שגם בהתפלה דנפש האלקית ישנה העלאה שבדוגמת העלאה דנפש הבהמית,"
        },
        {
          "s": 41,
          "text": "שהמבוקש שבה הוא העלאה]."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "והנה ידוע דבסליחה וכפרה שני ענינים51."
        },
        {
          "s": 1,
          "text": "שע\"י ההמשכה מעצמות אוא\"ס בעל הרצון שאינו מוכרח בהרצון,"
        },
        {
          "s": 2,
          "text": "מתבטלים החטאים והפגמים."
        },
        {
          "s": 3,
          "text": "ועוד ענין בסליחה וכפרה,"
        },
        {
          "s": 4,
          "text": "שע\"י ההמשכה מעצמות אוא\"ס בעל הרצון52,"
        },
        {
          "s": 5,
          "text": "נמשך רצון חדש"
        },
        {
          "s": 6,
          "text": "(שלמעלה מהרצון שנסתלק ע\"י החטא),"
        },
        {
          "s": 7,
          "text": "ועי\"ז נעשה מרוצה לפניו ית' כמו קודם החטא."
        },
        {
          "s": 8,
          "text": "והחילוק דשני הענינים הוא,"
        },
        {
          "s": 9,
          "text": "דזה שע\"י ההמשכה מעצמות אוא\"ס מתבטלים הפגמים הוא מפני שאינו מוכרח בהרצון,"
        },
        {
          "s": 10,
          "text": "מובדל מהרצון,"
        },
        {
          "s": 11,
          "text": "וזה שנמשך ממנו רצון חדש הוא"
        },
        {
          "s": 12,
          "text": "(לא מפני שהוא מובדל מהרצון,"
        },
        {
          "s": 13,
          "text": "אלא אדרבה)"
        },
        {
          "s": 14,
          "text": "מפני שהוא בעל הרצון."
        },
        {
          "s": 15,
          "text": "דבדרגת הרצון,"
        },
        {
          "s": 16,
          "text": "יש הגבלה באופן המשכתו,"
        },
        {
          "s": 17,
          "text": "וכשעושים היפך הרצון הוא מסתלק."
        },
        {
          "s": 18,
          "text": "משא\"כ בעל הרצון,"
        },
        {
          "s": 19,
          "text": "אינו מוגבל באופן ההמשכה,"
        },
        {
          "s": 20,
          "text": "ולכן גם לאחרי שעשו היפך הרצון שעי\"ז נסתלק הרצון,"
        },
        {
          "s": 21,
          "text": "אפשר להיות נמשך ממנו רצון חדש."
        }
      ]
    }
  ]
}