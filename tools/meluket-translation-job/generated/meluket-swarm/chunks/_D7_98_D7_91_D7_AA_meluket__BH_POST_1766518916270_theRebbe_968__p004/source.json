{
  "globalIndex": 442,
  "owner": 42,
  "jobId": "_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916270_theRebbe_968__p004",
  "batchId": "meluket-_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916270_theRebbe_968__p004",
  "seriesId": "טבת_meluket",
  "postId": "BH_POST_1766518916270_theRebbe_968",
  "title": "מאמר היושבת בגנים תשי\"ג",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ויש להוסיף בזה שהוא ע\"ד הידוע בפירוש חברים56"
        },
        {
          "s": 2,
          "text": "מקשיבים לקולך,"
        },
        {
          "s": 3,
          "text": "חברים הם מלאכי השרת57,"
        },
        {
          "s": 4,
          "text": "והם מקשיבים לקולך לקול התורה והתפלה דישראל,"
        },
        {
          "s": 5,
          "text": "דלהיות שקול ודיבור האדם הוא גשמי,"
        },
        {
          "s": 6,
          "text": "לכן,"
        },
        {
          "s": 7,
          "text": "בכדי שיעלו התורה והתפלה של האדם הוא ע\"י שהמלאכים מזככים אותם,"
        },
        {
          "s": 8,
          "text": "דגפיף להון ומנשק להון58,"
        },
        {
          "s": 9,
          "text": "וע\"י שהמלאכים מעלים אותיות התורה והתפלה דישראל"
        },
        {
          "s": 10,
          "text": "(פירוש הנ\"ל במקשיבים לקולך),"
        },
        {
          "s": 11,
          "text": "הנה בשכר זה59"
        },
        {
          "s": 12,
          "text": "הם מקשיבים לקולך שהם מקבלים מאותיות התורה והתפלה דישראל60,"
        },
        {
          "s": 13,
          "text": "שהם נעלים הרבה יותר מהמלאכים ועד לעילוי שבאין ערוך61,"
        },
        {
          "s": 14,
          "text": "עד\"ז הוא גם בענין הגילויים דלע\"ל,"
        },
        {
          "s": 15,
          "text": "דהגם שהם נעלים באין ערוך לגבי הגילויים דג\"ע,"
        },
        {
          "s": 16,
          "text": "מ\"מ,"
        },
        {
          "s": 17,
          "text": "מכיון שהגילויים דלעתיד הוא האור שנמשך ע\"י עשיית המצוות בדברים גשמיים שבעוה\"ז הגשמי והחומרי,"
        },
        {
          "s": 18,
          "text": "לכן צריכים הם להזדכך ע\"י שעולים לג\"ע62,"
        },
        {
          "s": 19,
          "text": "דג\"ע הוא מזוכך בתכלית"
        },
        {
          "s": 20,
          "text": "(כידוע63"
        },
        {
          "s": 21,
          "text": "הטעם לזה שאדה\"ר נגרש מג\"ע,"
        },
        {
          "s": 22,
          "text": "כי ג\"ע אינו סובל מציאות החטא)."
        },
        {
          "s": 23,
          "text": "אלא שעכשיו,"
        },
        {
          "s": 24,
          "text": "גם לאחרי שמזדככים בג\"ע,"
        },
        {
          "s": 25,
          "text": "הנה עצם המצוה אינו מאיר בגילוי ורק הארה בלבד,"
        },
        {
          "s": 26,
          "text": "אור הממלא."
        },
        {
          "s": 27,
          "text": "ועי\"ז"
        },
        {
          "s": 28,
          "text": "(כיון שענינו דאור הממלא הוא גילוי)"
        },
        {
          "s": 29,
          "text": "יהי' לע\"ל הגילוי דעצם המצוה,"
        },
        {
          "s": 30,
          "text": "גילוי הסובב,"
        },
        {
          "s": 31,
          "text": "ולמעלה יותר,"
        },
        {
          "s": 32,
          "text": "הרי בשמים,"
        },
        {
          "s": 33,
          "text": "גילוי פשיטות העצמות."
        }
      ]
    }
  ]
}