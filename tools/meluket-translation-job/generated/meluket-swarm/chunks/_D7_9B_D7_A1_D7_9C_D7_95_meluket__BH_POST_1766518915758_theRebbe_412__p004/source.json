{
  "globalIndex": 348,
  "owner": 48,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915758_theRebbe_412__p004",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915758_theRebbe_412__p004",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915758_theRebbe_412",
  "title": "מאמר להבין ענין נרות חנוכה תשכ\"ו",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ויש לבאר זה ע\"פ מה שממשיך בהמאמר39,"
        },
        {
          "s": 2,
          "text": "דאיתא בזהר40"
        },
        {
          "s": 3,
          "text": "איזהו חסיד המתחסד עם קונו,"
        },
        {
          "s": 4,
          "text": "היינו דענינו של חסיד הוא שעבודתו היא לא בשביל עצמו בכדי שיהי' דבוק באלקות אלא לצורך גבוה,"
        },
        {
          "s": 5,
          "text": "כמבואר בתניא41."
        },
        {
          "s": 6,
          "text": "ומבאר בהמאמר,"
        },
        {
          "s": 7,
          "text": "דההמשכה שע\"י העבודה דחסידים היא מפנימיות עתיק."
        },
        {
          "s": 8,
          "text": "וזהו שחסיד הוא למעלה מצדיק ולמעלה גם מישר42."
        },
        {
          "s": 9,
          "text": "דההמשכה שע\"י עבודת הצדיקים היא מחיצוניות הכתר,"
        },
        {
          "s": 10,
          "text": "אריך."
        },
        {
          "s": 11,
          "text": "וההמשכה שע\"י העבודה דישרים"
        },
        {
          "s": 12,
          "text": "(שלמעלה מצדיקים)"
        },
        {
          "s": 13,
          "text": "היא מפנימיות הכתר,"
        },
        {
          "s": 14,
          "text": "עתיק."
        },
        {
          "s": 15,
          "text": "וההמשכה שע\"י העבודה דחסידים"
        },
        {
          "s": 16,
          "text": "(שלמעלה מישרים)"
        },
        {
          "s": 17,
          "text": "היא מפנימיות עתיק."
        },
        {
          "s": 18,
          "text": "דע\"י שהעבודה שלהם היא בביטול"
        },
        {
          "s": 19,
          "text": "(למעלה ממציאות),"
        },
        {
          "s": 20,
          "text": "לכן ההמשכה שנמשכת ע\"י עבודתם היא מבחינת העצם שלמעלה מהתפשטות"
        },
        {
          "s": 21,
          "text": "(מציאות),"
        },
        {
          "s": 22,
          "text": "פנימיות עתיק."
        },
        {
          "s": 23,
          "text": "וזהו שארז\"ל43"
        },
        {
          "s": 24,
          "text": "שצדקה היא לעניים וגמילות חסדים היא בין לעניים בין לעשירים,"
        },
        {
          "s": 25,
          "text": "דמזה"
        },
        {
          "s": 26,
          "text": "(שגמילות חסדים היא גם לעשירים)"
        },
        {
          "s": 27,
          "text": "מובן שחסד הוא למעלה גם מעשירות."
        },
        {
          "s": 28,
          "text": "ומבאר44,"
        },
        {
          "s": 29,
          "text": "דג' ענינים אלה"
        },
        {
          "s": 30,
          "text": "(צדקה,"
        },
        {
          "s": 31,
          "text": "עשירות וחסד)"
        },
        {
          "s": 32,
          "text": "הם ג' מדריגות בההמשכות דלמעלה שנמשכים במלכות."
        },
        {
          "s": 33,
          "text": "צדקה שהיא מילוי החסרון"
        },
        {
          "s": 34,
          "text": "[די מחסורו ואי אתה מצווה לעשרו45]"
        },
        {
          "s": 35,
          "text": "הוא המשכת הגילוי ששייך למלכות,"
        },
        {
          "s": 36,
          "text": "שעי\"ז נתמלא החסרון שלה."
        },
        {
          "s": 37,
          "text": "דבגילוי זה נכלל גם בחינת חיצוניות הכתר,"
        },
        {
          "s": 38,
          "text": "אריך."
        },
        {
          "s": 39,
          "text": "דכיון שאריך הוא שורש ומקור הנאצלים אלא שהוא מקיף עליהם"
        },
        {
          "s": 40,
          "text": "(סובב),"
        },
        {
          "s": 41,
          "text": "הוא בכלל האור השייך לעולמות"
        },
        {
          "s": 42,
          "text": "(מלכות)."
        },
        {
          "s": 43,
          "text": "ויש לומר,"
        },
        {
          "s": 44,
          "text": "דשם צדיק מלשון צדקה הוא,"
        },
        {
          "s": 45,
          "text": "כי ע\"י עבודת הצדיקים הוא המשכת חיצוניות הכתר"
        },
        {
          "s": 46,
          "text": "(כנ\"ל),"
        },
        {
          "s": 47,
          "text": "דהמשכה זו היא בכלל מילוי החסרון,"
        },
        {
          "s": 48,
          "text": "צדקה."
        },
        {
          "s": 49,
          "text": "ועשירות,"
        },
        {
          "s": 50,
          "text": "שהיא למעלה ממילוי החסרון,"
        },
        {
          "s": 51,
          "text": "הוא המשכת גילוי אור שלמעלה משייכות למלכות"
        },
        {
          "s": 52,
          "text": "(שנמשך במלכות),"
        },
        {
          "s": 53,
          "text": "פנימיות הכתר,"
        },
        {
          "s": 54,
          "text": "עתיק."
        },
        {
          "s": 55,
          "text": "וחסד שהוא למעלה גם מעשירות הוא המשכת פנימיות עתיק"
        },
        {
          "s": 56,
          "text": "(שנמשך במלכות)."
        },
        {
          "s": 57,
          "text": "וזהו איזהו חסיד המתחסד עם קונו,"
        },
        {
          "s": 58,
          "text": "דמהטעמים על זה דמי שעבודתו היא"
        },
        {
          "s": 59,
          "text": "(לא לצורך עצמו,"
        },
        {
          "s": 60,
          "text": "אלא)"
        },
        {
          "s": 61,
          "text": "לצורך גבוה נקרא בשם חסיד"
        },
        {
          "s": 62,
          "text": "(מלשון חסד),"
        },
        {
          "s": 63,
          "text": "הוא,"
        },
        {
          "s": 64,
          "text": "כי ע\"י שהעבודה שלו היא בתכלית הביטול"
        },
        {
          "s": 65,
          "text": "(למעלה ממציאות),"
        },
        {
          "s": 66,
          "text": "ההמשכה שע\"י עבודתו היא מפנימיות עתיק"
        },
        {
          "s": 67,
          "text": "(כנ\"ל),"
        },
        {
          "s": 68,
          "text": "ענין החסד,"
        },
        {
          "s": 69,
          "text": "ולכן נקרא בשם חסיד."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "דמ\"ש יודוך גו' וחסידיך יברכוכה,"
        },
        {
          "s": 3,
          "text": "שהמעלה דההמשכה"
        },
        {
          "s": 4,
          "text": "(ברכה)"
        },
        {
          "s": 5,
          "text": "שע\"י חסידיך הוא שההמשכה היא ממקום שאין שייך בו השגה אלא הודאה בלבד,"
        },
        {
          "s": 6,
          "text": "הוא,"
        },
        {
          "s": 7,
          "text": "כי אמיתית ענין ההודאה הוא בפנימיות עתיק46,"
        },
        {
          "s": 8,
          "text": "וההמשכה משם"
        },
        {
          "s": 9,
          "text": "(באופן דברכה)"
        },
        {
          "s": 10,
          "text": "היא ע\"י חסידיך דוקא."
        },
        {
          "s": 11,
          "text": "גם יש לומר,"
        },
        {
          "s": 12,
          "text": "שעיקר החידוש ביודוך גו' יברכוכה הוא,"
        },
        {
          "s": 13,
          "text": "שההמשכה מהמקום שבו הו\"ע ההודאה"
        },
        {
          "s": 14,
          "text": "(אוא\"ס שלמעלה מהשתלשלות)"
        },
        {
          "s": 15,
          "text": "היא באופן דברכה"
        },
        {
          "s": 16,
          "text": "(יברכוכה),"
        },
        {
          "s": 17,
          "text": "היינו שההמשכה היא בדרך ממילא,"
        },
        {
          "s": 18,
          "text": "וההמשכה באופן זה היא"
        },
        {
          "s": 19,
          "text": "(בעיקר)"
        },
        {
          "s": 20,
          "text": "ע\"י חסידיך דוקא."
        },
        {
          "s": 21,
          "text": "היינו דזה שההמשכה היא מהמקום שבו הו\"ע ההודאה,"
        },
        {
          "s": 22,
          "text": "הוא גם בצדיקים וישרים."
        },
        {
          "s": 23,
          "text": "דכיון שגם אריך ומכ\"ש חיצוניות עתיק הם למעלה מהשתלשלות,"
        },
        {
          "s": 24,
          "text": "אין שייך בהם השגה אלא הודאה בלבד."
        },
        {
          "s": 25,
          "text": "אלא שההמשכה מאריך ומחיצוניות עתיק"
        },
        {
          "s": 26,
          "text": "(שע\"י צדיקים וישרים)"
        },
        {
          "s": 27,
          "text": "היא"
        },
        {
          "s": 28,
          "text": "(כמו)"
        },
        {
          "s": 29,
          "text": "בדרך פעולה,"
        },
        {
          "s": 30,
          "text": "ואמיתית הענין דבדרך ממילא הוא בההמשכה מפנימיות עתיק"
        },
        {
          "s": 31,
          "text": "(שע\"י חסידיך),"
        },
        {
          "s": 32,
          "text": "כדלקמן."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "והענין הוא,"
        },
        {
          "s": 2,
          "text": "דאריך ועתיק הם בדוגמת רצון ותענוג."
        },
        {
          "s": 3,
          "text": "ומהחילוקים שבין רצון לתענוג הוא47,"
        },
        {
          "s": 4,
          "text": "דפעולת הרצון בהכחות והאברים היא בדרך שליטה,"
        },
        {
          "s": 5,
          "text": "היינו שהכחות והאברים מצד עצמם נשארים בטבעם כמו שהיו קודם אלא שהרצון שולט עליהם ומכריח אותם שיהיו כפי הרצון"
        },
        {
          "s": 6,
          "text": "(היפך הטבע שלהם)."
        },
        {
          "s": 7,
          "text": "והפעולה שנעשית בהכחות והאברים ע\"י התענוג,"
        },
        {
          "s": 8,
          "text": "כיון שהתענוג הוא הפנימיות והחיות דהכחות והאברים עצמם48,"
        },
        {
          "s": 9,
          "text": "לכן,"
        },
        {
          "s": 10,
          "text": "הפעולה שנעשית בהם ע\"י התענוג היא"
        },
        {
          "s": 11,
          "text": "(לא באופן דשליטה והכרח,"
        },
        {
          "s": 12,
          "text": "אלא)"
        },
        {
          "s": 13,
          "text": "שהם עצמם נעשים כך."
        },
        {
          "s": 14,
          "text": "ועד\"ז הוא למעלה49,"
        },
        {
          "s": 15,
          "text": "דהשינוי"
        },
        {
          "s": 16,
          "text": "(כביכול)"
        },
        {
          "s": 17,
          "text": "שנעשה בהדרגא דהשתלשלות ע\"י ההמשכה דחיצוניות הכתר שנמשכת ע\"י הצדיקים,"
        },
        {
          "s": 18,
          "text": "דגם כשמצד בחינת ההשתלשלות ישנה גזירה שלא תהי' המשכת ההשפעה וע\"י שהצדיק ממשיך רצון חדש מהכתר שלמעלה מהשתלשלות"
        },
        {
          "s": 19,
          "text": "(חיצוניות הכתר)"
        },
        {
          "s": 20,
          "text": "מתבטלת הגזירה,"
        },
        {
          "s": 21,
          "text": "הוא באופן דשליטה וממשלה"
        },
        {
          "s": 22,
          "text": "(צדיק מושל ביראת אלקים),"
        },
        {
          "s": 23,
          "text": "שהרצון דלמעלה מהשתלשלות שולט ומושל על ההשתלשלות."
        },
        {
          "s": 24,
          "text": "וביטול הגזירה שמצד בחינת ההשתלשלות ע\"י המשכת פנימיות הכתר שנמשכת ע\"י העבודה דישרים הוא"
        },
        {
          "s": 25,
          "text": "(לא באופן דשליטה,"
        },
        {
          "s": 26,
          "text": "אלא)"
        },
        {
          "s": 27,
          "text": "דכיון שהתענוג דפנימיות הכתר הוא הפנימיות דההשתלשלות,"
        },
        {
          "s": 28,
          "text": "לכן,"
        },
        {
          "s": 29,
          "text": "ע\"י המשכת פנימיות הרצון והתענוג"
        },
        {
          "s": 30,
          "text": "(דפנימיות הכתר),"
        },
        {
          "s": 31,
          "text": "שהרצון שם הוא שתהי' ההשפעה,"
        },
        {
          "s": 32,
          "text": "ביטול הגזירה הוא גם מצד ההשתלשלות גופא."
        },
        {
          "s": 33,
          "text": "ויש לומר,"
        },
        {
          "s": 34,
          "text": "דזהו שארז\"ל50"
        },
        {
          "s": 35,
          "text": "כל המלמד את בן עם הארץ תורה אפילו הקב\"ה גוזר גזירה מבטלה בשבילו שנאמר51"
        },
        {
          "s": 36,
          "text": "ואם תוציא יקר מזולל כפי תהי',"
        },
        {
          "s": 37,
          "text": "דלשון מבטלה בשבילו מורה שהקב\"ה מבטלה בשבילו,"
        },
        {
          "s": 38,
          "text": "דיש לומר,"
        },
        {
          "s": 39,
          "text": "שזה נעלה יותר מזה שהקב\"ה גוזר וצדיק מבטל."
        },
        {
          "s": 40,
          "text": "והענין הוא,"
        },
        {
          "s": 41,
          "text": "דעיקר התענוג דלמעלה הוא מהחידוש52"
        },
        {
          "s": 42,
          "text": "דאתהפכא חשוכא לנהורא,"
        },
        {
          "s": 43,
          "text": "להוציא יקר מזולל53."
        },
        {
          "s": 44,
          "text": "וכיון שמעבודתו של צדיק זה שמלמד ומפיץ תורה חוצה גם לבן עם הארץ נעשה התענוג דלמעלה,"
        },
        {
          "s": 45,
          "text": "לכן,"
        },
        {
          "s": 46,
          "text": "ביטול הגזירה שעל ידו הוא"
        },
        {
          "s": 47,
          "text": "[לא באופן דהקב\"ה גוזר וצדיק מבטל,"
        },
        {
          "s": 48,
          "text": "היינו שמצד הדרגא דהקב\"ה"
        },
        {
          "s": 49,
          "text": "(השתלשלות)"
        },
        {
          "s": 50,
          "text": "ישנה הגזירה,"
        },
        {
          "s": 51,
          "text": "אלא שע\"י הדרגא דלמעלה מהשתלשלות"
        },
        {
          "s": 52,
          "text": "(חיצוניות הכתר)"
        },
        {
          "s": 53,
          "text": "שנמשכת ע\"י הצדיק שמושלת על הדרגא דהשתלשלות"
        },
        {
          "s": 54,
          "text": "(צדיק מושל ביראת אלקים)"
        },
        {
          "s": 55,
          "text": "היא מתבטלת,"
        },
        {
          "s": 56,
          "text": "כי אם],"
        },
        {
          "s": 57,
          "text": "שע\"י התענוג"
        },
        {
          "s": 58,
          "text": "(פנימיות הכתר)"
        },
        {
          "s": 59,
          "text": "שנעשה למעלה מעבודתו,"
        },
        {
          "s": 60,
          "text": "ביטול הגזירה הוא גם מצד הדרגא דהקב\"ה"
        },
        {
          "s": 61,
          "text": "(השתלשלות)."
        }
      ]
    }
  ]
}