{
  "globalIndex": 14,
  "owner": 14,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913771_theRebbe_98__p002",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913771_theRebbe_98__p002",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518913771_theRebbe_98",
  "title": "מאמר יו\"ט של ר\"ה תשל\"ג",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים מה שארז\"ל14"
        },
        {
          "s": 2,
          "text": "משביעין אותו תהי צדיק כו',"
        },
        {
          "s": 3,
          "text": "ואמר כ\"ק מו\"ח אדמו\"ר15"
        },
        {
          "s": 4,
          "text": "בשם הצ\"צ,"
        },
        {
          "s": 5,
          "text": "אשר בראש השנה הראשונה לחייו"
        },
        {
          "s": 6,
          "text": "(שנת תק\"ן16)"
        },
        {
          "s": 7,
          "text": "אמר אדמו\"ר הזקן דרוש משביעין אותו תהי צדיק כו',"
        },
        {
          "s": 8,
          "text": "והוא השלשת פרקים הראשונים של ספר התניא17."
        },
        {
          "s": 9,
          "text": "ויש לבאר השייכות דענין משביעין אותו לראש השנה ע\"פ המבואר בלקו\"ת18,"
        },
        {
          "s": 10,
          "text": "דזה שכל אחד מישראל נק' אדם"
        },
        {
          "s": 11,
          "text": "(אתם קרויין אדם19),"
        },
        {
          "s": 12,
          "text": "הוא,"
        },
        {
          "s": 13,
          "text": "לפי שבנשמת כל אחד מישראל יש חלק מנשמת אדם הראשון."
        },
        {
          "s": 14,
          "text": "ומזה מובן,"
        },
        {
          "s": 15,
          "text": "דבראש השנה"
        },
        {
          "s": 16,
          "text": "(יום ברוא אדם הראשון)"
        },
        {
          "s": 17,
          "text": "שאז מתחדש"
        },
        {
          "s": 18,
          "text": "(בכל שנה)"
        },
        {
          "s": 19,
          "text": "הענין דהמשכת נשמת אדם הראשון בגופו"
        },
        {
          "s": 20,
          "text": "(ויפח20"
        },
        {
          "s": 21,
          "text": "באפיו נשמת חיים)21,"
        },
        {
          "s": 22,
          "text": "הרי זה גם יום ההולדת של כל אחד מישראל."
        },
        {
          "s": 23,
          "text": "וי\"ל שזהו הקשר דמשביעין אותו לראש השנה."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ויש לקשר זה עם פירוש המדרש22"
        },
        {
          "s": 1,
          "text": "עה\"פ23"
        },
        {
          "s": 2,
          "text": "בחודש השביעי שהוא ירחא דשבועתא"
        },
        {
          "s": 3,
          "text": "(שביעי מלשון שבועה),"
        },
        {
          "s": 4,
          "text": "וכמבואר בדרושי הצ\"צ24"
        },
        {
          "s": 5,
          "text": "השייכות דירחא דשבועתא למשביעין אותו תהי צדיק."
        },
        {
          "s": 6,
          "text": "ואולי יש להוסיף,"
        },
        {
          "s": 7,
          "text": "דבחודש השביעי ג' פירושים,"
        },
        {
          "s": 8,
          "text": "שביעי כפשוטו,"
        },
        {
          "s": 9,
          "text": "שביעי מלשון שבועה"
        },
        {
          "s": 10,
          "text": "(ירחא דשבועתא כנ\"ל),"
        },
        {
          "s": 11,
          "text": "ושביעי מלשון שובע,"
        },
        {
          "s": 12,
          "text": "כדאיתא במדרש25"
        },
        {
          "s": 13,
          "text": "דפירוש בחודש השביעי הוא,"
        },
        {
          "s": 14,
          "text": "שהוא משובע בכל"
        },
        {
          "s": 15,
          "text": "(גיתות בתוכו,"
        },
        {
          "s": 16,
          "text": "ברכות בתוכו,"
        },
        {
          "s": 17,
          "text": "וכו')."
        },
        {
          "s": 18,
          "text": "ועד\"ז הוא במשביעין אותו תהי צדיק כו',"
        },
        {
          "s": 19,
          "text": "שמבואר בכ\"מ26"
        },
        {
          "s": 20,
          "text": "וגם בדרושי הצ\"צ27"
        },
        {
          "s": 21,
          "text": "דבמשביעין ג' פירושים."
        },
        {
          "s": 22,
          "text": "משביעין כפשוטו,"
        },
        {
          "s": 23,
          "text": "וגם מלשון שובע ומלשון שבעה,"
        },
        {
          "s": 24,
          "text": "כדלקמן."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה השייכות דג' ענינים אלה"
        },
        {
          "s": 2,
          "text": "(שבועה,"
        },
        {
          "s": 3,
          "text": "שובע,"
        },
        {
          "s": 4,
          "text": "שבעה)"
        },
        {
          "s": 5,
          "text": "היא,"
        },
        {
          "s": 6,
          "text": "דענין השבועה הוא שמקשר את עצמותו."
        },
        {
          "s": 7,
          "text": "וכמו בשבועה כפשוטה,"
        },
        {
          "s": 8,
          "text": "דזה שהאדם נשבע לעשות איזה דבר"
        },
        {
          "s": 9,
          "text": "(הגם שעכשיו בעת שנשבע הוא רוצה בזה,"
        },
        {
          "s": 10,
          "text": "ולמה צריך להשבועה),"
        },
        {
          "s": 11,
          "text": "הוא,"
        },
        {
          "s": 12,
          "text": "בכדי שגם כשיהי' איזה דבר שיגרום שלא ירצה בהדבר,"
        },
        {
          "s": 13,
          "text": "הנה ע\"י שנשבע לעשות הדבר,"
        },
        {
          "s": 14,
          "text": "יעשה את הדבר גם נגד רצונו28."
        },
        {
          "s": 15,
          "text": "והטעם על זה הוא כי ענין השבועה הוא שמקשר את עצמותו בזה,"
        },
        {
          "s": 16,
          "text": "עצם הנפש שלמעלה מרצון."
        },
        {
          "s": 17,
          "text": "ועד\"ז הוא למעלה,"
        },
        {
          "s": 18,
          "text": "דענין השבועה הוא כמ\"ש29"
        },
        {
          "s": 19,
          "text": "בי נשבעתי,"
        },
        {
          "s": 20,
          "text": "בי בעצמותי."
        },
        {
          "s": 21,
          "text": "וכמבואר בהדרושים30,"
        },
        {
          "s": 22,
          "text": "דבי קאי על עתיק,"
        },
        {
          "s": 23,
          "text": "וידוע31"
        },
        {
          "s": 24,
          "text": "שעתיק הוא בחינה תחתונה שבמאציל שלמעלה משרש הנאצלים."
        }
      ]
    }
  ]
}