{
  "globalIndex": 711,
  "owner": 11,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917950_theRebbe_524__p002",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917950_theRebbe_524__p002",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917950_theRebbe_524",
  "title": "מאמר על שלושה דברים תשי\"ד",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש לבאר מ\"ש על שלשה דברים העולם עומד,"
        },
        {
          "s": 1,
          "text": "דמזה משמע,"
        },
        {
          "s": 2,
          "text": "שבכדי שתהי' עמידת העולם"
        },
        {
          "s": 3,
          "text": "(גילוי אלקות בעולם),"
        },
        {
          "s": 4,
          "text": "נוגע לא רק כללות הענין דתומ\"צ,"
        },
        {
          "s": 5,
          "text": "אלא הענין דשלשה דברים,"
        },
        {
          "s": 6,
          "text": "כי ענין עמידת העולם הוא,"
        },
        {
          "s": 7,
          "text": "שהגילוי אלקות שנמשך בעולם ע\"י תומ\"צ יהי' בו לא כמו דבר נוסף,"
        },
        {
          "s": 8,
          "text": "אלא שיתגלה בו שהכוונה וענינו הפנימי דהעולם"
        },
        {
          "s": 9,
          "text": "(העלם)"
        },
        {
          "s": 10,
          "text": "עצמו הוא שיהי' בו גילוי אלקות,"
        },
        {
          "s": 11,
          "text": "וענין זה שבתומ\"צ הוא ע\"י התחלקותם בג' דברים"
        },
        {
          "s": 12,
          "text": "(ג' סוגים)7,"
        },
        {
          "s": 13,
          "text": "תורה עבודה וגמ\"ח."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים מה שנתבאר לעיל"
        },
        {
          "s": 2,
          "text": "(בהמאמר הקודם8)"
        },
        {
          "s": 3,
          "text": "בביאור מאמר רז\"ל9"
        },
        {
          "s": 4,
          "text": "אור א\"ס למעלה מעלה עד אין קץ ולמטה מטה עד אין תכלית,"
        },
        {
          "s": 5,
          "text": "דמעלה ומטה הם"
        },
        {
          "s": 6,
          "text": "(בדרך כלל)"
        },
        {
          "s": 7,
          "text": "אצילות ובי\"ע,"
        },
        {
          "s": 8,
          "text": "ופירוש אוא\"ס למעלה כו' ולמטה כו' הוא,"
        },
        {
          "s": 9,
          "text": "שהעילוי והשלימות דאוא\"ס הוא בשני ענינים."
        },
        {
          "s": 10,
          "text": "בענין ההמשכה והירידה למטה להוות ולהחיות את הנבראים דבי\"ע,"
        },
        {
          "s": 11,
          "text": "ובזה גופא – למטה מטה עד אין תכלית,"
        },
        {
          "s": 12,
          "text": "שהוא נמשך להחיות הנבראים שבעולם הזה הגשמי שאין תחתון למטה ממנו10,"
        },
        {
          "s": 13,
          "text": "ועד שהוא נמשך להחיות גם את הקליפות,"
        },
        {
          "s": 14,
          "text": "ובענין הרוממות,"
        },
        {
          "s": 15,
          "text": "שגם עולמות העליונים,"
        },
        {
          "s": 16,
          "text": "אצילות ולמעלה מאצילות,"
        },
        {
          "s": 17,
          "text": "למעלה מעלה,"
        },
        {
          "s": 18,
          "text": "התהוותם הוא מהארה בלבד,"
        },
        {
          "s": 19,
          "text": "שבאין ערוך לגבי' ית'."
        },
        {
          "s": 20,
          "text": "דשני ענינים אלה הם"
        },
        {
          "s": 21,
          "text": "(בדרך כלל)"
        },
        {
          "s": 22,
          "text": "באור הממלא ואור הסובב."
        },
        {
          "s": 23,
          "text": "דבאור הממלא הוא ענין הירידה וההמשכה למטה להחיות את הנבראים לפי ערכם,"
        },
        {
          "s": 24,
          "text": "ובאור הסובב הוא ענין ההפלאה והרוממות,"
        },
        {
          "s": 25,
          "text": "שכל העולמות"
        },
        {
          "s": 26,
          "text": "(וגם האור שמתלבש בהם)"
        },
        {
          "s": 27,
          "text": "הם באין ערוך וכלא חשיב לגבי' ית'."
        },
        {
          "s": 28,
          "text": "ומשני ענינים אלה שבאור א\"ס נעשה שני הענינים דמעלה ומטה בעולמות."
        },
        {
          "s": 29,
          "text": "דענין מעלה ומטה הוא בכל העולמות."
        },
        {
          "s": 30,
          "text": "דהמציאות שבעולמות"
        },
        {
          "s": 31,
          "text": "(גם המציאות שבאצילות ולמעלה מאצילות)"
        },
        {
          "s": 32,
          "text": "הוא המטה שבהם,"
        },
        {
          "s": 33,
          "text": "וענין הרצוא,"
        },
        {
          "s": 34,
          "text": "יציאה ממציאות"
        },
        {
          "s": 35,
          "text": "(שישנו בכל העולמות,"
        },
        {
          "s": 36,
          "text": "גם בבי\"ע)"
        },
        {
          "s": 37,
          "text": "הוא המעלה שבהם11."
        },
        {
          "s": 38,
          "text": "ושני ענינים אלה שבעולמות הם משני ענינים הנ\"ל שבאור א\"ס."
        },
        {
          "s": 39,
          "text": "דמאור הממלא שהוא בתנועה דירידה והמשכה למטה,"
        },
        {
          "s": 40,
          "text": "נעשה המטה"
        },
        {
          "s": 41,
          "text": "(המציאות)"
        },
        {
          "s": 42,
          "text": "שבעולמות,"
        },
        {
          "s": 43,
          "text": "והמעלה שבעולמות"
        },
        {
          "s": 44,
          "text": "(הרצוא שבהם שרוצים לצאת ממציאותם)"
        },
        {
          "s": 45,
          "text": "הוא מגילוי הרוממות דאוא\"ס"
        },
        {
          "s": 46,
          "text": "(סובב)."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה ידוע12,"
        },
        {
          "s": 2,
          "text": "דזה שהבריאה היא בשביל האדם13,"
        },
        {
          "s": 3,
          "text": "הכוונה בזה היא לא רק לבריאת העולמות"
        },
        {
          "s": 4,
          "text": "(כולל גם עולם האצילות ועולמות הא\"ס שלמעלה מאצילות),"
        },
        {
          "s": 5,
          "text": "אלא לכל הגילויים,"
        },
        {
          "s": 6,
          "text": "גם גילויים הכי נעלים."
        },
        {
          "s": 7,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 8,
          "text": "שהכוונה בשני ענינים הנ\"ל שבאוא\"ס,"
        },
        {
          "s": 9,
          "text": "ענין הירידה וההמשכה למטה דאור הממלא וענין ההעלאה והרוממות דאור הסובב,"
        },
        {
          "s": 10,
          "text": "כולל גם השרש דשני ענינים אלה כמו שהם באוא\"ס שלפני הצמצום"
        },
        {
          "s": 11,
          "text": "[האור דעלות הרצון שהוא השרש דאור הממלא והאור שקודם עלות הרצון שהוא השרש דאור הסובב14],"
        },
        {
          "s": 12,
          "text": "היא,"
        },
        {
          "s": 13,
          "text": "בכדי שיהיו"
        },
        {
          "s": 14,
          "text": "(דוגמת)"
        },
        {
          "s": 15,
          "text": "שני ענינים אלה בעבודת האדם."
        },
        {
          "s": 16,
          "text": "דבכללות הם שני הקוין דתורה ותפלה15."
        },
        {
          "s": 17,
          "text": "דתפלה היא העלאה מלמטה למעלה,"
        },
        {
          "s": 18,
          "text": "דע\"י ההתבוננות דתפלה הוא יוצא ממציאותו ועד שבא להתפשטות הגשמיות16."
        },
        {
          "s": 19,
          "text": "ותורה היא המשכה מלמעלה למטה."
        },
        {
          "s": 20,
          "text": "דענין עסק התורה הוא"
        },
        {
          "s": 21,
          "text": "(לא שהאדם מבטל את שכלו,"
        },
        {
          "s": 22,
          "text": "אלא אדרבא),"
        },
        {
          "s": 23,
          "text": "שהתורה נמשכת ומתלבשת בשכלו של האדם,"
        },
        {
          "s": 24,
          "text": "המשכה מלמעלה למטה."
        },
        {
          "s": 25,
          "text": "ויתירה מזו,"
        },
        {
          "s": 26,
          "text": "דההמשכה דתורה"
        },
        {
          "s": 27,
          "text": "(שהיא נמשכת בשכלו של האדם)"
        },
        {
          "s": 28,
          "text": "הוא גם כשהאדם נמצא במצב דהיפך הטהרה17,"
        },
        {
          "s": 29,
          "text": "ע\"ד הענין דאוא\"ס למטה מטה עד אין תכלית,"
        },
        {
          "s": 30,
          "text": "שהוא נמשך להחיות לא רק הנבראים שבעוה\"ז הגשמי אלא גם את הקליפות."
        },
        {
          "s": 31,
          "text": "וכמו שבהענין דלמטה מטה עד אין תכלית,"
        },
        {
          "s": 32,
          "text": "גם כשהוא נמשך למטה להחיות את הנבראים ואפילו את הקליפות,"
        },
        {
          "s": 33,
          "text": "אין האור משתנה עי\"ז18,"
        },
        {
          "s": 34,
          "text": "עד\"ז הוא בההמשכה דתורה,"
        },
        {
          "s": 35,
          "text": "שגם כמו שנמשכת בשכלו של האדם,"
        },
        {
          "s": 36,
          "text": "ואפילו כשהאדם הוא במצב דהיפך הטהרה,"
        },
        {
          "s": 37,
          "text": "היא דבר ה'19."
        }
      ]
    }
  ]
}