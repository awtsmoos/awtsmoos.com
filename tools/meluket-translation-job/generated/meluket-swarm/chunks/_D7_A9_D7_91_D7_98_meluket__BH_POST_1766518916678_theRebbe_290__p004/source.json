{
  "globalIndex": 494,
  "owner": 44,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916678_theRebbe_290__p004",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916678_theRebbe_290__p004",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916678_theRebbe_290",
  "title": "הערות לד\"ה באתי לגני תשי\"ג",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "במאמר שם ס\"ז בתחילתו,"
        },
        {
          "s": 2,
          "text": "אשר כמעט כל הנשמות שבדורותינו נקראים בשם זרע בהמה."
        },
        {
          "s": 3,
          "text": "איפוא המקור ע\"ז?"
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "כן הוא בתורה אור לאדמו\"ר הזקן"
        },
        {
          "s": 1,
          "text": "(בעל התניא והשו\"ע)"
        },
        {
          "s": 2,
          "text": "ר\"פ משפטים."
        },
        {
          "s": 3,
          "text": "והוא מיוסד על מש\"כ בזהר ח\"ב ר\"פ משפטים"
        },
        {
          "s": 4,
          "text": "(צד,"
        },
        {
          "s": 5,
          "text": "סע\"ב)."
        },
        {
          "s": 6,
          "text": "ראה רמ\"ז שם."
        },
        {
          "s": 7,
          "text": "וראה גם לקוטי תורה לרבנו הזקן פ' צו"
        },
        {
          "s": 8,
          "text": "(ח,"
        },
        {
          "s": 9,
          "text": "ב ואילך)."
        },
        {
          "s": 10,
          "text": "שערי תשובה"
        },
        {
          "s": 11,
          "text": "(לבנו אדמו\"ר האמצעי)"
        },
        {
          "s": 12,
          "text": "ח\"א ד\"ה ששים המה."
        },
        {
          "s": 13,
          "text": "ובכ\"מ."
        }
      ]
    }
  ]
}