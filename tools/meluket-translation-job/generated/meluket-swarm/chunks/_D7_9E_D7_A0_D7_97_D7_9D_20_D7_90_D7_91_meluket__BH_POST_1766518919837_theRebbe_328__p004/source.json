{
  "globalIndex": 1026,
  "owner": 26,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919837_theRebbe_328__p004",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919837_theRebbe_328__p004",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919837_theRebbe_328",
  "title": "מאמר לא היו ימים טובים לישראל תשמ\"ז",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ובעומק יותר יש לומר,"
        },
        {
          "s": 1,
          "text": "דזה שבתשעה באב היתה התחלת הענין דגאולה העתידה הוא לא רק ברגע שלאחרי החורבן שאז נולד מושיען של ישראל,"
        },
        {
          "s": 2,
          "text": "אלא גם לפנ\"ז."
        },
        {
          "s": 3,
          "text": "שהרי זה שעלה ארי' והחריב את אריאל הוא על מנת שיבוא ארי' ויבנה אריאל38,"
        },
        {
          "s": 4,
          "text": "דמזה מובן,"
        },
        {
          "s": 5,
          "text": "שהכוונה דיבנה אריאל היתה לפני שהחריב את אריאל39,"
        },
        {
          "s": 6,
          "text": "אלא שאז,"
        },
        {
          "s": 7,
          "text": "היתה כוונה ומחשבה זו בהעלם"
        },
        {
          "s": 8,
          "text": "(בדרגא דמחשבה)"
        },
        {
          "s": 9,
          "text": "ולא נמשכה בגילוי,"
        },
        {
          "s": 10,
          "text": "בכדי שיוכל להיות חורבן ביהמ\"ק,"
        },
        {
          "s": 11,
          "text": "שעי\"ז דוקא יהי' בנין ביהמ\"ק השלישי שגדול יותר מבית ראשון ושני,"
        },
        {
          "s": 12,
          "text": "וברגע שלאחרי החורבן,"
        },
        {
          "s": 13,
          "text": "הותחל הגילוי דגאולה העתידה,"
        },
        {
          "s": 14,
          "text": "נולד מושיען של ישראל."
        },
        {
          "s": 15,
          "text": "אלא שהלידה שבת\"ב הוא רק התחלת הגילוי"
        },
        {
          "s": 16,
          "text": "[כמובן גם מהענינים דת\"ב שישנם גם לאחרי מנחת ת\"ב וגם לאחרי קידוש לבנה במוצאי ת\"ב40],"
        },
        {
          "s": 17,
          "text": "ועיקר הגילוי הוא בט\"ו באב."
        },
        {
          "s": 18,
          "text": "ועפ\"ז יובן הקשר דמעלת חמשה עשר באב עם זה שבחמשה עשר הוא שלימות הלבנה,"
        },
        {
          "s": 19,
          "text": "שהיא שלימות בענין הגילוי,"
        },
        {
          "s": 20,
          "text": "כי ענין חמשה עשר באב הוא שבו הוא גילוי הגאולה שהיתה"
        },
        {
          "s": 21,
          "text": "(בהעלם,"
        },
        {
          "s": 22,
          "text": "במחשבה וכוונה)"
        },
        {
          "s": 23,
          "text": "בת\"ב."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "דהטעם על זה שהציווי41"
        },
        {
          "s": 3,
          "text": "ועשו לי מקדש,"
        },
        {
          "s": 4,
          "text": "שהוא ציווי לדורות לעשות בית לה'42"
        },
        {
          "s": 5,
          "text": "[ציווי על כל בתי מקדשות,"
        },
        {
          "s": 6,
          "text": "כולל גם ביהמ\"ק דלעתיד],"
        },
        {
          "s": 7,
          "text": "נאמר"
        },
        {
          "s": 8,
          "text": "(בגילוי)"
        },
        {
          "s": 9,
          "text": "בנוגע לעשיית המשכן,"
        },
        {
          "s": 10,
          "text": "הוא,"
        },
        {
          "s": 11,
          "text": "לפי שבהמשכן הי' כלול בהעלם גם ביהמ\"ק שהוא דירת קבע43,"
        },
        {
          "s": 12,
          "text": "וגם ביהמ\"ק דלעתיד שהוא אהל בל יצען גו',"
        },
        {
          "s": 13,
          "text": "עיקר ענין הקביעות"
        },
        {
          "s": 14,
          "text": "(כנ\"ל סעיף ג)."
        },
        {
          "s": 15,
          "text": "וע\"ד הידוע44"
        },
        {
          "s": 16,
          "text": "בענין הגאולות,"
        },
        {
          "s": 17,
          "text": "שבהגאולה דיציאת מצרים נפתח הצינור והיו כלולים בה כל הגאולות,"
        },
        {
          "s": 18,
          "text": "כולל גם הגאולה העתידה."
        },
        {
          "s": 19,
          "text": "אלא שהגילוי דביהמ\"ק השלישי ודגאולה השלישית הוא ע\"י העבודה שבזמן הגלות,"
        },
        {
          "s": 20,
          "text": "שהיא ע\"ד עבודת התשובה."
        },
        {
          "s": 21,
          "text": "וכיון שביציאת מצרים היו ישראל במדריגת צדיקים45,"
        },
        {
          "s": 22,
          "text": "לכן,"
        },
        {
          "s": 23,
          "text": "הענין דגאולה העתידה שכלול בהגאולה דיציאת מצרים,"
        },
        {
          "s": 24,
          "text": "הי' אז בהעלם."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש לבאר זה שבחצר המשכן היו חמש עשרה אמה קלעים לכתף,"
        },
        {
          "s": 1,
          "text": "אף שענין זה שייך לביהמ\"ק השלישי,"
        },
        {
          "s": 2,
          "text": "כי במשכן הי' כלול גם ביהמ\"ק וגם ביהמ\"ק השלישי."
        },
        {
          "s": 3,
          "text": "ואעפ\"כ לא היו ימים טובים לישראל כחמשה עשר באב,"
        },
        {
          "s": 4,
          "text": "כי לפני חטא המרגלים,"
        },
        {
          "s": 5,
          "text": "כאשר מצד סדר ההשתלשלות לא הי' נתינת מקום לחורבן ביהמ\"ק ובמילא גם לא לבנין ביהמ\"ק השלישי,"
        },
        {
          "s": 6,
          "text": "הי' זה בתכלית ההעלם."
        },
        {
          "s": 7,
          "text": "ולאחרי חטא המרגלים,"
        },
        {
          "s": 8,
          "text": "כשנגזר על דור המדבר שלא יכנסו לארץ וגם התחלת הענין דחורבן ביהמ\"ק"
        },
        {
          "s": 9,
          "text": "[כי אז היתה התחלת ההמשכה דביהמ\"ק השלישי בהדרגא דמחשבה],"
        },
        {
          "s": 10,
          "text": "הנה בחמשה עשר באב בכל שנה"
        },
        {
          "s": 11,
          "text": "(מתחיל מחמשה עשר באב בו כלו מתי מדבר,"
        },
        {
          "s": 12,
          "text": "ועאכו\"כ לאחרי חורבן ביהמ\"ק)"
        },
        {
          "s": 13,
          "text": "הוא גילוי הפנימיות דחמש עשרה אמה קלעים לכתף שבחצר המשכן,"
        },
        {
          "s": 14,
          "text": "שענינם הוא המשכת עתיק בי\"ה ועי\"ז גם במלכות,"
        },
        {
          "s": 15,
          "text": "ענין אהל בל יצען,"
        },
        {
          "s": 16,
          "text": "ביהמ\"ק השלישי שאין"
        },
        {
          "s": 17,
          "text": "(שייך)"
        },
        {
          "s": 18,
          "text": "בו הפסק."
        },
        {
          "s": 19,
          "text": "ואז מתגלה גם הכוונה הפנימית של הבכי' דתשעה באב הראשון,"
        },
        {
          "s": 20,
          "text": "ויבכו העם בלילה ההוא46"
        },
        {
          "s": 21,
          "text": "שעי\"ז נקבע בכי' לדורות13,"
        },
        {
          "s": 22,
          "text": "שהיא בכדי שתהי' הבכי' למעליותא דלע\"ל,"
        },
        {
          "s": 23,
          "text": "בבכי יבואו47,"
        },
        {
          "s": 24,
          "text": "בכי' של שמחה48"
        },
        {
          "s": 25,
          "text": "מצד התגלות מדרגות הגבוהות49,"
        },
        {
          "s": 26,
          "text": "וע\"ד שאמרו רז\"ל50"
        },
        {
          "s": 27,
          "text": "גבי ר\"ע שכשהשיג סודות התורה בשיר השירים זלגו עיניו דמעות,"
        },
        {
          "s": 28,
          "text": "דמעות של שמחה מצד ריבוי האור51."
        }
      ]
    }
  ]
}