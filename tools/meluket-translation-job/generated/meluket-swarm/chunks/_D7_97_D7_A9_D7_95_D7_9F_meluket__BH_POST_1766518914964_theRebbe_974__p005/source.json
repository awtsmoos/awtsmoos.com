{
  "globalIndex": 203,
  "owner": 3,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914964_theRebbe_974__p005",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914964_theRebbe_974__p005",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518914964_theRebbe_974",
  "title": "מאמר ויהיו חיי שרה תשמ\"ה",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "והנה נתבאר לעיל"
        },
        {
          "s": 2,
          "text": "(סעיף ב)"
        },
        {
          "s": 3,
          "text": "הקשר והשייכות דשני הפירושים בשני חיי שרה"
        },
        {
          "s": 4,
          "text": "(דילה הוו חיין וכולן שוין לטובה),"
        },
        {
          "s": 5,
          "text": "דע\"י שהחיין הן דילי',"
        },
        {
          "s": 6,
          "text": "שהוא הבעה\"ב על כל שני חייו,"
        },
        {
          "s": 7,
          "text": "ביכלתו לפעול שכולן"
        },
        {
          "s": 8,
          "text": "(כל שנותיו,"
        },
        {
          "s": 9,
          "text": "גם השנים שבעבר)"
        },
        {
          "s": 10,
          "text": "יהיו שוין לטובה."
        },
        {
          "s": 11,
          "text": "וצריך להבין השייכות דענין זה בדילה הוו חיין"
        },
        {
          "s": 12,
          "text": "(שהוא הבעה\"ב על כל שני חייו)"
        },
        {
          "s": 13,
          "text": "עם המבואר בהמאמר דענין דילה הוו חיין הוא שגם המורגש הוא בביטול."
        },
        {
          "s": 14,
          "text": "ויש לומר הביאור בזה ע\"פ המבואר במק\"א53,"
        },
        {
          "s": 15,
          "text": "דזה שע\"י תשובה"
        },
        {
          "s": 16,
          "text": "(מאהבה)"
        },
        {
          "s": 17,
          "text": "נעשה שינוי בהעבר הוא,"
        },
        {
          "s": 18,
          "text": "כי שרש הזמן הוא במלכות54,"
        },
        {
          "s": 19,
          "text": "ולמעלה יותר – הקדימה ואיחור שבסדר ההשתלשלות55,"
        },
        {
          "s": 20,
          "text": "וכיון שתשובה היא למעלה מהשתלשלות"
        },
        {
          "s": 21,
          "text": "(שבאדם,"
        },
        {
          "s": 22,
          "text": "שלכן הגילוי שנמשך ע\"י התשובה הוא גילוי שלמעלה מהשתלשלות)56,"
        },
        {
          "s": 23,
          "text": "לכן אין בה ההגבלות דעבר הוה ועתיד."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "והגם שגם עשיית התשובה היא ברגע מסויים שמוגבל בהגדר דזמן,"
        },
        {
          "s": 1,
          "text": "עבר הוה ועתיד,"
        },
        {
          "s": 2,
          "text": "ומצד גדר הזמן אי אפשר שע\"י פעולה בהוה יהי' שינוי בהעבר"
        },
        {
          "s": 3,
          "text": "(כי סיבה צריכה להיות לפני המסובב),"
        },
        {
          "s": 4,
          "text": "מ\"מ,"
        },
        {
          "s": 5,
          "text": "כיון שהתשובה עצמה היא למעלה מהגבלת הזמן,"
        },
        {
          "s": 6,
          "text": "לכן,"
        },
        {
          "s": 7,
          "text": "נמשך על ידה הבל\"ג דלמעלה מזמן גם בהזמן"
        },
        {
          "s": 8,
          "text": "(בהרגע דעשיית תשובה),"
        },
        {
          "s": 9,
          "text": "וכאילו שרגע זה הי' מקודם,"
        },
        {
          "s": 10,
          "text": "לפני המסובב."
        },
        {
          "s": 11,
          "text": "ועפ\"ז יש לבאר השייכות דשני הענינים בדילה הוו חיין"
        },
        {
          "s": 12,
          "text": "[שגם המורגש הוא בביטול,"
        },
        {
          "s": 13,
          "text": "ושהוא בעה\"ב על כל שני חייו],"
        },
        {
          "s": 14,
          "text": "דע\"י שהמורגש"
        },
        {
          "s": 15,
          "text": "(מציאות,"
        },
        {
          "s": 16,
          "text": "גבול)"
        },
        {
          "s": 17,
          "text": "הוא בביטול"
        },
        {
          "s": 18,
          "text": "(למעלה ממציאות והגבלה),"
        },
        {
          "s": 19,
          "text": "עי\"ז,"
        },
        {
          "s": 20,
          "text": "גם בהזמן"
        },
        {
          "s": 21,
          "text": "(גבול)"
        },
        {
          "s": 22,
          "text": "נמשך הבל\"ג דלמעלה מהזמן."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "והגם שענין זה"
        },
        {
          "s": 2,
          "text": "(שהמורגש הוא בביטול)"
        },
        {
          "s": 3,
          "text": "הוא מדריגה נעלית,"
        },
        {
          "s": 4,
          "text": "מ\"מ,"
        },
        {
          "s": 5,
          "text": "כיון שמעשה אבות ואמהות הוא סימן ונתינת כח לבנים,"
        },
        {
          "s": 6,
          "text": "הענין דדילה הוו חיין שהי' אצל שרה הוא הוראה ונתינת כח לכל אחד מישראל שיוכל לעבוד את ה' בשמחה בהתגלות ובמורגש ושאעפ\"כ לא יבוא מזה להרגשת הישות57,"
        },
        {
          "s": 7,
          "text": "כי גם המורגש שלו הוא בביטול"
        },
        {
          "s": 8,
          "text": "(כנ\"ל סעיף ו)."
        },
        {
          "s": 9,
          "text": "וע\"י השמחה בעבודת ה' בכלל,"
        },
        {
          "s": 10,
          "text": "ובפרט כשהשמחה היא בעבודת התשובה עצמה"
        },
        {
          "s": 11,
          "text": "[וכמבואר במק\"א58"
        },
        {
          "s": 12,
          "text": "דשמחה של מצוה היא גם במצות התשובה,"
        },
        {
          "s": 13,
          "text": "ואדרבה,"
        },
        {
          "s": 14,
          "text": "השמחה דמצות התשובה היא גדולה יותר מהשמחה דכל המצוות],"
        },
        {
          "s": 15,
          "text": "עי\"ז מיתוסף עוד יותר בכח התשובה לשנות גם את העבר."
        }
      ]
    }
  ]
}