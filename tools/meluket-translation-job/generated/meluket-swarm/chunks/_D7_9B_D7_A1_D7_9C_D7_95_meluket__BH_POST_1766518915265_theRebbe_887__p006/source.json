{
  "globalIndex": 254,
  "owner": 4,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915265_theRebbe_887__p006",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915265_theRebbe_887__p006",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915265_theRebbe_887",
  "title": "מאמר אתה אחד תשכ\"ט",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר"
        },
        {
          "s": 2,
          "text": "(דיו\"ד כסלו),"
        },
        {
          "s": 3,
          "text": "דזה שישראל נק' בשם מקדשי שמך שייך גם לזה שישראל מוסרים נפשם על קידוש השם."
        },
        {
          "s": 4,
          "text": "וכן הוא גם במאמר הנ\"ל דבעל ההילולא דענין יקדישו את שמך הוא מסירת נפש על קידוש השם."
        },
        {
          "s": 5,
          "text": "ויש לומר,"
        },
        {
          "s": 6,
          "text": "שהשייכות דשני הפירושים ביקדישו את שמך,"
        },
        {
          "s": 7,
          "text": "מסירת נפש על קידוש השם והמשכת אתה קדוש בשמך קדוש,"
        },
        {
          "s": 8,
          "text": "הוא,"
        },
        {
          "s": 9,
          "text": "כי בכדי להגיע ולהמשיך מבחי' אתה קדוש"
        },
        {
          "s": 10,
          "text": "(שלמעלה מגדר העלם וגילוי)"
        },
        {
          "s": 11,
          "text": "צריך להיות בתכלית הביטול,"
        },
        {
          "s": 12,
          "text": "ומסירת נפש היא תכלית הביטול37."
        },
        {
          "s": 13,
          "text": "ויש לומר,"
        },
        {
          "s": 14,
          "text": "דזהו גם הטעם על זה שענין המסירת נפש נק' בשם קידוש השם,"
        },
        {
          "s": 15,
          "text": "כי ע\"י המסירת נפש ממשיכים בהשם מקדושת העצמות."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "וע\"פ הידוע38"
        },
        {
          "s": 1,
          "text": "שעבודת האדם שעל ידה נעשית ההמשכה צריכה להיות מעין ההמשכה,"
        },
        {
          "s": 2,
          "text": "יש לומר,"
        },
        {
          "s": 3,
          "text": "דשני הענינים שבההמשכה דיקדישו את שמך – ההמשכה מאתה קדוש בשמך קדוש,"
        },
        {
          "s": 4,
          "text": "ושעי\"ז נעשה גם בהשם ענין הגילוי – יש דוגמתם בהעבודה דמס\"נ."
        },
        {
          "s": 5,
          "text": "דהמשכת העצמות הוא ע\"י הביטול דמס\"נ"
        },
        {
          "s": 6,
          "text": "(כנ\"ל),"
        },
        {
          "s": 7,
          "text": "וזה שנעשה בהשם"
        },
        {
          "s": 8,
          "text": "(העלם)"
        },
        {
          "s": 9,
          "text": "ענין הגילוי הוא ע\"י שבמס\"נ באה היחידה"
        },
        {
          "s": 10,
          "text": "(העלם שלמעלה מגילוי)"
        },
        {
          "s": 11,
          "text": "לידי גילוי."
        },
        {
          "s": 12,
          "text": "וע\"פ המבואר בתניא39"
        },
        {
          "s": 13,
          "text": "שקיום התורה ומצוותי' תלוי בזה שיזכור תמיד ענין מסירת נפשו לה',"
        },
        {
          "s": 14,
          "text": "יש לומר,"
        },
        {
          "s": 15,
          "text": "שע\"י זכירת ענין המס\"נ,"
        },
        {
          "s": 16,
          "text": "גילוי היחידה הוא"
        },
        {
          "s": 17,
          "text": "(גם)"
        },
        {
          "s": 18,
          "text": "בדרגות הפרטיות שבאדם"
        },
        {
          "s": 19,
          "text": "[דע\"י זכירת ענין המס\"נ נעשית הגדלה והוספה בקיום התומ\"צ],"
        },
        {
          "s": 20,
          "text": "ועי\"ז גם הגילוי שנעשה בהשם הוא לא רק גילוי בכללות אלא גם בדרגות הפרטיות,"
        },
        {
          "s": 21,
          "text": "מתחיל מד' הדרגות שבתפלת אתה אחד כמבואר בארוכה במאמר הנ\"ל דבעל ההילולא,"
        },
        {
          "s": 22,
          "text": "ועד שיהי' הגילוי גם למטה בעוה\"ז הגשמי,"
        },
        {
          "s": 23,
          "text": "וידע כל פעול כי אתה פעלתו40,"
        },
        {
          "s": 24,
          "text": "ובעוה\"ז עצמו – בהתחתון שבו,"
        },
        {
          "s": 25,
          "text": "וראו כל בשר יחדיו כי פי ה' דיבר41,"
        },
        {
          "s": 26,
          "text": "שגם הבשר"
        },
        {
          "s": 27,
          "text": "(לא רק עיני בשר אלא גם הבשר עצמו42)"
        },
        {
          "s": 28,
          "text": "יראה שכל מציאותו הוא הדבר ה' שמהווה אותו בכל רגע מאין ליש."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "ועד\"ז הוא בנוגע לישראל"
        },
        {
          "s": 1,
          "text": "(שעל ידם נעשה גילוי זה),"
        },
        {
          "s": 2,
          "text": "שגם בדרגות הפרטיות דהנשמה יומשך הגילוי דעצם הנשמה,"
        },
        {
          "s": 3,
          "text": "ועד להגילוי דעצם הנשמה כמו שהיא מושרשת בהעצמות,"
        },
        {
          "s": 4,
          "text": "ישראל ומלכא בלחודוהי."
        }
      ]
    }
  ]
}