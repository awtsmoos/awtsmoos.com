{
  "globalIndex": 225,
  "owner": 25,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915124_theRebbe_182__p003",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915124_theRebbe_182__p003",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518915124_theRebbe_182",
  "title": "מאמר ויזרע יצחק בארץ תשכ\"ז",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה על פי הנ\"ל שהעבודה דויזרע יצחק היא זריעת"
        },
        {
          "s": 2,
          "text": "(ירידת והתלבשות)"
        },
        {
          "s": 3,
          "text": "הכחות דנה\"א בקיום המצוות ובבירור נה\"ב,"
        },
        {
          "s": 4,
          "text": "צריך לומר,"
        },
        {
          "s": 5,
          "text": "שענין וימצא מאה שערים הוא"
        },
        {
          "s": 6,
          "text": "(לא המשכה מלמעלה הבאה ע\"י קיום התומ\"צ מצ\"ע,"
        },
        {
          "s": 7,
          "text": "אלא)"
        },
        {
          "s": 8,
          "text": "העלי' דנפש האלקית שע\"י ירידת הכחות שלה במעשה המצוות ובבירור נה\"ב,"
        },
        {
          "s": 9,
          "text": "הצמיחה שע\"י הזריעה."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "והענין הוא,"
        },
        {
          "s": 1,
          "text": "כמבואר בהמאמר24,"
        },
        {
          "s": 2,
          "text": "דמאה שערים הם חמישים שערי בינה שתי פעמים."
        },
        {
          "s": 3,
          "text": "והענין הוא,"
        },
        {
          "s": 4,
          "text": "דבבינה שתי מדריגות"
        },
        {
          "s": 5,
          "text": "(בכללות)."
        },
        {
          "s": 6,
          "text": "יובל וסטרא דיובלא25."
        },
        {
          "s": 7,
          "text": "יובל הוא הבינה עצמה,"
        },
        {
          "s": 8,
          "text": "וסטרא דיובלא הוא לא הבינה עצמה ורק מה שנמשך ממנה26."
        },
        {
          "s": 9,
          "text": "וזהו חמישים שערי בינה שתי פעמים,"
        },
        {
          "s": 10,
          "text": "חמישים שערים שמסטרא דיובלא וחמישים שערים דיובל27"
        },
        {
          "s": 11,
          "text": "עצמו."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "והנה מבואר במק\"א28"
        },
        {
          "s": 1,
          "text": "בפירוש נו\"ן שערי בינה,"
        },
        {
          "s": 2,
          "text": "דכמו ששער כפשוטו הוא בסוף החצר שעל ידו יוצאים לחוץ,"
        },
        {
          "s": 3,
          "text": "עד\"ז הוא בנוגע לנו\"ן שערי בינה,"
        },
        {
          "s": 4,
          "text": "שהם בדרגא תחתונה דבינה,"
        },
        {
          "s": 5,
          "text": "שעל ידם נמשך השכל במדות"
        },
        {
          "s": 6,
          "text": "(דהמשכת השכל במדות הוא יציאה לחוץ מהשכל)."
        },
        {
          "s": 7,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 8,
          "text": "שגם חמישים השערים ביובל עצמו הם במוחין השייכים למדות,"
        },
        {
          "s": 9,
          "text": "אלא שבמוחין אלו עצמם שתי דרגות."
        },
        {
          "s": 10,
          "text": "השערים שמסטרא דיובלא שהם מקור ממש למדות"
        },
        {
          "s": 11,
          "text": "[וכמו הטיית השכל,"
        },
        {
          "s": 12,
          "text": "שכל המטה כלפי חסד ושכל המטה כלפי גבורה28],"
        },
        {
          "s": 13,
          "text": "והשערים דיובל עצמו שהם בהשכל עצמו שלמעלה מהטי' למדות,"
        },
        {
          "s": 14,
          "text": "וענין השערים שמורה על יציאה לחוץ הוא כי כללות שכל זה"
        },
        {
          "s": 15,
          "text": "(גם לפני הטייתו למדות)"
        },
        {
          "s": 16,
          "text": "הוא שכל ששייך למדות29."
        }
      ]
    }
  ]
}