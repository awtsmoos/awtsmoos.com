{
  "globalIndex": 891,
  "owner": 41,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919103_theRebbe_196__p001",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919103_theRebbe_196__p001",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919103_theRebbe_196",
  "title": "מאמר השם נפשנו בחיים תשח\"י",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ קרח,"
        },
        {
          "s": 2,
          "text": "ג' תמוז ה'תשח\"י*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "השם נפשנו בחיים ולא נתן למוט רגלנו1,"
        },
        {
          "s": 1,
          "text": "ומבאר כ\"ק מו\"ח אדמו\"ר במאמרו ד\"ה זה דחג הגאולה י\"ב תמוז2"
        },
        {
          "s": 2,
          "text": "[שהתחלת הגאולה היתה בג' תמוז3],"
        },
        {
          "s": 3,
          "text": "דהחיים שבהם שם נפשנו הם חיים נעלים יותר מחיי הנפש"
        },
        {
          "s": 4,
          "text": "(מצד עצמה)."
        },
        {
          "s": 5,
          "text": "דחיי הנפש הם מוגבלים,"
        },
        {
          "s": 6,
          "text": "דהגם שהנפש הוא חי בעצם"
        },
        {
          "s": 7,
          "text": "(שלמעלה מהתפשטות החיות שמחי' את הגוף,"
        },
        {
          "s": 8,
          "text": "ולא רק מחיות הפרטי אלא גם מחיות הכללי)4,"
        },
        {
          "s": 9,
          "text": "מ\"מ,"
        },
        {
          "s": 10,
          "text": "כיון דזה שהנפש הוא חי בעצם הוא מפני שהקב\"ה הטביע בהנפש טבע זה"
        },
        {
          "s": 11,
          "text": "(שיהי' חי בעצם),"
        },
        {
          "s": 12,
          "text": "לכן,"
        },
        {
          "s": 13,
          "text": "גם חיות זה"
        },
        {
          "s": 14,
          "text": "(דבחינת חי בעצם)"
        },
        {
          "s": 15,
          "text": "הוא בהגבלה,"
        },
        {
          "s": 16,
          "text": "והחיים שבהם שם נפשנו הם למעלה מהטבע5."
        },
        {
          "s": 17,
          "text": "וזהו השם נפשנו בחיים ולא נתן למוט רגלנו,"
        },
        {
          "s": 18,
          "text": "שהכח על זה שרגלנו לא יהיו למוט הוא דוקא מהחיים שלמעלה מהטבע."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ולהבין הטעם על זה שמצד חיי הנפש עצמה,"
        },
        {
          "s": 2,
          "text": "גם מצד בחינת חי בעצם,"
        },
        {
          "s": 3,
          "text": "אפשר להיות למוט רגלנו,"
        },
        {
          "s": 4,
          "text": "והכח על זה שלא יהי' למוט רגלנו הוא דוקא מהחיים שלמעלה מהטבע,"
        },
        {
          "s": 5,
          "text": "וגם להבין השייכות דענין זה להגאולה די\"ב תמוז,"
        },
        {
          "s": 6,
          "text": "יש להקדים מ\"ש בריש פרשתנו6"
        },
        {
          "s": 7,
          "text": "ויקח קרח ותרגם אונקלוס ואתפלג קרח."
        },
        {
          "s": 8,
          "text": "דבכ\"מ שנאמר ויקח תרגם ונסיב וכאן תרגם ואתפלג."
        },
        {
          "s": 9,
          "text": "ואיתא בספר נועם אלימלך7"
        },
        {
          "s": 10,
          "text": "דואתפלג"
        },
        {
          "s": 11,
          "text": "(קרח)"
        },
        {
          "s": 12,
          "text": "הוא ע\"ד רקיע המבדיל בין מים למים."
        },
        {
          "s": 13,
          "text": "ומבאר הצ\"צ8,"
        },
        {
          "s": 14,
          "text": "דפירוש זה"
        },
        {
          "s": 15,
          "text": "(שואתפלג קרח הוא ע\"ד רקיע המבדיל)"
        },
        {
          "s": 16,
          "text": "הוא ע\"פ מה דאיתא בזהר9"
        },
        {
          "s": 17,
          "text": "דרקיע המבדיל הוה מחלוקת שמאלא בימינא כו' כגוונא דא מחלוקת קרח באהרן."
        },
        {
          "s": 18,
          "text": "דמזה מובן,"
        },
        {
          "s": 19,
          "text": "שהשייכות דואתפלג קרח לרקיע המבדיל היא לא רק מפני שהשרש דמחלוקת"
        },
        {
          "s": 20,
          "text": "(איזו מחלוקת שתהי')"
        },
        {
          "s": 21,
          "text": "היא מרקיע המבדיל,"
        },
        {
          "s": 22,
          "text": "כדאיתא במדרש10"
        },
        {
          "s": 23,
          "text": "למה אין כתיב בשני כי טוב כו' שבו נבראת מחלוקת שנאמר11"
        },
        {
          "s": 24,
          "text": "ויהי מבדיל בין מים למים,"
        },
        {
          "s": 25,
          "text": "אלא שגם מחלוקת זו בפרט,"
        },
        {
          "s": 26,
          "text": "מחלוקת קרח באהרן,"
        },
        {
          "s": 27,
          "text": "היא דוגמת"
        },
        {
          "s": 28,
          "text": "(ושרשה היא)"
        },
        {
          "s": 29,
          "text": "המחלוקת דרקיע המבדיל."
        },
        {
          "s": 30,
          "text": "דכמו שהמחלוקת דרקיע המבדיל היא מחלוקת שמאלא בימינא,"
        },
        {
          "s": 31,
          "text": "עד\"ז היא מחלוקת קרח באהרן,"
        },
        {
          "s": 32,
          "text": "דאהרן הוא בקו החסד,"
        },
        {
          "s": 33,
          "text": "ימין,"
        },
        {
          "s": 34,
          "text": "וקרח שהי' לוי הי' מבחינת גבורות,"
        },
        {
          "s": 35,
          "text": "שמאל."
        }
      ]
    }
  ]
}