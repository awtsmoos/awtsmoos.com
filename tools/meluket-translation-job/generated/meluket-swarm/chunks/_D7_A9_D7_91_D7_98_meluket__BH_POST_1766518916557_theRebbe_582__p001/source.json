{
  "globalIndex": 483,
  "owner": 33,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916557_theRebbe_582__p001",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916557_theRebbe_582__p001",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916557_theRebbe_582",
  "title": "מאמר באתי לגני תשי\"ב",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד,"
        },
        {
          "s": 1,
          "text": "יו\"ד שבט,"
        },
        {
          "s": 2,
          "text": "תשי\"ב*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "באתי לגניא"
        },
        {
          "s": 1,
          "text": "אחותי כלה1."
        },
        {
          "s": 2,
          "text": "ואיתא במדרש רבה"
        },
        {
          "s": 3,
          "text": "(במקומו2)"
        },
        {
          "s": 4,
          "text": "לגני לגנוני,"
        },
        {
          "s": 5,
          "text": "למקום שהי' עיקרי בתחילה,"
        },
        {
          "s": 6,
          "text": "דעיקר שכינה בתחתונים היתה,"
        },
        {
          "s": 7,
          "text": "ועל ידי החטאים הנה על ידי חטא עץ הדעת נסתלקה השכינה מארץ לרקיע הא',"
        },
        {
          "s": 8,
          "text": "ועל ידי שאר חטאים נסתלקה מרקיע לרקיע עד רקיע הז'."
        },
        {
          "s": 9,
          "text": "ואח\"כ עמדו צדיקים והורידו את השכינה מרקיע לרקיע,"
        },
        {
          "s": 10,
          "text": "עד שבא השביעי,"
        },
        {
          "s": 11,
          "text": "וכל השביעין חביבין3,"
        },
        {
          "s": 12,
          "text": "שהוא משה,"
        },
        {
          "s": 13,
          "text": "והורידה למטה בארץ."
        },
        {
          "s": 14,
          "text": "וזהו צדיקים יירשו ארץ וישכנו לעד עלי'4,"
        },
        {
          "s": 15,
          "text": "דצדיקים יירשו ארץ שהוא גן עדן לפי שהם ממשיכים ומשכינים5"
        },
        {
          "s": 16,
          "text": "את השכינה בארץ התחתונה,"
        },
        {
          "s": 17,
          "text": "דזהו תכלית הכוונה בבריאת והתהוות העולמות."
        },
        {
          "s": 18,
          "text": "ועיקר הגילוי מה שהמשיכו את השכינה למטה,"
        },
        {
          "s": 19,
          "text": "הוא במקדש,"
        },
        {
          "s": 20,
          "text": "כמ\"ש6"
        },
        {
          "s": 21,
          "text": "ועשו לי מקדש ושכנתי בתוכם."
        },
        {
          "s": 22,
          "text": "והנה דייקו בזה רז\"ל7,"
        },
        {
          "s": 23,
          "text": "בתוכו לא נאמר אלא בתוכם,"
        },
        {
          "s": 24,
          "text": "בתוך כל אחד ואחד מישראל,"
        },
        {
          "s": 25,
          "text": "היינו דבכל אחד ואחד מישראל,"
        },
        {
          "s": 26,
          "text": "על ידי שעובד בעצמו אותם העבודות שהיו במקדש,"
        },
        {
          "s": 27,
          "text": "על ידי זה שוכן בו עיקר שכינה,"
        },
        {
          "s": 28,
          "text": "כמו שהי' בתחלת בריאת העולמות ועוד יותר מכבתחילה,"
        },
        {
          "s": 29,
          "text": "ונעשה עיקר דירה בתחתוניםב."
        },
        {
          "s": 30,
          "text": "והנה8"
        },
        {
          "s": 31,
          "text": "אחת עבודות העיקריות9"
        },
        {
          "s": 32,
          "text": "שהיו במקדש,"
        },
        {
          "s": 33,
          "text": "היא עבודת הקרבנות,"
        },
        {
          "s": 34,
          "text": "שהיא עבודה רוחניית."
        },
        {
          "s": 35,
          "text": "דגם עבודת הקרבנות שהיתה במקדש,"
        },
        {
          "s": 36,
          "text": "שהקריבו בהמה גשמית,"
        },
        {
          "s": 37,
          "text": "הנה גם זה היתה עבודה רוחניית,"
        },
        {
          "s": 38,
          "text": "וראי' על זה מענין השתתפות הכהנים בעבודתם ולוים בשירם וזמרם בעת הבאת הקרבן,"
        },
        {
          "s": 39,
          "text": "שהם ענינים רוחניים,"
        },
        {
          "s": 40,
          "text": "וכמ\"ש בזהרג"
        },
        {
          "s": 41,
          "text": "דכהני בחשאי וברעותא דלבא המשכה,"
        },
        {
          "s": 42,
          "text": "ולווים בשירה וזמרה שהוא ענין העלאה מלמטה למעלה10."
        },
        {
          "s": 43,
          "text": "הרי שגם עבודת הקרבנות במקדש היא עבודה רוחניית,"
        },
        {
          "s": 44,
          "text": "ומכל שכן עבודת הקרבנות כמו שהיא בכל אחד ואחד מישראל,"
        },
        {
          "s": 45,
          "text": "שהיא עבודה רוחניית,"
        },
        {
          "s": 46,
          "text": "וזהו מה שכתוב בהתחלת פרשת הקרבנות11,"
        },
        {
          "s": 47,
          "text": "אדם כי יקריב מכם קרבן להוי',"
        },
        {
          "s": 48,
          "text": "וידועד"
        },
        {
          "s": 49,
          "text": "פירוש כ\"ק אדמו\"ר הזקן בזה,"
        },
        {
          "s": 50,
          "text": "שהי' צריך לומר אדם מכם כי יקריב,"
        },
        {
          "s": 51,
          "text": "ומהו אומרו אדם כי יקריב מכם."
        },
        {
          "s": 52,
          "text": "אלא הפירוש הוא,"
        },
        {
          "s": 53,
          "text": "אדם כי יקריב,"
        },
        {
          "s": 54,
          "text": "כאשר האדם בא להתקרב לאלקות,"
        },
        {
          "s": 55,
          "text": "דזהו ענין הקרבן,"
        },
        {
          "s": 56,
          "text": "דאמאיה"
        },
        {
          "s": 57,
          "text": "איקרי קרבן אלא מפני שמקרב,"
        },
        {
          "s": 58,
          "text": "דקרבנות הוא ענין קירוב הכחות והחושים,"
        },
        {
          "s": 59,
          "text": "הרי מכם קרבן להוי',"
        },
        {
          "s": 60,
          "text": "איהר דאַרפט מקריב זיין פון אייך אַליין."
        },
        {
          "s": 61,
          "text": "והיינו דכמו דענין הקרבנות בגשמיות הוא שלוקחים בהמה חי' ושלמה ושוחטין אותה,"
        },
        {
          "s": 62,
          "text": "היינו שמוציאין ממנה החיות,"
        },
        {
          "s": 63,
          "text": "ואחר כך הוא הקרבת האימורים,"
        },
        {
          "s": 64,
          "text": "שהחלב נשרף באש שעל גבי המזבח,"
        },
        {
          "s": 65,
          "text": "ועוד יותר מזה בקרבן עולה,"
        },
        {
          "s": 66,
          "text": "התחלת הקרבנות,"
        },
        {
          "s": 67,
          "text": "שהוא עולה כליל למזבח,"
        },
        {
          "s": 68,
          "text": "הנה כמו\"כ הוא בעבודת הקרבנות ברוחניות,"
        },
        {
          "s": 69,
          "text": "שצריך להיות בהמה שלמה,"
        },
        {
          "s": 70,
          "text": "היינו שצריך לבדוק עצמו שתהי' הבהמה שבו שלמה,"
        },
        {
          "s": 71,
          "text": "היינו גם הגוף ונפש הבהמית,"
        },
        {
          "s": 72,
          "text": "והבדיקה צריכה להיות אדעתא דנפשי',"
        },
        {
          "s": 73,
          "text": "לא בדרך מצות אנשים מלומדה12,"
        },
        {
          "s": 74,
          "text": "כי באופן זה לא תהי' בדיקה טובה ומספקת."
        },
        {
          "s": 75,
          "text": "אבל כאשר יודע שהדבר נוגע לו בחיי נפשו ממש,"
        },
        {
          "s": 76,
          "text": "הנה אז הוא בודק עצמו בכל פינות נפשו,"
        },
        {
          "s": 77,
          "text": "במוחין ובמדות ובפרט בהג' לבושים מחשבה דבור ומעשה,"
        },
        {
          "s": 78,
          "text": "ואז ידע כל עניניו הדורשים תיקון."
        },
        {
          "s": 79,
          "text": "ולהיות שהדבר נוגע לו בחיי נפשו,"
        },
        {
          "s": 80,
          "text": "יעשה ויקיים בפועל את התיקונים הדרושים שלא יהי' בו מוםו."
        },
        {
          "s": 81,
          "text": "ואחר הבדיקה אז ירצה להיות קרבן,"
        },
        {
          "s": 82,
          "text": "ששוחטו,"
        },
        {
          "s": 83,
          "text": "היינו שהבשר וכו' נשאר בשלימות אלא שמוציאים ממנו החיות,"
        },
        {
          "s": 84,
          "text": "שמוציא החיות מענינים גשמיים,"
        },
        {
          "s": 85,
          "text": "והיינו שגוף הדברים הגשמיים נשאר,"
        },
        {
          "s": 86,
          "text": "אבל משתמש בהם רק בכדי שיהי' לו תוספות כח בעבודת הוי',"
        },
        {
          "s": 87,
          "text": "כמאמרז"
        },
        {
          "s": 88,
          "text": "חמרא וריחא פקחין,"
        },
        {
          "s": 89,
          "text": "דלאח"
        },
        {
          "s": 90,
          "text": "אכלי בשרא דתורא לא דקדקתי טעמו של דבר."
        },
        {
          "s": 91,
          "text": "שכ\"ז הוא בענינים שהם רשות,"
        },
        {
          "s": 92,
          "text": "ובפרט בעניני מצוה,"
        },
        {
          "s": 93,
          "text": "כמו אכילת שבת ויו\"ט,"
        },
        {
          "s": 94,
          "text": "או ציצית מצמר גשמי ותפילין מקלף גשמי,"
        },
        {
          "s": 95,
          "text": "היינו דברים גשמיים שעושים בהם עצמם מצוה,"
        },
        {
          "s": 96,
          "text": "ולא רק הציווי של בכל13"
        },
        {
          "s": 97,
          "text": "דרכיך דעהוט."
        },
        {
          "s": 98,
          "text": "וזהו עבודת הקרבנות,"
        },
        {
          "s": 99,
          "text": "להוציא החיות מענינים הגשמיים,"
        },
        {
          "s": 100,
          "text": "שישתמש בהם רק לעבודת הוי',"
        },
        {
          "s": 101,
          "text": "דאז הוא מכם קרבן,"
        },
        {
          "s": 102,
          "text": "פון אייך אַליין."
        },
        {
          "s": 103,
          "text": "וכאשר האדם מקריב מכם קרבן,"
        },
        {
          "s": 104,
          "text": "אז הוא קרבן להוי' שמתקרב ומתאחד עם הוי'."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "אמנם כאשר יתבונן במעמדו ומצבו ואדעתא דנפשי' כנ\"ל,"
        },
        {
          "s": 2,
          "text": "הנה,"
        },
        {
          "s": 3,
          "text": "לפעמים רבות,"
        },
        {
          "s": 4,
          "text": "יראה ויוכח דגם אפילו אם כעת אינו בעל עבירה,"
        },
        {
          "s": 5,
          "text": "מ\"מ הנה וחטאתי נגדי תמיד14,"
        },
        {
          "s": 6,
          "text": "דחטאותיו שעשה במשך ימי חלדו,"
        },
        {
          "s": 7,
          "text": "ובהם גם אלו שעשה קודם בר מצוה,"
        },
        {
          "s": 8,
          "text": "כמ\"שי"
        },
        {
          "s": 9,
          "text": "כ\"ק אדמו\"ר האמצעי,"
        },
        {
          "s": 10,
          "text": "קיימים הם,"
        },
        {
          "s": 11,
          "text": "כי לא תיקן אותם עדיין."
        },
        {
          "s": 12,
          "text": "וראי' מוכחת שלא תקן אותם,"
        },
        {
          "s": 13,
          "text": "כי אם הי' עושה תשובה כדבעי,"
        },
        {
          "s": 14,
          "text": "הרי אז,"
        },
        {
          "s": 15,
          "text": "לא זו בלבד שלא הי' אצלו הענין דעבירה גוררת עבירה15,"
        },
        {
          "s": 16,
          "text": "אלא,"
        },
        {
          "s": 17,
          "text": "אדרבה,"
        },
        {
          "s": 18,
          "text": "מצד זה שנעשה בעל תשובה,"
        },
        {
          "s": 19,
          "text": "הנה עבודתו מכאן ולהבא היתה צריכה להיות בחילא יתיר16"
        },
        {
          "s": 20,
          "text": "מכפי שהי' עד עתה,"
        },
        {
          "s": 21,
          "text": "דזה שהי' מקודם בארץ צי' וצלמות17,"
        },
        {
          "s": 22,
          "text": "הי' זה מעורר אצלו תשוקה ביותר לאלקות."
        },
        {
          "s": 23,
          "text": "אבל בהתבוננותו במעמדו ומצבו האמיתי,"
        },
        {
          "s": 24,
          "text": "מבלי להקל לעצמו ומבלי להטעות את עצמו כלל ועיקר,"
        },
        {
          "s": 25,
          "text": "הרי הוא מרגיש בנפשו ההיפך מזה לגמרי,"
        },
        {
          "s": 26,
          "text": "דלא זו בלבד שמעמדו ומצבו הקודם לא הביאו להאהבה רבה דזדונות18"
        },
        {
          "s": 27,
          "text": "נעשו לו כזכיותיא,"
        },
        {
          "s": 28,
          "text": "אלא,"
        },
        {
          "s": 29,
          "text": "אדרבה,"
        },
        {
          "s": 30,
          "text": "זה גרם לו והביאו לידי זה שהוא בעביות וגסות,"
        },
        {
          "s": 31,
          "text": "עד שהוא בציור דעבירה גוררת עבירה."
        },
        {
          "s": 32,
          "text": "אשר מכל זה ראי' מוכחת שאצלו הענין דוחטאתי נגדי תמיד אינו באופן שכבר עשה תשובה נכונה אלא שלפי מעמדו ומצבו עתה אין מספיק תשובה הקודמת וצריך כעת תשובה נעלית ביותריב,"
        },
        {
          "s": 33,
          "text": "כ\"א שמלכתחילה לא תקן כלל את עניניו,"
        },
        {
          "s": 34,
          "text": "והם מסך מבדיל בינו לבין אביו שבשמיםיג,"
        },
        {
          "s": 35,
          "text": "ומפסיק ומונע מעבודת הוי'."
        },
        {
          "s": 36,
          "text": "הנה כשמתבונן בכל זה ויודע ג\"כ גודל ענין הקרבנות שהוא קירוב הכחות והחושים,"
        },
        {
          "s": 37,
          "text": "עד שנכלל באש של מעלה,"
        },
        {
          "s": 38,
          "text": "ורזא דקורבנא עולה עד רזא דא\"ס וכמשי\"ת,"
        },
        {
          "s": 39,
          "text": "הנה הוא מקשה לעצמו,"
        },
        {
          "s": 40,
          "text": "איזה שייכות יש לו לענין הקרבנות,"
        },
        {
          "s": 41,
          "text": "ואיך ירצה לקרבן להוי',"
        },
        {
          "s": 42,
          "text": "והוא אין בו מתום19,"
        },
        {
          "s": 43,
          "text": "ולהסיר הקושיא מוסיף כ\"ק מו\"ח אדמו\"ר20"
        },
        {
          "s": 44,
          "text": "על פירוש כ\"ק אדמו\"ר הזקן בתיבת מכם,"
        },
        {
          "s": 45,
          "text": "ואומר,"
        },
        {
          "s": 46,
          "text": "מכם היינו מכם ובכם הדבר תלוי,"
        },
        {
          "s": 47,
          "text": "דאָס איז אָפּהיינגיק פון אייך אַליין,"
        },
        {
          "s": 48,
          "text": "שמבלי הבט על מעמדו ומצבו ועל כל מה שעבר עליו עד עתה,"
        },
        {
          "s": 49,
          "text": "שיודע נגעי לבבו,"
        },
        {
          "s": 50,
          "text": "מ\"מ בכם הדבר תלוי,"
        },
        {
          "s": 51,
          "text": "עד שכל אחד ואחד יכול לומר מתי יגיעו מעשיי למעשי אבותי אברהם יצחק ויעקב21."
        },
        {
          "s": 52,
          "text": "וזהו מכם קרבן להוי',"
        },
        {
          "s": 53,
          "text": "בכם תלוי הדבר להיות קרבן להוי',"
        },
        {
          "s": 54,
          "text": "להתקרב ולהתאחד עם הוי'."
        },
        {
          "s": 55,
          "text": "דקרבנות הם להוי' דוקא,"
        },
        {
          "s": 56,
          "text": "לא לאלקים שהוא בגימטריא הטבע22,"
        },
        {
          "s": 57,
          "text": "כ\"א להוי' דוקא,"
        },
        {
          "s": 58,
          "text": "וכמבואר בזהריד"
        },
        {
          "s": 59,
          "text": "על פסוק זובח לאלקים יחרם,"
        },
        {
          "s": 60,
          "text": "שענין הקרבנות הוא להוי' דוקא,"
        },
        {
          "s": 61,
          "text": "למעלה משם אלקים."
        },
        {
          "s": 62,
          "text": "ובאמת מגיע עוד למעלה יותר,"
        },
        {
          "s": 63,
          "text": "לפני הוי',"
        },
        {
          "s": 64,
          "text": "דרזא דקורבנא עולה עד רזא דא\"סטו,"
        },
        {
          "s": 65,
          "text": "שהוא למעלה גם מהוי',"
        },
        {
          "s": 66,
          "text": "דשם הוי' אף שהוא למעלה משם אלקים,"
        },
        {
          "s": 67,
          "text": "מ\"מ ד' אותיותיו רומזות על צמצום התפשטות המשכה והתפשטות23,"
        },
        {
          "s": 68,
          "text": "וואָס דאָס איז אַ סדר פון השתלשלות,"
        },
        {
          "s": 69,
          "text": "אבל א\"ס הוא למעלה מהוי',"
        },
        {
          "s": 70,
          "text": "ולשם מגיע עבודת הקרבנות."
        },
        {
          "s": 71,
          "text": "וזהו שמסיים בענין ההקרבה לרצונו לפני הוי'."
        },
        {
          "s": 72,
          "text": "דמקודם לזה אומר קרבן להוי' ובסיום הענין,"
        },
        {
          "s": 73,
          "text": "אחרי שאומר מן הבהמה מן הבקר ומן הצאן,"
        },
        {
          "s": 74,
          "text": "אומר לפני הוי',"
        },
        {
          "s": 75,
          "text": "ופירש כ\"ק אדמו\"ר הצ\"צטז,"
        },
        {
          "s": 76,
          "text": "לפני הוי' למעלה מהוי'."
        },
        {
          "s": 77,
          "text": "וזהו ענין הקרבנות,"
        },
        {
          "s": 78,
          "text": "שהעבודה היא לא רק בנפש אלקית,"
        },
        {
          "s": 79,
          "text": "כ\"א מן הבהמה מן הבקר ומן הצאן שהוא נפש הבהמית,"
        },
        {
          "s": 80,
          "text": "ובפרט כמו שהי' במקדש,"
        },
        {
          "s": 81,
          "text": "שהיתה יכולה להיות עבודת הקרבנות בבהמה גשמית ממש,"
        },
        {
          "s": 82,
          "text": "שעל ידי זה הוא מגיע לפני הוי',"
        },
        {
          "s": 83,
          "text": "רזא דא\"ס."
        }
      ]
    }
  ]
}