{
  "globalIndex": 702,
  "owner": 2,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917894_theRebbe_634__p005",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917894_theRebbe_634__p005",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917894_theRebbe_634",
  "title": "מאמר כימי צאתך תשי\"ב",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יש לומר שהחידוש דאראנו נפלאות שיהי' לע\"ל,"
        },
        {
          "s": 2,
          "text": "שגם הנסים המלובשים בטבע יהיו באופן דאראנו נפלאות"
        },
        {
          "s": 3,
          "text": "(שיראו את הנס),"
        },
        {
          "s": 4,
          "text": "הוא גם בהנסים"
        },
        {
          "s": 5,
          "text": "(נפלאות)"
        },
        {
          "s": 6,
          "text": "עצמם."
        },
        {
          "s": 7,
          "text": "דזה שעכשיו הטבע מעלים על הנס שבו הוא לפי שהטבע"
        },
        {
          "s": 8,
          "text": "(גם כשמתלבש בו נס)"
        },
        {
          "s": 9,
          "text": "הוא היפך הנס."
        },
        {
          "s": 10,
          "text": "וכנ\"ל"
        },
        {
          "s": 11,
          "text": "(סעיף ה)"
        },
        {
          "s": 12,
          "text": "שהשינוי"
        },
        {
          "s": 13,
          "text": "(הנס)"
        },
        {
          "s": 14,
          "text": "שנעשה בהטבע הוא היפך חוקי ותכונות הטבע."
        },
        {
          "s": 15,
          "text": "ולכן,"
        },
        {
          "s": 16,
          "text": "הנסים שלמעלה מהטבע הם בגילוי יותר."
        },
        {
          "s": 17,
          "text": "וזה שלע\"ל יהיו"
        },
        {
          "s": 18,
          "text": "(גם)"
        },
        {
          "s": 19,
          "text": "הנסים המלובשים בטבע באופן דאראנו נפלאות"
        },
        {
          "s": 20,
          "text": "(שיראו את הנס שבהטבע),"
        },
        {
          "s": 21,
          "text": "הוא,"
        },
        {
          "s": 22,
          "text": "כי לע\"ל,"
        },
        {
          "s": 23,
          "text": "תהי' עליית הטבע,"
        },
        {
          "s": 24,
          "text": "שגם הטבע יהי' כלי לגילוי אוא\"ס הבל\"ג שיתלבש בו."
        },
        {
          "s": 25,
          "text": "ולכן גם הנסים המלובשים בטבע יהיו בגילוי."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "וזהו שהחידוש דאראנו נפלאות שיהי' לע\"ל הוא בראיית הנפלאות וגם בהנפלאות עצמם,"
        },
        {
          "s": 1,
          "text": "דהנסים המלובשים בטבע עכשיו הם באופן שגם לאחרי הגילוי דאוא\"ס הבל\"ג שמתגלה בהנס,"
        },
        {
          "s": 2,
          "text": "נשאר מציאות"
        },
        {
          "s": 3,
          "text": "(טבע)"
        },
        {
          "s": 4,
          "text": "שמצד ענינו הוא היפך גילוי אור הבל\"ג"
        },
        {
          "s": 5,
          "text": "(אלא שהגילוי דאור הבל\"ג שולט עליו שהנהגתו בפועל תהי' כפי רצונו ית')."
        },
        {
          "s": 6,
          "text": "ובהנסים המלובשים בטבע שיהיו לע\"ל,"
        },
        {
          "s": 7,
          "text": "תהיינה שתי המעלות."
        },
        {
          "s": 8,
          "text": "שהגילוי דאוא\"ס הבל\"ג יהי' בהטבע,"
        },
        {
          "s": 9,
          "text": "ושלא תהי' מציאות שהיא היפך גילוי דהבל\"ג,"
        },
        {
          "s": 10,
          "text": "כיון שגם הטבע יהי' כלי לאוא\"ס הבל\"ג."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ויש לקשר זה עם הידוע42"
        },
        {
          "s": 2,
          "text": "שלע\"ל תהי' הנשמה ניזונית מהגוף."
        },
        {
          "s": 3,
          "text": "דעכשיו הגוף ניזון מהנשמה ולעתיד תהי' הנשמה ניזונית מהגוף."
        },
        {
          "s": 4,
          "text": "דהגם שגם אז יהי' גוף גשמי מ\"מ יהי' ניזון מאלקות ולא יצטרך לאכו\"ש גשמית,"
        },
        {
          "s": 5,
          "text": "ויתירה מזו שהגוף יהי' נעלה יותר מהנשמה."
        },
        {
          "s": 6,
          "text": "והענין הוא,"
        },
        {
          "s": 7,
          "text": "דביטול הגוף לאלקות מגיע למעלה יותר מביטול הנשמה43."
        },
        {
          "s": 8,
          "text": "דזה שהנשמה בטילה לאלקות,"
        },
        {
          "s": 9,
          "text": "מכיון שהיא רוחנית,"
        },
        {
          "s": 10,
          "text": "הביטול שלה קשור עם מציאותה."
        },
        {
          "s": 11,
          "text": "וכאשר פועלים"
        },
        {
          "s": 12,
          "text": "(ע\"י עבודה)"
        },
        {
          "s": 13,
          "text": "ביטול בגוף הגשמי,"
        },
        {
          "s": 14,
          "text": "ביטול זה הוא"
        },
        {
          "s": 15,
          "text": "(לא מצד מציאותו של הגוף,"
        },
        {
          "s": 16,
          "text": "אלא)"
        },
        {
          "s": 17,
          "text": "מצד האלקות."
        },
        {
          "s": 18,
          "text": "אלא שעכשיו,"
        },
        {
          "s": 19,
          "text": "הביטול דהנשמה הוא ביטול במציאות והביטול דהגוף הוא ביטול היש44."
        },
        {
          "s": 20,
          "text": "ולע\"ל,"
        },
        {
          "s": 21,
          "text": "בהביטול דהגוף תהיינה שתי המעלות."
        },
        {
          "s": 22,
          "text": "שהביטול הוא מצד האלקות ושהביטול יהי' בכל מציאותו."
        },
        {
          "s": 23,
          "text": "ולכן לעתיד תהי' הנשמה ניזונית מהגוף."
        }
      ]
    }
  ]
}