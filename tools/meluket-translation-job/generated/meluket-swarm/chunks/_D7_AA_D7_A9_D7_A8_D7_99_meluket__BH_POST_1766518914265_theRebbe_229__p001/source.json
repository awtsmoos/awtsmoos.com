{
  "globalIndex": 101,
  "owner": 1,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914265_theRebbe_229__p001",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914265_theRebbe_229__p001",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914265_theRebbe_229",
  "title": "מאמר כנשר יעיר קנו תשמ\"ב",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ האזינו,"
        },
        {
          "s": 2,
          "text": "י\"ב תשרי ה'תשמ\"ב"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "(הנחה)"
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "כנשר יעיר קנו על גוזליו ירחף גו'1,"
        },
        {
          "s": 1,
          "text": "הנה מה כתיב לעיל מיני'2"
        },
        {
          "s": 2,
          "text": "ימצאהו בארץ מדבר,"
        },
        {
          "s": 3,
          "text": "ואח\"ז מסיים3"
        },
        {
          "s": 4,
          "text": "הוי' בדד ינחנו."
        },
        {
          "s": 5,
          "text": "הנה הפירוש הפשוט בזה הוא,"
        },
        {
          "s": 6,
          "text": "שהקב\"ה נוהג עם בני ישראל ברחמים כמו הנשר המרחף על גוזליו"
        },
        {
          "s": 7,
          "text": "(וכפרש\"י),"
        },
        {
          "s": 8,
          "text": "כלומר,"
        },
        {
          "s": 9,
          "text": "שיש רחמי נשר כפשוטם,"
        },
        {
          "s": 10,
          "text": "ויש רחמים שהם כמו נשר ולמעלה הימנו."
        },
        {
          "s": 11,
          "text": "והנה כל הענינים שבתורה ישנם בכל העולמות עד למעלה מעלה,"
        },
        {
          "s": 12,
          "text": "ומזה מובן,"
        },
        {
          "s": 13,
          "text": "דכשם שיש ב' בחינות אלו בעוה\"ז הגשמי"
        },
        {
          "s": 14,
          "text": "(נשר וכמו נשר),"
        },
        {
          "s": 15,
          "text": "כך הוא בעולמות שלמעלה ממנו,"
        },
        {
          "s": 16,
          "text": "עולמות בי\"ע,"
        },
        {
          "s": 17,
          "text": "עד לעולם האצילות,"
        },
        {
          "s": 18,
          "text": "דאף שיש בו ע\"ס הרי הוא עולם האחדות,"
        },
        {
          "s": 19,
          "text": "ומ\"מ גם בו יש בחי' נשר והיא מדת הרחמים דאצי',"
        },
        {
          "s": 20,
          "text": "ויש בו בחי' כנשר,"
        },
        {
          "s": 21,
          "text": "היינו רחמים שלמעלה ממדת הרחמים4."
        },
        {
          "s": 22,
          "text": "אמנם אעפ\"כ הרי עיקר התורה היא למטה כמאמר5"
        },
        {
          "s": 23,
          "text": "תורה לא בשמים היא,"
        },
        {
          "s": 24,
          "text": "וכתורת הרב המגיד6"
        },
        {
          "s": 25,
          "text": "על מארז\"ל7"
        },
        {
          "s": 26,
          "text": "דע מה למעלה ממך,"
        },
        {
          "s": 27,
          "text": "שכל הענינים שלמעלה תלויים בך,"
        },
        {
          "s": 28,
          "text": "בעבודת האדם הנמצא למטה,"
        },
        {
          "s": 29,
          "text": "ובפרט אחרי מ\"ת שאז ניתנה התורה למטה ולא בשמים היא"
        },
        {
          "s": 30,
          "text": "(כנ\"ל)."
        },
        {
          "s": 31,
          "text": "ועוד זאת,"
        },
        {
          "s": 32,
          "text": "דכל הגבוה יותר יורד למטה יותר8,"
        },
        {
          "s": 33,
          "text": "היינו דהענין הכי נעלה"
        },
        {
          "s": 34,
          "text": "(שבתורה)"
        },
        {
          "s": 35,
          "text": "נמצא דוקא למטה,"
        },
        {
          "s": 36,
          "text": "ומזה מובן גם בענין הנשר,"
        },
        {
          "s": 37,
          "text": "שפסוק זה כולל את ב' הקצוות,"
        },
        {
          "s": 38,
          "text": "דהרחמים הכי עליונים נמשכים דוקא למטה במקום שבו רחמי נשר כפשוטו."
        }
      ]
    }
  ]
}