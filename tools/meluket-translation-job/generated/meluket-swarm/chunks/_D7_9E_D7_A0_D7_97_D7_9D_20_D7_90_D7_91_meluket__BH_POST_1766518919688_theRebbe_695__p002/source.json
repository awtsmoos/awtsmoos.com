{
  "globalIndex": 994,
  "owner": 44,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919688_theRebbe_695__p002",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919688_theRebbe_695__p002",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919688_theRebbe_695",
  "title": "מאמר ציון במשפט תפדה תשל\"ה",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ג)"
        },
        {
          "s": 2,
          "text": "והנה פירוש זה שבחי' ושבי' בצדקה היא למעלה מבחי' ציון במשפט תפדה הוא בהתאם עם הפירוש שבלקו\"ת ובס' הליקוטים להאריז\"ל13"
        },
        {
          "s": 3,
          "text": "עה\"פ ציון במשפט תפדה"
        },
        {
          "s": 4,
          "text": "[אלא ששם מבאר ב' הבחינות בדרגא תחתונה],"
        },
        {
          "s": 5,
          "text": "דציון היא נקודת ציון יסוד שבנוקבא ולפי שהוא חלול והאורות מתגלים שם שם הוא אחיזת החיצונים ולכן אמר שבמשפט כו' גורמין שתפדה ודוחין משם החיצונים,"
        },
        {
          "s": 6,
          "text": "אבל עדיין אין כ\"ז רק כדי שלא יתאחזו בה לבד ותהי' ניכרת שם במקומה ולא תעלה עדיין למקומה הראשון ותצא מביניהם מכל וכל."
        },
        {
          "s": 7,
          "text": "אבל כדי להוציא' מביניהם ולהעלותה ולהושיבה למקומה הראשון צריך שיעשו כו' צדקה כו' וזהו ושבי' בצדקה להשיבה למקומה צריך צדקה ובזכות הצדקה תשוב למקומה הראשון."
        },
        {
          "s": 8,
          "text": "הרי שושבי' בצדקה הוא למעלה מציון במשפט תפדה."
        },
        {
          "s": 9,
          "text": "וכן מובן גם בפשטות,"
        },
        {
          "s": 10,
          "text": "כמש\"כ שם,"
        },
        {
          "s": 11,
          "text": "דמשפט"
        },
        {
          "s": 12,
          "text": "(הגם דמשפט איהו רחמי14)"
        },
        {
          "s": 13,
          "text": "ענינו הוא כפי שורת הדין,"
        },
        {
          "s": 14,
          "text": "משא\"כ צדקה הוא לפנים משורת הדין."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ד)"
        },
        {
          "s": 2,
          "text": "והנה מבואר במ\"א15"
        },
        {
          "s": 3,
          "text": "שפירושים שהם בכתוב אחד שייכים זל\"ז,"
        },
        {
          "s": 4,
          "text": "ומזה מובן,"
        },
        {
          "s": 5,
          "text": "אשר הפירוש דושבי' בצדקה הוא למטה מציון במשפט תפדה יש לו שייכות עם הפירוש שושבי' בצדקה הוא למעלה מציון במשפט תפדה"
        },
        {
          "s": 6,
          "text": "(והוא ע\"ד הידוע16"
        },
        {
          "s": 7,
          "text": "בענין חותם המתהפך)."
        },
        {
          "s": 8,
          "text": "והענין הוא,"
        },
        {
          "s": 9,
          "text": "הנה ידוע17"
        },
        {
          "s": 10,
          "text": "שמרז\"ל18"
        },
        {
          "s": 11,
          "text": "תלמוד גדול הוא עכשיו,"
        },
        {
          "s": 12,
          "text": "אבל בימות המשיח יהי' מעשה גדול."
        },
        {
          "s": 13,
          "text": "והנה תלמוד ומעשה הם בדוגמת צומח ודומם,"
        },
        {
          "s": 14,
          "text": "ולעתיד יהי' מעשה גדול,"
        },
        {
          "s": 15,
          "text": "כי אז תתגלה מעלת הדומם."
        },
        {
          "s": 16,
          "text": "והוא ע\"ד המבואר19"
        },
        {
          "s": 17,
          "text": "ע\"פ ויגש אליו יהודה בענין ההפרש בין משכן לביהמ\"ק"
        },
        {
          "s": 18,
          "text": "[שענין זה יש לו שייכות מיוחדת לשבת חזון,"
        },
        {
          "s": 19,
          "text": "וכמ\"ש הרר\"ה מפּאַריטש20"
        },
        {
          "s": 20,
          "text": ": ויתבאר עומק ענין זה"
        },
        {
          "s": 21,
          "text": "(שבשבת חזון מראין לכאו\"א המקדש דלעתיד)"
        },
        {
          "s": 22,
          "text": "עם המבואר במ\"א בענין ויגש אליו יהודה,"
        },
        {
          "s": 23,
          "text": "קורות בתינו כו']."
        },
        {
          "s": 24,
          "text": "שהמשכן הי' עצי שטים,"
        },
        {
          "s": 25,
          "text": "ארזים,"
        },
        {
          "s": 26,
          "text": "צומח,"
        },
        {
          "s": 27,
          "text": "משא\"כ ביהמ\"ק הי' מאבנים ועפר דוקא"
        },
        {
          "s": 28,
          "text": "(ואסור לעשות בו עץ בולט כו' כמ\"ש21"
        },
        {
          "s": 29,
          "text": "לא תטע לך אשרה כל עץ)."
        },
        {
          "s": 30,
          "text": "לפי שבביהמ\"ק הי' גילוי מעלת הדומם."
        },
        {
          "s": 31,
          "text": "ועיקר גילוי מעלת הדומם יהי' לע\"ל"
        },
        {
          "s": 32,
          "text": "(בביהמ\"ק השלישי),"
        },
        {
          "s": 33,
          "text": "שאז יתעלה יהודה"
        },
        {
          "s": 34,
          "text": "(בחי' דומם)"
        },
        {
          "s": 35,
          "text": "להיות למעלה מיוסף"
        },
        {
          "s": 36,
          "text": "(בחי' צומח),"
        },
        {
          "s": 37,
          "text": "וכמ\"ש22"
        },
        {
          "s": 38,
          "text": "הנה אני לוקח את עץ יוסף גו' ונתתי אותם עליו את עץ יהודה גו' ועבדי דוד מלך עליהם גו' ודוד עבדי נשיא להם לעולם23."
        },
        {
          "s": 39,
          "text": "דזהו ג\"כ מה שלע\"ל יהי' מעשה גדול,"
        },
        {
          "s": 40,
          "text": "כי ענינו של דוד הוא מעשה24,"
        },
        {
          "s": 41,
          "text": "וכמבואר במ\"א25"
        },
        {
          "s": 42,
          "text": "בענין ההפרש שבין דוד ליהונתן"
        },
        {
          "s": 43,
          "text": "(מל' ויסוד ע\"ד יודא ויוסף)"
        },
        {
          "s": 44,
          "text": "בן שאול,"
        },
        {
          "s": 45,
          "text": "דיהונתן בן שאול הו\"ע תלמוד"
        },
        {
          "s": 46,
          "text": "(עבודתו ע\"פ טו\"ד משא\"כ שמוע מזבח טוב"
        },
        {
          "s": 47,
          "text": "(קב\"ע דדוד)"
        },
        {
          "s": 48,
          "text": "ונאמר שאול מרחובות הנהר,"
        },
        {
          "s": 49,
          "text": "דרחובות הנהר הו\"ע הבנה והשגה,"
        },
        {
          "s": 50,
          "text": "תלמוד)"
        },
        {
          "s": 51,
          "text": "ודוד הוא בחי' מעשה."
        },
        {
          "s": 52,
          "text": "ונאמר עד דוד הגדיל."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ו)"
        },
        {
          "s": 2,
          "text": "והנה הגם שעכשיו תלמוד גדול,"
        },
        {
          "s": 3,
          "text": "מ\"מ יש כמה ענינים"
        },
        {
          "s": 4,
          "text": "(גם עכשיו)"
        },
        {
          "s": 5,
          "text": "שבהם מעלה למעשה על התלמוד."
        },
        {
          "s": 6,
          "text": "וכמו מה שמבטלין ת\"ת מפני מצוה שא\"א לעשותה ע\"י אחרים26."
        },
        {
          "s": 7,
          "text": "ותוכן אגה\"ק ד\"ה איהו וחיוהי"
        },
        {
          "s": 8,
          "text": "[שכתבה כ\"ק אדמו\"ר הזקן בכפר פּייענא בימים שלפני הסתלקותו27]"
        },
        {
          "s": 9,
          "text": "ה\"ה בהמעלה דמצוות מעשיות."
        },
        {
          "s": 10,
          "text": "וטעם הדבר שגם עכשיו מדגישים מעלת המעשה י\"ל שהוא לפי שכל הגילויים דלעתיד תלויים במעשינו ועבודתנו כל משך זמן הגלות28,"
        },
        {
          "s": 11,
          "text": "ומכיון שלעתיד יהי' מעשה גדול,"
        },
        {
          "s": 12,
          "text": "לכן גם עכשיו מדגישים מעלת המעשה,"
        },
        {
          "s": 13,
          "text": "כי עי\"ז יהי' הגילוי דלעתיד שאז יהי' מעשה גדול."
        },
        {
          "s": 14,
          "text": "וע\"ד המבואר באגה\"ק29"
        },
        {
          "s": 15,
          "text": "שלא אמרו רז\"ל ת\"ת שקול כנגד גמ\"ח אלא בימיהם משא\"כ בעתים הללו בעקבות משיחא,"
        },
        {
          "s": 16,
          "text": "עיקר עבודת ה' היא עבודת הצדקה."
        }
      ]
    }
  ]
}