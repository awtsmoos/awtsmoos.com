{
  "globalIndex": 698,
  "owner": 48,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917894_theRebbe_634__p001",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917894_theRebbe_634__p001",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917894_theRebbe_634",
  "title": "מאמר כימי צאתך תשי\"ב",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "אחרון של פסח ה'תשי\"ב*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "כימי צאתך מארץ מצרים אראנו נפלאות1,"
        },
        {
          "s": 1,
          "text": "וצריך להבין,"
        },
        {
          "s": 2,
          "text": "הרי גאולה העתידה תהי' נעלית הרבה יותר מהגאולה דיציאת מצרים"
        },
        {
          "s": 3,
          "text": "[שלכן,"
        },
        {
          "s": 4,
          "text": "לפי דעת בן זומא2,"
        },
        {
          "s": 5,
          "text": "אין מזכירין יציאת מצרים בימות המשיח."
        },
        {
          "s": 6,
          "text": "וגם לדעת חכמים2"
        },
        {
          "s": 7,
          "text": "שמזכירין יציאת מצרים בימות המשיח,"
        },
        {
          "s": 8,
          "text": "לפי שיש מעלה ביציאת מצרים גם לגבי גאולה העתידה,"
        },
        {
          "s": 9,
          "text": "הגאולה דיציאת מצרים תהי' טפילה לגאולה העתידה2],"
        },
        {
          "s": 10,
          "text": "ומהו אומרו כימי צאתך מארץ מצרים אראנו נפלאות,"
        },
        {
          "s": 11,
          "text": "שהעילוי דגאולה העתידה הוא שגם אז יהי' אראנו נפלאות כמו שהי' ביציאת מצרים."
        },
        {
          "s": 12,
          "text": "גם צריך להבין שמדייק אראנו נפלאות,"
        },
        {
          "s": 13,
          "text": "שעיקר המעלה דגאולה העתידה היא לא בהנפלאות עצמם שיהיו אז אלא בזה שהקב\"ה יראה את הנפלאות."
        },
        {
          "s": 14,
          "text": "גם צריך להבין אומרו אראנו לשון נסתר,"
        },
        {
          "s": 15,
          "text": "הרי בתחלה אומר"
        },
        {
          "s": 16,
          "text": "(כימי)"
        },
        {
          "s": 17,
          "text": "צאתך לשון נוכח,"
        },
        {
          "s": 18,
          "text": "והול\"ל אראך."
        },
        {
          "s": 19,
          "text": "ומ\"ש בזהר3"
        },
        {
          "s": 20,
          "text": "דמ\"ש אראנו לשון נסתר הוא לפי שאראנו קאי על משה,"
        },
        {
          "s": 21,
          "text": "צריך ביאור הקשר דפירוש זה עם הפירוש כפשוטו שאראנו קאי על ישראל."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ונקודת הביאור בזה,"
        },
        {
          "s": 1,
          "text": "דבנסים יש"
        },
        {
          "s": 2,
          "text": "(בכללות)"
        },
        {
          "s": 3,
          "text": "שני סוגים."
        },
        {
          "s": 4,
          "text": "נסים שלמעלה מהטבע"
        },
        {
          "s": 5,
          "text": "[כהנסים שהיו ביציאת מצרים,"
        },
        {
          "s": 6,
          "text": "הפיכת מים לדם וכו' ועד להנס דקריעת ים סוף שנהפך ים ליבשה],"
        },
        {
          "s": 7,
          "text": "ונסים המלובשים בדרכי הטבע."
        },
        {
          "s": 8,
          "text": "ובהם גופא שני אופנים."
        },
        {
          "s": 9,
          "text": "שלבושי הטבע הם באופן שניכר שהם רק לבוש להנס שמתלבש בהם."
        },
        {
          "s": 10,
          "text": "כנסים דחנוכה ופורים,"
        },
        {
          "s": 11,
          "text": "דעם היותם מלובשים בדרכי הטבע,"
        },
        {
          "s": 12,
          "text": "מ\"מ הי' ניכר בגילוי"
        },
        {
          "s": 13,
          "text": "(ועד שראו כל אפסי ארץ4)"
        },
        {
          "s": 14,
          "text": "הנס שבהם."
        },
        {
          "s": 15,
          "text": "ושלבושי הטבע מעלימים על הנס שמלובש בהם5."
        },
        {
          "s": 16,
          "text": "וידוע6"
        },
        {
          "s": 17,
          "text": "דשרש הנסים המלובשים בטבע הוא ממקום נעלה יותר משרש הנסים שלמעלה מהטבע."
        },
        {
          "s": 18,
          "text": "ושרש הנסים שמלובשים בטבע באופן שאין ניכר אפילו שלבושי הטבע הם רק לבוש הוא ממקום נעלה עוד יותר7."
        },
        {
          "s": 19,
          "text": "כמ\"ש8"
        },
        {
          "s": 20,
          "text": "לעושה נפלאות גדולות לבדו ואמרו רז\"ל9"
        },
        {
          "s": 21,
          "text": "אפילו בעל הנס אינו מכיר בנסו,"
        },
        {
          "s": 22,
          "text": "שהשרש דנפלאות אלו"
        },
        {
          "s": 23,
          "text": "(שאין בעל הנס מכיר בנסו)"
        },
        {
          "s": 24,
          "text": "הוא מבחינת לבדו10."
        },
        {
          "s": 25,
          "text": "וזהו החידוש בזה שבגאולה העתידה יהי' אראנו נפלאות,"
        },
        {
          "s": 26,
          "text": "כי הנפלאות שבגאולה העתידה יומשכו ממנו ית' לבדו,"
        },
        {
          "s": 27,
          "text": "כמרז\"ל11"
        },
        {
          "s": 28,
          "text": "לשעבר"
        },
        {
          "s": 29,
          "text": "(ביציאת מצרים)"
        },
        {
          "s": 30,
          "text": "אני ובית דיני הייתי מהלך לפניהם אבל לעתיד לבוא אני לבדי,"
        },
        {
          "s": 31,
          "text": "דהנסים שהיו ביציאת מצרים נמשכו ממנו ית' דרך בית דינו והנסים שבגאולה העתידה יהיו ממנו לבדו"
        },
        {
          "s": 32,
          "text": "(שלא ע\"י בית דינו)12."
        },
        {
          "s": 33,
          "text": "וזהו החידוש דאראנו נפלאות,"
        },
        {
          "s": 34,
          "text": "דהגם שהנפלאות הנמשכים ממנו ית' לבדו הם"
        },
        {
          "s": 35,
          "text": "(בדרך כלל)"
        },
        {
          "s": 36,
          "text": "באופן שהוא לבדו יודע שזה נס,"
        },
        {
          "s": 37,
          "text": "מ\"מ יהי' אראנו נפלאות,"
        },
        {
          "s": 38,
          "text": "שיהי' נראה בגילוי הנס שבהם."
        }
      ]
    }
  ]
}