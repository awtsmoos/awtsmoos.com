{
  "globalIndex": 927,
  "owner": 27,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919272_theRebbe_883__p003",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919272_theRebbe_883__p003",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919272_theRebbe_883",
  "title": "מאמר נתת ליראיך תשל\"ו",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ולהבין כ\"ז בפרטיות יותר,"
        },
        {
          "s": 2,
          "text": "יש להקדים תחלה כללות ענין ירידת הנשמה למטה שהיא ירידה גדולה מאיגרא רמה לבירא עמיקתא58."
        },
        {
          "s": 3,
          "text": "דהנה הנשמה קודם ירידתה למטה טהורה היא59,"
        },
        {
          "s": 4,
          "text": "ויש בזה כמה פירושים60,"
        },
        {
          "s": 5,
          "text": "א' דקאי על עולם האצילות,"
        },
        {
          "s": 6,
          "text": "ב' טהירו תתאה,"
        },
        {
          "s": 7,
          "text": "ג' טהירו עילאה."
        },
        {
          "s": 8,
          "text": "וירידתה היא למטה ביותר,"
        },
        {
          "s": 9,
          "text": "לא רק לעולמות בי\"ע,"
        },
        {
          "s": 10,
          "text": "עלמין דפרודא בכלל,"
        },
        {
          "s": 11,
          "text": "כ\"א לעוה\"ז התחתון שאין תחתון למטה ממנו61,"
        },
        {
          "s": 12,
          "text": "שרובו ככולו רע רק מעט טוב מעורב בתוכה62,"
        },
        {
          "s": 13,
          "text": "עד שמעשה עוה\"ז קשים כו'"
        },
        {
          "s": 14,
          "text": "(כמבואר בתניא63"
        },
        {
          "s": 15,
          "text": "בשם הע\"ח64),"
        },
        {
          "s": 16,
          "text": "ועוד זאת,"
        },
        {
          "s": 17,
          "text": "דהעבודה בעוה\"ז גופא היא בהמטה מטה ביותר,"
        },
        {
          "s": 18,
          "text": "במקום דלמצרים ירדתם ובאופן דיצה\"ר יש ביניכם65,"
        },
        {
          "s": 19,
          "text": "שצריך ללחום עם היצה\"ר והיום אומר לו עשה כך ולמחר כו' עבוד ע\"ז66,"
        },
        {
          "s": 20,
          "text": "שהוא ההיפך של אנכי ולא יהי' לך"
        },
        {
          "s": 21,
          "text": "(השרש לרמ\"ח מ\"ע ושס\"ה ל\"ת,"
        },
        {
          "s": 22,
          "text": "כמבואר בתניא67),"
        },
        {
          "s": 23,
          "text": "אלא שירידה זו צורך עלי'68."
        },
        {
          "s": 24,
          "text": "כי אף שהנשמה לא ירדה לתקן עצמה כו' אלא לתקן גופו ונפשו הבהמית וחלקו בעולם"
        },
        {
          "s": 25,
          "text": "(כמבואר בע\"ח69"
        },
        {
          "s": 26,
          "text": "הובא בתניא70),"
        },
        {
          "s": 27,
          "text": "אבל מ\"מ,"
        },
        {
          "s": 28,
          "text": "ע\"י ירידת הנשמה למטה הרי היא מתעלית לבחי' נעלית יותר מכמו שהיתה קודם ירידתה71,"
        },
        {
          "s": 29,
          "text": "שלמעלה גם מטה\"ע."
        },
        {
          "s": 30,
          "text": "ועוד יותר,"
        },
        {
          "s": 31,
          "text": "לבחי' שאין לה ערך ושייכות לענין של השתלשלות ודרגא ומעלה,"
        },
        {
          "s": 32,
          "text": "עד שאין שייך לומר אפילו זה שיש בה מעלה לגבי סדר השתלשלות,"
        },
        {
          "s": 33,
          "text": "כ\"א בלשון הידוע72"
        },
        {
          "s": 34,
          "text": "לאשתאבא בגופא דמלכא,"
        },
        {
          "s": 35,
          "text": "בעצמותו ומהותו ית'73."
        },
        {
          "s": 36,
          "text": "ובלשון הזהר במ\"א74,"
        },
        {
          "s": 37,
          "text": "בבחי' זו דלא משתכחי במלכא אלא ישראל בלחודייהו"
        },
        {
          "s": 38,
          "text": "(שלמעלה גם מתומ\"צ)."
        },
        {
          "s": 39,
          "text": "והעלי' היא ע\"י העבודה בתומ\"צ,"
        },
        {
          "s": 40,
          "text": "דאני נבראתי לשמש את קוני75,"
        },
        {
          "s": 41,
          "text": "וכמ\"ש76"
        },
        {
          "s": 42,
          "text": "ויניחהו גו' לעבדה ולשמרה,"
        },
        {
          "s": 43,
          "text": "לעבדה אלו רמ\"ח מ\"ע ולשמרה אלו שס\"ה מל\"ת77"
        },
        {
          "s": 44,
          "text": "(דכל מקום שנאמר השמר כו' אינו אלא בל\"ת78),"
        },
        {
          "s": 45,
          "text": "וצ\"ל לזה הקדמת התורה דגדול לימוד שמביא לידי מעשה79."
        },
        {
          "s": 46,
          "text": "וגם ניצוח היצה\"ר הוא ע\"י התורה כמארז\"ל80"
        },
        {
          "s": 47,
          "text": "בראתי יצה\"ר ובראתי לו תורה תבלין,"
        },
        {
          "s": 48,
          "text": "ואם פגע בך מנוול זה משכהו לבהמ\"ד כו'."
        },
        {
          "s": 49,
          "text": "וז\"ש42"
        },
        {
          "s": 50,
          "text": "סור מרע ועשה טוב בקש שלום ורדפהו,"
        },
        {
          "s": 51,
          "text": "דקאי על מ\"ע ומל\"ת ותורה,"
        },
        {
          "s": 52,
          "text": "כמבואר בלקו\"ת פרשתנו"
        },
        {
          "s": 53,
          "text": "(בלק)81."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "אמנם צלה\"ב טעם הדבר,"
        },
        {
          "s": 2,
          "text": "שדוקא ע\"י עבודת הנשמה למטה הרי היא מתעלית לבחי' נעלית יותר מכמו שהיתה לפני ירידתה,"
        },
        {
          "s": 3,
          "text": "ועד לעלי' כזו שהיא שלא בערך מדריגתה הקודמת."
        },
        {
          "s": 4,
          "text": "והענין הוא82,"
        },
        {
          "s": 5,
          "text": "כי הניצוצות שבענינים הגשמיים שרשם בעולם התוהו שלמעלה מעולם התיקון."
        },
        {
          "s": 6,
          "text": "וכמש\"נ83"
        },
        {
          "s": 7,
          "text": "כי לא על הלחם לבדו יחי' האדם כי על כל מוצא פי ה' יחי' האדם."
        },
        {
          "s": 8,
          "text": "ומפרש האריז\"ל84"
        },
        {
          "s": 9,
          "text": "דמוצא פי ה' שבלחם הוא הניצוץ אלקי שבו."
        },
        {
          "s": 10,
          "text": "ואף שגם בהאדם ישנו מוצא פי ה' המחי' אותו,"
        },
        {
          "s": 11,
          "text": "מ\"מ צריך להמוצא פי ה' שבלחם דוקא,"
        },
        {
          "s": 12,
          "text": "כי כל הגבוה יותר יורד למטה יותר85."
        },
        {
          "s": 13,
          "text": "וכמשל האבן הנמצאת בראש החומה,"
        },
        {
          "s": 14,
          "text": "הנה כאשר היא נופלת למטה ה\"ה נופלת בריחוק יותר מן החומה מהאבן הנופלת מאמצע החומה כו'86."
        },
        {
          "s": 15,
          "text": "ולכן,"
        },
        {
          "s": 16,
          "text": "מכיון שהמוצא פי ה' שבלחם נפל למטה יותר מהמוצא פי ה' שבאדם,"
        },
        {
          "s": 17,
          "text": "שהרי הלחם הוא מצומח,"
        },
        {
          "s": 18,
          "text": "ובפרט שבעת האכילה כבר אינו צומח כ\"א דומם"
        },
        {
          "s": 19,
          "text": "(ועוד זאת,"
        },
        {
          "s": 20,
          "text": "שאכילת לחם היא עם מלח87"
        },
        {
          "s": 21,
          "text": "שהוא דומם),"
        },
        {
          "s": 22,
          "text": "והאדם הוא מדבר,"
        },
        {
          "s": 23,
          "text": "הרי זה גופא הוכחה שהניצוצות הנמצאים בהלחם שרשם הוא למעלה מהמוצא פי ה' שבאדם,"
        },
        {
          "s": 24,
          "text": "גם מאדם העליון,"
        },
        {
          "s": 25,
          "text": "בחי' תיקון."
        },
        {
          "s": 26,
          "text": "ולכן דוקא על ידם יחי' האדם,"
        },
        {
          "s": 27,
          "text": "האדם שלמטה,"
        },
        {
          "s": 28,
          "text": "ו"
        },
        {
          "s": 29,
          "text": "(עי\"ז)"
        },
        {
          "s": 30,
          "text": "האדם העליון כביכול88."
        },
        {
          "s": 31,
          "text": "ולהעיר מעוד ענין בזה,"
        },
        {
          "s": 32,
          "text": "המבואר במ\"א89"
        },
        {
          "s": 33,
          "text": "בארוכה ההפרש שבין עולם התיקון לעולם התוהו,"
        },
        {
          "s": 34,
          "text": "דשניהם נתהוו ברצון העליון,"
        },
        {
          "s": 35,
          "text": "אלא שבעולם התיקון הוא באופן דדין הניין לי'90,"
        },
        {
          "s": 36,
          "text": "ובעולם התוהו הוא באופן דדין לא הניין לי'90."
        },
        {
          "s": 37,
          "text": "והיינו,"
        },
        {
          "s": 38,
          "text": "דבעולם התוהו ישנו הרצון העליון,"
        },
        {
          "s": 39,
          "text": "אלא שהוא בהעלם והסתר,"
        },
        {
          "s": 40,
          "text": "ובגילוי הו\"ע של היפך הרצון דדין לא הניין לי'."
        },
        {
          "s": 41,
          "text": "ולכן משתלשל מזה למטה,"
        },
        {
          "s": 42,
          "text": "שהענינים שנתהוו מעולם התוהו,"
        },
        {
          "s": 43,
          "text": "עם היות שבגילוי הם ענינים של היפך הקדושה דדין לא הניין לי',"
        },
        {
          "s": 44,
          "text": "מ\"מ,"
        },
        {
          "s": 45,
          "text": "גם בהם ישנם ניצוצות דקדושה,"
        },
        {
          "s": 46,
          "text": "ואדרבה,"
        },
        {
          "s": 47,
          "text": "דוקא בהם ישנו תוקף,"
        },
        {
          "s": 48,
          "text": "של אורות דתוהו."
        },
        {
          "s": 49,
          "text": "וזהו מה שע\"י ירידת הנשמה למטה ה\"ה מתעלית לבחי' נעלית יותר מכמו שהיתה קודם ירידתה,"
        },
        {
          "s": 50,
          "text": "שזהו מצד הבירורים של הניצוצות דעולם התוהו,"
        },
        {
          "s": 51,
          "text": "שעי\"ז יורש האורות דתוהו,"
        },
        {
          "s": 52,
          "text": "שזהו\"ע מורשה קהלת יעקב91."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "והנה,"
        },
        {
          "s": 2,
          "text": "עפ\"י הכלל הנ\"ל דכל הגבוה יותר נופל למטה יותר מוכרח לומר,"
        },
        {
          "s": 3,
          "text": "שגם בניצוצות דתוהו גופא,"
        },
        {
          "s": 4,
          "text": "כל מה שנפל למטה יותר שרשו ממקום גבוה יותר."
        },
        {
          "s": 5,
          "text": "שמזה מובן שיש מעלה בהבירורים שע\"י מל\"ת על הבירורים דמ\"ע,"
        },
        {
          "s": 6,
          "text": "דעם היות שגם הניצוצות שבדברים גשמיים שבהם הוא קיום מ\"ע שרשם מעולם התוהו,"
        },
        {
          "s": 7,
          "text": "מ\"מ אין הנפילה בהם כ\"כ,"
        },
        {
          "s": 8,
          "text": "שהרי הן עניני היתר שמק\"נ."
        },
        {
          "s": 9,
          "text": "משא\"כ במל\"ת,"
        },
        {
          "s": 10,
          "text": "שהן בענינים שהן אסורים וקשורים בידי החיצונים92,"
        },
        {
          "s": 11,
          "text": "הרי זה גופא הוכחה ששרש הניצוצות המלובשים בהם הוא למעלה יותר."
        },
        {
          "s": 12,
          "text": "שלכן ע\"י העבודה דמל\"ת,"
        },
        {
          "s": 13,
          "text": "גם בתחילת העבודה שאינו מהפך את הזדונות לזכיות ורק דוחה אותם,"
        },
        {
          "s": 14,
          "text": "נמשך אור נעלה יותר מכמו בהעבודה דמ\"ע."
        },
        {
          "s": 15,
          "text": "וכמבואר בלקו\"ת93,"
        },
        {
          "s": 16,
          "text": "דמ\"ע שייכות לו\"ה,"
        },
        {
          "s": 17,
          "text": "בחי' והנגלות94,"
        },
        {
          "s": 18,
          "text": "ול\"ת לי\"ה,"
        },
        {
          "s": 19,
          "text": "בחי' הנסתרות לה\"א94"
        },
        {
          "s": 20,
          "text": "(וגם – י\"ה הוא שם קדוש בפ\"ע95),"
        },
        {
          "s": 21,
          "text": "שהחילוק ביניהם הוא חילוק שבאין ערוך."
        },
        {
          "s": 22,
          "text": "ובכללות הוא ההפרש בין אור פנימי לאור מקיף,"
        },
        {
          "s": 23,
          "text": "דמ\"ע ממשיכות אור פנימי שהוא אור המתלבש בכלים,"
        },
        {
          "s": 24,
          "text": "ומל\"ת ממשיכות אור מקיף שלא יכילנו הכלי."
        },
        {
          "s": 25,
          "text": "והנה מעלה זו במל\"ת לגבי מ\"ע הוא גם כאשר העבודה בעניני ל\"ת היא רק באופן של דחי'."
        },
        {
          "s": 26,
          "text": "ועאכו\"כ כאשר העבודה בהם היא באופן שמהפך הזדונות לזכיות,"
        },
        {
          "s": 27,
          "text": "שאז ממשיך אור שלמעלה באין ערוך גם מהאור הנמשך ע\"י מל\"ת באופן של דחי'."
        },
        {
          "s": 28,
          "text": "וכמובן מזה שענין זה דזדונות נעשו לו כזכיות הוא רק ע\"י עבודת התשובה96,"
        },
        {
          "s": 29,
          "text": "שהרי העבודה הרגילה"
        },
        {
          "s": 30,
          "text": "(תמידים כסדרם)"
        },
        {
          "s": 31,
          "text": "בענינים אסורים היא רק בדרך דחי'."
        },
        {
          "s": 32,
          "text": "וההפרש שבין ב' עבודות אלו הוא חילוק שבאין ערוך,"
        },
        {
          "s": 33,
          "text": "כמובן מכ\"מ,"
        },
        {
          "s": 34,
          "text": "שההפרש ביניהם הוא כערך הגבול לגבי הבל\"ג."
        },
        {
          "s": 35,
          "text": "וכמו שהוא בענין הזמן,"
        },
        {
          "s": 36,
          "text": "דעבודת התשובה היא בשעתא חדא וברגעא חדא97,"
        },
        {
          "s": 37,
          "text": "למעלה ממדידה דזמן,"
        },
        {
          "s": 38,
          "text": "משא\"כ עבודה הרגילה היא מדודה בהמשך ושטח של זמן98"
        },
        {
          "s": 39,
          "text": "(ובדרך ממילא גם במקום99)."
        }
      ]
    }
  ]
}