{
  "globalIndex": 636,
  "owner": 36,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917442_theRebbe_735__p004",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917442_theRebbe_735__p004",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917442_theRebbe_735",
  "title": "מאמר על כן קראו תשי\"ג",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "דהטעם על זה שהמן הפיל פור בכדי להגיע לבחינת הגורל שלמעלה מהשתלשלות,"
        },
        {
          "s": 3,
          "text": "אף שאז"
        },
        {
          "s": 4,
          "text": "[בימי אחשורוש,"
        },
        {
          "s": 5,
          "text": "גם קודם שהפיל פור]"
        },
        {
          "s": 6,
          "text": "היתה ההנהגה מצד למעלה מהשתלשלות,"
        },
        {
          "s": 7,
          "text": "הוא,"
        },
        {
          "s": 8,
          "text": "לפי שבחינת הגורל הוא למעלה יותר גם מבחינת אחשורוש מי שאחרית וראשית שלו."
        },
        {
          "s": 9,
          "text": "והענין הוא,"
        },
        {
          "s": 10,
          "text": "דמזה עצמו שנקרא בשם אחשורוש מי שאחרית וראשית שלו,"
        },
        {
          "s": 11,
          "text": "מוכח,"
        },
        {
          "s": 12,
          "text": "שגם לגבי' ישנם הענינים דאחרית וראשית47,"
        },
        {
          "s": 13,
          "text": "אלא שהם שוין לגבי'."
        },
        {
          "s": 14,
          "text": "[ולהעיר ממ\"ש53"
        },
        {
          "s": 15,
          "text": "עשה משתה לכל שריו ועבדיו ואח\"כ לכל העם הנמצאים בשושן,"
        },
        {
          "s": 16,
          "text": "ומבואר בלקו\"ת54"
        },
        {
          "s": 17,
          "text": "שהגילוי שהי' לכל העם הי' למטה במדריגה מהגילוי שהי' לשריו ועבדיו."
        },
        {
          "s": 18,
          "text": "ולהוסיף,"
        },
        {
          "s": 19,
          "text": "שגם בהגילוי שהי' לכל העם היו כו\"כ חילוקי דרגות,"
        },
        {
          "s": 20,
          "text": "הראוי לחצר לחצר הראוי לגינה לגינה הראוי לביתן לביתן55."
        },
        {
          "s": 21,
          "text": "ויש לומר,"
        },
        {
          "s": 22,
          "text": "שמצד בחינת ההשתלשלות,"
        },
        {
          "s": 23,
          "text": "הגילוי הוא רק לשרים ועבדים,"
        },
        {
          "s": 24,
          "text": "וזה שהי' הגילוי גם לכל העם"
        },
        {
          "s": 25,
          "text": "(ועד לאלה שראויים רק לחצר)"
        },
        {
          "s": 26,
          "text": "הוא לפי שהגילוי הי' מבחי' אחשורוש שאחרית וראשית שלו."
        },
        {
          "s": 27,
          "text": "ומ\"מ הגילוי להעם הי' למטה מהגילוי לשריו ועבדיו"
        },
        {
          "s": 28,
          "text": "(וגם בהגילוי להעם היו כמה דרגות),"
        },
        {
          "s": 29,
          "text": "כי זה שאחרית וראשית שלו הוא שלגבי' אחרית וראשית הם בשוה,"
        },
        {
          "s": 30,
          "text": "אבל בנוגע להגילוי שלו בעולמות,"
        },
        {
          "s": 31,
          "text": "בעולמות העליונים"
        },
        {
          "s": 32,
          "text": "(ראשית)"
        },
        {
          "s": 33,
          "text": "הוא בגילוי יותר מבעולמות התחתונים"
        },
        {
          "s": 34,
          "text": "(אחרית)56]."
        },
        {
          "s": 35,
          "text": "משא\"כ בבחינת הגורל אין מלכתחילה הענין דראשית ואחרית,"
        },
        {
          "s": 36,
          "text": "כמובן מזה שהגורל הוא"
        },
        {
          "s": 37,
          "text": "(בכלל)"
        },
        {
          "s": 38,
          "text": "בשני דברים שוים"
        },
        {
          "s": 39,
          "text": "(כנ\"ל סעיף ב)."
        },
        {
          "s": 40,
          "text": "וכמו שהוא בנוגע להענינים דראשית ואחרית"
        },
        {
          "s": 41,
          "text": "(מעלה ומטה),"
        },
        {
          "s": 42,
          "text": "עד\"ז הוא בנוגע לקדושה וסט\"א,"
        },
        {
          "s": 43,
          "text": "שמצד הדרגא דאחשורוש יש חילוק בין קדושה לסט\"א,"
        },
        {
          "s": 44,
          "text": "אלא שמצד הרוממות שלו אין זה תופס מקום"
        },
        {
          "s": 45,
          "text": "(כ\"כ),"
        },
        {
          "s": 46,
          "text": "ולכן אפשר להיות יניקה גם לסט\"א"
        },
        {
          "s": 47,
          "text": "[ח\"ש דק\"נ ורוש דגקה\"ט57],"
        },
        {
          "s": 48,
          "text": "ועד שתהי' התגברות הסט\"א על הקדושה – הושחרו פניהם של ישראל57"
        },
        {
          "s": 49,
          "text": "[וי\"ל ע\"ד שממית בידים תתפש והיא בהיכלי מלך58"
        },
        {
          "s": 50,
          "text": "(אף שהיא מלכלכת את ההיכל),"
        },
        {
          "s": 51,
          "text": "כי מצד רוממותו של המלך אינו נותן לב להקפיד לגרשה59],"
        },
        {
          "s": 52,
          "text": "אבל לא להשמידם ח\"ו."
        },
        {
          "s": 53,
          "text": "וכשביקש המן להשמיד את כל היהודים"
        },
        {
          "s": 54,
          "text": "(ח\"ו היל\"ת)"
        },
        {
          "s": 55,
          "text": "הפיל פור הוא הגורל60,"
        },
        {
          "s": 56,
          "text": "דכיון שבבחינת הגורל אין מלכתחילה חילוק בין קדושה לסט\"א"
        },
        {
          "s": 57,
          "text": "[ובפרט לפי המבואר לעיל"
        },
        {
          "s": 58,
          "text": "(סעיף ג' וד')"
        },
        {
          "s": 59,
          "text": "שהגורל הוא לא רק למעלה מהשתלשלות אלא למעלה גם מהרצון דתומ\"צ],"
        },
        {
          "s": 60,
          "text": "לכן חשב שעי\"ז יוכל ח\"ו להפיק את זממו."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "והנה כמו שגורל הוא למעלה מהשכל ולמעלה גם מהרצון,"
        },
        {
          "s": 2,
          "text": "עד\"ז הוא בנוגע לבחירה שהוא למעלה משכל ולמעלה גם מרצון."
        },
        {
          "s": 3,
          "text": "דכאשר שכלו מחייב שדבר זה ראוי לבחור בו,"
        },
        {
          "s": 4,
          "text": "וגם כשהוא רוצה באיזה דבר"
        },
        {
          "s": 5,
          "text": "(רצון שלמעלה מהשכל),"
        },
        {
          "s": 6,
          "text": "הרי הוא מוכרח בזה ואין זה בחירה חפשית,"
        },
        {
          "s": 7,
          "text": "ואמיתית ענין הבחירה הוא כשהבחירה שלו היא לא מצד השכל וגם לא מצד הרצון61,"
        },
        {
          "s": 8,
          "text": "אלא שכך בוחר בבחירתו החפשית."
        },
        {
          "s": 9,
          "text": "והחילוק בין גורל ובחירה הוא,"
        },
        {
          "s": 10,
          "text": "דכשאדם עושה גורל ומחליט דכמו שיפול הגורל כן יהי' רצונו,"
        },
        {
          "s": 11,
          "text": "הרצון שלו הוא לא מצד האדם אלא מפני שכן נפל הגורל,"
        },
        {
          "s": 12,
          "text": "ובחירה היא שהאדם הוא הבוחר."
        },
        {
          "s": 13,
          "text": "ומזה מובן,"
        },
        {
          "s": 14,
          "text": "דבחירה היא למעלה מגורל."
        },
        {
          "s": 15,
          "text": "דגורל הוא הדרגא בנפש שהיא מוגדרת ומוכרחת בזה ששני הדברים הם שוים לגבה,"
        },
        {
          "s": 16,
          "text": "וענין הבחירה הוא שאינו מוגדר ומוכרח באיזה דברים,"
        },
        {
          "s": 17,
          "text": "כולל דברים שוים לגבי',"
        },
        {
          "s": 18,
          "text": "וביכלתו לבחור במה שירצה."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דבבחירה ישנם שני הענינים."
        },
        {
          "s": 2,
          "text": "הדרגא דנפש שלמעלה משכל שלגבה שני הדברים הם בשוה – דרגת הגורל,"
        },
        {
          "s": 3,
          "text": "וזה שהוא בוחר כמו שרוצה"
        },
        {
          "s": 4,
          "text": "(הגם ששני הדברים הם שוים"
        },
        {
          "s": 5,
          "text": "(לגבי'))"
        },
        {
          "s": 6,
          "text": "הוא בא מעצם הנפש."
        },
        {
          "s": 7,
          "text": "וע\"י הבחירה,"
        },
        {
          "s": 8,
          "text": "ההמשכה מהעצם להדרגא דגורל"
        },
        {
          "s": 9,
          "text": "(הדרגא שלגבה שני הדברים הם בשוה),"
        },
        {
          "s": 10,
          "text": "גם הגורל"
        },
        {
          "s": 11,
          "text": "(הגם שמצד עצמו אפשר להיות בשני האופנים)"
        },
        {
          "s": 12,
          "text": "הוא כפי הבחירה."
        },
        {
          "s": 13,
          "text": "וע\"ד מ\"ש62"
        },
        {
          "s": 14,
          "text": "אתה תומיך גורלי,"
        },
        {
          "s": 15,
          "text": "שהקב\"ה תומך את הגורל שיהי' כפי בחירת העצמות."
        },
        {
          "s": 16,
          "text": "וזהו מ\"ש63"
        },
        {
          "s": 17,
          "text": "יבחר לנו את נחלתינו את גאון יעקב גו',"
        },
        {
          "s": 18,
          "text": "דביעקב כתיב64"
        },
        {
          "s": 19,
          "text": "יעקב חבל נחלתו ותרגם אונקלוס יעקב עדב אחסנתי' דעדב הוא גורל65,"
        },
        {
          "s": 20,
          "text": "וענין יבחר גו' את גאון יעקב הוא66,"
        },
        {
          "s": 21,
          "text": "שגם בדרגת הגורל שלמעלה מהשתלשלות שהכל שוים שם,"
        },
        {
          "s": 22,
          "text": "הבחירה היא בישראל דוקא."
        }
      ]
    }
  ]
}