{
  "globalIndex": 851,
  "owner": 1,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918811_theRebbe_734__p002",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918811_theRebbe_734__p002",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918811_theRebbe_734",
  "title": "מאמר ביום השני הקריב תשל\"ב",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ומבואר בהדרושים10,"
        },
        {
          "s": 1,
          "text": "דהשייכות של נחשון ונתנאל ליהודה ויששכר הוא,"
        },
        {
          "s": 2,
          "text": "כי יהודה הו\"ע הביטול"
        },
        {
          "s": 3,
          "text": "[שלכן נקרא בשם יהודה על שם הפעם אודה את ה'11],"
        },
        {
          "s": 4,
          "text": "ולכן הנשיא דשבט יהודה הי' נחשון שירד תחלה לנחשול שבים,"
        },
        {
          "s": 5,
          "text": "ענין המס\"נ,"
        },
        {
          "s": 6,
          "text": "ביטול."
        },
        {
          "s": 7,
          "text": "ויששכר הו\"ע התורה"
        },
        {
          "s": 8,
          "text": "(כנ\"ל)."
        },
        {
          "s": 9,
          "text": "ולכן הנשיא דיששכר הי' נתנאל12,"
        },
        {
          "s": 10,
          "text": "אותיות נתן א-ל,"
        },
        {
          "s": 11,
          "text": "כי התורה היא מתנה."
        },
        {
          "s": 12,
          "text": "וענין בן צוער,"
        },
        {
          "s": 13,
          "text": "צוער מלשון מצער,"
        },
        {
          "s": 14,
          "text": "הוא,"
        },
        {
          "s": 15,
          "text": "כי הכלי לתורה הוא ביטול."
        },
        {
          "s": 16,
          "text": "וזהו שיהודה הקריב לפני יששכר,"
        },
        {
          "s": 17,
          "text": "כי ענין הביטול13"
        },
        {
          "s": 18,
          "text": "הוא לפני"
        },
        {
          "s": 19,
          "text": "(ולמעלה מ)"
        },
        {
          "s": 20,
          "text": "עסק התורה."
        },
        {
          "s": 21,
          "text": "דשורש התורה הוא בחכמה,"
        },
        {
          "s": 22,
          "text": "דאורייתא מחכמה נפקת14,"
        },
        {
          "s": 23,
          "text": "וע\"י הביטול הוא המשכת הכתר שלמעלה מחכמה."
        },
        {
          "s": 24,
          "text": "וצריך להבין,"
        },
        {
          "s": 25,
          "text": "דע\"פ המבואר בהדרושים שיהודה הוא בכתר ויששכר בחכמה,"
        },
        {
          "s": 26,
          "text": "למה העלה הכתוב על יששכר כאילו הוא הקריב תחלה"
        },
        {
          "s": 27,
          "text": "(תחלה גם ליהודה)."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה ידוע דיהודה הו\"ע המעשה"
        },
        {
          "s": 2,
          "text": "(כמ\"ש בהדרושים המבארים ענין הגשת יהודה ויוסף15),"
        },
        {
          "s": 3,
          "text": "ועפ\"ז,"
        },
        {
          "s": 4,
          "text": "יששכר ויהודה הו\"ע תלמוד ומעשה."
        },
        {
          "s": 5,
          "text": "ומבואר במק\"א16"
        },
        {
          "s": 6,
          "text": "דהגם שנמנו וגמרו שתלמוד גדול17,"
        },
        {
          "s": 7,
          "text": "מ\"מ,"
        },
        {
          "s": 8,
          "text": "מכיון שהטעם על זה שתלמוד גדול הוא לפי שתלמוד מביא לידי מעשה17,"
        },
        {
          "s": 9,
          "text": "הרי מזה עצמו מוכח שהמעשה הוא העיקר"
        },
        {
          "s": 10,
          "text": "[כי שורש המעשה הוא למעלה משורש התלמוד ולכן לע\"ל יהי' מעשה גדול18]."
        },
        {
          "s": 11,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 12,
          "text": "דזה שנשיא יששכר העלה עליו הכתוב כאילו הוא הקריב תחלה"
        },
        {
          "s": 13,
          "text": "(תחלה גם ליהודה)"
        },
        {
          "s": 14,
          "text": "הוא ע\"ד תלמוד גדול,"
        },
        {
          "s": 15,
          "text": "וזה שבפועל הקריב יהודה תחלה הוא לפי שהמעשה הוא העיקר."
        },
        {
          "s": 16,
          "text": "ולהוסיף,"
        },
        {
          "s": 17,
          "text": "דהקמת המשכן ומתן תורה שייכים זל\"ז."
        },
        {
          "s": 18,
          "text": "וכמובן ממדרשי חז\"ל19"
        },
        {
          "s": 19,
          "text": "עה\"פ20"
        },
        {
          "s": 20,
          "text": "באתי לגני,"
        },
        {
          "s": 21,
          "text": "שהמשכת וירידת עיקר שכינה למטה בארץ הותחלה בשעת מתן תורה,"
        },
        {
          "s": 22,
          "text": "ועיקר ההמשכה הי' כשהוקם המשכן."
        },
        {
          "s": 23,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 24,
          "text": "דכמו שמתן תורה הי' ע\"י שהקדימו נעשה לנשמע,"
        },
        {
          "s": 25,
          "text": "הדגשת מעלת המעשה על הלימוד וההבנה21"
        },
        {
          "s": 26,
          "text": "(נשמע מלשון הבנה22)"
        },
        {
          "s": 27,
          "text": "ובאופן שהקדימו נעשה לנשמע"
        },
        {
          "s": 28,
          "text": "[דלאחרי מתן תורה,"
        },
        {
          "s": 29,
          "text": "הגם שהמעשה הוא העיקר23"
        },
        {
          "s": 30,
          "text": "והטעם שתלמוד גדול הוא מפני שמביא לידי מעשה מ\"מ תלמוד גדול,"
        },
        {
          "s": 31,
          "text": "ולימוד קודם למעשה."
        },
        {
          "s": 32,
          "text": "אבל בכדי שתהי' ההמשכה דמתן תורה הי' צריך להיות ההכנה דהקדמת נעשה לנשמע],"
        },
        {
          "s": 33,
          "text": "עד\"ז הוא בנוגע לההמשכה שהיתה בהקמת המשכן."
        },
        {
          "s": 34,
          "text": "ולכן,"
        },
        {
          "s": 35,
          "text": "בחנוכת המשכן הקריב יהודה"
        },
        {
          "s": 36,
          "text": "(מעשה)"
        },
        {
          "s": 37,
          "text": "לפני יששכר"
        },
        {
          "s": 38,
          "text": "(תלמוד)."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וצריך להבין,"
        },
        {
          "s": 2,
          "text": "דכיון שגם זה שתלמוד גדול הוא מפני שמביא למעשה והמעשה הוא העיקר,"
        },
        {
          "s": 3,
          "text": "מהו החילוק בין שני הענינים,"
        },
        {
          "s": 4,
          "text": "שבדרך כלל התלמוד הוא קודם למעשה"
        },
        {
          "s": 5,
          "text": "[קודם בזמן,"
        },
        {
          "s": 6,
          "text": "וגם קודם במעלה,"
        },
        {
          "s": 7,
          "text": "תלמוד גדול],"
        },
        {
          "s": 8,
          "text": "ובמתן תורה וכן בחנוכת המשכן הי' מעשה קודם."
        },
        {
          "s": 9,
          "text": "ונקודת הביאור בזה,"
        },
        {
          "s": 10,
          "text": "דזה שהמעשה הוא העיקר"
        },
        {
          "s": 11,
          "text": "[אף שמעשה הוא כח היותר אחרון,"
        },
        {
          "s": 12,
          "text": "ועד\"ז למעלה המעשה הוא סוף ההשתלשלות],"
        },
        {
          "s": 13,
          "text": "הוא כי נעוץ תחלתן בסופן וסופן בתחלתן24,"
        },
        {
          "s": 14,
          "text": "וגם כי סוף25"
        },
        {
          "s": 15,
          "text": "מעשה במחשבה תחלה26."
        },
        {
          "s": 16,
          "text": "ומבאר אדמו\"ר"
        },
        {
          "s": 17,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 18,
          "text": "נ\"ע בהמשך תער\"ב27,"
        },
        {
          "s": 19,
          "text": "החילוק דשני הענינים,"
        },
        {
          "s": 20,
          "text": "דסופן הוא גמר סיום ההמשכה."
        },
        {
          "s": 21,
          "text": "ובחינה זו נעוצה בתחלתן תחלת וראשית ההמשכה."
        },
        {
          "s": 22,
          "text": "וכמובא שם משל לזה מהשפעת צדקה לעני,"
        },
        {
          "s": 23,
          "text": "שהתחילה"
        },
        {
          "s": 24,
          "text": "(של ההשפעה)"
        },
        {
          "s": 25,
          "text": "הוא שמתעורר ברחמים על העני,"
        },
        {
          "s": 26,
          "text": "ומזה נעשה אצלו אח\"כ רצון להטיב להעני"
        },
        {
          "s": 27,
          "text": "[דהרחמים הם הטעם דהרצון28],"
        },
        {
          "s": 28,
          "text": "ואח\"כ נמשך הרצון בשכל ובמדות וכו' עד שבא במעשה בפועל,"
        },
        {
          "s": 29,
          "text": "שנותן צדקה להעני."
        },
        {
          "s": 30,
          "text": "וענין נעוץ סופן בתחלתן הוא,"
        },
        {
          "s": 31,
          "text": "שעיקר המכוון בהתעוררות הרחמים"
        },
        {
          "s": 32,
          "text": "(תחלתן)"
        },
        {
          "s": 33,
          "text": "הוא שתהי' ההשפעה בפועל"
        },
        {
          "s": 34,
          "text": "(סופן)."
        },
        {
          "s": 35,
          "text": "ובאם לא תהי' ההשפעה בפועל"
        },
        {
          "s": 36,
          "text": "[הגם שע\"י הרחמים נעשה ההתעוררות דכל כחות הנעלים שבו,"
        },
        {
          "s": 37,
          "text": "רצון שכל ומדות,"
        },
        {
          "s": 38,
          "text": "ואפילו כשהרצון שלו להטיב להעני מתגלה בדיבור"
        },
        {
          "s": 39,
          "text": "(שמדבר דברי פיוס להעני29)"
        },
        {
          "s": 40,
          "text": "אבל לא בא במעשה בפועל],"
        },
        {
          "s": 41,
          "text": "חסר העיקר."
        },
        {
          "s": 42,
          "text": "ולפי שנעוץ סופן בתחלתן,"
        },
        {
          "s": 43,
          "text": "שהכוונה"
        },
        {
          "s": 44,
          "text": "(הנעוצה)"
        },
        {
          "s": 45,
          "text": "בהתעוררות הרחמים"
        },
        {
          "s": 46,
          "text": "(תחלתן)"
        },
        {
          "s": 47,
          "text": "הוא שיהי' המעשה בפועל"
        },
        {
          "s": 48,
          "text": "(סופן),"
        },
        {
          "s": 49,
          "text": "לכן נעוץ תחלתן בסופן,"
        },
        {
          "s": 50,
          "text": "שגילוי הכח דבחינת תחלה הוא30"
        },
        {
          "s": 51,
          "text": "דוקא בסוף ההשפעה,"
        },
        {
          "s": 52,
          "text": "בהמעשה בפועל."
        },
        {
          "s": 53,
          "text": "וענין סוף מעשה במחשבה תחלה הוא למעלה מענין נעוץ תחלתן בסופן וסופן בתחלתן."
        },
        {
          "s": 54,
          "text": "דפירוש סוף מעשה הוא"
        },
        {
          "s": 55,
          "text": "(לא סוף העשי' עצמה,"
        },
        {
          "s": 56,
          "text": "עשיית האדם,"
        },
        {
          "s": 57,
          "text": "אלא)"
        },
        {
          "s": 58,
          "text": "המעשה הבאה ע\"י עשיית ופעולת האדם."
        },
        {
          "s": 59,
          "text": "דבהשפעת החסד,"
        },
        {
          "s": 60,
          "text": "ענין סוף מעשה הוא קבלת ההשפעה,"
        },
        {
          "s": 61,
          "text": "שהעני מקבל את ההשפעה בטוב ונהנה מזה."
        },
        {
          "s": 62,
          "text": "דענין זה"
        },
        {
          "s": 63,
          "text": "(באיזה אופן מקבל העני את ההשפעה)"
        },
        {
          "s": 64,
          "text": "אינו תלוי בהנותן אלא בהמקבל."
        },
        {
          "s": 65,
          "text": "וזה מגיע במחשבה תחלה,"
        },
        {
          "s": 66,
          "text": "היינו בהתחילה שלפני תחלת המחשבה,"
        },
        {
          "s": 67,
          "text": "למעלה משורש ההשפעה."
        },
        {
          "s": 68,
          "text": "דשורש ההשפעה"
        },
        {
          "s": 69,
          "text": "(ההתעוררות להטיב)"
        },
        {
          "s": 70,
          "text": "הוא תחלת המחשבה,"
        },
        {
          "s": 71,
          "text": "וגילוי ענין זה הוא בסוף ההשפעה – נעוץ תחלתן בסופן,"
        },
        {
          "s": 72,
          "text": "והמעלה דסוף מעשה"
        },
        {
          "s": 73,
          "text": "(קבלת ההשפעה)"
        },
        {
          "s": 74,
          "text": "היא שסוף מעשה מגיע בהתחילה שלפני תחלת המחשבה,"
        },
        {
          "s": 75,
          "text": "למעלה משורש ההשפעה."
        },
        {
          "s": 76,
          "text": "ולכן התענוג שיש להמשפיע מקבלת ההשפעה"
        },
        {
          "s": 77,
          "text": "(מזה שהעני קיבל ההשפעה בטוב)"
        },
        {
          "s": 78,
          "text": "הוא תענוג גדול יותר מהתענוג שבההשפעה עצמה."
        }
      ]
    }
  ]
}