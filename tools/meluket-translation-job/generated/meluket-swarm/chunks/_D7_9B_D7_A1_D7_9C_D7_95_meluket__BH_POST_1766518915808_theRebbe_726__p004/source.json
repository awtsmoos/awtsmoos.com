{
  "globalIndex": 356,
  "owner": 6,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915808_theRebbe_726__p004",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915808_theRebbe_726__p004",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915808_theRebbe_726",
  "title": "מאמר פדה בשלום תשל\"ח",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ויש לקשר זה עם תורת הרב המגיד63"
        },
        {
          "s": 2,
          "text": "(בעל ההילולא64)"
        },
        {
          "s": 3,
          "text": "עה\"פ65"
        },
        {
          "s": 4,
          "text": "וישב יעקב בארץ מגורי אביו בארץ כנען,"
        },
        {
          "s": 5,
          "text": "שירידת יעקב ממדריגתו העליונה לישב בארץ בארציות"
        },
        {
          "s": 6,
          "text": "(היינו,"
        },
        {
          "s": 7,
          "text": "ירידת הנשמה למטה)"
        },
        {
          "s": 8,
          "text": "[ועד לאופן דוישב,"
        },
        {
          "s": 9,
          "text": "שאין ישיבה אלא לשון עכבה66]"
        },
        {
          "s": 10,
          "text": "הוא בשביל מגורי אביו,"
        },
        {
          "s": 11,
          "text": "מגורי לשון אסיפה וכניסה כמו אוגר בקיץ67,"
        },
        {
          "s": 12,
          "text": "לאגור ולאסוף הניצוצות הקדושים"
        },
        {
          "s": 13,
          "text": "(שבעוה\"ז)"
        },
        {
          "s": 14,
          "text": "ולהכניסם ולהעלותם לעילא."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "והנה בתורת הרב המגיד הנ\"ל בתחילתה68"
        },
        {
          "s": 1,
          "text": "מפרש,"
        },
        {
          "s": 2,
          "text": "שמגורי אביו הוא יראת אביו שבשמים"
        },
        {
          "s": 3,
          "text": "(מגורי לשון מגור ויראה69),"
        },
        {
          "s": 4,
          "text": "ופירוש וישב יעקב בארץ מגורי אביו גו' הוא,"
        },
        {
          "s": 5,
          "text": "דהגם שהוא בארץ,"
        },
        {
          "s": 6,
          "text": "בארציות וחומריות עוה\"ז"
        },
        {
          "s": 7,
          "text": "[ויתירה מזו,"
        },
        {
          "s": 8,
          "text": "שבעוה\"ז גופא הוא בארץ כנען מלשון כנען בידו מאזני מרמה70,"
        },
        {
          "s": 9,
          "text": "היינו שהוא נמצא בין הרשעים],"
        },
        {
          "s": 10,
          "text": "עכ\"ז הוא במגורי אביו,"
        },
        {
          "s": 11,
          "text": "ביראת אביו שבשמים."
        },
        {
          "s": 12,
          "text": "ולאחרי זה מוסיף עוד פירוש,"
        },
        {
          "s": 13,
          "text": "שמגורי אביו הוא אסיפת הניצוצות כנ\"ל."
        },
        {
          "s": 14,
          "text": "ויש לומר,"
        },
        {
          "s": 15,
          "text": "דשני פירושים אלה הם שני הענינים"
        },
        {
          "s": 16,
          "text": "(דלעיל סעיף ו)"
        },
        {
          "s": 17,
          "text": "שנעשים ע\"י ירידת הנשמה למטה."
        },
        {
          "s": 18,
          "text": "שבתחילה מבאר העילוי שנעשה בהנשמה ע\"י ירידתה למטה,"
        },
        {
          "s": 19,
          "text": "דע\"י שגם בהיותה בארציות וחומריות עוה\"ז"
        },
        {
          "s": 20,
          "text": "[ויתירה מזו – בארץ כנען]"
        },
        {
          "s": 21,
          "text": "היא ביראת שמים,"
        },
        {
          "s": 22,
          "text": "עי\"ז היא מתעלית יותר מכמו שהיתה לפני ירידתה."
        },
        {
          "s": 23,
          "text": "[ובפרט לפי המבואר בתו\"א ד\"ה וישב יעקב71"
        },
        {
          "s": 24,
          "text": "(ובהגהות הצ\"צ לשם72),"
        },
        {
          "s": 25,
          "text": "דע\"י שהנשמה מתגברת על ההעלמות וההסתרים דהגוף וזמן הגלות ומתעוררת באהבה ויראה,"
        },
        {
          "s": 26,
          "text": "גם האהבה ויראה גופא הם נעלים יותר מהאהבה ויראה שקודם ירידתה]."
        },
        {
          "s": 27,
          "text": "ואח\"כ מבאר ענין נעלה יותר שנעשה ע\"י ירידת הנשמה למטה,"
        },
        {
          "s": 28,
          "text": "דענין זה הוא תכלית כוונת הירידה,"
        },
        {
          "s": 29,
          "text": "לאגור ולאסוף הניצוצות הקדושים ולהעלותם למעלה."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "שהפירוש דמגורי אביו הוא אגירת ואסיפת הניצוצות בא בהמשך וקשור עם הפירוש שמגורי אביו הוא יראת אביו שבשמים."
        },
        {
          "s": 3,
          "text": "[והקשר דשני הפירושים מובן גם מהמבואר בתו\"א שם73,"
        },
        {
          "s": 4,
          "text": "שב' הפירושים במגורי,"
        },
        {
          "s": 5,
          "text": "לשון יראה ולשון אוצר,"
        },
        {
          "s": 6,
          "text": "שניהם עולים בקנה אחד."
        },
        {
          "s": 7,
          "text": "והגם שבתו\"א שם,"
        },
        {
          "s": 8,
          "text": "גם להפירוש שמגורי הוא לשון אוצר,"
        },
        {
          "s": 9,
          "text": "מגורי קאי על יראה"
        },
        {
          "s": 10,
          "text": "(כמ\"ש74"
        },
        {
          "s": 11,
          "text": "יראת ה' היא אוצרו,"
        },
        {
          "s": 12,
          "text": "וכן בדברי רז\"ל75"
        },
        {
          "s": 13,
          "text": "אוצר של יראת שמים),"
        },
        {
          "s": 14,
          "text": "יש לומר,"
        },
        {
          "s": 15,
          "text": "שהקשר דשני הפירושים הוא גם לפי הביאור בתורת הה\"מ שמגורי לשון אסיפה וכניסה"
        },
        {
          "s": 16,
          "text": "(אוצר)"
        },
        {
          "s": 17,
          "text": "קאי על אסיפת הניצוצות]."
        },
        {
          "s": 18,
          "text": "דשלימות הבירור והעלאת הניצוצות"
        },
        {
          "s": 19,
          "text": "(מגורי לשון אסיפה)"
        },
        {
          "s": 20,
          "text": "הוא ע\"י העבודה דיראה,"
        },
        {
          "s": 21,
          "text": "ביטול דעבד,"
        },
        {
          "s": 22,
          "text": "שכל כוונתו בעבודתו היא"
        },
        {
          "s": 23,
          "text": "(לא בשביל עצמו,"
        },
        {
          "s": 24,
          "text": "גם לא בכדי לדבקה בו כו',"
        },
        {
          "s": 25,
          "text": "ורק)"
        },
        {
          "s": 26,
          "text": "לשמש את קונו,"
        },
        {
          "s": 27,
          "text": "לעשות דירה לו ית' בתחתונים,"
        },
        {
          "s": 28,
          "text": "ועי\"ז הבירור הוא בשלימות76."
        }
      ]
    }
  ]
}