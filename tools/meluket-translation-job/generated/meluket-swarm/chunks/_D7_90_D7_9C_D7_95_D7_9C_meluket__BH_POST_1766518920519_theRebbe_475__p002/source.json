{
  "globalIndex": 1125,
  "owner": 25,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920519_theRebbe_475__p002",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920519_theRebbe_475__p002",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920519_theRebbe_475",
  "title": "מאמר אתם נצבים תשט\"ז",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה איתא במדרש7"
        },
        {
          "s": 2,
          "text": "ע\"פ8"
        },
        {
          "s": 3,
          "text": "ולקחתם לכם ביום הראשון הה\"ד9"
        },
        {
          "s": 4,
          "text": "יעלוז שדי וכל אשר בו,"
        },
        {
          "s": 5,
          "text": "יעלוז שדי זה העולם כו'10,"
        },
        {
          "s": 6,
          "text": "וכל אשר בו אלו הבריות וכו',"
        },
        {
          "s": 7,
          "text": "לפני מי,"
        },
        {
          "s": 8,
          "text": "לפני הוי',"
        },
        {
          "s": 9,
          "text": "למה,"
        },
        {
          "s": 10,
          "text": "כי בא בר\"ה ויוהכ\"פ,"
        },
        {
          "s": 11,
          "text": "מה לעשות,"
        },
        {
          "s": 12,
          "text": "ישפוט תבל בצדק ועמים במישרים11."
        },
        {
          "s": 13,
          "text": "וצריך להבין מהו השמחה דיעלוז שדי וכל אשר בו מהמשפט,"
        },
        {
          "s": 14,
          "text": "הלא זהו דין ומשפט,"
        },
        {
          "s": 15,
          "text": "ולכאורה יותר טוב בלי משפט כלל."
        },
        {
          "s": 16,
          "text": "וביותר יפלא,"
        },
        {
          "s": 17,
          "text": "שהרי אמרו רז\"ל12"
        },
        {
          "s": 18,
          "text": "שאפילו כל העולם כולו אומרים לך צדיק אתה הי' בעיניך כרשע,"
        },
        {
          "s": 19,
          "text": "ואמרו רז\"ל13"
        },
        {
          "s": 20,
          "text": "ג' ספרים נפתחים בר\"ה,"
        },
        {
          "s": 21,
          "text": "צדיקים נכתבים לאלתר לחיים,"
        },
        {
          "s": 22,
          "text": "רשעים כו',"
        },
        {
          "s": 23,
          "text": "וא\"כ,"
        },
        {
          "s": 24,
          "text": "איך אפשר להיות בשמחה."
        },
        {
          "s": 25,
          "text": "גם צריך להבין,"
        },
        {
          "s": 26,
          "text": "הלא כתיב14"
        },
        {
          "s": 27,
          "text": "כי המשפט לאלקים הוא,"
        },
        {
          "s": 28,
          "text": "ועל בני ישראל נאמר15"
        },
        {
          "s": 29,
          "text": "אשר לו אלקים קרובים אליו,"
        },
        {
          "s": 30,
          "text": "כדכתיב16"
        },
        {
          "s": 31,
          "text": "בנים אתם לה' אלקיכם,"
        },
        {
          "s": 32,
          "text": "וכתיב17"
        },
        {
          "s": 33,
          "text": "למען אחי ורעי,"
        },
        {
          "s": 34,
          "text": "והרי קרוב פסול לדון18."
        },
        {
          "s": 35,
          "text": "וגם צריך להבין מ\"ש ישפוט תבל בצדק,"
        },
        {
          "s": 36,
          "text": "מהו ענין בצדק,"
        },
        {
          "s": 37,
          "text": "ומהו דיוק הלשון תבל דוקא."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "אך הענין הוא,"
        },
        {
          "s": 1,
          "text": "דהנה אמרו רז\"ל במדרש19"
        },
        {
          "s": 2,
          "text": "כל השביעין חביבין,"
        },
        {
          "s": 3,
          "text": "בימים שביעי חביב,"
        },
        {
          "s": 4,
          "text": "יום השבת,"
        },
        {
          "s": 5,
          "text": "שנאמר20"
        },
        {
          "s": 6,
          "text": "ויברך אלקים את יום השביעי ויקדש אותו"
        },
        {
          "s": 7,
          "text": "(ואמרו רז\"ל21"
        },
        {
          "s": 8,
          "text": "ברכו במן וקדשו במן,"
        },
        {
          "s": 9,
          "text": "וכן אמרו רז\"ל22"
        },
        {
          "s": 10,
          "text": "קדשו במאור פניו של אדם,"
        },
        {
          "s": 11,
          "text": "שאינו דומה מאור פניו של אדם בחול למאור פניו של אדם בשבת),"
        },
        {
          "s": 12,
          "text": "בחדשים שביעי חביב,"
        },
        {
          "s": 13,
          "text": "חודש השביעי,"
        },
        {
          "s": 14,
          "text": "שהוא משובע בכל שברכו בגשמיות וברוחניות,"
        },
        {
          "s": 15,
          "text": "כמארז\"ל23"
        },
        {
          "s": 16,
          "text": "גיתות בתוכו ברכות בתוכו,"
        },
        {
          "s": 17,
          "text": "שהוא עת האסיף,"
        },
        {
          "s": 18,
          "text": "וכמו\"כ ברוחניות,"
        },
        {
          "s": 19,
          "text": "שיש בו מצוות הרבה,"
        },
        {
          "s": 20,
          "text": "שופר ר\"ה ויוהכ\"פ סוכה וד' מינים ושמיני עצרת."
        },
        {
          "s": 21,
          "text": "ולכן גם בארץ שביעית חביבה,"
        },
        {
          "s": 22,
          "text": "דכשם שישנם שבעה רקיעים,"
        },
        {
          "s": 23,
          "text": "שמים ושמי השמים ורקיע ושחקים זבול ומעון וערבות,"
        },
        {
          "s": 24,
          "text": "וכתיב24"
        },
        {
          "s": 25,
          "text": "סולו לרוכב בערבות בי\"ה שמו,"
        },
        {
          "s": 26,
          "text": "היינו,"
        },
        {
          "s": 27,
          "text": "שערבות שהוא השביעי הוא החביב,"
        },
        {
          "s": 28,
          "text": "לפי שבו נמצאים נשמותיהם של צדיקים כו'25,"
        },
        {
          "s": 29,
          "text": "ולכן הרי זה חביב אצל הקב\"ה להיות רוכב עליהם,"
        },
        {
          "s": 30,
          "text": "כמו כן הוא גם בארץ,"
        },
        {
          "s": 31,
          "text": "שיש לה שבעה שמות,"
        },
        {
          "s": 32,
          "text": "ארץ אדמה ארקא גיא צי' נשי' תבל,"
        },
        {
          "s": 33,
          "text": "הנה תבל שהוא השביעי הוא החביב,"
        },
        {
          "s": 34,
          "text": "ועז\"נ ישפוט תבל בצדק,"
        },
        {
          "s": 35,
          "text": "תבל דייקא."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ולהבין זה צריך להקדים תחילה ענין המשפט,"
        },
        {
          "s": 2,
          "text": "שהוא על כללות העבודה בשנה שעברה בקיום התומ\"צ,"
        },
        {
          "s": 3,
          "text": "בכל ג' הקוים דתורה עבודה וגמ\"ח,"
        },
        {
          "s": 4,
          "text": "שהם ג' הדברים שעליהם העולם עומד26,"
        },
        {
          "s": 5,
          "text": "שכללותם הו\"ע של צדקה."
        },
        {
          "s": 6,
          "text": "דהנה,"
        },
        {
          "s": 7,
          "text": "גם התורה הו\"ע של צדקה27,"
        },
        {
          "s": 8,
          "text": "שהרי התורה מצד עצמה היא באין ערוך כו',"
        },
        {
          "s": 9,
          "text": "והמשכתה בעולם הו\"ע של צדקה."
        },
        {
          "s": 10,
          "text": "וחיבור זה"
        },
        {
          "s": 11,
          "text": "(שהתורה תומשך בעולם)"
        },
        {
          "s": 12,
          "text": "פועלים נש\"י ע\"י עבודתם,"
        },
        {
          "s": 13,
          "text": "והיינו,"
        },
        {
          "s": 14,
          "text": "לפי שמחשבתם של ישראל קדמה אפילו למחשבתה של תורה28."
        },
        {
          "s": 15,
          "text": "וכמו\"כ עבודה,"
        },
        {
          "s": 16,
          "text": "שהו\"ע עבודת הקרבנות,"
        },
        {
          "s": 17,
          "text": "ובזמן הזה הו\"ע התפלה,"
        },
        {
          "s": 18,
          "text": "הרי זה קשור עם צדקה,"
        },
        {
          "s": 19,
          "text": "כמארז\"ל29"
        },
        {
          "s": 20,
          "text": "ר\"א יהיב פרוטה לעני והדר מצלי,"
        },
        {
          "s": 21,
          "text": "שנאמר30"
        },
        {
          "s": 22,
          "text": "אני בצדק אחזה פניך."
        },
        {
          "s": 23,
          "text": "והיינו,"
        },
        {
          "s": 24,
          "text": "שע\"י הצדקה נעשה בתפלה הענין דאחזה פניך,"
        },
        {
          "s": 25,
          "text": "פניך דייקא,"
        },
        {
          "s": 26,
          "text": "בחי' פנימיות האלקות שמתגלית ע\"י פנימיות הנשמה,"
        },
        {
          "s": 27,
          "text": "ולכן התפלה היא על הוי'"
        },
        {
          "s": 28,
          "text": "(ותתפלל חנה על הוי')31,"
        },
        {
          "s": 29,
          "text": "למעלה משם הוי'32."
        },
        {
          "s": 30,
          "text": "וזהו מ\"ש ישפוט תבל בצדק,"
        },
        {
          "s": 31,
          "text": "ב' צדק,"
        },
        {
          "s": 32,
          "text": "שהם ב' בחי' צדק,"
        },
        {
          "s": 33,
          "text": "בחי' הצדק שבגמ\"ח ותפלה,"
        },
        {
          "s": 34,
          "text": "שהו\"ע הצדקה שבהגבלה,"
        },
        {
          "s": 35,
          "text": "ובחי' הצדק שבתורה,"
        },
        {
          "s": 36,
          "text": "שהו\"ע הצדקה בלי הגבלה."
        }
      ]
    }
  ]
}