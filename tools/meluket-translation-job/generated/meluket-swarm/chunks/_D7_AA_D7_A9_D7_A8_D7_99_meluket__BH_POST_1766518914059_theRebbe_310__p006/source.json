  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914059_theRebbe_310__p006",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914059_theRebbe_310",
  "title": "מאמר שובה ישראל תשל\"ז",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "וזהו גם מה שממשיך בכתוב ושובו אל הוי',"
        },
        {
          "s": 1,
          "text": "שלאחרי התשובה דשובה ישראל עד הוי' אלקיך שהיא העלאה מלמטה למעלה,"
        },
        {
          "s": 2,
          "text": "צ\"ל ושובו אל הוי',"
        },
        {
          "s": 3,
          "text": "להמשיך האור מלמעלה למטה ע\"י תומ\"צ שהם דרך הוי'55."
        },
        {
          "s": 4,
          "text": "ועי\"ז,"
        },
        {
          "s": 5,
          "text": "ממשיכים כל ההשפעות לא רק בענינים רוחניים אלא גם בענינים גשמיים,"
        },
        {
          "s": 6,
          "text": "בבני חיי ומזוני רויחי,"
        },
        {
          "s": 7,
          "text": "וכמאמר אדמו\"ר הזקן56"
        },
        {
          "s": 8,
          "text": "אַז דער אויבערשטער גיט אידן גשמיות און אידן מאַכן פון די גשמיות רוחניות,"
        },
        {
          "s": 9,
          "text": "ועושים דירה לו ית' בתחתונים,"
        },
        {
          "s": 10,
          "text": "ועי\"ז – והיתה להוי' המלוכה57."
        }
      ]
    }
  ]
}