{
  "globalIndex": 543,
  "owner": 43,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916877_theRebbe_274__p002",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916877_theRebbe_274__p002",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916877_theRebbe_274",
  "title": "מאמר באתי לגני תשל\"ב",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ולהוסיף,"
        },
        {
          "s": 1,
          "text": "דזה שהפירוש דושכנתי בתוכם"
        },
        {
          "s": 2,
          "text": "(לשון רבים)"
        },
        {
          "s": 3,
          "text": "הוא בתוך כאו\"א מישראל בא"
        },
        {
          "s": 4,
          "text": "(בהמאמר)"
        },
        {
          "s": 5,
          "text": "בהמשך לזה שהורדת והמשכת השכינה למטה היתה ע\"י משה,"
        },
        {
          "s": 6,
          "text": "הוא,"
        },
        {
          "s": 7,
          "text": "כי הכח שבכ\"א מישראל להמשיך שיהי' שוכן בו עיקר שכינה הוא ע\"י המשכת עיקר שכינה למטה שהיתה ע\"י משה."
        },
        {
          "s": 8,
          "text": "דכמו שהירידה וההמשכה למטה שהיתה במתן תורה,"
        },
        {
          "s": 9,
          "text": "וירד הוי' על הר סיני14,"
        },
        {
          "s": 10,
          "text": "היתה באופן שעי\"ז ניתן הכח שגם לאחרי מ\"ת יוכלו להמשיך גילוי אלקות למטה"
        },
        {
          "s": 11,
          "text": "[דזהו שארז\"ל15,"
        },
        {
          "s": 12,
          "text": "שבמתן תורה נתבטלה הגזירה דעליונים לא ירדו למטה,"
        },
        {
          "s": 13,
          "text": "דענין ביטול הגזירה הוא שמכאן ולהבא יכול להיות ירידת עליונים למטה],"
        },
        {
          "s": 14,
          "text": "עד\"ז הוא בנוגע להירידה וההמשכה למטה שהיתה ע\"י המשכן שעשה משה"
        },
        {
          "s": 15,
          "text": "[דמהמעלות שבההמשכה שהיתה במשכן לגבי ההמשכה שהיתה במתן תורה הוא16,"
        },
        {
          "s": 16,
          "text": "דההמשכה למטה שהיתה במתן תורה היתה מצד דלמעלה"
        },
        {
          "s": 17,
          "text": "(ולכן הי' הגילוי רק לפי שעה),"
        },
        {
          "s": 18,
          "text": "וההמשכה במשכן היתה באופן שהמטה"
        },
        {
          "s": 19,
          "text": "(הדברים הגשמיים שמהם נעשה המשכן)"
        },
        {
          "s": 20,
          "text": "נעשה כלי להגילוי],"
        },
        {
          "s": 21,
          "text": "דע\"י שמשה הוריד והמשיך את השכינה במשכן באופן שהמטה נעשה כלי להגילוי,"
        },
        {
          "s": 22,
          "text": "עי\"ז ניתן הכח להמשיך אלקות באופן זה בבית המקדש,"
        },
        {
          "s": 23,
          "text": "וגם בהמקדש הרוחני שבכאו\"א מישראל."
        },
        {
          "s": 24,
          "text": "וע\"י שההמשכה בהמשכן היתה באופן שעי\"ז נמשך גילוי אלקות גם בכללות העולם,"
        },
        {
          "s": 25,
          "text": "נעשה עד\"ז גם בהמקדש הרוחני שבכ\"א מישראל,"
        },
        {
          "s": 26,
          "text": "דהשראת השכינה שבהאדם"
        },
        {
          "s": 27,
          "text": "(ושכנתי בתוכם)"
        },
        {
          "s": 28,
          "text": "תהי' באופן שעי\"ז יומשך גילוי אלקות גם בעולם"
        },
        {
          "s": 29,
          "text": "(וישכנו לעד עלי')."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 2,
          "text": "דהטעם על זה שעיקר שכינה בתחתונים היתה,"
        },
        {
          "s": 3,
          "text": "הוא,"
        },
        {
          "s": 4,
          "text": "כי תכלית הכוונה בבריאת והתהוות העולמות הוא שנתאוה הקב\"ה להיות לו ית' דירה בתחתונים17."
        },
        {
          "s": 5,
          "text": "ומבאר,"
        },
        {
          "s": 6,
          "text": "דזה שנתאוה הקב\"ה להיות לו ית' דירה בתחתונים הוא שיהי' גילוי אלקות למטה ע\"י עבודת האדם,"
        },
        {
          "s": 7,
          "text": "ע\"י אתכפיא ואתהפכא."
        },
        {
          "s": 8,
          "text": "[ויש לומר,"
        },
        {
          "s": 9,
          "text": "דמ\"ש בהמאמר שהגילוי אלקות למטה הוא ע\"י העבודה דאתכפיא ואתהפכא קאי זה"
        },
        {
          "s": 10,
          "text": "(גם)"
        },
        {
          "s": 11,
          "text": "על נתאוה כו' דירה בתחתונים."
        },
        {
          "s": 12,
          "text": "היינו,"
        },
        {
          "s": 13,
          "text": "דבזה שנתאוה שתהי' דירה בתחתונים,"
        },
        {
          "s": 14,
          "text": "כמה ענינים."
        },
        {
          "s": 15,
          "text": "שיהי' גילוי אלקות למטה – בתחתונים,"
        },
        {
          "s": 16,
          "text": "ושהגילוי אלקות למטה יהי' לא על ידי המשכה מלמעלה אלא ע\"י עבודת האדם – עבודת התחתונים,"
        },
        {
          "s": 17,
          "text": "ושהעבודה שעל ידה יומשך הגילוי למטה תהי' העבודה דאתכפיא ואתהפכא – עבודה שמצד ענין התחתונים]."
        },
        {
          "s": 18,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 19,
          "text": "דהגילוי שנמשך למטה ע\"י העבודה דאתכפיא ואתהפכא הוא גילוי שלמעלה משייכות לעולמות."
        },
        {
          "s": 20,
          "text": "[וזהו שע\"י ועשו לי מקדש היתה המשכת עיקר שכינה למטה,"
        },
        {
          "s": 21,
          "text": "דעיקר שכינה הוא האור שלמעלה משייכות לעולמות18,"
        },
        {
          "s": 22,
          "text": "כי העבודה דעשיית המשכן היא העבודה דאתכפיא ואתהפכא,"
        },
        {
          "s": 23,
          "text": "וע\"י עבודה זו הוא המשכת האור שלמעלה מעולמות,"
        },
        {
          "s": 24,
          "text": "עיקר שכינה]."
        },
        {
          "s": 25,
          "text": "וכמאמר19"
        },
        {
          "s": 26,
          "text": "כד אתכפיא סט\"א אסתלק יקרא דקוב\"ה בכולהו עלמין,"
        },
        {
          "s": 27,
          "text": "דפירוש בכולהו עלמין הוא אור שהוא בכולהו עלמין בשוה,"
        },
        {
          "s": 28,
          "text": "והוא האור שלמעלה משייכות לעולמות,"
        },
        {
          "s": 29,
          "text": "וע\"י העבודה דאתכפיא ואתהפכא נמשך20"
        },
        {
          "s": 30,
          "text": "אור זה."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר בפרק שני"
        },
        {
          "s": 2,
          "text": "(הפרק השייך לשנה זו21),"
        },
        {
          "s": 3,
          "text": "שהעבודה שהיתה במשכן ומקדש היא העבודה דאתכפיא המביאה לאתהפכא."
        },
        {
          "s": 4,
          "text": "ולכן אחת העבודות22"
        },
        {
          "s": 5,
          "text": "שהיו במקדש היא עבודת הקרבנות,"
        },
        {
          "s": 6,
          "text": "כי ענין עבודת הקרבנות הוא אתכפיא ואתהפכא"
        },
        {
          "s": 7,
          "text": "(כדלקמן)."
        },
        {
          "s": 8,
          "text": "והנה הקשר דענין זה"
        },
        {
          "s": 9,
          "text": "[שהעבודה שהיתה במשכן ומקדש היא העבודה דאתכפיא ואתהפכא]"
        },
        {
          "s": 10,
          "text": "עם המבואר בתחלת ההמשך"
        },
        {
          "s": 11,
          "text": "(בפשטות)"
        },
        {
          "s": 12,
          "text": "הוא,"
        },
        {
          "s": 13,
          "text": "דכיון שהמשכת עיקר שכינה בתחתונים היתה בעיקר במשכן ומקדש,"
        },
        {
          "s": 14,
          "text": "והמשכת עיקר שכינה למטה היא ע\"י העבודה דאתכפיא ואתהפכא,"
        },
        {
          "s": 15,
          "text": "לכן,"
        },
        {
          "s": 16,
          "text": "עיקר העבודה שהיתה במשכן ומקדש היא העבודה דאתכפיא ואתהפכא."
        },
        {
          "s": 17,
          "text": "אלא,"
        },
        {
          "s": 18,
          "text": "שבתחלת המאמר מדבר בענין המשכת עיקר שכינה למטה"
        },
        {
          "s": 19,
          "text": "(ושכנתי בתוכם)"
        },
        {
          "s": 20,
          "text": "שע\"י עשיית המשכן"
        },
        {
          "s": 21,
          "text": "(ועשו לי מקדש),"
        },
        {
          "s": 22,
          "text": "ובפרק זה מוסיף,"
        },
        {
          "s": 23,
          "text": "שגם ההמשכה במשכן ומקדש"
        },
        {
          "s": 24,
          "text": "[לאחרי עשייתו,"
        },
        {
          "s": 25,
          "text": "דהמשכה זו היא נעלית יותר מההמשכה שהיתה ע\"י עשיית המשכן]"
        },
        {
          "s": 26,
          "text": "היא על ידי העבודה דאתכפיא ואתהפכא."
        },
        {
          "s": 27,
          "text": "ולכן,"
        },
        {
          "s": 28,
          "text": "עיקר העבודה שהיתה במשכן ומקדש היא עבודת הקרבנות,"
        },
        {
          "s": 29,
          "text": "אתכפיא ואתהפכא."
        }
      ]
    }
  ]
}