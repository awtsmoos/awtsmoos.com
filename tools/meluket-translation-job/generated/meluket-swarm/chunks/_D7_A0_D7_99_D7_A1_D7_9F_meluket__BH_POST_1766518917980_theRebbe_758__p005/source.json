{
  "globalIndex": 721,
  "owner": 21,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917980_theRebbe_758__p005",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917980_theRebbe_758__p005",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917980_theRebbe_758",
  "title": "מאמר ונחה עליו רוח ה' תשכ\"ה",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יובן מה שמוסיף בהמאמר שהירידה היא לצורך עלי',"
        },
        {
          "s": 1,
          "text": "שבזה מבאר"
        },
        {
          "s": 2,
          "text": "(כנ\"ל סעיף ד)"
        },
        {
          "s": 3,
          "text": "דזה שע\"י העבודה דזמן הגלות יהי' הגילוי דלע\"ל הוא לא רק הגילוי דהענינים שלמעלה מהשגה וראי'"
        },
        {
          "s": 4,
          "text": "(שמשיח יגלה אותם מצד זה שהוא מלך),"
        },
        {
          "s": 5,
          "text": "אלא59"
        },
        {
          "s": 6,
          "text": "גם הענינים דהשגה וראי'60,"
        },
        {
          "s": 7,
          "text": "שמשיח יגלה אותם בתור רב61,"
        },
        {
          "s": 8,
          "text": "שגם הגילוי דענינים אלו הוא ע\"י העבודה דזמן הגלות,"
        },
        {
          "s": 9,
          "text": "כי זה שלע\"ל יהי' וראו כל בשר גו' מצד הטבע והתכונות דבשר גופא,"
        },
        {
          "s": 10,
          "text": "הוא דוקא ע\"י שמגלים הכוונה הפנימית דהירידה,"
        },
        {
          "s": 11,
          "text": "שהירידה היא צורך עלי'."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "והנה ענין זה"
        },
        {
          "s": 2,
          "text": "(שהצמצום הוא בשביל הגילוי)"
        },
        {
          "s": 3,
          "text": "מתגלה"
        },
        {
          "s": 4,
          "text": "(בעיקר)"
        },
        {
          "s": 5,
          "text": "ע\"י העבודה דזמן הגלות."
        },
        {
          "s": 6,
          "text": "דהנה הירידה דגלות,"
        },
        {
          "s": 7,
          "text": "היא לצורך עלי'"
        },
        {
          "s": 8,
          "text": "(בדוגמת מה שהצמצום הוא בשביל הגילוי)."
        },
        {
          "s": 9,
          "text": "אלא שבענין זה"
        },
        {
          "s": 10,
          "text": "(הירידה דגלות)"
        },
        {
          "s": 11,
          "text": "מיתוסף,"
        },
        {
          "s": 12,
          "text": "שגם בזמן הגלות גופא רואים בפועל איך שההעלם דהגלות מעורר את כח המס\"נ."
        },
        {
          "s": 13,
          "text": "והענין הוא כמבואר בהמאמר62,"
        },
        {
          "s": 14,
          "text": "דבזמן הגלות,"
        },
        {
          "s": 15,
          "text": "ובפרט בדרא דעקבתא דמשיחא,"
        },
        {
          "s": 16,
          "text": "כח המס\"נ הוא בגילוי יותר מבזמן הבית."
        },
        {
          "s": 17,
          "text": "ומביא משל על זה מכח הרצון שבנפש האדם,"
        },
        {
          "s": 18,
          "text": "שעם היותו כח מקיף,"
        },
        {
          "s": 19,
          "text": "שלכן הוא נמצא בכל האברים,"
        },
        {
          "s": 20,
          "text": "מ\"מ,"
        },
        {
          "s": 21,
          "text": "עיקר גילוי הרצון הוא בהעקביים63,"
        },
        {
          "s": 22,
          "text": "שלכן נקל יותר לאדם להכניס עקבו במים רותחים מכמו לתת מים רותחים על ראשו."
        },
        {
          "s": 23,
          "text": "דכמו\"כ הוא גם בהציור קומה דכנס\"י,"
        },
        {
          "s": 24,
          "text": "שכח המס\"נ"
        },
        {
          "s": 25,
          "text": "(כח בלתי מוגבל,"
        },
        {
          "s": 26,
          "text": "שלמעלה מהתלבשות בכלים)"
        },
        {
          "s": 27,
          "text": "הוא בגילוי יותר באנשים פשוטים"
        },
        {
          "s": 28,
          "text": "(בחינת עקביים)"
        },
        {
          "s": 29,
          "text": "מבבעלי מוחין."
        },
        {
          "s": 30,
          "text": "ועד\"ז הוא בהציור קומה דכללות כל הדורות,"
        },
        {
          "s": 31,
          "text": "שעיקר גילוי כח המס\"נ הוא בדרא דעקבתא דמשיחא."
        },
        {
          "s": 32,
          "text": "דהסיבה לזה מה שהעלם הגלות מעורר ומגלה כח המס\"נ"
        },
        {
          "s": 33,
          "text": "(אף שהעלם וגילוי הם שני הפכים)"
        },
        {
          "s": 34,
          "text": "הוא מפני ששרש ההעלם דגלות הוא ההעלם דצמצום הראשון,"
        },
        {
          "s": 35,
          "text": "שכוונתו הוא בשביל הגילוי."
        },
        {
          "s": 36,
          "text": "וע\"י העבודה דמס\"נ בזמן הגלות,"
        },
        {
          "s": 37,
          "text": "עי\"ז מתגלה בפועל ענין הפנימי דההעלם"
        },
        {
          "s": 38,
          "text": "(דהעלם הגלות,"
        },
        {
          "s": 39,
          "text": "ועד לשרשו ההעלם דצמצום הראשון),"
        },
        {
          "s": 40,
          "text": "שענינו הוא בשביל הגילוי."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "וע\"פ כל הנ\"ל יובן ג\"כ מה שבהעבודה דזמן הגלות,"
        },
        {
          "s": 3,
          "text": "ובפרט בדרא דעקבתא דמשיחא,"
        },
        {
          "s": 4,
          "text": "ישנם ב' ענינים,"
        },
        {
          "s": 5,
          "text": "לימוד פנימיות התורה בהבנה והשגה דוקא,"
        },
        {
          "s": 6,
          "text": "וביחד עם זה העבודה דמס\"נ."
        },
        {
          "s": 7,
          "text": "כי בפנימיות התורה שתתגלה לעתיד ישנם שתי מדריגות,"
        },
        {
          "s": 8,
          "text": "מה שאפשר לבוא בהשגה,"
        },
        {
          "s": 9,
          "text": "ועצם פנימיות התורה שלמעלה מהשגה"
        },
        {
          "s": 10,
          "text": "(ולמעלה גם מראי')."
        },
        {
          "s": 11,
          "text": "ומכיון שכל הגילויים דלעתיד תלויים במעשינו ועבודתינו עכשיו64,"
        },
        {
          "s": 12,
          "text": "לכן דורשים מכאו\"א ב' העבודות,"
        },
        {
          "s": 13,
          "text": "ההתעסקות בלימוד החסידות"
        },
        {
          "s": 14,
          "text": "(מעין תורתו של משיח)"
        },
        {
          "s": 15,
          "text": "בהבנה והשגה65,"
        },
        {
          "s": 16,
          "text": "וביחד עם זה העבודה דמס\"נ,"
        },
        {
          "s": 17,
          "text": "מסירת הרצון,"
        },
        {
          "s": 18,
          "text": "שע\"י ב' עבודות אלו יהי' גילוי המשיח בב' האופנים דרב ומלך,"
        },
        {
          "s": 19,
          "text": "בקרוב ממש."
        }
      ]
    }
  ]
}