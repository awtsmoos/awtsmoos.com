{
  "globalIndex": 449,
  "owner": 49,
  "jobId": "_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916328_theRebbe_715__p005",
  "batchId": "meluket-_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916328_theRebbe_715__p005",
  "seriesId": "טבת_meluket",
  "postId": "BH_POST_1766518916328_theRebbe_715",
  "title": "מאמר וארא אל אברהם תשל\"ה",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וזהו החילוק בין שם שדי ושם הוי',"
        },
        {
          "s": 2,
          "text": "דשם שדי שייך לעולמות כנ\"ל,"
        },
        {
          "s": 3,
          "text": "ושם הוי' הוא למעלה משייכות לעולמות."
        },
        {
          "s": 4,
          "text": "וכמארז\"ל28"
        },
        {
          "s": 5,
          "text": "עד שלא נברא העולם הי' הוא ושמו בלבד,"
        },
        {
          "s": 6,
          "text": "דזה ששמו"
        },
        {
          "s": 7,
          "text": "[שם הוי'29]"
        },
        {
          "s": 8,
          "text": "הי' עד שלא נברא העולם הוא לפי שהוא למעלה משייכות לעולמות."
        },
        {
          "s": 9,
          "text": "ולכן,"
        },
        {
          "s": 10,
          "text": "גם לאחרי שנברא העולם,"
        },
        {
          "s": 11,
          "text": "כשמאיר בעולם גילוי שם הוי',"
        },
        {
          "s": 12,
          "text": "אופן הגילוי שלו הוא"
        },
        {
          "s": 13,
          "text": "(לא לפי אופן העולם,"
        },
        {
          "s": 14,
          "text": "אלא)"
        },
        {
          "s": 15,
          "text": "שהאור עצמו הוא מתגלה."
        },
        {
          "s": 16,
          "text": "ועפ\"ז יש לבאר הטעם על זה שהנסים הנמשכים משם שדי הם מלובשים בטבע והנסים הנמשכים משם הוי' הם למעלה מהטבע"
        },
        {
          "s": 17,
          "text": "(כנ\"ל סעיף ד),"
        },
        {
          "s": 18,
          "text": "כי האור השייך לעולמות,"
        },
        {
          "s": 19,
          "text": "אופן הגילוי שלו הוא שהוא מאיר ופועל בההארה שנעשית מקור להוות הנבראים,"
        },
        {
          "s": 20,
          "text": "ולכן הנסים הנמשכים משם שדי על שם שדי באלקותי לכל ברי' הם מלובשים בטבע."
        },
        {
          "s": 21,
          "text": "והאור שלמעלה משייכות לעולמות"
        },
        {
          "s": 22,
          "text": "(הוי'),"
        },
        {
          "s": 23,
          "text": "אופן הגילוי שלו הוא שמתגלה האור עצמו."
        },
        {
          "s": 24,
          "text": "ולכן הנסים הנמשכים משם הוי' הם למעלה מהטבע."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש לבאר הטעם על זה שהגילוי אלקות שעל ידי הנסים שלמעלה מהטבע הוא למעלה מדי מחסורו"
        },
        {
          "s": 1,
          "text": "(ראה לעיל סעיף ד),"
        },
        {
          "s": 2,
          "text": "כי באור השייך לעולמות שייך לומר דכאשר האור אינו מאיר בהעולם,"
        },
        {
          "s": 3,
          "text": "העולם הוא חסר,"
        },
        {
          "s": 4,
          "text": "וכשמאיר בגילוי נעשה מילוי החסרון."
        },
        {
          "s": 5,
          "text": "אבל זה שאינו מאיר בעולם האור שלמעלה משייכות לעולמות,"
        },
        {
          "s": 6,
          "text": "אין זה חסרון בהעולם מכיון שאור זה אינו שייך אליו"
        },
        {
          "s": 7,
          "text": "[והמשכת אור זה הוא לא מילוי החסרון אלא עשירות]."
        },
        {
          "s": 8,
          "text": "וכיון שהנסים שלמעלה מהטבע נמשכים מהאור שלמעלה משייכות לעולמות,"
        },
        {
          "s": 9,
          "text": "לכן,"
        },
        {
          "s": 10,
          "text": "הגילוי דנסים אלו הוא לא מילוי חסרון אלא עשירות."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 2,
          "text": "דע\"פ הנ\"ל שהגילוי דא-ל שדי להאבות הוא למעלה משם שדי שהי' בהבריאה,"
        },
        {
          "s": 3,
          "text": "דשם שדי שהי' בהבריאה הוא על שם שאמרתי לעולמי די ושם שדי שנתגלה להאבות הוא על שם שדי באלקותי לכל ברי',"
        },
        {
          "s": 4,
          "text": "דמשם זה נמשכים נסים מלמעלה מהטבע"
        },
        {
          "s": 5,
          "text": "(אלא שהם מלובשים בטבע),"
        },
        {
          "s": 6,
          "text": "צריך להבין עוד יותר הדיוק"
        },
        {
          "s": 7,
          "text": "(שבתחילת המאמר)"
        },
        {
          "s": 8,
          "text": "שדוקא שם הוי' הוא מדת אמיתית,"
        },
        {
          "s": 9,
          "text": "איך שייך לומר שהאור שלמעלה מעולמות"
        },
        {
          "s": 10,
          "text": "(ורק שייך לעולמות)"
        },
        {
          "s": 11,
          "text": "אינו אמת ח\"ו."
        }
      ]
    }
  ]
}