{
  "globalIndex": 207,
  "owner": 7,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914993_theRebbe_833__p003",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914993_theRebbe_833__p003",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518914993_theRebbe_833",
  "title": "מאמר ויהיו חיי שרה תנש\"א",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה,"
        },
        {
          "s": 2,
          "text": "ע\"י ההמשכה וההתלבשות דמאה שנה כללא דכולא בהמוחין השייכים אל המדות"
        },
        {
          "s": 3,
          "text": "(עשרים שנה)"
        },
        {
          "s": 4,
          "text": "ובהמדות"
        },
        {
          "s": 5,
          "text": "(שבע שנים)"
        },
        {
          "s": 6,
          "text": "עד לעבודה במעשה בפועל כדי שיהי' גילוי אלקות בעולם,"
        },
        {
          "s": 7,
          "text": "אזי נעשה"
        },
        {
          "s": 8,
          "text": "(נוסף על בירור וזיכוך המטה)"
        },
        {
          "s": 9,
          "text": "גם עילוי גדול יותר בבחי' מאה שנה כללא דכולא,"
        },
        {
          "s": 10,
          "text": "כידוע29"
        },
        {
          "s": 11,
          "text": "שע\"י הירידה דהעליון להשפיע להתחתון מקבל גם העליון מעלת התחתון"
        },
        {
          "s": 12,
          "text": "(שלכן כל סדר ההשתלשלות הוא באופן דנעוץ תחילתן בסופן30,"
        },
        {
          "s": 13,
          "text": "שהעליון צריך גם לקבל מהתחתון)."
        },
        {
          "s": 14,
          "text": "ויתירה מזה,"
        },
        {
          "s": 15,
          "text": "כיון שההמשכה למטה היא מפני שנתאווה הקב\"ה להיות לו ית' דירה בתחתונים31,"
        },
        {
          "s": 16,
          "text": "הרי,"
        },
        {
          "s": 17,
          "text": "ע\"י ההמשכה למטה נשלמת כוונת העצמות שלמעלה מכל תואר וגדר,"
        },
        {
          "s": 18,
          "text": "שלכן,"
        },
        {
          "s": 19,
          "text": "מעלה ומטה,"
        },
        {
          "s": 20,
          "text": "בלי גבול וגבול,"
        },
        {
          "s": 21,
          "text": "שוין ממש."
        },
        {
          "s": 22,
          "text": "והחילוק דב' אופנים אלו בעבודה,"
        },
        {
          "s": 23,
          "text": "שבאופן הא' יש חילוק בין עליון"
        },
        {
          "s": 24,
          "text": "(עבודה בעניני קדושה)"
        },
        {
          "s": 25,
          "text": "לתחתון"
        },
        {
          "s": 26,
          "text": "(עבודה בעניני העולם),"
        },
        {
          "s": 27,
          "text": "והעבודה למטה הו\"ע של ירידה,"
        },
        {
          "s": 28,
          "text": "אלא שירידה זו היא צורך עלי'."
        },
        {
          "s": 29,
          "text": "ובאופן הב',"
        },
        {
          "s": 30,
          "text": "כיון שכל ענינו אינו אלא למלא חפצו ורצונו של הקב\"ה שנתאוה להיות לו ית' דירה בתחתונים,"
        },
        {
          "s": 31,
          "text": "הרי,"
        },
        {
          "s": 32,
          "text": "מצד כוונת העצמות אין חילוק בין עליון"
        },
        {
          "s": 33,
          "text": "(עבודה בעניני קדושה)"
        },
        {
          "s": 34,
          "text": "לתחתון"
        },
        {
          "s": 35,
          "text": "(עבודה בעניני העולם),"
        },
        {
          "s": 36,
          "text": "ובמילא,"
        },
        {
          "s": 37,
          "text": "העבודה למטה אינה ענין של ירידה,"
        },
        {
          "s": 38,
          "text": "כיון שנרגש בה הנקודה הכללית"
        },
        {
          "s": 39,
          "text": "(כללא דכולא)"
        },
        {
          "s": 40,
          "text": "שבכל עניני העבודה בשוה ממש,"
        },
        {
          "s": 41,
          "text": "כוונת העצמות."
        },
        {
          "s": 42,
          "text": "וזהו גם רזא דמאה ברכות בכל יום,"
        },
        {
          "s": 43,
          "text": "כפי שלמדו חז\"ל ממש\"נ מה ה' אלקיך שואל מעמך,"
        },
        {
          "s": 44,
          "text": "א\"ת מה אלא מאה,"
        },
        {
          "s": 45,
          "text": "כמבואר בהדרושים32"
        },
        {
          "s": 46,
          "text": "שמאה הוא מה בתוספת אל\"ף,"
        },
        {
          "s": 47,
          "text": "מה הו\"ע הביטול"
        },
        {
          "s": 48,
          "text": "(ונחנו מה33),"
        },
        {
          "s": 49,
          "text": "וע\"י הביטול דמה ממשיכים האל\"ף,"
        },
        {
          "s": 50,
          "text": "בחי' הכתר"
        },
        {
          "s": 51,
          "text": "(מאה),"
        },
        {
          "s": 52,
          "text": "שיומשך בגילוי למטה ע\"י הברכות."
        },
        {
          "s": 53,
          "text": "דכיון שעבודתו היא מצד הביטול והקבלת עול שבה מתגלה עצם הנשמה,"
        },
        {
          "s": 54,
          "text": "הרי כל ענינו אינו אלא למלא רצונו וחפצו של הקב\"ה,"
        },
        {
          "s": 55,
          "text": "שזוהי הנקודה הכללית דכל עניני העבודה,"
        },
        {
          "s": 56,
          "text": "כוונת העצמות."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יש לבאר מ\"ש ויהיו חיי שרה מאה שנה ועשרים שנה ושבע שנים שני חיי שרה,"
        },
        {
          "s": 2,
          "text": "ששני חיי שרה"
        },
        {
          "s": 3,
          "text": "(אינו ענין בפ\"ע שלמעלה מג' החלוקות דמאה שנה ועשרים שנה ושבע שנים,"
        },
        {
          "s": 4,
          "text": "אלא)"
        },
        {
          "s": 5,
          "text": "הם הקכ\"ז שנה עצמם,"
        },
        {
          "s": 6,
          "text": "שכולן שוין לטובה."
        },
        {
          "s": 7,
          "text": "כי,"
        },
        {
          "s": 8,
          "text": "בתחילת הכתוב מבואר העילוי שנעשה במאה שנה ע\"י ההמשכה למטה,"
        },
        {
          "s": 9,
          "text": "שזהו\"ע דבת ק' כבת כ' ובת כ' כבת ז',"
        },
        {
          "s": 10,
          "text": "שבמאה נוסף גם העילוי דעשרים,"
        },
        {
          "s": 11,
          "text": "ובעשרים נוסף גם העילוי דשבע."
        },
        {
          "s": 12,
          "text": "ולאח\"ז מוסיף בכתוב שני חיי שרה,"
        },
        {
          "s": 13,
          "text": "שכל סוגי העבודה דמאה שנה"
        },
        {
          "s": 14,
          "text": "(כתר)"
        },
        {
          "s": 15,
          "text": "עשרים שנה"
        },
        {
          "s": 16,
          "text": "(מוחין)"
        },
        {
          "s": 17,
          "text": "ושבע שנים"
        },
        {
          "s": 18,
          "text": "(מדות)"
        },
        {
          "s": 19,
          "text": "הם שוין לטובה,"
        },
        {
          "s": 20,
          "text": "שכל ענינם הוא להשלים כוונת העצמות,"
        },
        {
          "s": 21,
          "text": "שהיא בכל עניני העבודה בשוה34."
        },
        {
          "s": 22,
          "text": "ויש להוסיף בהביאור דכולן שוין לטובה,"
        },
        {
          "s": 23,
          "text": "שטובה רומז על עצם ומקור הטוב וטבע הטוב להיטיב35"
        },
        {
          "s": 24,
          "text": "כפי שנמשך ומתגלה בנשמתו של כאו\"א מישראל שהיא \"חלק אלקה ממעל ממש\"36,"
        },
        {
          "s": 25,
          "text": "חלק מן העצם שעל ידו תופסים בהעצם37,"
        },
        {
          "s": 26,
          "text": "וכאשר העבודה היא מצד עצם הנשמה,"
        },
        {
          "s": 27,
          "text": "שזהו\"ע הביטול והקבלת עול,"
        },
        {
          "s": 28,
          "text": "אזי כל עניני העבודה הם בשוה,"
        },
        {
          "s": 29,
          "text": "וההשתוות היא לטובה,"
        },
        {
          "s": 30,
          "text": "שכל עניני העבודה חדורים בהנקודה הכללית דהמשכת וגילוי עצם הטוב למטה,"
        },
        {
          "s": 31,
          "text": "להיות לו ית' דירה בתחתונים."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ויהי רצון,"
        },
        {
          "s": 2,
          "text": "שכיון שבימינו אלה נשלמו כל מעשינו ועבודתינו בכל פרטי הענינים דמאה שנה ועשרים שנה ושבע שנים,"
        },
        {
          "s": 3,
          "text": "ובאופן דשני חיי שרה שכולן שוין לטובה,"
        },
        {
          "s": 4,
          "text": "כדברי כ\"ק מו\"ח אדמו\"ר נשיא דורנו שכבר צחצחו את הכפתורים38,"
        },
        {
          "s": 5,
          "text": "ועומדים מוכנים39"
        },
        {
          "s": 6,
          "text": "לקבל פני משיח צדקנו,"
        },
        {
          "s": 7,
          "text": "ובפרט שלאחרי זה עברו עוד עשיריות שנים שבהם צעקו בנ\"י עד מתי"
        },
        {
          "s": 8,
          "text": "(וואָס דאָס דאַרף דאָך אויך האָבן אַ שיעור),"
        },
        {
          "s": 9,
          "text": "תבוא תיכף ומיד הגאולה האמיתית והשלימה ע\"י משיח צדקנו,"
        },
        {
          "s": 10,
          "text": "ואז יתגלה הענין דתולדות יצחק"
        },
        {
          "s": 11,
          "text": "(כפי שמתחילין לקרוא בתורה במנחה),"
        },
        {
          "s": 12,
          "text": "כמארז\"ל40"
        },
        {
          "s": 13,
          "text": "שלעתיד לבוא יאמרו ליצחק דוקא כי אתה אבינו41,"
        },
        {
          "s": 14,
          "text": "כיון שהתענוג והצחוק"
        },
        {
          "s": 15,
          "text": "(יצחק42)"
        },
        {
          "s": 16,
          "text": "שנעשה ע\"י מעשינו ועבודתינו כל משך זמן הגלות43"
        },
        {
          "s": 17,
          "text": "יתגלה לעתיד לבוא,"
        },
        {
          "s": 18,
          "text": "שאז44"
        },
        {
          "s": 19,
          "text": "ימלא שחוק פינו45,"
        },
        {
          "s": 20,
          "text": "ואז יהי' הענין דמאה שנה ועשרים שנה ושבע שנים באופן נעלה יותר46,"
        },
        {
          "s": 21,
          "text": "הן הענין דמאה שנה,"
        },
        {
          "s": 22,
          "text": "מאה ברכות,"
        },
        {
          "s": 23,
          "text": "והן הענין דכ\"ז שנה,"
        },
        {
          "s": 24,
          "text": "שרומז"
        },
        {
          "s": 25,
          "text": "(גם)"
        },
        {
          "s": 26,
          "text": "לכ\"ז47"
        },
        {
          "s": 27,
          "text": "אותיות התורה48,"
        },
        {
          "s": 28,
          "text": "כיון שכל עניני התומ\"צ יהיו בתכלית השלימות,"
        },
        {
          "s": 29,
          "text": "כמצות רצונך49,"
        },
        {
          "s": 30,
          "text": "ותורה חדשה מאתי תצא50,"
        },
        {
          "s": 31,
          "text": "טעמי תורה שיתגלו לעתיד לבוא בתורתו של משיח51,"
        },
        {
          "s": 32,
          "text": "כולל גם התורה חדשה דרבותינו נשיאינו עד לבעל יום ההולדת דכ\"ף מרחשון,"
        },
        {
          "s": 33,
          "text": "ובנו יחידו ממלא מקומו כ\"ק מו\"ח אדמו\"ר נשיא דורנו,"
        },
        {
          "s": 34,
          "text": "שהקיצו ורננו שוכני עפר52,"
        },
        {
          "s": 35,
          "text": "והם בראשם,"
        },
        {
          "s": 36,
          "text": "ויאמרו תורה חדשה,"
        },
        {
          "s": 37,
          "text": "חידוש גם לגבי הקב\"ה,"
        },
        {
          "s": 38,
          "text": "כביכול,"
        },
        {
          "s": 39,
          "text": "ע\"ד מארז\"ל53"
        },
        {
          "s": 40,
          "text": "נצחוני בני נצחוני,"
        },
        {
          "s": 41,
          "text": "עד לתורה חדשה מאתי תצא,"
        },
        {
          "s": 42,
          "text": "מאתי54"
        },
        {
          "s": 43,
          "text": "דייקא,"
        },
        {
          "s": 44,
          "text": "ובאופן שלא ילמדו עוד איש את רעהו גו' כי כולם ידעו אותי55,"
        },
        {
          "s": 45,
          "text": "אותי54"
        },
        {
          "s": 46,
          "text": "דייקא,"
        },
        {
          "s": 47,
          "text": "ועוד והוא העיקר,"
        },
        {
          "s": 48,
          "text": "שכל זה יהי' תיכף ומיד ממש,"
        },
        {
          "s": 49,
          "text": "ממש ממש."
        }
      ]
    }
  ]
}