{
  "globalIndex": 506,
  "owner": 6,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916754_theRebbe_640__p005",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916754_theRebbe_640__p005",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916754_theRebbe_640",
  "title": "מאמר באתי לגני תשכ\"ח",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה בתורה אור שם60"
        },
        {
          "s": 2,
          "text": "(במאמר שמבאר הענין דלא אדם הוא להנחם)"
        },
        {
          "s": 3,
          "text": "מבאר דענין אדם הוא ג' קוין."
        },
        {
          "s": 4,
          "text": "דגם ענין זה שבאדם"
        },
        {
          "s": 5,
          "text": "(שהוא בציור דג' קוין)"
        },
        {
          "s": 6,
          "text": "מורה על גודל מעלתו."
        },
        {
          "s": 7,
          "text": "וכמבואר במק\"א61"
        },
        {
          "s": 8,
          "text": "דעיקר החילוק בין תוהו לתיקון הוא,"
        },
        {
          "s": 9,
          "text": "דבתוהו היו הספירות בבחי' ב' קוין"
        },
        {
          "s": 10,
          "text": "(ימין ושמאל),"
        },
        {
          "s": 11,
          "text": "ובתיקון הם בבחי' ג' קוין"
        },
        {
          "s": 12,
          "text": "(ימין שמאל ואמצע)."
        },
        {
          "s": 13,
          "text": "ומעלת התיקון שיש בו ג' קוין הוא"
        },
        {
          "s": 14,
          "text": "(לא רק שנתוסף בו עוד קו,"
        },
        {
          "s": 15,
          "text": "קו האמצעי,"
        },
        {
          "s": 16,
          "text": "אלא גם)"
        },
        {
          "s": 17,
          "text": "שע\"י קו האמצעי נעשה חיבור והתכללות דב' הקוין ימין ושמאל."
        },
        {
          "s": 18,
          "text": "וזה שקו האמצעי מחבר ומייחד ב' הקוין חו\"ג הוא62"
        },
        {
          "s": 19,
          "text": "לפי ששרשו הוא מאוא\"ס שלימותא דכולא שכולל השלימות דב' הקוין."
        },
        {
          "s": 20,
          "text": "ונמצא,"
        },
        {
          "s": 21,
          "text": "דגם זה שאדם הוא בציור ג' קוין מורה על השלימות דאדם63."
        },
        {
          "s": 22,
          "text": "וזה שמבאר בהמאמר דאדם הוא מוחין ומדות ולא הענין דג' קוין,"
        },
        {
          "s": 23,
          "text": "יש לומר,"
        },
        {
          "s": 24,
          "text": "דזה שמבאר כאן ענין אדם הוא"
        },
        {
          "s": 25,
          "text": "(בעיקר)"
        },
        {
          "s": 26,
          "text": "בכדי לבאר הטעם על זה שבאדם שייך נחמה וחרטה,"
        },
        {
          "s": 27,
          "text": "דענין הנחמה וחרטה הוא שינוי והתהפכות,"
        },
        {
          "s": 28,
          "text": "היינו,"
        },
        {
          "s": 29,
          "text": "דלא רק שלפעמים הוא בקו החסד ולפעמים בקו הגבורה ולפעמים בקו הת\"ת"
        },
        {
          "s": 30,
          "text": "[ועד\"ז שבאלף הראשון היתה ההנהגה ע\"פ מדת החסד,"
        },
        {
          "s": 31,
          "text": "באלף השני ע\"פ מדת הגבורה,"
        },
        {
          "s": 32,
          "text": "וכו'64],"
        },
        {
          "s": 33,
          "text": "כי אם,"
        },
        {
          "s": 34,
          "text": "שבאותו הזמן והמצב משתנה מחסד לדין ומדין לחסד."
        },
        {
          "s": 35,
          "text": "ויתירה מזו,"
        },
        {
          "s": 36,
          "text": "דהשינוי הוא באופן דנחומין וחרטה,"
        },
        {
          "s": 37,
          "text": "דלא רק שמכאן ולהבא הנהגתו היא במדה אחרת"
        },
        {
          "s": 38,
          "text": "(אף שגם עכשיו הוא אותו המעמד ומצב),"
        },
        {
          "s": 39,
          "text": "אלא שהוא מתחרט על הנהגתו שלפני זה."
        },
        {
          "s": 40,
          "text": "ולכן מבאר בהמאמר דאדם הוא מוחין ומדות,"
        },
        {
          "s": 41,
          "text": "ולא הענין דג' קוין,"
        },
        {
          "s": 42,
          "text": "כי זה שנעשה שינוי המדות ובאופן דנחומין וחרטה הוא לפי שאדם הוא מוחין ומדות,"
        },
        {
          "s": 43,
          "text": "והמדות שלו הם ע\"פ השכל."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "והענין הוא דהנה כתיב65"
        },
        {
          "s": 2,
          "text": "לפי שכלו יהולל איש,"
        },
        {
          "s": 3,
          "text": "וידוע66"
        },
        {
          "s": 4,
          "text": "דזה שהאדם נקרא בשם איש הוא מצד המדות שבו"
        },
        {
          "s": 5,
          "text": "[דזהו החילוק בין התואר אדם להתואר איש,"
        },
        {
          "s": 6,
          "text": "דמה שנקרא בשם אדם הוא מצד השכל שבו ומה שנקרא בשם איש הוא מצד המדות שבו],"
        },
        {
          "s": 7,
          "text": "ופירוש לפי שכלו יהולל איש הוא דגם המדות שבאדם"
        },
        {
          "s": 8,
          "text": "(איש)"
        },
        {
          "s": 9,
          "text": "הם לפי שכלו."
        },
        {
          "s": 10,
          "text": "והיינו67"
        },
        {
          "s": 11,
          "text": "דגם המדות טבעיות שבאדם,"
        },
        {
          "s": 12,
          "text": "עם היות שעצם מציאותן הוא מצד הטבע"
        },
        {
          "s": 13,
          "text": "[ודלא כהמדות שכליות שכל מציאותן הוא מצד השכל],"
        },
        {
          "s": 14,
          "text": "הן מתעוררות ע\"י השכל."
        },
        {
          "s": 15,
          "text": "דזהו מ\"ש68"
        },
        {
          "s": 16,
          "text": "אל ירך לבבכם אל תיראו גו',"
        },
        {
          "s": 17,
          "text": "דלכאורה,"
        },
        {
          "s": 18,
          "text": "הרי היראה במלחמה היא דבר טבעי ואיך שייך ציווי על זה אל תיראו,"
        },
        {
          "s": 19,
          "text": "והביאור בזה,"
        },
        {
          "s": 20,
          "text": "דמכיון שהתעוררות מדות הטבעיות הוא ע\"י השכל,"
        },
        {
          "s": 21,
          "text": "לכן,"
        },
        {
          "s": 22,
          "text": "כשלא ישים דעתו ומחשבתו בזה,"
        },
        {
          "s": 23,
          "text": "לא ירך לבבו ולא ירא ויפחד כלל."
        },
        {
          "s": 24,
          "text": "וכמ\"ש הרמב\"ם69"
        },
        {
          "s": 25,
          "text": "וכל המתחיל לחשוב ולהרהר במלחמה ומבהיל עצמו עובר בלא תעשה,"
        },
        {
          "s": 26,
          "text": "שנאמר אל ירך לבבכם אל תיראו גו',"
        },
        {
          "s": 27,
          "text": "דגם יראה טבעית מתעוררת ופועלת כשמחשב ומהרהר בה."
        },
        {
          "s": 28,
          "text": "וכ\"ה גם בנפש האלקית,"
        },
        {
          "s": 29,
          "text": "דגם המדות טבעיות שלה,"
        },
        {
          "s": 30,
          "text": "התעוררותן הוא ע\"י השכל."
        },
        {
          "s": 31,
          "text": "דזהו מ\"ש70"
        },
        {
          "s": 32,
          "text": "ואהבת את ה' אלקיך,"
        },
        {
          "s": 33,
          "text": "דהגם שכל אחד מישראל בטבעו אוהב את ה',"
        },
        {
          "s": 34,
          "text": "וכתורת אדמו\"ר הזקן71"
        },
        {
          "s": 35,
          "text": "שכל אחד מישראל אינו רוצה בשום אופן ואינו יכול כלל להיות נפרד ח\"ו מאלקות,"
        },
        {
          "s": 36,
          "text": "מ\"מ ישנו ציווי על זה,"
        },
        {
          "s": 37,
          "text": "כי אהבה טבעית התעוררותה היא ע\"י התבוננות ועל זה הוא הציווי שיתבונן בדברים המעוררים את האהבה."
        },
        {
          "s": 38,
          "text": "וענין זה"
        },
        {
          "s": 39,
          "text": "(דהתעוררות האהבה היא ע\"י התבוננות)"
        },
        {
          "s": 40,
          "text": "הוא לא רק מצד ההעלם וההסתר דנה\"ב,"
        },
        {
          "s": 41,
          "text": "אלא גם מצד נפש האלקית,"
        },
        {
          "s": 42,
          "text": "כי המדות שבאדם,"
        },
        {
          "s": 43,
          "text": "ומכ\"ש נפש האלקית שבו,"
        },
        {
          "s": 44,
          "text": "הם ע\"פ שכל."
        },
        {
          "s": 45,
          "text": "ולאידך,"
        },
        {
          "s": 46,
          "text": "גם לאחרי שנה\"א נתלבשה בגוף ונה\"ב,"
        },
        {
          "s": 47,
          "text": "ע\"י התבוננות וכו' בהכרח שהאהבה הטבעית דנפש האלקית תבוא בגילוי."
        },
        {
          "s": 48,
          "text": "דמזה גופא שכל אחד מישראל נצטווה לאהוב את ה' מוכח שזה תלוי בבחירתו."
        },
        {
          "s": 49,
          "text": "ואין לומר,"
        },
        {
          "s": 50,
          "text": "דהציווי הוא רק על ההתבוננות,"
        },
        {
          "s": 51,
          "text": "וכמ\"ש אדמו\"ר הזקן72"
        },
        {
          "s": 52,
          "text": "שקיבל מהבעש\"ט ש\"מצות ואהבת היא לתקוע מחשבתו ודעתו .."
        },
        {
          "s": 53,
          "text": "בדברים המעוררים את האהבה,"
        },
        {
          "s": 54,
          "text": "ומה שיבוא מזה אין זה מעיקר המצוה\","
        },
        {
          "s": 55,
          "text": "שהרי פירוש הפשוט דואהבת הוא שיאהוב את ה'."
        },
        {
          "s": 56,
          "text": "ומזה מוכח,"
        },
        {
          "s": 57,
          "text": "דכאו\"א מישראל,"
        },
        {
          "s": 58,
          "text": "כשיתבונן בזה"
        },
        {
          "s": 59,
          "text": "(ויהי' לו גם השימת לב),"
        },
        {
          "s": 60,
          "text": "בהכרח שסוף סוף יהי' לו אהבת ה'73."
        },
        {
          "s": 61,
          "text": "וזהו מ\"ש בהמאמר,"
        },
        {
          "s": 62,
          "text": "שבמדות שבאדם יכול להיות שינוי מחסד לדין ומדין לחסד,"
        },
        {
          "s": 63,
          "text": "דמכיון שהמדות שבאדם הם ע\"פ השכל,"
        },
        {
          "s": 64,
          "text": "לכן,"
        },
        {
          "s": 65,
          "text": "כששכלו מחייב באופן אחר,"
        },
        {
          "s": 66,
          "text": "נעשה שינוי גם בהמדות."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "וביאור הענין בפרטיות יותר,"
        },
        {
          "s": 2,
          "text": "יובן ע\"פ מ\"ש אדמו\"ר האמצעי בתורת חיים74"
        },
        {
          "s": 3,
          "text": "דבמדות יש"
        },
        {
          "s": 4,
          "text": "(בכללות)"
        },
        {
          "s": 5,
          "text": "ג' מדריגות,"
        },
        {
          "s": 6,
          "text": "עיבור יניקה ומוחין."
        },
        {
          "s": 7,
          "text": "דזהו שהמדות נק' בשם צומח"
        },
        {
          "s": 8,
          "text": "[כידוע בענין דצח\"מ שבאדם,"
        },
        {
          "s": 9,
          "text": "דבחי' החי שבאדם הוא השכל,"
        },
        {
          "s": 10,
          "text": "והמדות הם הצומח שבו75],"
        },
        {
          "s": 11,
          "text": "כי צמיחת והגדלת המדות הם באופן דשינוי מדרגא לדרגא,"
        },
        {
          "s": 12,
          "text": "עיבור ואח\"כ יניקה ואח\"כ מוחין."
        },
        {
          "s": 13,
          "text": "בחי' עיבור היא המדות כמו שהן נעלמות עדיין בהשכל,"
        },
        {
          "s": 14,
          "text": "דוגמת עובר שבבטן האם."
        },
        {
          "s": 15,
          "text": "ובחי' יניקה היא המדות כמו שהן נמשכות בלב,"
        },
        {
          "s": 16,
          "text": "שגם אז הן גדילין מהמוחין,"
        },
        {
          "s": 17,
          "text": "ואדרבא אז הוא עיקר ההגדלה שלהם."
        },
        {
          "s": 18,
          "text": "בדוגמת התינוק,"
        },
        {
          "s": 19,
          "text": "שגם לאחרי שנולד ונעשה מציאות בפ\"ע,"
        },
        {
          "s": 20,
          "text": "הוא יונק מחלב אמו שעי\"ז נגדלים אבריו"
        },
        {
          "s": 21,
          "text": "(ועד שעיקר הגדלת הולד הוא בזמן היניקה)."
        },
        {
          "s": 22,
          "text": "ובחי' מוחין היא המדות כמו שהן בגדלות"
        },
        {
          "s": 23,
          "text": "(בדוגמת הולד שלאחרי זמן היניקה),"
        },
        {
          "s": 24,
          "text": "וגם מדות אלו מקבלות מהמוחין,"
        },
        {
          "s": 25,
          "text": "מבחי' גדלות המוחין,"
        },
        {
          "s": 26,
          "text": "כמבואר בתו\"ח שם."
        },
        {
          "s": 27,
          "text": "ועפ\"ז יובן הטעם על זה דכאשר השכל מחייב באופן אחר נעשה שינוי בהמדות"
        },
        {
          "s": 28,
          "text": "(כמבואר לעיל מהמאמר דההילולא),"
        },
        {
          "s": 29,
          "text": "דמכיון שגם לאחרי שהמדות נמשכו בלב ונעשו מציאות בפ\"ע הם מקבלים מהשכל,"
        },
        {
          "s": 30,
          "text": "בדוגמת התינוק,"
        },
        {
          "s": 31,
          "text": "שגם לאחרי שנולד ויצא לאויר העולם,"
        },
        {
          "s": 32,
          "text": "הוא יונק מחלב אמו"
        },
        {
          "s": 33,
          "text": "[ולא עוד,"
        },
        {
          "s": 34,
          "text": "אלא שאפילו המדות דגדלות מקבלים מהשכל],"
        },
        {
          "s": 35,
          "text": "לכן,"
        },
        {
          "s": 36,
          "text": "כשנעשה שינוי בהשכל,"
        },
        {
          "s": 37,
          "text": "משתנים גם המדות."
        }
      ]
    }
  ]
}