{
  "globalIndex": 943,
  "owner": 43,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919340_theRebbe_24__p005",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919340_theRebbe_24__p005",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919340_theRebbe_24",
  "title": "מאמר עשרה שיושבין תשמ\"ב",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דשני הענינים בההמשכה שעל ידי עבודה"
        },
        {
          "s": 2,
          "text": "(תפלה או לימוד התורה)"
        },
        {
          "s": 3,
          "text": "דרבים,"
        },
        {
          "s": 4,
          "text": "שההמשכה היא שלא בהדרגה"
        },
        {
          "s": 5,
          "text": "(למעלה מהשתלשלות),"
        },
        {
          "s": 6,
          "text": "ושע\"י עבודתם נמשך גם ממקום שא\"א לאתעדל\"ת"
        },
        {
          "s": 7,
          "text": "(גם לאתעדל\"ת דרבים)"
        },
        {
          "s": 8,
          "text": "לעורר שם,"
        },
        {
          "s": 9,
          "text": "הוא בשתי דרגות הנ\"ל."
        },
        {
          "s": 10,
          "text": "דבהדרגא די\"ג,"
        },
        {
          "s": 11,
          "text": "שהא' נמשך בהי\"ב,"
        },
        {
          "s": 12,
          "text": "כיון שי\"ב הוא גבול,"
        },
        {
          "s": 13,
          "text": "ההמשכה משם היא ע\"י אתעדל\"ת."
        },
        {
          "s": 14,
          "text": "אלא שע\"י הא' שנמשך בהי\"ב,"
        },
        {
          "s": 15,
          "text": "ההמשכה היא שלא בהדרגה"
        },
        {
          "s": 16,
          "text": "(בדוגמת יגעתי ומצאתי)."
        },
        {
          "s": 17,
          "text": "ובהדרגא די\"ג,"
        },
        {
          "s": 18,
          "text": "שהי\"ב נכללים בהא' וכל הי\"ג הם בל\"ג,"
        },
        {
          "s": 19,
          "text": "ההמשכה משם היא דוגמת אתעדל\"ע שמצד עצמה."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ויש לקשר זה עם חג הגאולה י\"ב י\"ג תמוז,"
        },
        {
          "s": 2,
          "text": "שבי\"ב תמוז"
        },
        {
          "s": 3,
          "text": "[יום ההולדת של בעל הגאולה]"
        },
        {
          "s": 4,
          "text": "הודיעו לו שהגיעה פקודה לשחררו,"
        },
        {
          "s": 5,
          "text": "והשחרור בפועל הי' בי\"ג תמוז43."
        },
        {
          "s": 6,
          "text": "ויש לומר,"
        },
        {
          "s": 7,
          "text": "דזה שבי\"ב"
        },
        {
          "s": 8,
          "text": "(תמוז)"
        },
        {
          "s": 9,
          "text": "הודיעו לו ע\"ד השחרור,"
        },
        {
          "s": 10,
          "text": "הו\"ע י\"ב כמו שנמשך בו הא'44."
        },
        {
          "s": 11,
          "text": "וכיון שי\"ב כמו שהוא במקומו,"
        },
        {
          "s": 12,
          "text": "גם כשנמשך בו הא',"
        },
        {
          "s": 13,
          "text": "הוא גבול,"
        },
        {
          "s": 14,
          "text": "לכן בי\"ב הי' עדיין לפני הגאולה בפועל."
        },
        {
          "s": 15,
          "text": "כי ענין הגאולה הוא למעלה ממדידה והגבלה"
        },
        {
          "s": 16,
          "text": "[ובפרט להמבואר בהמכתב דבעל הגאולה"
        },
        {
          "s": 17,
          "text": "[שבא בתור הקדמה להמאמר ד\"ה עשרה שיושבין]"
        },
        {
          "s": 18,
          "text": "שלא אותו בלבד גאל הקב\"ה אלא גם את כל ישראל,"
        },
        {
          "s": 19,
          "text": "כולל גם אלו אשר בשם ישראל"
        },
        {
          "s": 20,
          "text": "(רק45)"
        },
        {
          "s": 21,
          "text": "יכונה46."
        },
        {
          "s": 22,
          "text": "ולהוסיף,"
        },
        {
          "s": 23,
          "text": "שבזה נכללים גם הדורות שלאח\"ז,"
        },
        {
          "s": 24,
          "text": "כי הגאולה די\"ב-י\"ג תמוז היא פעולה נמשכת,"
        },
        {
          "s": 25,
          "text": "שממשכת גאולה לכל ישראל שבמשך כל הדורות,"
        },
        {
          "s": 26,
          "text": "גאולה בנוגע ללימוד התורה וקיום המצוות שלהם וגם גאולה בנוגע לענינים הגשמיים שלהם,"
        },
        {
          "s": 27,
          "text": "בני חיי ומזוני,"
        },
        {
          "s": 28,
          "text": "שיהיו כולם \"רויחי\","
        },
        {
          "s": 29,
          "text": "למעלה ממדידה והגבלה."
        },
        {
          "s": 30,
          "text": "ויתירה מזו,"
        },
        {
          "s": 31,
          "text": "שהיא"
        },
        {
          "s": 32,
          "text": "(הגאולה די\"ב-יג תמוז)"
        },
        {
          "s": 33,
          "text": "גם הקדמה והכנה לגאולה האמיתית והשלימה ע\"י משיח צדקנו47,"
        },
        {
          "s": 34,
          "text": "שאז יהי' אמיתית הענין דלמעלה ממדידה והגבלה],"
        },
        {
          "s": 35,
          "text": "והגאולה בפועל היתה בי\"ג בגימטריא אחד,"
        },
        {
          "s": 36,
          "text": "שהי\"ב מתעלים בהא',"
        },
        {
          "s": 37,
          "text": "למעלה מהגבלה."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר33,"
        },
        {
          "s": 2,
          "text": "דהגם שתורה היא המשכה מלמעלה למטה מ\"מ גם בתורה צ\"ל עבודה ויגיעה,"
        },
        {
          "s": 3,
          "text": "ושני ענינים בזה."
        },
        {
          "s": 4,
          "text": "שבכדי שלימוד התורה יהי' כדבעי הוא ע\"י"
        },
        {
          "s": 5,
          "text": "[הקדמת48]"
        },
        {
          "s": 6,
          "text": "עבודת התפלה,"
        },
        {
          "s": 7,
          "text": "דכל האומר אין לי אלא תורה אפילו תורה אין לו49."
        },
        {
          "s": 8,
          "text": "ושגם לימוד התורה עצמו צ\"ל בעבודה ויגיעה."
        },
        {
          "s": 9,
          "text": "ובזה שני ענינים."
        },
        {
          "s": 10,
          "text": "היגיעה בהבנת התורה,"
        },
        {
          "s": 11,
          "text": "יגעתי ומצאתי."
        },
        {
          "s": 12,
          "text": "והיגיעה בתורה לשנות טבעו ורגילותו,"
        },
        {
          "s": 13,
          "text": "כמאמר רז\"ל50"
        },
        {
          "s": 14,
          "text": "שאינו דומה שונה פרקו מאה פעמים לשונה פרקו מאה פעמים ואחד51,"
        },
        {
          "s": 15,
          "text": "שאז דוקא נקרא עובד אלקים."
        }
      ]
    }
  ]
}