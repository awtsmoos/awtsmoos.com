{
  "globalIndex": 48,
  "owner": 48,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913974_theRebbe_325__p001",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913974_theRebbe_325__p001",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518913974_theRebbe_325",
  "title": "מאמר וכל אדם תשכ\"ג",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ האזינו,"
        },
        {
          "s": 2,
          "text": "שבת תשובה ה'תשכ\"ג"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "וכל אדם לא יהי' באוהל מועד בבואו לכפר בקודש גו'1"
        },
        {
          "s": 1,
          "text": "ואיתא בירושלמי2"
        },
        {
          "s": 2,
          "text": "אפילו אותן שכתב בהן3"
        },
        {
          "s": 3,
          "text": "ודמות פניהם פני אדם."
        },
        {
          "s": 4,
          "text": "ומבאר הצ\"צ במאמרו ד\"ה זה4,"
        },
        {
          "s": 5,
          "text": "שהגילוי שנמשך כשכהן גדול הי' נכנס לקודש הקדשים הוא גילוי שלמעלה מהשתלשלות."
        },
        {
          "s": 6,
          "text": "וכדאיתא במדרש5"
        },
        {
          "s": 7,
          "text": "עה\"פ6"
        },
        {
          "s": 8,
          "text": "בזאת יבוא אהרן,"
        },
        {
          "s": 9,
          "text": "באיזה זכות הי' אהרן נכנס לבית קדשי הקדשים כו' זכות המילה היתה נכנסת עמו,"
        },
        {
          "s": 10,
          "text": "ומילה ניתנה בשמיני,"
        },
        {
          "s": 11,
          "text": "דשמיני הוא למעלה מהשתלשלות."
        },
        {
          "s": 12,
          "text": "וכדאיתא במדרש7"
        },
        {
          "s": 13,
          "text": "עה\"פ8"
        },
        {
          "s": 14,
          "text": "סוד הוי' ליראיו איזהו סוד הוי' זו מילה."
        },
        {
          "s": 15,
          "text": "שהגילויים דהשתלשלות הם מבחי' גליא דקוב\"ה,"
        },
        {
          "s": 16,
          "text": "והגילוי שנמשך ע\"י מילה הוא מבחי' סתים דקוב\"ה,"
        },
        {
          "s": 17,
          "text": "ולכן נק' סוד הוי',"
        },
        {
          "s": 18,
          "text": "דסוד הוא מה שהוא סתום ונעלם."
        },
        {
          "s": 19,
          "text": "ובשעה שהכה\"ג הי' נכנס לקודש הקדשים נמשך הגילוי דסוד הוי'."
        },
        {
          "s": 20,
          "text": "ולכן לא היו שם אפילו אותן שכתב בהן ודמות פניהם פני אדם,"
        },
        {
          "s": 21,
          "text": "כי לגבי גילוי זה אין מקום לנבראים,"
        },
        {
          "s": 22,
          "text": "אפילו לא להמלאכים שדמות פניהם פני אדם."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "וצריך להבין,"
        },
        {
          "s": 1,
          "text": "דמזה שבכדי שהכהן גדול יוכל ליכנס לקודש הקדשים הוא ע\"י זכות המילה שניתנה בשמיני,"
        },
        {
          "s": 2,
          "text": "מוכח,"
        },
        {
          "s": 3,
          "text": "שהגילוי דלמעלה מהשתלשלות שהי' בקדה\"ק הוא מצד מעלת קדה\"ק עצמו"
        },
        {
          "s": 4,
          "text": "(ולא שע\"י כניסתו של הכהן גדול לקדה\"ק נמשך הגילוי),"
        },
        {
          "s": 5,
          "text": "ואעפ\"כ,"
        },
        {
          "s": 6,
          "text": "זה שוכל אדם לא יהי' גו' אפילו אותן שכתב בהן ודמות פניהם פני אדם הוא דוקא בבואו של הכהן גדול לקדה\"ק לכפר בקודש."
        },
        {
          "s": 7,
          "text": "דמזה מובן,"
        },
        {
          "s": 8,
          "text": "שהגילוי שנמשך ע\"י העבודה דכהן גדול בקדה\"ק הוא נעלה יותר מהגילוי שהי' בקדה\"ק מצד עצמו."
        }
      ]
    }
  ]
}