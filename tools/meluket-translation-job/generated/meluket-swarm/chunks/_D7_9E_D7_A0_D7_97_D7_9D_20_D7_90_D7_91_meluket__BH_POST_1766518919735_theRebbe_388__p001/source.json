{
  "globalIndex": 1001,
  "owner": 1,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919735_theRebbe_388__p001",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919735_theRebbe_388__p001",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919735_theRebbe_388",
  "title": "מאמר ציון במשפט תפדה תשמ\"א",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ דברים,"
        },
        {
          "s": 2,
          "text": "שבת חזון,"
        },
        {
          "s": 3,
          "text": "ערב תשעה באב ה'תשמ\"א*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "ציון במשפט תפדה ושבי' בצדקה1,"
        },
        {
          "s": 1,
          "text": "ומדייק אדמו\"ר"
        },
        {
          "s": 2,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 3,
          "text": "נ\"ע במאמרו ד\"ה זה דשנת עדר\"ת2,"
        },
        {
          "s": 4,
          "text": "הרי הכוונה בציון כאן היא לא על עיר ציון3"
        },
        {
          "s": 5,
          "text": "[בפרט4]"
        },
        {
          "s": 6,
          "text": "אלא על"
        },
        {
          "s": 7,
          "text": "[כללות4]"
        },
        {
          "s": 8,
          "text": "ישראל,"
        },
        {
          "s": 9,
          "text": "ולמה אומר ציון."
        },
        {
          "s": 10,
          "text": "וגם מדייק מ\"ש ושבי' גו',"
        },
        {
          "s": 11,
          "text": "מי הם שבי'."
        },
        {
          "s": 12,
          "text": "[ויש לומר,"
        },
        {
          "s": 13,
          "text": "שגם דיוק זה"
        },
        {
          "s": 14,
          "text": "(מי הם שבי')"
        },
        {
          "s": 15,
          "text": "הוא ע\"פ מה שאומר לפנ\"ז שהכוונה בציון כאן היא על כללות ישראל."
        },
        {
          "s": 16,
          "text": "דיש מפרשים5"
        },
        {
          "s": 17,
          "text": "שציון קאי על עיר ציון ושבי' קאי על ישראל."
        },
        {
          "s": 18,
          "text": "אבל להפירוש"
        },
        {
          "s": 19,
          "text": "(שבהמאמר)"
        },
        {
          "s": 20,
          "text": "שציון קאי על ישראל,"
        },
        {
          "s": 21,
          "text": "מה הם שני הסוגים דציון ושבי']."
        },
        {
          "s": 22,
          "text": "וגם מהו\"ע שפדיית ציון תהי' במשפט והפדי' של שבי' בצדקה."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ונקודת הביאור"
        },
        {
          "s": 2,
          "text": "(ע\"פ המבואר ברשימות הצ\"צ עה\"פ6"
        },
        {
          "s": 3,
          "text": "ובמאמר הנ\"ל7),"
        },
        {
          "s": 4,
          "text": "דציון קאי על ישראל העוסקים בתורה ומצוות,"
        },
        {
          "s": 5,
          "text": "ונק' בשם ציון לפי שהם מצויינים בתומ\"צ."
        },
        {
          "s": 6,
          "text": "[וכדאיתא בירושלמי8"
        },
        {
          "s": 7,
          "text": "עה\"פ9"
        },
        {
          "s": 8,
          "text": "ואשים דברי בפיך ובצל ידי כסיתיך לנטוע שמים וליסוד ארץ ולאמר לציון עמי אתה,"
        },
        {
          "s": 9,
          "text": "חזרנו על כל המקרא ולא מצאנו שנקראו ישראל ציון אלא זה"
        },
        {
          "s": 10,
          "text": "(שנאמר)"
        },
        {
          "s": 11,
          "text": "ולאמר לציון עמי אתה."
        },
        {
          "s": 12,
          "text": "וידוע הביאור בזה10,"
        },
        {
          "s": 13,
          "text": "דבפסוק זה מדבר בג' הדברים שעליהם העולם עומד,"
        },
        {
          "s": 14,
          "text": "תורה עבודה וגמ\"ח11."
        },
        {
          "s": 15,
          "text": "ואשים דברי בפיך זו תורה,"
        },
        {
          "s": 16,
          "text": "ובצל ידי כסיתיך זו גמ\"ח,"
        },
        {
          "s": 17,
          "text": "לנטוע שמים וליסוד ארץ אלו הקרבנות"
        },
        {
          "s": 18,
          "text": "(כדאיתא בירושלמי שם)."
        },
        {
          "s": 19,
          "text": "וזהו לא מצאנו שנקראו ישראל ציון אלא זה,"
        },
        {
          "s": 20,
          "text": "כי זה שישראל נק' בשם ציון הוא ע\"י שעוסקים בתורה עבודה וגמ\"ח,"
        },
        {
          "s": 21,
          "text": "שהם כללות כל התומ\"צ]."
        },
        {
          "s": 22,
          "text": "ושבי' הם אלו שאינם עוסקים בתורה12,"
        },
        {
          "s": 23,
          "text": "שהם בשבי' ממש"
        },
        {
          "s": 24,
          "text": "[ושבי' מלשון שבי'13]"
        },
        {
          "s": 25,
          "text": "בהגוף ונה\"ב."
        },
        {
          "s": 26,
          "text": "וזהו ציון במשפט תפדה ושבי' בצדקה,"
        },
        {
          "s": 27,
          "text": "שהפדי' של העוסקים בתורה היא במשפט,"
        },
        {
          "s": 28,
          "text": "ע\"פ שורת הדין,"
        },
        {
          "s": 29,
          "text": "משא\"כ הפדי' של שבי' היא בתורת צדקה."
        },
        {
          "s": 30,
          "text": "והגם שגם פדייתם של אלו שהם בשבי' בהגוף ונה\"ב תהי' ע\"י התשובה,"
        },
        {
          "s": 31,
          "text": "דאין ישראל נגאלין אלא בתשובה14"
        },
        {
          "s": 32,
          "text": "והבטיחה תורה שסוף ישראל לעשות תשובה בסוף גלותן ו"
        },
        {
          "s": 33,
          "text": "(עי\"ז)"
        },
        {
          "s": 34,
          "text": "מיד הן נגאלין15"
        },
        {
          "s": 35,
          "text": "[ויש לומר,"
        },
        {
          "s": 36,
          "text": "דזהו הקשר של הפירוש ושבי' מלשון שבי' עם הפירוש דושבי' הוא עושי תשובה"
        },
        {
          "s": 37,
          "text": "(ושבי' מלשון תשובה16),"
        },
        {
          "s": 38,
          "text": "כי פדיית שבי' מלשון שבי' הוא ע\"י שיעשו תשובה],"
        },
        {
          "s": 39,
          "text": "הרי זה שתשובה מכפרת אינו ע\"פ משפט,"
        },
        {
          "s": 40,
          "text": "אלא חסד וצדקה דהקב\"ה17."
        },
        {
          "s": 41,
          "text": "אלא שאעפ\"כ,"
        },
        {
          "s": 42,
          "text": "הפדי' דשבי' היא למעלה מהפדי' דציון,"
        },
        {
          "s": 43,
          "text": "כי ענין המשפט הוא מדידה והגבלה,"
        },
        {
          "s": 44,
          "text": "משא\"כ צדקה היא למעלה מהגבלה."
        },
        {
          "s": 45,
          "text": "וכמבואר בהמאמר7,"
        },
        {
          "s": 46,
          "text": "שמשפט הוא האור שבגדר הכלים,"
        },
        {
          "s": 47,
          "text": "וצדקה הוא האור שבהבדלה שבא רק באופן של צדקה."
        },
        {
          "s": 48,
          "text": "ולכן,"
        },
        {
          "s": 49,
          "text": "האור שנמשך לצדיקים שפדייתם היא במשפט,"
        },
        {
          "s": 50,
          "text": "הוא האור שבגדר הכלים."
        },
        {
          "s": 51,
          "text": "[והיינו דזה מה שפדייתם היא במשפט,"
        },
        {
          "s": 52,
          "text": "יש בזה שני ענינים."
        },
        {
          "s": 53,
          "text": "א',"
        },
        {
          "s": 54,
          "text": "שאין זקוקים לצדקה,"
        },
        {
          "s": 55,
          "text": "כיון שמגיע להם ע\"פ דין."
        },
        {
          "s": 56,
          "text": "ב',"
        },
        {
          "s": 57,
          "text": "שענין המשפט שולל צדקה,"
        },
        {
          "s": 58,
          "text": "כמ\"ש18"
        },
        {
          "s": 59,
          "text": "לא תכירו פנים במשפט,"
        },
        {
          "s": 60,
          "text": "ופירש\"י19"
        },
        {
          "s": 61,
          "text": "שלא תאמר זה עני הוא כו' ומצוה לפרנסו]."
        },
        {
          "s": 62,
          "text": "והאור שנמשך לבע\"ת שפדייתם היא בצדקה,"
        },
        {
          "s": 63,
          "text": "הוא האור שבהבדלה."
        }
      ]
    }
  ]
}