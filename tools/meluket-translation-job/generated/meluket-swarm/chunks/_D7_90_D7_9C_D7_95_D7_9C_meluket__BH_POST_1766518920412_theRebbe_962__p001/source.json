{
  "globalIndex": 1106,
  "owner": 6,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920412_theRebbe_962__p001",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920412_theRebbe_962__p001",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920412_theRebbe_962",
  "title": "מאמר קומי אורי תשל\"ג",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "קומי אורי כי בא אורך גו'1,"
        },
        {
          "s": 1,
          "text": "הנה,"
        },
        {
          "s": 2,
          "text": "כי בא אורך הוא טעם על קומי אורי."
        },
        {
          "s": 3,
          "text": "שהקב\"ה אומר לישראל2,"
        },
        {
          "s": 4,
          "text": "דכיון שכבר בא אורך,"
        },
        {
          "s": 5,
          "text": "האור שלך"
        },
        {
          "s": 6,
          "text": "(של ישראל),"
        },
        {
          "s": 7,
          "text": "לכן צריכה את לקום ולהאיר."
        },
        {
          "s": 8,
          "text": "וצריך להבין מהו ענינם של שני אורות אלה,"
        },
        {
          "s": 9,
          "text": "האור של ישראל עצמם והאור שצריכים להאיר."
        },
        {
          "s": 10,
          "text": "ויובן זה ע\"פ מה דאיתא בילקוט3,"
        },
        {
          "s": 11,
          "text": "אמרו ישראל לפני הקב\"ה,"
        },
        {
          "s": 12,
          "text": "עשינו לך מנורה בימי משה וכבתה,"
        },
        {
          "s": 13,
          "text": "בימי שלמה וכבתה,"
        },
        {
          "s": 14,
          "text": "מכאן ואילך אין אנו ממתינין אלא לאורך,"
        },
        {
          "s": 15,
          "text": "שנאמר4"
        },
        {
          "s": 16,
          "text": "כי עמך מקור חיים באורך נראה אור,"
        },
        {
          "s": 17,
          "text": "וכך אמר הקב\"ה קומי אורי כי בא אורך."
        },
        {
          "s": 18,
          "text": "ומזה שמדמין קומי אורי כי בא אורך לבאורך נראה אור,"
        },
        {
          "s": 19,
          "text": "מובן,"
        },
        {
          "s": 20,
          "text": "ששני הענינים שבפסוק קומי אורי כי בא אורך הם דוגמת שני הענינים שבפסוק באורך נראה אור."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים מה שמבאר כ\"ק מו\"ח אדמו\"ר במאמרו ד\"ה כי עמך מקור חיים באורך נראה אור5,"
        },
        {
          "s": 2,
          "text": "שבפסוק זה יש ד' ענינים."
        },
        {
          "s": 3,
          "text": "חיים,"
        },
        {
          "s": 4,
          "text": "מקור חיים,"
        },
        {
          "s": 5,
          "text": "אורך ואור."
        },
        {
          "s": 6,
          "text": "וד' ענינים אלו הם בסדר מלמטה למעלה."
        },
        {
          "s": 7,
          "text": "חיים הוא החיות אלקי שמתלבש בעולמות,"
        },
        {
          "s": 8,
          "text": "ממלא כל עלמין."
        },
        {
          "s": 9,
          "text": "[ויש להוסיף ביאור,"
        },
        {
          "s": 10,
          "text": "דזה שנק' בשם חיים לשון רבים הוא,"
        },
        {
          "s": 11,
          "text": "כי החיות המתלבש בעולמות ונבראים הוא בריבוי התחלקות,"
        },
        {
          "s": 12,
          "text": "בכל נברא לפי ענינו]."
        },
        {
          "s": 13,
          "text": "מקור חיים הוא אור הסובב כל עלמין."
        },
        {
          "s": 14,
          "text": "אורך הוא תורה,"
        },
        {
          "s": 15,
          "text": "תורה אור6,"
        },
        {
          "s": 16,
          "text": "שלמעלה גם מסובב."
        },
        {
          "s": 17,
          "text": "והאור שנראה ע\"י אורך הוא למעלה גם מאורך,"
        },
        {
          "s": 18,
          "text": "ועד שאורך אינו אלא הכנה להאור שנראה על ידו."
        }
      ]
    }
  ]
}