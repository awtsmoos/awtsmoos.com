{
  "globalIndex": 205,
  "owner": 5,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914993_theRebbe_833__p001",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914993_theRebbe_833__p001",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518914993_theRebbe_833",
  "title": "מאמר ויהיו חיי שרה תנש\"א",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ חיי שרה,"
        },
        {
          "s": 2,
          "text": "כ\"ב מרחשון ה'תנש\"א"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "ויהיו חיי שרה מאה שנה ועשרים שנה ושבע שנים שני חיי שרה1,"
        },
        {
          "s": 1,
          "text": "וידועים הדיוקים בדרושי רבותינו נשיאינו"
        },
        {
          "s": 2,
          "text": "[החל מדרושי רבינו הזקן2,"
        },
        {
          "s": 3,
          "text": "ובתוספת הגהות וביאורים בדרושי רבותינו נשיאינו שלאח\"ז3,"
        },
        {
          "s": 4,
          "text": "וגם בדרושי אדמו\"ר"
        },
        {
          "s": 5,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 6,
          "text": "נ\"ע4,"
        },
        {
          "s": 7,
          "text": "בעל יום ההולדת דכ\"ף מרחשון5],"
        },
        {
          "s": 8,
          "text": "שבמספר מאה ובמספר עשרים נקט שנה"
        },
        {
          "s": 9,
          "text": "(מאה שנה ועשרים שנה)"
        },
        {
          "s": 10,
          "text": "לשון יחיד,"
        },
        {
          "s": 11,
          "text": "ובמספר שבע נקט שנים"
        },
        {
          "s": 12,
          "text": "(שבע שנים)"
        },
        {
          "s": 13,
          "text": "לשון רבים."
        },
        {
          "s": 14,
          "text": "גם,"
        },
        {
          "s": 15,
          "text": "מהו אומרו שני חיי שרה,"
        },
        {
          "s": 16,
          "text": "הרי כבר נאמר ויהיו חיי שרה"
        },
        {
          "s": 17,
          "text": "(ומפרט המספר דקכ\"ז שנה),"
        },
        {
          "s": 18,
          "text": "ולמה כופל שני חיי שרה."
        },
        {
          "s": 19,
          "text": "גם צריך להבין הלימוד וההוראה משני חיי שרה בעבודת כאו\"א מישראל,"
        },
        {
          "s": 20,
          "text": "כידוע שכל עניני התורה"
        },
        {
          "s": 21,
          "text": "(גם סיפורי התורה6)"
        },
        {
          "s": 22,
          "text": "הם הוראות לכאו\"א מישראל,"
        },
        {
          "s": 23,
          "text": "ובפרט מעשה אבות"
        },
        {
          "s": 24,
          "text": "(ואמהות)"
        },
        {
          "s": 25,
          "text": "שהם סימן"
        },
        {
          "s": 26,
          "text": "(ונתינת-כח)"
        },
        {
          "s": 27,
          "text": "לבנים7."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ומבואר בהדרושים,"
        },
        {
          "s": 2,
          "text": "שבפסוק זה נכלל כל סדר ההשתלשלות"
        },
        {
          "s": 3,
          "text": "(למעלה וגם)"
        },
        {
          "s": 4,
          "text": "בנפש האדם,"
        },
        {
          "s": 5,
          "text": "בכאו\"א מישראל,"
        },
        {
          "s": 6,
          "text": "שעבודתו צריכה להיות בכל פרטי הענינים דמאה שנה ועשרים שנה ושבע שנים,"
        },
        {
          "s": 7,
          "text": "כמו בשרה8."
        },
        {
          "s": 8,
          "text": "וביאור הענין,"
        },
        {
          "s": 9,
          "text": "דאיתא בזהר9"
        },
        {
          "s": 10,
          "text": "ויהיו חיי שרה כו' מאה שנה כללא דכולא קוב\"ה דאתכליל מאתר עילאה סתימא דכל סתימין במאה ברזא דמאה ברכאן בכל יומא,"
        },
        {
          "s": 11,
          "text": "וכן עשרים שנה,"
        },
        {
          "s": 12,
          "text": "ובגין כך כתיב שנה רזא דיחודא דלא אתפרש מחשבה ויובלא לעלמין,"
        },
        {
          "s": 13,
          "text": "שבע שנים אלין אתפרשן ונפקאן מכללא כו' בדינא ורחמי בכמה סטרין ואורחין כו' ובגין כך כו' כתיב בהו שנים ולא שנה,"
        },
        {
          "s": 14,
          "text": "וכולהו אקרון חיים כו'."
        },
        {
          "s": 15,
          "text": "והענין בזה,"
        },
        {
          "s": 16,
          "text": "שמאה שנה קאי על הכתר"
        },
        {
          "s": 17,
          "text": "(כי כתר כולל כל היו\"ד ספירות,"
        },
        {
          "s": 18,
          "text": "וכל א' מהם כלול מיו\"ד,"
        },
        {
          "s": 19,
          "text": "ויו\"ד פעמים יו\"ד הם מאה),"
        },
        {
          "s": 20,
          "text": "שענינו בנפש האדם הוא רצון"
        },
        {
          "s": 21,
          "text": "(חיצוניות הכתר)"
        },
        {
          "s": 22,
          "text": "ותענוג"
        },
        {
          "s": 23,
          "text": "(פנימיות הכתר)."
        },
        {
          "s": 24,
          "text": "ועשרים שנה קאי על חכמה ובינה"
        },
        {
          "s": 25,
          "text": "(שכל א' מהם כלול מיו\"ד),"
        },
        {
          "s": 26,
          "text": "בחי' המוחין"
        },
        {
          "s": 27,
          "text": "[ובכמה דרושים10"
        },
        {
          "s": 28,
          "text": "מבואר שגם מאה שנה הוא בחי' המוחין"
        },
        {
          "s": 29,
          "text": "(כידוע שיחידות במלכות,"
        },
        {
          "s": 30,
          "text": "עשיריות בז\"א,"
        },
        {
          "s": 31,
          "text": "ומאות באו\"א"
        },
        {
          "s": 32,
          "text": "(חו\"ב),"
        },
        {
          "s": 33,
          "text": "ואלפים בכתר),"
        },
        {
          "s": 34,
          "text": "ועפ\"ז י\"ל,"
        },
        {
          "s": 35,
          "text": "שמאה שנה הוא מוחין בעצם,"
        },
        {
          "s": 36,
          "text": "ועשרים שנה הוא מוחין השייכים להמדות"
        },
        {
          "s": 37,
          "text": "(עשיריות בז\"א)]."
        },
        {
          "s": 38,
          "text": "ובשניהם נאמר שנה"
        },
        {
          "s": 39,
          "text": "(מאה שנה ועשרים שנה)"
        },
        {
          "s": 40,
          "text": "לשון יחיד,"
        },
        {
          "s": 41,
          "text": "כי,"
        },
        {
          "s": 42,
          "text": "בכתר"
        },
        {
          "s": 43,
          "text": "(מאה)"
        },
        {
          "s": 44,
          "text": "כלולים כל הספירות יחד,"
        },
        {
          "s": 45,
          "text": "וגם חכמה ובינה"
        },
        {
          "s": 46,
          "text": "(עשרים)"
        },
        {
          "s": 47,
          "text": "הם תרין ריעין דלא מתפרשין11,"
        },
        {
          "s": 48,
          "text": "ולכן נכללים יחד."
        },
        {
          "s": 49,
          "text": "ושבע שנים קאי על שבע המדות,"
        },
        {
          "s": 50,
          "text": "ולהיותם באופן של התחלקות עד לקוין הפכיים דחסד וגבורה"
        },
        {
          "s": 51,
          "text": "(דינא ורחמי),"
        },
        {
          "s": 52,
          "text": "נאמר בהם שבע שנים,"
        },
        {
          "s": 53,
          "text": "לשון רבים."
        },
        {
          "s": 54,
          "text": "ומוסיף ומסיים שני חיי שרה,"
        },
        {
          "s": 55,
          "text": "שע\"י שלימות העבודה דמאה שנה ועשרים שנה ושבע שנים באים לדרגא נעלית יותר שלמעלה מהתחלקות,"
        },
        {
          "s": 56,
          "text": "שלכן לא נזכר בזה מספר"
        },
        {
          "s": 57,
          "text": "(ע\"ד לפני אחד מה אתה סופר12)."
        }
      ]
    }
  ]
}