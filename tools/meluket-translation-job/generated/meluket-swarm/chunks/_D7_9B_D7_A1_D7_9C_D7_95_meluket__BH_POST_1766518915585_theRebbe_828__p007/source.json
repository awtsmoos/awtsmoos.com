{
  "globalIndex": 320,
  "owner": 20,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915585_theRebbe_828__p007",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915585_theRebbe_828__p007",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915585_theRebbe_828",
  "title": "מאמר פתח אליהו תשט\"ו",
  "part": 7,
  "sections": [
    {
      "v": 18,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "וע\"פ המבואר לעיל"
        },
        {
          "s": 2,
          "text": "(סעיף ז)"
        },
        {
          "s": 3,
          "text": "שצורת הנבראים"
        },
        {
          "s": 4,
          "text": "(צורת החומר)"
        },
        {
          "s": 5,
          "text": "היא כלי להחיות האלקי שבהם"
        },
        {
          "s": 6,
          "text": "(הנפש שלהם),"
        },
        {
          "s": 7,
          "text": "יש לומר,"
        },
        {
          "s": 8,
          "text": "דהחיות והנפש של הנבראים הם הרצון."
        },
        {
          "s": 9,
          "text": "ומזה מובן,"
        },
        {
          "s": 10,
          "text": "דזה שהחיות האלקי מתלבש בכל נברא ומחי' אותו כפי ענינו,"
        },
        {
          "s": 11,
          "text": "שזה מורה שהנבראים תופסים מקום לגבי'"
        },
        {
          "s": 12,
          "text": "(כנ\"ל סעיף ג),"
        },
        {
          "s": 13,
          "text": "הוא"
        },
        {
          "s": 14,
          "text": "[לא מפני שהנבראים מצד עצמם תופסים מקום לגבי',"
        },
        {
          "s": 15,
          "text": "שהרי ענין ההתהוות שמהרצון הוא שעל ידם נשלם הרצון"
        },
        {
          "s": 16,
          "text": "(כנ\"ל סעיף ח),"
        },
        {
          "s": 17,
          "text": "אלא]"
        },
        {
          "s": 18,
          "text": "מפני שכך עלה ברצונו ית' שיהי' תפיסת מקום להנבראים,"
        },
        {
          "s": 19,
          "text": "ולכן הוא מתלבש בהנבראים ומחי' כל נברא כפי ענינו."
        }
      ]
    },
    {
      "v": 19,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז,"
        },
        {
          "s": 1,
          "text": "החילוק בין הנהגה טבעית להנהגה נסית,"
        },
        {
          "s": 2,
          "text": "דהנהגה טבעית היא בדעת תחתון והנהגה נסית בדעת עליון"
        },
        {
          "s": 3,
          "text": "(כמובא לעיל מהדרושים),"
        },
        {
          "s": 4,
          "text": "הוא,"
        },
        {
          "s": 5,
          "text": "דהרצון בהנהגה טבעית הוא להנהיג את העולם באופן שהעולם הוא מציאות,"
        },
        {
          "s": 6,
          "text": "למטה יש,"
        },
        {
          "s": 7,
          "text": "והרצון בהנהגה נסית הוא להנהיג את העולם באופן שהעולם הוא כלא חשיב,"
        },
        {
          "s": 8,
          "text": "למטה אין."
        }
      ]
    },
    {
      "v": 20,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "ויש לומר,"
        },
        {
          "s": 3,
          "text": "שעד\"ז הוא בכללות הענין דדעת תחתון,"
        },
        {
          "s": 4,
          "text": "שיש בו שני אופנים."
        },
        {
          "s": 5,
          "text": "שהדיעה שלמטה יש הוא לפי שלגבי דרגא זו המטה מצד עצמו הוא מציאות"
        },
        {
          "s": 6,
          "text": "(והביטול שלו הוא רק ביטול היש)."
        },
        {
          "s": 7,
          "text": "ושהדיעה שלמטה יש הוא בכדי שיהי' גילוי הענין דלמעלה מעלה עד אין קץ."
        },
        {
          "s": 8,
          "text": "ומהחילוקים בין שני האופנים הוא,"
        },
        {
          "s": 9,
          "text": "דבאופן הא' שהמטה מצד עצמו הוא מציאות,"
        },
        {
          "s": 10,
          "text": "דעת תחתון ודעת עליון הם שתי דיעות הפכיים בעצם מהותם."
        },
        {
          "s": 11,
          "text": "דדעת תחתון הוא שהמטה הוא יש ודעת עליון הוא שהמטה הוא אין."
        },
        {
          "s": 12,
          "text": "ובאופן הב' שהדיעה שלמטה יש הוא בכדי שיהי' גילוי הענין דלמעלה מעלה עד אין קץ,"
        },
        {
          "s": 13,
          "text": "ההפכיות דשתי הדיעות הוא רק בהציור שלהם,"
        },
        {
          "s": 14,
          "text": "אבל בעצם מהותם הם ענין אחד."
        },
        {
          "s": 15,
          "text": "דענינם של שתי הדיעות הוא גילוי הענינים שבאוא\"ס,"
        },
        {
          "s": 16,
          "text": "אלא שדעת עליון הוא הגילוי דלמטה עד אין תכלית,"
        },
        {
          "s": 17,
          "text": "ודעת תחתון הוא הגילוי דלמעלה עד אין קץ."
        }
      ]
    }
  ]
}