{
  "globalIndex": 461,
  "owner": 11,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916418_theRebbe_902__p002",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916418_theRebbe_902__p002",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916418_theRebbe_902",
  "title": "מאמר לה\"ע כתיבת ספר תורה תש\"ל",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "להבין ענין כתיבת ספר תורה,"
        },
        {
          "s": 1,
          "text": "כמ\"ש ברמב\"ם1"
        },
        {
          "s": 2,
          "text": "שמצות עשה על כל איש ואיש2"
        },
        {
          "s": 3,
          "text": "מישראל לכתוב ספר תורה לעצמו3"
        },
        {
          "s": 4,
          "text": "שנאמר4"
        },
        {
          "s": 5,
          "text": "ועתה כתבו לכם את השירה5,"
        },
        {
          "s": 6,
          "text": "והמלך מצוה עליו לכתוב ספר תורה אחד לעצמו לשם המלך יתר על ספר שיהי' לו כשהוא הדיוט שנאמר6"
        },
        {
          "s": 7,
          "text": "והי' כשבתו על כסא ממלכתו וכתב לו את משנה התורה הזאת וגו' והיתה עמו וקרא בו כל ימי חייו גו'7."
        },
        {
          "s": 8,
          "text": "והראשון שכתב ספר תורה הי' זה משה רבינו,"
        },
        {
          "s": 9,
          "text": "שהוא הרעיא מהימנא של כל ישראל8,"
        },
        {
          "s": 10,
          "text": "ואתפשטותא דמשה בכל דרא ודרא9,"
        },
        {
          "s": 11,
          "text": "וסיים אותה בערב שבת קודש,"
        },
        {
          "s": 12,
          "text": "כמבואר בכ\"מ10"
        },
        {
          "s": 13,
          "text": "– הנה כותב בזה כ\"ק אדמו\"ר הצ\"צ11,"
        },
        {
          "s": 14,
          "text": "שענין כתיבת ספר תורה יובן ע\"פ מה שמבאר כ\"ק אדמו\"ר הזקן בענין ויכתוב משה,"
        },
        {
          "s": 15,
          "text": "וכדלקמן."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה כתיב12"
        },
        {
          "s": 2,
          "text": "אלה מסעי בני ישראל אשר יצאו מארץ מצרים,"
        },
        {
          "s": 3,
          "text": "ומדייק בזה כ\"ק אדמו\"ר הזקן בדרושי אלה מסעי13,"
        },
        {
          "s": 4,
          "text": "שצלה\"ב לשון אלה מסעי שהוא לשון רבים,"
        },
        {
          "s": 5,
          "text": "ומסיים אשר יצאו מארץ מצרים,"
        },
        {
          "s": 6,
          "text": "והרי מארץ מצרים הוא רק יציאה ונסיעה ראשונה"
        },
        {
          "s": 7,
          "text": "(שנסעו מרעמסס לסוכות)."
        },
        {
          "s": 8,
          "text": "ומבאר בזה14,"
        },
        {
          "s": 9,
          "text": "שכל המ\"ב מסעות עד חנייתם מעבר לירדן יריחו,"
        },
        {
          "s": 10,
          "text": "בארץ הקודש תבנה ותכונן במהרה בימינו ע\"י משיח צדקנו,"
        },
        {
          "s": 11,
          "text": "הכל נקרא אשר יצאו מארץ מצרים."
        },
        {
          "s": 12,
          "text": "וע\"ז אומר15"
        },
        {
          "s": 13,
          "text": "ויכתוב משה את מוצאיהם למסעיהם גו' ואלה מסעיהם למוצאיהם."
        },
        {
          "s": 14,
          "text": "ומדייק בזה כ\"ק אדמו\"ר הזקן16,"
        },
        {
          "s": 15,
          "text": "דצריך להבין למה גבי ויכתוב משה הקדים מוצאיהם למסעיהם"
        },
        {
          "s": 16,
          "text": "(ויכתוב משה את מוצאיהם למסעיהם)"
        },
        {
          "s": 17,
          "text": "ואח\"כ הפך הסדר ואמר ואלה מסעיהם למוצאיהם."
        },
        {
          "s": 18,
          "text": "ומבאר,"
        },
        {
          "s": 19,
          "text": "ע\"פ הידוע דתכלית כוונת ירידת הנשמה בגוף,"
        },
        {
          "s": 20,
          "text": "שהנשמה ירדה מאיגרא רמה לבירא עמיקתא17,"
        },
        {
          "s": 21,
          "text": "שהו\"ע מצרים דעולם,"
        },
        {
          "s": 22,
          "text": "או עכ\"פ מצרים דקדושה18,"
        },
        {
          "s": 23,
          "text": "הוא צורך עלי'."
        },
        {
          "s": 24,
          "text": "והעלי' היא לדרגא שלמעלה מהמקום שממנו ירדה,"
        },
        {
          "s": 25,
          "text": "כמבואר בכ\"מ19,"
        },
        {
          "s": 26,
          "text": "שדוקא בזה מובן למה היתה הירידה,"
        },
        {
          "s": 27,
          "text": "כי ע\"י הירידה היא מגעת לדרגא שלמעלה ממקום ירידתה."
        },
        {
          "s": 28,
          "text": "וזהו ואלה מסעיהם למוצאיהם,"
        },
        {
          "s": 29,
          "text": "העלי' מלמטה למעלה,"
        },
        {
          "s": 30,
          "text": "לבחינת מוצאיהם20."
        },
        {
          "s": 31,
          "text": "וההקדמה והנתינת כח ע\"ז הוא ויכתוב משה את מוצאיהם למסעיהם,"
        },
        {
          "s": 32,
          "text": "היינו21"
        },
        {
          "s": 33,
          "text": "שמשה"
        },
        {
          "s": 34,
          "text": "[הרעיא מהימנא,"
        },
        {
          "s": 35,
          "text": "הרועה נאמן של כל ישראל בכל הדורות]"
        },
        {
          "s": 36,
          "text": "כתב"
        },
        {
          "s": 37,
          "text": "(וכתיבה ענינה המשכה22)"
        },
        {
          "s": 38,
          "text": "והמשיך מבחינת מוצאיהם,"
        },
        {
          "s": 39,
          "text": "מקור נשמות ישראל,"
        },
        {
          "s": 40,
          "text": "למסעיהם,"
        },
        {
          "s": 41,
          "text": "בחינת הנשמה המלובשת בגוף."
        },
        {
          "s": 42,
          "text": "ואומר בזה מוצאיהם"
        },
        {
          "s": 43,
          "text": "(ולא – יציאתם וכיו\"ב),"
        },
        {
          "s": 44,
          "text": "שענינו הוא כמו מוצא23,"
        },
        {
          "s": 45,
          "text": "שהענין שנמשך ממנו הוא כאילו בדרך ממילא."
        },
        {
          "s": 46,
          "text": "כי מוצאיהם היא דרגא כזו שאין שייך לומר עלי' שממנה נשפע איזה ענין ונעשה בה שינוי,"
        },
        {
          "s": 47,
          "text": "כ\"א מוצא,"
        },
        {
          "s": 48,
          "text": "בדרך ממילא24."
        },
        {
          "s": 49,
          "text": "ומ\"מ,"
        },
        {
          "s": 50,
          "text": "משם דוקא נמשך הענין למטה,"
        },
        {
          "s": 51,
          "text": "כמ\"ש25"
        },
        {
          "s": 52,
          "text": "ויפח באפיו נשמת חיים,"
        },
        {
          "s": 53,
          "text": "ומאן דנפח מתוכי' נפח מתוכיותו ומפנימיותו26."
        },
        {
          "s": 54,
          "text": "ויתירה מזו,"
        },
        {
          "s": 55,
          "text": "דבענין ויכתוב"
        },
        {
          "s": 56,
          "text": "(משה)"
        },
        {
          "s": 57,
          "text": "נכלל גם ענין החתימה,"
        },
        {
          "s": 58,
          "text": "כדאיתא בגמרא27"
        },
        {
          "s": 59,
          "text": "בפירוש וכתב לה ספר גו'28,"
        },
        {
          "s": 60,
          "text": "שלדעת ר' מאיר"
        },
        {
          "s": 61,
          "text": "[שנקרא כן ע\"ש שהוא מאיר עיני חכמים בהלכה29]"
        },
        {
          "s": 62,
          "text": "וכתב פירושו וחתם30."
        },
        {
          "s": 63,
          "text": "היינו,"
        },
        {
          "s": 64,
          "text": "שמשה פעל ענין הכתיבה והחתימה דבחינת מוצאיהם למסעיהם."
        },
        {
          "s": 65,
          "text": "ועי\"ז הי' אפשר להיות אח\"כ והי' בפועל ואלה מסעיהם למוצאיהם,"
        },
        {
          "s": 66,
          "text": "העלי' מלמטה למעלה,"
        },
        {
          "s": 67,
          "text": "כנ\"ל."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "וביאור הענין הוא"
        },
        {
          "s": 2,
          "text": "(כמבואר בדרושים הנ\"ל),"
        },
        {
          "s": 3,
          "text": "דהנה איתא בזהר31"
        },
        {
          "s": 4,
          "text": "שתיקון השביעי שבי\"ג תיקוני דיקנא הוא תיקון ואמת."
        },
        {
          "s": 5,
          "text": "דאף שכל הי\"ג תיקוני דיקנא נמשכים מלמעלה מסדר ההשתלשלות לגמרי,"
        },
        {
          "s": 6,
          "text": "שלכן י\"ג מדות הרחמים הם מתקנים כל הפגמים,"
        },
        {
          "s": 7,
          "text": "כמבואר באגה\"ת32,"
        },
        {
          "s": 8,
          "text": "מ\"מ ה\"ה נקראים תיקוני דיקנא,"
        },
        {
          "s": 9,
          "text": "שערות דדיקנא."
        },
        {
          "s": 10,
          "text": "דענין השערה הוא33,"
        },
        {
          "s": 11,
          "text": "דעם היות שיניקתה הוא מהמוחין שבתוך הגולגולת,"
        },
        {
          "s": 12,
          "text": "מ\"מ אופן המשכת החיות בהשערה הוא ע\"י הפסק עצם הגולגולת,"
        },
        {
          "s": 13,
          "text": "שזהו\"ע צמצום עצום ביותר,"
        },
        {
          "s": 14,
          "text": "ועד שאם יחתוך האדם שער ראשו לא ירגיש כאב כלל."
        },
        {
          "s": 15,
          "text": "והדוגמא מזה יובן למעלה,"
        },
        {
          "s": 16,
          "text": "דאע\"פ שההמשכה שבבחינת שערות דדיקנא היא למעלה מעלה מסדר ההשתלשלות,"
        },
        {
          "s": 17,
          "text": "מ\"מ אופן ההמשכה הוא בבחינת הארה בלבד שבא ע\"י צמצום גדול הנקרא בשם שערות."
        },
        {
          "s": 18,
          "text": "משא\"כ בתיקון השביעי די\"ג תיקוני דיקנא,"
        },
        {
          "s": 19,
          "text": "שהוא תיקון ואמת,"
        },
        {
          "s": 20,
          "text": "בו נמשך ומתגלה האור שלא ע\"י צמצום דבחינת שערות."
        },
        {
          "s": 21,
          "text": "אשר דוגמתו בהאדם למטה הוא חלק הפנים הפנוי משערות,"
        },
        {
          "s": 22,
          "text": "כמבואר בזהר34."
        },
        {
          "s": 23,
          "text": "ועוד זאת,"
        },
        {
          "s": 24,
          "text": "שעז\"נ חכמת אדם תאיר פניו35,"
        },
        {
          "s": 25,
          "text": "דבמאור פניו של האדם ניכר החידוש של ההמשכה החדשה מבחינת החכמה,"
        },
        {
          "s": 26,
          "text": "וכמו ר' אבהו36"
        },
        {
          "s": 27,
          "text": "שצהבו פניו מפני שמצא תוספתא חדתא37."
        },
        {
          "s": 28,
          "text": "והשינוי שבפניו הוא באופן שגלוי לכל,"
        },
        {
          "s": 29,
          "text": "וכדאיתא בגמרא38"
        },
        {
          "s": 30,
          "text": "גבי ר' יהודה שאפילו האינו-יהודי הכיר בו שהיו פניו צהובין,"
        },
        {
          "s": 31,
          "text": "מפני שחכמת אדם תאיר פניו."
        },
        {
          "s": 32,
          "text": "וזהו מהחילוקים שבין ההמשכה שבשערות לההמשכה שבפנים,"
        },
        {
          "s": 33,
          "text": "דאע\"פ שהשערות נמשכים מהמוחין שבראש,"
        },
        {
          "s": 34,
          "text": "וגם לאחר זה הן מקבלות חיות מהמוחין שבראש,"
        },
        {
          "s": 35,
          "text": "ועד שעי\"ז הן צומחות וגודלות,"
        },
        {
          "s": 36,
          "text": "בכ\"ז,"
        },
        {
          "s": 37,
          "text": "מה שנראה ונגלה הם רק השערות לבד,"
        },
        {
          "s": 38,
          "text": "והחיות שבתוכן אינו ניכר בהן,"
        },
        {
          "s": 39,
          "text": "ועד שגם זה שהן מקבלות חיות ג\"ז אינו ניכר בהן."
        },
        {
          "s": 40,
          "text": "משא\"כ ההמשכה שבפנים דחכמת אדם תאיר פניו,"
        },
        {
          "s": 41,
          "text": "הרי בפניו ניכרת החכמה."
        },
        {
          "s": 42,
          "text": "וזהו מה שתיקון הז' נקרא ואמת,"
        },
        {
          "s": 43,
          "text": "דענין האמת הוא שאין בו שינויים39,"
        },
        {
          "s": 44,
          "text": "כי החידוש"
        },
        {
          "s": 45,
          "text": "(העילוי)"
        },
        {
          "s": 46,
          "text": "דתיקון זה הוא שאינו משתנה"
        },
        {
          "s": 47,
          "text": "(מתעלם)"
        },
        {
          "s": 48,
          "text": "ע\"י ההמשכה,"
        },
        {
          "s": 49,
          "text": "שגם בהיותו נמשך הוא מאיר בגלוי."
        }
      ]
    }
  ]
}