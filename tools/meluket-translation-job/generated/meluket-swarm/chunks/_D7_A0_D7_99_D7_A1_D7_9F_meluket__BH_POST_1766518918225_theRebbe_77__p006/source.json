{
  "globalIndex": 764,
  "owner": 14,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918225_theRebbe_77__p006",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918225_theRebbe_77__p006",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518918225_theRebbe_77",
  "title": "מאמר הפך ים ליבשה תשכ\"ז",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יובן גם מה שקרי\"ס הי' בזכות משה68,"
        },
        {
          "s": 2,
          "text": "וכמ\"ש69"
        },
        {
          "s": 3,
          "text": "בוקע ים לפני משה זה א-לי כו'."
        },
        {
          "s": 4,
          "text": "דהנה,"
        },
        {
          "s": 5,
          "text": "מעלת משה לגבי שאר הנביאים היא שכל הנביאים נתנבאו בכה ומשה נתנבא בזה70."
        },
        {
          "s": 6,
          "text": "ועוד חילוק בין נבואת משה לנבואת שאר הנביאים,"
        },
        {
          "s": 7,
          "text": "שכל הנביאים כשמתנבאים אבריהם מזדעזעין וכח הגוף כשל כו'71,"
        },
        {
          "s": 8,
          "text": "שאין יכולים לעמוד על עמדם,"
        },
        {
          "s": 9,
          "text": "שהיו נופלים על פניהם לקבל הנבואה כמ\"ש72"
        },
        {
          "s": 10,
          "text": "ואפול על פני גו',"
        },
        {
          "s": 11,
          "text": "והיינו שהתגלות הנבואה היא באופן של התפשטות הגשמיות דוקא73,"
        },
        {
          "s": 12,
          "text": "ועד שהי' גם הפשטת הלבושים בעת הנבואה,"
        },
        {
          "s": 13,
          "text": "כמ\"ש74"
        },
        {
          "s": 14,
          "text": "ויפשט גם הוא בגדיו ויתנבא גו' ויפול ערום,"
        },
        {
          "s": 15,
          "text": "משא\"כ משה רבינו,"
        },
        {
          "s": 16,
          "text": "גם בעת התגלות הנבואה הי' עומד על עמדו שלם75."
        },
        {
          "s": 17,
          "text": "והענין בזה,"
        },
        {
          "s": 18,
          "text": "שדרגת הנבואה דשאר הנביאים,"
        },
        {
          "s": 19,
          "text": "בחי' כה"
        },
        {
          "s": 20,
          "text": "(בכ\"ף הדמיון),"
        },
        {
          "s": 21,
          "text": "אינה אלא הארה בלבד מעלמין סתימין לעלמין דאתגליין,"
        },
        {
          "s": 22,
          "text": "משא\"כ דרגת הנבואה דמשה,"
        },
        {
          "s": 23,
          "text": "בחי' זה,"
        },
        {
          "s": 24,
          "text": "היא גילוי העצמות."
        },
        {
          "s": 25,
          "text": "והנה,"
        },
        {
          "s": 26,
          "text": "גילוי אור עליון דעלמין סתימין שע\"י הנבואה,"
        },
        {
          "s": 27,
          "text": "פועל ביטול המציאות להיות כמו ברואים שבים,"
        },
        {
          "s": 28,
          "text": "שזהו\"ע דהתפשטות הגשמיות בעת הנבואה."
        },
        {
          "s": 29,
          "text": "ורק משה רבינו,"
        },
        {
          "s": 30,
          "text": "להיות דרגת הנבואה שלו בבחי' גילוי העצמות,"
        },
        {
          "s": 31,
          "text": "הנה מצד כח העצמות לא נתבטל ממציאותו אלא הי' עומד על עמדו שלם."
        },
        {
          "s": 32,
          "text": "וזהו גם מעלת הגילוי דקרי\"ס,"
        },
        {
          "s": 33,
          "text": "שאז הי' גילוי אלקות אצל כל ישראל באופן דנבואת משה."
        },
        {
          "s": 34,
          "text": "דהנה,"
        },
        {
          "s": 35,
          "text": "אמרו חז\"ל76"
        },
        {
          "s": 36,
          "text": "ראתה שפחה על הים מה שלא ראה יחזקאל בן בוזי בנבואתו."
        },
        {
          "s": 37,
          "text": "ולכאורה צריך להבין,"
        },
        {
          "s": 38,
          "text": "הרי היו כמה נסים אותות ומופתים,"
        },
        {
          "s": 39,
          "text": "ובמה נעלה ונשגב קרי\"ס דוקא להשוותו לנבואת יחזקאל ולומר שגדלה מעלתו ממעלת נבואת יחזקאל."
        },
        {
          "s": 40,
          "text": "אך הענין הוא,"
        },
        {
          "s": 41,
          "text": "שכללות ענין הנסים הוא גילוי אור שלמעלה מהעולם,"
        },
        {
          "s": 42,
          "text": "מבחי' עלמין סתימין,"
        },
        {
          "s": 43,
          "text": "שלכן פועל שינוי טבע העולם,"
        },
        {
          "s": 44,
          "text": "ע\"ד ובדוגמת התפשטות הגשמיות בעת הנבואה מצד גילוי האור דעלמין סתימין."
        },
        {
          "s": 45,
          "text": "משא\"כ קרי\"ס,"
        },
        {
          "s": 46,
          "text": "שהפך ים ליבשה,"
        },
        {
          "s": 47,
          "text": "היינו,"
        },
        {
          "s": 48,
          "text": "לא רק גילוי אור מבחי' עלמין סתימין,"
        },
        {
          "s": 49,
          "text": "אלא עוד זאת,"
        },
        {
          "s": 50,
          "text": "שההעלם עצמו בא בגילוי,"
        },
        {
          "s": 51,
          "text": "שענין זה הוא ע\"י גילוי העצמות דוקא,"
        },
        {
          "s": 52,
          "text": "הרי בכח העצמות להיות גילוי זה נמשך לנשמות בגופים כפי שעומדים על עמדם"
        },
        {
          "s": 53,
          "text": "(ללא צורך בהתפשטות הגשמיות),"
        },
        {
          "s": 54,
          "text": "היינו,"
        },
        {
          "s": 55,
          "text": "שאצל כל בנ\"י,"
        },
        {
          "s": 56,
          "text": "אפילו שפחה,"
        },
        {
          "s": 57,
          "text": "הי' גילוי אלקות ע\"ד התגלות הנבואה למשה רבינו שהי' עומד על עמדו שלם,"
        },
        {
          "s": 58,
          "text": "שהיו מראים באצבע77"
        },
        {
          "s": 59,
          "text": "ואומרים זה א-לי,"
        },
        {
          "s": 60,
          "text": "זה דייקא,"
        },
        {
          "s": 61,
          "text": "כמו משה שנתנבא בזה."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "והנה אף שהגילוי דקרי\"ס הי' לפי שעה בלבד,"
        },
        {
          "s": 2,
          "text": "ה\"ז גם הכנה להגילויים שיהיו בגאולה דלעתיד לבוא,"
        },
        {
          "s": 3,
          "text": "וגם נתינת כח על הזמן שבינתיים,"
        },
        {
          "s": 4,
          "text": "שלכן נאמר בנהר יעברו ברגל שם נשמחה בו"
        },
        {
          "s": 5,
          "text": "(שקאי על קרי\"ס)"
        },
        {
          "s": 6,
          "text": "בלשון עתיד,"
        },
        {
          "s": 7,
          "text": "להורות על התמידות"
        },
        {
          "s": 8,
          "text": "(כנ\"ל ס\"א)."
        },
        {
          "s": 9,
          "text": "והענין בזה,"
        },
        {
          "s": 10,
          "text": "שבנהר יעברו ברגל שם נשמחה בו,"
        },
        {
          "s": 11,
          "text": "רומז גם על ג' הרגלים דמועדים לשמחה שבהם היו עוברים את הנהר"
        },
        {
          "s": 12,
          "text": "(נהר פרת)"
        },
        {
          "s": 13,
          "text": "ועולים לרגל לראות את הגילוי דפני הוי',"
        },
        {
          "s": 14,
          "text": "יראה גו' את פני הוי',"
        },
        {
          "s": 15,
          "text": "ומזה נמשך גם עכשיו"
        },
        {
          "s": 16,
          "text": "(בזמן שאין ביהמ\"ק קיים)"
        },
        {
          "s": 17,
          "text": "התגלות השמחה בג' הרגלים,"
        },
        {
          "s": 18,
          "text": "והמשכתה בכל השנה כולה בשמחה של מצוה,"
        },
        {
          "s": 19,
          "text": "והרי המצוות הם האניות שבהם ועל ידם נעשית ההמשכה והגילוי מים"
        },
        {
          "s": 20,
          "text": "(עלמין סתימין)"
        },
        {
          "s": 21,
          "text": "ליבשה"
        },
        {
          "s": 22,
          "text": "(עלמין דאתגליין)"
        },
        {
          "s": 23,
          "text": "באופן שהברואים שביבשה לא יבטלו ממציאותם"
        },
        {
          "s": 24,
          "text": "(כנ\"ל ס\"ו),"
        },
        {
          "s": 25,
          "text": "מעין ודוגמת הגילוי דקרי\"ס."
        },
        {
          "s": 26,
          "text": "והשלימות דכל ענינים אלה תהי' בגאולה העתידה לבוא,"
        },
        {
          "s": 27,
          "text": "שאז יומשך הענין דשכר מצוה מצוה78"
        },
        {
          "s": 28,
          "text": "בגילוי למטה,"
        },
        {
          "s": 29,
          "text": "ועי\"ז יהי' גילוי אלקות בעוה\"ז הגשמי,"
        },
        {
          "s": 30,
          "text": "כמ\"ש79"
        },
        {
          "s": 31,
          "text": "ונגלה כבוד הוי' וראו כל בשר יחדיו גו',"
        },
        {
          "s": 32,
          "text": "ואעפ\"כ לא יתבטלו הנבראים ממציאותם מעוצם הגילוי."
        },
        {
          "s": 33,
          "text": "דהנה,"
        },
        {
          "s": 34,
          "text": "דעת הרמב\"ם80"
        },
        {
          "s": 35,
          "text": "היא שעיקר השכר דעוה\"ב הוא באופן שאין בו לא אכילה ולא שתי' כו'81,"
        },
        {
          "s": 36,
          "text": "נשמות בלא גופים,"
        },
        {
          "s": 37,
          "text": "אבל תורת החסידות82"
        },
        {
          "s": 38,
          "text": "מכריעה כדעת הרמב\"ן83"
        },
        {
          "s": 39,
          "text": "שעיקר השכר דעוה\"ב הוא עולם התחי',"
        },
        {
          "s": 40,
          "text": "נשמות בגופים דוקא,"
        },
        {
          "s": 41,
          "text": "ואעפ\"כ,"
        },
        {
          "s": 42,
          "text": "לא יבטלו ממציאותם מעוצם הגילוי,"
        },
        {
          "s": 43,
          "text": "כמו בקרי\"ס שבנהר יעברו ברגל."
        },
        {
          "s": 44,
          "text": "ויתירה מזה,"
        },
        {
          "s": 45,
          "text": "שלעתיד לבוא כתיב והדריך בנעלים84,"
        },
        {
          "s": 46,
          "text": "דהנה,"
        },
        {
          "s": 47,
          "text": "נעל הוא לבוש המכסה על הרגל,"
        },
        {
          "s": 48,
          "text": "וענינו למעלה,"
        },
        {
          "s": 49,
          "text": "שיש מלאכים שנקראים בשם נעל דשכינתא85,"
        },
        {
          "s": 50,
          "text": "שעל ידם בא האור האלקי בהעלם והסתר שיוכל להתקבל למטה."
        },
        {
          "s": 51,
          "text": "וכיון שלעתיד לבוא אמרו חז\"ל86"
        },
        {
          "s": 52,
          "text": "עתידים צדיקים"
        },
        {
          "s": 53,
          "text": "(ועמך כולם צדיקים87)"
        },
        {
          "s": 54,
          "text": "שנקראים על שמו של הקב\"ה,"
        },
        {
          "s": 55,
          "text": "יצטרכו גם הם לנעלים שיסתירו עוצם מעלתם כדי שיוכלו לקבל מהם כל שאר הנבראים שלמטה מהם."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "וזהו גם הקשר והשייכות דב' הפירושים שבפסוק הפך ים ליבשה בנהר יעברו ברגל וגו',"
        },
        {
          "s": 1,
          "text": "פירוש הא' שרק הפך ים ליבשה קאי על קרי\"ס,"
        },
        {
          "s": 2,
          "text": "ובנהר יעברו ברגל שם נשמחה בו,"
        },
        {
          "s": 3,
          "text": "לשון עתיד,"
        },
        {
          "s": 4,
          "text": "קאי על לעתיד לבוא,"
        },
        {
          "s": 5,
          "text": "ופירוש הב' שגם בנהר יעברו ברגל וגו' קאי על קרי\"ס,"
        },
        {
          "s": 6,
          "text": "כי,"
        },
        {
          "s": 7,
          "text": "כמו88"
        },
        {
          "s": 8,
          "text": "וע\"י שהי' כל זה בקרי\"ס"
        },
        {
          "s": 9,
          "text": "(וכפי' הב')"
        },
        {
          "s": 10,
          "text": "הנה כימי צאתך מארמ\"צ אראנו נפלאות בגאולה דלעתיד לבוא89,"
        },
        {
          "s": 11,
          "text": "שיהי'"
        },
        {
          "s": 12,
          "text": "(כהפטורת היום)"
        },
        {
          "s": 13,
          "text": "והחרים ה' את לשון ים מצרים והניף ידו על הנהר גו' והדריך בנעלים והייתה מסלה גו' כאשר הייתה לישראל ביום עלותו מארץ מצרים,"
        },
        {
          "s": 14,
          "text": "ושם נשמחה בו,"
        },
        {
          "s": 15,
          "text": "במהותו ועצמותו ממש,"
        },
        {
          "s": 16,
          "text": "בביאת משיח צדקנו במהרה בימינו אמן."
        }
      ]
    }
  ]
}