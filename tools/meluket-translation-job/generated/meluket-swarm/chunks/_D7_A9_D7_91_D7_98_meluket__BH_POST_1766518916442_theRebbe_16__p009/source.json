  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916442_theRebbe_16__p009",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916442_theRebbe_16__p009",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916442_theRebbe_16",
  "title": "סקירה ע\"ד ס\"ת לקבלת פני משיח צדקנו",
  "part": 9,
  "sections": [
    {
      "v": 24,
      "items": [
        {
          "s": 0,
          "text": "לאחר שיחה קצרה מאת כ\"ק אדמו\"ר שליט\"א,"
        },
        {
          "s": 1,
          "text": "קריאת פסוקי \"למנצח יענך\" ע\"י הרר\"ש הלוי לויטין ע\"ה ועניית הקהל פסוק אחר פסוק,"
        },
        {
          "s": 2,
          "text": "וניגוני רבותינו – סוימה כתיבת ספר-התורה."
        }
      ]
    },
    {
      "v": 25,
      "items": [
        {
          "s": 0,
          "text": "ולאחר אמירת פסוקי \"אתה הראת\"21,"
        },
        {
          "s": 1,
          "text": "ניגון \"פרזות תשב ירושלים\","
        },
        {
          "s": 2,
          "text": "גלילת ספר-התורה לבישת ה\"כתר\"22"
        },
        {
          "s": 3,
          "text": "ע\"י כ\"ק אדמו\"ר שליט\"א,"
        },
        {
          "s": 4,
          "text": "נשיאת ספר-התורה לארון הקודש תחת חופה ובלוית נרות – ברך כ\"ק אדמו\"ר שליט\"א ברכת \"שהחיינו\" בקול,"
        },
        {
          "s": 5,
          "text": "ואכל פרי חדש."
        }
      ]
    },
    {
      "v": 26,
      "items": [
        {
          "s": 0,
          "text": "אח\"כ אמר מאמר ד\"ה \"להבין ענין כתיבת ספר תורה\","
        },
        {
          "s": 1,
          "text": "הנדפס בזה,"
        },
        {
          "s": 2,
          "text": "ושיחה קצרה."
        }
      ]
    }
  ]
}