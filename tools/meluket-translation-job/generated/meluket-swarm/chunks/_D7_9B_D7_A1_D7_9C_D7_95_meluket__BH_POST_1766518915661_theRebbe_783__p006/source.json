{
  "globalIndex": 336,
  "owner": 36,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915661_theRebbe_783__p006",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915661_theRebbe_783__p006",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915661_theRebbe_783",
  "title": "מאמר פדה בשלום תשכ\"ו",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "ומבאר בהמאמר,"
        },
        {
          "s": 3,
          "text": "דע\"י שלעתיד לבוא תהי' ההמשכה מפנימיות עתיק"
        },
        {
          "s": 4,
          "text": "(א\"ס שברדל\"א)"
        },
        {
          "s": 5,
          "text": "שלמעלה מההמשכה שהיתה בימי שלמה,"
        },
        {
          "s": 6,
          "text": "עי\"ז יומשך הגילוי למטה יותר."
        },
        {
          "s": 7,
          "text": "וכדאיתא בע\"ח60,"
        },
        {
          "s": 8,
          "text": "שבעליית המלכות יש ז' מדריגות."
        },
        {
          "s": 9,
          "text": "בימי שלמה היתה מדריגה הו' ולע\"ל תהי' מדריגה הז'."
        },
        {
          "s": 10,
          "text": "ומהחילוקים שביניהם הוא,"
        },
        {
          "s": 11,
          "text": "דבמדריגה הו',"
        },
        {
          "s": 12,
          "text": "הגילוי במלכות הוא רק בט' ספירות שבה ועד לבחינת יסוד שבה"
        },
        {
          "s": 13,
          "text": "(והגילוי במלכות דמלכות61"
        },
        {
          "s": 14,
          "text": "הי' ע\"י שנכללה ביסוד שבה),"
        },
        {
          "s": 15,
          "text": "ובמדריגה הז',"
        },
        {
          "s": 16,
          "text": "הגילוי הוא גם במלכות דמלכות"
        },
        {
          "s": 17,
          "text": "(כמו שהיא במקומה)."
        },
        {
          "s": 18,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 19,
          "text": "שהחילוק דב' העליות דמלכות"
        },
        {
          "s": 20,
          "text": "(עלי' הו' שבימי שלמה ועלי' הז' שתהי' לע\"ל)"
        },
        {
          "s": 21,
          "text": "הוא גם בנוגע להנצוצות שנפלו למטה."
        },
        {
          "s": 22,
          "text": "והענין הוא,"
        },
        {
          "s": 23,
          "text": "דיסוד דנוקבא הוא התקשרות המקבל"
        },
        {
          "s": 24,
          "text": "(מלכות)"
        },
        {
          "s": 25,
          "text": "בהמשפיע"
        },
        {
          "s": 26,
          "text": "(ז\"א),"
        },
        {
          "s": 27,
          "text": "ומלכות דמלכות הוא"
        },
        {
          "s": 28,
          "text": "(בדרך כלל)"
        },
        {
          "s": 29,
          "text": "כח הפועל שבנפעל."
        },
        {
          "s": 30,
          "text": "ולכן,"
        },
        {
          "s": 31,
          "text": "בימי שלמה שהגילוי במלכות הי' רק בדרגת המלכות כמו ששייכת לז\"א,"
        },
        {
          "s": 32,
          "text": "גם ההעלאה דהנצוצות שנפלו למטה היתה רק באותם הנצוצות ששייכים להרגיש אור אלקי62."
        },
        {
          "s": 33,
          "text": "ולע\"ל שהגילוי יהי' גם בדרגת המלכות כמו שהיא בבי\"ע ועד לכח הפועל שבנפעל,"
        },
        {
          "s": 34,
          "text": "גם הנצוצות שנתרחקו ממלכות שלכן אין שייכים"
        },
        {
          "s": 35,
          "text": "(מצד עצמם)"
        },
        {
          "s": 36,
          "text": "להרגיש אור אלקי,"
        },
        {
          "s": 37,
          "text": "ואפילו הנצוצות שנתרחקו כ\"כ עד שהם עצמם נעשו כמו רע,"
        },
        {
          "s": 38,
          "text": "גם הם יתעלו ויוכללו בקדושה."
        },
        {
          "s": 39,
          "text": "ויתירה מזה,"
        },
        {
          "s": 40,
          "text": "שגם הגשמי עצמו"
        },
        {
          "s": 41,
          "text": "(לא רק הניצוץ שבו)"
        },
        {
          "s": 42,
          "text": "יהי' בתכלית ההתאחדות באלקות."
        },
        {
          "s": 43,
          "text": "וזה שהגשמי יהי' אז בתכלית ההתאחדות הוא לא רק מפני שאז יתגלה כח האלקי שבו שמהווה אותו מאין ליש,"
        },
        {
          "s": 44,
          "text": "גילוי כח הפועל שבנפעל,"
        },
        {
          "s": 45,
          "text": "אלא שגם הנפעל עצמו יהי' בתכלית ההתאחדות."
        },
        {
          "s": 46,
          "text": "והטעם לכל זה הוא"
        },
        {
          "s": 47,
          "text": "(כמובא לעיל מהמאמר),"
        },
        {
          "s": 48,
          "text": "כי אז תהי' המשכת פנימיות עתיק"
        },
        {
          "s": 49,
          "text": "(א\"ס שברדל\"א),"
        },
        {
          "s": 50,
          "text": "ולכן יהי' אז הגילוי גם במלכות שבמלכות,"
        },
        {
          "s": 51,
          "text": "ויתירה מזה – גם למטה בעוה\"ז הגשמי,"
        },
        {
          "s": 52,
          "text": "בנצוצות הקדושה שבדברים הגשמיים"
        },
        {
          "s": 53,
          "text": "(גם בהנצוצות שנתרחקו),"
        },
        {
          "s": 54,
          "text": "וגם בדברים הגשמיים עצמם."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דהטעם על זה שע\"י המשכת פנימיות עתיק"
        },
        {
          "s": 2,
          "text": "(א\"ס שברדל\"א)"
        },
        {
          "s": 3,
          "text": "יהי' גילוי אלקות בכל מקום,"
        },
        {
          "s": 4,
          "text": "הוא,"
        },
        {
          "s": 5,
          "text": "כי פנימיות עתיק הוא"
        },
        {
          "s": 6,
          "text": "(בכללות)"
        },
        {
          "s": 7,
          "text": "עצמות אוא\"ס,"
        },
        {
          "s": 8,
          "text": "דלגבי עצמות אוא\"ס אין שום מציאות שחוץ ממנו,"
        },
        {
          "s": 9,
          "text": "ואדרבא,"
        },
        {
          "s": 10,
          "text": "אמיתת המצאו ית' הוא המציאות של כל הנמצאים63,"
        },
        {
          "s": 11,
          "text": "ולכן ע\"י גילוי פנימיות עתיק,"
        },
        {
          "s": 12,
          "text": "יהי' נרגש בכל דבר שמציאותו הוא אלקות."
        },
        {
          "s": 13,
          "text": "ועפ\"ז יש לומר שהעילוי בהעולם שיהי' ע\"י המשכת פנימיות עתיק לגבי מצב העולם שהי' בימי שלמה הוא גם בנוגע לאותם הדברים שגם בימי שלמה הי' בהם גילוי אלקות."
        },
        {
          "s": 14,
          "text": "כי הגילוי שהי' בימי שלמה"
        },
        {
          "s": 15,
          "text": "(שהגילוי אז הי' מחיצוניות עתיק)"
        },
        {
          "s": 16,
          "text": "הי' כמו דבר נוסף על הדברים שבהם נמשך הגילוי,"
        },
        {
          "s": 17,
          "text": "והגילוי שיהי' לע\"ל בכל דבר הוא שיתגלה אז המציאות שלו גופא."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ב)"
        },
        {
          "s": 2,
          "text": "וזהו וחסידיך יברכוכה,"
        },
        {
          "s": 3,
          "text": "שההמשכה במלכות"
        },
        {
          "s": 4,
          "text": "(יברכו כה)"
        },
        {
          "s": 5,
          "text": "שנמשכת ע\"י חסידיך הוא באופן של חסד,"
        },
        {
          "s": 6,
          "text": "הפלגת הטוב."
        },
        {
          "s": 7,
          "text": "דנוסף לזה שהם ממשיכים במלכות האורות שנסתלקו ממנה שעי\"ז נתמלא החסרון שלה,"
        },
        {
          "s": 8,
          "text": "הם ממשיכים בה ענין העשירות שלמעלה ממילוי החסרון,"
        },
        {
          "s": 9,
          "text": "עתיק,"
        },
        {
          "s": 10,
          "text": "ויתירה מזה,"
        },
        {
          "s": 11,
          "text": "שממשיכים בה גם הגילוי שלמעלה מבחי' עשירות,"
        },
        {
          "s": 12,
          "text": "פנימיות עתיק."
        },
        {
          "s": 13,
          "text": "ומבאר בהמאמר,"
        },
        {
          "s": 14,
          "text": "דזה שהמשכה זו נמשכת ע\"י חסידיך"
        },
        {
          "s": 15,
          "text": "(דוקא)"
        },
        {
          "s": 16,
          "text": "הוא מצד שני ענינים."
        },
        {
          "s": 17,
          "text": "מצד הביטול שלהם."
        },
        {
          "s": 18,
          "text": "כמאמר הזהר"
        },
        {
          "s": 19,
          "text": "(הובא לעיל סעיף ה)"
        },
        {
          "s": 20,
          "text": "איזהו חסיד המתחסד עם קונו,"
        },
        {
          "s": 21,
          "text": "שעבודתו היא לא בשביל עצמו בכדי שיהי' דבוק באלקות אלא לצורך גבוה,"
        },
        {
          "s": 22,
          "text": "כמבואר בתניא64."
        },
        {
          "s": 23,
          "text": "וע\"י שהעבודה שלהם היא בביטול"
        },
        {
          "s": 24,
          "text": "(למעלה ממציאות),"
        },
        {
          "s": 25,
          "text": "לכן ההמשכה שנמשכת ע\"י עבודתם היא מבחינת העצם שלמעלה מהתפשטות"
        },
        {
          "s": 26,
          "text": "(מציאות),"
        },
        {
          "s": 27,
          "text": "עתיק,"
        },
        {
          "s": 28,
          "text": "ויתירה מזה – פנימיות עתיק."
        },
        {
          "s": 29,
          "text": "[וזהו איזהו חסיד שמתחסד עם קונו ופירש בתקו\"ז עם קן דילי'."
        },
        {
          "s": 30,
          "text": "דמהביאורים בהקשר דשני הענינים הוא,"
        },
        {
          "s": 31,
          "text": "דע\"י שהוא מתחסד עם קונו,"
        },
        {
          "s": 32,
          "text": "שעבודתו היא לא בשביל עצמו אלא לצורך גבוה,"
        },
        {
          "s": 33,
          "text": "לכן בכחו להתחסד עם קן דילי',"
        },
        {
          "s": 34,
          "text": "שההמשכה במלכות"
        },
        {
          "s": 35,
          "text": "(קן דילי')"
        },
        {
          "s": 36,
          "text": "תהי'"
        },
        {
          "s": 37,
          "text": "(לא רק באופן של צדקה,"
        },
        {
          "s": 38,
          "text": "מילוי החסרון,"
        },
        {
          "s": 39,
          "text": "אלא)"
        },
        {
          "s": 40,
          "text": "באופן של חסד – עשירות ולמעלה מעשירות]."
        },
        {
          "s": 41,
          "text": "ועוד ענין בהשייכות דהמשכת פנימיות עתיק לחסידיך,"
        },
        {
          "s": 42,
          "text": "דענין החסידות הוא שכחות הטבעיים נעשים כחות אלקיים65,"
        },
        {
          "s": 43,
          "text": "והחידוש בעולם שיהי' לע\"ל ע\"י המשכת פנימיות עתיק הוא אז אהפוך אל עמים66"
        },
        {
          "s": 44,
          "text": "[שהבירור בימי שלמה הי' ע\"י שהאור דלמעלה משך אליו את הנצוצות שבהעמים"
        },
        {
          "s": 45,
          "text": "(כנ\"ל),"
        },
        {
          "s": 46,
          "text": "ולע\"ל יהפכו הם עצמם לקדושה],"
        },
        {
          "s": 47,
          "text": "ע\"ד שכחות הטבעיים נהפכים ונעשים כחות אלקיים."
        }
      ]
    }
  ]
}