{
  "globalIndex": 612,
  "owner": 12,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917334_theRebbe_880__p001",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917334_theRebbe_880__p001",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917334_theRebbe_880",
  "title": "מאמר ואתה תצוה תשמ\"א",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ תצוה,"
        },
        {
          "s": 2,
          "text": "יו\"ד אדר-ראשון ה'תשמ\"א*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "ואתה תצוה את בני ישראל ויקחו אליך שמן זית זך כתית למאור להעלות נר תמיד1,"
        },
        {
          "s": 1,
          "text": "וידועים הדיוקים בזה2"
        },
        {
          "s": 2,
          "text": "דבכל הציווים שבתורה נאמר צו את בני ישראל וכיו\"ב,"
        },
        {
          "s": 3,
          "text": "וכאן נאמר ואתה תצוה את בני ישראל."
        },
        {
          "s": 4,
          "text": "ולהוסיף,"
        },
        {
          "s": 5,
          "text": "דהדיוק מ\"ש ואתה תצוה הוא לא רק בהלשון אלא גם בהתוכן,"
        },
        {
          "s": 6,
          "text": "דלשון ואתה תצוה משמע שמשה הוא המצַוה,"
        },
        {
          "s": 7,
          "text": "וצריך להבין,"
        },
        {
          "s": 8,
          "text": "הרי משה הוא השליח למסור לישראל את ציווי הקב\"ה,"
        },
        {
          "s": 9,
          "text": "ולמה נאמר ואתה תצוה."
        },
        {
          "s": 10,
          "text": "גם צריך להבין מ\"ש ויקחו אליך,"
        },
        {
          "s": 11,
          "text": "שיביאו השמן למשה3"
        },
        {
          "s": 12,
          "text": "(אליך),"
        },
        {
          "s": 13,
          "text": "דלכאורה,"
        },
        {
          "s": 14,
          "text": "כיון שהעלאת הנרות היתה ע\"י אהרן,"
        },
        {
          "s": 15,
          "text": "למה הוצרך להביא את השמן למשה."
        },
        {
          "s": 16,
          "text": "גם צריך להבין מ\"ש שמן גו' כתית למאור,"
        },
        {
          "s": 17,
          "text": "דלכאורה הול\"ל שמן גו' להאיר."
        },
        {
          "s": 18,
          "text": "גם צריך להבין,"
        },
        {
          "s": 19,
          "text": "דבפסוק שלאח\"ז4"
        },
        {
          "s": 20,
          "text": "נאמר מערב עד בוקר וכאן נאמר להעלות נר תמיד."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ומבאר כ\"ק מו\"ח אדמו\"ר"
        },
        {
          "s": 2,
          "text": "(במאמרו הידוע ד\"ה וקבל היהודים5"
        },
        {
          "s": 3,
          "text": "שנאמר בפורים קטן תרפ\"ז6),"
        },
        {
          "s": 4,
          "text": "דציווי"
        },
        {
          "s": 5,
          "text": "(תצוה)"
        },
        {
          "s": 6,
          "text": "הוא צוותא וחיבור7."
        },
        {
          "s": 7,
          "text": "וזהו ואתה תצוה את בני ישראל,"
        },
        {
          "s": 8,
          "text": "שמשה הוא מקשר ומחבר את בני ישראל עם אוא\"ס8."
        },
        {
          "s": 9,
          "text": "וע\"י שמשה משפיע לישראל"
        },
        {
          "s": 10,
          "text": "(שמקשר אותם עם אוא\"ס),"
        },
        {
          "s": 11,
          "text": "עי\"ז נעשה יתרון והוספה במשה."
        },
        {
          "s": 12,
          "text": "[דמשה וישראל הם דוגמת ראש ורגל,"
        },
        {
          "s": 13,
          "text": "כמ\"ש9"
        },
        {
          "s": 14,
          "text": "שש מאות אלף רגלי העם אשר אנכי בקרבו,"
        },
        {
          "s": 15,
          "text": "דכל ישראל הם הרגלים דמשה,"
        },
        {
          "s": 16,
          "text": "ומשה הוא הראש שלהם."
        },
        {
          "s": 17,
          "text": "וכמו שבאדם הרגלים מוליכים את הראש למקום שהראש מצד עצמו אינו יכול להגיע לשם,"
        },
        {
          "s": 18,
          "text": "כמו\"כ הוא במשה וישראל,"
        },
        {
          "s": 19,
          "text": "שע\"י ישראל"
        },
        {
          "s": 20,
          "text": "(הרגלים דמשה)"
        },
        {
          "s": 21,
          "text": "מיתוסף עילוי במשה."
        },
        {
          "s": 22,
          "text": "דזהו מ\"ש שש מאות אלף רגלי העם אשר אנכי בקרבו,"
        },
        {
          "s": 23,
          "text": "שע\"י רגלי העם נמשך הגילוי דאנכי בקרבו של משה10]."
        },
        {
          "s": 24,
          "text": "וזהו ואתה תצוה את בני ישראל ויקחו אליך שמן זית גו',"
        },
        {
          "s": 25,
          "text": "דע\"י שמשה יצַוה ויקשר את בני ישראל עם אוא\"ס,"
        },
        {
          "s": 26,
          "text": "עי\"ז יביאו בני ישראל שמן זית למשה"
        },
        {
          "s": 27,
          "text": "(ויקחו אליך),"
        },
        {
          "s": 28,
          "text": "שיוסיפו תוספות אור במשה."
        }
      ]
    }
  ]
}