{
  "globalIndex": 349,
  "owner": 49,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915758_theRebbe_412__p005",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915758_theRebbe_412__p005",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915758_theRebbe_412",
  "title": "מאמר להבין ענין נרות חנוכה תשכ\"ו",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "והנה ידוע54,"
        },
        {
          "s": 1,
          "text": "דהגם שעתיק הוא מלשון נעתק ונבדל55,"
        },
        {
          "s": 2,
          "text": "מ\"מ,"
        },
        {
          "s": 3,
          "text": "מזה שנקרא בשם עתיק יומין56"
        },
        {
          "s": 4,
          "text": "(שהוא נעתק מיומין),"
        },
        {
          "s": 5,
          "text": "מובן,"
        },
        {
          "s": 6,
          "text": "שגם לגבי הדרגא דעתיק,"
        },
        {
          "s": 7,
          "text": "ישנם יומין,"
        },
        {
          "s": 8,
          "text": "אלא שהוא נעתק מהם."
        },
        {
          "s": 9,
          "text": "[ויתירה מזה54,"
        },
        {
          "s": 10,
          "text": "שגם הדרגא שנק' עתיק"
        },
        {
          "s": 11,
          "text": "(סתם),"
        },
        {
          "s": 12,
          "text": "שלמעלה מעתיק יומין,"
        },
        {
          "s": 13,
          "text": "מ\"מ,"
        },
        {
          "s": 14,
          "text": "כיון שנק' בשם עתיק,"
        },
        {
          "s": 15,
          "text": "דפירוש עתיק הוא שנעתק,"
        },
        {
          "s": 16,
          "text": "בהכרח לומר,"
        },
        {
          "s": 17,
          "text": "שישנו ענין שממנו הוא נעתק]."
        },
        {
          "s": 18,
          "text": "ולכן,"
        },
        {
          "s": 19,
          "text": "ביטול הגזירה שמצד הדרגא דהשתלשלות ע\"י המשכת עתיק היא בדרך פעולה."
        },
        {
          "s": 20,
          "text": "שמצד ההשתלשלות"
        },
        {
          "s": 21,
          "text": "(יומין)"
        },
        {
          "s": 22,
          "text": "נגזר שלא תהי' ההשפעה,"
        },
        {
          "s": 23,
          "text": "וע\"י המשכת עתיק,"
        },
        {
          "s": 24,
          "text": "היא מתבטלת."
        },
        {
          "s": 25,
          "text": "[אלא שביטול הגזירה שבהשתלשלות ע\"י המשכת עתיק הוא באופן שההשתלשלות עצמו נעשה באופן כזה]."
        },
        {
          "s": 26,
          "text": "אבל השינוי בהשתלשלות ע\"י המשכת פנימיות עתיק אינו בדרך פעולה אלא ממילא."
        },
        {
          "s": 27,
          "text": "והענין הוא,"
        },
        {
          "s": 28,
          "text": "דפנימיות עתיק הוא א\"ס שברדל\"א"
        },
        {
          "s": 29,
          "text": "(כמבואר בהמאמר57)."
        },
        {
          "s": 30,
          "text": "וכיון דפירוש א\"ס הוא שאין בו שום הגבלה,"
        },
        {
          "s": 31,
          "text": "הרי מובן,"
        },
        {
          "s": 32,
          "text": "שלגבי א\"ס אין שייך לומר שהוא נעתק ונבדל מענין ההשתלשלות,"
        },
        {
          "s": 33,
          "text": "כי לגבי' אין שייך ענין ההשתלשלות."
        },
        {
          "s": 34,
          "text": "[והגם שהוא נמצא ברדל\"א,"
        },
        {
          "s": 35,
          "text": "הרי מבואר בהמאמר שהוא נמצא ברדל\"א כמו שהוא בעצמותו]."
        },
        {
          "s": 36,
          "text": "ומזה מובן,"
        },
        {
          "s": 37,
          "text": "דביטול הגזירה שמצד ההשתלשלות ע\"י המשכת הגילוי דפנימיות עתיק הוא"
        },
        {
          "s": 38,
          "text": "(לא שע\"י הגילוי דפנימיות עתיק נעשה ביטול הגזירה,"
        },
        {
          "s": 39,
          "text": "כי אם),"
        },
        {
          "s": 40,
          "text": "שמצד הגילוי דפנימיות עתיק,"
        },
        {
          "s": 41,
          "text": "א\"ס"
        },
        {
          "s": 42,
          "text": "(שברדל\"א),"
        },
        {
          "s": 43,
          "text": "אין מקום מלכתחילה לגזירה."
        },
        {
          "s": 44,
          "text": "ועפ\"ז יש לבאר מ\"ש בהמאמר דענין חסידיך יברכוכה הוא כדאיתא בירושלמי אפילו הוא"
        },
        {
          "s": 45,
          "text": "(הקב\"ה)"
        },
        {
          "s": 46,
          "text": "אמר הכין ואת אמר הכין דידך קיימא דידי לא קיימא,"
        },
        {
          "s": 47,
          "text": "דפירוש דידי לא קיימא הוא"
        },
        {
          "s": 48,
          "text": "(לא שע\"י שאת אמר הכין מתבטלת הגזירה,"
        },
        {
          "s": 49,
          "text": "כי אם),"
        },
        {
          "s": 50,
          "text": "שע\"י הגילוי דפנימיות עתיק שנמשך ע\"י את אמר הכין,"
        },
        {
          "s": 51,
          "text": "אין מקום מלכתחילה לגזירה,"
        },
        {
          "s": 52,
          "text": "לא קיימא."
        },
        {
          "s": 53,
          "text": "וזהו יודוך גו' וחסידיך יברכוכה,"
        },
        {
          "s": 54,
          "text": "שההמשכה מהמקום שבו הוא ההודאה באופן דברכה"
        },
        {
          "s": 55,
          "text": "(בדרך ממילא)"
        },
        {
          "s": 56,
          "text": "הוא ע\"י חסידיך דוקא,"
        },
        {
          "s": 57,
          "text": "כי ההמשכה שע\"י חסידיך היא מפנימיות עתיק,"
        },
        {
          "s": 58,
          "text": "וההמשכה משם היא"
        },
        {
          "s": 59,
          "text": "(לא בדרך פעולה,"
        },
        {
          "s": 60,
          "text": "אלא)"
        },
        {
          "s": 61,
          "text": "בדרך ממילא."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "והנה החילוק שבין ג' המשכות הנ\"ל"
        },
        {
          "s": 2,
          "text": "(אריך,"
        },
        {
          "s": 3,
          "text": "עתיק ופנימיות עתיק)"
        },
        {
          "s": 4,
          "text": "הוא גם בענין הבירורים."
        },
        {
          "s": 5,
          "text": "דהבירור שע\"י הגילוי דאריך הוא בדרך מלמעלה למטה."
        },
        {
          "s": 6,
          "text": "היינו58"
        },
        {
          "s": 7,
          "text": "שהבירור דהתחתון הוא לא מצד המציאות שלו אלא אדרבא,"
        },
        {
          "s": 8,
          "text": "מפני שע\"י שמאיר בו גילוי אור שאינו בערך אליו"
        },
        {
          "s": 9,
          "text": "[בחינת סובב],"
        },
        {
          "s": 10,
          "text": "הוא מתבטל ממציאותו."
        },
        {
          "s": 11,
          "text": "ולכן,"
        },
        {
          "s": 12,
          "text": "גם לאחרי הבירור,"
        },
        {
          "s": 13,
          "text": "זה שהתחתון אינו מנגד הוא לפי שנתבטל ממציאותו ע\"י הגילוי אור,"
        },
        {
          "s": 14,
          "text": "אבל לא שנעשה שינוי בהמציאות דהתחתון עצמו."
        },
        {
          "s": 15,
          "text": "והבירור שע\"י הגילוי דעתיק הוא גם מצד ענינו דהתחתון עצמו59."
        },
        {
          "s": 16,
          "text": "דכיון שתענוג"
        },
        {
          "s": 17,
          "text": "(עתיק)"
        },
        {
          "s": 18,
          "text": "הוא הפנימיות והחיות דכל ההשתלשלות,"
        },
        {
          "s": 19,
          "text": "לכן,"
        },
        {
          "s": 20,
          "text": "הבירור דהתחתון שע\"י גילוי זה הוא באופן שנעשה שינוי בהתחתון עצמו."
        },
        {
          "s": 21,
          "text": "וכמבואר בהמאמר60"
        },
        {
          "s": 22,
          "text": "בענין הבירור ע\"י הגילוי שהאיר ע\"י שלמה"
        },
        {
          "s": 23,
          "text": "[דהגילוי שהאיר ע\"י שלמה הוא הגילוי דעתיק],"
        },
        {
          "s": 24,
          "text": "שהגילוי אור משך אליו את הנצוצות,"
        },
        {
          "s": 25,
          "text": "בדוגמת אבוקה שמושכת אלי' את הנצוצות."
        },
        {
          "s": 26,
          "text": "וכיון שהבירור הי' באופן שהנצוצות"
        },
        {
          "s": 27,
          "text": "(שבהתחתון)"
        },
        {
          "s": 28,
          "text": "נמשכו מעצמם להגילוי,"
        },
        {
          "s": 29,
          "text": "הרי מובן,"
        },
        {
          "s": 30,
          "text": "שהבירור אז הי' גם מצד ענינו דהתחתון61."
        },
        {
          "s": 31,
          "text": "אלא שמ\"מ,"
        },
        {
          "s": 32,
          "text": "כיון שגם לגבי עתיק יש המציאות דהשתלשלות,"
        },
        {
          "s": 33,
          "text": "ומצד סדר ההשתלשלות,"
        },
        {
          "s": 34,
          "text": "גדר התחתון הוא שהוא תחתון"
        },
        {
          "s": 35,
          "text": "(היפך דעליון62),"
        },
        {
          "s": 36,
          "text": "לכן הגילוי אור דהעליון שנמשך בו"
        },
        {
          "s": 37,
          "text": "[ובמילא,"
        },
        {
          "s": 38,
          "text": "גם הבירור שנעשה ע\"י הגילוי]"
        },
        {
          "s": 39,
          "text": "הוא כמו דבר נוסף עליו."
        },
        {
          "s": 40,
          "text": "והבירור שע\"י הגילוי דפנימיות עתיק,"
        },
        {
          "s": 41,
          "text": "כיון שפנימיות עתיק"
        },
        {
          "s": 42,
          "text": "(א\"ס שברדל\"א)"
        },
        {
          "s": 43,
          "text": "הוא"
        },
        {
          "s": 44,
          "text": "(בכללות)"
        },
        {
          "s": 45,
          "text": "עצמות אוא\"ס,"
        },
        {
          "s": 46,
          "text": "דלגבי עצמות אוא\"ס אין שייך מציאות שחוץ ממנו,"
        },
        {
          "s": 47,
          "text": "ואדרבא,"
        },
        {
          "s": 48,
          "text": "אמיתת המצאו ית' היא המציאות של כל הנמצאים63,"
        },
        {
          "s": 49,
          "text": "לכן,"
        },
        {
          "s": 50,
          "text": "ע\"י גילוי פנימיות עתיק,"
        },
        {
          "s": 51,
          "text": "נרגש בכל דבר שהמציאות שלו גופא היא אלקות."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "וזהו שבימי שלמה נתבררו רק נצוצות אלו שהי' בהם איזה ענין של אור ולע\"ל יתבררו כל הנצוצות,"
        },
        {
          "s": 3,
          "text": "כי בירור הנצוצות שע\"י גילוי חיצוניות עתיק"
        },
        {
          "s": 4,
          "text": "[שהגילוי שהי' בימי שלמה הי' הגילוי דחיצוניות עתיק]"
        },
        {
          "s": 5,
          "text": "הוא לא מצד הנצוצות עצמם אלא מצד זה שהגילוי מושך את הנצוצות אליו,"
        },
        {
          "s": 6,
          "text": "ולכן נתבררו אז רק נצוצות אלו ששייכים להרגיש גילוי אור."
        },
        {
          "s": 7,
          "text": "והבירור שע\"י גילוי פנימיות עתיק הוא שע\"י הגילוי דפנימיות עתיק מתגלה בכל דבר שהמציאות שלו גופא היא אלקות,"
        },
        {
          "s": 8,
          "text": "ולכן לע\"ל שאז יהי' הגילוי דפנימיות עתיק,"
        },
        {
          "s": 9,
          "text": "גם הנצוצות שנחשכו יתעלו ויוכללו בקדושה,"
        },
        {
          "s": 10,
          "text": "ויתירה מזה,"
        },
        {
          "s": 11,
          "text": "שגם הדברים הגשמיים עצמם"
        },
        {
          "s": 12,
          "text": "(לא רק הנצוצות שבהם)"
        },
        {
          "s": 13,
          "text": "יהיו בתכלית ההתאחדות באלקות,"
        },
        {
          "s": 14,
          "text": "כמשנ\"ת בד\"ה פדה בשלום שנאמר בי\"ט כסלו."
        }
      ]
    }
  ]
}