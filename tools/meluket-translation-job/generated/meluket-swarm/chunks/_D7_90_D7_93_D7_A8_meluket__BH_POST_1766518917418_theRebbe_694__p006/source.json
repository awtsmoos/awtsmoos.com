{
  "globalIndex": 631,
  "owner": 31,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917418_theRebbe_694__p006",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917418_theRebbe_694__p006",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917418_theRebbe_694",
  "title": "מאמר וקבל היהודים תשי\"א",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "והנה ע\"פ המבואר לעיל"
        },
        {
          "s": 3,
          "text": "(סעיף ד)"
        },
        {
          "s": 4,
          "text": "שבחיבור עליון ותחתון יש ג' ענינים – העליון,"
        },
        {
          "s": 5,
          "text": "התחתון והביטול שלהם – מובן,"
        },
        {
          "s": 6,
          "text": "שבכדי לזכות להגמר והשלימות דקבלת התורה אין מספיק הביטול דהנשמה ודהגוף,"
        },
        {
          "s": 7,
          "text": "אלא צריך שתהי' גם המציאות שלהם,"
        },
        {
          "s": 8,
          "text": "וכמו שהם בתכלית השלימות,"
        },
        {
          "s": 9,
          "text": "ושהמציאות שלהם תהי' קשורה ומחוברת עם התורה."
        },
        {
          "s": 10,
          "text": "וע\"ד שנת\"ל"
        },
        {
          "s": 11,
          "text": "(ס\"ו וס\"ח)"
        },
        {
          "s": 12,
          "text": "שהמעלה דלימוד התורה לשמה היא לא רק בענין הביטול"
        },
        {
          "s": 13,
          "text": "(שהלימוד שלו הוא לא בשביל השלימות שלו,"
        },
        {
          "s": 14,
          "text": "גם לא בשביל השלימות דהנשמה)"
        },
        {
          "s": 15,
          "text": "אלא גם זה שמציאותו של האדם הלומד"
        },
        {
          "s": 16,
          "text": "(הנשמה והגוף)"
        },
        {
          "s": 17,
          "text": "מתחברת עם התורה שעי\"ז הוא יוצא מהגבלותיו ומתעלה להבל\"ג דתורה."
        },
        {
          "s": 18,
          "text": "ויש לומר,"
        },
        {
          "s": 19,
          "text": "דזהו שמביא בהמאמר שהתעוררות המס\"נ דישראל היתה ע\"י מרדכי,"
        },
        {
          "s": 20,
          "text": "משה שבדורו,"
        },
        {
          "s": 21,
          "text": "דלימוד התורה של מרדכי הי' בתכלית העילוי,"
        },
        {
          "s": 22,
          "text": "וע\"י שעורר את ישראל ללמוד תורה במס\"נ"
        },
        {
          "s": 23,
          "text": "[ובפרט שמרדכי הי' ראש הדור"
        },
        {
          "s": 24,
          "text": "(ע\"ד משה)"
        },
        {
          "s": 25,
          "text": "שממנו נמשך לכל האברים],"
        },
        {
          "s": 26,
          "text": "המשיך בהם"
        },
        {
          "s": 27,
          "text": "(לא רק ענין הביטול,"
        },
        {
          "s": 28,
          "text": "אלא)"
        },
        {
          "s": 29,
          "text": "גם העילוי דלימוד התורה כמו שהיא מצד השלימות דהאדם,"
        },
        {
          "s": 30,
          "text": "השלימות דהנשמה ודהגוף."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש לבאר גם מה שמביא בהמאמר שמרדכי קיבץ כ\"ב אלף תינוקות של בית רבן,"
        },
        {
          "s": 1,
          "text": "כי מעלה זו בלימוד התורה"
        },
        {
          "s": 2,
          "text": "(שהיא מצד השלימות דהנשמה ודהגוף)"
        },
        {
          "s": 3,
          "text": "היא בעיקר בתינוקות של בית רבן."
        },
        {
          "s": 4,
          "text": "ויובן זה ע\"פ מה שארז\"ל82"
        },
        {
          "s": 5,
          "text": "אין העולם מתקיים אלא בשביל הבל תינוקות של בית רבן,"
        },
        {
          "s": 6,
          "text": "אמר לי' רב פפא לאביי דידי ודידך מאי,"
        },
        {
          "s": 7,
          "text": "א\"ל אינו דומה הבל שיש בו חטא להבל שאין בו חטא."
        },
        {
          "s": 8,
          "text": "דהגם שלימוד התורה של ר\"פ ואביי הי'"
        },
        {
          "s": 9,
          "text": "(בודאי)"
        },
        {
          "s": 10,
          "text": "לשמה בדרגות הכי נעלות ולימוד התורה דתינוקות של בית רבן הוא מצד יראת הרצועה83,"
        },
        {
          "s": 11,
          "text": "אעפ\"כ,"
        },
        {
          "s": 12,
          "text": "יש יתרון בהבל תינוקות של בית רבן,"
        },
        {
          "s": 13,
          "text": "שעל הבל זה דוקא העולם מתקיים."
        },
        {
          "s": 14,
          "text": "וידוע הביאור בזה84,"
        },
        {
          "s": 15,
          "text": "דהמעלה בהבל תשב\"ר הוא הן מצד נשמתם,"
        },
        {
          "s": 16,
          "text": "שהיא קרובה יותר לאלקות מפני שזה מקרוב באה מעולם הרוחני,"
        },
        {
          "s": 17,
          "text": "והן מצד הגוף שלהם שלא נתגשם כ\"כ באכו\"ש ובתאוות,"
        },
        {
          "s": 18,
          "text": "כמבואר במק\"א בארוכה."
        },
        {
          "s": 19,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 20,
          "text": "דזה שמביא בהמאמר שבזמן הגזירה קיבץ מרדכי כ\"ב אלף תינוקות של בית רבן,"
        },
        {
          "s": 21,
          "text": "הוא,"
        },
        {
          "s": 22,
          "text": "בכדי לבאר שבלימוד התורה שהי' אז,"
        },
        {
          "s": 23,
          "text": "הי'"
        },
        {
          "s": 24,
          "text": "(לא רק הביטול דהנשמה ודהגוף,"
        },
        {
          "s": 25,
          "text": "אלא)"
        },
        {
          "s": 26,
          "text": "גם השלימות דהנשמה ודהגוף."
        },
        {
          "s": 27,
          "text": "[אלא שמעלת הנשמה דתינוקות של בית רבן אינה שייכת"
        },
        {
          "s": 28,
          "text": "(כ\"כ)"
        },
        {
          "s": 29,
          "text": "ללימוד התורה שלהם,"
        },
        {
          "s": 30,
          "text": "מכיון שהלימוד שלהם הוא מפני יראת הרצועה"
        },
        {
          "s": 31,
          "text": "(טבע הגוף)"
        },
        {
          "s": 32,
          "text": "ולא מצד הנשמה,"
        },
        {
          "s": 33,
          "text": "וגם אין בזה הביטול דמס\"נ,"
        },
        {
          "s": 34,
          "text": "ולכן מביא בהמאמר שהלימוד דתינוקות של בית רבן הי' ע\"י מרדכי,"
        },
        {
          "s": 35,
          "text": "שעי\"ז הי' גם לימוד התורה שלהם במס\"נ כמבואר בהמאמר]."
        },
        {
          "s": 36,
          "text": "ויש להוסיף,"
        },
        {
          "s": 37,
          "text": "דע\"י שמרדכי קיבץ כ\"ב אלף תינוקות של בית רבן נתוסף אצלו העילוי דהבל תינוקות של בית רבן85,"
        },
        {
          "s": 38,
          "text": "ועי\"ז86"
        },
        {
          "s": 39,
          "text": "המשיך ענין זה גם בכל היהודים שבדורו."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ב)"
        },
        {
          "s": 2,
          "text": "ועפ\"ז יש לבאר גם מה שחייב אינש לבסומי בפוריא עד דלא ידע87,"
        },
        {
          "s": 3,
          "text": "כי בימי הפורים בכל שנה ושנה חוזר וניעור הענין דוקבל היהודים כמו שהי' בפעם הראשונה,"
        },
        {
          "s": 4,
          "text": "ואדרבא – באופן דמעלין בקודש88."
        },
        {
          "s": 5,
          "text": "[ויש להוסיף,"
        },
        {
          "s": 6,
          "text": "שהחידוש בימי הפורים לגבי מתן תורה הוא בשני ענינים."
        },
        {
          "s": 7,
          "text": "שבימי הפורים הי' הגמר והשלימות דקבלת התורה"
        },
        {
          "s": 8,
          "text": "(וקבל היהודים),"
        },
        {
          "s": 9,
          "text": "כנ\"ל בארוכה,"
        },
        {
          "s": 10,
          "text": "וגם קיום התורה,"
        },
        {
          "s": 11,
          "text": "כדאיתא בגמרא89"
        },
        {
          "s": 12,
          "text": "עה\"פ90"
        },
        {
          "s": 13,
          "text": "קיימו וקבלו היהודים קיימו מה שקבלו כבר,"
        },
        {
          "s": 14,
          "text": "דזה שקבלו במתן תורה לא הי' באופן דקיום נצחי,"
        },
        {
          "s": 15,
          "text": "דלאחרי שחטאו בעגל התנצלו את עדים91,"
        },
        {
          "s": 16,
          "text": "ובימי הפורים כתיב92"
        },
        {
          "s": 17,
          "text": "וימי הפורים האלה לא יעברו גו' וזכרם לא יסוף מזרעם,"
        },
        {
          "s": 18,
          "text": "דזה שקבלו בפורים קיים בקיום נצחי93."
        },
        {
          "s": 19,
          "text": "ועד\"ז הוא בימי הפורים בכל שנה ושנה,"
        },
        {
          "s": 20,
          "text": "שיש בזה שני ענינים אלה."
        },
        {
          "s": 21,
          "text": "שבכל שנה ניתוסף בהשלימות דקבלת התורה"
        },
        {
          "s": 22,
          "text": "(כנ\"ל),"
        },
        {
          "s": 23,
          "text": "ושגם הוספה זו יש לה קיום נצחי]."
        },
        {
          "s": 24,
          "text": "ולכן בפורים צ\"ל העבודה דלא ידע,"
        },
        {
          "s": 25,
          "text": "אַרויסגיין פון זיך,"
        },
        {
          "s": 26,
          "text": "כי השלימות דקבלת התורה באה ע\"י הביטול."
        },
        {
          "s": 27,
          "text": "וזהו גם שהיציאה ממציאותו"
        },
        {
          "s": 28,
          "text": "(עד דלא ידע)"
        },
        {
          "s": 29,
          "text": "צריכה להיות ע\"י לבסומי ביין94"
        },
        {
          "s": 30,
          "text": "(גשמי),"
        },
        {
          "s": 31,
          "text": "כי הביטול"
        },
        {
          "s": 32,
          "text": "(דפורים)"
        },
        {
          "s": 33,
          "text": "צריך להיות גם מצד הגוף,"
        },
        {
          "s": 34,
          "text": "כנ\"ל בארוכה."
        },
        {
          "s": 35,
          "text": "ומזה נמשך הנתינת כח על כל השנה,"
        },
        {
          "s": 36,
          "text": "שעניני הגוף לא יתפסו מקום אצלו ובמילא לא תהי' מניעה מצד הגוף ללימוד התורה."
        }
      ]
    }
  ]
}