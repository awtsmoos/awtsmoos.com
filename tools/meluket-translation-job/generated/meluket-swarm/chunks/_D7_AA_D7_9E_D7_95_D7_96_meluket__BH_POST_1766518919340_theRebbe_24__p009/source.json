{
  "globalIndex": 947,
  "owner": 47,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919340_theRebbe_24__p009",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919340_theRebbe_24__p009",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919340_theRebbe_24",
  "title": "מאמר עשרה שיושבין תשמ\"ב",
  "part": 9,
  "sections": [
    {
      "v": 24,
      "items": [
        {
          "s": 0,
          "text": "ועוד מעלה בברכת כהנים72,"
        },
        {
          "s": 1,
          "text": "שההמשכה דברכת כהנים היא מלמעלה מהשתלשלות."
        },
        {
          "s": 2,
          "text": "דברכה בכלל היא להמשיך מה שכבר נמצא בהמקור ולא דבר חדש,"
        },
        {
          "s": 3,
          "text": "דבענין זה מעלה בתפלה לגבי ברכה,"
        },
        {
          "s": 4,
          "text": "שעל ידי התפלה נעשה רצון חדש."
        },
        {
          "s": 5,
          "text": "ובברכת כהנים שתי המעלות,"
        },
        {
          "s": 6,
          "text": "שההמשכה היא מלמעלה מהשתלשלות,"
        },
        {
          "s": 7,
          "text": "ובדרך ציווי."
        },
        {
          "s": 8,
          "text": "וכמו\"כ הוא בההמשכה שעל ידי תורה,"
        },
        {
          "s": 9,
          "text": "שיש בה שתי המעלות,"
        },
        {
          "s": 10,
          "text": "שההמשכה היא מלמעלה מהשתלשלות ובאופן דציווי."
        },
        {
          "s": 11,
          "text": "וזוהי המעלה בההמשכה שעל ידי תורה"
        },
        {
          "s": 12,
          "text": "(דרבים)"
        },
        {
          "s": 13,
          "text": "לגבי ההמשכה שע\"י תפלה"
        },
        {
          "s": 14,
          "text": "(דרבים),"
        },
        {
          "s": 15,
          "text": "דההמשכה שע\"י תורה היא באופן שהוא בעה\"ב על ההמשכה."
        }
      ]
    },
    {
      "v": 25,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "והנה אף שברכת כהנים היא מצוה בפני עצמה,"
        },
        {
          "s": 3,
          "text": "קבעוה חכמים בתפלה73."
        },
        {
          "s": 4,
          "text": "ומזה מובן,"
        },
        {
          "s": 5,
          "text": "דהגם שתפלה היא מלמטלמ\"ע מ\"מ ע\"י התפלה מגיעים לההמשכה דברכת כהנים שהיא מלמעלה למטה."
        },
        {
          "s": 6,
          "text": "ועפ\"ז יש להוסיף בהלימוד דק\"ו,"
        },
        {
          "s": 7,
          "text": "דכמו שתפלה וברכת כהנים,"
        },
        {
          "s": 8,
          "text": "הגם שהם ענינים שונים,"
        },
        {
          "s": 9,
          "text": "דתפלה היא בקשה"
        },
        {
          "s": 10,
          "text": "(מלמטה למעלה)"
        },
        {
          "s": 11,
          "text": "וברכת כהנים היא ציווי"
        },
        {
          "s": 12,
          "text": "(מלמעלה למטה),"
        },
        {
          "s": 13,
          "text": "ואעפ\"כ ע\"י התפלה מגיעים לברכת כהנים,"
        },
        {
          "s": 14,
          "text": "עד\"ז הוא בתורה ותפלה,"
        },
        {
          "s": 15,
          "text": "דהגם שההמשכה דיגמה\"ר שלמעלה מהשתלשלות שע\"י לימוד התורה"
        },
        {
          "s": 16,
          "text": "(מצד עצמה)"
        },
        {
          "s": 17,
          "text": "היא למטה מההמשכה דיגמה\"ר שע\"י תפלה"
        },
        {
          "s": 18,
          "text": "(כנ\"ל סעיף ח),"
        },
        {
          "s": 19,
          "text": "מ\"מ,"
        },
        {
          "s": 20,
          "text": "ע\"י לימוד התורה נמשכת"
        },
        {
          "s": 21,
          "text": "(אח\"כ)"
        },
        {
          "s": 22,
          "text": "גם ההמשכה שע\"י תפלה שלמעלה מההמשכה דיגמה\"ר דתורה."
        }
      ]
    },
    {
      "v": 26,
      "items": [
        {
          "s": 0,
          "text": "ויש להוסיף,"
        },
        {
          "s": 1,
          "text": "שגם לימוד זה הוא באופן דק\"ו."
        },
        {
          "s": 2,
          "text": "דתפלה היא מלמטה למעלה וברכת כהנים היא מלמעלה למטה,"
        },
        {
          "s": 3,
          "text": "ואעפ\"כ ע\"י תפלה מגיעים לברכת כהנים,"
        },
        {
          "s": 4,
          "text": "הרי בנוגע תורה ותפלה,"
        },
        {
          "s": 5,
          "text": "שגם ההמשכה דתורה"
        },
        {
          "s": 6,
          "text": "(מצד עצמה)"
        },
        {
          "s": 7,
          "text": "היא יגמה\"ר שלמעלה מהשתלשלות ורק שהמשכה זו היא למטה מההמשכה דתפלה,"
        },
        {
          "s": 8,
          "text": "זה שע\"י התורה נמשכת גם ההמשכה דתפלה,"
        },
        {
          "s": 9,
          "text": "הוא במכש\"כ וק\"ו."
        },
        {
          "s": 10,
          "text": "ויש לומר,"
        },
        {
          "s": 11,
          "text": "דע\"י שתורה היא תורתו של האדם העוסק בתורה שהוא בעל הבית כביכול על התורה,"
        },
        {
          "s": 12,
          "text": "עי\"ז הוא נעשה בעה\"ב גם על דרגת ההמשכה דתפלה שנמשכת בתורה."
        },
        {
          "s": 13,
          "text": "וזהו שהלימוד דתורה ותפלה הוא במדת קל וחומר,"
        },
        {
          "s": 14,
          "text": "כי ההמשכה בתפלה שע\"י תורה יש לה יתרון לגבי ההמשכה דתפלה מצד עצמה."
        }
      ]
    }
  ]
}