{
  "globalIndex": 36,
  "owner": 36,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913877_theRebbe_326__p002",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913877_theRebbe_326__p002",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518913877_theRebbe_326",
  "title": "מאמר יו\"ט של ר\"ה תשמ\"ג",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ובזה מבארים מ\"ש14"
        },
        {
          "s": 1,
          "text": "תקעו בחודש שופר,"
        },
        {
          "s": 2,
          "text": "שידוע דיוק הבעש\"ט בזה15,"
        },
        {
          "s": 3,
          "text": "שלכאורה הול\"ל תקעו שופר בחודש,"
        },
        {
          "s": 4,
          "text": "ומבאר בזה,"
        },
        {
          "s": 5,
          "text": "דמ\"ש תקעו בחודש"
        },
        {
          "s": 6,
          "text": "(בחודש בסמיכות לתקעו)"
        },
        {
          "s": 7,
          "text": "הוא,"
        },
        {
          "s": 8,
          "text": "כי בחודש קאי על תקעו,"
        },
        {
          "s": 9,
          "text": "דבכל שנה צ\"ל התקיעות באופן חדש."
        },
        {
          "s": 10,
          "text": "והטעם על זה,"
        },
        {
          "s": 11,
          "text": "כי בכל שנה מתחדש בחינת השופר."
        },
        {
          "s": 12,
          "text": "ומכיון שכל הענינים שלמעלה נעשים ע\"י עבודת בנ\"י,"
        },
        {
          "s": 13,
          "text": "כתורת הרב המגיד16"
        },
        {
          "s": 14,
          "text": "בפירוש המשנה17"
        },
        {
          "s": 15,
          "text": "דע מה למעלה ממך דכל מה שלמעלה הכל הוא ממך,"
        },
        {
          "s": 16,
          "text": "לכן צ\"ל התקיעת שופר דישראל באופן חדש בכדי שעי\"ז יופעל למעלה ענין חדש."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה כמו שהוא במצות תקיעת שופר דראש השנה שבכל שנה שהוא באופן חדש,"
        },
        {
          "s": 2,
          "text": "עד\"ז הוא בכל המצוות,"
        },
        {
          "s": 3,
          "text": "כמארז\"ל18"
        },
        {
          "s": 4,
          "text": "בכל יום יהיו בעיניך כחדשים,"
        },
        {
          "s": 5,
          "text": "ויתירה מזו חדשים ממש19."
        },
        {
          "s": 6,
          "text": "אלא שבתקיעת שופר,"
        },
        {
          "s": 7,
          "text": "מכיון שהיא מצוה כללית על כל השנה20,"
        },
        {
          "s": 8,
          "text": "כידוע21"
        },
        {
          "s": 9,
          "text": "הטעם על מה שנקרא בשם ראש השנה"
        },
        {
          "s": 10,
          "text": "(ולא תחלת השנה)"
        },
        {
          "s": 11,
          "text": "לפי שהוא הראש הכולל כל ימי השנה,"
        },
        {
          "s": 12,
          "text": "ענין זה הוא ביתר שאת."
        },
        {
          "s": 13,
          "text": "ויש לומר,"
        },
        {
          "s": 14,
          "text": "דענין זה"
        },
        {
          "s": 15,
          "text": "(החידוש שבתקיעת שופר)"
        },
        {
          "s": 16,
          "text": "הוא השרש שממנו נמשך שגם המצוות דכל השנה יהיו חדשים."
        },
        {
          "s": 17,
          "text": "דהנה מצות תקיעת שופר בראש השנה ענינה הוא שתמליכוני עליכם22,"
        },
        {
          "s": 18,
          "text": "ומכיון דאופן המצוות הוא לפי האופן דתמליכוני עליכם,"
        },
        {
          "s": 19,
          "text": "כמובן ממארז\"ל23"
        },
        {
          "s": 20,
          "text": "קבלו מלכותי תחלה ואח\"כ אגזור עליכם גזירות,"
        },
        {
          "s": 21,
          "text": "לכן ע\"י שתקיעת שופר הוא באופן חדש נעשה כן בכל המצוות."
        },
        {
          "s": 22,
          "text": "דע\"י תקעו בחודש נעשה התחדשות כביכול במדת מלכותו ית',"
        },
        {
          "s": 23,
          "text": "בזה שהוא ית' מלך על ישראל"
        },
        {
          "s": 24,
          "text": "(תמליכוני עליכם),"
        },
        {
          "s": 25,
          "text": "ועי\"ז גם במלכותו על כל העולמות"
        },
        {
          "s": 26,
          "text": "[דגם זה נעשה ע\"י ובשביל ישראל,"
        },
        {
          "s": 27,
          "text": "שהקב\"ה ממלא את בקשת ישראל מלוך על העולם כולו בכבודך24,"
        },
        {
          "s": 28,
          "text": "שבזה"
        },
        {
          "s": 29,
          "text": "(ב\"העולם כולו\")"
        },
        {
          "s": 30,
          "text": "נכללים כל העולמות כולם],"
        },
        {
          "s": 31,
          "text": "שבכל ראש השנה נמשך חיות חדש בכל סדר ההשתלשלות,"
        },
        {
          "s": 32,
          "text": "חיות חדש שלא הי' עדיין מעולם,"
        },
        {
          "s": 33,
          "text": "כמ\"ש אדמו\"ר הזקן באגה\"ק25,"
        },
        {
          "s": 34,
          "text": "וחיות זה נמשך אח\"כ גם בכל ימי השנה,"
        },
        {
          "s": 35,
          "text": "על ידי י\"ב ראשי חדשים,"
        },
        {
          "s": 36,
          "text": "כמבואר בארוכה בספר עטרת ראש לאדמו\"ר האמצעי26."
        },
        {
          "s": 37,
          "text": "ועד\"ז הוא גם במצוות,"
        },
        {
          "s": 38,
          "text": "דענין החידוש שבמצוות"
        },
        {
          "s": 39,
          "text": "(בכל יום כו' חדשים)"
        },
        {
          "s": 40,
          "text": "במשך כל השנה,"
        },
        {
          "s": 41,
          "text": "נמשך הוא מהחידוש דתקיעת שופר שבראש השנה."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ובזה יובן27"
        },
        {
          "s": 2,
          "text": "שבראש השנה שחל בשבת אין תוקעין במדינה,"
        },
        {
          "s": 3,
          "text": "כי מה שצריך לתקוע בשופר בראש השנה הוא"
        },
        {
          "s": 4,
          "text": "(כנ\"ל)"
        },
        {
          "s": 5,
          "text": "בכדי לפעול עי\"ז השופר שלמעלה,"
        },
        {
          "s": 6,
          "text": "ובשבת יש בחי' זו"
        },
        {
          "s": 7,
          "text": "(שופר)"
        },
        {
          "s": 8,
          "text": "בלי עבודת האדם28."
        },
        {
          "s": 9,
          "text": "דהנה ידוע,"
        },
        {
          "s": 10,
          "text": "דביו\"ט אומרים מקדש ישראל והזמנים שישראל אינהו דקדשינהו לזמנים29,"
        },
        {
          "s": 11,
          "text": "משא\"כ שבת היא מקדשא וקיימא,"
        },
        {
          "s": 12,
          "text": "ואינה תלוי' בישראל שיקדשוה30."
        },
        {
          "s": 13,
          "text": "ולכן יש בשבת ריבוי ענינים שהם מן המוכן,"
        },
        {
          "s": 14,
          "text": "ומהם כמה באופן דשלימות,"
        },
        {
          "s": 15,
          "text": "גם בלי עבודת האדם."
        },
        {
          "s": 16,
          "text": "והנה כתיב31"
        },
        {
          "s": 17,
          "text": "לעשות את השבת,"
        },
        {
          "s": 18,
          "text": "דישראל עושים את השבת,"
        },
        {
          "s": 19,
          "text": "וכן כתיב32"
        },
        {
          "s": 20,
          "text": "זכור את יום השבת לקדשו,"
        },
        {
          "s": 21,
          "text": "דישראל צריכים לקדש את השבת."
        },
        {
          "s": 22,
          "text": "והענין הוא,"
        },
        {
          "s": 23,
          "text": "שבשבת יש שתי מדריגות33,"
        },
        {
          "s": 24,
          "text": "מה ששבת מקדשא וקיימא מצד עצמו,"
        },
        {
          "s": 25,
          "text": "ומה שישראל מוסיפים בו ע\"י עבודתם."
        },
        {
          "s": 26,
          "text": "דהנה שבת הו\"ע התענוג,"
        },
        {
          "s": 27,
          "text": "ואעפ\"כ אמרו34"
        },
        {
          "s": 28,
          "text": "כל המענג את השבת,"
        },
        {
          "s": 29,
          "text": "שצריכים לענג את השבת,"
        },
        {
          "s": 30,
          "text": "וכן כתיב35"
        },
        {
          "s": 31,
          "text": "וקראת לשבת עונג,"
        },
        {
          "s": 32,
          "text": "שצריך לקרוא ולהמשיך עונג בשבת,"
        },
        {
          "s": 33,
          "text": "כי ע\"י העבודה דישראל ממשיכים בשבת עונג נעלה יותר."
        },
        {
          "s": 34,
          "text": "אבל יש עונג בשבת מצד עצמו,"
        },
        {
          "s": 35,
          "text": "מצד זה ששבת מקדשא וקיימא,"
        },
        {
          "s": 36,
          "text": "והוא עונג בשלימות."
        },
        {
          "s": 37,
          "text": "דהרי כללות ענין השבת הוא שאז נעשה שלימות בכל הבריאה,"
        },
        {
          "s": 38,
          "text": "כמ\"ש36"
        },
        {
          "s": 39,
          "text": "ויכולו השמים והארץ וכל צבאם,"
        },
        {
          "s": 40,
          "text": "דויכולו הו\"ע השלימות כפירוש אדמו\"ר הצ\"צ37,"
        },
        {
          "s": 41,
          "text": "דמזה מובן שגם התענוג דשבת"
        },
        {
          "s": 42,
          "text": "(כמו שהוא מצד עצמו)"
        },
        {
          "s": 43,
          "text": "הוא בשלימות."
        },
        {
          "s": 44,
          "text": "וזהו מה שבראש השנה שחל בשבת אין הכרח כ\"כ לתקוע בשופר במדינה."
        },
        {
          "s": 45,
          "text": "דהנה שופר הוא בחינת תענוג38,"
        },
        {
          "s": 46,
          "text": "וכמו שמבאר בהמאמר39"
        },
        {
          "s": 47,
          "text": "דשופר הוא מלשון שפרו מעשיכם40"
        },
        {
          "s": 48,
          "text": "ומלשון הנותן אמרי שפר41"
        },
        {
          "s": 49,
          "text": "(וכן עוד לשונות שמביא בהמאמר שם),"
        },
        {
          "s": 50,
          "text": "שענינם הוא תענוג."
        },
        {
          "s": 51,
          "text": "ומכיון שכל מה שלמעלה הכל הוא ממך,"
        },
        {
          "s": 52,
          "text": "לכן בכדי שיהי' בחינת התענוג"
        },
        {
          "s": 53,
          "text": "(שופר)"
        },
        {
          "s": 54,
          "text": "שלמעלה,"
        },
        {
          "s": 55,
          "text": "נעשה זה ע\"י תקיעת שופר דישראל."
        },
        {
          "s": 56,
          "text": "דכ\"ז הוא בראש השנה שחל בחול."
        },
        {
          "s": 57,
          "text": "משא\"כ בשבת,"
        },
        {
          "s": 58,
          "text": "ענין התענוג הוא מן המוכן"
        },
        {
          "s": 59,
          "text": "(בלי עבודת האדם),"
        },
        {
          "s": 60,
          "text": "ועד שהתענוג הוא בשלימות"
        },
        {
          "s": 61,
          "text": "(כנ\"ל),"
        },
        {
          "s": 62,
          "text": "ולכן בראש השנה שחל בשבת המצוה דתקיעת שופר אינה בתוקף כ\"כ"
        },
        {
          "s": 63,
          "text": "(עם כל השטורעם)"
        },
        {
          "s": 64,
          "text": "כמו בראש השנה שחל בחול,"
        },
        {
          "s": 65,
          "text": "ולכן היא נדחית מצד החשש דשמא יעבירנו כו'."
        }
      ]
    }
  ]
}