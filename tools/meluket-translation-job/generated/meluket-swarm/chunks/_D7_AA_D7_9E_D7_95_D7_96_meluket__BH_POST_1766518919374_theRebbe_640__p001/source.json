{
  "globalIndex": 949,
  "owner": 49,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919374_theRebbe_640__p001",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919374_theRebbe_640__p001",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919374_theRebbe_640",
  "title": "מאמר עשרה שיושבין תשמ\"ב",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד*."
        },
        {
          "s": 1,
          "text": "ט\"ו תמוז,"
        },
        {
          "s": 2,
          "text": "ה'תשמ\"ב*"
        },
        {
          "s": 3,
          "text": "*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "עשרה שיושבין ועוסקין בתורה שכינה שרוי' ביניהם1,"
        },
        {
          "s": 1,
          "text": "ומבאר כ\"ק מו\"ח אדמו\"ר בעל הגאולה במאמרו ד\"ה זה שניתן על ידו לחגיגת י\"ב תמוז הראשונה"
        },
        {
          "s": 2,
          "text": "(שנת תרפ\"ח),"
        },
        {
          "s": 3,
          "text": "דהגם שגם אחד שיושב ועוסק בתורה ממשיך גילוי אלקות,"
        },
        {
          "s": 4,
          "text": "וכהמשך מאמר המשנה ומנין אפילו חמשה כו' אפילו שלשה כו' אפילו שנים כו' אפילו אחד כו',"
        },
        {
          "s": 5,
          "text": "מ\"מ,"
        },
        {
          "s": 6,
          "text": "ההמשכה שע\"י תורה דרבים היא המשכה נעלית יותר."
        },
        {
          "s": 7,
          "text": "דכמו שבתפלה אמרו רז\"ל2"
        },
        {
          "s": 8,
          "text": "תפלת רבים אינה נמאסת,"
        },
        {
          "s": 9,
          "text": "כי ע\"י תפלת רבים נמשכים י\"ג מדות הרחמים שלמעלה מהשתלשלות,"
        },
        {
          "s": 10,
          "text": "ויתירה מזו3"
        },
        {
          "s": 11,
          "text": "דההמשכה מלמעלה שע\"י תפלת רבים היא לא לפי ערך האתערותא דלתתא שלהם"
        },
        {
          "s": 12,
          "text": "(גם לא לפי ערך האתעדל\"ת דרבים),"
        },
        {
          "s": 13,
          "text": "כמו\"כ הוא בתורה,"
        },
        {
          "s": 14,
          "text": "שע\"י לימוד התורה דרבים הוא המשכת י\"ג מדות הרחמים שלמעלה מהשתלשלות"
        },
        {
          "s": 15,
          "text": "[דהגם שההמשכה די\"ג מדות הרחמים ע\"י עסק התורה הוא מצד מעלת התורה,"
        },
        {
          "s": 16,
          "text": "די\"ג המדות שהתורה נדרשת בהן הם כנגד י\"ג מדות הרחמים."
        },
        {
          "s": 17,
          "text": "דמזה מובן,"
        },
        {
          "s": 18,
          "text": "שההמשכה די\"ג מדות הרחמים היא גם כשאחד יושב ועוסק בתורה,"
        },
        {
          "s": 19,
          "text": "מ\"מ המשכת י\"ג מדות הרחמים ע\"י עסק התורה היא בעיקר ע\"י לימוד תורה ברבים דוקא,"
        },
        {
          "s": 20,
          "text": "היינו שהדרגא די\"ג מדות הרחמים שנמשכת ע\"י עסק התורה ברבים היא דרגא נעלית יותר],"
        },
        {
          "s": 21,
          "text": "ויתירה מזו,"
        },
        {
          "s": 22,
          "text": "שההמשכה שע\"י לימוד התורה דרבים היא לא לפי ערך הלימוד דהרבים."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "שהדמיון דתורה לתפלה,"
        },
        {
          "s": 3,
          "text": "מרומז גם במאמר המשנה הנ\"ל ומנין אפילו אחד שנאמר4"
        },
        {
          "s": 4,
          "text": "בכל המקום אשר אזכיר את שמי אבוא אליך וברכתיך,"
        },
        {
          "s": 5,
          "text": "דבכל המקום גו' קאי על בית המקדש"
        },
        {
          "s": 6,
          "text": "[מקום שהשכינה באה שם,"
        },
        {
          "s": 7,
          "text": "אבוא אליך],"
        },
        {
          "s": 8,
          "text": "שבו ניתן רשות להזכיר שם המפורש"
        },
        {
          "s": 9,
          "text": "[אזכיר את שמי]5,"
        },
        {
          "s": 10,
          "text": "ובית המקדש שייך לעמוד העבודה,"
        },
        {
          "s": 11,
          "text": "קרבנות6"
        },
        {
          "s": 12,
          "text": "ותפלה7"
        },
        {
          "s": 13,
          "text": "[ולהוסיף,"
        },
        {
          "s": 14,
          "text": "שגם ברכת כהנים שבה היו מזכירים בבית המקדש את השם ככתבו5,"
        },
        {
          "s": 15,
          "text": "היתה אחרי הקרבת תמיד של שחר8"
        },
        {
          "s": 16,
          "text": "(ההתחלה דכל הקרבנות),"
        },
        {
          "s": 17,
          "text": "וגם עכשיו קבעו חכמים ברכת כהנים בתפלה9,"
        },
        {
          "s": 18,
          "text": "ובתפלה עצמה – בברכת עבודה10]."
        },
        {
          "s": 19,
          "text": "ובמשנה מביא פסוק זה"
        },
        {
          "s": 20,
          "text": "(בכל המקום אשר אזכיר את שמי אבוא אליך וברכתיך)"
        },
        {
          "s": 21,
          "text": "לענין השראת השכינה שע\"י לימוד התורה,"
        },
        {
          "s": 22,
          "text": "ומזה משמע שתורה ותפלה שייכים זל\"ז ובענין זה במיוחד."
        }
      ]
    }
  ]
}