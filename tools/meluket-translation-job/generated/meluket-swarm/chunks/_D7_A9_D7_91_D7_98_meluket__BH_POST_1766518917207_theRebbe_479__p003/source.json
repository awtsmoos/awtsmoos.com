{
  "globalIndex": 602,
  "owner": 2,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917207_theRebbe_479__p003",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917207_theRebbe_479__p003",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518917207_theRebbe_479",
  "title": "מאמר ואלה המשפטים תשמ\"א",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה הפירוש דואלה המשפטים אשר תשים לפניהם בפשטות הוא,"
        },
        {
          "s": 2,
          "text": "שהקב\"ה אמר למשה רבינו שהוא"
        },
        {
          "s": 3,
          "text": "(משה)"
        },
        {
          "s": 4,
          "text": "ישים את המשפטים לפני ישראל41."
        },
        {
          "s": 5,
          "text": "ומזה מובן גם בנוגע לכי תקנה"
        },
        {
          "s": 6,
          "text": "[דכי תקנה לשון יחיד קאי על אשר תשים,"
        },
        {
          "s": 7,
          "text": "כנ\"ל סעיף ג],"
        },
        {
          "s": 8,
          "text": "שזה קאי על משה."
        },
        {
          "s": 9,
          "text": "והענין הוא,"
        },
        {
          "s": 10,
          "text": "דאיתא בזהר42,"
        },
        {
          "s": 11,
          "text": "בכולהו אתר דשמא אדכר תרי זימני פסיק טעמא בגווייהו,"
        },
        {
          "s": 12,
          "text": "כגון אברהם אברהם כו',"
        },
        {
          "s": 13,
          "text": "חוץ ממשה משה דלא פסיק טעמא בגווייהו."
        },
        {
          "s": 14,
          "text": "ומבואר בחסידות43,"
        },
        {
          "s": 15,
          "text": "דאברהם,"
        },
        {
          "s": 16,
          "text": "ע\"י שירדה נשמתו למטה,"
        },
        {
          "s": 17,
          "text": "נעשה בה שינוי לגבי שרשה שבאצילות44,"
        },
        {
          "s": 18,
          "text": "משא\"כ במשה,"
        },
        {
          "s": 19,
          "text": "גם בהיותו למטה האיר בגילוי מקורו כמו שהוא באצילות,"
        },
        {
          "s": 20,
          "text": "ועד שאין מחיצה והפסק ביניהם,"
        },
        {
          "s": 21,
          "text": "לא פסיק טעמא."
        },
        {
          "s": 22,
          "text": "והטעם על זה שגם בהיותו למטה הי' כמו שהוא באצילות,"
        },
        {
          "s": 23,
          "text": "הוא,"
        },
        {
          "s": 24,
          "text": "כי השרש דנשמת משה הוא מבחינת העיגולים שלמעלה מהשתלשלות,"
        },
        {
          "s": 25,
          "text": "ולגבי למעלה מהשתלשלות,"
        },
        {
          "s": 26,
          "text": "אצילות ועשי' הם בשוה45."
        },
        {
          "s": 27,
          "text": "וזהו שלמשה נאמר אשר תשים לפניהם כי תקנה,"
        },
        {
          "s": 28,
          "text": "כי החיבור דב' הדרגות שבתורה"
        },
        {
          "s": 29,
          "text": "[כמו שנתלבשה בשכל האדם"
        },
        {
          "s": 30,
          "text": "(תשים לפניהם)"
        },
        {
          "s": 31,
          "text": "וכמו שהיא תורתך שבאצילות"
        },
        {
          "s": 32,
          "text": "(קנין)]"
        },
        {
          "s": 33,
          "text": "הוא ע\"י הגילוי דלמעלה מהשתלשלות שנמשך ע\"י משה."
        },
        {
          "s": 34,
          "text": "וכמו שנתבאר לעיל"
        },
        {
          "s": 35,
          "text": "(סעיף ג)"
        },
        {
          "s": 36,
          "text": "שהחיבור דתורתו"
        },
        {
          "s": 37,
          "text": "(של האדם)"
        },
        {
          "s": 38,
          "text": "עם תורת הוי',"
        },
        {
          "s": 39,
          "text": "הוא ע\"י גילוי אוא\"ס."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה פירוש הנ\"ל בכי תקנה,"
        },
        {
          "s": 2,
          "text": "שקאי על אשר תשים לפניהם,"
        },
        {
          "s": 3,
          "text": "יש לקשר עם הפירוש הפשוט דכי תקנה קאי אלאח\"ז,"
        },
        {
          "s": 4,
          "text": "כי תקנה עבד,"
        },
        {
          "s": 5,
          "text": "כי כשלימוד התורה שלו היא באופן דכי תקנה,"
        },
        {
          "s": 6,
          "text": "שנרגש אצלו שהתורה שלומד היא תורת הוי',"
        },
        {
          "s": 7,
          "text": "הלימוד שלו הוא בתכלית הביטול,"
        },
        {
          "s": 8,
          "text": "בדוגמת ביטול העבד להאדון."
        },
        {
          "s": 9,
          "text": "דהגם שענין הלימוד הוא"
        },
        {
          "s": 10,
          "text": "(לא שהאדם יבטל את שכלו להתורה,"
        },
        {
          "s": 11,
          "text": "אלא אדרבה)"
        },
        {
          "s": 12,
          "text": "שיבין את התורה בהשכל שלו,"
        },
        {
          "s": 13,
          "text": "שענין זה קשור"
        },
        {
          "s": 14,
          "text": "(לכאורה)"
        },
        {
          "s": 15,
          "text": "עם המציאות שלו,"
        },
        {
          "s": 16,
          "text": "ועאכו\"כ כשהלימוד שלו הוא באופן שהתורה היא תורתו"
        },
        {
          "s": 17,
          "text": "(של האדם),"
        },
        {
          "s": 18,
          "text": "מ\"מ,"
        },
        {
          "s": 19,
          "text": "ע\"י שנרגש אצלו שהתורה"
        },
        {
          "s": 20,
          "text": "(גם לאחרי שירדה למטה ונתלבשה בשכל אנושי)"
        },
        {
          "s": 21,
          "text": "היא תורת הוי',"
        },
        {
          "s": 22,
          "text": "חכמתו של הקב\"ה שלמעלה משכל הנבראים,"
        },
        {
          "s": 23,
          "text": "[וזה שהאדם מבין את התורה בהשכל שלו הוא מפני שהקב\"ה אינו מוגבל בשום הגבלות"
        },
        {
          "s": 24,
          "text": "(גם לא בהגדר דבל\"ג)"
        },
        {
          "s": 25,
          "text": "ולכן ביכלתו ית' לחבר ההפכים דבל\"ג וגבול46,"
        },
        {
          "s": 26,
          "text": "ששכל האדם"
        },
        {
          "s": 27,
          "text": "(המוגבל)"
        },
        {
          "s": 28,
          "text": "ישיג חכמתו של הקב\"ה"
        },
        {
          "s": 29,
          "text": "(הבלתי מוגבל)],"
        },
        {
          "s": 30,
          "text": "זה שהוא מבין את התורה בהשכל שלו אינו סותר לענין הביטול,"
        },
        {
          "s": 31,
          "text": "כי זה שהוא מבין את התורה בהשכל שלו"
        },
        {
          "s": 32,
          "text": "[וגם זה שהתורה דילי' היא]"
        },
        {
          "s": 33,
          "text": "אינו מצד המציאות שלו אלא מצד זה שהקב\"ה הוא כל יכול."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יובן לשון חז\"ל47"
        },
        {
          "s": 2,
          "text": "עולה של תורה,"
        },
        {
          "s": 3,
          "text": "דלכאורה,"
        },
        {
          "s": 4,
          "text": "כיון שמצות תלמוד תורה היא"
        },
        {
          "s": 5,
          "text": "(לא שהאדם יבטל את שכלו להתורה,"
        },
        {
          "s": 6,
          "text": "אלא אדרבה)"
        },
        {
          "s": 7,
          "text": "שיבין את התורה בהשכל שלו דוקא"
        },
        {
          "s": 8,
          "text": "[וגם הפס\"ד דהאדם העוסק בתורה צריך להיות כפי הבנתו דהאדם,"
        },
        {
          "s": 9,
          "text": "דתורה לא בשמים היא וקוב\"ה קא חייך ואמר נצחוני בני נצחוני48],"
        },
        {
          "s": 10,
          "text": "מהו\"ע עולה של תורה,"
        },
        {
          "s": 11,
          "text": "דעול הו\"ע הביטול."
        },
        {
          "s": 12,
          "text": "והביאור בזה הוא"
        },
        {
          "s": 13,
          "text": "(כנ\"ל),"
        },
        {
          "s": 14,
          "text": "דע\"י הידיעה וההרגש שהתורה היא תורת הוי'"
        },
        {
          "s": 15,
          "text": "[וזה שהיא ניתנה לרשותו של האדם,"
        },
        {
          "s": 16,
          "text": "נצחוני בני נצחוני,"
        },
        {
          "s": 17,
          "text": "הוא מפני שהוא ית' הוא כל יכול,"
        },
        {
          "s": 18,
          "text": "ולכן ביכלתו ית' לתת את תורתו"
        },
        {
          "s": 19,
          "text": "(תורת הוי')"
        },
        {
          "s": 20,
          "text": "לרשותו של האדם],"
        },
        {
          "s": 21,
          "text": "גם זה שהוא מבין את התורה בהשכל שלו הוא באופן דעולה של תורה,"
        },
        {
          "s": 22,
          "text": "שהתורה היא האדון שלו והוא בטל להתורה כעבד שמוטל עליו עול האדון."
        },
        {
          "s": 23,
          "text": "וזה שהתורה ניתנה לרשותו"
        },
        {
          "s": 24,
          "text": "(נצחוני בני נצחוני),"
        },
        {
          "s": 25,
          "text": "הוא מפני שכן הוא רצון ה\"אדון\","
        },
        {
          "s": 26,
          "text": "נותן התורה."
        }
      ]
    }
  ]
}