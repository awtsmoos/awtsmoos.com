{
  "globalIndex": 783,
  "owner": 33,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918408_theRebbe_266__p002",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918408_theRebbe_266__p002",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918408_theRebbe_266",
  "title": "מאמר ונקדשתי תשכ\"ה",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "וממשיך ב"
        },
        {
          "s": 2,
          "text": "(הביאור ל)"
        },
        {
          "s": 3,
          "text": "המאמר12,"
        },
        {
          "s": 4,
          "text": "דזהו מה דאיתא במדרש13"
        },
        {
          "s": 5,
          "text": "(בענין ג' פעמים קדוש),"
        },
        {
          "s": 6,
          "text": "משל לבני מדינה שעשו שלש עטרות למלך,"
        },
        {
          "s": 7,
          "text": "מה עשה המלך,"
        },
        {
          "s": 8,
          "text": "הניח בראשו אחת ושתים בראש בניו,"
        },
        {
          "s": 9,
          "text": "כך בכל יום העליונים מכתירים לפני הקב\"ה שלש קדושות,"
        },
        {
          "s": 10,
          "text": "מה הקב\"ה עושה,"
        },
        {
          "s": 11,
          "text": "נותן בראשו אחת ושתים בראשן של ישראל,"
        },
        {
          "s": 12,
          "text": "הה\"ד14"
        },
        {
          "s": 13,
          "text": "כי קדוש אני והתקדישתם והייתם קדושים."
        },
        {
          "s": 14,
          "text": "היינו דכי קדוש אני הוא העטרה שנותן בראשו,"
        },
        {
          "s": 15,
          "text": "והתקדישתם והייתם קדושים הם שתי העטרות שנתן בראשן של ישראל."
        },
        {
          "s": 16,
          "text": "ולהעיר,"
        },
        {
          "s": 17,
          "text": "דבמדרש שלפנינו איתא הה\"ד דבר אל כל עדת בני ישראל קדושים תהיו והתקדישתם והייתם קדושים,"
        },
        {
          "s": 18,
          "text": "דלכאורה מזה משמע דשתי העטרות שנתן בראשן של ישראל הם קדושים תהיו"
        },
        {
          "s": 19,
          "text": "(שבסמיכות לכי קדוש אני)"
        },
        {
          "s": 20,
          "text": "ווהתקדישתם והייתם קדושים15"
        },
        {
          "s": 21,
          "text": "(שנחשבים שניהם לעטרה אחת)."
        },
        {
          "s": 22,
          "text": "אבל בלקו\"ת מפרש,"
        },
        {
          "s": 23,
          "text": "דשתי העטרות שנתן בראשן של ישראל הם והתקדישתם והייתם קדושים,"
        },
        {
          "s": 24,
          "text": "וקדושים תהיו"
        },
        {
          "s": 25,
          "text": "(שבסמיכות לכי קדוש אני)"
        },
        {
          "s": 26,
          "text": "אינה נמנית בהעטרות."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ויש לבאר זה ע\"פ מה דאיתא במדרש שם16,"
        },
        {
          "s": 2,
          "text": "קדושים תהיו יכול כמוני תלמוד לומר כי קדוש אני,"
        },
        {
          "s": 3,
          "text": "קדושתי למעלה מקדושתכם."
        },
        {
          "s": 4,
          "text": "וכתב הצ\"צ"
        },
        {
          "s": 5,
          "text": "(באוה\"ת ר\"פ קדושים17)"
        },
        {
          "s": 6,
          "text": "שזה תמוה."
        },
        {
          "s": 7,
          "text": "והכוונה בזה"
        },
        {
          "s": 8,
          "text": "(בפשטות)"
        },
        {
          "s": 9,
          "text": "היא,"
        },
        {
          "s": 10,
          "text": "כי איך שייך אפילו קס\"ד שישראל יהיו כמוני."
        },
        {
          "s": 11,
          "text": "ובלקו\"ת פ' נצבים18"
        },
        {
          "s": 12,
          "text": "מבואר,"
        },
        {
          "s": 13,
          "text": "דקדושתכם היא הקדושה שנמשכת ע\"י אתערותא דלתתא דמעשה המצוות,"
        },
        {
          "s": 14,
          "text": "וקדושתי שלמעלה מקדושתכם היא קדושה נעלית ביותר שאין אתערותא דלתתא דמעשה המצוות מגעת שם,"
        },
        {
          "s": 15,
          "text": "ונמשכת ע\"י התשובה."
        },
        {
          "s": 16,
          "text": "וזהו מה שבעלי תשובה הם למעלה מצדיקים גמורים19,"
        },
        {
          "s": 17,
          "text": "כי ע\"י התשובה הם ממשיכים מבחינת קדושתי שלמעלה מקדושתכם,"
        },
        {
          "s": 18,
          "text": "כמבואר בלקו\"ת שם."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ולכאורה צריך לומר,"
        },
        {
          "s": 1,
          "text": "דהמעלה שבבעלי תשובה על צדיקים גמורים,"
        },
        {
          "s": 2,
          "text": "אף שגם בצדיקים ישנה העבודה דג' פעמים קדוש וקדוש הא' הוא קדוש אני"
        },
        {
          "s": 3,
          "text": "(קדושתי שלמעלה מקדושתכם),"
        },
        {
          "s": 4,
          "text": "הוא,"
        },
        {
          "s": 5,
          "text": "שהגילוי דקדוש הא' בצדיקים הוא באופן דהעלאה למעלה,"
        },
        {
          "s": 6,
          "text": "שמשתוקקים לצאת ממציאותם וליכלל בקדושתו ית'"
        },
        {
          "s": 7,
          "text": "(וזה שנמשך להם כמו שהם למטה הוא רק קדוש הב' והג'),"
        },
        {
          "s": 8,
          "text": "ובבעלי תשובה,"
        },
        {
          "s": 9,
          "text": "גם קדוש הא' הוא באופן דהמשכה למטה."
        },
        {
          "s": 10,
          "text": "וצריך להבין,"
        },
        {
          "s": 11,
          "text": "איך אפשר שתומשך הקדושה דקדוש אני למטה20."
        },
        {
          "s": 12,
          "text": "וביותר אינו מובן,"
        },
        {
          "s": 13,
          "text": "דבאוה\"ת איתא,"
        },
        {
          "s": 14,
          "text": "שאפילו קס\"ד שיהיו כמוני הוא תמוה,"
        },
        {
          "s": 15,
          "text": "ובלקו\"ת איתא"
        },
        {
          "s": 16,
          "text": "(גם להמסקנא),"
        },
        {
          "s": 17,
          "text": "שע\"י התשובה ממשיכים הקדושה דקדוש אני,"
        },
        {
          "s": 18,
          "text": "דלכאורה הם סברות הפוכות."
        }
      ]
    }
  ]
}