{
  "globalIndex": 1000,
  "owner": 0,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919710_theRebbe_549__p005",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919710_theRebbe_549__p005",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919710_theRebbe_549",
  "title": "מאמר ציון במשפט תפדה תשל\"ו",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "והעצה לזה הוא זכור הוי',"
        },
        {
          "s": 1,
          "text": "שהעבודה תהי' באופן דזכרון,"
        },
        {
          "s": 2,
          "text": "למעלה מהגבלה"
        },
        {
          "s": 3,
          "text": "(בכל יום יהיו בעיניך כחדשים),"
        },
        {
          "s": 4,
          "text": "שעי\"ז מאיר הגילוי דהוי',"
        },
        {
          "s": 5,
          "text": "אור הסובב גם שלמעלה מהתלבשות."
        },
        {
          "s": 6,
          "text": "ויש לקשר זה עם פירוש הבעש\"ט עה\"פ55,"
        },
        {
          "s": 7,
          "text": "דמה הי' לנו הוא גילוי מ\"ה דהנשמה,"
        },
        {
          "s": 8,
          "text": "כי מ\"ה דהנשמה הוא עצם הנשמה שלמעלה מהתלבשות,"
        },
        {
          "s": 9,
          "text": "שקשורה עם הוי' שלמעלה מהתלבשות בעולם,"
        },
        {
          "s": 10,
          "text": "ועי\"ז באים להעבודה דזכור,"
        },
        {
          "s": 11,
          "text": "עבודה שלמעלה מהגבלה."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "וזהו56 ציון במשפט תפדה ושבי' בצדקה,"
        },
        {
          "s": 2,
          "text": "שהם ב' דרגות בנשמה."
        },
        {
          "s": 3,
          "text": "ציון היא דרגת הנשמה שלמעלה מהתלבשות בגוף"
        },
        {
          "s": 4,
          "text": "(מ\"ה דנשמה),"
        },
        {
          "s": 5,
          "text": "דבחינה זו אין שייך שתהי' בשבי' בנפש הבהמית,"
        },
        {
          "s": 6,
          "text": "שהמרירות והשמחה שלה יהיו מעניני עוה\"ז,"
        },
        {
          "s": 7,
          "text": "ורק שהיא בגלות,"
        },
        {
          "s": 8,
          "text": "שאינה מאירה בגילוי"
        },
        {
          "s": 9,
          "text": "(בהנשמה שבגוף)."
        },
        {
          "s": 10,
          "text": "ושבי' היא דרגת הנשמה שבהתלבשות,"
        },
        {
          "s": 11,
          "text": "דבחינה זו שייך שתהי' בשבי' בנה\"ב,"
        },
        {
          "s": 12,
          "text": "שהמרירות והשמחה שלה הם מעניני עוה\"ז."
        },
        {
          "s": 13,
          "text": "ויש לומר,"
        },
        {
          "s": 14,
          "text": "שהוא ע\"ד המבואר57"
        },
        {
          "s": 15,
          "text": "בפירוש הכתוב58"
        },
        {
          "s": 16,
          "text": "ותאמר ציון עזבני הוי' ואד' שכחני,"
        },
        {
          "s": 17,
          "text": "דשכחה הוא שיש דבר המשכח ולא רק העדר הזכרון."
        },
        {
          "s": 18,
          "text": "וזהו עזבני הוי' ואד' שכחני,"
        },
        {
          "s": 19,
          "text": "דבהוי' שהוא אור הסובב שלמעלה מהתלבשות בעולמות אין שייך ענין השכחה ח\"ו ורק ענין העזיבה,"
        },
        {
          "s": 20,
          "text": "והוא שבגלותא קוב\"ה סליק לעילא ואינו מאיר בגילוי למטה"
        },
        {
          "s": 21,
          "text": "(ע\"ד הגלות בבחינת ציון,"
        },
        {
          "s": 22,
          "text": "שאינה מאירה בהנשמה שבגוף59),"
        },
        {
          "s": 23,
          "text": "ואד'"
        },
        {
          "s": 24,
          "text": "(מלכות60)"
        },
        {
          "s": 25,
          "text": "שבכללות הוא אור הממלא,"
        },
        {
          "s": 26,
          "text": "שייך בו גם ענין השכחה,"
        },
        {
          "s": 27,
          "text": "ירידת המלכות להחיות הקליפות"
        },
        {
          "s": 28,
          "text": "(ע\"ד השבי' בדרגת הנשמה שבבחינת התלבשות59,"
        },
        {
          "s": 29,
          "text": "שהמרירות והשמחה שלה יכולים להיות מעניני עוה\"ז)."
        },
        {
          "s": 30,
          "text": "וזהו56"
        },
        {
          "s": 31,
          "text": "ציון במשפט תפדה ושבי' בצדקה,"
        },
        {
          "s": 32,
          "text": "שהפדי' דבחינת ציון מהדברים המכסים עלי' ומונעים הגילוי שלה בהנשמה שבגוף,"
        },
        {
          "s": 33,
          "text": "הוא ע\"י התורה"
        },
        {
          "s": 34,
          "text": "[משפט הוא הלכות התורה,"
        },
        {
          "s": 35,
          "text": "כמו שמתרגם ע\"פ61"
        },
        {
          "s": 36,
          "text": "כמשפט הראשון כהלכתא קדמייתא],"
        },
        {
          "s": 37,
          "text": "כי התורה היא אור"
        },
        {
          "s": 38,
          "text": "(תורה אור62)"
        },
        {
          "s": 39,
          "text": "ולכן על ידה נעשה הגילוי דבחינת ציון."
        },
        {
          "s": 40,
          "text": "והפדי' דדרגת הנשמה שבהתלבשות שהיא בשבי' בנה\"ב"
        },
        {
          "s": 41,
          "text": "(ושבי')"
        },
        {
          "s": 42,
          "text": "הוא בצדקה,"
        },
        {
          "s": 43,
          "text": "היינו כללות המצוות שנקראו צדקה63,"
        },
        {
          "s": 44,
          "text": "ובפרט ע\"י צדקה כפשוטה64,"
        },
        {
          "s": 45,
          "text": "דבצדקה כתיב65"
        },
        {
          "s": 46,
          "text": "רחבה מצותך מאד,"
        },
        {
          "s": 47,
          "text": "שע\"י מצות צדקה נמשך הגילוי דאור הבל\"ג66,"
        },
        {
          "s": 48,
          "text": "והגילוי הוא גם בהנשמה המלובשת בגוף67,"
        },
        {
          "s": 49,
          "text": "[ועד\"ז למעלה – בספירת המלכות שנקראת בשם שכינה על שם68"
        },
        {
          "s": 50,
          "text": "שמתלבשת בתחתונים להחיותם67],"
        },
        {
          "s": 51,
          "text": "ובאופן דהתלבשות."
        },
        {
          "s": 52,
          "text": "ועי\"ז נמשך גם הגילוי דעצם הנשמה ממש,"
        },
        {
          "s": 53,
          "text": "שלמעלה גם מדרגת הנשמה שלמעלה מהתלבשות,"
        },
        {
          "s": 54,
          "text": "וע\"ד שנת\"ל"
        },
        {
          "s": 55,
          "text": "(סעיף ג)"
        },
        {
          "s": 56,
          "text": "שהיחוד דסובב וממלא הוא ע\"י גילוי כח העצמות."
        },
        {
          "s": 57,
          "text": "וכיון שגם את העולם נתן בלבם של בני האדם69,"
        },
        {
          "s": 58,
          "text": "הנה עי\"ז נמשך גם בעולם,"
        },
        {
          "s": 59,
          "text": "שהגילוי דלמעלה מהטבע"
        },
        {
          "s": 60,
          "text": "(שנמשך מהסובב)"
        },
        {
          "s": 61,
          "text": "יהי' בגילוי גם בהטבע"
        },
        {
          "s": 62,
          "text": "(שנמשך מממלא),"
        },
        {
          "s": 63,
          "text": "ועי\"ז יהי' גם גילוי העצמות"
        },
        {
          "s": 64,
          "text": "(שמחבר את שניהם),"
        },
        {
          "s": 65,
          "text": "שעי\"ז תושלם הכוונה דדירה לו ית' בתחתונים70,"
        },
        {
          "s": 66,
          "text": "לו לעצמותו71."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ויהי רצון,"
        },
        {
          "s": 1,
          "text": "שבקרוב ממש תקויים ההבטחה והיעוד ציון במשפט תפדה ושבי' בצדקה,"
        },
        {
          "s": 2,
          "text": "שיעמוד72"
        },
        {
          "s": 3,
          "text": "מלך מבית דוד הוגה בתורה"
        },
        {
          "s": 4,
          "text": "(משפט)"
        },
        {
          "s": 5,
          "text": "ועוסק במצוות"
        },
        {
          "s": 6,
          "text": "(צדקה),"
        },
        {
          "s": 7,
          "text": "וילחום מלחמת ה' וינצח"
        },
        {
          "s": 8,
          "text": "[די\"ל שזה שילחום מלחמת ה' הוא ע\"י העבודה73"
        },
        {
          "s": 9,
          "text": "בדרגת הנשמה המלובשת בגוף,"
        },
        {
          "s": 10,
          "text": "שהעבודה בדרגא זו74"
        },
        {
          "s": 11,
          "text": "היא באופן דמלחמה עם נה\"ב],"
        },
        {
          "s": 12,
          "text": "ויבנה מקדש במקומו"
        },
        {
          "s": 13,
          "text": "[שעי\"ז יהי' הגילוי גם בכל העולם,"
        },
        {
          "s": 14,
          "text": "דהחלונות דביהמ\"ק היו שקופים אטומים75"
        },
        {
          "s": 15,
          "text": "שמהם אורה יוצאת לכל העולם76]"
        },
        {
          "s": 16,
          "text": "ויקבץ נדחי ישראל ויתקן את העולם77"
        },
        {
          "s": 17,
          "text": "כולו לעבוד את ה',"
        },
        {
          "s": 18,
          "text": "וכל זה – בקרוב ממש ובעגלא דידן."
        }
      ]
    }
  ]
}