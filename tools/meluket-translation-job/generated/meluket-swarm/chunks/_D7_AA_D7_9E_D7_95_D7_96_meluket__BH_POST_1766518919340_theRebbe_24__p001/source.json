{
  "globalIndex": 939,
  "owner": 39,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919340_theRebbe_24__p001",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919340_theRebbe_24__p001",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919340_theRebbe_24",
  "title": "מאמר עשרה שיושבין תשמ\"ב",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "י\"ג תמוז,"
        },
        {
          "s": 2,
          "text": "ה'תשמ\"ב*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "עשרה שיושבין ועוסקין בתורה שכינה שרוי' ביניהם כו' אפילו חמשה כו' אפילו שלשה כו' אפילו שנים כו' אפילו אחד1,"
        },
        {
          "s": 1,
          "text": "ומבאר כ\"ק מו\"ח אדמו\"ר בעל הגאולה במאמרו ד\"ה זה שניתן על ידו לחגיגת י\"ב תמוז הראשונה"
        },
        {
          "s": 2,
          "text": "(שנת תרפ\"ח)2,"
        },
        {
          "s": 3,
          "text": "דהגם3"
        },
        {
          "s": 4,
          "text": "שגם אחד שיושב ועוסק בתורה"
        },
        {
          "s": 5,
          "text": "(ומכש\"כ שנים שלשה וחמשה)"
        },
        {
          "s": 6,
          "text": "הוא ממשיך גילוי אלקות"
        },
        {
          "s": 7,
          "text": "(שכינה שרוי'4),"
        },
        {
          "s": 8,
          "text": "מ\"מ,"
        },
        {
          "s": 9,
          "text": "ההמשכה שע\"י תורה דרבים"
        },
        {
          "s": 10,
          "text": "(עשרה5)"
        },
        {
          "s": 11,
          "text": "היא המשכה נעלית יותר6."
        },
        {
          "s": 12,
          "text": "דכמו שבתפלה אמרו רז\"ל7"
        },
        {
          "s": 13,
          "text": "תפלת רבים אינה נמאסת שנאמר8"
        },
        {
          "s": 14,
          "text": "הן א-ל כביר ולא ימאס,"
        },
        {
          "s": 15,
          "text": "שהרבים בתפלתם ממשיכים י\"ג מדות הרחמים9,"
        },
        {
          "s": 16,
          "text": "כמו\"כ הוא בתורה,"
        },
        {
          "s": 17,
          "text": "שע\"י תורה דרבים נמשך גילוי אור עליון יותר."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "וביאור לשון רז\"ל תפלת רבים"
        },
        {
          "s": 1,
          "text": "[ובהמאמר אומר הלשון \"רבים\" גם בנוגע לתורה],"
        },
        {
          "s": 2,
          "text": "אף שמדבר בנוגע לעשרה"
        },
        {
          "s": 3,
          "text": "[והלשון רבים נופל גם בפחות מעשרה,"
        },
        {
          "s": 4,
          "text": "ולאידך,"
        },
        {
          "s": 5,
          "text": "גם עשרה אינם השלימות דרבים,"
        },
        {
          "s": 6,
          "text": "שהרי יש ריבוי גדול יותר10],"
        },
        {
          "s": 7,
          "text": "יש לבאר,"
        },
        {
          "s": 8,
          "text": "בהקדים,"
        },
        {
          "s": 9,
          "text": "דהטעם על שדבר שנעשה בפני עשרה מישראל הוא פרהסיא הכי גדולה"
        },
        {
          "s": 10,
          "text": "(דלא מצינו חילוק לענין פרהסיא בין עשרה ליותר מעשרה)"
        },
        {
          "s": 11,
          "text": "הוא,"
        },
        {
          "s": 12,
          "text": "כי עשרה מישראל הם11"
        },
        {
          "s": 13,
          "text": "דוגמת וכוללים העשרה סוגים דישראל"
        },
        {
          "s": 14,
          "text": "(ראשיכם שבטיכם גו' עד חוטב עציך ושואב מימיך12),"
        },
        {
          "s": 15,
          "text": "ופרסום בפני עשרה מישראל הוא כמו פרסום בכל ישראל."
        },
        {
          "s": 16,
          "text": "וזהו שעשרה מישראל נקראים בשם רבים"
        },
        {
          "s": 17,
          "text": "(סתם),"
        },
        {
          "s": 18,
          "text": "ריבוי הכי גדול שאין ריבוי גדול ממנו."
        }
      ]
    }
  ]
}