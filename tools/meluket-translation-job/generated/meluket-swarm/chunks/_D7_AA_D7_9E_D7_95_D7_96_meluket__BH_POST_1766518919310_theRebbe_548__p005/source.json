{
  "globalIndex": 937,
  "owner": 37,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919310_theRebbe_548__p005",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919310_theRebbe_548__p005",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919310_theRebbe_548",
  "title": "מאמר זה היום עשה ה' תשל\"ח",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "וממשיך במדרש בך ביראתך בך בתורתך בך בישועתך,"
        },
        {
          "s": 2,
          "text": "דהמשכת העצמות היא ע\"י היראה."
        },
        {
          "s": 3,
          "text": "וכמבואר בכ\"מ41"
        },
        {
          "s": 4,
          "text": "החילוק בין אהבה ליראה,"
        },
        {
          "s": 5,
          "text": "דע\"י האהבה,"
        },
        {
          "s": 6,
          "text": "כיון שהיא מציאות והתפשטות,"
        },
        {
          "s": 7,
          "text": "מגיעים בהגילויים דאוא\"ס"
        },
        {
          "s": 8,
          "text": "(התפשטות),"
        },
        {
          "s": 9,
          "text": "ודוקא ע\"י היראה שהיא ביטול,"
        },
        {
          "s": 10,
          "text": "ועד ביטול שמצד עצם הנשמה,"
        },
        {
          "s": 11,
          "text": "מגיעים בהעצמות."
        },
        {
          "s": 12,
          "text": "אבל,"
        },
        {
          "s": 13,
          "text": "זה שע\"י היראה מגיעים בהעצמות,"
        },
        {
          "s": 14,
          "text": "הוא בהעלם,"
        },
        {
          "s": 15,
          "text": "ובכדי שיהי' גילוי העצמות הוא ע\"י התורה,"
        },
        {
          "s": 16,
          "text": "תורה אור42."
        },
        {
          "s": 17,
          "text": "דהגם שהביטול דיראה הוא מצד עצם הנשמה,"
        },
        {
          "s": 18,
          "text": "דשרש הנשמות הוא למעלה משרש התורה43,"
        },
        {
          "s": 19,
          "text": "הרי הגילוי דכל ענין"
        },
        {
          "s": 20,
          "text": "(גם דשרש הנשמות כמו שהם מושרשים בהעצמות)"
        },
        {
          "s": 21,
          "text": "הוא ע\"י התורה."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ויש להוסיף,"
        },
        {
          "s": 1,
          "text": "דמכיון שאסתכל באורייתא וברא עלמא44,"
        },
        {
          "s": 2,
          "text": "כל ההמשכות שבעולם הם ע\"י התורה."
        },
        {
          "s": 3,
          "text": "ושני הענינים דלמעלה מהטבע"
        },
        {
          "s": 4,
          "text": "(בל\"ג)"
        },
        {
          "s": 5,
          "text": "ודטבע"
        },
        {
          "s": 6,
          "text": "(גבול)"
        },
        {
          "s": 7,
          "text": "שבעולם,"
        },
        {
          "s": 8,
          "text": "נמשכים משני הענינים דבל\"ג וגבול שבתורה."
        },
        {
          "s": 9,
          "text": "וכמבואר בכ\"מ45"
        },
        {
          "s": 10,
          "text": "עה\"פ46"
        },
        {
          "s": 11,
          "text": "עוטה אור כשלמה,"
        },
        {
          "s": 12,
          "text": "שגליא דתורה"
        },
        {
          "s": 13,
          "text": "(השלמה דתורה)"
        },
        {
          "s": 14,
          "text": "היא במדידה והגבלה,"
        },
        {
          "s": 15,
          "text": "ופנימיות התורה"
        },
        {
          "s": 16,
          "text": "(האור דתורה)"
        },
        {
          "s": 17,
          "text": "הוא בלי גבול."
        },
        {
          "s": 18,
          "text": "וע\"י היחוד דשני הענינים בתורה,"
        },
        {
          "s": 19,
          "text": "שהגליא והפנימיות הם תורה אחת,"
        },
        {
          "s": 20,
          "text": "ובפרט ע\"י עסק התורה באופן שבלימוד הנגלה נרגש אצלו בגילוי הפנימיות דתורה"
        },
        {
          "s": 21,
          "text": "(הנפלאות שבתורה),"
        },
        {
          "s": 22,
          "text": "עי\"ז נמשך בעולם החיבור דלמעלה מהטבע עם הטבע,"
        },
        {
          "s": 23,
          "text": "ובאופן שגם בהטבע יהי' נרגש בגילוי הנפלאות שלמעלה מהטבע."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "וזהו בך ביראתך בך בתורתך בך בישועתך,"
        },
        {
          "s": 1,
          "text": "שבתחילה צ\"ל ביראתך שעי\"ז ממשיכים את העצמות,"
        },
        {
          "s": 2,
          "text": "ולאח\"ז בתורתך"
        },
        {
          "s": 3,
          "text": "(תורה אור)"
        },
        {
          "s": 4,
          "text": "שעי\"ז נעשה גילוי העצמות,"
        },
        {
          "s": 5,
          "text": "ומזה נמשך להיות בך בישועתך,"
        },
        {
          "s": 6,
          "text": "דהגם שהיו במצב שהוזקקו לישועה,"
        },
        {
          "s": 7,
          "text": "וגם לאח\"ז"
        },
        {
          "s": 8,
          "text": "(כיון שנמצאים עדיין בגלות),"
        },
        {
          "s": 9,
          "text": "הישועה היא בלבושי הטבע,"
        },
        {
          "s": 10,
          "text": "מ\"מ ניכר בה בגילוי,"
        },
        {
          "s": 11,
          "text": "ובאופן דראו כל אפסי ארץ,"
        },
        {
          "s": 12,
          "text": "שהוא נס גלוי שלמעלה מהטבע."
        }
      ]
    }
  ]
}