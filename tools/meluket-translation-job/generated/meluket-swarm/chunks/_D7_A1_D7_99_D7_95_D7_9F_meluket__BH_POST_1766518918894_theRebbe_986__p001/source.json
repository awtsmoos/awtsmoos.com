{
  "globalIndex": 866,
  "owner": 16,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918894_theRebbe_986__p001",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918894_theRebbe_986__p001",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918894_theRebbe_986",
  "title": "מאמר בהעלותך את הנרות תשל\"ד",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "יום ד' פ' בהעלותך,"
        },
        {
          "s": 2,
          "text": "ט\"ו סיון ה'תשל\"ד*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "בהעלותך את הנרות אל מול פני המנורה יאירו שבעת הנרות1,"
        },
        {
          "s": 1,
          "text": "ומדייק כ\"ק מו\"ח אדמו\"ר בעל המאסר והגאולה במאמרו ד\"ה זה2,"
        },
        {
          "s": 2,
          "text": "שבתחלה אומר בהעלותך את הנרות"
        },
        {
          "s": 3,
          "text": "(נרות סתם)"
        },
        {
          "s": 4,
          "text": "ואינו מזכיר את מספרם,"
        },
        {
          "s": 5,
          "text": "ולאחרי זה אומר יאירו שבעת הנרות."
        },
        {
          "s": 6,
          "text": "וגם צריך להבין3"
        },
        {
          "s": 7,
          "text": "מ\"ש אל מול פני המנורה יאירו שבעת הנרות,"
        },
        {
          "s": 8,
          "text": "הרי פני המנורה הוא נר האמצעי4,"
        },
        {
          "s": 9,
          "text": "והול\"ל אל מול פני המנורה יאירו ששת הנרות5."
        },
        {
          "s": 10,
          "text": "ונקודת הביאור בזה6,"
        },
        {
          "s": 11,
          "text": "דהנרות שעליהם נאמר בהעלותך את הנרות,"
        },
        {
          "s": 12,
          "text": "והנרות שעליהם נאמר יאירו שבעת הנרות,"
        },
        {
          "s": 13,
          "text": "הם שני ענינים."
        },
        {
          "s": 14,
          "text": "בהעלותך את הנרות,"
        },
        {
          "s": 15,
          "text": "נרות סתם,"
        },
        {
          "s": 16,
          "text": "הם הנשמות שנק' נרות כמ\"ש7"
        },
        {
          "s": 17,
          "text": "נר הוי' נשמת אדם,"
        },
        {
          "s": 18,
          "text": "דכמו שהנר טבעו לעלות למעלה ולידבק בשרשו"
        },
        {
          "s": 19,
          "text": "(ביסוד האש הכללי שתחת גלגל8"
        },
        {
          "s": 20,
          "text": "הירח9),"
        },
        {
          "s": 21,
          "text": "כן הנשמה היא בטבע הרצוא לעלות למעלה להכלל במקור חוצבה."
        },
        {
          "s": 22,
          "text": "אלא שבנשמות דבי\"ע,"
        },
        {
          "s": 23,
          "text": "טבע הרצוא שבהם הוא בהעלם,"
        },
        {
          "s": 24,
          "text": "ועבודתו של אהרן היא לעורר ולגלות את טבע הרצוא והעלי' שלהם,"
        },
        {
          "s": 25,
          "text": "בהעלותך את הנרות,"
        },
        {
          "s": 26,
          "text": "שטבע העלי' שבהם יהי' בגילוי."
        },
        {
          "s": 27,
          "text": "ויאירו שבעת הנרות קאי על המאורות שברקיע השמים,"
        },
        {
          "s": 28,
          "text": "כדאיתא במדרש10"
        },
        {
          "s": 29,
          "text": "שהמשכן הוא שקול כנגד העולם,"
        },
        {
          "s": 30,
          "text": "דכל הענינים שהיו בבריאת העולם היו דוגמתם במשכן,"
        },
        {
          "s": 31,
          "text": "והמנורה שהיתה במשכן היא דוגמת יהי11"
        },
        {
          "s": 32,
          "text": "מאורות ברקיע השמים."
        },
        {
          "s": 33,
          "text": "ומ\"ש יאירו שבעת הנרות,"
        },
        {
          "s": 34,
          "text": "אף שבהמאמר יהי מאורות כתיב12"
        },
        {
          "s": 35,
          "text": "ויעש אלקים את שני המאורות גו',"
        },
        {
          "s": 36,
          "text": "הוא,"
        },
        {
          "s": 37,
          "text": "כי שמש וירח הם עיקרי המאורות,"
        },
        {
          "s": 38,
          "text": "אבל בפרטיות ישנם שבעה מאורות."
        },
        {
          "s": 39,
          "text": "וזהו בהעלותך את הנרות גו' יאירו שבעת הנרות,"
        },
        {
          "s": 40,
          "text": "שע\"י עבודתו של אהרן להעלות את הנרות,"
        },
        {
          "s": 41,
          "text": "שהנשמות דבי\"ע יהי' בהם הרצוא לאלקות בגילוי,"
        },
        {
          "s": 42,
          "text": "עי\"ז יאירו שבעת הנרות,"
        },
        {
          "s": 43,
          "text": "שנעשה תוספות אור בהמאמר13"
        },
        {
          "s": 44,
          "text": "יהי מאורות,"
        },
        {
          "s": 45,
          "text": "ע\"ד שרה הוסיפה על המאורות14."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה מזה שבהעלותך את הנרות לפי פשוטו קאי על נרות המנורה,"
        },
        {
          "s": 2,
          "text": "מובן,"
        },
        {
          "s": 3,
          "text": "דזה שבהעלותך את הנרות בפנימיות הענינים קאי על הנשמות הוא כי הנרות דנשמות הם הפנימיות דנרות המנורה."
        },
        {
          "s": 4,
          "text": "[דנוסף לזה שהנשמות הם נרות בכלל,"
        },
        {
          "s": 5,
          "text": "הם נרות המנורה]."
        },
        {
          "s": 6,
          "text": "וזה שבמנורה היו ז' נרות הוא מפני שהנרות דנשמות נחלקות לז' סוגים."
        },
        {
          "s": 7,
          "text": "ועפ\"ז צריך להבין טעם השינוי בלשון הכתוב,"
        },
        {
          "s": 8,
          "text": "שבנרות המאורות כתיב יאירו שבעת הנרות ובהנרות דנשמות כתיב בהעלותך את הנרות,"
        },
        {
          "s": 9,
          "text": "נרות סתם."
        }
      ]
    }
  ]
}