{
  "globalIndex": 189,
  "owner": 39,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914882_theRebbe_998__p003",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914882_theRebbe_998__p003",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518914882_theRebbe_998",
  "title": "מאמר ויהיו חיי שרה תש\"ל",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ומבואר בהמאמר,"
        },
        {
          "s": 2,
          "text": "דזה שהיסוד נקרא בשם כל הוא על שם נו\"ן שערי בינה שנמשכים בו"
        },
        {
          "s": 3,
          "text": "(כל בגימטריא נו\"ן23)."
        },
        {
          "s": 4,
          "text": "ומזה מובן,"
        },
        {
          "s": 5,
          "text": "דהיתרון בארץ"
        },
        {
          "s": 6,
          "text": "(מלכות)"
        },
        {
          "s": 7,
          "text": "ע\"י בחינת כל הוא בשני ענינים."
        },
        {
          "s": 8,
          "text": "שנמשך בה היסוד,"
        },
        {
          "s": 9,
          "text": "שהוא סיום המדות דאצילות,"
        },
        {
          "s": 10,
          "text": "ויתירה מזו,"
        },
        {
          "s": 11,
          "text": "שע\"י היסוד נמשכים בה נו\"ן שערי בינה,"
        },
        {
          "s": 12,
          "text": "מוחין שלמעלה ממדות."
        },
        {
          "s": 13,
          "text": "ויש לומר,"
        },
        {
          "s": 14,
          "text": "דשני ענינים אלה שייכים זה לזה."
        },
        {
          "s": 15,
          "text": "והענין הוא,"
        },
        {
          "s": 16,
          "text": "דמדות הם שייכים להזולת."
        },
        {
          "s": 17,
          "text": "דהגם שהמדות הם ענין שנוגע להאדם עצמו"
        },
        {
          "s": 18,
          "text": "(ולא כהדיבור שהוא גילוי להזולת),"
        },
        {
          "s": 19,
          "text": "מ\"מ,"
        },
        {
          "s": 20,
          "text": "הם בדרגת האדם כמו ששייך אל הזולת,"
        },
        {
          "s": 21,
          "text": "והמוחין הם בדרגת האדם כמו שהוא לעצמו,"
        },
        {
          "s": 22,
          "text": "מובדל מהזולת."
        },
        {
          "s": 23,
          "text": "ולכן,"
        },
        {
          "s": 24,
          "text": "כשההמשכה היא רק מבחינת המדות דז\"א שהם שייכים לזולת,"
        },
        {
          "s": 25,
          "text": "אזי,"
        },
        {
          "s": 26,
          "text": "ע\"י שהמלכות מקבלת בתוכה את המדות דז\"א נעשה בה שינוי"
        },
        {
          "s": 27,
          "text": "(כנ\"ל סעיף ג),"
        },
        {
          "s": 28,
          "text": "וזה שהמלכות מקבלת את המדות דז\"א כמו שהם"
        },
        {
          "s": 29,
          "text": "[דזהו\"ע יתרון ארץ בכל היא,"
        },
        {
          "s": 30,
          "text": "שגם בארץ מאיר הגילוי דבחינת כל כמו שהוא בעצמותו],"
        },
        {
          "s": 31,
          "text": "הוא ע\"י ששרש ההמשכה הוא מהמוחין,"
        },
        {
          "s": 32,
          "text": "דכיון שהמוחין הם למעלה משייכות לזולת"
        },
        {
          "s": 33,
          "text": "(ענין הדיבור,"
        },
        {
          "s": 34,
          "text": "מלכות),"
        },
        {
          "s": 35,
          "text": "לכן,"
        },
        {
          "s": 36,
          "text": "גם כשההמשכה באה בדיבור,"
        },
        {
          "s": 37,
          "text": "אין ביכולת הדיבור לפעול בה שינוי."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה גם המוחין שלמעלה משייכות לזולת הם בכלל סדר ההשתלשלות."
        },
        {
          "s": 2,
          "text": "והגילוי דבחינת מלך עילאה שע\"י קיום המצוות"
        },
        {
          "s": 3,
          "text": "(מלך לשדה נעבד)"
        },
        {
          "s": 4,
          "text": "שלמעלה מבחינת כל,"
        },
        {
          "s": 5,
          "text": "הוא למעלה מהשתלשלות."
        },
        {
          "s": 6,
          "text": "ולהוסיף,"
        },
        {
          "s": 7,
          "text": "דע\"פ המבואר במק\"א24"
        },
        {
          "s": 8,
          "text": "דכל הוא בחינת סובב25,"
        },
        {
          "s": 9,
          "text": "וזה שהיסוד נקרא בשם כל הוא לפי שהיסוד הוא בקו האמצעי שמגיע בכתר"
        },
        {
          "s": 10,
          "text": "(סובב)"
        },
        {
          "s": 11,
          "text": "[וזהו מ\"ש26"
        },
        {
          "s": 12,
          "text": "כי כל בשמים ובארץ ותרגם דאחיד בשמיא ובארעא,"
        },
        {
          "s": 13,
          "text": "כי לגבי הסובב שמים וארץ הם בשוה],"
        },
        {
          "s": 14,
          "text": "צריך לומר,"
        },
        {
          "s": 15,
          "text": "שהגילוי דבחינת מלך עילאה"
        },
        {
          "s": 16,
          "text": "(שע\"י קיום המצוות)"
        },
        {
          "s": 17,
          "text": "הוא למעלה גם מבחינת סובב."
        },
        {
          "s": 18,
          "text": "דסובב הוא שייך לעולמות אלא שהוא למעלה מהם וכולל את כולם כאחד."
        },
        {
          "s": 19,
          "text": "וזהו כי כל בשמים ובארץ,"
        },
        {
          "s": 20,
          "text": "שגם לגבי סובב יש שמים וארץ,"
        },
        {
          "s": 21,
          "text": "אלא שהוא מחברם ומאחדם – דאחיד בשמיא ובארעא."
        },
        {
          "s": 22,
          "text": "וע\"י המצוות הוא המשכת גילוי עצמות אוא\"ס שלמעלה משייכות לעולמות,"
        },
        {
          "s": 23,
          "text": "למעלה גם מסובב."
        },
        {
          "s": 24,
          "text": "וכמבואר בהמאמר,"
        },
        {
          "s": 25,
          "text": "דההמשכה שע\"י קיום המצוות היא מפנימיות הכתר."
        },
        {
          "s": 26,
          "text": "והחילוק שבין אריך"
        },
        {
          "s": 27,
          "text": "(חיצוניות הכתר)"
        },
        {
          "s": 28,
          "text": "לעתיק"
        },
        {
          "s": 29,
          "text": "(פנימיות הכתר)"
        },
        {
          "s": 30,
          "text": "הוא,"
        },
        {
          "s": 31,
          "text": "דאריך הוא שרש ומקור הנאצלים אלא שהוא מקיף עליהם – סובב27,"
        },
        {
          "s": 32,
          "text": "ועתיק הוא בחינה תחתונה שבמאציל – אוא\"ס שלמעלה משייכות לעולמות."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ומבואר בהמאמר,"
        },
        {
          "s": 1,
          "text": "דמלך עילאה הוא ת\"ת"
        },
        {
          "s": 2,
          "text": "[כדאיתא בזהר שם מלך דא קוב\"ה,"
        },
        {
          "s": 3,
          "text": "וקוב\"ה הוא בחינת ת\"ת]"
        },
        {
          "s": 4,
          "text": "ות\"ת ממשיך מפנימיות הכתר."
        },
        {
          "s": 5,
          "text": "ויש לומר,"
        },
        {
          "s": 6,
          "text": "דזה שהת\"ת"
        },
        {
          "s": 7,
          "text": "(דוקא)"
        },
        {
          "s": 8,
          "text": "ממשיך מפנימיות הכתר,"
        },
        {
          "s": 9,
          "text": "אף שגם היסוד הוא בקו האמצעי,"
        },
        {
          "s": 10,
          "text": "הוא,"
        },
        {
          "s": 11,
          "text": "כי חג\"ת הם עצם המדות ונה\"י הם שעל ידם היא ההשפעה"
        },
        {
          "s": 12,
          "text": "(דהמדות חג\"ת)28,"
        },
        {
          "s": 13,
          "text": "ולכן,"
        },
        {
          "s": 14,
          "text": "הגילוי דכתר שע\"י היסוד"
        },
        {
          "s": 15,
          "text": "(שעל ידו היא ההשפעה)"
        },
        {
          "s": 16,
          "text": "הוא בחינת שרש הנאצלים,"
        },
        {
          "s": 17,
          "text": "והגילוי דכתר שע\"י הת\"ת"
        },
        {
          "s": 18,
          "text": "(שלמעלה מהשפעה)"
        },
        {
          "s": 19,
          "text": "הוא בחינת פנימיות הכתר."
        }
      ]
    }
  ]
}