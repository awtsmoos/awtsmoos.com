{
  "globalIndex": 373,
  "owner": 23,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915883_theRebbe_878__p003",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915883_theRebbe_878__p003",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915883_theRebbe_878",
  "title": "מאמר מצותה משתשקע החמה תשל\"ח",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה התענוג"
        },
        {
          "s": 2,
          "text": "(תשוקה)"
        },
        {
          "s": 3,
          "text": "שלמעלה מזה שהאדם מהפך את השוק רה\"ר טורי דפרודא לרה\"י,"
        },
        {
          "s": 4,
          "text": "אתהפכא חשוכא לנהורא,"
        },
        {
          "s": 5,
          "text": "הוא תענוג הכי נעלה."
        },
        {
          "s": 6,
          "text": "וכידוע בענין הצחוק"
        },
        {
          "s": 7,
          "text": "[שהו\"ע התענוג הבא מדבר חידוש דוקא."
        },
        {
          "s": 8,
          "text": "שכמו\"כ הוא גם כביכול בהתענוג וצחוק שלמעלה,"
        },
        {
          "s": 9,
          "text": "שהוא מהחידוש דאתהפכא חשוכא לנהורא60]"
        },
        {
          "s": 10,
          "text": "שהוא תענוג גדול יותר משאר התענוגים שבעולם61."
        },
        {
          "s": 11,
          "text": "וי\"ל שזהו מה שאמרו62"
        },
        {
          "s": 12,
          "text": "כל המלמד את בן עם הארץ תורה אפילו הקב\"ה גוזר גזירה מבטלה בשבילו שנאמר63"
        },
        {
          "s": 13,
          "text": "ואם תוציא יקר מזולל כפי תהי'."
        },
        {
          "s": 14,
          "text": "דהנה זה שהצדיק מבטל את גזירת הקב\"ה64"
        },
        {
          "s": 15,
          "text": "(אף שיודע שהקב\"ה גזר כן)"
        },
        {
          "s": 16,
          "text": "הוא לפי שזה גופא הוא רצון הקב\"ה שהצדיק יבטל את הגזירה ויש להקב\"ה מזה נח\"ר ותענוג גדול65."
        },
        {
          "s": 17,
          "text": "וע\"ד מרז\"ל66"
        },
        {
          "s": 18,
          "text": "מאי עביד קוב\"ה בההיא שעתא כו' קא חייך ואמר נצחוני בני נצחוני,"
        },
        {
          "s": 19,
          "text": "דמזה שנצחוני בני,"
        },
        {
          "s": 20,
          "text": "נעשה למעלה תענוג הכי גדול,"
        },
        {
          "s": 21,
          "text": "חיוך וצחוק."
        },
        {
          "s": 22,
          "text": "וכמו שהוא בעניני הלכה,"
        },
        {
          "s": 23,
          "text": "שהקב\"ה מחייך ואומר נצחוני בני נצחוני,"
        },
        {
          "s": 24,
          "text": "עד\"ז הוא בנוגע להליכות עולם67,"
        },
        {
          "s": 25,
          "text": "הנהגות בעולם,"
        },
        {
          "s": 26,
          "text": "גזירותיו של הקב\"ה68,"
        },
        {
          "s": 27,
          "text": "שיש להקב\"ה נח\"ר ותענוג גדול מזה"
        },
        {
          "s": 28,
          "text": "[וע\"ד שארז\"ל69"
        },
        {
          "s": 29,
          "text": "גבי קידוש החודש אתם אפילו מזידין,"
        },
        {
          "s": 30,
          "text": "שגם כשקידשו את החודש במזיד היפך דיני התורה הרי זה מקודש,"
        },
        {
          "s": 31,
          "text": "ו"
        },
        {
          "s": 32,
          "text": "(גם אז)"
        },
        {
          "s": 33,
          "text": "אומר הקב\"ה לב\"ד של מעלה אני ואתם נלך אצל ב\"ד של מטה70]."
        },
        {
          "s": 34,
          "text": "וזהו כל המלמד את בן עם הארץ תורה כו' שנאמר ואם תוציא יקר מזולל כפי תהי',"
        },
        {
          "s": 35,
          "text": "כי התענוג והצחוק שלמעלה הוא מהעבודה דבירור הניצוצות,"
        },
        {
          "s": 36,
          "text": "להוציא יקר מזולל,"
        },
        {
          "s": 37,
          "text": "ולכן זה שמלמד ומפיץ תורה חוצה גם לבן עם הארץ עליו אמרו הקב\"ה גוזר גזירה וצדיק מבטלה,"
        },
        {
          "s": 38,
          "text": "כי מכיון שמעבודתו של צדיק זה נעשה התענוג והצחוק שלמעלה לכן הקב\"ה גוזר גזירה וצדיק מבטלה,"
        },
        {
          "s": 39,
          "text": "וקוב\"ה קא חייך ואמר נצחוני בני נצחוני."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וענין הנ\"ל"
        },
        {
          "s": 2,
          "text": "(סעיף ה)"
        },
        {
          "s": 3,
          "text": "שהכוונה בההעלמות וההסתרים דעולם הוא בכדי שיוכל להיות ובחרת בחיים,"
        },
        {
          "s": 4,
          "text": "נותן כח ועידוד להאדם שלא להתפעל מזה שרואה שהעולם הוא מלא קליפות וסט\"א71,"
        },
        {
          "s": 5,
          "text": "מציאות של שוק"
        },
        {
          "s": 6,
          "text": "(רשות הרבים)"
        },
        {
          "s": 7,
          "text": "שיש בו תרמודאי ועד שהתרמודאי הולכים בו"
        },
        {
          "s": 8,
          "text": "(כנ\"ל),"
        },
        {
          "s": 9,
          "text": "מכיון שזה גופא שהעולם הוא במצב כזה הוא בכדי שהאדם יתגבר כו'."
        },
        {
          "s": 10,
          "text": "וע\"ד המבואר בספר צוואת הריב\"ש72,"
        },
        {
          "s": 11,
          "text": "שכשאדם מתפלל בכוונה ועומד לנגדו נכרי73"
        },
        {
          "s": 12,
          "text": "המדבר ומבלבלו בתפלתו,"
        },
        {
          "s": 13,
          "text": "הנה זה גופא צריך לפעול בו שיתעורר להתפלל יותר בכוונה מעומקא דלבא."
        },
        {
          "s": 14,
          "text": "שכשיתבונן שחיותו של הנכרי הוא דבר הוי' ורוח פיו ית' המחי' ומהווה אותו בשעה זו גופא כשמדבר דיבורים המבלבלים את כוונת התפלה,"
        },
        {
          "s": 15,
          "text": "ועד שבדיבורים אלה גופא מלובש דיבורו ית' בבחי' גלות,"
        },
        {
          "s": 16,
          "text": "הנה ע\"י התבוננות זו יתעורר להתפלל יותר בכוונה מעומקא דלבא."
        },
        {
          "s": 17,
          "text": "דלא זו בלבד שאינו מתפעל מדיבורי הנכרי ומתפלל כמו שלא הי' מבלבלו,"
        },
        {
          "s": 18,
          "text": "אלא יתירה מזו,"
        },
        {
          "s": 19,
          "text": "שבלבול הנכרי גופא פועל בו התעוררות יתירה."
        },
        {
          "s": 20,
          "text": "כי ניצוצי הקדושה שהיו בגלות בדיבורי הנכרי הם מבחינה גבוה ביותר"
        },
        {
          "s": 21,
          "text": "(שלכן נפלו למטה ביותר),"
        },
        {
          "s": 22,
          "text": "וע\"י שהאדם מוציא אותם מהקליפות,"
        },
        {
          "s": 23,
          "text": "להוציא יקר מזולל,"
        },
        {
          "s": 24,
          "text": "מתגלה בהם שרשם שהוא גבוה ביותר,"
        },
        {
          "s": 25,
          "text": "ומזה נמשך תוספת כח להאדם בעבודתו."
        },
        {
          "s": 26,
          "text": "[ובפרט ע\"פ משנת\"ל"
        },
        {
          "s": 27,
          "text": "(סעיף ב)"
        },
        {
          "s": 28,
          "text": "בענין ירידה צורך עלי',"
        },
        {
          "s": 29,
          "text": "דהעלי' שלאחר הירידה היא למדריגה נעלית יותר מהמדריגה שקודם הירידה,"
        },
        {
          "s": 30,
          "text": "דכמו\"כ הוא גם בעליית הניצוצות,"
        },
        {
          "s": 31,
          "text": "שלאחרי הירידה"
        },
        {
          "s": 32,
          "text": "(והבירור)"
        },
        {
          "s": 33,
          "text": "הן מתעלות למעלה יותר מכמו שהיו בשרשם"
        },
        {
          "s": 34,
          "text": "(גבוה ביותר),"
        },
        {
          "s": 35,
          "text": "דיש לומר,"
        },
        {
          "s": 36,
          "text": "שעלייתם היא למעלה גם מהענין דגבוה ביותר,"
        },
        {
          "s": 37,
          "text": "והוא,"
        },
        {
          "s": 38,
          "text": "שע\"י העבודה דבירור הניצוצות נשלמת"
        },
        {
          "s": 39,
          "text": "(כנ\"ל ס\"ד)"
        },
        {
          "s": 40,
          "text": "הכוונה דדירה לו ית' בתחתונים,"
        },
        {
          "s": 41,
          "text": "לו לעצמותו,"
        },
        {
          "s": 42,
          "text": "שבעצמותו ית' אין שייך כל הגדר דמעלה ומטה"
        },
        {
          "s": 43,
          "text": "(גבוה ומטה)]."
        },
        {
          "s": 44,
          "text": "ובדוגמת ענין כליא ריגלא דתרמודאי,"
        },
        {
          "s": 45,
          "text": "שלא רק שהוא מכלה ומבטל את המורדים"
        },
        {
          "s": 46,
          "text": "(תרמודאי),"
        },
        {
          "s": 47,
          "text": "אלא שהוא פועל בהם גופא ענין הכליון74,"
        },
        {
          "s": 48,
          "text": "ע\"י שמברר את הניצוצות שבהם ומעלה אותם לשרשם."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יובן גם הקשר דשני הפירושים ברגל"
        },
        {
          "s": 2,
          "text": "(מן השוק),"
        },
        {
          "s": 3,
          "text": "שקאי על רגל דלעו\"ז"
        },
        {
          "s": 4,
          "text": "(ריגלא דתרמודאי),"
        },
        {
          "s": 5,
          "text": "ושקאי על ג' רגלים דקדושה,"
        },
        {
          "s": 6,
          "text": "כי בירור והעלאת הניצוצות שברגל דלעו\"ז"
        },
        {
          "s": 7,
          "text": "(שעי\"ז נעשה בו ענין הכליון,"
        },
        {
          "s": 8,
          "text": "כליא ריגלא דתרמודאי)"
        },
        {
          "s": 9,
          "text": "הוא ע\"י העבודה דג' רגלים."
        },
        {
          "s": 10,
          "text": "והענין הוא דהנה ידוע75"
        },
        {
          "s": 11,
          "text": "ההפרש בין תוהו לתיקון,"
        },
        {
          "s": 12,
          "text": "שבתוהו היו הספירות בבחי' ב' קוין ובתיקון הם בבחי' ג' קוין."
        },
        {
          "s": 13,
          "text": "והעבודה דבירור הניצוצות דתוהו שנפלו בלעו\"ז"
        },
        {
          "s": 14,
          "text": "(ריגלא דתרמודאי דלעו\"ז)"
        },
        {
          "s": 15,
          "text": "הוא ע\"י שמעלים אותם לבחי' התיקון שהוא בג' קוין,"
        },
        {
          "s": 16,
          "text": "ענין76"
        },
        {
          "s": 17,
          "text": "ג' רגלים"
        },
        {
          "s": 18,
          "text": "(דקדושה)."
        },
        {
          "s": 19,
          "text": "ובעבודת האדם הו\"ע ג' העמודים76"
        },
        {
          "s": 20,
          "text": "שעליהם העולם עומד77,"
        },
        {
          "s": 21,
          "text": "הן העולם קטן זה האדם78,"
        },
        {
          "s": 22,
          "text": "והן עמידת כללות העולם – עוה\"ז הגשמי התחתון במדריגה שאין תחתון למטה ממנו,"
        },
        {
          "s": 23,
          "text": "שעליו עומדים ומתקיימים כל העולמות וכל סדר ההשתלשלות."
        },
        {
          "s": 24,
          "text": "וזהו מ\"ש גבי יעקב"
        },
        {
          "s": 25,
          "text": "[ומכיון שנשמת יעקב היא כלולה מכל הנשמות79,"
        },
        {
          "s": 26,
          "text": "מובן מזה שכמו\"כ הוא בכאו\"א מישראל]"
        },
        {
          "s": 27,
          "text": "והנה הוי' נצב עליו80,"
        },
        {
          "s": 28,
          "text": "וארז\"ל81"
        },
        {
          "s": 29,
          "text": "הצדיקים אלקיהם מתקיים עליהם,"
        },
        {
          "s": 30,
          "text": "דזה שאלקותו ית' הוא בבחינת נצב"
        },
        {
          "s": 31,
          "text": "(נצב מלך82),"
        },
        {
          "s": 32,
          "text": "הוא מתקיים ונצב כביכול על מעשינו ועבודתינו,"
        },
        {
          "s": 33,
          "text": "ובפרט על מעשינו ועבודתינו במשך זמן הגלות83,"
        },
        {
          "s": 34,
          "text": "ועד שע\"י"
        },
        {
          "s": 35,
          "text": "(בירור)"
        },
        {
          "s": 36,
          "text": "חושך הגלות נעשה זה"
        },
        {
          "s": 37,
          "text": "(דאלקיהם מתקיים עליהם),"
        },
        {
          "s": 38,
          "text": "ועד שזה נעשה גם ע\"י עבודה דאצבע קטנה84,"
        },
        {
          "s": 39,
          "text": "וכידוע פס\"ד הרמב\"ם85"
        },
        {
          "s": 40,
          "text": "שע\"י מצוה אחת"
        },
        {
          "s": 41,
          "text": "[הן במחשבה,"
        },
        {
          "s": 42,
          "text": "הן בדיבור והן במעשה]"
        },
        {
          "s": 43,
          "text": "מכריע את עצמו ואת כל העולם כולו לכף זכות וגורם לו ולהם תשועה והצלה."
        }
      ]
    }
  ]
}