  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919688_theRebbe_695__p003",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919688_theRebbe_695__p003",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919688_theRebbe_695",
  "title": "מאמר ציון במשפט תפדה תשל\"ה",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ז)"
        },
        {
          "s": 2,
          "text": "ועפ\"ז יתאימו ב' הפירושים בושבי' בצדקה,"
        },
        {
          "s": 3,
          "text": "שהפירוש שושבי' בצדקה הוא למטה מציון במשפט תפדה הוא ע\"ד תלמוד גדול."
        },
        {
          "s": 4,
          "text": "אמנם מצד זה שלעתיד יהי' מעשה גדול"
        },
        {
          "s": 5,
          "text": "[וענין זה ישנו גם עכשיו,"
        },
        {
          "s": 6,
          "text": "כנ\"ל],"
        },
        {
          "s": 7,
          "text": "הנה מצד זה,"
        },
        {
          "s": 8,
          "text": "ושבי' בצדקה הוא למעלה מציון במשפט תפדה."
        },
        {
          "s": 9,
          "text": "וכמו שהוא בענין הצדקה,"
        },
        {
          "s": 10,
          "text": "שמצד הענינים דלעתיד יש בה מעלה לגבי תורה כנ\"ל,"
        },
        {
          "s": 11,
          "text": "עד\"ז הוא גם בענין התשובה"
        },
        {
          "s": 12,
          "text": "(ושבי'),"
        },
        {
          "s": 13,
          "text": "שיש בה מעלה לגבי תורה,"
        },
        {
          "s": 14,
          "text": "וכמארז\"ל30"
        },
        {
          "s": 15,
          "text": "שאלו לתורה כו' שאלו להקב\"ה אמר יעשה תשובה ויתכפר לו."
        },
        {
          "s": 16,
          "text": "אלא שמעלה זו שבתשובה היא באה לאחרי קדימת התורה,"
        },
        {
          "s": 17,
          "text": "שלכן מקדים שאלו לתורה כו'"
        },
        {
          "s": 18,
          "text": "[ועד\"ז הוא גם בנוגע מה שמקדים שאלו לחכמה כו' שאלו לנבואה כו'],"
        },
        {
          "s": 19,
          "text": "לפי שתחילה צ\"ל הענין ד"
        },
        {
          "s": 20,
          "text": "[חכמה נבואה ו]"
        },
        {
          "s": 21,
          "text": "תורה,"
        },
        {
          "s": 22,
          "text": "ומזה באים למעלת התשובה,"
        },
        {
          "s": 23,
          "text": "שאמיתית ענין מעלת התשובה תתגלה לעתיד,"
        },
        {
          "s": 24,
          "text": "ומשיח אתא לאתבא צדיקייא בתיובתא,"
        },
        {
          "s": 25,
          "text": "ואמרו רז\"ל שגאולה העתידה תהי' ע\"י התשובה דוקא,"
        },
        {
          "s": 26,
          "text": "דישראל עושין תשובה ומיד הן נגאלין31,"
        },
        {
          "s": 27,
          "text": "בקרוב ממש."
        }
      ]
    }
  ]
}