{
  "globalIndex": 1078,
  "owner": 28,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920191_theRebbe_834__p002",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920191_theRebbe_834__p002",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920191_theRebbe_834",
  "title": "מאמר אני לדודי תשל\"ב",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 2,
          "text": "דמהחילוקים בין אהבה ליראה הוא,"
        },
        {
          "s": 3,
          "text": "דאהבה באה ע\"י גילוי אור מלמעלה,"
        },
        {
          "s": 4,
          "text": "והיראה באה"
        },
        {
          "s": 5,
          "text": "(בעיקר)"
        },
        {
          "s": 6,
          "text": "ע\"י עבודת האדם."
        },
        {
          "s": 7,
          "text": "וע\"ד יראת מלך בו\"ד,"
        },
        {
          "s": 8,
          "text": "דזה שאנשי המדינה יראים מפני המלך הוא מפני שקיבלו אותו להיות מלך עליהם9,"
        },
        {
          "s": 9,
          "text": "דקבלת המלכות היא ע\"י העם,"
        },
        {
          "s": 10,
          "text": "שום תשים עליך מלך10."
        },
        {
          "s": 11,
          "text": "ולכן,"
        },
        {
          "s": 12,
          "text": "כיון שבאלול הוא העבודה דאני לדודי,"
        },
        {
          "s": 13,
          "text": "עבודת האדם,"
        },
        {
          "s": 14,
          "text": "צריך להיות אז יראה."
        },
        {
          "s": 15,
          "text": "ויש להוסיף,"
        },
        {
          "s": 16,
          "text": "שעיקר העבודה באלול,"
        },
        {
          "s": 17,
          "text": "אני לדודי,"
        },
        {
          "s": 18,
          "text": "הוא קבלת עול מלכות שמים."
        },
        {
          "s": 19,
          "text": "דזהו מ\"ש בלקו\"ת שהעבודה דאלול היא היציאה לשדה לקבל פני המלך11."
        },
        {
          "s": 20,
          "text": "וזה שתוקעין בשופר"
        },
        {
          "s": 21,
          "text": "(באלול)"
        },
        {
          "s": 22,
          "text": "לעורר יראה וחרדה,"
        },
        {
          "s": 23,
          "text": "הוא,"
        },
        {
          "s": 24,
          "text": "כי הענין דשום תשים עליך מלך הוא שתהא אימתו עליך12,"
        },
        {
          "s": 25,
          "text": "ובכדי שקבלת המלכות תהי' בשלימות הוא ע\"י התעוררות היראה דוקא13."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "וביאור הענין בפרטיות יותר יובן ע\"פ מ\"ש הצ\"צ במאמר14"
        },
        {
          "s": 2,
          "text": "שמבאר ענין תקיעת שופר בר\"ח אלול,"
        },
        {
          "s": 3,
          "text": "דזה שתוקעין בשופר בחודש אלול הוא הקדמה לתקיעת שופר דר\"ה."
        },
        {
          "s": 4,
          "text": "דהחילוק בין תק\"ש דאלול ותק\"ש דר\"ה הוא,"
        },
        {
          "s": 5,
          "text": "שהיראה"
        },
        {
          "s": 6,
          "text": "(והחרדה)"
        },
        {
          "s": 7,
          "text": "הבאה ע\"י תק\"ש דאלול היא יראה תתאה,"
        },
        {
          "s": 8,
          "text": "והיראה"
        },
        {
          "s": 9,
          "text": "(והחרדה)"
        },
        {
          "s": 10,
          "text": "הבאה ע\"י תקיעת שופר דר\"ה היא יראה עילאה."
        },
        {
          "s": 11,
          "text": "וזהו שתקנו לתקוע בשופר בר\"ח אלול ובכל החודש,"
        },
        {
          "s": 12,
          "text": "כי בכדי לבוא ליראה עילאה צ\"ל תחלה יראה תתאה."
        },
        {
          "s": 13,
          "text": "ועוד טעם על זה שתוקעין בשופר בחודש אלול קודם ראש השנה הוא,"
        },
        {
          "s": 14,
          "text": "כי בעשי\"ת,"
        },
        {
          "s": 15,
          "text": "מתחיל מר\"ה,"
        },
        {
          "s": 16,
          "text": "צריך להמשיך מהמקיף בכדי למלאות מה שפגמו במשך כל השנה,"
        },
        {
          "s": 17,
          "text": "והמשכת המקיף הוא ע\"י הביטול דוקא."
        },
        {
          "s": 18,
          "text": "וכמבואר בתו\"א15"
        },
        {
          "s": 19,
          "text": "עה\"פ16"
        },
        {
          "s": 20,
          "text": "השמים כסאי והארץ הדום רגלי אי זה בית גו' ואל זה אביט אל עני ונכה רוח,"
        },
        {
          "s": 21,
          "text": "דשמים וארץ הם תורה ומצוות,"
        },
        {
          "s": 22,
          "text": "דההמשכה שע\"י תומ\"צ הוא אור פנימי,"
        },
        {
          "s": 23,
          "text": "כסאי והדום רגלי,"
        },
        {
          "s": 24,
          "text": "ובכדי להמשיך המקיפים,"
        },
        {
          "s": 25,
          "text": "אי זה בית גו',"
        },
        {
          "s": 26,
          "text": "דבית הוא מקיף"
        },
        {
          "s": 27,
          "text": "(ובמקיפים עצמם מקיף הרחוק),"
        },
        {
          "s": 28,
          "text": "הוא ע\"י הביטול,"
        },
        {
          "s": 29,
          "text": "עני ונכה רוח וחרד על דברי."
        },
        {
          "s": 30,
          "text": "ולכן תוקעין בשופר באלול,"
        },
        {
          "s": 31,
          "text": "כי בכדי שתהי' המשכת המקיף בר\"ה צ\"ל נכה רוח וחרד,"
        },
        {
          "s": 32,
          "text": "וע\"י תקיעת שופר באים לחרדה."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "וצריך להבין,"
        },
        {
          "s": 1,
          "text": "הרי גם ע\"י שתוקעין בר\"ה באים לחרדה17,"
        },
        {
          "s": 2,
          "text": "ואדרבה,"
        },
        {
          "s": 3,
          "text": "החרדה דר\"ה היא גדולה יותר מהחרדה דאלול,"
        },
        {
          "s": 4,
          "text": "וכנ\"ל בהמאמר שהחרדה הבאה מתק\"ש דאלול היא יראה תתאה,"
        },
        {
          "s": 5,
          "text": "והחרדה הבאה מתק\"ש דר\"ה היא יראה עילאה."
        },
        {
          "s": 6,
          "text": "ואעפ\"כ,"
        },
        {
          "s": 7,
          "text": "המשכת המקיף בר\"ה היא ע\"י החרדה הבאה מתק\"ש דאלול."
        }
      ]
    }
  ]
}