{
  "globalIndex": 545,
  "owner": 45,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916877_theRebbe_274__p004",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916877_theRebbe_274__p004",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916877_theRebbe_274",
  "title": "מאמר באתי לגני תשל\"ב",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ויש להוסיף,"
        },
        {
          "s": 2,
          "text": "דענין זה"
        },
        {
          "s": 3,
          "text": "[המעלה שבענין ההעלאה מלמטלמ\"ע"
        },
        {
          "s": 4,
          "text": "(ביטול היש לאין)"
        },
        {
          "s": 5,
          "text": "שבעבודת הקרבנות]"
        },
        {
          "s": 6,
          "text": "שייך להמבואר בתחלת ההמשך,"
        },
        {
          "s": 7,
          "text": "שתכלית הכוונה דבריאת והתהוות כל העולמות הוא שעל ידם תהי' התהוות עוה\"ז התחתון,"
        },
        {
          "s": 8,
          "text": "ועי\"ז תושלם הכוונה דדירה בתחתונים."
        },
        {
          "s": 9,
          "text": "והענין הוא,"
        },
        {
          "s": 10,
          "text": "דמהטעמים על זה שהתהוות עוה\"ז התחתון היתה באופן שבתחלה נתהוו עולמות העליונים ועל ידם דוקא נעשה ההתהוות דעוה\"ז התחתון"
        },
        {
          "s": 11,
          "text": "(אף שלכאורה הי' צריך להיות מלכתחילה ההתהוות דעוה\"ז התחתון),"
        },
        {
          "s": 12,
          "text": "הוא,"
        },
        {
          "s": 13,
          "text": "כי ענין דירה בתחתונים הוא שהתחתונים"
        },
        {
          "s": 14,
          "text": "(הנבראים דעוה\"ז התחתון)"
        },
        {
          "s": 15,
          "text": "יהיו בטלים לאלקות,"
        },
        {
          "s": 16,
          "text": "וזה נעשה ע\"י שהתהוות התחתונים הוא מהעליונים."
        },
        {
          "s": 17,
          "text": "דע\"י שמשיגים שהחיות שבהם הי' כלול תחילה בהעליונים ואח\"כ ירד למטה"
        },
        {
          "s": 18,
          "text": "(ועד לירידה באין ערוך),"
        },
        {
          "s": 19,
          "text": "נעשה בהם ענין הרצוא ליכלל בשרשם,"
        },
        {
          "s": 20,
          "text": "שעי\"ז הם בטלים ממציאותם."
        },
        {
          "s": 21,
          "text": "ויש לומר,"
        },
        {
          "s": 22,
          "text": "דענין זה מרומז גם בהכלל שכל ירידה היא לצורך עלי'."
        },
        {
          "s": 23,
          "text": "דנוסף להפירוש שהכוונה דהירידה היא בכדי שעי\"ז תהי' עלי' למדריגה נעלית יותר מהמדריגה שלפני הירידה,"
        },
        {
          "s": 24,
          "text": "יש להוסיף בזה עוד פירוש,"
        },
        {
          "s": 25,
          "text": "שהכוונה בהירידה"
        },
        {
          "s": 26,
          "text": "(וההשתלשלות)"
        },
        {
          "s": 27,
          "text": "דעולמות"
        },
        {
          "s": 28,
          "text": "[היינו בזה שהתהוות עוה\"ז התחתון היתה באופן שבתחילה נתהוו עולמות העליונים וירדו ממדריגה למדריגה"
        },
        {
          "s": 29,
          "text": "(מעולם לעולם)"
        },
        {
          "s": 30,
          "text": "עד שנתהווה מהם עוה\"ז התחתון]"
        },
        {
          "s": 31,
          "text": "הוא בכדי שיהי' ענין העלי',"
        },
        {
          "s": 32,
          "text": "רצוא והעלאה32."
        },
        {
          "s": 33,
          "text": "וכמו\"כ הוא בנוגע להאור האלקי שמהווה את הנבראים33,"
        },
        {
          "s": 34,
          "text": "דמהטעמים על זה שבתחלה הי' האור כלול בהמאור,"
        },
        {
          "s": 35,
          "text": "דאור זה הוא למעלה משייכות לעולמות"
        },
        {
          "s": 36,
          "text": "[וכידוע שבאוא\"ס שלפני הצמצום"
        },
        {
          "s": 37,
          "text": "(דהאור שלפני הצמצום הוא"
        },
        {
          "s": 38,
          "text": "(בדרך כלל)"
        },
        {
          "s": 39,
          "text": "אור הכלול במאור)"
        },
        {
          "s": 40,
          "text": "לא הי' נתינת מקום לעולמות],"
        },
        {
          "s": 41,
          "text": "וע\"י הצמצום"
        },
        {
          "s": 42,
          "text": "(צמצום שבדרך סילוק)"
        },
        {
          "s": 43,
          "text": "נמשך ממנו"
        },
        {
          "s": 44,
          "text": "(מאוא\"ס שלפני הצמצום)"
        },
        {
          "s": 45,
          "text": "אור הקו שיש לו שייכות לעולמות,"
        },
        {
          "s": 46,
          "text": "ואח\"כ היו עוד כו\"כ צמצומים"
        },
        {
          "s": 47,
          "text": "(ירידות)"
        },
        {
          "s": 48,
          "text": "בהאור עד שנעשה מקור להוות את הנבראים"
        },
        {
          "s": 49,
          "text": "(אף שלכאורה הי' צריך להיות מלכתחילה המשכת אור זה),"
        },
        {
          "s": 50,
          "text": "הוא,"
        },
        {
          "s": 51,
          "text": "בכדי שבהנבראים יהי' הרצוא והעלי' להכלל בהאור שלמעלה משייכות לעולמות,"
        },
        {
          "s": 52,
          "text": "ועי\"ז יהיו בטלים לאלקות בתכלית הביטול,"
        },
        {
          "s": 53,
          "text": "ביטול במציאות."
        },
        {
          "s": 54,
          "text": "[וכידוע34"
        },
        {
          "s": 55,
          "text": "שהביטול שמצד גילוי האור שלפי ערך העולמות,"
        },
        {
          "s": 56,
          "text": "הוא רק ביטול היש,"
        },
        {
          "s": 57,
          "text": "ואמיתית ענין הביטול,"
        },
        {
          "s": 58,
          "text": "ביטול במציאות,"
        },
        {
          "s": 59,
          "text": "הוא דוקא מצד האור שלמעלה משייכות לעולמות]."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "וביאור הענין בפרטיות יותר,"
        },
        {
          "s": 2,
          "text": "יובן בהקדים מה שבקרבנות נאמר35"
        },
        {
          "s": 3,
          "text": "ריח ניחוח ופירשו חז\"ל36"
        },
        {
          "s": 4,
          "text": "נח\"ר לפני שאמרתי ונעשה רצוני,"
        },
        {
          "s": 5,
          "text": "וצריך להבין,"
        },
        {
          "s": 6,
          "text": "הרי זה שאמרתי ונעשה רצוני הוא בכל המצוות,"
        },
        {
          "s": 7,
          "text": "ואעפ\"כ נאמר זה בקרבנות דוקא."
        },
        {
          "s": 8,
          "text": "ומבאר אדמו\"ר הזקן37"
        },
        {
          "s": 9,
          "text": "בהקדים מה שארז\"ל38"
        },
        {
          "s": 10,
          "text": "עד שלא נברא העולם הי' הוא ושמו בלבד."
        },
        {
          "s": 11,
          "text": "דשמו הוא בחינת מלכות,"
        },
        {
          "s": 12,
          "text": "שהיא מקור ההשפעה וחיות הנבראים,"
        },
        {
          "s": 13,
          "text": "ושמו שהי' קודם שנברא העולם הוא בחינת המלכות כמו שהיתה כלולה בא\"ס ב\"ה,"
        },
        {
          "s": 14,
          "text": "דבהיותה שם אינה בבחינת מציאות,"
        },
        {
          "s": 15,
          "text": "כמו אור הכלול במאור שאינו במציאות."
        },
        {
          "s": 16,
          "text": "ואח\"כ נעשה התפשטות האור והזיו להחיות39"
        },
        {
          "s": 17,
          "text": "הנבראים מאין ליש."
        },
        {
          "s": 18,
          "text": "ומבאר,"
        },
        {
          "s": 19,
          "text": "דזה שהאור ירד ממדריגתו"
        },
        {
          "s": 20,
          "text": "(כמו שהי' כלול בא\"ס)"
        },
        {
          "s": 21,
          "text": "להחיות הנבראים מאין ליש,"
        },
        {
          "s": 22,
          "text": "הוא לצורך עלי',"
        },
        {
          "s": 23,
          "text": "בכדי שיהי' מיש לאין,"
        },
        {
          "s": 24,
          "text": "היינו,"
        },
        {
          "s": 25,
          "text": "שהיש יהי' בטל ונכלל באור א\"ס ב\"ה ממש."
        },
        {
          "s": 26,
          "text": "ועפ\"ז מבאר זה שבקרבנות"
        },
        {
          "s": 27,
          "text": "(דוקא)"
        },
        {
          "s": 28,
          "text": "נאמר ריח ניחוח"
        },
        {
          "s": 29,
          "text": "(ניחוח מלשון נחת רוח),"
        },
        {
          "s": 30,
          "text": "כי עיקר הנח\"ר והתענוג דלמעלה הוא מזה שהיש מתבטל ונעשה בחינת אין,"
        },
        {
          "s": 31,
          "text": "ועיקר הביטול יש לאין הוא במעשה הקרבנות."
        },
        {
          "s": 32,
          "text": "דענין הקרבנות הוא העלאה מלמטה למעלה,"
        },
        {
          "s": 33,
          "text": "שהתחתון יוצא ומתבטל ממציאותו ועולה"
        },
        {
          "s": 34,
          "text": "(נכלל)"
        },
        {
          "s": 35,
          "text": "למעלה"
        },
        {
          "s": 36,
          "text": "(כדלקמן)."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ולהוסיף40,"
        },
        {
          "s": 1,
          "text": "דנוסף לההעלאה דהקרבן עצמו,"
        },
        {
          "s": 2,
          "text": "שהבהמה שהקריבו ע\"ג המזבח היתה נשרפת"
        },
        {
          "s": 3,
          "text": "(מתבטלת ממציאותה)"
        },
        {
          "s": 4,
          "text": "ונכללת באש של מעלה,"
        },
        {
          "s": 5,
          "text": "נעשה עי\"ז העלאה גם במלאכים העליונים."
        },
        {
          "s": 6,
          "text": "כמ\"ש41"
        },
        {
          "s": 7,
          "text": "את קרבני לחמי לאשי,"
        },
        {
          "s": 8,
          "text": "אשי הם השרפים,"
        },
        {
          "s": 9,
          "text": "והקרבן הוא הלחם והמזון שלהם,"
        },
        {
          "s": 10,
          "text": "שמוסיף בהם כח וחיות להבטל ולהכלל באוא\"ס ועד לאשתאבא42"
        },
        {
          "s": 11,
          "text": "בגופא דמלכא."
        },
        {
          "s": 12,
          "text": "וזהו\"ע השיר שהי' בשעת הקרבת הקרבנות,"
        },
        {
          "s": 13,
          "text": "כי כל עלי' היא ע\"י שיר."
        },
        {
          "s": 14,
          "text": "כמארז\"ל43"
        },
        {
          "s": 15,
          "text": "כל בעלי השיר יוצאין בשיר ונמשכים בשיר,"
        },
        {
          "s": 16,
          "text": "ומובא בלקו\"ת44"
        },
        {
          "s": 17,
          "text": "בשם ס' לקו\"א של הה\"מ,"
        },
        {
          "s": 18,
          "text": "דבעלי השיר הם המלאכים45"
        },
        {
          "s": 19,
          "text": "[ויש לקשר זה עם הפירוש"
        },
        {
          "s": 20,
          "text": "(בפשטות)"
        },
        {
          "s": 21,
          "text": "שבעלי שיר הם חיות שנותנים שיר בצוארם46,"
        },
        {
          "s": 22,
          "text": "כי גם המלאכים נק' בשם חיות ובהמות47],"
        },
        {
          "s": 23,
          "text": "ופירוש יוצאין בשיר הוא,"
        },
        {
          "s": 24,
          "text": "שע\"י השיר שאומרים המלאכים הם יוצאים מהכלים שלהם,"
        },
        {
          "s": 25,
          "text": "להתכלל באוא\"ס ב\"ה."
        }
      ]
    }
  ]
}