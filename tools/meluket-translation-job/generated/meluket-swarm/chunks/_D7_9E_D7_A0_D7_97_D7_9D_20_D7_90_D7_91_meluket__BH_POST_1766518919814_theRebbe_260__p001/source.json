{
  "globalIndex": 1016,
  "owner": 16,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919814_theRebbe_260__p001",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919814_theRebbe_260__p001",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919814_theRebbe_260",
  "title": "מאמר לא היו ימים טובים לישראל תשל\"ה",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "יום ד',"
        },
        {
          "s": 2,
          "text": "חמשה עשר באב ה'תשל\"ה*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "לא היו ימים טובים לישראל כחמשה עשר באב וכיום הכפורים1,"
        },
        {
          "s": 1,
          "text": "ואיתא בגמרא2,"
        },
        {
          "s": 2,
          "text": "בשלמא יום הכפורים משום דאית בי' סליחה ומחילה,"
        },
        {
          "s": 3,
          "text": "יום שניתנו בו לוחות האחרונות,"
        },
        {
          "s": 4,
          "text": "אלא ט\"ו באב מאי היא,"
        },
        {
          "s": 5,
          "text": "ומתרץ שבט\"ו באב אירעו כמה ענינים טובים"
        },
        {
          "s": 6,
          "text": "(יום שהותרו שבטים לבוא זה בזה וכו')."
        },
        {
          "s": 7,
          "text": "וצריך להבין,"
        },
        {
          "s": 8,
          "text": "מהו גודל העילוי דמאורעות אלו,"
        },
        {
          "s": 9,
          "text": "שמפני זה,"
        },
        {
          "s": 10,
          "text": "היו\"ט דט\"ו באב הוא גדול יותר משאר הימים טובים."
        },
        {
          "s": 11,
          "text": "ובפרט שמפשטות הלשון לא היו ימים טובים לישראל כחמשה עשר באב כו' משמע3"
        },
        {
          "s": 12,
          "text": "שהוא גדול יותר מכל הימים טובים,"
        },
        {
          "s": 13,
          "text": "גם משלש רגלים."
        },
        {
          "s": 14,
          "text": "גם צריך להבין,"
        },
        {
          "s": 15,
          "text": "דמזה שלא היו כו' כחמשה עשר באב וכיום הכפורים משמע שט\"ו באב ויוהכ\"פ שייכים זה לזה."
        },
        {
          "s": 16,
          "text": "וגם צ\"ל זה שמאמר זה הוא הסיום והחותם דמס' תענית,"
        },
        {
          "s": 17,
          "text": "דלכאורה,"
        },
        {
          "s": 18,
          "text": "תענית ויו\"ט"
        },
        {
          "s": 19,
          "text": "[ובפרט יו\"ט גדול ביותר,"
        },
        {
          "s": 20,
          "text": "שלא היו ימים טובים כמותו]"
        },
        {
          "s": 21,
          "text": "הם הפכים4."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "והענין הוא,"
        },
        {
          "s": 1,
          "text": "דעיקר היו\"ט דט\"ו באב הוא כמובא בהמאמר שמבאר ענין חמשה עשר באב של אדמו\"ר"
        },
        {
          "s": 2,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 3,
          "text": "נ\"ע5"
        },
        {
          "s": 4,
          "text": "מפע\"ח6"
        },
        {
          "s": 5,
          "text": "כי אז הוא"
        },
        {
          "s": 6,
          "text": "[שלימות7]"
        },
        {
          "s": 7,
          "text": "מילוי הלבנה"
        },
        {
          "s": 8,
          "text": "[והענינים שאירעו בחמשה עשר באב הם כמו תוצאות מענינו העיקרי של יום זה – שלימות מילוי הלבנה8]."
        },
        {
          "s": 9,
          "text": "ומבאר בהמאמר,"
        },
        {
          "s": 10,
          "text": "דהגם שבכל ט\"ו בחודש הוא מילוי הלבנה,"
        },
        {
          "s": 11,
          "text": "מ\"מ,"
        },
        {
          "s": 12,
          "text": "גודל המעלה דמילוי הלבנה הוא המילוי והשלימות שלה שלאחרי חסרון,"
        },
        {
          "s": 13,
          "text": "דהשלימות שלאחרי חסרון היא שלימות נעלית יותר מהשלימות שמצד עצמה,"
        },
        {
          "s": 14,
          "text": "כידוע9"
        },
        {
          "s": 15,
          "text": "הכלל בעליות וירידות,"
        },
        {
          "s": 16,
          "text": "דהעלי' שלאחרי הירידה היא עלי' למעלה יותר מהדרגא שלפני הירידה,"
        },
        {
          "s": 17,
          "text": "וכל שהירידה היא ביותר,"
        },
        {
          "s": 18,
          "text": "העלי' היא ביותר."
        },
        {
          "s": 19,
          "text": "ולכן עיקר המעלה דמילוי הלבנה הוא בט\"ו באב,"
        },
        {
          "s": 20,
          "text": "כי בחודש אב,"
        },
        {
          "s": 21,
          "text": "הירידה דהלבנה"
        },
        {
          "s": 22,
          "text": "(דישראל דומין ללבנה10)"
        },
        {
          "s": 23,
          "text": "היא ירידה גדולה ביותר,"
        },
        {
          "s": 24,
          "text": "לכן,"
        },
        {
          "s": 25,
          "text": "העלי' דט\"ו באב"
        },
        {
          "s": 26,
          "text": "(שלאחרי הירידה דתשעה באב)"
        },
        {
          "s": 27,
          "text": "היא עלי' גדולה ביותר."
        },
        {
          "s": 28,
          "text": "וזהו לא היו ימים טובים לישראל כחמשה עשר באב,"
        },
        {
          "s": 29,
          "text": "שהוא יו\"ט גדול יותר גם מהימים טובים דפסח וסוכות,"
        },
        {
          "s": 30,
          "text": "אף שגם ימים טובים אלה הם בט\"ו בחודש,"
        },
        {
          "s": 31,
          "text": "כי העלי' דט\"ו בניסן"
        },
        {
          "s": 32,
          "text": "(פסח),"
        },
        {
          "s": 33,
          "text": "אף שהיא באה לאחרי הירידה דגלות מצרים,"
        },
        {
          "s": 34,
          "text": "הרי11"
        },
        {
          "s": 35,
          "text": "כשיצאו ישראל ממצרים היתה התחלת עבודתם דרגת צדיקים12,"
        },
        {
          "s": 36,
          "text": "דגר שנתגייר13"
        },
        {
          "s": 37,
          "text": "כקטן שנולד דמי14,"
        },
        {
          "s": 38,
          "text": "ולכן העלי' דט\"ו בניסן אינה בהמשך כ\"כ להירידה שהיתה לפני זה."
        },
        {
          "s": 39,
          "text": "וגם העלי' דט\"ו בתשרי"
        },
        {
          "s": 40,
          "text": "(סוכות),"
        },
        {
          "s": 41,
          "text": "אף שהיו\"ט דסוכות בא בהמשך להתשובה וכפרה דיום הכפורים15,"
        },
        {
          "s": 42,
          "text": "הרי11"
        },
        {
          "s": 43,
          "text": "העלי' עצמה מהמצב הבלתי רצוי שהי' מקודם הוא ביום הכפורים,"
        },
        {
          "s": 44,
          "text": "אלא שהגילוי דהענינים שנמשכו ביוהכ\"פ הוא בסוכות16."
        },
        {
          "s": 45,
          "text": "משא\"כ העלי' שלאחרי הירידה דתחלת חודש אב,"
        },
        {
          "s": 46,
          "text": "שהעלי' עצמה היא בט\"ו באב17,"
        },
        {
          "s": 47,
          "text": "לכן,"
        },
        {
          "s": 48,
          "text": "היו\"ט דחמשה עשר באב הוא גדול יותר מהיו\"ט דפסח וסוכות."
        }
      ]
    }
  ]
}