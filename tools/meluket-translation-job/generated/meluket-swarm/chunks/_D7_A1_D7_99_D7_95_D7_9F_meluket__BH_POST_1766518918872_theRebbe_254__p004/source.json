{
  "globalIndex": 862,
  "owner": 12,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918872_theRebbe_254__p004",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918872_theRebbe_254__p004",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918872_theRebbe_254",
  "title": "מאמר בהעלותך את הנרות תשכ\"ט",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "והנה ידוע37"
        },
        {
          "s": 1,
          "text": "דאהבה היא האהבה והרצון דהאדם"
        },
        {
          "s": 2,
          "text": "(האוהב),"
        },
        {
          "s": 3,
          "text": "ולכן,"
        },
        {
          "s": 4,
          "text": "גם כשהאהבה והרצון שלו הוא שיושלם רצון העליון,"
        },
        {
          "s": 5,
          "text": "מ\"מ,"
        },
        {
          "s": 6,
          "text": "עצם ענין האהבה והרצון הוא מציאות."
        },
        {
          "s": 7,
          "text": "ואמיתית ענין הביטול הוא בהעבודה דקבלת עול,"
        },
        {
          "s": 8,
          "text": "שהוא כמו עבד שאין לו שום רצונות,"
        },
        {
          "s": 9,
          "text": "וכל מה שעושה הוא מצד עול האדון שמוטל עליו,"
        },
        {
          "s": 10,
          "text": "שמצד זה הוא מוכרח לקיים רצון האדון."
        },
        {
          "s": 11,
          "text": "ויש לומר,"
        },
        {
          "s": 12,
          "text": "דכיון שביטול המרכבה להרוכב הוא לא מצד הרצון דהמרכבה"
        },
        {
          "s": 13,
          "text": "(שרוצה להיות בטילה להרוכב ומרכבה אליו)"
        },
        {
          "s": 14,
          "text": "אלא מצד הרוכב,"
        },
        {
          "s": 15,
          "text": "לכן בהירושה מהאבות הן הן המרכבה כלול בהעלם גם הביטול דקבלת עול."
        },
        {
          "s": 16,
          "text": "[ולהעיר ממאמר רז\"ל38"
        },
        {
          "s": 17,
          "text": "בשעה שהקדימו ישראל נעשה לנשמע כו' מי גילה לבני רז זה ומבואר בחסידות39"
        },
        {
          "s": 18,
          "text": "דזה שהקדימו נעשה לנשמע"
        },
        {
          "s": 19,
          "text": "[שבהביטול דקבלת עול עצמו הוא ביטול נעלה ביותר,"
        },
        {
          "s": 20,
          "text": "ביטול לבעל הרצון]"
        },
        {
          "s": 21,
          "text": "הוא ע\"י גילוי אהבה המסותרת,"
        },
        {
          "s": 22,
          "text": "רז."
        },
        {
          "s": 23,
          "text": "ויש לומר,"
        },
        {
          "s": 24,
          "text": "שהשייכות דאהבה מסותרת"
        },
        {
          "s": 25,
          "text": "(מציאות)"
        },
        {
          "s": 26,
          "text": "להקדמת נעשה לנשמע"
        },
        {
          "s": 27,
          "text": "(ביטול דקבלת עול),"
        },
        {
          "s": 28,
          "text": "הוא,"
        },
        {
          "s": 29,
          "text": "כי אהבה המסותרת היא בירושה מהאבות הן הן המרכבה]."
        },
        {
          "s": 30,
          "text": "ומזה מובן,"
        },
        {
          "s": 31,
          "text": "דהביטול שנמשך לישראל במתן תורה"
        },
        {
          "s": 32,
          "text": "(לאחרי שהקדימו נעשה לנשמע)"
        },
        {
          "s": 33,
          "text": "הוא ביטול נעלה יותר גם מהביטול דמרכבה."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והענין הוא,"
        },
        {
          "s": 2,
          "text": "דאיתא בגמרא40"
        },
        {
          "s": 3,
          "text": "אמרו עליו על ריב\"ז שלא הניח דבר גדול ודבר קטן,"
        },
        {
          "s": 4,
          "text": "דבר גדול מעשה מרכבה דבר קטן הוויות דאביי ורבא."
        },
        {
          "s": 5,
          "text": "ומבואר בהמאמר41,"
        },
        {
          "s": 6,
          "text": "דהטעם שמעשה מרכבה נק' דבר גדול הוא,"
        },
        {
          "s": 7,
          "text": "כי ע\"י המרכבה42"
        },
        {
          "s": 8,
          "text": "מגיע האדם הרוכב על המרכבה למקום שאינו יכול להגיע לשם מצד עצמו,"
        },
        {
          "s": 9,
          "text": "וכמו\"כ הוא במרכבה העליונה,"
        },
        {
          "s": 10,
          "text": "שהחיות נושאות את הכסא43"
        },
        {
          "s": 11,
          "text": "ואת האדם שעל הכסא44"
        },
        {
          "s": 12,
          "text": "לבחינת לא אדם45."
        },
        {
          "s": 13,
          "text": "ועיקר ההעלאה לבחינת לא אדם הוא בהמרכבה דהאבות"
        },
        {
          "s": 14,
          "text": "(האבות הן הן המרכבה),"
        },
        {
          "s": 15,
          "text": "מרכבה דאצילות."
        },
        {
          "s": 16,
          "text": "כי העלי' דבחינת אדם לבחינת לא אדם שע\"י מרכבה דבי\"ע היא שהאדם שעל הכסא"
        },
        {
          "s": 17,
          "text": "(אדם דבי\"ע)"
        },
        {
          "s": 18,
          "text": "מתעלה לדרגא שהיא בחינת לא אדם לגבי אדם דבי\"ע,"
        },
        {
          "s": 19,
          "text": "וע\"י המרכבה דהאבות,"
        },
        {
          "s": 20,
          "text": "מרכבה דאצילות,"
        },
        {
          "s": 21,
          "text": "נעשה העלי' דבחי' אדם דאצילות לבחינת לא אדם שלמעלה מאצילות,"
        },
        {
          "s": 22,
          "text": "אריך."
        },
        {
          "s": 23,
          "text": "וזהו שמעשה מרכבה נקרא דבר גדול,"
        },
        {
          "s": 24,
          "text": "כי אדם,"
        },
        {
          "s": 25,
          "text": "זעיר אנפין,"
        },
        {
          "s": 26,
          "text": "הוא בחינת קטנות וצמצום,"
        },
        {
          "s": 27,
          "text": "וע\"י המרכבה הוא מתעלה לבחינת אריך,"
        },
        {
          "s": 28,
          "text": "גדול."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "והטעם שהוויות דאביי ורבא נק' דבר קטן"
        },
        {
          "s": 1,
          "text": "(אף שהוא עיקר בתושבע\"פ)"
        },
        {
          "s": 2,
          "text": "הוא,"
        },
        {
          "s": 3,
          "text": "כי הלכות התורה נתלבשו בדברים קטנים."
        },
        {
          "s": 4,
          "text": "דנוסף לזה שהמצוות נתלבשו בדברים גשמיים,"
        },
        {
          "s": 5,
          "text": "יש בכל מצוה כמה פרטי דינים,"
        },
        {
          "s": 6,
          "text": "דענין ההתחלקות"
        },
        {
          "s": 7,
          "text": "(פרטים)"
        },
        {
          "s": 8,
          "text": "הוא צמצום והגבלה,"
        },
        {
          "s": 9,
          "text": "קטנות."
        },
        {
          "s": 10,
          "text": "[ועפ\"ז46,"
        },
        {
          "s": 11,
          "text": "החילוק בין מעשה מרכבה להוויות דאביי ורבא הוא מן הקצה אל הקצה."
        },
        {
          "s": 12,
          "text": "דענין מרכבה הוא היציאה מבחינת הגבלה"
        },
        {
          "s": 13,
          "text": "(אדם)"
        },
        {
          "s": 14,
          "text": "לבחינת בל\"ג"
        },
        {
          "s": 15,
          "text": "(לא אדם)"
        },
        {
          "s": 16,
          "text": "– דבר גדול"
        },
        {
          "s": 17,
          "text": "(דאמיתית ענין הגדלות הוא בדבר שאינו מוגבל47),"
        },
        {
          "s": 18,
          "text": "ובהוויות דאביי ורבא הוא להיפך,"
        },
        {
          "s": 19,
          "text": "התלבשות רצון העליון,"
        },
        {
          "s": 20,
          "text": "בלי גבול,"
        },
        {
          "s": 21,
          "text": "בדברים מוגבלים – דבר קטן]."
        },
        {
          "s": 22,
          "text": "וממשיך בהמאמר עוד טעם על זה שהוויות דאביי ורבא נק' דבר קטן,"
        },
        {
          "s": 23,
          "text": "כי התורה דעכשיו היא דבר קטן לגבי פנימיות התורה שתתגלה לעתיד."
        },
        {
          "s": 24,
          "text": "וגם לפי שהתורה היא משל ולבוש לאוא\"ס המלובש בה."
        },
        {
          "s": 25,
          "text": "שלכן נקראת התורה בשם משל הקדמוני48,"
        },
        {
          "s": 26,
          "text": "שהיא משל ולבוש לבחי' קדמונו של עולם49."
        },
        {
          "s": 27,
          "text": "ומשל לגבי נמשל הוא דבר קטן."
        }
      ]
    }
  ]
}