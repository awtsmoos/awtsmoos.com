{
  "globalIndex": 178,
  "owner": 28,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914830_theRebbe_782__p001",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914830_theRebbe_782__p001",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518914830_theRebbe_782",
  "title": "מאמר וה' אמר המכסה אני מאברהם תשל\"ז",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ וירא,"
        },
        {
          "s": 2,
          "text": "כ\"ף מרחשון ה'תשל\"ז"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "וה' אמר המכסה אני מאברהם גו' ואברהם היו יהי' לגוי גדול גו' כי ידעתיו למען אשר יצוה גו' ושמרו דרך ה' לעשות צדקה ומשפט גו'1."
        },
        {
          "s": 1,
          "text": "ומדייק בזה בעל יום ההולדת במאמרו ד\"ה זה דשנת תרס\"ז"
        },
        {
          "s": 2,
          "text": "(בהמשך תרס\"ו2),"
        },
        {
          "s": 3,
          "text": "הרי דרך הוי' זהו תומ\"צ3,"
        },
        {
          "s": 4,
          "text": "וא\"כ מה מוסיף הכתוב בלעשות צדקה גו'"
        },
        {
          "s": 5,
          "text": "(ענין המצוות4)"
        },
        {
          "s": 6,
          "text": "על ושמרו דרך הוי'."
        },
        {
          "s": 7,
          "text": "ומבאר שם5,"
        },
        {
          "s": 8,
          "text": "דדרך הוי' היא המשכה מלמעלה למטה,"
        },
        {
          "s": 9,
          "text": "וצדקה ומשפט היא העבודה בבחי' מלמטה למעלה,"
        },
        {
          "s": 10,
          "text": "העבודה דאור חוזר."
        },
        {
          "s": 11,
          "text": "[ועפ\"ז מבואר שם6"
        },
        {
          "s": 12,
          "text": "גם השייכות דושמרו דרך הוי' לעשות צדקה ומשפט למ\"ש לפנ\"ז והוי' אמר המכסה אני מאברהם גו']."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "והנה הפסוק כי ידעתיו גו' ושמרו דרך הוי' לעשות צדקה ומשפט נתבאר בהמשך הנ\"ל בד\"ה כי ידעתיו דשנת תרס\"ו7"
        },
        {
          "s": 1,
          "text": "(מאמר דש\"פ וירא הראשון שבההמשך),"
        },
        {
          "s": 2,
          "text": "ובמאמר זה"
        },
        {
          "s": 3,
          "text": "(מאמר דש\"פ וירא השני שבההמשך)"
        },
        {
          "s": 4,
          "text": "מבאר הפסוק באופן אחר,"
        },
        {
          "s": 5,
          "text": "נוסף על זה שמאמר הראשון מתחיל בפסוק כי ידעתיו ומאמר השני מתחיל בפסוק והוי' אמר המכסה אני גו',"
        },
        {
          "s": 6,
          "text": "הנה גם בפסוק כי ידעתיו גופא,"
        },
        {
          "s": 7,
          "text": "במאמר השני מפרש באופן אחר,"
        },
        {
          "s": 8,
          "text": "דבמאמר הראשון מביא שני פירושים בכי ידעתיו,"
        },
        {
          "s": 9,
          "text": "פירוש התרגום8"
        },
        {
          "s": 10,
          "text": "שידעתיו הוא לשון ידיעה,"
        },
        {
          "s": 11,
          "text": "ארי גלי קדמי,"
        },
        {
          "s": 12,
          "text": "ופירוש רש\"י שידעתיו הוא לשון חיבה."
        },
        {
          "s": 13,
          "text": "ומבאר שם9"
        },
        {
          "s": 14,
          "text": "דידעתיו לשון ידיעה הו\"ע רצון העצמי"
        },
        {
          "s": 15,
          "text": "(דזהו ארי גלי קדמי,"
        },
        {
          "s": 16,
          "text": "כי הרצון הוא בהתגלות),"
        },
        {
          "s": 17,
          "text": "וידעתיו לשון חיבה הו\"ע תענוג העצמי,"
        },
        {
          "s": 18,
          "text": "משא\"כ במאמר השני5"
        },
        {
          "s": 19,
          "text": "מפרש10"
        },
        {
          "s": 20,
          "text": "ידעתיו לשון חיבה,"
        },
        {
          "s": 21,
          "text": "שחיבב אותו בבחי' תענוג העצמי."
        },
        {
          "s": 22,
          "text": "ועוד חילוק בין שני המאמרים בהפירוש דושמרו דרך הוי' לעשות צדקה ומשפט."
        },
        {
          "s": 23,
          "text": "דבמאמר הראשון משמע"
        },
        {
          "s": 24,
          "text": "(כפשטות לשון הכתוב,"
        },
        {
          "s": 25,
          "text": "וכמבואר גם בכמה דרושים)"
        },
        {
          "s": 26,
          "text": "דלעשות צדקה ומשפט הוא הפירוש דושמרו דרך הוי'11,"
        },
        {
          "s": 27,
          "text": "או שצדקה ומשפט הוא פרט בדרך הוי'."
        },
        {
          "s": 28,
          "text": "ויש לומר שדרך הוי'"
        },
        {
          "s": 29,
          "text": "(לשון יחיד)"
        },
        {
          "s": 30,
          "text": "היא התורה"
        },
        {
          "s": 31,
          "text": "(בחינת כלל שלמעלה מהתחלקות),"
        },
        {
          "s": 32,
          "text": "ומזה נמשך לעשות צדקה12,"
        },
        {
          "s": 33,
          "text": "עשיית המצוות"
        },
        {
          "s": 34,
          "text": "(רמ\"ח אברין דמלכא13,"
        },
        {
          "s": 35,
          "text": "אברים פרטים)14."
        },
        {
          "s": 36,
          "text": "ובמאמר זה"
        },
        {
          "s": 37,
          "text": "(מאמר דש\"פ וירא השני שבההמשך)"
        },
        {
          "s": 38,
          "text": "מבאר דלעשות צדקה גו'"
        },
        {
          "s": 39,
          "text": "(עם היות שבא בהמשך לושמרו דרך הוי')"
        },
        {
          "s": 40,
          "text": "הוא לא פירוש או פרט בדרך הוי' אלא שהוא ענין נוסף."
        },
        {
          "s": 41,
          "text": "דלאחרי ושמרו דרך הוי',"
        },
        {
          "s": 42,
          "text": "המשכה מלמעלה למטה,"
        },
        {
          "s": 43,
          "text": "באים אח\"כ15"
        },
        {
          "s": 44,
          "text": "לעבודה נעלית יותר,"
        },
        {
          "s": 45,
          "text": "לעשות צדקה,"
        },
        {
          "s": 46,
          "text": "עבודה מלמטה למעלה."
        }
      ]
    }
  ]
}