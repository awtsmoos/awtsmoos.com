{
  "globalIndex": 730,
  "owner": 30,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918033_theRebbe_696__p003",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918033_theRebbe_696__p003",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518918033_theRebbe_696",
  "title": "מאמר כימי צאתך תשל\"ט",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר29,"
        },
        {
          "s": 2,
          "text": "דהתהוות העולמות היא מאור הקו."
        },
        {
          "s": 3,
          "text": "דמהאור שלפני הצמצום לא הי' אפשר להיות התהוות העולמות"
        },
        {
          "s": 4,
          "text": "(כמו שהם עכשיו),"
        },
        {
          "s": 5,
          "text": "כי העולמות הם בבחינת מעלה ומטה"
        },
        {
          "s": 6,
          "text": "[דזהו מה שהגדר דעולם הוא מקום,"
        },
        {
          "s": 7,
          "text": "דענין המקום ברוחניות הוא מעלה ומטה],"
        },
        {
          "s": 8,
          "text": "והאור שלפני הצמצום לא הי' בו ראש וסוף מעלה ומטה."
        },
        {
          "s": 9,
          "text": "וגם,"
        },
        {
          "s": 10,
          "text": "כי כללות האור שלפני הצמצום הוא אור הכלול בעצמותו,"
        },
        {
          "s": 11,
          "text": "והאור הכלול במאור הוא בתכלית הביטול עד שאינו עולה בשם אור כלל30,"
        },
        {
          "s": 12,
          "text": "ובמילא אין שייך שיהי' מקור לעולמות,"
        },
        {
          "s": 13,
          "text": "כי בכדי להיות מקור לאיזה דבר בהכרח שהמקור יהי' בבחינת מציאות."
        },
        {
          "s": 14,
          "text": "ודוקא ע\"י אור הקו,"
        },
        {
          "s": 15,
          "text": "דע\"י שנמשך ע\"י הצמצום הוא בבחינת מציאות אור,"
        },
        {
          "s": 16,
          "text": "ויש בו מעלה ומטה,"
        },
        {
          "s": 17,
          "text": "על ידו דוקא נעשה התהוות העולמות."
        },
        {
          "s": 18,
          "text": "ויש לומר,"
        },
        {
          "s": 19,
          "text": "דשני ענינים אלו שבהקו הם דוגמת שני הענינים הנ\"ל שבעולם."
        },
        {
          "s": 20,
          "text": "דהמעלה ומטה שבהקו הוא דוגמת הגבול דעולם,"
        },
        {
          "s": 21,
          "text": "וזה שהקו הוא מציאות אור"
        },
        {
          "s": 22,
          "text": "(שאינו בתכלית הביטול)"
        },
        {
          "s": 23,
          "text": "הוא דוגמת ההעלם וההסתר דעולם"
        },
        {
          "s": 24,
          "text": "(סיבת הישות שבו)."
        },
        {
          "s": 25,
          "text": "וע\"פ הנ\"ל דזה שהעולמות נק' בשם מצרים הוא מפני שהם בחינת מיצר והעלם"
        },
        {
          "s": 26,
          "text": "(שני ענינים אלו),"
        },
        {
          "s": 27,
          "text": "יש לומר,"
        },
        {
          "s": 28,
          "text": "שגם הקו נכלל בבחינת מצרים,"
        },
        {
          "s": 29,
          "text": "ואמיתית הענין דיציאת מצרים,"
        },
        {
          "s": 30,
          "text": "היציאה מכל המיצרים וההגבלות,"
        },
        {
          "s": 31,
          "text": "הוא ע\"י הגילוי דעצמות אוא\"ס שלפני הצמצום."
        },
        {
          "s": 32,
          "text": "וזהו שבגאולה העתידה תהי' השלימות דיציאת מצרים"
        },
        {
          "s": 33,
          "text": "(היציאה מכל המיצרים וההגבלות),"
        },
        {
          "s": 34,
          "text": "כי אז יהי' גילוי האור שלפני הצמצום,"
        },
        {
          "s": 35,
          "text": "ובזה גופא – גילוי אור הבל\"ג שלמעלה מהאור השייך לעולמות,"
        },
        {
          "s": 36,
          "text": "ועד לגילוי העצמות."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה זה שלעת\"ל תהי' היציאה מכל המיצרים וההגבלות,"
        },
        {
          "s": 2,
          "text": "הוא בנוגע לכל הענינים."
        },
        {
          "s": 3,
          "text": "שכל הענינים דלע\"ל יהיו באין ערוך לגבי כמו שהם עכשיו."
        },
        {
          "s": 4,
          "text": "הן בנוגע להעולם,"
        },
        {
          "s": 5,
          "text": "שאז יהיו שמים חדשים וארץ חדשה31"
        },
        {
          "s": 6,
          "text": "(עולם חדש),"
        },
        {
          "s": 7,
          "text": "והן בנוגע לתורה"
        },
        {
          "s": 8,
          "text": "[שעל ידה נברא העולם,"
        },
        {
          "s": 9,
          "text": "אסתכל באורייתא וברא עלמא32],"
        },
        {
          "s": 10,
          "text": "שלע\"ל יהי' תורה חדשה מאתי תצא33,"
        },
        {
          "s": 11,
          "text": "והן בנוגע להמשכת וגילוי אלקות,"
        },
        {
          "s": 12,
          "text": "שהגילוי אלקות שיהי' לע\"ל הוא גילוי חדש שנעלה באין ערוך מהגילוי דעכשיו,"
        },
        {
          "s": 13,
          "text": "דכל הגילויים דעכשיו הם מחיצוניות עתיק ולע\"ל יהי' הגילוי דפנימיות עתיק34."
        },
        {
          "s": 14,
          "text": "וזהו מה שהגאולה העתידה תהי' בעיקר ע\"י העבודה שבסיום זמן הגלות,"
        },
        {
          "s": 15,
          "text": "כי מכיון שכל הענינים דלע\"ל יהיו ענינים חדשים,"
        },
        {
          "s": 16,
          "text": "לכן,"
        },
        {
          "s": 17,
          "text": "גם העבודה שעל ידה נמשכים ענינים אלו צריכה להיות עבודה חדשה,"
        },
        {
          "s": 18,
          "text": "כדלקמן."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "והענין הוא,"
        },
        {
          "s": 1,
          "text": "דבזמן הבית,"
        },
        {
          "s": 2,
          "text": "שהי' אז גילוי אלקות,"
        },
        {
          "s": 3,
          "text": "עשרה נסים נעשו לאבותינו בבית המקדש35,"
        },
        {
          "s": 4,
          "text": "שנסים אלו היו נראים בעיני בשר ועד שכמה מהם היו נראים גם לעמי הארץ,"
        },
        {
          "s": 5,
          "text": "העבודה דקיום התומ\"צ היתה ע\"פ טעם ודעת."
        },
        {
          "s": 6,
          "text": "ואף שגם אז הי' הציווי36"
        },
        {
          "s": 7,
          "text": "ואהבת גו' בכל לבבך ובכל נפשך ובכל מאדך,"
        },
        {
          "s": 8,
          "text": "מ\"מ,"
        },
        {
          "s": 9,
          "text": "מכיון שראו אז גילוי אלקות במוחש,"
        },
        {
          "s": 10,
          "text": "גם בהמס\"נ שהיתה אז,"
        },
        {
          "s": 11,
          "text": "הי' מדידה והגבלה דטעם ודעת."
        },
        {
          "s": 12,
          "text": "ועד\"ז בזמן הגלות כשלא הי' התגברות החושך כ\"כ."
        },
        {
          "s": 13,
          "text": "משא\"כ בדרא דעקבתא דמשיחא,"
        },
        {
          "s": 14,
          "text": "שבכל יום נעשה התגברות החושך37,"
        },
        {
          "s": 15,
          "text": "וישנם כמה נסיונות,"
        },
        {
          "s": 16,
          "text": "ובפרט הנסיון דאל יבוש מפני המלעיגים38,"
        },
        {
          "s": 17,
          "text": "ומכ\"ש כשהמלעיגים הם אנשים פחותים וריקים,"
        },
        {
          "s": 18,
          "text": "שזה קשה מאד לסבול39,"
        },
        {
          "s": 19,
          "text": "הנה זה שעומדים בנסיונות אלו,"
        },
        {
          "s": 20,
          "text": "הוא עבודה דמסירת נפש שלמעלה ממדידה והגבלה."
        },
        {
          "s": 21,
          "text": "וזהו שהעבודה שבדרא דעקבתא דמשיחא,"
        },
        {
          "s": 22,
          "text": "ובדור זה גופא – בהסיום דזמן הגלות,"
        },
        {
          "s": 23,
          "text": "היא נעלית יותר"
        },
        {
          "s": 24,
          "text": "(בענין זה)"
        },
        {
          "s": 25,
          "text": "מהעבודות שהיו עד עכשיו40,"
        },
        {
          "s": 26,
          "text": "ובאופן דאין ערוך,"
        },
        {
          "s": 27,
          "text": "ועד שהיא עבודה חדשה,"
        },
        {
          "s": 28,
          "text": "כי עניני העבודה שבדורות הקודמים,"
        },
        {
          "s": 29,
          "text": "הי' להם איזו שייכות לטעם ודעת"
        },
        {
          "s": 30,
          "text": "(מדידה והגבלה דכחות הגלויים),"
        },
        {
          "s": 31,
          "text": "והעבודה שבסיום זמן הגלות היא העבודה דמס\"נ שמצד פנימיות הנשמה."
        }
      ]
    }
  ]
}