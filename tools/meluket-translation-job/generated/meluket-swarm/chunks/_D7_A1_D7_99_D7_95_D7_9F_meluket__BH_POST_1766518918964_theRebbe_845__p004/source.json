{
  "globalIndex": 880,
  "owner": 30,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918964_theRebbe_845__p004",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918964_theRebbe_845__p004",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918964_theRebbe_845",
  "title": "מאמר והנה פרח מטה אהרן תשל\"ג",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "והנה28 העיכוב שיכול להיות בההמשכה ממדריגה למדריגה הוא כשהרצון שלו בהדבר הוא מצד השכל."
        },
        {
          "s": 2,
          "text": "משא\"כ כשהרצון הוא לפי שיש לו תענוג בזה,"
        },
        {
          "s": 3,
          "text": "ובפרט כשיש תענוג עצמי שלמעלה מהשכל,"
        },
        {
          "s": 4,
          "text": "אזי,"
        },
        {
          "s": 5,
          "text": "ההמשכה מהרצון עד להמעשה היא במהירות,"
        },
        {
          "s": 6,
          "text": "בלי עיכוב."
        },
        {
          "s": 7,
          "text": "דכשעולה ברצונו לרצות בהדבר,"
        },
        {
          "s": 8,
          "text": "פועל הרצון מיד על השכל,"
        },
        {
          "s": 9,
          "text": "שיבין בשכלו שראוי לרצות בהדבר,"
        },
        {
          "s": 10,
          "text": "ומהשכל נמשך מיד להמחשבה ומהמחשבה לדיבור ומדיבור למעשה."
        },
        {
          "s": 11,
          "text": "וכל המשכות אלה הם במהירות בלי עיכוב."
        },
        {
          "s": 12,
          "text": "ושני ענינים בזה."
        },
        {
          "s": 13,
          "text": "שלאחרי שהחליט בשכלו כללות הענין אינו צריך להתייעץ ולדון אם ראוי לחשוב לדבר ולעשות."
        },
        {
          "s": 14,
          "text": "ויתירה מזו,"
        },
        {
          "s": 15,
          "text": "שכל המשכות אלה"
        },
        {
          "s": 16,
          "text": "[מהשכל למחשבה,"
        },
        {
          "s": 17,
          "text": "מהמחשבה לדיבור ומדיבור למעשה]"
        },
        {
          "s": 18,
          "text": "הם באופן דבדרך ממילא,"
        },
        {
          "s": 19,
          "text": "כי מצד גודל הרצון והתענוג בהדבר לא ישקוט ולא ינוח עד שיהי' הדבר במעשה בפועל."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ועד\"ז הוא בהנמשל למעלה,"
        },
        {
          "s": 1,
          "text": "דכששורש ההמשכה הוא מבחינת רב חסד שלמעלה מהשתלשלות,"
        },
        {
          "s": 2,
          "text": "אזי,"
        },
        {
          "s": 3,
          "text": "נמשכת ההשפעה למטה,"
        },
        {
          "s": 4,
          "text": "על ידי הדרגות דכל סדר ההשתלשלות,"
        },
        {
          "s": 5,
          "text": "במהירות גדולה בלי עיכובים29."
        },
        {
          "s": 6,
          "text": "דנוסף לזה שבהמשכה זו אין דינים שיעכבו ההמשכות שממדריגה למדריגה29,"
        },
        {
          "s": 7,
          "text": "הנה גם ההמשכות עצמם הם באופן דבדרך ממילא."
        },
        {
          "s": 8,
          "text": "וזהו שההמשכה דברכת כהנים היא במהירות,"
        },
        {
          "s": 9,
          "text": "כי ההמשכה דברכת כהנים היא מלמעלה מהשתלשלות"
        },
        {
          "s": 10,
          "text": "[כמבואר במק\"א30"
        },
        {
          "s": 11,
          "text": "שבברכת כהנים יש גם המעלה דתפלה,"
        },
        {
          "s": 12,
          "text": "שע\"י התפלה נמשך רצון חדש שלמעלה מהשתלשלות],"
        },
        {
          "s": 13,
          "text": "ולכן ההמשכה היא במהירות."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ויש להוסיף עוד ענין בהמעלה דברכת כהנים,"
        },
        {
          "s": 2,
          "text": "שההמשכה דברכת כהנים היא מלמעלה מעלה ביותר"
        },
        {
          "s": 3,
          "text": "[וכנ\"ל ששורש ההמשכה היא למעלה מהשתלשלות]"
        },
        {
          "s": 4,
          "text": "עד למטה מטה ביותר"
        },
        {
          "s": 5,
          "text": "[וכנ\"ל שההמשכה דברכת כהנים היא גם לאלה שמצד מדת הדין אינם ראויים]."
        },
        {
          "s": 6,
          "text": "וכיון שההמשכה דברכת כהנים היא במהירות ואינה מתעכבת,"
        },
        {
          "s": 7,
          "text": "לכן,"
        },
        {
          "s": 8,
          "text": "כשההשפעה נמשכת למטה היא בריבוי גדול."
        },
        {
          "s": 9,
          "text": "ועפ\"ז יש לבאר המשך הענינים בהדרוש שבלקו\"ת31,"
        },
        {
          "s": 10,
          "text": "שלאחרי שמבאר שההמשכה דברכת כהנים היא במהירות,"
        },
        {
          "s": 11,
          "text": "מביא דרשת רז\"ל32"
        },
        {
          "s": 12,
          "text": "עה\"פ33"
        },
        {
          "s": 13,
          "text": "יברכך ה' וישמרך,"
        },
        {
          "s": 14,
          "text": "יברכך בממון כו' יברכך בבנים כו' וישמרך מן המזיקים,"
        },
        {
          "s": 15,
          "text": "דלכאורה אינו מובן,"
        },
        {
          "s": 16,
          "text": "הרי בדרשת רז\"ל הנ\"ל מבואר רק מהי ההמשכה"
        },
        {
          "s": 17,
          "text": "(ברכה בממון ובבנים ושמירה מן המזיקים),"
        },
        {
          "s": 18,
          "text": "ובלקו\"ת מביא דרשה זו לענין שההמשכה היא במהירות,"
        },
        {
          "s": 19,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 20,
          "text": "דיברכך בממון ובבנים מורה על ריבוי ההשפעה שההשפעה היא בכל הענינים דבני חיי ומזוני"
        },
        {
          "s": 21,
          "text": "[דביברכך בממון נכלל גם הברכה על חיי,"
        },
        {
          "s": 22,
          "text": "דכי יהיב רחמנא שובעא לחיי הוא דיהיב34],"
        },
        {
          "s": 23,
          "text": "וענין וישמרך מן המזיקין מורה שהמשכת ההשפעה היא למטה מטה ביותר,"
        },
        {
          "s": 24,
          "text": "אפילו למקום שצריך לשמירה מן המזיקין,"
        },
        {
          "s": 25,
          "text": "והחיבור דשני ענינים אלה,"
        },
        {
          "s": 26,
          "text": "שגם כשההשפעה נמשכת למטה מטה"
        },
        {
          "s": 27,
          "text": "(וישמרך מן המזיקין)"
        },
        {
          "s": 28,
          "text": "היא בריבוי גדול"
        },
        {
          "s": 29,
          "text": "(יברכך בממון ובבנים),"
        },
        {
          "s": 30,
          "text": "הוא לפי שההמשכה היא במהירות ואינה מתעכבת."
        }
      ]
    }
  ]
}