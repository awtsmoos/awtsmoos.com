{
  "globalIndex": 1014,
  "owner": 14,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919787_theRebbe_472__p003",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919787_theRebbe_472__p003",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919787_theRebbe_472",
  "title": "מאמר איכה ישבה בדד תשל\"א",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וזהו איכה ישבה בדד העיר רבתי עם גו',"
        },
        {
          "s": 2,
          "text": "איכה בתמי' – דישראל שהיו בדרגת עם,"
        },
        {
          "s": 3,
          "text": "גחלים עוממות כו'52,"
        },
        {
          "s": 4,
          "text": "ורבתי עם"
        },
        {
          "s": 5,
          "text": "(כפשוטו)"
        },
        {
          "s": 6,
          "text": "ריבוי ההתחלקות כו' ורבתי בדיעות53"
        },
        {
          "s": 7,
          "text": "ריבוי הדיעות,"
        },
        {
          "s": 8,
          "text": "ד\"ע וד\"ת54."
        },
        {
          "s": 9,
          "text": "דהנה כתיב55"
        },
        {
          "s": 10,
          "text": "כי א-ל דיעות הוי'"
        },
        {
          "s": 11,
          "text": "(דיעות לשון רבים56),"
        },
        {
          "s": 12,
          "text": "וידוע תורת אדמו\"ר הזקן57"
        },
        {
          "s": 13,
          "text": "שצ\"ל מתאחדים יחד ולמעלה מזה – שמעלה ומטה שווין,"
        },
        {
          "s": 14,
          "text": "א-ל דיעות הוי' – שכולל ב' הדיעות יחד,"
        },
        {
          "s": 15,
          "text": "הנה היא רבתי בדיעות,"
        },
        {
          "s": 16,
          "text": "ד\"ע וד\"ת ובכמה אופנים."
        },
        {
          "s": 17,
          "text": "היתה כאלמנה – שבעלה הלך למדינת הים58,"
        },
        {
          "s": 18,
          "text": "ענין בעלה – באתכסיא,"
        },
        {
          "s": 19,
          "text": "רבתי בגוים הו\"ע ההתלבשות בעניני ע' אומות כו',"
        },
        {
          "s": 20,
          "text": "שרתי במדינות – גם כח ההתנשאות והתוקף הוא – במדינות59"
        },
        {
          "s": 21,
          "text": "הייתה למס."
        },
        {
          "s": 22,
          "text": "אבל כ\"ז הוא לעילוי': שרתי אותיות תשרי,"
        },
        {
          "s": 23,
          "text": "שאז בנין המלכות להיות שרתי במדינות60,"
        },
        {
          "s": 24,
          "text": "היתה למס הוא הביטול דקב\"ע,"
        },
        {
          "s": 25,
          "text": "שדוקא בזמן ההעלם וההסתר,"
        },
        {
          "s": 26,
          "text": "כשהיא רבתי עם גו' שרתי במדינות,"
        },
        {
          "s": 27,
          "text": "הנה אז דוקא הוא הביטול דקב\"ע,"
        },
        {
          "s": 28,
          "text": "שהיתה למס,"
        },
        {
          "s": 29,
          "text": "אשר אינו מציאות לעצמו והוא רק למס."
        },
        {
          "s": 30,
          "text": "וכידוע שהעבודה בזה\"ג ובפרט בעקבתי' דמשיחא הוא לא בבחי' המוחין ולא בבחי' המדות כ\"א העבודה דקב\"ע"
        },
        {
          "s": 31,
          "text": "(וכנ\"ל בפי' האיש משה עניו)."
        },
        {
          "s": 32,
          "text": "ועי\"ז דוקא נעשה ישבה בדד,"
        },
        {
          "s": 33,
          "text": "גילוי בחי' בדד שלמעלה מהשתלשלות,"
        },
        {
          "s": 34,
          "text": "יחיד,"
        },
        {
          "s": 35,
          "text": "שלמעלה גם מע\"ס הגנוזות – באופן דישבה."
        },
        {
          "s": 36,
          "text": "וכביאור כ\"ק אדמו\"ר האמצעי61"
        },
        {
          "s": 37,
          "text": "בפירוש אנת הוא חד ולא בחושבן,"
        },
        {
          "s": 38,
          "text": "שהוא למעלה גם מע\"ס הגנוזות."
        },
        {
          "s": 39,
          "text": "ובזה יובן תיווך ב' הפירושים באיכה ישבה בדד,"
        },
        {
          "s": 40,
          "text": "פירוש הפשוט ופירוש הצ\"צ שקאי על העילוי והגילוי דבחי' בדד,"
        },
        {
          "s": 41,
          "text": "כי הגילוי דבחי' בדד שלמעלה מהשתלשלות הוא ע\"י העבודה דקב\"ע שבזמן הגלות דוקא,"
        },
        {
          "s": 42,
          "text": "כנ\"ל."
        },
        {
          "s": 43,
          "text": "וזהו איכה ישבה בדד גו' איכה לשון תמי' ופליאה,"
        },
        {
          "s": 44,
          "text": "שיבוא מרבתי עם,"
        },
        {
          "s": 45,
          "text": "עוממות ורבתי בזה וכו' לבדד שלמעלה מהשתלשלות ובאופן דישבה הו\"ע של פליאה."
        },
        {
          "s": 46,
          "text": "(ועוד י\"ל שהגילוי והתיישבות דבחי' בדד שלמעלה מהשתלשלות,"
        },
        {
          "s": 47,
          "text": "ה\"ז שלא ע\"פ השתלשלות,"
        },
        {
          "s": 48,
          "text": "למעלה מטו\"ד62."
        },
        {
          "s": 49,
          "text": "ולכן גם העבודה שעי\"ז יומשך הגילוי דבחי' בדד,"
        },
        {
          "s": 50,
          "text": "הו\"ע עבודת התשובה63,"
        },
        {
          "s": 51,
          "text": "שענין התשובה הוא העבודה שלמעלה מהשתלשלות בנפש האדם)."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "והנה השייכות דבחי' בדד,"
        },
        {
          "s": 2,
          "text": "בחי' יחיד,"
        },
        {
          "s": 3,
          "text": "ליעקב דוקא"
        },
        {
          "s": 4,
          "text": "(כמ\"ש בטח בדד עין יעקב)"
        },
        {
          "s": 5,
          "text": "הוא,"
        },
        {
          "s": 6,
          "text": "כי הנה נת\"ל שבדד הוא בחי' עתיק,"
        },
        {
          "s": 7,
          "text": "שלמעלה מב' הקוין ימין ושמאל,"
        },
        {
          "s": 8,
          "text": "וכמאמר64"
        },
        {
          "s": 9,
          "text": "ולית שמאלא בהאי עתיקא,"
        },
        {
          "s": 10,
          "text": "ולכן גילוי בחי' זו הוא ע\"י העבודה בקו השלישי דוקא."
        },
        {
          "s": 11,
          "text": "וכמ\"ש ציון במשפט תפדה ומפרש כ\"ק אדמו\"ר הצמח צדק65"
        },
        {
          "s": 12,
          "text": "שהמשפט הוא דוקא בשלשה66"
        },
        {
          "s": 13,
          "text": "כו' דהיינו חג\"ת."
        },
        {
          "s": 14,
          "text": "והיינו שעשיית הדירה לו ית' ובאופן של שלימות הוא ע\"י העבודה בכל ג' הקוין דוקא,"
        },
        {
          "s": 15,
          "text": "וכביאור כ\"ק מו\"ח אדמו\"ר במשנה על שלשה דברים העולם עומד67,"
        },
        {
          "s": 16,
          "text": "שע\"י העבודה בג' הקוין,"
        },
        {
          "s": 17,
          "text": "תורה עבודה וגמ\"ח,"
        },
        {
          "s": 18,
          "text": "העולם עומד,"
        },
        {
          "s": 19,
          "text": "שנשלמה הכוונה דבריאת העולם."
        },
        {
          "s": 20,
          "text": "וזהו ג\"כ ענינו של בית השלישי,"
        },
        {
          "s": 21,
          "text": "קו השלישי,"
        },
        {
          "s": 22,
          "text": "בחי' נחלה בלי מצרים דיעקב,"
        },
        {
          "s": 23,
          "text": "שבו תהי'"
        },
        {
          "s": 24,
          "text": "(גם)"
        },
        {
          "s": 25,
          "text": "ההתכללות דבית ראשון ובית שני68."
        },
        {
          "s": 26,
          "text": "וזה יהי' למעלה גם מכמו שהי' בג\"ע מקדם,"
        },
        {
          "s": 27,
          "text": "היינו גם מכמו שהי' בג\"ע קודם החטא69,"
        },
        {
          "s": 28,
          "text": "וכידוע בענין אדם ומשיח,"
        },
        {
          "s": 29,
          "text": "שאדם הוא ר\"ת אדם דוד משיח70,"
        },
        {
          "s": 30,
          "text": "והצירוף הוא בסדר אד\"ם – שמורה על סדר וכו' משא\"כ במשיח כתיב71"
        },
        {
          "s": 31,
          "text": "הנה ישכיל עבדי ירום ונשא וגבה מאד,"
        },
        {
          "s": 32,
          "text": "מאד אותיות אדם,"
        },
        {
          "s": 33,
          "text": "אבל בצירוף המורה על בל\"ג,"
        },
        {
          "s": 34,
          "text": "היפך ענין הציור דאדם."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "והנה כאמור לעיל הגילוי דלעתיד ממשיכים ע\"י העבודה עכשיו דוקא."
        },
        {
          "s": 2,
          "text": "שמזה מובן שישנה מעלה בהעבודה דעכשיו גם על הגילוי דלעתיד,"
        },
        {
          "s": 3,
          "text": "וכמו שמבאר כ\"ק אדמו\"ר מהר\"ש בפירוש המשנה72"
        },
        {
          "s": 4,
          "text": "יפה שעה אחת בתשובה ומע\"ט בעוה\"ז מכל חיי עוה\"ב,"
        },
        {
          "s": 5,
          "text": "דמאחר שהעבודה בתשובה ומע\"ט בעוה\"ז הוא הגורם לחיי עוה\"ב"
        },
        {
          "s": 6,
          "text": "(כולל גם הגילויים דלעתיד)"
        },
        {
          "s": 7,
          "text": "הרי בהכרח שיש מעלה בהעבודה דעוה\"ז על הגילויים דלעתיד,"
        },
        {
          "s": 8,
          "text": "כי דבר הגורם הוא חזק יותר מהדבר שנעשה על ידו."
        },
        {
          "s": 9,
          "text": "וגם בענין התענוג,"
        },
        {
          "s": 10,
          "text": "שבחי' נחלה בלי מצרים דיעקב הוא בהזמן דרעוא דרעוין"
        },
        {
          "s": 11,
          "text": "(ענין התענוג),"
        },
        {
          "s": 12,
          "text": "יש מעלה בהעבודה דעכשיו דוקא,"
        },
        {
          "s": 13,
          "text": "וכמו שמבאר שם לפני זה73"
        },
        {
          "s": 14,
          "text": "שהתענוג דלעתיד הוא"
        },
        {
          "s": 15,
          "text": "(בכללות)"
        },
        {
          "s": 16,
          "text": "נח\"ר דהנברא והתענוג דתשובה ומע\"ט בעוה\"ז הוא"
        },
        {
          "s": 17,
          "text": "(בכללות)"
        },
        {
          "s": 18,
          "text": "נח\"ר דהבורא,"
        },
        {
          "s": 19,
          "text": "נח\"ר לפני74"
        },
        {
          "s": 20,
          "text": "שאמרתי ונעשה רצוני."
        }
      ]
    }
  ]
}