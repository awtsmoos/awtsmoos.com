{
  "globalIndex": 786,
  "owner": 36,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918472_theRebbe_445__p002",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918472_theRebbe_445__p002",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918472_theRebbe_445",
  "title": "מאמר לה\"ע פסח שני תשל\"ח",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ואולי יש להוסיף,"
        },
        {
          "s": 2,
          "text": "שהמעלה דפסח שני לגבי פסח ראשון היא לא רק שהדילוג דפסח שני נמשך במקום נעלה יותר,"
        },
        {
          "s": 3,
          "text": "אלא שגם הדילוג עצמו הוא דילוג נעלה יותר."
        },
        {
          "s": 4,
          "text": "וכמובן גם מזה שנקרא בשם פסח שני,"
        },
        {
          "s": 5,
          "text": "דפירוש הפשוט דפסח שני הוא לא"
        },
        {
          "s": 6,
          "text": "(רק)"
        },
        {
          "s": 7,
          "text": "שהפסח"
        },
        {
          "s": 8,
          "text": "(הדילוג)"
        },
        {
          "s": 9,
          "text": "נמשך בדרגא דשני אלא ש"
        },
        {
          "s": 10,
          "text": "(גם)"
        },
        {
          "s": 11,
          "text": "הפסח"
        },
        {
          "s": 12,
          "text": "(הדילוג)"
        },
        {
          "s": 13,
          "text": "הוא שני,"
        },
        {
          "s": 14,
          "text": "דילוג נעלה יותר מהדילוג דפסח ראשון."
        },
        {
          "s": 15,
          "text": "ומ\"ש בהמאמר דפירוש פסח שני הוא שהדילוג דפסח שני נמשך בהדרגא דשני"
        },
        {
          "s": 16,
          "text": "(יסוד),"
        },
        {
          "s": 17,
          "text": "הוא,"
        },
        {
          "s": 18,
          "text": "כי מעלת הדילוג דפסח שני"
        },
        {
          "s": 19,
          "text": "(שהדילוג הוא נעלה יותר)"
        },
        {
          "s": 20,
          "text": "נראה"
        },
        {
          "s": 21,
          "text": "(גם)"
        },
        {
          "s": 22,
          "text": "בזה שהדילוג נמשך בהדרגא דשני"
        },
        {
          "s": 23,
          "text": "(כדלקמן סעיף ה)."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש לקשר הביאור הנ\"ל"
        },
        {
          "s": 1,
          "text": "(דהצ\"צ)"
        },
        {
          "s": 2,
          "text": "שפסח שני הוא דרגא שני' ונעלית בעבודה הבאה לאחרי הקדמת העבודה דפסח ראשון,"
        },
        {
          "s": 3,
          "text": "עם הענין דפסח שני כמו שהוא בפשטות,"
        },
        {
          "s": 4,
          "text": "שהוא תיקון והשלמה למי שלא הקריב פסח18,"
        },
        {
          "s": 5,
          "text": "כי זה שפסח שני מתקן ומשלים החסרון דזה שלא הקריב פסח הוא מפני שהגילוי דפסח שני הוא דילוג שלא בהדרגה,"
        },
        {
          "s": 6,
          "text": "שאין בו מדידות והגבלות,"
        },
        {
          "s": 7,
          "text": "גם לא המדידות וההגבלות של הדילוג דפסח"
        },
        {
          "s": 8,
          "text": "(ראשון)19,"
        },
        {
          "s": 9,
          "text": "ולגבי גילוי זה – \"איז ניטאָ קיין פאַרפאַלן\"20."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים הידוע21"
        },
        {
          "s": 2,
          "text": "דמהחילוקים בין ז\"א למלכות הוא,"
        },
        {
          "s": 3,
          "text": "שהמלכות היא קצה העליון"
        },
        {
          "s": 4,
          "text": "(מקור)"
        },
        {
          "s": 5,
          "text": "דבי\"ע,"
        },
        {
          "s": 6,
          "text": "וז\"א הוא קצה התחתון דאצילות."
        },
        {
          "s": 7,
          "text": "וכיון שבאצילות לא יגורך רע22,"
        },
        {
          "s": 8,
          "text": "מובן דזה שע\"י היסוד"
        },
        {
          "s": 9,
          "text": "(ז\"א)"
        },
        {
          "s": 10,
          "text": "נעשה שלימות הבירור,"
        },
        {
          "s": 11,
          "text": "הענין דאתהפכא,"
        },
        {
          "s": 12,
          "text": "הוא כמו שהוא נמשך לברר23,"
        },
        {
          "s": 13,
          "text": "ועיקר העבודה שמצד ז\"א הוא"
        },
        {
          "s": 14,
          "text": "(לא ענין הבירורים,"
        },
        {
          "s": 15,
          "text": "אלא)"
        },
        {
          "s": 16,
          "text": "להמשיך אור24."
        },
        {
          "s": 17,
          "text": "וכמו שהוא בנוגע לספירת היסוד"
        },
        {
          "s": 18,
          "text": "(ענינו של חודש השני בספירות),"
        },
        {
          "s": 19,
          "text": "עד\"ז הוא גם בנוגע להעבודה דספירת העומר"
        },
        {
          "s": 20,
          "text": "(ענינו של חודש השני בעבודת האדם),"
        },
        {
          "s": 21,
          "text": "שעיקר ענינה"
        },
        {
          "s": 22,
          "text": "(לפי ביאור אחד25)"
        },
        {
          "s": 23,
          "text": "הוא לא בירור המדות דנפש הבהמית אלא המשכת מ\"ט שערי בינה,"
        },
        {
          "s": 24,
          "text": "ועד שעי\"ז נמשך גם שער הנו\"ן26."
        },
        {
          "s": 25,
          "text": "ויש לומר,"
        },
        {
          "s": 26,
          "text": "דזהו גם מה שאייר הוא ר\"ת אברהם יצחק יעקב רחל27,"
        },
        {
          "s": 27,
          "text": "שהם ד' רגלי המרכבה,"
        },
        {
          "s": 28,
          "text": "שהביטול דמרכבה הוא באופן שמלכתחילה אין מקום לענין של ישות ומכ\"ש לרע שצריך לפעול בו ביטול,"
        },
        {
          "s": 29,
          "text": "וכמבואר בתניא28"
        },
        {
          "s": 30,
          "text": "בענין האבות הן הן המרכבה29"
        },
        {
          "s": 31,
          "text": "שלא נעשו מרכבה רק לרצון העליון לבדו כל ימיהם."
        }
      ]
    }
  ]
}