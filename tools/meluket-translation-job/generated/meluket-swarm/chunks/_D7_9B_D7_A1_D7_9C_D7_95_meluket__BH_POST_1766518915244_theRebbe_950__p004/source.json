{
  "globalIndex": 245,
  "owner": 45,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915244_theRebbe_950__p004",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915244_theRebbe_950__p004",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915244_theRebbe_950",
  "title": "מאמר פדה בשלום תשכ\"ב",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וזהו ושבתי ב."
        },
        {
          "s": 2,
          "text": "שלום,"
        },
        {
          "s": 3,
          "text": "וכן פדה ב."
        },
        {
          "s": 4,
          "text": "שלום,"
        },
        {
          "s": 5,
          "text": "שלום מלמעלה למטה ושלום מלמטה למעלה,"
        },
        {
          "s": 6,
          "text": "שהבירור דנפש הבהמית"
        },
        {
          "s": 7,
          "text": "(פדה בשלום נפשי)"
        },
        {
          "s": 8,
          "text": "וכן בירור הנצוצות שבעולם"
        },
        {
          "s": 9,
          "text": "(ושבתי בשלום אל בית אבי)"
        },
        {
          "s": 10,
          "text": "צריך להיות בשני האופנים,"
        },
        {
          "s": 11,
          "text": "בדרך מלמעלה למטה ובדרך מלמטה למעלה,"
        },
        {
          "s": 12,
          "text": "שעי\"ז ישנם שני הענינים"
        },
        {
          "s": 13,
          "text": "(מעלות)"
        },
        {
          "s": 14,
          "text": "דשלום."
        },
        {
          "s": 15,
          "text": "ולהוסיף,"
        },
        {
          "s": 16,
          "text": "שהשלימות דשלום"
        },
        {
          "s": 17,
          "text": "(שלום גם מלשון שלימות)"
        },
        {
          "s": 18,
          "text": "הוא כשהשלום"
        },
        {
          "s": 19,
          "text": "(שבכל אחד דשני האופנים)"
        },
        {
          "s": 20,
          "text": "כולל שתי המעלות."
        },
        {
          "s": 21,
          "text": "שגם בהבירור שבדרך מלמטה למעלה יש"
        },
        {
          "s": 22,
          "text": "(מעין)"
        },
        {
          "s": 23,
          "text": "הענין דאתהפכא,"
        },
        {
          "s": 24,
          "text": "ושגם בהבירור שבדרך מלמעלה למטה יש"
        },
        {
          "s": 25,
          "text": "(מעין)"
        },
        {
          "s": 26,
          "text": "המעלה שהבירור הוא מצד ענינו דהתחתון."
        },
        {
          "s": 27,
          "text": "וזהו פדה בשלום נפשי מקרב לי,"
        },
        {
          "s": 28,
          "text": "שגם הענין דפדה בשלום,"
        },
        {
          "s": 29,
          "text": "שהוא"
        },
        {
          "s": 30,
          "text": "(בדרך כלל)"
        },
        {
          "s": 31,
          "text": "הפדי' דנה\"א מהגלות דנה\"ב ע\"י גילוי אור33,"
        },
        {
          "s": 32,
          "text": "תהי' בו המעלה דמקרב לי"
        },
        {
          "s": 33,
          "text": "(קרב מלשון קירוב)34,"
        },
        {
          "s": 34,
          "text": "הבירור דנה\"ב עצמה."
        },
        {
          "s": 35,
          "text": "ועד\"ז לאידך,"
        },
        {
          "s": 36,
          "text": "שגם הבירור שבדרך קרב"
        },
        {
          "s": 37,
          "text": "(מלחמה)"
        },
        {
          "s": 38,
          "text": "יהי' באופן דפדה בשלום,"
        },
        {
          "s": 39,
          "text": "אתהפכא."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "וממשיך הכתוב כי ברבים היו עמדי,"
        },
        {
          "s": 1,
          "text": "ברבים היו עמדי הוא טעם"
        },
        {
          "s": 2,
          "text": "(כי)"
        },
        {
          "s": 3,
          "text": "על פדה בשלום נפשי מקרב לי,"
        },
        {
          "s": 4,
          "text": "דע\"י ההתבוננות בענין היחידה,"
        },
        {
          "s": 5,
          "text": "שעי\"ז מתעורר אצלו ענין הביטול35"
        },
        {
          "s": 6,
          "text": "[היינו,"
        },
        {
          "s": 7,
          "text": "שגם לפני העבודה דפדה בשלום נפשי מקרב לי וצריך עדיין לפדות נפשו האלקית מהמלחמות דנה\"ב,"
        },
        {
          "s": 8,
          "text": "הוא מתעורר בביטול כללי לאלקות,"
        },
        {
          "s": 9,
          "text": "שבא מהיחידה שבו],"
        },
        {
          "s": 10,
          "text": "עי\"ז,"
        },
        {
          "s": 11,
          "text": "הבירור דנה\"ב הוא באופן דפדה בשלום נפשי מקרב לי,"
        },
        {
          "s": 12,
          "text": "שבכל אחד דשני אופני הבירור ישנם שתי המעלות36."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ויש לקשר ענין זה עם מה שמבאר כ\"ק מו\"ח אדמו\"ר במאמרו ד\"ה וכל37"
        },
        {
          "s": 2,
          "text": "בניך לימודי הוי' ורב שלום בניך שאמרו בש\"פ ויצא תרפ\"ט"
        },
        {
          "s": 3,
          "text": "(שבקונטרס דרושי חתונה38),"
        },
        {
          "s": 4,
          "text": "דהתרגום עה\"פ וכל בניך גו' הוא וכל בניך אלפין באורייתא דהוי' וסגי יהי שלם בנך."
        },
        {
          "s": 5,
          "text": "ומבאר39,"
        },
        {
          "s": 6,
          "text": "דזה שמדייק דאלפין באורייתא דהוי'"
        },
        {
          "s": 7,
          "text": "(אף שלכאורה אין זה חידוש,"
        },
        {
          "s": 8,
          "text": "דכולם יודעים שהתורה היא תורת הוי'40)"
        },
        {
          "s": 9,
          "text": "הוא,"
        },
        {
          "s": 10,
          "text": "שלימוד התורה שלהם הוא באופן שנרגש אצלו שהתורה היא תורת הוי'."
        },
        {
          "s": 11,
          "text": "ומוסיף בהמאמר,"
        },
        {
          "s": 12,
          "text": "דפירוש אלפין באורייתא דהוי' הוא,"
        },
        {
          "s": 13,
          "text": "דהגם שלימוד התורה"
        },
        {
          "s": 14,
          "text": "(אולפנא)"
        },
        {
          "s": 15,
          "text": "הוא שמבין ומשיג התורה בשכלו"
        },
        {
          "s": 16,
          "text": "(שכל אנושי),"
        },
        {
          "s": 17,
          "text": "מ\"מ,"
        },
        {
          "s": 18,
          "text": "גם בהלימוד"
        },
        {
          "s": 19,
          "text": "(שכל)"
        },
        {
          "s": 20,
          "text": "שלו נרגש שהתורה היא תורת הוי',"
        },
        {
          "s": 21,
          "text": "אלפין באורייתא דהוי'."
        },
        {
          "s": 22,
          "text": "וע\"י הרגש זה,"
        },
        {
          "s": 23,
          "text": "גם הלימוד"
        },
        {
          "s": 24,
          "text": "(ההשגה)"
        },
        {
          "s": 25,
          "text": "שלו הוא בביטול."
        },
        {
          "s": 26,
          "text": "ובכדי שלימוד התורה יהי' באופן זה,"
        },
        {
          "s": 27,
          "text": "הוא ע\"י הקדמת עבודת התפלה."
        },
        {
          "s": 28,
          "text": "כי ענין התפלה הוא ההתקשרות והביטול לאלקות."
        },
        {
          "s": 29,
          "text": "וע\"י לימוד התורה באופן זה"
        },
        {
          "s": 30,
          "text": "(דוקא)"
        },
        {
          "s": 31,
          "text": "נעשה רב שלום בניך – ריבוי שלום להתלמידי חכמים העוסקים בתורה41,"
        },
        {
          "s": 32,
          "text": "וגם ריבוי שלום בעולם כמו שלמדו רז\"ל42"
        },
        {
          "s": 33,
          "text": "מפסוק זה שתלמידי חכמים מרבים שלום בעולם."
        }
      ]
    }
  ]
}