{
  "globalIndex": 346,
  "owner": 46,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915758_theRebbe_412__p002",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915758_theRebbe_412__p002",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915758_theRebbe_412",
  "title": "מאמר להבין ענין נרות חנוכה תשכ\"ו",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "והנה אור זה"
        },
        {
          "s": 1,
          "text": "(שלמעלה מהשתלשלות,"
        },
        {
          "s": 2,
          "text": "שמאיר בימי חנוכה ובפרט בנרות חנוכה)"
        },
        {
          "s": 3,
          "text": "נמשך ע\"י המס\"נ דמתתיהו ובניו19."
        },
        {
          "s": 4,
          "text": "והיינו20,"
        },
        {
          "s": 5,
          "text": "שהשייכות דאור זה עם החושך שהי' אז,"
        },
        {
          "s": 6,
          "text": "הוא בשני ענינים,"
        },
        {
          "s": 7,
          "text": "מלמטה למעלה ומלמעלה למטה."
        },
        {
          "s": 8,
          "text": "מלמטה למעלה,"
        },
        {
          "s": 9,
          "text": "שמצד גודל החושך שהי' אז נתעורר אצלם כח המס\"נ שלמעלה מהשתלשלות שבאדם,"
        },
        {
          "s": 10,
          "text": "ועי\"ז המשיכו מעצמות אוא\"ס שלמעלה מהשתלשלות."
        },
        {
          "s": 11,
          "text": "ומלמעלה למטה,"
        },
        {
          "s": 12,
          "text": "שע\"י אור זה מאירים גם את החושך."
        },
        {
          "s": 13,
          "text": "וזהו הטעם לכל החילוקים דלעיל שבין נרות חנוכה ונרות המקדש,"
        },
        {
          "s": 14,
          "text": "דהאור שהאיר במקדש"
        },
        {
          "s": 15,
          "text": "(כיון שהמשכתו היתה לא ע\"י מס\"נ)"
        },
        {
          "s": 16,
          "text": "הי' גילוי דהשתלשלות,"
        },
        {
          "s": 17,
          "text": "ז' נרות."
        },
        {
          "s": 18,
          "text": "וכיון שהגילוי דהשתלשלות אין בכחו להאיר את החושך,"
        },
        {
          "s": 19,
          "text": "כי החושך הוא מנגד לגבי',"
        },
        {
          "s": 20,
          "text": "לכן מקום המנורה הי' בפנים"
        },
        {
          "s": 21,
          "text": "(בתוך הקודש)"
        },
        {
          "s": 22,
          "text": "ובימין"
        },
        {
          "s": 23,
          "text": "(דרום),"
        },
        {
          "s": 24,
          "text": "וזמן הדלקת הנרות הי' משך זמן לפני שקיעת החמה."
        },
        {
          "s": 25,
          "text": "ונרות חנוכה"
        },
        {
          "s": 26,
          "text": "(שלאחרי המס\"נ)"
        },
        {
          "s": 27,
          "text": "הם שמונה נרות,"
        },
        {
          "s": 28,
          "text": "אור שלמעלה מהשתלשלות,"
        },
        {
          "s": 29,
          "text": "שמאיר גם את החושך."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ומבאר כ\"ק מו\"ח אדמו\"ר בהמשך הנ\"ל21,"
        },
        {
          "s": 1,
          "text": "שלכן תיקנו שנר חנוכה יהי' על פתח ביתו מבחוץ,"
        },
        {
          "s": 2,
          "text": "לרשות הרבים,"
        },
        {
          "s": 3,
          "text": "אף שלא מצינו מצוה"
        },
        {
          "s": 4,
          "text": "(מלבד פרה אדומה)"
        },
        {
          "s": 5,
          "text": "שצריכה להיות ברשות הרבים,"
        },
        {
          "s": 6,
          "text": "כי ענינם של נרות חנוכה הוא להאיר את החושך דרשות הרבים,"
        },
        {
          "s": 7,
          "text": "כנ\"ל."
        },
        {
          "s": 8,
          "text": "ולכאורה,"
        },
        {
          "s": 9,
          "text": "ביאור זה צריך לביאור נוסף."
        },
        {
          "s": 10,
          "text": "דכיון שהאור שלמעלה מהשתלשלות שמאיר בחנוכה"
        },
        {
          "s": 11,
          "text": "[שאור זה מאיר את החושך דרה\"ר]"
        },
        {
          "s": 12,
          "text": "נמשך ע\"י המס\"נ דמתתי' ובניו,"
        },
        {
          "s": 13,
          "text": "צריך לומר לכאורה,"
        },
        {
          "s": 14,
          "text": "שגם ע\"י המס\"נ דפורים נמשך אור זה"
        },
        {
          "s": 15,
          "text": "[ובפרט שהמס\"נ דחנוכה הי'"
        },
        {
          "s": 16,
          "text": "(בעיקר)"
        },
        {
          "s": 17,
          "text": "רק במתתי' ובניו,"
        },
        {
          "s": 18,
          "text": "והמס\"נ דפורים הי' בכל ישראל22],"
        },
        {
          "s": 19,
          "text": "ואעפ\"כ לא תיקנו בפורים מצוה שצריכה להיות ברה\"ר,"
        },
        {
          "s": 20,
          "text": "רק בחנוכה."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה זה שהאור שהאיר במקדש הי' גילוי דהשתלשלות,"
        },
        {
          "s": 2,
          "text": "שהחושך הוא מנגד לגבי'"
        },
        {
          "s": 3,
          "text": "(כמובא לעיל מהדרושים),"
        },
        {
          "s": 4,
          "text": "הוא בערך האור דחנוכה,"
        },
        {
          "s": 5,
          "text": "אבל בכללות,"
        },
        {
          "s": 6,
          "text": "גם האור שהאיר במקדש הי' גילוי שלמעלה מהשתלשלות,"
        },
        {
          "s": 7,
          "text": "שאין החושך מנגד לגבי'."
        },
        {
          "s": 8,
          "text": "וכמו שנתבאר לעיל"
        },
        {
          "s": 9,
          "text": "(בד\"ה פדה בשלום23)"
        },
        {
          "s": 10,
          "text": "דזה שבנין ביהמ\"ק הי' ע\"י שלמה דוקא"
        },
        {
          "s": 11,
          "text": "(אף שתבנית המקדש נעשה ע\"י דוד)"
        },
        {
          "s": 12,
          "text": "הוא כמ\"ש24"
        },
        {
          "s": 13,
          "text": "הוא"
        },
        {
          "s": 14,
          "text": "(שלמה)"
        },
        {
          "s": 15,
          "text": "יהי' איש מנוחה וגו' ושלום ושקט אתן על ישראל בימיו"
        },
        {
          "s": 16,
          "text": "(ולכן)"
        },
        {
          "s": 17,
          "text": "הוא יבנה בית לשמי גו',"
        },
        {
          "s": 18,
          "text": "וזה שכל הגוים היו בטלים לשלמה"
        },
        {
          "s": 19,
          "text": "[שלכן הי' בימיו שלום ושקט]"
        },
        {
          "s": 20,
          "text": "הוא לפי ששלמה הוא בחינת מלך שהשלום שלו25,"
        },
        {
          "s": 21,
          "text": "אוא\"ס שלמעלה מהשתלשלות,"
        },
        {
          "s": 22,
          "text": "דלגבי גילוי זה"
        },
        {
          "s": 23,
          "text": "(שלמעלה מהשתלשלות)"
        },
        {
          "s": 24,
          "text": "מתבטלים כל המנגדים."
        },
        {
          "s": 25,
          "text": "דגילוי זה"
        },
        {
          "s": 26,
          "text": "(שהאיר ע\"י שלמה)"
        },
        {
          "s": 27,
          "text": "הי' גם לפני שנבנה ביהמ\"ק,"
        },
        {
          "s": 28,
          "text": "ובביהמ\"ק האיר גילוי זה עוד יותר."
        },
        {
          "s": 29,
          "text": "ואעפ\"כ,"
        },
        {
          "s": 30,
          "text": "לגבי הגילוי דחנוכה,"
        },
        {
          "s": 31,
          "text": "גם הגילוי שהאיר בביהמ\"ק הוא בכלל השתלשלות."
        },
        {
          "s": 32,
          "text": "וצריך ביאור בהחילוק שבין הגילוי דביהמ\"ק להגילוי דחנוכה."
        }
      ]
    }
  ]
}