{
  "globalIndex": 531,
  "owner": 31,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916846_theRebbe_939__p002",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916846_theRebbe_939__p002",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916846_theRebbe_939",
  "title": "מאמר באתי לגני תשל\"א",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דכמו שהמשכת השכינה למטה שע\"י עשיית המשכן היתה ע\"י כל ישראל"
        },
        {
          "s": 2,
          "text": "[כמ\"ש10"
        },
        {
          "s": 3,
          "text": "דבר אל בני ישראל גו' ועשו לי מקדש ושכנתי בתוכם,"
        },
        {
          "s": 4,
          "text": "שהציווי לעשות מקדש ולהמשיך עיקר שכינה למטה הוא לכל ישראל],"
        },
        {
          "s": 5,
          "text": "ומ\"ש במדרש שמשה המשיך השכינה למטה הוא,"
        },
        {
          "s": 6,
          "text": "כי עיקר עשיית המשכן וההמשכה שעי\"ז היתה ע\"י משה,"
        },
        {
          "s": 7,
          "text": "וגם על ידו נמשך הנתינת כח לישראל שע\"י ועשו לי מקדש יהי' ושכנתי בתוכם,"
        },
        {
          "s": 8,
          "text": "עד\"ז הוא בנוגע להמשכת השכינה עכשיו,"
        },
        {
          "s": 9,
          "text": "שהיא המשכה נעלית יותר גם מההמשכה שע\"י עשיית המשכן,"
        },
        {
          "s": 10,
          "text": "שהכח שבכאו\"א מישראל להמשיך המשכה זו היא ע\"י הצדיקים ראשי אלפי ישראל שבכל דור,"
        },
        {
          "s": 11,
          "text": "אתפשטותא דמשה שבכל דור11,"
        },
        {
          "s": 12,
          "text": "עד לכ\"ק מו\"ח אדמו\"ר בעל ההילולא נשיא דורינו."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה לאחרי שמבאר בהמאמר"
        },
        {
          "s": 2,
          "text": "(בקיצור)"
        },
        {
          "s": 3,
          "text": "מאמר המדרש בכללותו12,"
        },
        {
          "s": 4,
          "text": "מבאר בפרטיות יותר ובעומק יותר פרטי הענינים."
        },
        {
          "s": 5,
          "text": "בפרק הראשון דהמאמר"
        },
        {
          "s": 6,
          "text": "(הפרק השייך לשנה זו13)"
        },
        {
          "s": 7,
          "text": "מבאר הענין דעיקר שכינה בתחתונים,"
        },
        {
          "s": 8,
          "text": "ובהפרקים שלאחריו העבודה דועשו לי מקדש"
        },
        {
          "s": 9,
          "text": "(וגם העבודה במשכן ומקדש לאחרי עשייתו14)"
        },
        {
          "s": 10,
          "text": "שעל ידה נעשה ושכנתי בתוכם,"
        },
        {
          "s": 11,
          "text": "המשכת עיקר שכינה בתחתונים."
        },
        {
          "s": 12,
          "text": "ומבאר בפרק הראשון,"
        },
        {
          "s": 13,
          "text": "דהטעם על זה שעיקר שכינה בתחתונים היתה הוא כי15"
        },
        {
          "s": 14,
          "text": "תכלית הכוונה בבריאת והתהוות העולמות הוא שנתאוה הקב\"ה להיות לו ית' דירה בתחתונים16."
        },
        {
          "s": 15,
          "text": "ומבאר,"
        },
        {
          "s": 16,
          "text": "דזה שנתאווה הקב\"ה להיות לו ית' דירה בתחתונים הוא שיהי' גילוי אלקות למטה"
        },
        {
          "s": 17,
          "text": "(לא ע\"י המשכה מלמעלה אלא)"
        },
        {
          "s": 18,
          "text": "ע\"י עבודת האדם,"
        },
        {
          "s": 19,
          "text": "ושהעבודה שעל ידה נעשה גילוי אלקות בעולם היא העבודה דאתכפיא ואתהפכא,"
        },
        {
          "s": 20,
          "text": "כמאמר17"
        },
        {
          "s": 21,
          "text": "כד אתכפיא סט\"א אסתלק יקרא דקוב\"ה בכולהו עלמין."
        },
        {
          "s": 22,
          "text": "ומבאר,"
        },
        {
          "s": 23,
          "text": "דפירוש בכולהו עלמין הוא אור שהוא בכולהו עלמין בשוה."
        },
        {
          "s": 24,
          "text": "והוא האור שלמעלה משייכות לעולמות."
        },
        {
          "s": 25,
          "text": "דבאור המתלבש בעולמות יש חילוק בין עולמות עליונים לעולמות תחתונים,"
        },
        {
          "s": 26,
          "text": "כמאמר רז\"ל18"
        },
        {
          "s": 27,
          "text": "נטה ימינו וברא שמים נטה שמאלו וברא ארץ,"
        },
        {
          "s": 28,
          "text": "שההמשכה בשמים"
        },
        {
          "s": 29,
          "text": "(עולמות העליונים)"
        },
        {
          "s": 30,
          "text": "היא מבחי' ימין,"
        },
        {
          "s": 31,
          "text": "וההמשכה בארץ"
        },
        {
          "s": 32,
          "text": "(עולמות תחתונים)"
        },
        {
          "s": 33,
          "text": "היא מבחי' שמאל."
        },
        {
          "s": 34,
          "text": "ובחי' בכולהו עלמין,"
        },
        {
          "s": 35,
          "text": "האור שהוא בכל העולמות בשוה,"
        },
        {
          "s": 36,
          "text": "הוא האור שלמעלה משייכות לעולמות."
        },
        {
          "s": 37,
          "text": "וזהו כד אתכפיא סט\"א אסתלק יקרא דקוב\"ה בכולהו עלמין,"
        },
        {
          "s": 38,
          "text": "שע\"י העבודה דאתכפיא ואתהפכא19"
        },
        {
          "s": 39,
          "text": "נמשך20"
        },
        {
          "s": 40,
          "text": "האור שהוא בכולהו עלמין בשוה,"
        },
        {
          "s": 41,
          "text": "אור שלמעלה משייכות לעולמות."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "וצריך להבין,"
        },
        {
          "s": 1,
          "text": "דלכאורה,"
        },
        {
          "s": 2,
          "text": "הטעם על זה שעיקר שכינה בתחתונים היתה הוא כי נתאוה הקב\"ה להיות לו ית' דירה בתחתונים,"
        },
        {
          "s": 3,
          "text": "ומה נוגע כאן לבאר שעשיית הדירה צריכה להיות ע\"י עבודת האדם,"
        },
        {
          "s": 4,
          "text": "ושהעבודה שעל ידה נעשית הדירה היא העבודה דאתכפיא ואתהפכא,"
        },
        {
          "s": 5,
          "text": "ושע\"י עבודה זו הוא המשכת האור שלמעלה משייכות לעולמות."
        }
      ]
    }
  ]
}