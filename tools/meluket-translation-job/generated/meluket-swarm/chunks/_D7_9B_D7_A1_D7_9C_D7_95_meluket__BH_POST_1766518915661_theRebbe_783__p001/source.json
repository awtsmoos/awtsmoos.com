{
  "globalIndex": 331,
  "owner": 31,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915661_theRebbe_783__p001",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915661_theRebbe_783__p001",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915661_theRebbe_783",
  "title": "מאמר פדה בשלום תשכ\"ו",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "י\"ט כסלו ה'תשכ\"ו"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "פדה בשלום נפשי מקרב לי כי ברבים היו עמדי1,"
        },
        {
          "s": 1,
          "text": "וכותב רבינו הזקן"
        },
        {
          "s": 2,
          "text": "(בעל הגאולה והשמחה)2,"
        },
        {
          "s": 3,
          "text": "וכשקריתי בס' תהלים בפסוק פדה בשלום נפשי,"
        },
        {
          "s": 4,
          "text": "קודם שהתחלתי פסוק שלאחריו,"
        },
        {
          "s": 5,
          "text": "יצאתי בשלום מה' שלום."
        },
        {
          "s": 6,
          "text": "ומובן מזה,"
        },
        {
          "s": 7,
          "text": "שתוכן הכתוב שייך הוא לגאולת רבינו הזקן."
        },
        {
          "s": 8,
          "text": "והנה גאולת רבינו הזקן הו\"ע הפצת המעינות"
        },
        {
          "s": 9,
          "text": "(של תורת החסידות עד ל)"
        },
        {
          "s": 10,
          "text": "חוצה."
        },
        {
          "s": 11,
          "text": "וכידוע3,"
        },
        {
          "s": 12,
          "text": "אשר סיבת הקטרוג והמאסר למטה הי' מצד השקו\"ט למעלה ע\"ד הפצת רזי תורה באתגליא ועד שיגיע לכאו\"א."
        },
        {
          "s": 13,
          "text": "וכאשר הי' הפסק דין למעלה להפיץ רזי תורה"
        },
        {
          "s": 14,
          "text": "(ואדרבה,"
        },
        {
          "s": 15,
          "text": "ביתר שאת ויתר עז מכמו שהי' קודם המאסר)"
        },
        {
          "s": 16,
          "text": "נתבטל במילא הדין למטה,"
        },
        {
          "s": 17,
          "text": "ויצא לחירות."
        },
        {
          "s": 18,
          "text": "דמזה מובן,"
        },
        {
          "s": 19,
          "text": "שתוכן הכתוב פדה בשלום נפשי שייך לענין הפצת תורת החסידות."
        },
        {
          "s": 20,
          "text": "והנה אמרז\"ל4"
        },
        {
          "s": 21,
          "text": "פדה בשלום נפשי מקרב לי וגו',"
        },
        {
          "s": 22,
          "text": "אמר הקב\"ה,"
        },
        {
          "s": 23,
          "text": "כל העוסק בתורה ובגמילות חסדים ומתפלל עם הצבור מעלה אני עליו כאילו פדאני לי ולבני מבין אומות העולם."
        },
        {
          "s": 24,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 25,
          "text": "דנוסף על השייכות דהפצת תורת החסידות לתוכן הכתוב כמו שהוא כפשוטו"
        },
        {
          "s": 26,
          "text": "(דאין מקרא יוצא מידי פשוטו5)"
        },
        {
          "s": 27,
          "text": "– פדי' בשלום,"
        },
        {
          "s": 28,
          "text": "היא"
        },
        {
          "s": 29,
          "text": "(הפצת תורת החסידות)"
        },
        {
          "s": 30,
          "text": "שייכת גם לענין העוסק בתורה ובגמ\"ח ומתפלל עם הצבור."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה פירוש הפשוט בכתוב זה הוא,"
        },
        {
          "s": 2,
          "text": "אשר כי ברבים היו עמדי הוא נתינת טעם לפדה בשלום נפשי."
        },
        {
          "s": 3,
          "text": "היינו שאפשר להיות פדי' באופן של מלחמה,"
        },
        {
          "s": 4,
          "text": "והמעלה בפדי' זו הוא – פדה בשלום."
        },
        {
          "s": 5,
          "text": "והטעם על זה שפדה בשלום נפשי הוא,"
        },
        {
          "s": 6,
          "text": "כי ברבים היו עמדי."
        },
        {
          "s": 7,
          "text": "וצריך להבין מהו\"ע פדה בשלום דוקא,"
        },
        {
          "s": 8,
          "text": "והשייכות דברבים היו עמדי לפדה בשלום."
        },
        {
          "s": 9,
          "text": "והנה בדרשת רז\"ל על פסוק זה,"
        },
        {
          "s": 10,
          "text": "כל העוסק בתורה ובגמ\"ח ומתפלל עם הצבור כו',"
        },
        {
          "s": 11,
          "text": "פירש\"י,"
        },
        {
          "s": 12,
          "text": "תורה דכתיב6"
        },
        {
          "s": 13,
          "text": "וכל נתיבותי' שלום,"
        },
        {
          "s": 14,
          "text": "וכן גמ\"ח נמי שלום הוא,"
        },
        {
          "s": 15,
          "text": "ומתפלל עם הצבור הו\"ע כי ברבים היו עמדי"
        },
        {
          "s": 16,
          "text": "(כדפרש\"י שם,"
        },
        {
          "s": 17,
          "text": "כי ברבים היו עמדי,"
        },
        {
          "s": 18,
          "text": "שהתפללו עמי)."
        },
        {
          "s": 19,
          "text": "והיינו,"
        },
        {
          "s": 20,
          "text": "שג' ענינים אלו,"
        },
        {
          "s": 21,
          "text": "תורה גמ\"ח ותפלה בצבור,"
        },
        {
          "s": 22,
          "text": "מחלקם לב' חלוקות."
        },
        {
          "s": 23,
          "text": "תורה וגמ\"ח הו\"ע בשלום,"
        },
        {
          "s": 24,
          "text": "ותפלה בצבור הו\"ע כי ברבים היו עמדי."
        },
        {
          "s": 25,
          "text": "וצריך להבין מה שמחלק ג' ענינים אלו לשתי חלוקות."
        },
        {
          "s": 26,
          "text": "גם צריך להבין מה שאמרו כל העוסק כו',"
        },
        {
          "s": 27,
          "text": "שמדבר כאן בענין האדם העוסק בתורה כו' ולא בענין התורה גמ\"ח ותפלה בצבור עצמם."
        },
        {
          "s": 28,
          "text": "כלשון המורגל בכ\"מ,"
        },
        {
          "s": 29,
          "text": "כמו על שלשה דברים העולם עומד על התורה ועל העבודה ועל גמילות חסדים7"
        },
        {
          "s": 30,
          "text": "(ולא כל העוסק בתורה בעבודה ובגמ\"ח מעמיד הוא את העולם),"
        },
        {
          "s": 31,
          "text": "והלשון כאן הוא כל העוסק כו'."
        }
      ]
    }
  ]
}