{
  "globalIndex": 440,
  "owner": 40,
  "jobId": "_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916270_theRebbe_968__p002",
  "batchId": "meluket-_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916270_theRebbe_968__p002",
  "seriesId": "טבת_meluket",
  "postId": "BH_POST_1766518916270_theRebbe_968",
  "title": "מאמר היושבת בגנים תשי\"ג",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והענין הוא,"
        },
        {
          "s": 2,
          "text": "דאור הקו"
        },
        {
          "s": 3,
          "text": "(דאור הממלא הוא בכלל אור הקו)"
        },
        {
          "s": 4,
          "text": "המשכתו היא ע\"י הצמצום,"
        },
        {
          "s": 5,
          "text": "שהיא המשכה שבדרך דילוג."
        },
        {
          "s": 6,
          "text": "דענין הצמצום"
        },
        {
          "s": 7,
          "text": "(צמצום הראשון)"
        },
        {
          "s": 8,
          "text": "הוא שהאור שהי' תחילה נתעלם לגמרי ונשאר חלל ומקום פנוי12,"
        },
        {
          "s": 9,
          "text": "ומכיון שההמשכה שלאח\"ז היא לאחרי התעלמות"
        },
        {
          "s": 10,
          "text": "(הפסק)"
        },
        {
          "s": 11,
          "text": "האור לגמרי,"
        },
        {
          "s": 12,
          "text": "הרי ההמשכה שלאח\"ז היא בדרך דילוג."
        },
        {
          "s": 13,
          "text": "[והגם שגם בעת הצמצום נשאר רשימו כמבואר בכ\"מ13,"
        },
        {
          "s": 14,
          "text": "וכמובא גם במאמר הנ\"ל ד\"חלל לאו דוקא\"14"
        },
        {
          "s": 15,
          "text": "אלא שנשאר רשימו,"
        },
        {
          "s": 16,
          "text": "הרי ענין הרשימו הוא כח נעלם,"
        },
        {
          "s": 17,
          "text": "וכידוע15"
        },
        {
          "s": 18,
          "text": "דענין הרשימו הוא כח הגבול שבא\"ס,"
        },
        {
          "s": 19,
          "text": "שרש הכלים,"
        },
        {
          "s": 20,
          "text": "אבל בענין אור וגילוי,"
        },
        {
          "s": 21,
          "text": "הצמצום הוא סילוק והתעלמות לגמרי,"
        },
        {
          "s": 22,
          "text": "והמשכת האור שלאחרי הצמצום היא המשכה בדרך דילוג]."
        },
        {
          "s": 23,
          "text": "ולכן,"
        },
        {
          "s": 24,
          "text": "גם הדביקות דאור הקו היא דביקות שע\"י הפסק"
        },
        {
          "s": 25,
          "text": "(ואינה בבחינת דביקות ממש),"
        },
        {
          "s": 26,
          "text": "ובמילא אינו בבחינת אור וגילוי כ\"כ16."
        },
        {
          "s": 27,
          "text": "וכמשל17"
        },
        {
          "s": 28,
          "text": "חיות השערות שאינו דומה לחיות האברים,"
        },
        {
          "s": 29,
          "text": "שהוא חיות מצומצם ביותר,"
        },
        {
          "s": 30,
          "text": "ועד דכשחותכין השערות אינו מרגיש כאב,"
        },
        {
          "s": 31,
          "text": "לפי שאופן המשכתן מהמוח הוא ע\"י הפסק הגולגולת."
        },
        {
          "s": 32,
          "text": "ועד\"ז הוא בהנמשל למעלה,"
        },
        {
          "s": 33,
          "text": "דאור הסובב,"
        },
        {
          "s": 34,
          "text": "כיון שהמשכתו ממקורו ודביקותו במקורו הוא שלא ע\"י הפסק"
        },
        {
          "s": 35,
          "text": "[דהגם שגם אור הסובב הוא אור שנמשך לאחרי הצמצום,"
        },
        {
          "s": 36,
          "text": "הרי ידוע18"
        },
        {
          "s": 37,
          "text": "שפעולת הצמצום באור הסובב היא"
        },
        {
          "s": 38,
          "text": "(בעיקר)"
        },
        {
          "s": 39,
          "text": "לא בנוגע להאור גופא,"
        },
        {
          "s": 40,
          "text": "כי אם,"
        },
        {
          "s": 41,
          "text": "שלא יאיר בגילוי"
        },
        {
          "s": 42,
          "text": "(בפנימיות)"
        },
        {
          "s": 43,
          "text": "ורק בבחינת מקיף וסובב."
        },
        {
          "s": 44,
          "text": "דבאור הממלא הצמצום הוא בנוגע להאור עצמו,"
        },
        {
          "s": 45,
          "text": "שע\"י הצמצום נמשך"
        },
        {
          "s": 46,
          "text": "(ונתהוה)"
        },
        {
          "s": 47,
          "text": "אור כזה שלא הי' קודם19."
        },
        {
          "s": 48,
          "text": "משא\"כ פעולת הצמצום באור הסובב היא"
        },
        {
          "s": 49,
          "text": "(כנ\"ל)"
        },
        {
          "s": 50,
          "text": "שיהי' בבחינת מקיף וסובב,"
        },
        {
          "s": 51,
          "text": "אבל האור עצמו אינו אור שנתהוה אח\"כ כ\"א הוא הגילוי דאוא\"ס שלפני הצמצום,"
        },
        {
          "s": 52,
          "text": "גילוי שלא ע\"י הפסק],"
        },
        {
          "s": 53,
          "text": "לכן הוא אור וגילוי ממש"
        },
        {
          "s": 54,
          "text": "(דוגמת חיות האברים),"
        },
        {
          "s": 55,
          "text": "ואינו בגדר ציור והתחלקות."
        },
        {
          "s": 56,
          "text": "משא\"כ אור הממלא"
        },
        {
          "s": 57,
          "text": "(אור הקו),"
        },
        {
          "s": 58,
          "text": "שאופן המשכתו מאוא\"ס ודביקותו באוא\"ס הוא ע\"י הפסק הצמצום20,"
        },
        {
          "s": 59,
          "text": "אינו בבחינת גילוי כ\"כ"
        },
        {
          "s": 60,
          "text": "(כ\"א בדוגמת חיות השערות),"
        },
        {
          "s": 61,
          "text": "ולכן21"
        },
        {
          "s": 62,
          "text": "הוא בגדר התחלקות"
        },
        {
          "s": 63,
          "text": "(היינו,"
        },
        {
          "s": 64,
          "text": "שע\"י התלבשותו בכלים יהי' האור נראה כפי אופן הכלי22)."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וזהו שהעלי' מהגילוי דג\"ע להגילוי דלע\"ל היא בדרך בריחה"
        },
        {
          "s": 2,
          "text": "(כמו שנתבאר לעיל"
        },
        {
          "s": 3,
          "text": "(בתחילת המאמר)"
        },
        {
          "s": 4,
          "text": "דיוק הלשון ברח גו' על הרי בשמים,"
        },
        {
          "s": 5,
          "text": "ברח דוקא),"
        },
        {
          "s": 6,
          "text": "דכיון שהחילוק שבין אור הממלא"
        },
        {
          "s": 7,
          "text": "(הגילוי דג\"ע)"
        },
        {
          "s": 8,
          "text": "לאור הסובב"
        },
        {
          "s": 9,
          "text": "(הגילוי דלע\"ל)"
        },
        {
          "s": 10,
          "text": "הוא"
        },
        {
          "s": 11,
          "text": "(לא רק זה שאור הממלא בא בהתחלקות ע\"י הכלים,"
        },
        {
          "s": 12,
          "text": "אלא גם)"
        },
        {
          "s": 13,
          "text": "באופן המשכתם ממקורם,"
        },
        {
          "s": 14,
          "text": "דאור הממלא נמשך ע\"י הפסק הצמצום משא\"כ אור הסובב,"
        },
        {
          "s": 15,
          "text": "הרי מובן,"
        },
        {
          "s": 16,
          "text": "שהחילוק שביניהם הוא חילוק שבאין ערוך,"
        },
        {
          "s": 17,
          "text": "ולכן העלי' מהגילוי דג\"ע"
        },
        {
          "s": 18,
          "text": "(אור הממלא)"
        },
        {
          "s": 19,
          "text": "להגילוי דלע\"ל"
        },
        {
          "s": 20,
          "text": "(אור הסובב)"
        },
        {
          "s": 21,
          "text": "היא בדרך בריחה."
        },
        {
          "s": 22,
          "text": "דכמו שהמשכת אור הקו מאוא\"ס שלפני הצמצום היא בדרך דילוג,"
        },
        {
          "s": 23,
          "text": "כן גם העלי' מאור הממלא"
        },
        {
          "s": 24,
          "text": "(אור הקו)"
        },
        {
          "s": 25,
          "text": "לאור הסובב"
        },
        {
          "s": 26,
          "text": "(שהוא הגילוי דאוא\"ס שלפני הצמצום)"
        },
        {
          "s": 27,
          "text": "היא בדרך בריחה,"
        },
        {
          "s": 28,
          "text": "שלא בסדר והדרגה."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "אמנם,"
        },
        {
          "s": 2,
          "text": "עם היות שהגילוי דג\"ע הוא באין ערוך להגילוי דלעתיד,"
        },
        {
          "s": 3,
          "text": "אעפ\"כ,"
        },
        {
          "s": 4,
          "text": "הגילוי דג\"ע הוא הקדמה שעל ידו"
        },
        {
          "s": 5,
          "text": "(דוקא)"
        },
        {
          "s": 6,
          "text": "מגיעים להגילוי דלעתיד"
        },
        {
          "s": 7,
          "text": "(כנ\"ל בתחילת המאמר)."
        },
        {
          "s": 8,
          "text": "והענין הוא,"
        },
        {
          "s": 9,
          "text": "דהנה קודם יגמה\"ר כתיב23"
        },
        {
          "s": 10,
          "text": "הוי' הוי' ופסיק טעמא בגווייהו24."
        },
        {
          "s": 11,
          "text": "וידוע25"
        },
        {
          "s": 12,
          "text": "דהוי' הא' הוא הוי' דלעילא,"
        },
        {
          "s": 13,
          "text": "שם הוי' שבאוא\"ס שלפני הצמצום,"
        },
        {
          "s": 14,
          "text": "והוי' הב' הוא הוי' דלתתא,"
        },
        {
          "s": 15,
          "text": "שם הוי' שבאור הקו,"
        },
        {
          "s": 16,
          "text": "ופסיק טעמא בגווייהו הוא הפסק הצמצום שבין אוא\"ס לאור הקו."
        },
        {
          "s": 17,
          "text": "וזהו גם מ\"ש בפסוק ראשון דק\"ש26"
        },
        {
          "s": 18,
          "text": "הוי' אלקינו הוי',"
        },
        {
          "s": 19,
          "text": "דאלקינו הוא הצמצום שבין הוי' דלעילא"
        },
        {
          "s": 20,
          "text": "(אוא\"ס שלפני הצמצום)"
        },
        {
          "s": 21,
          "text": "והוי' דלתתא"
        },
        {
          "s": 22,
          "text": "(אור הקו)27."
        },
        {
          "s": 23,
          "text": "ומבאר בהמאמר,"
        },
        {
          "s": 24,
          "text": "דמ\"ש אלקינו"
        },
        {
          "s": 25,
          "text": "(בין ב' השמות הוי'),"
        },
        {
          "s": 26,
          "text": "דאלקינו"
        },
        {
          "s": 27,
          "text": "(משא\"כ אלקים)"
        },
        {
          "s": 28,
          "text": "עם היותו מורה על מדת הדין28"
        },
        {
          "s": 29,
          "text": "יש בו הטי' לחסד ולרחמים29,"
        },
        {
          "s": 30,
          "text": "כי ע\"י אלקינו דוקא הוא החיבור שיומשך הגילוי והשפע מהוי' דלעילא להוי' דלתתא."
        },
        {
          "s": 31,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 32,
          "text": "שהוא ע\"ד הידוע30"
        },
        {
          "s": 33,
          "text": "בענין הכלים,"
        },
        {
          "s": 34,
          "text": "דהגם שבאם הי' נשאר מתחילה אור הקו לא הי' אפשר להיות התהוות הכלים,"
        },
        {
          "s": 35,
          "text": "ומ\"מ לאחרי שנתהוו הכלים הם יכולים לקבל את הגילוי דאור הקו,"
        },
        {
          "s": 36,
          "text": "כי כיון שהתהוותם היתה ע\"י הצמצום בדרך סילוק דוקא31,"
        },
        {
          "s": 37,
          "text": "לכן נתהוו באופן כזה דלא רק שאינם מתבטלים מהגילוי דאור הקו אלא יתירה מזו שגילוי האור הוא ע\"י הכלים דוקא"
        },
        {
          "s": 38,
          "text": "[כי בהצמצום שבדרך סילוק דוקא מתגלה העצם32"
        },
        {
          "s": 39,
          "text": "שלמעלה מהגדר דגילוי"
        },
        {
          "s": 40,
          "text": "(אורות)"
        },
        {
          "s": 41,
          "text": "והעלם"
        },
        {
          "s": 42,
          "text": "(כלים),"
        },
        {
          "s": 43,
          "text": "ולכן ע\"י הצמצום בדרך סילוק נעשה החיבור דכלים ואורות],"
        },
        {
          "s": 44,
          "text": "עד\"ז הוא גם בנוגע לאור הקו33,"
        },
        {
          "s": 45,
          "text": "דע\"י שהמשכתו מאוא\"ס היתה ע\"י הצמצום בדרך סילוק,"
        },
        {
          "s": 46,
          "text": "עי\"ז נעשה באופן דלא רק שלא יתבטל ע\"י הגילוי דאוא\"ס הבל\"ג,"
        },
        {
          "s": 47,
          "text": "אלא יתירה מזו,"
        },
        {
          "s": 48,
          "text": "שעל ידו דוקא יהי' הגילוי דאוא\"ס."
        }
      ]
    }
  ]
}