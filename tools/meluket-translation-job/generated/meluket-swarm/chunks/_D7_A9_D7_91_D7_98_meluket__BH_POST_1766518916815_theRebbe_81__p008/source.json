{
  "globalIndex": 525,
  "owner": 25,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916815_theRebbe_81__p008",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916815_theRebbe_81__p008",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916815_theRebbe_81",
  "title": "מאמר באתי לגני תש\"ל",
  "part": 8,
  "sections": [
    {
      "v": 21,
      "items": [
        {
          "s": 0,
          "text": "והנה ידוע99,"
        },
        {
          "s": 1,
          "text": "שבכדי שיהי' החיבור דסובב וממלא הוא ע\"י המשכת עצמות אוא\"ס שלמעלה מסובב וממלא."
        },
        {
          "s": 2,
          "text": "ועד\"ז הוא בהנשמה,"
        },
        {
          "s": 3,
          "text": "שהחיבור דהנשמה שלמעלה והנשמה שבגוף הוא ע\"י המשכת עצם הנשמה,"
        },
        {
          "s": 4,
          "text": "שבכללות הוא יחידה."
        },
        {
          "s": 5,
          "text": "והמשכה זו היא ע\"י העבודה דבכל מאדך,"
        },
        {
          "s": 6,
          "text": "בכל מדה ומדה שהוא מודד לך הוי מודה לו100."
        },
        {
          "s": 7,
          "text": "כי זה שהוא מודה להקב\"ה בכל מדה ומדה בשוה הוא מצד הגילוי דיחידה101"
        },
        {
          "s": 8,
          "text": "[דנשמה שבגוף הוא נר\"נ,"
        },
        {
          "s": 9,
          "text": "נשמה שלמעלה – חי',"
        },
        {
          "s": 10,
          "text": "ועצם הנשמה – יחידה]."
        },
        {
          "s": 11,
          "text": "ועפ\"ז יובן שעבודת התפלה היא הנתינת כח לענין העבודה"
        },
        {
          "s": 12,
          "text": "(עבודה ויגיעה עצומה במלחמה כבדה)"
        },
        {
          "s": 13,
          "text": "בכל ג' הקוין,"
        },
        {
          "s": 14,
          "text": "כי הכח להתגבר על כל המניעות הוא מצד עצם הנשמה"
        },
        {
          "s": 15,
          "text": "(כנ\"ל סעיף ט),"
        },
        {
          "s": 16,
          "text": "וע\"י התפלה,"
        },
        {
          "s": 17,
          "text": "החיבור דנשמה שבגוף"
        },
        {
          "s": 18,
          "text": "(נר\"נ)"
        },
        {
          "s": 19,
          "text": "ונשמה שלמעלה"
        },
        {
          "s": 20,
          "text": "(חי'),"
        },
        {
          "s": 21,
          "text": "נמשך גם הגילוי דיחידה."
        }
      ]
    },
    {
      "v": 22,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ב)"
        },
        {
          "s": 2,
          "text": "והנה נתבאר לעיל"
        },
        {
          "s": 3,
          "text": "(סוף סעיף ג),"
        },
        {
          "s": 4,
          "text": "שעיקר הענין דאתכפיא"
        },
        {
          "s": 5,
          "text": "(ואתהפכא)"
        },
        {
          "s": 6,
          "text": "וההמשכה שעי\"ז הוא בזמן הגלות."
        },
        {
          "s": 7,
          "text": "ולהעיר,"
        },
        {
          "s": 8,
          "text": "שגם ענין זה מודגש בתפלה,"
        },
        {
          "s": 9,
          "text": "כמו שמבאר הצ\"צ במאמר הנ\"ל102"
        },
        {
          "s": 10,
          "text": "שהתפלה בזמן הגלות היא נעלית יותר מהתפלה שבזמן הבית."
        },
        {
          "s": 11,
          "text": "וכמ\"ש אדמו\"ר הזקן103"
        },
        {
          "s": 12,
          "text": "שבזמן הגלות,"
        },
        {
          "s": 13,
          "text": "המלכות עצמה היא בחינת תפלה."
        },
        {
          "s": 14,
          "text": "דבזמן הבית המלכות שואלת צרכי' מז\"א בעלה"
        },
        {
          "s": 15,
          "text": "(היינו שהמשכת האור שלמעלה מהשתלשלות במלכות הוא ע\"י ז\"א),"
        },
        {
          "s": 16,
          "text": "ובזמן הגלות אין צריך להמשיך דרך המדות עליונות."
        },
        {
          "s": 17,
          "text": "ומבאר הצ\"צ בהמאמר ענין זה בעבודת האדם,"
        },
        {
          "s": 18,
          "text": "שבזמן הבית,"
        },
        {
          "s": 19,
          "text": "העלאת הנשמה שבגוף לשרשה שלמעלה היתה ע\"י אהבה ויראה,"
        },
        {
          "s": 20,
          "text": "ובזמן הגלות,"
        },
        {
          "s": 21,
          "text": "כאשר יונתי בחגוי הסלע בסתר המדרגה104,"
        },
        {
          "s": 22,
          "text": "שהאהבה והיראה דהנשמה הם בהסתר,"
        },
        {
          "s": 23,
          "text": "העצה היא הראני את מראיך104,"
        },
        {
          "s": 24,
          "text": "מראה הוא אור חוזר,"
        },
        {
          "s": 25,
          "text": "העבודה דבכל מאדך שלמעלה מהגבלה שמתעוררת ע\"י ההסתר,"
        },
        {
          "s": 26,
          "text": "ועי\"ז העלאת הנשמה לשרשה היא בדרך דילוג,"
        },
        {
          "s": 27,
          "text": "דהעלאה זו היא למעלה יותר מההעלאה שע\"י אהוי\"ר,"
        },
        {
          "s": 28,
          "text": "שהיא בסדר והדרגה."
        },
        {
          "s": 29,
          "text": "ויש לומר,"
        },
        {
          "s": 30,
          "text": "דזה שאומר במאמר הנ\"ל שע\"י ההסתר שבזמן הגלות באים לבכל מאדך שהוא גילוי היחידה"
        },
        {
          "s": 31,
          "text": "(כנ\"ל סוף סעיף יא),"
        },
        {
          "s": 32,
          "text": "אף שהחיבור דנר\"נ עם חי'"
        },
        {
          "s": 33,
          "text": "(גם בזמן הבית)"
        },
        {
          "s": 34,
          "text": "הוא ע\"י המשכת היחידה"
        },
        {
          "s": 35,
          "text": "(כנ\"ל שם),"
        },
        {
          "s": 36,
          "text": "הוא,"
        },
        {
          "s": 37,
          "text": "שבזמן הבית העבודה עצמה היא"
        },
        {
          "s": 38,
          "text": "(בעיקר)"
        },
        {
          "s": 39,
          "text": "העבודה שמצד נר\"נ והעבודה שמצד חי',"
        },
        {
          "s": 40,
          "text": "אלא שהחיבור דב' עבודות אלו הוא ע\"י המשכת היחידה,"
        },
        {
          "s": 41,
          "text": "ובזמן הגלות,"
        },
        {
          "s": 42,
          "text": "שהעבודה עצמה היא באופן דמס\"נ,"
        },
        {
          "s": 43,
          "text": "היחידה עצמה היא בגילוי."
        }
      ]
    },
    {
      "v": 23,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ג)"
        },
        {
          "s": 2,
          "text": "ויש לומר,"
        },
        {
          "s": 3,
          "text": "דע\"י שהיחידה באה בגילוי ע\"י העבודה שבזמן הגלות,"
        },
        {
          "s": 4,
          "text": "נעשה בה עילוי."
        },
        {
          "s": 5,
          "text": "כי תכלית הכוונה דכל הענינים שבעולם וגם דהנשמה הוא בשביל עבודת האדם."
        },
        {
          "s": 6,
          "text": "ולכן,"
        },
        {
          "s": 7,
          "text": "זה שנעשה גילוי היחידה ע\"י העבודה,"
        },
        {
          "s": 8,
          "text": "הוא עילוי לגבי היחידה כמו שהיא מצד עצמה."
        },
        {
          "s": 9,
          "text": "ויש לקשר זה עם זה שאומרים קודם התפלה אשרנו מה טוב חלקנו ומה נעים גורלנו ומה יפה ירושתנו,"
        },
        {
          "s": 10,
          "text": "ומבאר כ\"ק מו\"ח אדמו\"ר בעל ההילולא במאמרו ד\"ה זה105"
        },
        {
          "s": 11,
          "text": "ג' הענינים דחלק גורל וירושה,"
        },
        {
          "s": 12,
          "text": "בהקדים,"
        },
        {
          "s": 13,
          "text": "שבנפש האדם,"
        },
        {
          "s": 14,
          "text": "ב' מדריגות בכללות."
        },
        {
          "s": 15,
          "text": "זה שהוא חי בעצם,"
        },
        {
          "s": 16,
          "text": "וזה שהוא חי להחיות106,"
        },
        {
          "s": 17,
          "text": "היינו החיות שמתפשט מהנפש להחיות את הגוף."
        },
        {
          "s": 18,
          "text": "ובחיות זה עצמו שתי מדריגות."
        },
        {
          "s": 19,
          "text": "חיות כללי שמחי' את כל אברי הגוף בשוה,"
        },
        {
          "s": 20,
          "text": "וחיות פרטי שמתלבש בכל אבר לפי ענינו."
        },
        {
          "s": 21,
          "text": "ועד\"ז הוא בהנשמה"
        },
        {
          "s": 22,
          "text": "(נפש האלקית)"
        },
        {
          "s": 23,
          "text": "שיש בה"
        },
        {
          "s": 24,
          "text": "(דוגמת)"
        },
        {
          "s": 25,
          "text": "ג' מדריגות אלו."
        },
        {
          "s": 26,
          "text": "עצם הנשמה,"
        },
        {
          "s": 27,
          "text": "וזה שהיא מאירה בהגוף ונפש הטבעית באופן כללי לפי שהגוף ונה\"ט אינם כלים לאור זה,"
        },
        {
          "s": 28,
          "text": "וזה שהיא מתלבשת בהגוף ונפשו הטבעית."
        },
        {
          "s": 29,
          "text": "ומבאר שם,"
        },
        {
          "s": 30,
          "text": "שג' ענינים אלו הם חלק גורל וירושה."
        },
        {
          "s": 31,
          "text": "ויש לומר,"
        },
        {
          "s": 32,
          "text": "שג' ענינים אלו הם"
        },
        {
          "s": 33,
          "text": "(בדרך כלל)"
        },
        {
          "s": 34,
          "text": "נר\"נ,"
        },
        {
          "s": 35,
          "text": "חי' ויחידה."
        },
        {
          "s": 36,
          "text": "וכמו שמבאר שם107"
        },
        {
          "s": 37,
          "text": "שירושתנו הוא נקודת היהדות שבכל אחד מישראל,"
        },
        {
          "s": 38,
          "text": "וידוע שנקודת היהדות היא היחידה שבנפש."
        },
        {
          "s": 39,
          "text": "ומבאר שם,"
        },
        {
          "s": 40,
          "text": "דזה שחושב כאן ג' ענינים אלו בסדר דמלמטה למעלה,"
        },
        {
          "s": 41,
          "text": "הוא,"
        },
        {
          "s": 42,
          "text": "כי תכלית הכוונה הוא,"
        },
        {
          "s": 43,
          "text": "שגם הגילוי דנקודת היהדות,"
        },
        {
          "s": 44,
          "text": "הגם שהוא ירושה שהוא דבר הבא ממילא,"
        },
        {
          "s": 45,
          "text": "יהי' ע\"י עבודת האדם בכח עצמו."
        }
      ]
    }
  ]
}