{
  "globalIndex": 1101,
  "owner": 1,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920390_theRebbe_690__p001",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920390_theRebbe_690__p001",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920390_theRebbe_690",
  "title": "מאמר את הוי' האמרת תש\"ל",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ תבוא,"
        },
        {
          "s": 2,
          "text": "ח\"י אלול,"
        },
        {
          "s": 3,
          "text": "ה'תש\"ל"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "את הוי' האמרת גו' והוי' האמירך גו'1,"
        },
        {
          "s": 1,
          "text": "ואיתא בגמרא2"
        },
        {
          "s": 2,
          "text": "אמר להם הקב\"ה לישראל כו' אתם עשיתוני חטיבה אחת בעולם שנאמר3"
        },
        {
          "s": 3,
          "text": "שמע ישראל ה' אלקינו ה' אחד ואני אעשה אתכם חטיבה אחת בעולם שנאמר4"
        },
        {
          "s": 4,
          "text": "ומי כעמך ישראל גוי אחד בארץ."
        },
        {
          "s": 5,
          "text": "וצריך להבין מה שאמרו אתם עשיתוני חטיבה אחת,"
        },
        {
          "s": 6,
          "text": "דפירוש עשיתוני כו' הוא,"
        },
        {
          "s": 7,
          "text": "דזה שהוי' הוא אחד"
        },
        {
          "s": 8,
          "text": "(חטיבה אחת),"
        },
        {
          "s": 9,
          "text": "נעשה זה ע\"י ישראל."
        },
        {
          "s": 10,
          "text": "וכמובן גם מזה שמדמין אני אעשה אתכם כו' לאתם עשיתוני"
        },
        {
          "s": 11,
          "text": "(ובפרט להגירסא5"
        },
        {
          "s": 12,
          "text": "אף אני אעשה),"
        },
        {
          "s": 13,
          "text": "דכמו שפירוש אני אעשה אתכם כו' הוא דזה שישראל הם גוי אחד נעשה ע\"י הקב\"ה"
        },
        {
          "s": 14,
          "text": "[כמו שממשיך בכתוב6"
        },
        {
          "s": 15,
          "text": "(לאחרי שאומר ומי כעמך ישראל גוי אחד בארץ)"
        },
        {
          "s": 16,
          "text": "אשר הלך האלקים בעצמו לפדות לו עם גו',"
        },
        {
          "s": 17,
          "text": "ופירש רש\"י7"
        },
        {
          "s": 18,
          "text": "וממה הם מיוחדים מכל הגוים,"
        },
        {
          "s": 19,
          "text": "מזה אשר הלך האלקים בעצמו לפדות לו עם כו' מזה אנו מיוחדים]8,"
        },
        {
          "s": 20,
          "text": "עד\"ז הוא גם פירוש אתם עשיתוני כו',"
        },
        {
          "s": 21,
          "text": "דענין הוי' אחד נעשה על ידי ישראל."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה פירוש הנ\"ל בהאמרת והאמירך"
        },
        {
          "s": 2,
          "text": "(אתם עשיתוני חטיבה אחת בעולם ואני אעשה אתכם חטיבה אחת בעולם)"
        },
        {
          "s": 3,
          "text": "בא בהמשך למה דאיתא בגמרא9"
        },
        {
          "s": 4,
          "text": "(לפנ\"ז)"
        },
        {
          "s": 5,
          "text": "תפילין דמארי10"
        },
        {
          "s": 6,
          "text": "עלמא מה כתיב בהו כו' ומי כעמך ישראל גוי אחד בארץ,"
        },
        {
          "s": 7,
          "text": "ומי משתבח קוב\"ה בשבחייהו דישראל,"
        },
        {
          "s": 8,
          "text": "אין,"
        },
        {
          "s": 9,
          "text": "דכתיב את ה' האמרת היום וכתיב וה' האמירך היום,"
        },
        {
          "s": 10,
          "text": "אמר להם הקב\"ה לישראל אתם עשיתוני חטיבה אחת בעולם ואני אעשה אתכם חטיבה אחת בעולם."
        },
        {
          "s": 11,
          "text": "והביאור בזה"
        },
        {
          "s": 12,
          "text": "(בשאלת הגמרא \"ומי משתבח קוב\"ה בשבחייהו דישראל\"),"
        },
        {
          "s": 13,
          "text": "כי תפילין נק' פאר,"
        },
        {
          "s": 14,
          "text": "כמ\"ש11"
        },
        {
          "s": 15,
          "text": "פארך חבוש עליך,"
        },
        {
          "s": 16,
          "text": "שהתפילין מביאים תפארת ושבח להאדם החובש אותם,"
        },
        {
          "s": 17,
          "text": "וכמו\"כ הוא גם בתפילין דמארי עלמא שהם מביאים בו תפארת ושבח כביכול,"
        },
        {
          "s": 18,
          "text": "ומזה מובן,"
        },
        {
          "s": 19,
          "text": "דומי כעמך ישראל גו' שכתוב בתפילין דמארי עלמא,"
        },
        {
          "s": 20,
          "text": "זהו תפארתו ושבחו של הקב\"ה12."
        },
        {
          "s": 21,
          "text": "וזהו שמקשה בגמרא ומי משתבח קוב\"ה בשבחייהו דישראל,"
        },
        {
          "s": 22,
          "text": "הרי פסוק זה"
        },
        {
          "s": 23,
          "text": "(ומי כעמך ישראל גו')"
        },
        {
          "s": 24,
          "text": "הוא שבחם של ישראל,"
        },
        {
          "s": 25,
          "text": "ואיך הוא תפארתו ושבחו של הקב\"ה."
        },
        {
          "s": 26,
          "text": "ומתרץ \"אין,"
        },
        {
          "s": 27,
          "text": "דכתיב את ה' האמרת\","
        },
        {
          "s": 28,
          "text": "האמרת לשון חשיבות ושבח13,"
        },
        {
          "s": 29,
          "text": "שישראל פועלים חשיבות ושבח בהקב\"ה."
        },
        {
          "s": 30,
          "text": "וצריך להבין,"
        },
        {
          "s": 31,
          "text": "דהראי' מהפסוק את ה' האמרת היא"
        },
        {
          "s": 32,
          "text": "(לכאורה)"
        },
        {
          "s": 33,
          "text": "רק שהקב\"ה משתבח ע\"י השבחים שישראל משבחים אותו ית'"
        },
        {
          "s": 34,
          "text": "(הוי' אלקינו הוי' אחד),"
        },
        {
          "s": 35,
          "text": "דהגם שכל הנבראים הם באין ערוך כלל לגבי' ית' מ\"מ עלה ברצונו ית' שע\"י השבחים שישראל משבחים אותו יובא בו"
        },
        {
          "s": 36,
          "text": "(כביכול)"
        },
        {
          "s": 37,
          "text": "חשיבות ושבח,"
        },
        {
          "s": 38,
          "text": "ואיך מוכח מזה שקוב\"ה משתבח בשבחייהו דישראל,"
        },
        {
          "s": 39,
          "text": "בהשבח של מעלת ישראל,"
        },
        {
          "s": 40,
          "text": "מה שישראל הם גוי אחד בארץ."
        },
        {
          "s": 41,
          "text": "וצריך לומר,"
        },
        {
          "s": 42,
          "text": "דע\"י את ה' האמרת,"
        },
        {
          "s": 43,
          "text": "שישראל משבחים את הקב\"ה והקב\"ה משתבח בזה,"
        },
        {
          "s": 44,
          "text": "עי\"ז נעשה שהקב\"ה משתבח בהשבח דישראל גופא14."
        },
        {
          "s": 45,
          "text": "ויש להוסיף,"
        },
        {
          "s": 46,
          "text": "דמזה שהפסוק שכתוב בתפילין דמארי עלמא הוא"
        },
        {
          "s": 47,
          "text": "(לא הפסוק שמע ישראל גו' הוי' אחד"
        },
        {
          "s": 48,
          "text": "(כבתפילין שלנו),"
        },
        {
          "s": 49,
          "text": "אלא)"
        },
        {
          "s": 50,
          "text": "הפסוק ומי כעמך ישראל גוי אחד בארץ,"
        },
        {
          "s": 51,
          "text": "מוכח,"
        },
        {
          "s": 52,
          "text": "דשבח זה של הקב\"ה,"
        },
        {
          "s": 53,
          "text": "דמשתבח קוב\"ה בשבחייהו דישראל,"
        },
        {
          "s": 54,
          "text": "הוא שבח גדול יותר מהשבח דאת הוי' האמרת"
        },
        {
          "s": 55,
          "text": "(השבח של ה' ע\"י שישראל משבחים אותו)."
        },
        {
          "s": 56,
          "text": "ועד ששבח זה"
        },
        {
          "s": 57,
          "text": "(מה שמשתבח בהשבח דישראל עצמם)"
        },
        {
          "s": 58,
          "text": "הוא"
        },
        {
          "s": 59,
          "text": "(התפילין)"
        },
        {
          "s": 60,
          "text": "הפאר שלו."
        },
        {
          "s": 61,
          "text": "גם צריך להבין מה שמביא אדמו\"ר הצ\"צ"
        },
        {
          "s": 62,
          "text": "(במאמרו ד\"ה את ה' האמרת היום)15,"
        },
        {
          "s": 63,
          "text": "דבענין האמרת והאמירך יש שתי דיעות."
        },
        {
          "s": 64,
          "text": "דהרשב\"א16"
        },
        {
          "s": 65,
          "text": "כתב שהאמרת והאמירך הוא ע\"ד דודי לי ואני לו17,"
        },
        {
          "s": 66,
          "text": "והמהרש\"א18"
        },
        {
          "s": 67,
          "text": "כתב שהוא ע\"ד אני לדודי ודודי לי19."
        },
        {
          "s": 68,
          "text": "וצריך להבין,"
        },
        {
          "s": 69,
          "text": "הרי הסדר דהאמרת והאמירך"
        },
        {
          "s": 70,
          "text": "(האמרת ואח\"כ האמירך)"
        },
        {
          "s": 71,
          "text": "הוא דוגמת אני לדודי"
        },
        {
          "s": 72,
          "text": "(ואח\"כ)"
        },
        {
          "s": 73,
          "text": "ודודי לי,"
        },
        {
          "s": 74,
          "text": "ומהו טעמו של הרשב\"א דהאמרת והאמירך הוא ע\"ד דודי לי ואני לו."
        }
      ]
    }
  ]
}