{
  "globalIndex": 402,
  "owner": 2,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518916062_theRebbe_542__p001",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518916062_theRebbe_542__p001",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518916062_theRebbe_542",
  "title": "מאמר פדה בשלום תשל\"א",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "י\"ט כסלו,"
        },
        {
          "s": 2,
          "text": "ה'תשל\"א*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "(הנחה בלתי מוגה)"
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "פדה בשלום נפשי מקרב לי כי ברבים היו עמדי1,"
        },
        {
          "s": 1,
          "text": "וידוע מש\"כ2"
        },
        {
          "s": 2,
          "text": "כ\"ק אדמו\"ר הזקן להגאון החסיד רלי\"צ ז\"ל מבאַרדיטשוב3,"
        },
        {
          "s": 3,
          "text": "כשקראתי כו' פדה בשלום נפשי כו' יצאתי בשלום מהוי' שלום."
        },
        {
          "s": 4,
          "text": "ומזה מובן שענין השלום שבהפדי' הו\"ע עיקרי,"
        },
        {
          "s": 5,
          "text": "שלכן מדגיש ענין זה"
        },
        {
          "s": 6,
          "text": "(ג' פעמים4)"
        },
        {
          "s": 7,
          "text": "במכתבו: פדה בשלום,"
        },
        {
          "s": 8,
          "text": "יצאתי בשלום,"
        },
        {
          "s": 9,
          "text": "מהוי' שלום."
        },
        {
          "s": 10,
          "text": "וכן מובן גם מאגה\"ק שבתניא סי' ב' שכתבו אחר ביאתו מפ\"ב"
        },
        {
          "s": 11,
          "text": "(לכללות אנ\"ש)"
        },
        {
          "s": 12,
          "text": "שסיומו וחותמו שצ\"ל שלום כו',"
        },
        {
          "s": 13,
          "text": "ההנהגה באופן אשר יתן ה' בלב אחיהם כמים הפנים וגו'."
        },
        {
          "s": 14,
          "text": "וכדמוכח ג\"כ מזה שבכו\"כ דרושי חסידות על פסוק זה5,"
        },
        {
          "s": 15,
          "text": "ובפרט בהדרושים די\"ט כסלו,"
        },
        {
          "s": 16,
          "text": "מבואר שהענין והחידוש דפדי' זו הוא מה שהפדי' היא בשלום."
        },
        {
          "s": 17,
          "text": "וצריך להבין,"
        },
        {
          "s": 18,
          "text": "דלכאורה הרי העיקר הוא עצם ענין הפדי'"
        },
        {
          "s": 19,
          "text": "(בין בנוגע לדוד נעים זמירות ישראל"
        },
        {
          "s": 20,
          "text": "(וכן בנוגע לדוד מלכא משיחא6),"
        },
        {
          "s": 21,
          "text": "ובין בנוגע לכ\"ק אדה\"ז בעל השמחה והגאולה,"
        },
        {
          "s": 22,
          "text": "הרי עיקר הענין הוא מה שיצא מהמאסר לחירות),"
        },
        {
          "s": 23,
          "text": "ומהי ההדגשה של בשלום דוקא."
        },
        {
          "s": 24,
          "text": "ועוד צריך להבין,"
        },
        {
          "s": 25,
          "text": "הרי ההמשך דפדה בשלום נפשי הוא כנאמר בכתוב מקרב לי כי ברבים היו עמדי,"
        },
        {
          "s": 26,
          "text": "ומכיון שהפדי' היא מקרב היינו מלחמה,"
        },
        {
          "s": 27,
          "text": "וכן זה שישנם רבים"
        },
        {
          "s": 28,
          "text": "(אלא שנהפוך הוא והרבים היו עמדי – כדאיתא בירושלמי7),"
        },
        {
          "s": 29,
          "text": "הרי מובן שהפדי' מצ\"ע הייתה צ\"ל באופן של מלחמה."
        },
        {
          "s": 30,
          "text": "וא\"כ צריך להבין מהו ההכרח דהפדי' תהי' בשלום דוקא."
        },
        {
          "s": 31,
          "text": "והנה נקודת הענין בזה,"
        },
        {
          "s": 32,
          "text": "מבואר בד\"ה פדה בשלום אשר לכ\"ק אדמו\"ר האמצעי,"
        },
        {
          "s": 33,
          "text": "ממלא מקומו של בעל השמחה והגאולה"
        },
        {
          "s": 34,
          "text": "(בשערי תשובה – שער התפלה),"
        },
        {
          "s": 35,
          "text": "דכאשר העבודה היא מצד בחי' יחידה,"
        },
        {
          "s": 36,
          "text": "הנה אז הפדי' היא בשלום."
        }
      ]
    }
  ]
}