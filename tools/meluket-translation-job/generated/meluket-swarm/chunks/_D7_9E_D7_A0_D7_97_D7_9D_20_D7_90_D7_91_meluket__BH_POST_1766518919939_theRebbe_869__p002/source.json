{
  "globalIndex": 1043,
  "owner": 43,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919939_theRebbe_869__p002",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919939_theRebbe_869__p002",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919939_theRebbe_869",
  "title": "מאמר ועתה ישראל תשכ\"ח",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "וע\"פ הידוע16"
        },
        {
          "s": 2,
          "text": "שעבודת האדם"
        },
        {
          "s": 3,
          "text": "(אתערותא דלתתא)"
        },
        {
          "s": 4,
          "text": "שעל ידה נעשית ההמשכה"
        },
        {
          "s": 5,
          "text": "(אתערותא דלעילא)"
        },
        {
          "s": 6,
          "text": "צריכה להיות מעין ההמשכה,"
        },
        {
          "s": 7,
          "text": "יש לומר,"
        },
        {
          "s": 8,
          "text": "שהעבודה שעל ידה נעשית הברכה וההמשכה מעלמא דאתכסיא לעלמא דאתגליא,"
        },
        {
          "s": 9,
          "text": "היא האהבה דבכל נפשך."
        },
        {
          "s": 10,
          "text": "והענין הוא,"
        },
        {
          "s": 11,
          "text": "דפירוש בכל נפשך הוא בכל כחות הנפש,"
        },
        {
          "s": 12,
          "text": "שכל ומדות17."
        },
        {
          "s": 13,
          "text": "ויש לומר הכוונה בזה,"
        },
        {
          "s": 14,
          "text": "שמעלת האהבה דבכל נפשך על האהבה דבכל לבבך היא,"
        },
        {
          "s": 15,
          "text": "שבהאהבה דבכל לבבך העיקר היא המדה"
        },
        {
          "s": 16,
          "text": "[שלכן נאמר בה בכל לבבך דלב הוא מקום משכן המדות],"
        },
        {
          "s": 17,
          "text": "כי ההשגה שמולידה אהבה זו היא בחיצוניות השכל השייך למדות,"
        },
        {
          "s": 18,
          "text": "וההשגה דבחינה זו היא18"
        },
        {
          "s": 19,
          "text": "במוח ואינה מאירה בלב,"
        },
        {
          "s": 20,
          "text": "ולכן הולדת האהבה מהשכל אינה בדרך ממילא אלא שהשכל צריך לפעול את האהבה."
        },
        {
          "s": 21,
          "text": "ובהאהבה דבכל נפשך,"
        },
        {
          "s": 22,
          "text": "ההשגה שממנה באה האהבה היא בפנימיות השכל,"
        },
        {
          "s": 23,
          "text": "שההשגה דבחינה זו מאירה18"
        },
        {
          "s": 24,
          "text": "בלב,"
        },
        {
          "s": 25,
          "text": "והמשכת האהבה מהשכל היא באופן דבדרך ממילא."
        },
        {
          "s": 26,
          "text": "ולכן נאמר בה בכל נפשך,"
        },
        {
          "s": 27,
          "text": "כל כחות הנפש,"
        },
        {
          "s": 28,
          "text": "כי באהבה זו נרגש גם השכל."
        },
        {
          "s": 29,
          "text": "[ויש לקשר זה עם המבואר במק\"א19,"
        },
        {
          "s": 30,
          "text": "שהאהבה דבכל לבבך היא רק בלב והאהבה דבכל נפשך היא"
        },
        {
          "s": 31,
          "text": "(לא רק בלב,"
        },
        {
          "s": 32,
          "text": "אלא)"
        },
        {
          "s": 33,
          "text": "מתפשטת גם בכל הכחות והאברים,"
        },
        {
          "s": 34,
          "text": "דיש לומר הכוונה בזה,"
        },
        {
          "s": 35,
          "text": "שבהאהבה דבכל לבבך,"
        },
        {
          "s": 36,
          "text": "זה שמקיים את המצוות מפני אהבתו את הוי' הוא באופן שהאהבה פועלת על המעשה שלו,"
        },
        {
          "s": 37,
          "text": "ובהאהבה דבכל נפשך,"
        },
        {
          "s": 38,
          "text": "עשיית המצוות שלו היא כמו בדרך ממילא."
        },
        {
          "s": 39,
          "text": "ויש לומר,"
        },
        {
          "s": 40,
          "text": "דהמשכת המדות בהכחות שלמטה מהם היא בדוגמת המשכת המדות עצמם,"
        },
        {
          "s": 41,
          "text": "שהמדות נמשכים מהשכל באופן דפעולה,"
        },
        {
          "s": 42,
          "text": "שהשכל צריך לפעול את המדה,"
        },
        {
          "s": 43,
          "text": "והמשכתם בהכחות שלמטה מהם היא באופן דפעולה."
        },
        {
          "s": 44,
          "text": "והמדות שנמשכים מהשכל באופן דממילא,"
        },
        {
          "s": 45,
          "text": "כי השכל מאיר גם בלב – המשכתם בהכחות שלמטה מהם היא באופן שהמדות עצמם מתפשטים בכל הכחות והאברים,"
        },
        {
          "s": 46,
          "text": "ופעולתם בהכחות והאברים היא באופן דבדרך ממילא]."
        },
        {
          "s": 47,
          "text": "וכיון שמוחין הם נסתרות ומדות הם נגלות20,"
        },
        {
          "s": 48,
          "text": "לכן,"
        },
        {
          "s": 49,
          "text": "ע\"י האהבה דבכל נפשך,"
        },
        {
          "s": 50,
          "text": "שהמוחין מאירים גם בלב,"
        },
        {
          "s": 51,
          "text": "נעשית הברכה וההמשכה מעלמא דאתכסיא לעלמא דאתגליא."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ועוד ביאור בהחילוק שבין האהבה דבכל לבבך והאהבה דבכל נפשך21,"
        },
        {
          "s": 2,
          "text": "שהאהבה דבכל לבבך היא בבחינת ממלא כל עלמין,"
        },
        {
          "s": 3,
          "text": "דכיון שהחיות דבחינת ממכ\"ע הוא מלובש בהנבראים בפנימיותם,"
        },
        {
          "s": 4,
          "text": "לכן ע\"י ההתבוננות נרגש חיות זה גם בנפש הבהמית,"
        },
        {
          "s": 5,
          "text": "והאהבה היא בכל לבבך בשני יצריך22."
        },
        {
          "s": 6,
          "text": "והאהבה דבכל נפשך היא בבחינת סוכ\"ע,"
        },
        {
          "s": 7,
          "text": "דכיון שאור הסובב הוא למעלה מהתלבשות בעולמות,"
        },
        {
          "s": 8,
          "text": "לכן ע\"י שנרגש בו ההפלאה דאוא\"ס"
        },
        {
          "s": 9,
          "text": "(סובב),"
        },
        {
          "s": 10,
          "text": "אהבתו את הוי' היא באופן דמסירת נפש,"
        },
        {
          "s": 11,
          "text": "אפילו נוטל את נפשך22."
        },
        {
          "s": 12,
          "text": "ועפ\"ז,"
        },
        {
          "s": 13,
          "text": "השייכות דהאהבה דבכל נפשך לההמשכה מעלמא דאתכסיא"
        },
        {
          "s": 14,
          "text": "(ענין הברכה)"
        },
        {
          "s": 15,
          "text": "היא לא רק לענין עלמא דאתכסיא כמו שהוא בספירות,"
        },
        {
          "s": 16,
          "text": "בינה,"
        },
        {
          "s": 17,
          "text": "אלא גם לענין עלמא דאתכסיא"
        },
        {
          "s": 18,
          "text": "(סובב)"
        },
        {
          "s": 19,
          "text": "כמו שהוא בכללות הגילויים"
        },
        {
          "s": 20,
          "text": "(ממלא)."
        },
        {
          "s": 21,
          "text": "ויש לומר,"
        },
        {
          "s": 22,
          "text": "דזה שע\"י האהבה שמצד הרגש ההפלאה דאוא\"ס נעשית ההמשכה מעלמא דאתכסיא"
        },
        {
          "s": 23,
          "text": "(סובב)"
        },
        {
          "s": 24,
          "text": "לעלמא דאתגליא"
        },
        {
          "s": 25,
          "text": "(ממלא),"
        },
        {
          "s": 26,
          "text": "הוא בעיקר כשאהבה זו,"
        },
        {
          "s": 27,
          "text": "שהיא מצד בחינת חי'"
        },
        {
          "s": 28,
          "text": "(מקיף),"
        },
        {
          "s": 29,
          "text": "נרגשת גם בהנר\"נ"
        },
        {
          "s": 30,
          "text": "(פנימי)"
        },
        {
          "s": 31,
          "text": "שלו."
        },
        {
          "s": 32,
          "text": "ועי\"ז נעשה החיבור דסובב וממלא."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה ידוע23,"
        },
        {
          "s": 2,
          "text": "שבכדי שיהי' החיבור דסובב וממלא הוא ע\"י המשכת אוא\"ס שלמעלה מסובב וממלא."
        },
        {
          "s": 3,
          "text": "וזהו24"
        },
        {
          "s": 4,
          "text": "אל תקרי מה אלא מאה,"
        },
        {
          "s": 5,
          "text": "מה הוא מלכות,"
        },
        {
          "s": 6,
          "text": "ממלא,"
        },
        {
          "s": 7,
          "text": "מאה הוא אריך,"
        },
        {
          "s": 8,
          "text": "סובב,"
        },
        {
          "s": 9,
          "text": "ואל תקרי מה אלא מאה הוא שגם במה"
        },
        {
          "s": 10,
          "text": "(ממלא)"
        },
        {
          "s": 11,
          "text": "תהי' המשכת מאה"
        },
        {
          "s": 12,
          "text": "(סובב)."
        },
        {
          "s": 13,
          "text": "והחילוק בין מאה למה הוא שמיתוסף בו אות אל\"ף,"
        },
        {
          "s": 14,
          "text": "דאל\"ף הוא בחינת עתיק"
        },
        {
          "s": 15,
          "text": "(בחינת חד ולא בחושבן25)"
        },
        {
          "s": 16,
          "text": "שלמעלה מסובב."
        },
        {
          "s": 17,
          "text": "ויש לומר,"
        },
        {
          "s": 18,
          "text": "דהטעם על זה שע\"י שמוסיפים אל\"ף בתיבת מה נעשה מאה,"
        },
        {
          "s": 19,
          "text": "הוא,"
        },
        {
          "s": 20,
          "text": "כי אל\"ף הוא בחינת עתיק,"
        },
        {
          "s": 21,
          "text": "שעי\"ז נעשה חיבור דסובב"
        },
        {
          "s": 22,
          "text": "(מאה)"
        },
        {
          "s": 23,
          "text": "וממלא"
        },
        {
          "s": 24,
          "text": "(מה),"
        },
        {
          "s": 25,
          "text": "ולכן,"
        },
        {
          "s": 26,
          "text": "ע\"י"
        },
        {
          "s": 27,
          "text": "(הוספת)"
        },
        {
          "s": 28,
          "text": "אל\"ף נעשה מה למאה."
        }
      ]
    }
  ]
}