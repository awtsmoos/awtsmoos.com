{
  "globalIndex": 195,
  "owner": 45,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914911_theRebbe_655__p003",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914911_theRebbe_655__p003",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518914911_theRebbe_655",
  "title": "מאמר ויהיו חיי שרה תשמ\"א",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "אך ביחד ע\"ז כתיב34"
        },
        {
          "s": 1,
          "text": "עבדו את ה' ביראה,"
        },
        {
          "s": 2,
          "text": "אלא שבפסוק זה עצמו ממשיך וגילו ברעדה,"
        },
        {
          "s": 3,
          "text": "שצ\"ל שמחה."
        },
        {
          "s": 4,
          "text": "אלא כאשר השמחה היא במורגש,"
        },
        {
          "s": 5,
          "text": "אפשר שמזה יבוא להרגשת הישות,"
        },
        {
          "s": 6,
          "text": "ועי\"ז לכמה דברים בלתי רצויים שמסתעפים מזה."
        },
        {
          "s": 7,
          "text": "ולכן צ\"ל עבדו את ה' ביראה וגילו ברעדה,"
        },
        {
          "s": 8,
          "text": "שעי\"ז תהי' השמחה"
        },
        {
          "s": 9,
          "text": "(שלא בבחי' מורגש,"
        },
        {
          "s": 10,
          "text": "כ\"א)"
        },
        {
          "s": 11,
          "text": "בבחי' ביטול וענוה,"
        },
        {
          "s": 12,
          "text": "ובלשון הכתוב35"
        },
        {
          "s": 13,
          "text": "ויספו ענוים בה' שמחה,"
        },
        {
          "s": 14,
          "text": "שהשמחה היא ביחד או מצד הענוה והביטול"
        },
        {
          "s": 15,
          "text": "(וכדלקמן סעיף ו)."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז מבאר בעל יום ההולדת במאמרו הנ\"ל36"
        },
        {
          "s": 2,
          "text": "ענין אתת חוה כו' אתת שרה כו',"
        },
        {
          "s": 3,
          "text": "שהצד השוה שבהם הוא שרצו לפעול ענין השמחה."
        },
        {
          "s": 4,
          "text": "כמארז\"ל גבי חוה37"
        },
        {
          "s": 5,
          "text": "אשכול של ענבים סחטה ונתנה לו,"
        },
        {
          "s": 6,
          "text": "ובנח כתיב38"
        },
        {
          "s": 7,
          "text": "ויטע כרם וישת מן היין,"
        },
        {
          "s": 8,
          "text": "דיין הו\"ע השמחה כמ\"ש39"
        },
        {
          "s": 9,
          "text": "יין המשמח אלקים ואנשים."
        },
        {
          "s": 10,
          "text": "אלא שבחוה היתה השמחה בבחי' מורגש,"
        },
        {
          "s": 11,
          "text": "דבחוה כתיב40"
        },
        {
          "s": 12,
          "text": "ותרא האשה כי טוב העץ למאכל וכי תאוה הוא גו' שזהו\"ע ההרגשה41."
        },
        {
          "s": 13,
          "text": "ונח רצה לתקן את חטא עה\"ד42,"
        },
        {
          "s": 14,
          "text": "שהוא ענין ההרגשה,"
        },
        {
          "s": 15,
          "text": "ע\"י הרגשה,"
        },
        {
          "s": 16,
          "text": "ולא עלתה בידו."
        },
        {
          "s": 17,
          "text": "דוישת מן היין הביא אותו"
        },
        {
          "s": 18,
          "text": "(לא לשמחה שבבחי' ביטול,"
        },
        {
          "s": 19,
          "text": "יין המשמח,"
        },
        {
          "s": 20,
          "text": "כי אם)"
        },
        {
          "s": 21,
          "text": "לוישכר,"
        },
        {
          "s": 22,
          "text": "יין המשכר."
        },
        {
          "s": 23,
          "text": "והגם דבשכרות הוא העדר ההרגשה,"
        },
        {
          "s": 24,
          "text": "אבל העדר ההרגשה שבזה הוא לא מצד הענוה והביטול כ\"א מצד בלבול הדעת"
        },
        {
          "s": 25,
          "text": "(וההרגשה)."
        },
        {
          "s": 26,
          "text": "והתיקון על חטא עה\"ד"
        },
        {
          "s": 27,
          "text": "(ענין ההרגשה)"
        },
        {
          "s": 28,
          "text": "נעשה ע\"י שרה דוקא"
        },
        {
          "s": 29,
          "text": "[כמבואר בקבלה43"
        },
        {
          "s": 30,
          "text": "ששרה תיקנה מה שקלקלה חוה],"
        },
        {
          "s": 31,
          "text": "דשרה היא בחי' מלכות44"
        },
        {
          "s": 32,
          "text": "[שלכן נקראת שרה מלשון45"
        },
        {
          "s": 33,
          "text": "שררה]46,"
        },
        {
          "s": 34,
          "text": "ענין הביטול,"
        },
        {
          "s": 35,
          "text": "ולכן על ידה דוקא נעשה התיקון,"
        },
        {
          "s": 36,
          "text": "שמחה שבבחי' ביטול."
        },
        {
          "s": 37,
          "text": "וזהו אתת שרה ונחתת וסלקת,"
        },
        {
          "s": 38,
          "text": "שמצד הביטול שבמלכות הנה גם כשהיא יורדת למטה,"
        },
        {
          "s": 39,
          "text": "הירידה"
        },
        {
          "s": 40,
          "text": "(נחתת)"
        },
        {
          "s": 41,
          "text": "היא בשביל העלי'"
        },
        {
          "s": 42,
          "text": "(וסלקת),"
        },
        {
          "s": 43,
          "text": "דירידת המלכות למטה היא בכדי לברר ולתקן הניצוצות דקדושה שנמצאים למטה ולהעלותם למעלה."
        },
        {
          "s": 44,
          "text": "וכמו\"כ הוא בירידת"
        },
        {
          "s": 45,
          "text": "(אברהם ו)"
        },
        {
          "s": 46,
          "text": "שרה למצרים"
        },
        {
          "s": 47,
          "text": "(בגשמיות),"
        },
        {
          "s": 48,
          "text": "שזה הי' בכדי47"
        },
        {
          "s": 49,
          "text": "שהעלי' ממצרים,"
        },
        {
          "s": 50,
          "text": "ויעל אברם ממצרים הוא ואשתו11,"
        },
        {
          "s": 51,
          "text": "תהי' באופן של ואברם כבד מאד במקנה בכסף ובזהב48,"
        },
        {
          "s": 52,
          "text": "שזה נעשה ע\"י שרה כמ\"ש49"
        },
        {
          "s": 53,
          "text": "ולאברם הטיב בעבורה."
        },
        {
          "s": 54,
          "text": "ועי\"ז זכתה לחיין עילאין,"
        },
        {
          "s": 55,
          "text": "ועד אשר דילה הוו חיין,"
        },
        {
          "s": 56,
          "text": "שהחיין הן דילה"
        },
        {
          "s": 57,
          "text": "(גם)"
        },
        {
          "s": 58,
          "text": "במורגש,"
        },
        {
          "s": 59,
          "text": "דלהיות שהמלכות היא בבחי' ביטול בעצם לכן גם המורגש שבה הוא בבחי' ביטול."
        },
        {
          "s": 60,
          "text": "ובעבודה הוא,"
        },
        {
          "s": 61,
          "text": "דגם כשהשמחה היא בהתגלות מ\"מ היא בבחי' ביטול"
        },
        {
          "s": 62,
          "text": "[ובדוגמת מלך שעם היותו ברוממות ובשמחה,"
        },
        {
          "s": 63,
          "text": "עוז וחדוה במקומו50,"
        },
        {
          "s": 64,
          "text": "אין זה בבחי' ישות]."
        },
        {
          "s": 65,
          "text": "ולכן משמחה זו,"
        },
        {
          "s": 66,
          "text": "הנה נוסף על שאינו שייך שיהיו מזה תוצאות בלתי רצויות"
        },
        {
          "s": 67,
          "text": "(כמו שהי' בחוה ובנח),"
        },
        {
          "s": 68,
          "text": "אלא אדרבא היא מביאה לתכלית העילוי,"
        },
        {
          "s": 69,
          "text": "ועד לדרגא שבדוגמת לעתיד לבוא,"
        },
        {
          "s": 70,
          "text": "וכמבואר בהמאמר"
        },
        {
          "s": 71,
          "text": "(של בעל יום ההולדת)51"
        },
        {
          "s": 72,
          "text": "שענין דילה הוו חיין הוא דוגמת ונחי' לפניו52"
        },
        {
          "s": 73,
          "text": "שיהי' לעתיד,"
        },
        {
          "s": 74,
          "text": "חיים בתכלית השלימות."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ויש לקשר זה עם הכתוב53"
        },
        {
          "s": 2,
          "text": "אז ימלא שחוק פינו,"
        },
        {
          "s": 3,
          "text": "שלעתיד לבוא תהי' השמחה בתכלית השלימות,"
        },
        {
          "s": 4,
          "text": "ועד שהשמחה דעכשיו,"
        },
        {
          "s": 5,
          "text": "גם כשהיא בתכלית השלימות"
        },
        {
          "s": 6,
          "text": "(עד כמה שאפשר להיות עכשיו),"
        },
        {
          "s": 7,
          "text": "היא באין ערוך לגבי השמחה והשחוק שיהיו לעתיד לבוא54,"
        },
        {
          "s": 8,
          "text": "אז ימלא שחוק פינו."
        },
        {
          "s": 9,
          "text": "והגם שהשמחה דלעתיד לבוא תבוא"
        },
        {
          "s": 10,
          "text": "(ככל הענינים דלעתיד55)"
        },
        {
          "s": 11,
          "text": "ע\"י עבודת ה' בשמחה במשך זמן הגלות,"
        },
        {
          "s": 12,
          "text": "מ\"מ השכר שיהי' מזה לעתיד לבוא"
        },
        {
          "s": 13,
          "text": "(אז ימלא שחוק פינו)"
        },
        {
          "s": 14,
          "text": "הוא שלא בערך ועד שלא בערך כלל,"
        },
        {
          "s": 15,
          "text": "ועד שהוא למעלה מגדר שכר."
        },
        {
          "s": 16,
          "text": "ועפ\"ז יש לבאר מה שבנה של שרה,"
        },
        {
          "s": 17,
          "text": "ששרה התפללה עליו וביותר"
        },
        {
          "s": 18,
          "text": "(עוד יותר מאברהם אבינו56),"
        },
        {
          "s": 19,
          "text": "נקרא בשם יצחק על שם צחוק עשה לי אלקים57,"
        },
        {
          "s": 20,
          "text": "כי ענין דילה הוו חיין"
        },
        {
          "s": 21,
          "text": "(דשרה)"
        },
        {
          "s": 22,
          "text": "הוא כמו ונחי' לפניו שיהי' לעתיד"
        },
        {
          "s": 23,
          "text": "(כנ\"ל מהמאמר דבעל יום ההולדת),"
        },
        {
          "s": 24,
          "text": "וזהו שבנה של שרה הוא יצחק שענינו הוא צחוק ושמחה,"
        },
        {
          "s": 25,
          "text": "ועד לשחוק ושמחה שבדוגמת ימלא שחוק פינו דלעתיד לבוא58,"
        },
        {
          "s": 26,
          "text": "שלכן לעתיד לבוא יאמרו ליצחק"
        },
        {
          "s": 27,
          "text": "(דוקא)"
        },
        {
          "s": 28,
          "text": "כי אתה אבינו59."
        }
      ]
    }
  ]
}