{
  "globalIndex": 720,
  "owner": 20,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917980_theRebbe_758__p004",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917980_theRebbe_758__p004",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917980_theRebbe_758",
  "title": "מאמר ונחה עליו רוח ה' תשכ\"ה",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה ידוע49"
        },
        {
          "s": 2,
          "text": "דכוונת הצמצום הוא בכדי שהגילוי דאוא\"ס יהי' גם בעולמות."
        },
        {
          "s": 3,
          "text": "דקודם הצמצום,"
        },
        {
          "s": 4,
          "text": "כשהי' אוא\"ס ממלא מקום החלל,"
        },
        {
          "s": 5,
          "text": "לא הי' אפשר להיות מציאות העולמות,"
        },
        {
          "s": 6,
          "text": "ובמילא לא הי' הגילוי בעולמות,"
        },
        {
          "s": 7,
          "text": "וע\"י הצמצום נתחדש שהגילוי דאוא\"ס יהי' גם בעולמות."
        },
        {
          "s": 8,
          "text": "ויובן זה בהקדים הידוע50"
        },
        {
          "s": 9,
          "text": "(בענין ההעלם דהצמצום,"
        },
        {
          "s": 10,
          "text": "מה שאור הבל\"ג נתעלם ונכלל במקורו),"
        },
        {
          "s": 11,
          "text": "דקודם הצמצום,"
        },
        {
          "s": 12,
          "text": "כאשר אוא\"ס הי' ממלא את מקום החלל"
        },
        {
          "s": 13,
          "text": "(היינו שהאיר בו אוא\"ס הבל\"ג)"
        },
        {
          "s": 14,
          "text": "הי' אלקות בפשיטות ומציאות בהתחדשות,"
        },
        {
          "s": 15,
          "text": "וע\"י סילוק האור,"
        },
        {
          "s": 16,
          "text": "נעשה מציאות בפשיטות ואלקות בהתחדשות."
        },
        {
          "s": 17,
          "text": "ובהחילוק דשני ענינים אלו בעבודת האדם,"
        },
        {
          "s": 18,
          "text": "כמה מדריגות."
        },
        {
          "s": 19,
          "text": "בכללות הוא החילוק בין ראיית אלקות להשגת אלקות."
        },
        {
          "s": 20,
          "text": "דכאשר הידיעה באלקות היא באופן דראי',"
        },
        {
          "s": 21,
          "text": "אפילו בראי' דחכמה ועאכו\"כ בראי' דנבואה שהיא ראי' ממש51,"
        },
        {
          "s": 22,
          "text": "הידיעה היא בפשיטות שאין צריך לראיות והוכחות על זה,"
        },
        {
          "s": 23,
          "text": "משא\"כ כשהידיעה באלקות היא מצד הכרח השכל,"
        },
        {
          "s": 24,
          "text": "היא בדרך התחדשות."
        },
        {
          "s": 25,
          "text": "אבל בפרטיות,"
        },
        {
          "s": 26,
          "text": "הענין דאלקות בפשיטות יהי' לע\"ל,"
        },
        {
          "s": 27,
          "text": "משא\"כ עכשיו גם הגילוי דנבואה הוא בדרך התחדשות."
        },
        {
          "s": 28,
          "text": "שהרי בדברים גשמיים יכול לראות כל אחד ואין בזה הפלאה כלל,"
        },
        {
          "s": 29,
          "text": "משא\"כ ענין הנבואה הוא דוקא במי שהוא ראוי לזה,"
        },
        {
          "s": 30,
          "text": "דאין הנבואה חלה אלא על חכם גדול בחכמה גבור במדותיו וכו'52,"
        },
        {
          "s": 31,
          "text": "וכן הוא בראי' דחכמה שהיא רק ביחידי סגולה,"
        },
        {
          "s": 32,
          "text": "הרי שגילוי הנבואה עכשיו הוא בדרך חידוש ולא בדרך פשיטות,"
        },
        {
          "s": 33,
          "text": "והוא מה שאומרים עליו חידוש שהוא נביא."
        },
        {
          "s": 34,
          "text": "והוא מפני שכללות הגילוי עכשיו,"
        },
        {
          "s": 35,
          "text": "גם הגילוי דנבואה,"
        },
        {
          "s": 36,
          "text": "הוא מאור הקו שאחר הצמצום."
        },
        {
          "s": 37,
          "text": "משא\"כ לע\"ל שאז יהי' הגילוי דאוא\"ס שקודם הצמצום,"
        },
        {
          "s": 38,
          "text": "תהי' הנבואה כמו דבר טבעי ממש,"
        },
        {
          "s": 39,
          "text": "שלכן יהי' בכאו\"א,"
        },
        {
          "s": 40,
          "text": "גם בילדים וילדות,"
        },
        {
          "s": 41,
          "text": "כמ\"ש53"
        },
        {
          "s": 42,
          "text": "אשפוך את רוחי על כל בשר וניבאו בניכם ובנותיכם54."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ועד\"ז הי' גם בראיית אלקות שהיתה בבית המקדש,"
        },
        {
          "s": 2,
          "text": "דזה שהגילוי דראי' שבביהמ\"ק הי' בכאו\"א,"
        },
        {
          "s": 3,
          "text": "יראה כל זכורך,"
        },
        {
          "s": 4,
          "text": "הוא מפני שבביהמ\"ק האיר גילוי אוא\"ס שקודם הצמצום,"
        },
        {
          "s": 5,
          "text": "אלא שאעפ\"כ,"
        },
        {
          "s": 6,
          "text": "גם הגילוי דביהמ\"ק לא הי' כמו דבר טבעי ממש."
        },
        {
          "s": 7,
          "text": "דמכיון שהגילוי הי' רק בביהמ\"ק"
        },
        {
          "s": 8,
          "text": "[ולא כמו ראיית דברים גשמיים שאין צריך לזה מקום מיוחד],"
        },
        {
          "s": 9,
          "text": "הרי מובן,"
        },
        {
          "s": 10,
          "text": "דזה שבביהמ\"ק הי' ראיית אלקות הי' מצד איזו סיבה,"
        },
        {
          "s": 11,
          "text": "מצד גילוי דאוא\"ס שהאיר בביהמ\"ק,"
        },
        {
          "s": 12,
          "text": "משא\"כ לע\"ל55"
        },
        {
          "s": 13,
          "text": "תהי' ראיית אלקות כמו דבר טבעי ממש,"
        },
        {
          "s": 14,
          "text": "כמ\"ש56"
        },
        {
          "s": 15,
          "text": "וראו כל בשר גו',"
        },
        {
          "s": 16,
          "text": "דהתכונות של עיני בשר57"
        },
        {
          "s": 17,
          "text": "יהיו באופן כזה שיראו אלקות58."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "וצריך להבין,"
        },
        {
          "s": 2,
          "text": "הרי הגילוי דאוא\"ס הבל\"ג ומציאות העולמות הם שני הפכים,"
        },
        {
          "s": 3,
          "text": "שלכן כשהי' אוא\"ס ממלא את מקום החלל לא הי' אפשר להיות התהוות העולמות ובכדי שיהי' מקום לעולמות הוצרך להיות סילוק האור,"
        },
        {
          "s": 4,
          "text": "ומכיון שהתהוות דמציאות העולמות היא דוקא מסילוק האור"
        },
        {
          "s": 5,
          "text": "(היפך ענין הגילוי),"
        },
        {
          "s": 6,
          "text": "היאך אפשר שהמציאות דעולמות"
        },
        {
          "s": 7,
          "text": "(ועאכו\"כ המציאות דבשר גשמי)"
        },
        {
          "s": 8,
          "text": "תהי' באופן שבמציאותה יהי' בה גילוי אלקות."
        },
        {
          "s": 9,
          "text": "והענין בזה,"
        },
        {
          "s": 10,
          "text": "דמכיון שכוונת הצמצום היא בשביל הגילוי"
        },
        {
          "s": 11,
          "text": "(שהגילוי יהי' גם במציאות העולמות,"
        },
        {
          "s": 12,
          "text": "כנ\"ל),"
        },
        {
          "s": 13,
          "text": "הרי שפנימיות הצמצום"
        },
        {
          "s": 14,
          "text": "[ובמילא גם העולמות שנתהוו מהצמצום]"
        },
        {
          "s": 15,
          "text": "אינו סותר לגילוי,"
        },
        {
          "s": 16,
          "text": "ואדרבא,"
        },
        {
          "s": 17,
          "text": "זהו"
        },
        {
          "s": 18,
          "text": "(ענין הגילוי)"
        },
        {
          "s": 19,
          "text": "ענינו הפנימי דהצמצום."
        },
        {
          "s": 20,
          "text": "אלא שבכדי לגלות הפנימיות דהצמצום,"
        },
        {
          "s": 21,
          "text": "זה נעשה ע\"י העבודה דישראל ובפרט בזמן הגלות"
        },
        {
          "s": 22,
          "text": "(כדלקמן סעיף ט)."
        }
      ]
    }
  ]
}