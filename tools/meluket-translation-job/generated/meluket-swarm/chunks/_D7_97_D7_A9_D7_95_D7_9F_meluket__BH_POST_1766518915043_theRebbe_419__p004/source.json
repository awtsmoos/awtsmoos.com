{
  "globalIndex": 215,
  "owner": 15,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915043_theRebbe_419__p004",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915043_theRebbe_419__p004",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518915043_theRebbe_419",
  "title": "מאמר ואברהם זקן תשל\"ח",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "אמנם ביאור זה מבאר רק השייכות דמצוות לימים."
        },
        {
          "s": 1,
          "text": "אבל עדיין אינו מובן ההכרח לעשיית המצוות בכל יום דוקא,"
        },
        {
          "s": 2,
          "text": "דלכאורה,"
        },
        {
          "s": 3,
          "text": "גם כשיחסיר יום אחד ולמחר יעשה שתי מצוות,"
        },
        {
          "s": 4,
          "text": "יזדככו המצוות ע\"י התפלה דיום המחרת."
        },
        {
          "s": 5,
          "text": "ואין לומר שהתפלה יכולה לזכך ולהעלות רק המצוות השייכות ליום זה,"
        },
        {
          "s": 6,
          "text": "דאין כל טעם לחילוק זה."
        },
        {
          "s": 7,
          "text": "ועוד דמכיון דיש ענין התשלומין"
        },
        {
          "s": 8,
          "text": "(ביום שלאח\"ז,"
        },
        {
          "s": 9,
          "text": "בתפלה הסמוכה לה)58"
        },
        {
          "s": 10,
          "text": "\"ואין אומרים כיון שעבר יומו בטל קרבנו\"59,"
        },
        {
          "s": 11,
          "text": "ועד ש"
        },
        {
          "s": 12,
          "text": "(בנוגע לכוונת התפלה)"
        },
        {
          "s": 13,
          "text": "תפלה אחת מלוקטת מתפלות כל השנה מעלית את התפלות דכל השנה60,"
        },
        {
          "s": 14,
          "text": "משמע מזה גם בנוגע לעליית המצוות שע\"י התפלה,"
        },
        {
          "s": 15,
          "text": "שהתפלה מעלית גם המצוות דיום הסמוך וכו'."
        },
        {
          "s": 16,
          "text": "וסמוכין לדבר – התפלות דשבת שהן מעלות התפלות של כל ימי החול עם כל התורה ומע\"ט שנכללו בהן61."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "אך הענין הוא,"
        },
        {
          "s": 2,
          "text": "דהנה ידוע שהתכלית דתומ\"צ הוא לפעול בירור וזיכוך בעוה\"ז הגשמי."
        },
        {
          "s": 3,
          "text": "דזהו מה שתורה לא בשמים היא62,"
        },
        {
          "s": 4,
          "text": "וכל התורה ניתנה לעשות שלום בעולם63,"
        },
        {
          "s": 5,
          "text": "ועאכו\"כ מצוות שלא ניתנו אלא לצרף בהן את הבריות64."
        },
        {
          "s": 6,
          "text": "ועד שמצות צדקה היא שקולה כנגד כל המצוות"
        },
        {
          "s": 7,
          "text": "(ונקראת בשם מצוה סתם),"
        },
        {
          "s": 8,
          "text": "כי התכלית דמצוות"
        },
        {
          "s": 9,
          "text": "[וכן התכלית דירידת הנשמה למטה]"
        },
        {
          "s": 10,
          "text": "שהוא"
        },
        {
          "s": 11,
          "text": "[לא בשביל הנשמה כ\"א]"
        },
        {
          "s": 12,
          "text": "בכדי לתקן את הגוף ונה\"ב וחלקו בעולם,"
        },
        {
          "s": 13,
          "text": "נשלם ע\"י מצות הצדקה"
        },
        {
          "s": 14,
          "text": "(יותר מאשר ע\"י שאר כל המצוות),"
        },
        {
          "s": 15,
          "text": "כמבואר בתניא65."
        },
        {
          "s": 16,
          "text": "וזהו66"
        },
        {
          "s": 17,
          "text": "שצריך להיות יומין שלימין דוקא,"
        },
        {
          "s": 18,
          "text": "שבכל יום ויום צריך להיות קיום מצוה,"
        },
        {
          "s": 19,
          "text": "כי מכיון שגדר העולם הוא מקום וזמן67,"
        },
        {
          "s": 20,
          "text": "הרי מובן שהתומ\"צ"
        },
        {
          "s": 21,
          "text": "(שתכליתם הוא לתקן את העולם)"
        },
        {
          "s": 22,
          "text": "צריכים לתקן גם את הזמן."
        },
        {
          "s": 23,
          "text": "ולכן מוכרח שבכל יום תהי' עשיית מצוה"
        },
        {
          "s": 24,
          "text": "(הגם שגם כשחסר לו יומא חדא יכול הוא לעשות את הלבוש ע\"י שיקיים מחר ב' מצוות),"
        },
        {
          "s": 25,
          "text": "כי בכדי לתקן את הימים68"
        },
        {
          "s": 26,
          "text": "(הזמן)"
        },
        {
          "s": 27,
          "text": "גופא צריך להיות כל69"
        },
        {
          "s": 28,
          "text": "יומא ויומא עביד עבידתי'."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "וזהו ואברהם זקן בא בימים,"
        },
        {
          "s": 2,
          "text": "שלאחרי שואברהם זקן הוא גם בא בימים שהוא מעלה גדולה יותר גם מהמעלה דזקן."
        },
        {
          "s": 3,
          "text": "דהנה הכוונה האמיתית בהתהוות העולמות"
        },
        {
          "s": 4,
          "text": "(בבחי' עצמות א\"ס)"
        },
        {
          "s": 5,
          "text": "היא מה שנתאוה הקב\"ה להיות לו ית' דירה בתחתונים דוקא70."
        },
        {
          "s": 6,
          "text": "וכוונה זו נשלמת ע\"י עבודת האדם,"
        },
        {
          "s": 7,
          "text": "אתם קרויין אדם71,"
        },
        {
          "s": 8,
          "text": "שהאדם דוקא יכול להשלים כוונה זו."
        },
        {
          "s": 9,
          "text": "וזהו שנקרא בשם אדם,"
        },
        {
          "s": 10,
          "text": "ע\"ש ב' הקצוות שהוא אדמה לעליון72"
        },
        {
          "s": 11,
          "text": "ושהוא נוצר מן האדמה73,"
        },
        {
          "s": 12,
          "text": "שגופו נעשה מהאדמה עצמה74"
        },
        {
          "s": 13,
          "text": "ובאופן שהי' תחילה דומם בפ\"ע"
        },
        {
          "s": 14,
          "text": "(בלי שום נפש חיונית בתוכו)"
        },
        {
          "s": 15,
          "text": "וכמ\"ש75"
        },
        {
          "s": 16,
          "text": "גלמי ראו עיניך"
        },
        {
          "s": 17,
          "text": "(ולא כגוף הצומח והחי)76,"
        },
        {
          "s": 18,
          "text": "כי גם ענין זה שבתואר אדם"
        },
        {
          "s": 19,
          "text": "(על שם האדמה)"
        },
        {
          "s": 20,
          "text": "מורה על מעלתו77,"
        },
        {
          "s": 21,
          "text": "שהוא מברר מתקן ומעלה גם את הדומם שהוא תחתון ביותר שאין תחתון למטה ממנו."
        },
        {
          "s": 22,
          "text": "ומעלה זו שבו באה בפועל ע\"י העבודה דבא בימים דוקא."
        },
        {
          "s": 23,
          "text": "שע\"י העבודה דזקן"
        },
        {
          "s": 24,
          "text": "(עצמה),"
        },
        {
          "s": 25,
          "text": "אף שגם עי\"ז בירר ותיקן את חלקו בעולם"
        },
        {
          "s": 26,
          "text": "(מקום),"
        },
        {
          "s": 27,
          "text": "מ\"מ,"
        },
        {
          "s": 28,
          "text": "מכיון שלא תיקן עדיין את הזמן,"
        },
        {
          "s": 29,
          "text": "הרי לא השלים עדיין הכוונה דדירה בתחתונים."
        },
        {
          "s": 30,
          "text": "ולכן הגם שעבודה זו מגעת בבחינת עתיק יומין,"
        },
        {
          "s": 31,
          "text": "שהיא בהעתקה"
        },
        {
          "s": 32,
          "text": "(והבדלה)"
        },
        {
          "s": 33,
          "text": "מבחי' יומין,"
        },
        {
          "s": 34,
          "text": "אין זה תכלית השלימות."
        },
        {
          "s": 35,
          "text": "משא\"כ ע\"י העבודה דבא בימים78,"
        },
        {
          "s": 36,
          "text": "כשעובד לתקן את הימים,"
        },
        {
          "s": 37,
          "text": "ועד דאת מספר ימיך אמלא79"
        },
        {
          "s": 38,
          "text": "מספר מלשון אבן ספיר"
        },
        {
          "s": 39,
          "text": "(וכמ\"ש בתו\"א80"
        },
        {
          "s": 40,
          "text": "שמספר ימיך הוא כמו השמים מספרים81"
        },
        {
          "s": 41,
          "text": "שפירש בזהר82"
        },
        {
          "s": 42,
          "text": "מנהרין ומנצצין וספירין),"
        },
        {
          "s": 43,
          "text": "היינו שהאדם מאיר את הימים"
        },
        {
          "s": 44,
          "text": "(הזמן)"
        },
        {
          "s": 45,
          "text": "באור התורה והמצוות,"
        },
        {
          "s": 46,
          "text": "עי\"ז הוא משלים הכוונה דדירה בתחתונים"
        },
        {
          "s": 47,
          "text": "(בהתחתון שבעולם הזה גופא83),"
        },
        {
          "s": 48,
          "text": "שזה"
        },
        {
          "s": 49,
          "text": "(השלמת כוונה זו)"
        },
        {
          "s": 50,
          "text": "הוא תכלית שלימות מעלת האדם,"
        },
        {
          "s": 51,
          "text": "כנ\"ל."
        }
      ]
    }
  ]
}