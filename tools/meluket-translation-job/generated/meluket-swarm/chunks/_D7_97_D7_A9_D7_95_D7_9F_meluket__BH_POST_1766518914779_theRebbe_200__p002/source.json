{
  "globalIndex": 173,
  "owner": 23,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914779_theRebbe_200__p002",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914779_theRebbe_200__p002",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518914779_theRebbe_200",
  "title": "מאמר מים רבים תשל\"ח",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה החידוש בזה שמים רבים לא יוכלו לכבות את האהבה,"
        },
        {
          "s": 2,
          "text": "דידוע דשרש המים רבים"
        },
        {
          "s": 3,
          "text": "[שהוא טרדות הפרנסה]"
        },
        {
          "s": 4,
          "text": "הוא בבחי' התהו שקדם לתיקון18."
        },
        {
          "s": 5,
          "text": "דזהו שנקראים מים רבים להיותם \"רבים\""
        },
        {
          "s": 6,
          "text": "(גם)"
        },
        {
          "s": 7,
          "text": "מצד שרשם ומקורם19."
        },
        {
          "s": 8,
          "text": "וזהו הרבותא20"
        },
        {
          "s": 9,
          "text": "בזה שמים רבים לא יוכלו לכבות את האהבה ונהרות לא ישטפוה,"
        },
        {
          "s": 10,
          "text": "דהגם ששרש המים רבים והנהרות21"
        },
        {
          "s": 11,
          "text": "הוא בבחי' התהו שקדם לתיקון"
        },
        {
          "s": 12,
          "text": "(שרש נפש האלקית),"
        },
        {
          "s": 13,
          "text": "מ\"מ לא יוכלו לכבות ח\"ו את האהבה שבנפש האלקית22."
        },
        {
          "s": 14,
          "text": "והטעם לזה הוא"
        },
        {
          "s": 15,
          "text": "(כמ\"ש לפנ\"ז23)"
        },
        {
          "s": 16,
          "text": "רשפי' רשפי אש שלהבת י-ה24,"
        },
        {
          "s": 17,
          "text": "ששרש הנשמה והאהבה מסותרת שבה הוא בעצמות אוא\"ס שלמעלה גם מבחי' תהו."
        },
        {
          "s": 18,
          "text": "ששרש האהבה שבנפש האלקית הוא בבחי' שלהבת י-ה כמו שהיא קשורה וגנוזה בגחלת"
        },
        {
          "s": 19,
          "text": "(רשפי אש25),"
        },
        {
          "s": 20,
          "text": "ולמעלה יותר26"
        },
        {
          "s": 21,
          "text": "– כמו שהוא בבחי' צור27"
        },
        {
          "s": 22,
          "text": "(שלמעלה מהוי'28),"
        },
        {
          "s": 23,
          "text": "ששם הוא שרש הנשמה,"
        },
        {
          "s": 24,
          "text": "כמבואר בלקו\"ת29"
        },
        {
          "s": 25,
          "text": "בפירוש הכתוב30"
        },
        {
          "s": 26,
          "text": "והרוח תשוב אל האלקים אשר נתנה,"
        },
        {
          "s": 27,
          "text": "שבחי' האלקים"
        },
        {
          "s": 28,
          "text": "(אשר נתנה)"
        },
        {
          "s": 29,
          "text": "הוא בחי' צור הנ\"ל."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה לא זו בלבד שאין ביכולת המים רבים הנ\"ל לכבות ח\"ו את האהבה של הנשמה,"
        },
        {
          "s": 2,
          "text": "אלא יתירה מזו,"
        },
        {
          "s": 3,
          "text": "שעל ידם נעשה יתרון בהאהבה."
        },
        {
          "s": 4,
          "text": "והוא שע\"י ירידת הנשמה למטה בעוה\"ז והתלבשותה במים רבים הנ\"ל היא מגיעה למדריגה נעלית יותר ממדריגתה קודם ירידתה למטה31."
        },
        {
          "s": 5,
          "text": "[וזהו תכלית הכוונה של מים רבים הנ\"ל."
        },
        {
          "s": 6,
          "text": "ולכן סו\"ס אין ביכולתם לכבות את האהבה,"
        },
        {
          "s": 7,
          "text": "לפי32"
        },
        {
          "s": 8,
          "text": "שתכלית עומק כוונתם של המים רבים גופא הוא אדרבא בכדי לפעול יתרון בהאהבה33]."
        },
        {
          "s": 9,
          "text": "ובעבודה העילוי שנעשה בהנשמה ע\"י ירידתה למטה והתלבשותה במים רבים הנ\"ל הוא שבאה לענין התשובה34."
        },
        {
          "s": 10,
          "text": "וכידוע35,"
        },
        {
          "s": 11,
          "text": "שהנשמות קודם ירידתן לגוף הם בבחי' צדיקים גמורים,"
        },
        {
          "s": 12,
          "text": "והיתרון שנעשה בהם ע\"י ירידתן בגוף הוא שנעשים בבחי' בעלי תשובה,"
        },
        {
          "s": 13,
          "text": "אשר במקום שבעלי תשובה עומדין צדיקים גמורים אינם עומדין36,"
        },
        {
          "s": 14,
          "text": "ויתירה מזו,"
        },
        {
          "s": 15,
          "text": "שאין יכולין לעמוד בו37,"
        },
        {
          "s": 16,
          "text": "שאין זה"
        },
        {
          "s": 17,
          "text": "(אפילו)"
        },
        {
          "s": 18,
          "text": "ביכולת38"
        },
        {
          "s": 19,
          "text": "שלהם."
        },
        {
          "s": 20,
          "text": "וזהו הטעם שירדה הנשמה למטה,"
        },
        {
          "s": 21,
          "text": "כי ענין התשובה"
        },
        {
          "s": 22,
          "text": "[הגם שאינה על עבירות דוקא,"
        },
        {
          "s": 23,
          "text": "כ\"א השבת הנפש למקורה ושרשה39]"
        },
        {
          "s": 24,
          "text": "שייך דוקא כאשר אינו נמצא במקומו האמיתי"
        },
        {
          "s": 25,
          "text": "(מקורו ושרשו),"
        },
        {
          "s": 26,
          "text": "שאז שייך שישוב לשרשו ומקורו,"
        },
        {
          "s": 27,
          "text": "בחי' והרוח תשוב אל האלקים אשר נתנה40."
        },
        {
          "s": 28,
          "text": "ומכיון שמעלת הבע\"ת היא נעלית יותר ממעלת הצדיקים"
        },
        {
          "s": 29,
          "text": "[ועד שהחילוק שביניהם הוא שלא בערך,"
        },
        {
          "s": 30,
          "text": "שלכן מקום שבעלי תשובה עומדין אין צדיקים גמורים יכולין לעמוד בו,"
        },
        {
          "s": 31,
          "text": "כנ\"ל],"
        },
        {
          "s": 32,
          "text": "לכן,"
        },
        {
          "s": 33,
          "text": "ע\"י ענין התשובה שמתחדש בהנשמה בירידתה למטה ה\"ה מתעלית יותר גם מכפי שהיתה בשרשה,"
        },
        {
          "s": 34,
          "text": "בבחי' האלקים אשר נתנה41."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והגם ששרש הנשמות הוא בעצמותו ית' שלמעלה מכל הגילויים,"
        },
        {
          "s": 2,
          "text": "וכדמוכח"
        },
        {
          "s": 3,
          "text": "(גם)"
        },
        {
          "s": 4,
          "text": "ממה שארז\"ל42"
        },
        {
          "s": 5,
          "text": "במי נמלך בנשמותיהן של צדיקים,"
        },
        {
          "s": 6,
          "text": "שענין ההמלכה הוא גם על גילויים הכי נעלים"
        },
        {
          "s": 7,
          "text": "(מכיון שהם ברצון ולא בהכרח ח\"ו),"
        },
        {
          "s": 8,
          "text": "הרי מובן שהנשמות שבהן נמלך הן למעלה מכל הגילויים43,"
        },
        {
          "s": 9,
          "text": "מ\"מ שייך לומר שע\"י התשובה"
        },
        {
          "s": 10,
          "text": "(בירידתן למטה)"
        },
        {
          "s": 11,
          "text": "נעשית בהן עלי' גם לגבי הדרגא שהי' בשרשן."
        },
        {
          "s": 12,
          "text": "ויובן זה ע\"פ מ\"ש הרב המגיד44"
        },
        {
          "s": 13,
          "text": "בפירוש מרז\"ל45"
        },
        {
          "s": 14,
          "text": "ישראל עלו במחשבה,"
        },
        {
          "s": 15,
          "text": "שהוא כמשל אדם שיש לו בן,"
        },
        {
          "s": 16,
          "text": "דגם כשהבן עבר מכנגד פניו והלך מאתו,"
        },
        {
          "s": 17,
          "text": "עכ\"ז נחקקה הצורה של הבן במחשבה של האב."
        },
        {
          "s": 18,
          "text": "אלא שבבני אדם שייך זה דוקא במי שיש לו בן כו'."
        },
        {
          "s": 19,
          "text": "אבל אצל השי\"ת שייך זה לומר אף קודם שנבראו ישראל הי' נחקק צורתם במחשבה,"
        },
        {
          "s": 20,
          "text": "כמ\"ש רז\"ל45"
        },
        {
          "s": 21,
          "text": "ישראל עלו במחשבה,"
        },
        {
          "s": 22,
          "text": "כי אצלו ית' העבר והעתיד אחד."
        },
        {
          "s": 23,
          "text": "ומובן מזה,"
        },
        {
          "s": 24,
          "text": "דזה מה שהנשמות מושרשות בעצמותו ית' ובהם נמלך כו' – הו\"ע הנשמות כמו שהן בבחי' נברא"
        },
        {
          "s": 25,
          "text": "(וכמו שהן יורדות למטה),"
        },
        {
          "s": 26,
          "text": "ורק ש"
        },
        {
          "s": 27,
          "text": "(גם)"
        },
        {
          "s": 28,
          "text": "צורה זו היא חקוקה במחשבתו ית',"
        },
        {
          "s": 29,
          "text": "לפי שאצלו ית' העבר והעתיד אחד."
        },
        {
          "s": 30,
          "text": "וכידוע46"
        },
        {
          "s": 31,
          "text": "בפירוש במי נמלך כו',"
        },
        {
          "s": 32,
          "text": "שזהו מה שעלה לפניו ית' התענוג שיתענג כבי' בעבודת הנשמות למטה."
        },
        {
          "s": 33,
          "text": "ועפ\"ז יובן ענין העלי' שנעשה בהנשמות ע\"י ירידתן למטה,"
        },
        {
          "s": 34,
          "text": "הגם שגם לפני ירידתן הן מושרשות בעצמותו ית',"
        },
        {
          "s": 35,
          "text": "כי זה מה שהן מושרשות בעצמותו ית'"
        },
        {
          "s": 36,
          "text": "(ובהם נמלך כו')"
        },
        {
          "s": 37,
          "text": "הוא מצד ידיעתו ית' שתהי' אח\"כ ירידתן למטה כו' וישלימו הכוונה47."
        },
        {
          "s": 38,
          "text": "והגם שגם בתחלה יודעים בודאות גמורה שישלימו הכוונה,"
        },
        {
          "s": 39,
          "text": "הרי זהו בכח,"
        },
        {
          "s": 40,
          "text": "ותכלית העילוי"
        },
        {
          "s": 41,
          "text": "(והכוונה)"
        },
        {
          "s": 42,
          "text": "הוא48"
        },
        {
          "s": 43,
          "text": "הפועל."
        },
        {
          "s": 44,
          "text": "[וזהו גם דיוק הלשון במי נמלך בנשמותיהן של צדיקים,"
        },
        {
          "s": 45,
          "text": "שבהיותן בבחינת ההמלכה"
        },
        {
          "s": 46,
          "text": "[שאז העילוי שלהן הוא בכח,"
        },
        {
          "s": 47,
          "text": "שיודעים שישלימו הכוונה]"
        },
        {
          "s": 48,
          "text": "הן בבחינת צדיקים,"
        },
        {
          "s": 49,
          "text": "ולאחרי ירידתן למטה"
        },
        {
          "s": 50,
          "text": "[שאז הם משלימים את הכוונה בפועל]"
        },
        {
          "s": 51,
          "text": "נעשים בבחי' בעלי תשובה]."
        }
      ]
    }
  ]
}