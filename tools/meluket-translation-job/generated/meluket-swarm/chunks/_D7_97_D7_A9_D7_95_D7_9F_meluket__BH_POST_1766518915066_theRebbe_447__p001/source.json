{
  "globalIndex": 216,
  "owner": 16,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915066_theRebbe_447__p001",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915066_theRebbe_447__p001",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518915066_theRebbe_447",
  "title": "מאמר ואברהם זקן תשמ\"ו",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ חיי שרה,"
        },
        {
          "s": 2,
          "text": "מבה\"ח כסלו,"
        },
        {
          "s": 3,
          "text": "ה'תשמ\"ו"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "ואברהם זקן בא בימים גו'1,"
        },
        {
          "s": 1,
          "text": "ומביא בזה כ\"ק אדמו\"ר"
        },
        {
          "s": 2,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 3,
          "text": "נ\"ע בעל יום ההולדת דכ\"ף חשון"
        },
        {
          "s": 4,
          "text": "(אשר בשבת זו נפעל הענין דויכולו השמים גו'2"
        },
        {
          "s": 5,
          "text": "בכל ימות השבוע שעבר,"
        },
        {
          "s": 6,
          "text": "כולל היום דכ\"ף חשון),"
        },
        {
          "s": 7,
          "text": "במאמרו על פסוק זה"
        },
        {
          "s": 8,
          "text": "(ש\"פ ח\"ש תרנ\"ד3),"
        },
        {
          "s": 9,
          "text": "מה שארז\"ל בגמרא4"
        },
        {
          "s": 10,
          "text": "ובמדרש5,"
        },
        {
          "s": 11,
          "text": "דעד אברהם לא הי' זקנה כו' אתא אברהם ובעי רחמי והוה זקנה שנאמר ואברהם זקן גו',"
        },
        {
          "s": 12,
          "text": "ומביא קושיית המהרש\"א6"
        },
        {
          "s": 13,
          "text": "והיפה תואר7,"
        },
        {
          "s": 14,
          "text": "שהרי כתיב לפנ\"ז8"
        },
        {
          "s": 15,
          "text": "ואברהם ושרה זקנים באים בימים ומה הי' החידוש עכשיו בבקשת אברהם."
        },
        {
          "s": 16,
          "text": "ומביא ע\"ז תירוצם"
        },
        {
          "s": 17,
          "text": "(שכללותו אחד הוא,"
        },
        {
          "s": 18,
          "text": "ורק בפרטי הענין יש חילוקים ביניהם)"
        },
        {
          "s": 19,
          "text": "דתוכן בקשת אברהם הי' שהזקנה תהי' ניכרת יותר."
        },
        {
          "s": 20,
          "text": "דלפני אברהם הנה אף שהי' ענין הזקנה מ\"מ לא הי' ניכר ההפרש בין צעיר לזקן,"
        },
        {
          "s": 21,
          "text": "וביקש אברהם שתהי' הזקנה ניכרת,"
        },
        {
          "s": 22,
          "text": "כלשון המדרש5"
        },
        {
          "s": 23,
          "text": "אמר לפניו רבון העולמים אדם ובנו נכנסין למקום ואין אדם יודע למי מכבד כו',"
        },
        {
          "s": 24,
          "text": "ובפרט אם קלסתר פניהם דומה,"
        },
        {
          "s": 25,
          "text": "כדאיתא בגמרא שם4"
        },
        {
          "s": 26,
          "text": "לגבי אברהם ויצחק עצמם,"
        },
        {
          "s": 27,
          "text": "שקלסתר פניו של יצחק הי' דומה לאברהם,"
        },
        {
          "s": 28,
          "text": "כמ\"ש9"
        },
        {
          "s": 29,
          "text": "(בפרשת השבוע הבא שקורין במנחת שבת זו)"
        },
        {
          "s": 30,
          "text": "ואלה תולדות יצחק בן אברהם אברהם הוליד את יצחק ופרש\"י שהקב\"ה צר קלסתר פניו של יצחק דומה לאברהם,"
        },
        {
          "s": 31,
          "text": "והעידו הכל שאברהם הוליד את יצחק."
        },
        {
          "s": 32,
          "text": "וע\"ז היתה הבקשה שיהי' ניכר תומ\"י שאברהם זקן מיצחק10."
        },
        {
          "s": 33,
          "text": "דזהו החידוש בבקשה זו עמ\"ש ואברהם ושרה זקנים באים בימים,"
        },
        {
          "s": 34,
          "text": "דהתם לא הי' ניכר ובולט בהם ענין הזקנה,"
        },
        {
          "s": 35,
          "text": "משא\"כ ע\"י בקשת אברהם נפעל שינוי בולט בפנים של זקנים,"
        },
        {
          "s": 36,
          "text": "היינו הן שינוי בעור הפנים ע\"י הקמטים וכו'"
        },
        {
          "s": 37,
          "text": "(קנייטשן)"
        },
        {
          "s": 38,
          "text": "שבעור הפנים11,"
        },
        {
          "s": 39,
          "text": "וענין זה הוא גם בשרה12"
        },
        {
          "s": 40,
          "text": "(בנשים),"
        },
        {
          "s": 41,
          "text": "עדמ\"ש13"
        },
        {
          "s": 42,
          "text": "אחרי בלותי היתה לי עדנה,"
        },
        {
          "s": 43,
          "text": "והן השינוי בשערות שבראש ובזקן אצל האנשים,"
        },
        {
          "s": 44,
          "text": "דאף ששערות הזקן ישנם כבר בצעיר לימים,"
        },
        {
          "s": 45,
          "text": "כההלכה14"
        },
        {
          "s": 46,
          "text": "שבן עשרים שנה מתמלא שער הזקן,"
        },
        {
          "s": 47,
          "text": "מ\"מ החידוש ע\"י הזקנה הוא בצבע השערות,"
        },
        {
          "s": 48,
          "text": "ששער הזקן נעשה לבן15."
        },
        {
          "s": 49,
          "text": "וכדאיתא במדרש16"
        },
        {
          "s": 50,
          "text": "שאמר הקב\"ה לאברהם בא לבוש לבושי ואברהם זקן בא בימים דכתיב17"
        },
        {
          "s": 51,
          "text": "עתיק18"
        },
        {
          "s": 52,
          "text": "יומין יתיב לבושי' כתלג חיור ושער רישי' כעמר נקא,"
        },
        {
          "s": 53,
          "text": "והיינו ענין ליבון השערות דאברהם."
        },
        {
          "s": 54,
          "text": "וכשם שהוא בענין ליבון השערות"
        },
        {
          "s": 55,
          "text": "(שזה נתחדש בענין ואברהם זקן גו')"
        },
        {
          "s": 56,
          "text": "צריך לומר שיש חידוש גם בענין בא בימים,"
        },
        {
          "s": 57,
          "text": "כדלקמן."
        },
        {
          "s": 58,
          "text": "ומבאר בהמאמר שם19"
        },
        {
          "s": 59,
          "text": "כללות ענין דליבון השערות,"
        },
        {
          "s": 60,
          "text": "שהוא המשכת בחי' י\"ג מדות הרחמים,"
        },
        {
          "s": 61,
          "text": "התגלות י\"ג תיקוני דיקנא שע\"ז נאמר לבושי' כתלג חיור ושער רישי' כעמר נקא,"
        },
        {
          "s": 62,
          "text": "היינו המשכה שלמעלה מסדר ההשתלשלות,"
        },
        {
          "s": 63,
          "text": "וזה הי' החידוש שנפעל ע\"י אברהם,"
        },
        {
          "s": 64,
          "text": "וכמבואר בארוכה שם."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "אמנם עדיין צריך להבין בענין בא בימים20,"
        },
        {
          "s": 1,
          "text": "מהו הענין והחידוש שבדבר זה."
        },
        {
          "s": 2,
          "text": "שכבר נאמר לפנ\"ז ואברהם ושרה גו' באים בימים."
        },
        {
          "s": 3,
          "text": "ובא בימים אין הכוונה בזה שכבר הגיע לסוף ימיו"
        },
        {
          "s": 4,
          "text": "[כמו בהפטרת השבוע דכתיב21"
        },
        {
          "s": 5,
          "text": "והמלך דוד זקן בא בימים,"
        },
        {
          "s": 6,
          "text": "דהכוונה בזה היא"
        },
        {
          "s": 7,
          "text": "(גם)"
        },
        {
          "s": 8,
          "text": "שהגיע לסוף ימיו22,"
        },
        {
          "s": 9,
          "text": "לגיל שבעים22],"
        },
        {
          "s": 10,
          "text": "שהרי הפסוק ואברהם ושרה גו' באים בימים נאמר יותר ממ' שנה לפני פסוק זה דפרשתנו"
        },
        {
          "s": 11,
          "text": "(שנאמר בעת השידוך דיצחק ורבקה כשהי' יצחק בן ארבעים23,"
        },
        {
          "s": 12,
          "text": "והפסוק ואברהם ושרה זקנים גו' נאמר לפני לידת יצחק),"
        },
        {
          "s": 13,
          "text": "היינו לפני שהי' אברהם בן מאה שנה,"
        },
        {
          "s": 14,
          "text": "ואברהם חי אח\"כ עד קע\"ה שנה24."
        },
        {
          "s": 15,
          "text": "ועד\"ז מ\"ש כאן ואברהם גו' בא בימים אין הכוונה בזה שהגיע לסוף ימיו,"
        },
        {
          "s": 16,
          "text": "כי הי' אז בן ק\"מ שנה,"
        },
        {
          "s": 17,
          "text": "וחי אח\"כ עוד ל\"ה שנה,"
        },
        {
          "s": 18,
          "text": "ועוד זאת,"
        },
        {
          "s": 19,
          "text": "דלולי עשו הי' חי עוד ה' שנה25,"
        },
        {
          "s": 20,
          "text": "היינו יותר מל\"ה שנה,"
        },
        {
          "s": 21,
          "text": "יותר מחצי שנותיו של אדם"
        },
        {
          "s": 22,
          "text": "(ימי שנותינו בהם שבעים שנה26)."
        },
        {
          "s": 23,
          "text": "גם צריך להבין הקשר דענין בא בימים למ\"ש ואברהם זקן,"
        },
        {
          "s": 24,
          "text": "ומזה שנאמר כאן עוד פעם בא בימים,"
        },
        {
          "s": 25,
          "text": "בהכרח לומר,"
        },
        {
          "s": 26,
          "text": "שזהו חידוש ושייך להחידוש דואברהם זקן,"
        },
        {
          "s": 27,
          "text": "ענין ליבון השערות הנ\"ל."
        }
      ]
    }
  ]
}