{
  "globalIndex": 1037,
  "owner": 37,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919915_theRebbe_134__p001",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919915_theRebbe_134__p001",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919915_theRebbe_134",
  "title": "מאמר ועתה ישראל תשכ\"ז",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ עקב,"
        },
        {
          "s": 2,
          "text": "כ\"ף מנחם-אב"
        },
        {
          "s": 3,
          "text": "(מאמר ב),"
        },
        {
          "s": 4,
          "text": "ה'תשכ\"ז"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "ועתה ישראל מה הוי' אלקיך שואל מעמך כי אם ליראה גו'1,"
        },
        {
          "s": 1,
          "text": "ואיתא בגמרא2"
        },
        {
          "s": 2,
          "text": "אטו יראה מילתא זוטרתי היא"
        },
        {
          "s": 3,
          "text": "(ומתרץ)"
        },
        {
          "s": 4,
          "text": "אין לגבי משה מילתא זוטרתי היא."
        },
        {
          "s": 5,
          "text": "וידוע הדיוק בזה3,"
        },
        {
          "s": 6,
          "text": "הרי שואל מעמך כתיב"
        },
        {
          "s": 7,
          "text": "(מכאו\"א מישראל),"
        },
        {
          "s": 8,
          "text": "ומהו התירוץ לגבי משה מילתא זוטרתי היא."
        },
        {
          "s": 9,
          "text": "גם צריך להבין מה דאיתא בגמרא4"
        },
        {
          "s": 10,
          "text": "חייב אדם לברך מאה ברכות בכל יום שנאמר ועתה ישראל מה ה' אלקיך שואל מעמך,"
        },
        {
          "s": 11,
          "text": "אל תקרי מה אלא מאה5."
        },
        {
          "s": 12,
          "text": "וכתב המהרש\"א6"
        },
        {
          "s": 13,
          "text": "דהטעם על זה שדרשו אל תקרי מה כו' הוא7"
        },
        {
          "s": 14,
          "text": "כי לפי פירוש הפשוט קשה אטו יראה מילתא זוטרתי היא ולכן דרשו אל תקרי מה אלא מאה,"
        },
        {
          "s": 15,
          "text": "שדבר זה"
        },
        {
          "s": 16,
          "text": "(לברך מאה ברכות בכל יום)"
        },
        {
          "s": 17,
          "text": "בנקל לאדם לקיים,"
        },
        {
          "s": 18,
          "text": "ועי\"ז יבוא ליראה את ה'8."
        },
        {
          "s": 19,
          "text": "וצריך ביאור,"
        },
        {
          "s": 20,
          "text": "מהי המעלה דמאה ברכות שעל ידם באים ליראה את הוי'."
        },
        {
          "s": 21,
          "text": "וגם צריך להבין,"
        },
        {
          "s": 22,
          "text": "ע\"פ הידוע שכל הפירושים שבאותו הפסוק שייכים זל\"ז9,"
        },
        {
          "s": 23,
          "text": "מהי השייכות דמה ומאה."
        },
        {
          "s": 24,
          "text": "וגם מהי השייכות דשני פירושים הנ\"ל"
        },
        {
          "s": 25,
          "text": "(שמתרצים הקושיא אטו יראה מילתא זוטרתי היא),"
        },
        {
          "s": 26,
          "text": "דלגבי משה מילתא זוטרתי היא ואל תקרי מה אלא מאה."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה החילוק בין הפירוש כפשוטו"
        },
        {
          "s": 2,
          "text": "(מה)"
        },
        {
          "s": 3,
          "text": "להפירוש הנדרש ע\"פ הלימוד דאל תקרי"
        },
        {
          "s": 4,
          "text": "(מאה),"
        },
        {
          "s": 5,
          "text": "דלהפירוש כפשוטו,"
        },
        {
          "s": 6,
          "text": "מה קאי על ליראה גו',"
        },
        {
          "s": 7,
          "text": "דכל מה שה\"א שואל מעמך הוא ליראה את הוי',"
        },
        {
          "s": 8,
          "text": "ולהפירוש הנדרש,"
        },
        {
          "s": 9,
          "text": "מה"
        },
        {
          "s": 10,
          "text": "(מאה)"
        },
        {
          "s": 11,
          "text": "הו\"ע לעצמו10,"
        },
        {
          "s": 12,
          "text": "דזה שה\"א שואל מעמך הוא מה,"
        },
        {
          "s": 13,
          "text": "מאה ברכות,"
        },
        {
          "s": 14,
          "text": "אלא שעי\"ז תבוא ליראה את הוי'."
        },
        {
          "s": 15,
          "text": "ועוד חילוק בין שני הפירושים,"
        },
        {
          "s": 16,
          "text": "דלשון מה מורה שהענין"
        },
        {
          "s": 17,
          "text": "(המדובר)"
        },
        {
          "s": 18,
          "text": "הוא דבר קטן,"
        },
        {
          "s": 19,
          "text": "ובלשון הגמרא מילתא זוטרתי,"
        },
        {
          "s": 20,
          "text": "ומאה הוא מספר גדול ועד לשלימות המספר,"
        },
        {
          "s": 21,
          "text": "דבאותיות,"
        },
        {
          "s": 22,
          "text": "מספר הכי גדול הוא מאות11."
        },
        {
          "s": 23,
          "text": "ובפרט לפי המבואר בחסידות12,"
        },
        {
          "s": 24,
          "text": "דזה שניתוסף במאה על מה הוא אות אל\"ף אותיות פלא,"
        },
        {
          "s": 25,
          "text": "אור הסובב שלמעלה מהשתלשלות."
        },
        {
          "s": 26,
          "text": "וצריך להבין,"
        },
        {
          "s": 27,
          "text": "דלכאורה,"
        },
        {
          "s": 28,
          "text": "שני חילוקים אלה שבין שני הפירושים,"
        },
        {
          "s": 29,
          "text": "הם הפכים."
        },
        {
          "s": 30,
          "text": "דמזה שהמאה ברכות הם הקדמה ליראה,"
        },
        {
          "s": 31,
          "text": "מובן,"
        },
        {
          "s": 32,
          "text": "שהיראה היא למעלה מהם13,"
        },
        {
          "s": 33,
          "text": "ואעפ\"כ,"
        },
        {
          "s": 34,
          "text": "החיוב דמאה ברכות נלמד מהדרש אל תקרי מה אלא מאה,"
        },
        {
          "s": 35,
          "text": "ובנוגע להיראה כתיב מה גו' שואל מעמך,"
        },
        {
          "s": 36,
          "text": "דלשון מה מורה"
        },
        {
          "s": 37,
          "text": "(כנ\"ל)"
        },
        {
          "s": 38,
          "text": "על דבר קטן."
        }
      ]
    }
  ]
}