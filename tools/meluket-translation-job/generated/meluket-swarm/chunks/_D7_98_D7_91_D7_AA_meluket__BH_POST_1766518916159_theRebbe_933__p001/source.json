{
  "globalIndex": 419,
  "owner": 19,
  "jobId": "_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916159_theRebbe_933__p001",
  "batchId": "meluket-_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916159_theRebbe_933__p001",
  "seriesId": "טבת_meluket",
  "postId": "BH_POST_1766518916159_theRebbe_933",
  "title": "מאמר ודוד עבדי תשל\"ב",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ ויגש,"
        },
        {
          "s": 2,
          "text": "ז' טבת,"
        },
        {
          "s": 3,
          "text": "ה'תשל\"ב"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "ודוד עבדי נשיא להם לעולם1,"
        },
        {
          "s": 1,
          "text": "הנה פסוק זה הוא בההפטורה דפרשת ויגש."
        },
        {
          "s": 2,
          "text": "וצריך להבין,"
        },
        {
          "s": 3,
          "text": "דלכאורה השייכות דההפטורה להפרשה2"
        },
        {
          "s": 4,
          "text": "היא בזה שהתוכן דשניהם הוא חיבור יהודה ויוסף."
        },
        {
          "s": 5,
          "text": "דהתחלת הפרשה היא ויגש אליו יהודה ובההפטורה נאמר3"
        },
        {
          "s": 6,
          "text": "קח לך עץ אחד וכתוב עליו ליהודה גו' ולקח עץ אחד וכתוב עליו ליוסף גו' וקרב אותם אחד אל אחד לך לעץ אחד גו' ועשיתי אותם לגוי אחד גו' ומלך אחד יהי' לכולם גו'."
        },
        {
          "s": 7,
          "text": "אבל בפרטיות,"
        },
        {
          "s": 8,
          "text": "בהגשת יהודה ליוסף"
        },
        {
          "s": 9,
          "text": "(בפרשה)"
        },
        {
          "s": 10,
          "text": "מודגש שיוסף הי' נעלה יותר מיהודה"
        },
        {
          "s": 11,
          "text": "[הן בההגשה עצמה,"
        },
        {
          "s": 12,
          "text": "שהרי זה שיהודה נגש ליוסף הוא מפני שהי' זקוק אליו"
        },
        {
          "s": 13,
          "text": "(שישחרר את בנימין),"
        },
        {
          "s": 14,
          "text": "והן בדברי יהודה ליוסף שאמר4"
        },
        {
          "s": 15,
          "text": "בי אדוני ידבר נא עבדך גו'],"
        },
        {
          "s": 16,
          "text": "ועד שיוסף הי' מלך על כל אחיו,"
        },
        {
          "s": 17,
          "text": "כולל יהודה,"
        },
        {
          "s": 18,
          "text": "ובההפטורה נאמר5"
        },
        {
          "s": 19,
          "text": "ועבדי דוד מלך עליהם גו' ודוד עבדי נשיא להם לעולם."
        },
        {
          "s": 20,
          "text": "ומזה שפסוקים אלה הם בההפטורה דפרשת ויגש,"
        },
        {
          "s": 21,
          "text": "משמע,"
        },
        {
          "s": 22,
          "text": "שענין זה"
        },
        {
          "s": 23,
          "text": "(המעלה דיהודה לגבי יוסף)"
        },
        {
          "s": 24,
          "text": "ישנו"
        },
        {
          "s": 25,
          "text": "(ברמז)"
        },
        {
          "s": 26,
          "text": "גם בויגש אליו יהודה,"
        },
        {
          "s": 27,
          "text": "אלא שבויגש אליו יהודה,"
        },
        {
          "s": 28,
          "text": "המעלה דיהודה לגבי יוסף היא ברמז ובהעלם"
        },
        {
          "s": 29,
          "text": "(וזה שמודגש בגילוי בויגש אליו יהודה היא המעלה דיוסף לגבי יהודה),"
        },
        {
          "s": 30,
          "text": "ובההפטורה הוא בגילוי."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה ענין זה"
        },
        {
          "s": 2,
          "text": "[שבויגש אליו יהודה יש"
        },
        {
          "s": 3,
          "text": "(בהעלם)"
        },
        {
          "s": 4,
          "text": "גם המעלה דיהודה לגבי יוסף]"
        },
        {
          "s": 5,
          "text": "מובן גם מהמבואר בתו\"א ד\"ה ויגש אליו יהודה6,"
        },
        {
          "s": 6,
          "text": "דזה שביהמ\"ק הי' מדומם"
        },
        {
          "s": 7,
          "text": "[ודלא כהמשכן,"
        },
        {
          "s": 8,
          "text": "שרק קרקע המשכן הי' מעפר7,"
        },
        {
          "s": 9,
          "text": "דומם,"
        },
        {
          "s": 10,
          "text": "אבל כותלי המשכן היו מצומח,"
        },
        {
          "s": 11,
          "text": "והמכסה שעל המשכן"
        },
        {
          "s": 12,
          "text": "(היריעות)"
        },
        {
          "s": 13,
          "text": "הי' מחי],"
        },
        {
          "s": 14,
          "text": "הוא,"
        },
        {
          "s": 15,
          "text": "כי זה שדומם הוא למטה מצומח הוא ע\"פ סדר ההשתלשלות,"
        },
        {
          "s": 16,
          "text": "אבל בשרשם,"
        },
        {
          "s": 17,
          "text": "שורש הדומם הוא למעלה משורש הצומח וחי"
        },
        {
          "s": 18,
          "text": "[וע\"ד שמים וארץ,"
        },
        {
          "s": 19,
          "text": "דבההתהות בפועל,"
        },
        {
          "s": 20,
          "text": "שמים קדמו לארץ,"
        },
        {
          "s": 21,
          "text": "ובשרשם במחשבה,"
        },
        {
          "s": 22,
          "text": "ארץ קדמה."
        },
        {
          "s": 23,
          "text": "דזה גופא שהארץ נבראת לבסוף מורה שבמחשבה היא קדמה לשמים,"
        },
        {
          "s": 24,
          "text": "דסוף מעשה במחשבה תחילה8]."
        },
        {
          "s": 25,
          "text": "וכמו\"כ הוא בז\"א ומלכות"
        },
        {
          "s": 26,
          "text": "[שהם בדוגמת צומח ודומם],"
        },
        {
          "s": 27,
          "text": "שבסדר ההשתלשלות,"
        },
        {
          "s": 28,
          "text": "ז\"א הוא למעלה ממלכות,"
        },
        {
          "s": 29,
          "text": "אבל בשרשם,"
        },
        {
          "s": 30,
          "text": "שורש המלכות הוא למעלה משורש הז\"א."
        },
        {
          "s": 31,
          "text": "ולכן לע\"ל תהי' המלכות למעלה מז\"א,"
        },
        {
          "s": 32,
          "text": "אשת חיל עטרת בעלה9,"
        },
        {
          "s": 33,
          "text": "כי אז יהי' בגילוי שורש המלכות"
        },
        {
          "s": 34,
          "text": "(שלמעלה משורש הז\"א)."
        },
        {
          "s": 35,
          "text": "וזהו שבמשכן היו הכתלים והגג מצומח וחי ובביהמ\"ק הי' כל זה מדומם,"
        },
        {
          "s": 36,
          "text": "כי המשכן שהי' רק דירת עראי של הקב\"ה10,"
        },
        {
          "s": 37,
          "text": "הי' כפי סדר ההשתלשלות,"
        },
        {
          "s": 38,
          "text": "ולכן קרקע המשכן הי' מדומם,"
        },
        {
          "s": 39,
          "text": "כותלי המשכן מצומח,"
        },
        {
          "s": 40,
          "text": "וגג המשכן מחי,"
        },
        {
          "s": 41,
          "text": "כי בסדר ההשתלשלות,"
        },
        {
          "s": 42,
          "text": "צומח הוא למעלה מדומם וחי הוא למעלה גם מצומח."
        },
        {
          "s": 43,
          "text": "אבל בית המקדש שהי' דירת קבע של הקב\"ה10,"
        },
        {
          "s": 44,
          "text": "הי' מעין עולם הבא,"
        },
        {
          "s": 45,
          "text": "שאז תהי' המלכות"
        },
        {
          "s": 46,
          "text": "(דומם)"
        },
        {
          "s": 47,
          "text": "למעלה מכל הספירות."
        },
        {
          "s": 48,
          "text": "ולכן הי' אפילו הגג מדומם."
        }
      ]
    }
  ]
}