{
  "globalIndex": 179,
  "owner": 29,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914830_theRebbe_782__p002",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914830_theRebbe_782__p002",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518914830_theRebbe_782",
  "title": "מאמר וה' אמר המכסה אני מאברהם תשל\"ז",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויובן כ\"ז ע\"פ המבואר בד\"ה זכור תרע\"ח16"
        },
        {
          "s": 2,
          "text": "לבעל יום ההולדת"
        },
        {
          "s": 3,
          "text": "(עה\"פ ושמרו דרך הוי'),"
        },
        {
          "s": 4,
          "text": "ובארוכה בביאורי הזהר לאדמו\"ר האמצעי17"
        },
        {
          "s": 5,
          "text": "(עה\"פ18"
        },
        {
          "s": 6,
          "text": "כי ישרים דרכי הוי')"
        },
        {
          "s": 7,
          "text": "ובכ\"מ19,"
        },
        {
          "s": 8,
          "text": "דענין דרך למעלה הוא בדוגמת דרך כפשוטו"
        },
        {
          "s": 9,
          "text": "(בגשמיות),"
        },
        {
          "s": 10,
          "text": "שהוא ממוצע שמחבר שני מקומות שמצד עצמם הם רחוקים זמ\"ז בתכלית."
        },
        {
          "s": 11,
          "text": "וכמו דרך המלך הנמשך והולך מעיר המלוכה מקום מושב המלך לכל מרחבי המדינה"
        },
        {
          "s": 12,
          "text": "(שעל ידו מגיעים לכל העיירות הגדולות),"
        },
        {
          "s": 13,
          "text": "וממנו מסתעפים עוד דרכים ונתיבות שעל ידם יכולים להגיע לעיירות הקטנות וכו' עד לפינה הכי נדחת,"
        },
        {
          "s": 14,
          "text": "דהריחוק שבין עיירות הקטנות ומכש\"כ פינה הנדחת לעיר הבירה מקום מושב המלך הוא נוסף על הריחוק במקום גם ריחוק במעלה,"
        },
        {
          "s": 15,
          "text": "ועד לריחוק שבאין ערוך,"
        },
        {
          "s": 16,
          "text": "וע\"י אמצעות הדרך נעשה קישור וחיבור דפינה הנדחת עם מקום מושב המלך."
        },
        {
          "s": 17,
          "text": "וזהו מה שהקו הנמשך מאוא\"ס נקרא בשם דרך,"
        },
        {
          "s": 18,
          "text": "כי הקו הוא הממוצע שעל ידו נמשך מאוא\"ס לעולמות,"
        },
        {
          "s": 19,
          "text": "דנוסף על זה שהתהוות העולמות"
        },
        {
          "s": 20,
          "text": "(המשכת אוא\"ס להוות את העולמות)"
        },
        {
          "s": 21,
          "text": "הוא ע\"י אמצעות הקו"
        },
        {
          "s": 22,
          "text": "[דענין זה הוא ע\"י חיצוניות הקו,"
        },
        {
          "s": 23,
          "text": "דשרשו הוא ממל' דא\"ס],"
        },
        {
          "s": 24,
          "text": "הרי ע\"י הקו נעשה גם המשכת הגילויים דאוא\"ס בעולמות"
        },
        {
          "s": 25,
          "text": "[דענין זה הוא ע\"י פנימיות הקו,"
        },
        {
          "s": 26,
          "text": "דשרשו הוא מת\"ת הנעלם]."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז מבאר בעל יום ההולדת בד\"ה זכור הנ\"ל20"
        },
        {
          "s": 2,
          "text": "זה שהתומ\"צ נק' דרך הוי',"
        },
        {
          "s": 3,
          "text": "כי ענין תומ\"צ הוא לאתקנא רזא דשמי'21,"
        },
        {
          "s": 4,
          "text": "המשכת בחי' שמו הגדול"
        },
        {
          "s": 5,
          "text": "(שם הוי'),"
        },
        {
          "s": 6,
          "text": "שהוא הגילוי דעצמות אוא\"ס"
        },
        {
          "s": 7,
          "text": "(בחי' ת\"ת הנעלם שלמעלה מבחי' מל' דא\"ס)."
        },
        {
          "s": 8,
          "text": "ולכן נק' דרך הוי',"
        },
        {
          "s": 9,
          "text": "הדרכים שעל ידם נמשך בעולם הגילוי דשם הוי',"
        },
        {
          "s": 10,
          "text": "שמו הגדול."
        },
        {
          "s": 11,
          "text": "ועי\"ז נשלמה הכוונה דדירה בתחתונים22,"
        },
        {
          "s": 12,
          "text": "הגילוי דעצמות אוא\"ס"
        },
        {
          "s": 13,
          "text": "(שלמעלה מבחי' סובב וממלא)"
        },
        {
          "s": 14,
          "text": "למטה בתחתונים,"
        },
        {
          "s": 15,
          "text": "בתחתון שאין23"
        },
        {
          "s": 16,
          "text": "תחתון למטה ממנו."
        },
        {
          "s": 17,
          "text": "ומבאר שם24,"
        },
        {
          "s": 18,
          "text": "דענין דירה בתחתונים הוא כמשל אדם הדר בבית חבירו,"
        },
        {
          "s": 19,
          "text": "שכל עצמותו כמו שהוא דר בביתו הוא דר בבית חבירו."
        },
        {
          "s": 20,
          "text": "ויש לומר,"
        },
        {
          "s": 21,
          "text": "שהכוונה בהמשל דאדם הדר בבית חבירו,"
        },
        {
          "s": 22,
          "text": "הוא לבאר,"
        },
        {
          "s": 23,
          "text": "דענין דירה בתחתונים הוא לא באופן שמצד הגילוי דאוא\"ס בהתחתון נעשה בו זיכוך ועלי'"
        },
        {
          "s": 24,
          "text": "(באופן שמתבטל ה\"תחתון\" שבו),"
        },
        {
          "s": 25,
          "text": "כי אם,"
        },
        {
          "s": 26,
          "text": "שגם לאחרי הגילוי הוא נשאר תחתון25,"
        },
        {
          "s": 27,
          "text": "ואעפ\"כ נמשך בו הגילוי דעצמות אוא\"ס."
        },
        {
          "s": 28,
          "text": "דזהו תוכן המשל דאדם הדר בבית חבירו,"
        },
        {
          "s": 29,
          "text": "שגם לאחרי שהוא דר שם הבית הוא בית חבירו,"
        },
        {
          "s": 30,
          "text": "ואעפ\"כ הוא דר שם בכל עצמותו כמו שהוא דר בביתו."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה לאחרי זה ממשיך בהמאמר"
        },
        {
          "s": 2,
          "text": "(ד\"ה זכור הנ\"ל26),"
        },
        {
          "s": 3,
          "text": "דכמו שדרך כפשוטו משמש לא רק להליכה אלא גם לחזרה27,"
        },
        {
          "s": 4,
          "text": "עד\"ז הוא גם בדרך הוי',"
        },
        {
          "s": 5,
          "text": "דאמיתית ענינו הוא שהוא באופן כזה שעל ידו נעשה לא רק ההמשכה מלמעלה למטה"
        },
        {
          "s": 6,
          "text": "(ענין הליכה),"
        },
        {
          "s": 7,
          "text": "אלא גם העלאת התחתון,"
        },
        {
          "s": 8,
          "text": "שיהי' כלי לההמשכה28."
        },
        {
          "s": 9,
          "text": "ושני ענינים אלו"
        },
        {
          "s": 10,
          "text": "(ההמשכה מלמעלה והעלאת המטה)"
        },
        {
          "s": 11,
          "text": "נעשים על ידי לימוד התורה וקיום המצוות29."
        },
        {
          "s": 12,
          "text": "ע\"י לימוד התורה נעשה ההמשכה דעצמות אוא\"ס"
        },
        {
          "s": 13,
          "text": "(דהחכמה דתורה היא מבחי' החכמה דעצמות א\"ס)"
        },
        {
          "s": 14,
          "text": "בשכל האדם"
        },
        {
          "s": 15,
          "text": "(שכל אנושי שמלובש במוח גשמי),"
        },
        {
          "s": 16,
          "text": "ובפרט כשלומד היטב בעיון שכלו שאז היא מתאחדת עמו ביחוד נפלא שאין יחוד כמוהו30,"
        },
        {
          "s": 17,
          "text": "ועד שנקראת על שמו31."
        },
        {
          "s": 18,
          "text": "ובירור והעלאת התחתון נעשה ע\"י מעשה המצוות,"
        },
        {
          "s": 19,
          "text": "ובפרט כשמעשה המצוות הוא באופן דאתכפיא,"
        },
        {
          "s": 20,
          "text": "מעשה מלשון כפי'32."
        },
        {
          "s": 21,
          "text": "וזהו ושמרו דרך הוי' לעשות צדקה גו',"
        },
        {
          "s": 22,
          "text": "דאמיתית ענין הדרך שמשמש לא רק להליכה"
        },
        {
          "s": 23,
          "text": "(המשכה מלמעלה)"
        },
        {
          "s": 24,
          "text": "אלא גם לחזרה"
        },
        {
          "s": 25,
          "text": "(בירור והעלאת התחתון)"
        },
        {
          "s": 26,
          "text": "הוא שנוסף ללימוד התורה יש גם עשיית צדקה,"
        },
        {
          "s": 27,
          "text": "דכל המצוות נק' בשם צדקה33."
        },
        {
          "s": 28,
          "text": "ומוסיף צדקה ומשפט34,"
        },
        {
          "s": 29,
          "text": "דעשיית הצדקה"
        },
        {
          "s": 30,
          "text": "(צדקה כפשוטה)"
        },
        {
          "s": 31,
          "text": "צ\"ל במשפט,"
        },
        {
          "s": 32,
          "text": "שישפוט את עצמו מהמותרות ויחשוב היטב מה שהוא מוכרח לנפשו וכל השאר יתן לצדקה."
        },
        {
          "s": 33,
          "text": "ועד\"ז הוא בכל המצוות"
        },
        {
          "s": 34,
          "text": "(שנק' בשם צדקה,"
        },
        {
          "s": 35,
          "text": "כנ\"ל)"
        },
        {
          "s": 36,
          "text": "שקיומם צ\"ל באופן דמשפט."
        },
        {
          "s": 37,
          "text": "ומוסיף לעשות"
        },
        {
          "s": 38,
          "text": "(צדקה ומשפט),"
        },
        {
          "s": 39,
          "text": "שגם זה"
        },
        {
          "s": 40,
          "text": "(שהצדקה היא באופן דמשפט)"
        },
        {
          "s": 41,
          "text": "אינו מספיק עדיין,"
        },
        {
          "s": 42,
          "text": "וצריך להיות באופן דאתכפיא,"
        },
        {
          "s": 43,
          "text": "מעשה מלשון כפי'."
        },
        {
          "s": 44,
          "text": "ועי\"ז נעשה בירור והעלאת התחתון,"
        },
        {
          "s": 45,
          "text": "שנעשה כלי להגילוי שלמעלה."
        }
      ]
    }
  ]
}