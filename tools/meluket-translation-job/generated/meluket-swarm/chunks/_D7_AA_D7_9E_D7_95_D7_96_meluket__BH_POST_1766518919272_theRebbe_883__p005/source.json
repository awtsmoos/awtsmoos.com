{
  "globalIndex": 929,
  "owner": 29,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919272_theRebbe_883__p005",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919272_theRebbe_883__p005",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919272_theRebbe_883",
  "title": "מאמר נתת ליראיך תשל\"ו",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ב)"
        },
        {
          "s": 2,
          "text": "וזהו מש\"נ131"
        },
        {
          "s": 3,
          "text": "מפי עוללים ויונקים יסדת עוז גו' להשבית אויב ומתנקם."
        },
        {
          "s": 4,
          "text": "ומבאר כ\"ק מו\"ח אדמו\"ר בעל הגאולה והשמחה במאמרו ד\"ה וקבל היהודים את אשר החלו לעשות דשנת תרפ\"ז132"
        },
        {
          "s": 5,
          "text": "(שמאמר זה אמרו עוד לפני מאסרו,"
        },
        {
          "s": 6,
          "text": "במעמד ומצב של גזירות איומות בנוגע ללימוד התורה,"
        },
        {
          "s": 7,
          "text": "ובפרט של עוללים ויונקים133),"
        },
        {
          "s": 8,
          "text": "דע\"י עוז,"
        },
        {
          "s": 9,
          "text": "אין עוז אלא תורה134,"
        },
        {
          "s": 10,
          "text": "פועלים להשבית אויב ומתנקם."
        },
        {
          "s": 11,
          "text": "דהאויב הוא שונא הגלוי והנוקם הוא שונא נסתר ועולל עלילות כו'"
        },
        {
          "s": 12,
          "text": "(שזוהי סכנה גדולה יותר מהאויב),"
        },
        {
          "s": 13,
          "text": "וע\"י עוז דתורה נעשה להשבית אויב ומתנקם."
        },
        {
          "s": 14,
          "text": "וענין עוז דתורה הו\"ע התוקף,"
        },
        {
          "s": 15,
          "text": "שאין מתחשבים עם המניעות וההעלמות וההסתרים כו',"
        },
        {
          "s": 16,
          "text": "שע\"י תוקף זה מבטלים כל הגזירות,"
        },
        {
          "s": 17,
          "text": "ומתגלה האמת שרובם אין להם מציאות והם רק ענין של הפחדה בעלמא."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "וההתחלה והיסוד של עוז דתורה הוא מפי עוללים ויונקים דוקא."
        },
        {
          "s": 1,
          "text": "דהנה כתיב135"
        },
        {
          "s": 2,
          "text": "תורה צוה לנו משה מורשה קהלת יעקב,"
        },
        {
          "s": 3,
          "text": "שהתורה היא ירושה לכאו\"א מישראל,"
        },
        {
          "s": 4,
          "text": "וגם תינוק בן יומו יורש136,"
        },
        {
          "s": 5,
          "text": "ויורש הכל כמש\"נ137"
        },
        {
          "s": 6,
          "text": "תחת אבותיך יהיו בניך גו',"
        },
        {
          "s": 7,
          "text": "שלכן גם עוללים ויונקים יש להם כל התורה בירושה."
        },
        {
          "s": 8,
          "text": "ואדרבה התורה אצלם היא היסוד כו'"
        },
        {
          "s": 9,
          "text": "(יסדת עוז),"
        },
        {
          "s": 10,
          "text": "וכמרז\"ל138"
        },
        {
          "s": 11,
          "text": "אם אין גדיים אין תיישים."
        },
        {
          "s": 12,
          "text": "וכמו יסוד גשמי הנמצא בקרקע,"
        },
        {
          "s": 13,
          "text": "שאין נוגע היופי שלו כו',"
        },
        {
          "s": 14,
          "text": "כ\"א החוזק ותוקף שלו,"
        },
        {
          "s": 15,
          "text": "כי צ\"ל חזק באופן כזה שיוכל להחזיק את כל הבנין,"
        },
        {
          "s": 16,
          "text": "גם הגג שעל הבנין,"
        },
        {
          "s": 17,
          "text": "כדי שהבנין יהי' איתן ועומד על עמדו,"
        },
        {
          "s": 18,
          "text": "שכל הרוחות המנשבות בעולם לא יוכלו להזיזו ממקומו."
        },
        {
          "s": 19,
          "text": "וזהו מפי עוללים ויונקים יסדת עוז גו' להשבית אויב ומתנקם,"
        },
        {
          "s": 20,
          "text": "שע\"י עוללים ויונקים דוקא,"
        },
        {
          "s": 21,
          "text": "הבל התשב\"ר139,"
        },
        {
          "s": 22,
          "text": "שהוא היסוד של עוז דתורה,"
        },
        {
          "s": 23,
          "text": "נעשה להשבית אויב ומתנקם."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ג)"
        },
        {
          "s": 2,
          "text": "ויש לקשר ענין הנ\"ל"
        },
        {
          "s": 3,
          "text": "(שעבודת הנסיונות היא ע\"י מס\"נ דוקא,"
        },
        {
          "s": 4,
          "text": "בחי' נס בתוך נס שבנפש)"
        },
        {
          "s": 5,
          "text": "עם מש\"נ בפרשת השבוע140"
        },
        {
          "s": 6,
          "text": "אך בגורל יחלק את הארץ."
        },
        {
          "s": 7,
          "text": "דחלוקת הארץ,"
        },
        {
          "s": 8,
          "text": "שזה קאי על חלוקת הארץ שלמטה,"
        },
        {
          "s": 9,
          "text": "ועל חלוקת הארץ שלמעלה,"
        },
        {
          "s": 10,
          "text": "או בלשון מאמרי רז\"ל"
        },
        {
          "s": 11,
          "text": "(שהובאו במאמרי רבותינו נשיאינו141)"
        },
        {
          "s": 12,
          "text": "עוה\"ב"
        },
        {
          "s": 13,
          "text": "(דכל ישראל יש להם חלק לעוה\"ב142"
        },
        {
          "s": 14,
          "text": "שנאמר143"
        },
        {
          "s": 15,
          "text": "ועמך כולם גו' לעולם ירשו ארץ),"
        },
        {
          "s": 16,
          "text": "היא ע\"י הגורל."
        },
        {
          "s": 17,
          "text": "כי בחי' הגורל שבנפש הו\"ע העבודה שלמעלה מטו\"ד144,"
        },
        {
          "s": 18,
          "text": "ועוד יותר,"
        },
        {
          "s": 19,
          "text": "למעלה גם מכח הרצון."
        },
        {
          "s": 20,
          "text": "וכמו גורל כפשוטו,"
        },
        {
          "s": 21,
          "text": "שאינו תלוי כלל ברצונו של מטיל הגורל145."
        },
        {
          "s": 22,
          "text": "ולכן ע\"י בחי' הגורל דוקא היא חלוקת הארץ בכל הדרגות שבה כנ\"ל,"
        },
        {
          "s": 23,
          "text": "הן עוה\"ב והן א\"י כפשוטה"
        },
        {
          "s": 24,
          "text": "(ואין מקרא יוצא מידי פשוטו146)."
        },
        {
          "s": 25,
          "text": "דהנה כתיב147"
        },
        {
          "s": 26,
          "text": "ארץ אשר גו' עיני ה' אלקיך בה מרשית השנה ועד אחרית שנה,"
        },
        {
          "s": 27,
          "text": "שיש בזה ב' הקצוות."
        },
        {
          "s": 28,
          "text": "מצד אחד הוא למעלה ממדידות והגבלות הזמן,"
        },
        {
          "s": 29,
          "text": "שה\"ה מרשית השנה ועד אחרית שנה."
        },
        {
          "s": 30,
          "text": "ולאידך,"
        },
        {
          "s": 31,
          "text": "נמשך הוא ב"
        },
        {
          "s": 32,
          "text": "(מדוה\"ג ד)"
        },
        {
          "s": 33,
          "text": "זמן,"
        },
        {
          "s": 34,
          "text": "שלכן הוא רק עד אחרית שנה,"
        },
        {
          "s": 35,
          "text": "ובשנה שלאח\"ז מתחדש אור זה באור חדש עליון יותר שלא הי' מאיר עדיין מימי עולם אור עליון כזה."
        },
        {
          "s": 36,
          "text": "ואור זה מתלבש בארץ שלמטה להחיות כו' כל משך שנה זו,"
        },
        {
          "s": 37,
          "text": "וכמבואר בארוכה באגה\"ק148."
        },
        {
          "s": 38,
          "text": "ולכן חלוקת הארץ,"
        },
        {
          "s": 39,
          "text": "שבה מאיר אור שלמעלה ממדוה\"ג,"
        },
        {
          "s": 40,
          "text": "היא ע\"י בחי' הגורל דוקא."
        }
      ]
    }
  ]
}