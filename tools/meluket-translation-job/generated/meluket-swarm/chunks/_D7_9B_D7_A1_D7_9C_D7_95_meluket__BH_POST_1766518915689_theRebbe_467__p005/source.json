{
  "globalIndex": 343,
  "owner": 43,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915689_theRebbe_467__p005",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915689_theRebbe_467__p005",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915689_theRebbe_467",
  "title": "הוספה משיחות ש\"פ וישב-מקץ תשכ\"ו",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "והנה בנוגע לענינינו"
        },
        {
          "s": 1,
          "text": "(גאולת רבינו הזקן16),"
        },
        {
          "s": 2,
          "text": "הרי מובן,"
        },
        {
          "s": 3,
          "text": "אשר ג' דברים אלו – נוגע לאדם העובד,"
        },
        {
          "s": 4,
          "text": "היינו רבינו הזקן,"
        },
        {
          "s": 5,
          "text": "אשר הוא נפדה בשלום."
        },
        {
          "s": 6,
          "text": "וכמו שכותב \"כשקריתי בפסוק פדה בשלום כו' יצאתי בשלום\","
        },
        {
          "s": 7,
          "text": "אשר הוא עצמו עסק בג' ענינים אלו בהיותו במאסר"
        },
        {
          "s": 8,
          "text": "(ולכן פעלה קריאתו)"
        },
        {
          "s": 9,
          "text": "ועי\"ז הוא נפדה בשלום."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "וצריך להבין,"
        },
        {
          "s": 1,
          "text": "איך הי' שייך בהיותו במאסר העבודה דתפלה בצבור."
        },
        {
          "s": 2,
          "text": "דלימוד התורה ובאופן דעוסק שייך גם בהיותו במאסר,"
        },
        {
          "s": 3,
          "text": "וגם עסק בגמ\"ח בהיותו במאסר ע\"ד שאמר הלל,"
        },
        {
          "s": 4,
          "text": "כשהי' הולך לאכול,"
        },
        {
          "s": 5,
          "text": "שהוא הולך לגמול חסד עם העלובה ועני' הוא גופו17,"
        },
        {
          "s": 6,
          "text": "אבל איך הי' יכול להתפלל בצבור? והענין הוא,"
        },
        {
          "s": 7,
          "text": "כמו שמבאר כ\"ק אדמו\"ר הצ\"צ18"
        },
        {
          "s": 8,
          "text": "(שהשנה19"
        },
        {
          "s": 9,
          "text": "היא שנת המאה להסתלקות הילולא שלו)"
        },
        {
          "s": 10,
          "text": "– דתפלת יחיד שהרבים צריכים לו הוא כמו תפלה בצבור."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "והנה ידוע פירוש רבינו הזקן20"
        },
        {
          "s": 1,
          "text": "בעל הגאולה והשמחה על מארז\"ל21"
        },
        {
          "s": 2,
          "text": "כאן ליחיד כאן לצבור,"
        },
        {
          "s": 3,
          "text": "דכאן ליחיד הוא בחי' יחידה שבנפש."
        },
        {
          "s": 4,
          "text": "ומזה שהגמרא מדמה \"כאן לצבור\" לענין \"כאן ליחיד\""
        },
        {
          "s": 5,
          "text": "(בעשי\"ת),"
        },
        {
          "s": 6,
          "text": "מובן אשר גם הענין דתפלה בצבור,"
        },
        {
          "s": 7,
          "text": "שייך לבחי' יחידה."
        },
        {
          "s": 8,
          "text": "דבענין הספירות הוא בחי' פנימיות הכתר,"
        },
        {
          "s": 9,
          "text": "וכמשנ\"ת במאמר"
        },
        {
          "s": 10,
          "text": "(סעיף יג)"
        },
        {
          "s": 11,
          "text": "שתפלה בצבור היא מבחי' פנימיות הכתר."
        },
        {
          "s": 12,
          "text": "וכ\"ה גם בענין עסק התורה"
        },
        {
          "s": 13,
          "text": "(פנימיות התורה)"
        },
        {
          "s": 14,
          "text": "וגמ\"ח"
        },
        {
          "s": 15,
          "text": "(שלמעלה מצדקה)"
        },
        {
          "s": 16,
          "text": "שהם מבחי' פנימיות הכתר – דבעבודת האדם היא בחי' יחידה."
        }
      ]
    }
  ]
}