{
  "globalIndex": 683,
  "owner": 33,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917795_theRebbe_561__p003",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917795_theRebbe_561__p003",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917795_theRebbe_561",
  "title": "מאמר כי ישאלך בנך תשל\"ח",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ויובן זה ע\"פ המבואר במאמר הנ\"ל,"
        },
        {
          "s": 2,
          "text": "שג' הענינים דעדות חוקים ומשפטים הם בכל המצוות."
        },
        {
          "s": 3,
          "text": "שגם המצוות דחוקים ומשפטים נק' בשם עדות"
        },
        {
          "s": 4,
          "text": "[כמ\"ש26"
        },
        {
          "s": 5,
          "text": "ויקם עדות ביעקב גו'],"
        },
        {
          "s": 6,
          "text": "ועד\"ז הוא בנוגע לחוקים,"
        },
        {
          "s": 7,
          "text": "שגם בהמצוות שע\"פ טעם"
        },
        {
          "s": 8,
          "text": "(עדות ואפילו משפטים),"
        },
        {
          "s": 9,
          "text": "הטעם הוא רק על כללות המצוה ולא על הפרטים27,"
        },
        {
          "s": 10,
          "text": "והפרטים הם באופן חוקה חקקתי גזירה גזרתי."
        },
        {
          "s": 11,
          "text": "ועד\"ז הוא בנוגע למשפטים,"
        },
        {
          "s": 12,
          "text": "שגם בהמצוות דעדות וחוקים יש הענין דמשפטים28."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "והענין הוא,"
        },
        {
          "s": 1,
          "text": "דבגילוי אלקות שע\"י המצוות ג' מדריגות בכללות."
        },
        {
          "s": 2,
          "text": "אור המתלבש בעולמות,"
        },
        {
          "s": 3,
          "text": "דבכללות הוא אור הממלא,"
        },
        {
          "s": 4,
          "text": "ואור שלמעלה מהתלבשות בעולמות אבל שייך לעולמות,"
        },
        {
          "s": 5,
          "text": "דבכללות הוא אור הסובב,"
        },
        {
          "s": 6,
          "text": "ועצמות אוא\"ס שלמעלה משייכות לעולמות."
        },
        {
          "s": 7,
          "text": "דאור הממלא מושג גם בשכל,"
        },
        {
          "s": 8,
          "text": "ולכן המשכתו היא ע\"י הענין דמשפטים,"
        },
        {
          "s": 9,
          "text": "השגת השכל."
        },
        {
          "s": 10,
          "text": "ואור הסובב,"
        },
        {
          "s": 11,
          "text": "אין שייך בו השגת החיוב ורק ידיעת השלילה,"
        },
        {
          "s": 12,
          "text": "דזה שהוא יודע ומבין שבאור זה אי אפשר להיות השגת השכל,"
        },
        {
          "s": 13,
          "text": "הו\"ע ביטול ההשגה29."
        },
        {
          "s": 14,
          "text": "ולכן המשכת אור הסובב היא ע\"י קיום החוקים30,"
        },
        {
          "s": 15,
          "text": "שענינם הוא שמבטל את שכלו,"
        },
        {
          "s": 16,
          "text": "אין לך רשות להרהר21."
        },
        {
          "s": 17,
          "text": "ובעצמות אוא\"ס שאינו בגדר שייכות לעולמות,"
        },
        {
          "s": 18,
          "text": "אין שייך לומר גם שהוא מושלל מהשגת השכל."
        },
        {
          "s": 19,
          "text": "וכמבואר בתניא31,"
        },
        {
          "s": 20,
          "text": "שהאומר על הקב\"ה שאי אפשר להשיגו הוא כאומר על איזו חכמה רמה ועמוקה שאי אפשר למששה בידים,"
        },
        {
          "s": 21,
          "text": "שכל השומע יצחק לו."
        },
        {
          "s": 22,
          "text": "כי ענין השלילה,"
        },
        {
          "s": 23,
          "text": "שאומרים על איזה דבר שהוא מושלל מדבר שני,"
        },
        {
          "s": 24,
          "text": "שייך דוקא בדברים שיש יחס ביניהם,"
        },
        {
          "s": 25,
          "text": "והשכל והמישוש הם שני ענינים נבדלים לגמרי שאין יחס ביניהם."
        },
        {
          "s": 26,
          "text": "[ואולי יש להוסיף,"
        },
        {
          "s": 27,
          "text": "שבהמשל דשכל ומישוש,"
        },
        {
          "s": 28,
          "text": "כיון ששניהם הם נבראים מוגבלים,"
        },
        {
          "s": 29,
          "text": "יש יחס ביניהם."
        },
        {
          "s": 30,
          "text": "משא\"כ בהנמשל32."
        },
        {
          "s": 31,
          "text": "ולכן זה שאין שייך לומר על הקב\"ה שאי אפשר להשיגו הוא יותר מזה שאין שייך לומר על סברא שכלית שאי אפשר למששה בידים]."
        },
        {
          "s": 32,
          "text": "ולכן,"
        },
        {
          "s": 33,
          "text": "המשכת עצמות אוא\"ס אינה גם ע\"י ענין החוקים,"
        },
        {
          "s": 34,
          "text": "ביטול השכל,"
        },
        {
          "s": 35,
          "text": "כיון שלגבי עצמות אוא\"ס אין שייך לומר גם הענין דשלילת השכל."
        },
        {
          "s": 36,
          "text": "וזה שע\"י המצוות הוא המשכת עצמות אוא\"ס הוא מפני שהמצוות הם רצון וציווי העצמות."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "וזהו ענין העדות שבמצוות33,"
        },
        {
          "s": 1,
          "text": "דזה שכל המצוות"
        },
        {
          "s": 2,
          "text": "(גם המצוות דחוקים ומשפטים)"
        },
        {
          "s": 3,
          "text": "נק' בשם עדות הוא לפי שהם ממשיכים ומגלים העלם העצמי דעצמות אוא\"ס,"
        },
        {
          "s": 4,
          "text": "שלמעלה גם מסובב34."
        },
        {
          "s": 5,
          "text": "דכמו שענין העדות בפשטות הוא על דבר הנעלם דוקא,"
        },
        {
          "s": 6,
          "text": "דעל דבר הגלוי אין שייך עדות,"
        },
        {
          "s": 7,
          "text": "מכיון שהוא גלוי,"
        },
        {
          "s": 8,
          "text": "ואפילו על מילתא דעבידא לאגלויי אין צריך עדות35,"
        },
        {
          "s": 9,
          "text": "עד\"ז הוא ברוחניות,"
        },
        {
          "s": 10,
          "text": "דאור הממלא הוא דבר הגלוי שמושג בשכל,"
        },
        {
          "s": 11,
          "text": "ואור הסובב שלמעלה מהתלבשות בעולמות הוא מילתא דעבידא לאגלויי"
        },
        {
          "s": 12,
          "text": "(העלם ששייך לגילוי),"
        },
        {
          "s": 13,
          "text": "כי על ידי ההשגה באור הממלא שמתלבש בעולמות,"
        },
        {
          "s": 14,
          "text": "שהוא הארה בלבד"
        },
        {
          "s": 15,
          "text": "(כדמוכח מזה גופא שהוא בהתלבשות),"
        },
        {
          "s": 16,
          "text": "באים לידי ידיעה שישנו אור שהוא מופלא מעולמות,"
        },
        {
          "s": 17,
          "text": "שהוא המקור שממנו נמשך ההארה שבהתלבשות."
        },
        {
          "s": 18,
          "text": "וענין העדות הוא בעצמות אוא\"ס,"
        },
        {
          "s": 19,
          "text": "שלמעלה גם מסובב,"
        },
        {
          "s": 20,
          "text": "שהוא נעלם לגמרי."
        },
        {
          "s": 21,
          "text": "וזהו מה שכל המצוות נק' עדות,"
        },
        {
          "s": 22,
          "text": "לפי שהם ממשיכים ומגלים עצמות אוא\"ס שלמעלה גם מסובב."
        }
      ]
    }
  ]
}