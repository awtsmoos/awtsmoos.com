{
  "globalIndex": 153,
  "owner": 3,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914575_theRebbe_239__p002",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914575_theRebbe_239__p002",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914575_theRebbe_239",
  "title": "מאמר בראשית ברא תשל\"ח",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ומה טעם פתח בבראשית משום כח מעשיו הגיד לעמו לתת להם נחלת גוים."
        },
        {
          "s": 2,
          "text": "והיינו שהענין דכח מעשיו גו' לתת להם נחלת גוים הוא נעלה יותר גם מענין המשכת הסובב,"
        },
        {
          "s": 3,
          "text": "בחי' אוא\"ס שלפני הצמצום."
        },
        {
          "s": 4,
          "text": "דהנה תכלית הכוונה"
        },
        {
          "s": 5,
          "text": "(דתומ\"צ)"
        },
        {
          "s": 6,
          "text": "הוא להמשיך בחי' אור חדש,"
        },
        {
          "s": 7,
          "text": "היינו בחי' עצמות אוא\"ס שלמעלה מהאור שהי' ממלא מקום החלל9."
        },
        {
          "s": 8,
          "text": "והמשכת אור זה הוא דוקא ע\"י עבודת הבירורים10."
        },
        {
          "s": 9,
          "text": "וזהו היתרון שבכח מעשיו גו' לתת להם נחלת גוים על החודש הזה,"
        },
        {
          "s": 10,
          "text": "כי ענין החודש הזה הוא המשכת אור הסובב,"
        },
        {
          "s": 11,
          "text": "שבשרשו הוא בחי' האור שהי' ממלא מקום החלל,"
        },
        {
          "s": 12,
          "text": "וע\"י11"
        },
        {
          "s": 13,
          "text": "עבודת הבירורים דעניני העולם שנפלו מז\"מ,"
        },
        {
          "s": 14,
          "text": "מלכי אדום שברצונו נתנה להם – כמרז\"ל12"
        },
        {
          "s": 15,
          "text": "בונה עולמות ומחריבן – ובנ\"י מבררים ויורשים13"
        },
        {
          "s": 16,
          "text": "אותם ונעשו נחלת יעקב,"
        },
        {
          "s": 17,
          "text": "ממשיכים בחי' אור חדש שלמעלה מהאור שהי' ממלא מקום החלל."
        },
        {
          "s": 18,
          "text": "וכמו שהוא בכלל העולם"
        },
        {
          "s": 19,
          "text": "(עולמות בי\"ע,"
        },
        {
          "s": 20,
          "text": "דמשם יפרד)"
        },
        {
          "s": 21,
          "text": "בא ג\"כ בפרט הבירור דכיבוש ארצות שבעה גוים,"
        },
        {
          "s": 22,
          "text": "שישראל מהפכים אותם לארץ ישראל."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה מכיון דזה ש\"ברצונו נתנה להם\""
        },
        {
          "s": 2,
          "text": "(לזמן מסויים)"
        },
        {
          "s": 3,
          "text": "הוא בכדי שיהי' אח\"כ \"ברצונו נטלה מהם ונתנה לנו\","
        },
        {
          "s": 4,
          "text": "הרי פשוט,"
        },
        {
          "s": 5,
          "text": "שבאם מחליטים בתוקף,"
        },
        {
          "s": 6,
          "text": "אזי מבררים בנקל ביותר את ארצות שבעה גוים,"
        },
        {
          "s": 7,
          "text": "וכל העולם כולו,"
        },
        {
          "s": 8,
          "text": "שיהי' דירה לו ית'."
        },
        {
          "s": 9,
          "text": "וזה מה שנדמה שצריך לזה יגיעה ועמל,"
        },
        {
          "s": 10,
          "text": "ועד שאומות העולם טוענים בנוגע לכל בירור14"
        },
        {
          "s": 11,
          "text": "לסטים אתם הוא מצד גודל ההעלם והסתר,"
        },
        {
          "s": 12,
          "text": "מה שאין נרגש בעולם אשר \"כל הארץ של הקב\"ה היא\""
        },
        {
          "s": 13,
          "text": "(ו\"כי15"
        },
        {
          "s": 14,
          "text": "ממך הכל\"16)."
        },
        {
          "s": 15,
          "text": "אבל הרי תכלית הכוונה של ההעלם והסתר הוא בכדי שיהי' ובקשתם משם17,"
        },
        {
          "s": 16,
          "text": "אַז אידן זאָלן זוכן און געפינען דעם אויבערשטן בכל עניני העולם,"
        },
        {
          "s": 17,
          "text": "בההעלמות וההסתרים18"
        },
        {
          "s": 18,
          "text": "[וכמשל האב המסתיר את עצמו מבנו הקטן בכדי להראות את חכמת הבן שמבין שההסתר וההעלם אינו אלא בכדי שיבקשנו וימצאנו19],"
        },
        {
          "s": 19,
          "text": "והבטיחה תורה שכאשר ובקשתם משם אז בודאי \"ומצאת\"20,"
        },
        {
          "s": 20,
          "text": "שכובשים את כל העולם ועושים ממנו דירה לו ית',"
        },
        {
          "s": 21,
          "text": "עד אשר אז אהפוך אל עמים שפה ברורה וגו' לעבדו שכם אחד21."
        },
        {
          "s": 22,
          "text": "והיתה לה' המלוכה22."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ויש לקשר זה גם עם ענין ד\"ויעקב הלך לדרכו\""
        },
        {
          "s": 2,
          "text": "(שבמוצאי שבת בראשית23),"
        },
        {
          "s": 3,
          "text": "דהגם שהולך לדרכו"
        },
        {
          "s": 4,
          "text": "(גם)"
        },
        {
          "s": 5,
          "text": "בעניני הרשות ובעובדין דחול במשך כל השנה,"
        },
        {
          "s": 6,
          "text": "מ\"מ אינו יירא מזה,"
        },
        {
          "s": 7,
          "text": "כי אם,"
        },
        {
          "s": 8,
          "text": "הולך לבטח דרכו,"
        },
        {
          "s": 9,
          "text": "ובשמחה ובטוב לבב."
        },
        {
          "s": 10,
          "text": "וזהו גם מה שבמוצאי שבת"
        },
        {
          "s": 11,
          "text": "[ובפרט במוצאי שבת בראשית,"
        },
        {
          "s": 12,
          "text": "שאז מתחיל"
        },
        {
          "s": 13,
          "text": "(בעיקר)"
        },
        {
          "s": 14,
          "text": "הסדר דויעקב הלך לדרכו23]"
        },
        {
          "s": 15,
          "text": "אומרים24"
        },
        {
          "s": 16,
          "text": "אל תירא עבדי יעקב25,"
        },
        {
          "s": 17,
          "text": "כי \"במוצאי שבת מסתלקת הנשמה יתירה וצריך לחזור ולירד בבחי' יעקב עבדי בכל ששת ימי המעשה לברר בירורים בבי\"ע כו' לכך אומר אל תירא עבדי יעקב כו' מלירד שם,"
        },
        {
          "s": 18,
          "text": "ובזה נותנים כח ועוז כו'\"26."
        },
        {
          "s": 19,
          "text": "והטעם לזה"
        },
        {
          "s": 20,
          "text": "(לענין אל תירא)"
        },
        {
          "s": 21,
          "text": "הוא כי הוי' אלקיו עמו27,"
        },
        {
          "s": 22,
          "text": "שכאו\"א מישראל"
        },
        {
          "s": 23,
          "text": "(גם מי שהוא בבחי' יעקב),"
        },
        {
          "s": 24,
          "text": "בכל מקום ובכל זמן ובכל ענין"
        },
        {
          "s": 25,
          "text": "(גם בחו\"ל ובימי החול ובעובדין דחול),"
        },
        {
          "s": 26,
          "text": "הוי' אלקיו"
        },
        {
          "s": 27,
          "text": "(הוא)"
        },
        {
          "s": 28,
          "text": "עמו,"
        },
        {
          "s": 29,
          "text": "ועד שנעשה שותף להקב\"ה במעשה בראשית28,"
        },
        {
          "s": 30,
          "text": "שהוא פועל חידוש בהבריאה"
        },
        {
          "s": 31,
          "text": "(כמו הקב\"ה כביכול)."
        },
        {
          "s": 32,
          "text": "כי ע\"י עבודתו בעבודת הבירורים לעשות את העולם דירה לו ית',"
        },
        {
          "s": 33,
          "text": "הוא פועל חידוש בהבריאה"
        },
        {
          "s": 34,
          "text": "[דזהו גם מה שבשבת בראשית קורין בתורה בראשית ברא אלקים את השמים ואת הארץ,"
        },
        {
          "s": 35,
          "text": "שעי\"ז נעשה בריאת השמים והארץ וכל צבאיהם מחדש ובאופן חדש],"
        },
        {
          "s": 36,
          "text": "ועד שיהי' השמים החדשים והארץ החדשה גו'29."
        }
      ]
    }
  ]
}