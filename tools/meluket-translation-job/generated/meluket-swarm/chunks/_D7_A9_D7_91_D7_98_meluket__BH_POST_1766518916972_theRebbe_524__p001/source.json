{
  "globalIndex": 560,
  "owner": 10,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916972_theRebbe_524__p001",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916972_theRebbe_524__p001",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916972_theRebbe_524",
  "title": "מאמר באתי לגני תשמ\"ח",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ בשלח,"
        },
        {
          "s": 2,
          "text": "י\"א שבט ה'תשמ\"ח*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "באתי לגני אחותי כלה1,"
        },
        {
          "s": 1,
          "text": "ומביא ע\"ז כ\"ק מו\"ח אדמו\"ר בעל ההילולא בהמאמר דיום ההסתלקות ויום ההילולא שלו2,"
        },
        {
          "s": 2,
          "text": "דאיתא במדרש רבה"
        },
        {
          "s": 3,
          "text": "(במקומו)"
        },
        {
          "s": 4,
          "text": "לגני לגנוני,"
        },
        {
          "s": 5,
          "text": "למקום שהי' עיקרי בתחלה,"
        },
        {
          "s": 6,
          "text": "דעיקר שכינה בתחתונים היתה,"
        },
        {
          "s": 7,
          "text": "אלא שע\"י הענינים הבלתי רצויים נסתלקה השכינה מלמטה למעלה עד רקיע השביעי,"
        },
        {
          "s": 8,
          "text": "ואח\"כ"
        },
        {
          "s": 9,
          "text": "[והותחל תיכף לאחרי זה]"
        },
        {
          "s": 10,
          "text": "עמדו שבעה צדיקים והורידו את השכינה מלמעלה למטה,"
        },
        {
          "s": 11,
          "text": "עד שבא משה שהוא השביעי"
        },
        {
          "s": 12,
          "text": "(דכל השביעין חביבין3)"
        },
        {
          "s": 13,
          "text": "והורידה למטה בארץ."
        },
        {
          "s": 14,
          "text": "וענין זה"
        },
        {
          "s": 15,
          "text": "(ירידת והמשכת השכינה למטה בארץ)"
        },
        {
          "s": 16,
          "text": "נעשה בעיקר ע\"י המשכן שעשה משה"
        },
        {
          "s": 17,
          "text": "[ועד דהמשכן נק' מעשה משה4],"
        },
        {
          "s": 18,
          "text": "כמ\"ש5"
        },
        {
          "s": 19,
          "text": "ועשו לי מקדש ושכנתי בתוכם."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר6,"
        },
        {
          "s": 2,
          "text": "שהמשכת עיקר שכינה למטה"
        },
        {
          "s": 3,
          "text": "(ושכנתי בתוכם)"
        },
        {
          "s": 4,
          "text": "נעשית ע\"י העבודה דאתהפכא חשוכא לנהורא."
        },
        {
          "s": 5,
          "text": "וזהו מה שבמשכן כתיב7"
        },
        {
          "s": 6,
          "text": "ועשית את הקרשים למשכן,"
        },
        {
          "s": 7,
          "text": "קרש הוא אותיות שקר,"
        },
        {
          "s": 8,
          "text": "וע\"י שמהפכים את השקר דעולם לקרש המשכן,"
        },
        {
          "s": 9,
          "text": "עי\"ז נעשה ושכנתי בתוכם,"
        },
        {
          "s": 10,
          "text": "המשכת עיקר שכינה בתחתונים."
        },
        {
          "s": 11,
          "text": "[ויש להוסיף,"
        },
        {
          "s": 12,
          "text": "דזהו גם מה ששקר אותיות קשר8,"
        },
        {
          "s": 13,
          "text": "כי העבודה שעל ידה נעשה ושכנתי בתוכם היא לא באופן שהאדם העובד פורש עצמו מעניני העולם,"
        },
        {
          "s": 14,
          "text": "כי אם,"
        },
        {
          "s": 15,
          "text": "שיש לו קשר עם העולם9,"
        },
        {
          "s": 16,
          "text": "ומהפך את העולם גופא לקדושה,"
        },
        {
          "s": 17,
          "text": "אתהפכא חשוכא לנהורא]."
        },
        {
          "s": 18,
          "text": "וזהו10"
        },
        {
          "s": 19,
          "text": "גם מה שהמשכן הי' מעצי שטים7,"
        },
        {
          "s": 20,
          "text": "שטים מלשון שטות11,"
        },
        {
          "s": 21,
          "text": "היינו שטות דלעו\"ז,"
        },
        {
          "s": 22,
          "text": "והעבודה שעל ידה נעשה ושכנתי בתוכם היא להפוך את השטות דלעו\"ז לשטות דקדושה."
        },
        {
          "s": 23,
          "text": "דבכדי שיהי' ושכנתי בתוכם המשכת עיקר שכינה למטה"
        },
        {
          "s": 24,
          "text": "[דעיקר שכינה הוא עצמות אוא\"ס שלמעלה משייכות לעולמות12]"
        },
        {
          "s": 25,
          "text": "אינו מספיק העבודה שע\"פ טעם ודעת,"
        },
        {
          "s": 26,
          "text": "וצריכה להיות העבודה דשטות דקדושה שלמעלה מטעם ודעת."
        },
        {
          "s": 27,
          "text": "כמאמר רז\"ל13"
        },
        {
          "s": 28,
          "text": "אהני לי' שטותי' לסבא,"
        },
        {
          "s": 29,
          "text": "דמאמר זה הוא בנוגע לאמורא שהי' מגדולי ישראל"
        },
        {
          "s": 30,
          "text": "(גם לפני זה)"
        },
        {
          "s": 31,
          "text": "ועד שנקרא בשם סבא,"
        },
        {
          "s": 32,
          "text": "וע\"י עבודתו באופן של שטות דקדושה שלמעלה מטו\"ד נתעלה עוד יותר,"
        },
        {
          "s": 33,
          "text": "אהני לי' שטותי'."
        }
      ]
    }
  ]
}