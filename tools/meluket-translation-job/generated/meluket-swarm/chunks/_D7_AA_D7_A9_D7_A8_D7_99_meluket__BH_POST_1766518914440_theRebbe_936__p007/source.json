  "owner": 32,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914440_theRebbe_936__p007",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914440_theRebbe_936__p007",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914440_theRebbe_936",
  "title": "מאמר תורה צוה תשכ\"ג",
  "part": 7,
  "sections": [
    {
      "v": 18,
      "items": [
        {
          "s": 0,
          "text": "ולהוסיף,"
        },
        {
          "s": 1,
          "text": "דזה שכל ישראל מתאחדים להיות מציאות אחת,"
        },
        {
          "s": 2,
          "text": "קהלת יעקב,"
        },
        {
          "s": 3,
          "text": "הוא לא מפני שנרגש בהם עילוי שלמעלה מהתחלקות"
        },
        {
          "s": 4,
          "text": "[ע\"ד ההתאחדות דישורון מלשון שיר,"
        },
        {
          "s": 5,
          "text": "שהוא ע\"י גילוי המקיף שלמעלה מהתחלקות],"
        },
        {
          "s": 6,
          "text": "שהרי יעקב הוא מלשון עקב,"
        },
        {
          "s": 7,
          "text": "ובעקב אין נרגש עילוי,"
        },
        {
          "s": 8,
          "text": "אלא אחדות עצמית."
        },
        {
          "s": 9,
          "text": "ועד\"ז הוא בנוגע לההתאחדות דישראל בענין הריקוד בעקביים."
        },
        {
          "s": 10,
          "text": "וע\"י הענין דקהלת יעקב,"
        },
        {
          "s": 11,
          "text": "מתגלה הענין דמורשה,"
        },
        {
          "s": 12,
          "text": "ירושה דתורה,"
        },
        {
          "s": 13,
          "text": "שישראל אורייתא וקוב\"ה כולא חד."
        },
        {
          "s": 14,
          "text": "דבמתנה דתורה,"
        },
        {
          "s": 15,
          "text": "יש ג' ענינים."
        },
        {
          "s": 16,
          "text": "הנותן המקבל והמתנה"
        },
        {
          "s": 17,
          "text": "(תורה),"
        },
        {
          "s": 18,
          "text": "משא\"כ בענין הירושה דתורה,"
        },
        {
          "s": 19,
          "text": "ישראל ואורייתא וקוב\"ה כולא חד."
        }
      ]
    },
    {
      "v": 19,
      "items": [
        {
          "s": 0,
          "text": "והמשכת ענין זה"
        },
        {
          "s": 1,
          "text": "(מורשה,"
        },
        {
          "s": 2,
          "text": "ירושה דתורה)"
        },
        {
          "s": 3,
          "text": "בשמחת תורה,"
        },
        {
          "s": 4,
          "text": "היא בשמחה גדולה."
        },
        {
          "s": 5,
          "text": "ומשמח\"ת נמשך זה על כל השנה כולה,"
        },
        {
          "s": 6,
          "text": "שתהי' שנה שמיחה בלימוד התורה בלי שום מניעות ועיכובים,"
        },
        {
          "s": 7,
          "text": "שמפני זה נתאוו כל ישראל וכו' לימות המשיח כי אז לא יהי' שום מונע ומעכב מלעסוק בתורה ובמצוות כדרוש57,"
        },
        {
          "s": 8,
          "text": "ועד שיהי' ומלאה הארץ דעה את הוי' כמים לים מכסים58,"
        },
        {
          "s": 9,
          "text": "בביאת משיח צדקנו בקרוב ממש."
        }
      ]
    }
  ]
}