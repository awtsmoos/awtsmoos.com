{
  "globalIndex": 21,
  "owner": 21,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913794_theRebbe_460__p003",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913794_theRebbe_460__p003",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518913794_theRebbe_460",
  "title": "מאמר וביום שמחתכם תש\"מ",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "וזהו וביום שמחתכם גו' ותקעתם בחצוצרות גו' אני ה' אלקיכם,"
        },
        {
          "s": 2,
          "text": "ותקעתם הו\"ע תקיעת שופר,"
        },
        {
          "s": 3,
          "text": "דמצות היום"
        },
        {
          "s": 4,
          "text": "(דר\"ה)"
        },
        {
          "s": 5,
          "text": "הוא בשופר,"
        },
        {
          "s": 6,
          "text": "וכדאיתא במשנה12"
        },
        {
          "s": 7,
          "text": "שופר מאריך וחצוצרות מקצרות שמצות היום בשופר."
        },
        {
          "s": 8,
          "text": "ועי\"ז נמשך ונתגלה גם הענין דחצוצרות48"
        },
        {
          "s": 9,
          "text": "שהקב\"ה וישראל הם ב' חצאי צורות,"
        },
        {
          "s": 10,
          "text": "היינו מה שישראל הם מושרשים בעצמותו ית' והם המחליטים את הרצון"
        },
        {
          "s": 11,
          "text": "(כנ\"ל בענין במי נמלך בנשמותיהן של צדיקים),"
        },
        {
          "s": 12,
          "text": "ומרצון המוחלט נמשך לרצון הגלוי וכו' עד שנמשך למטה בעוה\"ז,"
        },
        {
          "s": 13,
          "text": "שזהו העיקר."
        },
        {
          "s": 14,
          "text": "והיינו שההמשכה בכל הדרגות,"
        },
        {
          "s": 15,
          "text": "עונג רצון מוחין מדות ומלכות וכו' הוא ממוצע שעי\"ז יומשך אח\"כ בעוה\"ז."
        },
        {
          "s": 16,
          "text": "וכמבואר בתניא קדישא49"
        },
        {
          "s": 17,
          "text": "שבכל סדר ההשתלשלות הוא ירידה מאור פניו ית',"
        },
        {
          "s": 18,
          "text": "ותכלית הכוונה הוא עוה\"ז התחתון שאין תחתון למטה ממנו,"
        },
        {
          "s": 19,
          "text": "בירא עמיקתא,"
        },
        {
          "s": 20,
          "text": "שבו דוקא"
        },
        {
          "s": 21,
          "text": "(בעוה\"ז התחתון)"
        },
        {
          "s": 22,
          "text": "נברא האדם וניתנה בו הנשמה חלק אלוקה ממעל ממש,"
        },
        {
          "s": 23,
          "text": "וע\"י עבודתו בתומ\"צ"
        },
        {
          "s": 24,
          "text": "(לעבדה ולשמרה50)"
        },
        {
          "s": 25,
          "text": "נשלמה הכוונה דדירה בתחתונים,"
        },
        {
          "s": 26,
          "text": "דירה לעצמותו ומהותו51,"
        },
        {
          "s": 27,
          "text": "שיהי' אלה תולדות פרץ תולדות מלא52,"
        },
        {
          "s": 28,
          "text": "שהוא למעלה יותר גם מכמו שהי' בתחלת הבריאה דעולם על מילואו נברא53,"
        },
        {
          "s": 29,
          "text": "פרץ הוליד גו' את דוד54,"
        },
        {
          "s": 30,
          "text": "דוד מלכא משיחא,"
        },
        {
          "s": 31,
          "text": "שיבנה ביהמ\"ק55"
        },
        {
          "s": 32,
          "text": "ויהי' ותקעתם בחצוצרות גו' לפני אלקיכם,"
        },
        {
          "s": 33,
          "text": "בחצוצרות וקול שופר הריעו לפני המלך ה',"
        },
        {
          "s": 34,
          "text": "כפשוטו"
        },
        {
          "s": 35,
          "text": "(בביהמ\"ק)"
        },
        {
          "s": 36,
          "text": "למטה מעשרה טפחים."
        },
        {
          "s": 37,
          "text": "כי ע\"י העבודה שבמשך זמן הגלות דתקעו בחודש שופר,"
        },
        {
          "s": 38,
          "text": "שפרו מעשיכם56,"
        },
        {
          "s": 39,
          "text": "ובאופן של חידוש כדיוק הכתוב תקעו בחודש שופר"
        },
        {
          "s": 40,
          "text": "(ולא תקעו שופר בחודש)"
        },
        {
          "s": 41,
          "text": "כידוע פירוש הבעש\"ט57"
        },
        {
          "s": 42,
          "text": "בזה,"
        },
        {
          "s": 43,
          "text": "עי\"ז נעשה הענין דעשה לך שתי חצוצרות גו' למקרא העדה ולמסע את המחנות31"
        },
        {
          "s": 44,
          "text": "לאסף את כל ישראל יחד ולמסע ולהליכה מחיל אל חיל,"
        },
        {
          "s": 45,
          "text": "מבירא עמיקתא עד לאיגרא רמה,"
        },
        {
          "s": 46,
          "text": "והענין דכי58"
        },
        {
          "s": 47,
          "text": "תבואו מלחמה מלחמה עם נה\"ב59"
        },
        {
          "s": 48,
          "text": "ונושעתם ע\"י אתכפיא ואתהפכא,"
        },
        {
          "s": 49,
          "text": "ועי\"ז יהי' ותקעתם בחצוצרות לפני אלקיכם בביהמ\"ק השלישי שיבנה בקרוב ממש ע\"י משיח צדקנו,"
        },
        {
          "s": 50,
          "text": "וכל זה באופן דוביום שמחתכם,"
        },
        {
          "s": 51,
          "text": "ושמחת עולם על ראשם60,"
        },
        {
          "s": 52,
          "text": "במהרה בימינו ממש."
        }
      ]
    }
  ]
}