{
  "globalIndex": 923,
  "owner": 23,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919223_theRebbe_96__p008",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919223_theRebbe_96__p008",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919223_theRebbe_96",
  "title": "מאמר תפלה למשה תשכ\"ט",
  "part": 8,
  "sections": [
    {
      "v": 21,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "ויש לומר,"
        },
        {
          "s": 3,
          "text": "דע\"י שדוד כתב המזמור תפלה למשה בספר תהלים שנאמר ע\"י כל ישראל,"
        },
        {
          "s": 4,
          "text": "גם ע\"י אנשים פשוטים,"
        },
        {
          "s": 5,
          "text": "ניתן הכח לכאו\"א מישראל,"
        },
        {
          "s": 6,
          "text": "לגלות בחינת העשירות שבו"
        },
        {
          "s": 7,
          "text": "(מצד בחינת משה שבכ\"א מישראל95),"
        },
        {
          "s": 8,
          "text": "ועי\"ז – למלאות החסרון דמלכות ודהעולם,"
        },
        {
          "s": 9,
          "text": "מילוי החסרון לגמרי,"
        },
        {
          "s": 10,
          "text": "שלא יהי' מקום בעולם שאין מאיר בו גילוי אלקות."
        },
        {
          "s": 11,
          "text": "ויש לקשר זה עם מאמר המדרש96"
        },
        {
          "s": 12,
          "text": "בפירוש איש האלקים,"
        },
        {
          "s": 13,
          "text": "בשעה שעלה לרקיע איש ובשעה שירד מן הרקיע אלקים,"
        },
        {
          "s": 14,
          "text": "ומבאר כ\"ק מו\"ח אדמו\"ר בשיחה הנ\"ל"
        },
        {
          "s": 15,
          "text": "(שהובאה בתחילת המאמר)97,"
        },
        {
          "s": 16,
          "text": "דאדם"
        },
        {
          "s": 17,
          "text": "(מוחין98)"
        },
        {
          "s": 18,
          "text": "הוא למעלה מאיש"
        },
        {
          "s": 19,
          "text": "(מדות98),"
        },
        {
          "s": 20,
          "text": "ומ\"ש במדרש בשעה שעלה לרקיע איש הוא להורות שגם בעת התפלה,"
        },
        {
          "s": 21,
          "text": "כשמתבונן בדרגות הכי נעלות ומשיג אותם בטוב,"
        },
        {
          "s": 22,
          "text": "עולה לרקיע,"
        },
        {
          "s": 23,
          "text": "צריך לזכור שהוא איש,"
        },
        {
          "s": 24,
          "text": "שיש לו מדות שצריך לבררם ולזככם,"
        },
        {
          "s": 25,
          "text": "ועי\"ז,"
        },
        {
          "s": 26,
          "text": "בשעה שיורד מן הרקיע"
        },
        {
          "s": 27,
          "text": "(לאחרי התפלה)"
        },
        {
          "s": 28,
          "text": "הוא אלקים,"
        },
        {
          "s": 29,
          "text": "אלקים מלשון דין99"
        },
        {
          "s": 30,
          "text": "ואלקים מלשון כח וגבורה100,"
        },
        {
          "s": 31,
          "text": "שהוא בעל כח וגבורה לעשות דין בעצמו שהנהגתו בפועל תהי' כדבעי."
        }
      ]
    },
    {
      "v": 22,
      "items": [
        {
          "s": 0,
          "text": "וע\"פ המבואר דענינו של משה"
        },
        {
          "s": 1,
          "text": "(המודגש בתפלה למשה)"
        },
        {
          "s": 2,
          "text": "הוא זה שמשה הי' עשיר,"
        },
        {
          "s": 3,
          "text": "צריך לומר,"
        },
        {
          "s": 4,
          "text": "שהעבודה דאיש האלקים שייכת לענין העשירות."
        },
        {
          "s": 5,
          "text": "והענין הוא,"
        },
        {
          "s": 6,
          "text": "דג' הענינים שלמעלה"
        },
        {
          "s": 7,
          "text": "(ממלא,"
        },
        {
          "s": 8,
          "text": "סובב ואוא\"ס שלמעלה מסובב)"
        },
        {
          "s": 9,
          "text": "יש דוגמתם באדם."
        },
        {
          "s": 10,
          "text": "שהגילויים דהנשמה הם דוגמת הגילויים דממלא וסובב,"
        },
        {
          "s": 11,
          "text": "ועצם הנשמה היא דוגמת עצמות אוא\"ס."
        },
        {
          "s": 12,
          "text": "וכמו שלמעלה,"
        },
        {
          "s": 13,
          "text": "מצד הגילויים דממלא וסובב יש נתינת מקום למציאות שמחוץ לאלקות וזה שאמיתית המציאות של כל הנמצאים הוא אלקות הוא דוקא מצד עצמות אוא\"ס"
        },
        {
          "s": 14,
          "text": "(כנ\"ל סעיף ט),"
        },
        {
          "s": 15,
          "text": "עד\"ז הוא בעבודת האדם,"
        },
        {
          "s": 16,
          "text": "שבכדי שההתבוננות שבתפלה תהי' באופן שתפעול על הנהגתו במשך כל היום,"
        },
        {
          "s": 17,
          "text": "איש האלקים,"
        },
        {
          "s": 18,
          "text": "הוא ע\"י שהתפלה שלו קשורה עם עצם הנשמה,"
        },
        {
          "s": 19,
          "text": "משה,"
        },
        {
          "s": 20,
          "text": "עשירות."
        }
      ]
    },
    {
      "v": 23,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "ולהוסיף,"
        },
        {
          "s": 3,
          "text": "דמבואר בהמאמר101,"
        },
        {
          "s": 4,
          "text": "שבתפלת משה על כנס\"י,"
        },
        {
          "s": 5,
          "text": "היא ספירת המלכות,"
        },
        {
          "s": 6,
          "text": "שני ענינים."
        },
        {
          "s": 7,
          "text": "המשכת הארה מעצמות אוא\"ס שעי\"ז אפשר להיות עליית המלכות"
        },
        {
          "s": 8,
          "text": "(מלמטה למעלה)"
        },
        {
          "s": 9,
          "text": "בעצמות אוא\"ס,"
        },
        {
          "s": 10,
          "text": "ועי\"ז נעשה אח\"כ המשכת העצמות במלכות"
        },
        {
          "s": 11,
          "text": "(מלמעלה למטה)."
        },
        {
          "s": 12,
          "text": "ויש לומר,"
        },
        {
          "s": 13,
          "text": "דשני ענינים אלה"
        },
        {
          "s": 14,
          "text": "(במלכות)"
        },
        {
          "s": 15,
          "text": "הם ע\"י שני הענינים באיש האלקים"
        },
        {
          "s": 16,
          "text": "[בשעה שעלה לרקיע איש ובשעה שירד מן הרקיע אלקים]"
        },
        {
          "s": 17,
          "text": "שבעבודת האדם."
        },
        {
          "s": 18,
          "text": "דע\"י העבודה דבשעה שעלה לרקיע איש,"
        },
        {
          "s": 19,
          "text": "שגם בההתבוננות דתפלה הוא זוכר שיש לו מדות שצריך לבררם ולזככם,"
        },
        {
          "s": 20,
          "text": "דזה שהתפלה שלו היא באופן זה הוא ע\"י שהתפלה שלו קשורה עם עצם הנשמה"
        },
        {
          "s": 21,
          "text": "(כנ\"ל סעיף יו\"ד),"
        },
        {
          "s": 22,
          "text": "הוא המשכת הארה מעצם הנשמה"
        },
        {
          "s": 23,
          "text": "(מלמעלמ\"ט)"
        },
        {
          "s": 24,
          "text": "שעי\"ז מתעלים ענינים התחתונים שבו להתפלה – עי\"ז נמשך הארה מעצמות אוא\"ס לרומם ולהעלות את המלכות לשרשה בהעצמות."
        },
        {
          "s": 25,
          "text": "וע\"י העבודה דבשעה שירד מן הרקיע אלקים,"
        },
        {
          "s": 26,
          "text": "דע\"י שהתפלה קשורה עם עצם הנשמה היא פועלת על הנהגתו במשך כל היום,"
        },
        {
          "s": 27,
          "text": "הוא המשכת וגילוי עצם הנשמה בענינים התחתונים שבו – עי\"ז הוא המשכת וגילוי העצמות במלכות,"
        },
        {
          "s": 28,
          "text": "גזור שתיבנה בבחינת בנין עדי עד."
        }
      ]
    }
  ]
}