{
  "globalIndex": 1121,
  "owner": 21,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920487_theRebbe_9__p005",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920487_theRebbe_9__p005",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920487_theRebbe_9",
  "title": "מאמר לך אמר לבי תש\"כ",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ועד\"ז הוא למעלה,"
        },
        {
          "s": 1,
          "text": "דבשם אלקים אפשר להיות"
        },
        {
          "s": 2,
          "text": "(ע\"י ריבוי צמצומים)"
        },
        {
          "s": 3,
          "text": "יניקה לחיצונים,"
        },
        {
          "s": 4,
          "text": "ועד לאלקים אחרים45."
        },
        {
          "s": 5,
          "text": "וע\"פ המבואר בכ\"מ46"
        },
        {
          "s": 6,
          "text": "דשם אלקים הוא לא רק המגן ונרתק שמעלים ומסתיר על האור דשם הוי',"
        },
        {
          "s": 7,
          "text": "אלא שגם האור דשם הוי' כמו שנמשך ומתצמצם ע\"י שם אלקים להיות מקור לנבראים,"
        },
        {
          "s": 8,
          "text": "שבכללות הוא אור הממלא,"
        },
        {
          "s": 9,
          "text": "נקרא אלקים,"
        },
        {
          "s": 10,
          "text": "יש לומר שעד\"ז הוא באור הממלא."
        },
        {
          "s": 11,
          "text": "דמכיון שההתהוות משם אלקים"
        },
        {
          "s": 12,
          "text": "(אור הממלא)"
        },
        {
          "s": 13,
          "text": "היא בדרך התלבשות,"
        },
        {
          "s": 14,
          "text": "הנבראים שמתהווים ממנו הם תופסים מקום,"
        },
        {
          "s": 15,
          "text": "והביטול שלהם הוא רק ביטול היש47,"
        },
        {
          "s": 16,
          "text": "ולכן אפשר להשתלשל מזה ישות ממש48,"
        },
        {
          "s": 17,
          "text": "ועד להישות דע\"ז"
        },
        {
          "s": 18,
          "text": "(אלקים אחרים)."
        },
        {
          "s": 19,
          "text": "ובכדי שלא יהי' נתינת מקום לישות ולעו\"ז,"
        },
        {
          "s": 20,
          "text": "הוא דוקא ע\"י הגילוי דשם הוי'"
        },
        {
          "s": 21,
          "text": "(אור הסובב),"
        },
        {
          "s": 22,
          "text": "שההתהוות ממנו היא באופן דבדרך ממילא,"
        },
        {
          "s": 23,
          "text": "והנבראים אינם תופסים מקום לגבי',"
        },
        {
          "s": 24,
          "text": "ביטול במציאות47."
        },
        {
          "s": 25,
          "text": "וע\"פ המבואר לעיל"
        },
        {
          "s": 26,
          "text": "(סעיף ה)"
        },
        {
          "s": 27,
          "text": "שגם שם הוי' הוא מקור להתהוות,"
        },
        {
          "s": 28,
          "text": "בהכרח שגם לגבי שם הוי' יש איזה תפיסת מקום להנבראים49,"
        },
        {
          "s": 29,
          "text": "ואמיתית הביטול הוא דוקא לגבי עצמות אוא\"ס שלמעלה מהוי' שאינו בגדר מקור לעולמות."
        },
        {
          "s": 30,
          "text": "ועפ\"ז יש לומר שבכדי לשלול בתכלית שלא תהי' נתינת מקום לישות,"
        },
        {
          "s": 31,
          "text": "הוא דוקא ע\"י הגילוי דעצמות אוא\"ס שלמעלה מהוי'."
        },
        {
          "s": 32,
          "text": "וזהו מ\"ש50"
        },
        {
          "s": 33,
          "text": "לא יהי' לך אלקים אחרים על פני,"
        },
        {
          "s": 34,
          "text": "שבכדי שלא יהי' שום נתינת מקום לאלקים אחרים הוא ע\"י על פני,"
        },
        {
          "s": 35,
          "text": "דאמיתית הענין דפני הוא עצמות אוא\"ס שלמעלה מהוי'."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "דשני הפירושים בלך אמר לבי בקשו פני"
        },
        {
          "s": 3,
          "text": "(שלך הוא בשבילך ובשליחותך,"
        },
        {
          "s": 4,
          "text": "ושלך הוא במקומך),"
        },
        {
          "s": 5,
          "text": "וגם שני הפירושים"
        },
        {
          "s": 6,
          "text": "(בהמאמר)"
        },
        {
          "s": 7,
          "text": "בבקשו"
        },
        {
          "s": 8,
          "text": "(בקשה ותחינה,"
        },
        {
          "s": 9,
          "text": "בקשה וחיפוש),"
        },
        {
          "s": 10,
          "text": "הם בהתאם לשתי הדרגות בפני."
        },
        {
          "s": 11,
          "text": "דבהפנימיות דשם הוי'"
        },
        {
          "s": 12,
          "text": "(שהוא בחי' פנימיות לגבי שם אלקים),"
        },
        {
          "s": 13,
          "text": "שדוגמתו באדם הוא הארת נקודת הלב,"
        },
        {
          "s": 14,
          "text": "פירוש לך הוא בשבילך ובשליחותך."
        },
        {
          "s": 15,
          "text": "היינו שהלב הוא שלוחו של הקב\"ה,"
        },
        {
          "s": 16,
          "text": "דענינו של שליח הוא ששולחים אותו לעשות איזה דבר."
        },
        {
          "s": 17,
          "text": "והשליחות שבדרגא זו שבפנימיות הלב הוא להאיר בחיצוניות הלב כדי לנצח המלחמה עם הנפש הבהמית,"
        },
        {
          "s": 18,
          "text": "דעיקר הנצחון"
        },
        {
          "s": 19,
          "text": "(שע\"י גילוי דרגא זו)"
        },
        {
          "s": 20,
          "text": "הוא בהלבושים מחשבה דיבור ומעשה,"
        },
        {
          "s": 21,
          "text": "אלא שבכדי שהמחשבה דיבור ומעשה יהיו בשלימות הוא ע\"י המדות שבלב51,"
        },
        {
          "s": 22,
          "text": "עבודה עם הלב."
        },
        {
          "s": 23,
          "text": "ועפ\"ז פירוש בקשו פני הוא בקשה וחיפוש,"
        },
        {
          "s": 24,
          "text": "לחפש בכל עניניו שיהיו בהתאם לבחי' פני"
        },
        {
          "s": 25,
          "text": "(פני הוי')."
        },
        {
          "s": 26,
          "text": "ובהפנימיות דאוא\"ס שלמעלה מהוי',"
        },
        {
          "s": 27,
          "text": "שדוגמתו באדם היא עצמות נקודת הלב,"
        },
        {
          "s": 28,
          "text": "פירוש לך הוא במקומך,"
        },
        {
          "s": 29,
          "text": "וכמובא לעיל"
        },
        {
          "s": 30,
          "text": "(סוף סעיף ב)"
        },
        {
          "s": 31,
          "text": "מהמאמר שהוא נקודת היהדות שבכל אחד מישראל שמקושרת בהעצמות"
        },
        {
          "s": 32,
          "text": "(במקומך)."
        },
        {
          "s": 33,
          "text": "דבדרגא זו אין שייך ענין השליחות,"
        },
        {
          "s": 34,
          "text": "כי נקודת היהדות אינה אמצעי לענין אחר"
        },
        {
          "s": 35,
          "text": "(מילוי השליחות),"
        },
        {
          "s": 36,
          "text": "והתכלית הוא בה עצמה52."
        },
        {
          "s": 37,
          "text": "והעבודה בנוגע לדרגא זו היא – עבודה בהלב עצמו,"
        },
        {
          "s": 38,
          "text": "שיהי' בגילוי."
        },
        {
          "s": 39,
          "text": "דפנימיות הלב כמו שהוא מצד עצמו הוא בהעלם53,"
        },
        {
          "s": 40,
          "text": "והעבודה בו היא לעורר אותו שיהי' בגילוי."
        },
        {
          "s": 41,
          "text": "ועפ\"ז פירוש בקשו פני הוא בקשה ותחינה,"
        },
        {
          "s": 42,
          "text": "דבקשה ותחינה היא"
        },
        {
          "s": 43,
          "text": "(כהלשון בהמאמר)"
        },
        {
          "s": 44,
          "text": "בהתעוררות גדולה."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "והנה מבואר במק\"א54,"
        },
        {
          "s": 2,
          "text": "שבהעלי' דהנשמה שע\"י ירידתה למטה,"
        },
        {
          "s": 3,
          "text": "שני ענינים."
        },
        {
          "s": 4,
          "text": "שע\"י שגם בהיותה מלובשת בגוף ונה\"ב היא עובדת את ה',"
        },
        {
          "s": 5,
          "text": "מתגלה תוקף ההתקשרות שלה עם הקב\"ה,"
        },
        {
          "s": 6,
          "text": "שגם ההעלם וההסתר דהגוף ונה\"ב אינו יכול לעשות גרעון בההתקשרות שלה."
        },
        {
          "s": 7,
          "text": "ושע\"י עבודתה למטה נעשה ענין חדש,"
        },
        {
          "s": 8,
          "text": "הבירור והזיכוך דהגוף ונה\"ב וחלקו בעולם."
        },
        {
          "s": 9,
          "text": "וכיון שענין זה"
        },
        {
          "s": 10,
          "text": "(הבירור והזיכוך דהגוף וכו')"
        },
        {
          "s": 11,
          "text": "הוא התחדשות"
        },
        {
          "s": 12,
          "text": "(ולא גילוי ההעלם),"
        },
        {
          "s": 13,
          "text": "הוא נעלה יותר מגילוי תוקף ההתקשרות דהנשמה."
        },
        {
          "s": 14,
          "text": "וע\"פ הידוע55"
        },
        {
          "s": 15,
          "text": "שבירור וזיכוך הגוף ונה\"ב"
        },
        {
          "s": 16,
          "text": "(שבשביל זה ירדה הנשמה למטה56)"
        },
        {
          "s": 17,
          "text": "הוא דוקא ע\"י אהבה ויראה שבהתגלות הלב,"
        },
        {
          "s": 18,
          "text": "חיצוניות הלב,"
        },
        {
          "s": 19,
          "text": "יש לומר,"
        },
        {
          "s": 20,
          "text": "שיש יתרון בהשליחות דהארת נקודת הלב לחיצוניות הלב,"
        },
        {
          "s": 21,
          "text": "על העבודה דגילוי נקודת היהדות."
        }
      ]
    }
  ]
}