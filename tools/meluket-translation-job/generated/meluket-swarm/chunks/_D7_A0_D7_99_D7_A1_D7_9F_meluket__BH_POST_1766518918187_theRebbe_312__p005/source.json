{
  "globalIndex": 758,
  "owner": 8,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918187_theRebbe_312__p005",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918187_theRebbe_312__p005",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518918187_theRebbe_312",
  "title": "מאמר החודש הזה לכם תשל\"א",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "וזהו החודש הזה לכם ראש חדשים ראשון הוא לכם לחדשי השנה,"
        },
        {
          "s": 1,
          "text": "שכללות הענין דהחודש הזה לכם"
        },
        {
          "s": 2,
          "text": "(משבחר ביעקב ובניו)"
        },
        {
          "s": 3,
          "text": "מורה על עבודתם של ישראל בכח עצמם,"
        },
        {
          "s": 4,
          "text": "אלא שבזה גופא ישנם ב' אופני עבודה שבהם תלויים ב' אופני ההנהגה בעולם,"
        },
        {
          "s": 5,
          "text": "הנהגה ניסית,"
        },
        {
          "s": 6,
          "text": "ענינו של ר\"ח ניסן,"
        },
        {
          "s": 7,
          "text": "ראש חודש של גאולה,"
        },
        {
          "s": 8,
          "text": "והנהגה טבעית,"
        },
        {
          "s": 9,
          "text": "ענינם של חדשי השנה,"
        },
        {
          "s": 10,
          "text": "ששנה מורה על הנהגה טבעית,"
        },
        {
          "s": 11,
          "text": "וחדשי השנה מורה על זה שההנהגה הטבעית תלוי' בעבודתם של ישראל,"
        },
        {
          "s": 12,
          "text": "החודש הזה לכם."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ויש להוסיף ולקשר זה עם המבואר בד\"ה והר סיני עשן תרכ\"ח57,"
        },
        {
          "s": 2,
          "text": "וז\"ל: עשן ר\"ת עולם שנה נפש,"
        },
        {
          "s": 3,
          "text": "ורבינו אאזמו\"ר זצ\"ל פי' ששנה הם י\"ב ר\"ח הם י\"ב גבולי אלכסוני' של המדות כמ\"ש מזה באורך בדרוש מחר חדש58,"
        },
        {
          "s": 4,
          "text": "ומסתמא שמע כן מהמגיד זצ\"ל59,"
        },
        {
          "s": 5,
          "text": "ועולם היא בחינת מדות בעצם,"
        },
        {
          "s": 6,
          "text": "והיינו ע\"ש כי אמרתי עולם חסד יבנה60,"
        },
        {
          "s": 7,
          "text": "וכתיב זכור רחמיך וחסדיך כי מעולם המה61,"
        },
        {
          "s": 8,
          "text": "שבחינת העולם הם מבחינת המדות,"
        },
        {
          "s": 9,
          "text": "ונפש הוא חיות העולם,"
        },
        {
          "s": 10,
          "text": "ונמצא מפרש שבחינת נפש גבוה מכולם,"
        },
        {
          "s": 11,
          "text": "עכ\"ל."
        },
        {
          "s": 12,
          "text": "והענין בזה,"
        },
        {
          "s": 13,
          "text": "שגם שנה קשורה עם ר\"ח,"
        },
        {
          "s": 14,
          "text": "שזהו\"ע די\"ב ראשי חדשים שבשנה,"
        },
        {
          "s": 15,
          "text": "אלא שהם י\"ב גבולי אלכסון של המדות,"
        },
        {
          "s": 16,
          "text": "היינו,"
        },
        {
          "s": 17,
          "text": "שאין זה בחינת המדות כמו שהם במקומם,"
        },
        {
          "s": 18,
          "text": "אלא כמו שהם בגבולי אלכסון,"
        },
        {
          "s": 19,
          "text": "וענינם בספירות הוא בחינת המלכות,"
        },
        {
          "s": 20,
          "text": "שרגלי' יורדות62"
        },
        {
          "s": 21,
          "text": "בבי\"ע,"
        },
        {
          "s": 22,
          "text": "וגם כמו שהוא באצילות הוא בבחינת שייכות לעולמות בי\"ע"
        },
        {
          "s": 23,
          "text": "(שזהו השרש דהנהגה טבעית)."
        },
        {
          "s": 24,
          "text": "ולמעלה מזה,"
        },
        {
          "s": 25,
          "text": "בחינת עולם,"
        },
        {
          "s": 26,
          "text": "בחינת מדות בעצם,"
        },
        {
          "s": 27,
          "text": "ז\"א,"
        },
        {
          "s": 28,
          "text": "שלמעלה מעולמות בי\"ע"
        },
        {
          "s": 29,
          "text": "(שזהו השרש להנהגה נסית)."
        },
        {
          "s": 30,
          "text": "ולמעלה מזה,"
        },
        {
          "s": 31,
          "text": "בחינת נפש,"
        },
        {
          "s": 32,
          "text": "ספירת הבינה,"
        },
        {
          "s": 33,
          "text": "שהיא חיות העולם ובמילא גם החיות דשנה"
        },
        {
          "s": 34,
          "text": "(שרומז על עבודתם של ישראל שבה תלויים ב' אופני ההנהגה דנס וטבע,"
        },
        {
          "s": 35,
          "text": "ז\"א ומלכות)."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ויש63 לומר בדרך אפשר,"
        },
        {
          "s": 2,
          "text": "שזה נרמז ג\"כ בג' הקריאות דשבת זה: פרשת ויקרא,"
        },
        {
          "s": 3,
          "text": "התחלת תורת כהנים,"
        },
        {
          "s": 4,
          "text": "דקאי על בני ישראל שעליהם נאמר64"
        },
        {
          "s": 5,
          "text": "ואתם תהיו לי ממלכת כהנים – בחינת נפש"
        },
        {
          "s": 6,
          "text": "(בינה)"
        },
        {
          "s": 7,
          "text": "; החודש הזה לכם,"
        },
        {
          "s": 8,
          "text": "הקריאה דפרשת החודש – ציווי דראש חודש בתורה,"
        },
        {
          "s": 9,
          "text": "אבל ברוב השנים אינו ביום דר\"ח בעולם – בחינת עולם שהיא בחינת מדות בעצם"
        },
        {
          "s": 10,
          "text": "(ז\"א,"
        },
        {
          "s": 11,
          "text": "שלמעלה מירידה לבי\"ע)"
        },
        {
          "s": 12,
          "text": "; ובראשי חדשיכם גו',"
        },
        {
          "s": 13,
          "text": "הקריאה דראש חודש – ר\"ח בעולם – בחינת שנה שהם י\"ב חדשים"
        },
        {
          "s": 14,
          "text": "(מלכות,"
        },
        {
          "s": 15,
          "text": "שרגלי' יורדות לבי\"ע)."
        },
        {
          "s": 16,
          "text": "וע\"פ הנ\"ל: ובראשי חדשיכם – מורה על הנהגה טבעית"
        },
        {
          "s": 17,
          "text": "(מלכות),"
        },
        {
          "s": 18,
          "text": "החודש הזה – מורה על הנהגה נסית"
        },
        {
          "s": 19,
          "text": "(ז\"א),"
        },
        {
          "s": 20,
          "text": "והקריאה דתורת כהנים,"
        },
        {
          "s": 21,
          "text": "ויקרא אל משה ולא נאמר מי הוא הקורא כו' – דלחד הפירושים הוא בחינת המקיף"
        },
        {
          "s": 22,
          "text": "(כתר65,"
        },
        {
          "s": 23,
          "text": "גם מקיף דבינה,"
        },
        {
          "s": 24,
          "text": "חופה על חתן וכלה,"
        },
        {
          "s": 25,
          "text": "זו\"ן ביחד66)"
        },
        {
          "s": 26,
          "text": "– עולם החירות."
        }
      ]
    }
  ]
}