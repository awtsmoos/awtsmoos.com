{
  "globalIndex": 797,
  "owner": 47,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918549_theRebbe_741__p003",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918549_theRebbe_741__p003",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918549_theRebbe_741",
  "title": "מאמר לה\"ע רשב\"י תשמ\"ה",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ועד\"ז הוא גם בענין השבחים דרשב\"י,"
        },
        {
          "s": 1,
          "text": "דזה שע\"י השבחים עוררו שיומשך השפע שלו"
        },
        {
          "s": 2,
          "text": "(בחינת איתן,"
        },
        {
          "s": 3,
          "text": "יחידה)"
        },
        {
          "s": 4,
          "text": "בלימוד התורה דהתנאים שהלימוד שלהם הי' לברר בירורים,"
        },
        {
          "s": 5,
          "text": "הוא מצד היתרון שבענין הבירורים"
        },
        {
          "s": 6,
          "text": "(על ענין הגילויים),"
        },
        {
          "s": 7,
          "text": "דהרצון והתענוג שלמעלה הוא בענין הבירורים דוקא."
        },
        {
          "s": 8,
          "text": "דזהו מ\"ש והאיתנים"
        },
        {
          "s": 9,
          "text": "(אותיות תנאים)"
        },
        {
          "s": 10,
          "text": "מוסדי ארץ,"
        },
        {
          "s": 11,
          "text": "ארץ מלשון רצון50,"
        },
        {
          "s": 12,
          "text": "ויתירה מזו שארץ שייך גם לתשוקה כמ\"ש51"
        },
        {
          "s": 13,
          "text": "פקדת הארץ ותשוקקי',"
        },
        {
          "s": 14,
          "text": "דהרצון ותשוקה ותענוג שלמעלה הוא בארץ דוקא,"
        },
        {
          "s": 15,
          "text": "בבירור דברים הגשמיים,"
        },
        {
          "s": 16,
          "text": "ובפרט בבירור הענינים דנזיקין,"
        },
        {
          "s": 17,
          "text": "שנעשה ע\"י האיתנים מוסדי ארץ52."
        },
        {
          "s": 18,
          "text": "וע\"י המשכת האור דפנימיות התורה שלמעלה מענין הבירורים,"
        },
        {
          "s": 19,
          "text": "תורתו של רשב\"י,"
        },
        {
          "s": 20,
          "text": "להאיתנים מוסדי ארץ"
        },
        {
          "s": 21,
          "text": "(שעי\"ז נמשך להם תוספות גם בענין הבירורים),"
        },
        {
          "s": 22,
          "text": "עי\"ז נעשה יתרון בהאור53,"
        },
        {
          "s": 23,
          "text": "כי יתרון האור הוא מן"
        },
        {
          "s": 24,
          "text": "(בירור)"
        },
        {
          "s": 25,
          "text": "החושך54."
        },
        {
          "s": 26,
          "text": "ולא עוד אלא שע\"י שנמשך להאיתנים מוסדי ארץ"
        },
        {
          "s": 27,
          "text": "(ענין הבירורים)"
        },
        {
          "s": 28,
          "text": "השפע דרשב\"י"
        },
        {
          "s": 29,
          "text": "(אור שלמעלה מענין הבירורים),"
        },
        {
          "s": 30,
          "text": "ישנם ב' המעלות,"
        },
        {
          "s": 31,
          "text": "המעלה דאור ישר והמעלה דאור חוזר,"
        },
        {
          "s": 32,
          "text": "וע\"ד לאתבא צדיקייא בתיובתא55,"
        },
        {
          "s": 33,
          "text": "המעלה דצדיקים והמעלה דבעלי תשובה."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ויש לקשר זה עם מאמר הזהר56"
        },
        {
          "s": 2,
          "text": "זמנא חדא הוה צריך עלמא למיטרא,"
        },
        {
          "s": 3,
          "text": "אתו לקמי' דר\"ש ר' ייסא ור' חזקי' ושאר חברייא,"
        },
        {
          "s": 4,
          "text": "וע\"י שדרש להם בפסוק57"
        },
        {
          "s": 5,
          "text": "הנה מה טוב ומה נעים שבת אחים גו' ירד מטר,"
        },
        {
          "s": 6,
          "text": "ומבואר בדרושי אדמו\"ר הצ\"צ58"
        },
        {
          "s": 7,
          "text": "ואדמו\"ר מהר\"ש59,"
        },
        {
          "s": 8,
          "text": "דהגם שרשב\"י המשיך ירידת הגשמים ע\"י אמירת תורה בדרך מלמעלה למטה,"
        },
        {
          "s": 9,
          "text": "מ\"מ הי' צריך לזה גם העלאת מ\"ן דהחברייא והשבחים ששיבחו אותו,"
        },
        {
          "s": 10,
          "text": "שעי\"ז פעלו יתרון ברשב\"י ע\"ד מתלמידי60"
        },
        {
          "s": 11,
          "text": "יותר מכולן."
        },
        {
          "s": 12,
          "text": "ויש לומר,"
        },
        {
          "s": 13,
          "text": "שהשייכות דענין זה לירידת גשמים היא,"
        },
        {
          "s": 14,
          "text": "כי במטר כתיב61"
        },
        {
          "s": 15,
          "text": "כי לא המטיר גו' ואדם אין לעבוד את האדמה,"
        },
        {
          "s": 16,
          "text": "דירידת המטר הוא ע\"י עבודת האדם,"
        },
        {
          "s": 17,
          "text": "ובפרט ע\"י עבודת התשובה כמארז\"ל62"
        },
        {
          "s": 18,
          "text": "עה\"פ63"
        },
        {
          "s": 19,
          "text": "יערוף כמטר לקחי גו' שברו הבריות את ערפן מיד מטר יורד,"
        },
        {
          "s": 20,
          "text": "ובירידת המטר ע\"י אמירת תורה דרשב\"י"
        },
        {
          "s": 21,
          "text": "(מלמעלה למטה)"
        },
        {
          "s": 22,
          "text": "והעלאת מ\"ן דתלמידיו"
        },
        {
          "s": 23,
          "text": "(מלמטה למעלה)"
        },
        {
          "s": 24,
          "text": "היו ב' המעלות,"
        },
        {
          "s": 25,
          "text": "המעלה דצדיקים והמעלה דבעלי תשובה."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ולכאורה יש להוסיף,"
        },
        {
          "s": 1,
          "text": "דהמשכת השפע דרשב\"י"
        },
        {
          "s": 2,
          "text": "(בחינת איתן,"
        },
        {
          "s": 3,
          "text": "יחידה)"
        },
        {
          "s": 4,
          "text": "להאיתנים מוסדי ארץ בשביל ענין הבירורים,"
        },
        {
          "s": 5,
          "text": "הוא ע\"ד המבואר במקום אחר64"
        },
        {
          "s": 6,
          "text": "בענין יחידה שבנפש,"
        },
        {
          "s": 7,
          "text": "דזה שהיחידה מתפשטת בד' אמותיו של אדם65,"
        },
        {
          "s": 8,
          "text": "שלכן66"
        },
        {
          "s": 9,
          "text": "ד' אמות של אדם קונות לו בכל מקום67"
        },
        {
          "s": 10,
          "text": "גם שלא מדעתו68,"
        },
        {
          "s": 11,
          "text": "הוא דוקא בכדי לקנות חפץ שמונח בהם69,"
        },
        {
          "s": 12,
          "text": "הקנאת דבר גשמי"
        },
        {
          "s": 13,
          "text": "(שמחוץ לאדם)"
        },
        {
          "s": 14,
          "text": "לרשותו של האדם,"
        },
        {
          "s": 15,
          "text": "בכדי לבררו ולזככו על ידי שישתמש בו לשם שמים,"
        },
        {
          "s": 16,
          "text": "כי הבירור דדברים גשמיים דוקא מגיע בהעצם."
        },
        {
          "s": 17,
          "text": "ועד\"ז הוא גם ביחידה דתורה"
        },
        {
          "s": 18,
          "text": "(תורת רשב\"י),"
        },
        {
          "s": 19,
          "text": "שהיא מתעוררת ונמשכת בשביל ענין הבירורים."
        }
      ]
    }
  ]
}