{
  "globalIndex": 1032,
  "owner": 32,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919889_theRebbe_263__p001",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919889_theRebbe_263__p001",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919889_theRebbe_263",
  "title": "מאמר והי' עקב תשמעון תשכ\"ז",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "והי' עקב תשמעון גו' ושמרתם ועשיתם אותם גו'1,"
        },
        {
          "s": 1,
          "text": "וידוע הדיוק בזה2,"
        },
        {
          "s": 2,
          "text": "הרי קיום התומ\"צ תלוי בבחירת האדם,"
        },
        {
          "s": 3,
          "text": "והול\"ל והי' אם תשמעון"
        },
        {
          "s": 4,
          "text": "[כמו אם3"
        },
        {
          "s": 5,
          "text": "בחוקותי תלכו,"
        },
        {
          "s": 6,
          "text": "והי'4"
        },
        {
          "s": 7,
          "text": "אם שמוע תשמעו],"
        },
        {
          "s": 8,
          "text": "ולמה אומר והי' עקב תשמעון,"
        },
        {
          "s": 9,
          "text": "דפי' הלשון הוא שודאי תשמעון."
        },
        {
          "s": 10,
          "text": "ומבאר אדמו\"ר הצמח צדק5"
        },
        {
          "s": 11,
          "text": "דעקב קאי על הזמן דעקבתא דמשיחא,"
        },
        {
          "s": 12,
          "text": "וזהו והי' עקב תשמעון,"
        },
        {
          "s": 13,
          "text": "תשמעון ודאי,"
        },
        {
          "s": 14,
          "text": "דהבטיחה תורה שסוף ישראל לעשות תשובה בסוף גלותן ומיד הן נגאלין6."
        },
        {
          "s": 15,
          "text": "וממשיך בהמאמר7,"
        },
        {
          "s": 16,
          "text": "דג' הלשונות,"
        },
        {
          "s": 17,
          "text": "תשמעון ושמרתם ועשיתם,"
        },
        {
          "s": 18,
          "text": "הם מחשבה דיבור ומעשה."
        },
        {
          "s": 19,
          "text": "תשמעון הוא מחשבה,"
        },
        {
          "s": 20,
          "text": "דעיקר השמיעה הוא במחשבה"
        },
        {
          "s": 21,
          "text": "(והאוזן אינו אלא כלי שעל ידו נכנס הקול במחשבתו),"
        },
        {
          "s": 22,
          "text": "ושמרתם הוא דיבור,"
        },
        {
          "s": 23,
          "text": "כי עיקר השמירה בפה כמ\"ש8"
        },
        {
          "s": 24,
          "text": "ערוכה בכל ושמורה,"
        },
        {
          "s": 25,
          "text": "ועשיתם מעשה."
        },
        {
          "s": 26,
          "text": "ועל זה ממשיך ואומר1"
        },
        {
          "s": 27,
          "text": "ושמר ה' אלקיך לך את הברית ואת החסד אשר נשבע גו',"
        },
        {
          "s": 28,
          "text": "ברית חסד ושבועה הם מחשבה דיבור ומעשה"
        },
        {
          "s": 29,
          "text": "(כמבואר שם בארוכה),"
        },
        {
          "s": 30,
          "text": "וע\"י תשמעון ושמרתם ועשיתם,"
        },
        {
          "s": 31,
          "text": "העבודה דמחשבה דיבור ומעשה של האדם,"
        },
        {
          "s": 32,
          "text": "נמשכים לו המחשבה דיבור ומעשה שלמעלה,"
        },
        {
          "s": 33,
          "text": "את הברית ואת החסד אשר נשבע."
        },
        {
          "s": 34,
          "text": "אמנם9"
        },
        {
          "s": 35,
          "text": "ענין זה"
        },
        {
          "s": 36,
          "text": "(שיומשך להאדם המחשבה דיבור ומעשה שלמעלה)"
        },
        {
          "s": 37,
          "text": "אינו מספיק עדיין,"
        },
        {
          "s": 38,
          "text": "שהרי גם לפני ירידת הנשמה למטה היתה בבחינה הכי עליונה שבזה,"
        },
        {
          "s": 39,
          "text": "המחשבה שלמעלה,"
        },
        {
          "s": 40,
          "text": "ישראל עלו במחשבה10,"
        },
        {
          "s": 41,
          "text": "וירידת הנשמה למטה היא לצורך עלי',"
        },
        {
          "s": 42,
          "text": "בכדי שע\"י עבודתה למטה תתעלה למדריגה נעלית יותר מכמו שהיתה קודם הירידה,"
        },
        {
          "s": 43,
          "text": "ועד בחינת ואתה11"
        },
        {
          "s": 44,
          "text": "משמרה בקרבי"
        },
        {
          "s": 45,
          "text": "(שלמעלה גם מבחי' טהורה11"
        },
        {
          "s": 46,
          "text": "היא)12."
        },
        {
          "s": 47,
          "text": "וזהו מ\"ש ושמר גו' את הברית ואת החסד אשר נשבע גו',"
        },
        {
          "s": 48,
          "text": "דע\"י עקב תשמעון ושמרתם ועשיתם,"
        },
        {
          "s": 49,
          "text": "העבודה דמחשבה דיבור ומעשה בהעקב דנשמה דקאי על הנשמה שבגוף13,"
        },
        {
          "s": 50,
          "text": "ובפרט בעקבתא דמשיחא"
        },
        {
          "s": 51,
          "text": "[הוספה בהירידה,"
        },
        {
          "s": 52,
          "text": "ובמילא,"
        },
        {
          "s": 53,
          "text": "גם בהעלי' שע\"י הירידה],"
        },
        {
          "s": 54,
          "text": "שע\"י הירידה בגוף ונה\"ב"
        },
        {
          "s": 55,
          "text": "(ובפרט בגלות),"
        },
        {
          "s": 56,
          "text": "העבודה דמחשבה דיבור ומעשה של הנשמה היא ברעו\"ד ובאופן דמס\"נ"
        },
        {
          "s": 57,
          "text": "(למעלה מהשתל'),"
        },
        {
          "s": 58,
          "text": "עי\"ז יהי' ושמר גו' את הברית ואת החסד אשר נשבע גו'"
        },
        {
          "s": 59,
          "text": "(ושמר דייקא),"
        },
        {
          "s": 60,
          "text": "שהמחשבה דיבור ומעשה שלמעלה יהי' בהם הגילוי דואתה משמרה בקרבי,"
        },
        {
          "s": 61,
          "text": "דבכללות הו\"ע12"
        },
        {
          "s": 62,
          "text": "גילוי העצמות."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה פירוש הנ\"ל"
        },
        {
          "s": 2,
          "text": "(דאדמו\"ר הצ\"צ)"
        },
        {
          "s": 3,
          "text": "בוהי' עקב תשמעון"
        },
        {
          "s": 4,
          "text": "(שעקב הוא מלשון סוף וקאי על אחרית הימים14)"
        },
        {
          "s": 5,
          "text": "יש לקשר עם מאמר המדרש15"
        },
        {
          "s": 6,
          "text": "עה\"פ,"
        },
        {
          "s": 7,
          "text": "אמר להם הקב\"ה כו' שכרו"
        },
        {
          "s": 8,
          "text": "(שכר המצוות)"
        },
        {
          "s": 9,
          "text": "בעקב אני נותן לכם כו'"
        },
        {
          "s": 10,
          "text": "(שנאמר)"
        },
        {
          "s": 11,
          "text": "והי' עקב תשמעון."
        },
        {
          "s": 12,
          "text": "אלא שע\"פ המדרש שאיירי בשכר המצוות,"
        },
        {
          "s": 13,
          "text": "הכוונה בעקב"
        },
        {
          "s": 14,
          "text": "(אחרית הימים)"
        },
        {
          "s": 15,
          "text": "היא להזמן שלאחרי ביאת המשיח,"
        },
        {
          "s": 16,
          "text": "ולפי פשטות הענין שאיירי בקיום המצוות"
        },
        {
          "s": 17,
          "text": "(תשמעון גו' ושמרתם ועשיתם אותם),"
        },
        {
          "s": 18,
          "text": "הכוונה בעקב"
        },
        {
          "s": 19,
          "text": "(אחרית הימים)"
        },
        {
          "s": 20,
          "text": "היא לסוף זמן הגלות,"
        },
        {
          "s": 21,
          "text": "עקבתא דמשיחא."
        },
        {
          "s": 22,
          "text": "והקשר דשני הפירושים הוא16,"
        },
        {
          "s": 23,
          "text": "כי שכר המצוות שיהי' בעקב"
        },
        {
          "s": 24,
          "text": "(לע\"ל)"
        },
        {
          "s": 25,
          "text": "הוא שאז יהי' גילוי העצמות,"
        },
        {
          "s": 26,
          "text": "כמבואר בתניא17."
        },
        {
          "s": 27,
          "text": "וכיון שגילוי זה הוא ע\"י העבודה"
        },
        {
          "s": 28,
          "text": "(דתומ\"צ באופן)"
        },
        {
          "s": 29,
          "text": "דמס\"נ"
        },
        {
          "s": 30,
          "text": "(כנ\"ל),"
        },
        {
          "s": 31,
          "text": "לכן,"
        },
        {
          "s": 32,
          "text": "ע\"י עקב תשמעון כפירוש הצ\"צ,"
        },
        {
          "s": 33,
          "text": "העבודה בעקבתא דמשיחא,"
        },
        {
          "s": 34,
          "text": "שאז המס\"נ הוא ביותר18,"
        },
        {
          "s": 35,
          "text": "עי\"ז יהי' הגילוי דלע\"ל,"
        },
        {
          "s": 36,
          "text": "בעקב אני נותן לכם."
        }
      ]
    }
  ]
}