{
  "globalIndex": 754,
  "owner": 4,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918187_theRebbe_312__p001",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918187_theRebbe_312__p001",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518918187_theRebbe_312",
  "title": "מאמר החודש הזה לכם תשל\"א",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ ויקרא,"
        },
        {
          "s": 2,
          "text": "פרשת החודש,"
        },
        {
          "s": 3,
          "text": "ראש חודש ניסן,"
        },
        {
          "s": 4,
          "text": "ה'תשל\"א"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "(הנחה)"
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "החודש1 הזה לכם ראש חדשים ראשון הוא לכם לחדשי השנה2."
        },
        {
          "s": 1,
          "text": "והנה3"
        },
        {
          "s": 2,
          "text": "ידוע מאמר האבן עזרא4"
        },
        {
          "s": 3,
          "text": "אין ללבנה שנה כלל כאשר אין לשמש חודש כלל."
        },
        {
          "s": 4,
          "text": "והיינו,"
        },
        {
          "s": 5,
          "text": "שחלוקת הזמן דשנה שייכת לחמה,"
        },
        {
          "s": 6,
          "text": "שבמשך שנה החמה הולכת וסובבת עד שחוזרת למקומה הראשון,"
        },
        {
          "s": 7,
          "text": "ואז חוזרת וסובבת עוד הפעם כו',"
        },
        {
          "s": 8,
          "text": "ולכן נקראת שנה מלשון משנה"
        },
        {
          "s": 9,
          "text": "(שאותו הדבר חוזר ונשנה עוד הפעם),"
        },
        {
          "s": 10,
          "text": "אבל מחודש לחודש לא נשתנה מאומה בהילוכה."
        },
        {
          "s": 11,
          "text": "וחלוקת הזמן דחודש שייכת ללבנה,"
        },
        {
          "s": 12,
          "text": "שהילוכה עד שובה אל הנקודה הראשונה הוא במשך חודש,"
        },
        {
          "s": 13,
          "text": "אבל משנה לשנה לא נשתנה מאומה בהילוכה."
        },
        {
          "s": 14,
          "text": "ועפ\"ז צריך להבין מש\"נ החודש גו' לחדשי השנה,"
        },
        {
          "s": 15,
          "text": "שמזכיר הענין דשנה ביחס לחדשים."
        },
        {
          "s": 16,
          "text": "גם צריך להבין5"
        },
        {
          "s": 17,
          "text": "מש\"נ על ר\"ח ניסן החודש הזה לכם ראש חדשים ראשון הוא גו',"
        },
        {
          "s": 18,
          "text": "והלא א' בתשרי הוא ראש השנה."
        },
        {
          "s": 19,
          "text": "וכמבואר בלקו\"ת6"
        },
        {
          "s": 20,
          "text": "הדיוק דראש השנה"
        },
        {
          "s": 21,
          "text": "(ולא תחילת השנה),"
        },
        {
          "s": 22,
          "text": "שכשם שהראש כולל החיות דכל אברי הגוף,"
        },
        {
          "s": 23,
          "text": "כך ראש השנה כולל החיות דכל השנה,"
        },
        {
          "s": 24,
          "text": "דאף שישנו חידוש החיות בכל יום,"
        },
        {
          "s": 25,
          "text": "כמאמר7"
        },
        {
          "s": 26,
          "text": "המחדש בטובו בכל יום תמיד מעשה בראשית,"
        },
        {
          "s": 27,
          "text": "ולא רק בכל יום אלא גם בכל רגע8,"
        },
        {
          "s": 28,
          "text": "מ\"מ,"
        },
        {
          "s": 29,
          "text": "יש סדר מסודר בהמשכת וחידוש החיות,"
        },
        {
          "s": 30,
          "text": "שבתחילה היא המשכת החיות הכללית בראש השנה,"
        },
        {
          "s": 31,
          "text": "ונחלקת אח\"כ לי\"ב ראשי חדשים,"
        },
        {
          "s": 32,
          "text": "ומר\"ח נמשך לכל ימי החודש."
        },
        {
          "s": 33,
          "text": "ומבואר בארוכה ובפרטיות יותר בעטרת ראש9,"
        },
        {
          "s": 34,
          "text": "שישנם ב' ענינים בראש,"
        },
        {
          "s": 35,
          "text": "הא',"
        },
        {
          "s": 36,
          "text": "שהחיות דכל אברי הגוף כלול תחילה בהראש וממנו נמשך לכל האברים,"
        },
        {
          "s": 37,
          "text": "והב',"
        },
        {
          "s": 38,
          "text": "שגם לאחרי שכבר נמשך החיות לכל האברים פרטיים הנה הראש הוא מנהיגם,"
        },
        {
          "s": 39,
          "text": "וכמבואר בתניא10"
        },
        {
          "s": 40,
          "text": "דגם עכשיו"
        },
        {
          "s": 41,
          "text": "(לאחרי המשכת החיות מהראש לכל האברים)"
        },
        {
          "s": 42,
          "text": "יניקת הצפרנים נמשכת מהמוח שבראש,"
        },
        {
          "s": 43,
          "text": "וב' ענינים אלו ישנם גם בראש השנה."
        },
        {
          "s": 44,
          "text": "ועפ\"ז צריך להבין מהו אומרו שר\"ח ניסן הוא ראש חדשים ראשון"
        },
        {
          "s": 45,
          "text": "(ראשון גם מלשון ראש)"
        },
        {
          "s": 46,
          "text": "הוא לחדשי השנה,"
        },
        {
          "s": 47,
          "text": "היינו,"
        },
        {
          "s": 48,
          "text": "שר\"ח ניסן הוא בדוגמת הענינים שבמשל הראש כפשוטו,"
        },
        {
          "s": 49,
          "text": "הרי הענין דראש השנה הוא בא' בתשרי."
        }
      ]
    }
  ]
}