{
  "globalIndex": 526,
  "owner": 26,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916815_theRebbe_81__p009",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916815_theRebbe_81__p009",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916815_theRebbe_81",
  "title": "מאמר באתי לגני תש\"ל",
  "part": 9,
  "sections": [
    {
      "v": 24,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ד)"
        },
        {
          "s": 2,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 3,
          "text": "דיצרו של אדם מתגבר עליו להטרידו ולבלבלו בעת העבודה דוקא."
        },
        {
          "s": 4,
          "text": "וכמו שנראה במוחש,"
        },
        {
          "s": 5,
          "text": "שדוקא בעת העבודה דתורה ותפלה או בקיום איזה מצוה,"
        },
        {
          "s": 6,
          "text": "אז נדמה לו,"
        },
        {
          "s": 7,
          "text": "אשר דוקא בשעה זו הוא צריך לעשות איזה ענין שנוגע לו ביותר."
        },
        {
          "s": 8,
          "text": "דמחשבות אלו דנה\"ב הם בכדי לבלבל את הנפש האלקית."
        },
        {
          "s": 9,
          "text": "והראי',"
        },
        {
          "s": 10,
          "text": "שבזמנים אחרים אין נופלים לו מחשבות כאלו."
        },
        {
          "s": 11,
          "text": "וע\"פ מה שנתבאר לעיל"
        },
        {
          "s": 12,
          "text": "(סעיף ז וסעיף יו\"ד)"
        },
        {
          "s": 13,
          "text": "שהענינים שבאדם"
        },
        {
          "s": 14,
          "text": "(המבוארים בפרק העשרים)"
        },
        {
          "s": 15,
          "text": "הם השרש דענינים אלו שבעולם"
        },
        {
          "s": 16,
          "text": "(המבוארים בפרקים הקודמים),"
        },
        {
          "s": 17,
          "text": "יש לומר,"
        },
        {
          "s": 18,
          "text": "דזה שמחשבות אלו מתקבלות בהאדם,"
        },
        {
          "s": 19,
          "text": "דהגם שרואה שמחשבות אלו נופלים דוקא בעת העבודה"
        },
        {
          "s": 20,
          "text": "[שמזה צריך להבין גם מצד השכל דנפש הבהמית שמחשבות אלו הם רק בכדי לבלבלו מתורה ועבודה]"
        },
        {
          "s": 21,
          "text": "ואעפ\"כ המחשבות מתקבלים אצלו,"
        },
        {
          "s": 22,
          "text": "הוא ענין השקר שבאדם,"
        },
        {
          "s": 23,
          "text": "שממנו משתלשל השקר דעולם,"
        },
        {
          "s": 24,
          "text": "מה שהעולם מראה את עצמו למציאות"
        },
        {
          "s": 25,
          "text": "(המבואר בפרקים הקודמים)."
        }
      ]
    },
    {
      "v": 25,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ו)"
        },
        {
          "s": 2,
          "text": "והנה ידוע מ\"ש אדמו\"ר מהר\"ש בהמשך מים רבים"
        },
        {
          "s": 3,
          "text": "(תרל\"ו)"
        },
        {
          "s": 4,
          "text": "בתחלתו,"
        },
        {
          "s": 5,
          "text": "עה\"פ108"
        },
        {
          "s": 6,
          "text": "אולת אדם תסלף דרכו ועל ה' יזעף לבו,"
        },
        {
          "s": 7,
          "text": "שכל הרעות הבאות לאדם,"
        },
        {
          "s": 8,
          "text": "הוא עצמו גרם לזה."
        },
        {
          "s": 9,
          "text": "וכמו אדם המסכן עצמו עבור מותרות,"
        },
        {
          "s": 10,
          "text": "דכאשר קורה לו אסון,"
        },
        {
          "s": 11,
          "text": "ה\"ה עצמו גרם לזה,"
        },
        {
          "s": 12,
          "text": "כיון שהי' יכול להסתפק בלחם לאכול ובגד ללבוש."
        },
        {
          "s": 13,
          "text": "ויתירה מזו,"
        },
        {
          "s": 14,
          "text": "שאפילו באם רוצה עשירות,"
        },
        {
          "s": 15,
          "text": "באם הי' יודע"
        },
        {
          "s": 16,
          "text": "(וזה הי' מונח אצלו)"
        },
        {
          "s": 17,
          "text": "שברכת ה' היא תעשיר109,"
        },
        {
          "s": 18,
          "text": "וזה שצריך גם לעשי' בדרך הטבע כמ\"ש110"
        },
        {
          "s": 19,
          "text": "וברכך הוי' אלקיך בכל אשר תעשה הוא רק מפני שרצה הקב\"ה שהברכה"
        },
        {
          "s": 20,
          "text": "(שלמעלה)"
        },
        {
          "s": 21,
          "text": "תומשך ע\"י לבושי הטבע,"
        },
        {
          "s": 22,
          "text": "אזי היתה העשי' שלו רק באופן דיגיע כפיך111,"
        },
        {
          "s": 23,
          "text": "יגיעת כפים ושאר אברים החיצונים ולא יגיעת המוח והלב112,"
        },
        {
          "s": 24,
          "text": "ומכ\"ש שלא הי' מסכן עצמו עבור זה."
        },
        {
          "s": 25,
          "text": "ויש לקשר זה עם המבואר בהמשך הנ\"ל בתחלתו113"
        },
        {
          "s": 26,
          "text": "שמים רבים הם טרדות הפרנסה והמחשבות שבעניני עוה\"ז,"
        },
        {
          "s": 27,
          "text": "דזה שאולת אדם תסלף דרכו גו' כי רעות הבאות לאדם הוא עצמו גרם לזה,"
        },
        {
          "s": 28,
          "text": "קאי גם על מים רבים הנ\"ל."
        },
        {
          "s": 29,
          "text": "דזה שהמחשבות בעניני פרנסה מטרידים אותו,"
        },
        {
          "s": 30,
          "text": "ועד שמשום זה אינו יכול לעסוק בתורה ועבודה,"
        },
        {
          "s": 31,
          "text": "הוא עצמו גרם לזה."
        },
        {
          "s": 32,
          "text": "דבאם הי' מתבונן כדבעי דברכת ה' היא תעשיר,"
        },
        {
          "s": 33,
          "text": "המחשבות בעניני פרנסה לא היו מטרידים אותו."
        },
        {
          "s": 34,
          "text": "ועד\"ז הוא בנוגע לכל המחשבות המטרידים את האדם ומבלבלים אותו מתורה ועבודה,"
        },
        {
          "s": 35,
          "text": "שברובם,"
        },
        {
          "s": 36,
          "text": "הוא ע\"י שהאדם הביא עצמו לזה."
        },
        {
          "s": 37,
          "text": "והיינו שמצד ההעלם וההסתר דהעולם,"
        },
        {
          "s": 38,
          "text": "כולל גם ההעלם וההסתר דהגוף ודנפש הבהמית,"
        },
        {
          "s": 39,
          "text": "כמו שהוא מצד עצמו,"
        },
        {
          "s": 40,
          "text": "גם לאחרי הירידה דחטא עה\"ד וגם בזמן הגלות,"
        },
        {
          "s": 41,
          "text": "לא הי' מעלים ומסתיר כ\"כ,"
        },
        {
          "s": 42,
          "text": "ועיקר ההעלם וההסתר הוא ע\"י שהאדם עצמו גרם לזה."
        },
        {
          "s": 43,
          "text": "ומזה מובן במכ\"ש בנוגע להמחשבות הנ\"ל"
        },
        {
          "s": 44,
          "text": "(סעיף יד)"
        },
        {
          "s": 45,
          "text": "שנופלים להאדם בשעת התורה והתפלה,"
        },
        {
          "s": 46,
          "text": "שבאם הי' עושה חשבון דזה שהם נופלים בשעת העבודה דוקא הוא כי כל ענינם הוא לבלבלו מתורה ועבודה,"
        },
        {
          "s": 47,
          "text": "אזי,"
        },
        {
          "s": 48,
          "text": "לא רק שמחשבות כאלו לא היו מתקבלים אצלו אלא שגם לא היו נופלים לו מלכתחילה."
        }
      ]
    },
    {
      "v": 26,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ז)"
        },
        {
          "s": 2,
          "text": "והנה גם כשהאדם הביא עצמו לידי מצב כזה,"
        },
        {
          "s": 3,
          "text": "שאז העבודה אצלו היא קשה עוד יותר,"
        },
        {
          "s": 4,
          "text": "הנה ע\"י עבודת התפלה יש לו הנתינת כח להתגבר."
        },
        {
          "s": 5,
          "text": "וכיון שכל הענינים הם מדה כנגד מדה,"
        },
        {
          "s": 6,
          "text": "הנה גם עבודת התפלה עצמה באה ע\"י יגיעה גדולה ועצומה."
        },
        {
          "s": 7,
          "text": "הן בנוגע לההתבוננות שבתפלה עצמה,"
        },
        {
          "s": 8,
          "text": "שהיא יגיעה רבה כמבואר בתניא114,"
        },
        {
          "s": 9,
          "text": "ובפרט שההתבוננות צריכה להיות התבוננות פרטית דוקא,"
        },
        {
          "s": 10,
          "text": "שמצד זה תכבד עליו העבודה עוד יותר,"
        },
        {
          "s": 11,
          "text": "כמו שמבאר אדמו\"ר"
        },
        {
          "s": 12,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 13,
          "text": "נ\"ע בקונטרס העבודה115."
        },
        {
          "s": 14,
          "text": "והן בנוגע לההכנה שלפני התפלה,"
        },
        {
          "s": 15,
          "text": "כמו שמבאר אדמו\"ר"
        },
        {
          "s": 16,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 17,
          "text": "נ\"ע בקונטרס התפלה116,"
        },
        {
          "s": 18,
          "text": "שקודם התפלה צריך להתייגע להסיר מדעתו כל טרדא שלא יטריד ויבלבל אותו בתפלה."
        },
        {
          "s": 19,
          "text": "ומבאר שם,"
        },
        {
          "s": 20,
          "text": "שגם אלו שנדמה להם שאינם יכולים להסיר הטרדות מלבם,"
        },
        {
          "s": 21,
          "text": "הנה בשומם אל לבם דכשהולכים לישון הם מסירים את הטרדות והדאגות,"
        },
        {
          "s": 22,
          "text": "ובאם בשביל ענין גשמי המוכרח להגוף ביכלתו להסיר הטרדות,"
        },
        {
          "s": 23,
          "text": "מכ\"ש שביכלתם לפעול זאת בדבר הנוגע לנפשם."
        }
      ]
    }
  ]
}