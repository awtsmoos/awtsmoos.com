{
  "globalIndex": 432,
  "owner": 32,
  "jobId": "_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916210_theRebbe_473__p003",
  "batchId": "meluket-_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916210_theRebbe_473__p003",
  "seriesId": "טבת_meluket",
  "postId": "BH_POST_1766518916210_theRebbe_473",
  "title": "מאמר יהודה אתה יודוך תשל\"ח",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ובחי' לוי על שם ילוה אישי אלי11"
        },
        {
          "s": 1,
          "text": "הוא מה שאחר ק\"ש אומרים אמת ויציב וכו' הדבר הזה עלינו,"
        },
        {
          "s": 2,
          "text": "הדבר הזה קאי על התורה,"
        },
        {
          "s": 3,
          "text": "כי ע\"י התורה נעשה ילוה אישי אלי"
        },
        {
          "s": 4,
          "text": "(כדלקמן)."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "וביאור הענין,"
        },
        {
          "s": 2,
          "text": "הנה ג' בחינות הנ\"ל"
        },
        {
          "s": 3,
          "text": "(ראובן שמעון ולוי)"
        },
        {
          "s": 4,
          "text": "הם ג' הקוין שעליהם העולם עומד12"
        },
        {
          "s": 5,
          "text": "[גם העולם קטן זה האדם13,"
        },
        {
          "s": 6,
          "text": "אתם קרויין אדם14]"
        },
        {
          "s": 7,
          "text": "תורה עבודה וגמ\"ח."
        },
        {
          "s": 8,
          "text": "בחי' ראובן"
        },
        {
          "s": 9,
          "text": "(אהבה)"
        },
        {
          "s": 10,
          "text": "הוא קו הגמ\"ח."
        },
        {
          "s": 11,
          "text": "כי כאשר יש לו אהבת ה' יש לו גם אהבת ישראל"
        },
        {
          "s": 12,
          "text": "[שהרי אהבת ה' ואהבת ישראל הם כולא חד15],"
        },
        {
          "s": 13,
          "text": "ולכן,"
        },
        {
          "s": 14,
          "text": "עבודתו היא בקו הגמ\"ח,"
        },
        {
          "s": 15,
          "text": "כי אהבה היא16"
        },
        {
          "s": 16,
          "text": "סיבת החסד ופנימיותה,"
        },
        {
          "s": 17,
          "text": "המשכה מלמעלמ\"ט."
        },
        {
          "s": 18,
          "text": "ובחי' שמעון"
        },
        {
          "s": 19,
          "text": "(יראה)"
        },
        {
          "s": 20,
          "text": "הוא קו העבודה,"
        },
        {
          "s": 21,
          "text": "ענין התפלה,"
        },
        {
          "s": 22,
          "text": "קו השמאל"
        },
        {
          "s": 23,
          "text": "[ובתפלה גופא הו\"ע פרשה שני' דק\"ש,"
        },
        {
          "s": 24,
          "text": "כנ\"ל],"
        },
        {
          "s": 25,
          "text": "העלאה מלמטלמ\"ע."
        },
        {
          "s": 26,
          "text": "ובחי' לוי על שם ילוה אישי אלי הוא קו התורה,"
        },
        {
          "s": 27,
          "text": "כי ע\"י אורייתא ישראל וקוב\"ה כולא חד17."
        },
        {
          "s": 28,
          "text": "וזהו\"ע ילוה אישי אלי,"
        },
        {
          "s": 29,
          "text": "כי ע\"י התורה נעשה חיבור עם אישי זה הקב\"ה,"
        },
        {
          "s": 30,
          "text": "עד שישראל וקוב\"ה כולא חד."
        },
        {
          "s": 31,
          "text": "וזהו מה שבחי' לוי הו\"ע אמת ויציב כו' הדבר הזה שקאי"
        },
        {
          "s": 32,
          "text": "(כנ\"ל)"
        },
        {
          "s": 33,
          "text": "על התורה."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וזהו יהודה אתה יודוך אחיך,"
        },
        {
          "s": 2,
          "text": "שהעבודה דבחי'"
        },
        {
          "s": 3,
          "text": "(אחיך)"
        },
        {
          "s": 4,
          "text": "ראובן שמעון ולוי,"
        },
        {
          "s": 5,
          "text": "ב' פרשיות דק\"ש ואמת ויציב,"
        },
        {
          "s": 6,
          "text": "היא הקדמה והכנה לבחי' יהודה,"
        },
        {
          "s": 7,
          "text": "העבודה דשמו\"ע,"
        },
        {
          "s": 8,
          "text": "הודי' וביטול,"
        },
        {
          "s": 9,
          "text": "כעבדא קמי' מרי'18."
        },
        {
          "s": 10,
          "text": "שהביטול דתפלת העמידה הוא ביטול בתכלית למעלה גם מהביטול דק\"ש."
        },
        {
          "s": 11,
          "text": "וכמובן גם מחילוקי הדינים"
        },
        {
          "s": 12,
          "text": "(בענין הפסק וכו')"
        },
        {
          "s": 13,
          "text": "בין ק\"ש לשמו\"ע19."
        },
        {
          "s": 14,
          "text": "וענין זה"
        },
        {
          "s": 15,
          "text": "[מה שע\"י העבודה דבחי' ראובן שמעון ולוי מגיעים אח\"כ לבחי' יהודה"
        },
        {
          "s": 16,
          "text": "(בן הרביעי)]"
        },
        {
          "s": 17,
          "text": "הוא ע\"ד הידוע20"
        },
        {
          "s": 18,
          "text": "בענין ג' הכתרים"
        },
        {
          "s": 19,
          "text": "[כתר תורה כתר כהונה וכתר מלכות,"
        },
        {
          "s": 20,
          "text": "שהם בג' הקוין תורה עבודה וגמ\"ח21]"
        },
        {
          "s": 21,
          "text": "וכתר שם טוב שעולה על גביהן22"
        },
        {
          "s": 22,
          "text": "[שהוא למעלה מהם],"
        },
        {
          "s": 23,
          "text": "שבכדי להגיע לבחי' כתר שם טוב הוא ע\"י ג' הכתרים,"
        },
        {
          "s": 24,
          "text": "עולה על גביהן."
        }
      ]
    }
  ]
}