{
  "globalIndex": 267,
  "owner": 17,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915304_theRebbe_180__p013",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915304_theRebbe_180__p013",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915304_theRebbe_180",
  "title": "מאמר ושבתי בשלום תשל\"ח",
  "part": 13,
  "sections": [
    {
      "v": 36,
      "items": [
        {
          "s": 0,
          "text": "כ)"
        },
        {
          "s": 1,
          "text": "ח)"
        },
        {
          "s": 2,
          "text": "וזהו ושבתי בשלום אל בית אבי,"
        },
        {
          "s": 3,
          "text": "שקאי"
        },
        {
          "s": 4,
          "text": "(כנ\"ל)"
        },
        {
          "s": 5,
          "text": "על עבודת הבירורים,"
        },
        {
          "s": 6,
          "text": "שעי\"ז נעשה"
        },
        {
          "s": 7,
          "text": "(טוט זיך אויף)"
        },
        {
          "s": 8,
          "text": "ענין ושבתי בשלום גו' שיהי' לעתיד עד והאבן הזאת גו' יהי' בית אלקים."
        },
        {
          "s": 9,
          "text": "וזה גופא מורה על גודל העילוי שבהעבודה דסוף זמן הגלות,"
        },
        {
          "s": 10,
          "text": "שעיקר העבודה אז היא עבודת התשובה"
        },
        {
          "s": 11,
          "text": "(ועד שגם העבודה דתורה ומצוות"
        },
        {
          "s": 12,
          "text": "(לחם ובגד)"
        },
        {
          "s": 13,
          "text": "שבסוף זמן הגלות היא לאחרי קדימת עבודת התשובה"
        },
        {
          "s": 14,
          "text": "(ושבתי בשלום)205),"
        },
        {
          "s": 15,
          "text": "שהרי ע\"י העבודה דתשובה ומעשים טובים"
        },
        {
          "s": 16,
          "text": "(היינו שגם המעשים טובים הם לאחרי קדימת התשובה206)"
        },
        {
          "s": 17,
          "text": "נעשה"
        },
        {
          "s": 18,
          "text": "(טוט זיך אויף)"
        },
        {
          "s": 19,
          "text": "ענין ושבתי בשלום גו' שיהי' לע\"ל."
        },
        {
          "s": 20,
          "text": "[ועד שיפה שעה אחת בתשובה ומעשים טובים בעוה\"ז מכל חיי העוה\"ב207,"
        },
        {
          "s": 21,
          "text": "לפי שגורם הדבר חזק יותר מהנעשה על ידו."
        },
        {
          "s": 22,
          "text": "וגם לפי שהתענוג דעוה\"ב הוא תענוג האדם שהוא נברא,"
        },
        {
          "s": 23,
          "text": "והתענוג דתשובה ומע\"ט"
        },
        {
          "s": 24,
          "text": "(בעוה\"ז)"
        },
        {
          "s": 25,
          "text": "הוא תענוג הבורא208]."
        },
        {
          "s": 26,
          "text": "ובפרט,"
        },
        {
          "s": 27,
          "text": "שזה שע\"י העבודה דעכשיו טוט זיך אויף הגילוי דלעתיד הוא באופן שמעין הגילוי דלעתיד יש גם עכשיו"
        },
        {
          "s": 28,
          "text": "(כנ\"ל סעיף כד-כה)."
        },
        {
          "s": 29,
          "text": "דמכיון שהעבודה שבסוף זמן הגלות היא עבודת התשובה,"
        },
        {
          "s": 30,
          "text": "ובבע\"ת נאמר142"
        },
        {
          "s": 31,
          "text": "והי' טרם יקראו ואני אענה140,"
        },
        {
          "s": 32,
          "text": "לכן,"
        },
        {
          "s": 33,
          "text": "גם בסוף זמן הגלות"
        },
        {
          "s": 34,
          "text": "[ובפרט כשיש גם התפלה"
        },
        {
          "s": 35,
          "text": "(\"יקראו\")"
        },
        {
          "s": 36,
          "text": "ושבתי בשלום]"
        },
        {
          "s": 37,
          "text": "נעשה כבר ואני אענה,"
        },
        {
          "s": 38,
          "text": "המשכת וגילוי מעין הענינים דלעתיד."
        },
        {
          "s": 39,
          "text": "ובדוגמת יעקב,"
        },
        {
          "s": 40,
          "text": "שבהיותו עדיין בחרן הי' ויפרוץ האיש מאד מאד ויהי לו צאן רבות"
        },
        {
          "s": 41,
          "text": "(שזהו העיקר110)"
        },
        {
          "s": 42,
          "text": "ושפחות ועבדים וגמלים וחמורים111,"
        },
        {
          "s": 43,
          "text": "עד\"ז הוא בכאו\"א מישראל,"
        },
        {
          "s": 44,
          "text": "שבסוף זמן הגלות"
        },
        {
          "s": 45,
          "text": "(כשנמצאים בחרן)"
        },
        {
          "s": 46,
          "text": "יהי' ויפרוץ מאד מאד,"
        },
        {
          "s": 47,
          "text": "ובאופן דפדה בשלום,"
        },
        {
          "s": 48,
          "text": "בכל הפירושים ובכל הפרטים,"
        },
        {
          "s": 49,
          "text": "הן בעבודה הרוחנית"
        },
        {
          "s": 50,
          "text": "[ובפרט בלימוד והפצת תורת החסידות,"
        },
        {
          "s": 51,
          "text": "שיהי' בלי שום בלבולים ובתכלית ההרחבה]"
        },
        {
          "s": 52,
          "text": "והן בענינים הגשמיים,"
        },
        {
          "s": 53,
          "text": "ובאופן דופרצת209"
        },
        {
          "s": 54,
          "text": "(ויפרוץ),"
        },
        {
          "s": 55,
          "text": "שזה ימהר ויזרז הגאולה העתידה – אחישנה"
        },
        {
          "s": 56,
          "text": "(באחישנה גופא210),"
        },
        {
          "s": 57,
          "text": "שבקרוב ממש יהי' קץ שם לחושך211,"
        },
        {
          "s": 58,
          "text": "ויקבלו פני משיח צדקנו,"
        },
        {
          "s": 59,
          "text": "שיוליכנו לארצנו הקדושה,"
        },
        {
          "s": 60,
          "text": "ארץ אשר גו' תמיד עיני ה' אלקיך בה מרשית השנה ועד אחרית שנה212,"
        },
        {
          "s": 61,
          "text": "ארץ ישראל לגבולותי',"
        },
        {
          "s": 62,
          "text": "ואח\"כ – וגם זה באופן דאחישנה – ירחיב ה' אלקיך את גבולך213,"
        },
        {
          "s": 63,
          "text": "ובקרוב ממש ובעגלא דידן214."
        }
      ]
    }
  ]
}