{
  "globalIndex": 554,
  "owner": 4,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916949_theRebbe_558__p001",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916949_theRebbe_558__p001",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916949_theRebbe_558",
  "title": "מאמר באתי לגני תש\"מ",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "יו\"ד שבט ה'תש\"מ*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "הנחה"
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "באתי לגני אחותי כלה1,"
        },
        {
          "s": 1,
          "text": "ומביא ע\"ז כ\"ק מו\"ח אדמו\"ר בעל ההילולא במאמרו ליום ההסתלקות וההילולא שלו,"
        },
        {
          "s": 2,
          "text": "דאיתא במדרש רבה2"
        },
        {
          "s": 3,
          "text": "לגני לגנוני,"
        },
        {
          "s": 4,
          "text": "למקום שהי' עיקרי"
        },
        {
          "s": 5,
          "text": "[היינו עיקר דירתי]"
        },
        {
          "s": 6,
          "text": "בתחלה,"
        },
        {
          "s": 7,
          "text": "דעיקר שכינה בתחתונים היתה,"
        },
        {
          "s": 8,
          "text": "וע\"י ז' הענינים הבלתי רצויים נסתלקה השכינה מלמטה למעלה,"
        },
        {
          "s": 9,
          "text": "קוב\"ה סליק לעילא ולעילא3,"
        },
        {
          "s": 10,
          "text": "עד לרקיע השביעי,"
        },
        {
          "s": 11,
          "text": "ואח\"כ עמדו שבעה צדיקים והורידו את השכינה מלמעלה למטה,"
        },
        {
          "s": 12,
          "text": "עד שבא משה שהוא השביעי וכל השביעין חביבין4"
        },
        {
          "s": 13,
          "text": "והורידה למטה בארץ."
        },
        {
          "s": 14,
          "text": "וזהו צדיקים יירשו ארץ וישכנו לעד עלי'5,"
        },
        {
          "s": 15,
          "text": "דעבודת הצדיקים היא להשכין ולהמשיך את השכינה מלמעלה למטה,"
        },
        {
          "s": 16,
          "text": "בחי' עד"
        },
        {
          "s": 17,
          "text": "(כמו שהיא בבחי' שוכן עד מרום וקדוש)"
        },
        {
          "s": 18,
          "text": "ישכינו עלי',"
        },
        {
          "s": 19,
          "text": "למטה בארץ,"
        },
        {
          "s": 20,
          "text": "בעוה\"ז התחתון שאין תחתון למטה ממנו."
        },
        {
          "s": 21,
          "text": "והנה התחלת ההמשכה למטה שע\"י משה היתה בעת מ\"ת כמ\"ש6"
        },
        {
          "s": 22,
          "text": "וירד הוי' על הר סיני,"
        },
        {
          "s": 23,
          "text": "אבל בקביעות7"
        },
        {
          "s": 24,
          "text": "ובגילוי הי' זה בעשיית המשכן כמ\"ש8"
        },
        {
          "s": 25,
          "text": "ועשו לי מקדש ושכנתי בתוכם."
        },
        {
          "s": 26,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 27,
          "text": "שהמשכת עיקר שכינה בתחתונים"
        },
        {
          "s": 28,
          "text": "(ושכנתי בתוכם)"
        },
        {
          "s": 29,
          "text": "נעשית ע\"י העבודה דאתהפכא חשוכא לנהורא."
        },
        {
          "s": 30,
          "text": "וזהו מה שהמשכן הי' מעצי שטים,"
        },
        {
          "s": 31,
          "text": "שמהם נעשו הקרשים,"
        },
        {
          "s": 32,
          "text": "כמ\"ש9"
        },
        {
          "s": 33,
          "text": "ועשית את הקרשים למשכן עצי שטים עומדים,"
        },
        {
          "s": 34,
          "text": "קרש הוא אותיות שקר והוא השקר דעולם,"
        },
        {
          "s": 35,
          "text": "הבא מהשטות דלעו\"ז,"
        },
        {
          "s": 36,
          "text": "אין אדם עובר עבירה אא\"כ נכנס בו רוח שטות10,"
        },
        {
          "s": 37,
          "text": "וע\"י העבודה דועשית את הקרשים למשכן עצי שטים עומדים,"
        },
        {
          "s": 38,
          "text": "שמהפכים השטות דלעו\"ז לשטות דקדושה"
        },
        {
          "s": 39,
          "text": "(עצי שטים),"
        },
        {
          "s": 40,
          "text": "את השקר דעולם לקרש המשכן"
        },
        {
          "s": 41,
          "text": "(קרשים למשכן),"
        },
        {
          "s": 42,
          "text": "עי\"ז נעשה ושכנתי בתוכם,"
        },
        {
          "s": 43,
          "text": "המשכת"
        },
        {
          "s": 44,
          "text": "(עיקר)"
        },
        {
          "s": 45,
          "text": "שכינה בתחתונים."
        },
        {
          "s": 46,
          "text": "ומוסיף בהמאמר דיוק לשון הכתוב ושכנתי בתוכם,"
        },
        {
          "s": 47,
          "text": "בתוכו לא נאמר אלא בתוכם בתוך כל אחד ואחד11,"
        },
        {
          "s": 48,
          "text": "דבכאו\"א מישראל ע\"י העבודה דאתהפכא חשוכא לנהורא,"
        },
        {
          "s": 49,
          "text": "עי\"ז שוכן בו עיקר שכינה כמו שהי' בתחלת הבריאה,"
        },
        {
          "s": 50,
          "text": "באתי לגני לגנוני,"
        },
        {
          "s": 51,
          "text": "למקום שהי' עיקרו בתחלה,"
        },
        {
          "s": 52,
          "text": "ונעשה עיקר דירה בתחתונים."
        }
      ]
    }
  ]
}