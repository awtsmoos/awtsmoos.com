{
  "globalIndex": 118,
  "owner": 18,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914390_theRebbe_977__p004",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914390_theRebbe_977__p004",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914390_theRebbe_977",
  "title": "מאמר בסוכות תשבו תשכ\"ג",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ובעומק יותר יש לומר21,"
        },
        {
          "s": 1,
          "text": "שענין החידוש שבתשובה כפשוטה הוא גם לגבי הרצון והכוונה דלמעלה."
        },
        {
          "s": 2,
          "text": "שהרצון והכוונה דלמעלה בבריאת העולם והאדם היא שהאדם יהי' צדיק,"
        },
        {
          "s": 3,
          "text": "כמרז\"ל22"
        },
        {
          "s": 4,
          "text": "במי נמלך בנשמותיהן של צדיקים."
        },
        {
          "s": 5,
          "text": "וע\"י שחטא ופגם והעביר את הדרך"
        },
        {
          "s": 6,
          "text": "(היפך הכוונה דבריאת העולם והאדם)"
        },
        {
          "s": 7,
          "text": "ואח\"כ מתקן זה ע\"י התשובה,"
        },
        {
          "s": 8,
          "text": "עי\"ז נמשך אור חדש שלא הי' בכוונת הבריאה."
        },
        {
          "s": 9,
          "text": "והכח להמשיך אור חדש שלא הי' בהכוונה דבמי נמלך,"
        },
        {
          "s": 10,
          "text": "הוא לפי ששורש הנשמות הוא בעצמות אוא\"ס,"
        },
        {
          "s": 11,
          "text": "שהוא למעלה גם משרשם בהענין דבמי נמלך."
        },
        {
          "s": 12,
          "text": "ויש לומר,"
        },
        {
          "s": 13,
          "text": "דזה שע\"י התשובה משתנה האדם ממציאותו ונעשה מציאות חדשה לגמרי,"
        },
        {
          "s": 14,
          "text": "חידוש אמיתי שאינו המשך ממצבו הקודם,"
        },
        {
          "s": 15,
          "text": "הוא,"
        },
        {
          "s": 16,
          "text": "לפי שע\"י התשובה הוא המשכת עצם הנשמה כמו שהיא מושרשת בעצמות אוא\"ס23,"
        },
        {
          "s": 17,
          "text": "ולגבי עצם הנשמה,"
        },
        {
          "s": 18,
          "text": "אין נפק\"מ מצבו של האדם שהי' לפני התשובה."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש להוסיף ביאור בזה שע\"י העבודה דבסוכות תשבו"
        },
        {
          "s": 1,
          "text": "(גילוי התשובה דיום הכפורים)"
        },
        {
          "s": 2,
          "text": "נעשה שינוי באורות המקיפים שנעשים אורות מתיישבים,"
        },
        {
          "s": 3,
          "text": "כי הענין דהמשכת עצם הנשמה שע\"י התשובה מתגלה בזה שהאדם משתנה ממציאותו24,"
        },
        {
          "s": 4,
          "text": "ולכן,"
        },
        {
          "s": 5,
          "text": "הגילוי דהמשכת העצמות שע\"י בסוכות תשבו"
        },
        {
          "s": 6,
          "text": "(גילוי התשובה דיום הכפורים)"
        },
        {
          "s": 7,
          "text": "הוא בענין השינוי,"
        },
        {
          "s": 8,
          "text": "שאורות המקיפים משתנים להיות אורות מתיישבים."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "שהגילוי דעצם הנשמה שמושרשת בעצמות אוא\"ס"
        },
        {
          "s": 3,
          "text": "(שלמעלה משורש הנשמות בהענין דבמי נמלך)"
        },
        {
          "s": 4,
          "text": "שע\"י תשובה,"
        },
        {
          "s": 5,
          "text": "הוא בשני ענינים."
        },
        {
          "s": 6,
          "text": "בהתשובה עצמה ובהסיבה שמביאה לתשובה."
        },
        {
          "s": 7,
          "text": "והענין הוא,"
        },
        {
          "s": 8,
          "text": "דזה שהאדם עושה תשובה לאחרי שחטא הוא מצד שרש הנשמה בעצמות אוא\"ס שלמעלה מהענין דבמי נמלך."
        },
        {
          "s": 9,
          "text": "שמצד שורש הנשמות בהענין דבמי נמלך בנשמותיהן של צדיקים,"
        },
        {
          "s": 10,
          "text": "ע\"י שחטא ופגם"
        },
        {
          "s": 11,
          "text": "(היפך הכוונה דבמי נמלך),"
        },
        {
          "s": 12,
          "text": "הוא נפרד משרשו,"
        },
        {
          "s": 13,
          "text": "וזה שלאחרי שחטא הוא עושה תשובה ומשנה את מציאותו,"
        },
        {
          "s": 14,
          "text": "הוא מצד גילוי שורש הנשמה בעצמות אוא\"ס,"
        },
        {
          "s": 15,
          "text": "שלמעלה מהענין דבמי נמלך."
        },
        {
          "s": 16,
          "text": "ועוד ענין בזה,"
        },
        {
          "s": 17,
          "text": "דהסיבה שמביאה אותו לחזור בתשובה היא לפי שנקודת היהדות שבו היא תמיד בשלימות"
        },
        {
          "s": 18,
          "text": "(וכאשר מתעוררת נקודת היהדות שבו,"
        },
        {
          "s": 19,
          "text": "אינו רוצה בשום אופן להיות נפרד ועושה תשובה),"
        },
        {
          "s": 20,
          "text": "וזה שנקודת היהדות שבו היא תמיד בשלימות,"
        },
        {
          "s": 21,
          "text": "דגם בשעת החטא הנשמה היא באמנה אתו ית'25,"
        },
        {
          "s": 22,
          "text": "הוא לפי שההתקשרות דהנשמה באלקות היא התקשרות עצמית,"
        },
        {
          "s": 23,
          "text": "שלמעלה מההתקשרות שע\"י תורה ומצוות"
        },
        {
          "s": 24,
          "text": "(הענין דבמי נמלך)."
        }
      ]
    }
  ]
}