{
  "globalIndex": 872,
  "owner": 22,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918918_theRebbe_323__p003",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918918_theRebbe_323__p003",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918918_theRebbe_323",
  "title": "מאמר ועתה יגדל נא תשי\"ט",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יובן יותר25"
        },
        {
          "s": 2,
          "text": "הטעם על זה שע\"י שמביא את השכל בדיבור מיתוסף בהשגת השכל יותר מכמו שהי' קודם,"
        },
        {
          "s": 3,
          "text": "כי הכח שמחלק את הסברא באותיות הדיבור שרשו הוא בקדמות השכל,"
        },
        {
          "s": 4,
          "text": "המקור דשכל הגלוי26."
        },
        {
          "s": 5,
          "text": "וזהו גם הטעם על זה שלפעמים כשלומד איזה ענין במחשבה ומתעוררים אצלו קושיות חזקות שאינו יכול לתרצם וע\"י שלומד הענין בדיבור מתיישבים אצלו הקושיות וסתירות27."
        },
        {
          "s": 6,
          "text": "כי השכל כמו שהוא מצד מקורו הוא שכל ברור,"
        },
        {
          "s": 7,
          "text": "בלי סיג ופסולת28,"
        },
        {
          "s": 8,
          "text": "ולכן כשמביא את השכל בדיבור,"
        },
        {
          "s": 9,
          "text": "שעי\"ז נמשך השכל כמו שהוא בשרשו"
        },
        {
          "s": 10,
          "text": "(כנ\"ל),"
        },
        {
          "s": 11,
          "text": "נעשה אצלו ברור באופן שאין שום קושיא וסתירה כלל29."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "והנה גם החכמה,"
        },
        {
          "s": 2,
          "text": "בחינת קדמות השכל,"
        },
        {
          "s": 3,
          "text": "להיותה שרש ומקור השכל,"
        },
        {
          "s": 4,
          "text": "בהכרח שהיא בבחינת מציאות."
        },
        {
          "s": 5,
          "text": "דכמו שהשכל הוא מציאות"
        },
        {
          "s": 6,
          "text": "(שמחוץ להנפש30),"
        },
        {
          "s": 7,
          "text": "עד\"ז הוא גם שרש השכל,"
        },
        {
          "s": 8,
          "text": "קדמות השכל."
        },
        {
          "s": 9,
          "text": "וזהו מעלת הרצון על השכל"
        },
        {
          "s": 10,
          "text": "(גם על קדמות השכל31),"
        },
        {
          "s": 11,
          "text": "שהרצון אינו מציאות לעצמו וכל ענינו הוא הטיית והמשכת הנפש30."
        },
        {
          "s": 12,
          "text": "ולכן הרצון מושל ושולט על כל הכחות32"
        },
        {
          "s": 13,
          "text": "גם על כח השכל,"
        },
        {
          "s": 14,
          "text": "כמארז\"ל33"
        },
        {
          "s": 15,
          "text": "לעולם ילמוד אדם במקום שלבו חפץ,"
        },
        {
          "s": 16,
          "text": "דע\"י שרוצה בזה,"
        },
        {
          "s": 17,
          "text": "הוא מבין באופן אחר."
        },
        {
          "s": 18,
          "text": "ומכיון שהרצון הוא למעלה גם משרש השכל"
        },
        {
          "s": 19,
          "text": "(קדמות השכל),"
        },
        {
          "s": 20,
          "text": "כנ\"ל,"
        },
        {
          "s": 21,
          "text": "לכן,"
        },
        {
          "s": 22,
          "text": "הפעולה שנעשית בשכל ע\"י הרצון היא גם בשרש השכל."
        },
        {
          "s": 23,
          "text": "ולכן,"
        },
        {
          "s": 24,
          "text": "ההוספה בשכל שע\"י הרצון היא הרבה יותר מההוספה שע\"י הדיבור34."
        },
        {
          "s": 25,
          "text": "כי ההוספה שע\"י הדיבור היא מפני שהדיבור מעורר שרש השכל,"
        },
        {
          "s": 26,
          "text": "ומכיון שגם שרש השכל הוא מציאות ויש בו ציור,"
        },
        {
          "s": 27,
          "text": "לכן,"
        },
        {
          "s": 28,
          "text": "ההוספה שע\"י המשכת השרש היא במדידה והגבלה,"
        },
        {
          "s": 29,
          "text": "משא\"כ ההוספה בשכל שע\"י הרצון אינה מדודה"
        },
        {
          "s": 30,
          "text": "(כ\"כ),"
        },
        {
          "s": 31,
          "text": "מכיון שפעולת הרצון היא גם בשרש השכל."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ועד\"ז יובן למעלה,"
        },
        {
          "s": 1,
          "text": "שבההגדלה בשם אד',"
        },
        {
          "s": 2,
          "text": "שני אופנים."
        },
        {
          "s": 3,
          "text": "ההגדלה באד' ע\"י שנמשך בו מבחינת כח אד'."
        },
        {
          "s": 4,
          "text": "וכמובא לעיל"
        },
        {
          "s": 5,
          "text": "(סעיף ג')"
        },
        {
          "s": 6,
          "text": "מכמה דרושים דפירוש יגדל כח אד' הוא שתהי' הגדלה באד' ע\"י שיומשך בו הכח שלו35,"
        },
        {
          "s": 7,
          "text": "שרשו ומקורו."
        },
        {
          "s": 8,
          "text": "וההגדלה באד' ע\"י ההמשכה מבחינת הסובב שלמעלה מהשתלשלות"
        },
        {
          "s": 9,
          "text": "(דסובב הוא דוגמת הרצון),"
        },
        {
          "s": 10,
          "text": "דהגדלה זו היא נעלית יותר,"
        },
        {
          "s": 11,
          "text": "מכיון שהגדלה זו היא גם בכח אד'"
        },
        {
          "s": 12,
          "text": "(השרש דאד'),"
        },
        {
          "s": 13,
          "text": "וכפירוש הפשוט ביגדל כח אד',"
        },
        {
          "s": 14,
          "text": "שתהי' הגדלה בכח אד'."
        }
      ]
    }
  ]
}