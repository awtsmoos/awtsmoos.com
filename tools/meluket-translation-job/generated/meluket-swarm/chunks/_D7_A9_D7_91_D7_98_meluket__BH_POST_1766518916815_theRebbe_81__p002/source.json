{
  "globalIndex": 519,
  "owner": 19,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916815_theRebbe_81__p002",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916815_theRebbe_81__p002",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916815_theRebbe_81",
  "title": "מאמר באתי לגני תש\"ל",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 2,
          "text": "דזה שנתאוה הקב\"ה להיות לו ית' דירה בתחתונים הוא שיהי' גילוי אלקות למטה ע\"י עבודת האדם,"
        },
        {
          "s": 3,
          "text": "ע\"י אתכפיא ואתהפכא."
        },
        {
          "s": 4,
          "text": "דשני ענינים בזה."
        },
        {
          "s": 5,
          "text": "שהגילוי אלקות למטה"
        },
        {
          "s": 6,
          "text": "(דירה בתחתונים)"
        },
        {
          "s": 7,
          "text": "יהי' לא ע\"י המשכה מלמעלה אלא ע\"י עבודת האדם,"
        },
        {
          "s": 8,
          "text": "ושהעבודה שעל ידה נעשה גילוי אלקות בעולם תהי' העבודה דאתכפיא ואתהפכא."
        },
        {
          "s": 9,
          "text": "ויש לומר,"
        },
        {
          "s": 10,
          "text": "דזה שמוסיף שהשלימות דדירה בתחתונים הוא כשעשיית הדירה היא ע\"י העבודה דאתכפיא ואתהפכא10,"
        },
        {
          "s": 11,
          "text": "הוא,"
        },
        {
          "s": 12,
          "text": "כי עפ\"ז מודגש עוד יותר מעלת המשכת עיקר שכינה בתחתונים עכשיו לגבי ההמשכה שהיתה בתחלת הבריאה."
        },
        {
          "s": 13,
          "text": "דזה שההמשכה עכשיו"
        },
        {
          "s": 14,
          "text": "(לאחרי שנעשתה הירידה בעולם)"
        },
        {
          "s": 15,
          "text": "היא נעלית יותר מכמו שהיתה בתחלת הבריאה,"
        },
        {
          "s": 16,
          "text": "הוא לא רק מפני שכל עלי' שלאחרי ירידה היא עלי' למעלה יותר מהדרגא שלפני הירידה11,"
        },
        {
          "s": 17,
          "text": "אלא גם לפי שההמשכה עכשיו היא על ידי העבודה דאתכפיא ואתהפכא."
        },
        {
          "s": 18,
          "text": "משא\"כ לפני חטא עה\"ד,"
        },
        {
          "s": 19,
          "text": "אף שגם המשכת עיקר שכינה בתחתונים אז היתה ע\"י עבודת אדם הראשון,"
        },
        {
          "s": 20,
          "text": "לעבדה12"
        },
        {
          "s": 21,
          "text": "ולשמרה13,"
        },
        {
          "s": 22,
          "text": "העבודה אז היתה להמשיך אלקות מלמעלה ולא העבודה דאתכפיא ואתהפכא."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "דזהו מה שעשיית המשכן היתה לאחרי חטא העגל14,"
        },
        {
          "s": 3,
          "text": "דהכוונה בהירידה דעולם"
        },
        {
          "s": 4,
          "text": "(שעל ידי חטא העגל)15"
        },
        {
          "s": 5,
          "text": "לפני עשיית המשכן,"
        },
        {
          "s": 6,
          "text": "היא,"
        },
        {
          "s": 7,
          "text": "בכדי שהעבודה דועשו לי מקדש תהי'"
        },
        {
          "s": 8,
          "text": "(לא רק קיום ציווי הקב\"ה,"
        },
        {
          "s": 9,
          "text": "אלא גם)"
        },
        {
          "s": 10,
          "text": "העבודה דאתכפיא ואתהפכא."
        },
        {
          "s": 11,
          "text": "וכמבואר בהמאמר16,"
        },
        {
          "s": 12,
          "text": "שהעבודה דועשו לי מקדש היא להפוך השטות דלעו\"ז לשטות דקדושה ולהפוך השקר דעולם17"
        },
        {
          "s": 13,
          "text": "לקרש המשכן."
        },
        {
          "s": 14,
          "text": "ועי\"ז נעשה ושכנתי בתוכם,"
        },
        {
          "s": 15,
          "text": "המשכת עיקר שכינה בתחתונים,"
        },
        {
          "s": 16,
          "text": "למעלה יותר מכמו שהי' קודם החטא."
        },
        {
          "s": 17,
          "text": "וענין זה"
        },
        {
          "s": 18,
          "text": "(שהמשכת עיקר שכינה בתחתונים במשכן היתה למעלה יותר מכמו שהי' קודם החטא)"
        },
        {
          "s": 19,
          "text": "מובן גם מזה שההנהגה דעולם"
        },
        {
          "s": 20,
          "text": "(גם קודם החטא)"
        },
        {
          "s": 21,
          "text": "היתה ע\"פ טבע,"
        },
        {
          "s": 22,
          "text": "דשרש הטבע הוא מהאור שבערך העולמות18,"
        },
        {
          "s": 23,
          "text": "ובמשכן היתה הנהגה נסית שלמעלה מהטבע"
        },
        {
          "s": 24,
          "text": "[כמחז\"ל19"
        },
        {
          "s": 25,
          "text": "עשרה נסים נעשו לאבותינו בבית המקדש,"
        },
        {
          "s": 26,
          "text": "שעד\"ז הי' במשכן20],"
        },
        {
          "s": 27,
          "text": "דשרש הנסים הוא מהאור שלמעלה מעולמות."
        },
        {
          "s": 28,
          "text": "ויתירה מזו,"
        },
        {
          "s": 29,
          "text": "שבקודש הקדשים מקום הארון אינו מן המדה21,"
        },
        {
          "s": 30,
          "text": "מקום ולמעלה מהמקום כאחד,"
        },
        {
          "s": 31,
          "text": "שבכדי שיהי' החיבור דשני הפכים דמקום ולמעלה מהמקום22"
        },
        {
          "s": 32,
          "text": "הוא דוקא ע\"י הגילוי דאוא\"ס שלמעלה גם מהאור שלמעלה מעולמות23,"
        },
        {
          "s": 33,
          "text": "נמנע24"
        },
        {
          "s": 34,
          "text": "הנמנעות25."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "והנה עד\"ז הוא בהירידה דעולם שע\"י הגלות,"
        },
        {
          "s": 1,
          "text": "שהיא ירידה צורך עלי'."
        },
        {
          "s": 2,
          "text": "דכיון שעיקר העבודה דאתכפיא ואתהפכא היא בזמן הגלות,"
        },
        {
          "s": 3,
          "text": "לכן,"
        },
        {
          "s": 4,
          "text": "ההמשכה שע\"י העבודה שבזמן הגלות היא נעלית יותר מההמשכה שע\"י העבודה שבזמן הבית."
        },
        {
          "s": 5,
          "text": "וזהו מהטעמים שהגילוי דלע\"ל יהי' נעלה יותר מהגילוי שהי' בביהמ\"ק,"
        },
        {
          "s": 6,
          "text": "כי הגילוי דלע\"ל הוא26"
        },
        {
          "s": 7,
          "text": "שאז יהי' גילוי ההמשכה שע\"י העבודה שבזמן הגלות."
        }
      ]
    }
  ]
}