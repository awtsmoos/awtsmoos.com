{
  "globalIndex": 950,
  "owner": 0,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919374_theRebbe_640__p002",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919374_theRebbe_640__p002",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919374_theRebbe_640",
  "title": "מאמר עשרה שיושבין תשמ\"ב",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ולהוסיף,"
        },
        {
          "s": 1,
          "text": "דהפירוש שבכל המקום אשר אזכיר את שמי גו' קאי על בית המקדש שבו ניתן רשות להזכיר את שם המפורש,"
        },
        {
          "s": 2,
          "text": "הוא פשוטו של מקרא11"
        },
        {
          "s": 3,
          "text": "(תורה שבכתב),"
        },
        {
          "s": 4,
          "text": "והפירוש שאזכיר את שמי קאי על לימוד התורה הוא ע\"פ דרשת חז\"ל"
        },
        {
          "s": 5,
          "text": "(תורה שבעל פה)."
        },
        {
          "s": 6,
          "text": "וע\"פ הידוע12"
        },
        {
          "s": 7,
          "text": "שכל הענינים דתושבע\"פ נמשכים מתושב\"כ,"
        },
        {
          "s": 8,
          "text": "יש לומר,"
        },
        {
          "s": 9,
          "text": "דזה שהלימוד שאפילו אחד שיושב ועוסק בתורה שכינה שרוי' הוא מהפסוק בכל המקום אשר אזכיר את שמי גו' שבפשטות קאי על ביהמ\"ק ששייך לעמוד העבודה,"
        },
        {
          "s": 10,
          "text": "הוא,"
        },
        {
          "s": 11,
          "text": "כי עיקר הענין דהשראת השכינה באופן דאבוא אליך,"
        },
        {
          "s": 12,
          "text": "המשכת אוא\"ס שלמעלה מהשתלשלות"
        },
        {
          "s": 13,
          "text": "(אבוא,"
        },
        {
          "s": 14,
          "text": "אני בעצמי),"
        },
        {
          "s": 15,
          "text": "הוא ע\"י קו העבודה,"
        },
        {
          "s": 16,
          "text": "העלאה מלמטה למעלה."
        },
        {
          "s": 17,
          "text": "וכמבואר בתניא13"
        },
        {
          "s": 18,
          "text": "דהטעם שע\"י תפלה נמשך אוא\"ס שלמעלה מהשתלשלות"
        },
        {
          "s": 19,
          "text": "[שע\"י המשכה זו נעשה שינוי בהנבראים,"
        },
        {
          "s": 20,
          "text": "לרפאות החולים ולברך השנים]"
        },
        {
          "s": 21,
          "text": "הוא מפני גודל העילוי דהעלאת מ\"ן."
        },
        {
          "s": 22,
          "text": "וע\"י התפלה באה אח\"כ המשכה זו גם בתורה."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "וע\"פ מ\"ש בהמאמר דבעל הגאולה"
        },
        {
          "s": 1,
          "text": "(הובא לעיל סעיף א)"
        },
        {
          "s": 2,
          "text": "דזה שע\"י תפלה וע\"י תורה ממשיכים יגמה\"ר שלמעלה מהשתלשלות הוא בעיקר בתפלת רבים14"
        },
        {
          "s": 3,
          "text": "ובתורה דרבים,"
        },
        {
          "s": 4,
          "text": "ועד שההמשכה שע\"י תפלת רבים ותורה דרבים היא שלא לפי ערך האתערותא דלתתא"
        },
        {
          "s": 5,
          "text": "(דהרבים),"
        },
        {
          "s": 6,
          "text": "מובן,"
        },
        {
          "s": 7,
          "text": "דענין הנ\"ל שההמשכה שלמעלה מהשתלשלות שבתורה היא ע\"י התפלה,"
        },
        {
          "s": 8,
          "text": "מודגש עוד יותר בההמשכה שע\"י רבים."
        },
        {
          "s": 9,
          "text": "וכמו שנתבאר לעיל"
        },
        {
          "s": 10,
          "text": "(בהמאמר די\"ג תמוז15),"
        },
        {
          "s": 11,
          "text": "דהטעם שענין ההמשכה שלא לפי ערך ההעלאה שע\"י תורה דרבים נלמד"
        },
        {
          "s": 12,
          "text": "(בהמאמר דבעל הגאולה)"
        },
        {
          "s": 13,
          "text": "מההמשכה שע\"י תפלה דרבים16,"
        },
        {
          "s": 14,
          "text": "הוא,"
        },
        {
          "s": 15,
          "text": "כי עיקר ומקור ענין זה הוא בתפלה,"
        },
        {
          "s": 16,
          "text": "ועי\"ז נמשך אח\"כ גם בתורה."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והגם שהמעלה דהעלאת מ\"ן ישנה לכאורה גם בתורה,"
        },
        {
          "s": 2,
          "text": "וכמבואר בהמאמר דבעל הגאולה17"
        },
        {
          "s": 3,
          "text": "שגם בתורה צ\"ל עבודה ויגיעה,"
        },
        {
          "s": 4,
          "text": "מ\"מ,"
        },
        {
          "s": 5,
          "text": "עיקר הענין דהמשכה שלמעלה מהשתלשלות הוא ע\"י העלאת מ\"ן דתפלה דוקא18."
        },
        {
          "s": 6,
          "text": "ונקודת הביאור בזה,"
        },
        {
          "s": 7,
          "text": "שהמעלה דעבודת האדם"
        },
        {
          "s": 8,
          "text": "(העלאת מ\"ן)"
        },
        {
          "s": 9,
          "text": "שעל ידה נמשך אוא\"ס שלמעלה מהשתלשלות,"
        },
        {
          "s": 10,
          "text": "היא"
        },
        {
          "s": 11,
          "text": "(בעיקר)"
        },
        {
          "s": 12,
          "text": "כשהעבודה היא בביטול19,"
        },
        {
          "s": 13,
          "text": "וענין הביטול הוא בעבודת התפלה."
        },
        {
          "s": 14,
          "text": "שהיגיעה בלימוד התורה,"
        },
        {
          "s": 15,
          "text": "כיון שענין הלימוד הוא שיבין וישיג מה שלומד,"
        },
        {
          "s": 16,
          "text": "לכן היגיעה בתורה,"
        },
        {
          "s": 17,
          "text": "גם היגיעה דשונה פרקו מאה פעמים ואחד20,"
        },
        {
          "s": 18,
          "text": "אף שיגיעה זו היא לא"
        },
        {
          "s": 19,
          "text": "(רק)"
        },
        {
          "s": 20,
          "text": "בשביל הבנת התורה אלא בכדי לשנות טבעו ורגילותו,"
        },
        {
          "s": 21,
          "text": "אינה אמיתית ענין הביטול,"
        },
        {
          "s": 22,
          "text": "כיון שגם הלימוד דפעם המאה ואחד הוא בהבנה והשגה."
        },
        {
          "s": 23,
          "text": "ועיקר הביטול הוא בעבודת התפלה,"
        },
        {
          "s": 24,
          "text": "שהאדם המתפלל הוא כעבד21"
        },
        {
          "s": 25,
          "text": "בפני רבו22."
        },
        {
          "s": 26,
          "text": "ויש לומר,"
        },
        {
          "s": 27,
          "text": "שגם העבודה דתפלה שבשביל עסק התורה"
        },
        {
          "s": 28,
          "text": "(דכל האומר אין לי אלא תורה אפילו תורה אין לו23),"
        },
        {
          "s": 29,
          "text": "כיון שהתפלה היא בשביל התורה שענינה הוא הבנה והשגה,"
        },
        {
          "s": 30,
          "text": "אינה אמיתית ענין הביטול24."
        },
        {
          "s": 31,
          "text": "ולכן עיקר הענין דהמשכה שלמעלה מהשתלשלות"
        },
        {
          "s": 32,
          "text": "(ומכ\"ש המשכה שלא לפי ערך ההעלאה)"
        },
        {
          "s": 33,
          "text": "הוא ע\"י העלאת מ\"ן דתפלה,"
        },
        {
          "s": 34,
          "text": "ועי\"ז נמשך אח\"כ גם בתורה."
        },
        {
          "s": 35,
          "text": "דע\"י העבודה שבתורה"
        },
        {
          "s": 36,
          "text": "[העבודה דתפלה שבשביל התורה,"
        },
        {
          "s": 37,
          "text": "ולמטה מזה – העבודה דשונה פרקו מאה פעמים ואחד בכדי לשנות טבעו ורגילותו,"
        },
        {
          "s": 38,
          "text": "ולמטה מזה – היגיעה בהבנת התורה],"
        },
        {
          "s": 39,
          "text": "התורה שלומד היא כלי לההמשכה שלמעלה מהשתלשלות שע\"י תפלה."
        }
      ]
    }
  ]
}