{
  "globalIndex": 654,
  "owner": 4,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917627_theRebbe_329__p002",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917627_theRebbe_329__p002",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917627_theRebbe_329",
  "title": "מאמר החודש הזה לכם תשל\"ה",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים דבהחילוק בין תשרי וניסן כמה ענינים."
        },
        {
          "s": 2,
          "text": "ומהם,"
        },
        {
          "s": 3,
          "text": "דההמשכה בתשרי היא ע\"י אתערותא דלתתא,"
        },
        {
          "s": 4,
          "text": "וההמשכה בניסן היא מלמעלה,"
        },
        {
          "s": 5,
          "text": "אתערותא דלעילא מצד עצמה14."
        },
        {
          "s": 6,
          "text": "דזהו שברכת הגשם היא בשמע\"צ"
        },
        {
          "s": 7,
          "text": "(תשרי)"
        },
        {
          "s": 8,
          "text": "וברכת טל היא בפסח"
        },
        {
          "s": 9,
          "text": "(ניסן),"
        },
        {
          "s": 10,
          "text": "כי גשם הוא15"
        },
        {
          "s": 11,
          "text": "המשכה ע\"י אתעדל\"ת וטל הוא15"
        },
        {
          "s": 12,
          "text": "שיורד מלמעלה מעצמו16."
        },
        {
          "s": 13,
          "text": "ועוד חילוק בין ניסן ותשרי,"
        },
        {
          "s": 14,
          "text": "דהחיות שנמשך בראש השנה"
        },
        {
          "s": 15,
          "text": "(תשרי)"
        },
        {
          "s": 16,
          "text": "על כל השנה הוא בגבול ומדה"
        },
        {
          "s": 17,
          "text": "(שבכללות הוא החיות שמלובש בהנבראים בפנימיותם),"
        },
        {
          "s": 18,
          "text": "שהוא השרש דהנהגת הטבע,"
        },
        {
          "s": 19,
          "text": "וזה שניסן הוא ראש חדשים"
        },
        {
          "s": 20,
          "text": "[דזה שנקרא בשם ראש חדשים הוא לפי שממנו נמשך חיות לכל החדשים,"
        },
        {
          "s": 21,
          "text": "בדוגמת ראש כפשוטו שממנו נמשך חיות לכל אברי הגוף]"
        },
        {
          "s": 22,
          "text": "הוא בנוגע להמשכת אור הבל\"ג שלמעלה מעולמות,"
        },
        {
          "s": 23,
          "text": "השרש דהנהגה נסית שלמעלה מהטבע17."
        },
        {
          "s": 24,
          "text": "וזהו שבריאת העולם היתה בתשרי ויציאת מצרים היתה בניסן,"
        },
        {
          "s": 25,
          "text": "כי בריאת העולם הוא זה שנברא העולם מדוד ומוגבל ע\"פ חוקי הטבע,"
        },
        {
          "s": 26,
          "text": "ויציאת מצרים היא היציאה מהמיצרים וההגבלות דעולם ע\"י גילוי אור הבל\"ג שלמעלה מעולמות."
        },
        {
          "s": 27,
          "text": "ויש לומר דשני ענינים אלה תלויים זב\"ז."
        },
        {
          "s": 28,
          "text": "דההמשכה הבאה ע\"י אתערותא דלתתא"
        },
        {
          "s": 29,
          "text": "(עבודת הנבראים)"
        },
        {
          "s": 30,
          "text": "היא מדודה ומוגבלת לפי אופן המטה,"
        },
        {
          "s": 31,
          "text": "וההמשכה הבאה ע\"י אתערותא דלעילא מצד עצמה היא כפי אופן המעלה."
        },
        {
          "s": 32,
          "text": "ועפ\"ז צריך להבין,"
        },
        {
          "s": 33,
          "text": "מה שהמחשבה לברוא את העולם היתה בניסן,"
        },
        {
          "s": 34,
          "text": "מהי השייכות דבריאת העולם"
        },
        {
          "s": 35,
          "text": "(מדידה והגבלה)"
        },
        {
          "s": 36,
          "text": "לניסן"
        },
        {
          "s": 37,
          "text": "(גילוי אור הבל\"ג)."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה הפלוגתא דר\"א ור\"י היא גם בנוגע להזמן דגאולה העתידה."
        },
        {
          "s": 2,
          "text": "דר\"א ס\"ל דבניסן נגאלו ובתשרי עתידין ליגאל ור\"י ס\"ל דבניסן נגאלו ובניסן עתידין ליגאל18."
        },
        {
          "s": 3,
          "text": "ומבאר הצ\"צ19"
        },
        {
          "s": 4,
          "text": "דאזלי לשיטתייהו באופן הגאולה20."
        },
        {
          "s": 5,
          "text": "דר\"א ס\"ל אם ישראל עושין תשובה נגאלין ואם לאו אין נגאלין,"
        },
        {
          "s": 6,
          "text": "ולכן ס\"ל דבתשרי עתידין ליגאל,"
        },
        {
          "s": 7,
          "text": "כי אז התשובה מתקבלת ביתר שאת21."
        },
        {
          "s": 8,
          "text": "דזה שהגאולה דיציאת מצרים היתה בניסן וגאולה העתידה תהי' בתשרי הוא,"
        },
        {
          "s": 9,
          "text": "לפי שהם חלוקים באופנם."
        },
        {
          "s": 10,
          "text": "דהגאולה דיצי\"מ היתה ע\"י הגילוי מלמעלה,"
        },
        {
          "s": 11,
          "text": "ולכן היתה בניסן."
        },
        {
          "s": 12,
          "text": "וגאולה העתידה תהי' ע\"י התשובה,"
        },
        {
          "s": 13,
          "text": "עבודתם של ישראל,"
        },
        {
          "s": 14,
          "text": "ולכן תהי' בתשרי."
        },
        {
          "s": 15,
          "text": "[וזהו גם הטעם על זה שהגאולה דיציאת מצרים"
        },
        {
          "s": 16,
          "text": "(וכן הגאולות שלאחרי')"
        },
        {
          "s": 17,
          "text": "היתה גאולה שיש אחרי' גלות,"
        },
        {
          "s": 18,
          "text": "בחינת נקבה22,"
        },
        {
          "s": 19,
          "text": "וגאולה העתידה תהי' גאולה נצחית שאין אחרי' גלות,"
        },
        {
          "s": 20,
          "text": "בחינת זכר22,"
        },
        {
          "s": 21,
          "text": "כי איש מזריע תחילה יולדת נקבה,"
        },
        {
          "s": 22,
          "text": "אשה מזרעת תחלה יולדת זכר23]."
        },
        {
          "s": 23,
          "text": "ור\"י ס\"ל לא בכסף תגאלו24"
        },
        {
          "s": 24,
          "text": "לא בתשובה ומעשים טובים"
        },
        {
          "s": 25,
          "text": "[דאפילו אין עושין תשובה נגאלין25],"
        },
        {
          "s": 26,
          "text": "לכן ס\"ל דבניסן עתידין ליגאל."
        },
        {
          "s": 27,
          "text": "וזה שהגאולה העתידה תהי' גאולה נצחית,"
        },
        {
          "s": 28,
          "text": "בחינת זכר,"
        },
        {
          "s": 29,
          "text": "אף שגם גאולה העתידה תהי' ע\"י גילוי מלמעלה,"
        },
        {
          "s": 30,
          "text": "הוא,"
        },
        {
          "s": 31,
          "text": "כי הגילוי דלע\"ל הוא ממקום נעלה מאד,"
        },
        {
          "s": 32,
          "text": "שגם כשאיש מזריע תחלה יולדת זכר."
        },
        {
          "s": 33,
          "text": "כמ\"ש26"
        },
        {
          "s": 34,
          "text": "ולציון יאמר איש ואיש יולד בה והוא יכוננה עליון,"
        },
        {
          "s": 35,
          "text": "דכאשר הגילוי הוא ממקום נעלה מאד,"
        },
        {
          "s": 36,
          "text": "והוא יכוננה עליון,"
        },
        {
          "s": 37,
          "text": "אזי,"
        },
        {
          "s": 38,
          "text": "איש ואיש יולד,"
        },
        {
          "s": 39,
          "text": "דגם כשאיש מזריע תחלה נולד איש"
        },
        {
          "s": 40,
          "text": "(זכר)."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "וצריך להבין,"
        },
        {
          "s": 1,
          "text": "דבנוגע לאופן הגאולה קיימא לן כר' אליעזר,"
        },
        {
          "s": 2,
          "text": "כמ\"ש הרמב\"ם27"
        },
        {
          "s": 3,
          "text": "שאין ישראל נגאלין אלא בתשובה,"
        },
        {
          "s": 4,
          "text": "ובנוגע לזמן הגאולה מובא בכמה דרושים28"
        },
        {
          "s": 5,
          "text": "שבמדרש29"
        },
        {
          "s": 6,
          "text": "הכריע וסתם כדעת ר\"י דבניסן עתידין ליגאל30."
        },
        {
          "s": 7,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 8,
          "text": "ע\"פ מ\"ש בתניא31"
        },
        {
          "s": 9,
          "text": "שכל הגילויים דלע\"ל תלויים במעשינו ועבודתינו במשך זמן הגלות."
        },
        {
          "s": 10,
          "text": "דענין זה הוא"
        },
        {
          "s": 11,
          "text": "(בפשטות)"
        },
        {
          "s": 12,
          "text": "לכל הדיעות."
        },
        {
          "s": 13,
          "text": "אלא שלדעת ר' יהושע,"
        },
        {
          "s": 14,
          "text": "זה שע\"י מעשינו ועבודתינו בזמן הגלות יומשכו הגילויים דלע\"ל,"
        },
        {
          "s": 15,
          "text": "הוא"
        },
        {
          "s": 16,
          "text": "(לא מצד עצמם,"
        },
        {
          "s": 17,
          "text": "אלא)"
        },
        {
          "s": 18,
          "text": "לפי שבמעשינו ועבודתינו בזמן הגלות יש הכח דהגילוי מלמעלה"
        },
        {
          "s": 19,
          "text": "(כדלקמן סעיף ה)."
        },
        {
          "s": 20,
          "text": "ועפ\"ז יש לבאר התיווך דשני פסקי דינים הנ\"ל,"
        },
        {
          "s": 21,
          "text": "שאין ישראל נגאלין אלא בתשובה ושבניסן עתידין ליגאל,"
        },
        {
          "s": 22,
          "text": "כי זה שישראל עושין תשובה בסוף גלותן ומיד הן נגאלין32"
        },
        {
          "s": 23,
          "text": "הוא,"
        },
        {
          "s": 24,
          "text": "לפי שבעשיית התשובה דישראל בסוף גלותן יש הכח דהגילוי מלמעלה,"
        },
        {
          "s": 25,
          "text": "ענין ניסן."
        }
      ]
    }
  ]
}