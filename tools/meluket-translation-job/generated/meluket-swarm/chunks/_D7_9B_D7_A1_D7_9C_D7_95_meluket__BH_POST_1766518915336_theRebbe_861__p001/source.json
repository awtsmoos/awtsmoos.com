{
  "globalIndex": 268,
  "owner": 18,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915336_theRebbe_861__p001",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915336_theRebbe_861__p001",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915336_theRebbe_861",
  "title": "מאמר פדה בשלום תשל\"ט",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "מוצאי ש\"פ ויצא,"
        },
        {
          "s": 2,
          "text": "ט' כסלו,"
        },
        {
          "s": 3,
          "text": "אור ליו\"ד כסלו,"
        },
        {
          "s": 4,
          "text": "ה'תשל\"ט*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "פדה בשלום נפשי מקרב לי כי ברבים היו עמדי1,"
        },
        {
          "s": 1,
          "text": "ומבאר בעל הגאולה במאמרו ד\"ה זה"
        },
        {
          "s": 2,
          "text": "(שנדפס בספרו שערי תשובה2)3"
        },
        {
          "s": 3,
          "text": "דפירוש פדה בשלום"
        },
        {
          "s": 4,
          "text": "(בשלום דוקא)"
        },
        {
          "s": 5,
          "text": "הוא שהפדי' היא באופן שהמנגד מתבטל לגמרי,"
        },
        {
          "s": 6,
          "text": "שלכן אין צריך למלחמה כלל."
        },
        {
          "s": 7,
          "text": "וע\"ד שהי' בימי שלמה4,"
        },
        {
          "s": 8,
          "text": "שכל הגוים נתבטלו לגבי שלמה שלא ע\"י מלחמה,"
        },
        {
          "s": 9,
          "text": "שלכן נקרא בשם שלמה כי שלום הי' בימיו5."
        },
        {
          "s": 10,
          "text": "ומדייק בהמאמר6,"
        },
        {
          "s": 11,
          "text": "דכאשר נמצאים במצב שאין מנגדים כלל,"
        },
        {
          "s": 12,
          "text": "למה צריך פדי'."
        },
        {
          "s": 13,
          "text": "ויש לומר הביאור בדיוק זה,"
        },
        {
          "s": 14,
          "text": "כי פירוש פדה בשלום הוא לא שהשלום בא לאחרי הפדי'"
        },
        {
          "s": 15,
          "text": "(היינו שהפדי' היא בדרך מלחמה ואח\"כ נעשה שלום),"
        },
        {
          "s": 16,
          "text": "כי אם,"
        },
        {
          "s": 17,
          "text": "שהפדי'"
        },
        {
          "s": 18,
          "text": "(עצמה)"
        },
        {
          "s": 19,
          "text": "היא בשלום,"
        },
        {
          "s": 20,
          "text": "ולכן מדייק,"
        },
        {
          "s": 21,
          "text": "שבמצב של שלום אין צריך לכאורה לפדי'."
        },
        {
          "s": 22,
          "text": "ויש להוסיף עוד דיוק,"
        },
        {
          "s": 23,
          "text": "דבפסוק זה גופא כתיב פדה גו' מקרב לי,"
        },
        {
          "s": 24,
          "text": "דזה שפדה נפשי הוא מן המלחמות הבאים עלי7,"
        },
        {
          "s": 25,
          "text": "והיאך שייך שהפדי' מן המלחמות היא פדי' בשלום,"
        },
        {
          "s": 26,
          "text": "דלכאורה הם שני ענינים הפכים."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויש להוסיף,"
        },
        {
          "s": 2,
          "text": "דשני ענינים אלו"
        },
        {
          "s": 3,
          "text": "(פדה בשלום ומקרב לי)"
        },
        {
          "s": 4,
          "text": "הם לא רק שני הפכים"
        },
        {
          "s": 5,
          "text": "(סתם)"
        },
        {
          "s": 6,
          "text": "אלא שהם הפכים מן הקצה אל הקצה."
        },
        {
          "s": 7,
          "text": "דהנה הטעם על זה שמלחמה נקראת בשם קרב מלשון קירוב"
        },
        {
          "s": 8,
          "text": "(אף שמלחמה הוא היפך ענין הקירוב),"
        },
        {
          "s": 9,
          "text": "הוא"
        },
        {
          "s": 10,
          "text": "(כמובן מהמאמר8),"
        },
        {
          "s": 11,
          "text": "לפי שעיקר ותוקף של מלחמה הוא כשהיא באופן של קירוב."
        },
        {
          "s": 12,
          "text": "דהנה במלחמה יש שני אופנים."
        },
        {
          "s": 13,
          "text": "ששני הלוחמים הם בריחוק זה מזה,"
        },
        {
          "s": 14,
          "text": "אלא שזורקים"
        },
        {
          "s": 15,
          "text": "(אחד על השני)"
        },
        {
          "s": 16,
          "text": "אבני חצים ובליסטראות וכיו\"ב."
        },
        {
          "s": 17,
          "text": "או ששני הלוחמים מתקרבים זה לזה"
        },
        {
          "s": 18,
          "text": "(בקירוב מקום)"
        },
        {
          "s": 19,
          "text": "ועד שהם נאבקים זה עם זה9,"
        },
        {
          "s": 20,
          "text": "ויאבק איש עמו10,"
        },
        {
          "s": 21,
          "text": "שהם מתקרבים זה לזה"
        },
        {
          "s": 22,
          "text": "(לא רק במקום,"
        },
        {
          "s": 23,
          "text": "אלא)"
        },
        {
          "s": 24,
          "text": "גם בגופם,"
        },
        {
          "s": 25,
          "text": "ועד דשני הלוחמים חובקים זה את זה."
        },
        {
          "s": 26,
          "text": "דמלחמה זו"
        },
        {
          "s": 27,
          "text": "(תכלית הקירוב)"
        },
        {
          "s": 28,
          "text": "היא מלחמה קשה ביותר."
        }
      ]
    }
  ]
}