{
  "globalIndex": 759,
  "owner": 9,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918225_theRebbe_77__p001",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918225_theRebbe_77__p001",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518918225_theRebbe_77",
  "title": "מאמר הפך ים ליבשה תשכ\"ז",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "אחרון של פסח,"
        },
        {
          "s": 2,
          "text": "בסעודה,"
        },
        {
          "s": 3,
          "text": "ה'תשכ\"ז*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "(הנחה בלתי מוגה)"
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "הפך ים ליבשה בנהר יעברו ברגל שם נשמחה בו1,"
        },
        {
          "s": 1,
          "text": "והפירוש בזה הוא2,"
        },
        {
          "s": 2,
          "text": "הפך ים ליבשה לשון עבר מדבר בקריעת ים סוף,"
        },
        {
          "s": 3,
          "text": "בנהר יעברו ברגל,"
        },
        {
          "s": 4,
          "text": "לשון עתיד קאי על לעתיד לבוא,"
        },
        {
          "s": 5,
          "text": "שאז יהי' והניף ידו3"
        },
        {
          "s": 6,
          "text": "על הנהר בעים רוחו,"
        },
        {
          "s": 7,
          "text": "לאחרי אשר והחרים ה' את לשון ים מצרים,"
        },
        {
          "s": 8,
          "text": "ושם נשמחה לע\"ל בו,"
        },
        {
          "s": 9,
          "text": "בו בעצמותו4."
        },
        {
          "s": 10,
          "text": "ומזה שמקשר הפך ים ובנהר יעברו,"
        },
        {
          "s": 11,
          "text": "אף שזמן רב ביותר ביניהם,"
        },
        {
          "s": 12,
          "text": "מובן,"
        },
        {
          "s": 13,
          "text": "שהפך ים ליבשה הוא הנתינת כח שיהי' אח\"כ בנהר יעברו ברגל,"
        },
        {
          "s": 14,
          "text": "וכמ\"ש5"
        },
        {
          "s": 15,
          "text": "כימי צאתך מארץ מצרים אראנו נפלאות,"
        },
        {
          "s": 16,
          "text": "שאין זה דוגמא בעלמא,"
        },
        {
          "s": 17,
          "text": "אלא שתלוי זה בזה,"
        },
        {
          "s": 18,
          "text": "שהיציאה ממצרים מביאה להגאולה העתידה,"
        },
        {
          "s": 19,
          "text": "ולכן נלמדים כמה פרטים של גאולה העתידה מגאולת מצרים."
        },
        {
          "s": 20,
          "text": "והנה עוד פירוש בזה6"
        },
        {
          "s": 21,
          "text": "אשר כל הכתוב מדבר בקרי\"ס דכל ג' הענינים היו בקרי\"ס."
        },
        {
          "s": 22,
          "text": "ועפ\"ז מובן בפשיטות שישנם שייכות זל\"ז,"
        },
        {
          "s": 23,
          "text": "ומ\"ש בנהר יעברו ברגל ושם נשמחה – לשון עתיד – מורה על התמידות7,"
        },
        {
          "s": 24,
          "text": "דבכל עלי' לרגל הי' העברה בנהר,"
        },
        {
          "s": 25,
          "text": "וגם כפשוטו הרי נהר הידוע וסתם נהר"
        },
        {
          "s": 26,
          "text": "(בתנ\"ך)8"
        },
        {
          "s": 27,
          "text": "הרי זה נהר פרת9,"
        },
        {
          "s": 28,
          "text": "הנה הכח ע\"ז וההתחלה הי' בקרי\"ס."
        },
        {
          "s": 29,
          "text": "וכן שם נשמחה בו,"
        },
        {
          "s": 30,
          "text": "דזהו מה שבקרי\"ס הייתה שירת הים וכאו\"א מראה באצבעו ואומר זה א-לי ואנוהו10,"
        },
        {
          "s": 31,
          "text": "נשמחה ובו בעצמותו,"
        },
        {
          "s": 32,
          "text": "הנה כמו\"כ הוא בכל שמחה של מצוה11"
        },
        {
          "s": 33,
          "text": "ושמחת רגלים ועלי' לרגל דאז יראה כל כו' שבא לראות את פני ה' בפרט12."
        }
      ]
    }
  ]
}