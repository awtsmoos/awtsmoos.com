{
  "globalIndex": 532,
  "owner": 32,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916846_theRebbe_939__p003",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916846_theRebbe_939__p003",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916846_theRebbe_939",
  "title": "מאמר באתי לגני תשל\"א",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 1,
          "text": "דבמאמר המדרש עיקר שכינה בתחתונים היתה,"
        },
        {
          "s": 2,
          "text": "שני ענינים."
        },
        {
          "s": 3,
          "text": "המעלה דתחתונים"
        },
        {
          "s": 4,
          "text": "(לגבי עליונים),"
        },
        {
          "s": 5,
          "text": "שבהם דוקא היתה עיקר שכינה,"
        },
        {
          "s": 6,
          "text": "ושדרגת השכינה שהיתה בתחתונים היא"
        },
        {
          "s": 7,
          "text": "(לא שכינה סתם,"
        },
        {
          "s": 8,
          "text": "אלא)"
        },
        {
          "s": 9,
          "text": "עיקר שכינה."
        },
        {
          "s": 10,
          "text": "והענינים שבהמאמר"
        },
        {
          "s": 11,
          "text": "(בפרק הראשון)"
        },
        {
          "s": 12,
          "text": "הם ביאור על שני ענינים אלה."
        },
        {
          "s": 13,
          "text": "דזה שנתאוה שהגילוי אלקות למטה"
        },
        {
          "s": 14,
          "text": "(דירה בתחתונים)"
        },
        {
          "s": 15,
          "text": "יהי' ע\"י עבודת האדם מדגיש מעלת התחתונים."
        },
        {
          "s": 16,
          "text": "דנוסף לזה שנתאוה שהדירה"
        },
        {
          "s": 17,
          "text": "(גילוי אלקות)"
        },
        {
          "s": 18,
          "text": "תהי' בתחתונים,"
        },
        {
          "s": 19,
          "text": "נתאוה שגם עשיית הדירה תהי' ע\"י עבודת התחתונים."
        },
        {
          "s": 20,
          "text": "דע\"י שהגילוי אלקות בהתחתונים נמשך ע\"י עבודתם,"
        },
        {
          "s": 21,
          "text": "הם כלים להגילוי,"
        },
        {
          "s": 22,
          "text": "ויתירה מזה,"
        },
        {
          "s": 23,
          "text": "שהגילוי שנמשך בהם הוא מצד ענין התחתונים גופא."
        },
        {
          "s": 24,
          "text": "ומוסיף,"
        },
        {
          "s": 25,
          "text": "שהעבודה שעל ידה נעשית הדירה היא העבודה דאתכפיא ואתהפכא,"
        },
        {
          "s": 26,
          "text": "כי עי\"ז מודגש עוד יותר שהגילוי שנמשך בהתחתונים הוא מצד ענינם."
        },
        {
          "s": 27,
          "text": "דנוסף לזה שהגילוי שנמשך בהם הוא ע\"י עבודתם,"
        },
        {
          "s": 28,
          "text": "גם העבודה"
        },
        {
          "s": 29,
          "text": "(שעל ידה נמשך הגילוי)"
        },
        {
          "s": 30,
          "text": "היא עבודה שמצד ענין התחתונים."
        },
        {
          "s": 31,
          "text": "וזה שההמשכה שע\"י העבודה דאתכפיא ואתהפכא הוא המשכת האור שהוא בכולהו עלמין בשוה הוא ביאור על הלשון עיקר שכינה בתחתונים,"
        },
        {
          "s": 32,
          "text": "וכמבואר במק\"א21"
        },
        {
          "s": 33,
          "text": "שעיקר שכינה הוא האור שלמעלה מעולמות."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ולהוסיף,"
        },
        {
          "s": 2,
          "text": "דשני ענינים הנ\"ל מובנים גם מלשון רז\"ל16"
        },
        {
          "s": 3,
          "text": "נתאוה כו' דירה בתחתונים,"
        },
        {
          "s": 4,
          "text": "נתאוה דוקא."
        },
        {
          "s": 5,
          "text": "והענין הוא,"
        },
        {
          "s": 6,
          "text": "דבזהר ובע\"ח איתא,"
        },
        {
          "s": 7,
          "text": "שישנם טעמים על בריאת העולמות"
        },
        {
          "s": 8,
          "text": "[דבזהר22"
        },
        {
          "s": 9,
          "text": "איתא שהטעם הוא בגין דישתמודעון לי' ובע\"ח23"
        },
        {
          "s": 10,
          "text": "איתא דהטעם הוא בכדי שיתגלו שלימות כחותיו ופעולותיו],"
        },
        {
          "s": 11,
          "text": "ובמרז\"ל הנ\"ל איתא דבריאת העולמות היתה לפי שנתאוה הקב\"ה להיות לו ית' דירה בתחתונים,"
        },
        {
          "s": 12,
          "text": "דענין נתאוה הוא למעלה מטעם,"
        },
        {
          "s": 13,
          "text": "ובלשון אדמו\"ר הזקן24"
        },
        {
          "s": 14,
          "text": "אויף אַ תאוה איז קיין קשיא,"
        },
        {
          "s": 15,
          "text": "היינו שענין התאוה הוא במקום"
        },
        {
          "s": 16,
          "text": "(דרגא)"
        },
        {
          "s": 17,
          "text": "שאין שייך שם קושיא לפי שהוא למעלה מהשכל."
        },
        {
          "s": 18,
          "text": "וידוע הביאור בזה,"
        },
        {
          "s": 19,
          "text": "דבזהר ובע\"ח מדבר בענין בריאת העולמות כמו שהיא מצד בחינת הגילויים,"
        },
        {
          "s": 20,
          "text": "וכיון שגילויים גם גילויים הכי נעלים הם מוגדרים באיזה גדר,"
        },
        {
          "s": 21,
          "text": "הרצון לעשיית איזה דבר הוא מפני שאותו הדבר הוא בהתאם להגדר שלהם"
        },
        {
          "s": 22,
          "text": "(טעם),"
        },
        {
          "s": 23,
          "text": "ובמארז\"ל הנ\"ל מדבר בענין הבריאה שמצד העצמות,"
        },
        {
          "s": 24,
          "text": "דכיון שאינו מוגדר בשום גדר,"
        },
        {
          "s": 25,
          "text": "הרצון לבריאת העולמות שבהעצמות הוא לא מפני שיש איזה עילוי בהבריאה אלא שכך נתאוה,"
        },
        {
          "s": 26,
          "text": "למעלה מטעם."
        },
        {
          "s": 27,
          "text": "וכמו שהענין דנתאוה הוא בהעצמות,"
        },
        {
          "s": 28,
          "text": "גם הענין שהוא מתאוה אליו הוא שיהי' לו דירה בתחתונים,"
        },
        {
          "s": 29,
          "text": "דענין דירה הוא25"
        },
        {
          "s": 30,
          "text": "ע\"ד דירת האדם שעצמות האדם דר בהדירה,"
        },
        {
          "s": 31,
          "text": "היינו שבהתחתונים תהי' המשכת וגילוי העצמות."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "והנה ידוע26"
        },
        {
          "s": 1,
          "text": "דההוכחה על זה שהסיבה לבריאת העולמות היא לפי שנתאוה"
        },
        {
          "s": 2,
          "text": "(למעלה מהטעם),"
        },
        {
          "s": 3,
          "text": "היא,"
        },
        {
          "s": 4,
          "text": "כי בכדי שיהי' הענין דישתמודעון לי'"
        },
        {
          "s": 5,
          "text": "(ידיעת אלקות)"
        },
        {
          "s": 6,
          "text": "הי' מספיק בהתהוות עולמות העליונים"
        },
        {
          "s": 7,
          "text": "(עולם האצילות ועולמות הא\"ס שלמעלה מאצילות)"
        },
        {
          "s": 8,
          "text": "ולא הי' צריך להיות התהוות עולמות התחתונים."
        },
        {
          "s": 9,
          "text": "ואדרבא,"
        },
        {
          "s": 10,
          "text": "עיקר הענין דישתמודעון לי' הוא דוקא בעולמות העליונים."
        },
        {
          "s": 11,
          "text": "דהידיעה וההשגה באלקות שבעולמות התחתונים"
        },
        {
          "s": 12,
          "text": "(עולמות בי\"ע הרוחניים)"
        },
        {
          "s": 13,
          "text": "היא רק בהמציאות דאלקות ולא בהמהות."
        },
        {
          "s": 14,
          "text": "ומכש\"כ בעולם העשי' הגשמי שאין נרגש בו גם המציאות דאלקות."
        },
        {
          "s": 15,
          "text": "ועד\"ז הוא בהטעם דיתגלו שלימות כחותיו ופעולותיו,"
        },
        {
          "s": 16,
          "text": "שבכדי שיתגלו שלימות כחותיו הי' מספיק בהתהוות עולמות העליונים,"
        },
        {
          "s": 17,
          "text": "דכיון שגם עולמות העליונים הם מציאות והתהוותם היא בדרך התחדשות"
        },
        {
          "s": 18,
          "text": "(יש מאין),"
        },
        {
          "s": 19,
          "text": "לכן ע\"י שאוא\"ס מהווה אותם מתגלה הכח שבו27"
        },
        {
          "s": 20,
          "text": "(שבכחו להוות דבר חדש)28."
        },
        {
          "s": 21,
          "text": "ויתירה מזו יש לומר,"
        },
        {
          "s": 22,
          "text": "שעיקר גילוי שלימות כחותיו הוא דוקא בהתהוות עולמות העליונים."
        },
        {
          "s": 23,
          "text": "דכיון שהתהוות עולמות התחתונים"
        },
        {
          "s": 24,
          "text": "(בי\"ע)"
        },
        {
          "s": 25,
          "text": "הוא ע\"י שהכח האלקי שמהווה אותם הוא מתעלם מהם,"
        },
        {
          "s": 26,
          "text": "הרי בפעולה זו דהכח"
        },
        {
          "s": 27,
          "text": "(התהוות בי\"ע),"
        },
        {
          "s": 28,
          "text": "אין מתגלה הכח."
        },
        {
          "s": 29,
          "text": "ומכש\"כ שאינו מתגלה בהתהוות עוה\"ז התחתון,"
        },
        {
          "s": 30,
          "text": "שההעלם דכח המהווה הוא עוד יותר."
        },
        {
          "s": 31,
          "text": "ומזה שנתהוו"
        },
        {
          "s": 32,
          "text": "(גם)"
        },
        {
          "s": 33,
          "text": "עולמות בי\"ע הרוחניים,"
        },
        {
          "s": 34,
          "text": "ומכש\"כ מההתהוות דעוה\"ז הגשמי,"
        },
        {
          "s": 35,
          "text": "שאין בו"
        },
        {
          "s": 36,
          "text": "(מצד עצמו)"
        },
        {
          "s": 37,
          "text": "שום מעלה,"
        },
        {
          "s": 38,
          "text": "ובלשון אדמו\"ר הזקן29"
        },
        {
          "s": 39,
          "text": "תחתון שאין תחתון למטה ממנו,"
        },
        {
          "s": 40,
          "text": "מוכח,"
        },
        {
          "s": 41,
          "text": "שתכלית כוונת הבריאה היא"
        },
        {
          "s": 42,
          "text": "(לא מצד הטעם,"
        },
        {
          "s": 43,
          "text": "אלא)"
        },
        {
          "s": 44,
          "text": "לפי שכך נתאווה שעוה\"ז התחתון יהי' דירה לו ית',"
        },
        {
          "s": 45,
          "text": "לו לעצמותו."
        }
      ]
    }
  ]
}