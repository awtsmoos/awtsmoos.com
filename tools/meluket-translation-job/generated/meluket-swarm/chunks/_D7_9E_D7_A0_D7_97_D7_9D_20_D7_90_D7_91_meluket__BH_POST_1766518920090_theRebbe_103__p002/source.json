{
  "globalIndex": 1069,
  "owner": 19,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518920090_theRebbe_103__p002",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518920090_theRebbe_103__p002",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518920090_theRebbe_103",
  "title": "מאמר ושמתי כדכד שמשתיך תשט\"ז",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ולהבין זה צריך להקדים תחלה משנת\"ל6"
        },
        {
          "s": 1,
          "text": "דוהי' עקב קאי על הזמן דעקבתא דמשיחא,"
        },
        {
          "s": 2,
          "text": "דאז הנה תשמעון ודאי,"
        },
        {
          "s": 3,
          "text": "לפי שהוא דור האחרון,"
        },
        {
          "s": 4,
          "text": "ולא ידח ממנו נדח,"
        },
        {
          "s": 5,
          "text": "ולזאת הנה בדור זה תשמעון ודאי."
        },
        {
          "s": 6,
          "text": "וכללות העבודה הוא תשמעון ושמרתם ועשיתם,"
        },
        {
          "s": 7,
          "text": "שהוא מחשבה דבור ומעשה,"
        },
        {
          "s": 8,
          "text": "וכאשר המחדומ\"ע שלו יהיו מחדומ\"ע של נה\"א לבדו,"
        },
        {
          "s": 9,
          "text": "והוא מחדומ\"ע דתומ\"צ,"
        },
        {
          "s": 10,
          "text": "אזי הנה ושמר ה\"א לך את הברית ואת החסד ואת השבועה,"
        },
        {
          "s": 11,
          "text": "שיומשך המחדומ\"ע שמלמעלה אליו."
        },
        {
          "s": 12,
          "text": "דבכללות הוא שע\"י עבודתו נעשה יחוד העובד עם הנעבד,"
        },
        {
          "s": 13,
          "text": "יחוד נש\"י עם הקב\"ה,"
        },
        {
          "s": 14,
          "text": "יחוד פב\"פ,"
        },
        {
          "s": 15,
          "text": "וע\"י האהבה דבכל מאדך7"
        },
        {
          "s": 16,
          "text": "ממשיך הגילויים שלמעלה מהשתלשלות."
        },
        {
          "s": 17,
          "text": "אמנם זה שע\"י עבודתו ממשיך הגילוי שמלמעלה,"
        },
        {
          "s": 18,
          "text": "הוא רק מצד הכריתת ברית בלבד,"
        },
        {
          "s": 19,
          "text": "שהרי לאו מכל אלין מדות איהו כלל,"
        },
        {
          "s": 20,
          "text": "ובכדי שמעשה הנבראים יהי' תופס מקום,"
        },
        {
          "s": 21,
          "text": "הוא רק מצד הברית."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה ענין הברית הוא התורה,"
        },
        {
          "s": 2,
          "text": "כמ\"ש8"
        },
        {
          "s": 3,
          "text": "את הברית אשר כרת עמנו בחורב9,"
        },
        {
          "s": 4,
          "text": "ובילקוט10"
        },
        {
          "s": 5,
          "text": "ע\"פ11"
        },
        {
          "s": 6,
          "text": "אלה דברי הברית איתא12"
        },
        {
          "s": 7,
          "text": "אין ברית אלא תורה,"
        },
        {
          "s": 8,
          "text": "והיינו שהתורה הוא הברית המאחד נש\"י עם הקב\"ה,"
        },
        {
          "s": 9,
          "text": "וכמ\"ש13"
        },
        {
          "s": 10,
          "text": "אנכי עומד בין הוי' וביניכם,"
        },
        {
          "s": 11,
          "text": "דאנכי מי שאנכי,"
        },
        {
          "s": 12,
          "text": "דלא אתרמיז לא בשום אות ולא בשום קוץ14,"
        },
        {
          "s": 13,
          "text": "דבכללות הוא הכתר,"
        },
        {
          "s": 14,
          "text": "הנה הוא מחבר ישראל וקוב\"ה ע\"י התורה."
        },
        {
          "s": 15,
          "text": "וביאור הענין הוא,"
        },
        {
          "s": 16,
          "text": "ע\"פ הידוע שבכל ממוצע המחבר שני דברים יש ב' בחי',"
        },
        {
          "s": 17,
          "text": "בחי' א' השייכת להעליון,"
        },
        {
          "s": 18,
          "text": "ובחי' ב' השייכת להתחתון,"
        },
        {
          "s": 19,
          "text": "וע\"י ב' הבחי' שבו נעשה ממוצע המחבר."
        },
        {
          "s": 20,
          "text": "וכמו\"כ יובן גם בהתורה שהיא ממוצע המחבר נש\"י וקוב\"ה,"
        },
        {
          "s": 21,
          "text": "שיש בהתורה בחי' השייכת לנבראים,"
        },
        {
          "s": 22,
          "text": "ובחי' השייכת להקב\"ה,"
        },
        {
          "s": 23,
          "text": "ועי\"ז היא מחברת נש\"י וקוב\"ה."
        },
        {
          "s": 24,
          "text": "דהנה,"
        },
        {
          "s": 25,
          "text": "התורה נתלבשה בדברים גשמיים כו',"
        },
        {
          "s": 26,
          "text": "ומצד זה היא שייכת לנבראים,"
        },
        {
          "s": 27,
          "text": "ובכללות הו\"ע גליא דתורה."
        },
        {
          "s": 28,
          "text": "ויש בחי' בהתורה כמו שהיא בענינים רוחניים,"
        },
        {
          "s": 29,
          "text": "והוא בחי' סתים דתורה שמדברת בעניני אלקות,"
        },
        {
          "s": 30,
          "text": "שלכן הוא סתים"
        },
        {
          "s": 31,
          "text": "(לגבינו),"
        },
        {
          "s": 32,
          "text": "שהרי התורה היא חכמתו ורצונו של הקב\"ה."
        },
        {
          "s": 33,
          "text": "וע\"י ב' בחי' אלו התורה היא ממוצע המחבר אוא\"ס ב\"ה ונש\"י."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "וביאור ב' בחי' אלו בהתורה בעומק יותר,"
        },
        {
          "s": 1,
          "text": "הנה ידוע דמה שאורייתא מחכמה נפקת15"
        },
        {
          "s": 2,
          "text": "אין הכוונה על חכמה תתאה וחכמה עילאה בלבד,"
        },
        {
          "s": 3,
          "text": "כי אם על חכמה סתימאה,"
        },
        {
          "s": 4,
          "text": "דח\"ס הוא הממוצע האמיתי."
        },
        {
          "s": 5,
          "text": "דהנה,"
        },
        {
          "s": 6,
          "text": "כללות הכתר הוא ממוצע בין אוא\"ס המאציל והנאצלים,"
        },
        {
          "s": 7,
          "text": "והוא ע\"י ב' הבחי' שבהכתר,"
        },
        {
          "s": 8,
          "text": "בחי' תחתונה שבמאציל,"
        },
        {
          "s": 9,
          "text": "ובחי' ראשונה שבאצילות,"
        },
        {
          "s": 10,
          "text": "דע\"י ב' בחי' אלו"
        },
        {
          "s": 11,
          "text": "(בחי' תחתונה שבמאציל ושרש ומקור הנאצלים)"
        },
        {
          "s": 12,
          "text": "נעשה הכתר ממוצע לחבר אוא\"ס המאציל עם האצילות."
        },
        {
          "s": 13,
          "text": "אמנם ב' בחי' אלו כמו שהם בכתר,"
        },
        {
          "s": 14,
          "text": "הרי הם ב' מדריגות מיוחדות,"
        },
        {
          "s": 15,
          "text": "ואין זה אמיתית ענין הממוצע,"
        },
        {
          "s": 16,
          "text": "והממוצע האמיתי הוא בחי' חכמה סתימאה,"
        },
        {
          "s": 17,
          "text": "לפי שבח\"ס הנה ב' בחי' אלו"
        },
        {
          "s": 18,
          "text": "(השייכות להמאציל והשייכות לאצי')"
        },
        {
          "s": 19,
          "text": "אינם ב' מדריגות מיוחדות,"
        },
        {
          "s": 20,
          "text": "אלא הם כאחד,"
        },
        {
          "s": 21,
          "text": "ולכן הוא הממוצע האמיתי."
        },
        {
          "s": 22,
          "text": "ויובן זה עד\"מ כמו שאנו רואים למטה בנפש האדם,"
        },
        {
          "s": 23,
          "text": "דבכח החכמה יש ב' ענינים הפכיים,"
        },
        {
          "s": 24,
          "text": "כח ההפשטה וההפלאה,"
        },
        {
          "s": 25,
          "text": "וכח הירידה וההלבשה."
        },
        {
          "s": 26,
          "text": "ענין ההפלאה שבחכמה הוא מה שבכחו להפשיט את השכל מהציורים החומרים וגם מהציורים הגשמיים ואפילו מהציורים הרוחניים,"
        },
        {
          "s": 27,
          "text": "והיינו שמפשיט את השכל מכל הציורים שבו,"
        },
        {
          "s": 28,
          "text": "אורך רוחב ועומק,"
        },
        {
          "s": 29,
          "text": "ונשאר רק הנקודה,"
        },
        {
          "s": 30,
          "text": "שזוהי בחי' הנקודה שבחכמה."
        },
        {
          "s": 31,
          "text": "וענין הירידה וההלבשה דחכמה הוא שבכח החכמה להוריד את המושכל עד למטה מטה,"
        },
        {
          "s": 32,
          "text": "כמו וידבר שלשת אלפים משל16"
        },
        {
          "s": 33,
          "text": "ולמטה יותר."
        },
        {
          "s": 34,
          "text": "והנה,"
        },
        {
          "s": 35,
          "text": "ב' ענינים אלו שבחכמה אינם ב' ענינים נבדלים זה מזה,"
        },
        {
          "s": 36,
          "text": "אלא הוא ענין אחד."
        },
        {
          "s": 37,
          "text": "דכח הירידה הוא מצד כח ההפלאה,"
        },
        {
          "s": 38,
          "text": "דמה שבכחו להוריד את המושכל עד למטה מטה הוא לפי שתופס את עצם נקודת השכל המופשט מכל ציור,"
        },
        {
          "s": 39,
          "text": "ומשום זה דוקא ביכלתו להוריד את השכל עד למטה מטה."
        },
        {
          "s": 40,
          "text": "ועד\"ז יובן למעלה בבחי' ח\"ס,"
        },
        {
          "s": 41,
          "text": "דב' הבחי' שבח\"ס,"
        },
        {
          "s": 42,
          "text": "הבחי' השייכת להמאציל והבחי' השייכת להאצילות,"
        },
        {
          "s": 43,
          "text": "אינם ב' ענינים נבדלים זמ\"ז,"
        },
        {
          "s": 44,
          "text": "אלא הו\"ע אחד,"
        },
        {
          "s": 45,
          "text": "ולכן הנה ח\"ס הוא הממוצע האמיתי."
        },
        {
          "s": 46,
          "text": "וכמו\"כ יובן בתורה,"
        },
        {
          "s": 47,
          "text": "דב' הענינים שבתורה,"
        },
        {
          "s": 48,
          "text": "מה שהיא חכמתו של הקב\"ה,"
        },
        {
          "s": 49,
          "text": "ומה שנתלבשה בדברים גשמיים,"
        },
        {
          "s": 50,
          "text": "אינם ב' בחי' נבדלים זמ\"ז,"
        },
        {
          "s": 51,
          "text": "גליא דתורה וסתים דתורה,"
        },
        {
          "s": 52,
          "text": "כי אם שאורייתא מחכמה"
        },
        {
          "s": 53,
          "text": "(סתימאה)"
        },
        {
          "s": 54,
          "text": "נפקת,"
        },
        {
          "s": 55,
          "text": "ומצד בחי' העליונה שבתורה הנה משום זה דוקא ירדה למטה ונתלבשה בדברים גשמיים."
        },
        {
          "s": 56,
          "text": "ולכן נקראת התורה ברית,"
        },
        {
          "s": 57,
          "text": "שהוא הממוצע האמיתי בין נש\"י ואוא\"ס ב\"ה."
        }
      ]
    }
  ]
}