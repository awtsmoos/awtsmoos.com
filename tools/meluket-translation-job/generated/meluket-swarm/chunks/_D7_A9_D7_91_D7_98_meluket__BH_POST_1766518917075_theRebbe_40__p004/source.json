{
  "globalIndex": 582,
  "owner": 32,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917075_theRebbe_40__p004",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917075_theRebbe_40__p004",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518917075_theRebbe_40",
  "title": "מאמר באתי לגני תשל\"ח",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דזהו גם הפירוש"
        },
        {
          "s": 2,
          "text": "(בפנימיות הענינים)"
        },
        {
          "s": 3,
          "text": "בזה שיתרו הי' כהן מדין,"
        },
        {
          "s": 4,
          "text": "דמדין הוא מלשון מדון ופירוד39,"
        },
        {
          "s": 5,
          "text": "והתחלת ענין הפירוד הוא"
        },
        {
          "s": 6,
          "text": "(כביכול)"
        },
        {
          "s": 7,
          "text": "בדקות וכו' מהמדריגות הכי עליונות שבאצילות."
        },
        {
          "s": 8,
          "text": "כמרז\"ל40"
        },
        {
          "s": 9,
          "text": "עד שלא נברא העולם הי' הוא ושמו בלבד,"
        },
        {
          "s": 10,
          "text": "וידוע שבעד שלא נברא העולם נכלל גם עד שלא נאצל41,"
        },
        {
          "s": 11,
          "text": "והיינו שדוקא קודם שנאצל הי' הוא ושמו בלבד"
        },
        {
          "s": 12,
          "text": "[שהגילוי"
        },
        {
          "s": 13,
          "text": "(שמו)"
        },
        {
          "s": 14,
          "text": "הי' בתכלית היחוד בעצמותו ית'42],"
        },
        {
          "s": 15,
          "text": "אבל לאחרי שנאצל"
        },
        {
          "s": 16,
          "text": "(ע\"י הצמצום),"
        },
        {
          "s": 17,
          "text": "נעשה הגילוי בבחינת מציאות"
        },
        {
          "s": 18,
          "text": "(בערך הביטול והיחוד שהי' עד שלא נאצל),"
        },
        {
          "s": 19,
          "text": "כביכול ענין מדון ופירוד43."
        },
        {
          "s": 20,
          "text": "אלא שזה שנעשה מציאות הוא מצד הצמצום דשם אלקים,"
        },
        {
          "s": 21,
          "text": "ומכיון שההעלם דהצמצום הוא רק לגבינו"
        },
        {
          "s": 22,
          "text": "(היינו לגבי הגילויים שלאחרי הצמצום),"
        },
        {
          "s": 23,
          "text": "והוי' ואלקים כולא חד44,"
        },
        {
          "s": 24,
          "text": "לכן,"
        },
        {
          "s": 25,
          "text": "גם עכשיו הם"
        },
        {
          "s": 26,
          "text": "(באמת)"
        },
        {
          "s": 27,
          "text": "בתכלית היחוד כמו שהי' קודם שנאצל."
        },
        {
          "s": 28,
          "text": "וזהו מה שיתרו הי' כהן מדין,"
        },
        {
          "s": 29,
          "text": "שהיתה לו ידיעה והכרה בכל המדריגות שנאצלו,"
        },
        {
          "s": 30,
          "text": "אלא שידיעתו בהם היתה כמו שהם"
        },
        {
          "s": 31,
          "text": "(מצד הצמצום)"
        },
        {
          "s": 32,
          "text": "בבחינת מציאות,"
        },
        {
          "s": 33,
          "text": "מדון ופירוד."
        },
        {
          "s": 34,
          "text": "ומזה נשתלשל45"
        },
        {
          "s": 35,
          "text": "שהי' כהן מדין כפשוטו,"
        },
        {
          "s": 36,
          "text": "והי' מכיר בכל ע\"ז שבעולם,"
        },
        {
          "s": 37,
          "text": "ע\"ז כפשוטה."
        },
        {
          "s": 38,
          "text": "וע\"י שהי' לו ידיעה והכרה בכל הדרגות"
        },
        {
          "s": 39,
          "text": "(לאחרי שנאצל),"
        },
        {
          "s": 40,
          "text": "בא אח\"כ לידי ידיעה והכרה"
        },
        {
          "s": 41,
          "text": "[והודעה והכרזה]"
        },
        {
          "s": 42,
          "text": "כי גדול הוי' מכל האלקים."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "וע\"פ כל הנ\"ל יש לומר,"
        },
        {
          "s": 2,
          "text": "דזה שהיתרון נעשה בתורה ע\"י הודאת יתרו הוא שנמשך בה העצמות"
        },
        {
          "s": 3,
          "text": "(כנ\"ל סעיף ג),"
        },
        {
          "s": 4,
          "text": "הוא מפני שהודאת יתרו עתה ידעתי כי גדול הוי' מכל האלקים היא הידיעה בהפלאת העצמות שהוא למעלה מגילויים"
        },
        {
          "s": 5,
          "text": "(גדול הוי' מכל האלקים)."
        },
        {
          "s": 6,
          "text": "ומכיון דזה שהגיע לידיעה זו"
        },
        {
          "s": 7,
          "text": "(בהפלאת העצמות)"
        },
        {
          "s": 8,
          "text": "היתה ע\"י הידיעה וההכרה שהיתה לו"
        },
        {
          "s": 9,
          "text": "(לפני זה)"
        },
        {
          "s": 10,
          "text": "בכל הדרגות דגילויים שנאצלו,"
        },
        {
          "s": 11,
          "text": "לכן,"
        },
        {
          "s": 12,
          "text": "היתרון בתורה"
        },
        {
          "s": 13,
          "text": "(המשכת העצמות)"
        },
        {
          "s": 14,
          "text": "הוא באופן ששייך לגילויים,"
        },
        {
          "s": 15,
          "text": "הנתינת כח לכל אחד מישראל לאפשה לה,"
        },
        {
          "s": 16,
          "text": "לגלות את חלקו בתורה46,"
        },
        {
          "s": 17,
          "text": "וכפסק אדמו\"ר הזקן47"
        },
        {
          "s": 18,
          "text": "שכל אחד צריך להשיג בידיעת התורה,"
        },
        {
          "s": 19,
          "text": "ולחדש בה48,"
        },
        {
          "s": 20,
          "text": "הן בפשט והן ברמז הן בדרוש והן בסוד."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ויהי רצון שכן תהי' לנו,"
        },
        {
          "s": 1,
          "text": "שכל אחד יעשה כהנ\"ל,"
        },
        {
          "s": 2,
          "text": "ונזכה לראות בגלוי איך שכל ישראל הם ממלכת כהנים וגוי קדוש49,"
        },
        {
          "s": 3,
          "text": "שכל אחד מישראל יהי' במעמד ומצב של שר50"
        },
        {
          "s": 4,
          "text": "כפשוטו,"
        },
        {
          "s": 5,
          "text": "כי ע\"י ההחלטה ללמוד את התורה ולקיימה גם כשהוא במצב של עוני,"
        },
        {
          "s": 6,
          "text": "הרי כהבטחת חז\"ל51"
        },
        {
          "s": 7,
          "text": "כל המקיים את התורה מעוני סופה לקיימה מעושר,"
        },
        {
          "s": 8,
          "text": "שכשמחליט ללמדה ולקיימה מעוני הנה מיד לאחרי ההחלטה52"
        },
        {
          "s": 9,
          "text": "הוא לומדה ומקיימה מעושר,"
        },
        {
          "s": 10,
          "text": "מעושר אמיתי בגשמיות וברוחניות גם יחד,"
        },
        {
          "s": 11,
          "text": "ומוסיף בלימוד התורה בנגלה ובחסידות,"
        },
        {
          "s": 12,
          "text": "ולימוד מביא לידי מעשה53"
        },
        {
          "s": 13,
          "text": "– קיום המצוות בהידור,"
        },
        {
          "s": 14,
          "text": "און מ'ברענגט אַראָפּ משיח צדקנו למטה מעשרה טפחים בקרוב ממש,"
        },
        {
          "s": 15,
          "text": "ויבנה בית המקדש במקומו ויקבץ נדחי ישראל54,"
        },
        {
          "s": 16,
          "text": "והיתה לה' המלוכה55,"
        },
        {
          "s": 17,
          "text": "בגאולה האמיתית והשלימה ע\"י משיח צדקנו,"
        },
        {
          "s": 18,
          "text": "במהרה בימינו ממש."
        }
      ]
    }
  ]
}