{
  "globalIndex": 874,
  "owner": 24,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918942_theRebbe_422__p001",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918942_theRebbe_422__p001",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918942_theRebbe_422",
  "title": "מאמר וישלח יהושוע תשל\"ו",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ שלח,"
        },
        {
          "s": 2,
          "text": "כ\"ח סיון,"
        },
        {
          "s": 3,
          "text": "מבה\"ח תמוז,"
        },
        {
          "s": 4,
          "text": "ה'תשל\"ו*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "וישלח יהושע גו' שנים אנשים מרגלים גו'1,"
        },
        {
          "s": 1,
          "text": "ומבאר בלקו\"ת"
        },
        {
          "s": 2,
          "text": "(ד\"ה זה2)"
        },
        {
          "s": 3,
          "text": "החילוק בין המרגלים ששלח יהושע להמרגלים ששלח משה,"
        },
        {
          "s": 4,
          "text": "דבמרגלים ששלח משה כתיב3"
        },
        {
          "s": 5,
          "text": "שלח לך לדעתך אני איני מצוה לך,"
        },
        {
          "s": 6,
          "text": "משא\"כ שילוח המרגלים דיהושע הי'"
        },
        {
          "s": 7,
          "text": "(לא מדעתו אלא)"
        },
        {
          "s": 8,
          "text": "ע\"פ ציווי ה'."
        },
        {
          "s": 9,
          "text": "ועוד חילוק,"
        },
        {
          "s": 10,
          "text": "דהמרגלים ששלח יהושע היו רק ליריחו,"
        },
        {
          "s": 11,
          "text": "מנעולה של ארץ ישראל4,"
        },
        {
          "s": 12,
          "text": "ועי\"ז תרו את כל הארץ5,"
        },
        {
          "s": 13,
          "text": "משא\"כ המרגלים ששלח משה הלכו בכל הארץ לארכה ולרחבה6."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ונקודת הביאור בזה,"
        },
        {
          "s": 2,
          "text": "שהציווי דכיבוש הארץ"
        },
        {
          "s": 3,
          "text": "(ברוחניות)"
        },
        {
          "s": 4,
          "text": "הוא"
        },
        {
          "s": 5,
          "text": "(ככל הציוויים שבתורה)"
        },
        {
          "s": 6,
          "text": "ענין נצחי בכל דור ודור7."
        },
        {
          "s": 7,
          "text": "דכאו\"א מישראל צריך לכבוש8"
        },
        {
          "s": 8,
          "text": "כל הכחות והענינים דגופו ונפשו הבהמית"
        },
        {
          "s": 9,
          "text": "(ארץ כנען)"
        },
        {
          "s": 10,
          "text": "ולעשותם כלים לאלקות"
        },
        {
          "s": 11,
          "text": "(ארץ ישראל)."
        },
        {
          "s": 12,
          "text": "והחילוק בין יריחו לכללות הארץ בנפש האדם הוא9,"
        },
        {
          "s": 13,
          "text": "דיריחו הוא ג' הלבושים מחשבה דיבור ומעשה"
        },
        {
          "s": 14,
          "text": "[כי יריחו הוא מלשון ריח,"
        },
        {
          "s": 15,
          "text": "ולבושים שייכים לריח,"
        },
        {
          "s": 16,
          "text": "וכרמז לשון הזהר10"
        },
        {
          "s": 17,
          "text": "בריחא דלבושייכו],"
        },
        {
          "s": 18,
          "text": "וכללות הארץ"
        },
        {
          "s": 19,
          "text": "(ארץ ז' עממין)"
        },
        {
          "s": 20,
          "text": "הם המדות שבאדם."
        },
        {
          "s": 21,
          "text": "וזהו מה שהציווי"
        },
        {
          "s": 22,
          "text": "(ליהושע)"
        },
        {
          "s": 23,
          "text": "לשלוח מרגלים הי' שילכו"
        },
        {
          "s": 24,
          "text": "(רק)"
        },
        {
          "s": 25,
          "text": "ליריחו,"
        },
        {
          "s": 26,
          "text": "כי מחשבה דיבור ומעשה הם ברשותו של אדם,"
        },
        {
          "s": 27,
          "text": "ולכן יש ציווי לכאו\"א לתור ולבחון את המחשבה דיבור ומעשה שלו שיהיו כולם להוי'."
        },
        {
          "s": 28,
          "text": "משא\"כ המדות שבלב אינם ברשותו של כל אדם,"
        },
        {
          "s": 29,
          "text": "דצדיקים"
        },
        {
          "s": 30,
          "text": "(דוקא)"
        },
        {
          "s": 31,
          "text": "לבם ברשותם11,"
        },
        {
          "s": 32,
          "text": "ולכן במרגלים ששלח משה לתור את כל הארץ"
        },
        {
          "s": 33,
          "text": "(לבחון את המדות,"
        },
        {
          "s": 34,
          "text": "שיהיו כולם להוי')"
        },
        {
          "s": 35,
          "text": "כתיב שלח לך לדעתך,"
        },
        {
          "s": 36,
          "text": "אני איני מצוה לך,"
        },
        {
          "s": 37,
          "text": "כי העבודה דכיבוש המדות"
        },
        {
          "s": 38,
          "text": "(בשלימות)"
        },
        {
          "s": 39,
          "text": "היא דוקא ע\"י גילוי בחי' משה,"
        },
        {
          "s": 40,
          "text": "ואינה שוה לכל נפש."
        }
      ]
    }
  ]
}