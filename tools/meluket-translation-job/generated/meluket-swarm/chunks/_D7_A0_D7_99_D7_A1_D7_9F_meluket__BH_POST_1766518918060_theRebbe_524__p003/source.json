{
  "globalIndex": 734,
  "owner": 34,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918060_theRebbe_524__p003",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918060_theRebbe_524__p003",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518918060_theRebbe_524",
  "title": "מאמר ועבדי דוד תשמ\"ו",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ובזה יובן מ\"ש ועבדי דוד מלך עליהם ורועה אחד יהי' לכולם כו' ולא יחצו עוד לשתי ממלכות עוד."
        },
        {
          "s": 2,
          "text": "כי גם לע\"ל יהיו ב' ממלכות דיהודה ויוסף,"
        },
        {
          "s": 3,
          "text": "היינו ב' אופני העבודה דתורה ומצוות,"
        },
        {
          "s": 4,
          "text": "ואדרבה,"
        },
        {
          "s": 5,
          "text": "אז יהי' תכלית השלימות דלימוד התורה,"
        },
        {
          "s": 6,
          "text": "שהרי אז מלאכתן נעשית ע\"י אחרים28"
        },
        {
          "s": 7,
          "text": "ואפשר להיות עסק התורה באופן דתורתן אומנתן29."
        },
        {
          "s": 8,
          "text": "ובזה הוא החידוש,"
        },
        {
          "s": 9,
          "text": "דאעפ\"כ עבדי דוד מלך עליהם,"
        },
        {
          "s": 10,
          "text": "מעשה גדול,"
        },
        {
          "s": 11,
          "text": "שכל העבודות אז"
        },
        {
          "s": 12,
          "text": "(גם לימוד התורה)"
        },
        {
          "s": 13,
          "text": "יהיו באופן דמעשה וכפי',"
        },
        {
          "s": 14,
          "text": "היינו למעלה מכל המיצרים וגבולים."
        },
        {
          "s": 15,
          "text": "וזהו גם הדיוק ודוד עבדי דוקא,"
        },
        {
          "s": 16,
          "text": "שיהי' בבחי' עבד,"
        },
        {
          "s": 17,
          "text": "עבד נאמן30,"
        },
        {
          "s": 18,
          "text": "תכלית השלימות,"
        },
        {
          "s": 19,
          "text": "בחי' יחידה ליחדך31,"
        },
        {
          "s": 20,
          "text": "שיש רק הענין דיחיד בלי שום פניות."
        },
        {
          "s": 21,
          "text": "וזה נמשך,"
        },
        {
          "s": 22,
          "text": "כנ\"ל,"
        },
        {
          "s": 23,
          "text": "גם בלימוד התורה דלעתיד,"
        },
        {
          "s": 24,
          "text": "וכנ\"ל דאז יהי' לימוד התורה באופן דתורתן אומנתן כו'."
        },
        {
          "s": 25,
          "text": "ועד שלא יחצו עוד לשתי ממלכות"
        },
        {
          "s": 26,
          "text": "(ושתי מחנות),"
        },
        {
          "s": 27,
          "text": "וכמ\"ש לפני זה32,"
        },
        {
          "s": 28,
          "text": "וקרב אותם אחד אל אחד לך לעץ אחד והיו לאחדים בידיך."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "והנה נת\"ל שכל הגילויים דלע\"ל תלויים במעשינו ועבודתינו."
        },
        {
          "s": 2,
          "text": "ועד\"ז יובן גם בענין זה דועבדי דוד מלך עליהם,"
        },
        {
          "s": 3,
          "text": "שזה נעשה ע\"י ההכנה בעבודת האדם בזמן הזה."
        },
        {
          "s": 4,
          "text": "וי\"ל שזהו מ\"ש הרמב\"ם שם33,"
        },
        {
          "s": 5,
          "text": "שתחלת העבודה היא שלא לשמה ומתוך שלא לשמה בא לעבודה לשם חיי עוה\"ב,"
        },
        {
          "s": 6,
          "text": "ועד שסוף סוף בא לשמה,"
        },
        {
          "s": 7,
          "text": "לעבודה כאברהם אבינו,"
        },
        {
          "s": 8,
          "text": "שקראו הקב\"ה אוהבו."
        },
        {
          "s": 9,
          "text": "דמזה שענין זה נפסק להלכה בספר הרמב\"ם,"
        },
        {
          "s": 10,
          "text": "מובן שענין זה נדרש מכאו\"א מישראל,"
        },
        {
          "s": 11,
          "text": "ומבקש לפי כוחם,"
        },
        {
          "s": 12,
          "text": "דישנם הכחות בכאו\"א מישראל להגיע לעבודה זו."
        },
        {
          "s": 13,
          "text": "ואולי י\"ל ע\"ד הרמז,"
        },
        {
          "s": 14,
          "text": "שזה שהנ\"ל הוא הכנה אל הגילויים דלעתיד,"
        },
        {
          "s": 15,
          "text": "נרמז במ\"ש הרמב\"ם ענין זה בפרק עשירי מהלכות תשובה,"
        },
        {
          "s": 16,
          "text": "דידוע34"
        },
        {
          "s": 17,
          "text": "דענין התשובה הוא החידוש דלע\"ל,"
        },
        {
          "s": 18,
          "text": "כמאמר35"
        },
        {
          "s": 19,
          "text": "משיח עתיד לאתבא צדיקייא בתיובתא."
        },
        {
          "s": 20,
          "text": "דמזה מובן,"
        },
        {
          "s": 21,
          "text": "שע\"י עבודה זו דלשמה בתכלית השלימות"
        },
        {
          "s": 22,
          "text": "(עשר),"
        },
        {
          "s": 23,
          "text": "באים להגילוי דלע\"ל,"
        },
        {
          "s": 24,
          "text": "ועבדי דוד מלך עליהם."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ויהי רצון שכן יהי' במהרה בימינו ממש,"
        },
        {
          "s": 2,
          "text": "שיקויים היעוד36"
        },
        {
          "s": 3,
          "text": "דכי מלאה הארץ דעה את ה' כמים לים מכסים,"
        },
        {
          "s": 4,
          "text": "היינו לא רק שישיגו דעת בוראם כפי כח האדם37,"
        },
        {
          "s": 5,
          "text": "ובאופן דיחוד נפלא שאין יחוד כמוהו כו',"
        },
        {
          "s": 6,
          "text": "אלא יתירה מזו,"
        },
        {
          "s": 7,
          "text": "שיגיעו לבחי' כמים לים מכסים38,"
        },
        {
          "s": 8,
          "text": "בחי' עבד נאמן שאינו מציאות בפני עצמו כלל."
        },
        {
          "s": 9,
          "text": "ויקויים היעוד39"
        },
        {
          "s": 10,
          "text": "והיתה לה' המלוכה בכל העולם כולו,"
        },
        {
          "s": 11,
          "text": "ובפרט בישראל עם קרובו40,"
        },
        {
          "s": 12,
          "text": "שכל אחד מהם הוא כבן יחיד להקב\"ה41,"
        },
        {
          "s": 13,
          "text": "הקשור עם בחי' יחיד שלמעלה,"
        },
        {
          "s": 14,
          "text": "יחידה ליחדך."
        },
        {
          "s": 15,
          "text": "ויקויים גם המשך הפסוק42,"
        },
        {
          "s": 16,
          "text": "והי' ה' למלך על כל הארץ ביום ההוא יהי' ה' אחד ושמו אחד,"
        },
        {
          "s": 17,
          "text": "כפי שאני נכתב כך אני נקרא43,"
        },
        {
          "s": 18,
          "text": "שיהי' נקרא"
        },
        {
          "s": 19,
          "text": "(בגלוי)"
        },
        {
          "s": 20,
          "text": "בשם העצם ושם המפורש ושם המיוחד44,"
        },
        {
          "s": 21,
          "text": "ויהי' גילוי בחי' אחדות הפשוטה דלמעלה,"
        },
        {
          "s": 22,
          "text": "אשר הפשיטות דלמעלה קשורה עם הפשיטות דאדם פשוט שלמטה45,"
        },
        {
          "s": 23,
          "text": "בגאולה האמיתית והשלימה,"
        },
        {
          "s": 24,
          "text": "במהרה בימינו ממש,"
        },
        {
          "s": 25,
          "text": "ע\"י משיח צדקנו."
        }
      ]
    }
  ]
}