{
  "globalIndex": 779,
  "owner": 29,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918380_theRebbe_210__p006",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918380_theRebbe_210__p006",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918380_theRebbe_210",
  "title": "מאמר דבר אל..קדושים תהיו תשכ\"א",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "וע\"פ הידוע62"
        },
        {
          "s": 1,
          "text": "שכל אחד"
        },
        {
          "s": 2,
          "text": "(גם כשהוא בדרגת בינוני ואפילו למטה מבינוני)"
        },
        {
          "s": 3,
          "text": "שמקיים מצוות נקרא בשם צדיק"
        },
        {
          "s": 4,
          "text": "[כי כללות המצוות נק' בשם צדקה63,"
        },
        {
          "s": 5,
          "text": "ולכן המקיים את המצוות נקרא בשם צדיק על שם הצדקה"
        },
        {
          "s": 6,
          "text": "(מצוות62)],"
        },
        {
          "s": 7,
          "text": "יש לומר,"
        },
        {
          "s": 8,
          "text": "שהענין דאתהפכא הוא לא רק בצדיקים כפשוטם אלא גם במקיימי מצוות בכלל."
        },
        {
          "s": 9,
          "text": "דכיון שלא ניתנו המצוות אלא לצרף בהן את הבריות64"
        },
        {
          "s": 10,
          "text": "(צירוף מלשון בירור וזיכוך),"
        },
        {
          "s": 11,
          "text": "ובכל פעם כשאדם מקיים מצוה נתברר פרט של הגוף ונה\"ב,"
        },
        {
          "s": 12,
          "text": "הרי בנוגע לפרט זה שנתברר כבר הוא בחינת צדיק,"
        },
        {
          "s": 13,
          "text": "אתהפכא."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ויש65 לקשר זה עם המבואר בהמאמר ד\"ה להבין ענין פסח שני"
        },
        {
          "s": 2,
          "text": "(להצ\"צ)66,"
        },
        {
          "s": 3,
          "text": "דהחילוק בין פסח ראשון לפסח שני הוא בהתאם להחילוק שבין חודש ניסן לחודש אייר."
        },
        {
          "s": 4,
          "text": "שהעבודה דחודש ניסן,"
        },
        {
          "s": 5,
          "text": "שענינו הוא יציאת מצרים,"
        },
        {
          "s": 6,
          "text": "היא העבודה דסור מרע,"
        },
        {
          "s": 7,
          "text": "היינו שהרע הוא בתקפו והעבודה היא להיות סור מרע,"
        },
        {
          "s": 8,
          "text": "לצאת ולברוח מהרע,"
        },
        {
          "s": 9,
          "text": "אתכפיא67."
        },
        {
          "s": 10,
          "text": "והעבודה דחודש אייר היא העבודה דאתהפכא."
        },
        {
          "s": 11,
          "text": "וכמבואר בלקו\"ת68"
        },
        {
          "s": 12,
          "text": "בפירוש הכתוב69"
        },
        {
          "s": 13,
          "text": "באחד לחודש השני גו' לצאתם מארץ מצרים,"
        },
        {
          "s": 14,
          "text": "שעבודה הראשונה דיציאת מצרים,"
        },
        {
          "s": 15,
          "text": "חודש הראשון,"
        },
        {
          "s": 16,
          "text": "היא אתכפיא סט\"א,"
        },
        {
          "s": 17,
          "text": "ולאחרי זה באה עבודה שני' ביציאת מצרים,"
        },
        {
          "s": 18,
          "text": "חודש השני,"
        },
        {
          "s": 19,
          "text": "אתהפכא."
        },
        {
          "s": 20,
          "text": "וזהו שענינו המיוחד של חודש אייר הוא ספירת העומר70,"
        },
        {
          "s": 21,
          "text": "שענינו הוא71"
        },
        {
          "s": 22,
          "text": "בירור המדות והפיכתם לקדושה,"
        },
        {
          "s": 23,
          "text": "אתהפכא."
        },
        {
          "s": 24,
          "text": "ועפ\"ז מבאר בהמאמר72"
        },
        {
          "s": 25,
          "text": "הטעם על זה שבפסח ראשון חמץ אסור בבל יראה ובל ימצא ובפסח שני חמץ ומצה עמו בבית73,"
        },
        {
          "s": 26,
          "text": "כי בפסח ראשון,"
        },
        {
          "s": 27,
          "text": "שהמדות עדיין אינן מבוררות"
        },
        {
          "s": 28,
          "text": "(והעבודה אז היא רק אתכפיא),"
        },
        {
          "s": 29,
          "text": "צריך ליזהר ביותר מהרע – בל יראה ובל ימצא,"
        },
        {
          "s": 30,
          "text": "ובפסח שני"
        },
        {
          "s": 31,
          "text": "(אייר),"
        },
        {
          "s": 32,
          "text": "שכבר יצא מהרע74"
        },
        {
          "s": 33,
          "text": "(אתהפכא),"
        },
        {
          "s": 34,
          "text": "אפשר לברר לזכך ולהעלות גם את החמץ."
        },
        {
          "s": 35,
          "text": "[ולהעיר,"
        },
        {
          "s": 36,
          "text": "שעד\"ז הוא החילוק דצדיקים"
        },
        {
          "s": 37,
          "text": "(אתהפכא)"
        },
        {
          "s": 38,
          "text": "ובעלי תשובה"
        },
        {
          "s": 39,
          "text": "(אתכפיא),"
        },
        {
          "s": 40,
          "text": "שצדיק צריך לומר אפשי ומה אעשה ואבי שבשמים גזר עלי75,"
        },
        {
          "s": 41,
          "text": "משא\"כ בעל תשובה צריך לומר אי אפשי,"
        },
        {
          "s": 42,
          "text": "שצריך לשמירה יתירה76]."
        },
        {
          "s": 43,
          "text": "ומזה מוכח שהענין דאתהפכא הוא גם בנוגע לענין פרטי."
        },
        {
          "s": 44,
          "text": "שהרי פסח שני הוא באמצע ימי הספירה ונשארו עדיין מדות שצריך לבררם,"
        },
        {
          "s": 45,
          "text": "ומ\"מ אומר בהמאמר שבפסח שני הוא הענין דאתהפכא,"
        },
        {
          "s": 46,
          "text": "כי בנוגע להמדות שנתבררו בהימים שלפני פסח שני כבר יצא מהרע,"
        },
        {
          "s": 47,
          "text": "אתהפכא."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "והנה77 הטעם על זה שיציאת מצרים היא באופן דאתכפיא וספירת העומר היא באופן דאתהפכא,"
        },
        {
          "s": 1,
          "text": "הוא,"
        },
        {
          "s": 2,
          "text": "כי יציאת מצרים היתה מצד אתערותא דלעילא,"
        },
        {
          "s": 3,
          "text": "והגילוי הנמשך מלמעלה"
        },
        {
          "s": 4,
          "text": "(שלא ע\"י עבודת האדם)"
        },
        {
          "s": 5,
          "text": "אינו נמשך בפנימיות כ\"כ,"
        },
        {
          "s": 6,
          "text": "וספירת העומר היא עבודת האדם,"
        },
        {
          "s": 7,
          "text": "אתערותא דלתתא,"
        },
        {
          "s": 8,
          "text": "והגילוי הנמשך מלמעלה ע\"י עבודת האדם"
        },
        {
          "s": 9,
          "text": "[אתערותא דלעילא שע\"י אתערותא דלתתא]"
        },
        {
          "s": 10,
          "text": "הוא בפנימיות."
        },
        {
          "s": 11,
          "text": "והגם שהגילוי שבא מלמעלה הוא נעלה יותר מהגילוי שנמשך ע\"י עבודת האדם"
        },
        {
          "s": 12,
          "text": "[כי הנברא בעבודתו יכול להגיע רק עד שרשו78],"
        },
        {
          "s": 13,
          "text": "דכמו\"כ הוא גם בנוגע ליצי\"מ וספירת העומר,"
        },
        {
          "s": 14,
          "text": "שהגילוי שהי' ביציאת מצרים הוא שנגלה עליהם מלך מלכי המלכים הקב\"ה בכבודו ובעצמו79,"
        },
        {
          "s": 15,
          "text": "וחודש אייר נקרא בשם חודש זיו80"
        },
        {
          "s": 16,
          "text": "כי הגילוי שנמשך בחודש זה הוא הארה בלבד"
        },
        {
          "s": 17,
          "text": "[ויש לומר,"
        },
        {
          "s": 18,
          "text": "דנוסף לזה שהגילוי שנמשך ע\"י עבודת האדם הוא למטה מהגילוי שנמשך בדרך אתערותא דלעילא מצד עצמה,"
        },
        {
          "s": 19,
          "text": "בנוגע להגילוי שנמשך ע\"י העבודה דספירת העומר הוא עוד יותר."
        },
        {
          "s": 20,
          "text": "כי כיון שהעבודה דספירת העומר היא"
        },
        {
          "s": 21,
          "text": "(הכנה ו)"
        },
        {
          "s": 22,
          "text": "קודם מתן תורה,"
        },
        {
          "s": 23,
          "text": "לכן,"
        },
        {
          "s": 24,
          "text": "הגילוי שנמשך ע\"י העבודה דספירת העומר הוא דוגמת הגילוי שע\"י עבודת האבות לפני מתן תורה"
        },
        {
          "s": 25,
          "text": "(כשהיתה הגזירה והמחיצה בין עליונים ותחתונים81)"
        },
        {
          "s": 26,
          "text": "שהוא למטה יותר מהגילוי שנמשך ע\"י העבודה לאחרי מתן תורה"
        },
        {
          "s": 27,
          "text": "(אף שגם הגילוי שנמשך ע\"י אתערותא דלתתא עכשיו הוא למטה מהגילוי הנמשך מלמעלה מצד עצמו)."
        },
        {
          "s": 28,
          "text": "וזהו שחודש אייר נקרא בשם זיו לפי שבו נולדו זיותני עולם82"
        },
        {
          "s": 29,
          "text": "הם האבות83,"
        },
        {
          "s": 30,
          "text": "שהמצוות שלהם ריחות היו84],"
        },
        {
          "s": 31,
          "text": "מ\"מ,"
        },
        {
          "s": 32,
          "text": "בנוגע להאדם,"
        },
        {
          "s": 33,
          "text": "הגילוי הבא מלמעלה נרגש"
        },
        {
          "s": 34,
          "text": "(בעיקר)"
        },
        {
          "s": 35,
          "text": "רק בנפש האלקית ואינו נרגש בנפש הבהמית,"
        },
        {
          "s": 36,
          "text": "ולכן העבודה שע\"י גילוי זה היא רק אתכפיא,"
        },
        {
          "s": 37,
          "text": "וע\"י עבודת האדם ובפרט ע\"י הגילוי שנמשך ע\"י העבודה,"
        },
        {
          "s": 38,
          "text": "נעשה הבירור דנפש הבהמית והפיכתה לקדושה,"
        },
        {
          "s": 39,
          "text": "אתהפכא."
        }
      ]
    }
  ]
}