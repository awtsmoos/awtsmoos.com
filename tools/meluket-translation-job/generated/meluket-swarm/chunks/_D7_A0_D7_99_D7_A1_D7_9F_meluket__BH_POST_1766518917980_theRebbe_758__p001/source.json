{
  "globalIndex": 717,
  "owner": 17,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917980_theRebbe_758__p001",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917980_theRebbe_758__p001",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917980_theRebbe_758",
  "title": "מאמר ונחה עליו רוח ה' תשכ\"ה",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "אחרון של פסח,"
        },
        {
          "s": 2,
          "text": "ה'תשכ\"ה"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "ונחה עליו רוח הוי' גו' והריחו ביראת הוי' גו' וגר זאב עם כבש גו'1,"
        },
        {
          "s": 1,
          "text": "ומבאר כ\"ק מו\"ח אדמו\"ר במאמרו ד\"ה זה2"
        },
        {
          "s": 2,
          "text": "שבפסוקים אלו מתאר הנביא ביאת משיח צדקנו שיבוא לגאלנו בב\"א,"
        },
        {
          "s": 3,
          "text": "ואומר בזה כמה דברים בנוגע למלך המשיח והנהגתו."
        },
        {
          "s": 4,
          "text": "בתחילה מבאר מעלת מלך המשיח עצמו – ונחה עליו רוח הוי' וגו',"
        },
        {
          "s": 5,
          "text": "ואח\"כ מבאר את הנהגתו – והריחו ביראת הוי' וגו'"
        },
        {
          "s": 6,
          "text": "[שגם והריחו הו\"ע בהנהגתו,"
        },
        {
          "s": 7,
          "text": "דמורח3"
        },
        {
          "s": 8,
          "text": "ודאין4],"
        },
        {
          "s": 9,
          "text": "ולאח\"ז מוסיף וגר זאב עם כבש וגו',"
        },
        {
          "s": 10,
          "text": "שהנהגת המשיח תהי' באופן כזה שיפעול5"
        },
        {
          "s": 11,
          "text": "גילוי אלקות בכל העולם,"
        },
        {
          "s": 12,
          "text": "לא רק בסוג המדבר אלא גם בסוג החי"
        },
        {
          "s": 13,
          "text": "(זאב ונמר וכו')6"
        },
        {
          "s": 14,
          "text": "ואפילו בסוג הדומם7,"
        },
        {
          "s": 15,
          "text": "וכמו שממשיך בכתוב8"
        },
        {
          "s": 16,
          "text": "כי מלאה הארץ דיעה את הוי',"
        },
        {
          "s": 17,
          "text": "שגם הארץ הגשמית"
        },
        {
          "s": 18,
          "text": "(דומם)"
        },
        {
          "s": 19,
          "text": "תהי' מלאה דיעה את הוי'."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ומדייק בהמאמר,"
        },
        {
          "s": 1,
          "text": "דצריך להבין,"
        },
        {
          "s": 2,
          "text": "דמכיון שיהי' אז מלאה הארץ דיעה את הוי',"
        },
        {
          "s": 3,
          "text": "למה יצטרכו למלך."
        },
        {
          "s": 4,
          "text": "ונקודת הביאור בזה9"
        },
        {
          "s": 5,
          "text": "דמלוכה הו\"ע ההתנשאות,"
        },
        {
          "s": 6,
          "text": "מה שהמלך מובדל ומרומם מהעם."
        },
        {
          "s": 7,
          "text": "וגם הציוויים של המלך"
        },
        {
          "s": 8,
          "text": "(אף שלכאורה הם תנועה דקירוב,"
        },
        {
          "s": 9,
          "text": "שהמלך מתקרב אל העם להנהיגם כרצונו)"
        },
        {
          "s": 10,
          "text": "הם10"
        },
        {
          "s": 11,
          "text": "באופן דרוממות והבדלה,"
        },
        {
          "s": 12,
          "text": "בדרך פקודה וגזירה."
        },
        {
          "s": 13,
          "text": "וכן הוא גם מצד העם,"
        },
        {
          "s": 14,
          "text": "דמה שהם מקיימים ציווי המלך הוא לא מפני שהם יודעים ומשיגים את טעם הציווי,"
        },
        {
          "s": 15,
          "text": "כי אם,"
        },
        {
          "s": 16,
          "text": "מצד יראת ואימת המלך,"
        },
        {
          "s": 17,
          "text": "שתהא אימתו עליך11."
        },
        {
          "s": 18,
          "text": "ונמצא,"
        },
        {
          "s": 19,
          "text": "שגם ההשפעה מהמלך להעם הוא באופן דהתנשאות והבדלה."
        },
        {
          "s": 20,
          "text": "וזהו ההפרש שבין השפעה דרב להשפעה דמלך,"
        },
        {
          "s": 21,
          "text": "דענין השפעה דרב הוא מה שהרב מתקרב להתלמיד"
        },
        {
          "s": 22,
          "text": "(שמצמצם את שכלו לפי\"ע כלי התלמיד)"
        },
        {
          "s": 23,
          "text": "באופן שהתלמיד ישיג את השכל,"
        },
        {
          "s": 24,
          "text": "משא\"כ השפעה דמלך היא מובדלת מהעם,"
        },
        {
          "s": 25,
          "text": "למעלה מהשכל שלהם."
        },
        {
          "s": 26,
          "text": "והשרש דב' ענינים אלו"
        },
        {
          "s": 27,
          "text": "(השפעה דרב ודמלך)"
        },
        {
          "s": 28,
          "text": "הוא12"
        },
        {
          "s": 29,
          "text": "גם בתורה,"
        },
        {
          "s": 30,
          "text": "דיש בה"
        },
        {
          "s": 31,
          "text": "(דוגמת)"
        },
        {
          "s": 32,
          "text": "שני ענינים אלו."
        },
        {
          "s": 33,
          "text": "דישנם ענינים בתורה שנתלבשו בשכל,"
        },
        {
          "s": 34,
          "text": "אבל עצם התורה היא למעלה מהשכל13."
        },
        {
          "s": 35,
          "text": "ולעתיד לבוא,"
        },
        {
          "s": 36,
          "text": "יתגלו שני הענינים."
        },
        {
          "s": 37,
          "text": "דזהו מה שמשיח נק' בשם רב ובשם מלך,"
        },
        {
          "s": 38,
          "text": "היינו,"
        },
        {
          "s": 39,
          "text": "דנוסף על זה שמשיח ילמד תורה לכל ישראל14"
        },
        {
          "s": 40,
          "text": "וישפיע לכולם טוב טעם ודעת בסודות,"
        },
        {
          "s": 41,
          "text": "בפנימיות התורה,"
        },
        {
          "s": 42,
          "text": "שמצד השפעה זו נק' משיח בשם רב,"
        },
        {
          "s": 43,
          "text": "הנה הוא בעצמו ישיג הרבה יותר לאין קץ ממה שישפיע בהשגה,"
        },
        {
          "s": 44,
          "text": "וההשפעה דענינים אלו תהי' בבחי' מקיף,"
        },
        {
          "s": 45,
          "text": "בדוגמת השפעה דמלך."
        },
        {
          "s": 46,
          "text": "ויש להוסיף לכאורה,"
        },
        {
          "s": 47,
          "text": "דע\"פ הידוע15"
        },
        {
          "s": 48,
          "text": "שלימוד התורה דמשיח"
        },
        {
          "s": 49,
          "text": "(מה שילמד את כל העם)"
        },
        {
          "s": 50,
          "text": "יהי' באופן דראי' שלמעלה מהשגה,"
        },
        {
          "s": 51,
          "text": "מובן מזה,"
        },
        {
          "s": 52,
          "text": "דהענינים שישפיע באופן דמלך הם ענינים כאלו שאינם יכולים לבוא בגילוי אפילו בראי' שלמעלה מהשכל,"
        },
        {
          "s": 53,
          "text": "ואעפ\"כ,"
        },
        {
          "s": 54,
          "text": "מצד זה שמשיח יהי'"
        },
        {
          "s": 55,
          "text": "(גם)"
        },
        {
          "s": 56,
          "text": "מלך,"
        },
        {
          "s": 57,
          "text": "יגלה לישראל גם ענינים אלו,"
        },
        {
          "s": 58,
          "text": "אלא שהגילוי דענינים אלו יהי' בדרך מקיף."
        }
      ]
    }
  ]
}