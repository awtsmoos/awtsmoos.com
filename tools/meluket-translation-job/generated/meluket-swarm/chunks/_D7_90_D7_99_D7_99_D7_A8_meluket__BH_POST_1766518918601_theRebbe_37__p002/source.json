{
  "globalIndex": 806,
  "owner": 6,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918601_theRebbe_37__p002",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918601_theRebbe_37__p002",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918601_theRebbe_37",
  "title": "מאמר גל עיני ואביטה תשל\"ז",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ומבאר בהמאמר17,"
        },
        {
          "s": 2,
          "text": "דבנפלאות שבתורה"
        },
        {
          "s": 3,
          "text": "(פנימיות התורה)"
        },
        {
          "s": 4,
          "text": "שתי דרגות."
        },
        {
          "s": 5,
          "text": "והענין הוא,"
        },
        {
          "s": 6,
          "text": "דאיתא בזהר18"
        },
        {
          "s": 7,
          "text": "שבתורה יש לבוש,"
        },
        {
          "s": 8,
          "text": "גוף,"
        },
        {
          "s": 9,
          "text": "נשמה ונשמה לנשמה."
        },
        {
          "s": 10,
          "text": "גליא דתורה הוא הלבוש והגוף דתורה"
        },
        {
          "s": 11,
          "text": "[הסיפורים דתורה – לבוש,"
        },
        {
          "s": 12,
          "text": "וההלכות דתורה – הגוף],"
        },
        {
          "s": 13,
          "text": "והנשמה דתורה היא פנימיות התורה,"
        },
        {
          "s": 14,
          "text": "שנחלקת בכללות לשתי דרגות."
        },
        {
          "s": 15,
          "text": "רזין דאורייתא"
        },
        {
          "s": 16,
          "text": "(סתים)"
        },
        {
          "s": 17,
          "text": "– נשמתא,"
        },
        {
          "s": 18,
          "text": "ורזין דרזין"
        },
        {
          "s": 19,
          "text": "(סתימא דכל סתימין)"
        },
        {
          "s": 20,
          "text": "– נשמתא לנשמתא."
        },
        {
          "s": 21,
          "text": "והבקשה גל עיני ואביטה נפלאות מתורתך"
        },
        {
          "s": 22,
          "text": "(נפלאות לשון רבים)"
        },
        {
          "s": 23,
          "text": "היא שיראה את שתי הדרגות דנפלאות שבתורה,"
        },
        {
          "s": 24,
          "text": "רזין ורזין דרזין."
        },
        {
          "s": 25,
          "text": "ומבאר,"
        },
        {
          "s": 26,
          "text": "שנשמתא היא בחינת נר\"ן,"
        },
        {
          "s": 27,
          "text": "ונשמתא לנשמתא היא בחינת ח\"י."
        },
        {
          "s": 28,
          "text": "ואולי יש לומר,"
        },
        {
          "s": 29,
          "text": "שהענינים דפנימיות התורה שגילה רשב\"י במשך כל ימי חייו19"
        },
        {
          "s": 30,
          "text": "הם בחינת נשמתא דאורייתא,"
        },
        {
          "s": 31,
          "text": "והענינים שגילה ביום הסתלקותו19"
        },
        {
          "s": 32,
          "text": "הם בחינת נשמתא לנשמתא."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "והנה ברשימות הצ\"צ לתהלים עה\"פ גל עיני ואביטה נפלאות מתורתך20"
        },
        {
          "s": 1,
          "text": "מביא מאמר הזהר הנ\"ל שבתורה יש לבושא וגופא ונשמתא ונשמתא לנשמתא,"
        },
        {
          "s": 2,
          "text": "ומבאר,"
        },
        {
          "s": 3,
          "text": "שהבקשה גל עיני ואביטה נפלאות היא שיראה לא רק הלבוש לבד אלא גם נשמתא."
        },
        {
          "s": 4,
          "text": "ובהמשך הענין מביא פירוש השל\"ה21"
        },
        {
          "s": 5,
          "text": "דאביטה נפלאות הוא כוונת המצוות."
        },
        {
          "s": 6,
          "text": "ולאחרי שמביא פירוש השל\"ה ממשיך לבאר שנפלאות הוא פנימיות התורה,"
        },
        {
          "s": 7,
          "text": "נשמתא דאורייתא."
        },
        {
          "s": 8,
          "text": "וצריך להבין,"
        },
        {
          "s": 9,
          "text": "דלכאורה הי' צריך תחלה לסיים ביאור הפירוש שנפלאות הוא נשמתא דאורייתא ולאח\"ז להביא עוד פירוש שנפלאות הוא כוונת המצוות,"
        },
        {
          "s": 10,
          "text": "ומזה שמביא פירוש זה באמצע הביאור שנפלאות הוא נשמתא דאורייתא,"
        },
        {
          "s": 11,
          "text": "משמע,"
        },
        {
          "s": 12,
          "text": "שהפירוש שנפלאות הוא כוונת המצוות נוגע לביאור והבנת הפירוש דאביטה נפלאות הוא שיראה נשמתא דאורייתא."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים מ\"ש גל עיני גו' שמבקש מהקב\"ה שיפקח את עיניו,"
        },
        {
          "s": 2,
          "text": "דלכאורה,"
        },
        {
          "s": 3,
          "text": "כיון שהסיבה לזה שע\"ד הרגיל אין רואים את הנפלאות דתורה הוא"
        },
        {
          "s": 4,
          "text": "(לא מצד החסרון דהכלים,"
        },
        {
          "s": 5,
          "text": "אלא)"
        },
        {
          "s": 6,
          "text": "לפי שהנפלאות הם מכוסים ונעלמים"
        },
        {
          "s": 7,
          "text": "[ויש לומר,"
        },
        {
          "s": 8,
          "text": "שההעלם דבחינת נשמתא דאורייתא הוא מפני שהיא מלובשת בהגוף דתורה"
        },
        {
          "s": 9,
          "text": "(גליא דתורה)"
        },
        {
          "s": 10,
          "text": "שמעלים על הנשמה,"
        },
        {
          "s": 11,
          "text": "וההעלם דבחינת נשמתא לנשמתא דאורייתא הוא"
        },
        {
          "s": 12,
          "text": "(לא שהיא מלובשת באיזה דבר שמעלים עלי',"
        },
        {
          "s": 13,
          "text": "אלא)"
        },
        {
          "s": 14,
          "text": "שמצד עצמה היא בהעלם,"
        },
        {
          "s": 15,
          "text": "העלם שלמעלה מגילוי],"
        },
        {
          "s": 16,
          "text": "הוה לי' לבקש שהקב\"ה יגלה את הנפלאות דתורה22,"
        },
        {
          "s": 17,
          "text": "ומהי הבקשה גל עיני שהקב\"ה יפקח את עיניו."
        },
        {
          "s": 18,
          "text": "ונקודת הביאור בזה,"
        },
        {
          "s": 19,
          "text": "ע\"פ מה דאיתא במדרש23,"
        },
        {
          "s": 20,
          "text": "משל למלך שגזר ואמר בני רומי לא ירדו לסוריא ובני סוריא לא יעלו לרומי,"
        },
        {
          "s": 21,
          "text": "כך כשברא הקב\"ה את העולם גזר ואמר השמים שמים לה' והארץ נתן לבני אדם24,"
        },
        {
          "s": 22,
          "text": "כשביקש ליתן התורה ביטל הגזירה ואמר התחתונים יעלו לעליונים והעליונים ירדו לתחתונים,"
        },
        {
          "s": 23,
          "text": "ואני המתחיל,"
        },
        {
          "s": 24,
          "text": "שנאמר25"
        },
        {
          "s": 25,
          "text": "וירד הוי' על הר סיני וכתיב26"
        },
        {
          "s": 26,
          "text": "ואל משה אמר עלה אל הוי'."
        },
        {
          "s": 27,
          "text": "ומבואר במק\"א27,"
        },
        {
          "s": 28,
          "text": "דהטעם שאומר התחתונים יעלו לעליונים לפני והעליונים ירדו לתחתונים,"
        },
        {
          "s": 29,
          "text": "אף שירידת העליונים למטה היתה קודם,"
        },
        {
          "s": 30,
          "text": "אני המתחיל,"
        },
        {
          "s": 31,
          "text": "הוא,"
        },
        {
          "s": 32,
          "text": "כי תכלית הכוונה דמתן תורה הוא התחתונים יעלו לעליונים"
        },
        {
          "s": 33,
          "text": "[שיהיו כלי לגילוי אלקות,"
        },
        {
          "s": 34,
          "text": "ויתירה מזה שגם המשכת הגילוי בהם תהי' מצד ענינם וע\"י עבודתם],"
        },
        {
          "s": 35,
          "text": "אלא שבכדי שיוכל להיות עליית התחתונים למעלה הוא ע\"י ירידת העליונים למטה,"
        },
        {
          "s": 36,
          "text": "שהיא ההתחלה והנתינת כח על עליית התחתונים למעלה."
        },
        {
          "s": 37,
          "text": "ועד\"ז הוא במתן תורה דפנימיות התורה שבל\"ג בעומר,"
        },
        {
          "s": 38,
          "text": "שהכוונה בביטול הגזירה והמחיצה בין עליונים ותחתונים בנוגע לפנימיות התורה היא,"
        },
        {
          "s": 39,
          "text": "שהגילוי דפנימיות התורה שנמשך להאדם יהי'"
        },
        {
          "s": 40,
          "text": "(גם)"
        },
        {
          "s": 41,
          "text": "מצד האדם."
        },
        {
          "s": 42,
          "text": "וזהו גל עיני ואביטה נפלאות מתורתך,"
        },
        {
          "s": 43,
          "text": "שהקב\"ה יפקח את עיני האדם ויראה את הנפלאות שבתורה"
        },
        {
          "s": 44,
          "text": "(לא רק ע\"י שהנפלאות יהיו בגילוי,"
        },
        {
          "s": 45,
          "text": "אלא גם)"
        },
        {
          "s": 46,
          "text": "מצד ענינו של האדם."
        }
      ]
    }
  ]
}