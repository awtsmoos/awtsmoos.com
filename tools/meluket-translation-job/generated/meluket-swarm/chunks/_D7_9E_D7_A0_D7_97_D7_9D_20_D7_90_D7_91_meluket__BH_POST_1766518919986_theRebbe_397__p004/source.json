{
  "globalIndex": 1055,
  "owner": 5,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919986_theRebbe_397__p004",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919986_theRebbe_397__p004",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919986_theRebbe_397",
  "title": "מאמר לא היו ימים טובים לישראל תשל\"ה",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "וזהו עלה ארי' במזל ארי' והחריב אריאל כו' על מנת שיבא ארי' במזל ארי' ויבנה אריאל,"
        },
        {
          "s": 1,
          "text": "כי יבא ארי'"
        },
        {
          "s": 2,
          "text": "[זה הקב\"ה דכתיב בי' ארי' שאג מי לא יירא]"
        },
        {
          "s": 3,
          "text": "הו\"ע התגלות הכתר שלמעלה מהשתלשלות18,"
        },
        {
          "s": 4,
          "text": "ומכיון שהגילוי שלמעלה מהשתלשלות הוא ע\"י העבודה שלמעלה ממדידה והגבלה,"
        },
        {
          "s": 5,
          "text": "לכן בכדי שיבא ארי' כו' הוצרך להיות עלה ארי' כו',"
        },
        {
          "s": 6,
          "text": "כי המרירות והצער שמצד מיצר הגלות הוא המעורר את העבודה שלמעלה מהגבלה,"
        },
        {
          "s": 7,
          "text": "כנ\"ל."
        },
        {
          "s": 8,
          "text": "ולכן ע\"י קדימת הגלות דוקא יבא ארי' כו' ויבנה אריאל,"
        },
        {
          "s": 9,
          "text": "ביהמ\"ק השלישי."
        },
        {
          "s": 10,
          "text": "וזהו גם המעלה דביהמ\"ק דלעתיד על בית ראשון ובית שני,"
        },
        {
          "s": 11,
          "text": "שדוקא בביהמ\"ק השלישי"
        },
        {
          "s": 12,
          "text": "(להיותו אחרי קדימת הגלות האחרון)"
        },
        {
          "s": 13,
          "text": "יהי' בו"
        },
        {
          "s": 14,
          "text": "(עיקר)"
        },
        {
          "s": 15,
          "text": "גילוי בחינת א\"ס שלמעלה מהשתלשלות"
        },
        {
          "s": 16,
          "text": "(יבא ארי')."
        },
        {
          "s": 17,
          "text": "וזהו הטעם מה שביהמ\"ק דלעתיד יהי' בבחינת נצחיות"
        },
        {
          "s": 18,
          "text": "(משא\"כ בית ראשון ובית שני היו בבחינת הפסק),"
        },
        {
          "s": 19,
          "text": "כי מצד הגילוי דא\"ס שלמעלה מהשתלשלות,"
        },
        {
          "s": 20,
          "text": "אין שייך ענין ההפסק."
        },
        {
          "s": 21,
          "text": "וזהו מ\"ש47"
        },
        {
          "s": 22,
          "text": "מקדש אד' כוננו ידיך הוי' ימלוך לעולם ועד,"
        },
        {
          "s": 23,
          "text": "שהפירוש בזה הוא"
        },
        {
          "s": 24,
          "text": "(כמ\"ש מעמק המלך בדרוש הנ\"ל48),"
        },
        {
          "s": 25,
          "text": "דלהיות שמקדש גו' כוננו ידיך,"
        },
        {
          "s": 26,
          "text": "היינו שביהמ\"ק דלעתיד יהי' בידי הקב\"ה בעצמו"
        },
        {
          "s": 27,
          "text": "[היינו בחינת הא\"ס שלמעלה מהשתלשלות]"
        },
        {
          "s": 28,
          "text": "לכן הוי' ימלוך לעולם ועד,"
        },
        {
          "s": 29,
          "text": "שיהי' בבחינת נצחיות."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "והנה הכח שיש בזמן הגלות להעבודה דבכל מאדך שעי\"ז יהי' ביהמ\"ק דלע\"ל,"
        },
        {
          "s": 1,
          "text": "הוא מצד הגילויים דבית ראשון ובית שני שהיו לפני הגלות."
        },
        {
          "s": 2,
          "text": "שגילויים אלו נותנים את הכח להאיר את חשכת הגלות בנר מצוה ותורה אור49,"
        },
        {
          "s": 3,
          "text": "ועד שעי\"ז יהי' ולילה כיום יאיר50"
        },
        {
          "s": 4,
          "text": "בגאולה העתידה."
        },
        {
          "s": 5,
          "text": "והטעם לזה"
        },
        {
          "s": 6,
          "text": "(מה שבית ראשון ובית שני נותנים את הכח על העבודה דבכל מאדך שעי\"ז יהי' ביהמ\"ק השלישי)"
        },
        {
          "s": 7,
          "text": "הוא,"
        },
        {
          "s": 8,
          "text": "לפי שגם בבית ראשון ובית שני"
        },
        {
          "s": 9,
          "text": "(אף שהי' בהם הפסק)"
        },
        {
          "s": 10,
          "text": "הי' מעין ביהמ\"ק השלישי."
        },
        {
          "s": 11,
          "text": "ועד\"ז הוא גם בנוגע למשכן שהי' מעין ביהמ\"ק דלעתיד."
        },
        {
          "s": 12,
          "text": "דהגם שהמשכן נק' אהל51,"
        },
        {
          "s": 13,
          "text": "דירת ארעי"
        },
        {
          "s": 14,
          "text": "(ודלא כהמקדש שנקרא בית52,"
        },
        {
          "s": 15,
          "text": "דירת קבע),"
        },
        {
          "s": 16,
          "text": "הרי דוקא המשכן,"
        },
        {
          "s": 17,
          "text": "מכיון שהי' מעשה ידי משה,"
        },
        {
          "s": 18,
          "text": "הוא קיים לעולם53."
        },
        {
          "s": 19,
          "text": "ובזה יובן מה שלאחרי שמביא בדרוש הנ\"ל את הפירוש דעמה\"מ שמקדש אד' כוננו ידיך קאי על ביהמ\"ק דלעתיד הוא מוסיף שהמשמעות מגמרא ומדרשים שקאי על משכן ומקדש"
        },
        {
          "s": 20,
          "text": "(אף שפירוש זה אינו שייך לכאורה לתוכן הענין המבואר בדרוש זה),"
        },
        {
          "s": 21,
          "text": "כי זה שבמקדש אד' כוננו ידיך יש ב' פירושים אלו"
        },
        {
          "s": 22,
          "text": "(שקאי על ביהמ\"ק דלעתיד,"
        },
        {
          "s": 23,
          "text": "ושקאי על משכן ומקדש)"
        },
        {
          "s": 24,
          "text": "הוא54"
        },
        {
          "s": 25,
          "text": "לפי שבבית ראשון ובית שני"
        },
        {
          "s": 26,
          "text": "(וכן במשכן)"
        },
        {
          "s": 27,
          "text": "הי' מעין ביהמ\"ק דלעתיד כנ\"ל."
        },
        {
          "s": 28,
          "text": "ולכן מביא בהמאמר גם הפירוש שמקדש אד' כוננו ידיך קאי על משכן ומקדש,"
        },
        {
          "s": 29,
          "text": "כי בזה מבאר,"
        },
        {
          "s": 30,
          "text": "שהכח שבזה\"ג על העבודה להמשיך את ביהמ\"ק השלישי הוא מבית ראשון ובית שני"
        },
        {
          "s": 31,
          "text": "(וגם ממשכן)."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "אמנם עיקר הענין דמקדש אד' כוננו ידיך הוא בביהמ\"ק דלעתיד דוקא."
        },
        {
          "s": 1,
          "text": "משא\"כ במשכן ומקדש"
        },
        {
          "s": 2,
          "text": "(בית ראשון ובית שני)"
        },
        {
          "s": 3,
          "text": "הוא רק מעין ביהמ\"ק דלעתיד."
        },
        {
          "s": 4,
          "text": "כי פירוש כוננו ידיך הוא שנעשה בידי הקב\"ה בעצמו,"
        },
        {
          "s": 5,
          "text": "היינו בחינת הכתר שלמעלה מהשתלשלות,"
        },
        {
          "s": 6,
          "text": "וגילוי בחינה זו יהי' בביהמ\"ק דלעתיד,"
        },
        {
          "s": 7,
          "text": "שאז דוקא יהי' אמיתית הענין דקיימא סיהרא באשלמותא55,"
        },
        {
          "s": 8,
          "text": "בחינת השלימות שלמעלה מהשתלשלות."
        },
        {
          "s": 9,
          "text": "דבחינת קיימא סיהרא באשלמותא שבבית ראשון"
        },
        {
          "s": 10,
          "text": "[וכמרז\"ל56"
        },
        {
          "s": 11,
          "text": "שביהמ\"ק נבנה ע\"י שלמה,"
        },
        {
          "s": 12,
          "text": "לפי ששלמה הי' בדור ט\"ו לאברהם ואז נתמלא דיסקוס של לבנה],"
        },
        {
          "s": 13,
          "text": "הוא דוגמת בחינת יתרון ארץ,"
        },
        {
          "s": 14,
          "text": "משא\"כ השלימות שבביהמ\"ק דלעתיד הו\"ע מלך לשדה נעבד."
        },
        {
          "s": 15,
          "text": "ובכדי להמשיך בחינת מלך לשדה נעבד כמו שהוא למעליותא,"
        },
        {
          "s": 16,
          "text": "הוצרך להיות תחילה הגלות,"
        },
        {
          "s": 17,
          "text": "בחינת מלך לשדה נעבד כמו שהוא לגריעותא."
        },
        {
          "s": 18,
          "text": "וע\"י ירידת המלכות בקצה הכי תחתון,"
        },
        {
          "s": 19,
          "text": "עד שהיא נעבדת לשדה דלעו\"ז,"
        },
        {
          "s": 20,
          "text": "תהי' עליית המלכות בבחינה הכי נעלית,"
        },
        {
          "s": 21,
          "text": "עד שתאיר בה בחינת עתיק."
        },
        {
          "s": 22,
          "text": "שהטעם לזה שירושלים שהיא בחינת מלכות תיקרא נוה שאנן57"
        },
        {
          "s": 23,
          "text": "שקאי על בחינת עתיק,"
        },
        {
          "s": 24,
          "text": "הוא מצד זה שבמלכות תאיר בחינת עתיק58."
        }
      ]
    }
  ]
}