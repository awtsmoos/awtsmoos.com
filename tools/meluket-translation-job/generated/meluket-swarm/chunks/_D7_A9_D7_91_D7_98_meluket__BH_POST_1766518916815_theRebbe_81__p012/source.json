{
  "globalIndex": 529,
  "owner": 29,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916815_theRebbe_81__p012",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916815_theRebbe_81__p012",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916815_theRebbe_81",
  "title": "מאמר באתי לגני תש\"ל",
  "part": 12,
  "sections": [
    {
      "v": 33,
      "items": [
        {
          "s": 0,
          "text": "כ)"
        },
        {
          "s": 1,
          "text": "ב)"
        },
        {
          "s": 2,
          "text": "ויש לבאר השייכות דענין זה לסיום וחותם דפרק העשרים,"
        },
        {
          "s": 3,
          "text": "ע\"פ המבואר בלקו\"ת129,"
        },
        {
          "s": 4,
          "text": "דזה שפתחו של אולם הי' גבוה ארבעים אמה130,"
        },
        {
          "s": 5,
          "text": "שני פעמים עשרים,"
        },
        {
          "s": 6,
          "text": "הוא,"
        },
        {
          "s": 7,
          "text": "דעשרים בגימטריא כתר,"
        },
        {
          "s": 8,
          "text": "ושני פעמים עשרים"
        },
        {
          "s": 9,
          "text": "(ארבעים)"
        },
        {
          "s": 10,
          "text": "הם שני הבחינות שבכתר,"
        },
        {
          "s": 11,
          "text": "עתיק ואריך."
        },
        {
          "s": 12,
          "text": "ומבואר שם,"
        },
        {
          "s": 13,
          "text": "דזה שפתח האולם לא היו לו דלתות והי' פתוח תמיד מעצמו130,"
        },
        {
          "s": 14,
          "text": "הוא,"
        },
        {
          "s": 15,
          "text": "כי עבודת האדם אינה בערך לעורר ולהמשיך בחינת הכתר שלמעלה מהשתלשלות,"
        },
        {
          "s": 16,
          "text": "אלא שע\"י שלימות העבודה,"
        },
        {
          "s": 17,
          "text": "נמשך הוא מעצמו."
        },
        {
          "s": 18,
          "text": "וע\"פ המבואר במק\"א131"
        },
        {
          "s": 19,
          "text": "שאתערותא דלתתא מגעת לא רק בח\"ס אלא גם בגלגלתא דאריך,"
        },
        {
          "s": 20,
          "text": "יש לומר,"
        },
        {
          "s": 21,
          "text": "דזה שפתח האולם הי' פתוח תמיד מעצמו הוא בעיקר מצד בחינת עתיק שבו."
        },
        {
          "s": 22,
          "text": "ועפ\"ז יש לבאר השייכות דגילוי פנימיות ועצמות א\"ס ב\"ה לסיום וחותם פרק העשרים,"
        },
        {
          "s": 23,
          "text": "דהסיום והחותם דעשרים הוא בחינה הב' דכתר,"
        },
        {
          "s": 24,
          "text": "עתיק,"
        },
        {
          "s": 25,
          "text": "ובעתיק עצמו – פנימיות עתיק,"
        },
        {
          "s": 26,
          "text": "עד לפנימיות ועצמות א\"ס ב\"ה."
        },
        {
          "s": 27,
          "text": "והשלימות דגילוי זה יהי' בפתחו של אולם דביהמ\"ק השלישי,"
        },
        {
          "s": 28,
          "text": "שיבנה במהרה בימינו ע\"י משיח צדקנו,"
        },
        {
          "s": 29,
          "text": "בקרוב ממש."
        }
      ]
    }
  ]
}