{
  "globalIndex": 250,
  "owner": 0,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915265_theRebbe_887__p002",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915265_theRebbe_887__p002",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915265_theRebbe_887",
  "title": "מאמר אתה אחד תשכ\"ט",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "וצריך להבין,"
        },
        {
          "s": 1,
          "text": "הרי הדיוק"
        },
        {
          "s": 2,
          "text": "(שבהמאמר)"
        },
        {
          "s": 3,
          "text": "שהי' צריך לומר גוי יחיד מובן בפשטות,"
        },
        {
          "s": 4,
          "text": "ועד\"ז בהמשל דבן יחיד,"
        },
        {
          "s": 5,
          "text": "שזה שנקרא בשם בן יחיד הוא מפני שהוא בן אחד בלבד,"
        },
        {
          "s": 6,
          "text": "ובהמאמר משמע,"
        },
        {
          "s": 7,
          "text": "דזה שהול\"ל גוי יחיד הוא מפני שהאהבה לבן יחיד וכן אהבת הבן יחיד להוריו היא אהבה גדולה ביותר."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויש לומר הביאור בזה ע\"פ המבואר בכ\"מ6"
        },
        {
          "s": 2,
          "text": "עה\"פ7"
        },
        {
          "s": 3,
          "text": "שמע ישראל גו' הוי' אחד,"
        },
        {
          "s": 4,
          "text": "דמ\"ש הוי' אחד ולא הוי' יחיד,"
        },
        {
          "s": 5,
          "text": "הוא,"
        },
        {
          "s": 6,
          "text": "כי החילוק בין יחיד לאחד הוא,"
        },
        {
          "s": 7,
          "text": "שאחד מורה על התאחדות הפרטים8"
        },
        {
          "s": 8,
          "text": "[וכמו אלף אחד שהוא כלל הכלול מאלף פרטים."
        },
        {
          "s": 9,
          "text": "ועד\"ז אדם אחד,"
        },
        {
          "s": 10,
          "text": "שהוא כלול מרמ\"ח אברים ושס\"ה גידים],"
        },
        {
          "s": 11,
          "text": "ויחיד מורה על ענין שלמעלה מפרטים"
        },
        {
          "s": 12,
          "text": "[וכמו יחידה שבנפש,"
        },
        {
          "s": 13,
          "text": "שאינה מורכבת מכחות פרטים]."
        },
        {
          "s": 14,
          "text": "ולכן נאמר הוי' אחד ולא הוי' יחיד,"
        },
        {
          "s": 15,
          "text": "בכדי להורות,"
        },
        {
          "s": 16,
          "text": "שגם לאחרי שנברא העולם"
        },
        {
          "s": 17,
          "text": "(שיש בו ריבוי פרטים),"
        },
        {
          "s": 18,
          "text": "הוא מיוחד עמו ית'."
        },
        {
          "s": 19,
          "text": "וכמרומז בג' האותיות שבתיבת אחד9,"
        },
        {
          "s": 20,
          "text": "שהח' שמורה על ז' רקיעים וארץ והד' שמורה על ד' רוחות העולם הם בטלים ומיוחדים עם האל\"ף,"
        },
        {
          "s": 21,
          "text": "אלופו10"
        },
        {
          "s": 22,
          "text": "של עולם."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "וזה שמדייק בהמאמר מ\"ש אתה אחד ושמך אחד"
        },
        {
          "s": 1,
          "text": "(ולא אתה יחיד ושמך יחיד),"
        },
        {
          "s": 2,
          "text": "יש לומר ע\"פ המבואר בכ\"מ11,"
        },
        {
          "s": 3,
          "text": "דזה שכתוב הוי' אחד הוא דוקא בהאור ששייך לעולמות,"
        },
        {
          "s": 4,
          "text": "אבל אוא\"ס שלמעלה משייכות לעולמות,"
        },
        {
          "s": 5,
          "text": "אין שייך לקרותו אחד רק יחיד,"
        },
        {
          "s": 6,
          "text": "כי לגבי אור זה אין שום מציאות12"
        },
        {
          "s": 7,
          "text": "והוא לבדו הוא."
        },
        {
          "s": 8,
          "text": "וכיון שתפלה זו"
        },
        {
          "s": 9,
          "text": "(אתה אחד כו')"
        },
        {
          "s": 10,
          "text": "היא התפלה דמנחת שבת,"
        },
        {
          "s": 11,
          "text": "דנוסף לזה שבשבת בכלל הוא הגילוי דאוא\"ס שלמעלה משייכות לעולמות,"
        },
        {
          "s": 12,
          "text": "הנה בשבת גופא עיקר גילוי זה הוא במנחת שבת,"
        },
        {
          "s": 13,
          "text": "רעוא דרעוין13,"
        },
        {
          "s": 14,
          "text": "וכידוע14"
        },
        {
          "s": 15,
          "text": "בענין ג' הסעודות דשבת,"
        },
        {
          "s": 16,
          "text": "דזה שבסעודה הג' כתיב15"
        },
        {
          "s": 17,
          "text": "היום לא הוא לפי שאז הוא המשכת תענוג העצמי הבלתי מורגש"
        },
        {
          "s": 18,
          "text": "(שלמעלה מאכילה ושתי'),"
        },
        {
          "s": 19,
          "text": "דבכללות הוא עצם האור שאינו בגדר עלמין"
        },
        {
          "s": 20,
          "text": "(גם לא באופן דסובב)16,"
        },
        {
          "s": 21,
          "text": "לכן מדייק בהמאמר שבתפלה זו הול\"ל אתה יחיד ושמך יחיד."
        }
      ]
    }
  ]
}