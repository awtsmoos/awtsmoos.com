{
  "globalIndex": 67,
  "owner": 17,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914059_theRebbe_310__p005",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914059_theRebbe_310__p005",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914059_theRebbe_310",
  "title": "מאמר שובה ישראל תשל\"ז",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ויש להוסיף,"
        },
        {
          "s": 2,
          "text": "שעיקר החידוש והמעלה שבבעלי תשובה הוא בהעבודה דתומ\"צ שלאחרי התשובה,"
        },
        {
          "s": 3,
          "text": "כי עבודת התשובה היא לדלג שור49"
        },
        {
          "s": 4,
          "text": "שלא כסדר ודרך השתלשלות."
        },
        {
          "s": 5,
          "text": "ולכן,"
        },
        {
          "s": 6,
          "text": "גילוי התקשרות העצמית דעצם הנשמה עם העצמות שע\"י התשובה והכפרה,"
        },
        {
          "s": 7,
          "text": "עם היות שהגילוי הוא בדרגות אלו שבהם הי' הפגם,"
        },
        {
          "s": 8,
          "text": "שבכללות הוא הבחינות נר\"נ,"
        },
        {
          "s": 9,
          "text": "הרי זה כמו שהנר\"נ הם באופן של העלאה למעלה"
        },
        {
          "s": 10,
          "text": "(להדרגות חי' יחידה,"
        },
        {
          "s": 11,
          "text": "ועד לעצם הנשמה)."
        },
        {
          "s": 12,
          "text": "ועיקר החידוש והמעלה דתשובה הוא בזה שע\"י התשובה,"
        },
        {
          "s": 13,
          "text": "גם העבודה דתומ\"צ היא בחילא יתיר50."
        },
        {
          "s": 14,
          "text": "שהעבודה בתומ\"צ היא בסדר מסודר"
        },
        {
          "s": 15,
          "text": "[ד"
        },
        {
          "s": 16,
          "text": "(רוב)"
        },
        {
          "s": 17,
          "text": "המצוות יש להן שיעור מצומצם כמבואר בתניא51,"
        },
        {
          "s": 18,
          "text": "ועאכו\"כ לימוד התורה שהוא בהבנה והשגה],"
        },
        {
          "s": 19,
          "text": "וע\"י שהעבודה דתומ\"צ שלאחרי התשובה היא בחילא יתיר,"
        },
        {
          "s": 20,
          "text": "הגילוי דחי' יחידה"
        },
        {
          "s": 21,
          "text": "(וי\"ל גם דעצם הנשמה)"
        },
        {
          "s": 22,
          "text": "בנר\"נ הוא כמו שהנר\"נ הם למטה."
        },
        {
          "s": 23,
          "text": "ויתירה מזו,"
        },
        {
          "s": 24,
          "text": "שע\"י העבודה דתומ\"צ נעשה גם העולם דירה לו ית',"
        },
        {
          "s": 25,
          "text": "ועי\"ז נשלמת הכוונה דדירה בתחתונים,"
        },
        {
          "s": 26,
          "text": "וכידוע בענין במי נמלך בנשמותיהן של צדיקים52,"
        },
        {
          "s": 27,
          "text": "דזה שאמרו בנשמותיהן של צדיקים"
        },
        {
          "s": 28,
          "text": "(אף שבמקום שבעלי תשובה עומדין אין צדיקים גמורין יכולין לעמוד בו),"
        },
        {
          "s": 29,
          "text": "כי תכלית כוונת הבריאה היא שיהי' דירה לו ית' בתחתונים,"
        },
        {
          "s": 30,
          "text": "וזה נעשה ע\"י עבודת הצדיקים,"
        },
        {
          "s": 31,
          "text": "עבודה דתומ\"צ."
        },
        {
          "s": 32,
          "text": "אלא שהשלימות בהעבודה דתומ\"צ הוא כשהיא באה לאחרי קדימת התשובה שאז העבודה דתומ\"צ היא בחילא יתיר,"
        },
        {
          "s": 33,
          "text": "ועי\"ז מיתוסף בהגילוי אלקות"
        },
        {
          "s": 34,
          "text": "(שבאדם,"
        },
        {
          "s": 35,
          "text": "ועי\"ז)"
        },
        {
          "s": 36,
          "text": "גם בעולם,"
        },
        {
          "s": 37,
          "text": "ועי\"ז נשלמת יותר הכוונה דדירה בתחתונים."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "וזהו שובה ישראל עד הוי' אלקיך גו' קחו עמכם דברים גו',"
        },
        {
          "s": 2,
          "text": "דזה שמוסיף קחו עמכם דברים לאחרי שאומר שובה ישראל עד הוי' אלקיך,"
        },
        {
          "s": 3,
          "text": "הוא,"
        },
        {
          "s": 4,
          "text": "כי מצד גודל העילוי שבעבודת התשובה,"
        },
        {
          "s": 5,
          "text": "ובפרט בהתשובה דשובה גו' עד הוי' אלקיך,"
        },
        {
          "s": 6,
          "text": "שהתשובה היא בבחינת עד ולא עד בכלל,"
        },
        {
          "s": 7,
          "text": "ויתירה מזו – הוי' אלקיך,"
        },
        {
          "s": 8,
          "text": "שעי\"ז מתגלית עצם הנשמה שקשורה עם העצמות"
        },
        {
          "s": 9,
          "text": "(שלמעלה גם מבעל הרצון),"
        },
        {
          "s": 10,
          "text": "ואע\"פ שהוא נמצא בדרגא נעלית ביותר,"
        },
        {
          "s": 11,
          "text": "ולכאורה אינו שייך לתיקון הפגמים"
        },
        {
          "s": 12,
          "text": "[ובפרט שבכדי לתקן זה צריך לירד ממדריגתו],"
        },
        {
          "s": 13,
          "text": "בכל זה אומר קחו עמכם דברים,"
        },
        {
          "s": 14,
          "text": "שצריך להיות וידוי דברים,"
        },
        {
          "s": 15,
          "text": "בכדי למחות את גוף הקליפות53."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ועוד פירוש בקחו עמכם דברים,"
        },
        {
          "s": 1,
          "text": "שדברים הם תורה ומצוות54."
        },
        {
          "s": 2,
          "text": "שגם בענין דתיקון החטאים,"
        },
        {
          "s": 3,
          "text": "אף שיש בזה היתרון שעי\"ז נמשך הגילוי דעצם הנשמה"
        },
        {
          "s": 4,
          "text": "(גם)"
        },
        {
          "s": 5,
          "text": "בהדרגות התחתונות ששייך בהם פגם,"
        },
        {
          "s": 6,
          "text": "מ\"מ,"
        },
        {
          "s": 7,
          "text": "גם זה אינו מספיק,"
        },
        {
          "s": 8,
          "text": "וצ\"ל קחו עמכם דברים,"
        },
        {
          "s": 9,
          "text": "תורה ומצוות,"
        },
        {
          "s": 10,
          "text": "שעי\"ז יהי' העילוי גם בהדרגות דהנשמה כמו שהם למטה"
        },
        {
          "s": 11,
          "text": "(ולא באופן דהעלאה),"
        },
        {
          "s": 12,
          "text": "ויתירה מזו,"
        },
        {
          "s": 13,
          "text": "שעי\"ז נעשה גם בירור וזיכוך בהעולם,"
        },
        {
          "s": 14,
          "text": "ונעשה דירה לו ית' בתחתונים."
        }
      ]
    }
  ]
}