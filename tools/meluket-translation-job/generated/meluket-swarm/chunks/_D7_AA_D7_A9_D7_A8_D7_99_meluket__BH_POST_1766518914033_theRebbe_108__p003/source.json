{
  "globalIndex": 60,
  "owner": 10,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914033_theRebbe_108__p003",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914033_theRebbe_108__p003",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914033_theRebbe_108",
  "title": "מאמר שובה ישראל תשל\"ז",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דזהו הטעם שבפרשה שני' דק\"ש נאמר רק בכל לבבכם ובכל נפשכם44,"
        },
        {
          "s": 2,
          "text": "כי האהבה דבכל מאדך,"
        },
        {
          "s": 3,
          "text": "להיותה באה ע\"י הגילוי דאוא\"ס שאינו בגדר עלמין כלל,"
        },
        {
          "s": 4,
          "text": "אינה לכאו\"א45."
        },
        {
          "s": 5,
          "text": "וזה שדורשים מכאו\"א היא האהבה שמצד אור הממלא ואור הסובב."
        },
        {
          "s": 6,
          "text": "ועד\"ז הוא בנוגע לג' הענינים דסור מרע ועשה טוב ובקש שלום,"
        },
        {
          "s": 7,
          "text": "שבכו\"כ מקומות נזכרו רק שני הענינים דסור מרע ועשה טוב."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה ידוע46"
        },
        {
          "s": 2,
          "text": "דזה שע\"י התשובה נעשה סליחת עוונות,"
        },
        {
          "s": 3,
          "text": "דאמיתית ענין הסליחה הוא שהאדם יהי' מרוצה לפניו ית' כמו קודם החטא,"
        },
        {
          "s": 4,
          "text": "הוא,"
        },
        {
          "s": 5,
          "text": "כי ע\"י התשובה ממשיכים רצון חדש מאוא\"ס בעל הרצון,"
        },
        {
          "s": 6,
          "text": "שלמעלה מהרצון דתומ\"צ."
        },
        {
          "s": 7,
          "text": "והמשכה זו היא ע\"י שעשיית התשובה שלו היא באופן דבכל מאדך,"
        },
        {
          "s": 8,
          "text": "למעלה ממדידה והגבלה."
        },
        {
          "s": 9,
          "text": "כידוע47"
        },
        {
          "s": 10,
          "text": "שע\"י האהבה דבכל מאדך עושין רצונו של מקום,"
        },
        {
          "s": 11,
          "text": "ופירוש עושין רצונו של מקום הוא שעושים את הרצון."
        },
        {
          "s": 12,
          "text": "כי ע\"י האהבה דבכל מאדך,"
        },
        {
          "s": 13,
          "text": "מגיעים באוא\"ס שלמעלה מרצון,"
        },
        {
          "s": 14,
          "text": "ועי\"ז,"
        },
        {
          "s": 15,
          "text": "ממשיכים משם רצון חדש48."
        },
        {
          "s": 16,
          "text": "וע\"פ הידוע49"
        },
        {
          "s": 17,
          "text": "שעבודת האדם שעל ידה נעשית ההמשכה צריכה להיות מעין ההמשכה,"
        },
        {
          "s": 18,
          "text": "יש לומר,"
        },
        {
          "s": 19,
          "text": "דשני הענינים בעושין רצונו של מקום,"
        },
        {
          "s": 20,
          "text": "שההמשכה היא מאוא\"ס שלמעלה מבחי' רצון ושגם הרצון שנמשך משם הוא למעלה יותר מהרצון כמו שהוא מצד עצמו,"
        },
        {
          "s": 21,
          "text": "נעשים ע\"י דוגמת שני ענינים אלה בהאהבה דבכל מאדך."
        },
        {
          "s": 22,
          "text": "דע\"י שהאהבה דבכל מאדך היא למעלה מרצון"
        },
        {
          "s": 23,
          "text": "(וכנ\"ל סעיף ד שהמס\"נ דבכל מאדך היא לא שהוא רוצה למסור נפשו אלא שאינו יכול להפרד ח\"ו מאחדותו ית'),"
        },
        {
          "s": 24,
          "text": "לכן היא מגעת בבעל הרצון50."
        },
        {
          "s": 25,
          "text": "וזה שע\"י האהבה דבכל מאדך נעשה עילוי גם בהאהבה דבכל לבבך ובכל נפשך,"
        },
        {
          "s": 26,
          "text": "עי\"ז,"
        },
        {
          "s": 27,
          "text": "גם הרצון שנמשך מבעל הרצון הוא נעלה יותר."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וזהו שובה ישראל עד הוי' אלקיך,"
        },
        {
          "s": 2,
          "text": "דזה שנאמרו כאן ב' השמות הוי' ואלקים הוא,"
        },
        {
          "s": 3,
          "text": "כי ענינו ועבודתו של כל אחד מישראל הוא בב' שמות אלה."
        },
        {
          "s": 4,
          "text": "וכיון שענין התשובה הוא שישוב ויחזור למקומו,"
        },
        {
          "s": 5,
          "text": "לכן נאמר כאן ב' השמות דהוי' ואלקים."
        },
        {
          "s": 6,
          "text": "וזה שאומר עד הוי' אלקיך"
        },
        {
          "s": 7,
          "text": "(ולא להוי' אלקיך)"
        },
        {
          "s": 8,
          "text": "הוא,"
        },
        {
          "s": 9,
          "text": "כפירוש אדמו\"ר הזקן51,"
        },
        {
          "s": 10,
          "text": "ששיעור התשובה52"
        },
        {
          "s": 11,
          "text": "הוא עד שהוי' יהי' אלקיך."
        },
        {
          "s": 12,
          "text": "והיינו,"
        },
        {
          "s": 13,
          "text": "שהתשובה צריכה להיות באופן דבכל מאדך,"
        },
        {
          "s": 14,
          "text": "למעלה ממדידה והגבלה,"
        },
        {
          "s": 15,
          "text": "שעי\"ז היא ההמשכה מאוא\"ס שלמעלה מהוי',"
        },
        {
          "s": 16,
          "text": "דענין זה"
        },
        {
          "s": 17,
          "text": "(שההמשכה היא מאוא\"ס שלמעלה מהוי')"
        },
        {
          "s": 18,
          "text": "מתגלה בזה שהוי' הוא אלקיך כחך וחיותך."
        },
        {
          "s": 19,
          "text": "כי בכדי שיהי' החיבור דסובב"
        },
        {
          "s": 20,
          "text": "(הוי')"
        },
        {
          "s": 21,
          "text": "וממלא"
        },
        {
          "s": 22,
          "text": "(אלקים)"
        },
        {
          "s": 23,
          "text": "הוא ע\"י שההמשכה היא מאוא\"ס שלמעלה מהוי'53."
        },
        {
          "s": 24,
          "text": "וזהו שממשיך בכתוב כי כשלת בעוניך,"
        },
        {
          "s": 25,
          "text": "שהוא טעם על זה שהתשובה צריכה להיות באופן זה,"
        },
        {
          "s": 26,
          "text": "דמכיון שכשלת בעוניך,"
        },
        {
          "s": 27,
          "text": "לכן אין מספיק העבודה דבכל לבבך ובכל נפשך שמצד השמות אלקים והוי',"
        },
        {
          "s": 28,
          "text": "וצריכה להיות העבודה דבכל מאדך,"
        },
        {
          "s": 29,
          "text": "בכדי שתהי' ההמשכה מאוא\"ס שלמעלה מהוי'."
        }
      ]
    }
  ]
}