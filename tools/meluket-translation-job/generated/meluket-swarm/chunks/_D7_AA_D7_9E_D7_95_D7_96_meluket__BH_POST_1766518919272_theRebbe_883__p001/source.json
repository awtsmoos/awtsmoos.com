{
  "globalIndex": 925,
  "owner": 25,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919272_theRebbe_883__p001",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919272_theRebbe_883__p001",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919272_theRebbe_883",
  "title": "מאמר נתת ליראיך תשל\"ו",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ חוקת-בלק,"
        },
        {
          "s": 2,
          "text": "י\"ב תמוז*"
        },
        {
          "s": 3,
          "text": "ה'תשל\"ו"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "נתת ליראיך נס להתנוסס מפני קשט סלה1,"
        },
        {
          "s": 1,
          "text": "ומביא כ\"ק מו\"ח אדמו\"ר בעל הגאולה והשמחה במאמרו"
        },
        {
          "s": 2,
          "text": "(ד\"ה זה2)"
        },
        {
          "s": 3,
          "text": "פי' הת\"י יהבתא לדחליך נסא לאתנסאה בי'"
        },
        {
          "s": 4,
          "text": "(מלשון נסיון)"
        },
        {
          "s": 5,
          "text": "מן בגלל קושטי' דאברהם לעלמין."
        },
        {
          "s": 6,
          "text": "והנה פסוק זה אמרו דוד נעים זמירות ישראל3"
        },
        {
          "s": 7,
          "text": "בשם כאו\"א מישראל4."
        },
        {
          "s": 8,
          "text": "שמזה מובן,"
        },
        {
          "s": 9,
          "text": "דכל הפרטים שבכתוב זה ישנם ג\"כ אצל כאו\"א מישראל5."
        },
        {
          "s": 10,
          "text": "וכמובן ג\"כ מפי' התרגום דמפני קשט סלה היינו קושטי' דאברהם,"
        },
        {
          "s": 11,
          "text": "וידוע6"
        },
        {
          "s": 12,
          "text": "דבחי' האבות ישנה אצל כאו\"א,"
        },
        {
          "s": 13,
          "text": "דאין קורין אבות אלא לשלשה7,"
        },
        {
          "s": 14,
          "text": "ראש צורים גו'8,"
        },
        {
          "s": 15,
          "text": "ובפרט אברהם שהוא ראש לאבות9."
        },
        {
          "s": 16,
          "text": "ומזה מובן דגם מש\"נ נתת ליראיך גו'"
        },
        {
          "s": 17,
          "text": "(שהטעם ע\"ז הוא מפני קשט סלה)"
        },
        {
          "s": 18,
          "text": "קאי ג\"כ על כאו\"א מישראל,"
        },
        {
          "s": 19,
          "text": "וכמ\"ש10"
        },
        {
          "s": 20,
          "text": "ועתה ישראל מה ה' אלקיך שואל מעמך כי אם ליראה גו',"
        },
        {
          "s": 21,
          "text": "דלגבי בחי' משה שבכאו\"א יראה היא מילתא11"
        },
        {
          "s": 22,
          "text": "זוטרתא12."
        },
        {
          "s": 23,
          "text": "וי\"ל שלכן כאו\"א מישראל,"
        },
        {
          "s": 24,
          "text": "גם אשר בשם ישראל יכונה13,"
        },
        {
          "s": 25,
          "text": "נקרא ליראיך."
        },
        {
          "s": 26,
          "text": "וז\"ש נתת ליראיך נס להתנוסס מפני קשט סלה,"
        },
        {
          "s": 27,
          "text": "שהקב\"ה נותן לכאו\"א מישראל נס להתנוסס"
        },
        {
          "s": 28,
          "text": "(מלשון נסיון),"
        },
        {
          "s": 29,
          "text": "כי בכאו\"א ישנו הקושטי' דאברהם."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 2,
          "text": "וידוע דאברהם אבינו ע\"ה פתח הצנור14"
        },
        {
          "s": 3,
          "text": "דמסירת נפש."
        },
        {
          "s": 4,
          "text": "ויש לומר שבזה מבאר טעם הדבר שעבודת הנסיונות קשורה עם קושטי' דאברהם דוקא."
        },
        {
          "s": 5,
          "text": "דלכאורה הרי עיקר עבודת אברהם לא היתה בענין דליראיך,"
        },
        {
          "s": 6,
          "text": "עבודת היראה,"
        },
        {
          "s": 7,
          "text": "כ\"א בהאהבה וכמש\"נ15"
        },
        {
          "s": 8,
          "text": "אברהם אוהבי,"
        },
        {
          "s": 9,
          "text": "ע\"ז מבאר שאאע\"ה פתח הצנור דמס\"נ,"
        },
        {
          "s": 10,
          "text": "שעבודת הנסיונות היא ע\"י מס\"נ דוקא,"
        },
        {
          "s": 11,
          "text": "דמס\"נ היא שלימות ענין היראה והביטול16."
        },
        {
          "s": 12,
          "text": "וז\"ש17"
        },
        {
          "s": 13,
          "text": "לאחרי נסיון העקידה עתה ידעתי כי ירא אלקים אתה."
        },
        {
          "s": 14,
          "text": "והנה זה שעבודת הנסיונות היא ע\"י מס\"נ דוקא,"
        },
        {
          "s": 15,
          "text": "הכוונה בזה היא לדרגא נעלית שבה."
        },
        {
          "s": 16,
          "text": "דהנה כללות העבודה בתומ\"צ צ\"ל מיוסדת על עבודה דמס\"נ,"
        },
        {
          "s": 17,
          "text": "וכדאיתא בתניא18"
        },
        {
          "s": 18,
          "text": "הטעם למה צוה משה רבינו ע\"ה לדור שנכנסו לארץ לקרות ק\"ש כו' משום שקיום התומ\"צ תלוי בזה שיזכור ענין המס\"נ כו',"
        },
        {
          "s": 19,
          "text": "וכן כללות עסק התומ\"צ והתפלה אצל הנשמה הוא ענין של מס\"נ כו' כיון שאינה מהרהרת בצרכי הגוף כו'19,"
        },
        {
          "s": 20,
          "text": "אבל מ\"מ עבודתו בגלוי אינה ענין של מס\"נ,"
        },
        {
          "s": 21,
          "text": "כ\"א עבודה דתומ\"צ,"
        },
        {
          "s": 22,
          "text": "שמקיים המ\"ע בכל פרטיהן ונזהר במל\"ת בכל פרטיהן,"
        },
        {
          "s": 23,
          "text": "שמזה מובן שאין זה עבודת המס\"נ כמו שהיא לעצמה,"
        },
        {
          "s": 24,
          "text": "אלא כמו שהיא קשורה עם עבודה דתומ\"צ ומלובשת בה,"
        },
        {
          "s": 25,
          "text": "שהיא עבודה ע\"פ טו\"ד."
        },
        {
          "s": 26,
          "text": "וי\"ל שבכחות הנפש הו\"ע העבודה מצד מקיף הקרוב השייך לפנימי ומתלבש בו,"
        },
        {
          "s": 27,
          "text": "ע\"ד כח הרצון שמתלבש בחכמה,"
        },
        {
          "s": 28,
          "text": "ועל ידה בכללות כח השכל ומדות,"
        },
        {
          "s": 29,
          "text": "כחות הפנימיים של האדם,"
        },
        {
          "s": 30,
          "text": "משא\"כ עבודת הנסיונות היא ע\"י עבודת המס\"נ עצמה,"
        },
        {
          "s": 31,
          "text": "ומה שנשתלשל מזה עניני עבודה בעשר כחות נפשו הוא ע\"ד טפל ותוצאה מעיקר ענינו,"
        },
        {
          "s": 32,
          "text": "שהו\"ע המס\"נ."
        },
        {
          "s": 33,
          "text": "וי\"ל שבכחות הנפש היא בחי' מקיף הרחוק,"
        },
        {
          "s": 34,
          "text": "בחי' יחידה שבנפש20."
        },
        {
          "s": 35,
          "text": "ועפ\"ז יש לקשר ב' הפירושים שבפסוק נתת גו' נס להתנוסס,"
        },
        {
          "s": 36,
          "text": "א' ענין הנסיונות כפי' הת\"י"
        },
        {
          "s": 37,
          "text": "(כנ\"ל),"
        },
        {
          "s": 38,
          "text": "ב' ענין הנסים21,"
        },
        {
          "s": 39,
          "text": "ונס להתנוסס הוא"
        },
        {
          "s": 40,
          "text": "(ע\"ד לשון חז\"ל22)"
        },
        {
          "s": 41,
          "text": "נס בתוך נס,"
        },
        {
          "s": 42,
          "text": "כי עבודת הנסיונות היא מצד בחי' נס בתוך נס שבנפש,"
        },
        {
          "s": 43,
          "text": "בחי' יחידה."
        }
      ]
    }
  ]
}