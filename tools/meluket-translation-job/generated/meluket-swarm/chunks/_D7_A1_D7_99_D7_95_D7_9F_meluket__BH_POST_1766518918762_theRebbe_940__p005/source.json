{
  "globalIndex": 843,
  "owner": 43,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918762_theRebbe_940__p005",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918762_theRebbe_940__p005",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918762_theRebbe_940",
  "title": "מאמר וידבר אלוקים את כל הדברים האלה תשכ\"ט",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וזהו שאמרו רז\"ל52"
        },
        {
          "s": 2,
          "text": "עה\"פ53"
        },
        {
          "s": 3,
          "text": "לריח שמניך טובים שמן תורק שמך,"
        },
        {
          "s": 4,
          "text": "כל השירים54"
        },
        {
          "s": 5,
          "text": "שאמרו לפניך האבות ריחות היו אבל אנו שמן תורק שמך כאדם שמוריק מכלי לכלי,"
        },
        {
          "s": 6,
          "text": "כל המצוות שעשו לפניך האבות ריחות היו אבל אנו שמן תורק שמך,"
        },
        {
          "s": 7,
          "text": "דיש לומר,"
        },
        {
          "s": 8,
          "text": "שבמרז\"ל זה מבוארים כל ג' הענינים שנתחדשו במתן תורה."
        },
        {
          "s": 9,
          "text": "דהחילוק שבין ריח לשמן בהם עצמם,"
        },
        {
          "s": 10,
          "text": "שהריח הוא רק התפשטות"
        },
        {
          "s": 11,
          "text": "(הארת)"
        },
        {
          "s": 12,
          "text": "השמן,"
        },
        {
          "s": 13,
          "text": "מורה על החידוש בתורה ובמצוות"
        },
        {
          "s": 14,
          "text": "(שניתנו במ\"ת)"
        },
        {
          "s": 15,
          "text": "בנוגע לנותן התורה ומצַוה המצוות."
        },
        {
          "s": 16,
          "text": "דהתורה כמו שהיא מצד עצמה"
        },
        {
          "s": 17,
          "text": "(חכמתו של הקב\"ה)"
        },
        {
          "s": 18,
          "text": "היא הארה בלבד"
        },
        {
          "s": 19,
          "text": "(ריח),"
        },
        {
          "s": 20,
          "text": "ואמיתית הענין דאורייתא וקוב\"ה כולא חד55"
        },
        {
          "s": 21,
          "text": "נעשה במתן תורה,"
        },
        {
          "s": 22,
          "text": "שאז נמשך בה העצמות"
        },
        {
          "s": 23,
          "text": "(שמן)."
        },
        {
          "s": 24,
          "text": "ועד\"ז הוא בנוגע למצוות,"
        },
        {
          "s": 25,
          "text": "שבמתן תורה נמשך בהם העצמות."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ועוד חילוק בין ריח השמן להשמן עצמו,"
        },
        {
          "s": 1,
          "text": "שע\"י שמריחים את ריח השמן לא נחסר מאומה מהשמן,"
        },
        {
          "s": 2,
          "text": "משא\"כ כשלוקחים את השמן עצמו הוא נחסר בהמקום שהי' בו תחלה"
        },
        {
          "s": 3,
          "text": "(שמן תורק שמך,"
        },
        {
          "s": 4,
          "text": "כאדם שמוריק מכלי לכלי)."
        },
        {
          "s": 5,
          "text": "ובהנמשל הוא,"
        },
        {
          "s": 6,
          "text": "שע\"י נתינת התורה למטה,"
        },
        {
          "s": 7,
          "text": "ניטל56"
        },
        {
          "s": 8,
          "text": "מהעליונים הכח לפסוק דין,"
        },
        {
          "s": 9,
          "text": "דתורה לא."
        },
        {
          "s": 10,
          "text": "בשמים היא57."
        },
        {
          "s": 11,
          "text": "ועוד חילוק בין ריח לשמן,"
        },
        {
          "s": 12,
          "text": "דהריח הוא הולך וכלה ועד שלא נשאר ממנו מאומה,"
        },
        {
          "s": 13,
          "text": "וגם ההנאה שהאדם נהנה מהריח,"
        },
        {
          "s": 14,
          "text": "לאחרי שנפסק הריח עוברת הנאתו58,"
        },
        {
          "s": 15,
          "text": "משא\"כ המאכל"
        },
        {
          "s": 16,
          "text": "(שמן59),"
        },
        {
          "s": 17,
          "text": "גם לאחרי שנתעכל המזון במעיו,"
        },
        {
          "s": 18,
          "text": "נשאר במציאות,"
        },
        {
          "s": 19,
          "text": "אלא שנהפך לדם ובשר,"
        },
        {
          "s": 20,
          "text": "ועי\"ז הוא פועל בהאדם שהתכונות שלו יהיו כפי תכונות המאכל60."
        },
        {
          "s": 21,
          "text": "ובהנמשל הוא,"
        },
        {
          "s": 22,
          "text": "שההמשכה ע\"י קיום המצוות ומכש\"כ ע\"י לימוד התורה דהאבות לא נקבעה בהעולם בפנימיותו61."
        },
        {
          "s": 23,
          "text": "וע\"י לימוד התורה שלאחרי מתן תורה ומכש\"כ ע\"י קיום המצוות נעשה שינוי העולם בפנימיות ובקביעות."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "דבג' ענינים הנ\"ל שנתחדשו במתן תורה,"
        },
        {
          "s": 3,
          "text": "החידוש העיקרי הוא שבמ\"ת נעשה המשכת העצמות בתורה,"
        },
        {
          "s": 4,
          "text": "ועי\"ז נעשה החידוש גם בהתורה ובמקבלי התורה."
        },
        {
          "s": 5,
          "text": "דהתורה מצד עצמה,"
        },
        {
          "s": 6,
          "text": "כיון שהיא באין ערוך לגמרי להעולם,"
        },
        {
          "s": 7,
          "text": "אין שינוי בהדברים שבעולם ע\"י דיני התורה,"
        },
        {
          "s": 8,
          "text": "ועד\"ז הוא בנוגע למצוות."
        },
        {
          "s": 9,
          "text": "והכח שבהתורה והמצוות שניתנו במ\"ת לפעול שינוי בהעולם הוא כי במתן תורה נמשך העצמות בהתורה ומצוותי',"
        },
        {
          "s": 10,
          "text": "ועי\"ז יש בהם הכח לפעול גם בהדברים שבעולם שאינם בערך להתומ\"צ כי העצמות הוא בכל מקום."
        },
        {
          "s": 11,
          "text": "ועד\"ז הוא בנוגע להכח שניתן לישראל לפסוק הלכות ועד לאופן דקוב\"ה חייך ואמר נצחוני בני נצחוני,"
        },
        {
          "s": 12,
          "text": "דכח זה שבישראל הוא לפי ששורש הנשמות הוא בעצמותו ית'"
        },
        {
          "s": 13,
          "text": "(למעלה מכמו שצמצם את עצמו בתואר קוב\"ה)62."
        },
        {
          "s": 14,
          "text": "והגילוי דשורש הנשמה"
        },
        {
          "s": 15,
          "text": "(כמו שמושרשת בהעצמות)"
        },
        {
          "s": 16,
          "text": "בהנשמה כמו שבאה בהמשכה ועאכו\"כ בהנשמה המלובשת בגוף,"
        },
        {
          "s": 17,
          "text": "הוא ע\"י התורה."
        },
        {
          "s": 18,
          "text": "דע\"י שהפתיחה דמתן תורה היתה באנכי ר\"ת אנא נפשי כתבית יהבית,"
        },
        {
          "s": 19,
          "text": "שהכניס כביכול את עצמותו בתורה,"
        },
        {
          "s": 20,
          "text": "עי\"ז נעשה אנכי"
        },
        {
          "s": 21,
          "text": "(הוי')"
        },
        {
          "s": 22,
          "text": "אלקיך"
        },
        {
          "s": 23,
          "text": "(לשון יחיד)"
        },
        {
          "s": 24,
          "text": "דכאו\"א מישראל,"
        },
        {
          "s": 25,
          "text": "וע\"י עסק התורה שלו כדבעי,"
        },
        {
          "s": 26,
          "text": "נמשך זה בגילוי."
        }
      ]
    }
  ]
}