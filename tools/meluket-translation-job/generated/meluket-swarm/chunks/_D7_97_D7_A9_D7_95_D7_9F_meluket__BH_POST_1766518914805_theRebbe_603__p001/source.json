{
  "globalIndex": 175,
  "owner": 25,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914805_theRebbe_603__p001",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914805_theRebbe_603__p001",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518914805_theRebbe_603",
  "title": "מאמר ויאמר ה' אל אברם תשל\"ח",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "מוצאי ש\"פ לך לך – בחדרו – ה'תשל\"ח"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "ויאמר ה' אל אברם לך לך מארצך וממולדתך ומבית אביך אל הארץ אשר אראך,"
        },
        {
          "s": 1,
          "text": "וידוע1"
        },
        {
          "s": 2,
          "text": "שיש בזה ב' פירושים."
        },
        {
          "s": 3,
          "text": "פירוש הא' שההליכה"
        },
        {
          "s": 4,
          "text": "(דלך לך)"
        },
        {
          "s": 5,
          "text": "היא מלמעלמ\"ט."
        },
        {
          "s": 6,
          "text": "וכמבואר בתו\"א2"
        },
        {
          "s": 7,
          "text": "שאברם הוא אב רם,"
        },
        {
          "s": 8,
          "text": "שכל הנעלם מכל רעיון"
        },
        {
          "s": 9,
          "text": "[שהוא למעלה גם מבחי' חכמה."
        },
        {
          "s": 10,
          "text": "כי חכמה"
        },
        {
          "s": 11,
          "text": "(עם היותה ראשית כל הכחות פנימיים)"
        },
        {
          "s": 12,
          "text": "היא בחי' גילוי."
        },
        {
          "s": 13,
          "text": "משא\"כ אב רם הוא שכל הנעלם מכל רעיון."
        },
        {
          "s": 14,
          "text": "וכמבואר בהגהות וביאורי הצ\"צ לתו\"א שם3"
        },
        {
          "s": 15,
          "text": "פרטי הדרגות שבזה]."
        },
        {
          "s": 16,
          "text": "ואמר ה' אל אברם לך לך מארצך גו' שיצא אורו הנעלם לגילוי ויומשך מלמעלה למטה עד אל הארץ,"
        },
        {
          "s": 17,
          "text": "בחי' מלכות."
        },
        {
          "s": 18,
          "text": "ומוסיף \"אשר אראך\","
        },
        {
          "s": 19,
          "text": "ובזה ב' פירושים."
        },
        {
          "s": 20,
          "text": "א'"
        },
        {
          "s": 21,
          "text": "(כפשוטו)"
        },
        {
          "s": 22,
          "text": "שאראך קאי על הארץ,"
        },
        {
          "s": 23,
          "text": "בחי' מלכות,"
        },
        {
          "s": 24,
          "text": "שהמלכות היא בחי' עלמא דאתגליא לכן אומר עלי' אשר אראך4."
        },
        {
          "s": 25,
          "text": "ופירוש ב' שאראך קאי על אברם"
        },
        {
          "s": 26,
          "text": "(בחי' שכל הנעלם מכל רעיון)"
        },
        {
          "s": 27,
          "text": "– \"אראה ואגלה אותך בעצמך\"5"
        },
        {
          "s": 28,
          "text": "(\"במהותך ועצמותך\"6)."
        },
        {
          "s": 29,
          "text": "והיינו,"
        },
        {
          "s": 30,
          "text": "דהגם שספירת המלכות עלמא דאתגליא"
        },
        {
          "s": 31,
          "text": "(ובפרט כמו שנמשכת בבי\"ע7)"
        },
        {
          "s": 32,
          "text": "היא קצה הכי תחתון,"
        },
        {
          "s": 33,
          "text": "ושכל הנעלם מכל רעיון"
        },
        {
          "s": 34,
          "text": "(שהוא נעלם גם מרעיון העליון)"
        },
        {
          "s": 35,
          "text": "הוא קצה הכי עליון,"
        },
        {
          "s": 36,
          "text": "אעפ\"כ,"
        },
        {
          "s": 37,
          "text": "ע\"י הירידה וההמשכה"
        },
        {
          "s": 38,
          "text": "(דאברם,"
        },
        {
          "s": 39,
          "text": "שכל הנעלם מכל רעיון)"
        },
        {
          "s": 40,
          "text": "אל הארץ אשר אראך"
        },
        {
          "s": 41,
          "text": "(כפירוש הא'),"
        },
        {
          "s": 42,
          "text": "לבחי' מלכות עלמא דאתגליא"
        },
        {
          "s": 43,
          "text": "(קצה התחתון),"
        },
        {
          "s": 44,
          "text": "עי\"ז יתראה ויתגלה אמיתית ענינו"
        },
        {
          "s": 45,
          "text": "(מהותו ועצמותו)"
        },
        {
          "s": 46,
          "text": "של אברם"
        },
        {
          "s": 47,
          "text": "(כפירוש הב'),"
        },
        {
          "s": 48,
          "text": "שנעשה עילוי"
        },
        {
          "s": 49,
          "text": "(גם)"
        },
        {
          "s": 50,
          "text": "בבחי' שכל הנעלם מכל רעיון"
        },
        {
          "s": 51,
          "text": "(קצה הכי עליון),"
        },
        {
          "s": 52,
          "text": "כמובן מהמבואר בתו\"א שם8."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ועד\"ז הוא גם בענין ירידת הנשמה בגוף9,"
        },
        {
          "s": 2,
          "text": "שהעלי' הנעשית בהנשמה ע\"י ירידתה למטה"
        },
        {
          "s": 3,
          "text": "[שנעשית בבחינת מהלך10,"
        },
        {
          "s": 4,
          "text": "ענין \"לך לך\"11],"
        },
        {
          "s": 5,
          "text": "היא גם בהדרגות הכי נעלות שבה,"
        },
        {
          "s": 6,
          "text": "ואפילו בבחינת יחידה."
        },
        {
          "s": 7,
          "text": "דהגם דזה שנקראת יחידה הוא להיותה \"מקבלת מיחיד\"12"
        },
        {
          "s": 8,
          "text": "[שלכן13"
        },
        {
          "s": 9,
          "text": "אין שייך שתהי' כנגדה בלעו\"ז,"
        },
        {
          "s": 10,
          "text": "בבואה דבבואה לית להו14],"
        },
        {
          "s": 11,
          "text": "מ\"מ,"
        },
        {
          "s": 12,
          "text": "ע\"י שהנשמה יורדת למטה,"
        },
        {
          "s": 13,
          "text": "מאיגרא רמה לבירא עמיקתא15,"
        },
        {
          "s": 14,
          "text": "נעשה עלי' גם בבחינת יחידה שבה."
        },
        {
          "s": 15,
          "text": "כמבואר בכמה דרושים16"
        },
        {
          "s": 16,
          "text": "שע\"י עבודת הנשמה בירידתה למטה דוקא נעשה עלי'"
        },
        {
          "s": 17,
          "text": "(ועלי' שלא בערך)"
        },
        {
          "s": 18,
          "text": "גם בשרש ועצם הנשמה שלמעלה."
        },
        {
          "s": 19,
          "text": "וכמובן גם מהמבואר בכמה שיחות17"
        },
        {
          "s": 20,
          "text": "(בענין עלי' לתורה),"
        },
        {
          "s": 21,
          "text": "שהעלי' היא בכל חמש הבחינות שבנשמה נפש רוח נשמה חי' יחידה,"
        },
        {
          "s": 22,
          "text": "שהם ג' הבחינות תחתיים שניים ושלישיים18"
        },
        {
          "s": 23,
          "text": "דתיבת נח."
        },
        {
          "s": 24,
          "text": "וע\"פ משנת\"ל19"
        },
        {
          "s": 25,
          "text": "(ע\"פ תורת הבעש\"ט20"
        },
        {
          "s": 26,
          "text": "עה\"פ21"
        },
        {
          "s": 27,
          "text": "בא גו' אל התיבה)"
        },
        {
          "s": 28,
          "text": "שענין תיבת נח הוא \"הוראה בסדר עבודה\"22"
        },
        {
          "s": 29,
          "text": "לכאו\"א מישראל"
        },
        {
          "s": 30,
          "text": "[ובפרט לאחרי חודש תשרי שאז מתחיל סדר העבודה ד\"ויעקב הלך לדרכו\"23."
        },
        {
          "s": 31,
          "text": "שהגם שהוא הולך לדרכו"
        },
        {
          "s": 32,
          "text": "(גם)"
        },
        {
          "s": 33,
          "text": "בעניני הרשות ובעובדין דחול,"
        },
        {
          "s": 34,
          "text": "ועד לבחי' מים רבים שהם כל טרדות הפרנסה כו'24,"
        },
        {
          "s": 35,
          "text": "מ\"מ ע\"י שמכניס את עצמו בהתיבות דתפלה ותורה הנה לא זו בלבד שהוא \"ניצל מהשטף דמבול\"22"
        },
        {
          "s": 36,
          "text": "אלא יתירה מזו שע\"י המים נעשה ותרם התיבה25"
        },
        {
          "s": 37,
          "text": "ועד שנעשה ותנח התיבה26],"
        },
        {
          "s": 38,
          "text": "מובן מזה,"
        },
        {
          "s": 39,
          "text": "שעליית הנשמה שנעשה ע\"י ירידתה למטה והתלבשותה במים רבים הוא בכל ג' הבחינות"
        },
        {
          "s": 40,
          "text": "(דתיבת נח)"
        },
        {
          "s": 41,
          "text": "תחתיים שניים ושלישיים,"
        },
        {
          "s": 42,
          "text": "שענינם בנפש האדם הוא נר\"נ חי' יחידה27."
        },
        {
          "s": 43,
          "text": "בדוגמת המבואר לעיל"
        },
        {
          "s": 44,
          "text": "(סעיף א')"
        },
        {
          "s": 45,
          "text": "שע\"י הליכת וירידת אברם אל הארץ בחי' מלכות,"
        },
        {
          "s": 46,
          "text": "שהתכלית"
        },
        {
          "s": 47,
          "text": "(דירידה זו)"
        },
        {
          "s": 48,
          "text": "הוא להיות גילוי בבי\"ע28"
        },
        {
          "s": 49,
          "text": "[וכידוע29,"
        },
        {
          "s": 50,
          "text": "שהליכת אברם אל הארץ הי' בכדי להמשיך בבי\"ע עד בעוה\"ז הגשמי,"
        },
        {
          "s": 51,
          "text": "שעי\"ז עשה הכנה לההמשכה שע\"י מעשה המצוות בגשמיות לאחרי מתן תורה]"
        },
        {
          "s": 52,
          "text": "נעשה עילוי גם בבחי' שכל הנעלם מכל רעיון."
        }
      ]
    }
  ]
}