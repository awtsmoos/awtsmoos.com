{
  "globalIndex": 293,
  "owner": 43,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915437_theRebbe_101__p005",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915437_theRebbe_101__p005",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915437_theRebbe_101",
  "title": "מאמר אשר ברא תשל\"ט",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וזהו אשר ברא ששון ושמחה חתן וכלה כו',"
        },
        {
          "s": 2,
          "text": "שקאי"
        },
        {
          "s": 3,
          "text": "(גם)"
        },
        {
          "s": 4,
          "text": "על בריאת חתן וכלה שלמעלה"
        },
        {
          "s": 5,
          "text": "(שמהם משתלשלים חתן וכלה שלמטה)."
        },
        {
          "s": 6,
          "text": "וזה שנקראים בשם חתן וכלה"
        },
        {
          "s": 7,
          "text": "(דשמו אשר יקראו לו בלה\"ק מורה על תוכנו של הדבר ועד שהוא המהוה ומחי' ומקיים את הדבר כתורת הבעש\"ט הידועה67),"
        },
        {
          "s": 8,
          "text": "הוא,"
        },
        {
          "s": 9,
          "text": "כי חתן הוא מלשון חות דרגא כמשנת\"ל"
        },
        {
          "s": 10,
          "text": "(סעיף ג),"
        },
        {
          "s": 11,
          "text": "וכלה היא מלשון כליון ומלשון כלתה נפשי68"
        },
        {
          "s": 12,
          "text": "[שהם שתי בחי' בכלה,"
        },
        {
          "s": 13,
          "text": "כמבואר בלקו\"ת69]."
        },
        {
          "s": 14,
          "text": "והכוונה בבריאת חתן וכלה שלמעלה היא בכדי שיומשכו מהם חתן וכלה שלמטה,"
        },
        {
          "s": 15,
          "text": "וכמבואר לעיל"
        },
        {
          "s": 16,
          "text": "(סעיף ג)"
        },
        {
          "s": 17,
          "text": "בפירוש הכתוב כי אמרתי עולם חסד יבנה שבנין ספירת החסד הוא בכדי שיהי' התהוות העולם."
        },
        {
          "s": 18,
          "text": "ולכן ע\"י עבודת ישראל למטה ובפרט בזה שמשמחים את החתן וכלה"
        },
        {
          "s": 19,
          "text": "(כפשוטם למטה),"
        },
        {
          "s": 20,
          "text": "עי\"ז פועלים הן לעילא והן לתתא,"
        },
        {
          "s": 21,
          "text": "ועד שנעשה שמח תשמח רעים האהובים כשמחך יצירך בגן עדן מקדם70"
        },
        {
          "s": 22,
          "text": "(קודם החטא)"
        },
        {
          "s": 23,
          "text": "שאז הי' העולם על מילואו71,"
        },
        {
          "s": 24,
          "text": "אלה תולדות השמים והארץ בהבראם72,"
        },
        {
          "s": 25,
          "text": "תולדות מלא73."
        },
        {
          "s": 26,
          "text": "ויתירה מזו,"
        },
        {
          "s": 27,
          "text": "דכיון שהכוונה בהירידה"
        },
        {
          "s": 28,
          "text": "(דעולם)"
        },
        {
          "s": 29,
          "text": "שנעשה ע\"י חטא עה\"ד היא לצורך עלי',"
        },
        {
          "s": 30,
          "text": "הרי מובן שהעלי' היא למקום גבוה יותר מכמו שהי' קודם הירידה,"
        },
        {
          "s": 31,
          "text": "ולכן,"
        },
        {
          "s": 32,
          "text": "ע\"י העבודה"
        },
        {
          "s": 33,
          "text": "(שלאחרי החטא)"
        },
        {
          "s": 34,
          "text": "יהי' עילוי נעלה יותר גם מכמו שהי' בתחלת הבריאה,"
        },
        {
          "s": 35,
          "text": "אלה תולדות פרץ74,"
        },
        {
          "s": 36,
          "text": "תולדות מלא73,"
        },
        {
          "s": 37,
          "text": "דתולדות מלא שבפסוק זה הוא למעלה יותר מתולדות מלא שבתחלת הבריאה."
        },
        {
          "s": 38,
          "text": "וגילוי עילוי זה יהי' בביאת משיח צדקנו,"
        },
        {
          "s": 39,
          "text": "כמו שמסיים שם"
        },
        {
          "s": 40,
          "text": "(בתולדות פרץ75)"
        },
        {
          "s": 41,
          "text": "וישי הוליד את דוד,"
        },
        {
          "s": 42,
          "text": "דוד מלכא משיחא."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "וגילוי זה יהי' בקרוב ממש ובעגלא דידן,"
        },
        {
          "s": 1,
          "text": "בחסד וברחמים ובטוב הנראה והנגלה,"
        },
        {
          "s": 2,
          "text": "ע\"י מעשינו ועבודתנו במשך שיתא76"
        },
        {
          "s": 3,
          "text": "אלפי שני דהוה עלמא77"
        },
        {
          "s": 4,
          "text": "[שזה כולל ענין הזמן"
        },
        {
          "s": 5,
          "text": "(שיתא אלפי שני)"
        },
        {
          "s": 6,
          "text": "וענין המקום"
        },
        {
          "s": 7,
          "text": "(עלמא)"
        },
        {
          "s": 8,
          "text": "יחד],"
        },
        {
          "s": 9,
          "text": "ובפרט ע\"י העבודה דיפוצו מעינותיך,"
        },
        {
          "s": 10,
          "text": "המעיינות דתורת הבעש\"ט,"
        },
        {
          "s": 11,
          "text": "ובפרט כמו שנתגלו ע\"י אדמו\"ר הזקן לאחרי י\"ט כסלו"
        },
        {
          "s": 12,
          "text": "[וכידוע מאמר אדמו\"ר"
        },
        {
          "s": 13,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 14,
          "text": "נ\"ע78"
        },
        {
          "s": 15,
          "text": "שענין יפוצו מעינותיך חוצה הותחל בעיקר לאחרי פטרבורג],"
        },
        {
          "s": 16,
          "text": "שעי\"ז אתי מר דא מלכא משיחא79"
        },
        {
          "s": 17,
          "text": "שאז יהיו הנישואין של הקב\"ה וכנסת ישראל80,"
        },
        {
          "s": 18,
          "text": "וגם הנישואין דהקב\"ה ודכל אחד מישראל,"
        },
        {
          "s": 19,
          "text": "בתכלית השלימות,"
        },
        {
          "s": 20,
          "text": "כמבואר בארוכה בכ\"מ81"
        },
        {
          "s": 21,
          "text": "עה\"פ82"
        },
        {
          "s": 22,
          "text": "כימי צאתך מארץ מצרים אראנו נפלאות שהענינים דלע\"ל יהיו נפלאות – נו\"ן פלאות – אפילו בערך הנסים והנפלאות דיציאת מצרים,"
        },
        {
          "s": 23,
          "text": "שאז יהי' ענין הנישואין בשלימות,"
        },
        {
          "s": 24,
          "text": "בקרוב ממש,"
        },
        {
          "s": 25,
          "text": "במהרה בימינו."
        }
      ]
    }
  ]
}