{
  "globalIndex": 438,
  "owner": 38,
  "jobId": "_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916230_theRebbe_919__p005",
  "batchId": "meluket-_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916230_theRebbe_919__p005",
  "seriesId": "טבת_meluket",
  "postId": "BH_POST_1766518916230_theRebbe_919",
  "title": "מאמר הבאים ישרש יעקב תשמ\"ח",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וצריך להבין,"
        },
        {
          "s": 2,
          "text": "דלפי ביאור הנ\"ל,"
        },
        {
          "s": 3,
          "text": "השייכות דקיום המצוות עכשיו"
        },
        {
          "s": 4,
          "text": "(פירוש השני)"
        },
        {
          "s": 5,
          "text": "להגאולה"
        },
        {
          "s": 6,
          "text": "(פירוש הראשון)"
        },
        {
          "s": 7,
          "text": "הוא בהענין דישרש יעקב,"
        },
        {
          "s": 8,
          "text": "שענינה של המשכת השרש עכשיו הוא שההמשכה תהי' בגילוי,"
        },
        {
          "s": 9,
          "text": "ומזה שאומר בהמאמר"
        },
        {
          "s": 10,
          "text": "(בתחלתו,"
        },
        {
          "s": 11,
          "text": "עוד לפני שמעתיק הת\"י)"
        },
        {
          "s": 12,
          "text": "שהת\"י מפרש הפסוק על הגאולה,"
        },
        {
          "s": 13,
          "text": "מובן שזהו עיקר הפירוש,"
        },
        {
          "s": 14,
          "text": "ומזה משמע דזה שהפירוש שישרש יעקב קאי על קיום המצוות עכשיו בא לאחרי ובהמשך לפירוש הת\"י,"
        },
        {
          "s": 15,
          "text": "הוא,"
        },
        {
          "s": 16,
          "text": "לפי שקיום המצוות עכשיו בא בהמשך לכללות ענין הגאולה."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דזה שמקדים בהמאמר הפירוש שקאי על הגאולה,"
        },
        {
          "s": 2,
          "text": "הוא,"
        },
        {
          "s": 3,
          "text": "כי כל הענינים נמשכים מהתורה,"
        },
        {
          "s": 4,
          "text": "אסתכל באורייתא וברא עלמא37,"
        },
        {
          "s": 5,
          "text": "וע\"י שבתורה מקדימים ענין הגאולה,"
        },
        {
          "s": 6,
          "text": "נמשך כך גם בעולם שהגאולה תהי' בהקדם יותר."
        },
        {
          "s": 7,
          "text": "ולהוסיף,"
        },
        {
          "s": 8,
          "text": "דכאשר יהודי"
        },
        {
          "s": 9,
          "text": "(ומכ\"ש נשיא38)"
        },
        {
          "s": 10,
          "text": "חושב ע\"ד ענין טוב,"
        },
        {
          "s": 11,
          "text": "המחשבה שלו פועלת שכן יהי' בפועל."
        },
        {
          "s": 12,
          "text": "כמאמר הצ\"צ שנתפרסם ע\"י כ\"ק מו\"ח אדמו\"ר39"
        },
        {
          "s": 13,
          "text": "טראַכט גוט וועט זיין גוט."
        },
        {
          "s": 14,
          "text": "וסיפר כ\"ק מו\"ח אדמו\"ר40"
        },
        {
          "s": 15,
          "text": "שהצ\"צ אמר מאמר זה לאחד החסידים,"
        },
        {
          "s": 16,
          "text": "וע\"י מחשבתו של החסיד איז געוואָרן גוט בפועל."
        },
        {
          "s": 17,
          "text": "ויש לומר,"
        },
        {
          "s": 18,
          "text": "דזה שכ\"ק מו\"ח אדמו\"ר הוסיף סיפור הנ\"ל,"
        },
        {
          "s": 19,
          "text": "הוא כי ע\"י שאירע כן בפועל,"
        },
        {
          "s": 20,
          "text": "נמשך זה גם בגשמיות."
        },
        {
          "s": 21,
          "text": "וע\"ד הידוע41"
        },
        {
          "s": 22,
          "text": "דזה שהנביאים עשו גם פעולות"
        },
        {
          "s": 23,
          "text": "(בגשמיות)"
        },
        {
          "s": 24,
          "text": "בהתאם לנבואתם,"
        },
        {
          "s": 25,
          "text": "הוא,"
        },
        {
          "s": 26,
          "text": "כי עי\"ז נעשה הקשר דהנבואה עם"
        },
        {
          "s": 27,
          "text": "(גשמיות)"
        },
        {
          "s": 28,
          "text": "העולם."
        },
        {
          "s": 29,
          "text": "ויש לומר,"
        },
        {
          "s": 30,
          "text": "דכאשר המחשבה באה בדיבור ומכ\"ש במעשה,"
        },
        {
          "s": 31,
          "text": "היא פועלת עוד יותר."
        },
        {
          "s": 32,
          "text": "ועאכו\"כ בנידון דידן,"
        },
        {
          "s": 33,
          "text": "דנוסף לזה שהמחשבה דהצ\"צ"
        },
        {
          "s": 34,
          "text": "(להקדים הפירוש שהבאים ישרש יעקב קאי על הגאולה)"
        },
        {
          "s": 35,
          "text": "באה בכתב"
        },
        {
          "s": 36,
          "text": "(מעשה),"
        },
        {
          "s": 37,
          "text": "הוא גם חלק בתורה."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ויהי רצון,"
        },
        {
          "s": 2,
          "text": "שע\"י הדיבור בענינים אלו ימהרו ויזרזו כל זה עוד יותר,"
        },
        {
          "s": 3,
          "text": "ובפרט ע\"י העבודה דהפצת היהדות בכלל והפצת המעינות בפרט42,"
        },
        {
          "s": 4,
          "text": "שזוהי הכנה קרובה לקיום היעוד43"
        },
        {
          "s": 5,
          "text": "מלאה הארץ דעה את הוי' כמים לים מכסים,"
        },
        {
          "s": 6,
          "text": "סיום וחותם ספרו של הרמב\"ם44"
        },
        {
          "s": 7,
          "text": "(בעל ההילולא דכ\"ף טבת45),"
        },
        {
          "s": 8,
          "text": "שענין זה קשור גם עם התחלת ספרו לידע שיש שם מצוי ראשון."
        },
        {
          "s": 9,
          "text": "וזה קשור גם עם הספר תניא קדישא ספרו של אדמו\"ר הזקן"
        },
        {
          "s": 10,
          "text": "(בעל ההילולא דכ\"ד טבת46),"
        },
        {
          "s": 11,
          "text": "בו47"
        },
        {
          "s": 12,
          "text": "נתבארו הענינים דידיעת השם."
        },
        {
          "s": 13,
          "text": "ויהי רצון שזכותם של בעלי ההילולא שקיבצו וליקטו בספריהם הנ\"ל כל עניני התורה – ספר משנה תורה שמקבץ48"
        },
        {
          "s": 14,
          "text": "כל ההלכות דנגלה דתורה,"
        },
        {
          "s": 15,
          "text": "וספר לקוטי אמרים"
        },
        {
          "s": 16,
          "text": "(תניא)"
        },
        {
          "s": 17,
          "text": "המלקט כל הענינים דפנימיות התורה,"
        },
        {
          "s": 18,
          "text": "וגם הספרים תורה אור ולקוטי תורה שבהם נלקטו המאמרים העיקריים49"
        },
        {
          "s": 19,
          "text": "של אדמו\"ר הזקן כפי שנסדרו ע\"י הצ\"צ – יקרב וימהר עוד יותר קיום היעוד שבההפטורה50"
        },
        {
          "s": 20,
          "text": "ואתם תלוקטו לאחד אחד בני ישראל,"
        },
        {
          "s": 21,
          "text": "ע\"י הקב\"ה עצמו51,"
        },
        {
          "s": 22,
          "text": "שבקרוב ממש ילקט את כולנו,"
        },
        {
          "s": 23,
          "text": "ונלך כולנו יחד לארץ הקודש"
        },
        {
          "s": 24,
          "text": "(כמו שתהי' בהרחבה,"
        },
        {
          "s": 25,
          "text": "ירחיב ה' אלקיך את גבולך52)"
        },
        {
          "s": 26,
          "text": "ושם גופא – לירושלים ולבית המקדש שיבנה במהרה בימינו ממש."
        }
      ]
    }
  ]
}