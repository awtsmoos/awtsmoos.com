{
  "globalIndex": 498,
  "owner": 48,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916723_theRebbe_111__p001",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916723_theRebbe_111__p001",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916723_theRebbe_111",
  "title": "מאמר באתי לגני תשי\"ט",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד,"
        },
        {
          "s": 1,
          "text": "יו\"ד שבט,"
        },
        {
          "s": 2,
          "text": "ה'תשי\"ט"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "(הנחה)"
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "באתי לגני1"
        },
        {
          "s": 1,
          "text": "אחותי כלה2,"
        },
        {
          "s": 2,
          "text": "ומבאר כ\"ק מו\"ח אדמו\"ר בעל ההילולא בהמאמר3"
        },
        {
          "s": 3,
          "text": "עפ\"י המבואר במדרש4"
        },
        {
          "s": 4,
          "text": "לגני לגנוני,"
        },
        {
          "s": 5,
          "text": "למקום שהי' עיקרי בתחילה,"
        },
        {
          "s": 6,
          "text": "דעיקר שכינה בתחתונים היתה,"
        },
        {
          "s": 7,
          "text": "דבתחלת הבריאה עולם על מלואו נברא5,"
        },
        {
          "s": 8,
          "text": "וע\"י חטא עה\"ד והחטאים שלאחריו סילקו את השכינה מלמטה למעלה עד רקיע הז',"
        },
        {
          "s": 9,
          "text": "והצדיקים ע\"י עבודתם המשיכו את השכינה מלמעלה למטה,"
        },
        {
          "s": 10,
          "text": "דהתחלת ההמשכה הי' מאברהם,"
        },
        {
          "s": 11,
          "text": "שהוא הי' הראשון,"
        },
        {
          "s": 12,
          "text": "והורידה מרקיע הז' לו' וכו' עד שבא משה שהוא השביעי וכל השביעין חביבין6"
        },
        {
          "s": 13,
          "text": "והורידה מרקיע הא' למטה בארץ,"
        },
        {
          "s": 14,
          "text": "ולכן למשה נאמר7"
        },
        {
          "s": 15,
          "text": "ועשו לי מקדש ושכנתי בתוכם,"
        },
        {
          "s": 16,
          "text": "דכפשוטו קאי על המשכת אלקות שהי' למטה בארץ,"
        },
        {
          "s": 17,
          "text": "וגם כמאמר רז\"ל8"
        },
        {
          "s": 18,
          "text": "בתוכו לא נאמר אלא בתוכם,"
        },
        {
          "s": 19,
          "text": "בתוך כאו\"א מישראל,"
        },
        {
          "s": 20,
          "text": "ועפי\"ז מבאר בהמאמר9"
        },
        {
          "s": 21,
          "text": "הטעם מה שהמשכן,"
        },
        {
          "s": 22,
          "text": "דמשכן איהו מקדש ומקדש איהו משכן10,"
        },
        {
          "s": 23,
          "text": "הי' מעצי שטים11,"
        },
        {
          "s": 24,
          "text": "דשטים הוא מל' הטי'12"
        },
        {
          "s": 25,
          "text": "כמ\"ש13"
        },
        {
          "s": 26,
          "text": "שטו העם,"
        },
        {
          "s": 27,
          "text": "והוא ההטי' מדרך הישר והמיצוע,"
        },
        {
          "s": 28,
          "text": "שישנה בב' אופנים,"
        },
        {
          "s": 29,
          "text": "ההטי' מדרך המיצוע לגרוע והטי' מדרך המיצוע לטוב,"
        },
        {
          "s": 30,
          "text": "שההטי' לגרוע הוא כמרז\"ל14"
        },
        {
          "s": 31,
          "text": "אין אדם עובר עבירה אא\"כ נכנס בו רוח שטות,"
        },
        {
          "s": 32,
          "text": "ושטות זה שהוא השטות דעולם והשטות דלעו\"ז צריך להפוך לבחי' השטות דקדושה והוא העבודה שלמעלה מטעם ודעת,"
        },
        {
          "s": 33,
          "text": "וזהו"
        },
        {
          "s": 34,
          "text": "(האתהפכא משטות דלעו\"ז לשטות דקדושה)"
        },
        {
          "s": 35,
          "text": "עיקר עבודת המשכן ומקדש,"
        },
        {
          "s": 36,
          "text": "שעי\"ז נעשה ושכנתי בתוכם,"
        },
        {
          "s": 37,
          "text": "שיהי' עיקר שכינה בתחתונים,"
        },
        {
          "s": 38,
          "text": "באתי לגני לגנוני15."
        },
        {
          "s": 39,
          "text": "ועפי\"ז מבאר גם בהמאמר16"
        },
        {
          "s": 40,
          "text": "הטעם מה שעצי שטים נק' בשם קרשים11,"
        },
        {
          "s": 41,
          "text": "שכל השמות שבתורה הם בדיוק ומתאימים לתוכן ענינם17,"
        },
        {
          "s": 42,
          "text": "דהנה האותיות דקרש הם אותיות שקר ואותיות קשר,"
        },
        {
          "s": 43,
          "text": "והיינו אשר מהשקר דעולם צריך להפכם ולעשות מהם קרשי המשכן,"
        },
        {
          "s": 44,
          "text": "בחי' קשר,"
        },
        {
          "s": 45,
          "text": "והיינו לקשר כל עניני העולם בשכינה ובעיקר שכינה שהוא פנימיות ועצמות א\"ס ב\"ה."
        },
        {
          "s": 46,
          "text": "וכמו שמבאר בפרטיות אותיות קו\"ף ורי\"ש ואיך שייך כנגדם בקדושה,"
        },
        {
          "s": 47,
          "text": "ואשר צריך להפכם מהאותיות כמו שהם באתוון דזיופא18"
        },
        {
          "s": 48,
          "text": "לעניני טוב וקדושה,"
        },
        {
          "s": 49,
          "text": "וכמבואר כל הנ\"ל באריכות בסעיפים הקודמים19."
        }
      ]
    }
  ]
}