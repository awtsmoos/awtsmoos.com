{
  "globalIndex": 629,
  "owner": 29,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917418_theRebbe_694__p004",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917418_theRebbe_694__p004",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917418_theRebbe_694",
  "title": "מאמר וקבל היהודים תשי\"א",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ויש לומר בעומק יותר,"
        },
        {
          "s": 2,
          "text": "שגם המצוה דוהגית בו יומם ולילה,"
        },
        {
          "s": 3,
          "text": "כיון שהמצוות הם ציווים להאדם"
        },
        {
          "s": 4,
          "text": "[ודלא כהתורה כמו שהיא חכמתו של הקב\"ה"
        },
        {
          "s": 5,
          "text": "(שלמעלה משייכות לעולם)"
        },
        {
          "s": 6,
          "text": "ורק שאח\"כ ירדה למטה],"
        },
        {
          "s": 7,
          "text": "הרי התורה שלומדים מצד המצוה דוהגית בו יומם ולילה היא"
        },
        {
          "s": 8,
          "text": "(לא התורה כמו שהיא מצד עצמה,"
        },
        {
          "s": 9,
          "text": "אלא)"
        },
        {
          "s": 10,
          "text": "כמו ששייכת להאדם."
        },
        {
          "s": 11,
          "text": "ואמיתית הענין דלימוד התורה עצמה"
        },
        {
          "s": 12,
          "text": "(כמו שהיא למעלה משייכות לאדם)"
        },
        {
          "s": 13,
          "text": "הוא בלימוד התורה לשמה,"
        },
        {
          "s": 14,
          "text": "שהלימוד הוא לא בכדי לקיים מצות תלמוד תורה אלא מצד התורה עצמה."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ויש להוסיף שהמעלה בלימוד התורה לשמה לגבי הלימוד בכדי לקיים מצות ת\"ת הוא לא רק בכוונת הלימוד אלא גם בהלימוד בפועל."
        },
        {
          "s": 1,
          "text": "דכאשר הלימוד הוא בכדי לקיים מצות ת\"ת,"
        },
        {
          "s": 2,
          "text": "הלימוד הוא בהגבלה,"
        },
        {
          "s": 3,
          "text": "דגם במצות והגית בו יומם ולילה יש כו\"כ הגבלות כמבואר בהלכות ת\"ת."
        },
        {
          "s": 4,
          "text": "משא\"כ בלימוד התורה לשמה,"
        },
        {
          "s": 5,
          "text": "אינו מתחשב במדידות והגבלות"
        },
        {
          "s": 6,
          "text": "(אם גם באופן כזה הוא מחוייב ללמוד או לא73),"
        },
        {
          "s": 7,
          "text": "והלימוד שלו הוא למעלה ממדידת והגבלת הזמן,"
        },
        {
          "s": 8,
          "text": "ועד\"ז למעלה מהמדידה והגבלה דמקום כמרז\"ל74"
        },
        {
          "s": 9,
          "text": "לאונסו שאני."
        },
        {
          "s": 10,
          "text": "והטעם לזה"
        },
        {
          "s": 11,
          "text": "(בפנימיות הענינים)"
        },
        {
          "s": 12,
          "text": "הוא,"
        },
        {
          "s": 13,
          "text": "כי המצוה דוהגית היא ציווי להאדם,"
        },
        {
          "s": 14,
          "text": "לכן יש בה הגבלות"
        },
        {
          "s": 15,
          "text": "(לפי האדם)."
        },
        {
          "s": 16,
          "text": "משא\"כ בלימוד התורה לשמה,"
        },
        {
          "s": 17,
          "text": "מכיון שהתורה"
        },
        {
          "s": 18,
          "text": "(כמו שהיא מצד עצמה)"
        },
        {
          "s": 19,
          "text": "היא למעלה ממדידה והגבלה"
        },
        {
          "s": 20,
          "text": "(ארוכה מארץ מדה),"
        },
        {
          "s": 21,
          "text": "לכן,"
        },
        {
          "s": 22,
          "text": "גם לימוד התורה של האדם,"
        },
        {
          "s": 23,
          "text": "כשהלימוד שלו הוא לשמה"
        },
        {
          "s": 24,
          "text": "(מצד התורה עצמה),"
        },
        {
          "s": 25,
          "text": "הוא באופן שהוא יוצא מההגבלות דזמן ומקום."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "שהחיבור דעליונים ותחתונים שנתחדש במתן תורה הוא מתגלה בעיקר בלימוד התורה לשמה."
        },
        {
          "s": 3,
          "text": "דנוסף על זה שבכדי שיוכל להיות החיבור דעליונים ותחתונים הוא ע\"י ביטול הגדר דעליון ותחתון ע\"י המשכת אוא\"ס שלמעלה משניהם"
        },
        {
          "s": 4,
          "text": "(כנ\"ל סעיף ד),"
        },
        {
          "s": 5,
          "text": "שדוגמתו באדם הוא כשעוסק בתורה לשמה שאז הוא בביטול המציאות הן בנוגע להגוף"
        },
        {
          "s": 6,
          "text": "(תחתון)"
        },
        {
          "s": 7,
          "text": "והן בנוגע להנשמה"
        },
        {
          "s": 8,
          "text": "(עליון),"
        },
        {
          "s": 9,
          "text": "הנה גם החיבור דעליונים ותחתונים עצמו מתגלה בלימוד זה,"
        },
        {
          "s": 10,
          "text": "שהבל\"ג דתורה"
        },
        {
          "s": 11,
          "text": "(עליונים)"
        },
        {
          "s": 12,
          "text": "פועל על האדם"
        },
        {
          "s": 13,
          "text": "(תחתונים)"
        },
        {
          "s": 14,
          "text": "שלימוד התורה שלו יהי' למעלה מהגבלה."
        },
        {
          "s": 15,
          "text": "ויש להוסיף,"
        },
        {
          "s": 16,
          "text": "דע\"י שהבל\"ג דתורה פועל גם בהאדם"
        },
        {
          "s": 17,
          "text": "(ועד\"ז ע\"י ירידת התורה למטה בכלל),"
        },
        {
          "s": 18,
          "text": "מתגלה הבל\"ג דתורה עוד יותר,"
        },
        {
          "s": 19,
          "text": "דזה שהתורה היא בל\"ג הוא לא רק בהמקום והדרגא של התורה אלא שהיא נמשכת גם למטה75"
        },
        {
          "s": 20,
          "text": "וגם בהמשכתה למטה נרגש בגילוי הבל\"ג שבה,"
        },
        {
          "s": 21,
          "text": "שגם לימוד התורה של האדם הוא באופן דבל\"ג76."
        }
      ]
    }
  ]
}