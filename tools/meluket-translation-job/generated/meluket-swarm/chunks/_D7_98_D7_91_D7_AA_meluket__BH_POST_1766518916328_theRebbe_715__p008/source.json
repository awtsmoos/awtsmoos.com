  "jobId": "_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916328_theRebbe_715__p008",
  "batchId": "meluket-_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916328_theRebbe_715__p008",
  "seriesId": "טבת_meluket",
  "postId": "BH_POST_1766518916328_theRebbe_715",
  "title": "מאמר וארא אל אברהם תשל\"ה",
  "part": 8,
  "sections": [
    {
      "v": 21,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "\"א)"
        },
        {
          "s": 2,
          "text": "והנה גילוי הפנימיות דהנסים המלובשים בטבע"
        },
        {
          "s": 3,
          "text": "(שההתלבשות היא כי עי\"ז מתגלה אמיתית הבל\"ג,"
        },
        {
          "s": 4,
          "text": "כנ\"ל סעיף ט)"
        },
        {
          "s": 5,
          "text": "יהי' בעיקר לע\"ל."
        },
        {
          "s": 6,
          "text": "דעכשיו,"
        },
        {
          "s": 7,
          "text": "הגבול שנמשך משם שדי על שם שאמרתי לעולמי די והבל\"ג שנמשך משם הוי' הם שני ענינים הפכים."
        },
        {
          "s": 8,
          "text": "ולכן מקום לומר,"
        },
        {
          "s": 9,
          "text": "דזה שישנם נסים המלובשים בטבע הוא לפי שבנסים אלו נשאר עדיין הגבול"
        },
        {
          "s": 10,
          "text": "(שנמשך מזה שאמרתי לעולמי די)"
        },
        {
          "s": 11,
          "text": "שמעלים על הבל\"ג דהוי'."
        },
        {
          "s": 12,
          "text": "אבל לעתיד לבוא,"
        },
        {
          "s": 13,
          "text": "שאז הגבול לא יעלים על הבל\"ג,"
        },
        {
          "s": 14,
          "text": "יהי' נרגש בגילוי דהתלבשות הנסים בטבע היא כי עי\"ז מתגלה אמיתית הבל\"ג."
        },
        {
          "s": 15,
          "text": "וזהו לא ניכרתי להם במדת אמיתית שלי,"
        },
        {
          "s": 16,
          "text": "שהגילוי דשם הוי' עכשיו הוא מדת אמיתית,"
        },
        {
          "s": 17,
          "text": "מדה מלשון מדידה והגבלה,"
        },
        {
          "s": 18,
          "text": "שהבל\"ג דהוי' מוגבל בענין הבל\"ג,"
        },
        {
          "s": 19,
          "text": "והגילוי דהוי' שיהי' לע\"ל יהי' למעלה ממדה"
        },
        {
          "s": 20,
          "text": "(כנ\"ל סעיף א),"
        },
        {
          "s": 21,
          "text": "כי אז,"
        },
        {
          "s": 22,
          "text": "גם בהגבול יהי' גילוי הבל\"ג51,"
        },
        {
          "s": 23,
          "text": "וכמ\"ש52"
        },
        {
          "s": 24,
          "text": "ונגלה כבוד הוי' וראו כל בשר,"
        },
        {
          "s": 25,
          "text": "שגם הבשר הגשמי53"
        },
        {
          "s": 26,
          "text": "יראה הגילוי דכבוד הוי',"
        },
        {
          "s": 27,
          "text": "בביאת משיח צדקנו בקרוב ממש."
        }
      ]
    }
  ]
}