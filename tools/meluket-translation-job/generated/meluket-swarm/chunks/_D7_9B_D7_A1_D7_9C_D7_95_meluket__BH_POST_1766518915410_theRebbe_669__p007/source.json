{
  "globalIndex": 287,
  "owner": 37,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915410_theRebbe_669__p007",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915410_theRebbe_669__p007",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915410_theRebbe_669",
  "title": "מאמר פדה בשלום תשמ\"ו",
  "part": 7,
  "sections": [
    {
      "v": 18,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "שעד\"ז הוא גם בהענין דפדה בשלום נפשי,"
        },
        {
          "s": 2,
          "text": "שיש בו"
        },
        {
          "s": 3,
          "text": "(דוגמת)"
        },
        {
          "s": 4,
          "text": "ג' מדריגות אלה."
        },
        {
          "s": 5,
          "text": "והענין הוא,"
        },
        {
          "s": 6,
          "text": "דאמיתית הענין דפדה בשלום נפשי,"
        },
        {
          "s": 7,
          "text": "שהמנגד מתבטל לגמרי,"
        },
        {
          "s": 8,
          "text": "כמבואר לעיל"
        },
        {
          "s": 9,
          "text": "(סעיף ב)"
        },
        {
          "s": 10,
          "text": "מהמאמר דבעל הגאולה,"
        },
        {
          "s": 11,
          "text": "הוא ע\"י גילוי היחידה52."
        },
        {
          "s": 12,
          "text": "דבחינת חי',"
        },
        {
          "s": 13,
          "text": "כיון שיש כנגדה לעו\"ז53,"
        },
        {
          "s": 14,
          "text": "לכן הגילוי שלה אינו שולל ומבטל לגמרי הרצונות זרים דנפש הבהמית,"
        },
        {
          "s": 15,
          "text": "והוא רק שהרצון לאלקות"
        },
        {
          "s": 16,
          "text": "(דבחינת חי')"
        },
        {
          "s": 17,
          "text": "מתגבר על הרצונות דנה\"ב."
        },
        {
          "s": 18,
          "text": "ובכדי שיהי' ביטול הרצונות דנה\"ב הוא ע\"י גילוי היחידה."
        },
        {
          "s": 19,
          "text": "דכיון שבחינת היחידה אין כנגדה לעו\"ז53,"
        },
        {
          "s": 20,
          "text": "בבואה דבבואה לית להו54,"
        },
        {
          "s": 21,
          "text": "לכן ע\"י גילוי היחידה מתבטל הלעו\"ז ממילא."
        }
      ]
    },
    {
      "v": 19,
      "items": [
        {
          "s": 0,
          "text": "וזהו שאמיתית הענין דפדה בשלום נפשי יהי' בביאת המשיח דוקא,"
        },
        {
          "s": 1,
          "text": "כי כמו שבאדם,"
        },
        {
          "s": 2,
          "text": "ביטול הלעו\"ז שבו הוא ע\"י גילוי היחידה דוקא,"
        },
        {
          "s": 3,
          "text": "עד\"ז הוא בכללות העולם,"
        },
        {
          "s": 4,
          "text": "שדוקא ע\"י משיח,"
        },
        {
          "s": 5,
          "text": "שהוא היחידה דכללות ההשתלשלות55,"
        },
        {
          "s": 6,
          "text": "יהי' ביטול הסט\"א לגמרי."
        },
        {
          "s": 7,
          "text": "אלא שמ\"מ,"
        },
        {
          "s": 8,
          "text": "כיון שכל הגילויים דלע\"ל תלויים במעשינו ועבודתינו עכשיו56,"
        },
        {
          "s": 9,
          "text": "גם הענין דביטול הסט\"א ע\"י גילוי יחידה הכללית שיהי' לע\"ל,"
        },
        {
          "s": 10,
          "text": "הוא ע\"י שהאדם מגלה את היחידה שבו שעי\"ז מתבטלים הרצונות זרים דנפשו הבהמית."
        },
        {
          "s": 11,
          "text": "ובפרט,"
        },
        {
          "s": 12,
          "text": "כשע\"י גילוי היחידה שלו הוא פועל גם"
        },
        {
          "s": 13,
          "text": "(במדה)"
        },
        {
          "s": 14,
          "text": "ביטול הסט\"א שבזולתו."
        },
        {
          "s": 15,
          "text": "וכמו דוד המלך,"
        },
        {
          "s": 16,
          "text": "שע\"י עבודתו פעל שגם עמשי אמר לו שלום שלום לך ושלום לעוזריך57,"
        },
        {
          "s": 17,
          "text": "ושגם אנשי אבשלום התפללו לנצחונו של דוד58."
        }
      ]
    },
    {
      "v": 20,
      "items": [
        {
          "s": 0,
          "text": "והנה כיון שעכשיו כל הענינים הם בהגבלה,"
        },
        {
          "s": 1,
          "text": "לכן,"
        },
        {
          "s": 2,
          "text": "גם ענין המס\"נ שמצד גילוי היחידה59"
        },
        {
          "s": 3,
          "text": "הוא בנוגע לענין מוגבל."
        },
        {
          "s": 4,
          "text": "[וע\"ד שנתבאר לעיל"
        },
        {
          "s": 5,
          "text": "(סעיף ז)"
        },
        {
          "s": 6,
          "text": "בענין גילוי כח הא\"ס שבהולדה,"
        },
        {
          "s": 7,
          "text": "שהגילוי דא\"ס הוא בענין מוגבל]."
        },
        {
          "s": 8,
          "text": "ומזה מובן,"
        },
        {
          "s": 9,
          "text": "דהגם שגילוי היחידה הכללית דלע\"ל הוא ע\"י גילוי היחידה עכשיו,"
        },
        {
          "s": 10,
          "text": "מ\"מ,"
        },
        {
          "s": 11,
          "text": "גילוי היחידה עכשיו לגבי גילוי היחידה הכללית דלע\"ל הוא באין ערוך."
        },
        {
          "s": 12,
          "text": "ועד\"ז הוא בנוגע לפדה בשלום נפשי שהי' אצל דוד,"
        },
        {
          "s": 13,
          "text": "דכיון שהפדי' בשלום שלו היתה רק בנוגע לכמה אנשים"
        },
        {
          "s": 14,
          "text": "(עמשי,"
        },
        {
          "s": 15,
          "text": "אנשי אבשלום וכו')"
        },
        {
          "s": 16,
          "text": "ולא בכללות העולם"
        },
        {
          "s": 17,
          "text": "(דבכללות העולם היו מנגדים),"
        },
        {
          "s": 18,
          "text": "לכן,"
        },
        {
          "s": 19,
          "text": "הוא באין ערוך כלל לגבי הפדי' בשלום דלע\"ל,"
        },
        {
          "s": 20,
          "text": "שלא יהיו בה הגבלות."
        },
        {
          "s": 21,
          "text": "והמשכת הפדי' בשלום דלע\"ל"
        },
        {
          "s": 22,
          "text": "(בלי גבול)"
        },
        {
          "s": 23,
          "text": "ע\"י הפדי' בשלום דדוד"
        },
        {
          "s": 24,
          "text": "(שהיא בנוגע לענינים מוגבלים)"
        },
        {
          "s": 25,
          "text": "הוא ע\"ד המשכת ענין ההילוך והבלי גבול ע\"י קיום התומ\"צ בעוה\"ז באלו העוסקים רק בנגלה דתורה."
        },
        {
          "s": 26,
          "text": "והענין דפדה בשלום נפשי שבהגאולה דיו\"ד כסלו"
        },
        {
          "s": 27,
          "text": "[ועד\"ז בהגאולה די\"ט כסלו ודי\"ב תמוז],"
        },
        {
          "s": 28,
          "text": "כיון שהגאולה היא בנוגע לפנימיות התורה,"
        },
        {
          "s": 29,
          "text": "היחידה דתורה60,"
        },
        {
          "s": 30,
          "text": "לכן,"
        },
        {
          "s": 31,
          "text": "הענין דפדה בשלום נפשי שבגאולה זו,"
        },
        {
          "s": 32,
          "text": "אין בו מדידות והגבלות,"
        },
        {
          "s": 33,
          "text": "והוא בנוגע לכל הענינים."
        }
      ]
    }
  ]
}