{
  "globalIndex": 798,
  "owner": 48,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918549_theRebbe_741__p004",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918549_theRebbe_741__p004",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918549_theRebbe_741",
  "title": "מאמר לה\"ע רשב\"י תשמ\"ה",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וע\"פ כל הנ\"ל יובן גם זה שהשבחים שהיו משבחים את רשב\"י"
        },
        {
          "s": 2,
          "text": "(שמביא בהמאמר)"
        },
        {
          "s": 3,
          "text": "בכדי לעורר את ההשפעה הם ר\"י קארי לי' שבת ומאן פני האדון הוי' דא רשב\"י,"
        },
        {
          "s": 4,
          "text": "כי בשבחים אלו מרומז המשכת העליון"
        },
        {
          "s": 5,
          "text": "(שמובדל בערך)"
        },
        {
          "s": 6,
          "text": "למטה,"
        },
        {
          "s": 7,
          "text": "ויתירה מזו שההמשכה היא ע\"י עבודת התחתון."
        },
        {
          "s": 8,
          "text": "דהנה70"
        },
        {
          "s": 9,
          "text": "בשבת כתיב71"
        },
        {
          "s": 10,
          "text": "כי קודש היא,"
        },
        {
          "s": 11,
          "text": "קודש מלה בגרמי'72,"
        },
        {
          "s": 12,
          "text": "היינו ששבת הוא מובדל ושלא בערך לששת ימי המעשה,"
        },
        {
          "s": 13,
          "text": "ואעפ\"כ נמשך מקדושת השבת בימים שלפניו ושלאחריו,"
        },
        {
          "s": 14,
          "text": "דמיום ד' ואילך הוא קמי שבתא ועד יום ד' הוא בתר שבתא73,"
        },
        {
          "s": 15,
          "text": "נוסף לזה ששבת מיני' מתברכין כולהו יומין74."
        },
        {
          "s": 16,
          "text": "ועד\"ז הוא בנוגע להאדם,"
        },
        {
          "s": 17,
          "text": "דעם היות ששבת היא מקדשא וקיימא75,"
        },
        {
          "s": 18,
          "text": "דמכיון שקדושת השבת היא קדושה נעלית ביותר,"
        },
        {
          "s": 19,
          "text": "קודש מלה בגרמי'"
        },
        {
          "s": 20,
          "text": "(כנ\"ל),"
        },
        {
          "s": 21,
          "text": "אין שייך בה תפיסת ידי אדם,"
        },
        {
          "s": 22,
          "text": "אעפ\"כ ניתן כח לישראל להוסיף בקדושת השבת76,"
        },
        {
          "s": 23,
          "text": "זכור את יום השבת לקדשו77,"
        },
        {
          "s": 24,
          "text": "ועד שישראל מוסיפים גם בהתענוג דשבת,"
        },
        {
          "s": 25,
          "text": "כלשון רז\"ל78"
        },
        {
          "s": 26,
          "text": "כל המענג את השבת."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ועד\"ז הוא גם בענין מאן פני האדון הוי',"
        },
        {
          "s": 1,
          "text": "דהוי' הוא שם העצם שם המפורש ושם המיוחד79,"
        },
        {
          "s": 2,
          "text": "משא\"כ זה שהוא ית' נקרא בשם אדון הוא כמרז\"ל80"
        },
        {
          "s": 3,
          "text": "לך נאה לקרות אדנ' שאתה אדון לכל בריותיך,"
        },
        {
          "s": 4,
          "text": "דנוסף לזה ששם אד' הוא בספירת המלכות81,"
        },
        {
          "s": 5,
          "text": "ובמלכות גופא – כמו שיורדת בבריאה82,"
        },
        {
          "s": 6,
          "text": "להוות את העולמות ולהיות אדון עליהם,"
        },
        {
          "s": 7,
          "text": "הנה מלשון רז\"ל שאתה אדון לכל בריותיך"
        },
        {
          "s": 8,
          "text": "(בריותיך דוקא)"
        },
        {
          "s": 9,
          "text": "משמע שהשם אד'83"
        },
        {
          "s": 10,
          "text": "הוא על נבראים אלו שהם בריות בעלמא84"
        },
        {
          "s": 11,
          "text": "[ובדוגמת אדון בפשטות,"
        },
        {
          "s": 12,
          "text": "שהתואר אדון הוא על עבדים דוקא]."
        },
        {
          "s": 13,
          "text": "וענין פני האדון הוי' הוא ההתאחדות דהוי'"
        },
        {
          "s": 14,
          "text": "(שם העצם)"
        },
        {
          "s": 15,
          "text": "עם בחי' אד'"
        },
        {
          "s": 16,
          "text": "(אדון לכל בריותיך)."
        },
        {
          "s": 17,
          "text": "וזהו גם מה שבמצות ראי' כתיב85"
        },
        {
          "s": 18,
          "text": "יראה כל זכורך את פני האדון הוי'."
        },
        {
          "s": 19,
          "text": "דהנה ארז\"ל86"
        },
        {
          "s": 20,
          "text": "כשם שבא ליראות כך בא לראות,"
        },
        {
          "s": 21,
          "text": "דנוסף לזה שבעת העלי' לרגל היו רואים אלקות במוחש"
        },
        {
          "s": 22,
          "text": "(דראי' הוא למעלה מהשגה)"
        },
        {
          "s": 23,
          "text": "והראי' היתה גם בבחינת הפנימיות דאלקות כמ\"ש יראה גו' את פני גו',"
        },
        {
          "s": 24,
          "text": "הנה יתירה מזו,"
        },
        {
          "s": 25,
          "text": "שראיית האדם באלקות"
        },
        {
          "s": 26,
          "text": "(מלמטה למעלה)"
        },
        {
          "s": 27,
          "text": "היתה באותו האופן כמו הראי' דלמעלה,"
        },
        {
          "s": 28,
          "text": "כשם שבא ליראות כך בא לראות,"
        },
        {
          "s": 29,
          "text": "ישר יחזו פנימו87,"
        },
        {
          "s": 30,
          "text": "שהראי' שלמטה והראי' שלמעלה הם ישר,"
        },
        {
          "s": 31,
          "text": "בהשוואה88."
        },
        {
          "s": 32,
          "text": "ולכן נאמר בזה יראה גו' את פני האדון הוי',"
        },
        {
          "s": 33,
          "text": "כי בכדי שתהי' ההתאחדות דהראי' שלמטה עם הראי' שלמעלה,"
        },
        {
          "s": 34,
          "text": "הוא ע\"י המשכת בחינת האדון הוי',"
        },
        {
          "s": 35,
          "text": "התאחדות דאדון עם הוי'."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ויש להוסיף,"
        },
        {
          "s": 1,
          "text": "דבמצות ראי' נכלל גם הבאת קרבן"
        },
        {
          "s": 2,
          "text": "(עולת ראי')"
        },
        {
          "s": 3,
          "text": "כמ\"ש89"
        },
        {
          "s": 4,
          "text": "ולא יראו פני ריקם."
        },
        {
          "s": 5,
          "text": "שבזה נראה גודל העילוי דעבודת הבירורים,"
        },
        {
          "s": 6,
          "text": "שע\"י הבאת קרבן גשמי"
        },
        {
          "s": 7,
          "text": "[ועד שלדיעה אחת90"
        },
        {
          "s": 8,
          "text": "צ\"ל הקרבן לא מן העוף אלא מן הבהמה91],"
        },
        {
          "s": 9,
          "text": "עי\"ז דוקא יראו פני,"
        },
        {
          "s": 10,
          "text": "גילוי הפנימיות דאלקות ובאופן דראי',"
        },
        {
          "s": 11,
          "text": "ועד לבחינת ישר יחזו פנימו."
        }
      ]
    }
  ]
}