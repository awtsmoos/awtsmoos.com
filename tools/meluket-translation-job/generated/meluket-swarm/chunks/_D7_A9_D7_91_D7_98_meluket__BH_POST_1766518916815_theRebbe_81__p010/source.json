{
  "globalIndex": 527,
  "owner": 27,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916815_theRebbe_81__p010",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916815_theRebbe_81__p010",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916815_theRebbe_81",
  "title": "מאמר באתי לגני תש\"ל",
  "part": 10,
  "sections": [
    {
      "v": 27,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ז)"
        },
        {
          "s": 2,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 3,
          "text": "שהעצה ליפטר מהמחשבות שנופלים לו בשעת התורה והתפלה הוא לעורר מדת הנצח שבנפשו."
        },
        {
          "s": 4,
          "text": "דלהיות שמדת הנצחון הוא נטוע בעצם הנפש שלמעלה מכחות הגלויים,"
        },
        {
          "s": 5,
          "text": "לכן,"
        },
        {
          "s": 6,
          "text": "ע\"י מדת הנצח יכול להתגבר ולדחות כל הטרדות והבלבולים."
        },
        {
          "s": 7,
          "text": "ולכאורה הי' אפשר לומר,"
        },
        {
          "s": 8,
          "text": "דזה שאומר בהמאמר שהעצה היא לעורר את מדת הנצח דוקא,"
        },
        {
          "s": 9,
          "text": "הוא,"
        },
        {
          "s": 10,
          "text": "כי העצה שמובאת לעיל"
        },
        {
          "s": 11,
          "text": "(סעיף טז)"
        },
        {
          "s": 12,
          "text": "מקונטרס התפלה היא רק בנוגע למחשבות זרות שנופלים בשעת התפלה מצד הטרדות שלו,"
        },
        {
          "s": 13,
          "text": "אבל כשהמחשבות נופלים לו דוקא בשעת התפלה,"
        },
        {
          "s": 14,
          "text": "בכדי לבלבלו"
        },
        {
          "s": 15,
          "text": "(דבהמאמר מדבר בענין מחשבות אלו),"
        },
        {
          "s": 16,
          "text": "העצה היא לעורר את מדת הנצח."
        },
        {
          "s": 17,
          "text": "וצריך להבין,"
        },
        {
          "s": 18,
          "text": "דלכאורה,"
        },
        {
          "s": 19,
          "text": "גם בנוגע למחשבות אלו,"
        },
        {
          "s": 20,
          "text": "אפשר ליפטר מהם ע\"י שיתבונן דזה שהם נופלים לו בשעת העבודה דוקא הוא כי כל ענינם הוא לבלבלו מתורה ועבודה."
        },
        {
          "s": 21,
          "text": "ובהמאמר אומר שהעצה ליפטר ממחשבות אלו היא לא ע\"י התבוננות אלא דוקא בדרך נצחון."
        }
      ]
    },
    {
      "v": 28,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ח)"
        },
        {
          "s": 2,
          "text": "והנה מבואר בתניא117,"
        },
        {
          "s": 3,
          "text": "שהמחשבות זרות שנופלים לאדם בעת התפלה בכדי לבלבלו הוא כמשל אדם המתפלל בכוונה ועומד לנגדו ערל118"
        },
        {
          "s": 4,
          "text": "רשע ומשיח ומדבר עמו כדי לבלבלו."
        },
        {
          "s": 5,
          "text": "וידועה תורת הבעש\"ט119,"
        },
        {
          "s": 6,
          "text": "דכשאדם אחר"
        },
        {
          "s": 7,
          "text": "(ומכ\"ש נכרי או קטן120)"
        },
        {
          "s": 8,
          "text": "מדבר ומבלבלו בתפלתו,"
        },
        {
          "s": 9,
          "text": "צריך להתבונן דכיון שהכל הוא בהשגחה פרטית,"
        },
        {
          "s": 10,
          "text": "הרי מובן,"
        },
        {
          "s": 11,
          "text": "שזהו ירידת השכינה כביכול שירדה פלאים להתלבש ניצוץ מהארתה בפיו של אדם זה המבלבל,"
        },
        {
          "s": 12,
          "text": "וזה שירדה השכינה למטה כ\"כ הוא בכדי שאחזק עצמי בעבודת התפלה."
        },
        {
          "s": 13,
          "text": "וע\"י התבוננות זו הוא מתעורר להתפלל יותר בכוונה מעומקא דלבא עד שלא ישמע דיבורו של המבלבל."
        }
      ]
    },
    {
      "v": 29,
      "items": [
        {
          "s": 0,
          "text": "ויש לקשר זה עם תורת הרב המגיד121"
        },
        {
          "s": 1,
          "text": "בתחלת פרשתנו"
        },
        {
          "s": 2,
          "text": "(פ' בא)"
        },
        {
          "s": 3,
          "text": "עה\"פ122"
        },
        {
          "s": 4,
          "text": "למען שתי אותותי אלה בקרבו,"
        },
        {
          "s": 5,
          "text": "דזה שהקב\"ה הכביד את לב פרעה והביא עליו עוד ג' מכות הוא בכדי לברר את הניצוצות שהיו במצרים שלא נתבררו מקודם."
        },
        {
          "s": 6,
          "text": "וזהו למען שתי אותותי,"
        },
        {
          "s": 7,
          "text": "אותותי מלשון אותיות,"
        },
        {
          "s": 8,
          "text": "שהניצוצות שנפלו בהקליפות הוא מהאותיות שנשברו"
        },
        {
          "s": 9,
          "text": "[וכידוע בענין שבה\"כ דתהו123,"
        },
        {
          "s": 10,
          "text": "דשבירת הכלים הוא שבירת האותיות,"
        },
        {
          "s": 11,
          "text": "וזה גרם שאח\"כ נפלו ניצוצות מהם לתוך הקליפות]."
        },
        {
          "s": 12,
          "text": "ועיקר הבירור שלהם הוא על ידי שמכניסים אותם"
        },
        {
          "s": 13,
          "text": "(לאחרי שמשנים את הצירוף)"
        },
        {
          "s": 14,
          "text": "בתורה."
        },
        {
          "s": 15,
          "text": "והבירור דהאותיות שנשברו ונפלו בהקליפות במצרים שלא נתבררו מקודם הוא ע\"י שהקב\"ה הכניסם בהסיפורים דתחלת הפרשה."
        },
        {
          "s": 16,
          "text": "וזהו למען שתי אותותי גו',"
        },
        {
          "s": 17,
          "text": "דזה שהקב\"ה הכביד את לב פרעה הוא למען שתי אותותי,"
        },
        {
          "s": 18,
          "text": "בכדי לברר אותיות אלו שנפלו בהשבירה ע\"י שהכניסם בסיפורים שבתורה."
        },
        {
          "s": 19,
          "text": "[אלא שאעפ\"כ,"
        },
        {
          "s": 20,
          "text": "מכיון שנשארו עדיין במצרים ניצוצות שלא נתבררו הי' הציווי124"
        },
        {
          "s": 21,
          "text": "וישאלו איש מאת רעהו גו' כלי כסף וכלי זהב,"
        },
        {
          "s": 22,
          "text": "בכדי לברר כל הניצוצות שהיו במצרים]."
        }
      ]
    }
  ]
}