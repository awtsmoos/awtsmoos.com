{
  "globalIndex": 899,
  "owner": 49,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919126_theRebbe_561__p004",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919126_theRebbe_561__p004",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919126_theRebbe_561",
  "title": "מאמר יהי ה' אלוקינו עמנו תשכ\"ד",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה לשון עם שייך כשיש דמיון בין שני הדברים."
        },
        {
          "s": 2,
          "text": "כדרשת רז\"ל20"
        },
        {
          "s": 3,
          "text": "עה\"פ21"
        },
        {
          "s": 4,
          "text": "והתייצבו שם עמך,"
        },
        {
          "s": 5,
          "text": "עמך בדומין לך."
        },
        {
          "s": 6,
          "text": "דהגם שלשון עם מורה על דבר טפל"
        },
        {
          "s": 7,
          "text": "(כנ\"ל סעיף ב),"
        },
        {
          "s": 8,
          "text": "מ\"מ,"
        },
        {
          "s": 9,
          "text": "יש לו דמיון להעיקר."
        },
        {
          "s": 10,
          "text": "ועד\"ז הוא בלשון את,"
        },
        {
          "s": 11,
          "text": "שמורה על דבר טפל כדרשת רז\"ל22"
        },
        {
          "s": 12,
          "text": "עה\"פ23"
        },
        {
          "s": 13,
          "text": "את בשרו את הטפל לבשרו,"
        },
        {
          "s": 14,
          "text": "ומ\"מ הוא בדומה להעיקר,"
        },
        {
          "s": 15,
          "text": "כדרשת רז\"ל20"
        },
        {
          "s": 16,
          "text": "עה\"פ24"
        },
        {
          "s": 17,
          "text": "ונשאו אתך,"
        },
        {
          "s": 18,
          "text": "אתך בדומין לך."
        },
        {
          "s": 19,
          "text": "ומבואר בספרי דקדוק25,"
        },
        {
          "s": 20,
          "text": "דהטפל המרומז בלשון את הוא טפל יותר מהטפל שבלשון עם26."
        },
        {
          "s": 21,
          "text": "ועפ\"ז,"
        },
        {
          "s": 22,
          "text": "בלשון את עיקר ההדגשה הוא שהדבר"
        },
        {
          "s": 23,
          "text": "(שאומרים עליו את)"
        },
        {
          "s": 24,
          "text": "הוא רק טפל,"
        },
        {
          "s": 25,
          "text": "ובלשון עם עיקר ההדגשה הוא על הדמיון דשני הדברים."
        },
        {
          "s": 26,
          "text": "ומזה מובן,"
        },
        {
          "s": 27,
          "text": "שעיקר ההדגשה ביהי הוי' אלקינו עמנו הוא לא שהוי' אלקינו הוא טפל כביכול להאדם,"
        },
        {
          "s": 28,
          "text": "אלא הדמיון כביכול שביניהם."
        },
        {
          "s": 29,
          "text": "ויש לומר,"
        },
        {
          "s": 30,
          "text": "שהדמיון שביניהם הוא בהענין דעיקר וטפל."
        },
        {
          "s": 31,
          "text": "דכמו שהשלימות דעבודת האדם היא כשהעבודה שלו היא בכח עצמו27,"
        },
        {
          "s": 32,
          "text": "שלכן הוי' אלקינו הוא טפל כביכול להאדם"
        },
        {
          "s": 33,
          "text": "(כנ\"ל סעיף ב),"
        },
        {
          "s": 34,
          "text": "עד\"ז הוא לאידך,"
        },
        {
          "s": 35,
          "text": "שהשלימות דעבודת האדם היא כשעבודתו"
        },
        {
          "s": 36,
          "text": "[גם העבודה בכח עצמו,"
        },
        {
          "s": 37,
          "text": "וגם העבודה דמס\"נ,"
        },
        {
          "s": 38,
          "text": "כולל גם המס\"נ על ענינים שע\"פ דין אין מחוייב למסור נפשו עליהם]"
        },
        {
          "s": 39,
          "text": "היא לא מפני שהוא רוצה לעבוד את ה' אלא מפני שהוא בטל לאלקות."
        },
        {
          "s": 40,
          "text": "דכיון שביטולו להקב\"ה הוא ביטול בתכלית,"
        },
        {
          "s": 41,
          "text": "לכן,"
        },
        {
          "s": 42,
          "text": "כל מצוה ומצוה"
        },
        {
          "s": 43,
          "text": "(גם כשע\"פ דין אין מחוייב למסור נפשו על זה)"
        },
        {
          "s": 44,
          "text": "היא אצלו באופן שאין שייך כלל שלא לקיימה,"
        },
        {
          "s": 45,
          "text": "אפילו כשקיומה הוא ע\"י מס\"נ."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ויש להוסיף,"
        },
        {
          "s": 1,
          "text": "דע\"י הביטול לאלקות,"
        },
        {
          "s": 2,
          "text": "מיתוסף גם בהמס\"נ28."
        },
        {
          "s": 3,
          "text": "דכאשר המס\"נ שלו היא מפני שהוא רוצה והחליט לקיים ציווי הקב\"ה גם כשצריך לזה מס\"נ,"
        },
        {
          "s": 4,
          "text": "הרי יש אצלו נתינת מקום שאפשר להיות גם באופן אחר,"
        },
        {
          "s": 5,
          "text": "וזה שבפועל הוא עומד במס\"נ הוא רק מפני שהחליט כן."
        },
        {
          "s": 6,
          "text": "משא\"כ כשהמס\"נ שלו היא מפני ביטולו להקב\"ה,"
        },
        {
          "s": 7,
          "text": "שלכן כל מצוה שצוה הקב\"ה היא אצלו באופן שאין שייך כלל שלא לקיימה,"
        },
        {
          "s": 8,
          "text": "הרי אז אין נתינת מקום כלל שיהי' באופן אחר."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "וזהו יהי הוי' אלקינו עמנו כאשר הי' עם אבותינו,"
        },
        {
          "s": 2,
          "text": "דבעבודת האבות מודגשים שני ענינים הנ\"ל."
        },
        {
          "s": 3,
          "text": "שקיימו כל התורה עד שלא ניתנה29,"
        },
        {
          "s": 4,
          "text": "דבזה מודגש שעבודתם היתה"
        },
        {
          "s": 5,
          "text": "(לא מפני הציווי מלמעלה,"
        },
        {
          "s": 6,
          "text": "אלא)"
        },
        {
          "s": 7,
          "text": "בכח עצמם."
        },
        {
          "s": 8,
          "text": "ואעפ\"כ היו בתכלית הביטול,"
        },
        {
          "s": 9,
          "text": "דהאבות הן הן המרכבה30."
        },
        {
          "s": 10,
          "text": "וביטול המרכבה להרוכב הוא ביטול בתכלית."
        },
        {
          "s": 11,
          "text": "דביטול המרכבה להרוכב הוא לא מצד הרצון דהמרכבה"
        },
        {
          "s": 12,
          "text": "(שרוצה להיות בטילה להרוכב ומרכבה אליו),"
        },
        {
          "s": 13,
          "text": "אלא מצד הרוכב."
        },
        {
          "s": 14,
          "text": "וכיון שבביטול יש כו\"כ דרגות,"
        },
        {
          "s": 15,
          "text": "לכן,"
        },
        {
          "s": 16,
          "text": "מבקשים יהי הוי' אלקינו עמנו כאשר הי' עם אבותינו,"
        },
        {
          "s": 17,
          "text": "שהענין דיהי הוי' אלקינו עמנו,"
        },
        {
          "s": 18,
          "text": "הביטול שלנו לאלקות,"
        },
        {
          "s": 19,
          "text": "יהי' כאשר הי' עם אבותינו,"
        },
        {
          "s": 20,
          "text": "ביטול דמרכבה."
        }
      ]
    }
  ]
}