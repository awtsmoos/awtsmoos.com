{
  "globalIndex": 1018,
  "owner": 18,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919814_theRebbe_260__p003",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919814_theRebbe_260__p003",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919814_theRebbe_260",
  "title": "מאמר לא היו ימים טובים לישראל תשל\"ה",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ומבאר בהמאמר,"
        },
        {
          "s": 1,
          "text": "דאז,"
        },
        {
          "s": 2,
          "text": "כשמאיר במלכות הכתר שלמעלה מהשתלשלות,"
        },
        {
          "s": 3,
          "text": "קיימא סיהרא באשלמותא,"
        },
        {
          "s": 4,
          "text": "שמאיר האור גם בחיצוניות המלכות"
        },
        {
          "s": 5,
          "text": "(דיבור דמלכות,"
        },
        {
          "s": 6,
          "text": "עשרה מאמרות שבהם נברא העולם),"
        },
        {
          "s": 7,
          "text": "ועי\"ז,"
        },
        {
          "s": 8,
          "text": "גם בעולם."
        },
        {
          "s": 9,
          "text": "דבההמשכה שע\"פ סדר השתלשלות,"
        },
        {
          "s": 10,
          "text": "יש חילוק בין פנימיות המלכות"
        },
        {
          "s": 11,
          "text": "(שדה)"
        },
        {
          "s": 12,
          "text": "וחיצוניות המלכות"
        },
        {
          "s": 13,
          "text": "(ארץ),"
        },
        {
          "s": 14,
          "text": "ולכן,"
        },
        {
          "s": 15,
          "text": "כשההמשכה במלכות היא מבחינת המוחין,"
        },
        {
          "s": 16,
          "text": "הגילוי הוא רק בהדרגא דמלכות שמקבלת מז\"א"
        },
        {
          "s": 17,
          "text": "(פנימיות המלכות),"
        },
        {
          "s": 18,
          "text": "ובהדרגא דמלכות שהיא שרש הנבראים"
        },
        {
          "s": 19,
          "text": "(עשרה מאמרות)"
        },
        {
          "s": 20,
          "text": "אין האור מאיר."
        },
        {
          "s": 21,
          "text": "בדוגמת29"
        },
        {
          "s": 22,
          "text": "הלבנה בזמן פגימתה,"
        },
        {
          "s": 23,
          "text": "שאור השמש מאיר רק בחצי כדור העליון שבה."
        },
        {
          "s": 24,
          "text": "וכשההמשכה היא מהכתר שלמעלה מהשתלשלות,"
        },
        {
          "s": 25,
          "text": "הגילוי הוא גם בהעשרה מאמרות"
        },
        {
          "s": 26,
          "text": "(ועל ידם גם בהעולם),"
        },
        {
          "s": 27,
          "text": "בדוגמת29"
        },
        {
          "s": 28,
          "text": "הלבנה בזמן המילוי"
        },
        {
          "s": 29,
          "text": "(באמצע החודש),"
        },
        {
          "s": 30,
          "text": "שאור השמש מאיר גם בחצי כדור התחתון שבה."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וצריך להבין,"
        },
        {
          "s": 2,
          "text": "דלכאורה ענין מיעוט הירח הוא שבכדי שיהי' התהוות העולמות נעשה מיעוט וחסרון בהמלכות"
        },
        {
          "s": 3,
          "text": "(את עשית את השמים גו'30,"
        },
        {
          "s": 4,
          "text": "את חסר ה'31),"
        },
        {
          "s": 5,
          "text": "שאין מאיר בה האור דאצילות שלמעלה משרש הנבראים,"
        },
        {
          "s": 6,
          "text": "וכיון שבג\"ע מאיר בחי' כל,"
        },
        {
          "s": 7,
          "text": "היסוד וגם המוחין,"
        },
        {
          "s": 8,
          "text": "הרי אין בו חסרון."
        },
        {
          "s": 9,
          "text": "וכמבואר בהמאמר32,"
        },
        {
          "s": 10,
          "text": "דהטעם שג\"ע נקרא בשם כל,"
        },
        {
          "s": 11,
          "text": "הוא,"
        },
        {
          "s": 12,
          "text": "כי יש בו הכל בלי חסרון."
        },
        {
          "s": 13,
          "text": "ועפ\"ז נמצא,"
        },
        {
          "s": 14,
          "text": "שגם בג\"ע הלבנה"
        },
        {
          "s": 15,
          "text": "(מלכות)"
        },
        {
          "s": 16,
          "text": "היא בשלימות."
        },
        {
          "s": 17,
          "text": "ובהמאמר אומר שהענין דקיימא סיהרא באשלמותא הוא דוקא כשמלך לשדה נעבד,"
        },
        {
          "s": 18,
          "text": "שע\"י העבודה נמשך בו הכתר"
        },
        {
          "s": 19,
          "text": "(מלך עילאה)"
        },
        {
          "s": 20,
          "text": "שלמעלה מהשתלשלות."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 1,
          "text": "דאמיתית הענין דקיימא סיהרא באשלמותא הוא שהשלימות היא באופן שאין שייך שיהי' חסרון."
        },
        {
          "s": 2,
          "text": "ושלימות זו היא דוקא כשההמשכה היא מאור שלמעלה משייכות לעולמות,"
        },
        {
          "s": 3,
          "text": "שאין שייך שיהי' בו צמצום."
        },
        {
          "s": 4,
          "text": "דאור השייך לעולמות,"
        },
        {
          "s": 5,
          "text": "גם האור שקודם הצמצום,"
        },
        {
          "s": 6,
          "text": "הוא אור כזה ששייך בו צמצום."
        },
        {
          "s": 7,
          "text": "ולכן,"
        },
        {
          "s": 8,
          "text": "ההמשכה דבחי' כל שבג\"ע,"
        },
        {
          "s": 9,
          "text": "אף שההמשכה היא בשלימות"
        },
        {
          "s": 10,
          "text": "[וכנ\"ל מהמאמר דפירוש כל הוא הכל בלי חסרון],"
        },
        {
          "s": 11,
          "text": "כיון שההמשכה היא מאור מוגבל"
        },
        {
          "s": 12,
          "text": "(מוחין)"
        },
        {
          "s": 13,
          "text": "ששייך שיהי' בו צמצום והפסק,"
        },
        {
          "s": 14,
          "text": "אינו אמיתית השלימות33."
        },
        {
          "s": 15,
          "text": "ואמיתית הענין דקיימא סיהרא באשלמותא הוא ע\"י העבודה דתומ\"צ,"
        },
        {
          "s": 16,
          "text": "שעי\"ז נמשך אור הבל\"ג"
        },
        {
          "s": 17,
          "text": "(שלמעלה מהאור ששייך לעולמות)"
        },
        {
          "s": 18,
          "text": "שאין שייך בו צמצום,"
        },
        {
          "s": 19,
          "text": "מלך לשדה נעבד."
        }
      ]
    }
  ]
}