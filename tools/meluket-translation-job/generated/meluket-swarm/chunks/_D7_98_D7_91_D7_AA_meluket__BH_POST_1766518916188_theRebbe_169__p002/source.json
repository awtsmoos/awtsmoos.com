{
  "globalIndex": 426,
  "owner": 26,
  "jobId": "_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916188_theRebbe_169__p002",
  "batchId": "meluket-_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916188_theRebbe_169__p002",
  "seriesId": "טבת_meluket",
  "postId": "BH_POST_1766518916188_theRebbe_169",
  "title": "מאמר ויגש אליו יהודה תשל\"ו",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "והנה ידוע,"
        },
        {
          "s": 1,
          "text": "שבכדי לעורר העלאת מ\"ן דב\"ן,"
        },
        {
          "s": 2,
          "text": "זה גופא הוא ע\"י המשכה משם מ\"ה."
        },
        {
          "s": 3,
          "text": "וזהו מ\"ש בזהר דהגשת יהודה ליוסף הו\"ע סמיכת גאולה לתפלה,"
        },
        {
          "s": 4,
          "text": "דהגשת יהודה ליוסף הוא העלאת מ\"ן דהשבטים"
        },
        {
          "s": 5,
          "text": "[יהודה הוא עיקר השבטים10]"
        },
        {
          "s": 6,
          "text": "ליוסף,"
        },
        {
          "s": 7,
          "text": "לעורר המשכת מ\"ד משם מ\"ה שיהי' הבירור שני מלמעלמ\"ט."
        },
        {
          "s": 8,
          "text": "[וזהו שארז\"ל11"
        },
        {
          "s": 9,
          "text": "עה\"פ ויגש אליו יהודה אין ויגש אלא לשלום,"
        },
        {
          "s": 10,
          "text": "כי מעלת הבירור שבדרך מלמעלמ\"ט"
        },
        {
          "s": 11,
          "text": "(הבירור דיוסף)"
        },
        {
          "s": 12,
          "text": "היא שהוא בדרך שלום12."
        },
        {
          "s": 13,
          "text": "וכידוע13"
        },
        {
          "s": 14,
          "text": "החילוק בין הבירור דתפלה להבירור דתורה,"
        },
        {
          "s": 15,
          "text": "שהבירור דתפלה שהוא מלמטלמ\"ע הוא בדרך מלחמה,"
        },
        {
          "s": 16,
          "text": "והבירור דתורה שהוא מלמעלמ\"ט הוא בדרך מנוחה ושלום."
        },
        {
          "s": 17,
          "text": "ובתורה גופא,"
        },
        {
          "s": 18,
          "text": "החילוק בין הבירור שע\"י גליא דתורה להבירור שע\"י פנימיות התורה14]."
        },
        {
          "s": 19,
          "text": "והנתינת כח על העלאת המ\"ן דמלכות לז\"א,"
        },
        {
          "s": 20,
          "text": "הגשת יהודה ליוסף,"
        },
        {
          "s": 21,
          "text": "הוא ע\"י ההמשכה מז\"א למלכות,"
        },
        {
          "s": 22,
          "text": "סמיכת גאולה לתפלה15."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "והלשון סמיכת גאולה לתפלה שמורה"
        },
        {
          "s": 1,
          "text": "(כנ\"ל)"
        },
        {
          "s": 2,
          "text": "שתפלה היא העיקר,"
        },
        {
          "s": 3,
          "text": "הוא16"
        },
        {
          "s": 4,
          "text": "כי עיקר הכוונה דדירה בתחתונים הוא בהבירור שבדרך מלמטה למעלה,"
        },
        {
          "s": 5,
          "text": "בירור דב\"ן."
        },
        {
          "s": 6,
          "text": "דהבירור בדרך מלמעלמ\"ט,"
        },
        {
          "s": 7,
          "text": "בירור דמ\"ה,"
        },
        {
          "s": 8,
          "text": "כיון שהבירור הוא מצד הגילוי אור"
        },
        {
          "s": 9,
          "text": "(ולא מצד התחתון גופא),"
        },
        {
          "s": 10,
          "text": "אין זה שייך כ\"כ להתחתון עצמו,"
        },
        {
          "s": 11,
          "text": "והכוונה דדירה בתחתונים נשלמת דוקא ע\"י הבירור בדרך מלמטלמ\"ע,"
        },
        {
          "s": 12,
          "text": "שהתחתון נעשה כלי לאלקות17."
        },
        {
          "s": 13,
          "text": "ולכן לע\"ל יהי' יהודה למעלה מיוסף,"
        },
        {
          "s": 14,
          "text": "כמ\"ש בההפטורה דפרשת ויגש18"
        },
        {
          "s": 15,
          "text": "ועבדי דוד מלך עליהם גו' ודוד עבדי נשיא להם לעולם19."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "וצריך להבין,"
        },
        {
          "s": 2,
          "text": "הרי זה שהבירור דב\"ן הוא למעלה ממ\"ה יהי' לע\"ל,"
        },
        {
          "s": 3,
          "text": "ועכשיו מ\"ה הוא למעלה מב\"ן,"
        },
        {
          "s": 4,
          "text": "וענין סמיכת גאולה לתפלה הוא שעכשיו תפלה היא למעלה מגאולה."
        },
        {
          "s": 5,
          "text": "וגם צריך להבין,"
        },
        {
          "s": 6,
          "text": "דממ\"ש בזהר שהגשת יהודה ליוסף הו\"ע סמיכת גאולה לתפלה,"
        },
        {
          "s": 7,
          "text": "משמע,"
        },
        {
          "s": 8,
          "text": "שגם בהגשת יהודה ליוסף ניכר המעלה דמלכות לגבי ז\"א."
        }
      ]
    }
  ]
}