{
  "globalIndex": 803,
  "owner": 3,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918574_theRebbe_925__p004",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918574_theRebbe_925__p004",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918574_theRebbe_925",
  "title": "מאמר פתח רבי שמעון תשל\"ד",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 1,
          "text": "דזה שישראל אורייתא וקוב\"ה כולא חד"
        },
        {
          "s": 2,
          "text": "(דלא רק שהם מקושרים זה בזה אלא שהם חד ממש)"
        },
        {
          "s": 3,
          "text": "הוא"
        },
        {
          "s": 4,
          "text": "(בעיקר)"
        },
        {
          "s": 5,
          "text": "בישראל."
        },
        {
          "s": 6,
          "text": "דבנוגע לתורה,"
        },
        {
          "s": 7,
          "text": "מכיון שהתורה היא בשביל ישראל"
        },
        {
          "s": 8,
          "text": "(דבר אל בנ\"י צו את בנ\"י54),"
        },
        {
          "s": 9,
          "text": "היינו שהיא דוגמת אמצעי,"
        },
        {
          "s": 10,
          "text": "היא כמו מציאות דבר שמחובר ומקושר עם הקב\"ה,"
        },
        {
          "s": 11,
          "text": "משא\"כ ישראל שהם מושרשים בהעצמות ממש,"
        },
        {
          "s": 12,
          "text": "זה שישראל מושרשים בהעצמות,"
        },
        {
          "s": 13,
          "text": "אין זה שמושרש בו ענין אחר ח\"ו אלא שזה"
        },
        {
          "s": 14,
          "text": "(השרש דישראל)"
        },
        {
          "s": 15,
          "text": "חד עם העצמות."
        },
        {
          "s": 16,
          "text": "וע\"י שישראל ממשיכים העצמות בתורה,"
        },
        {
          "s": 17,
          "text": "נעשית גם התורה חד עם העצמות,"
        },
        {
          "s": 18,
          "text": "ישראל אורייתא וקוב\"ה כולא חד,"
        },
        {
          "s": 19,
          "text": "חד ממש."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וע\"פ כל הנ\"ל יש לבאר,"
        },
        {
          "s": 2,
          "text": "דשני הענינים שברשב\"י,"
        },
        {
          "s": 3,
          "text": "בחד קטירא אתקטרנא ובי' אחידא כו',"
        },
        {
          "s": 4,
          "text": "הם שני אופנים בלימוד התורה שלו"
        },
        {
          "s": 5,
          "text": "(עיקר ענינו דרשב\"י,"
        },
        {
          "s": 6,
          "text": "תורתו אומנתו)."
        },
        {
          "s": 7,
          "text": "ויובן ע\"פ הידוע55"
        },
        {
          "s": 8,
          "text": "דזה שגם ע\"י לימוד נגלה דתורה נעשה ההתקשרות דישראל בהעצמות דתורה ודקוב\"ה"
        },
        {
          "s": 9,
          "text": "(כנ\"ל סעיף ד),"
        },
        {
          "s": 10,
          "text": "הוא בהעלם,"
        },
        {
          "s": 11,
          "text": "וגילוי העצמות"
        },
        {
          "s": 12,
          "text": "(דתורה ודקוב\"ה)"
        },
        {
          "s": 13,
          "text": "הוא בהעסק דפנימיות התורה."
        },
        {
          "s": 14,
          "text": "וכיון שהלימוד דרשב\"י הי' באופן שגם בלימוד הנגלה שלו האיר הפנימיות56,"
        },
        {
          "s": 15,
          "text": "לכן,"
        },
        {
          "s": 16,
          "text": "ההתקשרות שלו בהעצמות דאורייתא ודקוב\"ה,"
        },
        {
          "s": 17,
          "text": "גם בלימוד הנגלה שלו,"
        },
        {
          "s": 18,
          "text": "היתה בגילוי."
        },
        {
          "s": 19,
          "text": "וזהו שאמר כל יומין דאתקטרנא בהאי עלמא בחד קטירא אתקטרנא בי' בקוב\"ה,"
        },
        {
          "s": 20,
          "text": "שגם לימוד הנגלה שלו"
        },
        {
          "s": 21,
          "text": "(שבזה הי' רוב לימודו57)"
        },
        {
          "s": 22,
          "text": "[ועד\"ז כל עניניו,"
        },
        {
          "s": 23,
          "text": "שהיו חדורים בתורה,"
        },
        {
          "s": 24,
          "text": "מכיון שתורתו אומנתו]"
        },
        {
          "s": 25,
          "text": "היתה באופן דהתקשרות שלמעלה מדביקות,"
        },
        {
          "s": 26,
          "text": "בחד קטירא אתקטרנא."
        },
        {
          "s": 27,
          "text": "ויתירה מזו,"
        },
        {
          "s": 28,
          "text": "שעי\"ז הגיע גם לקשר השלישי,"
        },
        {
          "s": 29,
          "text": "הקשר דישראל וקוב\"ה שמצד עצם הנשמה כמו שהיא מקושרת עם העצמות."
        },
        {
          "s": 30,
          "text": "דזהו\"ע בחד קטירא אתקטרנא,"
        },
        {
          "s": 31,
          "text": "דהתקשרות שמצד יחידה58"
        },
        {
          "s": 32,
          "text": "(עצם הנשמה)"
        },
        {
          "s": 33,
          "text": "היא למעלה מהתחלקות דשני קוין,"
        },
        {
          "s": 34,
          "text": "וכמבואר במק\"א59,"
        },
        {
          "s": 35,
          "text": "דבבחינת היחידה,"
        },
        {
          "s": 36,
          "text": "שניהם הם ענין אחד,"
        },
        {
          "s": 37,
          "text": "חד קטירא."
        },
        {
          "s": 38,
          "text": "דבהקשר דישראל וקוב\"ה שע\"י אורייתא,"
        },
        {
          "s": 39,
          "text": "כיון שהתורה היא כמו אמצעי ואינה חד ממש עם העצמות,"
        },
        {
          "s": 40,
          "text": "לכן,"
        },
        {
          "s": 41,
          "text": "גם ההתקשרות דישראל וקוב\"ה שע\"י התורה"
        },
        {
          "s": 42,
          "text": "(גם ההתקשרות כמו שהיא מצד עצם התורה שלמעלה מהשתלשלות),"
        },
        {
          "s": 43,
          "text": "היא דוגמת התקשרות דשני דברים המתקשרים,"
        },
        {
          "s": 44,
          "text": "ובמילא,"
        },
        {
          "s": 45,
          "text": "ההתקשרות היא באופן שיש לה רצון לאלקות"
        },
        {
          "s": 46,
          "text": "(מציאות דרצון,"
        },
        {
          "s": 47,
          "text": "שנחלק לשני קוין),"
        },
        {
          "s": 48,
          "text": "ואמיתית הענין דבחד קטירא אתקטרנא,"
        },
        {
          "s": 49,
          "text": "קשר אחד,"
        },
        {
          "s": 50,
          "text": "הוא בקשר דישראל וקוב\"ה"
        },
        {
          "s": 51,
          "text": "(שלמעלה מהקשר שלהם ע\"י אמצעות התורה),"
        },
        {
          "s": 52,
          "text": "מצד זה שהשרש דישראל הוא בהעצמות."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "וע\"פ כל הנ\"ל יש לומר,"
        },
        {
          "s": 1,
          "text": "דזה שרשב\"י הגיע להשלימות דבי' אחידא ביום הסתלקותו דוקא,"
        },
        {
          "s": 2,
          "text": "הוא,"
        },
        {
          "s": 3,
          "text": "כי במשך כל ימי חייו,"
        },
        {
          "s": 4,
          "text": "עיקר ענינו הי' עסק התורה"
        },
        {
          "s": 5,
          "text": "(תורתו אומנתו),"
        },
        {
          "s": 6,
          "text": "ולכן גם בהענין דבחד קטירא אתקטרנא"
        },
        {
          "s": 7,
          "text": "(שמצד עצם הנשמה)"
        },
        {
          "s": 8,
          "text": "הי' נרגש ענין ההתקשרות"
        },
        {
          "s": 9,
          "text": "(דוגמת התקשרות דשני דברים שמתקשרים),"
        },
        {
          "s": 10,
          "text": "וביום הסתלקותו,"
        },
        {
          "s": 11,
          "text": "האיר אצלו בגילוי"
        },
        {
          "s": 12,
          "text": "(ובשלימות60)"
        },
        {
          "s": 13,
          "text": "הקשר דישראל וקוב\"ה שמצד עצם הנשמה,"
        },
        {
          "s": 14,
          "text": "נשמתי בי' אחידא61."
        }
      ]
    }
  ]
}