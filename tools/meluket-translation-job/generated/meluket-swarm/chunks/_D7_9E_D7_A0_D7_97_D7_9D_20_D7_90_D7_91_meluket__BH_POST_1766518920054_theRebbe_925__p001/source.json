  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518920054_theRebbe_925__p001",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518920054_theRebbe_925",
  "title": "מאמר והי' עקב תשמעון תשט\"ז",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ עקב,"
        },
        {
          "s": 2,
          "text": "כ\"ף מנחם-אב,"
        },
        {
          "s": 3,
          "text": "ה'תשט\"ז"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "(הנחה בלתי מוגה)"
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "והי' עקב תשמעון את המשפטים האלה ושמרתם ועשיתם אותם ושמר ה\"א לך את הברית ואת החסד אשר נשבע גו'1."
        },
        {
          "s": 1,
          "text": "וידוע הדיוק בזה2,"
        },
        {
          "s": 2,
          "text": "דהלשון תשמעון פירושו תשמעון ודאי,"
        },
        {
          "s": 3,
          "text": "והיינו לפי שעקב קאי על הזמן דעקבתא דמשיחא,"
        },
        {
          "s": 4,
          "text": "ומאחר שהוא דור היותר אחרון,"
        },
        {
          "s": 5,
          "text": "לכן תשמעון ודאי,"
        },
        {
          "s": 6,
          "text": "לפי שהוא דור היותר אחרון ואי אפשר לחכות יותר,"
        },
        {
          "s": 7,
          "text": "ס'איז ניטאָ אויף ווען צו אָפּלייגן די בירורים,"
        },
        {
          "s": 8,
          "text": "ולכן תשמעון ודאי3."
        }
      ]
    }
  ]
}