{
  "globalIndex": 726,
  "owner": 26,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918005_theRebbe_76__p005",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918005_theRebbe_76__p005",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518918005_theRebbe_76",
  "title": "מאמר כימי צאתך תשל\"ח",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "דבהתלבשות הנפלאות בטבע שיהי' לע\"ל,"
        },
        {
          "s": 3,
          "text": "שני ענינים."
        },
        {
          "s": 4,
          "text": "דזה שהנפלאות שלמעלה מטבע יתלבשו בטבע הוא כי אז גם ההעלם שלמעלה מגילוי יומשך בגילוי."
        },
        {
          "s": 5,
          "text": "וזה שהטבע לא יסתיר על הנפלאות הוא לפי שאז תהי' עליית הטבע,"
        },
        {
          "s": 6,
          "text": "שגם הטבע יהי' כלי להנפלאות שלמעלה מהטבע."
        },
        {
          "s": 7,
          "text": "ועפ\"ז יש לבאר הקשר דשני הפירושים באראנו נפלאות – פירוש אדמו\"ר האמצעי שגם הנפלאות שלמעלה מהטבע יראו אז בגילוי"
        },
        {
          "s": 8,
          "text": "(ולא כמו עכשיו שהנפלאות שלמעלה מהטבע יודעים רק מציאותם),"
        },
        {
          "s": 9,
          "text": "ופירוש הצ\"צ שגם בהנסים המלובשים בטבע"
        },
        {
          "s": 10,
          "text": "(נפלאות גדולות הנמשכים מבחינת לבדו)"
        },
        {
          "s": 11,
          "text": "יהי' נראה בגילוי הנס שבהם"
        },
        {
          "s": 12,
          "text": "(כנ\"ל סעיף ג)"
        },
        {
          "s": 13,
          "text": "– כי התוכן דשני הפירושים הוא שלע\"ל יהי' הטבע כלי ללמעלה מהטבע,"
        },
        {
          "s": 14,
          "text": "שלכן לא יסתיר הטבע על הנסים המלובשים בו."
        },
        {
          "s": 15,
          "text": "אלא שלפירוש הצ\"צ,"
        },
        {
          "s": 16,
          "text": "ענין אראנו נפלאות הוא שהטבע לא יסתיר על הנסים השייכים לטבע"
        },
        {
          "s": 17,
          "text": "(היינו,"
        },
        {
          "s": 18,
          "text": "הנסים הנמשכים מזה שאוא\"ס הוא למטה מטה כו',"
        },
        {
          "s": 19,
          "text": "ענין הגילוי דאוא\"ס)."
        },
        {
          "s": 20,
          "text": "דהטבע כמו שהוא עכשיו מסתיר גם על נסים אלה."
        },
        {
          "s": 21,
          "text": "כי שורש הנסים המלובשים בטבע הוא בהגילוי דאוא\"ס,"
        },
        {
          "s": 22,
          "text": "דבכללות הוא שם הוי' שלמעלה מהטבע,"
        },
        {
          "s": 23,
          "text": "ושורש הטבע הוא משם אלקים"
        },
        {
          "s": 24,
          "text": "(אלקים בגימטריא הטבע37)"
        },
        {
          "s": 25,
          "text": "שמעלים ומסתיר על שם הוי'."
        },
        {
          "s": 26,
          "text": "ולע\"ל יהי' שם אלקים כלי להגילוי דהוי'."
        },
        {
          "s": 27,
          "text": "ולפירוש אדמו\"ר האמצעי,"
        },
        {
          "s": 28,
          "text": "ענין אראנו נפלאות הוא שהטבע הנמשך משם אלקים יהי' כלי"
        },
        {
          "s": 29,
          "text": "(גם)"
        },
        {
          "s": 30,
          "text": "להנפלאות שלמעלה מהטבע הנמשכים מזה שאוא\"ס הוא למעלה מעלה כו',"
        },
        {
          "s": 31,
          "text": "העלם שלמעלה מגילוי"
        },
        {
          "s": 32,
          "text": "(למעלה מהוי')."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "וע\"פ המובא לעיל"
        },
        {
          "s": 2,
          "text": "(מהמאמר)"
        },
        {
          "s": 3,
          "text": "שבהגאולה דיציאת מצרים נפתח הצנור גם דגאולה העתידה,"
        },
        {
          "s": 4,
          "text": "יש לומר,"
        },
        {
          "s": 5,
          "text": "שבהגאולה דיציאת מצרים נמשך גם הנתינת כח על הענין דאראנו נפלאות שיהי' בגאולה העתידה."
        },
        {
          "s": 6,
          "text": "והענין הוא,"
        },
        {
          "s": 7,
          "text": "דזה שלע\"ל יהי' הטבע כלי ללמעלה מהטבע"
        },
        {
          "s": 8,
          "text": "[ענין אראנו נפלאות]"
        },
        {
          "s": 9,
          "text": "הוא ע\"י הבירורים,"
        },
        {
          "s": 10,
          "text": "שעי\"ז מזדכך העולם ומתעלה ונעשה כלי ללמעלה מהטבע."
        },
        {
          "s": 11,
          "text": "דהתחלת ענין הבירורים היתה ביציאת מצרים."
        },
        {
          "s": 12,
          "text": "דע\"י שעבדים היינו לפרעה במצרים38"
        },
        {
          "s": 13,
          "text": "[לפרעה – מלך קשה,"
        },
        {
          "s": 14,
          "text": "במצרים – מדינה קשה,"
        },
        {
          "s": 15,
          "text": "שאין39"
        },
        {
          "s": 16,
          "text": "עבד יכול לברוח משם40]"
        },
        {
          "s": 17,
          "text": "ואעפ\"כ עמדו בנסיון,"
        },
        {
          "s": 18,
          "text": "עי\"ז ביררו הניצוצות שהיו במצרים."
        },
        {
          "s": 19,
          "text": "ועד שוינצלו את מצרים41,"
        },
        {
          "s": 20,
          "text": "שעשאוה כמצולה שאין בה דגים וכמצודה שאין בה דגן42,"
        },
        {
          "s": 21,
          "text": "ועי\"ז ניתן הכח על עבודת הבירורים בכל הימים שלאחרי יציאת מצרים"
        },
        {
          "s": 22,
          "text": "(ימי לשון רבים),"
        },
        {
          "s": 23,
          "text": "כולל גם הימים שבזמן הגלות."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דמהטעמים על זה שמזכירין יציאת מצרים בכל יום הוא כי עי\"ז מיתוסף בהנתינת כח שנמשך מיציאת מצרים על עבודת הבירורים בכל יום."
        },
        {
          "s": 2,
          "text": "וע\"י שבכל יום ויום מבררים עוד ניצוצות ועוד ניצוצות,"
        },
        {
          "s": 3,
          "text": "מתקרבים יותר לביאת המשיח,"
        },
        {
          "s": 4,
          "text": "כי ע\"י כל ניצוץ שנתברר,"
        },
        {
          "s": 5,
          "text": "נעשה העולם יותר מזוכך,"
        },
        {
          "s": 6,
          "text": "ועד שבגמר הבירורים יהי' העולם כלי לגילוי אלקות שלמעלה מעולמות,"
        },
        {
          "s": 7,
          "text": "דבכללות הוא שהטבע דעולם יהי' כלי ללמעלה מהטבע,"
        },
        {
          "s": 8,
          "text": "אראנו נפלאות."
        },
        {
          "s": 9,
          "text": "ולכן יזכירו יציאת מצרים גם בימות המשיח,"
        },
        {
          "s": 10,
          "text": "כי זה שאז יהי' העולם כלי לגילוי אלקות שלמעלה מעולמות הוא ע\"י הגאולה דיציאת מצרים."
        },
        {
          "s": 11,
          "text": "וזהו כימי צאתך מארץ מצרים אראנו נפלאות,"
        },
        {
          "s": 12,
          "text": "דזה שאומר שאראנו נפלאות"
        },
        {
          "s": 13,
          "text": "(לע\"ל)"
        },
        {
          "s": 14,
          "text": "יהי' כימי צאתך מארץ מצרים הוא,"
        },
        {
          "s": 15,
          "text": "כי הנתינת כח על הענין דאראנו נפלאות שיהי' לע\"ל היא מיציאת מצרים."
        },
        {
          "s": 16,
          "text": "ומדייק כימי צאתך,"
        },
        {
          "s": 17,
          "text": "כימי לשון רבים,"
        },
        {
          "s": 18,
          "text": "כי ביציאת מצרים היתה רק הנתינת כח על הענין דאראנו נפלאות,"
        },
        {
          "s": 19,
          "text": "ובכדי שהענין דאראנו נפלאות יומשך בפועל הוא ע\"י עבודת הבירורים בהימים שבין יציאת מצרים וגאולה העתידה,"
        },
        {
          "s": 20,
          "text": "שהם ימי צאתך מארץ מצרים"
        },
        {
          "s": 21,
          "text": "(כנ\"ל סעיף א מהמאמר),"
        },
        {
          "s": 22,
          "text": "ימי לשון רבים."
        }
      ]
    }
  ]
}