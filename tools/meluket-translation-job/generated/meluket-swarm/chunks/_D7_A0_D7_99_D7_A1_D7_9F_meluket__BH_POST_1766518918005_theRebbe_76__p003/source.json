{
  "globalIndex": 724,
  "owner": 24,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918005_theRebbe_76__p003",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918005_theRebbe_76__p003",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518918005_theRebbe_76",
  "title": "מאמר כימי צאתך תשל\"ח",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ולהוסיף,"
        },
        {
          "s": 1,
          "text": "דעפ\"ז יש לבאר גם מה שהכתוב מדייק אראנו נפלאות,"
        },
        {
          "s": 2,
          "text": "שעיקר החידוש הוא לא בזה שיהיו אז נפלאות אלא בזה שהקב\"ה יראה את הנפלאות,"
        },
        {
          "s": 3,
          "text": "כי נפלאות ישנם גם עכשיו,"
        },
        {
          "s": 4,
          "text": "ועד שישנם גם נפלאות גדולות הנמשכים מבחינת לבדו,"
        },
        {
          "s": 5,
          "text": "והחידוש בגאולה העתידה הוא שאז יהי' אראנו נפלאות."
        },
        {
          "s": 6,
          "text": "דעכשיו,"
        },
        {
          "s": 7,
          "text": "הנסים הנמשכים מבחינת לבדו הם באופן שרק לבדו יודע שזה נס,"
        },
        {
          "s": 8,
          "text": "ובגאולה העתידה יהי' אראנו נפלאות,"
        },
        {
          "s": 9,
          "text": "שיהי' נראה בגילוי הנס שבהם."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה שני הסוגים שבנסים"
        },
        {
          "s": 2,
          "text": "(נסים שלמעלה מהטבע ונסים המלובשים בטבע)"
        },
        {
          "s": 3,
          "text": "יש בכל אחד מהם מעלה20."
        },
        {
          "s": 4,
          "text": "וכיון שלע\"ל יהיו כל הענינים בתכלית השלימות,"
        },
        {
          "s": 5,
          "text": "צריך לומר,"
        },
        {
          "s": 6,
          "text": "דמ\"ש אראנו נפלאות הוא לא רק בנוגע להנסים המלובשים בטבע"
        },
        {
          "s": 7,
          "text": "(שלע\"ל יהי' נראה בגילוי הנס שבהם,"
        },
        {
          "s": 8,
          "text": "כנ\"ל סעיף ג),"
        },
        {
          "s": 9,
          "text": "אלא גם בנוגע להנסים שאינם מלובשים בטבע."
        },
        {
          "s": 10,
          "text": "וכמובן גם מזה שאומר שהנפלאות שיהיו בגאולה העתידה יהיו כימי צאתך מארץ מצרים,"
        },
        {
          "s": 11,
          "text": "דהנסים שהיו ביציאת מצרים היו למעלה מהטבע21."
        },
        {
          "s": 12,
          "text": "ולהוסיף,"
        },
        {
          "s": 13,
          "text": "דזה שנסים נק' בשם נפלאות הוא"
        },
        {
          "s": 14,
          "text": "(בפשטות)"
        },
        {
          "s": 15,
          "text": "לפי שהם פלא שאין להם מקום בטבע,"
        },
        {
          "s": 16,
          "text": "ומזה מובן,"
        },
        {
          "s": 17,
          "text": "דמ\"ש אראנו נפלאות ואיתא במדרש שהנפלאות שיהיו בגאולה העתידה יהיו גדולות יותר מהנפלאות שהיו ביציאת מצרים"
        },
        {
          "s": 18,
          "text": "[ועד שיהיו נפלאות בערך הנפלאות שהיו ביציאת מצרים]"
        },
        {
          "s": 19,
          "text": "– הכוונה בזה היא,"
        },
        {
          "s": 20,
          "text": "שהפלא"
        },
        {
          "s": 21,
          "text": "(למעלה מהטבע)"
        },
        {
          "s": 22,
          "text": "בהנסים שיהיו בגאולה העתידה הוא פלא גם בערך הפלא דהנסים שהיו ביציאת מצרים22."
        },
        {
          "s": 23,
          "text": "וצריך להבין מ\"ש אראנו נפלאות,"
        },
        {
          "s": 24,
          "text": "דלכאורה,"
        },
        {
          "s": 25,
          "text": "להפירוש שאראנו נפלאות קאי על הנסים שלמעלה מהטבע"
        },
        {
          "s": 26,
          "text": "(ובפרט שהלמעלה מהטבע דהנפלאות שיהיו לע\"ל יהי' עוד יותר מהלמעלה מהטבע שהי' בהנסים דיציאת מצרים),"
        },
        {
          "s": 27,
          "text": "מהו החידוש בזה שיראו את הנפלאות."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים מה שהובא לעיל"
        },
        {
          "s": 2,
          "text": "(סעיף ג)"
        },
        {
          "s": 3,
          "text": "שהנסים שאין בעל הנס מכיר בנסו שורש המשכתם הוא מבחינת לבדו."
        },
        {
          "s": 4,
          "text": "וצריך להבין,"
        },
        {
          "s": 5,
          "text": "איך אפשר שלבושי הטבע יעלימו ויסתירו על נס שנמשך מבחינת לבדו."
        },
        {
          "s": 6,
          "text": "והענין הוא,"
        },
        {
          "s": 7,
          "text": "דמהמעלות בנסים המלובשים בטבע לגבי הנסים שלמעלה מהטבע,"
        },
        {
          "s": 8,
          "text": "הוא כמו שמבאר אדמו\"ר האמצעי בשער האמונה23,"
        },
        {
          "s": 9,
          "text": "דע\"י שהנס מתלבש בטבע הוא בא בגילוי."
        },
        {
          "s": 10,
          "text": "דהנסים שאינם מלובשים בטבע,"
        },
        {
          "s": 11,
          "text": "יודעים רק מציאותם ולא מהותם."
        },
        {
          "s": 12,
          "text": "וכמו נס דתחיית המתים,"
        },
        {
          "s": 13,
          "text": "דהגם שרואים בפועל שבתחילה הי' מת ועכשיו הוא חי,"
        },
        {
          "s": 14,
          "text": "אין יודעים ומשיגים איך הוא קם לתחי'."
        },
        {
          "s": 15,
          "text": "ועד\"ז הוא בכל הנסים שלמעלה מהטבע."
        },
        {
          "s": 16,
          "text": "ולכן נקראים נסים אלו בשם נפלאות,"
        },
        {
          "s": 17,
          "text": "דפלא הוא זה שאינו מושג בשכל"
        },
        {
          "s": 18,
          "text": "[ועד,"
        },
        {
          "s": 19,
          "text": "שכשאדם רואה דבר פלא הוא משתומם על זה,"
        },
        {
          "s": 20,
          "text": "דהשתוממות הוא ביטול השכל24]."
        },
        {
          "s": 21,
          "text": "וע\"י שהנס מתלבש בטבע,"
        },
        {
          "s": 22,
          "text": "הוא בא בגילוי,"
        },
        {
          "s": 23,
          "text": "שמשיגים את מהותו."
        },
        {
          "s": 24,
          "text": "כהנס דפורים,"
        },
        {
          "s": 25,
          "text": "שיודעים ומשיגים איך נתבטלה הגזירה"
        },
        {
          "s": 26,
          "text": "(שזה הי' ע\"י אסתר וכו')."
        },
        {
          "s": 27,
          "text": "וכן ארבעה שצריכים להודות,"
        },
        {
          "s": 28,
          "text": "שיודעים ומשיגים איך נתרפא החולה"
        },
        {
          "s": 29,
          "text": "(שזה הי' ע\"י סממני הרפואה),"
        },
        {
          "s": 30,
          "text": "וכיו\"ב."
        }
      ]
    }
  ]
}