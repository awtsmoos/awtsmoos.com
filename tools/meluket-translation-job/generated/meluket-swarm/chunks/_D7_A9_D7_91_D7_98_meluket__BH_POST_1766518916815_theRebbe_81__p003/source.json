{
  "globalIndex": 520,
  "owner": 20,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916815_theRebbe_81__p003",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916815_theRebbe_81__p003",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916815_theRebbe_81",
  "title": "מאמר באתי לגני תש\"ל",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר27"
        },
        {
          "s": 2,
          "text": "(לאחרי שמבאר בארוכה שהמשכת עיקר שכינה בתחתונים היא ע\"י העבודה דאתכפיא ואתהפכא),"
        },
        {
          "s": 3,
          "text": "שעל שם זה נקראים ישראל בשם צבאות הוי'28,"
        },
        {
          "s": 4,
          "text": "מצד העבודה שלהם דאתכפיא ואתהפכא."
        },
        {
          "s": 5,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 6,
          "text": "דהחילוק שבין צבא"
        },
        {
          "s": 7,
          "text": "(אנשי חיל)"
        },
        {
          "s": 8,
          "text": "ובין השרים וכיו\"ב שעוסקים בהטבת עניני המדינה הוא בשני ענינים."
        },
        {
          "s": 9,
          "text": "הן בהפעולה בהמדינה שנעשית על ידם,"
        },
        {
          "s": 10,
          "text": "דע\"י שיוצאים למלחמה לכבוש את האויב,"
        },
        {
          "s": 11,
          "text": "נעשה חידוש במדינת המלך,"
        },
        {
          "s": 12,
          "text": "שגם אותה המדינה שהיתה תחלה ברשות האויב נעשית מדינת המלך"
        },
        {
          "s": 13,
          "text": "(משא\"כ הטבת המדינה והגדלת כחה שע\"י השרים אינה באופן של חידוש),"
        },
        {
          "s": 14,
          "text": "והן בנוגע להצבא עצמם,"
        },
        {
          "s": 15,
          "text": "שהמסירה והנתינה שלהם להמלך היא למעלה מכל הגבלות,"
        },
        {
          "s": 16,
          "text": "ועד שמסכנים את נפשם כשיוצאים למלחמה,"
        },
        {
          "s": 17,
          "text": "ויתירה מזו שהם מוכנים תמיד"
        },
        {
          "s": 18,
          "text": "(גם שלא בעת מלחמה)"
        },
        {
          "s": 19,
          "text": "למסור נפשם מבלי לנטות מאשר נצטוו29,"
        },
        {
          "s": 20,
          "text": "מעלת הביטול."
        },
        {
          "s": 21,
          "text": "וזהו שישראל נק' בשם צבאות הוי' הוא מצד העבודה שלהם דאתכפיא ואתהפכא,"
        },
        {
          "s": 22,
          "text": "דענין אתהפכא,"
        },
        {
          "s": 23,
          "text": "שמהפך את העולם שמראה את עצמו למציאות"
        },
        {
          "s": 24,
          "text": "[שזהו\"ע השקר דעולם30]"
        },
        {
          "s": 25,
          "text": "להיות מקדש ודירה לו ית',"
        },
        {
          "s": 26,
          "text": "הוא דוגמת הכיבוש שבא ע\"י המלחמה."
        },
        {
          "s": 27,
          "text": "ומהמעלות דאתהפכא היא החידוש31."
        },
        {
          "s": 28,
          "text": "דזה שחושך נהפך לאור הוא חידוש."
        },
        {
          "s": 29,
          "text": "וענין האתכפיא היא המלחמה עצמה,"
        },
        {
          "s": 30,
          "text": "שלוחם נגד יצרו,"
        },
        {
          "s": 31,
          "text": "והמעלה דאתכפיא היא בענין הביטול32,"
        },
        {
          "s": 32,
          "text": "שמסלק ומניח את עצמו על הצד מפני רצון הקב\"ה33."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "וממשיך בהמאמר34,"
        },
        {
          "s": 1,
          "text": "דכמו שבמלחמה בגשמיות,"
        },
        {
          "s": 2,
          "text": "בכדי לנצח את המלחמה מבזבזים את האוצרות ונותנים אותם"
        },
        {
          "s": 3,
          "text": "(ע\"י שרי הפקידים)"
        },
        {
          "s": 4,
          "text": "לאנשי החיל בכדי שינצחו את המלחמה,"
        },
        {
          "s": 5,
          "text": "עד\"ז הוא גם למעלה,"
        },
        {
          "s": 6,
          "text": "שבכדי שהצבאות הוי' ינצחו את המלחמה,"
        },
        {
          "s": 7,
          "text": "נותנים להם,"
        },
        {
          "s": 8,
          "text": "ובאופן דבזבוז,"
        },
        {
          "s": 9,
          "text": "האוצר שלמעלה."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה החילוק שבין שתי העבודות דאתכפיא ואתהפכא היא גם בההמשכה שנמשכת על ידם."
        },
        {
          "s": 2,
          "text": "שההמשכה שע\"י העבודה דאתכפיא היא נעלית יותר מההמשכה שע\"י העבודה דאתהפכא32."
        },
        {
          "s": 3,
          "text": "דכד אתכפיא סט\"א"
        },
        {
          "s": 4,
          "text": "(אתכפיא דוקא35)"
        },
        {
          "s": 5,
          "text": "אסתלק יקרא דקוב\"ה בכולהו עלמין36,"
        },
        {
          "s": 6,
          "text": "המשכת וגילוי עצמות אוא\"ס שלמעלה משייכות לעולמות37,"
        },
        {
          "s": 7,
          "text": "שלכן נקראת המשכה זו בשם אסתלק,"
        },
        {
          "s": 8,
          "text": "לפי שהוא גילוי האור שבבחינת רוממות38."
        },
        {
          "s": 9,
          "text": "[ולהעיר,"
        },
        {
          "s": 10,
          "text": "שכמו\"כ הוא גם בהסתלקות של צדיקים,"
        },
        {
          "s": 11,
          "text": "שאינה סילוק כפשוטו ח\"ו,"
        },
        {
          "s": 12,
          "text": "שהרי רועי ישראל לא יעזבו את צאן מרעיתם39,"
        },
        {
          "s": 13,
          "text": "אלא אדרבא,"
        },
        {
          "s": 14,
          "text": "המשכה נעלית יותר,"
        },
        {
          "s": 15,
          "text": "המשכה מנשמת הצדיק עצמה שאינה מוגבלת בתוך כלי ולבוש40,"
        },
        {
          "s": 16,
          "text": "וזה שנק' בשם הסתלקות הוא לפי שהוא גילוי שלמעלה מהתלבשות בכלים."
        },
        {
          "s": 17,
          "text": "ובפרט לאחרי עשרים שנה,"
        },
        {
          "s": 18,
          "text": "שאז מיתוסף גם הענין דלמכור בנכסי אביו41"
        },
        {
          "s": 19,
          "text": "[שזה קאי גם על התלמידים של הצדיק שנקראים בנים42],"
        },
        {
          "s": 20,
          "text": "ומבואר בלקו\"ת43"
        },
        {
          "s": 21,
          "text": "דזה שארז\"ל41"
        },
        {
          "s": 22,
          "text": "ולמכור בנכסי אביו עד שיהא בן עשרים הוא כי אז נכנסים בו מקיפי אבא,"
        },
        {
          "s": 23,
          "text": "מקיפים שלמעלה מהתלבשות בכלים."
        },
        {
          "s": 24,
          "text": "ויש לקשר זה גם עם זה שעשרים בגימטריא כתר44,"
        },
        {
          "s": 25,
          "text": "ע\"פ המבואר בלקו\"ת שם בפירוש הכתוב45"
        },
        {
          "s": 26,
          "text": "שאו את ראש גו' לגולגלותם מבן עשרים שנה גו',"
        },
        {
          "s": 27,
          "text": "דגולגלותם הוא כתר"
        },
        {
          "s": 28,
          "text": "(גלגלתא),"
        },
        {
          "s": 29,
          "text": "וע\"י שנמשכים המקיפים דאבא אפשר להיות ההעלאה לגלגלתא,"
        },
        {
          "s": 30,
          "text": "כתר."
        },
        {
          "s": 31,
          "text": "והיינו,"
        },
        {
          "s": 32,
          "text": "שלאחרי עשרים שנה יכולים לקבל נוסף על בחינת חי' של נשמת הצדיק גם מבחינת יחידה שלו,"
        },
        {
          "s": 33,
          "text": "כמבואר בלקו\"ת שם שמקיפים דאבא וגלגלתא הם חי' ויחידה]."
        }
      ]
    }
  ]
}