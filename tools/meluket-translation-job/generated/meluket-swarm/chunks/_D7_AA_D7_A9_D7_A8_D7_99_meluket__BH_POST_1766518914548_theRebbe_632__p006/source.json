{
  "globalIndex": 151,
  "owner": 1,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914548_theRebbe_632__p006",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914548_theRebbe_632__p006",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914548_theRebbe_632",
  "title": "מאמר ביום השמיני תשמ\"א",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "והנה בשמיני עצרת"
        },
        {
          "s": 2,
          "text": "(שמיני מלשון שומן79)"
        },
        {
          "s": 3,
          "text": "הוא התמצית והעסענץ80"
        },
        {
          "s": 4,
          "text": "של כל הענינים דחודש תשרי81,"
        },
        {
          "s": 5,
          "text": "ובו נקלטים"
        },
        {
          "s": 6,
          "text": "(עצרת מלשון קליטה5)"
        },
        {
          "s": 7,
          "text": "כל ענינים אלו."
        },
        {
          "s": 8,
          "text": "ועי\"ז נמשכים"
        },
        {
          "s": 9,
          "text": "(כל הענינים דחודש תשרי)"
        },
        {
          "s": 10,
          "text": "על כל השנה,"
        },
        {
          "s": 11,
          "text": "כמ\"ש אדמו\"ר הצ\"צ82"
        },
        {
          "s": 12,
          "text": "ד\"בו"
        },
        {
          "s": 13,
          "text": "(בשמיני עצרת)"
        },
        {
          "s": 14,
          "text": "מקבלים כל ישראל שפע הנהגתם בתורתם ועבודתם כל השנה\"."
        },
        {
          "s": 15,
          "text": "וזהו ביום השמיני שלח"
        },
        {
          "s": 16,
          "text": "(המלך)"
        },
        {
          "s": 17,
          "text": "את העם גו' וילכו לאהליהם,"
        },
        {
          "s": 18,
          "text": "דמבחינת המלכות שנמשכה בראש השנה עשי\"ת וכו' ניתן הכח"
        },
        {
          "s": 19,
          "text": "(שלח83)"
        },
        {
          "s": 20,
          "text": "לכל ישראל ללכת לאהליהם,"
        },
        {
          "s": 21,
          "text": "לעניני העולם שעוסקים בהם במשך השנה,"
        },
        {
          "s": 22,
          "text": "ולעשות מהם אהל ומשכן לו ית',"
        },
        {
          "s": 23,
          "text": "דירה בתחתונים84."
        },
        {
          "s": 24,
          "text": "וזהו שלח את העם"
        },
        {
          "s": 25,
          "text": "(עם דייקא),"
        },
        {
          "s": 26,
          "text": "שזהו ע\"ד \"למען85"
        },
        {
          "s": 27,
          "text": "הקים אותך היום לו לעם\" שבראש השנה,"
        },
        {
          "s": 28,
          "text": "דמ\"ש \"לו לעם\""
        },
        {
          "s": 29,
          "text": "(דוקא)"
        },
        {
          "s": 30,
          "text": "הוא כי אין86"
        },
        {
          "s": 31,
          "text": "מלך בלא עם87."
        },
        {
          "s": 32,
          "text": "אלא שבראש השנה,"
        },
        {
          "s": 33,
          "text": "הפירוש \"עם\" הוא"
        },
        {
          "s": 34,
          "text": "(לא מלשון עוממות88"
        },
        {
          "s": 35,
          "text": "אלא אדרבא)"
        },
        {
          "s": 36,
          "text": "עם מלשון עמו"
        },
        {
          "s": 37,
          "text": "(שהם אנשים כמותו ומתייחסים אליו)89,"
        },
        {
          "s": 38,
          "text": "וענין שלח את העם דשמיני עצרת הוא שיהיו בחי' עם מלשון עוממות90,"
        },
        {
          "s": 39,
          "text": "וגם בזה יומשך מבחי' עם מלשון עמו91,"
        },
        {
          "s": 40,
          "text": "שעי\"ז נמשך הכח להיות \"וילכו לאהליהם\","
        },
        {
          "s": 41,
          "text": "לעשות מאהליהם כפשוטם,"
        },
        {
          "s": 42,
          "text": "עניני העולם,"
        },
        {
          "s": 43,
          "text": "אהל ומשכן לו ית'."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "וממשיך בכתוב שמחים וטובי לב על כל הטובה אשר עשה ה' לדוד עבדו ולישראל עמו,"
        },
        {
          "s": 1,
          "text": "שמחים וטובי לב הוא גילוי האהבה דפנימיות נקודת הלב"
        },
        {
          "s": 2,
          "text": "(כמבואר בהמאמר92)"
        },
        {
          "s": 3,
          "text": "[דלאחרי אמירת המזמור93"
        },
        {
          "s": 4,
          "text": "לדוד ה' אורי וישעי מר\"ח אלול עד הו\"ר94,"
        },
        {
          "s": 5,
          "text": "שני פעמים בכל יום,"
        },
        {
          "s": 6,
          "text": "דנקודת המזמור היא לך אמר לבי בקשו פני גו'95,"
        },
        {
          "s": 7,
          "text": "האָט מען זיכער אויסגעבעטן שיהי' גילוי פנימיות נקודת הלב96,"
        },
        {
          "s": 8,
          "text": "ובשמיני עצרת נעשים כל ישראל שמחים וטובי לב],"
        },
        {
          "s": 9,
          "text": "על כל הטובה אשר עשה ה' לדוד עבדו,"
        },
        {
          "s": 10,
          "text": "בחי' מלכותו ית',"
        },
        {
          "s": 11,
          "text": "ולישראל עמו,"
        },
        {
          "s": 12,
          "text": "שעוסקים בבנינו של עולם"
        },
        {
          "s": 13,
          "text": "(כמ\"ש97"
        },
        {
          "s": 14,
          "text": "וכל בניך לימודי הוי' אל תקרי בניך אלא בוניך98),"
        },
        {
          "s": 15,
          "text": "דבנינו של עולם הוא בחי' מלכותו ית'99."
        },
        {
          "s": 16,
          "text": "ויש לומר,"
        },
        {
          "s": 17,
          "text": "דישראל הוא בחי' בן"
        },
        {
          "s": 18,
          "text": "(כידוע בענין יעקב וישראל,"
        },
        {
          "s": 19,
          "text": "שיעקב הוא בחי' עבד וישראל הוא בחי' בן100),"
        },
        {
          "s": 20,
          "text": "ועם הוא מלשון עוממות"
        },
        {
          "s": 21,
          "text": "(כנ\"ל),"
        },
        {
          "s": 22,
          "text": "בחי' עבד שלמטה מבחי' בן."
        },
        {
          "s": 23,
          "text": "אבל יש יתרון גם בזה שישראל הם עמו ית' על זה שהם בניו ית'"
        },
        {
          "s": 24,
          "text": "(כמשנ\"ת לעיל101)."
        },
        {
          "s": 25,
          "text": "ולכן אומר כאן ולישראל עמו,"
        },
        {
          "s": 26,
          "text": "שתי המעלות102."
        },
        {
          "s": 27,
          "text": "וע\"ד שנת\"ל בענין שלח את העם,"
        },
        {
          "s": 28,
          "text": "שהוא חיבור ד\"עם\" מלשון עמו"
        },
        {
          "s": 29,
          "text": "(אנשים כמותו)"
        },
        {
          "s": 30,
          "text": "עם \"עם\" מלשון עוממות."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "וע\"פ כל הנ\"ל יש לבאר גם זה שבדברי הימים כתיב וביום עשרים ושלשה לחודש השביעי שלח את העם גו' שזהו רמז ליו\"ט שני של גליות"
        },
        {
          "s": 3,
          "text": "(כנ\"ל בתחלת המאמר דהצ\"צ),"
        },
        {
          "s": 4,
          "text": "דענין יו\"ט שני הוא103"
        },
        {
          "s": 5,
          "text": "שגם יום שמצד עצמו הוא חול,"
        },
        {
          "s": 6,
          "text": "עושים אותו ישראל ליו\"ט"
        },
        {
          "s": 7,
          "text": "(קדושה),"
        },
        {
          "s": 8,
          "text": "ולכן מרמז הכתוב הענין דיו\"ט שני בשמיני עצרת דוקא,"
        },
        {
          "s": 9,
          "text": "ובשמיני עצרת גופא בהענין דשלח את העם,"
        },
        {
          "s": 10,
          "text": "כי ענין שלח את העם גו' הוא"
        },
        {
          "s": 11,
          "text": "(כנ\"ל בארוכה)"
        },
        {
          "s": 12,
          "text": "הנתינת כח משמיני עצרת על כל השנה לעשות את עניני העולם"
        },
        {
          "s": 13,
          "text": "(שמצד עצמם הם חול)"
        },
        {
          "s": 14,
          "text": "לדירה לו ית'."
        },
        {
          "s": 15,
          "text": "ויש להוסיף,"
        },
        {
          "s": 16,
          "text": "דנתינת כח הנ\"ל שנמשך ביו\"ט שני דשמיני עצרת"
        },
        {
          "s": 17,
          "text": "(שמחת תורה)"
        },
        {
          "s": 18,
          "text": "היא שייכת יותר להעולם מההמשכה שביו\"ט ראשון104,"
        },
        {
          "s": 19,
          "text": "מכיון שעוד לפני ההליכה לאהליהם,"
        },
        {
          "s": 20,
          "text": "בשמיני עצרת גופא,"
        },
        {
          "s": 21,
          "text": "נעשה כבר"
        },
        {
          "s": 22,
          "text": "(ביו\"ט שני שבו)"
        },
        {
          "s": 23,
          "text": "הפיכת חול לקודש."
        },
        {
          "s": 24,
          "text": "ולכן מוסיף"
        },
        {
          "s": 25,
          "text": "(בדברי הימים)"
        },
        {
          "s": 26,
          "text": "\"ולשלמה\","
        },
        {
          "s": 27,
          "text": "דהנתינת כח על עבודת הבירורים במשך כל השנה שנמשך מיו\"ט שני דשמיני עצרת"
        },
        {
          "s": 28,
          "text": "[שבו נעשה כבר הענין דהפיכת חול לקודש,"
        },
        {
          "s": 29,
          "text": "ובפרט שביום זה קוראין בתורה בראשית105"
        },
        {
          "s": 30,
          "text": "ברא אלקים את השמים ואת הארץ]"
        },
        {
          "s": 31,
          "text": "הוא באופן שבירור הניצוצות יהי' כמו שהי' בימי שלמה,"
        },
        {
          "s": 32,
          "text": "שעליו נאמר106"
        },
        {
          "s": 33,
          "text": "שלמה יהי' שמו ושלום ושקט אתן על ישראל בימיו,"
        },
        {
          "s": 34,
          "text": "בירור בדרך שלום ומנוחה107."
        },
        {
          "s": 35,
          "text": "וזה נעשה הכנה קרובה לביאת משיח צדקנו,"
        },
        {
          "s": 36,
          "text": "שהוא מזרע דוד ושלמה108,"
        },
        {
          "s": 37,
          "text": "שאז יהי' אמיתית ושלימות השלום,"
        },
        {
          "s": 38,
          "text": "באופן נעלה יותר גם מכמו שהי' בימי שלמה,"
        },
        {
          "s": 39,
          "text": "שהשלום שהי' בימי שלמה הוא שכולם נתבטלו מצד הגילוי אור"
        },
        {
          "s": 40,
          "text": "(אבל לא נהפכו לקדושה),"
        },
        {
          "s": 41,
          "text": "משא\"כ לע\"ל יהי' אהפוך109"
        },
        {
          "s": 42,
          "text": "אל עמים שפה ברורה גו' לעבדו שכם אחד110,"
        },
        {
          "s": 43,
          "text": "בביאת משיח צדקנו בקרוב ממש."
        }
      ]
    }
  ]
}