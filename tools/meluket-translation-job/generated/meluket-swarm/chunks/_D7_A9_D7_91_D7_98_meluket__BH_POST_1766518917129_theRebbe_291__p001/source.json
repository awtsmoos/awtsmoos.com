{
  "globalIndex": 588,
  "owner": 38,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917129_theRebbe_291__p001",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917129_theRebbe_291__p001",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518917129_theRebbe_291",
  "title": "מאמר כי תשא תשל\"א",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ משפטים,"
        },
        {
          "s": 2,
          "text": "פ' שקלים,"
        },
        {
          "s": 3,
          "text": "מבה\"ח אדר ה'תשל\"א"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "כי תשא את ראש בני ישראל לפקודיהם ונתנו איש כופר נפשו גו'1,"
        },
        {
          "s": 1,
          "text": "ואיתא בגמרא2,"
        },
        {
          "s": 2,
          "text": "אמר משה לפני הקב\"ה,"
        },
        {
          "s": 3,
          "text": "רבש\"ע במה תרום קרן ישראל אמר לו בכי תשא,"
        },
        {
          "s": 4,
          "text": "ופירש רש\"י,"
        },
        {
          "s": 5,
          "text": "אם באת לשאת ראשם בהגבהה קח מהם כופר לצדקה."
        },
        {
          "s": 6,
          "text": "ולכאורה,"
        },
        {
          "s": 7,
          "text": "השייכות דכי תשא להרמת קרן ישראל היא,"
        },
        {
          "s": 8,
          "text": "כי תשא הוא"
        },
        {
          "s": 9,
          "text": "(גם)"
        },
        {
          "s": 10,
          "text": "מלשון הגבהה והרמה."
        },
        {
          "s": 11,
          "text": "וצריך להבין,"
        },
        {
          "s": 12,
          "text": "דעפ\"ז,"
        },
        {
          "s": 13,
          "text": "כששאל משה להקב\"ה במה תרום קרן ישראל הי' צריך לכאורה לענות לו בנתינת כופר לצדקה,"
        },
        {
          "s": 14,
          "text": "ומהו פירוש המענה בכי תשא"
        },
        {
          "s": 15,
          "text": "[שהרמת קרן ישראל נעשית ע\"י כי תשא],"
        },
        {
          "s": 16,
          "text": "הרי נשיאת ראש בני ישראל והרמת קרנם הוא היינו הך."
        },
        {
          "s": 17,
          "text": "גם צריך להבין,"
        },
        {
          "s": 18,
          "text": "דבכתוב נאמר ונתנו איש כופר נפשו,"
        },
        {
          "s": 19,
          "text": "שנשיאת"
        },
        {
          "s": 20,
          "text": "(הגבהת והרמת)"
        },
        {
          "s": 21,
          "text": "ראש ישראל היא ע\"י נתינת כופר,"
        },
        {
          "s": 22,
          "text": "ובפרש\"י הנ\"ל אם באת לשאת ראשם בהגבהה קח מהם כופר לצדקה."
        },
        {
          "s": 23,
          "text": "גם צריך להבין,"
        },
        {
          "s": 24,
          "text": "דלשון הכתוב הוא כי תשא את ראש בני ישראל,"
        },
        {
          "s": 25,
          "text": "והלשון בשאלת משה הוא במה תרום קרן ישראל."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והענין הוא,"
        },
        {
          "s": 2,
          "text": "דמבואר בהדרושים"
        },
        {
          "s": 3,
          "text": "(ד\"ה כי תשא את ראש בני ישראל3),"
        },
        {
          "s": 4,
          "text": "דראש הוא אהבה הטבעית שלמעלה מהשכל4,"
        },
        {
          "s": 5,
          "text": "וכתיב5"
        },
        {
          "s": 6,
          "text": "כי עוונותי עברו ראשי גו',"
        },
        {
          "s": 7,
          "text": "שהעוונות מסתירים על בחינת הראש דהנשמה"
        },
        {
          "s": 8,
          "text": "(אהבה הטבעית שלמעלה מהשכל)"
        },
        {
          "s": 9,
          "text": "שלא יאיר בגילוי בכחות הפנימיים."
        },
        {
          "s": 10,
          "text": "וזהו כי תשא את ראש גו',"
        },
        {
          "s": 11,
          "text": "דהגם שבבחינת הראש אין שייך פגם,"
        },
        {
          "s": 12,
          "text": "מ\"מ,"
        },
        {
          "s": 13,
          "text": "זה עצמו שהראש דהנשמה אינו יכול להאיר בגילוי בכחות הפנימיים מורה שנעשה בו ירידה והשפלה6"
        },
        {
          "s": 14,
          "text": "ע\"י העוונות"
        },
        {
          "s": 15,
          "text": "(אלא שהירידה וההשפלה היא לא בנוגע לעצמו ורק בנוגע להגילוי שלו),"
        },
        {
          "s": 16,
          "text": "ולכן צריך לישא את הראש,"
        },
        {
          "s": 17,
          "text": "להגבי' אותו משפלותו."
        }
      ]
    }
  ]
}