{
  "globalIndex": 509,
  "owner": 9,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916754_theRebbe_640__p008",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916754_theRebbe_640__p008",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916754_theRebbe_640",
  "title": "מאמר באתי לגני תשכ\"ח",
  "part": 8,
  "sections": [
    {
      "v": 21,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ג)"
        },
        {
          "s": 2,
          "text": "וביאור הענין"
        },
        {
          "s": 3,
          "text": "(שהשרש דנצח ישראל הוא ברצון שלמעלה גם מטעם כמוס)"
        },
        {
          "s": 4,
          "text": "בפרטיות יותר,"
        },
        {
          "s": 5,
          "text": "יש להקדים מה שבדרושי אדמו\"ר"
        },
        {
          "s": 6,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 7,
          "text": "נ\"ע מבואר הענין דשני רצונות אלו"
        },
        {
          "s": 8,
          "text": "(רצון שיש בו טעם ורצון שאין בו טעם)"
        },
        {
          "s": 9,
          "text": "בשני אופנים."
        },
        {
          "s": 10,
          "text": "דלפעמים91"
        },
        {
          "s": 11,
          "text": "מבואר,"
        },
        {
          "s": 12,
          "text": "שרצון שאין לו טעם כמוס הוא למעלה מרצון שיש לו טעם"
        },
        {
          "s": 13,
          "text": "(כבהמאמר דההילולא),"
        },
        {
          "s": 14,
          "text": "ולפעמים92"
        },
        {
          "s": 15,
          "text": "מבואר,"
        },
        {
          "s": 16,
          "text": "דרצון שאין לו טעם הוא חיצוניות המקיף,"
        },
        {
          "s": 17,
          "text": "והרצון שיש לו טעם הוא פנימיות המקיף"
        },
        {
          "s": 18,
          "text": "(פנימיות הרצון)."
        },
        {
          "s": 19,
          "text": "ונקודת הביאור בזה,"
        },
        {
          "s": 20,
          "text": "דזה שמבואר לפעמים שרצון שיש לו טעם הוא למעלה מרצון שאין לו טעם,"
        },
        {
          "s": 21,
          "text": "הכוונה ב\"טעם\" היא זה שנרגש בו פנימיות הכוונה,"
        },
        {
          "s": 22,
          "text": "שהרצון הוא בישראל דוקא."
        },
        {
          "s": 23,
          "text": "דברצון שאין בו טעם,"
        },
        {
          "s": 24,
          "text": "הכל שוין,"
        },
        {
          "s": 25,
          "text": "איני יודע באיזה מהם חפץ93,"
        },
        {
          "s": 26,
          "text": "ורצון שיש בו טעם הוא שנרגש בו פנימיות הכוונה,"
        },
        {
          "s": 27,
          "text": "שחפץ במעשיהם של צדיקים דוקא."
        }
      ]
    },
    {
      "v": 22,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ד)"
        },
        {
          "s": 2,
          "text": "ויובן זה ע\"פ תורת הרב המגיד94"
        },
        {
          "s": 3,
          "text": "על מארז\"ל95"
        },
        {
          "s": 4,
          "text": "תפילין דמארי96"
        },
        {
          "s": 5,
          "text": "עלמא מה כתיב בהו כו' ומי97"
        },
        {
          "s": 6,
          "text": "כעמך ישראל גו',"
        },
        {
          "s": 7,
          "text": "דאיתא בכתבי האריז\"ל98"
        },
        {
          "s": 8,
          "text": "תפילין נקראים מוחין,"
        },
        {
          "s": 9,
          "text": "דפירוש מוחין"
        },
        {
          "s": 10,
          "text": "(כאן)"
        },
        {
          "s": 11,
          "text": "הוא תענוג."
        },
        {
          "s": 12,
          "text": "דהתענוג דישראל מזה שאנו דבוקים בו ית',"
        },
        {
          "s": 13,
          "text": "ועד אשר וראו כל עמי הארץ כי שם הוי' נקרא עליך99,"
        },
        {
          "s": 14,
          "text": "נקרא תפילין שלנו."
        },
        {
          "s": 15,
          "text": "והתענוג שלו ית' מזה שאנו דבוקים בו ית',"
        },
        {
          "s": 16,
          "text": "ומי כעמך ישראל גוי אחד בארץ,"
        },
        {
          "s": 17,
          "text": "נקרא תפילין שלו."
        },
        {
          "s": 18,
          "text": "והנה תענוג זה"
        },
        {
          "s": 19,
          "text": "(הן התענוג דהקב\"ה והן התענוג דישראל)"
        },
        {
          "s": 20,
          "text": "מזה שאנו דבוקים בו ית',"
        },
        {
          "s": 21,
          "text": "הוא למעלה מהטעם."
        },
        {
          "s": 22,
          "text": "וכמובן מזה שתענוג זה נקרא בשם תפילין,"
        },
        {
          "s": 23,
          "text": "דהוקשו כל המצוות לתפילין100,"
        },
        {
          "s": 24,
          "text": "דהרצון שבמצוות הוא רצון עצמי שלמעלה מהטעם."
        },
        {
          "s": 25,
          "text": "[דנוסף לזה שגם טעמי המצוות"
        },
        {
          "s": 26,
          "text": "(כמו שהם לאמיתתם)"
        },
        {
          "s": 27,
          "text": "הם למעלה מההבנה דשכל אנושי,"
        },
        {
          "s": 28,
          "text": "וכמ\"ש באגה\"ק101"
        },
        {
          "s": 29,
          "text": "שטעמי המצוות לא נתגלו והם למעלה מהשכל וההבנה,"
        },
        {
          "s": 30,
          "text": "וגם באיזהו מקומן שנתגלה ונתפרש איזה טעם המובן לנו לכאורה,"
        },
        {
          "s": 31,
          "text": "אין זה תכלית הטעם,"
        },
        {
          "s": 32,
          "text": "אלא בתוכו מלובש פנימיות ותעלומות חכמה שלמעלה מהשכל וההבנה,"
        },
        {
          "s": 33,
          "text": "הנה הרצון דמצוות הוא רצון עצמי שלמעלה מהטעם,"
        },
        {
          "s": 34,
          "text": "למעלה גם מהטעם דפנימיות ותעלומות חכמה."
        },
        {
          "s": 35,
          "text": "דזהו מה שבקיום המצוות צ\"ל שתי כוונות,"
        },
        {
          "s": 36,
          "text": "כוונה כללית וכוונה פרטית102,"
        },
        {
          "s": 37,
          "text": "שמצד הענין דטעמי המצוות צ\"ל הכוונה פרטית השייכת לאותה המצוה,"
        },
        {
          "s": 38,
          "text": "ומצד הרצון"
        },
        {
          "s": 39,
          "text": "(שלמעלה מטעם)"
        },
        {
          "s": 40,
          "text": "צ\"ל הכוונה כללית לקיים רצון ה']."
        },
        {
          "s": 41,
          "text": "ובפרט במצות תפילין שגם לאחרי שהרצון נתלבש בטעם,"
        },
        {
          "s": 42,
          "text": "ועד לטעם המובן בשכל אנושי,"
        },
        {
          "s": 43,
          "text": "ניכר בו שבשרשו הוא למעלה מהטעם."
        },
        {
          "s": 44,
          "text": "שהרי הכוונה הפרטית דמצות תפילין היא לשעבד הלב והמוח103,"
        },
        {
          "s": 45,
          "text": "הרי מזה גופא מוכח שהיא למעלה ממוח ולב,"
        },
        {
          "s": 46,
          "text": "שלכן ביכלתה לשעבד את המוח והלב."
        },
        {
          "s": 47,
          "text": "וע\"פ המובא לעיל מהמאמר שגם ברצון"
        },
        {
          "s": 48,
          "text": "(חיצוניות הרצון)"
        },
        {
          "s": 49,
          "text": "יש הטעם"
        },
        {
          "s": 50,
          "text": "(כמוס)"
        },
        {
          "s": 51,
          "text": "שבו והמדות שבו,"
        },
        {
          "s": 52,
          "text": "צריך לומר,"
        },
        {
          "s": 53,
          "text": "דתפילין הם למעלה גם מהענין ד\"מוח ולב\" שברצון."
        }
      ]
    },
    {
      "v": 23,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ו)"
        },
        {
          "s": 2,
          "text": "ועפ\"ז מובן,"
        },
        {
          "s": 3,
          "text": "דזה שתפילין נק' מוחין ד\"פירוש מוחין נקרא תענוג\","
        },
        {
          "s": 4,
          "text": "אין הכוונה בזה שהתענוג"
        },
        {
          "s": 5,
          "text": "(דהקב\"ה ודישראל)"
        },
        {
          "s": 6,
          "text": "שנקרא בשם תפילין,"
        },
        {
          "s": 7,
          "text": "הוא מורכב בטעם,"
        },
        {
          "s": 8,
          "text": "כי אם,"
        },
        {
          "s": 9,
          "text": "שתענוג זה הוא תענוג עצמי שלמעלה מהטעם,"
        },
        {
          "s": 10,
          "text": "ולמעלה גם מטעם כמוס,"
        },
        {
          "s": 11,
          "text": "וענין ה\"מוחין\" שבו הוא שנרגש בו הכוונה פנימית,"
        },
        {
          "s": 12,
          "text": "שהתענוג הוא בישראל דוקא."
        }
      ]
    }
  ]
}