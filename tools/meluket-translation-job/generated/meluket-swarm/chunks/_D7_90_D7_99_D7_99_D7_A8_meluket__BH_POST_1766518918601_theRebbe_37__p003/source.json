{
  "globalIndex": 807,
  "owner": 7,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918601_theRebbe_37__p003",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918601_theRebbe_37__p003",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918601_theRebbe_37",
  "title": "מאמר גל עיני ואביטה תשל\"ז",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש לבאר מ\"ש בהמאמר28"
        },
        {
          "s": 1,
          "text": "דפירוש גל עיני ואביטה נפלאות מתורתך הוא שראיית הנפלאות דתורה"
        },
        {
          "s": 2,
          "text": "(נשמתא דאורייתא ונשמתא לנשמתא)"
        },
        {
          "s": 3,
          "text": "תהי' מתורתך,"
        },
        {
          "s": 4,
          "text": "מתורה הנגלית,"
        },
        {
          "s": 5,
          "text": "דלכאורה,"
        },
        {
          "s": 6,
          "text": "הרי העיקר הוא שיראה הנפלאות דתורה,"
        },
        {
          "s": 7,
          "text": "ומהו היתרון בזה שיראה אותם ע\"י הענינים שבגליא דתורה."
        },
        {
          "s": 8,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 9,
          "text": "דכל הענינים שבעולם ושבאדם,"
        },
        {
          "s": 10,
          "text": "התחלתם הוא בתורה29."
        },
        {
          "s": 11,
          "text": "ולכן,"
        },
        {
          "s": 12,
          "text": "ע\"י שראיית הנפלאות דתורה"
        },
        {
          "s": 13,
          "text": "(דהאדם)"
        },
        {
          "s": 14,
          "text": "היא ע\"י ענינים אלה שבגליא דתורה,"
        },
        {
          "s": 15,
          "text": "היינו שהגוף והלבוש דתורה עצמו מגלה את הנשמה והנשמה לנשמה דתורה,"
        },
        {
          "s": 16,
          "text": "עי\"ז נעשה עד\"ז גם בהאדם העוסק בתורה,"
        },
        {
          "s": 17,
          "text": "דזה שרואה את הנפלאות דתורה הוא"
        },
        {
          "s": 18,
          "text": "(גם)"
        },
        {
          "s": 19,
          "text": "מצד ענינו דהאדם."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה שני הענינים הנ\"ל שבביטול הגזירה והמחיצה בין עליונים לתחתונים שנתחדשו במתן תורה הם בכללות יותר תורה ומצוות."
        },
        {
          "s": 2,
          "text": "דענין ירידת העליונים למטה שנתחדש במתן תורה הוא בעיקר בתורה,"
        },
        {
          "s": 3,
          "text": "וענין עליית התחתונים למעלה שנתחדש במתן תורה הוא בעיקר במצוות30."
        },
        {
          "s": 4,
          "text": "והענין הוא,"
        },
        {
          "s": 5,
          "text": "דמהחילוקים בין תורה למצוות הוא31,"
        },
        {
          "s": 6,
          "text": "דהתורה היא דבר ה',"
        },
        {
          "s": 7,
          "text": "חכמתו של הקב\"ה,"
        },
        {
          "s": 8,
          "text": "אלא שירדה למטה ונתלבשה בשכל אנושי בכדי שהאדם יוכל להבינה ולהשיגה,"
        },
        {
          "s": 9,
          "text": "והמצוות שהם ציוויים להאדם,"
        },
        {
          "s": 10,
          "text": "הכוונה והמבוקש בהם היא"
        },
        {
          "s": 11,
          "text": "(לא הציווי עצמו,"
        },
        {
          "s": 12,
          "text": "אלא)"
        },
        {
          "s": 13,
          "text": "קיום הציווי שהאדם מקיים."
        },
        {
          "s": 14,
          "text": "וזהו שהענין דירידת העליונים למטה הוא בעיקר בתורה,"
        },
        {
          "s": 15,
          "text": "דהתורה,"
        },
        {
          "s": 16,
          "text": "שהיא חכמתו של הקב\"ה,"
        },
        {
          "s": 17,
          "text": "מקומה למעלה32,"
        },
        {
          "s": 18,
          "text": "וזה שהתורה ניתנה למטה ונתלבשה בשכל אנושי ובדברים גשמיים הו\"ע ירידת העליונים לתחתונים"
        },
        {
          "s": 19,
          "text": "(משא\"כ בנתינת המצוות למטה אין מודגש כ\"כ הענין דירידת העליונים למטה,"
        },
        {
          "s": 20,
          "text": "שהרי אדרבה,"
        },
        {
          "s": 21,
          "text": "ענינם של המצוות"
        },
        {
          "s": 22,
          "text": "(ציוויים)"
        },
        {
          "s": 23,
          "text": "הוא שהאדם יקיים אותם)."
        },
        {
          "s": 24,
          "text": "וענין התחתונים יעלו לעליונים הוא בעיקר במצוות."
        },
        {
          "s": 25,
          "text": "דבתורה,"
        },
        {
          "s": 26,
          "text": "כיון שגם לאחרי שירדה למטה היא דבר ה',"
        },
        {
          "s": 27,
          "text": "לכן,"
        },
        {
          "s": 28,
          "text": "גם בלימוד ועסק התורה דהאדם נרגש בעיקר ההמשכה מלמעלה,"
        },
        {
          "s": 29,
          "text": "שהתורה שהיא חכמתו של הקב\"ה נמשכת ומתלבשת בשכלו של האדם,"
        },
        {
          "s": 30,
          "text": "ולא הבירור והזיכוך דשכל האדם."
        },
        {
          "s": 31,
          "text": "והענין שהתחתונים יעלו לעליונים מודגש בעיקר במצוות,"
        },
        {
          "s": 32,
          "text": "דכיון שענין המצוות"
        },
        {
          "s": 33,
          "text": "(ציוויים)"
        },
        {
          "s": 34,
          "text": "הוא שהאדם יקיים את המצוות"
        },
        {
          "s": 35,
          "text": "(כנ\"ל),"
        },
        {
          "s": 36,
          "text": "והכוונה בזה היא בכדי לצרף את הבריות33,"
        },
        {
          "s": 37,
          "text": "בכדי לברר ולזכך ולהעלות הכחות והאברים של האדם שמקיים את המצוה וגם את הדברים שבעולם שבהם מקיימים את המצוה ולעשותם כלים לאלקות,"
        },
        {
          "s": 38,
          "text": "ענין המצוות הוא עליית התחתונים למעלה."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "וע\"פ מה שנתבאר לעיל"
        },
        {
          "s": 1,
          "text": "(סעיף ד)"
        },
        {
          "s": 2,
          "text": "שעיקר הכוונה בביטול הגזירה דמתן תורה הוא שהתחתונים יעלו למעלה,"
        },
        {
          "s": 3,
          "text": "וכמו\"כ הוא בנוגע לביטול הגזירה והמחיצה בנוגע לפנימיות התורה"
        },
        {
          "s": 4,
          "text": "(גל עיני ואביטה נפלאות מתורתך)"
        },
        {
          "s": 5,
          "text": "שהעיקר הוא העלי' מלמטלמ\"ע,"
        },
        {
          "s": 6,
          "text": "צריך לומר,"
        },
        {
          "s": 7,
          "text": "דבאביטה נפלאות מתורתך נכלל גם ענין המצוות כמו שהם מצד נשמתא דאורייתא."
        },
        {
          "s": 8,
          "text": "ולכן מביא הצ\"צ פירוש השל\"ה דנפלאות מתורתך הם כוונת המצוות."
        },
        {
          "s": 9,
          "text": "והענין הוא,"
        },
        {
          "s": 10,
          "text": "דבכדי שקיום המצוות יהי' כדבעי הוא ע\"י לימוד התורה,"
        },
        {
          "s": 11,
          "text": "דתלמוד מביא לידי מעשה34."
        },
        {
          "s": 12,
          "text": "ויש לומר,"
        },
        {
          "s": 13,
          "text": "דבכדי שמעשה המצוה"
        },
        {
          "s": 14,
          "text": "(הגוף של המצוה35)"
        },
        {
          "s": 15,
          "text": "יהי' כדבעי הוא ע\"י לימוד גליא דתורה"
        },
        {
          "s": 16,
          "text": "(הגוף דתורה),"
        },
        {
          "s": 17,
          "text": "ובכדי שכוונת המצוות"
        },
        {
          "s": 18,
          "text": "(הנשמה דהמצוות35)"
        },
        {
          "s": 19,
          "text": "תהי' כדבעי הוא ע\"י לימוד פנימיות התורה"
        },
        {
          "s": 20,
          "text": "(נשמתא דאורייתא)."
        }
      ]
    }
  ]
}