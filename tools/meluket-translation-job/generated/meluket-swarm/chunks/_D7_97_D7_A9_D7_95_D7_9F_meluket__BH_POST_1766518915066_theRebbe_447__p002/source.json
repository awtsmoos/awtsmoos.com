{
  "globalIndex": 217,
  "owner": 17,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915066_theRebbe_447__p002",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915066_theRebbe_447__p002",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518915066_theRebbe_447",
  "title": "מאמר ואברהם זקן תשמ\"ו",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "והענין הוא,"
        },
        {
          "s": 1,
          "text": "דפירוש בא בימים הוא"
        },
        {
          "s": 2,
          "text": "(כמבואר בקיצור בתו\"א27"
        },
        {
          "s": 3,
          "text": "ובארוכה באוה\"ת פרשתנו28)"
        },
        {
          "s": 4,
          "text": "שכל ימיו היו שלימין ויומין עילאין ולא חסרא יומא חדא ח\"ו"
        },
        {
          "s": 5,
          "text": "(כדאיתא בזהר29)."
        },
        {
          "s": 6,
          "text": "וזהו פירוש בא בימים,"
        },
        {
          "s": 7,
          "text": "שבא עם כל ימיו."
        },
        {
          "s": 8,
          "text": "וזהו תוכן בא בימים"
        },
        {
          "s": 9,
          "text": "(בפסוק ואברהם ושרה גו' באים בימים,"
        },
        {
          "s": 10,
          "text": "ובפסוק ואברהם זקן בא בימים),"
        },
        {
          "s": 11,
          "text": "שהסך הכל של ימיו עד אז הי' ימים שלימים ומלאים בעבודת ה'."
        },
        {
          "s": 12,
          "text": "ובזה גופא יש ב' אופנים30,"
        },
        {
          "s": 13,
          "text": "שתהי' העבודה באופן דבא בימים והעדר החסרון,"
        },
        {
          "s": 14,
          "text": "אבל מ\"מ ה\"ז במדידה והגבלה,"
        },
        {
          "s": 15,
          "text": "די31"
        },
        {
          "s": 16,
          "text": "מחסורו אשר יחסר לו."
        },
        {
          "s": 17,
          "text": "אמנם למעלה מזה היא העבודה דלמעלה ממדידה והגבלה32,"
        },
        {
          "s": 18,
          "text": "אתה מחוייב לעשרו."
        },
        {
          "s": 19,
          "text": "וזהו החידוש דואברהם זקן בא בימים על מ\"ש ואברהם ושרה זקנים באים בימים,"
        },
        {
          "s": 20,
          "text": "דהכתוב הנ\"ל"
        },
        {
          "s": 21,
          "text": "(ואברהם ושרה גו')"
        },
        {
          "s": 22,
          "text": "הוא שלימות העבודה שבמדידה והגבלה"
        },
        {
          "s": 23,
          "text": "(כי מ\"ש זקנים שם לא קאי על לובן השערות),"
        },
        {
          "s": 24,
          "text": "משא\"כ הפסוק ואברהם זקן בא בימים הוא שלימות העבודה דזקן שלמעלה ממדידה והגבלה."
        },
        {
          "s": 25,
          "text": "וזהו ענין הזקנה שהוא ליבון השערות,"
        },
        {
          "s": 26,
          "text": "דקאי על שערות הזקן,"
        },
        {
          "s": 27,
          "text": "וקשור עם בחי' הזקן שלמעלה,"
        },
        {
          "s": 28,
          "text": "בחי' הדיקנא דעתיק יומין,"
        },
        {
          "s": 29,
          "text": "שיש בזה י\"ג תיקוני דיקנא שהן י\"ג מדות הרחמים,"
        },
        {
          "s": 30,
          "text": "כנ\"ל,"
        },
        {
          "s": 31,
          "text": "דענין מדות הרחמים הוא למעלה ממדידה והגבלה."
        },
        {
          "s": 32,
          "text": "דשערות בכלל ענינם הוא צמצום החיות,"
        },
        {
          "s": 33,
          "text": "ועד שהחיות הוא באופן של הפסק לגמרי"
        },
        {
          "s": 34,
          "text": "(כמובא בדרושים אלה33),"
        },
        {
          "s": 35,
          "text": "והחידוש כאן הוא שהשערות הם בצבע לבן,"
        },
        {
          "s": 36,
          "text": "שזה קשור עם י\"ג תיקוני דיקנא,"
        },
        {
          "s": 37,
          "text": "י\"ג מדות הרחמים,"
        },
        {
          "s": 38,
          "text": "למעלה ממדידה והגבלה לגמרי."
        },
        {
          "s": 39,
          "text": "וזהו החידוש במ\"ש ואברהם זקן בא בימים,"
        },
        {
          "s": 40,
          "text": "שענין בא בימים,"
        },
        {
          "s": 41,
          "text": "שלימות הימים,"
        },
        {
          "s": 42,
          "text": "שהימים מלאים ושלמים,"
        },
        {
          "s": 43,
          "text": "הוא באופן דזקן שלמעלה ממדידה והגבלה לגמרי,"
        },
        {
          "s": 44,
          "text": "עד באופן די\"ג תיקוני דיקנא."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "והנה התורה היא נצחית34"
        },
        {
          "s": 1,
          "text": "וכל הענינים שבה הם הוראות נצחיות לכאו\"א מישראל,"
        },
        {
          "s": 2,
          "text": "ומזה מובן שענין זה הוא הוראה בעבודת כאו\"א מישראל."
        },
        {
          "s": 3,
          "text": "ובפרט שענין זה קאי באברהם אבינו דארז\"ל35"
        },
        {
          "s": 4,
          "text": "אין קורין אבות אלא לשלשה,"
        },
        {
          "s": 5,
          "text": "ומבואר בכ\"מ36"
        },
        {
          "s": 6,
          "text": "דעבודת כל אחד מהשבטים שייכת בעיקר לשבט זה,"
        },
        {
          "s": 7,
          "text": "ובכללות נחלקים ישראל לב' הקוין דיששכר וזבולון,"
        },
        {
          "s": 8,
          "text": "מארי תורה ומארי עובדין טבין37,"
        },
        {
          "s": 9,
          "text": "משא\"כ עבודת האבות שייכת לכאו\"א מישראל."
        },
        {
          "s": 10,
          "text": "(דמכל זה מובן,"
        },
        {
          "s": 11,
          "text": "שהעבודה הנ\"ל דאברהם אבינו"
        },
        {
          "s": 12,
          "text": "(זקן בא בימים)"
        },
        {
          "s": 13,
          "text": "ישנה גם בכאו\"א מישראל)."
        },
        {
          "s": 14,
          "text": "ובפרט שבעבודת התפלה שבכל יום אומרים בתחלת תפלת העמידה ברכה הראשונה הנק' ברכת אבות38,"
        },
        {
          "s": 15,
          "text": "וחותמים הברכה מגן אברהם"
        },
        {
          "s": 16,
          "text": "(היינו שזהו החותם המאמת את כל הדבר)."
        },
        {
          "s": 17,
          "text": "ומה גם שתפלה זו חוזרים ג\"פ בכל יום,"
        },
        {
          "s": 18,
          "text": "וד' פעמים בשבת ויו\"ט וכו' וה' פעמים ביוהכ\"פ."
        },
        {
          "s": 19,
          "text": "וזהו שחותמים מגן אברהם משום שאברהם כולל הכל."
        },
        {
          "s": 20,
          "text": "והיינו,"
        },
        {
          "s": 21,
          "text": "דנוסף לזה שג' התפלות בכלל הן כנגד ג' האבות ונתקנו על ידן39,"
        },
        {
          "s": 22,
          "text": "הנה בפרטיות יותר ישנם ג' אופני העבודה של ג' האבות,"
        },
        {
          "s": 23,
          "text": "אהבה ויראה ורחמים40,"
        },
        {
          "s": 24,
          "text": "בעבודות כל היום כולו."
        },
        {
          "s": 25,
          "text": "וכמבואר בכ\"מ41"
        },
        {
          "s": 26,
          "text": "שהמדות דקדושה הם בהתכללות זו מזו,"
        },
        {
          "s": 27,
          "text": "וגם בפרטיות יותר ע\"פ המבואר בדרושי ספירת העומר42"
        },
        {
          "s": 28,
          "text": "שבה התכללות כאו\"א מז' המדות מז',"
        },
        {
          "s": 29,
          "text": "הנה מזה מובן בכ\"ש וק\"ו לגבי ג' המדות דאהבה יראה ורחמים שהן כלולות זו מזו."
        },
        {
          "s": 30,
          "text": "וזהו ענין ואברהם זקן בא בימים בעבודה,"
        },
        {
          "s": 31,
          "text": "דכשם שהי' באברהם ענין בא בימים,"
        },
        {
          "s": 32,
          "text": "יומין שלימין,"
        },
        {
          "s": 33,
          "text": "וענין ואברהם זקן,"
        },
        {
          "s": 34,
          "text": "זקן זה שקנה חכמה43,"
        },
        {
          "s": 35,
          "text": "וענין י\"ג תיקוני דיקנא,"
        },
        {
          "s": 36,
          "text": "העבודה למעלה ממדידה והגבלה כנ\"ל,"
        },
        {
          "s": 37,
          "text": "וכמבואר בארוכה במאמר בעל יום ההולדת הנ\"ל,"
        },
        {
          "s": 38,
          "text": "הנה עד\"ז צריכים להיות כל ענינים אלו בעבודת כאו\"א מישראל."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ויש להוסיף בזה,"
        },
        {
          "s": 1,
          "text": "דהנה מאמר בעל יום ההולדת הנ\"ל נאמר לפני יותר מתשעים שנה"
        },
        {
          "s": 2,
          "text": "(תרנ\"ד)."
        },
        {
          "s": 3,
          "text": "והנה ארז\"ל במשנה במס' אבות44"
        },
        {
          "s": 4,
          "text": "בן תשעים לשוח45,"
        },
        {
          "s": 5,
          "text": "דענין השיחה קאי על ענין התפלה"
        },
        {
          "s": 6,
          "text": "(כפירוש כמה מפרשי המשנה באבות שם46),"
        },
        {
          "s": 7,
          "text": "וכמ\"ש גם בפרשתנו47"
        },
        {
          "s": 8,
          "text": "ויצא יצחק לשוח בשדה,"
        },
        {
          "s": 9,
          "text": "וארז\"ל39,"
        },
        {
          "s": 10,
          "text": "אין שיחה אלא תפלה,"
        },
        {
          "s": 11,
          "text": "ועד\"ז קאי על ענין לימוד התורה"
        },
        {
          "s": 12,
          "text": "(כמ\"ש במפרשי המשנה46),"
        },
        {
          "s": 13,
          "text": "וכמ\"ש בתהלים בתמניא אפי"
        },
        {
          "s": 14,
          "text": "(מזמור קי\"ט48)"
        },
        {
          "s": 15,
          "text": "מה אהבתי תורתיך כל היום היא שיחתי,"
        },
        {
          "s": 16,
          "text": "וי\"ל הכוונה בזה,"
        },
        {
          "s": 17,
          "text": "דמתחיל מתשעים שנה מתחילה שלימות מיוחדת בלימוד התורה ועבודת התפלה."
        },
        {
          "s": 18,
          "text": "וע\"ד שארז\"ל49"
        },
        {
          "s": 19,
          "text": "עד ארבעין שנין לא קאי איניש אדעתי' דרבי',"
        },
        {
          "s": 20,
          "text": "היינו שמתחילה שלימות מיוחדת בלימוד התורה אחרי ארבעין שנין,"
        },
        {
          "s": 21,
          "text": "עד\"ז מתחילה שלימות מיוחדת באופן הבנת התורה וכו' אחרי תשעים שנה."
        },
        {
          "s": 22,
          "text": "דפשיטא שאין הכוונה בזה שאחרי שהגיע לשנת התשעים אינו יכול לעלות יותר ויותר,"
        },
        {
          "s": 23,
          "text": "אלא הפירוש הוא שבשנת התשעים נוסף עילוי מיוחד,"
        },
        {
          "s": 24,
          "text": "ובזה גופא צריך לעלות בקודש50"
        },
        {
          "s": 25,
          "text": "ולאפשה לה51"
        },
        {
          "s": 26,
          "text": "יותר ויותר"
        },
        {
          "s": 27,
          "text": "(בלימוד התורה)."
        },
        {
          "s": 28,
          "text": "וע\"ד בשנת הארבעים,"
        },
        {
          "s": 29,
          "text": "דמה שארז\"ל עד ארבעין שנין כו' אין הכוונה בזה שכשמגיעה שנת הארבעים אינו יכול לעלות יותר,"
        },
        {
          "s": 30,
          "text": "אלא שאז נוסף עילוי מיוחד,"
        },
        {
          "s": 31,
          "text": "ובו צריך לעלות בקודש ולאפשה וכו'."
        },
        {
          "s": 32,
          "text": "ועוד זאת,"
        },
        {
          "s": 33,
          "text": "דהנה ארז\"ל52"
        },
        {
          "s": 34,
          "text": "שהתלמידים קרויים בנים והרב קרוי אב,"
        },
        {
          "s": 35,
          "text": "ואיתא בגמרא53"
        },
        {
          "s": 36,
          "text": "שיפה כח הבן מכח האב,"
        },
        {
          "s": 37,
          "text": "פירוש,"
        },
        {
          "s": 38,
          "text": "דאף שכל מה שיש לבן הוא מהאב,"
        },
        {
          "s": 39,
          "text": "וזה שיפה כח הבן הוא מכח האב54,"
        },
        {
          "s": 40,
          "text": "בכ\"ז הרי ישנם באב ענינים נעלמים שאינם מתגלים אצלו"
        },
        {
          "s": 41,
          "text": "(ועד שאפשר שהם בהעלם שאינו במציאות),"
        },
        {
          "s": 42,
          "text": "ומתגלים רק אצל הבן."
        },
        {
          "s": 43,
          "text": "והרי ענין זה הוא להלכה"
        },
        {
          "s": 44,
          "text": "(בהלכה?),"
        },
        {
          "s": 45,
          "text": "שיש דברים"
        },
        {
          "s": 46,
          "text": "(הלכות?)"
        },
        {
          "s": 47,
          "text": "שבהם יפה כח הבן מכח האב."
        },
        {
          "s": 48,
          "text": "וכן הוא גם בתלמידים ורב,"
        },
        {
          "s": 49,
          "text": "שיש בכח התלמידים לחדש ענינים בהלכה שלא חידש הרב,"
        },
        {
          "s": 50,
          "text": "היינו שהיו בהעלם אצלו"
        },
        {
          "s": 51,
          "text": "(לגמרי)."
        },
        {
          "s": 52,
          "text": "[דזהו55"
        },
        {
          "s": 53,
          "text": "גם הביאור במארז\"ל56"
        },
        {
          "s": 54,
          "text": "כל מה שתלמיד ותיק עתיד לחדש הכל ניתן למשה מסיני"
        },
        {
          "s": 55,
          "text": "(כמאמר57"
        },
        {
          "s": 56,
          "text": "משה קיבל תורה מסיני כו' היינו שמשה קיבל כל התורה),"
        },
        {
          "s": 57,
          "text": "כי הענינים שנמסרו ע\"י משה יש מהם – בהעלם בתכלית,"
        },
        {
          "s": 58,
          "text": "והתלמיד ותיק מחדשם,"
        },
        {
          "s": 59,
          "text": "מגלה ענינים אלו]."
        },
        {
          "s": 60,
          "text": "דמכל זה מובן ענין בן תשעים לשוח,"
        },
        {
          "s": 61,
          "text": "שכשמגיע זמן של תשעים שנה מתחילה שלימות מיוחדת באופן לימוד התורה וכו'."
        },
        {
          "s": 62,
          "text": "וכן יובן גם בנוגע למאמר דידן והענינים שבו."
        }
      ]
    }
  ]
}