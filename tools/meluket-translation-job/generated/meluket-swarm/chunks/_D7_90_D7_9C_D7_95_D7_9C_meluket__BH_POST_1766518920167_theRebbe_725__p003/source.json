{
  "globalIndex": 1074,
  "owner": 24,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920167_theRebbe_725__p003",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920167_theRebbe_725__p003",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920167_theRebbe_725",
  "title": "מאמר אני לדודי תשכ\"ו",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ומוסיף בהמאמר ומראה פנים שוחקות לכולם,"
        },
        {
          "s": 2,
          "text": "דהחילוק בין מקבל"
        },
        {
          "s": 3,
          "text": "(בסבר פנים יפות)"
        },
        {
          "s": 4,
          "text": "למראה"
        },
        {
          "s": 5,
          "text": "(פנים שוחקות)"
        },
        {
          "s": 6,
          "text": "הוא,"
        },
        {
          "s": 7,
          "text": "דלשון מקבל נופל על דבר שישנו מקודם"
        },
        {
          "s": 8,
          "text": "(לפני שקיבל)"
        },
        {
          "s": 9,
          "text": "והוא מקבל את הדבר,"
        },
        {
          "s": 10,
          "text": "ומראה פנים שוחקות הוא שהפנים שוחקות שלו"
        },
        {
          "s": 11,
          "text": "(שישנם גם לפני שמראה)"
        },
        {
          "s": 12,
          "text": "הוא מראה ומגלה אותם לזולתו."
        },
        {
          "s": 13,
          "text": "וזהו דלאחרי שאומר שהמלך מקבל את כולם בסבר פנים יפות מוסיף שהוא מראה פנים שוחקות לכולם,"
        },
        {
          "s": 14,
          "text": "דזה שהוא מקבלם בסבר פנים יפות הוא שהרצון דהעם"
        },
        {
          "s": 15,
          "text": "(להקביל את פני המלך)"
        },
        {
          "s": 16,
          "text": "מתקבל אצל המלך בסבר פנים יפות,"
        },
        {
          "s": 17,
          "text": "וההוספה דמראה פנים שוחקות הוא דכשמתעורר ברצון לעשות תשובה נמשך לו הגילוי דפנים שוחקות דלמעלה,"
        },
        {
          "s": 18,
          "text": "התענוג"
        },
        {
          "s": 19,
          "text": "(שחוק)"
        },
        {
          "s": 20,
          "text": "דהמלך עצמו."
        },
        {
          "s": 21,
          "text": "דתענוג זה הוא למעלה מהתענוג"
        },
        {
          "s": 22,
          "text": "(דבחינת פנים יפות)"
        },
        {
          "s": 23,
          "text": "שמהתעוררות התשובה,"
        },
        {
          "s": 24,
          "text": "וכמבואר במק\"א20,"
        },
        {
          "s": 25,
          "text": "דשורש השחוק"
        },
        {
          "s": 26,
          "text": "(פנים שוחקות)"
        },
        {
          "s": 27,
          "text": "הוא בעצמות התענוג"
        },
        {
          "s": 28,
          "text": "(תענוג עצמי הבלתי מורכב)"
        },
        {
          "s": 29,
          "text": "שלמעלה מתענוג הבא ע\"י דבר"
        },
        {
          "s": 30,
          "text": "(תענוג המורכב)."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דענין פנים שוחקות בהנמשל הוא התענוג דלמעלה שבישראל עצמם21"
        },
        {
          "s": 2,
          "text": "(שלמעלה מהתענוג שמקיום התורה ומצוות דישראל,"
        },
        {
          "s": 3,
          "text": "ולמעלה גם מהתענוג שמעבודת התשובה)"
        },
        {
          "s": 4,
          "text": "דתענוג זה הוא בהעצמות."
        },
        {
          "s": 5,
          "text": "וע\"י שמראה להם פנים שוחקות,"
        },
        {
          "s": 6,
          "text": "שתענוג זה מתגלה להאדם"
        },
        {
          "s": 7,
          "text": "(המתעורר ברצון לתשובה),"
        },
        {
          "s": 8,
          "text": "זה מעורר אצלו"
        },
        {
          "s": 9,
          "text": "(כמים הפנים לפנים22)"
        },
        {
          "s": 10,
          "text": "התענוג באלקות ועד שהתענוג באלקות הוא עצם התענוג שלו,"
        },
        {
          "s": 11,
          "text": "וזה נותן לו הכח עוד יותר להתגבר על המניעות ועיכובים ולשוב בתשובה שלימה."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וצריך להבין,"
        },
        {
          "s": 2,
          "text": "דמהנ\"ל מובן שהגילוי שבאלול הוא לא רק נתינת כח לעבודה"
        },
        {
          "s": 3,
          "text": "[דכשהמלך בשדה ישנו הרשות והיכולת לכל אחד להקביל את פניו]"
        },
        {
          "s": 4,
          "text": "אלא גם מעורר את האדם"
        },
        {
          "s": 5,
          "text": "[דע\"י שהמלך מקבל את כולם בסבר פנים יפות ובפרט ע\"י שמראה פנים שוחקות לכולם,"
        },
        {
          "s": 6,
          "text": "זה מעורר אותם לשוב בתשובה שלימה],"
        },
        {
          "s": 7,
          "text": "ואעפ\"כ העבודה באלול היא אני לדודי,"
        },
        {
          "s": 8,
          "text": "עבודת האדם."
        }
      ]
    }
  ]
}