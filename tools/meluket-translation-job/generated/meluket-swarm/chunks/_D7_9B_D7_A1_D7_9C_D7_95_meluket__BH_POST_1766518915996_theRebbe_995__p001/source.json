  "owner": 39,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915996_theRebbe_995__p001",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915996_theRebbe_995__p001",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915996_theRebbe_995",
  "title": "מאמר אתה אחד תשל\"ב",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ ויצא,"
        },
        {
          "s": 2,
          "text": "ט' כסלו,"
        },
        {
          "s": 3,
          "text": "ה'תשל\"ב*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "(הנחה בלתי מוגה)"
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "אתה אחד1"
        },
        {
          "s": 1,
          "text": "ושמך אחד ומי כעמך כישראל גוי אחד בארץ כו',"
        },
        {
          "s": 2,
          "text": "הנה נוסח זה אומרים בתפלת מנחה דשבת,"
        },
        {
          "s": 3,
          "text": "רעוא דרעוין."
        },
        {
          "s": 4,
          "text": "וצריך להבין מהי המעלה של תפלת מנחה דשבת על כל התפלות,"
        },
        {
          "s": 5,
          "text": "גם על"
        },
        {
          "s": 6,
          "text": "(שאר)"
        },
        {
          "s": 7,
          "text": "התפלות דשבת גופא,"
        },
        {
          "s": 8,
          "text": "שאז דוקא אומרים אתה אחד כו' דמדבר בקוב\"ה עצמו2."
        },
        {
          "s": 9,
          "text": "ובפרט על פי המבואר בד\"ה זה לבעל ההילולא3"
        },
        {
          "s": 10,
          "text": "דבנוסח זה מבוארים כל המדריגות שבאצילות ולמעלה מאצילות,"
        },
        {
          "s": 11,
          "text": "כל בחי' ההשתלשלות ושלמעלה מהשתלשלות."
        }
      ]
    }
  ]
}