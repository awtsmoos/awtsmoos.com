{
  "globalIndex": 160,
  "owner": 10,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914661_theRebbe_935__p003",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914661_theRebbe_935__p003",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914661_theRebbe_935",
  "title": "מאמר כנשר יעיר קנו תשכ\"ב",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "וביאור הענין,"
        },
        {
          "s": 2,
          "text": "דהנה כתיב27"
        },
        {
          "s": 3,
          "text": "רם על כל גוים הוי' על השמים כבודו,"
        },
        {
          "s": 4,
          "text": "וזהו לפי שיטת אומות העולם שהם חושבים שהבריאה היא בדרך השתלשלות עילה ועלול,"
        },
        {
          "s": 5,
          "text": "שהעילה והעלול הם בערך זה לזה,"
        },
        {
          "s": 6,
          "text": "וכמבואר באגה\"ק28"
        },
        {
          "s": 7,
          "text": "שהעלול יודע ומשיג איזה השגה בעילתו,"
        },
        {
          "s": 8,
          "text": "ועד שגם במהותם ועצמותם אין הפרש גדול כ\"כ רק שזה עילה וזה עלול,"
        },
        {
          "s": 9,
          "text": "ולכן סוברים הם שלהיותו רם ונשא הרי רק על השמים כבודו,"
        },
        {
          "s": 10,
          "text": "ולא על הארץ,"
        },
        {
          "s": 11,
          "text": "כיון שזוהי השפלה לפניו ית' להשפיל את עצמו בעלולים השפלים כמו הארץ וכל אשר בה,"
        },
        {
          "s": 12,
          "text": "שהרי ככל שתתארך ההשתלשלות דעילה ועלול"
        },
        {
          "s": 13,
          "text": "(ווי לאַנג עס זאָל ניט זיין)"
        },
        {
          "s": 14,
          "text": "יהיו העילה והעלול בערך זה לזה."
        },
        {
          "s": 15,
          "text": "אבל האמת היא כפי שיודעים בנ\"י"
        },
        {
          "s": 16,
          "text": "(היינו,"
        },
        {
          "s": 17,
          "text": "שענין זה הוא לא רק באופן של אמונה,"
        },
        {
          "s": 18,
          "text": "אלא נמשך גם בהבנה והשגה)"
        },
        {
          "s": 19,
          "text": "שהתהוות הבריאה אינה בדרך עילה ועלול,"
        },
        {
          "s": 20,
          "text": "אלא בדרך יש מאין,"
        },
        {
          "s": 21,
          "text": "שזהו\"ע שבאין ערוך כלל,"
        },
        {
          "s": 22,
          "text": "והיינו,"
        },
        {
          "s": 23,
          "text": "שגם השמים הם בחי' השפלה,"
        },
        {
          "s": 24,
          "text": "וכמ\"ש29"
        },
        {
          "s": 25,
          "text": "היושבי בשמים,"
        },
        {
          "s": 26,
          "text": "כפי שמדייק בזהר30"
        },
        {
          "s": 27,
          "text": "דהול\"ל היושב בשמים,"
        },
        {
          "s": 28,
          "text": "ומהו אומרו היושבי,"
        },
        {
          "s": 29,
          "text": "בתוספת יו\"ד,"
        },
        {
          "s": 30,
          "text": "אלא שהיו\"ד מורה על קטנות והשפלה יתירה בהוספה על ההשפלה שבכללות ענין הישיבה,"
        },
        {
          "s": 31,
          "text": "כמשל האדם היושב שעי\"ז נשפל מלא קומתו,"
        },
        {
          "s": 32,
          "text": "ועז\"נ31"
        },
        {
          "s": 33,
          "text": "המגביהי לשבת המשפילי לראות בשמים ובארץ,"
        },
        {
          "s": 34,
          "text": "היינו,"
        },
        {
          "s": 35,
          "text": "שלהיותו מגביהי לשבת,"
        },
        {
          "s": 36,
          "text": "לכן הוא משפילי לראות בשמים ובארץ בשוה."
        },
        {
          "s": 37,
          "text": "ומזה מוכח גם בנוגע להענין דהשגחה פרטית,"
        },
        {
          "s": 38,
          "text": "שההשגחה אינה רק על מין המדבר,"
        },
        {
          "s": 39,
          "text": "אלא גם על כל פרטי הנבראים עד לבחי' הדומם,"
        },
        {
          "s": 40,
          "text": "וכידוע תורת הבעש\"ט שנמסרה לנו ע\"י כ\"ק מו\"ח אדמו\"ר נשיא דורנו32,"
        },
        {
          "s": 41,
          "text": "שיש השגחה פרטית אפילו על עלה הנובל מן האילן ומתגלגל ממקום למקום,"
        },
        {
          "s": 42,
          "text": "אם ובאיזה אופן יתגלגל,"
        },
        {
          "s": 43,
          "text": "ועד שענין זה נוגע לכללות הכוונה כו'."
        },
        {
          "s": 44,
          "text": "ויסוד דבר זה הוא מארז\"ל בחולין33"
        },
        {
          "s": 45,
          "text": "ר' יוחנן כי הוה חזי שלך אמר משפטיך תהום רבה,"
        },
        {
          "s": 46,
          "text": "ופירש\"י שזמנתה שלך לשפוט ולעשות נקמתך בדגת הים להמית המזומנים למות."
        },
        {
          "s": 47,
          "text": "וכן איתא במד\"ר פ' וישלח34"
        },
        {
          "s": 48,
          "text": "שגם צפור מבלעדי שמיא לא מתצדא,"
        },
        {
          "s": 49,
          "text": "שב\"ק יוצא ואומר דימוס"
        },
        {
          "s": 50,
          "text": "(לשון רחמים והצלה)"
        },
        {
          "s": 51,
          "text": "או ספקולא"
        },
        {
          "s": 52,
          "text": "(לשון מיתה ועונש)."
        },
        {
          "s": 53,
          "text": "אמנם,"
        },
        {
          "s": 54,
          "text": "מדברי המדרש הנ\"ל אין ראי' כל כך35,"
        },
        {
          "s": 55,
          "text": "ועיקר הראי' היא ממארז\"ל דחולין הנ\"ל,"
        },
        {
          "s": 56,
          "text": "ומזה הביא רבינו הזקן תשובה36"
        },
        {
          "s": 57,
          "text": "להאומרים שההשגחה היא רק במין האדם,"
        },
        {
          "s": 58,
          "text": "שהרי מפורש להדיא שגם על דגי הים יש השגחה פרטית להזמין שלך כדי להמית המזומנים למות."
        },
        {
          "s": 59,
          "text": "והא דאמרו חז\"ל37"
        },
        {
          "s": 60,
          "text": "על הפסוק38"
        },
        {
          "s": 61,
          "text": "ותעשה אדם כדגי הים,"
        },
        {
          "s": 62,
          "text": "מה דגים שבים כל הגדול מחבירו בולע את חבירו אף בני אדם אלמלא מוראה של מלכות איש את רעהו חיים בלעו,"
        },
        {
          "s": 63,
          "text": "אין הכוונה שבליעת הדג ע\"י דג גדול ממנו היא בלא דין ומשפט,"
        },
        {
          "s": 64,
          "text": "אלא ע\"ד שפירש\"י בחולין גבי שלך."
        },
        {
          "s": 65,
          "text": "וראי' לדבר,"
        },
        {
          "s": 66,
          "text": "שהרי מזה הוכיחו בגמרא שגם במין האדם כן הוא,"
        },
        {
          "s": 67,
          "text": "ובמין האדם הכל מודים שיש השגחה פרטית,"
        },
        {
          "s": 68,
          "text": "וא\"כ,"
        },
        {
          "s": 69,
          "text": "הרי זה בא ללמד ונמצא למד,"
        },
        {
          "s": 70,
          "text": "שגם בדגי הים יש השגחה פרטית."
        },
        {
          "s": 71,
          "text": "ומה שאמרו שכדי שלא יהי' איש את רעהו חיים בלעו צריך להיות מוראה של מלכות"
        },
        {
          "s": 72,
          "text": "(ולכן הוי מתפלל בשלומה של מלכות)39,"
        },
        {
          "s": 73,
          "text": "אף שהכל הוא בהשגחה ובדין ומשפט,"
        },
        {
          "s": 74,
          "text": "הרי זה ע\"ד שאמרו40"
        },
        {
          "s": 75,
          "text": "שאסור לעמוד במקום סכנה,"
        },
        {
          "s": 76,
          "text": "סולם רעוע,"
        },
        {
          "s": 77,
          "text": "כותל רעוע וכיו\"ב,"
        },
        {
          "s": 78,
          "text": "כי,"
        },
        {
          "s": 79,
          "text": "כדי להנצל מסכנה יש צורך בריבוי זכיות כו',"
        },
        {
          "s": 80,
          "text": "וכמו כן צריך לשלול את הסכנה דאיש את רעהו חיים בלעו ע\"י התפלה בשלומה של מלכות."
        },
        {
          "s": 81,
          "text": "אמנם,"
        },
        {
          "s": 82,
          "text": "אלה שאינם מאמינים שהקב\"ה משגיח על הנבראים שבארץ,"
        },
        {
          "s": 83,
          "text": "אלא עזב את הארץ בידי המזלות כו',"
        },
        {
          "s": 84,
          "text": "הרי זה ענין של עבודה זרה,"
        },
        {
          "s": 85,
          "text": "שעל זה נצטוו גם אומות העולם."
        },
        {
          "s": 86,
          "text": "ומ\"מ,"
        },
        {
          "s": 87,
          "text": "לא נצטוו אוה\"ע על השיתוף,"
        },
        {
          "s": 88,
          "text": "כי אם בנ\"י,"
        },
        {
          "s": 89,
          "text": "שנצטוו גם לייחדו כו',"
        },
        {
          "s": 90,
          "text": "כנ\"ל."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "וממשיך בהמאמר לבאר שלילת ענין השיתוף בתוספת ביאור,"
        },
        {
          "s": 1,
          "text": "ע\"פ מארז\"ל41"
        },
        {
          "s": 2,
          "text": "שלשה שותפין יש באדם הקב\"ה ואביו ואמו כו',"
        },
        {
          "s": 3,
          "text": "שמזה יובן שענין השיתוף הוא לא רק כאשר חושבים שהם שותפים שוים,"
        },
        {
          "s": 4,
          "text": "אלא גם שותפות שאינה אלא באיזה פרט קל נחשבת לענין של שיתוף שעליו הוזהרו בנ\"י בהציווי לייחדו,"
        },
        {
          "s": 5,
          "text": "כי,"
        },
        {
          "s": 6,
          "text": "השלשה שותפין שבאדם אינם שותפים שוים,"
        },
        {
          "s": 7,
          "text": "שהרי נוסף לכך שחלק האב והאם אינו אלא הגוף"
        },
        {
          "s": 8,
          "text": "(עצמות כו' מהאב ובשר כו' מהאם),"
        },
        {
          "s": 9,
          "text": "ואילו הקב\"ה נותן בו רוח ונשמה,"
        },
        {
          "s": 10,
          "text": "שזהו העיקר,"
        },
        {
          "s": 11,
          "text": "שהרי בצאת הנפש מן הגוף נשאר חלק האב והאם כאבן דומם כו',"
        },
        {
          "s": 12,
          "text": "הנה עוד זאת,"
        },
        {
          "s": 13,
          "text": "גם ציור צורת הולד מחלק האב והאם ע\"י שהיית טפת האב בבטן האם תשעה חדשים,"
        },
        {
          "s": 14,
          "text": "לא נעשה ע\"י האב והאם,"
        },
        {
          "s": 15,
          "text": "בדעתם ורצונם,"
        },
        {
          "s": 16,
          "text": "אלא ע\"י הקב\"ה לבדו,"
        },
        {
          "s": 17,
          "text": "כמארז\"ל42"
        },
        {
          "s": 18,
          "text": "ע\"פ43"
        },
        {
          "s": 19,
          "text": "אין צור כאלקינו,"
        },
        {
          "s": 20,
          "text": "אין צייר כאלקינו שצר צורה בתוך צורה,"
        },
        {
          "s": 21,
          "text": "והוא בכח המפליא לעשות כו'."
        },
        {
          "s": 22,
          "text": "ונמצא,"
        },
        {
          "s": 23,
          "text": "שאע\"פ שחלק האב והאם קטן מאד,"
        },
        {
          "s": 24,
          "text": "מ\"מ יש להם קצת שותפות,"
        },
        {
          "s": 25,
          "text": "שהרי הם בעלי בחירה,"
        },
        {
          "s": 26,
          "text": "ואם לא ינשאו לא יולידו,"
        },
        {
          "s": 27,
          "text": "ומאחר שיש להם קצת שותפות,"
        },
        {
          "s": 28,
          "text": "נקראים שותפים."
        },
        {
          "s": 29,
          "text": "ומזה מובן בנוגע לשלילת ענין השיתוף,"
        },
        {
          "s": 30,
          "text": "שלא זו בלבד ששוללים שותפות חשובה,"
        },
        {
          "s": 31,
          "text": "כדעת אוה\"ע שקרו לי' אלקא דאלקייא"
        },
        {
          "s": 32,
          "text": "(שגם הם נקראים בשם אלקים),"
        },
        {
          "s": 33,
          "text": "אלא שלא שייך שום ענין של שותפות ח\"ו,"
        },
        {
          "s": 34,
          "text": "אפילו לא שותפות קלה ביותר,"
        },
        {
          "s": 35,
          "text": "כי,"
        },
        {
          "s": 36,
          "text": "אע\"פ שההשפעה למטה נמשכת ע\"י הכוכבים ומזלות,"
        },
        {
          "s": 37,
          "text": "ובפרט בזמן הגלות שאז צריכה להיות ההשפעה ע\"י כוכבים ומזלות דוקא44,"
        },
        {
          "s": 38,
          "text": "מ\"מ,"
        },
        {
          "s": 39,
          "text": "אי אפשר לקרותם בשם שותפים כלל,"
        },
        {
          "s": 40,
          "text": "כיון שאינם בעלי בחירה כלל,"
        },
        {
          "s": 41,
          "text": "כי אם שעל ידם עובר השפע שנשפע ברצון הבורא,"
        },
        {
          "s": 42,
          "text": "והם עצמם אינם אלא כגרזן ביד החוצב בו,"
        },
        {
          "s": 43,
          "text": "שלא שייך לומר שהגרזן הוא שותף במלאכת החציבה,"
        },
        {
          "s": 44,
          "text": "לפי שאינו בעל בחירה כלל."
        },
        {
          "s": 45,
          "text": "אמנם,"
        },
        {
          "s": 46,
          "text": "אוה\"ע לא נצטוו על השיתוף,"
        },
        {
          "s": 47,
          "text": "והיינו,"
        },
        {
          "s": 48,
          "text": "לפי שבאוה\"ע כתיב"
        },
        {
          "s": 49,
          "text": "(בפרשת השבוע45)"
        },
        {
          "s": 50,
          "text": "יצב גבולות עמים למספר בנ\"י,"
        },
        {
          "s": 51,
          "text": "ע' נפש יוצאי ירך יעקב,"
        },
        {
          "s": 52,
          "text": "והם מקבלים ההשפעה מע' השרים,"
        },
        {
          "s": 53,
          "text": "וכמ\"ש46"
        },
        {
          "s": 54,
          "text": "אשר חלק ה' אלקיך אותם לכל העמים גו',"
        },
        {
          "s": 55,
          "text": "שלא מנען מלטעות אחריהם47."
        },
        {
          "s": 56,
          "text": "אבל בנ\"י נצטוו על השיתוף,"
        },
        {
          "s": 57,
          "text": "לידע האמת שכל מה שנעשה בעולם אינו אלא ברצונו של הקב\"ה,"
        },
        {
          "s": 58,
          "text": "ואין עוד מלבדו48."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והענין הוא,"
        },
        {
          "s": 2,
          "text": "דהנה כתיב"
        },
        {
          "s": 3,
          "text": "(בפרשת השבוע49)"
        },
        {
          "s": 4,
          "text": "ראו עתה כי אני אני הוא ואין אלקים עמדי גו',"
        },
        {
          "s": 5,
          "text": "והקשה בזהר50,"
        },
        {
          "s": 6,
          "text": "ראו כי אני אני הוא סגי,"
        },
        {
          "s": 7,
          "text": "מאי עתה,"
        },
        {
          "s": 8,
          "text": "והיינו,"
        },
        {
          "s": 9,
          "text": "דמ\"ש אני אני הוא,"
        },
        {
          "s": 10,
          "text": "חיבור ב' הבחי' דאני,"
        },
        {
          "s": 11,
          "text": "הו\"ע יחוד הוי' ואלקים,"
        },
        {
          "s": 12,
          "text": "דהוי' ואלקים כולא חד51"
        },
        {
          "s": 13,
          "text": "(כמשנ\"ת בארוכה במאמרים שלפנ\"ז52),"
        },
        {
          "s": 14,
          "text": "שענין זה יהי' לעתיד לבוא,"
        },
        {
          "s": 15,
          "text": "כמ\"ש53"
        },
        {
          "s": 16,
          "text": "ונשגב הוי' לבדו ביום ההוא,"
        },
        {
          "s": 17,
          "text": "ומהו אומרו ראו עתה,"
        },
        {
          "s": 18,
          "text": "דקאי גם על הזמן דעכשיו"
        },
        {
          "s": 19,
          "text": "(נוסף לכך שכל עניני התורה הם נצחיים)."
        },
        {
          "s": 20,
          "text": "וממשיך בהמאמר ביאור ההפרש בין גן עדן לתחיית המתים,"
        },
        {
          "s": 21,
          "text": "שמזה יובן שעיקר הגילוי דאני אני הוא לעתיד לבוא גופא יהי' בתחיית המתים דוקא,"
        },
        {
          "s": 22,
          "text": "ועפ\"ז יוקשה עוד יותר אומרו ראו עתה."
        },
        {
          "s": 23,
          "text": "והענין בזה,"
        },
        {
          "s": 24,
          "text": "שבג\"ע ישנו ענין של התחלקות,"
        },
        {
          "s": 25,
          "text": "ואין מאיר שם אמיתת ענין האחדות,"
        },
        {
          "s": 26,
          "text": "כי אם בתחיית המתים דוקא."
        },
        {
          "s": 27,
          "text": "דהנה,"
        },
        {
          "s": 28,
          "text": "אע\"פ שגדלה ביותר מעלת ג\"ע,"
        },
        {
          "s": 29,
          "text": "שאינו סובל מציאות הרע,"
        },
        {
          "s": 30,
          "text": "ויתירה מזה,"
        },
        {
          "s": 31,
          "text": "שאינו סובל מציאות הגשמי"
        },
        {
          "s": 32,
          "text": "(כמבואר במק\"א54),"
        },
        {
          "s": 33,
          "text": "מ\"מ,"
        },
        {
          "s": 34,
          "text": "הרי זה ענין של הגבלה והתחלקות,"
        },
        {
          "s": 35,
          "text": "כידוע שכללות הענין דג\"ע נחלק לב' בחינות,"
        },
        {
          "s": 36,
          "text": "ג\"ע התחתון וג\"ע העליון."
        },
        {
          "s": 37,
          "text": "ואף שבפרטיות ישנם ריבוי מדריגות בג\"ע,"
        },
        {
          "s": 38,
          "text": "שעל זה אמרו חז\"ל55"
        },
        {
          "s": 39,
          "text": "צדיקים אין להם מנוחה כו' שנאמר56"
        },
        {
          "s": 40,
          "text": "ילכו מחיל אל חיל,"
        },
        {
          "s": 41,
          "text": "וזהו שהאבות ומשה רבינו הם כבר בג\"ע יותר מג' אלפים שנה והולכים תמיד בעילוי אחר עילוי,"
        },
        {
          "s": 42,
          "text": "מ\"מ,"
        },
        {
          "s": 43,
          "text": "בדרך כלל הם רק ב' בחינות,"
        },
        {
          "s": 44,
          "text": "געה\"ת וגעה\"ע,"
        },
        {
          "s": 45,
          "text": "שהם ב' סוגים בג\"ע."
        },
        {
          "s": 46,
          "text": "וכמובן מזה שכל א' מהם נקרא בשם מיוחד,"
        },
        {
          "s": 47,
          "text": "דלכאורה,"
        },
        {
          "s": 48,
          "text": "כיון שיש ריבוי מדריגות בג\"ע,"
        },
        {
          "s": 49,
          "text": "הרי ממה נפשך,"
        },
        {
          "s": 50,
          "text": "או שכולם נקראים בשם אחד,"
        },
        {
          "s": 51,
          "text": "גן עדן,"
        },
        {
          "s": 52,
          "text": "ואומרים שיש בו ריבוי מדריגות,"
        },
        {
          "s": 53,
          "text": "או שכל מדריגה בפ\"ע נקראת בשם מיוחד."
        },
        {
          "s": 54,
          "text": "וכיון שישנם ריבוי מדריגות בג\"ע,"
        },
        {
          "s": 55,
          "text": "ונקראים בב' שמות,"
        },
        {
          "s": 56,
          "text": "געה\"ת וגעה\"ע,"
        },
        {
          "s": 57,
          "text": "הרי מובן שכללות הענין דג\"ע הוא באופן של התחלקות לב' מדריגות שהם ב' סוגים בג\"ע."
        },
        {
          "s": 58,
          "text": "משא\"כ תחיית המתים הוא בחינה ומדריגה אחת."
        },
        {
          "s": 59,
          "text": "דהנה,"
        },
        {
          "s": 60,
          "text": "אף שגם בעולם התחי' יש כמה חילוקי מדריגות,"
        },
        {
          "s": 61,
          "text": "וכמארז\"ל57"
        },
        {
          "s": 62,
          "text": "שכל אחד ואחד נכוה מחופתו של חבירו,"
        },
        {
          "s": 63,
          "text": "דהיינו,"
        },
        {
          "s": 64,
          "text": "שהמדריגה שהיא בחי' חופה אצל צדיק אחד,"
        },
        {
          "s": 65,
          "text": "שמקפת את כל כחותיו הפנימיים ומתענג בה כו',"
        },
        {
          "s": 66,
          "text": "הנה חבירו נכוה ממנה,"
        },
        {
          "s": 67,
          "text": "שנכוה הו\"ע הפכי כו',"
        },
        {
          "s": 68,
          "text": "וא\"כ,"
        },
        {
          "s": 69,
          "text": "יש גם בעולם התחי' כמה חילוקי מדריגות,"
        },
        {
          "s": 70,
          "text": "מ\"מ,"
        },
        {
          "s": 71,
          "text": "ההתחלקות היא רק במדריגות פרטיות,"
        },
        {
          "s": 72,
          "text": "אבל בכלל הרי זה רק בחינה ומדריגה אחת,"
        },
        {
          "s": 73,
          "text": "משא\"כ בג\"ע שיש בכללו ב' בחינות ומדריגות."
        },
        {
          "s": 74,
          "text": "ושורש הענין הוא,"
        },
        {
          "s": 75,
          "text": "לפי שבג\"ע מאיר רק בחי' אור הממכ\"ע שיש בו חילוקי מדריגות,"
        },
        {
          "s": 76,
          "text": "ולכן יש ב' בחינות,"
        },
        {
          "s": 77,
          "text": "געה\"ת וגעה\"ע,"
        },
        {
          "s": 78,
          "text": "ומצד זה הנה גם סדר עליית הנשמות בג\"ע הוא רק לאחרי הקדמת הדין ומשפט כו',"
        },
        {
          "s": 79,
          "text": "וכמארז\"ל58"
        },
        {
          "s": 80,
          "text": "מוטב דלידייני' כו' וליתי לעלמא דאתי,"
        },
        {
          "s": 81,
          "text": "היינו,"
        },
        {
          "s": 82,
          "text": "שבשביל לבוא לג\"ע צ\"ל הקדמת הבירור וזיכוך בגיהנם,"
        },
        {
          "s": 83,
          "text": "שהם יסורים גדולים ביותר,"
        },
        {
          "s": 84,
          "text": "כמובא באגה\"ת59"
        },
        {
          "s": 85,
          "text": "בשם הרמב\"ן60"
        },
        {
          "s": 86,
          "text": "שאפילו יסורים של איוב ע' שנה אין להם ערך כלל ליסורי הנפש שעה אחת בגיהנם,"
        },
        {
          "s": 87,
          "text": "ואעפ\"כ,"
        },
        {
          "s": 88,
          "text": "כדאי כל יסורי גיהנם בשביל ליתי לעלמא דאתי,"
        },
        {
          "s": 89,
          "text": "מצד גודל התענוג שבג\"ע,"
        },
        {
          "s": 90,
          "text": "אפילו ג\"ע התחתון."
        },
        {
          "s": 91,
          "text": "ועוד זאת,"
        },
        {
          "s": 92,
          "text": "שכדי לעלות מגעה\"ת לגעה\"ע צ\"ל תחילה הטבילה בנהר דינור,"
        },
        {
          "s": 93,
          "text": "והעלי' בהעמוד שבין געה\"ת לגעה\"ע,"
        },
        {
          "s": 94,
          "text": "כידוע61"
        },
        {
          "s": 95,
          "text": "בפירוש הכתוב62"
        },
        {
          "s": 96,
          "text": "ובזה הנערה באה אל המלך."
        },
        {
          "s": 97,
          "text": "ועד שיש נשמות שאינם שייכים ואינם באים לגעה\"ע כלל,"
        },
        {
          "s": 98,
          "text": "וכל עליותיהם הם בגעה\"ת בלבד."
        },
        {
          "s": 99,
          "text": "וכל זה הוא לפי שבג\"ע מאיר בחי' ממכ\"ע שיש בו הגבלה והתחלקות."
        },
        {
          "s": 100,
          "text": "משא\"כ תחיית המתים הוא מבחי' אוא\"ס הסוכ\"ע,"
        },
        {
          "s": 101,
          "text": "שלא שייך בו חילוקי מדריגות,"
        },
        {
          "s": 102,
          "text": "ולכן גם בעולם התחי' אין חילוקי מדריגות,"
        },
        {
          "s": 103,
          "text": "והוא בחי' אחת בדרך כלל,"
        },
        {
          "s": 104,
          "text": "ולכן אמרו63"
        },
        {
          "s": 105,
          "text": "שכל ישראל יש להם חלק לעולם הבא"
        },
        {
          "s": 106,
          "text": "(דקאי על עולם התחי')64."
        },
        {
          "s": 107,
          "text": "וזהו ענין אני אני הוא שיהי' לעתיד בתחיית המתים,"
        },
        {
          "s": 108,
          "text": "שיתחברו ב' בחי' אני להיות רק מדריגה אחת בדרך כלל,"
        },
        {
          "s": 109,
          "text": "לפי שאז יתגלה אמיתית ענין האחדות באופן של העדר ההתחלקות."
        },
        {
          "s": 110,
          "text": "ועפ\"ז יוקשה יותר אומרו ראו עתה כי אני אני הוא,"
        },
        {
          "s": 111,
          "text": "הרי גילוי זה יהי' לעתיד לבוא בתחיית המתים דוקא."
        }
      ]
    }
  ]
}