{
  "globalIndex": 581,
  "owner": 31,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917075_theRebbe_40__p003",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917075_theRebbe_40__p003",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518917075_theRebbe_40",
  "title": "מאמר באתי לגני תשל\"ח",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "וצריך להבין,"
        },
        {
          "s": 1,
          "text": "דמלשון הכתוב"
        },
        {
          "s": 2,
          "text": "(שיש יתרון לחכמה מן הסכלות כיתרון האור מן החושך)"
        },
        {
          "s": 3,
          "text": "משמע,"
        },
        {
          "s": 4,
          "text": "דזה שיתרון האור הוא מן החושך"
        },
        {
          "s": 5,
          "text": "(דע\"י שהחושך נהפך לאור נעשה יתרון בהאור)"
        },
        {
          "s": 6,
          "text": "הוא דבר ידוע,"
        },
        {
          "s": 7,
          "text": "והכתוב מחדש,"
        },
        {
          "s": 8,
          "text": "דכמו\"כ הוא בחכמה וסכלות,"
        },
        {
          "s": 9,
          "text": "שע\"י בירור החכמה דלעו\"ז נעשה יתרון בחכמה דקדושה."
        },
        {
          "s": 10,
          "text": "וצריך ביאור,"
        },
        {
          "s": 11,
          "text": "דלכאורה,"
        },
        {
          "s": 12,
          "text": "לאחרי שיודעים כבר שע\"י בירור הלעו\"ז"
        },
        {
          "s": 13,
          "text": "(חושך)"
        },
        {
          "s": 14,
          "text": "נעשה יתרון בקדושה"
        },
        {
          "s": 15,
          "text": "(אור),"
        },
        {
          "s": 16,
          "text": "מהו החידוש בזה שיש יתרון לחכמה מן הסכלות,"
        },
        {
          "s": 17,
          "text": "ועד שאומר על זה וראיתי אני"
        },
        {
          "s": 18,
          "text": "(שלמה המלך,"
        },
        {
          "s": 19,
          "text": "החכם מכל אדם)."
        },
        {
          "s": 20,
          "text": "וע\"פ הנ\"ל יש לומר,"
        },
        {
          "s": 21,
          "text": "דזה שע\"י שהחושך נהפך לאור נעשה יתרון בהאור הוא בהאור הבא ונמשך ע\"י עבודה,"
        },
        {
          "s": 22,
          "text": "שבזה שייך לומר שהעבודה דאתהפכא חשוכא לנהורא ממשיכה המשכה נעלית יותר מההמשכה שנמשכה ע\"י העבודה בעניני קדושה."
        },
        {
          "s": 23,
          "text": "והחידוש דשלמה"
        },
        {
          "s": 24,
          "text": "(וראיתי אני)"
        },
        {
          "s": 25,
          "text": "הוא,"
        },
        {
          "s": 26,
          "text": "שע\"י בירור והפיכת הלעו\"ז לקדושה נעשה יתרון גם בחכמת התורה."
        },
        {
          "s": 27,
          "text": "דהגם שהמשכת וירידת התורה למטה היא המשכה מצד עצמה,"
        },
        {
          "s": 28,
          "text": "מצד למעלה"
        },
        {
          "s": 29,
          "text": "[וכהלשון מתן תורה,"
        },
        {
          "s": 30,
          "text": "מתנה מלמעלה,"
        },
        {
          "s": 31,
          "text": "שלא מצד עבודת האדם],"
        },
        {
          "s": 32,
          "text": "וגם מה שתלמיד ותיק עתיד לחדש ע\"י היגיעה שלו בעסק התורה כבר ניתן למשה בסיני27"
        },
        {
          "s": 33,
          "text": "(והיגיעה שלו היא לגלות28"
        },
        {
          "s": 34,
          "text": "זה שניתן כבר בדרך מתנה,"
        },
        {
          "s": 35,
          "text": "המשכה מלמעלה),"
        },
        {
          "s": 36,
          "text": "מ\"מ,"
        },
        {
          "s": 37,
          "text": "ע\"י בירור הסכלות דחכמות חיצוניות והפיכתה לחכמה דקדושה"
        },
        {
          "s": 38,
          "text": "[כשלומד חכמה זו29"
        },
        {
          "s": 39,
          "text": "בכדי להוסיף עי\"ז ידיעה בעניני התורה,"
        },
        {
          "s": 40,
          "text": "שעי\"ז מתבררת חכמה זו ונכללת בתורה30],"
        },
        {
          "s": 41,
          "text": "נעשה יתרון בחכמת התורה,"
        },
        {
          "s": 42,
          "text": "למעלה יותר מכמו שהיא מצד עצמה."
        },
        {
          "s": 43,
          "text": "ויתירה מזו,"
        },
        {
          "s": 44,
          "text": "שע\"י הודאת יתרו"
        },
        {
          "s": 45,
          "text": "(קודם מתן תורה)"
        },
        {
          "s": 46,
          "text": "נעשה יתרון גם בכללות הענין דמתן תורה."
        },
        {
          "s": 47,
          "text": "דהגם שמתן תורה היתה בדרך המשכה מלמעלה"
        },
        {
          "s": 48,
          "text": "[דהענינים שבתורה שמתחדשים ע\"י התלמיד ותיק שבכל דור,"
        },
        {
          "s": 49,
          "text": "הגם שהענינים עצמם ניתנו כבר בסיני,"
        },
        {
          "s": 50,
          "text": "המשכתם מהעלם לגילוי היא ע\"י העבודה והיגיעה של התלמיד ותיק,"
        },
        {
          "s": 51,
          "text": "משא\"כ ההמשכה דמתן תורה היתה בדרך המשכה מלמעלה,"
        },
        {
          "s": 52,
          "text": "שלא ע\"י עבודה ויגיעה],"
        },
        {
          "s": 53,
          "text": "מ\"מ,"
        },
        {
          "s": 54,
          "text": "ע\"י הבירור והפיכת החכמה דלעו\"ז לחכמה דקדושה שע\"י הודאת יתרו,"
        },
        {
          "s": 55,
          "text": "נעשה יתרון"
        },
        {
          "s": 56,
          "text": "(כביכול)"
        },
        {
          "s": 57,
          "text": "גם בהתורה שניתנה במתן תורה."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דהיתרון"
        },
        {
          "s": 2,
          "text": "(כביכול)"
        },
        {
          "s": 3,
          "text": "שנעשה בהתורה ע\"י הודאת יתרו הוא,"
        },
        {
          "s": 4,
          "text": "דהתורה מצד עצמה ענינה הוא המשכה מלמעלה,"
        },
        {
          "s": 5,
          "text": "שעבודת המטה אינה מגיעה לשם,"
        },
        {
          "s": 6,
          "text": "ומכש\"כ שהעבודה דהפיכת החושך דלעו\"ז לקדושה אינה מגיעה לשם כי לגבי האור דתורה אין"
        },
        {
          "s": 7,
          "text": "(מלכתחילה)"
        },
        {
          "s": 8,
          "text": "החושך,"
        },
        {
          "s": 9,
          "text": "ועי\"ז שמתן תורה היתה ע\"י הודאת יתרו,"
        },
        {
          "s": 10,
          "text": "נמשך בה העצמות שלמעלה מגדר דמעלה ומטה,"
        },
        {
          "s": 11,
          "text": "אור וחושך,"
        },
        {
          "s": 12,
          "text": "ועי\"ז נתחדש,"
        },
        {
          "s": 13,
          "text": "שע\"י העבודה ויגיעה יוכלו לחדש בתורה31,"
        },
        {
          "s": 14,
          "text": "לאפשה לה32,"
        },
        {
          "s": 15,
          "text": "ושע\"י בירור הסכלות דחכמות חיצוניות יהי' יתרון בחכמת התורה."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וביאור הענין"
        },
        {
          "s": 2,
          "text": "(דהיתרון שנעשה ע\"י שהודה יתרו שגדול הוי' מכל האלקים)"
        },
        {
          "s": 3,
          "text": "בעומק יותר,"
        },
        {
          "s": 4,
          "text": "יובן בהקדים שלכאורה אינו מובן,"
        },
        {
          "s": 5,
          "text": "דלפי פשוטו שהכוונה ב\"מכל האלקים\" היא לע\"ז,"
        },
        {
          "s": 6,
          "text": "כדפירש רש\"י עה\"פ מכל האלקים מלמד שהי' מכיר בכל ע\"ז שבעולם,"
        },
        {
          "s": 7,
          "text": "מהי הרבותא בזה שהודה שהוי' גדול מכל האלקים."
        },
        {
          "s": 8,
          "text": "ויש לומר הביאור ע\"פ מ\"ש הרמב\"ם33"
        },
        {
          "s": 9,
          "text": "שהתחלת ענין ע\"ז הוא מה שחשבו שמכיון שהקב\"ה ברא את הכוכבים והגלגלים להנהיג את העולם והם המשמשים לפניו לכן ראוי לחלוק להם כבוד"
        },
        {
          "s": 10,
          "text": "[וטעותם הי' בזה שחשבו שיש שלטון להכוכבים להשפיע בבחירתם,"
        },
        {
          "s": 11,
          "text": "ולא ידעו האמת שהוא ית' משפיע על ידם כגרזן ביד החוצב34]."
        },
        {
          "s": 12,
          "text": "ומזה יובן,"
        },
        {
          "s": 13,
          "text": "ששלילת ענין ע\"ז שייך לא רק בנוגע לכוכבים ומזלות אלא גם בנוגע לכל המדריגות דסדר ההשתלשלות"
        },
        {
          "s": 14,
          "text": "(מלאכים35,"
        },
        {
          "s": 15,
          "text": "ספירות וכו'36)"
        },
        {
          "s": 16,
          "text": "שעל ידם נמשך השפע למטה."
        },
        {
          "s": 17,
          "text": "ואדרבא,"
        },
        {
          "s": 18,
          "text": "כל שהממוצע הוא נעלה יותר צריך לשלול את הטעות שראוי לחלוק לו כבוד,"
        },
        {
          "s": 19,
          "text": "כי הוא אינו אלא כגרזן ביד החוצב."
        },
        {
          "s": 20,
          "text": "וכמובן גם ממה דאיתא במדרש37"
        },
        {
          "s": 21,
          "text": "משל למלך שנכנס למדינה והיו עמו דוכסין ואפרכין כו',"
        },
        {
          "s": 22,
          "text": "ככל שהשר הוא גדול יותר,"
        },
        {
          "s": 23,
          "text": "ובפרט המשנה למלך,"
        },
        {
          "s": 24,
          "text": "צריך לפקחות יתירה להיות אנא נסיב מלכא."
        },
        {
          "s": 25,
          "text": "וזהו שהודאת יתרו כי גדול הוי' מכל האלקים היתה תלוי' בזה שהי' מכיר כל ע\"ז שבעולם,"
        },
        {
          "s": 26,
          "text": "כי ע\"י שהי' לו ידיעה והכרה בכל סדר ההשתלשלות,"
        },
        {
          "s": 27,
          "text": "עד במדריגה הכי עליונה,"
        },
        {
          "s": 28,
          "text": "עי\"ז דוקא38"
        },
        {
          "s": 29,
          "text": "הי' יכול להיות אצלו הידיעה"
        },
        {
          "s": 30,
          "text": "(עתה ידעתי)"
        },
        {
          "s": 31,
          "text": "כי גדול הוי' מכל האלקים."
        }
      ]
    }
  ]
}