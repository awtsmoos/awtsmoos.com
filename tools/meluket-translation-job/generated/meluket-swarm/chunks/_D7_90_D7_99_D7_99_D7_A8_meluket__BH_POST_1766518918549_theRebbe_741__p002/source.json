{
  "globalIndex": 796,
  "owner": 46,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918549_theRebbe_741__p002",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918549_theRebbe_741__p002",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918549_theRebbe_741",
  "title": "מאמר לה\"ע רשב\"י תשמ\"ה",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "וביאור הענין"
        },
        {
          "s": 1,
          "text": "(השייכות דבחינת איתן לרשב\"י),"
        },
        {
          "s": 2,
          "text": "הנה ידוע,"
        },
        {
          "s": 3,
          "text": "דאיתן קאי על עצם הנשמה17,"
        },
        {
          "s": 4,
          "text": "בחינת יחידה,"
        },
        {
          "s": 5,
          "text": "שהיא מיוחדת באלקות בתכלית היחוד."
        },
        {
          "s": 6,
          "text": "וזוהי השייכות דאיתן לרשב\"י,"
        },
        {
          "s": 7,
          "text": "כי רשב\"י הי' בתכלית היחוד,"
        },
        {
          "s": 8,
          "text": "כמו שאמר על עצמו אנא סימנא בעלמא18,"
        },
        {
          "s": 9,
          "text": "בחד קטירא אתקטרנא בי' בקוב\"ה,"
        },
        {
          "s": 10,
          "text": "בי' אחידא בי' להיטא בי' אתדבקת19"
        },
        {
          "s": 11,
          "text": "[כמבואר בהערות אאמו\"ר20"
        },
        {
          "s": 12,
          "text": "ענין ג' הלשונות],"
        },
        {
          "s": 13,
          "text": "שהוא הביטול והיחוד שמצד היחידה."
        },
        {
          "s": 14,
          "text": "וזהו גם שרשב\"י הי' מקור פנימיות התורה,"
        },
        {
          "s": 15,
          "text": "רזין דאורייתא שהם נשמתא דאורייתא21"
        },
        {
          "s": 16,
          "text": "ורזין דרזין שהם נשמתא דנשמתא22,"
        },
        {
          "s": 17,
          "text": "שבנשמתא לנשמתא נכלל גם בחינת יחידה23."
        },
        {
          "s": 18,
          "text": "ולא עוד אלא שגם לימוד הנגלה שלו"
        },
        {
          "s": 19,
          "text": "(שבזה הי' רוב לימודו24),"
        },
        {
          "s": 20,
          "text": "הי' באופן דלימוד פנימיות התורה,"
        },
        {
          "s": 21,
          "text": "המשכת אלקות מלמעלה למטה25."
        },
        {
          "s": 22,
          "text": "דהנה החילוק בין נגלה דתורה לפנימיות התורה הוא26,"
        },
        {
          "s": 23,
          "text": "שנגלה דתורה נתלבשה בדברים גשמיים בכדי לברר בירורים27,"
        },
        {
          "s": 24,
          "text": "משא\"כ פנימיות התורה היא למעלה מהתלבשות,"
        },
        {
          "s": 25,
          "text": "והלימוד דפנימיות התורה הוא"
        },
        {
          "s": 26,
          "text": "(בעיקר לא בכדי לברר בירורים,"
        },
        {
          "s": 27,
          "text": "כי אם),"
        },
        {
          "s": 28,
          "text": "להמשיך אורות עליונים."
        },
        {
          "s": 29,
          "text": "ואצל רשב\"י,"
        },
        {
          "s": 30,
          "text": "הנה גם בלימוד הנגלה האיר הפנימיות,"
        },
        {
          "s": 31,
          "text": "ועד שגם לימוד הנגלה שלו הי' המשכת אלקות מלמעלה28."
        },
        {
          "s": 32,
          "text": "וזהו העילוי דרשב\"י על שאר התנאים,"
        },
        {
          "s": 33,
          "text": "דכל התנאים,"
        },
        {
          "s": 34,
          "text": "עיקר עסקם הי' או בנגלה דתורה או בנסתר דתורה."
        },
        {
          "s": 35,
          "text": "דרוב התנאים,"
        },
        {
          "s": 36,
          "text": "עיקר עסקם הי' בנגלה דתורה,"
        },
        {
          "s": 37,
          "text": "דמארי קבלה מועטים היו29,"
        },
        {
          "s": 38,
          "text": "ורב יהודה כולי תנויי בנזיקין הוה30,"
        },
        {
          "s": 39,
          "text": "דחלק זה שבתורה נתלבש בדברים הכי תחתונים שבעוה\"ז הגשמי גופא"
        },
        {
          "s": 40,
          "text": "(עניני נזיקין,"
        },
        {
          "s": 41,
          "text": "טענות של שקר וכו'),"
        },
        {
          "s": 42,
          "text": "בכדי לברר גם הניצוצות שבדברים אלו31."
        },
        {
          "s": 43,
          "text": "ואלו שעיקר עסקם הי' בנסתר דתורה,"
        },
        {
          "s": 44,
          "text": "מעשה מרכבה,"
        },
        {
          "s": 45,
          "text": "לא היו עוסקים בנגלה כ\"כ."
        },
        {
          "s": 46,
          "text": "כמו ר' נחוניא בן הקנה שחיבר ספר הקנה32,"
        },
        {
          "s": 47,
          "text": "הרי בנגלה דתורה מובא ממנו רק מעט."
        },
        {
          "s": 48,
          "text": "משא\"כ רשב\"י,"
        },
        {
          "s": 49,
          "text": "הנה נוסף על זה שעסקו בפנימיות התורה הי' באופן נעלה הרבה יותר33,"
        },
        {
          "s": 50,
          "text": "המשיך האור דפנימיות גם בנגלה,"
        },
        {
          "s": 51,
          "text": "כידוע34"
        },
        {
          "s": 52,
          "text": "בענין מחצתי ואני ארפא35"
        },
        {
          "s": 53,
          "text": "שע\"י רשב\"י נתרפאה ונתבטלה המחיצה שבין גליא דתורה לסתים דאורייתא,"
        },
        {
          "s": 54,
          "text": "ועד שהנגלה והנסתר הם חד."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יובן שהעילוי דרשב\"י על כל התנאים הוא עילוי שבאין ערוך,"
        },
        {
          "s": 2,
          "text": "שלכן,"
        },
        {
          "s": 3,
          "text": "בכדי לעורר השפע ממנו הוצרכו לשבחו."
        },
        {
          "s": 4,
          "text": "דהנה העילוי דיחידה על נרנ\"ח הוא עילוי שבאין ערוך,"
        },
        {
          "s": 5,
          "text": "וכמובן גם מזה שנקראת יחידה לשון יחיד,"
        },
        {
          "s": 6,
          "text": "דתואר יחיד מורה שאין שני לו36."
        },
        {
          "s": 7,
          "text": "דהגם שגם יחידה היא"
        },
        {
          "s": 8,
          "text": "(ניצוץ)"
        },
        {
          "s": 9,
          "text": "נברא,"
        },
        {
          "s": 10,
          "text": "וכל ה' הדרגות"
        },
        {
          "s": 11,
          "text": "(גם יחידה)"
        },
        {
          "s": 12,
          "text": "שייכים להנפש שמלובשת בהגוף ובאופן דשם כמאמר37"
        },
        {
          "s": 13,
          "text": "חמשה שמות נקראו לה"
        },
        {
          "s": 14,
          "text": "(להנפש שבגוף),"
        },
        {
          "s": 15,
          "text": "אעפ\"כ,"
        },
        {
          "s": 16,
          "text": "הרי ענינה של יחידה הוא מה שהיא מקבלת מבחינת יחיד38,"
        },
        {
          "s": 17,
          "text": "ניצוץ נברא שענינו הוא מה שבו מתלבש ניצוץ בורא39."
        },
        {
          "s": 18,
          "text": "ומזה מובן במכ\"ש בענין יחידה הכללית"
        },
        {
          "s": 19,
          "text": "(דכללות ההשתלשלות ומכ\"ש)"
        },
        {
          "s": 20,
          "text": "דתורה,"
        },
        {
          "s": 21,
          "text": "שהיא נעלית באין ערוך אפילו מנשמתא דאורייתא,"
        },
        {
          "s": 22,
          "text": "ועאכו\"כ מגופא דאורייתא,"
        },
        {
          "s": 23,
          "text": "היינו ההלכות דתורה שנק'40"
        },
        {
          "s": 24,
          "text": "גופי תורה."
        },
        {
          "s": 25,
          "text": "ולכן,"
        },
        {
          "s": 26,
          "text": "בכדי לעורר השפע דרשב\"י"
        },
        {
          "s": 27,
          "text": "(בחינת איתן,"
        },
        {
          "s": 28,
          "text": "יחידה),"
        },
        {
          "s": 29,
          "text": "ובפרט בחינת הפנימיות שבזה"
        },
        {
          "s": 30,
          "text": "(העלם שלצורך עצמו41),"
        },
        {
          "s": 31,
          "text": "שיומשך בלימוד התורה"
        },
        {
          "s": 32,
          "text": "(נגלה דתורה,"
        },
        {
          "s": 33,
          "text": "ועד לנזיקין)"
        },
        {
          "s": 34,
          "text": "דהתנאים שהלימוד שלהם42"
        },
        {
          "s": 35,
          "text": "הי' באופן דהתלבשות לברר בירורים,"
        },
        {
          "s": 36,
          "text": "הוצרכו לשבחו,"
        },
        {
          "s": 37,
          "text": "כי בכדי לעורר השפעה שבאין ערוך הוא ע\"י קדימת השבחים,"
        },
        {
          "s": 38,
          "text": "כנ\"ל."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "אך צריך להבין,"
        },
        {
          "s": 2,
          "text": "מכיון שרשב\"י הי' מובדל בערך משאר התנאים איך יפעלו עליו השבחים שלהם ועד לעורר ולחדש ההשפעה אליהם."
        },
        {
          "s": 3,
          "text": "וביותר אינו מובן מענין השבחים שמשבחים את הבורא,"
        },
        {
          "s": 4,
          "text": "בכדי לעורר הרצון להשפיע לנבראים,"
        },
        {
          "s": 5,
          "text": "הרי התעוררות הרצון הוא בעצמות אוא\"ס שלמעלה מהשתלשלות"
        },
        {
          "s": 6,
          "text": "[כמובן מהמבואר בכ\"מ43"
        },
        {
          "s": 7,
          "text": "דע\"י השבחים מעוררים הרצון שיומשך ויתלבש בהספירות],"
        },
        {
          "s": 8,
          "text": "והיאך שייך שהשבחים שלנו יתפסו מקום בעצמות אוא\"ס."
        },
        {
          "s": 9,
          "text": "וידוע הענין בזה44,"
        },
        {
          "s": 10,
          "text": "דזה שהעלאת מ\"ן דהנבראים"
        },
        {
          "s": 11,
          "text": "(כולל ענין השבחים45)"
        },
        {
          "s": 12,
          "text": "מעוררת ההמשכה,"
        },
        {
          "s": 13,
          "text": "הוא לפי שכן עלה ברצונו ית' שהעלאת מ\"ן דהנבראים תתפוס מקום אצלו ית'."
        },
        {
          "s": 14,
          "text": "ולא עוד אלא שע\"י העלאת מ\"ן דהנבראים יהי' שינוי כביכול בהאור,"
        },
        {
          "s": 15,
          "text": "שיומשך למטה למקום שאין ערוך כלל,"
        },
        {
          "s": 16,
          "text": "אף שמצד עצמו הוא מובדל מזה."
        },
        {
          "s": 17,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 18,
          "text": "דמכיון שנתאוה הקב\"ה להיות לו ית' דירה בתחתונים46,"
        },
        {
          "s": 19,
          "text": "דענין נתאוה הוא למעלה מהטעם כמאמר אדה\"ז47"
        },
        {
          "s": 20,
          "text": "אויף אַ תאוה איז קיין קשיא,"
        },
        {
          "s": 21,
          "text": "הנה להיות שהתאוה והתענוג דלמעלה הוא דירה בתחתונים,"
        },
        {
          "s": 22,
          "text": "בתחתון שאין תחתון למטה ממנו48,"
        },
        {
          "s": 23,
          "text": "לכן העלאת מ\"ן דהנבראים פועלת בהאור49."
        },
        {
          "s": 24,
          "text": "ולכאורה יש להוסיף,"
        },
        {
          "s": 25,
          "text": "דזהו גם מה שרובם ככולם של השבחים"
        },
        {
          "s": 26,
          "text": "(בסידור שבחו של מקום בפסוקי דזמרה קודם התפלה)"
        },
        {
          "s": 27,
          "text": "הם בענין השפעתו ית' בנבראים,"
        },
        {
          "s": 28,
          "text": "כי"
        },
        {
          "s": 29,
          "text": "[נוסף לזה שהשבח צ\"ל מעין השפע שרוצים לעורר,"
        },
        {
          "s": 30,
          "text": "ובכדי לעורר ההשפעה למטה צ\"ל השבחים בענין זה,"
        },
        {
          "s": 31,
          "text": "הנה]"
        },
        {
          "s": 32,
          "text": "ע\"י שמשבחים לפניו ית' השפעתו לנבראים התחתונים,"
        },
        {
          "s": 33,
          "text": "עי\"ז מעוררים ומגלים התענוג בדירה בתחתונים."
        }
      ]
    }
  ]
}