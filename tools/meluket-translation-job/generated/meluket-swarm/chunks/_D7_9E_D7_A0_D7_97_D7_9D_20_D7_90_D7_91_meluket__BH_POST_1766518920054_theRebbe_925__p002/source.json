{
  "globalIndex": 1064,
  "owner": 14,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518920054_theRebbe_925__p002",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518920054_theRebbe_925__p002",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518920054_theRebbe_925",
  "title": "מאמר והי' עקב תשמעון תשט\"ז",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "והנה בתיבת תשמעון יש ג' פירושים."
        },
        {
          "s": 1,
          "text": "תשמעון מלשון הבנה,"
        },
        {
          "s": 2,
          "text": "כמ\"ש4"
        },
        {
          "s": 3,
          "text": "דבר כי שומע עבדך."
        },
        {
          "s": 4,
          "text": "תשמעון מלשון אסיפה,"
        },
        {
          "s": 5,
          "text": "כמ\"ש5"
        },
        {
          "s": 6,
          "text": "וישמע שאול את העם."
        },
        {
          "s": 7,
          "text": "ותשמעון כפשוטו מלשון שמיעה,"
        },
        {
          "s": 8,
          "text": "דענין השמיעה שייך למחשבה,"
        },
        {
          "s": 9,
          "text": "שהרי האוזן היא רק הכלי שעל ידו שומעים,"
        },
        {
          "s": 10,
          "text": "אבל השמיעה גופא היא במחשבה,"
        },
        {
          "s": 11,
          "text": "וענין השמיעה שייך גם לדיבור,"
        },
        {
          "s": 12,
          "text": "שהרי שומעים מה שמדברים."
        },
        {
          "s": 13,
          "text": "וזהו מ\"ש תשמעון ושמרתם ועשיתם,"
        },
        {
          "s": 14,
          "text": "דתשמעון הוא מחשבה,"
        },
        {
          "s": 15,
          "text": "וכנ\"ל שהשמיעה היא במחשבה,"
        },
        {
          "s": 16,
          "text": "ושמרתם הוא דיבור,"
        },
        {
          "s": 17,
          "text": "כמאמר6"
        },
        {
          "s": 18,
          "text": "שמור זה משנה,"
        },
        {
          "s": 19,
          "text": "והוא הפסק הלכה כפי שבא בדיבור,"
        },
        {
          "s": 20,
          "text": "דכאשר השכל הוא במחשבה,"
        },
        {
          "s": 21,
          "text": "אזי הוא בהעלם עדיין,"
        },
        {
          "s": 22,
          "text": "דישנם פנים להיתר וטהור ויש פנים להיפך7,"
        },
        {
          "s": 23,
          "text": "משא\"כ כאשר השכל בא בגילוי בדיבור,"
        },
        {
          "s": 24,
          "text": "אזי ישנו פסק ההלכה."
        },
        {
          "s": 25,
          "text": "ואז לא תהי' יניקה לחיצונים,"
        },
        {
          "s": 26,
          "text": "דכאשר הוא בהעלם עדיין אפשר להיות יניקה,"
        },
        {
          "s": 27,
          "text": "אבל כאשר בא בגילוי אזי אין להם יניקה."
        },
        {
          "s": 28,
          "text": "וזהו שמור זה משנה,"
        },
        {
          "s": 29,
          "text": "שהמשנה שענינה גילוי השכל בדיבור היא שמירה שלא יהי' יניקה כו'."
        },
        {
          "s": 30,
          "text": "ועשיתם הוא מעשה."
        },
        {
          "s": 31,
          "text": "והיינו שתשמעון ושמרתם ועשיתם הם מחשבה דיבור ומעשה."
        },
        {
          "s": 32,
          "text": "וההתחלה בזה היא מבחי' מחדומ\"ע שבמחשבה גופא,"
        },
        {
          "s": 33,
          "text": "שזהו ג' הפירושים שבתיבת תשמעון,"
        },
        {
          "s": 34,
          "text": "דשמיעה מלשון הבנה היינו מחשבה שבמחשבה,"
        },
        {
          "s": 35,
          "text": "ושמיעה מלשון אסיפה היינו מעשה שבמחשבה,"
        },
        {
          "s": 36,
          "text": "ושמיעה כפשוטו היינו דיבור שבמחשבה,"
        },
        {
          "s": 37,
          "text": "ששומע מה שמדברים."
        },
        {
          "s": 38,
          "text": "וזהו והי' עקב תשמעון גו',"
        },
        {
          "s": 39,
          "text": "דכאשר תשמעון בבחי' מחדומ\"ע שבמחשבה,"
        },
        {
          "s": 40,
          "text": "ואח\"כ תשמעון ושמרתם ועשיתם במחדומ\"ע ממש,"
        },
        {
          "s": 41,
          "text": "הנה עי\"ז ושמר ה\"א לך את הברית ואת החסד אשר נשבע,"
        },
        {
          "s": 42,
          "text": "דג' ענינים אלו"
        },
        {
          "s": 43,
          "text": "(ברית חסד ושבועה)"
        },
        {
          "s": 44,
          "text": "הם ההמשכה שמלמעלה."
        },
        {
          "s": 45,
          "text": "דברית הוא מעשה,"
        },
        {
          "s": 46,
          "text": "דענין הכריתת ברית הוא שכורתין דבר שלם לשנים ועוברים ביניהם8,"
        },
        {
          "s": 47,
          "text": "שעי\"ז תהי' האהבה ביניהם בתמידות,"
        },
        {
          "s": 48,
          "text": "גם במצב שלא יהי' טעם על האהבה,"
        },
        {
          "s": 49,
          "text": "לא מצד בחי' הדיבור,"
        },
        {
          "s": 50,
          "text": "ואפילו לא מצד בחי' המחשבה,"
        },
        {
          "s": 51,
          "text": "ואעפ\"כ תהי' האהבה מצד הכר\"ב שהו\"ע של מעשה בפועל."
        },
        {
          "s": 52,
          "text": "וחסד הוא מחשבה,"
        },
        {
          "s": 53,
          "text": "שהרי החסד הוא הרגש הלב והמוח,"
        },
        {
          "s": 54,
          "text": "ולכן הוא בכלל מחשבה."
        },
        {
          "s": 55,
          "text": "ובפרט שכאן נאמר ושמר את החסד,"
        },
        {
          "s": 56,
          "text": "כמבואר9"
        },
        {
          "s": 57,
          "text": "החילוק בין עושה חסד לנוצר חסד,"
        },
        {
          "s": 58,
          "text": "דעושה חסד הוא עשיית החסד,"
        },
        {
          "s": 59,
          "text": "ונוצר חסד הוא ששומר את החסד בלבבו ובמחשבתו."
        },
        {
          "s": 60,
          "text": "ושבועה הוא דיבור."
        },
        {
          "s": 61,
          "text": "וזהו והי' עקב גו' דכאשר תהי' העבודה מלמטה למעלה במחשבה דיבור ומעשה,"
        },
        {
          "s": 62,
          "text": "אזי תהי' המשכת המחשבה דיבור ומעשה מלמעלה למטה."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "וצריך להבין טעם שינוי הסדר,"
        },
        {
          "s": 1,
          "text": "שבעבודה מלמטה למעלה נאמרו המחדומ\"ע כסדרם,"
        },
        {
          "s": 2,
          "text": "תחילה מחשבה ואח\"כ דיבור ומעשה,"
        },
        {
          "s": 3,
          "text": "ובהמשכה מלמעלה למטה נאמר תחלה מעשה ואח\"כ מחשבה ודיבור."
        },
        {
          "s": 4,
          "text": "דלכאורה,"
        },
        {
          "s": 5,
          "text": "מאחר שההמשכה שמלמעלה באה ע\"י עבודת האדם,"
        },
        {
          "s": 6,
          "text": "א\"כ הי' צ\"ל סדר ההמשכה מלמעלה כפי סדר העבודה,"
        },
        {
          "s": 7,
          "text": "ומהו הטעם שבעבודה הסדר הוא שמעשה בא אחרי מחשבה ודיבור,"
        },
        {
          "s": 8,
          "text": "ובההמשכה מלמעלה בא המעשה קודם למחשבה ודיבור."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והענין הוא,"
        },
        {
          "s": 2,
          "text": "דהנה כללות עבודת האדם באה ע\"י ההתבוננות,"
        },
        {
          "s": 3,
          "text": "דנקודת העבודה היא כמאמרז\"ל10"
        },
        {
          "s": 4,
          "text": "איזהו עבודה שבלב זו תפלה,"
        },
        {
          "s": 5,
          "text": "וקודם לזה ההתבוננות דק\"ש וברכות ק\"ש וכו',"
        },
        {
          "s": 6,
          "text": "וכתוב11"
        },
        {
          "s": 7,
          "text": "שמע ישראל הוי' אלקינו הוי' אחד,"
        },
        {
          "s": 8,
          "text": "הנה הא' דאחד מורה על א\"ס אלופו של עולם,"
        },
        {
          "s": 9,
          "text": "והח' מורה על ז' רקיעים וארץ,"
        },
        {
          "s": 10,
          "text": "והד' מורה על ד' סטרין12."
        },
        {
          "s": 11,
          "text": "והנה,"
        },
        {
          "s": 12,
          "text": "הד' הוא ד' רבתי,"
        },
        {
          "s": 13,
          "text": "והוא בחי' גדלות הדיבור."
        },
        {
          "s": 14,
          "text": "דדל\"ת הוא בחי' הדיבור,"
        },
        {
          "s": 15,
          "text": "וד' רבתי הוא גדלות הדיבור,"
        },
        {
          "s": 16,
          "text": "והוא בחי' הדיבור כמו שהוא במחשבה."
        },
        {
          "s": 17,
          "text": "והענין הוא עד\"מ כמו שאנו רואים באדם למטה,"
        },
        {
          "s": 18,
          "text": "שכל פרטי הדיבורים כלולים תחילה במחשבתו,"
        },
        {
          "s": 19,
          "text": "במחשבה אחת,"
        },
        {
          "s": 20,
          "text": "דמחשבה אחת זו היא מקור כל הדיבורים הפרטיים,"
        },
        {
          "s": 21,
          "text": "ולא זו בלבד שהמחשבה היא מקורם,"
        },
        {
          "s": 22,
          "text": "אלא שהמחשבה כוללת בתוכה כל פרטי הדיבורים גם לאחר שנמשכו ממנה."
        },
        {
          "s": 23,
          "text": "ועד\"ז יובן גם למעלה,"
        },
        {
          "s": 24,
          "text": "שכל פרטי העשרה מאמרות כלולים תחילה בבחי' מחשבה אחת הכוללת אותם13,"
        },
        {
          "s": 25,
          "text": "והוא בחי' המאמר דבראשית,"
        },
        {
          "s": 26,
          "text": "כמארז\"ל14"
        },
        {
          "s": 27,
          "text": "בראשית נמי מאמר הוא,"
        },
        {
          "s": 28,
          "text": "דמלשון זה מובן ב' הפכים,"
        },
        {
          "s": 29,
          "text": "דמחד גיסא מובן שהמאמר דבראשית הוא בכלל המאמרות,"
        },
        {
          "s": 30,
          "text": "ולאידך גיסא מובן שהוא למעלה מהם,"
        },
        {
          "s": 31,
          "text": "שהרי צריך להודעה דנמי מאמר הוא,"
        },
        {
          "s": 32,
          "text": "לפי שהמאמר דבראשית הוא למעלה משאר המאמרות,"
        },
        {
          "s": 33,
          "text": "והוא בחי' המאמרות כמו שהם כלולים בהמחשבה."
        },
        {
          "s": 34,
          "text": "וזהו שאמרו15"
        },
        {
          "s": 35,
          "text": "והלא במאמר אחד יכול להבראות,"
        },
        {
          "s": 36,
          "text": "דמאמר אחד קאי על המאמר דבראשית שהוא כולל בתוכו כל שאר המאמרות,"
        },
        {
          "s": 37,
          "text": "ולכן הנה ממאמר אחד דבראשית יכול להבראות כל הבריאה."
        },
        {
          "s": 38,
          "text": "וזהו בחי' ד' רבתי שהו\"ע פרטי המאמרות כמו שהם כלולים בהמחשבה אחת הכוללת אותם,"
        },
        {
          "s": 39,
          "text": "שהוא גדלות הדיבור,"
        },
        {
          "s": 40,
          "text": "שהרי אין זה אמיתית ענין המחשבה,"
        },
        {
          "s": 41,
          "text": "כי אם ענין הדיבור,"
        },
        {
          "s": 42,
          "text": "אלא שהוא הדיבור כמו שהוא כלול עדיין בהמחשבה,"
        },
        {
          "s": 43,
          "text": "שזהו בחי' גדלות הדיבור."
        },
        {
          "s": 44,
          "text": "וזהו\"ע הוי' אחד,"
        },
        {
          "s": 45,
          "text": "שהוא הביטול כמו שהוא מצד בחי' ד' רבתי,"
        },
        {
          "s": 46,
          "text": "גדלות הדיבור."
        }
      ]
    }
  ]
}