{
  "globalIndex": 855,
  "owner": 5,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918840_theRebbe_178__p002",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918840_theRebbe_178__p002",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918840_theRebbe_178",
  "title": "מאמר רני ושמחי תשכ\"ז",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה בתו\"א שם בד\"ה רני ושמחי הראשון6"
        },
        {
          "s": 2,
          "text": "מקשר הפסוק רני ושמחי בת ציון עם מאמר המדרש7"
        },
        {
          "s": 3,
          "text": "(עה\"פ8"
        },
        {
          "s": 4,
          "text": "צאינה וראינה בנות ציון במלך שלמה בעטרה שעטרה לו אמו),"
        },
        {
          "s": 5,
          "text": "משל למלך כו' לא זז מחבבה9"
        },
        {
          "s": 6,
          "text": "עד שקראה בתי כו' לא זז מחבבה עד שקראה אחותי כו' לא זז מחבבה עד שקראה אמי."
        },
        {
          "s": 7,
          "text": "ומבאר שם10,"
        },
        {
          "s": 8,
          "text": "דג' ענינים אלה"
        },
        {
          "s": 9,
          "text": "(בתי אחותי אמי)"
        },
        {
          "s": 10,
          "text": "בעבודת האדם הם קיום המצוות11"
        },
        {
          "s": 11,
          "text": "עסק התורה והעבודה דמסירת נפש."
        },
        {
          "s": 12,
          "text": "דבקיום המצוות האדם המקיים את המצוה הוא בחי' מקבל"
        },
        {
          "s": 13,
          "text": "(בת),"
        },
        {
          "s": 14,
          "text": "שהוא מקבל את ההמשכה שנמשכת ע\"י קיום המצוה."
        },
        {
          "s": 15,
          "text": "וע\"י עסק התורה נעשים ישראל אחים ורעים להקב\"ה"
        },
        {
          "s": 16,
          "text": "(אחותי)."
        },
        {
          "s": 17,
          "text": "וע\"י העבודה דמס\"נ נק' בשם אמי,"
        },
        {
          "s": 18,
          "text": "שהם משפיעים כביכול בהקב\"ה."
        },
        {
          "s": 19,
          "text": "ויש לקשר זה עם המבואר בכ\"מ12"
        },
        {
          "s": 20,
          "text": "עה\"פ בעטרה שעטרה לו אמו,"
        },
        {
          "s": 21,
          "text": "דהעטרה שעטרה כנס\"י"
        },
        {
          "s": 22,
          "text": "(אמו)"
        },
        {
          "s": 23,
          "text": "להקב\"ה הוא ע\"י שהקדימו נעשה לנשמע,"
        },
        {
          "s": 24,
          "text": "כי הביטול דהקדמת נעשה לנשמע הוא כהביטול דמס\"נ13."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דמהטעמים שקוראין פרשת בהעלותך את הנרות לאחרי חג השבועות14"
        },
        {
          "s": 2,
          "text": "הוא,"
        },
        {
          "s": 3,
          "text": "כי נרות קאי על נשמות ישראל כמ\"ש15"
        },
        {
          "s": 4,
          "text": "נר הוי' נשמת אדם16,"
        },
        {
          "s": 5,
          "text": "דפירוש נר הוי' הוא שהנשמה מאירה"
        },
        {
          "s": 6,
          "text": "(משפעת)"
        },
        {
          "s": 7,
          "text": "כביכול להוי'17,"
        },
        {
          "s": 8,
          "text": "וכדאיתא במדרש18"
        },
        {
          "s": 9,
          "text": "עה\"פ בהעלותך את הנרות שישראל מאירין למי שמאיר לכל העולם,"
        },
        {
          "s": 10,
          "text": "וענין זה שייך לחג השבועות,"
        },
        {
          "s": 11,
          "text": "עטרה שעטרה לו אמו."
        },
        {
          "s": 12,
          "text": "ועפ\"ז צריך להבין עוד יותר מה שההפטורה דש\"פ בהעלותך את הנרות"
        },
        {
          "s": 13,
          "text": "(ענין אמי)"
        },
        {
          "s": 14,
          "text": "הוא רני ושמחי בת ציון."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והענין הוא,"
        },
        {
          "s": 2,
          "text": "שההמשכה שע\"י קיום המצוות,"
        },
        {
          "s": 3,
          "text": "בתי,"
        },
        {
          "s": 4,
          "text": "היא המשכה נעלית יותר מההמשכה שע\"י העבודה דאחותי ואמי."
        },
        {
          "s": 5,
          "text": "כי העבודה דמסירת נפש"
        },
        {
          "s": 6,
          "text": "(אמי),"
        },
        {
          "s": 7,
          "text": "ועד\"ז עסק התורה"
        },
        {
          "s": 8,
          "text": "(אחותי),"
        },
        {
          "s": 9,
          "text": "מכיון שהיא עבודה רוחנית,"
        },
        {
          "s": 10,
          "text": "יש לה שייכות לההמשכה שנמשכת על ידה,"
        },
        {
          "s": 11,
          "text": "וכיון שההמשכה שע\"י העבודה דאחותי ואמי היא כמו אתערותא דלעילא שמתעוררת ונמשכת על ידי אתערותא דלתתא,"
        },
        {
          "s": 12,
          "text": "ההמשכה היא רק ממקום שאתעדל\"ת מגעת לשם."
        },
        {
          "s": 13,
          "text": "וההמשכה שע\"י מעשה המצוות,"
        },
        {
          "s": 14,
          "text": "שעשיית המצוה היא עשי' גשמית שאינה בערך כלל19,"
        },
        {
          "s": 15,
          "text": "היא כמו אתעדל\"ע שמצד עצמה,"
        },
        {
          "s": 16,
          "text": "ולכן ההמשכה היא מעצמות אוא\"ס20."
        },
        {
          "s": 17,
          "text": "וזהו רני ושמחי בת ציון כי הנני בא ושכנתי בתוכך,"
        },
        {
          "s": 18,
          "text": "שהנני בא כולל שני ענינים."
        },
        {
          "s": 19,
          "text": "הנני מוכן מעצמי שלא ע\"י אתעדל\"ת21,"
        },
        {
          "s": 20,
          "text": "בא,"
        },
        {
          "s": 21,
          "text": "אני בעצמי כביכול אוא\"ס ב\"ה ממש22."
        }
      ]
    }
  ]
}