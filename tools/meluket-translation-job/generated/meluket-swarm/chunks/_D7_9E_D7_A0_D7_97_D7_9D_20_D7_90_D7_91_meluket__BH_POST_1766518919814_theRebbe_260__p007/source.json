  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919814_theRebbe_260__p007",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919814_theRebbe_260__p007",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919814_theRebbe_260",
  "title": "מאמר לא היו ימים טובים לישראל תשל\"ה",
  "part": 7,
  "sections": [
    {
      "v": 18,
      "items": [
        {
          "s": 0,
          "text": "ויהי רצון,"
        },
        {
          "s": 1,
          "text": "שע\"י מעשינו ועבודתינו69"
        },
        {
          "s": 2,
          "text": "שלא להתפעל מכל הנסיונות,"
        },
        {
          "s": 3,
          "text": "כולל גם נסיונות כאלו שמצד כל החשבונות"
        },
        {
          "s": 4,
          "text": "(גם מצד העילוי שבעבודת הנסיונות70)"
        },
        {
          "s": 5,
          "text": "אין הסברה על זה,"
        },
        {
          "s": 6,
          "text": "יקרבו ויזרזו עוד יותר הגאולה העתידה ע\"י משיח צדקנו,"
        },
        {
          "s": 7,
          "text": "שילחם71"
        },
        {
          "s": 8,
          "text": "מלחמות ה' וינצח"
        },
        {
          "s": 9,
          "text": "[דרובם של מלחמות אלו אין להם מקום בשכל,"
        },
        {
          "s": 10,
          "text": "גם לא בהשכל של הלוחמים,"
        },
        {
          "s": 11,
          "text": "שלכן,"
        },
        {
          "s": 12,
          "text": "המלחמות הם בתוקף גדול,"
        },
        {
          "s": 13,
          "text": "ואעפ\"כ ינצח],"
        },
        {
          "s": 14,
          "text": "ויבנה בית המקדש במקומו,"
        },
        {
          "s": 15,
          "text": "ויקבץ נדחי ישראל,"
        },
        {
          "s": 16,
          "text": "כולל שיקבץ כל ניצוצות הקדושה72"
        },
        {
          "s": 17,
          "text": "וגם נדחי ישראל כפשוטם – קיבוץ גלויות,"
        },
        {
          "s": 18,
          "text": "בקרוב ממש,"
        },
        {
          "s": 19,
          "text": "בגאולה האמיתית והשלימה ע\"י משיח צדקנו."
        }
      ]
    }
  ]
}