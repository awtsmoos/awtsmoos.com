{
  "globalIndex": 1084,
  "owner": 34,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920213_theRebbe_982__p002",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920213_theRebbe_982__p002",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920213_theRebbe_982",
  "title": "מאמר אני לדודי תשמ\"ו",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה בכללות דרושי חודש אלול בלקו\"ת,"
        },
        {
          "s": 2,
          "text": "שנסדר ונדפס ע\"י כ\"ק אדמו\"ר הצ\"צ10,"
        },
        {
          "s": 3,
          "text": "מצינו דבר פלא,"
        },
        {
          "s": 4,
          "text": "שבדרושים אלה לא ישנה קעפּל"
        },
        {
          "s": 5,
          "text": "(כותרת)"
        },
        {
          "s": 6,
          "text": "בפ\"ע11"
        },
        {
          "s": 7,
          "text": "\"דרושים לאלול\"12,"
        },
        {
          "s": 8,
          "text": "ונכללו בהדרושים לפ' ראה."
        },
        {
          "s": 9,
          "text": "וצריך ביאור הקשר דדרושי אלול עם פרשת ראה."
        },
        {
          "s": 10,
          "text": "וגם צריך להבין מה שלא נדפסו בלקו\"ת דרושים לפ' שופטים13."
        },
        {
          "s": 11,
          "text": "הגם שישנו ריבוי דרושים מאדמו\"ר הזקן על פ' שופטים,"
        },
        {
          "s": 12,
          "text": "הן על תחילת הפרשה"
        },
        {
          "s": 13,
          "text": "(שופטים ושוטרים)"
        },
        {
          "s": 14,
          "text": "והן על פסוקים שבאמצע הפרשה."
        },
        {
          "s": 15,
          "text": "וכנדפס גם באוה\"ת להצ\"צ,"
        },
        {
          "s": 16,
          "text": "ועד\"ז גם בדרושי אדמו\"ר האמצעי,"
        },
        {
          "s": 17,
          "text": "שכמה משניהם מיוסדים על מאמרי אדמו\"ר הזקן,"
        },
        {
          "s": 18,
          "text": "ונדפסו דרושים לפ' ראה"
        },
        {
          "s": 19,
          "text": "(שלפני פ' שופטים)"
        },
        {
          "s": 20,
          "text": "ופ' תצא"
        },
        {
          "s": 21,
          "text": "(שאחרי')"
        },
        {
          "s": 22,
          "text": "ולא נדפסו דרושים לפ' שופטים"
        },
        {
          "s": 23,
          "text": "(והרי הדרושים דאלול שייכים"
        },
        {
          "s": 24,
          "text": "(גם)"
        },
        {
          "s": 25,
          "text": "לפ' שופטים14)."
        },
        {
          "s": 26,
          "text": "גם צריך להבין דהקביעות בזמן דר\"ח אלול בפ' שופטים מכריחה שיש שייכות ביניהם ומהי."
        },
        {
          "s": 27,
          "text": "ולהעיר מענין נפלא בדרוש הנ\"ל"
        },
        {
          "s": 28,
          "text": "(ד\"ה אני לדודי)"
        },
        {
          "s": 29,
          "text": "שבלקו\"ת,"
        },
        {
          "s": 30,
          "text": "שמתחיל ונדפס בדף לב."
        },
        {
          "s": 31,
          "text": "וי\"ל בדא\"פ שמספר לב יש בו תוכן מיוחד,"
        },
        {
          "s": 32,
          "text": "כמדובר במ\"א15"
        },
        {
          "s": 33,
          "text": "רמז הדבר שבפרק לב16"
        },
        {
          "s": 34,
          "text": "שבתניא מבואר ענין ואהבת לרעך כמוך17,"
        },
        {
          "s": 35,
          "text": "משום שענין אהבת ישראל הוא הלב והעיקר,"
        },
        {
          "s": 36,
          "text": "כמארז\"ל18"
        },
        {
          "s": 37,
          "text": "זה כלל גדול בתורה."
        },
        {
          "s": 38,
          "text": "ועד\"ז י\"ל לגבי דף לב שבספר משנה תורה בלקו\"ת שנסדר לדפוס ע\"י הצ\"צ,"
        },
        {
          "s": 39,
          "text": "והיינו,"
        },
        {
          "s": 40,
          "text": "שבדף זה"
        },
        {
          "s": 41,
          "text": "(בדרוש זה)"
        },
        {
          "s": 42,
          "text": "הוא הלב של הלקו\"ת דמשנה תורה."
        },
        {
          "s": 43,
          "text": "ואפילו את\"ל שזה שדרוש זה נדפס בדף לב הי' אח\"כ,"
        },
        {
          "s": 44,
          "text": "מ\"מ קרוב לומר,"
        },
        {
          "s": 45,
          "text": "שמכיון שזהו ספר בתורה,"
        },
        {
          "s": 46,
          "text": "ובפרט ע\"פ תורת הבעש\"ט הידועה19,"
        },
        {
          "s": 47,
          "text": "אפשר ללמוד הוראה בעבודת האדם גם מפרטים כאלו."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ויש לומר הביאור בכל זה,"
        },
        {
          "s": 2,
          "text": "ע\"פ משנת\"ל שנקודת הדרוש הנ\"ל היא אשר העבודה דחודש אלול היא כמשל המלך בשדה."
        },
        {
          "s": 3,
          "text": "ועפ\"ז יומתק הקשר דדרושי אלול עם"
        },
        {
          "s": 4,
          "text": "(דף)"
        },
        {
          "s": 5,
          "text": "לב,"
        },
        {
          "s": 6,
          "text": "דהנה כשהמלך בשדה,"
        },
        {
          "s": 7,
          "text": "הרי \"השדה\" משווה כל הנמצאים בו,"
        },
        {
          "s": 8,
          "text": "מכיון דשם כל אחד"
        },
        {
          "s": 9,
          "text": "(בלי הבדל)"
        },
        {
          "s": 10,
          "text": "רשאי ויכול להקביל פניו,"
        },
        {
          "s": 11,
          "text": "והוא מקבל את כולם כו'"
        },
        {
          "s": 12,
          "text": "(משא\"כ בהיותו בעיר מלכותו,"
        },
        {
          "s": 13,
          "text": "ובפרט בהיכלו,"
        },
        {
          "s": 14,
          "text": "שרק המובחרים ויחידי סגולה נכנסים אל המלך)."
        },
        {
          "s": 15,
          "text": "ויתירה מזו,"
        },
        {
          "s": 16,
          "text": "דבהיות המלך בשדה,"
        },
        {
          "s": 17,
          "text": "אזי מתבטלים המחיצות וכו' שבין המלך להעם,"
        },
        {
          "s": 18,
          "text": "והוא מקבל את כולם בסבר פנים יפות ומראה להם פנים שוחקות."
        },
        {
          "s": 19,
          "text": "ובכלל"
        },
        {
          "s": 20,
          "text": "(ובפרט באלול20),"
        },
        {
          "s": 21,
          "text": "אני"
        },
        {
          "s": 22,
          "text": "(ישראל)"
        },
        {
          "s": 23,
          "text": "ודודי"
        },
        {
          "s": 24,
          "text": "(הקב\"ה),"
        },
        {
          "s": 25,
          "text": "כל אחד מהם הוא לב כביכול להשני."
        },
        {
          "s": 26,
          "text": "וזה תלוי בהאחדות דישראל"
        },
        {
          "s": 27,
          "text": "(אני)"
        },
        {
          "s": 28,
          "text": "(מה שבהיות המלך בשדה כולם שוים),"
        },
        {
          "s": 29,
          "text": "כמבואר באגה\"ק21."
        },
        {
          "s": 30,
          "text": "ויש לומר שזהו גם הקשר עם פרשת ראה,"
        },
        {
          "s": 31,
          "text": "דענין הראי',"
        },
        {
          "s": 32,
          "text": "הארת י\"ג מדות הרחמים הוא שיהי' פנים בפנים,"
        },
        {
          "s": 33,
          "text": "פנימיות רצונו ית' לישראל ופנימיות הרצון דישראל אליו ית'22"
        },
        {
          "s": 34,
          "text": "(וע\"ד הנ\"ל שכל אחד מהם הוא לב דהשני)."
        },
        {
          "s": 35,
          "text": "וכמש\"נ ראה אנכי נותן לפניכם,"
        },
        {
          "s": 36,
          "text": "בחי' פנים בפנים23."
        },
        {
          "s": 37,
          "text": "[אמנם הענין דשופטים ושוטרים גו'24"
        },
        {
          "s": 38,
          "text": "הוא אדרבה,"
        },
        {
          "s": 39,
          "text": "היפך ההשתוות,"
        },
        {
          "s": 40,
          "text": "לברר החילוק"
        },
        {
          "s": 41,
          "text": "(והמחיצות)"
        },
        {
          "s": 42,
          "text": "שבין זל\"ז,"
        },
        {
          "s": 43,
          "text": "בין דין לדין כו'25]."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה מבואר בהמשך הדרוש שם26,"
        },
        {
          "s": 2,
          "text": "שכשם שיש בחי' שדה כך יש בחי' מדבר,"
        },
        {
          "s": 3,
          "text": "ארץ לא זרועה27"
        },
        {
          "s": 4,
          "text": "אשר לא ישב אדם שם28."
        },
        {
          "s": 5,
          "text": "ובמשל דחודש אלול מלך בשדה"
        },
        {
          "s": 6,
          "text": "(ולא במדבר)"
        },
        {
          "s": 7,
          "text": "שהשדה נעלה מהמדבר."
        },
        {
          "s": 8,
          "text": "וגם בפשטות המדבר הוא ארץ לא זרועה,"
        },
        {
          "s": 9,
          "text": "משא\"כ השדה הוא מקום זריעה וצמיחת הלחם,"
        },
        {
          "s": 10,
          "text": "ארץ29"
        },
        {
          "s": 11,
          "text": "ממנה יצא לחם."
        },
        {
          "s": 12,
          "text": "שהלחם מבררים אותו ומעלים אותו,"
        },
        {
          "s": 13,
          "text": "ולחם לבב אנוש יסעד30,"
        },
        {
          "s": 14,
          "text": "דלא על הלחם לבדו יחי' האדם כי על כל מוצא פי הוי'31"
        },
        {
          "s": 15,
          "text": "שבלחם,"
        },
        {
          "s": 16,
          "text": "הניצוץ האלקי שבלחם"
        },
        {
          "s": 17,
          "text": "(כמבואר בכתבי האריז\"ל32"
        },
        {
          "s": 18,
          "text": "ובכ\"מ33)."
        },
        {
          "s": 19,
          "text": "ונמצא שהחידוש דשדה על עיר ומדבר הוא,"
        },
        {
          "s": 20,
          "text": "דהעיר הם הבתים שבתוך תחום הקדושה,"
        },
        {
          "s": 21,
          "text": "והמדבר הוא מחוץ לתחום הקדושה"
        },
        {
          "s": 22,
          "text": "(לא ישב אדם שם),"
        },
        {
          "s": 23,
          "text": "והשדה תוכנו הוא הבירור של הענינים שמחוץ לבית והכנסתם לתוך הקדושה."
        },
        {
          "s": 24,
          "text": "וזהו כללות עבודת האדם,"
        },
        {
          "s": 25,
          "text": "לברר את עניני העולם ולהעלותם לאלקות."
        },
        {
          "s": 26,
          "text": "וגם מטעם זה כללות הקרבנות נק' בשם את קרבני לחמי לאישי34,"
        },
        {
          "s": 27,
          "text": "ענין הלחם,"
        },
        {
          "s": 28,
          "text": "ובלשון רז\"ל35"
        },
        {
          "s": 29,
          "text": "רעייתי פרנסתי."
        }
      ]
    }
  ]
}