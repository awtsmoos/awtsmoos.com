{
  "globalIndex": 700,
  "owner": 0,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917894_theRebbe_634__p003",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917894_theRebbe_634__p003",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917894_theRebbe_634",
  "title": "מאמר כימי צאתך תשי\"ב",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ויש לבאר זה ע\"פ מ\"ש בהמשך תרס\"ו31,"
        },
        {
          "s": 1,
          "text": "דזה שבהנהגת הטבע יש ענין התמידיות"
        },
        {
          "s": 2,
          "text": "(הגם שטבע הוא מהחיות האלקי שמלובש בהנבראים,"
        },
        {
          "s": 3,
          "text": "וחיות המלובש בנבראים הוא חיות מוגבל,"
        },
        {
          "s": 4,
          "text": "כנ\"ל)"
        },
        {
          "s": 5,
          "text": "הוא לפי ששרש החיות המלובש בהנבראים הוא"
        },
        {
          "s": 6,
          "text": "(לא מהכלים,"
        },
        {
          "s": 7,
          "text": "כי אם)"
        },
        {
          "s": 8,
          "text": "מאור הקו,"
        },
        {
          "s": 9,
          "text": "ששרשו הוא מאוא\"ס שלפני הצמצום."
        },
        {
          "s": 10,
          "text": "וכמבואר בכ\"מ32"
        },
        {
          "s": 11,
          "text": "דשרש הכלים הוא מהצמצום עצמו,"
        },
        {
          "s": 12,
          "text": "ושרש הקו הוא מאוא\"ס שלפני הצמצום"
        },
        {
          "s": 13,
          "text": "(אלא שנמשך ע\"י הצמצום),"
        },
        {
          "s": 14,
          "text": "כמ\"ש בע\"ח33"
        },
        {
          "s": 15,
          "text": "שאחר הצמצום המשיך מן אוא\"ס קו א' ישר מן אור העיגול שלו34."
        },
        {
          "s": 16,
          "text": "והנה ידוע35"
        },
        {
          "s": 17,
          "text": "דזה שהקו בקע את חושך הצמצום,"
        },
        {
          "s": 18,
          "text": "שכל בקיעה היא מצד תגבורת36,"
        },
        {
          "s": 19,
          "text": "הוא לפי ששרש המשכתו הוא מת\"ת הנעלם,"
        },
        {
          "s": 20,
          "text": "שלמעלה מהאור שהאיר"
        },
        {
          "s": 21,
          "text": "(בגילוי)"
        },
        {
          "s": 22,
          "text": "לפני הצמצום."
        },
        {
          "s": 23,
          "text": "ועפ\"ז יש לבאר דזה שיש מעלה בהגילוי דכח הא\"ס שמתגלה ע\"י התמידיות שבהנהגת הטבע לגבי גילוי הא\"ס שע\"י נסים,"
        },
        {
          "s": 24,
          "text": "הוא,"
        },
        {
          "s": 25,
          "text": "כי האור שלפני הצמצום הוא מוגבל בענין הבל\"ג,"
        },
        {
          "s": 26,
          "text": "ואי אפשר שהגילוי שלו יהי' בהגבול דעולמות."
        },
        {
          "s": 27,
          "text": "ולכן,"
        },
        {
          "s": 28,
          "text": "הגילוי דאור הסובב"
        },
        {
          "s": 29,
          "text": "[שהוא גילוי האור שלפני הצמצום37]"
        },
        {
          "s": 30,
          "text": "שממנו שרש הנסים,"
        },
        {
          "s": 31,
          "text": "הוא ע\"י שידוד הטבע,"
        },
        {
          "s": 32,
          "text": "ביטול הטבע"
        },
        {
          "s": 33,
          "text": "(גבול)"
        },
        {
          "s": 34,
          "text": "דעולם."
        },
        {
          "s": 35,
          "text": "ואור הקו שממנו הוא התמידיות שבהנהגת הטבע,"
        },
        {
          "s": 36,
          "text": "כיון ששרשו הוא מת\"ת הנעלם,"
        },
        {
          "s": 37,
          "text": "הוא כולל ומחבר שני ההפכים דבל\"ג וגבול."
        },
        {
          "s": 38,
          "text": "ולכן,"
        },
        {
          "s": 39,
          "text": "גילוי הבל\"ג"
        },
        {
          "s": 40,
          "text": "(נצחיות)"
        },
        {
          "s": 41,
          "text": "שמאור הקו הוא גם בגבול"
        },
        {
          "s": 42,
          "text": "(טבע)."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה ע\"פ הנ\"ל"
        },
        {
          "s": 2,
          "text": "(סעיף ד)"
        },
        {
          "s": 3,
          "text": "שגם התמידיות שבהנהגת הטבע הוא ע\"י המשכת הגילוי דאוא\"ס הבל\"ג שלמעלה מעולמות,"
        },
        {
          "s": 4,
          "text": "והמעלה שבנסים היא שעל ידם נמשך הגילוי דאוא\"ס הבל\"ג עצמו שלמעלה מהתלבשות בגבול,"
        },
        {
          "s": 5,
          "text": "יש לומר,"
        },
        {
          "s": 6,
          "text": "דשני הסוגים שבנסים,"
        },
        {
          "s": 7,
          "text": "נסים שלמעלה מהטבע ונסים המלובשים בטבע,"
        },
        {
          "s": 8,
          "text": "הם שני אופנים בגילוי אוא\"ס הבל\"ג שלמעלה מהתלבשות בגבול."
        },
        {
          "s": 9,
          "text": "ועפ\"ז,"
        },
        {
          "s": 10,
          "text": "זה שנת\"ל"
        },
        {
          "s": 11,
          "text": "(סעיף ג)"
        },
        {
          "s": 12,
          "text": "שהמעלה דנסים המלובשים בטבע היא שהגילוי דאוא\"ס הבל\"ג מתלבש בהגבול דעולם עצמו,"
        },
        {
          "s": 13,
          "text": "הוא,"
        },
        {
          "s": 14,
          "text": "זה שבנסים יש גם הענין והמעלה דהנהגת הטבע,"
        },
        {
          "s": 15,
          "text": "והמעלה דנסים המלובשים בטבע בענין מעלת הנסים עצמם"
        },
        {
          "s": 16,
          "text": "(גילוי אוא\"ס הבל\"ג שלמעלה מהתלבשות)"
        },
        {
          "s": 17,
          "text": "היא,"
        },
        {
          "s": 18,
          "text": "שבהם מתגלה דזה שאוא\"ס הבל\"ג"
        },
        {
          "s": 19,
          "text": "(שלמעלה מהתלבשות)"
        },
        {
          "s": 20,
          "text": "מושל ושולט על הטבע הוא באופן שגם הטבע עצמו נעשה כפי רצונו"
        },
        {
          "s": 21,
          "text": "(ביאור השני שבסעיף הנ\"ל)."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ועד\"ז הוא גם בנוגע להנסים שלמעלה מהטבע,"
        },
        {
          "s": 1,
          "text": "שגם המעלה דנסים אלה היא שהנסים הם בגילוי וגם דזה שאוא\"ס הבל\"ג מושל ושולט על הטבע מתגלה יותר"
        },
        {
          "s": 2,
          "text": "(בפרט אחד)"
        },
        {
          "s": 3,
          "text": "בהנסים שלמעלה מהטבע."
        },
        {
          "s": 4,
          "text": "דבהנסים המלובשים בטבע,"
        },
        {
          "s": 5,
          "text": "שהטבע נשאר במציאות,"
        },
        {
          "s": 6,
          "text": "השליטה דאוא\"ס על הטבע היא"
        },
        {
          "s": 7,
          "text": "(רק)"
        },
        {
          "s": 8,
          "text": "שאופן הנהגת הטבע הוא כפי רצונו,"
        },
        {
          "s": 9,
          "text": "ובהנסים שלמעלה מהטבע,"
        },
        {
          "s": 10,
          "text": "שהטבע מתבטל ממציאותו,"
        },
        {
          "s": 11,
          "text": "השליטה דאוא\"ס על הטבע היא בעצם מציאותו."
        },
        {
          "s": 12,
          "text": "ויש לומר,"
        },
        {
          "s": 13,
          "text": "שהחילוק שבין סוגי הנסים בשרשם הוא,"
        },
        {
          "s": 14,
          "text": "דבנסים המלובשים בטבע הוא גילוי אוא\"ס הבל\"ג כמו ששייך ונותן מקום לגבול."
        },
        {
          "s": 15,
          "text": "ולכן,"
        },
        {
          "s": 16,
          "text": "לגבי גילוי אור זה,"
        },
        {
          "s": 17,
          "text": "ישנו מציאות הטבע"
        },
        {
          "s": 18,
          "text": "(הגבול),"
        },
        {
          "s": 19,
          "text": "אלא שהגבול הוא כפי רצון אוא\"ס הבל\"ג."
        },
        {
          "s": 20,
          "text": "ובהנסים שלמעלה מהטבע הוא גילוי אוא\"ס הבל\"ג כמו שהוא למעלה מענין הגבול,"
        },
        {
          "s": 21,
          "text": "ולכן,"
        },
        {
          "s": 22,
          "text": "לגבי גילוי אור זה,"
        },
        {
          "s": 23,
          "text": "מתבטל הטבע ממציאותו."
        },
        {
          "s": 24,
          "text": "[וע\"ד המבואר במק\"א38"
        },
        {
          "s": 25,
          "text": "בענין רצון ושכל"
        },
        {
          "s": 26,
          "text": "[דרצון ושכל הם משל על אור הסובב"
        },
        {
          "s": 27,
          "text": "(שרש הנסים)"
        },
        {
          "s": 28,
          "text": "ואור הממלא"
        },
        {
          "s": 29,
          "text": "(שרש הטבע)],"
        },
        {
          "s": 30,
          "text": "דזה שהרצון נמשך בהשכל ופועל עליו שיהי' טעם להרצון,"
        },
        {
          "s": 31,
          "text": "הוא רק בהארת הרצון,"
        },
        {
          "s": 32,
          "text": "אבל עצם הרצון אינו נמשך בשכל,"
        },
        {
          "s": 33,
          "text": "אין טעם לרצון]."
        }
      ]
    }
  ]
}