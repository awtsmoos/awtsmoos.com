{
  "globalIndex": 107,
  "owner": 7,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914333_theRebbe_315__p001",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914333_theRebbe_315__p001",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914333_theRebbe_315",
  "title": "מאמר בסוכות תשבו תשמ\"א",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "אור לי\"ג תשרי,"
        },
        {
          "s": 2,
          "text": "הילולא דאדמו\"ר מהר\"ש נ\"ע,"
        },
        {
          "s": 3,
          "text": "ה'תשמ\"א*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "בסוכות תשבו שבעת ימים גו' למען ידעו דורותיכם כי בסוכות הושבתי את בני ישראל בהוציאי אותם מארץ מצרים1."
        },
        {
          "s": 1,
          "text": "הנה פסוק זה מביא רבינו הזקן בשו\"ע ריש הלכות סוכה2"
        },
        {
          "s": 2,
          "text": "ומדייק בלשונו הזהב"
        },
        {
          "s": 3,
          "text": "(דבסוכות הושבתי גו')"
        },
        {
          "s": 4,
          "text": "הם היו ענני כבודו שהקיפם בהם לצל כו'3"
        },
        {
          "s": 5,
          "text": "ודוגמא לזה צונו לעשות סוכות העשויות לצל."
        },
        {
          "s": 6,
          "text": "ומבאר אדמו\"ר מהר\"ש בעל ההילולא בהמאמרים דחג הסוכות שנאמרו לפני מאה שנה4,"
        },
        {
          "s": 7,
          "text": "דסכך הסוכה נעשה מענן הקטורת דיוהכ\"פ5,"
        },
        {
          "s": 8,
          "text": "דענן הוא כמו צל."
        },
        {
          "s": 9,
          "text": "אלא שביום הכפורים הוא בהעלם עדיין"
        },
        {
          "s": 10,
          "text": "(בכסא6),"
        },
        {
          "s": 11,
          "text": "ובא בגילוי ליום חגינו6,"
        },
        {
          "s": 12,
          "text": "בחג הסוכות7."
        },
        {
          "s": 13,
          "text": "והנה בסוכה צ\"ל צלתה מרובה מחמתה8,"
        },
        {
          "s": 14,
          "text": "היינו שבסוכה יש גם חמתה9,"
        },
        {
          "s": 15,
          "text": "אלא שצלתה צ\"ל מרובה מחמתה."
        },
        {
          "s": 16,
          "text": "ועד\"ז ביוהכ\"פ יש גם הענין דחמתה,"
        },
        {
          "s": 17,
          "text": "אלא שעיקר העבודה דיוהכ\"פ הוא ענין הצל."
        },
        {
          "s": 18,
          "text": "דהנה ב' הענינים דחמתה וצלתה בהעבודות בביהמ\"ק,"
        },
        {
          "s": 19,
          "text": "ועד\"ז בתפלות שבמקום קרבנות תקנום10,"
        },
        {
          "s": 20,
          "text": "הם עבודת הקרבנות ועבודת הקטורת11."
        },
        {
          "s": 21,
          "text": "דבקרבנות כתיב12"
        },
        {
          "s": 22,
          "text": "לחמי לאשי גו',"
        },
        {
          "s": 23,
          "text": "ואשי,"
        },
        {
          "s": 24,
          "text": "אש שבאה מן ההדיוט וגם אש שירד מן השמים13,"
        },
        {
          "s": 25,
          "text": "הו\"ע החום,"
        },
        {
          "s": 26,
          "text": "חמתה."
        },
        {
          "s": 27,
          "text": "ועבודת הקטורת,"
        },
        {
          "s": 28,
          "text": "שעיקרה הוא הענן,"
        },
        {
          "s": 29,
          "text": "הו\"ע צלתה כנ\"ל."
        },
        {
          "s": 30,
          "text": "וזהו מה שביוהכ\"פ יש הענין דחמתה,"
        },
        {
          "s": 31,
          "text": "שהרי גם אז יש עבודת הקרבנות."
        },
        {
          "s": 32,
          "text": "אלא שעיקר העבודה דיוהכ\"פ היא העבודה דקטורת,"
        },
        {
          "s": 33,
          "text": "בחי' צל,"
        },
        {
          "s": 34,
          "text": "ומזה נמשך גם בסוכות,"
        },
        {
          "s": 35,
          "text": "ליום חגינו,"
        },
        {
          "s": 36,
          "text": "שצ\"ל צלתה מרובה מחמתה."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "וביאור ההפרש בין קרבנות לקטורת,"
        },
        {
          "s": 2,
          "text": "יובן משמם אשר יקראו להם בלשון הקודש"
        },
        {
          "s": 3,
          "text": "[כתורת הבעש\"ט הידועה14]."
        },
        {
          "s": 4,
          "text": "הנה קרבן הוא מלשון קירוב15,"
        },
        {
          "s": 5,
          "text": "וכמו שמבאר כ\"ק מו\"ח אדמו\"ר בדרושי ההילולא שלו16"
        },
        {
          "s": 6,
          "text": "שקרבנות הו\"ע קירוב הכחות והחושים,"
        },
        {
          "s": 7,
          "text": "ורזא דקורבנא עולה עד רזא דא\"ס17."
        },
        {
          "s": 8,
          "text": "וקטורת הוא לשון קשר"
        },
        {
          "s": 9,
          "text": "[כי כל קשר שבפסוק מתורגם בלשון קטר18],"
        },
        {
          "s": 10,
          "text": "דלא רק שהוא מקורב לאלקות,"
        },
        {
          "s": 11,
          "text": "ומקורב בתכלית הקירוב,"
        },
        {
          "s": 12,
          "text": "אלא שהוא גם מקושר עם אלקות,"
        },
        {
          "s": 13,
          "text": "ומקושר בתכלית."
        },
        {
          "s": 14,
          "text": "וההפרש בין קירוב"
        },
        {
          "s": 15,
          "text": "(קרבנות)"
        },
        {
          "s": 16,
          "text": "והתקשרות"
        },
        {
          "s": 17,
          "text": "(קטורת)"
        },
        {
          "s": 18,
          "text": "הוא,"
        },
        {
          "s": 19,
          "text": "דכאשר הוא מקורב לאלקות גם כשהוא מקורב בתכלית הקירוב,"
        },
        {
          "s": 20,
          "text": "הוא בבחי' מציאות עדיין."
        },
        {
          "s": 21,
          "text": "וזהו שבקרבנות כתיב לחמי לאשי"
        },
        {
          "s": 22,
          "text": "[והעבודה דקרבנות הו\"ע חמתה,"
        },
        {
          "s": 23,
          "text": "כנ\"ל],"
        },
        {
          "s": 24,
          "text": "כי העבודה דקרבנות היא בדרך כלל עבודה שע\"פ טעם ודעת19,"
        },
        {
          "s": 25,
          "text": "וגם זה שנמשך מלמעלה ע\"י עבודה זו,"
        },
        {
          "s": 26,
          "text": "נחת רוח לפני שאמרתי ונעשה רצוני20,"
        },
        {
          "s": 27,
          "text": "שייך לטעם ודעת,"
        },
        {
          "s": 28,
          "text": "והאהבה שע\"פ טעם ודעת היא בבחי' מורגש21,"
        },
        {
          "s": 29,
          "text": "ולכן שייך בה בחי' חום,"
        },
        {
          "s": 30,
          "text": "ותוקפו שלהובא22"
        },
        {
          "s": 31,
          "text": "דרחימותא11."
        },
        {
          "s": 32,
          "text": "משא\"כ העבודה דקטורת היא בדרך כלל העבודה ברעותא דלבא שלמעלה מטעם ודעת23,"
        },
        {
          "s": 33,
          "text": "שבבחי' זו אין שייך ענין המורגש."
        },
        {
          "s": 34,
          "text": "וזהו שקטורת הוא לשון קשר,"
        },
        {
          "s": 35,
          "text": "שהוא ההתקשרות והדביקות באוא\"ס ב\"ה בלי שום הרגש11,"
        },
        {
          "s": 36,
          "text": "שאינו שום מציאות לעצמו וכל מציאותו הוא רק מה שהוא מקושר עמו,"
        },
        {
          "s": 37,
          "text": "עד שנעשים כולא חד."
        },
        {
          "s": 38,
          "text": "ובלשון הידוע24"
        },
        {
          "s": 39,
          "text": "בחד קטירא אתקטרנא בי' בקוב\"ה בי' אחידא"
        },
        {
          "s": 40,
          "text": "[דהגם שממשיך גם בי' להיטא,"
        },
        {
          "s": 41,
          "text": "הרי מכיון שבי' להיטא"
        },
        {
          "s": 42,
          "text": "(שם)"
        },
        {
          "s": 43,
          "text": "הוא לאחרי בי' אחידא אין בזה הרגש],"
        },
        {
          "s": 44,
          "text": "דענין בי' אחידא הוא שנעשה חד ממש עם אור אין סוף."
        }
      ]
    }
  ]
}