{
  "globalIndex": 827,
  "owner": 27,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918708_theRebbe_155__p003",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918708_theRebbe_155__p003",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918708_theRebbe_155",
  "title": "מאמר בשעה שעלה משה למרום תשכ\"ה",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים מ\"ש23"
        },
        {
          "s": 2,
          "text": "כמים הפנים לפנים כן לב האדם לאדם,"
        },
        {
          "s": 3,
          "text": "ומבואר בחסידות24"
        },
        {
          "s": 4,
          "text": "דלב האדם לאדם קאי לא רק על שני בני אדם,"
        },
        {
          "s": 5,
          "text": "דלב האדם באהבתו לחבירו מעורר אהבת חבירו אליו,"
        },
        {
          "s": 6,
          "text": "אלא גם על אדם התחתון ואדם העליון,"
        },
        {
          "s": 7,
          "text": "דכפי אופן העבודה של אדם התחתון,"
        },
        {
          "s": 8,
          "text": "אתערותא דלתתא,"
        },
        {
          "s": 9,
          "text": "כן הוא אופן האתערותא דלעילא,"
        },
        {
          "s": 10,
          "text": "ההמשכה מאדם העליון לאדם התחתון,"
        },
        {
          "s": 11,
          "text": "כמים הפנים לפנים25."
        },
        {
          "s": 12,
          "text": "ויש לומר,"
        },
        {
          "s": 13,
          "text": "שהדמיון דלב האדם לאדם למים הפנים לפנים הוא26,"
        },
        {
          "s": 14,
          "text": "דכמו שבמים הפנים לפנים,"
        },
        {
          "s": 15,
          "text": "זה שנראה להאדם אותה הצורה שהוא מראה בהמים הוא לפי שע\"י הסתכלותו בהמים נעשים"
        },
        {
          "s": 16,
          "text": "(נראים)"
        },
        {
          "s": 17,
          "text": "בהמים צורת הפנים המסתכלת בהם וצורה זו נראית אח\"כ לאדם המסתכל,"
        },
        {
          "s": 18,
          "text": "כן הוא בלב האדם לאדם,"
        },
        {
          "s": 19,
          "text": "דזה שע\"י העבודה והאתערותא דלתתא של אדם התחתון נעשה אתערותא דלעילא והמשכה מאדם העליון לאדם התחתון,"
        },
        {
          "s": 20,
          "text": "הוא,"
        },
        {
          "s": 21,
          "text": "כי העבודה דאדם התחתון עולה מלמטה למעלה,"
        },
        {
          "s": 22,
          "text": "לאדם העליון,"
        },
        {
          "s": 23,
          "text": "ועי\"ז נעשה בו"
        },
        {
          "s": 24,
          "text": "(דוגמת)"
        },
        {
          "s": 25,
          "text": "ענין זה,"
        },
        {
          "s": 26,
          "text": "ואח\"כ נמשך ענין זה"
        },
        {
          "s": 27,
          "text": "(שנעשה באדם העליון)"
        },
        {
          "s": 28,
          "text": "מלמעלה למטה,"
        },
        {
          "s": 29,
          "text": "לאדם התחתון."
        },
        {
          "s": 30,
          "text": "ולהוסיף,"
        },
        {
          "s": 31,
          "text": "דבמשל המים,"
        },
        {
          "s": 32,
          "text": "זה שפני האדם שמסתכל בהמים נראים בהמים,"
        },
        {
          "s": 33,
          "text": "הוא רק שנראה כן לעין הרואה,"
        },
        {
          "s": 34,
          "text": "ובהנמשל,"
        },
        {
          "s": 35,
          "text": "ע\"י העבודה דאדם התחתון נעשה27"
        },
        {
          "s": 36,
          "text": "(דוגמת)"
        },
        {
          "s": 37,
          "text": "ענין זה באדם העליון"
        },
        {
          "s": 38,
          "text": "(ולא רק שנראה כן)28."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "והנה29 כמו שלב האדם לאדם הוא"
        },
        {
          "s": 1,
          "text": "(לא רק כפשוטו,"
        },
        {
          "s": 2,
          "text": "אלא)"
        },
        {
          "s": 3,
          "text": "גם ברוחניות"
        },
        {
          "s": 4,
          "text": "(באדם העליון ואדם התחתון),"
        },
        {
          "s": 5,
          "text": "כמו\"כ הוא גם בנוגע להתחלת הכתוב כמים הפנים לפנים,"
        },
        {
          "s": 6,
          "text": "שמדבר"
        },
        {
          "s": 7,
          "text": "(לא רק במים כפשוטם,"
        },
        {
          "s": 8,
          "text": "אלא)"
        },
        {
          "s": 9,
          "text": "גם במים העליונים,"
        },
        {
          "s": 10,
          "text": "היינו הפשיטות דאוא\"ס שלמעלה מציור אדם."
        },
        {
          "s": 11,
          "text": "וענין כמים הפנים לפנים הוא,"
        },
        {
          "s": 12,
          "text": "דהגם שאוא\"ס הוא פשוט בתכלית הפשיטות ואין שייך בו ציור דספירות,"
        },
        {
          "s": 13,
          "text": "מ\"מ,"
        },
        {
          "s": 14,
          "text": "ע\"י העלאת מ\"ן דהספירות לאוא\"ס,"
        },
        {
          "s": 15,
          "text": "נעשים בו ספירות – עשר ספירות הגנוזות30,"
        },
        {
          "s": 16,
          "text": "וע\"ס הגנוזות הם כמו מקור שמהם נמשכים ע\"ס הגלויות"
        },
        {
          "s": 17,
          "text": "[ע\"ד שני הענינים דכמים הפנים לפנים במים כפשוטם,"
        },
        {
          "s": 18,
          "text": "שדמות הפנים המסתכלת בהם נראית בהמים,"
        },
        {
          "s": 19,
          "text": "העלאה מלמטה למעלה,"
        },
        {
          "s": 20,
          "text": "ושהדמות הנראית בהמים היא נראית אח\"כ להאדם המסתכל,"
        },
        {
          "s": 21,
          "text": "המשכה מלמעלה למטה]."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "וצריך להבין,"
        },
        {
          "s": 1,
          "text": "דמזה שנאמר כמים הפנים לפנים כן לב האדם לאדם משמע,"
        },
        {
          "s": 2,
          "text": "דענין מים הפנים לפנים הוא פשוט יותר מענין לב האדם לאדם,"
        },
        {
          "s": 3,
          "text": "ולכאורה,"
        },
        {
          "s": 4,
          "text": "הרי האין ערוך דציור"
        },
        {
          "s": 5,
          "text": "(\"פנים\")"
        },
        {
          "s": 6,
          "text": "לגבי פשיטות"
        },
        {
          "s": 7,
          "text": "(\"מים\")"
        },
        {
          "s": 8,
          "text": "הוא הרבה יותר מהאין ערוך של הציור דאדם התחתון לגבי הציור דאדם העליון"
        },
        {
          "s": 9,
          "text": "[כמאמר הידוע31"
        },
        {
          "s": 10,
          "text": "יותר משאין ערוך עשי' לגבי אצילות אין ערוך אצילות לגבי אוא\"ס],"
        },
        {
          "s": 11,
          "text": "ועפ\"ז,"
        },
        {
          "s": 12,
          "text": "זה שע\"י העלאת מ\"ן נעשה ציור דספירות באוא\"ס הוא לכאורה חידוש גדול הרבה יותר מזה שהציור דאדם התחתון נעשה באדם העליון,"
        },
        {
          "s": 13,
          "text": "ומזה שנאמר כמים הפנים לפנים כן לב האדם לאדם משמע,"
        },
        {
          "s": 14,
          "text": "דענין מים הפנים לפנים הוא פשוט יותר32."
        }
      ]
    }
  ]
}