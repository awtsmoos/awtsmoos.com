{
  "globalIndex": 1122,
  "owner": 22,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920487_theRebbe_9__p006",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920487_theRebbe_9__p006",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920487_theRebbe_9",
  "title": "מאמר לך אמר לבי תש\"כ",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "דזהו שמבאר בהמאמר מ\"ש מבשרי אחזה אלוקה,"
        },
        {
          "s": 3,
          "text": "מבשרי דוקא,"
        },
        {
          "s": 4,
          "text": "שהכוונה בזה היא לראי' מוחשית"
        },
        {
          "s": 5,
          "text": "(באלקות)"
        },
        {
          "s": 6,
          "text": "שמתייחסת להגוף,"
        },
        {
          "s": 7,
          "text": "כי תכלית הכוונה דירידת הנשמה למטה הוא"
        },
        {
          "s": 8,
          "text": "(לא שעניני הנשמה יהיו בגילוי בהיותה מלובשת בגוף,"
        },
        {
          "s": 9,
          "text": "כי אם)"
        },
        {
          "s": 10,
          "text": "שהגוף יראה אלקות."
        },
        {
          "s": 11,
          "text": "[ולהעיר שיש עוד פירוש במבשרי אחזה אלוקה,"
        },
        {
          "s": 12,
          "text": "שבהבשר עצמו רואים את האלקות שבו."
        },
        {
          "s": 13,
          "text": "וכתורת אדמו\"ר הזקן57"
        },
        {
          "s": 14,
          "text": "עה\"פ מבשרי אחזה אלוקה שצריך שייערין דעם בשר אַז מי זאָל דערזעהען געטליכקייט."
        },
        {
          "s": 15,
          "text": "דמזה שאומר שצריך שייערין דעם בשר"
        },
        {
          "s": 16,
          "text": "(הסרת הדברים המכסים)"
        },
        {
          "s": 17,
          "text": "מובן שעי\"ז רואים האלקות שבהבשר עצמו."
        },
        {
          "s": 18,
          "text": "וכמובן גם ממאמר אדמו\"ר"
        },
        {
          "s": 19,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 20,
          "text": "נ\"ע58"
        },
        {
          "s": 21,
          "text": "עה\"פ מבשרי אחזה אלוקה,"
        },
        {
          "s": 22,
          "text": "קוק ניט וואָס ער איז אַ גולם,"
        },
        {
          "s": 23,
          "text": "דעם גולם האָט מהוה גיווען עצמות א\"ס ב\"ה,"
        },
        {
          "s": 24,
          "text": "דהוא לבדו בכחו ויכלתו לברוא יש מאין ואפס המוחלט59."
        },
        {
          "s": 25,
          "text": "ויש לומר,"
        },
        {
          "s": 26,
          "text": "דזה שבהמאמר מבאר דפירוש מבשרי אחזה אלוקה הוא ראי' מוחשית,"
        },
        {
          "s": 27,
          "text": "אף שראיית האלקות שבהבשר עצמו הוא לכאורה ענין נעלה יותר"
        },
        {
          "s": 28,
          "text": "(ובפרט לפירוש אדמו\"ר נ\"ע שקאי על כח העצמות שבהגוף),"
        },
        {
          "s": 29,
          "text": "הוא,"
        },
        {
          "s": 30,
          "text": "כי ראיית האלקות שבהבשר"
        },
        {
          "s": 31,
          "text": "(כח העצמות שבו)"
        },
        {
          "s": 32,
          "text": "היא ראי' שכלית שמתייחסת להנפש,"
        },
        {
          "s": 33,
          "text": "ותכלית הכוונה דירידת הנשמה למטה הוא שהגוף יראה אלקות]."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "והנה ידוע60,"
        },
        {
          "s": 3,
          "text": "דכמו שירידת הנשמה למטה היא לצורך עלי',"
        },
        {
          "s": 4,
          "text": "כמו\"כ הוא גם בנוגע לירידת האור האלקי להוות ולהחיות את הנבראים,"
        },
        {
          "s": 5,
          "text": "שהיא ירידה צורך עלי'."
        },
        {
          "s": 6,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 7,
          "text": "שע\"י ששם הוי' יורד ומתלבש בשם אלקים"
        },
        {
          "s": 8,
          "text": "(בכדי להוות ולהחיות את הנבראים),"
        },
        {
          "s": 9,
          "text": "נעשה עלי' בהאור,"
        },
        {
          "s": 10,
          "text": "למעלה יותר גם מכמו שהוא בשרשו באוא\"ס שלמעלה מהוי'61."
        },
        {
          "s": 11,
          "text": "והעלי' היא,"
        },
        {
          "s": 12,
          "text": "שנעשה62"
        },
        {
          "s": 13,
          "text": "בו ענין חדש63"
        },
        {
          "s": 14,
          "text": "– גילוי אלקות בעוה\"ז הגשמי."
        },
        {
          "s": 15,
          "text": "וכמובא לעיל"
        },
        {
          "s": 16,
          "text": "(סעיף ב)"
        },
        {
          "s": 17,
          "text": "מהמאמר,"
        },
        {
          "s": 18,
          "text": "דישנם עניני אלקות,"
        },
        {
          "s": 19,
          "text": "כמו השגחה פרטית,"
        },
        {
          "s": 20,
          "text": "שהם בגילוי ממש,"
        },
        {
          "s": 21,
          "text": "עד שאפשר לראותם במוחש."
        },
        {
          "s": 22,
          "text": "ויש לומר,"
        },
        {
          "s": 23,
          "text": "דזהו מ\"ש בהמאמר דזה שראי' מוחשית מתייחסת להגוף הוא הן בנוגע להאדם הרואה והן בנוגע להדבר הנראה,"
        },
        {
          "s": 24,
          "text": "שהיתרון בהפנימיות השייכת לחיצוניות וירידתה בחיצוניות הוא הן בנוגע להאדם,"
        },
        {
          "s": 25,
          "text": "שהגוף רואה אלקות"
        },
        {
          "s": 26,
          "text": "(כנ\"ל סעיף ט),"
        },
        {
          "s": 27,
          "text": "והן בנוגע להאור שלמעלה,"
        },
        {
          "s": 28,
          "text": "שהגילוי שלו הוא בעוה\"ז הגשמי."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "והנה עד\"ז הוא בעבודת האדם,"
        },
        {
          "s": 3,
          "text": "שעל ידי ירידת המוחין"
        },
        {
          "s": 4,
          "text": "[העליון שבאדם64,"
        },
        {
          "s": 5,
          "text": "דטבע המוחין הוא עלי' למעלה]"
        },
        {
          "s": 6,
          "text": "בהמדות"
        },
        {
          "s": 7,
          "text": "[התחתון שבאדם64,"
        },
        {
          "s": 8,
          "text": "דטבע המדות הוא ירידה למטה],"
        },
        {
          "s": 9,
          "text": "נעשה עלי' בהמוחין."
        },
        {
          "s": 10,
          "text": "ועיקר העלי' הוא לא זה שאור השכל מאיר גם בלב,"
        },
        {
          "s": 11,
          "text": "אלא שעי\"ז נעשה ענין חדש – התעוררות המדות."
        },
        {
          "s": 12,
          "text": "ויש לומר,"
        },
        {
          "s": 13,
          "text": "שזהו הטעם על זה שבכדי שתהי' התעוררות המדות שבלב צריכה להיות הכנה גם מצד הלב,"
        },
        {
          "s": 14,
          "text": "כי עיקר החידוש שבהתעוררות המדות הוא כשההתעוררות היא"
        },
        {
          "s": 15,
          "text": "(גם)"
        },
        {
          "s": 16,
          "text": "מצד ענין המדות."
        }
      ]
    }
  ]
}