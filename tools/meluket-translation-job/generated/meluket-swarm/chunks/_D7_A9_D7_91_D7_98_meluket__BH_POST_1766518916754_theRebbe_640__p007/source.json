{
  "globalIndex": 508,
  "owner": 8,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916754_theRebbe_640__p007",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916754_theRebbe_640__p007",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916754_theRebbe_640",
  "title": "מאמר באתי לגני תשכ\"ח",
  "part": 7,
  "sections": [
    {
      "v": 18,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יובן גם הקשר דהשכל"
        },
        {
          "s": 1,
          "text": "(גם לאחרי שנמשך)"
        },
        {
          "s": 2,
          "text": "עם הרצון,"
        },
        {
          "s": 3,
          "text": "כי זה שע\"י הרצון נעשה המשכת וגילוי השכל הוא מצד זה שהרצון הוא מעצמות הנפש,"
        },
        {
          "s": 4,
          "text": "העצם דכל הכחות."
        },
        {
          "s": 5,
          "text": "דכמו\"כ הוא גם בנוגע להסברא דכל יצר מחשבות לבו רק רע גו',"
        },
        {
          "s": 6,
          "text": "דהשינוי שנעשה בסברא זו,"
        },
        {
          "s": 7,
          "text": "שמקודם היתה טעם לחוב ואח\"כ נעשית"
        },
        {
          "s": 8,
          "text": "(סברא זו עצמה)"
        },
        {
          "s": 9,
          "text": "טעם לזכות,"
        },
        {
          "s": 10,
          "text": "הוא מצד השינוי כביכול שהי' בהרצון"
        },
        {
          "s": 11,
          "text": "(כנ\"ל בהמאמר דבעל ההילולא)."
        }
      ]
    },
    {
      "v": 19,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "והנה הסיבה לזה שנעשה שינוי בהרצון,"
        },
        {
          "s": 3,
          "text": "מבאר בהמאמר,"
        },
        {
          "s": 4,
          "text": "דלאחר שוירח הוי' את ריח הניחוח77,"
        },
        {
          "s": 5,
          "text": "דרזא דקורבנא עולה עד רזא דא\"ס,"
        },
        {
          "s": 6,
          "text": "אז נמשך רצון חדש."
        },
        {
          "s": 7,
          "text": "והענין הוא כמו שמבאר אדמו\"ר מהר\"ש בהמשך מים רבים87,"
        },
        {
          "s": 8,
          "text": "דריח מעורר את עצם הנפש."
        },
        {
          "s": 9,
          "text": "דזהו שהמתעלף ר\"ל,"
        },
        {
          "s": 10,
          "text": "כשנותנים לו להריח ריח חזק הוא מתעורר מהתעלפותו,"
        },
        {
          "s": 11,
          "text": "כי ענין ההתעלפות הוא העדר התפשטות החיות,"
        },
        {
          "s": 12,
          "text": "וע\"י הריח חזק שמעורר את עצם הנפש,"
        },
        {
          "s": 13,
          "text": "נמשך החיות מחדש"
        },
        {
          "s": 14,
          "text": "(מעצם הנפש)."
        },
        {
          "s": 15,
          "text": "ועד\"ז יובן למעלה,"
        },
        {
          "s": 16,
          "text": "דענין ויתעצב אל לבו88"
        },
        {
          "s": 17,
          "text": "(היפך וירא אלקים את כל אשר עשה והנה טוב מאד89)"
        },
        {
          "s": 18,
          "text": "היא תנועה דסילוק"
        },
        {
          "s": 19,
          "text": "(דוגמת ענין ההתעלפות),"
        },
        {
          "s": 20,
          "text": "וע\"י שהריח את ריח הניחוח דקרבנות,"
        },
        {
          "s": 21,
          "text": "נח\"ר לפני שאמרתי ונעשה רצוני90"
        },
        {
          "s": 22,
          "text": "נמשך רצון חדש מהעצמות שלמעלה מבחי' גילוי."
        }
      ]
    },
    {
      "v": 20,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ב)"
        },
        {
          "s": 2,
          "text": "והנה הטעם על זה שגם ברצון"
        },
        {
          "s": 3,
          "text": "(שלמעלה מהשכל)"
        },
        {
          "s": 4,
          "text": "שייך ניחומין וחרטה"
        },
        {
          "s": 5,
          "text": "(שינוי),"
        },
        {
          "s": 6,
          "text": "הוא כי גם הרצון הוא בכלל ציור אדם,"
        },
        {
          "s": 7,
          "text": "מוחין ומדות."
        },
        {
          "s": 8,
          "text": "דברצון יש המדות שבו והטעם שבו,"
        },
        {
          "s": 9,
          "text": "טעם כמוס."
        },
        {
          "s": 10,
          "text": "ומכיון ששכל"
        },
        {
          "s": 11,
          "text": "(גם טעם כמוס)"
        },
        {
          "s": 12,
          "text": "הוא דבר שמתהפך"
        },
        {
          "s": 13,
          "text": "[כמובן מהסברא דכל יצר מחשבות לבו רק רע גו' שאפשר להסבירה בשני אופנים הפכים,"
        },
        {
          "s": 14,
          "text": "לחוב ולזכות],"
        },
        {
          "s": 15,
          "text": "לכן,"
        },
        {
          "s": 16,
          "text": "כשנעשה שינוי בטעם הכמוס,"
        },
        {
          "s": 17,
          "text": "משתנה הרצון"
        },
        {
          "s": 18,
          "text": "(מדות שברצון),"
        },
        {
          "s": 19,
          "text": "בדוגמת השינוי בשכל הגלוי שעי\"ז משתנים המדות."
        },
        {
          "s": 20,
          "text": "דכ\"ז הוא ברצון שיש בו טעם."
        },
        {
          "s": 21,
          "text": "משא\"כ רצון שלמעלה מהטעם"
        },
        {
          "s": 22,
          "text": "(שאין לו גם טעם כמוס),"
        },
        {
          "s": 23,
          "text": "אין שייך בו שינוי."
        },
        {
          "s": 24,
          "text": "וזהו מ\"ש וגם נצח ישראל גו' לא ינחם כי לא אדם הוא להנחם,"
        },
        {
          "s": 25,
          "text": "שהשרש דנצח ישראל הוא בהרצון שלמעלה מטעם,"
        },
        {
          "s": 26,
          "text": "ולכן אין שייך בו נחמה."
        }
      ]
    }
  ]
}