{
  "globalIndex": 822,
  "owner": 22,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918679_theRebbe_674__p004",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918679_theRebbe_674__p004",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918679_theRebbe_674",
  "title": "מאמר אנכי הוי' אלוקיך תשמ\"ט",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה,"
        },
        {
          "s": 2,
          "text": "כמו שבמתן תורה בפעם הראשונה נעשה תוקף בקיום העולם כמאמר חז\"ל44"
        },
        {
          "s": 3,
          "text": "עה\"פ45"
        },
        {
          "s": 4,
          "text": "ארץ יראה ושקטה,"
        },
        {
          "s": 5,
          "text": "שעד יום הששי בסיון ארץ יראה,"
        },
        {
          "s": 6,
          "text": "וביום הששי בסיון,"
        },
        {
          "s": 7,
          "text": "כשישראל קיבלו את התורה,"
        },
        {
          "s": 8,
          "text": "שקטה,"
        },
        {
          "s": 9,
          "text": "עד\"ז הוא בכל שנה ושנה,"
        },
        {
          "s": 10,
          "text": "שע\"י ההוספה במתן תורה ובקבלת התורה נעשית הוספה בהתוקף דקיום העולם."
        },
        {
          "s": 11,
          "text": "וע\"ד משנת\"ל"
        },
        {
          "s": 12,
          "text": "(ס\"ג)"
        },
        {
          "s": 13,
          "text": "שע\"י עסק התורה באופן דיהיו בעיניך חדשים מגלים גם החידוש שישנו בהעולם,"
        },
        {
          "s": 14,
          "text": "שהוא מתחדש בכל רגע מאין ליש בכח העצמות."
        },
        {
          "s": 15,
          "text": "דיש לומר שענין זה"
        },
        {
          "s": 16,
          "text": "[גילוי כח האלקי שמהוה את העולם מאין ליש]"
        },
        {
          "s": 17,
          "text": "הוא אמיתית הענין דשקטה."
        },
        {
          "s": 18,
          "text": "ועפ\"ז יש להוסיף,"
        },
        {
          "s": 19,
          "text": "דזה שבכל שנה צריך להוסיף בההכנות למתן תורה וקבלת התורה,"
        },
        {
          "s": 20,
          "text": "נכלל בזה גם הוספה בג' העמודים שעליהם העולם עומד,"
        },
        {
          "s": 21,
          "text": "תורה עבודה וגמ\"ח46."
        },
        {
          "s": 22,
          "text": "ובפרט בצדקה,"
        },
        {
          "s": 23,
          "text": "דנוסף לזה שהוא אחד העמודים דהעולם,"
        },
        {
          "s": 24,
          "text": "הוא"
        },
        {
          "s": 25,
          "text": "(גם)"
        },
        {
          "s": 26,
          "text": "כללות כל התורה,"
        },
        {
          "s": 27,
          "text": "כמבואר בתו\"א ד\"ה בחודש השלישי47."
        },
        {
          "s": 28,
          "text": "ולכן נוסף על הסיום"
        },
        {
          "s": 29,
          "text": "(כנהוג)"
        },
        {
          "s": 30,
          "text": "בעשיית כל אחד ואחת לשליח במצות צדקה – צריך להיות בערב חג השבועות,"
        },
        {
          "s": 31,
          "text": "ערב זמן מתן תורתנו,"
        },
        {
          "s": 32,
          "text": "הוספה מיוחדת בנתינת הצדקה,"
        },
        {
          "s": 33,
          "text": "ועד שנתינת הצדקה ביום זה תהי' באופן של פתיחה חדשה,"
        },
        {
          "s": 34,
          "text": "דע\"י פתיחה זו נעשה גם הוספה בההשפעה מידו הפתוחה"
        },
        {
          "s": 35,
          "text": "(המלאה הפתוחה הקדושה והרחבה48)"
        },
        {
          "s": 36,
          "text": "בנוגע לכל הענינים,"
        },
        {
          "s": 37,
          "text": "ובפרט בהענין דמתן תורה,"
        },
        {
          "s": 38,
          "text": "מתחיל מהדיבור הראשון אנכי גו' אשר הוצאתיך מארץ מצרים,"
        },
        {
          "s": 39,
          "text": "שיוצאים מכל המיצרים וגבולים,"
        },
        {
          "s": 40,
          "text": "ונעשים חד עם אנכי נותן התורה."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "וענין זה"
        },
        {
          "s": 1,
          "text": "(דיציאה ממיצרים וגבולים)"
        },
        {
          "s": 2,
          "text": "בא בהנשמה כמו שהיא מלובשת בגוף,"
        },
        {
          "s": 3,
          "text": "לאורך ימים ושנים טובות,"
        },
        {
          "s": 4,
          "text": "גוף בריא ונשמה בריאה."
        },
        {
          "s": 5,
          "text": "וע\"י לימוד גליא דתורה"
        },
        {
          "s": 6,
          "text": "(הגוף דתורה49)"
        },
        {
          "s": 7,
          "text": "ופנימיות התורה"
        },
        {
          "s": 8,
          "text": "(נשמתא דאורייתא49)"
        },
        {
          "s": 9,
          "text": "ששניהם הם תורה אחת,"
        },
        {
          "s": 10,
          "text": "נעשים גם הגוף והנשמה של האדם הלומד מציאות אחת,"
        },
        {
          "s": 11,
          "text": "מציאות שהיא חד עם אנכי,"
        },
        {
          "s": 12,
          "text": "נותן התורה."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "וע\"י שמכריזים על ענינים אלו בבית גדול,"
        },
        {
          "s": 1,
          "text": "בית שמגדלין בו תורה50"
        },
        {
          "s": 2,
          "text": "ובית שמגדלין בו תפלה51,"
        },
        {
          "s": 3,
          "text": "דתפלה הוא בקשת כל צרכיו,"
        },
        {
          "s": 4,
          "text": "הן צרכיו הרוחניים והן צרכיו הגשמיים,"
        },
        {
          "s": 5,
          "text": "הנה עי\"ז ניתוסף עוד יותר בכל הנ\"ל,"
        },
        {
          "s": 6,
          "text": "שהקב\"ה עוזר לקיים את כל ההחלטות"
        },
        {
          "s": 7,
          "text": "(שהם גם בקשה ותפלה)"
        },
        {
          "s": 8,
          "text": "דההכנות למתן תורה,"
        },
        {
          "s": 9,
          "text": "וגם ממלא הבקשות בנוגע לההמשכה דמ\"ת"
        },
        {
          "s": 10,
          "text": "[ובפרט שנמצאים בבית שמגדלין בו תורה],"
        },
        {
          "s": 11,
          "text": "שהמשכת התורה תהי' בשלימות ובאופן חדש לגמרי כנ\"ל,"
        },
        {
          "s": 12,
          "text": "ועד לתורה חדשה מאתי תצא52"
        },
        {
          "s": 13,
          "text": "בגאולה האמיתית והשלימה ע\"י משיח צדקנו."
        },
        {
          "s": 14,
          "text": "ולהוסיף,"
        },
        {
          "s": 15,
          "text": "דענין מתן תורה הוא – נתינת התורה למטה בארץ,"
        },
        {
          "s": 16,
          "text": "ובאופן שלא בשמים היא53."
        },
        {
          "s": 17,
          "text": "וכמחז\"ל54"
        },
        {
          "s": 18,
          "text": "שהקב\"ה אומר למלאכי השרת אני ואתם נלך אצל ב\"ד של מטה כו'."
        }
      ]
    }
  ]
}