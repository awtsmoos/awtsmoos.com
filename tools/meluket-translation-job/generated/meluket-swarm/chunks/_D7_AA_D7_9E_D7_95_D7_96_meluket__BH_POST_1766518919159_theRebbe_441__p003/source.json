{
  "globalIndex": 903,
  "owner": 3,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919159_theRebbe_441__p003",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919159_theRebbe_441__p003",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919159_theRebbe_441",
  "title": "מאמר ה' לי בעוזרי תשי\"ז",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וזהו זמירות היו לי חוקיך"
        },
        {
          "s": 2,
          "text": "(חוקיך דוקא),"
        },
        {
          "s": 3,
          "text": "דכוונת הכתוב בחוקיך היא"
        },
        {
          "s": 4,
          "text": "(לא להסוג דחוקים,"
        },
        {
          "s": 5,
          "text": "כ\"א)"
        },
        {
          "s": 6,
          "text": "לכל המצוות,"
        },
        {
          "s": 7,
          "text": "דכאשר קיומם"
        },
        {
          "s": 8,
          "text": "(וכן לימודם)"
        },
        {
          "s": 9,
          "text": "הוא מצד ציווי וגזירת הקב\"ה"
        },
        {
          "s": 10,
          "text": "(באופן דחוקיך,"
        },
        {
          "s": 11,
          "text": "חוקה חקקתי גזירה גזרתי),"
        },
        {
          "s": 12,
          "text": "אזי דוקא זמירות היו לי."
        },
        {
          "s": 13,
          "text": "והענין הוא,"
        },
        {
          "s": 14,
          "text": "דזה שכל העולמות בטלים במציאות לגבי"
        },
        {
          "s": 15,
          "text": "(דקדוק אחד מדקדוקי)"
        },
        {
          "s": 16,
          "text": "תורה,"
        },
        {
          "s": 17,
          "text": "הוא בעיקר מצד זה ששרש התורה הוא בכתר שלמעלה מהחכמה,"
        },
        {
          "s": 18,
          "text": "שמצד בחינה זו,"
        },
        {
          "s": 19,
          "text": "המצוות וכן כל דקדוקי ההלכות שבהם,"
        },
        {
          "s": 20,
          "text": "הם מצד זה שכן עלה ברצונו ית',"
        },
        {
          "s": 21,
          "text": "רצון שלמעלה מטעם."
        },
        {
          "s": 22,
          "text": "דבבחינת התורה כמו שנמשכה בחכמה,"
        },
        {
          "s": 23,
          "text": "מכיון שהמצוות והדקדוקים שבהם"
        },
        {
          "s": 24,
          "text": "(מצד בחינת החכמה)"
        },
        {
          "s": 25,
          "text": "הם מצד הטעם,"
        },
        {
          "s": 26,
          "text": "שבכדי שע\"י התפילין יומשכו מוחין העליונים בעולמות צריכים להיות באופן כזה דוקא,"
        },
        {
          "s": 27,
          "text": "הרי בהכרח שיש איזה ערך ותפיסת מקום להעולמות,"
        },
        {
          "s": 28,
          "text": "שהרי כל דקדוקי ההלכות שמצד בחינה זו הם בכדי שיומשך השפע בעולמות,"
        },
        {
          "s": 29,
          "text": "ולכן מדייק זמירות היו לי חוקיך"
        },
        {
          "s": 30,
          "text": "(דוקא)"
        },
        {
          "s": 31,
          "text": "בבית מגורי,"
        },
        {
          "s": 32,
          "text": "דכשעסק התורה שלו הוא באופן שיודע ומרגיש שכל דקדוקי התורה הם מצד זה שכן עלה ברצונו ית'"
        },
        {
          "s": 33,
          "text": "(חוקיך),"
        },
        {
          "s": 34,
          "text": "אזי נרגש אצלו איך שכל העולמות בטלים במציאות לגבי דקדוק אחד מדקדוקי תורה,"
        },
        {
          "s": 35,
          "text": "ובמילא,"
        },
        {
          "s": 36,
          "text": "הדברי תורה שלומד הם לו זמירות"
        },
        {
          "s": 37,
          "text": "(תענוג ושעשועים)"
        },
        {
          "s": 38,
          "text": "גם בבית מגוריו,"
        },
        {
          "s": 39,
          "text": "כי כל הרדיפות שסובל משונאיו אינם תופסים מקום אצלו,"
        },
        {
          "s": 40,
          "text": "ויתירה מזו,"
        },
        {
          "s": 41,
          "text": "שעי\"ז נמשך כן גם בעולם,"
        },
        {
          "s": 42,
          "text": "שהשונאים והרודפים מתבטלים,"
        },
        {
          "s": 43,
          "text": "זמירות מלשון לזמר עריצים."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וביאור הענין בעומק יותר,"
        },
        {
          "s": 2,
          "text": "יובן בהקדים תחילה ענין עדות."
        },
        {
          "s": 3,
          "text": "שגם ענין זה הוא בכל המצוות"
        },
        {
          "s": 4,
          "text": "(גם בהמצוות דחוקים ודמשפטים),"
        },
        {
          "s": 5,
          "text": "ע\"ד שנת\"ל בנוגע למשפטים וחוקים."
        },
        {
          "s": 6,
          "text": "והענין הוא,"
        },
        {
          "s": 7,
          "text": "כמו שמבאר בעל הגאולה בהמאמר ד\"ה ויקם30"
        },
        {
          "s": 8,
          "text": "עדות ביעקב ותורה שם בישראל31,"
        },
        {
          "s": 9,
          "text": "דמה שהמצוות"
        },
        {
          "s": 10,
          "text": "(גם המצוות דמשפטים ודחוקים)"
        },
        {
          "s": 11,
          "text": "נק' עדות הוא לפי שהם ממשיכים ומגלים העלם העצמי דעצמות אוא\"ס,"
        },
        {
          "s": 12,
          "text": "שלמעלה מההעלם השייך לגילוי."
        },
        {
          "s": 13,
          "text": "דכמו שענין העדות בפשטות הוא על דבר הנעלם דוקא,"
        },
        {
          "s": 14,
          "text": "דעל דבר הגלוי אין שייך עדות,"
        },
        {
          "s": 15,
          "text": "מכיון שהוא גלוי,"
        },
        {
          "s": 16,
          "text": "ואפילו על מילתא דעבידא לאגלויי אין צריך עדות32,"
        },
        {
          "s": 17,
          "text": "עד\"ז הוא ברוחניות,"
        },
        {
          "s": 18,
          "text": "דאור הממלא הוא דבר הגלוי שמושג מצד השכל,"
        },
        {
          "s": 19,
          "text": "וכידוע33"
        },
        {
          "s": 20,
          "text": "בענין ומבשרי34"
        },
        {
          "s": 21,
          "text": "אחזה אלוקה,"
        },
        {
          "s": 22,
          "text": "דכמו שברור לאדם שיש נפש שמחי' את גופו,"
        },
        {
          "s": 23,
          "text": "דע\"י שמרגיש שגופו חי הוא יודע ברור שאין זה מצד הגוף עצמו אלא שיש נפש שמחי' את גופו,"
        },
        {
          "s": 24,
          "text": "כמו\"כ הוא גם בנוגע לעולם,"
        },
        {
          "s": 25,
          "text": "דע\"י שרואים עולם חי יודעים בבירור35"
        },
        {
          "s": 26,
          "text": "שיש חיות אלקי שמחי' את העולם."
        },
        {
          "s": 27,
          "text": "ואור הסובב שלמעלה מהתלבשות בעולמות הוא מילתא דעבידא לאגלויי"
        },
        {
          "s": 28,
          "text": "(העלם ששייך לגילוי)."
        },
        {
          "s": 29,
          "text": "וכמבואר בכ\"מ36,"
        },
        {
          "s": 30,
          "text": "דע\"י ההשגה באור הממלא שמתלבש בעולמות,"
        },
        {
          "s": 31,
          "text": "שהוא הארה בלבד"
        },
        {
          "s": 32,
          "text": "(כדמוכח מזה גופא שהוא בהתלבשות),"
        },
        {
          "s": 33,
          "text": "מזה באים לידי ידיעה שישנו אור שהוא מופלא מעולמות,"
        },
        {
          "s": 34,
          "text": "שהוא המקור שממנו נמשך ההארה שבהתלבשות."
        },
        {
          "s": 35,
          "text": "והוא ע\"ד מה שהשכל גופא מכריח שיש למעלה מהשכל."
        },
        {
          "s": 36,
          "text": "וענין העדות הוא בעצמות אוא\"ס,"
        },
        {
          "s": 37,
          "text": "שלמעלה גם מסובב,"
        },
        {
          "s": 38,
          "text": "שהוא נעלם לגמרי,"
        },
        {
          "s": 39,
          "text": "ואין שייך בו שום ידיעה והשגה,"
        },
        {
          "s": 40,
          "text": "גם לא ידיעת השלילה37."
        },
        {
          "s": 41,
          "text": "וזהו מה שכל המצוות נק' עדות,"
        },
        {
          "s": 42,
          "text": "לפי שהם ממשיכים ומגלים עצמות אוא\"ס שלמעלה גם מסובב."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "וצריך להבין,"
        },
        {
          "s": 2,
          "text": "והרי זה שהמצוות הם עדות על עצמות אוא\"ס הוא מפני שהם רצונו ית',"
        },
        {
          "s": 3,
          "text": "רצון שלמעלה מטעם38,"
        },
        {
          "s": 4,
          "text": "ומהו החילוק בין ענין עדות לענין חוקים."
        },
        {
          "s": 5,
          "text": "וגם צריך להבין השייכות של הסוג דמצוות שנק' עדות מפני שהם אות וזכרון,"
        },
        {
          "s": 6,
          "text": "ענין הטעם,"
        },
        {
          "s": 7,
          "text": "עם ענין העדות שבכללות המצוות,"
        },
        {
          "s": 8,
          "text": "זה שהם מעידים על עצמות אוא\"ס מפני שהם רצון שלמעלה מטעם."
        },
        {
          "s": 9,
          "text": "והענין הוא,"
        },
        {
          "s": 10,
          "text": "דענין העדות שבמצוות בעבודת האדם היא העבודה דרעותא דלבא39,"
        },
        {
          "s": 11,
          "text": "דרעותא דלבא הוא הרצון באלקות שמצד עצם הנשמה,"
        },
        {
          "s": 12,
          "text": "שעי\"ז תופסים בהעצמות,"
        },
        {
          "s": 13,
          "text": "כמאמר40"
        },
        {
          "s": 14,
          "text": "לית מחשבה תפיסא בי' כלל"
        },
        {
          "s": 15,
          "text": "(בי' קאי על פנימיות ועצמות אוא\"ס שלמעלה מסובב,"
        },
        {
          "s": 16,
          "text": "שאינו נתפס בשום השגה,"
        },
        {
          "s": 17,
          "text": "גם לא בהשגת השלילה)"
        },
        {
          "s": 18,
          "text": "אבל נתפס איהו ברעותא דלבא."
        },
        {
          "s": 19,
          "text": "והעבודה דחוקים היא העבודה דקבלת עול."
        },
        {
          "s": 20,
          "text": "דהחילוק שבין שתי עבודות אלו הוא,"
        },
        {
          "s": 21,
          "text": "דבהעבודה דרעותא דלבא,"
        },
        {
          "s": 22,
          "text": "מכיון שיש לו רצון,"
        },
        {
          "s": 23,
          "text": "הגם שהרצון הוא מצד ההתקשרות דעצם הנשמה בעצמות אוא\"ס,"
        },
        {
          "s": 24,
          "text": "ה\"ה בבחינת מציאות עדיין41."
        },
        {
          "s": 25,
          "text": "וגם כשהרצון שלו הוא בביטול,"
        },
        {
          "s": 26,
          "text": "שאינו רוצה לעצמו כלל וכל רצונו הוא שיהי' גילוי אלקות בעולם ושתושלם הכוונה דדירה42"
        },
        {
          "s": 27,
          "text": "לו ית' בתחתונים,"
        },
        {
          "s": 28,
          "text": "מ\"מ,"
        },
        {
          "s": 29,
          "text": "עצם ענין הרצון הוא מציאות."
        },
        {
          "s": 30,
          "text": "ואמיתית ענין הביטול הוא בהעבודה דקבלת עול43,"
        },
        {
          "s": 31,
          "text": "שהוא כמו עבד שאין לו שום רצונות כלל,"
        },
        {
          "s": 32,
          "text": "וכל מה שעושה הוא מצד עול האדון שמוטל עליו,"
        },
        {
          "s": 33,
          "text": "שמצד זה הוא מוכרח לקיים רצון האדון."
        }
      ]
    }
  ]
}