{
  "globalIndex": 638,
  "owner": 38,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917471_theRebbe_230__p001",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917471_theRebbe_230__p001",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917471_theRebbe_230",
  "title": "מאמר בלילה ההוא תשכ\"ה",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "פורים"
        },
        {
          "s": 2,
          "text": "(מאמר א),"
        },
        {
          "s": 3,
          "text": "ה'תשכ\"ה"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "בלילה ההוא נדדה שנת המלך1,"
        },
        {
          "s": 1,
          "text": "וצריך להבין,"
        },
        {
          "s": 2,
          "text": "אומרו בלילה ההוא,"
        },
        {
          "s": 3,
          "text": "דלכאורה,"
        },
        {
          "s": 4,
          "text": "גם כשהי' אומר בלילה סתם היו יודעים שקאי על הלילה שבה היו המאורעות הכתובים בפסוקים שלפניו."
        },
        {
          "s": 5,
          "text": "ויש לבאר זה ע\"פ מה שמביא כ\"ק מו\"ח אדמו\"ר במאמרו ד\"ה זה2"
        },
        {
          "s": 6,
          "text": "דאיתא במנהגי מהרי\"ל3"
        },
        {
          "s": 7,
          "text": "דמבלילה ההוא צריך להגבי' את קולו בקריאתו לפי שזהו עיקר הנס."
        },
        {
          "s": 8,
          "text": "ומבאר בהמאמר ע\"פ מ\"ש בילקוט4"
        },
        {
          "s": 9,
          "text": "דנדדה שנת המלך זה מלכו של עולם."
        },
        {
          "s": 10,
          "text": "דכשישראל הם במצב של שינה,"
        },
        {
          "s": 11,
          "text": "נעשה שינה כביכול במלכו של עולם."
        },
        {
          "s": 12,
          "text": "וכמ\"ש5"
        },
        {
          "s": 13,
          "text": "אני ישנה ואיתא בזהר6"
        },
        {
          "s": 14,
          "text": "בגלותא,"
        },
        {
          "s": 15,
          "text": "דע\"י השינה דישראל בזמן הגלות7,"
        },
        {
          "s": 16,
          "text": "הם גורמים שינה כביכול למעלה7."
        },
        {
          "s": 17,
          "text": "וזהו שבלילה ההוא נדדה שנת המלך הוא עיקרו של נס,"
        },
        {
          "s": 18,
          "text": "לילה הוא זמן הגלות8,"
        },
        {
          "s": 19,
          "text": "שהוא זמן של שינה"
        },
        {
          "s": 20,
          "text": "(למעלה),"
        },
        {
          "s": 21,
          "text": "וזה שבלילה ההוא"
        },
        {
          "s": 22,
          "text": "(גלות)"
        },
        {
          "s": 23,
          "text": "נדדה שנת המלך מלכו של עולם הוא עיקרו של נס."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש לבאר דיוק הכתוב בלילה ההוא,"
        },
        {
          "s": 1,
          "text": "הוא לשון נסתר מורה על העלם"
        },
        {
          "s": 2,
          "text": "(שני פעמים הסתר,"
        },
        {
          "s": 3,
          "text": "לילה והוא),"
        },
        {
          "s": 4,
          "text": "שנוסף על ההעלם וההסתר דגלות"
        },
        {
          "s": 5,
          "text": "(לילה)"
        },
        {
          "s": 6,
          "text": "בכלל,"
        },
        {
          "s": 7,
          "text": "הנה אז,"
        },
        {
          "s": 8,
          "text": "בימי אחשורוש,"
        },
        {
          "s": 9,
          "text": "הי' ההעלם וההסתר עוד יותר,"
        },
        {
          "s": 10,
          "text": "הסתר כפול."
        },
        {
          "s": 11,
          "text": "וכדאיתא בגמרא9"
        },
        {
          "s": 12,
          "text": "אסתר מן התורה מנין ואנכי10"
        },
        {
          "s": 13,
          "text": "הסתר אסתיר."
        },
        {
          "s": 14,
          "text": "וע\"פ תורת הבעש\"ט11"
        },
        {
          "s": 15,
          "text": "דפירוש הסתר אסתיר"
        },
        {
          "s": 16,
          "text": "(שתי פעמים)"
        },
        {
          "s": 17,
          "text": "שההסתר הוא מוסתר,"
        },
        {
          "s": 18,
          "text": "יש לומר,"
        },
        {
          "s": 19,
          "text": "שכן הוא גם הפירוש דבלילה ההוא,"
        },
        {
          "s": 20,
          "text": "שהלילה דגלות הוא באופן דהוא הסתר,"
        },
        {
          "s": 21,
          "text": "היינו שאין מרגישים שהגלות הוא לילה וחושך,"
        },
        {
          "s": 22,
          "text": "שמים12"
        },
        {
          "s": 23,
          "text": "חושך לאור."
        },
        {
          "s": 24,
          "text": "והכתוב מדייק בלילה ההוא נדדה שנת המלך,"
        },
        {
          "s": 25,
          "text": "להדגיש יותר גודל ותוקף13"
        },
        {
          "s": 26,
          "text": "הנס."
        },
        {
          "s": 27,
          "text": "דהגם שהשינה דישראל אז היתה שינה בתכלית"
        },
        {
          "s": 28,
          "text": "[וע\"ד המבואר במק\"א14"
        },
        {
          "s": 29,
          "text": "החילוק בין שינה לתרדמה,"
        },
        {
          "s": 30,
          "text": "שהישנים יודעים שהחלום אינו אלא חלום שהוא שקר משא\"כ הנרדמים חושבים את השקר לאמת],"
        },
        {
          "s": 31,
          "text": "שזה גורם שינה כזו כביכול גם למעלה,"
        },
        {
          "s": 32,
          "text": "מ\"מ,"
        },
        {
          "s": 33,
          "text": "נדדה שנת המלך מלכו של עולם,"
        },
        {
          "s": 34,
          "text": "אפילו שינה סתם,"
        },
        {
          "s": 35,
          "text": "נדדה."
        }
      ]
    }
  ]
}