{
  "globalIndex": 143,
  "owner": 43,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914519_theRebbe_363__p003",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914519_theRebbe_363__p003",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914519_theRebbe_363",
  "title": "מאמר ביום השמיני עצרת תש\"מ",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ועד\"ז הוא גם בתשובה כפשוטה,"
        },
        {
          "s": 2,
          "text": "דכאשר האדם חטא ופגם והעביר את הדרך"
        },
        {
          "s": 3,
          "text": "(שזהו היפך טבע האדם וטבע דלמעלה)"
        },
        {
          "s": 4,
          "text": "ואח\"כ מתקן זה ע\"י התשובה,"
        },
        {
          "s": 5,
          "text": "ובפרט כשהתשובה היא באופן דזדונות נעשו לו כזכיות65,"
        },
        {
          "s": 6,
          "text": "הנה עי\"ז נעשה ענין חדש שלמעלה מטבע האדם ומהטבע שלמעלה"
        },
        {
          "s": 7,
          "text": "(דטבע הטוב להטיב),"
        },
        {
          "s": 8,
          "text": "וגם למעלה משרש הנשמות כמו שהן בבחי' במי נמלך."
        },
        {
          "s": 9,
          "text": "והענין הוא,"
        },
        {
          "s": 10,
          "text": "כי עבודת התשובה היא בדרך דילוג66"
        },
        {
          "s": 11,
          "text": "מה שהאדם משתנה ונהפך"
        },
        {
          "s": 12,
          "text": "(שלא בסדר והדרגה)"
        },
        {
          "s": 13,
          "text": "ונעשה מציאות חדשה67."
        },
        {
          "s": 14,
          "text": "דזהו מה שתשובה היא למעלה מהזמן שלכן גם כמו שהיא נמשכת בבחי' הזמן היא בשעתא חדא וברגעא חדא68,"
        },
        {
          "s": 15,
          "text": "לפי69"
        },
        {
          "s": 16,
          "text": "שעבודת התשובה היא שלא בהדרגה."
        },
        {
          "s": 17,
          "text": "וזהו גם מה שבבע\"ת נאמר והי' טרם יקראו ואני אענה70,"
        },
        {
          "s": 18,
          "text": "דענין זה"
        },
        {
          "s": 19,
          "text": "(מענה טרם הקריאה)"
        },
        {
          "s": 20,
          "text": "הוא היפך הטבע וההשתלשלות,"
        },
        {
          "s": 21,
          "text": "כי ע\"י הדילוג"
        },
        {
          "s": 22,
          "text": "(דתשובה)"
        },
        {
          "s": 23,
          "text": "שלא בסדר ההשתלשלות שבאדם,"
        },
        {
          "s": 24,
          "text": "עי\"ז נעשה גם למעלה שלא בסדר ההשתלשלות,"
        },
        {
          "s": 25,
          "text": "וע\"ד מ\"ש71"
        },
        {
          "s": 26,
          "text": "ממעמקים קראתיך הוי',"
        },
        {
          "s": 27,
          "text": "ממעמקים"
        },
        {
          "s": 28,
          "text": "(לשון רבים)"
        },
        {
          "s": 29,
          "text": "הוא מעומק לעומק72,"
        },
        {
          "s": 30,
          "text": "דע\"י עבודת התשובה מעומק פנימיות נקודת הלב,"
        },
        {
          "s": 31,
          "text": "עי\"ז הוא קורא וממשיך מבחי' עומק ופנימיות א\"ס ב\"ה73"
        },
        {
          "s": 32,
          "text": "[ועד שענין התשובה מגיע בעצמותו ית',"
        },
        {
          "s": 33,
          "text": "כידוע בענין שאלו להקב\"ה כו' אמר יעשה תשובה ויתכפר לו74]."
        },
        {
          "s": 34,
          "text": "וע\"י המשכה זו,"
        },
        {
          "s": 35,
          "text": "זדונות נעשו לו כזכיות73."
        },
        {
          "s": 36,
          "text": "דכמו שע\"י התשובה נעשה ענין חדש באדם שנעשה מציאות חדשה כנ\"ל,"
        },
        {
          "s": 37,
          "text": "כמו\"כ נעשה עי\"ז ענין חדש בעולם75"
        },
        {
          "s": 38,
          "text": "שזדונות נהפכים לזכיות."
        },
        {
          "s": 39,
          "text": "וזכיות אלו"
        },
        {
          "s": 40,
          "text": "(שמהפכים מהזדונות),"
        },
        {
          "s": 41,
          "text": "מכיון שנעשים ע\"י הדילוג דתשובה,"
        },
        {
          "s": 42,
          "text": "הם נעלים יותר76"
        },
        {
          "s": 43,
          "text": "מהזכיות דצדיקים."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וזהו מה שבלוחות האחרונות"
        },
        {
          "s": 2,
          "text": "(שבעבודת האדם הו\"ע עבודת התשובה כנ\"ל)"
        },
        {
          "s": 3,
          "text": "כתיב כפלים לתושי',"
        },
        {
          "s": 4,
          "text": "שהכוונה בכפלים היא לא רק כפלים במספר77"
        },
        {
          "s": 5,
          "text": "כי אם לריבוי גדול יותר ועד באין ערוך"
        },
        {
          "s": 6,
          "text": "[כמובן גם מזה שבלוחות האחרונות נתוספו ריבוי ענינים,"
        },
        {
          "s": 7,
          "text": "הלכות מדרש ואגדות78],"
        },
        {
          "s": 8,
          "text": "כי נוסף על זה שבבע\"ת יש ב' סוגי זכיות"
        },
        {
          "s": 9,
          "text": "(כפלים במספר)"
        },
        {
          "s": 10,
          "text": "הזכיות דתומ\"צ"
        },
        {
          "s": 11,
          "text": "(כמו בצדיקים)"
        },
        {
          "s": 12,
          "text": "והזכיות שנעשו מהפיכת הזדונות,"
        },
        {
          "s": 13,
          "text": "הרי הזכיות שנעשו מהפיכת הזדונות הם נעלים יותר ועד באין ערוך מזכיות הצדיקים."
        },
        {
          "s": 14,
          "text": "ויתירה מזו,"
        },
        {
          "s": 15,
          "text": "שגם התומ\"צ שלאחרי התשובה הם נעלים יותר,"
        },
        {
          "s": 16,
          "text": "בחילא יתיר79."
        },
        {
          "s": 17,
          "text": "וזהו גם מהביאורים בזה שגאולה העתידה היא ע\"י הקדמת עבודת התשובה דוקא80,"
        },
        {
          "s": 18,
          "text": "כי גם השגת התורה דלע\"ל תהי' כפלים לתושי'."
        },
        {
          "s": 19,
          "text": "ולא רק כפלים במספר,"
        },
        {
          "s": 20,
          "text": "ההשגה בכל מה שלמדו עכשיו בנגלה דתורה ובפנימיות התורה"
        },
        {
          "s": 21,
          "text": "(ותלמודו בידו81)"
        },
        {
          "s": 22,
          "text": "וההשגה בתורתו של משיח,"
        },
        {
          "s": 23,
          "text": "אלא גם לריבוי ביותר ועד לאין ערוך,"
        },
        {
          "s": 24,
          "text": "שהרי בביאת המשיח יהי' ישקני מנשיקות פיהו82"
        },
        {
          "s": 25,
          "text": "שיתגלה סוד טעמי' ומסתר צפונותי'83"
        },
        {
          "s": 26,
          "text": "(תעלומות חכמה)."
        },
        {
          "s": 27,
          "text": "ויתירה מזו,"
        },
        {
          "s": 28,
          "text": "שעי\"ז גם השגת הנגלה דתורה תהי' באופן נעלה יותר."
        },
        {
          "s": 29,
          "text": "ועד\"ז ע\"י העבודה דתומ\"צ בזמן הגלות,"
        },
        {
          "s": 30,
          "text": "דכללות העבודה שבזמן הגלות"
        },
        {
          "s": 31,
          "text": "(גם העבודה דתומ\"צ)"
        },
        {
          "s": 32,
          "text": "היא עבודת התשובה וע\"י התשובה כפלים לתושי'."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ויובן זה על פי הידוע84"
        },
        {
          "s": 2,
          "text": "שהחילוק בין תלמוד בבלי לתלמוד ירושלמי הוא בדוגמת החילוק בין לוחות הראשונות ללוחות האחרונות."
        },
        {
          "s": 3,
          "text": "דתלמוד85"
        },
        {
          "s": 4,
          "text": "ירושלמי הוא בדרך אור ישר"
        },
        {
          "s": 5,
          "text": "(דוגמת עבודת הצדיקים,"
        },
        {
          "s": 6,
          "text": "לוחות הראשונות),"
        },
        {
          "s": 7,
          "text": "ותלמוד בבלי הוא הפלפול בריבוי קושיות והעלמות,"
        },
        {
          "s": 8,
          "text": "במחשכים הושיבני86"
        },
        {
          "s": 9,
          "text": "זה תלמוד בבלי87,"
        },
        {
          "s": 10,
          "text": "ואעפ\"כ הלכה כבבלי דוקא88,"
        },
        {
          "s": 11,
          "text": "כי ע\"י היגיעה בבירור הקושיות וכו' מגיעים לאמיתית הכוונה,"
        },
        {
          "s": 12,
          "text": "לבחי' העלם העצמי שבתורה,"
        },
        {
          "s": 13,
          "text": "בחי' תעלומות חכמה"
        },
        {
          "s": 14,
          "text": "(דוגמת מעלת הזכיות דבע\"ת שנעשים מהזדונות,"
        },
        {
          "s": 15,
          "text": "על הזכיות דצדיקים)."
        },
        {
          "s": 16,
          "text": "וזהו מה שבלוחות האחרונות דוקא כתיב ויגד לך תעלומות חכמה כי כפלים לתושי',"
        },
        {
          "s": 17,
          "text": "תעלומות חכמה הוא"
        },
        {
          "s": 18,
          "text": "(עד ל)"
        },
        {
          "s": 19,
          "text": "פנימיות ח\"ס,"
        },
        {
          "s": 20,
          "text": "ובשרשה היא פנימיות ועצמות א\"ס89,"
        },
        {
          "s": 21,
          "text": "וזה מתגלה ע\"י הפלפול וכו' דתלמוד בבלי דוקא."
        },
        {
          "s": 22,
          "text": "וגילוי זה יהי' בעיקר לע\"ל,"
        },
        {
          "s": 23,
          "text": "וכדאיתא בזהר90"
        },
        {
          "s": 24,
          "text": "עה\"פ91"
        },
        {
          "s": 25,
          "text": "עין לא ראתה גו' יעשה למחכה לו מאי למחכה לו כו' אינון דדחקין למלה דחוכמתא ודייקין לי' ומחכאן לי' למנדע ברירא דמלה כו',"
        },
        {
          "s": 26,
          "text": "שע\"י ריבוי העיון והיגיעה בריבוי קושיות וכו',"
        },
        {
          "s": 27,
          "text": "יהי'"
        },
        {
          "s": 28,
          "text": "(לע\"ל)"
        },
        {
          "s": 29,
          "text": "הגילוי דבחי' עדן שעליו נאמר עין לא ראתה92,"
        },
        {
          "s": 30,
          "text": "בחי' העלם העצמי."
        },
        {
          "s": 31,
          "text": "ועי\"ז נעשה עילוי ושלימות גם בהתורה שהיא מתקשרת עם העצמות"
        },
        {
          "s": 32,
          "text": "(בדוגמת דוד הי' מחבר תורה שלמעלה בהקב\"ה93),"
        },
        {
          "s": 33,
          "text": "דהתורה מצ\"ע"
        },
        {
          "s": 34,
          "text": "(כמו שניתנה במ\"ת,"
        },
        {
          "s": 35,
          "text": "בלוחות הראשונות)"
        },
        {
          "s": 36,
          "text": "היא בחי' חכמה,"
        },
        {
          "s": 37,
          "text": "דאורייתא מחכמה נפקת94,"
        },
        {
          "s": 38,
          "text": "והגם שבמ\"ת ניתנה גם התורה שתתגלה לע\"ל"
        },
        {
          "s": 39,
          "text": "(שהרי מ\"ת הי' רק פעם אחת)95,"
        },
        {
          "s": 40,
          "text": "הנה בעת מ\"ת ניתן זה בבחי' העלם,"
        },
        {
          "s": 41,
          "text": "תעלומות חכמה,"
        },
        {
          "s": 42,
          "text": "ובכדי להמשיך זה בגילוי"
        },
        {
          "s": 43,
          "text": "(באופן דתורה אור96),"
        },
        {
          "s": 44,
          "text": "הנה כח זה ניתן בלוחות האחרונות דוקא."
        },
        {
          "s": 45,
          "text": "וזהו מה שע\"י עסק התורה בזמן הגלות דוקא"
        },
        {
          "s": 46,
          "text": "(תלמוד בבלי)"
        },
        {
          "s": 47,
          "text": "יהי' הגילוי דלע\"ל שאז תושלם הכוונה דדירה97"
        },
        {
          "s": 48,
          "text": "בתחתונים,"
        },
        {
          "s": 49,
          "text": "כי בדירה בתחתונים ב' ענינים,"
        },
        {
          "s": 50,
          "text": "דירה לו לעצמותו98"
        },
        {
          "s": 51,
          "text": "ודירה בתחתונים,"
        },
        {
          "s": 52,
          "text": "וב' ענינים אלו נעשים99"
        },
        {
          "s": 53,
          "text": "ע\"י העסק והיגיעה בתלמוד בבלי דוקא."
        },
        {
          "s": 54,
          "text": "דע\"י היגיעה בבירור הקושיות מגיעים לבחי' העלם העצמי כנ\"ל,"
        },
        {
          "s": 55,
          "text": "לו לעצמותו,"
        },
        {
          "s": 56,
          "text": "ועי\"ז מגיעים גם לאמיתית הכוונה לפסוק הלכה למעשה כנ\"ל,"
        },
        {
          "s": 57,
          "text": "וע\"י העשי' בפועל"
        },
        {
          "s": 58,
          "text": "(כפי פסק ההלכה)"
        },
        {
          "s": 59,
          "text": "נעשה דירה לו ית' בתחתונים."
        },
        {
          "s": 60,
          "text": "וזהו במחשכים הושיבני"
        },
        {
          "s": 61,
          "text": "(זה תלמוד בבלי),"
        },
        {
          "s": 62,
          "text": "דע\"י במחשכים"
        },
        {
          "s": 63,
          "text": "(היגיעה בריבוי הקושיות וכו')"
        },
        {
          "s": 64,
          "text": "נעשה הושיבני,"
        },
        {
          "s": 65,
          "text": "דירה לו ית' בתחתונים."
        }
      ]
    }
  ]
}