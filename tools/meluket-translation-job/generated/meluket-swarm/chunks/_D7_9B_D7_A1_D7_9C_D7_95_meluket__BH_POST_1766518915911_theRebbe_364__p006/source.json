{
  "globalIndex": 380,
  "owner": 30,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915911_theRebbe_364__p006",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915911_theRebbe_364__p006",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915911_theRebbe_364",
  "title": "מאמר ברוך שעשה נסים תשמ\"ג",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "והנה לאחרי שמבאר בהמאמר"
        },
        {
          "s": 2,
          "text": "(ד\"ה ברוך שעשה נסים)"
        },
        {
          "s": 3,
          "text": "גודל העילוי דשמן המשחה,"
        },
        {
          "s": 4,
          "text": "הוא מבאר56,"
        },
        {
          "s": 5,
          "text": "דשמן למאור"
        },
        {
          "s": 6,
          "text": "(שבו הי' הנס דחנוכה)"
        },
        {
          "s": 7,
          "text": "הוא נעלה יותר גם משמן המשחה."
        },
        {
          "s": 8,
          "text": "דהנה האור שנעשה מהשמן"
        },
        {
          "s": 9,
          "text": "(דהאור בא מכליון השמן)"
        },
        {
          "s": 10,
          "text": "הוא למעלה מהשמן."
        },
        {
          "s": 11,
          "text": "והוא ע\"ד הריח שהי' בשמן המשחה שהוא למעלה מהשמן."
        },
        {
          "s": 12,
          "text": "[ויתירה מזו,"
        },
        {
          "s": 13,
          "text": "דהאור שנעשה מהשמן הוא למעלה גם מהריח דשמן,"
        },
        {
          "s": 14,
          "text": "כמבואר בהמאמר57]."
        },
        {
          "s": 15,
          "text": "והחילוק שביניהם הוא,"
        },
        {
          "s": 16,
          "text": "דהריח שבשמן המשחה הוא בשביל השמן,"
        },
        {
          "s": 17,
          "text": "שע\"י הריח נמשך השמן דח\"ס לגילוי,"
        },
        {
          "s": 18,
          "text": "שיוכלו לחנך בו את המזבח"
        },
        {
          "s": 19,
          "text": "(שיהי' ראוי לקרבנות ולנסכים),"
        },
        {
          "s": 20,
          "text": "משא\"כ בשמן ואור הוא אדרבה,"
        },
        {
          "s": 21,
          "text": "דהשמן הוא בשביל האור,"
        },
        {
          "s": 22,
          "text": "ועד שהשמן נכלה ונעשה ממנו אור."
        },
        {
          "s": 23,
          "text": "ועוד ענין בזה,"
        },
        {
          "s": 24,
          "text": "דהאור שנעשה מכליון השמן,"
        },
        {
          "s": 25,
          "text": "עם היות שמצד עצמו הוא בחי' העלם,"
        },
        {
          "s": 26,
          "text": "דנוסף לזה שהטבע דאור"
        },
        {
          "s": 27,
          "text": "(איזה אש שיהי')"
        },
        {
          "s": 28,
          "text": "הוא להסתלק לשרשו58,"
        },
        {
          "s": 29,
          "text": "הנה בנוגע לאור זה"
        },
        {
          "s": 30,
          "text": "(שנעשה מכליון השמן),"
        },
        {
          "s": 31,
          "text": "הרי אפילו שמן הוא בחי' העלם,"
        },
        {
          "s": 32,
          "text": "ועאכו\"כ האור שנעשה מכליון השמן ולמעלה ממנו,"
        },
        {
          "s": 33,
          "text": "ואעפ\"כ,"
        },
        {
          "s": 34,
          "text": "הוא59"
        },
        {
          "s": 35,
          "text": "נעשה אור המאיר."
        },
        {
          "s": 36,
          "text": "ולא עוד,"
        },
        {
          "s": 37,
          "text": "אלא שע\"י השמן הוא דולק בנחת60,"
        },
        {
          "s": 38,
          "text": "אור שבהתיישבות."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "ומכ\"ז מובן גודל העילוי של הנס דחנוכה שהי' בפך השמן,"
        },
        {
          "s": 3,
          "text": "שלא הי' בו אלא להדליק יום אחד ונעשה בו נס והדליקו ממנו שמונה ימים61,"
        },
        {
          "s": 4,
          "text": "דהאור שהדליקו משמן זה,"
        },
        {
          "s": 5,
          "text": "מכיון שהי' ע\"י נס,"
        },
        {
          "s": 6,
          "text": "הוא נעלה עוד יותר,"
        },
        {
          "s": 7,
          "text": "ואעפ\"כ,"
        },
        {
          "s": 8,
          "text": "גם אור זה האיר בגילוי,"
        },
        {
          "s": 9,
          "text": "ובהתיישבות."
        },
        {
          "s": 10,
          "text": "ויש לקשר זה גם עם זה שהדליקו שמונה ימים,"
        },
        {
          "s": 11,
          "text": "יומי דחנוכה תמניא אינון61,"
        },
        {
          "s": 12,
          "text": "דענין שמונת ימים הוא62"
        },
        {
          "s": 13,
          "text": "(כמבואר בהמאמר שם63)"
        },
        {
          "s": 14,
          "text": "ההמשכה מז' יומין דעתיק"
        },
        {
          "s": 15,
          "text": "(בחינה נעלית ביותר)"
        },
        {
          "s": 16,
          "text": "במלכות"
        },
        {
          "s": 17,
          "text": "(שרש הנבראים,"
        },
        {
          "s": 18,
          "text": "וע\"י המלכות נמשך אור זה בגילוי גם למטה)."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "ויהי רצון,"
        },
        {
          "s": 3,
          "text": "שבקרוב ממש נזכה לביאת משיח צדקנו,"
        },
        {
          "s": 4,
          "text": "שאז יהי' והכהו לשבעה נחלים64,"
        },
        {
          "s": 5,
          "text": "וביחד עם זה לכנור של שמונה נימין65,"
        },
        {
          "s": 6,
          "text": "ועד להכנור דעולם הבא שיהי' של עשר נימין65,"
        },
        {
          "s": 7,
          "text": "שגם כנור זה יהי' בבית המקדש השלישי שיבנה בביאת משיח צדקנו"
        },
        {
          "s": 8,
          "text": "(שהרי בית המקדש השלישי יהי' בית נצחי66),"
        },
        {
          "s": 9,
          "text": "וכל זה בקרוב ממש,"
        },
        {
          "s": 10,
          "text": "ועד באופן דמיד,"
        },
        {
          "s": 11,
          "text": "ובלשון הרמב\"ם67"
        },
        {
          "s": 12,
          "text": "מיד הן נגאלין."
        }
      ]
    }
  ]
}