{
  "globalIndex": 940,
  "owner": 40,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919340_theRebbe_24__p002",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919340_theRebbe_24__p002",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919340_theRebbe_24",
  "title": "מאמר עשרה שיושבין תשמ\"ב",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה מבואר בתניא13"
        },
        {
          "s": 2,
          "text": "שהמעלה דעשרה היא בכל הענינים דתורה ומצוות,"
        },
        {
          "s": 3,
          "text": "כי אין דבר שבקדושה בפחות מעשרה14."
        },
        {
          "s": 4,
          "text": "אלא שאעפ\"כ,"
        },
        {
          "s": 5,
          "text": "עיקר המעלה דעשרה הוא בתפלה."
        },
        {
          "s": 6,
          "text": "דהמעלה שבתפלת רבים שהיא רצוי' ומקובלת לעולם15,"
        },
        {
          "s": 7,
          "text": "וכיון שהמבוקש דתפלה הוא שהקב\"ה ימלא את בקשתו16,"
        },
        {
          "s": 8,
          "text": "הרי המעלה בתפלת רבים על תפלת יחיד הוא לא שבתפלת רבים מיתוסף עוד ענין,"
        },
        {
          "s": 9,
          "text": "כי אם,"
        },
        {
          "s": 10,
          "text": "שזה נוגע להתפלה עצמה."
        },
        {
          "s": 11,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 12,
          "text": "דמ\"ש בהמאמר שהמעלה בתורה דרבים היא דוגמת המעלה דתפלת רבים,"
        },
        {
          "s": 13,
          "text": "הכוונה בזה היא"
        },
        {
          "s": 14,
          "text": "(גם)"
        },
        {
          "s": 15,
          "text": "שהמעלה בתורה דרבים היא בענין עיקרי."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ולכאורה הי' אפשר לבאר זה,"
        },
        {
          "s": 1,
          "text": "דכיון שאין התורה נקנית אלא בחבורה17,"
        },
        {
          "s": 2,
          "text": "מובן,"
        },
        {
          "s": 3,
          "text": "דכשלימוד התורה הוא בחבורה גדולה יותר,"
        },
        {
          "s": 4,
          "text": "התורה נקנית יותר."
        },
        {
          "s": 5,
          "text": "וכיון שהשלימות דחבורה היא בעשרה18,"
        },
        {
          "s": 6,
          "text": "כי עשרה מישראל הם דוגמת וכוללים כל העשרה סוגים דישראל,"
        },
        {
          "s": 7,
          "text": "כנ\"ל,"
        },
        {
          "s": 8,
          "text": "לכן,"
        },
        {
          "s": 9,
          "text": "כשלימוד התורה הוא בעשרה,"
        },
        {
          "s": 10,
          "text": "קנין התורה הוא בשלימות."
        },
        {
          "s": 11,
          "text": "אבל ביאור זה אינו מספיק."
        },
        {
          "s": 12,
          "text": "כי מעלה הנ\"ל בתורה דרבים היא בהאדם העוסק בתורה,"
        },
        {
          "s": 13,
          "text": "שכשלומד בעשרה,"
        },
        {
          "s": 14,
          "text": "הקנין שלו"
        },
        {
          "s": 15,
          "text": "(שקונה את התורה ומקבל אותה)"
        },
        {
          "s": 16,
          "text": "הוא בשלימות."
        },
        {
          "s": 17,
          "text": "והדמיון דתורה ברבים לתפלת רבים הוא בההמשכה19."
        },
        {
          "s": 18,
          "text": "כמפורש בהמאמר,"
        },
        {
          "s": 19,
          "text": "דכמו שהרבים בתפלתם ממשיכים י\"ג מדות הרחמים כמו\"כ ע\"י תורה ברבים נמשך אור עליון יותר."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ובכדי לבאר מעלת ההמשכה שע\"י תורה דרבים,"
        },
        {
          "s": 2,
          "text": "מקדים בהמאמר,"
        },
        {
          "s": 3,
          "text": "שר' ישמעאל אומר20"
        },
        {
          "s": 4,
          "text": "בשלש עשרה מדות התורה נדרשת בק\"ו ובגז\"ש וכו'21."
        },
        {
          "s": 5,
          "text": "ומבאר,"
        },
        {
          "s": 6,
          "text": "דע\"י כל מדה ומדה"
        },
        {
          "s": 7,
          "text": "(מי\"ג המדות שהתורה נדרשת בהן)"
        },
        {
          "s": 8,
          "text": "מתגלים ענינים חדשים."
        },
        {
          "s": 9,
          "text": "והטעם על זה הוא,"
        },
        {
          "s": 10,
          "text": "כי י\"ג מדות שהתורה נדרשת בהן הם כנגד י\"ג מדות הרחמים."
        },
        {
          "s": 11,
          "text": "וכתורת הרב המגיד22"
        },
        {
          "s": 12,
          "text": "דכשאמר משה א-ל נא רפא נא לה23,"
        },
        {
          "s": 13,
          "text": "דשם א-ל הוא מדה הראשונה24"
        },
        {
          "s": 14,
          "text": "די\"ג מדות הרחמים,"
        },
        {
          "s": 15,
          "text": "אמר לו הקב\"ה ק\"ו,"
        },
        {
          "s": 16,
          "text": "ואבי' ירוק ירק בפני' גו' ק\"ו לשכינה25,"
        },
        {
          "s": 17,
          "text": "מדה הראשונה די\"ג המדות שהתורה נדרשת בהן."
        },
        {
          "s": 18,
          "text": "ומוסיף בהמאמר,"
        },
        {
          "s": 19,
          "text": "שזהו גם הקשר דשני הפירושים בהרועה בשושנים26,"
        },
        {
          "s": 20,
          "text": "א\"ת שושנים אלא ששונים בהלכות27"
        },
        {
          "s": 21,
          "text": "ומה שושנה אית בה תליסר עלין אוף כנס\"י אית בה תליסר מכילין דרחמי28,"
        },
        {
          "s": 22,
          "text": "והקשר דשני הפירושים הוא29"
        },
        {
          "s": 23,
          "text": "כי ע\"י לימוד התורה"
        },
        {
          "s": 24,
          "text": "(ששונים בהלכות)"
        },
        {
          "s": 25,
          "text": "נמשכים י\"ג מדות הרחמים."
        },
        {
          "s": 26,
          "text": "וזהו שע\"י תורה דרבים נמשך אור עליון יותר,"
        },
        {
          "s": 27,
          "text": "כי זה שע\"י לימוד התורה נמשכים י\"ג מדות הרחמים הוא30"
        },
        {
          "s": 28,
          "text": "בעיקר ע\"י לימוד תורה ברבים דוקא."
        }
      ]
    }
  ]
}