{
  "globalIndex": 1068,
  "owner": 18,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518920090_theRebbe_103__p001",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518920090_theRebbe_103__p001",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518920090_theRebbe_103",
  "title": "מאמר ושמתי כדכד שמשתיך תשט\"ז",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ ראה,"
        },
        {
          "s": 2,
          "text": "מבה\"ח אלול,"
        },
        {
          "s": 3,
          "text": "ה'תשט\"ז *"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "(הנחה בלתי מוגה)"
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ושמתי כדכד שמשתיך1,"
        },
        {
          "s": 1,
          "text": "ואמרז\"ל2"
        },
        {
          "s": 2,
          "text": "חד אמר שהם וחד אמר ישפה אמר הקב\"ה להוי כדין וכדין."
        },
        {
          "s": 3,
          "text": "הנה פסוק זה הוא אחד היעודים שיהיו בהגאולה העתידה לבוא ע\"י משיח צדקנו במהרה בימינו."
        },
        {
          "s": 4,
          "text": "ויש בזה ב' אופנים,"
        },
        {
          "s": 5,
          "text": "שהם וישפה,"
        },
        {
          "s": 6,
          "text": "ואמר הקב\"ה להוי כדין וכדין."
        },
        {
          "s": 7,
          "text": "ולהבין ב' אופנים אלו ברוחניות,"
        },
        {
          "s": 8,
          "text": "היינו בהגילוי אלקות שיהי' לע\"ל,"
        },
        {
          "s": 9,
          "text": "יובן זה מזה שב' אבנים אלו היו מי\"ב האבנים טובות אשר בהחושן של כה\"ג,"
        },
        {
          "s": 10,
          "text": "למספר שבטי בנ\"י,"
        },
        {
          "s": 11,
          "text": "שהם כנגד יוסף וישפה כנגד בנימין."
        },
        {
          "s": 12,
          "text": "והנה,"
        },
        {
          "s": 13,
          "text": "יוסף ובנימין הם צדיק עליון וצדיק תחתון,"
        },
        {
          "s": 14,
          "text": "דבחי' יוסף הוא המשכת אלקות מלמעלה למטה,"
        },
        {
          "s": 15,
          "text": "יוסף הוא המשביר בר3,"
        },
        {
          "s": 16,
          "text": "שממשיך אלקות מלמעלמ\"ט,"
        },
        {
          "s": 17,
          "text": "והיינו דגם כאשר העולם לא נזדכך עדיין עד כדי כך שיוכל לקבל בתוכו גילוי אור נעלה,"
        },
        {
          "s": 18,
          "text": "מ\"מ נמשך אור בדרך מלמעלמ\"ט."
        },
        {
          "s": 19,
          "text": "ובחי' בנימין הוא זיכוך ועלי' מלמטלמ\"ע,"
        },
        {
          "s": 20,
          "text": "היינו שפועל בירור זיכוך עלי' והתקשרות בנש\"י וחלקם בעולם,"
        },
        {
          "s": 21,
          "text": "ובמילא גם בכללות הבריאה,"
        },
        {
          "s": 22,
          "text": "שיוכלו לקבל את האור."
        },
        {
          "s": 23,
          "text": "וע\"ד משל כמו שמוח הבע\"ח אינו כלי לשכל ומוח האדם הוא כלי לשכל,"
        },
        {
          "s": 24,
          "text": "לפי שהוא מזוכך יותר,"
        },
        {
          "s": 25,
          "text": "הנה עבודתו של בנימין הוא העלאה מלמטלמ\"ע שפועל זיכוך במוח ושכל האדם עד שיהי' כלי לאור אלקי נעלה."
        },
        {
          "s": 26,
          "text": "והנה,"
        },
        {
          "s": 27,
          "text": "בב' אופנים אלו יש בכל אחד מהם מעלה מיוחדת."
        },
        {
          "s": 28,
          "text": "המעלה בעבודתו של בנימין,"
        },
        {
          "s": 29,
          "text": "שהו\"ע ישפה,"
        },
        {
          "s": 30,
          "text": "שהמטה מתייחד יותר עם האור אלקי,"
        },
        {
          "s": 31,
          "text": "דלהיות אשר ההמשכה היא מצד הזיכוך שנעשה כלי להאור,"
        },
        {
          "s": 32,
          "text": "במילא הרי הוא ביחוד גמור עם האור."
        },
        {
          "s": 33,
          "text": "והמעלה בעבודתו של יוסף,"
        },
        {
          "s": 34,
          "text": "שהו\"ע שהם,"
        },
        {
          "s": 35,
          "text": "שנמשך אור נעלה ביותר שאינו כפי אופן התחתון כי אם כפי שהוא מצד העליון."
        },
        {
          "s": 36,
          "text": "ועל זה אמר הקב\"ה להוי כדין וכדין,"
        },
        {
          "s": 37,
          "text": "אשר לע\"ל יהיו ב' המעלות."
        },
        {
          "s": 38,
          "text": "וכמבואר כל הנ\"ל באריכות בלקו\"ת בהדרושים ושמתי כדכד4."
        },
        {
          "s": 39,
          "text": "והנה,"
        },
        {
          "s": 40,
          "text": "ידוע שכל הגילוים שיהיו לעתיד תלויים במעשינו ועבודתינו כל זמן משך הגלות5,"
        },
        {
          "s": 41,
          "text": "ומאחר שלעתיד יהיו האופנים דמלמעלמ\"ט ומלמטלמ\"ע,"
        },
        {
          "s": 42,
          "text": "בהכרח לומר שגם בהעבודה בזמן משך הגלות ישנם ג\"כ אופנים אלו."
        },
        {
          "s": 43,
          "text": "וצריך להבין מהו\"ע ב' אופנים אלו דשהם וישפה בעבודה."
        }
      ]
    }
  ]
}