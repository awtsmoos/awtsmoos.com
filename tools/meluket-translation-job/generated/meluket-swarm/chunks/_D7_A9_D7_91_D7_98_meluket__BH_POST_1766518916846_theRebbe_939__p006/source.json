{
  "globalIndex": 535,
  "owner": 35,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916846_theRebbe_939__p006",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916846_theRebbe_939__p006",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916846_theRebbe_939",
  "title": "מאמר באתי לגני תשל\"א",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "וע\"פ הנ\"ל"
        },
        {
          "s": 1,
          "text": "(סעיף ב)"
        },
        {
          "s": 2,
          "text": "שבעיקר שכינה בתחתונים מודגשים שני ענינים – עיקר שכינה"
        },
        {
          "s": 3,
          "text": "(שלמעלה מעולמות),"
        },
        {
          "s": 4,
          "text": "ובתחתונים"
        },
        {
          "s": 5,
          "text": "(דזה שעיקר בתחתונים הוא"
        },
        {
          "s": 6,
          "text": "(גם)"
        },
        {
          "s": 7,
          "text": "מצד ענינם דהתחתונים)"
        },
        {
          "s": 8,
          "text": "– יש לומר,"
        },
        {
          "s": 9,
          "text": "שהיתרון בהמשכת עיקר שכינה בתחתונים לאחרי שנסתלקה לגבי כמו שהיתה בתחלת הבריאה,"
        },
        {
          "s": 10,
          "text": "הוא בשני הענינים."
        },
        {
          "s": 11,
          "text": "שהגילוי אלקות שנמשך ע\"י עבודת האדם עכשיו הוא גילוי נעלה יותר מהגילוי שנמשך ע\"י עבודת אדה\"ר קודם החטא,"
        },
        {
          "s": 12,
          "text": "ושהמשכת הגילוי בעולם"
        },
        {
          "s": 13,
          "text": "(בתחתונים)"
        },
        {
          "s": 14,
          "text": "עכשיו הוא בפנימיות יותר."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים ביאור בהמובא לעיל דהגם שחטא"
        },
        {
          "s": 2,
          "text": "(חטא עה\"ד,"
        },
        {
          "s": 3,
          "text": "וכן כל החטאים)"
        },
        {
          "s": 4,
          "text": "הוא היפך רצון העליון,"
        },
        {
          "s": 5,
          "text": "מ\"מ הוא בכוונה."
        },
        {
          "s": 6,
          "text": "והענין הוא כמ\"ש בעל ההילולא בהמאמרים דחג הגאולה42,"
        },
        {
          "s": 7,
          "text": "דכמו שכל דבר שלמטה יש לו שרש ומקור למעלה,"
        },
        {
          "s": 8,
          "text": "עד\"ז הוא בנוגע לחטא ועון,"
        },
        {
          "s": 9,
          "text": "שיש סיבה ונתינת מקום על זה למעלה."
        },
        {
          "s": 10,
          "text": "ומביא הוכחה על זה מחטא הראשון שהי' בעולם,"
        },
        {
          "s": 11,
          "text": "הוא חטא עה\"ד."
        },
        {
          "s": 12,
          "text": "דלכאורה יפלא,"
        },
        {
          "s": 13,
          "text": "הרי אדה\"ר הי' בתכלית העילוי הן מצד נפשו שחכמתו היתה גדולה יותר מחכמת שכלים הנבדלים43"
        },
        {
          "s": 14,
          "text": "והן מצד גופו שגופו של אדה\"ר הי' יציר כפיו של הקב\"ה44"
        },
        {
          "s": 15,
          "text": "ועקבו של אדה\"ר הי' מכהה גלגל חמה45,"
        },
        {
          "s": 16,
          "text": "ואיך שייך שחטא ועבר על ציווי ה'."
        },
        {
          "s": 17,
          "text": "ולהוסיף,"
        },
        {
          "s": 18,
          "text": "שע\"פ מאמר רז\"ל46"
        },
        {
          "s": 19,
          "text": "דהטעם שנברא האדם יחידי הוא ללמדנו שכל אחד מישראל הוא דוגמת אדה\"ר,"
        },
        {
          "s": 20,
          "text": "יש לומר,"
        },
        {
          "s": 21,
          "text": "דהפלא איך שייך ענין החטא הוא גם בכאו\"א מישראל47."
        },
        {
          "s": 22,
          "text": "דכיון שנפש השנית שבו היא חלק אלוקה ממעל ממש48,"
        },
        {
          "s": 23,
          "text": "וגם בנוגע להגוף דישראל נאמר49"
        },
        {
          "s": 24,
          "text": "ובנו בחרת מכל עם ולשון ואיתא בתניא50"
        },
        {
          "s": 25,
          "text": "שזה קאי על הגוף החומרי שנדמה בחומריותו לגופי אומות העולם,"
        },
        {
          "s": 26,
          "text": "וע\"פ הידוע51"
        },
        {
          "s": 27,
          "text": "שאמיתית ענין הבחירה הוא בהעצמות,"
        },
        {
          "s": 28,
          "text": "מובן,"
        },
        {
          "s": 29,
          "text": "שבהגוף דישראל יש יתרון גם לגבי הנשמה,"
        },
        {
          "s": 30,
          "text": "שבו"
        },
        {
          "s": 31,
          "text": "(בהגוף)"
        },
        {
          "s": 32,
          "text": "דוקא הוא בחירת העצמות,"
        },
        {
          "s": 33,
          "text": "איך שייך שיהי' בישראל חטא."
        },
        {
          "s": 34,
          "text": "והביאור בזה"
        },
        {
          "s": 35,
          "text": "(במאמר הנ\"ל דבעל ההילולא),"
        },
        {
          "s": 36,
          "text": "שהסיבה והנתינת מקום לחטא"
        },
        {
          "s": 37,
          "text": "(כפשוטו,"
        },
        {
          "s": 38,
          "text": "למטה)"
        },
        {
          "s": 39,
          "text": "בהענינים דלמעלה הוא מיעוט הירח52."
        },
        {
          "s": 40,
          "text": "ולמעלה יותר,"
        },
        {
          "s": 41,
          "text": "הסיבה ונתינת מקום לחטא הוא – שבירת הכלים דתוהו."
        },
        {
          "s": 42,
          "text": "היינו דבריאת עולם התוהו,"
        },
        {
          "s": 43,
          "text": "עולם שלא אהנייא לי'53"
        },
        {
          "s": 44,
          "text": "(שלכן הי' בו השבירה),"
        },
        {
          "s": 45,
          "text": "הוא"
        },
        {
          "s": 46,
          "text": "(כמו)"
        },
        {
          "s": 47,
          "text": "היפך הרצון."
        },
        {
          "s": 48,
          "text": "ולכן הוא סיבה ונתינת מקום לחטא."
        },
        {
          "s": 49,
          "text": "ולמעלה יותר,"
        },
        {
          "s": 50,
          "text": "הסיבה ונתינת מקום לחטא הוא – צמצום הראשון שהי' בדרך סילוק."
        },
        {
          "s": 51,
          "text": "כי רצון העליון הוא שיהי' גילוי אור,"
        },
        {
          "s": 52,
          "text": "וסילוק האור"
        },
        {
          "s": 53,
          "text": "(צמצום הראשון)"
        },
        {
          "s": 54,
          "text": "הוא"
        },
        {
          "s": 55,
          "text": "(כמו)"
        },
        {
          "s": 56,
          "text": "היפך הרצון"
        },
        {
          "s": 57,
          "text": "[דהגם שכוונת הצמצום היא בשביל הגילוי,"
        },
        {
          "s": 58,
          "text": "הרי הצמצום עצמו הוא היפך הרצון54]."
        },
        {
          "s": 59,
          "text": "והענין דהיפך הרצון"
        },
        {
          "s": 60,
          "text": "(כביכול)"
        },
        {
          "s": 61,
          "text": "שבצמצום הראשון הוא סיבה ונתינת מקום"
        },
        {
          "s": 62,
          "text": "(ע\"י שבירת הכלים דתוהו ומיעוט הירח)"
        },
        {
          "s": 63,
          "text": "לחטא,"
        },
        {
          "s": 64,
          "text": "היפך הרצון כפשוטו."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "ולהעיר,"
        },
        {
          "s": 1,
          "text": "שההוכחה על זה שגם ענין דהיפך הרצון הוא בכוונה,"
        },
        {
          "s": 2,
          "text": "הוא בעיקר מצמצום הראשון."
        },
        {
          "s": 3,
          "text": "כי מיעוט הירח,"
        },
        {
          "s": 4,
          "text": "הגם שהקב\"ה המעיט את הירח,"
        },
        {
          "s": 5,
          "text": "הרי הסיבה לזה הי' קטרוג הלבנה55."
        },
        {
          "s": 6,
          "text": "וגם שבירת הכלים דתוהו,"
        },
        {
          "s": 7,
          "text": "הגם שבריאת עולם התוהו מלכתחילה היתה באופן דבונה על מנת לסתור56,"
        },
        {
          "s": 8,
          "text": "יש לומר,"
        },
        {
          "s": 9,
          "text": "דע\"י שהי' הצמצום,"
        },
        {
          "s": 10,
          "text": "שהוא שרש התהוות העולמות,"
        },
        {
          "s": 11,
          "text": "נקבע שהתהוות עולם התיקון תהי' לאחרי בנין וסתירת התוהו57,"
        },
        {
          "s": 12,
          "text": "בונה על מנת לסתור וסותר על מנת לבנות56."
        },
        {
          "s": 13,
          "text": "ועיקר ההוכחה על זה שגם ענין דהיפך הרצון הוא שלא במקרה ח\"ו אלא בכוונה הוא מצמצום הראשון."
        },
        {
          "s": 14,
          "text": "דבנוגע להצמצום א\"א לומר שהי' הכרח כביכול בהצמצום בכדי שיוכל להיות התהוות העולמות,"
        },
        {
          "s": 15,
          "text": "שהרי כל הענין דהתהוות העולמות"
        },
        {
          "s": 16,
          "text": "(עולם לשון העלם58)"
        },
        {
          "s": 17,
          "text": "הוא מצד הצמצום."
        },
        {
          "s": 18,
          "text": "דהרצון לעולמות באוא\"ס שלפני הצמצום הוא שיהיו עולמות שבהם יהי' גילוי האור."
        },
        {
          "s": 19,
          "text": "דכיון שענין האור הוא גילוי,"
        },
        {
          "s": 20,
          "text": "גם הרצון לעולמות שהי' בהאור הוא"
        },
        {
          "s": 21,
          "text": "(לא להעולמות עצמם,"
        },
        {
          "s": 22,
          "text": "אלא)"
        },
        {
          "s": 23,
          "text": "להגילוי שיהי' בעולמות."
        },
        {
          "s": 24,
          "text": "ומזה מובן,"
        },
        {
          "s": 25,
          "text": "דהכוונה בהצמצום"
        },
        {
          "s": 26,
          "text": "[סילוק האור,"
        },
        {
          "s": 27,
          "text": "בכדי שיתהוו עולמות שענינם הוא העלם]"
        },
        {
          "s": 28,
          "text": "היא לא רק בכדי שעי\"ז יושלם הרצון לעולמות שהי' תחלה בהאור שקודם הצמצום59,"
        },
        {
          "s": 29,
          "text": "אלא שיש בזה עוד כוונה60,"
        },
        {
          "s": 30,
          "text": "שהיא היפך הרצון שהי' תחלה61."
        },
        {
          "s": 31,
          "text": "והיינו,"
        },
        {
          "s": 32,
          "text": "דכוונת הצמצום כמו שהיא בהאור"
        },
        {
          "s": 33,
          "text": "(שאוא\"ס צמצם עצמו)"
        },
        {
          "s": 34,
          "text": "הוא שיהי' גילוי בהעולמות שיתהוו מהצמצום,"
        },
        {
          "s": 35,
          "text": "וכוונת הצמצום כמו שהיא בהצמצום עצמו היא – שבו מתגלה ענין ההעלם שלמעלה מגילוי,"
        },
        {
          "s": 36,
          "text": "והוא שהעצמות אינו מוכרח ח\"ו בענין הגילוי וביכלתו להיות"
        },
        {
          "s": 37,
          "text": "(גם)"
        },
        {
          "s": 38,
          "text": "בהעלם."
        },
        {
          "s": 39,
          "text": "אלא שגילוי ענין ההעלם"
        },
        {
          "s": 40,
          "text": "[שההעלם הוא מפני שהעצמות אינו מוכרח ח\"ו בענין הגילוי]"
        },
        {
          "s": 41,
          "text": "הוא ע\"י הגילוי שנמשך אחרי הצמצום."
        },
        {
          "s": 42,
          "text": "דע\"י הגילוי שנמשך בעולמות שנתהוו מהצמצום,"
        },
        {
          "s": 43,
          "text": "יכולים הם להרגיש"
        },
        {
          "s": 44,
          "text": "(נוסף על הרגש הגילוי)"
        },
        {
          "s": 45,
          "text": "גם שרש וסיבת ההעלם שבהם,"
        },
        {
          "s": 46,
          "text": "שהוא מצד יכולת העצמות."
        },
        {
          "s": 47,
          "text": "[ויש לקשר זה עם הענין דדירה בתחתונים,"
        },
        {
          "s": 48,
          "text": "שעוה\"ז התחתון נעשה דירה להעצמות,"
        },
        {
          "s": 49,
          "text": "כי בעוה\"ז הוא עיקר ההעלם,"
        },
        {
          "s": 50,
          "text": "וע\"י שמתגלה שההעלם שבו הוא מצד יכולת העצמות,"
        },
        {
          "s": 51,
          "text": "הוא נעשה דירה להעצמות]."
        }
      ]
    }
  ]
}