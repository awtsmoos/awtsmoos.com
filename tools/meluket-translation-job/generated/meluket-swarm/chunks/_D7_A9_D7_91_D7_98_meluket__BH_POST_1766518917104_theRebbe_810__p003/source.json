{
  "globalIndex": 585,
  "owner": 35,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917104_theRebbe_810__p003",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917104_theRebbe_810__p003",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518917104_theRebbe_810",
  "title": "מאמר באתי לגני תשל\"ו",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "והנה ענין הביטול"
        },
        {
          "s": 1,
          "text": "(שהוא ההכנה למ\"ת,"
        },
        {
          "s": 2,
          "text": "כנ\"ל)"
        },
        {
          "s": 3,
          "text": "צ\"ל בכל ג' הקוין דתורה עבודה וגמ\"ח40."
        },
        {
          "s": 4,
          "text": "דהנה תורה היא המשכה מלמעלה,"
        },
        {
          "s": 5,
          "text": "וההמשכה מלמעלה היא דוקא למי שבטל,"
        },
        {
          "s": 6,
          "text": "וכמ\"ש41"
        },
        {
          "s": 7,
          "text": "מרום וקדוש אשכון ואת דכא ושפל רוח."
        },
        {
          "s": 8,
          "text": "שלכן לימוד התורה צ\"ל לא בבחינת יש מי שלומד רק כמ\"ש42"
        },
        {
          "s": 9,
          "text": "תען לשוני אמרתך,"
        },
        {
          "s": 10,
          "text": "כעונה אחר הקורא43,"
        },
        {
          "s": 11,
          "text": "ועד\"ז הוא גם בקו הצדקה,"
        },
        {
          "s": 12,
          "text": "דענין הצדקה הוא44"
        },
        {
          "s": 13,
          "text": "להחיות רוח שפלים."
        },
        {
          "s": 14,
          "text": "וכמו שהוא בנוגע לצדקה בפרט,"
        },
        {
          "s": 15,
          "text": "עד\"ז הוא גם בכללות המצוות שנקראים בשם צדקה45,"
        },
        {
          "s": 16,
          "text": "שקיום המצוות צ\"ל בביטול דוקא,"
        },
        {
          "s": 17,
          "text": "שהוא מקיים מצות הוי'ב"
        },
        {
          "s": 18,
          "text": "[ובדוגמת הביטול בלימוד התורה,"
        },
        {
          "s": 19,
          "text": "שהוא מרגיש שהתורה היא אמרתך]."
        },
        {
          "s": 20,
          "text": "ועד\"ז הוא גם בקו העבודה שענינה הוא44"
        },
        {
          "s": 21,
          "text": "בחינת ביטול"
        },
        {
          "s": 22,
          "text": "(מלמטה למעלה),"
        },
        {
          "s": 23,
          "text": "דזהו מה שעבודת התפלה צ\"ל בביטול דוקא וכמ\"ש46"
        },
        {
          "s": 24,
          "text": "תפלה לדוד הטה גו' וענני כי עני ואביון אני,"
        },
        {
          "s": 25,
          "text": "וכמרז\"ל47"
        },
        {
          "s": 26,
          "text": "אין עומדים להתפלל אלא מתוך כובד ראש ופירש\"י הכנעה ושפלות48."
        },
        {
          "s": 27,
          "text": "וזהו ג\"כ מה שמבאר כ\"ק מו\"ח אדמו\"ר בהמאמר"
        },
        {
          "s": 28,
          "text": "(פ\"ו)"
        },
        {
          "s": 29,
          "text": "ענין הביטול בכל ג' הקוין,"
        },
        {
          "s": 30,
          "text": "דבענין לימוד התורה מביא מה שאמרו רז\"ל49"
        },
        {
          "s": 31,
          "text": "לא תמצא בגסי הרוח כו',"
        },
        {
          "s": 32,
          "text": "כי לימוד התורה צ\"ל בתכלית הביטול,"
        },
        {
          "s": 33,
          "text": "וכמו התלמיד המקבל מרבו,"
        },
        {
          "s": 34,
          "text": "שבעת ההשפעה צ\"ל בטל בתכלית"
        },
        {
          "s": 35,
          "text": "(שפתותיו נוטפות מר50),"
        },
        {
          "s": 36,
          "text": "וכן בנוגע לתפלה מביא בהמאמר מ\"ש תפלה לדוד הטה ה' אזנך וענני כי עני ואביון אני,"
        },
        {
          "s": 37,
          "text": "שהבקשה הטה גו' וענני הוא לפי דעני ואביון אני,"
        },
        {
          "s": 38,
          "text": "וגם הביטול שצ\"ל בהקו דגמ\"ח כללות המצוות מרמז שם בהמשל דכח התנועה,"
        },
        {
          "s": 39,
          "text": "שבכדי להגבי' משא כבדה צריך לצמצם את עצמו,"
        },
        {
          "s": 40,
          "text": "שבזה מרמז ענין הביטול שבקיום המצוות."
        },
        {
          "s": 41,
          "text": "כי המצוות מלובשים בדברים גשמיים,"
        },
        {
          "s": 42,
          "text": "וענין ההתלבשות בגשמיות"
        },
        {
          "s": 43,
          "text": "(אצל יהודי)"
        },
        {
          "s": 44,
          "text": "הוא דבר קשה."
        },
        {
          "s": 45,
          "text": "וזהו מה שמרמז בהמשל דכח התנועה,"
        },
        {
          "s": 46,
          "text": "דכמו שבכדי להגבי' משא כבדה צריך לצמצם את עצמו,"
        },
        {
          "s": 47,
          "text": "עד\"ז הוא גם בקיום המצוות"
        },
        {
          "s": 48,
          "text": "(שהוא דוגמת משא כבדה)"
        },
        {
          "s": 49,
          "text": "שצ\"ל בביטול."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה בענין הביטול דאות יו\"ד"
        },
        {
          "s": 2,
          "text": "(שבאחורי הדל\"ת)"
        },
        {
          "s": 3,
          "text": "מבאר בהמאמר,"
        },
        {
          "s": 4,
          "text": "וז\"ל: דאות יו\"ד מורה על הביטול ואזעירת גרמה51,"
        },
        {
          "s": 5,
          "text": "והיינו מלכות דאצילות דלית לה מגרמה כלום."
        },
        {
          "s": 6,
          "text": "ויש לומר הכוונה בזה שמוסיף הענין דלית לה מגרמה כלום,"
        },
        {
          "s": 7,
          "text": "כי הענין דאזעירת גרמה,"
        },
        {
          "s": 8,
          "text": "אף שהוא בחינת ביטול,"
        },
        {
          "s": 9,
          "text": "מ\"מ נשאר עדיין איזה מציאות"
        },
        {
          "s": 10,
          "text": "(ורק שהמציאות הוא באופן דאזעירת),"
        },
        {
          "s": 11,
          "text": "ולכן מוסיף הענין דלית לה מגרמה כלום,"
        },
        {
          "s": 12,
          "text": "שהיא"
        },
        {
          "s": 13,
          "text": "(כלשון המאמר שם)"
        },
        {
          "s": 14,
          "text": "בתכלית הביטול והשפלות."
        },
        {
          "s": 15,
          "text": "ויובן זה ע\"פ מ\"ש כ\"ק אדמו\"ר האמצעי בביאורי הזהר52"
        },
        {
          "s": 16,
          "text": "בענין וגם אמנה אחותי בת אבי היא אך לא בת אמי53,"
        },
        {
          "s": 17,
          "text": "שבחינת הביטול דכלי ריקן באה מבחינת החכמה"
        },
        {
          "s": 18,
          "text": "(אבי)"
        },
        {
          "s": 19,
          "text": "דוקא."
        },
        {
          "s": 20,
          "text": "כי מההתבוננות דבינה"
        },
        {
          "s": 21,
          "text": "(אמי)"
        },
        {
          "s": 22,
          "text": "נעשה ההתפעלות בבחינת התלהבות ורעש,"
        },
        {
          "s": 23,
          "text": "וענין הביטול דכלי ריקן בא מבחינת החכמה"
        },
        {
          "s": 24,
          "text": "(אבי)"
        },
        {
          "s": 25,
          "text": "דוקא,"
        },
        {
          "s": 26,
          "text": "שההתפעלות דחכמה הו\"ע השפלות להניח את עצמו ולבטל את עצמו מכל וכל."
        },
        {
          "s": 27,
          "text": "והנה מובן,"
        },
        {
          "s": 28,
          "text": "שגם ההתפעלות בבחינת התלהבות ורעש שבאה מההתבוננות דבינה,"
        },
        {
          "s": 29,
          "text": "מכיון שגם בת אמי היא בחינה דקדושה,"
        },
        {
          "s": 30,
          "text": "היא בבחינת ביטול,"
        },
        {
          "s": 31,
          "text": "שהרי \"כל ענין הקדושה שיהי' בבחינת ביטול בתכלית\"54,"
        },
        {
          "s": 32,
          "text": "וההפרש שבין בת אמי לבת אבי הוא רק מה שההתפעלות הנולדה מהבינה אינה בבחינת ביטול בתכלית."
        },
        {
          "s": 33,
          "text": "כי מכיון שבינה היא הבנה והשגה,"
        },
        {
          "s": 34,
          "text": "בחינת מציאות,"
        },
        {
          "s": 35,
          "text": "לכן גם ההתפעלות הנולדת ממנה היא בבחינת רעש."
        },
        {
          "s": 36,
          "text": "משא\"כ מבחינת החכמה הוא בא לידי ביטול בתכלית,"
        },
        {
          "s": 37,
          "text": "והיינו שהביטול הבא ע\"י ההתבוננות דבינה"
        },
        {
          "s": 38,
          "text": "(שהוא בחינת רעש והתפעלות)"
        },
        {
          "s": 39,
          "text": "הוא בבחינת חיצוניות בלבד,"
        },
        {
          "s": 40,
          "text": "משא\"כ הביטול דחכמה"
        },
        {
          "s": 41,
          "text": "(שהיא בחשאי)"
        },
        {
          "s": 42,
          "text": "הוא בחינת ביטול עצמי שהוא בטל בעצם מהותו."
        },
        {
          "s": 43,
          "text": "וזהו מה שמדייק בהמאמר הענין דלית לה מגרמה כלום,"
        },
        {
          "s": 44,
          "text": "בחינת תכלית הביטול,"
        },
        {
          "s": 45,
          "text": "כי מכיון שבביטול ישנם כמה דרגות כנ\"ל,"
        },
        {
          "s": 46,
          "text": "לכן מדייק שהביטול"
        },
        {
          "s": 47,
          "text": "(דאות ד')"
        },
        {
          "s": 48,
          "text": "המבואר כאן הוא ביטול בתכלית"
        },
        {
          "s": 49,
          "text": "(שהוא ביטול נעלה יותר גם מהביטול דחכמה,"
        },
        {
          "s": 50,
          "text": "כמשי\"ת לקמן)."
        },
        {
          "s": 51,
          "text": "שע\"י ביטול כזה דוקא הוא נעשה כלי לקבל גם שפע שבאין ערוך אליו כלל,"
        },
        {
          "s": 52,
          "text": "וכמו שמבאר בהמשל דרב ותלמיד,"
        },
        {
          "s": 53,
          "text": "שע\"י שהתלמיד הוא בבחינת ביטול במציאות לגמרי,"
        },
        {
          "s": 54,
          "text": "בתכלית הביטול והשפלות,"
        },
        {
          "s": 55,
          "text": "אז דוקא הוא כלי לקבל אמיתית השפעת הרב."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והענין הוא כמו שמבאר כ\"ק אדמו\"ר הצ\"צ באוה\"ת55,"
        },
        {
          "s": 2,
          "text": "שביטול התלמיד לקבל שפע הרב הוא בדוגמת ביטול הרב בכדי להשפיע להתלמיד,"
        },
        {
          "s": 3,
          "text": "דכאשר הרב משפיע שכל לתלמיד שבערכו,"
        },
        {
          "s": 4,
          "text": "הנה הגם שגם אז צריך לצמצם קצת את שכלו מ\"מ אינו צריך להניח את עצמו."
        },
        {
          "s": 5,
          "text": "משא\"כ כשרוצה להשפיע שכל לתלמיד שאינו בערך כלל אז הוא צריך להניח עצמותו על הצד ולצמצם כל עצמותו כו'."
        },
        {
          "s": 6,
          "text": "ועד\"ז הוא בנוגע לביטול התלמיד,"
        },
        {
          "s": 7,
          "text": "שבכדי לקבל השפעה שבערכו"
        },
        {
          "s": 8,
          "text": "(אף שגם אז צ\"ל בביטול,"
        },
        {
          "s": 9,
          "text": "מ\"מ)"
        },
        {
          "s": 10,
          "text": "אינו צריך להיות בתכלית הביטול,"
        },
        {
          "s": 11,
          "text": "משא\"כ בכדי לקבל השפעה שאינו בערכו כלל,"
        },
        {
          "s": 12,
          "text": "הנה כמו שהרב המשפיע צריך להניח את עצמותו כנ\"ל,"
        },
        {
          "s": 13,
          "text": "עד\"ז הוא גם בהתלמיד המקבל"
        },
        {
          "s": 14,
          "text": "(כמים הפנים לפנים56)"
        },
        {
          "s": 15,
          "text": "שצריך להיות בבחינת ביטול בתכלית."
        },
        {
          "s": 16,
          "text": "ועפ\"ז מבאר"
        },
        {
          "s": 17,
          "text": "(שם)"
        },
        {
          "s": 18,
          "text": "מה שאמרו רז\"ל57"
        },
        {
          "s": 19,
          "text": "ר' זירא צם מאה תעניתא דלשתכח מיני' תלמוד בבלי כדי שיוכל לקבל תלמוד ירושלמי,"
        },
        {
          "s": 20,
          "text": "\"שהמכוון,"
        },
        {
          "s": 21,
          "text": "שכשלא הי' כלי ריקן והי' בידו מהשגות הראשוני' לא הי' יכול לקבל השפע העליון דא\"י\"."
        },
        {
          "s": 22,
          "text": "וי\"ל הכוונה בזה,"
        },
        {
          "s": 23,
          "text": "כי בפשטות אינו מובן מה שהוצרך ר\"ז לצום מאה תעניתא כו',"
        },
        {
          "s": 24,
          "text": "דלכאורה,"
        },
        {
          "s": 25,
          "text": "הרי גם קודם לזה הי' אצלו הביטול כדבעי"
        },
        {
          "s": 26,
          "text": "[דמזה גופא שלמד והשיג תלמוד בבלי הרי מוכח שהי' בביטול,"
        },
        {
          "s": 27,
          "text": "שהרי השגת התורה היא ע\"י הביטול דוקא ועד אשר כל תלמיד שאין שפתותיו נוטפות מר כו'],"
        },
        {
          "s": 28,
          "text": "וא\"כ למה הוצרך לצום מאה תעניתא כו',"
        },
        {
          "s": 29,
          "text": "ועל זה מבאר כ\"ק אדמו\"ר הצ\"צ,"
        },
        {
          "s": 30,
          "text": "שהמכוון בזה הוא שהי' צ\"ל כלי ריקן גם מהשגות הראשונים."
        },
        {
          "s": 31,
          "text": "דמכיון שבכדי לקבל אור נעלה יותר צריך להיות בביטול גדול יותר,"
        },
        {
          "s": 32,
          "text": "לכן,"
        },
        {
          "s": 33,
          "text": "בכדי שיוכל לקבל השפע עליון דא\"י"
        },
        {
          "s": 34,
          "text": "[שהוא נעלה באין ערוך],"
        },
        {
          "s": 35,
          "text": "לא הי' מספיק הביטול שהי' אצלו מקודם,"
        },
        {
          "s": 36,
          "text": "והוצרך לצום מאה תעניתא,"
        },
        {
          "s": 37,
          "text": "שצומות הוא ביטול דמציאות האדם,"
        },
        {
          "s": 38,
          "text": "וביטול זה אינו מספיק עדיין והוצרך להיות גם דלשתכח מיני' תלמוד בבלי"
        },
        {
          "s": 39,
          "text": "(היינו שצ\"ל לא רק ביטול מציאותו בכלל כ\"א גם ביטול השגתו הקודמת),"
        },
        {
          "s": 40,
          "text": "שזהו אמיתית הענין דכלי ריקן,"
        },
        {
          "s": 41,
          "text": "אשר הוא ריקן גם מההשגות הראשונים."
        },
        {
          "s": 42,
          "text": "וזהו ג\"כ ענין אחותי בת אבי היא,"
        },
        {
          "s": 43,
          "text": "כי בחינת כלי ריקן הנ\"ל נמשך מצד החכמה דוקא ולא מבחינת בינה,"
        },
        {
          "s": 44,
          "text": "כמבואר באוה\"ת שם."
        }
      ]
    }
  ]
}