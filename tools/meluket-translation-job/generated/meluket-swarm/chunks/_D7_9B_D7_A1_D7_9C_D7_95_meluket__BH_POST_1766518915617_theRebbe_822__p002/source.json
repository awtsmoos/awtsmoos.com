{
  "globalIndex": 323,
  "owner": 23,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915617_theRebbe_822__p002",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915617_theRebbe_822__p002",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915617_theRebbe_822",
  "title": "מאמר ברוך שעשה ניסים תשט\"ו",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "וביאור הענין"
        },
        {
          "s": 2,
          "text": "(השייכות דנסים לזיווג פנימי דחו\"ב)"
        },
        {
          "s": 3,
          "text": "בפרטיות יותר,"
        },
        {
          "s": 4,
          "text": "יובן בהקדים מה שנתבאר לעיל"
        },
        {
          "s": 5,
          "text": "(בד\"ה פתח אלי'9)"
        },
        {
          "s": 6,
          "text": "דהנהגת הטבע"
        },
        {
          "s": 7,
          "text": "[שהקב\"ה מנהיג את כל נברא לפי ענינו,"
        },
        {
          "s": 8,
          "text": "דזה מורה שבהנהגה זו הנבראים תופסים מקום]"
        },
        {
          "s": 9,
          "text": "היא בבחינת דעת תחתון שלמטה יש"
        },
        {
          "s": 10,
          "text": "(ולמעלה אין),"
        },
        {
          "s": 11,
          "text": "והנהגה נסית"
        },
        {
          "s": 12,
          "text": "[שהקב\"ה מנהיג את העולם כפי רצונו ולא כפי תכונת וטבע הנבראים,"
        },
        {
          "s": 13,
          "text": "שזה מורה שבהנהגה זו הנבראים אינם תופסים מקום]"
        },
        {
          "s": 14,
          "text": "היא בבחינת דעת עליון ש"
        },
        {
          "s": 15,
          "text": "(למעלה יש ו)"
        },
        {
          "s": 16,
          "text": "למטה אין."
        },
        {
          "s": 17,
          "text": "והנה שתי דיעות אלו בענין הספירות הם חכמה ובינה10."
        },
        {
          "s": 18,
          "text": "דבחכמה נרגש שאוא\"ס הוא יש האמיתי וכולא קמי' כלא חשיב11"
        },
        {
          "s": 19,
          "text": "– דעת עליון שלמעלה יש ולמטה אין,"
        },
        {
          "s": 20,
          "text": "ובבינה שהיא השגה,"
        },
        {
          "s": 21,
          "text": "דהשגה היא מציאות יש,"
        },
        {
          "s": 22,
          "text": "היא דעת תחתון."
        },
        {
          "s": 23,
          "text": "דהגם שגם בבינה מושג שכולא קמי' כלא חשיב,"
        },
        {
          "s": 24,
          "text": "אין זה נרגש בה12."
        },
        {
          "s": 25,
          "text": "דכיון שהשגה"
        },
        {
          "s": 26,
          "text": "(גם ההשגה דכולא קמי' כלא חשיב)"
        },
        {
          "s": 27,
          "text": "היא מציאות,"
        },
        {
          "s": 28,
          "text": "המציאות"
        },
        {
          "s": 29,
          "text": "(דההשגה)"
        },
        {
          "s": 30,
          "text": "היא היפך ההרגש דכלא חשיב13."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "והנה14 זה שבבינה הוא דעת תחתון שלמעלה אין ולמטה יש הוא גם בנוגע לההמשכה שמהחכמה לבינה."
        },
        {
          "s": 1,
          "text": "דחכמה ובינה הם אין ויש,"
        },
        {
          "s": 2,
          "text": "והתהוות הבינה מהחכמה היא בדוגמת התהוות יש מאין15."
        },
        {
          "s": 3,
          "text": "דכמו שבהתהוות יש מאין האין הוא בהעלם מהיש,"
        },
        {
          "s": 4,
          "text": "שלכן נקרא בשם אין לפי שאינו מושג בהיש"
        },
        {
          "s": 5,
          "text": "[וזה שהאין אינו מושג בהיש הוא לא רק מצד היש"
        },
        {
          "s": 6,
          "text": "(שהוא באין ערוך להאין ולכן אין ביכלתו להשיג את האין),"
        },
        {
          "s": 7,
          "text": "אלא גם מצד האין,"
        },
        {
          "s": 8,
          "text": "שהוא"
        },
        {
          "s": 9,
          "text": "(האין)"
        },
        {
          "s": 10,
          "text": "מתעלם מהיש."
        },
        {
          "s": 11,
          "text": "וכידוע16"
        },
        {
          "s": 12,
          "text": "דהתהוות יש מאין הוא ע\"י שהכח האלקי"
        },
        {
          "s": 13,
          "text": "(האין)"
        },
        {
          "s": 14,
          "text": "המהוה את הנברא"
        },
        {
          "s": 15,
          "text": "(היש)"
        },
        {
          "s": 16,
          "text": "מתעלם מהנברא],"
        },
        {
          "s": 17,
          "text": "עד\"ז הוא בהתהוות הבינה מהחכמה,"
        },
        {
          "s": 18,
          "text": "דזה שהבינה היא יש הוא לפי שהאין דחכמה מתעלם מהבינה."
        },
        {
          "s": 19,
          "text": "והגם שההשגה דבינה היא בנקודת החכמה,"
        },
        {
          "s": 20,
          "text": "שהבינה משגת נקודת ההשכלה,"
        },
        {
          "s": 21,
          "text": "הרי עיקר החכמה הוא הראי' דחכמה שלמעלה משכל,"
        },
        {
          "s": 22,
          "text": "דענין זה אינו נמשך כלל בבינה."
        },
        {
          "s": 23,
          "text": "וגם ההשכלה דחכמה"
        },
        {
          "s": 24,
          "text": "(שנמשכת בהבינה)"
        },
        {
          "s": 25,
          "text": "היא"
        },
        {
          "s": 26,
          "text": "(בעיקר)"
        },
        {
          "s": 27,
          "text": "הנחת הנפש,"
        },
        {
          "s": 28,
          "text": "והשכל שבה הוא רק החיצוניות17."
        },
        {
          "s": 29,
          "text": "ומה שמושג בבינה הוא רק השכל שבנקודת ההשכלה"
        },
        {
          "s": 30,
          "text": "(החיצוניות),"
        },
        {
          "s": 31,
          "text": "אבל ההנחה שבנקודת ההשכלה"
        },
        {
          "s": 32,
          "text": "(הפנימיות והעצמיות שלה)"
        },
        {
          "s": 33,
          "text": "הוא בחינת אין לגבי הבינה,"
        },
        {
          "s": 34,
          "text": "שאינו מושג בה."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש להוסיף ביאור בזה שהענין דדעת עליון הוא בחכמה דוקא,"
        },
        {
          "s": 1,
          "text": "משא\"כ בבינה"
        },
        {
          "s": 2,
          "text": "(אף שבבינה מושגים הענינים שבחכמה)"
        },
        {
          "s": 3,
          "text": "הוא דעת תחתון,"
        },
        {
          "s": 4,
          "text": "כי זה שבחכמה הוא דעת עליון שלמטה אין"
        },
        {
          "s": 5,
          "text": "(ההרגש דכולא קמי' כלא חשיב),"
        },
        {
          "s": 6,
          "text": "הוא"
        },
        {
          "s": 7,
          "text": "(לא מצד השכל שבה,"
        },
        {
          "s": 8,
          "text": "שהרי השכל הוא מציאות,"
        },
        {
          "s": 9,
          "text": "היפך ההרגש דכלא חשיב,"
        },
        {
          "s": 10,
          "text": "אלא)"
        },
        {
          "s": 11,
          "text": "מצד הפנימיות והעצמיות שלה"
        },
        {
          "s": 12,
          "text": "(שבדוגמת ראי' דחכמה)"
        },
        {
          "s": 13,
          "text": "שלמעלה מהשכל,"
        },
        {
          "s": 14,
          "text": "וכיון דזה שנמשך בהבינה הוא רק ההשכלה דחכמה,"
        },
        {
          "s": 15,
          "text": "לכן בבינה הוא דעת תחתון."
        }
      ]
    }
  ]
}