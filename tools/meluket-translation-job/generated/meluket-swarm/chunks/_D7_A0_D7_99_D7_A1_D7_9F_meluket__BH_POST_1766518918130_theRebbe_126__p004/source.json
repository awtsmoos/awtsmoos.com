{
  "globalIndex": 745,
  "owner": 45,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918130_theRebbe_126__p004",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918130_theRebbe_126__p004",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518918130_theRebbe_126",
  "title": "מאמר לה\"ע תחיית המתים תשמ\"ו",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "אמנם,"
        },
        {
          "s": 2,
          "text": "גם הגילוי דימות המשיח הוא רק גילוי הסובב,"
        },
        {
          "s": 3,
          "text": "ולכן יהיו בו חילוקי מדריגות"
        },
        {
          "s": 4,
          "text": "(כנ\"ל),"
        },
        {
          "s": 5,
          "text": "משא\"כ הגילוי דתחיית המתים יהי'"
        },
        {
          "s": 6,
          "text": "(בכללותו)"
        },
        {
          "s": 7,
          "text": "לכל ישראל בשוה45,"
        },
        {
          "s": 8,
          "text": "לפי שבתחיית המתים יהי' גילוי עצמות אוא\"ס שלמעלה מהתחלקות."
        },
        {
          "s": 9,
          "text": "ובזה גופא יהיו שני ענינים."
        },
        {
          "s": 10,
          "text": "הגילוי דעצמות אוא\"ס שהמשיכו ע\"י קיום המצוות,"
        },
        {
          "s": 11,
          "text": "ועי\"ז יתעלו ישראל למדריגה עליונה יותר46,"
        },
        {
          "s": 12,
          "text": "שתתגלה מעלת ישראל עצמם,"
        },
        {
          "s": 13,
          "text": "נצר מטעי מעשה ידי להתפאר,"
        },
        {
          "s": 14,
          "text": "שמעלה זו שבישראל היא נעלית יותר מזה שממשיכים גילוי אלקות ע\"י לימוד התורה וקיום המצוות."
        },
        {
          "s": 15,
          "text": "דשרש הנשמות הוא בעצמותו ית'"
        },
        {
          "s": 16,
          "text": "(למעלה משורש התומ\"צ),"
        },
        {
          "s": 17,
          "text": "וגם בהגוף דישראל הוא בחירת העצמות47."
        }
      ]
    }
  ]
}