{
  "globalIndex": 833,
  "owner": 33,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918734_theRebbe_176__p001",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918734_theRebbe_176__p001",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918734_theRebbe_176",
  "title": "מאמר וידבר אלוקים את כל הדברים האלה תשכ\"ח",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "יום ב' דחג השבועות ה'תשכ\"ח"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "וידבר אלקים את כל הדברים האלה לאמר אנכי גו'1,"
        },
        {
          "s": 1,
          "text": "ומדייק אדמו\"ר הזקן2"
        },
        {
          "s": 2,
          "text": "מהו אומרו את כל הדברים האלה,"
        },
        {
          "s": 3,
          "text": "דלכאורה הול\"ל וידבר אלקים אנכי גו'."
        },
        {
          "s": 4,
          "text": "ומבאר,"
        },
        {
          "s": 5,
          "text": "דכל הדברים האלה קאי3"
        },
        {
          "s": 6,
          "text": "על כל התורה כולה,"
        },
        {
          "s": 7,
          "text": "כולל כל מה שתלמיד ותיק עתיד לחדש וכו'4."
        },
        {
          "s": 8,
          "text": "וזהו וידבר אלקים את כל הדברים האלה,"
        },
        {
          "s": 9,
          "text": "דבעשרת הדברות"
        },
        {
          "s": 10,
          "text": "(אנכי וגו')"
        },
        {
          "s": 11,
          "text": "נכלל כל התורה כולה"
        },
        {
          "s": 12,
          "text": "(כל הדברים האלה)."
        },
        {
          "s": 13,
          "text": "ויש לקשר זה עם פירוש רש\"י עה\"פ5,"
        },
        {
          "s": 14,
          "text": "דמ\"ש את כל הדברים האלה"
        },
        {
          "s": 15,
          "text": "(קודם לאנכי גו')"
        },
        {
          "s": 16,
          "text": "הוא ללמד שכל עשרת הדברות נאמרו"
        },
        {
          "s": 17,
          "text": "(תחילה)"
        },
        {
          "s": 18,
          "text": "בדיבור אחד,"
        },
        {
          "s": 19,
          "text": "ואח\"כ חזר ופירש כל דיבור ודיבור בפ\"ע,"
        },
        {
          "s": 20,
          "text": "דתוכנם של שני הפירושים הוא,"
        },
        {
          "s": 21,
          "text": "שנתינת התורה היתה בדרך כלל ופרט."
        },
        {
          "s": 22,
          "text": "אלא שלפי פירוש רש\"י מדבר הכתוב בעשרת הדברות עצמם,"
        },
        {
          "s": 23,
          "text": "שמתחילה נאמרו בבחינת כלל"
        },
        {
          "s": 24,
          "text": "(דיבור אחד)"
        },
        {
          "s": 25,
          "text": "ואח\"כ נפרטו כל דיבור ודיבור בפ\"ע,"
        },
        {
          "s": 26,
          "text": "ולפי פירוש אדמו\"ר הזקן מדבר הכתוב בהפרטים דתורה,"
        },
        {
          "s": 27,
          "text": "שגם הם ניתנו תחילה בבחינת כלל,"
        },
        {
          "s": 28,
          "text": "בעשרת הדברות,"
        },
        {
          "s": 29,
          "text": "ואח\"כ נפרטו ונמשכו בגילוי."
        },
        {
          "s": 30,
          "text": "ויש להוסיף,"
        },
        {
          "s": 31,
          "text": "שגם זה גופא"
        },
        {
          "s": 32,
          "text": "(הפירוט והגילוי דעשרת הדברות)"
        },
        {
          "s": 33,
          "text": "הי' באופן דכלל ופרט."
        },
        {
          "s": 34,
          "text": "דתחילת ההמשכה והפירוט דעשרת הדברות הוא בתורה שבכתב,"
        },
        {
          "s": 35,
          "text": "ואח\"כ נפרט בפרטיות יותר בתורה שבעל פה,"
        },
        {
          "s": 36,
          "text": "דכל התורה שבעל פה היא פירוש6"
        },
        {
          "s": 37,
          "text": "וביאור דתורה שבכתב7"
        },
        {
          "s": 38,
          "text": "(מנא הני מילי אמר קרא),"
        },
        {
          "s": 39,
          "text": "והתורה שבעל פה גופא היא ג\"כ באופן דכלל ופרט,"
        },
        {
          "s": 40,
          "text": "משנה ברייתא8"
        },
        {
          "s": 41,
          "text": "גמרא וכו' עד כל מה שתלמיד ותיק עתיד לחדש."
        },
        {
          "s": 42,
          "text": "וצריך להבין9,"
        },
        {
          "s": 43,
          "text": "מכיון שכל הפרטים דתורה,"
        },
        {
          "s": 44,
          "text": "עד לכל מה שתלמיד ותיק עתיד לחדש,"
        },
        {
          "s": 45,
          "text": "הכל ניתן למשה בסיני4,"
        },
        {
          "s": 46,
          "text": "למה לא ניתנו מלכתחילה באופן גלוי,"
        },
        {
          "s": 47,
          "text": "ומדוע ניתנו תחילה בבחינת כלל."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויובן זה10"
        },
        {
          "s": 2,
          "text": "ממה שמצינו עד\"ז גם בבריאת העולם"
        },
        {
          "s": 3,
          "text": "(אסתכל באורייתא וברא עלמא11),"
        },
        {
          "s": 4,
          "text": "שהיתה באופן דכלל ופרט."
        },
        {
          "s": 5,
          "text": "דאמרו רז\"ל12"
        },
        {
          "s": 6,
          "text": "בעשרה מאמרות נברא העולם כו' במאמר אחד יכול להבראות,"
        },
        {
          "s": 7,
          "text": "וידוע13"
        },
        {
          "s": 8,
          "text": "דמאמר אחד הוא המאמר דבראשית"
        },
        {
          "s": 9,
          "text": "(בראשית נמי מאמר הוא14),"
        },
        {
          "s": 10,
          "text": "שהוא מאמר כללי שכולל ט' המאמרות שלאחריו."
        },
        {
          "s": 11,
          "text": "דזהו מ\"ש15"
        },
        {
          "s": 12,
          "text": "בראשית ברא אלקים את השמים ואת הארץ וארז\"ל16"
        },
        {
          "s": 13,
          "text": "את השמים לרבות צבאיהם ואת הארץ לרבות צבאי',"
        },
        {
          "s": 14,
          "text": "שכל הנבראים נתהוו מהמאמר דבראשית"
        },
        {
          "s": 15,
          "text": "(להיותו מאמר כללי שכולל את כל המאמרות)."
        },
        {
          "s": 16,
          "text": "אלא שהיו בבחינת כלל17,"
        },
        {
          "s": 17,
          "text": "ואח\"כ נפרט המאמר דבראשית בהט' מאמרות שלאחריו18,"
        },
        {
          "s": 18,
          "text": "ועי\"ז נעשו הנבראים בבחינת התחלקות פרטים."
        }
      ]
    }
  ]
}