{
  "globalIndex": 155,
  "owner": 5,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914597_theRebbe_351__p002",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914597_theRebbe_351__p002",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914597_theRebbe_351",
  "title": "מאמר אלה תולדות נח תנש\"א",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר28,"
        },
        {
          "s": 2,
          "text": "דמנחת שבת וכן סעודה שלישית דשבת,"
        },
        {
          "s": 3,
          "text": "היא למעלה משתי השבתות"
        },
        {
          "s": 4,
          "text": "(מעלי דשבתא ויומא דשבתא),"
        },
        {
          "s": 5,
          "text": "ועד שלגבי בחינה זו,"
        },
        {
          "s": 6,
          "text": "שתי השבתות הם בשוה."
        },
        {
          "s": 7,
          "text": "וזהו זכור ושמור בדיבור אחד נאמרו29,"
        },
        {
          "s": 8,
          "text": "דזכור ושמור הם יומא דשבתא ומעלי דשבתא"
        },
        {
          "s": 9,
          "text": "[זכור לדכורא30"
        },
        {
          "s": 10,
          "text": "(משפיע)"
        },
        {
          "s": 11,
          "text": "הוא יומא דשבתא,"
        },
        {
          "s": 12,
          "text": "המשכה מלמעלה למטה,"
        },
        {
          "s": 13,
          "text": "ושמור לנוקבא30"
        },
        {
          "s": 14,
          "text": "(מקבל)"
        },
        {
          "s": 15,
          "text": "הוא מעלי דשבתא,"
        },
        {
          "s": 16,
          "text": "העלאה מלמטה למעלה31],"
        },
        {
          "s": 17,
          "text": "ולגבי גילוי הבחינה דמנחת שבת,"
        },
        {
          "s": 18,
          "text": "המשפיע והמקבל הם בשוה,"
        },
        {
          "s": 19,
          "text": "זכור ושמור בדיבור אחד."
        },
        {
          "s": 20,
          "text": "ויש לקשר זה עם מה שאומרים במנחת שבת כי מאתך היא מנוחתם,"
        },
        {
          "s": 21,
          "text": "שהמנוחה דשבת"
        },
        {
          "s": 22,
          "text": "(שמתגלית במנחת שבת,"
        },
        {
          "s": 23,
          "text": "רעוא דרעוין32)"
        },
        {
          "s": 24,
          "text": "היא מאתך,"
        },
        {
          "s": 25,
          "text": "מאתך ממש33."
        },
        {
          "s": 26,
          "text": "ומנוחה זו היא כוללת גם המנוחה דיומא דשבתא ודמעלי שבתא,"
        },
        {
          "s": 27,
          "text": "זכור ושמור."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דענין זכור ושמור בדיבור אחד בעבודת האדם הוא,"
        },
        {
          "s": 2,
          "text": "שקיום המצוות שלו הוא"
        },
        {
          "s": 3,
          "text": "[לא מפני שהורגל כן והרגל נעשה טבע34,"
        },
        {
          "s": 4,
          "text": "טבע הגוף ונפש הטבעית,"
        },
        {
          "s": 5,
          "text": "תחתון שבאדם,"
        },
        {
          "s": 6,
          "text": "וגם לא מפני שאוהב את הוי' וחפץ לדבקה בו ואי אפשר לדבקה בו באמת כי אם בקיום רמ\"ח פיקודין שהם35"
        },
        {
          "s": 7,
          "text": "רמ\"ח אברין דמלכא36,"
        },
        {
          "s": 8,
          "text": "דקיום המצוות באופן זה הוא מצד הנשמה"
        },
        {
          "s": 9,
          "text": "(נפש האלקית),"
        },
        {
          "s": 10,
          "text": "עליון שבאדם,"
        },
        {
          "s": 11,
          "text": "אלא שקיום המצוות שלו הוא]"
        },
        {
          "s": 12,
          "text": "מצד המצוה עצמה,"
        },
        {
          "s": 13,
          "text": "מצוה מלשון צוותא וחיבור37,"
        },
        {
          "s": 14,
          "text": "שהוא מתאחד ומתחבר עם אוא\"ס מצַוה המצוות שלמעלה מהגדר דעליון ותחתון"
        },
        {
          "s": 15,
          "text": "(נשמה וגוף)"
        },
        {
          "s": 16,
          "text": "וכולל שניהם."
        },
        {
          "s": 17,
          "text": "וזהו\"ע זכור ושמור בדיבור אחד,"
        },
        {
          "s": 18,
          "text": "דכוונת המצוה השייכת לנשמה"
        },
        {
          "s": 19,
          "text": "(זכור)"
        },
        {
          "s": 20,
          "text": "ומעשה המצוה השייכת להגוף"
        },
        {
          "s": 21,
          "text": "(שמור),"
        },
        {
          "s": 22,
          "text": "הם כולא חד."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "שהמעלה דמנחת שבת על הכפילות"
        },
        {
          "s": 2,
          "text": "(וההתכללות)"
        },
        {
          "s": 3,
          "text": "דשתי השבתות שכל אחת מהם כלולה משתיהן"
        },
        {
          "s": 4,
          "text": "(כנ\"ל סעיף ב),"
        },
        {
          "s": 5,
          "text": "היא,"
        },
        {
          "s": 6,
          "text": "דבענין ההתכללות"
        },
        {
          "s": 7,
          "text": "(דלעיל שם),"
        },
        {
          "s": 8,
          "text": "כל אחד מהם הוא ענין לעצמו,"
        },
        {
          "s": 9,
          "text": "אלא שכלול גם מענין השני."
        },
        {
          "s": 10,
          "text": "דואהבת את ה' אלקיך הוא מצד הנשמה,"
        },
        {
          "s": 11,
          "text": "אלא שהאהבה דהנשמה נמשכת גם בחלל השמאלי38,"
        },
        {
          "s": 12,
          "text": "ועד שמתפשטת גם בכל הכחות והאברים וניכרת גם בחלקו בעולם."
        },
        {
          "s": 13,
          "text": "והענין דמעשה המצוות שייך בעיקר לגוף האדם,"
        },
        {
          "s": 14,
          "text": "אלא שבכדי שקיום המצוה תהי' לשמה הוא ע\"י האהבה ויראה39."
        },
        {
          "s": 15,
          "text": "וענין זכור ושמור בדיבור אחד שבמנחת שבת הוא שכוונת המצוה"
        },
        {
          "s": 16,
          "text": "(דהנשמה)"
        },
        {
          "s": 17,
          "text": "ומעשה המצוה"
        },
        {
          "s": 18,
          "text": "(דהגוף)"
        },
        {
          "s": 19,
          "text": "הם כולא חד."
        }
      ]
    }
  ]
}