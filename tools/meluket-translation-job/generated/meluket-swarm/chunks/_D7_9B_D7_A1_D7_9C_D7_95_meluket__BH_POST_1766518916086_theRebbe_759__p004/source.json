  "globalIndex": 411,
  "owner": 11,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518916086_theRebbe_759__p004",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518916086_theRebbe_759__p004",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518916086_theRebbe_759",
  "title": "מאמר אמר ר' אלכסנדרי תשל\"א",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "והנה המאמר ד\"ה להבין מ\"ש בע\"ח הנ\"ל לאדה\"ז,"
        },
        {
          "s": 2,
          "text": "הי' עד עכשיו בהעלם,"
        },
        {
          "s": 3,
          "text": "וע\"י סיבות מסיבות שונות יצא מן המיצר כו' ונמצא עכשיו בדפוס,"
        },
        {
          "s": 4,
          "text": "וידועים דברי הצ\"צ32"
        },
        {
          "s": 5,
          "text": "שדבר שבדפוס הוא לדורי דורות."
        },
        {
          "s": 6,
          "text": "ויש לקשר זה עם מ\"ש33"
        },
        {
          "s": 7,
          "text": "מלחמה להוי' בעמלק מדור דור,"
        },
        {
          "s": 8,
          "text": "שישנם בזה כמה פירושים ודרגות,"
        },
        {
          "s": 9,
          "text": "דורו של משה ודורו של שמואל,"
        },
        {
          "s": 10,
          "text": "דורו של משה ושמואל ודורו של משיח34,"
        },
        {
          "s": 11,
          "text": "שאז יהי'"
        },
        {
          "s": 12,
          "text": "(לא רק תמחה35"
        },
        {
          "s": 13,
          "text": "אלא גם)"
        },
        {
          "s": 14,
          "text": "מחה אמחה גו'36,"
        },
        {
          "s": 15,
          "text": "והוא שע\"י העבודה דיפוצו מעינותיך חוצה"
        },
        {
          "s": 16,
          "text": "(שכל אחד מתעסק בזה,"
        },
        {
          "s": 17,
          "text": "ומכאן ולהבא יתעסק עוד יותר)"
        },
        {
          "s": 18,
          "text": "נזכה לביאת משיח צדקנו37"
        },
        {
          "s": 19,
          "text": "בקרוב בימינו ובעגלא דידן."
        }
      ]
    }
  ]
}