{
  "globalIndex": 575,
  "owner": 25,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917050_theRebbe_195__p002",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917050_theRebbe_195__p002",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518917050_theRebbe_195",
  "title": "מאמר הנני ממטיר לכם תשל\"ז",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה במשנה תורה11"
        },
        {
          "s": 2,
          "text": "כתיב ויאכילך את המן גו' למען הודיעך כי לא על הלחם לבדו יחי' האדם כי על כל מוצא פי הוי' יחי' האדם,"
        },
        {
          "s": 3,
          "text": "והיינו דנוסף לזה שענין המן הוא למען אנסנו הילך בתורתי גו',"
        },
        {
          "s": 4,
          "text": "ישנו עוד ענין בהמן,"
        },
        {
          "s": 5,
          "text": "שהוא למען הודיעך כי לא על הלחם לבדו יחי' האדם כי על כל מוצא פי הוי' יחי' האדם."
        },
        {
          "s": 6,
          "text": "וצ\"ל שייכות ב' הענינים זל\"ז."
        },
        {
          "s": 7,
          "text": "עוד צלה\"ב,"
        },
        {
          "s": 8,
          "text": "דלכאורה יש בזה תמיהה גדולה ונפלאה,"
        },
        {
          "s": 9,
          "text": "למה צריכים"
        },
        {
          "s": 10,
          "text": "(אָנקומען)"
        },
        {
          "s": 11,
          "text": "להמן כדי לידע שכל המציאות כולה תלוי' במוצא פי הוי',"
        },
        {
          "s": 12,
          "text": "והרי לכאורה הוא דבר פשוט שלעולם הוי' דברך נצב בשמים12,"
        },
        {
          "s": 13,
          "text": "היינו שהמוצא פי הוי' שבכל דבר הוא המהווה ומחי' ומקיים אותו13,"
        },
        {
          "s": 14,
          "text": "שענין זה הוא באמונה פשוטה אצל כאו\"א מישראל שנקראו מאמינים בני מאמינים עוד בהיותם בארץ מצרים14,"
        },
        {
          "s": 15,
          "text": "עאכו\"כ לאחרי היציאה ממצרים,"
        },
        {
          "s": 16,
          "text": "שנגלה עליהם ממה\"מ הקב\"ה בכבודו ובעצמו כו',"
        },
        {
          "s": 17,
          "text": "ובפרט לאחרי קריעת י\"ס בשביעי של פסח שאז אמרו זה א-לי ואנוהו15,"
        },
        {
          "s": 18,
          "text": "וא\"כ ה\"ז לכאורה בפשטות שעל כל מוצא פי הוי' יחי' האדם,"
        },
        {
          "s": 19,
          "text": "ומהו החידוש דהנני ממטיר לכם לחם מן השמים,"
        },
        {
          "s": 20,
          "text": "ויאכילך את המן גו' שעי\"ז דוקא באה הידיעה שלא על הלחם לבדו יחי' האדם כי על כל מוצא פי הוי' יחי' האדם."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "אך כללות נקודת הביאור בזה היא,"
        },
        {
          "s": 2,
          "text": "דהחידוש דלחם מן השמים בא לאחרי שהי' הענין דלחם מן הארץ בתכלית העילוי שלו,"
        },
        {
          "s": 3,
          "text": "ואעפ\"כ אומרים שישנו עילוי גדול יותר בלחם מן השמים"
        },
        {
          "s": 4,
          "text": "(כדלקמן)."
        },
        {
          "s": 5,
          "text": "ועד\"ז הוא בנוגע להחידוש דלמען הודיעך כי לא על הלחם לבדו יחי' האדם,"
        },
        {
          "s": 6,
          "text": "דאין הכוונה בזה להודיע שאין העולם ח\"ו באופן שאין בעה\"ב לבירה זו והלחם הוא מציאות בפ\"ע,"
        },
        {
          "s": 7,
          "text": "אלא שזה הי' ידוע בפשטות שהלחם מתהווה מפי הוי' שבו,"
        },
        {
          "s": 8,
          "text": "ממכ\"ע,"
        },
        {
          "s": 9,
          "text": "אבל עדיין אי\"ז הידיעה דאמיתית הענינים,"
        },
        {
          "s": 10,
          "text": "שממוצא פי הוי' יחי' האדם."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ויובן כ\"ז בהקדם הביאור בהחילוק שבין לחם מן השמים ללחם מן הארץ כפי שהוא ברוחניות הענין."
        },
        {
          "s": 2,
          "text": "שזהו בדוגמת החילוק בעבודה בין תורה למצוות."
        },
        {
          "s": 3,
          "text": "דהעבודה דתורה היא באופן דהמשכה מלמעלמ\"ט,"
        },
        {
          "s": 4,
          "text": "הלא כה דברי גו'16"
        },
        {
          "s": 5,
          "text": "ואשים דברי בפיך גו'17,"
        },
        {
          "s": 6,
          "text": "היינו שזהו דבר הוי' שנמשך למטה"
        },
        {
          "s": 7,
          "text": "(לחם מן השמים)."
        },
        {
          "s": 8,
          "text": "ולכן אין שייך בזה שינויים דהתורה היא נצחית18."
        },
        {
          "s": 9,
          "text": "משא\"כ מעשה המצוות,"
        },
        {
          "s": 10,
          "text": "הנה אע\"פ שגם זה בא ע\"י לימוד התורה וכמאמר19"
        },
        {
          "s": 11,
          "text": "גדול לימוד שמביא לידי מעשה,"
        },
        {
          "s": 12,
          "text": "מ\"מ הרי זה קשור בפעולת האדם שצריך לעשות מהקלף גשמי שיהי' הענין דתפילין,"
        },
        {
          "s": 13,
          "text": "ומהצמר גשמי שיהי' הענין דציצית וכו'"
        },
        {
          "s": 14,
          "text": "(שזהו\"ע מן הארץ)."
        },
        {
          "s": 15,
          "text": "ובתוספת ביאור יובן זה מב' הענינים כפי שהם בתורה עצמה"
        },
        {
          "s": 16,
          "text": "(שהרי כל הענינים שבעולם תחלתם היא כפי שהם בתורה),"
        },
        {
          "s": 17,
          "text": "שזהו תושב\"כ ותושבע\"פ20."
        },
        {
          "s": 18,
          "text": "דבתושב\"כ הרי כל אות וכל תג הוא מנוי וספור בדיוק,"
        },
        {
          "s": 19,
          "text": "ואין שייך לומר בזה לא הוספה ולא גרעון ח\"ו"
        },
        {
          "s": 20,
          "text": "(מן השמים),"
        },
        {
          "s": 21,
          "text": "משא\"כ בתושבע\"פ כתיב21"
        },
        {
          "s": 22,
          "text": "ארוכה מארץ מדה ורחבה מני ים,"
        },
        {
          "s": 23,
          "text": "ועד באופן דועלמות אין מספר22,"
        },
        {
          "s": 24,
          "text": "בל\"ג,"
        },
        {
          "s": 25,
          "text": "שזה בא23"
        },
        {
          "s": 26,
          "text": "ע\"י יגיעת האדם"
        },
        {
          "s": 27,
          "text": "(מן הארץ)"
        },
        {
          "s": 28,
          "text": "דיגעת ולא מצאת אל תאמין24,"
        },
        {
          "s": 29,
          "text": "דמכיון שהוא יגע כדבעי"
        },
        {
          "s": 30,
          "text": "(כפי תביעת התורה)"
        },
        {
          "s": 31,
          "text": "הרי דבר ברור שעי\"ז יש לו לפי אופן היגיעה,"
        },
        {
          "s": 32,
          "text": "ועד לאופן של מציאה ומצאת."
        },
        {
          "s": 33,
          "text": "והנה כמו שהוא בקו התורה,"
        },
        {
          "s": 34,
          "text": "כן הוא גם בשאר הב' קוין דגמ\"ח"
        },
        {
          "s": 35,
          "text": "(מצוות)"
        },
        {
          "s": 36,
          "text": "ועבודה."
        },
        {
          "s": 37,
          "text": "דישנו חילוק זה"
        },
        {
          "s": 38,
          "text": "(בקו הגמ\"ח)"
        },
        {
          "s": 39,
          "text": "בין עבודתו הרוחנית"
        },
        {
          "s": 40,
          "text": "(מצוות)"
        },
        {
          "s": 41,
          "text": "לעבודתו עם העולם באופן שצריך יגיעת נפש ויגיעת בשר כדי להפוך את העולם שיהי' דירה לו ית' בתחתונים."
        },
        {
          "s": 42,
          "text": "ועד\"ז ישנם ב' ענינים אלו בעבודה גופא"
        },
        {
          "s": 43,
          "text": "(שהיא הממוצע בין תורה לגמ\"ח),"
        },
        {
          "s": 44,
          "text": "דישנה העבודה דאהבה בתענוגים,"
        },
        {
          "s": 45,
          "text": "ועד\"ז העבודה דיום השבת,"
        },
        {
          "s": 46,
          "text": "וקראת לשבת עונג25,"
        },
        {
          "s": 47,
          "text": "שענין העונג"
        },
        {
          "s": 48,
          "text": "(דאהבה בתענוגים ודשבת)"
        },
        {
          "s": 49,
          "text": "קשור עם ענין המנוחה,"
        },
        {
          "s": 50,
          "text": "היינו שאין אז כל ענין היגיעה,"
        },
        {
          "s": 51,
          "text": "וכמבואר בתניא26"
        },
        {
          "s": 52,
          "text": "דאהבה בתענוגים ענינה הוא דוגמת מתן שכר כו',"
        },
        {
          "s": 53,
          "text": "משא\"כ העבודה,"
        },
        {
          "s": 54,
          "text": "מלשון עבוד עורות27"
        },
        {
          "s": 55,
          "text": "והעבודה דימות החול,"
        },
        {
          "s": 56,
          "text": "שכללות ענין עבודות אלו הוא ע\"י יגיעה ועבודה גדולה."
        }
      ]
    }
  ]
}