{
  "globalIndex": 1029,
  "owner": 29,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919866_theRebbe_58__p002",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919866_theRebbe_58__p002",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919866_theRebbe_58",
  "title": "מאמר ויענך וירעיבך ויאכילך תשכ\"ג",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים דאיתא במדרש17"
        },
        {
          "s": 2,
          "text": "שהמן הי' מאכל רעבון."
        },
        {
          "s": 3,
          "text": "דפירוש וירעיבך גו' את המן הוא ש\"וירעיבך\" קאי על \"את המן\","
        },
        {
          "s": 4,
          "text": "שהמן הרעיב אותך."
        },
        {
          "s": 5,
          "text": "והענין הוא,"
        },
        {
          "s": 6,
          "text": "דמן רומז לאגדה"
        },
        {
          "s": 7,
          "text": "[כמ\"ש18"
        },
        {
          "s": 8,
          "text": "והוא כזרע גד לבן ואיתא במכילתא כאגדה שמושכת לבו של אדם],"
        },
        {
          "s": 9,
          "text": "שהוא19"
        },
        {
          "s": 10,
          "text": "פנימיות התורה."
        },
        {
          "s": 11,
          "text": "וכמבואר בכ\"מ20"
        },
        {
          "s": 12,
          "text": "דלחם מן הארץ הוא גליא דתורה,"
        },
        {
          "s": 13,
          "text": "ולחם מן השמים"
        },
        {
          "s": 14,
          "text": "(מן)"
        },
        {
          "s": 15,
          "text": "הוא פנימיות התורה."
        },
        {
          "s": 16,
          "text": "וכיון שבפנימיות התורה הוא רק ידיעת המציאות ולא השגת המהות21,"
        },
        {
          "s": 17,
          "text": "לכן,"
        },
        {
          "s": 18,
          "text": "הלימוד דפנימיות התורה קשור ברעבון"
        },
        {
          "s": 19,
          "text": "(ע\"ד הרעב לשמוע את דבר ה'22)"
        },
        {
          "s": 20,
          "text": "להשיג המהות23."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ובעומק יותר יש לומר דמ\"ש במדרש שהמן הוא מאכל רעבון,"
        },
        {
          "s": 1,
          "text": "הכוונה בזה היא"
        },
        {
          "s": 2,
          "text": "(לא רק שהמן פועל אינו שולל רעבון באדם האוכלו,"
        },
        {
          "s": 3,
          "text": "אלא גם)"
        },
        {
          "s": 4,
          "text": "שהמן עצמו הוא מאכל רעבון."
        },
        {
          "s": 5,
          "text": "ויובן זה בהקדים שביאור הנ\"ל דלחם מן הארץ הוא גליא דתורה ולחם מן השמים הוא פנימיות התורה,"
        },
        {
          "s": 6,
          "text": "הוא בכללות,"
        },
        {
          "s": 7,
          "text": "אבל בפרטיות,"
        },
        {
          "s": 8,
          "text": "שני ענינים אלה"
        },
        {
          "s": 9,
          "text": "(לחם מן הארץ ולחם מן השמים)"
        },
        {
          "s": 10,
          "text": "הם גם בפנימיות התורה."
        },
        {
          "s": 11,
          "text": "והענין הוא,"
        },
        {
          "s": 12,
          "text": "דאיתא בתניא24"
        },
        {
          "s": 13,
          "text": "שבלימוד פנימיות התורה שני ענינים."
        },
        {
          "s": 14,
          "text": "שהיא מצוה רמה25"
        },
        {
          "s": 15,
          "text": "ונשאה ושמביאה ללב שלם."
        },
        {
          "s": 16,
          "text": "ויש לומר,"
        },
        {
          "s": 17,
          "text": "שהלימוד דפנימיות התורה לפי שמביאה ללב שלם,"
        },
        {
          "s": 18,
          "text": "כיון ששייך לענין הבירורים"
        },
        {
          "s": 19,
          "text": "(בירור המדות),"
        },
        {
          "s": 20,
          "text": "הוא דומה ללחם מן הארץ,"
        },
        {
          "s": 21,
          "text": "ועיקר הענין דלחם מן השמים הוא בהלימוד והידיעה דפנימיות התורה מצד עצמו26."
        },
        {
          "s": 22,
          "text": "ויש לומר,"
        },
        {
          "s": 23,
          "text": "שהחילוק דשני אופני הלימוד הוא גם בדרגת השכל."
        },
        {
          "s": 24,
          "text": "דהלימוד והידיעה דפנימיות התורה בכדי לבוא ללב שלם הוא במוחין השייכים למדות,"
        },
        {
          "s": 25,
          "text": "והלימוד והידיעה דפנימיות התורה מצד עצמה הוא במוחין שלמעלה ממדות."
        },
        {
          "s": 26,
          "text": "ועפ\"ז יש לבאר שהמן הוא מאכל רעבון,"
        },
        {
          "s": 27,
          "text": "כי ענין שביעה"
        },
        {
          "s": 28,
          "text": "(בענין השכל)"
        },
        {
          "s": 29,
          "text": "הוא שהוא תופס את השכל,"
        },
        {
          "s": 30,
          "text": "ולכן,"
        },
        {
          "s": 31,
          "text": "הידיעה וההשגה דמוחין השייכים למדות"
        },
        {
          "s": 32,
          "text": "(לחם מן הארץ שבפנימיות התורה)"
        },
        {
          "s": 33,
          "text": "שהיא נתפסת בשכל האדם בהשגה ותפיסא ממש"
        },
        {
          "s": 34,
          "text": "(שלכן פועלת ההשגה גם בהמדות שלו)"
        },
        {
          "s": 35,
          "text": "היא מאכל המשביע,"
        },
        {
          "s": 36,
          "text": "והידיעה וההשגה דמוחין שלמעלה ממדות"
        },
        {
          "s": 37,
          "text": "(לחם מן השמים,"
        },
        {
          "s": 38,
          "text": "מן)"
        },
        {
          "s": 39,
          "text": "שהיא באופן דהפלאה ואינה נתפסת"
        },
        {
          "s": 40,
          "text": "(כ\"כ)"
        },
        {
          "s": 41,
          "text": "בשכל האדם,"
        },
        {
          "s": 42,
          "text": "היא מאכל רעבון."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "שהחילוק דשני הפירושים במאכל רעבון,"
        },
        {
          "s": 3,
          "text": "שפועל שאינו שולל רעבון בהאדם ושהמאכל עצמו הוא רעבון שלמעלה מתפיסא"
        },
        {
          "s": 4,
          "text": "(אף שגם הידיעה שפועלת רעבון בהאדם הוא לפי שהיא למעלה מההשגה שלו),"
        },
        {
          "s": 5,
          "text": "הוא,"
        },
        {
          "s": 6,
          "text": "שידיעה זו היא בדרגת השכל שבערך המדות,"
        },
        {
          "s": 7,
          "text": "אלא שהיא למעלה מהם,"
        },
        {
          "s": 8,
          "text": "ולכן פועלת בהאדם"
        },
        {
          "s": 9,
          "text": "(שעיקרו מדות)"
        },
        {
          "s": 10,
          "text": "רעבון וצמאון להשיג את הענין."
        },
        {
          "s": 11,
          "text": "והידיעה שהיא עצמה בחינת רעבון,"
        },
        {
          "s": 12,
          "text": "היא בדרגת השכל שלמעלה ממדות"
        },
        {
          "s": 13,
          "text": "(כנ\"ל סעיף ב),"
        },
        {
          "s": 14,
          "text": "שלכן,"
        },
        {
          "s": 15,
          "text": "היא בחינת רעבון בעצם לגבי המדות."
        },
        {
          "s": 16,
          "text": "וכשמתגלית דרגא זו בהמדות,"
        },
        {
          "s": 17,
          "text": "הם בביטול."
        },
        {
          "s": 18,
          "text": "וע\"ד החילוק בין חכמה ובינה,"
        },
        {
          "s": 19,
          "text": "שע\"י ההשגה דבינה,"
        },
        {
          "s": 20,
          "text": "כאשר ההתבוננות וההשגה היא בההפלאה דאוא\"ס שלמעלה מעולמות,"
        },
        {
          "s": 21,
          "text": "הוא בא לידי אהבה רבה"
        },
        {
          "s": 22,
          "text": "(בתשוקה וצמאון),"
        },
        {
          "s": 23,
          "text": "יש מי שאוהב,"
        },
        {
          "s": 24,
          "text": "וע\"י הראי' דחכמה הוא בא ליראה,"
        },
        {
          "s": 25,
          "text": "ביטול27."
        },
        {
          "s": 26,
          "text": "אלא שאעפ\"כ גם דרגא זו דמן נק' בשם מאכל רעבון,"
        },
        {
          "s": 27,
          "text": "כי הזיכוך שע\"י אכילת המן הוא שהאדם האוכל את המן הוא בטל בתכלית,"
        },
        {
          "s": 28,
          "text": "ועי\"ז הוא נעשה"
        },
        {
          "s": 29,
          "text": "(כמו)"
        },
        {
          "s": 30,
          "text": "כלי לקבל חיות מאור שאינו בערכו."
        },
        {
          "s": 31,
          "text": "וע\"ד הענין דלהחיותם ברעב28"
        },
        {
          "s": 32,
          "text": "דיוהכ\"פ29,"
        },
        {
          "s": 33,
          "text": "שהרעב דיוהכ\"פ הוא בחינת תענוג עצמי הבלתי מורגש שלמעלה מאכילה ושתי'"
        },
        {
          "s": 34,
          "text": "[וכידוע30"
        },
        {
          "s": 35,
          "text": "שהטעם דיוהכ\"פ אסור באכילה ושתי' הוא לפי שביוהכ\"פ הוא גילוי תענוג עצמי הבלתי מורגש],"
        },
        {
          "s": 36,
          "text": "וענין להחיותם ברעב הוא שביוהכ\"פ מקבלים חיות מתענוג זה31."
        }
      ]
    }
  ]
}