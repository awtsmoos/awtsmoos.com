{
  "globalIndex": 450,
  "owner": 0,
  "jobId": "_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916328_theRebbe_715__p006",
  "batchId": "meluket-_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916328_theRebbe_715__p006",
  "seriesId": "טבת_meluket",
  "postId": "BH_POST_1766518916328_theRebbe_715",
  "title": "מאמר וארא אל אברהם תשל\"ה",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "ומבאר זה בהקדים דבהשראת השכינה בבית המקדש,"
        },
        {
          "s": 1,
          "text": "שהי' במקום גשמי,"
        },
        {
          "s": 2,
          "text": "ישנם ב' דיעות30."
        },
        {
          "s": 3,
          "text": "דעת הרמב\"ם31"
        },
        {
          "s": 4,
          "text": "[וכ\"ה דעת הרס\"ג32,"
        },
        {
          "s": 5,
          "text": "הרד\"ק33"
        },
        {
          "s": 6,
          "text": "ועוד,"
        },
        {
          "s": 7,
          "text": "כמובא בהמאמר],"
        },
        {
          "s": 8,
          "text": "דכיון שהקב\"ה אינו בגדר מקום לכן אין שייך לומר שהשראת השכינה היתה במקום המקדש עצמו"
        },
        {
          "s": 9,
          "text": "(באופן דהתלבשות),"
        },
        {
          "s": 10,
          "text": "כי אם,"
        },
        {
          "s": 11,
          "text": "שמקום המקדש הוא מוכשר שיהי' על ידו גילוי אלקות לישראל שבאו לשם."
        },
        {
          "s": 12,
          "text": "וע\"ד כתיבת שכל ע\"י אצבעות היד,"
        },
        {
          "s": 13,
          "text": "שהיד היא רק אמצעי שעל ידה נמשך השכל"
        },
        {
          "s": 14,
          "text": "(בדרך מעביר),"
        },
        {
          "s": 15,
          "text": "אף שהיד עצמה אינה משגת השכל."
        },
        {
          "s": 16,
          "text": "ודעת הרמב\"ן34"
        },
        {
          "s": 17,
          "text": "היא שהשראת השכינה בבית המקדש היתה באופן דהתלבשות,"
        },
        {
          "s": 18,
          "text": "שהגילוי הי' בהמקדש עצמו."
        },
        {
          "s": 19,
          "text": "וע\"ד משכן השכל במוח,"
        },
        {
          "s": 20,
          "text": "שהשכל הוא מלובש בהמוח והמוח משיג את השכל."
        },
        {
          "s": 21,
          "text": "וההכרעה בתורת החסידות35"
        },
        {
          "s": 22,
          "text": "היא כדעת הרמב\"ן."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "[ולהעיר,"
        },
        {
          "s": 1,
          "text": "שבכלל,"
        },
        {
          "s": 2,
          "text": "המעלה שבהתלבשות היא בנוגע להתחתון,"
        },
        {
          "s": 3,
          "text": "אבל בנוגע לההמשכה עצמה,"
        },
        {
          "s": 4,
          "text": "ההמשכה שבדרך מעביר היא נעלית יותר מההמשכה שבדרך התלבשות."
        },
        {
          "s": 5,
          "text": "דכשההמשכה מתלבשת בהתחתון היא מתצמצמת ומשתנית כפי הכלי של התחתון,"
        },
        {
          "s": 6,
          "text": "משא\"כ כשהיא בדרך מעביר אינה מתצמצמת כ\"כ."
        },
        {
          "s": 7,
          "text": "וכמובן גם ממשלים הנ\"ל,"
        },
        {
          "s": 8,
          "text": "שהמעלה דהתלבשות השכל בהמוח היא בנוגע להמוח,"
        },
        {
          "s": 9,
          "text": "שהמוח משיג את השכל,"
        },
        {
          "s": 10,
          "text": "אבל בנוגע להשכל,"
        },
        {
          "s": 11,
          "text": "ע\"י שהשכל מתלבש במוח הגשמי,"
        },
        {
          "s": 12,
          "text": "נעשה בו צמצום והגשמה,"
        },
        {
          "s": 13,
          "text": "ובכתיבת שכל ע\"י אצבעות היד אין השכל משתנה ע\"י האצבעות."
        },
        {
          "s": 14,
          "text": "[וכמבואר בהדרושים שמדברים בענין מעביר והתלבשות36,"
        },
        {
          "s": 15,
          "text": "דכשההמשכה היא בדרך התלבשות היא מתייחסת להלבוש,"
        },
        {
          "s": 16,
          "text": "משא\"כ כשההמשכה היא רק בדרך מעביר."
        },
        {
          "s": 17,
          "text": "וכמבואר שם37"
        },
        {
          "s": 18,
          "text": "החילוק בין ארץ ישראל וחוץ לארץ38,"
        },
        {
          "s": 19,
          "text": "שבחוץ לארץ,"
        },
        {
          "s": 20,
          "text": "המשכת השפע ממלכות דאצילות כמו שהיא מלובשת במלכות דבריאה ודיצירה היא ע\"י שהיא מתלבשת במלכות דעשי',"
        },
        {
          "s": 21,
          "text": "ולכן שייך השפע למלכות דעשי'39,"
        },
        {
          "s": 22,
          "text": "ובא\"י המשכת השפע"
        },
        {
          "s": 23,
          "text": "(ממלכות דאצילות המלובשת במלכות דבריאה ודיצירה)"
        },
        {
          "s": 24,
          "text": "ע\"י מלכות דעשי' היא רק בדרך מעביר,"
        },
        {
          "s": 25,
          "text": "ולכן שייך השפע למלכות דיצירה39]."
        },
        {
          "s": 26,
          "text": "אבל זה שהשראת השכינה בביהמ\"ק היתה בדרך התלבשות – הכוונה בזה היא"
        },
        {
          "s": 27,
          "text": "(רק)"
        },
        {
          "s": 28,
          "text": "להמעלה שבהתלבשות,"
        },
        {
          "s": 29,
          "text": "דהגילוי שהאיר בביהמ\"ק"
        },
        {
          "s": 30,
          "text": "(גם לאחרי התלבשותו בביהמ\"ק שהי' במקום גשמי)"
        },
        {
          "s": 31,
          "text": "הי' למעלה מגדר מקום40,"
        },
        {
          "s": 32,
          "text": "וענין ההתלבשות הוא שהגילוי שלו בביהמ\"ק הגשמי הי' בפנימיות."
        },
        {
          "s": 33,
          "text": "ולהוסיף,"
        },
        {
          "s": 34,
          "text": "דזה שהשראת השכינה בביהמ\"ק היתה בדרך התלבשות,"
        },
        {
          "s": 35,
          "text": "מורה גם על גודל מעלת הגילוי שהאיר בו."
        },
        {
          "s": 36,
          "text": "דזה שהגילוי נמשך"
        },
        {
          "s": 37,
          "text": "(גם)"
        },
        {
          "s": 38,
          "text": "במקום גשמי ובאופן דהתלבשות הוא41"
        },
        {
          "s": 39,
          "text": "לפי שהגילוי שהאיר בביהמ\"ק הי' גילוי בלתי מוגבל]."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "ולאחרי שמבאר באריכות ענין השראת השכינה בביהמ\"ק,"
        },
        {
          "s": 1,
          "text": "ממשיך בהמאמר42,"
        },
        {
          "s": 2,
          "text": "דפירוש מדת אמת הוא כענין תיקון ואמת הפנוי משערות43"
        },
        {
          "s": 3,
          "text": "– בלי גבול,"
        },
        {
          "s": 4,
          "text": "וזהו שדוקא שם הוי' הוא מדת אמיתית,"
        },
        {
          "s": 5,
          "text": "כי שם שדי שבבריאת העולם על שם שאמרתי לעולמי די הוא שמאיר בגבול,"
        },
        {
          "s": 6,
          "text": "וגם שם שדי שנתגלה להאבות על שם שדי באלקותי לכל ברי' הוא שמאיר בגבול,"
        },
        {
          "s": 7,
          "text": "כי הנסים שנמשכים משם זה הם מלובשים בטבע,"
        },
        {
          "s": 8,
          "text": "ולכן דוקא שם הוי' הוא מדת אמיתית,"
        },
        {
          "s": 9,
          "text": "להיותו בלי גבול."
        },
        {
          "s": 10,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 11,
          "text": "שגם כל השמות הם אמת,"
        },
        {
          "s": 12,
          "text": "אלא שהוי' הוא אמת לאמיתו."
        }
      ]
    }
  ]
}