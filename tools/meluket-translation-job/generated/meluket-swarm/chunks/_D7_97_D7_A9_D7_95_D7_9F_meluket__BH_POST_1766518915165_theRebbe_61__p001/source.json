{
  "globalIndex": 233,
  "owner": 33,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915165_theRebbe_61__p001",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915165_theRebbe_61__p001",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518915165_theRebbe_61",
  "title": "מאמר ויאמר לו יהונתן תשל\"א",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ תולדות,"
        },
        {
          "s": 2,
          "text": "מבה\"ח וער\"ח כסלו,"
        },
        {
          "s": 3,
          "text": "תשל\"א"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "(הנחה)"
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ויאמר לו יהונתן מחר חודש ונפקדת כי יפקד מושבך1,"
        },
        {
          "s": 1,
          "text": "והיינו שע\"י ביטול המקבל שהו\"ע כי יפקד,"
        },
        {
          "s": 2,
          "text": "עי\"ז נעשה הזכרון למעלה"
        },
        {
          "s": 3,
          "text": "(וכמו שהוא כפשוטו),"
        },
        {
          "s": 4,
          "text": "שע\"י העלם והסתר הלבנה לגמרי בערב ראש חודש,"
        },
        {
          "s": 5,
          "text": "עד שלא נשאר ממנה גם נקודה,"
        },
        {
          "s": 6,
          "text": "עי\"ז נעשה מחר – חדש,"
        },
        {
          "s": 7,
          "text": "שהוא מולד הלבנה מחדש,"
        },
        {
          "s": 8,
          "text": "שהו\"ע יחוד שמשא וסיהרא."
        },
        {
          "s": 9,
          "text": "ובעבודה הוא שע\"י הביטול של המקבל נעשה עי\"ז ההתחדשות."
        },
        {
          "s": 10,
          "text": "והנה בכדי שיהי' ענין ההתחדשות צריך להיות נמשך מבחינה שלמעלה מסדר השתלשלות,"
        },
        {
          "s": 11,
          "text": "וכמו שיהי' לעתיד לבוא שתהי' התחדשות בהבריאה לפי שתהי' ההמשכה מבחינת פנימיות עתיק."
        },
        {
          "s": 12,
          "text": "דהנה כל ההמשכות עתה הם רק מחיצוניות עתיק משא\"כ לעתיד לבוא יהי' נמשך מפנימיות עתיק ממש2."
        },
        {
          "s": 13,
          "text": "והנה הגילויים דלעתיד תלוים במעשינו ועבודתנו במשך זמן הגלות3,"
        },
        {
          "s": 14,
          "text": "ולכן בחינת מולד הלבנה בר\"ח שהו\"ע החידוש,"
        },
        {
          "s": 15,
          "text": "הוא מעין מה שהם עתידים להתחדש כמותה לעתיד לבוא."
        },
        {
          "s": 16,
          "text": "וע\"ד המבואר במדרש4"
        },
        {
          "s": 17,
          "text": "בענין חדשים לבקרים רבה אמונתך,"
        },
        {
          "s": 18,
          "text": "שמזה שהאדם מתחדש בכל בקר כברי' חדשה הנה רבה אמונתך שהוא דוגמא לתחיית המתים שהקב\"ה מחייהו בטל תחי'5."
        },
        {
          "s": 19,
          "text": "אמנם עיקר ענין ההתחדשות יהי' לע\"ל דוקא כמבואר בלקו\"ת6"
        },
        {
          "s": 20,
          "text": "שאז יהיו נשמות חדשות."
        },
        {
          "s": 21,
          "text": "וע\"ה שגם עכשיו ישנן נשמות חדשות אבל אין זה אמיתית ענין ההתחדשות,"
        },
        {
          "s": 22,
          "text": "ואמיתית בחינת נשמות חדשות יהי' לע\"ל דוקא,"
        },
        {
          "s": 23,
          "text": "שזהו ענין ועטרותיהם7"
        },
        {
          "s": 24,
          "text": "בראשיהם8"
        },
        {
          "s": 25,
          "text": "וכו'."
        },
        {
          "s": 26,
          "text": "אבל עכ\"ז ישנו דוגמא לענין ההתחדשות גם עכשיו בראש חודש שע\"י הביטול וכו' מגיעים לבחינת עדן,"
        },
        {
          "s": 27,
          "text": "שע\"ז ארז\"ל9"
        },
        {
          "s": 28,
          "text": "כל הנביאים לא נתנבאו אלא לימות המשיח אבל לעוה\"ב עין לא ראתה אלקים זולתך10"
        },
        {
          "s": 29,
          "text": "וכו' זה עדן כו'."
        }
      ]
    }
  ]
}