{
  "globalIndex": 197,
  "owner": 47,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914911_theRebbe_655__p005",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914911_theRebbe_655__p005",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518914911_theRebbe_655",
  "title": "מאמר ויהיו חיי שרה תשמ\"א",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ומעשה אבות סימן לבנים,"
        },
        {
          "s": 2,
          "text": "שהעבודה דשרה היא הוראה ונתינת כח לכאו\"א מישראל"
        },
        {
          "s": 3,
          "text": "[ועד שענין זה שבכאו\"א מישראל הוא"
        },
        {
          "s": 4,
          "text": "(ככל הענינים דהאבות והאמהות)"
        },
        {
          "s": 5,
          "text": "בירושה73],"
        },
        {
          "s": 6,
          "text": "שיוכל לעבוד את ה' בשמחה בהתגלות,"
        },
        {
          "s": 7,
          "text": "והשמחה תהי' מיוסדת על ענין הביטול,"
        },
        {
          "s": 8,
          "text": "ונפשי כעפר לכל תהי'74."
        },
        {
          "s": 9,
          "text": "ולכן אין חשש75"
        },
        {
          "s": 10,
          "text": "שיסתעף מזה איזה ענין בלתי רצוי ח\"ו,"
        },
        {
          "s": 11,
          "text": "ואדרבא,"
        },
        {
          "s": 12,
          "text": "מכיון ששמחה פורץ גדר,"
        },
        {
          "s": 13,
          "text": "הנה ע\"י השמחה יוסיף אומץ בעבודתו ביתר שאת וביתר עז,"
        },
        {
          "s": 14,
          "text": "עד לעבודה שלמעלה ממדידה והגבלה,"
        },
        {
          "s": 15,
          "text": "ענין תגבורת החיות בעבודה."
        },
        {
          "s": 16,
          "text": "ועי\"ז נעשה גם תגבורת החיים כפשוטו,"
        },
        {
          "s": 17,
          "text": "אריכות ימים ושנים טובות בפשטות."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ויש לקשר זה עם יום ההולדת של כ\"ק אדמו\"ר נ\"ע דשנה זו,"
        },
        {
          "s": 2,
          "text": "(סיום וחותם)"
        },
        {
          "s": 3,
          "text": "שנה המאה ועשרים76,"
        },
        {
          "s": 4,
          "text": "דאיתא בזהר77"
        },
        {
          "s": 5,
          "text": "על הפסוק78"
        },
        {
          "s": 6,
          "text": "והיו ימיו מאה ועשרים שנה שהוא רמז למשה כו' שממשיך חיין לבני נשא"
        },
        {
          "s": 7,
          "text": "(לכאו\"א מישראל)"
        },
        {
          "s": 8,
          "text": "מההוא אילנא דחיין,"
        },
        {
          "s": 9,
          "text": "שבזה נכלל גם אריכות ימים בפשטות,"
        },
        {
          "s": 10,
          "text": "וכדאיתא בזהר שם"
        },
        {
          "s": 11,
          "text": "(לפנ\"ז)"
        },
        {
          "s": 12,
          "text": "בשגם78"
        },
        {
          "s": 13,
          "text": "דא משה79"
        },
        {
          "s": 14,
          "text": "כו' ומחילא דא קיימין בני נשא בעלמא יומין סגיאין."
        },
        {
          "s": 15,
          "text": "וענין זה ממשיך משה גם עכשיו,"
        },
        {
          "s": 16,
          "text": "כמו שממשיך בזהר שם משה לא מית כו',"
        },
        {
          "s": 17,
          "text": "וארז\"ל80"
        },
        {
          "s": 18,
          "text": "מה להלן עומד ומשמש אף כאן עומד ומשמש."
        },
        {
          "s": 19,
          "text": "וכמו שהוא במשה רבינו רעיא מהימנא,"
        },
        {
          "s": 20,
          "text": "כמו\"כ הוא ברועי ישראל שבכל דור ודור,"
        },
        {
          "s": 21,
          "text": "עד לבעל יום ההולדת ובנו כ\"ק מו\"ח אדמו\"ר ממלא מקומו,"
        },
        {
          "s": 22,
          "text": "וכידוע המכתב של כ\"ק מו\"ח אדמו\"ר81"
        },
        {
          "s": 23,
          "text": "(בנוגע לאביו."
        },
        {
          "s": 24,
          "text": "ומזה מובן שכ\"ה גם אצלו82)"
        },
        {
          "s": 25,
          "text": "שרועי ישראל לא יפרדו ח\"ו מעל צאן מרעיתם,"
        },
        {
          "s": 26,
          "text": "שהוא ע\"ד מארז\"ל הנ\"ל בנוגע למשה מה להלן עומד ומשמש אף כאן עומד ומשמש,"
        },
        {
          "s": 27,
          "text": "שגם עכשיו הוא"
        },
        {
          "s": 28,
          "text": "(בעל יום ההולדת,"
        },
        {
          "s": 29,
          "text": "ובמילא מובן – בנו ממלא מקומו)"
        },
        {
          "s": 30,
          "text": "ממליץ זכות על כל אחד ואחת מישראל,"
        },
        {
          "s": 31,
          "text": "וממשיך להם ברכות הצלחות וישועות,"
        },
        {
          "s": 32,
          "text": "ועד שממשיך מבחי' אילנא דחיין"
        },
        {
          "s": 33,
          "text": "(עץ החיים)"
        },
        {
          "s": 34,
          "text": "וגם אריכות ימים בפשטות לכל אחד ואחת מישראל."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "והנה כמו שענין דילה הוו חיין"
        },
        {
          "s": 2,
          "text": "(דשרה)"
        },
        {
          "s": 3,
          "text": "הוא דוגמת ונחי' לפניו שיהי' לעתיד"
        },
        {
          "s": 4,
          "text": "(כנ\"ל סוף סעיף ד וסעיף ה מהמאמר דבעל יום ההולדת),"
        },
        {
          "s": 5,
          "text": "עד\"ז הוא גם בענין הנתינת כח שנמשך מזה לכל אחד מישראל על העבודה בשמחה"
        },
        {
          "s": 6,
          "text": "(כנ\"ל סעיף ח),"
        },
        {
          "s": 7,
          "text": "שע\"י העבודה בשמחה נזכה בקרוב ממש לקיום היעוד52"
        },
        {
          "s": 8,
          "text": "ביום השלישי יקימנו ונחי' לפניו."
        },
        {
          "s": 9,
          "text": "והענין הוא,"
        },
        {
          "s": 10,
          "text": "דהנה מבואר בלקו\"ת"
        },
        {
          "s": 11,
          "text": "(ד\"ה יחיינו מיומיים ביום השלישי יקימנו ונחי' לפניו83),"
        },
        {
          "s": 12,
          "text": "דיומיים הם בחי' ממכ\"ע וסוכ\"ע,"
        },
        {
          "s": 13,
          "text": "וביום השלישי הוא בחי' שלמעלה גם מבחי' סוכ\"ע."
        },
        {
          "s": 14,
          "text": "היינו שאין בו שום מדידות והגבלות,"
        },
        {
          "s": 15,
          "text": "גם לא המדידה דסוכ\"ע."
        },
        {
          "s": 16,
          "text": "ומכיון ששמחה פורץ גדר,"
        },
        {
          "s": 17,
          "text": "וע\"י השמחה מגיעים"
        },
        {
          "s": 18,
          "text": "(כנ\"ל סעיף ח)"
        },
        {
          "s": 19,
          "text": "לעבודה שלמעלה ממדידה והגבלה,"
        },
        {
          "s": 20,
          "text": "לכן השמחה"
        },
        {
          "s": 21,
          "text": "(בעבודת ה')"
        },
        {
          "s": 22,
          "text": "היא הכנה קרובה וכלי לגילוי בחי' ביום השלישי"
        },
        {
          "s": 23,
          "text": "(יקימנו ונחי' לפניו),"
        },
        {
          "s": 24,
          "text": "בחי' שלמעלה"
        },
        {
          "s": 25,
          "text": "(גם)"
        },
        {
          "s": 26,
          "text": "מבחי' סוכ\"ע,"
        },
        {
          "s": 27,
          "text": "שגילוי זה יהי' בביהמ\"ק השלישי,"
        },
        {
          "s": 28,
          "text": "וכהפירוש84"
        },
        {
          "s": 29,
          "text": "דביום השלישי קאי על ביהמ\"ק השלישי,"
        },
        {
          "s": 30,
          "text": "שיבנה מלך המשיח85,"
        },
        {
          "s": 31,
          "text": "מלך מבית דוד86."
        },
        {
          "s": 32,
          "text": "וגם ענין זה שייך במיוחד לענין השמחה,"
        },
        {
          "s": 33,
          "text": "כמובן מזה שהרמב\"ם87"
        },
        {
          "s": 34,
          "text": "מביא ראי' על ענין השמחה שישמח אדם"
        },
        {
          "s": 35,
          "text": "(כל אדם)"
        },
        {
          "s": 36,
          "text": "בעשיית המצוה מדוד מלך ישראל דכתיב בי'88"
        },
        {
          "s": 37,
          "text": "והמלך89"
        },
        {
          "s": 38,
          "text": "דוד מפזז ומכרכר לפני ה' וגו'."
        },
        {
          "s": 39,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 40,
          "text": "דדוד מלך ישראל הו\"ע ספירת המלכות90,"
        },
        {
          "s": 41,
          "text": "וזהו שהי' בתכלית הביטול,"
        },
        {
          "s": 42,
          "text": "אם לא שויתי ודוממתי91,"
        },
        {
          "s": 43,
          "text": "כי מלכות היא בחי' ביטול,"
        },
        {
          "s": 44,
          "text": "כנ\"ל"
        },
        {
          "s": 45,
          "text": "(סעיף ד)."
        },
        {
          "s": 46,
          "text": "וזהו שעבודתו היתה בשמחה גדולה,"
        },
        {
          "s": 47,
          "text": "והמלך דוד מפזז ומכרכר לפני ה',"
        },
        {
          "s": 48,
          "text": "כי מצד הביטול דמלכות גם כשהשמחה היא בהתגלות אין שייך שיסתעף מזה ענין בלתי רצוי."
        },
        {
          "s": 49,
          "text": "ומכיון שדוד מלך ישראל חי וקיים92,"
        },
        {
          "s": 50,
          "text": "היינו שהוא חי וקיים"
        },
        {
          "s": 51,
          "text": "(בכאו\"א מישראל)"
        },
        {
          "s": 52,
          "text": "בתור דוד מלך ישראל"
        },
        {
          "s": 53,
          "text": "(הביטול דמלכות),"
        },
        {
          "s": 54,
          "text": "לכן הוא נותן הכח לכל אחד מישראל שישמח בעשיית המצוה"
        },
        {
          "s": 55,
          "text": "(אף שעבודה גדולה היא93),"
        },
        {
          "s": 56,
          "text": "ושהשמחה תהי' באופן הרצוי."
        }
      ]
    }
  ]
}