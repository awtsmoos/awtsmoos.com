{
  "globalIndex": 890,
  "owner": 40,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518919022_theRebbe_358__p005",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518919022_theRebbe_358__p005",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518919022_theRebbe_358",
  "title": "מאמר ואהי אצלו אמון תשכ\"א",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "והנה ההכנה למתן תורה הוא ענין ספירת העומר."
        },
        {
          "s": 2,
          "text": "דהנה,"
        },
        {
          "s": 3,
          "text": "ספירת העומר הוא ענין הבירורים,"
        },
        {
          "s": 4,
          "text": "ועז\"נ וספרתם לכם ממחרת השבת,"
        },
        {
          "s": 5,
          "text": "דמחרת השבת הוא למעלה מבחינת שבת,"
        },
        {
          "s": 6,
          "text": "והיינו,"
        },
        {
          "s": 7,
          "text": "ששבת"
        },
        {
          "s": 8,
          "text": "(שנאמר כאן)"
        },
        {
          "s": 9,
          "text": "הוא בחינת מנוחה שאחרי היגיעה,"
        },
        {
          "s": 10,
          "text": "ומחרת השבת הוא בחינת מנוחה בעצם,"
        },
        {
          "s": 11,
          "text": "שהוא בחינת עצם התענוג."
        },
        {
          "s": 12,
          "text": "ומבחינה זו נמשך הנתינת כח על עבודת הבירורים."
        },
        {
          "s": 13,
          "text": "וע\"ד משנת\"ל בענין עשיית מלאכה,"
        },
        {
          "s": 14,
          "text": "שעשיית המלאכה היא מצד התענוג שיש לו בהדבר,"
        },
        {
          "s": 15,
          "text": "שמשום זה הוא יורד בכח העשי' שלו ובשאר כחותיו לעשות המלאכה."
        },
        {
          "s": 16,
          "text": "ועד\"ז יובן למעלה,"
        },
        {
          "s": 17,
          "text": "שהכח על הירידה בעבודת הבירורים הוא מבחינת מחרת השבת,"
        },
        {
          "s": 18,
          "text": "עצם התענוג."
        },
        {
          "s": 19,
          "text": "וזהו וספרתם לכם ממחרת השבת גו',"
        },
        {
          "s": 20,
          "text": "שמבחינת מחרת השבת נמשך הנתינת כח על עבודת הבירורים דספירת העומר,"
        },
        {
          "s": 21,
          "text": "דפירוש וספרתם הוא כפירוש כ\"ק אדמו\"ר הזקן72"
        },
        {
          "s": 22,
          "text": "מלשון ספירות ובהירות,"
        },
        {
          "s": 23,
          "text": "שצריך לברר את כל המדות ולעשותם שיהיו ספירות ובהירות."
        },
        {
          "s": 24,
          "text": "ועי\"ז נמשך אח\"כ בחג השבועות בחינת מקיף החוזר,"
        },
        {
          "s": 25,
          "text": "שעז\"נ עד ממחרת השבת השביעית תספרו חמישים יום,"
        },
        {
          "s": 26,
          "text": "שהוא גילוי בחינת תענוג הבלתי מורגש."
        },
        {
          "s": 27,
          "text": "דעיקר גילוי זה יהי' לעתיד ביום שכולו שבת ומנוחה,"
        },
        {
          "s": 28,
          "text": "ומעין זה מאיר גם בסעודה שלישית דשבת כנ\"ל."
        },
        {
          "s": 29,
          "text": "וגם ביומא דשבתא ובמעלי שבתא מאיר מעין בחינה זו,"
        },
        {
          "s": 30,
          "text": "שלכן אומרים אז מזמור שיר ליום השבת73,"
        },
        {
          "s": 31,
          "text": "יום שכולו שבת ומנוחה74."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דזה שיציאת מצרים היתה הכנה למתן תורה,"
        },
        {
          "s": 2,
          "text": "דהכנה צריכה להיות מעין זה שמכינים,"
        },
        {
          "s": 3,
          "text": "הוא מפני שגם ביציאת מצרים הי'"
        },
        {
          "s": 4,
          "text": "(בהעלם)"
        },
        {
          "s": 5,
          "text": "גם בחינת מנוחה בעצם,"
        },
        {
          "s": 6,
          "text": "עצם האורה."
        },
        {
          "s": 7,
          "text": "וזהו מ\"ש75"
        },
        {
          "s": 8,
          "text": "בהוציאך את העם ממצרים תעבדון את האלקים על ההר הזה,"
        },
        {
          "s": 9,
          "text": "כי גם ביציאת מצרים הי' הענין שהאיר במתן תורה,"
        },
        {
          "s": 10,
          "text": "אלא שביציאת מצרים הי' זה בהעלם,"
        },
        {
          "s": 11,
          "text": "ובמתן תורה נמשך בגילוי."
        },
        {
          "s": 12,
          "text": "וזהו וספרתם לכם ממחרת השבת,"
        },
        {
          "s": 13,
          "text": "דזה שגם יציאת מצרים נקרא מחרת השבת,"
        },
        {
          "s": 14,
          "text": "הוא לפי שביציאת מצרים הי' גם עצם האור,"
        },
        {
          "s": 15,
          "text": "בחינת מנוחה בעצם,"
        },
        {
          "s": 16,
          "text": "אלא שמה שנמשך אז בגילוי הי' בשביל מכת בכורות,"
        },
        {
          "s": 17,
          "text": "מנוחה שאחרי המלחמה,"
        },
        {
          "s": 18,
          "text": "אבל בהעלם הי' בזה גם בחינת מנוחה בעצם."
        },
        {
          "s": 19,
          "text": "ולהוסיף,"
        },
        {
          "s": 20,
          "text": "דכיון שמהענין דמחרת השבת שביציאת מצרים נמשך הנתינת כח על ספירת העומר,"
        },
        {
          "s": 21,
          "text": "וספרתם לכם ממחרת השבת,"
        },
        {
          "s": 22,
          "text": "לכן,"
        },
        {
          "s": 23,
          "text": "יש דוגמת ענין זה גם בספירת העומר."
        },
        {
          "s": 24,
          "text": "דהנה,"
        },
        {
          "s": 25,
          "text": "בספירת העומר נאמר שבע שבתות תמימות תהיינה,"
        },
        {
          "s": 26,
          "text": "שבכל ספירה צריכה להיות תמימות,"
        },
        {
          "s": 27,
          "text": "שלכן אם החסיר לספור פעם אחת אזי חסר בכל ימי הספירה76,"
        },
        {
          "s": 28,
          "text": "לפי שכל אחת צריכה להיות בתמימות,"
        },
        {
          "s": 29,
          "text": "ויתירה מזה,"
        },
        {
          "s": 30,
          "text": "שכל אחת צריכה להיות בשלימות"
        },
        {
          "s": 31,
          "text": "[דאמיתית ענין התמימות הוא"
        },
        {
          "s": 32,
          "text": "(לא רק שאין בו חסרון,"
        },
        {
          "s": 33,
          "text": "אלא)"
        },
        {
          "s": 34,
          "text": "גם ענין השלימות,"
        },
        {
          "s": 35,
          "text": "כתורת הבעש\"ט77"
        },
        {
          "s": 36,
          "text": "עה\"פ78"
        },
        {
          "s": 37,
          "text": "תורת ה' תמימה – \"והיא שלימה\","
        },
        {
          "s": 38,
          "text": "כמשנת\"ל79."
        },
        {
          "s": 39,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 40,
          "text": "דזה שבכל ספירה צריכה להיות תמימות,"
        },
        {
          "s": 41,
          "text": "הוא"
        },
        {
          "s": 42,
          "text": "(לא רק שלא יהי' חסרון,"
        },
        {
          "s": 43,
          "text": "אלא)"
        },
        {
          "s": 44,
          "text": "שיהי' בה גם שלימות],"
        },
        {
          "s": 45,
          "text": "וענין התמימות ושלימות הוא מנוחה בעצם."
        },
        {
          "s": 46,
          "text": "ועי\"ז נמשך להיות אח\"כ מחרת השבת השביעית,"
        },
        {
          "s": 47,
          "text": "גילוי תענוג העצמי,"
        },
        {
          "s": 48,
          "text": "בשעת מתן תורה."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "וזהו ואהי' אצלו אמון גו' שעשועים,"
        },
        {
          "s": 2,
          "text": "שבמתן תורה הי' המשכת שעשועים העצמיים,"
        },
        {
          "s": 3,
          "text": "דזהו אנכי הוי' אלקיך,"
        },
        {
          "s": 4,
          "text": "אנכי מי שאנכי,"
        },
        {
          "s": 5,
          "text": "דלא אתרמיז לא בשום אות ולא בשום קוץ,"
        },
        {
          "s": 6,
          "text": "היינו,"
        },
        {
          "s": 7,
          "text": "שבמ\"ת הי' המשכת העצמות."
        },
        {
          "s": 8,
          "text": "אלא שבתחילה הוצרך להיות יציאת מצרים וספירת העומר,"
        },
        {
          "s": 9,
          "text": "ואחרי הכנה זו הי' הגילוי דמתן תורה,"
        },
        {
          "s": 10,
          "text": "תענוג הבלתי מורגש,"
        },
        {
          "s": 11,
          "text": "בחינת מנוחה בעצם."
        },
        {
          "s": 12,
          "text": "וכמו\"כ יהי' גם בגאולה העתידה,"
        },
        {
          "s": 13,
          "text": "דמשיח הוא איש שלום,"
        },
        {
          "s": 14,
          "text": "בחינת מנוחה בעצם."
        },
        {
          "s": 15,
          "text": "אך בהזמן דלעתיד גופא יהיו כמה מדריגות80,"
        },
        {
          "s": 16,
          "text": "כמאמר רז\"ל81"
        },
        {
          "s": 17,
          "text": "אריסטון"
        },
        {
          "s": 18,
          "text": "(סעודה)"
        },
        {
          "s": 19,
          "text": "עתיד הקב\"ה לעשות לעבדיו הצדיקים,"
        },
        {
          "s": 20,
          "text": "שהוא דוגמת מנוחה שלאחרי מלחמה,"
        },
        {
          "s": 21,
          "text": "תענוג המורגש,"
        },
        {
          "s": 22,
          "text": "ואח\"כ יהי' יום שכולו שבת ומנוחה,"
        },
        {
          "s": 23,
          "text": "תענוג הבלתי מורגש."
        },
        {
          "s": 24,
          "text": "ואז תושלם כוונת הבריאה ותכלית הכוונה דמתן תורה,"
        },
        {
          "s": 25,
          "text": "שיהי' ונגלה כבוד הוי' וראו כל בשר גו'82,"
        },
        {
          "s": 26,
          "text": "שיהי' הוי' אחד ושמו אחד83,"
        },
        {
          "s": 27,
          "text": "כמו שאני נכתב אני נקרא84."
        }
      ]
    }
  ]
}