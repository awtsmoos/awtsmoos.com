{
  "globalIndex": 556,
  "owner": 6,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916949_theRebbe_558__p003",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916949_theRebbe_558__p003",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916949_theRebbe_558",
  "title": "מאמר באתי לגני תש\"מ",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "והנה נוסף למה שישראל נקראים בשם צבאות הוי' נקראים הם גם צבאות25"
        },
        {
          "s": 1,
          "text": "(כמו שמביא בהמאמר הפסוקים26"
        },
        {
          "s": 2,
          "text": "ויהי בעצם היום הזה הוציא הוי' את בני ישראל מארץ מצרים על צבאותם,"
        },
        {
          "s": 3,
          "text": "כי בעצם היום הזה הוצאתי את צבאותיכם מארץ מצרים)."
        },
        {
          "s": 4,
          "text": "וההפרש בין צבאות הוי' לצבאות הוא27,"
        },
        {
          "s": 5,
          "text": "שצִבאות הוי'"
        },
        {
          "s": 6,
          "text": "(צבאות בחיריק)"
        },
        {
          "s": 7,
          "text": "הוא לשון סמוך,"
        },
        {
          "s": 8,
          "text": "שהצבאות נטפל להוי',"
        },
        {
          "s": 9,
          "text": "וצְבאות"
        },
        {
          "s": 10,
          "text": "(צבאות בשוא)"
        },
        {
          "s": 11,
          "text": "הוא ענין בפני עצמו."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה ידוע דמה שישראל נק' אדם הוא על שם אדמה לעליון28."
        },
        {
          "s": 2,
          "text": "שמזה מובן,"
        },
        {
          "s": 3,
          "text": "דמה שישראל נק'"
        },
        {
          "s": 4,
          "text": "(גם)"
        },
        {
          "s": 5,
          "text": "בשם צבאות שייך זה להשם צבאות,"
        },
        {
          "s": 6,
          "text": "שהוא מז' השמות שאינן נמחקין29."
        },
        {
          "s": 7,
          "text": "ויובן זה ע\"פ מ\"ש כ\"ק אדמו\"ר הזקן30"
        },
        {
          "s": 8,
          "text": "ששם צבאות נתגלה ע\"י הנביאים,"
        },
        {
          "s": 9,
          "text": "כדאיתא31"
        },
        {
          "s": 10,
          "text": "שמיום שברא הקב\"ה את עולמו לא הי' אדם שקראו להקב\"ה צבאות עד שבאתה חנה וקראתו צבאות ואמר הקב\"ה32"
        },
        {
          "s": 11,
          "text": "עתיד בן שלך לפתוח בנבואה בשם זה."
        },
        {
          "s": 12,
          "text": "ועיקר הנבואה בשם זה הי' בנביאים האחרונים שהיו בסוף זמן בית ראשון ובהתחלת הגלות,"
        },
        {
          "s": 13,
          "text": "שרוב נבואתם הי' בשם זה."
        },
        {
          "s": 14,
          "text": "והנה הגם שדברי הנביאים,"
        },
        {
          "s": 15,
          "text": "דברי קבלה,"
        },
        {
          "s": 16,
          "text": "הם למטה במדריגה מדברי תורה"
        },
        {
          "s": 17,
          "text": "[ואפילו בנוגע לנבואת משה כתיב33"
        },
        {
          "s": 18,
          "text": "ולא קם נביא עוד בישראל כמשה,"
        },
        {
          "s": 19,
          "text": "ועאכו\"כ שהם למטה מדברי תורה],"
        },
        {
          "s": 20,
          "text": "אעפ\"כ שם צבאות לא נזכר בתורה כ\"א בנביאים דוקא,"
        },
        {
          "s": 21,
          "text": "ויש מעלה בדברי נביא על דברי תורה."
        },
        {
          "s": 22,
          "text": "וכמו שמצינו שהעובר על דברי נביא עונשו קשה יותר מעובר על כו\"כ דברי תורה34,"
        },
        {
          "s": 23,
          "text": "ומזה מובן שכן הוא גם בנוגע להפגם35."
        },
        {
          "s": 24,
          "text": "ועפ\"ז מבאר כ\"ק אדמו\"ר האמצעי בארוכה36,"
        },
        {
          "s": 25,
          "text": "זה שהעונש והפגם של העובר על דברי נביא קשה יותר מעובר על"
        },
        {
          "s": 26,
          "text": "(כו\"כ מ)"
        },
        {
          "s": 27,
          "text": "דברי תורה שייך לזה ששם צבאות נמשך ע\"י הנביאים דוקא."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והענין הוא,"
        },
        {
          "s": 2,
          "text": "הנה פירוש שם צבאות הוא אות הוא בצבא שלו37,"
        },
        {
          "s": 3,
          "text": "והיינו דצבא הוא ריבוי נבראים,"
        },
        {
          "s": 4,
          "text": "והשם צבאות,"
        },
        {
          "s": 5,
          "text": "אות הוא בצבא שלו,"
        },
        {
          "s": 6,
          "text": "הוא בחי' האלקות כמו שנמשך בנבראים."
        },
        {
          "s": 7,
          "text": "וכמבואר בתו\"א38"
        },
        {
          "s": 8,
          "text": "בענין שם צבאות,"
        },
        {
          "s": 9,
          "text": "שצבאות הוא לשון חיילות והם גדודי נשמות ומלאכים דבריאה ש"
        },
        {
          "s": 10,
          "text": "(מצד עצמן)"
        },
        {
          "s": 11,
          "text": "אינן אלקות כלל."
        },
        {
          "s": 12,
          "text": "וזהו ההפרש בין שם צבאות לשאר השמות שאינן נמחקין,"
        },
        {
          "s": 13,
          "text": "דכל השמות מורים על אוא\"ס כמו שהוא באצילות שהוא עולם האחדות,"
        },
        {
          "s": 14,
          "text": "איהו וחיוהי חד איהו וגרמוהי חד39,"
        },
        {
          "s": 15,
          "text": "משא\"כ שם צבאות מורה על אוא\"ס כמו שנמשך ומתלבש בבי\"ע,"
        },
        {
          "s": 16,
          "text": "שהם עלמי דפרודא40"
        },
        {
          "s": 17,
          "text": "נבראים נפרדים כמ\"ש41"
        },
        {
          "s": 18,
          "text": "ומשם יפרד."
        },
        {
          "s": 19,
          "text": "שלכן יש מ\"ד בגמרא42"
        },
        {
          "s": 20,
          "text": "(ולא רק קס\"ד)"
        },
        {
          "s": 21,
          "text": "שצבאות אינו שם קדוש,"
        },
        {
          "s": 22,
          "text": "שלא נקרא צבאות אלא על שם ישראל."
        },
        {
          "s": 23,
          "text": "וגם לפי מה דקי\"ל43"
        },
        {
          "s": 24,
          "text": "דצבאות הוא מהשמות שאינן נמחקין,"
        },
        {
          "s": 25,
          "text": "הנה שם זה קאי על אוא\"ס כמו שנמשך ומתלבש בנבראים."
        },
        {
          "s": 26,
          "text": "וי\"ל הבי' ע\"פ מה דאיתא בזהר ובתקו\"ז ובכתבי האריז\"ל44"
        },
        {
          "s": 27,
          "text": "ששם צבאות הוא בנצח והוד45,"
        },
        {
          "s": 28,
          "text": "כי נצח והוד הם לבר מגופא,"
        },
        {
          "s": 29,
          "text": "היינו שענינם הוא"
        },
        {
          "s": 30,
          "text": "(לא בשביל האצילות גופא,"
        },
        {
          "s": 31,
          "text": "כי אם)"
        },
        {
          "s": 32,
          "text": "בכדי להמשיך בעולמות בי\"ע שלמטה מאצילות,"
        },
        {
          "s": 33,
          "text": "וע\"ד הידוע46"
        },
        {
          "s": 34,
          "text": "שנו\"ה הן כליות יועצות בכדי להשפיע להבן ולהתלמיד."
        }
      ]
    }
  ]
}