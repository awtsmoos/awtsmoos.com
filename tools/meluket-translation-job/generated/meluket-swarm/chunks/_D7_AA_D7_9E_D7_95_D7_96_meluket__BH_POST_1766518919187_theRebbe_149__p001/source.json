{
  "globalIndex": 907,
  "owner": 7,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919187_theRebbe_149__p001",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919187_theRebbe_149__p001",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919187_theRebbe_149",
  "title": "מאמר וידבר זאת חוקת תשכ\"ט",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ חוקת-בלק,"
        },
        {
          "s": 2,
          "text": "י\"ב תמוז,"
        },
        {
          "s": 3,
          "text": "ה'תשכ\"ט"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "וידבר ה' אל משה גו' זאת חוקת התורה גו' ויקחו אליך פרה אדומה גו'1,"
        },
        {
          "s": 1,
          "text": "ופירש רש\"י ויקחו אליך,"
        },
        {
          "s": 2,
          "text": "לעולם היא נקראת על שמך,"
        },
        {
          "s": 3,
          "text": "פרה שעשה משה במדבר."
        },
        {
          "s": 4,
          "text": "וצריך להבין,"
        },
        {
          "s": 5,
          "text": "הרי רק פרה הראשונה עשה משה,"
        },
        {
          "s": 6,
          "text": "ולמה נקראות כל הפרות"
        },
        {
          "s": 7,
          "text": "(שמונת הפרות שעשו אח\"כ,"
        },
        {
          "s": 8,
          "text": "וגם פרה העשירית שיעשה מלך המשיח2)"
        },
        {
          "s": 9,
          "text": "על שמו של משה."
        },
        {
          "s": 10,
          "text": "ולהוסיף,"
        },
        {
          "s": 11,
          "text": "דע\"פ הידוע3"
        },
        {
          "s": 12,
          "text": "ששמו של כל דבר אשר יקראו לו מורה על ענינו ותוכנו,"
        },
        {
          "s": 13,
          "text": "מובן,"
        },
        {
          "s": 14,
          "text": "דזה שכל הפרות נקראות על שמו של משה הוא לפי שזה"
        },
        {
          "s": 15,
          "text": "(השייכות למשה)"
        },
        {
          "s": 16,
          "text": "הוא ענינם ותוכנם."
        },
        {
          "s": 17,
          "text": "ועפ\"ז צריך להבין עוד יותר זה שהפרות נקראות על שם משה,"
        },
        {
          "s": 18,
          "text": "הרי עשיית הפרות הייתה ע\"י הכהנים4"
        },
        {
          "s": 19,
          "text": "[וגם פרה הראשונה נעשתה ע\"י אלעזר הכהן5,"
        },
        {
          "s": 20,
          "text": "ופירוש פרה שעשה משה הוא לכאורה רק שנעשתה ע\"פ הוראתו וציוויו6],"
        },
        {
          "s": 21,
          "text": "ומהי שייכותן למשה,"
        },
        {
          "s": 22,
          "text": "ועד שנקראות על שמו."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והענין הוא,"
        },
        {
          "s": 2,
          "text": "דאיתא בלקו\"ת7,"
        },
        {
          "s": 3,
          "text": "דהטעם על זה שבפרה אדומה נאמר זאת חוקת התורה,"
        },
        {
          "s": 4,
          "text": "הוא,"
        },
        {
          "s": 5,
          "text": "לפי שמצות פרה אדומה היא כללות התורה."
        },
        {
          "s": 6,
          "text": "ולכן,"
        },
        {
          "s": 7,
          "text": "כמו שהתורה נקראת על שמו של משה כמ\"ש8"
        },
        {
          "s": 8,
          "text": "זכרו תורת משה עבדי9,"
        },
        {
          "s": 9,
          "text": "כן גם פרה אדומה,"
        },
        {
          "s": 10,
          "text": "שהיא כללות התורה,"
        },
        {
          "s": 11,
          "text": "נקראת על שמו של משה10."
        },
        {
          "s": 12,
          "text": "ולכאורה יש להוסיף,"
        },
        {
          "s": 13,
          "text": "דמ\"ש בלקו\"ת שמצות פרה אדומה היא כללות התורה,"
        },
        {
          "s": 14,
          "text": "הכוונה היא בעיקר למצוות התורה"
        },
        {
          "s": 15,
          "text": "[כמובן מהביאור בלקו\"ת שם11,"
        },
        {
          "s": 16,
          "text": "דזה שמצות פרה אדומה הוא כללות התורה הוא כי יסוד כל המצוות הוא רצוא ושוב,"
        },
        {
          "s": 17,
          "text": "ופרה אדומה הו\"ע רצוא ושוב]."
        },
        {
          "s": 18,
          "text": "ועפ\"ז כללות מצוות התורה שייכות למשה."
        }
      ]
    }
  ]
}