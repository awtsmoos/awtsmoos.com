{
  "globalIndex": 1020,
  "owner": 20,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919814_theRebbe_260__p005",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919814_theRebbe_260__p005",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919814_theRebbe_260",
  "title": "מאמר לא היו ימים טובים לישראל תשל\"ה",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר הביאור בזה ע\"פ הידוע48"
        },
        {
          "s": 1,
          "text": "דעבודת הצדיקים"
        },
        {
          "s": 2,
          "text": "(כולל גם ההמשכה שע\"י העבודה)"
        },
        {
          "s": 3,
          "text": "היא בבחינת אור ישר,"
        },
        {
          "s": 4,
          "text": "מלמעלה למטה,"
        },
        {
          "s": 5,
          "text": "היינו שהגילוי שמאיר בעולם ע\"י עבודת הצדיקים הוא"
        },
        {
          "s": 6,
          "text": "(בעיקר)"
        },
        {
          "s": 7,
          "text": "מצד למעלה,"
        },
        {
          "s": 8,
          "text": "ובכדי שיהי' זיכוך ועלי' גם בהמטה עצמו,"
        },
        {
          "s": 9,
          "text": "זה נעשה"
        },
        {
          "s": 10,
          "text": "(בעיקר)"
        },
        {
          "s": 11,
          "text": "ע\"י עבודת התשובה."
        },
        {
          "s": 12,
          "text": "ועפ\"ז יובן זה שהמשכת הכתר"
        },
        {
          "s": 13,
          "text": "(מלך עילאה)"
        },
        {
          "s": 14,
          "text": "שהיתה לפני הירידה דגלות,"
        },
        {
          "s": 15,
          "text": "לגבי ההמשכה שלאחרי הירידה היא בכלל סדר ההשתלשלות,"
        },
        {
          "s": 16,
          "text": "כי אמיתית הענין דלמעלה מהשתלשלות הוא שאין בו ההגבלה והחילוק דמעלה ומטה,"
        },
        {
          "s": 17,
          "text": "וכיון שהעבודה שבזמן הבית היא"
        },
        {
          "s": 18,
          "text": "(בדרך כלל)"
        },
        {
          "s": 19,
          "text": "עבודת הצדיקים,"
        },
        {
          "s": 20,
          "text": "דההמשכה שע\"י עבודה זו היא"
        },
        {
          "s": 21,
          "text": "(בעיקר)"
        },
        {
          "s": 22,
          "text": "מצד למעלה,"
        },
        {
          "s": 23,
          "text": "היינו דגם לאחרי ההמשכה יש חילוק בין המעלה להמטה,"
        },
        {
          "s": 24,
          "text": "נמצא שהמשכה זו היא בכלל השתלשלות."
        },
        {
          "s": 25,
          "text": "[אלא שבהבחינות דהשתלשלות גופא,"
        },
        {
          "s": 26,
          "text": "ההמשכה שע\"י העבודה דתומ\"צ היא מאור הבל\"ג,"
        },
        {
          "s": 27,
          "text": "שהוא בכל מקום בשוה."
        },
        {
          "s": 28,
          "text": "ולכן,"
        },
        {
          "s": 29,
          "text": "האור שנמשך בביהמ\"ק ע\"י העבודה,"
        },
        {
          "s": 30,
          "text": "ישנו גם בזמן הגלות"
        },
        {
          "s": 31,
          "text": "(כנ\"ל סעיף ה)."
        },
        {
          "s": 32,
          "text": "אבל אעפ\"כ,"
        },
        {
          "s": 33,
          "text": "כיון49"
        },
        {
          "s": 34,
          "text": "דזה שהאור הוא בכל מקום הוא מפני שהאור הוא א\"ס,"
        },
        {
          "s": 35,
          "text": "לכן,"
        },
        {
          "s": 36,
          "text": "בכדי שבהעולם יהי' נרגש האור,"
        },
        {
          "s": 37,
          "text": "הוא דוקא כשהעולם הוא באופן שיש לו שייכות להאור50."
        },
        {
          "s": 38,
          "text": "וכיון שבזמן הגלות נעשה ירידה בהעולם,"
        },
        {
          "s": 39,
          "text": "לכן,"
        },
        {
          "s": 40,
          "text": "בזמן הגלות אינו מאיר הגילוי בהעולם]."
        },
        {
          "s": 41,
          "text": "וע\"י העבודה שבזמן הגלות,"
        },
        {
          "s": 42,
          "text": "שהיא"
        },
        {
          "s": 43,
          "text": "(בדרך כלל)"
        },
        {
          "s": 44,
          "text": "עבודת התשובה,"
        },
        {
          "s": 45,
          "text": "ההמשכה היא ממקום שאין בו חילוק דמעלה ומטה,"
        },
        {
          "s": 46,
          "text": "אמיתית הענין דלמעלה מסדר השתלשלות,"
        },
        {
          "s": 47,
          "text": "שע\"י המשכה זו,"
        },
        {
          "s": 48,
          "text": "נעשה זיכוך ועלי' גם בהמטה עצמו51."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ויש לבאר זה בעומק יותר ע\"פ המבואר במק\"א52"
        },
        {
          "s": 2,
          "text": "דהגילוי שנמשך בעולם ע\"י עבודת הצדיקים,"
        },
        {
          "s": 3,
          "text": "כיון שכוונת הבריאה לכתחילה היתה בכדי שהצדיקים"
        },
        {
          "s": 4,
          "text": "(ועמך כולם צדיקים53)"
        },
        {
          "s": 5,
          "text": "ע\"י עבודתם יוסיפו גילוי אלקות בעולם,"
        },
        {
          "s": 6,
          "text": "במי נמלך בנשמותיהן של צדיקים54,"
        },
        {
          "s": 7,
          "text": "לכן,"
        },
        {
          "s": 8,
          "text": "הגילוי שנמשך בעולם ע\"י עבודת הצדיקים,"
        },
        {
          "s": 9,
          "text": "גם הגילוי שלמעלה מהשתלשלות,"
        },
        {
          "s": 10,
          "text": "כולל גם זה שע\"י העבודה דתומ\"צ נמשך אור חדש שלא האיר אפילו קודם הצמצום,"
        },
        {
          "s": 11,
          "text": "אין זה חידוש אמיתי."
        },
        {
          "s": 12,
          "text": "משא\"כ ע\"י עבודת התשובה,"
        },
        {
          "s": 13,
          "text": "כשהאדם חטא ופגם והעביר את הדרך"
        },
        {
          "s": 14,
          "text": "(היפך הכוונה דבריאת האדם שהי' באופן דעשה האלקים את האדם ישר55)"
        },
        {
          "s": 15,
          "text": "ואח\"כ מתקן זה ע\"י התשובה,"
        },
        {
          "s": 16,
          "text": "עי\"ז נעשה חידוש גם לגבי כוונת הבריאה כמו שהיא בהדרגא דבמי נמלך."
        },
        {
          "s": 17,
          "text": "וזה שבכח האדם לפעול חידוש זה הוא לפי ששרש הנשמות הוא בהעצמות,"
        },
        {
          "s": 18,
          "text": "שהוא למעלה משרשם בהענין דבמי נמלך."
        },
        {
          "s": 19,
          "text": "דהגם שההמלכה היא למעלה מכל הגילויים,"
        },
        {
          "s": 20,
          "text": "גם מהגילוי דחפץ חסד56,"
        },
        {
          "s": 21,
          "text": "שהרי ההמלכה היא אם להיות חפץ חסד או לאו,"
        },
        {
          "s": 22,
          "text": "מ\"מ,"
        },
        {
          "s": 23,
          "text": "ההמלכה היא בנוגע לגילויים"
        },
        {
          "s": 24,
          "text": "(אם יהיו גילויים אם לאו),"
        },
        {
          "s": 25,
          "text": "ושרש הנשמות הוא בהעצמות."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "וזהו שהשלימות דעולם שתהי' לע\"ל,"
        },
        {
          "s": 1,
          "text": "אלה תולדות פרץ57"
        },
        {
          "s": 2,
          "text": "תולדות מלא58,"
        },
        {
          "s": 3,
          "text": "תהי' נעלית יותר מהשלימות שהיתה בתחילת הבריאה,"
        },
        {
          "s": 4,
          "text": "אלה תולדות השמים והארץ בהבראם59"
        },
        {
          "s": 5,
          "text": "תולדות מלא58,"
        },
        {
          "s": 6,
          "text": "עולם על מילואו נברא60,"
        },
        {
          "s": 7,
          "text": "שהשלימות דעולם כמו שהוא מצד הבריאה,"
        },
        {
          "s": 8,
          "text": "כולל גם השלימות שמצד כוונת הבריאה61"
        },
        {
          "s": 9,
          "text": "(הענין דבמי נמלך),"
        },
        {
          "s": 10,
          "text": "היא במדידה והגבלה,"
        },
        {
          "s": 11,
          "text": "והשלימות דעולם שתהי' לע\"ל ע\"י עבודת התשובה"
        },
        {
          "s": 12,
          "text": "[שהגילוי דלע\"ל יהי' בעיקר ע\"י עבודת התשובה]"
        },
        {
          "s": 13,
          "text": "תהי' למעלה ממדידה והגבלה,"
        },
        {
          "s": 14,
          "text": "אלה תולדות פרץ,"
        },
        {
          "s": 15,
          "text": "דענין פרץ"
        },
        {
          "s": 16,
          "text": "[שנקרא כן על שם פרצת עליך פרץ62]"
        },
        {
          "s": 17,
          "text": "הוא שפורץ כל המדידות והגבלות,"
        },
        {
          "s": 18,
          "text": "כולל גם המדידה וההגבלה שמצד כוונת הבריאה כמו שהיא בבחינת ההמלכה,"
        },
        {
          "s": 19,
          "text": "היינו שמים חדשים וארץ חדשה63."
        }
      ]
    }
  ]
}