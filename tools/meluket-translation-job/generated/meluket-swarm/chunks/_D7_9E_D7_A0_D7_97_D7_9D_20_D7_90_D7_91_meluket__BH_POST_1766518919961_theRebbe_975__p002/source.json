{
  "globalIndex": 1048,
  "owner": 48,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919961_theRebbe_975__p002",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919961_theRebbe_975__p002",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919961_theRebbe_975",
  "title": "מאמר ועתה ישראל תשל\"ז",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים מה דאיתא במדרש תהלים עה\"פ13"
        },
        {
          "s": 2,
          "text": "אחת שאלתי מאת ה' וגו',"
        },
        {
          "s": 3,
          "text": "אמר הקב\"ה לדוד,"
        },
        {
          "s": 4,
          "text": "בתחלה אתה אומר אחת שאלתי"
        },
        {
          "s": 5,
          "text": "(גו')"
        },
        {
          "s": 6,
          "text": "שבתי בבית ה' ואח\"כ אתה שואל כמה שאלות לחזות בנועם ה' ולבקר בהיכלו וכו',"
        },
        {
          "s": 7,
          "text": "והשיב דוד ממך למדתי,"
        },
        {
          "s": 8,
          "text": "בתחלה לא באת עלי14"
        },
        {
          "s": 9,
          "text": "אלא באחת שנאמר ועתה ישראל מה ה' אלקיך שואל מעמך כי אם ליראה ואח\"כ פתחת עלינו במצוות הרבה שנאמר ללכת בכל דרכיו ולדבקה בו וגו'."
        },
        {
          "s": 10,
          "text": "וצריך להבין,"
        },
        {
          "s": 11,
          "text": "דלכאורה תשובת דוד ממך למדתי אינה מתרצת זה שאמר אחת שאלתי,"
        },
        {
          "s": 12,
          "text": "אלא שאומרת שהשאלה היא על הקב\"ה,"
        },
        {
          "s": 13,
          "text": "שבתחלה אומר כי אם ליראה ואח\"כ פתח במצוות הרבה."
        },
        {
          "s": 14,
          "text": "ופירש הרב המגיד15,"
        },
        {
          "s": 15,
          "text": "שדוד ביקש רק דבר אחד לבד,"
        },
        {
          "s": 16,
          "text": "כי הדברים המפורטים"
        },
        {
          "s": 17,
          "text": "(לחזות בנועם ה' וגו')"
        },
        {
          "s": 18,
          "text": "הם מסתעפים משבתי בבית ה'."
        },
        {
          "s": 19,
          "text": "ועד\"ז הוא במה ה' אלקיך שואל מעמך כי אם ליראה,"
        },
        {
          "s": 20,
          "text": "שהדברים המפורטים"
        },
        {
          "s": 21,
          "text": "(ללכת בכל דרכיו וגו')"
        },
        {
          "s": 22,
          "text": "הם מסתעפים מליראה את ה' אלקיך."
        },
        {
          "s": 23,
          "text": "אבל,"
        },
        {
          "s": 24,
          "text": "עפ\"ז צריך להבין לאידך גיסא,"
        },
        {
          "s": 25,
          "text": "הרי דבר זה"
        },
        {
          "s": 26,
          "text": "(שישנם ענינים כלליים שמסתעפים מהם הרבה פרטים)"
        },
        {
          "s": 27,
          "text": "הוא מובן בפשטות,"
        },
        {
          "s": 28,
          "text": "ולמה צריך ללמוד זה מהקב\"ה."
        },
        {
          "s": 29,
          "text": "ונקודת הביאור בזה,"
        },
        {
          "s": 30,
          "text": "דהכוונה כאן בדבר אחד לבד היא לנקודה עצמית שלמעלה מכלל לפרטים."
        },
        {
          "s": 31,
          "text": "דזהו מ\"ש דוד אחת שאלתי,"
        },
        {
          "s": 32,
          "text": "אחת היא יחידה16,"
        },
        {
          "s": 33,
          "text": "יחיד בעצם,"
        },
        {
          "s": 34,
          "text": "שאינו בגדר התחלקות פרטים"
        },
        {
          "s": 35,
          "text": "(כידוע החילוק בין יחיד לאחד17)."
        },
        {
          "s": 36,
          "text": "ועד\"ז הוא ליראה את הוי',"
        },
        {
          "s": 37,
          "text": "דפירוש ליראה את הוי'"
        },
        {
          "s": 38,
          "text": "(דלשון את מורה על דבר שאינו אלא טפל18)"
        },
        {
          "s": 39,
          "text": "הוא שאינו מציאות לעצמו כלל,"
        },
        {
          "s": 40,
          "text": "וכל ענינו הוא רק זה שהוא טפל ובטל להוי'19."
        },
        {
          "s": 41,
          "text": "וגם להמבואר בתניא20"
        },
        {
          "s": 42,
          "text": "דמה ה' אלקיך שואל מעמך כ\"א ליראה את ה' אלקיך קאי על יראה תתאה,"
        },
        {
          "s": 43,
          "text": "הרי ידוע21,"
        },
        {
          "s": 44,
          "text": "דכל הדרגות שביראה שייכות זל\"ז."
        },
        {
          "s": 45,
          "text": "וגם הביטול דיר\"ת הוא מצד עצם הנשמה."
        },
        {
          "s": 46,
          "text": "וכידוע החילוק בין יראה לאהבה22,"
        },
        {
          "s": 47,
          "text": "דאהבה להיותה מציאות היא מצד הגילויים דהנשמה,"
        },
        {
          "s": 48,
          "text": "ויראה להיותה ביטול היא מצד עצם הנשמה."
        },
        {
          "s": 49,
          "text": "וזהו ממך למדתי,"
        },
        {
          "s": 50,
          "text": "כי בכדי לקשר הפרטים עם הנקודה העצמית שלמעלה מכלל לפרטים,"
        },
        {
          "s": 51,
          "text": "צריך על זה לימוד ונתינת כח מהקב\"ה."
        },
        {
          "s": 52,
          "text": "והקשר דנקודה העצמית עם הפרטים הוא בשני אופנים."
        },
        {
          "s": 53,
          "text": "א',"
        },
        {
          "s": 54,
          "text": "באופן דמלמטה למעלה,"
        },
        {
          "s": 55,
          "text": "שע\"י הפרטים מגיעים להנקודה."
        },
        {
          "s": 56,
          "text": "וכמ\"ש23"
        },
        {
          "s": 57,
          "text": "ויצונו ה' לעשות את כל החוקים האלה ליראה את הוי',"
        },
        {
          "s": 58,
          "text": "שע\"י קיום המצוות"
        },
        {
          "s": 59,
          "text": "(תרי\"ג מצוות פרטיות)"
        },
        {
          "s": 60,
          "text": "באים ליראה את הוי'."
        },
        {
          "s": 61,
          "text": "וב',"
        },
        {
          "s": 62,
          "text": "באופן דמלמעלה למטה,"
        },
        {
          "s": 63,
          "text": "שמהנקודה נמשכים ומסתעפים פרטים,"
        },
        {
          "s": 64,
          "text": "ובאופן שגם לאחרי שנמשכו הפרטים,"
        },
        {
          "s": 65,
          "text": "מאירה בהם הנקודה העצמית שלמעלה ממקור לפרטים."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יש לבאר מה שאמרו אל תקרי מה אלא מאה,"
        },
        {
          "s": 2,
          "text": "מה הוא ביטול כמו ונחנו מה24"
        },
        {
          "s": 3,
          "text": "[ויש לומר,"
        },
        {
          "s": 4,
          "text": "דזהו שלשון מה מורה על קטנות הדבר"
        },
        {
          "s": 5,
          "text": "(כנ\"ל סעיף ב),"
        },
        {
          "s": 6,
          "text": "שהוא ע\"ד מ\"ש אתם המעט מכל העמים שממעטים את עצמם25],"
        },
        {
          "s": 7,
          "text": "והוא הביטול עצמי שמצד עצם הנשמה."
        },
        {
          "s": 8,
          "text": "ופירוש מה ה' אלקיך שואל מעמך הוא שה' אלקיך שואל מעמך הביטול דמה26."
        },
        {
          "s": 9,
          "text": "ומביטול זה מסתעפים אח\"כ כל הפרטים שנמנים בהמשך הכתוב,"
        },
        {
          "s": 10,
          "text": "כולל גם ליראה את הוי'27."
        },
        {
          "s": 11,
          "text": "דעם היות שגם הביטול דיראה הוא מצד עצם הנשמה,"
        },
        {
          "s": 12,
          "text": "וביטול זה הוא הנקודה העצמית שממנה מסתעפים הפרטים שלאח\"ז"
        },
        {
          "s": 13,
          "text": "(ללכת בכל דרכיו וגו'),"
        },
        {
          "s": 14,
          "text": "מ\"מ,"
        },
        {
          "s": 15,
          "text": "מכיון שהביטול הוא בציור דיראה,"
        },
        {
          "s": 16,
          "text": "שענינה הוא"
        },
        {
          "s": 17,
          "text": "(ככל המדות)"
        },
        {
          "s": 18,
          "text": "ההרגש שהוא ירא,"
        },
        {
          "s": 19,
          "text": "הוא בכלל הגילויים דהנשמה,"
        },
        {
          "s": 20,
          "text": "משא\"כ הביטול דמ\"ה הוא ביטול בעצם."
        },
        {
          "s": 21,
          "text": "כהביטול דמס\"נ28"
        },
        {
          "s": 22,
          "text": "שבכאו\"א מישראל29,"
        },
        {
          "s": 23,
          "text": "מצד המ\"ה שבו,"
        },
        {
          "s": 24,
          "text": "שהוא למעלה מכל הכחות כולל גם כח הרצון,"
        },
        {
          "s": 25,
          "text": "שהרי זה שהוא מוסר נפשו הוא לא מצד הרצון שלו אלא מפני שאינו יכול להפרד ח\"ו מאחדותו ית'30."
        },
        {
          "s": 26,
          "text": "וזהו מה הוי' אלקיך,"
        },
        {
          "s": 27,
          "text": "שהביטול דמ\"ה הוא מפני שהוי'"
        },
        {
          "s": 28,
          "text": "(הוא)"
        },
        {
          "s": 29,
          "text": "אלקיך כחך וחיותך."
        },
        {
          "s": 30,
          "text": "דמכיון שאלקות הוא החיות שלו,"
        },
        {
          "s": 31,
          "text": "אין שייך כלל שיהי' נפרד ח\"ו מאלקות."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "אבל,"
        },
        {
          "s": 2,
          "text": "הביטול דמ\"ה שישנו בכאו\"א מישראל הוא בהעלם."
        },
        {
          "s": 3,
          "text": "והעלם זה הוא לא רק מפני נפש הבהמית שמעלמת ומסתרת על זה,"
        },
        {
          "s": 4,
          "text": "אלא שגם מצד עצמו הוא נעלם,"
        },
        {
          "s": 5,
          "text": "להיותו למעלה מגילוי31."
        },
        {
          "s": 6,
          "text": "ובכדי שיהי' בגילוי,"
        },
        {
          "s": 7,
          "text": "על זה אמרו אל תקרי מה אלא מאה."
        },
        {
          "s": 8,
          "text": "דמה ומאה הם ב' קצוות."
        },
        {
          "s": 9,
          "text": "מה הוא נקודה עצמית שלמעלה מגדר פרטים,"
        },
        {
          "s": 10,
          "text": "ומאה הוא ריבוי פרטים עד לריבוי הכי גדול32."
        },
        {
          "s": 11,
          "text": "ובנפש האדם הוא עשר הכחות כמו שכל אחד מהם כלול מעשר."
        },
        {
          "s": 12,
          "text": "וע\"י העבודה בפרטי הכחות"
        },
        {
          "s": 13,
          "text": "(מאה),"
        },
        {
          "s": 14,
          "text": "מתעורר ומתגלה הנקודה דמ\"ה33."
        },
        {
          "s": 15,
          "text": "וזהו אל תקרי מה אלא מאה,"
        },
        {
          "s": 16,
          "text": "דמה מצד עצמו הוא למעלה מגילוי – אל תקרי"
        },
        {
          "s": 17,
          "text": "(קרי הוא גילוי34),"
        },
        {
          "s": 18,
          "text": "והתגלותו היא ע\"י העבודה דמאה."
        },
        {
          "s": 19,
          "text": "ויתירה מזו,"
        },
        {
          "s": 20,
          "text": "שהגילוי דמ\"ה"
        },
        {
          "s": 21,
          "text": "(שנעשה ע\"י העבודה דמאה)"
        },
        {
          "s": 22,
          "text": "הוא באופן כללי וגם נרגש בכחות הפרטיים35."
        },
        {
          "s": 23,
          "text": "ויש לומר שגם זה מרומז באל תקרי מה אלא מאה,"
        },
        {
          "s": 24,
          "text": "כי כאשר הגילוי דמ\"ה הוא רק בכללות,"
        },
        {
          "s": 25,
          "text": "אזי,"
        },
        {
          "s": 26,
          "text": "הגילוי הוא רק בנוגע למ\"ה"
        },
        {
          "s": 27,
          "text": "(שבתחלה הי' בהעלם ואח\"כ נתגלה מהעלמו),"
        },
        {
          "s": 28,
          "text": "וזהו אל תקרי מה אלא מאה,"
        },
        {
          "s": 29,
          "text": "שהקריאה והגילוי דמ\"ה צריך להיות לא רק בנוגע להמ\"ה אלא גם בכחות הפרטיים,"
        },
        {
          "s": 30,
          "text": "מאה."
        }
      ]
    }
  ]
}