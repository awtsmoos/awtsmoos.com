{
  "globalIndex": 409,
  "owner": 9,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518916086_theRebbe_759__p002",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518916086_theRebbe_759__p002",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518916086_theRebbe_759",
  "title": "מאמר אמר ר' אלכסנדרי תשל\"א",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה ד' הפעולות הנעשות ע\"י עסק התורה לשמה שמונה בגמרא שם"
        },
        {
          "s": 2,
          "text": "(ובפרט שמדגיש בהמאמר בתחלתו: וחשיב כאן ד' ענינים),"
        },
        {
          "s": 3,
          "text": "י\"ל שד' ענינים אלו הם כנגד ד' העולמות אבי\"ע,"
        },
        {
          "s": 4,
          "text": "וכנגד ד' הפלוגות בספירות"
        },
        {
          "s": 5,
          "text": "(וכידוע11"
        },
        {
          "s": 6,
          "text": "שהע\"ס נחלקות בכלל לד' – כנגד ד' אותיות הוי' וכנגד ד' העולמות),"
        },
        {
          "s": 7,
          "text": "וענין העוסק בתורה לשמה שפועל ד' ענינים אלו הוא בחינה שלמעלה מד' העולמות,"
        },
        {
          "s": 8,
          "text": "שלכן פועל בהם."
        },
        {
          "s": 9,
          "text": "והענין הוא,"
        },
        {
          "s": 10,
          "text": "דהנה ידוע שבריאה הוא בחי' חב\"ד,"
        },
        {
          "s": 11,
          "text": "יצירה בחי' חג\"ת,"
        },
        {
          "s": 12,
          "text": "ועשי' הו\"ע הלבושים מחדומ\"ע,"
        },
        {
          "s": 13,
          "text": "ולמעלה יותר,"
        },
        {
          "s": 14,
          "text": "בחי' נה\"י."
        },
        {
          "s": 15,
          "text": "אמנם אצילות הוא עולם האחדות,"
        },
        {
          "s": 16,
          "text": "והיינו שגם מצד הכלים הוא עולם האחדות,"
        },
        {
          "s": 17,
          "text": "וכידוע שבאצילות הנה איהו וחיוהי חד וגם איהו וגרמוהי חד12."
        },
        {
          "s": 18,
          "text": "וזהו מה שד' ענינים הנ\"ל הם כנגד ד' העולמות אבי\"ע – משים שלום בפמליא כו' שהו\"ע המדות כנ\"ל,"
        },
        {
          "s": 19,
          "text": "בחי' חג\"ת,"
        },
        {
          "s": 20,
          "text": "יצירה."
        },
        {
          "s": 21,
          "text": "בנה פלטרין כו' שהו\"ע המוחין כנ\"ל,"
        },
        {
          "s": 22,
          "text": "בריאה."
        },
        {
          "s": 23,
          "text": "מגין על כל העולם כו',"
        },
        {
          "s": 24,
          "text": "הנהגה בפועל בעולם הבאה מצד המוחין והמדות,"
        },
        {
          "s": 25,
          "text": "בחי' נה\"י ומחדומ\"ע,"
        },
        {
          "s": 26,
          "text": "עשי'."
        },
        {
          "s": 27,
          "text": "מקרב את הגאולה שהו\"ע השלימות שלמעלה מענין הבריאה כנ\"ל,"
        },
        {
          "s": 28,
          "text": "בחי' אצילות עולם האחדות."
        },
        {
          "s": 29,
          "text": "וזהו שבהביאור בהמאמר במקרב את הגאולה כ' שנשתנה בעצם מהותו לטוב,"
        },
        {
          "s": 30,
          "text": "כי באצילות לא יגורך רע13."
        },
        {
          "s": 31,
          "text": "אמנם ענין העוסק בתורה לשמה שפועל ד' ענינים אלו הוא למעלה גם מעולם האצילות,"
        },
        {
          "s": 32,
          "text": "כנ\"ל."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ויש לקשר זה עם המבואר בהמאמר ד\"ה להבין מ\"ש בע\"ח לאדה\"ז14"
        },
        {
          "s": 2,
          "text": "(שנאמר בי\"ט כסלו15),"
        },
        {
          "s": 3,
          "text": "שמבאר שם בענין בחי' עקודים בכלי אחד,"
        },
        {
          "s": 4,
          "text": "שהוא בחי' כתר וכו',"
        },
        {
          "s": 5,
          "text": "מקיף הכללי שלמעלה מהתחלקות,"
        },
        {
          "s": 6,
          "text": "שלכן כולל כל הספירות בשוה."
        },
        {
          "s": 7,
          "text": "דבכללות הוא בחי' עצמות אוא\"ס שמאיר בכל העולמות בשוה."
        },
        {
          "s": 8,
          "text": "וכמו שמבאר בהמאמר שם,"
        },
        {
          "s": 9,
          "text": "דזהו מה שגם תינוקות ונשים אומרים על עצמות אוא\"ס אתה לנוכח,"
        },
        {
          "s": 10,
          "text": "כי מצד עצמות אוא\"ס כולם הם בשוה,"
        },
        {
          "s": 11,
          "text": "וההפרש הוא רק בבחי' ההתגלות,"
        },
        {
          "s": 12,
          "text": "אבל מצד בחי' ההעלם הכל שוין כו'."
        },
        {
          "s": 13,
          "text": "וזהו\"ע העוסק בתורה לשמה,"
        },
        {
          "s": 14,
          "text": "שע\"י עסק התורה לשמה ממשיך בחי' מקיף הנ\"ל שלמעלה מעולמות,"
        },
        {
          "s": 15,
          "text": "ולכן הוא פועל בכל ד' העולמות."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ויש16 להוסיף ביאור במאמר הנ\"ל,"
        },
        {
          "s": 2,
          "text": "ובהקדמה,"
        },
        {
          "s": 3,
          "text": "שמאמר זה הוא מאמר יסודי שמבאר כל סדר ההשתלשלות,"
        },
        {
          "s": 4,
          "text": "אלא שמבאר הענין בקיצור נמרץ,"
        },
        {
          "s": 5,
          "text": "וכמרז\"ל17"
        },
        {
          "s": 6,
          "text": "לעולם ישנה אדם לתלמידו בדרך קצרה."
        },
        {
          "s": 7,
          "text": "וזהו גם סדר הענינים שבהמאמר,"
        },
        {
          "s": 8,
          "text": "שבתחילת המאמר מבאר כללות הענין דאורות וכלים,"
        },
        {
          "s": 9,
          "text": "ואח\"כ מבאר בפרטיות,"
        },
        {
          "s": 10,
          "text": "בתחילה כמו שהוא מלמטה למעלה,"
        },
        {
          "s": 11,
          "text": "ואח\"כ כמו שהוא מלמעלה למטה."
        },
        {
          "s": 12,
          "text": "דהנה,"
        },
        {
          "s": 13,
          "text": "בתחלת המאמר מבאר כללות הענין דאורות וכלים"
        },
        {
          "s": 14,
          "text": "[ולהעיר,"
        },
        {
          "s": 15,
          "text": "שבהכת\"י18"
        },
        {
          "s": 16,
          "text": "הי' כתוב תחלה: \"ענין או\"כ למעלה\","
        },
        {
          "s": 17,
          "text": "ואח\"כ העביר קולמוס על תיבת למעלה],"
        },
        {
          "s": 18,
          "text": "שהאורות מצד עצמם הם בחי' העלם,"
        },
        {
          "s": 19,
          "text": "וענין הגילוי הוא מצד הכלים דוקא."
        },
        {
          "s": 20,
          "text": "ומבאר זה ע\"פ משל מנפש האדם,"
        },
        {
          "s": 21,
          "text": "מבשרי אחזה גו'19,"
        },
        {
          "s": 22,
          "text": "שכחות הנפש מצד עצמם הם בהעלם,"
        },
        {
          "s": 23,
          "text": "ורק ע\"י התלבשותם באברי הגוף,"
        },
        {
          "s": 24,
          "text": "אזי הם באים בגילוי."
        },
        {
          "s": 25,
          "text": "ולכן כשנפש האדם מתגלגלת בגופי דצ\"ח הרי היא בהעלם,"
        },
        {
          "s": 26,
          "text": "לפי שאינם כלים אלי',"
        },
        {
          "s": 27,
          "text": "וכן באדם גופא כשהשכל מתלבש באבר אחר זולת המוח,"
        },
        {
          "s": 28,
          "text": "הוא בהעלם."
        },
        {
          "s": 29,
          "text": "ועד\"ז הוא למעלה,"
        },
        {
          "s": 30,
          "text": "שגילוי הע\"ס הוא מצד הכלים דוקא,"
        },
        {
          "s": 31,
          "text": "אבל האורות מצד עצמם הם בבחי' פשיטות והעלם."
        },
        {
          "s": 32,
          "text": "ולאחרי שמבאר כללות הענין דאורות וכלים,"
        },
        {
          "s": 33,
          "text": "ממשיך לבאר את הענין כמו שהוא מלמטה למעלה,"
        },
        {
          "s": 34,
          "text": "וכמו שהוא מלמעלה למטה."
        },
        {
          "s": 35,
          "text": "בתחילה מבאר הענין מלמטה למעלה,"
        },
        {
          "s": 36,
          "text": "היינו20"
        },
        {
          "s": 37,
          "text": "שהשכל שבנפש האדם מתהווה מבחי' הכלים דעשי',"
        },
        {
          "s": 38,
          "text": "וכן האורות דעשי' נמשכים מבחי' הכלים דיצירה,"
        },
        {
          "s": 39,
          "text": "וכן הוא בכל סדר ההשתלשלות,"
        },
        {
          "s": 40,
          "text": "שבחי' האורות שבכל עולם נמשכים מבחי' הכלים דהעולם שלמעלה ממנו."
        },
        {
          "s": 41,
          "text": "ואח\"כ מבאר הענין מלמעלה למטה,"
        },
        {
          "s": 42,
          "text": "היינו21"
        },
        {
          "s": 43,
          "text": "של' כלים דאצילות נעשים נר\"ן לבי\"ע."
        },
        {
          "s": 44,
          "text": "מבחי' יו\"ד כלים פנימיים,"
        },
        {
          "s": 45,
          "text": "בחי' חב\"ד,"
        },
        {
          "s": 46,
          "text": "נעשה בחי' נשמה לבריאה,"
        },
        {
          "s": 47,
          "text": "מבחי' יו\"ד כלים תיכונים,"
        },
        {
          "s": 48,
          "text": "בחי' חג\"ת,"
        },
        {
          "s": 49,
          "text": "נעשה בחי' רוח ליצירה,"
        },
        {
          "s": 50,
          "text": "ומבחי' יו\"ד כלים חיצוניים,"
        },
        {
          "s": 51,
          "text": "בחי' נה\"י,"
        },
        {
          "s": 52,
          "text": "נעשה בחי' נפש בעשי'."
        },
        {
          "s": 53,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 54,
          "text": "שבכל עולם"
        },
        {
          "s": 55,
          "text": "(מג' עולמות בי\"ע)"
        },
        {
          "s": 56,
          "text": "ישנם ג' הבחינות חב\"ד חג\"ת ונה\"י,"
        },
        {
          "s": 57,
          "text": "ורק שעולם הבריאה עיקרו חב\"ד,"
        },
        {
          "s": 58,
          "text": "עולם היצירה עיקרו חג\"ת,"
        },
        {
          "s": 59,
          "text": "ועולם העשי' עיקרו נה\"י."
        }
      ]
    }
  ]
}