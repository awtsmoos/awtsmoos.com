  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920390_theRebbe_690__p005",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920390_theRebbe_690",
  "title": "מאמר את הוי' האמרת תש\"ל",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "ויש לקשר"
        },
        {
          "s": 3,
          "text": "(גם)"
        },
        {
          "s": 4,
          "text": "ענין זה עם ח\"י אלול,"
        },
        {
          "s": 5,
          "text": "כי נוסף על זה ש"
        },
        {
          "s": 6,
          "text": "(גם)"
        },
        {
          "s": 7,
          "text": "ענין זה"
        },
        {
          "s": 8,
          "text": "(גודל העילוי דישראל ואהבת ישראל)"
        },
        {
          "s": 9,
          "text": "הוא מהענינים העיקריים דתורת החסידות93,"
        },
        {
          "s": 10,
          "text": "הנה ח\"י אלול הוא יום התחלת העבודה דשנה הבאה94,"
        },
        {
          "s": 11,
          "text": "מתחיל מר\"ה שאז מכתירים ישראל את הקב\"ה למלך95,"
        },
        {
          "s": 12,
          "text": "דהכח שיש בישראל להכתיר אותו למלך הוא מפני שהם קשורים ומיוחדים עם עצמותו ית'"
        },
        {
          "s": 13,
          "text": "(שלמעלה מבחי' מלך)96,"
        },
        {
          "s": 14,
          "text": "והקב\"ה מקבל את ההכתרה ונעשה מלך ישראל97,"
        },
        {
          "s": 15,
          "text": "ועי\"ז ועל ידם –"
        },
        {
          "s": 16,
          "text": "(גם)"
        },
        {
          "s": 17,
          "text": "מלך על כל הארץ98,"
        },
        {
          "s": 18,
          "text": "הוי' אלקי ישראל מלך ומלכותו בכל משלה99,"
        },
        {
          "s": 19,
          "text": "ונמשך בגילוי שיהי' מלך ישראל וגואלו 97,"
        },
        {
          "s": 20,
          "text": "ע\"י משיח צדקנו,"
        },
        {
          "s": 21,
          "text": "שילחם מלחמות הוי' וינצח ויבנה מקדש במקומו ויקבץ נדחי ישראל100,"
        },
        {
          "s": 22,
          "text": "ומלאה הארץ דעה את הוי' גו'101"
        },
        {
          "s": 23,
          "text": "כל העולם102,"
        },
        {
          "s": 24,
          "text": "בגאולה האמיתית והשלימה,"
        },
        {
          "s": 25,
          "text": "בקרוב ממש."
        }
      ]
    }
  ]
}