{
  "globalIndex": 718,
  "owner": 18,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917980_theRebbe_758__p002",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917980_theRebbe_758__p002",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917980_theRebbe_758",
  "title": "מאמר ונחה עליו רוח ה' תשכ\"ה",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר16,"
        },
        {
          "s": 2,
          "text": "דכל זה"
        },
        {
          "s": 3,
          "text": "(היינו הן ההשפעה דרב והן ההשפעה דמלך17)"
        },
        {
          "s": 4,
          "text": "בא דוקא על ידי הקדמת העבודה דזמן הגלות."
        },
        {
          "s": 5,
          "text": "ולהבין השייכות של העבודה דזמן הגלות להגילוי דלע\"ל,"
        },
        {
          "s": 6,
          "text": "מקדים בהמאמר18,"
        },
        {
          "s": 7,
          "text": "שמצד גודל וריבוי ההעלמות וההסתרים שבזמן הגלות,"
        },
        {
          "s": 8,
          "text": "עיקר העבודה בזמן הגלות הוא בדרך נצחון,"
        },
        {
          "s": 9,
          "text": "להיות חזק בקיום התומ\"צ בפועל ממש,"
        },
        {
          "s": 10,
          "text": "מבלי להתחשב עם שום מונע ומעכב."
        },
        {
          "s": 11,
          "text": "דבכללות הו\"ע העבודה דמס\"נ שלמעלה מטו\"ד,"
        },
        {
          "s": 12,
          "text": "דענין המס\"נ הוא שאינו נכנס בשום שקו\"ט,"
        },
        {
          "s": 13,
          "text": "כי אם,"
        },
        {
          "s": 14,
          "text": "שאי אפשר כלל19"
        },
        {
          "s": 15,
          "text": "להיות באופן אחר."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "והענין הוא,"
        },
        {
          "s": 1,
          "text": "דבזמן הבית היו כל ישראל במדריגה עליונה20,"
        },
        {
          "s": 2,
          "text": "דנוסף על זה שהיו בעלי השגה גדולה21,"
        },
        {
          "s": 3,
          "text": "הנה בעלייתם לרגל היתה אצלם גם ראי' באלקות"
        },
        {
          "s": 4,
          "text": "(שלמעלה מהשגה)"
        },
        {
          "s": 5,
          "text": "כמ\"ש22"
        },
        {
          "s": 6,
          "text": "שלש פעמים בשנה יראה גו' וכשם שבא ליראות כך בא לראות23,"
        },
        {
          "s": 7,
          "text": "משא\"כ בזמן הגלות כתיב24"
        },
        {
          "s": 8,
          "text": "אני ישנה וארז\"ל25"
        },
        {
          "s": 9,
          "text": "בגלותא,"
        },
        {
          "s": 10,
          "text": "דכמו שבשינה כפשוטה מתעלמים כל כחות הפנימיים,"
        },
        {
          "s": 11,
          "text": "מתחיל מכח השכל,"
        },
        {
          "s": 12,
          "text": "שבעת השינה מסתלק כח השכל ולא נשאר אלא כח המדמה26,"
        },
        {
          "s": 13,
          "text": "ועיקר ההתעלמות"
        },
        {
          "s": 14,
          "text": "(שמצד השינה)"
        },
        {
          "s": 15,
          "text": "הוא בכח הראי'"
        },
        {
          "s": 16,
          "text": "(ועד שזה ניכר גם באברי הגוף,"
        },
        {
          "s": 17,
          "text": "שבעת השינה נסגרים העינים)27,"
        },
        {
          "s": 18,
          "text": "כמו\"כ הוא גם בהשינה דגלות,"
        },
        {
          "s": 19,
          "text": "דעיקר ההעלם דגלות הוא מה שבזמן הגלות לא ישנה הראי' באלקות,"
        },
        {
          "s": 20,
          "text": "אותותינו לא ראינו28,"
        },
        {
          "s": 21,
          "text": "וגם ההשגה באלקות"
        },
        {
          "s": 22,
          "text": "(שישנה גם בזמן הגלות)"
        },
        {
          "s": 23,
          "text": "אינה בערך כלל לההשגה שבזמן הבית,"
        },
        {
          "s": 24,
          "text": "ועד שההשגה שבזמן הגלות"
        },
        {
          "s": 25,
          "text": "(לגבי ההשגה שבזמן הבית)"
        },
        {
          "s": 26,
          "text": "היא בדוגמת כח המדמה שבשינה29."
        },
        {
          "s": 27,
          "text": "ומצד זה,"
        },
        {
          "s": 28,
          "text": "גם האהוי\"ר"
        },
        {
          "s": 29,
          "text": "(שבזמן הגלות)"
        },
        {
          "s": 30,
          "text": "אינה כדבעי."
        },
        {
          "s": 31,
          "text": "דנוסף לזה שבזמן הגלות א\"א להיות הביטול דהשתחוואה"
        },
        {
          "s": 32,
          "text": "(ביטול פנימי)"
        },
        {
          "s": 33,
          "text": "שבא דוקא מצד הראי' באלקות,"
        },
        {
          "s": 34,
          "text": "וכמ\"ש30"
        },
        {
          "s": 35,
          "text": "ואין אנו יכולים לעלות וליראות ולהשתחוות לפניך,"
        },
        {
          "s": 36,
          "text": "דמכיון שאין אנו יכולים לעלות וליראות במילא אין אנו יכולים"
        },
        {
          "s": 37,
          "text": "(גם)"
        },
        {
          "s": 38,
          "text": "להשתחוות להיות בבחי' ביטול פנימי31,"
        },
        {
          "s": 39,
          "text": "הנה גם הביטול חיצוני"
        },
        {
          "s": 40,
          "text": "(ביטול דכריעה)32,"
        },
        {
          "s": 41,
          "text": "שבא מצד השגת אלקות"
        },
        {
          "s": 42,
          "text": "(שישנו,"
        },
        {
          "s": 43,
          "text": "בכללות,"
        },
        {
          "s": 44,
          "text": "גם בזמן הגלות),"
        },
        {
          "s": 45,
          "text": "אינו כדבעי,"
        },
        {
          "s": 46,
          "text": "מכיון שגם ההשגה באלקות שבזמן הגלות אינה השגה אמיתית,"
        },
        {
          "s": 47,
          "text": "ועיקר העבודה שבזמן הגלות הוא בדרך נצחון,"
        },
        {
          "s": 48,
          "text": "כנ\"ל."
        },
        {
          "s": 49,
          "text": "ובזמן הגלות גופא,"
        },
        {
          "s": 50,
          "text": "הנה מדור לדור מתמעטים המוחין והלבבות,"
        },
        {
          "s": 51,
          "text": "כמרז\"ל33"
        },
        {
          "s": 52,
          "text": "לבן של ראשונים כו' ואנו כמלא נקב מחט סידקית,"
        },
        {
          "s": 53,
          "text": "ובפרט בדרא דעקבתא דמשיחא שנתרבו ההעלמות וההסתרים"
        },
        {
          "s": 54,
          "text": "(נוסף לזה שנתמעטו המוחין)."
        },
        {
          "s": 55,
          "text": "ולכן בזמן הזה נוגע עוד יותר ענין הנצחון והמס\"נ שלמעלה מטו\"ד."
        },
        {
          "s": 56,
          "text": "וגם הבעלי מוחין הנמצאים עכשיו צריכים להניח שכלם ולא לילך אחרי הטעם ודעת"
        },
        {
          "s": 57,
          "text": "(כי מצד השכל אפשר לנטות ח\"ו מדרך האמת,"
        },
        {
          "s": 58,
          "text": "ובפרט עכשיו שנתרבו ההעלמות וההסתרים,"
        },
        {
          "s": 59,
          "text": "כנ\"ל),"
        },
        {
          "s": 60,
          "text": "רק לעמוד חזק שלא לנטות ח\"ו מהשו\"ע אפילו כקוצו של יו\"ד,"
        },
        {
          "s": 61,
          "text": "עבודה בדרך נצחון ומס\"נ שלמעלה מהשכל34."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה הטעם על זה שההעלם וההסתר דהגלות"
        },
        {
          "s": 2,
          "text": "(כולל גם ההעלם וההסתר דדרא דעקבתא דמשיחא)"
        },
        {
          "s": 3,
          "text": "הוא רק על כחות הפנימיים דהנשמה ולא על מדת הנצח,"
        },
        {
          "s": 4,
          "text": "מבאר בהמאמר35,"
        },
        {
          "s": 5,
          "text": "שזהו לפי ששרש הנצח36"
        },
        {
          "s": 6,
          "text": "הוא בעצם הנפש,"
        },
        {
          "s": 7,
          "text": "דכמו\"כ הוא למעלה,"
        },
        {
          "s": 8,
          "text": "ששרש הנצח הוא בפנימיות הכתר,"
        },
        {
          "s": 9,
          "text": "ובפנימיות הכתר לא שייך ענין השינוי."
        },
        {
          "s": 10,
          "text": "וכמ\"ש37"
        },
        {
          "s": 11,
          "text": "וגם נצח ישראל לא ישקר ולא ינחם כי לא אדם הוא להנחם,"
        },
        {
          "s": 12,
          "text": "דענין הנחמה והשינוי שייך רק בבחינת אדם,"
        },
        {
          "s": 13,
          "text": "השתלשלות,"
        },
        {
          "s": 14,
          "text": "ומכיון ששרש הנצח הוא בבחינת לא אדם,"
        },
        {
          "s": 15,
          "text": "למעלה מהשתלשלות,"
        },
        {
          "s": 16,
          "text": "לכן אין שייך בו שינוי,"
        },
        {
          "s": 17,
          "text": "וישנו בגילוי גם בזמן הגלות."
        },
        {
          "s": 18,
          "text": "ולא עוד,"
        },
        {
          "s": 19,
          "text": "אלא שבזמן הגלות,"
        },
        {
          "s": 20,
          "text": "ובפרט בעקבתא דמשיחא,"
        },
        {
          "s": 21,
          "text": "כח הנצחון והמס\"נ הוא בגילוי יותר מבזמן הבית38."
        }
      ]
    }
  ]
}