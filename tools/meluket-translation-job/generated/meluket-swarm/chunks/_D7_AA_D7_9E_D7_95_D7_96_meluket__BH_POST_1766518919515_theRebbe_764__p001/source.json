{
  "globalIndex": 965,
  "owner": 15,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919515_theRebbe_764__p001",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919515_theRebbe_764__p001",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919515_theRebbe_764",
  "title": "מאמר גדול יהי' תשכ\"ב",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "גדול יהי' כבוד הבית הזה האחרון מן הראשון1,"
        },
        {
          "s": 1,
          "text": "ויש בזה שני פירושים2."
        },
        {
          "s": 2,
          "text": "פירוש הפשוט הוא3"
        },
        {
          "s": 3,
          "text": "שבית הזה האחרון קאי על בית שני שהי' גדול מבית הראשון בבנין ובשנים,"
        },
        {
          "s": 4,
          "text": "ובזהר4"
        },
        {
          "s": 5,
          "text": "איתא שהבית הזה האחרון קאי על בית המקדש השלישי שיבנה במהרה בימינו שיהי' גדול מבית הראשון ומבית השני,"
        },
        {
          "s": 6,
          "text": "דשניהם נכללים ב"
        },
        {
          "s": 7,
          "text": "(מן ה)"
        },
        {
          "s": 8,
          "text": "ראשון,"
        },
        {
          "s": 9,
          "text": "כי שניהם לא הי' להם קיום,"
        },
        {
          "s": 10,
          "text": "ובית שלישי יהי' קיים בקיום נצחי."
        },
        {
          "s": 11,
          "text": "וזהו שאמרו רז\"ל5"
        },
        {
          "s": 12,
          "text": "לא כאברהם שכתוב בו הר ולא כיצחק שכתוב בו שדה אלא כיעקב שקראו בית,"
        },
        {
          "s": 13,
          "text": "דבית ראשון הוא כנגד אברהם ובית שני כנגד יצחק ובית שלישי כנגד יעקב6,"
        },
        {
          "s": 14,
          "text": "ומבואר בלקו\"ת7"
        },
        {
          "s": 15,
          "text": "שהשייכות דבית שלישי ליעקב הוא כי מדתו של יעקב היא אמת,"
        },
        {
          "s": 16,
          "text": "ואמת הוא שאין שייך בו הפסק8"
        },
        {
          "s": 17,
          "text": "ושינוי."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה אף שבמארז\"ל הנ\"ל"
        },
        {
          "s": 2,
          "text": "(לא כאברהם כו')"
        },
        {
          "s": 3,
          "text": "מדובר בביהמ\"ק,"
        },
        {
          "s": 4,
          "text": "הלשון בלקו\"ת שם הוא שלש גאולות הן,"
        },
        {
          "s": 5,
          "text": "גאולה ראשונה בזכות אברהם גאולה שני' בזכות יצחק גאולה שלישית בזכות יעקב."
        },
        {
          "s": 6,
          "text": "ומבאר שם דגאולה השלישית היא גאולה נצחית."
        },
        {
          "s": 7,
          "text": "והביאור בזה בפשטות הוא,"
        },
        {
          "s": 8,
          "text": "כי מעיקרי הגאולה הוא – בנין בית המקדש9."
        },
        {
          "s": 9,
          "text": "וע\"י שמיתוסף עילוי בביהמ\"ק,"
        },
        {
          "s": 10,
          "text": "הגאולה היא נעלית יותר10."
        },
        {
          "s": 11,
          "text": "ולכן מקשר בלקו\"ת המעלה דגאולה השלישית עם המעלה דביהמ\"ק השלישי."
        }
      ]
    }
  ]
}