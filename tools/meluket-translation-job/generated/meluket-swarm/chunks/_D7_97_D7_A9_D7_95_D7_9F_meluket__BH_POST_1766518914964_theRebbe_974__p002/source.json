{
  "globalIndex": 200,
  "owner": 0,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914964_theRebbe_974__p002",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914964_theRebbe_974__p002",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518914964_theRebbe_974",
  "title": "מאמר ויהיו חיי שרה תשמ\"ה",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 1,
          "text": "דע\"י תשובה מאהבה משנים גם את העבר14,"
        },
        {
          "s": 2,
          "text": "ולכן בכחו של כל אחד"
        },
        {
          "s": 3,
          "text": "(גם מי שחטא ופגם והעביר את הדרך)"
        },
        {
          "s": 4,
          "text": "שכל שנותיו"
        },
        {
          "s": 5,
          "text": "(גם שנותיו שבעבר)"
        },
        {
          "s": 6,
          "text": "יהיו שוין לטובה."
        },
        {
          "s": 7,
          "text": "ועפ\"ז יש לבאר הקשר והשייכות דשני הפירושים בשני חיי שרה,"
        },
        {
          "s": 8,
          "text": "דילה הוו חיין וכולן שוין לטובה,"
        },
        {
          "s": 9,
          "text": "כי כל הענינים שבגשמיות משתלשלים מענינם ברוחניות15,"
        },
        {
          "s": 10,
          "text": "וע\"י ענין דילה הוו חיין בנוגע לחיין עילאין,"
        },
        {
          "s": 11,
          "text": "עי\"ז נעשה דילה הוו חיין גם בנוגע לחיים בפשטות,"
        },
        {
          "s": 12,
          "text": "שהחיים הן שלה והיא נעשית בעה\"ב עליהם,"
        },
        {
          "s": 13,
          "text": "ועי\"ז ניתן הכח לכל אחד מישראל16"
        },
        {
          "s": 14,
          "text": "שכל שני חייו"
        },
        {
          "s": 15,
          "text": "(גם השנים שעברו)"
        },
        {
          "s": 16,
          "text": "יהיו שלו ושהוא יהי' בעה\"ב עליהם,"
        },
        {
          "s": 17,
          "text": "ולכן בכחו שיהיו כל שנותיו"
        },
        {
          "s": 18,
          "text": "(גם השנים שבעבר)"
        },
        {
          "s": 19,
          "text": "שוין לטובה."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יובן מה שכתוב בתניא17"
        },
        {
          "s": 2,
          "text": "שכל אחד יכול להיות בינוני בכל עת ובכל שעה,"
        },
        {
          "s": 3,
          "text": "דלכאורה,"
        },
        {
          "s": 4,
          "text": "כיון שבינוני הוא זה שלא עבר עבירה מימיו ולא נקרא עליו שם רשע אפילו שעה אחת ורגע אחד כל ימיו18,"
        },
        {
          "s": 5,
          "text": "איך כל אדם"
        },
        {
          "s": 6,
          "text": "(כולל גם זה שעבר עבירה)"
        },
        {
          "s": 7,
          "text": "יכול להיות בינוני19."
        },
        {
          "s": 8,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 9,
          "text": "דכמו שבנוגע לכל המצוות רשות לכל אדם נתונה ואין מי שיעכב בידו20,"
        },
        {
          "s": 10,
          "text": "כמו\"כ הוא בנוגע למצות התשובה,"
        },
        {
          "s": 11,
          "text": "שלכל אחד מישראל יש לו בחירה חפשית לקיים מצות התשובה21."
        },
        {
          "s": 12,
          "text": "ויש לומר,"
        },
        {
          "s": 13,
          "text": "דהבחירה בנוגע למצות התשובה היא עוד יותר מבשאר המצוות."
        },
        {
          "s": 14,
          "text": "לפי שתשובה היא מצוה כללית,"
        },
        {
          "s": 15,
          "text": "ולכן יש על זה נתינת כח מיוחדת."
        },
        {
          "s": 16,
          "text": "וגם,"
        },
        {
          "s": 17,
          "text": "דכיון שכל אחד מישראל רוצה לעשות כל המצוות ולהתרחק מן העבירות אלא שיצרו הוא שתקפו22,"
        },
        {
          "s": 18,
          "text": "הרי כשעשה עבירה היפך רצונו דהאדם האמיתי,"
        },
        {
          "s": 19,
          "text": "בפנימיותו הוא מתחרט ומיצר ודואג על זה."
        },
        {
          "s": 20,
          "text": "היינו,"
        },
        {
          "s": 21,
          "text": "שבפנימיותו הוא עושה תשובה23"
        },
        {
          "s": 22,
          "text": "מיד."
        },
        {
          "s": 23,
          "text": "ולכן זה שאין מי שיעכב בידו לקיים מצות התשובה הוא"
        },
        {
          "s": 24,
          "text": "(בפרט אחד)"
        },
        {
          "s": 25,
          "text": "יותר מבשאר המצוות,"
        },
        {
          "s": 26,
          "text": "כי בכדי לקיים מצוה זו אינו צריך לעשי' ופעולה חדשה ורק לגלות התשובה שבפנימיותו."
        },
        {
          "s": 27,
          "text": "וזהו שכל אדם יכול להיות בינוני בכל עת ובכל שעה,"
        },
        {
          "s": 28,
          "text": "דכיון שיש לו בחירה חפשית לקיים מצות התשובה,"
        },
        {
          "s": 29,
          "text": "דעיקר ושלימות התשובה הוא תשובה מאהבה,"
        },
        {
          "s": 30,
          "text": "שעי\"ז נעקר עונו מתחלתו24,"
        },
        {
          "s": 31,
          "text": "הרי ביכלתו להיות בינוני שלא עבר עבירה מימיו25."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ויש להוסיף בביאור הקשר והשייכות דשני הפירושים בשני חיי שרה,"
        },
        {
          "s": 2,
          "text": "דילה הוו וכולן שוין,"
        },
        {
          "s": 3,
          "text": "שבכל אחד מהם כלולים שני הענינים."
        },
        {
          "s": 4,
          "text": "דגם בהפירוש ששני חיי שרה הוא כולן שוין לטובה,"
        },
        {
          "s": 5,
          "text": "כלול הענין דדילה הוו חיין"
        },
        {
          "s": 6,
          "text": "[כנ\"ל סעיף ב,"
        },
        {
          "s": 7,
          "text": "שבכדי שיהי' כולן שוין לטובה גם השנים שבעבר,"
        },
        {
          "s": 8,
          "text": "הוא ע\"י ששני חייו הם שלו],"
        },
        {
          "s": 9,
          "text": "ועד\"ז לאידך,"
        },
        {
          "s": 10,
          "text": "שגם בהפירוש ששני חיי שרה הוא דילה הוו חיין,"
        },
        {
          "s": 11,
          "text": "כלול הענין דכולן שוין."
        }
      ]
    }
  ]
}