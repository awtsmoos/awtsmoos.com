{
  "globalIndex": 113,
  "owner": 13,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914360_theRebbe_10__p003",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914360_theRebbe_10__p003",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914360_theRebbe_10",
  "title": "מאמר וחג האסיף תשמ\"ג",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וביאור הענין"
        },
        {
          "s": 2,
          "text": "(השייכות דנטילת ד' מינים עם חג הסוכות)"
        },
        {
          "s": 3,
          "text": "בעומק יותר,"
        },
        {
          "s": 4,
          "text": "דענין האחדות שבשניהם הוא לא רק באופן דהתאחדות של דברים נפרדים,"
        },
        {
          "s": 5,
          "text": "אלא אחדות אמיתית שלמעלה מהתחלקות."
        },
        {
          "s": 6,
          "text": "דבמצות נטילת ד' מינים הנה נוסף על האחדות שבכל אחד מד' המינים"
        },
        {
          "s": 7,
          "text": "(כמו שהוא בפני עצמו),"
        },
        {
          "s": 8,
          "text": "שהיא התאחדות של דברים נפרדים,"
        },
        {
          "s": 9,
          "text": "הרי כל ד' המינים נעשים מצוה אחת38,"
        },
        {
          "s": 10,
          "text": "ענין אחד39."
        },
        {
          "s": 11,
          "text": "דהגם שהם ד' מינים שונים,"
        },
        {
          "s": 12,
          "text": "ומן הקצה אל הקצה,"
        },
        {
          "s": 13,
          "text": "כדאיתא במדרש40"
        },
        {
          "s": 14,
          "text": "דד' מינים שבלולב הם כנגד ד' סוגים שבישראל,"
        },
        {
          "s": 15,
          "text": "מהסוג שכנגד אתרוג שיש בו טעם וריח"
        },
        {
          "s": 16,
          "text": "(תורה ומעשים טובים)"
        },
        {
          "s": 17,
          "text": "עד להסוג שכנגד ערבה שאין בה לא טעם ולא ריח,"
        },
        {
          "s": 18,
          "text": "מ\"מ הם נעשים כולם"
        },
        {
          "s": 19,
          "text": "(כל הד' סוגים)"
        },
        {
          "s": 20,
          "text": "אגודה אחת לעשות רצונך,"
        },
        {
          "s": 21,
          "text": "דאחדות זו"
        },
        {
          "s": 22,
          "text": "(מה שכולם נעשים אגודה אחת לעשות רצונך)"
        },
        {
          "s": 23,
          "text": "היא אחדות אמיתית שלמעלה מהתחלקות41."
        },
        {
          "s": 24,
          "text": "ועד\"ז הוא בענין האחדות דסוכה,"
        },
        {
          "s": 25,
          "text": "דלאחרי שאומר בסוכות תשבו שבעת ימים,"
        },
        {
          "s": 26,
          "text": "ענין האחדות דנפרדים"
        },
        {
          "s": 27,
          "text": "(מה ששבעת ימים מתאחדים בסוכה אחת),"
        },
        {
          "s": 28,
          "text": "מוסיף כל האזרח בישראל ישבו בסוכות"
        },
        {
          "s": 29,
          "text": "(ישבו סתם,"
        },
        {
          "s": 30,
          "text": "ואינו אומר שבעת ימים),"
        },
        {
          "s": 31,
          "text": "אחדות אמיתית שלמעלה מהתחלקות42."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז תובן השייכות דחג הסוכות"
        },
        {
          "s": 2,
          "text": "(תחוגו את חג ה' שבעת ימים,"
        },
        {
          "s": 3,
          "text": "דמצות ישיבה בסוכה ודמצות נטילת ד' מינים)"
        },
        {
          "s": 4,
          "text": "לבאספכם את תבואת הארץ,"
        },
        {
          "s": 5,
          "text": "כי באספכם הוא ענין האחדות,"
        },
        {
          "s": 6,
          "text": "שבתחילה הם דברים נפרדים,"
        },
        {
          "s": 7,
          "text": "וענין באספך הוא לאסוף אותם"
        },
        {
          "s": 8,
          "text": "(ולאחדם)"
        },
        {
          "s": 9,
          "text": "יחד."
        },
        {
          "s": 10,
          "text": "ושני ענינים בזה"
        },
        {
          "s": 11,
          "text": "(בדוגמת ב' המדריגות דאחדות שבסוכה וד' מינים)."
        },
        {
          "s": 12,
          "text": "דתחילה היא האסיפה"
        },
        {
          "s": 13,
          "text": "(וההתאחדות)"
        },
        {
          "s": 14,
          "text": "של ריבוי הפרטים דכל מין ומין"
        },
        {
          "s": 15,
          "text": "(דגן,"
        },
        {
          "s": 16,
          "text": "תירוש ויצהר)"
        },
        {
          "s": 17,
          "text": "בפני עצמו,"
        },
        {
          "s": 18,
          "text": "ולאח\"ז היא האסיפה"
        },
        {
          "s": 19,
          "text": "(ההתאחדות)"
        },
        {
          "s": 20,
          "text": "דכל ג' המינים יחד,"
        },
        {
          "s": 21,
          "text": "שאוסף כולם אל הבית43"
        },
        {
          "s": 22,
          "text": "(למקום אחד)."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה כל ענינים אלו באים לאחרי העבודה דהתחלת חודש תשרי,"
        },
        {
          "s": 2,
          "text": "אותיות רשית44."
        },
        {
          "s": 3,
          "text": "דעשרה ימים שבין ראש השנה ליום הכפורים45,"
        },
        {
          "s": 4,
          "text": "עשרה ימים,"
        },
        {
          "s": 5,
          "text": "הם בחינת התחלקות,"
        },
        {
          "s": 6,
          "text": "וביום הכפורים הם מתכללים ומתאחדים ביום אחד"
        },
        {
          "s": 7,
          "text": "(דיום הכפורים)46,"
        },
        {
          "s": 8,
          "text": "אחת בשנה47,"
        },
        {
          "s": 9,
          "text": "ולאחרי יום הכפורים,"
        },
        {
          "s": 10,
          "text": "בד' ימים שבין יום הכפורים לסוכות,"
        },
        {
          "s": 11,
          "text": "היא ההכנה לקיום מצות בסוכות תשבו ונטילת ד' מינים48,"
        },
        {
          "s": 12,
          "text": "כולל גם העבודה דבאספך את מעשיך מן השדה,"
        },
        {
          "s": 13,
          "text": "דעבודה זו היא"
        },
        {
          "s": 14,
          "text": "(כנ\"ל בתחילת המאמר)"
        },
        {
          "s": 15,
          "text": "לפני והכנה לחג הסוכות."
        },
        {
          "s": 16,
          "text": "אלא שביום הכפורים,"
        },
        {
          "s": 17,
          "text": "שאין בו אכילה ושתי' וכו',"
        },
        {
          "s": 18,
          "text": "הוא באופן דהפשטה מעניני העולם49."
        },
        {
          "s": 19,
          "text": "ובפרט בתפלת נעילה דיום הכפורים,"
        },
        {
          "s": 20,
          "text": "שאז ישראל ומלכא בלחודוהי50."
        },
        {
          "s": 21,
          "text": "דזהו פירוש נעילה51,"
        },
        {
          "s": 22,
          "text": "שנועלים כל השערים ונמצאים"
        },
        {
          "s": 23,
          "text": "(בפנים)"
        },
        {
          "s": 24,
          "text": "רק ישראל ומלכא."
        },
        {
          "s": 25,
          "text": "ובכדי להשלים הכוונה דדירה בתחתונים52,"
        },
        {
          "s": 26,
          "text": "צריכה להיות ההמשכה"
        },
        {
          "s": 27,
          "text": "(להמשיך ענין האחדות)"
        },
        {
          "s": 28,
          "text": "למטה,"
        },
        {
          "s": 29,
          "text": "בעוה\"ז הגשמי,"
        },
        {
          "s": 30,
          "text": "עד בענינים הגשמיים דעוה\"ז,"
        },
        {
          "s": 31,
          "text": "מתחיל מבאספך את מעשיך מן השדה,"
        },
        {
          "s": 32,
          "text": "דהגם שהיא עבודה רוחנית"
        },
        {
          "s": 33,
          "text": "(כנ\"ל בתחילת המאמר),"
        },
        {
          "s": 34,
          "text": "מ\"מ הרי היא קשורה גם עם אסיפת התבואה"
        },
        {
          "s": 35,
          "text": "(דגנך תירושך ויצהרך)"
        },
        {
          "s": 36,
          "text": "כפשוטה בגשמיות53,"
        },
        {
          "s": 37,
          "text": "ועד\"ז הוא גם במצות בסוכות תשבו,"
        },
        {
          "s": 38,
          "text": "דסכך הסוכה צ\"ל מגרנך ומיקבך ובזה גופא דוקא מפסולת גורן ויקב54,"
        },
        {
          "s": 39,
          "text": "ועד\"ז הוא גם במצות נטילת ד' מינים,"
        },
        {
          "s": 40,
          "text": "דא\"א לקיים המצוה ע\"י כוונה55,"
        },
        {
          "s": 41,
          "text": "ע\"י העבודה דמדות"
        },
        {
          "s": 42,
          "text": "(הגם שד' המינים הם מסוג הצומח וצומח הו\"ע המדות56),"
        },
        {
          "s": 43,
          "text": "וגם לא ע\"י העבודה דמלכות"
        },
        {
          "s": 44,
          "text": "(אף שענין הנענועים הוא להמשיך בנוקבא דז\"א"
        },
        {
          "s": 45,
          "text": "(מלכות)"
        },
        {
          "s": 46,
          "text": "העומדת בחזה דז\"א57),"
        },
        {
          "s": 47,
          "text": "וצריך לד' מינים גשמיים דוקא,"
        },
        {
          "s": 48,
          "text": "ושיגעו בחזה58"
        },
        {
          "s": 49,
          "text": "הגשמי דוקא."
        }
      ]
    }
  ]
}