{
  "globalIndex": 1080,
  "owner": 30,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920191_theRebbe_834__p004",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920191_theRebbe_834__p004",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920191_theRebbe_834",
  "title": "מאמר אני לדודי תשל\"ב",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה אף שבהדרגות דיראה,"
        },
        {
          "s": 2,
          "text": "היראה דאלול היא למטה מהיראה דראש השנה,"
        },
        {
          "s": 3,
          "text": "דהיראה דאלול היא יראה תתאה והיראה דר\"ה היא יראה עילאה,"
        },
        {
          "s": 4,
          "text": "מ\"מ יש מעלה בהיראה דאלול על היראה דר\"ה."
        },
        {
          "s": 5,
          "text": "כי היראה והביטול שבר\"ה,"
        },
        {
          "s": 6,
          "text": "כיון שאז הוא זמן התגלות מלכותו ית'29,"
        },
        {
          "s": 7,
          "text": "היראה והביטול אז אינם חידוש."
        },
        {
          "s": 8,
          "text": "דכיון שכולא קמי' כלא חשיב וכל שהוא קמי' יותר הוא יותר כלא30,"
        },
        {
          "s": 9,
          "text": "הרי זה שישראל הם בביטול דיראה עילאה בהזמן דר\"ה כשהם נמצאים בהיכל מלכותו,"
        },
        {
          "s": 10,
          "text": "אין בזה חידוש."
        },
        {
          "s": 11,
          "text": "[ובדוגמת הביטול שבאצילות,"
        },
        {
          "s": 12,
          "text": "שאין בזה חידוש31,"
        },
        {
          "s": 13,
          "text": "מכיון שבאצילות מאיר גילוי אוא\"ס."
        },
        {
          "s": 14,
          "text": "ועד\"ז באצילות גופא,"
        },
        {
          "s": 15,
          "text": "שהביטול שבספירת החכמה,"
        },
        {
          "s": 16,
          "text": "שבה הוא עיקר הביטול,"
        },
        {
          "s": 17,
          "text": "אינו חידוש,"
        },
        {
          "s": 18,
          "text": "לפי שבחכמה הוא הגילוי דהוא לבדו ואין זולתו32."
        },
        {
          "s": 19,
          "text": "ומכ\"ש הביטול דכתר,"
        },
        {
          "s": 20,
          "text": "דאע\"ג שהוא אור צח וכו' אוכם הוא קדם עילת העילות33,"
        },
        {
          "s": 21,
          "text": "דפירוש אוכם הוא שהכתר הוא בביטול"
        },
        {
          "s": 22,
          "text": "(כמו מראה השחור שאינו גבוה נגד מראה הלבן)"
        },
        {
          "s": 23,
          "text": "לגבי אוא\"ס שלמעלה מהכתר"
        },
        {
          "s": 24,
          "text": "(עילת העילות)34,"
        },
        {
          "s": 25,
          "text": "שאין זה חידוש,"
        },
        {
          "s": 26,
          "text": "מכיון שהכתר משיג35"
        },
        {
          "s": 27,
          "text": "שהוא באין ערוך לגבי אוא\"ס]."
        },
        {
          "s": 28,
          "text": "והיראה והביטול באלול,"
        },
        {
          "s": 29,
          "text": "כשהמלך הוא בשדה"
        },
        {
          "s": 30,
          "text": "(שאז אין נרגש הגדלות והרוממות שלו)"
        },
        {
          "s": 31,
          "text": "ואעפ\"כ ישנו הביטול דישראל,"
        },
        {
          "s": 32,
          "text": "שמקבלים עליהם מלכותו ית',"
        },
        {
          "s": 33,
          "text": "ולא עוד אלא שגם תוקעין בשופר לעורר יראה וחרדה"
        },
        {
          "s": 34,
          "text": "(בכדי שקבלת המלכות תהי' בשלימות),"
        },
        {
          "s": 35,
          "text": "הנה ביטול זה,"
        },
        {
          "s": 36,
          "text": "אף שהוא ביטול היש,"
        },
        {
          "s": 37,
          "text": "הוא יקר מאד בעיני הוי'36."
        },
        {
          "s": 38,
          "text": "ויש לומר,"
        },
        {
          "s": 39,
          "text": "דע\"י התענוג של המלך מזה שיוצאין לקראתו לקבל פניו"
        },
        {
          "s": 40,
          "text": "(קבלת מלכותו ית')"
        },
        {
          "s": 41,
          "text": "בהיותו בשדה מיתוסף עוד יותר בזה שהוא מקבל את כולם בסבר פנים יפות ומראה פנים שוחקות לכולם."
        },
        {
          "s": 42,
          "text": "ויש להוסיף,"
        },
        {
          "s": 43,
          "text": "דהמעלה שבהיראה והביטול דאלול לגבי היראה והביטול דר\"ה היא לא רק מצד החידוש שבזה,"
        },
        {
          "s": 44,
          "text": "אלא גם בענין הביטול37."
        },
        {
          "s": 45,
          "text": "דהביטול שע\"י גילוי,"
        },
        {
          "s": 46,
          "text": "כיון שהביטול הוא מפני שמכיר ומרגיש העילוי דהגילוי"
        },
        {
          "s": 47,
          "text": "(שהוא באין ערוך לגבי'),"
        },
        {
          "s": 48,
          "text": "הרי הביטול קשור עם מציאות האדם"
        },
        {
          "s": 49,
          "text": "(ההכרה שלו)."
        },
        {
          "s": 50,
          "text": "ואמיתית ענין הביטול הוא בהעבודה דקבלת עול,"
        },
        {
          "s": 51,
          "text": "שהוא כמו עבד,"
        },
        {
          "s": 52,
          "text": "שמצד עול האדון שמוטל עליו הוא מוכרח לקיים רצון האדון."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יש לבאר מ\"ש בהמאמר שהמשכת המקיף דר\"ה היא"
        },
        {
          "s": 2,
          "text": "(בעיקר)"
        },
        {
          "s": 3,
          "text": "ע\"י היראה והחרדה הבאה ע\"י תק\"ש דאלול,"
        },
        {
          "s": 4,
          "text": "כי זה שע\"י החרדה"
        },
        {
          "s": 5,
          "text": "(וחרד על דברי)"
        },
        {
          "s": 6,
          "text": "הוא המשכת המקיף"
        },
        {
          "s": 7,
          "text": "(בית),"
        },
        {
          "s": 8,
          "text": "הוא"
        },
        {
          "s": 9,
          "text": "(בעיקר)"
        },
        {
          "s": 10,
          "text": "כשהחרדה היא באופן דביטול ושפלות,"
        },
        {
          "s": 11,
          "text": "עני ונכה רוח."
        },
        {
          "s": 12,
          "text": "וכמבואר בהמאמר דכל שהאדם משפיל את עצמו יותר,"
        },
        {
          "s": 13,
          "text": "המקיף שנמשך הוא מקיף עליון יותר."
        },
        {
          "s": 14,
          "text": "ולכן עיקר המשכת המקיף הוא ע\"י היראה והחרדה דאלול,"
        },
        {
          "s": 15,
          "text": "כי היראה והחרדה דר\"ה הוא ע\"י שמרגיש הגילוי דלמעלה,"
        },
        {
          "s": 16,
          "text": "והביטול שע\"י הרגש הגילוי אינו באופן דשפלות,"
        },
        {
          "s": 17,
          "text": "ועיקר הענין דעני ונכה רוח,"
        },
        {
          "s": 18,
          "text": "ביטול באופן דשפלות,"
        },
        {
          "s": 19,
          "text": "הוא בהיראה והחרדה דאלול."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ויש להוסיף עוד ביאור בהמעלה שבהיראה דאלול על היראה דראש השנה,"
        },
        {
          "s": 1,
          "text": "דכיון שהיראה והביטול דאלול באה ע\"י עבודתם של ישראל,"
        },
        {
          "s": 2,
          "text": "אני לדודי,"
        },
        {
          "s": 3,
          "text": "שהשרש דישראל הוא בהעצמות,"
        },
        {
          "s": 4,
          "text": "לכן,"
        },
        {
          "s": 5,
          "text": "ההמשכה שע\"י יראה וביטול זה היא המשכת העצמות."
        },
        {
          "s": 6,
          "text": "ויש לומר,"
        },
        {
          "s": 7,
          "text": "שזהו הטעם הפנימי על זה שמהיראה תתאה דאלול באים אח\"כ בר\"ה ליראה עילאה,"
        },
        {
          "s": 8,
          "text": "כי ע\"י היראה דאלול הוא המשכת העצמות,"
        },
        {
          "s": 9,
          "text": "ועי\"ז נמשכים"
        },
        {
          "s": 10,
          "text": "(אח\"כ)"
        },
        {
          "s": 11,
          "text": "גם הגילויים."
        }
      ]
    }
  ]
}