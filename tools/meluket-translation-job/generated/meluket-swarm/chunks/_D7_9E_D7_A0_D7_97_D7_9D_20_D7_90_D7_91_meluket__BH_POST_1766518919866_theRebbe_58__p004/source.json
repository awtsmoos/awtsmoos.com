  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919866_theRebbe_58__p004",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919866_theRebbe_58__p004",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919866_theRebbe_58",
  "title": "מאמר ויענך וירעיבך ויאכילך תשכ\"ג",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "והנה זה שהמן הוא מאכל רעבון הוא כשהאדם הוא מציאות,"
        },
        {
          "s": 1,
          "text": "משא\"כ כשהוא בביטול לאלקות,"
        },
        {
          "s": 2,
          "text": "עיקר ההנאה והתענוג שלו הוא מהשפעה שנרגש בה שאינה בסלו דהאדם ונמשכת מהקב\"ה."
        },
        {
          "s": 3,
          "text": "וע\"י הביטול שלו הוא כלי לקבל השפע הבלתי מוגבל,"
        },
        {
          "s": 4,
          "text": "רואה ואוכל."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יש לבאר שהנוסח דברכת הזן"
        },
        {
          "s": 2,
          "text": "(דכתיב בה ואכלת ושבעת וברכת)"
        },
        {
          "s": 3,
          "text": "הוא על המן,"
        },
        {
          "s": 4,
          "text": "כי אמיתית ענין השובע"
        },
        {
          "s": 5,
          "text": "(והעשירות49)"
        },
        {
          "s": 6,
          "text": "הוא במן,"
        },
        {
          "s": 7,
          "text": "כשמרגיש שהשפע שנותנים לו אינו בסלו"
        },
        {
          "s": 8,
          "text": "(דהאדם)"
        },
        {
          "s": 9,
          "text": "אלא הוא נשפע תמיד מלמעלה"
        },
        {
          "s": 10,
          "text": "(כהמן שהי' ניכר בו בגילוי שמתחדש בכל יום)."
        },
        {
          "s": 11,
          "text": "וביכלתו של כאו\"א מישראל לבוא להרגש זה."
        },
        {
          "s": 12,
          "text": "ובפרט ע\"פ הידוע50"
        },
        {
          "s": 13,
          "text": "שפרנסה בזמן הזה"
        },
        {
          "s": 14,
          "text": "(בזמן הגלות)"
        },
        {
          "s": 15,
          "text": "הוא באופן דהשפעת המן."
        },
        {
          "s": 16,
          "text": "וע\"י הרגש זה הוא כלי לקבל השפע הבלתי מוגבל דמן."
        },
        {
          "s": 17,
          "text": "וכמאמר רז\"ל51"
        },
        {
          "s": 18,
          "text": "כלי ריקן מחזיק כלי מלא אינו מחזיק."
        },
        {
          "s": 19,
          "text": "דכאשר הוא מציאות,"
        },
        {
          "s": 20,
          "text": "ובפרט כשחושב שהשפע שנותנים לו הוא בסלו"
        },
        {
          "s": 21,
          "text": "(כלי מלא)"
        },
        {
          "s": 22,
          "text": "אינו מחזיק אפילו השפע המצומצם דלחם מן הארץ,"
        },
        {
          "s": 23,
          "text": "וע\"י שהוא כלי ריקן,"
        },
        {
          "s": 24,
          "text": "הוא מחזיק גם השובע והעשירות דמן,"
        },
        {
          "s": 25,
          "text": "ונמשכים לו כל ההשפעות דבני חיי ומזוני באופן של רויחי."
        }
      ]
    }
  ]
}