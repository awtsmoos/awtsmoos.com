{
  "globalIndex": 314,
  "owner": 14,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915585_theRebbe_828__p001",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915585_theRebbe_828__p001",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915585_theRebbe_828",
  "title": "מאמר פתח אליהו תשט\"ו",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "י\"ט כסלו ה'תשט\"ו*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "פתח אליהו ואמר,"
        },
        {
          "s": 1,
          "text": "רבון עלמין אנת הוא חד ולא בחושבן,"
        },
        {
          "s": 2,
          "text": "אנת הוא עילאה על כל עילאין,"
        },
        {
          "s": 3,
          "text": "סתימא על כל סתימין,"
        },
        {
          "s": 4,
          "text": "לית מחשבה תפיסא בך כלל,"
        },
        {
          "s": 5,
          "text": "אנת הוא דאפיקת עשר תיקונין וקרינן להון עשר ספירן1."
        },
        {
          "s": 6,
          "text": "ומבאר כ\"ק מו\"ח אדמו\"ר במאמרו ד\"ה זה2"
        },
        {
          "s": 7,
          "text": "שאמרו בי\"ט כסלו"
        },
        {
          "s": 8,
          "text": "(ה'תש\"ב)3,"
        },
        {
          "s": 9,
          "text": "שחשיב כאן כל המדריגות שמעצמות אוא\"ס עד הע\"ס דאצילות."
        },
        {
          "s": 10,
          "text": "אנת הוא חד הוא עצמות אוא\"ס,"
        },
        {
          "s": 11,
          "text": "ובכתר הוא פנימיות הכתר,"
        },
        {
          "s": 12,
          "text": "עתיק."
        },
        {
          "s": 13,
          "text": "ועל בחינה זו אמר ולא בחושבן,"
        },
        {
          "s": 14,
          "text": "שאינו בחושבן הענינים הנמנים לאח\"ז,"
        },
        {
          "s": 15,
          "text": "דכל הענינים הנמנים לאח\"ז"
        },
        {
          "s": 16,
          "text": "(כולל גם עילאה על כל עילאין)"
        },
        {
          "s": 17,
          "text": "הם באין ערוך לגבי אנת הוא חד,"
        },
        {
          "s": 18,
          "text": "ולכן אינו נחשב עמהם,"
        },
        {
          "s": 19,
          "text": "לא בחושבן."
        },
        {
          "s": 20,
          "text": "אנת הוא עילאה על כל עילאין הוא חיצוניות הכתר,"
        },
        {
          "s": 21,
          "text": "אריך."
        },
        {
          "s": 22,
          "text": "סתימא על כל סתימין הוא חכמה דאריך."
        },
        {
          "s": 23,
          "text": "לית מחשבה תפיסא בך כלל הוא פנימיות החכמה."
        },
        {
          "s": 24,
          "text": "אנת הוא דאפיקת עשר תיקונין,"
        },
        {
          "s": 25,
          "text": "הם הע\"ס דאצילות."
        },
        {
          "s": 26,
          "text": "ומבאר,"
        },
        {
          "s": 27,
          "text": "דהטעם שבאצילות הספירות הם במספר"
        },
        {
          "s": 28,
          "text": "(עשר תיקונין)"
        },
        {
          "s": 29,
          "text": "הוא,"
        },
        {
          "s": 30,
          "text": "כי אצילות הוא בכלל סדר ההשתלשלות"
        },
        {
          "s": 31,
          "text": "(גבול),"
        },
        {
          "s": 32,
          "text": "ובהשתלשלות שייך ענין המספר."
        },
        {
          "s": 33,
          "text": "ומזה מובן,"
        },
        {
          "s": 34,
          "text": "דהענינים שחשיב כאן נחלקים בדרך כלל לג' חלוקות."
        },
        {
          "s": 35,
          "text": "אנת הוא חד שקאי"
        },
        {
          "s": 36,
          "text": "(כנ\"ל)"
        },
        {
          "s": 37,
          "text": "על עתיק,"
        },
        {
          "s": 38,
          "text": "הוא נעתק ומובדל מהשתלשלות,"
        },
        {
          "s": 39,
          "text": "אנת הוא עילאה על כל עילאין,"
        },
        {
          "s": 40,
          "text": "שהוא למעלה מהשתלשלות אבל שייך להשתלשלות,"
        },
        {
          "s": 41,
          "text": "אנת הוא דאפיקת עשר תיקונין,"
        },
        {
          "s": 42,
          "text": "הם הע\"ס דאצילות,"
        },
        {
          "s": 43,
          "text": "השתלשלות4."
        },
        {
          "s": 44,
          "text": "וממשיך בהמאמר5,"
        },
        {
          "s": 45,
          "text": "שע\"י העבודה דמס\"נ ממשיכים מבחינת אנת הוא חד בהע\"ס."
        },
        {
          "s": 46,
          "text": "ועי\"ז הגילוי מה שהוא למעלה מהטבע נמשך בטבע6."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה מזה שאומר בהמאמר דפתח אליהו אנת הוא דאפיקת עשר תיקונין כו' לאנהגא בהון עלמין,"
        },
        {
          "s": 2,
          "text": "שהטעם על האצלת הע\"ס דאצילות הוא בכדי שעל ידם תהי' הנהגת העולמות,"
        },
        {
          "s": 3,
          "text": "מובן,"
        },
        {
          "s": 4,
          "text": "דהמדריגות שלמעלה מהע\"ס הם למעלה מהנהגת העולמות."
        },
        {
          "s": 5,
          "text": "ועפ\"ז,"
        },
        {
          "s": 6,
          "text": "גם הגילוי דאנת הוא עילאה וכו' הוא למעלה מהטבע."
        },
        {
          "s": 7,
          "text": "ובהמאמר אומר שהמשכת הגילוי שלמעלה מהטבע הוא ע\"י ההמשכה מבחינת אנת הוא חד."
        },
        {
          "s": 8,
          "text": "גם צריך להבין,"
        },
        {
          "s": 9,
          "text": "דכיון שגם הנהגת העולם שע\"פ טבע היא שאוא\"ס מנהיג את העולם באופן זה,"
        },
        {
          "s": 10,
          "text": "אנת הוא דאפיקת עשר תיקונין כו' לאנהגא בהון עלמין,"
        },
        {
          "s": 11,
          "text": "למה צריך שבהטבע תהי' המשכת הגילוי שלמעלה מהטבע."
        },
        {
          "s": 12,
          "text": "והגם דזה שאוא\"ס מנהיג את העולמות ע\"י הע\"ס הוא ע\"י התלבשותו בהכלים דע\"ס"
        },
        {
          "s": 13,
          "text": "[דהנהגת העולמות היא מהאור המתלבש בעולמות,"
        },
        {
          "s": 14,
          "text": "ובכדי שהאור יתלבש בעולמות הוא ע\"י שמתלבש"
        },
        {
          "s": 15,
          "text": "(תחלה)"
        },
        {
          "s": 16,
          "text": "בהכלים],"
        },
        {
          "s": 17,
          "text": "הרי גם לאחרי שהאור מתלבש בהכלים ובהעולמות הוא קשור עם אוא\"ס הבל\"ג."
        },
        {
          "s": 18,
          "text": "וכמבואר בהמשך תרס\"ו7"
        },
        {
          "s": 19,
          "text": "דזה שבהנהגת הטבע יש ענין התמידיות"
        },
        {
          "s": 20,
          "text": "(הגם שטבע הוא מהחיות האלקי שמלובש בהנבראים,"
        },
        {
          "s": 21,
          "text": "שהוא חיות מוגבל),"
        },
        {
          "s": 22,
          "text": "הוא,"
        },
        {
          "s": 23,
          "text": "כי שרש החיות המלובש בהנבראים הוא מאור הקו,"
        },
        {
          "s": 24,
          "text": "ששרשו הוא מאוא\"ס שלפני הצמצום8,"
        },
        {
          "s": 25,
          "text": "והשלימות דטבע הוא ע\"י שנמשך בו הגילוי שלמעלה מהטבע."
        }
      ]
    }
  ]
}