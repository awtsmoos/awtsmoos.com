{
  "globalIndex": 868,
  "owner": 18,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918894_theRebbe_986__p003",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918894_theRebbe_986__p003",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918894_theRebbe_986",
  "title": "מאמר בהעלותך את הנרות תשל\"ד",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והענין הוא,"
        },
        {
          "s": 2,
          "text": "דהנשמה גם כמו שהיא למעלה,"
        },
        {
          "s": 3,
          "text": "היא דוגמת הבן"
        },
        {
          "s": 4,
          "text": "(כמו)"
        },
        {
          "s": 5,
          "text": "שנמשך ממוח האב21,"
        },
        {
          "s": 6,
          "text": "אבל עצם הנשמה כמו שהיא מושרשת בעצמותו ית',"
        },
        {
          "s": 7,
          "text": "בדוגמת הבן כמו שהוא במוח האב עצמו"
        },
        {
          "s": 8,
          "text": "(טרם שנמשך),"
        },
        {
          "s": 9,
          "text": "אינה בגדר המשכה וגילוי29."
        },
        {
          "s": 10,
          "text": "וע\"י עבודת הנשמה בירידתה למטה,"
        },
        {
          "s": 11,
          "text": "לעורר ולגלות את טבע הרצוא והעלי' שבה,"
        },
        {
          "s": 12,
          "text": "שהוא דוגמת טבע הגעגועים דבן אל אביו30,"
        },
        {
          "s": 13,
          "text": "עי\"ז מתגלית עצם הנשמה כמו שהיא מושרשת בהעצמות."
        },
        {
          "s": 14,
          "text": "כי לגבי דרגת הנשמה שבדוגמת הבן שנמשך ממוח האב,"
        },
        {
          "s": 15,
          "text": "הירידה לבי\"ע"
        },
        {
          "s": 16,
          "text": "(ומכ\"ש הירידה למטה בעוה\"ז הגשמי)"
        },
        {
          "s": 17,
          "text": "מעלמת ומסתרת על זה"
        },
        {
          "s": 18,
          "text": "[וכידוע31"
        },
        {
          "s": 19,
          "text": "שרק נשמות דאצילות נק' בשם בנים],"
        },
        {
          "s": 20,
          "text": "וזה שגם בירידתה למטה היא בבחינת בן בגילוי,"
        },
        {
          "s": 21,
          "text": "שהרצוא והעלי' שלה הוא בגילוי כבן המתגעגע אל אביו,"
        },
        {
          "s": 22,
          "text": "הוא ע\"י גילוי עצם הנשמה כמו שהיא במוח האב"
        },
        {
          "s": 23,
          "text": "(טרם שנמשך),"
        },
        {
          "s": 24,
          "text": "שלגבי דרגא זו"
        },
        {
          "s": 25,
          "text": "(עצם הנשמה כמו שמושרשת בהעצמות),"
        },
        {
          "s": 26,
          "text": "אצילות ובי\"ע הם בשוה."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש לבאר מ\"ש בלקו\"ת32"
        },
        {
          "s": 1,
          "text": "עה\"פ33"
        },
        {
          "s": 2,
          "text": "ראיתי והנה מנורת זהב כולה גו' זה דבר ה' אל זרובבל,"
        },
        {
          "s": 3,
          "text": "שהשייכות דמנורה לדבר ה' אל זרובבל היא,"
        },
        {
          "s": 4,
          "text": "דדבר ה' הוא מקור נש\"י,"
        },
        {
          "s": 5,
          "text": "ומ\"ש דבר ה' אל זרובבל הוא,"
        },
        {
          "s": 6,
          "text": "כי ישראל אז"
        },
        {
          "s": 7,
          "text": "(בזמן גלות בבל)"
        },
        {
          "s": 8,
          "text": "נקראו בשם זרובבל על שם וזרעתי'34"
        },
        {
          "s": 9,
          "text": "לי בארץ"
        },
        {
          "s": 10,
          "text": "(זרובבל מלשון זרוע בבבל)."
        },
        {
          "s": 11,
          "text": "וזוהי השייכות דמנורת זהב עם דבר ה' אל זרובבל,"
        },
        {
          "s": 12,
          "text": "כי כללות נש\"י נק' מנורה."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "דלכאורה אינו מובן,"
        },
        {
          "s": 1,
          "text": "מה נוגע לענין המנורה שישראל הם זרועים בבבל."
        },
        {
          "s": 2,
          "text": "וי\"ל הביאור בזה,"
        },
        {
          "s": 3,
          "text": "ע\"פ הידוע35"
        },
        {
          "s": 4,
          "text": "דזה שהירידה דהגלות נק' בשם זריעה הוא כי הכוונה בהירידה היא שהיא לצורך עלי',"
        },
        {
          "s": 5,
          "text": "בדוגמת הזריעה בארץ שהיא בשביל הצמיחה"
        },
        {
          "s": 6,
          "text": "(בריבוי,"
        },
        {
          "s": 7,
          "text": "דכלום אדם זורע סאה אלא להכניס כמה כורין36)."
        },
        {
          "s": 8,
          "text": "וזוהי השייכות דמנורת זהב עם זרובבל,"
        },
        {
          "s": 9,
          "text": "כי הענין דבהעלותך את הנרות,"
        },
        {
          "s": 10,
          "text": "שהוא הגילוי דעצם הנשמה"
        },
        {
          "s": 11,
          "text": "(כנ\"ל סעיף ב),"
        },
        {
          "s": 12,
          "text": "הוא בעיקר ע\"י העבודה בזמן הגלות"
        },
        {
          "s": 13,
          "text": "[דזה שנת\"ל שהגילוי דעצם הנשמה הוא ע\"י עבודתה בירידתה למטה,"
        },
        {
          "s": 14,
          "text": "הוא בכללות,"
        },
        {
          "s": 15,
          "text": "ועיקר הגילוי הוא ע\"י העבודה דישראל בירידתם בפרט בגלות],"
        },
        {
          "s": 16,
          "text": "ולכן נק' ישראל כאן בשם זרובבל על שם שהיו זרועים בבבל"
        },
        {
          "s": 17,
          "text": "(גלות הראשון דד' הגלויות37),"
        },
        {
          "s": 18,
          "text": "בכדי לרמז,"
        },
        {
          "s": 19,
          "text": "דלא רק שגם בזמן הגלות ישראל הם מנורה"
        },
        {
          "s": 20,
          "text": "[דגם כאשר אני ישנה38"
        },
        {
          "s": 21,
          "text": "בגלותא39"
        },
        {
          "s": 22,
          "text": "לבי ער38],"
        },
        {
          "s": 23,
          "text": "אלא יתירה מזו,"
        },
        {
          "s": 24,
          "text": "שהירידה בגלות היא זריעה שעל ידה נעשה צמיחה בריבוי גדול יותר,"
        },
        {
          "s": 25,
          "text": "בהעלותך את הנרות40."
        }
      ]
    }
  ]
}