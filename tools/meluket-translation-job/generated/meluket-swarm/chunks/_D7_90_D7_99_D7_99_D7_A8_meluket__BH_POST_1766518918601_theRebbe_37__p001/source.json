{
  "globalIndex": 805,
  "owner": 5,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918601_theRebbe_37__p001",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918601_theRebbe_37__p001",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918601_theRebbe_37",
  "title": "מאמר גל עיני ואביטה תשל\"ז",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ אמור,"
        },
        {
          "s": 2,
          "text": "י\"ט אייר,"
        },
        {
          "s": 3,
          "text": "ה'תשל\"ז*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "גל עיני ואביטה נפלאות מתורתך1,"
        },
        {
          "s": 1,
          "text": "וכתב אדמו\"ר מהר\"ש במאמרו ע\"פ זה2,"
        },
        {
          "s": 2,
          "text": "דע\"פ מ\"ש בסידור שער הל\"ג בעומר3"
        },
        {
          "s": 3,
          "text": "שהרמז בתורה על ל\"ג בעומר הוא בפסוק4"
        },
        {
          "s": 4,
          "text": "עד הגל הזה,"
        },
        {
          "s": 5,
          "text": "גם הפסוק גל עיני יתבאר על ל\"ג בעומר."
        },
        {
          "s": 6,
          "text": "וע\"פ הידוע שכל הענינים שבתורה הם בתכלית הדיוק,"
        },
        {
          "s": 7,
          "text": "יש לומר,"
        },
        {
          "s": 8,
          "text": "דזה שהענין דל\"ג בעומר שבפסוק גל עיני גו' למדין מהענין דל\"ג בעומר שבפסוק עד הגל הזה,"
        },
        {
          "s": 9,
          "text": "הוא,"
        },
        {
          "s": 10,
          "text": "כי בכדי לבוא לענין גל עיני גו' הוא ע\"י עד הגל הזה."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה השייכות דפסוק זה לל\"ג בעומר יום ההסתלקות דרשב\"י"
        },
        {
          "s": 2,
          "text": "(בפשטות)"
        },
        {
          "s": 3,
          "text": "הוא,"
        },
        {
          "s": 4,
          "text": "כי ענינו של רשב\"י הוא – שעל ידו הי' הגילוי דפנימיות התורה"
        },
        {
          "s": 5,
          "text": "[וכמבואר בכ\"מ5,"
        },
        {
          "s": 6,
          "text": "שהגילוי דתורה הנגלית הי' ע\"י משה רבינו והגילוי דפנימיות התורה הי' ע\"י רשב\"י6],"
        },
        {
          "s": 7,
          "text": "ועיקר הגילוי הי' ביום הסתלקותו,"
        },
        {
          "s": 8,
          "text": "כדאיתא בזהר7"
        },
        {
          "s": 9,
          "text": "שביום הסתלקותו גילה לתלמידיו \"מלין קדישין\" שלא גילה במשך כל ימי חייו"
        },
        {
          "s": 10,
          "text": "(כי הענינים שגילה אז היו ענינים נעלים ביותר שאפילו רשב\"י הי' מקודם ירא לגלותם8)."
        },
        {
          "s": 11,
          "text": "וע\"י כתיבת המלין קדישין"
        },
        {
          "s": 12,
          "text": "(ע\"פ הציווי שלו9),"
        },
        {
          "s": 13,
          "text": "נתגלו אח\"כ לכל ישראל,"
        },
        {
          "s": 14,
          "text": "ועד שנתגלו באופן דיתפרנסון10,"
        },
        {
          "s": 15,
          "text": "בהבנה והשגה."
        },
        {
          "s": 16,
          "text": "שגם המשכת גילוי זה"
        },
        {
          "s": 17,
          "text": "(הגילוי לכל ישראל ובאופן דיתפרנסון)"
        },
        {
          "s": 18,
          "text": "היתה ביום הסתלקות רשב\"י"
        },
        {
          "s": 19,
          "text": "(ע\"י כתיבתן של המלין קדישין אז,"
        },
        {
          "s": 20,
          "text": "ע\"פ הציווי שלו)."
        },
        {
          "s": 21,
          "text": "ולהוסיף,"
        },
        {
          "s": 22,
          "text": "דע\"פ הידוע11"
        },
        {
          "s": 23,
          "text": "שביום הסתלקותו של אדם מתגלה הפנימיות של כל עבודתו שעבד במשך כל ימי חייו,"
        },
        {
          "s": 24,
          "text": "מובן,"
        },
        {
          "s": 25,
          "text": "דביום הסתלקות רשב\"י,"
        },
        {
          "s": 26,
          "text": "נתגלה גם הפנימיות של הסודות שגילה במשך כל ימי חייו."
        },
        {
          "s": 27,
          "text": "ובכל שנה ושנה,"
        },
        {
          "s": 28,
          "text": "ביום ל\"ג בעומר,"
        },
        {
          "s": 29,
          "text": "חוזר וניעור הגילוי שהי' בל\"ג בעומר בפעם הראשונה12"
        },
        {
          "s": 30,
          "text": "– גילוי פנימיות התורה"
        },
        {
          "s": 31,
          "text": "(תורתו של רשב\"י)."
        },
        {
          "s": 32,
          "text": "וכמובן גם מהמבואר בכ\"מ13"
        },
        {
          "s": 33,
          "text": "דבל\"ג בעומר הוא מתן תורה14"
        },
        {
          "s": 34,
          "text": "דפנימיות התורה,"
        },
        {
          "s": 35,
          "text": "בדוגמת חג השבועות שהוא זמן מתן תורה בכלל."
        },
        {
          "s": 36,
          "text": "דמזה מובן,"
        },
        {
          "s": 37,
          "text": "דכמו שמתן תורה בחג השבועות הוא בכל שנה ושנה,"
        },
        {
          "s": 38,
          "text": "כמו\"כ מתן תורה דפנימיות התורה בל\"ג בעומר הוא בכל שנה ושנה."
        },
        {
          "s": 39,
          "text": "וזהו שענין ל\"ג בעומר מרומז בפסוק גל עיני ואביטה נפלאות מתורתך,"
        },
        {
          "s": 40,
          "text": "כי נפלאות שבתורה הוא פנימיות התורה15,"
        },
        {
          "s": 41,
          "text": "וענין גל גו' נפלאות הוא גילוי"
        },
        {
          "s": 42,
          "text": "(גל מלשון גילוי16)"
        },
        {
          "s": 43,
          "text": "הנפלאות דתורה"
        },
        {
          "s": 44,
          "text": "(פנימיות התורה)"
        },
        {
          "s": 45,
          "text": "שנמשך בג\"ל"
        },
        {
          "s": 46,
          "text": "(בל\"ג בעומר)."
        }
      ]
    }
  ]
}