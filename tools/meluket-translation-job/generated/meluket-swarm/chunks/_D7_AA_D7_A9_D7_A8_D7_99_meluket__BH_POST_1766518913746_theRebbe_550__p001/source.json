{
  "globalIndex": 8,
  "owner": 8,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913746_theRebbe_550__p001",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913746_theRebbe_550__p001",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518913746_theRebbe_550",
  "title": "מאמר והיה ביום ההוא תשכ\"ח",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "יום ב' דראש השנה,"
        },
        {
          "s": 2,
          "text": "ה'תשכ\"ח"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "והי'1 ביום ההוא יתקע בשופר גדול ובאו האובדים בארץ אשור והנדחים בארץ מצרים והשתחוו לה' בהר הקדש בירושלים,"
        },
        {
          "s": 1,
          "text": "ומדייק אדמו\"ר הזקן"
        },
        {
          "s": 2,
          "text": "(בהמאמר ד\"ה זה שבלקו\"ת2)"
        },
        {
          "s": 3,
          "text": "מ\"ש בשופר גדול,"
        },
        {
          "s": 4,
          "text": "מהי המעלה דשופר גדול."
        },
        {
          "s": 5,
          "text": "גם צריך להבין"
        },
        {
          "s": 6,
          "text": "(כמו שמדייק בהמשך המאמר3)"
        },
        {
          "s": 7,
          "text": "מ\"ש יתקע סתם ולא נאמר מי הוא התוקע."
        },
        {
          "s": 8,
          "text": "ואדמו\"ר האמצעי4"
        },
        {
          "s": 9,
          "text": "מוסיף עוד דיוק בזה שנאמר יתקע,"
        },
        {
          "s": 10,
          "text": "דלשון יתקע"
        },
        {
          "s": 11,
          "text": "(תי\"ו בקמ\"ץ)"
        },
        {
          "s": 12,
          "text": "מורה שיתקע מעצמו."
        },
        {
          "s": 13,
          "text": "ונקודת הביאור"
        },
        {
          "s": 14,
          "text": "(בהדרושים5)"
        },
        {
          "s": 15,
          "text": "היא,"
        },
        {
          "s": 16,
          "text": "דההתעוררות שעל ידי שופר סתם הוא רק לאלה שהם בקירוב קצת,"
        },
        {
          "s": 17,
          "text": "ובכדי לעורר את האובדים בארץ אשור והנדחים בארץ מצרים שגם הם יתעוררו לבוא לירושלים ולהשתחוות לה',"
        },
        {
          "s": 18,
          "text": "הוא על ידי שופר גדול."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ובכדי לבאר העילוי דשופר גדול שיהי' לע\"ל,"
        },
        {
          "s": 1,
          "text": "מקדים בהמאמר6"
        },
        {
          "s": 2,
          "text": "ביאור ענין שופר דראש השנה"
        },
        {
          "s": 3,
          "text": "(עכשיו),"
        },
        {
          "s": 4,
          "text": "דעל ידי שישראל תוקעין בשופר,"
        },
        {
          "s": 5,
          "text": "שהיא הצעקה דפנימיות הלב שלמעלה מהשכל,"
        },
        {
          "s": 6,
          "text": "עי\"ז נמשך פנימיות הלב דלמעלה כביכול,"
        },
        {
          "s": 7,
          "text": "רצון העליון שלמעלה מהחכמה."
        },
        {
          "s": 8,
          "text": "ועל זה נאמר7"
        },
        {
          "s": 9,
          "text": "ואד' הוי' בשופר יתקע,"
        },
        {
          "s": 10,
          "text": "דכמו שתקיעת שופר דהאדם היא הצעקה דפנימיות הלב,"
        },
        {
          "s": 11,
          "text": "עד\"ז הוא למעלה,"
        },
        {
          "s": 12,
          "text": "דענין תקיעת שופר הוא המשכת וגילוי הפנימיות."
        },
        {
          "s": 13,
          "text": "והחילוק בין שופר סתם לשופר גדול הוא,"
        },
        {
          "s": 14,
          "text": "דשופר סתם הוא המשכת וגילוי הפנימיות דאלקות שלמעלה מעולמות אבל שייך לעולמות,"
        },
        {
          "s": 15,
          "text": "סובב כל עלמין,"
        },
        {
          "s": 16,
          "text": "ושופר גדול הוא המשכת וגילוי הפנימיות דאלקות שלמעלה משייכות לעולמות,"
        },
        {
          "s": 17,
          "text": "למעלה גם מסובב."
        },
        {
          "s": 18,
          "text": "וזהו שבשופר סתם כתיב ואד' הוי' בשופר יתקע,"
        },
        {
          "s": 19,
          "text": "דאד' הוי' הם שמות,"
        },
        {
          "s": 20,
          "text": "אלא ששמות אלה"
        },
        {
          "s": 21,
          "text": "(אד' הוי' בניקוד אלקים)"
        },
        {
          "s": 22,
          "text": "הם נעלים ביותר8,"
        },
        {
          "s": 23,
          "text": "ובשופר גדול כתיב יתקע סתם ולא נאמר מי הוא התוקע,"
        },
        {
          "s": 24,
          "text": "כי תקיעה זו היא המשכה וגילוי מבחינת סתימא דכל סתימין,"
        },
        {
          "s": 25,
          "text": "שלמעלה משמות."
        }
      ]
    }
  ]
}