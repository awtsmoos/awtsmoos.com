{
  "globalIndex": 186,
  "owner": 36,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914855_theRebbe_522__p005",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914855_theRebbe_522__p005",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518914855_theRebbe_522",
  "title": "מאמר ואשה אחת תשמ\"ו",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "והטעם על זה,"
        },
        {
          "s": 2,
          "text": "כי במתן תורה,"
        },
        {
          "s": 3,
          "text": "על ידי הדיבור55"
        },
        {
          "s": 4,
          "text": "אנכי הוי' אלקיך,"
        },
        {
          "s": 5,
          "text": "נעשה כן בכאו\"א מישראל,"
        },
        {
          "s": 6,
          "text": "שאנכי"
        },
        {
          "s": 7,
          "text": "(על ידי שנמשך בהוי')"
        },
        {
          "s": 8,
          "text": "הוא אלקיך,"
        },
        {
          "s": 9,
          "text": "כחך וחיותך56."
        },
        {
          "s": 10,
          "text": "והגם דזה שאנכי נעשה אלקיך הוא כמו שנמשך בהוי',"
        },
        {
          "s": 11,
          "text": "וכמבואר בהמאמר57"
        },
        {
          "s": 12,
          "text": "החילוק בין מצות התשובה לכל המצוות,"
        },
        {
          "s": 13,
          "text": "דבתשובה כתיב אשר אנכי מצוך,"
        },
        {
          "s": 14,
          "text": "אנכי סתם,"
        },
        {
          "s": 15,
          "text": "ובכל המצוות כתיב אנכי הוי',"
        },
        {
          "s": 16,
          "text": "אנכי כמו שנמשך בהוי',"
        },
        {
          "s": 17,
          "text": "מ\"מ,"
        },
        {
          "s": 18,
          "text": "ע\"פ הידוע58"
        },
        {
          "s": 19,
          "text": "שבהדיבור אנכי כלולים כל המצוות,"
        },
        {
          "s": 20,
          "text": "גם מצות התשובה,"
        },
        {
          "s": 21,
          "text": "יש לומר,"
        },
        {
          "s": 22,
          "text": "שבאנכי הוי'"
        },
        {
          "s": 23,
          "text": "(שבמתן תורה)"
        },
        {
          "s": 24,
          "text": "נכלל גם בחינת אנכי כמו שהוא בעצמותו,"
        },
        {
          "s": 25,
          "text": "למעלה מהמשכה בהוי',"
        },
        {
          "s": 26,
          "text": "אלא שהגילוי דבחינה זו הוא במצות התשובה."
        },
        {
          "s": 27,
          "text": "ומזה מובן,"
        },
        {
          "s": 28,
          "text": "דזה שבמתן תורה נעשה בכאו\"א מישראל שאנכי הוא אלקיך,"
        },
        {
          "s": 29,
          "text": "כחך וחיותך,"
        },
        {
          "s": 30,
          "text": "הוא גם בחינת אנכי שלמעלה מהמשכה בהוי'."
        },
        {
          "s": 31,
          "text": "וכאשר האדם רוצה להתעורר בתשובה"
        },
        {
          "s": 32,
          "text": "(עוד לפני שעושה תשובה),"
        },
        {
          "s": 33,
          "text": "עי\"ז מתגלה אצלו שאנכי"
        },
        {
          "s": 34,
          "text": "(גם אנכי שלמעלה מהמשכה בהוי')"
        },
        {
          "s": 35,
          "text": "הוא כחך וחיותך,"
        },
        {
          "s": 36,
          "text": "היינו שזה שייך גם להנר\"נ שלו,"
        },
        {
          "s": 37,
          "text": "ועי\"ז,"
        },
        {
          "s": 38,
          "text": "המצוה הזאת"
        },
        {
          "s": 39,
          "text": "(תשובה)"
        },
        {
          "s": 40,
          "text": "אשר אנכי מצוך,"
        },
        {
          "s": 41,
          "text": "לא נפלאת היא ממך ולא רחוקה היא,"
        },
        {
          "s": 42,
          "text": "ואדרבא,"
        },
        {
          "s": 43,
          "text": "קרוב אליך הדבר מאד בפיך ובלבבך לעשותו,"
        },
        {
          "s": 44,
          "text": "שקרוב מאד לכ\"א מישראל להגיע לתשובה,"
        },
        {
          "s": 45,
          "text": "ולא רק לדרגת התשובה כמו שירדה להיות בבחינת פלא וריחוק אלא גם לדרגת התשובה אשר אנכי מצוך."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "וזהו ואת ובנייך תחיי בנותר,"
        },
        {
          "s": 3,
          "text": "שגם כחות הפנימיים דהנשמה יחיו בנותר,"
        },
        {
          "s": 4,
          "text": "דהגם שנותר הוא מקיף,"
        },
        {
          "s": 5,
          "text": "ויתירה מזו שהוא מקיף הרחוק,"
        },
        {
          "s": 6,
          "text": "מ\"מ,"
        },
        {
          "s": 7,
          "text": "נמשך ממנו חיות גם לכחות הפנימיים דהנשמה,"
        },
        {
          "s": 8,
          "text": "כי ע\"י התשובה מתגלה שאנכי הוא אלקיך כחך וחיותך."
        },
        {
          "s": 9,
          "text": "וע\"ד שנת\"ל"
        },
        {
          "s": 10,
          "text": "(סעיף ט)"
        },
        {
          "s": 11,
          "text": "בענין לא נפלאת היא ממך."
        },
        {
          "s": 12,
          "text": "אלא שענין לא נפלאת היא ממך הוא שכחות הפנימיים דהנשמה"
        },
        {
          "s": 13,
          "text": "(ע\"י הרצון לעשות תשובה)"
        },
        {
          "s": 14,
          "text": "הם באופן שעל ידם אפשר להגיע להמקיפים,"
        },
        {
          "s": 15,
          "text": "וענין ואת ובנייך תחיי בנותר הוא שכחות הפנימיים חיים"
        },
        {
          "s": 16,
          "text": "(בחיות פנימי)"
        },
        {
          "s": 17,
          "text": "בהנותר שנמשך ע\"י התשובה,"
        },
        {
          "s": 18,
          "text": "בנותר דמקיף הקרוב וגם בנותר דמקיף הרחוק"
        },
        {
          "s": 19,
          "text": "[ויש לומר,"
        },
        {
          "s": 20,
          "text": "שבנותר נכלל גם העצם שלמעלה מהגדר דמקיף ופנימי]."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ויש לקשר זה גם עם פירוש רז\"ל עה\"פ ואת ובנייך תחיי בנותר,"
        },
        {
          "s": 1,
          "text": "עד שיחיו המתים,"
        },
        {
          "s": 2,
          "text": "כי בתחיית המתים יהי' חיות הגוף מהסובב59"
        },
        {
          "s": 3,
          "text": "(נותר)."
        },
        {
          "s": 4,
          "text": "וע\"י ענין את ובנייך תחיי בנותר,"
        },
        {
          "s": 5,
          "text": "שהחיות דכחות הפנימיים"
        },
        {
          "s": 6,
          "text": "(דהנשמה)"
        },
        {
          "s": 7,
          "text": "הוא בנותר,"
        },
        {
          "s": 8,
          "text": "יהי' לע\"ל גם חיות הגוף מהסובב."
        },
        {
          "s": 9,
          "text": "[ולא עוד אלא שהחיות דהגוף יהי' נעלה יותר,"
        },
        {
          "s": 10,
          "text": "שלכן,"
        },
        {
          "s": 11,
          "text": "הנשמה תהי' ניזונית מהגוף59]."
        },
        {
          "s": 12,
          "text": "ויש לומר,"
        },
        {
          "s": 13,
          "text": "שזוהי גם השייכות דתשובה לגאולה העתידה,"
        },
        {
          "s": 14,
          "text": "דאין ישראל נגאלין אלא בתשובה60"
        },
        {
          "s": 15,
          "text": "ומשיח אתא לאתבא צדיקייא בתיובתא61,"
        },
        {
          "s": 16,
          "text": "כי ההמשכה שע\"י התשובה היא באופן שממנה נמשך חיות גם לכחות הפנימיים,"
        },
        {
          "s": 17,
          "text": "את ובנייך תחיי בנותר,"
        },
        {
          "s": 18,
          "text": "והשלימות דגאולה העתידה היא בתחיית המתים,"
        },
        {
          "s": 19,
          "text": "שחיות הגוף יהי' מהסובב."
        },
        {
          "s": 20,
          "text": "ולכן,"
        },
        {
          "s": 21,
          "text": "ע\"י שישראל עושין תשובה מיד הן נגאלין60,"
        },
        {
          "s": 22,
          "text": "בגאולה האמיתית והשלימה ע\"י משיח צדקנו,"
        },
        {
          "s": 23,
          "text": "יבוא ויגאלנו ויוליכנו קוממיות לארצנו,"
        },
        {
          "s": 24,
          "text": "בעגלא דידן ממש."
        }
      ]
    }
  ]
}