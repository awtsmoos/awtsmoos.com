{
  "globalIndex": 859,
  "owner": 9,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918872_theRebbe_254__p001",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918872_theRebbe_254__p001",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918872_theRebbe_254",
  "title": "מאמר בהעלותך את הנרות תשכ\"ט",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ בהעלותך,"
        },
        {
          "s": 2,
          "text": "כ\"א סיון,"
        },
        {
          "s": 3,
          "text": "ה'תשכ\"ט"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "בהעלותך את הנרות1,"
        },
        {
          "s": 1,
          "text": "ואיתא בלקו\"ת2"
        },
        {
          "s": 2,
          "text": "דנרות הם הנשמות כמ\"ש3"
        },
        {
          "s": 3,
          "text": "נר הוי' נשמת אדם"
        },
        {
          "s": 4,
          "text": "[וז' הנרות דהמנורה הם ז' סוגי בני ישראל בעבודת ה',"
        },
        {
          "s": 5,
          "text": "יש עובד מאהבה משוך כמים"
        },
        {
          "s": 6,
          "text": "(חסד)"
        },
        {
          "s": 7,
          "text": "ויש מאהבה כרשפי אש"
        },
        {
          "s": 8,
          "text": "(גבורה)"
        },
        {
          "s": 9,
          "text": "וכו']."
        },
        {
          "s": 10,
          "text": "ומבאר אדמו\"ר מהר\"ש במאמרו ד\"ה וידבר גו' בהעלותך את הנרות שנאמר לפני מאה שנה4,"
        },
        {
          "s": 11,
          "text": "דזה שהנשמות נקראים נרות הוא כמאמר רז\"ל5"
        },
        {
          "s": 12,
          "text": "אמר הקב\"ה לאדם נרי בידך ונרך בידי,"
        },
        {
          "s": 13,
          "text": "נרי בידך זו התורה דכתיב6"
        },
        {
          "s": 14,
          "text": "כי נר מצוה ותורה אור ונרך בידי זו הנפש דכתיב3"
        },
        {
          "s": 15,
          "text": "נר הוי' נשמת אדם,"
        },
        {
          "s": 16,
          "text": "אם שמרת את נרי אני משמר את נרך ואם כבית את נרי אני מכבה את נרך."
        },
        {
          "s": 17,
          "text": "וצריך להבין,"
        },
        {
          "s": 18,
          "text": "הרי זה שהנשמות נק' נרות הוא מפורש בקרא"
        },
        {
          "s": 19,
          "text": "(נר הוי' נשמת אדם),"
        },
        {
          "s": 20,
          "text": "ולמה מביא בהמאמר את דברי המדרש נרי בידך ונרך בידי."
        },
        {
          "s": 21,
          "text": "גם צריך להבין,"
        },
        {
          "s": 22,
          "text": "דבפסוק נאמר נר הוי' נשמת אדם,"
        },
        {
          "s": 23,
          "text": "שהנשמה היא נר הוי',"
        },
        {
          "s": 24,
          "text": "ובמדרש הנ\"ל אומר שהנשמה היא נרך"
        },
        {
          "s": 25,
          "text": "(דהאדם)"
        },
        {
          "s": 26,
          "text": "והתורה היא נרי."
        },
        {
          "s": 27,
          "text": "(דהקב\"ה)."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויש לבאר זה בהקדים המבואר בכ\"מ7"
        },
        {
          "s": 2,
          "text": "דענין בהעלותך את הנרות הוא שאהרן מעורר את הנשמות שיהי' בהם הרצון לעלות למעלה,"
        },
        {
          "s": 3,
          "text": "ועד ליכלל בעצמות אוא\"ס."
        },
        {
          "s": 4,
          "text": "והגם דרצון זה הוא טבע דהנשמה,"
        },
        {
          "s": 5,
          "text": "וכמבואר בתניא8,"
        },
        {
          "s": 6,
          "text": "דהטעם שהנשמות נקראים בשם נרות,"
        },
        {
          "s": 7,
          "text": "הוא,"
        },
        {
          "s": 8,
          "text": "כי כמו שהנר טבעו לעלות למעלה ולידבק בשרשו"
        },
        {
          "s": 9,
          "text": "(ביסוד האש הכללי שתחת9"
        },
        {
          "s": 10,
          "text": "גלגל הירח)"
        },
        {
          "s": 11,
          "text": "כן הנשמה היא בטבע הרצוא לעלות למעלה להכלל במקור חוצבה,"
        },
        {
          "s": 12,
          "text": "מ\"מ צריך שאהרן יעלה את הנרות"
        },
        {
          "s": 13,
          "text": "(הנשמות),"
        },
        {
          "s": 14,
          "text": "כי ע\"י ירידת הנשמה למטה והתלבשותה בגוף מתעלם טבע הרצוא שבה."
        },
        {
          "s": 15,
          "text": "וכמבואר בארוכה בהדרושים7,"
        },
        {
          "s": 16,
          "text": "דמהטעמים על זה שהנשמות דאצילות נקראים זרע אדם והנשמות דבי\"ע נקראים זרע בהמה10,"
        },
        {
          "s": 17,
          "text": "הוא,"
        },
        {
          "s": 18,
          "text": "כי הנשמות דאצילות,"
        },
        {
          "s": 19,
          "text": "גם בירידתם למטה,"
        },
        {
          "s": 20,
          "text": "טבע הרצוא והעלי' שבהם הוא בגילוי,"
        },
        {
          "s": 21,
          "text": "ולכן נקראים בשם אדם על שם רוח האדם העולה היא למעלה11,"
        },
        {
          "s": 22,
          "text": "והנשמות דבי\"ע"
        },
        {
          "s": 23,
          "text": "(שהם רוב הנשמות12),"
        },
        {
          "s": 24,
          "text": "כשהן יורדות למטה ומתלבשות בגוף,"
        },
        {
          "s": 25,
          "text": "הן נמשכות אחר הגוף ועניני עוה\"ז הגשמי,"
        },
        {
          "s": 26,
          "text": "ולכן נקראים בשם בהמה על שם רוח הבהמה היורדת היא למטה11."
        },
        {
          "s": 27,
          "text": "ועבודתו של אהרן היא לעורר ולגלות את טבע הרצוא והעלי' שישנו גם בנשמות דבי\"ע,"
        },
        {
          "s": 28,
          "text": "בהעלותך את הנרות,"
        },
        {
          "s": 29,
          "text": "שטבע העלי' שבהם יהי' בגילוי."
        }
      ]
    }
  ]
}