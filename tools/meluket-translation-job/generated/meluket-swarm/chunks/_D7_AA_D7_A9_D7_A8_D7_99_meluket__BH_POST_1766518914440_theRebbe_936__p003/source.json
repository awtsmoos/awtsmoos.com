{
  "globalIndex": 128,
  "owner": 28,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914440_theRebbe_936__p003",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914440_theRebbe_936__p003",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914440_theRebbe_936",
  "title": "מאמר תורה צוה תשכ\"ג",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה נוסף לשני ענינים הנ\"ל שבתורה"
        },
        {
          "s": 2,
          "text": "(ירושה דתורה,"
        },
        {
          "s": 3,
          "text": "והתקן עצמך ללמוד תורה),"
        },
        {
          "s": 4,
          "text": "נקראת התורה בשם מתנה24."
        },
        {
          "s": 5,
          "text": "כהנוסח דברכת התורה ונתן לנו את תורתו וחותמין נותן התורה,"
        },
        {
          "s": 6,
          "text": "וחג השבועות נקרא25"
        },
        {
          "s": 7,
          "text": "זמן מתן תורתנו."
        },
        {
          "s": 8,
          "text": "דענין המתנה שבתורה הוא למעלה גם מהענין דהתקן עצמך ללמוד תורה."
        },
        {
          "s": 9,
          "text": "והענין הוא26,"
        },
        {
          "s": 10,
          "text": "דהחילוק בין טל ומטר הוא,"
        },
        {
          "s": 11,
          "text": "דירידת מטר תלוי' בעבודת האדם"
        },
        {
          "s": 12,
          "text": "(כמ\"ש27"
        },
        {
          "s": 13,
          "text": "והי' אם שמוע גו'"
        },
        {
          "s": 14,
          "text": "(ואז28)"
        },
        {
          "s": 15,
          "text": "ונתתי מטר ארצכם גו'),"
        },
        {
          "s": 16,
          "text": "וטל אינו תלוי בעבודת האדם"
        },
        {
          "s": 17,
          "text": "(כמארז\"ל29"
        },
        {
          "s": 18,
          "text": "טל לא מיעצר),"
        },
        {
          "s": 19,
          "text": "דכמו\"כ הוא ברוחניות,"
        },
        {
          "s": 20,
          "text": "דמטר היא ההמשכה שע\"י אתעדל\"ת וטל היא ההמשכה מלמעלה מצד עצמה."
        },
        {
          "s": 21,
          "text": "ומזה מובן,"
        },
        {
          "s": 22,
          "text": "דזה שנת\"ל דבחינת טל תורה היא המשכת התורה כמו שהיא למעלה ע\"י עסק התורה לשמה"
        },
        {
          "s": 23,
          "text": "(כל הקורא ושונה הקב\"ה קורא ושונה כנגדו),"
        },
        {
          "s": 24,
          "text": "הוא בכללות,"
        },
        {
          "s": 25,
          "text": "אבל בפרטיות,"
        },
        {
          "s": 26,
          "text": "גם המשכת התורה כמו שהיא למעלה,"
        },
        {
          "s": 27,
          "text": "הקב\"ה קורא ושונה,"
        },
        {
          "s": 28,
          "text": "כיון שההמשכה היא ע\"י שהאדם קורא ושונה,"
        },
        {
          "s": 29,
          "text": "נכללת בבחינת מטר דתורה,"
        },
        {
          "s": 30,
          "text": "ובחינת טל תורה היא דרגא נעלית יותר בתורה,"
        },
        {
          "s": 31,
          "text": "שאינה נמשכת ע\"י עסק התורה דהאדם"
        },
        {
          "s": 32,
          "text": "(גם לא ע\"י עסק התורה לשמה),"
        },
        {
          "s": 33,
          "text": "והמשכתה היא מצד עצמה."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "וזהו26 שאמרו רז\"ל30"
        },
        {
          "s": 1,
          "text": "ג' שעות ראשונות הקב\"ה יושב ועוסק בתורה,"
        },
        {
          "s": 2,
          "text": "וידוע הדיוק בזה,"
        },
        {
          "s": 3,
          "text": "הרי כל הקורא ושונה הקב\"ה קורא ושונה כנגדו,"
        },
        {
          "s": 4,
          "text": "וכיון שישראל עוסקים בתורה במשך כל היום"
        },
        {
          "s": 5,
          "text": "(זה לומד בשעה זו וזה לומד בשעה זו),"
        },
        {
          "s": 6,
          "text": "הרי גם הקב\"ה עוסק בתורה במשך כל היום,"
        },
        {
          "s": 7,
          "text": "ואעפ\"כ אמרו שבג' שעות ראשונות הקב\"ה יושב ועוסק בתורה."
        },
        {
          "s": 8,
          "text": "ונקודת הביאור בזה,"
        },
        {
          "s": 9,
          "text": "דזה שכל הקורא ושונה הקב\"ה קורא ושונה כנגדו היא המשכה מלמעלה שע\"י אתערותא דלתתא"
        },
        {
          "s": 10,
          "text": "(עסק התורה דהאדם),"
        },
        {
          "s": 11,
          "text": "ולכן,"
        },
        {
          "s": 12,
          "text": "ההמשכה היא לפי ערך האתערותא דלתתא."
        },
        {
          "s": 13,
          "text": "דזהו שאמרו כל הקורא ושונה הקב\"ה קורא ושונה כנגדו,"
        },
        {
          "s": 14,
          "text": "דזה שהקב\"ה קורא ושונה הוא כנגדו,"
        },
        {
          "s": 15,
          "text": "לפי ערך הלימוד דהאדם."
        },
        {
          "s": 16,
          "text": "וזה שבג' שעות ראשונות הקב\"ה יושב ועוסק בתורה הוא המשכה מלמעלה מצד עצמה,"
        },
        {
          "s": 17,
          "text": "ממקום שאין אתעדל\"ת מגעת לשם."
        },
        {
          "s": 18,
          "text": "וענין זה הוא בחינת טל דתורה,"
        },
        {
          "s": 19,
          "text": "כי שורש הטל הוא בג' ראשונות דעתיק."
        },
        {
          "s": 20,
          "text": "וזוהי השייכות דהקב\"ה יושב ועוסק בתורה"
        },
        {
          "s": 21,
          "text": "(טל תורה)"
        },
        {
          "s": 22,
          "text": "לג' שעות ראשונות,"
        },
        {
          "s": 23,
          "text": "כי ג'"
        },
        {
          "s": 24,
          "text": "[שעות]"
        },
        {
          "s": 25,
          "text": "ראשונות הם ג' ראשונות דעתיק."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ויש לבאר זה ע\"פ הידוע31"
        },
        {
          "s": 1,
          "text": "שגם בפנימיות התורה יש חיצוניות ופנימיות."
        },
        {
          "s": 2,
          "text": "דזה שפנימיות התורה מדברת בהענינים דהשתלשלות הוא הגליא שבה."
        },
        {
          "s": 3,
          "text": "[והוא ע\"ד נגלה דתורה שמדברת בעניני העולם."
        },
        {
          "s": 4,
          "text": "אלא שנגלה דתורה מדברת בענינים גשמיים,"
        },
        {
          "s": 5,
          "text": "ופנימיות התורה בענינים רוחניים]."
        },
        {
          "s": 6,
          "text": "ודרגא זו שבפנימיות התורה היא בבחינת השגה32."
        },
        {
          "s": 7,
          "text": "ועיקר הענין דפנימיות התורה הוא זה שהתורה היא התענוג דלמעלה,"
        },
        {
          "s": 8,
          "text": "תענוג שלמעלה מהשגה."
        },
        {
          "s": 9,
          "text": "ויש לומר,"
        },
        {
          "s": 10,
          "text": "שההמשכה דפנימיות התורה ע\"י עסק התורה לשמה,"
        },
        {
          "s": 11,
          "text": "שעל זה אמרו כל הקורא ושונה הקב\"ה קורא ושונה כנגדו"
        },
        {
          "s": 12,
          "text": "[הענין דהתקן עצמך ללמוד תורה],"
        },
        {
          "s": 13,
          "text": "הוא הגליא שבפנימיות התורה,"
        },
        {
          "s": 14,
          "text": "שמדברת בהענינים דהשתלשלות וכיו\"ב."
        },
        {
          "s": 15,
          "text": "וההמשכה דפנימיות התורה מצד עצמה,"
        },
        {
          "s": 16,
          "text": "שעל זה אמרו ג' שעות ראשונות הקב\"ה יושב ועוסק בתורה"
        },
        {
          "s": 17,
          "text": "[ענין המתנה דתורה33]"
        },
        {
          "s": 18,
          "text": "הוא בחי' תענוג דתורה שלמעלה מהשגה."
        }
      ]
    }
  ]
}