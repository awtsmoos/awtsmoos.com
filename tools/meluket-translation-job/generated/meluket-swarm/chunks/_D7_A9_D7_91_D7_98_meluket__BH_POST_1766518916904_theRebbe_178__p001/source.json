{
  "globalIndex": 549,
  "owner": 49,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916904_theRebbe_178__p001",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916904_theRebbe_178__p001",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916904_theRebbe_178",
  "title": "מאמר באתי לגני תשל\"ז",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "מוצש\"ק פ' בא,"
        },
        {
          "s": 2,
          "text": "יו\"ד שבט,"
        },
        {
          "s": 3,
          "text": "ה'תשל\"ז*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "באתי לגני אחותי כלה1,"
        },
        {
          "s": 1,
          "text": "ומביא ע\"ז כ\"ק מו\"ח אדמו\"ר בעל היאצ\"ט וההילולא במאמרו הידוע ליו\"ד שבט תש\"י,"
        },
        {
          "s": 2,
          "text": "דאיתא במדרש רבה2א"
        },
        {
          "s": 3,
          "text": "לגן אין כתיב כאן אלא לגני לגנוני,"
        },
        {
          "s": 4,
          "text": "למקום שהי' עיקרי"
        },
        {
          "s": 5,
          "text": "[היינו עיקר דירתו]"
        },
        {
          "s": 6,
          "text": "בתחילה,"
        },
        {
          "s": 7,
          "text": "ד"
        },
        {
          "s": 8,
          "text": "[בעת בריה\"ע]"
        },
        {
          "s": 9,
          "text": "עיקר שכינה בתחתונים הי',"
        },
        {
          "s": 10,
          "text": "וע\"י הענינים בלתי רצויים שהיו לאח\"ז נסתלקה השכינה מארץ לרקיע עד שנסתלקה לרקיע השביעי."
        },
        {
          "s": 11,
          "text": "ואח\"כ עמדו שבעה צדיקים והורידו את השכינה למטה,"
        },
        {
          "s": 12,
          "text": "החל מאברהם אבינו שהוריד את השכינה מרקיע ז' לו' עד כי משה שהוא השביעי,"
        },
        {
          "s": 13,
          "text": "וכל השביעין חביבין4,"
        },
        {
          "s": 14,
          "text": "הורידה למטה בארץ."
        },
        {
          "s": 15,
          "text": "וזהו כללות ענין עבודת הצדיקים,"
        },
        {
          "s": 16,
          "text": "ועמך כולם צדיקים5,"
        },
        {
          "s": 17,
          "text": "להמשיך השכינה למטה,"
        },
        {
          "s": 18,
          "text": "כמ\"ש6"
        },
        {
          "s": 19,
          "text": "צדיקים יירשו ארץ וישכנו לעד עלי',"
        },
        {
          "s": 20,
          "text": "דעבודת צדיקים היא וישכנו – להשכין,"
        },
        {
          "s": 21,
          "text": "לעד – השכינה,"
        },
        {
          "s": 22,
          "text": "בחינת שוכן עד מרום וקדוש,"
        },
        {
          "s": 23,
          "text": "עלי' – למטה בארץ."
        },
        {
          "s": 24,
          "text": "והמשכת השכינה למטה שע\"י משה היתה במעשה המשכןב,"
        },
        {
          "s": 25,
          "text": "דענינו הוא מ\"ש7"
        },
        {
          "s": 26,
          "text": "ועשו לי מקדש ושכנתי בתוכם,"
        },
        {
          "s": 27,
          "text": "שבו וע\"י הי' המשכת השכינהג."
        },
        {
          "s": 28,
          "text": "והנה התחלת המשכן הי' בהקרשים12,"
        },
        {
          "s": 29,
          "text": "שעשו אותם מעצי שיטים,"
        },
        {
          "s": 30,
          "text": "וכמ\"ש13"
        },
        {
          "s": 31,
          "text": "ועשית את הקרשים למשכן עצי שיטים עומדים."
        },
        {
          "s": 32,
          "text": "והענין בזה הוא"
        },
        {
          "s": 33,
          "text": "[כמו שמבאר בהמאמר שם14"
        },
        {
          "s": 34,
          "text": "ע\"פ הגמרא15"
        },
        {
          "s": 35,
          "text": "והמדרש16]"
        },
        {
          "s": 36,
          "text": "דשיטים הוא מלשון שטות,"
        },
        {
          "s": 37,
          "text": "והוא השטות דלעו\"ז,"
        },
        {
          "s": 38,
          "text": "כמארז\"ל17"
        },
        {
          "s": 39,
          "text": "אין אדם עובר עבירה אא\"כ נכנס בו רוח שטות,"
        },
        {
          "s": 40,
          "text": "והעבודה היא להפוך ע\"י אתכפיא ואתהפכא את השטות דלעו\"ז לשטות דקדושה"
        },
        {
          "s": 41,
          "text": "[כמאמר18"
        },
        {
          "s": 42,
          "text": "אהני לי' שטותי' לסבא]."
        },
        {
          "s": 43,
          "text": "וזהו מה שהקרשים היו מעצי שיטים,"
        },
        {
          "s": 44,
          "text": "שע\"י עבודת האדם עושים מהשטות דלעו\"ז"
        },
        {
          "s": 45,
          "text": "(שיטים)"
        },
        {
          "s": 46,
          "text": "קרשים למשכן."
        },
        {
          "s": 47,
          "text": "וזהו ג\"כ השם קרשים,"
        },
        {
          "s": 48,
          "text": "דקרש הוא אותיות שקר,"
        },
        {
          "s": 49,
          "text": "אלא שבצירוף אחר,"
        },
        {
          "s": 50,
          "text": "והיינו שענינם הוא שמשקר העולם עושים קרש למשכן,"
        },
        {
          "s": 51,
          "text": "ועי\"ז מקימים"
        },
        {
          "s": 52,
          "text": "(שטעלט מען אויף)"
        },
        {
          "s": 53,
          "text": "את המשכן."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "וממשיך ד"
        },
        {
          "s": 2,
          "text": "בהמאמר שם23"
        },
        {
          "s": 3,
          "text": "דהנה בהקדמת הזהר בענין האותיות דאעלו קמי קוב\"ה למברי' בהו עלמא כו' איתא דאות ק' ר' אתוון דאתחזיאו על סטרא בישא אינון,"
        },
        {
          "s": 4,
          "text": "ובגין לאתקיימא נטלי אות ש' בגווייהו כו',"
        },
        {
          "s": 5,
          "text": "דהאות ש' את קשוט איהו"
        },
        {
          "s": 6,
          "text": "(כמ\"ש לעיל בזהר שם)."
        },
        {
          "s": 7,
          "text": "והטעם שהיו צריכים לאות של אמת הוא משום דשקר אין לו רגלים כו'."
        },
        {
          "s": 8,
          "text": "והעבודה היא לעשות משקר זה"
        },
        {
          "s": 9,
          "text": "(דאות ק' ור')"
        },
        {
          "s": 10,
          "text": "קרשים למשכן,"
        },
        {
          "s": 11,
          "text": "והוא ע\"י הלעו\"ז דאותיות אלו."
        },
        {
          "s": 12,
          "text": "דאת זה לעו\"ז עשה האלקים24,"
        },
        {
          "s": 13,
          "text": "ובדוגמא לאות רי\"ש"
        },
        {
          "s": 14,
          "text": "(אות דשיקרא)"
        },
        {
          "s": 15,
          "text": "בלעו\"ז,"
        },
        {
          "s": 16,
          "text": "הנה ישנה אות דלי\"ת בקדושה."
        },
        {
          "s": 17,
          "text": "דאע\"פ דד' ור' הם שוים בפירושם,"
        },
        {
          "s": 18,
          "text": "דד' הוא מלשון דלות ועניות וכן אות רי\"ש הוא מלשון עניות ודלות,"
        },
        {
          "s": 19,
          "text": "מ\"מ ה\"ה מובדלים ומחולקים בעניניהם ועד שהחילוק ביניהם הוא חילוק עיקרי."
        },
        {
          "s": 20,
          "text": "וכמובן ממה דאיתא במדרש25"
        },
        {
          "s": 21,
          "text": "בהזהירות שצ\"ל שלא להחליף ד' בר' ור' בד',"
        },
        {
          "s": 22,
          "text": "ובאותיות אלו הוא החילוק שבין הוי' אחד להענין דאל אחר"
        },
        {
          "s": 23,
          "text": "[ובשני הכתובים הד' ור' הם באות רבתי],"
        },
        {
          "s": 24,
          "text": "וכאשר יחליף רי\"ש במקום הדלי\"ת ודלי\"ת במקום הרי\"ש הרי זה מחריב עולמות."
        },
        {
          "s": 25,
          "text": "שמזה מובן שהחילוק שביניהם הוא מן הקצה אל הקצה."
        },
        {
          "s": 26,
          "text": "והחילוק שביניהם בציורם הוא"
        },
        {
          "s": 27,
          "text": "[כמו שמבאר בסעיף השביעיה]"
        },
        {
          "s": 28,
          "text": "שבאות ד' יש יו\"ד זעירא"
        },
        {
          "s": 29,
          "text": "[בחינת נקודה]"
        },
        {
          "s": 30,
          "text": "מאחוריו,"
        },
        {
          "s": 31,
          "text": "משא\"כ באות ר',"
        },
        {
          "s": 32,
          "text": "וע\"י יו\"ד זה הנה במקום רי\"ש,"
        },
        {
          "s": 33,
          "text": "שהו\"ע העניות והדלות דלעו\"ז,"
        },
        {
          "s": 34,
          "text": "נעשה אות ד' דקדושה"
        },
        {
          "s": 35,
          "text": "(ע\"כ מתוכן ס\"ז שם)."
        },
        {
          "s": 36,
          "text": "ואע\"פ שגם דלי\"ת הוא מלשון דלות ועניות"
        },
        {
          "s": 37,
          "text": "(כנ\"ל),"
        },
        {
          "s": 38,
          "text": "אי\"ז כלל ענין העניות דרי\"ש דלעו\"ז,"
        },
        {
          "s": 39,
          "text": "כי ענין הדלות דקדושה מורה על ענין הביטול דקדושה,"
        },
        {
          "s": 40,
          "text": "וכמ\"ש ונפשי כעפר לכל תהי',"
        },
        {
          "s": 41,
          "text": "כי עני ואביון אני גו'26,"
        },
        {
          "s": 42,
          "text": "שזהו ענין הדלות מצד הביטול שבקדושה"
        },
        {
          "s": 43,
          "text": "[וכמבואר בארוכה בסעיף הקודם27"
        },
        {
          "s": 44,
          "text": "האופנים ומדריגות דביטול,"
        },
        {
          "s": 45,
          "text": "עד להביטול דאזעירת גרמה28"
        },
        {
          "s": 46,
          "text": "וסיהרא לית לה מגרמה כלום29"
        },
        {
          "s": 47,
          "text": "– דביטול זה דלית לה מגרמה כלום הוא ביטול בתכלית ובשלימות,"
        },
        {
          "s": 48,
          "text": "יותר גם מהביטול דאזעירת גרמה."
        },
        {
          "s": 49,
          "text": "דבאזעירת גרמה הרי עדיין ישנה מציאות,"
        },
        {
          "s": 50,
          "text": "אלא שהמציאות היא בבחינת זעיר,"
        },
        {
          "s": 51,
          "text": "משא\"כ בלית לה מגרמה כלום,"
        },
        {
          "s": 52,
          "text": "שאין לה מציאות כלל"
        },
        {
          "s": 53,
          "text": "(גם לא באופן דזעיר)"
        },
        {
          "s": 54,
          "text": "והוא בתכלית הביטול]"
        },
        {
          "s": 55,
          "text": "משא\"כ העניות והדלות שבלעו\"ז שענינה הוא כמ\"ש30"
        },
        {
          "s": 56,
          "text": "ולרש אין כל."
        },
        {
          "s": 57,
          "text": "וממשיך לבאר בהמאמר31"
        },
        {
          "s": 58,
          "text": "ענין היו\"ד שמאחורי הדלי\"ת"
        },
        {
          "s": 59,
          "text": "(שע\"י מחולק מהרי\"ש דלעו\"ז,"
        },
        {
          "s": 60,
          "text": "שאין בה יו\"ד)"
        },
        {
          "s": 61,
          "text": "דאם שהוא אות זעירא מכל האותיות הנה הוא ראש לכל האותיות,"
        },
        {
          "s": 62,
          "text": "דכל אות הרי תחלתו אות יו\"ד והוא מה"
        },
        {
          "s": 63,
          "text": "[דאיתא בגמרא מנחות32]"
        },
        {
          "s": 64,
          "text": "שביו\"ד נברא העוה\"ב"
        },
        {
          "s": 65,
          "text": "[ומזה נמשך אח\"כ בספירת היסוד"
        },
        {
          "s": 66,
          "text": "(כפי שיתבאר לקמן)]"
        },
        {
          "s": 67,
          "text": "דעל זה אומר33"
        },
        {
          "s": 68,
          "text": "כי כל בשמים ובארץ ותרגם דאחיד בשמיא ובארעא,"
        },
        {
          "s": 69,
          "text": "שהיא ספירת היסוד שבחינת המלכות מקבלת ממנה כו'"
        },
        {
          "s": 70,
          "text": "(ע\"כ מהמאמר שם)."
        }
      ]
    }
  ]
}