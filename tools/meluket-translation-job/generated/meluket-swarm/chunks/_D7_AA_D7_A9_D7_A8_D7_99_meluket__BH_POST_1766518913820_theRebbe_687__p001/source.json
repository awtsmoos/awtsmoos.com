{
  "globalIndex": 22,
  "owner": 22,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913820_theRebbe_687__p001",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913820_theRebbe_687__p001",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518913820_theRebbe_687",
  "title": "מאמר זה היום תחילת מעשיך תשמ\"א",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "יום ב' דראש השנה ה'תשמ\"א*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "זה היום תחלת מעשיך זכרון ליום ראשון1,"
        },
        {
          "s": 1,
          "text": "וידוע דהיום"
        },
        {
          "s": 2,
          "text": "(סתם)"
        },
        {
          "s": 3,
          "text": "קאי על ראש השנה2,"
        },
        {
          "s": 4,
          "text": "ופירוש זה היום הוא שבהיום דראש השנה נמשכת בחי' זה3,"
        },
        {
          "s": 5,
          "text": "דבראש השנה מכתירים בני ישראל את הקב\"ה למלך4"
        },
        {
          "s": 6,
          "text": "ופועלים ועושים גילוי מלכותו ית' בכל העולם,"
        },
        {
          "s": 7,
          "text": "עד אשר וידע כל פעול כי אתה פעלתו5,"
        },
        {
          "s": 8,
          "text": "שגם בחי' פעול שבעשי'6"
        },
        {
          "s": 9,
          "text": "(ומכ\"ש דיצירה ודבריאה)"
        },
        {
          "s": 10,
          "text": "ידע כי אתה פעלתו."
        },
        {
          "s": 11,
          "text": "וזהו זה היום,"
        },
        {
          "s": 12,
          "text": "דבראש השנה נמשך אלקות בגילוי ממש,"
        },
        {
          "s": 13,
          "text": "ועד ד\"זה\","
        },
        {
          "s": 14,
          "text": "כאו\"א מראה באצבעו ואומר זה7."
        },
        {
          "s": 15,
          "text": "וי\"ל דזהו גם הביאור שאומרים על היום דראש השנה זה היום תחלת מעשיך,"
        },
        {
          "s": 16,
          "text": "דידוע הדיוק בזה מכ\"ק אדמו\"ר הזקן וכ\"ק אדמו\"ר האמצעי וכ\"ק אדמו\"ר הצ\"צ וכ\"ק אדמו\"ר מהר\"ש וכ\"ק אדמו\"ר"
        },
        {
          "s": 17,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 18,
          "text": "נ\"ע וכ\"ק מו\"ח אדמו\"ר נשיא דורנו,"
        },
        {
          "s": 19,
          "text": "שהרי בכ\"ה באלול נברא העולם8"
        },
        {
          "s": 20,
          "text": "וראש השנה הוא יום ברוא אדם הראשון שהוא יום וא\"ו למע\"ב9,"
        },
        {
          "s": 21,
          "text": "ואיך אומרים על יום זה שהוא תחלת מעשיך."
        },
        {
          "s": 22,
          "text": "וגם למה ראש השנה הוא באחד בתשרי ולא בכ\"ה באלול."
        },
        {
          "s": 23,
          "text": "ועוד שבראש השנה כל באי עולם יעברון לפניך כבני מרון10,"
        },
        {
          "s": 24,
          "text": "לא רק סוג המדבר אלא גם הנבראים דסוג החי,"
        },
        {
          "s": 25,
          "text": "דסוג הצומח ודסוג הדומם,"
        },
        {
          "s": 26,
          "text": "ולמה ראש השנה הוא ביום ברוא האדם דוקא."
        },
        {
          "s": 27,
          "text": "והביאור בזה,"
        },
        {
          "s": 28,
          "text": "דתכלית הכוונה בבריאת העולם הוא שהאדם ע\"י עבודתו ימשיך גילוי אלקות בעולם,"
        },
        {
          "s": 29,
          "text": "גילוי עד ד\"זה\""
        },
        {
          "s": 30,
          "text": "(כאו\"א מראה באצבעו ואומר זה),"
        },
        {
          "s": 31,
          "text": "וענין זה נתחדש ונעשה ביום ברוא האדם,"
        },
        {
          "s": 32,
          "text": "דבריאת העולם בכ\"ה באלול היתה בבחי' כה,"
        },
        {
          "s": 33,
          "text": "וביום ברוא אדם הראשון"
        },
        {
          "s": 34,
          "text": "(ע\"י עבודתו)"
        },
        {
          "s": 35,
          "text": "נתחדש ונעשה גילוי אלקות,"
        },
        {
          "s": 36,
          "text": "בבחי' זה11."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "וביאור ענין העילוי שנתחדש ונעשה ביום ברוא אדם הראשון יובן בהקדים מעלת דרגת העולם כמו שנברא ביום הראשון דמעשה בראשית"
        },
        {
          "s": 2,
          "text": "(בכ\"ה באלול),"
        },
        {
          "s": 3,
          "text": "שאז הי' העולם בדרגא נעלית"
        },
        {
          "s": 4,
          "text": "(כדלקמן),"
        },
        {
          "s": 5,
          "text": "שמזה יובן גודל העילוי שנתחדש ונעשה בהעולם ביום ברוא אדם הראשון."
        },
        {
          "s": 6,
          "text": "וי\"ל שזהו הטעם שבכו\"כ דרושי רבותינו נשיאינו דראש השנה"
        },
        {
          "s": 7,
          "text": "(שמבואר בהם הטעם על זה שראש השנה הוא בא' בתשרי)"
        },
        {
          "s": 8,
          "text": "מבוארת בהם המעלה דכ\"ה באלול,"
        },
        {
          "s": 9,
          "text": "כי ע\"י הביאור במעלת כ\"ה באלול מובן יותר גודל העילוי דראש השנה."
        }
      ]
    }
  ]
}