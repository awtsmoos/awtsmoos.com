{
  "globalIndex": 784,
  "owner": 34,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918408_theRebbe_266__p003",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918408_theRebbe_266__p003",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918408_theRebbe_266",
  "title": "מאמר ונקדשתי תשכ\"ה",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 1,
          "text": "דמ\"ש הצ\"צ שזה תמוה,"
        },
        {
          "s": 2,
          "text": "הכוונה בזה היא,"
        },
        {
          "s": 3,
          "text": "שאין לזה מקום בשכל,"
        },
        {
          "s": 4,
          "text": "גם לא בחכמה שלמעלה."
        },
        {
          "s": 5,
          "text": "דכיון שע\"פ סדר ההשתלשלות"
        },
        {
          "s": 6,
          "text": "[שנקבע כפי שגזרה חכמתו ית']"
        },
        {
          "s": 7,
          "text": "נברא הוא באין ערוך לבורא,"
        },
        {
          "s": 8,
          "text": "אין שייך אפילו קס\"ד שיהיו כמוני."
        },
        {
          "s": 9,
          "text": "אבל לגבי עצמות אוא\"ס אין שייך שום גדרים,"
        },
        {
          "s": 10,
          "text": "דמי יאמר לו מה תעשה21."
        },
        {
          "s": 11,
          "text": "וכיון שע\"י התשובה מגיעים בעצמות אוא\"ס שלמעלה מחכמה"
        },
        {
          "s": 12,
          "text": "[כידוע בענין שאלו לתורה כו' שאלו להקב\"ה כו' אמר יעשה תשובה ויתכפר לו22,"
        },
        {
          "s": 13,
          "text": "דהמענה יעשה תשובה כו' בא דוקא מהקב\"ה שלמעלה מחכמה דתורה],"
        },
        {
          "s": 14,
          "text": "לכן,"
        },
        {
          "s": 15,
          "text": "ע\"י התשובה,"
        },
        {
          "s": 16,
          "text": "יכול כמוני."
        },
        {
          "s": 17,
          "text": "ועפ\"ז יומתק מה שמפשטות לשון הכתוב קדושים תהיו כי קדוש אני"
        },
        {
          "s": 18,
          "text": "(שקדוש אני הוא הטעם וההסברה על קדושים תהיו)"
        },
        {
          "s": 19,
          "text": "משמע שהציווי קדושים תהיו הוא שקדושתם של ישראל צריכה להיות בדומה לקדושתו ית',"
        },
        {
          "s": 20,
          "text": "כי ע\"י עבודת התשובה מגיעים לקדושה זו."
        },
        {
          "s": 21,
          "text": "ולהעיר מהפירוש23"
        },
        {
          "s": 22,
          "text": "ביכול כמוני – יכול כמוני בניחותא."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "דשני הביאורים בנוגע להפסוקים שבהם נרמזים שתי העטרות שנתן בראש בניו"
        },
        {
          "s": 3,
          "text": "(אם נכלל בזה גם הפסוק קדושים תהיו)"
        },
        {
          "s": 4,
          "text": "ושני הפירושים ביכול כמוני,"
        },
        {
          "s": 5,
          "text": "תלויים זה בזה."
        },
        {
          "s": 6,
          "text": "דלהפירוש שיכול כמוני הוא בלשון תמי' – הקדושה דקדושים תהיו נכללת בקדושתכם שלמטה מקדושתי,"
        },
        {
          "s": 7,
          "text": "ולכן,"
        },
        {
          "s": 8,
          "text": "קדושים תהיו הוא בכלל העטרות שנתן בראש בניו,"
        },
        {
          "s": 9,
          "text": "ולהפירוש יכול כמוני בניחותא – הקדושה דקדושים תהיו היא הקדושה דקדוש אני"
        },
        {
          "s": 10,
          "text": "(שהיא העטרה שנטל לעצמו),"
        },
        {
          "s": 11,
          "text": "ושתי העטרות שנתן בראש בניו הם והתקדישתם והייתם קדושים."
        },
        {
          "s": 12,
          "text": "ומ\"ש במדרש שהקדושה דקדוש אני היא העטרה שנטל לעצמו,"
        },
        {
          "s": 13,
          "text": "אף שגם קדושה זו נמשכת לישראל,"
        },
        {
          "s": 14,
          "text": "יש לומר,"
        },
        {
          "s": 15,
          "text": "כי המשכת הקדושה דקדוש אני בבעלי תשובה היא"
        },
        {
          "s": 16,
          "text": "(לא מצד המציאות שלהם24"
        },
        {
          "s": 17,
          "text": "אלא)"
        },
        {
          "s": 18,
          "text": "לפי שע\"י התשובה מתגלה שרש הנשמה שהוא חד עם העצמות,"
        },
        {
          "s": 19,
          "text": "ונמצא,"
        },
        {
          "s": 20,
          "text": "דגם לאחרי שהעטרה ישנה בישראל,"
        },
        {
          "s": 21,
          "text": "היא בראשו של המלך"
        },
        {
          "s": 22,
          "text": "(ולא ניתנה לאחר,"
        },
        {
          "s": 23,
          "text": "גם לא לבניו)."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "דזה שענין ההמשכה דקדושתי שלמעלה מקדושתכם מבואר להדיא בהדרושים דפרשת נצבים משא\"כ בהדרושים דפרשתנו בא ענין זה רק ברמז"
        },
        {
          "s": 3,
          "text": "(ומ\"ש להדיא בדרושים אלה הוא שהגילוי דקדוש הא' באדם הוא באופן דהעלאה מלמטה למעלה,"
        },
        {
          "s": 4,
          "text": "שרוצה לצאת ממציאותו וליכלל בקדוש),"
        },
        {
          "s": 5,
          "text": "הוא,"
        },
        {
          "s": 6,
          "text": "כי בפרשת אתם נצבים היום,"
        },
        {
          "s": 7,
          "text": "שקורין קודם ר\"ה25,"
        },
        {
          "s": 8,
          "text": "הוא זמן התשובה."
        },
        {
          "s": 9,
          "text": "ובפרט להמבואר בלקו\"ת26"
        },
        {
          "s": 10,
          "text": "שהתשובה דאתם נצבים היום כולכם לפני הוי' גו' הוא שכל הנשמות מתעלות למעלה במקור חוצבם."
        },
        {
          "s": 11,
          "text": "ולכן בהדרושים דפ' נצבים מבואר להדיא ההמשכה דקדושתי שלמעלה מקדושתכם27,"
        },
        {
          "s": 12,
          "text": "כי ע\"י שנש\"י מתעלות למקור חוצבם נמשך להם גם העטרה שנטל לעצמו"
        },
        {
          "s": 13,
          "text": "(כנ\"ל סעיף ה)."
        },
        {
          "s": 14,
          "text": "ובהדרושים דהפרשיות שקורין בימי ספירת העומר,"
        },
        {
          "s": 15,
          "text": "שהעבודה דספירת העומר היא"
        },
        {
          "s": 16,
          "text": "(לא באופן דדילוג"
        },
        {
          "s": 17,
          "text": "(תשובה28)"
        },
        {
          "s": 18,
          "text": "אלא אדרבא)"
        },
        {
          "s": 19,
          "text": "בסדר והדרגה"
        },
        {
          "s": 20,
          "text": "(יום אחד,"
        },
        {
          "s": 21,
          "text": "שני ימים,"
        },
        {
          "s": 22,
          "text": "וכו'),"
        },
        {
          "s": 23,
          "text": "בא ענין זה דהמשכת קדושתי שלמעלה מקדושתכם רק ברמז."
        },
        {
          "s": 24,
          "text": "ויש לומר,"
        },
        {
          "s": 25,
          "text": "דזה שמובא בדרושים אלה ענין זה ברמז עכ\"פ,"
        },
        {
          "s": 26,
          "text": "הוא,"
        },
        {
          "s": 27,
          "text": "כי ספירת העומר הו\"ע בירור נפש הבהמית29,"
        },
        {
          "s": 28,
          "text": "ובירור נפש הבהמית הוא כענין התשובה30."
        },
        {
          "s": 29,
          "text": "ויש להוסיף,"
        },
        {
          "s": 30,
          "text": "דפרשת אמור קורין ברוב השנים בהשבת שבסמיכות לפסח שני,"
        },
        {
          "s": 31,
          "text": "דפסח שני הו\"ע התשובה."
        },
        {
          "s": 32,
          "text": "וכמבואר בארוכה במק\"א31"
        },
        {
          "s": 33,
          "text": "דפסח ראשון הו\"ע עבודת הצדיקים ופסח שני הו\"ע עבודת התשובה."
        },
        {
          "s": 34,
          "text": "ולכן גם בהדרושים דפרשת אמור מרומז הענין דהמשכת קדושתי שלמעלה מקדושתכם,"
        },
        {
          "s": 35,
          "text": "יכול כמוני בניחותא."
        }
      ]
    }
  ]
}