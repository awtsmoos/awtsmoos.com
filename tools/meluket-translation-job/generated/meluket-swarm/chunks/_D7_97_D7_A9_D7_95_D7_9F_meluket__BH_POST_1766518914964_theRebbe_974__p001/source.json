{
  "globalIndex": 199,
  "owner": 49,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914964_theRebbe_974__p001",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914964_theRebbe_974__p001",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518914964_theRebbe_974",
  "title": "מאמר ויהיו חיי שרה תשמ\"ה",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "אור ליום ה' פ' חיי שרה,"
        },
        {
          "s": 2,
          "text": "כ\"ף מרחשון ה'תשמ\"ה"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "ויהיו חיי שרה מאה שנה ועשרים שנה ושבע שנים שני חיי שרה1,"
        },
        {
          "s": 1,
          "text": "ומדייק אדמו\"ר"
        },
        {
          "s": 2,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 3,
          "text": "נ\"ע בעל יום ההולדת במאמרו ד\"ה זה דשנת עטר\"ת2,"
        },
        {
          "s": 4,
          "text": "הרי כבר נאמר ויהיו חיי שרה"
        },
        {
          "s": 5,
          "text": "[ומפרט שנותי' במאות עשיריות ואחדות],"
        },
        {
          "s": 6,
          "text": "ומה מוסיף שני חיי שרה."
        },
        {
          "s": 7,
          "text": "ומבאר זה ע\"פ מה דאיתא בזהר3"
        },
        {
          "s": 8,
          "text": "דהטעם על זה שבשרה דוקא נאמר ימי שני חיי' שלא נאמר בשאר אמהות4,"
        },
        {
          "s": 9,
          "text": "הוא,"
        },
        {
          "s": 10,
          "text": "כי שרה נחתת"
        },
        {
          "s": 11,
          "text": "(למצרים)"
        },
        {
          "s": 12,
          "text": "וסלקת כד\"א5"
        },
        {
          "s": 13,
          "text": "ויעל אברם ממצרים הוא ואשתו,"
        },
        {
          "s": 14,
          "text": "ובגין כך זכתה לחיין עילאין."
        },
        {
          "s": 15,
          "text": "ומסיים"
        },
        {
          "s": 16,
          "text": "(בזהר שם)"
        },
        {
          "s": 17,
          "text": "ועל דא דילה הוו חיין."
        },
        {
          "s": 18,
          "text": "ועפ\"ז מבאר בהמאמר6"
        },
        {
          "s": 19,
          "text": "מה שכפל עוד פעם לומר שני חיי שרה,"
        },
        {
          "s": 20,
          "text": "כי ויהיו חיי שרה הוא שזכתה לחיין עילאין,"
        },
        {
          "s": 21,
          "text": "ושני חיי שרה הוא שהחיין נעשו שלה,"
        },
        {
          "s": 22,
          "text": "דילה הוו"
        },
        {
          "s": 23,
          "text": "[וכמבואר בהמאמר7"
        },
        {
          "s": 24,
          "text": "החילוק דשני הענינים]."
        },
        {
          "s": 25,
          "text": "וצריך להבין הקשר והשייכות דפירוש המאמר ששני חיי שרה הוא שהחיין נעשו שלה,"
        },
        {
          "s": 26,
          "text": "עם פירוש רש\"י8"
        },
        {
          "s": 27,
          "text": "עה\"פ ששני חיי שרה הוא שכולן שוין לטובה."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים דכל הסיפורים שבתורה"
        },
        {
          "s": 2,
          "text": "(מלשון הוראה9)"
        },
        {
          "s": 3,
          "text": "הם הוראות לכאו\"א מישראל."
        },
        {
          "s": 4,
          "text": "ובפרט מעשה אבות"
        },
        {
          "s": 5,
          "text": "[ואמהות]"
        },
        {
          "s": 6,
          "text": "שהם סימן ונתינת כח לבנים10."
        },
        {
          "s": 7,
          "text": "דכיון שהם האבות"
        },
        {
          "s": 8,
          "text": "[והאמהות]"
        },
        {
          "s": 9,
          "text": "של כל אחד מישראל,"
        },
        {
          "s": 10,
          "text": "לכן הענינים והעבודות שלהם נמשכים בירושה לכל אחד מישראל11."
        },
        {
          "s": 11,
          "text": "ועפ\"ז,"
        },
        {
          "s": 12,
          "text": "זה שהתורה מספרת שכל שני חיי שרה הם שוין לטובה הוא הוראה ונתינת כח לכל אחד מישראל שכל שנותיו יהיו שוים לטובה."
        },
        {
          "s": 13,
          "text": "וצריך ביאור,"
        },
        {
          "s": 14,
          "text": "דהוראה לאדם שייכת"
        },
        {
          "s": 15,
          "text": "(לכאורה)"
        },
        {
          "s": 16,
          "text": "בנוגע לההוה והעתיד ולא בנוגע להעבר,"
        },
        {
          "s": 17,
          "text": "וכיון שידע אינש בנפשי' מעמדו ומצבו בעבר,"
        },
        {
          "s": 18,
          "text": "ומאי עביד באורתא12"
        },
        {
          "s": 19,
          "text": "ובהימים שלפנ\"ז"
        },
        {
          "s": 20,
          "text": "[ואפילו הענינים שעשה בשוגג,"
        },
        {
          "s": 21,
          "text": "הם מהתגברות נפש הבהמית13],"
        },
        {
          "s": 22,
          "text": "איך שייך לומר לו הוראה שכל שנותיו"
        },
        {
          "s": 23,
          "text": "(גם שנותיו שבעבר)"
        },
        {
          "s": 24,
          "text": "יהיו שוין לטובה."
        }
      ]
    }
  ]
}