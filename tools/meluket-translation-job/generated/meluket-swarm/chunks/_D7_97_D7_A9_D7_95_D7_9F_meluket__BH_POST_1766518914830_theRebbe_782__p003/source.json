{
  "globalIndex": 180,
  "owner": 30,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914830_theRebbe_782__p003",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914830_theRebbe_782__p003",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518914830_theRebbe_782",
  "title": "מאמר וה' אמר המכסה אני מאברהם תשל\"ז",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה העילוי שבבירור והעלאת התחתון,"
        },
        {
          "s": 2,
          "text": "מובן מהמאמר"
        },
        {
          "s": 3,
          "text": "(ד\"ה זכור הנ\"ל)"
        },
        {
          "s": 4,
          "text": "שיש בזה ב' ענינים."
        },
        {
          "s": 5,
          "text": "א' שזה נוגע לההמשכה שלמעלה."
        },
        {
          "s": 6,
          "text": "וכמ\"ש במאמר הנ\"ל26"
        },
        {
          "s": 7,
          "text": "דכמו שבדרך כפשוטו באם א\"א לילך בו בחזרה אזי אינו נקרא דרך"
        },
        {
          "s": 8,
          "text": "(לא רק לגבי המקום שבא לשם,"
        },
        {
          "s": 9,
          "text": "אלא)"
        },
        {
          "s": 10,
          "text": "גם לגבי המקום שהלך משם,"
        },
        {
          "s": 11,
          "text": "דכשלא ישנה העלי'"
        },
        {
          "s": 12,
          "text": "(שהתחתון אינו כלי לההמשכה),"
        },
        {
          "s": 13,
          "text": "אין ההמשכה אמיתית."
        },
        {
          "s": 14,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 15,
          "text": "דאמיתית ענין ושלימות ההמשכה"
        },
        {
          "s": 16,
          "text": "(שאין בה הגבלה)"
        },
        {
          "s": 17,
          "text": "היא,"
        },
        {
          "s": 18,
          "text": "דלא רק שהיא נמשכת בכל מקום גם במקום הכי תחתון,"
        },
        {
          "s": 19,
          "text": "אלא שהיא נמשכת וחודרת בכל חלקי המקום עד שמתעצמת עמו."
        },
        {
          "s": 20,
          "text": "שזה"
        },
        {
          "s": 21,
          "text": "(ההתעצמות)"
        },
        {
          "s": 22,
          "text": "הוא דוקא כשהתחתון הוא כלי להגילוי."
        },
        {
          "s": 23,
          "text": "דהגם שמצד למעלה אפשר להיות ההמשכה גם בתחתון שאינו כלי,"
        },
        {
          "s": 24,
          "text": "דמי35"
        },
        {
          "s": 25,
          "text": "יאמר לו מה תעשה36,"
        },
        {
          "s": 26,
          "text": "הרי בנוגע להתחתון,"
        },
        {
          "s": 27,
          "text": "מכיון שמצדו אינו כלי ראוי לההמשכה,"
        },
        {
          "s": 28,
          "text": "אינו מתעצם עם האור37,"
        },
        {
          "s": 29,
          "text": "ובמילא חסר גם בההמשכה כנ\"ל."
        },
        {
          "s": 30,
          "text": "ועוד ענין בבירור והעלאת התחתון38,"
        },
        {
          "s": 31,
          "text": "ובפרט כשהבירור הוא באופן דאתכפיא,"
        },
        {
          "s": 32,
          "text": "שזה דוקא מגיע בהעצמות."
        },
        {
          "s": 33,
          "text": "וזהו\"ע מעשה גדול39,"
        },
        {
          "s": 34,
          "text": "כי מעשה מלשון כפי'"
        },
        {
          "s": 35,
          "text": "(בירור התחתון)"
        },
        {
          "s": 36,
          "text": "מגיע בהעלם העצמי40"
        },
        {
          "s": 37,
          "text": "שלמעלה מכל ההמשכות והגילויים41."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יש לבאר תוכן הפנימי של החילוקים דהמאמרים דש\"פ וירא בהמשך תרס\"ו."
        },
        {
          "s": 2,
          "text": "דבמאמר הראשון מבאר ענין המצוות,"
        },
        {
          "s": 3,
          "text": "זה שע\"י קיום המצוות נמשכים ענינים הכי נעלים,"
        },
        {
          "s": 4,
          "text": "רצון עצמי ותענוג עצמי."
        },
        {
          "s": 5,
          "text": "היינו שהעילוי דעבודת המטה הוא שעי\"ז נעשה ההמשכה מלמעלה וגם ענין בירור התחתון הוא שעי\"ז היא השלימות דההמשכה."
        },
        {
          "s": 6,
          "text": "ולכן מפרש"
        },
        {
          "s": 7,
          "text": "(כפשטות לשון הכתוב)"
        },
        {
          "s": 8,
          "text": "דלעשות צדקה ומשפט הוא פירוש ופרט בדרך הוי',"
        },
        {
          "s": 9,
          "text": "ההמשכה מלמעלה."
        },
        {
          "s": 10,
          "text": "ולשנה הבאה במאמר השני מבאר העילוי דמעשה המצוות"
        },
        {
          "s": 11,
          "text": "(עבודת המטה)"
        },
        {
          "s": 12,
          "text": "כמו שהוא מצד עצמו42,"
        },
        {
          "s": 13,
          "text": "בדוגמת הגילוי דלעתיד שאז תתגלה מעלת המעשה,"
        },
        {
          "s": 14,
          "text": "מעשה גדול,"
        },
        {
          "s": 15,
          "text": "לא רק זה שהמעשה מעורר וממשיך את אור הבל\"ג כמו שהוא למעלה מהתלבשות בחכמה"
        },
        {
          "s": 16,
          "text": "(תלמוד),"
        },
        {
          "s": 17,
          "text": "אלא גם העילוי דהמעשה גופא,"
        },
        {
          "s": 18,
          "text": "שהוא מגיע בהעלם העצמי40"
        },
        {
          "s": 19,
          "text": "(שלמעלה גם מאור הבל\"ג שנמשך על ידו)41."
        },
        {
          "s": 20,
          "text": "ולכן מפרש דלעשות צדקה ומשפט הוא"
        },
        {
          "s": 21,
          "text": "(לא פרט וביאור בדרך הוי',"
        },
        {
          "s": 22,
          "text": "כ\"א)"
        },
        {
          "s": 23,
          "text": "ענין נוסף"
        },
        {
          "s": 24,
          "text": "(שבא לאחרי וע\"י ושמרו דרך הוי')43."
        },
        {
          "s": 25,
          "text": "וזהו מה שמאמר זה מתחיל בפסוק והוי' אמר המכסה אני,"
        },
        {
          "s": 26,
          "text": "ומבאר דהמכסה אני הוא בחי' העלם העצמי דא\"ס,"
        },
        {
          "s": 27,
          "text": "ופירוש המכסה אני מאברהם הוא שלאברהם נתגלה בחי' זו,"
        },
        {
          "s": 28,
          "text": "דע\"י עבודתו בבחי' אור חוזר מלמטה למעלה,"
        },
        {
          "s": 29,
          "text": "וגם יצוה את בניו ואת ביתו אחריו גו' לעשות צדקה ומשפט,"
        },
        {
          "s": 30,
          "text": "לכן נתגלה לו בחי' העלם העצמי."
        },
        {
          "s": 31,
          "text": "[ואומר על זה המכסה בתמי'44,"
        },
        {
          "s": 32,
          "text": "כי מצד העבודה שלו"
        },
        {
          "s": 33,
          "text": "(בבחינת אור חוזר)"
        },
        {
          "s": 34,
          "text": "אין שייך שלא יתגלה לו בחינה זו]."
        },
        {
          "s": 35,
          "text": "ומכיון שבמאמר זה מדובר בענין הגילוי דהעלם העצמי"
        },
        {
          "s": 36,
          "text": "(המכסה אני),"
        },
        {
          "s": 37,
          "text": "לכן,"
        },
        {
          "s": 38,
          "text": "גם בפסוק כי ידעתיו גו' מפרש שידעתיו הוא לשון חיבה שחיבב אותו בבחי' תענוג העצמי"
        },
        {
          "s": 39,
          "text": "[דגילוי תענוג העצמי הוא נעלה יותר מגילוי הרצון,"
        },
        {
          "s": 40,
          "text": "שלכן גילוי הרצון יש גם עכשיו משא\"כ גילוי התענוג יהי' רק לעתיד45],"
        },
        {
          "s": 41,
          "text": "כי ע\"י המשכת וגילוי העלם העצמי,"
        },
        {
          "s": 42,
          "text": "גם הגילויים הם באופן נעלה יותר46."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "והנה שני ענינים אלו דושמרו דרך הוי'"
        },
        {
          "s": 1,
          "text": "(המשכה מלמעלה למטה)"
        },
        {
          "s": 2,
          "text": "לעשות צדקה ומשפט"
        },
        {
          "s": 3,
          "text": "(עבודה מלמטה למעלה)"
        },
        {
          "s": 4,
          "text": "ישנם בכאו\"א מישראל,"
        },
        {
          "s": 5,
          "text": "במשך כל הדורות."
        },
        {
          "s": 6,
          "text": "דנוסף על זה שכל עניני התורה הם נצחיים47,"
        },
        {
          "s": 7,
          "text": "ובפרט הענינים דמעשה אבות סימן ונתינת כח לבנים48,"
        },
        {
          "s": 8,
          "text": "הרי בנוגע לענין זה אומר בפירוש אשר יצוה את בניו ואת ביתו אחריו,"
        },
        {
          "s": 9,
          "text": "עד סוף כל הדורות."
        },
        {
          "s": 10,
          "text": "וציווי זה"
        },
        {
          "s": 11,
          "text": "(שאברהם מצוה את בניו גו')"
        },
        {
          "s": 12,
          "text": "הוא נתינת כח מיוחד"
        },
        {
          "s": 13,
          "text": "(נוסף על הנתינת כח שמצד מעשה אבות)"
        },
        {
          "s": 14,
          "text": "לכל אחד מישראל על שתי עבודות הנ\"ל."
        }
      ]
    }
  ]
}