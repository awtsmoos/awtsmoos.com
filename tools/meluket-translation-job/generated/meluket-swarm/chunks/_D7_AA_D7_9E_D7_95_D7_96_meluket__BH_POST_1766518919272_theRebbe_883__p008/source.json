{
  "globalIndex": 932,
  "owner": 32,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919272_theRebbe_883__p008",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919272_theRebbe_883__p008",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919272_theRebbe_883",
  "title": "מאמר נתת ליראיך תשל\"ו",
  "part": 8,
  "sections": [
    {
      "v": 21,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ט)"
        },
        {
          "s": 2,
          "text": "וזהו נתת ליראיך נס להתנוסס מפני קשט סלה,"
        },
        {
          "s": 3,
          "text": "דקושטי' דאברהם הוא באופן של סלה,"
        },
        {
          "s": 4,
          "text": "לעלמין,"
        },
        {
          "s": 5,
          "text": "דאפילו בסוף כל עלמין בדרא דעקבתא דמשיחא,"
        },
        {
          "s": 6,
          "text": "ובזה גופא ברגעים האחרונים של הגלות,"
        },
        {
          "s": 7,
          "text": "הנה עבודת ישראל היא מתוך מס\"נ,"
        },
        {
          "s": 8,
          "text": "בחי' נס בתוך נס שבנפש,"
        },
        {
          "s": 9,
          "text": "דלא רק שיש אצלם ענין הקרנות,"
        },
        {
          "s": 10,
          "text": "אלא עוד זאת,"
        },
        {
          "s": 11,
          "text": "שהם באופן של תרוממנה קרנות צדיק"
        },
        {
          "s": 12,
          "text": "(וכפירש\"י דקאי על ישראל שהם שבחו של הקב\"ה,"
        },
        {
          "s": 13,
          "text": "צדיקו של עולם)."
        },
        {
          "s": 14,
          "text": "ועי\"ז יחלצון ידידיך הושיעה ימינך וענני,"
        },
        {
          "s": 15,
          "text": "שגואלים הימין שבזמן הגלות היא באופן דהשיב אחור ימינו."
        },
        {
          "s": 16,
          "text": "והוא ע\"י שמתגלה בחי' גורל אצל כאו\"א,"
        },
        {
          "s": 17,
          "text": "דותעמוד לגורלך לקץ הימין,"
        },
        {
          "s": 18,
          "text": "בחי' אתה תומיך גורלי."
        },
        {
          "s": 19,
          "text": "ועי\"ז נעשה"
        },
        {
          "s": 20,
          "text": "(אך בגורל)"
        },
        {
          "s": 21,
          "text": "יחלק את הארץ"
        },
        {
          "s": 22,
          "text": "(ובב' הנוסחאות שבכת\"י המאמרים199,"
        },
        {
          "s": 23,
          "text": "יחלק ותחלק),"
        },
        {
          "s": 24,
          "text": "חלוקת הארץ כפשוטה"
        },
        {
          "s": 25,
          "text": "(דאין ענין יוצא מידי פשוטו),"
        },
        {
          "s": 26,
          "text": "ולמטה מעשרה טפחים בגאולה האמיתית והשלימה ע\"י משיח צדקנו,"
        },
        {
          "s": 27,
          "text": "שאז יהי' כיבוש א\"י השלימה,"
        },
        {
          "s": 28,
          "text": "ולאח\"ז כיבוש ארץ הקני הקניזי והקדמוני,"
        },
        {
          "s": 29,
          "text": "ולאח\"ז ירחיב ה\"א את גבולך,"
        },
        {
          "s": 30,
          "text": "נחלה בלי מצרים."
        },
        {
          "s": 31,
          "text": "ומכיון שכ\"ז נעשה ע\"י בחי' הגורל שהיא למעלה מטו\"ד,"
        },
        {
          "s": 32,
          "text": "לכן אין צורך כלל באריכות זמן כ\"א בלשון אדמו\"ר הזקן200"
        },
        {
          "s": 33,
          "text": "דיום שכולו ארוך היינו שגם בתחלתו הוא ארוך,"
        },
        {
          "s": 34,
          "text": "דבשעתא חדא באה הגאולה האמיתית והשלימה עם כל הפרטים והשלימות שבה,"
        },
        {
          "s": 35,
          "text": "עד כי ירחיב ה\"א את גבולך,"
        },
        {
          "s": 36,
          "text": "ע\"י ה' דוקא201"
        },
        {
          "s": 37,
          "text": "(ע\"ד דאתה דייקא תומיך גורלי),"
        },
        {
          "s": 38,
          "text": "בקרוב ממש בביאת משיח צדקנו,"
        },
        {
          "s": 39,
          "text": "שהקב\"ה מוליך את ישראל בקומה זקופה בגאולה האמיתית והשלימה,"
        },
        {
          "s": 40,
          "text": "וירם קרן משיחו202,"
        },
        {
          "s": 41,
          "text": "ויהפכו ימים אלו לששון ולשמחה ולמועדים טובים203,"
        },
        {
          "s": 42,
          "text": "בעגלא דידן."
        }
      ]
    }
  ]
}