{
  "globalIndex": 694,
  "owner": 44,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917870_theRebbe_730__p001",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917870_theRebbe_730__p001",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917870_theRebbe_730",
  "title": "מאמר אשרי תבחר ותקרב תשט\"ז",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "אור ליום ועש\"ק פ' חיי שרה,"
        },
        {
          "s": 2,
          "text": "כ\"ו מרחשון ה'תשט\"ז*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "אשרי תבחר ותקרב ישכון חצריך נשבעה בטוב ביתך קדוש היכלך1,"
        },
        {
          "s": 1,
          "text": "הנה פסוק זה אומרים לפני ברית מילה,"
        },
        {
          "s": 2,
          "text": "כדאיתא בסידור סדר המילה."
        },
        {
          "s": 3,
          "text": "והמקור לזה הוא מ\"ש בזהר2"
        },
        {
          "s": 4,
          "text": "חסידי קדמאי כו' כד מקריבין בנייהו לקרבנא דא פתחי ואמרי אשרי תבחר ותקרב ישכון חצריך וכו'."
        },
        {
          "s": 5,
          "text": "[והגם שבזהר שם חסידי קדמאי כו',"
        },
        {
          "s": 6,
          "text": "כתב זה אדמו\"ר הזקן בסידורו3,"
        },
        {
          "s": 7,
          "text": "שהוא דבר השוה לכל נפש]."
        },
        {
          "s": 8,
          "text": "וביאור השייכות דפסוק זה לברית מילה הוא,"
        },
        {
          "s": 9,
          "text": "דבפסוק זה נמנים ד' ענינים,"
        },
        {
          "s": 10,
          "text": "חצריך לשון רבים שתי בחינות חצר4,"
        },
        {
          "s": 11,
          "text": "ביתך והיכלך."
        },
        {
          "s": 12,
          "text": "וסדר הענינים בהפסוק הוא מלמטה למעלה."
        },
        {
          "s": 13,
          "text": "כדאיתא בזהר שם,"
        },
        {
          "s": 14,
          "text": "בקדמיתא חצריך לבתר ביתך ולבתר היכלך,"
        },
        {
          "s": 15,
          "text": "דא פנימאה מן דא ודא לעילא מן דא."
        },
        {
          "s": 16,
          "text": "ויש לומר,"
        },
        {
          "s": 17,
          "text": "שד' ענינים אלה הם כנגד ד' עולמות אבי\"ע"
        },
        {
          "s": 18,
          "text": "(כדלקמן סעיף ו)."
        },
        {
          "s": 19,
          "text": "ולכן אומרים פסוק זה קודם הברית,"
        },
        {
          "s": 20,
          "text": "כי ע\"י המילה הוא המשכה שלמעלה מהשתלשלות,"
        },
        {
          "s": 21,
          "text": "ובכדי שתהי' המשכה זו צ\"ל תחלה השלימות דהשתלשלות"
        },
        {
          "s": 22,
          "text": "(ד' עולמות)"
        },
        {
          "s": 23,
          "text": "כדלקמן"
        },
        {
          "s": 24,
          "text": "(סעיף ז)."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והענין הוא,"
        },
        {
          "s": 2,
          "text": "דהחילוק בין חצר ובית"
        },
        {
          "s": 3,
          "text": "(כפשוטם)"
        },
        {
          "s": 4,
          "text": "הוא,"
        },
        {
          "s": 5,
          "text": "דבית הוא דירת אדם ובחצר נמצאים הבהמות והעופות,"
        },
        {
          "s": 6,
          "text": "כדאיתא במשנה5"
        },
        {
          "s": 7,
          "text": "הי' מעמיד בהמה בחצר כו' ומגדל תרנגולים6."
        },
        {
          "s": 8,
          "text": "ובחצר עצמו שני סוגים,"
        },
        {
          "s": 9,
          "text": "חצר מקורה וחצר שאינו מקורה."
        },
        {
          "s": 10,
          "text": "דהחילוק בין חצר מקורה וחצר שאינו מקורה הוא גם בהלכה,"
        },
        {
          "s": 11,
          "text": "דחצר שאינו מקורה"
        },
        {
          "s": 12,
          "text": "(כשהוא יותר מסאתיים מדאורייתא הוא רשות היחיד אבל מדברי סופרים הוא ככרמלית לפי שדומה לרשות הרבים7,"
        },
        {
          "s": 13,
          "text": "וחצר מקורה הוא רשות היחיד גם מד\"ס8."
        },
        {
          "s": 14,
          "text": "והחילוק ביניהם בפשטות,"
        },
        {
          "s": 15,
          "text": "דשמירת הבהמות היא גם בחצר שאינו מקורה"
        },
        {
          "s": 16,
          "text": "[וצריך רק שהחצר יהי' מוקף מחיצות],"
        },
        {
          "s": 17,
          "text": "ושמירת העופות"
        },
        {
          "s": 18,
          "text": "(שיכולים לפרוח ע\"ג המחיצות)"
        },
        {
          "s": 19,
          "text": "הוא בחצר מקורה דוקא."
        }
      ]
    }
  ]
}