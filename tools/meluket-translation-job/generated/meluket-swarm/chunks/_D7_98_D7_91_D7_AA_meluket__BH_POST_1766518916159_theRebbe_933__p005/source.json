{
  "globalIndex": 423,
  "owner": 23,
  "jobId": "_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916159_theRebbe_933__p005",
  "batchId": "meluket-_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916159_theRebbe_933__p005",
  "seriesId": "טבת_meluket",
  "postId": "BH_POST_1766518916159_theRebbe_933",
  "title": "מאמר ודוד עבדי תשל\"ב",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר45,"
        },
        {
          "s": 1,
          "text": "דערבותו של יהודה,"
        },
        {
          "s": 2,
          "text": "שנתקשר בקשר חזק להיות כו' בשני עולמות46,"
        },
        {
          "s": 3,
          "text": "היא באה מצד זה שכל ישראל הם עצם אחד ממש"
        },
        {
          "s": 4,
          "text": "(שלמעלה מזה שמעורבים זה בזה)."
        },
        {
          "s": 5,
          "text": "ולכן היתה ערבות זו אצל יהודה דוקא,"
        },
        {
          "s": 6,
          "text": "כי יהודה הוא בחינת מלכות,"
        },
        {
          "s": 7,
          "text": "דשורש המלכות הוא בכתר"
        },
        {
          "s": 8,
          "text": "(ובכתר עצמו בפנימיות הכתר)"
        },
        {
          "s": 9,
          "text": "שלמעלה מהתחלקות."
        },
        {
          "s": 10,
          "text": "ויש להוסיף,"
        },
        {
          "s": 11,
          "text": "דע\"י שאמר יהודה ליוסף כי עבדך ערב את הנער,"
        },
        {
          "s": 12,
          "text": "דערבות זו היתה מצד זה שכל ישראל הם עצם אחד ממש,"
        },
        {
          "s": 13,
          "text": "נמשך ענין זה"
        },
        {
          "s": 14,
          "text": "(בבחינת מקיף עכ\"פ)"
        },
        {
          "s": 15,
          "text": "גם ביוסף,"
        },
        {
          "s": 16,
          "text": "ולכן לא יכול יוסף להתאפק גו'47"
        },
        {
          "s": 17,
          "text": "והתוודע אל אחיו."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 2,
          "text": "דפירוש כמוך כפרעה הוא,"
        },
        {
          "s": 3,
          "text": "שגם שרשו האמיתי דז\"א"
        },
        {
          "s": 4,
          "text": "(יוסף,"
        },
        {
          "s": 5,
          "text": "כמוך)"
        },
        {
          "s": 6,
          "text": "הוא בעצם הכתר"
        },
        {
          "s": 7,
          "text": "(שלמעלה מהדרגא דכתר שהוא שורש הז\"א),"
        },
        {
          "s": 8,
          "text": "פרעה."
        },
        {
          "s": 9,
          "text": "היינו,"
        },
        {
          "s": 10,
          "text": "שהכוונה בהאצלת ז\"א,"
        },
        {
          "s": 11,
          "text": "וגם בהדרגא דכתר שהוא שורש הז\"א,"
        },
        {
          "s": 12,
          "text": "הוא בכדי להשלים הכוונה דפנימיות הכתר."
        },
        {
          "s": 13,
          "text": "וע\"י שיהודה"
        },
        {
          "s": 14,
          "text": "[בחינת מלכות,"
        },
        {
          "s": 15,
          "text": "ששרשה הוא בפנימיות הכתר,"
        },
        {
          "s": 16,
          "text": "היינו48"
        },
        {
          "s": 17,
          "text": "שגם לאחרי שנמשכה למטה נרגש בה השורש שלה בפנימיות הכתר]"
        },
        {
          "s": 18,
          "text": "אמר ליוסף כמוך כפרעה,"
        },
        {
          "s": 19,
          "text": "הונח"
        },
        {
          "s": 20,
          "text": "(האָט זיך אָפּגעלייגט)"
        },
        {
          "s": 21,
          "text": "ענין זה גם ביוסף,"
        },
        {
          "s": 22,
          "text": "וזה פעל בו ענין בי אדוני,"
        },
        {
          "s": 23,
          "text": "שימשיך השפע למלכות בשביל המלכות,"
        },
        {
          "s": 24,
          "text": "בכדי להשלים הכוונה דפנימיות הכתר."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "והנה לפי ביאור זה,"
        },
        {
          "s": 3,
          "text": "השייכות דבי אדוני לכמוך כפרעה הוא,"
        },
        {
          "s": 4,
          "text": "שכמוך כפרעה היא הסיבה לענין בי אדוני."
        },
        {
          "s": 5,
          "text": "דע\"י שהונח אצל יוסף שהשורש האמיתי דז\"א"
        },
        {
          "s": 6,
          "text": "(הכוונה בהאצלת ז\"א)"
        },
        {
          "s": 7,
          "text": "הוא בפנימיות הכתר,"
        },
        {
          "s": 8,
          "text": "זה הביא אותו שימשיך השפע למלכות בשביל המלכות,"
        },
        {
          "s": 9,
          "text": "בכדי להשלים הכוונה דפנימיות הכתר."
        },
        {
          "s": 10,
          "text": "ועוד ביאור בהשייכות דשני הענינים,"
        },
        {
          "s": 11,
          "text": "שע\"י שיוסף ימשיך השפע למלכות בשביל המלכות,"
        },
        {
          "s": 12,
          "text": "בי אדוני,"
        },
        {
          "s": 13,
          "text": "עי\"ז יהי' בו גילוי פנימיות הכתר,"
        },
        {
          "s": 14,
          "text": "כמוך כפרעה"
        },
        {
          "s": 15,
          "text": "(כנ\"ל סעיף ז)."
        },
        {
          "s": 16,
          "text": "דזה שהונח אצלו הענין דכמוך כפרעה לפני שהשפיע במלכות,"
        },
        {
          "s": 17,
          "text": "הי' זה"
        },
        {
          "s": 18,
          "text": "(לא בבחינת גילוי,"
        },
        {
          "s": 19,
          "text": "אלא)"
        },
        {
          "s": 20,
          "text": "שהניח את עצמו להשפיע למלכות,"
        },
        {
          "s": 21,
          "text": "בכדי להשלים הכוונה."
        },
        {
          "s": 22,
          "text": "וע\"י שהשפיע למלכות,"
        },
        {
          "s": 23,
          "text": "נמשך לו הגילוי דפנימיות הכתר."
        }
      ]
    }
  ]
}