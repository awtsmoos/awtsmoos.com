{
  "globalIndex": 595,
  "owner": 45,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917153_theRebbe_141__p003",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917153_theRebbe_141__p003",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518917153_theRebbe_141",
  "title": "מאמר ואלה המשפטים תשל\"ח",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה זה שאפשר להיות קס\"ד בתורה ד\"או אינו אלא עבדו של עברי\" אבל הוא עצמו עבד כנעני,"
        },
        {
          "s": 2,
          "text": "והיינו שתהי' דרגת העבודה בבחי' עבד כנעני דבהפקירא ניחא לי',"
        },
        {
          "s": 3,
          "text": "הוא רק מצד ירידת הנשמה למטה,"
        },
        {
          "s": 4,
          "text": "שירדה מאיגרא רמה לבירא עמיקתא47."
        },
        {
          "s": 5,
          "text": "[וגם אז אין קס\"ד שיהי' עבד כנעני לגמרי ח\"ו כ\"א \"עבדו"
        },
        {
          "s": 6,
          "text": "(כנעני)"
        },
        {
          "s": 7,
          "text": "של עברי\","
        },
        {
          "s": 8,
          "text": "דישנה עליו השפעת ואדנות של \"עברי\","
        },
        {
          "s": 9,
          "text": "כי גם מי שהוא בדרגא הכי פחותה שבישראל"
        },
        {
          "s": 10,
          "text": "(בבחי' עבד כנעני,"
        },
        {
          "s": 11,
          "text": "מצד ירידת הנשמה למטה)"
        },
        {
          "s": 12,
          "text": "מ\"מ להיותו בן לאברהם אבינו"
        },
        {
          "s": 13,
          "text": "[דאחד הי' אברהם48,"
        },
        {
          "s": 14,
          "text": "אברהם העברי49]"
        },
        {
          "s": 15,
          "text": "יש לו בירושה האהבה"
        },
        {
          "s": 16,
          "text": "(והיראה)"
        },
        {
          "s": 17,
          "text": "המסותרת כמבואר בארוכה בתניא50,"
        },
        {
          "s": 18,
          "text": "שאהוי\"ר זו פועלת אצל כאו\"א"
        },
        {
          "s": 19,
          "text": "(גם אם נדמה לו דבהפקירא ניחא לי',"
        },
        {
          "s": 20,
          "text": "שרצונו הוא בענינים אחרים,"
        },
        {
          "s": 21,
          "text": "גם בענינים כאלו שהם היפך הרצוי ח\"ו)"
        },
        {
          "s": 22,
          "text": "אַז ער מוז טאָן ווי דער אויבערשטער וויל,"
        },
        {
          "s": 23,
          "text": "ולכן אא\"פ שיהי' כנעני לגמרי ח\"ו כ\"א עבד כנעני של עברי,"
        },
        {
          "s": 24,
          "text": "שבגלוי הוא בבחי' עבד כנעני,"
        },
        {
          "s": 25,
          "text": "אבל נמצא בו"
        },
        {
          "s": 26,
          "text": "(בהעלם)"
        },
        {
          "s": 27,
          "text": "האהבה המסותרת שבירושה מאברהם העברי]."
        },
        {
          "s": 28,
          "text": "וכוונת ירידה זו,"
        },
        {
          "s": 29,
          "text": "שישנו קס\"ד בתורה ד\"או אינו אלא עבדו של עברי\","
        },
        {
          "s": 30,
          "text": "היא רק בכדי שע\"י עבודתו ב\"תלמוד לומר\" – לימוד התורה באופן שילמוד ממנה מהו רצון התורה – הנה יראה מיד ויגלה האמיתיות שלו ש\"אף כאן עבד שהוא עברי\"51,"
        },
        {
          "s": 31,
          "text": "ושהוא בעצמו הוא עברי"
        },
        {
          "s": 32,
          "text": "(ולא שהוא כנעני ויש עליו רק אדנות העברי),"
        },
        {
          "s": 33,
          "text": "והיינו שמקומו ומדרגתו הוא בבחי' עבר הנהר52,"
        },
        {
          "s": 34,
          "text": "וגם כדאיתא במדרש53"
        },
        {
          "s": 35,
          "text": "דמה שאברהם נקרא אברהם העברי הוא ע\"ש שכל העולם כולו מעבר אחד והוא מעבר אחד,"
        },
        {
          "s": 36,
          "text": "וכן פועל בעבודתו להיות"
        },
        {
          "s": 37,
          "text": "(עבד)"
        },
        {
          "s": 38,
          "text": "עברי,"
        },
        {
          "s": 39,
          "text": "אַז ער שטעלט זיך אַנטקעגן דער גאַנצער וועלט,"
        },
        {
          "s": 40,
          "text": "מתחיל מהעלם והסתר"
        },
        {
          "s": 41,
          "text": "(עולם מלשון העלם54)"
        },
        {
          "s": 42,
          "text": "נפשו הבהמית,"
        },
        {
          "s": 43,
          "text": "ומהפך אותה,"
        },
        {
          "s": 44,
          "text": "והולך ועולה מדרגא לדרגא,"
        },
        {
          "s": 45,
          "text": "מבחי' עבד כנעני"
        },
        {
          "s": 46,
          "text": "(שלקחתו מישראל)"
        },
        {
          "s": 47,
          "text": "לבחי' עבד"
        },
        {
          "s": 48,
          "text": "(שהוא)"
        },
        {
          "s": 49,
          "text": "עברי,"
        },
        {
          "s": 50,
          "text": "ואח\"כ גם לבחי' אמה העברי',"
        },
        {
          "s": 51,
          "text": "ועד שפועל בעבודתו שיהי' לו או לבנו יעדנה55"
        },
        {
          "s": 52,
          "text": "כמבואר בארוכה בדרוש הנכבד לרבינו הגדול נ\"ע הנ\"ל56."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "והנה כללות ענין הנ\"ל ישנו גם בעבודת כאו\"א בכל יום57."
        },
        {
          "s": 2,
          "text": "והענין הוא,"
        },
        {
          "s": 3,
          "text": "דבחי' עבד כנעני הוא כאשר ישראל הם בבחי' התלבשות בעניני העולם בכדי58"
        },
        {
          "s": 4,
          "text": "לברר אותם,"
        },
        {
          "s": 5,
          "text": "וכמ\"ש59"
        },
        {
          "s": 6,
          "text": "ועשית כל מלאכתך,"
        },
        {
          "s": 7,
          "text": "שצ\"ל מלאכה בעניני עוה\"ז הגשמי וגם בחומריות העולם בכדי להפכו לקדושה,"
        },
        {
          "s": 8,
          "text": "שמצד התלבשות זו בעניני העולם,"
        },
        {
          "s": 9,
          "text": "ע\"י הבירור אפשר שיתדבק בהמברר ענין בלתי רצוי מדבר המתברר כדאיתא בתניא60,"
        },
        {
          "s": 10,
          "text": "ועי\"ז אפשר שיהי' נראה בתחלת העבודה כבחי' עבד כנעני."
        },
        {
          "s": 11,
          "text": "אמנם ירידה זו היא לצורך עלי',"
        },
        {
          "s": 12,
          "text": "ולכן היא לרגע בלבד,"
        },
        {
          "s": 13,
          "text": "ומיד לאח\"ז היא התחלת העלי',"
        },
        {
          "s": 14,
          "text": "ויתירה מזו הנה ע\"י הירידה נעשה עלי' ביתר שאת ויתר עוז,"
        },
        {
          "s": 15,
          "text": "ע\"ד המבואר בתניא61"
        },
        {
          "s": 16,
          "text": "בנוגע לענין המבלבל את האדם בתפלתו,"
        },
        {
          "s": 17,
          "text": "שמהבלבול עצמו צריך להתעורר להתפלל יותר בכוונה מעומקא דלבא."
        },
        {
          "s": 18,
          "text": "והוא כשיתבונן שמכיון שהקב\"ה הוא המחי' את הענין המבלבלו הנה בודאי שזה שהראו לו"
        },
        {
          "s": 19,
          "text": "(מלמעלה)"
        },
        {
          "s": 20,
          "text": "בלבול זה,"
        },
        {
          "s": 21,
          "text": "והבלבול נמצא בתוך הד\"א שלו,"
        },
        {
          "s": 22,
          "text": "ועד שגם מבלבלו בתפלתו,"
        },
        {
          "s": 23,
          "text": "הוא"
        },
        {
          "s": 24,
          "text": "(לא מפני שהוא ענין בפ\"ע ח\"ו,"
        },
        {
          "s": 25,
          "text": "כ\"א)"
        },
        {
          "s": 26,
          "text": "רק בכדי שהאדם ע\"י עבודתו יעשה מהבלבול מטעמים ל' רבים,"
        },
        {
          "s": 27,
          "text": "תחלה ע\"י העבודה שבבחי' אתכפיא"
        },
        {
          "s": 28,
          "text": "(כללות עבודת הבינונים),"
        },
        {
          "s": 29,
          "text": "עד שיגיע גם לבחי' אתהפכא"
        },
        {
          "s": 30,
          "text": "(כללות עבודת הצדיקים)"
        },
        {
          "s": 31,
          "text": "כמבואר בתניא62,"
        },
        {
          "s": 32,
          "text": "ועד\"ז הוא בענין הנ\"ל שמהירידה גופא צריך להתעורר ביתר שאת לעבוד עבודתו בבחי' עבד כנעני,"
        },
        {
          "s": 33,
          "text": "עבד עברי ואמה העברי',"
        },
        {
          "s": 34,
          "text": "עד שיגיע להיות לו או לבנו יעדנה,"
        },
        {
          "s": 35,
          "text": "ועד ויצאה חנם אין כסף63"
        },
        {
          "s": 36,
          "text": "[שכ\"ז הוא כללות העבודה דאתכפיא ואתהפכא הנ\"ל]"
        },
        {
          "s": 37,
          "text": "כמבואר בארוכה בדרוש הנ\"ל."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "וע\"י עבודה הנ\"ל דשש שנים יעבוד,"
        },
        {
          "s": 1,
          "text": "ד"
        },
        {
          "s": 2,
          "text": "(יעבוד)"
        },
        {
          "s": 3,
          "text": "קאי על כללות עבודת האדם לקונו,"
        },
        {
          "s": 4,
          "text": "הנה מגיעים לובשביעית"
        },
        {
          "s": 5,
          "text": "(יצא לחפשי חנם)64,"
        },
        {
          "s": 6,
          "text": "דקאי על השלימות הכי נעלית שתהי' לע\"ל,"
        },
        {
          "s": 7,
          "text": "יום65"
        },
        {
          "s": 8,
          "text": "שכולו שבת ומנוחה לחיי העולמים66,"
        },
        {
          "s": 9,
          "text": "שאז יהי' גילוי אלקות למטה,"
        },
        {
          "s": 10,
          "text": "דירה לו ית' בתחתונים"
        },
        {
          "s": 11,
          "text": "[ומעין גילוי זה מאיר גם עתה בשבת67"
        },
        {
          "s": 12,
          "text": "ובפרט68"
        },
        {
          "s": 13,
          "text": "בהזמן דרעוא דכל רעוין]."
        }
      ]
    }
  ]
}