{
  "globalIndex": 457,
  "owner": 7,
  "jobId": "_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916371_theRebbe_639__p001",
  "batchId": "meluket-_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916371_theRebbe_639__p001",
  "seriesId": "טבת_meluket",
  "postId": "BH_POST_1766518916371_theRebbe_639",
  "title": "מאמר וידבר אלוקים אל משה תשל\"א",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ וארא,"
        },
        {
          "s": 2,
          "text": "מבה\"ח שבט,"
        },
        {
          "s": 3,
          "text": "ה'תשל\"א*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "(הנחה בלתי מוגה)"
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "וידבר אלקים אל משה ויאמר אליו אני ה' וארא אל אברהם אל יצחק ואל יעקב גו' ושמי הוי' לא נודעתי להם1."
        },
        {
          "s": 1,
          "text": "וידוע הדיוק2"
        },
        {
          "s": 2,
          "text": "בזה מבעל ההילולא במה שאומר ושמי הוי' לא נודעתי להם,"
        },
        {
          "s": 3,
          "text": "הלא נאמר שם הוי' וכמה פעמים בדיבור להאבות,"
        },
        {
          "s": 4,
          "text": "וכמו שהקשה בפירש\"י."
        },
        {
          "s": 5,
          "text": "גם צריך להבין מה שאומר כאן דוקא אני הוי',"
        },
        {
          "s": 6,
          "text": "מה השייכות דשם הוי' ליצי\"מ ולמ\"ת"
        },
        {
          "s": 7,
          "text": "(שקשורים זב\"ז,"
        },
        {
          "s": 8,
          "text": "כמ\"ש3"
        },
        {
          "s": 9,
          "text": "בהוציאך את העם ממצרים תעבדון את האלקים על ההר הזה)."
        },
        {
          "s": 10,
          "text": "והנה מהמבואר בד\"ה זה בתו\"א,"
        },
        {
          "s": 11,
          "text": "מובן,"
        },
        {
          "s": 12,
          "text": "שלהאבות נתגלה שם הוי' רק ע\"י שם אלקים,"
        },
        {
          "s": 13,
          "text": "שבכללות הוא בחי' שם הוי' דלתתא,"
        },
        {
          "s": 14,
          "text": "אבל שם הוי' דלעילא לא נודעתי להם,"
        },
        {
          "s": 15,
          "text": "משא\"כ במ\"ת נתגלה שם הוי' שלמעלה מהתלבשות בשם אלקים,"
        },
        {
          "s": 16,
          "text": "בחי' שם הוי' דלעילא."
        },
        {
          "s": 17,
          "text": "שלכן קודם מ\"ת הי' הגזירה4"
        },
        {
          "s": 18,
          "text": "שהעליונים לא ירדו לתחתונים והתחתונים לא יעלו לעליונים,"
        },
        {
          "s": 19,
          "text": "ובמ\"ת ביטל הקב\"ה את הגזירה ואמר התחתונים יעלו לעליונים,"
        },
        {
          "s": 20,
          "text": "והעליונים ירדו לתחתונים,"
        },
        {
          "s": 21,
          "text": "ואני המתחיל,"
        },
        {
          "s": 22,
          "text": "שנאמר5"
        },
        {
          "s": 23,
          "text": "וירד הוי' על הר סיני,"
        },
        {
          "s": 24,
          "text": "וכתיב6"
        },
        {
          "s": 25,
          "text": "ואל משה אמר עלה אל ה'."
        },
        {
          "s": 26,
          "text": "וזהו מה שנאמר לו כאן אני הוי',"
        },
        {
          "s": 27,
          "text": "שמתחיל גילוי חדש,"
        },
        {
          "s": 28,
          "text": "שיתגלה שם הוי' שלמעלה מהתלבשות בשם אלקים,"
        },
        {
          "s": 29,
          "text": "שם הוי' דלעילא."
        }
      ]
    }
  ]
}