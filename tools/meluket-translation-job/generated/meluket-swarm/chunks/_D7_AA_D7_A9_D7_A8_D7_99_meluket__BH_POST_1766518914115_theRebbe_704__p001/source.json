{
  "globalIndex": 73,
  "owner": 23,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914115_theRebbe_704__p001",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914115_theRebbe_704__p001",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914115_theRebbe_704",
  "title": "מאמר שובה ישראל תשמ\"א",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ האזינו,"
        },
        {
          "s": 2,
          "text": "שבת שובה ה'תשמ\"א*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "שובה ישראל עד הוי' אלקיך כי כשלת בעוניך1,"
        },
        {
          "s": 1,
          "text": "ופירש אדמו\"ר הזקן2,"
        },
        {
          "s": 2,
          "text": "דמ\"ש שובה גו' עד הוי' אלקיך"
        },
        {
          "s": 3,
          "text": "(אף שלכאורה הול\"ל להוי' אלקיך3)"
        },
        {
          "s": 4,
          "text": "הוא,"
        },
        {
          "s": 5,
          "text": "ששיעור התשובה הוא עד שהוי' יהי' אלקיך4."
        },
        {
          "s": 6,
          "text": "וצריך להבין,"
        },
        {
          "s": 7,
          "text": "דמי ששייך"
        },
        {
          "s": 8,
          "text": "(ודורשים ממנו)"
        },
        {
          "s": 9,
          "text": "תשובה נעלית כזו,"
        },
        {
          "s": 10,
          "text": "הרי הוא בעל מדריגה נעלית גם קודם עשיית תשובה זו,"
        },
        {
          "s": 11,
          "text": "וכמובן גם ממ\"ש שובה ישראל,"
        },
        {
          "s": 12,
          "text": "דשם ישראל הוא על שם כי שרית עם אלקים ועם אנשים ותוכל5,"
        },
        {
          "s": 13,
          "text": "שהוא שר6"
        },
        {
          "s": 14,
          "text": "ושולט על ההעלם דשם אלקים ועל הכחות שמתפשטים ממנו"
        },
        {
          "s": 15,
          "text": "(אנשים)7,"
        },
        {
          "s": 16,
          "text": "ואיך שייך בו ענין העון שיהי' צריך לתשובה."
        },
        {
          "s": 17,
          "text": "והגם שידוע שתשובה היא לא רק על עבירות8"
        },
        {
          "s": 18,
          "text": "אלא להשיב נפשו למקורה ושרשה"
        },
        {
          "s": 19,
          "text": "[והרוח תשוב אל האלקים אשר נתנה9],"
        },
        {
          "s": 20,
          "text": "דתשובה זו היא גם בצדיקים גמורים10,"
        },
        {
          "s": 21,
          "text": "הרי מפורש בכתוב שובה ישראל גו' כי כשלת בעוניך11,"
        },
        {
          "s": 22,
          "text": "והיאך שייך ענין העוונות במי שהוא בדרגא זו."
        },
        {
          "s": 23,
          "text": "גם צריך להבין מה שממשיך בכתוב12"
        },
        {
          "s": 24,
          "text": "קחו עמכם דברים ושובו אל הוי',"
        },
        {
          "s": 25,
          "text": "דאחרי שכבר אמר שובה ישראל גו' מה מוסיף ב"
        },
        {
          "s": 26,
          "text": "(קחו עמכם דברים)"
        },
        {
          "s": 27,
          "text": "ושובו אל הוי'13."
        },
        {
          "s": 28,
          "text": "גם צריך להבין מה שאומר אח\"כ12"
        },
        {
          "s": 29,
          "text": "אמרו אליו כל תשא עון גו',"
        },
        {
          "s": 30,
          "text": "שגם האמירה והבקשה תשא עון קשורה עם ענין התשובה14,"
        },
        {
          "s": 31,
          "text": "ומזה משמע שלאחרי התשובה דשובה ישראל גו' ודשובו אל הוי',"
        },
        {
          "s": 32,
          "text": "צריך להיות עוד תשובה13."
        },
        {
          "s": 33,
          "text": "גם צ\"ל מה שבתשובה הא' ובתשובה הג' מזכיר ענין העון"
        },
        {
          "s": 34,
          "text": "(כי כשלת בעוניך,"
        },
        {
          "s": 35,
          "text": "תשא עון),"
        },
        {
          "s": 36,
          "text": "משא\"כ בתשובה הב'."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ונקודת הביאור בזה ע\"פ המבואר בלקו\"ת15,"
        },
        {
          "s": 2,
          "text": "דבתשובה יש ג' בחינות."
        },
        {
          "s": 3,
          "text": "תשובה דסור מרע,"
        },
        {
          "s": 4,
          "text": "תשובה דועשה טוב,"
        },
        {
          "s": 5,
          "text": "ותשובה דבקש שלום דקאי על התורה דכל העוסק בתורה משים שלום בפמליא של מעלה ובפמליא של מטה16,"
        },
        {
          "s": 6,
          "text": "וכל התורה ניתנה לעשות שלום בעולם17."
        },
        {
          "s": 7,
          "text": "וג' התשובות שבפסוקים אלו"
        },
        {
          "s": 8,
          "text": "[שובה ישראל גו',"
        },
        {
          "s": 9,
          "text": "ושובו אל הוי',"
        },
        {
          "s": 10,
          "text": "אמרו אליו כל תשא עון]"
        },
        {
          "s": 11,
          "text": "הם ג' התשובות דסור מרע ודועשה טוב ודבקש שלום18."
        },
        {
          "s": 12,
          "text": "וזהו גם מה שפסוקים אלו הם התחלת ההפטרה דשבת תשובה,"
        },
        {
          "s": 13,
          "text": "כי בשבת תשובה צ\"ל כל ג' הבחינות."
        },
        {
          "s": 14,
          "text": "וכמו שסיפר כ\"ק מו\"ח אדמו\"ר19,"
        },
        {
          "s": 15,
          "text": "שאצל הצמח צדק היו בשבת תשובה ג' נרות של תשובה,"
        },
        {
          "s": 16,
          "text": "ואמר הצמח צדק \"עס איז פאַראַן דריי תשובות\","
        },
        {
          "s": 17,
          "text": "וביאר כ\"ק מו\"ח אדמו\"ר שהם ג' התשובות המבוארים בלקו\"ת15."
        },
        {
          "s": 18,
          "text": "וזהו מה שבתשובה הראשונה כתיב שובה גו' כי כשלת בעוניך,"
        },
        {
          "s": 19,
          "text": "משא\"כ בתשובה השני'"
        },
        {
          "s": 20,
          "text": "(ושובו אל הוי')"
        },
        {
          "s": 21,
          "text": "לא נזכר ענין העון,"
        },
        {
          "s": 22,
          "text": "כי תשובה הראשונה היא תשובה דסור מרע"
        },
        {
          "s": 23,
          "text": "(כשלת בעוניך),"
        },
        {
          "s": 24,
          "text": "משא\"כ השני' היא תשובה דועשה טוב20."
        },
        {
          "s": 25,
          "text": "וזהו גם מה שבתשובה הראשונה נזכר גם שם אלקים"
        },
        {
          "s": 26,
          "text": "(עד הוי' אלקיך)"
        },
        {
          "s": 27,
          "text": "ובתשובה השני' נזכר רק שם הוי'"
        },
        {
          "s": 28,
          "text": "(ושובו אל הוי')"
        },
        {
          "s": 29,
          "text": "ובתשובה השלישית כתיב אמרו אליו,"
        },
        {
          "s": 30,
          "text": "כי התשובה דסור מרע היא שיהי' הוי' אלקינו21,"
        },
        {
          "s": 31,
          "text": "והתשובה דועשה טוב היא להתקשר ולהדבק בשם הוי' כמו שהוא למעלה משם אלקים22,"
        },
        {
          "s": 32,
          "text": "והתשובה דבקש שלום היא להדבק וליכלל בעצמות אוא\"ס שלמעלה משם הוי'23."
        }
      ]
    }
  ]
}