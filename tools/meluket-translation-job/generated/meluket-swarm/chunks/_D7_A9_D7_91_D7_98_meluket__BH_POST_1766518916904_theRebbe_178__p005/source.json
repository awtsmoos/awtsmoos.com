{
  "globalIndex": 553,
  "owner": 3,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916904_theRebbe_178__p005",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916904_theRebbe_178__p005",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916904_theRebbe_178",
  "title": "מאמר באתי לגני תשל\"ז",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ב)"
        },
        {
          "s": 2,
          "text": "והענין הוא,"
        },
        {
          "s": 3,
          "text": "כמבואר בקונטרס עה\"ח137"
        },
        {
          "s": 4,
          "text": "בארוכה,"
        },
        {
          "s": 5,
          "text": "דהעבודה שמצד יחו\"ת היא בבחינת אחרי הוי' אלקיכם תלכו,"
        },
        {
          "s": 6,
          "text": "והעבודה שמצד יחו\"ע היא בבחינת ביטול במציאות"
        },
        {
          "s": 7,
          "text": "(היינו דבחי' יחו\"ע ויחו\"ת הם בחי' פנים ואחור בעבודה)."
        },
        {
          "s": 8,
          "text": "והנה138"
        },
        {
          "s": 9,
          "text": "התורה על הרוב תדבר,"
        },
        {
          "s": 10,
          "text": "ובפרט בזמן הגלות,"
        },
        {
          "s": 11,
          "text": "הנה עיקר העבודה היא בבחינת יחו\"ת"
        },
        {
          "s": 12,
          "text": "(אחרי הוי' אלקיכם תלכו),"
        },
        {
          "s": 13,
          "text": "אבל גם אז צריך להיות זכירה דהעבודה שבבחינת יחו\"ע"
        },
        {
          "s": 14,
          "text": "[זכירה בדוגמת הזכירה דעמלק."
        },
        {
          "s": 15,
          "text": "דעמלק הוא אותיות מלק,"
        },
        {
          "s": 16,
          "text": "מלשון ומלק את ראשו ממול ערפו81,"
        },
        {
          "s": 17,
          "text": "והיינו דמקום יניקתו הוא בבחינת אחור וענינו לפעול השכחה"
        },
        {
          "s": 18,
          "text": "(כנ\"ל דענין השכחה הוא מצד בחינת האחור)."
        },
        {
          "s": 19,
          "text": "ולכן מזהיר הכתוב בנוגע אליו במיוחד זכור ואל תשכח139]."
        },
        {
          "s": 20,
          "text": "שמזמן לזמן עכ\"פ צ\"ל עבודתו בבחינת יחו\"ע,"
        },
        {
          "s": 21,
          "text": "בכדי שיהי' קיום לעבודתו בבחינת יחו\"ת צ\"ל נתינת כח והארה ע\"ז מהעבודה שבבחינת יחו\"ע."
        },
        {
          "s": 22,
          "text": "ובחינת יחו\"ע מאירה בבחינת יחו\"ת."
        },
        {
          "s": 23,
          "text": "ובחינת יחו\"ע"
        },
        {
          "s": 24,
          "text": "(הנותנת כח לקיום העבודה שבבחינת יחו\"ת)"
        },
        {
          "s": 25,
          "text": "קשורה עם לימוד פנימיות התורה,"
        },
        {
          "s": 26,
          "text": "כמבואר שם140"
        },
        {
          "s": 27,
          "text": "דענין פנימיות התורה הוא כמ\"ש141"
        },
        {
          "s": 28,
          "text": "דע את אלקי אביך,"
        },
        {
          "s": 29,
          "text": "והיינו לידע גדולתו וכו' ועי\"ז נעשה"
        },
        {
          "s": 30,
          "text": "(כסיום הכתוב)"
        },
        {
          "s": 31,
          "text": "ועבדהו בלבב שלם,"
        },
        {
          "s": 32,
          "text": "שהעבודה היא בשלימות"
        },
        {
          "s": 33,
          "text": "(שזהו כנ\"ל דבחינת פנים דתורה"
        },
        {
          "s": 34,
          "text": "(פנימיות התורה)"
        },
        {
          "s": 35,
          "text": "קשורה עם בחינת פנים שבעבודה,"
        },
        {
          "s": 36,
          "text": "העבודה שבבחינת יחו\"ע)."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ג)"
        },
        {
          "s": 2,
          "text": "ובכללות,"
        },
        {
          "s": 3,
          "text": "זהו"
        },
        {
          "s": 4,
          "text": "(שבחינת פנים יומשך גם בבחינת אחור)"
        },
        {
          "s": 5,
          "text": "שתכלית הכוונה הוא שיהי' עיקר שכינה בתחתונים."
        },
        {
          "s": 6,
          "text": "וכמבואר בפע\"ח142"
        },
        {
          "s": 7,
          "text": "דכל מעשינו ועבודתינו בזמן הגלות מגיעים רק בבחינת חיצוניות ע\"ק,"
        },
        {
          "s": 8,
          "text": "ולע\"ל יהי' גילוי בחינת פנימיות ע\"ק."
        },
        {
          "s": 9,
          "text": "אמנם אעפ\"כ הנה מעשינו ועבודתינו במשך זמן הגלות ממשיכים השכר דימות המשיח ושלאח\"ז143,"
        },
        {
          "s": 10,
          "text": "שכללות ענינו הוא כמ\"ש144"
        },
        {
          "s": 11,
          "text": "ולא יכנף עוד מוריך,"
        },
        {
          "s": 12,
          "text": "ונגלה כבוד הוי' וראו כל בשר יחדיו גו'145"
        },
        {
          "s": 13,
          "text": "עד שיהי' בבחינת פנים בפנים,"
        },
        {
          "s": 14,
          "text": "שבחינת פנימיות ע\"ק יהי' בגלוי."
        },
        {
          "s": 15,
          "text": "ומה שפועלים עתה כן הוא ע\"י שבזמן הגלות ישנו הנתינת כח דבחינת פנימיות התורה"
        },
        {
          "s": 16,
          "text": "(שמצד בחינת פנימיות ע\"ק),"
        },
        {
          "s": 17,
          "text": "דטועמי' חיים זכו146כג."
        },
        {
          "s": 18,
          "text": "ופנימיות התורה מביאה להעבודה בבחינת ביטול במציאות,"
        },
        {
          "s": 19,
          "text": "שזה מביא לעבודה שכללות ענינה הוא יחו\"ע,"
        },
        {
          "s": 20,
          "text": "שעבודה זו קשורה עם פנימיות הנשמה,"
        },
        {
          "s": 21,
          "text": "וכמבואר בכ\"מ,"
        },
        {
          "s": 22,
          "text": "וזהו הכנה קרובה שיומשך בדומה לזה"
        },
        {
          "s": 23,
          "text": "(לעבודה זו),"
        },
        {
          "s": 24,
          "text": "במדתו של הקב\"ה שהיא מדה כנגד מדה129,"
        },
        {
          "s": 25,
          "text": "והיינו שע\"י יפוצו מעינותיך חוצה דוקא"
        },
        {
          "s": 26,
          "text": "(בחינת פנימיות התורה שמצד בחינת פנימיות ע\"ק כו' המביאה לעבודה שמצד פנימיות הנשמה וכו')"
        },
        {
          "s": 27,
          "text": "קאתי מר דא מלכא משיחאכד"
        },
        {
          "s": 28,
          "text": "(גילוי בחינת פנימיות ע\"ק,"
        },
        {
          "s": 29,
          "text": "עיקר שכינה,"
        },
        {
          "s": 30,
          "text": "בתחתונים)."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ד)"
        },
        {
          "s": 2,
          "text": "וזהו"
        },
        {
          "s": 3,
          "text": "(המשכת בחינת פנים באחור,"
        },
        {
          "s": 4,
          "text": "ע\"ד היו\"ד בהדלי\"ת)"
        },
        {
          "s": 5,
          "text": "ג\"כ כללות נקודת המאמר דבעל ההילולא,"
        },
        {
          "s": 6,
          "text": "שהתחלתו הוא בבאתי לגני לגנוני,"
        },
        {
          "s": 7,
          "text": "למקום שהי' עיקרי בתחילה דעיקר שכינה בתחתונים היתה,"
        },
        {
          "s": 8,
          "text": "ומובן דמ\"ש"
        },
        {
          "s": 9,
          "text": "(במדרש)"
        },
        {
          "s": 10,
          "text": "עיקר שכינה,"
        },
        {
          "s": 11,
          "text": "הכוונה היא פנימיות השכינה150,"
        },
        {
          "s": 12,
          "text": "ששייכת להפנימיות דלמעלה עד לבחינת פנימיות ע\"ק."
        },
        {
          "s": 13,
          "text": "ובחינה זו צ\"ל בתחתונים דוקא,"
        },
        {
          "s": 14,
          "text": "וזה נעשה ע\"י עבודת האדם,"
        },
        {
          "s": 15,
          "text": "עד שע\"י העבודה פועלים כמו שממשיך בסיום המאמר151כה"
        },
        {
          "s": 16,
          "text": "שמעמידים צבאות ה',"
        },
        {
          "s": 17,
          "text": "ופותחים האוצרות הכמוסים,"
        },
        {
          "s": 18,
          "text": "וכל הון יקר שבהאוצרות אשר אספו אבותיו והמלך בעצמו מחלקים אותם לאנשי הצבא ע\"י פקידי החיל וראשי הצבא,"
        },
        {
          "s": 19,
          "text": "שזה קאי,"
        },
        {
          "s": 20,
          "text": "בכללות,"
        },
        {
          "s": 21,
          "text": "על ראשיכם לשבטיכם,"
        },
        {
          "s": 22,
          "text": "ראשי ונשיאי ישראל בכל דור ודור,"
        },
        {
          "s": 23,
          "text": "דאתפשטותי' דמשה בכל דרא ודרא152"
        },
        {
          "s": 24,
          "text": "עד לנשיא דורינו בעל ההילולא,"
        },
        {
          "s": 25,
          "text": "והקיצו ורננו שוכני עפר153"
        },
        {
          "s": 26,
          "text": "והוא בתוכם ויוליכנו קוממיות לארצנו בקרוב ממש,"
        },
        {
          "s": 27,
          "text": "לקבל פני משיח צדקנו שילמד תורה את כל העם כולו154,"
        },
        {
          "s": 28,
          "text": "פנימיות התורה,"
        },
        {
          "s": 29,
          "text": "ובעגלא דידן."
        }
      ]
    }
  ]
}