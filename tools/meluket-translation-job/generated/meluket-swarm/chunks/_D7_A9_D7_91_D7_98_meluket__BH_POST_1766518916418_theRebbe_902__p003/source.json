{
  "globalIndex": 462,
  "owner": 12,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916418_theRebbe_902__p003",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916418_theRebbe_902__p003",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916418_theRebbe_902",
  "title": "מאמר לה\"ע כתיבת ספר תורה תש\"ל",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ואולי י\"ל,"
        },
        {
          "s": 1,
          "text": "דזה שתיקון הז' נקרא ואמת"
        },
        {
          "s": 2,
          "text": "(דענין האמת הוא שאינו משתנה)"
        },
        {
          "s": 3,
          "text": "הוא גם מצד שרשו,"
        },
        {
          "s": 4,
          "text": "דהבחינה שממנה באה ההמשכה דתיקון הז' היא אני הוי' לא שניתי40."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה ע\"פ הידוע41"
        },
        {
          "s": 2,
          "text": "שכל הגבוה גבוה ביותר נמשך למטה מטה ביותר,"
        },
        {
          "s": 3,
          "text": "מובן,"
        },
        {
          "s": 4,
          "text": "דתיקון השביעי,"
        },
        {
          "s": 5,
          "text": "תיקון ואמת,"
        },
        {
          "s": 6,
          "text": "נמשך בעיקר למטה."
        },
        {
          "s": 7,
          "text": "והענין הוא,"
        },
        {
          "s": 8,
          "text": "דהנה אמיתית הענין דאני הוי' לא שניתי הוא בעצמותו ומהותו ית' שמציאותו42"
        },
        {
          "s": 9,
          "text": "הוא מעצמותו ואינו עלול מאיזה עילה שקדמה לו ח\"ו."
        },
        {
          "s": 10,
          "text": "כי בהגילויים43,"
        },
        {
          "s": 11,
          "text": "שקדמה להם עילה וסיבה,"
        },
        {
          "s": 12,
          "text": "אין לומר אמיתית הענין דלא שניתי,"
        },
        {
          "s": 13,
          "text": "וזה גופא שקדמה להם עילה וסיבה,"
        },
        {
          "s": 14,
          "text": "הרי זה שינוי,"
        },
        {
          "s": 15,
          "text": "שהרי ישנו שינוי בין לפני שנמשכה מהעילה וסיבה,"
        },
        {
          "s": 16,
          "text": "ובעת שנמשכה מהעילה וסיבה,"
        },
        {
          "s": 17,
          "text": "ולאחר שנמשכה מהעילה וסיבה."
        },
        {
          "s": 18,
          "text": "משא\"כ בעצמותו ומהותו ית' שאינו עלול מאיזה עילה שקדמה לו ח\"ו,"
        },
        {
          "s": 19,
          "text": "הרי אין בו שום שינויים ח\"ו,"
        },
        {
          "s": 20,
          "text": "אמיתית הענין דאני הוי' לא שניתי."
        },
        {
          "s": 21,
          "text": "וענין זה נמשך בעיקר למטה,"
        },
        {
          "s": 22,
          "text": "וכמו שמבאר כ\"ק אדמו\"ר האמצעי44,"
        },
        {
          "s": 23,
          "text": "דזה שהיש דלמטה מרגיש שמציאותו מעצמותו,"
        },
        {
          "s": 24,
          "text": "ובהרגשתו לא קדמה לו עילה וסיבה,"
        },
        {
          "s": 25,
          "text": "הוא מפני ששרשו הוא מעצמותו ומהותו ית' שמציאותו הוא מעצמותו ואינו עלול מאיזה עילה שקדמה לו ח\"ו,"
        },
        {
          "s": 26,
          "text": "דאמיתית המציאות דיש הנברא הוא יש האמיתי."
        },
        {
          "s": 27,
          "text": "וכמבואר בארוכה בד\"ה מי כמוכה לכ\"ק אדמו\"ר מהר\"ש45"
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "[אשר,"
        },
        {
          "s": 1,
          "text": "כפי שגילה כ\"ק מו\"ח אדמו\"ר46"
        },
        {
          "s": 2,
          "text": "– לכל אחד מהרביים היו מאמרים קבועים אשר פעם בשתים או בשלש שנים היו חוזרים עליהם ברבים,"
        },
        {
          "s": 3,
          "text": "ואחד ממאמרי כ\"ק אדמו\"ר מהר\"ש אלה – הי' ד\"ה מי כמוכה],"
        }
      ]
    }
  ]
}