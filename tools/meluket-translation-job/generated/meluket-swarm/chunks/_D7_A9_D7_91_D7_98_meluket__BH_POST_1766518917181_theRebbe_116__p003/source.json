{
  "globalIndex": 599,
  "owner": 49,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917181_theRebbe_116__p003",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917181_theRebbe_116__p003",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518917181_theRebbe_116",
  "title": "מאמר זה יתנו תש\"מ",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ובזה יובן מה שמסיים לכפר על נפשותיכם,"
        },
        {
          "s": 2,
          "text": "שעי\"ז פועל תיקון של החטאים עד לחטא העגל."
        },
        {
          "s": 3,
          "text": "כי מכיון שע\"י הבירורים מתעלה למקום נעלה ביותר,"
        },
        {
          "s": 4,
          "text": "בחי' התוהו שקדם אל התיקון,"
        },
        {
          "s": 5,
          "text": "ולמעלה מזה,"
        },
        {
          "s": 6,
          "text": "במקום שיעקב הוא הבכור"
        },
        {
          "s": 7,
          "text": "(וכמשל השפופרת שהטיפה הנכנסת ראשונה תצא אחרונה28),"
        },
        {
          "s": 8,
          "text": "עד למעלה מזה,"
        },
        {
          "s": 9,
          "text": "במקום ששניהם שוים,"
        },
        {
          "s": 10,
          "text": "הלא אח עשו ליעקב29,"
        },
        {
          "s": 11,
          "text": "עד לבחי' אחדות הפשוטה,"
        },
        {
          "s": 12,
          "text": "הרי פשוט הוא שמשם נמשך תיקון כל החסרונות והפגמים וכו'."
        },
        {
          "s": 13,
          "text": "וזהו ענין עשרים גרה הנ\"ל,"
        },
        {
          "s": 14,
          "text": "דאיתא בספר הבהיר30"
        },
        {
          "s": 15,
          "text": "ע\"ס מלמטלמ\"ע לא ידענו מלמעלמ\"ט ידענו,"
        },
        {
          "s": 16,
          "text": "כי ע\"י העבודה בבחי' ע\"ס מלמטלמ\"ע ממשיכים מבחי' לא ידענו,"
        },
        {
          "s": 17,
          "text": "שלמעלה לגמרי מענין הידיעה וכו'."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "וזהו גם מה שזה הי' התיקון לחטא העגל,"
        },
        {
          "s": 1,
          "text": "דחטא העגל הי' כאשר בושש משה לרדת גו'31,"
        },
        {
          "s": 2,
          "text": "וארז\"ל32"
        },
        {
          "s": 3,
          "text": "א\"ת בושש אלא באו שש,"
        },
        {
          "s": 4,
          "text": "שבאה שעה ששית,"
        },
        {
          "s": 5,
          "text": "חצי היום,"
        },
        {
          "s": 6,
          "text": "ולא בא,"
        },
        {
          "s": 7,
          "text": "והתיקון לזה הוא ע\"י העבודה דמחצית השקל דוקא33."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה כשם שע\"י נתינת מחצית השקל הקריבו קרבנות בכל השנה,"
        },
        {
          "s": 2,
          "text": "עד\"ז בעבודה,"
        },
        {
          "s": 3,
          "text": "שצ\"ל העבודה הנ\"ל בכל השנה,"
        },
        {
          "s": 4,
          "text": "ובאופן של שמחה וטוב לבב,"
        },
        {
          "s": 5,
          "text": "מרוב כל,"
        },
        {
          "s": 6,
          "text": "היינו דתמורת זה שהי' חוסר כל יהי' מרוב כל,"
        },
        {
          "s": 7,
          "text": "ולמעלה מזה,"
        },
        {
          "s": 8,
          "text": "שהרי יפה שעה אחת בתשובה ומעשים טובים בעוה\"ז מכל חיי העוה\"ב34."
        },
        {
          "s": 9,
          "text": "אלא שמפני טעם הידוע ליוצרם הרי עכשיו אין הענינים בגלוי,"
        },
        {
          "s": 10,
          "text": "ובקרוב ממש יהי' ונגלה כבוד הוי' וראו כל בשר יחדיו גו'35."
        },
        {
          "s": 11,
          "text": "ויה\"ר שבקרוב נקיים מצות מחצית השקל בביהמ\"ק השלישי,"
        },
        {
          "s": 12,
          "text": "נשמות בגופים ומתוך בריאות הנכונה ובהרחבה,"
        },
        {
          "s": 13,
          "text": "והקיצו ורננו שוכני עפר36"
        },
        {
          "s": 14,
          "text": "ואהרן ומשה עמהם37,"
        },
        {
          "s": 15,
          "text": "וקהל גדול ישובו הנה38,"
        },
        {
          "s": 16,
          "text": "בקרוב ממש."
        }
      ]
    }
  ]
}