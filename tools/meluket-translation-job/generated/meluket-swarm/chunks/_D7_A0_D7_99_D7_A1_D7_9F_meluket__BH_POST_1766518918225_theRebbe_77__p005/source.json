{
  "globalIndex": 763,
  "owner": 13,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918225_theRebbe_77__p005",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918225_theRebbe_77__p005",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518918225_theRebbe_77",
  "title": "מאמר הפך ים ליבשה תשכ\"ז",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ובפרטיות יותר,"
        },
        {
          "s": 1,
          "text": "נעשה ענין זה ע\"י התומ\"צ."
        },
        {
          "s": 2,
          "text": "והענין הוא,"
        },
        {
          "s": 3,
          "text": "דהנה כתיב60"
        },
        {
          "s": 4,
          "text": "היתה כאניות סוחר ממרחק תביא לחמה,"
        },
        {
          "s": 5,
          "text": "דקאי על כנסת ישראל שנמשלה לסוחר,"
        },
        {
          "s": 6,
          "text": "כמבואר בתו\"א61"
        },
        {
          "s": 7,
          "text": "בענין כנען דקדושה שפירושו סוחר,"
        },
        {
          "s": 8,
          "text": "כמו הסוחר שמפזר ממון כדי להרויח ולהשתכר יותר,"
        },
        {
          "s": 9,
          "text": "ודוגמתו הוא כללות הענין דירידת הנשמה למטה לעסוק בהמסחר דבירור וזיכוך עניני העולם לעשות לו ית' דירה בתחתונים."
        },
        {
          "s": 10,
          "text": "וסדר המסחר הוא שמוליכים ומביאים הסחורה מים ליבשה ומיבשה לים ע\"י אניות,"
        },
        {
          "s": 11,
          "text": "ובלשון הזהר62"
        },
        {
          "s": 12,
          "text": "ארבין דסלקין ונחתין בימא,"
        },
        {
          "s": 13,
          "text": "שעל ידם דוקא יכולים הברואים שביבשה לעבור ולהוליך הסחורה מים ליבשה ומיבשה לים מבלי לטבוע בים,"
        },
        {
          "s": 14,
          "text": "וענינו בנמשל,"
        },
        {
          "s": 15,
          "text": "שכדי שהנשמה לא תטבע בההתבוננות בדעת עליון שזוהי הדעה דעלמא דאתכסייא שבבחי' ים,"
        },
        {
          "s": 16,
          "text": "יש צורך באניות,"
        },
        {
          "s": 17,
          "text": "דקאי על התומ\"צ63,"
        },
        {
          "s": 18,
          "text": "שנעשים לבושים להנשמה שבכחם תוכל להגיע למעלת יחו\"ע באופן שלא תתבטל ממציאותה."
        },
        {
          "s": 19,
          "text": "דהנה,"
        },
        {
          "s": 20,
          "text": "אף שהנשמה יש לה לבושים מצד עצמה,"
        },
        {
          "s": 21,
          "text": "שעז\"נ64"
        },
        {
          "s": 22,
          "text": "אך בצלם יתהלך איש,"
        },
        {
          "s": 23,
          "text": "מ\"מ,"
        },
        {
          "s": 24,
          "text": "מצד ירידתה למטה יכולים להיות הלבושים שלא כדבעי,"
        },
        {
          "s": 25,
          "text": "ולכן יש צורך בהלבושים דתומ\"צ שעל ידם מתתקנים לבושי הנשמה,"
        },
        {
          "s": 26,
          "text": "ואז יש בכחה של הנשמה למטה לבוא למעלת יחו\"ע מבלי שתתבטל מציאותה."
        },
        {
          "s": 27,
          "text": "ועד\"ז בנוגע לכללות ההמשכה מן העולם ועד העולם,"
        },
        {
          "s": 28,
          "text": "מעלמא דאתכסייא לעלמא דאתגלייא,"
        },
        {
          "s": 29,
          "text": "באופן שהברואים שביבשה לא יתבטלו ממציאותם,"
        },
        {
          "s": 30,
          "text": "שהכח לזה הוא ע\"י קיום התומ\"צ שנתלבשו בעניני העולם."
        },
        {
          "s": 31,
          "text": "וכללות הענין בזה,"
        },
        {
          "s": 32,
          "text": "שתומ\"צ מושרשים ונמשכים מעצמותו ית',"
        },
        {
          "s": 33,
          "text": "שהוא למעלה מגדר עלמין,"
        },
        {
          "s": 34,
          "text": "ועד שעלמא דאתכסייא ועלמא דאתגלייא הם בהשוואה אצלו,"
        },
        {
          "s": 35,
          "text": "ולכן נמשך על ידם הכח להמשכה וגילוי מעלמא דאתכסייא לעלמא דאתגלייא,"
        },
        {
          "s": 36,
          "text": "כנ\"ל."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יתבאר העילוי דקרי\"ס שע\"ז נאמר הפך ים ליבשה."
        },
        {
          "s": 2,
          "text": "דהנה,"
        },
        {
          "s": 3,
          "text": "הפירוש דהפך ים ליבשה הוא לא רק שנמשך מהים אל היבשה,"
        },
        {
          "s": 4,
          "text": "אלא יתירה מזה,"
        },
        {
          "s": 5,
          "text": "שהים עצמו נהפך ליבשה,"
        },
        {
          "s": 6,
          "text": "והיינו,"
        },
        {
          "s": 7,
          "text": "לא רק שנמשך איזה המשכה וגילוי מים ליבשה,"
        },
        {
          "s": 8,
          "text": "מעלמין סתימין לעלמין דאתגליין"
        },
        {
          "s": 9,
          "text": "(שזהו\"ע דברוך גו' מן העולם ועד העולם),"
        },
        {
          "s": 10,
          "text": "אלא יתירה מזה,"
        },
        {
          "s": 11,
          "text": "שההעלם עצמו בא בגילוי,"
        },
        {
          "s": 12,
          "text": "היינו,"
        },
        {
          "s": 13,
          "text": "שבעלמין דאתגליין"
        },
        {
          "s": 14,
          "text": "(יבשה)"
        },
        {
          "s": 15,
          "text": "נתגלה האור האלקי כמו שהוא בעלמין סתימין"
        },
        {
          "s": 16,
          "text": "(ים)"
        },
        {
          "s": 17,
          "text": "ממש65."
        },
        {
          "s": 18,
          "text": "וממשיך בכתוב בנהר יעברו ברגל"
        },
        {
          "s": 19,
          "text": "(שלפירוש הב' קאי גם זה על קרי\"ס,"
        },
        {
          "s": 20,
          "text": "כנ\"ל ס\"א),"
        },
        {
          "s": 21,
          "text": "דאף שהפך ים ליבשה,"
        },
        {
          "s": 22,
          "text": "שבעלמין דאתגליין נתגלה האור האלקי כמו שהוא בעלמין סתימין ממש,"
        },
        {
          "s": 23,
          "text": "מ\"מ,"
        },
        {
          "s": 24,
          "text": "לא נשתנתה מציאות הברואים שבעלמא דאתגלייא להיות כמו הברואים שבעלמא דאתכסייא,"
        },
        {
          "s": 25,
          "text": "נוני ימא,"
        },
        {
          "s": 26,
          "text": "אלא נשארו במציאותם כברואים שביבשה באותה שעה שעברו בנהר והאיר אצלם גילוי האור האלקי דבחי' ים,"
        },
        {
          "s": 27,
          "text": "כמ\"ש66"
        },
        {
          "s": 28,
          "text": "ובני ישראל הלכו ביבשה בתוך הים,"
        },
        {
          "s": 29,
          "text": "בבחי' נוני ימא דמהלכין ביבשתא67."
        },
        {
          "s": 30,
          "text": "וממשיך הכתוב שם נשמחה בו"
        },
        {
          "s": 31,
          "text": "(שגם זה קאי על קרי\"ס כנ\"ל),"
        },
        {
          "s": 32,
          "text": "שבזה מבאר כיצד אפ\"ל הענין דהפך ים ליבשה באופן"
        },
        {
          "s": 33,
          "text": "(שלא יבטלו ממציאותם אלא)"
        },
        {
          "s": 34,
          "text": "דבנהר יעברו ברגל,"
        },
        {
          "s": 35,
          "text": "שזהו לפי ששם נשמחה בו,"
        },
        {
          "s": 36,
          "text": "בו דייקא,"
        },
        {
          "s": 37,
          "text": "היינו בעצמותו."
        },
        {
          "s": 38,
          "text": "והענין בזה,"
        },
        {
          "s": 39,
          "text": "שכדי להיות הענין דהפך ים ליבשה,"
        },
        {
          "s": 40,
          "text": "שבחי' ההעלם שבעלמין סתימין עצמו יבוא ויומשך בגילוי בעלמין דאתגליין"
        },
        {
          "s": 41,
          "text": "(לא רק המשכת הארה מעלמין סתימין לעלמין דאתגליין),"
        },
        {
          "s": 42,
          "text": "ה\"ז רק בכח העצמות"
        },
        {
          "s": 43,
          "text": "(בו בעצמותו)"
        },
        {
          "s": 44,
          "text": "שהוא למעלה מהגדרים דים ויבשה כו',"
        },
        {
          "s": 45,
          "text": "וכיון שענין זה נעשה בכח העצמות,"
        },
        {
          "s": 46,
          "text": "הרי בכח העצמות שהגילוי דבחי' ים ביבשה,"
        },
        {
          "s": 47,
          "text": "הפך ים ליבשה,"
        },
        {
          "s": 48,
          "text": "יהי' באופן שהברואים שביבשה לא יבטלו ממציאותם אלא בנהר יעברו ברגל."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "וזהו גם הביאור בב' הענינים שנאמרו בכתוב לגוזר ים סוף לגזרים כי לעולם חסדו והעביר ישראל בתוכו כי לעולם חסדו."
        },
        {
          "s": 1,
          "text": "דהנה,"
        },
        {
          "s": 2,
          "text": "החסד הא' הוא הענין דקרי\"ס כשלעצמו,"
        },
        {
          "s": 3,
          "text": "שהפך ים ליבשה,"
        },
        {
          "s": 4,
          "text": "היינו,"
        },
        {
          "s": 5,
          "text": "שבעלמין דאתגליין נתגלה האור האלקי כמו שהוא בעלמין סתימין ממש,"
        },
        {
          "s": 6,
          "text": "שענין זה כשלעצמו הוא חסד הוי',"
        },
        {
          "s": 7,
          "text": "ועז\"נ לגוזר ים סוף לגזרים כי לעולם חסדו."
        },
        {
          "s": 8,
          "text": "ולאח\"ז מוסיף בכתוב והעביר ישראל בתוכו כי לעולם חסדו,"
        },
        {
          "s": 9,
          "text": "שזהו חסד נוסף שבנ\"י לא נתבטלו מפני עוצם גילוי האור דעלמין סתימין,"
        },
        {
          "s": 10,
          "text": "אלא הלכו בתוך הים ביבשה,"
        },
        {
          "s": 11,
          "text": "בנהר יעברו ברגל."
        },
        {
          "s": 12,
          "text": "ולא עוד אלא שהחסד הב' שהעביר ישראל בתוכו הוא נעלה יותר באין ערוך מחסד הא' שבקרי\"ס כשלעצמו,"
        },
        {
          "s": 13,
          "text": "כי,"
        },
        {
          "s": 14,
          "text": "הענין דהעברת בנ\"י בתוך הים ביבשה"
        },
        {
          "s": 15,
          "text": "(שלא נתבטלו מעוצם הגילוי דהים)"
        },
        {
          "s": 16,
          "text": "הוא בכח העצמות דוקא,"
        },
        {
          "s": 17,
          "text": "שלמעלה מהגדרים דים ויבשה כו',"
        },
        {
          "s": 18,
          "text": "כנ\"ל."
        }
      ]
    }
  ]
}