{
  "globalIndex": 24,
  "owner": 24,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913820_theRebbe_687__p003",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913820_theRebbe_687__p003",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518913820_theRebbe_687",
  "title": "מאמר זה היום תחילת מעשיך תשמ\"א",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ויש לומר שהכח שיש בישראל להמשיך גילוי בחי' זו,"
        },
        {
          "s": 2,
          "text": "הוא מצד שרש נשמתם"
        },
        {
          "s": 3,
          "text": "[שהרי בריאת האדם ביום ששי למע\"ב"
        },
        {
          "s": 4,
          "text": "(ראש השנה)"
        },
        {
          "s": 5,
          "text": "היא שאז הי' ויפח באפיו נשמת חיים34."
        },
        {
          "s": 6,
          "text": "משא\"כ גופו של אדם הראשון שנוצר מעפר מן האדמה34"
        },
        {
          "s": 7,
          "text": "שנבראה כבר"
        },
        {
          "s": 8,
          "text": "(כנ\"ל)"
        },
        {
          "s": 9,
          "text": "ביום הראשון35]."
        },
        {
          "s": 10,
          "text": "והענין הוא,"
        },
        {
          "s": 11,
          "text": "דהנה כתיב34"
        },
        {
          "s": 12,
          "text": "ויפח באפיו נשמת חיים,"
        },
        {
          "s": 13,
          "text": "ומבאר רבינו הזקן36"
        },
        {
          "s": 14,
          "text": "כמ\"ש בזהר37"
        },
        {
          "s": 15,
          "text": "מאן דנפח מתוכי' נפח,"
        },
        {
          "s": 16,
          "text": "ומפרש מתוכיותו ומפנימיותו,"
        },
        {
          "s": 17,
          "text": "היינו ד"
        },
        {
          "s": 18,
          "text": "(שרש)"
        },
        {
          "s": 19,
          "text": "הנשמה הוא בעצמותו ית'."
        },
        {
          "s": 20,
          "text": "והגם שממשיך שם,"
        },
        {
          "s": 21,
          "text": "דכמו שהבן נמשך ממוח האב כך כביכול נשמת כל איש ישראל נמשכה ממחשבתו וחכמתו ית',"
        },
        {
          "s": 22,
          "text": "הנה זה שהנשמה היא בבחי' מחשבתו וחכמתו ית' הוא כמו שהיא באה בהמשכה,"
        },
        {
          "s": 23,
          "text": "אבל שרשה"
        },
        {
          "s": 24,
          "text": "(האמיתי)"
        },
        {
          "s": 25,
          "text": "הוא בעצמותו ית'."
        },
        {
          "s": 26,
          "text": "דכמו שהוא בהמשל דאב ובן,"
        },
        {
          "s": 27,
          "text": "דשרש הבן הוא מעצמות האב ממש שלמעלה מבחי' הגילויים"
        },
        {
          "s": 28,
          "text": "(דהאב),"
        },
        {
          "s": 29,
          "text": "שלכן אפשר שיהי' יפה כח הבן מכח האב38"
        },
        {
          "s": 30,
          "text": "כי שרש הבן הוא מעצם נפש האב ובעצם נפשו הרי האב שלם בכל כוחותיו39,"
        },
        {
          "s": 31,
          "text": "עד\"ז הוא גם בנשמות ישראל,"
        },
        {
          "s": 32,
          "text": "בנים אתם להוי' אלקיכם40,"
        },
        {
          "s": 33,
          "text": "ששרשם הוא בעצמותו ית'"
        },
        {
          "s": 34,
          "text": "(שלמעלה מבחי' הגילויים),"
        },
        {
          "s": 35,
          "text": "ולכן יש בהם עילוי כביכול על בחי' הגילויים שלמעלה,"
        },
        {
          "s": 36,
          "text": "בדוגמת יפה כח הבן מכח האב."
        },
        {
          "s": 37,
          "text": "וכמרז\"ל41"
        },
        {
          "s": 38,
          "text": "קוב\"ה חייך ואמר נצחוני בני נצחוני,"
        },
        {
          "s": 39,
          "text": "קוב\"ה הוא אוא\"ס כמו שבא בהמשכה באופן דקדוש וברוך"
        },
        {
          "s": 40,
          "text": "[קדוש הוא סוכ\"ע,"
        },
        {
          "s": 41,
          "text": "שהוא קדוש ומובדל מהשתלשלות,"
        },
        {
          "s": 42,
          "text": "וברוך מלשון ברכה והמשכה הוא כמו שנמשך להיות ממכ\"ע42],"
        },
        {
          "s": 43,
          "text": "ומכיון ששרש הנשמות הוא בעצמותו ית'"
        },
        {
          "s": 44,
          "text": "(שלמעלה גם מבחי' קדוש),"
        },
        {
          "s": 45,
          "text": "לכן קוב\"ה חייך ואמר נצחוני בני נצחוני"
        },
        {
          "s": 46,
          "text": "[וענין זה שייך במיוחד לראש השנה,"
        },
        {
          "s": 47,
          "text": "כמאמר רז\"ל43,"
        },
        {
          "s": 48,
          "text": "כשמתכנסין מלאכי השרת לפני הקב\"ה לומר אימתי ראש השנה כו' הקב\"ה אומר להם לי מה אתם שואלים,"
        },
        {
          "s": 49,
          "text": "אני ואתם נלך אצל ב\"ד של מטה]."
        },
        {
          "s": 50,
          "text": "ובפרט ע\"פ תורת הרב המגיד44"
        },
        {
          "s": 51,
          "text": "בפירוש מרז\"ל45"
        },
        {
          "s": 52,
          "text": "ישראל עלו במחשבה,"
        },
        {
          "s": 53,
          "text": "שהוא כמשל הבן שצורתו חקוקה במחשבת האב,"
        },
        {
          "s": 54,
          "text": "אלא שבבני אדם שייך זה דוקא לאחרי שנולד הבן,"
        },
        {
          "s": 55,
          "text": "משא\"כ אצל השי\"ת,"
        },
        {
          "s": 56,
          "text": "אף קודם שנבראו ישראל הי' נחקק צורתם במחשבה,"
        },
        {
          "s": 57,
          "text": "כי אצלו ית' העבר והעתיד אחד."
        },
        {
          "s": 58,
          "text": "שמזה מובן עוד יותר46,"
        },
        {
          "s": 59,
          "text": "דשרש הנשמות"
        },
        {
          "s": 60,
          "text": "(בנים אתם לה' אלקיכם)"
        },
        {
          "s": 61,
          "text": "הוא בעצמותו ית'."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ויש לומר שזהו מ\"ש אדמו\"ר הזקן36"
        },
        {
          "s": 2,
          "text": "בענין ויפח באפיו נשמת חיים,"
        },
        {
          "s": 3,
          "text": "שהוא בבחי' נפיחה בכח כביכול47,"
        },
        {
          "s": 4,
          "text": "דזה שצריך להיות נפיחה בכח הוא מפני ששרש הנשמה הוא בבחי' העלם העצמי,"
        },
        {
          "s": 5,
          "text": "העלם שאינו במציאות,"
        },
        {
          "s": 6,
          "text": "וההמשכה מבחי' העלם שאינו במציאות היא ע\"י טרחא ויגיעה דוקא."
        },
        {
          "s": 7,
          "text": "דהנה ידוע שבכדי להמשיך מהעלם שישנו במציאות אין צריך לטרחא ויגיעה."
        },
        {
          "s": 8,
          "text": "וכמו שלהבת הקשורה בגחלת,"
        },
        {
          "s": 9,
          "text": "דלהיות שגם בתוך הגחלת היא במציאות אש אלא שאינה נראה ונגלה בחוץ"
        },
        {
          "s": 10,
          "text": "(העלם שישנו במציאות),"
        },
        {
          "s": 11,
          "text": "לכן הוצאת השלהבת מהגחלת היא בלי עמל ויגיעה."
        },
        {
          "s": 12,
          "text": "משא\"כ ההמשכה מבחי' העלם שאינו במציאות היא ע\"י טרחא ויגיעה דוקא."
        },
        {
          "s": 13,
          "text": "וכמו הוצאת האש מצור החלמיש,"
        },
        {
          "s": 14,
          "text": "דלהיות האש שבצור הוא בבחי' העלם שאינו במציאות,"
        },
        {
          "s": 15,
          "text": "לכן אי אפשר להוציא ממנו אש כ\"א ע\"י הכאה,"
        },
        {
          "s": 16,
          "text": "בטרחא ויגיעה דוקא."
        },
        {
          "s": 17,
          "text": "וכמבואר כ\"ז בארוכה בדרושי כ\"ק אדמו\"ר"
        },
        {
          "s": 18,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 19,
          "text": "נ\"ע48."
        },
        {
          "s": 20,
          "text": "וזהו מ\"ש אדה\"ז שויפח באפיו נשמת חיים הוא בבחי' נפיחה בכח,"
        },
        {
          "s": 21,
          "text": "כי שרש הנשמות הוא בבחי' העלם שאינו במציאות,"
        },
        {
          "s": 22,
          "text": "בחי' צור"
        },
        {
          "s": 23,
          "text": "[וכמבואר בלקו\"ת49"
        },
        {
          "s": 24,
          "text": "בענין התשובה דוהרוח תשוב אל האלקים אשר נתנה50,"
        },
        {
          "s": 25,
          "text": "דבחי' האלקים"
        },
        {
          "s": 26,
          "text": "(אשר נתנה)"
        },
        {
          "s": 27,
          "text": "שהוא שרש הנשמה"
        },
        {
          "s": 28,
          "text": "(ומבחינה זו ניתנה הנשמה באופן דנתינה,"
        },
        {
          "s": 29,
          "text": "דכל51"
        },
        {
          "s": 30,
          "text": "הנותן בעין יפה הוא נותן52)"
        },
        {
          "s": 31,
          "text": "הוא בחי' צור],"
        },
        {
          "s": 32,
          "text": "ולכן ההמשכה משם היא ע\"י נפיחה בכח."
        },
        {
          "s": 33,
          "text": "ולהיות דשרש נש\"י הוא בעצמותו ית' לכן ביכלתם להמשיך בעולם גילוי עצמות אוא\"ס."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה הנ\"ל הוא ביאור על זה שבכחם של ישראל להמשיך גילוי עצמות אוא\"ס."
        },
        {
          "s": 2,
          "text": "אמנם זה שממשיכים גילוי זה בעולם,"
        },
        {
          "s": 3,
          "text": "חיבור בחי' זה עם בחי' כה33,"
        },
        {
          "s": 4,
          "text": "י\"ל שהוא ע\"י שממשיכים גילוי נשמתם בגופם."
        },
        {
          "s": 5,
          "text": "דהנה גוף האדם"
        },
        {
          "s": 6,
          "text": "(שנוצר מעפר מן האדמה שנברא בכ\"ה באלול)"
        },
        {
          "s": 7,
          "text": "הוא בחי' כה,"
        },
        {
          "s": 8,
          "text": "וע\"י שפועל גילוי אלקות בגופו,"
        },
        {
          "s": 9,
          "text": "עי\"ז הוא ממשיך גילוי אלקות גם בעולם."
        },
        {
          "s": 10,
          "text": "דבמדה שאדם מודד בה מודדין לו53,"
        },
        {
          "s": 11,
          "text": "ולכן ע\"י שהאדם ממשיך הגילוי דבחי' זה בבחי' כה שבעצמו,"
        },
        {
          "s": 12,
          "text": "עי\"ז נמשך הגילוי דבחי' זה גם בבחי' כה דכל העולם54."
        },
        {
          "s": 13,
          "text": "וכמו אדם הראשון שאמר לכל הבריאה בואו נשתחוה ונכרעה נברכה לפני ה' עושינו55,"
        },
        {
          "s": 14,
          "text": "דזה שפעל ביטול בכל הבריאה"
        },
        {
          "s": 15,
          "text": "(שחוץ ממנו)"
        },
        {
          "s": 16,
          "text": "הוא ע\"י פעולת הביטול בעצמו."
        },
        {
          "s": 17,
          "text": "וכפירוש נשתחוה"
        },
        {
          "s": 18,
          "text": "(ולא השתחוו),"
        },
        {
          "s": 19,
          "text": "היינו56"
        },
        {
          "s": 20,
          "text": "ש"
        },
        {
          "s": 21,
          "text": "(גם)"
        },
        {
          "s": 22,
          "text": "הוא עצמו ישתחוה ויהי' בביטול."
        },
        {
          "s": 23,
          "text": "וביאור הענין"
        },
        {
          "s": 24,
          "text": "(זה שהמשכת גילוי אלקות בעולם היא ע\"י קדימת ההמשכה בגוף האדם),"
        },
        {
          "s": 25,
          "text": "הנה שם אדם הוא על שם אדמה לעליון57,"
        },
        {
          "s": 26,
          "text": "וי\"ל דזהו בנשמת האדם וגם בגוף האדם,"
        },
        {
          "s": 27,
          "text": "כמ\"ש58"
        },
        {
          "s": 28,
          "text": "נעשה אדם גו' כדמותנו59."
        },
        {
          "s": 29,
          "text": "וכמו שגופו של אדם הראשון הי' יציר כפיו של הקב\"ה60,"
        },
        {
          "s": 30,
          "text": "עד\"ז הוא גם בהנוגע להגוף דכאו\"א מישראל,"
        },
        {
          "s": 31,
          "text": "שהרי אתם קרויים אדם ע\"ש אדם הראשון"
        },
        {
          "s": 32,
          "text": "(כנ\"ל)."
        },
        {
          "s": 33,
          "text": "וזה שכאו\"א מישראל נקרא אדם ע\"ש אדמה לעליון,"
        },
        {
          "s": 34,
          "text": "בין מצד נשמתו בין מצד גופו,"
        },
        {
          "s": 35,
          "text": "הו\"ע נצחי שאין שייך בו שינוי."
        },
        {
          "s": 36,
          "text": "וכמ\"ש61"
        },
        {
          "s": 37,
          "text": "ואתם תהיו לי ממלכת כהנים וגוי קדוש,"
        },
        {
          "s": 38,
          "text": "די\"ל שממלכת כהנים קאי על הנשמה וגוי קדוש קאי על הגוף62,"
        },
        {
          "s": 39,
          "text": "ובשניהם נאמר ואתם תהיו לי,"
        },
        {
          "s": 40,
          "text": "דכל מקום שנאמר לי אינו זז לעולם63."
        },
        {
          "s": 41,
          "text": "ולכן ע\"י עבודת האדם להמשיך גילוי אלקות בגופו,"
        },
        {
          "s": 42,
          "text": "נמשך עי\"ז גילוי אלקות גם בעולם."
        }
      ]
    }
  ]
}