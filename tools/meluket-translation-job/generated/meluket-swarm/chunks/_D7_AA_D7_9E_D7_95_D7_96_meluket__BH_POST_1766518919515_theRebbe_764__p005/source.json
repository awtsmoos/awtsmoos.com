{
  "globalIndex": 969,
  "owner": 19,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919515_theRebbe_764__p005",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919515_theRebbe_764__p005",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919515_theRebbe_764",
  "title": "מאמר גדול יהי' תשכ\"ב",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "אלא שגם המשל דאור ומאור אינו מספיק,"
        },
        {
          "s": 1,
          "text": "כי באור ומאור,"
        },
        {
          "s": 2,
          "text": "קירוב האור להמאור וביטולו אליו הוא באופן שהאור אינו מציאות כלל וכל ענינו הוא שהוא גילוי המאור."
        },
        {
          "s": 3,
          "text": "משא\"כ בהנמשל,"
        },
        {
          "s": 4,
          "text": "גם בההתהוות שמשם הוי' כתיב כי הוא צוה ונבראו,"
        },
        {
          "s": 5,
          "text": "דענין בריאה הוא"
        },
        {
          "s": 6,
          "text": "(לא התפשטות וגילוי המקור,"
        },
        {
          "s": 7,
          "text": "אלא)"
        },
        {
          "s": 8,
          "text": "התהוות דבר."
        },
        {
          "s": 9,
          "text": "וכמובן גם ממ\"ש בתניא51,"
        },
        {
          "s": 10,
          "text": "שגם באם היתה ההתהוות משם הוי' שלא ע\"י הצמצום דשם אלקים היו מתהווים הנבראים מאין ליש"
        },
        {
          "s": 11,
          "text": "(אלא שאז היו בטלים בתכלית,"
        },
        {
          "s": 12,
          "text": "כביטול זיו השמש בשמש)."
        },
        {
          "s": 13,
          "text": "ובכדי לבאר שגם מציאות דבר הוא בקירוב למקורו,"
        },
        {
          "s": 14,
          "text": "הוא ע\"י המשל דעילה ועלול."
        },
        {
          "s": 15,
          "text": "דהגם שהעלול הוא מציאות ולא גילוי העילה מ\"מ הוא בקירוב להעילה."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דהטעם על זה שהמשל דעילה ועלול מובא לפני המשל דאור ומאור,"
        },
        {
          "s": 2,
          "text": "הוא,"
        },
        {
          "s": 3,
          "text": "כי עיקר החידוש בזה שהנבראים שמתהווים משם הוי' הם בטלים להוי',"
        },
        {
          "s": 4,
          "text": "הוא,"
        },
        {
          "s": 5,
          "text": "שהגם שהם נבראים"
        },
        {
          "s": 6,
          "text": "(מציאות דבר)"
        },
        {
          "s": 7,
          "text": "מ\"מ נרגש בהם בגילוי האור דשם הוי',"
        },
        {
          "s": 8,
          "text": "וענין זה מובן דוקא מהמשל דעילה ועלול."
        },
        {
          "s": 9,
          "text": "אלא שבכדי לבאר שגילוי המקור ישנו גם בדבר שבאין ערוך להמקור,"
        },
        {
          "s": 10,
          "text": "מוסיפים המשל דאור ומאור."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה ידוע52"
        },
        {
          "s": 2,
          "text": "דזה שהעולם מוגדר בגדר דמקום וזמן הוא לפי שהתהוותו היא ע\"י שם אלקים,"
        },
        {
          "s": 3,
          "text": "ובאם הי' מתהווה משם הוי'"
        },
        {
          "s": 4,
          "text": "(הי' הוה ויהי' כאחד53)"
        },
        {
          "s": 5,
          "text": "לא הי' מוגדר בהגדר דמקום וזמן."
        },
        {
          "s": 6,
          "text": "וזהו שבביהמ\"ק כתיב אכן יש הוי' במקום הזה,"
        },
        {
          "s": 7,
          "text": "כי54"
        },
        {
          "s": 8,
          "text": "בביהמ\"ק המקום הי' למעלה מגדר מקום,"
        },
        {
          "s": 9,
          "text": "מקום הארון אינו מן המדה55."
        },
        {
          "s": 10,
          "text": "אלא שהגילוי שהאיר בביהמ\"ק הי' הגילוי דשם הוי' כמו שמאיר בשם אלקים."
        },
        {
          "s": 11,
          "text": "דשם הוי' כמו שהוא מצד עצמו הוא למעלה מגדר מקום,"
        },
        {
          "s": 12,
          "text": "וזה שקודש הקדשים הי' מקום מדוד ומוגבל"
        },
        {
          "s": 13,
          "text": "(עשרים אמה על עשרים אמה),"
        },
        {
          "s": 14,
          "text": "וגם הארון הי' במדידה דמקום"
        },
        {
          "s": 15,
          "text": "(אמתיים וחצי ארכו ואמה וחצי רחבו),"
        },
        {
          "s": 16,
          "text": "ואעפ\"כ מקום הארון אינו מן המדה,"
        },
        {
          "s": 17,
          "text": "הו\"ע יחוד הוי' ואלקים56."
        },
        {
          "s": 18,
          "text": "וצריך להבין,"
        },
        {
          "s": 19,
          "text": "דכיון שגם בההתהוות שמשם הוי' מתהווה דבר חדש שאינו בערך להמקור המהווה"
        },
        {
          "s": 20,
          "text": "[והגילוי דשם הוי' בהעולם שנתהווה ממנו הוא רק בענין הביטול,"
        },
        {
          "s": 21,
          "text": "שנרגש בהם שמציאותם היא רק זה שהאור האלקי מהוה אותם בכל רגע]57,"
        },
        {
          "s": 22,
          "text": "הרי גם בהעולם כמו שנתהווה משם הוי' הי' צריך להיות לכאורה ההגבלה דזמן ומקום."
        }
      ]
    }
  ]
}