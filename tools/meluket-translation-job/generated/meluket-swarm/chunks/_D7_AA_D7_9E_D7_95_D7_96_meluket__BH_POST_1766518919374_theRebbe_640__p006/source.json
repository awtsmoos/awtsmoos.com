{
  "globalIndex": 954,
  "owner": 4,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919374_theRebbe_640__p006",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919374_theRebbe_640__p006",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919374_theRebbe_640",
  "title": "מאמר עשרה שיושבין תשמ\"ב",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש להוסיף עוד ענין במעלת עשרה שיושבין ועוסקין בתורה,"
        },
        {
          "s": 1,
          "text": "דכיון שאין דיעותיהן שוות85,"
        },
        {
          "s": 2,
          "text": "הרי כל אחד מהעשרה יש לו ההסברה שלו"
        },
        {
          "s": 3,
          "text": "(בהענין שלומדים),"
        },
        {
          "s": 4,
          "text": "וע\"י שלומדים יחד וכל אחד אומר ההסברה שלו להמשתתפים בהשיעור,"
        },
        {
          "s": 5,
          "text": "יש בזה גם המעלה דעסק התורה עם זולתו."
        },
        {
          "s": 6,
          "text": "ועוד ענין בזה,"
        },
        {
          "s": 7,
          "text": "דע\"י שעשרה מישראל עוסקים בענין אחד,"
        },
        {
          "s": 8,
          "text": "בתורה או בתפלה או בקיום מצוה,"
        },
        {
          "s": 9,
          "text": "מיתוסף בהם ענין חדש – ענין הציבור86,"
        },
        {
          "s": 10,
          "text": "אור העולה על כולנה87."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "והנה לשון רז\"ל הוא הבא לטהר מסייעין לו."
        },
        {
          "s": 3,
          "text": "שכשבא לטהר אחרים,"
        },
        {
          "s": 4,
          "text": "הסיוע הוא מיד כשבא לטהר."
        },
        {
          "s": 5,
          "text": "ומזה מובן,"
        },
        {
          "s": 6,
          "text": "שכל אלה שמסרו עצמם למלאות שליחותו של בעל הגאולה בכלל,"
        },
        {
          "s": 7,
          "text": "ובפרט בהשליחות88"
        },
        {
          "s": 8,
          "text": "לייסד שיעורים ברבים,"
        },
        {
          "s": 9,
          "text": "שע\"י ההתמסרות עצמה"
        },
        {
          "s": 10,
          "text": "(אַריינוואַרפן זיך אין דער אַרבעט,"
        },
        {
          "s": 11,
          "text": "עוד לפני העשי' בפועל)"
        },
        {
          "s": 12,
          "text": "נמשך סיוע ונתינת כח נוספים להצליח עוד יותר במילוי השליחות."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "ויהי רצון,"
        },
        {
          "s": 1,
          "text": "שע\"י המסירה ונתינה למלאות שליחותו של בעל הגאולה,"
        },
        {
          "s": 2,
          "text": "ובפרט אַז מ'האַלט שוין באמצע,"
        },
        {
          "s": 3,
          "text": "והוי' לי"
        },
        {
          "s": 4,
          "text": "(לכל אחד מהמתעסקים בזה)"
        },
        {
          "s": 5,
          "text": "בעוזרי לסיים את השליחות בתכלית השלימות,"
        },
        {
          "s": 6,
          "text": "נזכה מיד לגאולה האמיתית והשלימה ע\"י משיח צדקנו."
        },
        {
          "s": 7,
          "text": "וכיון שנמצאים כעת ביום זכאי – יום השלישי89"
        },
        {
          "s": 8,
          "text": "שהוכפל בו כי טוב90,"
        },
        {
          "s": 9,
          "text": "ויום החמשה עשר דחודש הגאולה שבו קיימא סיהרא באשלמותא91"
        },
        {
          "s": 10,
          "text": "(השלימות דחודש הגאולה),"
        },
        {
          "s": 11,
          "text": "הרי הזכות דיום זכאי ימהר92"
        },
        {
          "s": 12,
          "text": "עוד יותר הגאולה,"
        },
        {
          "s": 13,
          "text": "במהרה בימינו ממש."
        }
      ]
    }
  ]
}