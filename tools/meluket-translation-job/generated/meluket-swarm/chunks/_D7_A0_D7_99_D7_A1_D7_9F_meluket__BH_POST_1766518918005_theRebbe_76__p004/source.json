{
  "globalIndex": 725,
  "owner": 25,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918005_theRebbe_76__p004",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918005_theRebbe_76__p004",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518918005_theRebbe_76",
  "title": "מאמר כימי צאתך תשל\"ח",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דענין זה"
        },
        {
          "s": 2,
          "text": "[שבהנסים המלובשים בטבע,"
        },
        {
          "s": 3,
          "text": "מהות הנס הוא בגילוי]"
        },
        {
          "s": 4,
          "text": "הוא בעיקר בהנסים שאין בעל הנס מכיר בנסו."
        },
        {
          "s": 5,
          "text": "דהנסים שניכר בגילוי שלבושי הטבע הם רק לבוש להנס שמתלבש בהם,"
        },
        {
          "s": 6,
          "text": "ואפילו הנסים שאין ניכר בהם בגילוי שהוא נס אבל מ\"מ ניכר שהוא דבר בלתי רגיל"
        },
        {
          "s": 7,
          "text": "(כמו ארבעה שצריכים להודות),"
        },
        {
          "s": 8,
          "text": "הם בגדר פלא שאינם מובנים בשכל"
        },
        {
          "s": 9,
          "text": "[שלכן צריכים להודות עליהם,"
        },
        {
          "s": 10,
          "text": "דהודאה הוא ביטול השכל25],"
        },
        {
          "s": 11,
          "text": "והנסים שאין בעל הנס מכיר בנסו הם מלובשים בטבע כ\"כ עד שמושגים בשכל."
        },
        {
          "s": 12,
          "text": "ועפ\"ז יש לומר דזה שהנסים הנמשכים מבחינת לבדו הם באופן שאין בעל הנס מכיר בנסו,"
        },
        {
          "s": 13,
          "text": "הוא,"
        },
        {
          "s": 14,
          "text": "כי הענינים הנמשכים מבחינת לבדו הם בגילוי בכל מקום"
        },
        {
          "s": 15,
          "text": "(כי אין שייך שיהי' איזה דבר שיוכל להעלים עליהם),"
        },
        {
          "s": 16,
          "text": "ולכן הם מלובשים בטבע באופן שאין בעל הנס מכיר בנסו,"
        },
        {
          "s": 17,
          "text": "שאין בהם פלא כלל"
        },
        {
          "s": 18,
          "text": "(גם לא כהפלא דארבעה שצריכים להודות)"
        },
        {
          "s": 19,
          "text": "והם מושגים בשכל26."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה החילוק דשני הסוגים שבנסים בשרשם הוא"
        },
        {
          "s": 2,
          "text": "(כמבואר בשער האמונה שם27)"
        },
        {
          "s": 3,
          "text": "דהנסים המלובשים בטבע שורש המשכתם הוא מזה שאוא\"ס הוא למטה מטה עד אין תכלית28"
        },
        {
          "s": 4,
          "text": "– ענין ההתפשטות והגילוי דאוא\"ס,"
        },
        {
          "s": 5,
          "text": "שהוא מתפשט ומתגלה עד למטה מטה29,"
        },
        {
          "s": 6,
          "text": "ולכן הם באים בגילוי,"
        },
        {
          "s": 7,
          "text": "עד שהם מושגים גם בשכל האדם,"
        },
        {
          "s": 8,
          "text": "והנסים שלמעלה מהטבע שורש המשכתם הוא מזה שאוא\"ס הוא למעלה מעלה עד אין קץ28"
        },
        {
          "s": 9,
          "text": "– ענין ההתעלמות והעלי' שבאוא\"ס,"
        },
        {
          "s": 10,
          "text": "שהוא מתעלה ומתעלם בהעלם אחר העלם ובעילוי אחר עילוי,"
        },
        {
          "s": 11,
          "text": "למעלה מעלה29,"
        },
        {
          "s": 12,
          "text": "ולכן,"
        },
        {
          "s": 13,
          "text": "גם כשהם נמשכים למטה הם למעלה מגילוי,"
        },
        {
          "s": 14,
          "text": "נפלאות."
        },
        {
          "s": 15,
          "text": "וזהו30"
        },
        {
          "s": 16,
          "text": "כימי צאתך מארץ מצרים אראנו נפלאות,"
        },
        {
          "s": 17,
          "text": "שבגאולה העתידה,"
        },
        {
          "s": 18,
          "text": "גם הנפלאות ששורש המשכתם הוא מזה שאוא\"ס למעלה מעלה עד אין קץ,"
        },
        {
          "s": 19,
          "text": "יהיו בגילוי,"
        },
        {
          "s": 20,
          "text": "והגילוי יהי' באופן דראי'31,"
        },
        {
          "s": 21,
          "text": "אראנו."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "שבאראנו נפלאות שיהי' לע\"ל,"
        },
        {
          "s": 2,
          "text": "שני ענינים."
        },
        {
          "s": 3,
          "text": "שגם הנסים דלע\"ל שלא יהיו מלובשים בטבע"
        },
        {
          "s": 4,
          "text": "[כמו בקיעת הים והנהר – והחרים הוי' את לשון ים מצרים והניף ידו על הנהר גו'32]"
        },
        {
          "s": 5,
          "text": "יהיו בגילוי,"
        },
        {
          "s": 6,
          "text": "ע\"ד הנס דקריעת ים סוף שהי' ביציאת מצרים,"
        },
        {
          "s": 7,
          "text": "דהגם שהי' למעלה מהטבע מ\"מ ראו אז בגילוי"
        },
        {
          "s": 8,
          "text": "(לא רק בקיעת הים,"
        },
        {
          "s": 9,
          "text": "אלא גם)"
        },
        {
          "s": 10,
          "text": "הגילוי שעל ידו נבקע הים,"
        },
        {
          "s": 11,
          "text": "שכאו\"א הי' מראה באצבעו ואומר זה אלי ואנוהו33."
        },
        {
          "s": 12,
          "text": "והחידוש באראנו נפלאות דלע\"ל לגבי הגילוי דקריעת ים סוף הוא,"
        },
        {
          "s": 13,
          "text": "שהנפלאות שיהיו לע\"ל יהיו נפלאות גם בערך הנפלאות שהיו ביציאת מצרים,"
        },
        {
          "s": 14,
          "text": "היינו,"
        },
        {
          "s": 15,
          "text": "שהנפלאות דלע\"ל יומשכו ממקום נעלה יותר מהנפלאות שהיו ביציאת מצרים34"
        },
        {
          "s": 16,
          "text": "[ולכן יהיו גם נפלאות גדולות יותר בפשטות],"
        },
        {
          "s": 17,
          "text": "ואעפ\"כ יהיו בגילוי ובאופן דראי'."
        },
        {
          "s": 18,
          "text": "וגם,"
        },
        {
          "s": 19,
          "text": "שהגילוי שהי' בקי\"ס הי' רק לפי שעה,"
        },
        {
          "s": 20,
          "text": "והגילוי דלע\"ל"
        },
        {
          "s": 21,
          "text": "(הגם שיהי' גילוי נעלה יותר מהגילוי שהי' בקי\"ס,"
        },
        {
          "s": 22,
          "text": "מ\"מ)"
        },
        {
          "s": 23,
          "text": "יהי' באופן תמידי ונצחי35."
        },
        {
          "s": 24,
          "text": "ועוד ענין באראנו נפלאות,"
        },
        {
          "s": 25,
          "text": "דע\"י שלע\"ל יתגלו הנפלאות לישראל,"
        },
        {
          "s": 26,
          "text": "תהי' המשכתם גם בעולם באופן של גילוי,"
        },
        {
          "s": 27,
          "text": "ולכן יתלבשו אז בטבע."
        },
        {
          "s": 28,
          "text": "ואעפ\"כ יהיו נפלאות,"
        },
        {
          "s": 29,
          "text": "כי זה שיתלבשו בטבע הוא לא מפני שהם בגדר גילוי"
        },
        {
          "s": 30,
          "text": "[כהנסים המלובשים בטבע עכשיו,"
        },
        {
          "s": 31,
          "text": "ששורש המשכתם הוא מזה שאוא\"ס הוא למטה מטה,"
        },
        {
          "s": 32,
          "text": "ענין ההתפשטות והגילוי דאוא\"ס],"
        },
        {
          "s": 33,
          "text": "אלא,"
        },
        {
          "s": 34,
          "text": "דהגם ששורש המשכתם הוא מזה שאוא\"ס הוא למעלה מעלה עד אין קץ,"
        },
        {
          "s": 35,
          "text": "העלם שלמעלה מגילוי"
        },
        {
          "s": 36,
          "text": "[ויתירה מזה,"
        },
        {
          "s": 37,
          "text": "שהוא העלם שלמעלה גם מגדר גילוי,"
        },
        {
          "s": 38,
          "text": "וכמבואר בהמשך ההילולא36,"
        },
        {
          "s": 39,
          "text": "דזה שאוא\"ס הוא למעלה מעלה כו' הוא שגם בעצמותו אינו בגדר גילוי],"
        },
        {
          "s": 40,
          "text": "מ\"מ יהיו מלובשים בטבע,"
        },
        {
          "s": 41,
          "text": "כי לע\"ל גם ההעלם"
        },
        {
          "s": 42,
          "text": "(שלמעלה מגילוי)"
        },
        {
          "s": 43,
          "text": "יהי' בגילוי."
        }
      ]
    }
  ]
}