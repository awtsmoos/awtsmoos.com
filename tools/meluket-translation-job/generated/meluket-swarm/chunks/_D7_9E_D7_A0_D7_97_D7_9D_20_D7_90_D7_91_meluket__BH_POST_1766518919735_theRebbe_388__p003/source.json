{
  "globalIndex": 1003,
  "owner": 3,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919735_theRebbe_388__p003",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919735_theRebbe_388__p003",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919735_theRebbe_388",
  "title": "מאמר ציון במשפט תפדה תשמ\"א",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה ידוע שכוונת הירידה דהגלות היא לצורך עלי'."
        },
        {
          "s": 2,
          "text": "שע\"י העבודה בזמן הגלות דוקא יהי' הגילוי דלעתיד שהוא נעלה יותר מהגילוי שהי' בזמן הבית."
        },
        {
          "s": 3,
          "text": "וכיתרון האור מן החושך35,"
        },
        {
          "s": 4,
          "text": "שע\"י החושך נעשה יתרון בהאור,"
        },
        {
          "s": 5,
          "text": "שהוא נעלה יותר מכמו שהי' קודם."
        },
        {
          "s": 6,
          "text": "וכל שהירידה"
        },
        {
          "s": 7,
          "text": "(החושך)"
        },
        {
          "s": 8,
          "text": "היא למטה יותר,"
        },
        {
          "s": 9,
          "text": "העלי'"
        },
        {
          "s": 10,
          "text": "(יתרון האור)"
        },
        {
          "s": 11,
          "text": "שעל ידה,"
        },
        {
          "s": 12,
          "text": "היא נעלית יותר."
        },
        {
          "s": 13,
          "text": "ומזה מובן,"
        },
        {
          "s": 14,
          "text": "דמכיון שהירידה דהגלות היא בעיקר בהגוף"
        },
        {
          "s": 15,
          "text": "(כנ\"ל סעיף ד),"
        },
        {
          "s": 16,
          "text": "לכן,"
        },
        {
          "s": 17,
          "text": "העלי' דלע\"ל"
        },
        {
          "s": 18,
          "text": "(הנעשית ע\"י הירידה דהגלות)"
        },
        {
          "s": 19,
          "text": "שתהי' בהגוף היא נעלית יותר מהעלי' שתהי' בהנשמה."
        },
        {
          "s": 20,
          "text": "ויובן זה ע\"פ המבואר במק\"א36"
        },
        {
          "s": 21,
          "text": "בענין העלי' דהנשמה שנעשית ע\"י ירידתה למטה,"
        },
        {
          "s": 22,
          "text": "שיש בזה שני ענינים."
        },
        {
          "s": 23,
          "text": "א',"
        },
        {
          "s": 24,
          "text": "דעי\"ז שגם בהיותה למטה ומלובשת בגוף ונה\"ב היא עובדת את ה',"
        },
        {
          "s": 25,
          "text": "מתגלה תוקף ההתקשרות שלה עם הקב\"ה,"
        },
        {
          "s": 26,
          "text": "שגם ההעלם וההסתר דהגוף ונה\"ב אינו יכול לבטל ח\"ו,"
        },
        {
          "s": 27,
          "text": "ואפילו לא לעשות גרעון בההתקשרות שלה."
        },
        {
          "s": 28,
          "text": "ב',"
        },
        {
          "s": 29,
          "text": "שע\"י עבודת הנשמה למטה נעשה הבירור והזיכוך דהגוף ונה\"ב וחלקו בעולם."
        },
        {
          "s": 30,
          "text": "והחילוק שבין שני ענינים אלו הוא37,"
        },
        {
          "s": 31,
          "text": "דבענין הא' – יתרון האור הוא ע\"י החושך."
        },
        {
          "s": 32,
          "text": "והיתרון הוא,"
        },
        {
          "s": 33,
          "text": "שע\"י החושך מתגלה תוקף האור,"
        },
        {
          "s": 34,
          "text": "שגם החושך הכי גדול אינו מעלים לגבי'."
        },
        {
          "s": 35,
          "text": "משא\"כ בענין הב' – יתרון האור הוא גם בהחושך עצמו,"
        },
        {
          "s": 36,
          "text": "שהחושך"
        },
        {
          "s": 37,
          "text": "(דהגוף ונה\"ב והעולם)"
        },
        {
          "s": 38,
          "text": "נהפך לאור."
        },
        {
          "s": 39,
          "text": "והיתרון הוא,"
        },
        {
          "s": 40,
          "text": "שבכדי להפוך את החושך לאור הוא בכח העצמות שלמעלה מהגדרים דאור וחושך,"
        },
        {
          "s": 41,
          "text": "וע\"י הפיכת החושך לאור,"
        },
        {
          "s": 42,
          "text": "מתגלה כח העצמות."
        },
        {
          "s": 43,
          "text": "ויתירה מזו,"
        },
        {
          "s": 44,
          "text": "דעי\"ז דוקא נשלמת הכוונה דנתאוה הקב\"ה להיות לו ית' דירה בתחתונים38"
        },
        {
          "s": 45,
          "text": "[דענין נתאוה הוא בעצמותו ית'39]."
        },
        {
          "s": 46,
          "text": "וכמבואר בתניא40,"
        },
        {
          "s": 47,
          "text": "שהכוונה בירידת הנשמה למטה היא לא בשביל הנשמה אלא בכדי לתקן את הגוף ונה\"ב וחלקו בעולם,"
        },
        {
          "s": 48,
          "text": "כי עי\"ז דוקא נשלמת הכוונה דדירה בתחתונים41."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "וכמו שהוא בהעלי' שע\"י ירידת הנשמה למטה,"
        },
        {
          "s": 1,
          "text": "שעיקר העלי' הוא הבירור והזיכוך דהגוף וכו',"
        },
        {
          "s": 2,
          "text": "עד\"ז הוא גם בהעלי' דלע\"ל ע\"י הירידה דהגלות,"
        },
        {
          "s": 3,
          "text": "שעיקר העלי' היא בהגוף."
        },
        {
          "s": 4,
          "text": "דהיתרון שנעשה בהנשמה ע\"י חושך הגלות הוא גילוי תוקף ההתקשרות שלה,"
        },
        {
          "s": 5,
          "text": "שהגם שהיא מלובשת בגוף והגוף הוא בגלות מ\"מ גם אז הנשמה אינה בגלות."
        },
        {
          "s": 6,
          "text": "והיתרון שנעשה בהגוף הוא שהחושך דהגוף כמו שהוא בגלות"
        },
        {
          "s": 7,
          "text": "(שהוא חושך גדול יותר מהחושך שלו42"
        },
        {
          "s": 8,
          "text": "כמו שהוא מצד עצמו)"
        },
        {
          "s": 9,
          "text": "נהפך לאור,"
        },
        {
          "s": 10,
          "text": "ויתירה מזו,"
        },
        {
          "s": 11,
          "text": "דעי\"ז שגם החושך שלו כמו שהוא בגלות נהפך לאור,"
        },
        {
          "s": 12,
          "text": "נשלמת הכוונה דדירה בתחתונים,"
        },
        {
          "s": 13,
          "text": "בתחתון שאין תחתון למטה ממנו43."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה ידוע44"
        },
        {
          "s": 2,
          "text": "שלע\"ל תהי' הנשמה ניזונית מן הגוף."
        },
        {
          "s": 3,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 4,
          "text": "שלע\"ל יהי' להנשמה"
        },
        {
          "s": 5,
          "text": "(לא רק היתרון שנעשה ע\"י החושך,"
        },
        {
          "s": 6,
          "text": "אלא)"
        },
        {
          "s": 7,
          "text": "גם היתרון הבא מן החושך עצמו."
        },
        {
          "s": 8,
          "text": "דהגם שיתרון זה יהי'"
        },
        {
          "s": 9,
          "text": "(בעיקר)"
        },
        {
          "s": 10,
          "text": "בהגוף,"
        },
        {
          "s": 11,
          "text": "גם הנשמה תקבל מהגוף יתרון זה."
        },
        {
          "s": 12,
          "text": "וע\"ד הידוע45"
        },
        {
          "s": 13,
          "text": "בענין העלי' שנעשית בהנשמה ע\"י ירידתה למטה בגוף ונה\"ב,"
        },
        {
          "s": 14,
          "text": "דנוסף לזה שע\"י ההעלם וההסתר דהגוף ונה\"ב מתעוררים ומתגלים כחות הנעלמים של הנשמה"
        },
        {
          "s": 15,
          "text": "(שהיו גם קודם ירידתה),"
        },
        {
          "s": 16,
          "text": "הנה ע\"י שהנשמה מבררת ומזככת את הגוף ונה\"ב,"
        },
        {
          "s": 17,
          "text": "נעשה בה גם יתרון והוספה."
        },
        {
          "s": 18,
          "text": "כמ\"ש46"
        },
        {
          "s": 19,
          "text": "משכני אחריך נרוצה,"
        },
        {
          "s": 20,
          "text": "דע\"י שנה\"א פועלת שגם נה\"ב יהי' לה אהבת ה',"
        },
        {
          "s": 21,
          "text": "שהאהבה דנה\"ב היא בדרך מרוצה,"
        },
        {
          "s": 22,
          "text": "עי\"ז נעשה נרוצה גם בנה\"א,"
        },
        {
          "s": 23,
          "text": "אחריך נרוצה לשון רבים47."
        },
        {
          "s": 24,
          "text": "אלא שעכשיו,"
        },
        {
          "s": 25,
          "text": "מכיון שהנשמה היא המשפיע והגוף הוא המקבל,"
        },
        {
          "s": 26,
          "text": "יתרון זה דהנשמה"
        },
        {
          "s": 27,
          "text": "(שמקבל מהגוף)"
        },
        {
          "s": 28,
          "text": "אינו בשלימות,"
        },
        {
          "s": 29,
          "text": "והשלימות דיתרון זה יהי' לע\"ל,"
        },
        {
          "s": 30,
          "text": "מכיון שאז תהי' הנשמה ניזונית מן הגוף."
        }
      ]
    }
  ]
}