{
  "globalIndex": 482,
  "owner": 32,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916512_theRebbe_860__p002",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916512_theRebbe_860__p002",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916512_theRebbe_860",
  "title": "מאמר היושבת בגנים תשי\"א",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "וזהו ענין דהיושבת בגנים,"
        },
        {
          "s": 2,
          "text": "הנשמות היושבות בג\"ע התחתון ובג\"ע העליון,"
        },
        {
          "s": 3,
          "text": "באים להקשיב קולם דנש\"י למטה."
        },
        {
          "s": 4,
          "text": "דהכוונה בזה הוא דגם הנשמותג"
        },
        {
          "s": 5,
          "text": "כמו שהם למעלה קודם ירידתן בגוף,"
        },
        {
          "s": 6,
          "text": "וגם אותן הנשמות שכבר היו בגוף,"
        },
        {
          "s": 7,
          "text": "שיש בהם המעלה שמצד עבודת הגוף,"
        },
        {
          "s": 8,
          "text": "כי בזמן היותן בגוף הנה ימים יוצרוד"
        },
        {
          "s": 9,
          "text": "ולו אחד בהם24,"
        },
        {
          "s": 10,
          "text": "שהמשיכו האחד בהם והשלימו כל עבודתם דעל שם זה נקראים ישראל צבאות הוי'25"
        },
        {
          "s": 11,
          "text": "(כמבואר במאמר כ\"ק מו\"ח אדמו\"ר הנ\"ל8),"
        },
        {
          "s": 12,
          "text": "דצבא יש בו ג' פירושים: א' לשון חיל,"
        },
        {
          "s": 13,
          "text": "היינו קבלת עול."
        },
        {
          "s": 14,
          "text": "ב' זמן קבוע היינו שבזמן הקבוע להם משלימים כל עבודתם."
        },
        {
          "s": 15,
          "text": "ג' לשון צביון דפירושו יופי,"
        },
        {
          "s": 16,
          "text": "לא רק רצון26"
        },
        {
          "s": 17,
          "text": "כ\"א יופי,"
        },
        {
          "s": 18,
          "text": "הבא מפנימיות הכתר וגורם תענוגה"
        },
        {
          "s": 19,
          "text": "שעש\"ז נקראים צבאות הוי'."
        },
        {
          "s": 20,
          "text": "ובכ\"ז הנה גם הם באים להקשיב לקולם של הנשמות המלובשים בגופים,"
        },
        {
          "s": 21,
          "text": "ואפילו אם עבודתם אינה עדיין בשלימות,"
        },
        {
          "s": 22,
          "text": "לא בפי' הא' דצבא חיל שענינו קבלת עול,"
        },
        {
          "s": 23,
          "text": "לא בפי' הב' דצבא זמן יומין שלימין ולא חסריןו,"
        },
        {
          "s": 24,
          "text": "ולא בפי' הג' דצבא יופי,"
        },
        {
          "s": 25,
          "text": "וכמו שמסיים בהמאמר8"
        },
        {
          "s": 26,
          "text": "דכאשר לומדים תורה ואינו מזכיר תנאים באופן לימוד התורה,"
        },
        {
          "s": 27,
          "text": "ומקיימים את המצוות,"
        },
        {
          "s": 28,
          "text": "ואינו מזכיר תנאים באופן קיום המצוות,"
        },
        {
          "s": 29,
          "text": "נתהפך מקשר ושקר,"
        },
        {
          "s": 30,
          "text": "שקר העולם,"
        },
        {
          "s": 31,
          "text": "לקרש,"
        },
        {
          "s": 32,
          "text": "עצי שטים עומדים27"
        },
        {
          "s": 33,
          "text": "ומחברים אור א\"ס ב\"ה עם העולם,"
        },
        {
          "s": 34,
          "text": "אתהפכא מן הקצה אל הקצה,"
        },
        {
          "s": 35,
          "text": "דהנה אחד מצירופי קרש הוא קשר."
        },
        {
          "s": 36,
          "text": "קשר דקדושה דענינו התקשרות."
        },
        {
          "s": 37,
          "text": "משא\"כ בלעו\"ז הרי לא תאמרון קשר לכל אשר יאמר העם הזה קשרז,"
        },
        {
          "s": 38,
          "text": "כי ענינם פירוד והתחלקות."
        },
        {
          "s": 39,
          "text": "אבל התקשרות דקדושה,"
        },
        {
          "s": 40,
          "text": "הרי כולם נקראו חברים,"
        },
        {
          "s": 41,
          "text": "חברים מקשיבים."
        },
        {
          "s": 42,
          "text": "שהנשמות כמו שהם למעלה,"
        },
        {
          "s": 43,
          "text": "וגם הנשמות שכבר היו בגוף שיש בהם מעלת העבודה שמצד הגוף כי השלימו בעלמא דין כל עבודתם,"
        },
        {
          "s": 44,
          "text": "בכל הג' פירושים של צבא הנ\"ל,"
        },
        {
          "s": 45,
          "text": "כולם באים להקשיב ולקבל קולם של הנשמות המלובשים בגופים ואף שעדיין לא השלימו עבודתם,"
        },
        {
          "s": 46,
          "text": "כי אף שהם נפוצים בגולה ורועים בגנים של אחרים,"
        },
        {
          "s": 47,
          "text": "בכ\"ז רייסט מען זיך אָפּ פון וועלט און מען נעמט מיט דעם גוף ונה\"ב ובאים בבתי כנסיות ובתי מדרשות וקורין את השמע ועוסקין בתורה,"
        },
        {
          "s": 48,
          "text": "שזהו\"ע מסירת נפש ממשח,"
        },
        {
          "s": 49,
          "text": "און דאָס פאַרמאָגט מען נאָר אין עוה\"ז,"
        },
        {
          "s": 50,
          "text": "ולכן הנה חברים,"
        },
        {
          "s": 51,
          "text": "גם הנשמות שבג\"עט"
        },
        {
          "s": 52,
          "text": "מקשיבים לקולם,"
        },
        {
          "s": 53,
          "text": "וגם הקב\"ה אומר אני ופמליא שלי באים לשמוע בקולך."
        },
        {
          "s": 54,
          "text": "וזהו ימים יוצרו ולא,"
        },
        {
          "s": 55,
          "text": "ולא כתיב ולו קריי"
        },
        {
          "s": 56,
          "text": "שבעבודתם עבודת הנשמה בגוף,"
        },
        {
          "s": 57,
          "text": "אין גוף און מיטן גוף,"
        },
        {
          "s": 58,
          "text": "ממשיכים מלמעלה מן ההשתלשלות בלמטה מן ההשתלשלות,"
        },
        {
          "s": 59,
          "text": "אחד בהם,"
        },
        {
          "s": 60,
          "text": "שיהי' הוי' אחד ושמו אחד28."
        }
      ]
    }
  ]
}