{
  "globalIndex": 963,
  "owner": 13,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919434_theRebbe_712__p005",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919434_theRebbe_712__p005",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919434_theRebbe_712",
  "title": "מאמר וחזקת והיית לאיש תשכ\"ח",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 2,
          "text": "דזהו מ\"ש בשל\"ה48"
        },
        {
          "s": 3,
          "text": "דיעקב הוא תפילין של ראש ויוסף הוא תפילין של יד,"
        },
        {
          "s": 4,
          "text": "כי ע\"י תפילין של ראש נעשה החיבור"
        },
        {
          "s": 5,
          "text": "(תפילין מלשון התחברות)"
        },
        {
          "s": 6,
          "text": "דאוא\"ס המאציל עם הנאצלים,"
        },
        {
          "s": 7,
          "text": "שממשיך תוספות אור באו\"א ובז\"א דאצילות,"
        },
        {
          "s": 8,
          "text": "וע\"י תפילין של יד שהוא במלכות"
        },
        {
          "s": 9,
          "text": "[כמ\"ש49"
        },
        {
          "s": 10,
          "text": "וקשרתם לאות על ידכה,"
        },
        {
          "s": 11,
          "text": "יד כהה50,"
        },
        {
          "s": 12,
          "text": "דיד כהה היא המלכות]"
        },
        {
          "s": 13,
          "text": "נעשה החיבור דאוא\"ס"
        },
        {
          "s": 14,
          "text": "(גם)"
        },
        {
          "s": 15,
          "text": "עם הנבראים."
        },
        {
          "s": 16,
          "text": "[דזהו מה שתש\"ר נק' בשם פאר51,"
        },
        {
          "s": 17,
          "text": "כמו תכשיט שהאדם מתקשט בו52,"
        },
        {
          "s": 18,
          "text": "ותפילין של יד53"
        },
        {
          "s": 19,
          "text": "הם רק לבוש,"
        },
        {
          "s": 20,
          "text": "כי בי\"ע הם לבושים וע\"ס דאצילות נק' בשם תיקונין54,"
        },
        {
          "s": 21,
          "text": "דתיקונין הוא כמו תכשיטים55]."
        },
        {
          "s": 22,
          "text": "וזהו שיעקב הוא תש\"ר ויוסף תש\"י,"
        },
        {
          "s": 23,
          "text": "כי יעקב הוא בריח התיכון שמבריח ומחבר אוא\"ס עם הנאצלים,"
        },
        {
          "s": 24,
          "text": "ויוסף הוא מחבר"
        },
        {
          "s": 25,
          "text": "[בן פורת יוסף56,"
        },
        {
          "s": 26,
          "text": "פורת אותיות תופר57,"
        },
        {
          "s": 27,
          "text": "תופר ומחבר]"
        },
        {
          "s": 28,
          "text": "אוא\"ס עם הנבראים."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "וצריך להבין,"
        },
        {
          "s": 1,
          "text": "דכיון שבכדי שתהי' המשכה בבי\"ע צ\"ל תחלה ההמשכה באצילות,"
        },
        {
          "s": 2,
          "text": "למה מקדימין הנחת תש\"י לתש\"ר."
        },
        {
          "s": 3,
          "text": "ויש לומר הביאור בזה ע\"פ הידוע58"
        },
        {
          "s": 4,
          "text": "שהמצוות דהקב\"ה שנעשים ע\"י שישראל מקיימים את המצוות הם נעלים יותר מהמצוות דהקב\"ה כמו שהם מצד עצמם."
        },
        {
          "s": 5,
          "text": "ויש להוסיף,"
        },
        {
          "s": 6,
          "text": "דבמצות תפילין,"
        },
        {
          "s": 7,
          "text": "ענין זה הוא ביותר."
        },
        {
          "s": 8,
          "text": "דמכיון שתפילין דמארי59"
        },
        {
          "s": 9,
          "text": "עלמא מה כתיב בהו כו' ומי60"
        },
        {
          "s": 10,
          "text": "כעמך ישראל גוי אחד בארץ61,"
        },
        {
          "s": 11,
          "text": "דקוב\"ה משתבח בשבחייהו דישראל61"
        },
        {
          "s": 12,
          "text": "– הרי בזה נוגע עוד יותר העבודה דישראל,"
        },
        {
          "s": 13,
          "text": "הנחת תפילין דישראל."
        },
        {
          "s": 14,
          "text": "ולכן מקדימין הנחת תש\"י לתש\"ר,"
        },
        {
          "s": 15,
          "text": "כי המעלה דעבודה היא בעיקר בהעבודה דיחודא תתאה"
        },
        {
          "s": 16,
          "text": "(בי\"ע)62,"
        },
        {
          "s": 17,
          "text": "ולכן העבודה דיחו\"ת מגעת למעלה יותר מהעבודה דיחו\"ע"
        },
        {
          "s": 18,
          "text": "(אצילות),"
        },
        {
          "s": 19,
          "text": "וההוספה שנעשית בתפילין דמארי עלמא"
        },
        {
          "s": 20,
          "text": "[המשכת אוא\"ס באצילות"
        },
        {
          "s": 21,
          "text": "(תש\"ר)"
        },
        {
          "s": 22,
          "text": "ובי\"ע"
        },
        {
          "s": 23,
          "text": "(תש\"י)]"
        },
        {
          "s": 24,
          "text": "ע\"י הנחת תפילין דישראל,"
        },
        {
          "s": 25,
          "text": "היא בעיקר ע\"י הנחת תש\"י63."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "והנה זה שע\"י קיום המצוות דישראל מיתוסף עילוי בהמצוות דהקב\"ה הוא64,"
        },
        {
          "s": 1,
          "text": "כי ישראל עלו במחשבה65,"
        },
        {
          "s": 2,
          "text": "מחשבה עצמית שלמעלה מכל הגילויים"
        },
        {
          "s": 3,
          "text": "(גם מהגילוי דחפץ חסד66"
        },
        {
          "s": 4,
          "text": "שהוא השרש והסיבה לכל הגילויים),"
        },
        {
          "s": 5,
          "text": "ולכן ע\"י העבודה"
        },
        {
          "s": 6,
          "text": "(קיום המצוות)"
        },
        {
          "s": 7,
          "text": "דישראל מיתוסף עילוי בהמצוות דהקב\"ה."
        },
        {
          "s": 8,
          "text": "ועפ\"ז יש לומר עוד טעם על זה שההוספה בתפילין דמארי עלמא היא בעיקר ע\"י הנחת תש\"י,"
        },
        {
          "s": 9,
          "text": "כי ההמשכה בבי\"ע"
        },
        {
          "s": 10,
          "text": "(תש\"י)"
        },
        {
          "s": 11,
          "text": "מגעת בהעצם שלמעלה משרש ההשפעה והגילוי"
        },
        {
          "s": 12,
          "text": "(כנ\"ל סעיף ה),"
        },
        {
          "s": 13,
          "text": "שבכללות הוא בחינת מחשבה עצמית הנ\"ל."
        }
      ]
    }
  ]
}