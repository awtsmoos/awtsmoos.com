{
  "globalIndex": 665,
  "owner": 15,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917669_theRebbe_390__p003",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917669_theRebbe_390__p003",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917669_theRebbe_390",
  "title": "מאמר החודש הזה לכם תשמ\"ז",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דמ\"ש בהמאמר"
        },
        {
          "s": 2,
          "text": "(בתחלתו24)"
        },
        {
          "s": 3,
          "text": "דהכוונה בנתינת התורה היא להמשיך אוא\"ס שלפני הצמצום,"
        },
        {
          "s": 4,
          "text": "הגם שהעילוי דתורה הוא שגם באוא\"ס שלפני הצמצום גופא נמשך הגילוי דעצמות אוא\"ס שלמעלה מהאור השייך לעולמות,"
        },
        {
          "s": 5,
          "text": "הוא,"
        },
        {
          "s": 6,
          "text": "כי גם המשכת האור השייך לעולמות"
        },
        {
          "s": 7,
          "text": "(שלפני הצמצום)"
        },
        {
          "s": 8,
          "text": "היא ע\"י צמצום."
        },
        {
          "s": 9,
          "text": "דהגם שהצמצום שהי' באור זה"
        },
        {
          "s": 10,
          "text": "(השייך לעולמות)"
        },
        {
          "s": 11,
          "text": "נק' בשם צמצום הראשון,"
        },
        {
          "s": 12,
          "text": "הרי מבואר במק\"א25"
        },
        {
          "s": 13,
          "text": "שגם לפני צמצום הראשון היו כו\"כ צמצומים."
        },
        {
          "s": 14,
          "text": "דנוסף לזה שהמשכת אור השייך לעולמות מהאור שלמעלה משייכות לעולמות היא ע\"י צמצום כנ\"ל,"
        },
        {
          "s": 15,
          "text": "הנה גם המשכת האור שלמעלה משייכות לעולמות היא ע\"י צמצום."
        },
        {
          "s": 16,
          "text": "דמכיון שגם אור זה"
        },
        {
          "s": 17,
          "text": "(שלמעלה משייכות לעולמות)"
        },
        {
          "s": 18,
          "text": "הוא בבחי' המשכה וגילוי,"
        },
        {
          "s": 19,
          "text": "ולפני זה הי' כלול בעצמות המאור ממש26"
        },
        {
          "s": 20,
          "text": "[ובפרט שיש לומר שפירוש זה שהי' כלול בעצמות המאור ממש הוא שהי' כלול בהעצמות שלמעלה27"
        },
        {
          "s": 21,
          "text": "מתואר מאור28],"
        },
        {
          "s": 22,
          "text": "הרי מובן29,"
        },
        {
          "s": 23,
          "text": "דהמשכת האור שבבחי' גילוי מהאור הכלול בעצמות המאור היא ע\"י צמצום עצום."
        },
        {
          "s": 24,
          "text": "ועפ\"ז יש לומר דמ\"ש בהמאמר שהכוונה בנתינת התורה היא להמשיך האור שלפני הצמצום – הכוונה בזה היא"
        },
        {
          "s": 25,
          "text": "(לא רק להאור שלפני צמצום הראשון אלא)"
        },
        {
          "s": 26,
          "text": "גם להאור שלפני כל הצמצומים."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יש לבאר גם מ\"ש בהמאמר30"
        },
        {
          "s": 2,
          "text": "שפרשת החודש נאמרה מיד אחרי יצי\"מ,"
        },
        {
          "s": 3,
          "text": "דלכאורה תמוה,"
        },
        {
          "s": 4,
          "text": "הרי מפורש בקרא31"
        },
        {
          "s": 5,
          "text": "שפרשת החודש נאמר בארץ מצרים,"
        },
        {
          "s": 6,
          "text": "ויש לומר,"
        },
        {
          "s": 7,
          "text": "דמ\"ש בהמאמר שפרשת החודש נאמרה לאחרי יצי\"מ הכוונה היא לאחרי אמירת וסיפור יצי\"מ"
        },
        {
          "s": 8,
          "text": "(יצי\"מ כמו שהוא בתורה)."
        },
        {
          "s": 9,
          "text": "דלאחרי שנאמרו כל הציווים"
        },
        {
          "s": 10,
          "text": "(שבתורה)"
        },
        {
          "s": 11,
          "text": "לפרעה שישלח את ישראל ממצרים,"
        },
        {
          "s": 12,
          "text": "עד לההתראה האחרונה דמכת בכורות שלאח\"ז אמר פרעה צא אתה וכל העם גו'32,"
        },
        {
          "s": 13,
          "text": "הנה מיד לאחרי אמירת יצי\"מ נאמרה פרשת החודש."
        },
        {
          "s": 14,
          "text": "והענין הוא,"
        },
        {
          "s": 15,
          "text": "דמעלת הגילוי דתורה על הגילוי דעולמות"
        },
        {
          "s": 16,
          "text": "(המבוארת במאמר זה)"
        },
        {
          "s": 17,
          "text": "היא גם על הגילוי דעולמות כמו שהוא בתורה."
        },
        {
          "s": 18,
          "text": "דזהו מה שמביא בהמאמר מ\"ש רש\"י לא הי' צריך להתחיל את התורה אלא מהחודש הזה לכם ומה טעם פתח בבראשית,"
        },
        {
          "s": 19,
          "text": "שגם הענין דבראשית ברא"
        },
        {
          "s": 20,
          "text": "(ועד\"ז הסיפור דהאבות וכו'33)"
        },
        {
          "s": 21,
          "text": "כמו שהוא בתורה הוא רק"
        },
        {
          "s": 22,
          "text": "(כמו)"
        },
        {
          "s": 23,
          "text": "הקדמה לפרשת החודש,"
        },
        {
          "s": 24,
          "text": "דפרשה זו היא עיקר התחלת התורה."
        },
        {
          "s": 25,
          "text": "ולכן גם בנוגע להענין דיצי\"מ שהוא הכנה למ\"ת,"
        },
        {
          "s": 26,
          "text": "מדובר בהמאמר ע\"ד הענין דיצי\"מ כמו שהוא בתורה."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ויש לקשר ענין זה"
        },
        {
          "s": 1,
          "text": "[שהגילוי דתורה הוא למעלה יותר גם מהגילוי דעולמות כמו שהוא בתורה]"
        },
        {
          "s": 2,
          "text": "עם משנת\"ל"
        },
        {
          "s": 3,
          "text": "(סעיף ד)"
        },
        {
          "s": 4,
          "text": "שהגילוי דתורה הוא עצמות אוא\"ס שלמעלה מכל הצמצומים"
        },
        {
          "s": 5,
          "text": "(גם מהצמצומים שלפני צמצום הראשון),"
        },
        {
          "s": 6,
          "text": "ע\"פ הידוע דכללות כל התורה"
        },
        {
          "s": 7,
          "text": "(גם סיפורי התורה שלפני פרשת החודש)"
        },
        {
          "s": 8,
          "text": "קדמה לעולם34,"
        },
        {
          "s": 9,
          "text": "ומכיון דהתחלת ענין עולם הוא מצמצום הראשון35,"
        },
        {
          "s": 10,
          "text": "התורה שקדמה לעולם היא באוא\"ס שלפני הצמצום."
        },
        {
          "s": 11,
          "text": "ויתירה מזו יש לומר,"
        },
        {
          "s": 12,
          "text": "דמכיון שגם בהאור שלפני הצמצום יש כבר התחלת שרש המדידה דעולמות,"
        },
        {
          "s": 13,
          "text": "התורה שקדמה לעולם היא בהאור שבבחי' גילוי לעצמו שלמעלה משייכות לעולמות."
        },
        {
          "s": 14,
          "text": "דזהו גם בסיפורי התורה שלפני פרשת החודש."
        },
        {
          "s": 15,
          "text": "והעילוי דפרשת החודש,"
        },
        {
          "s": 16,
          "text": "עיקר התחלת התורה,"
        },
        {
          "s": 17,
          "text": "הוא,"
        },
        {
          "s": 18,
          "text": "הגילוי דעצמות אוא\"ס שלפני כל הצמצומים."
        }
      ]
    }
  ]
}