{
  "globalIndex": 310,
  "owner": 10,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915545_theRebbe_780__p001",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915545_theRebbe_780__p001",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915545_theRebbe_780",
  "title": "מאמר פדה בשלום תשמ\"א",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "יום ג',"
        },
        {
          "s": 2,
          "text": "טו\"ב כסלו ה'תשמ\"א – לפני תפלת מנחה*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "פדה בשלום נפשי מקרב לי כי ברבים היו עמדי1,"
        },
        {
          "s": 1,
          "text": "וידועים דיוקי כ\"ק אדמו\"ר הזקן בעל הגאולה די\"ט כסלו2,"
        },
        {
          "s": 2,
          "text": "ובנו ממלא מקומו כ\"ק אדמו\"ר האמצעי בעל הגאולה דיו\"ד כסלו3,"
        },
        {
          "s": 3,
          "text": "במה שבפסוק זה מודגש לא רק ענין הפדי' והגאולה בכלל,"
        },
        {
          "s": 4,
          "text": "אלא שהפדי' היא בשלום דוקא."
        },
        {
          "s": 5,
          "text": "וגם מ\"ש מקרב לי,"
        },
        {
          "s": 6,
          "text": "ולא ממלחמה וכיו\"ב."
        },
        {
          "s": 7,
          "text": "ועוד יש לדייק אומרו מקרב לי דייקא,"
        },
        {
          "s": 8,
          "text": "שהפדי' היא לי."
        },
        {
          "s": 9,
          "text": "גם צריך להבין אומרו כי ברבים היו עמדי,"
        },
        {
          "s": 10,
          "text": "דמשמע שזהו הטעם על זה שפדה בשלום נפשי גו' – מהו הענין בזה."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ונקודת הביאור בזה,"
        },
        {
          "s": 2,
          "text": "דפדי' שייך רק כאשר יש מציאות של ענין המנגד,"
        },
        {
          "s": 3,
          "text": "דכאשר אין מציאות של צד שכנגד אין צורך ומקום לפדי',"
        },
        {
          "s": 4,
          "text": "כיון שהקדושה היא הדרך היחידה והמציאות היחידה,"
        },
        {
          "s": 5,
          "text": "אבל כאשר יש צד שכנגד,"
        },
        {
          "s": 6,
          "text": "מציאות של חושך וסכלות וכו',"
        },
        {
          "s": 7,
          "text": "צ\"ל הפדי' מן החושך והסכלות וכו'."
        },
        {
          "s": 8,
          "text": "ופדי' זו מביאה שהקדושה תהי' באופן דיתרון האור מן החושך ויתרון החכמה מן הסכלות4,"
        },
        {
          "s": 9,
          "text": "היינו,"
        },
        {
          "s": 10,
          "text": "דע\"י הפדי' מן החושך והסכלות,"
        },
        {
          "s": 11,
          "text": "עי\"ז דוקא נעשה יתרון אור וחכמה,"
        },
        {
          "s": 12,
          "text": "ולא רק יתרון בכמות,"
        },
        {
          "s": 13,
          "text": "אלא גם יתרון באיכות."
        }
      ]
    }
  ]
}