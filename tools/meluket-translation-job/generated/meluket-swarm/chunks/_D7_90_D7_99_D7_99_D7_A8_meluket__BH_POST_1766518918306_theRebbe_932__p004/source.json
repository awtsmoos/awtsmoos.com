{
  "globalIndex": 768,
  "owner": 18,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918306_theRebbe_932__p004",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918306_theRebbe_932__p004",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918306_theRebbe_932",
  "title": "מאמר השמים כסאי תשל\"ו",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ועי\"ז בא אח\"כ לשנה הרביעית,"
        },
        {
          "s": 1,
          "text": "שנמשך במלכות גם הת\"ת,"
        },
        {
          "s": 2,
          "text": "דבעבודת האדם הוא שבהמחשבה דיבור ומעשה שלו נמשך גם מעצמיות המדות,"
        },
        {
          "s": 3,
          "text": "אהבה ויראה,"
        },
        {
          "s": 4,
          "text": "וכן שמחת לבב בתפארת הוי' והדר גאונו שבא ע\"י לאסתכלא ביקרא דמלכא49."
        },
        {
          "s": 5,
          "text": "ואז,"
        },
        {
          "s": 6,
          "text": "עבודתו אינה לדחות את הרע"
        },
        {
          "s": 7,
          "text": "[כי כשיש לו אהבת ה',"
        },
        {
          "s": 8,
          "text": "הרע הוא מאוס אצלו50"
        },
        {
          "s": 9,
          "text": "ואינו צריך לדחותו]"
        },
        {
          "s": 10,
          "text": "אלא להמשיך תוספות אור."
        },
        {
          "s": 11,
          "text": "דזהו שבשנה הרביעית יהי' כל פריו קודש הילולים להוי',"
        },
        {
          "s": 12,
          "text": "דענין ההילול הוא כמבואר בלקו\"ת47"
        },
        {
          "s": 13,
          "text": "בפירוש הכתוב51"
        },
        {
          "s": 14,
          "text": "ואתה קדוש יושב תהלות ישראל,"
        },
        {
          "s": 15,
          "text": "שהוא ית' מצד עצמו הוא קדוש ומובדל,"
        },
        {
          "s": 16,
          "text": "וע\"י תהלות ישראל הוא יושב ונמשך למטה."
        },
        {
          "s": 17,
          "text": "ויש לומר,"
        },
        {
          "s": 18,
          "text": "שהוא ע\"ד העבודה שמצד נר\"נ"
        },
        {
          "s": 19,
          "text": "(השמים כסאי והארץ הדום רגלי)"
        },
        {
          "s": 20,
          "text": "ומצד המקיפים חי' יחידה"
        },
        {
          "s": 21,
          "text": "(בית),"
        },
        {
          "s": 22,
          "text": "שעי\"ז נמשכים ומתגלים הפנימיים והמקיפים52"
        },
        {
          "s": 23,
          "text": "שלמעלה."
        },
        {
          "s": 24,
          "text": "אלא שהמשכה זו היא רק מבחינת הגילויים,"
        },
        {
          "s": 25,
          "text": "וכמבואר בלקו\"ת46"
        },
        {
          "s": 26,
          "text": "בפירוש הכתוב מודים אנחנו לך ומהללים לשם תפארתך,"
        },
        {
          "s": 27,
          "text": "שההודאה היא לך,"
        },
        {
          "s": 28,
          "text": "למהותו ועצמותו,"
        },
        {
          "s": 29,
          "text": "וההילול הוא רק לשמו ית'53,"
        },
        {
          "s": 30,
          "text": "לשם תפארתך."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ועי\"ז באים אח\"כ לשנה החמישית,"
        },
        {
          "s": 1,
          "text": "להוסיף לכם תבואתו,"
        },
        {
          "s": 2,
          "text": "תוספות אור שנמשך מקוצו של יו\"ד,"
        },
        {
          "s": 3,
          "text": "כתר."
        },
        {
          "s": 4,
          "text": "דיש לומר,"
        },
        {
          "s": 5,
          "text": "שענינה בעבודת האדם הוא האמונה שלמעלה מהדעת,"
        },
        {
          "s": 6,
          "text": "שהאמונה שלו היא מצד ההכרה שלית מחשבה תפיסא בי' כלל."
        },
        {
          "s": 7,
          "text": "דבאמונה זו ישנם ב' המעלות."
        },
        {
          "s": 8,
          "text": "שהיא בעצמותו ית',"
        },
        {
          "s": 9,
          "text": "ושהעצמות הוא בגילוי."
        },
        {
          "s": 10,
          "text": "היינו שבאמונה זו54"
        },
        {
          "s": 11,
          "text": "נרגש הפלאת העצמות,"
        },
        {
          "s": 12,
          "text": "שכל ההילולים והתשבחות הם רק לשם תפארתך,"
        },
        {
          "s": 13,
          "text": "ובעצמותו ית' אין שייך שום הילול,"
        },
        {
          "s": 14,
          "text": "ורק אמונה והודאה55."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "דזהו שהפירות דשנה הרביעית אין נאכלים אלא בירושלים56,"
        },
        {
          "s": 3,
          "text": "והפירות דשנה החמישית נאכלים בכל מקום,"
        },
        {
          "s": 4,
          "text": "כי הגילוי דשנה הרביעית הוא במדידה והגבלה,"
        },
        {
          "s": 5,
          "text": "ולכן ההילול דפירות אלו הוא שמביאים אותם לירושלים לשבח ולהלל לשמים57,"
        },
        {
          "s": 6,
          "text": "והגילוי דשנה החמישית,"
        },
        {
          "s": 7,
          "text": "כיון שהוא למעלה ממדידה והגבלה,"
        },
        {
          "s": 8,
          "text": "לכן ההודאה לה' על ההוספה בתבואה זו58"
        },
        {
          "s": 9,
          "text": "היא בכל מקום"
        },
        {
          "s": 10,
          "text": "(וגם בפירות שאין בהם קדושה,"
        },
        {
          "s": 11,
          "text": "ועד שהן נאכלין אפילו בטומאה)."
        },
        {
          "s": 12,
          "text": "וע\"י ההודאה לה' על פירות אלו שאין בהם קדושה,"
        },
        {
          "s": 13,
          "text": "ההמשכה היא מעצמות אוא\"ס"
        },
        {
          "s": 14,
          "text": "(שלמעלה משייכות לספירות)59,"
        },
        {
          "s": 15,
          "text": "ונמשכת למטה ביותר,"
        },
        {
          "s": 16,
          "text": "ועי\"ז נשלמת הכוונה דנתאוה הקב\"ה להיות לו ית' דירה בתחתונים60,"
        },
        {
          "s": 17,
          "text": "שהתחתון שאין תחתון למטה ממנו61,"
        },
        {
          "s": 18,
          "text": "נעשה דירה לו ית',"
        },
        {
          "s": 19,
          "text": "לו לעצמותו62."
        }
      ]
    }
  ]
}