{
  "globalIndex": 109,
  "owner": 9,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914333_theRebbe_315__p003",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914333_theRebbe_315__p003",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914333_theRebbe_315",
  "title": "מאמר בסוכות תשבו תשמ\"א",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וזהו בסוכות תשבו גו' למען ידעו דורותיכם כי בסוכות הושבתי גו',"
        },
        {
          "s": 2,
          "text": "דידיעה זו היא"
        },
        {
          "s": 3,
          "text": "(לא רק ענין בכוונת המצוה,"
        },
        {
          "s": 4,
          "text": "אלא גם)"
        },
        {
          "s": 5,
          "text": "חלק בקיום המצוה55"
        },
        {
          "s": 6,
          "text": "(כדמוכח גם מלשון אדמו\"ר הזקן בשלחנו56)."
        },
        {
          "s": 7,
          "text": "דהנה סכך הסוכה נעשה"
        },
        {
          "s": 8,
          "text": "(כנ\"ל)"
        },
        {
          "s": 9,
          "text": "מענן הקטורת דיוהכ\"פ"
        },
        {
          "s": 10,
          "text": "[והשייכות דסוכה לענן הקטורת היא הן מצד זה שהסוכה היא עשוי' לצל וענן הוא כמו צל"
        },
        {
          "s": 11,
          "text": "(כנ\"ל),"
        },
        {
          "s": 12,
          "text": "וגם מצד זה שבסוכות הושבתי הם ענני הכבוד],"
        },
        {
          "s": 13,
          "text": "דענין ענן הקטורת דיוהכ\"פ הוא בחי' המקיף שלמעלה מטעם ודעת,"
        },
        {
          "s": 14,
          "text": "ובחג הסוכות צריך להמשיך מקיף זה בפנימיות,"
        },
        {
          "s": 15,
          "text": "בסוכות תשבו,"
        },
        {
          "s": 16,
          "text": "וההמשכה בפנימיות היא ע\"י הדעת דוקא,"
        },
        {
          "s": 17,
          "text": "כמבואר בארוכה בהמשך וככה של בעל ההילולא57."
        },
        {
          "s": 18,
          "text": "ובפרט ע\"י נטילת ד' מינים,"
        },
        {
          "s": 19,
          "text": "שמורים על ענין האחדות58,"
        },
        {
          "s": 20,
          "text": "שעי\"ז נמשך הדעת"
        },
        {
          "s": 21,
          "text": "(גם בבחי' נוקבא59)"
        },
        {
          "s": 22,
          "text": "למטה יותר,"
        },
        {
          "s": 23,
          "text": "בפנימיותו של כאו\"א מישראל60."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "וביאור הענין בעומק יותר יובן ע\"פ מה שמבאר בעל ההילולא בהמשך המאמרים הנ\"ל61"
        },
        {
          "s": 2,
          "text": "בענין ירידת הנשמה בגוף,"
        },
        {
          "s": 3,
          "text": "ועד\"ז בענין ירידת המצוות והתלבשותם בדברים גשמיים"
        },
        {
          "s": 4,
          "text": "[וכמו במצות הקרבנות שצריך להקריב בהמה גשמית דוקא,"
        },
        {
          "s": 5,
          "text": "וכן הקטורת היא מי\"א סממנים גשמיים דוקא,"
        },
        {
          "s": 6,
          "text": "וכן סכך הסוכה"
        },
        {
          "s": 7,
          "text": "(שהוא דוגמת ענין הקטורת)"
        },
        {
          "s": 8,
          "text": "הוא מדבר גשמי מפסולת גורן ויקב62,"
        },
        {
          "s": 9,
          "text": "ועד\"ז הוא בשאר המצוות],"
        },
        {
          "s": 10,
          "text": "שהיא ירידה צורך עלי'."
        },
        {
          "s": 11,
          "text": "דשרש הנשמה היא מבחי' התיקון,"
        },
        {
          "s": 12,
          "text": "ושרש הגוף ונה\"ב,"
        },
        {
          "s": 13,
          "text": "וכן שרש הדברים הגשמיים שבהם נתלבשו המצוות,"
        },
        {
          "s": 14,
          "text": "הוא בבחי' התוהו שקדם לתיקון."
        },
        {
          "s": 15,
          "text": "וע\"י שהנשמה יורדת למטה ומתלבשת בגוף ונה\"ב ועוסקת בתומ\"צ שנתלבשו בדברים גשמיים,"
        },
        {
          "s": 16,
          "text": "עי\"ז היא מבררת את הניצוצות דתוהו שנפלו למטה בהגוף ונה\"ב ובדברים הגשמיים"
        },
        {
          "s": 17,
          "text": "(שהמצוות מלובשות בהם)"
        },
        {
          "s": 18,
          "text": "ומעלה אותם לשרשם,"
        },
        {
          "s": 19,
          "text": "ועי\"ז נמשך להם האורות דתוהו שלמעלה מהאורות דתיקון,"
        },
        {
          "s": 20,
          "text": "כידוע שהאורות דתיקון הם אורות מועטים ובתוהו היו אורות מרובים63."
        },
        {
          "s": 21,
          "text": "ובפרט לפי המבואר שם64"
        },
        {
          "s": 22,
          "text": "שריבוי האור דתוהו הוא לא רק ריבוי בכמות"
        },
        {
          "s": 23,
          "text": "(היינו שהוא באותו הסוג של האורות דתיקון ורק שהוא בריבוי גדול מאד),"
        },
        {
          "s": 24,
          "text": "כי אם,"
        },
        {
          "s": 25,
          "text": "שהאורות דתוהו הם בסוג אחר לגמרי."
        },
        {
          "s": 26,
          "text": "ובמכ\"ש מזה שאמרו רז\"ל65"
        },
        {
          "s": 27,
          "text": "על אור שנברא ביום הראשון שהי' אדם מביט בו מסוף העולם ועד סופו,"
        },
        {
          "s": 28,
          "text": "שביאור הלשון מסוף העולם ועד סופו"
        },
        {
          "s": 29,
          "text": "(אף שלכאורה הי' צ\"ל מתחלת העולם ועד סופו)"
        },
        {
          "s": 30,
          "text": "הוא דכללות כל העולמות נחלקים לב' בחינות,"
        },
        {
          "s": 31,
          "text": "עלמא דאתכסיא ועלמא דאתגליא,"
        },
        {
          "s": 32,
          "text": "והכוונה במסוף העולם ועד סופו היא מסוף העולם דעלמא דאתגליא מלמעלמ\"ט ועד סופו דעלמא דאתכסיא מלמטלמ\"ע,"
        },
        {
          "s": 33,
          "text": "דמזה מובן שענין הריבוי דאור זה"
        },
        {
          "s": 34,
          "text": "(אור שנברא ביום הראשון)"
        },
        {
          "s": 35,
          "text": "לגבי האור דשאר הימים הוא לא רק ריבוי בכמות אלא שהוא ריבוי שאינו בערך כלל."
        },
        {
          "s": 36,
          "text": "וכל זה הוא בעולם התיקון גופא"
        },
        {
          "s": 37,
          "text": "[שהרי גם אור שנברא ביום ראשון הוא מבחי' התיקון],"
        },
        {
          "s": 38,
          "text": "שכללות האורות דתיקון הם אורות מועטים."
        },
        {
          "s": 39,
          "text": "ומזה מובן במכ\"ש בענין ריבוי האור שהי' בבחי' התוהו,"
        },
        {
          "s": 40,
          "text": "שנוסף על הריבוי בכמות,"
        },
        {
          "s": 41,
          "text": "הי'"
        },
        {
          "s": 42,
          "text": "(וזהו עיקר מעלתו)"
        },
        {
          "s": 43,
          "text": "אור נבדל בערך לגמרי מהאור דתיקון."
        },
        {
          "s": 44,
          "text": "וע\"י שהנשמה,"
        },
        {
          "s": 45,
          "text": "ששרשה מבחי' התיקון,"
        },
        {
          "s": 46,
          "text": "מבררת ומתקנת את הניצוצות שנפלו למטה בדברים הגשמיים,"
        },
        {
          "s": 47,
          "text": "עי\"ז נמשכים האורות מרובים דתוהו בכלים מרובים דתיקון."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "וזהו שירידת הנשמה בגוף היא ירידה צורך עלי',"
        },
        {
          "s": 1,
          "text": "דשרש הנשמה הוא"
        },
        {
          "s": 2,
          "text": "(כנ\"ל)"
        },
        {
          "s": 3,
          "text": "בבחי' התיקון"
        },
        {
          "s": 4,
          "text": "[אלא שבתיקון גופא היא בבחי' הכי עליונה,"
        },
        {
          "s": 5,
          "text": "דישראל עלו במחשבה66],"
        },
        {
          "s": 6,
          "text": "וע\"י שיורדת מאיגרא67"
        },
        {
          "s": 7,
          "text": "רמה לבירא עמיקתא ומבררת את הניצוצות שנפלו למטה מטה"
        },
        {
          "s": 8,
          "text": "(לבירא עמיקתא),"
        },
        {
          "s": 9,
          "text": "דזה גופא שנפלו למטה מטה ביותר הוא מצד זה ששרשם הוא למעלה מעלה ביותר68,"
        },
        {
          "s": 10,
          "text": "עי\"ז נעשה בה תוספת עילוי למעלה יותר מכמו שהיתה קודם ירידתה69."
        },
        {
          "s": 11,
          "text": "וכידוע תורת האריז\"ל עה\"פ כי לא על הלחם לבדו יחי' האדם כי על כל מוצא פי הוי' יחי' האדם70,"
        },
        {
          "s": 12,
          "text": "דזה שהלחם מחי' את האדם"
        },
        {
          "s": 13,
          "text": "(אף שהלחם הוא צומח והאדם הוא מדבר)"
        },
        {
          "s": 14,
          "text": "הוא לא מצד הלחם לבדו,"
        },
        {
          "s": 15,
          "text": "כי אם,"
        },
        {
          "s": 16,
          "text": "מצד מוצא פי הוי' שבהלחם,"
        },
        {
          "s": 17,
          "text": "היינו מהמאמר71"
        },
        {
          "s": 18,
          "text": "תדשא הארץ דשא."
        },
        {
          "s": 19,
          "text": "וזה שהאדם צריך להמוצא פי הוי' שבהלחם דוקא"
        },
        {
          "s": 20,
          "text": "(אף שגם באדם מלובש דבר הוי' מהמאמר72"
        },
        {
          "s": 21,
          "text": "נעשה אדם)"
        },
        {
          "s": 22,
          "text": "הוא לפי שמוצא פי הוי' שבהלחם הוא מבחי' התוהו,"
        },
        {
          "s": 23,
          "text": "ולכן על ידו דוקא יחי' האדם שמבחי' התיקון."
        },
        {
          "s": 24,
          "text": "וכמו שהוא בלחם,"
        },
        {
          "s": 25,
          "text": "עד\"ז הוא בכל עניני האדם"
        },
        {
          "s": 26,
          "text": "[דלחם כולל כל עניני אכילה ושתי'73"
        },
        {
          "s": 27,
          "text": "וגם כל צרכי האדם74],"
        },
        {
          "s": 28,
          "text": "כולל גם עבודת האדם בתומ\"צ,"
        },
        {
          "s": 29,
          "text": "שע\"י שהאדם מברר את הדברים הגשמיים"
        },
        {
          "s": 30,
          "text": "[ע\"י שעושה אותם לשם שמים75,"
        },
        {
          "s": 31,
          "text": "ועאכו\"כ ע\"י קיום המצוות בדברים הגשמיים עצמם],"
        },
        {
          "s": 32,
          "text": "הנה על מוצא פי הוי' שבדברים הגשמיים יחי' האדם,"
        },
        {
          "s": 33,
          "text": "שמתוסף עילוי בנשמת האדם למעלה יותר מכמו שהיתה קודם ירידתה."
        },
        {
          "s": 34,
          "text": "ומכיון שהאור דתוהו הוא נבדל בערך לגמרי"
        },
        {
          "s": 35,
          "text": "(כנ\"ל),"
        },
        {
          "s": 36,
          "text": "לכן גם העילוי שמתוסף בהנשמה הוא עילוי שלא בערך כלל76."
        }
      ]
    }
  ]
}