{
  "globalIndex": 998,
  "owner": 48,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919710_theRebbe_549__p003",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919710_theRebbe_549__p003",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919710_theRebbe_549",
  "title": "מאמר ציון במשפט תפדה תשל\"ו",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דזה שקיום המצוות צ\"ל באופן של כחדשים ממש הוא לא רק בכדי שעי\"ז יהי' קיום התומ\"צ ביותר חיות,"
        },
        {
          "s": 2,
          "text": "אלא ש"
        },
        {
          "s": 3,
          "text": "(גם)"
        },
        {
          "s": 4,
          "text": "ענין זה עצמו"
        },
        {
          "s": 5,
          "text": "(דבכל יום יהיו בעיניך כחדשים)"
        },
        {
          "s": 6,
          "text": "נוגע לקיום המצוות."
        },
        {
          "s": 7,
          "text": "כי ענין המצוות הוא שעל ידם נעשה יחוד קוב\"ה ושכינתי'35,"
        },
        {
          "s": 8,
          "text": "יחוד סובב וממלא35."
        },
        {
          "s": 9,
          "text": "וכיון שעבודת האדם"
        },
        {
          "s": 10,
          "text": "(אתערותא דלתתא)"
        },
        {
          "s": 11,
          "text": "שעל ידה נעשית ההמשכה"
        },
        {
          "s": 12,
          "text": "(אתערותא דלעילא)"
        },
        {
          "s": 13,
          "text": "צריכה להיות מעין ההמשכה,"
        },
        {
          "s": 14,
          "text": "לכן כשקיום המצוות דהאדם הוא באופן שבכל יום הם בעיניו כחדשים,"
        },
        {
          "s": 15,
          "text": "חיבור דזמן עם למעלה מהזמן,"
        },
        {
          "s": 16,
          "text": "עי\"ז מיתוסף בגילוי היחוד דסובב וממלא שנעשה ע\"י המצוות."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה שני הענינים דסובב וממלא הם שני השמות דהוי' ואלקים."
        },
        {
          "s": 2,
          "text": "וכמבואר בכ\"מ36"
        },
        {
          "s": 3,
          "text": "דשם אלקים הוא לא רק המגן ונרתק שמעלים ומסתיר על האור דשם הוי',"
        },
        {
          "s": 4,
          "text": "אלא שגם האור דשם הוי' כמו שנמשך ומתצמצם ע\"י שם אלקים להיות מקור לנבראים,"
        },
        {
          "s": 5,
          "text": "שבכללות הוא אור הממלא,"
        },
        {
          "s": 6,
          "text": "נקרא אלקים."
        },
        {
          "s": 7,
          "text": "וע\"פ הידוע37"
        },
        {
          "s": 8,
          "text": "דזה שהגוף מעלים על הנפש הוא כי שרש הנפש הוא מהוי' ושרש הגוף הוא מאלקים38,"
        },
        {
          "s": 9,
          "text": "ולכן כמו שאלקים מעלים על הוי' כן הגוף מעלים על הנפש,"
        },
        {
          "s": 10,
          "text": "יש לומר,"
        },
        {
          "s": 11,
          "text": "שעד\"ז הוא גם בהענין דסובב וממלא"
        },
        {
          "s": 12,
          "text": "[שגם אור הממלא נק' אלקים,"
        },
        {
          "s": 13,
          "text": "כנ\"ל],"
        },
        {
          "s": 14,
          "text": "שבכדי שהאדם ידע וירגיש שהעיקר הוא עניני הנשמה ועניני הגוף הם רק טפל,"
        },
        {
          "s": 15,
          "text": "הוא ע\"י יחוד סובב וממלא."
        },
        {
          "s": 16,
          "text": "דבאור הממלא"
        },
        {
          "s": 17,
          "text": "(כמו שהוא מצד עצמו)"
        },
        {
          "s": 18,
          "text": "להיותו מקור לנבראים והנבראים תופסים מקום לגבי',"
        },
        {
          "s": 19,
          "text": "יש תפיסת מקום לעניני הגוף,"
        },
        {
          "s": 20,
          "text": "וע\"י היחוד דסובב וממלא,"
        },
        {
          "s": 21,
          "text": "שגם בהאור כמו שנעשה מקור לעולמות מאיר הגילוי דאוא\"ס שלמעלה מעולמות,"
        },
        {
          "s": 22,
          "text": "דכולא קמי' כלא חשיב,"
        },
        {
          "s": 23,
          "text": "עי\"ז ישנה ההכרה שעניני הגוף הם רק בשביל הנשמה."
        },
        {
          "s": 24,
          "text": "ועפ\"ז יש לבאר מ\"ש בלקו\"ת דכאשר לא ישנו הענין דבכל יום כחדשים אזי המרירות והתענוג שלו הם מעניני עוה\"ז,"
        },
        {
          "s": 25,
          "text": "כי בכדי שיהי' היחוד דסובב וממלא,"
        },
        {
          "s": 26,
          "text": "שעי\"ז עניני עוה\"ז אינם תופסים מקום אצלו,"
        },
        {
          "s": 27,
          "text": "הוא ע\"י שקיום המצוות שלו הוא באופן דבכל יום כחדשים."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יש לבאר השייכות דגלות לשכחה,"
        },
        {
          "s": 2,
          "text": "כמ\"ש39"
        },
        {
          "s": 3,
          "text": "למה לנצח תשכחנו גו',"
        },
        {
          "s": 4,
          "text": "כי סיבת השכחה היא שהידיעה שהיתה אצלו מקודם היתה מוגבלת,"
        },
        {
          "s": 5,
          "text": "ולכן במשך הזמן היא נפסקת40."
        },
        {
          "s": 6,
          "text": "ומזה מובן בענין הזכרון והשכחה"
        },
        {
          "s": 7,
          "text": "(כביכול)"
        },
        {
          "s": 8,
          "text": "למעלה,"
        },
        {
          "s": 9,
          "text": "דענין הזכרון הוא בסובב,"
        },
        {
          "s": 10,
          "text": "דכיון שהוא בל\"ג,"
        },
        {
          "s": 11,
          "text": "אין שייך שם הפסק,"
        },
        {
          "s": 12,
          "text": "וענין השכחה הוא במלכות,"
        },
        {
          "s": 13,
          "text": "דמלכות היא שרש הנבראים,"
        },
        {
          "s": 14,
          "text": "ממלא41."
        },
        {
          "s": 15,
          "text": "ולכן,"
        },
        {
          "s": 16,
          "text": "כשקיום התומ\"צ דהאדם הוא באופן דבכל יום הם כחדשים,"
        },
        {
          "s": 17,
          "text": "שעי\"ז מאיר הגילוי דאור הבל\"ג גם באור המוגבל,"
        },
        {
          "s": 18,
          "text": "אין שייך ענין השכחה,"
        },
        {
          "s": 19,
          "text": "אבל כאשר קיום התומ\"צ דהאדם הוא בהגבלה,"
        },
        {
          "s": 20,
          "text": "שאז,"
        },
        {
          "s": 21,
          "text": "כשמקיים אותה המצוה בפעם שני' ושלישית אין לו אותו החיות כמו שהי' אצלו בפעם הראשונה,"
        },
        {
          "s": 22,
          "text": "שעי\"ז גורם גם למעלה שבאור המוגבל לא יהי' הגילוי דאור הבל\"ג,"
        },
        {
          "s": 23,
          "text": "מזה נמשך ענין השכחה."
        },
        {
          "s": 24,
          "text": "וכמו שבאדם,"
        },
        {
          "s": 25,
          "text": "כשקיום התומ\"צ שלו הוא באופן דהגבלה,"
        },
        {
          "s": 26,
          "text": "משתלשל מזה שהתענוג שלו הוא בעניני עוה\"ז,"
        },
        {
          "s": 27,
          "text": "שזה"
        },
        {
          "s": 28,
          "text": "(התענוג בעניני עוה\"ז,"
        },
        {
          "s": 29,
          "text": "גם בתאוות היתר)"
        },
        {
          "s": 30,
          "text": "הוא היפך הקדושה,"
        },
        {
          "s": 31,
          "text": "עד\"ז הוא למעלה,"
        },
        {
          "s": 32,
          "text": "דע\"י שז\"א"
        },
        {
          "s": 33,
          "text": "(סובב)"
        },
        {
          "s": 34,
          "text": "מסתלק,"
        },
        {
          "s": 35,
          "text": "קוב\"ה סליק לעילא42,"
        },
        {
          "s": 36,
          "text": "ונשאר רק המלכות"
        },
        {
          "s": 37,
          "text": "(ממלא),"
        },
        {
          "s": 38,
          "text": "זה גורם ירידת המלכות להחיות הקליפות,"
        },
        {
          "s": 39,
          "text": "גלות השכינה."
        }
      ]
    }
  ]
}