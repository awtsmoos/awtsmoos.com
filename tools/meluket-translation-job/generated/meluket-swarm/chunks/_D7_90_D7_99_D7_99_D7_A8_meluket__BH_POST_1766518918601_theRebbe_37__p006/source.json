  "owner": 10,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918601_theRebbe_37__p006",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918601_theRebbe_37__p006",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918601_theRebbe_37",
  "title": "מאמר גל עיני ואביטה תשל\"ז",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "וע\"י לימוד והפצת פנימיות התורה,"
        },
        {
          "s": 3,
          "text": "תורתו של רשב\"י,"
        },
        {
          "s": 4,
          "text": "ובפרט כמו שנתגלתה בתורת החסידות,"
        },
        {
          "s": 5,
          "text": "גילוי באופן דיתפרנסון,"
        },
        {
          "s": 6,
          "text": "הבנה והשגה,"
        },
        {
          "s": 7,
          "text": "ועד שהשכל דהאדם הלומד נעשה חד עם הענין שלומד50"
        },
        {
          "s": 8,
          "text": "[שהוא ע\"ד המבואר לעיל בענין גל עיני,"
        },
        {
          "s": 9,
          "text": "שראיית הנפלאות דתורה היא מצד ענינו של האדם עצמו],"
        },
        {
          "s": 10,
          "text": "זוכים לגילוי פנימיות התורה שיהי' לע\"ל,"
        },
        {
          "s": 11,
          "text": "שהגילוי אז יהי' נוסף על מצד מלמעלה אלא שזה יהי' ענינו דהעולם,"
        },
        {
          "s": 12,
          "text": "כמ\"ש הרמב\"ם51"
        },
        {
          "s": 13,
          "text": "ולא יהי' עסק כל העולם אלא לדעת את ה' בלבד כו'52"
        },
        {
          "s": 14,
          "text": "שנאמר53"
        },
        {
          "s": 15,
          "text": "כי מלאה הארץ דיעה את ה' כמים לים מכסים,"
        },
        {
          "s": 16,
          "text": "בגאולה האמיתית והשלימה ע\"י משיח צדקנו,"
        },
        {
          "s": 17,
          "text": "בקרוב ממש."
        }
      ]
    }
  ]
}