{
  "globalIndex": 505,
  "owner": 5,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916754_theRebbe_640__p004",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916754_theRebbe_640__p004",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916754_theRebbe_640",
  "title": "מאמר באתי לגני תשכ\"ח",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ויש להוסיף,"
        },
        {
          "s": 1,
          "text": "דמ\"ש כי לא אדם הוא,"
        },
        {
          "s": 2,
          "text": "אדם סתם"
        },
        {
          "s": 3,
          "text": "(אף שכוונת הכתוב שאינו בגדר ציור אדם העליון),"
        },
        {
          "s": 4,
          "text": "הוא לפי שאמיתית ועיקר ענין אדם הוא באדם העליון,"
        },
        {
          "s": 5,
          "text": "וזה שהאדם שלמטה נקרא בשם אדם הוא"
        },
        {
          "s": 6,
          "text": "(על שם אדמה לעליון49)"
        },
        {
          "s": 7,
          "text": "מפני שהוא דומה לאדם העליון,"
        },
        {
          "s": 8,
          "text": "ועל דמות הכסא דמות כמראה אדם50."
        },
        {
          "s": 9,
          "text": "ויתירה מזו,"
        },
        {
          "s": 10,
          "text": "שגם האדם שעל הכסא הוא רק \"כמראה אדם\""
        },
        {
          "s": 11,
          "text": "(בכ\"ף הדמיון)"
        },
        {
          "s": 12,
          "text": "ולא אדם עצמו,"
        },
        {
          "s": 13,
          "text": "כי אמיתית ועיקר ענין אדם הוא באצילות."
        },
        {
          "s": 14,
          "text": "משא\"כ האדם שעל הכסא שבבריאה"
        },
        {
          "s": 15,
          "text": "(כסא הכבוד הוא בבריאה51)"
        },
        {
          "s": 16,
          "text": "הוא רק דמות כמראה אדם52."
        },
        {
          "s": 17,
          "text": "ובפרטיות יותר,"
        },
        {
          "s": 18,
          "text": "גם באצילות ישנם שני ענינים אלה."
        },
        {
          "s": 19,
          "text": "אדם הוא ז\"א דאצילות,"
        },
        {
          "s": 20,
          "text": "ומלכות דאצילות היא \"כמראה אדם\"53."
        },
        {
          "s": 21,
          "text": "ולמעלה יותר,"
        },
        {
          "s": 22,
          "text": "גם ז\"א הוא רק \"כמראה אדם\" ואדם ממש הוא באריך54."
        },
        {
          "s": 23,
          "text": "וזהו כי לא אדם הוא להנחם,"
        },
        {
          "s": 24,
          "text": "אדם סתם קאי על האדם העליון"
        },
        {
          "s": 25,
          "text": "(עד לאדם דאריך),"
        },
        {
          "s": 26,
          "text": "ולא אדם הוא עתיק,"
        },
        {
          "s": 27,
          "text": "דבבחינת עתיק אין שייך נחמה וחרטה."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה הטעם על זה שבאדם שייך נחמה,"
        },
        {
          "s": 2,
          "text": "מבאר בהמאמר,"
        },
        {
          "s": 3,
          "text": "דאדם הוא מוחין ומדות."
        },
        {
          "s": 4,
          "text": "ומבאר,"
        },
        {
          "s": 5,
          "text": "דזה שאדם הוא מוחין ומדות,"
        },
        {
          "s": 6,
          "text": "הכוונה בזה היא שהמדות"
        },
        {
          "s": 7,
          "text": "(שבו)"
        },
        {
          "s": 8,
          "text": "הם ע\"פ שכל והשכל"
        },
        {
          "s": 9,
          "text": "(שבו)"
        },
        {
          "s": 10,
          "text": "שייך למדות."
        },
        {
          "s": 11,
          "text": "ויש לומר,"
        },
        {
          "s": 12,
          "text": "דמ\"ש בהמאמר שאדם הוא מוחין ומדות ושהמוחין והמדות שבו שייכים זל\"ז,"
        },
        {
          "s": 13,
          "text": "הוא לא רק בכדי לבאר הטעם על זה שבאדם שייך נחמה"
        },
        {
          "s": 14,
          "text": "(כדלקמן),"
        },
        {
          "s": 15,
          "text": "אלא גם בכדי לבאר גודל העילוי דאדם"
        },
        {
          "s": 16,
          "text": "[דזה שאדם הוא מוחין ומדות ושהמוחין והמדות שבו שייכים זל\"ז הוא מצד גודל העילוי שלו,"
        },
        {
          "s": 17,
          "text": "כדלקמן],"
        },
        {
          "s": 18,
          "text": "שעי\"ז יובן יותר גודל העילוי דבחי' לא אדם,"
        },
        {
          "s": 19,
          "text": "שהוא למעלה גם מהעילוי דאדם."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ויובן זה ע\"פ הידוע55"
        },
        {
          "s": 1,
          "text": "שהאדם כלול מכל המדריגות."
        },
        {
          "s": 2,
          "text": "דנוסף לזה שהוא כלול מכל המדות,"
        },
        {
          "s": 3,
          "text": "כמ\"ש הרמב\"ם56"
        },
        {
          "s": 4,
          "text": "דהבע\"ח והאילנות יש להם פעל חד בלבד או ב' פעלים אבל האדם יעשה מעשים רבים משתנים זה מזה,"
        },
        {
          "s": 5,
          "text": "היינו דכל הנבראים,"
        },
        {
          "s": 6,
          "text": "יש לכל אחד מהם מדה מיוחדת"
        },
        {
          "s": 7,
          "text": "(נשר רחמני והעורב אכזרי57,"
        },
        {
          "s": 8,
          "text": "וכן במלאכים,"
        },
        {
          "s": 9,
          "text": "מיכאל באהבה וגבריאל ביראה),"
        },
        {
          "s": 10,
          "text": "והאדם כלול מכל המדות"
        },
        {
          "s": 11,
          "text": "[דהתכללות זו שבאדם היא זה שהוא כלול מכל הענינים במדריגה אחת,"
        },
        {
          "s": 12,
          "text": "מדות],"
        },
        {
          "s": 13,
          "text": "הנה נוסף לזה הוא כלול גם מכל המדריגות,"
        },
        {
          "s": 14,
          "text": "מדרגא הכי עליונה עד דרגא הכי תחתונה,"
        },
        {
          "s": 15,
          "text": "כדאיתא במדרש58"
        },
        {
          "s": 16,
          "text": "שהאדם נברא מן העליונים ומן התחתונים."
        },
        {
          "s": 17,
          "text": "וזהו שאדם הוא מוחין ומדות,"
        },
        {
          "s": 18,
          "text": "דטבע המוחין הוא עלי' למעלה וטבע המדות הוא ירידה למטה,"
        },
        {
          "s": 19,
          "text": "וכיון שהאדם כלול מן העליונים ומן התחתונים"
        },
        {
          "s": 20,
          "text": "(משניהם יחד),"
        },
        {
          "s": 21,
          "text": "לכן,"
        },
        {
          "s": 22,
          "text": "מוחין בפ\"ע או מדות בפ\"ע אינם ענין אדם,"
        },
        {
          "s": 23,
          "text": "וענין האדם הוא מוחין ומדות."
        },
        {
          "s": 24,
          "text": "וזהו59"
        },
        {
          "s": 25,
          "text": "גם הטעם על זה שהמדות דאדם הם ע\"פ שכל והשכל דאדם שייך למדות"
        },
        {
          "s": 26,
          "text": "(אף ששכל ומדות הם שני ענינים שונים וגם הפכים),"
        },
        {
          "s": 27,
          "text": "כי כל ענין שבו,"
        },
        {
          "s": 28,
          "text": "הן השכל והן המדות,"
        },
        {
          "s": 29,
          "text": "הוא מצד נקודת השלימות שלו שכוללת את שניהם,"
        },
        {
          "s": 30,
          "text": "ולכן הם שייכים זל\"ז."
        },
        {
          "s": 31,
          "text": "וזהו מ\"ש בהמאמר שאדם הוא מוחין ומדות וכו',"
        },
        {
          "s": 32,
          "text": "כי בזה ניכר גודל העילוי דאדם,"
        },
        {
          "s": 33,
          "text": "נקודת השלימות דעליונים ותחתונים."
        }
      ]
    }
  ]
}