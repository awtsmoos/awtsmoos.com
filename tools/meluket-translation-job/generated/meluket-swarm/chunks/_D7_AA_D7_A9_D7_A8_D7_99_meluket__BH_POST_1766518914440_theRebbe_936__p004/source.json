{
  "globalIndex": 129,
  "owner": 29,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914440_theRebbe_936__p004",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914440_theRebbe_936__p004",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914440_theRebbe_936",
  "title": "מאמר תורה צוה תשכ\"ג",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "וזהו תורה צוה גו' מורשה קהלת יעקב ויהי בישורון מלך גו' יחד שבטי ישראל,"
        },
        {
          "s": 2,
          "text": "דזה שהתורה היא ירושה לכל אחד מישראל הוא מצד בחינת יעקב שבהם"
        },
        {
          "s": 3,
          "text": "(מורשה קהלת יעקב),"
        },
        {
          "s": 4,
          "text": "והענין דהתקן עצמך ללמוד תורה שאינה ירושה לך הוא מצד בחינת ישראל,"
        },
        {
          "s": 5,
          "text": "והמתנה דתורה היא מצד בחינת ישורון."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "והענין הוא,"
        },
        {
          "s": 1,
          "text": "דיעקב הוא בחינת עבד כמ\"ש34"
        },
        {
          "s": 2,
          "text": "שמע אלי יעקב עבדי,"
        },
        {
          "s": 3,
          "text": "וישראל הוא בחינת בן כמ\"ש35"
        },
        {
          "s": 4,
          "text": "בני בכורי ישראל36."
        },
        {
          "s": 5,
          "text": "והעבודה דיעקב היא37"
        },
        {
          "s": 6,
          "text": "שהוא עובד אלקים,"
        },
        {
          "s": 7,
          "text": "לתקן ההסתר הנמשך משם אלקים."
        },
        {
          "s": 8,
          "text": "וישראל הוא על שם כי שרית עם אלקים38,"
        },
        {
          "s": 9,
          "text": "שמושל ושולט על שם אלקים."
        },
        {
          "s": 10,
          "text": "וזהו שאיתא בזהר39"
        },
        {
          "s": 11,
          "text": "שישראל ויעקב הם נגד ב' השמות הוי' ואלקים,"
        },
        {
          "s": 12,
          "text": "דלגבי בחינת יעקב י' עקב40"
        },
        {
          "s": 13,
          "text": "ישנו ההסתר דשם אלקים ועבודתו היא לתקן ההסתר."
        },
        {
          "s": 14,
          "text": "וגם לאחרי שמתקן ההסתר דשם אלקים,"
        },
        {
          "s": 15,
          "text": "שעי\"ז נמשך הגילוי דהוי',"
        },
        {
          "s": 16,
          "text": "הוא הגילוי דהוי' כמו שהוא ע\"י שם אלקים."
        },
        {
          "s": 17,
          "text": "וישראל שהוא על שם כי שרית עם אלקים,"
        },
        {
          "s": 18,
          "text": "שלגבי' אין מלכתחילה ההעלם וההסתר דשם אלקים,"
        },
        {
          "s": 19,
          "text": "הגילוי דהוי' שנמשך ע\"י ישראל הוא הגילוי דהוי' עצמו."
        },
        {
          "s": 20,
          "text": "ומבואר בלקו\"ת41"
        },
        {
          "s": 21,
          "text": "שהעבודה בששת ימי החול היא"
        },
        {
          "s": 22,
          "text": "(בדרך כלל)"
        },
        {
          "s": 23,
          "text": "העבודה דיעקב,"
        },
        {
          "s": 24,
          "text": "עבודת הבירורים,"
        },
        {
          "s": 25,
          "text": "לתקן ההסתר דשם אלקים."
        },
        {
          "s": 26,
          "text": "והעבודה דשבת היא בבחינת ישראל."
        },
        {
          "s": 27,
          "text": "כי בשבת כתיב42"
        },
        {
          "s": 28,
          "text": "ויכל אלקים,"
        },
        {
          "s": 29,
          "text": "שכלתה מדת הצמצום וההסתר דשם אלקים ונמשך הגילוי דהוי',"
        },
        {
          "s": 30,
          "text": "ולכן אין צריך אז לעבודת הבירורים,"
        },
        {
          "s": 31,
          "text": "והעבודה דשבת היא להתענג על הוי',"
        },
        {
          "s": 32,
          "text": "שלמעלה מעבודת הבירורים."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ובחינת ישורון היא למעלה גם מבחינת ישראל."
        },
        {
          "s": 1,
          "text": "דישורון הוא מלשון שיר,"
        },
        {
          "s": 2,
          "text": "דבר עגול כטבעת שאין לו ראש וסוף43."
        },
        {
          "s": 3,
          "text": "ומבואר בלקו\"ת44"
        },
        {
          "s": 4,
          "text": "דזה שישראל נק' בשם ישורון הוא מצד שורש הנשמות כמו שעלו במחשבה."
        },
        {
          "s": 5,
          "text": "ויש לומר,"
        },
        {
          "s": 6,
          "text": "דהחילוק שבין ישורון לישראל,"
        },
        {
          "s": 7,
          "text": "אף שגם הענין דישראל על שם כי שרית עם אלקים הוא מצד הגילוי דשורש הנשמה שלמעלה מהתלבשות בגוף"
        },
        {
          "s": 8,
          "text": "[וכמבואר בכ\"מ45"
        },
        {
          "s": 9,
          "text": "דיעקב הוא הנשמה שמלובשת בגוף וישראל הוא שורש הנשמה שלמעלה מהתלבשות בגוף],"
        },
        {
          "s": 10,
          "text": "דישראל הוא בחינת בן"
        },
        {
          "s": 11,
          "text": "(כנ\"ל),"
        },
        {
          "s": 12,
          "text": "דלשון וענין בן שייך דוקא לאחרי שהבן נמשך ממוח האב,"
        },
        {
          "s": 13,
          "text": "וישורון הוא עצם הנשמה כמו שהיא מושרשת בעצמותו ית',"
        },
        {
          "s": 14,
          "text": "בדוגמת הבן כמו שהוא במוח האב עצמו"
        },
        {
          "s": 15,
          "text": "(טרם שנמשך)."
        },
        {
          "s": 16,
          "text": "וזהו שישורון הוא מלשון שיר שאין בו ראש וסוף,"
        },
        {
          "s": 17,
          "text": "כי בהדרגא דהנשמות כמו שנמשכו כבר ממוח האב"
        },
        {
          "s": 18,
          "text": "(גם כמו שהם למעלה)"
        },
        {
          "s": 19,
          "text": "ישנם חילוקי דרגות,"
        },
        {
          "s": 20,
          "text": "והענין דשיר שאין בו ראש וסוף הוא בעצם הנשמות כמו שהם מושרשים באוא\"ס."
        },
        {
          "s": 21,
          "text": "וזהו מ\"ש ויהי בישורון מלך ואיתא בלקו\"ת44"
        },
        {
          "s": 22,
          "text": "שזה קאי על ראש השנה,"
        },
        {
          "s": 23,
          "text": "שתמליכוני עליכם,"
        },
        {
          "s": 24,
          "text": "כי הענין דתמליכוני עליכם הוא ע\"י גילוי עצם הנשמה כמו שהיא מושרשת בעצמות אוא\"ס."
        }
      ]
    }
  ]
}