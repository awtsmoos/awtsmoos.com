{
  "globalIndex": 135,
  "owner": 35,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914464_theRebbe_108__p003",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914464_theRebbe_108__p003",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914464_theRebbe_108",
  "title": "מאמר אתה הראת לדעת תשל\"ז",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "וזהו אתה הראת לדעת כי הוי' הוא האלקים,"
        },
        {
          "s": 1,
          "text": "כי בע\"ס דאצילות"
        },
        {
          "s": 2,
          "text": "(גם בחב\"ד דאצילות)"
        },
        {
          "s": 3,
          "text": "יש אורות וכלים."
        },
        {
          "s": 4,
          "text": "דשרש האורות הוא מהוי' ושרש הכלים הוא מאלקים."
        },
        {
          "s": 5,
          "text": "וע\"י הידיעה שהוי' הוא האלקים,"
        },
        {
          "s": 6,
          "text": "דהוי' ואלקים כולא חד39,"
        },
        {
          "s": 7,
          "text": "באים להידיעה שאין עוד מלבדו."
        },
        {
          "s": 8,
          "text": "כי שני השמות הוי' ואלקים כמו שהם מצד עצמם,"
        },
        {
          "s": 9,
          "text": "הם שני ענינים שונים,"
        },
        {
          "s": 10,
          "text": "ויתירה מזו שהם שני ענינים הפכיים,"
        },
        {
          "s": 11,
          "text": "דהוי' הוא גילוי ואלקים הוא צמצום והעלם."
        },
        {
          "s": 12,
          "text": "וזה שהוי' ואלקים כולא חד הוא מפני ששניהם הם שמותיו של הקב\"ה שלמעלה משניהם40,"
        },
        {
          "s": 13,
          "text": "אלא שכך עלה ברצונו ית' שהגילוי שלו יהי' בשני הקוין דבל\"ג וגבול"
        },
        {
          "s": 14,
          "text": "(גילוי וצמצום),"
        },
        {
          "s": 15,
          "text": "ולכן,"
        },
        {
          "s": 16,
          "text": "גם לאחרי שנמשכו בגילוי בענין השמות,"
        },
        {
          "s": 17,
          "text": "שאז הם שני ענינים הפכיים,"
        },
        {
          "s": 18,
          "text": "הם מתכללים זמ\"ז,"
        },
        {
          "s": 19,
          "text": "ועד שהוי' ואלקים כולא חד."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה זה שהאורות והכלים"
        },
        {
          "s": 2,
          "text": "(הוי' ואלקים)"
        },
        {
          "s": 3,
          "text": "בשרשם הם כולא חד,"
        },
        {
          "s": 4,
          "text": "כמה מדריגות בזה."
        },
        {
          "s": 5,
          "text": "דבכללות הו\"ע עשר ספירות הגנוזות."
        },
        {
          "s": 6,
          "text": "שגם בע\"ס הגנוזות יש"
        },
        {
          "s": 7,
          "text": "(דוגמת)"
        },
        {
          "s": 8,
          "text": "אורות וכלים41,"
        },
        {
          "s": 9,
          "text": "והם השרש של האורות וכלים שבע\"ס הגלויות,"
        },
        {
          "s": 10,
          "text": "אלא שבע\"ס הגנוזות הם כולא חד."
        },
        {
          "s": 11,
          "text": "דכמו שענין ההתחלקות דהספירות"
        },
        {
          "s": 12,
          "text": "(חכמה,"
        },
        {
          "s": 13,
          "text": "בינה וכו')"
        },
        {
          "s": 14,
          "text": "הוא בספירות הגלויות משא\"כ ע\"ס הגנוזות הם כלולים כולם כאחד בבחינת התערבות והתאחדות42,"
        },
        {
          "s": 15,
          "text": "עד\"ז הוא גם בענין ההתחלקות דאורות וכלים,"
        },
        {
          "s": 16,
          "text": "שבע\"ס הגנוזות הם"
        },
        {
          "s": 17,
          "text": "(האורות והכלים)"
        },
        {
          "s": 18,
          "text": "בהתאחדות."
        },
        {
          "s": 19,
          "text": "אבל בפרטיות,"
        },
        {
          "s": 20,
          "text": "גם בע\"ס הגנוזות,"
        },
        {
          "s": 21,
          "text": "אורות וכלים הם שני ענינים."
        },
        {
          "s": 22,
          "text": "וזה שהוי' ואלקים כולא חד הוא בכללות האור שלפני הצמצום."
        },
        {
          "s": 23,
          "text": "דהנה ידוע43"
        },
        {
          "s": 24,
          "text": "שבהאור שלפני הצמצום יש שתי מדריגות בכללות."
        },
        {
          "s": 25,
          "text": "שהאור מצד עצמו הוא אין סוף"
        },
        {
          "s": 26,
          "text": "[והספירות שמצד האור עצמו הם ספירות אין קץ],"
        },
        {
          "s": 27,
          "text": "והוא השרש דאור הסובב,"
        },
        {
          "s": 28,
          "text": "ומצד זה שעלה ברצונו להאציל כו' יש בו גם השרש דעשר ספירות"
        },
        {
          "s": 29,
          "text": "(ע\"ס הגנוזות),"
        },
        {
          "s": 30,
          "text": "והוא השרש דאור הממלא."
        },
        {
          "s": 31,
          "text": "וזהו ששמו הגדול שלפני הצמצום הוא דוגמת הוי' בניקוד אלקים,"
        },
        {
          "s": 32,
          "text": "שמצד עצמו הוא א\"ס,"
        },
        {
          "s": 33,
          "text": "הוי',"
        },
        {
          "s": 34,
          "text": "אלא שאעפ\"כ כלול בו גם השרש דאור הגבול"
        },
        {
          "s": 35,
          "text": "(ממלא),"
        },
        {
          "s": 36,
          "text": "אלקים."
        },
        {
          "s": 37,
          "text": "וכיון דזה שכלול בו השרש דאור הגבול הוא מפני שעלה ברצונו"
        },
        {
          "s": 38,
          "text": "(דאוא\"ס הבל\"ג)"
        },
        {
          "s": 39,
          "text": "שיהיו עשר ספירות,"
        },
        {
          "s": 40,
          "text": "דאמיתית ענין הרצון הוא שגם לאחרי שרוצה באיזה דבר ענינו של הדבר שרוצה בו הוא"
        },
        {
          "s": 41,
          "text": "(לא הדבר מצד עצמו,"
        },
        {
          "s": 42,
          "text": "אלא)"
        },
        {
          "s": 43,
          "text": "להשלים זה שהוא רוצה44,"
        },
        {
          "s": 44,
          "text": "לכן,"
        },
        {
          "s": 45,
          "text": "השרש דאור הגבול כמו שהוא לפני הצמצום,"
        },
        {
          "s": 46,
          "text": "הוא"
        },
        {
          "s": 47,
          "text": "(לא ענין בפני עצמו,"
        },
        {
          "s": 48,
          "text": "אלא)"
        },
        {
          "s": 49,
          "text": "חד עם"
        },
        {
          "s": 50,
          "text": "(הרצון של)"
        },
        {
          "s": 51,
          "text": "אוא\"ס הבל\"ג."
        },
        {
          "s": 52,
          "text": "וכמובן גם מזה שמובא לעיל דשמו הגדול שלפני הצמצום הוא דוגמת הוי' בניקוד אלקים,"
        },
        {
          "s": 53,
          "text": "היינו שהוא שם אחד שכולל שני הענינים דהוי' ואלקים."
        },
        {
          "s": 54,
          "text": "אמנם בפרטיות יותר,"
        },
        {
          "s": 55,
          "text": "מכיון שגם ברצון יש תפיסת מקום להדבר שרוצים בו"
        },
        {
          "s": 56,
          "text": "(שע\"י דבר זה דוקא נשלם הרצון),"
        },
        {
          "s": 57,
          "text": "לכן,"
        },
        {
          "s": 58,
          "text": "זה שבהאור שלפני הצמצום יש שרש לאור הסובב"
        },
        {
          "s": 59,
          "text": "(בל\"ג,"
        },
        {
          "s": 60,
          "text": "הוי')"
        },
        {
          "s": 61,
          "text": "ושרש לאור הממלא"
        },
        {
          "s": 62,
          "text": "(גבול,"
        },
        {
          "s": 63,
          "text": "אלקים),"
        },
        {
          "s": 64,
          "text": "הם כמו שני ענינים."
        },
        {
          "s": 65,
          "text": "ואמיתית הענין דהוי' ואלקים כולא חד הוא בבחינת היכולת"
        },
        {
          "s": 66,
          "text": "(שלמעלה מענין הספירות,"
        },
        {
          "s": 67,
          "text": "שאין שייך בו גם ספירות אין קץ),"
        },
        {
          "s": 68,
          "text": "דזה שביכלתו להאיר"
        },
        {
          "s": 69,
          "text": "(השרש דהוי')"
        },
        {
          "s": 70,
          "text": "ושביכלתו שלא להאיר"
        },
        {
          "s": 71,
          "text": "(השרש דאלקים)"
        },
        {
          "s": 72,
          "text": "הוא חד ממש."
        },
        {
          "s": 73,
          "text": "וע\"ד המבואר במק\"א45,"
        },
        {
          "s": 74,
          "text": "דבהאור שלפני הצמצום,"
        },
        {
          "s": 75,
          "text": "גם בהאור שקודם עלות הרצון,"
        },
        {
          "s": 76,
          "text": "הגילוי וההעלם הם שני ענינים."
        },
        {
          "s": 77,
          "text": "ולכן,"
        },
        {
          "s": 78,
          "text": "העבודה כמו שהיא מצד האור שלפני הצמצום היא להמשיך ריבוי אור"
        },
        {
          "s": 79,
          "text": "(ע\"ד שקודם הצמצום הי' התגברות כח הגילוי על כח ההעלם)."
        },
        {
          "s": 80,
          "text": "ובכדי שיהי' אתהפכא חשוכא לנהורא,"
        },
        {
          "s": 81,
          "text": "שהחושך עצמו יהפך לאור,"
        },
        {
          "s": 82,
          "text": "הוא דוקא מצד ענין היכולת."
        },
        {
          "s": 83,
          "text": "דכיון שהיכולת להאיר"
        },
        {
          "s": 84,
          "text": "(שרש האור)"
        },
        {
          "s": 85,
          "text": "והיכולת שלא להאיר"
        },
        {
          "s": 86,
          "text": "(שרש החושך)"
        },
        {
          "s": 87,
          "text": "הם חד ממש,"
        },
        {
          "s": 88,
          "text": "לכן,"
        },
        {
          "s": 89,
          "text": "ע\"י שמגיעים בבחינת היכולת,"
        },
        {
          "s": 90,
          "text": "גם החושך נהפך לאור."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "וזהו הקשר דהוי' הוא האלקים עם אין עוד מלבדו,"
        },
        {
          "s": 1,
          "text": "שע\"י הידיעה דהוי' הוא האלקים באים להידיעה שאין עוד מלבדו"
        },
        {
          "s": 2,
          "text": "(כנ\"ל סעיף ה),"
        },
        {
          "s": 3,
          "text": "דמזה שרואים שהוי' ואלקים הם מאוחדים כאחד ממש,"
        },
        {
          "s": 4,
          "text": "שבעבודת האדם הוא ואהבת את הוי' אלקיך בכל לבבך בשני יצריך46,"
        },
        {
          "s": 5,
          "text": "שגם היצה\"ר"
        },
        {
          "s": 6,
          "text": "(ששרשו מההעלם דאלקים)"
        },
        {
          "s": 7,
          "text": "אוהב את הוי'"
        },
        {
          "s": 8,
          "text": "(כמו היצ\"ט ששרשו מהגילוי דהוי'),"
        },
        {
          "s": 9,
          "text": "מזה יודעים שאין עוד מלבדו,"
        },
        {
          "s": 10,
          "text": "שהשרש דשני הענינים"
        },
        {
          "s": 11,
          "text": "(של הגילוי דהוי' וההעלם דאלקים)"
        },
        {
          "s": 12,
          "text": "הוא זה שביכלתו להאיר וביכלתו שלא להאיר,"
        },
        {
          "s": 13,
          "text": "דענין היכולת אינו דבר כלל זולת העצמות והוא רק שהעצמות הוא יכול,"
        },
        {
          "s": 14,
          "text": "אין עוד מלבדו."
        },
        {
          "s": 15,
          "text": "וזהו גם מה שאומר בתחלת הכתוב אתה הראת לדעת,"
        },
        {
          "s": 16,
          "text": "דו האָסט זיך באַוויזן אַז מען זאָל דיך וויסן,"
        },
        {
          "s": 17,
          "text": "כי כיון שענין היכולת הוא זה שהעצמות הוא יכול,"
        },
        {
          "s": 18,
          "text": "הידיעה בענין היכולת היא ידיעת העצמות47."
        }
      ]
    }
  ]
}