{
  "globalIndex": 867,
  "owner": 17,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918894_theRebbe_986__p002",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918894_theRebbe_986__p002",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918894_theRebbe_986",
  "title": "מאמר בהעלותך את הנרות תשל\"ד",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ויובן זה ע\"פ מ\"ש בלקו\"ת15"
        },
        {
          "s": 1,
          "text": "שז' הנרות דהמנורה הם ז' סוגי בנ\"י בעבודת ה',"
        },
        {
          "s": 2,
          "text": "יש עובד מאהבה משוך כמים"
        },
        {
          "s": 3,
          "text": "(חסד)"
        },
        {
          "s": 4,
          "text": "ויש מאהבה כרשפי אש"
        },
        {
          "s": 5,
          "text": "(גבורה)"
        },
        {
          "s": 6,
          "text": "וכו'."
        },
        {
          "s": 7,
          "text": "ויש לומר,"
        },
        {
          "s": 8,
          "text": "דזה שז' סוגים אלה"
        },
        {
          "s": 9,
          "text": "(אף שהחילוק שביניהם הוא רק באופן עבודתם)"
        },
        {
          "s": 10,
          "text": "נק' ז' נרות"
        },
        {
          "s": 11,
          "text": "(דמזה שהנשמה קרוי' נר16"
        },
        {
          "s": 12,
          "text": "משמע שהם ז' סוגי נשמות),"
        },
        {
          "s": 13,
          "text": "הוא,"
        },
        {
          "s": 14,
          "text": "כי כיון שאני נבראתי לשמש את קוני17"
        },
        {
          "s": 15,
          "text": "(ובפרט להגירסא18"
        },
        {
          "s": 16,
          "text": "אני לא נבראתי אלא לשמש את קוני),"
        },
        {
          "s": 17,
          "text": "לכן,"
        },
        {
          "s": 18,
          "text": "החילוק באופן עבודתם"
        },
        {
          "s": 19,
          "text": "(השימוש את קונם)"
        },
        {
          "s": 20,
          "text": "נוגע לעצם מציאותם."
        },
        {
          "s": 21,
          "text": "וע\"פ המבואר במק\"א19"
        },
        {
          "s": 22,
          "text": "בדיוק לשון רז\"ל אני נבראתי לשמש את קוני,"
        },
        {
          "s": 23,
          "text": "דזה שענינו של האדם"
        },
        {
          "s": 24,
          "text": "(הנשמה)"
        },
        {
          "s": 25,
          "text": "הוא לשמש את קונו,"
        },
        {
          "s": 26,
          "text": "הוא בנוגע לבריאתו,"
        },
        {
          "s": 27,
          "text": "ירידת הנשמה לבריאה,"
        },
        {
          "s": 28,
          "text": "אבל הנשמה עצמה כמו שהיא בבחינת טהורה היא20"
        },
        {
          "s": 29,
          "text": "(למעלה מבחינת אתה בראתה20),"
        },
        {
          "s": 30,
          "text": "כיון שהיא חלק אלוקה ממעל ממש21,"
        },
        {
          "s": 31,
          "text": "אינה אמצעי לאיזה ענין אחר"
        },
        {
          "s": 32,
          "text": "(גם לא להענין דלשמש את קונה)"
        },
        {
          "s": 33,
          "text": "והתכלית הוא בה בעצמה,"
        },
        {
          "s": 34,
          "text": "מובן,"
        },
        {
          "s": 35,
          "text": "שההתחלקות דנשמות באופן עבודתם היא רק בהדרגא דאתה בראתה,"
        },
        {
          "s": 36,
          "text": "ולא בעצם מהותם."
        },
        {
          "s": 37,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 38,
          "text": "דמ\"ש בהעלותך את הנרות,"
        },
        {
          "s": 39,
          "text": "נרות סתם"
        },
        {
          "s": 40,
          "text": "(ולא שבעת הנרות),"
        },
        {
          "s": 41,
          "text": "הוא לרמז שהעלי' דהנשמות"
        },
        {
          "s": 42,
          "text": "(בהעלותך את הנרות)"
        },
        {
          "s": 43,
          "text": "היא"
        },
        {
          "s": 44,
          "text": "(גם)"
        },
        {
          "s": 45,
          "text": "בהדרגא דטהורה היא שלמעלה מהתחלקות,"
        },
        {
          "s": 46,
          "text": "נרות סתם."
        },
        {
          "s": 47,
          "text": "דזה שמובא לעיל"
        },
        {
          "s": 48,
          "text": "(מהמאמר)"
        },
        {
          "s": 49,
          "text": "שבהעלותך את הנרות הוא בנשמות דבי\"ע,"
        },
        {
          "s": 50,
          "text": "דכיון שע\"י ירידתם לבי\"ע טבע הרצוא והעלי' שלהם הוא בהעלם לכן צריך לעורר ולגלות טבע העלי' שלהם,"
        },
        {
          "s": 51,
          "text": "בהעלותך את הנרות,"
        },
        {
          "s": 52,
          "text": "הוא התחלת העלי'."
        },
        {
          "s": 53,
          "text": "אבל עי\"ז נעשית בהם"
        },
        {
          "s": 54,
          "text": "(אח\"כ)"
        },
        {
          "s": 55,
          "text": "עלי' נעלית יותר,"
        },
        {
          "s": 56,
          "text": "שהם מתעלים למעלה יותר גם מכמו שהיו קודם ירידתם."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ויובן זה ע\"פ תורת הרב המגיד22"
        },
        {
          "s": 2,
          "text": "עה\"פ בהעלותך את הנרות,"
        },
        {
          "s": 3,
          "text": "דנרות הם המצוות כמ\"ש23"
        },
        {
          "s": 4,
          "text": "כי נר מצוה."
        },
        {
          "s": 5,
          "text": "דכמו שהנר שורה בו אור,"
        },
        {
          "s": 6,
          "text": "כך המצוה הפנימיות"
        },
        {
          "s": 7,
          "text": "(האור)"
        },
        {
          "s": 8,
          "text": "שלה הוא אהבה ויראה."
        },
        {
          "s": 9,
          "text": "ופירוש בהעלותך את הנרות"
        },
        {
          "s": 10,
          "text": "(דפירוש את הוא"
        },
        {
          "s": 11,
          "text": "(גם)"
        },
        {
          "s": 12,
          "text": "עם)"
        },
        {
          "s": 13,
          "text": "הוא,"
        },
        {
          "s": 14,
          "text": "שתעלה את עצמך עם המצוות,"
        },
        {
          "s": 15,
          "text": "והעלי' היא אל מול פני המנורה,"
        },
        {
          "s": 16,
          "text": "להפנימיות."
        },
        {
          "s": 17,
          "text": "וע\"ד מ\"ש24"
        },
        {
          "s": 18,
          "text": "וידבר אלקים את כל הדברים האלה לאמר אנכי גו',"
        },
        {
          "s": 19,
          "text": "שהכוונה דכל המצוות"
        },
        {
          "s": 20,
          "text": "(כל הדברים האלה)"
        },
        {
          "s": 21,
          "text": "היא לאמר,"
        },
        {
          "s": 22,
          "text": "שהאדם"
        },
        {
          "s": 23,
          "text": "(יחשוב ו)"
        },
        {
          "s": 24,
          "text": "יאמר אנכי ולא יהי' לך,"
        },
        {
          "s": 25,
          "text": "היינו או\"י"
        },
        {
          "s": 26,
          "text": "(ר\"ת אנכי ולא יהי',"
        },
        {
          "s": 27,
          "text": "וגם ר\"ת)"
        },
        {
          "s": 28,
          "text": "אהבה ויראה"
        },
        {
          "s": 29,
          "text": "(דאנכי הוא אהבה ולא יהי' לך יראה),"
        },
        {
          "s": 30,
          "text": "על פני פי' פנימיות,"
        },
        {
          "s": 31,
          "text": "שהפנימיות הוא הקב\"ה."
        },
        {
          "s": 32,
          "text": "וזהו אל מול פני המנורה."
        },
        {
          "s": 33,
          "text": "יאירו שבעת הנרות הם שבעת ימי הבנין,"
        },
        {
          "s": 34,
          "text": "אהבה ויראה ותפארת וכו'."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ולכאורה הכוונה בזה,"
        },
        {
          "s": 1,
          "text": "דבהפנימיות דמצוות שני ענינים."
        },
        {
          "s": 2,
          "text": "שעל ידי קיום המצוות"
        },
        {
          "s": 3,
          "text": "(הנר,"
        },
        {
          "s": 4,
          "text": "הכלי)"
        },
        {
          "s": 5,
          "text": "באים לאהוי\"ר25"
        },
        {
          "s": 6,
          "text": "(האור),"
        },
        {
          "s": 7,
          "text": "דזהו שאנכי ולא יהי'"
        },
        {
          "s": 8,
          "text": "(כללות כל המצוות26)"
        },
        {
          "s": 9,
          "text": "ר\"ת או\"י אהבה ויראה,"
        },
        {
          "s": 10,
          "text": "דפנימיות זו היא כמו אור הנר שהאור והנר הם בערך זה לזה,"
        },
        {
          "s": 11,
          "text": "ועי\"ז נמשך בהם אח\"כ פנימיות נעלית יותר – על פני27,"
        },
        {
          "s": 12,
          "text": "אמיתית הפנימיות שהוא הקב\"ה."
        },
        {
          "s": 13,
          "text": "ועפ\"ז יובן גם הקשר דשני הענינים דבהעלותך את הנרות להפירוש דנרות הם הנשמות,"
        },
        {
          "s": 14,
          "text": "גילוי טבע הרצוא והעלי' בנשמות דבי\"ע ושעי\"ז נעשה בהם עלי' למעלה יותר גם מכמו שהיו באצילות קודם ירידתם לבי\"ע,"
        },
        {
          "s": 15,
          "text": "דזה שהנשמה מתעוררת ברצוא"
        },
        {
          "s": 16,
          "text": "(אהבה רבה שלמעלה מטעם ודעת28),"
        },
        {
          "s": 17,
          "text": "הגם שעלי' זו היא אל מול פני המנורה"
        },
        {
          "s": 18,
          "text": "(בחי' פנימיות),"
        },
        {
          "s": 19,
          "text": "היא דרגא הראשונה דפנימיות"
        },
        {
          "s": 20,
          "text": "(דוגמת אהוי\"ר שנמשכים ע\"י המצוות),"
        },
        {
          "s": 21,
          "text": "ועי\"ז היא מתעלית למעלה יותר גם מכמו שהיתה באצילות,"
        },
        {
          "s": 22,
          "text": "דרגא השני' דפנימיות,"
        },
        {
          "s": 23,
          "text": "על פני."
        }
      ]
    }
  ]
}