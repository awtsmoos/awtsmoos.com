{
  "globalIndex": 152,
  "owner": 2,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914575_theRebbe_239__p001",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914575_theRebbe_239__p001",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914575_theRebbe_239",
  "title": "מאמר בראשית ברא תשל\"ח",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "מוצאי שבת בראשית – בחדרו – ה'תשל\"ח"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "בראשית ברא אלקים את השמים ואת הארץ,"
        },
        {
          "s": 1,
          "text": "וארז\"ל1"
        },
        {
          "s": 2,
          "text": "אמר ר' יצחק לא הי' צריך להתחיל את התורה אלא מהחודש הזה לכם כו',"
        },
        {
          "s": 3,
          "text": "ומה טעם פתח בבראשית משום כח מעשיו הגיד לעמו לתת להם נחלת גוים2,"
        },
        {
          "s": 4,
          "text": "שאם יאמרו אומות העולם לישראל לסטים אתם שכבשתם ארצות שבעה גוים הם אומרים להם כל הארץ של הקב\"ה היא הוא בראה ונתנה לאשר ישר בעיניו ברצונו נתנה להם וברצונו נטלה מהם ונתנה לנו."
        },
        {
          "s": 5,
          "text": "ומבואר בזה בדרושי רבותינו נשיאינו3,"
        },
        {
          "s": 6,
          "text": "דזה מה שהי' צריך להתחיל את התורה מהחודש הזה לכם הוא,"
        },
        {
          "s": 7,
          "text": "כי ענין \"החודש הזה\" הוא יחוד סובב וממלא."
        },
        {
          "s": 8,
          "text": "כי חודש הוא בחינת מלכות,"
        },
        {
          "s": 9,
          "text": "חודש אשתו4,"
        },
        {
          "s": 10,
          "text": "בחינת ממכ\"ע,"
        },
        {
          "s": 11,
          "text": "ו\"זה\" הוא ענין גילוי"
        },
        {
          "s": 12,
          "text": "[כמרז\"ל5"
        },
        {
          "s": 13,
          "text": "מראה באצבעו ואומר זה],"
        },
        {
          "s": 14,
          "text": "יסוד וז\"א,"
        },
        {
          "s": 15,
          "text": "יחוד סוכ\"ע וממכ\"ע."
        },
        {
          "s": 16,
          "text": "ופירוש \"החודש הזה"
        },
        {
          "s": 17,
          "text": "(לכם)"
        },
        {
          "s": 18,
          "text": "\" הוא שבבחי' ממכ\"ע"
        },
        {
          "s": 19,
          "text": "(חודש)"
        },
        {
          "s": 20,
          "text": "יהי' בו גילוי סוכ\"ע"
        },
        {
          "s": 21,
          "text": "(הזה)."
        },
        {
          "s": 22,
          "text": "והי' צריך להתחיל את התורה מהחודש הזה לכם,"
        },
        {
          "s": 23,
          "text": "כי תכלית התורה ומצוותי' הו\"ע יחוד סובב וממלא."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה ענין המשכת הסובב שע\"י תורה ומצוות בשרשו הראשון הוא המשכת אוא\"ס שלפני הצמצום."
        },
        {
          "s": 2,
          "text": "וכדאיתא בעמק המלך בתחלתו6,"
        },
        {
          "s": 3,
          "text": "דבריאת העולמות הי' ע\"י צמצום הראשון שהי' באוא\"ס ונשאר חלל ומקום פנוי,"
        },
        {
          "s": 4,
          "text": "ומזה הוא שרש התהוות הכלים ומציאות העולמות"
        },
        {
          "s": 5,
          "text": "(ענין מעשה בראשית)."
        },
        {
          "s": 6,
          "text": "ומ\"ש7"
        },
        {
          "s": 7,
          "text": "ויניחהו בג\"ע לעבדה ולשמרה"
        },
        {
          "s": 8,
          "text": "[שקאי על העבודה דתומ\"צ,"
        },
        {
          "s": 9,
          "text": "לעבדה זה רמ\"ח מ\"ע ולשמרה זה שס\"ה מל\"ת8]"
        },
        {
          "s": 10,
          "text": "הוא להמשיך תוספות אורות ע\"י הקו מאוא\"ס שלפני הצמצום,"
        },
        {
          "s": 11,
          "text": "עד שלעתיד יהי' גילוי אוא\"ס במקום החלל כמו שהי' קודם הצמצום."
        },
        {
          "s": 12,
          "text": "וזהו לא הי' צריך להתחיל את התורה אלא מהחודש הזה לכם כו',"
        },
        {
          "s": 13,
          "text": "כי סיפור מע\"ב הכל הוא אחר הצמצום,"
        },
        {
          "s": 14,
          "text": "ומכיון שענינה של התורה הוא המשכת אוא\"ס שלמעלה מהצמצום,"
        },
        {
          "s": 15,
          "text": "הוצרך להתחיל את התורה"
        },
        {
          "s": 16,
          "text": "(לא במע\"ב,"
        },
        {
          "s": 17,
          "text": "כ\"א)"
        },
        {
          "s": 18,
          "text": "מהחודש הזה שהו\"ע המשכת בחי' הסובב"
        },
        {
          "s": 19,
          "text": "(\"הזה\"),"
        },
        {
          "s": 20,
          "text": "שבשרשו הוא המשכת אוא\"ס שלפני הצמצום."
        }
      ]
    }
  ]
}