{
  "globalIndex": 873,
  "owner": 23,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918918_theRebbe_323__p004",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918918_theRebbe_323__p004",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918918_theRebbe_323",
  "title": "מאמר ועתה יגדל נא תשי\"ט",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "והנה כל הענינים שלמעלה,"
        },
        {
          "s": 2,
          "text": "המשכתם היא ע\"י עבודת האדם."
        },
        {
          "s": 3,
          "text": "וזהו ועתה יגדל נא כח אד' כאשר דברת לאמר,"
        },
        {
          "s": 4,
          "text": "דכאשר דברת קאי על הדיבור דהקב\"ה למשה הי' לך לעזרני,"
        },
        {
          "s": 5,
          "text": "שמשה יאמר תצלח מלאכתך36,"
        },
        {
          "s": 6,
          "text": "שהגדלת כח אד' נעשית ע\"י עבודת האדם"
        },
        {
          "s": 7,
          "text": "(אמירת משה)."
        },
        {
          "s": 8,
          "text": "וע\"פ הידוע37"
        },
        {
          "s": 9,
          "text": "שעבודת האדם"
        },
        {
          "s": 10,
          "text": "(אתערותא דלתתא)"
        },
        {
          "s": 11,
          "text": "שעל ידה נעשית ההמשכה"
        },
        {
          "s": 12,
          "text": "(אתערותא דלעילא)"
        },
        {
          "s": 13,
          "text": "צריכה להיות מעין ההמשכה,"
        },
        {
          "s": 14,
          "text": "מובן,"
        },
        {
          "s": 15,
          "text": "שבכדי שתהי' הגדלת כח אד'"
        },
        {
          "s": 16,
          "text": "(ממלא)"
        },
        {
          "s": 17,
          "text": "על ידי שיומשך בו מבחינת הסובב שלמעלה מהשתלשלות,"
        },
        {
          "s": 18,
          "text": "הוא ע\"י ההגדלה"
        },
        {
          "s": 19,
          "text": "(הוספה)"
        },
        {
          "s": 20,
          "text": "בהעבודה שע\"פ טעם ודעת ע\"י המשכת וגילוי העבודה שלמעלה מטעם ודעת."
        },
        {
          "s": 21,
          "text": "וע\"ד המבואר בתניא38"
        },
        {
          "s": 22,
          "text": "שקיום התורה ומצוותי' תלוי בזה שיזכור תמיד ענין מסירת נפשו לה' שע\"י זכירת ענין המס\"נ,"
        },
        {
          "s": 23,
          "text": "למעלה מהשתלשלות שבאדם,"
        },
        {
          "s": 24,
          "text": "נעשית הגדלה והוספה בקיום התומ\"צ,"
        },
        {
          "s": 25,
          "text": "השתלשלות שבאדם."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ובפרטיות יותר יש לומר,"
        },
        {
          "s": 1,
          "text": "שבכדי שתהי' המשכת הסובב וההגדלה בכח אד',"
        },
        {
          "s": 2,
          "text": "צריך לקשר העבודה שלמעלה מטעם ודעת עם בחינת קדמות השכל."
        },
        {
          "s": 3,
          "text": "וזהו שאמרו רז\"ל39"
        },
        {
          "s": 4,
          "text": "כל העונה אמן יהא שמי' רבא מברך בכל כחו קורעין לו גזר דינו של ע' שנה40,"
        },
        {
          "s": 5,
          "text": "דבכל כחו ישנם שני פירושים."
        },
        {
          "s": 6,
          "text": "פי' רש\"י41"
        },
        {
          "s": 7,
          "text": "בכל כחו בכל כח כוונתו,"
        },
        {
          "s": 8,
          "text": "ופירוש התוספות42"
        },
        {
          "s": 9,
          "text": "בקול רם."
        },
        {
          "s": 10,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 11,
          "text": "דע\"י אמירת אמן יהא שמי' רבא בכל כחו נעשה הגדלת כח אד'43."
        },
        {
          "s": 12,
          "text": "דשמי' רבא הוא שמו הגדול,"
        },
        {
          "s": 13,
          "text": "סובב שלמעלה מהשתלשלות,"
        },
        {
          "s": 14,
          "text": "שע\"י המשכת הסובב נעשה הגדלת כח אד' כנ\"ל."
        },
        {
          "s": 15,
          "text": "ולכן ע\"י אמירת אמן יהא שמי' רבא קורעין לו גזר דינו של ע' שנה,"
        },
        {
          "s": 16,
          "text": "דהגזר דין הוא מצד הפגם בשם אד',"
        },
        {
          "s": 17,
          "text": "וע\"י הגדלת כח אד' נתתקן הפגם,"
        },
        {
          "s": 18,
          "text": "ובכדי שתהי' ההמשכה דשמי' רבא בבחינת כח אד',"
        },
        {
          "s": 19,
          "text": "הוא ע\"י שני הענינים"
        },
        {
          "s": 20,
          "text": "(הפירושים)"
        },
        {
          "s": 21,
          "text": "דבכל כחו."
        },
        {
          "s": 22,
          "text": "דכל כוונתו היא הכוונה דרעותא דלבא שלמעלה מטעם ודעת,"
        },
        {
          "s": 23,
          "text": "למעלה מהשתלשלות שבאדם,"
        },
        {
          "s": 24,
          "text": "וקול רם הוא הדיבור שמעורר בחינת קדמות השכל,"
        },
        {
          "s": 25,
          "text": "השרש דהשתלשלות44."
        },
        {
          "s": 26,
          "text": "וע\"י שכל כוונתו היא לא רק במחשבה אלא באה בקול רם,"
        },
        {
          "s": 27,
          "text": "עי\"ז נעשית ההמשכה דשמי' רבא בכח אד'."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "והנה ידוע45"
        },
        {
          "s": 2,
          "text": "שעבודת האדם מגעת עד שרש הנבראים,"
        },
        {
          "s": 3,
          "text": "בחינת השתלשלות,"
        },
        {
          "s": 4,
          "text": "וזה שעל ידי העבודה נמשך גם מלמעלה מהשתלשלות,"
        },
        {
          "s": 5,
          "text": "הוא ע\"י נתינת כח מלמעלה שנמשך במתן תורה."
        },
        {
          "s": 6,
          "text": "וזהו כאשר דברת לאמר,"
        },
        {
          "s": 7,
          "text": "דזה שע\"י עבודת האדם"
        },
        {
          "s": 8,
          "text": "(לאמר)"
        },
        {
          "s": 9,
          "text": "נעשה הגדלת כח אד',"
        },
        {
          "s": 10,
          "text": "שההגדלה היא על ידי המשכת הסובב שלמעלה מהשתלשלות,"
        },
        {
          "s": 11,
          "text": "הוא כאשר דברת,"
        },
        {
          "s": 12,
          "text": "דכאשר דברת קאי"
        },
        {
          "s": 13,
          "text": "(גם)"
        },
        {
          "s": 14,
          "text": "על לאמר"
        },
        {
          "s": 15,
          "text": "(כנ\"ל בתחלת המאמר),"
        },
        {
          "s": 16,
          "text": "שע\"י דיבור הקב\"ה הי' לך לעזרני,"
        },
        {
          "s": 17,
          "text": "ניתן הכח"
        },
        {
          "s": 18,
          "text": "(למשה,"
        },
        {
          "s": 19,
          "text": "ועל ידו לכאו\"א מישראל)"
        },
        {
          "s": 20,
          "text": "שע\"י עבודתו יוכל לפעול הגדלת כח אד'."
        },
        {
          "s": 21,
          "text": "וע\"פ המובא לעיל שכח זה"
        },
        {
          "s": 22,
          "text": "(שע\"י עבודה יומשך גם האור שלמעלה מהשתלשלות)"
        },
        {
          "s": 23,
          "text": "נמשך במתן תורה,"
        },
        {
          "s": 24,
          "text": "יש לומר,"
        },
        {
          "s": 25,
          "text": "דכאשר דברת לאמר קאי"
        },
        {
          "s": 26,
          "text": "(גם)"
        },
        {
          "s": 27,
          "text": "על וידבר גו' לאמר46"
        },
        {
          "s": 28,
          "text": "שנאמר במתן תורה47,"
        },
        {
          "s": 29,
          "text": "שגם הפירוש דוידבר גו' לאמר הוא שוידבר אלקים הי' שישראל יאמרו את כל הדברים האלה"
        },
        {
          "s": 30,
          "text": "(שקאי גם על כל התורה כולה48)"
        },
        {
          "s": 31,
          "text": "באופן דלאמר,"
        },
        {
          "s": 32,
          "text": "לומר הדברים שהקב\"ה אומר49."
        },
        {
          "s": 33,
          "text": "היינו שע\"י שהאדם אומר דברי תורה,"
        },
        {
          "s": 34,
          "text": "הוא גורם שהקב\"ה יאמר דיבורים אלו,"
        },
        {
          "s": 35,
          "text": "המשכת אוא\"ס"
        },
        {
          "s": 36,
          "text": "(שלמעלה מהשתלשלות)"
        },
        {
          "s": 37,
          "text": "בתורה"
        },
        {
          "s": 38,
          "text": "(השתלשלות)."
        },
        {
          "s": 39,
          "text": "ועי\"ז נמשך הכח גם בכללות עבודת האדם,"
        },
        {
          "s": 40,
          "text": "שע\"י עבודתו"
        },
        {
          "s": 41,
          "text": "(באופן שהלמעלה מהשתלשלות שבאדם מאיר בהשתלשלות שבו)"
        },
        {
          "s": 42,
          "text": "ממשיך אור שלמעלה מהשתלשלות בהשתלשלות,"
        },
        {
          "s": 43,
          "text": "המשכת סובב בממלא."
        },
        {
          "s": 44,
          "text": "ועי\"ז נעשה המשכת הסובב גם למטה בעולם"
        },
        {
          "s": 45,
          "text": "(שהמשכת הסובב בעולם היא גם בהפנימיות שבו),"
        },
        {
          "s": 46,
          "text": "ועי\"ז נשלמת הכוונה דדירה50"
        },
        {
          "s": 47,
          "text": "לו ית' בתחתונים."
        }
      ]
    }
  ]
}