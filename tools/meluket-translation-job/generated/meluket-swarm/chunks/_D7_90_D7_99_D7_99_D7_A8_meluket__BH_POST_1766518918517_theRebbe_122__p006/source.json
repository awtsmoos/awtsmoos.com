{
  "globalIndex": 794,
  "owner": 44,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918517_theRebbe_122__p006",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918517_theRebbe_122__p006",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918517_theRebbe_122",
  "title": "מאמר שיר המעלות תשכ\"ב",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "דזה שאמירת התורה דרשב\"י היתה בפסוק הנה מה טוב ומה נעים שבת אחים גם יחד הוא מצד שני ענינים."
        },
        {
          "s": 3,
          "text": "לפי שזה שייך לירידת גשמים"
        },
        {
          "s": 4,
          "text": "(כנ\"ל סעיף ה),"
        },
        {
          "s": 5,
          "text": "וגם לפי שזה שפעל ירידת גשמים"
        },
        {
          "s": 6,
          "text": "(שענינם הוא אתערותא דלתתא,"
        },
        {
          "s": 7,
          "text": "עבודת האדם)"
        },
        {
          "s": 8,
          "text": "ע\"י אמירת תורה"
        },
        {
          "s": 9,
          "text": "(המשכה מלמעלה,"
        },
        {
          "s": 10,
          "text": "תורתו של הקב\"ה),"
        },
        {
          "s": 11,
          "text": "הוא לפי שישראל וקוב\"ה כולא חד,"
        },
        {
          "s": 12,
          "text": "ולכן אמירת התורה שלו היתה עה\"פ שבת אחים גם יחד שקאי על היחוד דקוב\"ה וישראל"
        },
        {
          "s": 13,
          "text": "(כמובא לעיל בתחלת המאמר)."
        },
        {
          "s": 14,
          "text": "ויש להוסיף,"
        },
        {
          "s": 15,
          "text": "דזהו גם מה שבדרוש שלו"
        },
        {
          "s": 16,
          "text": "(שעל ידו פעל ירידת גשמים)"
        },
        {
          "s": 17,
          "text": "מדובר בענין אהבת ישראל,"
        },
        {
          "s": 18,
          "text": "שגם אלה שבתחלה היו מגיחי קרבא דבעו לקטלא דא לדא,"
        },
        {
          "s": 19,
          "text": "לבתר אתהדרו ברחימותא דאחוה,"
        },
        {
          "s": 20,
          "text": "כי ע\"י האהבה והאחדות דישראל מתגלה האהבה והאחדות דישראל והקב\"ה."
        },
        {
          "s": 21,
          "text": "דע\"י שבת אחים"
        },
        {
          "s": 22,
          "text": "(האהבה והאחוה דישראל)"
        },
        {
          "s": 23,
          "text": "נמשך להיות גם יחד,"
        },
        {
          "s": 24,
          "text": "גם לאכללא עמהון שכינתא."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "וזהו כשמן הטוב גו',"
        },
        {
          "s": 2,
          "text": "שמן הוא חכמה,"
        },
        {
          "s": 3,
          "text": "תורה,"
        },
        {
          "s": 4,
          "text": "ושמן הטוב הוא פנימיות התורה42."
        },
        {
          "s": 5,
          "text": "ויש לקשר זה עם מ\"ש במפרשי הזהר43,"
        },
        {
          "s": 6,
          "text": "דשמן הטוב הוא הארת יסוד דעתיק,"
        },
        {
          "s": 7,
          "text": "כי גליא דתורה שייך לאריך ופנימיות התורה לעתיק."
        },
        {
          "s": 8,
          "text": "וזהו שבת אחים גם יחד כשמן הטוב גו',"
        },
        {
          "s": 9,
          "text": "שבכדי להיות שבת אחים הוא ע\"י לימוד פנימיות התורה."
        },
        {
          "s": 10,
          "text": "וממשיך בכתוב יורד על הזקן זקן אהרן שיורד על פי מדותיו,"
        },
        {
          "s": 11,
          "text": "שהם שתי ירידות."
        },
        {
          "s": 12,
          "text": "זקן הוא הבנת והשגת התורה,"
        },
        {
          "s": 13,
          "text": "זקן שקנה חכמה44,"
        },
        {
          "s": 14,
          "text": "ומדותיו הם לבושי המצוות45."
        },
        {
          "s": 15,
          "text": "שהלימוד דפנימיות התורה צריך לחדור"
        },
        {
          "s": 16,
          "text": "(דורכנעמען)"
        },
        {
          "s": 17,
          "text": "כל הכחות שלו,"
        },
        {
          "s": 18,
          "text": "הן ההבנה וההשגה והן המעשה בפועל."
        },
        {
          "s": 19,
          "text": "ועי\"ז נעשה שבת אחים גם יחד,"
        },
        {
          "s": 20,
          "text": "שהאהבת ישראל שלו היא באופן דשבת אחים"
        },
        {
          "s": 21,
          "text": "(התקשרות,"
        },
        {
          "s": 22,
          "text": "דוגמת קישורי תנאים)"
        },
        {
          "s": 23,
          "text": "ויתירה מזו באופן דגם יחד"
        },
        {
          "s": 24,
          "text": "(יחוד דנשואין),"
        },
        {
          "s": 25,
          "text": "ועי\"ז קוב\"ה אצית למילולייהו ונעשים כלים לקבל ההשפעה מאוא\"ס שאין בו הגבלות,"
        },
        {
          "s": 26,
          "text": "גם לא ההגבלה דחכמת התורה,"
        },
        {
          "s": 27,
          "text": "שהקב\"ה עצמו משפיע לכאו\"א מישראל רב טוב בטוב הנראה והנגלה,"
        },
        {
          "s": 28,
          "text": "בבני חיי ומזוני רויחא."
        }
      ]
    }
  ]
}