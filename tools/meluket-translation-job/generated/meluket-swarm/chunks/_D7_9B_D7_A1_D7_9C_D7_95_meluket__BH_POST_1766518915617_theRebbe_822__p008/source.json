{
  "globalIndex": 329,
  "owner": 29,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915617_theRebbe_822__p008",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915617_theRebbe_822__p008",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915617_theRebbe_822",
  "title": "מאמר ברוך שעשה ניסים תשט\"ו",
  "part": 8,
  "sections": [
    {
      "v": 21,
      "items": [
        {
          "s": 0,
          "text": "ולהוסיף,"
        },
        {
          "s": 1,
          "text": "שגם בנסים שלמעלה מהטבע,"
        },
        {
          "s": 2,
          "text": "שני סוגים."
        },
        {
          "s": 3,
          "text": "דהגם שהנסים אינם מלובשים בטבע,"
        },
        {
          "s": 4,
          "text": "מ\"מ יש מקום לטעות שהם טבע."
        },
        {
          "s": 5,
          "text": "וכמו ירידת המן במשך ארבעים שנה,"
        },
        {
          "s": 6,
          "text": "דהגם שהנס לא הי' מלובש בטבע"
        },
        {
          "s": 7,
          "text": "[וכמ\"ש הרמב\"ם35"
        },
        {
          "s": 8,
          "text": "ששהיית ישראל במדבר ארבעים שנה ומציאות המן שם הוא מהפלאים הגדולים,"
        },
        {
          "s": 9,
          "text": "כי טבע המדבר הוא לא מקום זרע גו'36,"
        },
        {
          "s": 10,
          "text": "ואי אפשר שיהי' בו לחם"
        },
        {
          "s": 11,
          "text": "(לא לחם מן הארץ וגם לא לחם מן השמים)."
        },
        {
          "s": 12,
          "text": "ומכש\"כ זה שלא הי' בו פסולת37,"
        },
        {
          "s": 13,
          "text": "ועאכו\"כ זה שהממעיט לא החסיר38,"
        },
        {
          "s": 14,
          "text": "שמצד טבע העולם אין מקום לזה],"
        },
        {
          "s": 15,
          "text": "מ\"מ,"
        },
        {
          "s": 16,
          "text": "ע\"י שהנס הי' ארבעים שנה הי' מקום לטעות שהוא טבע."
        },
        {
          "s": 17,
          "text": "ושהנס הוא בגילוי כ\"כ שאין נתינת מקום כלל לטעות שהוא טבע,"
        },
        {
          "s": 18,
          "text": "כהנס דקריעת ים סוף."
        }
      ]
    },
    {
      "v": 22,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 2,
          "text": "דבהחילוק שבין שני הסוגים"
        },
        {
          "s": 3,
          "text": "(נסים שלמעלה מהטבע ונסים המלובשים בטבע)"
        },
        {
          "s": 4,
          "text": "בשרשם,"
        },
        {
          "s": 5,
          "text": "שני ביאורים."
        },
        {
          "s": 6,
          "text": "דשרש הנסים שלמעלה מהטבע הוא משם הוי',"
        },
        {
          "s": 7,
          "text": "ושרש הנסים המלובשים בטבע הוא משם שדי39,"
        },
        {
          "s": 8,
          "text": "שדי באלקותי לכל ברי'40."
        },
        {
          "s": 9,
          "text": "[והחילוק דשני האופנים בנסים המלובשים בטבע גופא הוא,"
        },
        {
          "s": 10,
          "text": "דשם שדי הוא ביסוד,"
        },
        {
          "s": 11,
          "text": "שההמשכה שלו למטה היא ע\"י המלכות."
        },
        {
          "s": 12,
          "text": "ובזה שני אופנים."
        },
        {
          "s": 13,
          "text": "שהמשכתן ע\"י המלכות היא בדרך מעביר או שהיא בדרך התלבשות."
        },
        {
          "s": 14,
          "text": "והם השרש דשני האופנים שבנסים41]."
        },
        {
          "s": 15,
          "text": "דלפי ביאור זה,"
        },
        {
          "s": 16,
          "text": "החילוק שבין שני סוגי הנסים הוא"
        },
        {
          "s": 17,
          "text": "(גם)"
        },
        {
          "s": 18,
          "text": "בשרשם."
        },
        {
          "s": 19,
          "text": "ועוד ביאור,"
        },
        {
          "s": 20,
          "text": "דהנסים המלובשים בטבע הם מבחינת אני כמו שמלובש בהאין דמלכות42."
        },
        {
          "s": 21,
          "text": "(והוא ע\"ד המבואר במק\"א43"
        },
        {
          "s": 22,
          "text": "דשרש הנסים המלובשים בטבע הוא משם הוי' כמו שמלובש בשם אד')."
        }
      ]
    },
    {
      "v": 23,
      "items": [
        {
          "s": 0,
          "text": "וע\"פ המבואר לעיל"
        },
        {
          "s": 1,
          "text": "(בסעיף ח)"
        },
        {
          "s": 2,
          "text": "דריבוי סוגי הנסים הוא בלמעלה מהשתלשלות"
        },
        {
          "s": 3,
          "text": "(שבכדי שיומשכו בהשתלשלות יש ריבוי למעלה מהשתלשלות)"
        },
        {
          "s": 4,
          "text": "יש לומר,"
        },
        {
          "s": 5,
          "text": "שד' הסוגים דנסים שרשם הוא בד' האותיות דשם הוי'."
        },
        {
          "s": 6,
          "text": "דהנסים הנמשכים מהאותיות ו\"ה השייכים לעולמות"
        },
        {
          "s": 7,
          "text": "(ו\"ה נגלות44)"
        },
        {
          "s": 8,
          "text": "הם מתלבשים בטבע."
        },
        {
          "s": 9,
          "text": "וכמו שבאותיות ו\"ה,"
        },
        {
          "s": 10,
          "text": "הו' הוא קו אחד הנמשך מלמעלה למטה היינו שגם כשנמשך למטה הוא מחובר עם למעלה,"
        },
        {
          "s": 11,
          "text": "והה' הוא בציור דאורך ורוחב"
        },
        {
          "s": 12,
          "text": "(שניכר בו רק שטח המקבל),"
        },
        {
          "s": 13,
          "text": "עד\"ז הוא גם בהנסים הנמשכים מהאותיות ו\"ה,"
        },
        {
          "s": 14,
          "text": "דהנסים הנמשכים מהוא\"ו גם לאחרי שנמשכים ומתלבשים בלבושי הטבע ניכר בגילוי שהם נס,"
        },
        {
          "s": 15,
          "text": "והנסים הנמשכים מה' אחרונה לאחרי שנמשכים ומתלבשים בלבושי הטבע ניכר בגילוי רק הטבע שבהם מלובשים הנסים"
        },
        {
          "s": 16,
          "text": "(שטח המקבל)."
        },
        {
          "s": 17,
          "text": "והנסים הנמשכים מהאותיות י\"ה שהם למעלה משייכות לעולמות"
        },
        {
          "s": 18,
          "text": "(י\"ה נסתרות44),"
        },
        {
          "s": 19,
          "text": "הם למעלה מהתלבשות בטבע,"
        },
        {
          "s": 20,
          "text": "ובהם עצמם שני סוגים."
        },
        {
          "s": 21,
          "text": "דאות ה' שיש בה ציור דאורך ורוחב,"
        },
        {
          "s": 22,
          "text": "שעי\"ז שייך שיהי' בה תפיסא – לכן,"
        },
        {
          "s": 23,
          "text": "בדרגת הנסים הנמשכים ממנה יש נתינת מקום לטבע."
        },
        {
          "s": 24,
          "text": "דהגם שהנסים עצמם אינם מלובשים בטבע מ\"מ,"
        },
        {
          "s": 25,
          "text": "לגבי דרגא זו,"
        },
        {
          "s": 26,
          "text": "אין הטבע מושלל,"
        },
        {
          "s": 27,
          "text": "ולכן יש מקום לטעות שהם טבע."
        },
        {
          "s": 28,
          "text": "ולגבי דרגת הנסים הנמשכים מאות יו\"ד שהיא רק נקודה שאין בה תפיסא,"
        },
        {
          "s": 29,
          "text": "אין מקום לטבע,"
        },
        {
          "s": 30,
          "text": "ולכן בנסים אלו אין שייך לטעות שהם טבע."
        }
      ]
    }
  ]
}