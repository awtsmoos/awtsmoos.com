{
  "globalIndex": 443,
  "owner": 43,
  "jobId": "_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916295_theRebbe_70__p001",
  "batchId": "meluket-_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916295_theRebbe_70__p001",
  "seriesId": "טבת_meluket",
  "postId": "BH_POST_1766518916295_theRebbe_70",
  "title": "מאמר וידבר אלוקים אל משה תשל\"ב",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "כ\"ד טבת"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "וידבר אלקים אל משה ויאמר אליו אני הוי',"
        },
        {
          "s": 1,
          "text": "ומסיים לכן אמור לבני ישראל אני הוי'1."
        },
        {
          "s": 2,
          "text": "וידוע הדיוקים בזה מבעל ההילולא2,"
        },
        {
          "s": 3,
          "text": "מהו החידוש באני ה' שבזה מתחיל הדבור וכמו שמבאר וממשיך בכתוב"
        },
        {
          "s": 4,
          "text": "(החידוש באני הוי')"
        },
        {
          "s": 5,
          "text": "שהגם שוארא"
        },
        {
          "s": 6,
          "text": "(גם)"
        },
        {
          "s": 7,
          "text": "אל אברהם אל יצחק ואל יעקב הי' זה רק בא-ל שדי אבל שמי הוי' לא נודעתי להם."
        },
        {
          "s": 8,
          "text": "גם צריך להבין בכללות תוכן הענין דוארא אל אברהם גו' ושמי הוי' לא נודעתי להם,"
        },
        {
          "s": 9,
          "text": "שמצד אחד מורה זה על העילוי והחידוש שבמשה לגבי האבות,"
        },
        {
          "s": 10,
          "text": "שדוקא בימי משה נתגלה שמי הוי',"
        },
        {
          "s": 11,
          "text": "משא\"כ להאבות לא נתגלה הידיעה וההשגה בשמי הוי',"
        },
        {
          "s": 12,
          "text": "וביחד עם זה איתא במדרש3"
        },
        {
          "s": 13,
          "text": "על פסוק וענין זה"
        },
        {
          "s": 14,
          "text": "(הובא בפרש\"י עה\"ת4)"
        },
        {
          "s": 15,
          "text": "שאמר הקב\"ה חבל על דאבדין ולא משתכחין שוארא אל אברהם אל יצחק ואל יעקב כו' ולא הרהרו אחר מדותי ואתה אמרת כו',"
        },
        {
          "s": 16,
          "text": "שלכאורה הרי זה שני ענינים הפכיים."
        },
        {
          "s": 17,
          "text": "ועד\"ז צריך להבין במשארז\"ל5"
        },
        {
          "s": 18,
          "text": "(הובא בד\"ה החודש הזה לכם,"
        },
        {
          "s": 19,
          "text": "ה'ש\"ת6)"
        },
        {
          "s": 20,
          "text": "בנוגע למשה כל השביעין חביבין,"
        },
        {
          "s": 21,
          "text": "דיש בזה דבר והיפוכו,"
        },
        {
          "s": 22,
          "text": "דכשאומר שהשביעין חביבין הרי זה חביבות יותר מכל אלו שקדמו לו,"
        },
        {
          "s": 23,
          "text": "וביחד עם זה,"
        },
        {
          "s": 24,
          "text": "הרי מזה שאומרים שחביבותו של משה הוא להיותו שביעי,"
        },
        {
          "s": 25,
          "text": "הרי מובן מזה"
        },
        {
          "s": 26,
          "text": "(וכמבואר בד\"ה הנ\"ל)"
        },
        {
          "s": 27,
          "text": "שחביבותו הוא מצד זה שהוא שביעי לראשון."
        },
        {
          "s": 28,
          "text": "ובפרט לפי דברי המדרש7,"
        },
        {
          "s": 29,
          "text": "המובא בהמאמר"
        },
        {
          "s": 30,
          "text": "(שם),"
        },
        {
          "s": 31,
          "text": "דבשעה שביקש משה ענין ששייך לגדולים אמר לו הקב\"ה במקום גדולים אל תעמוד,"
        },
        {
          "s": 32,
          "text": "שובמקום גדולים קאי על אברהם."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ויובן בהקדים,"
        },
        {
          "s": 1,
          "text": "דהנה ידוע המאמר של בעל ההילולא,"
        },
        {
          "s": 2,
          "text": "בתו\"א פ' שמות8,"
        },
        {
          "s": 3,
          "text": "וגם באחד הביכלאַך שיצאו לאחרונה לחירות מן השבי'9"
        },
        {
          "s": 4,
          "text": "ד\"ה להבין הביאור במרז\"ל עה\"פ10"
        },
        {
          "s": 5,
          "text": "ששים המה מלכות ושמונים פלגשים ועלמות אין מספר אחת היא יונתי תמתי אחת היא לאמה ברה היא ליולדתה,"
        },
        {
          "s": 6,
          "text": "ששים המה מלכות אלו ששים מסכתות ושמונים פלגשים אלו הברייתות ועלמות אין מספר אלו ההלכות,"
        },
        {
          "s": 7,
          "text": "שהן מימרות האמוראים,"
        },
        {
          "s": 8,
          "text": "ומסיים שכ\"ז אינו בדומה לאחת היא יונתי."
        },
        {
          "s": 9,
          "text": "ולהבין זה,"
        },
        {
          "s": 10,
          "text": "וגם להבין מרז\"ל11"
        },
        {
          "s": 11,
          "text": "גדול תלמוד שמביא לידי מעשה,"
        },
        {
          "s": 12,
          "text": "דלכאורה הלא מצינו כמה הלכות שאין להם שייכות למעשה,"
        },
        {
          "s": 13,
          "text": "ובפרט ע\"פ המבואר בקו\"א12"
        },
        {
          "s": 14,
          "text": "שישנם ענינים שלא היו כו' ולא יהיו ואעפ\"כ ישנן הלכות ושקו\"ט בענינים אלו."
        },
        {
          "s": 15,
          "text": "ומבאר שם בהקדם הידוע שתכלית הבריאה היא לעשות לו ית' דירה בתחתונים13,"
        },
        {
          "s": 16,
          "text": "שהדירה בתחתונים נעשה ע\"י ששים מלכות ושמונים פלגשים ועלמות אין מספר,"
        },
        {
          "s": 17,
          "text": "ובכללות ע\"י התורה,"
        },
        {
          "s": 18,
          "text": "שע\"י עסק התורה טהור,"
        },
        {
          "s": 19,
          "text": "כשר ומותר,"
        },
        {
          "s": 20,
          "text": "עי\"ז מתברר הדבר ההוא,"
        },
        {
          "s": 21,
          "text": "וע\"י עבודת ישראל אח\"כ מזדכך ומתעלה הדבר ועד שנעשה דירה לו ית' בתחתונים."
        },
        {
          "s": 22,
          "text": "והנה כמו שבדירה צ\"ל כלים נאים,"
        },
        {
          "s": 23,
          "text": "עשה טוב,"
        },
        {
          "s": 24,
          "text": "כן גם צריך להסיר הענינים הבלתי רצויים שזהו\"ע סור מרע,"
        },
        {
          "s": 25,
          "text": "וזהו התורה כמו שהיא בקו הגבורה,"
        },
        {
          "s": 26,
          "text": "שהפס\"ד הוא להיפך מטהור כשר ומותר,"
        },
        {
          "s": 27,
          "text": "והיינו לפי שאי\"ז ראוי להיות כלי לאלקות – דירה לו ית' בתחתונים."
        },
        {
          "s": 28,
          "text": "וזה\"ע ששים המה מלכות,"
        },
        {
          "s": 29,
          "text": "ששים מסכתות,"
        },
        {
          "s": 30,
          "text": "שדוקא בתושבע\"פ הוא בירור רצה\"ע לידע הענינים דסור מרע ועשה טוב."
        },
        {
          "s": 31,
          "text": "וכללות תושבע\"פ מתחלקת בששה,"
        },
        {
          "s": 32,
          "text": "שהם הששה סדרי משנה,"
        },
        {
          "s": 33,
          "text": "וכל א' כלול מעשרה שמזה נעשה ששים המה מלכות."
        },
        {
          "s": 34,
          "text": "ומה שנק' בשם מלכות הוא כי במשנה אלקות הוא בגילוי כמו במלכה שהמלך הולך אלי' בגלוי ובאופן של קביעות."
        },
        {
          "s": 35,
          "text": "וי\"ל שזוהי שייכות ענין המשנה לבית,"
        },
        {
          "s": 36,
          "text": "להזמן שביהמ\"ק הי' קיים,"
        },
        {
          "s": 37,
          "text": "דהגם שסדור המשנה וסיומה הי' ע\"י רבינו הקדוש"
        },
        {
          "s": 38,
          "text": "(שהי' אחר זמן הבית),"
        },
        {
          "s": 39,
          "text": "הרי אמרז\"ל14"
        },
        {
          "s": 40,
          "text": "ותותר בימי רבי,"
        },
        {
          "s": 41,
          "text": "שימי רבי ה\"ה ההמשך להזמן שביהמ\"ק הי' קיים."
        },
        {
          "s": 42,
          "text": "ושמונים פלגשים אלו ברייתות,"
        },
        {
          "s": 43,
          "text": "שברייתא הוא מל' בר וחוץ,"
        },
        {
          "s": 44,
          "text": "דלפי שבזמן ההוא הי' ענין הגלות,"
        },
        {
          "s": 45,
          "text": "גלינו מארצנו,"
        },
        {
          "s": 46,
          "text": "שהו\"ע בר וחוץ,"
        },
        {
          "s": 47,
          "text": "הנה גם גילוי הרצון וגילוי אלקות שהי' בתורה בזמן ההוא לא הי' בבירור כ\"כ שלכן נק' בשם פלגש."
        },
        {
          "s": 48,
          "text": "ואח\"כ נמשך למטה יותר ועלמות אין מספר אלו ההלכות שהן מימרות האמוראים,"
        },
        {
          "s": 49,
          "text": "ובזה נכלל כל מה שתלמיד ותיק עתיד לחדש,"
        },
        {
          "s": 50,
          "text": "ובפרט תלמוד בבלי שעליו נאמר במחשכים הושיבני15"
        },
        {
          "s": 51,
          "text": "שהיא התורה שבזמן הגלות דוקא,"
        },
        {
          "s": 52,
          "text": "ועד לגלות אחרון."
        },
        {
          "s": 53,
          "text": "ונק' עלמות מלשון העלם והסתר,"
        },
        {
          "s": 54,
          "text": "שההעלם וההסתר שבהם הוא יותר מכמו שהוא בברייתות."
        },
        {
          "s": 55,
          "text": "אבל מ\"מ דוקא בהם ישנו ענין האין מספר,"
        },
        {
          "s": 56,
          "text": "שע\"י נעשה תכלית הבירור ועד לאופן דאין מספר."
        },
        {
          "s": 57,
          "text": "וזה הוא הקדמה להזמן דוהי' מספר בני ישראל אשר לא יספר16."
        }
      ]
    }
  ]
}