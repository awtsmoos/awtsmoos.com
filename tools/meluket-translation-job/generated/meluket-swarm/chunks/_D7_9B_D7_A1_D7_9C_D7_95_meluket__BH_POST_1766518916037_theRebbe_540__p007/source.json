{
  "globalIndex": 400,
  "owner": 0,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518916037_theRebbe_540__p007",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518916037_theRebbe_540__p007",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518916037_theRebbe_540",
  "title": "מאמר וישב יעקב תשכ\"ז",
  "part": 7,
  "sections": [
    {
      "v": 18,
      "items": [
        {
          "s": 0,
          "text": "והנה מה שנקראים בשם ישובי עשו,"
        },
        {
          "s": 1,
          "text": "אף שענין ההתיישבות היא בתיקון דוקא,"
        },
        {
          "s": 2,
          "text": "כי גם בתהו ישנם בחי' הכלים,"
        },
        {
          "s": 3,
          "text": "ובחי' הכלים הו\"ע ההתיישבות,"
        },
        {
          "s": 4,
          "text": "אלא שישובי עשו הם בדרך קצרה,"
        },
        {
          "s": 5,
          "text": "היינו,"
        },
        {
          "s": 6,
          "text": "שענין ההתיישבות שבתהו היא בבחי' קיצור ומיעוט,"
        },
        {
          "s": 7,
          "text": "כי בתהו היו אורות מרובים וכלים מועטים,"
        },
        {
          "s": 8,
          "text": "שהכלים לא היו לפי ערך האורות כלל,"
        },
        {
          "s": 9,
          "text": "כי לא הי' מזיגה נכונה בין האורות והכלים89"
        },
        {
          "s": 10,
          "text": "(נוסף לכך שגם הכלים מצד עצמם הם מועטים,"
        },
        {
          "s": 11,
          "text": "היינו,"
        },
        {
          "s": 12,
          "text": "שענין הכלי בהם הוא במיעוט),"
        },
        {
          "s": 13,
          "text": "שזו היתה הסיבה לשבירת הכלים,"
        },
        {
          "s": 14,
          "text": "שהאורות נסתלקו למעלה והכלים נשברו ונפלו למטה."
        },
        {
          "s": 15,
          "text": "וזהו מה שנתחדש בענין התיקון,"
        },
        {
          "s": 16,
          "text": "שנעשה מזיגה נכונה בין האורות והכלים,"
        },
        {
          "s": 17,
          "text": "אורות מועטים וכלים מרובים,"
        },
        {
          "s": 18,
          "text": "שמצד זה הנה בתיקון ההתיישבות היא בריבוי,"
        },
        {
          "s": 19,
          "text": "ישובי יעקב בדרך ארוכה."
        }
      ]
    },
    {
      "v": 19,
      "items": [
        {
          "s": 0,
          "text": "והנה אף שבחי' התהו מצד עצמה אינה כפי הכוונה,"
        },
        {
          "s": 1,
          "text": "וכמאמר90"
        },
        {
          "s": 2,
          "text": "דין לא הניין לי',"
        },
        {
          "s": 3,
          "text": "שזהו שישובי עשו ותולדותיו לא היו ספונים וחשובים,"
        },
        {
          "s": 4,
          "text": "מ\"מ,"
        },
        {
          "s": 5,
          "text": "הם הקדמה לענין וישב יעקב גו' בארץ כנען,"
        },
        {
          "s": 6,
          "text": "שהרי כל ענין המסחר של ירידת הנשמה למטה הוא מצד שבה\"כ דתהו,"
        },
        {
          "s": 7,
          "text": "כנ\"ל."
        },
        {
          "s": 8,
          "text": "וזהו שאחר שכתב לך ישובי עשו בדרך קצרה כתיב וישב יעקב בארץ מגורי אביו בארץ כנען,"
        },
        {
          "s": 9,
          "text": "כי ירידת הנשמה למטה היא בכדי לברר את הניצוצות דתהו כנ\"ל,"
        },
        {
          "s": 10,
          "text": "וזהו\"ע וישב יעקב בארץ מגורי אביו,"
        },
        {
          "s": 11,
          "text": "שמגורי הוא לשון אוצר91,"
        },
        {
          "s": 12,
          "text": "וכמו אוגר בקיץ92,"
        },
        {
          "s": 13,
          "text": "והו\"ע אסיפת ובירור הניצוצות דתהו שנתפזרו ע\"י שבה\"כ."
        },
        {
          "s": 14,
          "text": "דהנה ידוע93"
        },
        {
          "s": 15,
          "text": "שענין שבה\"כ הוא שהכלים נפרדו מחיבורם,"
        },
        {
          "s": 16,
          "text": "וכהמשל בזה מענין האותיות,"
        },
        {
          "s": 17,
          "text": "שכאשר הם מחוברים בתיבה אחת,"
        },
        {
          "s": 18,
          "text": "אזי נושאים הם בתוכם פירוש התיבה."
        },
        {
          "s": 19,
          "text": "וכמו בהאותיות ב'ר'ו'ך',"
        },
        {
          "s": 20,
          "text": "שבהיותם מחוברים יחד בהצירוף דברוך נושאים הם ההשכלה שבתיבת ברוך,"
        },
        {
          "s": 21,
          "text": "וכאשר הם מתפזרים זה מזה,"
        },
        {
          "s": 22,
          "text": "אזי נשאר בכל אות רק רושם מההשכלה."
        },
        {
          "s": 23,
          "text": "וכמו\"כ הוא ענין שבה\"כ דתהו,"
        },
        {
          "s": 24,
          "text": "שהכלים נפרדו מחיבורם כו'."
        },
        {
          "s": 25,
          "text": "וזהו\"ע מגורי אביו,"
        },
        {
          "s": 26,
          "text": "שהנשמה בירידתה למטה אוספת ומבררת את הניצוצות דתהו שנתפזרו כו'."
        },
        {
          "s": 27,
          "text": "והנה,"
        },
        {
          "s": 28,
          "text": "יש עוד פירוש במגורי אביו,"
        },
        {
          "s": 29,
          "text": "שמגורי הוא מלשון יראה,"
        },
        {
          "s": 30,
          "text": "וכמו שפירש הרב המגיד94"
        },
        {
          "s": 31,
          "text": "(שיום הילולא שלו בי\"ט כסלו,"
        },
        {
          "s": 32,
          "text": "וגם ענין גאולת רבינו הזקן בי\"ט כסלו שייכת לענין ההילולא של הרב המגיד95)"
        },
        {
          "s": 33,
          "text": "שמגורי אביו הו\"ע היראה מאבינו שבשמים."
        },
        {
          "s": 34,
          "text": "ויש לבאר שייכות ב' הפירושים,"
        },
        {
          "s": 35,
          "text": "ע\"פ משנת\"ל"
        },
        {
          "s": 36,
          "text": "(ס\"ח ואילך)"
        },
        {
          "s": 37,
          "text": "שעיקר הבירור שבתיקון הוא ע\"י בחי' הדעת האלקי,"
        },
        {
          "s": 38,
          "text": "שהיא ההכרה עצמית שלמעלה מהשכל,"
        },
        {
          "s": 39,
          "text": "שזהו\"ע תכלית הידיעה שלא נדע."
        },
        {
          "s": 40,
          "text": "וזהו\"ע מגורי אביו מלשון יראה"
        },
        {
          "s": 41,
          "text": "(כפירוש הב'),"
        },
        {
          "s": 42,
          "text": "בחי' יראת בושת,"
        },
        {
          "s": 43,
          "text": "שבאה מצד ההכרה ברוממות הא\"ס שלמעלה מהשגה96,"
        },
        {
          "s": 44,
          "text": "בחי' תכלית הידיעה שלא נדע."
        },
        {
          "s": 45,
          "text": "ומצד הכרה זו נעשית הבחירה בטוב"
        },
        {
          "s": 46,
          "text": "(כנ\"ל),"
        },
        {
          "s": 47,
          "text": "שעי\"ז הוא עיקר אסיפת ובירור הניצוצות"
        },
        {
          "s": 48,
          "text": "(פירוש הא' דמגורי)."
        },
        {
          "s": 49,
          "text": "וזהו ג\"כ מה שארץ ישראל נקראת כאן בשם ארץ כנען,"
        },
        {
          "s": 50,
          "text": "דענין כנען הוא כמ\"ש כנען בידו מאזני מרמה,"
        },
        {
          "s": 51,
          "text": "שמצד המרמה נעשה תערובות טו\"ר,"
        },
        {
          "s": 52,
          "text": "וכנ\"ל"
        },
        {
          "s": 53,
          "text": "(ס\"ו)"
        },
        {
          "s": 54,
          "text": "שמצד ענין הערמומית נעשה תערובות טו\"ר,"
        },
        {
          "s": 55,
          "text": "והו\"ע חיצוניות הדעת,"
        },
        {
          "s": 56,
          "text": "שזוהי הסיבה לשבה\"כ דתהו."
        },
        {
          "s": 57,
          "text": "אך התכלית של ירידה זו היא לעשות מארץ כנען ארץ ישראל,"
        },
        {
          "s": 58,
          "text": "שזוהי העלי' הנעשית ע\"י הירידה,"
        },
        {
          "s": 59,
          "text": "וכפי' השני שבכנען לשון סוחר,"
        },
        {
          "s": 60,
          "text": "שהו\"ע הריוח שע\"י הפיזור."
        }
      ]
    },
    {
      "v": 20,
      "items": [
        {
          "s": 0,
          "text": "וזהו גם ענין המאסר והגאולה די\"ט כסלו,"
        },
        {
          "s": 1,
          "text": "שבעת המאסר היתה הירידה בתכלית,"
        },
        {
          "s": 2,
          "text": "וכידוע97"
        },
        {
          "s": 3,
          "text": "שרבינו הזקן סבל אז יסורי הגוף ויסורי הנפש כו'."
        },
        {
          "s": 4,
          "text": "אך תכלית ירידה הלזו היא בשביל העלי',"
        },
        {
          "s": 5,
          "text": "שזהו שבעת הגאולה ראו כל אפסי ארץ כו'98,"
        },
        {
          "s": 6,
          "text": "והו\"ע גילוי אלקות בהאותות ומופתים שע\"י הצדיקים,"
        },
        {
          "s": 7,
          "text": "ואז הותחל עיקר הענין דיפוצו99"
        },
        {
          "s": 8,
          "text": "מעינותיך חוצה100,"
        },
        {
          "s": 9,
          "text": "והרי ע\"י הפצת המעינות דפנימיות התורה יהי' קאתי מר99,"
        },
        {
          "s": 10,
          "text": "שאז יהי' גילוי פנימיות הדעת,"
        },
        {
          "s": 11,
          "text": "כמ\"ש101"
        },
        {
          "s": 12,
          "text": "כי מלאה הארץ דעה את הוי' וגו',"
        },
        {
          "s": 13,
          "text": "בקרוב ממש."
        }
      ]
    }
  ]
}