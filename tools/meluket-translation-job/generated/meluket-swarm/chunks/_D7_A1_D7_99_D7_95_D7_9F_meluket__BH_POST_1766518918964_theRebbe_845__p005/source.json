{
  "globalIndex": 881,
  "owner": 31,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918964_theRebbe_845__p005",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918964_theRebbe_845__p005",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918964_theRebbe_845",
  "title": "מאמר והנה פרח מטה אהרן תשל\"ג",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "דהגם שברכת כהנים היתה לפני שפרח מטה אהרן ויגמול שקדים,"
        },
        {
          "s": 3,
          "text": "כמ\"ש35"
        },
        {
          "s": 4,
          "text": "וישא אהרן את ידיו אל העם ויברכם ופרש\"י ויברכם ברכת כהנים"
        },
        {
          "s": 5,
          "text": "[וגם אז היתה ההמשכה דברכת כהנים במהירות],"
        },
        {
          "s": 6,
          "text": "מ\"מ,"
        },
        {
          "s": 7,
          "text": "לאחרי שפרח מטה אהרן ניתוסף עילוי בזה."
        },
        {
          "s": 8,
          "text": "כי כיון שהענין דפרח מטה אהרן גו' ויגמול שקדים בא ע\"י הערעור על הכהונה,"
        },
        {
          "s": 9,
          "text": "הרי זה36"
        },
        {
          "s": 10,
          "text": "דוגמת שטר שיצא עליו ערעור והוחזק בבי\"ד,"
        },
        {
          "s": 11,
          "text": "שיש לו תוקף יותר משטר שלא הי' עליו ערעור37."
        },
        {
          "s": 12,
          "text": "וכיתרון האור מן החושך38."
        },
        {
          "s": 13,
          "text": "ועפ\"ז יש לבאר מ\"ש בלקו\"ת בסיום המאמר39"
        },
        {
          "s": 14,
          "text": "שיש שקידה למוטב ולטוב,"
        },
        {
          "s": 15,
          "text": "ושקדים דמטה אהרן הם שקדים טובים,"
        },
        {
          "s": 16,
          "text": "דיש לומר,"
        },
        {
          "s": 17,
          "text": "דזה שמביא בהמאמר שיש שקידה למוטב הוא לרמז שבהשקדים טובים דמטה אהרן יש גם מעלת האתהפכא דמוטב לטוב."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ויש להוסיף,"
        },
        {
          "s": 1,
          "text": "דזה שהקיום דכהונת אהרן לאחרי הערעור הי' ע\"י ויגמול שקדים,"
        },
        {
          "s": 2,
          "text": "שענינם של שקדים הוא מהירות"
        },
        {
          "s": 3,
          "text": "(כנ\"ל סעיף א),"
        },
        {
          "s": 4,
          "text": "הוא לפי שמעלת האתהפכא דמוטב לטוב שייכת גם לענין המהירות."
        },
        {
          "s": 5,
          "text": "וי\"ל הביאור בזה,"
        },
        {
          "s": 6,
          "text": "כי ענין המהירות הוא שגם כשההשפעה נמשכת למטה מטה היא בריבוי גדול"
        },
        {
          "s": 7,
          "text": "(כנ\"ל סעיף ח)."
        },
        {
          "s": 8,
          "text": "ובכדי שגם למטה תהי' ריבוי השפעה,"
        },
        {
          "s": 9,
          "text": "צריך להיות המטה כלי לזה."
        },
        {
          "s": 10,
          "text": "ויש לומר,"
        },
        {
          "s": 11,
          "text": "שמהטעמים על זה שהסיום והחותם דברכת כהנים הוא וישם לך שלום40,"
        },
        {
          "s": 12,
          "text": "הוא,"
        },
        {
          "s": 13,
          "text": "כי הכלי לריבוי ברכה,"
        },
        {
          "s": 14,
          "text": "ועד לריבוי בלתי מוגבל"
        },
        {
          "s": 15,
          "text": "[דריבוי ההשפעה דברכת כהנים הוא"
        },
        {
          "s": 16,
          "text": "(בשרשו)"
        },
        {
          "s": 17,
          "text": "ריבוי בלתי מוגבל,"
        },
        {
          "s": 18,
          "text": "וכנ\"ל ששורש ההשפעה דברכת כהנים הוא למעלה מהשתלשלות],"
        },
        {
          "s": 19,
          "text": "הוא השלום,"
        },
        {
          "s": 20,
          "text": "דלא מצא הקב\"ה כלי מחזיק ברכה לישראל אלא השלום41."
        },
        {
          "s": 21,
          "text": "ועפ\"ז יש לבאר השייכות דמעלת האתהפכא לענין המהירות דשקדים,"
        },
        {
          "s": 22,
          "text": "כי אמיתית ענין המהירות הוא,"
        },
        {
          "s": 23,
          "text": "דזה שגם למטה ההשפעה היא בריבוי הוא לא רק מפני שההמשכה שמלמעלה אינה מתעכבת אלא גם שהמטה הוא כלי לזה ע\"י השלום שבו,"
        },
        {
          "s": 24,
          "text": "ואמיתית ענין השלום הוא כשגם המוטב נהפך לטוב."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ותכלית השלימות דשלום זה"
        },
        {
          "s": 1,
          "text": "(שגם האויב נהפך לאוהב)"
        },
        {
          "s": 2,
          "text": "יהי' בביאת משיח צדקנו בקרוב ממש,"
        },
        {
          "s": 3,
          "text": "שאז יהי' שלום בריבוי וברכה בריבוי42,"
        },
        {
          "s": 4,
          "text": "ריבוי בלתי מוגבל,"
        },
        {
          "s": 5,
          "text": "כמ\"ש43"
        },
        {
          "s": 6,
          "text": "פרזות תשב ירושלים,"
        },
        {
          "s": 7,
          "text": "בלי מדידות והגבלות."
        }
      ]
    }
  ]
}