{
  "globalIndex": 368,
  "owner": 18,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915857_theRebbe_394__p003",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915857_theRebbe_394__p003",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915857_theRebbe_394",
  "title": "מאמר ת\"ר מצות נר חנוכה תשל\"ח",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה בכדי לנצח מלחמה זו,"
        },
        {
          "s": 2,
          "text": "אין מספיקה העבודה שע\"פ טעם ודעת,"
        },
        {
          "s": 3,
          "text": "ואפילו לא העבודה שלמעלה מטעם ודעת הקשורה עם טו\"ד"
        },
        {
          "s": 4,
          "text": "(העבודה שמצד בחי' מקיף דחי'46,"
        },
        {
          "s": 5,
          "text": "מקיף הקרוב),"
        },
        {
          "s": 6,
          "text": "מכיון שטימאו גם את כל השמנים שבהיכל,"
        },
        {
          "s": 7,
          "text": "היינו גם הענינים דקדושה שלמעלה מטו\"ד אלה הקשורים עם טו\"ד."
        },
        {
          "s": 8,
          "text": "ונצחון המלחמה הוא ע\"י העבודה דמס\"נ דוקא,"
        },
        {
          "s": 9,
          "text": "דענין המס\"נ היא העמידה בתוקף נגד כל המונעים ומעכבים,"
        },
        {
          "s": 10,
          "text": "תוקף עצמי שלמעלה מהשכל לגמרי,"
        },
        {
          "s": 11,
          "text": "וכמו המס\"נ על קדה\"ש שאינה מצד איזו סברא שכלית,"
        },
        {
          "s": 12,
          "text": "כי אם,"
        },
        {
          "s": 13,
          "text": "שאי אפשר כלל להיות באופן אחר47."
        },
        {
          "s": 14,
          "text": "וזה בא מצד ההתקשרות דעצם הנשמה,"
        },
        {
          "s": 15,
          "text": "בחינת יחידה,"
        },
        {
          "s": 16,
          "text": "דענין התקשרות עצמית הוא שא\"א כלל להיות באופן אחר ח\"ו48."
        },
        {
          "s": 17,
          "text": "ומכיון שבבחינת היחידה אין שייך שום פגם וטומאה ח\"ו"
        },
        {
          "s": 18,
          "text": "(בדוגמת הפך אחד של שמן שהי' חתום בחותמו של כהן גדול,"
        },
        {
          "s": 19,
          "text": "שאין החיצונים יכולים ליגע שם49),"
        },
        {
          "s": 20,
          "text": "הנה ע\"י העבודה דמס\"נ שמצד היחידה,"
        },
        {
          "s": 21,
          "text": "עי\"ז דוקא מנצחים את המלחמה."
        },
        {
          "s": 22,
          "text": "וכמו שהי' במלחמת היונים כפשוטה,"
        },
        {
          "s": 23,
          "text": "דע\"י המס\"נ של מתתיהו ובניו,"
        },
        {
          "s": 24,
          "text": "דאף שהיו חלשים ומעטים מ\"מ עמדו במס\"נ להלחם נגד גבורים ורבים,"
        },
        {
          "s": 25,
          "text": "ועי\"ז עוררו ופעלו גם באנשי דורם למסור נפשם על קדה\"ש שלא לעבור על הדת בשום אופן,"
        },
        {
          "s": 26,
          "text": "הנה עי\"ז נצחו את המלחמה50."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "והנה נצחון המלחמה שנעשה ע\"י העבודה דמס\"נ הוא נצחון בשלימות."
        },
        {
          "s": 2,
          "text": "דנוסף על זה שהעבודה דמס\"נ,"
        },
        {
          "s": 3,
          "text": "להיותה באה מצד העצם,"
        },
        {
          "s": 4,
          "text": "היא חודרת בכל כחות הנפש עד לכח המעשה,"
        },
        {
          "s": 5,
          "text": "שבכל עניניו ניכר אַז דאָס טוט אַ מס\"נ-איד,"
        },
        {
          "s": 6,
          "text": "וע\"ד מ\"ש באברהם51"
        },
        {
          "s": 7,
          "text": "עקב אשר שמע אברהם בקולי,"
        },
        {
          "s": 8,
          "text": "שע\"י המס\"נ שלו פעל דגם העקב שלו שמע"
        },
        {
          "s": 9,
          "text": "(האָט דערהערט)"
        },
        {
          "s": 10,
          "text": "ציווי הקב\"ה52,"
        },
        {
          "s": 11,
          "text": "הנה עוד זאת,"
        },
        {
          "s": 12,
          "text": "שלגבי בחינת יחידה אין שייך שום מנגד."
        },
        {
          "s": 13,
          "text": "דבעבודה ע\"פ טו\"ד,"
        },
        {
          "s": 14,
          "text": "ואפילו בעבודה שלמעלה מטו\"ד הקשורה עם טו\"ד,"
        },
        {
          "s": 15,
          "text": "שייך שיהי' מנגד."
        },
        {
          "s": 16,
          "text": "משא\"כ כשמעורר ומגלה בחינת היחידה שלו,"
        },
        {
          "s": 17,
          "text": "אין שייך שיהי' מנגד53."
        },
        {
          "s": 18,
          "text": "ולא עוד,"
        },
        {
          "s": 19,
          "text": "אלא שבהתגלות בחינת יחידה שבנפש,"
        },
        {
          "s": 20,
          "text": "הרי זה פועל גם על נה\"ב,"
        },
        {
          "s": 21,
          "text": "שעצם החומריות דנה\"ב מתהפך מן הקצה אל הקצה54."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ובזה יובן מה שנרות חנוכה חלוקים מנרות המקדש הן במספרם והן בזמן הדלקתם,"
        },
        {
          "s": 1,
          "text": "כי ענין חנוכה הוא העבודה דמס\"נ שמצד בחינת יחידה,"
        },
        {
          "s": 2,
          "text": "למעלה מהשתלשלות"
        },
        {
          "s": 3,
          "text": "(שבאדם),"
        },
        {
          "s": 4,
          "text": "ולכן הם ח' נרות,"
        },
        {
          "s": 5,
          "text": "דמספר ח' קשור"
        },
        {
          "s": 6,
          "text": "(כנ\"ל ס\"א)"
        },
        {
          "s": 7,
          "text": "עם בחינה שלמעלה מהשתלשלות."
        },
        {
          "s": 8,
          "text": "ובדוגמת החילוק בין כנור דבית המקדש שהי' של שבעת נימין,"
        },
        {
          "s": 9,
          "text": "וכנור של ימות המשיח שיהי' של שמונה נימין55."
        },
        {
          "s": 10,
          "text": "דאף שבית המקדש הוא מקום הכי מקודש שבעולם,"
        },
        {
          "s": 11,
          "text": "ובפרט כנור של בית המקדש שהו\"ע המשכת שם הוי',"
        },
        {
          "s": 12,
          "text": "דכנור אותיות כ\"ו"
        },
        {
          "s": 13,
          "text": "(גימטריא דשם הוי')"
        },
        {
          "s": 14,
          "text": "נר56"
        },
        {
          "s": 15,
          "text": "(נר57"
        },
        {
          "s": 16,
          "text": "הוי' נשמת אדם)58,"
        },
        {
          "s": 17,
          "text": "מ\"מ הוא רק שלימות דסדר ההשתלשלות,"
        },
        {
          "s": 18,
          "text": "ולכן הי' של שבעת נימין."
        },
        {
          "s": 19,
          "text": "משא\"כ בימות המשיח שיהי' גילוי שלמעלה מסדר ההשתלשלות"
        },
        {
          "s": 20,
          "text": "(שם הוי' דלעילא),"
        },
        {
          "s": 21,
          "text": "יהי' של שמונה נימין59."
        }
      ]
    }
  ]
}