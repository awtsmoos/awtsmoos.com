{
  "globalIndex": 454,
  "owner": 4,
  "jobId": "_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916353_theRebbe_917__p002",
  "batchId": "meluket-_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916353_theRebbe_917__p002",
  "seriesId": "טבת_meluket",
  "postId": "BH_POST_1766518916353_theRebbe_917",
  "title": "מאמר ואלה שמות תשל\"ז",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והענין הוא10,"
        },
        {
          "s": 2,
          "text": "דהנה כתיב11,"
        },
        {
          "s": 3,
          "text": "ירוד ירדנו,"
        },
        {
          "s": 4,
          "text": "שישנם ב' ירידות,"
        },
        {
          "s": 5,
          "text": "וכן בענין הגאולה נאמר ואנכי אעלך גם עלה,"
        },
        {
          "s": 6,
          "text": "ב' עליות,"
        },
        {
          "s": 7,
          "text": "ובכללות ב'"
        },
        {
          "s": 8,
          "text": "(ירידות ו)"
        },
        {
          "s": 9,
          "text": "עליות אלו קאי על גאולת מצרים והגאולה העתידה."
        },
        {
          "s": 10,
          "text": "ולכאורה מהי השייכות בין הגאולה ממצרים להגאולה העתידה"
        },
        {
          "s": 11,
          "text": "(שמקשרים אותם זל\"ז)."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "והענין הוא12,"
        },
        {
          "s": 1,
          "text": "דהנה כתיב13"
        },
        {
          "s": 2,
          "text": "כימי צאתך מארץ מצרים אראנו נפלאות."
        },
        {
          "s": 3,
          "text": "דהפירוש הפשוט בהכתוב הוא,"
        },
        {
          "s": 4,
          "text": "דכמו שבימי צאתך מארץ מצרים היו נפלאות הנה בדוגמא לזה אראנו נפלאות בגאולה העתידה,"
        },
        {
          "s": 5,
          "text": "ובזהר14"
        },
        {
          "s": 6,
          "text": "פירש שהנפלאות דגאולה העתידה יהיו נפלאות אפילו לגבי הנפלאות שהיו בימי צאתך מארץ מצרים."
        },
        {
          "s": 7,
          "text": "אמנם מזה שמדמין ב' הנפלאות"
        },
        {
          "s": 8,
          "text": "(דמצרים והגאולה העתידה)"
        },
        {
          "s": 9,
          "text": "זל\"ז מובן שיש ביניהם שייכות בתוכנם הפנימי"
        },
        {
          "s": 10,
          "text": "(ולא רק שדומין מצד זה שבשניהם ישנם נפלאות),"
        },
        {
          "s": 11,
          "text": "ומפני שהם דומים בתוכנם הפנימי נמשך אח\"כ שהם דומים גם במה שבשני הגאולות ישנם נפלאות"
        },
        {
          "s": 12,
          "text": "[וזהו קשר המשך המאמר"
        },
        {
          "s": 13,
          "text": "(בתורה אור שם,"
        },
        {
          "s": 14,
          "text": "וכן בתורת חיים שם)"
        },
        {
          "s": 15,
          "text": "שלאחר שביאר דב' העליות"
        },
        {
          "s": 16,
          "text": "(דאעלך גם עלה)"
        },
        {
          "s": 17,
          "text": "קאי על גאולת מצרים והגאולה העתידה ממשיך דהנה כתיב כימי צאתך מארץ מצרים אראנו נפלאות,"
        },
        {
          "s": 18,
          "text": "כי בזה בא לבאר את השייכות שבין ב' הגאולות"
        },
        {
          "s": 19,
          "text": "(שמקשרים אותם בהכתוב דאעלך גם עלה)]."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "וביאור השייכות בתוכן ב' הגאולות"
        },
        {
          "s": 2,
          "text": "(דמצרים ודלע\"ל)"
        },
        {
          "s": 3,
          "text": "הוא15,"
        },
        {
          "s": 4,
          "text": "דכמו שבגלות מצרים לא היתה הכוונה בהגלות עצמו ח\"ו,"
        },
        {
          "s": 5,
          "text": "ונקודתו הפנימית היתה ענין הגאולה שלאח\"ז,"
        },
        {
          "s": 6,
          "text": "שתכליתה הוא קבלת התורה כמ\"ש16"
        },
        {
          "s": 7,
          "text": "בהוציאך את העם ממצרים תעבדון את האלקים על ההר הזה,"
        },
        {
          "s": 8,
          "text": "הנה כך כל הגלות הזה הוא כדי לזכות לגילוי פנימיות התורה שיהי' לע\"ל,"
        },
        {
          "s": 9,
          "text": "שע\"ז נאמר17"
        },
        {
          "s": 10,
          "text": "ישקני מנשיקות פיהו גו'."
        },
        {
          "s": 11,
          "text": "דכמו שענין השעבוד דמצרים הי' בכדי לצרף את ישראל ולזככם ולטהרם בכדי שיוכלו לקבל את התורה,"
        },
        {
          "s": 12,
          "text": "בדוגמא לכור הברזל18"
        },
        {
          "s": 13,
          "text": "שמצרף את הכסף מהפסולת והסיגים ונשאר הכסף נקי מכל סיג כו',"
        },
        {
          "s": 14,
          "text": "הנה עד\"ז ע\"י גלות זה האחרון זוכים לגילוי פנימיות התורה"
        },
        {
          "s": 15,
          "text": "[ונמשך באופן דמיני' יתפרנסון19,"
        },
        {
          "s": 16,
          "text": "והיינו באופן של פרנסה ומזון20,"
        },
        {
          "s": 17,
          "text": "דענין זה הוא אמיתית הפרנסה של"
        },
        {
          "s": 18,
          "text": "(כל)"
        },
        {
          "s": 19,
          "text": "א' מישראל,"
        },
        {
          "s": 20,
          "text": "ועד שנמשך גם בהרגל שלו,"
        },
        {
          "s": 21,
          "text": "ופועל בו התפשטות והתרחבות,"
        },
        {
          "s": 22,
          "text": "וכמו שנת\"ל21]."
        },
        {
          "s": 23,
          "text": "וזהו ביאור גודל אריכות גלות זה האחרון שהוא באין ערוך מגלות מצרים,"
        },
        {
          "s": 24,
          "text": "דטעם הדבר הוא,"
        },
        {
          "s": 25,
          "text": "כיון שתכלית כוונת גלות האחרון הוא בכדי לזכות עי\"ז לגילוי פנימיות התורה,"
        },
        {
          "s": 26,
          "text": "משא\"כ גלות מצרים דכוונתו היתה בשביל גילוי נגלה דתורה,"
        },
        {
          "s": 27,
          "text": "כנ\"ל,"
        },
        {
          "s": 28,
          "text": "לכן כמו שפנימיות התורה,"
        },
        {
          "s": 29,
          "text": "ישקני מנשיקות פיהו,"
        },
        {
          "s": 30,
          "text": "הוא באין ערוך מנגלה דתורה,"
        },
        {
          "s": 31,
          "text": "כמו\"כ הגלות"
        },
        {
          "s": 32,
          "text": "(שע\"י באים לגילוי זה)"
        },
        {
          "s": 33,
          "text": "הוא ג\"כ"
        },
        {
          "s": 34,
          "text": "(בדוגמא להתורה שמתגלית ע\"י)"
        },
        {
          "s": 35,
          "text": "באין ערוך מגלות מצרים שע\"י באו לגילוי נגלה דתורה."
        },
        {
          "s": 36,
          "text": "דנגלה דתורה הוא בחינת תורה שבאה בהגבלה,"
        },
        {
          "s": 37,
          "text": "משא\"כ פנימיות התורה,"
        },
        {
          "s": 38,
          "text": "שהיא באין ערוך למעלה ממדידה והגבלה."
        },
        {
          "s": 39,
          "text": "ואע\"פ שגם אריכות גלות זה האחרון באה בהגבלה בכמות"
        },
        {
          "s": 40,
          "text": "(השנים),"
        },
        {
          "s": 41,
          "text": "הנה אין הכוונה בגודל האריכות שבגלות זה על האריכות בזמן"
        },
        {
          "s": 42,
          "text": "(בלבד),"
        },
        {
          "s": 43,
          "text": "כ\"א"
        },
        {
          "s": 44,
          "text": "(גם)"
        },
        {
          "s": 45,
          "text": "על האריכות שבו בגודל היסורים והצרות ובפרט בחבלי משיח"
        },
        {
          "s": 46,
          "text": "(חבלי לידה)22,"
        },
        {
          "s": 47,
          "text": "שצרות ויסורים אלו הם באין ערוך מהיסורים שבגלות מצרים."
        },
        {
          "s": 48,
          "text": "ואין הכוונה שצ\"ל ח\"ו צרות ויסורים וכו',"
        },
        {
          "s": 49,
          "text": "כ\"א ענינים שאינם מתאימים לרגילותו של ישראל"
        },
        {
          "s": 50,
          "text": "(וואָס איז ניט לויט די געוואוינהייט פון אַ אידן)"
        },
        {
          "s": 51,
          "text": "בלבד,"
        },
        {
          "s": 52,
          "text": "שג\"ז נחשב ליסורים."
        },
        {
          "s": 53,
          "text": "וכדאיתא בגמרא23"
        },
        {
          "s": 54,
          "text": "עה\"כ24"
        },
        {
          "s": 55,
          "text": "ויעבידו מצרים את בני ישראל בפרך שנתנו עבודת נשים לאנשים וכו',"
        },
        {
          "s": 56,
          "text": "אע\"פ שעבודת נשים קלה מעבודת אנשים,"
        },
        {
          "s": 57,
          "text": "דאשה תש כוחה25,"
        },
        {
          "s": 58,
          "text": "מ\"מ לגבי האנשים לעבודת פרך יחשב כיון שאינה לפי רגילותם."
        },
        {
          "s": 59,
          "text": "ועאכו\"כ בנוגע לענין של העדר הרגילות לגבי א' מישראל,"
        },
        {
          "s": 60,
          "text": "שליסורים גדולים יחשב."
        },
        {
          "s": 61,
          "text": "ובמכש\"כ וק\"ו מנבוכדנצר26"
        },
        {
          "s": 62,
          "text": "שבזכות שפסע ג' פסיעות לכבוד ממה\"מ הקב\"ה זכה למלכות לו ולבנו ולבן בנו,"
        },
        {
          "s": 63,
          "text": "ג' דורות27,"
        },
        {
          "s": 64,
          "text": "ומלכות בתכלית ההתרחבות וכו',"
        },
        {
          "s": 65,
          "text": "דנבוכדנצר מולך בכפה הי'28,"
        },
        {
          "s": 66,
          "text": "הנה עאכו\"כ כשמדובר אודות א' מישראל,"
        },
        {
          "s": 67,
          "text": "בני בכורי ישראל29,"
        },
        {
          "s": 68,
          "text": "בנים אתם לה' אלקיכם30,"
        },
        {
          "s": 69,
          "text": "הנה הטובה המגיע להם היא שלא לפי ערך כלל ממה שזכה נבוכדנצר,"
        },
        {
          "s": 70,
          "text": "וכ\"א מישראל אפילו הפשוט שבפשוטים ביכולתו לתבוע מהקב\"ה כל ענינים טובים ברוחניות"
        },
        {
          "s": 71,
          "text": "[שזהו העיקר של יהודי]"
        },
        {
          "s": 72,
          "text": "ומזה נמשך גם בגשמיות,"
        },
        {
          "s": 73,
          "text": "בכל עניני ברכה וכו' שכללותם היא בני חיי ומזוני רויחי,"
        },
        {
          "s": 74,
          "text": "ובאופן דמולך בכפה."
        },
        {
          "s": 75,
          "text": "ומזה מובן שכל ענין של העדר הרגילות של יהודי ליסורים גדולים יחשב,"
        },
        {
          "s": 76,
          "text": "ובאין ערוך לגבי מצרים שהי' לפני מ\"ת ודרגת מצווה ועושה31,"
        },
        {
          "s": 77,
          "text": "ועי\"ז מעבירים הכתמים הכי קטנים שנשארו לאחר כל היסורים וצרות וואָס מ'איז דורכגעגאַנגען."
        }
      ]
    }
  ]
}