{
  "globalIndex": 1092,
  "owner": 42,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920318_theRebbe_459__p004",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920318_theRebbe_459__p004",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920318_theRebbe_459",
  "title": "מאמר שמח תשמח תשמ\"א",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "וכמו שהי' ביום חתונתו זה מ\"ת57"
        },
        {
          "s": 2,
          "text": "שאז היתה המשכת השמחה העצמית כו'"
        },
        {
          "s": 3,
          "text": "(וכמבואר בהמאמר58,"
        },
        {
          "s": 4,
          "text": "דעיקר השמחה שפורצת כל הגדרים הוא שמחת נשואין),"
        },
        {
          "s": 5,
          "text": "וההמשכה אז היתה ע\"י עבודה,"
        },
        {
          "s": 6,
          "text": "שהרי ביום חתונתו זה מ\"ת קאי על לוחות השניות59"
        },
        {
          "s": 7,
          "text": "וענין לוחות השניות הוא מה שניתנו ע\"י עבודה דוקא."
        },
        {
          "s": 8,
          "text": "ועד\"ז הוא בקיום כל מצוה,"
        },
        {
          "s": 9,
          "text": "דע\"י כל מצוה צ\"ל לשם יחוד קוב\"ה ושכינתי' כדאיתא בפע\"ח60,"
        },
        {
          "s": 10,
          "text": "ומה שאנו אומרים לשם יחוד רק פעם אחת קודם התפלה הוא לפי שאמירה זו היא פעולה נמשכת על כל היום61."
        },
        {
          "s": 11,
          "text": "ומכיון שכל אחד מישראל הוא בנו יחידו של הקב\"ה כתורת הבעש\"ט הידועה62,"
        },
        {
          "s": 12,
          "text": "וכתיב63"
        },
        {
          "s": 13,
          "text": "בני בכורי ישראל לשון יחיד,"
        },
        {
          "s": 14,
          "text": "וגם במ\"ת נאמר לכאו\"א מישראל אנכי64"
        },
        {
          "s": 15,
          "text": "הוי' אלקיך לשון יחיד65,"
        },
        {
          "s": 16,
          "text": "הרי,"
        },
        {
          "s": 17,
          "text": "שהשמחה שלמעלה שבקיום כל מצוה דכאו\"א מישראל היא שמחת הקב\"ה בחתונת בנו יחידו,"
        },
        {
          "s": 18,
          "text": "דשמחה זו פורצת כל הגדרים."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ובפרט בחודש אלול,"
        },
        {
          "s": 2,
          "text": "כשהמלך נמצא בשדה עם כאו\"א מישראל,"
        },
        {
          "s": 3,
          "text": "ומקבל את כאו\"א בסבר פנים יפות ומראה לו פנים שוחקות66,"
        },
        {
          "s": 4,
          "text": "ואלול הוא ר\"ת אני לדודי ודודי לי67,"
        },
        {
          "s": 5,
          "text": "דאפילו דודים שקאי על זו\"ן שזיווגם הוא רק לפרקים13,"
        },
        {
          "s": 6,
          "text": "הנה בחודש אלול הם מתייחדים בתיבה אחת."
        },
        {
          "s": 7,
          "text": "ומזה מובן,"
        },
        {
          "s": 8,
          "text": "דנוסף על הענין דשמחת נשואין"
        },
        {
          "s": 9,
          "text": "(יחוד קוב\"ה ושכינתי')"
        },
        {
          "s": 10,
          "text": "שבמשך כל השנה מצד קיום המצוות,"
        },
        {
          "s": 11,
          "text": "הנה בחודש אלול הוא ביתר שאת."
        },
        {
          "s": 12,
          "text": "ובפרט בהשבתות בחודש אלול."
        },
        {
          "s": 13,
          "text": "דהנה בחודש אלול תוקעין בשופר כדי להזהיר ישראל שיעשו תשובה שנאמר68"
        },
        {
          "s": 14,
          "text": "אם יתקע שופר בעיר ועם לא יחרדו69."
        },
        {
          "s": 15,
          "text": "הרי שבאלול יש גם ענין היראה וחרדה."
        },
        {
          "s": 16,
          "text": "אמנם זהו רק בימי החול,"
        },
        {
          "s": 17,
          "text": "משא\"כ בהשבתות שבחודש אלול,"
        },
        {
          "s": 18,
          "text": "הרי ענין היראה והחרדה דאלול לכאורה"
        },
        {
          "s": 19,
          "text": "(בגילוי)"
        },
        {
          "s": 20,
          "text": "אינם בשבת,"
        },
        {
          "s": 21,
          "text": "שהרי בשבת אין תוקעין ובשבת אין עצב בה70,"
        },
        {
          "s": 22,
          "text": "ועיקר פעולת אלול בימי השבתות הוא הענין דאני לדודי ודודי לי,"
        },
        {
          "s": 23,
          "text": "שמחת נשואין דהקב\"ה וכנס\"י."
        },
        {
          "s": 24,
          "text": "ומזה מובן,"
        },
        {
          "s": 25,
          "text": "שכל הוספה בתומ\"צ,"
        },
        {
          "s": 26,
          "text": "ובפרט בחודש אלול,"
        },
        {
          "s": 27,
          "text": "פורצת כל הגדרים,"
        },
        {
          "s": 28,
          "text": "כולל גם גדרי הגלות,"
        },
        {
          "s": 29,
          "text": "דכל הוספה בתומ\"צ"
        },
        {
          "s": 30,
          "text": "(שענינם היפך הגלות)"
        },
        {
          "s": 31,
          "text": "ממהרת את הגאולה העתידה,"
        },
        {
          "s": 32,
          "text": "ביום ההוא יהי' גו'71,"
        },
        {
          "s": 33,
          "text": "ב\"פ י\"ה72,"
        },
        {
          "s": 34,
          "text": "היינו שגם ו\"ה יהי' כמו י\"ה,"
        },
        {
          "s": 35,
          "text": "וכמו שי\"ה זיווגייהו תדיר,"
        },
        {
          "s": 36,
          "text": "כמו\"כ בחי' ו\"ה יהי' זיווגייהו תדיר73,"
        },
        {
          "s": 37,
          "text": "בגאולה העתידה,"
        },
        {
          "s": 38,
          "text": "שאז יהי' ענין הנשואין,"
        },
        {
          "s": 39,
          "text": "כדאיתא בשמו\"ר74"
        },
        {
          "s": 40,
          "text": "שעכשיו הו\"ע האירוסין ולע\"ל יהיו הנשואין,"
        },
        {
          "s": 41,
          "text": "במהרה בימינו ממש."
        }
      ]
    }
  ]
}