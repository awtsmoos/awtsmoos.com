{
  "globalIndex": 25,
  "owner": 25,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913820_theRebbe_687__p004",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913820_theRebbe_687__p004",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518913820_theRebbe_687",
  "title": "מאמר זה היום תחילת מעשיך תשמ\"א",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וזהו זה היום תחלת מעשיך כו' כי חק לישראל הוא משפט לאלקי יעקב64,"
        },
        {
          "s": 2,
          "text": "דמלת כי פירושה נתינת טעם על מה שקדם לומר זה היום תחלת מעשיך65."
        },
        {
          "s": 3,
          "text": "דהנה החיבור ד\"זה\" ו\"כה\" שבאדם"
        },
        {
          "s": 4,
          "text": "(שעי\"ז הוא ממשיך הגילוי ד\"זה\" גם בבחי' \"כה\" דהעולם)"
        },
        {
          "s": 5,
          "text": "הוא ע\"י עבודתו בלימוד התורה ובקיום המצוות."
        },
        {
          "s": 6,
          "text": "דעסק התורה שייך"
        },
        {
          "s": 7,
          "text": "(בעיקר)"
        },
        {
          "s": 8,
          "text": "להנשמה66"
        },
        {
          "s": 9,
          "text": "(זה),"
        },
        {
          "s": 10,
          "text": "וקיום המצוות שנתלבשו בדברים גשמיים שייך"
        },
        {
          "s": 11,
          "text": "(בעיקר)"
        },
        {
          "s": 12,
          "text": "לבירור וזיכוך הגוף66,"
        },
        {
          "s": 13,
          "text": "וע\"י העבודה בעסק התורה וקיום המצוות"
        },
        {
          "s": 14,
          "text": "(ועד שנעשים ענין אחד,"
        },
        {
          "s": 15,
          "text": "מכיון שכל אחד מסייע להשני67),"
        },
        {
          "s": 16,
          "text": "נעשה החיבור ד\"זה\" עם \"כה\"."
        },
        {
          "s": 17,
          "text": "וזהו כי חק לישראל הוא משפט לאלקי יעקב,"
        },
        {
          "s": 18,
          "text": "חק קאי על התורה ומשפט על המצוות"
        },
        {
          "s": 19,
          "text": "(כמבואר בלקו\"ת65)."
        },
        {
          "s": 20,
          "text": "דזהו חק לישראל גו' משפט לאלקי יעקב,"
        },
        {
          "s": 21,
          "text": "דבתורה"
        },
        {
          "s": 22,
          "text": "(חק)"
        },
        {
          "s": 23,
          "text": "אומר ישראל ובמצוות"
        },
        {
          "s": 24,
          "text": "(משפט)"
        },
        {
          "s": 25,
          "text": "אומר יעקב,"
        },
        {
          "s": 26,
          "text": "כי התורה היא הבנה והשגה,"
        },
        {
          "s": 27,
          "text": "ולכן שייכת לישראל אותיות לי ראש68,"
        },
        {
          "s": 28,
          "text": "ומצוות שקיומן הוא בכח המעשה של האדם שייכות ליעקב מלשון עקב69."
        },
        {
          "s": 29,
          "text": "וגם יעקב הוא על שם וידו אוחזת בעקב גו'70,"
        },
        {
          "s": 30,
          "text": "וי\"ל שזהו71"
        },
        {
          "s": 31,
          "text": "שהמצוות נתלבשו בדברים גשמיים דעוה\"ז התחתון שאין תחתון למטה ממנו."
        },
        {
          "s": 32,
          "text": "וזהו זה היום תחלת מעשיך כו' כי חק לישראל הוא משפט לאלקי יעקב,"
        },
        {
          "s": 33,
          "text": "ד\"חק לישראל גו' משפט לאלקי יעקב\" הוא נתינת טעם על זה היום תחלת מעשיך,"
        },
        {
          "s": 34,
          "text": "היינו דהמשכת וגילוי עצמות אוא\"ס"
        },
        {
          "s": 35,
          "text": "(\"זה\")"
        },
        {
          "s": 36,
          "text": "בהעולם"
        },
        {
          "s": 37,
          "text": "(\"מעשיך\")"
        },
        {
          "s": 38,
          "text": "ע\"י האדם שנברא בהיום דראש השנה"
        },
        {
          "s": 39,
          "text": "(\"היום\")"
        },
        {
          "s": 40,
          "text": "הוא ע\"י חק לישראל גו' משפט לאלקי יעקב,"
        },
        {
          "s": 41,
          "text": "לימוד התורה וקיום המצוות72."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "וע\"פ הנ\"ל יש לבאר גם מה שידוע דבראש השנה הוא בנין המלכות73,"
        },
        {
          "s": 2,
          "text": "דכמו שבראש השנה בפעם הראשונה,"
        },
        {
          "s": 3,
          "text": "ביום ברוא אדם הראשון,"
        },
        {
          "s": 4,
          "text": "הי'"
        },
        {
          "s": 5,
          "text": "(התחלת)"
        },
        {
          "s": 6,
          "text": "גילוי מדת מלכותו ית' ע\"י אדם הראשון,"
        },
        {
          "s": 7,
          "text": "דזהו מה שאמר אדם הראשון אז"
        },
        {
          "s": 8,
          "text": "(השיר של יום ו'74)"
        },
        {
          "s": 9,
          "text": "הוי' מלך גאות לבש75,"
        },
        {
          "s": 10,
          "text": "עד\"ז הוא בכל שנה ושנה,"
        },
        {
          "s": 11,
          "text": "שבהיום דראש השנה הוא המשכת בחינת המלכות ממקורה ע\"י ישראל שקרויין אדם ע\"ש אדם הראשון כנ\"ל76."
        },
        {
          "s": 12,
          "text": "וזהו שאומרים בהתפלות דראש השנה5"
        },
        {
          "s": 13,
          "text": "מלוך על העולם כולו בכבודך כו' מלך על כל הארץ"
        },
        {
          "s": 14,
          "text": "[וענין זה77"
        },
        {
          "s": 15,
          "text": "אומרים מיד בתחלת ראש השנה,"
        },
        {
          "s": 16,
          "text": "בתפלת ערבית],"
        },
        {
          "s": 17,
          "text": "לפי שעיקר הענין דראש השנה הוא המשכת ובנין המלכות."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "דהנה ע\"פ המבואר בכ\"מ78"
        },
        {
          "s": 1,
          "text": "משמע שהשייכות דראש השנה לענין המשכת המלכות היא לפי שבראש השנה הוא חידוש מע\"ב"
        },
        {
          "s": 2,
          "text": "(שלכן נקרא תחלת מעשיך)79,"
        },
        {
          "s": 3,
          "text": "החידוש דכללות העולמות והתהוותם ליש80,"
        },
        {
          "s": 4,
          "text": "ולכן צריך להמשיך אז מדת המלכות,"
        },
        {
          "s": 5,
          "text": "לפי שהתהוות כל העולמות היא ממדת מלכותו ית'."
        },
        {
          "s": 6,
          "text": "וביאור זה דורש תוס' ביאור,"
        },
        {
          "s": 7,
          "text": "שהרי לצורך ההתהוות צ\"ל כל המדות,"
        },
        {
          "s": 8,
          "text": "כמ\"ש81"
        },
        {
          "s": 9,
          "text": "כי ששת ימים עשה ה' את השמים ואת הארץ וידוע82"
        },
        {
          "s": 10,
          "text": "דששת ימים קאי על שש המדות שמהן נעשו השמים והארץ,"
        },
        {
          "s": 11,
          "text": "דכל יומא ויומא עביד עבידתי'83."
        },
        {
          "s": 12,
          "text": "ואע\"פ שבשביל התהוות העולם צ\"ל כל המדות,"
        },
        {
          "s": 13,
          "text": "בכ\"ז מדגישים בהתפלות דראש השנה המשכת המלכות דוקא."
        },
        {
          "s": 14,
          "text": "ונוסף על זה,"
        },
        {
          "s": 15,
          "text": "הרי ענין המלכות שלצורך התהוות העולמות הוא"
        },
        {
          "s": 16,
          "text": "(בעיקר)"
        },
        {
          "s": 17,
          "text": "בחינת הדיבור דמלכות,"
        },
        {
          "s": 18,
          "text": "בדבר הוי' שמים נעשו84,"
        },
        {
          "s": 19,
          "text": "והם העשרה מאמרות שבהם נברא העולם85,"
        },
        {
          "s": 20,
          "text": "וההדגשה בראש השנה היא"
        },
        {
          "s": 21,
          "text": "(לא על ענין הדיבור דמלכות,"
        },
        {
          "s": 22,
          "text": "כי אם)"
        },
        {
          "s": 23,
          "text": "על ענין המלוכה,"
        },
        {
          "s": 24,
          "text": "מלוך על העולם כולו כו' מלך על כל הארץ."
        },
        {
          "s": 25,
          "text": "וגם בנוגע להדיבור דמלכות,"
        },
        {
          "s": 26,
          "text": "הרי רובם ככולם של המאמרות שבהם נברא העולם היו לפני יום ו' דמע\"ב"
        },
        {
          "s": 27,
          "text": "[ויתירה מזו,"
        },
        {
          "s": 28,
          "text": "שהתהוות הנבראים מהעשרה מאמרות היא תמיד"
        },
        {
          "s": 29,
          "text": "(גם לאחרי שי\"ב)"
        },
        {
          "s": 30,
          "text": "כתורת הבעש\"ט הידועה86,"
        },
        {
          "s": 31,
          "text": "וכמאמר87"
        },
        {
          "s": 32,
          "text": "המחדש בטובו בכל יום תמיד מעשה בראשית וידוע שזהו בכל יום תמיד דוקא,"
        },
        {
          "s": 33,
          "text": "בכל רגע ורגע],"
        },
        {
          "s": 34,
          "text": "ומה זה שייך לראש השנה דוקא."
        }
      ]
    }
  ]
}