{
  "globalIndex": 712,
  "owner": 12,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917950_theRebbe_524__p003",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917950_theRebbe_524__p003",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917950_theRebbe_524",
  "title": "מאמר על שלושה דברים תשי\"ד",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה כמו שהענין דלמעלה עד אין קץ הוא גם בעולמות התחתונים,"
        },
        {
          "s": 2,
          "text": "כמו שנתבאר לעיל"
        },
        {
          "s": 3,
          "text": "(סעיף ב)"
        },
        {
          "s": 4,
          "text": "שגם בהנבראים דבי\"ע ואפילו בהנבראים שבעוה\"ז מאיר בהם הרוממות דאוא\"ס,"
        },
        {
          "s": 5,
          "text": "שכל העולמות הם באין ערוך וכלא חשיב לגבי' ית',"
        },
        {
          "s": 6,
          "text": "ועי\"ז נעשה בהם רצוא לאלקות,"
        },
        {
          "s": 7,
          "text": "שרוצים לצאת ממציאותם,"
        },
        {
          "s": 8,
          "text": "עד\"ז הוא גם בההעלאה דתפלה"
        },
        {
          "s": 9,
          "text": "(שהיא דוגמת הענין דלמעלה עד אין קץ),"
        },
        {
          "s": 10,
          "text": "דגם כשהאדם הוא למטה מטה עד אין תכלית,"
        },
        {
          "s": 11,
          "text": "הנה ע\"י התפלה הוא מתעלה"
        },
        {
          "s": 12,
          "text": "(היינו שהוא ברצוא ותשוקה לעלות)"
        },
        {
          "s": 13,
          "text": "למעלה מעלה עד אין קץ."
        },
        {
          "s": 14,
          "text": "וכמ\"ש20"
        },
        {
          "s": 15,
          "text": "סולם מוצב ארצה וראשו מגיע השמימה ואיתא בזהר21"
        },
        {
          "s": 16,
          "text": "סולם דא צלותא,"
        },
        {
          "s": 17,
          "text": "דגם כשהאדם הוא בדרגא הכי תחתונה"
        },
        {
          "s": 18,
          "text": "(ארצה22),"
        },
        {
          "s": 19,
          "text": "ע\"י הסולם דתפלה הוא מגיע ועולה השמימה."
        },
        {
          "s": 20,
          "text": "אלא,"
        },
        {
          "s": 21,
          "text": "שלהיותו בשפל המצב,"
        },
        {
          "s": 22,
          "text": "בכדי שיתעורר ברצוא ותשוקה לעלות למעלה,"
        },
        {
          "s": 23,
          "text": "צריך הוא להתבונן"
        },
        {
          "s": 24,
          "text": "(לא רק בהענינים דגדולת ה' המבוארים בתפלה,"
        },
        {
          "s": 25,
          "text": "אלא גם)"
        },
        {
          "s": 26,
          "text": "בענין זה עצמו,"
        },
        {
          "s": 27,
          "text": "שהוא בשפל המצב."
        },
        {
          "s": 28,
          "text": "הן בנוגע למחשבה דיבור ומעשה,"
        },
        {
          "s": 29,
          "text": "שלפעמים הוא נכשל"
        },
        {
          "s": 30,
          "text": "(ער פאַלט דורך)"
        },
        {
          "s": 31,
          "text": "אפילו במעשה בפועל ומכ\"ש בדיבור ועאכו\"כ במחשבה,"
        },
        {
          "s": 32,
          "text": "והן בנוגע לשכלו ומדותיו."
        },
        {
          "s": 33,
          "text": "דהגם שעיקר עבודת האדם הוא סור מרע ועשה טוב בפועל ממש במחשבה דיבור ומעשה,"
        },
        {
          "s": 34,
          "text": "הרי ענין זה"
        },
        {
          "s": 35,
          "text": "(שהעיקר הוא הפועל ממש)"
        },
        {
          "s": 36,
          "text": "הוא בנוגע להכוונה דלמעלה,"
        },
        {
          "s": 37,
          "text": "אבל בנוגע למצב האדם23,"
        },
        {
          "s": 38,
          "text": "כיון שהשכל והמדות הם מיוחדים עם הנפש,"
        },
        {
          "s": 39,
          "text": "והמחשבה דיבור ומעשה הם רק לבושים"
        },
        {
          "s": 40,
          "text": "(כמשנ\"ת בארוכה במאמר הקודם24),"
        },
        {
          "s": 41,
          "text": "ציור השכל והמדות שלו"
        },
        {
          "s": 42,
          "text": "(אם הם בקדושה או להיפך)"
        },
        {
          "s": 43,
          "text": "נוגע יותר מהמחשבה דיבור ומעשה שלו."
        },
        {
          "s": 44,
          "text": "ומכ\"ש כשמתבונן בנוגע לעצם נפשו,"
        },
        {
          "s": 45,
          "text": "שגם כשהמחשבה דיבור ומעשה וגם המדות והשכל הם בקדושה אפשר שעצם נפשו היא בעמקי הקליפות,"
        },
        {
          "s": 46,
          "text": "וכידוע25"
        },
        {
          "s": 47,
          "text": "בענין מה שאמר ריב\"ז26"
        },
        {
          "s": 48,
          "text": "איני יודע באיזו דרך מוליכין אותי,"
        },
        {
          "s": 49,
          "text": "הנה ע\"י שמתבונן בכל זה ומרגיש שהוא בשפל המצב,"
        },
        {
          "s": 50,
          "text": "הוא מתעורר ברצוא לצאת ממציאותו ולעלות למעלה."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה נתבאר לעיל"
        },
        {
          "s": 2,
          "text": "(במאמר הקודם27)"
        },
        {
          "s": 3,
          "text": "דשני הענינים שבאוא\"ס"
        },
        {
          "s": 4,
          "text": "(למעלה מעלה עד אין קץ ולמטה מטה עד אין תכלית)"
        },
        {
          "s": 5,
          "text": "בשרשם הראשון"
        },
        {
          "s": 6,
          "text": "(בהאור כמו שכלול בהעצמות,"
        },
        {
          "s": 7,
          "text": "שהו\"ע היכולת)"
        },
        {
          "s": 8,
          "text": "הוא זה שביכלתו להאיר וביכלתו שלא להאיר."
        },
        {
          "s": 9,
          "text": "וכיון שבבחינת היכולת שניהם"
        },
        {
          "s": 10,
          "text": "(היכולת להאיר והיכולת שלא להאיר)"
        },
        {
          "s": 11,
          "text": "הם ענין אחד,"
        },
        {
          "s": 12,
          "text": "לכן,"
        },
        {
          "s": 13,
          "text": "גם כשהם נמשכים בגילוי ועי\"ז הם נעשים שני ענינים,"
        },
        {
          "s": 14,
          "text": "למעלה מעלה ולמטה מטה,"
        },
        {
          "s": 15,
          "text": "הם כלולים זה מזה."
        },
        {
          "s": 16,
          "text": "ועד\"ז הוא בתורה ותפלה,"
        },
        {
          "s": 17,
          "text": "שהם כלולים זה מזה."
        },
        {
          "s": 18,
          "text": "דגם בתורה שהיא המשכה מלמעלה למטה יש בה ענין ההעלאה מלמטה למעלה,"
        },
        {
          "s": 19,
          "text": "וכמו\"כ הוא בתפלה,"
        },
        {
          "s": 20,
          "text": "שהיא העלאה מלמטה למעלה,"
        },
        {
          "s": 21,
          "text": "שיש בה גם ענין ההמשכה מלמעלה למטה."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ויובן זה ע\"פ מה שאמרו רז\"ל28"
        },
        {
          "s": 1,
          "text": "ג' שעות ראשונות הקב\"ה יושב ועוסק בתורה,"
        },
        {
          "s": 2,
          "text": "וידוע הדיוק בזה29,"
        },
        {
          "s": 3,
          "text": "הרי כל הקורא ושונה הקב\"ה קורא ושונה כנגדו30,"
        },
        {
          "s": 4,
          "text": "וכיון שישראל עוסקים בתורה במשך כל היום"
        },
        {
          "s": 5,
          "text": "(זה לומד בשעה זו וזה לומד בשעה זו),"
        },
        {
          "s": 6,
          "text": "הרי גם הקב\"ה עוסק בתורה במשך כל היום,"
        },
        {
          "s": 7,
          "text": "ואעפ\"כ אמרו שבג' שעות ראשונות"
        },
        {
          "s": 8,
          "text": "(דוקא)"
        },
        {
          "s": 9,
          "text": "הקב\"ה יושב ועוסק בתורה."
        },
        {
          "s": 10,
          "text": "ונקודת הביאור בזה31,"
        },
        {
          "s": 11,
          "text": "דזה שכל הקורא ושונה הקב\"ה קורא ושונה כנגדו היא המשכה מלמעלה שע\"י אתערותא דלתתא"
        },
        {
          "s": 12,
          "text": "(עסק התורה דהאדם),"
        },
        {
          "s": 13,
          "text": "ולכן,"
        },
        {
          "s": 14,
          "text": "ההמשכה היא לפי ערך האתערותא דלתתא."
        },
        {
          "s": 15,
          "text": "דזהו שאמרו כל הקורא ושונה הקב\"ה קורא ושונה כנגדו,"
        },
        {
          "s": 16,
          "text": "דזה שהקב\"ה קורא ושונה הוא כנגדו,"
        },
        {
          "s": 17,
          "text": "לפי הלימוד דהאדם."
        },
        {
          "s": 18,
          "text": "וזה שבג' שעות ראשונות הקב\"ה יושב ועוסק בתורה היא המשכה מלמעלה מצד עצמה,"
        },
        {
          "s": 19,
          "text": "ממקום שאין אתעדל\"ת מגעת לשם."
        },
        {
          "s": 20,
          "text": "והמשכה זו היא נתינת כח לאדם שיוכל לעסוק בתורה ושע\"י עסק התורה שלו יהי' הקב\"ה קורא ושונה כנגדו."
        },
        {
          "s": 21,
          "text": "וזהו יערוף כמטר לקחי תזל כטל אמרתי32,"
        },
        {
          "s": 22,
          "text": "דהחילוק בין טל ומטר הוא,"
        },
        {
          "s": 23,
          "text": "דירידת מטר תלוי בעבודת האדם"
        },
        {
          "s": 24,
          "text": "(כמ\"ש33"
        },
        {
          "s": 25,
          "text": "והי' אם שמוע גו'"
        },
        {
          "s": 26,
          "text": "(ואז דוקא34)"
        },
        {
          "s": 27,
          "text": "ונתתי מטר ארצכם גו'),"
        },
        {
          "s": 28,
          "text": "וטל אינו תלוי בעבודת האדם"
        },
        {
          "s": 29,
          "text": "(כמארז\"ל35"
        },
        {
          "s": 30,
          "text": "טל לא מיעצר),"
        },
        {
          "s": 31,
          "text": "דכמו\"כ הוא ברוחניות,"
        },
        {
          "s": 32,
          "text": "דמטר היא ההמשכה שע\"י אתעדל\"ת וטל היא ההמשכה מלמעלה מצד עצמה."
        },
        {
          "s": 33,
          "text": "והטעם שהתורה נמשלה לטל ולמטר הוא,"
        },
        {
          "s": 34,
          "text": "כי בתורה שני הענינים36."
        },
        {
          "s": 35,
          "text": "הדרגא דתורה שנמשכת ע\"י עסק התורה דהאדם – יערוף כמטר לקחי,"
        },
        {
          "s": 36,
          "text": "והדרגא דתורה שהמשכתה היא מלמעלה"
        },
        {
          "s": 37,
          "text": "(בדרך אתעדל\"ע מצד עצמה)"
        },
        {
          "s": 38,
          "text": "– תזל כטל אמרתי."
        },
        {
          "s": 39,
          "text": "וזוהי השייכות דהקב\"ה יושב ועוסק בתורה לג' שעות ראשונות כי שורש הגשם"
        },
        {
          "s": 40,
          "text": "(מטר)"
        },
        {
          "s": 41,
          "text": "הוא בז' תחתונות דעתיק"
        },
        {
          "s": 42,
          "text": "[כידוע בענין שבעתים כאור שבעת הימים37,"
        },
        {
          "s": 43,
          "text": "דשבעתים הוא ארבעים ותשע,"
        },
        {
          "s": 44,
          "text": "ושבעתים כאור שבעת הימים,"
        },
        {
          "s": 45,
          "text": "מ\"ט פעמים ז',"
        },
        {
          "s": 46,
          "text": "בגימטריא גשם38."
        },
        {
          "s": 47,
          "text": "דמזה מובן,"
        },
        {
          "s": 48,
          "text": "שגשם שייך לשבעת הימים שהם ז' תחתונות דעתיק],"
        },
        {
          "s": 49,
          "text": "ושורש הטל הוא בג' ראשונות דעתיק."
        },
        {
          "s": 50,
          "text": "וזוהי השייכות דהקב\"ה יושב ועוסק בתורה"
        },
        {
          "s": 51,
          "text": "(טל דתורה)"
        },
        {
          "s": 52,
          "text": "לג' שעות ראשונות,"
        },
        {
          "s": 53,
          "text": "כי ג'"
        },
        {
          "s": 54,
          "text": "[שעות]"
        },
        {
          "s": 55,
          "text": "ראשונות הם ג' ראשונות דעתיק."
        }
      ]
    }
  ]
}