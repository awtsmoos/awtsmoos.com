{
  "globalIndex": 147,
  "owner": 47,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914548_theRebbe_632__p002",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914548_theRebbe_632__p002",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914548_theRebbe_632",
  "title": "מאמר ביום השמיני תשמ\"א",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים מה שארז\"ל12"
        },
        {
          "s": 2,
          "text": "יפה שעה אחת בתשובה ומעשים טובים בעולם הזה מכל חיי העולם הבא,"
        },
        {
          "s": 3,
          "text": "ואיתא בלקו\"ת"
        },
        {
          "s": 4,
          "text": "(בדרושי שמע\"צ13),"
        },
        {
          "s": 5,
          "text": "דבתשובה ומעשים טובים שני פירושים."
        },
        {
          "s": 6,
          "text": "א',"
        },
        {
          "s": 7,
          "text": "דפירוש תשובה ומעשים טובים הוא שהתשובה היא הקדמה למעשים טובים,"
        },
        {
          "s": 8,
          "text": "דבכדי שהמעשים יהיו טובים"
        },
        {
          "s": 9,
          "text": "(ומאירים)"
        },
        {
          "s": 10,
          "text": "הוא ע\"י קדימת התשובה14."
        },
        {
          "s": 11,
          "text": "ועפ\"ז,"
        },
        {
          "s": 12,
          "text": "זה שאמרו יפה שעה אחת כו' בעוה\"ז קאי"
        },
        {
          "s": 13,
          "text": "(בעיקר)"
        },
        {
          "s": 14,
          "text": "על מעשים טובים."
        },
        {
          "s": 15,
          "text": "והגם שגם לפי פירוש זה יש מעלה בתשובה מכיון שהיא מביאה למעשים טובים,"
        },
        {
          "s": 16,
          "text": "ה\"ז ע\"ד הידוע15"
        },
        {
          "s": 17,
          "text": "בענין גדול לימוד שמביא לידי מעשה16,"
        },
        {
          "s": 18,
          "text": "שבזה גופא מודגש מעלת המעשה."
        },
        {
          "s": 19,
          "text": "הב',"
        },
        {
          "s": 20,
          "text": "דתשובה ומעשים טובים הם שני ענינים,"
        },
        {
          "s": 21,
          "text": "ויפה שעה אחת קאי על שניהם17,"
        },
        {
          "s": 22,
          "text": "היינו,"
        },
        {
          "s": 23,
          "text": "דתשובה היא ענין בפ\"ע."
        },
        {
          "s": 24,
          "text": "ואדרבא,"
        },
        {
          "s": 25,
          "text": "תשובה היא נעלית יותר ממעשים טובים18."
        },
        {
          "s": 26,
          "text": "ועפ\"ז יש לומר דזה שמקדים תשובה למעשים טובים הוא מפני שהיא קודמת במעלה."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ונקודת הביאור בזה י\"ל שבשניהם הו\"ע התשובה."
        },
        {
          "s": 1,
          "text": "היינו,"
        },
        {
          "s": 2,
          "text": "שגם מעשים טובים ענינם הוא תשובה,"
        },
        {
          "s": 3,
          "text": "דע\"י קיום המצוות"
        },
        {
          "s": 4,
          "text": "[ועד\"ז ע\"י העבודה דכל מעשיך יהיו לשם שמים19,"
        },
        {
          "s": 5,
          "text": "ועאכו\"כ20"
        },
        {
          "s": 6,
          "text": "ע\"י בכל דרכיך דעהו21]"
        },
        {
          "s": 7,
          "text": "פודים את ניצוצות הקדושה שבדברים הגשמיים ומשיבים ומעלים אותם לשרשם."
        },
        {
          "s": 8,
          "text": "אלא שתשובה היא תשובה דהנשמה,"
        },
        {
          "s": 9,
          "text": "השבת הנשמה למקורה ושרשה,"
        },
        {
          "s": 10,
          "text": "והרוח תשוב אל האלקים אשר נתנה22,"
        },
        {
          "s": 11,
          "text": "ומעשים טובים הוא התשובה דהניצוצות שבעולם23,"
        },
        {
          "s": 12,
          "text": "כולל גם הניצוצות שבגופו ונפשו הבהמית,"
        },
        {
          "s": 13,
          "text": "שהבירור והעלי' שלהם הוא ע\"י מעשה המצוות,"
        },
        {
          "s": 14,
          "text": "מעשים טובים."
        },
        {
          "s": 15,
          "text": "וזהו יפה שעה אחת בתשובה ומעשים טובים בעולם הזה,"
        },
        {
          "s": 16,
          "text": "כי ענין התשובה"
        },
        {
          "s": 17,
          "text": "(תשובה דהנשמה,"
        },
        {
          "s": 18,
          "text": "ותשובה דהניצוצות,"
        },
        {
          "s": 19,
          "text": "מעשים טובים)"
        },
        {
          "s": 20,
          "text": "היא בעולם הזה דוקא24."
        },
        {
          "s": 21,
          "text": "דזהו הטעם על ירידת הנשמה למטה,"
        },
        {
          "s": 22,
          "text": "בכדי שיהי' בה ענין התשובה."
        },
        {
          "s": 23,
          "text": "דבהיותה למעלה היא במדריגת צדיק,"
        },
        {
          "s": 24,
          "text": "וע\"י ירידתה למטה מתחדש בה ענין התשובה25,"
        },
        {
          "s": 25,
          "text": "ובמקום שבעלי תשובה עומדין אין צדיקים גמורין יכולים לעמוד בו26."
        },
        {
          "s": 26,
          "text": "ועד\"ז הוא בנוגע לירידת הניצוצות למטה,"
        },
        {
          "s": 27,
          "text": "דע\"י הבירור והעלי' שלהם"
        },
        {
          "s": 28,
          "text": "(ענין התשובה דהניצוצות)"
        },
        {
          "s": 29,
          "text": "הם מתעלים למעלה יותר מכפי שהיו קודם הירידה27."
        },
        {
          "s": 30,
          "text": "ועפ\"ז יש לבאר שני הפירושים דלעיל בזה שמקדים תשובה למעשים טובים"
        },
        {
          "s": 31,
          "text": "[אם העיקר הוא מעשים טובים והתשובה היא הקדמה למעשים טובים,"
        },
        {
          "s": 32,
          "text": "או שקדימת תשובה למעשים טובים היא גם קדימה במעלה],"
        },
        {
          "s": 33,
          "text": "כי בהעילוי דתשובה"
        },
        {
          "s": 34,
          "text": "(לגבי צדיקים)"
        },
        {
          "s": 35,
          "text": "כמה ענינים,"
        },
        {
          "s": 36,
          "text": "וישנם ענינים שעיקרם הוא בהתשובה דהנשמה,"
        },
        {
          "s": 37,
          "text": "ומצד ענינים אלו,"
        },
        {
          "s": 38,
          "text": "תשובה"
        },
        {
          "s": 39,
          "text": "(דהנשמה)"
        },
        {
          "s": 40,
          "text": "קודמת במעלה למעשים טובים"
        },
        {
          "s": 41,
          "text": "(תשובה דהניצוצות),"
        },
        {
          "s": 42,
          "text": "ויש ענינים שעיקרם הוא בהתשובה דהניצוצות,"
        },
        {
          "s": 43,
          "text": "ומצד זה העיקר הוא מעשים טובים."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים העילוי דתשובה כפשוטה"
        },
        {
          "s": 2,
          "text": "(תשובה על עבירות),"
        },
        {
          "s": 3,
          "text": "שיש בזה כמה ענינים."
        },
        {
          "s": 4,
          "text": "א',"
        },
        {
          "s": 5,
          "text": "שהצמאון לאלקות דבעלי תשובה הוא צמאון גדול יותר מהצמאון דצדיקים."
        },
        {
          "s": 6,
          "text": "דמכיון שמקודם היו רחוקים,"
        },
        {
          "s": 7,
          "text": "לכן הצמאון שלהם הוא גדול יותר,"
        },
        {
          "s": 8,
          "text": "כמבואר בתניא28."
        },
        {
          "s": 9,
          "text": "וב',"
        },
        {
          "s": 10,
          "text": "דמכיון שמקודם היו רחוקים,"
        },
        {
          "s": 11,
          "text": "הרי התענוג והנחת רוח למעלה שנעשה ע\"י התשובה הוא גדול יותר מהתענוג ונח\"ר דעשיית המצוות"
        },
        {
          "s": 12,
          "text": "(עבודת הצדיקים)"
        },
        {
          "s": 13,
          "text": "נח\"ר29"
        },
        {
          "s": 14,
          "text": "לפני שאמרתי ונעשה רצוני."
        },
        {
          "s": 15,
          "text": "וכידוע המשל על זה מבן מלך שנתרחק מאביו המלך ועד שהי' בשבי' וכו',"
        },
        {
          "s": 16,
          "text": "דכשיוצא מהשבי' ובא לאביו המלך,"
        },
        {
          "s": 17,
          "text": "התענוג והשמחה שלהם"
        },
        {
          "s": 18,
          "text": "(של בן המלך ושל המלך)"
        },
        {
          "s": 19,
          "text": "הוא גדול הרבה יותר מהתענוג והשמחה שהי' קודם"
        },
        {
          "s": 20,
          "text": "(לפני שנתרחק)."
        },
        {
          "s": 21,
          "text": "דעיקר התענוג והשמחה הוא מקירוב שבא לאחרי הריחוק30."
        },
        {
          "s": 22,
          "text": "וג',"
        },
        {
          "s": 23,
          "text": "דעבודת התשובה היא בדרך דילוג שלא בסדר והדרגה31,"
        },
        {
          "s": 24,
          "text": "שמשתנה ונעשה מציאות חדשה."
        },
        {
          "s": 25,
          "text": "ובלשון הרמב\"ם32"
        },
        {
          "s": 26,
          "text": "\"אני אחר ואיני אותו האיש שעשה אותן המעשים\""
        },
        {
          "s": 27,
          "text": "[וע\"י חידוש זה"
        },
        {
          "s": 28,
          "text": "(דהאדם),"
        },
        {
          "s": 29,
          "text": "נעשה חידוש גם בעולם,"
        },
        {
          "s": 30,
          "text": "שזדונות נהפכים לזכיות33]."
        },
        {
          "s": 31,
          "text": "וגם מזה נעשה תענוג גדול למעלה,"
        },
        {
          "s": 32,
          "text": "דעיקר התענוג הוא מדבר חדש דוקא,"
        },
        {
          "s": 33,
          "text": "ולהעיר ממשל הידוע דצפור המדברת34."
        }
      ]
    }
  ]
}