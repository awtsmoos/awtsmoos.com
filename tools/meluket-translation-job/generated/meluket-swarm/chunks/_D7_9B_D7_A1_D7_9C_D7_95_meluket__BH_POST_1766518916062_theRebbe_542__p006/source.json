{
  "globalIndex": 407,
  "owner": 7,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518916062_theRebbe_542__p006",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518916062_theRebbe_542__p006",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518916062_theRebbe_542",
  "title": "מאמר פדה בשלום תשל\"א",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "ועל פי זה תובן גם השייכות של פדה בשלום נפשי גו'"
        },
        {
          "s": 1,
          "text": "[שההדגשה בזה מה שהפדי' היא בשלום דוקא]"
        },
        {
          "s": 2,
          "text": "להגאולה די\"ט כסלו"
        },
        {
          "s": 3,
          "text": "(התגלות דתורת החסידות),"
        },
        {
          "s": 4,
          "text": "דהנה מבואר בכ\"מ46"
        },
        {
          "s": 5,
          "text": "שענינה של תורת החסידות גילוי פנימיות התורה,"
        },
        {
          "s": 6,
          "text": "פנימית החכ' פנימית אבא"
        },
        {
          "s": 7,
          "text": "(הוא פנימית עתיק)"
        },
        {
          "s": 8,
          "text": "היא בחי' יחידה,"
        },
        {
          "s": 9,
          "text": "ומצד בחי' יחידה הנה גם כאשר ישנו בחי' רבים,"
        },
        {
          "s": 10,
          "text": "הפדי' היא בשלום47"
        },
        {
          "s": 11,
          "text": "(וי\"ל שזהו עוד יותר מהענין דעושה שלום במרומיו48"
        },
        {
          "s": 12,
          "text": "ע\"פ פירוש הרב המגיד49,"
        },
        {
          "s": 13,
          "text": "שזהו בדוגמת עוצם ביטול השר בבואו לפני המלך,"
        },
        {
          "s": 14,
          "text": "משא\"כ כאן שבטלו הרצונות מעיקרא),"
        },
        {
          "s": 15,
          "text": "שאין צריך למלחמה כלל,"
        },
        {
          "s": 16,
          "text": "ואדרבה העבודה היא דוקא בדרכי נועם ובדרכי שלום,"
        },
        {
          "s": 17,
          "text": "ועי\"ז נעשה"
        },
        {
          "s": 18,
          "text": "(כמו שמסיים באגה\"ק הנ\"ל)"
        },
        {
          "s": 19,
          "text": "שיהי' כמים הפנים וגו',"
        },
        {
          "s": 20,
          "text": "היינו כפי סיום הכתוב50"
        },
        {
          "s": 21,
          "text": "כן לב האדם לאדם,"
        },
        {
          "s": 22,
          "text": "שהכוונה בזה הוא גם לבחי' אדם העליון51,"
        },
        {
          "s": 23,
          "text": "שיהי' באור52"
        },
        {
          "s": 24,
          "text": "פני מלך חיים53,"
        },
        {
          "s": 25,
          "text": "שמצד זה יהי'"
        },
        {
          "s": 26,
          "text": "(כמרז\"ל54"
        },
        {
          "s": 27,
          "text": "עה\"פ פדה בשלום נפשי)"
        },
        {
          "s": 28,
          "text": "פדאני לי ולבני מבין אוה\"ע,"
        },
        {
          "s": 29,
          "text": "והוא שבקרוב ממש יהי' אתי מר דא מלכא משיחא,"
        },
        {
          "s": 30,
          "text": "ע\"י העבודה55"
        },
        {
          "s": 31,
          "text": "דיפוצו מעינותיך56"
        },
        {
          "s": 32,
          "text": "חוצה,"
        },
        {
          "s": 33,
          "text": "שבעיקר הותחלה57"
        },
        {
          "s": 34,
          "text": "לאחרי הגאולה די\"ט כסלו,"
        },
        {
          "s": 35,
          "text": "שמתוך מנוחה ושמחה וטוב לבב ובאופן של שלום תהי' היציאה בשלום מן הגלות בגאולה האמתית והשלימה ובקרוב ממש מהוי' שלום."
        }
      ]
    }
  ]
}