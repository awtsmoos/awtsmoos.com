{
  "globalIndex": 7,
  "owner": 7,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913707_theRebbe_562__p008",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913707_theRebbe_562__p008",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518913707_theRebbe_562",
  "title": "מאמר יבחר לנו את נחלתינו תשכ\"ג",
  "part": 8,
  "sections": [
    {
      "v": 21,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "ויש לומר,"
        },
        {
          "s": 3,
          "text": "דהטעם הפנימי על זה שבכל ר\"ה חוזרים כל הדברים לקדמותם,"
        },
        {
          "s": 4,
          "text": "הוא,"
        },
        {
          "s": 5,
          "text": "כי ע\"י שהמשכת המלכות"
        },
        {
          "s": 6,
          "text": "(גם המשכת המלכות שבשביל העולמות)"
        },
        {
          "s": 7,
          "text": "היא ע\"י אמרו לפני מלכיות,"
        },
        {
          "s": 8,
          "text": "הביטול שמצד עצם הנשמה שמגיע וממשיך את רצון המוחלט עצמו,"
        },
        {
          "s": 9,
          "text": "עי\"ז נמשך גילוי נעלה יותר גם בעולם."
        },
        {
          "s": 10,
          "text": "דהגם שבנוגע לעולמות הוא"
        },
        {
          "s": 11,
          "text": "(בעיקר)"
        },
        {
          "s": 12,
          "text": "המשכת הרצון גלוי,"
        },
        {
          "s": 13,
          "text": "מ\"מ,"
        },
        {
          "s": 14,
          "text": "כיון שהתעוררות והמשכת רצון הגלוי"
        },
        {
          "s": 15,
          "text": "(ע\"י אתעדל\"ת)"
        },
        {
          "s": 16,
          "text": "הוא ע\"י המשכת רצון המוחלט שע\"י הביטול שמצד עצם הנשמה,"
        },
        {
          "s": 17,
          "text": "נמשך מעין זה גם בעולם."
        },
        {
          "s": 18,
          "text": "ועי\"ז נשלמת הכוונה דבריאת העולמות,"
        },
        {
          "s": 19,
          "text": "שיהי' דירה לו ית' בתחתונים60."
        }
      ]
    },
    {
      "v": 22,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "וזהו יבחר לנו את נחלתינו את גאון יעקב,"
        },
        {
          "s": 3,
          "text": "שהבקשה דפסוק זה"
        },
        {
          "s": 4,
          "text": "(ועד\"ז בכללות המזמור)"
        },
        {
          "s": 5,
          "text": "שאומרים קודם תקיעת שופר היא,"
        },
        {
          "s": 6,
          "text": "שע\"י העבודה דתקיעת שופר תהי'"
        },
        {
          "s": 7,
          "text": "(נוסף על קיום המצוה דתקיעת שופר,"
        },
        {
          "s": 8,
          "text": "וענין התשובה דתקיעת שופר)"
        },
        {
          "s": 9,
          "text": "גם גילוי עצם הנשמה כמו שהיא מושרשת בהעצמות,"
        },
        {
          "s": 10,
          "text": "דזה שהנשמות מושרשות בהעצמות הוא לפי שכן בחר בבחירתו החפשית,"
        },
        {
          "s": 11,
          "text": "יבחר לנו."
        },
        {
          "s": 12,
          "text": "וממשיך את נחלתינו את גאון יעקב,"
        },
        {
          "s": 13,
          "text": "דגילוי ענין זה הוא בנקודת היהדות,"
        },
        {
          "s": 14,
          "text": "נחלתינו,"
        },
        {
          "s": 15,
          "text": "השורה בנקודת הלב שבכ\"א מישראל,"
        },
        {
          "s": 16,
          "text": "בית מקדשא דיעקב."
        },
        {
          "s": 17,
          "text": "וע\"פ המבואר לעיל"
        },
        {
          "s": 18,
          "text": "(סעיף יו\"ד)"
        },
        {
          "s": 19,
          "text": "שע\"י גילוי שרש הנשמות נמשך מעין גילוי זה גם בעולם שעי\"ז נשלמת הכוונה דדירה בתחתונים,"
        },
        {
          "s": 20,
          "text": "יש לבאר הקשר דהפירוש שגאון יעקב קאי על בית המקדש שבכ\"א מישראל עם הפירוש שקאי על ביהמ\"ק השלישי,"
        },
        {
          "s": 21,
          "text": "כי עיקר הענין דדירה בתחתונים יהי' בביהמ\"ק השלישי61"
        },
        {
          "s": 22,
          "text": "שיבנה במהרה בימינו ע\"י משיח צדקנו."
        }
      ]
    },
    {
      "v": 23,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "שנוסף על השייכות דהפסוק יבחר לנו גו' לכללות הענין דתקיעת שופר,"
        },
        {
          "s": 2,
          "text": "יש לו שייכות מיוחדת להפסוק"
        },
        {
          "s": 3,
          "text": "(שלאחריו)"
        },
        {
          "s": 4,
          "text": "עלה אלקים בתרועה הוי' בקול שופר,"
        },
        {
          "s": 5,
          "text": "שדרשו חז\"ל דע\"י שישראל נוטלין את שופריהן ותוקעין לפני הקב\"ה הוא עומד מכסא דין ויושב בכסא רחמים62."
        },
        {
          "s": 6,
          "text": "והענין הוא,"
        },
        {
          "s": 7,
          "text": "דהרחמים הנמשכים ע\"י אתעדל\"ת הם בהגבלה כפי האתעדל\"ת."
        },
        {
          "s": 8,
          "text": "והקשר דשני הפסוקים הוא,"
        },
        {
          "s": 9,
          "text": "דזה שישראל נוטלין את שופריהן ותוקעין הוא לא רק אתעדל\"ת אלא שעי\"ז מתגלה בחירת העצמות בישראל,"
        },
        {
          "s": 10,
          "text": "ולכן הרחמים הנמשכים עי\"ז הם רחמים בלי גבול."
        },
        {
          "s": 11,
          "text": "ונמשך מהקב\"ה עצמו"
        },
        {
          "s": 12,
          "text": "(מהעצמות)"
        },
        {
          "s": 13,
          "text": "לכאו\"א מישראל כתיבה וחתימה טובה לשנה טובה ומתוקה בטוב הנראה והנגלה."
        }
      ]
    }
  ]
}