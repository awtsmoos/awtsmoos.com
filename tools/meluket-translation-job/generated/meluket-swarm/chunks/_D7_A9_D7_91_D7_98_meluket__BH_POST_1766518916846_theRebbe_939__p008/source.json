{
  "globalIndex": 537,
  "owner": 37,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916846_theRebbe_939__p008",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916846_theRebbe_939__p008",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916846_theRebbe_939",
  "title": "מאמר באתי לגני תשל\"א",
  "part": 8,
  "sections": [
    {
      "v": 21,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "והנה נתבאר לעיל"
        },
        {
          "s": 2,
          "text": "(סעיף ו)"
        },
        {
          "s": 3,
          "text": "דבכוונת הצמצום שני ענינים."
        },
        {
          "s": 4,
          "text": "בשביל הגילוי,"
        },
        {
          "s": 5,
          "text": "ושע\"י הצמצום מתגלה ענין ההעלם"
        },
        {
          "s": 6,
          "text": "(שלמעלה מגילוי)"
        },
        {
          "s": 7,
          "text": "שמצד יכולת העצמות."
        },
        {
          "s": 8,
          "text": "ולהוסיף,"
        },
        {
          "s": 9,
          "text": "דמבואר בכ\"מ71"
        },
        {
          "s": 10,
          "text": "שגם בכוונת הצמצום בשביל הגילוי,"
        },
        {
          "s": 11,
          "text": "שני ענינים."
        },
        {
          "s": 12,
          "text": "שכוונת הצמצום היא בכדי שהגילוי דאוא\"ס שהאיר לפני הצמצום"
        },
        {
          "s": 13,
          "text": "(האור שהי' ממלא מקום החלל72)"
        },
        {
          "s": 14,
          "text": "יהי' גם בעולמות."
        },
        {
          "s": 15,
          "text": "דקודם הצמצום,"
        },
        {
          "s": 16,
          "text": "לא הי' אפשר להיות מציאות העולמות,"
        },
        {
          "s": 17,
          "text": "ובמילא לא הי' הגילוי בעולמות,"
        },
        {
          "s": 18,
          "text": "וע\"י הצמצום נתחדש שהגילוי דאוא\"ס יהי' גם בעולמות."
        },
        {
          "s": 19,
          "text": "ושע\"י הצמצום יהי' הגילוי דפנימיות ועצמות אוא\"ס שלמעלה מהאור שהי' ממלא מקום החלל."
        },
        {
          "s": 20,
          "text": "ומבואר שם,"
        },
        {
          "s": 21,
          "text": "דהאור שהי' ממלא מקום החלל הוא ההעלם דאור הקו"
        },
        {
          "s": 22,
          "text": "(היינו שהמשכת הקו מאור זה היא באופן דגילוי ההעלם),"
        },
        {
          "s": 23,
          "text": "(שרש)"
        },
        {
          "s": 24,
          "text": "אור הממלא,"
        },
        {
          "s": 25,
          "text": "והאור שלמעלה מהאור שהי' ממלא מקום החלל הוא"
        },
        {
          "s": 26,
          "text": "(שרש)"
        },
        {
          "s": 27,
          "text": "אור הסובב."
        },
        {
          "s": 28,
          "text": "וצריך להבין,"
        },
        {
          "s": 29,
          "text": "איך אפשר שיהי' בהעולם גילוי נעלה כזה שלא האיר אפילו קודם הצמצום,"
        },
        {
          "s": 30,
          "text": "ואעפ\"כ לא יתבטל העולם ממציאותו."
        }
      ]
    },
    {
      "v": 22,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "והנה ידועה תורת הרב המגיד73"
        },
        {
          "s": 2,
          "text": "עה\"פ74"
        },
        {
          "s": 3,
          "text": "עשה לך שתי חצוצרות כסף,"
        },
        {
          "s": 4,
          "text": "שהקב\"ה והאדם אתם קרויין אדם75"
        },
        {
          "s": 5,
          "text": "הם שתי חצוצרות,"
        },
        {
          "s": 6,
          "text": "שתי חצאי צורות."
        },
        {
          "s": 7,
          "text": "דאדם הוא אותיות אל\"ף ד\"ם76,"
        },
        {
          "s": 8,
          "text": "אל\"ף הוא הקב\"ה אלופו של עולם,"
        },
        {
          "s": 9,
          "text": "וד\"ם הוא האדם"
        },
        {
          "s": 10,
          "text": "[שהאדם מצד עצמו,"
        },
        {
          "s": 11,
          "text": "לפני שמתדבק בהקב\"ה,"
        },
        {
          "s": 12,
          "text": "הוא בחינת דם],"
        },
        {
          "s": 13,
          "text": "דזהו שארז\"ל77"
        },
        {
          "s": 14,
          "text": "מאי דכתיב78"
        },
        {
          "s": 15,
          "text": "לא תאכלו על הדם,"
        },
        {
          "s": 16,
          "text": "לא תאכלו קודם שתתפללו על דמכם,"
        },
        {
          "s": 17,
          "text": "כי האדם מצד עצמו"
        },
        {
          "s": 18,
          "text": "(לפני שמתדבק בהקב\"ה ע\"י התפלה)"
        },
        {
          "s": 19,
          "text": "הוא בחינת דם79."
        },
        {
          "s": 20,
          "text": "וכל אחד מהם"
        },
        {
          "s": 21,
          "text": "[האל\"ף זה הקב\"ה והד\"ם זה האדם]"
        },
        {
          "s": 22,
          "text": "הוא רק חצי צורה,"
        },
        {
          "s": 23,
          "text": "וכשמתדבקים יחד נעשה צורה שלימה,"
        },
        {
          "s": 24,
          "text": "אדם."
        },
        {
          "s": 25,
          "text": "ומבאר שם,"
        },
        {
          "s": 26,
          "text": "שההתחברות דהקב\"ה עם האדם הוא ע\"י שהקב\"ה עשה כמה צמצומים דרך כמה עולמות כדי שיהי' אחדות עם האדם."
        },
        {
          "s": 27,
          "text": "ועד\"ז הוא מצד האדם,"
        },
        {
          "s": 28,
          "text": "שבכדי שיתחבר עם הקב\"ה צריך הוא לפרוש את עצמו מכל הגשמיות עד שיעלה דרך כל העולמות ויהי' אחדות עם הקב\"ה עד שיבוטל במציאות80,"
        },
        {
          "s": 29,
          "text": "ואז יקרא אדם."
        },
        {
          "s": 30,
          "text": "ומבאר הצ\"צ81,"
        },
        {
          "s": 31,
          "text": "דזה שהקב\"ה עשה כמה צמצומים כו' והאדם צריך לפרוש את עצמו כו' הוא כמבואר בלקו\"ת ד\"ה תקעו השני82"
        },
        {
          "s": 32,
          "text": "שבכדי שיהי' החיבור דעליון ותחתון צריך העליון לירד למטה ממדריגתו והתחתון צריך לעלות למעלה ממדריגתו."
        },
        {
          "s": 33,
          "text": "ומבאר,"
        },
        {
          "s": 34,
          "text": "דזה שהקב\"ה עשה כמה צמצומים כו' הוא כי בא\"ס נאמר83"
        },
        {
          "s": 35,
          "text": "כי לא אדם הוא,"
        },
        {
          "s": 36,
          "text": "ובכדי להתלבש בעשר ספירות,"
        },
        {
          "s": 37,
          "text": "ציור אדם,"
        },
        {
          "s": 38,
          "text": "הוא ע\"י כמה צמצומים."
        },
        {
          "s": 39,
          "text": "ומוסיף,"
        },
        {
          "s": 40,
          "text": "דזה שהע\"ס הם בציור אדם הוא לפי שע\"ס הם ג' קוין84,"
        },
        {
          "s": 41,
          "text": "וגם לפי שע\"ס הם בדרך כלל מחשבה דיבור ומעשה,"
        },
        {
          "s": 42,
          "text": "א' ד' מ\"ם85."
        },
        {
          "s": 43,
          "text": "ומקשר זה עם ענין ג' בחינות אדם."
        },
        {
          "s": 44,
          "text": "ולכאורה הכוונה,"
        },
        {
          "s": 45,
          "text": "דזה שג' האותיות אד\"ם רומזים על מחשבה דיבור ומעשה,"
        },
        {
          "s": 46,
          "text": "הכוונה בזה היא לא רק לג' הבחינות מחשבה דיבור ומעשה שבע\"ס דאצילות,"
        },
        {
          "s": 47,
          "text": "אלא גם לג' בחינות אדם,"
        },
        {
          "s": 48,
          "text": "בי\"ע הכלליים"
        },
        {
          "s": 49,
          "text": "(א\"ק,"
        },
        {
          "s": 50,
          "text": "עתיק ואריך,"
        },
        {
          "s": 51,
          "text": "ואצילות)86,"
        },
        {
          "s": 52,
          "text": "שהם דוגמת מחשבה דיבור ומעשה87."
        },
        {
          "s": 53,
          "text": "ועפ\"ז,"
        },
        {
          "s": 54,
          "text": "זה שהקב\"ה עשה כמה צמצומים להתלבש בציור אדם,"
        },
        {
          "s": 55,
          "text": "הכוונה בזה היא להצמצומים שעל ידם היא ההמשכה לבי\"ע הכלליים,"
        },
        {
          "s": 56,
          "text": "שהם שלשה מיני צמצומים עצומים כלליים88."
        },
        {
          "s": 57,
          "text": "דכל צמצומים אלו הם בכדי שתהי' ההמשכה בציור אדם העליון."
        },
        {
          "s": 58,
          "text": "ולאח\"ז,"
        },
        {
          "s": 59,
          "text": "בכדי שתהי' ההמשכה מאצילות לבי\"ע,"
        },
        {
          "s": 60,
          "text": "הוא ע\"י הפרסא."
        },
        {
          "s": 61,
          "text": "וכמ\"ש בתורת הה\"מ הנ\"ל בפירוש הכתוב89"
        },
        {
          "s": 62,
          "text": "ועל דמות הכסא,"
        },
        {
          "s": 63,
          "text": "שהוא ית' מכוסה שם,"
        },
        {
          "s": 64,
          "text": "ומבאר הצ\"צ81,"
        },
        {
          "s": 65,
          "text": "דכסא"
        },
        {
          "s": 66,
          "text": "(מלשון כיסוי)"
        },
        {
          "s": 67,
          "text": "הוא הפרסא שהיא דוגמת המשל שמכסה ומסתיר90"
        },
        {
          "s": 68,
          "text": "על השכל שבתוכו."
        },
        {
          "s": 69,
          "text": "וצריך להבין,"
        },
        {
          "s": 70,
          "text": "דכיון שהחיבור דאוא\"ס עם האדם הוא ע\"י כמה וכמה צמצומים וגם ע\"י פרסא,"
        },
        {
          "s": 71,
          "text": "איך שייך שהאדם ע\"י עבודתו ימשיך גילוי שלמעלה מהצמצום."
        }
      ]
    },
    {
      "v": 23,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "והענין הוא,"
        },
        {
          "s": 3,
          "text": "דכתיב91"
        },
        {
          "s": 4,
          "text": "ועבדתם את הוי' אלקיכם,"
        },
        {
          "s": 5,
          "text": "ומדייק אדמו\"ר מהר\"ש92,"
        },
        {
          "s": 6,
          "text": "דענין עבודה הוא תיקון ושירות מה שהעבד עובד ומתקן לרבו,"
        },
        {
          "s": 7,
          "text": "וכיון שהוא ית' הוא שלימותא דכולא93,"
        },
        {
          "s": 8,
          "text": "איך שייך ענין העבודה בנוגע למעלה."
        },
        {
          "s": 9,
          "text": "ומבאר94,"
        },
        {
          "s": 10,
          "text": "דבאמת אין שייך לומר שהעבודה היא צורך גבוה ע\"ד שירות העבד לרבו,"
        },
        {
          "s": 11,
          "text": "אלא שעלה ברצונו ית' שיתאוה להיות לו דירה בתחתונים,"
        },
        {
          "s": 12,
          "text": "ושזה יהי' ע\"י עבודת האדם."
        },
        {
          "s": 13,
          "text": "ומבאר שם,"
        },
        {
          "s": 14,
          "text": "דעיקר ענין העבודה הוא כשעושה היפך רצונו,"
        },
        {
          "s": 15,
          "text": "אתכפיא."
        },
        {
          "s": 16,
          "text": "וכדאיתא בגמרא95"
        },
        {
          "s": 17,
          "text": "עה\"פ96"
        },
        {
          "s": 18,
          "text": "ושבתם וראיתם גו' בין עובד אלקים לאשר לא עבדו,"
        },
        {
          "s": 19,
          "text": "דכששונה פרקו מאה פעמים נק' לא עבדו כי לימוד התורה שלו הוא כפי הרגילות"
        },
        {
          "s": 20,
          "text": "(שבימיהם הי' הרגילות לשנות כל פרק מאה פעמים),"
        },
        {
          "s": 21,
          "text": "וכששונה פרקו מאה פעמים ואחד,"
        },
        {
          "s": 22,
          "text": "שינוי הרגילות,"
        },
        {
          "s": 23,
          "text": "אתכפיא,"
        },
        {
          "s": 24,
          "text": "נק' עובד אלקים."
        },
        {
          "s": 25,
          "text": "וזהו גם שעבודה הוא מלשון עורות עבודים,"
        },
        {
          "s": 26,
          "text": "כי עיבוד עורות הוא ע\"י שדורכים אותם97."
        },
        {
          "s": 27,
          "text": "וזהו היתרון דאתכפיא לגבי אתהפכא,"
        },
        {
          "s": 28,
          "text": "כי ענין העבודה הוא שמייגע עצמו נגד טבעו98."
        },
        {
          "s": 29,
          "text": "ומבאר שם,"
        },
        {
          "s": 30,
          "text": "שזהו גם המעלה שבתשובה,"
        },
        {
          "s": 31,
          "text": "כדאיתא בתדב\"א99"
        },
        {
          "s": 32,
          "text": "בנוגע לבעל תשובה,"
        },
        {
          "s": 33,
          "text": "הי' רגיל לקרות דף אחד יקרא ב' דפים,"
        },
        {
          "s": 34,
          "text": "לשנות פרק אחד ישנה ב' פרקים."
        }
      ]
    }
  ]
}