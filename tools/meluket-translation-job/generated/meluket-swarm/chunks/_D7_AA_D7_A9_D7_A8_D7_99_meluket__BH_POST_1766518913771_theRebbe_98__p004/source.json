{
  "globalIndex": 16,
  "owner": 16,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913771_theRebbe_98__p004",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913771_theRebbe_98__p004",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518913771_theRebbe_98",
  "title": "מאמר יו\"ט של ר\"ה תשל\"ג",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ויש לקשר זה עם מ\"ש הצ\"צ41"
        },
        {
          "s": 1,
          "text": "דשבועה היא בבינה ביסוד ובמלכות,"
        },
        {
          "s": 2,
          "text": "דזה ששבועה היא בבינה שייך להשבועה עצמה,"
        },
        {
          "s": 3,
          "text": "המשכת עתיק"
        },
        {
          "s": 4,
          "text": "[ועד\"ז המשכת שרש הנשמה],"
        },
        {
          "s": 5,
          "text": "דבבינה הוא גילוי עתיק42."
        },
        {
          "s": 6,
          "text": "כמ\"ש43"
        },
        {
          "s": 7,
          "text": "ונהר יוצא מעדן,"
        },
        {
          "s": 8,
          "text": "דנהר הוא בינה ועדן הוא עתיק,"
        },
        {
          "s": 9,
          "text": "ופירוש נהר יוצא מעדן הוא שבבינה הוא גילוי עתיק."
        },
        {
          "s": 10,
          "text": "וזה ששבועה היא במלכות שייך להשובע דשבועה,"
        },
        {
          "s": 11,
          "text": "דזה שהשבועה משפעת ונותנת כח בהנשמה שבהגוף הוא ע\"י שההמשכה היא במלכות,"
        },
        {
          "s": 12,
          "text": "וזה ששבועה היא ביסוד,"
        },
        {
          "s": 13,
          "text": "הוא,"
        },
        {
          "s": 14,
          "text": "שהמשכת הבינה"
        },
        {
          "s": 15,
          "text": "(ועתיק שבה)"
        },
        {
          "s": 16,
          "text": "במלכות היא ע\"י היסוד."
        },
        {
          "s": 17,
          "text": "וזהו גם הקשר עם הפירוש השלישי במשביעין אותו שהוא מלשון שבע,"
        },
        {
          "s": 18,
          "text": "דלפי ביאור אחד קאי זה על היסוד,"
        },
        {
          "s": 19,
          "text": "שהוא שביעי מהבינה44."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יובן הקשר של השבועה שמשביעין אותו תהי צדיק עם חודש השביעי,"
        },
        {
          "s": 2,
          "text": "ירחא דשבועתא,"
        },
        {
          "s": 3,
          "text": "כי זה שבריאת האדם היתה ביום הששי למעשה בראשית,"
        },
        {
          "s": 4,
          "text": "יום הראשון דחודש השביעי,"
        },
        {
          "s": 5,
          "text": "הוא מפני שני טעמים45."
        },
        {
          "s": 6,
          "text": "להיותו אחור למעשה בראשית46,"
        },
        {
          "s": 7,
          "text": "דשרש הדצ\"ח הוא מתוהו ושרש האדם הוא מתיקון שלמטה מתוהו."
        },
        {
          "s": 8,
          "text": "ולהיותו קודם למעשה בראשית46"
        },
        {
          "s": 9,
          "text": "(קדום במעלה),"
        },
        {
          "s": 10,
          "text": "כדאיתא בגמרא47,"
        },
        {
          "s": 11,
          "text": "דזה שהאדם נברא בסוף הוא כדי שיכנס לסעודה מיד,"
        },
        {
          "s": 12,
          "text": "שזה מורה על מעלת האדם,"
        },
        {
          "s": 13,
          "text": "שכל הבריאה היא בשביל האדם."
        },
        {
          "s": 14,
          "text": "דגם התהוות התוהו שקדם לתיקון הוא בכדי שיהי' בירור התוהו ע\"י עבודת האדם,"
        },
        {
          "s": 15,
          "text": "כנ\"ל."
        },
        {
          "s": 16,
          "text": "וזהו מה שאומרים על היום דראש השנה זה היום תחלת מעשיך48,"
        },
        {
          "s": 17,
          "text": "אף שבריאת העולם היתה בכ\"ה באלול49,"
        },
        {
          "s": 18,
          "text": "כי50"
        },
        {
          "s": 19,
          "text": "הכוונה בבריאת העולם היא שהאדם ע\"י עבודתו יעשה את העולם דירה לו ית',"
        },
        {
          "s": 20,
          "text": "וענין זה הותחל ביום ברוא האדם."
        },
        {
          "s": 21,
          "text": "דנוסף לזה שאז דוקא נעשית האפשרות להשלים כוונה זו,"
        },
        {
          "s": 22,
          "text": "נעשה אז כן גם בפועל,"
        },
        {
          "s": 23,
          "text": "כמארז\"ל51"
        },
        {
          "s": 24,
          "text": "שאדם הראשון"
        },
        {
          "s": 25,
          "text": "(ביום שנברא)"
        },
        {
          "s": 26,
          "text": "הכריז לכל הברואים בואו52"
        },
        {
          "s": 27,
          "text": "נשתחוה ונכרעה נברכה לפני ה' עושנו,"
        },
        {
          "s": 28,
          "text": "וכולם ענו ואמרו ה'53"
        },
        {
          "s": 29,
          "text": "מלך גאות לבש."
        },
        {
          "s": 30,
          "text": "וזהו שחודש השביעי"
        },
        {
          "s": 31,
          "text": "(שבו נברא האדם)"
        },
        {
          "s": 32,
          "text": "הוא ירחא דשבועתא,"
        },
        {
          "s": 33,
          "text": "כי הכח שיש באדם לפעול בהעולם,"
        },
        {
          "s": 34,
          "text": "אף שבגילוי האדם הוא אחור למעשה בראשית,"
        },
        {
          "s": 35,
          "text": "הוא ע\"י גילוי שרשו האמיתי של האדם,"
        },
        {
          "s": 36,
          "text": "שהוא קדם למעשה בראשית,"
        },
        {
          "s": 37,
          "text": "וגילוי זה הוא ע\"י השבועה"
        },
        {
          "s": 38,
          "text": "(כנ\"ל בארוכה),"
        },
        {
          "s": 39,
          "text": "ירחא דשבועתא."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ועד\"ז הוא בראש השנה שבכל שנה ושנה,"
        },
        {
          "s": 1,
          "text": "שאז מכתירין ישראל"
        },
        {
          "s": 2,
          "text": "[שקרויין אדם,"
        },
        {
          "s": 3,
          "text": "לפי שבכ\"א מישראל יש ניצוץ מנשמת אדם הראשון,"
        },
        {
          "s": 4,
          "text": "כנ\"ל סעיף ג]"
        },
        {
          "s": 5,
          "text": "את הקב\"ה למלך עליהם ועל כל העולם,"
        },
        {
          "s": 6,
          "text": "שעי\"ז עושים את העולם דירה לו ית',"
        },
        {
          "s": 7,
          "text": "ובכל שנה ושנה ההכתרה ועשיית הדירה שעי\"ז הם באופן נעלה יותר,"
        },
        {
          "s": 8,
          "text": "שהכח שבכאו\"א מישראל על זה הוא ע\"י שבכל ראש השנה,"
        },
        {
          "s": 9,
          "text": "התחלת ירחא דשבועתא,"
        },
        {
          "s": 10,
          "text": "נמשכת מחדש השבועה שמשביעין את כאו\"א מישראל תהי צדיק."
        },
        {
          "s": 11,
          "text": "ויש לומר,"
        },
        {
          "s": 12,
          "text": "דע\"י שאמר אדמו\"ר הזקן את הדרוש משביעין אותו תהי צדיק בראש השנה,"
        },
        {
          "s": 13,
          "text": "אמירת תורה"
        },
        {
          "s": 14,
          "text": "(תורה אור),"
        },
        {
          "s": 15,
          "text": "המשכת השבועה בראש השנה היא בגילוי עוד יותר."
        }
      ]
    }
  ]
}