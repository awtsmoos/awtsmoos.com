{
  "globalIndex": 760,
  "owner": 10,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918225_theRebbe_77__p002",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918225_theRebbe_77__p002",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518918225_theRebbe_77",
  "title": "מאמר הפך ים ליבשה תשכ\"ז",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "והנה בקריעת ים סוף כתיב13"
        },
        {
          "s": 1,
          "text": "לגוזר ים סוף לגזרים כי לעולם חסדו והעביר ישראל בתוכו כי לעולם חסדו,"
        },
        {
          "s": 2,
          "text": "דמאומרו ב' פעמים כי לעולם חסדו מוכח שכל ענין משני אלה הוא חסד בפ\"ע."
        },
        {
          "s": 3,
          "text": "וכמ\"ש בהגדה כמה מעלות טובות למקום עלינו כו' קרע לנו את הים"
        },
        {
          "s": 4,
          "text": "(ועוד מעלה)"
        },
        {
          "s": 5,
          "text": "והעבירנו בתוכו בחרבה14."
        },
        {
          "s": 6,
          "text": "ולכאורה אינו מובן,"
        },
        {
          "s": 7,
          "text": "דהלא כל ענין קריעת ים סוף הוא בשביל שיהי' והעביר ישראל בתוכו."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדם15"
        },
        {
          "s": 2,
          "text": "ביאור אדמו\"ר האמצעי במאמרו הידוע ד\"ה בוקע ים כו' להבין ענין קריעת ים סוף16,"
        },
        {
          "s": 3,
          "text": "שהענין דים ויבשה ישנו בכל הבחינות והדרגות מלמעלה מעלה עד למטה מטה."
        },
        {
          "s": 4,
          "text": "ומבאר זה ע\"פ משל"
        },
        {
          "s": 5,
          "text": "(שצ\"ל להיות דומה וקרוב להנמשל17)"
        },
        {
          "s": 6,
          "text": "מהענין דים ויבשה כמו שהם למטה בגשמיות."
        },
        {
          "s": 7,
          "text": "דהנה,"
        },
        {
          "s": 8,
          "text": "אמרו רז\"ל18"
        },
        {
          "s": 9,
          "text": "כל מה שיש ביבשה יש בים,"
        },
        {
          "s": 10,
          "text": "ומ\"מ יש הפרש בין הברואים שביבשה להברואים שבים,"
        },
        {
          "s": 11,
          "text": "שהברואים שבים מכוסים במי הים עד שלא ניכרת מציאותם לעין כל,"
        },
        {
          "s": 12,
          "text": "וגם הם עצמם מרגישים שהים הוא מקום חיותם19,"
        },
        {
          "s": 13,
          "text": "וכיון שעולין ליבשה מיד מתים20."
        },
        {
          "s": 14,
          "text": "משא\"כ ברואים שביבשה,"
        },
        {
          "s": 15,
          "text": "הנה אף שהכל הי' מן העפר21,"
        },
        {
          "s": 16,
          "text": "הרי אופן הגידול דצומח הוא"
        },
        {
          "s": 17,
          "text": "(לא באופן שמכוסה בתוך העפר,"
        },
        {
          "s": 18,
          "text": "אלא)"
        },
        {
          "s": 19,
          "text": "מחוץ להעפר,"
        },
        {
          "s": 20,
          "text": "על פני האדמה דוקא,"
        },
        {
          "s": 21,
          "text": "ועאכו\"כ מין החי שאפילו אינו מחובר אל העפר"
        },
        {
          "s": 22,
          "text": "(כמו הצומח),"
        },
        {
          "s": 23,
          "text": "וכן האדם,"
        },
        {
          "s": 24,
          "text": "שהוא שלימות הבריאה,"
        },
        {
          "s": 25,
          "text": "אף שנברא עפר מן האדמה22,"
        },
        {
          "s": 26,
          "text": "וכל פרטי הצטרכותו כמו אכילה ושתי' ודומיהן הם מן העפר,"
        },
        {
          "s": 27,
          "text": "הרי הוא דבר נפרד מן העפר ולמעלה ממנו,"
        },
        {
          "s": 28,
          "text": "על פני האדמה דוקא."
        },
        {
          "s": 29,
          "text": "וסיבת החילוק בין הברואים שבים לברואים שביבשה תלוי' באופן ההמשכה ממקורם."
        },
        {
          "s": 30,
          "text": "והיינו,"
        },
        {
          "s": 31,
          "text": "שברואים שבים מקבלים חיותם ממקורם באופן של קירוב,"
        },
        {
          "s": 32,
          "text": "היינו,"
        },
        {
          "s": 33,
          "text": "שהמקור הוא בגילוי אליהם,"
        },
        {
          "s": 34,
          "text": "ומשום זה מרגישים הם את מקור חיותם ובטלים אליו להיות מכוסים במים."
        },
        {
          "s": 35,
          "text": "משא\"כ ברואים שביבשה מקבלים חיותם ממקורם באופן של ריחוק,"
        },
        {
          "s": 36,
          "text": "היינו,"
        },
        {
          "s": 37,
          "text": "שהמקור הוא בהעלם והסתר מהם,"
        },
        {
          "s": 38,
          "text": "ולכן,"
        },
        {
          "s": 39,
          "text": "לא זו בלבד שאינם מכוסים בעפר,"
        },
        {
          "s": 40,
          "text": "אלא עוד זאת,"
        },
        {
          "s": 41,
          "text": "שנדמה להם שהם מציאות בפ\"ע."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "והנמשל מזה בהחילוק שבין ים ליבשה למעלה,"
        },
        {
          "s": 1,
          "text": "דהנה23,"
        },
        {
          "s": 2,
          "text": "ים קאי על עלמין סתימין דלא אתגליין,"
        },
        {
          "s": 3,
          "text": "עלמא דאתכסייא,"
        },
        {
          "s": 4,
          "text": "שהברואים שבהם בטלים למקור חיותם שנרגש בהם בגילוי,"
        },
        {
          "s": 5,
          "text": "כמו מלאכים עליונים,"
        },
        {
          "s": 6,
          "text": "שהחיות שלהם הוא הביטול לאלקות,"
        },
        {
          "s": 7,
          "text": "כמ\"ש24"
        },
        {
          "s": 8,
          "text": "יראת הוי' לחיים,"
        },
        {
          "s": 9,
          "text": "והביטול שלהם הוא באופן שאינם מציאות לעצמם כלל,"
        },
        {
          "s": 10,
          "text": "אלא כל מציאותם היא המציאות דאלקות,"
        },
        {
          "s": 11,
          "text": "שלכן מצינו במלאכים עליונים שאומרים בי נשבעתי גו'25,"
        },
        {
          "s": 12,
          "text": "לבלתי הפכי גו'26"
        },
        {
          "s": 13,
          "text": "וכיו\"ב,"
        },
        {
          "s": 14,
          "text": "דלכאורה אינו מובן,"
        },
        {
          "s": 15,
          "text": "הרי מלאך הוא נברא,"
        },
        {
          "s": 16,
          "text": "ואיך יכול לומר על עצמו לשון שמורה על אלקות,"
        },
        {
          "s": 17,
          "text": "אלא,"
        },
        {
          "s": 18,
          "text": "להיות שאינו מציאות לעצמו כלל,"
        },
        {
          "s": 19,
          "text": "וכל מציאותו היא המציאות דאלקות,"
        },
        {
          "s": 20,
          "text": "יכול לומר על עצמו לשון שמורה על אלקות27."
        },
        {
          "s": 21,
          "text": "וכן הוא בנשמות קודם ירידתם למטה,"
        },
        {
          "s": 22,
          "text": "שעומדים בביטול תמידי לאלקות,"
        },
        {
          "s": 23,
          "text": "כמ\"ש28"
        },
        {
          "s": 24,
          "text": "חי הוי' אשר עמדתי לפניו,"
        },
        {
          "s": 25,
          "text": "ואין עמידה אלא תפלה29,"
        },
        {
          "s": 26,
          "text": "שעומדים תמיד בביטול לאלקות,"
        },
        {
          "s": 27,
          "text": "ואינם מציאות בפ\"ע,"
        },
        {
          "s": 28,
          "text": "בדוגמת דגים שבים שבטלים בתכלית לגבי הים."
        },
        {
          "s": 29,
          "text": "ויבשה קאי על עלמין דאתגליין,"
        },
        {
          "s": 30,
          "text": "שהברואים שבהם נראים מציאות בפ\"ע,"
        },
        {
          "s": 31,
          "text": "ועד למציאות של דבר נפרד,"
        },
        {
          "s": 32,
          "text": "שמזה יכול להשתלשל מציאות דבר שמעלים ומסתיר ומנגד לאלקות,"
        },
        {
          "s": 33,
          "text": "ועד שיכול לומר אני ואפסי עוד30."
        },
        {
          "s": 34,
          "text": "וסיבת החילוק בין הברואים שבעלמא דאתכסייא להברואים שבעלמא דאתגלייא,"
        },
        {
          "s": 35,
          "text": "תלוי' באופן ההמשכה ממקורם,"
        },
        {
          "s": 36,
          "text": "ספירת המלכות,"
        },
        {
          "s": 37,
          "text": "שהיא מקור ההתהוות דכל העולמות והנבראים,"
        },
        {
          "s": 38,
          "text": "כמ\"ש31"
        },
        {
          "s": 39,
          "text": "מלכותך מלכות כל עולמים."
        },
        {
          "s": 40,
          "text": "דהנה32,"
        },
        {
          "s": 41,
          "text": "ספירת המלכות נקראת לפעמים בשם ים,"
        },
        {
          "s": 42,
          "text": "ולפעמים נקראת בשם יבשה."
        },
        {
          "s": 43,
          "text": "כשספירת המלכות עולה למעלה לקבל מבחי' חכמה ובינה שנקראים בשם ים,"
        },
        {
          "s": 44,
          "text": "כי י' דים קאי על חכמה,"
        },
        {
          "s": 45,
          "text": "וים בגימטריא חמישים רומז על חמישים שערי בינה,"
        },
        {
          "s": 46,
          "text": "אזי נקראת גם היא בשם ים,"
        },
        {
          "s": 47,
          "text": "כמ\"ש33"
        },
        {
          "s": 48,
          "text": "והים עליהם מלמעלה גו',"
        },
        {
          "s": 49,
          "text": "וממנה מתהווים עלמין סתימין שהברואים שבהם נקראים נוני ימא."
        },
        {
          "s": 50,
          "text": "וכשהמלכות יורדת למטה כו',"
        },
        {
          "s": 51,
          "text": "שאז מקבלת מבחינות שלמטה מחו\"ב,"
        },
        {
          "s": 52,
          "text": "חו\"ג וכו',"
        },
        {
          "s": 53,
          "text": "אזי נקראת בשם יבשה וארץ,"
        },
        {
          "s": 54,
          "text": "כמ\"ש34"
        },
        {
          "s": 55,
          "text": "והארץ הדום רגלי,"
        },
        {
          "s": 56,
          "text": "וממנה מתהווים עלמין דאתגליין שהברואים שבהם נראים ליש ודבר נפרד בפ\"ע."
        }
      ]
    }
  ]
}