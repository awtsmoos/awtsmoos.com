{
  "globalIndex": 656,
  "owner": 6,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917627_theRebbe_329__p004",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917627_theRebbe_329__p004",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917627_theRebbe_329",
  "title": "מאמר החודש הזה לכם תשל\"ה",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יש לבאר התיווך דשני פסקי הדינים בנוגע להגאולה,"
        },
        {
          "s": 2,
          "text": "שאין ישראל נגאלין אלא בתשובה ושבניסן עתידין ליגאל,"
        },
        {
          "s": 3,
          "text": "כי זה שישראל עושין תשובה בסוף גלותן"
        },
        {
          "s": 4,
          "text": "[שבגלות עצמו,"
        },
        {
          "s": 5,
          "text": "עיקר ההעלם וההסתר דהגלות הוא בסופו],"
        },
        {
          "s": 6,
          "text": "הוא באופן שנרגש בהם,"
        },
        {
          "s": 7,
          "text": "דזה שעושין תשובה הוא לא מצד ציור המציאות של האדם העושה תשובה51"
        },
        {
          "s": 8,
          "text": "אלא מפני שהבטיחה תורה שבסוף הגלות יעשו תשובה."
        },
        {
          "s": 9,
          "text": "בחינת ניסן,"
        },
        {
          "s": 10,
          "text": "בת,"
        },
        {
          "s": 11,
          "text": "שאין לו משל עצמו כלום והוא מקבל מלמעלה."
        },
        {
          "s": 12,
          "text": "והגם שהתשובה היא ברצונו ובבחירתו52,"
        },
        {
          "s": 13,
          "text": "וכלשון הרמב\"ם שסוף ישראל לעשות תשובה,"
        },
        {
          "s": 14,
          "text": "עשי' ועבודה דישראל"
        },
        {
          "s": 15,
          "text": "[ודלא כההתעוררות תשובה הבאה ע\"י הכרוזים שמלמעלה53],"
        },
        {
          "s": 16,
          "text": "מ\"מ עשיית התשובה דישראל שבסוף הגלות היא לא מצד הציור שלהם מצד עצמם,"
        },
        {
          "s": 17,
          "text": "אלא מפני שהבטחת התורה פועלת עליהם שיעשו תשובה."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דזהו מה שישראל עושין תשובה ומיד הן נגאלין32,"
        },
        {
          "s": 2,
          "text": "דכאשר עשיית התשובה היא מצד האדם עצמו"
        },
        {
          "s": 3,
          "text": "(שהוא במצב וציור כזה ששייך לתשובה),"
        },
        {
          "s": 4,
          "text": "הגם שתשובה בכלל היא באופן דדילוג54"
        },
        {
          "s": 5,
          "text": "מ\"מ יש בה איזה סדר והדרגה."
        },
        {
          "s": 6,
          "text": "דכיון שהאדם הוא מוגבל,"
        },
        {
          "s": 7,
          "text": "גם בהדילוג שלו יש סדר55."
        },
        {
          "s": 8,
          "text": "שבתחלה הוא בא לתשובה תתאה ואח\"כ לתשובה עילאה55"
        },
        {
          "s": 9,
          "text": "ועד שהוא נגאל לגמרי מהמצב"
        },
        {
          "s": 10,
          "text": "(גלות)"
        },
        {
          "s": 11,
          "text": "שהי' לפני התשובה."
        },
        {
          "s": 12,
          "text": "וזה שישראל עושין תשובה בסוף גלותן ומיד הן נגאלין,"
        },
        {
          "s": 13,
          "text": "הוא,"
        },
        {
          "s": 14,
          "text": "לפי שעשיית תשובה זו היא באופן דבת"
        },
        {
          "s": 15,
          "text": "(מצד הבטחת התורה),"
        },
        {
          "s": 16,
          "text": "שהביטול דבת מגיע בעצמות אוא\"ס שלמעלה מהשתלשלות"
        },
        {
          "s": 17,
          "text": "(כנ\"ל סעיף ה),"
        },
        {
          "s": 18,
          "text": "ולכן,"
        },
        {
          "s": 19,
          "text": "התשובה דבת היא למעלה מסדר והדרגה"
        },
        {
          "s": 20,
          "text": "(למעלה גם מהסדר דדילוג)."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "והנה זה שהבטחת התורה פועלת על האדם שיעשה תשובה מעצמו,"
        },
        {
          "s": 2,
          "text": "הוא חיבור דניסן ותשרי."
        },
        {
          "s": 3,
          "text": "דזה שהתשובה"
        },
        {
          "s": 4,
          "text": "(שבסוף הגלות)"
        },
        {
          "s": 5,
          "text": "היא שישראל עושין תשובה בכח עצמם,"
        },
        {
          "s": 6,
          "text": "מלמטה למעלה"
        },
        {
          "s": 7,
          "text": "[ודלא כביציאת מצרים,"
        },
        {
          "s": 8,
          "text": "שחפצם של ישראל לצאת מטומאת מצרים ולדבקה בו ית' היתה מצד הגילוי מלמעלה,"
        },
        {
          "s": 9,
          "text": "שלכן יציאתם ממצרים היתה באופן דכי56"
        },
        {
          "s": 10,
          "text": "ברח העם57],"
        },
        {
          "s": 11,
          "text": "הוא הענין והמעלה דתשרי."
        },
        {
          "s": 12,
          "text": "וזה שעשיית התשובה היא מצד הבטחת התורה,"
        },
        {
          "s": 13,
          "text": "שלכן היא באופן דמיד הן נגאלין,"
        },
        {
          "s": 14,
          "text": "למעלה מסדר והדרגה,"
        },
        {
          "s": 15,
          "text": "הוא המעלה דניסן."
        },
        {
          "s": 16,
          "text": "וכמשנת\"ל"
        },
        {
          "s": 17,
          "text": "(סעיף ב)"
        },
        {
          "s": 18,
          "text": "שהמעלה דניסן לגבי תשרי הוא שבניסן הוא המשכת אור הבל\"ג."
        },
        {
          "s": 19,
          "text": "ויש לומר,"
        },
        {
          "s": 20,
          "text": "דזה שבניסן דוקא עתידין ליגאל,"
        },
        {
          "s": 21,
          "text": "אף שבהתשובה שבסוף הגלות"
        },
        {
          "s": 22,
          "text": "(שעל ידה תבוא הגאולה)"
        },
        {
          "s": 23,
          "text": "ישנם שני הענינים והמעלות,"
        },
        {
          "s": 24,
          "text": "דניסן ודתשרי,"
        },
        {
          "s": 25,
          "text": "הוא,"
        },
        {
          "s": 26,
          "text": "כי הכח להחיבור דתשרי וניסן בעבודת האדם הוא כי תכלית58"
        },
        {
          "s": 27,
          "text": "הכוונה בהבריאה דתשרי"
        },
        {
          "s": 28,
          "text": "(בראשית ברא)"
        },
        {
          "s": 29,
          "text": "שאז נברא העולם במדידה והגבלה הוא בכדי שע\"י העבודה דתומ\"צ יהי' בו הגילוי דניסן"
        },
        {
          "s": 30,
          "text": "(החודש הזה לכם)."
        },
        {
          "s": 31,
          "text": "וזהו שהמחשבה לברוא את העולם היתה בניסן,"
        },
        {
          "s": 32,
          "text": "שהמחשבה היא הכוונה והתכלית של העשי' שלאחרי המחשבה"
        },
        {
          "s": 33,
          "text": "(כנ\"ל סעיף ב),"
        },
        {
          "s": 34,
          "text": "כי הכוונה והתכלית דבריאת העולם דתשרי"
        },
        {
          "s": 35,
          "text": "(מדידה והגבלה)"
        },
        {
          "s": 36,
          "text": "הוא שיהי' בו הגילוי דניסן שלמעלה מהגבלה."
        },
        {
          "s": 37,
          "text": "אלא שבכדי שתושלם הכוונה שגם בהגבול יהי' גילוי הבל\"ג היתה הבריאה בפועל באופן שבגילוי לא הי' נרגש בה הכוונה."
        },
        {
          "s": 38,
          "text": "שעי\"ז נברא עולם מוגבל."
        },
        {
          "s": 39,
          "text": "וע\"י מעשינו ועבודתינו ובפרט בזמן הגלות,"
        },
        {
          "s": 40,
          "text": "מתגלה שהפנימיות"
        },
        {
          "s": 41,
          "text": "(הכוונה והתכלית)"
        },
        {
          "s": 42,
          "text": "דהגבול שנברא בתשרי הוא שיהי' בו גילוי הבל\"ג."
        },
        {
          "s": 43,
          "text": "וזהו שעשיית התשובה שבסוף הגלות"
        },
        {
          "s": 44,
          "text": "(עשיית ופעולת האדם שנברא בתשרי,"
        },
        {
          "s": 45,
          "text": "גבול)"
        },
        {
          "s": 46,
          "text": "היא באופן דבל\"ג"
        },
        {
          "s": 47,
          "text": "(ניסן),"
        },
        {
          "s": 48,
          "text": "כי ע\"י מעשינו ועבודתינו מתגלה שענינו הפנימי דהגבול שנברא בתשרי הוא הבל\"ג דניסן."
        },
        {
          "s": 49,
          "text": "וזהו בניסן עתידין ליגאל,"
        },
        {
          "s": 50,
          "text": "כי אז יתגלה שגם הגבול דתשרי,"
        },
        {
          "s": 51,
          "text": "פנימיותו הוא הבל\"ג דניסן."
        }
      ]
    }
  ]
}