{
  "globalIndex": 699,
  "owner": 49,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917894_theRebbe_634__p002",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917894_theRebbe_634__p002",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917894_theRebbe_634",
  "title": "מאמר כימי צאתך תשי\"ב",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה ידוע הדיוק13"
        },
        {
          "s": 2,
          "text": "מ\"ש כימי צאתך מארץ מצרים,"
        },
        {
          "s": 3,
          "text": "כימי לשון רבים,"
        },
        {
          "s": 4,
          "text": "הרי יציאת מצרים היתה ביום אחד"
        },
        {
          "s": 5,
          "text": "[ובזכירת יציאת מצרים כתיב זכור את היום הזה אשר יצאתם ממצרים14,"
        },
        {
          "s": 6,
          "text": "למען תזכור את יום צאתך מארץ מצרים15],"
        },
        {
          "s": 7,
          "text": "ולמה נאמר כימי לשון רבים."
        },
        {
          "s": 8,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 9,
          "text": "דביציאת מצרים נכלל גם קריעת ים סוף16."
        },
        {
          "s": 10,
          "text": "[וכ\"ה במצות זכירת יציאת מצרים בכל יום,"
        },
        {
          "s": 11,
          "text": "שנכלל בה גם זכירת קריעת ים סוף17."
        },
        {
          "s": 12,
          "text": "וכן במצות סיפור יציאת מצרים בליל הפסח,"
        },
        {
          "s": 13,
          "text": "דכל המרבה לספר ביציאת מצרים הרי זה משובח18,"
        },
        {
          "s": 14,
          "text": "שגם סיפור קריעת ים סוף נכלל בזה19]."
        },
        {
          "s": 15,
          "text": "ולכן נאמר כימי צאתך מארץ מצרים,"
        },
        {
          "s": 16,
          "text": "כימי לשון רבים."
        },
        {
          "s": 17,
          "text": "[ומ\"ש במצות זכירת יציאת מצרים יום צאתך מארץ מצרים הוא,"
        },
        {
          "s": 18,
          "text": "כי עיקר המצוה דזכירת יציאת מצרים היא זכירת יציאת מצרים עצמה וזכירת קריעת ים סוף אינה מעכבת20]."
        },
        {
          "s": 19,
          "text": "ופירוש כימי צאתך מארץ מצרים אראנו נפלאות הוא,"
        },
        {
          "s": 20,
          "text": "שבגאולה העתידה יהיו הנסים והנפלאות שהיו ביציאת מצרים עצמה וגם הנס והפלא דקריעת ים סוף."
        },
        {
          "s": 21,
          "text": "כמ\"ש21"
        },
        {
          "s": 22,
          "text": "והחרים הוי' את לשון ים מצרים גו' והיתה מסילה גו' כאשר היתה לישראל ביום עלותו מארץ מצרים."
        },
        {
          "s": 23,
          "text": "וצריך להבין השייכות דשני הענינים בכימי צאתך מארץ מצרים אראנו נפלאות,"
        },
        {
          "s": 24,
          "text": "שגם הנפלאות הנמשכים ממנו ית' לבדו יהיו באופן דאראנו"
        },
        {
          "s": 25,
          "text": "(שיראו את הנס שבהם),"
        },
        {
          "s": 26,
          "text": "ושבהנפלאות שיהיו בגאולה העתידה יהי' גם הפלא דקריעת ים סוף."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים,"
        },
        {
          "s": 2,
          "text": "דזה ששרש הנסים המלובשים בטבע הוא ממקום נעלה יותר משרש הנסים שלמעלה מהטבע,"
        },
        {
          "s": 3,
          "text": "הוא,"
        },
        {
          "s": 4,
          "text": "כי בהנסים שלמעלה מהטבע,"
        },
        {
          "s": 5,
          "text": "הגילוי דאוא\"ס הבל\"ג שלמעלה מעולמות"
        },
        {
          "s": 6,
          "text": "(שממנו נמשכים הנסים)"
        },
        {
          "s": 7,
          "text": "הוא באופן שהטבע בטל על ידי הגילוי,"
        },
        {
          "s": 8,
          "text": "שידוד מערכות הטבע,"
        },
        {
          "s": 9,
          "text": "ובמילא,"
        },
        {
          "s": 10,
          "text": "אין נמשך הגילוי בעולם."
        },
        {
          "s": 11,
          "text": "ובהנסים המלובשים בטבע,"
        },
        {
          "s": 12,
          "text": "הגילוי דאוא\"ס הבל\"ג שלמעלה מעולמות הוא בהעולם עצמו22."
        },
        {
          "s": 13,
          "text": "וכיון שהעולם עצמו הוא גבול,"
        },
        {
          "s": 14,
          "text": "דגבול ובל\"ג הם שני הפכים,"
        },
        {
          "s": 15,
          "text": "לכן,"
        },
        {
          "s": 16,
          "text": "בכדי שהגילוי דאוא\"ס הבל\"ג יהי' בהגבול דעולם,"
        },
        {
          "s": 17,
          "text": "הוא ע\"י שהמשכת הבל\"ג היא מעצמות אוא\"ס שנמצא בכל מקום גם בהגבול"
        },
        {
          "s": 18,
          "text": "(וטבע)"
        },
        {
          "s": 19,
          "text": "דעולם."
        },
        {
          "s": 20,
          "text": "ועוד ביאור במעלת הנסים המלובשים בטבע לגבי הנסים שלמעלה מהטבע,"
        },
        {
          "s": 21,
          "text": "דענין הנסים הוא שעל ידם מתגלה שהוא ית' מושל ושולט על הטבע23."
        },
        {
          "s": 22,
          "text": "וענין זה מתגלה יותר בהנסים המלובשים בטבע."
        },
        {
          "s": 23,
          "text": "דגילוי ממשלתו ית' ע\"י הנסים שלמעלה מהטבע הוא שבכחו ית' לבטל ולשדד את חוקי הטבע,"
        },
        {
          "s": 24,
          "text": "ובהנסים שמלובשים בטבע מתגלה שאוא\"ס מושל ושולט על הטבע עצמו24,"
        },
        {
          "s": 25,
          "text": "שהטבע יהי' כפי רצונו25."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וביאור החילוק בין שני הביאורים במעלת הנסים המלובשים בטבע,"
        },
        {
          "s": 2,
          "text": "יובן בהקדים מ\"ש בעקידה26"
        },
        {
          "s": 3,
          "text": "שגם מהנהגת הטבע אפשר לידע גדלות הבורא."
        },
        {
          "s": 4,
          "text": "דנוסף לזה שע\"י ההתבוננות בהנהגת הבריאה"
        },
        {
          "s": 5,
          "text": "(הילוך המזלות וכו')"
        },
        {
          "s": 6,
          "text": "באים להכרה שיש בעה\"ב לבירה זו27,"
        },
        {
          "s": 7,
          "text": "הנה ע\"י ההתבוננות בזה שהנהגת הטבע היא תמידית בלי שינוי,"
        },
        {
          "s": 8,
          "text": "ובלשון הכתוב28"
        },
        {
          "s": 9,
          "text": "לא ישבותו,"
        },
        {
          "s": 10,
          "text": "דהגם שזה כבר קרוב לששה אלפים שנים ואעפ\"כ אין שום חלישות בההנהגה הטבעית,"
        },
        {
          "s": 11,
          "text": "[וכן מזה שבמשך כל הזמן לא נעשה חלישות בכחם של הנבראים,"
        },
        {
          "s": 12,
          "text": "דזה שצבא השמים קיימים באיש וצבא הארץ קיימים במין הוא באופן שהם חזקים כביום הבראם29],"
        },
        {
          "s": 13,
          "text": "עי\"ז יודעים גדלות הבורא,"
        },
        {
          "s": 14,
          "text": "שכחו ית'"
        },
        {
          "s": 15,
          "text": "(שממנו באה ההשפעה בעולם)"
        },
        {
          "s": 16,
          "text": "הוא א\"ס ובל\"ג."
        },
        {
          "s": 17,
          "text": "דהגם שטבע הנבראים הוא מהחיות אלקי שמתלבש בהם,"
        },
        {
          "s": 18,
          "text": "וזה שכל נברא יש לו טבע מיוחד הוא כפי אופן החיות שבו,"
        },
        {
          "s": 19,
          "text": "דמזה מובן שהחיות שמלובש בהנבראים הוא חיות מוגבל30,"
        },
        {
          "s": 20,
          "text": "הנה זהו בנוגע להטבע עצמו,"
        },
        {
          "s": 21,
          "text": "אבל התמידיות שבהנהגת הטבע,"
        },
        {
          "s": 22,
          "text": "שאין בה שינוי וחלישות,"
        },
        {
          "s": 23,
          "text": "הוא בכח הא\"ס הבל\"ג שלמעלה מהתלבשות."
        },
        {
          "s": 24,
          "text": "אלא שבכדי לידע גדלות הבורא ע\"י הנהגת הטבע,"
        },
        {
          "s": 25,
          "text": "צריך להתבוננות."
        },
        {
          "s": 26,
          "text": "וכשרואים נס,"
        },
        {
          "s": 27,
          "text": "שינוי הטבע,"
        },
        {
          "s": 28,
          "text": "רואים מיד"
        },
        {
          "s": 29,
          "text": "(גם בלי התבוננות)"
        },
        {
          "s": 30,
          "text": "שזה בא מאוא\"ס שאינו מוגבל בגדר העולם."
        },
        {
          "s": 31,
          "text": "ועוד מעלה בנסים לגבי הנהגת הטבע,"
        },
        {
          "s": 32,
          "text": "שכח הא\"ס הבל\"ג שמתגלה ע\"י התמידיות שבהנהגת הטבע"
        },
        {
          "s": 33,
          "text": "(גם לאחרי ההתבוננות)"
        },
        {
          "s": 34,
          "text": "הוא מלובש בענין הגבול,"
        },
        {
          "s": 35,
          "text": "שהנהגת הטבע"
        },
        {
          "s": 36,
          "text": "(גבול)"
        },
        {
          "s": 37,
          "text": "אין לה שינוי והפסק,"
        },
        {
          "s": 38,
          "text": "וע\"י הנסים נמשך גילוי אוא\"ס הבל\"ג עצמו שלמעלה מהתלבשות בגבול."
        },
        {
          "s": 39,
          "text": "אלא שאעפ\"כ,"
        },
        {
          "s": 40,
          "text": "מטעם זה עצמו,"
        },
        {
          "s": 41,
          "text": "יש מעלה בהגילוי דכח הא\"ס שמתגלה ע\"י התמידיות שבהנהגת הטבע לגבי גילוי הא\"ס שע\"י הנסים."
        },
        {
          "s": 42,
          "text": "דענין הבל\"ג כמו שמתגלה ע\"י הנסים,"
        },
        {
          "s": 43,
          "text": "שידוד הטבע דעולם,"
        },
        {
          "s": 44,
          "text": "אינו שייך להעולם,"
        },
        {
          "s": 45,
          "text": "וע\"י התמידיות שבהנהגת הטבע,"
        },
        {
          "s": 46,
          "text": "מתגלה שגם חיות העולם"
        },
        {
          "s": 47,
          "text": "(גבול)"
        },
        {
          "s": 48,
          "text": "הוא קשור עם אוא\"ס הבל\"ג."
        }
      ]
    }
  ]
}