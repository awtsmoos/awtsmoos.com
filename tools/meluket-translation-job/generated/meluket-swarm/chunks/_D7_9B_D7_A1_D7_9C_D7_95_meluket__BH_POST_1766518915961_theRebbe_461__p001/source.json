{
  "globalIndex": 385,
  "owner": 35,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915961_theRebbe_461__p001",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915961_theRebbe_461__p001",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915961_theRebbe_461",
  "title": "מאמר ביום השמיני תשמ\"ו",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "מוצש\"ק פ' מקץ,"
        },
        {
          "s": 2,
          "text": "ליל זאת חנוכה ה'תשמ\"ו*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "ביום השמיני נשיא לבני מנשה גו'1"
        },
        {
          "s": 1,
          "text": "זאת חנוכת המזבח גו'2,"
        },
        {
          "s": 2,
          "text": "הנה ידוע דמהטעמים על זה שבחנוכה קוראין קרבנות הנשיאים3"
        },
        {
          "s": 3,
          "text": "הוא לפי שבחנוכה חינכו4"
        },
        {
          "s": 4,
          "text": "את המזבח5,"
        },
        {
          "s": 5,
          "text": "דוגמת חנוכת המזבח"
        },
        {
          "s": 6,
          "text": "(בפעם הראשונה)"
        },
        {
          "s": 7,
          "text": "ע\"י קרבנות הנשיאים."
        },
        {
          "s": 8,
          "text": "ומזה מובן,"
        },
        {
          "s": 9,
          "text": "דשמונת ימי חנוכה הם דוגמת שמונת ימי המילואים."
        },
        {
          "s": 10,
          "text": "וכמו ששמונת ימי המילואים נחלקים לב',"
        },
        {
          "s": 11,
          "text": "שבעת ימי המילואים ויום השמיני,"
        },
        {
          "s": 12,
          "text": "עד\"ז הוא בשמונת ימי חנוכה,"
        },
        {
          "s": 13,
          "text": "שיום השמיני דחנוכה נקרא"
        },
        {
          "s": 14,
          "text": "(ע\"פ מנהג ישראל)"
        },
        {
          "s": 15,
          "text": "גם בשם בפני עצמו,"
        },
        {
          "s": 16,
          "text": "זאת חנוכה."
        },
        {
          "s": 17,
          "text": "[ויש לומר,"
        },
        {
          "s": 18,
          "text": "שזהו גם מה שהקריאה בתורה ביום השמיני דחנוכה היא הרבה יותר משבעת הימים שלפניו,"
        },
        {
          "s": 19,
          "text": "דבשבעת ימים הראשונים קוראין בכל יום רק שני נשיאים6"
        },
        {
          "s": 20,
          "text": "וביום השמיני דחנוכה קוראין חמשה נשיאים וגם זאת חנוכת המזבח וריש פרשת בהעלותך את הנרות7,"
        },
        {
          "s": 21,
          "text": "דהוספה בקריאת התורה מורה על מעלת היום]."
        },
        {
          "s": 22,
          "text": "ומבואר בד\"ה ברוך שעשה נסים לאדמו\"ר הזקן עם הגהות והערות וכו' דהצמח צדק8,"
        },
        {
          "s": 23,
          "text": "שיום השמיני"
        },
        {
          "s": 24,
          "text": "[למילואים וכן יום השמיני]"
        },
        {
          "s": 25,
          "text": "דחנוכה הוא מלכות,"
        },
        {
          "s": 26,
          "text": "ולכן נקרא בשם זאת חנוכה,"
        },
        {
          "s": 27,
          "text": "כי זאת היא9"
        },
        {
          "s": 28,
          "text": "מלכות10."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה ידוע11"
        },
        {
          "s": 2,
          "text": "דבשמיני שני ענינים."
        },
        {
          "s": 3,
          "text": "ששמיני הוא למעלה מהשבעה שלפניו"
        },
        {
          "s": 4,
          "text": "[וע\"ד הפירוש בהאותיות דתיבת אז,"
        },
        {
          "s": 5,
          "text": "אל\"ף רוכב על זיי\"ן12],"
        },
        {
          "s": 6,
          "text": "דשבעה הם שבעת המדות ושמיני הוא בינה."
        },
        {
          "s": 7,
          "text": "וששמיני הוא מלכות שלמטה משבעת המדות."
        },
        {
          "s": 8,
          "text": "וכמו\"כ הוא בנוגע ליום השמיני למילואים,"
        },
        {
          "s": 9,
          "text": "דאיתא בלקו\"ת13"
        },
        {
          "s": 10,
          "text": "שני פירושים בזה."
        },
        {
          "s": 11,
          "text": "שיום השמיני למילואים הוא למעלה מז' ימי המילואים,"
        },
        {
          "s": 12,
          "text": "דז' ימי המילואים הם בבינה ויום השמיני למילואים הוא חכמה14."
        },
        {
          "s": 13,
          "text": "ושיום השמיני למילואים הוא מלכות."
        },
        {
          "s": 14,
          "text": "והתיווך דשני הפירושים הוא15,"
        },
        {
          "s": 15,
          "text": "כי בכדי שתהי' ההמשכה במלכות"
        },
        {
          "s": 16,
          "text": "(שמיני שלמטה משבעה),"
        },
        {
          "s": 17,
          "text": "הוא דוקא ע\"י שההמשכה היא ממקום נעלה יותר"
        },
        {
          "s": 18,
          "text": "(שלמעלה משבעה)."
        }
      ]
    }
  ]
}