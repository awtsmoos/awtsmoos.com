{
  "globalIndex": 272,
  "owner": 22,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915360_theRebbe_171__p001",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915360_theRebbe_171__p001",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915360_theRebbe_171",
  "title": "מאמר פדה בשלום תשמ\"א",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "אור ליום ג',"
        },
        {
          "s": 2,
          "text": "יו\"ד כסלו ה'תשמ\"א*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "פדה בשלום נפשי מקרב לי כי ברבים היו עמדי1,"
        },
        {
          "s": 1,
          "text": "ומבאר בעל הגאולה במאמרו ד\"ה זה"
        },
        {
          "s": 2,
          "text": "(שנדפס בספרו שערי תשובה2)3,"
        },
        {
          "s": 3,
          "text": "דפירוש פדה בשלום"
        },
        {
          "s": 4,
          "text": "(בשלום דוקא)"
        },
        {
          "s": 5,
          "text": "הוא שהפדי' היא באופן שהמנגד מתבטל לגמרי,"
        },
        {
          "s": 6,
          "text": "שלכן אין צריך למלחמה כלל."
        },
        {
          "s": 7,
          "text": "וע\"ד שהי' בימי שלמה,"
        },
        {
          "s": 8,
          "text": "שכל הגוים נתבטלו לגבי שלמה,"
        },
        {
          "s": 9,
          "text": "שלא ע\"י מלחמה,"
        },
        {
          "s": 10,
          "text": "שלכן נקרא בשם שלמה כי שלום הי' בימיו כו'4."
        },
        {
          "s": 11,
          "text": "אלא שהשלום שבימי שלמה לא הי' עדיין בשלימות5,"
        },
        {
          "s": 12,
          "text": "ותכלית השלימות שבזה יהי' בימות המשיח שאז יתבטל הרע לגמרי"
        },
        {
          "s": 13,
          "text": "(כמ\"ש6"
        },
        {
          "s": 14,
          "text": "ואת רוח הטומאה אעביר מן הארץ),"
        },
        {
          "s": 15,
          "text": "שלכן יהי' אז ונהרו אליו כל הגוים גו'7"
        },
        {
          "s": 16,
          "text": "(ונהרו מעצמם),"
        },
        {
          "s": 17,
          "text": "וכמו\"כ בנוגע לבע\"ח – לא ירעו ולא ישחיתו גו'8"
        },
        {
          "s": 18,
          "text": "וארי' כבקר יאכל תבן9,"
        },
        {
          "s": 19,
          "text": "ואולי י\"ל,"
        },
        {
          "s": 20,
          "text": "דמזה שמביא בהמאמר הפסוק וארי' כבקר יאכל תבן,"
        },
        {
          "s": 21,
          "text": "מובן,"
        },
        {
          "s": 22,
          "text": "דבימות המשיח גופא,"
        },
        {
          "s": 23,
          "text": "השלימות דפדה בשלום תהי' בתקופה השני' דוקא10."
        },
        {
          "s": 24,
          "text": "וכמבואר במק\"א11"
        },
        {
          "s": 25,
          "text": "תיווך הדעות12"
        },
        {
          "s": 26,
          "text": "בפירוש וגר זאב עם כבש וגו'13,"
        },
        {
          "s": 27,
          "text": "שבתקופה הראשונה דימות המשיח יהי' זה בדרך \"משל וחידה\"14,"
        },
        {
          "s": 28,
          "text": "והכוונה לאומות העולם,"
        },
        {
          "s": 29,
          "text": "ובתקופה השני' יהי' זה כפשוטו"
        },
        {
          "s": 30,
          "text": "(בנוגע לבע\"ח)."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "וביאור הענין"
        },
        {
          "s": 2,
          "text": "(דהגם שענין הפדי' בשלום הי' גם בימי שלמה,"
        },
        {
          "s": 3,
          "text": "מ\"מ,"
        },
        {
          "s": 4,
          "text": "תכלית השלימות שבזה יהי' בימות המשיח,"
        },
        {
          "s": 5,
          "text": "ובהם גופא בתקופה הב'),"
        },
        {
          "s": 6,
          "text": "יובן מזה שמבאר בהמאמר15,"
        },
        {
          "s": 7,
          "text": "דגם ע\"י עסק התורה"
        },
        {
          "s": 8,
          "text": "(עכשיו)"
        },
        {
          "s": 9,
          "text": "נעשה פדי' בשלום16,"
        },
        {
          "s": 10,
          "text": "כי הבירור שע\"י עסק התורה הוא \"בחי' ביטול הרע בעצם\"."
        },
        {
          "s": 11,
          "text": "וכמבואר בכמה דרושים17"
        },
        {
          "s": 12,
          "text": "ההפרש בין תורה לתפלה,"
        },
        {
          "s": 13,
          "text": "שהבירור דתפלה הוא בדרך מלחמה,"
        },
        {
          "s": 14,
          "text": "שעת צלותא שעת קרבא18,"
        },
        {
          "s": 15,
          "text": "והבירור דתורה הוא בדרך מנוחה."
        },
        {
          "s": 16,
          "text": "דהחילוק שבין בירור בדרך מלחמה לבירור בדרך מנוחה הוא שבבירור שבדרך מלחמה צריך המברר להתלבש בלבושי המתברר,"
        },
        {
          "s": 17,
          "text": "משא\"כ בהבירור שבדרך מנוחה,"
        },
        {
          "s": 18,
          "text": "המברר נשאר במקומו,"
        },
        {
          "s": 19,
          "text": "וע\"י הגילוי אור"
        },
        {
          "s": 20,
          "text": "(דהמברר)"
        },
        {
          "s": 21,
          "text": "שמאיר על המתברר,"
        },
        {
          "s": 22,
          "text": "הוא מתברר ממילא."
        },
        {
          "s": 23,
          "text": "וכמו שהי' בימי שלמה,"
        },
        {
          "s": 24,
          "text": "דשלמה הי' במקומו,"
        },
        {
          "s": 25,
          "text": "וע\"י גדולת שמו שנשמע גם במקומות הרחוקים,"
        },
        {
          "s": 26,
          "text": "נמשכו אליו מעצמם,"
        },
        {
          "s": 27,
          "text": "כמ\"ש19"
        },
        {
          "s": 28,
          "text": "ומלכת שבא שומעת את שמע שלמה גו' ותבא ירושלמה גו'."
        },
        {
          "s": 29,
          "text": "דכמו\"כ הוא החילוק שבין הבירור דתפלה להבירור דתורה,"
        },
        {
          "s": 30,
          "text": "שהבירור דתפלה הוא באופן שנפש האלקית מתלבשת בנפש הבהמית"
        },
        {
          "s": 31,
          "text": "(וכידוע20"
        },
        {
          "s": 32,
          "text": "שבכדי שההתבוננות דתפלה תפעול בירור נה\"ב,"
        },
        {
          "s": 33,
          "text": "צריכה להיות ההתבוננות בענינים כאלו ובאופן שגם נה\"ב יכולה להשיג),"
        },
        {
          "s": 34,
          "text": "משא\"כ הבירור דתורה הוא בדרך ממילא,"
        },
        {
          "s": 35,
          "text": "דע\"י שלומדים בתורה שדבר זה מותר ודבר זה אסור,"
        },
        {
          "s": 36,
          "text": "הם מתבררים ממילא."
        }
      ]
    }
  ]
}