  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918104_theRebbe_982__p004",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918104_theRebbe_982__p004",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518918104_theRebbe_982",
  "title": "מאמר כל ישראל תשל\"ג",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 1,
          "text": "שבמעלת התורה דלע\"ל,"
        },
        {
          "s": 2,
          "text": "תורתו של משיח,"
        },
        {
          "s": 3,
          "text": "שני ענינים."
        },
        {
          "s": 4,
          "text": "זה שאז יהי' הגילוי דשלימות התורה מצד עצמה,"
        },
        {
          "s": 5,
          "text": "והעילוי שיהי' אז בתורה ע\"י העילוי דמצוות."
        },
        {
          "s": 6,
          "text": "ועד\"ז הוא בנוגע לנשמה,"
        },
        {
          "s": 7,
          "text": "דנוסף לזה שאז יתגלה שורש הנשמות עצמם,"
        },
        {
          "s": 8,
          "text": "תקבל הנשמה גם הגילוי דמעלת הגוף"
        },
        {
          "s": 9,
          "text": "(בחירת העצמות בהגוף)."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ויהי רצון,"
        },
        {
          "s": 1,
          "text": "שע\"י מעשינו ועבודתינו37,"
        },
        {
          "s": 2,
          "text": "ובפרט על ידי העבודה דיפוצו מעיינותיך חוצה38,"
        },
        {
          "s": 3,
          "text": "נזכה ללימוד תורתו של משיח,"
        },
        {
          "s": 4,
          "text": "מפיו של משיח,"
        },
        {
          "s": 5,
          "text": "בקרוב ממש."
        }
      ]
    }
  ]
}