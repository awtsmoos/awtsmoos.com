{
  "globalIndex": 544,
  "owner": 44,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916877_theRebbe_274__p003",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916877_theRebbe_274__p003",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916877_theRebbe_274",
  "title": "מאמר באתי לגני תשל\"ב",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 2,
          "text": "דעבודת הקרבנות היא עבודה רוחנית שבנפש."
        },
        {
          "s": 3,
          "text": "ומביא ראי' על זה מענין השתתפות הכהנים והלוים בעבודתם ושירם וזמרם בעת הבאת הקרבן,"
        },
        {
          "s": 4,
          "text": "שהם ענינים רוחניים."
        },
        {
          "s": 5,
          "text": "[וכמבואר בכ\"מ23,"
        },
        {
          "s": 6,
          "text": "דההמשכה שבקרבנות היתה ע\"י עבודת הכהנים,"
        },
        {
          "s": 7,
          "text": "וההעלאה דהקרבנות היתה ע\"י השירה והזמרה דהלוים24]."
        },
        {
          "s": 8,
          "text": "וזהו מ\"ש25"
        },
        {
          "s": 9,
          "text": "אדם כי יקריב מכם גו',"
        },
        {
          "s": 10,
          "text": "אף שלכאורה הי' צריך לומר אדם מכם כי יקריב,"
        },
        {
          "s": 11,
          "text": "שבזה מרמז,"
        },
        {
          "s": 12,
          "text": "שהקרבן צריך להיות לא רק מן הבהמה כפשוטה אלא גם מכם"
        },
        {
          "s": 13,
          "text": "(פון אייך אַליין),"
        },
        {
          "s": 14,
          "text": "מן הבהמה שבלבו של אדם."
        },
        {
          "s": 15,
          "text": "ויש לומר,"
        },
        {
          "s": 16,
          "text": "דמ\"ש בהמאמר שעבודת הקרבנות היא"
        },
        {
          "s": 17,
          "text": "(גם)"
        },
        {
          "s": 18,
          "text": "עבודה רוחנית בנפש האדם"
        },
        {
          "s": 19,
          "text": "[אף דזה שעבודת הקרבנות היא העבודה דאתהפכא הוא גם בקרבנות כפשוטם,"
        },
        {
          "s": 20,
          "text": "דכשלוקחים בהמה שחיותה היא מקליפת נוגה26"
        },
        {
          "s": 21,
          "text": "ועושים אותה קרבן להוי',"
        },
        {
          "s": 22,
          "text": "הו\"ע אתהפכא חשוכא לנהורא],"
        },
        {
          "s": 23,
          "text": "שייך למ\"ש בתחלת המאמר,"
        },
        {
          "s": 24,
          "text": "דפירוש ועשו לי מקדש ושכנתי בתוכם"
        },
        {
          "s": 25,
          "text": "(לשון רבים)"
        },
        {
          "s": 26,
          "text": "הוא בתוך כל אחד ואחד מישראל."
        },
        {
          "s": 27,
          "text": "דמזה מובן,"
        },
        {
          "s": 28,
          "text": "דכמו שבמשכן ומקדש,"
        },
        {
          "s": 29,
          "text": "היתה עיקר ההמשכה ע\"י עבודת הקרבנות27"
        },
        {
          "s": 30,
          "text": "[דהגם שההמשכה שנמשכה בו ע\"י עשיית המקדש היא המשכה נעלית ביותר"
        },
        {
          "s": 31,
          "text": "(שע\"י ועשו לי מקדש נעשה ושכנתי בתוכם,"
        },
        {
          "s": 32,
          "text": "ושכנתי אני בעצמי),"
        },
        {
          "s": 33,
          "text": "מ\"מ,"
        },
        {
          "s": 34,
          "text": "ההמשכה שנמשכה בו ע\"י עבודת הקרבנות היא נעלית עוד יותר],"
        },
        {
          "s": 35,
          "text": "עד\"ז הוא בנוגע להמקדש שבכ\"א מישראל,"
        },
        {
          "s": 36,
          "text": "שגם לאחרי העבודה דועשו לי מקדש"
        },
        {
          "s": 37,
          "text": "(שהאדם עושה את עצמו למקדש לו ית'),"
        },
        {
          "s": 38,
          "text": "שעי\"ז נעשה ושכנתי בתוכם,"
        },
        {
          "s": 39,
          "text": "צריכה להיות העבודה דאדם כי יקריב מכם,"
        },
        {
          "s": 40,
          "text": "שעי\"ז תומשך בו המשכה נעלית עוד יותר,"
        },
        {
          "s": 41,
          "text": "עיקר הענין דושכנתי בתוכם28."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים מ\"ש בהמאמר"
        },
        {
          "s": 2,
          "text": "(בתחילת הפרק),"
        },
        {
          "s": 3,
          "text": "שהעבודה שהיתה במשכן ומקדש היא העבודה דאתכפיא המביאה לאתהפכא."
        },
        {
          "s": 4,
          "text": "דבתחלת המאמר אומר,"
        },
        {
          "s": 5,
          "text": "שהעבודה שעל ידה הוא המשכת עיקר שכינה למטה היא העבודה דאתכפיא ואתהפכא"
        },
        {
          "s": 6,
          "text": "[דהגם שמביא שם את המאמר כד אתכפיא סט\"א אסתלק יקרא דקוב\"ה בכולהו עלמין,"
        },
        {
          "s": 7,
          "text": "מ\"מ מדבר בשני הענינים,"
        },
        {
          "s": 8,
          "text": "אתכפיא ואתהפכא."
        },
        {
          "s": 9,
          "text": "ואדרבא,"
        },
        {
          "s": 10,
          "text": "עיקר הביאור"
        },
        {
          "s": 11,
          "text": "(בתחילת המאמר)"
        },
        {
          "s": 12,
          "text": "הוא בהמעלה דאתהפכא,"
        },
        {
          "s": 13,
          "text": "דע\"י שהחושך נהפך לאור נעשה יתרון האור],"
        },
        {
          "s": 14,
          "text": "ובפרק זה"
        },
        {
          "s": 15,
          "text": "(פרק שני),"
        },
        {
          "s": 16,
          "text": "כשמדבר בהעבודה שהיתה במשכן ומקדש"
        },
        {
          "s": 17,
          "text": "(לאחרי עשייתם),"
        },
        {
          "s": 18,
          "text": "אומר,"
        },
        {
          "s": 19,
          "text": "שהעבודה במשכן ומקדש היא העבודה דאתכפיא המביאה לאתהפכא29."
        },
        {
          "s": 20,
          "text": "ויש לומר,"
        },
        {
          "s": 21,
          "text": "דמהביאורים על זה שההמשכה שע\"י עבודת הקרבנות היא המשכה נעלית יותר מההמשכה שע\"י עשיית המקדש"
        },
        {
          "s": 22,
          "text": "(כנ\"ל סעיף ה),"
        },
        {
          "s": 23,
          "text": "הוא,"
        },
        {
          "s": 24,
          "text": "כי ההדגשה בהעבודה דעשיית המקדש הוא הענין דאתהפכא30"
        },
        {
          "s": 25,
          "text": "[שהאדם והעולם נהפכים להיות מקדש לו ית'],"
        },
        {
          "s": 26,
          "text": "והחידוש שבעבודת הקרבנות הוא שבה מודגש"
        },
        {
          "s": 27,
          "text": "(גם)"
        },
        {
          "s": 28,
          "text": "הענין דאתכפיא"
        },
        {
          "s": 29,
          "text": "(כדלקמן),"
        },
        {
          "s": 30,
          "text": "וההמשכה שע\"י העבודה דאתכפיא היא נעלית יותר מההמשכה שע\"י העבודה דאתהפכא31."
        },
        {
          "s": 31,
          "text": "ועפ\"ז יש להוסיף ביאור בזה שמבאר"
        },
        {
          "s": 32,
          "text": "(ובארוכה)"
        },
        {
          "s": 33,
          "text": "הענין דעבודת הקרבנות כמו שהוא בעבודת האדם,"
        },
        {
          "s": 34,
          "text": "כי בקרבנות כפשוטם,"
        },
        {
          "s": 35,
          "text": "ניכר בגילוי רק הענין דאתהפכא"
        },
        {
          "s": 36,
          "text": "[שהבהמה שחיותה מקליפת נוגה נהפכה להיות קרבן להוי'],"
        },
        {
          "s": 37,
          "text": "והענין דאתכפיא שבעבודת הקרבנות ניכר יותר בעבודת הקרבנות שבנפש האדם."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "וביאור הענין דאתכפיא שבעבודת הקרבנות,"
        },
        {
          "s": 1,
          "text": "יובן בהקדים,"
        },
        {
          "s": 2,
          "text": "שהמעלה שבאתכפיא על אתהפכא היא,"
        },
        {
          "s": 3,
          "text": "דענין אתהפכא הוא שהדבר נשאר במציאותו אלא שמציאותו היא מציאות דקדושה,"
        },
        {
          "s": 4,
          "text": "ואתכפיא הו\"ע הביטול,"
        },
        {
          "s": 5,
          "text": "יציאה ממציאותו31."
        },
        {
          "s": 6,
          "text": "וזהו הטעם על זה שההמשכה שע\"י העבודה דאתכפיא היא נעלית יותר מההמשכה שע\"י העבודה דאתהפכא,"
        },
        {
          "s": 7,
          "text": "כי ע\"י שהאדם יוצא מהמציאות שלו ונעשה בחינת אין,"
        },
        {
          "s": 8,
          "text": "הוא מעורר וממשיך בחינת אין האמיתי"
        },
        {
          "s": 9,
          "text": "(שלמעלה ממציאות)31."
        },
        {
          "s": 10,
          "text": "ועפ\"ז יש לבאר השייכות דעבודת הקרבנות"
        },
        {
          "s": 11,
          "text": "(גם דקרבנות כפשוטם)"
        },
        {
          "s": 12,
          "text": "לאתכפיא,"
        },
        {
          "s": 13,
          "text": "כי ענין הקרבנות הוא העלאה מלמטה למעלה"
        },
        {
          "s": 14,
          "text": "(כדלקמן ס\"ח ואילך),"
        },
        {
          "s": 15,
          "text": "דענין ההעלאה מלמטלמ\"ע הוא שהתחתון מתבטל ממציאותו ונכלל בהעליון"
        },
        {
          "s": 16,
          "text": "[ובפשטות הוא,"
        },
        {
          "s": 17,
          "text": "שהבהמה היתה נשרפת"
        },
        {
          "s": 18,
          "text": "(מתבטלת ממציאותה)"
        },
        {
          "s": 19,
          "text": "ונכללת באש שלמעלה],"
        },
        {
          "s": 20,
          "text": "וענין זה"
        },
        {
          "s": 21,
          "text": "[שהיש בטל ונעשה בחינת אין]"
        },
        {
          "s": 22,
          "text": "הוא תוכן הענין דאתכפיא."
        }
      ]
    }
  ]
}