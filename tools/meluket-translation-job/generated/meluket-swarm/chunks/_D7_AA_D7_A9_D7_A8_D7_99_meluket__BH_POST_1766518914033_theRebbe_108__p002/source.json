{
  "globalIndex": 59,
  "owner": 9,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914033_theRebbe_108__p002",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914033_theRebbe_108__p002",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914033_theRebbe_108",
  "title": "מאמר שובה ישראל תשל\"ז",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "וזהו הקשר דשני העבודות דסור מרע ודועשה טוב לב' השמות אלקים והוי'."
        },
        {
          "s": 1,
          "text": "דהנה ידוע24"
        },
        {
          "s": 2,
          "text": "שבסור מרע נכלל גם הזהירות שלא לעבור על מ\"ע"
        },
        {
          "s": 3,
          "text": "(דביטול מ\"ע הוא איסור,"
        },
        {
          "s": 4,
          "text": "רע),"
        },
        {
          "s": 5,
          "text": "אלא שבסור מרע,"
        },
        {
          "s": 6,
          "text": "מכיון שהזהירות שלו בקיום המצוות הוא מפני שירא25"
        },
        {
          "s": 7,
          "text": "לעבור על ציווי המלך,"
        },
        {
          "s": 8,
          "text": "קיום המצוות שלו הוא רק עד כמה שמחוייב."
        },
        {
          "s": 9,
          "text": "והחידוש בהעבודה דעשה טוב הוא,"
        },
        {
          "s": 10,
          "text": "שקיום המצוות שלו הוא"
        },
        {
          "s": 11,
          "text": "(לא רק מפני שהוא מוכרח בזה,"
        },
        {
          "s": 12,
          "text": "בכדי שלא לעבור על הציווי,"
        },
        {
          "s": 13,
          "text": "אלא)"
        },
        {
          "s": 14,
          "text": "באופן דעשי',"
        },
        {
          "s": 15,
          "text": "ועשה טוב."
        },
        {
          "s": 16,
          "text": "וכמ\"ש בלקו\"ת26"
        },
        {
          "s": 17,
          "text": "דענין ועשה טוב הוא שמייגע את עצמו בתומ\"צ,"
        },
        {
          "s": 18,
          "text": "ועד ליגיעה יותר מטבעו ורגילותו27."
        },
        {
          "s": 19,
          "text": "וזהו שהעבודה דסור מרע שייכת לשם אלקים והעבודה דועשה טוב לשם הוי',"
        },
        {
          "s": 20,
          "text": "כי זה שהוא ירא לעבור על מצות המלך,"
        },
        {
          "s": 21,
          "text": "ועד שמפני היראה שלו הוא כובש את יצרו"
        },
        {
          "s": 22,
          "text": "(גם כשיצרו בוער כאש28)"
        },
        {
          "s": 23,
          "text": "מפני שהוא ירא לעבור על מצות המלך,"
        },
        {
          "s": 24,
          "text": "הוא ע\"י שמרגיש שהוא ית' מושל ושולט עליו,"
        },
        {
          "s": 25,
          "text": "אלקים."
        },
        {
          "s": 26,
          "text": "והעבודה דועשה טוב,"
        },
        {
          "s": 27,
          "text": "שמייגע עצמו בתומ\"צ יותר מטבעו ורגילותו,"
        },
        {
          "s": 28,
          "text": "הוא ע\"י גילוי אור הסובב שלמעלה מעולמות,"
        },
        {
          "s": 29,
          "text": "הוי' שלמעלה מטבע."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "וביאור השייכות של העבודה דועשה טוב לאור הסובב בפרטיות יותר,"
        },
        {
          "s": 2,
          "text": "הנה נתבאר לעיל,"
        },
        {
          "s": 3,
          "text": "שגם אור הסובב יש לו שייכות לעולמות,"
        },
        {
          "s": 4,
          "text": "אלא שענינם של העולמות לגבי אור הסובב הוא"
        },
        {
          "s": 5,
          "text": "(לא המציאות שלהם,"
        },
        {
          "s": 6,
          "text": "רק)"
        },
        {
          "s": 7,
          "text": "זה שעל ידם נשלם הרצון."
        },
        {
          "s": 8,
          "text": "ועד\"ז הוא בהעבודה דועשה טוב,"
        },
        {
          "s": 9,
          "text": "דמכיון שהעבודה דועשה טוב הוא מפני שהוא אוהב את הוי' וחפץ לדבקה בו29,"
        },
        {
          "s": 10,
          "text": "הרי עבודתו את ה' קשורה עם מציאותו של האדם,"
        },
        {
          "s": 11,
          "text": "האהבה והרצון שלו."
        },
        {
          "s": 12,
          "text": "אלא שהאהבה שלו להוי' היא באופן שזה"
        },
        {
          "s": 13,
          "text": "(אהבת ה')"
        },
        {
          "s": 14,
          "text": "נעשה כל ענינו30,"
        },
        {
          "s": 15,
          "text": "שלכן עבודתו את ה' היא באופן שאינו מתחשב עם הגבלת הטבע שלו."
        },
        {
          "s": 16,
          "text": "וזוהי המעלה בהעבודה דבקש שלום,"
        },
        {
          "s": 17,
          "text": "שהוא עסק התורה,"
        },
        {
          "s": 18,
          "text": "על העבודה דועשה טוב,"
        },
        {
          "s": 19,
          "text": "כי התורה נקראת משל הקדמוני31,"
        },
        {
          "s": 20,
          "text": "שהיא משל ולבוש לבחי' קדמונו של עולם,"
        },
        {
          "s": 21,
          "text": "היינו לעצמות אוא\"ס שאינו בגדר עלמין כלל32,"
        },
        {
          "s": 22,
          "text": "ולכן,"
        },
        {
          "s": 23,
          "text": "הביטול דעסק התורה הוא ביטול בתכלית33."
        },
        {
          "s": 24,
          "text": "וכמבואר בתו\"א34"
        },
        {
          "s": 25,
          "text": "החילוק בין תורה למצוות,"
        },
        {
          "s": 26,
          "text": "שבקיום המצוות,"
        },
        {
          "s": 27,
          "text": "האדם המקיים את המצוות הוא כמו עבד המקיים מצות המלך,"
        },
        {
          "s": 28,
          "text": "דמציאות העבד אינה מציאות האדון."
        },
        {
          "s": 29,
          "text": "וגם כשקיום המצוות שלו היא מאהבה בתענוגים,"
        },
        {
          "s": 30,
          "text": "אעפ\"כ יש מי שאוהב35."
        },
        {
          "s": 31,
          "text": "משא\"כ בלימוד התורה ה\"ה המלך עצמו."
        },
        {
          "s": 32,
          "text": "דכאשר עסק התורה הוא בביטול,"
        },
        {
          "s": 33,
          "text": "אזי ואשים דברי בפיך36,"
        },
        {
          "s": 34,
          "text": "דברי ממש."
        },
        {
          "s": 35,
          "text": "היינו"
        },
        {
          "s": 36,
          "text": "(שלא האדם הוא המדבר,"
        },
        {
          "s": 37,
          "text": "כי אם)"
        },
        {
          "s": 38,
          "text": "שדבר הוי' זו הלכה37"
        },
        {
          "s": 39,
          "text": "היא המדברת מתוך גרונו."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה עד\"ז הוא בהעבודה דאהבת ה',"
        },
        {
          "s": 2,
          "text": "שיש בה ג' מדריגות."
        },
        {
          "s": 3,
          "text": "בכל לבבך,"
        },
        {
          "s": 4,
          "text": "בכל נפשך,"
        },
        {
          "s": 5,
          "text": "ובכל מאדך."
        },
        {
          "s": 6,
          "text": "ומבואר בכ\"מ38,"
        },
        {
          "s": 7,
          "text": "שהאהבה דבכל לבבך היא ע\"י ההתבוננות באור האלקי המתלבש בנבראים להחיותם,"
        },
        {
          "s": 8,
          "text": "דבכללות הוא אור הממלא."
        },
        {
          "s": 9,
          "text": "דע\"י שמתבונן שהחיות של כל דבר הוא אלקות,"
        },
        {
          "s": 10,
          "text": "וההתבוננות שלו היא באופן שזה יהי' מובן גם בהשכל דנפש הבהמית,"
        },
        {
          "s": 11,
          "text": "עי\"ז יבוא לאהבה את הוי' בכל לבבך בשני יצריך39."
        },
        {
          "s": 12,
          "text": "והאהבה דבכל נפשך היא ע\"י ההתבוננות שהאור המחי' את העולמות הוא הארה בלבד ושהארה זו היא באין ערוך לגבי אוא\"ס,"
        },
        {
          "s": 13,
          "text": "דבכללות הוא אור הסובב,"
        },
        {
          "s": 14,
          "text": "עי\"ז יבוא להאהבה דבכל נפשך,"
        },
        {
          "s": 15,
          "text": "שאהבתו את הוי' היא באופן דמסירת נפש,"
        },
        {
          "s": 16,
          "text": "אפילו נוטל את נפשך39."
        },
        {
          "s": 17,
          "text": "והאהבה דבכל מאדך היא ע\"י גילוי עצמות אוא\"ס שאינו בגדר עלמין כלל,"
        },
        {
          "s": 18,
          "text": "שע\"י גילוי זה,"
        },
        {
          "s": 19,
          "text": "האהבה היא למעלה ממדידה והגבלה."
        },
        {
          "s": 20,
          "text": "והגם שגם האהבה דבכל נפשך היא אפילו נוטל את נפשך וענין המס\"נ הוא למעלה ממדידה והגבלה,"
        },
        {
          "s": 21,
          "text": "הנה המס\"נ40"
        },
        {
          "s": 22,
          "text": "שבהאהבה דבכל נפשך,"
        },
        {
          "s": 23,
          "text": "שהוא בכללות בבחי' חי'41,"
        },
        {
          "s": 24,
          "text": "היא באופן שהוא רוצה למסור את נפשו"
        },
        {
          "s": 25,
          "text": "[ויתירה מזו שרצון זה הוא דוגמת42"
        },
        {
          "s": 26,
          "text": "הרצון שע\"פ טעם,"
        },
        {
          "s": 27,
          "text": "מצד זה שכל הענינים הם באין ערוך לגבי אוא\"ס]."
        },
        {
          "s": 28,
          "text": "והאהבה דבכל מאדך,"
        },
        {
          "s": 29,
          "text": "שהיא בכללות בבחי' יחידה41,"
        },
        {
          "s": 30,
          "text": "היא לא מצד הרצון שלו אלא מפני שאינו יכול להפרד ח\"ו מאחדותו ית'43."
        },
        {
          "s": 31,
          "text": "דמס\"נ באופן זה הוא אמיתית ענין הביטול,"
        },
        {
          "s": 32,
          "text": "מכיון שהמס\"נ היא לא מצד הרצון"
        },
        {
          "s": 33,
          "text": "(מציאות)"
        },
        {
          "s": 34,
          "text": "שלו אלא מצד האלקות."
        },
        {
          "s": 35,
          "text": "וע\"ד שנת\"ל"
        },
        {
          "s": 36,
          "text": "(סעיף ג)"
        },
        {
          "s": 37,
          "text": "מעלת העבודה דבקש שלום על העבודה דועשה טוב."
        }
      ]
    }
  ]
}