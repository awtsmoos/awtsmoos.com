{
  "globalIndex": 80,
  "owner": 30,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914162_theRebbe_955__p001",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914162_theRebbe_955__p001",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914162_theRebbe_955",
  "title": "מאמר כנשר יאיר קנו תשכ\"ט",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ האזינו,"
        },
        {
          "s": 2,
          "text": "י\"ג תשרי,"
        },
        {
          "s": 3,
          "text": "ה'תשכ\"ט"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "(הנחה)"
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "כנשר יעיר קנו גו' ישאהו על אברתו1,"
        },
        {
          "s": 1,
          "text": "וידוע הפירוש של בעל ההילולא2,"
        },
        {
          "s": 2,
          "text": "שנשר הוא בחינת רחמים,"
        },
        {
          "s": 3,
          "text": "וכנשר יעיר גו' הוא בחינת רחמים רבים."
        },
        {
          "s": 4,
          "text": "ומ\"ש ישאהו על אברתו,"
        },
        {
          "s": 5,
          "text": "אף שאין לו גוף ואין לו דמות הגוף3,"
        },
        {
          "s": 6,
          "text": "הוא כי זאת התורה אדם4,"
        },
        {
          "s": 7,
          "text": "והו\"ע רמ\"ח אברים דמלכא הנעשים ע\"י רמ\"ח פקודין5,"
        },
        {
          "s": 8,
          "text": "שע\"י קיום המצוות מעלה אני עליכם כאילו עשאוני6."
        },
        {
          "s": 9,
          "text": "וזהו\"ע ישאהו על אברתו,"
        },
        {
          "s": 10,
          "text": "שמצד הרחמים רבים דבחי' נשר הנה ע\"י התשובה נעשה העילוי למעלה מבחינת רמ\"ח אברים דמלכא שע\"י המצוות"
        },
        {
          "s": 11,
          "text": "(ישאהו על אברתו)."
        },
        {
          "s": 12,
          "text": "וזה מתאים עם המבואר בקבלה7"
        },
        {
          "s": 13,
          "text": "דחיות המרכבה בהם מאיר מי\"ג תיקוני דיקנא,"
        },
        {
          "s": 14,
          "text": "ולמעלה יותר נשר הוא בחי' עתיק שנעתק ונבדל מכל סדר ההשתלשלות,"
        },
        {
          "s": 15,
          "text": "שלכן מצד בחי' זו אין שום מדידות והגבלות,"
        },
        {
          "s": 16,
          "text": "גם לא המדידות שבמדריגות הכי עליונות שבסדר השתלשלות,"
        },
        {
          "s": 17,
          "text": "עד גם להמדידות דתורה ומצוות."
        },
        {
          "s": 18,
          "text": "ולכן מצד בחינה זו ישאהו על אברתו."
        },
        {
          "s": 19,
          "text": "וי\"ל בדא\"פ שזהו ג\"כ הטעם מה שקוראין פרשת האזינו בעשי\"ת או תיכף אחרי יום הכפורים,"
        },
        {
          "s": 20,
          "text": "כי אז הוא זמן התשובה,"
        },
        {
          "s": 21,
          "text": "אשר גם מי שחטא,"
        },
        {
          "s": 22,
          "text": "בין חטא כפשוטו ובין חטא מלשון חסרון כמ\"ש8"
        },
        {
          "s": 23,
          "text": "אני ובני שלמה חטאים,"
        },
        {
          "s": 24,
          "text": "והיינו שחסר לו בשלימות עבודתו,"
        },
        {
          "s": 25,
          "text": "הנה מצד הגילוי דבחי' נשר,"
        },
        {
          "s": 26,
          "text": "נעשה ע\"י התשובה העלי' למעלה מבחי' אברתו."
        }
      ]
    }
  ]
}