{
  "globalIndex": 1119,
  "owner": 19,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920487_theRebbe_9__p003",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920487_theRebbe_9__p003",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920487_theRebbe_9",
  "title": "מאמר לך אמר לבי תש\"כ",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה בהענין דפני,"
        },
        {
          "s": 2,
          "text": "בכל אחת מג' בחינות אלה,"
        },
        {
          "s": 3,
          "text": "יש ב' מדריגות,"
        },
        {
          "s": 4,
          "text": "בכללות."
        },
        {
          "s": 5,
          "text": "פנימיות שיש לה שייכות להחיצוניות,"
        },
        {
          "s": 6,
          "text": "ופנימיות ממש שמובדלת מהחיצוניות."
        },
        {
          "s": 7,
          "text": "דבענין העולמות הוא אצילות ולמעלה מאצילות."
        },
        {
          "s": 8,
          "text": "וכמ\"ש הצ\"צ20"
        },
        {
          "s": 9,
          "text": "בפירוש הכתוב בקשו פני את פניך הוי' אבקש,"
        },
        {
          "s": 10,
          "text": "דבקשו פני הוא להמשיך החכמה,"
        },
        {
          "s": 11,
          "text": "אצילות,"
        },
        {
          "s": 12,
          "text": "ואת פניך הוי' אבקש הוא להמשיך הפנים של הוי',"
        },
        {
          "s": 13,
          "text": "האורות דאריך ועתיק."
        },
        {
          "s": 14,
          "text": "דהחילוק בין אצילות ולמעלה מאצילות הוא,"
        },
        {
          "s": 15,
          "text": "דאצילות הוא בכלל ד' העולמות אלא שהוא ה\"פנים\" שלהם,"
        },
        {
          "s": 16,
          "text": "פנימיות ששייך לחיצוניות,"
        },
        {
          "s": 17,
          "text": "ולמעלה מאצילות הוא למעלה מעולמות,"
        },
        {
          "s": 18,
          "text": "פנימיות שמובדל מחיצוניות."
        },
        {
          "s": 19,
          "text": "ועד\"ז הוא בפנימיות הלב,"
        },
        {
          "s": 20,
          "text": "פנים דהנשמות,"
        },
        {
          "s": 21,
          "text": "שיש בו דוגמת ב' מדריגות אלה."
        },
        {
          "s": 22,
          "text": "וכמבואר בלקו\"ת ד\"ה כי תצא למלחמה על אויביך21,"
        },
        {
          "s": 23,
          "text": "דבפנימיות הלב יש שתי מדריגות,"
        },
        {
          "s": 24,
          "text": "הארת נקודת הלב ועצמות נקודת הלב,"
        },
        {
          "s": 25,
          "text": "דשתי המדריגות הם מאצילות"
        },
        {
          "s": 26,
          "text": "[דזהו החילוק שבין חיצוניות הלב לפנימיות הלב,"
        },
        {
          "s": 27,
          "text": "שחיצוניות הלב הוא מבי\"ע ופנימיות הלב הוא מאצילות."
        },
        {
          "s": 28,
          "text": "וזהו מה שחיצוניות הלב הוא ע\"פ טעם ודעת ופנימיות הלב הוא למעלה מטעם ודעת,"
        },
        {
          "s": 29,
          "text": "כי בבריאה הוא ענין ההשגה,"
        },
        {
          "s": 30,
          "text": "אימא מקננא בכורסיא22,"
        },
        {
          "s": 31,
          "text": "ואצילות בכלל הוא חכמה,"
        },
        {
          "s": 32,
          "text": "דאמיתית ענין החכמה הוא למעלה מהשכל],"
        },
        {
          "s": 33,
          "text": "אלא שהארת נקודת הלב היא מאצילות שבפנימיות בי\"ע ועצמות נקודת הלב היא מאצילות עצמו."
        },
        {
          "s": 34,
          "text": "וכמו שלמעלה,"
        },
        {
          "s": 35,
          "text": "בחינת האצילות שבבי\"ע היא רק הארת האצילות,"
        },
        {
          "s": 36,
          "text": "עד\"ז הוא בנשמת האדם,"
        },
        {
          "s": 37,
          "text": "שבחינה זו היא רק הארת נקודת הלב."
        },
        {
          "s": 38,
          "text": "ונמצא,"
        },
        {
          "s": 39,
          "text": "שהארת נקודת הלב הוא מה שמאיר מפנימיות הלב לחיצוניות הלב"
        },
        {
          "s": 40,
          "text": "(ע\"ד הארת האצילות בבי\"ע),"
        },
        {
          "s": 41,
          "text": "ועצמות נקודת הלב הוא הפנימיות כמו שהוא במקומו."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ועד\"ז הוא גם בהפנימיות דאלקות,"
        },
        {
          "s": 1,
          "text": "שיש בו דוגמת ב' מדריגות הנ\"ל."
        },
        {
          "s": 2,
          "text": "ויובן זה ע\"פ מ\"ש בתניא23"
        },
        {
          "s": 3,
          "text": "בענין ב' השמות הוי' ואלקים,"
        },
        {
          "s": 4,
          "text": "דאלקים הוא חיצוניות והוי' הוא פנימיות."
        },
        {
          "s": 5,
          "text": "[ויש לקשר זה עם המבואר בלקו\"ת שם24,"
        },
        {
          "s": 6,
          "text": "דהאהבה שבחיצוניות הלב באה ע\"י ההתבוננות באור הממלא,"
        },
        {
          "s": 7,
          "text": "והאהבה"
        },
        {
          "s": 8,
          "text": "(רעו\"ד שלמעלה מטו\"ד)"
        },
        {
          "s": 9,
          "text": "שבפנימיות הלב נמשכת מאור הסובב,"
        },
        {
          "s": 10,
          "text": "כי הוי' ואלקים הם"
        },
        {
          "s": 11,
          "text": "(בד\"כ)"
        },
        {
          "s": 12,
          "text": "סובב וממלא25."
        },
        {
          "s": 13,
          "text": "ולכן,"
        },
        {
          "s": 14,
          "text": "אור הממלא"
        },
        {
          "s": 15,
          "text": "(אלקים),"
        },
        {
          "s": 16,
          "text": "חיצוניות26,"
        },
        {
          "s": 17,
          "text": "הוא שרש להאהבה דחיצוניות הלב,"
        },
        {
          "s": 18,
          "text": "ואור הסובב"
        },
        {
          "s": 19,
          "text": "(הוי'),"
        },
        {
          "s": 20,
          "text": "פנימיות,"
        },
        {
          "s": 21,
          "text": "הוא שרש להאהבה דפנימיות הלב]."
        },
        {
          "s": 22,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 23,
          "text": "דפירוש פניך הוי' הוא העצם דהוי' שלמעלה מהתלבשות באלקים."
        },
        {
          "s": 24,
          "text": "דזה שהוי'"
        },
        {
          "s": 25,
          "text": "(בכלל)"
        },
        {
          "s": 26,
          "text": "הוא פנימיות,"
        },
        {
          "s": 27,
          "text": "הוא גם לאחרי שמתלבש באלקים."
        },
        {
          "s": 28,
          "text": "ופניך הוי' הוא העצם דהוי' שלמעלה מהתלבשות באלקים."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ויש לומר דבחינת פניך הוי',"
        },
        {
          "s": 2,
          "text": "הפנימיות דהוי',"
        },
        {
          "s": 3,
          "text": "הוא למעלה גם מהוי' שלמעלה מהתלבשות באלקים."
        },
        {
          "s": 4,
          "text": "[וע\"ד המבואר במקום אחר27"
        },
        {
          "s": 5,
          "text": "בפירוש הכתוב28"
        },
        {
          "s": 6,
          "text": "ואמת הוי' לעולם,"
        },
        {
          "s": 7,
          "text": "דגם שם הוי' שלמעלה מהתלבשות באלקים הוא הוי'"
        },
        {
          "s": 8,
          "text": "(סתם),"
        },
        {
          "s": 9,
          "text": "ואמת הוי'"
        },
        {
          "s": 10,
          "text": "(האמיתית דהוי')"
        },
        {
          "s": 11,
          "text": "הוא עצמות אוא\"ס שלמעלה משם הוי',"
        },
        {
          "s": 12,
          "text": "למעלה גם מהוי' שלמעלה מהתלבשות באלקים]."
        },
        {
          "s": 13,
          "text": "ויובן זה ע\"פ הידוע29"
        },
        {
          "s": 14,
          "text": "דהפנימיות של כל דבר הוא הדבר עצמו,"
        },
        {
          "s": 15,
          "text": "וזה שהוא מקור לאיזה ענין אחר,"
        },
        {
          "s": 16,
          "text": "הוא החיצוניות שלו."
        },
        {
          "s": 17,
          "text": "ועפ\"ז יש לבאר החילוק בין שתי הדרגות בהפנימיות שלמעלה"
        },
        {
          "s": 18,
          "text": "(הוי' ואוא\"ס שלמעלה מהוי'),"
        },
        {
          "s": 19,
          "text": "דהוי' הוא לשון מהווה30,"
        },
        {
          "s": 20,
          "text": "אלא שההתהוות שמשם הוי' היא באופן דבדרך ממילא."
        },
        {
          "s": 21,
          "text": "וכידוע31"
        },
        {
          "s": 22,
          "text": "דההתהוות שמשם אלקים היא בדרך התלבשות"
        },
        {
          "s": 23,
          "text": "(בראשית ברא אלקים32),"
        },
        {
          "s": 24,
          "text": "וההתהוות משם הוי' היא באופן דבדרך ממילא"
        },
        {
          "s": 25,
          "text": "(יהללו את שם הוי' כי הוא צוה ונבראו33)."
        },
        {
          "s": 26,
          "text": "ולכן,"
        },
        {
          "s": 27,
          "text": "בכללות,"
        },
        {
          "s": 28,
          "text": "שם הוי' הוא פנימיות,"
        },
        {
          "s": 29,
          "text": "כי זה שההתהוות ממנו היא באופן דבדרך ממילא,"
        },
        {
          "s": 30,
          "text": "מורה על זה שהוא מופלא מענין ההתהוות34"
        },
        {
          "s": 31,
          "text": "(ואינו מקור ממש)."
        },
        {
          "s": 32,
          "text": "אבל בפרטיות,"
        },
        {
          "s": 33,
          "text": "זה שמשם הוי' נעשה ההתהוות,"
        },
        {
          "s": 34,
          "text": "הוא מפני שהוא מקור לההתהוות35,"
        },
        {
          "s": 35,
          "text": "ולכן,"
        },
        {
          "s": 36,
          "text": "עיקר ענין הפנימיות הוא בעצמות אוא\"ס שלמעלה מהוי'."
        }
      ]
    }
  ]
}