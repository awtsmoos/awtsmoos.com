{
  "globalIndex": 316,
  "owner": 16,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915585_theRebbe_828__p003",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915585_theRebbe_828__p003",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915585_theRebbe_828",
  "title": "מאמר פתח אליהו תשט\"ו",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ומבואר בהדרושים17,"
        },
        {
          "s": 2,
          "text": "דשתי הדיעות הם אמת,"
        },
        {
          "s": 3,
          "text": "דשתיהם יש להם שרש בעצמות אוא\"ס,"
        },
        {
          "s": 4,
          "text": "דבאוא\"ס ישנם שני ענינים."
        },
        {
          "s": 5,
          "text": "שהוא למעלה מעלה עד אין קץ18"
        },
        {
          "s": 6,
          "text": "ושהוא למטה מטה עד אין תכלית18."
        },
        {
          "s": 7,
          "text": "ושני ענינים אלה הם השרש דדעת תחתון ודעת עליון."
        },
        {
          "s": 8,
          "text": "שמצד הגילוי דאוא\"ס,"
        },
        {
          "s": 9,
          "text": "שהוא בגילוי בכל מקום למטה מטה עד אין תכלית,"
        },
        {
          "s": 10,
          "text": "כולא קמי' כלא חשיב – דעת עליון שלמטה אין."
        },
        {
          "s": 11,
          "text": "ומצד ההעלם דאוא\"ס,"
        },
        {
          "s": 12,
          "text": "שהוא מתעלה בעצמותו למעלה מעלה עד אין קץ,"
        },
        {
          "s": 13,
          "text": "הנבראים הם במציאות יש – דעת תחתון שלמטה יש."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "וצריך להבין19,"
        },
        {
          "s": 1,
          "text": "דכיון שגם דעת תחתון שרשו הוא בעצמות אוא\"ס,"
        },
        {
          "s": 2,
          "text": "הרי השלימות דדעת תחתון הוא לכאורה שיהי' בו בגילוי דזה שלמטה יש הוא"
        },
        {
          "s": 3,
          "text": "(לא שהנבראים מצד עצמם הם מציאות יש,"
        },
        {
          "s": 4,
          "text": "אלא)"
        },
        {
          "s": 5,
          "text": "מפני שאוא\"ס הוא למעלה מעלה עד אין קץ,"
        },
        {
          "s": 6,
          "text": "ובהדרושים מבואר,"
        },
        {
          "s": 7,
          "text": "שהשלימות דדעת תחתון הוא ע\"י שמאיר בו הגילוי דדעת עליון."
        },
        {
          "s": 8,
          "text": "גם צריך להבין לאידך,"
        },
        {
          "s": 9,
          "text": "במ\"ש בהדרושים שגם דעת תחתון הוא אמת לפי שיש לו שרש בעצמות אוא\"ס,"
        },
        {
          "s": 10,
          "text": "דלכאורה,"
        },
        {
          "s": 11,
          "text": "כיון שהענין דלמעלה מעלה עד אין קץ"
        },
        {
          "s": 12,
          "text": "(השרש דדעת תחתון)"
        },
        {
          "s": 13,
          "text": "הוא ההעלם דאוא\"ס,"
        },
        {
          "s": 14,
          "text": "הרי ההרגש דלמטה יש"
        },
        {
          "s": 15,
          "text": "(כמו שנרגש בדעת תחתון)"
        },
        {
          "s": 16,
          "text": "הוא לכאורה לא מצד אוא\"ס אלא אדרבה,"
        },
        {
          "s": 17,
          "text": "לפי שלא נרגש בו אוא\"ס,"
        },
        {
          "s": 18,
          "text": "ואעפ\"כ אומרים,"
        },
        {
          "s": 19,
          "text": "שהדיעה שלמטה יש"
        },
        {
          "s": 20,
          "text": "(כמו שהוא בדעת תחתון)"
        },
        {
          "s": 21,
          "text": "היא דיעה אמיתית."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והענין הוא,"
        },
        {
          "s": 2,
          "text": "דמבואר בהדרושים20,"
        },
        {
          "s": 3,
          "text": "דבטבע כמה פירושים."
        },
        {
          "s": 4,
          "text": "דבשו\"ת חכם צבי21"
        },
        {
          "s": 5,
          "text": "איתא,"
        },
        {
          "s": 6,
          "text": "דשם טבע הוא שם חדש שחידשו חכמים האחרונים."
        },
        {
          "s": 7,
          "text": "דכיון שהכל"
        },
        {
          "s": 8,
          "text": "(גם הטבע)"
        },
        {
          "s": 9,
          "text": "הוא מאתו ית',"
        },
        {
          "s": 10,
          "text": "הרי גם הטבע הוא נס."
        },
        {
          "s": 11,
          "text": "אלא שנסים אלו הם תמיד,"
        },
        {
          "s": 12,
          "text": "נסים רצופים."
        },
        {
          "s": 13,
          "text": "ויש אומרים22"
        },
        {
          "s": 14,
          "text": "שטבע הוא מלשון מטבע."
        },
        {
          "s": 15,
          "text": "דאיתא במשנה23,"
        },
        {
          "s": 16,
          "text": "אדם טובע כמה מטבעות בחותם אחד וכולן דומין זה לזה,"
        },
        {
          "s": 17,
          "text": "ומלך מלכי המלכים הקב\"ה טבע כל אדם בחותמו של אדם הראשון ואין אחד מהן דומה לחבירו."
        },
        {
          "s": 18,
          "text": "ובתניא24"
        },
        {
          "s": 19,
          "text": "איתא,"
        },
        {
          "s": 20,
          "text": "דטבע הוא שם המושאל לכל דבר שאינו ע\"פ טעם ודעת."
        }
      ]
    }
  ]
}