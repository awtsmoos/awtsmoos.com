{
  "globalIndex": 1094,
  "owner": 44,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920368_theRebbe_469__p002",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920368_theRebbe_469__p002",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920368_theRebbe_469",
  "title": "מאמר השקיפה ממעון קדשך תשכ\"ז",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ולבאר זה מקדים בהמאמר דאיתא בירושלמי10"
        },
        {
          "s": 2,
          "text": "בוא וראה כמה גדול כוחן של עושי מצוה,"
        },
        {
          "s": 3,
          "text": "שכל השקפה שבתורה ארורה וזה בלשון ברכה."
        },
        {
          "s": 4,
          "text": "דע\"י קיום המצוות מהפכים את הקללה לברכה"
        },
        {
          "s": 5,
          "text": "[ובהמשך לזה מבאר הפסוק11"
        },
        {
          "s": 6,
          "text": "ולא אבה הוי' אלקיך לשמוע אל בלעם ויהפוך הוי' אלקיך לך את הקללה לברכה כי אהבך הוי' אלקיך,"
        },
        {
          "s": 7,
          "text": "שאומר ג' פעמים הוי' אלקיך,"
        },
        {
          "s": 8,
          "text": "כדלקמן סעיף ד]."
        },
        {
          "s": 9,
          "text": "ולאח\"ז12"
        },
        {
          "s": 10,
          "text": "מבאר שני הסוגים דעמך וישראל,"
        },
        {
          "s": 11,
          "text": "דיודעי תורה ויושבי אהל הם ישראל,"
        },
        {
          "s": 12,
          "text": "ואנשים פשוטים שמקיימים תורה ומצוות בתמימות ובפשטות הם עם הוי'"
        },
        {
          "s": 13,
          "text": "(עמך)13."
        },
        {
          "s": 14,
          "text": "ומקדים עמך לישראל,"
        },
        {
          "s": 15,
          "text": "כי גדול תלמוד שמביא לידי מעשה14"
        },
        {
          "s": 16,
          "text": "ועושי מצוה מהפכים את הקללה לברכה."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "שהשייכות דגדול תלמוד שמביא לידי מעשה לזה שמקדים עמך לישראל,"
        },
        {
          "s": 2,
          "text": "הוא,"
        },
        {
          "s": 3,
          "text": "כי מזה שגדול תלמוד הוא לפי15"
        },
        {
          "s": 4,
          "text": "שהתלמוד מביא לידי מעשה מוכח שהמעשה הוא העיקר16."
        },
        {
          "s": 5,
          "text": "אלא שזה בלבד אינו ביאור מספיק על זה שמקדים עמך"
        },
        {
          "s": 6,
          "text": "(מקיימי מצוות)"
        },
        {
          "s": 7,
          "text": "לישראל"
        },
        {
          "s": 8,
          "text": "(לומדי תורה),"
        },
        {
          "s": 9,
          "text": "שהרי במרז\"ל זה עצמו אומר גדול תלמוד."
        },
        {
          "s": 10,
          "text": "ולכן מוסיף שעושי מצוה מהפכים הקללה לברכה,"
        },
        {
          "s": 11,
          "text": "היינו שבענין זה"
        },
        {
          "s": 12,
          "text": "(דהפיכת קללה לברכה)"
        },
        {
          "s": 13,
          "text": "מתגלה המעלה שבמעשה לגבי תלמוד"
        },
        {
          "s": 14,
          "text": "(ע\"ד לע\"ל שאז יהי' מעשה גדול17)."
        },
        {
          "s": 15,
          "text": "וכיון שענין השקיפה גו' וברך הוא הפיכת קללה לברכה"
        },
        {
          "s": 16,
          "text": "(כנ\"ל מירושלמי)"
        },
        {
          "s": 17,
          "text": "לכן מקדים עמך לישראל."
        },
        {
          "s": 18,
          "text": "וצריך להבין השייכות דהפיכת קללה לברכה למעלת המעשה."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה לאחרי שמבאר בהמאמר שע\"י קיום המצוות מהפכים קללה לברכה,"
        },
        {
          "s": 2,
          "text": "מביא בהמאמר מ\"ש ולא אבה הוי' אלקיך לשמוע אל בלעם ויהפוך הוי' אלקיך לך את הקללה לברכה כי אהבך הוי' אלקיך,"
        },
        {
          "s": 3,
          "text": "ומבאר,"
        },
        {
          "s": 4,
          "text": "שבפסוק זה – ג' ענינים."
        },
        {
          "s": 5,
          "text": "ובכל אחד מהם אומר הוי' אלקיך18."
        },
        {
          "s": 6,
          "text": "ענין ולא אבה גו' לשמוע אל בלעם הוא שהקב\"ה אינו רוצה לשמוע ואינו שומע קטרוגים על ישראל."
        },
        {
          "s": 7,
          "text": "וזה שאינו שומע את הקטרוגים"
        },
        {
          "s": 8,
          "text": "(אף שמצד מדת הדין יש להם מקום19)"
        },
        {
          "s": 9,
          "text": "הוא מצד מדת הרחמים,"
        },
        {
          "s": 10,
          "text": "הוי' אלקיך."
        },
        {
          "s": 11,
          "text": "וענין ויהפוך לך את הקללה לברכה הוא שזדונות20"
        },
        {
          "s": 12,
          "text": "נהפכים לזכיות21"
        },
        {
          "s": 13,
          "text": "[דלא רק שאין שומעים להמקטרגים"
        },
        {
          "s": 14,
          "text": "(אבל העוונות לא נמחקו),"
        },
        {
          "s": 15,
          "text": "אלא שנעשה כפרת העוונות,"
        },
        {
          "s": 16,
          "text": "ויתירה מזו,"
        },
        {
          "s": 17,
          "text": "שזדונות נהפכים לזכיות]."
        },
        {
          "s": 18,
          "text": "ואומר כאן הוי' אלקיך פעם שני',"
        },
        {
          "s": 19,
          "text": "כי הוי' שממנו נמשך ולא אבה לשמוע להמקטרגים הוא הוי' דלתתא,"
        },
        {
          "s": 20,
          "text": "ובכדי שתהי' כפרת עוונות,"
        },
        {
          "s": 21,
          "text": "ובפרט הפיכת זדונות לזכיות,"
        },
        {
          "s": 22,
          "text": "הוא ע\"י המשכת גילוי הוי' דלעילא22."
        },
        {
          "s": 23,
          "text": "וענין כי אהבך היא האהבה העצמית דהקב\"ה לישראל,"
        },
        {
          "s": 24,
          "text": "שגם בהדרגא דלמעלה מהשתלשלות שבה נאמר כי אח עשו ליעקב23,"
        },
        {
          "s": 25,
          "text": "מ\"מ ואוהב את יעקב23"
        },
        {
          "s": 26,
          "text": "דוקא."
        },
        {
          "s": 27,
          "text": "וזהו הוי' אלקיך,"
        },
        {
          "s": 28,
          "text": "דהגם שבהוי' דלעילא"
        },
        {
          "s": 29,
          "text": "(אוא\"ס שלמעלה מהשתלשלות)"
        },
        {
          "s": 30,
          "text": "הכל שוין,"
        },
        {
          "s": 31,
          "text": "מ\"מ,"
        },
        {
          "s": 32,
          "text": "ע\"י גילוי האהבה העצמית דהקב\"ה לישראל"
        },
        {
          "s": 33,
          "text": "(כי אהבך),"
        },
        {
          "s": 34,
          "text": "גם הוי' דלעילא הוא אלקיך"
        },
        {
          "s": 35,
          "text": "(דישראל)"
        },
        {
          "s": 36,
          "text": "דוקא."
        },
        {
          "s": 37,
          "text": "ולאחרי זה מבאר בהמאמר24"
        },
        {
          "s": 38,
          "text": "הטעם שמקדים עמך"
        },
        {
          "s": 39,
          "text": "(מקיימי מצוות)"
        },
        {
          "s": 40,
          "text": "לישראל"
        },
        {
          "s": 41,
          "text": "(לומדי תורה),"
        },
        {
          "s": 42,
          "text": "כי"
        },
        {
          "s": 43,
          "text": "[גדול תלמוד שמביא לידי מעשה ו]"
        },
        {
          "s": 44,
          "text": "עושי מצוה מהפכים את הקללה לברכה"
        },
        {
          "s": 45,
          "text": "(כנ\"ל סעיף ג)."
        },
        {
          "s": 46,
          "text": "וצריך להבין,"
        },
        {
          "s": 47,
          "text": "דלכאורה,"
        },
        {
          "s": 48,
          "text": "בכדי לבאר הטעם שמקדים עמך לישראל נוגע רק שעושי מצוה מהפכים קללה לברכה,"
        },
        {
          "s": 49,
          "text": "ומזה שמקדים בהמאמר"
        },
        {
          "s": 50,
          "text": "(גם)"
        },
        {
          "s": 51,
          "text": "הביאור דג' הענינים שבפסוק ולא אבה גו' לשמוע אל בלעם,"
        },
        {
          "s": 52,
          "text": "משמע,"
        },
        {
          "s": 53,
          "text": "שזה מוסיף ביאור בזה שמקדים עמך לישראל."
        }
      ]
    }
  ]
}