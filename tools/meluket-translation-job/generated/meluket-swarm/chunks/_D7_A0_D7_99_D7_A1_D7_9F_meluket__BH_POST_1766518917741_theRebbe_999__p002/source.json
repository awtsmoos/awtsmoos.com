{
  "globalIndex": 674,
  "owner": 24,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917741_theRebbe_999__p002",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917741_theRebbe_999__p002",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917741_theRebbe_999",
  "title": "מאמר אשה כי תזריע תשכ\"ה",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והענין הוא,"
        },
        {
          "s": 2,
          "text": "דהנה המעלה שבאתערותא דלעילא"
        },
        {
          "s": 3,
          "text": "(שמצד עצמה)"
        },
        {
          "s": 4,
          "text": "היא שההמשכה היא ממקום שאין אתערותא דלתתא מגעת לשם,"
        },
        {
          "s": 5,
          "text": "וההמשכה היא מצד כי13"
        },
        {
          "s": 6,
          "text": "חפץ חסד הוא14."
        },
        {
          "s": 7,
          "text": "וע\"פ הידוע15"
        },
        {
          "s": 8,
          "text": "בענין במי נמלך בנשמותיהן של צדיקים16"
        },
        {
          "s": 9,
          "text": "(ועמך כולם צדיקים17),"
        },
        {
          "s": 10,
          "text": "דזה שנתעורר כביכול להיות חפץ חסד הוא מצד זה שעלה במחשבה"
        },
        {
          "s": 11,
          "text": "(מחשבה עצמית,"
        },
        {
          "s": 12,
          "text": "שלמעלה מהגילוי דחפץ חסד)"
        },
        {
          "s": 13,
          "text": "שעתידין ישראל לקיים תומ\"צ ולעשות דירה לו ית' בתחתונים,"
        },
        {
          "s": 14,
          "text": "מובן,"
        },
        {
          "s": 15,
          "text": "שהשרש דעבודתם של ישראל הוא למעלה יותר גם מהענין דחפץ חסד."
        },
        {
          "s": 16,
          "text": "וע\"י שהגילוי דחפץ חסד נתעורר ונמשך ע\"י עבודת האדם,"
        },
        {
          "s": 17,
          "text": "מיתוסף בו עילוי נעלה יותר"
        },
        {
          "s": 18,
          "text": "(מכמו שהוא מצד עצמו,"
        },
        {
          "s": 19,
          "text": "מצד למעלה),"
        },
        {
          "s": 20,
          "text": "שנמשך בו מהמחשבה עצמית שלמעלה מגילוי."
        },
        {
          "s": 21,
          "text": "ועפ\"ז יש לבאר,"
        },
        {
          "s": 22,
          "text": "דזה שבחודש ניסן"
        },
        {
          "s": 23,
          "text": "(שענינו הוא המשכה מלמעלה)"
        },
        {
          "s": 24,
          "text": "קוראין אשה כי תזריע וילדה זכר"
        },
        {
          "s": 25,
          "text": "(ההדגשה במעלת אתערותא דלתתא)"
        },
        {
          "s": 26,
          "text": "הוא,"
        },
        {
          "s": 27,
          "text": "כי עיקר העילוי בההמשכה מלמעלה"
        },
        {
          "s": 28,
          "text": "(והגילוי דחפץ חסד)"
        },
        {
          "s": 29,
          "text": "הוא כשהיא נמשכת ע\"י עבודה."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה ענין זה"
        },
        {
          "s": 2,
          "text": "(שאשה מזרעת תחלה יולדת זכר מורה על המעלה שבאתערותא דלתתא)"
        },
        {
          "s": 3,
          "text": "הוא גם להפירוש שלידת הזכר הוא מטיפת האיש הבאה באחרונה דעילאה גבר."
        },
        {
          "s": 4,
          "text": "אלא שלפירוש זה,"
        },
        {
          "s": 5,
          "text": "המעלה באתערותא דלתתא"
        },
        {
          "s": 6,
          "text": "(זרע האשה)"
        },
        {
          "s": 7,
          "text": "הוא שהיא סיבה שהאתערותא דלעילא הנמשכת על ידה תהי' מבחי' נעלית יותר18"
        },
        {
          "s": 8,
          "text": "(עילאה גבר),"
        },
        {
          "s": 9,
          "text": "ולהפירוש שלידת הזכר הוא מזרע האשה,"
        },
        {
          "s": 10,
          "text": "המעלה שבאתערותא דלתתא היא"
        },
        {
          "s": 11,
          "text": "(גם)"
        },
        {
          "s": 12,
          "text": "מצד עצמה."
        },
        {
          "s": 13,
          "text": "ועפ\"ז יש לומר הרמז בהסדר דשני הפירושים,"
        },
        {
          "s": 14,
          "text": "דזה שמקדים הפירוש שלידת הזכר הוא מזרע האיש,"
        },
        {
          "s": 15,
          "text": "אף שהמסקנא היא שהוא מזרע האשה,"
        },
        {
          "s": 16,
          "text": "כי בתחלת העבודה,"
        },
        {
          "s": 17,
          "text": "מעלת האתערותא דלתתא היא שהאתערותא דלעילא הנמשכת על ידה היא נעלית יותר,"
        },
        {
          "s": 18,
          "text": "ועי\"ז מתגלית אח\"כ המעלה שבאתערותא דלתתא גופא."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ויובן זה ע\"פ המבואר בלקו\"ת19"
        },
        {
          "s": 1,
          "text": "שיש בחינה שלישית באתערותא דלעילא,"
        },
        {
          "s": 2,
          "text": "שהיא בדרך מתנה."
        },
        {
          "s": 3,
          "text": "שגם אתערותא דלעילא זו נמשכת ממקום שאין אתערותא דלתתא מגעת שם כלל,"
        },
        {
          "s": 4,
          "text": "אלא שבכדי שיהי' הגילוי של אתערותא דלעילא זו צ\"ל תחלה השלימות דמעשה התחתונים,"
        },
        {
          "s": 5,
          "text": "האתעדל\"ת והאתעדל\"ע שנמשכת על ידה."
        },
        {
          "s": 6,
          "text": "וצריך להבין,"
        },
        {
          "s": 7,
          "text": "הרי הכוונה דנתאוה הקב\"ה להיות לו ית' דירה בתחתונים20"
        },
        {
          "s": 8,
          "text": "היא שעשיית הדירה תהי' ע\"י עבודת האדם,"
        },
        {
          "s": 9,
          "text": "דמזה מובן,"
        },
        {
          "s": 10,
          "text": "שגם גילויים הכי נעלים,"
        },
        {
          "s": 11,
          "text": "גם האור שלמעלה מהשייכות לנבראים"
        },
        {
          "s": 12,
          "text": "(שאין בכח האתערותא דלתתא להגיע לשם),"
        },
        {
          "s": 13,
          "text": "ועד לגילוי העצמות21,"
        },
        {
          "s": 14,
          "text": "נמשכים הם ע\"י עבודת האדם22,"
        },
        {
          "s": 15,
          "text": "ואיך זה מתאים עם המובא לעיל מלקו\"ת שע\"י העבודה נמשך רק מבחינה שאתערותא דלתתא מגעת לשם,"
        },
        {
          "s": 16,
          "text": "והמשכת הבחינות שלמעלה מזה היא בדרך מתנה מלמעלה."
        },
        {
          "s": 17,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 18,
          "text": "דזה שאתערותא דלתתא מגעת רק באור השייך לעולמות הוא מצד ענין הנבראים"
        },
        {
          "s": 19,
          "text": "[אתערותא דלתתא כמו שהוא בבחינת \"תתא\","
        },
        {
          "s": 20,
          "text": "הנבדל מ\"עילא\"]."
        },
        {
          "s": 21,
          "text": "אבל מצד כח העצמות שישנו בעבודתם של ישראל"
        },
        {
          "s": 22,
          "text": "[וכמשנת\"ל"
        },
        {
          "s": 23,
          "text": "(סעיף ג)"
        },
        {
          "s": 24,
          "text": "בענין במי נמלך בנשמותיהן של צדיקים,"
        },
        {
          "s": 25,
          "text": "ששרש העבודה דישראל הוא במחשבה העצמית שבעצמותו ית',"
        },
        {
          "s": 26,
          "text": "שלמעלה מכל הגילויים,"
        },
        {
          "s": 27,
          "text": "גם מהגילויים הכי נעלים],"
        },
        {
          "s": 28,
          "text": "אין שייך לחלק בין \"תתא\" ל\"עילא\","
        },
        {
          "s": 29,
          "text": "דישראל וקוב\"ה כולא חד."
        },
        {
          "s": 30,
          "text": "אלא שגילוי ענין זה"
        },
        {
          "s": 31,
          "text": "(השרש דעבודת ישראל כמו שהוא במחשבה העצמית)"
        },
        {
          "s": 32,
          "text": "הוא דוקא לאחרי שנשלם כל השייך לעבודת האדם,"
        },
        {
          "s": 33,
          "text": "העבודה עצמה"
        },
        {
          "s": 34,
          "text": "(אתערותא דלתתא)"
        },
        {
          "s": 35,
          "text": "וההמשכה מלמעלה"
        },
        {
          "s": 36,
          "text": "(אתערותא דלעילא)"
        },
        {
          "s": 37,
          "text": "שבאה על ידה."
        },
        {
          "s": 38,
          "text": "ולכן,"
        },
        {
          "s": 39,
          "text": "תחלת ההמשכה הבאה ע\"י העבודה"
        },
        {
          "s": 40,
          "text": "(לפני שנתגלה כח העצמות שבה)"
        },
        {
          "s": 41,
          "text": "היא רק מהאור השייך לעולמות,"
        },
        {
          "s": 42,
          "text": "מקום שאתערותא דלתתא מגעת לשם,"
        },
        {
          "s": 43,
          "text": "אבל לאחרי השלימות דעבודה"
        },
        {
          "s": 44,
          "text": "(הן דהעבודה עצמה והן דההמשכה מלמעלה שעל ידה),"
        },
        {
          "s": 45,
          "text": "שאז מתגלה ה\"פנימיות\" שלה,"
        },
        {
          "s": 46,
          "text": "הנחת רוח והתענוג שלמעלה שבעבודת ישראל,"
        },
        {
          "s": 47,
          "text": "נחת רוח לפני שאמרתי ונעשה רצוני23,"
        },
        {
          "s": 48,
          "text": "דנחת רוח ותענוג זה"
        },
        {
          "s": 49,
          "text": "(שנעשה רצוני,"
        },
        {
          "s": 50,
          "text": "ע\"י ישראל)"
        },
        {
          "s": 51,
          "text": "הוא בעצמותו ית'"
        },
        {
          "s": 52,
          "text": "(נחת רוח לפני)24,"
        },
        {
          "s": 53,
          "text": "ע\"י העבודה נמשך גם האור שלמעלה משייכות לעולמות25,"
        },
        {
          "s": 54,
          "text": "ועד להמשכת העצמות."
        }
      ]
    }
  ]
}