  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919787_theRebbe_472__p004",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919787_theRebbe_472__p004",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919787_theRebbe_472",
  "title": "מאמר איכה ישבה בדד תשל\"א",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "וזהו שע\"י מעשינו ועבודתנו דעכשיו ממשיכים שבקרוב ממש יבנה ויתגלה75"
        },
        {
          "s": 1,
          "text": "בית השלישי,"
        },
        {
          "s": 2,
          "text": "בחי' בטח בדד עין יעקב,"
        },
        {
          "s": 3,
          "text": "שתהי' בו גם ההתכללות דבית ראשון ובית שני ואז הוי' בדד ינחנו"
        },
        {
          "s": 4,
          "text": "(לכאו\"א מבנ\"י)"
        },
        {
          "s": 5,
          "text": "אע\"פ"
        },
        {
          "s": 6,
          "text": "(וע\"י)"
        },
        {
          "s": 7,
          "text": "שימצאהו בארץ מדבר ובתוהו גו'"
        },
        {
          "s": 8,
          "text": "(עבודה בזה\"ג)"
        },
        {
          "s": 9,
          "text": "ויבוא מהמדבר לבדד ינחנו באופן דכתיב לעיל מיני' כנשר יעיר קנו,"
        },
        {
          "s": 10,
          "text": "ברחמים ובחמלה – שבקרוב ממש תבוא הגאולה בחסד וברחמים,"
        },
        {
          "s": 11,
          "text": "ותהי' אז שלימות הכוונה דנתאוה הקב\"ה להיות לו ית' דירה בתחתונים."
        }
      ]
    }
  ]
}