{
  "globalIndex": 635,
  "owner": 35,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917442_theRebbe_735__p003",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917442_theRebbe_735__p003",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917442_theRebbe_735",
  "title": "מאמר על כן קראו תשי\"ג",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "וצריך להבין,"
        },
        {
          "s": 2,
          "text": "דלפי הנ\"ל שע\"י הפור הוא הגורל הוא המשכת אוא\"ס בעל הרצון,"
        },
        {
          "s": 3,
          "text": "שעי\"ז נתכפרו כל הענינים הבלתי רצויים,"
        },
        {
          "s": 4,
          "text": "מה היתה סברתו של המן הרשע"
        },
        {
          "s": 5,
          "text": "(שקטרג על היהודים31)"
        },
        {
          "s": 6,
          "text": "להפיל פור הוא הגורל."
        },
        {
          "s": 7,
          "text": "גם צריך להבין מ\"ש על כן קראו לימים האלה פורים על שם ה."
        },
        {
          "s": 8,
          "text": "פור,"
        },
        {
          "s": 9,
          "text": "דהפור"
        },
        {
          "s": 10,
          "text": "(בה\"א הידיעה)"
        },
        {
          "s": 11,
          "text": "קאי על הפור שנאמר לפנ\"ז היינו הפור שהפיל המן,"
        },
        {
          "s": 12,
          "text": "והרי הפור שהפיל המן הי' ענין בלתי רצוי ולמה נקראים ימים האלה פורים על שם פור זה."
        },
        {
          "s": 13,
          "text": "ונקודת הביאור בזה,"
        },
        {
          "s": 14,
          "text": "שמצד הדרגא דהשתלשלות,"
        },
        {
          "s": 15,
          "text": "כיון שבדרגא זו מעשה התחתונים תופס מקום,"
        },
        {
          "s": 16,
          "text": "עיקר ההשפעה היא לישראל,"
        },
        {
          "s": 17,
          "text": "לפי שישראל הם מקיימים תומ\"צ,"
        },
        {
          "s": 18,
          "text": "ואפילו אלו שהם היפך צדיקים הם מלאים מצוות כרמון32."
        },
        {
          "s": 19,
          "text": "וכמ\"ש33"
        },
        {
          "s": 20,
          "text": "השקיפה ממעון קדשך מן השמים וברך את עמך את ישראל,"
        },
        {
          "s": 21,
          "text": "שמצד בחינת שמים"
        },
        {
          "s": 22,
          "text": "[שמים הוא שם מים34,"
        },
        {
          "s": 23,
          "text": "ומים הוא חכמה ראשית ההשתלשלות],"
        },
        {
          "s": 24,
          "text": "נשפעים הברכות לישראל35."
        },
        {
          "s": 25,
          "text": "וכיון שגם המן הרשע ידע שלאחרי כל הקטרוגים שקטרג על ישראל אין שום דמיון בינו ובין ישראל"
        },
        {
          "s": 26,
          "text": "[שלכן,"
        },
        {
          "s": 27,
          "text": "מצד הדרגא דהשתלשלות אין שייך שהמן הרשע ינצח ח\"ו את ישראל שגם הפחותים שבהם מלאים מצוות כרמון],"
        },
        {
          "s": 28,
          "text": "לכן הפיל פור הוא הגורל,"
        },
        {
          "s": 29,
          "text": "דכיון שבהדרגא דלמעלה מהשתלשלות"
        },
        {
          "s": 30,
          "text": "(גורל)"
        },
        {
          "s": 31,
          "text": "אין מעשה התחתונים תופס מקום,"
        },
        {
          "s": 32,
          "text": "והכל שוים שם,"
        },
        {
          "s": 33,
          "text": "כחשיכה כאורה36,"
        },
        {
          "s": 34,
          "text": "לכן חשב שמצד דרגת הגורל שלמעלה מהשתלשלות יש מקום שהוא ינצח ח\"ו את ישראל."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ויש לקשר זה עם המבואר במק\"א37"
        },
        {
          "s": 2,
          "text": "בענין אחשורוש,"
        },
        {
          "s": 3,
          "text": "דאחשורוש הוא אחש ורוש38."
        },
        {
          "s": 4,
          "text": "חש הוא מלשון שתיקה"
        },
        {
          "s": 5,
          "text": "[כדאיתא בגמרא39"
        },
        {
          "s": 6,
          "text": "מאי חשמל כו' עתים חשות עתים ממללות],"
        },
        {
          "s": 7,
          "text": "והשתיקה דחש היא למעלה מדיבור40,"
        },
        {
          "s": 8,
          "text": "ע\"ד מלה בסלע שתיקותא בתרי41."
        },
        {
          "s": 9,
          "text": "דשרש הדיבור הוא בחכמה42,"
        },
        {
          "s": 10,
          "text": "ושתיקה היא בכתר שלמעלה מהחכמה,"
        },
        {
          "s": 11,
          "text": "כמארז\"ל43"
        },
        {
          "s": 12,
          "text": "סיג לחכמה שתיקה44,"
        },
        {
          "s": 13,
          "text": "דסיג לחכמה"
        },
        {
          "s": 14,
          "text": "(סיג מלשון גדר ומקיף)"
        },
        {
          "s": 15,
          "text": "הוא הכתר שלמעלה מהחכמה."
        },
        {
          "s": 16,
          "text": "ויש לקשר זה עם מה דאיתא במדרש45"
        },
        {
          "s": 17,
          "text": "שאחשורוש זה הקב\"ה שאחרית וראשית שלו46,"
        },
        {
          "s": 18,
          "text": "כי כתר הוא"
        },
        {
          "s": 19,
          "text": "(בכלל)"
        },
        {
          "s": 20,
          "text": "אור הסובב שלמעלה מהשתלשלות,"
        },
        {
          "s": 21,
          "text": "דאור הסובב כולל אחרית וראשית בשוה,"
        },
        {
          "s": 22,
          "text": "אחרית וראשית שלו47."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "וצריך להבין,"
        },
        {
          "s": 1,
          "text": "דבגמרא48"
        },
        {
          "s": 2,
          "text": "איתא דאחשורוש הוא על שם שהושחרו פניהם של ישראל בימיו,"
        },
        {
          "s": 3,
          "text": "ואיך זה מתאים עם הפירוש שאחשורוש הוא מי שאחרית וראשית שלו."
        },
        {
          "s": 4,
          "text": "והענין הוא,"
        },
        {
          "s": 5,
          "text": "דהיא הנותנת."
        },
        {
          "s": 6,
          "text": "דכיון שמצד הסובב שלמעלה מהשתלשלות אור וחושך שוים לפניו"
        },
        {
          "s": 7,
          "text": "(כנ\"ל סעיף ה),"
        },
        {
          "s": 8,
          "text": "לכן,"
        },
        {
          "s": 9,
          "text": "מבחינת השתיקה"
        },
        {
          "s": 10,
          "text": "(חש דאחשורוש)"
        },
        {
          "s": 11,
          "text": "שלמעלה מדיבור נשתלשל"
        },
        {
          "s": 12,
          "text": "(ע\"י ריבוי צמצומים וכו')"
        },
        {
          "s": 13,
          "text": "השתיקה שלמטה מדיבור49,"
        },
        {
          "s": 14,
          "text": "שהאלקות הוא בהעלם"
        },
        {
          "s": 15,
          "text": "(העלם כפשוטו שלמטה מגילוי),"
        },
        {
          "s": 16,
          "text": "ועד להשתיקה דכרחל לפני גוזזי' נאלמה50,"
        },
        {
          "s": 17,
          "text": "דלא רק שהאלקות אינו מאיר בגילוי אלא שגם הקליפה מסתרת על האלקות,"
        },
        {
          "s": 18,
          "text": "קליפת נוגה שנקראת חש51,"
        },
        {
          "s": 19,
          "text": "ועד שמתחברת עם גקה\"ט,"
        },
        {
          "s": 20,
          "text": "רוש52."
        }
      ]
    }
  ]
}