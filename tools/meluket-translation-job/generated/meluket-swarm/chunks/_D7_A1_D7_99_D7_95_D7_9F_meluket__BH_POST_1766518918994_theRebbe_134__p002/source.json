{
  "globalIndex": 883,
  "owner": 33,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918994_theRebbe_134__p002",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918994_theRebbe_134__p002",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918994_theRebbe_134",
  "title": "מאמר בשעה שעלה משה למרום תשכ\"א",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והענין הוא,"
        },
        {
          "s": 2,
          "text": "דטענת המלאכים על נתינת התורה לישראל לא היתה על זה שנותנים את התורה לנשמות"
        },
        {
          "s": 3,
          "text": "(ישראל),"
        },
        {
          "s": 4,
          "text": "כי גם המלאכים ידעו שנשמות הם במדריגה נעלית יותר מהמלאכים,"
        },
        {
          "s": 5,
          "text": "אלא טענתם היתה על זה שנותנים את התורה להגוף,"
        },
        {
          "s": 6,
          "text": "כלשון הגמרא,"
        },
        {
          "s": 7,
          "text": "אתה מבקש ליתנה לבשר ודם."
        },
        {
          "s": 8,
          "text": "ויתירה מזה,"
        },
        {
          "s": 9,
          "text": "שגם בנוגע להגוף,"
        },
        {
          "s": 10,
          "text": "לא היתה טענתם על זה שנותנים התורה לגוף בכלל"
        },
        {
          "s": 11,
          "text": "(גוף רוחני),"
        },
        {
          "s": 12,
          "text": "אלא על נתינת התורה לגוף האדם שהוא גוף גשמי,"
        },
        {
          "s": 13,
          "text": "כלשון הגמרא"
        },
        {
          "s": 14,
          "text": "(הנ\"ל)"
        },
        {
          "s": 15,
          "text": "אתה מבקש ליתנה לבשר ודם."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "וביאור הענין9,"
        },
        {
          "s": 1,
          "text": "דהנה מצינו ששירת המלאכים נזכרה בנביאים,"
        },
        {
          "s": 2,
          "text": "וכמ\"ש בההפטרה דחג השבועות,"
        },
        {
          "s": 3,
          "text": "ואשמע אחרי קול רעש גדול10,"
        },
        {
          "s": 4,
          "text": "וכתיב קול כנפיהם כקול מים רבים כקול שדי גו'11,"
        },
        {
          "s": 5,
          "text": "והאופנים וחיות הקודש ברעש גדול12,"
        },
        {
          "s": 6,
          "text": "משא\"כ שירת הנשמות לא מצינו בנביאים."
        },
        {
          "s": 7,
          "text": "והיינו,"
        },
        {
          "s": 8,
          "text": "שיש גם שירת הנשמות,"
        },
        {
          "s": 9,
          "text": "שהרי הנשמות יש להם עליות תמיד,"
        },
        {
          "s": 10,
          "text": "כמ\"ש13"
        },
        {
          "s": 11,
          "text": "ילכו מחיל אל חיל,"
        },
        {
          "s": 12,
          "text": "וכמ\"ש14"
        },
        {
          "s": 13,
          "text": "והי' מדי חודש בחדשו ומדי שבת בשבתו יבוא כל בשר גו',"
        },
        {
          "s": 14,
          "text": "שהו\"ע הילוך ועליית הנשמות שעולים לגן עדן העליון וחוזרים לגן עדן התחתון ועולים עוד הפעם לגן עדן העליון,"
        },
        {
          "s": 15,
          "text": "וידוע שכל עלי' היא ע\"י שיר,"
        },
        {
          "s": 16,
          "text": "וכמאמר15"
        },
        {
          "s": 17,
          "text": "כל בעלי השיר יוצאין בשיר ונמשכין בשיר,"
        },
        {
          "s": 18,
          "text": "וכיון שעליית הנשמות היא למעלה יותר מעליית המלאכים,"
        },
        {
          "s": 19,
          "text": "הרי מובן שגם שירת הנשמות היא יותר משירת המלאכים,"
        },
        {
          "s": 20,
          "text": "ומ\"מ לא נזכר בנביאים שירת הנשמות."
        },
        {
          "s": 21,
          "text": "וטעם הדבר מבואר בלקוטי תורה16,"
        },
        {
          "s": 22,
          "text": "לפי שהמלאכים הם בעלי נפש וגוף,"
        },
        {
          "s": 23,
          "text": "דהגם שנקראים שכלים נבדלים17,"
        },
        {
          "s": 24,
          "text": "הרי זה דוקא בערך הגוף שלמטה,"
        },
        {
          "s": 25,
          "text": "אבל מ\"מ גם המלאכים יש להם גוף,"
        },
        {
          "s": 26,
          "text": "וכמ\"ש18"
        },
        {
          "s": 27,
          "text": "עושה מלאכיו רוחות משרתיו אש לוהט,"
        },
        {
          "s": 28,
          "text": "ופירש הרמב\"ן19"
        },
        {
          "s": 29,
          "text": "שקאי על גוף המלאכים."
        },
        {
          "s": 30,
          "text": "והיינו,"
        },
        {
          "s": 31,
          "text": "שאי אפשר לפרש שקאי על נפש המלאכים,"
        },
        {
          "s": 32,
          "text": "כי בנפש המלאכים לא שייך ענין אש ורוח כלל,"
        },
        {
          "s": 33,
          "text": "דעם היות שאש ורוח הם ב' יסודות הדקים,"
        },
        {
          "s": 34,
          "text": "ובזה גופא הרי המלאכים הם מדקות היסודות,"
        },
        {
          "s": 35,
          "text": "כדמוכח מפי' הרמב\"ן,"
        },
        {
          "s": 36,
          "text": "מ\"מ הרי הם יסודות."
        },
        {
          "s": 37,
          "text": "וענין זה לא שייך בנפש המלאכים,"
        },
        {
          "s": 38,
          "text": "שהו\"ע המדות אהבה ויראה,"
        },
        {
          "s": 39,
          "text": "מחנה מיכאל בחסד ומחנה גבריאל בגבורה20,"
        },
        {
          "s": 40,
          "text": "ובפרט ע\"פ המבואר בתניא21"
        },
        {
          "s": 41,
          "text": "בשם הזהר22"
        },
        {
          "s": 42,
          "text": "שישנם מלאכים שכליים,"
        },
        {
          "s": 43,
          "text": "שהרי בענין המדות ומכ\"ש בענין השכל לא שייך גם ענין יסודות הדקים."
        },
        {
          "s": 44,
          "text": "ועכצ\"ל דמ\"ש עושה מלאכיו רוחות גו' קאי על גוף המלאכים."
        },
        {
          "s": 45,
          "text": "ומכיון שהמלאכים הם בעלי גוף,"
        },
        {
          "s": 46,
          "text": "לכן השירה שלהם נשמעת באזני הנביאים."
        },
        {
          "s": 47,
          "text": "משא\"כ שירת הנשמות שאין להם גוף כלל,"
        },
        {
          "s": 48,
          "text": "וענין השירה שלהם הוא ענין ההשגה ואהבה ויראה,"
        },
        {
          "s": 49,
          "text": "הנה זה אי אפשר שהנביא ישמע."
        },
        {
          "s": 50,
          "text": "וכמו שהוא בענין השמיעה,"
        },
        {
          "s": 51,
          "text": "כן הוא גם בענין הראי',"
        },
        {
          "s": 52,
          "text": "שהמלאכים נתפסים בראי',"
        },
        {
          "s": 53,
          "text": "וכמ\"ש23"
        },
        {
          "s": 54,
          "text": "וירא והנה שלשה אנשים נצבים עליו,"
        },
        {
          "s": 55,
          "text": "דכיון שהמלאכים יש להם גוף,"
        },
        {
          "s": 56,
          "text": "והיינו שגם במעמדם ומצבם יש להם גוף,"
        },
        {
          "s": 57,
          "text": "לכן אפשר שיתלבשו למטה יותר,"
        },
        {
          "s": 58,
          "text": "עד שיהיו נתפסים בראי' כו'."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ומכל זה מובן שטענת המלאכים על נתינת התורה לישראל לא היתה מצד הנשמה,"
        },
        {
          "s": 1,
          "text": "שהרי הנשמות הם למעלה מהמלאכים,"
        },
        {
          "s": 2,
          "text": "אלא מצד הגוף."
        },
        {
          "s": 3,
          "text": "והיינו,"
        },
        {
          "s": 4,
          "text": "שגם המלאכים ידעו שמתן תורה צריך להיות לנשמות בגופים דוקא,"
        },
        {
          "s": 5,
          "text": "ומ\"מ טענו שתינתן התורה אליהם,"
        },
        {
          "s": 6,
          "text": "דכיון שגם הם בעלי גוף,"
        },
        {
          "s": 7,
          "text": "הרי גם זה יספיק לנתינת התורה,"
        },
        {
          "s": 8,
          "text": "ולא יהי' צורך לתת התורה לגוף בו\"ד,"
        },
        {
          "s": 9,
          "text": "שמצד הבשר ורתיחות הדמים אפשר להיות ענין בלתי רצוי כו'."
        },
        {
          "s": 10,
          "text": "ועל זה השיבו להם,"
        },
        {
          "s": 11,
          "text": "כלום למצרים ירדתם כו' יצר הרע יש ביניכם,"
        },
        {
          "s": 12,
          "text": "היינו שלא מספיק המצרים והגבולים של גופות המלאכים,"
        },
        {
          "s": 13,
          "text": "אלא צריך למצרים וגבולים כאלו ששייך בהם יצר הרע,"
        },
        {
          "s": 14,
          "text": "וגם אותו צריך להפוך לטוב,"
        },
        {
          "s": 15,
          "text": "וכמאמר הבעש\"ט24"
        },
        {
          "s": 16,
          "text": "עה\"פ25"
        },
        {
          "s": 17,
          "text": "סור מרע ועשה טוב,"
        },
        {
          "s": 18,
          "text": "שצריך לסור מהרע ולעשות ממנו שיהי' טוב,"
        },
        {
          "s": 19,
          "text": "ולכן ניתנה תורה לגוף בשר ודם דוקא26."
        },
        {
          "s": 20,
          "text": "ועד\"ז בנוגע לטענת המלאכים בעת בריאת העולם ובמשכן"
        },
        {
          "s": 21,
          "text": "[כמשנת\"ל שג' ענינים אלה שייכים זל\"ז,"
        },
        {
          "s": 22,
          "text": "שקיום העשרה מאמרות"
        },
        {
          "s": 23,
          "text": "(שמהם נברא העולם תמיד,"
        },
        {
          "s": 24,
          "text": "כתורת הבעש\"ט27"
        },
        {
          "s": 25,
          "text": "עה\"פ28"
        },
        {
          "s": 26,
          "text": "לעולם הוי' דברך נצב בשמים,"
        },
        {
          "s": 27,
          "text": "שהדבר הוי' צריך להיות תמיד בהנברא להוותו ולהחיותו ולקיימו),"
        },
        {
          "s": 28,
          "text": "נמשך מעשרת הדברות שבתורה,"
        },
        {
          "s": 29,
          "text": "שהתורה היא המשלמת את תכלית כוונת הבריאה שיהי' העולם מקדש ומשכן לו ית'],"
        },
        {
          "s": 30,
          "text": "שטענתם היתה שמספיק גם גוף רוחני של מלאכים."
        },
        {
          "s": 31,
          "text": "ועל זה השיבו להם שצריך לגוף בשר ודם דוקא,"
        },
        {
          "s": 32,
          "text": "כי,"
        },
        {
          "s": 33,
          "text": "כל מה שברא הקב\"ה בעולמו לא בראו אלא לכבודו,"
        },
        {
          "s": 34,
          "text": "שנאמר29"
        },
        {
          "s": 35,
          "text": "כל הנקרא בשמי ולכבודי בראתיו יצרתיו אף עשיתיו30,"
        },
        {
          "s": 36,
          "text": "וכתיב31"
        },
        {
          "s": 37,
          "text": "אנכי עשיתי ארץ ואדם עלי' בראתי,"
        },
        {
          "s": 38,
          "text": "עשיתי הוא מלשון לעשות לתקן32,"
        },
        {
          "s": 39,
          "text": "היינו שתכלית הבריאה הוא לתקן ולהעלות את כל הבריאה ולעשותה ע\"י התורה מקדש ומשכן לו ית',"
        },
        {
          "s": 40,
          "text": "ובשביל זה צריך לגוף בו\"ד דוקא,"
        },
        {
          "s": 41,
          "text": "שעי\"ז יוכלו להעלות גם את המטה ביותר."
        },
        {
          "s": 42,
          "text": "וכידוע המשל33"
        },
        {
          "s": 43,
          "text": "מהגבהת הבנין שצריך להגבי' אותו מתחתיתו דוקא,"
        },
        {
          "s": 44,
          "text": "משא\"כ אם יגביהו מאמצעיתו אזי לא יוגבה תחתיתו."
        }
      ]
    }
  ]
}