{
  "globalIndex": 684,
  "owner": 34,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917795_theRebbe_561__p004",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917795_theRebbe_561__p004",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917795_theRebbe_561",
  "title": "מאמר כי ישאלך בנך תשל\"ח",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "וביאור המעלה דעדות על חוקים בפרטיות יותר,"
        },
        {
          "s": 2,
          "text": "אף שגם בחוקים נרגש בגילוי שהם רצונו ית',"
        },
        {
          "s": 3,
          "text": "רצון שלמעלה מטעם,"
        },
        {
          "s": 4,
          "text": "יובן ע\"פ מ\"ש בהמאמר36"
        },
        {
          "s": 5,
          "text": "שחוקים הוא מלשון חקיקה."
        },
        {
          "s": 6,
          "text": "ומהמשך הענינים שבהמאמר משמע דשני ענינים בזה."
        },
        {
          "s": 7,
          "text": "ענין החקיקה למעלה,"
        },
        {
          "s": 8,
          "text": "כמ\"ש בהמאמר דמעלת אותיות החקיקה על אותיות הכתיבה היא שאותיות החקיקה אינם דבר נוסף על העצם,"
        },
        {
          "s": 9,
          "text": "ומבאר שזהו בחינת הכתר."
        },
        {
          "s": 10,
          "text": "ויש לומר,"
        },
        {
          "s": 11,
          "text": "דזה שהכתר"
        },
        {
          "s": 12,
          "text": "(סובב)"
        },
        {
          "s": 13,
          "text": "הוא דוגמת אותיות החקיקה שאינם דבר נוסף על העצם,"
        },
        {
          "s": 14,
          "text": "הוא,"
        },
        {
          "s": 15,
          "text": "שהגילוי דאור הממלא להיותו גילוי שבבחינת גבול ולא כמו העצם,"
        },
        {
          "s": 16,
          "text": "הוא כמו דבר נוסף על העצם,"
        },
        {
          "s": 17,
          "text": "והגילוי דאור הסובב,"
        },
        {
          "s": 18,
          "text": "להיותו בל\"ג כמו העצם,"
        },
        {
          "s": 19,
          "text": "אינו דבר נוסף על העצם37."
        },
        {
          "s": 20,
          "text": "ועוד ענין בחוקים מלשון חקיקה,"
        },
        {
          "s": 21,
          "text": "שע\"י החוקים נעשה בעולם ענין החקיקה."
        },
        {
          "s": 22,
          "text": "כדאיתא במדרש38"
        },
        {
          "s": 23,
          "text": "ע\"פ39"
        },
        {
          "s": 24,
          "text": "אם לא בריתי יומם ולילה חוקות שמים וארץ לא שמתי,"
        },
        {
          "s": 25,
          "text": "חוקים שבהם חקקתי את השמים והארץ."
        },
        {
          "s": 26,
          "text": "ומבאר בהמאמר דענין חקקתי שמים וארץ הוא הביטול שנעשה בעולם40,"
        },
        {
          "s": 27,
          "text": "ע\"י המשכת הסובב,"
        },
        {
          "s": 28,
          "text": "חקיקה דלמעלה."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "והנה גם בחקיקה,"
        },
        {
          "s": 1,
          "text": "ע\"י חקיקה נעשה שינוי בהדבר שחוקקין בו,"
        },
        {
          "s": 2,
          "text": "שאינו כמו שהי' בתחילה."
        },
        {
          "s": 3,
          "text": "וכמו בחקיקת אותיות באבן,"
        },
        {
          "s": 4,
          "text": "שבתחילה הי' האבן פשוט ועכשיו הוא מצוייר באותיות41"
        },
        {
          "s": 5,
          "text": "[ובפרט כשהחקיקה הוא באבן הבהיר ומבהיק,"
        },
        {
          "s": 6,
          "text": "שע\"י החקיקה נעשה שינוי בהבהירות וההבהקה של האבן,"
        },
        {
          "s": 7,
          "text": "שבמקום החקיקה אינו מבהיק כ\"כ41]."
        },
        {
          "s": 8,
          "text": "ועוד ענין בזה"
        },
        {
          "s": 9,
          "text": "[נוסף להשינוי"
        },
        {
          "s": 10,
          "text": "(ירידה)"
        },
        {
          "s": 11,
          "text": "שנעשה בהאבן ע\"י החקיקה],"
        },
        {
          "s": 12,
          "text": "שהחקיקה היא קשורה בהחלל,"
        },
        {
          "s": 13,
          "text": "שנחסר בהאבן,"
        },
        {
          "s": 14,
          "text": "היינו שהחקיקה עצמה היא כמו היפך האבן."
        },
        {
          "s": 15,
          "text": "ויש לומר דשני ענינים אלה הם גם בהנמשל דאור הסובב."
        },
        {
          "s": 16,
          "text": "שהירידה בהאור להיות סובב לעלמין הוא דוגמת השינוי והירידה שנעשה בהאבן,"
        },
        {
          "s": 17,
          "text": "שאינו פשוט"
        },
        {
          "s": 18,
          "text": "(ואינו מאיר ומבהיק כ\"כ)"
        },
        {
          "s": 19,
          "text": "כמו שהי' תחילה."
        },
        {
          "s": 20,
          "text": "ועי\"ז נעשה נתינת מקום לעולם"
        },
        {
          "s": 21,
          "text": "(שמתהווה מאור הסובב),"
        },
        {
          "s": 22,
          "text": "שמציאות העולם"
        },
        {
          "s": 23,
          "text": "(מלשון העלם)"
        },
        {
          "s": 24,
          "text": "הוא היפך גילוי האור,"
        },
        {
          "s": 25,
          "text": "בדוגמת החקיקה שנחסר מהאבן."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "שעד\"ז הוא גם בחוקים,"
        },
        {
          "s": 2,
          "text": "דזה שנק' בשם חוקים מלשון חקיקה הוא מצד שני ענינים הנ\"ל."
        },
        {
          "s": 3,
          "text": "והענין הוא,"
        },
        {
          "s": 4,
          "text": "דפירוש חוקה הוא כמאמר רז\"ל חוקה חקקתי גזירה גזרתי ואין לך רשות להרהר אחרי'21,"
        },
        {
          "s": 5,
          "text": "דשני ענינים בזה."
        },
        {
          "s": 6,
          "text": "שהרצון דחוקים הוא"
        },
        {
          "s": 7,
          "text": "(לא כמו שהוא בעצמותו,"
        },
        {
          "s": 8,
          "text": "אלא)"
        },
        {
          "s": 9,
          "text": "בבחינת ירידה כביכול לשלול את השכל"
        },
        {
          "s": 10,
          "text": "(אין לך רשות להרהר),"
        },
        {
          "s": 11,
          "text": "בדוגמת השינוי והירידה שנעשה בהאבן ע\"י החקיקה."
        },
        {
          "s": 12,
          "text": "ושהשכל"
        },
        {
          "s": 13,
          "text": "(שהרצון שולל אותו)"
        },
        {
          "s": 14,
          "text": "הוא באופן שההבנה וההשגה שלו היא היפך הרצון42,"
        },
        {
          "s": 15,
          "text": "שלכן צריך לשלול ולומר אין לך רשות להרהר."
        },
        {
          "s": 16,
          "text": "ועפ\"ז תובן יותר המעלה דעדות לגבי חוקים,"
        },
        {
          "s": 17,
          "text": "דענין החוקים הוא הרצון דמצוות כמו שהוא בבחינת ירידה לשלול הענינים"
        },
        {
          "s": 18,
          "text": "(השכל)"
        },
        {
          "s": 19,
          "text": "שהם הפכים,"
        },
        {
          "s": 20,
          "text": "וענין העדות הוא הרצון דמצוות כמו שהוא בעצמותו."
        }
      ]
    }
  ]
}