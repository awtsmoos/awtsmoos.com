{
  "globalIndex": 574,
  "owner": 24,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917050_theRebbe_195__p001",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917050_theRebbe_195__p001",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518917050_theRebbe_195",
  "title": "מאמר הנני ממטיר לכם תשל\"ז",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "יום ה' פ' בשלח,"
        },
        {
          "s": 2,
          "text": "ט\"ו בשבט,"
        },
        {
          "s": 3,
          "text": "ה'תשל\"ז*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "הנחה"
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "הנני ממטיר לכם לחם מן השמים גו'"
        },
        {
          "s": 1,
          "text": "(ומבאר שזהו)"
        },
        {
          "s": 2,
          "text": "למען אנסנו הילך בתורתי אם לא1."
        },
        {
          "s": 3,
          "text": "וידועים דיוקי רבותינו נשיאינו בכתוב זה2,"
        },
        {
          "s": 4,
          "text": "מהו הקשר דענין המן"
        },
        {
          "s": 5,
          "text": "(לחם מן השמים)"
        },
        {
          "s": 6,
          "text": "עם ענין התורה."
        },
        {
          "s": 7,
          "text": "ובפרט שאומר למען אנסנו אם יוכל להיות קבלת התורה,"
        },
        {
          "s": 8,
          "text": "היינו שמנסיון זה ידעו אם ילך בתורתי אם לא,"
        },
        {
          "s": 9,
          "text": "שבנסיון זה תלוי ענין קבלת התורה."
        },
        {
          "s": 10,
          "text": "וגם מהו לשון הילך בתורתי,"
        },
        {
          "s": 11,
          "text": "הול\"ל כבכ\"מ לשון של לימוד,"
        },
        {
          "s": 12,
          "text": "המתאים לתורה להיותה ענין של שכל,"
        },
        {
          "s": 13,
          "text": "או הישמור תורתי וכיו\"ב."
        },
        {
          "s": 14,
          "text": "עוד צלה\"ב,"
        },
        {
          "s": 15,
          "text": "דהנה מכיון שאומרים בחמשה עשר באייר3"
        },
        {
          "s": 16,
          "text": "הנני ממטיר לכם לחם מן השמים,"
        },
        {
          "s": 17,
          "text": "הרי מובן שזהו דבר חידוש לגבי הלחם מן הארץ שהיו אוכלים עד חמשה עשר באייר,"
        },
        {
          "s": 18,
          "text": "ולכאורה אי\"מ שהרי ישנה מעלה גדולה בהלחם מן הארץ שאכלו אז שהי' מהעוגות מצות שאכלו בארץ מצרים שע\"ז נצטוו על מצות ומרורים יאכלוהו4,"
        },
        {
          "s": 19,
          "text": "דענין המצה ה\"ה קשור עם הגאולה,"
        },
        {
          "s": 20,
          "text": "וכמבואר בדרושי פסח5"
        },
        {
          "s": 21,
          "text": "דענין המצה"
        },
        {
          "s": 22,
          "text": "(הנה אע\"פ שהו\"ע של קטנות,"
        },
        {
          "s": 23,
          "text": "מ\"מ)"
        },
        {
          "s": 24,
          "text": "הוא קטנות אבא וכמאמר6"
        },
        {
          "s": 25,
          "text": "אין התינוק יודע לקרות אבא כו' עד שיטעום טעם דגן,"
        },
        {
          "s": 26,
          "text": "דעי\"ז הי' הגילוי דנגלה עליהם ממה\"מ הקב\"ה בכבודו ובעצמו וגאלם7,"
        },
        {
          "s": 27,
          "text": "שמכ\"ז מובן גודל העילוי דלחם מן הארץ,"
        },
        {
          "s": 28,
          "text": "ואעפ\"כ אומרים ש"
        },
        {
          "s": 29,
          "text": "(אי\"ז מספיק ו)"
        },
        {
          "s": 30,
          "text": "ישנו חידוש שנתוסף דוקא ע\"י הלחם מן השמים."
        },
        {
          "s": 31,
          "text": "עוד צלה\"ב,"
        },
        {
          "s": 32,
          "text": "דהרי החידוש דלחם מן השמים הי' בזה שבא שלא ע\"י עבודת ויגיעת האדם כלחם מן הארץ,"
        },
        {
          "s": 33,
          "text": "אלא כמ\"ש הנני ממטיר לכם,"
        },
        {
          "s": 34,
          "text": "היינו שבא מלמעלה,"
        },
        {
          "s": 35,
          "text": "וא\"כ אי\"מ מהו הלשון ממטיר,"
        },
        {
          "s": 36,
          "text": "הלא ענין המטר הוא לא כענין הטל שטל לא מיעצר8,"
        },
        {
          "s": 37,
          "text": "אלא הוא תלוי בעבודת האדם,"
        },
        {
          "s": 38,
          "text": "וכמבואר בדרושי האזינו9"
        },
        {
          "s": 39,
          "text": "החילוק בין יערוף כמטר לקחי ותזל כטל אמרתי10."
        }
      ]
    }
  ]
}