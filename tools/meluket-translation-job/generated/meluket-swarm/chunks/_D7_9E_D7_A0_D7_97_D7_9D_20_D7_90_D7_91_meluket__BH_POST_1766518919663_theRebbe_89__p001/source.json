{
  "globalIndex": 988,
  "owner": 38,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919663_theRebbe_89__p001",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919663_theRebbe_89__p001",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919663_theRebbe_89",
  "title": "מאמר ציון במשפט תפדה תשל\"ה",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "יום השלישי שהוכפל בו כי טוב,"
        },
        {
          "s": 2,
          "text": "ערב ר\"ח מנחם-אב,"
        },
        {
          "s": 3,
          "text": "תשל\"ה*."
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "הנחה"
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ציון במשפט תפדה ושבי' בצדקה1,"
        },
        {
          "s": 1,
          "text": "הנה פסוק זה הוא בתחילת ספר ישעי',"
        },
        {
          "s": 2,
          "text": "שענינו"
        },
        {
          "s": 3,
          "text": "(של ישעי')"
        },
        {
          "s": 4,
          "text": "כשמו כן הוא"
        },
        {
          "s": 5,
          "text": "(ישעי' מלשון ישועה2),"
        },
        {
          "s": 6,
          "text": "וכדאיתא בגמרא3"
        },
        {
          "s": 7,
          "text": "ישעי' כולי' נחמתא."
        },
        {
          "s": 8,
          "text": "ועד שאפילו אלו הענינים בנבואות ישעי' שלכאורה אינם ישועה,"
        },
        {
          "s": 9,
          "text": "הנה באמת גם הם ישועה ונחמה,"
        },
        {
          "s": 10,
          "text": "וכמבואר בקבלה4"
        },
        {
          "s": 11,
          "text": "שהם בחי' גבורות ממותקות,"
        },
        {
          "s": 12,
          "text": "ולפי שהישועה"
        },
        {
          "s": 13,
          "text": "(גאולה)"
        },
        {
          "s": 14,
          "text": "העתידה תהי' על ידי מיתוק הגבורות,"
        },
        {
          "s": 15,
          "text": "ולכן יצחק יהי' עיקר כו'"
        },
        {
          "s": 16,
          "text": "[וכדאיתא בגמרא5,"
        },
        {
          "s": 17,
          "text": "שלעת\"ל יאמרו ליצחק"
        },
        {
          "s": 18,
          "text": "(דוקא)"
        },
        {
          "s": 19,
          "text": "כי אתה אבינו,"
        },
        {
          "s": 20,
          "text": "שיצחק הו\"ע הגבורות],"
        },
        {
          "s": 21,
          "text": "לכן בהישועות שבספר ישעי' ישנן הישועות שבבחי' חסדים הגלויים,"
        },
        {
          "s": 22,
          "text": "והישועות דבחי' גבורות ממותקים,"
        },
        {
          "s": 23,
          "text": "גבורות שנהפכים לחסדים6"
        },
        {
          "s": 24,
          "text": "(שהם נעלים יותר7"
        },
        {
          "s": 25,
          "text": "מחסדים הגלויים)."
        },
        {
          "s": 26,
          "text": "ועד\"ז הוא גם בהנבואה שבתחילת הספר,"
        },
        {
          "s": 27,
          "text": "שיש בה שני סוגים הנ\"ל,"
        },
        {
          "s": 28,
          "text": "מסיים בשנים ציון במשפט תפדה ושבי' בצדקה,"
        },
        {
          "s": 29,
          "text": "כדלקמן."
        }
      ]
    }
  ]
}