{
  "globalIndex": 557,
  "owner": 7,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916949_theRebbe_558__p004",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916949_theRebbe_558__p004",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916949_theRebbe_558",
  "title": "מאמר באתי לגני תש\"מ",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וזהו מה ששם צבאות לא נזכר בתורה כ\"א בנביאים דוקא,"
        },
        {
          "s": 2,
          "text": "כי משה רבינו הי' נשמה והנהגה דאצילות,"
        },
        {
          "s": 3,
          "text": "שלכן נקרא משה על שם מן המים משיתיהו47,"
        },
        {
          "s": 4,
          "text": "מים חכ' הוא בחי' אצילות."
        },
        {
          "s": 5,
          "text": "וכן התורה שניתנה ע\"י משה ונקראת על שמו כמ\"ש48"
        },
        {
          "s": 6,
          "text": "זכרו תורת משה עבדי היא בחי' אצילות."
        },
        {
          "s": 7,
          "text": "ולכן לא נזכר בתורה שם צבאות,"
        },
        {
          "s": 8,
          "text": "כי שם צבאות מורה"
        },
        {
          "s": 9,
          "text": "(כנ\"ל)"
        },
        {
          "s": 10,
          "text": "על אוא\"ס כמו שנמשך בנבראים,"
        },
        {
          "s": 11,
          "text": "שלמטה מאצילות."
        },
        {
          "s": 12,
          "text": "והוא49"
        },
        {
          "s": 13,
          "text": "ע\"ד מ\"ש50"
        },
        {
          "s": 14,
          "text": "ביהושע ויאמר לא כי אני שר צבא ה' עתה באתי,"
        },
        {
          "s": 15,
          "text": "ואמרו רז\"ל51"
        },
        {
          "s": 16,
          "text": "עתה באתי אבל משה רבך לא קיבלו."
        },
        {
          "s": 17,
          "text": "דבימי משה,"
        },
        {
          "s": 18,
          "text": "פני משה כפני חמה52,"
        },
        {
          "s": 19,
          "text": "הי' המשכת בחי' אצילות,"
        },
        {
          "s": 20,
          "text": "וגם הנהגת המלחמות53"
        },
        {
          "s": 21,
          "text": "לא היתה ע\"י שר צבא ה' כ\"א כמ\"ש54"
        },
        {
          "s": 22,
          "text": "הוי' ילחם לכם."
        },
        {
          "s": 23,
          "text": "דזהו מה שביציאת מצרים וקריעת ים סוף היו נסים נגלים יוצאים מדרכי הטבע לגמרי שלא הי' לבוש הטבע כלל,"
        },
        {
          "s": 24,
          "text": "לפי שהמלחמה היתה ע\"י שם הוי',"
        },
        {
          "s": 25,
          "text": "בחי' אצילות."
        },
        {
          "s": 26,
          "text": "משא\"כ לאחרי הסתלקות פני משה כפני חמה וההנהגה היתה ע\"י פני יהושע כפני לבנה52"
        },
        {
          "s": 27,
          "text": "הנה אז דוקא בא שר צבא הוי',"
        },
        {
          "s": 28,
          "text": "עתה"
        },
        {
          "s": 29,
          "text": "(דוקא)"
        },
        {
          "s": 30,
          "text": "באתי."
        },
        {
          "s": 31,
          "text": "והגם שגם אז"
        },
        {
          "s": 32,
          "text": "(ע\"י שהנהגת המלחמה היתה ע\"י שר צבא הוי')"
        },
        {
          "s": 33,
          "text": "היו כמה נסים שלמעלה מהטבע,"
        },
        {
          "s": 34,
          "text": "מ\"מ כללות המלחמה היתה קצת בלבושי הטבע,"
        },
        {
          "s": 35,
          "text": "ולא כהמלחמה בימי משה שהיתה למעלה מלבושי הטבע לגמרי,"
        },
        {
          "s": 36,
          "text": "הוי' ילחם לכם."
        },
        {
          "s": 37,
          "text": "וזהו ענין שם צבאות שנמשך ע\"י הנביאים,"
        },
        {
          "s": 38,
          "text": "אות הוא בצבא שלו,"
        },
        {
          "s": 39,
          "text": "שגם בנבראים דבי\"ע"
        },
        {
          "s": 40,
          "text": "(צבא)"
        },
        {
          "s": 41,
          "text": "יהי' אות הוא ית' ממש בצבא שלו,"
        },
        {
          "s": 42,
          "text": "שגם בבי\"ע יהי' איהו וגרמוהי חד כמו באצילות."
        },
        {
          "s": 43,
          "text": "וענין זה הוא למעלה מבחי' שר צבא הוי'"
        },
        {
          "s": 44,
          "text": "(שהי' ביהושע),"
        },
        {
          "s": 45,
          "text": "כי שר צבא הוי' הוא מלאך,"
        },
        {
          "s": 46,
          "text": "משא\"כ שם צבאות הוא מז' שמות שאינן נמחקין,"
        },
        {
          "s": 47,
          "text": "כי גם בבי\"ע נעשה איהו וגרמוהי חד."
        },
        {
          "s": 48,
          "text": "וזהו מה ששם צבאות נתחדש ע\"י הנביאים,"
        },
        {
          "s": 49,
          "text": "כי הנביאים המשיכו שגם בכלים דבי\"ע תהי' התלבשות אוא\"ס ב\"ה בתכלית היחוד,"
        },
        {
          "s": 50,
          "text": "כמו בכלים דאצילות,"
        },
        {
          "s": 51,
          "text": "ועי\"ז נקרא הוא ית' בשם צבאות,"
        },
        {
          "s": 52,
          "text": "כמו שנקרא בהשמות"
        },
        {
          "s": 53,
          "text": "(א-ל,"
        },
        {
          "s": 54,
          "text": "אלקים וכו')"
        },
        {
          "s": 55,
          "text": "שמורים על הכלים דאצילות"
        },
        {
          "s": 56,
          "text": "(לפי שאיהו וגרמוהי חד),"
        },
        {
          "s": 57,
          "text": "כי גם הצבאות"
        },
        {
          "s": 58,
          "text": "(לשון חיילות,"
        },
        {
          "s": 59,
          "text": "גדודי נשמות ומלאכים דבריאה)"
        },
        {
          "s": 60,
          "text": "נעשו חד עמו ית',"
        },
        {
          "s": 61,
          "text": "כמבואר בארוכה בתו\"א38."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "והנה ענין הנ\"ל בשם צבאות שאיהו וגרמוהי חד גם בבי\"ע,"
        },
        {
          "s": 2,
          "text": "כותב כ\"ק אדמו\"ר הצ\"צ55"
        },
        {
          "s": 3,
          "text": "שבע\"ח לא מצינו זה."
        },
        {
          "s": 4,
          "text": "שמזה משמע שזהו חידושו של כ\"ק אדמו\"ר הזקן,"
        },
        {
          "s": 5,
          "text": "כדמוכח ממה שכ\"ק אדמו\"ר הצ\"צ אינו מציין מקור אחר לזה."
        },
        {
          "s": 6,
          "text": "ומובן גודל החידוש והעילוי דשם צבאות שנעשה ע\"י עבודת בנ\"י כמו שישראל הם במעמד ומצב דזמן הנביאים"
        },
        {
          "s": 7,
          "text": "(לאחרי הזמן דפני משה כפני חמה),"
        },
        {
          "s": 8,
          "text": "ובפרט כמו שישראל הם במעמד ומצב דזמן נביאים האחרונים שהיו בסוף בית ראשון ותחלת זמן הגלות,"
        },
        {
          "s": 9,
          "text": "ועד\"ז בהזמן שלאח\"ז,"
        },
        {
          "s": 10,
          "text": "שגם בעולמות בי\"ע שמצד עצמם הם נבראים נפרדים"
        },
        {
          "s": 11,
          "text": "[דענין איהו וגרמוהי חד הוא באצילות,"
        },
        {
          "s": 12,
          "text": "עולם האחדות]"
        },
        {
          "s": 13,
          "text": "יהי' איהו וגרמוהי חד כמו באצילות."
        },
        {
          "s": 14,
          "text": "וי\"ל שזהו הפי' להפס\"ד שצבאות הוא שם קודש ובכ\"ז נקרא ע\"ש צבאות שלו"
        },
        {
          "s": 15,
          "text": "(כבגמרא56),"
        },
        {
          "s": 16,
          "text": "ע\"ש ישראל57,"
        },
        {
          "s": 17,
          "text": "כי זה שצבאות הוא שם קודש,"
        },
        {
          "s": 18,
          "text": "היינו שגם בבי\"ע איהו וגרמוהי חד,"
        },
        {
          "s": 19,
          "text": "זה נעשה ע\"י העבודה דישראל,"
        },
        {
          "s": 20,
          "text": "כנ\"ל."
        },
        {
          "s": 21,
          "text": "וזה נעשה ע\"י המשכת אור ממקום עליון ביותר58,"
        },
        {
          "s": 22,
          "text": "שנעלה גם מבחינת התורה"
        },
        {
          "s": 23,
          "text": "(כמו שהיתה בגילוי בזמן משה)."
        },
        {
          "s": 24,
          "text": "שהרי בתורה לא נזכר שם צבאות"
        },
        {
          "s": 25,
          "text": "(היינו שמצד בחינת התורה,"
        },
        {
          "s": 26,
          "text": "הענין דאיהו וגרמוהי חד הוא רק באצילות),"
        },
        {
          "s": 27,
          "text": "ובכדי שיהי' איהו וגרמוהי חד גם בבי\"ע צריך להמשיך ממקום עליון יותר."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "והנה המשכה זו היא ע\"י עבודת הבירורים."
        },
        {
          "s": 2,
          "text": "דהנה ידועה תורת הבעש\"ט59,"
        },
        {
          "s": 3,
          "text": "שבכל דבר שנמצא ברשותו של ישראל ישנם ניצוצין קדושים השייכים לשרש נשמתו."
        },
        {
          "s": 4,
          "text": "ובזה מבאר מה שהתורה חסה על ממונם של ישראל60"
        },
        {
          "s": 5,
          "text": "(אף שהוא רק ממונם),"
        },
        {
          "s": 6,
          "text": "כי מכיון שהממון"
        },
        {
          "s": 7,
          "text": "(וכן שארי דברים)"
        },
        {
          "s": 8,
          "text": "הוא של ישראל,"
        },
        {
          "s": 9,
          "text": "זה מורה"
        },
        {
          "s": 10,
          "text": "(שהרי כל הענינים הם בהשגחה פרטית)"
        },
        {
          "s": 11,
          "text": "שניצוצות אלו שייכים לשרש נשמתו,"
        },
        {
          "s": 12,
          "text": "והבירור דניצוצות אלו הוא חלק מעבודתו,"
        },
        {
          "s": 13,
          "text": "וע\"י שמבררים את הניצוצות ומזככים ומעלים אותם לשרשם הם מוסיפים עילוי גם בו."
        },
        {
          "s": 14,
          "text": "דכמו\"כ הי' בגלות מצרים,"
        },
        {
          "s": 15,
          "text": "שע\"י וינצלו את מצרים שעשאוה כמצולה שאין בה דגים וכמצודה שאין בה דגן61"
        },
        {
          "s": 16,
          "text": "שביררו את הניצוצות השייכים לעלמא דאתכסיא"
        },
        {
          "s": 17,
          "text": "(כמצולה שאין בה דגים)"
        },
        {
          "s": 18,
          "text": "והניצוצות השייכים לעלמא דאתגליא"
        },
        {
          "s": 19,
          "text": "(כמצודה שאין בה דגן),"
        },
        {
          "s": 20,
          "text": "עי\"ז נעשה עילוי גם בישראל."
        },
        {
          "s": 21,
          "text": "וכמו שמבאר כ\"ק אדמו\"ר מהר\"ש62"
        },
        {
          "s": 22,
          "text": "בארוכה בענין ויהי בשלח פרעה את העם שהי' משלח פארות וענפים ועושה פרי למעלה את העם,"
        },
        {
          "s": 23,
          "text": "שע\"י הניצוצות שביררו בגלות מצרים נעשה בהם תוספות וריבוי."
        },
        {
          "s": 24,
          "text": "דזהו מ\"ש"
        },
        {
          "s": 25,
          "text": "(גבי גלות מצרים)"
        },
        {
          "s": 26,
          "text": "וזרעתי' לי בארץ63,"
        },
        {
          "s": 27,
          "text": "דענין הזריעה הוא כמרז\"ל64"
        },
        {
          "s": 28,
          "text": "כלום אדם זורע כור65"
        },
        {
          "s": 29,
          "text": "אלא כדי להוציא כמה כורין,"
        },
        {
          "s": 30,
          "text": "היינו,"
        },
        {
          "s": 31,
          "text": "דמה שישראל נזרעו בגלות מצרים הוא בשביל ההוספה שנעשה בהם ע\"י בירור הניצוצות."
        },
        {
          "s": 32,
          "text": "כמו שמבאר כ\"ק אדמו\"ר מהר\"ש בארוכה כמה פרטים בענין ההוספה שנעשה ע\"י בירור הניצוצות."
        }
      ]
    }
  ]
}