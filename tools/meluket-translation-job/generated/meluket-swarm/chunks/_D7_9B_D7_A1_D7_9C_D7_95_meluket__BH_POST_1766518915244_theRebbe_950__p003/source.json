{
  "globalIndex": 244,
  "owner": 44,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915244_theRebbe_950__p003",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915244_theRebbe_950__p003",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915244_theRebbe_950",
  "title": "מאמר פדה בשלום תשכ\"ב",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ולכאורה צריך לומר,"
        },
        {
          "s": 1,
          "text": "שהכוונה"
        },
        {
          "s": 2,
          "text": "(בהמאמר)"
        },
        {
          "s": 3,
          "text": "במלמעלה למטה ובמלמטה למעלה היא"
        },
        {
          "s": 4,
          "text": "(גם)"
        },
        {
          "s": 5,
          "text": "לשני האופנים שבענין הבירורים"
        },
        {
          "s": 6,
          "text": "(הענין דושבתי,"
        },
        {
          "s": 7,
          "text": "השבת הנצוצות לשרשם),"
        },
        {
          "s": 8,
          "text": "בירור בדרך מלמעלה למטה ובירור בדרך מלמטה למעלה."
        },
        {
          "s": 9,
          "text": "וצריך להבין,"
        },
        {
          "s": 10,
          "text": "הרי מבואר בכ\"מ22"
        },
        {
          "s": 11,
          "text": "[וגם במאמר הנ\"ל"
        },
        {
          "s": 12,
          "text": "(ד\"ה פדה בשלום)"
        },
        {
          "s": 13,
          "text": "דבעל הגאולה,"
        },
        {
          "s": 14,
          "text": "הובא לעיל סעיפים א-ב],"
        },
        {
          "s": 15,
          "text": "דענין השלום הוא בהבירור בדרך מלמעלה למטה"
        },
        {
          "s": 16,
          "text": "(בירור שע\"י גילוי אור),"
        },
        {
          "s": 17,
          "text": "משא\"כ הבירור שבדרך מלמטה למעלה"
        },
        {
          "s": 18,
          "text": "(בירור שבדרך התלבשות)"
        },
        {
          "s": 19,
          "text": "הוא באופן דמלחמה,"
        },
        {
          "s": 20,
          "text": "ומזה שאומר דפירוש בשלום הוא ב' שלום,"
        },
        {
          "s": 21,
          "text": "שלום מלמעלה למטה ושלום מלמטה למעלה,"
        },
        {
          "s": 22,
          "text": "משמע שגם הבירור שמלמטה למעלה הוא באופן דשלום."
        },
        {
          "s": 23,
          "text": "ולהוסיף,"
        },
        {
          "s": 24,
          "text": "דמזה שנאמר ושבתי בשלום ב' שלום"
        },
        {
          "s": 25,
          "text": "(שצריך להיות שניהם),"
        },
        {
          "s": 26,
          "text": "משמע,"
        },
        {
          "s": 27,
          "text": "שבכל אחד מהם יש יתרון23."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והענין הוא,"
        },
        {
          "s": 2,
          "text": "דבשלום"
        },
        {
          "s": 3,
          "text": "(שנעשה ע\"י הבירור)"
        },
        {
          "s": 4,
          "text": "שני אופנים."
        },
        {
          "s": 5,
          "text": "שנתבטל המנגד – ואופן זה הוא"
        },
        {
          "s": 6,
          "text": "(בעיקר)"
        },
        {
          "s": 7,
          "text": "בהבירור בדרך מלמעלה למטה."
        },
        {
          "s": 8,
          "text": "דבהבירור בדרך מלמטה למעלה,"
        },
        {
          "s": 9,
          "text": "שהמברר מתלבש בהמתברר ומתעסק עמו שירצה להתברר,"
        },
        {
          "s": 10,
          "text": "אין זה שהתחתון"
        },
        {
          "s": 11,
          "text": "(המתברר)"
        },
        {
          "s": 12,
          "text": "נתבטל אלא שהוא מתברר מצד הרצון שלו."
        },
        {
          "s": 13,
          "text": "וכיון שגם לאחרי שנתברר הוא מציאות דתחתון"
        },
        {
          "s": 14,
          "text": "(דתחתון ועליון הם הפכים24),"
        },
        {
          "s": 15,
          "text": "לכן,"
        },
        {
          "s": 16,
          "text": "גם לאחרי שנתברר,"
        },
        {
          "s": 17,
          "text": "שייך שינגד להעליון."
        },
        {
          "s": 18,
          "text": "ובעבודת האדם הוא,"
        },
        {
          "s": 19,
          "text": "שהבירור דנה\"ב ע\"י שנה\"א מתלבשת בנה\"ב,"
        },
        {
          "s": 20,
          "text": "הוא,"
        },
        {
          "s": 21,
          "text": "שההתבוננות דנפש האלקית היא באופן שגם נפש הבהמית תבין ותשיג את הענין האלקי"
        },
        {
          "s": 22,
          "text": "(שמתבונן בו)"
        },
        {
          "s": 23,
          "text": "שעי\"ז תבוא לאהבה את ה'."
        },
        {
          "s": 24,
          "text": "דזה שנה\"ב אוהבת את ה'"
        },
        {
          "s": 25,
          "text": "(הגם שבטבעה היא נמשכת לענינים גשמיים25)"
        },
        {
          "s": 26,
          "text": "הוא"
        },
        {
          "s": 27,
          "text": "(לא ע\"י שנתבטל המציאות שלה,"
        },
        {
          "s": 28,
          "text": "אלא אדרבה)"
        },
        {
          "s": 29,
          "text": "ע\"י שהשכל דנה\"ב בא להבנה שצריך לאהוב את ה'26."
        },
        {
          "s": 30,
          "text": "וכיון דזה שנפש הבהמית אוהבת את ה'"
        },
        {
          "s": 31,
          "text": "(כולל גם ההבנה וההשגה שצריך לאהוב את ה')"
        },
        {
          "s": 32,
          "text": "הוא מצד השכל דנפש האלקית"
        },
        {
          "s": 33,
          "text": "(שנתלבש בהשכל דנה\"ב),"
        },
        {
          "s": 34,
          "text": "אבל נפש הבהמית מצד עצמה היא נמשכת לענינים גשמיים"
        },
        {
          "s": 35,
          "text": "[וכמבואר בכ\"מ27"
        },
        {
          "s": 36,
          "text": "שהבירור דנה\"ב שע\"י התבוננות היא רק בדרך אתכפיא],"
        },
        {
          "s": 37,
          "text": "הרי גם עכשיו"
        },
        {
          "s": 38,
          "text": "(שגם נה\"ב יש לה אהבת ה')"
        },
        {
          "s": 39,
          "text": "נשאר בהעלם ההתנגדות שלה לנה\"א"
        },
        {
          "s": 40,
          "text": "(אלא שההתנגדות שלה אינה באה בפועל)."
        },
        {
          "s": 41,
          "text": "ובכדי שיהי' ביטול המנגד הוא ע\"י הבירור בדרך מלמעלה למטה."
        },
        {
          "s": 42,
          "text": "דע\"י28"
        },
        {
          "s": 43,
          "text": "שמתגלה בהתחתון גילוי אור שאינו בערך אליו,"
        },
        {
          "s": 44,
          "text": "הוא מתבטל ממציאותו."
        },
        {
          "s": 45,
          "text": "ובעבודת האדם הוא,"
        },
        {
          "s": 46,
          "text": "דע\"י שנרגש בנה\"ב האהבה דנה\"א שלמעלה מטו\"ד,"
        },
        {
          "s": 47,
          "text": "דאהבה זו היא"
        },
        {
          "s": 48,
          "text": "(בדרך כלל)"
        },
        {
          "s": 49,
          "text": "אהבה רבה שלמעלה מהגבלת כלי הלב,"
        },
        {
          "s": 50,
          "text": "עי\"ז מתבטל המציאות דנפש הבהמית,"
        },
        {
          "s": 51,
          "text": "ועי\"ז היא נהפכת לטוב,"
        },
        {
          "s": 52,
          "text": "אתהפכא"
        },
        {
          "s": 53,
          "text": "(שלמעלה מאתכפיא)29."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ועוד אופן בשלום"
        },
        {
          "s": 1,
          "text": "(שנעשה ע\"י הבירור),"
        },
        {
          "s": 2,
          "text": "דזה שהי' בתחלה מנגד נעשה אוהב"
        },
        {
          "s": 3,
          "text": "(ובלשון הכתוב30"
        },
        {
          "s": 4,
          "text": "גם אויביו ישלים אתו)"
        },
        {
          "s": 5,
          "text": "– ואופן זה הוא"
        },
        {
          "s": 6,
          "text": "(בעיקר)"
        },
        {
          "s": 7,
          "text": "בהבירור בדרך מלמטה למעלה."
        },
        {
          "s": 8,
          "text": "דבהבירור בדרך מלמעלה למטה,"
        },
        {
          "s": 9,
          "text": "זה שהתחתון אינו מנגד הוא לפי שנתבטל ממציאותו ע\"י הגילוי אור,"
        },
        {
          "s": 10,
          "text": "אבל לא שנעשה שינוי בהמציאות דהתחתון עצמו."
        },
        {
          "s": 11,
          "text": "דהגם שע\"י גילוי האהבה רבה שלמעלה מטו\"ד נהפכת נה\"ב לטוב"
        },
        {
          "s": 12,
          "text": "(אתהפכא),"
        },
        {
          "s": 13,
          "text": "הרי האתהפכא שלה היא"
        },
        {
          "s": 14,
          "text": "(לא מצד ענינה דנה\"ב,"
        },
        {
          "s": 15,
          "text": "אלא)"
        },
        {
          "s": 16,
          "text": "מפני שע\"י האהבה רבה דנה\"א מתבטלת נה\"ב ממציאותה31."
        },
        {
          "s": 17,
          "text": "ואמיתית הענין דגם אויביו ישלים אתו הוא בהבירור בדרך מלמטה למעלה32,"
        },
        {
          "s": 18,
          "text": "דזה שנפש הבהמית יש לה אהבת ה' הוא מצד השכל דנה\"ב."
        }
      ]
    }
  ]
}