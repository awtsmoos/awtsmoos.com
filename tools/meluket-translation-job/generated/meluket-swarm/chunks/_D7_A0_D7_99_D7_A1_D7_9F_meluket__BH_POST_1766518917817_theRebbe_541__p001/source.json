{
  "globalIndex": 688,
  "owner": 38,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917817_theRebbe_541__p001",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917817_theRebbe_541__p001",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917817_theRebbe_541",
  "title": "מאמר כימי צאתך תשמ\"ב",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "י\"א ניסן ה'תשמ\"ב*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "כימי צאתך מארץ מצרים אראנו נפלאות1,"
        },
        {
          "s": 1,
          "text": "וידוע דיוק הזהר2"
        },
        {
          "s": 2,
          "text": "בזה"
        },
        {
          "s": 3,
          "text": "[הובא בדרושי רבותינו נשיאינו3]"
        },
        {
          "s": 4,
          "text": "במ\"ש כימי לשון רבים,"
        },
        {
          "s": 5,
          "text": "והרי יציאת מצרים היתה ביום אחד,"
        },
        {
          "s": 6,
          "text": "וכן בזכירת יצי\"מ כתיב4"
        },
        {
          "s": 7,
          "text": "זכור את היום הזה אשר יצאתם ממצרים,"
        },
        {
          "s": 8,
          "text": "למען תזכור את יום צאתך מארץ מצרים,"
        },
        {
          "s": 9,
          "text": "ולמה נאמר כימי לשון רבים."
        },
        {
          "s": 10,
          "text": "וגם צריך להבין בתוכן הכתוב כימי צאתך מארץ מצרים אראנו נפלאות,"
        },
        {
          "s": 11,
          "text": "דפירוש הפשוט בזה הוא שהגאולה העתידה לבוא במהרה בימינו ממש ע\"י משיח צדקנו תהי' באופן של אראנו נפלאות כמו שהיתה הגאולה דיצי\"מ,"
        },
        {
          "s": 12,
          "text": "ואינו מובן,"
        },
        {
          "s": 13,
          "text": "הרי מבואר בכו\"כ פסוקים ומאמרי רז\"ל5"
        },
        {
          "s": 14,
          "text": "שדוקא הגאולה העתידה תהי' גאולה שלימה שאין אחרי' גלות משא\"כ הגאולה דיצי\"מ,"
        },
        {
          "s": 15,
          "text": "הרי שהגאולה העתידה תהי' נעלית הרבה יותר מהגאולה דיצי\"מ,"
        },
        {
          "s": 16,
          "text": "שלכן לפי דיעה אחת אין מזכירין יצי\"מ לימות המשיח6,"
        },
        {
          "s": 17,
          "text": "וגם להדיעה שמזכירין יצי\"מ לימות המשיח6"
        },
        {
          "s": 18,
          "text": "צריך על זה לימוד מיוחד,"
        },
        {
          "s": 19,
          "text": "ומהו אומרו כימי צאתך מארץ מצרים אראנו נפלאות,"
        },
        {
          "s": 20,
          "text": "שהעילוי דגאולה העתידה היא מה שגם אז יהי' אראנו נפלאות כמו שהי' ביצי\"מ."
        },
        {
          "s": 21,
          "text": "ויתירה מזו,"
        },
        {
          "s": 22,
          "text": "דמלשון הכתוב כימי צאתך מארץ מצרים אראנו נפלאות משמע שהנפלאות שהיו בימי צאתך מארץ מצרים הם ההתחלה והשרש גם על הנפלאות שיהיו בגאולה העתידה,"
        },
        {
          "s": 23,
          "text": "דמזה מובן שיש מעלה בהגאולה דיצי\"מ על גאולה העתידה."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ונקודת הביאור בזה,"
        },
        {
          "s": 2,
          "text": "שבפסוק זה"
        },
        {
          "s": 3,
          "text": "(כימי צאתך מארץ מצרים אראנו נפלאות)"
        },
        {
          "s": 4,
          "text": "יש שני פירושים."
        },
        {
          "s": 5,
          "text": "פירוש א',"
        },
        {
          "s": 6,
          "text": "שגאולה העתידה תהי' כהגאולה דיצי\"מ,"
        },
        {
          "s": 7,
          "text": "שגם אז יהי' אראנו נפלאות כמו שהי' בהגאולה דיצי\"מ."
        },
        {
          "s": 8,
          "text": "ופירוש ב',"
        },
        {
          "s": 9,
          "text": "שהנפלאות שיהיו בגאולה העתידה יהיו נפלאות גם בערך הנפלאות שהיו בימי צאתך מארץ מצרים7."
        },
        {
          "s": 10,
          "text": "והיינו,"
        },
        {
          "s": 11,
          "text": "דהגם שבכללות הנפלאות דגאולה העתידה הן דומות להנפלאות דגאולת מצרים"
        },
        {
          "s": 12,
          "text": "(כפירוש הפשוט),"
        },
        {
          "s": 13,
          "text": "אעפ\"כ,"
        },
        {
          "s": 14,
          "text": "יהי' יתרון בהנפלאות דלעתיד,"
        },
        {
          "s": 15,
          "text": "ועד שיהיו נפלאות גם בערך הנפלאות דיצי\"מ."
        },
        {
          "s": 16,
          "text": "וביאור מעלת הנפלאות דלע\"ל על הנפלאות דיצי\"מ בלשון הקבלה,"
        },
        {
          "s": 17,
          "text": "הנה ידוע8"
        },
        {
          "s": 18,
          "text": "שביצי\"מ הוצרך להוציא את ישראל ממ\"ט שערים דלעו\"ז."
        },
        {
          "s": 19,
          "text": "דזהו מה שמיד לאחרי היציאה ממצרים מתחילים ימי ספירת העומר,"
        },
        {
          "s": 20,
          "text": "שבכל יום מימי הספירה יוצאים משער אחד דלעו\"ז."
        },
        {
          "s": 21,
          "text": "וזה"
        },
        {
          "s": 22,
          "text": "(היציאה מהשערים דלעו\"ז)"
        },
        {
          "s": 23,
          "text": "הי' ע\"י המשכת חמישים שערי בינה."
        },
        {
          "s": 24,
          "text": "ולכן הוזכר בתורה ענין יצי\"מ נ' פעמים כנגד נ' שערי בינה9."
        },
        {
          "s": 25,
          "text": "והנה ידוע שבנ' שערי בינה יש כמה דרגות10."
        },
        {
          "s": 26,
          "text": "נ' שערי בינה כמו שנמשכים במלכות,"
        },
        {
          "s": 27,
          "text": "והוא מה שמסטרא דיובלא"
        },
        {
          "s": 28,
          "text": "(בינה)"
        },
        {
          "s": 29,
          "text": "נמשכים במלכות11."
        },
        {
          "s": 30,
          "text": "ולמעלה יותר,"
        },
        {
          "s": 31,
          "text": "הנ' שערי בינה כמו שהם במקומם,"
        },
        {
          "s": 32,
          "text": "בבינה."
        },
        {
          "s": 33,
          "text": "ולמעלה יותר,"
        },
        {
          "s": 34,
          "text": "כמו שהם כלולים בשער הנ',"
        },
        {
          "s": 35,
          "text": "בבחינת הכתר"
        },
        {
          "s": 36,
          "text": "(ובכתר גופא – בבחינת עתיק)."
        },
        {
          "s": 37,
          "text": "וזהו מה שהגילויים דלע\"ל יהיו נפלאות גם בערך הנפלאות דיצי\"מ,"
        },
        {
          "s": 38,
          "text": "כי נ' שערי בינה שנמשכו ביצי\"מ הם השערים דבחינת בינה"
        },
        {
          "s": 39,
          "text": "(וזה גופא,"
        },
        {
          "s": 40,
          "text": "כמו שנמשכים ע\"י בחינת המלכות),"
        },
        {
          "s": 41,
          "text": "משא\"כ לע\"ל תהי' המשכת הנ' שערי בינה כמו שהם בכתר12."
        },
        {
          "s": 42,
          "text": "ולא עוד אלא שבכתר גופא תהי' אז ההמשכה מבחינת עתיק,"
        },
        {
          "s": 43,
          "text": "ובעתיק גופא מבחינת פנימיות עתיק12."
        },
        {
          "s": 44,
          "text": "וכמ\"ש במשיח13"
        },
        {
          "s": 45,
          "text": "הנה ישכיל עבדי ירום ונשא וגבה מאד,"
        },
        {
          "s": 46,
          "text": "דמאד"
        },
        {
          "s": 47,
          "text": "(זה דכתיב גבי משיח)"
        },
        {
          "s": 48,
          "text": "הוא בחינת פנימיות עתיק14,"
        },
        {
          "s": 49,
          "text": "ובלשון הפע\"ח15,"
        },
        {
          "s": 50,
          "text": "שכל ההמשכות עכשיו הם רק מבחינת חיצוניות עתיק ולע\"ל תהי' המשכת וגילוי בחינת פנימיות עתיק."
        },
        {
          "s": 51,
          "text": "אלא שאעפ\"כ מדמה הכתוב הנפלאות שיהיו בגאולה העתידה להנפלאות שהיו ביצי\"מ,"
        },
        {
          "s": 52,
          "text": "וכפירוש הפשוט בכתוב שבגאולה העתידה יהי' אראנו נפלאות כמו שהי' בימי צאתך מארץ מצרים,"
        },
        {
          "s": 53,
          "text": "כי גם ביצי\"מ היו גילויים הכי נעלים,"
        },
        {
          "s": 54,
          "text": "וכמבואר בהמשך תער\"ב16"
        },
        {
          "s": 55,
          "text": "בפירוש נגלה עליהם מלך מלכי המלכים הקב\"ה בכבודו ובעצמו17,"
        },
        {
          "s": 56,
          "text": "שבכבודו ובעצמו הם דרגות הכי נעלות."
        },
        {
          "s": 57,
          "text": "אלא שביצי\"מ הי' הגילוי דבחינה זו ע\"י ההתלבשות בבחינת מלכות,"
        },
        {
          "s": 58,
          "text": "ופסח ה' על הפתח18,"
        },
        {
          "s": 59,
          "text": "דפתח הוא בחינת המלכות19,"
        },
        {
          "s": 60,
          "text": "ולע\"ל יהי' זה בגילוי בלי שום לבוש כמ\"ש20"
        },
        {
          "s": 61,
          "text": "ולא יכנף עוד מוריך."
        }
      ]
    }
  ]
}