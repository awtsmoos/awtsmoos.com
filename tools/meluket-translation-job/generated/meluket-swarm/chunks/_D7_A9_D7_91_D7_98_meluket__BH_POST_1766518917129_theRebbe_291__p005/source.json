{
  "globalIndex": 592,
  "owner": 42,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917129_theRebbe_291__p005",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917129_theRebbe_291__p005",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518917129_theRebbe_291",
  "title": "מאמר כי תשא תשל\"א",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דזה שמובא לעיל"
        },
        {
          "s": 2,
          "text": "(סעיף ה)"
        },
        {
          "s": 3,
          "text": "שעיקר הכפרה הוא גמילות חסדים לפי שפנימיות הרצון דלמעלה הוא בהמשכה למטה,"
        },
        {
          "s": 4,
          "text": "חסד חפצתי,"
        },
        {
          "s": 5,
          "text": "הוא בעיקר בנוגע לזה שיהי' מרוצה לפניו ית',"
        },
        {
          "s": 6,
          "text": "וגם בנוגע לתיקון הפגמים."
        },
        {
          "s": 7,
          "text": "אבל בנוגע ביטול הפגמים"
        },
        {
          "s": 8,
          "text": "[דענין זה הוא מפני שעצמות אוא\"ס בעל הרצון הוא מובדל מהרצון],"
        },
        {
          "s": 9,
          "text": "יש יתרון בהמשכה ששייכת להעלאה."
        },
        {
          "s": 10,
          "text": "דע\"י ההעלאה"
        },
        {
          "s": 11,
          "text": "(יציאה ממציאותו,"
        },
        {
          "s": 12,
          "text": "ביטול)"
        },
        {
          "s": 13,
          "text": "מגיעים לענין זה שבבעל הרצון שהוא מובדל מהרצון."
        },
        {
          "s": 14,
          "text": "וע\"י ההמשכה שלאחרי ההעלאה נמשך ענין זה"
        },
        {
          "s": 15,
          "text": "(שאוא\"ס הוא מובדל מהרצון)"
        },
        {
          "s": 16,
          "text": "למטה,"
        },
        {
          "s": 17,
          "text": "ועי\"ז מתבטלים הפגמים."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "וזהו כי תשא את ראש בני ישראל גו' ואיתא בגמרא אמר משה לפני הקב\"ה רבש\"ע במה תרום קרן ישראל אמר לו בכי תשא,"
        },
        {
          "s": 2,
          "text": "דיש לומר ששני הענינים בכי תשא – נשיאת והגבהת הראש דבנ\"י והרמת קרן ישראל,"
        },
        {
          "s": 3,
          "text": "הם ע\"ד שני הענינים דגמ\"ח,"
        },
        {
          "s": 4,
          "text": "גמ\"ח כפשוטה וגמ\"ח דתפלה."
        },
        {
          "s": 5,
          "text": "והענין הוא,"
        },
        {
          "s": 6,
          "text": "דהחלישות53"
        },
        {
          "s": 7,
          "text": "(ירידה והשפלה)"
        },
        {
          "s": 8,
          "text": "שנעשה ע\"י החטא בהראש דהנשמה,"
        },
        {
          "s": 9,
          "text": "שאין ביכלתו להאיר בכחות הפנימיים,"
        },
        {
          "s": 10,
          "text": "הוא ע\"ד סילוק האור שנעשה מצד הפגם,"
        },
        {
          "s": 11,
          "text": "שהאור מסתלק לשרשו ואינו מאיר בהכלים54."
        },
        {
          "s": 12,
          "text": "וענין נשיאת והגבהת הראש"
        },
        {
          "s": 13,
          "text": "[שכח הגילוי דבחינת ראש בהנשמה הוא בתוקף כמו שהי' תחלה,"
        },
        {
          "s": 14,
          "text": "להאיר בכחות הפנימיים]"
        },
        {
          "s": 15,
          "text": "שע\"י נתינת כופר לצדקה הוא ע\"ד הכפרה"
        },
        {
          "s": 16,
          "text": "(מילוי הפגמים והחזרת הרצון)"
        },
        {
          "s": 17,
          "text": "שע\"י גמילות חסד כפשוטה."
        },
        {
          "s": 18,
          "text": "והתמי' של משה היתה במה תרום קרן ישראל,"
        },
        {
          "s": 19,
          "text": "דכיון שהירידה שבדרגת הקרן היא"
        },
        {
          "s": 20,
          "text": "(לא שהחטא פעל בה ירידה,"
        },
        {
          "s": 21,
          "text": "אלא)"
        },
        {
          "s": 22,
          "text": "שלא נשלמה הכוונה שבשבילה ירדה למטה,"
        },
        {
          "s": 23,
          "text": "תמה משה איך אפשר לתקן זה."
        },
        {
          "s": 24,
          "text": "ויש לומר,"
        },
        {
          "s": 25,
          "text": "דזה שאמר משה לפני הקב\"ה במה תרום קרן ישראל,"
        },
        {
          "s": 26,
          "text": "הוא כי בכדי לתקן זה שלא נשלמה הכוונה הוא ע\"י ההמשכה מעצמות אוא\"ס בעל הרצון שמובדל מהרצון,"
        },
        {
          "s": 27,
          "text": "ולכן אמר זה משה לפני הקדוש ב\"ה שהוא קדוש ומובדל,"
        },
        {
          "s": 28,
          "text": "ויתירה מזה,"
        },
        {
          "s": 29,
          "text": "לפני הקב\"ה,"
        },
        {
          "s": 30,
          "text": "בכדי להמשיך משם."
        },
        {
          "s": 31,
          "text": "אמר לו בכי תשא,"
        },
        {
          "s": 32,
          "text": "בזה שמשה ישא את ראשם בהגבהה,"
        },
        {
          "s": 33,
          "text": "שגם המשכת בחינת לפני הקב\"ה צריכה להיות ע\"י בחינת חכמה"
        },
        {
          "s": 34,
          "text": "(ענינו של משה),"
        },
        {
          "s": 35,
          "text": "וע\"ד הידוע שגם גילוי הסובב הוא ע\"י הממלא."
        },
        {
          "s": 36,
          "text": "ואף שהפעולה דמשה"
        },
        {
          "s": 37,
          "text": "(מצד עצמו)"
        },
        {
          "s": 38,
          "text": "היא כי תשא את ראש,"
        },
        {
          "s": 39,
          "text": "נמשך בזה גם הכח דבחינת לפני הקב\"ה,"
        },
        {
          "s": 40,
          "text": "שעי\"ז נעשה הרמת קרן ישראל."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ובכדי שענין זה יומשך לישראל הוא ע\"י שנשיאת והגבהת הראש שלהם הוא ע\"י שמשה לוקח מהם כופר,"
        },
        {
          "s": 1,
          "text": "כלשון רש\"י קח מהם כופר לצדקה,"
        },
        {
          "s": 2,
          "text": "ענין ההעלאה שבצדקה."
        },
        {
          "s": 3,
          "text": "וע\"ד המבואר לעיל"
        },
        {
          "s": 4,
          "text": "(סעיף ז),"
        },
        {
          "s": 5,
          "text": "שע\"י גמ\"ח כפשוטה הוא המשכת הרצון מבעל הרצון,"
        },
        {
          "s": 6,
          "text": "ובכדי להגיע לענין זה שבבעל הרצון שהוא מובדל מהרצון הוא ע\"י גמ\"ח דתפלה,"
        },
        {
          "s": 7,
          "text": "המשכה ששייכת להעלאה,"
        },
        {
          "s": 8,
          "text": "עד\"ז הוא בענין כופר נפשו,"
        },
        {
          "s": 9,
          "text": "שע\"י נתינת הכופר לצדקה"
        },
        {
          "s": 10,
          "text": "(המשכה)"
        },
        {
          "s": 11,
          "text": "הוא המשכת הרצון,"
        },
        {
          "s": 12,
          "text": "ועי\"ז נעשה נשיאת והרמת הראש."
        },
        {
          "s": 13,
          "text": "וע\"י שמשה לוקח מהם כופר לצדקה"
        },
        {
          "s": 14,
          "text": "(ענין ההעלאה שבצדקה)"
        },
        {
          "s": 15,
          "text": "הוא המשכת עצמות אוא\"ס שמובדל מהרצון,"
        },
        {
          "s": 16,
          "text": "ועי\"ז תרום קרן ישראל,"
        },
        {
          "s": 17,
          "text": "ובאופן דקרנו55"
        },
        {
          "s": 18,
          "text": "תרום בכבוד."
        }
      ]
    }
  ]
}