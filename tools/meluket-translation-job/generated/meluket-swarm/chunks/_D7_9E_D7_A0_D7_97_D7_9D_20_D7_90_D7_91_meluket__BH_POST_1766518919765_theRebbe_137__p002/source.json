{
  "globalIndex": 1006,
  "owner": 6,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919765_theRebbe_137__p002",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919765_theRebbe_137__p002",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919765_theRebbe_137",
  "title": "מאמר קץ שם לחושך תשכ\"ד",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה ידוע שכל גילוי הוא ע\"י תורה"
        },
        {
          "s": 2,
          "text": "(תורה אור13)."
        },
        {
          "s": 3,
          "text": "ומזה מובן,"
        },
        {
          "s": 4,
          "text": "דכיון שביטול חושך הגלות הוא ע\"י אור,"
        },
        {
          "s": 5,
          "text": "לכן,"
        },
        {
          "s": 6,
          "text": "בכדי לקרב ולמהר עוד יותר את הגאולה העתידה,"
        },
        {
          "s": 7,
          "text": "הוא ע\"י הלימוד בתורה בענין האור14."
        },
        {
          "s": 8,
          "text": "ולהעיר,"
        },
        {
          "s": 9,
          "text": "דבהדרוש של אדמו\"ר"
        },
        {
          "s": 10,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 11,
          "text": "נ\"ע שנאמר בשבת תשעה באב נדחה15"
        },
        {
          "s": 12,
          "text": "מדובר בענין האור."
        },
        {
          "s": 13,
          "text": "דיש לומר,"
        },
        {
          "s": 14,
          "text": "שהשייכות דענין זה לתשעה באב נדחה הוא16,"
        },
        {
          "s": 15,
          "text": "כי תשעה באב שחל בשבת ונדחה הוא מסוגל לפעול שיהי' נדחה לגמרי17,"
        },
        {
          "s": 16,
          "text": "ודחיית וביטול הגלות הוא ע\"י אור18."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ומבואר בהמאמר,"
        },
        {
          "s": 1,
          "text": "דאור הוא אין,"
        },
        {
          "s": 2,
          "text": "ביטול."
        },
        {
          "s": 3,
          "text": "[דהחילוק בין אור וכלי,"
        },
        {
          "s": 4,
          "text": "הוא,"
        },
        {
          "s": 5,
          "text": "שאור הוא אין וכלי הוא יש]."
        },
        {
          "s": 6,
          "text": "ובהביטול דאור ג' מדריגות."
        },
        {
          "s": 7,
          "text": "הביטול דאור מצד עצמו,"
        },
        {
          "s": 8,
          "text": "מפני שאור הוא מעין המאור,"
        },
        {
          "s": 9,
          "text": "והביטול שבו ע\"י שנרגש בו מקורו,"
        },
        {
          "s": 10,
          "text": "והביטול שלו מצד טבע הרצוא והעלי' שבו ליכלל במקורו."
        },
        {
          "s": 11,
          "text": "וצריך להבין,"
        },
        {
          "s": 12,
          "text": "הרי גם הביטול דאור שמצד עצמו הוא"
        },
        {
          "s": 13,
          "text": "(לכאורה)"
        },
        {
          "s": 14,
          "text": "זה שאור אינו מציאות לעצמו וענינו הוא גילוי המאור,"
        },
        {
          "s": 15,
          "text": "ומהו החילוק בין האור עצמו"
        },
        {
          "s": 16,
          "text": "(שענינו הוא גילוי המאור)"
        },
        {
          "s": 17,
          "text": "לזה שנרגש בו מקורו."
        },
        {
          "s": 18,
          "text": "גם צריך להבין מ\"ש בהמאמר19"
        },
        {
          "s": 19,
          "text": "שהביטול שבהאור ע\"י שנרגש בו מקורו הוא הביטול דכלא חשיב,"
        },
        {
          "s": 20,
          "text": "הרי זה שהאור אינו מציאות לעצמו וענינו הוא גילוי המאור,"
        },
        {
          "s": 21,
          "text": "הוא,"
        },
        {
          "s": 22,
          "text": "לכאורה,"
        },
        {
          "s": 23,
          "text": "ביטול גדול יותר מהביטול דכלא חשיב"
        },
        {
          "s": 24,
          "text": "[כי הביטול דכלא חשיב הוא רק בנוגע לחשיבותו,"
        },
        {
          "s": 25,
          "text": "שאין לו ערך וחשיבות לגבי מקורו,"
        },
        {
          "s": 26,
          "text": "ואין זה נוגע לעצם מציאותו],"
        },
        {
          "s": 27,
          "text": "ובהמאמר אומר,"
        },
        {
          "s": 28,
          "text": "שהביטול שניתוסף בהאור ע\"י שנרגש בו מקורו,"
        },
        {
          "s": 29,
          "text": "על הביטול שלו מצד עצמו"
        },
        {
          "s": 30,
          "text": "(שענינו הוא גילוי המאור),"
        },
        {
          "s": 31,
          "text": "הוא הביטול דכלא חשיב."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר הביאור בזה ע\"פ הידוע20,"
        },
        {
          "s": 1,
          "text": "דהגם שאור הוא מעין המאור,"
        },
        {
          "s": 2,
          "text": "מ\"מ,"
        },
        {
          "s": 3,
          "text": "כיון שהמאור הוא מובדל מהאור"
        },
        {
          "s": 4,
          "text": "(שהמאור אינו מקור להאור ורק שהוא נמצא ממנו),"
        },
        {
          "s": 5,
          "text": "לכן זה שהאור מגלה את המאור הוא רק מציאות המאור ולא מהותו21."
        },
        {
          "s": 6,
          "text": "אלא שאעפ\"כ,"
        },
        {
          "s": 7,
          "text": "מצד דביקותו של האור בהמאור נרגש בו גם מהות המאור"
        },
        {
          "s": 8,
          "text": "(שמובדל מהאור ואינו מתגלה בו)."
        },
        {
          "s": 9,
          "text": "ועי\"ז הוא מתבטל ממציאותו."
        },
        {
          "s": 10,
          "text": "דמציאות האור הוא גילוי"
        },
        {
          "s": 11,
          "text": "(המאור),"
        },
        {
          "s": 12,
          "text": "וע\"י שנרגש בו שהמאור"
        },
        {
          "s": 13,
          "text": "(מהות המאור)"
        },
        {
          "s": 14,
          "text": "הוא למעלה מגילוי,"
        },
        {
          "s": 15,
          "text": "ושהגילוי אין לו ערך"
        },
        {
          "s": 16,
          "text": "(כלא חשיב)"
        },
        {
          "s": 17,
          "text": "לגבי המאור,"
        },
        {
          "s": 18,
          "text": "הוא מתבטל ממציאותו."
        }
      ]
    }
  ]
}