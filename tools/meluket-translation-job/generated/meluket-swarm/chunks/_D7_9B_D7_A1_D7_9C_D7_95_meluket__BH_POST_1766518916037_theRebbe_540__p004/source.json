{
  "globalIndex": 397,
  "owner": 47,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518916037_theRebbe_540__p004",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518916037_theRebbe_540__p004",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518916037_theRebbe_540",
  "title": "מאמר וישב יעקב תשכ\"ז",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה ידוע שחטא עה\"ד פעל הענין דתערובות טוב ורע,"
        },
        {
          "s": 2,
          "text": "וכמבואר בשיחה של כ\"ק מו\"ח אדמו\"ר מי\"ט כסלו48"
        },
        {
          "s": 3,
          "text": "דבכל דבר ודבר יש תערובות טוב ורע ואין טוב בלא רע,"
        },
        {
          "s": 4,
          "text": "ואין רע בלא טוב,"
        },
        {
          "s": 5,
          "text": "כידוע49"
        },
        {
          "s": 6,
          "text": "שלאחר חטא עה\"ד כל דבר שבעולם הוא באופן של התערבות טו\"ר."
        },
        {
          "s": 7,
          "text": "וענין זה הוא מצד הדעת,"
        },
        {
          "s": 8,
          "text": "דהנה,"
        },
        {
          "s": 9,
          "text": "מי שאין לו דעת כלל או שיש לו רק קטנות הדעת,"
        },
        {
          "s": 10,
          "text": "הולך לפי תומו,"
        },
        {
          "s": 11,
          "text": "היינו,"
        },
        {
          "s": 12,
          "text": "שכל דבר שעושה הוא בתכלית התמימות ללא התערבות דבר הפכי,"
        },
        {
          "s": 13,
          "text": "דכאשר עושה דבר טוב אין מעורב בו רע,"
        },
        {
          "s": 14,
          "text": "וכאשר עושה דבר רע אין מעורב בו טוב,"
        },
        {
          "s": 15,
          "text": "מפני שאין לו דעת וערמומיות,"
        },
        {
          "s": 16,
          "text": "משא\"כ מי שיש לו דעת וערמומיות,"
        },
        {
          "s": 17,
          "text": "שיכול להסתיר את עצמו"
        },
        {
          "s": 18,
          "text": "(ער קען זיך אויסבאַהאַלטן),"
        },
        {
          "s": 19,
          "text": "אזי אפשר שבעשיית הדבר תהי' לו איזה כוונה ופני' וכיו\"ב,"
        },
        {
          "s": 20,
          "text": "שאז הנה גם כאשר בחיצוניות עושה דבר טוב,"
        },
        {
          "s": 21,
          "text": "מ\"מ,"
        },
        {
          "s": 22,
          "text": "יכול להיות שבפנימיות הרי זה דבר רע,"
        },
        {
          "s": 23,
          "text": "וכן להיפך שבחיצוניות הוא רע ובפנימיות הוא טוב."
        },
        {
          "s": 24,
          "text": "וע\"ד מ\"ש50"
        },
        {
          "s": 25,
          "text": "חושך שבטו שונא בנו,"
        },
        {
          "s": 26,
          "text": "שאף שבגלוי הו\"ע של גבורה שמייסר את בנו,"
        },
        {
          "s": 27,
          "text": "הרי מצד הכוונה שבזה הו\"ע של חסד,"
        },
        {
          "s": 28,
          "text": "שעושה זאת מצד אהבתו אל בנו,"
        },
        {
          "s": 29,
          "text": "והיינו,"
        },
        {
          "s": 30,
          "text": "שאע\"פ שמצד אהבתו אל בנו רוצה רק להטיב לו בטוב הגלוי,"
        },
        {
          "s": 31,
          "text": "מ\"מ,"
        },
        {
          "s": 32,
          "text": "ע\"י הדעת נעשה התגברות השכל להטות את המדה,"
        },
        {
          "s": 33,
          "text": "כיון שמעמיק ומבין שאע\"פ שאוהב את בנו,"
        },
        {
          "s": 34,
          "text": "מ\"מ,"
        },
        {
          "s": 35,
          "text": "לטובתו צריך לייסרו,"
        },
        {
          "s": 36,
          "text": "ועי\"ז נעשית אצלו נטי' לגבורה,"
        },
        {
          "s": 37,
          "text": "ומצד הנטי' למדת הגבורה,"
        },
        {
          "s": 38,
          "text": "בא אח\"כ בגלוי שמייסר את בנו."
        },
        {
          "s": 39,
          "text": "וזהו ענין חטא עה\"ד,"
        },
        {
          "s": 40,
          "text": "שענין הדעת פועל תערובות טו\"ר."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "אך צריך להבין,"
        },
        {
          "s": 1,
          "text": "שהרי הקליפות אין להם מוח הדעת,"
        },
        {
          "s": 2,
          "text": "וכמ\"ש בזהר51"
        },
        {
          "s": 3,
          "text": "אל אחר אסתריס ולא עביד פירין כו'."
        },
        {
          "s": 4,
          "text": "והביאור בזה,"
        },
        {
          "s": 5,
          "text": "שזה שאין להם דעת היינו פנימיות הדעת,"
        },
        {
          "s": 6,
          "text": "שפועל ביטול בהמדות,"
        },
        {
          "s": 7,
          "text": "שמזה אין יניקה ללעו\"ז,"
        },
        {
          "s": 8,
          "text": "אבל יש להם חיצוניות הדעת,"
        },
        {
          "s": 9,
          "text": "שמזה יכול להיות יניקה ללעו\"ז,"
        },
        {
          "s": 10,
          "text": "ועי\"ז נעשה תערובות טו\"ר."
        },
        {
          "s": 11,
          "text": "והענין הוא,"
        },
        {
          "s": 12,
          "text": "דהנה,"
        },
        {
          "s": 13,
          "text": "ענין ההתערבות שייך רק כשיש פרטים,"
        },
        {
          "s": 14,
          "text": "וכמ\"ש אדמו\"ר האמצעי52"
        },
        {
          "s": 15,
          "text": "שד' היסודות כמו שהן מצד עצמן לא שייך בהם ענין ההתכללות,"
        },
        {
          "s": 16,
          "text": "ורק מצד זה שיסוד האש יש בו ג\"כ יסוד המים ויסוד המים יש בו ג\"כ יסוד האש כו',"
        },
        {
          "s": 17,
          "text": "לכן שייך ענין ההתכללות."
        },
        {
          "s": 18,
          "text": "וכן הוא בענין הדעת,"
        },
        {
          "s": 19,
          "text": "שלהיותו ענין ההעמקה שעי\"ז בא השכל בריבוי פרטים,"
        },
        {
          "s": 20,
          "text": "לכן פועל ענין ההתכללות וההתערבות."
        },
        {
          "s": 21,
          "text": "ואין זה סתירה להמבואר במ\"א53"
        },
        {
          "s": 22,
          "text": "שריבוי הפרטים שבשכל באים ע\"י הבינה,"
        },
        {
          "s": 23,
          "text": "כי,"
        },
        {
          "s": 24,
          "text": "מצד הבינה נמצאים הפרטים רק בדרך כלל,"
        },
        {
          "s": 25,
          "text": "משא\"כ כשמבין ע\"י ההעמקה שבכח הדעת,"
        },
        {
          "s": 26,
          "text": "אזי בא הענין בפרטי פרטיות כו'."
        },
        {
          "s": 27,
          "text": "וזהו מעלת הדעת על המוחין חו\"ב,"
        },
        {
          "s": 28,
          "text": "דהנה בכללות השכל יש אורך רוחב ועומק,"
        },
        {
          "s": 29,
          "text": "אורך הו\"ע נקודת החכמה,"
        },
        {
          "s": 30,
          "text": "היינו שעצם הסברא כמו שהיא נמשכת ויורדת ממדריגה למדריגה,"
        },
        {
          "s": 31,
          "text": "רק שהיא בבחי' התלבשות כו'."
        },
        {
          "s": 32,
          "text": "ורוחב הו\"ע הבינה שמפרט את הפרטים שבשכל,"
        },
        {
          "s": 33,
          "text": "אבל זהו בכללות עדיין."
        },
        {
          "s": 34,
          "text": "ואח\"כ בא ענין העומק שהו\"ע הדעת,"
        },
        {
          "s": 35,
          "text": "שמצד העומק נעשה אמיתית ענין הפרטים,"
        },
        {
          "s": 36,
          "text": "שמוצא בהשכל כל הפרטי פרטים שבו,"
        },
        {
          "s": 37,
          "text": "ומצד זה יכול להיות ההתכללות וההתערבות."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "אמנם עפ\"ז צריך להבין מ\"ש התרגום עה\"פ54"
        },
        {
          "s": 2,
          "text": "עץ הדעת טוב ורע,"
        },
        {
          "s": 3,
          "text": "דאכלין מיני' חכימין בין טב לביש,"
        },
        {
          "s": 4,
          "text": "היינו,"
        },
        {
          "s": 5,
          "text": "שע\"י הדעת יכול להבחין להבדיל ולהפריש בין טוב לרע."
        },
        {
          "s": 6,
          "text": "וכדאיתא בגמרא55"
        },
        {
          "s": 7,
          "text": "שמפני זה קבעו הבדלה בחונן הדעת,"
        },
        {
          "s": 8,
          "text": "שאם אין דיעה הבדלה מניין כו'."
        },
        {
          "s": 9,
          "text": "וכאן מבואר להיפך,"
        },
        {
          "s": 10,
          "text": "שע\"י הדעת נעשה תערובות טו\"ר."
        },
        {
          "s": 11,
          "text": "אך הענין הוא,"
        },
        {
          "s": 12,
          "text": "דהנה,"
        },
        {
          "s": 13,
          "text": "כאשר הרע הוא בגלוי ובגסות,"
        },
        {
          "s": 14,
          "text": "אזי העבודה להבחין בו כו' אינה קשה כ\"כ,"
        },
        {
          "s": 15,
          "text": "ואין צריכים על זה למוח הדעת דוקא."
        },
        {
          "s": 16,
          "text": "אמנם,"
        },
        {
          "s": 17,
          "text": "כיון שע\"י חטא עה\"ד נעשה תערובות טוב ורע בעולם,"
        },
        {
          "s": 18,
          "text": "ונעשה גם דקות הרע,"
        },
        {
          "s": 19,
          "text": "הנה על זה יש צורך בעבודה ביגיעה דוקא"
        },
        {
          "s": 20,
          "text": "(ועי\"ז ומצאת56),"
        },
        {
          "s": 21,
          "text": "להבחין גם בדקות הרע ולברר הטוב מהרע."
        },
        {
          "s": 22,
          "text": "והענין בזה,"
        },
        {
          "s": 23,
          "text": "דהנה כתיב57"
        },
        {
          "s": 24,
          "text": "חבלי השוא וכעבות העגלה חטאה,"
        },
        {
          "s": 25,
          "text": "היינו,"
        },
        {
          "s": 26,
          "text": "שאם מתחילה לא יהי' חבלי השוא,"
        },
        {
          "s": 27,
          "text": "אי אפשר שיבוא לידי חטא שהוא כעבותות העגלה,"
        },
        {
          "s": 28,
          "text": "דאיך שייך שיעשה דבר כזה,"
        },
        {
          "s": 29,
          "text": "ורק עי\"ז שבתחילה הי' חבלי השוא,"
        },
        {
          "s": 30,
          "text": "שהו\"ע דקות הרע,"
        },
        {
          "s": 31,
          "text": "הנה מזה בא אח\"כ לעבותות העגלה חטאה,"
        },
        {
          "s": 32,
          "text": "גסות הרע."
        },
        {
          "s": 33,
          "text": "אך כדי להבחין בדקות הרע ולבררו צריך להתייגע יותר,"
        },
        {
          "s": 34,
          "text": "וכידוע58"
        },
        {
          "s": 35,
          "text": "שיעקב הי' בבית לבן כ' שנה בכדי לברר גם דקות הרע,"
        },
        {
          "s": 36,
          "text": "משא\"כ גבי עשו לא הי' צריך ריבוי זמן,"
        },
        {
          "s": 37,
          "text": "משום שבעשו הי' רק גסות הרע."
        },
        {
          "s": 38,
          "text": "וענין זה נעשה ע\"י מוח הדעת,"
        },
        {
          "s": 39,
          "text": "והיינו,"
        },
        {
          "s": 40,
          "text": "מצד המרחב שבדעת,"
        },
        {
          "s": 41,
          "text": "שנכנס בעומק הדבר ויודע כל הפרטים שבו"
        },
        {
          "s": 42,
          "text": "(שמצד זה גופא נעשה התכללות והתערבות טו\"ר כנ\"ל),"
        },
        {
          "s": 43,
          "text": "יש בכחו להבחין גם בדקות הרע ולברר הטוב מן הרע."
        }
      ]
    }
  ]
}