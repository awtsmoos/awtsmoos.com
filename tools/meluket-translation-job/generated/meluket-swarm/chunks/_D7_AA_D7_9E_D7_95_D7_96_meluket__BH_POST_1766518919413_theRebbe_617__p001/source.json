{
  "globalIndex": 955,
  "owner": 5,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919413_theRebbe_617__p001",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919413_theRebbe_617__p001",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919413_theRebbe_617",
  "title": "מאמר אך בגורל תשל\"ה",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ד' פ' פינחס,"
        },
        {
          "s": 2,
          "text": "ט\"ז תמוז,"
        },
        {
          "s": 3,
          "text": "תשל\"ה*."
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "אך בגורל יחלק את הארץ1,"
        },
        {
          "s": 1,
          "text": "חלוקת ארה\"ק,"
        },
        {
          "s": 2,
          "text": "שכבשו את ארץ כנען2"
        },
        {
          "s": 3,
          "text": "ועשו אותה ארץ ישראל,"
        },
        {
          "s": 4,
          "text": "ועד שעוד בהיות בנ\"י במדבר"
        },
        {
          "s": 5,
          "text": "(טרם שבאו לא\"י)"
        },
        {
          "s": 6,
          "text": "נאמר עלי' ארץ אשר גו' עיני ה\"א בה מרשית השנה ועד אחרית שנה3,"
        },
        {
          "s": 7,
          "text": "הנה מבאר אשר חלוקת ארה\"ק הייתה ע\"פ הגורל."
        },
        {
          "s": 8,
          "text": "והוספה בזה על פי ה'4"
        },
        {
          "s": 9,
          "text": "ומפרש רש\"י5"
        },
        {
          "s": 10,
          "text": "ברוח הקודש."
        },
        {
          "s": 11,
          "text": "ועוד ענין הי' בחלוקת הארץ לרב תרבה נחלתו ולמעט תמעיט נחלתו6,"
        },
        {
          "s": 12,
          "text": "שהו\"ע עפ\"י שכל."
        },
        {
          "s": 13,
          "text": "שהרי פירוש הפשוט בלרב תרבה גו' הוא כמו שמפרש רש\"י"
        },
        {
          "s": 14,
          "text": "[אשר פירוש רש\"י עה\"ת הוא פשוטו של מקרא7]"
        },
        {
          "s": 15,
          "text": "לשבט שהי' מרובה באוכלוסין נתנו חלק רב שלא היו החלקים שוים כו',"
        },
        {
          "s": 16,
          "text": "דחלוקה זו היא ע\"פ שכל."
        },
        {
          "s": 17,
          "text": "[והגם דהרמב\"ן פליג ע\"ז וכן יש פירושים אחרים ברש\"י8,"
        },
        {
          "s": 18,
          "text": "הרי הרמב\"ן מפרש כוונת רש\"י כפשוטה."
        },
        {
          "s": 19,
          "text": "ואפילו להרמב\"ן וכן לפי מפרשים אלו שמפרשים את דברי רש\"י כדעת הרמב\"ן,"
        },
        {
          "s": 20,
          "text": "הנה מזה גופא שלפי פירושם הוצרך הכתוב לשלול החלוקה ע\"פ שכל מוכח שיש לחלוקה זו שייכות לשכל."
        },
        {
          "s": 21,
          "text": "אבל עיקר המדובר כאן הוא פשטות הכתוב ופשטות פירוש רש\"י והספרי9."
        },
        {
          "s": 22,
          "text": "שהחלוקה הייתה לפי מספר האנשים,"
        },
        {
          "s": 23,
          "text": "שהיא חלוקה ע\"פ שכל]."
        },
        {
          "s": 24,
          "text": "נמצא שבחלוקת הארץ היו ג' ענינים."
        },
        {
          "s": 25,
          "text": "ע\"פ גורל,"
        },
        {
          "s": 26,
          "text": "ע\"פ רוה\"ק,"
        },
        {
          "s": 27,
          "text": "וע\"פ שכל המובן גם בנפש השכלית."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה הענין דחלוקת הארץ ע\"פ גורל מבאר כ\"ק אדמו\"ר הצ\"צ10,"
        },
        {
          "s": 2,
          "text": "מיוסד על מאמר כ\"ק אדמו\"ר הזקן11"
        },
        {
          "s": 3,
          "text": "במה שאמר ריב\"ז איני יודע באיזו דרך מוליכים אותי12,"
        },
        {
          "s": 4,
          "text": "דלכאורה תמוה,"
        },
        {
          "s": 5,
          "text": "והרי ריב\"ז לא הלך ד\"א בלא תורה ובלא תפילין13,"
        },
        {
          "s": 6,
          "text": "ופ' שנה למד ולימד תורה14"
        },
        {
          "s": 7,
          "text": "וכו',"
        },
        {
          "s": 8,
          "text": "ומה מקום לספק באיזו דרך מוליכין אותו,"
        },
        {
          "s": 9,
          "text": "ומבאר בזה כ\"ק אדה\"ז שזהו מצד עצם הנפש,"
        },
        {
          "s": 10,
          "text": "היינו מצד בחי' הנפש שלמעלה מטו\"ד."
        },
        {
          "s": 11,
          "text": "ולכן אמר ריב\"ז איני יודע כו',"
        },
        {
          "s": 12,
          "text": "אע\"פ שעסק בתורה וכו',"
        },
        {
          "s": 13,
          "text": "כי זה שעסק בתורה הו\"ע השייך לטו\"ד ואין מזה ראי' להבחי' שלמעלה מטו\"ד."
        },
        {
          "s": 14,
          "text": "והנה גם בחינה זו,"
        },
        {
          "s": 15,
          "text": "מכיון שיש בזה הענין דשכר ועונש"
        },
        {
          "s": 16,
          "text": "(כמובן מזה גופא שאמר ריב\"ז איני יודע באיזו דרך מוליכין אותי),"
        },
        {
          "s": 17,
          "text": "מוכח מזה,"
        },
        {
          "s": 18,
          "text": "שיש אפשריות ויכולת ורשות לכל אדם נתונה15"
        },
        {
          "s": 19,
          "text": "גם בנוגע לבחינה זו שבנפש."
        },
        {
          "s": 20,
          "text": "והיינו שיש עבודה כזו שפועלת גם בעצם הנפש ושעל ידה תהי' כדבעי16."
        },
        {
          "s": 21,
          "text": "ובחינה זו שבנפש,"
        },
        {
          "s": 22,
          "text": "וכן העבודה השייכת לבחינה זו,"
        },
        {
          "s": 23,
          "text": "נקראת בשם גורל17."
        },
        {
          "s": 24,
          "text": "ועפ\"ז מבאר הצ\"צ הענין דחלוקת הארץ שע\"פ גורל."
        }
      ]
    }
  ]
}