{
  "globalIndex": 130,
  "owner": 30,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914440_theRebbe_936__p005",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914440_theRebbe_936__p005",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914440_theRebbe_936",
  "title": "מאמר תורה צוה תשכ\"ג",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "וזוהי השייכות דג' ענינים אלה שבישראל"
        },
        {
          "s": 1,
          "text": "(יעקב,"
        },
        {
          "s": 2,
          "text": "ישראל וישורון)"
        },
        {
          "s": 3,
          "text": "לג' הענינים שבתורה,"
        },
        {
          "s": 4,
          "text": "דענין הירושה שבתורה שהוא מצד הבירורים"
        },
        {
          "s": 5,
          "text": "[שע\"י הבירורים דתורה יורשים את האורות דתהו,"
        },
        {
          "s": 6,
          "text": "כנ\"ל סעיף ב],"
        },
        {
          "s": 7,
          "text": "הוא מצד בחינת יעקב,"
        },
        {
          "s": 8,
          "text": "דעבודת הבירורים היא בבחינת יעקב."
        },
        {
          "s": 9,
          "text": "והענין דהתקן עצמך ללמוד תורה,"
        },
        {
          "s": 10,
          "text": "שע\"י עסק התורה לשמה נמשך הגילוי דתורה כמו שהיא למעלה"
        },
        {
          "s": 11,
          "text": "(פנימיות התורה),"
        },
        {
          "s": 12,
          "text": "הוא מצד בחינת ישראל46,"
        },
        {
          "s": 13,
          "text": "דעסק התורה דבחינת ישראל הוא"
        },
        {
          "s": 14,
          "text": "(לא בכדי לברר בירורים,"
        },
        {
          "s": 15,
          "text": "אלא)"
        },
        {
          "s": 16,
          "text": "בכדי להמשיך גילוי אלקות."
        },
        {
          "s": 17,
          "text": "וענין המתנה דתורה שהוא המשכת התענוג דתורה"
        },
        {
          "s": 18,
          "text": "(שלמעלה מהשגה)"
        },
        {
          "s": 19,
          "text": "שלמעלה מהתחלקות הוא מצד בחינת ישורון."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וצריך להבין,"
        },
        {
          "s": 2,
          "text": "דלפי ביאור הנ\"ל,"
        },
        {
          "s": 3,
          "text": "הטעם שהתורה נקראת בשם ירושה הוא לפי שהתורה מביאה לירושה"
        },
        {
          "s": 4,
          "text": "(שע\"י הבירורים שע\"י התורה יורשים אורות דתהו),"
        },
        {
          "s": 5,
          "text": "והפירוש דתורה גו' מורשה"
        },
        {
          "s": 6,
          "text": "(בפשטות,"
        },
        {
          "s": 7,
          "text": "דאין מקרא יוצא מידי פשוטו47)"
        },
        {
          "s": 8,
          "text": "הוא,"
        },
        {
          "s": 9,
          "text": "שהתורה עצמה היא ירושה48."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דענין הירושה דתורה"
        },
        {
          "s": 2,
          "text": "(להפירוש שהתורה עצמה היא ירושה)"
        },
        {
          "s": 3,
          "text": "הוא למעלה יותר גם מענין המתנה דתורה."
        },
        {
          "s": 4,
          "text": "דזה שמובא לעיל מהדרושים דירושה היא למטה ממתנה,"
        },
        {
          "s": 5,
          "text": "הוא49"
        },
        {
          "s": 6,
          "text": "לפי שירושה היא מצד מציאותו של היורש"
        },
        {
          "s": 7,
          "text": "(שהוא קרובו של המוריש)"
        },
        {
          "s": 8,
          "text": "ואינה תלוי' ברצון המוריש,"
        },
        {
          "s": 9,
          "text": "ומתנה היא מצד רצונו של הנותן."
        },
        {
          "s": 10,
          "text": "דענין זה הוא בירושה שהיא50"
        },
        {
          "s": 11,
          "text": "(רק)"
        },
        {
          "s": 12,
          "text": "מצד קורבה."
        },
        {
          "s": 13,
          "text": "אבל בירושה שענינה הוא50"
        },
        {
          "s": 14,
          "text": "שהיורש עומד במקום המוריש"
        },
        {
          "s": 15,
          "text": "(ובמילא יורש את נכסיו),"
        },
        {
          "s": 16,
          "text": "אין שייך לומר שהיא באה מצד מציאותו של היורש,"
        },
        {
          "s": 17,
          "text": "כיון שהיורש אינו מציאות אחר מהמוריש אלא עומד במקום המוריש."
        },
        {
          "s": 18,
          "text": "ואדרבה,"
        },
        {
          "s": 19,
          "text": "ירושה זו היא למעלה ממתנה."
        },
        {
          "s": 20,
          "text": "דמתנה היא מצד רצון הנותן,"
        },
        {
          "s": 21,
          "text": "ובירושה"
        },
        {
          "s": 22,
          "text": "(באופן זה)"
        },
        {
          "s": 23,
          "text": "היורש עומד במקום המוריש עצמו"
        },
        {
          "s": 24,
          "text": "(שלמעלה מהרצון שלו)."
        },
        {
          "s": 25,
          "text": "ועפ\"ז צריך לומר,"
        },
        {
          "s": 26,
          "text": "דהטעם על זה שבענין הירושה דתורה"
        },
        {
          "s": 27,
          "text": "(שהיא למעלה גם ממתנה דתורה)"
        },
        {
          "s": 28,
          "text": "נאמר מורשה קהלת יעקב הוא,"
        },
        {
          "s": 29,
          "text": "כי ישראל וישורון הם שם המעלה,"
        },
        {
          "s": 30,
          "text": "ולכן שייכים לענין הגילויים,"
        },
        {
          "s": 31,
          "text": "וענין הירושה שהיורש עומד במקום המוריש עצמו מתגלה בהשם יעקב,"
        },
        {
          "s": 32,
          "text": "כאשר הוא שם העצם51,"
        },
        {
          "s": 33,
          "text": "שבו כל ישראל הם בשוה."
        }
      ]
    }
  ]
}