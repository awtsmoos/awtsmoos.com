{
  "globalIndex": 719,
  "owner": 19,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917980_theRebbe_758__p003",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917980_theRebbe_758__p003",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917980_theRebbe_758",
  "title": "מאמר ונחה עליו רוח ה' תשכ\"ה",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דמה שמבאר בהמאמר"
        },
        {
          "s": 2,
          "text": "(ובארוכה)"
        },
        {
          "s": 3,
          "text": "במעלת שרש הנצח הוא"
        },
        {
          "s": 4,
          "text": "(גם)"
        },
        {
          "s": 5,
          "text": "כדי לבאר הטעם על זה שהגילוי דלע\"ל בא דוקא ע\"י הקדמת העבודה דזמן הגלות."
        },
        {
          "s": 6,
          "text": "דלהיות שהעבודה בזמן הגלות היא בדרך נצחון,"
        },
        {
          "s": 7,
          "text": "דשרש הנצח הוא מפנימיות הכתר,"
        },
        {
          "s": 8,
          "text": "בחינת ישת חושך סתרו39"
        },
        {
          "s": 9,
          "text": "שלמעלה מגילוי,"
        },
        {
          "s": 10,
          "text": "לכן ע\"י העבודה דזמן הגלות יתגלו לע\"ל גם הענינים שלמעלה מהשגה וראי'40"
        },
        {
          "s": 11,
          "text": "(למעלה גם מההשגה וראי' דלעתיד),"
        },
        {
          "s": 12,
          "text": "ורק שמשיח יגלה אותם באופן דמלוכה,"
        },
        {
          "s": 13,
          "text": "כנ\"ל."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר41,"
        },
        {
          "s": 2,
          "text": "דביאור דבר זה"
        },
        {
          "s": 3,
          "text": "(מה שהגילוי דלעתיד בא דוקא ע\"י העבודה שבזמן הגלות)"
        },
        {
          "s": 4,
          "text": "יובן מענין ירידת הנשמה למטה,"
        },
        {
          "s": 5,
          "text": "שהירידה היא לצורך עלי'."
        },
        {
          "s": 6,
          "text": "דמזה מובן גם בהירידה דגלות,"
        },
        {
          "s": 7,
          "text": "שהיא לצורך עלי'."
        },
        {
          "s": 8,
          "text": "שע\"י העבודה בזמן הגלות דוקא יהי' הגילוי דלעתיד שהוא נעלה יותר מהגילוי שהי' בזמן הבית."
        },
        {
          "s": 9,
          "text": "ויש לומר,"
        },
        {
          "s": 10,
          "text": "דהוספת ביאור זה"
        },
        {
          "s": 11,
          "text": "(שכוונת הירידה דהגלות היא מלכתחילה לצורך עלי')"
        },
        {
          "s": 12,
          "text": "הוא בכדי לבאר הטעם על זה שגם הגילוי דמשיח שיגלה בתור רב,"
        },
        {
          "s": 13,
          "text": "בהשגה וראי',"
        },
        {
          "s": 14,
          "text": "בא דוקא ע\"י העבודה דזמן הגלות"
        },
        {
          "s": 15,
          "text": "(אף שענין ההשגה ומכ\"ש הראי' הי' דוקא בזמן הבית,"
        },
        {
          "s": 16,
          "text": "כנ\"ל)."
        },
        {
          "s": 17,
          "text": "ויובן זה מענין הירידה שבכללות ההשתלשלות,"
        },
        {
          "s": 18,
          "text": "דתחילת הירידה הוא צמצום הראשון,"
        },
        {
          "s": 19,
          "text": "וידוע42"
        },
        {
          "s": 20,
          "text": "דפעולת הצמצום היא הן באוא\"ס הבל\"ג והן בהאור שבבחינת גבול"
        },
        {
          "s": 21,
          "text": "(האור שלהאיר העולמות)."
        },
        {
          "s": 22,
          "text": "דפעולת הצמצום באור הבל\"ג הוא מה שנתעלם ונכלל במקורו,"
        },
        {
          "s": 23,
          "text": "ואינו מאיר בגילוי במקום החלל,"
        },
        {
          "s": 24,
          "text": "היינו דפעולת הצמצום באור זה הוא לא בהאור גופא."
        },
        {
          "s": 25,
          "text": "וי\"ל הטעם,"
        },
        {
          "s": 26,
          "text": "דמכיון שאור זה הוא למעלה מערך העולמות,"
        },
        {
          "s": 27,
          "text": "אין ביכולת הצמצום לפעול בו ירידה והגבלה,"
        },
        {
          "s": 28,
          "text": "וכל פעולת הצמצום באור זה הוא שלא יאיר במקום החלל."
        },
        {
          "s": 29,
          "text": "משא\"כ פעולת הצמצום בהאור שלהאיר העולמות הוא בהאור גופא,"
        },
        {
          "s": 30,
          "text": "ובכמה ענינים,"
        },
        {
          "s": 31,
          "text": "א' שלפני הצמצום הי' אור זה מעורב וכלול באור הבל\"ג וע\"י הצמצום נבדל בפ\"ע43,"
        },
        {
          "s": 32,
          "text": "שעי\"ז ירד ממעלתו,"
        },
        {
          "s": 33,
          "text": "ב' דע\"י שנמשך דרך דילוג הצמצום שלא בהדרגה הוא בא בבחינת התחלקות עשר ספירות"
        },
        {
          "s": 34,
          "text": "[וכמבואר בארוכה44,"
        },
        {
          "s": 35,
          "text": "דענין הספירות שבאור הוא לא רק מצד הכלים כי אם,"
        },
        {
          "s": 36,
          "text": "שענין הספירות הוא גם מצד האור],"
        },
        {
          "s": 37,
          "text": "ג' דע\"י הצמצום מתלבש"
        },
        {
          "s": 38,
          "text": "(אח\"כ)"
        },
        {
          "s": 39,
          "text": "האור בהכלים שעי\"ז הוא בא בהגשמה,"
        },
        {
          "s": 40,
          "text": "שנעשה כמו הכלים."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה עד\"ז הוא גם בההעלם דירידת הנשמה למטה"
        },
        {
          "s": 2,
          "text": "(שכל ההעלמות שרשם הוא מההעלם"
        },
        {
          "s": 3,
          "text": "(דצמצום)"
        },
        {
          "s": 4,
          "text": "הראשון),"
        },
        {
          "s": 5,
          "text": "שיש בו שני ענינים,"
        },
        {
          "s": 6,
          "text": "דוגמת שני ענינים הנ\"ל שבצמצום הראשון45."
        },
        {
          "s": 7,
          "text": "א',"
        },
        {
          "s": 8,
          "text": "שבהיות הנשמה למעלה,"
        },
        {
          "s": 9,
          "text": "כל כחותי' האירו בגילוי,"
        },
        {
          "s": 10,
          "text": "ובירידתה למטה,"
        },
        {
          "s": 11,
          "text": "הם בהעלם."
        },
        {
          "s": 12,
          "text": "דהעלם הזה אינו מה שהגוף מעלים,"
        },
        {
          "s": 13,
          "text": "כי אם,"
        },
        {
          "s": 14,
          "text": "שענינים אלו דהנשמה נשארים למעלה ואינם מתלבשים בהגוף46,"
        },
        {
          "s": 15,
          "text": "בדוגמת מה שאור הבל\"ג אינו מאיר במקום החלל."
        },
        {
          "s": 16,
          "text": "וב',"
        },
        {
          "s": 17,
          "text": "שגם ענינים אלו שמתלבשים בהגוף,"
        },
        {
          "s": 18,
          "text": "הם בהגשמה,"
        },
        {
          "s": 19,
          "text": "בדוגמת ההעלם שבאור הקו שמצד הכלים47."
        },
        {
          "s": 20,
          "text": "ועד\"ז הוא גם בהעלם דגלות,"
        },
        {
          "s": 21,
          "text": "שיש בו דוגמת שני ענינים אלו48."
        },
        {
          "s": 22,
          "text": "א',"
        },
        {
          "s": 23,
          "text": "מה שבזמן הגלות לא ישנם הגילויים דביהמ\"ק,"
        },
        {
          "s": 24,
          "text": "והוא מה שמשחרב ביהמ\"ק אין אנו יכולים לעלות וליראות,"
        },
        {
          "s": 25,
          "text": "שלא ישנה ראי' באלקות."
        },
        {
          "s": 26,
          "text": "וב' שגם ההשגה שבזמן הגלות אינה השגה אמיתית,"
        },
        {
          "s": 27,
          "text": "שזהו"
        },
        {
          "s": 28,
          "text": "(לא רק מצד זה שלא ישנם הגילויים דביהמ\"ק,"
        },
        {
          "s": 29,
          "text": "אלא גם)"
        },
        {
          "s": 30,
          "text": "מצד ההעלם והסתר דגלות,"
        },
        {
          "s": 31,
          "text": "שמעלים ומסתיר על השגת אלקות."
        }
      ]
    }
  ]
}