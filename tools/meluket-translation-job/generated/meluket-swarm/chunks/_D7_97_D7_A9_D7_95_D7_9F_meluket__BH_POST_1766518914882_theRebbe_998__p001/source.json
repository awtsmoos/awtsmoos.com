{
  "globalIndex": 187,
  "owner": 37,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914882_theRebbe_998__p001",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914882_theRebbe_998__p001",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518914882_theRebbe_998",
  "title": "מאמר ויהיו חיי שרה תש\"ל",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ חיי שרה,"
        },
        {
          "s": 2,
          "text": "מבה\"ח כסלו,"
        },
        {
          "s": 3,
          "text": "ה'תש\"ל"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "ויהיו חיי שרה מאה שנה ועשרים שנה ושבע שנים שני חיי שרה1,"
        },
        {
          "s": 1,
          "text": "ומדייק אדמו\"ר"
        },
        {
          "s": 2,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 3,
          "text": "נ\"ע בעל יום ההולדת דכ\"ף מרחשון במאמרו ד\"ה זה2,"
        },
        {
          "s": 4,
          "text": "הרי כבר נאמר ויהיו חיי שרה,"
        },
        {
          "s": 5,
          "text": "ולמה נכפל עוד פעם שני חיי שרה."
        },
        {
          "s": 6,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 7,
          "text": "שבזהר3"
        },
        {
          "s": 8,
          "text": "עה\"פ ויהיו חיי שרה מבאר תחלה את הפסוק4"
        },
        {
          "s": 9,
          "text": "ויתרון ארץ בכל היא מלך לשדה נעבד,"
        },
        {
          "s": 10,
          "text": "ולאח\"ז5"
        },
        {
          "s": 11,
          "text": "אומר דענין ויהיו חיי שרה הוא ששרה זכתה לחיין עילאין."
        },
        {
          "s": 12,
          "text": "ומבאר בהמאמר השייכות דויתרון ארץ בכל היא מלך לשדה נעבד לויהיו חיי שרה,"
        },
        {
          "s": 13,
          "text": "דארץ ושדה הם בחינת מלכות,"
        },
        {
          "s": 14,
          "text": "וענין יתרון ארץ בכל היא מלך לשדה נעבד הוא המשכת האורות שלמעלה ממלכות,"
        },
        {
          "s": 15,
          "text": "בחינת כל ובחינת מלך,"
        },
        {
          "s": 16,
          "text": "במלכות."
        },
        {
          "s": 17,
          "text": "וזוהי השייכות דויתרון ארץ בכל היא מלך לשדה נעבד לויהיו חיי שרה,"
        },
        {
          "s": 18,
          "text": "כי שרה היא בחינת מלכות"
        },
        {
          "s": 19,
          "text": "(דוגמת ארץ ושדה),"
        },
        {
          "s": 20,
          "text": "וזה ששרה זכתה לחיין עילאין הוא שנמשכו בה האורות שלמעלה ממלכות."
        },
        {
          "s": 21,
          "text": "ומבאר בארוכה ד' הענינים שבפסוק ויתרון ארץ גו',"
        },
        {
          "s": 22,
          "text": "שתי הבחינות שבמלכות,"
        },
        {
          "s": 23,
          "text": "ארץ ושדה,"
        },
        {
          "s": 24,
          "text": "ושתי הבחינות בהאורות שלמעלה מהמלכות הנמשכים במלכות,"
        },
        {
          "s": 25,
          "text": "בחינת כל ובחינת מלך."
        },
        {
          "s": 26,
          "text": "ומבאר,"
        },
        {
          "s": 27,
          "text": "דעשרים שנה ושבע שנים הוא ע\"ד בחינת כל,"
        },
        {
          "s": 28,
          "text": "ומאה שנה הוא ע\"ד בחינת מלך6."
        },
        {
          "s": 29,
          "text": "ולאחרי זה מבאר"
        },
        {
          "s": 30,
          "text": "(בסיום המאמר),"
        },
        {
          "s": 31,
          "text": "דויהיו חיי שרה הוא המשכת החיין עילאין"
        },
        {
          "s": 32,
          "text": "(מאה שנה ועשרים שנה ושבע שנים)"
        },
        {
          "s": 33,
          "text": "במלכות,"
        },
        {
          "s": 34,
          "text": "ושני חיי שרה הוא,"
        },
        {
          "s": 35,
          "text": "שהחיין עילאין נמשכו בבי\"ע."
        },
        {
          "s": 36,
          "text": "וצריך להבין,"
        },
        {
          "s": 37,
          "text": "דבכדי לבאר ההוספה דשני חיי שרה על ויהיו חיי שרה נוגע לכאורה רק שויהיו חיי שרה הוא המשכת חיין עילאין במלכות,"
        },
        {
          "s": 38,
          "text": "דעפ\"ז יש לבאר שההוספה דשני חיי שרה היא ההמשכה בבי\"ע,"
        },
        {
          "s": 39,
          "text": "ומזה שביאור זה בא"
        },
        {
          "s": 40,
          "text": "(בהמאמר)"
        },
        {
          "s": 41,
          "text": "לאחרי ביאור הפסוק ויתרון ארץ גו' ושייכותו לויהיו חיי שרה,"
        },
        {
          "s": 42,
          "text": "משמע,"
        },
        {
          "s": 43,
          "text": "שעי\"ז מיתוסף ביאור בהענין דשני חיי שרה"
        },
        {
          "s": 44,
          "text": "(ההמשכה בבי\"ע)."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויובן זה ע\"פ המבואר בהמאמר7"
        },
        {
          "s": 2,
          "text": "החילוק בין ארץ ושדה,"
        },
        {
          "s": 3,
          "text": "דארץ הוא כללות העולם,"
        },
        {
          "s": 4,
          "text": "ושדה"
        },
        {
          "s": 5,
          "text": "(המובחר שבארץ)"
        },
        {
          "s": 6,
          "text": "הוא הגן עדן."
        },
        {
          "s": 7,
          "text": "וחילוק זה שבין כללות העולם לג\"ע"
        },
        {
          "s": 8,
          "text": "(שכללות העולם נקרא ארץ וג\"ע שדה)"
        },
        {
          "s": 9,
          "text": "הוא בשרשם."
        },
        {
          "s": 10,
          "text": "דהתהוות העולם הוא מבחינת חיצוניות המלכות שנק' ארץ,"
        },
        {
          "s": 11,
          "text": "והג\"ע הוא מבחינת פנימיות המלכות שנק' שדה."
        },
        {
          "s": 12,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 13,
          "text": "דכמו שמעלת השדה כפשוטה היא שהוא מקום הראוי לזריעה,"
        },
        {
          "s": 14,
          "text": "עד\"ז הוא בנוגע לג\"ע,"
        },
        {
          "s": 15,
          "text": "שהוא מקום מוכשר להמשכת הגילוי דאוא\"ס"
        },
        {
          "s": 16,
          "text": "(צמיחה)"
        },
        {
          "s": 17,
          "text": "שע\"י זריעת המצוות."
        },
        {
          "s": 18,
          "text": "[וכמבואר במק\"א8"
        },
        {
          "s": 19,
          "text": "עה\"פ9"
        },
        {
          "s": 20,
          "text": "ויקח ה' אלקים את האדם ויניחהו בגן עדן לעבדה ולשמרה וארז\"ל10"
        },
        {
          "s": 21,
          "text": "לעבדה זה רמ\"ח מ\"ע ולשמרה זה שס\"ה מל\"ת,"
        },
        {
          "s": 22,
          "text": "דהטעם על זה שהניחהו בג\"ע"
        },
        {
          "s": 23,
          "text": "(דוקא)"
        },
        {
          "s": 24,
          "text": "לעבדה ולשמרה,"
        },
        {
          "s": 25,
          "text": "הוא,"
        },
        {
          "s": 26,
          "text": "כי ג\"ע הוא מקום מוכשר להגילוי שנמשך ע\"י קיום המצוות."
        },
        {
          "s": 27,
          "text": "וזה שנמשך הגילוי ע\"י קיום המצוות בכללות העולם"
        },
        {
          "s": 28,
          "text": "(לאחרי שגורש האדם מג\"ע)"
        },
        {
          "s": 29,
          "text": "הוא כמ\"ש11"
        },
        {
          "s": 30,
          "text": "וישלחהו ה' אלקים מגן עדן לעבוד את האדמה גו',"
        },
        {
          "s": 31,
          "text": "דענין לעבוד את האדמה הוא לעשות המקום דעולם שיהי' מוכשר להגילוי12]."
        },
        {
          "s": 32,
          "text": "וזהו ויתרון ארץ בכל היא מלך לשדה נעבד,"
        },
        {
          "s": 33,
          "text": "שהיתרון דארץ"
        },
        {
          "s": 34,
          "text": "[כללות העולם,"
        },
        {
          "s": 35,
          "text": "שהתהוותו היא מחיצוניות המלכות]"
        },
        {
          "s": 36,
          "text": "היא בכל,"
        },
        {
          "s": 37,
          "text": "שנמשך בה בחינת כל,"
        },
        {
          "s": 38,
          "text": "היא ספירת היסוד שנקראת כל13."
        },
        {
          "s": 39,
          "text": "ומלך לשדה נעבד הוא המשכת הגילוי דאוא\"ס"
        },
        {
          "s": 40,
          "text": "(שלמעלה מבחינת כל)"
        },
        {
          "s": 41,
          "text": "שע\"י קיום המצוות."
        },
        {
          "s": 42,
          "text": "כדאיתא בזהר שם,"
        },
        {
          "s": 43,
          "text": "מאן מלך דא מלך עילאה דאתחבר לשדה כד איהו נעבד,"
        },
        {
          "s": 44,
          "text": "שע\"י העבודה בג\"ע"
        },
        {
          "s": 45,
          "text": "(שדה נעבד)"
        },
        {
          "s": 46,
          "text": "שהיא העבודה דקיום המצוות"
        },
        {
          "s": 47,
          "text": "(לעבדה רמ\"ח מ\"ע ולשמרה שס\"ה מל\"ת),"
        },
        {
          "s": 48,
          "text": "נמשך גילוי אוא\"ס"
        },
        {
          "s": 49,
          "text": "(מלך עילאה),"
        },
        {
          "s": 50,
          "text": "שלמעלה מהגילוי דבחינת כל."
        }
      ]
    }
  ]
}