{
  "globalIndex": 436,
  "owner": 36,
  "jobId": "_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916230_theRebbe_919__p003",
  "batchId": "meluket-_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916230_theRebbe_919__p003",
  "seriesId": "טבת_meluket",
  "postId": "BH_POST_1766518916230_theRebbe_919",
  "title": "מאמר הבאים ישרש יעקב תשמ\"ח",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דזה שבדרוש הנ\"ל דהצ\"צ אינו מעתיק פירוש זה בהבאים ישרש יעקב שזה קאי על קיום המצוות שבזמן הגלות,"
        },
        {
          "s": 2,
          "text": "הוא,"
        },
        {
          "s": 3,
          "text": "כי זה שהגילויים דלע\"ל תלויים במעשינו ועבודתינו הוא במעשינו ועבודתינו שבכל הזמנים,"
        },
        {
          "s": 4,
          "text": "הן בזמן הבית והן בזמן הגלות,"
        },
        {
          "s": 5,
          "text": "שבכל אחד מהם יש מעלה"
        },
        {
          "s": 6,
          "text": "(כדלקמן),"
        },
        {
          "s": 7,
          "text": "וישרש יעקב"
        },
        {
          "s": 8,
          "text": "(להביאור שבדרוש זה)"
        },
        {
          "s": 9,
          "text": "קאי על קיום המצוות שבכל הזמנים."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והענין הוא,"
        },
        {
          "s": 2,
          "text": "דבהמעלה שבקיום המצוות על לימוד התורה,"
        },
        {
          "s": 3,
          "text": "שני ענינים."
        },
        {
          "s": 4,
          "text": "שההמשכה שע\"י קיום המצוות היא נעלית יותר מההמשכה שע\"י לימוד התורה"
        },
        {
          "s": 5,
          "text": "(כנ\"ל סעיף א),"
        },
        {
          "s": 6,
          "text": "וזה שבקיום המצוות ישנה המעלה דאתהפכא חשוכא לנהורא,"
        },
        {
          "s": 7,
          "text": "כי בירור הגוף ונה\"ב וחלקו בעולם הוא"
        },
        {
          "s": 8,
          "text": "(בעיקר)"
        },
        {
          "s": 9,
          "text": "ע\"י מעשה המצוות24."
        },
        {
          "s": 10,
          "text": "ומהחילוקים שבין שני הענינים,"
        },
        {
          "s": 11,
          "text": "דההמשכה שע\"י קיום המצוות היא בזמן הבית יותר מבזמן הגלות."
        },
        {
          "s": 12,
          "text": "כי ההמשכה שע\"י מעשה המצוות היא"
        },
        {
          "s": 13,
          "text": "(בעיקר)"
        },
        {
          "s": 14,
          "text": "כשהעשי' היא בביטול25,"
        },
        {
          "s": 15,
          "text": "וכיון שענין הביטול הוא בעיקר בזמן הבית"
        },
        {
          "s": 16,
          "text": "[דנוסף לזה שבזמן הגלות א\"א להיות הביטול דהשתחוואה"
        },
        {
          "s": 17,
          "text": "(ביטול פנימי)"
        },
        {
          "s": 18,
          "text": "שבא דוקא מצד הראי' באלקות,"
        },
        {
          "s": 19,
          "text": "וכמו שאומרים26"
        },
        {
          "s": 20,
          "text": "ואין אנו יכולים לעלות וליראות ולהשתחוות לפניך,"
        },
        {
          "s": 21,
          "text": "דמכיון שאין אנו יכולים לעלות וליראות במילא אין אנו יכולים להשתחוות,"
        },
        {
          "s": 22,
          "text": "להיות בבחי' ביטול פנימי27,"
        },
        {
          "s": 23,
          "text": "הנה גם הביטול החיצוני"
        },
        {
          "s": 24,
          "text": "(ביטול דכריעה28),"
        },
        {
          "s": 25,
          "text": "שבא מצד השגת אלקות"
        },
        {
          "s": 26,
          "text": "(שישנה,"
        },
        {
          "s": 27,
          "text": "בכללות,"
        },
        {
          "s": 28,
          "text": "גם בזמן הגלות),"
        },
        {
          "s": 29,
          "text": "אינו כדבעי,"
        },
        {
          "s": 30,
          "text": "כיון שגם ההשגה באלקות שבזמן הגלות אינה השגה אמיתית29],"
        },
        {
          "s": 31,
          "text": "לכן,"
        },
        {
          "s": 32,
          "text": "ההמשכה שע\"י קיום המצוות בזמן הבית היתה המשכה נעלית יותר."
        },
        {
          "s": 33,
          "text": "ועיקר ההמשכה שע\"י המצוות יהי' לע\"ל,"
        },
        {
          "s": 34,
          "text": "כי אז יהי' קיום המצוות בתכלית השלימות,"
        },
        {
          "s": 35,
          "text": "כמצות רצונך30."
        },
        {
          "s": 36,
          "text": "והענין דאתהפכא חשוכא לנהורא שע\"י קיום המצוות הוא בעיקר בזמן הגלות."
        },
        {
          "s": 37,
          "text": "כי החושך דהגוף ודנה\"ב ודהעולם כמו שהם בגלות הוא חושך גדול יותר מהחושך שלהם כמו שהם מצד עצמם,"
        },
        {
          "s": 38,
          "text": "וע\"י קיום המצוות בזמן הגלות,"
        },
        {
          "s": 39,
          "text": "שעי\"ז נעשה הבירור דהגוף וכו' כמו שהם בגלות,"
        },
        {
          "s": 40,
          "text": "גם חושך זה נהפך לאור."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה לע\"ל יהי' הגילוי דשני הענינים הנ\"ל שבקיום המצוות,"
        },
        {
          "s": 2,
          "text": "גילוי ההמשכה שע\"י קיום המצוות עצמה,"
        },
        {
          "s": 3,
          "text": "וגילוי ההמשכה שע\"י הבירור והאתהפכא שנעשה ע\"י המצוה."
        },
        {
          "s": 4,
          "text": "ויש לומר דזה שכתוב בתניא שהגילויים דלעתיד תלויים במעשינו ועבודתינו שבזמן הגלות,"
        },
        {
          "s": 5,
          "text": "הוא,"
        },
        {
          "s": 6,
          "text": "כי בתניא שם מדובר בהעילוי דאתהפכא חשוכא לנהורא,"
        },
        {
          "s": 7,
          "text": "יתרון31"
        },
        {
          "s": 8,
          "text": "האור הבא מן החושך32."
        },
        {
          "s": 9,
          "text": "והגילוי דאור זה שיהי' לעתיד"
        },
        {
          "s": 10,
          "text": "(יתרון האור הבא מן החושך)"
        },
        {
          "s": 11,
          "text": "תלוי"
        },
        {
          "s": 12,
          "text": "(בעיקר)"
        },
        {
          "s": 13,
          "text": "במעשינו ועבודתינו שבזמן הגלות,"
        },
        {
          "s": 14,
          "text": "וזה שלע\"ל יהי' הגילוי דאוא\"ס שבהמצוות עצמם תלוי"
        },
        {
          "s": 15,
          "text": "(בעיקר)"
        },
        {
          "s": 16,
          "text": "במעשינו ועבודתינו שבזמן הבית."
        }
      ]
    }
  ]
}