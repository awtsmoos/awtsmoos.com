  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918708_theRebbe_155__p008",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918708_theRebbe_155",
  "title": "מאמר בשעה שעלה משה למרום תשכ\"ה",
  "part": 8,
  "sections": [
    {
      "v": 21,
      "items": [
        {
          "s": 0,
          "text": "וזהו מ\"ש וספרתם לכם גו' מיום הביאכם את עומר התנופה גו',"
        },
        {
          "s": 1,
          "text": "דענין עומר התנופה גו' הוא כמ\"ש61"
        },
        {
          "s": 2,
          "text": "והניף את העומר גו' לרצונכם,"
        },
        {
          "s": 3,
          "text": "לרצונכם הוא רעותא דלבא,"
        },
        {
          "s": 4,
          "text": "וע\"י רצון זה"
        },
        {
          "s": 5,
          "text": "(דהאדם)"
        },
        {
          "s": 6,
          "text": "עושים וממשיכים רצונו של מקום."
        },
        {
          "s": 7,
          "text": "וזהו אימתי הן תמימות בזמן שישראל עושין רצונו של מקום,"
        },
        {
          "s": 8,
          "text": "דהמשכה זו הו\"ע התמימות,"
        },
        {
          "s": 9,
          "text": "אמיתית השלימות."
        }
      ]
    }
  ]
}