{
  "globalIndex": 577,
  "owner": 27,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917050_theRebbe_195__p004",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917050_theRebbe_195__p004",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518917050_theRebbe_195",
  "title": "מאמר הנני ממטיר לכם תשל\"ז",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ולהבין לשון ממטיר דוקא,"
        },
        {
          "s": 2,
          "text": "הנני ממטיר לכם גו',"
        },
        {
          "s": 3,
          "text": "הנה יובן זה מהמבואר בלקו\"ת בדרושי פ' עקב49,"
        },
        {
          "s": 4,
          "text": "דאף שבכללות הנה המן הוא בחי' טל"
        },
        {
          "s": 5,
          "text": "(כנ\"ל),"
        },
        {
          "s": 6,
          "text": "אעפ\"כ נתגשם עד שדכו במדוכה ובשלו בפרור50,"
        },
        {
          "s": 7,
          "text": "ועד שאפי' בצדיקים שאצלם הי' אכילת המן בלי טרחא,"
        },
        {
          "s": 8,
          "text": "מ\"מ הי' צ\"ל ולקטו מעל פתח האוהל51,"
        },
        {
          "s": 9,
          "text": "ואח\"כ הי' צ\"ל האכילה כפשוטה,"
        },
        {
          "s": 10,
          "text": "ועד שמבואר בראשונים52"
        },
        {
          "s": 11,
          "text": "שהי' גם ענין הברכה המוציא לחם מן השמים או בנוסח אחר וכו'52."
        },
        {
          "s": 12,
          "text": "אבל מ\"מ,"
        },
        {
          "s": 13,
          "text": "ע\"י שראו ואכלו המן ששרשו הוא מטלא דבדולחא,"
        },
        {
          "s": 14,
          "text": "ונמשך למטה עד שנתגשם"
        },
        {
          "s": 15,
          "text": "[כמבואר בדרושי כ\"ק אדה\"ז משנת תקס\"ח ועוד53],"
        },
        {
          "s": 16,
          "text": "עי\"ז יוודע להם שלא על הלחם לבדו יחי' האדם54,"
        },
        {
          "s": 17,
          "text": "היינו"
        },
        {
          "s": 18,
          "text": "(לא שאי\"צ להיות ענין אכילת הלחם,"
        },
        {
          "s": 19,
          "text": "אלא שצריך להיות אכילה"
        },
        {
          "s": 20,
          "text": "(שלכן נתגשם המן),"
        },
        {
          "s": 21,
          "text": "אמנם)"
        },
        {
          "s": 22,
          "text": "השלילה היא שאין זה על הלחם לבדו,"
        },
        {
          "s": 23,
          "text": "היינו בחי' ממכ\"ע שבזה"
        },
        {
          "s": 24,
          "text": "(כמשנת\"ל),"
        },
        {
          "s": 25,
          "text": "אלא על כל מוצא פי הוי' יחי' האדם,"
        },
        {
          "s": 26,
          "text": "ע\"י שהמוצא פי הוי' מתלבש בהלחם,"
        },
        {
          "s": 27,
          "text": "כמו שהמן נתגשם כו'."
        },
        {
          "s": 28,
          "text": "וכמש\"נ בתורה שהיא נעלמה מעיני כל חי55,"
        },
        {
          "s": 29,
          "text": "ואהי' שעשועים לפניו גו'56,"
        },
        {
          "s": 30,
          "text": "ומשם נסעה וירדה בסתר המדרי' ממדרגה למדרגה כו' עד שנתלבשה כו' בדיו על הספר57,"
        },
        {
          "s": 31,
          "text": "באותיות התורה58."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "וזהו כללות הענין דהנני ממטיר לכם לחם מן השמים,"
        },
        {
          "s": 2,
          "text": "דאע\"פ שישראל היו לפנ\"ז ברום המעלות,"
        },
        {
          "s": 3,
          "text": "הנה אעפ\"כ,"
        },
        {
          "s": 4,
          "text": "כשהנני ממטיר לכם לחם מן השמים הרי אין דרגתם שלפנ\"ז מגיעה להמעלה שצריכה להיות אצלם ע\"י ענין זה."
        },
        {
          "s": 5,
          "text": "הן בנוגע ללימוד התורה,"
        },
        {
          "s": 6,
          "text": "שצ\"ל באופן של הליכה,"
        },
        {
          "s": 7,
          "text": "הילך בתורתי"
        },
        {
          "s": 8,
          "text": "(שלי דוקא ע\"ד החילוק דמצוות הוי' ומצוותי59),"
        },
        {
          "s": 9,
          "text": "ובפרט ע\"פ המבואר בתו\"א60"
        },
        {
          "s": 10,
          "text": "דבההליכה שבפסוק זה"
        },
        {
          "s": 11,
          "text": "(הילך בתורתי)"
        },
        {
          "s": 12,
          "text": "ישנם ב' הענינים דמלמעלמ\"ט ומלמטלמ\"ע,"
        },
        {
          "s": 13,
          "text": "והן בנוגע להעבודה דכל מעשיך יהיו לשם שמים ובכל דרכיך דעהו61,"
        },
        {
          "s": 14,
          "text": "שכללות צרכי האדם נק' בשם אכילה62,"
        },
        {
          "s": 15,
          "text": "הנה ע\"י המן נפעל דאע\"פ שיודע שלחם זה יש קס\"ד לומר שעליו לבדו יחי' האדם,"
        },
        {
          "s": 16,
          "text": "כי הכוונה היא ללחם זה כמו שהוא בתכלית השלימות"
        },
        {
          "s": 17,
          "text": "(כמשנת\"ל),"
        },
        {
          "s": 18,
          "text": "אעפ\"כ הרי זהו רק לחם מן הארץ,"
        },
        {
          "s": 19,
          "text": "ולא על הלחם לבדו יחי' האדם כי על כל מוצא פי הוי' יחי' האדם."
        },
        {
          "s": 20,
          "text": "ובזה גופא למען הודיעך דייקא,"
        },
        {
          "s": 21,
          "text": "היינו שאין זה רק באופן של אמונה,"
        },
        {
          "s": 22,
          "text": "כ\"א ידיעה ובתכלית השלימות דידיעה,"
        },
        {
          "s": 23,
          "text": "שיודע בעת אכלו את הלחם שאז מקבל חיות ממוצא פי הוי' שע\"י יחי' האדם."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "והנה התורה היא נצחית18,"
        },
        {
          "s": 2,
          "text": "ולכאורה צלה\"ב במה הנצחיות של כל הפרטים ושל כללות הענין דהנני ממטיר לכם לחם מן השמים."
        },
        {
          "s": 3,
          "text": "עוד צלה\"ב,"
        },
        {
          "s": 4,
          "text": "דהנה איתא בברכות63"
        },
        {
          "s": 5,
          "text": "משה תקן לישראל ברכת הזן בשעה שירד להם מן"
        },
        {
          "s": 6,
          "text": "(שלכן אומרים הזן לשון נסתר64)"
        },
        {
          "s": 7,
          "text": "יהושע תקן להם ברכת הארץ"
        },
        {
          "s": 8,
          "text": "(על הארץ ועל המזון,"
        },
        {
          "s": 9,
          "text": "ארץ דמפקא מזון65),"
        },
        {
          "s": 10,
          "text": "ומחוייבים גם עתה,"
        },
        {
          "s": 11,
          "text": "שהברכה הראשונה דברכת המזון היא ברכת הזן שהיא על המן."
        },
        {
          "s": 12,
          "text": "והענין הוא כמשנת\"ל66"
        },
        {
          "s": 13,
          "text": "בארוכה,"
        },
        {
          "s": 14,
          "text": "דאפילו כשהעבודה היא"
        },
        {
          "s": 15,
          "text": "(מאיזה טעם שיהי')"
        },
        {
          "s": 16,
          "text": "רק ביחו\"ת,"
        },
        {
          "s": 17,
          "text": "מ\"מ צריכים עכ\"פ מזמן לזמן גם להארה מיחו\"ע67"
        },
        {
          "s": 18,
          "text": "ועד שזה יפעול בגלוי."
        },
        {
          "s": 19,
          "text": "ועד\"ז כשהעבודה היא רק באופן דאתכפיא,"
        },
        {
          "s": 20,
          "text": "מ\"מ צ\"ל ההתבוננות עכ\"פ בהשגה גם בהענין דאתהפכא."
        },
        {
          "s": 21,
          "text": "ועד\"ז הוא בלימוד התורה,"
        },
        {
          "s": 22,
          "text": "דאף שעיקר הלימוד הוא לכאורה בנגלה דתורה,"
        },
        {
          "s": 23,
          "text": "ששם הוא ענין היגיעה,"
        },
        {
          "s": 24,
          "text": "אעפ\"כ מוכרח להיות גם הענין דפנימיות התורה68,"
        },
        {
          "s": 25,
          "text": "וכמבואר בארוכה בקונטרס עץ החיים69"
        },
        {
          "s": 26,
          "text": "ובכמה דרושים."
        },
        {
          "s": 27,
          "text": "ואדרבה,"
        },
        {
          "s": 28,
          "text": "הענין דפנימיות התורה הו\"ע דמלח שע\"י הוא קיום כל הלימוד."
        },
        {
          "s": 29,
          "text": "וכדאיתא בשבת70"
        },
        {
          "s": 30,
          "text": "משל לאדם שאמר לשלוחו העלה לי כור חטים לעלי'"
        },
        {
          "s": 31,
          "text": "[היינו ענין החטים כפי שהוא באופן נעלה]"
        },
        {
          "s": 32,
          "text": "כו' עירבת בהם קב חומטין א\"ל לאו כו',"
        },
        {
          "s": 33,
          "text": "היינו שבלי ענין המלח71,"
        },
        {
          "s": 34,
          "text": "אין קיום אפי' לכור של חטים ושבעלי'."
        },
        {
          "s": 35,
          "text": "ועד\"ז הוא בכללות העבודה דעולמות בי\"ע,"
        },
        {
          "s": 36,
          "text": "הרי אמרז\"ל שצ\"ל כשם שאין בלבך אלא אחד כך אין בלבנו אלא אחד72,"
        },
        {
          "s": 37,
          "text": "היינו שצריכים לזכור מה שאין בלבך"
        },
        {
          "s": 38,
          "text": "(של יעקב,"
        },
        {
          "s": 39,
          "text": "אצילות)"
        },
        {
          "s": 40,
          "text": "אלא אחד,"
        },
        {
          "s": 41,
          "text": "וזה פועל שאין בלבנו"
        },
        {
          "s": 42,
          "text": "(השבטים,"
        },
        {
          "s": 43,
          "text": "בי\"ע)"
        },
        {
          "s": 44,
          "text": "אלא אחד כשם שאין בלבך כו'."
        },
        {
          "s": 45,
          "text": "והיינו דנוסף לזה שישנו הענין דועד,"
        },
        {
          "s": 46,
          "text": "יש לו גם הענין דאחד."
        },
        {
          "s": 47,
          "text": "דאף שהענין דועד הוא המשכת מלכותו של הקב\"ה בכל העולמות כולם,"
        },
        {
          "s": 48,
          "text": "מ\"מ אין זה מגיע להענין דאחד,"
        },
        {
          "s": 49,
          "text": "כי אף שועד בחילופי אתוון אחד73,"
        },
        {
          "s": 50,
          "text": "הרי אין זה מגיע להאתוון כפי שהם קודם החילוף,"
        },
        {
          "s": 51,
          "text": "וכמובן מהמבואר בשער היחוד והאמונה74"
        },
        {
          "s": 52,
          "text": "ענין החילופים כו'."
        }
      ]
    }
  ]
}