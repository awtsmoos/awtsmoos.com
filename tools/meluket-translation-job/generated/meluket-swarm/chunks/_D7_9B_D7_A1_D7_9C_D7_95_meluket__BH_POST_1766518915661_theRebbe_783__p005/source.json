{
  "globalIndex": 335,
  "owner": 35,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915661_theRebbe_783__p005",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915661_theRebbe_783__p005",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915661_theRebbe_783",
  "title": "מאמר פדה בשלום תשכ\"ו",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "שהחילוק בין קומה ה' שאמר משה לקומה ה' שאמר דוד הוא בשני ענינים."
        },
        {
          "s": 3,
          "text": "באופן הבירור"
        },
        {
          "s": 4,
          "text": "[שהבירור ע\"י הארון דמשכן הי' בדרך מלחמה,"
        },
        {
          "s": 5,
          "text": "שלכן נאמר ויפוצו אויביך וינוסו משנאיך,"
        },
        {
          "s": 6,
          "text": "שישנם מנגדים"
        },
        {
          "s": 7,
          "text": "(אויביך ומשנאיך)"
        },
        {
          "s": 8,
          "text": "שצריך ללחום בהם,"
        },
        {
          "s": 9,
          "text": "והבירור שבימי שלמה ובפרט ע\"י הגילוי דביהמ\"ק הי' בדרך מנוחה,"
        },
        {
          "s": 10,
          "text": "קומה ה' למנוחתך,"
        },
        {
          "s": 11,
          "text": "כנ\"ל בארוכה],"
        },
        {
          "s": 12,
          "text": "וגם בהבירור עצמו."
        },
        {
          "s": 13,
          "text": "דזה שבקומה ה' שאמר משה נאמר ויפוצו אויביך וינוסו משנאיך,"
        },
        {
          "s": 14,
          "text": "הוא,"
        },
        {
          "s": 15,
          "text": "לפי שגם לאחרי הבירור ע\"י נסיעת הארון במדבר,"
        },
        {
          "s": 16,
          "text": "נשאר עדיין מנגדים,"
        },
        {
          "s": 17,
          "text": "אויביך ומשנאיך,"
        },
        {
          "s": 18,
          "text": "אלא שהיו באופן דיפוצו וינוסו."
        },
        {
          "s": 19,
          "text": "והענין הוא,"
        },
        {
          "s": 20,
          "text": "דבבירור שבדרך מלמעלה למטה,"
        },
        {
          "s": 21,
          "text": "שהעליון"
        },
        {
          "s": 22,
          "text": "(המברר)"
        },
        {
          "s": 23,
          "text": "אינו מתלבש בהתחתון והבירור בהתחתון הוא ע\"י גילוי אור דהעליון,"
        },
        {
          "s": 24,
          "text": "זה שהתחתון אינו מנגד הוא לא מצד המציאות"
        },
        {
          "s": 25,
          "text": "(רצון,"
        },
        {
          "s": 26,
          "text": "שכל וכו')"
        },
        {
          "s": 27,
          "text": "שלו,"
        },
        {
          "s": 28,
          "text": "אלא אדרבה,"
        },
        {
          "s": 29,
          "text": "מפני שע\"י שמאיר בו גילוי אור שאינו בערך אליו הוא מתבטל ממציאותו55."
        },
        {
          "s": 30,
          "text": "והנה כשהבירור הוא באופן שהעליון"
        },
        {
          "s": 31,
          "text": "(המברר)"
        },
        {
          "s": 32,
          "text": "בא למקומו של התחתון"
        },
        {
          "s": 33,
          "text": "(המתברר),"
        },
        {
          "s": 34,
          "text": "הרי זה מוכיח שהתחתון תופס מקום לגבי',"
        },
        {
          "s": 35,
          "text": "ולכן אין שייך שע\"י הגילוי שלו יתבטל התחתון בתכלית."
        },
        {
          "s": 36,
          "text": "וכיון שגם בירור זה הוא בדרך מלמעלה למטה ולא בדרך התלבשות"
        },
        {
          "s": 37,
          "text": "(כנ\"ל סעיף ח),"
        },
        {
          "s": 38,
          "text": "והביטול שע\"י גילוי אור זה אינו ביטול בתכלית,"
        },
        {
          "s": 39,
          "text": "לכן,"
        },
        {
          "s": 40,
          "text": "גם לאחרי הבירור נשאר עדיין"
        },
        {
          "s": 41,
          "text": "(בהעלם)"
        },
        {
          "s": 42,
          "text": "מציאות דמנגד"
        },
        {
          "s": 43,
          "text": "(אויביך ומשנאיך),"
        },
        {
          "s": 44,
          "text": "אלא שמ\"מ,"
        },
        {
          "s": 45,
          "text": "כיון שהתחתון אינו בערך גם לגבי גילוי זה שיש לו תפיסת מקום לגבי',"
        },
        {
          "s": 46,
          "text": "לכן,"
        },
        {
          "s": 47,
          "text": "גם ע\"י גילוי זה מתבטל התוקף דהתחתון,"
        },
        {
          "s": 48,
          "text": "וההתנגדות שלו"
        },
        {
          "s": 49,
          "text": "(אויביך ומשנאיך)"
        },
        {
          "s": 50,
          "text": "היא באופן דיפוצו וינוסו."
        },
        {
          "s": 51,
          "text": "משא\"כ בהבירור שבדרך מנוחה,"
        },
        {
          "s": 52,
          "text": "דזה שהעליון"
        },
        {
          "s": 53,
          "text": "(המברר)"
        },
        {
          "s": 54,
          "text": "הוא במקומו ואינו יורד למקומו של התחתון הוא לפי שהתחתון אינו תופס מקום לגבי' – ע\"י גילוי אור זה,"
        },
        {
          "s": 55,
          "text": "הביטול דהתחתון הוא ביטול בתכלית."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר בעומק יותר,"
        },
        {
          "s": 1,
          "text": "דגם כשהבירור הוא באופן שהמברר הוא במקומו אלא שהוא בדרגא כזו שהמתברר יש לו תפיסת מקום לגבי',"
        },
        {
          "s": 2,
          "text": "הביטול דהמנגד אינו ביטול בתכלית."
        },
        {
          "s": 3,
          "text": "ועפ\"ז יש להוסיף ביאור בזה שמשמע בהמאמר דזה ששלמה הי' איש מנוחה הוא מפני שבימיו הוה קיימא סיהרא באשלמותא,"
        },
        {
          "s": 4,
          "text": "עשירות שלמעלה ממילוי החסרון,"
        },
        {
          "s": 5,
          "text": "כי אמיתית הענין דמנוחה"
        },
        {
          "s": 6,
          "text": "[ושלום]56"
        },
        {
          "s": 7,
          "text": "הוא כשהמנגד מתבטל בתכלית,"
        },
        {
          "s": 8,
          "text": "ובכדי שהמנגד יתבטל בתכלית הוא ע\"י המשכת ענין העשירות,"
        },
        {
          "s": 9,
          "text": "אוא\"ס שלמעלה משייכות לעולמות,"
        },
        {
          "s": 10,
          "text": "עתיק."
        },
        {
          "s": 11,
          "text": "דבאור השייך לעולמות,"
        },
        {
          "s": 12,
          "text": "כולל גם אור הסובב,"
        },
        {
          "s": 13,
          "text": "כתר,"
        },
        {
          "s": 14,
          "text": "כיון שאור זה נותן מקום לעולמות,"
        },
        {
          "s": 15,
          "text": "עולם מלשון העלם והסתר57"
        },
        {
          "s": 16,
          "text": "– הביטול דהמנגדים שבעולם ע\"י גילוי אור זה אינו ביטול בתכלית."
        },
        {
          "s": 17,
          "text": "וזה ששלמה הי' איש מנוחה ושלום הי' בימיו הוא מפני שבימיו היתה המשכת בחי' עתיק,"
        },
        {
          "s": 18,
          "text": "עשירות."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 3,
          "text": "דענין החסד שהוא למעלה גם מעשירות"
        },
        {
          "s": 4,
          "text": "[שלכן גמילות חסדים היא גם לעשירים],"
        },
        {
          "s": 5,
          "text": "הוא הגילוי דלע\"ל שהוא נעלה יותר גם מהגילוי שהי' בימי שלמה."
        },
        {
          "s": 6,
          "text": "דההמשכה שבימי שלמה היתה מבחינת עתיק"
        },
        {
          "s": 7,
          "text": "(כנ\"ל),"
        },
        {
          "s": 8,
          "text": "ולע\"ל תהי' ההמשכה מבחינת פנימיות עתיק,"
        },
        {
          "s": 9,
          "text": "היינו א\"ס שברדל\"א,"
        },
        {
          "s": 10,
          "text": "שהוא עיקר הענין דעתיק."
        },
        {
          "s": 11,
          "text": "ולהעיר ממ\"ש בזהר"
        },
        {
          "s": 12,
          "text": "(באדרא זוטא58)"
        },
        {
          "s": 13,
          "text": "האי עתיקא אשתכח בתלת רישין,"
        },
        {
          "s": 14,
          "text": "ופירש הרח\"ו"
        },
        {
          "s": 15,
          "text": "(בביאור האדר\"ז59),"
        },
        {
          "s": 16,
          "text": "שעיקר עתיקא הוא הא\"ס,"
        },
        {
          "s": 17,
          "text": "ועל שם התעלמותו בג' רישין נקראים גם הג' רישין בשם עתיק."
        },
        {
          "s": 18,
          "text": "ועפ\"ז עיקר עתיקא הוא א\"ס שבכל ג' הרישין."
        },
        {
          "s": 19,
          "text": "אבל במאמר זה מבאר שעיקר הענין דעתיק הוא א\"ס שברדל\"א."
        },
        {
          "s": 20,
          "text": "ויש לבאר זה ע\"פ מ\"ש בהמאמר"
        },
        {
          "s": 21,
          "text": "(בהמשך הענין)"
        },
        {
          "s": 22,
          "text": "בענין מ\"ש הרח\"ו"
        },
        {
          "s": 23,
          "text": "(בביאור האדר\"ז שם)"
        },
        {
          "s": 24,
          "text": "נמצא ומתעלם ומתגלה בג' רישין,"
        },
        {
          "s": 25,
          "text": "שג' הלשונות נמצא ומתעלם ומתגלה הם כמו ג' הענינים דאתה הוא והוי'."
        },
        {
          "s": 26,
          "text": "נמצא הוא כמו אתה,"
        },
        {
          "s": 27,
          "text": "עצמות,"
        },
        {
          "s": 28,
          "text": "מתעלם ומתגלה הם כמו הוא והוי',"
        },
        {
          "s": 29,
          "text": "ב' מדריגות באור."
        },
        {
          "s": 30,
          "text": "ופירוש נמצא הוא שהוא נמצא כמו שהוא בעצמותו."
        },
        {
          "s": 31,
          "text": "ועפ\"ז יש לבאר מ\"ש בהמאמר שעיקר הענין דעתיק הוא א\"ס שברדל\"א."
        },
        {
          "s": 32,
          "text": "ולהוסיף,"
        },
        {
          "s": 33,
          "text": "דע\"פ הביאור בהמאמר דענין נמצא"
        },
        {
          "s": 34,
          "text": "(שא\"ס נמצא ברדל\"א)"
        },
        {
          "s": 35,
          "text": "הוא שהוא נמצא ברדל\"א כמו שהוא בעצמותו,"
        },
        {
          "s": 36,
          "text": "יש לבאר זה שבימי שלמה היתה עשירות אמיתית,"
        },
        {
          "s": 37,
          "text": "אף שלא הי' אז הגילוי דלעתיד,"
        },
        {
          "s": 38,
          "text": "כי החידוש שיהי' לע\"ל הוא שאז יהי' גילוי העצם שלמעלה מבחינת הגילויים,"
        },
        {
          "s": 39,
          "text": "וענין הגילויים הי' בימי שלמה בשלימות."
        }
      ]
    }
  ]
}