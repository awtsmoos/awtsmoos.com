{
  "globalIndex": 551,
  "owner": 1,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916904_theRebbe_178__p003",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916904_theRebbe_178__p003",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916904_theRebbe_178",
  "title": "מאמר באתי לגני תשל\"ז",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה כל הענינים"
        },
        {
          "s": 2,
          "text": "(שלמעלה)"
        },
        {
          "s": 3,
          "text": "דוגמתם גם בעבודת נש\"י,"
        },
        {
          "s": 4,
          "text": "וכן הוא במה שנת\"ל שע\"י הצמצום נמשך הגילוי."
        },
        {
          "s": 5,
          "text": "והענין הוא,"
        },
        {
          "s": 6,
          "text": "דהנה כללות העבודה מתחלקת בהעבודה שבבחינת פנים והעבודה שבבחינת אחור70."
        },
        {
          "s": 7,
          "text": "והחילוק שביניהם,"
        },
        {
          "s": 8,
          "text": "בכללות,"
        },
        {
          "s": 9,
          "text": "הוא בדוגמת החילוק"
        },
        {
          "s": 10,
          "text": "(כפשוטו)"
        },
        {
          "s": 11,
          "text": "שבין פנים ואחור,"
        },
        {
          "s": 12,
          "text": "שבכללות הוא ענין העורף."
        },
        {
          "s": 13,
          "text": "דהנה הפנים71"
        },
        {
          "s": 14,
          "text": "מה שנקרא כן"
        },
        {
          "s": 15,
          "text": "(בשם פנים),"
        },
        {
          "s": 16,
          "text": "הוא משום דבו נתגלה הפנימיות וכן בו נמצאים החושים בגלוי,"
        },
        {
          "s": 17,
          "text": "חוש הראי' בעינים,"
        },
        {
          "s": 18,
          "text": "חוש השמיעה באזנים,"
        },
        {
          "s": 19,
          "text": "חוש הריח בחוטם,"
        },
        {
          "s": 20,
          "text": "הדיבור בפה."
        },
        {
          "s": 21,
          "text": "משא\"כ באחור,"
        },
        {
          "s": 22,
          "text": "בהעורף,"
        },
        {
          "s": 23,
          "text": "הנה החיות הוא בהעלם."
        },
        {
          "s": 24,
          "text": "ועד\"ז יובן למעלה החילוק שבין האור שלפני הצמצום ולאחר הצמצום,"
        },
        {
          "s": 25,
          "text": "וכמו שנת\"ל שהאור הנמשך ע\"י הצמצום הוא שלא בערך ואינו בדומה להאור שלפני הצמצום"
        },
        {
          "s": 26,
          "text": "[כי מכיון שהמשכתו הוא ע\"י הפסק הצמצום שבבחינת סילוק אור הראשון לגמרי לכן האור הנמשך ע\"י הוא בבחינת אור חדש"
        },
        {
          "s": 27,
          "text": "(וכנ\"ל מתורת הרב המגיד דויהי אור"
        },
        {
          "s": 28,
          "text": "(חדש)"
        },
        {
          "s": 29,
          "text": "ולא ויהי כן"
        },
        {
          "s": 30,
          "text": "(הוא דויאמר אלקים))]"
        },
        {
          "s": 31,
          "text": "עד שהאור שלאחה\"צ לגבי לפנה\"צ הוא בערך האחור לגבי פנים."
        },
        {
          "s": 32,
          "text": "ועד\"ז העבודה שבבחינת אחור לגבי העבודה שבבחינת פנים שאינם בערך זל\"ז."
        },
        {
          "s": 33,
          "text": "אמנם אעפ\"כ,"
        },
        {
          "s": 34,
          "text": "הנה ע\"ד שנת\"ל בענין הצמצום,"
        },
        {
          "s": 35,
          "text": "שע\"י הצמצום נמשך גם לאחר הצמצום האור שלפני הצמצום"
        },
        {
          "s": 36,
          "text": "(ואפילו בחינת אור הבל\"ג),"
        },
        {
          "s": 37,
          "text": "עד\"ז הוא ג\"כ בעבודה שגם באופן העבודה שבבחינת אחור מאיר בחינת הפנים"
        },
        {
          "s": 38,
          "text": "[וכן נמשך באופן כזה בנשמות ותורה"
        },
        {
          "s": 39,
          "text": "(וכפי שיתבאר לקמן)]."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וביאור הענין הוא,"
        },
        {
          "s": 2,
          "text": "דהעבודה שבבחינת פנים היא"
        },
        {
          "s": 3,
          "text": "(בכללות)"
        },
        {
          "s": 4,
          "text": "העבודה כמו שהיא מצד עולם האצילות,"
        },
        {
          "s": 5,
          "text": "והעבודה שבבחינת אחור היא"
        },
        {
          "s": 6,
          "text": "(בכללות)"
        },
        {
          "s": 7,
          "text": "העבודה שמצד עולמות בי\"ע."
        },
        {
          "s": 8,
          "text": "דהנה עולם האצילות,"
        },
        {
          "s": 9,
          "text": "בכללות הוא כמו שסדר ההשתלשלות והעולמות הם"
        },
        {
          "s": 10,
          "text": "(שטייען)"
        },
        {
          "s": 11,
          "text": "מצד אלקות."
        },
        {
          "s": 12,
          "text": "דאצילות הוא מלשון אצלו וסמוך,"
        },
        {
          "s": 13,
          "text": "וכדאיתא בפרדס72"
        },
        {
          "s": 14,
          "text": "ונקרא עולם האחדות,"
        },
        {
          "s": 15,
          "text": "דאיהו וחיוהי וגרמוהי חד,"
        },
        {
          "s": 16,
          "text": "כדאיתא בהקדמת תקו\"ז73."
        },
        {
          "s": 17,
          "text": "ועולמות בי\"ע נקראים עלמא דפרודא,"
        },
        {
          "s": 18,
          "text": "משם יפרד74,"
        },
        {
          "s": 19,
          "text": "שזהו היפך מעולם האחדות"
        },
        {
          "s": 20,
          "text": "(אצילות)."
        },
        {
          "s": 21,
          "text": "ועד\"ז הם ב' אופני העבודה דפנים ואחור,"
        },
        {
          "s": 22,
          "text": "דבאצילות העבודה היא בבחינת פנים"
        },
        {
          "s": 23,
          "text": "(שאלקות הוא בגילוי),"
        },
        {
          "s": 24,
          "text": "ובעולמות בי\"ע העבודה היא בבחינת אחור,"
        },
        {
          "s": 25,
          "text": "דההנהגה שבבי\"ע הוא בבחינת אחרי הוי' אלקיכם תלכו75,"
        },
        {
          "s": 26,
          "text": "ובלשון הידוע76"
        },
        {
          "s": 27,
          "text": "שבבי\"ע עולמות הם בפשיטות ואלקות הוא בהתחדשות,"
        },
        {
          "s": 28,
          "text": "שזהו\"ע בחינת אחור"
        },
        {
          "s": 29,
          "text": "(שאלקות הוא בבחינת העלם)טז."
        },
        {
          "s": 30,
          "text": "וע\"ז ההוראה,"
        },
        {
          "s": 31,
          "text": "דהן אמת ש"
        },
        {
          "s": 32,
          "text": "[התורה על הרוב תדבר84"
        },
        {
          "s": 33,
          "text": "ו]"
        },
        {
          "s": 34,
          "text": "העבודה היא בבחינת אחרי הוי' אלקיכם תלכויז,"
        },
        {
          "s": 35,
          "text": "בדוגמת העבודה שהי' לפני מתן תורה,"
        },
        {
          "s": 36,
          "text": "כמ\"ש78"
        },
        {
          "s": 37,
          "text": "לכתך אחרי במדבריח,"
        },
        {
          "s": 38,
          "text": "אמנם כדי שיהי' קיום להעבודה"
        },
        {
          "s": 39,
          "text": "(שבבחינת אחור)"
        },
        {
          "s": 40,
          "text": "ותפעול פעולתה צריך נתינת כח לזה ע\"י שיתבונן שמצד פנימיות נפשו ופנימיות לבבו הוא"
        },
        {
          "s": 41,
          "text": "(תמיד)"
        },
        {
          "s": 42,
          "text": "בבחינת פנים,"
        },
        {
          "s": 43,
          "text": "כפס\"ד הרמב\"ם הידוע בהלכות גירושין ספ\"ב,"
        },
        {
          "s": 44,
          "text": "דכאו\"א מישראל באיזה מעמד ומצב שיהי' רוצה הוא לעשות כל המצוות ולהתרחק מן העבירות ויצרו הוא שתקפו כו',"
        },
        {
          "s": 45,
          "text": "וכמו\"כ יתבונן בזה שאפילו בשעת החטא היתה באמנה אתו ית'88,"
        },
        {
          "s": 46,
          "text": "כיון ש"
        },
        {
          "s": 47,
          "text": "(פנימיות נפשו)"
        },
        {
          "s": 48,
          "text": "הוא חלק אלוקה ממעל ממש89."
        },
        {
          "s": 49,
          "text": "וע\"י התבוננות זו,"
        },
        {
          "s": 50,
          "text": "אע\"פ שמצד מצבו הוא בבחינת אתכפיא ולא הגיע עדיין לבחינת אתהפכא חשוכא לנהורא ומרירו למיתקו90"
        },
        {
          "s": 51,
          "text": "[שאז מתבטל כל ענין הצמצום ולעו\"ז],"
        },
        {
          "s": 52,
          "text": "הנה מ\"מ יש לו"
        },
        {
          "s": 53,
          "text": "(מההתבוננות שבפנימיות נפשו ולבו,"
        },
        {
          "s": 54,
          "text": "הוא בבחינת פנים)"
        },
        {
          "s": 55,
          "text": "נתינת כח והארה והשפעה עד להשפעה גלוי' גם בנוגע לחיצוניות נפשו"
        },
        {
          "s": 56,
          "text": "(אחור דנפשו),"
        },
        {
          "s": 57,
          "text": "בעבודתו שבבחינת אחרי הוי' אלקיכם תלכו,"
        },
        {
          "s": 58,
          "text": "העבודה שבבחינת אחור."
        },
        {
          "s": 59,
          "text": "ועד שזה פועל גם על לבושיו דמחדו\"מ,"
        },
        {
          "s": 60,
          "text": "שביחד עם זה שהענינים נעשים בפועל,"
        },
        {
          "s": 61,
          "text": "דהמעשה הוא העיקר91,"
        },
        {
          "s": 62,
          "text": "הנה ע\"י שמאיר הארה מפנימיות נפשו"
        },
        {
          "s": 63,
          "text": "(שע\"י ההתבוננות)"
        },
        {
          "s": 64,
          "text": "יש לו בזה"
        },
        {
          "s": 65,
          "text": "(נוסף על המעשה בפועל)"
        },
        {
          "s": 66,
          "text": "גם חיות ונעימות ועד שיש לו גם תענוג."
        },
        {
          "s": 67,
          "text": "וכמו שנת\"ל"
        },
        {
          "s": 68,
          "text": "(מהרמב\"ם הנ\"ל)"
        },
        {
          "s": 69,
          "text": "דאף שכופין אותו כו' אמנם כשאומר רוצה אני הנה זהו רצונו האמיתי,"
        },
        {
          "s": 70,
          "text": "שהרי תורת אמת אומר ע\"ז שזהו לרצונו92,"
        },
        {
          "s": 71,
          "text": "שזהו מצד הארת פנימיות נפשו שבאה בגילוי ופועלת גם על חיצוניות נפשויט,"
        },
        {
          "s": 72,
          "text": "ובחינת פנים מאיר גם בהעבודה שמצד עצמה היא בבחינת אחור."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "והנה כמו שהוא בתחלת ההשתלשלות"
        },
        {
          "s": 2,
          "text": "(בענין הצמצום)"
        },
        {
          "s": 3,
          "text": "ובעבודה,"
        },
        {
          "s": 4,
          "text": "כן הוא גם בנשמות."
        },
        {
          "s": 5,
          "text": "וכמו שמבאר כ\"ק אדמו\"ר האמצעי בשער התשובה94"
        },
        {
          "s": 6,
          "text": "[בקיצור]"
        },
        {
          "s": 7,
          "text": "במאחז\"ל95"
        },
        {
          "s": 8,
          "text": "שהשבטים אמרו ליעקב כשם שאין בלבך אלא אחד כך אין בלבנו אלא אחד."
        },
        {
          "s": 9,
          "text": "דידוע הדיוק בזה96,"
        },
        {
          "s": 10,
          "text": "דמהו\"ע ההקדמה שהקדימו כשם שאין בלבך,"
        },
        {
          "s": 11,
          "text": "דלכאורה הול\"ל רק אין בלבנו אלא אחד,"
        },
        {
          "s": 12,
          "text": "וכן מהו ההו\"א שבאו השבטים לשלול."
        },
        {
          "s": 13,
          "text": "אך הענין הוא,"
        },
        {
          "s": 14,
          "text": "דההקדמה דכשם שאין בלבך אלא אחד הוא הסבר ונתינת טעם למה שאמרו אין בלבנו אלא אחד."
        },
        {
          "s": 15,
          "text": "דאע\"פ שהשבטים הם בבחינת מרכבתא תתאה דעולם הבריאהכ,"
        },
        {
          "s": 16,
          "text": "התחלת עולמות בי\"ע,"
        },
        {
          "s": 17,
          "text": "עלמא דפרודא,"
        },
        {
          "s": 18,
          "text": "דכללות ענין עולמות האלו הוא בבחינת פירוד כמ\"ש ומשם יפרד,"
        },
        {
          "s": 19,
          "text": "אחרי ה\"א"
        },
        {
          "s": 20,
          "text": "(כנ\"ל)"
        },
        {
          "s": 21,
          "text": "הנה אעפ\"כ אין בלבנו אלא אחד."
        },
        {
          "s": 22,
          "text": "והיינו,"
        },
        {
          "s": 23,
          "text": "דאף ש"
        },
        {
          "s": 24,
          "text": "(גם בשלימות העבודה דעולם הבריאה הנה)"
        },
        {
          "s": 25,
          "text": "העבודה בגלוי היא בבחינת ועד שהוא רק חילופי אתוון דאחד98,"
        },
        {
          "s": 26,
          "text": "והיינו שהעבודה היא בבחינת אחרי הוי' אלקיכם גו',"
        },
        {
          "s": 27,
          "text": "מ\"מ בלבנו דהיינו בפנימיות הלב הוא בבחינת אחד."
        },
        {
          "s": 28,
          "text": "והנתינת כח ע\"ז שגם"
        },
        {
          "s": 29,
          "text": "(בהשבטים)"
        },
        {
          "s": 30,
          "text": "בהיותם בבי\"ע,"
        },
        {
          "s": 31,
          "text": "עלמא דפרודא,"
        },
        {
          "s": 32,
          "text": "יהי' בפנימיות הלב בבחינת אחד,"
        },
        {
          "s": 33,
          "text": "היא מצד שאין בלבך אלא אחד"
        },
        {
          "s": 34,
          "text": "(כנ\"ל שזהו הסברה ונתינת טעם ע\"ז שאין בלבנו אלא אחד)."
        },
        {
          "s": 35,
          "text": "שבחי' של יעקב"
        },
        {
          "s": 36,
          "text": "(בלבך)"
        },
        {
          "s": 37,
          "text": "שמקומו הוא בעולם האצילות,"
        },
        {
          "s": 38,
          "text": "ולא עוד אלא שהוא בחיר שבאבות99,"
        },
        {
          "s": 39,
          "text": "שהאבות הן הן המרכבה100,"
        },
        {
          "s": 40,
          "text": "ולכן עבודתו וכו' היא בבחינת אחד,"
        },
        {
          "s": 41,
          "text": "הנה זה ממשיךכא"
        },
        {
          "s": 42,
          "text": "גם בלבנו"
        },
        {
          "s": 43,
          "text": "(דהשבטים,"
        },
        {
          "s": 44,
          "text": "בבי\"ע)"
        },
        {
          "s": 45,
          "text": "אלא אחד"
        },
        {
          "s": 46,
          "text": "(הביטול וכו' דאחד)."
        },
        {
          "s": 47,
          "text": "אמנם אעפ\"כ אומרים על המשכה זו כשם כו' כך כו',"
        },
        {
          "s": 48,
          "text": "היינו דאי\"ז אותו הענין ממש."
        },
        {
          "s": 49,
          "text": "וכמו שמבאר כ\"ק אדמו\"ר הצ\"צ בהדרושים101"
        },
        {
          "s": 50,
          "text": "דמה שאמרו כשם שאין בלבך כו' כך כו' הוא ממש ענין המאמר102"
        },
        {
          "s": 51,
          "text": "כגוונא דאינון מתייחדין לעילא אוף הכי איהי אתייחדת לתתא בכורסייא למיהוי אחד באחד103"
        },
        {
          "s": 52,
          "text": "כו',"
        },
        {
          "s": 53,
          "text": "שע\"י שאינון מתייחדין לעילא באחד נמשך כמו\"כ לתתא בכורסייא למיהוי אחד באחד"
        },
        {
          "s": 54,
          "text": "[עד שנמשך כן גם בהי\"ב שבטים,"
        },
        {
          "s": 55,
          "text": "כמבואר שם בארוכה שזהו הי\"ב גבולי אלכסון הנעשים מהתכללות הו' קצוות"
        },
        {
          "s": 56,
          "text": "(דהו' מדות)"
        },
        {
          "s": 57,
          "text": "זב\"ז],"
        },
        {
          "s": 58,
          "text": "אבל מ\"מ זהו כגוונא בלבד,"
        },
        {
          "s": 59,
          "text": "ואינו אותו הענין ממש כמו שהוא באצילות."
        },
        {
          "s": 60,
          "text": "וכמו\"כ הוא במה שאמרו השבטים"
        },
        {
          "s": 61,
          "text": "(כנ\"ל שכן נמשך בהי\"ב שבטים)"
        },
        {
          "s": 62,
          "text": "כשם שאין כו' כך כו' דמבחינת יחו\"ע שבלבך,"
        },
        {
          "s": 63,
          "text": "שבאצילות,"
        },
        {
          "s": 64,
          "text": "נמשך לנו"
        },
        {
          "s": 65,
          "text": "(בבי\"ע)"
        },
        {
          "s": 66,
          "text": "להיות בבחינת יחו\"ת ג\"כ להיות בבחינת ביטול היש לאין אבל לא כמו יחו\"ע ממש רק כשם כו' כך כו'."
        },
        {
          "s": 67,
          "text": "וזהו מה שגם בנשמות דבי\"ע"
        },
        {
          "s": 68,
          "text": "(נשמות השבטים)"
        },
        {
          "s": 69,
          "text": "נמשך הארה מנשמות דאצילות"
        },
        {
          "s": 70,
          "text": "(נשמת יעקב)."
        },
        {
          "s": 71,
          "text": "ע\"ד שהוא בכללות ההשתלשלות ובעבודה."
        }
      ]
    }
  ]
}