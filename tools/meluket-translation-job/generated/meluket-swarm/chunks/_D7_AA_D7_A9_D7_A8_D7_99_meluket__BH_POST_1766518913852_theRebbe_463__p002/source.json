{
  "globalIndex": 30,
  "owner": 30,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913852_theRebbe_463__p002",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913852_theRebbe_463__p002",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518913852_theRebbe_463",
  "title": "מאמר זה היום תחילת מעשיך תשמ\"ב",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "וביאור הענין"
        },
        {
          "s": 2,
          "text": "(שראש השנה,"
        },
        {
          "s": 3,
          "text": "יום ברוא אדם הראשון,"
        },
        {
          "s": 4,
          "text": "הוא תחלת מעשיך)"
        },
        {
          "s": 5,
          "text": "בעומק יותר,"
        },
        {
          "s": 6,
          "text": "הנה ידוע שעבודת האדם בכחה לשנות גם את העבר20."
        },
        {
          "s": 7,
          "text": "ומזה מובן"
        },
        {
          "s": 8,
          "text": "(במכ\"ש)"
        },
        {
          "s": 9,
          "text": "בנוגע לעבודתו של אדם הראשון שהי' יציר כפיו של הקב\"ה21,"
        },
        {
          "s": 10,
          "text": "שהעילוי שפעל בכל הנבראים ע\"י הכרזתו בואו נשתחוה גו' לפני ה' עושינו הוא גם בנוגע למציאותם שלפני עבודתו."
        },
        {
          "s": 11,
          "text": "דכיון22"
        },
        {
          "s": 12,
          "text": "שכוונת הבריאה מלכתחילה היא שהאדם ע\"י עבודתו ימשיך גילוי אלקות בעולם23,"
        },
        {
          "s": 13,
          "text": "לכן,"
        },
        {
          "s": 14,
          "text": "לאחרי שנמשך בעולם גילוי אלקות נעשה עי\"ז עילוי גם במציאות העולם שהי' לפנ\"ז,"
        },
        {
          "s": 15,
          "text": "ובפרט שענינו הוא הכנה להגילוי שנמשך ע\"י עבודת האדם."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "וזהו מה שהיום דראש השנה,"
        },
        {
          "s": 1,
          "text": "יום ברוא אדם הראשון,"
        },
        {
          "s": 2,
          "text": "הוא תחלת מעשיך,"
        },
        {
          "s": 3,
          "text": "דפירוש הפשוט"
        },
        {
          "s": 4,
          "text": "(ואין ענין יוצא מידי פשוטו)"
        },
        {
          "s": 5,
          "text": "דתחלת מעשיך הוא התחלת כל המעשים,"
        },
        {
          "s": 6,
          "text": "גם המעשים שהיו בה' ימים הראשונים דמע\"ב"
        },
        {
          "s": 7,
          "text": "(כולל גם הזמן דימים אלו24),"
        },
        {
          "s": 8,
          "text": "כי ע\"י עבודתו של אדם הראשון נעשה עילוי וחידוש גם בהמציאות דעולם שהי' לפני זה,"
        },
        {
          "s": 9,
          "text": "ולכן זה היום הוא תחלת מעשיך,"
        },
        {
          "s": 10,
          "text": "ההתחלה של כל הבריאה."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "וכמו שבראש השנה בפעם הראשונה,"
        },
        {
          "s": 1,
          "text": "ביום ברוא אדם הראשון,"
        },
        {
          "s": 2,
          "text": "נעשה שלימות הבריאה"
        },
        {
          "s": 3,
          "text": "(מעשיך),"
        },
        {
          "s": 4,
          "text": "ובאופן של חידוש"
        },
        {
          "s": 5,
          "text": "(תחלת מעשיך),"
        },
        {
          "s": 6,
          "text": "עד\"ז הוא בראש השנה שבכל שנה ושנה,"
        },
        {
          "s": 7,
          "text": "דע\"י שישראל מכתירים את הקב\"ה שיהי' מלך עליהם ועל כל העולם,"
        },
        {
          "s": 8,
          "text": "נעשה שלימות וחידוש בכל הבריאה,"
        },
        {
          "s": 9,
          "text": "ועד שעי\"ז נעשה שלימות וחידוש גם למעלה,"
        },
        {
          "s": 10,
          "text": "כתורת הה\"מ25"
        },
        {
          "s": 11,
          "text": "ואדמו\"ר הזקן26"
        },
        {
          "s": 12,
          "text": "על מאמר המשנה27"
        },
        {
          "s": 13,
          "text": "דע מה למעלה ממך,"
        },
        {
          "s": 14,
          "text": "דכל הענינים שלמעלה הם ממך."
        }
      ]
    }
  ]
}