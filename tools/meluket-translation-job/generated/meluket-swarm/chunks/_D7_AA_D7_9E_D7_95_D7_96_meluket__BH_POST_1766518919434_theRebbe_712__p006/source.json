{
  "globalIndex": 964,
  "owner": 14,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919434_theRebbe_712__p006",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919434_theRebbe_712__p006",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919434_theRebbe_712",
  "title": "מאמר וחזקת והיית לאיש תשכ\"ח",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וזהו וחזקת והיית לאיש,"
        },
        {
          "s": 2,
          "text": "דזה שבן י\"ג שנה נעשה איש ע\"פ טבע,"
        },
        {
          "s": 3,
          "text": "הוא ענין שמצד למעלה,"
        },
        {
          "s": 4,
          "text": "מצד שהקב\"ה הטביע הטבע בהבריאה,"
        },
        {
          "s": 5,
          "text": "ומכיון שעיקר המעלה דכל ענין הוא כשהוא בא ע\"י עבודת האדם"
        },
        {
          "s": 6,
          "text": "(כנ\"ל בארוכה),"
        },
        {
          "s": 7,
          "text": "לכן צ\"ל וחזקת והיית לאיש,"
        },
        {
          "s": 8,
          "text": "שיהי' לאיש"
        },
        {
          "s": 9,
          "text": "(גם)"
        },
        {
          "s": 10,
          "text": "ע\"י עבודתו."
        },
        {
          "s": 11,
          "text": "ועפ\"ז יש לבאר גם הדיוק דוחזקת והיית לאיש,"
        },
        {
          "s": 12,
          "text": "דאיש מורה על המדות,"
        },
        {
          "s": 13,
          "text": "אף שהמעלה דבן י\"ג שנה היא בהמוחין,"
        },
        {
          "s": 14,
          "text": "שיש לו עצם המוחין שלמעלה מענין המדות,"
        },
        {
          "s": 15,
          "text": "כי המעלה דעבודת האדם שמגעת במחשבה העצמית היא בעיקר בהעבודה דהמשכת עצם המוחין"
        },
        {
          "s": 16,
          "text": "(שלמעלה מענין המדות)"
        },
        {
          "s": 17,
          "text": "בהמדות,"
        },
        {
          "s": 18,
          "text": "ע\"ד המבואר לעיל בענין יוסף שממשיך גילוי האצילות"
        },
        {
          "s": 19,
          "text": "(שלמעלה משרש הנבראים)"
        },
        {
          "s": 20,
          "text": "בבי\"ע."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "ויש לקשר כ\"ז עם עבודתו של כ\"ק מו\"ח אדמו\"ר,"
        },
        {
          "s": 1,
          "text": "יוסף שבדורנו67,"
        },
        {
          "s": 2,
          "text": "שהמאמר ד\"ה וחזקת והיית לאיש נאמר בסיום וחותם חגיגת הבר מצוה שלו,"
        },
        {
          "s": 3,
          "text": "שעבודתו העיקרית היתה יפוצו מעינותיך חוצה,"
        },
        {
          "s": 4,
          "text": "שגם בחוצה הכי תחתון שאין חוצה למטה ממנו68"
        },
        {
          "s": 5,
          "text": "יומשכו"
        },
        {
          "s": 6,
          "text": "(נוסף על מים שנמשכים מהמעינות,"
        },
        {
          "s": 7,
          "text": "גם)"
        },
        {
          "s": 8,
          "text": "המעינות עצמם."
        },
        {
          "s": 9,
          "text": "שזו"
        },
        {
          "s": 10,
          "text": "(הפצת המעינות חוצה)"
        },
        {
          "s": 11,
          "text": "היא ההכנה והכלי לאתי בקרוב ממש מר דא מלכא משיחא69."
        }
      ]
    }
  ]
}