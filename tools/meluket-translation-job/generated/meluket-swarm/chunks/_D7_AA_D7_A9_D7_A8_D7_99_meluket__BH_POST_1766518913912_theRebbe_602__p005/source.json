{
  "globalIndex": 43,
  "owner": 43,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913912_theRebbe_602__p005",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913912_theRebbe_602__p005",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518913912_theRebbe_602",
  "title": "מאמר אדון עולם תשמ\"ג",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "ובפרט שכבר הי' לעולמים,"
        },
        {
          "s": 3,
          "text": "ומעשה רב73,"
        },
        {
          "s": 4,
          "text": "כמסופר בגמרא74"
        },
        {
          "s": 5,
          "text": "שאמרו לשונות שנראים בחיצוניות כו' ובאמת כולהו ברכתא נינהו,"
        },
        {
          "s": 6,
          "text": "ומה שברכו אותו בלשון כזה הוא כמ\"ש אדמו\"ר הצ\"צ75"
        },
        {
          "s": 7,
          "text": "לפי שהברכה באופן זה היא מבחינת סתים,"
        },
        {
          "s": 8,
          "text": "דהברכות שמבחינת סתים הם ברכות נעלות יותר וגם המשכתם למטה היא בתוקף גדול יותר"
        },
        {
          "s": 9,
          "text": "(מיט אַ שטורעם)."
        },
        {
          "s": 10,
          "text": "וכדאיתא בגמרא שם,"
        },
        {
          "s": 11,
          "text": "שברכו אותו תוליד בנים כו' המשכת וגילוי כח הא\"ס76"
        },
        {
          "s": 12,
          "text": "בדור ישרים יבורך."
        },
        {
          "s": 13,
          "text": "והנה פירוש זה"
        },
        {
          "s": 14,
          "text": "(דמה שברכו בלשון כזה הוא לפי שהברכה באופן זה היא מבחינת סתים)"
        },
        {
          "s": 15,
          "text": "אומר אדמו\"ר הצ\"צ שהוא \"יותר נראה כפשטן\"."
        },
        {
          "s": 16,
          "text": "דלפנ\"ז מובא שם"
        },
        {
          "s": 17,
          "text": "(בענין הברכות שבפרשת בחוקותי)"
        },
        {
          "s": 18,
          "text": "שהו\"ע דהיפך הברכה אלא שזה קאי על הלעו\"ז."
        },
        {
          "s": 19,
          "text": "ואח\"כ מביא פירוש נעלה יותר77,"
        },
        {
          "s": 20,
          "text": "דמה שהברכות נאמרו בלשון כזה הוא בכדי לחדודי."
        },
        {
          "s": 21,
          "text": "דגם לפי פירוש זה,"
        },
        {
          "s": 22,
          "text": "ענין הברכה שבלשון זה אינו בפשטות ובגילוי,"
        },
        {
          "s": 23,
          "text": "שהרי בכדי לעמוד על אמיתית הענין צריך לחידוד השכל."
        },
        {
          "s": 24,
          "text": "אבל לאח\"ז מסיק,"
        },
        {
          "s": 25,
          "text": "דמה שהברכות נאמרו בלשון כזה אין זה גרעון ח\"ו אלא אדרבה מפני שהברכות נעלות יותר."
        },
        {
          "s": 26,
          "text": "ועל פירוש זה אומר שהוא \"יותר נראה כפשטן\","
        },
        {
          "s": 27,
          "text": "דמה שלשונות אלו ברכתא נינהו אין זה פירוש מחודד כ\"א הפירוש הפשוט,"
        },
        {
          "s": 28,
          "text": "גם בעולם הפשט."
        },
        {
          "s": 29,
          "text": "ולאחר שאדמו\"ר הצ\"צ פתח את הדרך,"
        },
        {
          "s": 30,
          "text": "ובפרט שלימד ונתן זה בתורה מלשון הוראה78,"
        },
        {
          "s": 31,
          "text": "נעשה זה הוראה ונתינת כח לכאו\"א,"
        },
        {
          "s": 32,
          "text": "לפרש ולגלות הברכה גם בלשונות וענינים שבחיצוניותם נראים כו',"
        },
        {
          "s": 33,
          "text": "ואדרבה,"
        },
        {
          "s": 34,
          "text": "ברכות אלו הם נעלות ביותר,"
        },
        {
          "s": 35,
          "text": "וכפשטן,"
        },
        {
          "s": 36,
          "text": "בטוב הנראה והנגלה."
        },
        {
          "s": 37,
          "text": "דכח זה"
        },
        {
          "s": 38,
          "text": "(להמשיך כל הענינים בטוב הנראה והנגלה)"
        },
        {
          "s": 39,
          "text": "הוא גם בכל ימי השנה."
        },
        {
          "s": 40,
          "text": "ובפרט בראש השנה כשמכתירים את המלך בשמחה גדולה"
        },
        {
          "s": 41,
          "text": "(כמובא לעיל מכ\"ק מו\"ח אדמו\"ר),"
        },
        {
          "s": 42,
          "text": "דשמחה פורצת כל הגדרים79."
        },
        {
          "s": 43,
          "text": "ועאכו\"כ ביו\"ט של ראש השנה שחל להיות בשבת,"
        },
        {
          "s": 44,
          "text": "דכל ההמשכות הנעשים ע\"י תקיעת שופר נעשים הם בשבת מצ\"ע,"
        },
        {
          "s": 45,
          "text": "דבשבת נמשך בחי' תענוג הפשוט,"
        },
        {
          "s": 46,
          "text": "כמבואר בארוכה בהמשך יו\"ט של ראש השנה שחל להיות בשבת לכ\"ק אדמו\"ר"
        },
        {
          "s": 47,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 48,
          "text": "נ\"ע80."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ב)"
        },
        {
          "s": 2,
          "text": "וזהו אדון עולם אשר מלך בטרם כל יצור נברא,"
        },
        {
          "s": 3,
          "text": "ומבאר כ\"ק מו\"ח אדמו\"ר במאמרו ד\"ה זה"
        },
        {
          "s": 4,
          "text": "(כמובא לעיל בהתחלת המאמר)"
        },
        {
          "s": 5,
          "text": "דאדון עולם בגימט' אין סוף קאי על המלכות כמו שהוא בעצמותו ית',"
        },
        {
          "s": 6,
          "text": "רצון המוחלט בעצמותו,"
        },
        {
          "s": 7,
          "text": "ומבאר שם81,"
        },
        {
          "s": 8,
          "text": "דברצון המוחלט בעצמותו אין שייך העלאת מ\"ן כלל."
        },
        {
          "s": 9,
          "text": "אבל אעפ\"כ,"
        },
        {
          "s": 10,
          "text": "כ\"ז והמאמר ד\"ה אדון עולם בא"
        },
        {
          "s": 11,
          "text": "(כנ\"ל)"
        },
        {
          "s": 12,
          "text": "בהמשך להמאמר ד\"ה יו\"ט של ראש השנה שחל להיות בשבת שבו מבאר הענין דתקיעת שופר בראש השנה"
        },
        {
          "s": 13,
          "text": "(העבודה שכוללת כל פרטי העבודות דכל השנה),"
        },
        {
          "s": 14,
          "text": "דעבודת ישראל פועלת לא רק בנין הז\"א"
        },
        {
          "s": 15,
          "text": "(וגם כל הבחינות והפרצופים דכל ההשתלשלות,"
        },
        {
          "s": 16,
          "text": "כנ\"ל בארוכה),"
        },
        {
          "s": 17,
          "text": "ולא רק שהיא מעוררת גם באוא\"ס שלפני הצמצום בחינת רצון הגלוי"
        },
        {
          "s": 18,
          "text": "(בהבחינה דגילוי לזולתו)"
        },
        {
          "s": 19,
          "text": "וגם בחינת רצון הנעלם"
        },
        {
          "s": 20,
          "text": "(בהבחינה דגילוי לעצמו),"
        },
        {
          "s": 21,
          "text": "אלא יתירה מזו,"
        },
        {
          "s": 22,
          "text": "דמצד זה שישראל מושרשים בהעצמות,"
        },
        {
          "s": 23,
          "text": "הם ממשיכים גם מבחינת רצון המוחלט בעצמותו,"
        },
        {
          "s": 24,
          "text": "בחינת אדון עולם בגימ' אין סוף82."
        },
        {
          "s": 25,
          "text": "והמשכה זו היא"
        },
        {
          "s": 26,
          "text": "(בעיקר)"
        },
        {
          "s": 27,
          "text": "למטה בעולם העשי' הגשמיית,"
        },
        {
          "s": 28,
          "text": "ובזה גופא – בענינים גשמיים,"
        },
        {
          "s": 29,
          "text": "דנוסף על הדין בראש השנה בענין המשכת אלקות,"
        },
        {
          "s": 30,
          "text": "משפט83"
        },
        {
          "s": 31,
          "text": "לאלקי יעקב84,"
        },
        {
          "s": 32,
          "text": "הנה עיקר הדין בראש השנה הוא בענין השפעות גשמיות85,"
        },
        {
          "s": 33,
          "text": "וישראל זוכים בדין בב' הענינים,"
        },
        {
          "s": 34,
          "text": "הן בהשפעות רוחניות והן בהשפעות גשמיות בבני חיי ומזוני רויחי,"
        },
        {
          "s": 35,
          "text": "וכאמור דעיקר הענין דראש השנה היא ההמשכה בגשמיות,"
        },
        {
          "s": 36,
          "text": "פועל ישועות בקרב הארץ86,"
        },
        {
          "s": 37,
          "text": "דהמשכת הישועות"
        },
        {
          "s": 38,
          "text": "(בכל הפירושים שבזה)"
        },
        {
          "s": 39,
          "text": "תהי' באופן דפועל,"
        },
        {
          "s": 40,
          "text": "דלשון פעולה מורה על פעולה גשמיית דוקא עוד יותר מלשון עשי',"
        },
        {
          "s": 41,
          "text": "ובזה גופא בקרב הארץ87,"
        },
        {
          "s": 42,
          "text": "בתחתון שאין תחתון למטה ממנו."
        },
        {
          "s": 43,
          "text": "ובפשטות הוא,"
        },
        {
          "s": 44,
          "text": "שכאו\"א מישראל נכתב ונחתם בספרן של צדיקים גמורים88,"
        },
        {
          "s": 45,
          "text": "כי ועמך כולם צדיקים89"
        },
        {
          "s": 46,
          "text": "(צדיקים גמורים),"
        },
        {
          "s": 47,
          "text": "לאלתר לחיים88"
        },
        {
          "s": 48,
          "text": "ולאלתר לגאולה90,"
        },
        {
          "s": 49,
          "text": "דכאו\"א מישראל יצא מהגלות לגאולה האמיתית והשלימה,"
        },
        {
          "s": 50,
          "text": "וכמ\"ש בההפטורה דראש השנה91"
        },
        {
          "s": 51,
          "text": "קהל גדול ישובו הנה,"
        },
        {
          "s": 52,
          "text": "דבזה נכלל כל אחד ואחת מישראל כמבואר בארוכה בההפטורה דראש השנה,"
        },
        {
          "s": 53,
          "text": "ובשמחה גדולה,"
        },
        {
          "s": 54,
          "text": "וכנ\"ל שהכתרת המלך היא בשמחה גדולה,"
        },
        {
          "s": 55,
          "text": "ושמחת עולם על ראשם92,"
        },
        {
          "s": 56,
          "text": "בגאולה האמיתית והשלימה ע\"י משיח צדקנו,"
        },
        {
          "s": 57,
          "text": "בקרוב ממש."
        }
      ]
    }
  ]
}