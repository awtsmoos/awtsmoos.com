{
  "globalIndex": 415,
  "owner": 15,
  "jobId": "_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916134_theRebbe_917__p004",
  "batchId": "meluket-_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916134_theRebbe_917__p004",
  "seriesId": "טבת_meluket",
  "postId": "BH_POST_1766518916134_theRebbe_917",
  "title": "מאמר ויגש אליו יהודה תשכ\"ה",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "וביאור הענין בפרטיות יותר,"
        },
        {
          "s": 2,
          "text": "יובן ע\"פ מ\"ש הצ\"צ בהמאמר35"
        },
        {
          "s": 3,
          "text": "ד\"ה להבין הענין שארז\"ל36"
        },
        {
          "s": 4,
          "text": "שאור א\"ס ב\"ה הוא למעלה עד אין קץ ולמטה עד אין תכלית"
        },
        {
          "s": 5,
          "text": "[שהביכל הזה"
        },
        {
          "s": 6,
          "text": "(שבו נמצא מאמר הנ\"ל)"
        },
        {
          "s": 7,
          "text": "הי' משך כמה שנים בשבי',"
        },
        {
          "s": 8,
          "text": "ובזמן האחרון37"
        },
        {
          "s": 9,
          "text": "נפדה מהשבי' והגיע לכאן."
        },
        {
          "s": 10,
          "text": "ולהעיר,"
        },
        {
          "s": 11,
          "text": "שבדרוש זה ישנם כמה ענינים שאינם בדרושים הנ\"ל]"
        },
        {
          "s": 12,
          "text": "בפירוש הכתוב38"
        },
        {
          "s": 13,
          "text": "חנוך לנער על פי דרכו גם כי יזקין לא יסור ממנה,"
        },
        {
          "s": 14,
          "text": "דלכאורה כשהאדם מזקין צריך להתעלות למדריגה נעלית יותר,"
        },
        {
          "s": 15,
          "text": "ומהי39"
        },
        {
          "s": 16,
          "text": "המעלה שגם כשיזקין לא יסור מהדרך שחינכו אותו כשהי' נער,"
        },
        {
          "s": 17,
          "text": "ומבאר בהמאמר,"
        },
        {
          "s": 18,
          "text": "דבשכל אנושי יש חילוק גדול ועצום בין השכל שהאדם משיג בנערותו להשכל שהוא משיג בגדלותו ומכש\"כ בזקנותו."
        },
        {
          "s": 19,
          "text": "אבל בהתורה שהיא אלקות,"
        },
        {
          "s": 20,
          "text": "החילוק שבין נערותו לזקנותו הוא רק בהשגת השכל של האדם שבה מלובשת התורה,"
        },
        {
          "s": 21,
          "text": "אבל בהתורה עצמה,"
        },
        {
          "s": 22,
          "text": "שהיא חכמתו של הקב\"ה שלמעלה משכל הנבראים,"
        },
        {
          "s": 23,
          "text": "אין חילוק בין שכל הנער לשכל הזקן,"
        },
        {
          "s": 24,
          "text": "ולכן גם כשיזקין לא יסור מן הדרך שלמדוהו בהיותו נער."
        },
        {
          "s": 25,
          "text": "ומוסיף בהמאמר,"
        },
        {
          "s": 26,
          "text": "דכתיב40"
        },
        {
          "s": 27,
          "text": "נער הייתי גם זקנתי,"
        },
        {
          "s": 28,
          "text": "נער הוא מט\"ט שביצירה וגם זקנתי הוא עלייתו באצילות,"
        },
        {
          "s": 29,
          "text": "דחכמת התורה שבאצילות היא נעלית הרבה יותר מחכמת התורה שביצירה."
        },
        {
          "s": 30,
          "text": "ואעפ\"כ,"
        },
        {
          "s": 31,
          "text": "גם כשיזקין ויתעלה באצילות לא יסור מהדרך שלמדוהו בהיותו נער ביצירה,"
        },
        {
          "s": 32,
          "text": "כי עצם התורה היא תענוג העצמי דהעצמות"
        },
        {
          "s": 33,
          "text": "(ואהי' אצלו גו' שעשועים41,"
        },
        {
          "s": 34,
          "text": "אצלו דוקא),"
        },
        {
          "s": 35,
          "text": "שלמעלה גם מחכמתו של הקב\"ה,"
        },
        {
          "s": 36,
          "text": "חכמה דאצילות."
        },
        {
          "s": 37,
          "text": "ובנוגע לענין זה שבתורה"
        },
        {
          "s": 38,
          "text": "(שהוא עיקר התורה)"
        },
        {
          "s": 39,
          "text": "אין חילוק בין ההשגה דיצירה"
        },
        {
          "s": 40,
          "text": "(וגם ההשגה דשכל אנושי)"
        },
        {
          "s": 41,
          "text": "לההשגה דאצילות."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יובן עוד יותר היתרון בההמשכה דתורה לגבי ההמשכה שע\"י תפלה."
        },
        {
          "s": 1,
          "text": "דההמשכה למטה שע\"י תפלה היא"
        },
        {
          "s": 2,
          "text": "(לא שהאלקות עצמו נמשך למטה,"
        },
        {
          "s": 3,
          "text": "אלא)"
        },
        {
          "s": 4,
          "text": "שע\"י ההמשכה נעשה שינוי בעניני העולם."
        },
        {
          "s": 5,
          "text": "וההמשכה דתורה,"
        },
        {
          "s": 6,
          "text": "היא המשכת אלקות,"
        },
        {
          "s": 7,
          "text": "שגם לאחרי ירידתה למטה היא חכמתו של הקב\"ה."
        },
        {
          "s": 8,
          "text": "ויתירה מזו,"
        },
        {
          "s": 9,
          "text": "שהאלקות שבתורה שנמשכת למטה ומתלבשת בשכלו של האדם הלומד,"
        },
        {
          "s": 10,
          "text": "אינה בגדר עלמין,"
        },
        {
          "s": 11,
          "text": "שלכן,"
        },
        {
          "s": 12,
          "text": "ההשגה דשכל אנושי וההשגה דאצילות הם בשוה ממש לגבה."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "דכמו שהיתרון בההמשכה דתורה לגבי ההמשכה דתפלה הוא בנוגע להמטה,"
        },
        {
          "s": 3,
          "text": "שנמשך בו גילוי אלקות,"
        },
        {
          "s": 4,
          "text": "עד\"ז הוא בהיתרון שבההמשכה שע\"י תפלה לגבי ההמשכה דתורה,"
        },
        {
          "s": 5,
          "text": "דנוסף לזה ששרש ההמשכה שע\"י תפלה הוא מלמעלה מהשתלשלות,"
        },
        {
          "s": 6,
          "text": "היתרון בההמשכה שע\"י תפלה הוא גם בנוגע להמטה,"
        },
        {
          "s": 7,
          "text": "שע\"י התפלה נעשה שינוי בהנבראים שלמטה,"
        },
        {
          "s": 8,
          "text": "לרפאות החולים ולברך השנים42."
        },
        {
          "s": 9,
          "text": "ולהוסיף,"
        },
        {
          "s": 10,
          "text": "דענין זה"
        },
        {
          "s": 11,
          "text": "[שע\"י תפלה נעשה שינוי למטה]"
        },
        {
          "s": 12,
          "text": "הוא בכל תפלה."
        },
        {
          "s": 13,
          "text": "והענין הוא,"
        },
        {
          "s": 14,
          "text": "דמבואר בדרוש הנ\"ל דהצ\"צ43,"
        },
        {
          "s": 15,
          "text": "דזה שאיתא בגמרא44"
        },
        {
          "s": 16,
          "text": "שבתפלת ציבור"
        },
        {
          "s": 17,
          "text": "(דוקא)"
        },
        {
          "s": 18,
          "text": "כתיב45"
        },
        {
          "s": 19,
          "text": "הן א-ל כביר לא46"
        },
        {
          "s": 20,
          "text": "ימאס,"
        },
        {
          "s": 21,
          "text": "שהיא רצוי' ומקובלת לעולם47,"
        },
        {
          "s": 22,
          "text": "הכוונה בזה היא,"
        },
        {
          "s": 23,
          "text": "דזה שהקב\"ה ממלא הבקשה דתפלת ציבור,"
        },
        {
          "s": 24,
          "text": "הוא גם בגילוי."
        },
        {
          "s": 25,
          "text": "והיינו,"
        },
        {
          "s": 26,
          "text": "שגם בתפלת יחיד,"
        },
        {
          "s": 27,
          "text": "הקב\"ה ממלא את בקשתו"
        },
        {
          "s": 28,
          "text": "[וכדמוכח מזה שאנשי כנה\"ג תיקנו להתפלל ג' פעמים בכל יום,"
        },
        {
          "s": 29,
          "text": "ובודאי שלא תיקנו שתהי' ח\"ו ברכה לבטלה]."
        },
        {
          "s": 30,
          "text": "אלא שבתפלת יחיד,"
        },
        {
          "s": 31,
          "text": "אפשר שההשפעה"
        },
        {
          "s": 32,
          "text": "(מילוי הבקשה)"
        },
        {
          "s": 33,
          "text": "תהי' בהעלם,"
        },
        {
          "s": 34,
          "text": "והמעלה דתפלת ציבור היא שההשפעה היא בגילוי."
        },
        {
          "s": 35,
          "text": "ולהעיר,"
        },
        {
          "s": 36,
          "text": "שבכמה דרושים48"
        },
        {
          "s": 37,
          "text": "מבואר שבתפלת יחיד אפשר שההשפעה תישאר למעלה ולא תומשך למטה,"
        },
        {
          "s": 38,
          "text": "ובדרוש הנ\"ל דהצ\"צ מבואר שההשפעה"
        },
        {
          "s": 39,
          "text": "(גם בתפלת יחיד)"
        },
        {
          "s": 40,
          "text": "נמשכת למטה,"
        },
        {
          "s": 41,
          "text": "אלא שאפשר שתהי' בהעלם."
        },
        {
          "s": 42,
          "text": "ויש לומר,"
        },
        {
          "s": 43,
          "text": "דכיון דהבקשה דתפלה היא שתושפע ההשפעה למטה"
        },
        {
          "s": 44,
          "text": "(לרפאות החולים ולברך השנים),"
        },
        {
          "s": 45,
          "text": "לכן,"
        },
        {
          "s": 46,
          "text": "גם כשממשיכים לו ההשפעה שביקש אבל ההשפעה אינה נמשכת למטה,"
        },
        {
          "s": 47,
          "text": "תפלתו היא ברכה לבטלה,"
        },
        {
          "s": 48,
          "text": "ומזה מוכח,"
        },
        {
          "s": 49,
          "text": "שבכל תפלה,"
        },
        {
          "s": 50,
          "text": "גם בתפלת יחיד נמשכת ההשפעה למטה אלא שאפשר שתהי' בהעלם."
        }
      ]
    }
  ]
}