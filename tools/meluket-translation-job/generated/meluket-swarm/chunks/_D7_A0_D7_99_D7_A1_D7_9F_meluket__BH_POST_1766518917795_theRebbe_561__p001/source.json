{
  "globalIndex": 681,
  "owner": 31,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917795_theRebbe_561__p001",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917795_theRebbe_561__p001",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917795_theRebbe_561",
  "title": "מאמר כי ישאלך בנך תשל\"ח",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "י\"א ניסן ה'תשל\"ח*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "כי ישאלך בנך מחר לאמר מה העדות והחוקים והמשפטים אשר צוה ה' אלקינו אתכם1,"
        },
        {
          "s": 1,
          "text": "– שאלה זו היא שאלת הבן חכם,"
        },
        {
          "s": 2,
          "text": "כמ\"ש בהגדה2"
        },
        {
          "s": 3,
          "text": "חכם מה הוא אומר מה העדות גו'."
        },
        {
          "s": 4,
          "text": "וידוע הדיוק בדרושי רבותינו נשיאינו3,"
        },
        {
          "s": 5,
          "text": "דמאחר שנקרא בשם חכם"
        },
        {
          "s": 6,
          "text": "[דאמיתית החכמה היא חכמת התורה4]"
        },
        {
          "s": 7,
          "text": "הרי הוא בודאי יודע את המצוות,"
        },
        {
          "s": 8,
          "text": "ומהי שאלתו מה העדות והחוקים והמשפטים גו'."
        },
        {
          "s": 9,
          "text": "ויש להוסיף,"
        },
        {
          "s": 10,
          "text": "דמהמשך הכתוב5"
        },
        {
          "s": 11,
          "text": "ואמרת לבנך גו' ויצונו הוי' לעשות את כל החוקים האלה גו' לטוב לנו גו' שמבארים המעלה שבקיום המצוות"
        },
        {
          "s": 12,
          "text": "(לטוב לנו גו'),"
        },
        {
          "s": 13,
          "text": "מובן6"
        },
        {
          "s": 14,
          "text": "שפירוש מה העדות גו' הוא מהו ענין המצוות"
        },
        {
          "s": 15,
          "text": "(איזו מעלה יש בהם),"
        },
        {
          "s": 16,
          "text": "וצריך ביאור,"
        },
        {
          "s": 17,
          "text": "איך שייך שבן חכם ישאל שאלה כזו."
        },
        {
          "s": 18,
          "text": "וביותר אינו מובן,"
        },
        {
          "s": 19,
          "text": "דבהביאור בענין המצוות"
        },
        {
          "s": 20,
          "text": "(בהתשובה דואמרת לבנך)"
        },
        {
          "s": 21,
          "text": "אומר שני ענינים."
        },
        {
          "s": 22,
          "text": "ויוציאנו הוי' ממצרים גו' ויצונו גו' לעשות את כל החוקים,"
        },
        {
          "s": 23,
          "text": "דכיון שהוציאנו ממצרים אנו משועבדים אליו לקיים מצותיו7."
        },
        {
          "s": 24,
          "text": "ועוד ענין בקיום המצוות8"
        },
        {
          "s": 25,
          "text": "שהם לטוב לנו כל הימים גו'9."
        },
        {
          "s": 26,
          "text": "ומזה שבהתשובה דואמרת לבנך מבאר שני הענינים,"
        },
        {
          "s": 27,
          "text": "מובן,"
        },
        {
          "s": 28,
          "text": "ששניהם הם חידוש אצל הבן."
        },
        {
          "s": 29,
          "text": "ואינו מובן,"
        },
        {
          "s": 30,
          "text": "דמאחר שאינו יודע ענין המצוות"
        },
        {
          "s": 31,
          "text": "(לא רק שאינו יודע שהמצוות הם לטוב לנו,"
        },
        {
          "s": 32,
          "text": "אלא שאינו מבין אפילו החיוב דקיום המצוות בדרך קבלת עול10),"
        },
        {
          "s": 33,
          "text": "איך קוראים אותו בתואר"
        },
        {
          "s": 34,
          "text": "(בן)"
        },
        {
          "s": 35,
          "text": "חכם."
        },
        {
          "s": 36,
          "text": "גם צריך להבין"
        },
        {
          "s": 37,
          "text": "(כמו שמדייק בהדרושים3)"
        },
        {
          "s": 38,
          "text": "מה שאומר אשר צוה הוי' אלקינו אתכם,"
        },
        {
          "s": 39,
          "text": "אתכם ולא אותנו."
        },
        {
          "s": 40,
          "text": "והגם דע\"י שאומר הוי' אלקינו אין מקום לטעות שמוציא ח\"ו את עצמו מהכלל11,"
        },
        {
          "s": 41,
          "text": "מ\"מ צריך ביאור מה שאומר אתכם12,"
        },
        {
          "s": 42,
          "text": "דהול\"ל אשר צוה הוי' אלקינו אותנו,"
        },
        {
          "s": 43,
          "text": "או אשר צוה הוי' אלקינו ותו לא13."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ונקודת הביאור בזה בהדרושים14,"
        },
        {
          "s": 1,
          "text": "ע\"פ הידוע15"
        },
        {
          "s": 2,
          "text": "דקיום המצוות של האבות הי'"
        },
        {
          "s": 3,
          "text": "(בעיקר)"
        },
        {
          "s": 4,
          "text": "עבודה רוחנית,"
        },
        {
          "s": 5,
          "text": "והפעולה שעשו בגשמיות היתה כעין כלי להעבודה הרוחנית."
        },
        {
          "s": 6,
          "text": "והמצוות שניתנו במתן תורה,"
        },
        {
          "s": 7,
          "text": "עיקרם הוא העשי' בפועל."
        },
        {
          "s": 8,
          "text": "דעשיית המצוה היא לא הכנה וכלי לכוונתה,"
        },
        {
          "s": 9,
          "text": "אלא אדרבה,"
        },
        {
          "s": 10,
          "text": "העשי' היא העיקר."
        },
        {
          "s": 11,
          "text": "וכמו בנדו\"ד מצות אכילת מצה,"
        },
        {
          "s": 12,
          "text": "דכאשר יכוון בסוד מצות מצה וח\"ו יחסר הפועל ממש,"
        },
        {
          "s": 13,
          "text": "לא ימשיך מאומה,"
        },
        {
          "s": 14,
          "text": "ולאידך,"
        },
        {
          "s": 15,
          "text": "כשיקיים המצוה בפועל,"
        },
        {
          "s": 16,
          "text": "גם בלי כוונה16,"
        },
        {
          "s": 17,
          "text": "ימשיך האור."
        },
        {
          "s": 18,
          "text": "ושאלת הבן חכם היא איך ממשיכים גילוי אוא\"ס ע\"י מעשה"
        },
        {
          "s": 19,
          "text": "(המצוות)."
        },
        {
          "s": 20,
          "text": "וזהו שאומר מה העדות גו' אשר צוה הוי' אלקינו אתכם,"
        },
        {
          "s": 21,
          "text": "אתכם דוקא,"
        },
        {
          "s": 22,
          "text": "דכיון שהעבודה שלכם"
        },
        {
          "s": 23,
          "text": "(לאחרי מ\"ת)"
        },
        {
          "s": 24,
          "text": "היא עשי'"
        },
        {
          "s": 25,
          "text": "(ולא עבודה רוחנית כעבודת האבות),"
        },
        {
          "s": 26,
          "text": "איך נמשך גילוי אוא\"ס ע\"י עבודה זו."
        },
        {
          "s": 27,
          "text": "והתשובה"
        },
        {
          "s": 28,
          "text": "(ואמרת לבנך)"
        },
        {
          "s": 29,
          "text": "עבדים היינו לפרעה במצרים ויוציאנו הוי' ממצרים גו' ויצונו הוי' לעשות את כל החוקים האלה גו' היא,"
        },
        {
          "s": 30,
          "text": "דגלות מצרים ויציאת מצרים היו הכנה למתן תורה,"
        },
        {
          "s": 31,
          "text": "ובמתן תורה ניתן הכח שע\"י מצוות מעשיות"
        },
        {
          "s": 32,
          "text": "(לעשות את כל החוקים גו',"
        },
        {
          "s": 33,
          "text": "לעשות דייקא17)"
        },
        {
          "s": 34,
          "text": "ימשיכו המשכות למעלה יותר מההמשכות שהמשיכו האבות ע\"י עבודה רוחנית שלהם,"
        },
        {
          "s": 35,
          "text": "ועד להמשכת העצמות."
        }
      ]
    }
  ]
}