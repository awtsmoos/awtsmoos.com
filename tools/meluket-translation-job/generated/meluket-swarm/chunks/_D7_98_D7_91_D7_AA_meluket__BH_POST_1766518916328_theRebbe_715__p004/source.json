{
  "globalIndex": 448,
  "owner": 48,
  "jobId": "_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916328_theRebbe_715__p004",
  "batchId": "meluket-_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916328_theRebbe_715__p004",
  "seriesId": "טבת_meluket",
  "postId": "BH_POST_1766518916328_theRebbe_715",
  "title": "מאמר וארא אל אברהם תשל\"ה",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דזהו מ\"ש בהמאמר"
        },
        {
          "s": 2,
          "text": "(הובא לעיל סעיף ב)"
        },
        {
          "s": 3,
          "text": "שהגילוי דשם שדי שהי' לאברהם הוא גילוי חדש שלא הי' לפנ\"ז גם בהעלם25,"
        },
        {
          "s": 4,
          "text": "כי בריאת העולם במדה וגבול היא ע\"י שהאור נתלבש בכלים שמגבילים את התפשטות האור,"
        },
        {
          "s": 5,
          "text": "וזה שדי באלקותי לכל ברי'"
        },
        {
          "s": 6,
          "text": "(שההתפשטות שלו היא בלי גבול)"
        },
        {
          "s": 7,
          "text": "הוא ע\"י גילוי אור הבל\"ג שלמעלה מהתלבשות בכלים."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה מזה ששני הענינים – שאמרתי לעולמי די ושדי באלקותי לכל ברי' – הם באותו השם"
        },
        {
          "s": 2,
          "text": "(שדי),"
        },
        {
          "s": 3,
          "text": "מובן26,"
        },
        {
          "s": 4,
          "text": "שהם שייכים זל\"ז."
        },
        {
          "s": 5,
          "text": "כי זה שענין די באלקותי לכל ברי' הוא ע\"י גילוי אור הבל\"ג שלמעלה מהתלבשות בכלים,"
        },
        {
          "s": 6,
          "text": "הוא"
        },
        {
          "s": 7,
          "text": "[לא שמתגלה האור עצמו כמו שהוא במקומו,"
        },
        {
          "s": 8,
          "text": "למעלה מכלים,"
        },
        {
          "s": 9,
          "text": "כי אז היתה מתבטלת המדידה וההגבלה דהעולם,"
        },
        {
          "s": 10,
          "text": "אלא],"
        },
        {
          "s": 11,
          "text": "דהגם שהאור נתלבש בכלים,"
        },
        {
          "s": 12,
          "text": "שעי\"ז נעשה הגבלה בההתפשטות שלו בנוגע לההתהוות,"
        },
        {
          "s": 13,
          "text": "שאמרתי לעולמי די,"
        },
        {
          "s": 14,
          "text": "אעפ\"כ,"
        },
        {
          "s": 15,
          "text": "בנוגע לגילוי אלקות,"
        },
        {
          "s": 16,
          "text": "תהי' ההתפשטות שלו בלי גבול"
        },
        {
          "s": 17,
          "text": "(כמו שהוא מצד עצמו,"
        },
        {
          "s": 18,
          "text": "למעלה מהתלבשות בכלים),"
        },
        {
          "s": 19,
          "text": "די באלקותי לכל ברי'."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ולהוסיף,"
        },
        {
          "s": 1,
          "text": "דזה שגילוי האור שלמעלה מהכלים הוא באופן שהגילוי דהאור המתלבש הוא די לכל ברי',"
        },
        {
          "s": 2,
          "text": "הוא,"
        },
        {
          "s": 3,
          "text": "לפי שגם האור עצמו שלמעלה מהכלים"
        },
        {
          "s": 4,
          "text": "(דשם שדי)"
        },
        {
          "s": 5,
          "text": "הוא אור השייך לעולמות,"
        },
        {
          "s": 6,
          "text": "שדי באלקותי לכל ברי'."
        },
        {
          "s": 7,
          "text": "וכמבואר בהדרושים27,"
        },
        {
          "s": 8,
          "text": "דשם שדי על שם שדי באלקותי לכל ברי' הוא במקור ההשתלשלות,"
        },
        {
          "s": 9,
          "text": "דבענין הספירות הוא חיצוניות הכתר שהוא שרש הנאצלים,"
        },
        {
          "s": 10,
          "text": "ובאוא\"ס שלפני הצמצום הוא האור ששיער בעצמו להאיר במדה וגבול."
        },
        {
          "s": 11,
          "text": "ולכן,"
        },
        {
          "s": 12,
          "text": "לאחרי שנמשכה ממנו הארה שהיא מקור ממש להוות את הנבראים"
        },
        {
          "s": 13,
          "text": "(אור המתלבש בכלים),"
        },
        {
          "s": 14,
          "text": "גילוי אור זה"
        },
        {
          "s": 15,
          "text": "(שלמעלה מהשתלשלות אבל שייך להשתלשלות)"
        },
        {
          "s": 16,
          "text": "אינו שולל את ההארה אלא אדרבה,"
        },
        {
          "s": 17,
          "text": "הוא מאיר בה"
        },
        {
          "s": 18,
          "text": "[ועל ידה – בהנבראים שנתהוו ממנה]"
        },
        {
          "s": 19,
          "text": "ופועל בה עילוי."
        }
      ]
    }
  ]
}