{
  "globalIndex": 813,
  "owner": 13,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918633_theRebbe_459__p003",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918633_theRebbe_459__p003",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918633_theRebbe_459",
  "title": "מאמר בחודש השלישי תשכ\"ט",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וזהו ביום הזה באו מדבר סיני,"
        },
        {
          "s": 2,
          "text": "ומבאר בתו\"א,"
        },
        {
          "s": 3,
          "text": "דמדבר הוא מלשון דיבור,"
        },
        {
          "s": 4,
          "text": "ונקרא מדבר בתוספת מ'"
        },
        {
          "s": 5,
          "text": "(דמ' הוא מאותיות האמנתי\"ו שמורים על הקטנת הענין26)"
        },
        {
          "s": 6,
          "text": "להורות שהדיבור הוא בביטול."
        },
        {
          "s": 7,
          "text": "[וענין זה שייך גם למדבר כפשוטו,"
        },
        {
          "s": 8,
          "text": "ארץ לא זרועה27,"
        },
        {
          "s": 9,
          "text": "דכשהדיבור הוא ע\"פ שכלו ורצונו,"
        },
        {
          "s": 10,
          "text": "השכל והרצון הם הזריעה שעי\"ז הוא צמיחת הדיבור."
        },
        {
          "s": 11,
          "text": "וענין מדבר ארץ לא זרועה הוא שהדיבור דתורה שמדַבר הוא דבר ה' ואינו זרוע משכלו ורצונו28]."
        },
        {
          "s": 12,
          "text": "וסיני הוא שירדה שנאה לאומות העולם29,"
        },
        {
          "s": 13,
          "text": "והוא שהתורה נקראת תושי'30"
        },
        {
          "s": 14,
          "text": "לפי שמתשת כח הסט\"א."
        },
        {
          "s": 15,
          "text": "ויש לומר,"
        },
        {
          "s": 16,
          "text": "דזה שביום הזה באו מדבר הוא לפי שביום הזה"
        },
        {
          "s": 17,
          "text": "(ר\"ח)"
        },
        {
          "s": 18,
          "text": "הלבנה"
        },
        {
          "s": 19,
          "text": "[וכן ישראל שמונין ללבנה]"
        },
        {
          "s": 20,
          "text": "היא נקודה בלבד,"
        },
        {
          "s": 21,
          "text": "וזה שביום הזה באו סיני שירדה שנאה ליצה\"ר31"
        },
        {
          "s": 22,
          "text": "הוא לפי שביום הזה"
        },
        {
          "s": 23,
          "text": "(ר\"ח סיון)"
        },
        {
          "s": 24,
          "text": "נשלם הבירור של עיקרי המדות דנפש הבהמית."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "וצריך להבין,"
        },
        {
          "s": 2,
          "text": "דלפי הנ\"ל,"
        },
        {
          "s": 3,
          "text": "זה שבר\"ח סיון נשלמו עיקרי המדות הוא ביאור בשלימות האדם,"
        },
        {
          "s": 4,
          "text": "ובהדרוש שבתו\"א מקשר זה עם זה שבר\"ח הוא מולד הלבנה,"
        },
        {
          "s": 5,
          "text": "ענין הביטול."
        },
        {
          "s": 6,
          "text": "וי\"ל הביאור בזה,"
        },
        {
          "s": 7,
          "text": "דענין מולד הלבנה הוא"
        },
        {
          "s": 8,
          "text": "(לא הביטול שלה,"
        },
        {
          "s": 9,
          "text": "אלא אדרבה32)"
        },
        {
          "s": 10,
          "text": "שנולד מציאותה,"
        },
        {
          "s": 11,
          "text": "ע\"י שנמשך בה אור השמש."
        },
        {
          "s": 12,
          "text": "וזה שבעת המולד היא רק נקודה בלבד,"
        },
        {
          "s": 13,
          "text": "שזה מורה על הביטול שלה"
        },
        {
          "s": 14,
          "text": "(כנ\"ל),"
        },
        {
          "s": 15,
          "text": "הוא,"
        },
        {
          "s": 16,
          "text": "שהמציאות דהלבנה,"
        },
        {
          "s": 17,
          "text": "האור שלה,"
        },
        {
          "s": 18,
          "text": "היא בבחינת ביטול,"
        },
        {
          "s": 19,
          "text": "שנרגש בה שהאור שבה הוא לא משל עצמה ורק שמקבלת מהשמש."
        },
        {
          "s": 20,
          "text": "ועד\"ז הוא בישראל שמונין ללבנה,"
        },
        {
          "s": 21,
          "text": "דענין הביטול דר\"ח בעבודת האדם הוא שהמציאות שלו היא בביטול."
        },
        {
          "s": 22,
          "text": "[ויש לומר דזהו שמבואר בתו\"א דזה שר\"ח נקרא יום הזה"
        },
        {
          "s": 23,
          "text": "(סתם)"
        },
        {
          "s": 24,
          "text": "הוא כי יום הזה הוא אהבה שבבחינת ביטול"
        },
        {
          "s": 25,
          "text": "[דיום הוא אור כמ\"ש33"
        },
        {
          "s": 26,
          "text": "ויקרא אלקים לאור יום ואהבה היא אור,"
        },
        {
          "s": 27,
          "text": "וזה הוא יחו\"ע"
        },
        {
          "s": 28,
          "text": "(שלכן משה רבינו נתנבא בזה34),"
        },
        {
          "s": 29,
          "text": "ויום הזה הוא אהבה שבבחינת ביטול דיחו\"ע],"
        },
        {
          "s": 30,
          "text": "כי מהטעמים על זה שאהבה נק' בשם אור,"
        },
        {
          "s": 31,
          "text": "הוא,"
        },
        {
          "s": 32,
          "text": "לפי שאהבה היא התפשטות35"
        },
        {
          "s": 33,
          "text": "[ולכן היראה שהיא כיווץ"
        },
        {
          "s": 34,
          "text": "(היפך ההתפשטות)"
        },
        {
          "s": 35,
          "text": "נקראת בשם חושך36],"
        },
        {
          "s": 36,
          "text": "והביטול דר\"ח הוא לא באופן שמתבטל ממציאותו"
        },
        {
          "s": 37,
          "text": "(דוגמת הביטול דיראה),"
        },
        {
          "s": 38,
          "text": "כי אם,"
        },
        {
          "s": 39,
          "text": "שההתפשטות"
        },
        {
          "s": 40,
          "text": "(המציאות)"
        },
        {
          "s": 41,
          "text": "שלו היא בביטול]."
        },
        {
          "s": 42,
          "text": "ועפ\"ז יש לבאר הקשר דשני הענינים שבר\"ח סיון"
        },
        {
          "s": 43,
          "text": "(ביטול הלבנה והשלמת עיקרי המדות),"
        },
        {
          "s": 44,
          "text": "כי ענין מולד הלבנה הוא שהמציאות הוא בביטול."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יש לבאר מה שהקשו התוספות דהוה לי' למילף מדבר ממדבר,"
        },
        {
          "s": 2,
          "text": "כי זה שבר\"ח סיון באו לבחינת מדבר הוא ביטול נעלה יותר מזה שר\"ח נק' יום הזה."
        },
        {
          "s": 3,
          "text": "דענין יום הזה הוא שהוא במציאות"
        },
        {
          "s": 4,
          "text": "(ועד למציאות דהתפשטות,"
        },
        {
          "s": 5,
          "text": "יום)"
        },
        {
          "s": 6,
          "text": "אלא שהמציאות שלו היא בביטול"
        },
        {
          "s": 7,
          "text": "(הזה),"
        },
        {
          "s": 8,
          "text": "משא\"כ זה שבר\"ח סיון באו לבחינת מדבר"
        },
        {
          "s": 9,
          "text": "[שהדיבור שלו אינו דיבור עצמו כלל,"
        },
        {
          "s": 10,
          "text": "ופה האדם הוא רק כלי לדבר הוי' המדַבר על ידו,"
        },
        {
          "s": 11,
          "text": "וע\"ד דבר ה' בפי הנביא37]"
        },
        {
          "s": 12,
          "text": "הוא ביטול המציאות."
        },
        {
          "s": 13,
          "text": "וכיון שעיקר המעלה דר\"ח סיון הוא שבו באו להביטול דמדבר,"
        },
        {
          "s": 14,
          "text": "לכן מקום לומר שהרמז בכתוב"
        },
        {
          "s": 15,
          "text": "(שזה הי' בר\"ח סיון)"
        },
        {
          "s": 16,
          "text": "הוא בתיבת מדבר38."
        },
        {
          "s": 17,
          "text": "וזה שהלימוד בגמרא הוא מביום הזה,"
        },
        {
          "s": 18,
          "text": "הוא,"
        },
        {
          "s": 19,
          "text": "כי הענין דיום הזה שבר\"ח סיון הוא נעלה יותר גם מהביטול דמדבר,"
        },
        {
          "s": 20,
          "text": "כדלקמן."
        }
      ]
    }
  ]
}