{
  "globalIndex": 87,
  "owner": 37,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914186_theRebbe_341__p005",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914186_theRebbe_341__p005",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914186_theRebbe_341",
  "title": "מאמר בסוכות תשבו תשל\"ו",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "וזהו61 מה שיו\"ט ראשון של חג שחל להיות בשבת אין לולב דוחה שבת,"
        },
        {
          "s": 3,
          "text": "כי נטילת לולב הוא בכדי להמשיך בחי' המקיף"
        },
        {
          "s": 4,
          "text": "(דסוכה)"
        },
        {
          "s": 5,
          "text": "בפנימיות לכן בשבת שאז מאיר המקיף בבחי' פנימיות"
        },
        {
          "s": 6,
          "text": "(מצד ענין השבת),"
        },
        {
          "s": 7,
          "text": "אין צריך"
        },
        {
          "s": 8,
          "text": "(כ\"כ)"
        },
        {
          "s": 9,
          "text": "לנטילת לולב,"
        },
        {
          "s": 10,
          "text": "ולכן מספיקה הגזירה דרבה לדחות נטילת לולב."
        },
        {
          "s": 11,
          "text": "ומה שבזמן ביהמ\"ק היו נוטלין גם בשבת,"
        },
        {
          "s": 12,
          "text": "הוא לפי שיש כמה מדריגות במקיפים,"
        },
        {
          "s": 13,
          "text": "וע\"י נטילת לולב בזמן הבית המשיכו בחי' מקיף עליון יותר מבחי' המקיף שנמשך בשבת מצד עצמו"
        },
        {
          "s": 14,
          "text": "(מה ששבת מיקדשא וקיימא68)"
        },
        {
          "s": 15,
          "text": "וגם בחוץ לארץ"
        },
        {
          "s": 16,
          "text": "(בזמן הבית)."
        },
        {
          "s": 17,
          "text": "משא\"כ בזמן הגלות,"
        },
        {
          "s": 18,
          "text": "גם ע\"י נטילת לולב א\"א להמשיך בחי' מקיף העליון,"
        },
        {
          "s": 19,
          "text": "ומה שממשיכים עכשיו הוא רק בחי' המקיף שנמשך ע\"י השבת."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "והנה כאמור לעיל,"
        },
        {
          "s": 1,
          "text": "בסוכות תשבו,"
        },
        {
          "s": 2,
          "text": "המשכת המקיף דסוכה,"
        },
        {
          "s": 3,
          "text": "היא הכנה קרובה לכל האזרח בישראל שיזרח לע\"ל,"
        },
        {
          "s": 4,
          "text": "גילוי בחי' אמיתית המקיף,"
        },
        {
          "s": 5,
          "text": "בחי' פנימיות עתיק."
        },
        {
          "s": 6,
          "text": "שזהו החידוש בהגילוי דלע\"ל,"
        },
        {
          "s": 7,
          "text": "שעכשיו כל הגילויים הם רק מבחי' חיצוניות עתיק ולע\"ל יהי' גילוי בחי' פנימיות עתיק69."
        },
        {
          "s": 8,
          "text": "וזהו מ\"ש70"
        },
        {
          "s": 9,
          "text": "ישקני מנשיקות פיהו שילמדו תורתו של משיח מפיו של משיח,"
        },
        {
          "s": 10,
          "text": "שענינו הוא בחי' פנימיות עתיק"
        },
        {
          "s": 11,
          "text": "[דזהו מה שמשיח הוא למעלה גם מאדה\"ר,"
        },
        {
          "s": 12,
          "text": "וכמ\"ש71"
        },
        {
          "s": 13,
          "text": "ירום ונשא וגבה מאד,"
        },
        {
          "s": 14,
          "text": "מאד אותיות אדם אבל בצירוף המורה על בל\"ג,"
        },
        {
          "s": 15,
          "text": "שלמעלה גם מאדה\"ר72]."
        },
        {
          "s": 16,
          "text": "וזהו בסוכות תשבו גו' כל האזרח גו',"
        },
        {
          "s": 17,
          "text": "שהמשכת המקיף דסוכה היא הכנה קרובה להגילויים דגאולה העתידה ע\"י משיח צדקנו יבוא ויגאלנו ויוליכנו קוממיות לארצנו,"
        },
        {
          "s": 18,
          "text": "ושם נעשה לפניך את קרבנות חובותינו כמצות רצונך,"
        },
        {
          "s": 19,
          "text": "בקרוב ממש."
        }
      ]
    }
  ]
}