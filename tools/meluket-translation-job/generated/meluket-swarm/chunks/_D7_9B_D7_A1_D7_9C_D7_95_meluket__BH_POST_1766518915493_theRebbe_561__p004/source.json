{
  "globalIndex": 302,
  "owner": 2,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915493_theRebbe_561__p004",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915493_theRebbe_561__p004",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915493_theRebbe_561",
  "title": "מאמר וכל בניך תשמ\"א",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ויש להוסיף,"
        },
        {
          "s": 2,
          "text": "דההוראה מסדר הבירורים דיעקב"
        },
        {
          "s": 3,
          "text": "(ג\"ר לפני ז\"ת)"
        },
        {
          "s": 4,
          "text": "היא גם בנוגע להסדר דנגלה ופנימיות התורה."
        },
        {
          "s": 5,
          "text": "דהגם שהתחלת הלימוד הוא בנגלה דתורה,"
        },
        {
          "s": 6,
          "text": "ובאופן דיגיעה,"
        },
        {
          "s": 7,
          "text": "ואח\"כ הוא הלימוד בפנימיות התורה,"
        },
        {
          "s": 8,
          "text": "וכמ\"ש הרח\"ו54"
        },
        {
          "s": 9,
          "text": "שעסק ההלכה דהאריז\"ל הי' ביגיעה עד שהי' מזיע זיעה גדולה כדי לשבר הקליפה,"
        },
        {
          "s": 10,
          "text": "ומרוב גודל חריפותו הי' מעיין ו' דרכים בהלכה,"
        },
        {
          "s": 11,
          "text": "ורק לאח\"ז הי' מעיין ע\"ד הסוד,"
        },
        {
          "s": 12,
          "text": "אעפ\"כ,"
        },
        {
          "s": 13,
          "text": "ידיעת הענינים היסודיים דפנימיות התורה באופן של הנחה פשוטה שלמעלה מהבנה צ\"ל עוד לפני הלימוד בנגלה דתורה,"
        },
        {
          "s": 14,
          "text": "שעי\"ז,"
        },
        {
          "s": 15,
          "text": "גם לימוד הנגלה"
        },
        {
          "s": 16,
          "text": "(והבירור שעל ידו)"
        },
        {
          "s": 17,
          "text": "הוא באופן נעלה יותר."
        },
        {
          "s": 18,
          "text": "והענין הוא,"
        },
        {
          "s": 19,
          "text": "דנגלה דתורה הוא בכלל בהגבלה55,"
        },
        {
          "s": 20,
          "text": "ופנימיות התורה הוא בל\"ג,"
        },
        {
          "s": 21,
          "text": "וע\"י ידיעת הענינים דפנימיות התורה באופן של הנחה פשוטה כנ\"ל,"
        },
        {
          "s": 22,
          "text": "ועאכו\"כ ע\"י הלימוד דפנימיות התורה בהבנה והשגה,"
        },
        {
          "s": 23,
          "text": "ובפרט כשהלימוד גופא הוא באופן דכי ירחיב56,"
        },
        {
          "s": 24,
          "text": "למעלה ממדידה והגבלה"
        },
        {
          "s": 25,
          "text": "[ובפשטות,"
        },
        {
          "s": 26,
          "text": "שאינו מתחשב עם הזמן,"
        },
        {
          "s": 27,
          "text": "אם הוא עדיין באמצע זמן הסדר או שזה כבר לאחרי הסדר],"
        },
        {
          "s": 28,
          "text": "הנה עי\"ז גם לימוד הנגלה הוא באופן שלמעלה ממדידה והגבלה,"
        },
        {
          "s": 29,
          "text": "וגם הבירור שע\"י לימוד הנגלה,"
        },
        {
          "s": 30,
          "text": "עם היותו בירור בדרך התלבשות,"
        },
        {
          "s": 31,
          "text": "הוא באופן נעלה יותר."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "והנה הגם דזה מה שע\"י לימוד פנימיות התורה נעשה יתרון בלימוד הנגלה ובהבירור שעי\"ז הוא לכאורה ענין של ירידה לגבי הלימוד דפנימיות התורה כמו שהוא מצד עצמו,"
        },
        {
          "s": 3,
          "text": "אעפ\"כ,"
        },
        {
          "s": 4,
          "text": "מכיון שהשלימות דדירה בתחתונים הוא שהתחתון מצד עצמו יהי' כלי לאלקות,"
        },
        {
          "s": 5,
          "text": "דענין זה הוא דוקא ע\"י הבירור שבדרך התלבשות"
        },
        {
          "s": 6,
          "text": "(כנ\"ל סעיף ה),"
        },
        {
          "s": 7,
          "text": "יש לומר,"
        },
        {
          "s": 8,
          "text": "דע\"י ההמשכה דפנימיות התורה לנגלה דתורה,"
        },
        {
          "s": 9,
          "text": "שעל ידה נעשה יתרון בלימוד הנגלה ובהבירור שע\"י לימוד הנגלה,"
        },
        {
          "s": 10,
          "text": "היא מתעלית למעלה יותר מכמו שהיתה מצד עצמה."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "וזהו וכל בניך לימודי הוי' ורב שלום בניך,"
        },
        {
          "s": 3,
          "text": "דכל בניך לימודי הוי',"
        },
        {
          "s": 4,
          "text": "דאלפין באורייתא דהוי',"
        },
        {
          "s": 5,
          "text": "הוא מעלת לימוד התורה,"
        },
        {
          "s": 6,
          "text": "ובפרט פנימיות התורה"
        },
        {
          "s": 7,
          "text": "(אורייתא דהוי'),"
        },
        {
          "s": 8,
          "text": "כמו שהיא מצד עצמה,"
        },
        {
          "s": 9,
          "text": "ורב שלום בניך א\"ת בניך אלא בוניך הו\"ע הבירור בעולם שע\"י עסק התורה."
        },
        {
          "s": 10,
          "text": "וכיון שעי\"ז"
        },
        {
          "s": 11,
          "text": "(הבירור שע\"י עסק התורה)"
        },
        {
          "s": 12,
          "text": "נעשה עליית התורה מכמו שהיא מצד עצמה,"
        },
        {
          "s": 13,
          "text": "לכן מבאר ומסיים בהמאמר,"
        },
        {
          "s": 14,
          "text": "שע\"י הענין דבוניך,"
        },
        {
          "s": 15,
          "text": "בנאים העוסקים בבנינו של עולם,"
        },
        {
          "s": 16,
          "text": "יקויים גם בהם"
        },
        {
          "s": 17,
          "text": "(בהתלמידי חכמים עצמם)"
        },
        {
          "s": 18,
          "text": "ורב שלום בניך."
        }
      ]
    }
  ]
}