{
  "globalIndex": 1097,
  "owner": 47,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920368_theRebbe_469__p005",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920368_theRebbe_469__p005",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920368_theRebbe_469",
  "title": "מאמר השקיפה ממעון קדשך תשכ\"ז",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "והנה לאחרי שמבאר בהמאמר שבחי ירושלים גו' כי חזק בריחי שעריך גו',"
        },
        {
          "s": 2,
          "text": "מבאר בהמאמר הפסוק51"
        },
        {
          "s": 3,
          "text": "השם גבולך שלום גו' ושייכותו לכי חזק בריחי שעריך,"
        },
        {
          "s": 4,
          "text": "ולאח\"ז מבאר הפסוק52"
        },
        {
          "s": 5,
          "text": "הנותן שלג כצמר גו'."
        },
        {
          "s": 6,
          "text": "ומבאר53,"
        },
        {
          "s": 7,
          "text": "דשלג הוא בחינת לבושי' כתלג חיוור54,"
        },
        {
          "s": 8,
          "text": "וצמר הוא בחינת שער רישי' כעמר נקא55."
        },
        {
          "s": 9,
          "text": "וזהו55"
        },
        {
          "s": 10,
          "text": "מ\"ש56"
        },
        {
          "s": 11,
          "text": "אם יהיו חטאיכם כשנים כשלג ילבינו אם יאדימו כתולע כצמר יהיו,"
        },
        {
          "s": 12,
          "text": "שני הוא חוט לבן אלא שנצבע בצבע אדום,"
        },
        {
          "s": 13,
          "text": "היינו שהפגם הוא רק בהלבושים,"
        },
        {
          "s": 14,
          "text": "והתיקון דפגם זה הוא ע\"י בחינת לבושי' כתלג חיוור,"
        },
        {
          "s": 15,
          "text": "ותולע הוא אדום בעצם,"
        },
        {
          "s": 16,
          "text": "היינו שהפגם הגיע בעצם הנפש,"
        },
        {
          "s": 17,
          "text": "ובכדי לתקן פגם זה הוא ע\"י בחינת צמר,"
        },
        {
          "s": 18,
          "text": "שער רישי' כעמר נקא,"
        },
        {
          "s": 19,
          "text": "דשער רישי' הם המשכות מעצם הנפש57,"
        },
        {
          "s": 20,
          "text": "כמו שרואים,"
        },
        {
          "s": 21,
          "text": "שכשמושכין אדם בשערות ראשו נמשך כל הגוף."
        },
        {
          "s": 22,
          "text": "וענין הנותן שלג כצמר הוא שגם בשלג שהוא לבוש יומשך בחינת צמר,"
        },
        {
          "s": 23,
          "text": "עצם."
        },
        {
          "s": 24,
          "text": "והחיבור דצמר ושלג הוא ע\"י המשכה ממקום שלמעלה משניהם."
        },
        {
          "s": 25,
          "text": "ולאחרי שמבאר בהמאמר ענין הנותן שלג כצמר,"
        },
        {
          "s": 26,
          "text": "מבאר עוד פעם"
        },
        {
          "s": 27,
          "text": "(בשינוי קצת)"
        },
        {
          "s": 28,
          "text": "ענין שופטים ושוטרים תתן לך בכל שעריך,"
        },
        {
          "s": 29,
          "text": "ושעי\"ז נעשה כי חזק בריחי שעריך."
        },
        {
          "s": 30,
          "text": "וצריך להבין השייכות דהנותן שלג כצמר לכי חזק בריחי שעריך."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים,"
        },
        {
          "s": 2,
          "text": "דשלג וצמר,"
        },
        {
          "s": 3,
          "text": "יש יתרון בכל אחד מהם."
        },
        {
          "s": 4,
          "text": "והענין הוא,"
        },
        {
          "s": 5,
          "text": "דלבושי' כתלג חיוור"
        },
        {
          "s": 6,
          "text": "(שלג)"
        },
        {
          "s": 7,
          "text": "הוא י\"ג תיקוני דיקנא ששרשם הוא במוחא סתימאה דאריך שבו מלובש גבורה דעתיק,"
        },
        {
          "s": 8,
          "text": "ושער רישי' כעמר נקא"
        },
        {
          "s": 9,
          "text": "(צמר)"
        },
        {
          "s": 10,
          "text": "הם בגלגלתא דאריך שבו מלובש חסד דעתיק58."
        },
        {
          "s": 11,
          "text": "ומבואר בסידור59,"
        },
        {
          "s": 12,
          "text": "דענין הגבורות שבי\"ג תיקוני דיקנא הוא כי הם באים להמתיק הדינים ואין הדינים נמתקים אלא בשרשם60,"
        },
        {
          "s": 13,
          "text": "ושערות הראש,"
        },
        {
          "s": 14,
          "text": "שאין באים להמתיק דינים"
        },
        {
          "s": 15,
          "text": "(שהרי הם למעלה מיגמה\"ר),"
        },
        {
          "s": 16,
          "text": "הם בחינת חסד."
        },
        {
          "s": 17,
          "text": "ומזה מובן,"
        },
        {
          "s": 18,
          "text": "שהמתקת הדינים שע\"י הי\"ג תיקוני דיקנא,"
        },
        {
          "s": 19,
          "text": "כיון שהם באים להמתיק את הדינים,"
        },
        {
          "s": 20,
          "text": "לכן ההמתקה שייכת להמטה"
        },
        {
          "s": 21,
          "text": "(לאלה שנתעורר דינים עליהם),"
        },
        {
          "s": 22,
          "text": "וההמתקה שע\"י שער רישי',"
        },
        {
          "s": 23,
          "text": "שהם למעלה מענין המתקת הדינים,"
        },
        {
          "s": 24,
          "text": "הוא מצד החסדים שבהם,"
        },
        {
          "s": 25,
          "text": "גילוי מלמעלה."
        },
        {
          "s": 26,
          "text": "וזהו שי\"ג תיקוני דיקנא הם רחמים"
        },
        {
          "s": 27,
          "text": "(י\"ג מדות הרחמים)"
        },
        {
          "s": 28,
          "text": "ושער רישי' הם חסד61,"
        },
        {
          "s": 29,
          "text": "דרחמים הם"
        },
        {
          "s": 30,
          "text": "(בדרך כלל)"
        },
        {
          "s": 31,
          "text": "מזה שמרגיש את צערו של הזולת62,"
        },
        {
          "s": 32,
          "text": "והחסד הוא מצד עצמו63."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "והנה מהמבואר בהמאמר"
        },
        {
          "s": 1,
          "text": "(הובא לעיל סעיף ח)"
        },
        {
          "s": 2,
          "text": "דתיקון הפגמים שע\"י הגילוי דשער רישי' הוא בדוגמת שכשמושכין אדם בשערות ראשו נמשך כל הגוף,"
        },
        {
          "s": 3,
          "text": "מוכח,"
        },
        {
          "s": 4,
          "text": "דבחינת שער רישי' שלמעלה הוא העצם דישראל"
        },
        {
          "s": 5,
          "text": "[דכיון ששער רישי' הוא העצמיות דלמעלה שלמעלה מבחינת לבושי',"
        },
        {
          "s": 6,
          "text": "הרי זהו גם העצמיות דישראל,"
        },
        {
          "s": 7,
          "text": "כי ישראל וקוב\"ה כולא חד]."
        },
        {
          "s": 8,
          "text": "ועפ\"ז צריך לומר,"
        },
        {
          "s": 9,
          "text": "דהמובא לעיל ששער רישי' הם חסד"
        },
        {
          "s": 10,
          "text": "(והמתקת הדינים הוא על ידי גילוי מלמעלה)"
        },
        {
          "s": 11,
          "text": "הוא בנוגע לכחות הגלויים דהנשמה,"
        },
        {
          "s": 12,
          "text": "שעל ידם הוא תיקון ומילוי הפגמים."
        },
        {
          "s": 13,
          "text": "והענין הוא,"
        },
        {
          "s": 14,
          "text": "די\"ג תיקוני דיקנא,"
        },
        {
          "s": 15,
          "text": "עם היותם למעלה מהשתלשלות,"
        },
        {
          "s": 16,
          "text": "מ\"מ,"
        },
        {
          "s": 17,
          "text": "כיון שהם באים להמתיק הדינים"
        },
        {
          "s": 18,
          "text": "(שבהשתלשלות)"
        },
        {
          "s": 19,
          "text": "הם שייכים להשתלשלות."
        },
        {
          "s": 20,
          "text": "וי\"ל שענינם באדם הוא העצם דכחות הגלויים."
        },
        {
          "s": 21,
          "text": "ולכן,"
        },
        {
          "s": 22,
          "text": "הגילוי די\"ג תיקוני דיקנא פועל בכחות הגלויים דהנשמה."
        },
        {
          "s": 23,
          "text": "ובחינת שער רישי' הוא העצמיות דלמעלה שלמעלה מהעצם דכחות הגלויים"
        },
        {
          "s": 24,
          "text": "[וזהו מ\"ש בהמאמר"
        },
        {
          "s": 25,
          "text": "(הובא לעיל סעיף ח)"
        },
        {
          "s": 26,
          "text": "שהגילוי דבחינת שער רישי' מועיל גם כשהפגם הגיע בעצם הנפש,"
        },
        {
          "s": 27,
          "text": "כי העצם שבו הגיע הפגם הוא העצם ששייך להגילויים,"
        },
        {
          "s": 28,
          "text": "ובחינת שער רישי' הוא עצם הנשמה ממש,"
        },
        {
          "s": 29,
          "text": "שאין שייך בה פגם]."
        },
        {
          "s": 30,
          "text": "וכיון שהעצם הוא מובדל מהגילויים,"
        },
        {
          "s": 31,
          "text": "אין שייך שיפעול בהם."
        },
        {
          "s": 32,
          "text": "ותיקון הפגמים בכחות הגלויים שע\"י הגילוי דבחינת שער רישי',"
        },
        {
          "s": 33,
          "text": "הוא,"
        },
        {
          "s": 34,
          "text": "שמתגלה בהם,"
        },
        {
          "s": 35,
          "text": "שמצד עצם הנשמה אין שייך פגם,"
        },
        {
          "s": 36,
          "text": "דגם בשעת החטא היא באמנה אתו ית'64,"
        },
        {
          "s": 37,
          "text": "וכיון שעצם הנשמה היא העצם שלהם,"
        },
        {
          "s": 38,
          "text": "לכן גם הפגמים שבהם הם רק בחיצוניות."
        },
        {
          "s": 39,
          "text": "והיינו,"
        },
        {
          "s": 40,
          "text": "שתיקון הפגמים שע\"י י\"ג תיקוני דיקנא הוא שהעצם השייך לכחות הגלויים פועל בהם,"
        },
        {
          "s": 41,
          "text": "בהציור שלהם."
        },
        {
          "s": 42,
          "text": "ותיקון הפגמים שע\"י בחינת שער רישי' הוא שמתגלה בהם שמצד העצם"
        },
        {
          "s": 43,
          "text": "(שלהם)"
        },
        {
          "s": 44,
          "text": "אין שייך בהם פגם,"
        },
        {
          "s": 45,
          "text": "אבל אין זה שייך כ\"כ לענינם של כחות הגלויים עצמם,"
        },
        {
          "s": 46,
          "text": "להציור שלהם."
        }
      ]
    }
  ]
}