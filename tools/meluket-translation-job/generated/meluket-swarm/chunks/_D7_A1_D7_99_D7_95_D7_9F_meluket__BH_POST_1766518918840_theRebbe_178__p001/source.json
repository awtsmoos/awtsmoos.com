{
  "globalIndex": 854,
  "owner": 4,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918840_theRebbe_178__p001",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918840_theRebbe_178__p001",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918840_theRebbe_178",
  "title": "מאמר רני ושמחי תשכ\"ז",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ בהעלותך,"
        },
        {
          "s": 2,
          "text": "ט' סיון ה'תשכ\"ז"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "רני ושמחי בת ציון גו'1,"
        },
        {
          "s": 1,
          "text": "ומדייק אדמו\"ר הזקן בתו\"א"
        },
        {
          "s": 2,
          "text": "(דרושי חנוכה)"
        },
        {
          "s": 3,
          "text": "ד\"ה זה2,"
        },
        {
          "s": 4,
          "text": "דלכאורה הי' צריך להתחיל ההפטורה דשבת חנוכה בפסוק3"
        },
        {
          "s": 5,
          "text": "ויאמר אלי גו' ראיתי והנה מנורת זהב גו',"
        },
        {
          "s": 6,
          "text": "ולמה מתחילין ברני ושמחי בת ציון."
        },
        {
          "s": 7,
          "text": "ומבאר שם4,"
        },
        {
          "s": 8,
          "text": "שהשייכות דרני ושמחי בת ציון לחנוכה היא,"
        },
        {
          "s": 9,
          "text": "כי בת ציון קאי על כנסת ישראל בזמן הגלות,"
        },
        {
          "s": 10,
          "text": "דבזמן הבית נקראת כנסת ישראל בשם ציון ובזמן הגלות נקראת בת ציון,"
        },
        {
          "s": 11,
          "text": "כמבואר שם בארוכה."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "וצריך להבין,"
        },
        {
          "s": 1,
          "text": "דדיוק הנ\"ל"
        },
        {
          "s": 2,
          "text": "[שהתחלת ההפטורה היא רני ושמחי בת ציון ולא ראיתי והנה מנורת זהב]"
        },
        {
          "s": 3,
          "text": "הוא גם בההפטורה דשבת פרשת בהעלותך,"
        },
        {
          "s": 4,
          "text": "שבסמיכות לזמן מתן תורתינו,"
        },
        {
          "s": 5,
          "text": "דמתן תורה הו\"ע חירות5,"
        },
        {
          "s": 6,
          "text": "ואעפ\"כ גם התחלת ההפטורה דש\"פ בהעלותך היא רני ושמחי בת ציון."
        }
      ]
    }
  ]
}