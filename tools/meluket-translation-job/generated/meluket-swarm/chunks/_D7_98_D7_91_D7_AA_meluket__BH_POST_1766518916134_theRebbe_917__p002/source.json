{
  "globalIndex": 413,
  "owner": 13,
  "jobId": "_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916134_theRebbe_917__p002",
  "batchId": "meluket-_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916134_theRebbe_917__p002",
  "seriesId": "טבת_meluket",
  "postId": "BH_POST_1766518916134_theRebbe_917",
  "title": "מאמר ויגש אליו יהודה תשכ\"ה",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ומזה מובן,"
        },
        {
          "s": 1,
          "text": "שבהגשת יהודה ליוסף,"
        },
        {
          "s": 2,
          "text": "שני ענינים."
        },
        {
          "s": 3,
          "text": "שבגילוי,"
        },
        {
          "s": 4,
          "text": "הענין דהגשת יהודה ליוסף הוא לפי שיוסף"
        },
        {
          "s": 5,
          "text": "(יסוד ז\"א)"
        },
        {
          "s": 6,
          "text": "הוא המשפיע ויהודה"
        },
        {
          "s": 7,
          "text": "(מלכות)"
        },
        {
          "s": 8,
          "text": "הוא המקבל,"
        },
        {
          "s": 9,
          "text": "ולכן נגש יהודה ליוסף וביקש בי אדוני,"
        },
        {
          "s": 10,
          "text": "שיומשך בו השפע מיוסף הצדיק."
        },
        {
          "s": 11,
          "text": "ועוד ענין בהגשת יהודה ליוסף,"
        },
        {
          "s": 12,
          "text": "שמרומז בהסופי תיבות דויגש אליו יהודה,"
        },
        {
          "s": 13,
          "text": "שהוא החיבור והיחוד דיוסף"
        },
        {
          "s": 14,
          "text": "(ז\"א,"
        },
        {
          "s": 15,
          "text": "דעת עליון)"
        },
        {
          "s": 16,
          "text": "ויהודה"
        },
        {
          "s": 17,
          "text": "(מלכות,"
        },
        {
          "s": 18,
          "text": "דעת תחתון)"
        },
        {
          "s": 19,
          "text": "שיהי' לע\"ל,"
        },
        {
          "s": 20,
          "text": "שהמלכות תהי' כמו הז\"א."
        },
        {
          "s": 21,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 22,
          "text": "שבויגש אליו יהודה מרומז גם העלי' דמלכות שיהי' לע\"ל,"
        },
        {
          "s": 23,
          "text": "שהמלכות תהי' למעלה מז\"א,"
        },
        {
          "s": 24,
          "text": "אשת חיל עטרת בעלה15,"
        },
        {
          "s": 25,
          "text": "שלמעלה גם מהענין דשניהם שוים."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דזהו מה דאיתא בזהר16"
        },
        {
          "s": 2,
          "text": "שהגשת יהודה ליוסף הוא ענין סמיכת גאולה לתפלה"
        },
        {
          "s": 3,
          "text": "[דגאולה היא בחינת יסוד,"
        },
        {
          "s": 4,
          "text": "יוסף,"
        },
        {
          "s": 5,
          "text": "ותפלה היא בחינת מלכות,"
        },
        {
          "s": 6,
          "text": "יהודה17]."
        },
        {
          "s": 7,
          "text": "דמלשון רז\"ל18"
        },
        {
          "s": 8,
          "text": "סמיכת גאולה לתפלה"
        },
        {
          "s": 9,
          "text": "(ולא סמיכת תפלה לגאולה),"
        },
        {
          "s": 10,
          "text": "שתפלה היא במקומה וגאולה נסמכת"
        },
        {
          "s": 11,
          "text": "(נגשת)"
        },
        {
          "s": 12,
          "text": "לתפלה,"
        },
        {
          "s": 13,
          "text": "מובן19,"
        },
        {
          "s": 14,
          "text": "שהעיקר הוא20"
        },
        {
          "s": 15,
          "text": "התפלה."
        },
        {
          "s": 16,
          "text": "ומזה שאומר בזהר שהגשת יהודה ליוסף הו\"ע סמיכת גאולה לתפלה,"
        },
        {
          "s": 17,
          "text": "משמע,"
        },
        {
          "s": 18,
          "text": "שגם בהגשת יהודה ליוסף ישנה"
        },
        {
          "s": 19,
          "text": "(בהעלם)"
        },
        {
          "s": 20,
          "text": "המעלה דיהודה לגבי יוסף."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים מ\"ש אדמו\"ר"
        },
        {
          "s": 2,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 3,
          "text": "נ\"ע בד\"ה זה21,"
        },
        {
          "s": 4,
          "text": "דזה שיהודה הקדים תחלה בי אדוני"
        },
        {
          "s": 5,
          "text": "(דלכאורה הי' צריך להתחיל ידבר נא עבדך גו')"
        },
        {
          "s": 6,
          "text": "הוא כענין קדימת פסוק22"
        },
        {
          "s": 7,
          "text": "אד' שפתי תפתח קודם התפלה"
        },
        {
          "s": 8,
          "text": "[שאין זה הפסק בין גאולה לתפלה,"
        },
        {
          "s": 9,
          "text": "כדאיתא בגמרא23,"
        },
        {
          "s": 10,
          "text": "כיון דתקינו רבנן למימר אד' שפתי תפתח,"
        },
        {
          "s": 11,
          "text": "כתפלה אריכתא דמיא]."
        },
        {
          "s": 12,
          "text": "והנה בתרגום עה\"פ אד' שפתי תפתח פירש,"
        },
        {
          "s": 13,
          "text": "שפותי פתח באורייתא."
        },
        {
          "s": 14,
          "text": "ומבואר בכמה דרושים24"
        },
        {
          "s": 15,
          "text": "המבארים הענין דתורה ותפלה"
        },
        {
          "s": 16,
          "text": "(וגם בדרוש הנ\"ל25),"
        },
        {
          "s": 17,
          "text": "דהבקשה שבפסוק זה שבהתחלת התפלה היא,"
        },
        {
          "s": 18,
          "text": "שהתפלה"
        },
        {
          "s": 19,
          "text": "(ופי יגיד תהלתך)"
        },
        {
          "s": 20,
          "text": "תהי' כמו תורה"
        },
        {
          "s": 21,
          "text": "(אד' שפתי תפתח באורייתא)."
        },
        {
          "s": 22,
          "text": "דכמו שבתורה,"
        },
        {
          "s": 23,
          "text": "התורה שהאדם לומד היא דבר ה',"
        },
        {
          "s": 24,
          "text": "דברי אשר שמתי בפיך26,"
        },
        {
          "s": 25,
          "text": "והאדם הוא כעונה אחר הקורא27,"
        },
        {
          "s": 26,
          "text": "כמו\"כ גם התפלה תהי' באופן דופי יגיד תהלתך,"
        },
        {
          "s": 27,
          "text": "שתפלת האדם תהי' שעל ידה תומשך"
        },
        {
          "s": 28,
          "text": "(יגיד מלשון המשכה)"
        },
        {
          "s": 29,
          "text": "תהלתך,"
        },
        {
          "s": 30,
          "text": "תפלתו של הקב\"ה."
        }
      ]
    }
  ]
}