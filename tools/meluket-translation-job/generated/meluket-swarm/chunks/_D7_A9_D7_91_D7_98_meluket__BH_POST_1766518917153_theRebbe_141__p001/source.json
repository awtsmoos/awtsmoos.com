{
  "globalIndex": 593,
  "owner": 43,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917153_theRebbe_141__p001",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917153_theRebbe_141__p001",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518917153_theRebbe_141",
  "title": "מאמר ואלה המשפטים תשל\"ח",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "מוצאי ש\"פ משפטים,"
        },
        {
          "s": 2,
          "text": "מבה\"ח אדר ראשון – בחדרו – ה'תשל\"ח*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "ואלה המשפטים אשר תשים לפניהם1,"
        },
        {
          "s": 1,
          "text": "ומדייק בזה כ\"ק אדמו\"ר הזקן בתו\"א ריש פרשתנו2"
        },
        {
          "s": 2,
          "text": "דצלה\"ב דלפניהם משמע לשון רבים וכי תקנה הוא לשון יחיד,"
        },
        {
          "s": 3,
          "text": "והול\"ל כי יקנו."
        },
        {
          "s": 4,
          "text": "גם ידוע הדיוק3"
        },
        {
          "s": 5,
          "text": "מפני מה התחיל כל המשפטים בדין עבד עברי דוקא"
        },
        {
          "s": 6,
          "text": "[דזהו גם כוונת המדרש4"
        },
        {
          "s": 7,
          "text": "עה\"פ באמרו אני קניתי אתכם במצרים וכו',"
        },
        {
          "s": 8,
          "text": "לבאר טעם התחלת ואלה המשפטים בדין עבד עברי]."
        },
        {
          "s": 9,
          "text": "ועוד כמה דיוקים עה\"פ,"
        },
        {
          "s": 10,
          "text": "כמבואר בדרושי רבותינו נשיאינו ממלאי מקומו."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והענין הוא,"
        },
        {
          "s": 2,
          "text": "דהנה מ\"ש ואלה המשפטים וגו' הו\"ע כללי כמובן גם מפי' רז\"ל שקאי על כללות ענין לימוד התורה."
        },
        {
          "s": 3,
          "text": "וזהו ג\"כ מ\"ש תשים"
        },
        {
          "s": 4,
          "text": "(ל' יחיד)"
        },
        {
          "s": 5,
          "text": "דקאי על משה,"
        },
        {
          "s": 6,
          "text": "כי ענינו של משה הו\"ע התורה5,"
        },
        {
          "s": 7,
          "text": "ואח\"כ אומר לפניהם"
        },
        {
          "s": 8,
          "text": "(ל' רבים),"
        },
        {
          "s": 9,
          "text": "היינו שע\"י היתה המשכת התורה לכאו\"א מישראל עד סוף כל הדורות,"
        },
        {
          "s": 10,
          "text": "וכמ\"ש6"
        },
        {
          "s": 11,
          "text": "זכרו תורת משה עבדי,"
        },
        {
          "s": 12,
          "text": "עד לתינוק המתחיל לדבר שאביו מלמדו תורה7,"
        },
        {
          "s": 13,
          "text": "והיינו הפסוק8"
        },
        {
          "s": 14,
          "text": "תורה צוה לנו משה גו'."
        },
        {
          "s": 15,
          "text": "וכמו\"כ ישנה הוראה כללית בפסוק זה גם באופן לימוד התורה,"
        },
        {
          "s": 16,
          "text": "שצ\"ל באופן מסויים דוקא כדרז\"ל9"
        },
        {
          "s": 17,
          "text": "במ\"ש תשים לפניהם שהרב שלמד כו' חוזר ושונה הדבר אפי' כמה פעמים עד שיבינו עומק ההלכה בטעמה היטב,"
        },
        {
          "s": 18,
          "text": "ומוסיף עוד אדה\"ז בזה בסיום הל' ת\"ת שלו10"
        },
        {
          "s": 19,
          "text": "דצריך אתה לשים לפניהם טעם המיישב תלמודם ומשימו בלבם"
        },
        {
          "s": 20,
          "text": "[וי\"ל דבמ\"ש אדה\"ז שמשימו בלבם מפרש דמ\"ש"
        },
        {
          "s": 21,
          "text": "(תשים)"
        },
        {
          "s": 22,
          "text": "לפניהם היינו לפנימיותם11,"
        },
        {
          "s": 23,
          "text": "דזהו כשמשימו בהלב],"
        },
        {
          "s": 24,
          "text": "שזהו ענין כללי בלימוד התורה דכאו\"א מישראל"
        },
        {
          "s": 25,
          "text": "(שהרי לימוד התורה היא מצוה שבגופו,"
        },
        {
          "s": 26,
          "text": "שכל א' מחויב בה)."
        },
        {
          "s": 27,
          "text": "וכמ\"ש12"
        },
        {
          "s": 28,
          "text": "ושננתם לבניך ודרז\"ל13"
        },
        {
          "s": 29,
          "text": "שיהיו דברי תורה שנונים ומחודדים בפיך"
        },
        {
          "s": 30,
          "text": "(שזהו כענין הנ\"ל שההלכה צ\"ל ברורה ומסודרה וכו'),"
        },
        {
          "s": 31,
          "text": "דזהו חיוב על כאו\"א מישראל"
        },
        {
          "s": 32,
          "text": "[שהרי נוסף על החיוב דושננתם לבניך,"
        },
        {
          "s": 33,
          "text": "צ\"ל השינון בדברי תורה גם בלימוד האב"
        },
        {
          "s": 34,
          "text": "(והרב)"
        },
        {
          "s": 35,
          "text": "עצמו,"
        },
        {
          "s": 36,
          "text": "ואדרבה,"
        },
        {
          "s": 37,
          "text": "דוקא עי\"ז שתחלה ישנו אצלו השינון בדברי תורה אפ\"ל אח\"כ ושננתם"
        },
        {
          "s": 38,
          "text": "(גם)"
        },
        {
          "s": 39,
          "text": "לבניך]."
        },
        {
          "s": 40,
          "text": "ועפ\"ז מובן14"
        },
        {
          "s": 41,
          "text": "מ\"ש ואלה המשפטים אשר תשים לפניהם מיד לאחר פרשת מ\"ת,"
        },
        {
          "s": 42,
          "text": "כי בפסוק זה ישנה הוראה כללית באופן"
        },
        {
          "s": 43,
          "text": "[לימוד התורה דכאו\"א"
        },
        {
          "s": 44,
          "text": "[הן בהלימוד עם עצמו,"
        },
        {
          "s": 45,
          "text": "וכן בושננתם לבניך כפשוטו,"
        },
        {
          "s": 46,
          "text": "ולבניך אלו התלמידים כדחז\"ל15"
        },
        {
          "s": 47,
          "text": "עה\"פ]"
        },
        {
          "s": 48,
          "text": "ע\"פ דרז\"ל הנ\"ל ובעיקר באופן]"
        },
        {
          "s": 49,
          "text": "עבודת האדם לקונו."
        }
      ]
    }
  ]
}