{
  "globalIndex": 782,
  "owner": 32,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918408_theRebbe_266__p001",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918408_theRebbe_266__p001",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918408_theRebbe_266",
  "title": "מאמר ונקדשתי תשכ\"ה",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ אמור,"
        },
        {
          "s": 2,
          "text": "י\"ג אייר,"
        },
        {
          "s": 3,
          "text": "ה'תשכ\"ה"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "ונקדשתי בתוך בני ישראל אני ה' מקדישכם1,"
        },
        {
          "s": 1,
          "text": "ומבאר אדמו\"ר הזקן בלקו\"ת ד\"ה זה2,"
        },
        {
          "s": 2,
          "text": "דונקדשתי בתוך בני ישראל"
        },
        {
          "s": 3,
          "text": "(גילוי קדושתו ית' בתוך הלב3"
        },
        {
          "s": 4,
          "text": "דישראל)"
        },
        {
          "s": 5,
          "text": "הוא באופן דמלמטה למעלה,"
        },
        {
          "s": 6,
          "text": "שלבם של ישראל בוער כרשפי אש ליכלל בקדושתו ית',"
        },
        {
          "s": 7,
          "text": "ועי\"ז נמשך אח\"כ אני הוי' מקדישכם,"
        },
        {
          "s": 8,
          "text": "המשכת קדושתו ית' מלמעלה למטה."
        },
        {
          "s": 9,
          "text": "ובזה עצמו"
        },
        {
          "s": 10,
          "text": "(בההמשכה מלמעלה למטה)"
        },
        {
          "s": 11,
          "text": "שני ענינים,"
        },
        {
          "s": 12,
          "text": "ההמשכה ע\"י תורה וההמשכה ע\"י מצוות4."
        },
        {
          "s": 13,
          "text": "דההמשכה שע\"י תורה היא בפנימיות העולמות"
        },
        {
          "s": 14,
          "text": "(ברוחניות),"
        },
        {
          "s": 15,
          "text": "ובכדי שתהי' ההמשכה בחיצוניות העולמות"
        },
        {
          "s": 16,
          "text": "(בגשמיות),"
        },
        {
          "s": 17,
          "text": "הוא ע\"י מעשה המצוות5."
        },
        {
          "s": 18,
          "text": "וזהו מ\"ש ג' פעמים קדוש6,"
        },
        {
          "s": 19,
          "text": "דקדוש הא' הוא העלאה מלמטה למעלה,"
        },
        {
          "s": 20,
          "text": "וקדוש הב' והג' הם המשכות מלמעלה למטה,"
        },
        {
          "s": 21,
          "text": "ע\"י תורה וע\"י מצוות5."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "וממשיך ב"
        },
        {
          "s": 2,
          "text": "(הביאור ל)"
        },
        {
          "s": 3,
          "text": "המאמר7,"
        },
        {
          "s": 4,
          "text": "שג' פעמים קדוש הם ג' מדריגות."
        },
        {
          "s": 5,
          "text": "קדוש הא' הוא כתר"
        },
        {
          "s": 6,
          "text": "(שלמעלה מחכמה),"
        },
        {
          "s": 7,
          "text": "קדוש הב' הוא כתר דז\"א,"
        },
        {
          "s": 8,
          "text": "וקדוש הג' הוא כתר דמלכות."
        },
        {
          "s": 9,
          "text": "ויש לומר הביאור בזה ע\"פ הידוע8"
        },
        {
          "s": 10,
          "text": "שקדוש"
        },
        {
          "s": 11,
          "text": "(בכלל)"
        },
        {
          "s": 12,
          "text": "קאי על אור הסובב שהוא קדוש ומובדל מהשתלשלות."
        },
        {
          "s": 13,
          "text": "ולכן עיקר הענין דקדוש"
        },
        {
          "s": 14,
          "text": "(קדוש הא')"
        },
        {
          "s": 15,
          "text": "הוא בכתר שלמעלה מהחכמה"
        },
        {
          "s": 16,
          "text": "(כי חכמה היא ראשית ההשתלשלות9)."
        },
        {
          "s": 17,
          "text": "וזה שגם הכתר דז\"א וכתר דמלכות נק' בשם קדוש,"
        },
        {
          "s": 18,
          "text": "הוא,"
        },
        {
          "s": 19,
          "text": "כי השתלשלות הכתרים היא לא כהשתלשלות עילה ועלול שהעלול הוא מהות אחר מהעילה,"
        },
        {
          "s": 20,
          "text": "כי אם,"
        },
        {
          "s": 21,
          "text": "שכל הכתרים הם מהות אחד10,"
        },
        {
          "s": 22,
          "text": "וגם לאחרי ירידת הכתר להיות כתר לז\"א או למלכות,"
        },
        {
          "s": 23,
          "text": "הוא במהותו כמו שהי' קודם"
        },
        {
          "s": 24,
          "text": "(כתר שלמעלה מחכמה)."
        },
        {
          "s": 25,
          "text": "ויש לומר,"
        },
        {
          "s": 26,
          "text": "דזה שמבאר בהמאמר שג' פעמים קדוש הם חלוקים במדריגתם"
        },
        {
          "s": 27,
          "text": "(שקדוש הא' הוא הכתר שלמעלה מחכמה,"
        },
        {
          "s": 28,
          "text": "וקדוש הב' והג' הם הכתר דז\"א ודמלכות),"
        },
        {
          "s": 29,
          "text": "הוא גם ביאור על החילוק באופנם"
        },
        {
          "s": 30,
          "text": "(שקדוש הא' הוא באופן דמלמטה למעלה וקדוש הב' והג' הם באופן דמלמעלה למטה)."
        },
        {
          "s": 31,
          "text": "דהסובב"
        },
        {
          "s": 32,
          "text": "(כתר)"
        },
        {
          "s": 33,
          "text": "עצמו,"
        },
        {
          "s": 34,
          "text": "כיון שהוא קדוש ומובדל לגמרי,"
        },
        {
          "s": 35,
          "text": "הגילוי שלו באדם הוא באופן שהוא מכיר ומרגיש שזהו ענין שמופלא ומובדל ממנו,"
        },
        {
          "s": 36,
          "text": "ולכן הוא משתוקק לצאת ממציאותו וליכלל בהענין המופלא,"
        },
        {
          "s": 37,
          "text": "וכאשר הסובב יורד להיות כתר לז\"א או למלכות,"
        },
        {
          "s": 38,
          "text": "אז הגילוי שלו הוא באופן שנמשך למטה."
        },
        {
          "s": 39,
          "text": "ועד\"ז הוא בנוגע לקדוש הב' והג',"
        },
        {
          "s": 40,
          "text": "שהחילוק באופן המשכתם הוא מפני שהם חלוקים במדריגתם."
        },
        {
          "s": 41,
          "text": "דקדוש הב',"
        },
        {
          "s": 42,
          "text": "כיון שהירידה שלו הוא שנעשה כתר לז\"א"
        },
        {
          "s": 43,
          "text": "(דז\"א הוא סוף האצילות11),"
        },
        {
          "s": 44,
          "text": "המשכתו היא"
        },
        {
          "s": 45,
          "text": "(רק)"
        },
        {
          "s": 46,
          "text": "בפנימיות העולמות"
        },
        {
          "s": 47,
          "text": "(ע\"י תורה),"
        },
        {
          "s": 48,
          "text": "וקדוש הג',"
        },
        {
          "s": 49,
          "text": "שיורד להיות כתר למלכות"
        },
        {
          "s": 50,
          "text": "(דמלכות היא שרש הנבראים11),"
        },
        {
          "s": 51,
          "text": "המשכתו היא"
        },
        {
          "s": 52,
          "text": "(גם)"
        },
        {
          "s": 53,
          "text": "בחיצוניות העולמות"
        },
        {
          "s": 54,
          "text": "(ע\"י מעשה המצוות)."
        }
      ]
    }
  ]
}