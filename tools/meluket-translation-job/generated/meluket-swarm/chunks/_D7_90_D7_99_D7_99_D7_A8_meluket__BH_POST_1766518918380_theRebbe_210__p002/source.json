{
  "globalIndex": 775,
  "owner": 25,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918380_theRebbe_210__p002",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918380_theRebbe_210__p002",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918380_theRebbe_210",
  "title": "מאמר דבר אל..קדושים תהיו תשכ\"א",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה ענין יכול כמוני כו' שבמדרש הנ\"ל בא בהמשך למ\"ש שם לפנ\"ז עה\"פ6"
        },
        {
          "s": 2,
          "text": "והיית רק למעלה יכול כמוני כו' גדולתי למעלה מגדולתכם."
        },
        {
          "s": 3,
          "text": "וע\"פ מ\"ש בלקו\"ת בענין קדושתי למעלה מקדושתכם,"
        },
        {
          "s": 4,
          "text": "שביכלתם של ישראל להמשיך גם בחינת קדושתי שלמעלה מקדושתכם אלא שהמשכת קדושה זו היא ע\"י עבודה נעלית יותר"
        },
        {
          "s": 5,
          "text": "(עבודת התשובה שלמעלה מהעבודה דתומ\"צ),"
        },
        {
          "s": 6,
          "text": "צריך לומר,"
        },
        {
          "s": 7,
          "text": "שעד\"ז הוא גם בנוגע לשתי הדרגות דגדולה"
        },
        {
          "s": 8,
          "text": "(גדולתי וגדולתכם),"
        },
        {
          "s": 9,
          "text": "שביכלתם של ישראל להמשיך גם בחינת גדולתי,"
        },
        {
          "s": 10,
          "text": "אלא שלזה צריך עבודה נעלית יותר."
        },
        {
          "s": 11,
          "text": "ולהוסיף,"
        },
        {
          "s": 12,
          "text": "דקדושה היא למעלה מגדולה."
        },
        {
          "s": 13,
          "text": "דגדולה הו\"ע ההתפשטות והגילוי7"
        },
        {
          "s": 14,
          "text": "[שלכן נקראת החסד בשם גדולה8."
        },
        {
          "s": 15,
          "text": "וגם להביאור שגדולה היא למעלה ממדת החסד,"
        },
        {
          "s": 16,
          "text": "ענין הגדולה היא חסד"
        },
        {
          "s": 17,
          "text": "(התפשטות),"
        },
        {
          "s": 18,
          "text": "אלא שהיא למעלה ממדת החסד,"
        },
        {
          "s": 19,
          "text": "וההתפשטות שמצד הגדולה היא בלי גבול9]"
        },
        {
          "s": 20,
          "text": "וקדושה"
        },
        {
          "s": 21,
          "text": "(מלשון קדושה והבדלה)"
        },
        {
          "s": 22,
          "text": "הוא העצם10"
        },
        {
          "s": 23,
          "text": "שמובדל מענין ההתפשטות והגילוי7."
        },
        {
          "s": 24,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 25,
          "text": "שגם המשכת בחינת גדולתי שלמעלה מגדולתכם היא ע\"י עבודת הצדיקים"
        },
        {
          "s": 26,
          "text": "[אלא שבעבודת הצדיקים עצמה היא עבודה נעלית יותר],"
        },
        {
          "s": 27,
          "text": "וזה שצריך לעבודת התשובה דוקא הוא בשביל המשכת בחינת קדושתי."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ויש לבאר זה ע\"פ מ\"ש11"
        },
        {
          "s": 2,
          "text": "ויספו ענוים בהוי' שמחה ואביוני אדם בקדוש ישראל יגילו,"
        },
        {
          "s": 3,
          "text": "ומבואר בלקו\"ת12"
        },
        {
          "s": 4,
          "text": "דיספו ענוים בהוי' שמחה קאי על עבודת הצדיקים,"
        },
        {
          "s": 5,
          "text": "שע\"י הענוה והביטול שלהם הם מוסיפים שמחה בשם הוי',"
        },
        {
          "s": 6,
          "text": "ועי\"ז נמשך הגילוי דהוי' למטה,"
        },
        {
          "s": 7,
          "text": "ואביוני אדם הם הבעלי תשובה"
        },
        {
          "s": 8,
          "text": "[דתורה ומצוות נק' בשם אדם,"
        },
        {
          "s": 9,
          "text": "ולכן נקראים הבעלי תשובה בשם אביוני אדם כי הם אביונים מבחינת אדם דתורה ומצוות],"
        },
        {
          "s": 10,
          "text": "שהם מגיעים בבחינת קדוש ישראל,"
        },
        {
          "s": 11,
          "text": "שקדוש ומובדל מבחינת ישראל דלעילא,"
        },
        {
          "s": 12,
          "text": "למעלה מהוי'."
        },
        {
          "s": 13,
          "text": "ויש לומר,"
        },
        {
          "s": 14,
          "text": "שהוספת השמחה בהוי' שעי\"ז מיתוסף בההמשכה והגילוי שלו הוא המשכת בחינת גדולתי שלמעלה מגדולתכם."
        },
        {
          "s": 15,
          "text": "שהגדולה"
        },
        {
          "s": 16,
          "text": "(ההתפשטות)"
        },
        {
          "s": 17,
          "text": "דהוי'13"
        },
        {
          "s": 18,
          "text": "כמו שהוא מצד עצמו,"
        },
        {
          "s": 19,
          "text": "היא גדולה השייכת לעולמות ונבראים,"
        },
        {
          "s": 20,
          "text": "גדולתכם,"
        },
        {
          "s": 21,
          "text": "אלא שיש גבול בההתפשטות והגילוי שלו."
        },
        {
          "s": 22,
          "text": "וענין ויספו גו' בהוי' הוא שנמשכת בו הגדולה דאוא\"ס שלמעלה משייכות לעולמות,"
        },
        {
          "s": 23,
          "text": "גדולתי,"
        },
        {
          "s": 24,
          "text": "ועי\"ז מיתוסף גם בההתפשטות והגילוי דהוי'."
        },
        {
          "s": 25,
          "text": "דהמשכה זו היא ע\"י עבודת הצדיקים,"
        },
        {
          "s": 26,
          "text": "ענוים."
        },
        {
          "s": 27,
          "text": "וענין ואביוני אדם בקדוש ישראל יגילו הוא14"
        },
        {
          "s": 28,
          "text": "המשכת בחינת קדושתי"
        },
        {
          "s": 29,
          "text": "(שלמעלה מקדושתכם)"
        },
        {
          "s": 30,
          "text": "ע\"י התשובה."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים15"
        },
        {
          "s": 2,
          "text": "מ\"ש16"
        },
        {
          "s": 3,
          "text": "מי יתנך כאח לי יונק משדי אמי גו',"
        },
        {
          "s": 4,
          "text": "ופירש רש\"י17,"
        },
        {
          "s": 5,
          "text": "מי יתנך כאח לי,"
        },
        {
          "s": 6,
          "text": "שתבוא לנחמני כדרך שעשה יוסף לאחיו שגמלוהו רעה ונאמר בו18"
        },
        {
          "s": 7,
          "text": "וינחם אותם."
        },
        {
          "s": 8,
          "text": "ובמדרש19"
        },
        {
          "s": 9,
          "text": "איתא,"
        },
        {
          "s": 10,
          "text": "באי זה אח כו' הוי אומר כיוסף לבנימין."
        },
        {
          "s": 11,
          "text": "ומבאר הצ\"צ20,"
        },
        {
          "s": 12,
          "text": "דהטעם על זה שאנו מבקשים מהקב\"ה"
        },
        {
          "s": 13,
          "text": "(לפירוש המדרש)"
        },
        {
          "s": 14,
          "text": "שיהי' לנו כיוסף לבנימין ולא כיוסף לאחיו21"
        },
        {
          "s": 15,
          "text": "[אף שהנהגת יוסף לאחיו הוא רבותא טפי דהגם שלא נהגו עמו כראוי מ\"מ גמל להם טובות גדולות],"
        },
        {
          "s": 16,
          "text": "הוא,"
        },
        {
          "s": 17,
          "text": "כי הנהגת יוסף לאחיו היתה שבתחלה ציער יוסף את אחיו,"
        },
        {
          "s": 18,
          "text": "בכדי22"
        },
        {
          "s": 19,
          "text": "שעי\"ז יתכפר להם העון שמכרוהו"
        },
        {
          "s": 20,
          "text": "(ורק אח\"כ גמל להם טוב),"
        },
        {
          "s": 21,
          "text": "וכיון שאנו מבקשים23"
        },
        {
          "s": 22,
          "text": "מחוק ברחמיך הרבים אבל לא על ידי יסורים,"
        },
        {
          "s": 23,
          "text": "לכן אומרים שהקב\"ה יהי' לנו כיוסף לבנימין."
        },
        {
          "s": 24,
          "text": "וצריך להבין,"
        },
        {
          "s": 25,
          "text": "הרי הבקשה מי יתנך כאח לי היא דהגם שהנהגתינו היתה שלא כראוי מ\"מ יהי' הקב\"ה לנו כאח,"
        },
        {
          "s": 26,
          "text": "ואיך שייך על זה הדוגמא דכיוסף לבנימין."
        }
      ]
    }
  ]
}