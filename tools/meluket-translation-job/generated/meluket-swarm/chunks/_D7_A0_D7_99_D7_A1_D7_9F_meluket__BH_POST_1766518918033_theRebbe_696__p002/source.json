{
  "globalIndex": 729,
  "owner": 29,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918033_theRebbe_696__p002",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918033_theRebbe_696__p002",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518918033_theRebbe_696",
  "title": "מאמר כימי צאתך תשל\"ט",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ונמצא,"
        },
        {
          "s": 1,
          "text": "דזה שבפסוק למען תזכור את יום צאתך מארץ מצרים כל ימי חייך,"
        },
        {
          "s": 2,
          "text": "שממנו נלמד החיוב דזכירת יציאת מצרים בכל יום"
        },
        {
          "s": 3,
          "text": "(ביום ובלילה)12,"
        },
        {
          "s": 4,
          "text": "כתיב יום צאתך מארץ מצרים"
        },
        {
          "s": 5,
          "text": "(יום לשון יחיד),"
        },
        {
          "s": 6,
          "text": "הוא,"
        },
        {
          "s": 7,
          "text": "כי הענין דיציאת מצרים בכל יום הוא"
        },
        {
          "s": 8,
          "text": "(בעיקר)"
        },
        {
          "s": 9,
          "text": "היציאה מהמיצרים דלעו\"ז13,"
        },
        {
          "s": 10,
          "text": "ובכללות הוא היציאה מהמיצרים וההגבלות שמונעים ומעכבים ללימוד התורה וקיום המצוות,"
        },
        {
          "s": 11,
          "text": "וזה שייך ליום צאתך מארץ מצרים"
        },
        {
          "s": 12,
          "text": "(יום לשון יחיד),"
        },
        {
          "s": 13,
          "text": "דביציאת מצרים,"
        },
        {
          "s": 14,
          "text": "ע\"י שישראל נעשו עבדי ה'"
        },
        {
          "s": 15,
          "text": "(ולא עבדי פרעה)14,"
        },
        {
          "s": 16,
          "text": "ניתן הכח15"
        },
        {
          "s": 17,
          "text": "לכאו\"א מישראל שבנוגע לתומ\"צ יהי' משוחרר מכל עניני העולם,"
        },
        {
          "s": 18,
          "text": "כולל גם עניני הגלות16,"
        },
        {
          "s": 19,
          "text": "מכיון ששטרי קודם17."
        },
        {
          "s": 20,
          "text": "ובפסוק כימי צאתך מארץ מצרים אראנו נפלאות כתיב כימי לשון רבים,"
        },
        {
          "s": 21,
          "text": "כי בכדי להגיע להגילוי דגאולה העתידה,"
        },
        {
          "s": 22,
          "text": "אראנו נפלאות,"
        },
        {
          "s": 23,
          "text": "מכיון שהגילויים דגאולה העתידה יהיו נפלאות גם לגבי הגילוי דיציאת מצרים18,"
        },
        {
          "s": 24,
          "text": "צריכה להיות גם היציאה מהמיצרים וההגבלות דקדושה,"
        },
        {
          "s": 25,
          "text": "ובזה גופא – בכל יום ויום,"
        },
        {
          "s": 26,
          "text": "יציאה ממיצרים נעלים יותר,"
        },
        {
          "s": 27,
          "text": "ולכן אומר כימי לשון רבים."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה מהנ\"ל"
        },
        {
          "s": 2,
          "text": "(שהעבודה דיצי\"מ שבכל יום היא באופן נעלה יותר)"
        },
        {
          "s": 3,
          "text": "מובן,"
        },
        {
          "s": 4,
          "text": "שבזמן הגלות,"
        },
        {
          "s": 5,
          "text": "היציאה מהמיצרים וההגבלות היא ממיצרים נעלים יותר מאשר היציאה מהמיצרים שהיתה בזמן הבית."
        },
        {
          "s": 6,
          "text": "ובזמן הגלות גופא,"
        },
        {
          "s": 7,
          "text": "בהדורות שבעקבתא דמשיחא,"
        },
        {
          "s": 8,
          "text": "ובפרט בדור האחרון,"
        },
        {
          "s": 9,
          "text": "נעשה היציאה ממיצרים נעלים עוד יותר."
        },
        {
          "s": 10,
          "text": "דנוסף לזה,"
        },
        {
          "s": 11,
          "text": "שבכל יום ויום מבררים עוד נצוצות ועוד נצוצות,"
        },
        {
          "s": 12,
          "text": "ועי\"ז מתקרבים יותר לביאת המשיח19,"
        },
        {
          "s": 13,
          "text": "הנה גם הענין דיציאת מצרים,"
        },
        {
          "s": 14,
          "text": "היציאה מהמיצרים וההגבלות,"
        },
        {
          "s": 15,
          "text": "בכל יום הוא באופן נעלה יותר."
        },
        {
          "s": 16,
          "text": "וע\"י העבודה דיציאת מצרים שבימים האחרונים שלפני ביאת המשיח,"
        },
        {
          "s": 17,
          "text": "שהיציאה ממצרים בימים אלו היא גם מהמיצרים הכי נעלים,"
        },
        {
          "s": 18,
          "text": "יזכו בקרוב ממש לגאולה העתידה שאז תהי' היציאה מכל המיצרים וההגבלות."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "וביאור הענין"
        },
        {
          "s": 1,
          "text": "(שהגילוי דגאולה העתידה תהי'"
        },
        {
          "s": 2,
          "text": "(בעיקר)"
        },
        {
          "s": 3,
          "text": "ע\"י העבודה שבסיום זמן הגלות)"
        },
        {
          "s": 4,
          "text": "יובן בהקדים הביאור בזה שבגאולה העתידה תהי' היציאה מכל המיצרים וההגבלות,"
        },
        {
          "s": 5,
          "text": "גם מהמיצרים וההגבלות הכי נעלים."
        },
        {
          "s": 6,
          "text": "והענין הוא,"
        },
        {
          "s": 7,
          "text": "כמבואר בהמאמר20,"
        },
        {
          "s": 8,
          "text": "דכל העולמות"
        },
        {
          "s": 9,
          "text": "(גם עולמות הכי נעלים)"
        },
        {
          "s": 10,
          "text": "נק' בשם מצרים,"
        },
        {
          "s": 11,
          "text": "להיותם בחינת מיצר והעלם."
        },
        {
          "s": 12,
          "text": "והיינו דזה שהעולמות נק' בשם מצרים הוא מצד שני טעמים."
        },
        {
          "s": 13,
          "text": "מצד זה שהם בהגבלה,"
        },
        {
          "s": 14,
          "text": "מצרים מלשון מיצר וגבול,"
        },
        {
          "s": 15,
          "text": "וגם מצד זה שהתהוותם היא ע\"י העלם האור,"
        },
        {
          "s": 16,
          "text": "וכידוע21"
        },
        {
          "s": 17,
          "text": "שההעלם דצמצום הראשון"
        },
        {
          "s": 18,
          "text": "(שעל ידו נעשה מקום לעמידת העולמות)"
        },
        {
          "s": 19,
          "text": "הוא צמצום בדרך סילוק,"
        },
        {
          "s": 20,
          "text": "שנתעלם האור לגמרי,"
        },
        {
          "s": 21,
          "text": "בדוגמת22"
        },
        {
          "s": 22,
          "text": "מצרים דלעו\"ז"
        },
        {
          "s": 23,
          "text": "(מצרים כפשוטו)"
        },
        {
          "s": 24,
          "text": "שהוא העלם והסתר."
        },
        {
          "s": 25,
          "text": "ויש לומר,"
        },
        {
          "s": 26,
          "text": "דזהו מה שממשיך בהמאמר23,"
        },
        {
          "s": 27,
          "text": "דבעולם יש ג' ענינים."
        },
        {
          "s": 28,
          "text": "עולם כפשוטו שמורה על מקום וזמן24,"
        },
        {
          "s": 29,
          "text": "ועולם מלשון העלם25"
        },
        {
          "s": 30,
          "text": "(דענינו הסתר26),"
        },
        {
          "s": 31,
          "text": "ועולם לשון עלם27"
        },
        {
          "s": 32,
          "text": "שפירושו הוא נערות וכח."
        },
        {
          "s": 33,
          "text": "ומבאר הקשר דג' הפירושים,"
        },
        {
          "s": 34,
          "text": "שההעלם והסתר דעולם"
        },
        {
          "s": 35,
          "text": "(זמן ומקום)"
        },
        {
          "s": 36,
          "text": "הוא בתוקף גדול."
        },
        {
          "s": 37,
          "text": "דיש לומר,"
        },
        {
          "s": 38,
          "text": "דזה שמביא כאן לא רק הפירוש דעולם כפשוטו"
        },
        {
          "s": 39,
          "text": "(מקום וזמן)"
        },
        {
          "s": 40,
          "text": "אלא גם הפירושים שעולם הוא מלשון העלם ומלשון עלם,"
        },
        {
          "s": 41,
          "text": "הוא,"
        },
        {
          "s": 42,
          "text": "כי עולם כפשוטו,"
        },
        {
          "s": 43,
          "text": "מקום וזמן"
        },
        {
          "s": 44,
          "text": "(ענין ההגבלה),"
        },
        {
          "s": 45,
          "text": "הוא ביאור רק על זה שעולמות הם מצרים מלשון מיצר וגבול,"
        },
        {
          "s": 46,
          "text": "ובכדי לבאר גם המיצר וההעלם שבעולמות"
        },
        {
          "s": 47,
          "text": "(ועד שהוא בדוגמת ההעלם והסתר דמצרים כפשוטו28),"
        },
        {
          "s": 48,
          "text": "הוא מביא גם הפירושים דעולם הוא מלשון העלם ומלשון עלם,"
        },
        {
          "s": 49,
          "text": "שההעלם והסתר דעולם הוא בתוקף גדול."
        }
      ]
    }
  ]
}