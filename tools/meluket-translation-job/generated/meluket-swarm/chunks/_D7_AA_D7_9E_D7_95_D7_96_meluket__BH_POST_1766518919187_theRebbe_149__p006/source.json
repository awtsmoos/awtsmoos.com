{
  "globalIndex": 912,
  "owner": 12,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919187_theRebbe_149__p006",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919187_theRebbe_149__p006",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919187_theRebbe_149",
  "title": "מאמר וידבר זאת חוקת תשכ\"ט",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "וצריך להבין,"
        },
        {
          "s": 1,
          "text": "דלכאורה,"
        },
        {
          "s": 2,
          "text": "הביאור בהשייכות דג' האהבות לג' המדריגות דלמעלה הוא לאחרי הבנת הענינים דג' המדריגות,"
        },
        {
          "s": 3,
          "text": "ומהמשך הענינים בהמאמר משמע דענין זה"
        },
        {
          "s": 4,
          "text": "[שג' מדריגות אלה הם ג' האהבות]"
        },
        {
          "s": 5,
          "text": "מוסיף ביאור בג' המדריגות."
        },
        {
          "s": 6,
          "text": "ויש לומר מהביאורים בזה,"
        },
        {
          "s": 7,
          "text": "דהטעם על זה שישנם למעלה ג' מדריגות שבהם נכללים כל הגילויים,"
        },
        {
          "s": 8,
          "text": "הוא,"
        },
        {
          "s": 9,
          "text": "כי כל הגילויים דלמעלה הם בשביל עבודת האדם,"
        },
        {
          "s": 10,
          "text": "וכיון שבאהבת ה'"
        },
        {
          "s": 11,
          "text": "[שהיא עיקר העבודה,"
        },
        {
          "s": 12,
          "text": "דלית פולחנא כפולחנא דרחימותא62]"
        },
        {
          "s": 13,
          "text": "ישנם ג' האהבות,"
        },
        {
          "s": 14,
          "text": "בכל לבבך בכל נפשך ובכל מאדך,"
        },
        {
          "s": 15,
          "text": "לכן כללות כל הגילויים דלמעלה נחלקים לג' מדריגות"
        },
        {
          "s": 16,
          "text": "(ממלא וסובב ואוא\"ס שלמעלה מסובב)"
        },
        {
          "s": 17,
          "text": "שבהתאם לג' אהבות הנ\"ל."
        },
        {
          "s": 18,
          "text": "וכיון שהבנת ענין על בוריו הוא ע\"י שמבארים אותו מיסודו ושרשו,"
        },
        {
          "s": 19,
          "text": "לכן,"
        },
        {
          "s": 20,
          "text": "התחלת הביאור"
        },
        {
          "s": 21,
          "text": "(בהמאמר)"
        },
        {
          "s": 22,
          "text": "של ג' המדריגות דלמעלה הוא איך שבהם הם ג' האהבות,"
        },
        {
          "s": 23,
          "text": "כי זהו השורש והסיבה לזה שנמשכו ג' המדריגות."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "ויש לומר,"
        },
        {
          "s": 3,
          "text": "דהטעם בפנימיות הענינים על זה שהמשכת וגילוי ג' הענינים דממלא וסובב ועצמות אוא\"ס הוא ע\"י ג' האהבות דבכל לבבך ובכל נפשך ובכל מאדך,"
        },
        {
          "s": 4,
          "text": "הוא,"
        },
        {
          "s": 5,
          "text": "כי הכוונה בכל הגילויים היא בכדי שעל ידם תהי' אח\"כ בריאת העולם,"
        },
        {
          "s": 6,
          "text": "ולכן,"
        },
        {
          "s": 7,
          "text": "כמו שבריאת העולם היתה באופן שכל הענינים שבו63"
        },
        {
          "s": 8,
          "text": "יתתקנו ע\"י עבודת האדם,"
        },
        {
          "s": 9,
          "text": "בכדי שעי\"ז יהי' האדם שותף להקב\"ה במעשה בראשית,"
        },
        {
          "s": 10,
          "text": "עד\"ז הוא בנוגע להגילויים דלמעלה,"
        },
        {
          "s": 11,
          "text": "שהתהוותם"
        },
        {
          "s": 12,
          "text": "(המשכתם)"
        },
        {
          "s": 13,
          "text": "היתה באופן שהגילוי שלהם64"
        },
        {
          "s": 14,
          "text": "יהי' ע\"י עבודת האדם,"
        },
        {
          "s": 15,
          "text": "בכדי שהשותפות של האדם להקב\"ה במעשה בראשית תהי' לא רק בהעולם עצמו אלא גם בהגילויים דלמעלה שעל ידם היתה בריאת העולם."
        },
        {
          "s": 16,
          "text": "וכיון שעיקר עבודת האדם הוא אהבת ה' דלית פולחנא כפולחנא דרחימותא"
        },
        {
          "s": 17,
          "text": "(כנ\"ל),"
        },
        {
          "s": 18,
          "text": "לכן,"
        },
        {
          "s": 19,
          "text": "הגילוי דג' המדריגות הנ\"ל"
        },
        {
          "s": 20,
          "text": "(שבהם נכללים כל הענינים דלמעלה),"
        },
        {
          "s": 21,
          "text": "הוא ע\"י ג' האהבות דבכל לבבך ובכל נפשך ובכל מאדך."
        },
        {
          "s": 22,
          "text": "וע\"י שהענינים דלמעלה נמשכים ומתגלים ע\"י עבודת האדם,"
        },
        {
          "s": 23,
          "text": "נעשה בהם עלי' למעלה יותר מכמו שהם מצד עצמם65."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "וזהו תפלה למשה,"
        },
        {
          "s": 1,
          "text": "דהמשכת הגילוי דעצמות אוא\"ס שלמעלה מסובב שהמשיך משה במלכות היתה ע\"י תפלה דוקא,"
        },
        {
          "s": 2,
          "text": "הגם דכיון שמשה הוא דעת עליון שמקבל מעתיק"
        },
        {
          "s": 3,
          "text": "(עצמות אוא\"ס שלמעלה מסובב)"
        },
        {
          "s": 4,
          "text": "הי' ביכלתו להמשיך במלכות אור זה בדרך מלמעלה למטה,"
        },
        {
          "s": 5,
          "text": "כי ע\"י שהמשכת האור היא ע\"י תפלה,"
        },
        {
          "s": 6,
          "text": "עבודת האדם"
        },
        {
          "s": 7,
          "text": "(בדרך מלמטה למעלה),"
        },
        {
          "s": 8,
          "text": "נשלמת הכוונה שבשבילה נאצל האור,"
        },
        {
          "s": 9,
          "text": "ועי\"ז נעשה בו עלי' ומיתוסף בהבל\"ג שלו."
        },
        {
          "s": 10,
          "text": "שהבל\"ג שבו הוא לא רק כמו שהוא מצד עצמו,"
        },
        {
          "s": 11,
          "text": "עצם האור שאין שייך בו צמצום וסילוק,"
        },
        {
          "s": 12,
          "text": "אלא"
        },
        {
          "s": 13,
          "text": "(גם)"
        },
        {
          "s": 14,
          "text": "כמו שהוא מצד העצמות."
        },
        {
          "s": 15,
          "text": "ולכן,"
        },
        {
          "s": 16,
          "text": "בנין המלכות שנעשה ע\"י האור כמו שנמשך ע\"י תפלת משה הוא בנין עדי עד."
        }
      ]
    }
  ]
}