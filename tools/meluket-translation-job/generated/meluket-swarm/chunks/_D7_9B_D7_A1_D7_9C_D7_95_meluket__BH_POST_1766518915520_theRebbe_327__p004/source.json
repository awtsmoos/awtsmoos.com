{
  "globalIndex": 306,
  "owner": 6,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915520_theRebbe_327__p004",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915520_theRebbe_327__p004",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915520_theRebbe_327",
  "title": "מאמר מרגלא בפומיה דרבא תש\"מ",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דג' ענינים אלה הם ג' הענינים דחכמה תשובה ומעשים טובים."
        },
        {
          "s": 2,
          "text": "חכמה"
        },
        {
          "s": 3,
          "text": "(תורה)"
        },
        {
          "s": 4,
          "text": "הו\"ע בן"
        },
        {
          "s": 5,
          "text": "(כנ\"ל סעיף ה),"
        },
        {
          "s": 6,
          "text": "תשובה שענינה הוא שהאדם יוצא ומתבטל ממציאותו"
        },
        {
          "s": 7,
          "text": "(כנ\"ל סעיף ב),"
        },
        {
          "s": 8,
          "text": "הוא ע\"ד הענין דקבלת עול,"
        },
        {
          "s": 9,
          "text": "עבד,"
        },
        {
          "s": 10,
          "text": "ומעשים טובים הם המצוות עצמם,"
        },
        {
          "s": 11,
          "text": "רצון העצמות."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ויש לקשר זה עם פירוש הידוע34"
        },
        {
          "s": 1,
          "text": "בהלשון תשובה ומעשים טובים,"
        },
        {
          "s": 2,
          "text": "שעל ידי התשובה נעשים המעשים"
        },
        {
          "s": 3,
          "text": "(מעשה המצוות)"
        },
        {
          "s": 4,
          "text": "מעשים טובים ומאירים35,"
        },
        {
          "s": 5,
          "text": "דהמשכת העצמות היא"
        },
        {
          "s": 6,
          "text": "(בעיקר)"
        },
        {
          "s": 7,
          "text": "בקיום המצוות"
        },
        {
          "s": 8,
          "text": "(מעשים),"
        },
        {
          "s": 9,
          "text": "ולא בהביטול דתשובה"
        },
        {
          "s": 10,
          "text": "(ודקבלת עול)."
        },
        {
          "s": 11,
          "text": "אלא שבכדי שהמעשים יהיו מעשים טובים ומאירים,"
        },
        {
          "s": 12,
          "text": "שהמשכת העצמות שבהם תהי' בגילוי,"
        },
        {
          "s": 13,
          "text": "הוא ע\"י הביטול דתשובה וקבלת עול."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "והנה הגם שענין עסק התורה הוא שמציאותו של האדם"
        },
        {
          "s": 2,
          "text": "(ההבנה וההשגה שלו)"
        },
        {
          "s": 3,
          "text": "תהי' בהתאם להתורה,"
        },
        {
          "s": 4,
          "text": "מ\"מ,"
        },
        {
          "s": 5,
          "text": "גם בלימוד התורה צ\"ל הביטול דעבד,"
        },
        {
          "s": 6,
          "text": "עולה של תורה36."
        },
        {
          "s": 7,
          "text": "וזהו שארז\"ל37"
        },
        {
          "s": 8,
          "text": "שאינו דומה שונה פרקו מאה פעמים לשונה פרקו מאה פעמים ואחד,"
        },
        {
          "s": 9,
          "text": "לפי שבפעם זו היתירה משנה טבעו ורגילותו38,"
        },
        {
          "s": 10,
          "text": "שגם בתורה צ\"ל הביטול דעבד39."
        }
      ]
    }
  ]
}