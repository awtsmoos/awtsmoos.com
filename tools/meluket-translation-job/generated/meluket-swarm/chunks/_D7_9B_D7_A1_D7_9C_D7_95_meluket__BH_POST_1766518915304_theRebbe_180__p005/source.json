{
  "globalIndex": 259,
  "owner": 9,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915304_theRebbe_180__p005",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915304_theRebbe_180__p005",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915304_theRebbe_180",
  "title": "מאמר ושבתי בשלום תשל\"ח",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "וזהו שהעבודה שלאחרי ויצא יעקב מבאר שבע וילך חרנה"
        },
        {
          "s": 2,
          "text": "(ירידת הנשמה בגוף)"
        },
        {
          "s": 3,
          "text": "היא ויקח מאבני המקום גו'."
        },
        {
          "s": 4,
          "text": "דהנה ידוע74"
        },
        {
          "s": 5,
          "text": "שהכוונה בירידת הנשמה למטה היא לא בשביל הנשמה אלא בכדי לברר ולזכך הגוף ונה\"ב וחלקו בעולם,"
        },
        {
          "s": 6,
          "text": "שעי\"ז דוקא נתגלה הכוונה דנתאוה75"
        },
        {
          "s": 7,
          "text": "הקב\"ה להיות לו ית' דירה בתחתונים,"
        },
        {
          "s": 8,
          "text": "בתחתון שאין תחתון למטה ממנו76."
        },
        {
          "s": 9,
          "text": "וזהו שעיקר עבודת הנשמה בירידתה למטה"
        },
        {
          "s": 10,
          "text": "(ויצא יעקב גו' חרנה)"
        },
        {
          "s": 11,
          "text": "הוא ויקח מאבני המקום גו',"
        },
        {
          "s": 12,
          "text": "\"מקום\" הוא מציאות כזו שהאור האלקי שבו הוא בהעלם והסתר"
        },
        {
          "s": 13,
          "text": "[וכנ\"ל"
        },
        {
          "s": 14,
          "text": "(סעיף ו)"
        },
        {
          "s": 15,
          "text": "דזה ששם הוי'"
        },
        {
          "s": 16,
          "text": "(ברבוע)"
        },
        {
          "s": 17,
          "text": "בגימטריא מקום – הכוונה בזה היא,"
        },
        {
          "s": 18,
          "text": "ששם הוי' הוא בהעלם והסתר בהמקום"
        },
        {
          "s": 19,
          "text": "(באופן דגימטריא)."
        },
        {
          "s": 20,
          "text": "דהגם שכל מציאות המקום"
        },
        {
          "s": 21,
          "text": "(עולם)"
        },
        {
          "s": 22,
          "text": "הוא ששם הוי' מהווה אותו תמיד מאין ליש,"
        },
        {
          "s": 23,
          "text": "מ\"מ אופן מציאותו של שם הוי' בהעולם הוא רק באופן של גימטריא,"
        },
        {
          "s": 24,
          "text": "בחי' העלם והסתר],"
        },
        {
          "s": 25,
          "text": "ובזה גופא – אבני המקום,"
        },
        {
          "s": 26,
          "text": "אבני לשון רבים"
        },
        {
          "s": 27,
          "text": "(כנ\"ל),"
        },
        {
          "s": 28,
          "text": "והתכלית דירידת הנשמה למטה"
        },
        {
          "s": 29,
          "text": "(ויצא יעקב גו' חרנה)"
        },
        {
          "s": 30,
          "text": "הוא"
        },
        {
          "s": 31,
          "text": "(לא בשביל האור שנמשך לה ע\"י תורה ומצוות,"
        },
        {
          "s": 32,
          "text": "כי אם)"
        },
        {
          "s": 33,
          "text": "בשביל העבודה דויקח מאבני המקום,"
        },
        {
          "s": 34,
          "text": "לקחת את הדברים התחתונים"
        },
        {
          "s": 35,
          "text": "(הגוף ונה\"ב וחלקו בעולם),"
        },
        {
          "s": 36,
          "text": "ובאופן דויקח שנעשה בעה\"ב ומושל ושולט עליהם,"
        },
        {
          "s": 37,
          "text": "ולעשות מהם דירה לו ית'."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ויש להוסיף,"
        },
        {
          "s": 1,
          "text": "דבענין הבירורים גופא יש יתרון בהבירור דדברי הרשות ע\"י שעושה אותם לשם שמים על הבירור דדברים הגשמיים שע\"י קיום המצוות,"
        },
        {
          "s": 2,
          "text": "כי ע\"י הבירור דדברי הרשות"
        },
        {
          "s": 3,
          "text": "(שגם כשעושה אותם לשם שמים הם נשארים דברי הרשות,"
        },
        {
          "s": 4,
          "text": "מעשיך)"
        },
        {
          "s": 5,
          "text": "נשלמת יותר הכוונה דדירה בתחתונים,"
        },
        {
          "s": 6,
          "text": "תחתון שאין תחתון למטה ממנו."
        },
        {
          "s": 7,
          "text": "ועפ\"ז יובן יותר זה שהעבודה"
        },
        {
          "s": 8,
          "text": "(שבשבילה ירדה הנשמה למטה)"
        },
        {
          "s": 9,
          "text": "היא \"ויקח מאבני המקום\","
        },
        {
          "s": 10,
          "text": "ד\"מקום\" הוא מציאות כזו שהאור האלקי שבו הוא בהעלם והסתר כנ\"ל,"
        },
        {
          "s": 11,
          "text": "דיש לומר,"
        },
        {
          "s": 12,
          "text": "שקאי"
        },
        {
          "s": 13,
          "text": "(בעיקר)"
        },
        {
          "s": 14,
          "text": "על דברי הרשות,"
        },
        {
          "s": 15,
          "text": "שגם לאחרי העבודה הם \"מעשיך\" דהאדם."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "ועפ\"ז יובן גם גודל העלי' דאבני המקום"
        },
        {
          "s": 3,
          "text": "[לאחרי שנעשים אבן אחת,"
        },
        {
          "s": 4,
          "text": "ע\"י עבודת הבירורים],"
        },
        {
          "s": 5,
          "text": "שהם מתעלים למעלה מבחי' הראש דיעקב"
        },
        {
          "s": 6,
          "text": "(וישם מראשותיו),"
        },
        {
          "s": 7,
          "text": "ועד אשר"
        },
        {
          "s": 8,
          "text": "(לאחרי גמר הבירורים)"
        },
        {
          "s": 9,
          "text": "והאבן הזאת גו' יהי' בית אלקים,"
        },
        {
          "s": 10,
          "text": "שהכוונה בזה היא"
        },
        {
          "s": 11,
          "text": "(כנ\"ל סעיף א)"
        },
        {
          "s": 12,
          "text": "לא לאלקים סתם כ\"א לבחי' והי' הוי' לי לאלקים."
        },
        {
          "s": 13,
          "text": "דהנה ידוע77"
        },
        {
          "s": 14,
          "text": "שתכלית הכוונה האמיתית בבריאת והתהוות העולמות הוא מה שנתאוה הקב\"ה להיות לו ית' דירה בתחתונים,"
        },
        {
          "s": 15,
          "text": "בעוה\"ז הגשמי שאין תחתון למטה ממנו."
        },
        {
          "s": 16,
          "text": "דהגם שיש כמה טעמים לברה\"ע78"
        },
        {
          "s": 17,
          "text": "[בגין דישתמודעון לי'79"
        },
        {
          "s": 18,
          "text": "ובכדי שיתגלו שלימות כוחותיו כו'80],"
        },
        {
          "s": 19,
          "text": "הנה טעמים אלו הם בנשמות דאצילות"
        },
        {
          "s": 20,
          "text": "(הטעם בגין דישתמודעון)"
        },
        {
          "s": 21,
          "text": "ובבחי' האצילות"
        },
        {
          "s": 22,
          "text": "(הטעם בכדי שיתגלו),"
        },
        {
          "s": 23,
          "text": "ומקום ושרש טעמים אלו הוא בבחי' הגילויים."
        },
        {
          "s": 24,
          "text": "משא\"כ ענין נתאוה הקב\"ה להיות לו ית' דירה בתחתונים"
        },
        {
          "s": 25,
          "text": "[שמצד זה הוצרך להיות התהוות עוה\"ז התחתון דוקא שאין תחתון למטה ממנו]"
        },
        {
          "s": 26,
          "text": "הוא בעצמותו ית'."
        },
        {
          "s": 27,
          "text": "וכמאמר רבינו הזקן81"
        },
        {
          "s": 28,
          "text": "(בענין נתאוה כו' דירה בתחתונים)"
        },
        {
          "s": 29,
          "text": "\"אויף אַ תאוה איז קיין קשיא\","
        },
        {
          "s": 30,
          "text": "שהענין דנתאוה הוא בעצמותו ית' שאין שייך שם ענין הקושיות."
        },
        {
          "s": 31,
          "text": "וזהו והאבן הזאת גו' יהי' בית אלקים,"
        },
        {
          "s": 32,
          "text": "שהכוונה באלקים כאן היא לבחי' העלם העצמי,"
        },
        {
          "s": 33,
          "text": "שהדברים הגשמיים דוקא"
        },
        {
          "s": 34,
          "text": "(בחינת אבן,"
        },
        {
          "s": 35,
          "text": "דומם)"
        },
        {
          "s": 36,
          "text": "יהיו בית ודירה לעצמותו ית'."
        }
      ]
    }
  ]
}