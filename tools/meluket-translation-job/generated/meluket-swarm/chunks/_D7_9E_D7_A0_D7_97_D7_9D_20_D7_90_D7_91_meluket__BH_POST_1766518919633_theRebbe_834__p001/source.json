{
  "globalIndex": 985,
  "owner": 35,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919633_theRebbe_834__p001",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919633_theRebbe_834__p001",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919633_theRebbe_834",
  "title": "מאמר בלע המוות לנצח תשכ\"ה",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "בלע המות לנצח ומחה הוי' אלקים דמעה מעל כל פנים1,"
        },
        {
          "s": 1,
          "text": "ומבאר אדמו\"ר מהר\"ש במאמרו ד\"ה זה2,"
        },
        {
          "s": 2,
          "text": "דזה שלע\"ל יהי' בלע המות לנצח הוא לפי שאז יהי' ואת3"
        },
        {
          "s": 3,
          "text": "רוח הטומאה אעביר מן הארץ."
        },
        {
          "s": 4,
          "text": "ויובן זה בהקדים הטעם דהמבואר בקרא"
        },
        {
          "s": 5,
          "text": "(דלקמן)"
        },
        {
          "s": 6,
          "text": "שע\"י חטא עה\"ד נעשה מיתה בעולם,"
        },
        {
          "s": 7,
          "text": "היינו שמיתה וחטא עה\"ד שייכים זל\"ז."
        },
        {
          "s": 8,
          "text": "והענין הוא,"
        },
        {
          "s": 9,
          "text": "דע\"י חטא עה\"ד נעשה תערובות טוב ורע4."
        },
        {
          "s": 10,
          "text": "דמציאות הרע הי' גם קודם החטא,"
        },
        {
          "s": 11,
          "text": "אלא שאז הי' הרע מובדל מהטוב,"
        },
        {
          "s": 12,
          "text": "וכידוע5"
        },
        {
          "s": 13,
          "text": "שבתחלת הבריאה הי' מדור הקליפות למטה מהעולמות דקדושה,"
        },
        {
          "s": 14,
          "text": "וע\"י חטא עה\"ד נעשה תערובות טוב ורע"
        },
        {
          "s": 15,
          "text": "(בכל העולם6),"
        },
        {
          "s": 16,
          "text": "שהרע מעורב בהטוב והטוב בהרע,"
        },
        {
          "s": 17,
          "text": "ועד אשר אין טוב בלא רע ואין רע בלא טוב7."
        },
        {
          "s": 18,
          "text": "וזהו מ\"ש8"
        },
        {
          "s": 19,
          "text": "ועתה פן ישלח ידו ולקח גם מעץ החיים ואכל וחי לעולם,"
        },
        {
          "s": 20,
          "text": "דלכאורה,"
        },
        {
          "s": 21,
          "text": "הרי בריאת האדם"
        },
        {
          "s": 22,
          "text": "(מלכתחילה)"
        },
        {
          "s": 23,
          "text": "היתה באופן שיהי' חי לעולם,"
        },
        {
          "s": 24,
          "text": "והטעם על זה שנצטווה שלא לאכול מעה\"ד הוא בכדי שלא ימות"
        },
        {
          "s": 25,
          "text": "(כמ\"ש9"
        },
        {
          "s": 26,
          "text": "ומעץ הדעת גו' לא תאכל ממנו כי ביום אכלך ממנו מות תמות),"
        },
        {
          "s": 27,
          "text": "ומה איכפת שיאכל מעה\"ח ויהי' חי לעולם."
        },
        {
          "s": 28,
          "text": "ומבאר אדמו\"ר הזקן10,"
        },
        {
          "s": 29,
          "text": "דמכיון שע\"י חטא עה\"ד נתערב רע בהאדם,"
        },
        {
          "s": 30,
          "text": "לכן,"
        },
        {
          "s": 31,
          "text": "ועתה"
        },
        {
          "s": 32,
          "text": "(לאחרי חטא עה\"ד)"
        },
        {
          "s": 33,
          "text": "יש לחשוש פן ישלח ידו גו' וחי לעולם,"
        },
        {
          "s": 34,
          "text": "כי כשיהי' הוא חי לעולם,"
        },
        {
          "s": 35,
          "text": "גם הרע המעורב בו יהי' לו קיום לעולם."
        },
        {
          "s": 36,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 37,
          "text": "דזה שע\"י חטא עה\"ד נעשה מיתה בעולם הוא בכדי שלא יהי' קיום להרע,"
        },
        {
          "s": 38,
          "text": "כנ\"ל."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דהמיתה בעולם שנעשתה ע\"י חטא עה\"ד היא מסובבת מהחטא עצמו."
        },
        {
          "s": 2,
          "text": "והענין הוא,"
        },
        {
          "s": 3,
          "text": "דענין החיות הוא בקדושה דוקא,"
        },
        {
          "s": 4,
          "text": "משא\"כ הרע והטומאה"
        },
        {
          "s": 5,
          "text": "(היפך הקדושה)"
        },
        {
          "s": 6,
          "text": "הם מות11,"
        },
        {
          "s": 7,
          "text": "ולכן,"
        },
        {
          "s": 8,
          "text": "מכיון שע\"י חטא עה\"ד נתערב רע בהאדם,"
        },
        {
          "s": 9,
          "text": "מות רוחני,"
        },
        {
          "s": 10,
          "text": "מזה נשתלשל בו גם מיתה כפשוטה."
        },
        {
          "s": 11,
          "text": "וזהו גם מה שלע\"ל יהי' בלע המות לנצח,"
        },
        {
          "s": 12,
          "text": "דמכיון שאז יתבטל הרע,"
        },
        {
          "s": 13,
          "text": "מות הרוחני12,"
        },
        {
          "s": 14,
          "text": "עי\"ז יהי' במילא גם בלע המות כפשוטו."
        }
      ]
    }
  ]
}