{
  "globalIndex": 661,
  "owner": 11,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917648_theRebbe_921__p004",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917648_theRebbe_921__p004",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917648_theRebbe_921",
  "title": "מאמר החודש הזה לכם תשל\"ט",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "שעד\"ז הוא בנוגע לתשרי וניסן."
        },
        {
          "s": 3,
          "text": "שתכלית הכוונה בהבריאה דתשרי"
        },
        {
          "s": 4,
          "text": "(בראשית ברא)"
        },
        {
          "s": 5,
          "text": "שאז נברא העולם במדידה והגבלה הוא בכדי שע\"י העבודה דתומ\"צ יהי' בו גילוי הבל\"ג דניסן"
        },
        {
          "s": 6,
          "text": "(החודש הזה לכם)."
        },
        {
          "s": 7,
          "text": "ויש לקשר זה עם המבואר במק\"א38"
        },
        {
          "s": 8,
          "text": "בענין ב' הדיעות."
        },
        {
          "s": 9,
          "text": "בזמן הבריאה39"
        },
        {
          "s": 10,
          "text": "– דעת ר' אליעזר שבתשרי נברא העולם"
        },
        {
          "s": 11,
          "text": "(כ\"ה אלול40)"
        },
        {
          "s": 12,
          "text": "ודעת ר' יהושע שבניסן נברא העולם"
        },
        {
          "s": 13,
          "text": "(כ\"ה אדר41)"
        },
        {
          "s": 14,
          "text": "– שאלו ואלו דברי אלקים חיים,"
        },
        {
          "s": 15,
          "text": "אלא שבניסן עלה במחשבה לברוא,"
        },
        {
          "s": 16,
          "text": "והבריאה בפועל היתה בתשרי42"
        },
        {
          "s": 17,
          "text": "(שלאחרי ניסן)."
        },
        {
          "s": 18,
          "text": "וע\"פ הידוע שהכוונה והתכלית של עשי' היא המחשבה שלפני',"
        },
        {
          "s": 19,
          "text": "יש לומר,"
        },
        {
          "s": 20,
          "text": "דזה שהמחשבה לברוא את העולם היתה בניסן,"
        },
        {
          "s": 21,
          "text": "הכוונה בזה היא,"
        },
        {
          "s": 22,
          "text": "שהכוונה והתכלית דבריאת העולם בתשרי"
        },
        {
          "s": 23,
          "text": "(מדידה והגבלה)"
        },
        {
          "s": 24,
          "text": "הוא שיהי' בו הגילוי דניסן שלמעלה מהגבלה."
        },
        {
          "s": 25,
          "text": "אלא שבכדי שתושלם הכוונה שגם בהגבול יהי' גילוי הבל\"ג היתה הבריאה בפועל באופן שבגילוי לא הי' נרגש בה הכוונה,"
        },
        {
          "s": 26,
          "text": "שעי\"ז נברא עולם מוגבל,"
        },
        {
          "s": 27,
          "text": "וע\"י התומ\"צ נמשך בעולם המוגבל הגילוי דאוא\"ס הבל\"ג,"
        },
        {
          "s": 28,
          "text": "דהתחלת גילוי זה הי' ביציאת מצרים,"
        },
        {
          "s": 29,
          "text": "החודש הזה לכם."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יש לבאר מה שלאחרי יציאת מצרים ומתן תורה,"
        },
        {
          "s": 2,
          "text": "גם המנין דחדשי השנה הוא מניסן,"
        },
        {
          "s": 3,
          "text": "הגם שחדשי השנה הם גילויים השייכים להבריאה ושרש המשכתם הוא מהאור השייך לעולמות,"
        },
        {
          "s": 4,
          "text": "כי מצד ענין וגדר העולם א\"א שיהי' בו הגילויים דחדשי השנה,"
        },
        {
          "s": 5,
          "text": "כי גם חדשי השנה הם חדשים מלשון חידוש"
        },
        {
          "s": 6,
          "text": "(היפך הגדר דעולם),"
        },
        {
          "s": 7,
          "text": "וזה שנמשך בעולם"
        },
        {
          "s": 8,
          "text": "(שחיותו הוא מהאור שמתלבש בו)"
        },
        {
          "s": 9,
          "text": "הגילויים דחדשי השנה מהאור שלמעלה מהתלבשות בעולם הי' כמו הקדמה להגילוי דחדשים סתם,"
        },
        {
          "s": 10,
          "text": "האור שלמעלה משייכות לעולמות."
        },
        {
          "s": 11,
          "text": "[ויש לומר דזהו שארז\"ל43"
        },
        {
          "s": 12,
          "text": "משבחר הקב\"ה בעולמו קבע בו ראשי חדשים"
        },
        {
          "s": 13,
          "text": "(ושנים),"
        },
        {
          "s": 14,
          "text": "דזה שנקבע בעולם ראשי חדשים"
        },
        {
          "s": 15,
          "text": "(שהם היפך הגדר דעולם כנ\"ל)"
        },
        {
          "s": 16,
          "text": "הוא מצד זה שבחר הקב\"ה בעולמו,"
        },
        {
          "s": 17,
          "text": "דיש לומר שענין בחר בעולמו הוא הגילוי דכוונת הבריאה."
        },
        {
          "s": 18,
          "text": "דבריאת העולם היתה"
        },
        {
          "s": 19,
          "text": "(כנ\"ל)"
        },
        {
          "s": 20,
          "text": "באופן שלא הי' נרגש בה הכוונה,"
        },
        {
          "s": 21,
          "text": "וכשבחר הקב\"ה בעולמו התחיל להאיר בו קצת כוונת הבריאה]."
        },
        {
          "s": 22,
          "text": "אלא שלפני יציאת מצרים,"
        },
        {
          "s": 23,
          "text": "כיון שכל הענינים היו אז במיצר והגבלה,"
        },
        {
          "s": 24,
          "text": "לכן,"
        },
        {
          "s": 25,
          "text": "העילוי שהי' נרגש בהחידוש דחדשי השנה הוא רק שהם למעלה מהגבלה ממש,"
        },
        {
          "s": 26,
          "text": "ולכן הי' אז תשרי הראשון לחדשי השנה."
        },
        {
          "s": 27,
          "text": "אבל לאחרי הגילוי דיציאת מצרים ומתן תורה נתגלה שהחידוש דחדשי השנה"
        },
        {
          "s": 28,
          "text": "(שהי' מקודם)"
        },
        {
          "s": 29,
          "text": "הוא הקדמה להגילוי דיציאת מצרים ומתן תורה,"
        },
        {
          "s": 30,
          "text": "ולכן עכשיו ניסן הוא ראשון גם לחדשי השנה,"
        },
        {
          "s": 31,
          "text": "ומנין החדשים הוא מניסן."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "והנה התחלת הגילוי דחודש ניסן,"
        },
        {
          "s": 3,
          "text": "שהוא ראשון גם לחדשי השנה,"
        },
        {
          "s": 4,
          "text": "הוא משבת מברכים ראש חודש ניסן,"
        },
        {
          "s": 5,
          "text": "ובפרט כשהקביעות דראש חודש הוא באמצע השבוע"
        },
        {
          "s": 6,
          "text": "(לפני שבת)"
        },
        {
          "s": 7,
          "text": "שאז קוראין בהשבת שלפני ר\"ח"
        },
        {
          "s": 8,
          "text": "(שבת מברכים)"
        },
        {
          "s": 9,
          "text": "פרשת החודש44."
        },
        {
          "s": 10,
          "text": "ועאכו\"כ כשהקביעות דר\"ח ניסן היא ביום ה'"
        },
        {
          "s": 11,
          "text": "(כמו שהי' בהשנה דיציאת מצרים45)"
        },
        {
          "s": 12,
          "text": "שאז הקביעות דשבת מברכים ניסן ודש\"פ החודש הוא בכ\"ה אדר שבו עלה במחשבה לברוא את העולם,"
        },
        {
          "s": 13,
          "text": "דמחשבה זו היא הכוונה והתכלית של הבריאה בפועל,"
        },
        {
          "s": 14,
          "text": "שגם בהגבול דעולם"
        },
        {
          "s": 15,
          "text": "(כמו שנברא בתשרי)"
        },
        {
          "s": 16,
          "text": "יהי' גילוי אוא\"ס הבל\"ג"
        },
        {
          "s": 17,
          "text": "(ניסן),"
        },
        {
          "s": 18,
          "text": "שעי\"ז נשלמת הכוונה דדירה לו ית' בתחתונים."
        },
        {
          "s": 19,
          "text": "דגילוי זה יהי' בעיקר בגאולה העתידה,"
        },
        {
          "s": 20,
          "text": "דבניסן נגאלו ובניסן עתידין ליגאל46."
        }
      ]
    }
  ]
}