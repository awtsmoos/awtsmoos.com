{
  "globalIndex": 114,
  "owner": 14,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914360_theRebbe_10__p004",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914360_theRebbe_10__p004",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914360_theRebbe_10",
  "title": "מאמר וחג האסיף תשמ\"ג",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וזהו וחג האסיף גו' באספך את מעשיך מן השדה,"
        },
        {
          "s": 2,
          "text": "שהוא אסיפת כל הענינים יחד."
        },
        {
          "s": 3,
          "text": "וההתחלה בזה היא שמאספים כל הענינים דתורה59"
        },
        {
          "s": 4,
          "text": "(ככל העבודות,"
        },
        {
          "s": 5,
          "text": "שהתחלתם היא בענינם כמו שהוא בתורה,"
        },
        {
          "s": 6,
          "text": "מכיון דאסתכל באורייתא וברא עלמא60)."
        },
        {
          "s": 7,
          "text": "דהנה כל ענין בתורה יש בו ששים ריבוא פירושים ע\"ד הפשט,"
        },
        {
          "s": 8,
          "text": "ששים ריבוא פירושים ע\"ד הרמז,"
        },
        {
          "s": 9,
          "text": "וכן ע\"ד הדרוש וע\"ד הסוד61."
        },
        {
          "s": 10,
          "text": "וצריך לאסוף ולכלול כל הפירושים דחלק הפשט,"
        },
        {
          "s": 11,
          "text": "וכן כל הפירושים דחלק הרמז,"
        },
        {
          "s": 12,
          "text": "דחלק הדרוש ודחלק הסוד,"
        },
        {
          "s": 13,
          "text": "ולאחרי זה לאסוף ולכלול כל ד' החלקים יחד."
        },
        {
          "s": 14,
          "text": "וזהו ואספת דגנך ותירושך ויצהרך,"
        },
        {
          "s": 15,
          "text": "דגן"
        },
        {
          "s": 16,
          "text": "(לחם)"
        },
        {
          "s": 17,
          "text": "הוא נגלה דתורה,"
        },
        {
          "s": 18,
          "text": "תירוש"
        },
        {
          "s": 19,
          "text": "(יין)"
        },
        {
          "s": 20,
          "text": "הוא רזין דאורייתא,"
        },
        {
          "s": 21,
          "text": "ויצהר"
        },
        {
          "s": 22,
          "text": "(שמן)"
        },
        {
          "s": 23,
          "text": "הוא רזין דרזין62,"
        },
        {
          "s": 24,
          "text": "והעבודה דואספת דגנך ותירושך ויצהרך היא בשתים."
        },
        {
          "s": 25,
          "text": "האסיפה וההתכללות של ריבוי הענינים דכל סוג"
        },
        {
          "s": 26,
          "text": "(נגלה,"
        },
        {
          "s": 27,
          "text": "רזין ורזין דרזין)"
        },
        {
          "s": 28,
          "text": "גופא,"
        },
        {
          "s": 29,
          "text": "וגם האסיפה וההתכללות דכל הסוגים יחד,"
        },
        {
          "s": 30,
          "text": "ולהעלותם לדרגא שלמעלה מהתחלקות,"
        },
        {
          "s": 31,
          "text": "עד לבחי' אתר דכליל כולא63"
        },
        {
          "s": 32,
          "text": "ולמעלה יותר."
        },
        {
          "s": 33,
          "text": "והגם דעיקר ענין זה"
        },
        {
          "s": 34,
          "text": "(ההתאחדות דכל עניני התורה)"
        },
        {
          "s": 35,
          "text": "יהי' בביאת המשיח,"
        },
        {
          "s": 36,
          "text": "שילמד את כל העם כולו64"
        },
        {
          "s": 37,
          "text": "את כל התורה כולה,"
        },
        {
          "s": 38,
          "text": "גם רזי תורה ורזין דרזין,"
        },
        {
          "s": 39,
          "text": "וכמ\"ש65"
        },
        {
          "s": 40,
          "text": "ישקני מנשיקות פיהו ופירש\"י שלע\"ל יתגלה סוד טעמי'"
        },
        {
          "s": 41,
          "text": "(דתורה)"
        },
        {
          "s": 42,
          "text": "ומסתר צפונותי',"
        },
        {
          "s": 43,
          "text": "וכ\"ז יהי' אז באופן של ראי'66,"
        },
        {
          "s": 44,
          "text": "אעפ\"כ,"
        },
        {
          "s": 45,
          "text": "מכיון שטועמי' חיים זכו67,"
        },
        {
          "s": 46,
          "text": "הרי מעין זה באופן של טעימה עכ\"פ יכול להיות וצריך להיות עכשיו."
        },
        {
          "s": 47,
          "text": "ומזה"
        },
        {
          "s": 48,
          "text": "(מהענין דואספת דגנך ותירושך ויצהרך כמו שהוא בתורה)"
        },
        {
          "s": 49,
          "text": "נמשך שיהי' ואספת דגנך ותירושך ויצהרך בכל עניני עבודת האדם ברוחניות,"
        },
        {
          "s": 50,
          "text": "ועד שזה נמשך גם בואספת דגנך ותירושך ויצהרך כפשוטו,"
        },
        {
          "s": 51,
          "text": "בדגן תירוש ויצהר הגשמיים."
        },
        {
          "s": 52,
          "text": "ועד\"ז הוא גם בענין האחדות דישיבה בסוכה"
        },
        {
          "s": 53,
          "text": "(שלאחרי העבודה דואספת),"
        },
        {
          "s": 54,
          "text": "שיש בזה"
        },
        {
          "s": 55,
          "text": "(כנ\"ל)"
        },
        {
          "s": 56,
          "text": "ב' מדריגות,"
        },
        {
          "s": 57,
          "text": "בסוכות תשבו שבעת ימים שהו\"ע האחדות כמו ששייך עדיין לשבעת ימים"
        },
        {
          "s": 58,
          "text": "(התחלקות)"
        },
        {
          "s": 59,
          "text": "וכל האזרח בישראל ישבו בסוכות"
        },
        {
          "s": 60,
          "text": "(סתם,"
        },
        {
          "s": 61,
          "text": "שלמעלה מענין שבעת ימים),"
        },
        {
          "s": 62,
          "text": "דעיקר ענין זה יהי' לע\"ל,"
        },
        {
          "s": 63,
          "text": "כידוע68"
        },
        {
          "s": 64,
          "text": "דפירוש אזרח הוא מה שעתיד להזריח לע\"ל,"
        },
        {
          "s": 65,
          "text": "אלא שאעפ\"כ יש הארה מזה גם עכשיו."
        },
        {
          "s": 66,
          "text": "כפירוש בעל ההילולא"
        },
        {
          "s": 67,
          "text": "(ע\"פ זה)69,"
        },
        {
          "s": 68,
          "text": "דמה שעתיד להזריח לע\"ל בתוך ישראל ובפנימיותם,"
        },
        {
          "s": 69,
          "text": "הנה גם עכשיו ישבו בסוכות,"
        },
        {
          "s": 70,
          "text": "שזה מתגלה עליהם"
        },
        {
          "s": 71,
          "text": "(עכשיו)"
        },
        {
          "s": 72,
          "text": "בבחי' סוכות ומקיף."
        },
        {
          "s": 73,
          "text": "ועד\"ז הוא גם בענין הד' מינים"
        },
        {
          "s": 74,
          "text": "(דנטילת ד' מינים הוא"
        },
        {
          "s": 75,
          "text": "(כנ\"ל)"
        },
        {
          "s": 76,
          "text": "לאחרי הישיבה בסוכה),"
        },
        {
          "s": 77,
          "text": "דכל אחד מד' המינים הוא \"זה הקב\"ה\","
        },
        {
          "s": 78,
          "text": "דענין זה הוא גם עכשיו,"
        },
        {
          "s": 79,
          "text": "אלא שעכשיו הוא בהעלם,"
        },
        {
          "s": 80,
          "text": "והגילוי מזה יהי' לע\"ל שאז יהי' ונגלה כבוד הוי' וראו כל בשר גו'70."
        },
        {
          "s": 81,
          "text": "ואז יהי' גם אסיפת דגנך ותירושך ויצהרך באופן אחר,"
        },
        {
          "s": 82,
          "text": "שלא יהי' צריך להיות ואספת"
        },
        {
          "s": 83,
          "text": "(שישראל יצטרכו לאסוף)"
        },
        {
          "s": 84,
          "text": "כי אם ועמדו זרים ורעו צאנכם ובני נכר אכריכם וגו'71,"
        },
        {
          "s": 85,
          "text": "וגם הישיבה בסוכה תהי' באופן נעלה יותר,"
        },
        {
          "s": 86,
          "text": "שישבו בסוכת עורו של לויתן72,"
        },
        {
          "s": 87,
          "text": "וגם ענין זה הקב\"ה"
        },
        {
          "s": 88,
          "text": "(שבד' המינים)"
        },
        {
          "s": 89,
          "text": "יהי' אז בגילוי,"
        },
        {
          "s": 90,
          "text": "כפי שאני נכתב כך אני נקרא73,"
        },
        {
          "s": 91,
          "text": "אלא שמעין זה"
        },
        {
          "s": 92,
          "text": "(דכל ענינים אלו)"
        },
        {
          "s": 93,
          "text": "יש גם עכשיו,"
        },
        {
          "s": 94,
          "text": "וכנ\"ל בפירוש כל האזרח בישראל ישבו בסוכות,"
        },
        {
          "s": 95,
          "text": "ועאכו\"כ בהזמן דסוף הגלות"
        },
        {
          "s": 96,
          "text": "(עקבתא דמשיחא)"
        },
        {
          "s": 97,
          "text": "שנשארו רק רגעים ספורים,"
        },
        {
          "s": 98,
          "text": "והבטיחה תורה שסוף ישראל לעשות תשובה בסוף גלותן ומיד הן נגאלין74,"
        },
        {
          "s": 99,
          "text": "ובשמחה ובטוב לבב."
        }
      ]
    }
  ]
}