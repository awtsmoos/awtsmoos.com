{
  "globalIndex": 973,
  "owner": 23,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919515_theRebbe_764__p009",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919515_theRebbe_764__p009",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919515_theRebbe_764",
  "title": "מאמר גדול יהי' תשכ\"ב",
  "part": 9,
  "sections": [
    {
      "v": 24,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "וע\"י הגילוי דיחוד הוי' ואלקים"
        },
        {
          "s": 3,
          "text": "(באופן הנ\"ל)"
        },
        {
          "s": 4,
          "text": "שיהי' בביהמ\"ק"
        },
        {
          "s": 5,
          "text": "(השלישי)"
        },
        {
          "s": 6,
          "text": "שגם המקום"
        },
        {
          "s": 7,
          "text": "(שנתהווה משם אלקים)"
        },
        {
          "s": 8,
          "text": "הוא כלי להגילוי דהוי' שלמעלה מהמקום,"
        },
        {
          "s": 9,
          "text": "יומשך מעין גילוי זה גם בכל העולם."
        },
        {
          "s": 10,
          "text": "וגילוי זה יהי' בעיקר בהגאולה שלאחרי בנין ביהמ\"ק."
        },
        {
          "s": 11,
          "text": "דהטעם על זה שגאולה העתידה תהי' גאולה נצחית שאין שייך אחרי' גלות הוא לפי שהעולם יהי' כלי להגאולה."
        },
        {
          "s": 12,
          "text": "וכמבואר בלקו\"ת69"
        },
        {
          "s": 13,
          "text": "שגאולה השלישית היא בזכות יעקב שמדתו מדת אמת שאין שייך בו שינוי,"
        },
        {
          "s": 14,
          "text": "דאמיתית ענין הבל\"ג"
        },
        {
          "s": 15,
          "text": "(מדת האמת)"
        },
        {
          "s": 16,
          "text": "הוא שהמטה הוא כלי לזה."
        },
        {
          "s": 17,
          "text": "ועד\"ז הוא בהענין דקיבוץ גלויות"
        },
        {
          "s": 18,
          "text": "(דהגאולה),"
        },
        {
          "s": 19,
          "text": "שיהי' בכל ששה הקצוות"
        },
        {
          "s": 20,
          "text": "(דמקום),"
        },
        {
          "s": 21,
          "text": "ממזרח אביא זרעך וממערב אקבצך אמר לצפון תני ולתימן אל תכלאי הביאי בני מרחוק ובנותי מקצה הארץ70,"
        },
        {
          "s": 22,
          "text": "דיש לומר שרחוק וקצה הם כנגד ב' הקצוות מעלה ומטה."
        },
        {
          "s": 23,
          "text": "ויש לומר,"
        },
        {
          "s": 24,
          "text": "שקיבוץ הגליות מכל הששה קצוות תהי' באופן שהששה קצוות יסייעו לזה71."
        }
      ]
    },
    {
      "v": 25,
      "items": [
        {
          "s": 0,
          "text": "והנה אף שהגילוי שיומשך בעולם יהי' רק מעין הגילוי שבביהמ\"ק עצמו,"
        },
        {
          "s": 1,
          "text": "מ\"מ יש יתרון בההמשכה בעולם."
        },
        {
          "s": 2,
          "text": "כי היחוד דהוי' ואלקים שבביהמ\"ק עצמו,"
        },
        {
          "s": 3,
          "text": "כיון שלית דין אתר הדיוט,"
        },
        {
          "s": 4,
          "text": "אין ניכר בזה כ\"כ שהיחוד דהוי' ואלקים הוא גם מצד שם אלקים,"
        },
        {
          "s": 5,
          "text": "והגילוי דענין זה"
        },
        {
          "s": 6,
          "text": "(שהיחוד הוא גם מצד שם אלקים)"
        },
        {
          "s": 7,
          "text": "הוא בעיקר ע\"י שנמשך מעין הגילוי דביהמ\"ק בעולם,"
        },
        {
          "s": 8,
          "text": "אתר הדיוט."
        },
        {
          "s": 9,
          "text": "ועפ\"ז יש לבאר היתרון דהגאולה לגבי ביהמ\"ק"
        },
        {
          "s": 10,
          "text": "[שלכן תהי' הגאולה לאחרי בנין ביהמ\"ק,"
        },
        {
          "s": 11,
          "text": "כנ\"ל סעיף ב],"
        },
        {
          "s": 12,
          "text": "כי המשכת הגילוי דביהמ\"ק בעולם תהי'"
        },
        {
          "s": 13,
          "text": "(בעיקר)"
        },
        {
          "s": 14,
          "text": "בהגאולה,"
        },
        {
          "s": 15,
          "text": "כנ\"ל."
        }
      ]
    },
    {
      "v": 26,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "ועיקר הגילוי דיחוד הוי' ואלקים"
        },
        {
          "s": 3,
          "text": "(שהיחוד הוא גם מצד אלקים)"
        },
        {
          "s": 4,
          "text": "יהי' בתחיית המתים שלאחרי קיבוץ גלויות,"
        },
        {
          "s": 5,
          "text": "אחרון שבכולם."
        },
        {
          "s": 6,
          "text": "דהגילוי שיהי' בעולם"
        },
        {
          "s": 7,
          "text": "(גאולה מגלות וקיבוץ גלויות)"
        },
        {
          "s": 8,
          "text": "הוא גילוי מוגבל"
        },
        {
          "s": 9,
          "text": "(בערך הגילויים שיהיו לע\"ל),"
        },
        {
          "s": 10,
          "text": "וכנ\"ל שהוא רק מעין הגילוי דביהמ\"ק,"
        },
        {
          "s": 11,
          "text": "ובתחה\"מ,"
        },
        {
          "s": 12,
          "text": "שאז יהי' חיות הגוף מהסובב72"
        },
        {
          "s": 13,
          "text": "[נעלה יותר מהחיות דהנשמה,"
        },
        {
          "s": 14,
          "text": "שלכן,"
        },
        {
          "s": 15,
          "text": "הנשמה תהי' ניזונית מהגוף72],"
        },
        {
          "s": 16,
          "text": "יהיו שתי המעלות."
        },
        {
          "s": 17,
          "text": "גילוי בל\"ג"
        },
        {
          "s": 18,
          "text": "(סובב),"
        },
        {
          "s": 19,
          "text": "וגילוי זה יהי' בהגוף ששרשו הוא73"
        },
        {
          "s": 20,
          "text": "משם אלקים."
        }
      ]
    }
  ]
}