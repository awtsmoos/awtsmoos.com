{
  "globalIndex": 196,
  "owner": 46,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914911_theRebbe_655__p004",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914911_theRebbe_655__p004",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518914911_theRebbe_655",
  "title": "מאמר ויהיו חיי שרה תשמ\"א",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וביאור ענין השמחה שבבחי' ביטול"
        },
        {
          "s": 2,
          "text": "(ועד שגם כשהשמחה היא בהתגלות מ\"מ היא בבחי' ביטול),"
        },
        {
          "s": 3,
          "text": "הנה אמיתית ענין השמחה בא מצד הענוה והביטול,"
        },
        {
          "s": 4,
          "text": "כמ\"ש35"
        },
        {
          "s": 5,
          "text": "ויספו ענוים בה' שמחה."
        },
        {
          "s": 6,
          "text": "וביאור השייכות דענוה ושמחה"
        },
        {
          "s": 7,
          "text": "(אף שלכאורה הם שני ענינים הפכיים),"
        },
        {
          "s": 8,
          "text": "מבאר כ\"ק אדמו\"ר הזקן בד\"ה ויספו ענוים בה' שמחה60"
        },
        {
          "s": 9,
          "text": "[ובכמה דרושי רבותינו נשיאינו שלאח\"ז61,"
        },
        {
          "s": 10,
          "text": "וגם במאמר הנ\"ל של בעל יום ההולדת],"
        },
        {
          "s": 11,
          "text": "דענין הענוה הוא לא שהעניו טועה בעצמו ואינו יודע את מעלותיו,"
        },
        {
          "s": 12,
          "text": "כי אם,"
        },
        {
          "s": 13,
          "text": "דהגם שהוא יודע את המעלות שלו,"
        },
        {
          "s": 14,
          "text": "ועד שיודע את כל המעלות שלו"
        },
        {
          "s": 15,
          "text": "[דכאו\"א מישראל,"
        },
        {
          "s": 16,
          "text": "אפילו אלו שהנהגתם היא שלא כדבעי כלל,"
        },
        {
          "s": 17,
          "text": "לא רק שיש להם מצוות אלא שהמצוות ממלאים את מציאותם,"
        },
        {
          "s": 18,
          "text": "ובלשון רז\"ל62"
        },
        {
          "s": 19,
          "text": "מלאים מצוות כרימון,"
        },
        {
          "s": 20,
          "text": "ובפרט אשר ועמך כולם צדיקים63"
        },
        {
          "s": 21,
          "text": "וכל ישראל בחזקת כשרות64],"
        },
        {
          "s": 22,
          "text": "מ\"מ אינו נעשה עי\"ז למציאות בעיני עצמו ועאכו\"כ שאינו בבחי' ישות,"
        },
        {
          "s": 23,
          "text": "כי יודע את האמת שהמעלות שיש לו אינם כחו ועוצם ידו כ\"א ניתנו לו"
        },
        {
          "s": 24,
          "text": "(הכחות על זה)"
        },
        {
          "s": 25,
          "text": "מלמעלה,"
        },
        {
          "s": 26,
          "text": "ובאם היו נותנים כחות אלו לאחר הי' ג\"כ במדריגה זו,"
        },
        {
          "s": 27,
          "text": "ומצד הענוה והביטול שלו הוא חושב,"
        },
        {
          "s": 28,
          "text": "שאילו היו כחות אלו אצל אחר הי' מגלה אותם עוד יותר."
        },
        {
          "s": 29,
          "text": "וענוה זו"
        },
        {
          "s": 30,
          "text": "[מכיון שהוא יודע את המעלות,"
        },
        {
          "s": 31,
          "text": "אלא שאינו נעשה עי\"ז למציאות]"
        },
        {
          "s": 32,
          "text": "הנה לא רק שאינה מביאה להיפך השמחה,"
        },
        {
          "s": 33,
          "text": "אלא אדרבא,"
        },
        {
          "s": 34,
          "text": "הענוה והביטול שלו"
        },
        {
          "s": 35,
          "text": "(שחושב שאינו מגיע לו כלום)"
        },
        {
          "s": 36,
          "text": "מביאה אותו לשמחה גדולה ושלימה."
        },
        {
          "s": 37,
          "text": "דשלימות השמחה היא דוקא במי שהוא בטל,"
        },
        {
          "s": 38,
          "text": "כמבואר בהמאמר בארוכה."
        },
        {
          "s": 39,
          "text": "ומכיון שהשמחה באה בסיבת הענוה והביטול,"
        },
        {
          "s": 40,
          "text": "לכן גם השמחה עצמה"
        },
        {
          "s": 41,
          "text": "(גם כשהיא בהתגלות)"
        },
        {
          "s": 42,
          "text": "היא בבחי' ביטול."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וזהו ויהיו חיי שרה גו' שני חיי שרה,"
        },
        {
          "s": 2,
          "text": "ויהיו חיי שרה הוא מה שזכתה לחיין עילאין."
        },
        {
          "s": 3,
          "text": "ומפרט בזה מאה שנה ועשרים שנה ושבע שנים שקאי על כל הספירות65."
        },
        {
          "s": 4,
          "text": "וכמבואר בהמאמר66"
        },
        {
          "s": 5,
          "text": "דמאה שנה הוא בחי' אריך כמו שמאיר בו בחי' עתיק,"
        },
        {
          "s": 6,
          "text": "שלכן נאמר"
        },
        {
          "s": 7,
          "text": "(מאה)"
        },
        {
          "s": 8,
          "text": "שנה לשון יחיד,"
        },
        {
          "s": 9,
          "text": "ויש לומר שבנדו\"ד למעלה מבחי' אחד67."
        },
        {
          "s": 10,
          "text": "ועשרים שנה הוא בחי' חו\"ב,"
        },
        {
          "s": 11,
          "text": "ושבע שנים הוא בחי' ז' מדות,"
        },
        {
          "s": 12,
          "text": "שבעת ימי הבנין."
        },
        {
          "s": 13,
          "text": "ואח\"כ מוסיף שני חיי שרה,"
        },
        {
          "s": 14,
          "text": "דילה הוו חיין,"
        },
        {
          "s": 15,
          "text": "שהחיין הן דילה"
        },
        {
          "s": 16,
          "text": "(גם)"
        },
        {
          "s": 17,
          "text": "במורגש,"
        },
        {
          "s": 18,
          "text": "שבעבודה הו\"ע הביטול בהשמחה"
        },
        {
          "s": 19,
          "text": "(גם)"
        },
        {
          "s": 20,
          "text": "כמו שהיא בהתגלות"
        },
        {
          "s": 21,
          "text": "(כנ\"ל מהמאמר דבעל יום ההולדת)."
        },
        {
          "s": 22,
          "text": "וזהו גם הטעם לזה שבהסיום שני חיי שרה אינו מפרט המספרים דמאה עשרים ושבע,"
        },
        {
          "s": 23,
          "text": "כי זה שגם המורגש הוא בביטול,"
        },
        {
          "s": 24,
          "text": "שהוא יחוד שני ענינים הפכים"
        },
        {
          "s": 25,
          "text": "(מורגש וביטול),"
        },
        {
          "s": 26,
          "text": "הוא מבחי' שלמעלה מהתחלקות68."
        },
        {
          "s": 27,
          "text": "וזהו העילוי דשני חיי שרה על חיי שרה מאה שנה וגו',"
        },
        {
          "s": 28,
          "text": "דענין מאה שנה ועשרים שנה ושבע שנים,"
        },
        {
          "s": 29,
          "text": "עם היותו נעלה ביותר,"
        },
        {
          "s": 30,
          "text": "כמובן גם מפרש\"י עה\"פ,"
        },
        {
          "s": 31,
          "text": "מ\"מ הם ג' ענינים חלוקים,"
        },
        {
          "s": 32,
          "text": "משא\"כ שני חיי שרה הוא שכולן שוין69,"
        },
        {
          "s": 33,
          "text": "למעלה מהתחלקות."
        },
        {
          "s": 34,
          "text": "ומצד בחינה זו"
        },
        {
          "s": 35,
          "text": "(שלמעלה מהתחלקות),"
        },
        {
          "s": 36,
          "text": "גם המורגש הוא בביטול70,"
        },
        {
          "s": 37,
          "text": "דילה הוו חיין."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דע\"י ענין דילה הוו חיין בעבודה,"
        },
        {
          "s": 2,
          "text": "שגם המורגש"
        },
        {
          "s": 3,
          "text": "(שמחה שבהתגלות)"
        },
        {
          "s": 4,
          "text": "הוא בביטול"
        },
        {
          "s": 5,
          "text": "(כפירוש בעל יום ההולדת בדילה הוו חיין),"
        },
        {
          "s": 6,
          "text": "עי\"ז נעשה דילה הוו חיין גם בפשטות,"
        },
        {
          "s": 7,
          "text": "שהחיים הן שלה והיא נעשית בעה\"ב על החיים."
        },
        {
          "s": 8,
          "text": "כי שמחה פורץ כל הגדרים71,"
        },
        {
          "s": 9,
          "text": "ולכן ע\"י השמחה בהתגלות"
        },
        {
          "s": 10,
          "text": "(ובבחי' ביטול)"
        },
        {
          "s": 11,
          "text": "נעשה תגבורת החיים"
        },
        {
          "s": 12,
          "text": "(למעלה מגדר והגבלה),"
        },
        {
          "s": 13,
          "text": "וע\"ד הידוע72"
        },
        {
          "s": 14,
          "text": "בענין יצחק"
        },
        {
          "s": 15,
          "text": "[שענינו הוא צחוק ושמחה,"
        },
        {
          "s": 16,
          "text": "כנ\"ל],"
        },
        {
          "s": 17,
          "text": "שהגבורות דיצחק הו\"ע תגבורת החיות"
        },
        {
          "s": 18,
          "text": "(ותגבורת הברכות),"
        },
        {
          "s": 19,
          "text": "ועד לחיים בתכלית השלימות,"
        },
        {
          "s": 20,
          "text": "דוגמת ונחי' לפניו שיהי' לעתיד לבוא."
        }
      ]
    }
  ]
}