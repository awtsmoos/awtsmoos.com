{
  "globalIndex": 620,
  "owner": 20,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917370_theRebbe_643__p001",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917370_theRebbe_643__p001",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917370_theRebbe_643",
  "title": "מאמר וקבל היהודים תשל\"ח",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "יום ג',"
        },
        {
          "s": 2,
          "text": "פורים קטן ה'תשל\"ח*."
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "וקבל היהודים את אשר החלו לעשות1,"
        },
        {
          "s": 1,
          "text": "ומבאר בזה כ\"ק מו\"ח אדמו\"ר נשיא דורנו במאמרו הידוע2"
        },
        {
          "s": 2,
          "text": "שאמרו בפורים קטן"
        },
        {
          "s": 3,
          "text": "(תרפ\"ז)"
        },
        {
          "s": 4,
          "text": "במוסקבא"
        },
        {
          "s": 5,
          "text": "[אשר שנה זו היא התחלת יובל3"
        },
        {
          "s": 6,
          "text": "השני4"
        },
        {
          "s": 7,
          "text": "לאמירתו]"
        },
        {
          "s": 8,
          "text": "דעתה בזמן הגלות הם קבלו מה שהחלו כבר בזמן דמתן תורה."
        },
        {
          "s": 9,
          "text": "וכמאמרם ז\"ל5"
        },
        {
          "s": 10,
          "text": "על פסוק6"
        },
        {
          "s": 11,
          "text": "קיימו וקבלו היהודים וכו',"
        },
        {
          "s": 12,
          "text": "דקיימו עתה"
        },
        {
          "s": 13,
          "text": "(בימי אחשורוש)"
        },
        {
          "s": 14,
          "text": "מה שקבלו כבר בזמן דמ\"ת."
        },
        {
          "s": 15,
          "text": "ומדייק בזה בהמאמר,"
        },
        {
          "s": 16,
          "text": "דלכאורה הוא דבר נפלא"
        },
        {
          "s": 17,
          "text": "[ומדייק בשאלתו שזהו ענין \"נפלא\""
        },
        {
          "s": 18,
          "text": "(ולא כלשון הרגיל ברוב המאמרים – \"צלה\"ב\")"
        },
        {
          "s": 19,
          "text": "כי הענין"
        },
        {
          "s": 20,
          "text": "(דקבלו בזמן הגלות מה שהחלו בזמן מ\"ת)"
        },
        {
          "s": 21,
          "text": "הוא בבחי' נפלא."
        },
        {
          "s": 22,
          "text": "וכמבואר7"
        },
        {
          "s": 23,
          "text": "בענין לא נפלאת גו' ולא רחוקה8,"
        },
        {
          "s": 24,
          "text": "דריחוק וקירוב הוא בערך זל\"ז,"
        },
        {
          "s": 25,
          "text": "אבל נפלא מורה על ענין של הפלאה והבדלה ועד שהוא בבחי' פלא לגבי',"
        },
        {
          "s": 26,
          "text": "והיינו שהוא ענין שבאין ערוך לגמרי."
        },
        {
          "s": 27,
          "text": "וכידוע9"
        },
        {
          "s": 28,
          "text": "(בענין הספירות)"
        },
        {
          "s": 29,
          "text": "שבחי' פלא הוא בחי' הכתר,"
        },
        {
          "s": 30,
          "text": "ובפרטיות בחי' פנימיות הכתר,"
        },
        {
          "s": 31,
          "text": "שזהו באי\"ע לגמרי לכל סדר ההשתלשלות."
        },
        {
          "s": 32,
          "text": "ומזה יובן גם בנוגע לענין הנפלא המובא בהמאמר],"
        },
        {
          "s": 33,
          "text": "דבמתן תורה"
        },
        {
          "s": 34,
          "text": "(כאשר החלו לעשות)"
        },
        {
          "s": 35,
          "text": "היו ישראל בתכלית העילוי ובמעמד ומצב משובח,"
        },
        {
          "s": 36,
          "text": "והי' אז לאחרי קריעת ים סוף ויציאת מצרים,"
        },
        {
          "s": 37,
          "text": "שהם ענינים וואָס האָבן אַוועקגעשטעלט את כאו\"א מישראל ואת כללות עם ישראל במעמד נעלה ביותר,"
        },
        {
          "s": 38,
          "text": "דביצי\"מ נגלה עליהם ממה\"מ הקב\"ה בכבודו ובעצמו וגאלם,"
        },
        {
          "s": 39,
          "text": "ובשעת קרי\"ס"
        },
        {
          "s": 40,
          "text": "[שהוא הסיום וחותם דיצי\"מ10]"
        },
        {
          "s": 41,
          "text": "ראתה שפחה על הים מה שלא ראו נביאים11,"
        },
        {
          "s": 42,
          "text": "ועאכו\"כ תכלית העילוי דבנ\"י בזמן מ\"ת,"
        },
        {
          "s": 43,
          "text": "דמ\"ת הי' רק פעם אחת וכידוע12"
        },
        {
          "s": 44,
          "text": "שמ\"ת לא יהי' עוד הפעם,"
        },
        {
          "s": 45,
          "text": "וגם מבואר בתניא13"
        },
        {
          "s": 46,
          "text": "שבשעת מ\"ת כבר הי' מעין תכלית שלימות העולם שיהי' לע\"ל,"
        },
        {
          "s": 47,
          "text": "שהי' גילוי אלקות בראי' חושיית,"
        },
        {
          "s": 48,
          "text": "שמצד גילויים אלו היו ישראל בתכלית המעלה."
        },
        {
          "s": 49,
          "text": "משא\"כ בזמן הגלות הוא ההיפך מזה ממש,"
        },
        {
          "s": 50,
          "text": "שישראל הם בתחתית הירידה."
        },
        {
          "s": 51,
          "text": "ובפרט בזמן המן"
        },
        {
          "s": 52,
          "text": "(כאשר הי' וקבל היהודים גו' קיימו גו')"
        },
        {
          "s": 53,
          "text": "שבקש ח\"ו להשמיד להרוג ולאבד את כל היהודים מנער ועד זקן טף ונשים ביום אחד גו'14,"
        },
        {
          "s": 54,
          "text": "דגזירה זו היתה קשה ביותר שהרי היתה בבת אחת על כל היהודים שבכל העולם,"
        },
        {
          "s": 55,
          "text": "כי אחשורוש מושל בכיפה הי' כדאיתא במדרש15,"
        },
        {
          "s": 56,
          "text": "ולא הי' ביכולת להמלט למקום שכבר הי' אחר הגזירה כיון שהיתה ביום אחד"
        },
        {
          "s": 57,
          "text": "(בכל העולם),"
        },
        {
          "s": 58,
          "text": "שזהו"
        },
        {
          "s": 59,
          "text": "(בגלות גופא)"
        },
        {
          "s": 60,
          "text": "גלות הכי נורא."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ומבאר בהמאמר שם שתוקף"
        },
        {
          "s": 1,
          "text": "(הגזירה ו)"
        },
        {
          "s": 2,
          "text": "הגלות ברוחניות הי' הגזירה על ענין החינוך."
        },
        {
          "s": 3,
          "text": "וכדאיתא במדרש16"
        },
        {
          "s": 4,
          "text": "אמר"
        },
        {
          "s": 5,
          "text": "(המן)"
        },
        {
          "s": 6,
          "text": "אין אני שולח ידי תחלה אלא באלו התינוקות."
        },
        {
          "s": 7,
          "text": "והיינו דבכדי להפיק ח\"ו זממו ומחשבתו הרעה אשר חשב על היהודים רח\"ל לאבדם17,"
        },
        {
          "s": 8,
          "text": "הנה ההתחלה היא מאלו התינוקות של בית רבן."
        },
        {
          "s": 9,
          "text": "דהכוונה בזה היא הגזירה על כללות ענין החינוך,"
        },
        {
          "s": 10,
          "text": "וי\"ל שאף שבהנ\"ל תשב\"ר קאי על תינוק בשנים אבל מעין זה הוא גם בתינוק בעניני יהדות,"
        },
        {
          "s": 11,
          "text": "הגם שהוא איש גדול בשנים ובלשון כ\"ק מו\"ח אדמו\"ר ער האָט שוין ווייסע האָר,"
        },
        {
          "s": 12,
          "text": "מ\"מ במצבו בעניני תומ\"צ הוא בבחי' תינוק."
        },
        {
          "s": 13,
          "text": "[ומזה גופא"
        },
        {
          "s": 14,
          "text": "(שבהחינוך תלוי קיומו של עם ישראל)"
        },
        {
          "s": 15,
          "text": "מובן גודל המס\"נ שצ\"ל על חינוך בנ\"י."
        },
        {
          "s": 16,
          "text": "שצריך למסור נפשו בכדי שיהי' אל תגעו במשיחי18"
        },
        {
          "s": 17,
          "text": "אלו תינוקות של בית רבן כדאיתא במסכת שבת19,"
        },
        {
          "s": 18,
          "text": "אשר זה נעשה ע\"י שמכניסים את התינוקות אל מקומם הראוי,"
        },
        {
          "s": 19,
          "text": "אל בית רבן,"
        },
        {
          "s": 20,
          "text": "ושם גופא אופן החינוך הוא באופן של \"בית"
        },
        {
          "s": 21,
          "text": "(רבן)"
        },
        {
          "s": 22,
          "text": "\" וקבע,"
        },
        {
          "s": 23,
          "text": "היינו שהתינוקות יקבלו מרבן היסוד"
        },
        {
          "s": 24,
          "text": "(דעם גאַנצן שטעל)"
        },
        {
          "s": 25,
          "text": "על כל ימי חייהם]."
        }
      ]
    }
  ]
}