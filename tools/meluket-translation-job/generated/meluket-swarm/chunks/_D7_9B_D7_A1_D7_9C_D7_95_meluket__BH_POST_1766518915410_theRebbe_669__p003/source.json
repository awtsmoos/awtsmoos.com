{
  "globalIndex": 283,
  "owner": 33,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915410_theRebbe_669__p003",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915410_theRebbe_669__p003",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915410_theRebbe_669",
  "title": "מאמר פדה בשלום תשמ\"ו",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "וע\"פ הידוע23"
        },
        {
          "s": 1,
          "text": "בפירוש מאמר רז\"ל24"
        },
        {
          "s": 2,
          "text": "נפרעין מן האדם מדעתו ושלא מדעתו"
        },
        {
          "s": 3,
          "text": "(ועד\"ז בפירוש לשון המשנה25"
        },
        {
          "s": 4,
          "text": "דין וחשבון),"
        },
        {
          "s": 5,
          "text": "דכאשר אדם אומר פסק דינו של אדם אחר הוא פוסק בזה גם על עצמו,"
        },
        {
          "s": 6,
          "text": "הרי פסק דינו של אדמו\"ר האמצעי במאמרו ד\"ה פדה בשלום נפשי,"
        },
        {
          "s": 7,
          "text": "דפירוש פדה בשלום נפשי הוא שהמנגד מתבטל"
        },
        {
          "s": 8,
          "text": "(כהשלום שהי' בימי שלמה),"
        },
        {
          "s": 9,
          "text": "ויתירה מזו,"
        },
        {
          "s": 10,
          "text": "שהמנגד נהפך לאוהב"
        },
        {
          "s": 11,
          "text": "(כהשלום שיהי' לע\"ל),"
        },
        {
          "s": 12,
          "text": "הוא פס\"ד גם בנוגע לענין פדה בשלום נפשי שבהגאולה שלו – גאולה דיו\"ד כסלו,"
        },
        {
          "s": 13,
          "text": "[ומזה מובן גם בנוגע לענין פדה בשלום נפשי שבהגאולה די\"ט כסלו ובהגאולה די\"ב תמוז],"
        },
        {
          "s": 14,
          "text": "דענין השלום שבגאולות אלו הוא שהמנגד מתבטל,"
        },
        {
          "s": 15,
          "text": "ויתירה מזו,"
        },
        {
          "s": 16,
          "text": "שהוא נהפך לאוהב."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה פירוש הכתוב פדה בשלום נפשי בפשטות הוא,"
        },
        {
          "s": 2,
          "text": "שדוד אמר זה על הפדי' שלו כמו שהוא בעולם הזה,"
        },
        {
          "s": 3,
          "text": "שפדי' זו היא בשלום."
        },
        {
          "s": 4,
          "text": "וצריך להבין הקשר והשייכות דהפירוש שבהמאמר דזה שאמר דוד פדה בשלום נפשי קאי על נפש דוד כמו שיהי' לע\"ל,"
        },
        {
          "s": 5,
          "text": "עם הפירוש הפשוט שפדיית דוד עכשיו היתה פדי' בשלום."
        },
        {
          "s": 6,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 7,
          "text": "ע\"פ מ\"ש הרמב\"ם26"
        },
        {
          "s": 8,
          "text": "דבפרשת בלעם מדבר בשני המשיחים,"
        },
        {
          "s": 9,
          "text": "במשיח הראשון שהוא דוד ובמשיח האחרון שעומד מבניו."
        },
        {
          "s": 10,
          "text": "ויש לומר,"
        },
        {
          "s": 11,
          "text": "דהטעם על זה שדוד נקרא בשם משיח הראשון הוא,"
        },
        {
          "s": 12,
          "text": "לפי שכל הענינים שיהיו ע\"י מלך המשיח"
        },
        {
          "s": 13,
          "text": "(משיח האחרון),"
        },
        {
          "s": 14,
          "text": "התחלתם היתה ע\"י דוד,"
        },
        {
          "s": 15,
          "text": "משיח הראשון."
        },
        {
          "s": 16,
          "text": "אלא שהגמר והשלימות שלהם יהי' ע\"י משיח האחרון שעומד מבניו של דוד."
        },
        {
          "s": 17,
          "text": "ועפ\"ז יש לבאר הקשר דשני הפירושים בפסוק פדה בשלום נפשי,"
        },
        {
          "s": 18,
          "text": "שבפנימיות,"
        },
        {
          "s": 19,
          "text": "גם הפדי' דדוד עכשיו היתה פדי' בשלום."
        },
        {
          "s": 20,
          "text": "היינו שנתבטלו המנגדים"
        },
        {
          "s": 21,
          "text": "(ולא רק שלא לחמו עמו)"
        },
        {
          "s": 22,
          "text": "ויתירה מזו שנהפכו לאוהבים."
        },
        {
          "s": 23,
          "text": "אלא שבדוד הי' זה בפנימיות ובהעלם,"
        },
        {
          "s": 24,
          "text": "ולע\"ל תתגלה הפנימיות דפדיית נפש של דוד,"
        },
        {
          "s": 25,
          "text": "שהיא פדי' בשלום."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יובן עוד יותר גודל העילוי דהגאולה דיו\"ד כסלו,"
        },
        {
          "s": 1,
          "text": "דמזה שאומרים עלי' שהיא פדי' בשלום"
        },
        {
          "s": 2,
          "text": "(בלי הוספת הסברה שהיא הכנה לפדה בשלום דלע\"ל,"
        },
        {
          "s": 3,
          "text": "וכיו\"ב),"
        },
        {
          "s": 4,
          "text": "מוכח,"
        },
        {
          "s": 5,
          "text": "דענין השלום שבה"
        },
        {
          "s": 6,
          "text": "[שהמנגד מתבטל,"
        },
        {
          "s": 7,
          "text": "ויתירה מזו שנהפך לאוהב]"
        },
        {
          "s": 8,
          "text": "הוא"
        },
        {
          "s": 9,
          "text": "(גם)"
        },
        {
          "s": 10,
          "text": "בגילוי."
        }
      ]
    }
  ]
}