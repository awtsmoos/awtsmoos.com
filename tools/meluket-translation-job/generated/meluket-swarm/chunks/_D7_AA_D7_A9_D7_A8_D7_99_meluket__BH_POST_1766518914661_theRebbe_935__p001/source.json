  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914661_theRebbe_935__p001",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914661_theRebbe_935__p001",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914661_theRebbe_935",
  "title": "מאמר כנשר יעיר קנו תשכ\"ב",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ האזינו,"
        },
        {
          "s": 2,
          "text": "י\"ג תשרי*,"
        },
        {
          "s": 3,
          "text": "ה'תשכ\"ב"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "(הנחה בלתי מוגה)"
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "כנשר יעיר קנו גו' ישאהו על אברתו ה' בדד ינחנו1,"
        },
        {
          "s": 1,
          "text": "וקאי על מ\"ש לעיל מיני'2"
        },
        {
          "s": 2,
          "text": "יצרנהו כאישון עינו,"
        },
        {
          "s": 3,
          "text": "שעי\"ז שיצרנהו כאישון עינו עי\"ז כנשר יעיר קנו,"
        },
        {
          "s": 4,
          "text": "ולכן ישאהו על אברתו הוי' בדד ינחנו."
        },
        {
          "s": 5,
          "text": "ופירוש יצרנהו כאישון עינו,"
        },
        {
          "s": 6,
          "text": "הנה ידוע3"
        },
        {
          "s": 7,
          "text": "שישנם ספירות ומלאכים שנק' בשם עינים,"
        },
        {
          "s": 8,
          "text": "וכמבואר בתו\"א4"
        },
        {
          "s": 9,
          "text": "בענין עיני הוי' משוטטים ומשוטטות שהם ב' סוגים במלאכים,"
        },
        {
          "s": 10,
          "text": "אמנם ישראל שהם לפנים ממלאכי השרת הם בחי' אישון עינו."
        },
        {
          "s": 11,
          "text": "שהעין עם היותו כלי לכח הראי',"
        },
        {
          "s": 12,
          "text": "מ\"מ הנה עיקר הראי' הוא מהאישון שבעין,"
        },
        {
          "s": 13,
          "text": "וזהו מעלת ישראל על המלאכים,"
        },
        {
          "s": 14,
          "text": "שהמלאכים נק' בשם עינים בכללות,"
        },
        {
          "s": 15,
          "text": "וישראל הם בחי' אישון עינו."
        }
      ]
    }
  ]
}