{
  "globalIndex": 870,
  "owner": 20,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918918_theRebbe_323__p001",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918918_theRebbe_323__p001",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918918_theRebbe_323",
  "title": "מאמר ועתה יגדל נא תשי\"ט",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ שלח,"
        },
        {
          "s": 2,
          "text": "כ\"ח סיון,"
        },
        {
          "s": 3,
          "text": "מבה\"ח תמוז ה'תשי\"ט"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "ועתה יגדל נא כח אד' כאשר דברת לאמר1,"
        },
        {
          "s": 1,
          "text": "ופירש רש\"י2"
        },
        {
          "s": 2,
          "text": "ומהו הדיבור ה'3"
        },
        {
          "s": 3,
          "text": "ארך אפים."
        },
        {
          "s": 4,
          "text": "דמשמעות לשון הכתוב בפשטות היא,"
        },
        {
          "s": 5,
          "text": "שהדיבור דהקב\"ה"
        },
        {
          "s": 6,
          "text": "(כאשר דברת)"
        },
        {
          "s": 7,
          "text": "הוא יגדל כח אד',"
        },
        {
          "s": 8,
          "text": "ולכן הוצרך רש\"י לפרש שע\"פ דרך הפשט הפירוש הוא ה' ארך אפים."
        },
        {
          "s": 9,
          "text": "אבל מזה שהפסוק נאמר בלשון זה שהמשמעות שלו היא שהדיבור הוא שיגדל כח אד',"
        },
        {
          "s": 10,
          "text": "משמע שכוונת הכתוב היא גם לענין זה."
        },
        {
          "s": 11,
          "text": "וכדאיתא בגמרא4"
        },
        {
          "s": 12,
          "text": "בשעה שעלה משה למרום כו' אמר לו"
        },
        {
          "s": 13,
          "text": "(הקב\"ה למשה)"
        },
        {
          "s": 14,
          "text": "הי' לך לעזרני"
        },
        {
          "s": 15,
          "text": "(לומר תצלח מלאכתך5),"
        },
        {
          "s": 16,
          "text": "מיד אמר לו ועתה יגדל נא כח אד' כאשר דברת."
        },
        {
          "s": 17,
          "text": "היינו דכאשר דברת קאי על האמירה הי' לך לעזרני,"
        },
        {
          "s": 18,
          "text": "דענין לעזרני"
        },
        {
          "s": 19,
          "text": "[שיהי' עזר"
        },
        {
          "s": 20,
          "text": "(הוספה)"
        },
        {
          "s": 21,
          "text": "בהכח של מעלה]"
        },
        {
          "s": 22,
          "text": "הוא יגדל כח אד'."
        },
        {
          "s": 23,
          "text": "ויש להוסיף,"
        },
        {
          "s": 24,
          "text": "דמשמעות לשון הכתוב כאשר דברת לאמר הוא שהדיבור"
        },
        {
          "s": 25,
          "text": "(דהקב\"ה)"
        },
        {
          "s": 26,
          "text": "הוא לאמר"
        },
        {
          "s": 27,
          "text": "(שמשה יאמר)."
        },
        {
          "s": 28,
          "text": "וכמובן גם ממרז\"ל הנ\"ל דכאשר דברת קאי על מה שאמר הקב\"ה למשה הי' לך לעזרני,"
        },
        {
          "s": 29,
          "text": "שמשה יאמר6"
        },
        {
          "s": 30,
          "text": "תצלח מלאכתך."
        },
        {
          "s": 31,
          "text": "וע\"פ הידוע7"
        },
        {
          "s": 32,
          "text": "שכל הפירושים שבאותו הפסוק שייכים זה לזה,"
        },
        {
          "s": 33,
          "text": "מובן,"
        },
        {
          "s": 34,
          "text": "דג' פירושים אלה בכאשר דברת"
        },
        {
          "s": 35,
          "text": "[שקאי על יגדל כח אד',"
        },
        {
          "s": 36,
          "text": "על לאמר,"
        },
        {
          "s": 37,
          "text": "ועל ה' ארך אפים]"
        },
        {
          "s": 38,
          "text": "שייכים זה לזה."
        },
        {
          "s": 39,
          "text": "וצריך להבין השייכות דג' פירושים אלה."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויש לומר נקודת הביאור בזה,"
        },
        {
          "s": 2,
          "text": "דבקשת משה ועתה יגדל נא כח אד' גו' ה' ארך אפים גו' היא"
        },
        {
          "s": 3,
          "text": "(כמו שממשיך בכתוב8)"
        },
        {
          "s": 4,
          "text": "סלח נא לעון העם הזה גו',"
        },
        {
          "s": 5,
          "text": "מחילה סליחה וכפרה על חטא המרגלים."
        },
        {
          "s": 6,
          "text": "והנה בסליחה שני ענינים9."
        },
        {
          "s": 7,
          "text": "דשרש הסליחה הוא מבחינה שלמעלה מהשתלשלות,"
        },
        {
          "s": 8,
          "text": "כי בכדי למלאות הפגם צ\"ל המשכה ממקום נעלה ביותר שאין שייך בו פגם,"
        },
        {
          "s": 9,
          "text": "אבל בכדי שתהי' הסליחה"
        },
        {
          "s": 10,
          "text": "(מילוי הפגם)"
        },
        {
          "s": 11,
          "text": "בפועל,"
        },
        {
          "s": 12,
          "text": "צריכה להיות ההמשכה למטה,"
        },
        {
          "s": 13,
          "text": "בהמקום שבו הי' הפגם."
        },
        {
          "s": 14,
          "text": "וזהו ועתה יגדל נא כח אד' גו' ה' ארך אפים גו',"
        },
        {
          "s": 15,
          "text": "דשרש הסליחה היא מבחינת ה' ארך אפים גו',"
        },
        {
          "s": 16,
          "text": "י\"ג מדות הרחמים10"
        },
        {
          "s": 17,
          "text": "שלמעלה מהשתלשלות11,"
        },
        {
          "s": 18,
          "text": "ויגדל כח אד' הוא שתהי' ההמשכה למטה באד',"
        },
        {
          "s": 19,
          "text": "בכדי לתקן הפגם."
        },
        {
          "s": 20,
          "text": "דשם אד' הוא במלכות12,"
        },
        {
          "s": 21,
          "text": "והפגם דחטא המרגלים שלא רצו במצוות מעשיות13"
        },
        {
          "s": 22,
          "text": "הוא במלכות14,"
        },
        {
          "s": 23,
          "text": "וע\"י ההגדלה דכח אד' נתקן ונתמלא הפגם."
        }
      ]
    }
  ]
}