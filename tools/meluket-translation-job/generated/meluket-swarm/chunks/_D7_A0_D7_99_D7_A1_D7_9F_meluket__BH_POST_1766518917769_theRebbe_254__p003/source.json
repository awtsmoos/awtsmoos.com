{
  "globalIndex": 678,
  "owner": 28,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917769_theRebbe_254__p003",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917769_theRebbe_254__p003",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917769_theRebbe_254",
  "title": "מאמר ביום עשתי עשר תשל\"א",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וצריך להבין,"
        },
        {
          "s": 2,
          "text": "דלכאורה,"
        },
        {
          "s": 3,
          "text": "גם לביאור זה שבחירת הפקח בהמלך היא לא מצד התועלת שיהי' לו מזה אלא מצד מעלת המלך,"
        },
        {
          "s": 4,
          "text": "שלכן הוא מוותר על ריבוי ההשפעה הבאה על ידם,"
        },
        {
          "s": 5,
          "text": "בחירתו בהמלך היא מצד השכל45,"
        },
        {
          "s": 6,
          "text": "דמכיון שכולהו מתחלפין ומלכא לא מתחלף ראוי לוותר46"
        },
        {
          "s": 7,
          "text": "על ריבוי ההשפעה הבאה ע\"י השרים ולבחור בההשפעה המצומצמת שבאה מהמלך,"
        },
        {
          "s": 8,
          "text": "ומזה שמקשר במדרש ענין זה"
        },
        {
          "s": 9,
          "text": "(אנא נסיב מלכא)"
        },
        {
          "s": 10,
          "text": "עם חלקי הוי' אמרה נפשי,"
        },
        {
          "s": 11,
          "text": "משמע,"
        },
        {
          "s": 12,
          "text": "דזה שישראל בוחרים בהקב\"ה הוא מצד הנשמה"
        },
        {
          "s": 13,
          "text": "(שהיא חלק הוי')"
        },
        {
          "s": 14,
          "text": "שלמעלה מהשכל."
        },
        {
          "s": 15,
          "text": "ונקודת הביאור בזה,"
        },
        {
          "s": 16,
          "text": "דשכל האדם כמו שהוא מצד עצמו מכריח לרצות רק בזה שטוב לו."
        },
        {
          "s": 17,
          "text": "דזהו שאומות העולם בוחרים בהשרים,"
        },
        {
          "s": 18,
          "text": "אף שגם הם יכולים להבין שהמלך הוא העיקר"
        },
        {
          "s": 19,
          "text": "(דכולהו מתחלפין ומלכא לא מתחלף),"
        },
        {
          "s": 20,
          "text": "כי להיותם בבחינת יש,"
        },
        {
          "s": 21,
          "text": "אינם רוצים לוותר על התועלת שיהי' להם ע\"י שיקבלו מהשרים."
        },
        {
          "s": 22,
          "text": "וזה שבישראל ישנה ההכרה שצריך לוותר על התועלת והמציאות שלהם ולבחור באלקות,"
        },
        {
          "s": 23,
          "text": "הוא מצד הנשמה47"
        },
        {
          "s": 24,
          "text": "(חלק הוי')"
        },
        {
          "s": 25,
          "text": "שבחירתה באלקות היא בחירה עצמית שלמעלה מהשכל"
        },
        {
          "s": 26,
          "text": "(דבחירה זו היא לא מצד העילוי דאלקות,"
        },
        {
          "s": 27,
          "text": "שמלכא לא מתחלף,"
        },
        {
          "s": 28,
          "text": "אלא מצד העצמות),"
        },
        {
          "s": 29,
          "text": "וזה פועל על שכלם48,"
        },
        {
          "s": 30,
          "text": "שגם השכל מכיר דמכיון שאלקות הוא האמת שחי וקיים בקיום נצחי"
        },
        {
          "s": 31,
          "text": "(מלכא לא מתחלף),"
        },
        {
          "s": 32,
          "text": "צריך הוא לוותר על המציאות שלו ולבחור באלקות."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ואולי יש להוסיף,"
        },
        {
          "s": 2,
          "text": "דע\"י שהבחירה דהנשמה שלמעלה מהשכל נמשכת ופועלת בהשכל,"
        },
        {
          "s": 3,
          "text": "מיתוסף בה עילוי נעלה יותר מכמו שהיא מצד עצמה."
        },
        {
          "s": 4,
          "text": "ויובן זה בהקדים המבואר בסידור ד\"ה עבדים היינו לפרעה במצרים49,"
        },
        {
          "s": 5,
          "text": "בענין ההשפעה הנמשכת לעוברי רצונו50"
        },
        {
          "s": 6,
          "text": "שהיא רק בדרך אגב כמאן דשדי בתר כתפוי,"
        },
        {
          "s": 7,
          "text": "שהוא בדוגמת מלך51"
        },
        {
          "s": 8,
          "text": "שעושה סעודה ומשתה בשביל השרים הגדולים ועבדים החשובים ומוציא על זה ממון רב,"
        },
        {
          "s": 9,
          "text": "ומהשיריים של הסעודה מקבלים גם פחותי הערך כמו עבדים ושפחות שאחרי הרחיים,"
        },
        {
          "s": 10,
          "text": "ועד שגם הכלבים אוכלים את העצמות שמשליכים למטה."
        },
        {
          "s": 11,
          "text": "שבטח לא כיון המלך להוציא בשבילם הוצאות,"
        },
        {
          "s": 12,
          "text": "וזה שנשפע להם שיריים"
        },
        {
          "s": 13,
          "text": "(שגם השיריים של הסעודה הם הון רב)"
        },
        {
          "s": 14,
          "text": "הוא רק בדרך אגב."
        },
        {
          "s": 15,
          "text": "ועד\"ז הוא בהנמשל שההשפעה לעוברי רצונו היא רק בדרך אגב,"
        },
        {
          "s": 16,
          "text": "כמאן דשדי בתר כתפוי,"
        },
        {
          "s": 17,
          "text": "כמבואר שם בארוכה."
        },
        {
          "s": 18,
          "text": "ויש לומר,"
        },
        {
          "s": 19,
          "text": "דזה שמביא שני דוגמאות שההשפעה להם היא רק בדרך אגב"
        },
        {
          "s": 20,
          "text": "(ואינם יושבים בשולחן המלך),"
        },
        {
          "s": 21,
          "text": "עבדים ושפחות וכלבים,"
        },
        {
          "s": 22,
          "text": "ושני דוגמאות באלו שיושבים בשולחן המלך,"
        },
        {
          "s": 23,
          "text": "שרים גדולים ועבדים חשובים,"
        },
        {
          "s": 24,
          "text": "הוא,"
        },
        {
          "s": 25,
          "text": "בהתאם לד' דרגות בהנמשל."
        },
        {
          "s": 26,
          "text": "שדרגא הכי תחתונה הם הכלבים שאינם עובדים את המלך ורצונם הוא שיושפע להם גשמיות,"
        },
        {
          "s": 27,
          "text": "עוד ועוד,"
        },
        {
          "s": 28,
          "text": "כמ\"ש52"
        },
        {
          "s": 29,
          "text": "הכלבים עזי נפש לא ידעו שבעה."
        },
        {
          "s": 30,
          "text": "ויש לקשר זה עם הידוע53"
        },
        {
          "s": 31,
          "text": "שכלב הוא מלשון כולו לב."
        },
        {
          "s": 32,
          "text": "דטבע האדם בתולדתו וטבע יצירתו שהמוח שליט על הלב54,"
        },
        {
          "s": 33,
          "text": "וזה שהוא בבחינת כלב הוא בקצה ההפכי."
        },
        {
          "s": 34,
          "text": "דלא רק שהלב שליט על המוח,"
        },
        {
          "s": 35,
          "text": "אלא יתירה מזו שהוא כולו לב."
        },
        {
          "s": 36,
          "text": "ולכן כל55"
        },
        {
          "s": 37,
          "text": "ענינו הוא למלאות תאות לבו."
        },
        {
          "s": 38,
          "text": "ולמעלה מזה הם העבדים הפחותים56"
        },
        {
          "s": 39,
          "text": "(העבדים והשפחות שאחרי הרחיים),"
        },
        {
          "s": 40,
          "text": "שהם עובדים את המלך אלא שעבודתם היא רק מצד ההכרח"
        },
        {
          "s": 41,
          "text": "(מפני אימת הכאת השבט)57,"
        },
        {
          "s": 42,
          "text": "היפך הרצון והתענוג שלהם,"
        },
        {
          "s": 43,
          "text": "דעבדא בהפקירא ניחא לי'58."
        },
        {
          "s": 44,
          "text": "ומכיון שהרצון והתענוג שלהם הוא בתאוות עוה\"ז,"
        },
        {
          "s": 45,
          "text": "וזה שאינם עוברים על רצונו ית' הוא מפני יראת העונש,"
        },
        {
          "s": 46,
          "text": "מקומם הוא מחוץ לשולחן המלך."
        },
        {
          "s": 47,
          "text": "משא\"כ עבדים החשובים,"
        },
        {
          "s": 48,
          "text": "עבודתם את המלך היא ברצון וחשק."
        },
        {
          "s": 49,
          "text": "דהגם שעיקר עבודתם היא מצד קבלת עול"
        },
        {
          "s": 50,
          "text": "[כידוע59"
        },
        {
          "s": 51,
          "text": "החילוק בין בן לעבד,"
        },
        {
          "s": 52,
          "text": "דזה שהבן עושה רצון אביו הוא מפני האהבה וזה שהעבד ממלא רצון אדונו הוא בדרך קבלת עול],"
        },
        {
          "s": 53,
          "text": "מ\"מ,"
        },
        {
          "s": 54,
          "text": "זה גופא הוא ברצון וחשק,"
        },
        {
          "s": 55,
          "text": "שרוצים לקבל עליהם עול מלכות שמים."
        },
        {
          "s": 56,
          "text": "ולכן מקומם הוא בשולחן המלך."
        },
        {
          "s": 57,
          "text": "ולמעלה מהם הם השרים,"
        },
        {
          "s": 58,
          "text": "שיש להם ידיעה בהנהגת המלוכה"
        },
        {
          "s": 59,
          "text": "[שלכן כו\"כ ענינים בההנהגה מתנהגים על פיהם],"
        },
        {
          "s": 60,
          "text": "וגם יש להם השגה במעלת המלך ומפני זה יש להם אהבה אליו,"
        },
        {
          "s": 61,
          "text": "ועבודתם היא לא רק מצד קבלת עול אלא גם מצד אהבה."
        },
        {
          "s": 62,
          "text": "ובשרים גופא ישנם כו\"כ דרגות,"
        },
        {
          "s": 63,
          "text": "שנחלקות בכללות לשתים."
        },
        {
          "s": 64,
          "text": "שרים"
        },
        {
          "s": 65,
          "text": "(סתם)"
        },
        {
          "s": 66,
          "text": "ושרים גדולים."
        },
        {
          "s": 67,
          "text": "ויש לומר,"
        },
        {
          "s": 68,
          "text": "דג' סוגים אלו שנמצאים בשולחן המלך"
        },
        {
          "s": 69,
          "text": "[עבדים חשובים,"
        },
        {
          "s": 70,
          "text": "שרים ושרים גדולים]"
        },
        {
          "s": 71,
          "text": "הם בהתאם לג' הסוגים שבמדרש,"
        },
        {
          "s": 72,
          "text": "דוכסין ואיפרכין ואיסטרטילוטין,"
        },
        {
          "s": 73,
          "text": "שנמצאים יחד עם המלך,"
        },
        {
          "s": 74,
          "text": "כלשון המדרש \"והיו עמו\","
        },
        {
          "s": 75,
          "text": "בדוגמת עבדים החשובים והשרים שנמצאים בשולחן המלך."
        },
        {
          "s": 76,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 77,
          "text": "דהגם שהכוונה"
        },
        {
          "s": 78,
          "text": "(בפשטות)"
        },
        {
          "s": 79,
          "text": "בדוכסין וכו' היא להע' שרים דנוגה"
        },
        {
          "s": 80,
          "text": "(כמובא לעיל מהדרושים)60,"
        },
        {
          "s": 81,
          "text": "מ\"מ,"
        },
        {
          "s": 82,
          "text": "זה שמדייק שהדוכסין \"היו עמו\" הוא בכדי לרמז שמדבר כאן"
        },
        {
          "s": 83,
          "text": "[לא רק בהע' שרים,"
        },
        {
          "s": 84,
          "text": "שהם יש ודבר בפ\"ע61,"
        },
        {
          "s": 85,
          "text": "דוגמת עבדים הפחותים שמקומם הוא מחוץ לשולחן המלך,"
        },
        {
          "s": 86,
          "text": "אלא]"
        },
        {
          "s": 87,
          "text": "גם במלאכים שהם בטלים לאלקות,"
        },
        {
          "s": 88,
          "text": "ולמעלה יותר – בספירות דאצילות שאיהו וחיוהי וגרמוהי חד62,"
        },
        {
          "s": 89,
          "text": "שהם תמיד עם המלך."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז מובן עוד יותר גודל פקחותו של זה שאמר אנא נסיב מלכא,"
        },
        {
          "s": 1,
          "text": "דנוסף לזה שאינו רוצה לקבל ההשפעה בדוגמת הכלבים וגם לא כעבדים הפחותים שמחוץ לשולחן המלך"
        },
        {
          "s": 2,
          "text": "(הגם שההשפעה שנשפע להם היא בריבוי גדול)"
        },
        {
          "s": 3,
          "text": "ורוצה להיות בשולחן המלך,"
        },
        {
          "s": 4,
          "text": "אלא שאינו רוצה גם בהדוכסין וכו'"
        },
        {
          "s": 5,
          "text": "(מלאכים,"
        },
        {
          "s": 6,
          "text": "ספירות דאצילות ולמעלה יותר),"
        },
        {
          "s": 7,
          "text": "אלא בהמלך,"
        },
        {
          "s": 8,
          "text": "אנא נסיב מלכא."
        },
        {
          "s": 9,
          "text": "וכתורת הבעש\"ט63"
        },
        {
          "s": 10,
          "text": "הידועה עה\"פ64"
        },
        {
          "s": 11,
          "text": "תפלה לעני כי יעטוף ולפני הוי' ישפוך שיחו,"
        },
        {
          "s": 12,
          "text": "שאינו מבקש שום דבר ותפלתו היא שלפני הוי' ישפוך שיחו."
        },
        {
          "s": 13,
          "text": "ולזה צריך פקחות גדולה."
        },
        {
          "s": 14,
          "text": "ובדוגמת מלך בו\"ד,"
        },
        {
          "s": 15,
          "text": "שבכדי ליכנס להקיטון שבו נמצא המלך ולראות את פני המלך,"
        },
        {
          "s": 16,
          "text": "צריך לעבור תחילה דרך כמה וכמה היכלות שבכל אחד מהם יש הון יקר,"
        },
        {
          "s": 17,
          "text": "וישנם כאלו שכשרואים את ההון יקר שבהיכל החיצון,"
        },
        {
          "s": 18,
          "text": "הם מתענגים מזה בתענוג נפלא ומתעכבים שם."
        },
        {
          "s": 19,
          "text": "ויש כאלו שמתענגים בהיכל פנימי יותר."
        },
        {
          "s": 20,
          "text": "ודוקא מי שהוא חכם גדול,"
        },
        {
          "s": 21,
          "text": "גייט אים ניט אָן החשיבות והיוקר של ההון עצום הנמצא גם בהיכל הכי פנימי,"
        },
        {
          "s": 22,
          "text": "וכל רצונו ותשוקתו היא ליכנס להקיטון בו נמצא המלך ולראות את פני המלך."
        }
      ]
    }
  ]
}