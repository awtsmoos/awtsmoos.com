{
  "globalIndex": 276,
  "owner": 26,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915360_theRebbe_171__p005",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915360_theRebbe_171__p005",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915360_theRebbe_171",
  "title": "מאמר פדה בשלום תשמ\"א",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "וע\"פ כל הנ\"ל יובן זה שדוקא ע\"י העבודה עתה בהזמן דעקבתא דמשיחא כאשר החושך יכסה ארץ69"
        },
        {
          "s": 3,
          "text": "באים להגילויים של הגאולה העתידה."
        },
        {
          "s": 4,
          "text": "כי דוקא בזמן זה,"
        },
        {
          "s": 5,
          "text": "כשצריך להתעסק עם ניצוצי קדושה שנפלו למקום בלתי טהור,"
        },
        {
          "s": 6,
          "text": "וצריך להפך מרירו למיתקא וחשוכא לנהורא,"
        },
        {
          "s": 7,
          "text": "ועד שמזמן לזמן יוצאים מן הד' אמות של תורה,"
        },
        {
          "s": 8,
          "text": "או מן הד' אמות של תפלה,"
        },
        {
          "s": 9,
          "text": "לצאת מבית הכנסת ומבית המדרש,"
        },
        {
          "s": 10,
          "text": "ובלשון השו\"ע הנהג בהם מנהג דרך ארץ70,"
        },
        {
          "s": 11,
          "text": "מ\"מ ע\"י העבודה עכשיו דוקא מביאים את הגאולה העתידה,"
        },
        {
          "s": 12,
          "text": "דאז יקויים מ\"ש71"
        },
        {
          "s": 13,
          "text": "ואתם תלוקטו לאחד אחד,"
        },
        {
          "s": 14,
          "text": "כאו\"א מישראל וכל ישראל,"
        },
        {
          "s": 15,
          "text": "וכספם וזהבם אתם72,"
        },
        {
          "s": 16,
          "text": "עם כל ניצוצות הקדושה השייכים להם וגם הנמצאים בכספם וזהבם כפשוטם."
        },
        {
          "s": 17,
          "text": "לפי שבעבודה זו בזמן הגלות ישנו ענין המס\"נ בתכלית."
        },
        {
          "s": 18,
          "text": "וכידוע תורת רבינו הזקן"
        },
        {
          "s": 19,
          "text": "(ובארוכה במאמרי נשיא דורנו כ\"ק מו\"ח אדמו\"ר73)"
        },
        {
          "s": 20,
          "text": "עה\"פ74"
        },
        {
          "s": 21,
          "text": "והאיש משה עניו מאד מכל האדם אשר על פני האדמה,"
        },
        {
          "s": 22,
          "text": "שהענוה דמשה"
        },
        {
          "s": 23,
          "text": "(משה אמת ותורתו אמת75)"
        },
        {
          "s": 24,
          "text": "היתה במיוחד בקשר לדרא דעקבתא דמשיחא,"
        },
        {
          "s": 25,
          "text": "בראותו את המס\"נ שלהם בקיום התומ\"צ בענין אל יתבייש מפני המלעיגים76"
        },
        {
          "s": 26,
          "text": "וכו' וכיו\"ב."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "וזה מביא לקיום היעוד ויספו ענוים בה' שמחה77,"
        },
        {
          "s": 1,
          "text": "שמחת עולם על ראשם78,"
        },
        {
          "s": 2,
          "text": "שמחת הגאולה האמיתית והשלימה,"
        },
        {
          "s": 3,
          "text": "הבאה במיוחד ע\"י הפצת המעינות חוצה79,"
        },
        {
          "s": 4,
          "text": "ובאופן של נגאלין מיד80"
        },
        {
          "s": 5,
          "text": "ובאופן דפדה בשלום,"
        },
        {
          "s": 6,
          "text": "בלי שום טירחא,"
        },
        {
          "s": 7,
          "text": "עד שיקויים היעוד81"
        },
        {
          "s": 8,
          "text": "והיו מלכים אומניך ושרותיהם מניקותיך,"
        },
        {
          "s": 9,
          "text": "והביאו82"
        },
        {
          "s": 10,
          "text": "את כל אחיכם גו' מנחה לה' גו' בכלי טהור גו',"
        },
        {
          "s": 11,
          "text": "בקרוב ממש,"
        },
        {
          "s": 12,
          "text": "בימי הגלות האחרונים83,"
        },
        {
          "s": 13,
          "text": "ואח\"כ ומיד ובשלימות בפועל בגאולה האמיתית והשלימה ע\"י משיח צדקנו,"
        },
        {
          "s": 14,
          "text": "במהרה בימינו ממש."
        }
      ]
    }
  ]
}