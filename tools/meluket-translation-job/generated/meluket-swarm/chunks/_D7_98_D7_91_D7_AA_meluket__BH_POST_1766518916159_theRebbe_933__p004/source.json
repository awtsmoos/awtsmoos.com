{
  "globalIndex": 422,
  "owner": 22,
  "jobId": "_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916159_theRebbe_933__p004",
  "batchId": "meluket-_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916159_theRebbe_933__p004",
  "seriesId": "טבת_meluket",
  "postId": "BH_POST_1766518916159_theRebbe_933",
  "title": "מאמר ודוד עבדי תשל\"ב",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יש לבאר מה שהובא לעיל מתו\"א דפירוש בי אדוני הוא שבו יומשך השפע מיוסף הצדיק,"
        },
        {
          "s": 2,
          "text": "דלכאורה,"
        },
        {
          "s": 3,
          "text": "כיון שיהודה ביקש זה מיוסף,"
        },
        {
          "s": 4,
          "text": "הרי הי' צריך לבקשו שהוא"
        },
        {
          "s": 5,
          "text": "(יוסף)"
        },
        {
          "s": 6,
          "text": "ימשיך השפע אליו,"
        },
        {
          "s": 7,
          "text": "ולמה ביקש מיוסף שבו"
        },
        {
          "s": 8,
          "text": "(ביהודה)"
        },
        {
          "s": 9,
          "text": "יומשך השפע29."
        },
        {
          "s": 10,
          "text": "ויש לומר הביאור בזה ע\"פ הידוע30"
        },
        {
          "s": 11,
          "text": "בענין אורות וכלים"
        },
        {
          "s": 12,
          "text": "(דז\"א ומלכות"
        },
        {
          "s": 13,
          "text": "(יוסף ויהודה)"
        },
        {
          "s": 14,
          "text": "הם דוגמת אורות וכלים),"
        },
        {
          "s": 15,
          "text": "דזה שהאורות נמשכים להתלבש בכלים הוא מפני ששורש הכלים הוא למעלה משורש האורות,"
        },
        {
          "s": 16,
          "text": "וכיון שבהאורות נרגשת מעלת הכלים שמצד שרשם31,"
        },
        {
          "s": 17,
          "text": "לכן הם נמשכים להתלבש בכלים."
        },
        {
          "s": 18,
          "text": "ויש לומר,"
        },
        {
          "s": 19,
          "text": "דכיון שאורות הם גילוי,"
        },
        {
          "s": 20,
          "text": "לכן,"
        },
        {
          "s": 21,
          "text": "גם המעלה דכלים"
        },
        {
          "s": 22,
          "text": "(שמצד שרשם)"
        },
        {
          "s": 23,
          "text": "כמו שנרגשת בהאורות הוא זה שע\"י הכלים מתגלה הבל\"ג שבענין הגילוי"
        },
        {
          "s": 24,
          "text": "[דע\"י שהאורות מתלבשים בכלים,"
        },
        {
          "s": 25,
          "text": "הם נמשכים גם בעולמות בי\"ע,"
        },
        {
          "s": 26,
          "text": "ועד בעולם הזה הגשמי]."
        },
        {
          "s": 27,
          "text": "ועד\"ז הוא בז\"א ומלכות,"
        },
        {
          "s": 28,
          "text": "דזה שז\"א רוצה להשפיע למלכות"
        },
        {
          "s": 29,
          "text": "[דכל השפעה היא ברצון32]"
        },
        {
          "s": 30,
          "text": "מפני שהוא מרגיש המעלה דמלכות שמצד שרשה,"
        },
        {
          "s": 31,
          "text": "עיקר ההרגש הוא זה שע\"י ההשפעה במלכות תהי' ההמשכה דז\"א בשלימות"
        },
        {
          "s": 32,
          "text": "[שע\"י המלכות,"
        },
        {
          "s": 33,
          "text": "יומשך גם בבי\"ע,"
        },
        {
          "s": 34,
          "text": "עד בעולם הזה]."
        },
        {
          "s": 35,
          "text": "ולכן אמר יהודה ליוסף בי אדוני,"
        },
        {
          "s": 36,
          "text": "שהמשכת השפע מז\"א למלכות תהי'"
        },
        {
          "s": 37,
          "text": "(לא בכדי שההמשכה דז\"א תהי' בשלימות,"
        },
        {
          "s": 38,
          "text": "אלא)"
        },
        {
          "s": 39,
          "text": "בכדי שבהמלכות יומשך השפע33,"
        },
        {
          "s": 40,
          "text": "בי אדוני."
        },
        {
          "s": 41,
          "text": "ועל ידי זה דוקא יהי' כמוך כפרעה,"
        },
        {
          "s": 42,
          "text": "עליית ז\"א לעצם הכתר."
        },
        {
          "s": 43,
          "text": "דבחינת הכתר שמתגלית בז\"א ע\"י שההמשכה דז\"א נמשכת למטה מטה,"
        },
        {
          "s": 44,
          "text": "ענין הבלי גבול"
        },
        {
          "s": 45,
          "text": "(דכתר)"
        },
        {
          "s": 46,
          "text": "שביכלתו להיות נמשך למטה מטה,"
        },
        {
          "s": 47,
          "text": "הוא הגילוי דכתר,"
        },
        {
          "s": 48,
          "text": "וע\"י שיוסף"
        },
        {
          "s": 49,
          "text": "(ז\"א)"
        },
        {
          "s": 50,
          "text": "ימשיך השפע ליהודה"
        },
        {
          "s": 51,
          "text": "(מלכות)"
        },
        {
          "s": 52,
          "text": "בכדי שבמלכות יומשך השפע"
        },
        {
          "s": 53,
          "text": "(בי אדוני),"
        },
        {
          "s": 54,
          "text": "עי\"ז יהי' בו גילוי עצם הכתר."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "וצריך ביאור,"
        },
        {
          "s": 2,
          "text": "דכיון שענינו של ז\"א"
        },
        {
          "s": 3,
          "text": "(יוסף)"
        },
        {
          "s": 4,
          "text": "הוא גילוי,"
        },
        {
          "s": 5,
          "text": "הרי אין שייך לכאורה שיהי' בו ענין שאינו גילוי,"
        },
        {
          "s": 6,
          "text": "ואיך פעל יהודה אצל יוסף ענין דבי אדוני,"
        },
        {
          "s": 7,
          "text": "שימשיך שפע למלכות בשביל המלכות,"
        },
        {
          "s": 8,
          "text": "המשכה שאינה שייכת"
        },
        {
          "s": 9,
          "text": "(לכאורה)"
        },
        {
          "s": 10,
          "text": "לענין הגילויים."
        },
        {
          "s": 11,
          "text": "ויובן זה בהקדים34"
        },
        {
          "s": 12,
          "text": "המבואר בלקו\"ת פרשת בהעלותך את הנרות35"
        },
        {
          "s": 13,
          "text": "וגם בהדרושים דפרשת ויגש36"
        },
        {
          "s": 14,
          "text": "בענין כי עבדך ערב את הנער גו'37,"
        },
        {
          "s": 15,
          "text": "דזה שישראל ערבים זה בזה38"
        },
        {
          "s": 16,
          "text": "הוא מפני שהם מעורבים זה בזה"
        },
        {
          "s": 17,
          "text": "(ערבים לשון מעורבים)."
        },
        {
          "s": 18,
          "text": "דזהו מהטעמים על זה שכנסת ישראל נמשלה להמנורה"
        },
        {
          "s": 19,
          "text": "(מנורת זהב כולה39),"
        },
        {
          "s": 20,
          "text": "דכמו שבמנורה נאמר40"
        },
        {
          "s": 21,
          "text": "מקשה תיעשה המנורה,"
        },
        {
          "s": 22,
          "text": "דע\"י המקשה שמקישים אותה מה שלמעלה יורד למטה ומה שלמטה עולה למעלה ונתערב הכל יחד,"
        },
        {
          "s": 23,
          "text": "כן כל ישראל מעורבים"
        },
        {
          "s": 24,
          "text": "(וכלולים)"
        },
        {
          "s": 25,
          "text": "זה בזה,"
        },
        {
          "s": 26,
          "text": "עד שלא ימצא בהם ראש וסוף41."
        },
        {
          "s": 27,
          "text": "וזהו אתם קרויין אדם42,"
        },
        {
          "s": 28,
          "text": "שכל ישראל הם"
        },
        {
          "s": 29,
          "text": "(כמו)"
        },
        {
          "s": 30,
          "text": "אדם אחד."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דזה שכל ישראל הם כמו אדם אחד הוא למעלה יותר מזה שכל ישראל מעורבים זה בזה."
        },
        {
          "s": 2,
          "text": "דלשון מעורבים זה בזה שייך בדברים מחולקים שנתערבו יחד."
        },
        {
          "s": 3,
          "text": "וכן הוא גם בענין דמקשה תיעשה המנורה,"
        },
        {
          "s": 4,
          "text": "שההתכללות דמקשה היא באופן שישנם שני הענינים דמעלה ומטה,"
        },
        {
          "s": 5,
          "text": "אלא שהם מעורבים זה בזה,"
        },
        {
          "s": 6,
          "text": "דמה שלמעלה יורד למטה ומה שלמטה עולה למעלה."
        },
        {
          "s": 7,
          "text": "אבל זה שכל ישראל הם כמו אדם אחד הוא למעלה מהתחלקות."
        },
        {
          "s": 8,
          "text": "ויש לומר43,"
        },
        {
          "s": 9,
          "text": "דזה שאתם קרויין אדם הוא,"
        },
        {
          "s": 10,
          "text": "כי גם בההתאחדות דאברי גוף האדם שני הענינים."
        },
        {
          "s": 11,
          "text": "שכל האברים משלימים זה את זה,"
        },
        {
          "s": 12,
          "text": "כי כולם צריכים זה לזה."
        },
        {
          "s": 13,
          "text": "דכמו שהראש משפיע בהרגל כן הרגל משפיע בהראש."
        },
        {
          "s": 14,
          "text": "ובנוגע לענין זה"
        },
        {
          "s": 15,
          "text": "(שהרגל משפיע בהראש)"
        },
        {
          "s": 16,
          "text": "נקרא הרגל בשם ראש."
        },
        {
          "s": 17,
          "text": "דבהתכללות זו ישנה ההתחלקות דראש ורגל,"
        },
        {
          "s": 18,
          "text": "אלא דכיון שכל אבר הוא ראש"
        },
        {
          "s": 19,
          "text": "[כי כל אבר יש לו מעלה מיוחדת,"
        },
        {
          "s": 20,
          "text": "שמצד זה הוא משפיע בכל האברים],"
        },
        {
          "s": 21,
          "text": "לכן,"
        },
        {
          "s": 22,
          "text": "ההתכללות שלהם היא באופן שלא ימצא בהם ראש וסוף."
        },
        {
          "s": 23,
          "text": "ועד\"ז הוא בישראל,"
        },
        {
          "s": 24,
          "text": "שבכל אחד מישראל יש מעלה מיוחדת,"
        },
        {
          "s": 25,
          "text": "ומעלה זו הוא משפיע לשאר כל ישראל."
        },
        {
          "s": 26,
          "text": "ונמצא שכל ישראל משלימים זה את זה,"
        },
        {
          "s": 27,
          "text": "באופן שלא ימצא בהם ראש וסוף."
        },
        {
          "s": 28,
          "text": "[היינו,"
        },
        {
          "s": 29,
          "text": "שישנו ענין דראש וסוף,"
        },
        {
          "s": 30,
          "text": "אלא שא\"א לקבוע"
        },
        {
          "s": 31,
          "text": "(לא ימצא)"
        },
        {
          "s": 32,
          "text": "מיהו הראש ומיהו הסוף]."
        },
        {
          "s": 33,
          "text": "ועוד ענין בהאחדות דאברי גוף האדם,"
        },
        {
          "s": 34,
          "text": "שעיקר ענינה הוא זה שהם חלק מגוף האדם."
        },
        {
          "s": 35,
          "text": "דענין זה הוא בשוה בכל האברים."
        },
        {
          "s": 36,
          "text": "ועד\"ז הוא בישראל,"
        },
        {
          "s": 37,
          "text": "שכל אחד מישראל הוא חלק מכלל ישראל,"
        },
        {
          "s": 38,
          "text": "שמצד ענין זה,"
        },
        {
          "s": 39,
          "text": "כל ישראל הם עצם אחד44."
        }
      ]
    }
  ]
}