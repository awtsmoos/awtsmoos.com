{
  "globalIndex": 791,
  "owner": 41,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918517_theRebbe_122__p003",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918517_theRebbe_122__p003",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918517_theRebbe_122",
  "title": "מאמר שיר המעלות תשכ\"ב",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "והטעם על זה שרשב\"י דוקא המשיך ירידת גשמים ע\"י אמירת תורה,"
        },
        {
          "s": 1,
          "text": "הוא,"
        },
        {
          "s": 2,
          "text": "כי ירידת גשמים"
        },
        {
          "s": 3,
          "text": "(לאחרי שהי' תחלה עצירת גשמים)"
        },
        {
          "s": 4,
          "text": "הוא שינוי בהעולם,"
        },
        {
          "s": 5,
          "text": "דזה שנעשה שינוי בעולם הוא"
        },
        {
          "s": 6,
          "text": "(בדרך כלל)"
        },
        {
          "s": 7,
          "text": "ע\"י תפלה,"
        },
        {
          "s": 8,
          "text": "כמבואר בתניא18."
        },
        {
          "s": 9,
          "text": "אלא שברשב\"י,"
        },
        {
          "s": 10,
          "text": "גם בעסק התורה שלו היתה"
        },
        {
          "s": 11,
          "text": "(גם)"
        },
        {
          "s": 12,
          "text": "המעלה דתפלה,"
        },
        {
          "s": 13,
          "text": "ולכן המשיך ירידת גשמים ע\"י אמירת תורה."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והענין הוא,"
        },
        {
          "s": 2,
          "text": "דהחילוק בין תורה ותפלה הוא ע\"ד החילוק בין ברכה ותפלה19."
        },
        {
          "s": 3,
          "text": "דתפלה היא מלמטה למעלה"
        },
        {
          "s": 4,
          "text": "(כנ\"ל),"
        },
        {
          "s": 5,
          "text": "שהמתפלל הוא למטה ומבקש שישפיעו לו מלמעלה,"
        },
        {
          "s": 6,
          "text": "וברכה היא מלמעלה למטה,"
        },
        {
          "s": 7,
          "text": "שהמברך"
        },
        {
          "s": 8,
          "text": "[זה שיש לו כח לברך,"
        },
        {
          "s": 9,
          "text": "וע\"ד אברהם אבינו שאמר לו הקב\"ה הברכות נתונות לך20]"
        },
        {
          "s": 10,
          "text": "הוא למעלה מהשורש שממנו נמשכת הברכה וממשיך אותה מלמעלה למטה."
        },
        {
          "s": 11,
          "text": "וזהו שברכה היא בדרך ציווי,"
        },
        {
          "s": 12,
          "text": "כי המברך הוא למעלה מהשורש שמשם נמשכת הברכה ולכן בכחו לצוות."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "והנה המעלה דברכה לגבי תפלה היא בנוגע להאדם המברך והמתפלל,"
        },
        {
          "s": 1,
          "text": "אבל בנוגע לההמשכה עצמה,"
        },
        {
          "s": 2,
          "text": "ההמשכה שע\"י תפלה היא נעלית יותר."
        },
        {
          "s": 3,
          "text": "דענין הברכה הוא להמשיך מה שכבר נמצא בהמקור ולא דבר חדש,"
        },
        {
          "s": 4,
          "text": "וענין התפלה הוא בקשה מהקב\"ה שגם באם לא ישנה ח\"ו ההשפעה גם בהמקור,"
        },
        {
          "s": 5,
          "text": "ולא עוד אלא שנגזר עליו שיהי' חולה ח\"ו וכיו\"ב,"
        },
        {
          "s": 6,
          "text": "מ\"מ,"
        },
        {
          "s": 7,
          "text": "תומשך לו השפעה חדשה מאוא\"ס שלמעלה מהשתלשלות."
        },
        {
          "s": 8,
          "text": "דזהו שאומרים בכמה תפלות יהי רצון,"
        },
        {
          "s": 9,
          "text": "דפירוש יהי רצון הוא שיהי' רצון חדש."
        },
        {
          "s": 10,
          "text": "והטעם על זה שהמשכת אור חדש הוא ע\"י התפלה דוקא,"
        },
        {
          "s": 11,
          "text": "כי למעשה ידיך תכסוף21,"
        },
        {
          "s": 12,
          "text": "ולכן,"
        },
        {
          "s": 13,
          "text": "ע\"י התפלה,"
        },
        {
          "s": 14,
          "text": "עבודת המטה,"
        },
        {
          "s": 15,
          "text": "מגיעים לאוא\"ס שלמעלה מהשתלשלות."
        }
      ]
    }
  ]
}