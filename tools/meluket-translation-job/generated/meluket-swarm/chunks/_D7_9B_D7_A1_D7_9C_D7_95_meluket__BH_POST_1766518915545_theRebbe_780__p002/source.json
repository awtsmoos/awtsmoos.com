{
  "globalIndex": 311,
  "owner": 11,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915545_theRebbe_780__p002",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915545_theRebbe_780__p002",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915545_theRebbe_780",
  "title": "מאמר פדה בשלום תשמ\"א",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "והנה פדי' זו יכולה להיות בב' אופנים,"
        },
        {
          "s": 1,
          "text": "פדי' באופן של מלחמה ופדי' באופן של שלום."
        },
        {
          "s": 2,
          "text": "ומבאר ומחדש בפסוק,"
        },
        {
          "s": 3,
          "text": "שפדי' זו היא בשלום."
        },
        {
          "s": 4,
          "text": "ובזה גופא"
        },
        {
          "s": 5,
          "text": "(הן במלחמה והן בשלום)"
        },
        {
          "s": 6,
          "text": "אפשר להיות בב' אופנים,"
        },
        {
          "s": 7,
          "text": "אם הפדי' היא באופן שעומדים בקירוב אל המתברר והנפדה אף שעדיין לא נתברר ונפדה,"
        },
        {
          "s": 8,
          "text": "או שעומדים בריחוק ממנו,"
        },
        {
          "s": 9,
          "text": "וגם בזה מבאר ומחדש בפסוק,"
        },
        {
          "s": 10,
          "text": "שהפדי' היא מקרב לי,"
        },
        {
          "s": 11,
          "text": "היינו באופן דקירוב"
        },
        {
          "s": 12,
          "text": "(כמבואר בד\"ה פדה בשלום לאדמו\"ר האמצעי5),"
        },
        {
          "s": 13,
          "text": "ולי פדי' בתוקף שאין מקום לשינוי,"
        },
        {
          "s": 14,
          "text": "דכ\"מ שנאמר לי אינו זז לעולם6."
        },
        {
          "s": 15,
          "text": "והטעם על פדי' זו הוא כי ברבים היו עמדי,"
        },
        {
          "s": 16,
          "text": "שבזה ב' פירושים."
        },
        {
          "s": 17,
          "text": "א' דקאי על תפלת הרבים7."
        },
        {
          "s": 18,
          "text": "ב' דקאי על הגאולה,"
        },
        {
          "s": 19,
          "text": "שהגאולה היא"
        },
        {
          "s": 20,
          "text": "(גם)"
        },
        {
          "s": 21,
          "text": "של הרבים,"
        },
        {
          "s": 22,
          "text": "וע\"ד הלשון הידוע8"
        },
        {
          "s": 23,
          "text": "\"לא אותי בלבד גאל הקב\"ה כו'\"9."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה כל ענינים אלה ישנם בעבודת האדם"
        },
        {
          "s": 2,
          "text": "(כמבואר בהדרושים),"
        },
        {
          "s": 3,
          "text": "ומזה מובן שישנם בתורה,"
        },
        {
          "s": 4,
          "text": "כמ\"ש10"
        },
        {
          "s": 5,
          "text": "זאת התורה אדם."
        },
        {
          "s": 6,
          "text": "וע\"פ מה שארז\"ל11"
        },
        {
          "s": 7,
          "text": "קוב\"ה אסתכל באורייתא וברא עלמא,"
        },
        {
          "s": 8,
          "text": "מובן,"
        },
        {
          "s": 9,
          "text": "דאדרבה,"
        },
        {
          "s": 10,
          "text": "הענינים הם בתורה,"
        },
        {
          "s": 11,
          "text": "וממנה נמשכים לעולם."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "וביאור ענין פדה בשלום גו' כמו שהוא בתורה,"
        },
        {
          "s": 1,
          "text": "הנה ידוע12"
        },
        {
          "s": 2,
          "text": "דתורה לא בשמים היא וניתנה למטה בארץ דוקא."
        },
        {
          "s": 3,
          "text": "והיות שהתורה נמצאת למטה במקום החושך והסכלות13,"
        },
        {
          "s": 4,
          "text": "צ\"ל ענין הפדי' בתורה,"
        },
        {
          "s": 5,
          "text": "ועי\"ז נעשה יתרון האור מן החושך כו'."
        },
        {
          "s": 6,
          "text": "וע\"פ הידוע14"
        },
        {
          "s": 7,
          "text": "שבעולמות העליונים הפשיטות הוא אלקות וההתחדשות הוא המציאות אבל למטה הוא היפך מזה לגמרי דהפשיטות הוא המציאות וההתחדשות הוא אלקות,"
        },
        {
          "s": 8,
          "text": "וגילוי האלקות שצ\"ל התחדשות,"
        },
        {
          "s": 9,
          "text": "ה\"ז ענין הפדי'."
        },
        {
          "s": 10,
          "text": "ועד\"ז הוא בתורה."
        },
        {
          "s": 11,
          "text": "אמנם בזה גופא יש כמה אופנים,"
        },
        {
          "s": 12,
          "text": "ובכללות ב' אופנים,"
        },
        {
          "s": 13,
          "text": "דכשם שבעבודת האדם ישנה פדי' באופן של מלחמה ופדי' בשלום,"
        },
        {
          "s": 14,
          "text": "שזהו החילוק15"
        },
        {
          "s": 15,
          "text": "בין עבודת התפלה ללימוד התורה,"
        },
        {
          "s": 16,
          "text": "עד\"ז בתורה גופא יש כמה"
        },
        {
          "s": 17,
          "text": "(שני)"
        },
        {
          "s": 18,
          "text": "אופנים."
        },
        {
          "s": 19,
          "text": "אופן של לימוד התורה כמ\"ש16"
        },
        {
          "s": 20,
          "text": "חנוך לנער ע\"פ דרכו,"
        },
        {
          "s": 21,
          "text": "וכמו שמאריך הרמב\"ם בפירוש המשניות שלו17"
        },
        {
          "s": 22,
          "text": "שצריך לחפש כמה עצות וכו' כדי שהלימוד והחינוך יתאימו לדרכו של האדם הלומד"
        },
        {
          "s": 23,
          "text": "(הנער),"
        },
        {
          "s": 24,
          "text": "לפי מעמדו ומצבו באותה שעה."
        },
        {
          "s": 25,
          "text": "וישנו אופן של לימוד התורה,"
        },
        {
          "s": 26,
          "text": "שלומד תורה כפי שהיא בשמים,"
        },
        {
          "s": 27,
          "text": "דהגם שלומד התורה בארץ,"
        },
        {
          "s": 28,
          "text": "מ\"מ אופן הלימוד שלו הוא שאינו שייך אז כלל למציאות העולם,"
        },
        {
          "s": 29,
          "text": "ואין לו שום קשר עם עניני העולם."
        },
        {
          "s": 30,
          "text": "וכשם שיש חילוקים אלה בלימוד התורה,"
        },
        {
          "s": 31,
          "text": "עד\"ז הוא בתורה גופא."
        },
        {
          "s": 32,
          "text": "וכדאיתא ברעיא מהימנא18"
        },
        {
          "s": 33,
          "text": "ונתבאר באגרת הקודש19"
        },
        {
          "s": 34,
          "text": "(דבעל הגאולה)"
        },
        {
          "s": 35,
          "text": "דבתורה הנגלית,"
        },
        {
          "s": 36,
          "text": "עץ הדעת טו\"ר,"
        },
        {
          "s": 37,
          "text": "יש בה קשיא ומחלוקת"
        },
        {
          "s": 38,
          "text": "(וצ\"ל מלחמתה של תורה20"
        },
        {
          "s": 39,
          "text": "לתרץ ולברר המסקנא),"
        },
        {
          "s": 40,
          "text": "ופנימיות התורה,"
        },
        {
          "s": 41,
          "text": "עץ החיים,"
        },
        {
          "s": 42,
          "text": "דלית תמן לא קשיא כו',"
        },
        {
          "s": 43,
          "text": "ועד למעינות תורת הבעש\"ט,"
        },
        {
          "s": 44,
          "text": "שנתגלתה בדורותינו בתורת החסידות,"
        },
        {
          "s": 45,
          "text": "וזהו ענין הפדי' בשלום."
        }
      ]
    }
  ]
}