{
  "globalIndex": 184,
  "owner": 34,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914855_theRebbe_522__p003",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914855_theRebbe_522__p003",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518914855_theRebbe_522",
  "title": "מאמר ואשה אחת תשמ\"ו",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "וצריך להבין,"
        },
        {
          "s": 2,
          "text": "מה מחדש הכתוב בזה שהמצוה הזאת"
        },
        {
          "s": 3,
          "text": "(תשובה)"
        },
        {
          "s": 4,
          "text": "לא נפלאת היא ממך ולא רחוקה היא,"
        },
        {
          "s": 5,
          "text": "דלכאורה,"
        },
        {
          "s": 6,
          "text": "מכיון שגם באדם,"
        },
        {
          "s": 7,
          "text": "עבודת התשובה היא בהמקיפים חי' יחידה,"
        },
        {
          "s": 8,
          "text": "שהם בדוגמת המקיפים שלמעלה"
        },
        {
          "s": 9,
          "text": "(אריך ועתיק),"
        },
        {
          "s": 10,
          "text": "מהו החידוש"
        },
        {
          "s": 11,
          "text": "(כ\"כ)"
        },
        {
          "s": 12,
          "text": "בזה שע\"י העבודה בהמקיפים דהנשמה נמשכים המקיפים דלמעלה."
        },
        {
          "s": 13,
          "text": "ויש לומר,"
        },
        {
          "s": 14,
          "text": "דממך קאי על נר\"נ שהם עיקר האדם43."
        },
        {
          "s": 15,
          "text": "דהגם שתשובה היא בהמקיפים דנשמה,"
        },
        {
          "s": 16,
          "text": "מ\"מ,"
        },
        {
          "s": 17,
          "text": "בכדי לעורר המקיפים צריכה להיות התבוננות,"
        },
        {
          "s": 18,
          "text": "וההתבוננות"
        },
        {
          "s": 19,
          "text": "(שבנר\"נ)"
        },
        {
          "s": 20,
          "text": "צריכה להיות באופן שעי\"ז יתעוררו המקיפים שלמעלה מהשכל."
        },
        {
          "s": 21,
          "text": "וזהו החידוש בלא נפלאת היא ממך גו' שממך קאי על נר\"נ"
        },
        {
          "s": 22,
          "text": "(כנ\"ל),"
        },
        {
          "s": 23,
          "text": "דהגם שהמקיפים חי' יחידה הם נפלאים ורחוקים מנר\"נ,"
        },
        {
          "s": 24,
          "text": "מ\"מ,"
        },
        {
          "s": 25,
          "text": "בכח הנר\"נ לעורר"
        },
        {
          "s": 26,
          "text": "(ע\"י התבוננות המתאימה)"
        },
        {
          "s": 27,
          "text": "את המקיפים חי' יחידה44,"
        },
        {
          "s": 28,
          "text": "ועל ידם גם המקיפים שלמעלה,"
        },
        {
          "s": 29,
          "text": "אריך ועתיק."
        },
        {
          "s": 30,
          "text": "והטעם על זה הוא"
        },
        {
          "s": 31,
          "text": "(כמובא לעיל"
        },
        {
          "s": 32,
          "text": "(סוף סעיף ד)"
        },
        {
          "s": 33,
          "text": "מהמאמר)"
        },
        {
          "s": 34,
          "text": "כי נש\"י"
        },
        {
          "s": 35,
          "text": "(היינו גם הנר\"נ)"
        },
        {
          "s": 36,
          "text": "יש להם הכל,"
        },
        {
          "s": 37,
          "text": "וגם מלמעלה נותנים להם הכל."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים שהביאור בדיוק לשון הכתוב לא נפלאת היא ממך"
        },
        {
          "s": 2,
          "text": "(ממך דוקא),"
        },
        {
          "s": 3,
          "text": "הוא גם להפירוש45"
        },
        {
          "s": 4,
          "text": "שהמצוה הזאת קאי על כללות המצוות."
        },
        {
          "s": 5,
          "text": "דגם לפירוש זה,"
        },
        {
          "s": 6,
          "text": "המצוה הזאת היא בבחינת פלא,"
        },
        {
          "s": 7,
          "text": "וכמובא לעיל"
        },
        {
          "s": 8,
          "text": "(סעיף ד)"
        },
        {
          "s": 9,
          "text": "מהמאמר,"
        },
        {
          "s": 10,
          "text": "שגם כל המצוות,"
        },
        {
          "s": 11,
          "text": "להיותם רצון העליון שלמעלה מהטעם,"
        },
        {
          "s": 12,
          "text": "הם בבחינת פלא וריחוק"
        },
        {
          "s": 13,
          "text": "(אלא שאעפ\"כ לא נפלאת היא ממך,"
        },
        {
          "s": 14,
          "text": "מישראל)."
        },
        {
          "s": 15,
          "text": "ויש לומר,"
        },
        {
          "s": 16,
          "text": "דזה שאומר ב' לשונות,"
        },
        {
          "s": 17,
          "text": "נפלאת ורחוקה,"
        },
        {
          "s": 18,
          "text": "הוא,"
        },
        {
          "s": 19,
          "text": "כי במצוות יש שני ענינים."
        },
        {
          "s": 20,
          "text": "זה שהמצוות הם רצונו ית',"
        },
        {
          "s": 21,
          "text": "רצון שלמעלה מטעם."
        },
        {
          "s": 22,
          "text": "וזה שלאחרי שהרצון נתלבש בחכמה"
        },
        {
          "s": 23,
          "text": "(דתורה),"
        },
        {
          "s": 24,
          "text": "ניתוסף גם טעם לכל מצוה46."
        },
        {
          "s": 25,
          "text": "וזהו שני הלשונות דפלא וריחוק,"
        },
        {
          "s": 26,
          "text": "דהרצון שבמצוות,"
        },
        {
          "s": 27,
          "text": "להיותו למעלה מטעם,"
        },
        {
          "s": 28,
          "text": "הוא פלא."
        },
        {
          "s": 29,
          "text": "וטעמי המצוות כמו שהם מצד החכמה דתורה כמו שהיא למעלה,"
        },
        {
          "s": 30,
          "text": "הם בבחינת ריחוק."
        },
        {
          "s": 31,
          "text": "דהגם שגם טעמי המצוות"
        },
        {
          "s": 32,
          "text": "(כמו שהם בחכמתו ית')"
        },
        {
          "s": 33,
          "text": "הם למעלה מההבנה דשכל אנושי47,"
        },
        {
          "s": 34,
          "text": "מ\"מ,"
        },
        {
          "s": 35,
          "text": "החכמה דלמעלה היא מקור לחכמת ושכל הנבראים48,"
        },
        {
          "s": 36,
          "text": "ולכן היא לא נפלאת משכל הנבראים ורק רחוקה מהם49."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ויש להוסיף,"
        },
        {
          "s": 2,
          "text": "דהמצוות והתורה"
        },
        {
          "s": 3,
          "text": "(טעמי המצוות)"
        },
        {
          "s": 4,
          "text": "כמו שהם מצד עצמם,"
        },
        {
          "s": 5,
          "text": "אין שייך לומר עליהם גם התואר דפלא וריחוק."
        },
        {
          "s": 6,
          "text": "כי לשון פלא"
        },
        {
          "s": 7,
          "text": "(ומכ\"ש לשון ריחוק)"
        },
        {
          "s": 8,
          "text": "מורה שהדבר המופלא יש לו איזו שייכות להדבר שמופלא ממנו."
        },
        {
          "s": 9,
          "text": "משא\"כ בשני ענינים שאין שום שייכות ביניהם,"
        },
        {
          "s": 10,
          "text": "אין נופל הלשון פלא."
        },
        {
          "s": 11,
          "text": "וכמו שאין שייך לומר על סברא שכלית שהיא נפלאת מחוש המישוש50."
        },
        {
          "s": 12,
          "text": "וזה שהתומ\"צ הם ריחוק ופלא הוא לאחרי שירדו להיות להם איזו שייכות לעולם."
        },
        {
          "s": 13,
          "text": "דהתחלת הירידה היא זה שהתורה קדמה לעולם."
        },
        {
          "s": 14,
          "text": "דהתורה כמו שהיא מצד עצמה,"
        },
        {
          "s": 15,
          "text": "אינה בגדר עלמין כלל ואין שייך לומר עלי' שקדמה לעולם."
        },
        {
          "s": 16,
          "text": "וזה שארז\"ל51"
        },
        {
          "s": 17,
          "text": "אלפיים שנה קדמה תורה לעולם,"
        },
        {
          "s": 18,
          "text": "הוא בהדרגא דתורה כמו שירדה52"
        },
        {
          "s": 19,
          "text": "להיות בגדר עלמין."
        },
        {
          "s": 20,
          "text": "דבדרגא זו שייך לומר שקדמה לעולם,"
        },
        {
          "s": 21,
          "text": "ויתירה מזו,"
        },
        {
          "s": 22,
          "text": "שיש שיעור בהקדימה,"
        },
        {
          "s": 23,
          "text": "אלפיים שנה."
        },
        {
          "s": 24,
          "text": "ולאחרי זה ירדה עוד כו\"כ ירידות53,"
        },
        {
          "s": 25,
          "text": "עד שנמשכה למטה."
        },
        {
          "s": 26,
          "text": "ובדרגא זו דתורה,"
        },
        {
          "s": 27,
          "text": "כמו שהיא לאחרי ירידתה"
        },
        {
          "s": 28,
          "text": "[שהיא דרגא כללית,"
        },
        {
          "s": 29,
          "text": "הכוללת כו\"כ דרגות פרטיות,"
        },
        {
          "s": 30,
          "text": "מהדרגא דתורה שקדמה לעולם ועד להדרגא דתורה שנמשכה למטה]"
        },
        {
          "s": 31,
          "text": "שייך לומר שהיא בבחינת פלא וריחוק."
        }
      ]
    }
  ]
}