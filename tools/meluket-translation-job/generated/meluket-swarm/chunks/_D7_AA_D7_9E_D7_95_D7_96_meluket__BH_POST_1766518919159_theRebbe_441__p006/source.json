{
  "globalIndex": 906,
  "owner": 6,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919159_theRebbe_441__p006",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919159_theRebbe_441__p006",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919159_theRebbe_441",
  "title": "מאמר ה' לי בעוזרי תשי\"ז",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ד)"
        },
        {
          "s": 2,
          "text": "ויש לומר,"
        },
        {
          "s": 3,
          "text": "דזהו גם מה שהוי' הוא ר\"ת יסוד היסודות ועמוד החכמות,"
        },
        {
          "s": 4,
          "text": "דיסודות וחכמות הם שני ענינים הפכיים."
        },
        {
          "s": 5,
          "text": "דיסודות הם ההנחות הפשוטות שלמעלה מהבנין,"
        },
        {
          "s": 6,
          "text": "מהסברה,"
        },
        {
          "s": 7,
          "text": "שהם יסודי ההשגה,"
        },
        {
          "s": 8,
          "text": "וחכמות הם הסברות השכליות שנתפסות בהשכלה ועד ששייך בהם שקו\"ט."
        },
        {
          "s": 9,
          "text": "דבעבודת האדם ענין היסודות הוא האמונה פשוטה שלמעלה מהשכל,"
        },
        {
          "s": 10,
          "text": "וחכמות הו\"ע ההשגה."
        },
        {
          "s": 11,
          "text": "וי\"ל דשרש היסודות הוא בהוי' שלמעלה מעולמות"
        },
        {
          "s": 12,
          "text": "(הי' הוה ויהי' כאחד),"
        },
        {
          "s": 13,
          "text": "ושרש החכמות הוא בהוי' לשון מהוה,"
        },
        {
          "s": 14,
          "text": "והכח שמאחד היסודות והחכמות,"
        },
        {
          "s": 15,
          "text": "שהאמונה שלמעלה מהשכל תומשך גם בשכל,"
        },
        {
          "s": 16,
          "text": "הוא משם הוי' שם העצם."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יובן מה שדוד נענש על מה שאמר זמירות היו לי חוקיך,"
        },
        {
          "s": 1,
          "text": "כי התורה כמו שהיא מצד רצון העצמי שלמעלה מטעם"
        },
        {
          "s": 2,
          "text": "(יסודות)"
        },
        {
          "s": 3,
          "text": "היא דוגמת הוי' מלשון הי' הוה ויהי' כאחד שלמעלה מעולם,"
        },
        {
          "s": 4,
          "text": "שלכן,"
        },
        {
          "s": 5,
          "text": "הבירור שמצד בחינה זו הוא באופן דדחי'"
        },
        {
          "s": 6,
          "text": "(ולא בדרך בירור),"
        },
        {
          "s": 7,
          "text": "זמירות מלשון לזמר עריצים."
        },
        {
          "s": 8,
          "text": "ומכיון שאמיתית ענין אחדות הוי' הוא שהאחדות היא גם מצד העולמות,"
        },
        {
          "s": 9,
          "text": "לכן צ\"ל ההמשכה דעדות ומשפטים דתורה"
        },
        {
          "s": 10,
          "text": "(חכמות)"
        },
        {
          "s": 11,
          "text": "שיהי' גילוי אלקות בעולם."
        },
        {
          "s": 12,
          "text": "ועי\"ז מתגלה העצם דתורה שלמעלה גם מחוקים,"
        },
        {
          "s": 13,
          "text": "שם העצם."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ו)"
        },
        {
          "s": 2,
          "text": "וזהו הוי' לי בעוזרי,"
        },
        {
          "s": 3,
          "text": "עוזרי קאי על הניצוצות המתבררים,"
        },
        {
          "s": 4,
          "text": "שהם העוזרים האמיתים של האדם"
        },
        {
          "s": 5,
          "text": "[וע\"ד הידוע63"
        },
        {
          "s": 6,
          "text": "בענין כי לא על הלחם לבדו יחי' האדם כי על כל מוצא פי הוי' יחי' האדם64,"
        },
        {
          "s": 7,
          "text": "דע\"י שהאדם מברר את הניצוצות שבדצ\"ח,"
        },
        {
          "s": 8,
          "text": "נמשך לו תוספת כח בעבודתו,"
        },
        {
          "s": 9,
          "text": "שהניצוצות עוזרים ומסייעים לו],"
        },
        {
          "s": 10,
          "text": "ופי' הוי' לי בעוזרי הוא שהניצוצות המתבררים"
        },
        {
          "s": 11,
          "text": "(עוזרי),"
        },
        {
          "s": 12,
          "text": "הגם שענין הבירורים הוא מלמטה למעלה"
        },
        {
          "s": 13,
          "text": "(ענין דעולם),"
        },
        {
          "s": 14,
          "text": "יומשך בהם גילוי שם הוי' שלמעלה מהשתלשלות."
        },
        {
          "s": 15,
          "text": "וחיבור ב' ענינים אלו הוא מהוי' שם העצם."
        },
        {
          "s": 16,
          "text": "וזהו גם ואני אראה בשונאי,"
        },
        {
          "s": 17,
          "text": "דגם אלו שהם שונאי דוד שהם שונאי הוי',"
        },
        {
          "s": 18,
          "text": "אין צריך לדחותם לגמרי כ\"א לברר הניצוצות שבהם,"
        },
        {
          "s": 19,
          "text": "וע\"י שמוציאים הניצוצות מהם הנה הרע שבהם מתבטל."
        },
        {
          "s": 20,
          "text": "ועי\"ז באים לראי' באלקות,"
        },
        {
          "s": 21,
          "text": "אראה בשונאי,"
        },
        {
          "s": 22,
          "text": "ראיית אלקות במוחש גם בעניני עולם."
        },
        {
          "s": 23,
          "text": "וכמו שהי' אצל בעל הגאולה,"
        },
        {
          "s": 24,
          "text": "שגם המנגדים,"
        },
        {
          "s": 25,
          "text": "אף שנשארו במציאותם,"
        },
        {
          "s": 26,
          "text": "הוכרחו"
        },
        {
          "s": 27,
          "text": "(ע\"י הניצוצות שבהם)"
        },
        {
          "s": 28,
          "text": "לעשות כפי הכוונה,"
        },
        {
          "s": 29,
          "text": "והי' גילוי אלקות"
        },
        {
          "s": 30,
          "text": "(דלמעלה מהטבע)"
        },
        {
          "s": 31,
          "text": "במוחש"
        },
        {
          "s": 32,
          "text": "(בטבע)."
        },
        {
          "s": 33,
          "text": "ועי\"ז המשיך הכח לכל ההולכים באורחותיו להמשיך גילוי אלקות דלמעלה מהטבע בטבע,"
        },
        {
          "s": 34,
          "text": "וזה נעשה הכנה קרובה שתושלם הכוונה דדירה לו ית' בתחתונים,"
        },
        {
          "s": 35,
          "text": "שהתחתונים יהיו דירה לו ית',"
        },
        {
          "s": 36,
          "text": "לו לעצמותו65,"
        },
        {
          "s": 37,
          "text": "בגאולה האמיתית והשלימה ע\"י משיח צדקנו,"
        },
        {
          "s": 38,
          "text": "בקרוב ממש."
        }
      ]
    }
  ]
}