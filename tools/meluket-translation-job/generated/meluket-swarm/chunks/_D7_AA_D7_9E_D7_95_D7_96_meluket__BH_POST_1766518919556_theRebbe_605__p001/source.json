  "owner": 25,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919556_theRebbe_605__p001",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919556_theRebbe_605__p001",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919556_theRebbe_605",
  "title": "מאמר אלה מסעי תשי\"ג",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ מטות-מסעי,"
        },
        {
          "s": 2,
          "text": "מבה\"ח מנחם-אב*,"
        },
        {
          "s": 3,
          "text": "ה'תשי\"ג"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "(הנחה בלתי מוגה)"
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "אלה מסעי בני ישראל אשר יצאו מארץ מצרים גו' ויכתוב משה את מוצאיהם למסעיהם גו' ואלה מסעיהם למוצאיהם1."
        },
        {
          "s": 1,
          "text": "וידוע הדיוקים2"
        },
        {
          "s": 2,
          "text": "שבזה,"
        },
        {
          "s": 3,
          "text": "שאומר אלה מסעי,"
        },
        {
          "s": 4,
          "text": "שהוא לשון רבים,"
        },
        {
          "s": 5,
          "text": "ומסיים אשר יצאו מארץ מצרים אשר מארמ\"צ,"
        },
        {
          "s": 6,
          "text": "הוא רק יציאה ונסיעה הראשונה."
        },
        {
          "s": 7,
          "text": "גם אינו מובן אומרו ויכתוב משה,"
        },
        {
          "s": 8,
          "text": "שהרי כל התורה כולה כתבה משה רבינו,"
        },
        {
          "s": 9,
          "text": "ומה משמיענו בזה."
        },
        {
          "s": 10,
          "text": "גם מהו הכפל דמוצאיהם למסעיהם ומסעיהם למוצאיהם,"
        },
        {
          "s": 11,
          "text": "והיפך הסדר מרישא לסיפא."
        },
        {
          "s": 12,
          "text": "ובכללות הדברים צריך להבין,"
        },
        {
          "s": 13,
          "text": "מה נוגע הספור והידיעה דסדר המסעות,"
        },
        {
          "s": 14,
          "text": "ואף דבשביל דור ההוא מפרש במדרש3"
        },
        {
          "s": 15,
          "text": "משל למלך ובנו שהלכו כו' כשחזרו היו מונין כל המסעות והמאורעות שבהם,"
        },
        {
          "s": 16,
          "text": "אבל הרי התורה היא נצחית,"
        },
        {
          "s": 17,
          "text": "וע\"כ אשר ספור זה נוגע בכל הזמנים ובכל המקומות."
        }
      ]
    }
  ]
}