{
  "globalIndex": 304,
  "owner": 4,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915520_theRebbe_327__p002",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915520_theRebbe_327__p002",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915520_theRebbe_327",
  "title": "מאמר מרגלא בפומיה דרבא תש\"מ",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ונקודת הביאור בזה"
        },
        {
          "s": 2,
          "text": "(בהמאמר13)"
        },
        {
          "s": 3,
          "text": "ע\"פ מה דאיתא בזהר14"
        },
        {
          "s": 4,
          "text": "לית מחשבה תפיסא בך כלל,"
        },
        {
          "s": 5,
          "text": "אבל נתפס איהו ברעותא דלבא."
        },
        {
          "s": 6,
          "text": "דמחשבה"
        },
        {
          "s": 7,
          "text": "[השגה דבינה וגם החכמה שלמעלה מהשגה דבינה,"
        },
        {
          "s": 8,
          "text": "כולל גם ראי' דחכמה15]"
        },
        {
          "s": 9,
          "text": "תופסת רק בגילויים ולא בעצמות,"
        },
        {
          "s": 10,
          "text": "וע\"י רעו\"ד תופסים בהעצמות."
        },
        {
          "s": 11,
          "text": "והענין הוא,"
        },
        {
          "s": 12,
          "text": "דבאהבה ב' מדריגות בכללות."
        },
        {
          "s": 13,
          "text": "אהבה שע\"פ טעם ודעת,"
        },
        {
          "s": 14,
          "text": "ואהבה עצמית שמצד עצם הנשמה שמקושרת עם העצמות."
        },
        {
          "s": 15,
          "text": "ע\"ד אהבת בן לאביו שהיא אהבה עצמית שמעצם הבן לעצם האב."
        },
        {
          "s": 16,
          "text": "ואהבה זו נקראת בשם רעותא דלבא."
        },
        {
          "s": 17,
          "text": "וזהו נתפס איהו ברעותא דלבא,"
        },
        {
          "s": 18,
          "text": "דכמו שהבן מעורר את עצמות האב,"
        },
        {
          "s": 19,
          "text": "דכשהבן צועק אבא ניזוז האב בכל מהותו,"
        },
        {
          "s": 20,
          "text": "כמו\"כ הוא בהנמשל,"
        },
        {
          "s": 21,
          "text": "שהאהבה עצמית שמצד עצם הנשמה תופסת בהעצמות."
        },
        {
          "s": 22,
          "text": "וזהו שתכלית ועיקר החכמה הוא תשובה ומעשים טובים16,"
        },
        {
          "s": 23,
          "text": "כי החכמה תופסת רק בגילויים"
        },
        {
          "s": 24,
          "text": "(כנ\"ל),"
        },
        {
          "s": 25,
          "text": "ובכדי לתפוס בהעצמות הוא ע\"י תשובה ומעשים טובים."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "וצריך להבין,"
        },
        {
          "s": 1,
          "text": "דענין זה"
        },
        {
          "s": 2,
          "text": "(דחכמה תופסת בגילויים,"
        },
        {
          "s": 3,
          "text": "ובכדי לתפוס בהעצמות הוא ע\"י תשובה ומעשים טובים)"
        },
        {
          "s": 4,
          "text": "מבאר רק המעלה שבתשובה ומעשים טובים לגבי חכמה."
        },
        {
          "s": 5,
          "text": "דהגם שבדרגת הכחות דנפש האדם לימוד התורה הוא נעלה יותר מתשובה ומעשים טובים,"
        },
        {
          "s": 6,
          "text": "דלימוד התורה הוא בהשכל שבו,"
        },
        {
          "s": 7,
          "text": "ותשובה ומעשים טובים הם במדות שבלב ובכח המעשה"
        },
        {
          "s": 8,
          "text": "[תשובה במדות שבלב17,"
        },
        {
          "s": 9,
          "text": "ומעשים טובים בכח המעשה],"
        },
        {
          "s": 10,
          "text": "מ\"מ,"
        },
        {
          "s": 11,
          "text": "מעלה בתשובה ומעשים טובים שעל ידם דוקא תופסים בהעצמות."
        },
        {
          "s": 12,
          "text": "אבל ביאור זה הוא לכאורה רק להפירוש שתכלית חכמה הוא תכלית העילוי דחכמה."
        },
        {
          "s": 13,
          "text": "דכיון שע\"י התשובה ומעשים טובים תופסים בהעצמות,"
        },
        {
          "s": 14,
          "text": "לכן,"
        },
        {
          "s": 15,
          "text": "ע\"י שהחכמה מביאה לתשובה ומעשים טובים,"
        },
        {
          "s": 16,
          "text": "נעשה עילוי גם בחכמה"
        },
        {
          "s": 17,
          "text": "[וע\"ד גדול תלמוד שמביא לידי מעשה18,"
        },
        {
          "s": 18,
          "text": "דע\"י שהלימוד מביא לידי מעשה הוא גדול יותר מכמו שהוא מצד עצמו]."
        },
        {
          "s": 19,
          "text": "ומהמשך הענינים שבהמאמר משמע,"
        },
        {
          "s": 20,
          "text": "דענין זה"
        },
        {
          "s": 21,
          "text": "(שחכמה תופסת בגילויים,"
        },
        {
          "s": 22,
          "text": "ובכדי לתפוס בהעצמות הוא ע\"י תשובה ומעשים טובים)"
        },
        {
          "s": 23,
          "text": "הוא גם ביאור על זה שעיקרה של תורה הוא תשובה ומעשים טובים."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ויובן בהקדים,"
        },
        {
          "s": 2,
          "text": "דמ\"ש בהמאמר בהמשך להענין דנתפס איהו ברעותא דלבא שע\"י תשובה ומעשים טובים תופסים בהעצמות,"
        },
        {
          "s": 3,
          "text": "יש לומר ע\"פ המבואר בכ\"מ19,"
        },
        {
          "s": 4,
          "text": "שקיום התומ\"צ שלאחרי רעו\"ד הוא במדריגה נעלית יותר"
        },
        {
          "s": 5,
          "text": "(כדלקמן)."
        },
        {
          "s": 6,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 7,
          "text": "דמ\"ש בזהר שנתפס איהו ברעותא דלבא,"
        },
        {
          "s": 8,
          "text": "שני ענינים בזה."
        },
        {
          "s": 9,
          "text": "שנתפס בהרעותא דלבא עצמה,"
        },
        {
          "s": 10,
          "text": "וזה שהרעותא דלבא היא הקדמה לקיום התומ\"צ שבהם נתפס העצמות ממש."
        },
        {
          "s": 11,
          "text": "והיינו,"
        },
        {
          "s": 12,
          "text": "שבכדי לתפוס בהעצמות ממש הוא"
        },
        {
          "s": 13,
          "text": "(בעיקר)"
        },
        {
          "s": 14,
          "text": "ע\"י קיום התומ\"צ20,"
        },
        {
          "s": 15,
          "text": "אלא שזה שע\"י מעשה המצוות תופסים בהעצמות הוא כשהעשי' היא בביטול,"
        },
        {
          "s": 16,
          "text": "והביטול שבעשיית המצוות הוא כשהאהבה המביאה לקיום המצוות היא אהבה עצמית שלמעלה מטעם ודעת,"
        },
        {
          "s": 17,
          "text": "רעותא דלבא."
        },
        {
          "s": 18,
          "text": "דכשהאהבה21"
        },
        {
          "s": 19,
          "text": "[שבעת התפלה]"
        },
        {
          "s": 20,
          "text": "היא ע\"פ טעם ודעת,"
        },
        {
          "s": 21,
          "text": "קיום המצוות"
        },
        {
          "s": 22,
          "text": "[שבמשך כל היום]"
        },
        {
          "s": 23,
          "text": "הוא בכדי להמשיך גילוי אלקות."
        },
        {
          "s": 24,
          "text": "וגם כשהאהבה היא ע\"י ההתבוננות בההפלאה דאוא\"ס,"
        },
        {
          "s": 25,
          "text": "שעי\"ז בא לאהבה רבה דמי22"
        },
        {
          "s": 26,
          "text": "לי בשמים,"
        },
        {
          "s": 27,
          "text": "שאינו רוצה בכל הגילויים ורק בהעצמות23,"
        },
        {
          "s": 28,
          "text": "יש מבוקש בקיום המצוות שלו"
        },
        {
          "s": 29,
          "text": "(שבמשך כל היום),"
        },
        {
          "s": 30,
          "text": "להמשיך גילוי עצמות אוא\"ס."
        },
        {
          "s": 31,
          "text": "וקיום המצוות שלאחרי התעוררות האהבה עצמית"
        },
        {
          "s": 32,
          "text": "(רעותא דלבא)"
        },
        {
          "s": 33,
          "text": "הוא בלי שום מבוקש"
        },
        {
          "s": 34,
          "text": "[גם לא המבוקש דהמשכת גילוי עצמות אוא\"ס]"
        },
        {
          "s": 35,
          "text": "ורק לקיים רצונו ית',"
        },
        {
          "s": 36,
          "text": "בדרך קבלת עול."
        },
        {
          "s": 37,
          "text": "דהביטול שבקיום המצוות באופן זה הוא עוד יותר מהביטול שברעו\"ד24,"
        },
        {
          "s": 38,
          "text": "וע\"י קיום המצוות באופן זה הוא המשכת העצמות."
        }
      ]
    }
  ]
}