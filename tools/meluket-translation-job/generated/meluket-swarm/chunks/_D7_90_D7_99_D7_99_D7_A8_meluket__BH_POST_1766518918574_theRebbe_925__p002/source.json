{
  "globalIndex": 801,
  "owner": 1,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918574_theRebbe_925__p002",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918574_theRebbe_925__p002",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918574_theRebbe_925",
  "title": "מאמר פתח רבי שמעון תשל\"ד",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים הידוע16"
        },
        {
          "s": 2,
          "text": "שגם התקשרות היא למעלה מדביקות."
        },
        {
          "s": 3,
          "text": "דדביקות היא בחיצוניות,"
        },
        {
          "s": 4,
          "text": "כמו כאשר ידבק האזור אל מתני איש17,"
        },
        {
          "s": 5,
          "text": "שהדביקות דאזור ל"
        },
        {
          "s": 6,
          "text": "(מתני)"
        },
        {
          "s": 7,
          "text": "האיש היא רק לחיצוניותו,"
        },
        {
          "s": 8,
          "text": "והתקשרות הוא בפנימיות,"
        },
        {
          "s": 9,
          "text": "כמו ונפשו קשורה בנפשו18"
        },
        {
          "s": 10,
          "text": "שזה מגיע בפנימיותו19."
        },
        {
          "s": 11,
          "text": "וזהו החילוק בין קרבנות לקטורת,"
        },
        {
          "s": 12,
          "text": "דעבודת הקרבנות היא מצד זה שישראל דבוקים בהקב\"ה"
        },
        {
          "s": 13,
          "text": "[כדאיתא במדרש20"
        },
        {
          "s": 14,
          "text": "ובזהר21],"
        },
        {
          "s": 15,
          "text": "ולכן היו מקריבים הקרבנות על מזבח החיצון,"
        },
        {
          "s": 16,
          "text": "דבנפש האדם הוא חיצוניות הלב22."
        },
        {
          "s": 17,
          "text": "וקטורת הוא לשון קשר23"
        },
        {
          "s": 18,
          "text": "[דכל קשר שבפסוק מתורגם קטר24],"
        },
        {
          "s": 19,
          "text": "ולכן הקטורת היא על מזבח הפנימי,"
        },
        {
          "s": 20,
          "text": "דבנפש האדם הוא פנימיות הלב22."
        },
        {
          "s": 21,
          "text": "והחילוק שבין העבודה דחיצוניות הלב להעבודה דפנימיות הלב הוא25,"
        },
        {
          "s": 22,
          "text": "שהעבודה דחיצוניות הלב היא ע\"פ טעם ודעת,"
        },
        {
          "s": 23,
          "text": "דבהאהבה שע\"פ טעם ודעת שייך שינויים26,"
        },
        {
          "s": 24,
          "text": "והעבודה דפנימיות הלב היא למעלה מטעם ודעת,"
        },
        {
          "s": 25,
          "text": "שאין שייך בה שינוי."
        },
        {
          "s": 26,
          "text": "וזהו שקרבנות הוא לשון קירוב27"
        },
        {
          "s": 27,
          "text": "וקטורת לשון התקשרות,"
        },
        {
          "s": 28,
          "text": "דקירוב מורה שהוא מציאות,"
        },
        {
          "s": 29,
          "text": "אלא שהוא קרוב לאלקות,"
        },
        {
          "s": 30,
          "text": "אבל אפשר שיתרחק ח\"ו,"
        },
        {
          "s": 31,
          "text": "והתקשרות"
        },
        {
          "s": 32,
          "text": "(קטורת)"
        },
        {
          "s": 33,
          "text": "הוא קשר של קיימא,"
        },
        {
          "s": 34,
          "text": "דאמיתית ענין קשר של קיימא הוא שאין שייך בזה שינוי."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה חילוק זה בין דביקות והתקשרות הוא בהעבודה דמלמטה למעלה28."
        },
        {
          "s": 2,
          "text": "דקרבנות וקטורת שניהם הם עמוד העבודה,"
        },
        {
          "s": 3,
          "text": "שהיא העלאה מלמטה למעלה29."
        },
        {
          "s": 4,
          "text": "והחילוק בין דביקות והתקשרות בענין ההמשכה מלמעלה למטה"
        },
        {
          "s": 5,
          "text": "(תורה וגמ\"ח)"
        },
        {
          "s": 6,
          "text": "הוא כדאיתא בזהר30"
        },
        {
          "s": 7,
          "text": "כמה חביבין ישראל קמי קוב\"ה כו' ובעא לאתדבקא בהו ולאתקשרא עמהון,"
        },
        {
          "s": 8,
          "text": "ומבאר אדמו\"ר האמצעי31"
        },
        {
          "s": 9,
          "text": "דלאתדבקא בהו הוא ע\"י המצוות,"
        },
        {
          "s": 10,
          "text": "דההמשכה שע\"י המצוות היא בבחינת מקיף32"
        },
        {
          "s": 11,
          "text": "כמ\"ש33"
        },
        {
          "s": 12,
          "text": "וימינו תחבקני,"
        },
        {
          "s": 13,
          "text": "שהאור שנמשך ע\"י המצוות הוא מחבק את האדם המקיים את המצוות,"
        },
        {
          "s": 14,
          "text": "דחיבוק הוא מבחוץ,"
        },
        {
          "s": 15,
          "text": "ולכן אומר לאתדבקא בהו,"
        },
        {
          "s": 16,
          "text": "דדביקות הוא חיבור חיצוני."
        },
        {
          "s": 17,
          "text": "ולאתקשרא עמהון הוא ע\"י התורה,"
        },
        {
          "s": 18,
          "text": "דהמשכה שע\"י התורה היא בפנימיות כמ\"ש34"
        },
        {
          "s": 19,
          "text": "ותורתך בתוך מעי."
        },
        {
          "s": 20,
          "text": "ולכן אומר ולאתקשרא עמהון,"
        },
        {
          "s": 21,
          "text": "דהתקשרות הוא חיבור פנימי."
        },
        {
          "s": 22,
          "text": "שהחיבור דהקב\"ה עם ישראל שע\"י התורה נק' התקשרות,"
        },
        {
          "s": 23,
          "text": "כמאמר35"
        },
        {
          "s": 24,
          "text": "תלת קשרין36"
        },
        {
          "s": 25,
          "text": "אינון מתקשרן דא בדא,"
        },
        {
          "s": 26,
          "text": "קוב\"ה37"
        },
        {
          "s": 27,
          "text": "אורייתא וישראל."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה בהדביקות דישראל בהקב\"ה"
        },
        {
          "s": 2,
          "text": "[שמצד זה יש להם הכח להקריב קרבנות]"
        },
        {
          "s": 3,
          "text": "שני ענינים."
        },
        {
          "s": 4,
          "text": "דבמדרש38"
        },
        {
          "s": 5,
          "text": "איתא דזה שהקב\"ה צוה את ישראל להקריב קרבנות הוא מפני שהן דבוקין לי הדא הוא דכתיב17"
        },
        {
          "s": 6,
          "text": "כי כאשר ידבק האזור אל מתני איש גו',"
        },
        {
          "s": 7,
          "text": "ובזהר39"
        },
        {
          "s": 8,
          "text": "איתא זכאין אינון ישראל דקב\"ה קרא לון אדם כו' אדם כי יקריב מכם40,"
        },
        {
          "s": 9,
          "text": "מאי טעמא קרא לון אדם משום דכתיב41"
        },
        {
          "s": 10,
          "text": "ואתם הדבקים בהוי' אלקיכם גו'."
        },
        {
          "s": 11,
          "text": "ומבואר בהמשך תרס\"ו42,"
        },
        {
          "s": 12,
          "text": "שבמדרש מדבר בענין הדביקות דכלים,"
        },
        {
          "s": 13,
          "text": "שהכלים הם43"
        },
        {
          "s": 14,
          "text": "בבחינת מציאות והיחוד"
        },
        {
          "s": 15,
          "text": "(הדביקות)"
        },
        {
          "s": 16,
          "text": "שלהם אינו יחוד עצמי,"
        },
        {
          "s": 17,
          "text": "ולכן מביא הפסוק כאשר ידבק האזור גו' שהאזור הוא מציאות לעצמו אלא שדבוק להאדם,"
        },
        {
          "s": 18,
          "text": "ובזהר מדבר בענין הדביקות דאורות,"
        },
        {
          "s": 19,
          "text": "שהדביקות והיחוד דאורות הוא יחוד עצמי43,"
        },
        {
          "s": 20,
          "text": "ולכן מביא הכתוב ואתם הדבקים בהוי' אלקיכם,"
        },
        {
          "s": 21,
          "text": "דביקות ממש."
        },
        {
          "s": 22,
          "text": "ויש לומר,"
        },
        {
          "s": 23,
          "text": "דזה שגם הדביקות דאורות נק' בשם דביקות,"
        },
        {
          "s": 24,
          "text": "דדביקות הוא בחיצוניות"
        },
        {
          "s": 25,
          "text": "(כנ\"ל),"
        },
        {
          "s": 26,
          "text": "הוא מפני שגם האור הוא התפשטות וגילוי שמחוץ להעצם."
        }
      ]
    }
  ]
}