{
  "globalIndex": 1,
  "owner": 1,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913707_theRebbe_562__p002",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913707_theRebbe_562__p002",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518913707_theRebbe_562",
  "title": "מאמר יבחר לנו את נחלתינו תשכ\"ג",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "והנה מזה שאומרים לפני תקיעת שופר"
        },
        {
          "s": 1,
          "text": "(לא רק פסוק זה,"
        },
        {
          "s": 2,
          "text": "אלא)"
        },
        {
          "s": 3,
          "text": "את כל המזמור,"
        },
        {
          "s": 4,
          "text": "מובן,"
        },
        {
          "s": 5,
          "text": "שכל הפסוקים דהמזמור שייכים להענין דעומד מכסא דין ויושב בכסא רחמים שע\"י תקיעת שופר12."
        },
        {
          "s": 6,
          "text": "ומכ\"ש הפסוק יבחר לנו גו' שהוא בסמיכות להפסוק עלה אלקים בתרועה גו',"
        },
        {
          "s": 7,
          "text": "שזה מורה,"
        },
        {
          "s": 8,
          "text": "שפסוק זה שייך לעלה אלקים בתרועה גו'."
        },
        {
          "s": 9,
          "text": "וצריך להבין,"
        },
        {
          "s": 10,
          "text": "דענין יבחר לנו הוא שהבחירה דהקב\"ה בישראל היא מצד עצמו"
        },
        {
          "s": 11,
          "text": "(ולא שהעבודה דישראל מעוררת שיבחור בהם),"
        },
        {
          "s": 12,
          "text": "ויתירה מזו,"
        },
        {
          "s": 13,
          "text": "דענין הבחירה הוא13"
        },
        {
          "s": 14,
          "text": "בהעצמות,"
        },
        {
          "s": 15,
          "text": "שאין שייך שם הענין דאתערותא דלתתא."
        },
        {
          "s": 16,
          "text": "והיינו,"
        },
        {
          "s": 17,
          "text": "דנוסף לזה שהבחירה בפועל היא מצד עצמו ולא שמתעוררת ע\"י אתעדל\"ת,"
        },
        {
          "s": 18,
          "text": "אלא שבמקום זה"
        },
        {
          "s": 19,
          "text": "(שבו הוא ענין הבחירה)"
        },
        {
          "s": 20,
          "text": "אין שייך כלל לעורר ע\"י אתעדל\"ת."
        },
        {
          "s": 21,
          "text": "וענין עלה אלקים בתרועה גו' הוא,"
        },
        {
          "s": 22,
          "text": "שתקיעת שופר דישראל מעוררת שיהי' עומד מכסא דין ויושב בכסא רחמים."
        },
        {
          "s": 23,
          "text": "ומהסמיכות דשני הפסוקים משמע דשני הענינים שייכים זל\"ז."
        },
        {
          "s": 24,
          "text": "והיינו,"
        },
        {
          "s": 25,
          "text": "דע\"י שישראל נוטלין את שופריהן ותוקעין לפני הקב\"ה הם ממשיכים לא רק הרחמים המתעוררים ע\"י עבודה"
        },
        {
          "s": 26,
          "text": "(אתערותא דלעילא שמתעוררת ע\"י אתערותא דלתתא),"
        },
        {
          "s": 27,
          "text": "אלא שעי\"ז ממשיכים הם גם הרחמים14"
        },
        {
          "s": 28,
          "text": "שמצד בחירת הקב\"ה בישראל,"
        },
        {
          "s": 29,
          "text": "יבחר לנו."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ויש להוסיף,"
        },
        {
          "s": 2,
          "text": "דענין הנ\"ל"
        },
        {
          "s": 3,
          "text": "(שע\"י שישראל תוקעין בשופר ממשיכים הם גם הענין דבחירת העצמות שאין שייך לעורר שם ע\"י אתעדל\"ת)"
        },
        {
          "s": 4,
          "text": "מובן גם מהידוע15"
        },
        {
          "s": 5,
          "text": "שעיקר16"
        },
        {
          "s": 6,
          "text": "ענין ר\"ה הוא בנין המלכות,"
        },
        {
          "s": 7,
          "text": "כמאמר רז\"ל17"
        },
        {
          "s": 8,
          "text": "אמרו לפני מלכיות כדי שתמליכוני עליכם."
        },
        {
          "s": 9,
          "text": "ומה שאמרו18"
        },
        {
          "s": 10,
          "text": "מצות היום בשופר הוא,"
        },
        {
          "s": 11,
          "text": "כי הענין דתמליכוני עליכם הוא ע\"י תקיעת שופר19,"
        },
        {
          "s": 12,
          "text": "כהמשך מארז\"ל הנ\"ל ובמה בשופר20."
        },
        {
          "s": 13,
          "text": "והשייכות דר\"ה לבנין המלכות"
        },
        {
          "s": 14,
          "text": "(בפשטות)"
        },
        {
          "s": 15,
          "text": "היא21,"
        },
        {
          "s": 16,
          "text": "לפי שבר\"ה הוא חידוש מעשה בראשית."
        },
        {
          "s": 17,
          "text": "כמו שאומרים22"
        },
        {
          "s": 18,
          "text": "זה היום תחלת מעשיך,"
        },
        {
          "s": 19,
          "text": "שבכל ר\"ה מתהוים כל העולמות23"
        },
        {
          "s": 20,
          "text": "מחדש כמו שהי' בפעם הראשונה."
        },
        {
          "s": 21,
          "text": "והענין הוא,"
        },
        {
          "s": 22,
          "text": "דהתהוות כל העולמות היא ממדת מלכותו ית'."
        },
        {
          "s": 23,
          "text": "והמשכת המלכות שבכל ר\"ה"
        },
        {
          "s": 24,
          "text": "(כולל גם ר\"ה הראשון שבתחלת הבריאה)"
        },
        {
          "s": 25,
          "text": "היא רק על שנה אחת24,"
        },
        {
          "s": 26,
          "text": "ובערב ר\"ה עם חשיכה25"
        },
        {
          "s": 27,
          "text": "היא חוזרת ועולה ונכללת במקורה24."
        },
        {
          "s": 28,
          "text": "אלא שהעלי' והסילוק הוא רק בפנימיות המלכות,"
        },
        {
          "s": 29,
          "text": "שהוא התענוג והרצון שבמלכות."
        },
        {
          "s": 30,
          "text": "והחיות דהעולם בר\"ה"
        },
        {
          "s": 31,
          "text": "(גם לפני הענין דתמליכוני עליכם)"
        },
        {
          "s": 32,
          "text": "הוא מחיצוניות המלכות26,"
        },
        {
          "s": 33,
          "text": "בדוגמת אדם שעושה מלאכה כשהוא עיף ורפה ידים ואין לו תענוג בזה27."
        },
        {
          "s": 34,
          "text": "וכפתגם הידוע28,"
        },
        {
          "s": 35,
          "text": "שבליל ר\"ה"
        },
        {
          "s": 36,
          "text": "(לפני הענין דתמליכוני עליכם)"
        },
        {
          "s": 37,
          "text": "העולם הוא במצב דהתעלפות."
        },
        {
          "s": 38,
          "text": "וזהו אמרו לפני מלכיות כדי שתמליכוני עליכם,"
        },
        {
          "s": 39,
          "text": "שיהי' לו רצון ותענוג במלוכה."
        },
        {
          "s": 40,
          "text": "והנה ידוע27"
        },
        {
          "s": 41,
          "text": "שהסילוק שבר\"ה הוא בכל המדריגות"
        },
        {
          "s": 42,
          "text": "(מעשה,"
        },
        {
          "s": 43,
          "text": "דיבור,"
        },
        {
          "s": 44,
          "text": "מחשבה,"
        },
        {
          "s": 45,
          "text": "מדות ושכל),"
        },
        {
          "s": 46,
          "text": "דכל הדברים חוזרין לקדמותן."
        },
        {
          "s": 47,
          "text": "והמשכת המלכות"
        },
        {
          "s": 48,
          "text": "(רצון ותענוג במלוכה)"
        },
        {
          "s": 49,
          "text": "בר\"ה היא ע\"י שממשיכים מעצמות אוא\"ס."
        },
        {
          "s": 50,
          "text": "ומזה שהענין דתמליכוני עליכם הוא ע\"י תקיעת שופר כנ\"ל,"
        },
        {
          "s": 51,
          "text": "מובן,"
        },
        {
          "s": 52,
          "text": "שתקיעת שופר מגעת בעצמות אוא\"ס."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "וצריך להבין,"
        },
        {
          "s": 1,
          "text": "הרי תקיעת שופר היא מצוה,"
        },
        {
          "s": 2,
          "text": "וענין הציוויים"
        },
        {
          "s": 3,
          "text": "(מצוות)"
        },
        {
          "s": 4,
          "text": "שייך דוקא לאחרי שהוא ית' נעשה מלך,"
        },
        {
          "s": 5,
          "text": "כמאמר29"
        },
        {
          "s": 6,
          "text": "קבלו מלכותי תחלה ואח\"כ אגזור עליכם גזירות,"
        },
        {
          "s": 7,
          "text": "ובכדי שיהי' תמליכוני עליכם"
        },
        {
          "s": 8,
          "text": "(שישראל עושים אותו ית' למלך)"
        },
        {
          "s": 9,
          "text": "הוא ע\"י שמגיעים בעצמות אוא\"ס כמו שהוא לפני"
        },
        {
          "s": 10,
          "text": "(למעלה)"
        },
        {
          "s": 11,
          "text": "שנעשה מלך,"
        },
        {
          "s": 12,
          "text": "ואיך אפשר שע\"י תקיעת שופר"
        },
        {
          "s": 13,
          "text": "(קיום מצות וציווי המלך)"
        },
        {
          "s": 14,
          "text": "יעשו אותו ית' למלך30."
        },
        {
          "s": 15,
          "text": "ומזה מובן,"
        },
        {
          "s": 16,
          "text": "דבתקיעת שופר שני ענינים,"
        },
        {
          "s": 17,
          "text": "המצוה דתקיעת שופר,"
        },
        {
          "s": 18,
          "text": "וזה שע\"י תקיעת שופר מגיעים בעצמות אוא\"ס שלמעלה מבחינת מלך."
        }
      ]
    }
  ]
}