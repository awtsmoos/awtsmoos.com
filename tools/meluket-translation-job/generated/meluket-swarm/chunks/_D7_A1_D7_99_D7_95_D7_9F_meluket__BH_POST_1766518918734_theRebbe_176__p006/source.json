{
  "globalIndex": 838,
  "owner": 38,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918734_theRebbe_176__p006",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918734_theRebbe_176__p006",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918734_theRebbe_176",
  "title": "מאמר וידבר אלוקים את כל הדברים האלה תשכ\"ח",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "ויתירה מזו,"
        },
        {
          "s": 1,
          "text": "דע\"י העיון והיגיעה בהפרטים דתורה שבעל פה,"
        },
        {
          "s": 2,
          "text": "מגיעים למעלה גם מבחינת הכלל."
        },
        {
          "s": 3,
          "text": "דזהו מה שאמרו כל מה שתלמיד ותיק עתיד לחדש"
        },
        {
          "s": 4,
          "text": "(לחדש44"
        },
        {
          "s": 5,
          "text": "דוקא)45,"
        },
        {
          "s": 6,
          "text": "כי ע\"י היגיעה בתורה ממשיכים מבחינת התורה כמו שהיא מושרשת בהעלם העצמי דא\"ס,"
        },
        {
          "s": 7,
          "text": "שלמעלה מבחינת התורה כמו שבאה בבחינת המשכה וגילוי46."
        },
        {
          "s": 8,
          "text": "וזהו יגעתי ומצאתי47,"
        },
        {
          "s": 9,
          "text": "דענין מציאה"
        },
        {
          "s": 10,
          "text": "(מצאתי)"
        },
        {
          "s": 11,
          "text": "הוא שמוצא דבר חדש שבתחילה לא הי' אפשר לשער,"
        },
        {
          "s": 12,
          "text": "כמו מציאה שבאה48"
        },
        {
          "s": 13,
          "text": "בהיסח הדעת."
        },
        {
          "s": 14,
          "text": "וזהו יגעתי ומצאתי,"
        },
        {
          "s": 15,
          "text": "שע\"י היגיעה בתורה מוצאים ומגלים ענינים חדשים,"
        },
        {
          "s": 16,
          "text": "ועד שע\"י היגיעה בתורה"
        },
        {
          "s": 17,
          "text": "[ובפרט בפנימיות התורה שהיא מעין תורתו של משיח]"
        },
        {
          "s": 18,
          "text": "עכשיו,"
        },
        {
          "s": 19,
          "text": "נזכה לגילוי תורתו של משיח,"
        },
        {
          "s": 20,
          "text": "שבא48"
        },
        {
          "s": 21,
          "text": "בהיסח הדעת,"
        },
        {
          "s": 22,
          "text": "מצאתי דוד עבדי49"
        },
        {
          "s": 23,
          "text": "(מצאתי דוקא),"
        },
        {
          "s": 24,
          "text": "שאז יהי' גילוי עצמות אוא\"ס בלי לבוש50"
        },
        {
          "s": 25,
          "text": "(ועד שגם הגילוי בשעת מ\"ת הי' רק מעין הגילוי דלעתיד50),"
        },
        {
          "s": 26,
          "text": "בביאת משיח צדקנו,"
        },
        {
          "s": 27,
          "text": "בקרוב ממש."
        }
      ]
    }
  ]
}