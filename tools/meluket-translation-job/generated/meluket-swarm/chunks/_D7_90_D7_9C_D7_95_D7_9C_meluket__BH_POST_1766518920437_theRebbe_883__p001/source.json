{
  "globalIndex": 1110,
  "owner": 10,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920437_theRebbe_883__p001",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920437_theRebbe_883__p001",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920437_theRebbe_883",
  "title": "מאמר אתם נצבים תשל\"ט",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "אור ליום ב' פ' נצבים-וילך,"
        },
        {
          "s": 2,
          "text": "ח\"י אלול ה'תשל\"ט*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "(הנחה)"
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "אתם נצבים היום כולכם לפני ה' אלקיכם ראשיכם שבטיכם גו' לעברך בברית ה' אלקיך גו'1,"
        },
        {
          "s": 1,
          "text": "ואח\"כ ממשיך2"
        },
        {
          "s": 2,
          "text": "(בפ' שני,"
        },
        {
          "s": 3,
          "text": "שיעור לימוד החומש דיום זה)"
        },
        {
          "s": 4,
          "text": "(ולא אתכם לבדכם אנכי כורת את הברית הזאת גו' כי את גו' אשר איננו פה עמנו היום)"
        },
        {
          "s": 5,
          "text": "ושב3"
        },
        {
          "s": 6,
          "text": "ה' אלקיך גו'."
        },
        {
          "s": 7,
          "text": "והנה פרשה זו קורין לעולם קודם ראש השנה"
        },
        {
          "s": 8,
          "text": "(כמ\"ש רבינו הזקן בלקו\"ת4),"
        },
        {
          "s": 9,
          "text": "וידועה תורת הבעש\"ט5"
        },
        {
          "s": 10,
          "text": "שאתם נצבים זהו ברכתו של הקב\"ה שמברך את עמו בני ישראל בשבת מברכים שהוא השבת האחרון דחודש אלול בברכת החודש דחודש השביעי,"
        },
        {
          "s": 11,
          "text": "ובכח זה ישראל מברכים את החדשים דכל השנה,"
        },
        {
          "s": 12,
          "text": "שמזה מובן שענין זה"
        },
        {
          "s": 13,
          "text": "(דאתם נצבים גו')"
        },
        {
          "s": 14,
          "text": "הוא ענין כללי."
        },
        {
          "s": 15,
          "text": "והענין הוא,"
        },
        {
          "s": 16,
          "text": "דהנה הכתוב מבאר דזה שאתם נצבים היום כולכם גו',"
        },
        {
          "s": 17,
          "text": "כל עשר המדריגות6"
        },
        {
          "s": 18,
          "text": "מראשיכם שבטיכם עד חוטב עציך ושואב מימיך,"
        },
        {
          "s": 19,
          "text": "לאחדים כאחד6,"
        },
        {
          "s": 20,
          "text": "הוא בכדי לעברך בברית ה' אלקיך גו' שקודם שנכנסו לארץ"
        },
        {
          "s": 21,
          "text": "(שאז נאמרה פרשה זו בפעם הראשונה)"
        },
        {
          "s": 22,
          "text": "הי' כריתת ברית על קבלת התורה מלבד הברית אשר כרת אתם בחורב7,"
        },
        {
          "s": 23,
          "text": "היינו שמדובר כאן על כריתת ברית מיוחדת שלפני הכניסה לארץ."
        },
        {
          "s": 24,
          "text": "ומכיון שלא אתכם לבדכם אנכי כורת את הברית הזאת"
        },
        {
          "s": 25,
          "text": "(כ\"א גם)"
        },
        {
          "s": 26,
          "text": "את אשר איננו פה עמנו היום,"
        },
        {
          "s": 27,
          "text": "מובן שענין הכריתת ברית שלפני כניסת הארץ שייך בעבודת כל אחד ואחד."
        }
      ]
    }
  ]
}