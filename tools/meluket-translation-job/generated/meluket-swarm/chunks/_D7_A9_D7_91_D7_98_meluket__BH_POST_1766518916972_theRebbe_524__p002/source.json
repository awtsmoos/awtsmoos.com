{
  "globalIndex": 561,
  "owner": 11,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916972_theRebbe_524__p002",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916972_theRebbe_524__p002",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916972_theRebbe_524",
  "title": "מאמר באתי לגני תשמ\"ח",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה ידוע14"
        },
        {
          "s": 2,
          "text": "שהציווי ועשו לי מקדש הוא גם על המקדש,"
        },
        {
          "s": 3,
          "text": "בית ראשון בית שני,"
        },
        {
          "s": 4,
          "text": "וגם ביהמ\"ק השלישי שיבנה במהרה בימינו."
        },
        {
          "s": 5,
          "text": "ומזה מובן,"
        },
        {
          "s": 6,
          "text": "דכמו שהמשכת עיקר שכינה במשכן היתה ע\"י העבודה שלמעלה ממדידה והגבלה,"
        },
        {
          "s": 7,
          "text": "שטות דקדושה שלמעלה מטעם ודעת,"
        },
        {
          "s": 8,
          "text": "עד\"ז הוא בנוגע להמשכת עיקר שכינה בביהמ\"ק,"
        },
        {
          "s": 9,
          "text": "שזה נעשה ע\"י העבודה דשטות דקדושה שלמעלה ממדידה והגבלה."
        },
        {
          "s": 10,
          "text": "דע\"י מעשינו ועבודתינו במשך זמן הגלות באופן דשטות דקדושה שלמעלה מטעם ודעת,"
        },
        {
          "s": 11,
          "text": "עי\"ז ועשו לי,"
        },
        {
          "s": 12,
          "text": "עשיית ביהמ\"ק השלישי שיבנה במהרה בימינו,"
        },
        {
          "s": 13,
          "text": "שיהי' נעלה עוד יותר מהמשכן וביהמ\"ק הא' והב',"
        },
        {
          "s": 14,
          "text": "מקדש אד' כוננו ידיך15."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וזהו מה שישראל נק' בשם צבאות הוי'16"
        },
        {
          "s": 2,
          "text": "במשך כל הדורות,"
        },
        {
          "s": 3,
          "text": "דכאו\"א מישראל הוא חייל בצבאות השם,"
        },
        {
          "s": 4,
          "text": "שיוצא צבא למלחמה,"
        },
        {
          "s": 5,
          "text": "לכבוש את העולם ולעשותו דירה לו ית'."
        },
        {
          "s": 6,
          "text": "וזה מה שישראל נק' בשם צבאות ה'"
        },
        {
          "s": 7,
          "text": "(צבא דייקא)"
        },
        {
          "s": 8,
          "text": "הוא להורות,"
        },
        {
          "s": 9,
          "text": "שעבודתם צריכה להיות באופן שלא יתחשבו עם חשבונות שע\"פ טו\"ד,"
        },
        {
          "s": 10,
          "text": "שטות דקדושה שלמעלה מטו\"ד,"
        },
        {
          "s": 11,
          "text": "בדוגמת צבא כפשוטו."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר17,"
        },
        {
          "s": 2,
          "text": "דכמו שבמלחמה בגשמיות,"
        },
        {
          "s": 3,
          "text": "בכדי לנצח את המלחמה מבזבז המלך את כל האוצרות שנקבצו במשך כמה שנים מדור אחר דור18,"
        },
        {
          "s": 4,
          "text": "דהגם שע\"ד הרגיל הנה לא רק שאין משתמשים בהם"
        },
        {
          "s": 5,
          "text": "(אפילו לצורך גדול)"
        },
        {
          "s": 6,
          "text": "אלא יתירה מזו,"
        },
        {
          "s": 7,
          "text": "שהם כמוסים וגנוזים מעין כל רואה,"
        },
        {
          "s": 8,
          "text": "ומ\"מ בכדי לנצח את המנגד,"
        },
        {
          "s": 9,
          "text": "הנה לא רק שמשתמשים בהאוצרות אלא שגם מבזבזים אותם,"
        },
        {
          "s": 10,
          "text": "דבזבוז הוא למעלה מחשבון מדידה והגבלה,"
        },
        {
          "s": 11,
          "text": "והטעם לזה הוא כי הנצח מושרש בעצם הנפש דשם"
        },
        {
          "s": 12,
          "text": "(בעצם הנפש)"
        },
        {
          "s": 13,
          "text": "אין שייך שום חשבונות,"
        },
        {
          "s": 14,
          "text": "עד\"ז הוא גם למעלה,"
        },
        {
          "s": 15,
          "text": "שבכדי שצבאות ה' ינצחו את המלחמה,"
        },
        {
          "s": 16,
          "text": "לכבוש את העולם ולעשותו דירה לו ית',"
        },
        {
          "s": 17,
          "text": "נותנים להם בחי' האוצר שלמעלה,"
        },
        {
          "s": 18,
          "text": "ולא עוד,"
        },
        {
          "s": 19,
          "text": "אלא שנתינת האוצרות להם הוא באופן דבזבוז,"
        },
        {
          "s": 20,
          "text": "למעלה מחשבון."
        },
        {
          "s": 21,
          "text": "והגם שגם בנתינה"
        },
        {
          "s": 22,
          "text": "(ע\"ד הרגיל)"
        },
        {
          "s": 23,
          "text": "אמרו19"
        },
        {
          "s": 24,
          "text": "כל הנותן בעין יפה נותן,"
        },
        {
          "s": 25,
          "text": "הרי גם \"עין יפה\" הוא תואר של מדידה והגבלה,"
        },
        {
          "s": 26,
          "text": "משא\"כ כשהנתינה היא באופן דבזבוז,"
        },
        {
          "s": 27,
          "text": "אין בה הגבלות."
        },
        {
          "s": 28,
          "text": "והטעם על זה"
        },
        {
          "s": 29,
          "text": "(שבכדי שהצבאות ה' ינצחו את המלחמה,"
        },
        {
          "s": 30,
          "text": "נותנים להם את האוצרות ובאופן דבזבוז)"
        },
        {
          "s": 31,
          "text": "הוא,"
        },
        {
          "s": 32,
          "text": "כי שרש הנצח הוא בפנימיות הכתר20,"
        },
        {
          "s": 33,
          "text": "דשם"
        },
        {
          "s": 34,
          "text": "(בפנימיות הכתר)"
        },
        {
          "s": 35,
          "text": "אין שייך שום חשבונות."
        },
        {
          "s": 36,
          "text": "והגם שנתינת האוצרות ובאופן דבזבוז היא ע\"י השרים ומפקדי המלחמה,"
        },
        {
          "s": 37,
          "text": "נשיאי ישראל שבכל דור,"
        },
        {
          "s": 38,
          "text": "עד לנשיא דורנו בעל ההילולא,"
        },
        {
          "s": 39,
          "text": "הרי עיקר הכוונה בזה הוא שהאוצרות יומשכו ויותנו להאנשי חיל,"
        },
        {
          "s": 40,
          "text": "צבאות הוי',"
        },
        {
          "s": 41,
          "text": "שעל ידם נעשה הנצחון בפועל21."
        },
        {
          "s": 42,
          "text": "וזהו גם מה שהנצחון שיהי' ע\"י העבודה דצבאות ה'"
        },
        {
          "s": 43,
          "text": "(בביהמ\"ק השלישי)"
        },
        {
          "s": 44,
          "text": "הוא נצחון נצחי"
        },
        {
          "s": 45,
          "text": "(הוי' ימלוך לעולם ועד22),"
        },
        {
          "s": 46,
          "text": "דמכיון שהנתינת כח על עבודתם היא מפנימיות הכתר,"
        },
        {
          "s": 47,
          "text": "דבפנימיות הכתר אין שייך ענין השינויים,"
        },
        {
          "s": 48,
          "text": "לכן גם העבודה דהצבאות ה' היא בתוקף חזק בלי שינויים,"
        },
        {
          "s": 49,
          "text": "ובמילא גם הנצחון שע\"י העבודה הוא נצחי שאין שייך בו הפסק ושינוי."
        }
      ]
    }
  ]
}