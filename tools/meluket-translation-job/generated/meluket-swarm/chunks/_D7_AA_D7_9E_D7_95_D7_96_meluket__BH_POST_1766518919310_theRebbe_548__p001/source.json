{
  "globalIndex": 933,
  "owner": 33,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919310_theRebbe_548__p001",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919310_theRebbe_548__p001",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919310_theRebbe_548",
  "title": "מאמר זה היום עשה ה' תשל\"ח",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "י\"ב תמוז ה'תשל\"ח*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "זה היום עשה ה' נגילה ונשמחה בו1,"
        },
        {
          "s": 1,
          "text": "ומביא כ\"ק מו\"ח אדמו\"ר בעל הגאולה במאמרו ד\"ה זה"
        },
        {
          "s": 2,
          "text": "[שאמרו בחגיגת י\"ב תמוז הראשונה"
        },
        {
          "s": 3,
          "text": "(בסעודת הודאה),"
        },
        {
          "s": 4,
          "text": "בשנת תרפ\"ח2],"
        },
        {
          "s": 5,
          "text": "דאיתא במדרש3,"
        },
        {
          "s": 6,
          "text": "אמר ר' אבין אין אנו יודעים במה לשמוח אם ביום או בהקב\"ה,"
        },
        {
          "s": 7,
          "text": "בא שלמה ופירש4"
        },
        {
          "s": 8,
          "text": "נגילה ונשמחה בך בהקב\"ה,"
        },
        {
          "s": 9,
          "text": "בך ביראתך,"
        },
        {
          "s": 10,
          "text": "בך בתורתך,"
        },
        {
          "s": 11,
          "text": "בך בישועתך5."
        },
        {
          "s": 12,
          "text": "אמר ר' יצחק בך בעשרים ושתים אותיות שכתבת לנו בתורה,"
        },
        {
          "s": 13,
          "text": "ב' תרין כ' עשרין,"
        },
        {
          "s": 14,
          "text": "הרי בך."
        },
        {
          "s": 15,
          "text": "ומדייק בהמאמר,"
        },
        {
          "s": 16,
          "text": "מהו אומרו אין אנו יודעים במה לשמוח אם ביום או בהקב\"ה,"
        },
        {
          "s": 17,
          "text": "דמכיון שזה היום עשה ה'"
        },
        {
          "s": 18,
          "text": "[היינו,"
        },
        {
          "s": 19,
          "text": "דגם מעלתו של היום הוא לא מצד עצמו אלא שזה היום עשה ה'],"
        },
        {
          "s": 20,
          "text": "הרי מובן לכאורה שהשמחה צריכה להיות בהקב\"ה,"
        },
        {
          "s": 21,
          "text": "ומהו אומרו אין אנו יודעים במה לשמוח אם ביום או בהקב\"ה."
        },
        {
          "s": 22,
          "text": "וגם מה הם ג' הענינים דיראה תורה וישועה."
        },
        {
          "s": 23,
          "text": "וגם צ\"ל המאמר דר' יצחק בך בעשרים ושתים אותיות כו',"
        },
        {
          "s": 24,
          "text": "הרי בך בפשטות הוא בך בהקב\"ה,"
        },
        {
          "s": 25,
          "text": "ולמה מפרש בך בעשרים ושתים אותיות."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה ביאור מעלת היום"
        },
        {
          "s": 2,
          "text": "(ועד שיש קס\"ד לשמוח בהיום)"
        },
        {
          "s": 3,
          "text": "הוא6,"
        },
        {
          "s": 4,
          "text": "כי היום שבו נעשה נס7"
        },
        {
          "s": 5,
          "text": "הוא יום נעלה."
        },
        {
          "s": 6,
          "text": "ושני ענינים בזה."
        },
        {
          "s": 7,
          "text": "דהיום שבו נעשה נס הוא יום זכאי מצד עצמו"
        },
        {
          "s": 8,
          "text": "(גם מקודם),"
        },
        {
          "s": 9,
          "text": "שלכן נעשה בו נס,"
        },
        {
          "s": 10,
          "text": "כי מגלגלין זכות ליום זכאי8."
        },
        {
          "s": 11,
          "text": "ועוד דע\"י הנס שהי' בו,"
        },
        {
          "s": 12,
          "text": "נעשה יום זכאי ויום סגולה וכו'"
        },
        {
          "s": 13,
          "text": "(עוד יותר מכמו שהי' לפני זה)."
        },
        {
          "s": 14,
          "text": "ולא עוד אלא שביום זה עצמו עיקר העילוי הוא בהזמן הפרטי"
        },
        {
          "s": 15,
          "text": "(יום או לילה)"
        },
        {
          "s": 16,
          "text": "שבו נעשה הנס."
        },
        {
          "s": 17,
          "text": "כדאיתא במדרש9"
        },
        {
          "s": 18,
          "text": "בשעה שאתה עושה לנו נסים ביום אנו אומרים לפניך שירה ביום"
        },
        {
          "s": 19,
          "text": "(ותשר דבורה וברק בן אבינועם ביום וגו'10),"
        },
        {
          "s": 20,
          "text": "ובשעה שאתה עושה לנו נסים בלילה אנו אומרים לפניך שירה בלילה"
        },
        {
          "s": 21,
          "text": "(השיר יהי' לכם כליל התקדש חג11)."
        }
      ]
    }
  ]
}