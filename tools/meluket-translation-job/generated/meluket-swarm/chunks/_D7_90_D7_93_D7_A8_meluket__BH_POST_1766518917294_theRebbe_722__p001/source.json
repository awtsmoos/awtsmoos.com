  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917294_theRebbe_722__p001",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917294_theRebbe_722__p001",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917294_theRebbe_722",
  "title": "מאמר כי תשא תשכ\"ח",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ תשא,"
        },
        {
          "s": 2,
          "text": "ט\"ז אדר,"
        },
        {
          "s": 3,
          "text": "ה'תשכ\"ח"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "(הנחה)"
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "כי תשא גו',"
        },
        {
          "s": 1,
          "text": "הנה בפרשה זו1"
        },
        {
          "s": 2,
          "text": "מבואר ענין העבודה במשכן ובמקדש דאקרי משכן2,"
        },
        {
          "s": 3,
          "text": "ענין מעשה הקטרת,"
        },
        {
          "s": 4,
          "text": "שזה הי' מהעבודות העקריות במשכן,"
        },
        {
          "s": 5,
          "text": "ואעפ\"י שגם בפרשה הקודמת,"
        },
        {
          "s": 6,
          "text": "פ' תצוה3,"
        },
        {
          "s": 7,
          "text": "מדובר מענין הקטרת,"
        },
        {
          "s": 8,
          "text": "וכן בפרשה הבאה,"
        },
        {
          "s": 9,
          "text": "פ' ויקהל4,"
        },
        {
          "s": 10,
          "text": "אבל שם מדובר רק בכללות,"
        },
        {
          "s": 11,
          "text": "ובפרשה זו מבואר הענין בפרטות,"
        },
        {
          "s": 12,
          "text": "דהיינו ההכנות לזה,"
        },
        {
          "s": 13,
          "text": "וממה שהי' הקטרת נעשית,"
        },
        {
          "s": 14,
          "text": "וכן גודל הענין שבזה,"
        },
        {
          "s": 15,
          "text": "והלאוים הקשורים בזה וחומר הענין שבהם ועד לענין של היפך החיים להעובר עליהם,"
        },
        {
          "s": 16,
          "text": "אשר גם ענין זה דהיפך החיים מבואר דוקא בפרשה זו מאחר שכאן מבואר חומר הענין,"
        },
        {
          "s": 17,
          "text": "והגם שגם בקרבנות ישנם כו\"כ לאוים כמו חולין בעזרה ושחוטי חוץ וכו',"
        },
        {
          "s": 18,
          "text": "אך אין זה מגיע לקטרת שחמורה כ\"כ עד לענין של היפך החיים להעושה במתכונתה."
        }
      ]
    }
  ]
}