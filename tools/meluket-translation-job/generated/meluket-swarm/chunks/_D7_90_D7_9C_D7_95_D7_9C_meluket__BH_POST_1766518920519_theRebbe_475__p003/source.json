{
  "globalIndex": 1126,
  "owner": 26,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920519_theRebbe_475__p003",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920519_theRebbe_475__p003",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920519_theRebbe_475",
  "title": "מאמר אתם נצבים תשט\"ז",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ולהבין בפרטיות יותר מעלת הצדקה שעז\"נ ר\"א יהיב פרוטה לעני והדר מצלי שנאמר אני בצדק אחזה פניך,"
        },
        {
          "s": 2,
          "text": "הנה,"
        },
        {
          "s": 3,
          "text": "ענין הצדקה הוא להחיות רוח שפלים,"
        },
        {
          "s": 4,
          "text": "שהוא העני שאין לו כלום,"
        },
        {
          "s": 5,
          "text": "וכאשר נותן לו צדקה הרי הוא מחי' אותו,"
        },
        {
          "s": 6,
          "text": "ועי\"ז מעורר למעלה ג\"כ ענין להחיות רוח שפלים,"
        },
        {
          "s": 7,
          "text": "שהם ג' עולמות בי\"ע,"
        },
        {
          "s": 8,
          "text": "שנקראים שפלים,"
        },
        {
          "s": 9,
          "text": "ע\"ש שמקור התהוותם הוא רק מבחי' המלכות שהיא בחי' הארה בלבד,"
        },
        {
          "s": 10,
          "text": "כמ\"ש33"
        },
        {
          "s": 11,
          "text": "כי נשגב שמו לבדו"
        },
        {
          "s": 12,
          "text": "(ורק)"
        },
        {
          "s": 13,
          "text": "הודו"
        },
        {
          "s": 14,
          "text": "(זיו והארה בלבד)"
        },
        {
          "s": 15,
          "text": "על ארץ ושמים,"
        },
        {
          "s": 16,
          "text": "ולכן צריך להחיות רוח שפלים,"
        },
        {
          "s": 17,
          "text": "היינו,"
        },
        {
          "s": 18,
          "text": "שגם בבי\"ע יורגש אור האצילות,"
        },
        {
          "s": 19,
          "text": "וזהו ענין הצדקה למעלה שנפעל ע\"י הצדקה למטה."
        },
        {
          "s": 20,
          "text": "ועי\"ז נמשך אח\"כ בתפלה גילוי אור שלמעלה מהשתלשלות,"
        },
        {
          "s": 21,
          "text": "שהו\"ע הארת אוא\"ס מבחי' פנים,"
        },
        {
          "s": 22,
          "text": "אחזה פניך."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ובפרטיות יותר הנה בענין הצדקה גופא ישנם ב' אופני עבודה."
        },
        {
          "s": 1,
          "text": "דהנה אמרו חז\"ל34"
        },
        {
          "s": 2,
          "text": "הנותן פרוטה לעני מתברך בששה ברכות והמפייסו מתברך בי\"א ברכות."
        },
        {
          "s": 3,
          "text": "והענין בזה,"
        },
        {
          "s": 4,
          "text": "שנתינת פרוטה לעני היא לצורך גופו,"
        },
        {
          "s": 5,
          "text": "וכיון שעי\"ז הוא מחי' את גופו בלבד,"
        },
        {
          "s": 6,
          "text": "אזי גם פעולתו בענין הצדקה למעלה היא רק להמשיך אור האצילות לבי\"ע."
        },
        {
          "s": 7,
          "text": "וכמרומז גם בלשון פרוטה,"
        },
        {
          "s": 8,
          "text": "שהוא פרט ו\"ה35,"
        },
        {
          "s": 9,
          "text": "דהיינו להמשיך ולהפריט בחי' הוא\"ו אל הה\"א,"
        },
        {
          "s": 10,
          "text": "וכמבואר בסידור36"
        },
        {
          "s": 11,
          "text": "בד\"ה אדנ-י שפתי תפתח בענין קול ודיבור,"
        },
        {
          "s": 12,
          "text": "שהקול הוא בחי' כלל,"
        },
        {
          "s": 13,
          "text": "והדיבור הוא בחי' פרט שמפרט מה שבכלל,"
        },
        {
          "s": 14,
          "text": "כי הקול הוא בחי' כללות על כל האותיות,"
        },
        {
          "s": 15,
          "text": "והאותיות הם בחי' פרטיות כו'."
        },
        {
          "s": 16,
          "text": "וזהו\"ע פרוטה להפריט בחי' הוא\"ו אל הה\"א."
        },
        {
          "s": 17,
          "text": "ולכן מתברך בוא\"ו ברכות,"
        },
        {
          "s": 18,
          "text": "כנגד אות וא\"ו דשם הוי'."
        },
        {
          "s": 19,
          "text": "אמנם,"
        },
        {
          "s": 20,
          "text": "פיוס העני אינו ענין הנצרך לגופו בלבד,"
        },
        {
          "s": 21,
          "text": "כי אם ענין של הנחת הדעת,"
        },
        {
          "s": 22,
          "text": "והיינו,"
        },
        {
          "s": 23,
          "text": "שהעני מצד עצמו הוא בהתמרמרות כו',"
        },
        {
          "s": 24,
          "text": "לפי שיש לו תרעומת על כך שהוא עני,"
        },
        {
          "s": 25,
          "text": "וכמ\"ש37"
        },
        {
          "s": 26,
          "text": "תפלה לעני כי יעטוף גו',"
        },
        {
          "s": 27,
          "text": "שתפלתו היא על עצם היותו עני,"
        },
        {
          "s": 28,
          "text": "דעם היות שסדר הבריאה הוא באופן שצריך להיות החילוק דעשיר ועני38,"
        },
        {
          "s": 29,
          "text": "מ\"מ,"
        },
        {
          "s": 30,
          "text": "טוען למה צריך הוא להיות העני."
        },
        {
          "s": 31,
          "text": "וכאשר מדברים על לבו של העני ומניחים את דעתו כו' עד שמתפייס,"
        },
        {
          "s": 32,
          "text": "הרי זה ענין נעלה יותר מאשר נתינת פרוטה לצרכי גופו בלבד."
        },
        {
          "s": 33,
          "text": "ולכן עי\"ז פועלים"
        },
        {
          "s": 34,
          "text": "(לא רק המשכת אור האצילות בבי\"ע,"
        },
        {
          "s": 35,
          "text": "אלא גם)"
        },
        {
          "s": 36,
          "text": "המשכת פנימיות האלקות."
        },
        {
          "s": 37,
          "text": "וזהו שהמפייסו מתברך בי\"א ברכות,"
        },
        {
          "s": 38,
          "text": "כידוע שמספר י\"א מורה על בחי' שלמעלה מעשר ספירות39,"
        },
        {
          "s": 39,
          "text": "וע\"ד לפני הוי',"
        },
        {
          "s": 40,
          "text": "למעלה מהוי'40."
        },
        {
          "s": 41,
          "text": "וזהו גם שפיוס אותיות יוסף41,"
        },
        {
          "s": 42,
          "text": "דהנה ביוסף כתיב42"
        },
        {
          "s": 43,
          "text": "אלה תולדות יעקב יוסף,"
        },
        {
          "s": 44,
          "text": "והיינו,"
        },
        {
          "s": 45,
          "text": "שענינו של יעקב הוא באצילות,"
        },
        {
          "s": 46,
          "text": "אבל התכלית היא שיומשך גם בבי\"ע,"
        },
        {
          "s": 47,
          "text": "וזהו ענינו של יוסף שהוא המשביר בר לכל הארץ43,"
        },
        {
          "s": 48,
          "text": "שהו\"ע ההמשכה למטה,"
        },
        {
          "s": 49,
          "text": "וכדי שיומשך למטה צ\"ל ההמשכה מבחי' נעלית ביותר כו'."
        },
        {
          "s": 50,
          "text": "וזהו\"ע יהיב פרוטה לעני והדר מצלי,"
        },
        {
          "s": 51,
          "text": "היינו שתחלה צ\"ל יהיב פרוטה,"
        },
        {
          "s": 52,
          "text": "ועי\"ז בא אח\"כ להיות אחזה פניך,"
        },
        {
          "s": 53,
          "text": "המשכה פנימית,"
        },
        {
          "s": 54,
          "text": "כמו ע\"י ענין הפיוס."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה ב' האופנים הנ\"ל בעבודת הצדקה"
        },
        {
          "s": 2,
          "text": "(הנותן פרוטה לעני והמפייסו)"
        },
        {
          "s": 3,
          "text": "צריכים להיות קודם התפלה."
        },
        {
          "s": 4,
          "text": "והענין בזה,"
        },
        {
          "s": 5,
          "text": "דהנה,"
        },
        {
          "s": 6,
          "text": "בנוגע לתפלה אמרו רז\"ל44"
        },
        {
          "s": 7,
          "text": "תפלות אבות תקנום,"
        },
        {
          "s": 8,
          "text": "וכמו\"כ אמרו רז\"ל45"
        },
        {
          "s": 9,
          "text": "שג' הרגלים הם כנגד ג' האבות,"
        },
        {
          "s": 10,
          "text": "פסח כנגד אברהם,"
        },
        {
          "s": 11,
          "text": "שבועות כנגד יצחק,"
        },
        {
          "s": 12,
          "text": "וסוכות כנגד יעקב."
        },
        {
          "s": 13,
          "text": "ונמצא,"
        },
        {
          "s": 14,
          "text": "שענין התפלה וענין הרגלים הם מדרגה אחת."
        },
        {
          "s": 15,
          "text": "והנה,"
        },
        {
          "s": 16,
          "text": "בענין הרגלים כתיב46"
        },
        {
          "s": 17,
          "text": "שלש פעמים בשנה יראה כל זכורך את פני הוי' אלקיך במקום אשר יבחר,"
        },
        {
          "s": 18,
          "text": "היינו,"
        },
        {
          "s": 19,
          "text": "שבביהמ\"ק שהי' מכוון נגד ההיכלות47"
        },
        {
          "s": 20,
          "text": "הי' גילוי פני הוי' אלקיך,"
        },
        {
          "s": 21,
          "text": "וכמו\"כ בתפלה שסדרה נתקן נגד ההיכלות48"
        },
        {
          "s": 22,
          "text": "יש בה הגילוי דפני הוי' אלקיך."
        },
        {
          "s": 23,
          "text": "והנה,"
        },
        {
          "s": 24,
          "text": "הגילוי דפני הוי' אלקיך בביהמ\"ק הי' נעשה ע\"י ענין ההשתחוואה,"
        },
        {
          "s": 25,
          "text": "כמ\"ש לראות ולהשתחוות כו'."
        },
        {
          "s": 26,
          "text": "ובענין ההשתחוואה יש ב' בחינות49."
        },
        {
          "s": 27,
          "text": "השתחוואה חיצונית שהיא כדמיון השתחוואת העבד אל האדון שהיא בדרך כפי' והכרח,"
        },
        {
          "s": 28,
          "text": "שיכול להיות שאין רצונו לזה כלל,"
        },
        {
          "s": 29,
          "text": "אלא שמשתחווה מצד יראת האדון,"
        },
        {
          "s": 30,
          "text": "באופן של קבלת עול."
        },
        {
          "s": 31,
          "text": "והשתחוואה פנימית שהיא בבחי' חפץ ורצון,"
        },
        {
          "s": 32,
          "text": "ובאופן שכל כחותיו מתבטלים כו'."
        },
        {
          "s": 33,
          "text": "וב' הבחי' שבענין ההשתחוואה הם ע\"ד ב' הבחי' דשמיעה וראי',"
        },
        {
          "s": 34,
          "text": "דהיינו,"
        },
        {
          "s": 35,
          "text": "שכאשר העבודה היא בחי' שמיעה בלבד,"
        },
        {
          "s": 36,
          "text": "הרי זה פועל השתחוואה חיצונית בלבד,"
        },
        {
          "s": 37,
          "text": "אך כאשר העבודה היא בבחי' ראי',"
        },
        {
          "s": 38,
          "text": "הרי זה פועל השתחוואה פנימית."
        },
        {
          "s": 39,
          "text": "וכמו\"כ יש בתפלה ב' ענינים אלו,"
        },
        {
          "s": 40,
          "text": "דהנה,"
        },
        {
          "s": 41,
          "text": "התפלה היא סולם מוצב ארצה גו'50,"
        },
        {
          "s": 42,
          "text": "והיינו,"
        },
        {
          "s": 43,
          "text": "שהתחלת התפלה היא באופן דאחרי הוי' אלקיכם תלכו51,"
        },
        {
          "s": 44,
          "text": "אחרי הוי' היינו למטה מהוי',"
        },
        {
          "s": 45,
          "text": "ובבחי' אחוריים וחיצוניות בלבד,"
        },
        {
          "s": 46,
          "text": "שזוהי העבודה באופן של קבלת עול."
        },
        {
          "s": 47,
          "text": "אך גמר ותכלית העבודה היא להיות אחזה פניך,"
        },
        {
          "s": 48,
          "text": "בבחי' פנימיות,"
        },
        {
          "s": 49,
          "text": "לפני הוי',"
        },
        {
          "s": 50,
          "text": "דהיינו למעלה מהוי'."
        },
        {
          "s": 51,
          "text": "וב' ענינים הנ\"ל שבתפלה שכללותם קבלת עול והשגה,"
        },
        {
          "s": 52,
          "text": "באים ע\"י ב' אופני העבודה בענין הצדקה,"
        },
        {
          "s": 53,
          "text": "הנותן פרוטה לעני והמפייסו."
        }
      ]
    }
  ]
}