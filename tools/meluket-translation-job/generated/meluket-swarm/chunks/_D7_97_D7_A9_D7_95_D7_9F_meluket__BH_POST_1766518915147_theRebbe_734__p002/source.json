{
  "globalIndex": 230,
  "owner": 30,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915147_theRebbe_734__p002",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915147_theRebbe_734__p002",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518915147_theRebbe_734",
  "title": "מאמר ויתן לך תשכ\"ח",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה הברכה שברך יצחק ויתן לך האלקים היא ברכה נעלית יותר מהברכה דויברך אלקים את יצחק בנו."
        },
        {
          "s": 2,
          "text": "שהרי הברכה שנתברך יצחק מאלקים היתה נמשכת לבניו גם אם לא הי' מברכם,"
        },
        {
          "s": 3,
          "text": "וכפירוש רש\"י עה\"פ10"
        },
        {
          "s": 4,
          "text": "ויברך אלקים את יצחק בנו,"
        },
        {
          "s": 5,
          "text": "שאברהם נתיירא לברך את יצחק מפני שצפה את עשו יוצא ממנו,"
        },
        {
          "s": 6,
          "text": "אמר יבוא בעל הברכות ויברך את אשר ייטב בעיניו ובא הקב\"ה וברכו."
        },
        {
          "s": 7,
          "text": "דמזה מובן,"
        },
        {
          "s": 8,
          "text": "דכמו שבאם הי' אברהם מברך את יצחק,"
        },
        {
          "s": 9,
          "text": "היתה נמשכת הברכה גם לעשו גם אם לא הי' מברכו,"
        },
        {
          "s": 10,
          "text": "כמו\"כ הוא גם בנוגע להברכה שברך אלקים את יצחק,"
        },
        {
          "s": 11,
          "text": "דברכה זו נמשכה מעצמה לשני בניו,"
        },
        {
          "s": 12,
          "text": "גם לעשו."
        },
        {
          "s": 13,
          "text": "והברכה שברך יצחק ויתן לך האלקים מטל השמים וגו' היא ברכה נעלית יותר."
        },
        {
          "s": 14,
          "text": "וזהו גם מה שיעקב השתדל ביותר ועשה כמה ענינים שלא כדרכו11"
        },
        {
          "s": 15,
          "text": "בכדי לקבל הברכות,"
        },
        {
          "s": 16,
          "text": "אף שהברכה דויברך אלקים את יצחק היתה נמשכת אליו מעצמה,"
        },
        {
          "s": 17,
          "text": "כי הברכה ויתן לך האלקים מטל השמים וגו' היא נעלית יותר מהברכה דויברך אלקים את יצחק."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים המבואר בתו\"א פרשתנו12"
        },
        {
          "s": 2,
          "text": "ובכמה דרושים13,"
        },
        {
          "s": 3,
          "text": "דזה שרצה יצחק לברך את עשו אף שידע שאין שם שמים שגור בפיו14,"
        },
        {
          "s": 4,
          "text": "כי יצחק ראה שבעשו יש ניצוצות דקדושה גבוהים מאד,"
        },
        {
          "s": 5,
          "text": "ולכן רצה לברכו,"
        },
        {
          "s": 6,
          "text": "להמשיך עליו אור עליון,"
        },
        {
          "s": 7,
          "text": "שעי\"ז יתבררו הניצוצות שבו."
        },
        {
          "s": 8,
          "text": "אלא,"
        },
        {
          "s": 9,
          "text": "שבאם הי' נמשך אור זה על עשו"
        },
        {
          "s": 10,
          "text": "(שלא ע\"י יעקב)"
        },
        {
          "s": 11,
          "text": "הי' באחד משני פנים,"
        },
        {
          "s": 12,
          "text": "או שהי' נבלע בו או שהיתה מתבטלת מציאותו."
        },
        {
          "s": 13,
          "text": "ובכדי שיהי' הבירור דעשו הוא ע\"י יעקב דוקא."
        },
        {
          "s": 14,
          "text": "ולכן סיבב הקב\"ה שיצחק יברך את יעקב והמשכת אורות העליונים"
        },
        {
          "s": 15,
          "text": "(טל השמים ומשמני הארץ)"
        },
        {
          "s": 16,
          "text": "תהי' ליעקב,"
        },
        {
          "s": 17,
          "text": "שעי\"ז יברר את הניצוצות שבעשו."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ולהבין מהי הבחינה דאורות העליונים שעל ידם מתבררים הניצוצות,"
        },
        {
          "s": 2,
          "text": "יובן זה מהמבואר בתו\"א שם ובדרושים הנ\"ל15,"
        },
        {
          "s": 3,
          "text": "שהקליפות הם במספר י\"א."
        },
        {
          "s": 4,
          "text": "דבקדושה הוא מספר עשר,"
        },
        {
          "s": 5,
          "text": "עשר ולא תשע עשר ולא אחד עשר16,"
        },
        {
          "s": 6,
          "text": "משא\"כ בסט\"א יש י\"א כתרין דמסאבותא17."
        },
        {
          "s": 7,
          "text": "וזהו גם שבקטורת היו י\"א סממנים,"
        },
        {
          "s": 8,
          "text": "בכדי לברר את הי\"א כתרין דמסאבותא."
        },
        {
          "s": 9,
          "text": "וזה שהסט\"א היא במספר י\"א,"
        },
        {
          "s": 10,
          "text": "הוא,"
        },
        {
          "s": 11,
          "text": "כי מונים גם את החיות שמחי' אותם."
        },
        {
          "s": 12,
          "text": "דבקדושה החיות של הע\"ס"
        },
        {
          "s": 13,
          "text": "[ועד\"ז כל ענין שבקדושה,"
        },
        {
          "s": 14,
          "text": "שכל ענין הוא במספר עשר18]"
        },
        {
          "s": 15,
          "text": "נמשך בפנימיותם ומתאחד עמהם,"
        },
        {
          "s": 16,
          "text": "ולכן אינו נמנה בפני עצמו."
        },
        {
          "s": 17,
          "text": "משא\"כ בסט\"א,"
        },
        {
          "s": 18,
          "text": "החיות שמחי' אותם מובדל מהם"
        },
        {
          "s": 19,
          "text": "[דאם הי' נמשך בתוכם בפנימיותם הי' מובלע בהם ולא הי' בחינת חיות],"
        },
        {
          "s": 20,
          "text": "ולכן הוא נחשב בפני עצמו."
        }
      ]
    }
  ]
}