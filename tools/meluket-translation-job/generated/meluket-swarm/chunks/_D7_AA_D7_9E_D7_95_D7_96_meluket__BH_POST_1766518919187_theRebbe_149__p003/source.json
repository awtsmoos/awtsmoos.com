{
  "globalIndex": 909,
  "owner": 9,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919187_theRebbe_149__p003",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919187_theRebbe_149__p003",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919187_theRebbe_149",
  "title": "מאמר וידבר זאת חוקת תשכ\"ט",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "וזהו שבכל המצוות ישנם שני הענינים דחוקים ומשפטים,"
        },
        {
          "s": 1,
          "text": "שמצד הרצון דמצוות – כל המצוות הם חוקים,"
        },
        {
          "s": 2,
          "text": "וקיומם צריך להיות בדרך קבלת עול,"
        },
        {
          "s": 3,
          "text": "חוקה חקקתי גזירה גזרתי."
        },
        {
          "s": 4,
          "text": "ומצד הענין דטעמי המצוות – כל המצוות הם משפטים,"
        },
        {
          "s": 5,
          "text": "וקיומם צריך להיות"
        },
        {
          "s": 6,
          "text": "(גם)"
        },
        {
          "s": 7,
          "text": "מצד הטעם."
        },
        {
          "s": 8,
          "text": "וע\"י שמשה ידע הטעם דמצות פרה,"
        },
        {
          "s": 9,
          "text": "קיים גם מצוה זו מצד הטעם"
        },
        {
          "s": 10,
          "text": "[משא\"כ בכל אחד,"
        },
        {
          "s": 11,
          "text": "קיום מצות פרה אדומה מצד הטעם הוא27"
        },
        {
          "s": 12,
          "text": "זה שמתבונן שגם מצוה זו יש לה טעם]."
        },
        {
          "s": 13,
          "text": "ועפ\"ז יובן בפשטות שגם אצל משה לא הי' חסר ח\"ו קיום המצוות באופן דחוקה חקקתי גזירה גזרתי,"
        },
        {
          "s": 14,
          "text": "כי ענין זה שבקיום המצוות הוא מצד הרצון דמצוות."
        },
        {
          "s": 15,
          "text": "אבל ביאור זה צריך לביאור נוסף,"
        },
        {
          "s": 16,
          "text": "כי היתרון דמצות פרה אדומה לגבי כל המצוות הוא,"
        },
        {
          "s": 17,
          "text": "שבכל המצוות,"
        },
        {
          "s": 18,
          "text": "הטעם שבהם מעלים על הרצון,"
        },
        {
          "s": 19,
          "text": "ובמצות פרה אדומה שאין עלי' טעם"
        },
        {
          "s": 20,
          "text": "(בשכל האדם)"
        },
        {
          "s": 21,
          "text": "הרצון הוא בגילוי"
        },
        {
          "s": 22,
          "text": "[ופירוש זאת חוקת התורה הוא שכל מצוות התורה הם חוקה כמו פרה אדומה]."
        },
        {
          "s": 23,
          "text": "ומזה שנאמר ויקחו אליך,"
        },
        {
          "s": 24,
          "text": "דהפרה נקראת על שמו של משה,"
        },
        {
          "s": 25,
          "text": "משמע,"
        },
        {
          "s": 26,
          "text": "דענין המיוחד שבמצות פרה אדומה,"
        },
        {
          "s": 27,
          "text": "שהחוקה שבה"
        },
        {
          "s": 28,
          "text": "(רצון למעלה מטעם)"
        },
        {
          "s": 29,
          "text": "הוא בגילוי,"
        },
        {
          "s": 30,
          "text": "הוא גם לגבי משה,"
        },
        {
          "s": 31,
          "text": "ולכאורה,"
        },
        {
          "s": 32,
          "text": "כיון שמשה ידע טעם פרה,"
        },
        {
          "s": 33,
          "text": "מהו החילוק לגבי משה בין מצות פרה אדומה לכל המצוות."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים מ\"ש28"
        },
        {
          "s": 2,
          "text": "תפלה למשה."
        },
        {
          "s": 3,
          "text": "ואיתא בזהר29"
        },
        {
          "s": 4,
          "text": "שתפלה למשה היא תפלת עשיר30."
        },
        {
          "s": 5,
          "text": "ולהעיר ממ\"ש כ\"ק מו\"ח אדמו\"ר בעל הגאולה בשיחתו הידועה31"
        },
        {
          "s": 6,
          "text": "שהמזמור תפלה למשה שייך להגאולה די\"ט כסלו"
        },
        {
          "s": 7,
          "text": "[כידוע שאדמו\"ר הזקן הי' אומר בכל יום שיעור תהלים כמו שנחלק לימי החודש32,"
        },
        {
          "s": 8,
          "text": "וכיון שהמזמור תפלה למשה הוא התחלת שיעור תהלים החדשי דיום הי\"ט לחודש,"
        },
        {
          "s": 9,
          "text": "הרי אמר ביום גאולתו"
        },
        {
          "s": 10,
          "text": "(י\"ט כסלו)"
        },
        {
          "s": 11,
          "text": "מזמור זה],"
        },
        {
          "s": 12,
          "text": "דמזה מובן,"
        },
        {
          "s": 13,
          "text": "שמזמור זה שייך גם להגאולה די\"ב וי\"ג תמוז,"
        },
        {
          "s": 14,
          "text": "הגאולה דנשיא דורנו ממלא מקומו של בעל הגאולה די\"ט כסלו."
        },
        {
          "s": 15,
          "text": "[ובפרט בשנה זו33,"
        },
        {
          "s": 16,
          "text": "שבי\"ב תמוז,"
        },
        {
          "s": 17,
          "text": "יום ההולדת דבעל הגאולה,"
        },
        {
          "s": 18,
          "text": "הוא התחלת שנת הצדי\"ק דבעל הגאולה,"
        },
        {
          "s": 19,
          "text": "ובו מתחילים לומר מזמור צדי\"ק שבתהלים הוא המזמור תפלה למשה]."
        },
        {
          "s": 20,
          "text": "והנה ענינו ותוכנו דמזמור זה הוא תפלה למשה"
        },
        {
          "s": 21,
          "text": "[דהענינים הבאים בהמשך המזמור"
        },
        {
          "s": 22,
          "text": "(לאחרי התיבות תפלה למשה איש האלקים)"
        },
        {
          "s": 23,
          "text": "הם הענינים שמשה אמרם בתפלתו"
        },
        {
          "s": 24,
          "text": "(ענינים פרטיים),"
        },
        {
          "s": 25,
          "text": "אבל ענינו הכללי דהמזמור"
        },
        {
          "s": 26,
          "text": "[שהוא גם שמו דהמזמור]"
        },
        {
          "s": 27,
          "text": "הוא תפלה למשה],"
        },
        {
          "s": 28,
          "text": "דתפלה למשה היא תפלת עשיר"
        },
        {
          "s": 29,
          "text": "(כנ\"ל)."
        },
        {
          "s": 30,
          "text": "ומזה מובן,"
        },
        {
          "s": 31,
          "text": "שהשייכות דהמזמור להגאולה די\"ט כסלו ודי\"ב תמוז היא בעיקר מצד ענינו דכללות המזמור – תפלה למשה,"
        },
        {
          "s": 32,
          "text": "תפלת עשיר,"
        },
        {
          "s": 33,
          "text": "כדלקמן סעיף יג."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים הדיוק דאדמו\"ר"
        },
        {
          "s": 2,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 3,
          "text": "נ\"ע במאמרו ד\"ה תפלה למשה34,"
        },
        {
          "s": 4,
          "text": "הרי ענין התפלה הוא שמתפלל להקב\"ה שימלא את מחסורו35,"
        },
        {
          "s": 5,
          "text": "וכיון שהעשיר אינו חסר שום דבר,"
        },
        {
          "s": 6,
          "text": "מהו\"ע תפלת עשיר."
        },
        {
          "s": 7,
          "text": "ויש לומר,"
        },
        {
          "s": 8,
          "text": "שדיוק זה הוא"
        },
        {
          "s": 9,
          "text": "(בעיקר)"
        },
        {
          "s": 10,
          "text": "בנוגע לתפלת משה."
        },
        {
          "s": 11,
          "text": "דבעשיר בכלל יש לומר שהתפלה שלו היא שהקב\"ה ימלא את מחסורו הרוחני."
        },
        {
          "s": 12,
          "text": "משא\"כ במשה שגם בהיותו למטה האיר בו בגילוי המקור שלו כמו שהוא באצילות,"
        },
        {
          "s": 13,
          "text": "ועד שאין מחיצה והפסק ביניהם,"
        },
        {
          "s": 14,
          "text": "משה משה לא פסיק טעמא36,"
        },
        {
          "s": 15,
          "text": "הרי מובן,"
        },
        {
          "s": 16,
          "text": "דזה שמשה הי' עשיר בגשמיות הוא לפי שהי' עשיר ברוחניות,"
        },
        {
          "s": 17,
          "text": "היינו שגם ברוחניות לא הי' חסר שום דבר,"
        },
        {
          "s": 18,
          "text": "גם לא חסרון שבדוגמת סוס לרכוב עליו ועבד לרוץ לפניו,"
        },
        {
          "s": 19,
          "text": "ולכן מדייק בהמאמר מהו\"ע תפלת עשיר."
        }
      ]
    }
  ]
}