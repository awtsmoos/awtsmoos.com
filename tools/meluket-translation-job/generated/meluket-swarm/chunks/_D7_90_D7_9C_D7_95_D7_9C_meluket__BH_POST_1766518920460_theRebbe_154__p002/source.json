{
  "globalIndex": 1115,
  "owner": 15,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920460_theRebbe_154__p002",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920460_theRebbe_154__p002",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920460_theRebbe_154",
  "title": "מאמר אתם נצבים תשל\"ט",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "וזהו מה שממשיך בכתוב17"
        },
        {
          "s": 2,
          "text": "לעברך בברית"
        },
        {
          "s": 3,
          "text": "[שלעברך בברית הוא ביאור על מ\"ש לפנ\"ז אתם נצבים היום כולכם גו',"
        },
        {
          "s": 4,
          "text": "וכדאיתא בלקו\"ת18"
        },
        {
          "s": 5,
          "text": "שבזה מבאר איך הוא דרך היחוד ומהו ענין התשובה ולמה דוקא בראש השנה],"
        },
        {
          "s": 6,
          "text": "וכמבואר בלקו\"ת18"
        },
        {
          "s": 7,
          "text": "שהוא כמו שני אוהבים שכורתים ברית ביניהם שהם מתקשרים זה עם זה כאילו נעשו לבשר אחד."
        },
        {
          "s": 8,
          "text": "דזהו מה שאופן הכריתת ברית הוא כמ\"ש19"
        },
        {
          "s": 9,
          "text": "אשר כרתו את העגל ויעברו בין בתריו,"
        },
        {
          "s": 10,
          "text": "היינו דמה ששניהם עוברים בתוך גוף אחד מורה20"
        },
        {
          "s": 11,
          "text": "על שנעשו לבשר אחד."
        },
        {
          "s": 12,
          "text": "ומדייק בלקו\"ת שנעשו לבשר אחד,"
        },
        {
          "s": 13,
          "text": "וכן שניהם עוברים בתוך גוף אחד,"
        },
        {
          "s": 14,
          "text": "כי היחוד דהקב\"ה עם בני ישראל הוא גם מצד הגוף הגשמי,"
        },
        {
          "s": 15,
          "text": "ואדרבה,"
        },
        {
          "s": 16,
          "text": "מצד הכוונה דדירה בתחתונים הדירה לעצמותו ומהותו היא דוקא בתחתונים."
        },
        {
          "s": 17,
          "text": "וכמ\"ש21"
        },
        {
          "s": 18,
          "text": "באתי לגני וארז\"ל22"
        },
        {
          "s": 19,
          "text": "לגנוני כו' דעיקר שכינה בתחתונים היתה,"
        },
        {
          "s": 20,
          "text": "דדוקא בתחתונים היא בחינת גני וגנוני,"
        },
        {
          "s": 21,
          "text": "שענין הגן מורה על התענוג והשעשוע שלו כביכול,"
        },
        {
          "s": 22,
          "text": "ותענוג ושעשועים זה הוא בתחתונים דוקא."
        },
        {
          "s": 23,
          "text": "והענין הוא,"
        },
        {
          "s": 24,
          "text": "דהנה מבואר באגה\"ק ד\"ה איהו וחיוהי חד איהו וגרמוהי חד23"
        },
        {
          "s": 25,
          "text": "שהתהוות היש הנברא הוא בכח העצמות שמציאותו הוא מעצמותו ואינו עלול מאיזה עילה שקדמה לו ח\"ו,"
        },
        {
          "s": 26,
          "text": "שלכן גילוי העצמות הוא"
        },
        {
          "s": 27,
          "text": "(לא בחיוהי וגם לא בגרמוהי כי אם)"
        },
        {
          "s": 28,
          "text": "דוקא בהיש הנברא."
        },
        {
          "s": 29,
          "text": "וכמבואר בביאוה\"ז24"
        },
        {
          "s": 30,
          "text": "שאמיתית מציאותו של היש הנברא"
        },
        {
          "s": 31,
          "text": "(מה שנראה ליש)"
        },
        {
          "s": 32,
          "text": "הוא יש האמיתי."
        },
        {
          "s": 33,
          "text": "ולכן הכריתת ברית וההתקשרות דהקב\"ה עם ישראל הוא בעיקר בהגוף דישראל,"
        },
        {
          "s": 34,
          "text": "וכמבואר בשיחה הידועה25"
        },
        {
          "s": 35,
          "text": "השייכות דעצמות לגוף הגשמי דוקא."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "וזהו אמרו לפני מלכיות שתמליכוני עליכם26,"
        },
        {
          "s": 1,
          "text": "שעצמותו ית' בעט זיך כביכול ביי אַלע אידן און ביי יעדער אידן,"
        },
        {
          "s": 2,
          "text": "שתמליכוני עליכם."
        },
        {
          "s": 3,
          "text": "דהגם אשר נמלך בנשמותיהן של צדיקים27,"
        },
        {
          "s": 4,
          "text": "שעלה לפניו ית' התענוג שיתענג כביכול בעבודת הנשמות28,"
        },
        {
          "s": 5,
          "text": "ותענוג זה הי' עוד לפני הבריאה כתורת הרב המגיד בלקוטי אמרים ובאור תורה בתחלתם ובראשיתם29,"
        },
        {
          "s": 6,
          "text": "אעפ\"כ הוא מבקש שתמליכוני עליכם,"
        },
        {
          "s": 7,
          "text": "כי נמלך הוא בנשמותיהן של צדיקים,"
        },
        {
          "s": 8,
          "text": "ותכלית הכוונה היא העבודה דנשמות בגופים,"
        },
        {
          "s": 9,
          "text": "שעי\"ז נעשה תמליכוני עליכם,"
        },
        {
          "s": 10,
          "text": "לעורר30"
        },
        {
          "s": 11,
          "text": "התגלות פנימיות מלכותו ית' מעצמותו ומהותו."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וזהו לעברך בברית גו',"
        },
        {
          "s": 2,
          "text": "שבכל שנה קודם ר\"ה צ\"ל כריתת ברית מחדש על קבלת התורה שהוא בדוגמת הברית שהי' לפני הכניסה לארץ ישראל בפעם הראשונה,"
        },
        {
          "s": 3,
          "text": "מלבד הברית אשר כרת אתם בחורב31,"
        },
        {
          "s": 4,
          "text": "כי בעת הברית אשר כרת אתם בחורב היו ישראל צדיקים,"
        },
        {
          "s": 5,
          "text": "ולאחרי הירידה"
        },
        {
          "s": 6,
          "text": "(שע\"י החטא),"
        },
        {
          "s": 7,
          "text": "הוצרך להיות לעברך בברית הוי' אלקיך,"
        },
        {
          "s": 8,
          "text": "בחינת תשובה32."
        },
        {
          "s": 9,
          "text": "וברית זה"
        },
        {
          "s": 10,
          "text": "(דלעברך בברית)"
        },
        {
          "s": 11,
          "text": "שבא לאחרי הירידה כנ\"ל,"
        },
        {
          "s": 12,
          "text": "ירידה צורך עלי',"
        },
        {
          "s": 13,
          "text": "הוא נעלה יותר מהברית אשר כרת אתם בחורב,"
        },
        {
          "s": 14,
          "text": "כי \"לעברך בברית\" הוא33"
        },
        {
          "s": 15,
          "text": "מה שכורתי הברית עוברים בין הבתרים \"בתוך גוף אחד\" שהו\"ע ההתקשרות דהקב\"ה עם ישראל שנעשו חד ממש,"
        },
        {
          "s": 16,
          "text": "ועד שגם הגוף דישראל הוא מתייחד עם עצמותו ית'"
        },
        {
          "s": 17,
          "text": "(כנ\"ל),"
        },
        {
          "s": 18,
          "text": "שמצד התקשרות זו נעשה בקשו פני את פניך הוי' אבקש34"
        },
        {
          "s": 19,
          "text": "[ובאופן שפני"
        },
        {
          "s": 20,
          "text": "(דישראל)"
        },
        {
          "s": 21,
          "text": "ופניך הוי' נעשו אחד],"
        },
        {
          "s": 22,
          "text": "עבודת התשובה35"
        },
        {
          "s": 23,
          "text": "(שלמע' מעבודת הצדיקים)."
        },
        {
          "s": 24,
          "text": "דענין התשובה הוא למעלה ממדידה והגבלה,"
        },
        {
          "s": 25,
          "text": "למעלה מההגבלה דזמן שלכן תשובה היא בשעתא חדא וברגעא חדא36,"
        },
        {
          "s": 26,
          "text": "ולמעלה מההגבלה דמקום כולל גם ההגבלה דמקום רוחני שענין המקום ברוחניות הוא מעלה ומדריגה37,"
        },
        {
          "s": 27,
          "text": "שלכן אפילו כשהוא בדרגא הכי תחתונה"
        },
        {
          "s": 28,
          "text": "(מצד החטאים כו'),"
        },
        {
          "s": 29,
          "text": "מועלת תשובה."
        },
        {
          "s": 30,
          "text": "וזהו מה שממשיך בכתוב38"
        },
        {
          "s": 31,
          "text": "ושב ה' אלקיך את שבותך,"
        },
        {
          "s": 32,
          "text": "והשיב לא נאמר אלא ושב39,"
        },
        {
          "s": 33,
          "text": "כי מצד הכריתת ברית דהקב\"ה עם ישראל שנעשו חד ממש,"
        },
        {
          "s": 34,
          "text": "וגם מצד הגוף דישראל שהוא גוי קדוש ובתכלית הקדושה40,"
        },
        {
          "s": 35,
          "text": "הרי בכל מקום שישראל נמצא,"
        },
        {
          "s": 36,
          "text": "גם אם יהי' נדחך בקצה השמים41,"
        },
        {
          "s": 37,
          "text": "נמצא שם עצמותו ומהותו ית',"
        },
        {
          "s": 38,
          "text": "מכיון שהם חד ממש,"
        },
        {
          "s": 39,
          "text": "ולכן לא נאמר והשיב אלא ושב."
        }
      ]
    }
  ]
}