{
  "globalIndex": 399,
  "owner": 49,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518916037_theRebbe_540__p006",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518916037_theRebbe_540__p006",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518916037_theRebbe_540",
  "title": "מאמר וישב יעקב תשכ\"ז",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "וזהו מ\"ש פדה בשלום נפשי מקרב לי כי ברבים היו עמדי."
        },
        {
          "s": 3,
          "text": "דהנה73,"
        },
        {
          "s": 4,
          "text": "יש אופן של פדי' בשלום שאינה בדרך מלחמה כלל,"
        },
        {
          "s": 5,
          "text": "אלא בדרך מנוחה,"
        },
        {
          "s": 6,
          "text": "כפי שמצינו בשלמה שהי' איש מנוחה74,"
        },
        {
          "s": 7,
          "text": "והניצוצות באו אליו בדרך ממילא,"
        },
        {
          "s": 8,
          "text": "וכמו מלכת שבא שהביאה אליו את הניצוצות כו'75,"
        },
        {
          "s": 9,
          "text": "ומ\"מ,"
        },
        {
          "s": 10,
          "text": "כאשר מלכת שבא חזרה למקומה נשארה כמקודם ולא נתבררה."
        },
        {
          "s": 11,
          "text": "משא\"כ בדוד,"
        },
        {
          "s": 12,
          "text": "שאצלו הי' הבירור באופן של קרב,"
        },
        {
          "s": 13,
          "text": "באופן של מלחמה."
        },
        {
          "s": 14,
          "text": "ובפרטיות יותר,"
        },
        {
          "s": 15,
          "text": "יש במלחמה גופא ב' דרגות."
        },
        {
          "s": 16,
          "text": "יש מלחמה שהיא מרחוק,"
        },
        {
          "s": 17,
          "text": "שאין רואים את האויב ואין יודעים מהנעשה אתו,"
        },
        {
          "s": 18,
          "text": "שאז אין יכולים לבררו."
        },
        {
          "s": 19,
          "text": "אבל יש מלחמה שהיא באופן של קרב שמורה על הקירוב,"
        },
        {
          "s": 20,
          "text": "שזהו מש\"נ בדוד מקרב לי."
        },
        {
          "s": 21,
          "text": "ועל זה אמר כי ברבים היו עמדי,"
        },
        {
          "s": 22,
          "text": "וכמ\"ש בירושלמי שגם אנשי אבשלום התפללו לנצחונו של דוד,"
        },
        {
          "s": 23,
          "text": "וכמ\"ש76"
        },
        {
          "s": 24,
          "text": "גם אויביו ישלים אתו,"
        },
        {
          "s": 25,
          "text": "שבתיבת ישלים יש ב' פירושים,"
        },
        {
          "s": 26,
          "text": "מלשון שלום,"
        },
        {
          "s": 27,
          "text": "וגם מלשון שלימות."
        },
        {
          "s": 28,
          "text": "וענין זה נעשה ע\"י העבודה בבחי' קרב,"
        },
        {
          "s": 29,
          "text": "מלחמה באופן של קירוב,"
        },
        {
          "s": 30,
          "text": "שעי\"ז פועלים שברבים היו עמדי,"
        },
        {
          "s": 31,
          "text": "דרבים הו\"ע רה\"ר,"
        },
        {
          "s": 32,
          "text": "וכמ\"ש77"
        },
        {
          "s": 33,
          "text": "נעשה לשון רבים,"
        },
        {
          "s": 34,
          "text": "וכמארז\"ל78"
        },
        {
          "s": 35,
          "text": "כתוב והרוצה לטעות וכו',"
        },
        {
          "s": 36,
          "text": "ומהרבים נעשה עמדי,"
        },
        {
          "s": 37,
          "text": "רשות היחיד דיחידו של עולם79."
        },
        {
          "s": 38,
          "text": "וזהו פדה בשלום נפשי מקרב לי גו',"
        },
        {
          "s": 39,
          "text": "שזוהי תפלת דוד,"
        },
        {
          "s": 40,
          "text": "בחי' המלכות,"
        },
        {
          "s": 41,
          "text": "כללות כנס\"י,"
        },
        {
          "s": 42,
          "text": "היינו,"
        },
        {
          "s": 43,
          "text": "שנותנים כח לכאו\"א מישראל שיוכל להיות אצלו הפדי' מקרב,"
        },
        {
          "s": 44,
          "text": "שע\"י הבירור בבחי' קרב נעשה הפיכת התחתון,"
        },
        {
          "s": 45,
          "text": "היינו,"
        },
        {
          "s": 46,
          "text": "שאין זה באופן שמתבטל ממציאותו,"
        },
        {
          "s": 47,
          "text": "אלא שמציאות התחתון גופא נהפך לאלקות,"
        },
        {
          "s": 48,
          "text": "וכמ\"ש80"
        },
        {
          "s": 49,
          "text": "בכל לבבך בשני יצריך,"
        },
        {
          "s": 50,
          "text": "שאין זה באופן שהרגו בתענית81,"
        },
        {
          "s": 51,
          "text": "אלא שגם הנה\"ב יהי' לו אהבה לאלקות."
        },
        {
          "s": 52,
          "text": "וכללות הענין בזה,"
        },
        {
          "s": 53,
          "text": "שהבירור באופן דקרב אינו כמו אור השמש שמאיר בבית ע\"י שפותחים את החלונות,"
        },
        {
          "s": 54,
          "text": "שאור השמש אינו מתערב ומתאחד בעניני הבית,"
        },
        {
          "s": 55,
          "text": "ולכן לאחר שנסתלק אור השמש נשאר הבית אפל,"
        },
        {
          "s": 56,
          "text": "ואין יודעים מהנעשה שם,"
        },
        {
          "s": 57,
          "text": "אלא הבירור באופן דקרב הוא ע\"ד שהנשמה מתלבשת בגוף שהיא מתאחדת עם הגוף,"
        },
        {
          "s": 58,
          "text": "שהרי קודם התלבשותה בגוף היתה הנשמה למעלה והשיגה שם מהות אלקות,"
        },
        {
          "s": 59,
          "text": "ובהתלבשותה בגוף השגתה באלקות היא בבחי' המציאות דאלקות בלבד,"
        },
        {
          "s": 60,
          "text": "והשגת המהות שלה הוא בענינים גשמיים,"
        },
        {
          "s": 61,
          "text": "שזהו מפני שהנשמה מתאחדת עם הגוף ונה\"ב,"
        },
        {
          "s": 62,
          "text": "והיינו,"
        },
        {
          "s": 63,
          "text": "שנה\"א מרגשת את נה\"ב."
        },
        {
          "s": 64,
          "text": "וכמו\"כ לאידך גיסא,"
        },
        {
          "s": 65,
          "text": "שנפש הבהמית עלי' נאמר82"
        },
        {
          "s": 66,
          "text": "רוח הבהמה היורדת למטה,"
        },
        {
          "s": 67,
          "text": "מרגשת את נפש האלקית,"
        },
        {
          "s": 68,
          "text": "ועי\"ז פועלת נה\"א על נה\"ב שיהי' אצלה השגת אלקות באופן שהשכל הטבעי משיג את האלקות,"
        },
        {
          "s": 69,
          "text": "והיינו,"
        },
        {
          "s": 70,
          "text": "לא רק באופן שהוא מקבל דבר שלמעלה הימנו,"
        },
        {
          "s": 71,
          "text": "אלא באופן שהשכל הטבעי דנה\"ב נעשה כמו שכל התורה."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "והנה ב' אופני בירור הנ\"ל ישנם בכל ג' הקוין דתורה עבודה וגמ\"ח,"
        },
        {
          "s": 1,
          "text": "אבל בכללות הרי זה ההפרש בין תורה לתפלה,"
        },
        {
          "s": 2,
          "text": "שתורה הוא בבחי' קרב,"
        },
        {
          "s": 3,
          "text": "שעי\"ז מתהפכת נה\"ב לאלקות,"
        },
        {
          "s": 4,
          "text": "משא\"כ תפלה,"
        },
        {
          "s": 5,
          "text": "שעז\"נ83"
        },
        {
          "s": 6,
          "text": "בחרבי ובקשתי,"
        },
        {
          "s": 7,
          "text": "שתרגומו בצלותי ובבעותי,"
        },
        {
          "s": 8,
          "text": "הו\"ע מלחמה סתם84."
        },
        {
          "s": 9,
          "text": "וכיון שע\"י התורה נעשה שלימות הבירור,"
        },
        {
          "s": 10,
          "text": "לכן בתורה לא נאמר וימת בהדר,"
        },
        {
          "s": 11,
          "text": "משא\"כ בדה\"י שזהו בבחי' מלכות,"
        },
        {
          "s": 12,
          "text": "שרגלי' יורדות כו'85,"
        },
        {
          "s": 13,
          "text": "במקום של היפך החיים,"
        },
        {
          "s": 14,
          "text": "לכן נאמר וימת,"
        },
        {
          "s": 15,
          "text": "כיון ששם לא נעשה ענין הבירור כו'."
        },
        {
          "s": 16,
          "text": "ואף שידוע שהבירורים הם בבחי' מלכות,"
        },
        {
          "s": 17,
          "text": "שעז\"נ86"
        },
        {
          "s": 18,
          "text": "ותקם גו' ותתן טרף לביתה,"
        },
        {
          "s": 19,
          "text": "שהו\"ע ירידת המלכות בבי\"ע לברר בירורים,"
        },
        {
          "s": 20,
          "text": "יש לתרץ זה בב' אופנים,"
        },
        {
          "s": 21,
          "text": "הא',"
        },
        {
          "s": 22,
          "text": "שע\"י המלכות נעשה רק בירור ראשון ולא בירור שני87,"
        },
        {
          "s": 23,
          "text": "והב',"
        },
        {
          "s": 24,
          "text": "שגם הבירורים שמבררת המלכות הם ג\"כ ע\"י שנמשך בה מבחי' היסוד כו'."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ב)"
        },
        {
          "s": 2,
          "text": "וזהו מ\"ש וישב יעקב בארץ מגורי אביו בארץ כנען,"
        },
        {
          "s": 3,
          "text": "דכנען הוא לשון סוחר,"
        },
        {
          "s": 4,
          "text": "שמפזר את ממונו בכדי להרויח,"
        },
        {
          "s": 5,
          "text": "והו\"ע עליית הנשמה שע\"י ירידתה למטה והתלבשותה בגוף ונה\"ב."
        },
        {
          "s": 6,
          "text": "והנה ידוע88"
        },
        {
          "s": 7,
          "text": "שירידת הנשמה למטה אינה בשביל עצמה,"
        },
        {
          "s": 8,
          "text": "כי הנשמה עצמה אינה צריכה תיקון,"
        },
        {
          "s": 9,
          "text": "וירידתה למטה היא בכדי לברר את הניצוצות דתהו שנפלו למטה בדברים הגשמיים."
        },
        {
          "s": 10,
          "text": "וע\"י שמבררת את הניצוצות,"
        },
        {
          "s": 11,
          "text": "מתעלית היא למעלה יותר מכמו שהיתה קודם ירידתה."
        },
        {
          "s": 12,
          "text": "וזהו מה שענין ישובי עשו ותולדותיו הוא הקדמה לוישב יעקב גו' בארץ כנען,"
        },
        {
          "s": 13,
          "text": "כי ישובי עשו הו\"ע ז' מלכין דתהו,"
        },
        {
          "s": 14,
          "text": "וכל ענין המסחר"
        },
        {
          "s": 15,
          "text": "(כנען)"
        },
        {
          "s": 16,
          "text": "של ירידת הנשמה למטה הוא מצד הניצוצות דתהו שנפלו בשבה\"כ,"
        },
        {
          "s": 17,
          "text": "שזוהי הסיבה לירידת הנשמה"
        },
        {
          "s": 18,
          "text": "(פיזור ממון),"
        },
        {
          "s": 19,
          "text": "וכנ\"ל שהנשמה לא ירדה בשביל עצמה רק בכדי לברר את הניצוצות,"
        },
        {
          "s": 20,
          "text": "וזוהי גם הסיבה להעלי' שנעשית ע\"י הירידה"
        },
        {
          "s": 21,
          "text": "(הריוח שע\"י הפיזור),"
        },
        {
          "s": 22,
          "text": "וכנ\"ל שעליית הנשמה היא ע\"י בירור הניצוצות דתהו."
        }
      ]
    }
  ]
}