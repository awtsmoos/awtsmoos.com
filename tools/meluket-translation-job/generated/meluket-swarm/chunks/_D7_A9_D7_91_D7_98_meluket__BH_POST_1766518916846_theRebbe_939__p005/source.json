{
  "globalIndex": 534,
  "owner": 34,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916846_theRebbe_939__p005",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916846_theRebbe_939__p005",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916846_theRebbe_939",
  "title": "מאמר באתי לגני תשל\"א",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה ידוע שכל ירידה היא לצורך עלי'."
        },
        {
          "s": 2,
          "text": "דירידת הנשמה למטה היא בכדי שעל ידי זה תתעלה הנשמה למדריגה נעלית יותר מכמו שהיתה קודם ירידתה למטה33,"
        },
        {
          "s": 3,
          "text": "ועד\"ז הוא בהירידה"
        },
        {
          "s": 4,
          "text": "(וההשתלשלות)"
        },
        {
          "s": 5,
          "text": "דהעולמות,"
        },
        {
          "s": 6,
          "text": "דזה שירדו ממדריגה למדריגה"
        },
        {
          "s": 7,
          "text": "(מעולם לעולם)"
        },
        {
          "s": 8,
          "text": "עד שנתהווה מהם עוה\"ז התחתון,"
        },
        {
          "s": 9,
          "text": "הוא בשביל העלי' שנעשית עי\"ז34"
        },
        {
          "s": 10,
          "text": "[שעוה\"ז התחתון דוקא הוא דירה לו ית',"
        },
        {
          "s": 11,
          "text": "דירה להעצמות]."
        },
        {
          "s": 12,
          "text": "ומזה מובן,"
        },
        {
          "s": 13,
          "text": "שעד\"ז הוא בנוגע להירידה שבעוה\"ז עצמו,"
        },
        {
          "s": 14,
          "text": "שהירידה שנעשתה בו ע\"י חטא עה\"ד והענינים הבלתי רצויים שלאח\"ז היא צורך עלי',"
        },
        {
          "s": 15,
          "text": "בכדי שהמשכת עיקר שכינה למטה עכשיו"
        },
        {
          "s": 16,
          "text": "(לאחרי שנסתלקה)"
        },
        {
          "s": 17,
          "text": "תהי' נעלית יותר מהמשכת עיקר שכינה בתחתונים שהיתה בתחלת הבריאה."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ולכאורה הי' אפשר לומר,"
        },
        {
          "s": 1,
          "text": "דזה שירידה היא לצורך עלי' הוא כשהירידה היא ברצונו ית'"
        },
        {
          "s": 2,
          "text": "[שאז מוכרח לומר,"
        },
        {
          "s": 3,
          "text": "שהרצון בהירידה הוא בשביל העלי' שע\"י הירידה]."
        },
        {
          "s": 4,
          "text": "משא\"כ ירידה שע\"י חטא,"
        },
        {
          "s": 5,
          "text": "שהוא היפך רצון העליון"
        },
        {
          "s": 6,
          "text": "[דע\"י כח הבחירה שניתן להאדם ביכלתו לבחור היפך הרצון והכוונה שבשבילם נברא],"
        },
        {
          "s": 7,
          "text": "אין הכרח לכאורה שגם ירידה זו היא לצורך עלי'."
        },
        {
          "s": 8,
          "text": "והגם שאין שייך שבחירת האדם תעכב שלא תושלם ח\"ו הכוונה דדירה בתחתונים35,"
        },
        {
          "s": 9,
          "text": "ובחירת האדם קובעת רק את מהירות השלמת הכוונה36,"
        },
        {
          "s": 10,
          "text": "דמזה מוכח,"
        },
        {
          "s": 11,
          "text": "שהסילוק דעיקר שכינה שע\"י חטא עה\"ד והחטאים שלאחריו הי'"
        },
        {
          "s": 12,
          "text": "(מלכתחילה)"
        },
        {
          "s": 13,
          "text": "רק לפי שעה,"
        },
        {
          "s": 14,
          "text": "הרי ענין זה הוא רק הוכחה דזה שע\"י החטאים נסתלקה עיקר שכינה הי' זה"
        },
        {
          "s": 15,
          "text": "(מלכתחילה)"
        },
        {
          "s": 16,
          "text": "רק לפי שעה,"
        },
        {
          "s": 17,
          "text": "ובהכרח שאח\"כ תהי' המשכת עיקר שכינה למטה."
        },
        {
          "s": 18,
          "text": "אבל,"
        },
        {
          "s": 19,
          "text": "מהי ההוכחה שההמשכה למטה לאחרי הסילוק היא נעלית יותר מההמשכה שהיתה בתחלת הבריאה."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "והענין הוא,"
        },
        {
          "s": 1,
          "text": "דאיתא במדרש37"
        },
        {
          "s": 2,
          "text": "עה\"פ38"
        },
        {
          "s": 3,
          "text": "נורא עלילה על בני אדם,"
        },
        {
          "s": 4,
          "text": "עלילה נתלה בו"
        },
        {
          "s": 5,
          "text": "(באדם הראשון)"
        },
        {
          "s": 6,
          "text": "שהוא הביא את המיתה לעולם"
        },
        {
          "s": 7,
          "text": "(כי ביום אכלך ממנו מות תמות39),"
        },
        {
          "s": 8,
          "text": "שהרי התורה קדמה אלפים שנה לעולם וכתיב בה40"
        },
        {
          "s": 9,
          "text": "זאת התורה אדם כי ימות באוהל."
        },
        {
          "s": 10,
          "text": "ומבאר אדמו\"ר האמצעי41,"
        },
        {
          "s": 11,
          "text": "דזה שעלילה נתלה בו"
        },
        {
          "s": 12,
          "text": "(באדה\"ר)"
        },
        {
          "s": 13,
          "text": "הוא לא רק בנוגע להמיתה שבאה ע\"י חטא עה\"ד אלא גם בנוגע להחטא עצמו."
        },
        {
          "s": 14,
          "text": "כי זה שלפעמים גובר הרע דיצה\"ר על האדם,"
        },
        {
          "s": 15,
          "text": "הוא לפי שמלמעלה הסיתו עליו היצה\"ר להביאו לחטא זה."
        },
        {
          "s": 16,
          "text": "[אלא שהעזר מלמעלה להרע שבאדם להתגבר על הטוב שבו,"
        },
        {
          "s": 17,
          "text": "וכן העזר מלמעלה להטוב שבאדם להתגבר על הרע שבו,"
        },
        {
          "s": 18,
          "text": "הוא מובדל מהאדם ואינו נרגש בו,"
        },
        {
          "s": 19,
          "text": "ולכן אינו מכריח את האדם,"
        },
        {
          "s": 20,
          "text": "וזה שהאדם בוחר בטוב או ברע הוא בחירה חפשית]."
        },
        {
          "s": 21,
          "text": "וכיון שהירידה דעולם"
        },
        {
          "s": 22,
          "text": "(סילוק עיקר שכינה)"
        },
        {
          "s": 23,
          "text": "שבאה ע\"י חטא עה\"ד"
        },
        {
          "s": 24,
          "text": "(אף שהחטא הוא היפך הרצון)"
        },
        {
          "s": 25,
          "text": "היתה בכוונה,"
        },
        {
          "s": 26,
          "text": "בהכרח לומר,"
        },
        {
          "s": 27,
          "text": "שהכוונה דהירידה היא צורך עלי',"
        },
        {
          "s": 28,
          "text": "בכדי שהמשכת עיקר שכינה לאחרי שנסתלקה תהי' נעלית יותר מכמו שהיתה בתחלת הבריאה."
        }
      ]
    }
  ]
}