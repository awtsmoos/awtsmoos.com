{
  "globalIndex": 286,
  "owner": 36,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915410_theRebbe_669__p006",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915410_theRebbe_669__p006",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915410_theRebbe_669",
  "title": "מאמר פדה בשלום תשמ\"ו",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "והנה הגילוי שיהי' בתחיית המתים הוא"
        },
        {
          "s": 1,
          "text": "(כמבואר בכ\"מ51,"
        },
        {
          "s": 2,
          "text": "וגם במאמר הנ\"ל),"
        },
        {
          "s": 3,
          "text": "שאז תתגלה המשכת העצמות שע\"י קיום המצוות בעולם הזה."
        },
        {
          "s": 4,
          "text": "והוא ע\"ד שנתבאר לעיל"
        },
        {
          "s": 5,
          "text": "(סעיף ז)"
        },
        {
          "s": 6,
          "text": "בענין ההילולא שבהסתלקות הצדיקים שעסקו בפנימיות התורה,"
        },
        {
          "s": 7,
          "text": "שהוא גילוי הפנימיות והבלי גבול דהתומ\"צ שעסקו בעוה\"ז."
        },
        {
          "s": 8,
          "text": "אלא שעכשיו,"
        },
        {
          "s": 9,
          "text": "בכדי לקבל את הגילוי הוא ע\"י הסתלקות הנשמה מהגוף,"
        },
        {
          "s": 10,
          "text": "ולע\"ל יהי' גילוי זה גם בגוף הגשמי"
        },
        {
          "s": 11,
          "text": "(וגם הגילוי עצמו יהי' נעלה יותר,"
        },
        {
          "s": 12,
          "text": "שאז יהי' גילוי העצמות,"
        },
        {
          "s": 13,
          "text": "כנ\"ל)."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דמהטעמים שהענין דהילולא הג' מבואר בהדרוש ד\"ה להבין ענין הילולא דרשב\"י,"
        },
        {
          "s": 2,
          "text": "הוא,"
        },
        {
          "s": 3,
          "text": "לרמז,"
        },
        {
          "s": 4,
          "text": "שמעלת הצדיקים שעיקר עסקם הוא לגלות פנימיות התורה הוא בשני ענינים."
        },
        {
          "s": 5,
          "text": "שיום ההסתלקות שלהם נק' בשם יום הילולא,"
        },
        {
          "s": 6,
          "text": "לפי שאז מתגלה הפנימיות והבל\"ג בהתומ\"צ,"
        },
        {
          "s": 7,
          "text": "כנ\"ל בארוכה."
        },
        {
          "s": 8,
          "text": "וגם,"
        },
        {
          "s": 9,
          "text": "שע\"י עבודתם לגלות פנימיות התורה,"
        },
        {
          "s": 10,
          "text": "מתגלה"
        },
        {
          "s": 11,
          "text": "[אצלם,"
        },
        {
          "s": 12,
          "text": "ועל ידם מתגלה קצת גם לכל השייכים אליהם]"
        },
        {
          "s": 13,
          "text": "הבל\"ג דתומ\"צ גם בהנשמה כמו שהיא מלובשת בגוף הגשמי,"
        },
        {
          "s": 14,
          "text": "וגם בגוף הגשמי עצמו,"
        },
        {
          "s": 15,
          "text": "ע\"ד שיהי' בתחה\"מ."
        },
        {
          "s": 16,
          "text": "ויש להוסיף,"
        },
        {
          "s": 17,
          "text": "שהגילוי דשני הענינים,"
        },
        {
          "s": 18,
          "text": "גם ענין ההילולא דהסתלקות,"
        },
        {
          "s": 19,
          "text": "הוא בהנשמה כמו שמלובשת בגוף."
        },
        {
          "s": 20,
          "text": "אלא שבתחלה,"
        },
        {
          "s": 21,
          "text": "גילוי הבל\"ג להאדם הוא ע\"י שהוא בתנועה דביטול,"
        },
        {
          "s": 22,
          "text": "שיוצא ממציאותו – ע\"ד ענין ההסתלקות,"
        },
        {
          "s": 23,
          "text": "ועי\"ז,"
        },
        {
          "s": 24,
          "text": "מתגלה אח\"כ הבל\"ג גם בהמציאות דהאדם – ע\"ד הגילוי שיהי' בתחה\"מ."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "והנה מהנ\"ל מובן,"
        },
        {
          "s": 2,
          "text": "דבההילוך הנ\"ל"
        },
        {
          "s": 3,
          "text": "(עלי' בבחינת א\"ס ובלי גבול)"
        },
        {
          "s": 4,
          "text": "שנעשה על ידי קיום התומ\"צ בעולם הזה,"
        },
        {
          "s": 5,
          "text": "ג' מדריגות."
        },
        {
          "s": 6,
          "text": "דבהנשמות שעוסקים רק בנגלה דתורה,"
        },
        {
          "s": 7,
          "text": "ההילוך הוא בהעלם."
        },
        {
          "s": 8,
          "text": "כי מצד בחינת החיצוניות"
        },
        {
          "s": 9,
          "text": "(נגלה דתורה),"
        },
        {
          "s": 10,
          "text": "התומ\"צ הם במדידה והגבלה."
        },
        {
          "s": 11,
          "text": "וגילוי הבלי גבול שנמשך ע\"י קיום התומ\"צ בעוה\"ז יהי' בעיקר לע\"ל."
        },
        {
          "s": 12,
          "text": "ובהנשמות שעוסקים בפנימיות התורה,"
        },
        {
          "s": 13,
          "text": "גילוי הבלי גבול דהתומ\"צ"
        },
        {
          "s": 14,
          "text": "(ענין ההילוך)"
        },
        {
          "s": 15,
          "text": "הוא גם בעת הסתלקותם,"
        },
        {
          "s": 16,
          "text": "ועד\"ז בהיותם למטה ע\"י תנועת הביטול והיציאה ממציאותם."
        },
        {
          "s": 17,
          "text": "ועי\"ז באים אח\"כ למדריגה נעלית יותר,"
        },
        {
          "s": 18,
          "text": "שגילוי הבלי גבול דהתומ\"צ הוא גם בהמציאות שלהם."
        }
      ]
    }
  ]
}