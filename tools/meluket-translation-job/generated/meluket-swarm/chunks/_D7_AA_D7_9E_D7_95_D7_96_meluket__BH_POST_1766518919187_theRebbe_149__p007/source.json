{
  "globalIndex": 913,
  "owner": 13,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919187_theRebbe_149__p007",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919187_theRebbe_149__p007",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919187_theRebbe_149",
  "title": "מאמר וידבר זאת חוקת תשכ\"ט",
  "part": 7,
  "sections": [
    {
      "v": 18,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "וצריך ביאור,"
        },
        {
          "s": 3,
          "text": "דהעילוי שנעשה בהגילויים דלמעלה ע\"י עבודת האדם הוא"
        },
        {
          "s": 4,
          "text": "(בעיקר66)"
        },
        {
          "s": 5,
          "text": "כשההמשכה והגילוי שלהם היא ע\"י עבודת האדם,"
        },
        {
          "s": 6,
          "text": "וכיון דזה שע\"י תפלת משה היתה ההמשכה והגילוי הוא רק בנוגע כנסת ישראל"
        },
        {
          "s": 7,
          "text": "(כנסת ישראל כפשוטו,"
        },
        {
          "s": 8,
          "text": "וגם ספירת המלכות),"
        },
        {
          "s": 9,
          "text": "אבל בנוגע למשה אין שייך לכאורה לומר שההמשכה והגילוי היתה ע\"י תפלתו,"
        },
        {
          "s": 10,
          "text": "שהרי משה הוא עשיר,"
        },
        {
          "s": 11,
          "text": "דענין העשיר הוא שמאירים אצלו בגילוי כל הגילויים ואפילו הגילוי דעצמות אוא\"ס שלמעלה משייכות לעולמות,"
        },
        {
          "s": 12,
          "text": "ועפ\"ז,"
        },
        {
          "s": 13,
          "text": "העלי' וההוספה שנעשית בהאור ע\"י תפלת משה היא לכאורה רק לגבי אחרים ולא לגבי משה עצמו."
        },
        {
          "s": 14,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 15,
          "text": "דכיון שמשה הוא רוען של ישראל,"
        },
        {
          "s": 16,
          "text": "לכן,"
        },
        {
          "s": 17,
          "text": "כשחסר איזה ענין בכנסת ישראל,"
        },
        {
          "s": 18,
          "text": "הוא כמו שחסר הענין גם אצלו,"
        },
        {
          "s": 19,
          "text": "דנוסף לזה שהצער שלו על זה שחסר לישראל הי' צער גדול ביותר כאילו שהוא עצמו הי' החסר,"
        },
        {
          "s": 20,
          "text": "הנה גם החסרון דישראל הי' החסרון שלו67."
        },
        {
          "s": 21,
          "text": "כי משה וישראל הם חד,"
        },
        {
          "s": 22,
          "text": "ובלשון רש\"י68"
        },
        {
          "s": 23,
          "text": "שמשה הוא ישראל וישראל הם משה."
        },
        {
          "s": 24,
          "text": "ולכן,"
        },
        {
          "s": 25,
          "text": "הגם שמשה הי' עשיר והאירו בו כל הגילויים,"
        },
        {
          "s": 26,
          "text": "מ\"מ,"
        },
        {
          "s": 27,
          "text": "כיון שישראל היו חסרים הגילוי,"
        },
        {
          "s": 28,
          "text": "ורק ע\"י עבודה"
        },
        {
          "s": 29,
          "text": "(תפלתו של משה)"
        },
        {
          "s": 30,
          "text": "נתחדש הגילוי לגבם – גם לגבי משה נתחדש הגילוי ע\"י תפלתו."
        },
        {
          "s": 31,
          "text": "[ולהוסיף,"
        },
        {
          "s": 32,
          "text": "דזה שמשה הוא רוען של ישראל,"
        },
        {
          "s": 33,
          "text": "זהו ענינו העיקרי."
        },
        {
          "s": 34,
          "text": "וכל המעלות שלו,"
        },
        {
          "s": 35,
          "text": "כולל זה שהי' עשיר גם ברוחניות,"
        },
        {
          "s": 36,
          "text": "בחינת דעת עליון שמקבל מעתיק,"
        },
        {
          "s": 37,
          "text": "הם טפלים,"
        },
        {
          "s": 38,
          "text": "בחינת חיצוניות,"
        },
        {
          "s": 39,
          "text": "לגבי זה שהי' רוען של ישראל69."
        },
        {
          "s": 40,
          "text": "ועפ\"ז יובן יותר שגם לגבי משה נתחדש הגילוי ע\"י תפלה,"
        },
        {
          "s": 41,
          "text": "הגם שמצד העשירות שלו"
        },
        {
          "s": 42,
          "text": "(בחינת דעת עליון)"
        },
        {
          "s": 43,
          "text": "האירו אצלו גם לפנ\"ז כל הגילויים,"
        },
        {
          "s": 44,
          "text": "כי זה שהאירו אצלו כל הגילויים גם לפנ\"ז מצד העשירות שלו הוא בחינת החיצוניות שבו."
        },
        {
          "s": 45,
          "text": "אבל בנוגע להפנימיות שלו,"
        },
        {
          "s": 46,
          "text": "זה שהוא רוען של ישראל,"
        },
        {
          "s": 47,
          "text": "נתחדש הגילוי ע\"י תפלה]."
        },
        {
          "s": 48,
          "text": "ולכן העילוי שנעשה בהגילויים דלמעלה ע\"י שנמשכו ע\"י עבודה"
        },
        {
          "s": 49,
          "text": "(תפלה),"
        },
        {
          "s": 50,
          "text": "הוא גם בנוגע משה."
        }
      ]
    },
    {
      "v": 19,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ב)"
        },
        {
          "s": 2,
          "text": "וכמו כן הוא באתפשטותא דמשה שבכל דור,"
        },
        {
          "s": 3,
          "text": "עד לכ\"ק מו\"ח אדמו\"ר בעל הגאולה,"
        },
        {
          "s": 4,
          "text": "שענינו העיקרי והפנימי הוא זה שהוא רוען של ישראל,"
        },
        {
          "s": 5,
          "text": "והענינים דישראל הם ענינו דהנשיא."
        },
        {
          "s": 6,
          "text": "ועפ\"ז יש לבאר העילוי שנתחדש בהגאולה די\"ט כסלו ובהגאולה די\"ב תמוז ע\"י המאסר,"
        },
        {
          "s": 7,
          "text": "שהוא כיתרון האור מן החושך,"
        },
        {
          "s": 8,
          "text": "דלכאורה,"
        },
        {
          "s": 9,
          "text": "כיון שבנוגע להנשיאים לא שייך לומר שבהיותם במאסר הי' לגבם איזה ענין של חושך,"
        },
        {
          "s": 10,
          "text": "[וכמובן גם מהשיחה הידועה דבעל הגאולה70"
        },
        {
          "s": 11,
          "text": "בנוגע להמאסר של אדמו\"ר הזקן שהמאסר הי' בהסכמתו,"
        },
        {
          "s": 12,
          "text": "דמזה מובן,"
        },
        {
          "s": 13,
          "text": "שלגבם ההעלמות וההסתרים דהמאסר הם רק בחיצוניות],"
        },
        {
          "s": 14,
          "text": "איך נעשה עי\"ז יתרון האור."
        },
        {
          "s": 15,
          "text": "וי\"ל מהביאורים בזה,"
        },
        {
          "s": 16,
          "text": "דכיון שעיקר ענינם של הנשיאים הוא זה שהם רועי ישראל ונשיאי ישראל,"
        },
        {
          "s": 17,
          "text": "לכן,"
        },
        {
          "s": 18,
          "text": "ההעלם וההסתר דהמאסר שהי' בנוגע ישראל הוא העלם והסתר גם לגבי הנשיאים."
        },
        {
          "s": 19,
          "text": "ולכן,"
        },
        {
          "s": 20,
          "text": "בהגאולה מהמאסר,"
        },
        {
          "s": 21,
          "text": "כשהחושך נהפך לאור,"
        },
        {
          "s": 22,
          "text": "נעשה יתרון האור."
        }
      ]
    },
    {
      "v": 20,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ג)"
        },
        {
          "s": 2,
          "text": "והנה נתבאר לעיל"
        },
        {
          "s": 3,
          "text": "(סעיף ד)"
        },
        {
          "s": 4,
          "text": "שהשייכות דהגאולה די\"ט כסלו ודי\"ב תמוז להמזמור תפלה למשה הוא"
        },
        {
          "s": 5,
          "text": "(הן להענינים הפרטיים שנאמרו בהמזמור ומכש\"כ)"
        },
        {
          "s": 6,
          "text": "לענינו ותוכנו דכללות המזמור – תפלה למשה,"
        },
        {
          "s": 7,
          "text": "תפלת עשיר."
        },
        {
          "s": 8,
          "text": "וע\"פ המובא לעיל מהמאמר דענין העשירות הוא גילוי עצמות אוא\"ס שלמעלה מסובב"
        },
        {
          "s": 9,
          "text": "[והשייכות דתפלת עשיר"
        },
        {
          "s": 10,
          "text": "(מדינה פלונית כו' גזור שתיבנה)"
        },
        {
          "s": 11,
          "text": "לעשירות היא כי בכדי שבנין המלכות"
        },
        {
          "s": 12,
          "text": "(המדינה)"
        },
        {
          "s": 13,
          "text": "יהי' בבחינת בנין עדי עד הוא ע\"י שנמשך בה גילוי עצמות אוא\"ס],"
        },
        {
          "s": 14,
          "text": "יש לומר,"
        },
        {
          "s": 15,
          "text": "דיתרון האור שנעשה בהגאולה די\"ט כסלו ודי\"ב תמוז הוא המשכת גילוי עצמות אוא\"ס שלמעלה מממלא וסובב."
        }
      ]
    }
  ]
}