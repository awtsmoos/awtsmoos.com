{
  "globalIndex": 269,
  "owner": 19,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915336_theRebbe_861__p002",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915336_theRebbe_861__p002",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915336_theRebbe_861",
  "title": "מאמר פדה בשלום תשל\"ט",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ועד\"ז הוא לאידך,"
        },
        {
          "s": 1,
          "text": "שגם השלום שבפסוק זה הוא"
        },
        {
          "s": 2,
          "text": "(לא שלום סתם,"
        },
        {
          "s": 3,
          "text": "אלא)"
        },
        {
          "s": 4,
          "text": "תכלית השלימות שבשלום."
        },
        {
          "s": 5,
          "text": "וכמו שמבאר בעל הגאולה בהמאמר11"
        },
        {
          "s": 6,
          "text": "דאמיתית הענין דפדה בשלום נפשי הוא שאלו שהיו מקודם שונאים ומנגדים הם \"נעשים אוהבים גמורים\","
        },
        {
          "s": 7,
          "text": "דענין זה הוא למעלה גם מהשלום שהי' בימי שלמה12,"
        },
        {
          "s": 8,
          "text": "דהשלום שהי' בימי שלמה הוא שכולם נתבטלו מצד הגילוי אור"
        },
        {
          "s": 9,
          "text": "(אבל לא נהפכו לקדושה)13,"
        },
        {
          "s": 10,
          "text": "ואמיתית ענין השלום"
        },
        {
          "s": 11,
          "text": "(שגם המנגד נהפך לקדושה)"
        },
        {
          "s": 12,
          "text": "יהי' לע\"ל,"
        },
        {
          "s": 13,
          "text": "כמ\"ש14"
        },
        {
          "s": 14,
          "text": "אז אהפוך אל עמים שפה ברורה גו' לעבדו שכם אחד,"
        },
        {
          "s": 15,
          "text": "ועד\"ז בנוגע לבעלי חיים – וגר זאב עם כבש וגו'15,"
        },
        {
          "s": 16,
          "text": "ועד שגם הנחש"
        },
        {
          "s": 17,
          "text": "(פתן וצפעוני16)"
        },
        {
          "s": 18,
          "text": "יהפך לטוב,"
        },
        {
          "s": 19,
          "text": "כמ\"ש17"
        },
        {
          "s": 20,
          "text": "גם אויביו ישלים אתו זה הנחש,"
        },
        {
          "s": 21,
          "text": "וכמו שהי' בתחלת הבריאה"
        },
        {
          "s": 22,
          "text": "(לפני חטא עה\"ד)"
        },
        {
          "s": 23,
          "text": "שהי' שמש גדול18."
        },
        {
          "s": 24,
          "text": "ויתירה מזו יש לומר,"
        },
        {
          "s": 25,
          "text": "דכיון שכל ירידה היא צורך עלי',"
        },
        {
          "s": 26,
          "text": "בהכרח לומר,"
        },
        {
          "s": 27,
          "text": "שבירור ועליית הנחש לעתיד לבוא תהי' למעלה יותר גם מהדרגא ד\"שמש גדול\" שהי' לפני הירידה19."
        },
        {
          "s": 28,
          "text": "ועפ\"ז צריך להבין עוד יותר מ\"ש פדה בשלום גו' מקרב לי,"
        },
        {
          "s": 29,
          "text": "והרי הקרב והשלום שבפסוק זה הם שני הפכים מן הקצה אל הקצה,"
        },
        {
          "s": 30,
          "text": "ואיך זה פדה בשלום גו' מקרב לי."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים המבואר בהמאמר דבעל הגאולה20,"
        },
        {
          "s": 2,
          "text": "ששני הענינים דקרב ושלום ישנם בעבודת התפלה."
        },
        {
          "s": 3,
          "text": "ולהעיר,"
        },
        {
          "s": 4,
          "text": "דבכ\"מ21"
        },
        {
          "s": 5,
          "text": "מבואר שהבירור דתפלה הוא בדרך מלחמה,"
        },
        {
          "s": 6,
          "text": "שעת צלותא שעת קרבא22,"
        },
        {
          "s": 7,
          "text": "והבירור בדרך מנוחה"
        },
        {
          "s": 8,
          "text": "(שלום)"
        },
        {
          "s": 9,
          "text": "הוא ע\"י עסק התורה23."
        },
        {
          "s": 10,
          "text": "אבל בדרוש זה דבעל הגאולה מבואר,"
        },
        {
          "s": 11,
          "text": "שגם בעבודת התפלה ישנם שני הענינים."
        },
        {
          "s": 12,
          "text": "האהבה24"
        },
        {
          "s": 13,
          "text": "דבכל לבבך,"
        },
        {
          "s": 14,
          "text": "שמצד בחינת נר\"נ,"
        },
        {
          "s": 15,
          "text": "עם היות שגם ע\"י אהבה זו הוא פועל שגם נה\"ב יהי' לה אהבת ה',"
        },
        {
          "s": 16,
          "text": "בכל לבבך בשני יצריך25,"
        },
        {
          "s": 17,
          "text": "מ\"מ,"
        },
        {
          "s": 18,
          "text": "מכיון שהאהבה דבכל לבבך היא מצד ההבנה וההשגה"
        },
        {
          "s": 19,
          "text": "(שאלקות הוא טוב),"
        },
        {
          "s": 20,
          "text": "ומכיון ששכל הוא בחינת פנימי"
        },
        {
          "s": 21,
          "text": "(שמתלבש בהדבר שפועל בו),"
        },
        {
          "s": 22,
          "text": "הרי מובן דפעולת נה\"א בנה\"ב שתאהוב את הוי' הוא ע\"י שנה\"א מתלבשת בנה\"ב,"
        },
        {
          "s": 23,
          "text": "שההתבוננות של נה\"א צריכה להיות בענינים כאלו ובאופן שגם נה\"ב יכולה להשיג26,"
        },
        {
          "s": 24,
          "text": "הרי התלבשות זו"
        },
        {
          "s": 25,
          "text": "(שנה\"א מתלבשת בנה\"ב)"
        },
        {
          "s": 26,
          "text": "הו\"ע של מלחמה27."
        },
        {
          "s": 27,
          "text": "וגם האהבה דבכל נפשך,"
        },
        {
          "s": 28,
          "text": "שמצד בחינת חי',"
        },
        {
          "s": 29,
          "text": "הגם שחי' היא בחינת מקיף,"
        },
        {
          "s": 30,
          "text": "והבירור דנה\"ב שע\"י אהבה זו הוא"
        },
        {
          "s": 31,
          "text": "(לא בדרך התלבשות,"
        },
        {
          "s": 32,
          "text": "אלא)"
        },
        {
          "s": 33,
          "text": "שמצד תוקף הרצון דנה\"א"
        },
        {
          "s": 34,
          "text": "(רצון שלמעלה מטעם)"
        },
        {
          "s": 35,
          "text": "מתבטלים ממילא הרצונות דנה\"ב,"
        },
        {
          "s": 36,
          "text": "אעפ\"כ,"
        },
        {
          "s": 37,
          "text": "מכיון שביטול הרצונות דנה\"ב הוא רק מצד התגברות הרצון דנה\"א,"
        },
        {
          "s": 38,
          "text": "היינו שגם עכשיו יש לנה\"ב בהעלם רצונות זרים אלא שמצד התגברות הרצון דנה\"א אינם באים בפועל,"
        },
        {
          "s": 39,
          "text": "לכן נכלל זה בהעבודה דבירור שבדרך מלחמה."
        },
        {
          "s": 40,
          "text": "וענין פדה בשלום נפשי הוא בהאהבה דבכל מאדך,"
        },
        {
          "s": 41,
          "text": "שמצד בחינת יחידה."
        },
        {
          "s": 42,
          "text": "כי כיון שבחינת היחידה אין כנגדה לעומת זה,"
        },
        {
          "s": 43,
          "text": "בבואה דבבואה לית להו28,"
        },
        {
          "s": 44,
          "text": "לכן,"
        },
        {
          "s": 45,
          "text": "כשמתגלית בחינת היחידה,"
        },
        {
          "s": 46,
          "text": "מתבטל הלעו\"ז."
        },
        {
          "s": 47,
          "text": "דבחינת חי',"
        },
        {
          "s": 48,
          "text": "כיון שיש כנגדה לעו\"ז,"
        },
        {
          "s": 49,
          "text": "לכן הגילוי דבחינת חי' אינו שולל ומבטל הרצונות זרים דנה\"ב,"
        },
        {
          "s": 50,
          "text": "והוא רק בדרך התגברות,"
        },
        {
          "s": 51,
          "text": "שהרצון לאלקות"
        },
        {
          "s": 52,
          "text": "(שמבחינת חי')"
        },
        {
          "s": 53,
          "text": "מתגבר על הרצונות דנה\"ב,"
        },
        {
          "s": 54,
          "text": "ובכדי שיהי' ביטול הרצונות דנה\"ב הוא ע\"י גילוי היחידה."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ויש לקשר זה עם הידוע29"
        },
        {
          "s": 2,
          "text": "בענין כח המס\"נ שבכאו\"א מישראל"
        },
        {
          "s": 3,
          "text": "(דכח המס\"נ הוא מצד יחידה30),"
        },
        {
          "s": 4,
          "text": "דזה שהוא מוסר נפשו שלא להפרד ח\"ו מאחדותו ית' הוא לא מצד הרצון שלו"
        },
        {
          "s": 5,
          "text": "(היינו שאפשר להיות באופן אחר אלא שרוצה באופן זה),"
        },
        {
          "s": 6,
          "text": "אלא מפני שאינו יכול להפרד ח\"ו מאחדותו ית'."
        },
        {
          "s": 7,
          "text": "ועפ\"ז יש לבאר מה שמבואר בכ\"מ31"
        },
        {
          "s": 8,
          "text": "שהאהבה דבכל מאדך הו\"ע המס\"נ."
        },
        {
          "s": 9,
          "text": "דלכאורה אינו מובן,"
        },
        {
          "s": 10,
          "text": "והרי גם האהבה דבכל לבבך ובכל נפשך מחייבת לכאורה ענין המס\"נ,"
        },
        {
          "s": 11,
          "text": "דכשאוהב את הוי' בכל לבבו ועאכו\"כ כשאהבתו את הוי' היא בכל נפשו הרי בודאי ימסור נפשו עבורו32,"
        },
        {
          "s": 12,
          "text": "ומהו העילוי והחידוש בהאהבה דבכל מאדך."
        },
        {
          "s": 13,
          "text": "והביאור בזה,"
        },
        {
          "s": 14,
          "text": "שהמס\"נ שמצד האהבה דבכל לבבך ובכל נפשך היא באופן שרוצה למסור נפשו עבור הוי'"
        },
        {
          "s": 15,
          "text": "(באהבה דבכל לבבך,"
        },
        {
          "s": 16,
          "text": "נר\"נ – רצון שע\"פ טו\"ד,"
        },
        {
          "s": 17,
          "text": "ובאהבה דבכל נפשך,"
        },
        {
          "s": 18,
          "text": "חי' – רצון שלמעלה מטעם),"
        },
        {
          "s": 19,
          "text": "משא\"כ המס\"נ שמצד האהבה דבכל מאדך,"
        },
        {
          "s": 20,
          "text": "יחידה,"
        },
        {
          "s": 21,
          "text": "היא באופן שאינו יכול להיות נפרד ח\"ו."
        },
        {
          "s": 22,
          "text": "וזהו שענין המס\"נ הוא בהאהבה דבכל מאדך,"
        },
        {
          "s": 23,
          "text": "כי מס\"נ הו\"ע הביטול,"
        },
        {
          "s": 24,
          "text": "ואמיתית ענין הביטול הוא כשהמס\"נ היא לא מצד הרצון"
        },
        {
          "s": 25,
          "text": "(מציאות)"
        },
        {
          "s": 26,
          "text": "שלו אלא מצד האלקות."
        },
        {
          "s": 27,
          "text": "ויש לומר,"
        },
        {
          "s": 28,
          "text": "שזהו גם מהביאורים בזה שביטול הרצונות זרים דנה\"ב הוא דוקא בהאהבה דבכל מאדך,"
        },
        {
          "s": 29,
          "text": "כי האהבה דבכל לבבך ובכל נפשך,"
        },
        {
          "s": 30,
          "text": "מכיון שמצד אהבה זו יש אפשרות שלא למסור נפשו"
        },
        {
          "s": 31,
          "text": "(וזה שמוסר נפשו הוא רק מצד הרצון),"
        },
        {
          "s": 32,
          "text": "הרי זה מוכיח שנשאר עדיין מציאות הלעו\"ז."
        },
        {
          "s": 33,
          "text": "והביטול דלעו\"ז"
        },
        {
          "s": 34,
          "text": "(ביטול לגמרי)"
        },
        {
          "s": 35,
          "text": "הוא ע\"י האהבה דבכל מאדך,"
        },
        {
          "s": 36,
          "text": "שמצד אהבה זו אי אפשר להיות באופן אחר ח\"ו."
        }
      ]
    }
  ]
}