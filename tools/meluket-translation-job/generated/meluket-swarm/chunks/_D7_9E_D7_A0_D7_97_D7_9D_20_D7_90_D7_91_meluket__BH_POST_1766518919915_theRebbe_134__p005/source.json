  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919915_theRebbe_134__p005",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919915_theRebbe_134",
  "title": "מאמר ועתה ישראל תשכ\"ז",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ועד\"ז הוא גם בישראל עצמם,"
        },
        {
          "s": 1,
          "text": "דע\"י שהנשמה מאירה את הגוף,"
        },
        {
          "s": 2,
          "text": "שבו"
        },
        {
          "s": 3,
          "text": "(דוקא)"
        },
        {
          "s": 4,
          "text": "הוא בחירת העצמות53,"
        },
        {
          "s": 5,
          "text": "ניתוסף עילוי בהנשמה,"
        },
        {
          "s": 6,
          "text": "וע\"ד לע\"ל שהנשמה תהי' ניזונית מהגוף54."
        },
        {
          "s": 7,
          "text": "ויהי רצון שבקרוב ממש יקויים היעוד55"
        },
        {
          "s": 8,
          "text": "והקיצו ורננו שוכני עפר ובעל ההילולא בתוכם,"
        },
        {
          "s": 9,
          "text": "ונלך כולנו במהרה קוממיות לארצנו בביאת משיח צדקנו,"
        },
        {
          "s": 10,
          "text": "בעגלא דידן ממש."
        }
      ]
    }
  ]
}