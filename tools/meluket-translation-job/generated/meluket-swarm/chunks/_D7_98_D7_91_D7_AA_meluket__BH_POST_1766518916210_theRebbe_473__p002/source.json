{
  "globalIndex": 431,
  "owner": 31,
  "jobId": "_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916210_theRebbe_473__p002",
  "batchId": "meluket-_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916210_theRebbe_473__p002",
  "seriesId": "טבת_meluket",
  "postId": "BH_POST_1766518916210_theRebbe_473",
  "title": "מאמר יהודה אתה יודוך תשל\"ח",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "יהודה אתה יודוך אחיך וגו'1,"
        },
        {
          "s": 1,
          "text": "ומבאר כ\"ק אדמו\"ר הזקן בתו\"א ריש פרשתנו2,"
        },
        {
          "s": 2,
          "text": "שיהודה הוא על שם הפעם אודה את הוי'3"
        },
        {
          "s": 3,
          "text": "הוא בחי' הודי' שבכללות נשמות ישראל,"
        },
        {
          "s": 4,
          "text": "ובכדי שהודי' זו תהי' בהתגלות הוא ע\"י אחיך,"
        },
        {
          "s": 5,
          "text": "ראובן שמעון ולוי"
        },
        {
          "s": 6,
          "text": "[האחים של יהודה שנולדו לפניו]."
        },
        {
          "s": 7,
          "text": "וזהו יודוך אחיך,"
        },
        {
          "s": 8,
          "text": "שאחיך"
        },
        {
          "s": 9,
          "text": "[ראובן שמעון ולוי]"
        },
        {
          "s": 10,
          "text": "הם הגורמים ומביאים בחי' ההודי' דיהודה"
        },
        {
          "s": 11,
          "text": "(שתהי' בהתגלות)."
        },
        {
          "s": 12,
          "text": "ומבאר שם,"
        },
        {
          "s": 13,
          "text": "שראובן ושמעון הו\"ע ב' פרשיות דק\"ש ולוי הו\"ע אמת ויציב"
        },
        {
          "s": 14,
          "text": "(שלאחרי ק\"ש),"
        },
        {
          "s": 15,
          "text": "ועי\"ז באים אח\"כ לשמו\"ע,"
        },
        {
          "s": 16,
          "text": "בחי' ההודי' והביטול דבחי' יהודה."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והענין הוא"
        },
        {
          "s": 2,
          "text": "(כמבואר בתו\"א שם),"
        },
        {
          "s": 3,
          "text": "דהנה ראובן הוא על שם כי ראה גו'4,"
        },
        {
          "s": 4,
          "text": "שמעון על שם כי שמע גו'5."
        },
        {
          "s": 5,
          "text": "וענינם בעבודת ה'"
        },
        {
          "s": 6,
          "text": "(בכאו\"א מישראל),"
        },
        {
          "s": 7,
          "text": "בחי' ראובן הוא שעבודתו לקונו היא לא בבחי' השגה לבד כ\"א בבחי' ראי'."
        },
        {
          "s": 8,
          "text": "והיינו שההתאמתות שלו באלקות היא בוודאות הכי גדולה,"
        },
        {
          "s": 9,
          "text": "בדוגמת אדם שרואה איזה דבר שאין שייך שיהי' אצלו שום ספק בזה,"
        },
        {
          "s": 10,
          "text": "מכיון שהוא עצמו ראה את הדבר6."
        },
        {
          "s": 11,
          "text": "ועד\"ז הוא בעבודת ה',"
        },
        {
          "s": 12,
          "text": "שההתבוננות שלו"
        },
        {
          "s": 13,
          "text": "[ובפרט בענין דהשגחה פרטית7]"
        },
        {
          "s": 14,
          "text": "היא באופן"
        },
        {
          "s": 15,
          "text": "(דהסתכלות8)"
        },
        {
          "s": 16,
          "text": "שהענין מתאמת אצלו כאילו הוא רואה בראי' חושית ממש."
        },
        {
          "s": 17,
          "text": "ומראי' זו הוא בא לבחי' אהבת הוי',"
        },
        {
          "s": 18,
          "text": "וכמ\"ש4"
        },
        {
          "s": 19,
          "text": "(גבי קריאת שם ראובן)"
        },
        {
          "s": 20,
          "text": "כי ראה גו' כי עתה יאהבני."
        },
        {
          "s": 21,
          "text": "והו\"ע פרשה ראשונה דק\"ש,"
        },
        {
          "s": 22,
          "text": "ואהבת את הוי' אלקיך גו'9."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ובחי' שמעון"
        },
        {
          "s": 1,
          "text": "(על שם כי שמע גו')"
        },
        {
          "s": 2,
          "text": "הוא שהעבודה שלו היא בבחי' שמיעה והשגה לבד ולא בבחי' ראי'."
        },
        {
          "s": 3,
          "text": "ומכיון שאז הוא עדיין בבחי' ריחוק"
        },
        {
          "s": 4,
          "text": "[בדוגמת אדם השומע איזה דבר שמספרים לו,"
        },
        {
          "s": 5,
          "text": "אבל הוא עצמו לא ראה],"
        },
        {
          "s": 6,
          "text": "לכן אצלו העבודה בקו היראה."
        },
        {
          "s": 7,
          "text": "והו\"ע פרשה שני' דק\"ש,"
        },
        {
          "s": 8,
          "text": "והי' אם שמוע תשמעו גו' השמרו לכם פן יפתה גו'10."
        },
        {
          "s": 9,
          "text": "דמכיון שענין האלקות אצלו הוא רק בבחי' שמיעה"
        },
        {
          "s": 10,
          "text": "(אם שמוע תשמעו),"
        },
        {
          "s": 11,
          "text": "לכן צריכה להיות עבודתו בקו היראה"
        },
        {
          "s": 12,
          "text": "(השמרו לכם גו')."
        }
      ]
    }
  ]
}