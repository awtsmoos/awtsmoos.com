{
  "globalIndex": 97,
  "owner": 47,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914243_theRebbe_128__p003",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914243_theRebbe_128__p003",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914243_theRebbe_128",
  "title": "מאמר ולקחתם לכם תשל\"ט",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה כיון שתכלית בריאת האדם הוא לעשות לו ית' דירה בתחתונים39,"
        },
        {
          "s": 2,
          "text": "שזה נעשה ע\"י שעבודתו את ה' היא באופן כזה שגם גויים וכו' מכירים את מעלתו ועד שמברכים אותו,"
        },
        {
          "s": 3,
          "text": "מובן,"
        },
        {
          "s": 4,
          "text": "שלכאו\"א מישראל נותנים כח מלמעלה על זה."
        },
        {
          "s": 5,
          "text": "ובפרט בדורות האחרונים שלפני הגאולה,"
        },
        {
          "s": 6,
          "text": "שצריך לגמור ולהשלים עשיית הדירה,"
        },
        {
          "s": 7,
          "text": "שהנתינת כח על זה היא עוד יותר."
        },
        {
          "s": 8,
          "text": "ויש לומר,"
        },
        {
          "s": 9,
          "text": "דזהו גם מהטעמים על זה שסיפר כ\"ק מו\"ח אדמו\"ר40,"
        },
        {
          "s": 10,
          "text": "שאדמו\"ר מהר\"ש"
        },
        {
          "s": 11,
          "text": "(בעל ההילולא)"
        },
        {
          "s": 12,
          "text": "הי' נוסע בכל יום מימי החול לטייל,"
        },
        {
          "s": 13,
          "text": "ופעם"
        },
        {
          "s": 14,
          "text": "(מצד סיבה)"
        },
        {
          "s": 15,
          "text": "נסע בדרך אחרת,"
        },
        {
          "s": 16,
          "text": "וכל האנשים מעמי הארץ שהיו שם,"
        },
        {
          "s": 17,
          "text": "כשראו אותו כרעו והשתחוו לפניו."
        },
        {
          "s": 18,
          "text": "וכששאלו אח\"כ את אדמו\"ר מהר\"ש עד\"ז,"
        },
        {
          "s": 19,
          "text": "ענה: אויף וועמען דען שטייט ברוך תהי' מכל העמים."
        },
        {
          "s": 20,
          "text": "דהטעם על זה שכ\"ק מו\"ח אדמו\"ר סיפר מאורע זה וצוה לפרסמו,"
        },
        {
          "s": 21,
          "text": "יש לומר שהוא בכדי להוסיף בהנתינת כח על זה לכאו\"א מישראל."
        },
        {
          "s": 22,
          "text": "דנוסף על הנתינת כח שע\"י המאורע עצמו,"
        },
        {
          "s": 23,
          "text": "דכיון שמאורע זה הי' אצל נשיא,"
        },
        {
          "s": 24,
          "text": "דהנשיא הוא הכל41,"
        },
        {
          "s": 25,
          "text": "הוא נתינת כח לכאו\"א מישראל42,"
        },
        {
          "s": 26,
          "text": "הנה עי\"ז שנתגלה ונתפרסם ע\"י נשיא,"
        },
        {
          "s": 27,
          "text": "ניתוסף עי\"ז עוד יותר בהנתינת כח."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "דהנתינת כח מלמעלה על עבודה זו היא"
        },
        {
          "s": 3,
          "text": "(בעיקר)"
        },
        {
          "s": 4,
          "text": "בחג הסוכות."
        },
        {
          "s": 5,
          "text": "דע\"י שבחג הסוכות יודעים כולם"
        },
        {
          "s": 6,
          "text": "(גם הגוים כו')"
        },
        {
          "s": 7,
          "text": "שישראל אינון ניצוחייא,"
        },
        {
          "s": 8,
          "text": "ונוסף שהם יודעים מזה הם מסכימים לזה ועד שהם מהללים כו' את הוי' על זה שגבר עלינו חסדו"
        },
        {
          "s": 9,
          "text": "(כנ\"ל סעיף ג),"
        },
        {
          "s": 10,
          "text": "הנה מזה נמשכת נתינת כח על העבודה דברוך תהי' מכל העמים במשך כל השנה."
        },
        {
          "s": 11,
          "text": "ויש להוסיף,"
        },
        {
          "s": 12,
          "text": "דענין נצחון"
        },
        {
          "s": 13,
          "text": "(ישראל אינון ניצוחייא)"
        },
        {
          "s": 14,
          "text": "הוא שמנצחים את המנגד."
        },
        {
          "s": 15,
          "text": "דמזה מובן,"
        },
        {
          "s": 16,
          "text": "דזה שגילוי הנצחון בחג הסוכות הוא באופן שגם הגוים כו' מהללים כו',"
        },
        {
          "s": 17,
          "text": "הוא,"
        },
        {
          "s": 18,
          "text": "שגם אלה שהיו תחלה מנגדים,"
        },
        {
          "s": 19,
          "text": "גם הם נהפכים לאוהבים,"
        },
        {
          "s": 20,
          "text": "ומהללים כו' את הוי' על זה שגבר עלינו חסדו."
        },
        {
          "s": 21,
          "text": "ולכן,"
        },
        {
          "s": 22,
          "text": "גם הנתינת כח שנמשכת מחג הסוכות על העבודה דברוך תהי' מכל העמים במשך כל השנה היא גם בנוגע לאלה שהיו מנגדים,"
        },
        {
          "s": 23,
          "text": "ברוך תהי' מכל העמים."
        },
        {
          "s": 24,
          "text": "ומזה הוראה לכאו\"א מישראל,"
        },
        {
          "s": 25,
          "text": "שגם כשישנם לפעמים כאלה שמונעים ומעכבים אותו מעבודתו,"
        },
        {
          "s": 26,
          "text": "אין זה צריך לגרום חלישות ח\"ו בעבודתו"
        },
        {
          "s": 27,
          "text": "(ומכ\"ש שאין מקום למחשבת יאוש ח\"ו),"
        },
        {
          "s": 28,
          "text": "וכשמחליט למלאות את שליחותו מבלי להתחשב עם שום מניעות ועיכובים,"
        },
        {
          "s": 29,
          "text": "אזי יראה בגילוי בעיני בשר שכל המניעות אין בהם ממש43,"
        },
        {
          "s": 30,
          "text": "ואדרבא,"
        },
        {
          "s": 31,
          "text": "הכוונה בזה שיש לו מניעות הוא בכדי להגבי' אותו למדריגה נעלית יותר,"
        },
        {
          "s": 32,
          "text": "שתהי' לו העבודה דבירורים וגם העבודה דנסיונות"
        },
        {
          "s": 33,
          "text": "(שלולי המניעות לא הי' מגיע לעבודה זו,"
        },
        {
          "s": 34,
          "text": "שהרי מבקשים ונצטוינו לבקש אל תביאנו לידי נסיון44),"
        },
        {
          "s": 35,
          "text": "שעי\"ז יגיע למדריגה נעלית יותר45,"
        },
        {
          "s": 36,
          "text": "ועד שסוף סוף,"
        },
        {
          "s": 37,
          "text": "גם אלו שמנעו וכו' יהפכו למסייעים ומברכים,"
        },
        {
          "s": 38,
          "text": "ברוך תהי' מכל העמים,"
        },
        {
          "s": 39,
          "text": "ועי\"ז תושלם הכוונה דנתאווה הקב\"ה להיות לו ית' דירה בתחתונים,"
        },
        {
          "s": 40,
          "text": "בתחתון שאין תחתון למטה ממנו."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "והנה בכדי לפעול הבירור דאוה\"ע,"
        },
        {
          "s": 2,
          "text": "ובפרט דאלו שמנגדים,"
        },
        {
          "s": 3,
          "text": "הוא ע\"י התעוררות וגילוי בחינת יחידה שבנפש."
        },
        {
          "s": 4,
          "text": "דכיון שהניצוצות שבהם הם בתכלית ההעלם וההסתר,"
        },
        {
          "s": 5,
          "text": "לכן46,"
        },
        {
          "s": 6,
          "text": "בירור ניצוצות אלה הוא ע\"י התעוררות נקודת הנפש שלמעלה מהתפשטות וגילוי,"
        },
        {
          "s": 7,
          "text": "יחידה שבנפש."
        },
        {
          "s": 8,
          "text": "ובפשטות,"
        },
        {
          "s": 9,
          "text": "דע\"י שמעורר בחינת היחידה שבו הוא עומד בתוקף חזק,"
        },
        {
          "s": 10,
          "text": "שבכדי שיהי' לו תוקף חזק לעבוד עבודתו"
        },
        {
          "s": 11,
          "text": "(מבלי להתחשב עם המנגדים)"
        },
        {
          "s": 12,
          "text": "הוא ע\"י התעוררות היחידה שבו47,"
        },
        {
          "s": 13,
          "text": "וע\"י תוקף זה פועל סוף סוף גם על המנגדים שנהפכים למסייעים כו'"
        },
        {
          "s": 14,
          "text": "(כנ\"ל סעיף ו)."
        },
        {
          "s": 15,
          "text": "ואף שענין זה"
        },
        {
          "s": 16,
          "text": "(שהמנגדים נהפכים למסייעים כו')"
        },
        {
          "s": 17,
          "text": "הוא תוצאה"
        },
        {
          "s": 18,
          "text": "(לכאורה)"
        },
        {
          "s": 19,
          "text": "מגילוי היחידה שבו,"
        },
        {
          "s": 20,
          "text": "מ\"מ,"
        },
        {
          "s": 21,
          "text": "יש בזה עילוי לגבי הענין דגילוי היחידה."
        },
        {
          "s": 22,
          "text": "כי בגילוי היחידה לא נעשה דבר חדש,"
        },
        {
          "s": 23,
          "text": "משא\"כ זה שהמנגד נהפך למסייע"
        },
        {
          "s": 24,
          "text": "(היפך הטבע שלו)"
        },
        {
          "s": 25,
          "text": "הוא התחדשות48,"
        },
        {
          "s": 26,
          "text": "נוסף שעי\"ז דוקא נשלמת הכוונה דדירה בתחתונים,"
        },
        {
          "s": 27,
          "text": "בתחתון שאין תחתון למטה ממנו."
        }
      ]
    }
  ]
}