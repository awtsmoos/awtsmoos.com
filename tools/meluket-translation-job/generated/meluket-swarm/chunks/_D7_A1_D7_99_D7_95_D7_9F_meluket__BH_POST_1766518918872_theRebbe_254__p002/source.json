{
  "globalIndex": 860,
  "owner": 10,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918872_theRebbe_254__p002",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918872_theRebbe_254__p002",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918872_theRebbe_254",
  "title": "מאמר בהעלותך את הנרות תשכ\"ט",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ומבואר בהדרושים13,"
        },
        {
          "s": 1,
          "text": "דהטעם שהעלאת הנרות"
        },
        {
          "s": 2,
          "text": "[גילוי טבע הרצוא והעלי' דהנשמות]"
        },
        {
          "s": 3,
          "text": "הוא ע\"י אהרן דוקא,"
        },
        {
          "s": 4,
          "text": "כי באהרן כתיב14"
        },
        {
          "s": 5,
          "text": "כשמן הטוב על הראש יורד על הזקן זקן אהרן שיורד על פי מדותיו,"
        },
        {
          "s": 6,
          "text": "וענין זקן אהרן הוא הלכות התורה15,"
        },
        {
          "s": 7,
          "text": "וע\"י התורה,"
        },
        {
          "s": 8,
          "text": "תורה אור6,"
        },
        {
          "s": 9,
          "text": "מתגלה ומאיר טבע העלי' דהנשמה"
        },
        {
          "s": 10,
          "text": "(שישנו גם בירידתה למטה והתלבשותה בגוף),"
        },
        {
          "s": 11,
          "text": "בהעלותך את הנרות."
        },
        {
          "s": 12,
          "text": "ועפ\"ז יש לבאר השייכות דמארז\"ל"
        },
        {
          "s": 13,
          "text": "(המובא בהמאמר)"
        },
        {
          "s": 14,
          "text": "אם שמרת את נרי אני משמר את נרך לבהעלותך את הנרות,"
        },
        {
          "s": 15,
          "text": "כי ענין אני משמר את נרך"
        },
        {
          "s": 16,
          "text": "(שמירת הנר שלא תיכבה)"
        },
        {
          "s": 17,
          "text": "הוא שהנר דהנשמה"
        },
        {
          "s": 18,
          "text": "(טבע הרצוא והעלי' שלה)"
        },
        {
          "s": 19,
          "text": "יהי' בגילוי,"
        },
        {
          "s": 20,
          "text": "וזה ששמירת הנר דהנשמה הוא ע\"י שמירת הנר דתורה הוא ע\"ד הענין דבהעלותך את הנרות שע\"י אהרן,"
        },
        {
          "s": 21,
          "text": "תורה."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 2,
          "text": "דצריך להבין באם שמרת את נרי אני משמר את נרך,"
        },
        {
          "s": 3,
          "text": "מהי שייכותם זה לזה ועוד ועד שהם תלויים זה בזה."
        },
        {
          "s": 4,
          "text": "ומבאר זה ע\"פ מה דאיתא במדרש16"
        },
        {
          "s": 5,
          "text": "בזכות מי נבראו אלה תולדות השמים והארץ17"
        },
        {
          "s": 6,
          "text": "ובזכות מי הם עומדים,"
        },
        {
          "s": 7,
          "text": "בזכות אלה שמות בני ישראל18,"
        },
        {
          "s": 8,
          "text": "ואלה בזכות מי עומדים,"
        },
        {
          "s": 9,
          "text": "בזכות אלה העדות והחוקים והמשפטים19."
        },
        {
          "s": 10,
          "text": "שהכוונה דבריאת העולם היא בשביל ישראל,"
        },
        {
          "s": 11,
          "text": "והשלימות דישראל היא ע\"י התורה."
        },
        {
          "s": 12,
          "text": "דע\"י שישראל מקיימים התרי\"ג מצוות הם מתעלים למדריגה נעלית יותר מכמו שהם מצד עצמם."
        },
        {
          "s": 13,
          "text": "וזהו מה שהנשמה יורדת למטה ומתלבשת בגוף גשמי בכדי לקיים תומ\"צ,"
        },
        {
          "s": 14,
          "text": "כי ע\"י קיום התומ\"צ מתעלית הנשמה למעלה יותר מכמו שהיתה קודם ירידתה."
        },
        {
          "s": 15,
          "text": "וזהו אם שמרת את נרי אני משמר את נרך,"
        },
        {
          "s": 16,
          "text": "ששמירת הנר דהנשמה היא ע\"י שמירת הנר דתורה."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "וע\"פ מש\"כ בהמאמר דענין אם שמרת את נרי אני משמר את נרך הוא שע\"י קיום התומ\"צ מתעלית הנשמה למעלה יותר מכמו שהיתה קודם ירידתה,"
        },
        {
          "s": 1,
          "text": "יש לומר,"
        },
        {
          "s": 2,
          "text": "דזה שמקשר ענין זה עם בהעלותך את הנרות,"
        },
        {
          "s": 3,
          "text": "הוא,"
        },
        {
          "s": 4,
          "text": "כי גם ענין בהעלותך את הנרות הוא20"
        },
        {
          "s": 5,
          "text": "העלי' שנעשה בהנשמות למעלה יותר גם מכמו שהיו קודם ירידתם למטה."
        }
      ]
    }
  ]
}