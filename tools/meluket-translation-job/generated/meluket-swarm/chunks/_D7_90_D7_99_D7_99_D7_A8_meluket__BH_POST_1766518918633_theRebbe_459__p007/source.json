{
  "globalIndex": 817,
  "owner": 17,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918633_theRebbe_459__p007",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918633_theRebbe_459__p007",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918633_theRebbe_459",
  "title": "מאמר בחודש השלישי תשכ\"ט",
  "part": 7,
  "sections": [
    {
      "v": 18,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "ויש לומר,"
        },
        {
          "s": 3,
          "text": "שזהו גם הקשר דביום הזה עם"
        },
        {
          "s": 4,
          "text": "(מדבר)"
        },
        {
          "s": 5,
          "text": "סיני,"
        },
        {
          "s": 6,
          "text": "שירדה שנאה לאומות העולם שלא קיבלו בו את התורה63."
        },
        {
          "s": 7,
          "text": "דכמו64"
        },
        {
          "s": 8,
          "text": "שישראל קיבלו התורה מפני שכפה הקב\"ה עליהם הר כגיגית39"
        },
        {
          "s": 9,
          "text": "התגלות האהבה לישראל65"
        },
        {
          "s": 10,
          "text": "– ואוהב את יעקב66,"
        },
        {
          "s": 11,
          "text": "כמו\"כ הוא בנוגע לאוה\"ע שלא קיבלו את התורה שזהו מפני שירדה שנאה לאוה\"ע – ואת עשו שנאתי66."
        },
        {
          "s": 12,
          "text": "וזה שואוהב את יעקב ואת עשו שנאתי הוא לא מפני המעלה דישראל,"
        },
        {
          "s": 13,
          "text": "כי זה גופא שהחזירה הקב\"ה"
        },
        {
          "s": 14,
          "text": "(לתורה)"
        },
        {
          "s": 15,
          "text": "על כל אומה ולשון67"
        },
        {
          "s": 16,
          "text": "מוכיח שנתינת התורה היא ממקום נעלה ביותר,"
        },
        {
          "s": 17,
          "text": "שכל המעלות,"
        },
        {
          "s": 18,
          "text": "כולל גם המעלה דבנים אתם לה' אלקיכם68,"
        },
        {
          "s": 19,
          "text": "אינם תופסים מקום שם,"
        },
        {
          "s": 20,
          "text": "ושניהם"
        },
        {
          "s": 21,
          "text": "(ישראל ואוה\"ע)"
        },
        {
          "s": 22,
          "text": "שוים – הלא אח עשו ליעקב66,"
        },
        {
          "s": 23,
          "text": "אלא שבבחירתו החפשית בחר להיות ואוהב את יעקב ואת עשו שנאתי."
        },
        {
          "s": 24,
          "text": "וזהו הקשר דביום הזה עם מדבר סיני,"
        },
        {
          "s": 25,
          "text": "דזה שירדה שנאה לאוה\"ע הוא לפי שכך בחר בבחירתו החפשית"
        },
        {
          "s": 26,
          "text": "(כנ\"ל),"
        },
        {
          "s": 27,
          "text": "ואמיתית ענין הבחירה הוא רק בהעצמות,"
        },
        {
          "s": 28,
          "text": "זה."
        },
        {
          "s": 29,
          "text": "ועד\"ז הוא גם בנוגע להענין דסיני שירדה שנאה ליצה\"ר"
        },
        {
          "s": 30,
          "text": "(שבישראל),"
        },
        {
          "s": 31,
          "text": "שעי\"ז ניתן הכח לברר המדות דנפש הבהמית,"
        },
        {
          "s": 32,
          "text": "שהוא ע\"י גילוי כח העצמות."
        },
        {
          "s": 33,
          "text": "דזה שנפש האלקית בטילה לאלקות,"
        },
        {
          "s": 34,
          "text": "כולל שגם ההתפשטות שלה"
        },
        {
          "s": 35,
          "text": "(האהבה)"
        },
        {
          "s": 36,
          "text": "היא בביטול,"
        },
        {
          "s": 37,
          "text": "אינו חידוש כ\"כ,"
        },
        {
          "s": 38,
          "text": "ועיקר הענין דגילוי כח העצמות,"
        },
        {
          "s": 39,
          "text": "יום הזה,"
        },
        {
          "s": 40,
          "text": "הוא בזה שבאו מדבר סיני,"
        },
        {
          "s": 41,
          "text": "בירור וזיכוך הגוף ונה\"ב."
        }
      ]
    },
    {
      "v": 19,
      "items": [
        {
          "s": 0,
          "text": "אלא שאעפ\"כ עיקר הביאור"
        },
        {
          "s": 1,
          "text": "(באריכות ובפרטיות)"
        },
        {
          "s": 2,
          "text": "בהדרוש שבתו\"א בהמעלה דר\"ח סיון הוא בענין הביטול דבחינת מדבר,"
        },
        {
          "s": 3,
          "text": "כי המעלה בזה שגם המציאות הוא בטל"
        },
        {
          "s": 4,
          "text": "[בירור המדות דנה\"ב,"
        },
        {
          "s": 5,
          "text": "ועד\"ז שהמציאות"
        },
        {
          "s": 6,
          "text": "(אהבה)"
        },
        {
          "s": 7,
          "text": "דנפש האלקית היא בביטול]"
        },
        {
          "s": 8,
          "text": "היא שעי\"ז מתגלה כח העצמות"
        },
        {
          "s": 9,
          "text": "(כנ\"ל),"
        },
        {
          "s": 10,
          "text": "אבל בכדי לעורר ולהמשיך הענין דמתן תורה"
        },
        {
          "s": 11,
          "text": "(המשכת העצמות)"
        },
        {
          "s": 12,
          "text": "הוא ע\"י הביטול הבא מעצם הנשמה,"
        },
        {
          "s": 13,
          "text": "דביטול זה מגיע בהעצמות."
        }
      ]
    },
    {
      "v": 20,
      "items": [
        {
          "s": 0,
          "text": "ויש לקשר זה עם שבר\"ח סיון היו כל ישראל כאיש אחד בלב אחד69,"
        },
        {
          "s": 1,
          "text": "ואמר הקב\"ה הרי השעה שאתן להם את תורתי70,"
        },
        {
          "s": 2,
          "text": "כי זה שהיו כאיש אחד בלב אחד הוא ע\"י הגילוי דשרש הנשמה שלמעלה מהנשמה המלובשת בגוף,"
        },
        {
          "s": 3,
          "text": "וכמבואר בתניא71"
        },
        {
          "s": 4,
          "text": "שכל ישראל הם אחים ממש הוא"
        },
        {
          "s": 5,
          "text": "(דוקא)"
        },
        {
          "s": 6,
          "text": "מצד שרש נפשם,"
        },
        {
          "s": 7,
          "text": "ולכן זה שהיו כאיש אחד72"
        },
        {
          "s": 8,
          "text": "הגיע בהעצמות ונתעורר אצלו כביכול הרצון ליתן להם את תורתו."
        }
      ]
    }
  ]
}