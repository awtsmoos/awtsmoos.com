{
  "globalIndex": 946,
  "owner": 46,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919340_theRebbe_24__p008",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919340_theRebbe_24__p008",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919340_theRebbe_24",
  "title": "מאמר עשרה שיושבין תשמ\"ב",
  "part": 8,
  "sections": [
    {
      "v": 21,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "והנה ידועה תורת הבעש\"ט63"
        },
        {
          "s": 3,
          "text": "דכל מה שאדם רואה או שומע הוא הוראה בעבודת השם."
        },
        {
          "s": 4,
          "text": "ומוסיף הרב המגיד64"
        },
        {
          "s": 5,
          "text": "שכל מה שרואה ושומע וכל מקרה שיקרה לאדם הוא בשביל עבודת ה'."
        },
        {
          "s": 6,
          "text": "והביאור בזה,"
        },
        {
          "s": 7,
          "text": "כי גם כל מקרה הוא בהשגחה פרטית,"
        },
        {
          "s": 8,
          "text": "וזה שנקרא בשם מקרה הוא שלמטה בעוה\"ז הוא באופן של מקרה."
        },
        {
          "s": 9,
          "text": "וע\"ד מ\"ש65"
        },
        {
          "s": 10,
          "text": "כי יקרא קן צפור לפניך וארז\"ל66"
        },
        {
          "s": 11,
          "text": "פרט למזומן,"
        },
        {
          "s": 12,
          "text": "דהגם שכל הענינים הם בהשגח\"פ,"
        },
        {
          "s": 13,
          "text": "ויתירה מזו שהם מזומנים ממחשבה הקדומה דא\"ק,"
        },
        {
          "s": 14,
          "text": "מ\"מ,"
        },
        {
          "s": 15,
          "text": "אומר הכתוב כי יקרא קן צפור פרט למזומן,"
        },
        {
          "s": 16,
          "text": "כי ישנם ענינים שהכוונה שבהם נשלמת ע\"י שגם למטה הם באופן דמזומן,"
        },
        {
          "s": 17,
          "text": "וישנם ענינים שהכוונה שבהם נשלמת ע\"י שלמטה הם באופן דמקרה,"
        },
        {
          "s": 18,
          "text": "כי יקרא."
        },
        {
          "s": 19,
          "text": "ומזה מובן במכש\"כ בנוגע להענינים שבתורה,"
        },
        {
          "s": 20,
          "text": "שכל הפרטים שבה,"
        },
        {
          "s": 21,
          "text": "גם כשנראים בחיצוניות שהם רק בדרך אגב"
        },
        {
          "s": 22,
          "text": "(ע\"ד מקרה),"
        },
        {
          "s": 23,
          "text": "הם הוראה67."
        }
      ]
    },
    {
      "v": 22,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 1,
          "text": "דזה שהמדה די\"ג המדות שבתורה שנמשכה מיגמה\"ר שבתפלה היא מדת קל וחומר הוא להורות,"
        },
        {
          "s": 2,
          "text": "דהגם שעיקר ההמשכה דיגמה\"ר הוא בתפלה ועי\"ז באה ההמשכה גם בתורה,"
        },
        {
          "s": 3,
          "text": "מ\"מ,"
        },
        {
          "s": 4,
          "text": "יש מעלה בההמשכה שבתורה לגבי ההמשכה שבתפלה,"
        },
        {
          "s": 5,
          "text": "ע\"ד מדת קל וחומר,"
        },
        {
          "s": 6,
          "text": "דהגם שהחמור למידין מהקל,"
        },
        {
          "s": 7,
          "text": "מ\"מ,"
        },
        {
          "s": 8,
          "text": "הוא חמור לגבי הקל."
        },
        {
          "s": 9,
          "text": "וכמו שמבאר בהמאמר68"
        },
        {
          "s": 10,
          "text": "דזה שלמידין ההמשכה שלא לפי ערך ההעלאה שע\"י תורה דרבים מההמשכה שע\"י תפלת רבים הוא לימוד באופן דמכש\"כ,"
        },
        {
          "s": 11,
          "text": "ק\"ו."
        }
      ]
    },
    {
      "v": 23,
      "items": [
        {
          "s": 0,
          "text": "והענין הוא,"
        },
        {
          "s": 1,
          "text": "דהחילוק בין תורה ותפלה הוא ע\"ד החילוק בין ברכה ותפלה55."
        },
        {
          "s": 2,
          "text": "דבתפלה,"
        },
        {
          "s": 3,
          "text": "המתפלל הוא למטה ומבקש שישפיעו לו מלמעלה,"
        },
        {
          "s": 4,
          "text": "ובברכה,"
        },
        {
          "s": 5,
          "text": "המברך"
        },
        {
          "s": 6,
          "text": "[זה שיש לו כח לברך,"
        },
        {
          "s": 7,
          "text": "כמו הכהנים שניתן להם כח לברך]"
        },
        {
          "s": 8,
          "text": "הוא למעלה מהמקור שממנו נמשכת הברכה ומצַוה שתהי' ההמשכה למטה."
        },
        {
          "s": 9,
          "text": "וכהלשון בברכת כהנים יברכך ה' וגו'69,"
        },
        {
          "s": 10,
          "text": "שהוא לשון ציווי."
        },
        {
          "s": 11,
          "text": "ועד\"ז הוא בהמשכת ההשפעות שע\"י תורה."
        },
        {
          "s": 12,
          "text": "דכיון שכתר תורה הוא הפקר לכל70,"
        },
        {
          "s": 13,
          "text": "הרי ביכלתו של כל אחד מישראל לזכות בה ע\"י עסק התורה באופן שהיא נעשית תורתו71"
        },
        {
          "s": 14,
          "text": "(דהלומד),"
        },
        {
          "s": 15,
          "text": "ונעשה בעל הבית כביכול על התורה ומכש\"כ על המשכת ההשפעות שע\"י התורה."
        }
      ]
    }
  ]
}