{
  "globalIndex": 425,
  "owner": 25,
  "jobId": "_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916188_theRebbe_169__p001",
  "batchId": "meluket-_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916188_theRebbe_169__p001",
  "seriesId": "טבת_meluket",
  "postId": "BH_POST_1766518916188_theRebbe_169",
  "title": "מאמר ויגש אליו יהודה תשל\"ו",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ ויגש ה'תשל\"ו*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "ויגש אליו יהודה גו'1,"
        },
        {
          "s": 1,
          "text": "ואיתא בזהר2"
        },
        {
          "s": 2,
          "text": "דהגשת יהודה ליוסף הוא ענין סמיכת גאולה לתפלה."
        },
        {
          "s": 3,
          "text": "ומבואר בדרושי רבותינו נשיאינו3,"
        },
        {
          "s": 4,
          "text": "דגאולה היא בחינת יסוד כמ\"ש4"
        },
        {
          "s": 5,
          "text": "אם יגאלך טוב יגאל וטוב הוא בחינת יסוד,"
        },
        {
          "s": 6,
          "text": "ותפלה היא בחינת מלכות."
        },
        {
          "s": 7,
          "text": "וזוהי השייכות דגאולה ותפלה ליוסף ויהודה,"
        },
        {
          "s": 8,
          "text": "כי יוסף בן שבע עשרה שנה5"
        },
        {
          "s": 9,
          "text": "בגימטריא טוב הוא יסוד,"
        },
        {
          "s": 10,
          "text": "ויהודה הוא מלכות."
        },
        {
          "s": 11,
          "text": "וידוע הדיוק בזה3,"
        },
        {
          "s": 12,
          "text": "דהגשת יהודה ליוסף הוא שיוסף הי' במקומו ויהודה נגש ליוסף,"
        },
        {
          "s": 13,
          "text": "וסמיכת גאולה לתפלה הוא שתפלה היא במקומה וגאולה נסמכת"
        },
        {
          "s": 14,
          "text": "(נגשת)"
        },
        {
          "s": 15,
          "text": "לתפלה."
        },
        {
          "s": 16,
          "text": "ויתירה מזו,"
        },
        {
          "s": 17,
          "text": "דבהגשת יהודה ליוסף מודגש שיוסף הי' נעלה יותר מיהודה שלכן הוצרך יהודה לגשת אליו,"
        },
        {
          "s": 18,
          "text": "ובסמיכת גאולה לתפלה העיקר הוא6"
        },
        {
          "s": 19,
          "text": "התפלה."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ונקודת הביאור בזה בהדרושים,"
        },
        {
          "s": 2,
          "text": "ע\"פ המבואר בתו\"א ד\"ה והנה אנחנו מאלמים אלומים7,"
        },
        {
          "s": 3,
          "text": "שהניצוצות שנתבררו ע\"י השבטים הוצרכו להתברר בירור שני ע\"י יוסף,"
        },
        {
          "s": 4,
          "text": "כי הבירור שע\"י השבטים הוא בירור בדרך מלמטה למעלה"
        },
        {
          "s": 5,
          "text": "(בירור דב\"ן),"
        },
        {
          "s": 6,
          "text": "דבירור זה הוא רק ביטול היש,"
        },
        {
          "s": 7,
          "text": "ולכן הוצרכו להתברר בירור שני ע\"י יוסף,"
        },
        {
          "s": 8,
          "text": "בירור בדרך מלמעלה למטה"
        },
        {
          "s": 9,
          "text": "(בירור דמ\"ה),"
        },
        {
          "s": 10,
          "text": "ועי\"ז הם"
        },
        {
          "s": 11,
          "text": "(הניצוצות)"
        },
        {
          "s": 12,
          "text": "נכללים באלקות."
        },
        {
          "s": 13,
          "text": "ומבואר בתו\"א שם8,"
        },
        {
          "s": 14,
          "text": "שבכדי שתהי' המשכה דשם מ\"ה,"
        },
        {
          "s": 15,
          "text": "הוא ע\"י העלאת מ\"ן דשם ב\"ן."
        },
        {
          "s": 16,
          "text": "וזהו מ\"ש9"
        },
        {
          "s": 17,
          "text": "ותשתחוינה לאלומתי,"
        },
        {
          "s": 18,
          "text": "העלת מ\"ן דהשבטים בבחי' ביטול"
        },
        {
          "s": 19,
          "text": "(השתחואה),"
        },
        {
          "s": 20,
          "text": "שעי\"ז עוררו המשכת שם מ\"ה להיות בירור שני."
        }
      ]
    }
  ]
}