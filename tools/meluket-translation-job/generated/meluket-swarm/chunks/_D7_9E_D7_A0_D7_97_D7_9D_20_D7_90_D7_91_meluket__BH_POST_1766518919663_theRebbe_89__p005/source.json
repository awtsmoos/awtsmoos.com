{
  "globalIndex": 992,
  "owner": 42,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919663_theRebbe_89__p005",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919663_theRebbe_89__p005",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919663_theRebbe_89",
  "title": "מאמר ציון במשפט תפדה תשל\"ה",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "וע\"י העבודה בכל ג' הקוין,"
        },
        {
          "s": 3,
          "text": "הנה בדורות הקודמים נעשה עי\"ז כאילו פדאני"
        },
        {
          "s": 4,
          "text": "(בכ\"ף הדמיון),"
        },
        {
          "s": 5,
          "text": "והוא ע\"ד המבואר באגה\"ק88"
        },
        {
          "s": 6,
          "text": "בענין גאולה הפרטית."
        },
        {
          "s": 7,
          "text": "משא\"כ עכשיו אשר הנה זה עומד אחר כתלנו וכידוע השיחה של בעל הגאולה"
        },
        {
          "s": 8,
          "text": "(די\"ב תמוז),"
        },
        {
          "s": 9,
          "text": "שכבר נגמרו כל הבירורים וצריך רק צופּוצן די קנעפּלאַך89,"
        },
        {
          "s": 10,
          "text": "הנה עכשיו,"
        },
        {
          "s": 11,
          "text": "ע\"י העסק בתורה ובגמ\"ח ותפלה עם הצבור יהי' פדאני כו' ממש,"
        },
        {
          "s": 12,
          "text": "ובאופן של פדה בשלום נפשי,"
        },
        {
          "s": 13,
          "text": "כי אמיתית הענין דפדי' בשלום תהי' בביאת המשיח דוקא,"
        },
        {
          "s": 14,
          "text": "כמו שמבאר כ\"ק אדמו\"ר האמצעי90."
        },
        {
          "s": 15,
          "text": "וזהו ג\"כ מה שכתב אדמו\"ר הזקן"
        },
        {
          "s": 16,
          "text": "(באגה\"ק שלו בבואו מפ\"ב91)"
        },
        {
          "s": 17,
          "text": "וכשקריתי בס' תהלים בפסוק פדה בשלום נפשי כו' יצאתי בשלום מה' שלום,"
        },
        {
          "s": 18,
          "text": "דהנה ידוע92"
        },
        {
          "s": 19,
          "text": "שעיקר הענין דיפוצו מעינותיך חוצה הותחל לאחרי פ\"ב."
        },
        {
          "s": 20,
          "text": "ולכן יצא בשלום כשקרא בפסוק פדה בשלום נפשי,"
        },
        {
          "s": 21,
          "text": "כי"
        },
        {
          "s": 22,
          "text": "(עיקר)"
        },
        {
          "s": 23,
          "text": "הענין דפדה בשלום הוא בגאולה העתידה"
        },
        {
          "s": 24,
          "text": "(כנ\"ל),"
        },
        {
          "s": 25,
          "text": "ויפוצו מעינותיך חוצה הוא ההכנה93"
        },
        {
          "s": 26,
          "text": "לזה,"
        },
        {
          "s": 27,
          "text": "לקא אתי מר."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ועי\"ז פתח וסלל את הדרך,"
        },
        {
          "s": 1,
          "text": "שכאו\"א יכול"
        },
        {
          "s": 2,
          "text": "(ולכן צריך הוא)"
        },
        {
          "s": 3,
          "text": "לעסוק בהכנה זו ולהביא את הגאולה ע\"י שיעשה את התלוי בו וכפסק הרמב\"ם94"
        },
        {
          "s": 4,
          "text": "שע\"י פעולה אחת"
        },
        {
          "s": 5,
          "text": "(הן במעשה,"
        },
        {
          "s": 6,
          "text": "הן בדיבור והן במחשבה)"
        },
        {
          "s": 7,
          "text": "מכריע את עצמו ואת כל העולם כולו לכף זכות וגורם לו ולהם תשועה והצלה,"
        },
        {
          "s": 8,
          "text": "שנעשה פדה בשלום נפשי,"
        },
        {
          "s": 9,
          "text": "פדאני לי ולבני מבין אוה\"ע,"
        },
        {
          "s": 10,
          "text": "בקרוב ממש ובעגלא דידן,"
        },
        {
          "s": 11,
          "text": "בגאולה האמיתית והשלימה ע\"י משיח צדקנו."
        }
      ]
    }
  ]
}