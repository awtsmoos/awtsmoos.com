{
  "globalIndex": 481,
  "owner": 31,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916512_theRebbe_860__p001",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916512_theRebbe_860__p001",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916512_theRebbe_860",
  "title": "מאמר היושבת בגנים תשי\"א",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ בשלח,"
        },
        {
          "s": 2,
          "text": "י\"ג שבט,"
        },
        {
          "s": 3,
          "text": "ה'תשי\"א*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "היושבת בגנים חברים מקשיבים לקולך1,"
        },
        {
          "s": 1,
          "text": "ומביא בזה כ\"ק מו\"ח אדמו\"ר"
        },
        {
          "s": 2,
          "text": "(במאמרו2"
        },
        {
          "s": 3,
          "text": "המשך למאמר דהסתלקות)"
        },
        {
          "s": 4,
          "text": "ב' פירושים דלכאורה הם הפכים."
        },
        {
          "s": 5,
          "text": "פי' א'3"
        },
        {
          "s": 6,
          "text": "דגנים היינו4"
        },
        {
          "s": 7,
          "text": "עוה\"ז ויושבת בגנים קאי על כנסת ישראל הנפוצה בגולה רועה בגנים של אחרים,"
        },
        {
          "s": 8,
          "text": "מ\"מ כשיושבת בבתי כנסיות ובתי מדרשות,"
        },
        {
          "s": 9,
          "text": "הנה חברים שהם מלאכי השרת,"
        },
        {
          "s": 10,
          "text": "שנקראים חברים מפני שאין בהם לא קנאה לא שנאה ולא תחרות,"
        },
        {
          "s": 11,
          "text": "מקשיבים לקולך."
        },
        {
          "s": 12,
          "text": "ופי' הב'5"
        },
        {
          "s": 13,
          "text": "הוא דגנים קאי על ג\"ע6."
        },
        {
          "s": 14,
          "text": "ואף שיש בזה כמה מדריגות לאין קץ אך בכללות נחלקים לב' מדרי' ג\"ע התחתון וג\"ע העליון7,"
        },
        {
          "s": 15,
          "text": "וחברים מקשיבים היינו הנשמות שבג\"ע שנק' חברים כמו שמבאר במאמר המוסגר8"
        },
        {
          "s": 16,
          "text": "דלפעמים נשמהא"
        },
        {
          "s": 17,
          "text": "מנשמה נאצלת כו'."
        },
        {
          "s": 18,
          "text": "ויש לומר הדיוק בזה,"
        },
        {
          "s": 19,
          "text": "דמשמיענו אשר שייכות הנשמות זל\"ז אין זה סתם שייכות אלא נשמה מנשמה נאצלת,"
        },
        {
          "s": 20,
          "text": "ופי' ענין אצי' נת\"ל"
        },
        {
          "s": 21,
          "text": "(בד\"ה באתי לגני9)"
        },
        {
          "s": 22,
          "text": "שהוא גילוי ההעלם,"
        },
        {
          "s": 23,
          "text": "היינו שהוא דבר אחד,"
        },
        {
          "s": 24,
          "text": "הוא הוא אותו הדבר עצמו אלא שירד ונתגלה מהעלמו."
        },
        {
          "s": 25,
          "text": "וכמו כחות הנעלמים שאח\"כ ירדו ונתגלו מהעלמם,"
        },
        {
          "s": 26,
          "text": "דלכן אי אפשר לומר שהכוונה בהבריאה הוא בשביל עולם האצילות,"
        },
        {
          "s": 27,
          "text": "דמאחר שהוא גילוי ההעלם זהו ירידה,"
        },
        {
          "s": 28,
          "text": "אלא התכלית הוא עוה\"ז התחתון."
        },
        {
          "s": 29,
          "text": "וכמו\"כ הוא בשייכות הנשמות הנ\"ל שהוא ענין אצי' וגילוי ההעלם."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ולהבין שייכות ב' הפירושים,"
        },
        {
          "s": 2,
          "text": "הנה מקודם לזה מבאר בהמאמר10"
        },
        {
          "s": 3,
          "text": "אשר כשהנשמה יורדת למטה ומתלבשת בגוף,"
        },
        {
          "s": 4,
          "text": "הנה אף שהגוף הוא מעלים ומסתיר,"
        },
        {
          "s": 5,
          "text": "מ\"מ ע\"י עבודה מסיר ההעלם והסתר,"
        },
        {
          "s": 6,
          "text": "ואדרבה ע\"י ירידה והתלבשות זו הוא מתחזק ביתרון כח."
        },
        {
          "s": 7,
          "text": "והנה דיוק הלשון ואדרבה,"
        },
        {
          "s": 8,
          "text": "הוא כמו שמבאר כ\"ק רבינו הזקן"
        },
        {
          "s": 9,
          "text": "(אגה\"ק סכ\"ה11)"
        },
        {
          "s": 10,
          "text": "דברי כ\"ק הבעש\"ט12"
        },
        {
          "s": 11,
          "text": "בענין הכעס,"
        },
        {
          "s": 12,
          "text": "כגון שעומד לנגדו ערלב"
        },
        {
          "s": 13,
          "text": "ומדבר ומבלבלו,"
        },
        {
          "s": 14,
          "text": "הנה לא זו בלבד שאינו מתפעל ממנו,"
        },
        {
          "s": 15,
          "text": "ומתפלל כמו שלא הי' מבלבל הערל,"
        },
        {
          "s": 16,
          "text": "אלא עוד יותר שפועל בו חיזוק ותוספות כח כשמתבונן ענין גלות השכינה שנתלבשה בבחי' גלות בתוך דבור זה המבלבל."
        },
        {
          "s": 17,
          "text": "נמצא שע\"י בלבול זה מתעורר האדם יותר."
        },
        {
          "s": 18,
          "text": "וכן מבאר ג\"כ כ\"ק אדמו\"ר האמצעי"
        },
        {
          "s": 19,
          "text": "(בתורה אור13"
        },
        {
          "s": 20,
          "text": "הענין הוא בקצרה אבל בתורת חיים פרשה זו14"
        },
        {
          "s": 21,
          "text": "נת' באריכות)"
        },
        {
          "s": 22,
          "text": "בענין ויהי בשלח פרעה את העם15,"
        },
        {
          "s": 23,
          "text": "דהכוונה בזה הוא דלא זו בלבד שלא העלים והסתיר קליפת פרעה,"
        },
        {
          "s": 24,
          "text": "אדרבה עוד סייע,"
        },
        {
          "s": 25,
          "text": "וכמ\"ש16"
        },
        {
          "s": 26,
          "text": "ופרעה הקריב ואיתא במדרש17"
        },
        {
          "s": 27,
          "text": "הקריב את לבן של ישראל לאביהם שבשמים,"
        },
        {
          "s": 28,
          "text": "ועוד זאת שגם פרעה את העם פרעה איז מיטגעגאַנגען מיט דעם עם,"
        },
        {
          "s": 29,
          "text": "היינו שגם ניצוצים שנפלו שמה עלו אתם."
        },
        {
          "s": 30,
          "text": "וזהו ג\"כ דיוק הלשון ואדרבה,"
        },
        {
          "s": 31,
          "text": "היינו לא רק שהגוף אינו מעלים ומסתיר על הנשמה והיא נשארת במצבה כמו שאין העלם והסתר,"
        },
        {
          "s": 32,
          "text": "אלא אדרבה שע\"י ההעלם מתחלה,"
        },
        {
          "s": 33,
          "text": "האדם מתחזק ביתרון כח."
        },
        {
          "s": 34,
          "text": "וזהו עיקר הכוונה בבריאת העולמות אתכפיא ואתהפכא דהשטות דלעו\"ז און דעם קאָך פון נה\"ב און עניני עולם – לקדושה."
        },
        {
          "s": 35,
          "text": "ואף שמבואר בכ\"מ דעשיית המצוות הוא כדי להוסיף אורות באצי',"
        },
        {
          "s": 36,
          "text": "הנה כבר נת' לעיל18"
        },
        {
          "s": 37,
          "text": "דהעצמי שבזה הוא בעוה\"ז."
        },
        {
          "s": 38,
          "text": "וכמ\"ש כ\"ק אדמו\"ר הצ\"צ וכ\"ק אדמו\"ר מוהר\"ש19"
        },
        {
          "s": 39,
          "text": "שהאורות כמו שהם באצילות הם כמונחים בקופסא,"
        },
        {
          "s": 40,
          "text": "ולא זו בלבד שעיקר הגילוי,"
        },
        {
          "s": 41,
          "text": "עיקר שכינה,"
        },
        {
          "s": 42,
          "text": "הוא בעוה\"ז,"
        },
        {
          "s": 43,
          "text": "וכמשנת\"ל20"
        },
        {
          "s": 44,
          "text": "מכ\"ק אדמו\"ר"
        },
        {
          "s": 45,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 46,
          "text": "נ\"ע בארוכה פי' ענין עיקר שכינה,"
        },
        {
          "s": 47,
          "text": "הנה עוד יותר מזה,"
        },
        {
          "s": 48,
          "text": "מבאר כ\"ק רבינו הזקן21"
        },
        {
          "s": 49,
          "text": "וכ\"ה מכ\"ק הרב המגיד22,"
        },
        {
          "s": 50,
          "text": "בפי' מרז\"ל23"
        },
        {
          "s": 51,
          "text": "דע מה למעלה ממך,"
        },
        {
          "s": 52,
          "text": "דע אשר מה למעלה,"
        },
        {
          "s": 53,
          "text": "כל הענינים שלמעלה,"
        },
        {
          "s": 54,
          "text": "ממך ובך הדבר תלוי."
        }
      ]
    }
  ]
}