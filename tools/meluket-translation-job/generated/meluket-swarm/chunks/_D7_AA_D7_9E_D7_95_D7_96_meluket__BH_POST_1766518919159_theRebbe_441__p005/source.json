{
  "globalIndex": 905,
  "owner": 5,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919159_theRebbe_441__p005",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919159_theRebbe_441__p005",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919159_theRebbe_441",
  "title": "מאמר ה' לי בעוזרי תשי\"ז",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "וצריך להבין,"
        },
        {
          "s": 1,
          "text": "הרי עסק התורה דדוד באופן דזמירות היו לי חוקיך הוא בבחינת התורה כמו שהיא מצד רצון העצמי"
        },
        {
          "s": 2,
          "text": "(כנ\"ל בארוכה),"
        },
        {
          "s": 3,
          "text": "והיאך שייך שזה יהי' שלא כפי אמיתית הכוונה."
        },
        {
          "s": 4,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 5,
          "text": "ע\"פ מ\"ש בהמאמר בתחילתו בענין הוי' אחד48,"
        },
        {
          "s": 6,
          "text": "דפירוש אחד זה הוא יחיד,"
        },
        {
          "s": 7,
          "text": "ומה שאומרים אחד ולא יחיד הוא להורות דהוי' ואלקים כולא חד49."
        },
        {
          "s": 8,
          "text": "והענין הוא,"
        },
        {
          "s": 9,
          "text": "דאמיתית ענין אחדות הוי' הוא שהאחדות היא גם מצד העולם."
        },
        {
          "s": 10,
          "text": "וזהו מ\"ש הוי' אחד,"
        },
        {
          "s": 11,
          "text": "דבאם הי' כתיב הוי' יחיד,"
        },
        {
          "s": 12,
          "text": "הי' הפירוש בזה שיחודו ית' הוא מצד אוא\"ס"
        },
        {
          "s": 13,
          "text": "(ולא מצד העולם),"
        },
        {
          "s": 14,
          "text": "ובכדי להדגיש שיחודו ית' הוא גם מצד העולם,"
        },
        {
          "s": 15,
          "text": "ואפילו מצד העולם כמו שנברא משם אלקים שמעלים ומסתיר על שם הוי',"
        },
        {
          "s": 16,
          "text": "לכן נאמר50"
        },
        {
          "s": 17,
          "text": "הוי' אחד,"
        },
        {
          "s": 18,
          "text": "שגם החי\"ת והדל\"ת שהם ז' רקיעים וארץ וד' רוחות העולם,"
        },
        {
          "s": 19,
          "text": "הם בטלים להאל\"ף יחידו של עולם51."
        },
        {
          "s": 20,
          "text": "דמכיון שהוי' ואלקים כולא חד,"
        },
        {
          "s": 21,
          "text": "הרי שם אלקים אינו מסתיר באמת,"
        },
        {
          "s": 22,
          "text": "ולכן,"
        },
        {
          "s": 23,
          "text": "גם העולם שנתהווה משם אלקים הוא בטל באמת ואין עוד מלבדו52."
        },
        {
          "s": 24,
          "text": "ועד להביטול בדרגת ואופן דיחיד שלמעלה מאחד."
        },
        {
          "s": 25,
          "text": "וע\"י היחוד דשני הענינים"
        },
        {
          "s": 26,
          "text": "(שיחודו ית' הוא באופן דיחיד,"
        },
        {
          "s": 27,
          "text": "ושענין זה הוא גם מצד העולם),"
        },
        {
          "s": 28,
          "text": "עי\"ז הוא גילוי כח העצמות שכולל ומחבר הענין דאחד ודיחיד."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ב)"
        },
        {
          "s": 2,
          "text": "ויש להוסיף,"
        },
        {
          "s": 3,
          "text": "דשם הוי'"
        },
        {
          "s": 4,
          "text": "(הוי' אחד)"
        },
        {
          "s": 5,
          "text": "מורה על כל ג' הענינים"
        },
        {
          "s": 6,
          "text": "(אחד ויחיד וכח העצמות שמחברם)."
        },
        {
          "s": 7,
          "text": "דבהוי' יש ג' ענינים: א' הוי' מלשון מהוה53,"
        },
        {
          "s": 8,
          "text": "דפירוש זה בשם הוי' מורה על שייכותו לעולמות,"
        },
        {
          "s": 9,
          "text": "ב' הוי' מלשון הי' הוה ויהי'54,"
        },
        {
          "s": 10,
          "text": "דפירוש זה בשם הוי' מורה שהוא למעלה מעולמות,"
        },
        {
          "s": 11,
          "text": "וענין הג' בשם הוי' הוא שהוי' הוא שם העצם55,"
        },
        {
          "s": 12,
          "text": "היינו שהוא מורה על עצמותו ית'."
        },
        {
          "s": 13,
          "text": "דהגם שבפרדס56"
        },
        {
          "s": 14,
          "text": "כתב דזה ששם הוי' הוא שם העצם הוא רק לעצם הספירות,"
        },
        {
          "s": 15,
          "text": "היינו האורות המתלבשים בכלים,"
        },
        {
          "s": 16,
          "text": "הרי המסקנא דתורת החסידות57"
        },
        {
          "s": 17,
          "text": "היא דפירוש שם העצם הוא בהעצמות."
        },
        {
          "s": 18,
          "text": "והנה מכיון שכל ג' הענינים הם באותו שם,"
        },
        {
          "s": 19,
          "text": "הרי מובן58"
        },
        {
          "s": 20,
          "text": "שהם שייכים זל\"ז."
        },
        {
          "s": 21,
          "text": "והיינו דההתאחדות דשני הפירושים בהוי',"
        },
        {
          "s": 22,
          "text": "הוי' לשון מהוה והוי' מלשון הי' הוה ויהי' כאחד,"
        },
        {
          "s": 23,
          "text": "הוא מצד זה שהוי' הוא שם העצם."
        },
        {
          "s": 24,
          "text": "ונמצא,"
        },
        {
          "s": 25,
          "text": "דע\"י שהוי' שלמעלה מעולמות"
        },
        {
          "s": 26,
          "text": "(הי' הוה ויהי' כאחד)"
        },
        {
          "s": 27,
          "text": "נמשך בהוי' לשון מהוה,"
        },
        {
          "s": 28,
          "text": "אף שבחיצוניות הו\"ע של ירידה,"
        },
        {
          "s": 29,
          "text": "הנה עי\"ז דוקא מתגלה שם העצם שבו."
        },
        {
          "s": 30,
          "text": "ולא עוד אלא שגילוי שם העצם דהוי' הוא בעיקר בהוי' לשון מהוה."
        },
        {
          "s": 31,
          "text": "וכמבואר בכ\"מ57"
        },
        {
          "s": 32,
          "text": "דמה ששם הוי' הוא שם העצם שמורה על העצמות הוא כי ההתהוות יש מאין היא דוקא בכח העצמות שמציאותו מעצמותו59."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ג)"
        },
        {
          "s": 2,
          "text": "ועפ\"ז יובן גם מ\"ש הרמב\"ם60"
        },
        {
          "s": 3,
          "text": "(הובא במאמר הנ\"ל בתחילתו)"
        },
        {
          "s": 4,
          "text": "יסוד היסודות ועמוד החכמות לידע שיש שם מצוי ראשון והוא ממציא כל נמצא,"
        },
        {
          "s": 5,
          "text": "וכל הנמצאים משמים וארץ ומה שביניהם לא נמצאו אלא מאמיתת המצאו."
        },
        {
          "s": 6,
          "text": "דמצות הידיעה היא בג' ענינים."
        },
        {
          "s": 7,
          "text": "שיש שם מצוי ראשון,"
        },
        {
          "s": 8,
          "text": "שהוא ממציא כל נמצא,"
        },
        {
          "s": 9,
          "text": "ושכל הנמצאים כו' לא נמצאו אלא מאמיתת המצאו."
        },
        {
          "s": 10,
          "text": "דג' ענינים אלו הם נגד ג' ענינים הנ\"ל בהוי'."
        },
        {
          "s": 11,
          "text": "יסוד היסודות ועמוד החכמות הוא ר\"ת הוי'61."
        },
        {
          "s": 12,
          "text": "מצוי ראשון הוא שהוא קדום לכל,"
        },
        {
          "s": 13,
          "text": "למעלה מהבריאה."
        },
        {
          "s": 14,
          "text": "ממציא כל נמצא הוא הוי' לשון מהוה."
        },
        {
          "s": 15,
          "text": "וכל הנמצאים כו' לא נמצאו אלא מאמיתת המצאו,"
        },
        {
          "s": 16,
          "text": "אמיתת המצאו הוא העצמות שמציאותו מעצמותו62,"
        },
        {
          "s": 17,
          "text": "דהתהוות הנמצאים יש מאין הוא בכח העצמות"
        },
        {
          "s": 18,
          "text": "(כנ\"ל),"
        },
        {
          "s": 19,
          "text": "ענין שם העצם."
        }
      ]
    }
  ]
}