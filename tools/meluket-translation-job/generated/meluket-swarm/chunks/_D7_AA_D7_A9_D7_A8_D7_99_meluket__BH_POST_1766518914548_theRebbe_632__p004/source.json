{
  "globalIndex": 149,
  "owner": 49,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914548_theRebbe_632__p004",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914548_theRebbe_632__p004",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914548_theRebbe_632",
  "title": "מאמר ביום השמיני תשמ\"א",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה ג' ענינים הנ\"ל הם גם בהתשובה דהשבת הניצוצות"
        },
        {
          "s": 2,
          "text": "(שבדברים הגשמיים)"
        },
        {
          "s": 3,
          "text": "למקורם,"
        },
        {
          "s": 4,
          "text": "שגם בתשובה זו יש דוגמת ג' ענינים הנ\"ל."
        },
        {
          "s": 5,
          "text": "א',"
        },
        {
          "s": 6,
          "text": "הצמאון והתשוקה דהניצוצות"
        },
        {
          "s": 7,
          "text": "(מצד שרשם)"
        },
        {
          "s": 8,
          "text": "לעלות מירידתן ולחזור לשרשם,"
        },
        {
          "s": 9,
          "text": "וע\"ד מים תחתונים בוכין אנן בעינן למהוי קדם מלכא47."
        },
        {
          "s": 10,
          "text": "ב',"
        },
        {
          "s": 11,
          "text": "גודל השמחה שנעשה מהעלאת הניצוצות וחזרתם למקורם לאחרי שנתרחקו48."
        },
        {
          "s": 12,
          "text": "וג',"
        },
        {
          "s": 13,
          "text": "מכיון שהניצוצות שנפלו בקליפות,"
        },
        {
          "s": 14,
          "text": "גם בקליפת נוגה49,"
        },
        {
          "s": 15,
          "text": "נכבה אורם50,"
        },
        {
          "s": 16,
          "text": "הרי מצד מצבם אין שייך שיתבררו ויתעלו לשרשן,"
        },
        {
          "s": 17,
          "text": "וכשמתבררים ועולים לשרשם"
        },
        {
          "s": 18,
          "text": "(ע\"י עבודת האדם),"
        },
        {
          "s": 19,
          "text": "הוא חידוש51."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דהחידוש שבתשובה דהשבת הניצוצות הוא חידוש גדול יותר מהחידוש שבתשובה כפשוטה."
        },
        {
          "s": 2,
          "text": "דבתשובה כפשוטה,"
        },
        {
          "s": 3,
          "text": "אף שלפני התשובה הי' במצב כזה שלא עשה רצון הקב\"ה כנ\"ל,"
        },
        {
          "s": 4,
          "text": "הרי זהו רק כמו שהוא בחיצוניות,"
        },
        {
          "s": 5,
          "text": "אבל רצונו האמיתי"
        },
        {
          "s": 6,
          "text": "(גם אז52)"
        },
        {
          "s": 7,
          "text": "הי' למלאות רצון קונו"
        },
        {
          "s": 8,
          "text": "(כפס\"ד הידוע53),"
        },
        {
          "s": 9,
          "text": "אלא שרצון זה הי' בתכלית ההעלם,"
        },
        {
          "s": 10,
          "text": "ועד שהגילוי שלו הוא כמו חידוש54."
        },
        {
          "s": 11,
          "text": "משא\"כ התשובה דהחזרת הניצוצות למקורם,"
        },
        {
          "s": 12,
          "text": "מכיון שהניצוצות שנפלו בהקליפות"
        },
        {
          "s": 13,
          "text": "(גם בק\"נ)"
        },
        {
          "s": 14,
          "text": "נחשך אורם,"
        },
        {
          "s": 15,
          "text": "ועד שאינם בבחי' אור כלל,"
        },
        {
          "s": 16,
          "text": "הרי הבירור וההעלאה שלהם הוא חידוש ממש."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "אמנם,"
        },
        {
          "s": 2,
          "text": "ענין זה"
        },
        {
          "s": 3,
          "text": "(העילוי בהתשובה דהחזרת הניצוצות)"
        },
        {
          "s": 4,
          "text": "הוא במעלת החידוש שבתשובה."
        },
        {
          "s": 5,
          "text": "משא\"כ המעלה דצמאון שע\"י הריחוק היא בעיקר בהתשובה דנשמה"
        },
        {
          "s": 6,
          "text": "(הן בתשובה דצדיקים והן בתשובה כפשוטה)."
        },
        {
          "s": 7,
          "text": "דמכיון שההתקשרות דנשמות עם אלקות היא התקשרות עצמית,"
        },
        {
          "s": 8,
          "text": "כמו התקשרות בן עם האב"
        },
        {
          "s": 9,
          "text": "(בנים אתם להוי' אלקיכם55)"
        },
        {
          "s": 10,
          "text": "שהיא התקשרות עצמית56,"
        },
        {
          "s": 11,
          "text": "הרי כשהנשמה מרגישה שהיא מרוחקת מאלקות"
        },
        {
          "s": 12,
          "text": "(הריחוק שע\"י ירידתה למטה,"
        },
        {
          "s": 13,
          "text": "ומכ\"ש הריחוק שע\"י עבירות),"
        },
        {
          "s": 14,
          "text": "זה נוגע לעצמותה,"
        },
        {
          "s": 15,
          "text": "ובמילא,"
        },
        {
          "s": 16,
          "text": "גם הצמאון שע\"י הרגש הריחוק נוגע לעצמותה."
        },
        {
          "s": 17,
          "text": "ועד\"ז הוא גם בהתענוג מהקירוב שבא לאחרי הריחוק,"
        },
        {
          "s": 18,
          "text": "דמכיון שהנשמות הם בנים,"
        },
        {
          "s": 19,
          "text": "דהבן הוא מעצמיות האב57,"
        },
        {
          "s": 20,
          "text": "הרי תענוג האב מזה שנתקרב בנו"
        },
        {
          "s": 21,
          "text": "(לאחרי שנתרחק),"
        },
        {
          "s": 22,
          "text": "ועאכו\"כ בנו יחידו58,"
        },
        {
          "s": 23,
          "text": "הוא תענוג עצמי59."
        },
        {
          "s": 24,
          "text": "משא\"כ התענוג מקירוב הניצוצות לאחרי שנתרחקו הוא דוגמת שני אוהבים60"
        },
        {
          "s": 25,
          "text": "שלא ראו זה את זה משך זמן רב ולאחרי שמתקרבים ורואים זה את זה,"
        },
        {
          "s": 26,
          "text": "הם מתענגים ושמחים במאד61,"
        },
        {
          "s": 27,
          "text": "שתענוג זה"
        },
        {
          "s": 28,
          "text": "(עם היותו תענוג גדול)"
        },
        {
          "s": 29,
          "text": "הוא כמו שאר התענוגים שהם מדבר שחוץ ממנו62."
        }
      ]
    }
  ]
}