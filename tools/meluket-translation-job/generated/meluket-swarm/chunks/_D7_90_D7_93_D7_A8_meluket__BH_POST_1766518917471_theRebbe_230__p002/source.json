{
  "globalIndex": 639,
  "owner": 39,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917471_theRebbe_230__p002",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917471_theRebbe_230__p002",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917471_theRebbe_230",
  "title": "מאמר בלילה ההוא תשכ\"ה",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר15,"
        },
        {
          "s": 2,
          "text": "דזה שבלילה ההוא נדדה שנת המלך מלכו של עולם"
        },
        {
          "s": 3,
          "text": "(עיקר הנס דפורים)"
        },
        {
          "s": 4,
          "text": "נעשה ע\"י המס\"נ דישראל במשך כל השנה16."
        },
        {
          "s": 5,
          "text": "וצריך להבין,"
        },
        {
          "s": 6,
          "text": "הרי בזמן שישראל עושין רצונו של מקום,"
        },
        {
          "s": 7,
          "text": "אזי"
        },
        {
          "s": 8,
          "text": "(מצד סדר ההשתלשלות)"
        },
        {
          "s": 9,
          "text": "לא17"
        },
        {
          "s": 10,
          "text": "ינום ולא יישן18,"
        },
        {
          "s": 11,
          "text": "וכיון שישראל עמדו אז במס\"נ במשך כל השנה,"
        },
        {
          "s": 12,
          "text": "מהו הנס ויתירה מזה תוקף19"
        },
        {
          "s": 13,
          "text": "הנס בזה שנדדה שנת המלך."
        },
        {
          "s": 14,
          "text": "גם צריך להבין,"
        },
        {
          "s": 15,
          "text": "דפירוש בלילה ההוא נדדה שנת המלך לפי פשוטו שקאי על המלך אחשורוש,"
        },
        {
          "s": 16,
          "text": "הוא,"
        },
        {
          "s": 17,
          "text": "שהדברים שאירעו בלילה ההוא הם גרמו שנדדה שנת המלך20."
        },
        {
          "s": 18,
          "text": "וע\"פ הידוע שהענינים דלמטה משתלשלים מענינם למעלה21,"
        },
        {
          "s": 19,
          "text": "מובן,"
        },
        {
          "s": 20,
          "text": "דכמו\"כ הוא בנוגע לזה שנדדה שנת המלך מלכו של עולם,"
        },
        {
          "s": 21,
          "text": "שהענין דבלילה ההוא הוא שגרם להיות נדדה שנת המלך."
        },
        {
          "s": 22,
          "text": "וצריך להבין,"
        },
        {
          "s": 23,
          "text": "הרי לילה ההוא מורה"
        },
        {
          "s": 24,
          "text": "(כנ\"ל סעיף א)"
        },
        {
          "s": 25,
          "text": "על ההעלם וההסתר וגודלו,"
        },
        {
          "s": 26,
          "text": "היפך הענין שלילה ההוא מביא שיהי' נדדה שנת המלך מלכו של עולם22."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים המבואר בתו\"א בדרושי פורים23,"
        },
        {
          "s": 2,
          "text": "ובארוכה בדרוש אדמו\"ר האמצעי24,"
        },
        {
          "s": 3,
          "text": "דביום"
        },
        {
          "s": 4,
          "text": "(גילוי)"
        },
        {
          "s": 5,
          "text": "ובלילה"
        },
        {
          "s": 6,
          "text": "(העלם),"
        },
        {
          "s": 7,
          "text": "בכל אחד מהם,"
        },
        {
          "s": 8,
          "text": "יש שני הענינים דגילוי והעלם."
        },
        {
          "s": 9,
          "text": "וזהו שלפעמים כתיב יום הזה,"
        },
        {
          "s": 10,
          "text": "דזה מורה על גילוי25,"
        },
        {
          "s": 11,
          "text": "ולפעמים כתיב יום ההוא,"
        },
        {
          "s": 12,
          "text": "דהוא מורה על העלם"
        },
        {
          "s": 13,
          "text": "(כנ\"ל),"
        },
        {
          "s": 14,
          "text": "וכן בלילה לפעמים כתיב לילה הזה ולפעמים כתיב לילה ההוא."
        },
        {
          "s": 15,
          "text": "ונקודת הביאור בזה"
        },
        {
          "s": 16,
          "text": "(כמובן מהדרושים),"
        },
        {
          "s": 17,
          "text": "דהחילוק בין יום ולילה הוא בהם עצמם,"
        },
        {
          "s": 18,
          "text": "דיום הוא אור ולילה הוא חושך כמ\"ש26"
        },
        {
          "s": 19,
          "text": "ויקרא אלקים לאור יום ולחושך קרא לילה,"
        },
        {
          "s": 20,
          "text": "ועוד חילוק באופן היום והלילה,"
        },
        {
          "s": 21,
          "text": "אם הם באופן של גילוי"
        },
        {
          "s": 22,
          "text": "(זה)"
        },
        {
          "s": 23,
          "text": "או באופן של העלם"
        },
        {
          "s": 24,
          "text": "(הוא)."
        },
        {
          "s": 25,
          "text": "דלשון זה בנוגע ליום ולילה מורה על היום והלילה כמו שנמשכו למטה בגילוי,"
        },
        {
          "s": 26,
          "text": "ולשון הוא מורה על היום והלילה כמו שהם בעצם"
        },
        {
          "s": 27,
          "text": "(לפני שנמשכו בגילוי),"
        },
        {
          "s": 28,
          "text": "ולמעלה יותר – כמו שהם בשרשם."
        },
        {
          "s": 29,
          "text": "וזהו שבהגאולה דיציאת מצרים כתיב27"
        },
        {
          "s": 30,
          "text": "בעצם היום הזה יצאו כל צבאות הוי' מארץ מצרים,"
        },
        {
          "s": 31,
          "text": "וכן בתומ\"צ"
        },
        {
          "s": 32,
          "text": "(כמו שהם עכשיו28)"
        },
        {
          "s": 33,
          "text": "כתיב29"
        },
        {
          "s": 34,
          "text": "היום הזה ה' אלקיך מצוך גו',"
        },
        {
          "s": 35,
          "text": "ובגאולה העתידה כתיב30"
        },
        {
          "s": 36,
          "text": "ואמר ביום ההוא גו',"
        },
        {
          "s": 37,
          "text": "כי הגילוי שהי' בהגאולה דיצי\"מ הוא הגילוי דהאור כמו שנמשך למטה,"
        },
        {
          "s": 38,
          "text": "יום הזה,"
        },
        {
          "s": 39,
          "text": "ובגאולה העתידה יהי' גילוי עצם האור כמו שהוא למעלה מהמשכה וגילוי,"
        },
        {
          "s": 40,
          "text": "יום ההוא."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ועד\"ז הוא בנוגע ללילה,"
        },
        {
          "s": 2,
          "text": "בחינת החושך שלמעלה מאור"
        },
        {
          "s": 3,
          "text": "(למעלה גם מעצם האור),"
        },
        {
          "s": 4,
          "text": "דהחושך עצמו לפני שנמשך בגילוי"
        },
        {
          "s": 5,
          "text": "(ומכש\"כ כמו שהוא בשרשו)"
        },
        {
          "s": 6,
          "text": "נקרא לילה ההוא,"
        },
        {
          "s": 7,
          "text": "וכאשר נמשך למטה נקרא לילה הזה."
        },
        {
          "s": 8,
          "text": "אלא שבנוגע ללילה,"
        },
        {
          "s": 9,
          "text": "לילה ההוא הוא למטה מלילה הזה."
        },
        {
          "s": 10,
          "text": "דכיון שהחושך דלילה שלמעלה מאור הוא השרש והסיבה שעי\"ז נעשה חושך כפשוטו,"
        },
        {
          "s": 11,
          "text": "לכן ההעלם וההסתר"
        },
        {
          "s": 12,
          "text": "(חושך כפשוטו)"
        },
        {
          "s": 13,
          "text": "שנעשה ע\"י המשכת עצם החושך"
        },
        {
          "s": 14,
          "text": "(שלמעלה),"
        },
        {
          "s": 15,
          "text": "לילה ההוא,"
        },
        {
          "s": 16,
          "text": "הוא חושך גדול יותר מהחושך שנעשה ע\"י המשכת החושך כמו שבא בהמשכה,"
        },
        {
          "s": 17,
          "text": "לילה הזה."
        },
        {
          "s": 18,
          "text": "דלילה הזה הוא שהלילה הוא באופן דזה,"
        },
        {
          "s": 19,
          "text": "שנרגש בגילוי"
        },
        {
          "s": 20,
          "text": "[ועד לגילוי שאפשר להראות באצבע ולומר זה31]"
        },
        {
          "s": 21,
          "text": "שהוא לילה,"
        },
        {
          "s": 22,
          "text": "ולילה ההוא הוא שהלילה הוא באופן דהסתר"
        },
        {
          "s": 23,
          "text": "(הוא),"
        },
        {
          "s": 24,
          "text": "שאין נרגש שהוא לילה."
        }
      ]
    }
  ]
}