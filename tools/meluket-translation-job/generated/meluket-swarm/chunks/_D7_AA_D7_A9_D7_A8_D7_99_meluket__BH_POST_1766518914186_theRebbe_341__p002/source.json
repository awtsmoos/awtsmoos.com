{
  "globalIndex": 84,
  "owner": 34,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914186_theRebbe_341__p002",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914186_theRebbe_341__p002",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914186_theRebbe_341",
  "title": "מאמר בסוכות תשבו תשל\"ו",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ונקודת הביאור בכל ענינים אלו,"
        },
        {
          "s": 2,
          "text": "דסוכה הוא ענין המקיף13."
        },
        {
          "s": 3,
          "text": "ולא כהמקיף דלבוש,"
        },
        {
          "s": 4,
          "text": "שעם היותו בחי' מקיף מ\"מ יש בו התחלקות,"
        },
        {
          "s": 5,
          "text": "לבושי הראש לבושי הגוף ולבושי הרגל"
        },
        {
          "s": 6,
          "text": "(ובכאו\"א לפי מדת המלובש בו)."
        },
        {
          "s": 7,
          "text": "משא\"כ המקיף דסוכה שאין בו התחלקות,"
        },
        {
          "s": 8,
          "text": "שהרי הוא מקיף את ראשו ורובו14"
        },
        {
          "s": 9,
          "text": "[שהכוונה בזה – כמו ראשו וכולו,"
        },
        {
          "s": 10,
          "text": "כי רובו ככולו],"
        },
        {
          "s": 11,
          "text": "הראש הגוף והרגל כאחד15."
        },
        {
          "s": 12,
          "text": "ועפ\"ז צריך להבין מ\"ש בסוכות תשבו"
        },
        {
          "s": 13,
          "text": "[כהדיוק בכ\"מ בדרושי רבותינו נשיאינו,"
        },
        {
          "s": 14,
          "text": "וגם בהמשך תרס\"ו16],"
        },
        {
          "s": 15,
          "text": "הרי מקיף"
        },
        {
          "s": 16,
          "text": "(ובפרט כהנ\"ל)"
        },
        {
          "s": 17,
          "text": "אינו בבחינת התיישבות,"
        },
        {
          "s": 18,
          "text": "וא\"כ מהו\"ע בסוכות תשבו"
        },
        {
          "s": 19,
          "text": "[וגם אומר בסוכות"
        },
        {
          "s": 20,
          "text": "(בבי\"ת17)]."
        },
        {
          "s": 21,
          "text": "וענין זה"
        },
        {
          "s": 22,
          "text": "(התיישבות בסוכה)"
        },
        {
          "s": 23,
          "text": "אומרו ג' פעמים,"
        },
        {
          "s": 24,
          "text": "בסוכות תשבו גו' ישבו בסוכות גו' בסוכות הושבתי."
        },
        {
          "s": 25,
          "text": "גם צריך להבין מ\"ש למען ידעו דורותיכם כי בסוכות הושבתי גו'"
        },
        {
          "s": 26,
          "text": "(שהטעם לבסוכות תשבו גו' הוא בכדי שהדורות הבאים18"
        },
        {
          "s": 27,
          "text": "ידעו כי בסוכות הושבתי גו'),"
        },
        {
          "s": 28,
          "text": "דמכיון שמצות סוכה אינה ממצות התלויות בארץ ולא ממצות התלויות בזמן הבית,"
        },
        {
          "s": 29,
          "text": "יהי' קיומה במשך כל הדורות19,"
        },
        {
          "s": 30,
          "text": "כי התורה הזאת לא תהי' מוחלפת ח\"ו."
        },
        {
          "s": 31,
          "text": "וא\"כ הרי הידיעה"
        },
        {
          "s": 32,
          "text": "(כי בסוכות הושבתי גו')"
        },
        {
          "s": 33,
          "text": "של דורות הבאים תהי' עי\"ז שהם עצמם ישבו בסוכות,"
        },
        {
          "s": 34,
          "text": "ומהו בסוכות תשבו גו' למען ידעו דורותיכם,"
        },
        {
          "s": 35,
          "text": "שהידיעה של דורות הבאים תהי' ע\"י בסוכות תשבו דדורות הקודמים."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והביאור בזה הוא"
        },
        {
          "s": 2,
          "text": "(כאמור לעיל)"
        },
        {
          "s": 3,
          "text": "שסוכה הו\"ע מקיף."
        },
        {
          "s": 4,
          "text": "דהנה כתיב20"
        },
        {
          "s": 5,
          "text": "בכסה ליום חגינו,"
        },
        {
          "s": 6,
          "text": "דכל הענינים שהם בכסה"
        },
        {
          "s": 7,
          "text": "(כיסוי והעלם)"
        },
        {
          "s": 8,
          "text": "בהימים שלפני יום חגנו מתגלים הם בסוכות21."
        },
        {
          "s": 9,
          "text": "וכמו ענין השופר דר\"ה,"
        },
        {
          "s": 10,
          "text": "שמצות היום בשופר22,"
        },
        {
          "s": 11,
          "text": "הוא בא בגילוי ליום חגנו,"
        },
        {
          "s": 12,
          "text": "בהסכך דסוכה."
        },
        {
          "s": 13,
          "text": "דזהו מה שסכך"
        },
        {
          "s": 14,
          "text": "[דכל סוכות הכתוב סכך משמע דדופן לא איקרי סוכה23]"
        },
        {
          "s": 15,
          "text": "בגימטריא מאה24,"
        },
        {
          "s": 16,
          "text": "כנגד מאה קולות דשופר שנהגו25"
        },
        {
          "s": 17,
          "text": "ישראל"
        },
        {
          "s": 18,
          "text": "(שמנהג ישראל תורה היא)"
        },
        {
          "s": 19,
          "text": "לתקוע בר\"ה."
        },
        {
          "s": 20,
          "text": "וגם פרטי הקולות מרומזים בהאותיות דסכך,"
        },
        {
          "s": 21,
          "text": "ס' קולות דתקיעה,"
        },
        {
          "s": 22,
          "text": "כ' קולות דשברים וכ' דתרועה26."
        },
        {
          "s": 23,
          "text": "ועד\"ז הוא גם בנוגע לענין הקטורת דיוהכ\"פ שבא בגילוי ליום חגנו,"
        },
        {
          "s": 24,
          "text": "כידוע27"
        },
        {
          "s": 25,
          "text": "שסכך הסוכה הוא נעשה מענן הקטורת דיום הכפורים."
        },
        {
          "s": 26,
          "text": "ואף שביום הכפורים כבר ישנו ענין הגילוי,"
        },
        {
          "s": 27,
          "text": "דעיקר ענין בכסה"
        },
        {
          "s": 28,
          "text": "(החדש מתכסה)"
        },
        {
          "s": 29,
          "text": "הוא בתחילת החודש,"
        },
        {
          "s": 30,
          "text": "בראש השנה,"
        },
        {
          "s": 31,
          "text": "מ\"מ הגילוי דיום הכפורים"
        },
        {
          "s": 32,
          "text": "(עיקרו)"
        },
        {
          "s": 33,
          "text": "הוא למעלה28,"
        },
        {
          "s": 34,
          "text": "משא\"כ בסוכות נמשך הגילוי למטה ועד אשר"
        },
        {
          "s": 35,
          "text": "(סכך הסוכה,"
        },
        {
          "s": 36,
          "text": "הבא מענן הקטורת דיום הכפורים)"
        },
        {
          "s": 37,
          "text": "נראה גם לעיני בשר"
        },
        {
          "s": 38,
          "text": "[וי\"ל דהתחלת גילוי זה היא בהימים שבין יום הכפורים לסוכות,"
        },
        {
          "s": 39,
          "text": "שאז היא ההכנה למצות סוכה ואז עשיית הסוכה29."
        },
        {
          "s": 40,
          "text": "היינו שבימים אלו היא ההכנה והתחלת המשכת הגילוי"
        },
        {
          "s": 41,
          "text": "(דיום הכפורים)"
        },
        {
          "s": 42,
          "text": "שעיקרו למעלה – גם למטה]."
        },
        {
          "s": 43,
          "text": "וזהו מה שסוכה היא בחי' מקיף."
        },
        {
          "s": 44,
          "text": "דהנה ההפרש בין קטורת לקרבנות הוא30,"
        },
        {
          "s": 45,
          "text": "שבקרבנות כתיב31"
        },
        {
          "s": 46,
          "text": "לחמי לאשי,"
        },
        {
          "s": 47,
          "text": "דלחם הוא ענין פנימי"
        },
        {
          "s": 48,
          "text": "(ויש קרבנות שהם נאכלים גם לכהנים,"
        },
        {
          "s": 49,
          "text": "וקרבנות הנאכלים גם לבעלים ולכל אדם),"
        },
        {
          "s": 50,
          "text": "משא\"כ קטורת"
        },
        {
          "s": 51,
          "text": "(ובפרט דיום הכפורים)"
        },
        {
          "s": 52,
          "text": "הוא מקיף."
        },
        {
          "s": 53,
          "text": "ולכן גם הגילוי שלו ליום חגנו הוא בענין של מקיף,"
        },
        {
          "s": 54,
          "text": "המקיף דסכך."
        },
        {
          "s": 55,
          "text": "ומכיון שהוא שייך לקודש קדשים שהוא אמיתית הענין דמקיף,"
        },
        {
          "s": 56,
          "text": "לכן גם המקיף דסוכה הנמשך מענן הקטורת דיום הכפורים הוא למעלה מהמקיף דלבוש ואין בו התחלקות,"
        },
        {
          "s": 57,
          "text": "ועד שמקיף גם את הלבושים דראש גוף ורגל כאחד."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וזוהי השייכות דסוכה לענין השלום כמ\"ש ופרושׂ עלינו סוכת שלומך,"
        },
        {
          "s": 2,
          "text": "דמאחר שסוכה הו\"ע המקיף"
        },
        {
          "s": 3,
          "text": "(שלמעלה מהתחלקות),"
        },
        {
          "s": 4,
          "text": "נמשך מהמקיף דסוכה ענין השלום,"
        },
        {
          "s": 5,
          "text": "נעשה שלום בין נפה\"א לנפה\"ב,"
        },
        {
          "s": 6,
          "text": "וגם שלום בכל הבחינות דנפה\"א עצמה,"
        },
        {
          "s": 7,
          "text": "דמכיון שהסוכה מקיפה את כל עניני האדם,"
        },
        {
          "s": 8,
          "text": "מראשו ועד רגלו,"
        },
        {
          "s": 9,
          "text": "לכן על ידה נעשה שלום בכל הבחינות שבאדם."
        },
        {
          "s": 10,
          "text": "ועד שע\"י הסוכה נעשה שלום גם בעולם,"
        },
        {
          "s": 11,
          "text": "וכידוע32"
        },
        {
          "s": 12,
          "text": "שסוכה היא בדוגמת תיבת נח,"
        },
        {
          "s": 13,
          "text": "שבה הי' ענין השלום"
        },
        {
          "s": 14,
          "text": "(דאף שהיו בתיבה כל החיות יחד,"
        },
        {
          "s": 15,
          "text": "מ\"מ לא הריעו ולא השחיתו זל\"ז),"
        },
        {
          "s": 16,
          "text": "ומעין השלום שיהי' לע\"ל אשר לא ירעו ולא ישחיתו גו'33."
        },
        {
          "s": 17,
          "text": "ואף שהמקיף דסוכה הוא בחי' חיצוניות בינה ותיבת נח היא בחי' פנימיות בינה,"
        },
        {
          "s": 18,
          "text": "ולע\"ל יהי' למעלה גם מבחי' פנימיות בינה כמו שהיא במקומה,"
        },
        {
          "s": 19,
          "text": "אעפ\"כ השלום דבחי' המקיף דסוכה הוא בדוגמת השלום דלע\"ל."
        },
        {
          "s": 20,
          "text": "כי הטעם דלא ירעו ולא ישחיתו"
        },
        {
          "s": 21,
          "text": "(דלע\"ל)"
        },
        {
          "s": 22,
          "text": "הוא ע\"י הדעת"
        },
        {
          "s": 23,
          "text": "(וכמו שמסיים בכתוב)"
        },
        {
          "s": 24,
          "text": "כי מלאה הארץ דעה את הוי',"
        },
        {
          "s": 25,
          "text": "ולכן גם המקיף דסוכה שענינו הוא למען ידעו גו'34"
        },
        {
          "s": 26,
          "text": "(ענין הדעת),"
        },
        {
          "s": 27,
          "text": "הוא פועל ענין השלום בדוגמת השלום דלע\"ל."
        },
        {
          "s": 28,
          "text": "ובפרט לפי הביאור35"
        },
        {
          "s": 29,
          "text": "בהשייכות דסכך הסוכה לענן הקטורת דיום הכפורים שענינו הוא בחי' עתיק"
        },
        {
          "s": 30,
          "text": "[ובדוגמת כללות הענין דיום הכפורים,"
        },
        {
          "s": 31,
          "text": "יום שנתחייב בחמשה תפלות36,"
        },
        {
          "s": 32,
          "text": "לפי שהוא בחי' עתיק],"
        },
        {
          "s": 33,
          "text": "כי בבחי' בינה"
        },
        {
          "s": 34,
          "text": "(גם בחיצוניות בינה37)"
        },
        {
          "s": 35,
          "text": "הוא גילוי עתיק,"
        },
        {
          "s": 36,
          "text": "דהתגלות עתיק הוא בבינה,"
        },
        {
          "s": 37,
          "text": "הנה בחי' עתיק המתגלה בסכך הסוכה,"
        },
        {
          "s": 38,
          "text": "פועל ענין השלום,"
        },
        {
          "s": 39,
          "text": "שלכן נקראת הסוכה בשם סוכת שלומך."
        }
      ]
    }
  ]
}