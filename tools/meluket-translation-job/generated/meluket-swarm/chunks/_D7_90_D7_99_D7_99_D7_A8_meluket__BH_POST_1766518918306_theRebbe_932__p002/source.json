{
  "globalIndex": 766,
  "owner": 16,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918306_theRebbe_932__p002",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918306_theRebbe_932__p002",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918306_theRebbe_932",
  "title": "מאמר השמים כסאי תשל\"ו",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ויש להוסיף בפירוש הכתוב ואל זה אביט אל עני גו',"
        },
        {
          "s": 2,
          "text": "דהכוונה בעני היא לא רק לענין הביטול,"
        },
        {
          "s": 3,
          "text": "אלא גם לעני כפשוטו"
        },
        {
          "s": 4,
          "text": "(עני בדעת17),"
        },
        {
          "s": 5,
          "text": "שאין לו ידיעה והשגה באלקות ועבודתו היא רק מצד האמונה18"
        },
        {
          "s": 6,
          "text": "שלמטה19"
        },
        {
          "s": 7,
          "text": "מטעם ודעת,"
        },
        {
          "s": 8,
          "text": "מ\"מ,"
        },
        {
          "s": 9,
          "text": "מכיון שבעניות זו"
        },
        {
          "s": 10,
          "text": "(דאמונה שלמטה מטעם ודעת)"
        },
        {
          "s": 11,
          "text": "יש גם ענין העניות למעליותא,"
        },
        {
          "s": 12,
          "text": "ביטול20,"
        },
        {
          "s": 13,
          "text": "לכן,"
        },
        {
          "s": 14,
          "text": "אל זה אביט."
        },
        {
          "s": 15,
          "text": "ובדוגמת הלבנה,"
        },
        {
          "s": 16,
          "text": "דהגם שזה שבעת המולד היא נקודה בלבד"
        },
        {
          "s": 17,
          "text": "(ומכש\"כ זה שברגע שלפני המולד היא מתעלמת ומסתתרת לגמרי)"
        },
        {
          "s": 18,
          "text": "הוא שאינה מאירה,"
        },
        {
          "s": 19,
          "text": "ואעפ\"כ,"
        },
        {
          "s": 20,
          "text": "מכיון שזה קשור גם עם הביטול שלה,"
        },
        {
          "s": 21,
          "text": "נמשך בה אז אור חדש מלעילא מן שמשא."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ויש לקשר זה עם הביאור של אדמו\"ר מהר\"ש21"
        },
        {
          "s": 1,
          "text": "(בעל יום ההולדת דב' אייר)"
        },
        {
          "s": 2,
          "text": "עה\"פ22"
        },
        {
          "s": 3,
          "text": "ובראשי חדשיכם,"
        },
        {
          "s": 4,
          "text": "דמ\"ש ובראשי חדשיכם,"
        },
        {
          "s": 5,
          "text": "ראשי לשון רבים23,"
        },
        {
          "s": 6,
          "text": "הוא,"
        },
        {
          "s": 7,
          "text": "כי חודש היא מדת המלכות,"
        },
        {
          "s": 8,
          "text": "שהיא בחינת האמונה,"
        },
        {
          "s": 9,
          "text": "שיש בה ב' נקודות."
        },
        {
          "s": 10,
          "text": "דבסגול נקודה האמצעית היא תחת שתי הנקודות,"
        },
        {
          "s": 11,
          "text": "ובסגולתא נקודה האמצעית היא למעלה משתי הנקודות,"
        },
        {
          "s": 12,
          "text": "ובאמונה יש ב' הנקודות."
        },
        {
          "s": 13,
          "text": "שבגילוי היא נקודה התחתונה שבסגול,"
        },
        {
          "s": 14,
          "text": "ויש בה גם נקודה העליונה שבסגולתא24,"
        },
        {
          "s": 15,
          "text": "כי נעוץ25"
        },
        {
          "s": 16,
          "text": "תחלתן בסופן."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז נמצא,"
        },
        {
          "s": 2,
          "text": "שהעבודה דעני ונכה רוח"
        },
        {
          "s": 3,
          "text": "(אמונה)"
        },
        {
          "s": 4,
          "text": "צריכה להיות גם לפני העבודה דהשמים כסאי והארץ הדום רגלי"
        },
        {
          "s": 5,
          "text": "(תורה ומצוות),"
        },
        {
          "s": 6,
          "text": "ומכש\"כ לפני העבודה דאיזה בית אשר תבנו לי"
        },
        {
          "s": 7,
          "text": "(בכל מאדך),"
        },
        {
          "s": 8,
          "text": "שהרי אמונה וביטול הם היסוד של כל הענינים."
        },
        {
          "s": 9,
          "text": "אלא שבתחילה,"
        },
        {
          "s": 10,
          "text": "העניות שלו היא כפשוטה26,"
        },
        {
          "s": 11,
          "text": "דזה שצריך לאמונה באלקות"
        },
        {
          "s": 12,
          "text": "(אף שכמה ענינים מוכרחים מצד השכל)"
        },
        {
          "s": 13,
          "text": "הוא מפני שהוא עני בדעת,"
        },
        {
          "s": 14,
          "text": "ולאחרי העבודה בכחות הפנימיים"
        },
        {
          "s": 15,
          "text": "(השמים כסאי והארץ הדום רגלי)"
        },
        {
          "s": 16,
          "text": "ובכחות המקיפים"
        },
        {
          "s": 17,
          "text": "(בית),"
        },
        {
          "s": 18,
          "text": "העניות שלו היא26"
        },
        {
          "s": 19,
          "text": "ע\"ד מרז\"ל27"
        },
        {
          "s": 20,
          "text": "פתי יאמין לכל דבר28"
        },
        {
          "s": 21,
          "text": "זה משה רבינו,"
        },
        {
          "s": 22,
          "text": "דהגם שמשה הי' בעל השגה גדולה בתכלית השלימות,"
        },
        {
          "s": 23,
          "text": "מ\"מ היו אצלו כל הענינים"
        },
        {
          "s": 24,
          "text": "(דאלקות)29"
        },
        {
          "s": 25,
          "text": "באופן של אמונה,"
        },
        {
          "s": 26,
          "text": "כי מכיון שלגבי הקב\"ה דלית מחשבה תפיסא בי' כלל30"
        },
        {
          "s": 27,
          "text": "הכל כפתיים אצלו ית'31,"
        },
        {
          "s": 28,
          "text": "לכן כל הענינים צריכים להיות באופן של אמונה."
        },
        {
          "s": 29,
          "text": "ובכללות הוא,"
        },
        {
          "s": 30,
          "text": "דהעניות שבתחילת העבודה היא ביטול דקבלת עול שלמטה מטעם ודעת,"
        },
        {
          "s": 31,
          "text": "והעניות שלאח\"ז היא ביטול במציאות שלמעלה מטעם ודעת."
        }
      ]
    }
  ]
}