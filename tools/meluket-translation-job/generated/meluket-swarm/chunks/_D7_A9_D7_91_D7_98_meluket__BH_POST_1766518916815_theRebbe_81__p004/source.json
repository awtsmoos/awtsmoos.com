{
  "globalIndex": 521,
  "owner": 21,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916815_theRebbe_81__p004",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916815_theRebbe_81__p004",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916815_theRebbe_81",
  "title": "מאמר באתי לגני תש\"ל",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר בפרק עשרים"
        },
        {
          "s": 2,
          "text": "(הפרק השייך לשנה זו46),"
        },
        {
          "s": 3,
          "text": "דירידת הנשמה בגוף אינה בשביל עצמה,"
        },
        {
          "s": 4,
          "text": "דהנשמה עצמה אינה צריכה תיקון,"
        },
        {
          "s": 5,
          "text": "וירידתה למטה הוא בכדי לתקן ולזכך ולברר את הגוף ונפשו הטבעית,"
        },
        {
          "s": 6,
          "text": "כמ\"ש אדמו\"ר הזקן בתניא47,"
        },
        {
          "s": 7,
          "text": "מיוסד על מ\"ש בע\"ח48."
        },
        {
          "s": 8,
          "text": "ומבאר שהוא דוגמת סוד גלות השכינה לברר ניצוצין."
        },
        {
          "s": 9,
          "text": "ויש לומר,"
        },
        {
          "s": 10,
          "text": "דזה שאומר שהוא דוגמת סוד גלות השכינה,"
        },
        {
          "s": 11,
          "text": "הוא,"
        },
        {
          "s": 12,
          "text": "כי ע\"י דוגמא זו מובן דזה שהנשמה אינה צריכה תיקון הוא נוסף על שאינה צריכה תיקון ממש"
        },
        {
          "s": 13,
          "text": "(כמו כל הנבראים49)"
        },
        {
          "s": 14,
          "text": "אלא שאינה צריכה תיקון כלל50."
        },
        {
          "s": 15,
          "text": "דכמו שבנוגע להשכינה פשוט שאין שייך שצריכה איזה תיקון יהי' איזה שיהי' וזה שבאה בגלות הוא רק לברר ניצוצין,"
        },
        {
          "s": 16,
          "text": "כמו\"כ הוא בירידת הנשמה למטה"
        },
        {
          "s": 17,
          "text": "[שהוא דוגמת סוד גלות השכינה]"
        },
        {
          "s": 18,
          "text": "שאינה צריכה תיקון כלל."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "והנה לאחרי שמבאר בהמאמר גודל מעלת הנשמה"
        },
        {
          "s": 2,
          "text": "(כמו שהיתה קודם הירידה)51"
        },
        {
          "s": 3,
          "text": "שלכן אינה צריכה תיקון,"
        },
        {
          "s": 4,
          "text": "אומר,"
        },
        {
          "s": 5,
          "text": "שירידת הנשמה למטה הוא בכדי לברר ולזכך את הגוף ונפשו הטבעית ולהאיר חלקו בעולם."
        },
        {
          "s": 6,
          "text": "דבתחלת הענין אומר שכוונת הירידה היא בשביל הגוף ונפשו הטבעית,"
        },
        {
          "s": 7,
          "text": "ולאח\"ז מוסיף גם חלקו בעולם52."
        },
        {
          "s": 8,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 9,
          "text": "דבפרק זה שהוא פרק האחרון הסיום והחותם דההמשך,"
        },
        {
          "s": 10,
          "text": "מבואר הסך הכל והנקודה הפנימית והתיכונית דכל ההמשך."
        },
        {
          "s": 11,
          "text": "ויש לקשר זה עם זה שפרק זה הוא פרק העשרים,"
        },
        {
          "s": 12,
          "text": "עשרים בגימטריא כתר,"
        },
        {
          "s": 13,
          "text": "דכתר הוא רצון,"
        },
        {
          "s": 14,
          "text": "והנקודה והסך הכל של כל ענין הוא השלמת הרצון."
        },
        {
          "s": 15,
          "text": "ויש לומר,"
        },
        {
          "s": 16,
          "text": "דזהו מה שבתחלת ההמשך מבאר הכוונה דבריאת והתהוות העולמות ובתחלת הפרק דסיום וחותם ההמשך מבאר הכוונה דירידת הנשמה בגוף,"
        },
        {
          "s": 17,
          "text": "בריאת האדם53,"
        },
        {
          "s": 18,
          "text": "כי כל הבריאה היא בשביל האדם54,"
        },
        {
          "s": 19,
          "text": "אתם קרויין אדם55,"
        },
        {
          "s": 20,
          "text": "דגם הכוונה שבבריאת העולמות שנתאוה הקב\"ה להיות לו ית' דירה בתחתונים הוא בשביל56"
        },
        {
          "s": 21,
          "text": "ישראל57,"
        },
        {
          "s": 22,
          "text": "ולכן,"
        },
        {
          "s": 23,
          "text": "בפרק העשרים שבו מבואר הנקודה הפנימית דכל הענינים שבפרקים הקודמים מדבר בענין הכוונה דבריאת האדם."
        },
        {
          "s": 24,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 25,
          "text": "דזה שבתחלת הענין אומר שהכוונה בירידת הנשמה היא לתקן את הגוף ונפש הטבעית ואינו מזכיר חלקו בעולם,"
        },
        {
          "s": 26,
          "text": "הוא בכדי להדגיש שעיקר ופנימיות הכוונה הוא האדם."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "והנה ידוע,"
        },
        {
          "s": 1,
          "text": "דהגם שהכוונה בירידת הנשמה למטה הוא בכדי לזכך ולברר את הגוף ונה\"ט ולא בשביל עצמה,"
        },
        {
          "s": 2,
          "text": "מ\"מ,"
        },
        {
          "s": 3,
          "text": "ע\"י ירידתה למטה,"
        },
        {
          "s": 4,
          "text": "נעשה בה עלי'58."
        },
        {
          "s": 5,
          "text": "והעלי' שלה היא בשני ענינים."
        },
        {
          "s": 6,
          "text": "העלי' שנעשית בה ע\"י שמשלמת הכוונה59,"
        },
        {
          "s": 7,
          "text": "ומזה משתלשל שנעשה בה עלי' גם בענין הגילויים,"
        },
        {
          "s": 8,
          "text": "דבהיותה למעלה היא בבחינת צדיק גמור וע\"י ירידתה למטה נעשית בבחינת בעל תשובה60."
        },
        {
          "s": 9,
          "text": "ויש לומר,"
        },
        {
          "s": 10,
          "text": "דכיון שבריאת העולמות הוא בשביל ישראל כנ\"ל,"
        },
        {
          "s": 11,
          "text": "לכן,"
        },
        {
          "s": 12,
          "text": "כמו שבישראל,"
        },
        {
          "s": 13,
          "text": "ע\"י ירידת נשמתם למטה נעשה עלי' בהנשמה,"
        },
        {
          "s": 14,
          "text": "והעלי' היא בשני ענינים,"
        },
        {
          "s": 15,
          "text": "בזה שמשלמת את הכוונה וזה שנעשית בבחינת בעל תשובה,"
        },
        {
          "s": 16,
          "text": "הנה מזה משתלשל גם בעולמות,"
        },
        {
          "s": 17,
          "text": "שע\"י הירידה דעולמות העליונים להוות את עוה\"ז התחתון,"
        },
        {
          "s": 18,
          "text": "נעשה בהם עלי'."
        },
        {
          "s": 19,
          "text": "והעלי' היא בשני ענינים."
        },
        {
          "s": 20,
          "text": "שהם הכנה שעל ידם נעשה התהוות עוה\"ז התחתון,"
        },
        {
          "s": 21,
          "text": "שבו נשלמת הכוונה דדירה בתחתונים61,"
        },
        {
          "s": 22,
          "text": "וגם העילוי"
        },
        {
          "s": 23,
          "text": "(בענין הגילויים)"
        },
        {
          "s": 24,
          "text": "שבעוה\"ז,"
        },
        {
          "s": 25,
          "text": "זה שע\"י אתכפיא ואתהפכא נמשך אור שלמעלה משייכות לעולמות,"
        },
        {
          "s": 26,
          "text": "גם המשכה זו ישנה גם בעולמות העליונים,"
        },
        {
          "s": 27,
          "text": "מכיון שעל ידם נעשה התהוות עוה\"ז התחתון62."
        }
      ]
    }
  ]
}