{
  "globalIndex": 284,
  "owner": 34,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915410_theRebbe_669__p004",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915410_theRebbe_669__p004",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915410_theRebbe_669",
  "title": "מאמר פדה בשלום תשמ\"ו",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה ידוע27"
        },
        {
          "s": 2,
          "text": "דשבת ויום טוב צריכים הכנה ביום שלפניהם – ערב שבת וערב יום טוב."
        },
        {
          "s": 3,
          "text": "ובנוגע לעניננו,"
        },
        {
          "s": 4,
          "text": "חג הגאולה יו\"ד כסלו – הערב דיו\"ד כסלו"
        },
        {
          "s": 5,
          "text": "[שבו הוא ההכנה ליו\"ד כסלו]"
        },
        {
          "s": 6,
          "text": "הוא יום התשיעי בכסלו,"
        },
        {
          "s": 7,
          "text": "יום ההולדת ויום ההילולא דבעל הגאולה."
        },
        {
          "s": 8,
          "text": "והגם שהגאולה דיו\"ד כסלו היתה בשנת תקפ\"ז28,"
        },
        {
          "s": 9,
          "text": "שנה לפני ההסתלקות,"
        },
        {
          "s": 10,
          "text": "מ\"מ,"
        },
        {
          "s": 11,
          "text": "כיון שמגלגלין זכות ליום זכאי29,"
        },
        {
          "s": 12,
          "text": "יש לומר,"
        },
        {
          "s": 13,
          "text": "דזה שיום התשיעי בכסלו זכה להיות יום ההילולא של אדמו\"ר האמצעי הוא לפי שגם לפני זה הי' שייך לזה30."
        },
        {
          "s": 14,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 15,
          "text": "שגודל העילוי דיום הגאולה"
        },
        {
          "s": 16,
          "text": "[יו\"ד כסלו],"
        },
        {
          "s": 17,
          "text": "שענין פדה בשלום נפשי שבו הוא ע\"ד הענין דפדה בשלום נפשי שיהי' לע\"ל,"
        },
        {
          "s": 18,
          "text": "הוא לפי שה\"ערב\" שלו הוא יום ההילולא דבעל הגאולה."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים מ\"ש בעל הגאולה במאמרו ד\"ה להבין ענין הילולא דרשב\"י31,"
        },
        {
          "s": 2,
          "text": "דזה שיום הסתלקות הרשב\"י נקרא בשם הילולא,"
        },
        {
          "s": 3,
          "text": "הוא,"
        },
        {
          "s": 4,
          "text": "לפי שע\"י רשב\"י הי' הגילוי דפנימיות התורה."
        },
        {
          "s": 5,
          "text": "ומבאר זה בהקדים מארז\"ל32"
        },
        {
          "s": 6,
          "text": "האי עלמא דאזלינן מיני' כבי הילולא דמיא,"
        },
        {
          "s": 7,
          "text": "שע\"י ירידת הנשמות למטה בעוה\"ז,"
        },
        {
          "s": 8,
          "text": "האי עלמא,"
        },
        {
          "s": 9,
          "text": "נעשה בהם הענין דאזלינן,"
        },
        {
          "s": 10,
          "text": "מהלכים."
        },
        {
          "s": 11,
          "text": "דהנשמות כמו שהן למעלה נק' עומדים כמ\"ש33"
        },
        {
          "s": 12,
          "text": "חי הוי' אלקי ישראל אשר עמדתי לפניו,"
        },
        {
          "s": 13,
          "text": "ובזהר איתא34"
        },
        {
          "s": 14,
          "text": "כל נשמתא ונשמתא הוה קיימא בדיוקנאה קמי מלכא קדישא."
        },
        {
          "s": 15,
          "text": "דהגם שהנשמות כמו שהן למעלה הן תמיד ברצוא ושוב,"
        },
        {
          "s": 16,
          "text": "דעי\"ז הם עולים בעילוי אחר עילוי,"
        },
        {
          "s": 17,
          "text": "מ\"מ,"
        },
        {
          "s": 18,
          "text": "כיון שכל העליות שלהם הם בהגבלה,"
        },
        {
          "s": 19,
          "text": "דגם המדרגות הכי גבוהות"
        },
        {
          "s": 20,
          "text": "(שבהם היא עליית הנשמות)"
        },
        {
          "s": 21,
          "text": "הם ע\"פ מאמר קו המדה35,"
        },
        {
          "s": 22,
          "text": "לכן נק' בשם עומדים."
        },
        {
          "s": 23,
          "text": "וע\"י ירידת הנשמות למטה הם נעשים מהלכים,"
        },
        {
          "s": 24,
          "text": "שהעלי' דהנשמות בירידתם למטה היא בבחינת א\"ס ובל\"ג."
        },
        {
          "s": 25,
          "text": "וזהו האי עלמא דאזלינן מיני',"
        },
        {
          "s": 26,
          "text": "דהנשמות כמו שהם מצד עצמם הם עומדים,"
        },
        {
          "s": 27,
          "text": "וע\"י ירידתם בהאי עלמא,"
        },
        {
          "s": 28,
          "text": "נעשים מהלכים,"
        },
        {
          "s": 29,
          "text": "אזלינן."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "והטעם על זה שדוקא ע\"י האי עלמא נעשה הענין דאזלינן,"
        },
        {
          "s": 1,
          "text": "הוא,"
        },
        {
          "s": 2,
          "text": "כי האי עלמא כבי הילולא דמיא."
        },
        {
          "s": 3,
          "text": "והענין הוא36,"
        },
        {
          "s": 4,
          "text": "דנשמה וגוף הם דוגמת איש ואשה37."
        },
        {
          "s": 5,
          "text": "וכמו שבאיש ואשה כפשוטם,"
        },
        {
          "s": 6,
          "text": "בכדי שיהי' היחוד דדכר ונוקבא"
        },
        {
          "s": 7,
          "text": "(שהם שני הפכים)"
        },
        {
          "s": 8,
          "text": "הוא ע\"י שנמשך בהם כח הא\"ס שלמעלה משניהם38,"
        },
        {
          "s": 9,
          "text": "וכח זה שנמשך בהם מתגלה בענין ההולדה"
        },
        {
          "s": 10,
          "text": "[דענין להוליד דור אחר דור עד אין שיעור הוא לא מצד גדר הנבראים שהם בעלי גבול,"
        },
        {
          "s": 11,
          "text": "אלא מצד כח הא\"ס39"
        },
        {
          "s": 12,
          "text": "שלמעלה מגדר הנבראים40"
        },
        {
          "s": 13,
          "text": "שנמשך ע\"י נישואין],"
        },
        {
          "s": 14,
          "text": "עד\"ז הוא בנשמה וגוף שהם דוגמת איש ואשה,"
        },
        {
          "s": 15,
          "text": "שבכדי שיוכל להיות החיבור והיחוד דנשמה וגוף שהם שני הפכים הוא ע\"י המשכת כח הא\"ס."
        },
        {
          "s": 16,
          "text": "והמשכת כח זה מתגלה בענין ההולדה,"
        },
        {
          "s": 17,
          "text": "תולדותיהם של צדיקים מעשים טובים41,"
        },
        {
          "s": 18,
          "text": "שהעלי' שע\"י התומ\"צ היא עלי' בבחי' א\"ס ובל\"ג."
        },
        {
          "s": 19,
          "text": "וזהו האי עלמא דאזלינן מיני' כבי הילולא דמיא,"
        },
        {
          "s": 20,
          "text": "דהטעם על זה שדוקא מיני'"
        },
        {
          "s": 21,
          "text": "(האי עלמא)"
        },
        {
          "s": 22,
          "text": "נעשה אזלינן"
        },
        {
          "s": 23,
          "text": "(מהלכים),"
        },
        {
          "s": 24,
          "text": "הוא,"
        },
        {
          "s": 25,
          "text": "כי האי עלמא כבי הילולא דמיא,"
        },
        {
          "s": 26,
          "text": "שהחיבור והיחוד דנשמה הרוחנית עם הגוף הגשמי"
        },
        {
          "s": 27,
          "text": "(האי עלמא)"
        },
        {
          "s": 28,
          "text": "הוא בדוגמת יחוד חתן וכלה"
        },
        {
          "s": 29,
          "text": "(הילולא,"
        },
        {
          "s": 30,
          "text": "חתונה),"
        },
        {
          "s": 31,
          "text": "שעי\"ז נמשך כח הא\"ס."
        }
      ]
    }
  ]
}