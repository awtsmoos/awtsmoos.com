{
  "globalIndex": 126,
  "owner": 26,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914440_theRebbe_936__p001",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914440_theRebbe_936__p001",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914440_theRebbe_936",
  "title": "מאמר תורה צוה תשכ\"ג",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "יום שמחת תורה ה'תשכ\"ג"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "תורה צוה לנו משה מורשה קהלת יעקב1,"
        },
        {
          "s": 1,
          "text": "שהתורה היא ירושה2"
        },
        {
          "s": 2,
          "text": "לכאו\"א3"
        },
        {
          "s": 3,
          "text": "שמקהלת יעקב."
        },
        {
          "s": 4,
          "text": "וידועים הדיוקים בזה4,"
        },
        {
          "s": 5,
          "text": "הרי אמרו רז\"ל5"
        },
        {
          "s": 6,
          "text": "התקן עצמך ללמוד תורה שאינה ירושה לך,"
        },
        {
          "s": 7,
          "text": "וכאן נאמר שהתורה היא ירושה."
        },
        {
          "s": 8,
          "text": "גם צריך להבין,"
        },
        {
          "s": 9,
          "text": "דפירוש ירושה בפשטות הוא שיורש מאבותיו"
        },
        {
          "s": 10,
          "text": "(היינו שמצד עצמו אינו שייך להדבר אלא שירש זה מאבותיו),"
        },
        {
          "s": 11,
          "text": "והרי כל ישראל היו"
        },
        {
          "s": 12,
          "text": "(נשמותיהם)"
        },
        {
          "s": 13,
          "text": "במעמד הר סיני6"
        },
        {
          "s": 14,
          "text": "וקיבלו בעצמם את התורה."
        },
        {
          "s": 15,
          "text": "גם צריך להבין,"
        },
        {
          "s": 16,
          "text": "דבפסוק שלאח\"ז7"
        },
        {
          "s": 17,
          "text": "נאמר ויהי בישורון מלך בהתאסף ראשי עם יחד שבטי ישראל,"
        },
        {
          "s": 18,
          "text": "מהי השייכות דויהי בישורון מלך גו' למורשה קהלת יעקב."
        },
        {
          "s": 19,
          "text": "גם,"
        },
        {
          "s": 20,
          "text": "דבפסוק זה נקראים ישראל בשם יעקב"
        },
        {
          "s": 21,
          "text": "(מורשה קהלת יעקב),"
        },
        {
          "s": 22,
          "text": "ובהפסוק שלאח\"ז בתחלתו נקראים בשם ישורון"
        },
        {
          "s": 23,
          "text": "(ויהי בישורון מלך)"
        },
        {
          "s": 24,
          "text": "ובסיום הפסוק נקראים בשם ישראל"
        },
        {
          "s": 25,
          "text": "(יחד שבטי ישראל)."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ונקודת הביאור בזה"
        },
        {
          "s": 2,
          "text": "(כמובן מהדרושים8),"
        },
        {
          "s": 3,
          "text": "דבתורה שני ענינים."
        },
        {
          "s": 4,
          "text": "התורה כמו שהיא מצד עצמה,"
        },
        {
          "s": 5,
          "text": "שהיא חכמתו ורצונו של הקב\"ה,"
        },
        {
          "s": 6,
          "text": "וכמו שהתורה ירדה למטה,"
        },
        {
          "s": 7,
          "text": "ומבררת ומזככת את העולם,"
        },
        {
          "s": 8,
          "text": "מתחיל מהבירור והזיכוך שבאדם הלומד,"
        },
        {
          "s": 9,
          "text": "שהשכל דנפש הבהמית מתברר ומזדכך ונכלל בקדושה9."
        },
        {
          "s": 10,
          "text": "וזהו10"
        },
        {
          "s": 11,
          "text": "שאמרו רז\"ל11"
        },
        {
          "s": 12,
          "text": "לעולם יעסוק אדם בתורה ומצוות שלא לשמה שמתוך שלא לשמה בא לשמה,"
        },
        {
          "s": 13,
          "text": "דבתחילת העבודה,"
        },
        {
          "s": 14,
          "text": "עסק התורה דהאדם הוא בכדי לברר ולזכך את נפשו,"
        },
        {
          "s": 15,
          "text": "כמאמר רז\"ל12"
        },
        {
          "s": 16,
          "text": "מעיקרא כי עביד איניש אדעתא דנפשי' קא עביד,"
        },
        {
          "s": 17,
          "text": "שעסק התורה שלו הוא בכדי לזכך את נפשו,"
        },
        {
          "s": 18,
          "text": "ועי\"ז בא אח\"כ לעסק התורה לשמה,"
        },
        {
          "s": 19,
          "text": "לשם התורה עצמה"
        },
        {
          "s": 20,
          "text": "(שלמעלה מענין הבירורים)."
        }
      ]
    }
  ]
}