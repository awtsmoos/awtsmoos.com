{
  "globalIndex": 516,
  "owner": 16,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916782_theRebbe_480__p006",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916782_theRebbe_480__p006",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916782_theRebbe_480",
  "title": "מאמר באתי לגני תשכ\"ט",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ג)"
        },
        {
          "s": 2,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 3,
          "text": "דאיתא במדרש85,"
        },
        {
          "s": 4,
          "text": "דנעימות בימינך נצח זה הלולב שניקח בימין,"
        },
        {
          "s": 5,
          "text": "שעי\"ז הנצחון הוא בגילוי."
        },
        {
          "s": 6,
          "text": "וכדאיתא במדרש86"
        },
        {
          "s": 7,
          "text": "משל לשנים שנכנסו אצל הדיין ולית אנן ידעין מאן הוא נוצח אלא מאן דנסיב באיין"
        },
        {
          "s": 8,
          "text": "(לולב והדס87)"
        },
        {
          "s": 9,
          "text": "בידי' אנן ידעין דהוא נצוחייא,"
        },
        {
          "s": 10,
          "text": "כך ישראל כו' אנו יודעין דישראל אינון נצוחייא."
        },
        {
          "s": 11,
          "text": "ויש לומר,"
        },
        {
          "s": 12,
          "text": "דזה שמביא"
        },
        {
          "s": 13,
          "text": "(מהמדרש)"
        },
        {
          "s": 14,
          "text": "ולית אנן ידעין מאן הוא נוצח88,"
        },
        {
          "s": 15,
          "text": "הוא,"
        },
        {
          "s": 16,
          "text": "כי מכיון שכל ענין הנצחון הוא לנצח את המנגד,"
        },
        {
          "s": 17,
          "text": "הרי כל מה שהמנגד הוא בתוקף יותר,"
        },
        {
          "s": 18,
          "text": "הנצחון הוא ביותר."
        },
        {
          "s": 19,
          "text": "ולכן מביא בהמאמר \"לית אנן ידעין כו'\","
        },
        {
          "s": 20,
          "text": "היינו שהמנגד הוא בתוקף כ\"כ עד שיכול להיות ספק שהוא יהי' המנצח ח\"ו,"
        },
        {
          "s": 21,
          "text": "וכשמנצחים המנגד כשהוא בתוקף,"
        },
        {
          "s": 22,
          "text": "אז הוא אמיתית ועיקר ענין הנצחון."
        },
        {
          "s": 23,
          "text": "ועפ\"ז יובן גם מ\"ש בסיום וחותם הפרק דענין הנצחון הוא להיות אתכפיא סט\"א,"
        },
        {
          "s": 24,
          "text": "אתכפיא דוקא,"
        },
        {
          "s": 25,
          "text": "אף שבתחלת ההמשך אומר"
        },
        {
          "s": 26,
          "text": "(כו\"כ פעמים)"
        },
        {
          "s": 27,
          "text": "\"אתכפיא ואתהפכא\"89,"
        },
        {
          "s": 28,
          "text": "כי ענין ועשו לי מקדש שבזה מדבר בתחלת ההמשך,"
        },
        {
          "s": 29,
          "text": "נעשה בעיקר ע\"י העבודה דאתהפכא,"
        },
        {
          "s": 30,
          "text": "דע\"י שהאדם מהפך את נפש הבהמית שלו לקדושה,"
        },
        {
          "s": 31,
          "text": "נעשה כן גם בעולם90,"
        },
        {
          "s": 32,
          "text": "שהעולם נהפך להיות מקדש ודירה לו ית'."
        },
        {
          "s": 33,
          "text": "משא\"כ ענין הנצח"
        },
        {
          "s": 34,
          "text": "(דכל מה שהמנגד הוא בתוקף יותר הנצחון הוא ביותר,"
        },
        {
          "s": 35,
          "text": "כנ\"ל)"
        },
        {
          "s": 36,
          "text": "הוא בעיקר ע\"י העבודה דאתכפיא סט\"א בעודה בתקפה ובגבורתה91."
        },
        {
          "s": 37,
          "text": "וזהו גם מה שמסיים בהפרק \"ובשביל זה הוא התגלות אוצר העליון\","
        },
        {
          "s": 38,
          "text": "שעיקר התגלות האוצר ובאופן דבזבוז הוא בשביל העבודה דאתכפיא דוקא92."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "ויש לקשר זה עם המבואר בהמאמר93"
        },
        {
          "s": 1,
          "text": "דהגם שמסירת האוצר הוא ע\"י שרים ופקידים דוקא,"
        },
        {
          "s": 2,
          "text": "הכוונה פנימית הם האנשי חיל,"
        },
        {
          "s": 3,
          "text": "כי ההפרש בין אתכפיא לאתהפכא הוא,"
        },
        {
          "s": 4,
          "text": "כמו שמבאר אדמו\"ר מהר\"ש94,"
        },
        {
          "s": 5,
          "text": "דאתהפכא הוא שמואס ברע,"
        },
        {
          "s": 6,
          "text": "וכן עבודתו בהקו דועשה טוב היא כמ\"ש95"
        },
        {
          "s": 7,
          "text": "חפץ מאד,"
        },
        {
          "s": 8,
          "text": "שהוא חפץ במצוות בחשק ורצון,"
        },
        {
          "s": 9,
          "text": "דענין זה הוא רק בצדיקים"
        },
        {
          "s": 10,
          "text": "(שרים ופקידים),"
        },
        {
          "s": 11,
          "text": "משא\"כ אתכפיא הוא,"
        },
        {
          "s": 12,
          "text": "דהגם שאינו מואס ברע,"
        },
        {
          "s": 13,
          "text": "וגם בנוגע לועשה טוב אין לו חשק ורצון במצוות,"
        },
        {
          "s": 14,
          "text": "מ\"מ הוא כופה את עצמו להיות סור מרע ועשה טוב,"
        },
        {
          "s": 15,
          "text": "בדרך נצחון."
        },
        {
          "s": 16,
          "text": "וענין זה שייך לכל אחד מישראל"
        },
        {
          "s": 17,
          "text": "(אנשי חיל),"
        },
        {
          "s": 18,
          "text": "כדאיתא בתניא96"
        },
        {
          "s": 19,
          "text": "דאתכפיא סט\"א בעודה בתקפה ובגבורתה היא מדת הבינונים,"
        },
        {
          "s": 20,
          "text": "דמדת הבינוני היא מדת כל אדם97."
        },
        {
          "s": 21,
          "text": "ויש לומר,"
        },
        {
          "s": 22,
          "text": "דזהו גם הקשר דנצח ישראל עם לולב ומיניו,"
        },
        {
          "s": 23,
          "text": "דהמינים שבלולב מורים על הסוגים דישראל98,"
        },
        {
          "s": 24,
          "text": "וגם סוג הכי תחתון שבישראל שנמשל לערבה שאין בה לא טעם ולא ריח יש בהם כח הנצחון,"
        },
        {
          "s": 25,
          "text": "ואדרבא,"
        },
        {
          "s": 26,
          "text": "דוקא בערבה כח הנצחון הוא ביותר"
        },
        {
          "s": 27,
          "text": "[וכידוע99"
        },
        {
          "s": 28,
          "text": "שנצח והוד הם בדי ערבות שאין בהם לא טעם ולא ריח],"
        },
        {
          "s": 29,
          "text": "וע\"י שהערבות מעוררים את כח הנצחון"
        },
        {
          "s": 30,
          "text": "(לנצח את היצר בעודו בתקפו ובגבורתו),"
        },
        {
          "s": 31,
          "text": "הם מתקשרים עם ההדסים והלולב100,"
        },
        {
          "s": 32,
          "text": "ועל ידם נמשך בהם גם מעין101"
        },
        {
          "s": 33,
          "text": "הענין דאתהפכא102,"
        },
        {
          "s": 34,
          "text": "ועי\"ז יודעים דישראל אינון נצוחייא103,"
        },
        {
          "s": 35,
          "text": "שהנצחון הוא בגילוי לעין כל."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ד)"
        },
        {
          "s": 2,
          "text": "וביאור העילוי דההמשכה"
        },
        {
          "s": 3,
          "text": "(בזבוז האוצרות)"
        },
        {
          "s": 4,
          "text": "שעל ידי העבודה דאתכפיא דוקא בפרטיות יותר,"
        },
        {
          "s": 5,
          "text": "יובן ע\"פ מ\"ש אדמו\"ר"
        },
        {
          "s": 6,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 7,
          "text": "נ\"ע104"
        },
        {
          "s": 8,
          "text": "בביאור המאמר כד אתכפיא סט\"א אסתלק יקרא דקוב\"ה בכולהו עלמין,"
        },
        {
          "s": 9,
          "text": "דהטעם על זה שע\"י אתכפיא סט\"א נמשך אור נעלה כזה שנק' בשם \"אסתלק\" להיותו אור מקיף \"שמסולק מבחי' הפנימיות\"105"
        },
        {
          "s": 10,
          "text": "הוא,"
        },
        {
          "s": 11,
          "text": "כי יתרון האור הוא מן החושך דוקא,"
        },
        {
          "s": 12,
          "text": "שע\"י בירור החושך נמשך תוספות אור,"
        },
        {
          "s": 13,
          "text": "שלמעלה מהאור שנמשך בסוד שרש שנמדד ונקצב לפי ערך העולמות."
        },
        {
          "s": 14,
          "text": "ומבאר שם,"
        },
        {
          "s": 15,
          "text": "דזהו הטעם על זה שהאדם מקבל חיות מהמאכלים דדצ\"ח,"
        },
        {
          "s": 16,
          "text": "דע\"י שפועל בעצמו שלא להימשך אחר התענוג הגשמי שבהמאכל אלא שכוונתו תהי' לשם שמים שבכח האכילה ילמד ויתפלל"
        },
        {
          "s": 17,
          "text": "[שבכדי שיפעול בעצמו שכוונתו בהאכילה תהי' באמת לשם שמים צ\"ל תחלה העבודה דתפלה בהתבוננות כזו שמובנת גם לנה\"ב,"
        },
        {
          "s": 18,
          "text": "שגם נה\"ב תבין ותשיג שצריך לרצות באלקות ולא בחומריות העולם],"
        },
        {
          "s": 19,
          "text": "שעי\"ז מברר את המאכל שמפריד ממנו את הרע ומעלה את הטוב,"
        },
        {
          "s": 20,
          "text": "הנה ע\"י בירור זה,"
        },
        {
          "s": 21,
          "text": "נמשך לו תוספות אור,"
        },
        {
          "s": 22,
          "text": "בחינת המקיף."
        },
        {
          "s": 23,
          "text": "וזהו כד אתכפיא סט\"א אסתלק יקרא דקוב\"ה בכולהו עלמין,"
        },
        {
          "s": 24,
          "text": "כי המשכת המקיף היא ע\"י בירור החושך דוקא."
        },
        {
          "s": 25,
          "text": "ולהעיר,"
        },
        {
          "s": 26,
          "text": "דמזה שמבאר שם שפירוש כד אתכפיא סט\"א הוא בירור החושך"
        },
        {
          "s": 27,
          "text": "[ובפרט מהדוגמא דבירור המאכל ע\"י שאוכל לשם שמים,"
        },
        {
          "s": 28,
          "text": "שזה בא לאחרי הבירור דנה\"ב ע\"י עבודת התפלה],"
        },
        {
          "s": 29,
          "text": "מובן,"
        },
        {
          "s": 30,
          "text": "שגם במאמר זה106"
        },
        {
          "s": 31,
          "text": "מפרש שהכוונה בכד אתכפיא סט\"א היא"
        },
        {
          "s": 32,
          "text": "(בעיקר)"
        },
        {
          "s": 33,
          "text": "לאתכפיא שמביא לידי אתהפכא."
        }
      ]
    }
  ]
}