{
  "globalIndex": 243,
  "owner": 43,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915244_theRebbe_950__p002",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915244_theRebbe_950__p002",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915244_theRebbe_950",
  "title": "מאמר פדה בשלום תשכ\"ב",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ומבאר שם11,"
        },
        {
          "s": 1,
          "text": "דאמיתית הענין דפדה בשלום נפשי הוא ע\"י גילוי היחידה דוקא."
        },
        {
          "s": 2,
          "text": "דביטול הרצונות דנה\"ב שע\"י האהבה שלמעלה מטו\"ד שמצד המקיף דחי' הוא רק מפני שהרצון דנה\"א"
        },
        {
          "s": 3,
          "text": "(דבחי' חי')"
        },
        {
          "s": 4,
          "text": "מתגבר על הרצון דנה\"ב."
        },
        {
          "s": 5,
          "text": "[אלא שמצד תוקף הרצון דנה\"א מתבטלים ממילא הרצונות דנה\"ב."
        },
        {
          "s": 6,
          "text": "דבהעבודה שע\"פ טעם ודעת שמצד בחינת נר\"נ,"
        },
        {
          "s": 7,
          "text": "הבירור דנה\"ב הוא ע\"י שנפש האלקית מתלבשת בנה\"ב ולוחמת עמה,"
        },
        {
          "s": 8,
          "text": "משא\"כ בבחי' חי',"
        },
        {
          "s": 9,
          "text": "ע\"י תוקף הרצון דנה\"א"
        },
        {
          "s": 10,
          "text": "(רצון שלמעלה מטעם),"
        },
        {
          "s": 11,
          "text": "מתבטלים הם"
        },
        {
          "s": 12,
          "text": "(הרצונות דנה\"ב)"
        },
        {
          "s": 13,
          "text": "ממילא."
        },
        {
          "s": 14,
          "text": "אבל מ\"מ הביטול שלהם הוא רק מצד התגברות נה\"א,"
        },
        {
          "s": 15,
          "text": "ולא שהם בטלים בעצם]."
        },
        {
          "s": 16,
          "text": "ולכן אין זה אמיתית ענין השלום."
        },
        {
          "s": 17,
          "text": "ואמיתית הענין דפדה בשלום נפשי הוא ע\"י גילוי היחידה."
        },
        {
          "s": 18,
          "text": "דכיון שבחינת היחידה אין כנגדה לעו\"ז,"
        },
        {
          "s": 19,
          "text": "בבואה דבבואה לית להו12,"
        },
        {
          "s": 20,
          "text": "לכן,"
        },
        {
          "s": 21,
          "text": "ביטול הרצונות דנה\"ב ע\"י גילוי היחידה הוא"
        },
        {
          "s": 22,
          "text": "(לא שע\"י גילוי היחידה נעשה ביטול הרצונות,"
        },
        {
          "s": 23,
          "text": "כי אם)"
        },
        {
          "s": 24,
          "text": "שמצד היחידה אין מקום מלכתחילה לרצונות זרים."
        },
        {
          "s": 25,
          "text": "וזהו פדה בשלום נפשי גו' כי ברבים היו עמדי,"
        },
        {
          "s": 26,
          "text": "דברבים היו עמדי הוא טעם"
        },
        {
          "s": 27,
          "text": "(כי)"
        },
        {
          "s": 28,
          "text": "על פדה בשלום נפשי,"
        },
        {
          "s": 29,
          "text": "כי העבודה דברבים היו עמדי היא התעוררות וגילוי היחידה"
        },
        {
          "s": 30,
          "text": "(כמבואר בארוכה בהמאמר13),"
        },
        {
          "s": 31,
          "text": "וע\"י גילוי היחידה,"
        },
        {
          "s": 32,
          "text": "הפדי' דנה\"א היא באופן דשלום,"
        },
        {
          "s": 33,
          "text": "פדה בשלום נפשי."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "וצריך להבין,"
        },
        {
          "s": 2,
          "text": "דכיון שע\"י גילוי היחידה"
        },
        {
          "s": 3,
          "text": "(העבודה דברבים היו עמדי)"
        },
        {
          "s": 4,
          "text": "אין מקום למנגדים,"
        },
        {
          "s": 5,
          "text": "הרי אין צריך אז לפדי',"
        },
        {
          "s": 6,
          "text": "ומזה שברבים היו עמדי הוא טעם על פדה בשלום נפשי"
        },
        {
          "s": 7,
          "text": "[דטעם הוא הסיבה שלפני הענין שמסובב ממנו],"
        },
        {
          "s": 8,
          "text": "משמע,"
        },
        {
          "s": 9,
          "text": "שגם לאחרי הענין דברבים היו עמדי"
        },
        {
          "s": 10,
          "text": "(גילוי היחידה)"
        },
        {
          "s": 11,
          "text": "צריכה נה\"א לפדי'"
        },
        {
          "s": 12,
          "text": "(אלא שהפדי' היא בשלום)."
        },
        {
          "s": 13,
          "text": "וביותר א\"מ,"
        },
        {
          "s": 14,
          "text": "דמזה שברבים היו עמדי הוא טעם על פדה בשלום נפשי מקרב לי,"
        },
        {
          "s": 15,
          "text": "משמע,"
        },
        {
          "s": 16,
          "text": "דנוסף לזה שגם לאחרי הענין דברבים היו עמדי צריכה נפש האלקית"
        },
        {
          "s": 17,
          "text": "(נפשי)"
        },
        {
          "s": 18,
          "text": "לפדי'"
        },
        {
          "s": 19,
          "text": "(סתם),"
        },
        {
          "s": 20,
          "text": "היא צריכה גם לפדי' מהמלחמות שכנגדה."
        },
        {
          "s": 21,
          "text": "ולכאורה,"
        },
        {
          "s": 22,
          "text": "הרי גם כשנה\"ב הוא כישן"
        },
        {
          "s": 23,
          "text": "(שאח\"כ יכול להיות חוזר וניעור14)"
        },
        {
          "s": 24,
          "text": "אינו לוחם בשעת מעשה כנגד נה\"א,"
        },
        {
          "s": 25,
          "text": "ומכש\"כ15"
        },
        {
          "s": 26,
          "text": "כשמתבטלים הרצונות דנה\"ב"
        },
        {
          "s": 27,
          "text": "(ע\"י הרצון דנה\"א דבחי' חי'),"
        },
        {
          "s": 28,
          "text": "והאיך שייך שגם לאחרי גילוי היחידה"
        },
        {
          "s": 29,
          "text": "(ברבים היו עמדי),"
        },
        {
          "s": 30,
          "text": "שאז אין מקום כלל להרצונות דנה\"ב,"
        },
        {
          "s": 31,
          "text": "צריכה נה\"א לפדי' ממלחמות שכנגדה."
        },
        {
          "s": 32,
          "text": "וי\"ל הביאור,"
        },
        {
          "s": 33,
          "text": "דזה שנאמר כי ברבים היו עמדי"
        },
        {
          "s": 34,
          "text": "[דמזה משמע"
        },
        {
          "s": 35,
          "text": "(כנ\"ל)"
        },
        {
          "s": 36,
          "text": "שפדה גו' מקרב לי הוא לאחרי ברבים היו עמדי]"
        },
        {
          "s": 37,
          "text": "הוא בכדי לרמז,"
        },
        {
          "s": 38,
          "text": "שגם מי שהוא בדרגא נמוכה,"
        },
        {
          "s": 39,
          "text": "שנפש האלקית"
        },
        {
          "s": 40,
          "text": "(לא רק הדרגא דיחידה,"
        },
        {
          "s": 41,
          "text": "אלא נה\"א בכלל)"
        },
        {
          "s": 42,
          "text": "אצלו היא בהעלם,"
        },
        {
          "s": 43,
          "text": "ועד שנפש הבהמית לוחמת כנגד נפשו האלקית,"
        },
        {
          "s": 44,
          "text": "מ\"מ,"
        },
        {
          "s": 45,
          "text": "ע\"י המחשבה בענין היחידה"
        },
        {
          "s": 46,
          "text": "[וההחלטה שההנהגה שלו תהי' בהתאם לבחי' היחידה שבנפשו]16,"
        },
        {
          "s": 47,
          "text": "ברבים היו עמדי,"
        },
        {
          "s": 48,
          "text": "פדיית נפשו האלקית מהמלחמות דנה\"ב"
        },
        {
          "s": 49,
          "text": "(פדה נפשי מקרב לי)"
        },
        {
          "s": 50,
          "text": "היא באופן דשלום."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים מ\"ש"
        },
        {
          "s": 2,
          "text": "(בפרשתנו17)"
        },
        {
          "s": 3,
          "text": "ושבתי בשלום אל בית אבי,"
        },
        {
          "s": 4,
          "text": "ומבאר בעל הגאולה18,"
        },
        {
          "s": 5,
          "text": "דהליכת יעקב לחרן היתה בכדי לברר את הניצוצות שהיו שם,"
        },
        {
          "s": 6,
          "text": "וזהו שאמר ושבתי בשלום אל בית אבי,"
        },
        {
          "s": 7,
          "text": "שבירור הניצוצות והשבתם"
        },
        {
          "s": 8,
          "text": "(החזרתם)"
        },
        {
          "s": 9,
          "text": "לשרשם"
        },
        {
          "s": 10,
          "text": "(אל בית אבי)"
        },
        {
          "s": 11,
          "text": "יהי' באופן דשלום."
        },
        {
          "s": 12,
          "text": "ומוסיף בהמאמר19,"
        },
        {
          "s": 13,
          "text": "דפירוש בשלום הוא ב' שלום,"
        },
        {
          "s": 14,
          "text": "שלום מלמעלה למטה ושלום מלמטה למעלה."
        },
        {
          "s": 15,
          "text": "ויש לומר עד\"ז בנוגע לתיבת בשלום שבפסוק פדה בשלום נפשי,"
        },
        {
          "s": 16,
          "text": "דבשלום הוא ב' שלום20,"
        },
        {
          "s": 17,
          "text": "מלמעלה למטה ומלמטה למעלה."
        },
        {
          "s": 18,
          "text": "ויש לקשר זה עם הפסוק21"
        },
        {
          "s": 19,
          "text": "וכל בניך לימודי הוי' ורב שלום בניך,"
        },
        {
          "s": 20,
          "text": "דיש לומר,"
        },
        {
          "s": 21,
          "text": "שענין ריבוי שלום"
        },
        {
          "s": 22,
          "text": "(ורב שלום),"
        },
        {
          "s": 23,
          "text": "אין ריבוי פחות משנים,"
        },
        {
          "s": 24,
          "text": "הוא ב' בחינות דשלום,"
        },
        {
          "s": 25,
          "text": "שלום מלמעלה למטה ושלום מלמטה למעלה."
        }
      ]
    }
  ]
}