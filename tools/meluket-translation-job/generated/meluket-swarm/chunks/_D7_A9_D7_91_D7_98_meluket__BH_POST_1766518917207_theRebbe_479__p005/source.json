{
  "globalIndex": 604,
  "owner": 4,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917207_theRebbe_479__p005",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917207_theRebbe_479__p005",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518917207_theRebbe_479",
  "title": "מאמר ואלה המשפטים תשמ\"א",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יובן מה שהתחלת הפרשה היא בדין עבד עברי,"
        },
        {
          "s": 2,
          "text": "אף שעיקר ענין העבדות הוא בעבד כנעני"
        },
        {
          "s": 3,
          "text": "(כנ\"ל סעיף ב),"
        },
        {
          "s": 4,
          "text": "כי השלימות דענין העבדות"
        },
        {
          "s": 5,
          "text": "(קבלת עול)"
        },
        {
          "s": 6,
          "text": "הוא שהביטול דעבדות יהי' בתענוג ובחיות,"
        },
        {
          "s": 7,
          "text": "וענין זה הוא בעבד עברי דוקא."
        },
        {
          "s": 8,
          "text": "ויובן זה ע\"פ מ\"ש אדמו\"ר הזקן בד\"ה וכי ימכור איש את בתו לאמה56"
        },
        {
          "s": 9,
          "text": "[והצ\"צ כותב57"
        },
        {
          "s": 10,
          "text": "על מאמר זה שהוא דרוש נכבד מאד מדבר מענין צדיק רשע ובינוני],"
        },
        {
          "s": 11,
          "text": "דג' מיני העבדים שבפרשת משפטים,"
        },
        {
          "s": 12,
          "text": "עבד כנעני עבד עברי ואמה העברי',"
        },
        {
          "s": 13,
          "text": "הם ג' מדריגות בעבודת הוי'."
        },
        {
          "s": 14,
          "text": "עבד כנעני הוא שהרצון והתענוג שלו הם בפריקת עול,"
        },
        {
          "s": 15,
          "text": "כמארז\"ל58"
        },
        {
          "s": 16,
          "text": "עבדא בהפקירא ניחא לי',"
        },
        {
          "s": 17,
          "text": "שהנח\"ר שלו"
        },
        {
          "s": 18,
          "text": "(ניחא)"
        },
        {
          "s": 19,
          "text": "הוא בהפקירות,"
        },
        {
          "s": 20,
          "text": "פריקת עול,"
        },
        {
          "s": 21,
          "text": "ועבודתו את השם הוא רק מצד ההכרח,"
        },
        {
          "s": 22,
          "text": "מחמת אימת הכאת השבט,"
        },
        {
          "s": 23,
          "text": "דענין הכאת השבט ברוחניות הוא שמאיר בו נפשו האלקית"
        },
        {
          "s": 24,
          "text": "(אלא שהגילוי דנפש האלקית הוא רק בנוגע לעשי' בפועל)."
        },
        {
          "s": 25,
          "text": "[ומבאר שם59,"
        },
        {
          "s": 26,
          "text": "שבעבד"
        },
        {
          "s": 27,
          "text": "(כנעני)"
        },
        {
          "s": 28,
          "text": "נכלל גם רשע וטוב לו."
        },
        {
          "s": 29,
          "text": "דכמו שבעבד כפשוטו,"
        },
        {
          "s": 30,
          "text": "אפשר שהעבד יחטא לרבו ואעפ\"כ כשרבו מכהו בשבט הוא חוזר לעבודתו,"
        },
        {
          "s": 31,
          "text": "עד\"ז הוא בעבודת ה',"
        },
        {
          "s": 32,
          "text": "דגם מי שמצד התענוג שלו בפריקת עול הוא עובר על מצוות השם,"
        },
        {
          "s": 33,
          "text": "מ\"מ,"
        },
        {
          "s": 34,
          "text": "כיון שאח\"כ,"
        },
        {
          "s": 35,
          "text": "כשמאיר בו גילוי נפשו האלקית"
        },
        {
          "s": 36,
          "text": "(הכאת השבט)"
        },
        {
          "s": 37,
          "text": "הוא מתחרט על חטאיו,"
        },
        {
          "s": 38,
          "text": "לא יצא מכלל עבד."
        },
        {
          "s": 39,
          "text": "ולאידך,"
        },
        {
          "s": 40,
          "text": "גם הבינוני"
        },
        {
          "s": 41,
          "text": "(דרגא תחתונה שבבינוני)"
        },
        {
          "s": 42,
          "text": "נכלל בעבד כנעני."
        },
        {
          "s": 43,
          "text": "דהגם שלא עבר עבירה מימיו60,"
        },
        {
          "s": 44,
          "text": "מ\"מ,"
        },
        {
          "s": 45,
          "text": "כיון שהרצון והתענוג שלו הוא בתאוות עוה\"ז ועבודתו את השם הוא רק מצד ההכרח"
        },
        {
          "s": 46,
          "text": "(אלא שהגילוי דנפש האלקית מכריח אותו להיות סור מרע ועשה טוב במשך כל היום כולו),"
        },
        {
          "s": 47,
          "text": "לא יצא מכלל עבד כנעני]."
        },
        {
          "s": 48,
          "text": "ועבד עברי הוא שהרצון והתענוג שלו הוא"
        },
        {
          "s": 49,
          "text": "(בעיקר)"
        },
        {
          "s": 50,
          "text": "בעבודת השם,"
        },
        {
          "s": 51,
          "text": "והענינים דפריקת עול"
        },
        {
          "s": 52,
          "text": "(כולל התענוג בעניני עוה\"ז)"
        },
        {
          "s": 53,
          "text": "הם אצלו יסורים גדולים וצער61."
        },
        {
          "s": 54,
          "text": "והגם שכשבאים לו עניני עוה\"ז הוא מתענג מהם,"
        },
        {
          "s": 55,
          "text": "רצונו הוא שלא להמשך אחריהם."
        },
        {
          "s": 56,
          "text": "והוא מתמרמר על זה שהתענג בעניני עוה\"ז."
        },
        {
          "s": 57,
          "text": "[והוא עיקר מדריגת הבינוני]."
        },
        {
          "s": 58,
          "text": "ואמה העברי' היא מדריגת צדיק,"
        },
        {
          "s": 59,
          "text": "שהמדות שלו נהפכו לקדושה"
        },
        {
          "s": 60,
          "text": "(אתהפכא שלמעלה מאתכפיא),"
        },
        {
          "s": 61,
          "text": "כמבואר שם בארוכה."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "וזהו שבפרשת משפטים מדובר בקנין עבד עברי ואמה העברי'"
        },
        {
          "s": 1,
          "text": "[כי תקנה עבד עברי גו' וכי ימכור איש את בתו לאמה62"
        },
        {
          "s": 2,
          "text": "גו'],"
        },
        {
          "s": 3,
          "text": "והענין דעבד כנעני"
        },
        {
          "s": 4,
          "text": "(בהפרשיות שמדברים בקניני עבד63),"
        },
        {
          "s": 5,
          "text": "לא תצא כצאת העבדים62,"
        },
        {
          "s": 6,
          "text": "הוא רק כמו בדרך אגב"
        },
        {
          "s": 7,
          "text": "(ובאופן שלילי),"
        },
        {
          "s": 8,
          "text": "כי זה שהתחלת פרשת משפטים היא בדיני עבד הוא מפני שבפרשה זו"
        },
        {
          "s": 9,
          "text": "[שהיא בהמשך למתן תורה,"
        },
        {
          "s": 10,
          "text": "מה הראשונים מסיני אף אלו מסיני]"
        },
        {
          "s": 11,
          "text": "מדבר בכללות הענין דעבודת ה',"
        },
        {
          "s": 12,
          "text": "שצריכה להיות בדרך עבודת עבד,"
        },
        {
          "s": 13,
          "text": "וכיון שהעבדות צריכה להיות בתענוג וחיות,"
        },
        {
          "s": 14,
          "text": "לכן מדבר בדיני עבד עברי ואמה העברי'."
        },
        {
          "s": 15,
          "text": "בתחלה מדבר בעבד עברי,"
        },
        {
          "s": 16,
          "text": "מדריגת הבינוני,"
        },
        {
          "s": 17,
          "text": "כי מדת הבינוני היא מדת כל אדם ואחרי' כל אדם ימשוך64."
        },
        {
          "s": 18,
          "text": "ואח\"כ מדבר באמה העברי',"
        },
        {
          "s": 19,
          "text": "מדריגת צדיק,"
        },
        {
          "s": 20,
          "text": "שגם עבודה זו שייכת לכל אחד,"
        },
        {
          "s": 21,
          "text": "כמבואר בתניא65,"
        },
        {
          "s": 22,
          "text": "דגם כשיודע בנפשו שלא יגיע למדריגה זו באמת לאמיתו מ\"מ הוא יעשה את שלו לקיים את השבועה שמשביעין אותו תהי צדיק."
        },
        {
          "s": 23,
          "text": "ויש לומר דזה שמדבר"
        },
        {
          "s": 24,
          "text": "[כמו בדרך אגב עכ\"פ]"
        },
        {
          "s": 25,
          "text": "גם בעבד כנעני,"
        },
        {
          "s": 26,
          "text": "הוא מצד המעלה דאתכפיא."
        },
        {
          "s": 27,
          "text": "וכמ\"ש אדמו\"ר הזקן בדרוש הנ\"ל66,"
        },
        {
          "s": 28,
          "text": "שגם בצדיק גמור צריכה להיות העבודה דעבד כנעני,"
        },
        {
          "s": 29,
          "text": "מצד המעלה שבאתכפיא."
        },
        {
          "s": 30,
          "text": "דזהו שארז\"ל67"
        },
        {
          "s": 31,
          "text": "אל יאמר אדם אי אפשי כו' אלא אפשי ומה אעשה ואבי שבשמים גזר עלי,"
        },
        {
          "s": 32,
          "text": "דזה שצריך לומר אפשי כו' הוא בכדי שתהי' אצלו העבודה דאתכפיא."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "ולהעיר,"
        },
        {
          "s": 3,
          "text": "דבאתכפיא זו הוא רק המעלה דאתכפיא."
        },
        {
          "s": 4,
          "text": "דהגם שבזה שאומר אפשי הוא רחוק מאד מאלקות68,"
        },
        {
          "s": 5,
          "text": "הרי זה שאומר אפשי הוא מצד ציווי התורה,"
        },
        {
          "s": 6,
          "text": "וכוונתו בזה שאומר אפשי ומעורר רצון לזה69"
        },
        {
          "s": 7,
          "text": "הוא בכדי שתהי' אצלו העבודה דאתכפיא"
        },
        {
          "s": 8,
          "text": "(שיעשה נגד רצונו)."
        },
        {
          "s": 9,
          "text": "ועפ\"ז מובן,"
        },
        {
          "s": 10,
          "text": "דזה שעבודת הצדיקים היא לא מצד ההכרח אלא שזהו התענוג שלהם,"
        },
        {
          "s": 11,
          "text": "הוא גם בנוגע להעבודה דאתכפיא שלהם."
        },
        {
          "s": 12,
          "text": "דהגם שהיא אתכפיא באמת,"
        },
        {
          "s": 13,
          "text": "כי זה שאומרים אפשי הוא שמעוררים הרצון שלהם לזה,"
        },
        {
          "s": 14,
          "text": "אלא שכופין את עצמם ועושים נגד רצונם,"
        },
        {
          "s": 15,
          "text": "זה גופא הוא התענוג שלהם,"
        },
        {
          "s": 16,
          "text": "כיון שהכוונה בהרצון שלהם היא בכדי שיעשו נגד רצונם."
        }
      ]
    }
  ]
}