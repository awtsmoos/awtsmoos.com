{
  "globalIndex": 146,
  "owner": 46,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914548_theRebbe_632__p001",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914548_theRebbe_632__p001",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914548_theRebbe_632",
  "title": "מאמר ביום השמיני תשמ\"א",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "יום שמחת תורה ה'תשמ\"א"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "ביום השמיני שלח את העם ויברכו את המלך וילכו לאהליהם שמחים וטובי לב על כל הטובה אשר עשה ה' לדוד עבדו ולישראל עמו1,"
        },
        {
          "s": 1,
          "text": "הנה פסוק זה הוא סיום וחותם ההפטורה דשמיני עצרת."
        },
        {
          "s": 2,
          "text": "דמזה מובן,"
        },
        {
          "s": 3,
          "text": "דהגם ש\"שלח"
        },
        {
          "s": 4,
          "text": "(המלך)"
        },
        {
          "s": 5,
          "text": "את העם ויברכו את המלך גו'\" בפשטות הי' רק פעם אחת,"
        },
        {
          "s": 6,
          "text": "בשמיני עצרת שלאחרי חנוכת בית המקדש"
        },
        {
          "s": 7,
          "text": "[משא\"כ בהשנים שלאח\"ז,"
        },
        {
          "s": 8,
          "text": "לא מצינו שהוצרכו ליטול רשות מהמלך2"
        },
        {
          "s": 9,
          "text": "(ולברך אותו)"
        },
        {
          "s": 10,
          "text": "ללכת מביהמ\"ק לאהליהם],"
        },
        {
          "s": 11,
          "text": "מ\"מ הענין ברוחניות הוא בשמיני עצרת דכל שנה ושנה."
        },
        {
          "s": 12,
          "text": "וכמבואר בלקו\"ת3"
        },
        {
          "s": 13,
          "text": "ובכמה דרושים ד\"ה זה4,"
        },
        {
          "s": 14,
          "text": "דבשמיני עצרת הוא הקליטה"
        },
        {
          "s": 15,
          "text": "(עצרת מלשון קליטה5)"
        },
        {
          "s": 16,
          "text": "של כל הענינים דחודש תשרי,"
        },
        {
          "s": 17,
          "text": "מתחיל מענין דתמליכוני עליכם שבראש השנה6."
        },
        {
          "s": 18,
          "text": "ועד שאחד הפירושים בשמיני עצרת הוא מלשון מלוכה"
        },
        {
          "s": 19,
          "text": "(כמו זה7"
        },
        {
          "s": 20,
          "text": "יעצור בעמי)8,"
        },
        {
          "s": 21,
          "text": "דמזה מובן,"
        },
        {
          "s": 22,
          "text": "דענין המלכות בשמיני עצרת הוא מעניניו העיקריים."
        },
        {
          "s": 23,
          "text": "וזהו שהענין ד\"שלח"
        },
        {
          "s": 24,
          "text": "(המלך)"
        },
        {
          "s": 25,
          "text": "את העם גו'\" הוא בשמיני עצרת בכל שנה ושנה,"
        },
        {
          "s": 26,
          "text": "דבשמיני עצרת נמשך קבלת עול מלכות שמים על כל השנה9."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "והנה בדברי הימים10"
        },
        {
          "s": 1,
          "text": "כתיב וביום עשרים ושלשה לחודש השביעי שלח את העם גו',"
        },
        {
          "s": 2,
          "text": "ומבאר אדמו\"ר הצ\"צ בהגהותיו ללקו\"ת ד\"ה זה11,"
        },
        {
          "s": 3,
          "text": "שזה רמז ליו\"ט שני של גליות"
        },
        {
          "s": 4,
          "text": "(דיו\"ט שני דשמיני עצרת הוא בכ\"ג בתשרי)."
        },
        {
          "s": 5,
          "text": "וצריך להבין,"
        },
        {
          "s": 6,
          "text": "הרי בשמיני עצרת יש כמה ענינים,"
        },
        {
          "s": 7,
          "text": "ומדוע הרמז דיו\"ט שני דשמיני עצרת הוא בהענין דשלח את העם דוקא."
        },
        {
          "s": 8,
          "text": "גם צריך להבין מה שבדברי הימים שם נאמר על הטובה אשר עשה ה' לדוד ולשלמה גו'."
        },
        {
          "s": 9,
          "text": "דיש לומר,"
        },
        {
          "s": 10,
          "text": "דב' שינויים אלו"
        },
        {
          "s": 11,
          "text": "[שבדברי הימים כתיב וביום עשרים ושלשה גו',"
        },
        {
          "s": 12,
          "text": "ושמוסיף שם ולשלמה]"
        },
        {
          "s": 13,
          "text": "שייכים זל\"ז."
        },
        {
          "s": 14,
          "text": "היינו,"
        },
        {
          "s": 15,
          "text": "דענין שלח את העם שביום השמיני"
        },
        {
          "s": 16,
          "text": "(יו\"ט ראשון דשמיני עצרת)"
        },
        {
          "s": 17,
          "text": "שייך לדוד,"
        },
        {
          "s": 18,
          "text": "וענין שלח את העם שביום עשרים ושלשה לחודש השביעי"
        },
        {
          "s": 19,
          "text": "(יו\"ט שני דשמיני עצרת)"
        },
        {
          "s": 20,
          "text": "שייך לדוד ולשלמה."
        }
      ]
    }
  ]
}