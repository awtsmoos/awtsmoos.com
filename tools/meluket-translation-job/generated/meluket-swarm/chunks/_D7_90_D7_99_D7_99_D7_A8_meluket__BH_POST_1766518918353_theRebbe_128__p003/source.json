{
  "globalIndex": 772,
  "owner": 22,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918353_theRebbe_128__p003",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918353_theRebbe_128__p003",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918353_theRebbe_128",
  "title": "מאמר גן נעול תשמ\"ז",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "שזהו גם מהטעמים על זה שקודם חג השבועות זמן מתן תורתינו ישנם כו\"כ מצוות מיוחדות,"
        },
        {
          "s": 2,
          "text": "המצוות דחג הפסח ומצות ספירת העומר."
        },
        {
          "s": 3,
          "text": "דכמו שבכל יום,"
        },
        {
          "s": 4,
          "text": "כשהאדם נעשה ברי' חדשה26,"
        },
        {
          "s": 5,
          "text": "(עיקר)"
        },
        {
          "s": 6,
          "text": "לימוד התורה הוא לאחרי קיום כו\"כ מצוות"
        },
        {
          "s": 7,
          "text": "(ק\"ש,"
        },
        {
          "s": 8,
          "text": "תפילין,"
        },
        {
          "s": 9,
          "text": "תפלה וכו')27,"
        },
        {
          "s": 10,
          "text": "עד\"ז הוא בזמני השנה,"
        },
        {
          "s": 11,
          "text": "שבחג הפסח בכל שנה ושנה הוא לידת ישראל28,"
        },
        {
          "s": 12,
          "text": "שלאחרי קיום המצוות המיוחדות דזמנים אלו"
        },
        {
          "s": 13,
          "text": "(מצוות דחג הפסח ודימי ספירת העומר)"
        },
        {
          "s": 14,
          "text": "הוא זמן מתן תורתינו."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 2,
          "text": "דכמו שקידושי איש ואשה כפשוטם הוא ע\"י שהאיש נותן לה דבר"
        },
        {
          "s": 3,
          "text": "(פרוטה או שוה פרוטה)"
        },
        {
          "s": 4,
          "text": "שבו היא יכולה לקנות חיי נפשה,"
        },
        {
          "s": 5,
          "text": "עד\"ז הוא בנוגע לזה שהקב\"ה קדשנו במצותיו,"
        },
        {
          "s": 6,
          "text": "שע\"י קיום המצוות נמשך חיות להאדם שמקיים המצוות,"
        },
        {
          "s": 7,
          "text": "כמ\"ש29"
        },
        {
          "s": 8,
          "text": "אשר יעשה אותם האדם וחי בהם."
        },
        {
          "s": 9,
          "text": "והגם שהמצוות הם רצון העליון,"
        },
        {
          "s": 10,
          "text": "דרצון הוא בחינת סובב שמצד עצמו הוא קדוש ומובדל מהעולמות,"
        },
        {
          "s": 11,
          "text": "מ\"מ,"
        },
        {
          "s": 12,
          "text": "נמשך מאור זה חיות להאדם שמקיים המצוות,"
        },
        {
          "s": 13,
          "text": "חיות פנימי30."
        },
        {
          "s": 14,
          "text": "וכמובן גם מזה שהאור שנמשך ע\"י המצוות פועל"
        },
        {
          "s": 15,
          "text": "(לא רק במחשבה דיבור ומעשה שלו,"
        },
        {
          "s": 16,
          "text": "אלא)"
        },
        {
          "s": 17,
          "text": "גם בהמדות ועד בהרצון ותענוג שבו,"
        },
        {
          "s": 18,
          "text": "וכמובא לעיל"
        },
        {
          "s": 19,
          "text": "(סעיף א-ב)"
        },
        {
          "s": 20,
          "text": "מהמאמר,"
        },
        {
          "s": 21,
          "text": "שע\"י המצוות נעשה מובדל מהתאוות ומכל מדות הרעות,"
        },
        {
          "s": 22,
          "text": "ושענין אוגדין פתחיהן"
        },
        {
          "s": 23,
          "text": "(שנעשה ע\"י המצוות)"
        },
        {
          "s": 24,
          "text": "הוא שאין לו תענוג אלא באלקות."
        },
        {
          "s": 25,
          "text": "אלא שכל זה הוא רק בחיצוניות הלב ולא נקלט עדיין בתוך תוך עומק לבבו."
        },
        {
          "s": 26,
          "text": "ולכן נק' ארוסה31."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש לבאר פירוש התרגום שגן נעול קאי על גן עדן שא\"א ליכנס בו כ\"א נפשות הצדיקים,"
        },
        {
          "s": 1,
          "text": "כי הענין דאוגדין פתחיהן באופן הנ\"ל שגם התענוג שלו הוא רק באלקות,"
        },
        {
          "s": 2,
          "text": "הוא ע\"י המשכת האור מלמעלה"
        },
        {
          "s": 3,
          "text": "(ע\"י קיום המצוות),"
        },
        {
          "s": 4,
          "text": "ולכן המשל על זה הוא מגן עדן,"
        },
        {
          "s": 5,
          "text": "תענוג אלקי"
        },
        {
          "s": 6,
          "text": "(שמלמעלה)32."
        },
        {
          "s": 7,
          "text": "ויש לומר,"
        },
        {
          "s": 8,
          "text": "דזה שמביא בהמאמר"
        },
        {
          "s": 9,
          "text": "(בתחלתו)"
        },
        {
          "s": 10,
          "text": "פירוש התרגום,"
        },
        {
          "s": 11,
          "text": "הוא,"
        },
        {
          "s": 12,
          "text": "כי פירוש זה הוא היסוד להביאור שבהמאמר שאוגדין פתחיהן הו\"ע קדשנו במצותיך."
        }
      ]
    }
  ]
}