{
  "globalIndex": 650,
  "owner": 0,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917575_theRebbe_481__p003",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917575_theRebbe_481__p003",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917575_theRebbe_481",
  "title": "מאמר אלה פקודי תש\"ל",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ולהוסיף,"
        },
        {
          "s": 1,
          "text": "דזה שהשכל הוא למעלה משייכות לזולת,"
        },
        {
          "s": 2,
          "text": "הכוונה בזה היא לא רק לזולת שמחוץ להאדם,"
        },
        {
          "s": 3,
          "text": "אלא גם להענינים שבאדם עצמו שהם \"זולת\" לגבי השכל."
        },
        {
          "s": 4,
          "text": "ולכן,"
        },
        {
          "s": 5,
          "text": "בכדי לבוא על דבר שכל צריך לצמצם ולהעלים כל הכחות"
        },
        {
          "s": 6,
          "text": "(גם הרצון להבין את השכל)34,"
        },
        {
          "s": 7,
          "text": "כי כיון שהם זולת לגבי השכל,"
        },
        {
          "s": 8,
          "text": "הם מבלבלים להבנת השכל"
        },
        {
          "s": 9,
          "text": "(כמו הזולת שמחוץ להאדם)."
        },
        {
          "s": 10,
          "text": "ועד\"ז לאידך,"
        },
        {
          "s": 11,
          "text": "דגם כשהוא מבין את השכל,"
        },
        {
          "s": 12,
          "text": "ההשגה היא בריחוק ובהבדלה משאר הענינים והכחות שבאדם35,"
        },
        {
          "s": 13,
          "text": "ועד שאפשר שההשגה לא תפעול עליו."
        },
        {
          "s": 14,
          "text": "וזה שהשגת השכל מביאה"
        },
        {
          "s": 15,
          "text": "(בכלל)"
        },
        {
          "s": 16,
          "text": "למדות שבלב ועד למעשה בפועל"
        },
        {
          "s": 17,
          "text": "(גדול תלמוד שמביא לידי מעשה36),"
        },
        {
          "s": 18,
          "text": "הוא"
        },
        {
          "s": 19,
          "text": "[לא מפני שענין השכל הוא לפעול בהמדות ובהמעשה,"
        },
        {
          "s": 20,
          "text": "אלא]"
        },
        {
          "s": 21,
          "text": "לפי שהשכל הוא בדוגמת אור,"
        },
        {
          "s": 22,
          "text": "שמאיר בכל מקום37."
        },
        {
          "s": 23,
          "text": "ומזה מובן,"
        },
        {
          "s": 24,
          "text": "דבפעולת השכל על כל הכחות והענינים שבאדם,"
        },
        {
          "s": 25,
          "text": "אין מתגלה ענינו של השכל38."
        },
        {
          "s": 26,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 27,
          "text": "דזה שהמוחין הם נסתרות,"
        },
        {
          "s": 28,
          "text": "הוא,"
        },
        {
          "s": 29,
          "text": "שהם בהעלם גם מהענינים והכחות שבהאדם עצמו."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וזהו אלה פקודי המשכן משכן העדות אשר פוקד על פי משה,"
        },
        {
          "s": 2,
          "text": "משכן סתם הוא עבודת הלב,"
        },
        {
          "s": 3,
          "text": "ולכן נאמר המשכן בה' הידיעה,"
        },
        {
          "s": 4,
          "text": "כי מדות שבלב הם בחינת גילוי."
        },
        {
          "s": 5,
          "text": "ומשכן העדות,"
        },
        {
          "s": 6,
          "text": "דענין העדות הוא על דבר הנעלם דוקא"
        },
        {
          "s": 7,
          "text": "(כמבואר בלקו\"ת39),"
        },
        {
          "s": 8,
          "text": "הוא עבודת המוח,"
        },
        {
          "s": 9,
          "text": "שהמוחין הם בחי' העלם."
        },
        {
          "s": 10,
          "text": "[ולהוסיף,"
        },
        {
          "s": 11,
          "text": "דבמוחין עצמם,"
        },
        {
          "s": 12,
          "text": "עיקר הענין דמשכן העדות"
        },
        {
          "s": 13,
          "text": "(שעדות הוא בדבר הנעלם)"
        },
        {
          "s": 14,
          "text": "הוא בפנימיות המוחין שלמעלה משייכות למדות]."
        },
        {
          "s": 15,
          "text": "וענין משכן העדות הוא,"
        },
        {
          "s": 16,
          "text": "שההשגה באלקות"
        },
        {
          "s": 17,
          "text": "[כולל גם ההשגה דפנימיות המוחין]"
        },
        {
          "s": 18,
          "text": "מתאחדת עם האדם המשיג,"
        },
        {
          "s": 19,
          "text": "ועד שמציאותו הוא זה שהוא משכן העדות – משכן ומכון להאור האלקי שמאיר במוחין שלמעלה מהאור שמאיר במדות."
        },
        {
          "s": 20,
          "text": "וזהו שגבי משכן העדות נאמר אשר פוקד על פי משה,"
        },
        {
          "s": 21,
          "text": "כי בכדי שהאדם יהי' משכן לאור זה,"
        },
        {
          "s": 22,
          "text": "הוא ע\"י בחינת משה שבכל אחד מישראל40."
        },
        {
          "s": 23,
          "text": "ואין מקרא יוצא מידי פשוטו,"
        },
        {
          "s": 24,
          "text": "דאשר פוקד על פי משה קאי"
        },
        {
          "s": 25,
          "text": "(גם)"
        },
        {
          "s": 26,
          "text": "על אלה פקודי המשכן"
        },
        {
          "s": 27,
          "text": "(כנ\"ל סעיף א),"
        },
        {
          "s": 28,
          "text": "כי ע\"י העבודה דמשכן העדות"
        },
        {
          "s": 29,
          "text": "(מוחין),"
        },
        {
          "s": 30,
          "text": "גם המדות"
        },
        {
          "s": 31,
          "text": "(משכן סתם)"
        },
        {
          "s": 32,
          "text": "הם באופן אחר41"
        },
        {
          "s": 33,
          "text": "[וכמשנת\"ל סעיף ה שהמוחין הם דוגמת אור שמאיר בכל מקום]."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "והנה ידוע42"
        },
        {
          "s": 2,
          "text": "שהמעלה דעבודת התשובה לגבי עבודת הצדיקים היא,"
        },
        {
          "s": 3,
          "text": "שעבודת הצדיקים היא בסדר והדרגה,"
        },
        {
          "s": 4,
          "text": "ועבודת התשובה היא לדלג שור,"
        },
        {
          "s": 5,
          "text": "שלא בהדרגה."
        },
        {
          "s": 6,
          "text": "ויש לומר,"
        },
        {
          "s": 7,
          "text": "שמהביאורים בזה שתשובה"
        },
        {
          "s": 8,
          "text": "(דוקא)"
        },
        {
          "s": 9,
          "text": "היא בבינה"
        },
        {
          "s": 10,
          "text": "(כנ\"ל סעיף ב),"
        },
        {
          "s": 11,
          "text": "אף שגם בעבודת הצדיקים ישנה גם עבודה שמצד המוחין"
        },
        {
          "s": 12,
          "text": "(כולל העבודה שמצד פנימיות המוחין),"
        },
        {
          "s": 13,
          "text": "הוא,"
        },
        {
          "s": 14,
          "text": "כי עיקר מעלת המוחין על המדות הוא שהאור דמוחין הוא למעלה ובהבדלה ממציאותו של האדם"
        },
        {
          "s": 15,
          "text": "(כנ\"ל סעיף ה),"
        },
        {
          "s": 16,
          "text": "ולכן,"
        },
        {
          "s": 17,
          "text": "ענין המוחין"
        },
        {
          "s": 18,
          "text": "(בינה)"
        },
        {
          "s": 19,
          "text": "הוא"
        },
        {
          "s": 20,
          "text": "(בעיקר)"
        },
        {
          "s": 21,
          "text": "בעבודת התשובה,"
        },
        {
          "s": 22,
          "text": "הדילוג והיציאה ממציאות."
        },
        {
          "s": 23,
          "text": "ועפ\"ז,"
        },
        {
          "s": 24,
          "text": "שני הענינים שבמשכן הם עבודת הצדיקים ועבודת התשובה."
        },
        {
          "s": 25,
          "text": "דעבודת הצדיקים"
        },
        {
          "s": 26,
          "text": "(גם עבודת המוחין)"
        },
        {
          "s": 27,
          "text": "הוא משכן סתם,"
        },
        {
          "s": 28,
          "text": "ומשכן העדות הוא עבודת התשובה."
        },
        {
          "s": 29,
          "text": "והקשר דשני הפירושים באשר פוקד על פי משה"
        },
        {
          "s": 30,
          "text": "(לפי ביאור זה)"
        },
        {
          "s": 31,
          "text": "יש לומר,"
        },
        {
          "s": 32,
          "text": "דענינו של משה הוא ביטול במציאות,"
        },
        {
          "s": 33,
          "text": "ונחנו מה43,"
        },
        {
          "s": 34,
          "text": "ולכן עיקר הענין דפוקד על פי משה הוא במשכן העדות."
        },
        {
          "s": 35,
          "text": "אלא שאעפ\"כ שייך זה גם לאלה פקודי המשכן,"
        },
        {
          "s": 36,
          "text": "כי ע\"י התשובה,"
        },
        {
          "s": 37,
          "text": "גם קיום התומ\"צ הוא באופן נעלה יותר."
        },
        {
          "s": 38,
          "text": "וכפירוש הידוע44"
        },
        {
          "s": 39,
          "text": "בלשון רז\"ל45"
        },
        {
          "s": 40,
          "text": "תשובה ומעשים טובים,"
        },
        {
          "s": 41,
          "text": "שע\"י התשובה נעשים המעשים"
        },
        {
          "s": 42,
          "text": "(מעשה המצוות)"
        },
        {
          "s": 43,
          "text": "מעשים טובים ומאירים."
        }
      ]
    }
  ]
}