{
  "globalIndex": 66,
  "owner": 16,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914059_theRebbe_310__p004",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914059_theRebbe_310__p004",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914059_theRebbe_310",
  "title": "מאמר שובה ישראל תשל\"ז",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "שגם ביום הכיפורים ישנם שני הענינים,"
        },
        {
          "s": 3,
          "text": "הגילוי דעצם הנשמה שמקושרת עם העצמות,"
        },
        {
          "s": 4,
          "text": "וזה שענין זה מתגלה בדרגות הפרטיות דהנשמה,"
        },
        {
          "s": 5,
          "text": "עד לדרגת נפש שבה,"
        },
        {
          "s": 6,
          "text": "שעי\"ז מתגלית הכפרה"
        },
        {
          "s": 7,
          "text": "(שבאופן הנ\"ל)"
        },
        {
          "s": 8,
          "text": "גם בהדרגות דהנשמה ששייך בהם פגם."
        },
        {
          "s": 9,
          "text": "וזהו שיום הכפורים הוא יום שנתחייב בה' תפלות32,"
        },
        {
          "s": 10,
          "text": "ה' תפלות הם כנגד חמשה השמות דהנשמה,"
        },
        {
          "s": 11,
          "text": "נפש רוח נשמה חי' ויחידה33,"
        },
        {
          "s": 12,
          "text": "וענין יום שנתחייב בה' תפלות הוא שהגילוי דעצם הנשמה,"
        },
        {
          "s": 13,
          "text": "שמצד עיצומו של יום,"
        },
        {
          "s": 14,
          "text": "מתגלה בדרגות הפרטיות שלה."
        },
        {
          "s": 15,
          "text": "ויש לומר,"
        },
        {
          "s": 16,
          "text": "שהחילוק בין ה' התפלות הוא לא רק בהמקום"
        },
        {
          "s": 17,
          "text": "(הדרגא)"
        },
        {
          "s": 18,
          "text": "שבו מתגלה עצם הנשמה,"
        },
        {
          "s": 19,
          "text": "אלא גם בהגילוי."
        },
        {
          "s": 20,
          "text": "דבתפלת נעילה,"
        },
        {
          "s": 21,
          "text": "בחינת יחידה,"
        },
        {
          "s": 22,
          "text": "הגילוי הוא יותר מבד' התפלות שלפנ\"ז."
        },
        {
          "s": 23,
          "text": "ועד\"ז הוא בנוגע לד' התפלות עצמם,"
        },
        {
          "s": 24,
          "text": "שהחילוק הוא גם באופן הגילוי."
        },
        {
          "s": 25,
          "text": "ועד\"ז הוא בהבחינות שלמעלה,"
        },
        {
          "s": 26,
          "text": "דזה שיום הכפורים הוא יום שנתחייב בה' תפלות הוא לפי שביום הכפורים הוא עליית המלכות בעתיק"
        },
        {
          "s": 27,
          "text": "(כמבואר בסידור34),"
        },
        {
          "s": 28,
          "text": "דענין זה הוא בכל היום,"
        },
        {
          "s": 29,
          "text": "ואעפ\"כ,"
        },
        {
          "s": 30,
          "text": "יש בזה כו\"כ דרגות,"
        },
        {
          "s": 31,
          "text": "ועיקר העלי' הוא בנעילה"
        },
        {
          "s": 32,
          "text": "(כמבואר בסידור35)."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "והנה הדרגות דיום הכפורים נחלקות לב' דרגות כלליות."
        },
        {
          "s": 1,
          "text": "שבת שבתון היא36"
        },
        {
          "s": 2,
          "text": "(לשון נקבה)"
        },
        {
          "s": 3,
          "text": "ושבת שבתון הוא37"
        },
        {
          "s": 4,
          "text": "(לשון זכר)."
        },
        {
          "s": 5,
          "text": "דב' הדרגות הם בעתיק,"
        },
        {
          "s": 6,
          "text": "אלא שבעתיק שני פירושים."
        },
        {
          "s": 7,
          "text": "שבכללות,"
        },
        {
          "s": 8,
          "text": "בחינה העליונה שבכתר"
        },
        {
          "s": 9,
          "text": "(ובפרט התלת רישין שבה)"
        },
        {
          "s": 10,
          "text": "נקראת בשם עתיק,"
        },
        {
          "s": 11,
          "text": "אבל עיקר ענין דעתיקא הוא אוא\"ס שבהתלת רישין38."
        },
        {
          "s": 12,
          "text": "והחילוק בין שתי דרגות הנ\"ל הוא,"
        },
        {
          "s": 13,
          "text": "דשבת שבתון היא"
        },
        {
          "s": 14,
          "text": "(לשון נקבה)"
        },
        {
          "s": 15,
          "text": "הוא בעתיק,"
        },
        {
          "s": 16,
          "text": "בתלת רישין שבו"
        },
        {
          "s": 17,
          "text": "(שבהם נכלל גם רדל\"א),"
        },
        {
          "s": 18,
          "text": "ושבת שבתון הוא"
        },
        {
          "s": 19,
          "text": "(לשון זכר)"
        },
        {
          "s": 20,
          "text": "הוא באוא\"ס שברדל\"א39."
        },
        {
          "s": 21,
          "text": "ועפ\"ז יש לומר תוספת ביאור בזה שלאחרי שאומר שובה ישראל עד מוסיף הוי' אלקיך,"
        },
        {
          "s": 22,
          "text": "כי עד ולא עד בכלל הוא בעתיק"
        },
        {
          "s": 23,
          "text": "(כמובא לעיל ס\"ג מלקו\"ת),"
        },
        {
          "s": 24,
          "text": "וזה שהוי' כאלקים יחשב לגבי אוא\"ס שלמעלה מהוי' יש לומר שזהו לגבי אוא\"ס שברדל\"א."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "דזה שאומרים שמעלתו של יום הכפורים הוא,"
        },
        {
          "s": 3,
          "text": "שהוא יום שנתחייב בה' תפלות,"
        },
        {
          "s": 4,
          "text": "אף שהיום עצמו"
        },
        {
          "s": 5,
          "text": "(גילוי התקשרות העצמות דעצם הנשמה עם העצמות)"
        },
        {
          "s": 6,
          "text": "הוא נעלה יותר מזה שנתחייב בה' תפלות"
        },
        {
          "s": 7,
          "text": "(הגילוי בדרגות הפרטיות דהנשמה),"
        },
        {
          "s": 8,
          "text": "הוא,"
        },
        {
          "s": 9,
          "text": "כי זה שעצם הנשמה מתגלית בדרגות הפרטיות שלה,"
        },
        {
          "s": 10,
          "text": "שעי\"ז הכפרה בהמקום שבו הי' תחילה הפגם,"
        },
        {
          "s": 11,
          "text": "יש בזה יתרון לגבי הדרגא דעצם הנשמה."
        },
        {
          "s": 12,
          "text": "דהגם שבהבחינות נר\"נ ובפרט בחי' נפש"
        },
        {
          "s": 13,
          "text": "(כמו שהם מצד עצמם)"
        },
        {
          "s": 14,
          "text": "שייך פגמים אעפ\"כ הם מתכפרים."
        },
        {
          "s": 15,
          "text": "[ויתירה מזו,"
        },
        {
          "s": 16,
          "text": "שהכפרה שמצד עיצומו של יום היא באופן שמתגלה שבפנימיות לא הי' בהם פגם מלכתחילה,"
        },
        {
          "s": 17,
          "text": "כנ\"ל]."
        },
        {
          "s": 18,
          "text": "ועד\"ז הוא גם בענין הכפרה עצמו,"
        },
        {
          "s": 19,
          "text": "שעיקר החידוש שבכפרה הוא בכפרה על חטאים כפשוטם."
        },
        {
          "s": 20,
          "text": "דהכפרה על החטאים שבצדיקים,"
        },
        {
          "s": 21,
          "text": "הענין דיש מי שאוהב וכיו\"ב שלגבי מדריגתם הוא כמו פריקת עול40,"
        },
        {
          "s": 22,
          "text": "כיון שעל חטאים אלה אין שייך לומר שהם היפך רצון הקב\"ה"
        },
        {
          "s": 23,
          "text": "[שהרי ישות זו היא מפני הטבע שהטביע הקב\"ה41],"
        },
        {
          "s": 24,
          "text": "לכן,"
        },
        {
          "s": 25,
          "text": "הכפרה שעל זה אינה חידוש כ\"כ."
        },
        {
          "s": 26,
          "text": "ועיקר החידוש ו"
        },
        {
          "s": 27,
          "text": "(במילא)"
        },
        {
          "s": 28,
          "text": "המעלה היא בכפרה על חטאים כפשוטם,"
        },
        {
          "s": 29,
          "text": "שבזה מתגלה תוקף הבלתי מוגבל של ההתקשרות דישראל וקוב\"ה,"
        },
        {
          "s": 30,
          "text": "שגם כשעשו היפך רצונו מ\"מ"
        },
        {
          "s": 31,
          "text": "(ע\"י התשובה והכפרה)"
        },
        {
          "s": 32,
          "text": "הם מרוצים לפניו ית' כמו שלא חטאו מעולם42."
        },
        {
          "s": 33,
          "text": "וזהו שארז\"ל43"
        },
        {
          "s": 34,
          "text": "במקום שבעלי תשובה עומדין אין צדיקים גמורין יכולים לעמוד בו,"
        },
        {
          "s": 35,
          "text": "דיש לומר שאין מרז\"ל זה יוצא מידי פשוטו44"
        },
        {
          "s": 36,
          "text": "ועיקר המעלה דבעלי תשובה הוא בבעלי תשובה כפשוטם."
        },
        {
          "s": 37,
          "text": "ועפ\"ז יובן מה שמביא הצ\"צ45"
        },
        {
          "s": 38,
          "text": "(מספר טעמי המצוות להרח\"ו46),"
        },
        {
          "s": 39,
          "text": "דזה שהאריז\"ל הי' נוהג לומר פרטי הוידויים הוא,"
        },
        {
          "s": 40,
          "text": "כי כל ישראל הם גוף אחד,"
        },
        {
          "s": 41,
          "text": "דלכאורה הי' אפשר לומר שהוידויים של האריז\"ל היו על ענינים שבתכלית הדקות ששייכים גם אצלו47"
        },
        {
          "s": 42,
          "text": "[וע\"ד שנת\"ל בענין הישות דיש מי שאוהב],"
        },
        {
          "s": 43,
          "text": "וזה שמבארים דהוידויים של האריז\"ל היו"
        },
        {
          "s": 44,
          "text": "(גם)"
        },
        {
          "s": 45,
          "text": "על חטאים כפשוטם מפני שכל ישראל הם גוף אחד,"
        },
        {
          "s": 46,
          "text": "יש לומר,"
        },
        {
          "s": 47,
          "text": "כי ע\"פ ביאור זה דוקא מובן שאצל האריז\"ל היתה גם המעלה דבעלי תשובה כפשוטם48."
        }
      ]
    }
  ]
}