{
  "globalIndex": 451,
  "owner": 1,
  "jobId": "_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916328_theRebbe_715__p007",
  "batchId": "meluket-_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916328_theRebbe_715__p007",
  "seriesId": "טבת_meluket",
  "postId": "BH_POST_1766518916328_theRebbe_715",
  "title": "מאמר וארא אל אברהם תשל\"ה",
  "part": 7,
  "sections": [
    {
      "v": 18,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "וביאור השייכות דשתי הדיעות באופן השראת השכינה בביהמ\"ק להביאור שדוקא שם הוי' הוא מדת אמיתית,"
        },
        {
          "s": 2,
          "text": "יש לומר,"
        },
        {
          "s": 3,
          "text": "דנקודת החילוק דשתי הדיעות היא – ענין ההתלבשות."
        },
        {
          "s": 4,
          "text": "דהתלבשות"
        },
        {
          "s": 5,
          "text": "(בכלל)"
        },
        {
          "s": 6,
          "text": "היא ירידה,"
        },
        {
          "s": 7,
          "text": "שהמתלבש מתצמצם ומשתנה לפי אופן הלבוש"
        },
        {
          "s": 8,
          "text": "(כנ\"ל סעיף ח)."
        },
        {
          "s": 9,
          "text": "ולכן,"
        },
        {
          "s": 10,
          "text": "דעת הרמב\"ם היא שהשראת השכינה בביהמ\"ק היתה דרך מעביר,"
        },
        {
          "s": 11,
          "text": "כי אין שייך לומר באלקות שנתצמצם ונשתנה להיות בגדר מקום גשמי."
        },
        {
          "s": 12,
          "text": "ודעת הרמב\"ן"
        },
        {
          "s": 13,
          "text": "(וכ\"ה הכרעת תורת החסידות)"
        },
        {
          "s": 14,
          "text": "דזה שהשראת השכינה בביהמ\"ק היתה בדרך התלבשות אינה ירידה אלא אדרבה,"
        },
        {
          "s": 15,
          "text": "ע\"י שהאור נמשך ומתלבש במקום גשמי,"
        },
        {
          "s": 16,
          "text": "עי\"ז נתגלה שהאור הוא בלתי מוגבל"
        },
        {
          "s": 17,
          "text": "(כנ\"ל סעיף ח)."
        },
        {
          "s": 18,
          "text": "ויש לומר,"
        },
        {
          "s": 19,
          "text": "דזה שמביא בהמאמר גם דעת הרמב\"ם"
        },
        {
          "s": 20,
          "text": "[ומוסיף שכן הוא דעת הרס\"ג,"
        },
        {
          "s": 21,
          "text": "הרד\"ק,"
        },
        {
          "s": 22,
          "text": "ועוד],"
        },
        {
          "s": 23,
          "text": "הוא,"
        },
        {
          "s": 24,
          "text": "כי בההתלבשות שבביהמ\"ק היו שני הענינים."
        },
        {
          "s": 25,
          "text": "דבחיצוניות,"
        },
        {
          "s": 26,
          "text": "ההתלבשות"
        },
        {
          "s": 27,
          "text": "(גם ההתלבשות דביהמ\"ק)"
        },
        {
          "s": 28,
          "text": "היא ירידה וצמצום44"
        },
        {
          "s": 29,
          "text": "– היסוד דשיטת הרמב\"ם."
        },
        {
          "s": 30,
          "text": "ובפנימיות,"
        },
        {
          "s": 31,
          "text": "ההתלבשות בביהמ\"ק הוא גילוי אמיתית הבל\"ג שביכלתו להתלבש גם במקום גשמי – היסוד דשיטת הרמב\"ן."
        },
        {
          "s": 32,
          "text": "ולהעיר,"
        },
        {
          "s": 33,
          "text": "דענין זה"
        },
        {
          "s": 34,
          "text": "(שההתלבשות הוא גילוי אמיתית הבל\"ג)"
        },
        {
          "s": 35,
          "text": "נתבאר בתורת החסידות דוקא,"
        },
        {
          "s": 36,
          "text": "לפי שפנימיות התורה מגלית הפנימיות שבכל ענין."
        }
      ]
    },
    {
      "v": 19,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 1,
          "text": "דמהטעמים שמביא בהמאמר ב' הדיעות באופן השראת השכינה בביהמ\"ק הוא לרמז שעד\"ז הוא גם בנוגע להתלבשות הנסים בטבע,"
        },
        {
          "s": 2,
          "text": "שיש בזה שני הענינים."
        },
        {
          "s": 3,
          "text": "הענין בחיצוניות הוא,"
        },
        {
          "s": 4,
          "text": "דשרש הנסים המלובשים בטבע הוא מאור השייך לעולמות,"
        },
        {
          "s": 5,
          "text": "שמצד גילוי זה,"
        },
        {
          "s": 6,
          "text": "אי אפשר להיות שינוי וביטול הטבע."
        },
        {
          "s": 7,
          "text": "והענין בפנימיות הוא,"
        },
        {
          "s": 8,
          "text": "דע\"י התלבשות הנסים בטבע מתגלה אמיתית הבל\"ג,"
        },
        {
          "s": 9,
          "text": "דזה שאוא\"ס הבל\"ג"
        },
        {
          "s": 10,
          "text": "(שלמעלה מהתלבשות)"
        },
        {
          "s": 11,
          "text": "מושל ושולט על הטבע הוא באופן שגם הטבע עצמו נעשה כפי רצונו45."
        },
        {
          "s": 12,
          "text": "אלא שענין זה מתגלה דוקא ע\"י הנסים שלמעלה מהטבע."
        },
        {
          "s": 13,
          "text": "דלאחרי שרואים נסים שלמעלה מהטבע מובן דהתלבשות הנסים בטבע הוא"
        },
        {
          "s": 14,
          "text": "(לא מפני שאין בכחם לשדד הטבע,"
        },
        {
          "s": 15,
          "text": "אלא)"
        },
        {
          "s": 16,
          "text": "בכדי לגלות שהשליטה דאוא\"ס על הטבע היא גם על הטבע עצמו."
        },
        {
          "s": 17,
          "text": "ועפ\"ז יש לומר דזה שהאבות המשיכו הגילוי דשם שדי על שם שדי באלקותי לכל ברי',"
        },
        {
          "s": 18,
          "text": "גילוי חדש שלא הי' קודם גם בהעלם"
        },
        {
          "s": 19,
          "text": "(כנ\"ל סעיף ב וסעיף ה),"
        },
        {
          "s": 20,
          "text": "הי' הקדמה להגילוי דשם הוי' שנתגלה במתן תורה46."
        },
        {
          "s": 21,
          "text": "ויתירה מזו,"
        },
        {
          "s": 22,
          "text": "שהמשכה זו עצמה"
        },
        {
          "s": 23,
          "text": "(המשכת הגילוי דא-ל שדי שהמשיכו האבות)"
        },
        {
          "s": 24,
          "text": "היא המשכת הגילוי דשם הוי',"
        },
        {
          "s": 25,
          "text": "כי בפנימיות גם הנסים המלובשים בטבע שרש המשכתם הוא מאוא\"ס שלמעלה משייכות לעולמות,"
        },
        {
          "s": 26,
          "text": "הוי'."
        },
        {
          "s": 27,
          "text": "אלא שהמשכת שם הוי' אז היתה מלובשת בהשם א-ל שדי,"
        },
        {
          "s": 28,
          "text": "ובמתן תורה,"
        },
        {
          "s": 29,
          "text": "כשנמשך הגילוי דשם הוי',"
        },
        {
          "s": 30,
          "text": "נתגלה אז שזהו גם הפנימיות של הגילוי דא-ל שדי שנמשך ע\"י האבות47"
        },
        {
          "s": 31,
          "text": "(וע\"ד שנתבאר לעיל דלאחרי שרואים נסים שלמעלה מהטבע מתגלה שזהו גם הפנימיות דהנסים המלובשים בטבע)."
        },
        {
          "s": 32,
          "text": "וזהו וארא אל האבות בא-ל שדי ושמי הוי' לא נודעתי להם לא ניכרתי להם במדת אמיתית שלי,"
        },
        {
          "s": 33,
          "text": "שגם להאבות נמשך הגילוי דשם הוי',"
        },
        {
          "s": 34,
          "text": "אלא שאז הי' זה בהעלם,"
        },
        {
          "s": 35,
          "text": "לא נודעתי לא ניכרתי."
        }
      ]
    },
    {
      "v": 20,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "ובעומק יותר יש לומר,"
        },
        {
          "s": 3,
          "text": "שעד\"ז הוא גם בנוגע לשם שדי שבבריאת העולם על שם שאמרתי לעולמי די."
        },
        {
          "s": 4,
          "text": "דכיון שהכוונה והתכלית של המדידה וההגבלה דהעולם"
        },
        {
          "s": 5,
          "text": "(שאמרתי לעולמי די)"
        },
        {
          "s": 6,
          "text": "הוא שע\"י העבודה דתומ\"צ יומשך בהגבול גילוי הבלי גבול"
        },
        {
          "s": 7,
          "text": "(דשם שדי על שם שדי באלקותי לכל ברי',"
        },
        {
          "s": 8,
          "text": "ועי\"ז הבלי גבול דשם הוי'),"
        },
        {
          "s": 9,
          "text": "לכן,"
        },
        {
          "s": 10,
          "text": "הענין דשאמרתי לעולמי די בפנימיות הוא שיהי' בהגבול גילוי הבל\"ג."
        },
        {
          "s": 11,
          "text": "ויש לומר,"
        },
        {
          "s": 12,
          "text": "דזהו שכל השמות הם אמת,"
        },
        {
          "s": 13,
          "text": "כי ענינם של כל השמות48"
        },
        {
          "s": 14,
          "text": "(גם דשם שדי שאמרתי לעולמי די,"
        },
        {
          "s": 15,
          "text": "וגם דשם אלקים בגימטריא הטבע49)"
        },
        {
          "s": 16,
          "text": "הוא שיהי' הגילוי דאמת הוי'50."
        },
        {
          "s": 17,
          "text": "אלא שהשייכות דשם שדי שבברה\"ע להגילוי דהוי' היא,"
        },
        {
          "s": 18,
          "text": "שהכוונה בזה שאמרתי לעולמי די היא בכדי שיהי' בו גילוי הבל\"ג,"
        },
        {
          "s": 19,
          "text": "אבל בפועל,"
        },
        {
          "s": 20,
          "text": "הענין דאמרתי לעולמי די הוא להגביל,"
        },
        {
          "s": 21,
          "text": "להעלים הבל\"ג."
        },
        {
          "s": 22,
          "text": "והשייכות דשם שדי שנתגלה להאבות להגילוי דשם הוי' הוא שאז הותחל בפועל גילוי הבל\"ג דהוי',"
        },
        {
          "s": 23,
          "text": "ורק שאז"
        },
        {
          "s": 24,
          "text": "(עדיין)"
        },
        {
          "s": 25,
          "text": "לא ניכרתי במדת אמיתית שלי."
        }
      ]
    }
  ]
}