{
  "globalIndex": 503,
  "owner": 3,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916754_theRebbe_640__p002",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916754_theRebbe_640__p002",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916754_theRebbe_640",
  "title": "מאמר באתי לגני תשכ\"ח",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דזה שמבאר בהמאמר"
        },
        {
          "s": 2,
          "text": "(ובארוכה)"
        },
        {
          "s": 3,
          "text": "בענין הקרבנות,"
        },
        {
          "s": 4,
          "text": "אף שע\"י עשיית המשכן נעשה כבר"
        },
        {
          "s": 5,
          "text": "(לכאורה)"
        },
        {
          "s": 6,
          "text": "ושכנתי בתוכם,"
        },
        {
          "s": 7,
          "text": "הוא,"
        },
        {
          "s": 8,
          "text": "לפי שהמשכת עיקר שכינה למטה היא בעיקר ע\"י העבודה בהמשכן לאחרי הקמתו23."
        },
        {
          "s": 9,
          "text": "דהגם שההמשכה שהיתה בעת שהוקם המשכן ע\"י משה היא המשכה נעלית ביותר,"
        },
        {
          "s": 10,
          "text": "מ\"מ,"
        },
        {
          "s": 11,
          "text": "ההמשכה שע\"י עבודת הקרבנות"
        },
        {
          "s": 12,
          "text": "(דישראל24)"
        },
        {
          "s": 13,
          "text": "היא נעלית עוד יותר."
        },
        {
          "s": 14,
          "text": "ויש לומר,"
        },
        {
          "s": 15,
          "text": "דזהו גם מה שמביא בתחלת המאמר הפסוק25"
        },
        {
          "s": 16,
          "text": "צדיקים יירשו ארץ וישכנו לעד עלי',"
        },
        {
          "s": 17,
          "text": "ומבאר שצדיקים הם משכינים"
        },
        {
          "s": 18,
          "text": "(ממשיכים26)"
        },
        {
          "s": 19,
          "text": "בחי' שוכן עד27"
        },
        {
          "s": 20,
          "text": "מרום וקדוש28"
        },
        {
          "s": 21,
          "text": "שיהי' בגילוי למטה,"
        },
        {
          "s": 22,
          "text": "שמרמז בזה,"
        },
        {
          "s": 23,
          "text": "דהמשכת השכינה למטה היא לא רק ע\"י שבעה הצדיקים שמאברהם עד משה,"
        },
        {
          "s": 24,
          "text": "אלא גם ע\"י צדיקים סתם,"
        },
        {
          "s": 25,
          "text": "שבזה נכללים כאו\"א מישראל,"
        },
        {
          "s": 26,
          "text": "ועמך כולם צדיקים29."
        },
        {
          "s": 27,
          "text": "דלאחרי ההמשכה שע\"י שבעה הצדיקים,"
        },
        {
          "s": 28,
          "text": "ובפרט ע\"י משה שעל ידו נמשכה השכינה למטה בארץ,"
        },
        {
          "s": 29,
          "text": "הנה עי\"ז ניתן הכח לכאו\"א מישראל להמשיך עוד יותר,"
        },
        {
          "s": 30,
          "text": "ועי\"ז דוקא נשלמת הכוונה דדירה לו ית' בתחתונים30,"
        },
        {
          "s": 31,
          "text": "שעוה\"ז התחתון שאין תחתון למטה ממנו31"
        },
        {
          "s": 32,
          "text": "נעשה דירה לו ית',"
        },
        {
          "s": 33,
          "text": "לו לעצמותו32."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "וזהו שממשיך בהמאמר33"
        },
        {
          "s": 1,
          "text": "דישראל נק' בשם צבאות הוי'34,"
        },
        {
          "s": 2,
          "text": "ומבאר דצבא הוא"
        },
        {
          "s": 3,
          "text": "(גם)"
        },
        {
          "s": 4,
          "text": "מלשון צביון35,"
        },
        {
          "s": 5,
          "text": "דענין הצביון"
        },
        {
          "s": 6,
          "text": "(יופי)"
        },
        {
          "s": 7,
          "text": "דישראל הוא שיש בהם סוגים שונים,"
        },
        {
          "s": 8,
          "text": "מארי תורה וכו'36"
        },
        {
          "s": 9,
          "text": "עד לאנשים פשוטים"
        },
        {
          "s": 10,
          "text": "[כולל גם אלו שעליהם אמרו37"
        },
        {
          "s": 11,
          "text": "שהם מלאים מצוות כרימון],"
        },
        {
          "s": 12,
          "text": "דכל אחד מישראל הוא חייל בצבאות ה'"
        },
        {
          "s": 13,
          "text": "(צבא מלשון חיל),"
        },
        {
          "s": 14,
          "text": "שיוצא למלחמה,"
        },
        {
          "s": 15,
          "text": "לכבוש את העולם ולעשותו לדירה לו ית'."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה כמו שמלחמה כפשוטה קשורה עם מס\"נ,"
        },
        {
          "s": 2,
          "text": "עד\"ז הוא גם במלחמה זו,"
        },
        {
          "s": 3,
          "text": "שבכדי ללחום נגד השטות דלעו\"ז צריכה להיות העבודה שלמעלה ממדידה והגבלה,"
        },
        {
          "s": 4,
          "text": "שטות דקדושה שלמעלה מטעם ודעת,"
        },
        {
          "s": 5,
          "text": "דבכללות הו\"ע המס\"נ שלמעלה מהשכל."
        },
        {
          "s": 6,
          "text": "[ויש לקשר זה גם עם עבודת הקרבנות כפשוטה,"
        },
        {
          "s": 7,
          "text": "ע\"פ מ\"ש הרמב\"ן38"
        },
        {
          "s": 8,
          "text": "שבעת הקרבת הקרבן צריך בעל הקרבן לחשוב שחטא לאלקיו בגופו ובנפשו וראוי לו שישפך דמו וישרף גופו לולא חסד הבורא שלקח ממנו תמורה כו' דמו"
        },
        {
          "s": 9,
          "text": "(דהקרבן)"
        },
        {
          "s": 10,
          "text": "תחת דמו נפש תחת נפש כו',"
        },
        {
          "s": 11,
          "text": "שהו\"ע של מס\"נ]."
        }
      ]
    }
  ]
}