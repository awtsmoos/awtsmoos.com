{
  "globalIndex": 848,
  "owner": 48,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918788_theRebbe_204__p003",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918788_theRebbe_204__p003",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918788_theRebbe_204",
  "title": "מאמר אתה הראת לדעת תשמ\"ו",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "אמנם אעפ\"כ,"
        },
        {
          "s": 2,
          "text": "בהכרח לומר ומובן ופשוט מעצמו"
        },
        {
          "s": 3,
          "text": "(און ס'איז געשמאַק צו זאָגן),"
        },
        {
          "s": 4,
          "text": "שענין זה ישנו כבר עכשיו,"
        },
        {
          "s": 5,
          "text": "וכנודע שהכל ניתן במתן תורה."
        },
        {
          "s": 6,
          "text": "והענין הוא,"
        },
        {
          "s": 7,
          "text": "דהנה בתניא"
        },
        {
          "s": 8,
          "text": "(שם)"
        },
        {
          "s": 9,
          "text": "מבאר רבינו הזקן"
        },
        {
          "s": 10,
          "text": "(בענין גילוי האלקות שיהי' לע\"ל ובפרט בתחיית המתים)"
        },
        {
          "s": 11,
          "text": "שכבר הי' לעולמים מעין זה בשעת מתן תורה כדכתיב אתה הראת לדעת כו'."
        },
        {
          "s": 12,
          "text": "והיינו,"
        },
        {
          "s": 13,
          "text": "שענין זה"
        },
        {
          "s": 14,
          "text": "(הגילוי דתחיית המתים)"
        },
        {
          "s": 15,
          "text": "כבר נמשך במ\"ת,"
        },
        {
          "s": 16,
          "text": "ולא עוד אלא שמדייק בלשונו כבר הי' לעולמים דייקא."
        },
        {
          "s": 17,
          "text": "די\"ל הכוונה בזה,"
        },
        {
          "s": 18,
          "text": "שנמשך בגדרי העולם,"
        },
        {
          "s": 19,
          "text": "שזה כולל גדרי הזמן וגדרי המקום50,"
        },
        {
          "s": 20,
          "text": "כב' הפירושים בתיבת עולם51"
        },
        {
          "s": 21,
          "text": "(עולמים),"
        },
        {
          "s": 22,
          "text": "שזהו שמו אשר יקראו לו בלשון הקודש,"
        },
        {
          "s": 23,
          "text": "המהווה ומחי' ומקיים אותו52."
        },
        {
          "s": 24,
          "text": "וי\"ל שזהו הביאור בפתגם הידוע שמ\"ת לא יהי' עוד הפעם53,"
        },
        {
          "s": 25,
          "text": "כי מכיון שהכל כבר ניתן בשעת מ\"ת,"
        },
        {
          "s": 26,
          "text": "וא\"כ אין צורך"
        },
        {
          "s": 27,
          "text": "(מ'דאַרף ניט)"
        },
        {
          "s": 28,
          "text": "שיומשך עוד הפעם,"
        },
        {
          "s": 29,
          "text": "וכיון שאין צורך בדבר ממילא מובן שלא יהי' מ\"ת עוה\"פ."
        },
        {
          "s": 30,
          "text": "וע\"ד המבואר בכ\"מ54,"
        },
        {
          "s": 31,
          "text": "שכל התורה כולה כלולה בעשה\"ד שניתנו במ\"ת,"
        },
        {
          "s": 32,
          "text": "עד\"ז הוא בעניננו,"
        },
        {
          "s": 33,
          "text": "שכל הדרגות שבתורה,"
        },
        {
          "s": 34,
          "text": "כולל בחי' טל תורה דלעתיד,"
        },
        {
          "s": 35,
          "text": "הכל ניתן במתן תורה."
        },
        {
          "s": 36,
          "text": "וענין זה ניתן לכל ישראל,"
        },
        {
          "s": 37,
          "text": "כדאיתא במדרש55"
        },
        {
          "s": 38,
          "text": "שהתורה ניתנה לכאו\"א לפי כחו,"
        },
        {
          "s": 39,
          "text": "כולל גם יונקים ונשים מעוברות וכו'"
        },
        {
          "s": 40,
          "text": "(היינו שאפילו עוברין שבמעי אמן היו"
        },
        {
          "s": 41,
          "text": "(וקבלו)"
        },
        {
          "s": 42,
          "text": "בקבלת התורה),"
        },
        {
          "s": 43,
          "text": "ולא זו בלבד אלא56"
        },
        {
          "s": 44,
          "text": "גם כל הנשמות שלא ירדו אז לעולם עדיין,"
        },
        {
          "s": 45,
          "text": "או הנשמות שכבר ירדו ועלו לפנ\"ז57,"
        },
        {
          "s": 46,
          "text": "כולם היו בשעת מ\"ת."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "והנה בזה גופא"
        },
        {
          "s": 2,
          "text": "(מה שבחי' טל תורה כבר ניתן במתן תורה)"
        },
        {
          "s": 3,
          "text": "יש ב' אופנים."
        },
        {
          "s": 4,
          "text": "דאפשר שענין זה יהי' טמון ונעלם כמו אוצר דהון יקר הכמוס וחתום מעין כל רואה58,"
        },
        {
          "s": 5,
          "text": "וכמו שהתורה בכלל היתה חמדה גנוזה59"
        },
        {
          "s": 6,
          "text": "לפני מתן תורה."
        },
        {
          "s": 7,
          "text": "דגם ענין זה פועל עילוי בישראל,"
        },
        {
          "s": 8,
          "text": "כמו בפשטות,"
        },
        {
          "s": 9,
          "text": "שמי שיש בבעלותו אוצר גדול,"
        },
        {
          "s": 10,
          "text": "הרי אף שאינו משתמש בו מאיזו סיבה שתהי',"
        },
        {
          "s": 11,
          "text": "מ\"מ יש לו ערך גדול יותר,"
        },
        {
          "s": 12,
          "text": "שנחשב לעשיר גדול."
        },
        {
          "s": 13,
          "text": "וכ\"ה להלכה בהלכות ערכין דכתיב60"
        },
        {
          "s": 14,
          "text": "על פי אשר תשיג ידו יעריכנו הכהן,"
        },
        {
          "s": 15,
          "text": "שתלוי בהישג ידו,"
        },
        {
          "s": 16,
          "text": "ואם יש לו אוצר גדול"
        },
        {
          "s": 17,
          "text": "(אף שלא השתמש בו)"
        },
        {
          "s": 18,
          "text": "נערך עשיר,"
        },
        {
          "s": 19,
          "text": "ועד שזה מובן בפשטות גם אצל תגרי לוד,"
        },
        {
          "s": 20,
          "text": "ובמנהג דרך ארץ,"
        },
        {
          "s": 21,
          "text": "וגם בחו\"ל וגם בשבעים אומות העולם."
        },
        {
          "s": 22,
          "text": "ועד\"ז יובן בנמשל,"
        },
        {
          "s": 23,
          "text": "כשבחי' טל שבתורה היא באופן דאוצר נעלם בידי ישראל"
        },
        {
          "s": 24,
          "text": "(מזמן מ\"ת),"
        },
        {
          "s": 25,
          "text": "פועל שיהיו נערכים באופן נעלה ביותר ע\"י הכהן,"
        },
        {
          "s": 26,
          "text": "אלקיכם כהן הוא61,"
        },
        {
          "s": 27,
          "text": "ועד שענין זה פועל גם בע' האומות."
        },
        {
          "s": 28,
          "text": "אבל מ\"מ אין זה החידוש האמיתי דמתן תורה,"
        },
        {
          "s": 29,
          "text": "וגם לפני מתן תורה היתה התורה בבחי' חמדה גנוזה,"
        },
        {
          "s": 30,
          "text": "והחידוש דמ\"ת הוא שהתורה תומשך בישראל בפנימיות ובגלוי ובפשטות."
        },
        {
          "s": 31,
          "text": "ועד\"ז הוא בבחי' טל שבתורה,"
        },
        {
          "s": 32,
          "text": "שאינו מספיק זה שענין זה כבר ניתן"
        },
        {
          "s": 33,
          "text": "(בהעלם)"
        },
        {
          "s": 34,
          "text": "בשעת מ\"ת,"
        },
        {
          "s": 35,
          "text": "אלא צריך שיפעול גם בפנימיות,"
        },
        {
          "s": 36,
          "text": "וכמ\"ש62"
        },
        {
          "s": 37,
          "text": "כי היא חכמתכם ובינתכם גו',"
        },
        {
          "s": 38,
          "text": "דעיקר ענין התורה הוא שהיא בבחי' חכמה ובינה,"
        },
        {
          "s": 39,
          "text": "בחי' לימוד בהבנה והשגה."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "והענין הוא,"
        },
        {
          "s": 2,
          "text": "דהנה איתא במשנה63"
        },
        {
          "s": 3,
          "text": "אין דורשין במעשה מרכבה ביחיד אא\"כ הי' חכם ומבין מדעתו,"
        },
        {
          "s": 4,
          "text": "די\"ל,"
        },
        {
          "s": 5,
          "text": "דע\"י הלימוד דיחיד זה במעשה מרכבה"
        },
        {
          "s": 6,
          "text": "(דהיינו פנימיות התורה),"
        },
        {
          "s": 7,
          "text": "ה\"ה מוציא עי\"ז64"
        },
        {
          "s": 8,
          "text": "את כל תלמידיו וכל כלל ישראל בהבנה והשגה בפנימיות התורה."
        },
        {
          "s": 9,
          "text": "אך ע\"פ משנ\"ת שהגילוי דמ\"ת הי' לכל ישראל,"
        },
        {
          "s": 10,
          "text": "צריך לומר,"
        },
        {
          "s": 11,
          "text": "שגם ענין זה"
        },
        {
          "s": 12,
          "text": "(ההבנה והשגה בבחי' טל תורה)"
        },
        {
          "s": 13,
          "text": "צ\"ל בכל ישראל."
        },
        {
          "s": 14,
          "text": "ויש לומר65,"
        },
        {
          "s": 15,
          "text": "דזהו החידוש דתורת החסידות,"
        },
        {
          "s": 16,
          "text": "שיהי' לימוד פנימיות התורה"
        },
        {
          "s": 17,
          "text": "(בחי' טלא דבדולחא,"
        },
        {
          "s": 18,
          "text": "טלא דנטיף מע\"ק)"
        },
        {
          "s": 19,
          "text": "באופן דהבנה והשגה,"
        },
        {
          "s": 20,
          "text": "ובאופן דיתפרנסון מיני'66."
        },
        {
          "s": 21,
          "text": "כי הגם שבדורות הקודמים היתה הגבלה דאין דורשין במעשה מרכבה ביחיד כו',"
        },
        {
          "s": 22,
          "text": "הנה בזמן הזה,"
        },
        {
          "s": 23,
          "text": "בערב שבת67,"
        },
        {
          "s": 24,
          "text": "הרי הפס\"ד בשו\"ע68"
        },
        {
          "s": 25,
          "text": "שבע\"ש צ\"ל הטעימה69"
        },
        {
          "s": 26,
          "text": "מכל תבשיל ותבשיל דשבת,"
        },
        {
          "s": 27,
          "text": "טועמי' חיים זכו70,"
        },
        {
          "s": 28,
          "text": "וא\"כ צ\"ל עתה הטעימה מהגילוי דבחי' טל תורה שיתגלה לע\"ל,"
        },
        {
          "s": 29,
          "text": "היינו ההבנה וההשגה בפנימיות התורה."
        },
        {
          "s": 30,
          "text": "ובזה יובן מ\"ש גשם נדבות תניף אלקים גו',"
        },
        {
          "s": 31,
          "text": "שהטל תורה דמ\"ת נק' בשם גשם"
        },
        {
          "s": 32,
          "text": "(נדבות)"
        },
        {
          "s": 33,
          "text": "דוקא,"
        },
        {
          "s": 34,
          "text": "כי התכלית דבחי' טל זה הוא שתהי' בו גם המעלה דגשם,"
        },
        {
          "s": 35,
          "text": "ועד שיומשך בהבנה והשגה כמו בחי' גשם,"
        },
        {
          "s": 36,
          "text": "נגלה דתורה."
        }
      ]
    }
  ]
}