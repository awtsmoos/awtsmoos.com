{
  "globalIndex": 1086,
  "owner": 36,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920245_theRebbe_641__p001",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920245_theRebbe_641__p001",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920245_theRebbe_641",
  "title": "מאמר לכה דודי תשי\"ד",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ תצא,"
        },
        {
          "s": 2,
          "text": "י\"ג אלול,"
        },
        {
          "s": 3,
          "text": "ה'תשי\"ד*."
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "לכה דודי לקראת כלה פני שבת נקבלה,"
        },
        {
          "s": 1,
          "text": "ומביא כ\"ק מו\"ח אדמו\"ר במאמרו לכה דודי"
        },
        {
          "s": 2,
          "text": "(מדרושי החתונה1)"
        },
        {
          "s": 3,
          "text": "(מפדר\"א2)"
        },
        {
          "s": 4,
          "text": "שחתן דומה למלך והכלה למלכה."
        },
        {
          "s": 5,
          "text": "חתן זה הקב\"ה וכלה היא כנס\"י,"
        },
        {
          "s": 6,
          "text": "ובספירות הו\"ע ז\"א ומלכות,"
        },
        {
          "s": 7,
          "text": "דחתן הוא בחי' ז\"א וכלה היא בחי' מלכות."
        },
        {
          "s": 8,
          "text": "וזהו לכה דודי לקראת כלה פני שבת נקבלה,"
        },
        {
          "s": 9,
          "text": "שהו\"ע המשכת ז\"א למלכות,"
        },
        {
          "s": 10,
          "text": "וסדר ההמשכה הוא,"
        },
        {
          "s": 11,
          "text": "אשר תחילה צ\"ל ההמשכה חיצונית"
        },
        {
          "s": 12,
          "text": "(מז\"א למלכות)"
        },
        {
          "s": 13,
          "text": "שהיא רק בבחי' מקיף,"
        },
        {
          "s": 14,
          "text": "ואח\"כ היא ההמשכה פנימית."
        },
        {
          "s": 15,
          "text": "דכן הוא הסדר בכל השפעה ממשפיע למקבל,"
        },
        {
          "s": 16,
          "text": "דתחילה צ\"ל המשכת המשפיע מבחי' חיצוניות שלו לבחי' חיצוניות המקבל,"
        },
        {
          "s": 17,
          "text": "שעי\"ז מתעלה המקבל להיות קרוב למדרי' המשפיע,"
        },
        {
          "s": 18,
          "text": "ואח\"כ יוכל לקבל המשכה הפנימית מהמשפיע."
        },
        {
          "s": 19,
          "text": "ומביא ע\"ז3"
        },
        {
          "s": 20,
          "text": "ב' משלים"
        },
        {
          "s": 21,
          "text": "[מהשפעת רב לתלמיד,"
        },
        {
          "s": 22,
          "text": "ואב המשתעשע עם בנו הקטן]."
        },
        {
          "s": 23,
          "text": "ויש לומר,"
        },
        {
          "s": 24,
          "text": "שכוונתו במשלים אלה היא לא רק להביא דוגמאות לסדר ההמשכה"
        },
        {
          "s": 25,
          "text": "(שההשפעה חיצונית היא הקדמה לההשפעה פנימית),"
        },
        {
          "s": 26,
          "text": "אלא"
        },
        {
          "s": 27,
          "text": "(גם)"
        },
        {
          "s": 28,
          "text": "לבאר גודל העילוי שבב' השפעות אלו,"
        },
        {
          "s": 29,
          "text": "דגם ההשפעה חיצונית היא דרגא נעלית ביותר,"
        },
        {
          "s": 30,
          "text": "ועד שיש בה עילוי לגבי ההשפעה פנימית."
        },
        {
          "s": 31,
          "text": "כי ההשפעה חיצונית,"
        },
        {
          "s": 32,
          "text": "שהיא בחי' מקיף,"
        },
        {
          "s": 33,
          "text": "היא למעלה מכלי המקבל"
        },
        {
          "s": 34,
          "text": "(משא\"כ ההשפעה פנימית שמתקבלת בכלי המקבל)."
        },
        {
          "s": 35,
          "text": "ומ\"מ היא רק הקדמה לההשפעה פנימית,"
        },
        {
          "s": 36,
          "text": "כי דוקא ע\"י השפעה הפנימית מגיעים לעילוי נעלה יותר"
        },
        {
          "s": 37,
          "text": "(שלמעלה מבחי' המקיף)."
        },
        {
          "s": 38,
          "text": "וזהו על כל כבוד חופה4"
        },
        {
          "s": 39,
          "text": "שהם ב' בחי' כבוד,"
        },
        {
          "s": 40,
          "text": "כבוד חתן וכבוד כלה,"
        },
        {
          "s": 41,
          "text": "ולמעלה יותר5"
        },
        {
          "s": 42,
          "text": "כבוד דאבא וכבוד דאימא."
        },
        {
          "s": 43,
          "text": "ועי\"ז הוא יחוד או\"א ויחוד זו\"ן."
        },
        {
          "s": 44,
          "text": "דעם היות ששניהם"
        },
        {
          "s": 45,
          "text": "(כבוד"
        },
        {
          "s": 46,
          "text": "(וחופה)"
        },
        {
          "s": 47,
          "text": "דאו\"א,"
        },
        {
          "s": 48,
          "text": "וכבוד"
        },
        {
          "s": 49,
          "text": "(וחופה)"
        },
        {
          "s": 50,
          "text": "דזו\"ן)"
        },
        {
          "s": 51,
          "text": "הם בחי' מקיף,"
        },
        {
          "s": 52,
          "text": "מ\"מ ידוע6"
        },
        {
          "s": 53,
          "text": "שדוקא ביחוד זו\"ן"
        },
        {
          "s": 54,
          "text": "(שהוא יחוד פנימי)"
        },
        {
          "s": 55,
          "text": "נמשך העצם."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה המשל הראשון הוא מהשפעת רב לתלמיד,"
        },
        {
          "s": 2,
          "text": "וסדר ההשפעה הוא כמו שארז\"ל7"
        },
        {
          "s": 3,
          "text": "דמקמי דפתח להו לרבנן אמר מילתא דבדיחותא ובדחו רבנן ולבסוף יתיב באימתא ופתח בשמעתא,"
        },
        {
          "s": 4,
          "text": "דהמילתא דבדיחותא שקודם הלימוד"
        },
        {
          "s": 5,
          "text": "[שהו\"ע שיחת חולין של ת\"ח שצריכה לימוד8]"
        },
        {
          "s": 6,
          "text": "היא חיצונית בלבד,"
        },
        {
          "s": 7,
          "text": "אמנם השפעה זו היא הקדמה לההשפעה פנימית"
        },
        {
          "s": 8,
          "text": "(דפתח בשמעתא)"
        },
        {
          "s": 9,
          "text": "כי דוקא עי\"ז נעשה פתיחת הלב והמוח של התלמיד שיהי' כלי לקבלה לההשפעה פנימית."
        },
        {
          "s": 10,
          "text": "והנה מקור משל זה הוא מאדמו\"ר האמצעי בתורת חיים9"
        },
        {
          "s": 11,
          "text": "[אלא שבתו\"ח לא הובא זה כמשל להענין דלכה דודי."
        },
        {
          "s": 12,
          "text": "ובד\"ה סמוכים לעד פר\"ת10"
        },
        {
          "s": 13,
          "text": "(המאמר שאמר כ\"ק אדמו\"ר מהורש\"ב נ\"ע ביום הולדתו"
        },
        {
          "s": 14,
          "text": "(כ' מ\"ח)"
        },
        {
          "s": 15,
          "text": "האחרון בעלמא דין)"
        },
        {
          "s": 16,
          "text": "מקשר בדרך אפשר"
        },
        {
          "s": 17,
          "text": "(\"ואפשר שז\"ע כו'\")"
        },
        {
          "s": 18,
          "text": "הענין דמילתא דבדיחותא להענין דלכה דודי."
        },
        {
          "s": 19,
          "text": "ובד\"ה לכה דודי השמיט כ\"ק מו\"ח אדמו\"ר תיבת \"ואפשר\" וכותב זה בפשטות11],"
        },
        {
          "s": 20,
          "text": "ובתו\"ח שם"
        },
        {
          "s": 21,
          "text": "(לאח\"ז12)"
        },
        {
          "s": 22,
          "text": "מבאר,"
        },
        {
          "s": 23,
          "text": "דשרש ענין השחוק הוא מתענוג הפשוט שבלתי מורכב כלל."
        },
        {
          "s": 24,
          "text": "ומזה מובן,"
        },
        {
          "s": 25,
          "text": "דשרש של מילתא דבדיחותא"
        },
        {
          "s": 26,
          "text": "(שהוא תענוג הפשוט)"
        },
        {
          "s": 27,
          "text": "הוא למעלה מהשפעת השכל שלאח\"ז"
        },
        {
          "s": 28,
          "text": "(שהרי התענוג שבשכל הוא תענוג מורכב)."
        },
        {
          "s": 29,
          "text": "אמנם מ\"מ ה\"ז רק בחי' חיצונית,"
        },
        {
          "s": 30,
          "text": "וע\"י ההשפעה פנימית מגיעים לעילוי נעלה יותר."
        },
        {
          "s": 31,
          "text": "והענין הוא דבתענוג הפשוט גופא יש ב' דרגות13,"
        },
        {
          "s": 32,
          "text": "תענוג הפשוט המורגש ותענוג העצמי הבלתי מורגש."
        },
        {
          "s": 33,
          "text": "ודוקא ע\"י ההשפעה פנימית,"
        },
        {
          "s": 34,
          "text": "שהתלמיד מקבל בפנימיותו,"
        },
        {
          "s": 35,
          "text": "מגיעים לתענוג העצמי הבלתי מורגש."
        },
        {
          "s": 36,
          "text": "ולכן ארז\"ל14"
        },
        {
          "s": 37,
          "text": "ומתלמידי יותר מכולן."
        }
      ]
    }
  ]
}