{
  "globalIndex": 55,
  "owner": 5,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914005_theRebbe_415__p002",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914005_theRebbe_415__p002",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914005_theRebbe_415",
  "title": "מאמר שובה ישראל תשל\"ו",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "והענין הוא,"
        },
        {
          "s": 1,
          "text": "הנה כללות ענין התשובה הוא ענין דילוג10"
        },
        {
          "s": 2,
          "text": "כמו שנת\"ל"
        },
        {
          "s": 3,
          "text": "(בהשיחות),"
        },
        {
          "s": 4,
          "text": "למעלה מסדר והדרגה והשתלשלות."
        },
        {
          "s": 5,
          "text": "דזהו מה שהתשובה היא בשעתא חדא וברגעא חדא11,"
        },
        {
          "s": 6,
          "text": "דענינים שבהדרגה צריך לזה זמן,"
        },
        {
          "s": 7,
          "text": "וכל שהענינים הם נעלים יותר צריך יותר זמן,"
        },
        {
          "s": 8,
          "text": "וכמו לא קאי אינש אדעתא דרבי' עד ארבעין שנין12,"
        },
        {
          "s": 9,
          "text": "שמצד גודל עילוי הענין"
        },
        {
          "s": 10,
          "text": "(של דעתא דרבי')"
        },
        {
          "s": 11,
          "text": "צריך לזה זמן מופלג."
        },
        {
          "s": 12,
          "text": "אמנם ענין התשובה"
        },
        {
          "s": 13,
          "text": "(עם היותו ענין נעלה)"
        },
        {
          "s": 14,
          "text": "הוא בשעתא חדא וברגעא חדא,"
        },
        {
          "s": 15,
          "text": "לפי שעבודת התשובה היא בחילא יתיר13,"
        },
        {
          "s": 16,
          "text": "באופן של דילוג שלא בהדרגה."
        },
        {
          "s": 17,
          "text": "והדילוג שבענין התשובה הוא מה שמדלג מענין הפכי,"
        },
        {
          "s": 18,
          "text": "והיינו דלא רק שהיא באופן דאין ערוך כהעליות דאין ערוך שבקדושה גופא,"
        },
        {
          "s": 19,
          "text": "כי אם,"
        },
        {
          "s": 20,
          "text": "שמדלג מענין הפכי."
        },
        {
          "s": 21,
          "text": "דזהו גם בתשובה סתם,"
        },
        {
          "s": 22,
          "text": "שבתחילה הי' בצד ההיפך וברגעא חדא נעשה לבעל תשובה."
        },
        {
          "s": 23,
          "text": "ובפרט בתשובה מאה\"ר שזדונות נעשים לו כזכיות14,"
        },
        {
          "s": 24,
          "text": "שהיא דילוג מקצה היותר תחתון לקצה היותר עליון,"
        },
        {
          "s": 25,
          "text": "שהרי בתחילה היו לו לא רק עבירות סתם כ\"א זדונות,"
        },
        {
          "s": 26,
          "text": "קצה הכי תחתון,"
        },
        {
          "s": 27,
          "text": "וע\"י התשובה נעשים כזכיות,"
        },
        {
          "s": 28,
          "text": "שזכיות אלו"
        },
        {
          "s": 29,
          "text": "(הנעשים מזדונות)"
        },
        {
          "s": 30,
          "text": "הם נעלים יותר גם מזכיות הצדיקים,"
        },
        {
          "s": 31,
          "text": "קצה הכי עליון."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "והנה ידוע פירוש אדמו\"ר הזקן15"
        },
        {
          "s": 1,
          "text": "במרז\"ל16"
        },
        {
          "s": 2,
          "text": "תכלית חכמה תשובה ומעשים טובים,"
        },
        {
          "s": 3,
          "text": "שהטעם מה שמקדים תשובה למעשים טובים הוא לפי שע\"י קדימת התשובה המעשים הם מעשים טובים ומאירים."
        },
        {
          "s": 4,
          "text": "כי עבודת התשובה פועלת גם בהעבודה דתומ\"צ."
        },
        {
          "s": 5,
          "text": "ולכן,"
        },
        {
          "s": 6,
          "text": "מכיון שעבודת התשובה היא בדרך דילוג שלא בהדרגה,"
        },
        {
          "s": 7,
          "text": "הנה זה פועל שעד\"ז יהי' גם בהעבודה דתומ\"צ ועד בהעבודה דוכל מעשיך יהיו לשם שמים17,"
        },
        {
          "s": 8,
          "text": "שגם עבודה זו יהי' באופן שלמעלה מסדר והדרגה,"
        },
        {
          "s": 9,
          "text": "דוגמת ענין הדילוג שבתשובה."
        },
        {
          "s": 10,
          "text": "וכמבואר בארוכה בהמשך תרס\"ו בהמאמר שלפני ד\"ה שובה ישראל18"
        },
        {
          "s": 11,
          "text": "ונתבאר גם במאמר הקודם"
        },
        {
          "s": 12,
          "text": "(ד\"ה זה היום19)"
        },
        {
          "s": 13,
          "text": "שלימוד התורה צ\"ל ע\"י קדימת הביטול,"
        },
        {
          "s": 14,
          "text": "כמ\"ש ונפשי כעפר לכל תהי'"
        },
        {
          "s": 15,
          "text": "(ועי\"ז דוקא)"
        },
        {
          "s": 16,
          "text": "פתח לבי בתורתך20."
        },
        {
          "s": 17,
          "text": "ועד שגם בהדרגות דלימוד התורה גופא"
        },
        {
          "s": 18,
          "text": "(כאשר הדרגות הם באין ערוך),"
        },
        {
          "s": 19,
          "text": "צריך להיות תחילה ביטול השגת דרגא הקודמת,"
        },
        {
          "s": 20,
          "text": "וכמו ר\"ז צם מאה תעניתא לשכוח תלמוד בבלי בכדי להשיג תלמוד ירושלמי21."
        },
        {
          "s": 21,
          "text": "ועד\"ז הוא גם בקיום המצוות,"
        },
        {
          "s": 22,
          "text": "שצ\"ל בזה גם העבודה שלמעלה ממדידה והגבלה,"
        },
        {
          "s": 23,
          "text": "וכמ\"ש22"
        },
        {
          "s": 24,
          "text": "ואהבת את ה\"א בכל לבבך ובכל נפשך ובכל מאדך,"
        },
        {
          "s": 25,
          "text": "שאינו מספיק שקיום המצוות תהי' בהאהבה דבכל לבבך ובכל נפשך שהיא אהבה שבהגבלה כ\"א צריך שיהי' גם האהבה דבכל מאדך שהיא למעלה ממדידה והגבלה23."
        },
        {
          "s": 26,
          "text": "וענין זה הוא למעלה באין ערוך מקיום המצוות סתם,"
        },
        {
          "s": 27,
          "text": "כי העבודה דבכל מאדך הו\"ע עושין רצונו של מקום24"
        },
        {
          "s": 28,
          "text": "כידוע תורת הרב המגיד25"
        },
        {
          "s": 29,
          "text": "(היינו שהוא עושה את הרצון),"
        },
        {
          "s": 30,
          "text": "ומזה מובן שהוא למעלה באין ערוך מקיום המצוות"
        },
        {
          "s": 31,
          "text": "(סתם),"
        },
        {
          "s": 32,
          "text": "דקיום המצוות"
        },
        {
          "s": 33,
          "text": "(סתם)"
        },
        {
          "s": 34,
          "text": "הוא שכבר ישנו הרצון והאדם הוא רק מקיים את הרצון,"
        },
        {
          "s": 35,
          "text": "משא\"כ בהאהבה דבכל מאדך הוא עושה רצונו של מקום."
        },
        {
          "s": 36,
          "text": "וענין זה"
        },
        {
          "s": 37,
          "text": "(דבכל מאדך)"
        },
        {
          "s": 38,
          "text": "צריך להיות לא רק בהענין דקיום המצוות אלא גם בהעבודה דוכל מעשיך יהיו לשם שמים,"
        },
        {
          "s": 39,
          "text": "שהרי יש עוד פירוש בבכל מאדך,"
        },
        {
          "s": 40,
          "text": "כמרז\"ל26"
        },
        {
          "s": 41,
          "text": "בכל מאדך בכל ממונך,"
        },
        {
          "s": 42,
          "text": "שהו\"ע בכל מעשיך,"
        },
        {
          "s": 43,
          "text": "וגם פירוש זה בבכל מאדך שייך לפירוש הנ\"ל בבכל מאדך,"
        },
        {
          "s": 44,
          "text": "היינו שגם בכל ממונך,"
        },
        {
          "s": 45,
          "text": "כל מעשיך,"
        },
        {
          "s": 46,
          "text": "צ\"ל ואהבת את ה\"א לא רק בכל לבבך ולא רק בכל נפשך אלא גם בכל מאדך,"
        },
        {
          "s": 47,
          "text": "למעלה ממדידה והגבלה."
        },
        {
          "s": 48,
          "text": "אלא שענין הדילוג שלא בהדרגה שבתומ\"צ וכל מעשיך לש\"ש"
        },
        {
          "s": 49,
          "text": "(הנפעל מענין הדילוג שבתשובה)"
        },
        {
          "s": 50,
          "text": "הוא מה שבקדושה גופא העלי' היא באופן דאין ערוך,"
        },
        {
          "s": 51,
          "text": "משא\"כ בתשובה הוא הדילוג מצד ההיפך."
        },
        {
          "s": 52,
          "text": "ועד שהדילוג הוא מקצה הכי תחתון לקצה הכי עליון,"
        },
        {
          "s": 53,
          "text": "כנ\"ל."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "והנה הכח לעבודת התשובה שהיא בדרך דילוג לגמרי כנ\"ל הוא מצד בחינת ישראל."
        },
        {
          "s": 1,
          "text": "והגם שישראל הוא אותיות"
        },
        {
          "s": 2,
          "text": "(לי)"
        },
        {
          "s": 3,
          "text": "ראש27,"
        },
        {
          "s": 4,
          "text": "וענין הראש הוא שיש לו שייכות להגוף והרגל28,"
        },
        {
          "s": 5,
          "text": "מ\"מ הרי ישראל הוא אותיות לי ראש"
        },
        {
          "s": 6,
          "text": "(דראש הוא לי – בטל אליו"
        },
        {
          "s": 7,
          "text": "(וכפשטות הלשון והענין דשרית – שררה ונצחון דמלחמה)),"
        },
        {
          "s": 8,
          "text": "ומצד בחינה זו יכול להיות ענין הדילוג שלמעלה ממדידה."
        },
        {
          "s": 9,
          "text": "וזהו שובה ישראל,"
        },
        {
          "s": 10,
          "text": "כי הכח לשובה הוא מצד בחינת ישראל דוקא."
        },
        {
          "s": 11,
          "text": "ומכיון שבחינה זו ישנה בכאו\"א מישראל,"
        },
        {
          "s": 12,
          "text": "גם בזה שכשלת בעונך,"
        },
        {
          "s": 13,
          "text": "כמרז\"ל29"
        },
        {
          "s": 14,
          "text": "ישראל אע\"פ שחטא ישראל הוא,"
        },
        {
          "s": 15,
          "text": "ועד שישנה אפילו גם בזה שהוא דוגמת מי שממנו לומדים ישראל אע\"פ שחטא ישראל הוא,"
        },
        {
          "s": 16,
          "text": "לכן יש לכאו\"א הכח לתשובה."
        },
        {
          "s": 17,
          "text": "ומצד בחינה זו יכול להיות ענין התשובה גם בבחינת יעקב,"
        },
        {
          "s": 18,
          "text": "כי שמו העיקרי והעצמי של כאו\"א מישראל הוא ישראל,"
        },
        {
          "s": 19,
          "text": "היינו שבחינה זו היא העיקר והעצם שבו,"
        },
        {
          "s": 20,
          "text": "לכן היא פועלת גם על בחינת יעקב."
        },
        {
          "s": 21,
          "text": "וזהו גם מה שממשיך כי כשלת בעונך,"
        },
        {
          "s": 22,
          "text": "דהנה ידוע מאמר רבותינו נשיאינו30,"
        },
        {
          "s": 23,
          "text": "שכשם שצריך לידע חסרונות עצמו כן צריך לדעת מעלות עצמו,"
        },
        {
          "s": 24,
          "text": "ולכן אומר כי כשלת גו' שהוא רק ענין של כשלון בלבד,"
        },
        {
          "s": 25,
          "text": "שע\"י שרגלו נתקל בעץ או באבן זה פועל הכשלון בהראש,"
        },
        {
          "s": 26,
          "text": "ובחינת ישראל היא בשלימות."
        },
        {
          "s": 27,
          "text": "ובכ\"ז צ\"ל ענין התשובה בכל תוקפה כי מכיון שהוא בחינת ישראל,"
        },
        {
          "s": 28,
          "text": "הרי לגבי מדריגתו צריך לתשובה גם על ענין זה."
        },
        {
          "s": 29,
          "text": "ואדרבה,"
        },
        {
          "s": 30,
          "text": "מצד מדריגתו הנעלית,"
        },
        {
          "s": 31,
          "text": "הנה גם ענין קל נוגע יותר מפגם גדול בבחינת יעקב,"
        },
        {
          "s": 32,
          "text": "וע\"ד שאמרו בתניא31"
        },
        {
          "s": 33,
          "text": "ובשבת32"
        },
        {
          "s": 34,
          "text": "בנוגע לרבב על בגד ת\"ח הנק' בנאים,"
        },
        {
          "s": 35,
          "text": "וע\"ד המבואר בתניא33"
        },
        {
          "s": 36,
          "text": "בנוגע להרהור שבמחשבה שזה נוגע הרבה יותר מענין הדיבור כו'."
        }
      ]
    }
  ]
}