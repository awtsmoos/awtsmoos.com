{
  "globalIndex": 970,
  "owner": 20,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919515_theRebbe_764__p006",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919515_theRebbe_764__p006",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919515_theRebbe_764",
  "title": "מאמר גדול יהי' תשכ\"ב",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר הביאור בזה בהקדים דמזה שאומרים שהוי' הוא הי' הוה ויהי'"
        },
        {
          "s": 1,
          "text": "(כאחד),"
        },
        {
          "s": 2,
          "text": "דהי' הוה ויהי' הו\"ע הזמן,"
        },
        {
          "s": 3,
          "text": "מובן,"
        },
        {
          "s": 4,
          "text": "שגם העולם כמו שמתהווה משם הוי' יש בו ענין הזמן,"
        },
        {
          "s": 5,
          "text": "אלא שהזמן שבעולם זה הוא באופן שהעבר ההוה והעתיד הם כאחד."
        },
        {
          "s": 6,
          "text": "ועד\"ז הוא במקום שגם העולם כמו שמתהווה משם הוי' יש בו ענין המקום אלא שהששה קצוות דמקום הם כאחד."
        },
        {
          "s": 7,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 8,
          "text": "דהטעם על זה שהזמן ומקום דהעולם כמו שמתהווה משם הוי' אינם בהגבלה והתחלקות"
        },
        {
          "s": 9,
          "text": "(אף שגם העולם כמו שמתהווה משם הוי' הוא באין ערוך להמקור המהווה אותו),"
        },
        {
          "s": 10,
          "text": "הוא מפני הביטול שבו."
        },
        {
          "s": 11,
          "text": "דכיון שענינם של העבר ההוה והעתיד"
        },
        {
          "s": 12,
          "text": "(וכן ענינם של הששה קצוות)"
        },
        {
          "s": 13,
          "text": "הוא לא המציאות שלהם אלא זה שהוי' מהוה אותם,"
        },
        {
          "s": 14,
          "text": "לכן אינם סותרים זל\"ז והם כאחד."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז צריך לומר,"
        },
        {
          "s": 1,
          "text": "דהמבואר בכ\"מ שהמקום דקודש הקדשים הוא משם אלקים"
        },
        {
          "s": 2,
          "text": "(אף שגם מקום זה הי' למעלה מגדר מקום),"
        },
        {
          "s": 3,
          "text": "הוא,"
        },
        {
          "s": 4,
          "text": "כי המקום דקודש הקדשים"
        },
        {
          "s": 5,
          "text": "(עשרים אמה על עשרים אמה)"
        },
        {
          "s": 6,
          "text": "הי' באופן דהתחלקות,"
        },
        {
          "s": 7,
          "text": "שכל אמה היא במקום אחר,"
        },
        {
          "s": 8,
          "text": "וההתחלקות דמקום הוא משם אלקים."
        },
        {
          "s": 9,
          "text": "וזהו שמקום הארון אינו מן המדה הו\"ע יחוד הוי' ואלקים58,"
        },
        {
          "s": 10,
          "text": "שההגבלה וההתחלקות דמקום הארון היא מצד אלקים,"
        },
        {
          "s": 11,
          "text": "וזה שהי' אינו מן המדה הוא מצד הגילוי דשם הוי' שהאיר בגילוי בהמקום שנתהווה משם אלקים,"
        },
        {
          "s": 12,
          "text": "יחוד הוי' ואלקים."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וצריך להבין,"
        },
        {
          "s": 2,
          "text": "דזה שמצד שם אלקים הוא ההתחלקות דמקום וזמן הוא לפי שהזמן והמקום כמו שמתהווים משם אלקים הם מציאות,"
        },
        {
          "s": 3,
          "text": "דכאשר נרגש בהששה קצוות דמקום ובהעבר הוה ועתיד דזמן שענינם הוא שאלקות מהווה אותם הם כולם כאחד"
        },
        {
          "s": 4,
          "text": "(כנ\"ל סעיף ו),"
        },
        {
          "s": 5,
          "text": "ואיך שייך שבמקום הארון"
        },
        {
          "s": 6,
          "text": "(מקום שבהתחלקות,"
        },
        {
          "s": 7,
          "text": "שמורה שהוא מציאות)"
        },
        {
          "s": 8,
          "text": "יהי' גילוי שם הוי'"
        },
        {
          "s": 9,
          "text": "(אינו מן המדה)59."
        },
        {
          "s": 10,
          "text": "ונקודת הביאור בזה60,"
        },
        {
          "s": 11,
          "text": "שהצמצום וההסתר דשם אלקים הוא רק לגבי הנבראים,"
        },
        {
          "s": 12,
          "text": "אבל לגבי שם הוי' אינו מסתיר כלל."
        },
        {
          "s": 13,
          "text": "ולכן,"
        },
        {
          "s": 14,
          "text": "גם לאחרי ההתלבשות דשם הוי' בשם אלקים שעי\"ז נעשה העולם מציאות,"
        },
        {
          "s": 15,
          "text": "מ\"מ,"
        },
        {
          "s": 16,
          "text": "אין המציאות מסתיר לגבי',"
        },
        {
          "s": 17,
          "text": "וגם בהמציאות"
        },
        {
          "s": 18,
          "text": "(שנעשה ע\"י ההעלם דשם אלקים)"
        },
        {
          "s": 19,
          "text": "שעי\"ז נעשה ההתחלקות דמקום וזמן מאיר הגילוי דשם הוי',"
        },
        {
          "s": 20,
          "text": "שענינו דהעולם הוא זה שהוי' מהווה אותו."
        },
        {
          "s": 21,
          "text": "וכידוע המשל מרב ותלמיד,"
        },
        {
          "s": 22,
          "text": "דכאשר התלמיד הוא באין ערוך להרב,"
        },
        {
          "s": 23,
          "text": "צריך הרב להעלים את עצם שכלו ושישאר רק החיצוניות,"
        },
        {
          "s": 24,
          "text": "וגם החיצוניות צריך להגביל ולהעלים בלבושים והסברים ובמשלים."
        },
        {
          "s": 25,
          "text": "שהצמצום וההעלם הוא רק לגבי התלמיד ולא לגבי הרב."
        },
        {
          "s": 26,
          "text": "דהרב רואה את עצם שכלו גם בהחיצוניות וגם בהלבושים ובהמשלים."
        }
      ]
    }
  ]
}