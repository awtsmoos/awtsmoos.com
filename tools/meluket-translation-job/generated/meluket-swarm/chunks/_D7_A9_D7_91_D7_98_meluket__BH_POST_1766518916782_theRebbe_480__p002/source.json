{
  "globalIndex": 512,
  "owner": 12,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916782_theRebbe_480__p002",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916782_theRebbe_480__p002",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916782_theRebbe_480",
  "title": "מאמר באתי לגני תשכ\"ט",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והטעם שע\"י העבודה דאתכפיא ואתהפכא נמשך אור זה שלמעלה משייכות לעולמות,"
        },
        {
          "s": 2,
          "text": "מבאר בהמאמר,"
        },
        {
          "s": 3,
          "text": "כי יתרון האור הוא מן החושך דוקא18,"
        },
        {
          "s": 4,
          "text": "דכאשר החושך נהפך לאור נעשה יתרון בהאור."
        },
        {
          "s": 5,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 6,
          "text": "דהמשכת עיקר שכינה בתחתונים עכשיו"
        },
        {
          "s": 7,
          "text": "(לאחרי שנסתלקה ע\"י ז' הענינים הבלתי רצויים,"
        },
        {
          "s": 8,
          "text": "מתחיל מחטא עה\"ד)"
        },
        {
          "s": 9,
          "text": "ע\"י העבודה דאתכפיא ואתהפכא,"
        },
        {
          "s": 10,
          "text": "היא נעלית יותר מהמשכת עיקר שכינה בתחתונים ע\"י עבודת אדם הראשון19"
        },
        {
          "s": 11,
          "text": "בג\"ע קודם החטא."
        },
        {
          "s": 12,
          "text": "כי העבודה אז היתה להמשיך אלקות מלמעלה,"
        },
        {
          "s": 13,
          "text": "משא\"כ עכשיו,"
        },
        {
          "s": 14,
          "text": "שהעבודה היא להפוך החושך לאור,"
        },
        {
          "s": 15,
          "text": "הנה ההמשכה שע\"י עבודה זו היא המשכה נעלית יותר."
        },
        {
          "s": 16,
          "text": "וזהו20"
        },
        {
          "s": 17,
          "text": "שהמשכן הי' מעצי שטים,"
        },
        {
          "s": 18,
          "text": "שטים מלשון שטות21,"
        },
        {
          "s": 19,
          "text": "כי העבודה דועשו לי מקדש היא להפוך השטות דלעו\"ז לשטות דקדושה,"
        },
        {
          "s": 20,
          "text": "ועי\"ז נעשה ושכנתי בתוכם,"
        },
        {
          "s": 21,
          "text": "המשכת עיקר שכינה בתחתונים,"
        },
        {
          "s": 22,
          "text": "למעלה יותר מכמו שהי' קודם החטא."
        },
        {
          "s": 23,
          "text": "וכח זה ניתן לכאו\"א מישראל,"
        },
        {
          "s": 24,
          "text": "שע\"י שלוחם עם השטות דלעו\"ז ומהפכו לשטות דקדושה,"
        },
        {
          "s": 25,
          "text": "נעשתה המשכת עיקר שכינה בתחתונים,"
        },
        {
          "s": 26,
          "text": "עד לדרגא הכי נעלית דעיקר שכינה,"
        },
        {
          "s": 27,
          "text": "ועד להמשכת העצמות."
        },
        {
          "s": 28,
          "text": "ועי\"ז דוקא22"
        },
        {
          "s": 29,
          "text": "נשלמת הכוונה דדירה לו ית' בתחתונים23,"
        },
        {
          "s": 30,
          "text": "שעוה\"ז התחתון שאין תחתון למטה ממנו24"
        },
        {
          "s": 31,
          "text": "נעשה דירה לו ית',"
        },
        {
          "s": 32,
          "text": "לו לעצמותו25."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר26,"
        },
        {
          "s": 2,
          "text": "דזהו שישראל נק' בשם צבאות הוי'27,"
        },
        {
          "s": 3,
          "text": "דכל אחד מישראל הוא חיל בצבאות ה'"
        },
        {
          "s": 4,
          "text": "(צבא מלשון חיל),"
        },
        {
          "s": 5,
          "text": "שיוצא למלחמה,"
        },
        {
          "s": 6,
          "text": "לכבוש את העולם ולעשותו דירה לו ית'."
        },
        {
          "s": 7,
          "text": "ובכדי שישראל ינצחו את המלחמה,"
        },
        {
          "s": 8,
          "text": "נותנים להם מלמעלה כחות מיוחדים על זה."
        },
        {
          "s": 9,
          "text": "דכמו שבמלחמה בגשמיות,"
        },
        {
          "s": 10,
          "text": "בכדי לנצח את המלחמה מבזבזים את האוצרות28,"
        },
        {
          "s": 11,
          "text": "דהגם שע\"ד הרגיל הם כמוסים וחתומים מעין כל רואה"
        },
        {
          "s": 12,
          "text": "(ומכש\"כ שאין משתמשים בהם אפילו לצורך גדול),"
        },
        {
          "s": 13,
          "text": "ומ\"מ בכדי לנצח את המנגדים מבזבזים כל האוצרות,"
        },
        {
          "s": 14,
          "text": "והטעם לזה הוא כי הנצח מושרש בעצם הנפש,"
        },
        {
          "s": 15,
          "text": "דשם"
        },
        {
          "s": 16,
          "text": "(בעצם הנפש)"
        },
        {
          "s": 17,
          "text": "אין שייך חשבונות,"
        },
        {
          "s": 18,
          "text": "דעד\"ז הוא גם למעלה,"
        },
        {
          "s": 19,
          "text": "דשרש הנצח הוא בפנימיות הכתר בחינת לא אדם29,"
        },
        {
          "s": 20,
          "text": "ולכן,"
        },
        {
          "s": 21,
          "text": "בכדי שהצבאות הוי' ינצחו את המלחמה,"
        },
        {
          "s": 22,
          "text": "נותנים להם,"
        },
        {
          "s": 23,
          "text": "ובאופן דבזבוז,"
        },
        {
          "s": 24,
          "text": "בחינת האוצר שלמעלה."
        },
        {
          "s": 25,
          "text": "ובכדי לבאר ענין האוצר שלמעלה,"
        },
        {
          "s": 26,
          "text": "מקדים30"
        },
        {
          "s": 27,
          "text": "מאמר התקו\"ז31"
        },
        {
          "s": 28,
          "text": "אור א\"ס למעלה מעלה32"
        },
        {
          "s": 29,
          "text": "עד אין קץ ולמטה מטה32"
        },
        {
          "s": 30,
          "text": "עד אין תכלית."
        },
        {
          "s": 31,
          "text": "ומבאר33"
        },
        {
          "s": 32,
          "text": "שב' ענינים אלו הם"
        },
        {
          "s": 33,
          "text": "(גם)"
        },
        {
          "s": 34,
          "text": "ב' מדריגות באוא\"ס גופא."
        },
        {
          "s": 35,
          "text": "דלמטה מטה עד אין תכלית הוא האור שבבחינת גילוי בעצמותו כביכול וממנו בא אח\"כ הגילוי בעולמות,"
        },
        {
          "s": 36,
          "text": "ולמעלה מעלה עד אין קץ הוא עצם האור שאינו בגדר גילוי גם בעצמותו."
        },
        {
          "s": 37,
          "text": "וענין האוצר שלמעלה הוא העצמות שלמעלה מאור וגילוי,"
        },
        {
          "s": 38,
          "text": "גם מעצם האור."
        },
        {
          "s": 39,
          "text": "דהגם שגם עצם האור,"
        },
        {
          "s": 40,
          "text": "מכיון שאינו בגדר גילוי גם בעצמותו"
        },
        {
          "s": 41,
          "text": "(כנ\"ל)"
        },
        {
          "s": 42,
          "text": "נק' אוצר,"
        },
        {
          "s": 43,
          "text": "מ\"מ מזה שגם עצם האור נק' בשם אור"
        },
        {
          "s": 44,
          "text": "(גילוי),"
        },
        {
          "s": 45,
          "text": "מובן,"
        },
        {
          "s": 46,
          "text": "שעיקר ענין האוצר"
        },
        {
          "s": 47,
          "text": "[שענינו הוא שהוא סתום ונעלם]"
        },
        {
          "s": 48,
          "text": "הוא העצמות,"
        },
        {
          "s": 49,
          "text": "שאינו בגדר אור כלל34."
        },
        {
          "s": 50,
          "text": "ואוצר זה נותנים,"
        },
        {
          "s": 51,
          "text": "ובאופן דבזבוז,"
        },
        {
          "s": 52,
          "text": "לצבאות הוי',"
        },
        {
          "s": 53,
          "text": "בכדי לנצח המלחמה."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "וממשיך בפרק י\"ט"
        },
        {
          "s": 2,
          "text": "(הפרק השייך לשנה זו35),"
        },
        {
          "s": 3,
          "text": "דמכיון שהנצח מושרש בעצם הנפש שלמעלה מכחות הגלויים"
        },
        {
          "s": 4,
          "text": "[דכמו\"כ הוא למעלה ששרש הנצח הוא בפנימיות הכתר,"
        },
        {
          "s": 5,
          "text": "כנ\"ל],"
        },
        {
          "s": 6,
          "text": "לכן במדת הנצח יכולים להגיע לאוצר העליון."
        },
        {
          "s": 7,
          "text": "והיינו דזה שבכדי לנצח את המלחמה נותנים לישראל"
        },
        {
          "s": 8,
          "text": "(ובאופן דבזבוז)"
        },
        {
          "s": 9,
          "text": "האוצר שלמעלה הוא לא רק מפני ששרש הנצח הוא בדרגא כזו"
        },
        {
          "s": 10,
          "text": "(פנימיות הכתר)"
        },
        {
          "s": 11,
          "text": "שאין שייך שם חשבונות"
        },
        {
          "s": 12,
          "text": "[ובדוגמת בזבוז האוצרות בשביל נצוח המלחמה בגשמיות,"
        },
        {
          "s": 13,
          "text": "שמכיון שבעצם הנפש"
        },
        {
          "s": 14,
          "text": "(שרש הנצח)"
        },
        {
          "s": 15,
          "text": "אין חשבונות לכן בשביל הנצחון מבזבזים את האוצרות,"
        },
        {
          "s": 16,
          "text": "אבל הנצחון והאוצרות הם שני ענינים],"
        },
        {
          "s": 17,
          "text": "אלא שע\"י הנצח מגיעים לאוצר העליון."
        },
        {
          "s": 18,
          "text": "ומוסיף בהמאמר \"פירוש דהתגלות והמשכת אוצר העליון הוא במדת הנצח\"."
        },
        {
          "s": 19,
          "text": "דענין זה,"
        },
        {
          "s": 20,
          "text": "שבמדת הנצח מתגלה ונמשך אוצר העליון,"
        },
        {
          "s": 21,
          "text": "הוא חידוש גדול יותר מזה שע\"י הנצח מגיעים להאוצר."
        },
        {
          "s": 22,
          "text": "דזה שע\"י הנצח מגיעים לאוצר העליון,"
        },
        {
          "s": 23,
          "text": "אף שהאוצר הוא סתום ונעלם,"
        },
        {
          "s": 24,
          "text": "מצינו עד\"ז גם בענין התשובה,"
        },
        {
          "s": 25,
          "text": "וכמבואר בלקו\"ת36"
        },
        {
          "s": 26,
          "text": "בפירוש הכתוב37"
        },
        {
          "s": 27,
          "text": "לך אמר לבי בקשו פני את פניך הוי' אבקש,"
        },
        {
          "s": 28,
          "text": "שע\"י התשובה מעומק פנימיות הלב,"
        },
        {
          "s": 29,
          "text": "בקשו פני,"
        },
        {
          "s": 30,
          "text": "מגיעים לבחינת הפנים שלמעלה,"
        },
        {
          "s": 31,
          "text": "פניך הוי'."
        },
        {
          "s": 32,
          "text": "דהגם שבחינת הפנים שלמעלה הוא למעלה מגילוי,"
        },
        {
          "s": 33,
          "text": "כמ\"ש38"
        },
        {
          "s": 34,
          "text": "ופני לא יראו,"
        },
        {
          "s": 35,
          "text": "הוא בבחינת המשכה מלמעלה למטה,"
        },
        {
          "s": 36,
          "text": "אבל בבחינת העלאה את פניך הוי' אבקש39."
        },
        {
          "s": 37,
          "text": "ומזה מובן בנוגע לעניננו – מדת הנצח,"
        },
        {
          "s": 38,
          "text": "דזה שע\"י הנצח יכולים להגיע לאוצר העליון,"
        },
        {
          "s": 39,
          "text": "\"להגיע\" מלמטה למעלה,"
        },
        {
          "s": 40,
          "text": "אין זה חידוש כ\"כ,"
        },
        {
          "s": 41,
          "text": "ועיקר החידוש הוא שבמדת הנצח הוא התגלות והמשכת אוצר העליון,"
        },
        {
          "s": 42,
          "text": "התגלות והמשכה מלמעלה."
        },
        {
          "s": 43,
          "text": "וצריך להבין,"
        },
        {
          "s": 44,
          "text": "הרי ענינו של אוצר הוא שהוא סתום ונעלם,"
        },
        {
          "s": 45,
          "text": "למעלה מבחינת גילוי"
        },
        {
          "s": 46,
          "text": "[ובפרט לפי מה שנת\"ל"
        },
        {
          "s": 47,
          "text": "(סעיף ד)"
        },
        {
          "s": 48,
          "text": "שעיקר ענין האוצר הוא העצמות שאינו בגדר אור כלל],"
        },
        {
          "s": 49,
          "text": "והיאך שייך שתהי' התגלותו והמשכתו במדת הנצח."
        }
      ]
    }
  ]
}