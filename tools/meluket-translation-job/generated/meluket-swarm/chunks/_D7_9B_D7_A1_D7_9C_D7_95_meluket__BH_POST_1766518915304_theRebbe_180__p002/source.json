{
  "globalIndex": 256,
  "owner": 6,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915304_theRebbe_180__p002",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915304_theRebbe_180__p002",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915304_theRebbe_180",
  "title": "מאמר ושבתי בשלום תשל\"ח",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים מ\"ש בדרושי רבותינו נשיאינו16"
        },
        {
          "s": 2,
          "text": "(מיוסד על מ\"ש בזהר17)"
        },
        {
          "s": 3,
          "text": "עה\"פ ויצא יעקב מבאר שבע גו',"
        },
        {
          "s": 4,
          "text": "שיש בזה ב' פירושים,"
        },
        {
          "s": 5,
          "text": "פירוש א',"
        },
        {
          "s": 6,
          "text": "שבאר שבע הוא באר שבע דאברהם"
        },
        {
          "s": 7,
          "text": "(שקרא למקום ההוא באר שבע כי שם נשבעו שניהם18),"
        },
        {
          "s": 8,
          "text": "ופירוש ב',"
        },
        {
          "s": 9,
          "text": "שבאר שבע הוא באר שבע דיצחק"
        },
        {
          "s": 10,
          "text": "(שקרא אותה שבעה,"
        },
        {
          "s": 11,
          "text": "ע\"ש הבאר השביעית19)."
        },
        {
          "s": 12,
          "text": "וכ\"ה גם בפשטות,"
        },
        {
          "s": 13,
          "text": "שהרי ויצא יעקב מבאר שבע הי' בזמנו של יצחק"
        },
        {
          "s": 14,
          "text": "(כו\"כ שנים לאחרי הסתלקות אברהם)."
        },
        {
          "s": 15,
          "text": "וההפרש בין ב' הענינים הוא,"
        },
        {
          "s": 16,
          "text": "דבאר שבע דאברהם הוא בינה"
        },
        {
          "s": 17,
          "text": "(יסוד אימא)."
        },
        {
          "s": 18,
          "text": "שהרי אברהם הוא חכמה"
        },
        {
          "s": 19,
          "text": "[אלא שמתחילה נקרא אברם,"
        },
        {
          "s": 20,
          "text": "אב רם,"
        },
        {
          "s": 21,
          "text": "שהחכמה"
        },
        {
          "s": 22,
          "text": "(אב)"
        },
        {
          "s": 23,
          "text": "שבו היתה בבחי' שכל הנעלם מכל רעיון20,"
        },
        {
          "s": 24,
          "text": "ואח\"כ נקרא אברהם שנעשה אב המון גוים21,"
        },
        {
          "s": 25,
          "text": "שהחכמה"
        },
        {
          "s": 26,
          "text": "(אב)"
        },
        {
          "s": 27,
          "text": "שבו נמשכה בגילוי גם למטה עד לבחי' המון גוים22],"
        },
        {
          "s": 28,
          "text": "ובאר שבע דאברהם"
        },
        {
          "s": 29,
          "text": "[המקום דאברהם,"
        },
        {
          "s": 30,
          "text": "המקבל שלו,"
        },
        {
          "s": 31,
          "text": "בחי' שרה23]"
        },
        {
          "s": 32,
          "text": "הוא בינה,"
        },
        {
          "s": 33,
          "text": "ונקראת באר שבע לפי שהיא המקור המשפיע לשבע מדות."
        },
        {
          "s": 34,
          "text": "ולפי זה,"
        },
        {
          "s": 35,
          "text": "פירוש ויצא יעקב מבאר שבע וילך חרנה הוא שיצא ונמשך מבחי' בינה למלכות."
        },
        {
          "s": 36,
          "text": "ובאר שבע דיצחק הוא מלכות."
        },
        {
          "s": 37,
          "text": "כי יצחק הוא בינה24,"
        },
        {
          "s": 38,
          "text": "והמקבל דבינה היא מלכות25,"
        },
        {
          "s": 39,
          "text": "ונקראת באר שבע על שם שהיא מקבלת משבע מדות"
        },
        {
          "s": 40,
          "text": "[וכידוע שהמלכות נקראת כנסת ישראל,"
        },
        {
          "s": 41,
          "text": "לפי שהיא כונסת לתוכה בחי' המדות26]."
        },
        {
          "s": 42,
          "text": "ולפי זה,"
        },
        {
          "s": 43,
          "text": "פירוש ויצא יעקב מבאר שבע וילך חרנה קאי על היציאה וההמשכה לעולמות בי\"ע,"
        },
        {
          "s": 44,
          "text": "ומשם יפרד27."
        },
        {
          "s": 45,
          "text": "וכ\"ה גם בפשטות ענין היציאה,"
        },
        {
          "s": 46,
          "text": "שהרי ויצא יעקב הי' בכדי לברר הניצוצות שהיו אצל לבן"
        },
        {
          "s": 47,
          "text": "(כמסופר בפרשת ויצא)"
        },
        {
          "s": 48,
          "text": "[ולאח\"ז גם הניצוצות שהיו אצל עשו"
        },
        {
          "s": 49,
          "text": "(כמסופר בפרשת וישלח)],"
        },
        {
          "s": 50,
          "text": "ובירור הניצוצות הוא בעולמות בי\"ע."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וזהו גם ששם הסדרה"
        },
        {
          "s": 2,
          "text": "[המורה על ענינה ותוכנה28]"
        },
        {
          "s": 3,
          "text": "הוא ויצא,"
        },
        {
          "s": 4,
          "text": "כי כל ענין הבירורים שבירר יעקב אצל לבן המבואר בהסדרה"
        },
        {
          "s": 5,
          "text": "[וגם מה שבירר אצל עשו המבואר בפרשת וישלח,"
        },
        {
          "s": 6,
          "text": "שבא לאחרי ובהמשך להבירורים שבירר אצל לבן29]"
        },
        {
          "s": 7,
          "text": "הותחל מיציאתו מבאר שבע – ענין ויצא."
        },
        {
          "s": 8,
          "text": "וזה שיציאתו היתה באופן כזה שיברר הניצוצות שבחרן,"
        },
        {
          "s": 9,
          "text": "ותהי' מטתו שלימה,"
        },
        {
          "s": 10,
          "text": "לא כאברהם שיצא ממנו ישמעאל ולא כיצחק שיצא ממנו עשו30,"
        },
        {
          "s": 11,
          "text": "הענין הוא,"
        },
        {
          "s": 12,
          "text": "דהנה כתיב31"
        },
        {
          "s": 13,
          "text": "וידו אוחזת בעקב עשו"
        },
        {
          "s": 14,
          "text": "(ולכן)"
        },
        {
          "s": 15,
          "text": "ויקרא שמו יעקב."
        },
        {
          "s": 16,
          "text": "שבשם יעקב יש ב' חלקים."
        },
        {
          "s": 17,
          "text": "יו\"ד"
        },
        {
          "s": 18,
          "text": "(ידו אותיות יו\"ד32)"
        },
        {
          "s": 19,
          "text": "ועקב."
        },
        {
          "s": 20,
          "text": "וכמבואר בתו\"א ריש פרשתנו,"
        },
        {
          "s": 21,
          "text": "שיעקב הוא בחי' יו\"ד עקב33,"
        },
        {
          "s": 22,
          "text": "היינו המשכת בחי' חכמה עילאה"
        },
        {
          "s": 23,
          "text": "[היו\"ד דשם הוי'34]"
        },
        {
          "s": 24,
          "text": "בבחי' עקביים."
        },
        {
          "s": 25,
          "text": "וע\"י המשכת היו\"ד בהעקב דיעקב"
        },
        {
          "s": 26,
          "text": "[ועד אשר היו\"ד היא ההתחלה והראש דתיבת יעקב,"
        },
        {
          "s": 27,
          "text": "היינו שהיו\"ד היא מנהיגה את העקב35],"
        },
        {
          "s": 28,
          "text": "הנה עי\"ז הי' אפ\"ל ויצא יעקב גו' וילך חרנה,"
        },
        {
          "s": 29,
          "text": "להמשיך היו\"ד גם בבחי' העקב דעולמות,"
        },
        {
          "s": 30,
          "text": "עד בעוה\"ז התחתון שאין תחתון למטה ממנו,"
        },
        {
          "s": 31,
          "text": "שיהי' דירה לו ית'."
        },
        {
          "s": 32,
          "text": "[כי מכיון שהיו\"ד דיעקב היא"
        },
        {
          "s": 33,
          "text": "(כנ\"ל)"
        },
        {
          "s": 34,
          "text": "היו\"ד דשם הוי' שהוא הי' הוה ויהי' כאחד36"
        },
        {
          "s": 35,
          "text": "(היינו שהכל הוא בשוה לגבי'),"
        },
        {
          "s": 36,
          "text": "לכן גם כמו שהיו\"ד נמשכת בבחי' העקב דעולמות,"
        },
        {
          "s": 37,
          "text": "היא בתקפה."
        },
        {
          "s": 38,
          "text": "ונוסף לזה,"
        },
        {
          "s": 39,
          "text": "מכיון שהוי' הוא מלשון מהווה37,"
        },
        {
          "s": 40,
          "text": "והיו\"ד שבו מורה על תמידות ההתהוות38,"
        },
        {
          "s": 41,
          "text": "הרי היו\"ד היא המושלת ושולטת בכל העולמות עד בהעקב שבהם,"
        },
        {
          "s": 42,
          "text": "מכיון שכל מציאותם הוא הדבר הוי' המהווה אותם תמיד מאין ליש]."
        },
        {
          "s": 43,
          "text": "וזהו ויצא יעקב מבאר שבע וילך חרנה,"
        },
        {
          "s": 44,
          "text": "שיעקב ממשיך היו\"ד דשם הוי' גם בבחי' חרן,"
        },
        {
          "s": 45,
          "text": "שקאי"
        },
        {
          "s": 46,
          "text": "[כנ\"ל"
        },
        {
          "s": 47,
          "text": "(סעיף ג)"
        },
        {
          "s": 48,
          "text": "בפירוש הב']"
        },
        {
          "s": 49,
          "text": "על עולמות בי\"ע,"
        },
        {
          "s": 50,
          "text": "ובבי\"ע גופא חרון אף של עולם39,"
        },
        {
          "s": 51,
          "text": "עוה\"ז התחתון שאין תחתון למטה ממנו,"
        },
        {
          "s": 52,
          "text": "שיהי' דירה לו ית' בתחתונים."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה ירידה זו"
        },
        {
          "s": 2,
          "text": "(ויצא יעקב מבאר שבע וילך חרנה)"
        },
        {
          "s": 3,
          "text": "היא צורך עלי'."
        },
        {
          "s": 4,
          "text": "ונוסף להעלי' שנעשה בו לאחרי וע\"י עבודתו בחרן"
        },
        {
          "s": 5,
          "text": "[שע\"י שבירר הניצוצות דלבן ועשו הגיע למדריגה נעלית יותר מכמו שהי' לפנ\"ז,"
        },
        {
          "s": 6,
          "text": "ושבתי בשלום אל בית אבי וגו',"
        },
        {
          "s": 7,
          "text": "כמשי\"ת לקמן],"
        },
        {
          "s": 8,
          "text": "הנה גם לפנ\"ז,"
        },
        {
          "s": 9,
          "text": "בכדי שיוכל להמשיך"
        },
        {
          "s": 10,
          "text": "(היו\"ד)"
        },
        {
          "s": 11,
          "text": "בבחי' חרן ולברר הניצוצות,"
        },
        {
          "s": 12,
          "text": "נמשך בו כח נעלה יותר,"
        },
        {
          "s": 13,
          "text": "שלא הי' לו תחילה"
        },
        {
          "s": 14,
          "text": "(בגילוי)."
        },
        {
          "s": 15,
          "text": "[וע\"ד הידוע40"
        },
        {
          "s": 16,
          "text": "(גבי אברהם שהי' גדול בענקים41"
        },
        {
          "s": 17,
          "text": "וראש לאבות42),"
        },
        {
          "s": 18,
          "text": "שבכדי שיהי' אב המון גוים להעלות הניצוצות שבגוים"
        },
        {
          "s": 19,
          "text": "(הגרים),"
        },
        {
          "s": 20,
          "text": "נתוסף לו ה' שלא הי' לו תחילה]."
        }
      ]
    }
  ]
}