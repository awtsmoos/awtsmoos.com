{
  "globalIndex": 753,
  "owner": 3,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918160_theRebbe_102__p008",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918160_theRebbe_102__p008",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518918160_theRebbe_102",
  "title": "מאמר ויאמר לו יהונתן תשכ\"ח",
  "part": 8,
  "sections": [
    {
      "v": 21,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "והנה ידוע70"
        },
        {
          "s": 3,
          "text": "דזה שהנשמה רוצה לירד למטה להחיות את הגוף הוא מפני שהנשמה מרגשת מעלת הגוף מצד שרשו,"
        },
        {
          "s": 4,
          "text": "ששורש הגוף הוא למעלה משורש הנשמה,"
        },
        {
          "s": 5,
          "text": "ולכן היא רוצה להחיות את הגוף."
        },
        {
          "s": 6,
          "text": "ומה שאמרו רז\"ל71"
        },
        {
          "s": 7,
          "text": "על כרחך אתה חי,"
        },
        {
          "s": 8,
          "text": "הוא,"
        },
        {
          "s": 9,
          "text": "דכיון שהרצון דהנשמה להחיות את הגוף הוא לא מצד עצמה אלא מפני שהיא מרגשת את שורש הגוף,"
        },
        {
          "s": 10,
          "text": "לכן נק' זה בשם הכרח,"
        },
        {
          "s": 11,
          "text": "על כרחך אתה חי."
        },
        {
          "s": 12,
          "text": "ויש לומר,"
        },
        {
          "s": 13,
          "text": "דזה שהנשמה מרגשת את שורש הגוף"
        },
        {
          "s": 14,
          "text": "[אף שהרגש זה אינו שייך לכאורה לענינה דהנשמה,"
        },
        {
          "s": 15,
          "text": "וכמובן מזה שהרצון שלה להחיות את הגוף הבא מהרגש זה נקרא בשם הכרח],"
        },
        {
          "s": 16,
          "text": "הוא,"
        },
        {
          "s": 17,
          "text": "כי בכדי שיהי' לה רצון להחיות את הגוף נמשך בה גילוי שורש הגוף,"
        },
        {
          "s": 18,
          "text": "אף שמצד עצמה"
        },
        {
          "s": 19,
          "text": "(גם כמו שהיא מצד שרשה)"
        },
        {
          "s": 20,
          "text": "אינה שייכת לגילוי זה."
        },
        {
          "s": 21,
          "text": "וע\"י הגילוי דשורש הגוף שמאיר בהנשמה"
        },
        {
          "s": 22,
          "text": "(באופן דהכרח עכ\"פ)"
        },
        {
          "s": 23,
          "text": "קודם ירידתה למטה,"
        },
        {
          "s": 24,
          "text": "היא נעשית כמו כלי להגילוי דשורש הגוף שמאיר בה אח\"כ ע\"י עבודתה בהגוף."
        },
        {
          "s": 25,
          "text": "ועד\"ז הוא בהענין דאורות וכלים,"
        },
        {
          "s": 26,
          "text": "דזה שע\"י התלבשות האורות בהכלים נמשך בהם בחינת שורש הכלים הוא ע\"י שנרגש בהם עוד קודם ירידתם בהכלים שורש הכלים."
        },
        {
          "s": 27,
          "text": "ויש לומר,"
        },
        {
          "s": 28,
          "text": "דכמו\"כ הוא בנוגע להענין דספירת העומר ומתן תורה,"
        },
        {
          "s": 29,
          "text": "דזה שע\"י הירידה דנפש האלקית לברר המדות דנפש הבהמית"
        },
        {
          "s": 30,
          "text": "(יפקד מושבך)"
        },
        {
          "s": 31,
          "text": "נמשך בה הגילוי דמ\"ת מצד מעלת הבירורים"
        },
        {
          "s": 32,
          "text": "(כנ\"ל סעיף ד),"
        },
        {
          "s": 33,
          "text": "הוא,"
        },
        {
          "s": 34,
          "text": "כי הירידה לברר המדות דנפש הבהמית באה לאחרי וע\"י הגילוי דיציאת מצרים,"
        },
        {
          "s": 35,
          "text": "וע\"י הגילוי דיציאת מצרים נרגש בה"
        },
        {
          "s": 36,
          "text": "(גם לפני הירידה)"
        },
        {
          "s": 37,
          "text": "מעלת הבירורים,"
        },
        {
          "s": 38,
          "text": "מכיון שהיציאה ממצרים היתה ברכוש גדול."
        }
      ]
    },
    {
      "v": 22,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ב)"
        },
        {
          "s": 2,
          "text": "וזהו ויאמר לו יהונתן מחר חודש ונפקדת כי יפקד מושבך,"
        },
        {
          "s": 3,
          "text": "שבכדי שע\"י יפקד מושבך יהי' ונפקדת הוא ע\"י ההמשכה דויאמר לו יהונתן"
        },
        {
          "s": 4,
          "text": "(כנ\"ל סעיף ג),"
        },
        {
          "s": 5,
          "text": "שהוא ע\"ד הענין דיציאת מצרים וקריעת ים סוף,"
        },
        {
          "s": 6,
          "text": "שעי\"ז נרגש"
        },
        {
          "s": 7,
          "text": "(עוד לפני הירידה)"
        },
        {
          "s": 8,
          "text": "מעלת הבירורים."
        },
        {
          "s": 9,
          "text": "וזהו ונפקדת כי יפקד מושבך,"
        },
        {
          "s": 10,
          "text": "דמלשון זה משמע שהשייכות דיפקד לונפקדת הוא לא מצד הביטול שביפקד מושבך,"
        },
        {
          "s": 11,
          "text": "אלא מצד הענין דיפקד מושבך עצמו"
        },
        {
          "s": 12,
          "text": "(כנ\"ל סעיף א),"
        },
        {
          "s": 13,
          "text": "כי העלי' דהנשמה שע\"י ירידתה בגוף הוא לא מפני שעי\"ז מתגלה ענין דהנשמה"
        },
        {
          "s": 14,
          "text": "(ביטול,"
        },
        {
          "s": 15,
          "text": "וכו')"
        },
        {
          "s": 16,
          "text": "אלא מצד הגוף עצמו"
        },
        {
          "s": 17,
          "text": "(כנ\"ל סעיף ה),"
        },
        {
          "s": 18,
          "text": "ועד\"ז הוא בנוגע להענין דונפקדת,"
        },
        {
          "s": 19,
          "text": "שזה נעשה ע\"י הענין דיפקד מושבך עצמו."
        },
        {
          "s": 20,
          "text": "ונאמר ונפקדת כי יפקד מושבך,"
        },
        {
          "s": 21,
          "text": "דיפקד הוא"
        },
        {
          "s": 22,
          "text": "(גם)"
        },
        {
          "s": 23,
          "text": "לשון ונפקדת,"
        },
        {
          "s": 24,
          "text": "דנוסף לזה שיפקד מביא לונפקדת,"
        },
        {
          "s": 25,
          "text": "גם ביפקד עצמו יש ענין ונפקדת"
        },
        {
          "s": 26,
          "text": "(כנ\"ל סעיף א),"
        },
        {
          "s": 27,
          "text": "כי ע\"י שהירידה דיפקד מושבך באה ע\"י ההמשכה דויאמר לו יהונתן,"
        },
        {
          "s": 28,
          "text": "נרגש גם בהירידה עצמה מעלת הבירורים,"
        },
        {
          "s": 29,
          "text": "אלא שעיקר הגילוי הוא לאחרי הירידה דיפקד מושבך,"
        },
        {
          "s": 30,
          "text": "מחר חודש."
        }
      ]
    },
    {
      "v": 23,
      "items": [
        {
          "s": 0,
          "text": "ועד\"ז הוא בהחידוש דכנס\"י בגאולה העתידה,"
        },
        {
          "s": 1,
          "text": "שהם עתידים להתחדש כמותה72,"
        },
        {
          "s": 2,
          "text": "שגם בערב ראש חודש,"
        },
        {
          "s": 3,
          "text": "ברגעים האחרונים שלפני הגאולה,"
        },
        {
          "s": 4,
          "text": "מאיר מעין העילוי דהגאולה,"
        },
        {
          "s": 5,
          "text": "הן בנוגע לענינים הרוחניים – גילוי פנימיות התורה,"
        },
        {
          "s": 6,
          "text": "ובאופן דיפוצו מעיינותיך חוצה,"
        },
        {
          "s": 7,
          "text": "והן בנוגע להרכוש גדול שיהי' בגאולה העתידה – שלכל בני ישראל תהי' פרנסה בהרחבה ועד לעשירות,"
        },
        {
          "s": 8,
          "text": "ומזה באים מיד להגאולה,"
        },
        {
          "s": 9,
          "text": "שאז יהיו שני הענינים בתכלית השלימות – שהטובה תהי' מושפעת הרבה וכל המעדנים מצויים כעפר67,"
        },
        {
          "s": 10,
          "text": "ועאכו\"כ בנוגע לענינים הרוחניים – מלאה הארץ דעה את הוי' כמים לים מכסים66."
        }
      ]
    }
  ]
}