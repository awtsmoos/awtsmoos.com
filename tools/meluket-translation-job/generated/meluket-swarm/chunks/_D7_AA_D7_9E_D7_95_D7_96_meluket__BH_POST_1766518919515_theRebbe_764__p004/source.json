{
  "globalIndex": 968,
  "owner": 18,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919515_theRebbe_764__p004",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919515_theRebbe_764__p004",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919515_theRebbe_764",
  "title": "מאמר גדול יהי' תשכ\"ב",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "[והטעם לזה הוא,"
        },
        {
          "s": 1,
          "text": "דבהתהוות שבדרך ממילא עיקר ההדגשה הוא גילוי המקור."
        },
        {
          "s": 2,
          "text": "ולכן,"
        },
        {
          "s": 3,
          "text": "הגם שגם בעילה ועלול"
        },
        {
          "s": 4,
          "text": "(שהתהוות העלול מהעילה היא בדרך ממילא),"
        },
        {
          "s": 5,
          "text": "העלול אינו גילוי העילה אלא מהות לעצמו,"
        },
        {
          "s": 6,
          "text": "מ\"מ,"
        },
        {
          "s": 7,
          "text": "נרגש בו העילה."
        },
        {
          "s": 8,
          "text": "וכמו שכל ומדות,"
        },
        {
          "s": 9,
          "text": "שבהמדות נרגש השכל."
        },
        {
          "s": 10,
          "text": "ובכדי שיתהווה דבר שהוא בריחוק ממקורו,"
        },
        {
          "s": 11,
          "text": "הוא דוקא בדרך התלבשות."
        },
        {
          "s": 12,
          "text": "דענין ההתלבשות הוא"
        },
        {
          "s": 13,
          "text": "(לא שהמקור מתגלה,"
        },
        {
          "s": 14,
          "text": "אלא אדרבה)"
        },
        {
          "s": 15,
          "text": "הוא מתלבש"
        },
        {
          "s": 16,
          "text": "(ומתעסק)"
        },
        {
          "s": 17,
          "text": "להוות דבר חדש,"
        },
        {
          "s": 18,
          "text": "ולכן,"
        },
        {
          "s": 19,
          "text": "הדבר המתהווה ע\"י התלבשות הוא בריחוק ממקורו,"
        },
        {
          "s": 20,
          "text": "באופן שלא נרגש בו מקורו."
        },
        {
          "s": 21,
          "text": "ויש לומר שהוא ע\"ד הענין דכח ופועל,"
        },
        {
          "s": 22,
          "text": "דמהטעמים על זה שהמשכת הפעולה מהכח היא לא בדרך ממילא אלא ע\"י התלבשות"
        },
        {
          "s": 23,
          "text": "(שהכח פועל את הפעולה),"
        },
        {
          "s": 24,
          "text": "הוא כי הפעולה היא בריחוק מהכח."
        },
        {
          "s": 25,
          "text": "דהנה ידוע41"
        },
        {
          "s": 26,
          "text": "שהפעולה היא התחדשות לגבי הכח."
        },
        {
          "s": 27,
          "text": "דכיון שהכח הוא רוחני והפעולה היא גשמית,"
        },
        {
          "s": 28,
          "text": "הרי המשכת הפעולה מהכח היא"
        },
        {
          "s": 29,
          "text": "(כמו)"
        },
        {
          "s": 30,
          "text": "התהוות חדשה"
        },
        {
          "s": 31,
          "text": "(וע\"ד יש מאין)."
        },
        {
          "s": 32,
          "text": "וענין הכח הוא שבכחו לפעול דבר חדש."
        },
        {
          "s": 33,
          "text": "ומזה מובן,"
        },
        {
          "s": 34,
          "text": "דזה שמהפעולה יודעים את הכח,"
        },
        {
          "s": 35,
          "text": "הוא שע\"י הפעולה יודעים את הכח."
        },
        {
          "s": 36,
          "text": "אבל בהפעולה עצמה לא נרגש הכח42."
        },
        {
          "s": 37,
          "text": "דכיון שהכח הוא רוחני והפעולה היא גשמית,"
        },
        {
          "s": 38,
          "text": "אין הכח הרוחני מתגלה בפעולה הגשמית43."
        },
        {
          "s": 39,
          "text": "ויש להוסיף,"
        },
        {
          "s": 40,
          "text": "דזה שבהפעולה לא נרגש הכח הוא לא רק מצד הפעולה"
        },
        {
          "s": 41,
          "text": "(שהיא באין ערוך להכח)"
        },
        {
          "s": 42,
          "text": "אלא גם מצד הכח."
        },
        {
          "s": 43,
          "text": "דכיון שפעולת הכח הוא שעושה דבר חדש שאינו בערכו"
        },
        {
          "s": 44,
          "text": "(כנ\"ל),"
        },
        {
          "s": 45,
          "text": "לכן המשכת הכח לפעול היא המשכה נעלמת"
        },
        {
          "s": 46,
          "text": "[כי פעולת דבר חדש שאינו בערך מקורו היא ע\"י התעלמות המקור."
        },
        {
          "s": 47,
          "text": "דלאחרי שנפסק גילוי המקור,"
        },
        {
          "s": 48,
          "text": "אז דוקא שייך שיהי' דבר שאינו בערכו],"
        },
        {
          "s": 49,
          "text": "ולכן44,"
        },
        {
          "s": 50,
          "text": "הפעולה הבאה מהכח היא באופן שלא נרגש בה הכח]."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ועד\"ז הוא למעלה,"
        },
        {
          "s": 1,
          "text": "דההתהוות שמשם אלקים שהיא בדרך התלבשות,"
        },
        {
          "s": 2,
          "text": "היא באופן שהכח המהווה אינו נרגש בהנבראים,"
        },
        {
          "s": 3,
          "text": "ולכן הנבראים שנתהוו משם אלקים הם מציאות והביטול שלהם הוא45"
        },
        {
          "s": 4,
          "text": "רק ביטול היש."
        },
        {
          "s": 5,
          "text": "וההתהוות שמשם הוי' שהיא בדרך ממילא,"
        },
        {
          "s": 6,
          "text": "היא באופן שהוא בגילוי בהנבראים,"
        },
        {
          "s": 7,
          "text": "ולכן ביטול הנבראים שנתהוו משם הוי' הוא45"
        },
        {
          "s": 8,
          "text": "ביטול במציאות."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה ידוע דכשמביאים בדרושי חסידות שני משלים"
        },
        {
          "s": 2,
          "text": "(או יותר)"
        },
        {
          "s": 3,
          "text": "לאיזה ענין,"
        },
        {
          "s": 4,
          "text": "הוא,"
        },
        {
          "s": 5,
          "text": "כי אין המשל מכוון להנמשל בכל הפרטים,"
        },
        {
          "s": 6,
          "text": "ולכן מביאים שני משלים"
        },
        {
          "s": 7,
          "text": "(ויותר),"
        },
        {
          "s": 8,
          "text": "שכל אחד מהם מבאר איזה פרטים מהנמשל."
        },
        {
          "s": 9,
          "text": "וכן הוא בענינינו,"
        },
        {
          "s": 10,
          "text": "דהטעם שמביאים שני משלים על זה שבהתהוות שבדרך ממילא המתהווה הוא בקירוב להמהווה,"
        },
        {
          "s": 11,
          "text": "המשל דעילה ועלול והמשל דאור ומאור,"
        },
        {
          "s": 12,
          "text": "הוא,"
        },
        {
          "s": 13,
          "text": "כי בהנמשל,"
        },
        {
          "s": 14,
          "text": "גם בההתהוות שבדרך ממילא,"
        },
        {
          "s": 15,
          "text": "מתהווה דבר חדש שאינו בערך להמקור המהווה."
        },
        {
          "s": 16,
          "text": "וכמובן גם מזה שגם בההתהוות שמשם הוי' כתיב כי הוא צוה ונבראו,"
        },
        {
          "s": 17,
          "text": "דלשון בריאה מורה על התהוות יש מאין46,"
        },
        {
          "s": 18,
          "text": "דיש מאין הוא באין ערוך."
        },
        {
          "s": 19,
          "text": "וזה שההתהוות שמשם הוי' היא באופן שהוא בגילוי בהנבראים שנתהוו ממנו"
        },
        {
          "s": 20,
          "text": "(כנ\"ל סעיף ד),"
        },
        {
          "s": 21,
          "text": "הכוונה בזה היא שנרגש בהם שאינם מציאות לעצמם וכל מציאותם היא זה שהאור האלקי מהווה אותם מאין ליש,"
        },
        {
          "s": 22,
          "text": "דע\"י הרגש זה הם בטלים למקורם."
        },
        {
          "s": 23,
          "text": "אבל לא שהוא בגילוי בהנבראים עצמם"
        },
        {
          "s": 24,
          "text": "(ענינם ומעלתם)."
        },
        {
          "s": 25,
          "text": "דכיון שהנבראים הם באין ערוך לגבי',"
        },
        {
          "s": 26,
          "text": "הרי אין שייך שיתגלה בהם אור שאינו בערכם כלל,"
        },
        {
          "s": 27,
          "text": "וע\"ד שאין שייך שבפעולה גשמית יהי' הגילוי דכח הרוחני"
        },
        {
          "s": 28,
          "text": "(כנ\"ל שם)."
        },
        {
          "s": 29,
          "text": "[ולהוסיף,"
        },
        {
          "s": 30,
          "text": "דבכח ופועל,"
        },
        {
          "s": 31,
          "text": "כיון שכח ענינו הוא לפעול ופעולתו היא בדרך התלבשות,"
        },
        {
          "s": 32,
          "text": "לכן,"
        },
        {
          "s": 33,
          "text": "בזה שהכח פועל את הפעולה מתגלה הכח"
        },
        {
          "s": 34,
          "text": "(ורק שאינו מתגלה בהפעולה עצמה)."
        },
        {
          "s": 35,
          "text": "משא\"כ בההתהוות שמשם הוי',"
        },
        {
          "s": 36,
          "text": "כיון שההתהוות שמשם הוי' היא בדרך ממילא,"
        },
        {
          "s": 37,
          "text": "שזה מורה שהוא מופלא מענין ההתהוות47,"
        },
        {
          "s": 38,
          "text": "הרי אינו מתגלה גם ע\"י התהוות הנבראים,"
        },
        {
          "s": 39,
          "text": "כיון שהוא מופלא מענין ההתהוות]."
        },
        {
          "s": 40,
          "text": "ולכן המשל דעילה ועלול אינו מכוון להנמשל,"
        },
        {
          "s": 41,
          "text": "כי בעילה ועלול,"
        },
        {
          "s": 42,
          "text": "הקירוב דהעלול להעילה הוא שהעלול הוא בערך העילה,"
        },
        {
          "s": 43,
          "text": "וגילוי העילה הוא בהעלול עצמו48."
        },
        {
          "s": 44,
          "text": "[וכמו שכל ומדות שהם עילה ועלול,"
        },
        {
          "s": 45,
          "text": "שבהמדה עצמה ניכר השכל שהולידה."
        },
        {
          "s": 46,
          "text": "דכשמתעורר באהבה לאיזה דבר לפי שהבין והשיג בשכלו שהדבר טוב לו הרי נרגש בהאהבה עצמה שאהבתו להדבר היא מצד הטוב שבו."
        },
        {
          "s": 47,
          "text": "ואופן האהבה הוא כאופן הטוב של הדבר49]."
        },
        {
          "s": 48,
          "text": "ובכדי לבאר שגם כשהמתהווה הוא באין ערוך להמקור המהווה מ\"מ הוא בקירוב למקורו,"
        },
        {
          "s": 49,
          "text": "הוא ע\"י המשל דאור ומאור."
        },
        {
          "s": 50,
          "text": "דהגם שהאור הוא הארה בלבד שבאין ערוך להמאור"
        },
        {
          "s": 51,
          "text": "[שלכן אין המאור מתגלה בהאור,"
        },
        {
          "s": 52,
          "text": "שע\"י האור יודעים רק מציאות המאור ולא מהותו50],"
        },
        {
          "s": 53,
          "text": "מ\"מ,"
        },
        {
          "s": 54,
          "text": "הוא בקירוב להמאור,"
        },
        {
          "s": 55,
          "text": "שנרגש בו מקורו ובטל אליו."
        }
      ]
    }
  ]
}