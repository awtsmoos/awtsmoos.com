{
  "globalIndex": 1005,
  "owner": 5,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919765_theRebbe_137__p001",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919765_theRebbe_137__p001",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919765_theRebbe_137",
  "title": "מאמר קץ שם לחושך תשכ\"ד",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ דברים,"
        },
        {
          "s": 2,
          "text": "תשעה-באב נדחה,"
        },
        {
          "s": 3,
          "text": "ה'תשכ\"ד"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "קץ שם לחושך1,"
        },
        {
          "s": 1,
          "text": "ואיתא במדרש2,"
        },
        {
          "s": 2,
          "text": "זמן נתן לעולם כמה שנים יעשה באפילה."
        },
        {
          "s": 3,
          "text": "ומבאר הצמח צדק3"
        },
        {
          "s": 4,
          "text": "שהוא ע\"ד מ\"ש בזהר4"
        },
        {
          "s": 5,
          "text": "עה\"פ5"
        },
        {
          "s": 6,
          "text": "לכל זמן ועת לכל חפץ,"
        },
        {
          "s": 7,
          "text": "שיש זמן קצוב לחושך הגלות."
        },
        {
          "s": 8,
          "text": "וצריך להבין,"
        },
        {
          "s": 9,
          "text": "דכיון שכל הדברים שבעולם יש להם זמן קצוב,"
        },
        {
          "s": 10,
          "text": "לכל זמן,"
        },
        {
          "s": 11,
          "text": "מהו החידוש בקץ שם לחושך."
        },
        {
          "s": 12,
          "text": "וביותר אינו מובן,"
        },
        {
          "s": 13,
          "text": "דמלשון הכתוב קץ שם לחושך משמע,"
        },
        {
          "s": 14,
          "text": "שהחושך מצד עצמו אין לו קץ,"
        },
        {
          "s": 15,
          "text": "אלא ששם לו קץ."
        },
        {
          "s": 16,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 17,
          "text": "דזה שהדברים הבלתי רצויים אינם נמצאים בי\"ד העתים שנקצבו לטובה6"
        },
        {
          "s": 18,
          "text": "הוא רק שלא ישנם אז בפועל,"
        },
        {
          "s": 19,
          "text": "כי ע\"י הענינים הטובים שישנם אז,"
        },
        {
          "s": 20,
          "text": "הדברים שאינם רצויים הם מתבטלים."
        },
        {
          "s": 21,
          "text": "דכמו\"כ הוא באור וחושך,"
        },
        {
          "s": 22,
          "text": "שהאור דוחה את החושך"
        },
        {
          "s": 23,
          "text": "[ועד שאפילו מעט אור דוחה הרבה חושך7]."
        },
        {
          "s": 24,
          "text": "וענין קץ שם לחושך הוא,"
        },
        {
          "s": 25,
          "text": "שלאחרי שיהי' הקץ שלו לא יהי' שייך כלל ענין החושך."
        },
        {
          "s": 26,
          "text": "דזה שהגאולה העתידה תהי' גאולה נצחית שאין אחרי' גלות8,"
        },
        {
          "s": 27,
          "text": "הוא,"
        },
        {
          "s": 28,
          "text": "שאז לא יהי' שייך חושך הגלות."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה החילוק באופן ביטול החושך – אם הוא רק נדחה מפני האור,"
        },
        {
          "s": 2,
          "text": "או שאין שייך כלל מציאותו – תלוי בדרגת האור."
        },
        {
          "s": 3,
          "text": "שבכדי לדחות את החושך"
        },
        {
          "s": 4,
          "text": "(אבל גם לאחרי שנדחה שייכת מציאותו)"
        },
        {
          "s": 5,
          "text": "הוא גם ע\"י אור מוגבל,"
        },
        {
          "s": 6,
          "text": "ועד שאפילו מעט אור דוחה הרבה חושך7."
        },
        {
          "s": 7,
          "text": "ובכדי שהחושך יתבטל לגמרי הוא ע\"י אור בלתי מוגבל."
        },
        {
          "s": 8,
          "text": "וכדאיתא במדרש9"
        },
        {
          "s": 9,
          "text": "דזה שהגאולה דיציאת מצרים"
        },
        {
          "s": 10,
          "text": "(וכן הגאולה מגלות בבל ושאר הגלויות עד להגאולה דלעתיד)"
        },
        {
          "s": 11,
          "text": "היתה גאולה שיש אחרי' גלות,"
        },
        {
          "s": 12,
          "text": "וגאולה העתידה תהי' גאולה נצחית שאין אחרי' גלות,"
        },
        {
          "s": 13,
          "text": "הוא,"
        },
        {
          "s": 14,
          "text": "כי הגאולה דיציאת מצרים היא דוגמת אור הנר ששייך בו כיבוי10,"
        },
        {
          "s": 15,
          "text": "וגאולה העתידה היא דוגמת אור היום שאין שייך בו כיבוי."
        },
        {
          "s": 16,
          "text": "היינו,"
        },
        {
          "s": 17,
          "text": "שהגילוי דגאולה העתידה יהי' גילוי אור בלתי מוגבל שאין שייך בו הפסק11,"
        },
        {
          "s": 18,
          "text": "ולכן תהי' גאולה נצחית שאין אחרי' גלות12."
        }
      ]
    }
  ]
}