{
  "globalIndex": 366,
  "owner": 16,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915857_theRebbe_394__p001",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915857_theRebbe_394__p001",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915857_theRebbe_394",
  "title": "מאמר ת\"ר מצות נר חנוכה תשל\"ח",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "מוצאי ש\"פ מקץ,"
        },
        {
          "s": 2,
          "text": "שבת חנוכה,"
        },
        {
          "s": 3,
          "text": "ה'תשל\"ח*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "תנו רבנן מצות נר חנוכה כו' בית שמאי אומרים יום ראשון מדליק שמונה מכאן ואילך פוחת והולך ובית הלל אומרים יום ראשון מדליק אחת מכאן ואילך מוסיף והולך,"
        },
        {
          "s": 1,
          "text": "טעמא דב\"ש כנגד פרי החג וטעמא דב\"ה דמעלין בקודש כו'1."
        },
        {
          "s": 2,
          "text": "וידוע דיוק כ\"ק אדמו\"ר הזקן2,"
        },
        {
          "s": 3,
          "text": "מה ענין נר חנוכה לפרי החג."
        },
        {
          "s": 4,
          "text": "ובפרט לפי מ\"ש כ\"ק אדמו\"ר הצ\"צ3,"
        },
        {
          "s": 5,
          "text": "שגם ב\"ה לא פליגי רק משום דמעלין בקודש."
        },
        {
          "s": 6,
          "text": "ומה שמבואר בכ\"מ4"
        },
        {
          "s": 7,
          "text": "שהשייכות דחנוכה לסוכות היא ששניהם הם שמונה ימים,"
        },
        {
          "s": 8,
          "text": "דמספר שמונה מורה על בחינה שלמעלה מהשתלשלות5,"
        },
        {
          "s": 9,
          "text": "הרי זה גופא צריך ביאור,"
        },
        {
          "s": 10,
          "text": "מהו הקשר דסוכות וחנוכה לבחינה שלמעלה מהשתלשלות,"
        },
        {
          "s": 11,
          "text": "שמצד זה הם שמונה ימים."
        },
        {
          "s": 12,
          "text": "וגם,"
        },
        {
          "s": 13,
          "text": "הרי זה שתיקנו נרות חנוכה הוא מפני הנס שהי' בנרות המקדש,"
        },
        {
          "s": 14,
          "text": "ומכיון שבמקדש היו ז' נרות,"
        },
        {
          "s": 15,
          "text": "מדוע בחנוכה יש שמונה נרות"
        },
        {
          "s": 16,
          "text": "(וימים)6."
        },
        {
          "s": 17,
          "text": "וגם צריך להבין מה שהפערגליַיך"
        },
        {
          "s": 18,
          "text": "(ההשוואה)"
        },
        {
          "s": 19,
          "text": "דנרות חנוכה הוא"
        },
        {
          "s": 20,
          "text": "(לא לחג הסוכות בכלל,"
        },
        {
          "s": 21,
          "text": "אלא)"
        },
        {
          "s": 22,
          "text": "לפרי החג דוקא,"
        },
        {
          "s": 23,
          "text": "דלכאורה,"
        },
        {
          "s": 24,
          "text": "הרי נרות חנוכה שייכים להמנורה"
        },
        {
          "s": 25,
          "text": "(נרות חנוכה הם מפני הנס שהי' בנרות המנורה),"
        },
        {
          "s": 26,
          "text": "ופרי החג הקריבו"
        },
        {
          "s": 27,
          "text": "(ככל הקרבנות)"
        },
        {
          "s": 28,
          "text": "על גבי המזבח,"
        },
        {
          "s": 29,
          "text": "והרי מנורה ומזבח הם שני כלים שונים7"
        },
        {
          "s": 30,
          "text": "[ובפרט לפי המבואר בקבלה ובחסידות8],"
        },
        {
          "s": 31,
          "text": "ונרות וקרבנות עבודות שונות,"
        },
        {
          "s": 32,
          "text": "ועד ששלך"
        },
        {
          "s": 33,
          "text": "(נרות)"
        },
        {
          "s": 34,
          "text": "גדולה משלהם"
        },
        {
          "s": 35,
          "text": "(קרבנות)"
        },
        {
          "s": 36,
          "text": "כו' אינן בטלין לעולם9."
        },
        {
          "s": 37,
          "text": "וגם צריך להבין מה שמצותה"
        },
        {
          "s": 38,
          "text": "(של נ\"ח)"
        },
        {
          "s": 39,
          "text": "היא משתשקע החמה1,"
        },
        {
          "s": 40,
          "text": "דידוע הדיוק בזה10,"
        },
        {
          "s": 41,
          "text": "דנרות המקדש הדליקו מפלג המנחה,"
        },
        {
          "s": 42,
          "text": "שעה ורביע קודם השקיעה11,"
        },
        {
          "s": 43,
          "text": "וכיון שנרות חנוכה הם"
        },
        {
          "s": 44,
          "text": "(כנ\"ל)"
        },
        {
          "s": 45,
          "text": "מפני הנס שהי' בנרות המקדש"
        },
        {
          "s": 46,
          "text": "[ובפרט שכל דתקון רבנן כעין דאורייתא תקון12],"
        },
        {
          "s": 47,
          "text": "הי' ראוי לכאורה שתהי' זמן הדלקתם כנרות המקדש,"
        },
        {
          "s": 48,
          "text": "ולמה מצותה היא דוקא משתשקע החמה."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ונקודת הביאור בזה13,"
        },
        {
          "s": 2,
          "text": "דענינם של נרות חנוכה הוא להאיר את החושך."
        },
        {
          "s": 3,
          "text": "דהנה הנס דחנוכה הי' לאחרי שנכנסו היונים להיכל וטימאו כל השמנים שבהיכל1,"
        },
        {
          "s": 4,
          "text": "שהתגברות החושך"
        },
        {
          "s": 5,
          "text": "(דהיונים)14"
        },
        {
          "s": 6,
          "text": "היתה עד כדי כך,"
        },
        {
          "s": 7,
          "text": "דלא רק שנכנסו להיכל וטימאוהו,"
        },
        {
          "s": 8,
          "text": "אלא שטמאו גם את כל השמנים שבהיכל."
        },
        {
          "s": 9,
          "text": "דשמן הוא בחינת קודש"
        },
        {
          "s": 10,
          "text": "(כמ\"ש15"
        },
        {
          "s": 11,
          "text": "שמן משחת קודש)16,"
        },
        {
          "s": 12,
          "text": "קודש מלה בגרמי'17"
        },
        {
          "s": 13,
          "text": "(בדוגמת השמן שצף18"
        },
        {
          "s": 14,
          "text": "על גבי כל המשקין ואינו מתערב עמהם)19."
        },
        {
          "s": 15,
          "text": "דמזה מובן,"
        },
        {
          "s": 16,
          "text": "שזה שטימאו את כל השמנים שבהיכל,"
        },
        {
          "s": 17,
          "text": "נוגע"
        },
        {
          "s": 18,
          "text": "(בפרט זה)"
        },
        {
          "s": 19,
          "text": "עוד יותר מזה שטימאו את ההיכל,"
        },
        {
          "s": 20,
          "text": "אף שקדושת ההיכל היא דרגא נעלית בעשר קדושות20."
        },
        {
          "s": 21,
          "text": "וכדמוכח גם מזה שגם לאחרי שבאו בניך כו' וטיהרו את מקדשך21,"
        },
        {
          "s": 22,
          "text": "הנה בכדי שיוכלו להדליק את המנורה הוצרכו לנס דוקא,"
        },
        {
          "s": 23,
          "text": "מתחיל מהנס22"
        },
        {
          "s": 24,
          "text": "שמצאו פך אחד שמן טהור חתום בחותמו של כהן גדול23,"
        },
        {
          "s": 25,
          "text": "אור א\"ס שלמעלה מהשתלשלות,"
        },
        {
          "s": 26,
          "text": "שלגבי אור זה גם24"
        },
        {
          "s": 27,
          "text": "חושך לא יחשיך,"
        },
        {
          "s": 28,
          "text": "ואדרבא אור זה מאיר את החושך שגם החושך יאיר,"
        },
        {
          "s": 29,
          "text": "והוי'25"
        },
        {
          "s": 30,
          "text": "(בתוס' וא\"ו)"
        },
        {
          "s": 31,
          "text": "יגי' חשכי26."
        },
        {
          "s": 32,
          "text": "וזהו שנ\"ח מצותה משתשקע החמה דוקא,"
        },
        {
          "s": 33,
          "text": "כי ענין נרות חנוכה הוא להאיר את החושך."
        },
        {
          "s": 34,
          "text": "וזהו גם מה שנרות חנוכה הם שמונה דוקא"
        },
        {
          "s": 35,
          "text": "(וכן יומי דחנוכה תמניא אינון27),"
        },
        {
          "s": 36,
          "text": "שמספר שמונה מורה"
        },
        {
          "s": 37,
          "text": "(כנ\"ל ס\"א)"
        },
        {
          "s": 38,
          "text": "על בחינה שלמעלה מהשתלשלות,"
        },
        {
          "s": 39,
          "text": "שמצד בחינה זו דוקא אפשר להאיר גם את החושך28."
        }
      ]
    }
  ]
}