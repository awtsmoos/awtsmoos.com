{
  "globalIndex": 486,
  "owner": 36,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916627_theRebbe_635__p002",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916627_theRebbe_635__p002",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916627_theRebbe_635",
  "title": "רשימה באתי לגני תשי\"ג",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "והנה לכאורה יש להקשות6,"
        },
        {
          "s": 1,
          "text": "דסו\"ס מאי נפ\"מ,"
        },
        {
          "s": 2,
          "text": "דהרי ג\"ז7"
        },
        {
          "s": 3,
          "text": "היפך הרצון."
        },
        {
          "s": 4,
          "text": "ויל\"פ ע\"ד החילוק דשיתוף רק בנ\"י נצטוו,"
        },
        {
          "s": 5,
          "text": "דשרשם מסוכ\"ע,"
        },
        {
          "s": 6,
          "text": "ושם אין מציאות,"
        },
        {
          "s": 7,
          "text": "משא\"כ ממכ\"ע,"
        },
        {
          "s": 8,
          "text": "יש מציאות שבטלה,"
        },
        {
          "s": 9,
          "text": "ובמילא נותן מקום לאלקא דאלקייא,"
        },
        {
          "s": 10,
          "text": "משא\"כ בבנ\"י ה\"ז היפך טבעם גם ענין זה,"
        },
        {
          "s": 11,
          "text": "כיון שהם מסוכ\"ע,"
        },
        {
          "s": 12,
          "text": "ולכן גם קשב\"ק8,"
        },
        {
          "s": 13,
          "text": "וכמש\"כ בארוכה בד\"ח פ\"ח – כיון שבזה א\"א לטעות9."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ע\"י10"
        },
        {
          "s": 1,
          "text": "תוקף החמדה כו',"
        },
        {
          "s": 2,
          "text": "כי תוקפא דגופא11,"
        },
        {
          "s": 3,
          "text": "שפי' נפה\"ב,"
        },
        {
          "s": 4,
          "text": "כי הגוף,"
        },
        {
          "s": 5,
          "text": "אדרבא,"
        },
        {
          "s": 6,
          "text": "צ\"ל בריא,"
        },
        {
          "s": 7,
          "text": "וכמש\"כ הרמב\"ם דהיות הגוף בריא מדרכי השם הוא,"
        },
        {
          "s": 8,
          "text": "וידוע פי' הבעש\"ט עה\"פ כי תראה חמור גו',"
        },
        {
          "s": 9,
          "text": "עמו12"
        },
        {
          "s": 10,
          "text": "דוקא,"
        },
        {
          "s": 11,
          "text": "אלא הכוונה לנפה\"ט המלובשת בגוף"
        },
        {
          "s": 12,
          "text": "(ויאמר משה תש\"ט)"
        },
        {
          "s": 13,
          "text": "ומכסה על הנפה\"א13."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ואף שהניצוץ14"
        },
        {
          "s": 1,
          "text": "הוא מכלים דע\"ס,"
        },
        {
          "s": 2,
          "text": "אבל הוא מפני' הכלים,"
        },
        {
          "s": 3,
          "text": "שבהם דוקא15"
        },
        {
          "s": 4,
          "text": "מעצם האור,"
        },
        {
          "s": 5,
          "text": "שאינו מתגלה כלל בחיצו' הכלי,"
        },
        {
          "s": 6,
          "text": "ומזה דוקא יכול להיות בדומה לו16"
        },
        {
          "s": 7,
          "text": "(כי אראה תר\"ס17)."
        },
        {
          "s": 8,
          "text": "וזהו מתאים ג\"כ להמבואר במ\"א דיחידה מחיצו' א\"ק,"
        },
        {
          "s": 9,
          "text": "אבל הוא לבוש לפני' א\"ק."
        },
        {
          "s": 10,
          "text": "ומזה ישנו בכאו\"א מישראל,"
        },
        {
          "s": 11,
          "text": "כמבואר בלקו\"ת שמביא הצ\"צ"
        },
        {
          "s": 12,
          "text": "(למנצח על השמינית פ\"ב18."
        },
        {
          "s": 13,
          "text": "ד\"ה ועתה אם נא תרע\"ח19."
        },
        {
          "s": 14,
          "text": "לעיין במצות מילה בסהמ\"צ20)."
        },
        {
          "s": 15,
          "text": "ובמילא מובן שהוא בטבע אינו משתנה21."
        }
      ]
    }
  ]
}