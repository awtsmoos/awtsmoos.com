{
  "globalIndex": 567,
  "owner": 17,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916998_theRebbe_249__p003",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916998_theRebbe_249__p003",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916998_theRebbe_249",
  "title": "מאמר ארבעה ראשי שנים תשל\"א",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "וזהו שאמרו48"
        },
        {
          "s": 1,
          "text": "לעולם ילמוד אדם במקום שלבו חפץ,"
        },
        {
          "s": 2,
          "text": "דחפץ הוא רצון שיש בו תענוג49,"
        },
        {
          "s": 3,
          "text": "דהגם שגם בלימוד התורה צ\"ל הביטול דעבד"
        },
        {
          "s": 4,
          "text": "(עולה של תורה50)"
        },
        {
          "s": 5,
          "text": "וגם הביטול דאתכפיא"
        },
        {
          "s": 6,
          "text": "(לשנות פרקו מאה פעמים ואחד51),"
        },
        {
          "s": 7,
          "text": "מ\"מ,"
        },
        {
          "s": 8,
          "text": "עיקר ההדגשה בלימוד התורה הוא52"
        },
        {
          "s": 9,
          "text": "שהתורה שלומד תהי' התענוג והחיות שלו."
        },
        {
          "s": 10,
          "text": "ויש לומר טעם לזה,"
        },
        {
          "s": 11,
          "text": "דכיון שענין לימוד התורה הוא שעי\"ז נעשים ישראל וקוב\"ה כולא חד,"
        },
        {
          "s": 12,
          "text": "לכן,"
        },
        {
          "s": 13,
          "text": "כמו שבהקב\"ה,"
        },
        {
          "s": 14,
          "text": "התורה היא התענוג דהקב\"ה,"
        },
        {
          "s": 15,
          "text": "ואהי' אצלו שעשועים53,"
        },
        {
          "s": 16,
          "text": "כמו\"כ צריך להיות בהאדם העוסק בתורה,"
        },
        {
          "s": 17,
          "text": "שהתורה שלומד תהי' התענוג שלו."
        },
        {
          "s": 18,
          "text": "[ואף שהתענוג דהאדם בהתורה שלומד הוא מצד השכל שבה,"
        },
        {
          "s": 19,
          "text": "כמובן גם מענין במקום שלבו חפץ,"
        },
        {
          "s": 20,
          "text": "יש לומר,"
        },
        {
          "s": 21,
          "text": "שבפנימיות הענינים התענוג שלו בתורה הוא מפני שהתורה היא שעשועים דהקב\"ה"
        },
        {
          "s": 22,
          "text": "[וכיון שישראל וקוב\"ה כולא חד,"
        },
        {
          "s": 23,
          "text": "לכן התורה היא גם התענוג דישראל],"
        },
        {
          "s": 24,
          "text": "אלא שבתענוג הגלוי שלו נרגש שהתענוג שלו בתורה הוא מצד השכל שבה]."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "דשני הענינים שבתורה מרומזים בחטה ובאילן."
        },
        {
          "s": 3,
          "text": "דחטה שהיא תבואה"
        },
        {
          "s": 4,
          "text": "[דגם לדעת ר\"י היא רק מין אילן]"
        },
        {
          "s": 5,
          "text": "רומזת על התורה כמו ששייכת למצוות"
        },
        {
          "s": 6,
          "text": "(שלימוד התורה הוא בכדי לקיים מצות תלמוד תורה,"
        },
        {
          "s": 7,
          "text": "וכיו\"ב),"
        },
        {
          "s": 8,
          "text": "והתורה כמו שהיא מצד עצמה מרומזת באילן."
        },
        {
          "s": 9,
          "text": "דמעלת האילן לגבי תבואה היא,"
        },
        {
          "s": 10,
          "text": "שתבואה"
        },
        {
          "s": 11,
          "text": "(גם חטים)"
        },
        {
          "s": 12,
          "text": "היא דבר המוכרח לקיומו של האדם,"
        },
        {
          "s": 13,
          "text": "וענין האילן הוא שהוא מצמיח פירות,"
        },
        {
          "s": 14,
          "text": "שאינם מוכרחים לקיומו של האדם,"
        },
        {
          "s": 15,
          "text": "אלא דברים של תענוג."
        },
        {
          "s": 16,
          "text": "ולהוסיף,"
        },
        {
          "s": 17,
          "text": "שגם ראיית האילן"
        },
        {
          "s": 18,
          "text": "(לא רק אכילת פירותיו)"
        },
        {
          "s": 19,
          "text": "גורמת לתענוג,"
        },
        {
          "s": 20,
          "text": "כמ\"ש54"
        },
        {
          "s": 21,
          "text": "ויצמח גו' כל עץ נחמד למראה גו'."
        },
        {
          "s": 22,
          "text": "וכמו שרואים בפועל,"
        },
        {
          "s": 23,
          "text": "שהטיול בגן,"
        },
        {
          "s": 24,
          "text": "מקום שצומחים בו אילנות,"
        },
        {
          "s": 25,
          "text": "הוא תענוג."
        },
        {
          "s": 26,
          "text": "ועפ\"ז יובן העילוי דר\"ה לאילן על ר\"ה לירקות,"
        },
        {
          "s": 27,
          "text": "אף שבירקות נכלל גם חטים"
        },
        {
          "s": 28,
          "text": "(מאכל אדם)"
        },
        {
          "s": 29,
          "text": "שרומזים על התורה,"
        },
        {
          "s": 30,
          "text": "דההמשכה בר\"ה לירקות היא בנוגע לקיום המצוות,"
        },
        {
          "s": 31,
          "text": "וגם ההמשכה שבנוגע לעסק התורה"
        },
        {
          "s": 32,
          "text": "(חטים)"
        },
        {
          "s": 33,
          "text": "היא בנוגע לעסק התורה כמו ששייך לקיום המצוות,"
        },
        {
          "s": 34,
          "text": "וההמשכה בר\"ה לאילן היא בנוגע ללימוד התורה כמו שהוא מצד עצמו,"
        },
        {
          "s": 35,
          "text": "ענין התענוג דתורה."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "דע\"י שהמצוות נמשכות מהתורה,"
        },
        {
          "s": 3,
          "text": "וגם זה שקיום המצוות צ\"ל בדרך עבודת עבד הוא לפי שהתורה אמרה55"
        },
        {
          "s": 4,
          "text": "ועבדתם את ה' אלקיכם וגו'56,"
        },
        {
          "s": 5,
          "text": "עי\"ז נמשך מעין התענוג דתורה גם בעבודה דקבלת עול"
        },
        {
          "s": 6,
          "text": "(עבודת עבד)"
        },
        {
          "s": 7,
          "text": "שבקיום המצוות."
        },
        {
          "s": 8,
          "text": "וע\"ד המבואר בהמשך תרס\"ו57,"
        },
        {
          "s": 9,
          "text": "דזה שגם עבד פשוט"
        },
        {
          "s": 10,
          "text": "[שעבודתו היא מצד עול האדון המוטל עליו]"
        },
        {
          "s": 11,
          "text": "משתדל שהמלאכה שעושה תהי' לנוי ולתפארת לאדונו,"
        },
        {
          "s": 12,
          "text": "הוא לפי שגם עבד הפשוט יש לו תענוג בהעבודה,"
        },
        {
          "s": 13,
          "text": "אלא שהתענוג דעבד הפשוט הוא"
        },
        {
          "s": 14,
          "text": "[לא מצד ענינו ומציאותו של העבד,"
        },
        {
          "s": 15,
          "text": "אלא אדרבה]"
        },
        {
          "s": 16,
          "text": "מצד הביטול שלו58,"
        },
        {
          "s": 17,
          "text": "דלהיות שאינו מציאות לעצמו לכן התענוג של האדון הוא התענוג שלו."
        },
        {
          "s": 18,
          "text": "ועד\"ז הוא בעבודת ה',"
        },
        {
          "s": 19,
          "text": "שבהעבודה דקבלת עול יש גם ענין התענוג,"
        },
        {
          "s": 20,
          "text": "אלא שהתענוג הוא התענוג דלמעלה."
        },
        {
          "s": 21,
          "text": "ויש לומר,"
        },
        {
          "s": 22,
          "text": "דזה שגם בהעבודה דקב\"ע יש ענין התענוג,"
        },
        {
          "s": 23,
          "text": "הוא לפי שגם העבודה דקב\"ע נמשכת מהתורה,"
        },
        {
          "s": 24,
          "text": "שהתורה אמרה ועבדתם את ה' אלקיכם גו'."
        }
      ]
    }
  ]
}