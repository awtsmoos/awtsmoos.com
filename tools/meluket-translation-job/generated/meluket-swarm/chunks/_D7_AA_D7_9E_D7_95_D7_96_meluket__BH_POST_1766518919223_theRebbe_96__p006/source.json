{
  "globalIndex": 921,
  "owner": 21,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919223_theRebbe_96__p006",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919223_theRebbe_96__p006",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919223_theRebbe_96",
  "title": "מאמר תפלה למשה תשכ\"ט",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דמהטעמים על זה שמביא בהמאמר"
        },
        {
          "s": 2,
          "text": "(הובא לעיל סעיף ד)"
        },
        {
          "s": 3,
          "text": "מ\"ש יחיינו מיומיים ביום השלישי גו' ומבאר דיומיים הם ב' הגילויים דממלא וסובב ויום השלישי הוא גילוי עצמות אוא\"ס,"
        },
        {
          "s": 4,
          "text": "וג' גילויים אלו מתגלים בג' זמנים,"
        },
        {
          "s": 5,
          "text": "הוא לרמז,"
        },
        {
          "s": 6,
          "text": "דהגם שזמן הוא מגדרי העולם76"
        },
        {
          "s": 7,
          "text": "והחיות דהעולם"
        },
        {
          "s": 8,
          "text": "(המלובש בו בפנימיותו)"
        },
        {
          "s": 9,
          "text": "הוא ממלא,"
        },
        {
          "s": 10,
          "text": "מ\"מ,"
        },
        {
          "s": 11,
          "text": "שייך העולם גם לסובב וגם לאוא\"ס שלמעלה מסובב."
        },
        {
          "s": 12,
          "text": "ולהעיר,"
        },
        {
          "s": 13,
          "text": "שעד\"ז הוא בנוגע למקום"
        },
        {
          "s": 14,
          "text": "[שגדר העולם הוא מקום וזמן76],"
        },
        {
          "s": 15,
          "text": "דענין המקום שבעולם הוא שיש בו חילוקי דרגות מעלה ומטה84,"
        },
        {
          "s": 16,
          "text": "דהגם שההתחלקות מעלה ומטה שבעולם הוא מצד החילוק בהחיות המלובש בו,"
        },
        {
          "s": 17,
          "text": "ממלא"
        },
        {
          "s": 18,
          "text": "[כמארז\"ל85"
        },
        {
          "s": 19,
          "text": "נטה ימינו וברא שמים נטה שמאלו וברא ארץ,"
        },
        {
          "s": 20,
          "text": "דשמים"
        },
        {
          "s": 21,
          "text": "(עולמות העליונים)"
        },
        {
          "s": 22,
          "text": "הם מבחינת ימין וארץ"
        },
        {
          "s": 23,
          "text": "(עולמות התחתונים)"
        },
        {
          "s": 24,
          "text": "הם מבחינת שמאל,"
        },
        {
          "s": 25,
          "text": "והחילוק דימין ושמאל הוא בהחיות דבחינת ממלא כמ\"ש בהמשך ההילולא86"
        },
        {
          "s": 26,
          "text": "ומובן גם בפשטות],"
        },
        {
          "s": 27,
          "text": "מ\"מ,"
        },
        {
          "s": 28,
          "text": "כללות כל העולמות נחלקים לשלשה עולמות בריאה יצירה ועשי'87,"
        },
        {
          "s": 29,
          "text": "שהם דוגמת ג' גילויים הנ\"ל."
        },
        {
          "s": 30,
          "text": "וכמבואר בכ\"מ88,"
        },
        {
          "s": 31,
          "text": "שחומר"
        },
        {
          "s": 32,
          "text": "(בריאה),"
        },
        {
          "s": 33,
          "text": "עצם המציאות שלמעלה מצורה וגילוי,"
        },
        {
          "s": 34,
          "text": "הוא דוגמת העלם העצמי דעצמות אוא\"ס,"
        },
        {
          "s": 35,
          "text": "וצורה"
        },
        {
          "s": 36,
          "text": "(יצירה),"
        },
        {
          "s": 37,
          "text": "גילוי החומר,"
        },
        {
          "s": 38,
          "text": "הוא דוגמת הסובב שהוא גילוי עצמות אוא\"ס,"
        },
        {
          "s": 39,
          "text": "ותיקון"
        },
        {
          "s": 40,
          "text": "(עשי'),"
        },
        {
          "s": 41,
          "text": "ציור פרטי,"
        },
        {
          "s": 42,
          "text": "הוא דוגמת הממלא שמתלבש בכל עולם ובכל נברא לפי ערכו."
        },
        {
          "s": 43,
          "text": "וזהו גם מ\"ש בהמאמר89"
        },
        {
          "s": 44,
          "text": "בפירוש נוסח ברכת בורא נפשות,"
        },
        {
          "s": 45,
          "text": "דחסרונן לשון רבים הם ב' הענינים דמילוי החסרון שמצד ממכ\"ע וסוכ\"ע,"
        },
        {
          "s": 46,
          "text": "ועל כל מה שבראת להחיות בהם,"
        },
        {
          "s": 47,
          "text": "דפירש בטור90"
        },
        {
          "s": 48,
          "text": "שהם דברים הבאים לעידון ולתענוג,"
        },
        {
          "s": 49,
          "text": "הו\"ע ריבוי השפע דעשירות שמצד גילוי עצמות אוא\"ס,"
        },
        {
          "s": 50,
          "text": "דיש לומר,"
        },
        {
          "s": 51,
          "text": "שמהטעמים שמביא פירוש זה בהמאמר,"
        },
        {
          "s": 52,
          "text": "הוא לרמז,"
        },
        {
          "s": 53,
          "text": "שגם בעולם העשי'"
        },
        {
          "s": 54,
          "text": "(כולל גם עוה\"ז הגשמי)"
        },
        {
          "s": 55,
          "text": "ישנם ג' הענינים."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "אלא שהחיות האלקי המלובש בהעולם"
        },
        {
          "s": 1,
          "text": "(ממלא)"
        },
        {
          "s": 2,
          "text": "הוא בגילוי בהעולם,"
        },
        {
          "s": 3,
          "text": "וזה שגם גילוי חיות זה הוא ע\"י העבודה דישראל"
        },
        {
          "s": 4,
          "text": "[וכמו שנתבאר בד\"ה זאת חוקת התורה91"
        },
        {
          "s": 5,
          "text": "שגילוי ג' הענינים דממלא סובב ועצמות אוא\"ס הוא ע\"י ג' האהבות דבכל לבבך ובכל נפשך ובכל מאדך],"
        },
        {
          "s": 6,
          "text": "הוא,"
        },
        {
          "s": 7,
          "text": "כי זה שהחיות דממלא הוא בגילוי בהעולם הוא שבהעולם נרגש שהוא חי,"
        },
        {
          "s": 8,
          "text": "אבל אין נרגש בו שהחיות שבו הוא אלקות,"
        },
        {
          "s": 9,
          "text": "וע\"י העבודה דישראל נרגש בהעולם שהחיות שבו הוא אלקות."
        },
        {
          "s": 10,
          "text": "וגילוי זה הוא גם עכשיו,"
        },
        {
          "s": 11,
          "text": "בעולם הזה."
        },
        {
          "s": 12,
          "text": "והחיות דסובב שאינו מלובש בהעולם ורק סובב ומקיף עליו,"
        },
        {
          "s": 13,
          "text": "ומכש\"כ אוא\"ס שלמעלה מסובב – המשכתם בעולם היא ע\"י העבודה דישראל,"
        },
        {
          "s": 14,
          "text": "והגילוי דהמשכות אלו יהי' לע\"ל,"
        },
        {
          "s": 15,
          "text": "בימות המשיח"
        },
        {
          "s": 16,
          "text": "(גילוי הסובב)"
        },
        {
          "s": 17,
          "text": "ותחיית המתים"
        },
        {
          "s": 18,
          "text": "(גילוי עצמות אוא\"ס שלמעלה מסובב),"
        },
        {
          "s": 19,
          "text": "כנ\"ל"
        },
        {
          "s": 20,
          "text": "(סעיף ד)."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ומבאר בהמאמר92,"
        },
        {
          "s": 2,
          "text": "דזה שמשה נקרא עשיר"
        },
        {
          "s": 3,
          "text": "[וכנ\"ל סעיף ג שתפלה למשה היא תפלת עשיר]"
        },
        {
          "s": 4,
          "text": "הוא לפי שמשה הוא בחינת דעת עליון."
        },
        {
          "s": 5,
          "text": "והענין הוא,"
        },
        {
          "s": 6,
          "text": "דדעת תחתון מקבל מחיצוניות הכתר,"
        },
        {
          "s": 7,
          "text": "אריך,"
        },
        {
          "s": 8,
          "text": "ודעת עליון מקבל מפנימיות הכתר,"
        },
        {
          "s": 9,
          "text": "עתיק."
        },
        {
          "s": 10,
          "text": "והחילוק בין אריך לעתיק הוא,"
        },
        {
          "s": 11,
          "text": "שאריך הוא שורש ומקור הנאצלים,"
        },
        {
          "s": 12,
          "text": "בחי' סובב"
        },
        {
          "s": 13,
          "text": "[וכנ\"ל סעיף ד שסובב הוא כמו מקור לעולמות],"
        },
        {
          "s": 14,
          "text": "ועתיק הוא בחינה תחתונה שבמאציל,"
        },
        {
          "s": 15,
          "text": "עצמות אוא\"ס שלמעלה מגדר עולמות."
        },
        {
          "s": 16,
          "text": "וכיון שגילוי הסובב"
        },
        {
          "s": 17,
          "text": "(אריך)"
        },
        {
          "s": 18,
          "text": "הוא בכלל מילוי החסרון וענין העשירות הוא דוקא בעצמות אוא\"ס שלמעלה מסובב"
        },
        {
          "s": 19,
          "text": "(עתיק),"
        },
        {
          "s": 20,
          "text": "לכן,"
        },
        {
          "s": 21,
          "text": "גם בדעת,"
        },
        {
          "s": 22,
          "text": "ענין העשירות הוא דוקא בדעת עליון שמקבל מפנימיות הכתר."
        }
      ]
    }
  ]
}