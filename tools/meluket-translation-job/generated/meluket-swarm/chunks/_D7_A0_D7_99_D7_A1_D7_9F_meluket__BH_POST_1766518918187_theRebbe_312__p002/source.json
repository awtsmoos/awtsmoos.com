{
  "globalIndex": 755,
  "owner": 5,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918187_theRebbe_312__p002",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918187_theRebbe_312__p002",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518918187_theRebbe_312",
  "title": "מאמר החודש הזה לכם תשל\"א",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "אך הענין הוא11,"
        },
        {
          "s": 2,
          "text": "ע\"פ מ\"ש בעקידה12"
        },
        {
          "s": 3,
          "text": "שבהנהגת העולם ע\"י הקב\"ה יש ב' אופנים."
        },
        {
          "s": 4,
          "text": "הנהגה טבעית,"
        },
        {
          "s": 5,
          "text": "והנהגה שלמעלה מהטבע שהיא הנהגה ניסית."
        },
        {
          "s": 6,
          "text": "וזהו החילוק שבין ר\"ה שבא' בתשרי לר\"ח ניסן,"
        },
        {
          "s": 7,
          "text": "דא' בתשרי הוא ר\"ה להנהגה הטבעית,"
        },
        {
          "s": 8,
          "text": "ובלשון הכתוב חוקות שמים וארץ גו'13."
        },
        {
          "s": 9,
          "text": "ועז\"נ זרע וקציר וקר וחם וקיץ וחרף גו' לא ישבותו14,"
        },
        {
          "s": 10,
          "text": "שבזה נכללים כל השינויים שבמשך חדשי השנה,"
        },
        {
          "s": 11,
          "text": "וכדאיתא בגמרא15"
        },
        {
          "s": 12,
          "text": "חצי תשרי מרחשון וחצי כסלו זרע וכו',"
        },
        {
          "s": 13,
          "text": "היינו,"
        },
        {
          "s": 14,
          "text": "שכל א' משש תקופות אלה כוללת ב' חדשים מחדשי השנה."
        },
        {
          "s": 15,
          "text": "ור\"ח ניסן הוא ר\"ה להנהגה ניסית,"
        },
        {
          "s": 16,
          "text": "שזהו\"ע הגאולה דיצי\"מ שבחודש ניסן שהיתה באופן ניסי."
        },
        {
          "s": 17,
          "text": "והתחלת הגאולה היתה בר\"ח ניסן,"
        },
        {
          "s": 18,
          "text": "כשנאמרה פרשת החודש הזה לכם שבה נאמר גם הציווי דקרבן פסח,"
        },
        {
          "s": 19,
          "text": "כדאיתא במכילתא"
        },
        {
          "s": 20,
          "text": "(הובא ברש\"י)"
        },
        {
          "s": 21,
          "text": "עה\"פ16"
        },
        {
          "s": 22,
          "text": "וילכו ויעשו,"
        },
        {
          "s": 23,
          "text": "וכי כבר עשו,"
        },
        {
          "s": 24,
          "text": "אלא משקבלו עליהם לעשות מעלה עליהם כאילו עשו."
        },
        {
          "s": 25,
          "text": "ומרומז גם במארז\"ל17"
        },
        {
          "s": 26,
          "text": "יכול מראש חודש כו'"
        },
        {
          "s": 27,
          "text": "[ובפרט ע\"פ הפירוש18"
        },
        {
          "s": 28,
          "text": "יכול מראש חודש"
        },
        {
          "s": 29,
          "text": "(לא רק בתור קס\"ד,"
        },
        {
          "s": 30,
          "text": "אלא)"
        },
        {
          "s": 31,
          "text": "בניחותא,"
        },
        {
          "s": 32,
          "text": "שאפשר להיות כבר בר\"ח,"
        },
        {
          "s": 33,
          "text": "אלא שאינו דומה לכמו שהוא ביום ההוא,"
        },
        {
          "s": 34,
          "text": "ובפרט בשעה שיש מצה ומרור מונחים לפניך],"
        },
        {
          "s": 35,
          "text": "שמזה מובן שענין הגאולה התחיל כבר מר\"ח ניסן,"
        },
        {
          "s": 36,
          "text": "שהוא ר\"ה להנהגה נסית."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה החילוק שבין הנהגה טבעית"
        },
        {
          "s": 2,
          "text": "(תשרי)"
        },
        {
          "s": 3,
          "text": "להנהגה ניסית"
        },
        {
          "s": 4,
          "text": "(ניסן)19,"
        },
        {
          "s": 5,
          "text": "מובן ע\"פ מארז\"ל20"
        },
        {
          "s": 6,
          "text": "כשבחר הקב\"ה בעולמו קבע בו ראשי חדשים ושנים,"
        },
        {
          "s": 7,
          "text": "ומשבחר ביעקב ובניו קבע להם ראש חודש של גאולה,"
        },
        {
          "s": 8,
          "text": "היינו,"
        },
        {
          "s": 9,
          "text": "שהנהגה טבעית היא ההנהגה שקבע הקב\"ה בעולמו שתהי' בתמידות ללא הפסק,"
        },
        {
          "s": 10,
          "text": "משא\"כ הנהגה ניסית שהיא באופן של חידוש קשורה עם יעקב ובניו,"
        },
        {
          "s": 11,
          "text": "שהמשכתה היא ע\"י עבודתם של ישראל בכח עצמם דוקא21."
        },
        {
          "s": 12,
          "text": "וכמודגש ביצי\"מ שהיתה בזכות דם פסח ודם מילה22,"
        },
        {
          "s": 13,
          "text": "וכמ\"ש23"
        },
        {
          "s": 14,
          "text": "ואומר לך בדמיך חיי ואומר לך בדמיך חיי וגו' ואת ערם וערי' וגו'."
        },
        {
          "s": 15,
          "text": "וענין זה התחיל כבר בר\"ח,"
        },
        {
          "s": 16,
          "text": "וכנ\"ל,"
        },
        {
          "s": 17,
          "text": "שאז קיבלו לעשות הציווי ויקחו להם איש שה גו'24,"
        },
        {
          "s": 18,
          "text": "שבזה מודגש התוקף בעבודת בנ\"י,"
        },
        {
          "s": 19,
          "text": "שלמרות היות השה הע\"ז של מצרים,"
        },
        {
          "s": 20,
          "text": "לא התפעלו בנ\"י מהמצריים ולקחו השה לשחטו לקרבן לה'25,"
        },
        {
          "s": 21,
          "text": "שזוהי הנהגה נסית בענין העבודה"
        },
        {
          "s": 22,
          "text": "[ולהוסיף,"
        },
        {
          "s": 23,
          "text": "שבענין זה יש חידוש בר\"ח ניסן ובעשור לחודש גם לגבי ט\"ו ניסן,"
        },
        {
          "s": 24,
          "text": "כיון שבר\"ח ניסן היו עדיין בגלות מצרים,"
        },
        {
          "s": 25,
          "text": "ואעפ\"כ לא התפעלו מהמצריים כו'],"
        },
        {
          "s": 26,
          "text": "ועי\"ז פעלו שתהי' גם הנהגה מלמעלה באופן נסי."
        },
        {
          "s": 27,
          "text": "והענין בזה,"
        },
        {
          "s": 28,
          "text": "שע\"י עבודה בכח עצמו דוקא,"
        },
        {
          "s": 29,
          "text": "ממשיכים המשכה חדשה שהיא למעלה מההמשכה שישנה בתמידות,"
        },
        {
          "s": 30,
          "text": "כי,"
        },
        {
          "s": 31,
          "text": "ההמשכה שישנה בתמידות היא מבחינת החיצוניות בלבד,"
        },
        {
          "s": 32,
          "text": "וע\"י העבודה בכח עצמו ממשיכים מבחינת הפנימיות."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וביאור הענין,"
        },
        {
          "s": 2,
          "text": "דהנה,"
        },
        {
          "s": 3,
          "text": "אף שגם בהנהגה טבעית ניכרת גדולת הבורא,"
        },
        {
          "s": 4,
          "text": "ולא עוד אלא שדוקא בהנהגה טבעית באופן דלא ישבותו ניכר ומתגלה הענין דאני הוי' לא שניתי26,"
        },
        {
          "s": 5,
          "text": "מ\"מ,"
        },
        {
          "s": 6,
          "text": "בהנהגה ניסית מתגלית דרגא נעלית יותר שלמעלה גם מבחינת אני הוי' לא שניתי."
        },
        {
          "s": 7,
          "text": "והענין בזה,"
        },
        {
          "s": 8,
          "text": "דמ\"ש אני הוי' לא שניתי הוא בבחינה שיש בה שייכות ונתינת מקום לענין השינוי,"
        },
        {
          "s": 9,
          "text": "שלכן צריך לשלול ולומר אני הוי' לא."
        },
        {
          "s": 10,
          "text": "שניתי,"
        },
        {
          "s": 11,
          "text": "משא\"כ בבחי' שלמעלה מגדר השינוי לגמרי,"
        },
        {
          "s": 12,
          "text": "לא שייך כלל לומר לא שניתי."
        },
        {
          "s": 13,
          "text": "ובלשון רבינו הזקן בשער היחוד והאמונה27,"
        },
        {
          "s": 14,
          "text": "שהאומר על איזו חכמה רמה ועמוקה שאי אפשר למששה בידים מפני עומק המושג הנה כל השומע יצחק לו,"
        },
        {
          "s": 15,
          "text": "והיינו לפי שהחכמה אין לה שום ערך ושייכות לחוש המישוש,"
        },
        {
          "s": 16,
          "text": "ולכן לא שייך לשלול בה ענין המישוש."
        },
        {
          "s": 17,
          "text": "וכמו כן לא שייך לשלול ענין השינוי בבחינה שלמעלה מענין השינוי לגמרי."
        },
        {
          "s": 18,
          "text": "וע\"ד המבואר בשו\"ת הרשב\"א28"
        },
        {
          "s": 19,
          "text": "(הובא בספר החקירה להצ\"צ29)"
        },
        {
          "s": 20,
          "text": "בפירוש הכתוב30"
        },
        {
          "s": 21,
          "text": "ואתה הוא ושנותיך לא יתמו,"
        },
        {
          "s": 22,
          "text": "שהכתוב מדבר בגדר הזמן"
        },
        {
          "s": 23,
          "text": "(שהוא בהשגת האדם שהוא בעל גבול),"
        },
        {
          "s": 24,
          "text": "שזהו\"ע דשנותיך,"
        },
        {
          "s": 25,
          "text": "ובגדר הזמן יש צורך לשלול ולומר לא יתמו,"
        },
        {
          "s": 26,
          "text": "אבל לא שייך לומר כן בהבחי' שלמעלה מהזמן לגמרי"
        },
        {
          "s": 27,
          "text": "[כמו בבחינת השבת שהוא למעלה מהזמן,"
        },
        {
          "s": 28,
          "text": "שלכן בכל יום ראשון אומרים היום יום ראשון בשבת,"
        },
        {
          "s": 29,
          "text": "אע\"פ שעברו כמה וכמה מאות ואלפים ימים מעת בריה\"ע,"
        },
        {
          "s": 30,
          "text": "לפי שבחינת השבת הוא למעלה מן הזמן לגמרי31."
        },
        {
          "s": 31,
          "text": "ועד\"ז בנוגע לראש חודש שהוא בדוגמת שבת32]."
        },
        {
          "s": 32,
          "text": "וזהו שהנהגה טבעית"
        },
        {
          "s": 33,
          "text": "(שבה צריך לשלול את ענין השינוי,"
        },
        {
          "s": 34,
          "text": "אני הוי' לא שניתי)"
        },
        {
          "s": 35,
          "text": "נמשכת מבחינת החיצוניות,"
        },
        {
          "s": 36,
          "text": "משא\"כ הנהגה ניסית"
        },
        {
          "s": 37,
          "text": "(שבה לא שייך לשלול את ענין השינוי)"
        },
        {
          "s": 38,
          "text": "היא מבחינת הפנימיות שלמעלה לגמרי מעולמות."
        }
      ]
    }
  ]
}