{
  "globalIndex": 1083,
  "owner": 33,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920213_theRebbe_982__p001",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920213_theRebbe_982__p001",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920213_theRebbe_982",
  "title": "מאמר אני לדודי תשמ\"ו",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "אור ליום ה' פ' שופטים,"
        },
        {
          "s": 2,
          "text": "אדר\"ח אלול ה'תשמ\"ו*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "אני לדודי ודודי לי1"
        },
        {
          "s": 1,
          "text": "ר\"ת אלול2,"
        },
        {
          "s": 2,
          "text": "ומבאר בזה בדרוש הידוע בלקו\"ת3,"
        },
        {
          "s": 3,
          "text": "דבאלול מתחיל בחי' אני לדודי דהיינו בחי' אתערותא דלתתא,"
        },
        {
          "s": 4,
          "text": "עד ראש השנה ויום הכיפורים שהם בחי' המשכת אלקותו ית' למטה בבחי' התגלות."
        },
        {
          "s": 5,
          "text": "דזהו אני לדודי,"
        },
        {
          "s": 6,
          "text": "האתעדל\"ת"
        },
        {
          "s": 7,
          "text": "(מלמטה)"
        },
        {
          "s": 8,
          "text": "שבחודש אלול,"
        },
        {
          "s": 9,
          "text": "ואח\"כ ודודי לי,"
        },
        {
          "s": 10,
          "text": "ההמשכה מלמעלה בימים נוראים."
        },
        {
          "s": 11,
          "text": "אמנם הגם שענינו של חודש אלול הוא ההתעוררות מלמטה,"
        },
        {
          "s": 12,
          "text": "מ\"מ צ\"ל ע\"ז התעוררות ונתינת כח מלמעלה4."
        },
        {
          "s": 13,
          "text": "וזהו מה שמבאר בהמשך הדרוש,"
        },
        {
          "s": 14,
          "text": "שבחודש אלול הוא זמן התגלות י\"ג מדות הרחמים5,"
        },
        {
          "s": 15,
          "text": "שזהו ענין האתעדל\"ע המעוררת את האתעדל\"ת דאני לדודי6."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ומבאר זה7"
        },
        {
          "s": 2,
          "text": "ע\"פ משל למלך שקודם בואו לעיר יוצאין אנשי העיר לקראתו ומקבלין פניו בשדה ואז רשאין"
        },
        {
          "s": 3,
          "text": "[ומוסיף בזה כ\"ק מו\"ח אדמו\"ר נשיא דורנו8"
        },
        {
          "s": 4,
          "text": ": ויכולים]"
        },
        {
          "s": 5,
          "text": "כל מי שרוצה להקביל פניו,"
        },
        {
          "s": 6,
          "text": "והוא מקבל את כולם בסבר פנים יפות ומראה פנים שוחקות לכולם,"
        },
        {
          "s": 7,
          "text": "ובלכתו העירה הרי הם הולכים אחריו,"
        },
        {
          "s": 8,
          "text": "ואח\"כ בבואו להיכל מלכותו אין נכנסים כ\"א ברשות ואף גם זאת המובחרים שבעם ויחידי סגולה."
        },
        {
          "s": 9,
          "text": "וממשיך,"
        },
        {
          "s": 10,
          "text": "שכך הענין עד\"מ בחודש אלול יוצאין להקביל אור פניו ית' בשדה."
        },
        {
          "s": 11,
          "text": "ומבאר,"
        },
        {
          "s": 12,
          "text": "דענין הארת י\"ג מדה\"ר הו\"ע יאר ה' פניו אליך9,"
        },
        {
          "s": 13,
          "text": "דיש לומר,"
        },
        {
          "s": 14,
          "text": "שזהו\"ע מה שהמלך מקבל את כולם בסבר פנים יפות ומראה פנים שוחקות וכו',"
        },
        {
          "s": 15,
          "text": "ועד שאפ\"ל ענין של בקשה אל המלך עצמו וכו'."
        },
        {
          "s": 16,
          "text": "וכמבואר פרטי הענין בזה בעבודת האדם בלקו\"ת שם."
        }
      ]
    }
  ]
}