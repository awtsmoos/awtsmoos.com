{
  "globalIndex": 206,
  "owner": 6,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914993_theRebbe_833__p002",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914993_theRebbe_833__p002",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518914993_theRebbe_833",
  "title": "מאמר ויהיו חיי שרה תנש\"א",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "וצריך להבין,"
        },
        {
          "s": 2,
          "text": "דלפירוש זה,"
        },
        {
          "s": 3,
          "text": "שני חיי שרה הו\"ע בפ\"ע שלמעלה מג' החלוקות דמאה שנה ועשרים שנה ושבע שנים,"
        },
        {
          "s": 4,
          "text": "ופשטות הכתוב ששני חיי שרה הם הקכ\"ז שנים עצמם,"
        },
        {
          "s": 5,
          "text": "ולא ענין בפ\"ע שלמעלה מהם."
        },
        {
          "s": 6,
          "text": "וכמודגש בפירוש רש\"י13"
        },
        {
          "s": 7,
          "text": "שני חיי שרה כולן שוין לטובה,"
        },
        {
          "s": 8,
          "text": "שהענין דשוין לטובה"
        },
        {
          "s": 9,
          "text": "(למעלה מהתחלקות)"
        },
        {
          "s": 10,
          "text": "הוא בכולן,"
        },
        {
          "s": 11,
          "text": "היינו,"
        },
        {
          "s": 12,
          "text": "בג' החלוקות דמאה שנה ועשרים שנה ושבע שנים"
        },
        {
          "s": 13,
          "text": "(ולא בדרגא שלמעלה מהם)."
        },
        {
          "s": 14,
          "text": "גם צריך להבין מ\"ש בפירוש רש\"י בת ק' כבת כ' ובת כ' כבת ז',"
        },
        {
          "s": 15,
          "text": "שמזה משמע שיש עילוי בז' לגבי כ'"
        },
        {
          "s": 16,
          "text": "(בת כ' כבת ז')"
        },
        {
          "s": 17,
          "text": "ובכ' לגבי ק'"
        },
        {
          "s": 18,
          "text": "(בת ק' כבת כ'),"
        },
        {
          "s": 19,
          "text": "אע\"פ שכתר"
        },
        {
          "s": 20,
          "text": "(ק')"
        },
        {
          "s": 21,
          "text": "הוא למעלה מהמוחין"
        },
        {
          "s": 22,
          "text": "(כ'),"
        },
        {
          "s": 23,
          "text": "ומוחין הם למעלה ממדות"
        },
        {
          "s": 24,
          "text": "(ז')."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ויובן בהקדם המבואר בכמה דרושים14"
        },
        {
          "s": 2,
          "text": "המשך דברי הזהר מאה שנה כללא דכולא,"
        },
        {
          "s": 3,
          "text": "שמאה שנה הוא רזא דמאה ברכאן בכל יומא,"
        },
        {
          "s": 4,
          "text": "שחייב אדם לברך מאה ברכות בכל יום,"
        },
        {
          "s": 5,
          "text": "כפי שלמדו חז\"ל15"
        },
        {
          "s": 6,
          "text": "מהפסוק16"
        },
        {
          "s": 7,
          "text": "ועתה ישראל מה ה' אלקיך שואל מעמך,"
        },
        {
          "s": 8,
          "text": "א\"ת מה אלא מאה17."
        },
        {
          "s": 9,
          "text": "ונקודת הביאור,"
        },
        {
          "s": 10,
          "text": "שמאה שנה הוא גם הכלל דעשרים שנה ושבע שנים,"
        },
        {
          "s": 11,
          "text": "כללא דכולא."
        },
        {
          "s": 12,
          "text": "דנוסף לזה שכל מאה הדרגות"
        },
        {
          "s": 13,
          "text": "(עשר ספירות שכל א' מהם כלולה מעשר)"
        },
        {
          "s": 14,
          "text": "שבכתר הם כלל אחד שלמעלה מהתחלקות"
        },
        {
          "s": 15,
          "text": "[למעלה גם מהכלל דעשרים שנה,"
        },
        {
          "s": 16,
          "text": "שיש בו שתי דרגות"
        },
        {
          "s": 17,
          "text": "(חכמה בינה)"
        },
        {
          "s": 18,
          "text": "אלא שהם תרין ריעין דלא מתפרשין],"
        },
        {
          "s": 19,
          "text": "הוא גם הכלל דכל ג' החלוקות,"
        },
        {
          "s": 20,
          "text": "גם דעשרים שנה ושבע שנים."
        },
        {
          "s": 21,
          "text": "וכמבואר בהדרושים18"
        },
        {
          "s": 22,
          "text": "שמאה שנה"
        },
        {
          "s": 23,
          "text": "(כללא דכולא)"
        },
        {
          "s": 24,
          "text": "נמשך ומתלבש בהפרטים דעשרים שנה"
        },
        {
          "s": 25,
          "text": "(מוחין)"
        },
        {
          "s": 26,
          "text": "ושבע שנים"
        },
        {
          "s": 27,
          "text": "(מדות)."
        },
        {
          "s": 28,
          "text": "ויש לומר,"
        },
        {
          "s": 29,
          "text": "שזה שמאה הוא"
        },
        {
          "s": 30,
          "text": "(גם)"
        },
        {
          "s": 31,
          "text": "הכלל דעשרים ושבע,"
        },
        {
          "s": 32,
          "text": "הוא,"
        },
        {
          "s": 33,
          "text": "לא רק להביאור שמאה הוא כתר,"
        },
        {
          "s": 34,
          "text": "דכיון שכתר הוא מקיף ה\"ה הכלל דכל העשר ספירות,"
        },
        {
          "s": 35,
          "text": "אלא גם להביאור שמאה הוא עצם המוחין,"
        },
        {
          "s": 36,
          "text": "דאף שמוחין הם כחות פנימיים,"
        },
        {
          "s": 37,
          "text": "יש לומר,"
        },
        {
          "s": 38,
          "text": "שעצם המוחין הוא גם הכלל דהדרגות שלמטה ממנו,"
        },
        {
          "s": 39,
          "text": "שלכן,"
        },
        {
          "s": 40,
          "text": "עצם המוחין נמשך ומתלבש"
        },
        {
          "s": 41,
          "text": "(אח\"כ)"
        },
        {
          "s": 42,
          "text": "בהמוחין השייכים אל המדות,"
        },
        {
          "s": 43,
          "text": "שנחלקים"
        },
        {
          "s": 44,
          "text": "(בכללות)"
        },
        {
          "s": 45,
          "text": "לב' קוין"
        },
        {
          "s": 46,
          "text": "(עשרים שנה),"
        },
        {
          "s": 47,
          "text": "חיוב ושלילה"
        },
        {
          "s": 48,
          "text": "(עשה ולא תעשה)19,"
        },
        {
          "s": 49,
          "text": "ועד שנמשך בהמדות עצמם"
        },
        {
          "s": 50,
          "text": "(שבע שנים)"
        },
        {
          "s": 51,
          "text": "שבהם היא עיקר העבודה."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "וביאור הענין דמאה שנה כללא דכולא שהוא רזא דמאה ברכות שבכל יום,"
        },
        {
          "s": 2,
          "text": "יובן ע\"פ המבואר בכמה דרושים20"
        },
        {
          "s": 3,
          "text": "שענין הברכות הוא כללות העבודה."
        },
        {
          "s": 4,
          "text": "דהנה,"
        },
        {
          "s": 5,
          "text": "ברכה היא מלשון המשכה,"
        },
        {
          "s": 6,
          "text": "והפירוש דברוך אתה הוי' הוא להמשיך שם הוי'21"
        },
        {
          "s": 7,
          "text": "שיהי' ברוך ונמשך בגילוי למטה."
        },
        {
          "s": 8,
          "text": "וסדר ההמשכה הוא,"
        },
        {
          "s": 9,
          "text": "שתחלה נמשך שם הוי' בנפש האדם,"
        },
        {
          "s": 10,
          "text": "הוי' אלקינו,"
        },
        {
          "s": 11,
          "text": "להיות גילוי אוא\"ס בנפש כל ישראל שתתחזק אמונת ה' בלבם בגילוי עד שנעשה אלקה שלנו,"
        },
        {
          "s": 12,
          "text": "כוחינו וחיותנו,"
        },
        {
          "s": 13,
          "text": "ולאחרי שנמשך ונתגלה בישראל,"
        },
        {
          "s": 14,
          "text": "נמשך על ידם הגילוי גם למטה להיות מלך העולם."
        },
        {
          "s": 15,
          "text": "ויש להוסיף,"
        },
        {
          "s": 16,
          "text": "שההמשכה והגילוי למטה מודגשים גם בתוכן הברכות,"
        },
        {
          "s": 17,
          "text": "כי,"
        },
        {
          "s": 18,
          "text": "נוסף לכך ש"
        },
        {
          "s": 19,
          "text": "(רוב ה)"
        },
        {
          "s": 20,
          "text": "ברכות קשורים עם עניני העולם"
        },
        {
          "s": 21,
          "text": "(שהרי אפילו ברכות המצוות קשורים עם עניני העולם שבהם מקיימים המצוות,"
        },
        {
          "s": 22,
          "text": "ציצית בצמר גשמי ותפילין בקלף גשמי כו'),"
        },
        {
          "s": 23,
          "text": "הרי הברכות עצמם הם על עניני העולם,"
        },
        {
          "s": 24,
          "text": "וכמו ברכות השחר22"
        },
        {
          "s": 25,
          "text": "שתקנום חכמים על סדר העולם והנהגתו מה שהבריות נהנין בכל יום שיברכו להקב\"ה על זה בפעם ראשונה שנהנין הנאה זו בכל יום23,"
        },
        {
          "s": 26,
          "text": "ועד\"ז הברכות על בקשת צרכיו הגשמיים רופא חולים ומברך השנים וכיו\"ב,"
        },
        {
          "s": 27,
          "text": "ועאכו\"כ ברכות הנהנין שמברכים לפני אכילה ושתי',"
        },
        {
          "s": 28,
          "text": "שע\"י הברכה נעשה הדבר מותר באכילה ושתי',"
        },
        {
          "s": 29,
          "text": "כמארז\"ל24"
        },
        {
          "s": 30,
          "text": "כל הנהנה מעוה\"ז בלא ברכה כאילו נהנה מקדשי שמים,"
        },
        {
          "s": 31,
          "text": "שנאמר25"
        },
        {
          "s": 32,
          "text": "לה' הארץ ומלואה,"
        },
        {
          "s": 33,
          "text": "לאחר ברכה הרי היא לבני אדם,"
        },
        {
          "s": 34,
          "text": "היינו,"
        },
        {
          "s": 35,
          "text": "שפעולת הברכה היא"
        },
        {
          "s": 36,
          "text": "(לא לבטל ח\"ו העילוי דקדשי שמים שבדבר זה,"
        },
        {
          "s": 37,
          "text": "אלא)"
        },
        {
          "s": 38,
          "text": "שקדשי שמים נעשים שלו,"
        },
        {
          "s": 39,
          "text": "שאכילתו ושתייתו היא בבחינת קדשי שמים,"
        },
        {
          "s": 40,
          "text": "כיון שע\"י הברכה נעשה הבירור והזיכוך דהדברים הגשמיים להיות נמשך בהם הגילוי ד"
        },
        {
          "s": 41,
          "text": "(הוי' אלקינו)"
        },
        {
          "s": 42,
          "text": "מלך העולם."
        },
        {
          "s": 43,
          "text": "וזהו הפירוש בדברי הזהר מאה שנה כללא דכולא ברזא דמאה ברכאן בכל יומא26,"
        },
        {
          "s": 44,
          "text": "כי הענין דמאה ברכות הוא כללות כל העבודה להמשיך אלקות למטה,"
        },
        {
          "s": 45,
          "text": "וזהו\"ע דמאה שנה כללא דכולא,"
        },
        {
          "s": 46,
          "text": "כללות העבודה להמשיך אלקות למטה,"
        },
        {
          "s": 47,
          "text": "ע\"י ההמשכה וההתלבשות בהמוחין השייכים אל המדות"
        },
        {
          "s": 48,
          "text": "(עשרים שנה)"
        },
        {
          "s": 49,
          "text": "ועד לבחינת המדות"
        },
        {
          "s": 50,
          "text": "(שבע שנים),"
        },
        {
          "s": 51,
          "text": "שבעת ימי הבנין,"
        },
        {
          "s": 52,
          "text": "שעל ידם נברא העולם27,"
        },
        {
          "s": 53,
          "text": "ובהם"
        },
        {
          "s": 54,
          "text": "(בבחינת המדות)"
        },
        {
          "s": 55,
          "text": "היא עיקר העבודה בזמן הזה28."
        }
      ]
    }
  ]
}