{
  "globalIndex": 394,
  "owner": 44,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518916037_theRebbe_540__p001",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518916037_theRebbe_540__p001",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518916037_theRebbe_540",
  "title": "מאמר וישב יעקב תשכ\"ז",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ וישב,"
        },
        {
          "s": 2,
          "text": "כ\"ף כסלו,"
        },
        {
          "s": 3,
          "text": "ה'תשכ\"ז"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "וישב יעקב בארץ מגורי אביו בארץ כנען,"
        },
        {
          "s": 1,
          "text": "ומבאר רבינו הזקן בעל הגאולה והשמחה בספרו תו\"א1,"
        },
        {
          "s": 2,
          "text": "להבין כפל לשון בארץ מגורי אביו בארץ כנען,"
        },
        {
          "s": 3,
          "text": "שכנען פירושו סוחר,"
        },
        {
          "s": 4,
          "text": "כמ\"ש2"
        },
        {
          "s": 5,
          "text": "כנעני' נכבדי ארץ,"
        },
        {
          "s": 6,
          "text": "וכתיב3"
        },
        {
          "s": 7,
          "text": "כנען בידו מאזני מרמה,"
        },
        {
          "s": 8,
          "text": "וכמו הסוחר שמפזר ממון בכדי להרויח ולהשתכר,"
        },
        {
          "s": 9,
          "text": "וכל עיקר כוונתו היא להיות מפזר ונוסף עוד4"
        },
        {
          "s": 10,
          "text": "[דתכלית ענין המסחר הוא הריוח,"
        },
        {
          "s": 11,
          "text": "וכמארז\"ל5"
        },
        {
          "s": 12,
          "text": "זבון וזבין תגרא איקרי בתמי'],"
        },
        {
          "s": 13,
          "text": "כ\"ה גם ענין ירידת הנשמה למטה שתכלית הירידה היא בשביל העלי',"
        },
        {
          "s": 14,
          "text": "שע\"י ירידתה למטה והתלבשותה בגוף ונה\"ב דוקא באה לבחי' עליונה יותר מכמו שהיתה קודם ירידתה."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ולהבין זה בביאור יותר ובאריכות יותר,"
        },
        {
          "s": 1,
          "text": "גם להבין מ\"ש רש\"י עה\"פ וישב יעקב,"
        },
        {
          "s": 2,
          "text": "אחר שכתב לך ישובי עשו ותולדותיו בדרך קצרה,"
        },
        {
          "s": 3,
          "text": "שלא היו ספונים וחשובים לפרש כו' פירש לך ישובי יעקב ותולדותיו בדרך ארוכה כו'."
        },
        {
          "s": 4,
          "text": "דלכאורה מכיון שישובי עשו ותולדותיו אינם ספונים וחשובים לא הוצרך לכתבם כלל,"
        },
        {
          "s": 5,
          "text": "גם לא בדרך קצרה."
        },
        {
          "s": 6,
          "text": "וצריך לומר,"
        },
        {
          "s": 7,
          "text": "דהגם שישובי עשו,"
        },
        {
          "s": 8,
          "text": "מצ\"ע,"
        },
        {
          "s": 9,
          "text": "אינם ספונים וחשובים,"
        },
        {
          "s": 10,
          "text": "מ\"מ,"
        },
        {
          "s": 11,
          "text": "מכיון שעל ידם באים לישובי יעקב,"
        },
        {
          "s": 12,
          "text": "כתבם בקרא."
        },
        {
          "s": 13,
          "text": "אלא דלהיות שכל ענינם הוא מה שע\"י באים לישובי יעקב,"
        },
        {
          "s": 14,
          "text": "כתבם בדרך קצרה."
        },
        {
          "s": 15,
          "text": "משא\"כ ישובי יעקב ותולדותיו,"
        },
        {
          "s": 16,
          "text": "שהם ספונים וחשובים מצד עצמם,"
        },
        {
          "s": 17,
          "text": "פירש אותם בדרך ארוכה."
        },
        {
          "s": 18,
          "text": "וצריך להבין מהו ענין מה שע\"י ישובי עשו באים לישובי יעקב,"
        },
        {
          "s": 19,
          "text": "וגם צריך להבין דיוק הלשון דרך קצרה ודרך ארוכה."
        }
      ]
    }
  ]
}