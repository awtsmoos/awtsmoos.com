{
  "globalIndex": 826,
  "owner": 26,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918708_theRebbe_155__p002",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918708_theRebbe_155__p002",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918708_theRebbe_155",
  "title": "מאמר בשעה שעלה משה למרום תשכ\"ה",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "והענין הוא,"
        },
        {
          "s": 1,
          "text": "דבהטעם על זה שהתורה ניתנה למטה בארץ דוקא,"
        },
        {
          "s": 2,
          "text": "שני ענינים."
        },
        {
          "s": 3,
          "text": "לפי שההמשכה שע\"י המצוות היא כשקיום המצוות הוא בגשמיות,"
        },
        {
          "s": 4,
          "text": "וגם לפי שע\"י קיום המצוות למטה נעשה הבירור דנפש הבהמית10."
        },
        {
          "s": 5,
          "text": "וזהו שאמר משה כלום אתם עושים מלאכה כו' יצה\"ר יש ביניכם,"
        },
        {
          "s": 6,
          "text": "דהטעם שהתורה לא ניתנה בשמים למלאכים הוא כי אז היו חסרים שני הענינים."
        },
        {
          "s": 7,
          "text": "כלום אתם עושים מלאכה שאתם צריכים שבות,"
        },
        {
          "s": 8,
          "text": "ולכן אין שייך שיקיימו מצות שבת בגשמיות ועד\"ז הוא בנוגע לא תשא,"
        },
        {
          "s": 9,
          "text": "כיבוד אב ואם."
        },
        {
          "s": 10,
          "text": "יצה\"ר יש ביניכם11"
        },
        {
          "s": 11,
          "text": "ולכן אין שייך אצלם בירור נפש הבהמית."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "דבהשייכות דבירור נפש הבהמית"
        },
        {
          "s": 3,
          "text": "(יצה\"ר יש ביניכם)"
        },
        {
          "s": 4,
          "text": "למתן תורה,"
        },
        {
          "s": 5,
          "text": "שני ענינים."
        },
        {
          "s": 6,
          "text": "שע\"י קיום המצוות שניתנו במתן תורה נעשה בירור נפש הבהמית,"
        },
        {
          "s": 7,
          "text": "כנ\"ל."
        },
        {
          "s": 8,
          "text": "ושבירור נפש הבהמית הוא גם הכנה למתן תורה."
        },
        {
          "s": 9,
          "text": "שלכן סופרים ספירת העומר לפני חג השבועות,"
        },
        {
          "s": 10,
          "text": "כי ספירת העומר הוא בירור המדות דנפש הבהמית,"
        },
        {
          "s": 11,
          "text": "ועי\"ז זוכים בחגה\"ש למתן תורה12."
        },
        {
          "s": 12,
          "text": "ועפ\"ז,"
        },
        {
          "s": 13,
          "text": "הענין דיצה\"ר יש ביניכם"
        },
        {
          "s": 14,
          "text": "(ענין האחרון שבתשובת משה)"
        },
        {
          "s": 15,
          "text": "הוא ע\"ד הענין דלמצרים ירדתם"
        },
        {
          "s": 16,
          "text": "(ענין הראשון שבתשובת משה),"
        },
        {
          "s": 17,
          "text": "שבהשייכות דיצי\"מ למתן תורה,"
        },
        {
          "s": 18,
          "text": "שני ענינים."
        },
        {
          "s": 19,
          "text": "שע\"י מתן תורה,"
        },
        {
          "s": 20,
          "text": "המשכת וגילוי אנכי הוי' אלקיך,"
        },
        {
          "s": 21,
          "text": "נעשה אשר הוצאתיך מארץ מצרים13,"
        },
        {
          "s": 22,
          "text": "ושיציאת מצרים היא הקדמה והכנה למתן תורה,"
        },
        {
          "s": 23,
          "text": "כפירוש הפשוט באנכי הוי' אלקיך אשר הוצאתיך מארץ מצרים,"
        },
        {
          "s": 24,
          "text": "דאשר הוצאתיך מארץ מצרים הוא טעם על אנכי הוי' אלקיך14."
        },
        {
          "s": 25,
          "text": "וצריך להבין,"
        },
        {
          "s": 26,
          "text": "דענין מתן תורה הוא"
        },
        {
          "s": 27,
          "text": "(כמ\"ש בהפתיחה דמתן תורה)"
        },
        {
          "s": 28,
          "text": "אנכי הוי' אלקיך,"
        },
        {
          "s": 29,
          "text": "שאנכי הוא מהותו ועצמותו נעשה הוי' אלקיך15,"
        },
        {
          "s": 30,
          "text": "ואיך שייך שע\"י העבודה דבירור נפש הבהמית תהי' המשכת אנכי."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה איתא במדרש16"
        },
        {
          "s": 2,
          "text": "עה\"פ17"
        },
        {
          "s": 3,
          "text": "וספרתם לכם ממחרת השבת גו' שבע שבתות תמימות תהיינה אימתי הן תמימות בזמן שישראל עושין רצונו של מקום."
        },
        {
          "s": 4,
          "text": "וע\"פ המבואר בכ\"מ18"
        },
        {
          "s": 5,
          "text": "דענין עושין רצונו של מקום הוא דוקא ע\"י האהבה דבכל מאדך,"
        },
        {
          "s": 6,
          "text": "למעלה ממדידה והגבלה,"
        },
        {
          "s": 7,
          "text": "מובן,"
        },
        {
          "s": 8,
          "text": "דמ\"ש במדרש אימתי הן תמימות בזמן שישראל עושין רצונו של מקום,"
        },
        {
          "s": 9,
          "text": "הוא,"
        },
        {
          "s": 10,
          "text": "כשהעבודה דספה\"ע קשורה עם האהבה דבכל מאדך."
        },
        {
          "s": 11,
          "text": "[ולהעיר,"
        },
        {
          "s": 12,
          "text": "דבמק\"א ארז\"ל19"
        },
        {
          "s": 13,
          "text": "דשבע שבתות תמימות הוא דשבע השבתות דספה\"ע מתחילות באחד בשבת ומסיימות בשבת שבשבת,"
        },
        {
          "s": 14,
          "text": "שאז הם שבע שבתות תמימות."
        },
        {
          "s": 15,
          "text": "ויש לומר הקשר דשני הפירושים,"
        },
        {
          "s": 16,
          "text": "דבאותם השנים ששבע שבתות דספה\"ע מתחילות באחד בשבת ומסיימות בשבת20,"
        },
        {
          "s": 17,
          "text": "בנקל יותר,"
        },
        {
          "s": 18,
          "text": "שהעבודה דספה\"ע תהי' באופן דבכל מאדך]."
        },
        {
          "s": 19,
          "text": "ולכאורה יש לומר,"
        },
        {
          "s": 20,
          "text": "שהשייכות דעושין רצונו של מקום"
        },
        {
          "s": 21,
          "text": "(בכל מאדך)"
        },
        {
          "s": 22,
          "text": "לספירת העומר,"
        },
        {
          "s": 23,
          "text": "היא,"
        },
        {
          "s": 24,
          "text": "כי ספירת העומר היא הכנה למתן תורה,"
        },
        {
          "s": 25,
          "text": "וכיון שההכנה למתן תורה צריכה להיות בשני ענינים,"
        },
        {
          "s": 26,
          "text": "יציאת מצרים ובירור נפש הבהמית,"
        },
        {
          "s": 27,
          "text": "לכן,"
        },
        {
          "s": 28,
          "text": "צריך להיות בספירת העומר"
        },
        {
          "s": 29,
          "text": "(נוסף להענין דבירור המדות דנה\"ב,"
        },
        {
          "s": 30,
          "text": "גם)"
        },
        {
          "s": 31,
          "text": "העבודה דבכל מאדך,"
        },
        {
          "s": 32,
          "text": "למעלה ממדידה והגבלה,"
        },
        {
          "s": 33,
          "text": "היציאה ממצרים מלשון מיצר והגבלה."
        },
        {
          "s": 34,
          "text": "וצריך להבין דלפ\"ז,"
        },
        {
          "s": 35,
          "text": "העבודה דבכל מאדך היא הכנה מוכרחת למתן תורה,"
        },
        {
          "s": 36,
          "text": "ומזה שאמרו אימתי הן תמימות כו' משמע שעיקר הענין דספה\"ע,"
        },
        {
          "s": 37,
          "text": "הכנה למתן תורה,"
        },
        {
          "s": 38,
          "text": "הוא בירור המדות דנה\"ב,"
        },
        {
          "s": 39,
          "text": "והעבודה דבכל מאדך שייכת רק לשלימות ההכנה למ\"ת."
        },
        {
          "s": 40,
          "text": "וביותר אינו מובן,"
        },
        {
          "s": 41,
          "text": "דכיון שענין מתן תורה הוא הגילוי דאנכי,"
        },
        {
          "s": 42,
          "text": "מהותו ועצמותו שלמעלה מעלה מגדר השתלשלות21,"
        },
        {
          "s": 43,
          "text": "הרי העבודה המתאימה להמשכת גילוי זה הוא לכאורה העבודה דבכל מאדך"
        },
        {
          "s": 44,
          "text": "(למעלה מהשתלשלות שבאדם),"
        },
        {
          "s": 45,
          "text": "ואעפ\"כ,"
        },
        {
          "s": 46,
          "text": "עיקר העבודה דספה\"ע הוא בירור המדות דנפש הבהמית"
        },
        {
          "s": 47,
          "text": "[שבכדי לברר המדות דנה\"ב הוא דוקא ע\"י שנפש האלקית מתלבשת בנפש הבהמית22],"
        },
        {
          "s": 48,
          "text": "ועי\"ז נמשך הגילוי דאנכי."
        }
      ]
    }
  ]
}