  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915410_theRebbe_669__p008",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915410_theRebbe_669",
  "title": "מאמר פדה בשלום תשמ\"ו",
  "part": 8,
  "sections": [
    {
      "v": 21,
      "items": [
        {
          "s": 0,
          "text": "וזהו שיום התשיעי בכסלו,"
        },
        {
          "s": 1,
          "text": "יום ההילולא,"
        },
        {
          "s": 2,
          "text": "הוא הערב דיום הגאולה61,"
        },
        {
          "s": 3,
          "text": "כי ע\"י שהגילוי דפדה בשלום נפשי הי' לאחרי קדימת העבודה דהילולא של בעל הגאולה,"
        },
        {
          "s": 4,
          "text": "ענין הביטול"
        },
        {
          "s": 5,
          "text": "(שבדומה להסתלקות),"
        },
        {
          "s": 6,
          "text": "המשיך גילוי זה"
        },
        {
          "s": 7,
          "text": "(הגילוי דפדה בשלום נפשי שלמעלה ממדידה והגבלה)"
        },
        {
          "s": 8,
          "text": "גם בהמציאות דכל השייכים אליו."
        },
        {
          "s": 9,
          "text": "שלכן,"
        },
        {
          "s": 10,
          "text": "כדי לקבל גילוי זה,"
        },
        {
          "s": 11,
          "text": "אין צריכה להיות הכנה דביטול ויציאה מהמציאות,"
        },
        {
          "s": 12,
          "text": "ואין הדבר תלוי אלא ברצון,"
        },
        {
          "s": 13,
          "text": "וביכלתו של כל אחד"
        },
        {
          "s": 14,
          "text": "(גם לפני שיצא ממצבו)"
        },
        {
          "s": 15,
          "text": "לפדות את עצמו באופן דפדה בשלום נפשי,"
        },
        {
          "s": 16,
          "text": "שלום בתכלית השלימות,"
        },
        {
          "s": 17,
          "text": "ועי\"ז לפדות גם את כל העולם,"
        },
        {
          "s": 18,
          "text": "בגאולה האמיתית והשלימה ע\"י משיח צדקנו,"
        },
        {
          "s": 19,
          "text": "במהרה בימינו ממש ובעגלא דידן ממש."
        }
      ]
    }
  ]
}