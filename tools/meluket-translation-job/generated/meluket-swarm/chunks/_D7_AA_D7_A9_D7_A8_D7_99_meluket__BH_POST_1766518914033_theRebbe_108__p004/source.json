{
  "globalIndex": 61,
  "owner": 11,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914033_theRebbe_108__p004",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914033_theRebbe_108__p004",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914033_theRebbe_108",
  "title": "מאמר שובה ישראל תשל\"ז",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ועוד פירוש בשובה ישראל עד הוי' אלקיך,"
        },
        {
          "s": 2,
          "text": "שהתשובה צריכה להיות עד שהוי' יהי' רק בחי' אלקים וצמצום לגבי אוא\"ס שלמעלה מהוי'51."
        },
        {
          "s": 3,
          "text": "והחילוק בין שני הפירושים הוא,"
        },
        {
          "s": 4,
          "text": "דלהפירוש בעד הוי' אלקיך שהוי' יהי' אלקיך כחך וחיותך,"
        },
        {
          "s": 5,
          "text": "מה שנמשך בגילוי הוא השמות הוי' ואלקים אלא שהחיבור דב' השמות הוא ע\"י המשכה מאוא\"ס שלמעלה מהוי' ואלקים."
        },
        {
          "s": 6,
          "text": "ולהפירוש בעד הוי' אלקיך שהוי' יהי' רק בחי' אלקים וצמצום לגבי אוא\"ס שלמעלה מהוי',"
        },
        {
          "s": 7,
          "text": "האור עצמו"
        },
        {
          "s": 8,
          "text": "(שלמעלה מהוי')"
        },
        {
          "s": 9,
          "text": "נמשך בגילוי."
        },
        {
          "s": 10,
          "text": "דזה שהוי' נעשה בחי' אלקים וצמצום לגבי אוא\"ס שלמעלה מהוי' הוא דוקא כשאור זה מאיר בגילוי."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דהחילוק בין שני הפירושים הוא ע\"ד החילוק שבין תקיעת שופר לאמירת פסוקי שופרות."
        },
        {
          "s": 2,
          "text": "דהנה מבואר בהמשך תרס\"ו54,"
        },
        {
          "s": 3,
          "text": "שמלכיות וזכרונות הם באור הממלא ואור הסובב,"
        },
        {
          "s": 4,
          "text": "וההמשכה שע\"י שופר היא מאוא\"ס שלמעלה מממלא וסובב,"
        },
        {
          "s": 5,
          "text": "ועד לההמשכה מהעלם העצמי,"
        },
        {
          "s": 6,
          "text": "שע\"י המשכה זו נעשה היחוד דסובב וממלא."
        },
        {
          "s": 7,
          "text": "וההמשכה55"
        },
        {
          "s": 8,
          "text": "שע\"י אמירת פסוקי שופרות היא למעלה יותר גם מההמשכה שע\"י תקיעת שופר."
        },
        {
          "s": 9,
          "text": "דההמשכה שע\"י תקיעת שופר היא רק אור הסובב ואור הממלא,"
        },
        {
          "s": 10,
          "text": "אלא שע\"י שההמשכה היא מאוא\"ס"
        },
        {
          "s": 11,
          "text": "[ולמעלה יותר מהעלם העצמי],"
        },
        {
          "s": 12,
          "text": "הם מתחברים ומתאחדים."
        },
        {
          "s": 13,
          "text": "וע\"י אמירת פסוקי שופרות נמשך העלם העצמי עצמו,"
        },
        {
          "s": 14,
          "text": "בדוגמת הגילוי שיהי' לעתיד."
        },
        {
          "s": 15,
          "text": "וזהו56"
        },
        {
          "s": 16,
          "text": "מה שבפסוקי שופרות אומרים פסוקי שופרות דמ\"ת ומסיימים בענין השופר דלעתיד,"
        },
        {
          "s": 17,
          "text": "כי לע\"ל יהי' הגילוי דהעלם העצמי."
        },
        {
          "s": 18,
          "text": "ועד\"ז הי' הגילוי דמ\"ת."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "והנה השופר דלעתיד הוא נעלה יותר מהשופר דמ\"ת,"
        },
        {
          "s": 2,
          "text": "כדאיתא בפרקי דר\"א57"
        },
        {
          "s": 3,
          "text": "בענין ב' קרניו של אילו של יצחק,"
        },
        {
          "s": 4,
          "text": "דקרן הימין גדול מהשמאל,"
        },
        {
          "s": 5,
          "text": "בשל שמאל תקע בו הקב\"ה על הר סיני ובשל ימין עתיד לתקוע בו לעתיד לבוא."
        },
        {
          "s": 6,
          "text": "וגם בשופר דלעתיד עצמו ישנם כמה דרגות,"
        },
        {
          "s": 7,
          "text": "ואד' הוי' בשופר יתקע,"
        },
        {
          "s": 8,
          "text": "ויתקע בשופר גדול58."
        },
        {
          "s": 9,
          "text": "דאד' הוי' הם שמות,"
        },
        {
          "s": 10,
          "text": "אלא ששמות אלה"
        },
        {
          "s": 11,
          "text": "(אד' הוי' בניקוד אלקים)"
        },
        {
          "s": 12,
          "text": "הם נעלים ביותר,"
        },
        {
          "s": 13,
          "text": "כמבואר בארוכה בלקו\"ת59."
        },
        {
          "s": 14,
          "text": "דגילוי זה יהי' בהתחלת הגאולה."
        },
        {
          "s": 15,
          "text": "ולאח\"ז יתקע בשופר גדול,"
        },
        {
          "s": 16,
          "text": "יתקע סתם ולא נאמר מי הוא התוקע,"
        },
        {
          "s": 17,
          "text": "כי תקיעה זו היא המשכה וגילוי מבחינת סתימא דכל סתימין60."
        },
        {
          "s": 18,
          "text": "ויש לומר,"
        },
        {
          "s": 19,
          "text": "דזה שבפסוקי שופרות דראש השנה אומרים גם הפסוק יתקע בשופר גדול,"
        },
        {
          "s": 20,
          "text": "הוא,"
        },
        {
          "s": 21,
          "text": "כי ע\"י העבודה דר\"ה ממשיכים גם ענין זה."
        },
        {
          "s": 22,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 23,
          "text": "דזה שאומרים בההפטורה דשבת תשובה שובה ישראל עד הוי' אלקיך,"
        },
        {
          "s": 24,
          "text": "שבהוי' זה נכלל גם הענין דהוי' אד' בניקוד אלקים שהוא דרגא נעלית ביותר,"
        },
        {
          "s": 25,
          "text": "ואעפ\"כ אומרים שהתשובה צריכה להיות עד שהוי' יהי' רק בחינת אלקים וצמצום לגבי אוא\"ס שלמעלה מהוי',"
        },
        {
          "s": 26,
          "text": "כי ע\"י העבודה דר\"ה ממשיכים גם ענין יתקע בשופר גדול,"
        },
        {
          "s": 27,
          "text": "ולגבי דרגא זו,"
        },
        {
          "s": 28,
          "text": "גם השם הוי' אד' כאלקים יחשב."
        }
      ]
    }
  ]
}