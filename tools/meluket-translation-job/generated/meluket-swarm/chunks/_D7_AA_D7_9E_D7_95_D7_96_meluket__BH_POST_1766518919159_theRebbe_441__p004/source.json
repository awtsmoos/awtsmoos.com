{
  "globalIndex": 904,
  "owner": 4,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919159_theRebbe_441__p004",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919159_theRebbe_441__p004",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919159_theRebbe_441",
  "title": "מאמר ה' לי בעוזרי תשי\"ז",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "והנה החילוק שבין העבודה דעדות להעבודה דחוקים הוא דוגמת החילוק שביניהם בענין המצוות עצמם."
        },
        {
          "s": 2,
          "text": "ויובן זה ע\"פ הידוע44"
        },
        {
          "s": 3,
          "text": "שהרצון דמצוות כמו שהוא מצד העצמות הוא רצון עצמי שאינו בשביל איזה כוונה שתושלם ע\"י המצוות,"
        },
        {
          "s": 4,
          "text": "והתכלית דמצוות"
        },
        {
          "s": 5,
          "text": "(מצד רצון זה)"
        },
        {
          "s": 6,
          "text": "הוא המצוות עצמם."
        },
        {
          "s": 7,
          "text": "ומזה מובן,"
        },
        {
          "s": 8,
          "text": "דזה שהמצוות ממשיכים ומגלים עצמות אוא\"ס בעולם,"
        },
        {
          "s": 9,
          "text": "עם היות שההמשכה היא מצד זה שהמצוות הם רצונו ית' שלמעלה מטעם,"
        },
        {
          "s": 10,
          "text": "מ\"מ,"
        },
        {
          "s": 11,
          "text": "מכיון שזהו ענין שנעשה ע\"י המצוות,"
        },
        {
          "s": 12,
          "text": "הרי זה בדוגמת טעם."
        },
        {
          "s": 13,
          "text": "ואמיתית הענין דרצון העצמי של עצמותו ית' הוא בהמצוות גופא."
        },
        {
          "s": 14,
          "text": "וזהו מה שהעבודה דעדות היא העבודה דרעותא דלבא והעבודה דחוקים היא העבודה דקבלת עול,"
        },
        {
          "s": 15,
          "text": "כי ענין העדות שבמצוות,"
        },
        {
          "s": 16,
          "text": "מכיון שהוא המשכה וגילוי,"
        },
        {
          "s": 17,
          "text": "הכלי לזה הוא הרצון,"
        },
        {
          "s": 18,
          "text": "שגם הרצון שמצד עצם הנשמה היא תנועה דהמשכה והתפשטות"
        },
        {
          "s": 19,
          "text": "(מציאות),"
        },
        {
          "s": 20,
          "text": "והכלי לענין החוקים דמצוות שהוא רצון עצמי ממש שלמעלה מגילוי הוא הביטול דקבלת עול,"
        },
        {
          "s": 21,
          "text": "ביטול שמצד העצם שלמעלה מכל ענין דהתפשטות."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "וזהו זמירות היו לי חוקיך"
        },
        {
          "s": 3,
          "text": "(דוקא),"
        },
        {
          "s": 4,
          "text": "שכוונתו בזה היא לשלול לא רק הענין דמשפטים אלא גם הענין דעדות."
        },
        {
          "s": 5,
          "text": "כי בדרגת העדות נשארה עדיין איזו מציאות."
        },
        {
          "s": 6,
          "text": "ולא רק מצד האדם,"
        },
        {
          "s": 7,
          "text": "שגם הרצון שלו שלמעלה מטו\"ד"
        },
        {
          "s": 8,
          "text": "(רעו\"ד)"
        },
        {
          "s": 9,
          "text": "הוא מציאות"
        },
        {
          "s": 10,
          "text": "(כנ\"ל),"
        },
        {
          "s": 11,
          "text": "אלא גם מצד המצוות שבדרגת עדות,"
        },
        {
          "s": 12,
          "text": "מכיון שענינם הוא המשכת וגילוי אוא\"ס בעולם."
        },
        {
          "s": 13,
          "text": "ואמיתית ושלימות ההכרה שכל העולמות בטלים במציאות לגבי דקדוק אחד דתורה הוא דוקא בהדרגא דחוקים,"
        },
        {
          "s": 14,
          "text": "שהדקדוקים דתורה"
        },
        {
          "s": 15,
          "text": "(שמצד בחינה זו)"
        },
        {
          "s": 16,
          "text": "הם ענין עצמי מצד שרשם העצמי שבתורה,"
        },
        {
          "s": 17,
          "text": "שלמעלה משייכות לעולם."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "וממשיך בהמאמר45,"
        },
        {
          "s": 3,
          "text": "דמה שדוד נענש על זה46"
        },
        {
          "s": 4,
          "text": "הוא כי עסק התורה דדוד הי' באופן דלזמר עריצים"
        },
        {
          "s": 5,
          "text": "(כנ\"ל),"
        },
        {
          "s": 6,
          "text": "ותכלית הכוונה היא כמ\"ש47"
        },
        {
          "s": 7,
          "text": "לא תהו בראה לשבת יצרה,"
        },
        {
          "s": 8,
          "text": "להתעסק בעבודת הבירורים ולהמשיך גילוי אור בעולם."
        },
        {
          "s": 9,
          "text": "דזהו המעלה שבתפלה לגבי תורה,"
        },
        {
          "s": 10,
          "text": "דתפלה הוא בירור והעלאה,"
        },
        {
          "s": 11,
          "text": "היינו שע\"י התפלה מתבררים הניצוצות ומזדככים ועולים למעלה,"
        },
        {
          "s": 12,
          "text": "משא\"כ תורה היא המשכה מלמעלה,"
        },
        {
          "s": 13,
          "text": "והבירור ע\"י התורה הוא בדרך דחי'."
        },
        {
          "s": 14,
          "text": "וכשרצה דוד לברר בירורים ע\"י התורה,"
        },
        {
          "s": 15,
          "text": "שהוא בדרך דחי',"
        },
        {
          "s": 16,
          "text": "לזמר עריצים,"
        },
        {
          "s": 17,
          "text": "נענש על זה,"
        },
        {
          "s": 18,
          "text": "כי תכלית הכוונה הוא לשבת יצרה."
        }
      ]
    }
  ]
}