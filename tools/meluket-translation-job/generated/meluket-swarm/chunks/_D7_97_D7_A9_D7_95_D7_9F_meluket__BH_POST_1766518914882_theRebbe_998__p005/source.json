{
  "globalIndex": 191,
  "owner": 41,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914882_theRebbe_998__p005",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914882_theRebbe_998__p005",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518914882_theRebbe_998",
  "title": "מאמר ויהיו חיי שרה תש\"ל",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ויש להוסיף בביאור לשון הכתוב לשדה נעבד,"
        },
        {
          "s": 1,
          "text": "כי הכוונה דדירה בתחתונים היא שהגילוי אלקות שנמשך בהתחתונים יהי' מצד ענין התחתונים עצמם."
        },
        {
          "s": 2,
          "text": "ויש לומר,"
        },
        {
          "s": 3,
          "text": "דזהו הטעם על זה שהגילוי שע\"י המצוות הוא ע\"י שהמקום שבו נעשית המצוה הוא מוכשר להגילוי"
        },
        {
          "s": 4,
          "text": "[וכנ\"ל"
        },
        {
          "s": 5,
          "text": "(סעיף ב)"
        },
        {
          "s": 6,
          "text": "דזה שגן עדן נק' בשם שדה הוא לפי שהגן עדן הוא מקום מוכשר להגילוי שעל ידי זריעת המצוות."
        },
        {
          "s": 7,
          "text": "ועד\"ז הוא בנוגע להמקום דכללות העולם,"
        },
        {
          "s": 8,
          "text": "דזה שוישלחהו גו' לעבוד את האדמה הוא לעשות המקום דעולם להיות מוכשר להגילוי שע\"י המצוות],"
        },
        {
          "s": 9,
          "text": "כי ע\"י שהמשכת הגילוי בעולם שע\"י המצוה היא גם לפי שה"
        },
        {
          "s": 10,
          "text": "(מקום ד)"
        },
        {
          "s": 11,
          "text": "עולם מוכשר לזה,"
        },
        {
          "s": 12,
          "text": "הגילוי בעולם הוא מצד ענינו דהעולם עצמו."
        },
        {
          "s": 13,
          "text": "וזהו מלך לשדה נעבד,"
        },
        {
          "s": 14,
          "text": "כי שלימות הכוונה דדירה בתחתונים היא שהגילוי בעולם יהי'"
        },
        {
          "s": 15,
          "text": "(לא רק מצד קיום המצוה,"
        },
        {
          "s": 16,
          "text": "אלא גם)"
        },
        {
          "s": 17,
          "text": "מצד העולם,"
        },
        {
          "s": 18,
          "text": "שדה,"
        },
        {
          "s": 19,
          "text": "וכיון דזה שנעשה כביכול בחינת עצם האור,"
        },
        {
          "s": 20,
          "text": "מלך עילאה,"
        },
        {
          "s": 21,
          "text": "הוא בשביל כוונה זו,"
        },
        {
          "s": 22,
          "text": "לכן מלך לשדה נעבד."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ולהוסיף,"
        },
        {
          "s": 1,
          "text": "דהטעם"
        },
        {
          "s": 2,
          "text": "(בפנימיות הענינים)"
        },
        {
          "s": 3,
          "text": "על זה שהאדם גורש מגן עדן הוא,"
        },
        {
          "s": 4,
          "text": "כי הכוונה דדירה בתחתונים היא שהדירה תהי' בהתחתון שאין תחתון למטה ממנו35,"
        },
        {
          "s": 5,
          "text": "ושהדירה בו תהי' מצד ענינו"
        },
        {
          "s": 6,
          "text": "(דתחתון זה),"
        },
        {
          "s": 7,
          "text": "ולכן וישלחהו ה' אלקים מגן עדן לעבוד את האדמה גו',"
        },
        {
          "s": 8,
          "text": "לעשות המקום דעולם"
        },
        {
          "s": 9,
          "text": "(תחתון ביותר36)"
        },
        {
          "s": 10,
          "text": "מוכשר להגילוי,"
        },
        {
          "s": 11,
          "text": "בכדי שגם התחתון שאין תחתון למטה ממנו יהי' דירה לו ית',"
        },
        {
          "s": 12,
          "text": "ושהדירה בו תהי' מצד ענינו."
        },
        {
          "s": 13,
          "text": "ועד\"ז הוא בענין שדה וארץ דלמעלה,"
        },
        {
          "s": 14,
          "text": "דתכלית הכוונה בהמשכת הגילוי דבחינת מלך עילאה בשדה,"
        },
        {
          "s": 15,
          "text": "פנימיות המלכות,"
        },
        {
          "s": 16,
          "text": "הוא,"
        },
        {
          "s": 17,
          "text": "שעי\"ז יומשך הגילוי בארץ37,"
        },
        {
          "s": 18,
          "text": "חיצוניות המלכות"
        },
        {
          "s": 19,
          "text": "(ועי\"ז בבי\"ע,"
        },
        {
          "s": 20,
          "text": "עד בעוה\"ז התחתון),"
        },
        {
          "s": 21,
          "text": "ובאופן שהגילוי בארץ יהי'"
        },
        {
          "s": 22,
          "text": "(לא כמו דבר נוסף עליו,"
        },
        {
          "s": 23,
          "text": "אלא שזה)"
        },
        {
          "s": 24,
          "text": "יהי' ענינה של הארץ,"
        },
        {
          "s": 25,
          "text": "בדוגמת פנימיות המלכות"
        },
        {
          "s": 26,
          "text": "(שדה38)"
        },
        {
          "s": 27,
          "text": "שענינה הוא זה שמקבלת את הגילויים שלמעלה ממנה."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "וזהו ויהיו חיי שרה מאה שנה ועשרים שנה ושבע שנים,"
        },
        {
          "s": 2,
          "text": "ומבאר בהמאמר,"
        },
        {
          "s": 3,
          "text": "דמאה שנה הוא פנימיות הכתר,"
        },
        {
          "s": 4,
          "text": "בחינת מלך עילאה."
        },
        {
          "s": 5,
          "text": "עשרים שנה ושבע שנים הם מוחין ומדות"
        },
        {
          "s": 6,
          "text": "(שנמשכים ע\"י היסוד),"
        },
        {
          "s": 7,
          "text": "בחינת כל."
        },
        {
          "s": 8,
          "text": "וצריך ביאור,"
        },
        {
          "s": 9,
          "text": "הרי זה שזכתה שרה לחיין עילאין הי' באופן דמלמטה למעלה,"
        },
        {
          "s": 10,
          "text": "בתחילה בחינת כל ואח\"כ בחינת מלך עילאה,"
        },
        {
          "s": 11,
          "text": "והסדר בכתוב הוא מאה שנה ואח\"כ עשרים שנה ושבע שנים."
        },
        {
          "s": 12,
          "text": "ויש לומר הביאור,"
        },
        {
          "s": 13,
          "text": "שהוא בכדי לרמז שההמשכה דבחינת מאה שנה,"
        },
        {
          "s": 14,
          "text": "מלך עילאה,"
        },
        {
          "s": 15,
          "text": "המשיכה אח\"כ גם בבחינת עשרים שנה ושבע שנים,"
        },
        {
          "s": 16,
          "text": "בחינת כל."
        },
        {
          "s": 17,
          "text": "ועי\"ז,"
        },
        {
          "s": 18,
          "text": "הגילוי דבחינת מאה שנה שנמשך תחלה בבחינת שדה"
        },
        {
          "s": 19,
          "text": "(פנימיות המלכות)"
        },
        {
          "s": 20,
          "text": "נמשך אח\"כ גם בבחינת ארץ"
        },
        {
          "s": 21,
          "text": "(חיצוניות המלכות)39."
        },
        {
          "s": 22,
          "text": "ולאח\"ז נאמר שני חיי שרה,"
        },
        {
          "s": 23,
          "text": "שהמשיכה גילוי זה גם בבי\"ע."
        }
      ]
    }
  ]
}