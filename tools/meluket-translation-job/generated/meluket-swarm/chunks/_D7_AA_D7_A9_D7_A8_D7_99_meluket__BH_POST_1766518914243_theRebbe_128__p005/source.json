{
  "globalIndex": 99,
  "owner": 49,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914243_theRebbe_128__p005",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914243_theRebbe_128__p005",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914243_theRebbe_128",
  "title": "מאמר ולקחתם לכם תשל\"ט",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "וע\"פ כל הנ\"ל מובן,"
        },
        {
          "s": 2,
          "text": "דזה שע\"י נטילת ד' מינים פועלים שגם הגוים כו' יסכימו לנצחונם של ישראל ועד שיהללו וישבחו את ה' על זה,"
        },
        {
          "s": 3,
          "text": "הוא נעלה יותר"
        },
        {
          "s": 4,
          "text": "(בפרט אחד)"
        },
        {
          "s": 5,
          "text": "מהנצחון עצמו."
        },
        {
          "s": 6,
          "text": "כי זה שגם הגוים,"
        },
        {
          "s": 7,
          "text": "ובפרט אלה שהיו תחלה מנגדים"
        },
        {
          "s": 8,
          "text": "(והי' צריך לנצחם),"
        },
        {
          "s": 9,
          "text": "מהללים ומשבחים את ה' על זה שגבר עלינו חסדו,"
        },
        {
          "s": 10,
          "text": "הו\"ע של התחדשות"
        },
        {
          "s": 11,
          "text": "(ע\"ד שנת\"ל סעיף ז),"
        },
        {
          "s": 12,
          "text": "נוסף לזה שעי\"ז נשלמת הכוונה דדירה בתחתונים,"
        },
        {
          "s": 13,
          "text": "בתחתון שאין תחתון למטה ממנו."
        },
        {
          "s": 14,
          "text": "והגם שענין זה"
        },
        {
          "s": 15,
          "text": "(ביטול העמים לישראל)"
        },
        {
          "s": 16,
          "text": "יהי' בעיקר לע\"ל,"
        },
        {
          "s": 17,
          "text": "כדאיתא בנבואת זכרי'73"
        },
        {
          "s": 18,
          "text": "דלכל אחד מישראל יהיו ב' אלפים וח' מאות עבדים"
        },
        {
          "s": 19,
          "text": "(מאוה\"ע)"
        },
        {
          "s": 20,
          "text": "שיחזיקו בד' כנפות הטלית שלו,"
        },
        {
          "s": 21,
          "text": "הנה מעין זה הוא גם בזמן הגלות,"
        },
        {
          "s": 22,
          "text": "ובפרט בהזמן שבסמיכות לביאת המשיח"
        },
        {
          "s": 23,
          "text": "(כנ\"ל סעיף ה)."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "וזהו ולקחתם לכם ביום הראשון ראשון לחשבון,"
        },
        {
          "s": 1,
          "text": "דהגם שגילוי הנצחון דישראל שע\"י נטילת הד' מינים הוא גילוי הנצחון שהי' בר\"ה וענין זה שבנטילת ד' מינים בחג הסוכות שייך לזה שהוא יום הט\"ו לר\"ה,"
        },
        {
          "s": 2,
          "text": "מ\"מ,"
        },
        {
          "s": 3,
          "text": "זה שע\"י נטילת ד' מינים פועלים שהגוים יסכימו לנצחונם של ישראל ועד שיהללו וישבחו על זה הו\"ע חדש,"
        },
        {
          "s": 4,
          "text": "ולכן אומר ולקחתם לכם ביום הראשון,"
        },
        {
          "s": 5,
          "text": "ראשון לחשבון."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז י\"ל מה שארז\"ל74"
        },
        {
          "s": 1,
          "text": "בשכר שלשה ראשון"
        },
        {
          "s": 2,
          "text": "[שביתת הרגל דפסח ושביתת הרגל דחג ונטילת לולב75]"
        },
        {
          "s": 3,
          "text": "זכו לשלשה ראשון,"
        },
        {
          "s": 4,
          "text": "להכרית זרעו של עשו לבנין ביהמ\"ק ולשמו של משיח,"
        },
        {
          "s": 5,
          "text": "וידוע76"
        },
        {
          "s": 6,
          "text": "דבחי' ראשון דד' מינים הוא נעלה יותר מבחי' ראשון דסוכה77,"
        },
        {
          "s": 7,
          "text": "דלכאורה,"
        },
        {
          "s": 8,
          "text": "כיון שענין ד' מינים הוא המשכת המקיף דסוכה"
        },
        {
          "s": 9,
          "text": "(בפנימיות)"
        },
        {
          "s": 10,
          "text": "איך שייך שיהיו נעלים יותר מסוכה,"
        },
        {
          "s": 11,
          "text": "די\"ל הביאור בזה,"
        },
        {
          "s": 12,
          "text": "כי ע\"י העבודה דד' מינים משלימים ישראל הכוונה דנתאוה הקב\"ה להיות לו ית' דירה בתחתונים,"
        },
        {
          "s": 13,
          "text": "ולכן,"
        },
        {
          "s": 14,
          "text": "גם השכר שמגיע להם עי\"ז הוא גילוי העצמות."
        }
      ]
    }
  ]
}