{
  "globalIndex": 377,
  "owner": 27,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915911_theRebbe_364__p003",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915911_theRebbe_364__p003",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915911_theRebbe_364",
  "title": "מאמר ברוך שעשה נסים תשמ\"ג",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה מבואר בכמה דרושים32,"
        },
        {
          "s": 2,
          "text": "דזה שתורה נמשלה ליין ושמן33"
        },
        {
          "s": 3,
          "text": "קאי על רזי תורה,"
        },
        {
          "s": 4,
          "text": "שהם דוגמת היין והשמן שהם מכוסים ונעלמים בענבים וזיתים"
        },
        {
          "s": 5,
          "text": "[והחילוק בין יין לשמן הוא,"
        },
        {
          "s": 6,
          "text": "דיין הוא רזי תורה,"
        },
        {
          "s": 7,
          "text": "ושמן הוא רזין דרזין34]."
        },
        {
          "s": 8,
          "text": "ומזה מובן,"
        },
        {
          "s": 9,
          "text": "דזה שתורה נמשלה למים35"
        },
        {
          "s": 10,
          "text": "קאי על גליא דתורה36."
        },
        {
          "s": 11,
          "text": "וכמבואר בתניא37,"
        },
        {
          "s": 12,
          "text": "דהטעם על זה שתורה נמשלה למים הוא כי כמו שמים יורדים ממקום גבוה למקום נמוך38"
        },
        {
          "s": 13,
          "text": "כך התורה ירדה ממקומה שהיא רצונו וחכמתו ית' ומשם נסעה וירדה עד שנתלבשה בדברים גשמיים ועניני עוה\"ז,"
        },
        {
          "s": 14,
          "text": "דרוב הלכות התורה הם בדברים גשמיים."
        },
        {
          "s": 15,
          "text": "וצריך להבין,"
        },
        {
          "s": 16,
          "text": "דביאור זה הוא לכאורה להיפך מהמבואר במאמר זה"
        },
        {
          "s": 17,
          "text": "(ד\"ה ברוך שעשה ניסים)"
        },
        {
          "s": 18,
          "text": "ובהדרושים דחג הסוכות"
        },
        {
          "s": 19,
          "text": "(בענין ניסוך היין והמים)"
        },
        {
          "s": 20,
          "text": "שמים הם למעלה מיין."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 1,
          "text": "ע\"פ הכלל הידוע39"
        },
        {
          "s": 2,
          "text": "דכל הגבוה ביותר יורד למטה יותר."
        },
        {
          "s": 3,
          "text": "דמזה מובן,"
        },
        {
          "s": 4,
          "text": "דזה שמים מצד עצמם הם בטבע ההמשכה והגילוי,"
        },
        {
          "s": 5,
          "text": "עד שיורדים"
        },
        {
          "s": 6,
          "text": "(דוקא)"
        },
        {
          "s": 7,
          "text": "למקום נמוך,"
        },
        {
          "s": 8,
          "text": "דגם לאחרי שנמשכו למטה הם נמשכים בטבעם למקום נמוך יותר,"
        },
        {
          "s": 9,
          "text": "הוא מפני ששרש המשכתם הוא ממקום גבוה ביותר."
        },
        {
          "s": 10,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 11,
          "text": "דזה שמשמע בכמה דרושים דמים הם למטה מיין הוא מצד הטבע שלהם שבפועל."
        },
        {
          "s": 12,
          "text": "דמים הם בטבע ההמשכה והגילוי כנ\"ל,"
        },
        {
          "s": 13,
          "text": "משא\"כ יין מצד עצמו,"
        },
        {
          "s": 14,
          "text": "הוא מכוסה וטמון בענביו,"
        },
        {
          "s": 15,
          "text": "ובכדי שיבוא מהעלם לגילוי הוא ע\"י פעולה והשתדלות."
        },
        {
          "s": 16,
          "text": "[דזהו גם הטעם על זה שנכנס יין יצא סוד40,"
        },
        {
          "s": 17,
          "text": "כי כמו שהיין עצמו הוא גילוי ההעלם"
        },
        {
          "s": 18,
          "text": "(דזה שהי' תחלה בהעלם"
        },
        {
          "s": 19,
          "text": "(טמון בענביו)"
        },
        {
          "s": 20,
          "text": "יצא לגילוי),"
        },
        {
          "s": 21,
          "text": "עד\"ז הוא פועל גם בהאדם,"
        },
        {
          "s": 22,
          "text": "שהוא \"מוציא\" את הסוד שבו,"
        },
        {
          "s": 23,
          "text": "שיבוא בגילוי41]."
        },
        {
          "s": 24,
          "text": "ומה שמבואר בדרושים אלו דמים הם למעלה מיין הוא מצד מעלת שרש המים,"
        },
        {
          "s": 25,
          "text": "שניכר גם בהטבע שלהם"
        },
        {
          "s": 26,
          "text": "(בפועל),"
        },
        {
          "s": 27,
          "text": "דזה שיורדים למקום נמוך הוא,"
        },
        {
          "s": 28,
          "text": "כנ\"ל,"
        },
        {
          "s": 29,
          "text": "מצד זה שבשרשם הם גבוהים יותר."
        },
        {
          "s": 30,
          "text": "וזהו גם מה שמים אין להם טעם,"
        },
        {
          "s": 31,
          "text": "כי מכיון שגם בירידתם למטה ניכר בהם שבשרשם הם גבוהים יותר,"
        },
        {
          "s": 32,
          "text": "לכן,"
        },
        {
          "s": 33,
          "text": "גם בירידתם למטה הם למעלה מהטעם"
        },
        {
          "s": 34,
          "text": "(כנ\"ל סעיף ג)."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה מבואר לעיל"
        },
        {
          "s": 2,
          "text": "(סעיף א',"
        },
        {
          "s": 3,
          "text": "מהמאמר ד\"ה ברוך שעשה נסים),"
        },
        {
          "s": 4,
          "text": "דזה ששמן צף על גבי כל המשקין הוא מפני ששמן הוא למעלה מהם."
        },
        {
          "s": 5,
          "text": "וע\"פ המבואר לעיל"
        },
        {
          "s": 6,
          "text": "(סעיף ד),"
        },
        {
          "s": 7,
          "text": "דמעלת היין על המים היא שהיין מצד עצמו הוא בהעלם"
        },
        {
          "s": 8,
          "text": "(טמון בענביו),"
        },
        {
          "s": 9,
          "text": "ומעלת המים על היין היא מצד שרשם שזה ניכר בהם גם בזה שהם למעלה מהטעם,"
        },
        {
          "s": 10,
          "text": "צריך לומר,"
        },
        {
          "s": 11,
          "text": "דזה ששמן הוא למעלה הן מיין והן ממים הוא בשני הענינים,"
        },
        {
          "s": 12,
          "text": "הן בענין ההעלם שבו,"
        },
        {
          "s": 13,
          "text": "דההעלם דשמן"
        },
        {
          "s": 14,
          "text": "(זה שהוא טמון בהזיתים)"
        },
        {
          "s": 15,
          "text": "הוא העלם גדול יותר מההעלם דיין"
        },
        {
          "s": 16,
          "text": "(שטמון בענביו),"
        },
        {
          "s": 17,
          "text": "והן בזה שהוא למעלה מהטעם"
        },
        {
          "s": 18,
          "text": "(הנאה)"
        },
        {
          "s": 19,
          "text": "דהאדם,"
        },
        {
          "s": 20,
          "text": "כדלקמן"
        },
        {
          "s": 21,
          "text": "(סעיף ז)."
        }
      ]
    }
  ]
}