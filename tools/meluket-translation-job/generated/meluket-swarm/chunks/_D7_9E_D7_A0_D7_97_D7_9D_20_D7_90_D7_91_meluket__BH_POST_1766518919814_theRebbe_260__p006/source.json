{
  "globalIndex": 1021,
  "owner": 21,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919814_theRebbe_260__p006",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919814_theRebbe_260__p006",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919814_theRebbe_260",
  "title": "מאמר לא היו ימים טובים לישראל תשל\"ה",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יש לבאר חילוקי הדרגות שבמילוי ושלימות הלבנה"
        },
        {
          "s": 2,
          "text": "(דלעיל סעיף א),"
        },
        {
          "s": 3,
          "text": "דמילוי ושלימות הלבנה שבט\"ו דכל חודש,"
        },
        {
          "s": 4,
          "text": "כיון שהיא מצד הטבע שהטביע הקב\"ה בהבריאה ואינה קשורה עם עבודתם של ישראל,"
        },
        {
          "s": 5,
          "text": "הוא"
        },
        {
          "s": 6,
          "text": "(בכללות)"
        },
        {
          "s": 7,
          "text": "המשכה שע\"פ סדר השתלשלות."
        },
        {
          "s": 8,
          "text": "וזה שבט\"ו לחודש מאיר האור גם בחצי חלק התחתון דהלבנה הוא מצד מעלת יום הט\"ו,"
        },
        {
          "s": 9,
          "text": "שבו,"
        },
        {
          "s": 10,
          "text": "גם חצי חלק התחתון הוא דוגמת חצי חלק העליון."
        },
        {
          "s": 11,
          "text": "ושלימות הלבנה שבט\"ו בניסן וט\"ו בתשרי,"
        },
        {
          "s": 12,
          "text": "כיון שזה קשור"
        },
        {
          "s": 13,
          "text": "(גם)"
        },
        {
          "s": 14,
          "text": "עם עבודת האדם,"
        },
        {
          "s": 15,
          "text": "היא"
        },
        {
          "s": 16,
          "text": "(בכללות)"
        },
        {
          "s": 17,
          "text": "המשכה שלמעלה מהשתלשלות."
        },
        {
          "s": 18,
          "text": "שלכן ט\"ו בניסן וט\"ו בתשרי הם ימים טובים,"
        },
        {
          "s": 19,
          "text": "דענין יו\"ט הוא המשכת אור שלמעלה מהשתלשלות."
        },
        {
          "s": 20,
          "text": "ושלימות הלבנה בט\"ו באב שקשורה עם עבודת התשובה"
        },
        {
          "s": 21,
          "text": "(העלי' שלאחרי הירידה דתשעה באב),"
        },
        {
          "s": 22,
          "text": "הוא,"
        },
        {
          "s": 23,
          "text": "דזה שמאיר גם חצי חלק התחתון דהלבנה הוא"
        },
        {
          "s": 24,
          "text": "(לא רק מצד זה שהאור הוא א\"ס ולכן מאיר גם למטה,"
        },
        {
          "s": 25,
          "text": "אלא גם)"
        },
        {
          "s": 26,
          "text": "מצד העלי' שבהמלכות עצמה."
        },
        {
          "s": 27,
          "text": "וכמבואר בהמאמר,"
        },
        {
          "s": 28,
          "text": "דבט\"ו באב מאיר במלכות בחינת עתיק,"
        },
        {
          "s": 29,
          "text": "די\"ל שהוא הגילוי דמעלת ושרש המלכות עצמה."
        },
        {
          "s": 30,
          "text": "וזוהי גם השייכות דחמשה עשר באב ליום הכפורים,"
        },
        {
          "s": 31,
          "text": "כי גם ביוהכ\"פ הוא עליית המלכות בפנימיות עתיק,"
        },
        {
          "s": 32,
          "text": "כמבואר בהמאמר."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "דזה שהיו\"ט דחמשה עשר באב הוא נעלה יותר גם מיוהכ\"פ,"
        },
        {
          "s": 3,
          "text": "אף שגם ביוהכ\"פ הוא עבודת התשובה,"
        },
        {
          "s": 4,
          "text": "הוא,"
        },
        {
          "s": 5,
          "text": "כי מזה גופא שהתורה קבעה יום סליחה וכפרה בכל שנה ושנה,"
        },
        {
          "s": 6,
          "text": "מובן,"
        },
        {
          "s": 7,
          "text": "שהירידה לדברים הבלתי רצויים שלאחרי' באה העלי' דיוהכ\"פ היא באופן שיש לה מקום מצד הבריאה,"
        },
        {
          "s": 8,
          "text": "דזה שנקבע בתורה"
        },
        {
          "s": 9,
          "text": "(אסתכל באורייתא וברא עלמא64)"
        },
        {
          "s": 10,
          "text": "יום סליחה וכפרה על ענינים בלתי רצויים הוא,"
        },
        {
          "s": 11,
          "text": "כי מצד גודל העילוי שבתשובה,"
        },
        {
          "s": 12,
          "text": "דבמקום שבעלי תשובה עומדין אין צדיקים גמורין יכולים לעמוד בו65,"
        },
        {
          "s": 13,
          "text": "יש מקום לזה"
        },
        {
          "s": 14,
          "text": "(גם)"
        },
        {
          "s": 15,
          "text": "מצד כוונת הבריאה כמו שנמשכה בגילוי,"
        },
        {
          "s": 16,
          "text": "בהדרגא דבמי נמלך,"
        },
        {
          "s": 17,
          "text": "אף שעיקר הכוונה בדרגא זו היא עבודת הצדיקים,"
        },
        {
          "s": 18,
          "text": "במי נמלך בנשמותיהן של צדיקים."
        },
        {
          "s": 19,
          "text": "משא\"כ הירידה דתשעה באב,"
        },
        {
          "s": 20,
          "text": "חורבן ביהמ\"ק והגלות,"
        },
        {
          "s": 21,
          "text": "היא ירידה כזו שאין לזה נתינת מקום"
        },
        {
          "s": 22,
          "text": "[כמובן גם ממגילת איכה,"
        },
        {
          "s": 23,
          "text": "דזה שאומר איכה בלשון תמי' הוא לפי שגם מצד העילוי שבתשובה,"
        },
        {
          "s": 24,
          "text": "אין מקום לירידה כזו]."
        },
        {
          "s": 25,
          "text": "וזה שבפועל היתה ירידה זו בכדי שתהי' עלי' נעלית יותר,"
        },
        {
          "s": 26,
          "text": "עלה ארי' כו' על מנת שיבוא ארי',"
        },
        {
          "s": 27,
          "text": "הוא רק מצד הכוונה האמיתית"
        },
        {
          "s": 28,
          "text": "(כמו שהיא בהעצמות),"
        },
        {
          "s": 29,
          "text": "שע\"י העבודה דישראל יהי' חידוש בהבריאה,"
        },
        {
          "s": 30,
          "text": "שמים חדשים וארץ חדשה."
        },
        {
          "s": 31,
          "text": "ולכן,"
        },
        {
          "s": 32,
          "text": "היו\"ט דחמשה עשר באב הוא נעלה יותר גם מיוהכ\"פ."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "וזהו גם מה שהסיום והחותם דמס' תענית הוא לא היו ימים טובים לישראל כחמשה עשר באב כו',"
        },
        {
          "s": 1,
          "text": "כי זהו הביאור דכל התעניות."
        },
        {
          "s": 2,
          "text": "דזה שישנם דברים בלתי רצויים שצריך להתענות עליהם,"
        },
        {
          "s": 3,
          "text": "ועד להדברים שאירעו בשבעה עשר בתמוז ובתשעה באב66,"
        },
        {
          "s": 4,
          "text": "הוא בשביל העלי' שלאחרי הירידה – היו\"ט דחמשה עשר באב,"
        },
        {
          "s": 5,
          "text": "שהוא יום שמחת לבו67"
        },
        {
          "s": 6,
          "text": "(דהקב\"ה)"
        },
        {
          "s": 7,
          "text": "זה בנין בית המקדש שיבנה במהרה בימינו68."
        }
      ]
    }
  ]
}