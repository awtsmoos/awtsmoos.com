{
  "globalIndex": 279,
  "owner": 29,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915384_theRebbe_69__p003",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915384_theRebbe_69__p003",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915384_theRebbe_69",
  "title": "מאמר אתה אחד תשמ\"ב",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "וזהו מאתך היא מנוחתם,"
        },
        {
          "s": 1,
          "text": "שהמנוחה דשבת היא מאתך ממש,"
        },
        {
          "s": 2,
          "text": "כי הגילוי דבחינת שלימותא דכולא שלמעלה מקוין בכל ד' מדריגות הנ\"ל"
        },
        {
          "s": 3,
          "text": "(גם מהקוין כמו שהם לפני הצמצום,"
        },
        {
          "s": 4,
          "text": "מאתך ממש),"
        },
        {
          "s": 5,
          "text": "היא בבחינת יחידה דוקא."
        },
        {
          "s": 6,
          "text": "דהנה ד' הבחינות נרנ\"ח הם בד' העולמות אבי\"ע,"
        },
        {
          "s": 7,
          "text": "ולמעלה יותר – בד' המדריגות דכללות ההשתלשלות"
        },
        {
          "s": 8,
          "text": "(מתחיל מלפני הצמצום)"
        },
        {
          "s": 9,
          "text": "– משא\"כ בחינת יחידה היא למעלה מהשתלשלות"
        },
        {
          "s": 10,
          "text": "(שבאדם),"
        },
        {
          "s": 11,
          "text": "ועד שהיא למעלה גם מבחינת המקיף דבית"
        },
        {
          "s": 12,
          "text": "[דבכ\"מ17"
        },
        {
          "s": 13,
          "text": "מבואר שבחינת חי' היא דוגמת מקיף דלבוש ובחינת יחידה דוגמת מקיף דבית."
        },
        {
          "s": 14,
          "text": "אבל בד\"ה אתה אחד הנ\"ל"
        },
        {
          "s": 15,
          "text": "(וכ\"ה בכ\"מ),"
        },
        {
          "s": 16,
          "text": "שבחינת יחידה היא למעלה גם מהמקיף דבית."
        },
        {
          "s": 17,
          "text": "שלכן,"
        },
        {
          "s": 18,
          "text": "גם בבית"
        },
        {
          "s": 19,
          "text": "(שהוא מקיף יותר מהמקיף דלבושים)"
        },
        {
          "s": 20,
          "text": "לא ישכון בו בחינת יחידה,"
        },
        {
          "s": 21,
          "text": "כ\"א בד' אמות הרחוקים בתכלית,"
        },
        {
          "s": 22,
          "text": "יותר מהריחוק דבית,"
        },
        {
          "s": 23,
          "text": "שם דוקא תשכון הארת בחינת יחידה18]."
        },
        {
          "s": 24,
          "text": "ולכן,"
        },
        {
          "s": 25,
          "text": "בבחינת היחידה דוקא הוא גילוי בחינת הא\"ס"
        },
        {
          "s": 26,
          "text": "(שלמעלה גם מחג\"ת שלפני הצמצום)."
        },
        {
          "s": 27,
          "text": "וזהו כי מאתך היא מנוחתם,"
        },
        {
          "s": 28,
          "text": "דמכיון שמנוחתם"
        },
        {
          "s": 29,
          "text": "(דשבת)"
        },
        {
          "s": 30,
          "text": "היא מצד בחינת יחידה,"
        },
        {
          "s": 31,
          "text": "לכן היא מאתך,"
        },
        {
          "s": 32,
          "text": "מאתך ממש."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ומבאר בהמאמר שם19,"
        },
        {
          "s": 2,
          "text": "דמה שתיקנו אנשי כנסת הגדולה לומר אתה אחד כו',"
        },
        {
          "s": 3,
          "text": "הוא,"
        },
        {
          "s": 4,
          "text": "דכנסת הגדולה היא כנסת ישראל,"
        },
        {
          "s": 5,
          "text": "וכללות כל ההשתלשלות"
        },
        {
          "s": 6,
          "text": "(בד' מדריגות הנ\"ל שנכללו בנוסח זה)"
        },
        {
          "s": 7,
          "text": "נמסר לכנסת הגדולה"
        },
        {
          "s": 8,
          "text": "(כנסת ישראל),"
        },
        {
          "s": 9,
          "text": "ומכנסת הגדולה"
        },
        {
          "s": 10,
          "text": "(כנס\"י)"
        },
        {
          "s": 11,
          "text": "נמסר זה לכללות נש\"י,"
        },
        {
          "s": 12,
          "text": "נשמות שבגופים,"
        },
        {
          "s": 13,
          "text": "שגם הם יכולים לומר ולהמשיך כל בחינות אלו,"
        },
        {
          "s": 14,
          "text": "מתחיל מבחינת אתה אחד שקאי"
        },
        {
          "s": 15,
          "text": "(כנ\"ל)"
        },
        {
          "s": 16,
          "text": "על בחינת החסד שלפני הצמצום,"
        },
        {
          "s": 17,
          "text": "בחינת טבע הטוב להטיב שמצד חפץ חסד20."
        },
        {
          "s": 18,
          "text": "וזהו ועשיתם אתם21,"
        },
        {
          "s": 19,
          "text": "א\"ת אותם אלא אתם כאילו עשאוני22"
        },
        {
          "s": 20,
          "text": "בכפי'"
        },
        {
          "s": 21,
          "text": "(כי פי' עשאוני בלה\"ק הוא ענין כפי' כמו גט מעושה23),"
        },
        {
          "s": 22,
          "text": "היינו שאתם כופים אותי כביכול להקרא בשם חג\"ת אף בבחינת א\"ס שלפני הצמצום24."
        },
        {
          "s": 23,
          "text": "והכח על זה בנש\"י הוא לפי דשרש הנשמות הוא בא\"ס עצמו"
        },
        {
          "s": 24,
          "text": "(שלמעלה גם מחג\"ת שבא\"ס)24,"
        },
        {
          "s": 25,
          "text": "וגם לאחרי שנתלבשו בגופים מאירה בהם בחינת זו בבחינת היחידה שבהם"
        },
        {
          "s": 26,
          "text": "(כנ\"ל),"
        },
        {
          "s": 27,
          "text": "ולכן יש בכחם לעשות"
        },
        {
          "s": 28,
          "text": "(ובאופן דכפי')"
        },
        {
          "s": 29,
          "text": "כל ד' מדריגות הנ\"ל."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וע\"פ כל הנ\"ל יובן מה שאמירת הדרוש ד\"ה אתה אחד היתה בש\"ק"
        },
        {
          "s": 2,
          "text": "(פ' ויצא)"
        },
        {
          "s": 3,
          "text": "קודם תפלת המנחה"
        },
        {
          "s": 4,
          "text": "[אף שבדרך כלל,"
        },
        {
          "s": 5,
          "text": "אמירת דא\"ח בהזמן דרעוא דרעוין היא,"
        },
        {
          "s": 6,
          "text": "כנראה ברבותינו נשיאינו,"
        },
        {
          "s": 7,
          "text": "לאחרי תפלת המנחה25],"
        },
        {
          "s": 8,
          "text": "כי אמירת אתה אחד כו' הוא לפעול המשכת ד' מדריגות הנ\"ל."
        },
        {
          "s": 9,
          "text": "ומכיון שכל הענינים נמשכים ע\"י תורה26,"
        },
        {
          "s": 10,
          "text": "לכן,"
        },
        {
          "s": 11,
          "text": "לפני אמירת אתה אחד בתפלת מנחה הייתה המשכת ענין זה בתורה."
        },
        {
          "s": 12,
          "text": "ומכיון שהמשכת ד' המדריגות שבנוסח אתה אחד הוא מצד שרש הנשמות בא\"ס שמתגלה בבחינת יחידה כנ\"ל,"
        },
        {
          "s": 13,
          "text": "לכן,"
        },
        {
          "s": 14,
          "text": "בתורה גופא,"
        },
        {
          "s": 15,
          "text": "הייתה המשכת ענין זה כמו שהוא בפנימיות התורה,"
        },
        {
          "s": 16,
          "text": "וכמו שפנימיות התורה היא באופן דיתפרנסון27"
        },
        {
          "s": 17,
          "text": "[חסידות חב\"ד28],"
        },
        {
          "s": 18,
          "text": "בחינת יחידה דתורה29."
        }
      ]
    }
  ]
}