{
  "globalIndex": 893,
  "owner": 43,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919103_theRebbe_196__p003",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919103_theRebbe_196__p003",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919103_theRebbe_196",
  "title": "מאמר השם נפשנו בחיים תשח\"י",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ועד\"ז הוא בעבודת האדם,"
        },
        {
          "s": 2,
          "text": "שהגם שיש יתרון בהעבודה דבכל דרכיך דעהו35"
        },
        {
          "s": 3,
          "text": "על העבודה דתורה ומצוות,"
        },
        {
          "s": 4,
          "text": "שע\"י העבודה דבכל דרכיך דעהו ידיעת אלקות היא גם בעניני העולם"
        },
        {
          "s": 5,
          "text": "(בכל דרכיך)36,"
        },
        {
          "s": 6,
          "text": "מ\"מ,"
        },
        {
          "s": 7,
          "text": "בכדי שעסקו בדברי הרשות"
        },
        {
          "s": 8,
          "text": "(דרכיך)"
        },
        {
          "s": 9,
          "text": "יהי' באופן שעניני העולם לא יפעלו בו ירידה ח\"ו ואדרבא בהם עצמם יראה השגחה פרטית"
        },
        {
          "s": 10,
          "text": "(דעהו),"
        },
        {
          "s": 11,
          "text": "הוא ע\"י העבודה דכל מעשיך יהיו לשם שמים37,"
        },
        {
          "s": 12,
          "text": "שכוונתו בזה שעוסק בעניני הרשות היא בכדי שעי\"ז יוכל לעסוק בתורה ומצוות"
        },
        {
          "s": 13,
          "text": "[ומכיון שכל עסקו בעניני העולם הוא בשביל קיום התומ\"צ לכן הוא ממעט בהם ככל האפשרי ועוסק בהם רק עד כמה שמוכרח],"
        },
        {
          "s": 14,
          "text": "ואז גם כשעוסק בעניני העולם,"
        },
        {
          "s": 15,
          "text": "הוא רואה בהם גילוי אלקות,"
        },
        {
          "s": 16,
          "text": "דעהו."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וע\"פ הנ\"ל יובן גם דיוק לשון רז\"ל13"
        },
        {
          "s": 2,
          "text": "שאין מחזיקין במחלוקת,"
        },
        {
          "s": 3,
          "text": "מחזיקין דייקא,"
        },
        {
          "s": 4,
          "text": "דמציאות המחלוקת עצמה,"
        },
        {
          "s": 5,
          "text": "זה שמים התחתונים נבדלו ממים העליונים,"
        },
        {
          "s": 6,
          "text": "היא בריאה שנבראה ע\"י הקב\"ה."
        },
        {
          "s": 7,
          "text": "וחטאו של קרח הי' שהחזיק במחלוקת,"
        },
        {
          "s": 8,
          "text": "שרצה שתתקיים ההבדלה"
        },
        {
          "s": 9,
          "text": "(שמים התחתונים ישארו למטה ולא יהי' בהם הצמאון לעלות למעלה)."
        },
        {
          "s": 10,
          "text": "ויש להוסיף,"
        },
        {
          "s": 11,
          "text": "דכמו שהכוונה בבריאת המחלוקת"
        },
        {
          "s": 12,
          "text": "(רקיע המבדיל)"
        },
        {
          "s": 13,
          "text": "ביום השני היא בכדי שיתברר ביום השלישי,"
        },
        {
          "s": 14,
          "text": "שאז גם הרקיע המבדיל נעשה טוב,"
        },
        {
          "s": 15,
          "text": "עד\"ז הוא גם בנוגע למחלוקת קרח,"
        },
        {
          "s": 16,
          "text": "שהכוונה בזה"
        },
        {
          "s": 17,
          "text": "(כמו שהי' מצד למעלה38)"
        },
        {
          "s": 18,
          "text": "היתה בכדי שעי\"ז יהי' שלום באופן נעלה יותר מכמו שהי' קודם המחלוקת."
        },
        {
          "s": 19,
          "text": "וכמבואר בהדרושים39,"
        },
        {
          "s": 20,
          "text": "דזה שבתחלה דיבר משה אל קרח ואל עדתו והי' מחזר אחריהם בדברי שלום40,"
        },
        {
          "s": 21,
          "text": "הוא,"
        },
        {
          "s": 22,
          "text": "כי משה חשב דכמו שיום השלישי"
        },
        {
          "s": 23,
          "text": "(ת\"ת)"
        },
        {
          "s": 24,
          "text": "בירר את המחיצה וההבדלה שנעשה ביום השני,"
        },
        {
          "s": 25,
          "text": "עד\"ז יהי' גם בנוגע לקרח,"
        },
        {
          "s": 26,
          "text": "שמשה"
        },
        {
          "s": 27,
          "text": "[שהי' שלישי41,"
        },
        {
          "s": 28,
          "text": "ת\"ת42]"
        },
        {
          "s": 29,
          "text": "יברר אותו."
        },
        {
          "s": 30,
          "text": "[אלא שלא הי' כן,"
        },
        {
          "s": 31,
          "text": "כי קרח לא רצה בזה43,"
        },
        {
          "s": 32,
          "text": "ורצונו הי' להחזיק במחלוקת]."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש לבאר מה שמוסיף התרגום שויקח קרח הוא ואתפלג קרח ע\"ד רקיע המבדיל,"
        },
        {
          "s": 1,
          "text": "אף ששמו של קרח עצמו רומז"
        },
        {
          "s": 2,
          "text": "(כנ\"ל)"
        },
        {
          "s": 3,
          "text": "על רקיע המבדיל"
        },
        {
          "s": 4,
          "text": "(רקיע כעין הקרח),"
        },
        {
          "s": 5,
          "text": "כי שמו של קרח44"
        },
        {
          "s": 6,
          "text": "(מלשון קרחה45"
        },
        {
          "s": 7,
          "text": "שענינה הוא פילוג46)"
        },
        {
          "s": 8,
          "text": "מורה על הטבע שלו"
        },
        {
          "s": 9,
          "text": "(שהי' נוטה למחלוקת)"
        },
        {
          "s": 10,
          "text": "שנברא ע\"י הקב\"ה."
        },
        {
          "s": 11,
          "text": "משא\"כ ויקח קרח הוא מעשה המחלוקת שעשה ברצונו ובבחירתו."
        },
        {
          "s": 12,
          "text": "וזהו מה שמחדש התרגום אונקלוס דויקח קרח הוא ואתפלג קרח ע\"ד רקיע המבדיל,"
        },
        {
          "s": 13,
          "text": "שגם המעשה דמחלוקת קרח,"
        },
        {
          "s": 14,
          "text": "אף שזה הי' ברצונו ובבחירתו,"
        },
        {
          "s": 15,
          "text": "הוא ע\"ד רקיע המבדיל שנברא ע\"י הקב\"ה."
        },
        {
          "s": 16,
          "text": "דכמו שהכוונה בבריאת הרקיע המבדיל היא בכדי שיתברר ביום השלישי,"
        },
        {
          "s": 17,
          "text": "עד\"ז הוא גם ואתפלג קרח,"
        },
        {
          "s": 18,
          "text": "שהכוונה בזה"
        },
        {
          "s": 19,
          "text": "(מצד למעלה)"
        },
        {
          "s": 20,
          "text": "היא בכדי שיתברר ע\"י משה47,"
        },
        {
          "s": 21,
          "text": "כנ\"ל."
        }
      ]
    }
  ]
}