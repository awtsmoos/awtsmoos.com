{
  "globalIndex": 951,
  "owner": 1,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919374_theRebbe_640__p003",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919374_theRebbe_640__p003",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919374_theRebbe_640",
  "title": "מאמר עשרה שיושבין תשמ\"ב",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה25 ענין זה"
        },
        {
          "s": 2,
          "text": "(שע\"י התפלה נמשך אח\"כ גם בתורה)"
        },
        {
          "s": 3,
          "text": "מרומז גם בשני הקאַפּיטלאַך תהלים השייכים ליום ההולדת26"
        },
        {
          "s": 4,
          "text": "דבעל הגאולה בשנה זו"
        },
        {
          "s": 5,
          "text": "(תשמ\"ב),"
        },
        {
          "s": 6,
          "text": "בקאַפּיטל קב שסיימו לומר בערב יום ההולדת27"
        },
        {
          "s": 7,
          "text": "ובקאַפּיטל קג שהתחילו לומר ביום ההולדת."
        },
        {
          "s": 8,
          "text": "דבמזמור קב מתחיל בענין התפלה – תפלה לעני גו',"
        },
        {
          "s": 9,
          "text": "ובתפלה עצמה – בתפלה שבתכלית הביטול,"
        },
        {
          "s": 10,
          "text": "תפלה לעני כי יעטוף ולפני הוי' ישפוך שיחו."
        },
        {
          "s": 11,
          "text": "וכתורת הבעש\"ט הידועה28"
        },
        {
          "s": 12,
          "text": "עה\"פ,"
        },
        {
          "s": 13,
          "text": "שתפלת העני היא שלפני הוי' ישפוך שיחו."
        },
        {
          "s": 14,
          "text": "דזה שאינו מבקש שום דבר"
        },
        {
          "s": 15,
          "text": "(גם לא ענינים רוחניים29)"
        },
        {
          "s": 16,
          "text": "וכל מבוקשו הוא לשפוך שיחו לפני הוי',"
        },
        {
          "s": 17,
          "text": "הוא מפני גודל הביטול שלו."
        },
        {
          "s": 18,
          "text": "[ויש לומר,"
        },
        {
          "s": 19,
          "text": "דענין זה"
        },
        {
          "s": 20,
          "text": "(שאינו רוצה ומבקש שום דבר גם לא ענינים רוחניים ורק לשפוך שיחו לפני הוי')"
        },
        {
          "s": 21,
          "text": "הוא30"
        },
        {
          "s": 22,
          "text": "ע\"ד האהבה דמי לי בשמים ועמך לא חפצתי31,"
        },
        {
          "s": 23,
          "text": "וכלשון אדמו\"ר הזקן32"
        },
        {
          "s": 24,
          "text": "\"איך וויל זע גאָר ניסט איך וויל ניט דאיין ג\"ע איך וויל ניט דאיין עוה\"ב כו' איך וויל מער ניט אַז דיך אַליין\"."
        },
        {
          "s": 25,
          "text": "ויש לומר,"
        },
        {
          "s": 26,
          "text": "דע\"י שאמר אדמו\"ר הזקן איך וויל מער ניט אַז דיך אַליין,"
        },
        {
          "s": 27,
          "text": "ובפרט לאחרי שנתפרסם זה ע\"י הצמח צדק,"
        },
        {
          "s": 28,
          "text": "ניתן הכח33"
        },
        {
          "s": 29,
          "text": "לכאו\"א שהולך בעקבותיו"
        },
        {
          "s": 30,
          "text": "(וואָס האַלט זיך אין דער קליאַמקע34)"
        },
        {
          "s": 31,
          "text": "שבנוגע לפועל עכ\"פ יהי' אצלו מעין זה."
        },
        {
          "s": 32,
          "text": "ובפרט ע\"י לימוד תורתו של אדמו\"ר הזקן"
        },
        {
          "s": 33,
          "text": "(ועאכו\"כ ע\"י לימוד ענין זה),"
        },
        {
          "s": 34,
          "text": "שעי\"ז מתייחדים ביחוד נפלא35"
        },
        {
          "s": 35,
          "text": "עם תורתו של אדמו\"ר הזקן,"
        },
        {
          "s": 36,
          "text": "ועי\"ז – עם אדמו\"ר הזקן עצמו36]."
        },
        {
          "s": 37,
          "text": "ובהמשך המזמור37"
        },
        {
          "s": 38,
          "text": "אומר תכתב זאת לדור אחרון גו',"
        },
        {
          "s": 39,
          "text": "דקאי על התורה שהיא נצחית."
        },
        {
          "s": 40,
          "text": "ויש לומר,"
        },
        {
          "s": 41,
          "text": "שהקשר דשני הענינים הוא,"
        },
        {
          "s": 42,
          "text": "כי הענין דנצחיות התורה בעבודת האדם הוא שהתורה שלומד היא חקוקה במוחו ולבו38,"
        },
        {
          "s": 43,
          "text": "שאז דוקא אין שייך שיהי' בזה שינוי"
        },
        {
          "s": 44,
          "text": "(נצחיות),"
        },
        {
          "s": 45,
          "text": "ובכדי שלימוד התורה שלו יהי' באופן דחקיקה הוא ע\"י הקדמת עבודת התפלה."
        },
        {
          "s": 46,
          "text": "ונקודת הביאור בזה,"
        },
        {
          "s": 47,
          "text": "דענין החקיקה דתורה הוא"
        },
        {
          "s": 48,
          "text": "(בעיקר)"
        },
        {
          "s": 49,
          "text": "בהתורה כמו שהיא בשרשה,"
        },
        {
          "s": 50,
          "text": "בבחינת הכתר שלמעלה מחכמה39."
        },
        {
          "s": 51,
          "text": "ולאחרי שנמשכה ונתלבשה בחכמה"
        },
        {
          "s": 52,
          "text": "[דלמעלה,"
        },
        {
          "s": 53,
          "text": "ועאכו\"כ לאחרי שירדה ונתלבשה בשכל האדם]"
        },
        {
          "s": 54,
          "text": "היא באופן דכתיבה."
        },
        {
          "s": 55,
          "text": "ובכדי שלימוד התורה בהבנה והשגה תהי' באופן דחקיקה הוא ע\"י המשכת השורש דתורה"
        },
        {
          "s": 56,
          "text": "(כתר)"
        },
        {
          "s": 57,
          "text": "בהתורה שלמטה."
        },
        {
          "s": 58,
          "text": "ויש לומר,"
        },
        {
          "s": 59,
          "text": "דזהו מ\"ש תכתב זאת לדור אחרון,"
        },
        {
          "s": 60,
          "text": "תכתב לשון עתיד,"
        },
        {
          "s": 61,
          "text": "שבכדי שהתורה שלומד תהי' אצלו בבחינת נצחיות"
        },
        {
          "s": 62,
          "text": "(לדור אחרון),"
        },
        {
          "s": 63,
          "text": "צריך להגיע לדרגת החקיקה דתורה שלמעלה מבחינת כתיבה,"
        },
        {
          "s": 64,
          "text": "ולהמשיך משם בחינת הכתיבה דתורה,"
        },
        {
          "s": 65,
          "text": "תכתב לשון עתיד."
        },
        {
          "s": 66,
          "text": "וזוהי השייכות דתכתב זאת לדור אחרון לתפלה לעני גו',"
        },
        {
          "s": 67,
          "text": "שע\"י הקדמת הביטול דתפלה,"
        },
        {
          "s": 68,
          "text": "ובפרט כשהתפלה היא בתכלית הביטול,"
        },
        {
          "s": 69,
          "text": "שתפלתו היא שלפני הוי' ישפוך שיחו,"
        },
        {
          "s": 70,
          "text": "עי\"ז הוא ממשיך גילוי אוא\"ס שלמעלה מהשתלשלות,"
        },
        {
          "s": 71,
          "text": "והמשכה זו באה אח\"כ גם בלימוד התורה שלו,"
        },
        {
          "s": 72,
          "text": "תכתב זאת לדור אחרון."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ועד\"ז הוא במזמור קג שמתחיל בענין התפלה – ברכי נפשי את ה',"
        },
        {
          "s": 2,
          "text": "שהוא תפלת שבח והודי',"
        },
        {
          "s": 3,
          "text": "ובתפלה עצמה – תפלה שבתכלית הביטול."
        },
        {
          "s": 4,
          "text": "דהשבח וההודי' של דוד להקב\"ה"
        },
        {
          "s": 5,
          "text": "(ברכי נפשי את ה')"
        },
        {
          "s": 6,
          "text": "היתה על כל מאורע ומאורע,"
        },
        {
          "s": 7,
          "text": "כדאיתא בגמרא40"
        },
        {
          "s": 8,
          "text": "שדוד דר בחמשה עולמים ובכל עולם אמר שירה"
        },
        {
          "s": 9,
          "text": "(חמשה ברכי נפשי41),"
        },
        {
          "s": 10,
          "text": "דיש לומר,"
        },
        {
          "s": 11,
          "text": "שכל המאורעות דהאדם נחלקות לחמשה סוגים"
        },
        {
          "s": 12,
          "text": "(חמשה עולמים)"
        },
        {
          "s": 13,
          "text": "ודוד אמר שירה להקב\"ה על כל המאורעות,"
        },
        {
          "s": 14,
          "text": "דאמירת שירה להקב\"ה גם על הענינים דהיפך הטוב הנראה והנגלה הוא מפני גודל ועוצם הביטול."
        },
        {
          "s": 15,
          "text": "ובהמשך המזמור42"
        },
        {
          "s": 16,
          "text": "אומר ברכו ה' מלאכיו גבורי כח עושי דברו לשמוע בקול דברו,"
        },
        {
          "s": 17,
          "text": "ברישא עושי והדר לשמוע43,"
        },
        {
          "s": 18,
          "text": "הקדמת נעשה לנשמע שהיתה הכנה לקבלת התורה."
        },
        {
          "s": 19,
          "text": "ויש לומר שהקשר דשני הענינים44"
        },
        {
          "s": 20,
          "text": "הוא,"
        },
        {
          "s": 21,
          "text": "כי הביטול דהקדמת נעשה לנשמע הוא לא רק בנוגע לקיום המצוות אלא גם בלימוד התורה45."
        },
        {
          "s": 22,
          "text": "דע\"י שלפני מתן תורה הקדימו נעשה לנשמע,"
        },
        {
          "s": 23,
          "text": "ניתן הכח לכ\"א מישראל שלימוד התורה שלו יהי' בביטול,"
        },
        {
          "s": 24,
          "text": "באופן דתען לשוני אמרתך46,"
        },
        {
          "s": 25,
          "text": "כעונה אחר האומר47,"
        },
        {
          "s": 26,
          "text": "ועד שהדיבור שלו"
        },
        {
          "s": 27,
          "text": "(בתורה)"
        },
        {
          "s": 28,
          "text": "אינו תלוי ברצונו ובבחירתו48,"
        },
        {
          "s": 29,
          "text": "ועד שהביטול שלו כשעוסק בתורה הוא דוגמת הביטול דעל49"
        },
        {
          "s": 30,
          "text": "כל דיבור ודיבור פרחה נשמתן50."
        },
        {
          "s": 31,
          "text": "וזוהי השייכות ד"
        },
        {
          "s": 32,
          "text": "(עושי דברו)"
        },
        {
          "s": 33,
          "text": "לשמוע בקול דברו51"
        },
        {
          "s": 34,
          "text": "לברכי נפשי את ה',"
        },
        {
          "s": 35,
          "text": "כי ע\"י עבודת התפלה,"
        },
        {
          "s": 36,
          "text": "ובפרט כשהתפלה היא שאומר שירה על כל מאורע"
        },
        {
          "s": 37,
          "text": "(חמשה ברכי נפשי),"
        },
        {
          "s": 38,
          "text": "נמשך הביטול דתפלה גם בעסק התורה שלו."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ויש להוסיף בביאור השייכות ד"
        },
        {
          "s": 1,
          "text": "(עושי דברו)"
        },
        {
          "s": 2,
          "text": "לשמוע בקול דברו לחמשה ברכי נפשי,"
        },
        {
          "s": 3,
          "text": "דעיקר החידוש בהביטול דלימוד התורה הוא בתושבע\"פ,"
        },
        {
          "s": 4,
          "text": "שלימודה צ\"ל בהבנה והשגה"
        },
        {
          "s": 5,
          "text": "[דכשאינו מבין הפירוש אינו נחשב לימוד52]"
        },
        {
          "s": 6,
          "text": "ואעפ\"כ הלימוד הוא בביטול."
        },
        {
          "s": 7,
          "text": "וע\"ד על כל דיבור ודיבור פרחה נשמתן,"
        },
        {
          "s": 8,
          "text": "דהגם שכל דיבור הוא דיבור פרטי53"
        },
        {
          "s": 9,
          "text": "(דענין ההתחלקות שייך לההבנה וההשגה דתורה)"
        },
        {
          "s": 10,
          "text": "מ\"מ על כל דיבור ודיבור פרחה נשמתן."
        },
        {
          "s": 11,
          "text": "וזוהי השייכות דלשמוע בקול דברו לחמשה ברכי נפשי,"
        },
        {
          "s": 12,
          "text": "כי החידוש בהביטול דחמש פעמים ברכי נפשי"
        },
        {
          "s": 13,
          "text": "(שבמזמור קג)"
        },
        {
          "s": 14,
          "text": "על הביטול דלפני הוי' ישפוך שיחו"
        },
        {
          "s": 15,
          "text": "(שבמזמור קב),"
        },
        {
          "s": 16,
          "text": "הוא,"
        },
        {
          "s": 17,
          "text": "שהביטול דלפני הוי' ישפוך שיחו הוא שאין נוגע לו שום דבר"
        },
        {
          "s": 18,
          "text": "(כי כל מבוקשו הוא לדבר עם המלך),"
        },
        {
          "s": 19,
          "text": "והביטול דחמש ברכי נפשי שאומר שירה על כל המאורעות"
        },
        {
          "s": 20,
          "text": "(גם על הענינים דהיפך הטוב הנראה והנגלה)"
        },
        {
          "s": 21,
          "text": "הוא שגם הענינים השייכים למציאותו הם בתכלית הביטול."
        },
        {
          "s": 22,
          "text": "וע\"י ביטול זה בתפלה נמשך אח\"כ גם בעסק התורה שלו,"
        },
        {
          "s": 23,
          "text": "שגם הלימוד בהבנה והשגה הוא בביטול."
        }
      ]
    }
  ]
}