{
  "globalIndex": 986,
  "owner": 36,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919633_theRebbe_834__p002",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919633_theRebbe_834__p002",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919633_theRebbe_834",
  "title": "מאמר בלע המוות לנצח תשכ\"ה",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה הטעם על זה שדוקא לע\"ל יתבטל הרע"
        },
        {
          "s": 2,
          "text": "(מות הרוחני,"
        },
        {
          "s": 3,
          "text": "ובמילא גם המות כפשוטו)"
        },
        {
          "s": 4,
          "text": "הוא,"
        },
        {
          "s": 5,
          "text": "כי אז יהי' גילוי אור נעלה ביותר,"
        },
        {
          "s": 6,
          "text": "שלגבי אור זה,"
        },
        {
          "s": 7,
          "text": "מתבטלים במילא כל המנגדים."
        },
        {
          "s": 8,
          "text": "ומבאר בהמאמר13,"
        },
        {
          "s": 9,
          "text": "דהגם שגם בזמן שביהמ\"ק הי' קיים,"
        },
        {
          "s": 10,
          "text": "ובפרט בזמן בית ראשון,"
        },
        {
          "s": 11,
          "text": "ועאכו\"כ בימי שלמה דקיימא סיהרא באשלמותא14,"
        },
        {
          "s": 12,
          "text": "הי' גילוי אור נעלה ביותר,"
        },
        {
          "s": 13,
          "text": "ומצד גילוי זה,"
        },
        {
          "s": 14,
          "text": "כל הגוים נתבטלו לפניו,"
        },
        {
          "s": 15,
          "text": "שלא ע\"י מלחמה כלל15"
        },
        {
          "s": 16,
          "text": "[שלכן נק' בשם שלמה כי שלום הי' בימיו16],"
        },
        {
          "s": 17,
          "text": "מ\"מ הגילוי שהי' בימי שלמה הי' באופן שהי' עדיין מקום ליניקת החיצונים,"
        },
        {
          "s": 18,
          "text": "אלא שיניקתם אז היתה רק מאחוריים דקדושה ולא הי' להם אחיזה בפנימיות."
        },
        {
          "s": 19,
          "text": "[ויש לומר,"
        },
        {
          "s": 20,
          "text": "דזה שבימי שלמה הי' עדיין מקום ליניקת החיצונים,"
        },
        {
          "s": 21,
          "text": "ניכר גם באופן הביטול דהגוים שנתבטלו לפניו."
        },
        {
          "s": 22,
          "text": "וכמו מלכת שבא,"
        },
        {
          "s": 23,
          "text": "דעם היות שגם בהיותה בארצה ורק שמעה את שמע שלמה נעשה בה ביטול"
        },
        {
          "s": 24,
          "text": "(קצת),"
        },
        {
          "s": 25,
          "text": "שמצד זה17"
        },
        {
          "s": 26,
          "text": "באה אל שלמה18,"
        },
        {
          "s": 27,
          "text": "ובפרט לאחרי שבאה אליו וראתה את חכמתו וכו' שעי\"ז נתבטלה לפניו באופן שלא הי' בה עוד רוח19,"
        },
        {
          "s": 28,
          "text": "מ\"מ,"
        },
        {
          "s": 29,
          "text": "גם אז היתה מלכה,"
        },
        {
          "s": 30,
          "text": "ויתירה מזו,"
        },
        {
          "s": 31,
          "text": "שגם שלמה כיבד אותה בכבוד גדול20]."
        },
        {
          "s": 32,
          "text": "משא\"כ הגילוי דלע\"ל21"
        },
        {
          "s": 33,
          "text": "יהי' באופן שלא תהי' יניקה לחיצונים כלל"
        },
        {
          "s": 34,
          "text": "(גם לא מבחינת אחוריים)"
        },
        {
          "s": 35,
          "text": "ויתבטל הרע לגמרי,"
        },
        {
          "s": 36,
          "text": "בלע המות לנצח."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "וביאור החילוק בין הגילוי שהי' בימי שלמה"
        },
        {
          "s": 2,
          "text": "(שמצד גילוי זה הי' עדיין מקום ליניקת החיצונים,"
        },
        {
          "s": 3,
          "text": "מבחינת אחוריים עכ\"פ)"
        },
        {
          "s": 4,
          "text": "להגילוי דלע\"ל"
        },
        {
          "s": 5,
          "text": "(שמצד גילוי זה לא יהי' להם יניקה כלל),"
        },
        {
          "s": 6,
          "text": "מבאר בהמאמר22,"
        },
        {
          "s": 7,
          "text": "שהוא ע\"ד החילוק"
        },
        {
          "s": 8,
          "text": "(בעבודת האדם)"
        },
        {
          "s": 9,
          "text": "בין העבודה דסור מרע להעבודה דמואס ברע."
        },
        {
          "s": 10,
          "text": "דסור מרע הוא שמדחה את הרע אבל אינו שונא את הרע בעצם."
        },
        {
          "s": 11,
          "text": "ובמילא,"
        },
        {
          "s": 12,
          "text": "אף שבפועל הוא מדחה את הרע,"
        },
        {
          "s": 13,
          "text": "נשאר אצלו עדיין נתינת מקום להרע,"
        },
        {
          "s": 14,
          "text": "ועד שבהעלם יש לו איזה שמץ אהבה לרע,"
        },
        {
          "s": 15,
          "text": "כמבואר בתניא23"
        },
        {
          "s": 16,
          "text": "בדרגת צדיק שאינו גמור."
        },
        {
          "s": 17,
          "text": "משא\"כ כשהוא מואס ברע,"
        },
        {
          "s": 18,
          "text": "היינו שהוא מואס ברע בתכלית"
        },
        {
          "s": 19,
          "text": "(דרגת צדיק גמור),"
        },
        {
          "s": 20,
          "text": "אין אצלו שום נתינת מקום לרע,"
        },
        {
          "s": 21,
          "text": "שהרי אדרבא,"
        },
        {
          "s": 22,
          "text": "הוא שונא את הרע ומואס בו בתכלית השנאה והמיאוס."
        },
        {
          "s": 23,
          "text": "ועד\"ז הוא החילוק בין הגילוי שהי' בימי שלמה להגילוי דלע\"ל,"
        },
        {
          "s": 24,
          "text": "דהגילוי שהי' בימי שלמה,"
        },
        {
          "s": 25,
          "text": "עם היות שגם לגבי גילוי זה מתבטלים כל המנגדים"
        },
        {
          "s": 26,
          "text": "(בדוגמת שגם בהעבודה דסור מרע הוא מדחה את הרע),"
        },
        {
          "s": 27,
          "text": "מ\"מ,"
        },
        {
          "s": 28,
          "text": "יש עדיין מקום ליניקת החיצונים"
        },
        {
          "s": 29,
          "text": "(מבחינת אחוריים דקדושה עכ\"פ)."
        },
        {
          "s": 30,
          "text": "משא\"כ הגילוי דלע\"ל הוא דוגמת המואס ברע בתכלית המיאוס,"
        },
        {
          "s": 31,
          "text": "שאין בו שום נתינת מקום לענין דהיפך הקדושה."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ויש להוסיף,"
        },
        {
          "s": 1,
          "text": "דע\"פ המבואר בתניא23"
        },
        {
          "s": 2,
          "text": "שגודל השנאה לסט\"א והמיאוס ברע הוא כפי ערך גודל האהבה להוי',"
        },
        {
          "s": 3,
          "text": "החילוק בין סור מרע למואס ברע הוא"
        },
        {
          "s": 4,
          "text": "(לא רק בנוגע לאופן שלילת הרע,"
        },
        {
          "s": 5,
          "text": "אלא גם)"
        },
        {
          "s": 6,
          "text": "בגודל ואופן אהבתו להוי'."
        },
        {
          "s": 7,
          "text": "ועפ\"ז תומתק ההשוואה דחילוק זה"
        },
        {
          "s": 8,
          "text": "(שבין סור מרע למואס ברע)"
        },
        {
          "s": 9,
          "text": "להחילוק שבין הגילוי שהי' בימי שלמה להגילוי דלע\"ל,"
        },
        {
          "s": 10,
          "text": "דהחילוק שביניהם באופן שלילת הרע"
        },
        {
          "s": 11,
          "text": "(שבהגילוי שהי' בימי שלמה יש עדיין נתינת מקום ליניקת החיצונים משא\"כ בהגילוי דלע\"ל)"
        },
        {
          "s": 12,
          "text": "הוא מצד החילוק שבהם בדרגת ואופן האור והגילוי."
        }
      ]
    }
  ]
}