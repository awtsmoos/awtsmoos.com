{
  "globalIndex": 659,
  "owner": 9,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917648_theRebbe_921__p002",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917648_theRebbe_921__p002",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917648_theRebbe_921",
  "title": "מאמר החודש הזה לכם תשל\"ט",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ונקודת הביאור בזה"
        },
        {
          "s": 2,
          "text": "(כמו שמובן מהמאמר)"
        },
        {
          "s": 3,
          "text": "הוא,"
        },
        {
          "s": 4,
          "text": "שגם בחדשים"
        },
        {
          "s": 5,
          "text": "(מלשון חידוש),"
        },
        {
          "s": 6,
          "text": "שבכללות הם המשכת האור שלמעלה מהתלבשות בעולמות,"
        },
        {
          "s": 7,
          "text": "החדשים שלאחרי יציאת מצרים הם בדרגא נעלית יותר מהחדשים שהיו לפני זה."
        },
        {
          "s": 8,
          "text": "והענין הוא,"
        },
        {
          "s": 9,
          "text": "דהגילויים שנמשכו ע\"י עבודת האבות,"
        },
        {
          "s": 10,
          "text": "וגם האותות ומופתים שהיו במצרים"
        },
        {
          "s": 11,
          "text": "(כולל גם זה שבתשרי בטלה עבודה מאבותינו),"
        },
        {
          "s": 12,
          "text": "הם מבחינת האור ששייך לעולמות"
        },
        {
          "s": 13,
          "text": "(אלא שבאור זה גופא,"
        },
        {
          "s": 14,
          "text": "שרש האותות ומופתים הוא מבחינת האור שלמעלה מהתלבשות בעולמות),"
        },
        {
          "s": 15,
          "text": "דזהו מה שאותות ומופתים אלה היו במצרים מלשון מיצר וגבול,"
        },
        {
          "s": 16,
          "text": "כי כללות האור השייך לעולמות"
        },
        {
          "s": 17,
          "text": "(גם שלמעלה מהתלבשות)"
        },
        {
          "s": 18,
          "text": "הוא במדידה והגבלה,"
        },
        {
          "s": 19,
          "text": "וביציאת מצרים הי' הגילוי דעצמות אוא\"ס שלמעלה משייכות לעולמות,"
        },
        {
          "s": 20,
          "text": "ועי\"ז נעשה היציאה ממצרים,"
        },
        {
          "s": 21,
          "text": "היציאה מהמיצרים וההגבלות,"
        },
        {
          "s": 22,
          "text": "גם מהמיצרים וההגבלות הכי עליונים12."
        },
        {
          "s": 23,
          "text": "ומזה מובן,"
        },
        {
          "s": 24,
          "text": "דלפני יציאת מצרים,"
        },
        {
          "s": 25,
          "text": "גם החדשים"
        },
        {
          "s": 26,
          "text": "(מלשון חידוש)"
        },
        {
          "s": 27,
          "text": "שהיו אז,"
        },
        {
          "s": 28,
          "text": "הם חדשים השייכים להבריאה,"
        },
        {
          "s": 29,
          "text": "ואמיתית הענין דחדשים מלשון חידוש נעשה דוקא לאחרי יציאת מצרים."
        },
        {
          "s": 30,
          "text": "שי\"ב החדשים השייכים להבריאה שרשם הוא בהי\"ב צירופים דשם אד',"
        },
        {
          "s": 31,
          "text": "וי\"ב החדשים שלמעלה מהבריאה שרשם הוא בהי\"ב צירופים דשם הוי'13."
        },
        {
          "s": 32,
          "text": "[ויש לקשר זה עם המבואר בהמאמר14,"
        },
        {
          "s": 33,
          "text": "די\"ל החילוק בין חדשים סתם לחדשי השנה,"
        },
        {
          "s": 34,
          "text": "שחדשי השנה,"
        },
        {
          "s": 35,
          "text": "עם היותם גילויים שלמעלה מהעולם"
        },
        {
          "s": 36,
          "text": "(חדשים מלשון חידוש),"
        },
        {
          "s": 37,
          "text": "מ\"מ יש להם שייכות לעולם"
        },
        {
          "s": 38,
          "text": "(ושנה,"
        },
        {
          "s": 39,
          "text": "הנהגת הטבע),"
        },
        {
          "s": 40,
          "text": "וחדשים סתם הם הגילויים שלמעלה משייכות לעולמות]."
        },
        {
          "s": 41,
          "text": "וזהו שלפני יציאת מצרים הי' תשרי הראשון לחדשים ועכשיו ניסן הוא הראשון,"
        },
        {
          "s": 42,
          "text": "כי המשכת האור ששייך לעולמות הוא בתשרי שבו נברא העולם,"
        },
        {
          "s": 43,
          "text": "והמשכת עצמות אוא\"ס שלמעלה משייכות לעולמות הוא בניסן חודש הגאולה."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וצריך להבין,"
        },
        {
          "s": 2,
          "text": "דלפי ביאור זה נמצא לכאורה דזה שלאחרי יציאת מצרים ניסן הוא ראש חדשים הוא רק בענין החדשים שלמעלה מהבריאה"
        },
        {
          "s": 3,
          "text": "(שמהי\"ב צירופים דשם הוי',"
        },
        {
          "s": 4,
          "text": "שענינם הוא הגילוי דאוא\"ס שלמעלה משייכות לעולמות),"
        },
        {
          "s": 5,
          "text": "ומלשון התרגום דעתיקייא קרן לי' ירחא קדמאה כו' וכען הוא ירחא שביעאה משמע שזה שעכשיו ניסן הוא הראשון הוא"
        },
        {
          "s": 6,
          "text": "(גם)"
        },
        {
          "s": 7,
          "text": "בענין החדשים שבהם הי' תשרי הראשון"
        },
        {
          "s": 8,
          "text": "(היינו החדשים די\"ב צירופי אד',"
        },
        {
          "s": 9,
          "text": "שענינים הוא גילוי אוא\"ס השייך לעולמות)."
        },
        {
          "s": 10,
          "text": "וכן מובן גם מזה שמנין החדשים בתורה בכל מקום הוא מניסן15"
        },
        {
          "s": 11,
          "text": "(דאייר נקרא חודש השני,"
        },
        {
          "s": 12,
          "text": "סיון חודש השלישי),"
        },
        {
          "s": 13,
          "text": "כי לאחרי יציאת מצרים ומתן תורה,"
        },
        {
          "s": 14,
          "text": "ניסן הוא חודש הראשון בנוגע לכל הענינים."
        },
        {
          "s": 15,
          "text": "ויתירה מזו,"
        },
        {
          "s": 16,
          "text": "שגם בפרשיות התורה שלפני פרשת החודש,"
        },
        {
          "s": 17,
          "text": "מכיון שגם פרשיות אלו הם חלק מהתורה שניתנה לאחרי יציאת מצרים"
        },
        {
          "s": 18,
          "text": "(והדיבור הראשון דמ\"ת הוא אנכי גו' אשר הוצאתיך מארץ מצרים16),"
        },
        {
          "s": 19,
          "text": "מנין החדשים בהם הוא לא מתשרי אלא מניסן17."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ולכאורה הי' אפשר לבאר זה ע\"פ מ\"ש בהמאמר18,"
        },
        {
          "s": 1,
          "text": "דזה שלאחרי שנאמר החודש הזה לכם ראש חדשים מוסיף ראשון הוא לכם לחדשי השנה,"
        },
        {
          "s": 2,
          "text": "הוא,"
        },
        {
          "s": 3,
          "text": "דחדשי השנה"
        },
        {
          "s": 4,
          "text": "(חדשים השייכים לשנה)"
        },
        {
          "s": 5,
          "text": "הם הגילויים שנמשכים בעולם בלבושי הטבע,"
        },
        {
          "s": 6,
          "text": "וזהו שמוסיף ראשון הוא לכם לחדשי השנה,"
        },
        {
          "s": 7,
          "text": "שבישראל"
        },
        {
          "s": 8,
          "text": "(לכם),"
        },
        {
          "s": 9,
          "text": "יהי' הגילוי דאלקות שלמעלה מהטבע"
        },
        {
          "s": 10,
          "text": "(ניסן)"
        },
        {
          "s": 11,
          "text": "גם בטבע"
        },
        {
          "s": 12,
          "text": "(חדשי השנה)."
        },
        {
          "s": 13,
          "text": "אבל עדיין צריך להבין,"
        },
        {
          "s": 14,
          "text": "דלכאורה ענין זה"
        },
        {
          "s": 15,
          "text": "(שבישראל גם בהטבע צ\"ל נרגש האלקות שלמעלה מהטבע)"
        },
        {
          "s": 16,
          "text": "הוא ביאור רק על זה שלאחרי יציאת מצרים חדשי השנה שייכים גם לניסן,"
        },
        {
          "s": 17,
          "text": "אבל מהו הטעם על זה שמנין החדשים"
        },
        {
          "s": 18,
          "text": "(גם דחדשי השנה)"
        },
        {
          "s": 19,
          "text": "עכשיו הוא רק מניסן ולא מתשרי."
        },
        {
          "s": 20,
          "text": "דמכיון שחדשי השנה הם הגילויים השייכים להבריאה,"
        },
        {
          "s": 21,
          "text": "שבהם הי'"
        },
        {
          "s": 22,
          "text": "(תחלה)"
        },
        {
          "s": 23,
          "text": "תשרי הראשון,"
        },
        {
          "s": 24,
          "text": "למה נשתנה,"
        },
        {
          "s": 25,
          "text": "עכשיו שניסן הוא ראשון לחדשי השנה."
        },
        {
          "s": 26,
          "text": "והרי גם עכשיו"
        },
        {
          "s": 27,
          "text": "(אף שבישראל גם בהטבע צ\"ל נרגש האלקות שלמעלה מהטבע,"
        },
        {
          "s": 28,
          "text": "ואעפ\"כ)"
        },
        {
          "s": 29,
          "text": "ראש השנה הוא באחד בתשרי."
        }
      ]
    }
  ]
}