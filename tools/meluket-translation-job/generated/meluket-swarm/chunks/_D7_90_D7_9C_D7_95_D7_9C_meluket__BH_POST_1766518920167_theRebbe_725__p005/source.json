{
  "globalIndex": 1076,
  "owner": 26,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920167_theRebbe_725__p005",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920167_theRebbe_725__p005",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920167_theRebbe_725",
  "title": "מאמר אני לדודי תשכ\"ו",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "דע\"י שהגילוי די\"ג מדות הרחמים מעורר ומגלה הרצון הפנימי דישראל,"
        },
        {
          "s": 3,
          "text": "שהרצון דישראל באלקות הוא לפי שהם מושרשים בהעצמות,"
        },
        {
          "s": 4,
          "text": "נעשה עילוי בי\"ג מדות הרחמים."
        },
        {
          "s": 5,
          "text": "והענין הוא,"
        },
        {
          "s": 6,
          "text": "דזה שהבריאה היא בשביל ישראל32,"
        },
        {
          "s": 7,
          "text": "הכוונה בזה היא33"
        },
        {
          "s": 8,
          "text": "לא רק לבריאת העולם אלא לכל הגילויים,"
        },
        {
          "s": 9,
          "text": "גם לגילויים הכי נעלים."
        },
        {
          "s": 10,
          "text": "שע\"י הירידה די\"ג מדות הרחמים ממקומם"
        },
        {
          "s": 11,
          "text": "(היכל מלכותו,"
        },
        {
          "s": 12,
          "text": "למעלה מהשתלשלות)"
        },
        {
          "s": 13,
          "text": "לשדה בכדי לעורר ולגלות הרצון הפנימי בישראל מתגלה בהם שהכוונה בהם היא בשביל ישראל ששרשם הוא בהעצמות34."
        },
        {
          "s": 14,
          "text": "ויש לקשר זה עם מ\"ש35"
        },
        {
          "s": 15,
          "text": "מלך לשדה נעבד,"
        },
        {
          "s": 16,
          "text": "שאפילו המלך שאין למעלה ממנו נעבד לשדה כי ממנו מחיתו36,"
        },
        {
          "s": 17,
          "text": "ולפי מ\"ש בזהר37"
        },
        {
          "s": 18,
          "text": "מאן מלך דא מלך עילאה דאתחבר לשדה יש לומר שגם מחייתו כביכול של מלך עילאה38"
        },
        {
          "s": 19,
          "text": "הוא ע\"י שיורד ונמשך לשדה,"
        },
        {
          "s": 20,
          "text": "כי עי\"ז מתגלה שהכוונה בו היא בשביל ישראל ששרשם בהעצמות."
        },
        {
          "s": 21,
          "text": "וע\"פ מ\"ש בזהר37"
        },
        {
          "s": 22,
          "text": "אית שדה ואית שדה,"
        },
        {
          "s": 23,
          "text": "שדה דקדושה ושדה דלעו\"ז,"
        },
        {
          "s": 24,
          "text": "יש לומר39,"
        },
        {
          "s": 25,
          "text": "דענין מלך לשדה נעבד"
        },
        {
          "s": 26,
          "text": "(שע\"י הירידה וההמשכה לשדה נעשה עילוי במלך עילאה)"
        },
        {
          "s": 27,
          "text": "הוא בעיקר ע\"י שהגילוי די\"ג מדות הרחמים שלמעלה מהשתלשלות"
        },
        {
          "s": 28,
          "text": "(דבכללות הוא מלך עילאה40)"
        },
        {
          "s": 29,
          "text": "הוא גם לישראל הנמצאים במדבר"
        },
        {
          "s": 30,
          "text": "(שדה41"
        },
        {
          "s": 31,
          "text": "דלעו\"ז)"
        },
        {
          "s": 32,
          "text": "שעי\"ז מתגלה הרצון פנימי שלהם ויוצאים ממדבר"
        },
        {
          "s": 33,
          "text": "(שדה דלעו\"ז)"
        },
        {
          "s": 34,
          "text": "לשדה דקדושה להקביל את פני המלך."
        },
        {
          "s": 35,
          "text": "כי ע\"י התשובה דישראל שהיו תחילה בתכלית הריחוק מתגלה עוד יותר הפנימיות דישראל שרצונם האמיתי"
        },
        {
          "s": 36,
          "text": "(גם בשעת החטא)"
        },
        {
          "s": 37,
          "text": "הוא באלקות רק שיצרם הוא שתקפם42"
        },
        {
          "s": 38,
          "text": "[כפירוש הצ\"צ43"
        },
        {
          "s": 39,
          "text": "עה\"פ44"
        },
        {
          "s": 40,
          "text": "כי בשדה מצאה צעקה הנערה ואין מושיע לה,"
        },
        {
          "s": 41,
          "text": "שגם כשהנערה"
        },
        {
          "s": 42,
          "text": "(הנשמה)"
        },
        {
          "s": 43,
          "text": "היא בשדה דלעו\"ז,"
        },
        {
          "s": 44,
          "text": "ויתירה מזו,"
        },
        {
          "s": 45,
          "text": "שזה גרם שעשו איש שדה החזיק בה ושכב עמה45,"
        },
        {
          "s": 46,
          "text": "הנה גם אז הרצון דהנשמה הוא בקדושה,"
        },
        {
          "s": 47,
          "text": "והיא צועקת במר נפשה על זה שעשו איש שדה מחזיק בה,"
        },
        {
          "s": 48,
          "text": "צעקה הנערה,"
        },
        {
          "s": 49,
          "text": "ועי\"ז אין מושיע לה,"
        },
        {
          "s": 50,
          "text": "שנמשך לה ישועה מבחינת אין שלמעלה מהשתלשלות]."
        },
        {
          "s": 51,
          "text": "וכיון שגילוי רצון הפנימי דישראל"
        },
        {
          "s": 52,
          "text": "(שמצד שרשם בהעצמות)"
        },
        {
          "s": 53,
          "text": "הוא ע\"י התשובה דישראל שהיו תחילה בשדה דלעו\"ז"
        },
        {
          "s": 54,
          "text": "(מדבר),"
        },
        {
          "s": 55,
          "text": "לכן העילוי שנעשה בהי\"ג מדות ע\"י ירידתם והמשכתם למטה לעורר את האדם הוא בעיקר ע\"י שמעוררים את אלה שהיו תחילה בתכלית הריחוק."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "וזהו אני לדודי ודודי לי ר\"ת אלול,"
        },
        {
          "s": 2,
          "text": "דיש לומר46"
        },
        {
          "s": 3,
          "text": "שודודי לי שבר\"ת אלול קאי"
        },
        {
          "s": 4,
          "text": "(בעיקר)"
        },
        {
          "s": 5,
          "text": "על הגילוי דיגמה\"ר שבאלול."
        },
        {
          "s": 6,
          "text": "וזה שנאמר ודודי לי לאחרי אני לדודי"
        },
        {
          "s": 7,
          "text": "[אף שהגילוי דיגמה\"ר שבאלול הוא הנתינת כח על העבודה דאני לדודי]"
        },
        {
          "s": 8,
          "text": "הוא,"
        },
        {
          "s": 9,
          "text": "כי בפנימיות הענינים,"
        },
        {
          "s": 10,
          "text": "אני לדודי"
        },
        {
          "s": 11,
          "text": "(עבודת האדם)"
        },
        {
          "s": 12,
          "text": "הוא למעלה מודודי לי"
        },
        {
          "s": 13,
          "text": "(גילוי מלמעלה),"
        },
        {
          "s": 14,
          "text": "וכנ\"ל"
        },
        {
          "s": 15,
          "text": "(סעיף ו וסעיף ז)"
        },
        {
          "s": 16,
          "text": "שהכוונה בהגילוי דיגמה\"ר היא בכדי לעורר עבודת האדם,"
        },
        {
          "s": 17,
          "text": "ועי\"ז נעשה עילוי ביגמה\"ר."
        },
        {
          "s": 18,
          "text": "ושני ענינים בזה."
        },
        {
          "s": 19,
          "text": "העילוי שנעשה בהגילוי מלמעלה ע\"י ירידתו למטה בכדי לעורר את האדם"
        },
        {
          "s": 20,
          "text": "(כנ\"ל סעיף ז),"
        },
        {
          "s": 21,
          "text": "והעילוי שנעשה ע\"י התעוררות תשובה דהאדם בפועל."
        },
        {
          "s": 22,
          "text": "ובזה עצמו – שני ענינים."
        },
        {
          "s": 23,
          "text": "העילוי שמצד התענוג דלמעלה שבעבודת האדם ובפרט בעבודת התשובה – מקבל כו' בסבר פנים יפות,"
        },
        {
          "s": 24,
          "text": "ועי\"ז מתגלה אח\"כ התענוג העצמי שבישראל עצמם"
        },
        {
          "s": 25,
          "text": "(דשורש הנשמות הוא למעלה מהשורש דתומ\"צ,"
        },
        {
          "s": 26,
          "text": "גם ממצות התשובה)"
        },
        {
          "s": 27,
          "text": "– פנים שוחקות"
        },
        {
          "s": 28,
          "text": "(כנ\"ל סעיף ה)."
        },
        {
          "s": 29,
          "text": "ויש לומר,"
        },
        {
          "s": 30,
          "text": "דכיון שהתעוררות התשובה דהאדם"
        },
        {
          "s": 31,
          "text": "(שעל ידה הוא הגילוי דפנים יפות ופנים שוחקות)"
        },
        {
          "s": 32,
          "text": "באה ע\"י הגילוי דודודי לי"
        },
        {
          "s": 33,
          "text": "(הגילוי דיגמה\"ר שבאלול),"
        },
        {
          "s": 34,
          "text": "לכן,"
        },
        {
          "s": 35,
          "text": "הפעולה דאני לדודי בודודי לי הוא שגם הגילוי דודודי לי מתעלה להתענוג דפנים יפות ופנים שוחקות."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ויהי רצון,"
        },
        {
          "s": 1,
          "text": "שע\"י מעשינו ועבודתינו47,"
        },
        {
          "s": 2,
          "text": "ובפרט ע\"י העבודה דחודש אלול,"
        },
        {
          "s": 3,
          "text": "נזכה בקרוב ממש לגאולה העתידה,"
        },
        {
          "s": 4,
          "text": "שאז יהי' אמיתית הענין דמראה פנים שוחקות,"
        },
        {
          "s": 5,
          "text": "וכמבואר בכ\"מ48"
        },
        {
          "s": 6,
          "text": "בענין הקניגיא שעתיד הקב\"ה לעשות לצדיקים לע\"ל49,"
        },
        {
          "s": 7,
          "text": "שיראו בגילוי שכל המלחמה דטוב ורע"
        },
        {
          "s": 8,
          "text": "(שבעולם הזה)"
        },
        {
          "s": 9,
          "text": "הוא רק בכדי שיהי' שחוק ותענוג,"
        },
        {
          "s": 10,
          "text": "ואז ימלא שחוק פינו50,"
        },
        {
          "s": 11,
          "text": "וכל זה – בקרוב ממש."
        }
      ]
    }
  ]
}