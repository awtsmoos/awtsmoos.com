{
  "globalIndex": 613,
  "owner": 13,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917334_theRebbe_880__p002",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917334_theRebbe_880__p002",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917334_theRebbe_880",
  "title": "מאמר ואתה תצוה תשמ\"א",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ולבאר זה,"
        },
        {
          "s": 2,
          "text": "מקדים בהמאמר11"
        },
        {
          "s": 3,
          "text": "שמשה רבינו נקרא רעיא מהימנא,"
        },
        {
          "s": 4,
          "text": "דשני פירושים בזה."
        },
        {
          "s": 5,
          "text": "שהוא רועה נאמן של ישראל ושהוא זן ומפרנס את ישראל בענין האמונה."
        },
        {
          "s": 6,
          "text": "דהאמונה שישנה בישראל מצד עצמם,"
        },
        {
          "s": 7,
          "text": "שישראל הם מאמינים בני מאמינים12,"
        },
        {
          "s": 8,
          "text": "אפשר שתהי' בבחינת מקיף,"
        },
        {
          "s": 9,
          "text": "וזה שמשה רועה ומפרנס את ישראל בענין האמונה הוא שהאמונה תהי' בפנימיות."
        },
        {
          "s": 10,
          "text": "וזהו מ\"ש בזהר13"
        },
        {
          "s": 11,
          "text": "ההיא אמונה דלעילא יתזן ויתפרנס מני' על ידך"
        },
        {
          "s": 12,
          "text": "(ע\"י משה),"
        },
        {
          "s": 13,
          "text": "דזה שמשה זן ומפרנס את האמונה הוא שממשיך אותה בפנימיות."
        },
        {
          "s": 14,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 15,
          "text": "דזה שמשה הוא רעיא מהימנא,"
        },
        {
          "s": 16,
          "text": "הכוונה בזה היא גם לאתפשטותא דמשה שבכל דור14,"
        },
        {
          "s": 17,
          "text": "דראשי אלפי ישראל שבכל דור הם מחזקים את האמונה דישראל"
        },
        {
          "s": 18,
          "text": "(שבדורם),"
        },
        {
          "s": 19,
          "text": "שהאמונה שלהם תהי' בפנימיות."
        },
        {
          "s": 20,
          "text": "וכמו מרדכי15,"
        },
        {
          "s": 21,
          "text": "שהי' האתפשטותא דמשה שבדורו,"
        },
        {
          "s": 22,
          "text": "כמארז\"ל16"
        },
        {
          "s": 23,
          "text": "שמרדכי בדורו כמשה בדורו,"
        },
        {
          "s": 24,
          "text": "שגם בזמן גזירת המן,"
        },
        {
          "s": 25,
          "text": "שלימוד התורה וקיום המצוות אז הי' קשור עם מס\"נ,"
        },
        {
          "s": 26,
          "text": "הקהיל קהילות ברבים לחזק את אמונתם של ישראל בהוי' ולעמוד חזק בלימוד התורה וקיום המצוות."
        },
        {
          "s": 27,
          "text": "ולאחרי שמבאר בארוכה שמשה ואתפשטותא דילי' שבכל דרא מחזקים את האמונה דישראל,"
        },
        {
          "s": 28,
          "text": "מבאר17"
        },
        {
          "s": 29,
          "text": "דיוק לשון הכתוב שמן גו' כתית למאור"
        },
        {
          "s": 30,
          "text": "(למאור ולא להאיר),"
        },
        {
          "s": 31,
          "text": "שבזמן הגלות,"
        },
        {
          "s": 32,
          "text": "שכאו\"א הוא נשבר ונדכא,"
        },
        {
          "s": 33,
          "text": "כתית,"
        },
        {
          "s": 34,
          "text": "עי\"ז מגיעים למאור"
        },
        {
          "s": 35,
          "text": "(העצם)"
        },
        {
          "s": 36,
          "text": "שממנו נמצא האור."
        },
        {
          "s": 37,
          "text": "וצריך להבין השייכות דהפירוש בכתית למאור להמבואר"
        },
        {
          "s": 38,
          "text": "(בהמאמר)"
        },
        {
          "s": 39,
          "text": "לפנ\"ז שמשה"
        },
        {
          "s": 40,
          "text": "[ואתפשטותא דילי' שבכל דרא]"
        },
        {
          "s": 41,
          "text": "זן ומפרנס את האמונה שתהי' בפנימיות."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה הביאור בפסוק ואתה תצוה בא"
        },
        {
          "s": 2,
          "text": "(בהמאמר)"
        },
        {
          "s": 3,
          "text": "בהמשך להמבואר בתחלת המאמר,"
        },
        {
          "s": 4,
          "text": "דפירוש וקבל היהודים את אשר החלו לעשות18"
        },
        {
          "s": 5,
          "text": "הוא שקבלו מה שהחלו בהזמן דמתן תורה19."
        },
        {
          "s": 6,
          "text": "דבמתן תורה היתה ההתחלה"
        },
        {
          "s": 7,
          "text": "(החלו לעשות),"
        },
        {
          "s": 8,
          "text": "ובימי אחשורוש"
        },
        {
          "s": 9,
          "text": "(בזמן גזירת המן)"
        },
        {
          "s": 10,
          "text": "היתה הקבלה,"
        },
        {
          "s": 11,
          "text": "וקבל היהודים."
        },
        {
          "s": 12,
          "text": "[וע\"ד מארז\"ל20"
        },
        {
          "s": 13,
          "text": "עה\"פ21"
        },
        {
          "s": 14,
          "text": "קיימו וקבלו היהודים,"
        },
        {
          "s": 15,
          "text": "קיימו מה שקבלו כבר,"
        },
        {
          "s": 16,
          "text": "דזה שהקדימו נעשה לנשמע במ\"ת היתה רק הקבלה,"
        },
        {
          "s": 17,
          "text": "ובימי אחשורוש22"
        },
        {
          "s": 18,
          "text": "קיימו מה שקבלו23]."
        },
        {
          "s": 19,
          "text": "ומדייק בהמאמר,"
        },
        {
          "s": 20,
          "text": "שלכאורה הוא דבר פלא24,"
        },
        {
          "s": 21,
          "text": "דבמתן תורה היו ישראל בתכלית העילוי,"
        },
        {
          "s": 22,
          "text": "והי' אז אצלם גילוי אלקות בדרגא הכי נעלית"
        },
        {
          "s": 23,
          "text": "[דנוסף לזה שגם קודם מ\"ת היו גילויים נעלים ביותר,"
        },
        {
          "s": 24,
          "text": "הגילוי שהי' ביציאת מצרים ובפרט בקריעת ים סוף,"
        },
        {
          "s": 25,
          "text": "הנה הגילוי שהי' בשעת מ\"ת הי' גילוי נעלה עוד יותר],"
        },
        {
          "s": 26,
          "text": "ובימי אחשורוש היו ישראל בתכלית הירידה,"
        },
        {
          "s": 27,
          "text": "דנוסף לההעלם וההסתר שבכל גלות"
        },
        {
          "s": 28,
          "text": "[דכל גלות הוא בדוגמת גלות מצרים25,"
        },
        {
          "s": 29,
          "text": "וכמו שבגלות מצרים כתיב26"
        },
        {
          "s": 30,
          "text": "ולא שמעו אל משה מקוצר רוח ומעבודה קשה,"
        },
        {
          "s": 31,
          "text": "עד\"ז הוא בכל גלות,"
        },
        {
          "s": 32,
          "text": "שישנם כמה נסיונות בקיום התורה והמצוות],"
        },
        {
          "s": 33,
          "text": "הנה אז"
        },
        {
          "s": 34,
          "text": "(בזמן גזירת המן)"
        },
        {
          "s": 35,
          "text": "הי' ההעלם וההסתר עוד יותר,"
        },
        {
          "s": 36,
          "text": "ואעפ\"כ,"
        },
        {
          "s": 37,
          "text": "בזמן מתן תורה,"
        },
        {
          "s": 38,
          "text": "כשהיו ישראל בתכלית העילוי,"
        },
        {
          "s": 39,
          "text": "היתה רק ההתחלה"
        },
        {
          "s": 40,
          "text": "(החלו לעשות),"
        },
        {
          "s": 41,
          "text": "ובזמן גזירת המן,"
        },
        {
          "s": 42,
          "text": "כשהיו בתכלית השפלות,"
        },
        {
          "s": 43,
          "text": "אז דוקא קבלו מה שהחלו במתן תורה."
        },
        {
          "s": 44,
          "text": "ומבאר בזה,"
        },
        {
          "s": 45,
          "text": "דבזמן הגזירה,"
        },
        {
          "s": 46,
          "text": "הי' קיום התומ\"צ שלהם במס\"נ."
        },
        {
          "s": 47,
          "text": "[דנוסף לזה שהי' להם מס\"נ שלא לכפור ח\"ו"
        },
        {
          "s": 48,
          "text": "[כמבואר בתו\"א27,"
        },
        {
          "s": 49,
          "text": "שבאם היו ממירים דתם לא היו עושים להם כלום,"
        },
        {
          "s": 50,
          "text": "כי הגזירה היתה רק על היהודים,"
        },
        {
          "s": 51,
          "text": "ואעפ\"כ לא עלתה על דעתם מחשבת חוץ ח\"ו],"
        },
        {
          "s": 52,
          "text": "הי' להם מס\"נ גם על קיום התומ\"צ28,"
        },
        {
          "s": 53,
          "text": "ועד שהקהילו קהילות ברבים ללמוד תורה במס\"נ29]."
        },
        {
          "s": 54,
          "text": "והתעוררות המס\"נ שלהם היתה ע\"י מרדכי היהודי,"
        },
        {
          "s": 55,
          "text": "משה שבדורו."
        },
        {
          "s": 56,
          "text": "וזהו וקבל היהודים את אשר החלו לעשות,"
        },
        {
          "s": 57,
          "text": "דבמתן תורה היתה רק ההתחלה ובזמן גזירת המן היתה הקבלה,"
        },
        {
          "s": 58,
          "text": "כי ע\"י שהי' להם אז מס\"נ בפועל על תומ\"צ נתעלו"
        },
        {
          "s": 59,
          "text": "(בענין זה)"
        },
        {
          "s": 60,
          "text": "למדריגה נעלית יותר מכמו שהיו בזמן מתן תורה,"
        },
        {
          "s": 61,
          "text": "ולכן אז דוקא היתה הקבלה,"
        },
        {
          "s": 62,
          "text": "וקבל היהודים."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ולכאורה יש לומר,"
        },
        {
          "s": 1,
          "text": "שהפירוש בכתית למאור,"
        },
        {
          "s": 2,
          "text": "שע\"י כתית"
        },
        {
          "s": 3,
          "text": "(נשבר ונדכא)"
        },
        {
          "s": 4,
          "text": "מגיעים להמאור,"
        },
        {
          "s": 5,
          "text": "הוא ביאור על זה שבזמן הגזירה דוקא באו למס\"נ באופן נעלה ביותר30."
        },
        {
          "s": 6,
          "text": "כי מס\"נ היא מצד עצם הנשמה שלמעלה מגילוי,"
        },
        {
          "s": 7,
          "text": "מאור"
        },
        {
          "s": 8,
          "text": "(שממנו נמצא האור),"
        },
        {
          "s": 9,
          "text": "וע\"י שהיו אז במצב דכתית"
        },
        {
          "s": 10,
          "text": "(נשבר ונדכא),"
        },
        {
          "s": 11,
          "text": "נתגלה עצם הנשמה,"
        },
        {
          "s": 12,
          "text": "מאור."
        },
        {
          "s": 13,
          "text": "אבל מהמשך וסדר הענינים בהמאמר שהפירוש בכתית למאור בא לאחרי הענין דרעיא מהימנא,"
        },
        {
          "s": 14,
          "text": "משמע,"
        },
        {
          "s": 15,
          "text": "דענין כתית למאור שייך גם לזה שמשה זן ומפרנס את האמונה שתהי' בפנימיות."
        }
      ]
    }
  ]
}