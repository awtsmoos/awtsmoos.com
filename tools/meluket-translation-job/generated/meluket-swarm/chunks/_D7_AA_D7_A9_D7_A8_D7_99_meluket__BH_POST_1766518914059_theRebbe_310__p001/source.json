{
  "globalIndex": 63,
  "owner": 13,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914059_theRebbe_310__p001",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914059_theRebbe_310__p001",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914059_theRebbe_310",
  "title": "מאמר שובה ישראל תשל\"ז",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ האזינו,"
        },
        {
          "s": 2,
          "text": "שבת תשובה,"
        },
        {
          "s": 3,
          "text": "ה'תשל\"ז*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "שובה ישראל עד הוי' אלקיך גו' קחו עמכם דברים ושובו אל הוי'1,"
        },
        {
          "s": 1,
          "text": "וצריך להבין,"
        },
        {
          "s": 2,
          "text": "דכשאומר שובה ישראל הרי הכוונה היא לתשובה כדבעי,"
        },
        {
          "s": 3,
          "text": "ומכיון שמ\"ע להתוודות"
        },
        {
          "s": 4,
          "text": "(כשעושה תשובה)2,"
        },
        {
          "s": 5,
          "text": "ועד שהוידוי הוא מעיקרי התשובה3,"
        },
        {
          "s": 6,
          "text": "הרי בשובה ישראל נכלל גם וידוי דברים,"
        },
        {
          "s": 7,
          "text": "ומה מוסיף בקחו עמכם דברים4."
        },
        {
          "s": 8,
          "text": "כן צ\"ל ההמשך מה שאומר ושובו אל הוי',"
        },
        {
          "s": 9,
          "text": "דמזה משמע שלאחרי התשובה דשובה ישראל גו',"
        },
        {
          "s": 10,
          "text": "צריכה להיות עוד תשובה."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים מה שנתבאר לעיל5,"
        },
        {
          "s": 2,
          "text": "דמ\"ש שובה ישראל עד הוי' אלקיך"
        },
        {
          "s": 3,
          "text": "(אף שלכאורה הול\"ל להוי' אלקיך),"
        },
        {
          "s": 4,
          "text": "הוא,"
        },
        {
          "s": 5,
          "text": "כפירוש אדמו\"ר הזקן6,"
        },
        {
          "s": 6,
          "text": "שהתשובה צריכה להיות עד שהוי' יהי' אלקיך."
        },
        {
          "s": 7,
          "text": "ועוד פירוש7"
        },
        {
          "s": 8,
          "text": "בשובה ישראל עד,"
        },
        {
          "s": 9,
          "text": "שעד קאי על בחינה שלמעלה שנק' בשם עד8."
        },
        {
          "s": 10,
          "text": "וגם בזה שתי דרגות,"
        },
        {
          "s": 11,
          "text": "עד ועד בכלל ועד ולא עד בכלל."
        },
        {
          "s": 12,
          "text": "עד ועד בכלל הוא"
        },
        {
          "s": 13,
          "text": "(בד\"כ)"
        },
        {
          "s": 14,
          "text": "בהמדריגות שבסדר השתלשלות,"
        },
        {
          "s": 15,
          "text": "שכל המדריגות שבהשתלשלות הם בערך זל\"ז,"
        },
        {
          "s": 16,
          "text": "ולכן,"
        },
        {
          "s": 17,
          "text": "גם כשנמצא במדריגה תחתונה יש לו כבר שייכות להמדריגות שלמעלה ממנה,"
        },
        {
          "s": 18,
          "text": "ועד למדריגה הכי עליונה,"
        },
        {
          "s": 19,
          "text": "עד ועד בכלל."
        },
        {
          "s": 20,
          "text": "ועד ולא עד בכלל הוא בלמעלה מהשתלשלות,"
        },
        {
          "s": 21,
          "text": "שגם כשהוא נמצא בדרגא הכי עליונה שבהשתלשלות,"
        },
        {
          "s": 22,
          "text": "לא יגיע עי\"ז להדרגא שלמעלה מהשתלשלות,"
        },
        {
          "s": 23,
          "text": "עד ולא עד בכלל."
        }
      ]
    }
  ]
}