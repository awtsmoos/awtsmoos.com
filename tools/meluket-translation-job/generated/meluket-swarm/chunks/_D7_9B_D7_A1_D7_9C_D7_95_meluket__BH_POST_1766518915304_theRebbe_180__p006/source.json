{
  "globalIndex": 260,
  "owner": 10,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915304_theRebbe_180__p006",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915304_theRebbe_180__p006",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915304_theRebbe_180",
  "title": "מאמר ושבתי בשלום תשל\"ח",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "והנה ענין ויקח מאבני המקום גו' ישנו גם בהאדם עצמו."
        },
        {
          "s": 3,
          "text": "והענין הוא,"
        },
        {
          "s": 4,
          "text": "דהנה ידוע82"
        },
        {
          "s": 5,
          "text": "שאבנים הן אותיות83,"
        },
        {
          "s": 6,
          "text": "כי כמו שאבנים הן דומם כן האותיות הם בחי' הדומם שבכחות האדם."
        },
        {
          "s": 7,
          "text": "אבל אעפ\"כ,"
        },
        {
          "s": 8,
          "text": "ומטעם זה גופא,"
        },
        {
          "s": 9,
          "text": "ממשיכים הם"
        },
        {
          "s": 10,
          "text": "(אותיות מלשון אתא84"
        },
        {
          "s": 11,
          "text": "בוקר85,"
        },
        {
          "s": 12,
          "text": "ענין המשכה)"
        },
        {
          "s": 13,
          "text": "בחינת אור נעלה ביותר."
        },
        {
          "s": 14,
          "text": "וע\"ד הידוע86"
        },
        {
          "s": 15,
          "text": "בפירוש הכתוב87"
        },
        {
          "s": 16,
          "text": "כי לא על הלחם לבדו יחי' האדם כי על כל מוצא פי הוי' יחי' האדם,"
        },
        {
          "s": 17,
          "text": "דזה שהלחם מחי' את האדם הוא לפי שהמוצא פי הוי' שבלחם"
        },
        {
          "s": 18,
          "text": "(צומח)"
        },
        {
          "s": 19,
          "text": "הוא נעלה יותר"
        },
        {
          "s": 20,
          "text": "(בשרשו)"
        },
        {
          "s": 21,
          "text": "מהמוצא פי הוי' שבאדם,"
        },
        {
          "s": 22,
          "text": "דזה גופא שירד למטה יותר מורה שבשרשו הוא נעלה יותר,"
        },
        {
          "s": 23,
          "text": "דכל הגבוה יותר יורד למטה יותר,"
        },
        {
          "s": 24,
          "text": "עד\"ז הוא גם בענין האותיות,"
        },
        {
          "s": 25,
          "text": "דומם"
        },
        {
          "s": 26,
          "text": "(שבאדם),"
        },
        {
          "s": 27,
          "text": "ששרשם הוא למעלה יותר גם מבחי' צומח88,"
        },
        {
          "s": 28,
          "text": "דכל הגבוה גבוה89"
        },
        {
          "s": 29,
          "text": "יותר יורד למטה מטה יותר."
        },
        {
          "s": 30,
          "text": "וזהו\"ע ויקח מאבני המקום וישם מראשותיו"
        },
        {
          "s": 31,
          "text": "(כמו שהוא בעבודת כאו\"א מישראל),"
        },
        {
          "s": 32,
          "text": "שהעבודה דבחי' אותיות,"
        },
        {
          "s": 33,
          "text": "דומם שבאדם,"
        },
        {
          "s": 34,
          "text": "מגעת למעלה יותר מהעבודה דבחי' השכל"
        },
        {
          "s": 35,
          "text": "(מראשותיו)."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ב)"
        },
        {
          "s": 2,
          "text": "ושני פירושים הנ\"ל בויקח מאבני המקום גו'"
        },
        {
          "s": 3,
          "text": "[העבודה בבחי' הדומם שבאדם"
        },
        {
          "s": 4,
          "text": "(דלעיל סעיף יא)"
        },
        {
          "s": 5,
          "text": "והעבודה דבירור דברים הגשמיים שבעולם"
        },
        {
          "s": 6,
          "text": "(דלעיל סעיף ט)]"
        },
        {
          "s": 7,
          "text": "שייכים זה לזה."
        },
        {
          "s": 8,
          "text": "כי הבירור דעניני עוה\"ז הגשמי"
        },
        {
          "s": 9,
          "text": "(אבני המקום דעולם)"
        },
        {
          "s": 10,
          "text": "הוא ע\"י הדומם שבאדם,"
        },
        {
          "s": 11,
          "text": "כח הדיבור,"
        },
        {
          "s": 12,
          "text": "ובעיקר – כח המעשה90,"
        },
        {
          "s": 13,
          "text": "שהמעשה הוא העיקר91."
        },
        {
          "s": 14,
          "text": "ויש להוסיף,"
        },
        {
          "s": 15,
          "text": "שהשייכות דשני ענינים אלו היא לא רק מצד ענין ה\"תחתון\""
        },
        {
          "s": 16,
          "text": "(אבן,"
        },
        {
          "s": 17,
          "text": "דומם)"
        },
        {
          "s": 18,
          "text": "שבהם"
        },
        {
          "s": 19,
          "text": "[שהפעולה בגשמיות העולם היא ע\"י כחות התחתונים שבאדם],"
        },
        {
          "s": 20,
          "text": "כי אם,"
        },
        {
          "s": 21,
          "text": "גם בנוגע לענין העילוי שבהם"
        },
        {
          "s": 22,
          "text": "(וישם מראשותיו)."
        },
        {
          "s": 23,
          "text": "והיינו,"
        },
        {
          "s": 24,
          "text": "דזה שבכחו של כאו\"א מישראל לעשות מחלקו בעולם דירה לו ית',"
        },
        {
          "s": 25,
          "text": "לו לעצמותו92,"
        },
        {
          "s": 26,
          "text": "הוא לפי שע\"י עבודתו בכחות התחתונים שלו מתגלה עצם הנשמה המיוחד בעצמותו ית'93."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "ויובן זה בהקדים המבואר בכ\"מ94"
        },
        {
          "s": 1,
          "text": "בענין היו\"ד דשם הוי' שבנפש האדם שהוא בחי' חי'."
        },
        {
          "s": 2,
          "text": "ומכיון שבחי' הראש דיעקב"
        },
        {
          "s": 3,
          "text": "[שהוא היו\"ד דיעקב,"
        },
        {
          "s": 4,
          "text": "שהוא היו\"ד דשם הוי'"
        },
        {
          "s": 5,
          "text": "(כנ\"ל סעיף ד)]"
        },
        {
          "s": 6,
          "text": "הוא בחי' חי',"
        },
        {
          "s": 7,
          "text": "מובן מזה,"
        },
        {
          "s": 8,
          "text": "דזה שהעבודה דבחי' דומם שבאדם מגעת למעלה מבחי' ראש דיעקב"
        },
        {
          "s": 9,
          "text": "(כנ\"ל"
        },
        {
          "s": 10,
          "text": "(סו\"ס יא)"
        },
        {
          "s": 11,
          "text": "בפירוש ויקח מאבני המקום וישם מראשותיו),"
        },
        {
          "s": 12,
          "text": "הכוונה בזה היא – שע\"י העבודה דבחי' דומם שבאדם,"
        },
        {
          "s": 13,
          "text": "מתגלית בחינת היחידה שבו"
        },
        {
          "s": 14,
          "text": "(שלמעלה מבחי' חי')."
        },
        {
          "s": 15,
          "text": "כי ענין העבודה דבחי' דומם שבאדם,"
        },
        {
          "s": 16,
          "text": "היינו דהגם שאין לו שום חיות"
        },
        {
          "s": 17,
          "text": "(לא מצד הרגש המדות שבלב,"
        },
        {
          "s": 18,
          "text": "ולא מצד השכל שבמוח,"
        },
        {
          "s": 19,
          "text": "וגם לא מצד הרצון שלמעלה מהשכל"
        },
        {
          "s": 20,
          "text": "(בחי' חי'))"
        },
        {
          "s": 21,
          "text": "ומ\"מ הוא עובד את עבודתו,"
        },
        {
          "s": 22,
          "text": "הוא מצד העצם שלו,"
        },
        {
          "s": 23,
          "text": "מה שכל אחד מישראל בעצם מהותו הוא רוצה לעשות כל מה שהוא רצון ה',"
        },
        {
          "s": 24,
          "text": "כפס\"ד הרמב\"ם95"
        },
        {
          "s": 25,
          "text": "הידוע."
        },
        {
          "s": 26,
          "text": "וזהו שכאו\"א מישראל,"
        },
        {
          "s": 27,
          "text": "גם קל שבקלים,"
        },
        {
          "s": 28,
          "text": "יכול למסור נפשו על קדה\"ש96,"
        },
        {
          "s": 29,
          "text": "כי כח המס\"נ הוא מצד העצם שלו בחי' יחידה97,"
        },
        {
          "s": 30,
          "text": "שלגבי בחינה זו אין שייך שום מנגד,"
        },
        {
          "s": 31,
          "text": "בבואה דבבואה לית להו98."
        },
        {
          "s": 32,
          "text": "[וזהו גם מה שהבטיחה תורה שסוף ישראל לעשות תשובה כו' ומיד הן נגאלין99,"
        },
        {
          "s": 33,
          "text": "שהכוונה ב\"סוף ישראל לעשות תשובה\" היא"
        },
        {
          "s": 34,
          "text": "(גם)"
        },
        {
          "s": 35,
          "text": "לכאו\"א מישראל100"
        },
        {
          "s": 36,
          "text": "– כי על בחינת היחידה שבכ\"א מישראל אין שייך שום מנגד ח\"ו אלא שהיא בהעלם,"
        },
        {
          "s": 37,
          "text": "ותורת אמת מבטיחה שסו\"ס תהי' בגילוי]."
        }
      ]
    }
  ]
}