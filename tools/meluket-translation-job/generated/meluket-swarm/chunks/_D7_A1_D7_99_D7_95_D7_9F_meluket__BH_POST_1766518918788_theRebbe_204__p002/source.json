{
  "globalIndex": 847,
  "owner": 47,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918788_theRebbe_204__p002",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918788_theRebbe_204__p002",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918788_theRebbe_204",
  "title": "מאמר אתה הראת לדעת תשמ\"ו",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה הובא לעיל,"
        },
        {
          "s": 2,
          "text": "שבגמרא הובא ע\"ז הכתוב"
        },
        {
          "s": 3,
          "text": "(שאמר דוד)"
        },
        {
          "s": 4,
          "text": "גשם נדבות תניף אלקים גו',"
        },
        {
          "s": 5,
          "text": "ולכאורה צריך להבין,"
        },
        {
          "s": 6,
          "text": "הרי בפסוק כתיב גשם נדבות,"
        },
        {
          "s": 7,
          "text": "גשם דייקא,"
        },
        {
          "s": 8,
          "text": "וא\"כ מהו שמסיים שהחזירה להם בטל תחי',"
        },
        {
          "s": 9,
          "text": "טל דייקא."
        },
        {
          "s": 10,
          "text": "ומבואר במ\"א20,"
        },
        {
          "s": 11,
          "text": "שבחי' גשם נדבות"
        },
        {
          "s": 12,
          "text": "(לא גשם סתם)"
        },
        {
          "s": 13,
          "text": "הוא ע\"ד ענין הטל."
        },
        {
          "s": 14,
          "text": "אך עדיין צריך להבין למה נק' בשם גשם דוקא."
        },
        {
          "s": 15,
          "text": "וביאור הענין יובן ע\"פ מה שמבאר כ\"ק אדמו\"ר האמצעי במאמרו ד\"ה ענין טל תורה21"
        },
        {
          "s": 16,
          "text": "(והוא המשך לד\"ה להבין ענין עומר שעורים ושתי הלחם שנת\"ל בד\"ה זה דערחה\"ש),"
        },
        {
          "s": 17,
          "text": "דהנה כתיב22"
        },
        {
          "s": 18,
          "text": "יערוף כמטר לקחי תיזל כטל אמרתי"
        },
        {
          "s": 19,
          "text": "(דכתוב זה קאי על התורה,"
        },
        {
          "s": 20,
          "text": "שהרי אמרו משה רבינו,"
        },
        {
          "s": 21,
          "text": "אשר משה קיבל תורה מסיני ומסרה כו'23,"
        },
        {
          "s": 22,
          "text": "ועד שהתורה נקראת על שמו24),"
        },
        {
          "s": 23,
          "text": "הרי יש בתורה ב' מדרגות בחי' טל ובחי' מטר."
        },
        {
          "s": 24,
          "text": "ומבאר בזה25,"
        },
        {
          "s": 25,
          "text": "דהנה ידוע שהמטר בא מסיבת האדים שעולים מן הארץ כו'"
        },
        {
          "s": 26,
          "text": "[וכמ\"ש26"
        },
        {
          "s": 27,
          "text": "ואד יעלה מן הארץ והשקה את כל פני האדמה,"
        },
        {
          "s": 28,
          "text": "שזהו הגשם המשקה את פני האדמה,"
        },
        {
          "s": 29,
          "text": "וכמ\"ש27"
        },
        {
          "s": 30,
          "text": "כי כאשר ירד הגשם גו' הרוה את הארץ והולידה והצמיחה גו'],"
        },
        {
          "s": 31,
          "text": "אבל הטל הוא היורד מלמעלה מעצמו כמאמר28"
        },
        {
          "s": 32,
          "text": "טל לא מיעצר."
        },
        {
          "s": 33,
          "text": "ועד\"ז יש ב' מיני המשכות והשפעות מלמעלה29,"
        },
        {
          "s": 34,
          "text": "הא' הנמשך מלמעלה למטה ע\"י אתעדל\"ת,"
        },
        {
          "s": 35,
          "text": "שזהו בחי' מטר,"
        },
        {
          "s": 36,
          "text": "כמו המטר הנמשך ע\"י האד העולה מן הארץ,"
        },
        {
          "s": 37,
          "text": "והיינו ע\"י יגיעה ועבודה מלמטה."
        },
        {
          "s": 38,
          "text": "וכמארז\"ל30"
        },
        {
          "s": 39,
          "text": "על הפסוק יערוף כמטר לקחי,"
        },
        {
          "s": 40,
          "text": "שברו הבריות את ערפן מיד מטר יורד."
        },
        {
          "s": 41,
          "text": "ובעבודת האדם הנה בחי' עורף הוא בחי' אחוריים"
        },
        {
          "s": 42,
          "text": "(היפך בחי' פנים)31,"
        },
        {
          "s": 43,
          "text": "אחרי ה\"א תלכו32,"
        },
        {
          "s": 44,
          "text": "ושברו הבריות ערפן הוא ביטול ענין זה"
        },
        {
          "s": 45,
          "text": "(דהעלם והסתר)"
        },
        {
          "s": 46,
          "text": "הבא ע\"י עבודה ויגיעה."
        },
        {
          "s": 47,
          "text": "ואין הכוונה בזה שבירת הגוף בפשטות ח\"ו,"
        },
        {
          "s": 48,
          "text": "אלא שהנשמה בגוף,"
        },
        {
          "s": 49,
          "text": "גוף בריא בכל רמ\"ח אברים ושס\"ה גידים,"
        },
        {
          "s": 50,
          "text": "והשבירה אינה אלא שבירת הלב בלבד"
        },
        {
          "s": 51,
          "text": "(ושבירת העורף,"
        },
        {
          "s": 52,
          "text": "ומה לי קטלא כולא מה לי קטלא פלגא33)."
        },
        {
          "s": 53,
          "text": "ואדרבה,"
        },
        {
          "s": 54,
          "text": "ע\"י שבירת הלב בא הגוף לשלימות יותר,"
        },
        {
          "s": 55,
          "text": "כפתגם הידוע שאין לך דבר שלם כלב נשבר34."
        },
        {
          "s": 56,
          "text": "ועי\"ז המטר יורד מלמעלה,"
        },
        {
          "s": 57,
          "text": "והמטר משקה את הארץ והולידה והצמיחה וכו'."
        },
        {
          "s": 58,
          "text": "וההמשכה הב' מלמעלה היא בחי' טל שנמשך מעצמו בלי אתעדל\"ת כלל וכמו הטל שיורד מעצמו,"
        },
        {
          "s": 59,
          "text": "כמאמר טל לא מיעצר"
        },
        {
          "s": 60,
          "text": "(כנ\"ל)."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וזהו יערוף כמטר לקחי תיזל כטל אמרתי,"
        },
        {
          "s": 2,
          "text": "דכשם שיש ב' בחי' אלו"
        },
        {
          "s": 3,
          "text": "(אתעדל\"ע הנמשכת ע\"י אתעדל\"ת ואתעדל\"ע שלמעלה מאתעדל\"ת)"
        },
        {
          "s": 4,
          "text": "בהשפעות אלקות בכלל,"
        },
        {
          "s": 5,
          "text": "כך ישנם ב' ענינים אלו בתורה"
        },
        {
          "s": 6,
          "text": "(לקחי ואמרתי)."
        },
        {
          "s": 7,
          "text": "דענין שפע האור דתורה הנק' מטר הוא בחי' חיצוניות שבתורה"
        },
        {
          "s": 8,
          "text": "(נגלה דתורה)"
        },
        {
          "s": 9,
          "text": "הנמשך ע\"י עבודת האדם ויגיעת האדם."
        },
        {
          "s": 10,
          "text": "וכמאמר35"
        },
        {
          "s": 11,
          "text": "יגעתי ומצאתי תאמן,"
        },
        {
          "s": 12,
          "text": "דמזה מובן,"
        },
        {
          "s": 13,
          "text": "שהמציאה נמדדת לפי ערך היגיעה."
        },
        {
          "s": 14,
          "text": "והגם שמבואר במ\"א36,"
        },
        {
          "s": 15,
          "text": "שענין מציאה אינו בערך להיגיעה"
        },
        {
          "s": 16,
          "text": "(כמו מציאה כפשוטה שהמוצא אותה אינו יודע ממי בא לו המציאה37,"
        },
        {
          "s": 17,
          "text": "ומוצא אותה בדרך ממילא38),"
        },
        {
          "s": 18,
          "text": "מ\"מ יש לזה איזה ערך ושייכות להיגיעה,"
        },
        {
          "s": 19,
          "text": "ואם מתייגע במקום שהמציאה אינה שם לא ימצא אותה,"
        },
        {
          "s": 20,
          "text": "וכמ\"ש39"
        },
        {
          "s": 21,
          "text": "ובקשתם משם גו',"
        },
        {
          "s": 22,
          "text": "ומבואר בלקו\"ת40"
        },
        {
          "s": 23,
          "text": "דמ\"ש משם דייקא הוא משום שאי אפשר למצוא אבידה כ\"א במקום שנאבדה."
        },
        {
          "s": 24,
          "text": "משא\"כ טל שבתורה הוא בחי' השפעה שנמשך מעצמו,"
        },
        {
          "s": 25,
          "text": "והוא בחי' טלא דבדולחא,"
        },
        {
          "s": 26,
          "text": "טלא דנטיף מעתיקא קדישא41,"
        },
        {
          "s": 27,
          "text": "שעתיד להחיות בו את המתים,"
        },
        {
          "s": 28,
          "text": "בחי' פנימיות התורה."
        },
        {
          "s": 29,
          "text": "ולכן נאמר בו תיזל כטל,"
        },
        {
          "s": 30,
          "text": "דענין תיזל הוא מלשון נוזל,"
        },
        {
          "s": 31,
          "text": "היינו שנמשך ויורד למטה מטה כמו שהוא במקורו ושרשו בבחי' המזל."
        },
        {
          "s": 32,
          "text": "וגילוי בחי' טל תורה יהי' לע\"ל,"
        },
        {
          "s": 33,
          "text": "כמבואר בהמשך הדרוש שם שזהו משארז\"ל כל העוסק בתורה טל תורה מחייהו,"
        },
        {
          "s": 34,
          "text": "שע\"י העסק בתורה בנגלה בזמן הזה יומשך לע\"ל בחי' טל תורה42,"
        },
        {
          "s": 35,
          "text": "פנימיות התורה."
        },
        {
          "s": 36,
          "text": "[וכמבואר גם במ\"א43"
        },
        {
          "s": 37,
          "text": "במשארז\"ל44"
        },
        {
          "s": 38,
          "text": "אשרי מי שבא לכאן ותלמודו בידו,"
        },
        {
          "s": 39,
          "text": "שע\"י לימוד נגלה דתורה"
        },
        {
          "s": 40,
          "text": "(תלמודו)"
        },
        {
          "s": 41,
          "text": "בזמן הזה זוכים לגילוי סודות התורה דלע\"ל]."
        },
        {
          "s": 42,
          "text": "וזה גם מ\"ש45"
        },
        {
          "s": 43,
          "text": "תורה חדשה מאתי תצא."
        },
        {
          "s": 44,
          "text": "שגילוי בחי' תורה חדשה"
        },
        {
          "s": 45,
          "text": "(טל שבתורה)"
        },
        {
          "s": 46,
          "text": "יהי' לע\"ל דוקא."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ובזה יובן גם זה שבחי' טל זה הוא טל שעתיד להחיות בו את המתים,"
        },
        {
          "s": 2,
          "text": "כי החידוש דתחיית המתים הוא שנמשך מבחינת אתעדל\"ע שלמעלה מאתעדל\"ת."
        },
        {
          "s": 3,
          "text": "וכמבואר בכמה דרושים46"
        },
        {
          "s": 4,
          "text": "החידוש והשינוי דתחיית המתים לגבי גן עדן."
        },
        {
          "s": 5,
          "text": "דהנה תחיית המתים היא למעלה מג\"ע,"
        },
        {
          "s": 6,
          "text": "כדמוכח מנוסח ברכת יוצר"
        },
        {
          "s": 7,
          "text": "(דשבת)"
        },
        {
          "s": 8,
          "text": "אין ערוך כו' ואין זולתך מלכנו לחיי העולם הבא"
        },
        {
          "s": 9,
          "text": "(ג\"ע)"
        },
        {
          "s": 10,
          "text": "כו'"
        },
        {
          "s": 11,
          "text": "(ואח\"כ)"
        },
        {
          "s": 12,
          "text": "ואין דומה לך מושיענו לתחיית המתים,"
        },
        {
          "s": 13,
          "text": "ואעפ\"כ הנה בנוגע לג\"ע צ\"ל עבודת האדם,"
        },
        {
          "s": 14,
          "text": "הן העבודה לפני זה"
        },
        {
          "s": 15,
          "text": "(בתור הכנה לג\"ע)"
        },
        {
          "s": 16,
          "text": "והן העבודה בג\"ע עצמו,"
        },
        {
          "s": 17,
          "text": "שזהו ענין העליות שבג\"ע מדרגא לדרגא ע\"י העמוד שבין ג\"ע לג\"ע וכו'47,"
        },
        {
          "s": 18,
          "text": "ולא זו בלבד,"
        },
        {
          "s": 19,
          "text": "אלא שלא כל אדם זוכה לג\"ע"
        },
        {
          "s": 20,
          "text": "(כמובא הלשון בכ\"מ47)"
        },
        {
          "s": 21,
          "text": "(העליון)"
        },
        {
          "s": 22,
          "text": "משום שהוא תלוי בעבודה,"
        },
        {
          "s": 23,
          "text": "משא\"כ בנוגע לתחיית המתים תנן48"
        },
        {
          "s": 24,
          "text": "כל ישראל יש להם חלק לעוה\"ב,"
        },
        {
          "s": 25,
          "text": "ואף שאיתא בהמשך המשנה חוץ כו',"
        },
        {
          "s": 26,
          "text": "מ\"מ מבואר בירושלמי49,"
        },
        {
          "s": 27,
          "text": "שע\"י הבירור והזיכוך שלאח\"ז גם הם ישובו לתחי'."
        },
        {
          "s": 28,
          "text": "ומבואר הטעם בזה46,"
        },
        {
          "s": 29,
          "text": "משום שגילוי האלקות שבג\"ע שרשו הוא מבחי' אתעדל\"ע שנמשכת ע\"י אתעדל\"ת,"
        },
        {
          "s": 30,
          "text": "ממכ\"ע,"
        },
        {
          "s": 31,
          "text": "ולכן ה\"ה תלוי בעבודת האדם,"
        },
        {
          "s": 32,
          "text": "משא\"כ הגילוי דתחה\"מ הוא סוכ\"ע,"
        },
        {
          "s": 33,
          "text": "אתעדל\"ע שלמעלה מאתעדל\"ת,"
        },
        {
          "s": 34,
          "text": "ולכן אינו תלוי בעבודת האדם אלא כל ישראל יש להם חלק לעוה\"ב."
        },
        {
          "s": 35,
          "text": "וזהו ענין טל תחי',"
        },
        {
          "s": 36,
          "text": "כמשנת\"ל,"
        },
        {
          "s": 37,
          "text": "שבחי' טל הוא בחי' שנמשך מעצמו בלי שום אתעדל\"ת."
        }
      ]
    }
  ]
}