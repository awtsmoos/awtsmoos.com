{
  "globalIndex": 1027,
  "owner": 27,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919837_theRebbe_328__p005",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919837_theRebbe_328__p005",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919837_theRebbe_328",
  "title": "מאמר לא היו ימים טובים לישראל תשמ\"ז",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וזהו שבחמשה עשר באב היו1"
        },
        {
          "s": 2,
          "text": "בנות ירושלים"
        },
        {
          "s": 3,
          "text": "[ויש גורסין52"
        },
        {
          "s": 4,
          "text": "– בנות ישראל]"
        },
        {
          "s": 5,
          "text": "יוצאות וחולות בכרמים,"
        },
        {
          "s": 6,
          "text": "שהמחול דחמשה עשר באב הוא בדוגמת ומעין המחול דלע\"ל53"
        },
        {
          "s": 7,
          "text": "שעתיד54"
        },
        {
          "s": 8,
          "text": "הקב\"ה לעשות מחול לצדיקים וכאו\"א מראה באצבעו ואומר55"
        },
        {
          "s": 9,
          "text": "הנה56"
        },
        {
          "s": 10,
          "text": "אלקינו זה קוינו לו ויושיענו זה ה' קוינו לו נגילה ונשמחה בישועתו,"
        },
        {
          "s": 11,
          "text": "דביציאת מצרים אמרו \"זה\" פעם אחת"
        },
        {
          "s": 12,
          "text": "(זה א-לי ואנוהו57)"
        },
        {
          "s": 13,
          "text": "ולע\"ל יאמרו שני פעמים זה58"
        },
        {
          "s": 14,
          "text": "(הנה אלקינו זה גו' זה הוי' גו')."
        },
        {
          "s": 15,
          "text": "דביציאת מצרים שהיו אז במדריגת צדיקים אמרו זה רק פעם אחת – גילוי הוי' דז\"א,"
        },
        {
          "s": 16,
          "text": "ולע\"ל,"
        },
        {
          "s": 17,
          "text": "שיהיו במדריגת בעלי תשובה"
        },
        {
          "s": 18,
          "text": "[דתשובה היא כפלים לתושי'59]"
        },
        {
          "s": 19,
          "text": "יאמרו שני פעמים זה – גילוי הוי' דז\"א וגילוי הוי' דעתיק60."
        },
        {
          "s": 20,
          "text": "וממשיך בכתוב נגילה ונשמחה בישועתו,"
        },
        {
          "s": 21,
          "text": "דיש לומר,"
        },
        {
          "s": 22,
          "text": "שישועתו"
        },
        {
          "s": 23,
          "text": "(דהקב\"ה)"
        },
        {
          "s": 24,
          "text": "שלאחרי \"זה\" השני,"
        },
        {
          "s": 25,
          "text": "הוא פנימיות עתיק."
        },
        {
          "s": 26,
          "text": "וכידוע61"
        },
        {
          "s": 27,
          "text": "שלע\"ל יהי'"
        },
        {
          "s": 28,
          "text": "(גם)"
        },
        {
          "s": 29,
          "text": "הגילוי דפנימיות עתיק."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ויהי רצון,"
        },
        {
          "s": 1,
          "text": "שכל ענינים אלו יהיו בקרוב ממש,"
        },
        {
          "s": 2,
          "text": "ובפרט לאחרי שאמרו בההפטורה דמנחת ת\"ב קרובה ישועתי לבוא62,"
        },
        {
          "s": 3,
          "text": "שישועתי"
        },
        {
          "s": 4,
          "text": "(דהקב\"ה),"
        },
        {
          "s": 5,
          "text": "הישועה שעלי' נאמר נגילה ונשמחה בישועתו,"
        },
        {
          "s": 6,
          "text": "היא קרובה לבוא בקרוב ממש ובעגלא דידן,"
        },
        {
          "s": 7,
          "text": "אמן63"
        },
        {
          "s": 8,
          "text": "כן יהי רצון."
        }
      ]
    }
  ]
}