{
  "globalIndex": 1093,
  "owner": 43,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920368_theRebbe_469__p001",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920368_theRebbe_469__p001",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920368_theRebbe_469",
  "title": "מאמר השקיפה ממעון קדשך תשכ\"ז",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ תבוא,"
        },
        {
          "s": 2,
          "text": "ח\"י אלול ה'תשכ\"ז"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "השקיפה ממעון קדשך מן השמים וברך את עמך את ישראל1,"
        },
        {
          "s": 1,
          "text": "ומדייק כ\"ק מו\"ח אדמו\"ר במאמרו ד\"ה זה2"
        },
        {
          "s": 2,
          "text": "[שאמרו בח\"י אלול הראשון בבואו לארה\"ב בפעם השני' ע\"מ לדור,"
        },
        {
          "s": 3,
          "text": "והקביעות דח\"י אלול אז היתה בש\"פ תבוא,"
        },
        {
          "s": 4,
          "text": "כבשנה זו]"
        },
        {
          "s": 5,
          "text": "מה שאומר את עמך את ישראל,"
        },
        {
          "s": 6,
          "text": "הרי עם ה'"
        },
        {
          "s": 7,
          "text": "(עמך)"
        },
        {
          "s": 8,
          "text": "הם ישראל וישראל הם עם ה',"
        },
        {
          "s": 9,
          "text": "ולמה מפרט שניהם."
        },
        {
          "s": 10,
          "text": "כן צ\"ע,"
        },
        {
          "s": 11,
          "text": "דמזה שאומר את עמך את ישראל"
        },
        {
          "s": 12,
          "text": "(ולא את עמך ישראל),"
        },
        {
          "s": 13,
          "text": "משמע שעמך וישראל"
        },
        {
          "s": 14,
          "text": "(בפסוק זה)"
        },
        {
          "s": 15,
          "text": "הם שני ענינים."
        },
        {
          "s": 16,
          "text": "וצריך להבין"
        },
        {
          "s": 17,
          "text": "(כמו שמדייק בהמאמר),"
        },
        {
          "s": 18,
          "text": "הרי הענין דישראל הוא למעלה מהענין דעמך"
        },
        {
          "s": 19,
          "text": "[וכמובן גם מזה דשם עם מורה"
        },
        {
          "s": 20,
          "text": "(לפעמים)"
        },
        {
          "s": 21,
          "text": "על היפך השבח3,"
        },
        {
          "s": 22,
          "text": "ושם ישראל הוא על שם כי שרית עם אלקים ועם אנשים ותוכל4],"
        },
        {
          "s": 23,
          "text": "וכאן מקדים עמך לישראל."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "דהמבואר בהמאמר,"
        },
        {
          "s": 3,
          "text": "דמזה שאומר את עמך את ישראל משמע שהם שני ענינים,"
        },
        {
          "s": 4,
          "text": "מיוסד על מה שאמרו רז\"ל5"
        },
        {
          "s": 5,
          "text": "עה\"פ6"
        },
        {
          "s": 6,
          "text": "על שאול ועל יהונתן בנו ועל עם ה' ועל בית ישראל,"
        },
        {
          "s": 7,
          "text": "על על הפסיק הענין7."
        },
        {
          "s": 8,
          "text": "ועפ\"ז יש להוסיף,"
        },
        {
          "s": 9,
          "text": "שמהיתור דאת למדין לא רק שעמך וישראל הם שני ענינים8,"
        },
        {
          "s": 10,
          "text": "אלא שגם בוברך את עמך את ישראל שני ענינים,"
        },
        {
          "s": 11,
          "text": "ברכה לעמך וברכה לישראל9."
        },
        {
          "s": 12,
          "text": "וצריך להבין החילוק שבין ב' הברכות,"
        },
        {
          "s": 13,
          "text": "ושהברכה לעמך היא קודמת להברכה לישראל."
        }
      ]
    }
  ]
}