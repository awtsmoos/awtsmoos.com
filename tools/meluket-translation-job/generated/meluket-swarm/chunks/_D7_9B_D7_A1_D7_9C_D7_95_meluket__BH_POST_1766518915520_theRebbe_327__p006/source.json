{
  "globalIndex": 308,
  "owner": 8,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915520_theRebbe_327__p006",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915520_theRebbe_327__p006",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915520_theRebbe_327",
  "title": "מאמר מרגלא בפומיה דרבא תש\"מ",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "והנה ידוע שכל הענינים שבדרושי רבותינו נשיאינו,"
        },
        {
          "s": 2,
          "text": "כולל גם זמן אמירתם,"
        },
        {
          "s": 3,
          "text": "הם בתכלית הדיוק."
        },
        {
          "s": 4,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 5,
          "text": "דמהטעמים שדרוש זה אמרו כ\"ק מו\"ח אדמו\"ר בש\"פ וישלח,"
        },
        {
          "s": 6,
          "text": "השבת שלפני י\"ט כסלו,"
        },
        {
          "s": 7,
          "text": "הוא,"
        },
        {
          "s": 8,
          "text": "כי ענין הנ\"ל מרומז בהפסוק45"
        },
        {
          "s": 9,
          "text": "פדה בשלום נפשי גו' השייך לי\"ט כסלו46,"
        },
        {
          "s": 10,
          "text": "ובהפסוק קטונתי מכל החסדים ומכל האמת גו' שבפרשת וישלח47"
        },
        {
          "s": 11,
          "text": "וגם שייך להגאולה די\"ט כסלו48."
        },
        {
          "s": 12,
          "text": "והענין הוא,"
        },
        {
          "s": 13,
          "text": "דג' הענינים שבמארז\"ל הנ\"ל"
        },
        {
          "s": 14,
          "text": "[חכמה,"
        },
        {
          "s": 15,
          "text": "תשובה ומעשים טובים]"
        },
        {
          "s": 16,
          "text": "שייכים לג' העמודים49"
        },
        {
          "s": 17,
          "text": "דתורה עבודה וגמ\"ח."
        },
        {
          "s": 18,
          "text": "חכמה – תורה,"
        },
        {
          "s": 19,
          "text": "תשובה – עבודה,"
        },
        {
          "s": 20,
          "text": "כי תפלה"
        },
        {
          "s": 21,
          "text": "(עבודה50)"
        },
        {
          "s": 22,
          "text": "הו\"ע הביטול,"
        },
        {
          "s": 23,
          "text": "שהאדם המתפלל הוא כעבד בפני רבו51,"
        },
        {
          "s": 24,
          "text": "ומעשים טובים – גמילות חסדים,"
        },
        {
          "s": 25,
          "text": "דגמ\"ח הוא כללות כל המצוות52."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "והנה דרז\"ל53"
        },
        {
          "s": 1,
          "text": "פדה בשלום נפשי גו',"
        },
        {
          "s": 2,
          "text": "כל העוסק בתורה ובגמ\"ח ומתפלל עם הצבור כו' כאילו פדאני לי ולבני מבין האומות,"
        },
        {
          "s": 3,
          "text": "שהפדי' היא ע\"י ג' הענינים דתורה גמ\"ח ותפלה"
        },
        {
          "s": 4,
          "text": "(בצבור)."
        },
        {
          "s": 5,
          "text": "ועד\"ז הוא בהפסוק קטונתי מכל החסדים ומכל האמת,"
        },
        {
          "s": 6,
          "text": "דחסדים לשון רבים הם ב' הקוין דגמ\"ח ותפלה."
        },
        {
          "s": 7,
          "text": "וכידוע54"
        },
        {
          "s": 8,
          "text": "שתפלה היא בכלל גמ\"ח."
        },
        {
          "s": 9,
          "text": "[ונאמר החסדים לשון רבים,"
        },
        {
          "s": 10,
          "text": "כי החסד דגמ\"ח"
        },
        {
          "s": 11,
          "text": "(מצוות)"
        },
        {
          "s": 12,
          "text": "והחסד דתפלה,"
        },
        {
          "s": 13,
          "text": "הם שני חסדים."
        },
        {
          "s": 14,
          "text": "ובפרט לפי הידוע55"
        },
        {
          "s": 15,
          "text": "שתפלה היא בקו הגבורה,"
        },
        {
          "s": 16,
          "text": "העלאה מלמטה למעלה."
        },
        {
          "s": 17,
          "text": "דמזה מובן,"
        },
        {
          "s": 18,
          "text": "שהחסד שבתפלה אינו כהחסד שבגמ\"ח]."
        },
        {
          "s": 19,
          "text": "ואמת הוא תורה,"
        },
        {
          "s": 20,
          "text": "אין אמת אלא תורה56."
        },
        {
          "s": 21,
          "text": "ואומר קטונתי מכל החסדים ומכל האמת,"
        },
        {
          "s": 22,
          "text": "דענין הביטול"
        },
        {
          "s": 23,
          "text": "(קטונתי)"
        },
        {
          "s": 24,
          "text": "הוא לא רק מכל החסדים,"
        },
        {
          "s": 25,
          "text": "הקוין דתפלה וגמ\"ח"
        },
        {
          "s": 26,
          "text": "(תשובה ומעשים טובים),"
        },
        {
          "s": 27,
          "text": "אלא גם מכל האמת,"
        },
        {
          "s": 28,
          "text": "תורה"
        },
        {
          "s": 29,
          "text": "(חכמה)."
        },
        {
          "s": 30,
          "text": "ועד\"ז הוא במארז\"ל עה\"פ פדה בשלום נפשי,"
        },
        {
          "s": 31,
          "text": "שהדיוק הוא כל העוסק בתורה"
        },
        {
          "s": 32,
          "text": "(ולא הלומד תורה)."
        },
        {
          "s": 33,
          "text": "דענין עוסק בתורה הוא"
        },
        {
          "s": 34,
          "text": "(כמו שמבאר כ\"ק מו\"ח אדמו\"ר57),"
        },
        {
          "s": 35,
          "text": "שנוסף על זה שהוא לומד לעצמו,"
        },
        {
          "s": 36,
          "text": "הוא משתדל בכל מיני השתדלות להביא את הרבים לידי לימוד התורה."
        },
        {
          "s": 37,
          "text": "דזה שאינו מסתפק בזה שהוא עצמו לומד ומשתדל להביא את הרבים ללימוד התורה,"
        },
        {
          "s": 38,
          "text": "ובפרט כשנותן על זה מזמנו שהי' יכול ללמוד לעצמו,"
        },
        {
          "s": 39,
          "text": "הוא מצד הביטול שלו לתורה."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "והנה נתבאר לעיל"
        },
        {
          "s": 2,
          "text": "(סעיף ז),"
        },
        {
          "s": 3,
          "text": "שהחיבור דשני הענינים דבן ועבד הוא ע\"י גילוי עצם הנשמה כמו שמושרשת בהעצמות,"
        },
        {
          "s": 4,
          "text": "דבעצם הנשמה שני הענינים דבן ועבד הם כולא חד."
        },
        {
          "s": 5,
          "text": "ועפ\"ז יש לבאר הסדר דמרז\"ל הנ\"ל"
        },
        {
          "s": 6,
          "text": "(כל העוסק בתורה ובגמ\"ח ומתפלל עם הצבור),"
        },
        {
          "s": 7,
          "text": "שמקדים תורה לגמ\"ח ותפלה,"
        },
        {
          "s": 8,
          "text": "הגם שבסדר עבודת האדם בכלל לימוד התורה הוא"
        },
        {
          "s": 9,
          "text": "(בעיקר)"
        },
        {
          "s": 10,
          "text": "לאחרי התפלה58"
        },
        {
          "s": 11,
          "text": "[שבאה לאחרי קדימת גמ\"ח,"
        },
        {
          "s": 12,
          "text": "כמרז\"ל59"
        },
        {
          "s": 13,
          "text": "יהיב פרוטה לעני והדר מצלי],"
        },
        {
          "s": 14,
          "text": "כי אמיתית הענין דפדה בשלום נפשי הוא ע\"י גילוי היחידה60."
        },
        {
          "s": 15,
          "text": "ועד\"ז הוא בנוגע להענין דפדאני לי ולבני מבין האומות,"
        },
        {
          "s": 16,
          "text": "דזה שענין זה יהי' בביאת המשיח דוקא הוא לפי שמשיח הוא היחידה דכללות ההשתלשלות61."
        },
        {
          "s": 17,
          "text": "ויש לומר,"
        },
        {
          "s": 18,
          "text": "דהכוונה כאן ביחידה היא"
        },
        {
          "s": 19,
          "text": "(לא רק לדרגא הפרטית דיחידה,"
        },
        {
          "s": 20,
          "text": "אלא גם)"
        },
        {
          "s": 21,
          "text": "לעצם הנשמה."
        },
        {
          "s": 22,
          "text": "ולכן מקדים תורה לגמ\"ח ותפלה,"
        },
        {
          "s": 23,
          "text": "כי הגילוי דעצם הנשמה הוא ע\"י העוסק בתורה"
        },
        {
          "s": 24,
          "text": "[דזה שתורה"
        },
        {
          "s": 25,
          "text": "(בן)"
        },
        {
          "s": 26,
          "text": "היא באופן דעוסק"
        },
        {
          "s": 27,
          "text": "(עבד)"
        },
        {
          "s": 28,
          "text": "הוא מצד עצם הנשמה],"
        },
        {
          "s": 29,
          "text": "ולכן,"
        },
        {
          "s": 30,
          "text": "ענין זה הוא ההכנה העיקרית לביאת המשיח,"
        },
        {
          "s": 31,
          "text": "היחידה דכללות ההשתלשלות."
        }
      ]
    }
  ]
}