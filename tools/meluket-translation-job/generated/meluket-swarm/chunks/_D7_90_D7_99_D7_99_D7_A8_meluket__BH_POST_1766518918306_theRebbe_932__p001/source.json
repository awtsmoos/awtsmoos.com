{
  "globalIndex": 765,
  "owner": 15,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918306_theRebbe_932__p001",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918306_theRebbe_932__p001",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918306_theRebbe_932",
  "title": "מאמר השמים כסאי תשל\"ו",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ קדושים,"
        },
        {
          "s": 2,
          "text": "ב' דר\"ח אייר ה'תשל\"ו*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "השמים כסאי והארץ הדום רגלי,"
        },
        {
          "s": 1,
          "text": "אי זה בית אשר תבנו לי גו' ואל זה אביט אל עני ונכה רוח גו'1,"
        },
        {
          "s": 2,
          "text": "וידוע הדיוק בזה2,"
        },
        {
          "s": 3,
          "text": "הרי אין לו דמות הגוף3"
        },
        {
          "s": 4,
          "text": "ואיך שייך לומר כסאי והדום רגלי."
        },
        {
          "s": 5,
          "text": "וגם צ\"ל מ\"ש איזה בית אשר תבנו לי גו' ואל זה אביט אל עני ונכה רוח גו',"
        },
        {
          "s": 6,
          "text": "מהי המעלה דעני ונכה רוח,"
        },
        {
          "s": 7,
          "text": "דהגם שאיזה בית אשר תבנו לי,"
        },
        {
          "s": 8,
          "text": "מ\"מ אל זה"
        },
        {
          "s": 9,
          "text": "(לעני ונכה רוח)"
        },
        {
          "s": 10,
          "text": "אביט."
        },
        {
          "s": 11,
          "text": "ונקודת הביאור בזה,"
        },
        {
          "s": 12,
          "text": "דשמים וארץ הם תורה ומצוות"
        },
        {
          "s": 13,
          "text": "(כמבואר בארוכה בתו\"א4),"
        },
        {
          "s": 14,
          "text": "שבכללות היא העבודה דנר\"נ5."
        },
        {
          "s": 15,
          "text": "ובית היא העבודה דבכל מאדך6"
        },
        {
          "s": 16,
          "text": "שלמעלה מהגבלה7,"
        },
        {
          "s": 17,
          "text": "שמצד חי' יחידה5."
        },
        {
          "s": 18,
          "text": "ופירוש איזה בית אשר תבנו לי הוא8,"
        },
        {
          "s": 19,
          "text": "שגם העבודה שמצד המקיפים חי' יחידה,"
        },
        {
          "s": 20,
          "text": "שעל ידה נמשכים המקיפים שלמעלה,"
        },
        {
          "s": 21,
          "text": "אין זה בית אשר תבנו לי"
        },
        {
          "s": 22,
          "text": "(לי לעצמותי),"
        },
        {
          "s": 23,
          "text": "כי גם המקיפים הכי עליונים הם הארה בלבד."
        },
        {
          "s": 24,
          "text": "אל זה אביט אל עני ונכה רוח9,"
        },
        {
          "s": 25,
          "text": "דע\"י הביטול"
        },
        {
          "s": 26,
          "text": "(עני ונכה רוח)"
        },
        {
          "s": 27,
          "text": "הוא המשכת העצמות"
        },
        {
          "s": 28,
          "text": "(אל זה אביט)."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "שזהו גם הקשר והשייכות דההפטורה השמים כסאי לשבת ר\"ח,"
        },
        {
          "s": 3,
          "text": "כי בר\"ח הוא מולד הלבנה,"
        },
        {
          "s": 4,
          "text": "שאז"
        },
        {
          "s": 5,
          "text": "(בעת המולד)"
        },
        {
          "s": 6,
          "text": "היא נקודה בלבד,"
        },
        {
          "s": 7,
          "text": "שזה מורה על הביטול שלה10,"
        },
        {
          "s": 8,
          "text": "שלית לה מגרמה כלום11."
        },
        {
          "s": 9,
          "text": "ויתירה מזו,"
        },
        {
          "s": 10,
          "text": "שברגע שלפני מולד הלבנה היא בביטול לגמרי,"
        },
        {
          "s": 11,
          "text": "שאינה אפילו כנקודה,"
        },
        {
          "s": 12,
          "text": "ועי\"ז דוקא נעשה המולד שלה12."
        },
        {
          "s": 13,
          "text": "וע\"י הביטול שלה,"
        },
        {
          "s": 14,
          "text": "היא מקבלת אור חדש מהשמש,"
        },
        {
          "s": 15,
          "text": "דשרש המשכת אור זה הוא לא מהשמש עצמו"
        },
        {
          "s": 16,
          "text": "(שהרי אין כל חדש תחת השמש13)"
        },
        {
          "s": 17,
          "text": "אלא מלעילא14"
        },
        {
          "s": 18,
          "text": "מן שמשא15."
        },
        {
          "s": 19,
          "text": "וזהו שבשבת ר\"ח מפטירין השמים כסאי גו' ואל זה אביט אל עני ונכה רוח גו',"
        },
        {
          "s": 20,
          "text": "דההמשכה שע\"י הביטול16"
        },
        {
          "s": 21,
          "text": "היא המשכה נעלית ביותר,"
        },
        {
          "s": 22,
          "text": "כנ\"ל."
        }
      ]
    }
  ]
}