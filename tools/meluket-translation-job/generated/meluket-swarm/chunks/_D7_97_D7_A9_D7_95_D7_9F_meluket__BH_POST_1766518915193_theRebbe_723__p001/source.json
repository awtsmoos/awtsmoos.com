{
  "globalIndex": 236,
  "owner": 36,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915193_theRebbe_723__p001",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915193_theRebbe_723__p001",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518915193_theRebbe_723",
  "title": "מאמר ויאמר לו יהונתן תשמ\"ה",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ תולדות,"
        },
        {
          "s": 2,
          "text": "מבה\"ח וער\"ח כסלו ה'תשמ\"ה"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "ויאמר לו יהונתן מחר חודש ונפקדת כי יפקד מושבך1,"
        },
        {
          "s": 1,
          "text": "ומבאר הצ\"צ במאמרו ד\"ה זה2,"
        },
        {
          "s": 2,
          "text": "שדוד3"
        },
        {
          "s": 3,
          "text": "הוא בחינת מלכות,"
        },
        {
          "s": 4,
          "text": "הכוללת את כל נשמות ישראל,"
        },
        {
          "s": 5,
          "text": "דכל ישראל בני מלכים הם4."
        },
        {
          "s": 6,
          "text": "וענין ונפקדת כי יפקד מושבך הוא,"
        },
        {
          "s": 7,
          "text": "דע\"י שיפקד"
        },
        {
          "s": 8,
          "text": "(יחסר5)"
        },
        {
          "s": 9,
          "text": "מקום מושבך,"
        },
        {
          "s": 10,
          "text": "ביטול,"
        },
        {
          "s": 11,
          "text": "עי\"ז יהי' ונפקדת,"
        },
        {
          "s": 12,
          "text": "המשכת הזכרון5"
        },
        {
          "s": 13,
          "text": "דלמעלה."
        },
        {
          "s": 14,
          "text": "דזכרון הוא בחינה נעלית ביותר"
        },
        {
          "s": 15,
          "text": "(כדלקמן)."
        },
        {
          "s": 16,
          "text": "וזהו הקשר דונפקדת כי יפקד מושבך עם מחר חודש,"
        },
        {
          "s": 17,
          "text": "כי בערב ר\"ח הוא העלם והסתר הלבנה,"
        },
        {
          "s": 18,
          "text": "ועד שברגע שלפני המולד לא נשאר ממנה גם נקודה,"
        },
        {
          "s": 19,
          "text": "ועי\"ז נעשה אח\"כ"
        },
        {
          "s": 20,
          "text": "(מחר)"
        },
        {
          "s": 21,
          "text": "חודש,"
        },
        {
          "s": 22,
          "text": "מולד הלבנה מחדש,"
        },
        {
          "s": 23,
          "text": "המשכת אור חדש מהשמש ללבנה6,"
        },
        {
          "s": 24,
          "text": "שלא האיר בה מקודם."
        },
        {
          "s": 25,
          "text": "וכמו\"כ הוא בישראל שדומין ללבנה7,"
        },
        {
          "s": 26,
          "text": "דע\"י הביטול שלהם,"
        },
        {
          "s": 27,
          "text": "נמשך בהם אור נעלה ביותר,"
        },
        {
          "s": 28,
          "text": "אור חדש."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דזה שהמשכת האור חדש נק' ונפקדת,"
        },
        {
          "s": 2,
          "text": "זכרון8,"
        },
        {
          "s": 3,
          "text": "הוא,"
        },
        {
          "s": 4,
          "text": "כי המשכת האור השייך לעולמות"
        },
        {
          "s": 5,
          "text": "(גם האור שלמעלה מעולמות אבל שייך לעולמות)"
        },
        {
          "s": 6,
          "text": "אינו חידוש אמיתי,"
        },
        {
          "s": 7,
          "text": "ואור חדש הוא אור א\"ס שלמעלה משייכות לעולמות9."
        },
        {
          "s": 8,
          "text": "וזהו שהמשכת אור זה נק' ונפקדת,"
        },
        {
          "s": 9,
          "text": "כי הזכרון הוא באוא\"ס שלמעלה משייכות לעולמות."
        },
        {
          "s": 10,
          "text": "וכמבואר במק\"א10,"
        },
        {
          "s": 11,
          "text": "דכמו שבאדם ענין הזכרון אינו שייך אלא בדבר שאינו נחשב בעיניו"
        },
        {
          "s": 12,
          "text": "(ועד שבנקל לשכוח עליו),"
        },
        {
          "s": 13,
          "text": "עד\"ז הוא למעלה,"
        },
        {
          "s": 14,
          "text": "דענין הזכרון הוא באוא\"ס שלמעלה משייכות לעולמות,"
        },
        {
          "s": 15,
          "text": "דכולא קמי' כלא חשיב."
        },
        {
          "s": 16,
          "text": "וזהו ונפקדת כי יפקד מושבך,"
        },
        {
          "s": 17,
          "text": "דהמשכת האור שלמעלה משייכות לעולמות"
        },
        {
          "s": 18,
          "text": "(ונפקדת)"
        },
        {
          "s": 19,
          "text": "היא דוקא ע\"י הביטול"
        },
        {
          "s": 20,
          "text": "(יפקד מושבך)."
        },
        {
          "s": 21,
          "text": "דכשעבודת האדם קשורה עם המציאות שלו"
        },
        {
          "s": 22,
          "text": "(מציאות דקדושה),"
        },
        {
          "s": 23,
          "text": "ההמשכה שנמשכת ע\"י העבודה היא מבחינת אור השייך לעולמות"
        },
        {
          "s": 24,
          "text": "(מציאות),"
        },
        {
          "s": 25,
          "text": "ובכדי שתהי' המשכת האור שלמעלה משייכות לעולמות,"
        },
        {
          "s": 26,
          "text": "דכולא קמי' כלא חשיב,"
        },
        {
          "s": 27,
          "text": "הוא ע\"י הביטול,"
        },
        {
          "s": 28,
          "text": "יפקד מושבך."
        }
      ]
    }
  ]
}