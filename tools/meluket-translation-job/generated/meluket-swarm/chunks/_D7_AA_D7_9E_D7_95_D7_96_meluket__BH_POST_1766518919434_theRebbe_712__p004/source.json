{
  "globalIndex": 962,
  "owner": 12,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919434_theRebbe_712__p004",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919434_theRebbe_712__p004",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919434_theRebbe_712",
  "title": "מאמר וחזקת והיית לאיש תשכ\"ח",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ויובן זה ע\"פ הידוע41"
        },
        {
          "s": 1,
          "text": "דהטעם על זה שהמשכת הקו מסתיימת באצילות הוא כי הכוונה בהמשכת הקו היא שהאור יהי' בהתלבשות,"
        },
        {
          "s": 2,
          "text": "והתלבשות האור יכולה להיות רק בהענינים"
        },
        {
          "s": 3,
          "text": "(כלים ועולמות)"
        },
        {
          "s": 4,
          "text": "שהם אלקות."
        },
        {
          "s": 5,
          "text": "ובכדי שתהי' המשכת וגילוי הקו בבי\"ע הוא ע\"י המשכת אור הסובב,"
        },
        {
          "s": 6,
          "text": "שבכללות הוא האור שלפני הצמצום,"
        },
        {
          "s": 7,
          "text": "ובהאור שלפני הצמצום גופא – אור הבל\"ג"
        },
        {
          "s": 8,
          "text": "(שלמעלה מהאור שלהאיר העולמות)."
        },
        {
          "s": 9,
          "text": "וי\"ל הביאור בזה,"
        },
        {
          "s": 10,
          "text": "כי אור הבל\"ג,"
        },
        {
          "s": 11,
          "text": "מכיון שלגבי' אין הצמצום מסתיר,"
        },
        {
          "s": 12,
          "text": "הוא מאיר בגילוי"
        },
        {
          "s": 13,
          "text": "(גם לאחרי הצמצום)"
        },
        {
          "s": 14,
          "text": "בכל מקום,"
        },
        {
          "s": 15,
          "text": "גם בבי\"ע,"
        },
        {
          "s": 16,
          "text": "אלא שזהו רק בידיעתו ית' ובהעולמות אין זה נרגש"
        },
        {
          "s": 17,
          "text": "(כנ\"ל סעיף ג),"
        },
        {
          "s": 18,
          "text": "וע\"י שמאיר בהקו מהאור שלפני הצמצום,"
        },
        {
          "s": 19,
          "text": "נעשה גם הקו באופן כזה,"
        },
        {
          "s": 20,
          "text": "שהוא נמשך ומתגלה גם בבי\"ע."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש לבאר ההפרש בין הבקיעה דיעקב אותיות יבקע"
        },
        {
          "s": 1,
          "text": "(כמו שהוא מצד עצמו)"
        },
        {
          "s": 2,
          "text": "להבקיעה דיעקב אותיות יבקע כמו שנתגלה ע\"י יוסף,"
        },
        {
          "s": 3,
          "text": "שהבקיעה דיעקב"
        },
        {
          "s": 4,
          "text": "(מצד עצמו)"
        },
        {
          "s": 5,
          "text": "היא פריצת42"
        },
        {
          "s": 6,
          "text": "וביטול הגדרים דגילוי וצמצום"
        },
        {
          "s": 7,
          "text": "[ע\"י גילוי הפשיטות"
        },
        {
          "s": 8,
          "text": "(ת\"ת הנעלם)"
        },
        {
          "s": 9,
          "text": "שאינו מוגדר בגדרים אלה],"
        },
        {
          "s": 10,
          "text": "ועי\"ז נמשך הגילוי"
        },
        {
          "s": 11,
          "text": "(גם)"
        },
        {
          "s": 12,
          "text": "בעולמות שנתהוו מהצמצום."
        },
        {
          "s": 13,
          "text": "אבל עדיין נשארו הגדרים שבענין הגילוי עצמו,"
        },
        {
          "s": 14,
          "text": "החילוק בין הגילוי שבבחינת סובב והגילוי שבבחינת התלבשות,"
        },
        {
          "s": 15,
          "text": "שהגילוי שבבחינת סובב הוא בכל מקום והגילוי שבבחינת התלבשות יש בו מדידה והגבלה43"
        },
        {
          "s": 16,
          "text": "שהוא יכול להיות רק בענינים שהם כלים לגילוי."
        },
        {
          "s": 17,
          "text": "והבקיעה דיעקב אותיות יבקע כמו שנתגלתה ע\"י יוסף היא פריצת וביטול גם דהגדרים שבענין הגילוי גופא,"
        },
        {
          "s": 18,
          "text": "שגם הגילוי שבבחינת התלבשות יכול להיות בכל מקום."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יש לבאר גם מ\"ש בהמאמר44"
        },
        {
          "s": 2,
          "text": "דהטעם על זה שהגילוי בבי\"ע הוא דוקא ע\"י יוסף הוא כי יוסף הוא בחי' יסוד"
        },
        {
          "s": 3,
          "text": "(גמר ההשפעה)"
        },
        {
          "s": 4,
          "text": "ועיקר התענוג והשמחה הוא בגמר ההשפעה,"
        },
        {
          "s": 5,
          "text": "כמבואר שם בארוכה."
        },
        {
          "s": 6,
          "text": "ולכן דוקא ע\"י יוסף נמשך הגילוי בבי\"ע."
        },
        {
          "s": 7,
          "text": "וצריך להבין מהי השייכות דענין הגילוי בבי\"ע להתענוג והשמחה שבגמר ההשפעה,"
        },
        {
          "s": 8,
          "text": "ולמה אינו מספיק"
        },
        {
          "s": 9,
          "text": "(בשביל גילוי זה)"
        },
        {
          "s": 10,
          "text": "התענוג והשמחה שבתחלת ואמצע דההשפעה."
        },
        {
          "s": 11,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 12,
          "text": "דמעלת התענוג והשמחה שבגמר ההשפעה"
        },
        {
          "s": 13,
          "text": "[שהכוונה כאן בגמר ההשפעה היא לזה שהשפע נתקבל בכי טוב אצל המקבל45]"
        },
        {
          "s": 14,
          "text": "הוא שהתענוג מגיע בהעצם שלמעלה משרש ההשפעה,"
        },
        {
          "s": 15,
          "text": "וכידוע46"
        },
        {
          "s": 16,
          "text": "בענין סוף מעשה במחשבה תחלה47,"
        },
        {
          "s": 17,
          "text": "דסוף מעשה הוא קבלת ההשפעה,"
        },
        {
          "s": 18,
          "text": "וזה מגיע במחשבה תחלה,"
        },
        {
          "s": 19,
          "text": "היינו בהתחילה שלפני"
        },
        {
          "s": 20,
          "text": "(ולמעלה מ)"
        },
        {
          "s": 21,
          "text": "תחלת המחשבה,"
        },
        {
          "s": 22,
          "text": "שרש ההשפעה."
        },
        {
          "s": 23,
          "text": "ולכן דוקא ע\"י התענוג והשמחה שבגמר ההשפעה נעשה פריצת וביטול גדרי הגילוי"
        },
        {
          "s": 24,
          "text": "(השפעה),"
        },
        {
          "s": 25,
          "text": "ועי\"ז,"
        },
        {
          "s": 26,
          "text": "גם הגילוי שבבחינת התלבשות"
        },
        {
          "s": 27,
          "text": "(גילוי הקו)"
        },
        {
          "s": 28,
          "text": "מתגלה גם בבי\"ע."
        }
      ]
    }
  ]
}