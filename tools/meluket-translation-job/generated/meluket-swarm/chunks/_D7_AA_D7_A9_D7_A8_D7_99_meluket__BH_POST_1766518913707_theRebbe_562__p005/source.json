{
  "globalIndex": 4,
  "owner": 4,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913707_theRebbe_562__p005",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913707_theRebbe_562__p005",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518913707_theRebbe_562",
  "title": "מאמר יבחר לנו את נחלתינו תשכ\"ג",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז,"
        },
        {
          "s": 1,
          "text": "בכדי לפעול שיהי' בנין המלכות צריכים להמשיך ממקום שאין שם"
        },
        {
          "s": 2,
          "text": "(לא רק מציאות העולמות,"
        },
        {
          "s": 3,
          "text": "אלא שאין שם)"
        },
        {
          "s": 4,
          "text": "גם המציאות דנשמות."
        },
        {
          "s": 5,
          "text": "וצריך להבין,"
        },
        {
          "s": 6,
          "text": "איך שייך שהנשמות ע\"י עבודתם יגיעו למקום שלמעלה ממציאותם."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ונקודת הביאור בזה,"
        },
        {
          "s": 1,
          "text": "דזה שבעת סילוק המלכות"
        },
        {
          "s": 2,
          "text": "(בהדרגות שלמעלה ממלכות)"
        },
        {
          "s": 3,
          "text": "אין תפיסת מקום לכאורה לנשמות ועבודתם"
        },
        {
          "s": 4,
          "text": "(כי נשמות ומלכות הם ענין אחד),"
        },
        {
          "s": 5,
          "text": "הוא בנוגע להמציאות דנשמות,"
        },
        {
          "s": 6,
          "text": "וענין תמליכוני"
        },
        {
          "s": 7,
          "text": "(שישראל מבקשים ומתחננים להקב\"ה שיהי' מלך)"
        },
        {
          "s": 8,
          "text": "הוא הביטול פנימי שמצד עצם הנשמה46,"
        },
        {
          "s": 9,
          "text": "שמושרשת בהעצמות."
        },
        {
          "s": 10,
          "text": "וכשמתגלית עצם הנשמה היא ממשכת את העצמות."
        },
        {
          "s": 11,
          "text": "ועי\"ז נעשה גם בנין המלכות."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וביאור הענין דבנין המלכות שנעשה ע\"י המשכת העצמות שע\"י גילוי עצם הנשמה,"
        },
        {
          "s": 2,
          "text": "יש לומר,"
        },
        {
          "s": 3,
          "text": "ע\"פ המבואר בכ\"מ47"
        },
        {
          "s": 4,
          "text": "בענין ישראל עלו במחשבה48,"
        },
        {
          "s": 5,
          "text": "דמחשבה זו היא מחשבה עצמית."
        },
        {
          "s": 6,
          "text": "דמחשבה בכלל היא מחוץ להחושב"
        },
        {
          "s": 7,
          "text": "[וכמו אדם החושב איזה דבר,"
        },
        {
          "s": 8,
          "text": "דהמחשבה בהדבר היא למטה מהאדם עצמו,"
        },
        {
          "s": 9,
          "text": "ובמילא היא כמו חוץ ממנו],"
        },
        {
          "s": 10,
          "text": "והמחשבה דישראל היא חד עם החושב עצמו."
        },
        {
          "s": 11,
          "text": "וזהו במי נמלך בנשמותיהן של צדיקים49"
        },
        {
          "s": 12,
          "text": "(ועמך כולם צדיקים50),"
        },
        {
          "s": 13,
          "text": "שההמלכה דבמי נמלך היא לא רק על בריאת העולמות"
        },
        {
          "s": 14,
          "text": "(אם לברוא עולמות או לא לברוא),"
        },
        {
          "s": 15,
          "text": "אלא גם על המחשבה להתהוות העולמות"
        },
        {
          "s": 16,
          "text": "(אם תהי' המחשבה להתהוות העולמות או לאו),"
        },
        {
          "s": 17,
          "text": "דמזה מובן,"
        },
        {
          "s": 18,
          "text": "שנשמות ישראל"
        },
        {
          "s": 19,
          "text": "(שבהם נמלך אם תהי' המחשבה דבריאת העולמות)"
        },
        {
          "s": 20,
          "text": "הם למעלה ממחשבה זו."
        },
        {
          "s": 21,
          "text": "כי המחשבה דבריאת העולמות,"
        },
        {
          "s": 22,
          "text": "גם כמו שהיא בדרגא הכי נעלית,"
        },
        {
          "s": 23,
          "text": "היא דוגמת אדם החושב איזה דבר"
        },
        {
          "s": 24,
          "text": "(מחשבה לברוא עולמות),"
        },
        {
          "s": 25,
          "text": "שהמחשבה היא חוץ ממנו,"
        },
        {
          "s": 26,
          "text": "וישראל עלו במחשבה עצמית."
        },
        {
          "s": 27,
          "text": "ומבואר שם,"
        },
        {
          "s": 28,
          "text": "דהטעם על זה שההמלכה על המחשבה דבריאת העולמות היתה עם ישראל שעלו במחשבה עצמית"
        },
        {
          "s": 29,
          "text": "(אף שמחשבה עצמית היא למעלה מהמחשבה דבריאת העולמות),"
        },
        {
          "s": 30,
          "text": "הוא,"
        },
        {
          "s": 31,
          "text": "כי במחשבה עצמית שני אופנים."
        },
        {
          "s": 32,
          "text": "שחושב אודות עצמו,"
        },
        {
          "s": 33,
          "text": "ושחושב בדבר הנבדל ממנו ואעפ\"כ אין המחשבה חוץ ממנו כי הוא עצמו הוא החושב."
        },
        {
          "s": 34,
          "text": "וזה שישראל עלו במחשבה הוא אופן הב' שבמחשבה עצמית,"
        },
        {
          "s": 35,
          "text": "שהעצמות חושב כביכול בדבר הזולת"
        },
        {
          "s": 36,
          "text": "[וזהו בנים אתם להוי' אלקיכם51,"
        },
        {
          "s": 37,
          "text": "דכיון ששורש הנשמות הוא במחשבה העצמית,"
        },
        {
          "s": 38,
          "text": "שהעצמות חושב כביכול בדבר הזולת,"
        },
        {
          "s": 39,
          "text": "לכן,"
        },
        {
          "s": 40,
          "text": "גם לאחרי שבאו בהמשכה הם כמו בנים,"
        },
        {
          "s": 41,
          "text": "שבבן"
        },
        {
          "s": 42,
          "text": "(דוגמת)"
        },
        {
          "s": 43,
          "text": "שני ענינים הנ\"ל."
        },
        {
          "s": 44,
          "text": "שהבן הוא נבדל מהאב ואעפ\"כ יש בו מעצמיות האב]."
        },
        {
          "s": 45,
          "text": "ולכן ההמלכה על המחשבה דעולמות היתה עם ישראל."
        },
        {
          "s": 46,
          "text": "כי הכוונה דבריאת העולם"
        },
        {
          "s": 47,
          "text": "[שהתחתונים יהיו דירה לו ית']"
        },
        {
          "s": 48,
          "text": "נשלמת ע\"י הנשמות."
        }
      ]
    }
  ]
}