  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917418_theRebbe_694__p007",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917418_theRebbe_694__p007",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917418_theRebbe_694",
  "title": "מאמר וקבל היהודים תשי\"א",
  "part": 7,
  "sections": [
    {
      "v": 18,
      "items": [
        {
          "s": 0,
          "text": "וע\"פ מה שנת\"ל דמעלת לימוד התורה לשמה היא לא רק בענין הביטול אלא גם שהלימוד של האדם הוא באופן דבל\"ג,"
        },
        {
          "s": 1,
          "text": "יש לומר,"
        },
        {
          "s": 2,
          "text": "שעד\"ז הוא גם בעד דלא ידע,"
        },
        {
          "s": 3,
          "text": "שזה פועל"
        },
        {
          "s": 4,
          "text": "(אח\"כ)"
        },
        {
          "s": 5,
          "text": "עלי' גם בהידיעה"
        },
        {
          "s": 6,
          "text": "[דלימוד התורה צ\"ל בהבנה והשגה דוקא],"
        },
        {
          "s": 7,
          "text": "שמבין בשכלו ענינים בתורה שקודם לא הי' שייך לזה."
        },
        {
          "s": 8,
          "text": "וכמו שביאר כ\"ק מו\"ח אדמו\"ר באחת השיחות דפורים95,"
        },
        {
          "s": 9,
          "text": "שע\"י שמגיעים לדרגת לא ידע,"
        },
        {
          "s": 10,
          "text": "הידע שאח\"כ הוא באופן אחר לגמרי."
        },
        {
          "s": 11,
          "text": "ובכללות הוא שהשכל המוגבל של האדם מתאחד עם התורה שלומד הבלתי מוגבלת,"
        },
        {
          "s": 12,
          "text": "ועי\"ז נעשה חד גם עם קוב\"ה,"
        },
        {
          "s": 13,
          "text": "ישראל אורייתא וקוב\"ה כולא חד."
        }
      ]
    }
  ]
}