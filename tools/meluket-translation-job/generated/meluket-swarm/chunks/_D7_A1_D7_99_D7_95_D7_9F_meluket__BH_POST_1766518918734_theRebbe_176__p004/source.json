{
  "globalIndex": 836,
  "owner": 36,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918734_theRebbe_176__p004",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918734_theRebbe_176__p004",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918734_theRebbe_176",
  "title": "מאמר וידבר אלוקים את כל הדברים האלה תשכ\"ח",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ויובן זה בהקדים מה שארז\"ל12"
        },
        {
          "s": 1,
          "text": "דהטעם על זה שבריאת העולם היתה בעשרה מאמרות"
        },
        {
          "s": 2,
          "text": "(אף שבמאמר אחד יכול להבראות)"
        },
        {
          "s": 3,
          "text": "הוא להפרע מן הרשעים כו' וליתן שכר טוב לצדיקים כו'."
        },
        {
          "s": 4,
          "text": "וידוע הביאור בזה32,"
        },
        {
          "s": 5,
          "text": "דבאם היתה ההתהוות ממאמר אחד,"
        },
        {
          "s": 6,
          "text": "הי' העולם בטל בתכלית"
        },
        {
          "s": 7,
          "text": "[שהרי אפילו עולם הבריאה,"
        },
        {
          "s": 8,
          "text": "שנתהווה מהמאמר דבראשית שבספירת המלכות,"
        },
        {
          "s": 9,
          "text": "אינו יש ממש,"
        },
        {
          "s": 10,
          "text": "ומכ\"ש באם היתה ההתהוות מהמאמר אחד דחכמה או דכתר,"
        },
        {
          "s": 11,
          "text": "ועאכו\"כ מהרצון שלפני הצמצום,"
        },
        {
          "s": 12,
          "text": "שאז היו העולמות בתכלית הביטול],"
        },
        {
          "s": 13,
          "text": "ובמילא לא הי' שייך ענין הבחירה."
        },
        {
          "s": 14,
          "text": "ולכן היתה הבריאה בעשרה מאמרות פרטיים,"
        },
        {
          "s": 15,
          "text": "שעי\"ז נעשו הנבראים בבחינת יש,"
        },
        {
          "s": 16,
          "text": "ושייך בהם ענין הבחירה"
        },
        {
          "s": 17,
          "text": "(וענין שכר ועונש,"
        },
        {
          "s": 18,
          "text": "להפרע מן הרשעים וליתן שכר טוב לצדיקים)."
        },
        {
          "s": 19,
          "text": "אבל,"
        },
        {
          "s": 20,
          "text": "מכיון שההתהוות שמצד העשרה מאמרות היא בבחינת יש ועד שאפשר לבחור בהיפך,"
        },
        {
          "s": 21,
          "text": "הנה בכדי שתושלם כוונת הבריאה,"
        },
        {
          "s": 22,
          "text": "שיהי' גילוי אלקות בעולם ושהנבראים יהיו בטלים לאלקות,"
        },
        {
          "s": 23,
          "text": "לכן היתה הבריאה באופן שבתחילה נמשך המאמר אחד וממנו נפרטו עשרה מאמרות פרטיים,"
        },
        {
          "s": 24,
          "text": "דעי\"ז יש בהעלם בהעשרה מאמרות הכלל דמאמר אחד,"
        },
        {
          "s": 25,
          "text": "וע\"י עבודת האדם,"
        },
        {
          "s": 26,
          "text": "הוא מגלה את הכלל דמאמר אחד33"
        },
        {
          "s": 27,
          "text": "(שבכל הדרגות,"
        },
        {
          "s": 28,
          "text": "עד להרצון שלפני הצמצום)"
        },
        {
          "s": 29,
          "text": "בהעשרה מאמרות ובהעולם34"
        },
        {
          "s": 30,
          "text": "שנתהווה מהם,"
        },
        {
          "s": 31,
          "text": "שיהי' גילוי אלקות בהעולם ושיהי' בטל לאלקות35."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יובן גם זה שבתחילה האיר האור שבבחינת גילוי העצם שלמעלה משייכות לעולמות,"
        },
        {
          "s": 2,
          "text": "וממנו דוקא נמשך האור שלפי ערך העולמות."
        },
        {
          "s": 3,
          "text": "דהנה ידוע36"
        },
        {
          "s": 4,
          "text": "שהביטול בעולם שמצד גילוי האור שלפי ערך העולמות,"
        },
        {
          "s": 5,
          "text": "הוא רק ביטול היש,"
        },
        {
          "s": 6,
          "text": "מכיון שלגבי אור זה יש להם ערך,"
        },
        {
          "s": 7,
          "text": "ואמיתית ענין הביטול,"
        },
        {
          "s": 8,
          "text": "ביטול במציאות,"
        },
        {
          "s": 9,
          "text": "הוא דוקא מצד האור שלמעלה משייכות לעולמות."
        },
        {
          "s": 10,
          "text": "ולהיות שכוונת הבריאה היא שהנבראים יהיו בטלים לאלקות בתכלית הביטול,"
        },
        {
          "s": 11,
          "text": "ביטול במציאות,"
        },
        {
          "s": 12,
          "text": "שעי\"ז דוקא נעשים דירה לו ית',"
        },
        {
          "s": 13,
          "text": "לכן הי' תחילה האור שלמעלה משייכות לעולמות,"
        },
        {
          "s": 14,
          "text": "וממנו דוקא נמשך האור שלפי ערך העולמות,"
        },
        {
          "s": 15,
          "text": "דעי\"ז יש בו בהעלם גם מהאור שלמעלה משייכות לעולמות,"
        },
        {
          "s": 16,
          "text": "וכמו שידוע28"
        },
        {
          "s": 17,
          "text": "שבנקודת הרשימה יש בהעלם"
        },
        {
          "s": 18,
          "text": "(לא רק כל הפרטים שיומשכו אח\"כ בהקו,"
        },
        {
          "s": 19,
          "text": "אלא גם)"
        },
        {
          "s": 20,
          "text": "מפנימיות האור שלמעלה משייכות לעולמות,"
        },
        {
          "s": 21,
          "text": "וכבהמשל דרב ותלמיד,"
        },
        {
          "s": 22,
          "text": "שבנקודת השכל של הרב"
        },
        {
          "s": 23,
          "text": "(שנשאר אצלו בעת הצמצום)"
        },
        {
          "s": 24,
          "text": "יש בהעלם כל הפרטים שישפיע אח\"כ להתלמיד"
        },
        {
          "s": 25,
          "text": "(שנמשכים מחיצוניות השכל של הרב),"
        },
        {
          "s": 26,
          "text": "וגם מפנימיות השכל של הרב."
        },
        {
          "s": 27,
          "text": "ומכיון שהפרטים שנמשכים אח\"כ עד להעשרה מאמרות שמהם נברא העולם בפועל הם"
        },
        {
          "s": 28,
          "text": "(לא ענין בפ\"ע,"
        },
        {
          "s": 29,
          "text": "אלא)"
        },
        {
          "s": 30,
          "text": "הפרטים של הכלל דמאמר אחד"
        },
        {
          "s": 31,
          "text": "(עד לשרשו הראשון)"
        },
        {
          "s": 32,
          "text": "שיש בו בהעלם מהאור שלמעלה משייכות לעולמות,"
        },
        {
          "s": 33,
          "text": "לכן,"
        },
        {
          "s": 34,
          "text": "ע\"י העבודה,"
        },
        {
          "s": 35,
          "text": "מגלים בהעשרה מאמרות"
        },
        {
          "s": 36,
          "text": "(ובהעולם שנברא מהם)"
        },
        {
          "s": 37,
          "text": "לא רק הכלל דמאמר אחד אלא גם האור שלמעלה משייכות לעולמות"
        },
        {
          "s": 38,
          "text": "[ובדוגמת המשל דרב ותלמיד,"
        },
        {
          "s": 39,
          "text": "שע\"י שהתלמיד מעיין בהפרטים,"
        },
        {
          "s": 40,
          "text": "הנה סוף סוף נעשה קאי אדעתי' דרבי'37,"
        },
        {
          "s": 41,
          "text": "שמגיע לשכל העצמי דהרב],"
        },
        {
          "s": 42,
          "text": "דע\"י גילוי אור זה,"
        },
        {
          "s": 43,
          "text": "נמשך בעולם שיהי' בטל לאלקות בתכלית הביטול,"
        },
        {
          "s": 44,
          "text": "ביטול במציאות."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ובעומק יותר יש לומר,"
        },
        {
          "s": 2,
          "text": "דע\"י העבודה בהפרטים,"
        },
        {
          "s": 3,
          "text": "מגיעים לבחינת עצם האור,"
        },
        {
          "s": 4,
          "text": "שלמעלה גם מהאור שלמעלה מעולמות שישנו בהעלם בהכלל דעולמות."
        },
        {
          "s": 5,
          "text": "דמה שיש בהעלם בהכלל דעולמות הוא בחינת התפשטות האור,"
        },
        {
          "s": 6,
          "text": "שבתחילה הי' אוא\"ס ממלא את מקום החלל38,"
        },
        {
          "s": 7,
          "text": "שהוא האור שבבחינת התפשטות וגילוי,"
        },
        {
          "s": 8,
          "text": "ואח\"כ"
        },
        {
          "s": 9,
          "text": "(באור זה39)"
        },
        {
          "s": 10,
          "text": "עלה ברצונו להאציל ולברוא,"
        },
        {
          "s": 11,
          "text": "הרי שהשייכות דהרצון לעולמות"
        },
        {
          "s": 12,
          "text": "(הכלל דעולמות בשרשו הראשון)"
        },
        {
          "s": 13,
          "text": "לאור הבל\"ג שלמעלה מעולמות,"
        },
        {
          "s": 14,
          "text": "היא רק להאור שבבחינת התפשטות וגילוי,"
        },
        {
          "s": 15,
          "text": "וע\"י העבודה בהפרטים מגיעים לעצם האור."
        }
      ]
    }
  ]
}