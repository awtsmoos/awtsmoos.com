  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919961_theRebbe_975__p005",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919961_theRebbe_975__p005",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919961_theRebbe_975",
  "title": "מאמר ועתה ישראל תשל\"ז",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "וזהו ועתה ישראל מה ה' אלקיך שואל מעמך אל תקרי מה אלא מאה,"
        },
        {
          "s": 3,
          "text": "שבכדי שיוכל להיות העבודה דמאה ברכות,"
        },
        {
          "s": 4,
          "text": "להמשיך ריבוי האורות שלמעלה"
        },
        {
          "s": 5,
          "text": "(ריבוי באיכות)"
        },
        {
          "s": 6,
          "text": "בריבוי הנבראים שלמטה"
        },
        {
          "s": 7,
          "text": "(ריבוי ההתחלקות לפרטים),"
        },
        {
          "s": 8,
          "text": "הוא ע\"י המ\"ה שבנפש,"
        },
        {
          "s": 9,
          "text": "דמ\"ה הוא נקודה עצמית שלמעלה מגדר מספר"
        },
        {
          "s": 10,
          "text": "(שאין שייך בה ענין הריבוי,"
        },
        {
          "s": 11,
          "text": "גם לא ריבוי באיכות)."
        },
        {
          "s": 12,
          "text": "וע\"י העבודה דמאה ברכות,"
        },
        {
          "s": 13,
          "text": "עי\"ז גופא מתגלה המ\"ה שבו."
        },
        {
          "s": 14,
          "text": "ולא עוד אלא שכיון שהתכלית דירידת הנשמה למטה,"
        },
        {
          "s": 15,
          "text": "כולל גם ירידת המ\"ה דהנשמה,"
        },
        {
          "s": 16,
          "text": "הוא בכדי להמשיך גילוי אלקות בעולם"
        },
        {
          "s": 17,
          "text": "[כמו שהוא עכשיו,"
        },
        {
          "s": 18,
          "text": "עתה,"
        },
        {
          "s": 19,
          "text": "ע\"י העבודה דישראל על שם כי שרית גו' ותוכל],"
        },
        {
          "s": 20,
          "text": "לכן,"
        },
        {
          "s": 21,
          "text": "ע\"י שהאדם ממלא את תפקידו ושליחותו,"
        },
        {
          "s": 22,
          "text": "נעשה עילוי גם בהמ\"ה שבו74."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "וכיון שכבר נמצאים בסוף זמן הגלות,"
        },
        {
          "s": 1,
          "text": "וכל אחד מישראל השלים כבר את העבודה דהיום לעשותם,"
        },
        {
          "s": 2,
          "text": "דהבטיחה תורה שסוף ישראל לעשות תשובה בסוף גלותן75"
        },
        {
          "s": 3,
          "text": "– הנה מיד הן נגאלין75,"
        },
        {
          "s": 4,
          "text": "בגאולה האמיתית והשלימה ע\"י משיח צדקנו,"
        },
        {
          "s": 5,
          "text": "שאז תושלם הכוונה דדירה בתחתונים,"
        },
        {
          "s": 6,
          "text": "שיהי' גילוי אלקות בעוה\"ז הגשמי ובכל הפרטים שבו,"
        },
        {
          "s": 7,
          "text": "וישראל"
        },
        {
          "s": 8,
          "text": "[שהם המשיכו הגילוי בעולם]"
        },
        {
          "s": 9,
          "text": "יהיו במדריגה נעלית עוד יותר76,"
        },
        {
          "s": 10,
          "text": "וכל זה – בקרוב ממש בעגלא דידן."
        }
      ]
    }
  ]
}