{
  "globalIndex": 145,
  "owner": 45,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914519_theRebbe_363__p005",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914519_theRebbe_363__p005",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914519_theRebbe_363",
  "title": "מאמר ביום השמיני עצרת תש\"מ",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "וזהו ביום השמיני עצרת תהי' לכם,"
        },
        {
          "s": 3,
          "text": "דזה שנקרא בשם שמיני עצרת שמורה ע\"ז שבא בהמשך לז' ימי הסוכות דוקא,"
        },
        {
          "s": 4,
          "text": "אף שבשמיני עצרת נעצרים ונקלטים גם הענינים דראש השנה ויום הכפורים,"
        },
        {
          "s": 5,
          "text": "כי בראש השנה ויום הכפורים הוא ענין העלי' מלמטה למעלה,"
        },
        {
          "s": 6,
          "text": "ומכיון שהכוונה היא לשבת יצרה,"
        },
        {
          "s": 7,
          "text": "המשכה מלמעלה למטה,"
        },
        {
          "s": 8,
          "text": "לכן נקרא בשם שמיני עצרת,"
        },
        {
          "s": 9,
          "text": "שבו נעצרים ונקלטים כל הענינים שנמשכו מלמעלה למטה בז' ימי הסוכות,"
        },
        {
          "s": 10,
          "text": "שלכן נקרא בשם שמיני דוקא"
        },
        {
          "s": 11,
          "text": "[נוסף לזה ששמיני הוא מלשון שומן ודשן124]."
        },
        {
          "s": 12,
          "text": "אלא שאעפ\"כ שמיני עצרת הוא רגל בפ\"ע,"
        },
        {
          "s": 13,
          "text": "כי עי\"ז גופא מה שבשמיני עצרת נעצרים ונקלטים הענינים דז' ימי הסוכות,"
        },
        {
          "s": 14,
          "text": "נעשה בו ענין חדש,"
        },
        {
          "s": 15,
          "text": "רגל בפ\"ע."
        },
        {
          "s": 16,
          "text": "כי בז' ימי הסוכות נמשכים"
        },
        {
          "s": 17,
          "text": "(בבחי' מקיף)"
        },
        {
          "s": 18,
          "text": "הענינים דראש השנה ויום הכפורים ודכללות עשי\"ת עד לשלימות התשובה דיום הכפורים,"
        },
        {
          "s": 19,
          "text": "וע\"י המשכת ענין זה בפנימיות ובקליטה בשמיני עצרת,"
        },
        {
          "s": 20,
          "text": "ליום חגינו לשון יחיד,"
        },
        {
          "s": 21,
          "text": "מתגלה"
        },
        {
          "s": 22,
          "text": "(ובאופן דקליטה)"
        },
        {
          "s": 23,
          "text": "ההתקשרות והתאחדות דבחי' יחידה שבנפש עם בחי' יחיד,"
        },
        {
          "s": 24,
          "text": "שלשם מגיע ענין התשובה,"
        },
        {
          "s": 25,
          "text": "פר אחד איל אחד125."
        },
        {
          "s": 26,
          "text": "וזהו ג\"כ עצרת תהי' לכם ואיתא במדרש הה\"ד יהיו לך לבדך ואין לזרים אתך,"
        },
        {
          "s": 27,
          "text": "דזה שצריך לשלול ולומר אין לזרים אתך הוא לפי שבע\"ת שסורו רע צריך לזהירות יתירה126,"
        },
        {
          "s": 28,
          "text": "ולכן צריך לשלול הענין דזרים"
        },
        {
          "s": 29,
          "text": "(ענינים הבלתי רצויים)."
        },
        {
          "s": 30,
          "text": "אבל עי\"ז גופא"
        },
        {
          "s": 31,
          "text": "(הזהירות יתירה דהבע\"ת)"
        },
        {
          "s": 32,
          "text": "נעשה יהיו לך לבדך,"
        },
        {
          "s": 33,
          "text": "כי עי\"ז שהתשובה מגעת בעצמותו ית',"
        },
        {
          "s": 34,
          "text": "הרי לא שייך שם שום נתינת מקום לזרים,"
        },
        {
          "s": 35,
          "text": "ישראל ומלכא בלחודוהי."
        },
        {
          "s": 36,
          "text": "ואדרבה,"
        },
        {
          "s": 37,
          "text": "מצד המשכת העצמות"
        },
        {
          "s": 38,
          "text": "(ע\"י עבודת התשובה)"
        },
        {
          "s": 39,
          "text": "מתגלה פנימית ואמיתית הכוונה דעשיית הענינים הבלתי רצויים,"
        },
        {
          "s": 40,
          "text": "שזה הי' בכוונה תחלה"
        },
        {
          "s": 41,
          "text": "(כידוע127"
        },
        {
          "s": 42,
          "text": "בענין נורא עלילה על בני אדם128)"
        },
        {
          "s": 43,
          "text": "בכדי שיהי' אתהפכא חשוכא לנהורא,"
        },
        {
          "s": 44,
          "text": "הפיכת הזדונות לזכיות."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ב)"
        },
        {
          "s": 2,
          "text": "וזהו ג\"כ מה שקבעו שמחת תורה בשמיני עצרת על לוחות האחרונות דוקא"
        },
        {
          "s": 3,
          "text": "[שהגלוי דלוחות האחרונות"
        },
        {
          "s": 4,
          "text": "(ענין התשובה דיום הכפורים)"
        },
        {
          "s": 5,
          "text": "בפנימיות ובקליטה הוא בשמיני עצרת,"
        },
        {
          "s": 6,
          "text": "כנ\"ל],"
        },
        {
          "s": 7,
          "text": "כי השמחה דשמחת תורה היא"
        },
        {
          "s": 8,
          "text": "(בעיקר)"
        },
        {
          "s": 9,
          "text": "מצד זה שהתורה פועלת גם בענינים התחתונים שבעולם,"
        },
        {
          "s": 10,
          "text": "דזהו מה שהשמחה דשמחת תורה היא בריקודים ברגלים ובהם גופא בהעקב שבהם,"
        },
        {
          "s": 11,
          "text": "ולכן השמחה היא על לוחות האחרונות דוקא,"
        },
        {
          "s": 12,
          "text": "ענין התשובה,"
        },
        {
          "s": 13,
          "text": "כי עי\"ז מתברר גם הכי תחתון שבעולם,"
        },
        {
          "s": 14,
          "text": "עד שגם הזדונות נהפכים לזכיות."
        },
        {
          "s": 15,
          "text": "וכמו שבריקוד"
        },
        {
          "s": 16,
          "text": "(בגשמיות),"
        },
        {
          "s": 17,
          "text": "ע\"י שהרגלים והעקביים מתנשאים"
        },
        {
          "s": 18,
          "text": "(הויבן זיך)"
        },
        {
          "s": 19,
          "text": "ומרקדים,"
        },
        {
          "s": 20,
          "text": "הם מנשאים גם את הראש"
        },
        {
          "s": 21,
          "text": "(וכח השכל שבו)"
        },
        {
          "s": 22,
          "text": "שגם הוא מרקד בשמחה גדולה למעלה ממדידה והגבלה,"
        },
        {
          "s": 23,
          "text": "עד\"ז הוא גם ברוחניות הענינים,"
        },
        {
          "s": 24,
          "text": "שע\"י השמחה והריקודים דשמחת תורה נעשה עלי' והתנשאות גם בבחי' הראש דנשמה."
        },
        {
          "s": 25,
          "text": "ומכיון שאדם הוא אדמה לעליון129"
        },
        {
          "s": 26,
          "text": "הנה עי\"ז נעשה עלי' והתנשאות כביכול גם בחכמתו ית' שהיא התורה"
        },
        {
          "s": 27,
          "text": "[וכמובן גם מזה שבהריקודים דהקפות גם התורה היא שמחה ורוקדת,"
        },
        {
          "s": 28,
          "text": "כמאמר הידוע דרבינו נשיאינו],"
        },
        {
          "s": 29,
          "text": "ושמחה פורצת גדר130,"
        },
        {
          "s": 30,
          "text": "שהשמחה דשמחת תורה פורצת גם הגדר דתורה כביכול,"
        },
        {
          "s": 31,
          "text": "דהתורה מצ\"ע היא במדידה והגבלה וע\"י השמחה והריקודים דשמחת תורה ממשיכים בה מעצמותו ית',"
        },
        {
          "s": 32,
          "text": "וכנ\"ל ע\"ד מרז\"ל דוד הי' מחבר תורה שלמעלה בהקב\"ה."
        },
        {
          "s": 33,
          "text": "וכמו שהוא בתורה עד\"ז הוא בנשמות ישראל,"
        },
        {
          "s": 34,
          "text": "שע\"י השמחה והריקודים דשמחת תורה נעשה עלי' והתנשאות בבחי' הראש דנשמה"
        },
        {
          "s": 35,
          "text": "(כנ\"ל),"
        },
        {
          "s": 36,
          "text": "שמתקשרת ונעשית חד ממש עם העצמות,"
        },
        {
          "s": 37,
          "text": "שאו את ראש גו' לגולגלותם131,"
        },
        {
          "s": 38,
          "text": "שעיקר ענין זה יהי' במנין העשירי עוד תעבורנה הצאן ע\"י מונה132."
        },
        {
          "s": 39,
          "text": "וכל זה נעשה"
        },
        {
          "s": 40,
          "text": "(כנ\"ל)"
        },
        {
          "s": 41,
          "text": "ע\"י מעשינו ועבודתנו בזמן הגלות,"
        },
        {
          "s": 42,
          "text": "ובמיוחד לאחר גילוי תורת הרשב\"י ובאופן דיתפרנסון133"
        },
        {
          "s": 43,
          "text": "ע\"י תורת הבעש\"ט וע\"י תורת חסידות חב\"ד,"
        },
        {
          "s": 44,
          "text": "ויפקון בי' מן גלותא ברחמי134,"
        },
        {
          "s": 45,
          "text": "ושמחת עולם על ראשם135,"
        },
        {
          "s": 46,
          "text": "בגאולה האמיתית והשלימה בקרוב ממש בביאת משיח צדקנו,"
        },
        {
          "s": 47,
          "text": "דוד מלכא משיחא."
        }
      ]
    }
  ]
}