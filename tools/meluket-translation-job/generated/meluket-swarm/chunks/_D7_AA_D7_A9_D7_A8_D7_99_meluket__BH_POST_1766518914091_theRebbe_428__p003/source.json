{
  "globalIndex": 71,
  "owner": 21,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914091_theRebbe_428__p003",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914091_theRebbe_428__p003",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914091_theRebbe_428",
  "title": "מאמר שובה ישראל תש\"מ",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וזהו שובה ישראל עד הוי' אלקיך,"
        },
        {
          "s": 2,
          "text": "עד לשון נצחיות53,"
        },
        {
          "s": 3,
          "text": "שענין הנצחיות שייך בגדר הזמן דוקא"
        },
        {
          "s": 4,
          "text": "(דמה שלמעלה מגדר הזמן הוא למעלה אפילו מהי' הוה ויהי' כאחד54),"
        },
        {
          "s": 5,
          "text": "אלא שבגדר הזמן הוא בבחי' נצחיות."
        },
        {
          "s": 6,
          "text": "ולכן עד היא בבחי' מלכות,"
        },
        {
          "s": 7,
          "text": "שהיא55"
        },
        {
          "s": 8,
          "text": "בבחי' וגדר הזמן53."
        },
        {
          "s": 9,
          "text": "וישראל הוא בחי' ז\"א."
        },
        {
          "s": 10,
          "text": "ופירוש שובה ישראל עד הוי' אלקיך,"
        },
        {
          "s": 11,
          "text": "שצריך להשיב ישראל עד שתהי' המלכות באופן דעד ובחינות ישראל ובחי' עד"
        },
        {
          "s": 12,
          "text": "(ז\"א ומלכות,"
        },
        {
          "s": 13,
          "text": "בחינות ההשתלשלות)"
        },
        {
          "s": 14,
          "text": "להוי' אלקיך,"
        },
        {
          "s": 15,
          "text": "היינו לעצמות אוא\"ס שלגבי' הוי' כאלקים יחשב56,"
        },
        {
          "s": 16,
          "text": "ומשם צריך להמשיך בבחי' הוי' אלקיך,"
        },
        {
          "s": 17,
          "text": "הוי' לשון מהוה ובזה גופא כמו שמתלבש בשם אלקים,"
        },
        {
          "s": 18,
          "text": "ונעשה אלקיך כחך וחיותך."
        },
        {
          "s": 19,
          "text": "וזהו ג\"כ מה שאומרים בנעילת יום הכפורים ז' פעמים הוי' הוא האלקים,"
        },
        {
          "s": 20,
          "text": "כי בעשרת ימי תשובה גופא"
        },
        {
          "s": 21,
          "text": "[שאז התשובה היא יפה ביותר ומתקבלת היא מיד57]"
        },
        {
          "s": 22,
          "text": "עיקר התשובה הוא ביום הכפורים,"
        },
        {
          "s": 23,
          "text": "כמ\"ש הרמב\"ם58"
        },
        {
          "s": 24,
          "text": "יום הכפורים הוא זמן התשובה לכל כו' והוא קץ מחילה וסליחה לישראל כו',"
        },
        {
          "s": 25,
          "text": "וביום הכפורים גופא עיקר התשובה הוא בתפלת נעילה"
        },
        {
          "s": 26,
          "text": "(גמר היום)"
        },
        {
          "s": 27,
          "text": "שאז הוא נעילת שערים ונמצאים ישראל ומלכא בלחודוהי59,"
        },
        {
          "s": 28,
          "text": "לכן אומרים אז ז' פעמים הוי' הוא האלקים,"
        },
        {
          "s": 29,
          "text": "שיש בזה ב' ענינים הנ\"ל."
        },
        {
          "s": 30,
          "text": "ענין העלי'"
        },
        {
          "s": 31,
          "text": "(מלמטלמ\"ע)"
        },
        {
          "s": 32,
          "text": "בעצמות אוא\"ס,"
        },
        {
          "s": 33,
          "text": "וכידוע דענין הוי' הוא האלקים"
        },
        {
          "s": 34,
          "text": "(שאומרים בנעילת יום הכפורים)"
        },
        {
          "s": 35,
          "text": "הוא מה שז\"א"
        },
        {
          "s": 36,
          "text": "(הוי')"
        },
        {
          "s": 37,
          "text": "בעלותו לעתיקא כאלקים יחשב60,"
        },
        {
          "s": 38,
          "text": "וענין ההמשכה מלמעלה למטה"
        },
        {
          "s": 39,
          "text": "(בהוי' לשון מהוה ועד כמו שמתלבש בשם אלקים),"
        },
        {
          "s": 40,
          "text": "דזהו מה שאומרים זה ז' פעמים בכדי להמשיך בבחי' ז\"ת."
        },
        {
          "s": 41,
          "text": "וי\"ל דזהו ג\"כ מה שאומרים אז שמע ישראל הוי' אלקינו הוי' אחד פעם אחת ובשכמל\"ו ג' פעמים והוי' הוא האלקים ז' פעמים,"
        },
        {
          "s": 42,
          "text": "שמע ישראל גו' פעם אחת הו\"ע העלי' מלמטה למעלה61"
        },
        {
          "s": 43,
          "text": "ובשכמל\"ו62"
        },
        {
          "s": 44,
          "text": "ג' פעמים והוי' הוא האלקים ז\"פ הו\"ע ההמשכה מלמעלה למטה בכל הע\"ס"
        },
        {
          "s": 45,
          "text": "(ג' מוחין וז' מדות)."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ויש לקשר זה עם הכתוב וביום שמחתכם גו' ותקעתם בחצוצרות גו'63,"
        },
        {
          "s": 2,
          "text": "וידועה תורת הרב המגיד64"
        },
        {
          "s": 3,
          "text": "שתי חצוצרות שתי חצאי צורות,"
        },
        {
          "s": 4,
          "text": "ומבואר בהמאמר65"
        },
        {
          "s": 5,
          "text": "דענין שתי חצאי צורות הוא בבחי' הגילויים"
        },
        {
          "s": 6,
          "text": "(צורה מורה על גילוי),"
        },
        {
          "s": 7,
          "text": "ששם שייך לומר שהקב\"ה וכנסת ישראל הם שתי חצאי צורות שמשלימות זא\"ז."
        },
        {
          "s": 8,
          "text": "משא\"כ בעצמות,"
        },
        {
          "s": 9,
          "text": "ישראל וקוב\"ה הם חד ממש"
        },
        {
          "s": 10,
          "text": "(ואין שייך לומר שהם ב' חצאים)."
        },
        {
          "s": 11,
          "text": "וכמו\"כ הוא גם בענין שתי חצאי צורות שבנשמה66,"
        },
        {
          "s": 12,
          "text": "חלק הנשמה שלמעלה ראש שבנשמה וחלק הנשמה שבגוף"
        },
        {
          "s": 13,
          "text": "(בחי' נר\"נ)"
        },
        {
          "s": 14,
          "text": "רגל שבנשמה,"
        },
        {
          "s": 15,
          "text": "שזהו דוקא בבחי' הגילויים שבנשמה,"
        },
        {
          "s": 16,
          "text": "דגם ראש שבנשמה הוא עד בחי' חי' שיש לה שייכות לבחי' רגל שבנשמה"
        },
        {
          "s": 17,
          "text": "(נשמה שבגוף),"
        },
        {
          "s": 18,
          "text": "שלכן נקראת בשם מזל לפי שהיא מזלת ומטפת להארת הנשמה המלובשת בגוף."
        },
        {
          "s": 19,
          "text": "משא\"כ בחי' יחידה ובפרט עצם הנשמה,"
        },
        {
          "s": 20,
          "text": "עם היותה כוללת את כל הכחות ולמעלה יותר נושאת את כל הכחות,"
        },
        {
          "s": 21,
          "text": "היא למעלה מבחי' מקור ושייכות לבחי' הגילויים,"
        },
        {
          "s": 22,
          "text": "והיא"
        },
        {
          "s": 23,
          "text": "(דוקא67)"
        },
        {
          "s": 24,
          "text": "נמצאת בכל הבחינות דנשמה68,"
        },
        {
          "s": 25,
          "text": "עד בבחי' עקב שבה,"
        },
        {
          "s": 26,
          "text": "וגם בבחי' עקב שבגוף,"
        },
        {
          "s": 27,
          "text": "וגם בד' אמות"
        },
        {
          "s": 28,
          "text": "(שמחוץ לגוף האדם)69,"
        },
        {
          "s": 29,
          "text": "שלכן ד' אמותיו של אדם קונות לו70,"
        },
        {
          "s": 30,
          "text": "כמבואר בכ\"מ71,"
        },
        {
          "s": 31,
          "text": "וזוהי המעלה דשופר על חצוצרות,"
        },
        {
          "s": 32,
          "text": "כמרז\"ל72"
        },
        {
          "s": 33,
          "text": "שופר מאריך וחצוצרות מקצרות שמצות היום בשופר,"
        },
        {
          "s": 34,
          "text": "כי העבודה דשופר היא בעצם הנשמה שהיא חד ממש עם העצמות,"
        },
        {
          "s": 35,
          "text": "למעלה73"
        },
        {
          "s": 36,
          "text": "מענין שתי חצאי צורות."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "וזהו ג\"כ שופר מאריך,"
        },
        {
          "s": 2,
          "text": "דענין האריכות הוא הן למעלה והן למטה,"
        },
        {
          "s": 3,
          "text": "כי העבודה דשופר מגעת בהעצם"
        },
        {
          "s": 4,
          "text": "(בעצם הנשמה ובעצמותו ית')"
        },
        {
          "s": 5,
          "text": "שלמעלה מכל הגילויים"
        },
        {
          "s": 6,
          "text": "(אריכות למעלה),"
        },
        {
          "s": 7,
          "text": "שהוא נמצא כנ\"ל גם בהעקב"
        },
        {
          "s": 8,
          "text": "(אריכות למטה),"
        },
        {
          "s": 9,
          "text": "ועי\"ז נשלמה הכוונה דדירה לו ית' בתחתונים,"
        },
        {
          "s": 10,
          "text": "בב' הענינים,"
        },
        {
          "s": 11,
          "text": "לו לעצמותו ובתחתונים."
        },
        {
          "s": 12,
          "text": "אלא שצריך גם לבחי' הגילויים,"
        },
        {
          "s": 13,
          "text": "וכמו בדירת מלך בו\"ד שצ\"ל"
        },
        {
          "s": 14,
          "text": "(נוסף על העיקר,"
        },
        {
          "s": 15,
          "text": "דירה לעצמות המלך)"
        },
        {
          "s": 16,
          "text": "דירה נאה וכלים נאים,"
        },
        {
          "s": 17,
          "text": "לכן צ\"ל גם חצוצרות,"
        },
        {
          "s": 18,
          "text": "ומצד החביבות שבזה נשמעים ב' הקולות"
        },
        {
          "s": 19,
          "text": "(חצוצרות ושופר)74,"
        },
        {
          "s": 20,
          "text": "אבל מצות היום בשופר,"
        },
        {
          "s": 21,
          "text": "לפי שעיקר העבודה בראש השנה הוא העבודה שמצד עצם הנשמה שהיא חד עם העצמות."
        }
      ]
    }
  ]
}