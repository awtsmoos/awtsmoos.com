{
  "globalIndex": 1010,
  "owner": 10,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919765_theRebbe_137__p006",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919765_theRebbe_137__p006",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919765_theRebbe_137",
  "title": "מאמר קץ שם לחושך תשכ\"ד",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "והנה ע\"פ הידוע גודל הדיוק במאמרי רבותינו נשיאינו"
        },
        {
          "s": 2,
          "text": "(גם בנוגע לזמן אמירתם),"
        },
        {
          "s": 3,
          "text": "מסתבר לומר,"
        },
        {
          "s": 4,
          "text": "שהשייכות דמאמר הנ\"ל לתשעה באב נדחה הוא הן מצד כללות התוכן דהמאמר – ענין האור,"
        },
        {
          "s": 5,
          "text": "וגם מצד הפרטים דאור המבוארים בהמאמר."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "והענין הוא,"
        },
        {
          "s": 1,
          "text": "דבכדי שהחושך יתבטל לגמרי"
        },
        {
          "s": 2,
          "text": "(ולא רק שיהי' נדחה מפני האור)"
        },
        {
          "s": 3,
          "text": "הוא"
        },
        {
          "s": 4,
          "text": "(דוקא)"
        },
        {
          "s": 5,
          "text": "ע\"י גילוי אור בלתי מוגבל"
        },
        {
          "s": 6,
          "text": "(כנ\"ל סעיף ב)."
        },
        {
          "s": 7,
          "text": "ובפרטיות יותר – ע\"י גילוי אור הכלול במאור."
        },
        {
          "s": 8,
          "text": "דהאור שמתפשט מחוץ להמאור,"
        },
        {
          "s": 9,
          "text": "ענינו הוא להאיר את החושך."
        },
        {
          "s": 10,
          "text": "וכמו אור השמש שמתפשט בחלל העולם"
        },
        {
          "s": 11,
          "text": "(מחוץ להשמש),"
        },
        {
          "s": 12,
          "text": "שהמקום דחלל העולם הוא מקום חשוך,"
        },
        {
          "s": 13,
          "text": "וענינו של האור המתפשט בחלל העולם הוא להאיר מקום החושך."
        },
        {
          "s": 14,
          "text": "והאור הכלול במאור הוא במקום"
        },
        {
          "s": 15,
          "text": "(דרגא)"
        },
        {
          "s": 16,
          "text": "שאין שייך בו ענין החושך."
        },
        {
          "s": 17,
          "text": "ועד\"ז הוא למעלה,"
        },
        {
          "s": 18,
          "text": "דמהחילוקים בין אוא\"ס שקודם הצמצום"
        },
        {
          "s": 19,
          "text": "(אור הכלול בעצמותו)"
        },
        {
          "s": 20,
          "text": "והאור שלאחרי הצמצום"
        },
        {
          "s": 21,
          "text": "(שהוא דוגמת אור המתפשט מחוץ להמאור),"
        },
        {
          "s": 22,
          "text": "הוא,"
        },
        {
          "s": 23,
          "text": "שהאור שנמשך לאחרי הצמצום ענינו הוא להאיר את העולמות."
        },
        {
          "s": 24,
          "text": "ולכן,"
        },
        {
          "s": 25,
          "text": "הגילוי אלקות שישנו בעולם ע\"י גילוי האור שלאחרי הצמצום הוא בדרך התחדשות."
        },
        {
          "s": 26,
          "text": "מציאות בפשיטות ואלקות בהתחדשות40."
        },
        {
          "s": 27,
          "text": "[ע\"ד אור השמש שמתפשט בחלל העולם,"
        },
        {
          "s": 28,
          "text": "שהמקום דחלל העולם מצד עצמו הוא מקום חשוך,"
        },
        {
          "s": 29,
          "text": "והאור שמאיר בו הוא בדרך הוספה וחידוש]."
        },
        {
          "s": 30,
          "text": "וכשמאיר בעולם גילוי אוא\"ס שקודם הצמצום,"
        },
        {
          "s": 31,
          "text": "אלקות הוא בפשיטות40,"
        },
        {
          "s": 32,
          "text": "ועד שלא ישנו נתינת מקום כלל לענין שאינו אלקות."
        },
        {
          "s": 33,
          "text": "[בדוגמת שהי' קודם הצמצום,"
        },
        {
          "s": 34,
          "text": "כשהי' אוא\"ס ממלא את מקום החלל,"
        },
        {
          "s": 35,
          "text": "שלא הי' אז מקום לעמידת העולמות41]."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "וזהו שביטול החושך לגמרי הוא ע\"י גילוי אור הכלול במאור"
        },
        {
          "s": 1,
          "text": "(אוא\"ס שלפני הצמצום),"
        },
        {
          "s": 2,
          "text": "דהאור שלאחרי הצמצום,"
        },
        {
          "s": 3,
          "text": "כיון שענינו הוא להאיר את העולמות,"
        },
        {
          "s": 4,
          "text": "דמזה מובן שהעולמות תופסים מקום לגבי',"
        },
        {
          "s": 5,
          "text": "לכן,"
        },
        {
          "s": 6,
          "text": "גילוי אור זה הוא באופן שההעלם והסתר דעולם ביכלתו להעלים עליו."
        },
        {
          "s": 7,
          "text": "והיינו,"
        },
        {
          "s": 8,
          "text": "דנוסף לההעלם דעולם שישנו גם כשמאיר הגילוי,"
        },
        {
          "s": 9,
          "text": "שהגילוי אלקות בעולם שע\"י גילוי אור זה הוא בדרך התחדשות"
        },
        {
          "s": 10,
          "text": "(כנ\"ל),"
        },
        {
          "s": 11,
          "text": "הנה אפשר שההעלם דעולם יעלים גם על גילוי זה"
        },
        {
          "s": 12,
          "text": "(שלא יהי' בעולם גילוי אלקות כלל,"
        },
        {
          "s": 13,
          "text": "גם לא גילוי שבדרך התחדשות)."
        },
        {
          "s": 14,
          "text": "ובכדי שיהי' ביטול החושך הוא ע\"י גילוי עצם האור שלמעלה מהאור שלהאיר את העולמות,"
        },
        {
          "s": 15,
          "text": "דאור זה אין העולם מעלים לגבי'."
        },
        {
          "s": 16,
          "text": "וזהו מ\"ש במדרש42"
        },
        {
          "s": 17,
          "text": "שהגאולה העתידה היא דוגמת אור היום שאין שייך בו כיבוי,"
        },
        {
          "s": 18,
          "text": "דיש לומר שהכוונה בזה היא להאור שלמעלה משייכות לעולמות,"
        },
        {
          "s": 19,
          "text": "שאין שייך העלם לגבי'."
        }
      ]
    }
  ]
}