{
  "globalIndex": 1060,
  "owner": 10,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518920021_theRebbe_64__p004",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518920021_theRebbe_64__p004",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518920021_theRebbe_64",
  "title": "מאמר ושננתם לבניך תשל\"ח",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה ע\"פ האמור לעיל שדוקא ע\"י הירידה למטה מטה יכולים לפעול שתהי' העלי' למעלה מעלה,"
        },
        {
          "s": 2,
          "text": "למקום גבוה יותר מהמקום שמשם היתה הירידה,"
        },
        {
          "s": 3,
          "text": "מובן גם מעלת ענין המעשה לגבי ענין התלמוד,"
        },
        {
          "s": 4,
          "text": "שזהו כללות החילוק שבין מצוות"
        },
        {
          "s": 5,
          "text": "(מעשה)"
        },
        {
          "s": 6,
          "text": "לתורה"
        },
        {
          "s": 7,
          "text": "(תלמוד)."
        },
        {
          "s": 8,
          "text": "דהנה,"
        },
        {
          "s": 9,
          "text": "תורה ענינה המשכה מלמעלה למטה,"
        },
        {
          "s": 10,
          "text": "וביחד עם זה,"
        },
        {
          "s": 11,
          "text": "הלא כה דברי כאש גו'66,"
        },
        {
          "s": 12,
          "text": "שלכן אין דברי תורה מקבלין טומאה67,"
        },
        {
          "s": 13,
          "text": "היינו,"
        },
        {
          "s": 14,
          "text": "שגם כאשר נמצאים למטה,"
        },
        {
          "s": 15,
          "text": "ואפילו אצל מי שהוא במעמד ומצב דהיפך הטהרה,"
        },
        {
          "s": 16,
          "text": "גם שם אינם מקבלים טומאה."
        },
        {
          "s": 17,
          "text": "משא\"כ מצוות הרי ענינם הוא בדברים גשמיים דוקא68,"
        },
        {
          "s": 18,
          "text": "ועד שאפילו המצוות שענינם הוא הבנה והשגה שבמוח או הרגש שבלב,"
        },
        {
          "s": 19,
          "text": "קשורים הם עם אברים הגשמיים,"
        },
        {
          "s": 20,
          "text": "מוח הגשמי ולב הגשמי,"
        },
        {
          "s": 21,
          "text": "ובפרט ע\"פ המבואר בכ\"מ69,"
        },
        {
          "s": 22,
          "text": "ששלימות העבודה בקיום מצוות אלו היא כאשר נעשה שינוי גם בהגשמיות דכלי המוח וכלי הלב"
        },
        {
          "s": 23,
          "text": "(כיווץ והתרחבות והתפשטות)."
        },
        {
          "s": 24,
          "text": "וכיון שבמצוות ישנו ענין של ירידה למטה יותר"
        },
        {
          "s": 25,
          "text": "(בגשמיות),"
        },
        {
          "s": 26,
          "text": "לכן על ידם דוקא מגיעים להגבוה גבוה ביותר."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וביאור הענין,"
        },
        {
          "s": 2,
          "text": "דהנה יש ב' דעות70"
        },
        {
          "s": 3,
          "text": "(ואלו ואלו דברי אלקים חיים71)"
        },
        {
          "s": 4,
          "text": "אם תלמוד גדול או מעשה גדול."
        },
        {
          "s": 5,
          "text": "וזהו גם החילוק בין ב' הסדרים שבכתוב"
        },
        {
          "s": 6,
          "text": "(כנ\"ל שאלו ואלו דברי אלקים חיים),"
        },
        {
          "s": 7,
          "text": "הסדר בפ' ראשונה דק\"ש,"
        },
        {
          "s": 8,
          "text": "שתחילה נאמר ושננתם ואח\"כ נאמר וקשרתם,"
        },
        {
          "s": 9,
          "text": "כהדעה שתלמוד גדול"
        },
        {
          "s": 10,
          "text": "(שהרי קדימה בתורה מורה על קדימה במעלה),"
        },
        {
          "s": 11,
          "text": "והסדר בפ' שני' דק\"ש,"
        },
        {
          "s": 12,
          "text": "שתחילה נאמר וקשרתם ואח\"כ נאמר ולמדתם,"
        },
        {
          "s": 13,
          "text": "כהדעה שמעשה גדול72."
        },
        {
          "s": 14,
          "text": "והענין בזה,"
        },
        {
          "s": 15,
          "text": "דהנה,"
        },
        {
          "s": 16,
          "text": "ענין התלמוד הוא בפשטות כדי לדעת את המעשה אשר יעשון ואלה אשר לא תעשינה73"
        },
        {
          "s": 17,
          "text": "(שזהו כללות ענין המצוות,"
        },
        {
          "s": 18,
          "text": "מצוות עשה ומצוות לא תעשה),"
        },
        {
          "s": 19,
          "text": "ורק אח\"כ אפ\"ל קיום המצוות בפועל."
        },
        {
          "s": 20,
          "text": "וזהו הטעם שתלמוד גדול,"
        },
        {
          "s": 21,
          "text": "לפי שהלימוד מביא לידי מעשה"
        },
        {
          "s": 22,
          "text": "(כמבואר בהלכות ת\"ת לאדה\"ז74)."
        },
        {
          "s": 23,
          "text": "והיינו,"
        },
        {
          "s": 24,
          "text": "שענין התלמוד קשור עם הראש שבאדם,"
        },
        {
          "s": 25,
          "text": "שנקרא בשם ראש לפי שקודם במעלה ומושל ושולט על כל הגוף כולו,"
        },
        {
          "s": 26,
          "text": "שדוגמתו הו\"ע המצוות,"
        },
        {
          "s": 27,
          "text": "רמ\"ח מ\"ע כנגד רמ\"ח אברים ושס\"ה מל\"ת כנגד שס\"ה גידים75,"
        },
        {
          "s": 28,
          "text": "שהם למטה מהראש,"
        },
        {
          "s": 29,
          "text": "שלכן צ\"ל תחילה החלטת הראש כיצד תהי' הנהגת הגוף."
        },
        {
          "s": 30,
          "text": "ורק שכאשר ישנם כבר ב' הענינים דתורה ומצוות,"
        },
        {
          "s": 31,
          "text": "אזי יש מקום לב' דעות מה קדם,"
        },
        {
          "s": 32,
          "text": "לימוד או עשי',"
        },
        {
          "s": 33,
          "text": "ועד לדעה הב' שמעשה גדול,"
        },
        {
          "s": 34,
          "text": "מצד העילוי שע\"י הירידה למטה דוקא"
        },
        {
          "s": 35,
          "text": "(שזהו ע\"ד כללות העילוי דחודש אב,"
        },
        {
          "s": 36,
          "text": "כנ\"ל)."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ואעפ\"כ נאמר ושננתם לפני וקשרתם,"
        },
        {
          "s": 1,
          "text": "תלמוד לפני מעשה,"
        },
        {
          "s": 2,
          "text": "כי,"
        },
        {
          "s": 3,
          "text": "אע\"פ שגדלה מעלת המעשה,"
        },
        {
          "s": 4,
          "text": "מ\"מ,"
        },
        {
          "s": 5,
          "text": "כדי שיוכל להיות ענין המעשה צ\"ל תחילה ענין התלמוד שמביא לידי מעשה."
        },
        {
          "s": 6,
          "text": "וכמו שהוא בכללות עבודת האדם,"
        },
        {
          "s": 7,
          "text": "דאף שנת\"ל"
        },
        {
          "s": 8,
          "text": "(ס\"ד)"
        },
        {
          "s": 9,
          "text": "שחיות האדם היא דוקא ע\"י מוצא פי הוי' שבלחם שלמטה מן האדם"
        },
        {
          "s": 10,
          "text": "(מצד מעלת הירידה למטה דוקא),"
        },
        {
          "s": 11,
          "text": "מ\"מ,"
        },
        {
          "s": 12,
          "text": "כדי שיחי' האדם ע\"י אכילת הלחם צריך להכין תחילה את הלחם שיהי' ראוי למאכל אדם,"
        },
        {
          "s": 13,
          "text": "כדאיתא בגמרא76"
        },
        {
          "s": 14,
          "text": "אדם מביא חטין חטין כוסס"
        },
        {
          "s": 15,
          "text": "(בתמי'),"
        },
        {
          "s": 16,
          "text": "אלא צריך לעשות החיטים מאכל אדם"
        },
        {
          "s": 17,
          "text": "(ע\"י העזר כנגדו77)."
        },
        {
          "s": 18,
          "text": "וכמו\"כ הוא בענין תלמוד ומעשה,"
        },
        {
          "s": 19,
          "text": "שאף שמעשה גדול"
        },
        {
          "s": 20,
          "text": "(מצד מעלת הירידה למטה),"
        },
        {
          "s": 21,
          "text": "מ\"מ,"
        },
        {
          "s": 22,
          "text": "כדי שיוכל להיות ענין המעשה צריך להיות הקדמת התלמוד."
        },
        {
          "s": 23,
          "text": "ועי\"ז ניתוסף גם בהתלמוד העילוי דמעשה,"
        },
        {
          "s": 24,
          "text": "כשם שניתוסף בהאדם ע\"י אכילת הלחם,"
        },
        {
          "s": 25,
          "text": "כנ\"ל."
        }
      ]
    }
  ]
}