{
  "globalIndex": 1007,
  "owner": 7,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919765_theRebbe_137__p003",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919765_theRebbe_137__p003",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919765_theRebbe_137",
  "title": "מאמר קץ שם לחושך תשכ\"ד",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "אלא שמ\"מ,"
        },
        {
          "s": 1,
          "text": "גם הביטול דאור ע\"י שנרגש בו מקורו אינו ביטול לגמרי."
        },
        {
          "s": 2,
          "text": "דכיון שהאור והמקור שלו הם שני ענינים,"
        },
        {
          "s": 3,
          "text": "והאור הוא מחוץ למקורו,"
        },
        {
          "s": 4,
          "text": "הרי זה שהאור מרגיש את מקורו הוא שנרגש בו דבר שחוץ ממנו,"
        },
        {
          "s": 5,
          "text": "שאין זה נוגע לעצם מציאותו."
        },
        {
          "s": 6,
          "text": "ולכן,"
        },
        {
          "s": 7,
          "text": "הביטול שע\"י הרגש זה הוא רק בההתפשטות שלו ולא בעצם מציאותו."
        },
        {
          "s": 8,
          "text": "ועיקר הביטול דאור"
        },
        {
          "s": 9,
          "text": "(ביטול לגמרי)"
        },
        {
          "s": 10,
          "text": "הוא הביטול שמצד הרצוא שלו ליכלל במקורו."
        },
        {
          "s": 11,
          "text": "דכיון שרצון נוגע לעצם מציאותו"
        },
        {
          "s": 12,
          "text": "[כפירוש הבעש\"ט22"
        },
        {
          "s": 13,
          "text": "עה\"פ23"
        },
        {
          "s": 14,
          "text": "שרפים עומדים ממעל לו,"
        },
        {
          "s": 15,
          "text": "שע\"י הרצון שלהם ליכלל באוא\"ס הם"
        },
        {
          "s": 16,
          "text": "(כמו)"
        },
        {
          "s": 17,
          "text": "נמצאים"
        },
        {
          "s": 18,
          "text": "(עומדים)"
        },
        {
          "s": 19,
          "text": "שם."
        },
        {
          "s": 20,
          "text": "וע\"ד רצון האדם,"
        },
        {
          "s": 21,
          "text": "דבמקום שרצונו של אדם,"
        },
        {
          "s": 22,
          "text": "שם הוא נמצא,"
        },
        {
          "s": 23,
          "text": "ויתירה מזו,"
        },
        {
          "s": 24,
          "text": "ששם הוא נמצא כולו24],"
        },
        {
          "s": 25,
          "text": "לכן,"
        },
        {
          "s": 26,
          "text": "ע\"י שרוצה ליכלל במקורו הוא"
        },
        {
          "s": 27,
          "text": "(כמו)"
        },
        {
          "s": 28,
          "text": "כלול במקורו."
        },
        {
          "s": 29,
          "text": "ולכן,"
        },
        {
          "s": 30,
          "text": "הביטול שלו מצד הרצון ליכלל במקורו הוא ביטול לגמרי"
        },
        {
          "s": 31,
          "text": "(ע\"ד הביטול דאור הכלול במאור)."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 2,
          "text": "שג' המדריגות בהביטול דאור הם בג' מדריגות שבאור."
        },
        {
          "s": 3,
          "text": "הביטול דאור מצד עצמו הוא בהאור המתלבש בכלים."
        },
        {
          "s": 4,
          "text": "הביטול דאור מפני שנרגש בו מקורו הוא בהאור שלמעלה מהתלבשות בכלים,"
        },
        {
          "s": 5,
          "text": "אבל בגדר התלבשות."
        },
        {
          "s": 6,
          "text": "והביטול דאור שמצד טבע הרצוא והעלי' שלו ליכלל במקורו הוא בהאור שלמעלה מגדר התלבשות."
        },
        {
          "s": 7,
          "text": "וג' מדריגות שבאור כמו שהם בענין הספירות הם בינה חכמה וכתר."
        },
        {
          "s": 8,
          "text": "אור המתלבש בכלים הוא בבינה,"
        },
        {
          "s": 9,
          "text": "כי בבינה הוא חיבור האור עם הכלי."
        },
        {
          "s": 10,
          "text": "דזהו שבבינה הוא הוי' בניקוד אלקים25,"
        },
        {
          "s": 11,
          "text": "כי בבינה הוא חיבור האור"
        },
        {
          "s": 12,
          "text": "(הוי')"
        },
        {
          "s": 13,
          "text": "עם הכלים"
        },
        {
          "s": 14,
          "text": "(אלקים)26."
        },
        {
          "s": 15,
          "text": "האור שלמעלה מהתלבשות בכלים אבל בגדר התלבשות הוא בחכמה."
        },
        {
          "s": 16,
          "text": "והאור שלמעלה מגדר התלבשות הוא בכתר."
        },
        {
          "s": 17,
          "text": "וזהו שהביטול דדעת עליון,"
        },
        {
          "s": 18,
          "text": "שכולא קמי' כלא חשיב,"
        },
        {
          "s": 19,
          "text": "הוא דוקא בחכמה שלמעלה מהבינה27,"
        },
        {
          "s": 20,
          "text": "כי הביטול דכלא חשיב הוא מצד זה שנרגש בו מקורו,"
        },
        {
          "s": 21,
          "text": "ולכן ביטול זה הוא דוקא בחכמה – אור שלמעלה מהתלבשות"
        },
        {
          "s": 22,
          "text": "(אבל בגדר התלבשות)."
        },
        {
          "s": 23,
          "text": "והביטול שבכתר"
        },
        {
          "s": 24,
          "text": "(אור שלמעלה מגדר התלבשות)"
        },
        {
          "s": 25,
          "text": "הוא ביטול נעלה יותר גם מהביטול דחכמה,"
        },
        {
          "s": 26,
          "text": "שהביטול דחכמה הוא הביטול דהוא לבדו הוא ואין זולתו28,"
        },
        {
          "s": 27,
          "text": "הביטול דאין,"
        },
        {
          "s": 28,
          "text": "ובכתר הוא הביטול דאפס."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דזה שהביטול דאור שמצד עצמו הוא באור המתלבש בכלים והביטול דאור שמצד הרגש מקורו ומצד הרצוא ליכלל במקורו הוא בהאור שלמעלה מהתלבשות,"
        },
        {
          "s": 2,
          "text": "הוא,"
        },
        {
          "s": 3,
          "text": "כי ענין האור הוא גילוי,"
        },
        {
          "s": 4,
          "text": "וכיון שעיקר הגילוי שבאור הוא ע\"י התלבשותו בכלים,"
        },
        {
          "s": 5,
          "text": "לכן,"
        },
        {
          "s": 6,
          "text": "האור"
        },
        {
          "s": 7,
          "text": "(כמו שהוא מצד עצמו)"
        },
        {
          "s": 8,
          "text": "יורד ונמשך להתלבש בכלים."
        },
        {
          "s": 9,
          "text": "דהגם שהכלים הם היפך האור,"
        },
        {
          "s": 10,
          "text": "שהאור הוא אין והכלים הם יש"
        },
        {
          "s": 11,
          "text": "(כמובא לעיל סעיף ג מהמאמר),"
        },
        {
          "s": 12,
          "text": "מ\"מ,"
        },
        {
          "s": 13,
          "text": "כיון שהביטול"
        },
        {
          "s": 14,
          "text": "(אין)"
        },
        {
          "s": 15,
          "text": "דאור שמצד עצמו הוא זה שענינו הוא גילוי המאור,"
        },
        {
          "s": 16,
          "text": "לכן,"
        },
        {
          "s": 17,
          "text": "מצד זה גופא הוא יורד ונמשך להתלבש בכלים,"
        },
        {
          "s": 18,
          "text": "בכדי שהגילוי שלו יהי' בשלימות29."
        },
        {
          "s": 19,
          "text": "אבל כשנרגש בהאור המקור שלו שמובדל מגילוי,"
        },
        {
          "s": 20,
          "text": "עי\"ז הוא מתבטל מענין הגילוי"
        },
        {
          "s": 21,
          "text": "(כנ\"ל סעיף ג)"
        },
        {
          "s": 22,
          "text": "ואינו נמשך ומתלבש בכלים."
        },
        {
          "s": 23,
          "text": "אלא שמ\"מ,"
        },
        {
          "s": 24,
          "text": "כיון שהביטול שלו ע\"י שנרגש בו מקורו הוא רק בהתפשטותו ולא בעצם מציאותו"
        },
        {
          "s": 25,
          "text": "(כנ\"ל שם),"
        },
        {
          "s": 26,
          "text": "לכן,"
        },
        {
          "s": 27,
          "text": "הביטול שלו הוא באופן שנשאר עדיין בהגדר שלו,"
        },
        {
          "s": 28,
          "text": "גדר הגילוי,"
        },
        {
          "s": 29,
          "text": "ולכן הוא בגדר התלבשות בכלים."
        },
        {
          "s": 30,
          "text": "וע\"י הביטול דאור שמצד הרצוא ליכלל במקורו,"
        },
        {
          "s": 31,
          "text": "כיון שביטול זה הוא בעצם מציאותו,"
        },
        {
          "s": 32,
          "text": "לכן,"
        },
        {
          "s": 33,
          "text": "ע\"י ביטול זה אינו"
        },
        {
          "s": 34,
          "text": "(גם)"
        },
        {
          "s": 35,
          "text": "בגדר התלבשות בכלים."
        }
      ]
    }
  ]
}