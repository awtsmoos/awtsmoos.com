{
  "globalIndex": 1023,
  "owner": 23,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919837_theRebbe_328__p001",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919837_theRebbe_328__p001",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919837_theRebbe_328",
  "title": "מאמר לא היו ימים טובים לישראל תשמ\"ז",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "יום ב' פ' עקב,"
        },
        {
          "s": 2,
          "text": "חמשה עשר באב ה'תשמ\"ז*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "לא."
        },
        {
          "s": 1,
          "text": "היו ימים טובים לישראל כחמשה עשר באב וכיום הכפורים1,"
        },
        {
          "s": 2,
          "text": "ומביא אדמו\"ר"
        },
        {
          "s": 3,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 4,
          "text": "נ\"ע במאמרו המבאר ענין חמשה עשר באב2,"
        },
        {
          "s": 5,
          "text": "דאיתא בפע\"ח3"
        },
        {
          "s": 6,
          "text": "שהיו\"ט דט\"ו באב הוא שאז הוא שלימות4"
        },
        {
          "s": 7,
          "text": "מילוי הלבנה"
        },
        {
          "s": 8,
          "text": "[והענינים שאירעו בחמשה עשר באב"
        },
        {
          "s": 9,
          "text": "(המנוים בגמרא5)"
        },
        {
          "s": 10,
          "text": "הם כמו תוצאות מענינו העיקרי של יום זה – שלימות מילוי הלבנה]."
        },
        {
          "s": 11,
          "text": "ומדייק בהמאמר,"
        },
        {
          "s": 12,
          "text": "הרי זה שביום הט\"ו קיימא סיהרא באשלמותא6"
        },
        {
          "s": 13,
          "text": "הוא בכל חודש,"
        },
        {
          "s": 14,
          "text": "ואעפ\"כ לא נקבעו ליו\"ט מלבד פסח"
        },
        {
          "s": 15,
          "text": "(ט\"ו בניסן)"
        },
        {
          "s": 16,
          "text": "וסוכות"
        },
        {
          "s": 17,
          "text": "(ט\"ו בתשרי)."
        },
        {
          "s": 18,
          "text": "וביותר אינו מובן,"
        },
        {
          "s": 19,
          "text": "שמפשטות הלשון לא היו ימים טובים לישראל כחמשה עשר באב כו' משמע שהוא יו\"ט גדול יותר מכל הימים טובים,"
        },
        {
          "s": 20,
          "text": "גם מהימים טובים דפסח וסוכות,"
        },
        {
          "s": 21,
          "text": "אף שגם ימים טובים אלה הם בט\"ו בחודש7."
        },
        {
          "s": 22,
          "text": "ונקודת הביאור בזה"
        },
        {
          "s": 23,
          "text": "(בהמאמר),"
        },
        {
          "s": 24,
          "text": "שעיקר המעלה דמילוי ושלימות הלבנה ביום הט\"ו הזה הוא שהמילוי והשלימות הוא לאחרי חסרון,"
        },
        {
          "s": 25,
          "text": "שלאחרי חסרון היא שלימות נעלית יותר מהשלימות שמצד עצמה,"
        },
        {
          "s": 26,
          "text": "כידוע8"
        },
        {
          "s": 27,
          "text": "הכלל בעליות וירידות,"
        },
        {
          "s": 28,
          "text": "דהעלי' שלאחרי ירידה היא עלי' למעלה יותר מהדרגא שלפני הירידה,"
        },
        {
          "s": 29,
          "text": "וכל שהירידה היא ביותר,"
        },
        {
          "s": 30,
          "text": "העלי' היא ביותר."
        },
        {
          "s": 31,
          "text": "ולכן עיקר המעלה דמילוי הלבנה הוא בט\"ו באב,"
        },
        {
          "s": 32,
          "text": "כי בחודש אב,"
        },
        {
          "s": 33,
          "text": "הירידה דהלבנה"
        },
        {
          "s": 34,
          "text": "(וישראל דדומין ללבנה9)"
        },
        {
          "s": 35,
          "text": "היא ירידה גדולה ביותר,"
        },
        {
          "s": 36,
          "text": "ולכן העלי' דט\"ו באב"
        },
        {
          "s": 37,
          "text": "(שלאחרי הירידה דתשעה באב)"
        },
        {
          "s": 38,
          "text": "היא עלי' גדולה ביותר."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "דענין הנ\"ל שהיו\"ט דט\"ו באב הוא לפי שאז היא העלי' שלאחרי הירידה דתשעה באב מרומז גם בזה שהענין הראשון שאירע בט\"ו באב הוא שכלו בו מתי מדבר10."
        },
        {
          "s": 3,
          "text": "דענין מתי מדבר קשור עם תשעה באב,"
        },
        {
          "s": 4,
          "text": "שבת\"ב נגזר על דור המדבר שימותו במדבר ולא יכנסו לארץ1,"
        },
        {
          "s": 5,
          "text": "וגם קיום הגזירה היתה בתשעה באב,"
        },
        {
          "s": 6,
          "text": "שבכל ת\"ב"
        },
        {
          "s": 7,
          "text": "(דל\"ט שנים האחרונות שהיו במדבר)"
        },
        {
          "s": 8,
          "text": "היו עושין קבריהן11."
        },
        {
          "s": 9,
          "text": "והיו\"ט דט\"ו באב שבו כלו מתי מדבר הוא העלי' שלאחרי הירידה דתשעה באב12."
        },
        {
          "s": 10,
          "text": "ומזה מובן גם בנוגע ל"
        },
        {
          "s": 11,
          "text": "(עיקר)"
        },
        {
          "s": 12,
          "text": "הירידה דתשעה באב שבו חרב הבית בראשונה ובשני'1"
        },
        {
          "s": 13,
          "text": "[ובפרט שגם גזירת החורבן היתה באותו היום13"
        },
        {
          "s": 14,
          "text": "(תשעה באב דשנה ראשונה שהיו במדבר)"
        },
        {
          "s": 15,
          "text": "שבו נגזר על דור המדבר שלא יכנסו לארץ,"
        },
        {
          "s": 16,
          "text": "ושתי הגזירות היו בשביל אותו החטא"
        },
        {
          "s": 17,
          "text": "(חטא המרגלים)13],"
        },
        {
          "s": 18,
          "text": "שבט\"ו באב מאיר מעין הגילוי דלעתיד14,"
        },
        {
          "s": 19,
          "text": "שעיקרו15"
        },
        {
          "s": 20,
          "text": "הוא בנין ביהמ\"ק השלישי16"
        },
        {
          "s": 21,
          "text": "– העלי' שלאחרי הירידה דחורבן בית ראשון ושני."
        }
      ]
    }
  ]
}