{
  "globalIndex": 799,
  "owner": 49,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918549_theRebbe_741__p005",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918549_theRebbe_741__p005",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918549_theRebbe_741",
  "title": "מאמר לה\"ע רשב\"י תשמ\"ה",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וע\"פ כל הנ\"ל יובן גם הקשר דהסתלקות רשב\"י עם ספירת העומר,"
        },
        {
          "s": 2,
          "text": "ועד שיום הסתלקותו נק'"
        },
        {
          "s": 3,
          "text": "(ע\"פ מנהג ישראל תורה היא92)"
        },
        {
          "s": 4,
          "text": "בשם ל\"ג בעומר93."
        },
        {
          "s": 5,
          "text": "והענין הוא,"
        },
        {
          "s": 6,
          "text": "דהעבודה דספירת העומר היא בירור המדות דנפש הבהמית94,"
        },
        {
          "s": 7,
          "text": "ואעפ\"כ"
        },
        {
          "s": 8,
          "text": "(ואדרבא,"
        },
        {
          "s": 9,
          "text": "מצד זה),"
        },
        {
          "s": 10,
          "text": "דוקא במצוה זו אומרים95"
        },
        {
          "s": 11,
          "text": "ועל ידי זה יושפע שפע רב בכל העולמות,"
        },
        {
          "s": 12,
          "text": "כי עבודת הבירורים דוקא מגעת למעלה מעלה,"
        },
        {
          "s": 13,
          "text": "וממשכת משם שפע,"
        },
        {
          "s": 14,
          "text": "לא אור שהוא הארה בלבד אלא שפע שהוא מהות הדבר96,"
        },
        {
          "s": 15,
          "text": "ויתירה מזו – שפע רב,"
        },
        {
          "s": 16,
          "text": "ולהיותו שפע רב לכן97"
        },
        {
          "s": 17,
          "text": "(מצד הריבוי שבו)"
        },
        {
          "s": 18,
          "text": "הוא נמשך ונשפע בכל העולמות,"
        },
        {
          "s": 19,
          "text": "עד לעולם הזה התחתון,"
        },
        {
          "s": 20,
          "text": "ובעוה\"ז גופא למקום הכי תחתון שאין תחתון למטה ממנו."
        },
        {
          "s": 21,
          "text": "וי\"ל שזהו הקשר דימי הספירה"
        },
        {
          "s": 22,
          "text": "[ובהם גופא,"
        },
        {
          "s": 23,
          "text": "דיום הל\"ג בעומר,"
        },
        {
          "s": 24,
          "text": "סוף ותשלום העבודה דספה\"ע בעיקרי המדות98]"
        },
        {
          "s": 25,
          "text": "להסתלקות רשב\"י,"
        },
        {
          "s": 26,
          "text": "כי עבודתו של רשב\"י היתה לרפא ולבטל את המחיצות שבין כל הענינים,"
        },
        {
          "s": 27,
          "text": "ולהמשיך מלמעלה מעלה עד למטה מטה,"
        },
        {
          "s": 28,
          "text": "מבחינת איתן בבחינת ארץ."
        },
        {
          "s": 29,
          "text": "וענין זה עומד בגלוי ביום הסתלקותו בל\"ג בעומר,"
        },
        {
          "s": 30,
          "text": "כמבואר באגרת הקודש לאדה\"ז99"
        },
        {
          "s": 31,
          "text": "שביום ההסתלקות הנה כל עבודת האדם אשר עבד במשך ימי חייו עומדת בגלוי כפי שהיא בשרשה ומקורה,"
        },
        {
          "s": 32,
          "text": "וכמבואר בארוכה בדרושי ל\"ג בעומר בסידור לאדמו\"ר האמצעי100."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "וענין זה נמשך למטה מטה עד לשמחה כפשוטה101."
        },
        {
          "s": 1,
          "text": "ועד שמזה נמשכת שמחה גדולה ביותר,"
        },
        {
          "s": 2,
          "text": "עד לשמחה הפורצת גדר102,"
        },
        {
          "s": 3,
          "text": "שמחת עולם103,"
        },
        {
          "s": 4,
          "text": "הפורצת את גדרי הגלות,"
        },
        {
          "s": 5,
          "text": "ומביאה את הגאולה האמיתית והשלימה ע\"י משיח צדקנו,"
        },
        {
          "s": 6,
          "text": "דמשיח אתא לאתבא צדיקייא בתיובתא55."
        },
        {
          "s": 7,
          "text": "וזה קשור גם עם ענין הפצת המעינות,"
        },
        {
          "s": 8,
          "text": "אימתי אתי מר לכשיפוצו מעינותיך חוצה104,"
        },
        {
          "s": 9,
          "text": "במהרה בימינו ממש,"
        },
        {
          "s": 10,
          "text": "ובעגלא דידן105."
        }
      ]
    }
  ]
}