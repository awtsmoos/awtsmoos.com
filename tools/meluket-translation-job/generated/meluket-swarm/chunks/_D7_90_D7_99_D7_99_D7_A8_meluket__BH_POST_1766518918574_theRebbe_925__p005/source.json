{
  "globalIndex": 804,
  "owner": 4,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918574_theRebbe_925__p005",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918574_theRebbe_925__p005",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918574_theRebbe_925",
  "title": "מאמר פתח רבי שמעון תשל\"ד",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "והנה אף שזה דבחד קטירא אתקטרנא,"
        },
        {
          "s": 2,
          "text": "ומכ\"ש זה דבי' אחידא,"
        },
        {
          "s": 3,
          "text": "היא מדריגה נעלית ביותר,"
        },
        {
          "s": 4,
          "text": "מ\"מ,"
        },
        {
          "s": 5,
          "text": "ע\"י שפתח ר\"ש ואמר בחד קטירא אתקטרנא כו',"
        },
        {
          "s": 6,
          "text": "דפירוש \"פתח\" הוא62"
        },
        {
          "s": 7,
          "text": "שפתח את הצנור,"
        },
        {
          "s": 8,
          "text": "ניתן הכח לכאו\"א מישראל שיהי' אצלו אפס קצהו ושמץ מנהו63"
        },
        {
          "s": 9,
          "text": "דענין זה,"
        },
        {
          "s": 10,
          "text": "שלימוד התורה שלו יהי' באופן דנפשו קשורה להתורה בכל פנימיותו,"
        },
        {
          "s": 11,
          "text": "דהגם שישנם זמנים שמוכרח להפסיק מלימוד התורה64,"
        },
        {
          "s": 12,
          "text": "מ\"מ,"
        },
        {
          "s": 13,
          "text": "בעת הלימוד יהי' זה"
        },
        {
          "s": 14,
          "text": "(לימוד התורה)"
        },
        {
          "s": 15,
          "text": "כל מציאותו,"
        },
        {
          "s": 16,
          "text": "ועד שיהי' חד עם התורה ועם נותן התורה,"
        },
        {
          "s": 17,
          "text": "חד ממש65."
        },
        {
          "s": 18,
          "text": "והנתינת כח לזה ביתר שאת היא ע\"י לימוד פנימיות התורה,"
        },
        {
          "s": 19,
          "text": "תורתו של רשב\"י66,"
        },
        {
          "s": 20,
          "text": "שעי\"ז ישנו הכח"
        },
        {
          "s": 21,
          "text": "(עוד יותר)"
        },
        {
          "s": 22,
          "text": "להתקשר ולהתאחד עם התורה ונותן התורה."
        },
        {
          "s": 23,
          "text": "וע\"י הלימוד וההפצה דתורתו של רשב\"י,"
        },
        {
          "s": 24,
          "text": "שבדורותינו אלה נתגלתה בתורת החסידות,"
        },
        {
          "s": 25,
          "text": "מקרבים גם את הגאולה,"
        },
        {
          "s": 26,
          "text": "וכהבטחת מלך המשיח להבעש\"ט67"
        },
        {
          "s": 27,
          "text": "דלכשיפוצו מעינותיך חוצה אתי מר דא מלכא משיחא,"
        },
        {
          "s": 28,
          "text": "וכדאיתא בזהר68"
        },
        {
          "s": 29,
          "text": "דבהאי חיבורא דילך"
        },
        {
          "s": 30,
          "text": "(דהרשב\"י)"
        },
        {
          "s": 31,
          "text": "כו' יפקון בי' מן גלותא ברחמים."
        }
      ]
    }
  ]
}