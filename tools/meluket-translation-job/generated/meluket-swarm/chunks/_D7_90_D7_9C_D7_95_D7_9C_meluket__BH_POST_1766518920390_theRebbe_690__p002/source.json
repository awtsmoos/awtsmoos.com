{
  "globalIndex": 1102,
  "owner": 2,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920390_theRebbe_690__p002",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920390_theRebbe_690__p002",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920390_theRebbe_690",
  "title": "מאמר את הוי' האמרת תש\"ל",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ויובן כל זה בהקדים מה שמביא אדמו\"ר הצ\"צ"
        },
        {
          "s": 2,
          "text": "(במאמרו הנ\"ל)20"
        },
        {
          "s": 3,
          "text": "מ\"ש הבחיי21"
        },
        {
          "s": 4,
          "text": "דבפסוק את ה' האמרת וגו' יש ט\"ו תיבות כנגד ט\"ו דברים22"
        },
        {
          "s": 5,
          "text": "שהיו במשכן."
        },
        {
          "s": 6,
          "text": "ובבחיי שם,"
        },
        {
          "s": 7,
          "text": "ש\"המשכן דוגמת בריאת העולם,"
        },
        {
          "s": 8,
          "text": "וטעם הדבר בבריאת עולם ובמשכן,"
        },
        {
          "s": 9,
          "text": "כדי לרמוז מש\"כ23"
        },
        {
          "s": 10,
          "text": "כי בי\"ה ה' צור עולמים\"."
        },
        {
          "s": 11,
          "text": "והיינו,"
        },
        {
          "s": 12,
          "text": "דט\"ו הדברים שבמשכן רומזים על י\"ה"
        },
        {
          "s": 13,
          "text": "(בגימטריא ט\"ו)."
        },
        {
          "s": 14,
          "text": "ומזה מובן גם בנוגע לט\"ו התיבות שבפסוק את ה' האמרת,"
        },
        {
          "s": 15,
          "text": "שהם רומזים על י\"ה."
        },
        {
          "s": 16,
          "text": "וממשיך בבחיי שם,"
        },
        {
          "s": 17,
          "text": "שכנגדן"
        },
        {
          "s": 18,
          "text": "(כנגד הט\"ו דברים שבמשכן)"
        },
        {
          "s": 19,
          "text": "נמצאו ט\"ו פעמים ת\"ק בשבעה רקיעים24."
        },
        {
          "s": 20,
          "text": "ומבאר בהמאמר20,"
        },
        {
          "s": 21,
          "text": "דזהו גם מה שואתחנן בגימט' תקט\"ו25,"
        },
        {
          "s": 22,
          "text": "ט\"ו פעמים ת\"ק."
        },
        {
          "s": 23,
          "text": "וע\"פ המבואר במק\"א26"
        },
        {
          "s": 24,
          "text": "דענין ואתחנן בגימט' תקט\"ו"
        },
        {
          "s": 25,
          "text": "(שת\"ק וט\"ו הם בתיבה אחת27)"
        },
        {
          "s": 26,
          "text": "הוא חיבור ויחוד בחינת ט\"ו"
        },
        {
          "s": 27,
          "text": "(י\"ה)"
        },
        {
          "s": 28,
          "text": "עם בחינת ת\"ק"
        },
        {
          "s": 29,
          "text": "(כדלקמן),"
        },
        {
          "s": 30,
          "text": "יש לומר,"
        },
        {
          "s": 31,
          "text": "דזה שבפסוק את הוי' האמרת יש ט\"ו תיבות"
        },
        {
          "s": 32,
          "text": "(וכן זה שבמשכן היו ט\"ו דברים)"
        },
        {
          "s": 33,
          "text": "שרומז על י\"ה"
        },
        {
          "s": 34,
          "text": "(כנ\"ל)"
        },
        {
          "s": 35,
          "text": "הכוונה בזה היא"
        },
        {
          "s": 36,
          "text": "(לא לבחי' י\"ה כמו שהיא בפ\"ע,"
        },
        {
          "s": 37,
          "text": "כי אם)"
        },
        {
          "s": 38,
          "text": "לבחי' י\"ה כמו שהיא מחוברת ומיוחדת עם בחי' ת\"ק28."
        },
        {
          "s": 39,
          "text": "ויובן זה ע\"פ מרז\"ל"
        },
        {
          "s": 40,
          "text": "(שהובא לעיל)"
        },
        {
          "s": 41,
          "text": "דענין את הוי' האמרת הוא אתם עשיתוני חטיבה אחת כו' הוי' אחד,"
        },
        {
          "s": 42,
          "text": "שיש בזה שני פירושים."
        },
        {
          "s": 43,
          "text": "פירוש א',"
        },
        {
          "s": 44,
          "text": "דהוי' אחד הוא כמ\"ש האריז\"ל עה\"פ29"
        },
        {
          "s": 45,
          "text": "ביום ההוא יהי' הוי' אחד,"
        },
        {
          "s": 46,
          "text": "שי\"ה עם ו\"ה יהיו \"מקושרים באחדות א'\","
        },
        {
          "s": 47,
          "text": "חיבור מוחין ומדות30."
        },
        {
          "s": 48,
          "text": "ופירוש הב' הוא,"
        },
        {
          "s": 49,
          "text": "דפירוש הוי' אחד הוא ע\"ד אני הוי',"
        },
        {
          "s": 50,
          "text": "דאני שהוא עצמות אוא\"ס עם שם הוי',"
        },
        {
          "s": 51,
          "text": "כולא חד ממש31."
        },
        {
          "s": 52,
          "text": "וזהו מה שט\"ו התיבות"
        },
        {
          "s": 53,
          "text": "(בגמטריא י\"ה)"
        },
        {
          "s": 54,
          "text": "שבפסוק את הוי' האמרת רומזות לבחי' י\"ה כמו שהיא מחוברת ומיוחדת עם בחי' ת\"ק,"
        },
        {
          "s": 55,
          "text": "כי גם בהחיבור ויחוד דט\"ו עם ת\"ק"
        },
        {
          "s": 56,
          "text": "(שבתיבת ואתחנן)"
        },
        {
          "s": 57,
          "text": "יש שני פירושים,"
        },
        {
          "s": 58,
          "text": "דוגמת שני הפירושים הנ\"ל בהוי' אחד."
        },
        {
          "s": 59,
          "text": "פירוש א',"
        },
        {
          "s": 60,
          "text": "דת\"ק קאי על המדות שלמטה מהמוחין32."
        },
        {
          "s": 61,
          "text": "כי עיקרי המדות הם ה' המדות שמחסד עד הוד33,"
        },
        {
          "s": 62,
          "text": "וכל אחד מהם כלול מיו\"ד ויו\"ד מיו\"ד,"
        },
        {
          "s": 63,
          "text": "בגימטריא ת\"ק34."
        },
        {
          "s": 64,
          "text": "וזהו גם זה שהענינים שבעולם הם במספר ת\"ק35,"
        },
        {
          "s": 65,
          "text": "כי שרש הנבראים הוא מהמדות."
        },
        {
          "s": 66,
          "text": "ועפ\"ז,"
        },
        {
          "s": 67,
          "text": "ענין ואתחנן בגימטריא תקט\"ו"
        },
        {
          "s": 68,
          "text": "(שת\"ק וט\"ו הם בתיבה אחת)"
        },
        {
          "s": 69,
          "text": "הוא חיבור המוחין"
        },
        {
          "s": 70,
          "text": "(י\"ה בגימטריא ט\"ו)"
        },
        {
          "s": 71,
          "text": "עם המדות"
        },
        {
          "s": 72,
          "text": "(ת\"ק)36,"
        },
        {
          "s": 73,
          "text": "כפירוש הראשון בהוי' אחד."
        },
        {
          "s": 74,
          "text": "ופירוש ב',"
        },
        {
          "s": 75,
          "text": "דת\"ק קאי על המדות דאריך שלמעלה מהמוחין."
        },
        {
          "s": 76,
          "text": "וענין תקט\"ו הוא לקשר ולחבר חו\"ב"
        },
        {
          "s": 77,
          "text": "(י\"ה,"
        },
        {
          "s": 78,
          "text": "ט\"ו)"
        },
        {
          "s": 79,
          "text": "עם הכתר שלמעלה מהשתלשלות37,"
        },
        {
          "s": 80,
          "text": "דוגמת פירוש השני בהוי' אחד,"
        },
        {
          "s": 81,
          "text": "שהוי' ואני"
        },
        {
          "s": 82,
          "text": "(עצמות אוא\"ס שלמעלה מהשתלשלות),"
        },
        {
          "s": 83,
          "text": "הם כולא חד."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יובן גם השייכות דאת ה' האמרת לתפילין דמארי עלמא"
        },
        {
          "s": 2,
          "text": "[דהגם שבתפילין דמארי עלמא כתיב ומי כעמך ישראל גו' שהו\"ע וה' האמירך,"
        },
        {
          "s": 3,
          "text": "הרי שני הענינים דהאמרת והאמירך שייכים זל\"ז38],"
        },
        {
          "s": 4,
          "text": "כי גם בתפילין דמארי עלמא ישנם שני ענינים אלו."
        },
        {
          "s": 5,
          "text": "דתפילין הם ד' מוחין39,"
        },
        {
          "s": 6,
          "text": "ומה שהקב\"ה מניח תפילין,"
        },
        {
          "s": 7,
          "text": "יש בזה שני פירושים40."
        },
        {
          "s": 8,
          "text": "א',"
        },
        {
          "s": 9,
          "text": "דהקב\"ה הוא ז\"א,"
        },
        {
          "s": 10,
          "text": "והקב\"ה מניח תפילין הוא המשכת המוחין לז\"א"
        },
        {
          "s": 11,
          "text": "[היינו,"
        },
        {
          "s": 12,
          "text": "שנמשך בז\"א עצם המוחין."
        },
        {
          "s": 13,
          "text": "דזה שנמשך בהמדות דז\"א מהמוחין כפי שהם מצד סדר ההשתלשלות,"
        },
        {
          "s": 14,
          "text": "הוא רק מבחינת מוחין השייכים למדות,"
        },
        {
          "s": 15,
          "text": "וגם זה על ידי כמה וכמה צמצומים41,"
        },
        {
          "s": 16,
          "text": "ועד שבהתלבשותם בהמדות דז\"א הם נהפכים למהות מדות42,"
        },
        {
          "s": 17,
          "text": "דמוחין שבמדות לגבי מוחין עצמם הם42"
        },
        {
          "s": 18,
          "text": "מהות מדות."
        },
        {
          "s": 19,
          "text": "וענין הקב\"ה מניח תפילין הוא שבהמדות"
        },
        {
          "s": 20,
          "text": "(ז\"א)"
        },
        {
          "s": 21,
          "text": "נמשך עצם המוחין43."
        },
        {
          "s": 22,
          "text": "דזהו מה שהתפילין נקראים פאר,"
        },
        {
          "s": 23,
          "text": "שהקב\"ה ז\"א מתפאר בהם44,"
        },
        {
          "s": 24,
          "text": "דתפארת הוא מענין שבאין ערוך45]."
        },
        {
          "s": 25,
          "text": "וב',"
        },
        {
          "s": 26,
          "text": "דהקב\"ה הוא עצמות אוא\"ס שלמעלה מאצילות,"
        },
        {
          "s": 27,
          "text": "והקב\"ה מניח תפילין הוא המשכת אוא\"ס במוחין."
        },
        {
          "s": 28,
          "text": "[ולפי פירוש זה מובן עוד יותר ענין הפאר דתפילין46,"
        },
        {
          "s": 29,
          "text": "כי תוספת האור שנמשך בהמוחין מעצמות אוא\"ס שלמעלה מאצילות הוא באין ערוך לגמרי]."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "וזהו את הוי' האמרת,"
        },
        {
          "s": 1,
          "text": "האמרת לשון חשיבות ושבח,"
        },
        {
          "s": 2,
          "text": "דזה שהקב\"ה מניח תפילין"
        },
        {
          "s": 3,
          "text": "(הפאר והשבח שלו),"
        },
        {
          "s": 4,
          "text": "זה נעשה על ידי העבודה דישראל."
        },
        {
          "s": 5,
          "text": "וזהו אתם עשיתוני חטיבה אחת"
        },
        {
          "s": 6,
          "text": "(עשיתוני דייקא),"
        },
        {
          "s": 7,
          "text": "כי מצד סדר ההשתלשלות,"
        },
        {
          "s": 8,
          "text": "כפי שנמדד ע\"פ קו המדה,"
        },
        {
          "s": 9,
          "text": "ההמשכה מעליון לתחתון"
        },
        {
          "s": 10,
          "text": "(מהמאציל לאצילות,"
        },
        {
          "s": 11,
          "text": "וכן באצילות מהמוחין למדות)"
        },
        {
          "s": 12,
          "text": "היא מצומצמת כפי כלי התחתון,"
        },
        {
          "s": 13,
          "text": "ובכדי שיהי' הקב\"ה מניח תפילין בשני פירושים הנ\"ל,"
        },
        {
          "s": 14,
          "text": "שהם דוגמת שני הפירושים דלעיל בהוי' אחד"
        },
        {
          "s": 15,
          "text": "(חטיבה אחת),"
        },
        {
          "s": 16,
          "text": "יחוד ו\"ה עם י\"ה ויחוד הוי' עם אני,"
        },
        {
          "s": 17,
          "text": "זה נעשה על ידי העבודה דישראל,"
        },
        {
          "s": 18,
          "text": "אתם עשיתוני."
        }
      ]
    }
  ]
}