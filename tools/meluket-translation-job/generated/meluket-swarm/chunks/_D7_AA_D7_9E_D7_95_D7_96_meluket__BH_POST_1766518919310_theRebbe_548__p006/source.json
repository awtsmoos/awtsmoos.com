{
  "globalIndex": 938,
  "owner": 38,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919310_theRebbe_548__p006",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919310_theRebbe_548__p006",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919310_theRebbe_548",
  "title": "מאמר זה היום עשה ה' תשל\"ח",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "וממשיך במדרש,"
        },
        {
          "s": 1,
          "text": "אמר ר' יצחק47"
        },
        {
          "s": 2,
          "text": "בך בעשרים ושתים אותיות שכתבת לנו בתורה,"
        },
        {
          "s": 3,
          "text": "דזה שע\"י התורה נמשכת הישועה באופן הנ\"ל הוא בעיקר באותיות התורה."
        },
        {
          "s": 4,
          "text": "ושני ענינים בזה."
        },
        {
          "s": 5,
          "text": "כי החיבור דלמעלה מהטבע עם הטבע הוא בכח העצמות"
        },
        {
          "s": 6,
          "text": "(כנ\"ל),"
        },
        {
          "s": 7,
          "text": "ואותיות התורה הם כלים להמשכת העצמות"
        },
        {
          "s": 8,
          "text": "(כמבואר בהמאמר דבעל הגאולה)."
        },
        {
          "s": 9,
          "text": "והחיות של כאו\"א מישראל הוא ע\"י שיש לו אות בתורה48,"
        },
        {
          "s": 10,
          "text": "ולכן,"
        },
        {
          "s": 11,
          "text": "בכדי שיהי' נגילה ונשמחה בך"
        },
        {
          "s": 12,
          "text": "(דענין השמחה היא גילוי החיות עד לגילוי פנימיות החיות49),"
        },
        {
          "s": 13,
          "text": "הוא ע\"י אותיות התורה,"
        },
        {
          "s": 14,
          "text": "שמהם נמשך חיות לכ\"א מישראל."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "והנה ידוע50"
        },
        {
          "s": 2,
          "text": "ששמחה פורצת גדר."
        },
        {
          "s": 3,
          "text": "ומובן,"
        },
        {
          "s": 4,
          "text": "שהגדרים שנפרצים ע\"י השמחה הם רק הגדרים של אותה הבחינה שבה היא השמחה."
        },
        {
          "s": 5,
          "text": "ולכן,"
        },
        {
          "s": 6,
          "text": "כאשר השמחה בהנסים היא מצד הגילויים דממלא וסובב"
        },
        {
          "s": 7,
          "text": "(יום והקב\"ה),"
        },
        {
          "s": 8,
          "text": "שהם בגדר ידיעה"
        },
        {
          "s": 9,
          "text": "(אין אנו יודעים),"
        },
        {
          "s": 10,
          "text": "נשארים עדיין הגדרים שישנם בהבחינות שלמעלה מידיעה."
        },
        {
          "s": 11,
          "text": "משא\"כ ע\"י השמחה דנגילה ונשמחה בך בעצמותך,"
        },
        {
          "s": 12,
          "text": "נעשה פורץ,"
        },
        {
          "s": 13,
          "text": "פריצת כל הגדרים."
        },
        {
          "s": 14,
          "text": "ועי\"ז מיתוסף עוד יותר בהחיבור דלמעלה מהטבע עם הטבע שנעשה ע\"י גילוי העצמות."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "וזהו זה היום עשה ה' נגילה ונשמחה בו,"
        },
        {
          "s": 1,
          "text": "דע\"י השמחה בזה היום"
        },
        {
          "s": 2,
          "text": "(באופן דנגילה ונשמחה בך),"
        },
        {
          "s": 3,
          "text": "מיתוסף עוד יותר בהגאולה,"
        },
        {
          "s": 4,
          "text": "שהיא באופן נעלה עוד יותר מכמו שהיתה בפעם הראשונה"
        },
        {
          "s": 5,
          "text": "(כפי שנמשכה מלמעלה,"
        },
        {
          "s": 6,
          "text": "לפני השמחה)."
        },
        {
          "s": 7,
          "text": "וכיון שבהגאולה די\"ב תמוז נגאלו כאו\"א מישראל,"
        },
        {
          "s": 8,
          "text": "גם אלו אשר בשם ישראל"
        },
        {
          "s": 9,
          "text": "(רק)"
        },
        {
          "s": 10,
          "text": "יכונה51,"
        },
        {
          "s": 11,
          "text": "לכן,"
        },
        {
          "s": 12,
          "text": "גם ההוספה בהגאולה בכל שנה,"
        },
        {
          "s": 13,
          "text": "שנעשית ע\"י שמחת הגאולה,"
        },
        {
          "s": 14,
          "text": "היא נמשכת לכאו\"א מישראל,"
        },
        {
          "s": 15,
          "text": "להגאל מכל הענינים המונעים ומעכבים לתומ\"צ."
        },
        {
          "s": 16,
          "text": "וע\"פ הידוע שכל הגאולות שייכות זל\"ז כי כולם גאולה נקראות52,"
        },
        {
          "s": 17,
          "text": "יש לומר,"
        },
        {
          "s": 18,
          "text": "דע\"י השמחה בחגיגת הגאולה,"
        },
        {
          "s": 19,
          "text": "תהי' הוספה גם בגאולה העתידה,"
        },
        {
          "s": 20,
          "text": "שם נשמחה בו53,"
        },
        {
          "s": 21,
          "text": "בו בעצמותו54,"
        },
        {
          "s": 22,
          "text": "בביאת משיח צדקנו,"
        },
        {
          "s": 23,
          "text": "בקרוב ממש."
        }
      ]
    }
  ]
}