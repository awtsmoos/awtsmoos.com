{
  "globalIndex": 139,
  "owner": 39,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914491_theRebbe_55__p002",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914491_theRebbe_55__p002",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914491_theRebbe_55",
  "title": "מאמר להבין ענין שמח\"ת תשל\"ח",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ויובן זה ע\"פ מה שנת\"ל"
        },
        {
          "s": 2,
          "text": "(ד\"ה בסוכות תשבו10)"
        },
        {
          "s": 3,
          "text": "שכל המועדים דחודש תשרי הם בבחי' של אחת."
        },
        {
          "s": 4,
          "text": "דהנה על ראש השנה ארז\"ל11"
        },
        {
          "s": 5,
          "text": "מצות היום בשופר."
        },
        {
          "s": 6,
          "text": "היינו,"
        },
        {
          "s": 7,
          "text": "דזה מה שהיום דראש השנה הוא חלוק משאר המועדים הוא במצוה אחת"
        },
        {
          "s": 8,
          "text": "(איין און איינציקע מצוה),"
        },
        {
          "s": 9,
          "text": "מצות שופר."
        },
        {
          "s": 10,
          "text": "ובמצוה זו גופא כותב הרמב\"ם12"
        },
        {
          "s": 11,
          "text": "שהיא גזירת הכתוב למעלה מטעם."
        },
        {
          "s": 12,
          "text": "דהגם שהמצוה דשופר גם מרמזת על ענינים הכי נעלים בענין התשובה"
        },
        {
          "s": 13,
          "text": "(כמו שממשיך הרמב\"ם12"
        },
        {
          "s": 14,
          "text": "רמז יש בדבר כו')"
        },
        {
          "s": 15,
          "text": "מ\"מ ענינה הוא גזירת הכתוב למעלה מטעם."
        },
        {
          "s": 16,
          "text": "ועד\"ז הוא גם בנוגע ליום הכפורים"
        },
        {
          "s": 17,
          "text": "[סיום העשרת ימים שבין ראש השנה ליום הכפורים],"
        },
        {
          "s": 18,
          "text": "שהיא בחי' אחת דכל הג' בחי' דעולם שנה נפש."
        },
        {
          "s": 19,
          "text": "שהעבודה המיוחדת דיום הכפורים היא בקודש הקדשים בחי' אחת דעולם"
        },
        {
          "s": 20,
          "text": "(מקום),"
        },
        {
          "s": 21,
          "text": "ביום דיום הכפורים שנקרא13"
        },
        {
          "s": 22,
          "text": "בשם אחת בשנה,"
        },
        {
          "s": 23,
          "text": "בחי' אחת דשנה"
        },
        {
          "s": 24,
          "text": "(זמן),"
        },
        {
          "s": 25,
          "text": "ונעשית ע\"י כה\"ג"
        },
        {
          "s": 26,
          "text": "[אלא שהכה\"ג עושה זה בתור שלוחם של כל ישראל]"
        },
        {
          "s": 27,
          "text": "דכתיב14"
        },
        {
          "s": 28,
          "text": "בי' ויבדל אהרן להקדישו קודש קדשים,"
        },
        {
          "s": 29,
          "text": "בחי' אחת דנפש."
        },
        {
          "s": 30,
          "text": "ועד\"ז הוא גם בנוגע לסוכות,"
        },
        {
          "s": 31,
          "text": "שבענין הסוכה"
        },
        {
          "s": 32,
          "text": "[שמצות ישיבה בסוכה היא במשך כל שבעת ימי הסוכות,"
        },
        {
          "s": 33,
          "text": "מרגע הראשון שבהתחלתם]"
        },
        {
          "s": 34,
          "text": "מודגש ענין האחדות"
        },
        {
          "s": 35,
          "text": "(בחי' אחת)"
        },
        {
          "s": 36,
          "text": "דכל ישראל כמרז\"ל15"
        },
        {
          "s": 37,
          "text": "ראוים כל ישראל לישב בסוכה אחת."
        },
        {
          "s": 38,
          "text": "וכמו\"כ הוא גם במצות נטילת ד' מינים"
        },
        {
          "s": 39,
          "text": "[שענינה הוא להמשיך המקיף"
        },
        {
          "s": 40,
          "text": "(דסוכה אחת)"
        },
        {
          "s": 41,
          "text": "בפנימיות16],"
        },
        {
          "s": 42,
          "text": "שבכל אחד מד' מינים אלו ניכר ומודגש ענין האחדות,"
        },
        {
          "s": 43,
          "text": "ובפרט באתרוג,"
        },
        {
          "s": 44,
          "text": "שבו מודגש ענין האחדות עוד יותר"
        },
        {
          "s": 45,
          "text": "[שלכן בסדר הד' מינים שבכתוב17"
        },
        {
          "s": 46,
          "text": "(שגם סדר בתורה הוא תורה)"
        },
        {
          "s": 47,
          "text": "ההתחלה היא מאתרוג פרי עץ הדר],"
        },
        {
          "s": 48,
          "text": "דזה מה שאתרוג נקרא בכתוב בשם פרי עץ הדר הוא לפי שדר באילנו משנה לשנה18,"
        },
        {
          "s": 49,
          "text": "היינו שהוא סובל את שינויי ד' האוירים שבמשך השנה,"
        },
        {
          "s": 50,
          "text": "ועד אשר"
        },
        {
          "s": 51,
          "text": "(לא רק שהוא סובל את כל האוירים אלא)"
        },
        {
          "s": 52,
          "text": "הוא גדל מהם."
        },
        {
          "s": 53,
          "text": "ומענין האחדות שבאתרוג נמשך גם זה בשאר הג' מינים,"
        },
        {
          "s": 54,
          "text": "שלכן הענין דהדר שבג' המינים למדים מאתרוג19."
        },
        {
          "s": 55,
          "text": "ונוסף לזה שכל אחד מהד' מינים מורה על ענין האחדות,"
        },
        {
          "s": 56,
          "text": "הנה המצוה בנטילת ד' מינים היא לאחד את כל ד' המינים,"
        },
        {
          "s": 57,
          "text": "שמורים על ד' הסוגים שבבנ\"י20,"
        },
        {
          "s": 58,
          "text": "שיהי' וייעשו כולם אגודה אחת לעשות רצונך בלבב שלם."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה בכדי שיוכל להיות ההתאחדות האמיתית"
        },
        {
          "s": 2,
          "text": "(ובת קיימא)"
        },
        {
          "s": 3,
          "text": "של כל הד' סוגים דישראל,"
        },
        {
          "s": 4,
          "text": "הוא ע\"י התשובה."
        },
        {
          "s": 5,
          "text": "דהנה ענין התשובה הוא למעלה מהתחלקות,"
        },
        {
          "s": 6,
          "text": "שלכן היא בשעתא חדא וברגע חדא21."
        },
        {
          "s": 7,
          "text": "דזהו ההפרש שבין לוחות הראשונות"
        },
        {
          "s": 8,
          "text": "(ענין התורה מצ\"ע)"
        },
        {
          "s": 9,
          "text": "ללוחות השניות"
        },
        {
          "s": 10,
          "text": "(ענין תורה ע\"י תשובה),"
        },
        {
          "s": 11,
          "text": "שבכדי לקבל לוה\"ר הי' משה בהר ארבעים יום,"
        },
        {
          "s": 12,
          "text": "נוסף על ההכנה דשבעה שבועות תספר לך שהי' לפנ\"ז22."
        },
        {
          "s": 13,
          "text": "משא\"כ בלוחות השניות,"
        },
        {
          "s": 14,
          "text": "הרי הארבעים יום שהי' משה בהר הוא"
        },
        {
          "s": 15,
          "text": "(בעיקר)"
        },
        {
          "s": 16,
          "text": "בכדי לפעול שיתרצה הקב\"ה לישראל בשמחה ובלב שלם23,"
        },
        {
          "s": 17,
          "text": "ולאח\"ז ניתנו הלוחות בשעתא חדא."
        },
        {
          "s": 18,
          "text": "והנה ענין זה"
        },
        {
          "s": 19,
          "text": "[מה שהתשובה היא בשעתא חדא וברגע חדא]"
        },
        {
          "s": 20,
          "text": "מדגיש שענין התשובה הוא למעלה מכל מדידה והגבלה24,"
        },
        {
          "s": 21,
          "text": "מפני שתשובה אמיתית מגעת"
        },
        {
          "s": 22,
          "text": "(דערנעמט)"
        },
        {
          "s": 23,
          "text": "בפנימיות ועצמות הנפש,"
        },
        {
          "s": 24,
          "text": "שבחינה זו היא למעלה מהתחלקות,"
        },
        {
          "s": 25,
          "text": "בחי' אחת"
        },
        {
          "s": 26,
          "text": "(בשעתא חדא וברגע חדא)"
        },
        {
          "s": 27,
          "text": "דנפש."
        },
        {
          "s": 28,
          "text": "וזהו מה שע\"י התשובה נעשה ההתאחדות של כל הסוגים דישראל,"
        },
        {
          "s": 29,
          "text": "מראשיכם שבטיכם עד חוטב עציך ושואב מימיך,"
        },
        {
          "s": 30,
          "text": "ובאופן דאתם נצבים כולכם גו',"
        },
        {
          "s": 31,
          "text": "נצבים מלשון נצב25"
        },
        {
          "s": 32,
          "text": "מלך26,"
        },
        {
          "s": 33,
          "text": "שישראל נעשים מלכים און בעלי בתים על כל המציאות דעולם,"
        },
        {
          "s": 34,
          "text": "מתחיל מזה שהם נכתבים ונחתמים בכתיבה וחתימה טובה לשנה טובה ומתוקה בטוב הנראה והנגלה למטה מעשרה טפחים גם בענינים הגשמיים,"
        },
        {
          "s": 35,
          "text": "מכיון שמצד בחי' זו אין שייך לחלק בין רוחניות לגשמיות ובין מעלה למטה,"
        },
        {
          "s": 36,
          "text": "און דאָס נעמט דורך את כל סדר ההשתלשלות וגם מה שלמעלה מסדר ההשתלשלות."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "וזהו ענין יום אחד באו כולן לשאול שלום המלך אביהם כו' נעביד כולן חד יו\"ט ונחדי עמן,"
        },
        {
          "s": 1,
          "text": "יום אחד"
        },
        {
          "s": 2,
          "text": "(שבו באו כולן לשאול שלום המלך אביהם)"
        },
        {
          "s": 3,
          "text": "הוא יום הכפורים,"
        },
        {
          "s": 4,
          "text": "אחת דשנה"
        },
        {
          "s": 5,
          "text": "(וגם אחת דעולם ודנפש),"
        },
        {
          "s": 6,
          "text": "ומזה נמשך אח\"כ נעביד כולן חד יו\"ט כו' שקאי על שמחת תורה,"
        },
        {
          "s": 7,
          "text": "שהוא ג\"כ יום אחד"
        },
        {
          "s": 8,
          "text": "(חד יו\"ט),"
        },
        {
          "s": 9,
          "text": "בחי' אחת."
        }
      ]
    }
  ]
}