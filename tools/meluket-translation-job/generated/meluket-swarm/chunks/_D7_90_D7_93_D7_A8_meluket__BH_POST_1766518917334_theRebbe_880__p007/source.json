{
  "globalIndex": 618,
  "owner": 18,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917334_theRebbe_880__p007",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917334_theRebbe_880__p007",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917334_theRebbe_880",
  "title": "מאמר ואתה תצוה תשמ\"א",
  "part": 7,
  "sections": [
    {
      "v": 18,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יובן מ\"ש בהמאמר61,"
        },
        {
          "s": 1,
          "text": "דע\"י שישראל מוסיפים"
        },
        {
          "s": 2,
          "text": "(ע\"י עבודתם)"
        },
        {
          "s": 3,
          "text": "במדריגת משה,"
        },
        {
          "s": 4,
          "text": "עי\"ז יהי' נר תמיד,"
        },
        {
          "s": 5,
          "text": "דלכאורה,"
        },
        {
          "s": 6,
          "text": "זה שהנר דהנשמה"
        },
        {
          "s": 7,
          "text": "(נר62"
        },
        {
          "s": 8,
          "text": "הוי' נשמת אדם63)"
        },
        {
          "s": 9,
          "text": "הוא תמיד"
        },
        {
          "s": 10,
          "text": "(בשוה,"
        },
        {
          "s": 11,
          "text": "בלי שינוי),"
        },
        {
          "s": 12,
          "text": "הוא ע\"י גילוי עצם הנשמה שנמשך ע\"י משה"
        },
        {
          "s": 13,
          "text": "(ואתה תצוה),"
        },
        {
          "s": 14,
          "text": "דבעצם הנשמה אין שייך שינוי,"
        },
        {
          "s": 15,
          "text": "ובהמאמר אומר שהענין דנר תמיד הוא ע\"י שישראל מוסיפים במדריגת משה,"
        },
        {
          "s": 16,
          "text": "ויקחו אליך."
        },
        {
          "s": 17,
          "text": "ויש לומר,"
        },
        {
          "s": 18,
          "text": "שבהגילוי דעצם הנשמה בדרך מלמעלה למטה ע\"י ואתה תצוה,"
        },
        {
          "s": 19,
          "text": "יש חילוק בין ערב ובוקר."
        },
        {
          "s": 20,
          "text": "שעיקר הגילוי שלה הוא כשישנם העלמות והסתרים"
        },
        {
          "s": 21,
          "text": "(ערב)"
        },
        {
          "s": 22,
          "text": "שעי\"ז מתעורר ומתגלה כח המס\"נ,"
        },
        {
          "s": 23,
          "text": "וכמו שנתבאר לעיל"
        },
        {
          "s": 24,
          "text": "(סעיף יו\"ד),"
        },
        {
          "s": 25,
          "text": "שגם אלה שבזמן הגזירה"
        },
        {
          "s": 26,
          "text": "(ערב)"
        },
        {
          "s": 27,
          "text": "עמדו במס\"נ,"
        },
        {
          "s": 28,
          "text": "כשבאו למקום שאפשר לעסוק בתומ\"צ מתוך הרחבה"
        },
        {
          "s": 29,
          "text": "(בוקר),"
        },
        {
          "s": 30,
          "text": "אין ניכר בהם המס\"נ שהי' להם מקודם."
        },
        {
          "s": 31,
          "text": "ואמיתית הענין דנר תמיד"
        },
        {
          "s": 32,
          "text": "(שאין שייך בו שינוי)"
        },
        {
          "s": 33,
          "text": "הוא ע\"י עבודתם של ישראל שגם כחות הגלויים יהיו חד עם עצם הנשמה,"
        },
        {
          "s": 34,
          "text": "ויקחו אליך."
        }
      ]
    },
    {
      "v": 19,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש לבאר זה שכתית למאור נאמר בכתוב בהמשך לויקחו אליך גו',"
        },
        {
          "s": 1,
          "text": "כי בכתית למאור נכלל גם זה שישראל הם שבורים ונדכאים"
        },
        {
          "s": 2,
          "text": "(כתית)"
        },
        {
          "s": 3,
          "text": "מזה שהם בגלות,"
        },
        {
          "s": 4,
          "text": "דענין זה הוא ע\"י עבודתם של ישראל שגם כחות הגלויים שלהם יהיו מתאימים לעצם הנשמה,"
        },
        {
          "s": 5,
          "text": "ובחי' המאור דהנשמה שמתגלית עי\"ז היא עצם הנשמה כמו שהיא מושרשת בהעצמות,"
        },
        {
          "s": 6,
          "text": "ולכן נאמר כתית למאור בהמשך לויקחו אליך גו'."
        }
      ]
    },
    {
      "v": 20,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ב)"
        },
        {
          "s": 2,
          "text": "והנה הפירוש"
        },
        {
          "s": 3,
          "text": "(בפשטות)"
        },
        {
          "s": 4,
          "text": "בואתה תצוה את בני ישראל ויקחו אליך גו' הוא שמשה יצַוה את בני ישראל שיקחו אליך גו'."
        },
        {
          "s": 5,
          "text": "ומזה מובן גם בפנימיות הענינים,"
        },
        {
          "s": 6,
          "text": "דזה שמשה מצוה ומקשר את בני ישראל הוא באופן שממשיך להם נתינת כח גם על ויקחו אליך גו'."
        },
        {
          "s": 7,
          "text": "וכמו\"כ הוא בנוגע למשה שבדורנו,"
        },
        {
          "s": 8,
          "text": "כ\"ק מו\"ח אדמו\"ר נשיא דורנו,"
        },
        {
          "s": 9,
          "text": "שעבודתו לעורר ולגלות את האמונה שבכל אחד מישראל שמצד עצם הנשמה היא באופן שאח\"כ יעבדו עבודתם בכח עצמם,"
        },
        {
          "s": 10,
          "text": "ועד שיהיו נר תמיד שאין שייך בו שינוי גם מצד כחות הגלויים."
        }
      ]
    }
  ]
}