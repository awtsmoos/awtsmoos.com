{
  "globalIndex": 208,
  "owner": 8,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915018_theRebbe_923__p001",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915018_theRebbe_923__p001",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518915018_theRebbe_923",
  "title": "מאמר ואברהם זקן תשל\"ז",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ חיי שרה,"
        },
        {
          "s": 2,
          "text": "מבה\"ח כסלו ה'תשל\"ז"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "ואברהם זקן בא בימים וה' ברך את אברהם בכל1,"
        },
        {
          "s": 1,
          "text": "ומדייק אדמו\"ר"
        },
        {
          "s": 2,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 3,
          "text": "נ\"ע במאמרו ד\"ה זה"
        },
        {
          "s": 4,
          "text": "(דשנת תרס\"ו2)"
        },
        {
          "s": 5,
          "text": "מה שאומר בכל סתם ואינו מפרש במה ברכו."
        },
        {
          "s": 6,
          "text": "ונקודת הביאור3,"
        },
        {
          "s": 7,
          "text": "דכל הוא בחינת העלם העצמי,"
        },
        {
          "s": 8,
          "text": "שמשם נמשכים כל הגילויים."
        },
        {
          "s": 9,
          "text": "כדאיתא בזהר4"
        },
        {
          "s": 10,
          "text": "עה\"פ וה' ברך את אברהם בכל,"
        },
        {
          "s": 11,
          "text": "דאברהם אתברך מאתר דכל ברכאן נפקי מתמן."
        },
        {
          "s": 12,
          "text": "ולכן אומר בכל סתם ואינו מפרט פרטים,"
        },
        {
          "s": 13,
          "text": "לפי שהוא בחינת בלי גבול שלמעלה מפרטים."
        },
        {
          "s": 14,
          "text": "וצריך להבין הקשר והשייכות דפירוש הזהר שבכל הוא אתר דכל ברכאן נפקי מתמן עם פירוש רש\"י עה\"פ5"
        },
        {
          "s": 15,
          "text": "שבכל קאי על יצחק"
        },
        {
          "s": 16,
          "text": "(בכל בגימטריא בן)."
        },
        {
          "s": 17,
          "text": "וגם,"
        },
        {
          "s": 18,
          "text": "דמהמשך הכתובים משמע שפסוק זה"
        },
        {
          "s": 19,
          "text": "(ואברהם זקן וגו')"
        },
        {
          "s": 20,
          "text": "הוא הקדמה לויאמר אברהם אל עבדו גו' ולקחת אשה לבני ליצחק6,"
        },
        {
          "s": 21,
          "text": "וצריך להבין מהי השייכות דוה' ברך את אברהם בכל,"
        },
        {
          "s": 22,
          "text": "שנתברך מאתר דכל ברכאן נפקי מתמן,"
        },
        {
          "s": 23,
          "text": "לזה ששלח את עבדו לקחת אשה לבנו7."
        },
        {
          "s": 24,
          "text": "גם צריך להבין גודל העילוי דנשואי יצחק ורבקה שהוא נעלה יותר גם מבחינת בכל"
        },
        {
          "s": 25,
          "text": "(אתר דכל ברכאן נפקי מתמן),"
        },
        {
          "s": 26,
          "text": "ועד דזה שהוי' ברך את אברהם בכל הוא רק הקדמה לנשואי יצחק ורבקה."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים מה דאיתא במדרש8"
        },
        {
          "s": 2,
          "text": "אין הקב\"ה מעלה את האדם לשררה עד שבודק ובוחן אותו וכו' וכן אתה מוצא באבינו אברהם נסהו הקב\"ה עשר נסיונות ועמד בהן ואח\"כ ברכו שנאמר וה' ברך את אברהם בכל."
        },
        {
          "s": 3,
          "text": "ומבאר הצ\"צ9,"
        },
        {
          "s": 4,
          "text": "דעשר נסיונות הם כנגד עשר ספירות,"
        },
        {
          "s": 5,
          "text": "משא\"כ כל הוא פנימיות הכתר שאינו10"
        },
        {
          "s": 6,
          "text": "בחשבון ע\"ס."
        },
        {
          "s": 7,
          "text": "דבבחינה זו,"
        },
        {
          "s": 8,
          "text": "אין אתערותא דלתתא מגעת לשם."
        },
        {
          "s": 9,
          "text": "ולאחרי שעמד אברהם בעשר נסיונות כנגד ע\"ס שבהן שייך אתעדל\"ת,"
        },
        {
          "s": 10,
          "text": "אזי ברכו בכל,"
        },
        {
          "s": 11,
          "text": "פנימיות הכתר."
        },
        {
          "s": 12,
          "text": "ויש לומר,"
        },
        {
          "s": 13,
          "text": "דזהו גם דיוק לשון הכתוב ואברהם זקן בא בימים וה' ברך את אברהם בכל,"
        },
        {
          "s": 14,
          "text": "דזה שהי' זקן בא בימים,"
        },
        {
          "s": 15,
          "text": "עם היות שזהו ברכת הקב\"ה,"
        },
        {
          "s": 16,
          "text": "מייחס הכתוב לאברהם"
        },
        {
          "s": 17,
          "text": "(ואברהם זקן בא בימים),"
        },
        {
          "s": 18,
          "text": "משא\"כ בנוגע כל אינו אומר שאברהם הי' לו כל כ\"א שהוי' ברכו בכל,"
        },
        {
          "s": 19,
          "text": "דיש לומר הביאור בזה11,"
        },
        {
          "s": 20,
          "text": "דזה שנתברך בזקנה ובימים הוא אתערותא דלעילא שמתעוררת ונמשכת ע\"י אתעדל\"ת12,"
        },
        {
          "s": 21,
          "text": "עבודתו של אברהם,"
        },
        {
          "s": 22,
          "text": "משא\"כ זה שנתברך בכל הוא אתעדל\"ע הבאה מלמעלה שאין אתעדל\"ת מגעת לשם"
        },
        {
          "s": 23,
          "text": "[וזה שברכה זו באה דוקא לאחרי שעמד בעשר נסיונות הוא לפי שצריך להיות אתר13"
        },
        {
          "s": 24,
          "text": "שלים14],"
        },
        {
          "s": 25,
          "text": "ולכן כתיב בה וה' ברך גו'."
        }
      ]
    }
  ]
}