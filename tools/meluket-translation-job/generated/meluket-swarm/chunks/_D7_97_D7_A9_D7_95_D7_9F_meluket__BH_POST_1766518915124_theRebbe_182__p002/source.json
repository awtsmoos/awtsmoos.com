{
  "globalIndex": 224,
  "owner": 24,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915124_theRebbe_182__p002",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915124_theRebbe_182__p002",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518915124_theRebbe_182",
  "title": "מאמר ויזרע יצחק בארץ תשכ\"ז",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 1,
          "text": "ע\"פ מ\"ש הצ\"צ במאמרו ד\"ה זה6,"
        },
        {
          "s": 2,
          "text": "דאיתא במדרש7"
        },
        {
          "s": 3,
          "text": "בא יצחק אף הוא האיר שנאמר8"
        },
        {
          "s": 4,
          "text": "אור זרוע לצדיק וכתיב ויזרע יצחק."
        },
        {
          "s": 5,
          "text": "היינו שהזריעה שזרע יצחק הוא אור זרוע לצדיק."
        },
        {
          "s": 6,
          "text": "ובתדב\"א9"
        },
        {
          "s": 7,
          "text": "איתא עה\"פ ויזרע יצחק אין זריעה אלא צדקה שנאמר10"
        },
        {
          "s": 8,
          "text": "זרעו לכם לצדקה."
        },
        {
          "s": 9,
          "text": "ומבאר בהמאמר11,"
        },
        {
          "s": 10,
          "text": "דמ\"ש בתדב\"א שויזרע יצחק הוא צדקה קאי גם על כל המצוות שנק' בשם צדקה,"
        },
        {
          "s": 11,
          "text": "כמ\"ש12"
        },
        {
          "s": 12,
          "text": "וצדקה תהי' לנו13."
        },
        {
          "s": 13,
          "text": "וגם התורה נק' בשם זריעה,"
        },
        {
          "s": 14,
          "text": "כמ\"ש14"
        },
        {
          "s": 15,
          "text": "שש שנים תזרע שדך הם שיתא סדרי משנה15."
        },
        {
          "s": 16,
          "text": "וזהו שויזרע יצחק הוא אור זרוע לצדיק,"
        },
        {
          "s": 17,
          "text": "שהוא אור התורה והמצוות שזרוע"
        },
        {
          "s": 18,
          "text": "(נתלבש)"
        },
        {
          "s": 19,
          "text": "בדברים הגשמיים שבעוה\"ז16."
        },
        {
          "s": 20,
          "text": "ועפ\"ז יש לבאר מה שע\"י העבודה דויזרע נעשה ויגדל האיש"
        },
        {
          "s": 21,
          "text": "(בכללותו),"
        },
        {
          "s": 22,
          "text": "כי ויזרע יצחק הוא עבודה כללית,"
        },
        {
          "s": 23,
          "text": "העבודה דלימוד התורה וקיום המצוות."
        },
        {
          "s": 24,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 25,
          "text": "שגם שני הענינים שבפסוק ויזרע יצחק גו'"
        },
        {
          "s": 26,
          "text": "(וימצא מאה שערים,"
        },
        {
          "s": 27,
          "text": "ויברכהו ה')"
        },
        {
          "s": 28,
          "text": "הם ענינים כללים."
        },
        {
          "s": 29,
          "text": "דכמו שהעבודה דויזרע יצחק היא עבודה כללית"
        },
        {
          "s": 30,
          "text": "(כנ\"ל),"
        },
        {
          "s": 31,
          "text": "גם הענינים שנמשכו מלמעלה ע\"י עבודה זו הם ענינים כללים."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה מבואר בכ\"מ17,"
        },
        {
          "s": 2,
          "text": "דזה שתורה ומצוות נקראים בשם זריעה קאי על הירידה דתומ\"צ להתלבש בדברים גשמיים,"
        },
        {
          "s": 3,
          "text": "שהכוונה בזה היא לצורך עלי',"
        },
        {
          "s": 4,
          "text": "בדוגמת זריעה בארץ שהיא בשביל הצמיחה בריבוי יותר מכמו שהי' בתחלה."
        },
        {
          "s": 5,
          "text": "וצריך להבין,"
        },
        {
          "s": 6,
          "text": "דע\"פ ביאור זה,"
        },
        {
          "s": 7,
          "text": "הלשון זריעה בתומ\"צ שייך בנוגע להקב\"ה,"
        },
        {
          "s": 8,
          "text": "שהוא הוריד התומ\"צ למטה18,"
        },
        {
          "s": 9,
          "text": "ולא בנוגע לקיום התומ\"צ דהאדם."
        },
        {
          "s": 10,
          "text": "וממ\"ש ויזרע יצחק מובן שגם קיום התומ\"צ דהאדם היא ירידה לצורך עלי'."
        },
        {
          "s": 11,
          "text": "ויש לומר הביאור בזה ע\"פ מ\"ש בהמאמר בסופו11"
        },
        {
          "s": 12,
          "text": "עוד פירוש באור זרוע לצדיק,"
        },
        {
          "s": 13,
          "text": "דענין הזריעה הוא לזרוע בנפש הבהמית המשכת שכל ומדות של נפש האלקית,"
        },
        {
          "s": 14,
          "text": "שעי\"ז נעשה צמיחה ועלי' בהשכל והמדות דנפש האלקית."
        },
        {
          "s": 15,
          "text": "דכיון שהשרש דנפש הבהמית הוא למעלה מהשרש דנפש האלקית,"
        },
        {
          "s": 16,
          "text": "דנה\"א שרשה בתיקון ונה\"ב שרשה בתוהו,"
        },
        {
          "s": 17,
          "text": "לכן,"
        },
        {
          "s": 18,
          "text": "ע\"י זריעת השכל ומדות דנפש האלקית בנפש הבהמית נעשה צמיחה"
        },
        {
          "s": 19,
          "text": "(עלי')"
        },
        {
          "s": 20,
          "text": "בנפש האלקית."
        },
        {
          "s": 21,
          "text": "ולהעיר,"
        },
        {
          "s": 22,
          "text": "דבלקו\"ת19"
        },
        {
          "s": 23,
          "text": "מבואר שאור זרוע לצדיק קאי על ירידת נפש האלקית להתלבש בנפש הבהמית,"
        },
        {
          "s": 24,
          "text": "ומלשון המאמר לזרוע בנה\"ב המשכת שכל ומדות של נה\"א,"
        },
        {
          "s": 25,
          "text": "משמע,"
        },
        {
          "s": 26,
          "text": "שהאדם צריך לזרוע השכל ומדות דנה\"א בנה\"ב."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "והענין הוא,"
        },
        {
          "s": 1,
          "text": "דבעבודת הנשמה"
        },
        {
          "s": 2,
          "text": "(גם לאחרי ירידתה למטה)"
        },
        {
          "s": 3,
          "text": "ישנם שני אופנים."
        },
        {
          "s": 4,
          "text": "עבודת הנשמה מצד עצמה,"
        },
        {
          "s": 5,
          "text": "ועבודתה לברר את נה\"ב20."
        },
        {
          "s": 6,
          "text": "וזהו פירוש לזרוע השכל ומדות דנה\"א בנה\"ב,"
        },
        {
          "s": 7,
          "text": "כי השכל והמדות דנה\"א כמו שהם מצד עצמם"
        },
        {
          "s": 8,
          "text": "(גם לאחרי ירידת הנשמה למטה)"
        },
        {
          "s": 9,
          "text": "אי אפשר שיהי' על ידם בירור נה\"ב,"
        },
        {
          "s": 10,
          "text": "ובכדי שיפעלו בנה\"ב הוא ע\"י ירידתם והתלבשותם בהשכל והמדות דנה\"ב20,"
        },
        {
          "s": 11,
          "text": "זריעה."
        },
        {
          "s": 12,
          "text": "ויש לומר,"
        },
        {
          "s": 13,
          "text": "שעד\"ז הוא בקיום התומ\"צ,"
        },
        {
          "s": 14,
          "text": "שבכדי שיהי' חיות בהתומ\"צ הוא כשקיום התומ\"צ הוא באהבה ויראה21,"
        },
        {
          "s": 15,
          "text": "ובכדי שע\"י האהוי\"ר דהנשמה יהי' חיות במעשה המצוות שעי\"ז יהיו פרחא לעילא22"
        },
        {
          "s": 16,
          "text": "הוא ע\"י ירידתם והתלבשותם בהעשי'"
        },
        {
          "s": 17,
          "text": "(דהמצוה)23."
        },
        {
          "s": 18,
          "text": "וזהו שקיום התומ\"צ דהאדם נק' בשם זריעה,"
        },
        {
          "s": 19,
          "text": "ויזרע יצחק."
        }
      ]
    }
  ]
}