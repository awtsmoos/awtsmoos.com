{
  "globalIndex": 1030,
  "owner": 30,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919866_theRebbe_58__p003",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919866_theRebbe_58__p003",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919866_theRebbe_58",
  "title": "מאמר ויענך וירעיבך ויאכילך תשכ\"ג",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ויש לקשר זה עם מאמר הזהר32"
        },
        {
          "s": 2,
          "text": "ע\"פ33"
        },
        {
          "s": 3,
          "text": "ראו כי ה' נתן לכם השבת,"
        },
        {
          "s": 4,
          "text": "ר' חזקי' פתח שיר המעלות ממעמקים גו'34"
        },
        {
          "s": 5,
          "text": "דמעמקים"
        },
        {
          "s": 6,
          "text": "(לשון רבים)"
        },
        {
          "s": 7,
          "text": "הם עומקא דכולא ועומקא דבירא,"
        },
        {
          "s": 8,
          "text": "וכתב אאמו\"ר בעל ההילולא על הגליון של ספר הזהר שלו35"
        },
        {
          "s": 9,
          "text": "(שמשך כמה שנים הי' בשבי',"
        },
        {
          "s": 10,
          "text": "ובזמן האחרון נפדו"
        },
        {
          "s": 11,
          "text": "(ספר הזהר שלו עם עוד ספרים שלו)"
        },
        {
          "s": 12,
          "text": "מהשבי' והגיעו לכאן),"
        },
        {
          "s": 13,
          "text": "שהשייכות דפירוש זה בממעמקים לראו גו' השבת היא,"
        },
        {
          "s": 14,
          "text": "כי עומקא דכולא ועומקא דבירא הם חכמה ובינה,"
        },
        {
          "s": 15,
          "text": "שמהם נמשך השפע לכל ששה המדות דז\"א"
        },
        {
          "s": 16,
          "text": "(מבועין נפקין ונגדין לברכא כולא36)."
        },
        {
          "s": 17,
          "text": "וענין זה שייך לראו כי ה' נתן לכם השבת,"
        },
        {
          "s": 18,
          "text": "כי שבת הוא יומא שביעאה שהוא בינה37"
        },
        {
          "s": 19,
          "text": "(עומקא דבירא),"
        },
        {
          "s": 20,
          "text": "שבה מלובש חכמה"
        },
        {
          "s": 21,
          "text": "(עומקא דכולא),"
        },
        {
          "s": 22,
          "text": "ומיני' מתברכין שיתא יומין38,"
        },
        {
          "s": 23,
          "text": "ו\"ק דז\"א."
        },
        {
          "s": 24,
          "text": "וממשיך בעל ההילולא,"
        },
        {
          "s": 25,
          "text": "דזהו מ\"ש39"
        },
        {
          "s": 26,
          "text": "וקראת לשבת ענג,"
        },
        {
          "s": 27,
          "text": "ענג הוא ר\"ת עדן נהר גן40,"
        },
        {
          "s": 28,
          "text": "עדן ונהר הם חכמה ובינה"
        },
        {
          "s": 29,
          "text": "(עומקא דכולא ועומקא דבירא),"
        },
        {
          "s": 30,
          "text": "ומהם נמשך השפע והברכה לגן,"
        },
        {
          "s": 31,
          "text": "מלכות."
        },
        {
          "s": 32,
          "text": "וזהו שהמלכות נקראת שבת41,"
        },
        {
          "s": 33,
          "text": "כי שבת הוא אותיות ש' בת42,"
        },
        {
          "s": 34,
          "text": "ש' בגימטריא מעמקים הוא עדן ונהר,"
        },
        {
          "s": 35,
          "text": "ובת היא מלכות"
        },
        {
          "s": 36,
          "text": "(גן)"
        },
        {
          "s": 37,
          "text": "שבה נמשך השפע והברכה מעדן ונהר,"
        },
        {
          "s": 38,
          "text": "מעמקים."
        },
        {
          "s": 39,
          "text": "וצריך להבין,"
        },
        {
          "s": 40,
          "text": "דבתחילת הענין מדבר בהמשכת השפע מחו\"ב"
        },
        {
          "s": 41,
          "text": "(מעמקים)"
        },
        {
          "s": 42,
          "text": "לששה המדות דז\"א,"
        },
        {
          "s": 43,
          "text": "ולאח\"ז מבאר שזהו וקראת לשבת ענג,"
        },
        {
          "s": 44,
          "text": "ההמשכה מעדן ונהר לגן,"
        },
        {
          "s": 45,
          "text": "מלכות."
        },
        {
          "s": 46,
          "text": "ויש לומר הביאור בזה"
        },
        {
          "s": 47,
          "text": "(בעבודת האדם),"
        },
        {
          "s": 48,
          "text": "שמעמקים לשון רבים הם שני ענינים הנ\"ל שבמאכל רעבון,"
        },
        {
          "s": 49,
          "text": "עומקא דבירא"
        },
        {
          "s": 50,
          "text": "(בינה)"
        },
        {
          "s": 51,
          "text": "הוא הידיעה שפועלת רעבון,"
        },
        {
          "s": 52,
          "text": "ועומקא דכולא"
        },
        {
          "s": 53,
          "text": "(חכמה)"
        },
        {
          "s": 54,
          "text": "הוא הידיעה שהיא רעבון בעצם לגבי האדם,"
        },
        {
          "s": 55,
          "text": "ושני הענינים דז\"א ומלכות הם שתי דרגות בשכל האדם,"
        },
        {
          "s": 56,
          "text": "כמו שהוא מופשט"
        },
        {
          "s": 57,
          "text": "(קצת)"
        },
        {
          "s": 58,
          "text": "ממציאותו"
        },
        {
          "s": 59,
          "text": "(ז\"א)"
        },
        {
          "s": 60,
          "text": "וכמו שהוא בההגבלות שלו"
        },
        {
          "s": 61,
          "text": "(מלכות)."
        },
        {
          "s": 62,
          "text": "וההמשכה דמעמקים בשכל האדם"
        },
        {
          "s": 63,
          "text": "(ע\"י הביטול שלו)"
        },
        {
          "s": 64,
          "text": "היא בשתי הדרגות שבו,"
        },
        {
          "s": 65,
          "text": "גם בההגבלות שלו,"
        },
        {
          "s": 66,
          "text": "שהענינים דפנימיות התורה שמצד עצמם הם למעלה מהשכל נמשכים בשכל,"
        },
        {
          "s": 67,
          "text": "בהשגה ממש43."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ויש להוסיף,"
        },
        {
          "s": 1,
          "text": "שעיקר הגילוי דמעמקים הוא במלכות."
        },
        {
          "s": 2,
          "text": "דו' המדות דז\"א הם"
        },
        {
          "s": 3,
          "text": "(רק)"
        },
        {
          "s": 4,
          "text": "מתברכים מיומא שביעאה,"
        },
        {
          "s": 5,
          "text": "והמלכות"
        },
        {
          "s": 6,
          "text": "(נוסף על שבה נמשך השפע מחו\"ב,"
        },
        {
          "s": 7,
          "text": "גם)"
        },
        {
          "s": 8,
          "text": "היא עצמה נקראת שבת."
        },
        {
          "s": 9,
          "text": "ויתירה מזו,"
        },
        {
          "s": 10,
          "text": "שבשבת"
        },
        {
          "s": 11,
          "text": "(שקאי בעיקר על בינה)"
        },
        {
          "s": 12,
          "text": "יש גם אותיות בת,"
        },
        {
          "s": 13,
          "text": "היינו שעיקר ענין הש'"
        },
        {
          "s": 14,
          "text": "(מעמקים)"
        },
        {
          "s": 15,
          "text": "הוא כשהוא נמשך בבת,"
        },
        {
          "s": 16,
          "text": "מלכות."
        },
        {
          "s": 17,
          "text": "וי\"ל הביאור בזה בעבודת האדם,"
        },
        {
          "s": 18,
          "text": "שהוא ע\"ד הידוע44"
        },
        {
          "s": 19,
          "text": "שע\"י הפצת המעיינות חוצה מתגלה ענינם דהמעיינות."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה משני ענינים הנ\"ל שבמן דפנימיות התורה – רעבון שלמעלה מהשגה ואעפ\"כ הוא מאכל רעבון – נשתלשלו שני ענינים אלה בהמן כפשוטו."
        },
        {
          "s": 2,
          "text": "והענין הוא,"
        },
        {
          "s": 3,
          "text": "דהטעם על זה שהמן הי' דבר יום ביומו"
        },
        {
          "s": 4,
          "text": "[שלכן כתיב בי' ויענך וירעיבך,"
        },
        {
          "s": 5,
          "text": "כי אינו דומה מי שיש לו פת בסלו למי שאין לו פת בסלו],"
        },
        {
          "s": 6,
          "text": "הוא,"
        },
        {
          "s": 7,
          "text": "כי גדר העולם הוא"
        },
        {
          "s": 8,
          "text": "(מקום ו)"
        },
        {
          "s": 9,
          "text": "זמן45,"
        },
        {
          "s": 10,
          "text": "ומן הוא למעלה מהעולם,"
        },
        {
          "s": 11,
          "text": "למעלה מגדר זמן,"
        },
        {
          "s": 12,
          "text": "ולכן,"
        },
        {
          "s": 13,
          "text": "גם לאחרי שנמשך בעולם,"
        },
        {
          "s": 14,
          "text": "הי' צריך להתחדש בכל יום46."
        },
        {
          "s": 15,
          "text": "וזהו אינו דומה מי שיש לו פת בסלו למי שאין לו פת בסלו,"
        },
        {
          "s": 16,
          "text": "דלחם מן הארץ וכן כל ההשפעות שנמשכו בעולם,"
        },
        {
          "s": 17,
          "text": "כיון שאין ניכר בהם שהם מתחדשים בכל יום47,"
        },
        {
          "s": 18,
          "text": "נדמה לאדם שהם בסלו,"
        },
        {
          "s": 19,
          "text": "והמן שהי' ניכר בו בגילוי שמתחדש בכל יום מלמעלה,"
        },
        {
          "s": 20,
          "text": "אינו בסלו של האדם."
        },
        {
          "s": 21,
          "text": "ועד\"ז48"
        },
        {
          "s": 22,
          "text": "הוא בנוגע שטעמו בו כל הטעמים"
        },
        {
          "s": 23,
          "text": "(טעם השני על הרעבון דמן),"
        },
        {
          "s": 24,
          "text": "דבדבר מוגבל א\"א שיהיו בו כל הטעמים"
        },
        {
          "s": 25,
          "text": "(ובפרט שבהטעמים ישנם גם טעמים הפכיים),"
        },
        {
          "s": 26,
          "text": "וזה שהמן היו בו כל הטעמים הוא לפי שגם כשנמשך למטה הי' לחם מן השמים,"
        },
        {
          "s": 27,
          "text": "ענין אלוקי שלמעלה מההגבלות דעולם."
        },
        {
          "s": 28,
          "text": "וזהו \"אינו רואה ואוכל\","
        },
        {
          "s": 29,
          "text": "שעין האדם המוגבל לא הי' יכול לתפוס הבל\"ג דהמן,"
        },
        {
          "s": 30,
          "text": "ולכן לא ראה אפילו מאכל פשוט,"
        },
        {
          "s": 31,
          "text": "ע\"ד מקום אור גדול מנשוא – שהראי' מתבלבלת."
        }
      ]
    }
  ]
}