{
  "globalIndex": 1096,
  "owner": 46,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920368_theRebbe_469__p004",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920368_theRebbe_469__p004",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920368_theRebbe_469",
  "title": "מאמר השקיפה ממעון קדשך תשכ\"ז",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "אלא שאעפ\"כ נכלל זה ביראה תתאה,"
        },
        {
          "s": 1,
          "text": "כי עיקר ההתבוננות שלו הוא בהאלקות שבערך העולמות,"
        },
        {
          "s": 2,
          "text": "ולכן,"
        },
        {
          "s": 3,
          "text": "גם כשמתבונן שהוא רק בחינת דומם,"
        },
        {
          "s": 4,
          "text": "אין נרגש בו"
        },
        {
          "s": 5,
          "text": "(כ\"כ)"
        },
        {
          "s": 6,
          "text": "הרוממות דאוא\"ס שלמעלה מעולמות שכולא קמי' כלא חשיב46."
        },
        {
          "s": 7,
          "text": "ומזה מובן,"
        },
        {
          "s": 8,
          "text": "דזה שיראה עילאה היא מהרוממות דאוא\"ס שלמעלה מעולמות,"
        },
        {
          "s": 9,
          "text": "הכוונה בזה היא שנרגש אצלו ענין זה עצמו."
        },
        {
          "s": 10,
          "text": "ועפ\"ז צריך להבין עוד יותר מה שגבי ציון"
        },
        {
          "s": 11,
          "text": "(יראה עילאה)"
        },
        {
          "s": 12,
          "text": "נאמר אלקים47."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ומבאר בהמאמר ד\"ה שבחי הנ\"ל48,"
        },
        {
          "s": 2,
          "text": "דהטעם על מ\"ש הללי אלקיך ציון מבאר הכתוב עצמו"
        },
        {
          "s": 3,
          "text": "(בהפסוק שלאח\"ז)"
        },
        {
          "s": 4,
          "text": "כי חזק בריחי שעריך גו'."
        },
        {
          "s": 5,
          "text": "והענין הוא דאיתא במשנה49"
        },
        {
          "s": 6,
          "text": "כופין אותו"
        },
        {
          "s": 7,
          "text": "(לבן עיר)"
        },
        {
          "s": 8,
          "text": "לבנות לעיר חומה ודלתיים ובריח."
        },
        {
          "s": 9,
          "text": "דחומה היא בכדי להגן מן השונא שלא יכנס בעיר,"
        },
        {
          "s": 10,
          "text": "ובכדי שיוכלו בני העיר לצאת ולבוא,"
        },
        {
          "s": 11,
          "text": "עושים פתח ודלת בהחומה,"
        },
        {
          "s": 12,
          "text": "ועושים בריחים לדלת,"
        },
        {
          "s": 13,
          "text": "בכדי שלא יכנסו לעיר רק אלה הראויים ליכנס."
        },
        {
          "s": 14,
          "text": "ועד\"ז הוא למעלה,"
        },
        {
          "s": 15,
          "text": "דענין הבריחים הוא הגבורות דשם אלקים שמגבילים את השפע,"
        },
        {
          "s": 16,
          "text": "שלא יומשך ממנו יניקה לחיצונים."
        },
        {
          "s": 17,
          "text": "וזהו הללי אלקיך ציון"
        },
        {
          "s": 18,
          "text": "(והטעם שנאמר כאן שם אלקים הוא)"
        },
        {
          "s": 19,
          "text": "כי חזק בריחי שעריך,"
        },
        {
          "s": 20,
          "text": "שבציון הוא המשכת אוא\"ס שלמעלה מהשתלשלות"
        },
        {
          "s": 21,
          "text": "(כנ\"ל),"
        },
        {
          "s": 22,
          "text": "דלגבי אור זה הכל שוין,"
        },
        {
          "s": 23,
          "text": "ולכן צריך להגבורות דשם אלקים להגביל השפע שנמשך מאור זה,"
        },
        {
          "s": 24,
          "text": "שלא יינקו החיצונים."
        },
        {
          "s": 25,
          "text": "וע\"ד מ\"ש ולאמר לציון עמי אתה,"
        },
        {
          "s": 26,
          "text": "שההשפעה מבחי' ציון תהי' רק לעמי,"
        },
        {
          "s": 27,
          "text": "לישראל."
        },
        {
          "s": 28,
          "text": "וזהו שממשיך הכתוב ברך בניך בקרבך,"
        },
        {
          "s": 29,
          "text": "שהברכה וההשפעה תהי' רק לבניך,"
        },
        {
          "s": 30,
          "text": "לישראל."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 1,
          "text": "שענין זה נעשה ע\"י העבודה דשופטים ושוטרים תתן לך בכל שעריך50."
        },
        {
          "s": 2,
          "text": "שעריך הם נ' שערי בינה הנמשכים ממוח הבינה למדות שבלב."
        },
        {
          "s": 3,
          "text": "וע\"י העבודה דשופטים ושוטרים תתן לך בכל שעריך,"
        },
        {
          "s": 4,
          "text": "שכל ז' המדות"
        },
        {
          "s": 5,
          "text": "[שכל אחת מהם כלולה מז']"
        },
        {
          "s": 6,
          "text": "יהיו לה' לבדו,"
        },
        {
          "s": 7,
          "text": "עי\"ז נעשה בריחי שעריך,"
        },
        {
          "s": 8,
          "text": "שלא יומשך השפע לחיצונים רק לישראל."
        }
      ]
    }
  ]
}