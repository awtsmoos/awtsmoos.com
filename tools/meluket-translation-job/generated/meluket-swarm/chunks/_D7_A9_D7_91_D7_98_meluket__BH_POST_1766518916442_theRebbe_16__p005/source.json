  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916442_theRebbe_16",
  "title": "סקירה ע\"ד ס\"ת לקבלת פני משיח צדקנו",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "אמנם בג' כסלו כותב לו שוב11"
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "\"אדות הקלף להס\"ת הנה יעלה ביוקר ולכן בדעתנו לעשות זאת פה\"."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "את הקלף אמנם השיגו בארה\"ב,"
        },
        {
          "s": 1,
          "text": "על אף הקשיים בהשגת קלף באותה שעה,"
        },
        {
          "s": 2,
          "text": "כי רוב העורות נלקחו באותה שעה ע\"י הממשלה"
        },
        {
          "s": 3,
          "text": "(עבור צרכי המלחמה)."
        },
        {
          "s": 4,
          "text": "ולאחר התחלת הכתיבה פנה בנד\"ז,"
        },
        {
          "s": 5,
          "text": "בו' אייר תש\"ב,"
        },
        {
          "s": 6,
          "text": "למוה\"ר אלי' נחום שי' שקליאַר12"
        }
      ]
    }
  ]
}