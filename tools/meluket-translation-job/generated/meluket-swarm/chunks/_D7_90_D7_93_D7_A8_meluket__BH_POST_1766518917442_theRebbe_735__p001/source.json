{
  "globalIndex": 633,
  "owner": 33,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917442_theRebbe_735__p001",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917442_theRebbe_735__p001",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917442_theRebbe_735",
  "title": "מאמר על כן קראו תשי\"ג",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "פורים"
        },
        {
          "s": 2,
          "text": "(מאמר ב)*"
        },
        {
          "s": 3,
          "text": "ה'תשי\"ג"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "על כן קראו לימים האלה פורים על שם הפור1,"
        },
        {
          "s": 1,
          "text": "וע\"פ הידוע2"
        },
        {
          "s": 2,
          "text": "ששמו של כל דבר מורה על ענינו,"
        },
        {
          "s": 3,
          "text": "מובן,"
        },
        {
          "s": 4,
          "text": "דזה שקראו לימים האלה פורים על שם הפור הוא לפי שעיקר היו\"ט דפורים הוא הגורל"
        },
        {
          "s": 5,
          "text": "(פור הוא הגורל3)."
        },
        {
          "s": 6,
          "text": "וצריך להבין"
        },
        {
          "s": 7,
          "text": "(כמו שמדייק בתו\"א ד\"ה זה4),"
        },
        {
          "s": 8,
          "text": "דלכאורה,"
        },
        {
          "s": 9,
          "text": "הרי לא זה הי'"
        },
        {
          "s": 10,
          "text": "[עיקר5]"
        },
        {
          "s": 11,
          "text": "הנס."
        },
        {
          "s": 12,
          "text": "ולהוסיף,"
        },
        {
          "s": 13,
          "text": "דהגורל שהפיל המן"
        },
        {
          "s": 14,
          "text": "(לא רק שלא זה הי' הנס,"
        },
        {
          "s": 15,
          "text": "אלא אדרבה)"
        },
        {
          "s": 16,
          "text": "הי' חלק מהגזירה"
        },
        {
          "s": 17,
          "text": "[ובלשון המגילה6"
        },
        {
          "s": 18,
          "text": "הפיל פור הוא הגורל להומם ולאבדם],"
        },
        {
          "s": 19,
          "text": "ומזה שימים אלה נקראים בשם פורים על שם הפור,"
        },
        {
          "s": 20,
          "text": "משמע שזה"
        },
        {
          "s": 21,
          "text": "(הגורל)"
        },
        {
          "s": 22,
          "text": "הוא עיקר הנס דפורים,"
        },
        {
          "s": 23,
          "text": "ועד שהנס נקרא על שם זה."
        },
        {
          "s": 24,
          "text": "ולכאורה הי' אפשר לבאר ע\"פ מה שאיתא בגמרא7"
        },
        {
          "s": 25,
          "text": "דכשנפל הפור בחודש אדר שמח"
        },
        {
          "s": 26,
          "text": "(המן)"
        },
        {
          "s": 27,
          "text": "שמחה גדולה,"
        },
        {
          "s": 28,
          "text": "אמר נפל לי פור בירח שמת בו משה,"
        },
        {
          "s": 29,
          "text": "ולא הי' יודע שבשבעה באדר מת ובשבעה באדר נולד."
        },
        {
          "s": 30,
          "text": "ועפ\"ז הי' אפשר לומר,"
        },
        {
          "s": 31,
          "text": "דזה שימים האלה נקראים על שם הפור הוא לפי שהנס דפורים הי' זה שנפל הפור בחודש אדר,"
        },
        {
          "s": 32,
          "text": "החודש שבו נולד משה מושיען של ישראל."
        },
        {
          "s": 33,
          "text": "אבל ביאור זה עצ\"ע,"
        },
        {
          "s": 34,
          "text": "כי מזה שהיו\"ט נקרא פורים על שם הפור,"
        },
        {
          "s": 35,
          "text": "משמע,"
        },
        {
          "s": 36,
          "text": "שהשייכות דהנס לפור היא"
        },
        {
          "s": 37,
          "text": "(לא רק לזה שנפל הפור בחודש אדר,"
        },
        {
          "s": 38,
          "text": "אלא גם)"
        },
        {
          "s": 39,
          "text": "לענין הפור עצמו."
        },
        {
          "s": 40,
          "text": "ואדרבה,"
        },
        {
          "s": 41,
          "text": "עיקר הנס הי' מצד הפור הוא הגורל."
        },
        {
          "s": 42,
          "text": "דגורל הוא ענין נעלה ביותר,"
        },
        {
          "s": 43,
          "text": "שמזה נמשך הנס."
        },
        {
          "s": 44,
          "text": "וזה שנפל הגורל על חודש אדר שבו נולד מושיען של ישראל הוא"
        },
        {
          "s": 45,
          "text": "(כמו כל הענינים שהיו בהנס דפורים,"
        },
        {
          "s": 46,
          "text": "שהם)"
        },
        {
          "s": 47,
          "text": "תוצאה מעיקר ענינו,"
        },
        {
          "s": 48,
          "text": "פורים על שם הפור."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויובן זה ע\"פ המבואר בתו\"א8"
        },
        {
          "s": 2,
          "text": "דפורים ויום הכפורים שייכים זל\"ז9."
        },
        {
          "s": 3,
          "text": "דפירוש יום כ."
        },
        {
          "s": 4,
          "text": "פורים הוא כמו פורים"
        },
        {
          "s": 5,
          "text": "[ויתירה מזו,"
        },
        {
          "s": 6,
          "text": "דמזה שיום הכפורים הוא כ."
        },
        {
          "s": 7,
          "text": "פורים"
        },
        {
          "s": 8,
          "text": "(בכ\"ף הדמיון בלבד),"
        },
        {
          "s": 9,
          "text": "מוכח,"
        },
        {
          "s": 10,
          "text": "שפורים הוא נעלה יותר מיוהכ\"פ10]."
        },
        {
          "s": 11,
          "text": "ומהשייכות דיוהכ\"פ ופורים היא,"
        },
        {
          "s": 12,
          "text": "שבשניהם הו\"ע הגורל."
        },
        {
          "s": 13,
          "text": "דביוהכ\"פ הפילו גורל על שני השעירים11,"
        },
        {
          "s": 14,
          "text": "וגם פורים הוא על שם הפור הוא הגורל."
        },
        {
          "s": 15,
          "text": "ועוד ענין בהשייכות דפורים ויוהכ\"פ,"
        },
        {
          "s": 16,
          "text": "ששניהם הם למעלה משם הוי'12."
        },
        {
          "s": 17,
          "text": "דביוהכ\"פ כתיב13"
        },
        {
          "s": 18,
          "text": "לפני הוי' תטהרו,"
        },
        {
          "s": 19,
          "text": "למעלה מהוי'14."
        },
        {
          "s": 20,
          "text": "וגם בנוגע לפורים ידוע15"
        },
        {
          "s": 21,
          "text": "דהטעם שלא נזכר שם הוי' בכל מגילת אסתר16"
        },
        {
          "s": 22,
          "text": "הוא לפי שבפורים הוא גילוי אוא\"ס שלמעלה מהוי'."
        }
      ]
    }
  ]
}