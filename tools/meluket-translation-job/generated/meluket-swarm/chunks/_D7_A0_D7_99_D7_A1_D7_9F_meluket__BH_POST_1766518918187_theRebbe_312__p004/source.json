{
  "globalIndex": 757,
  "owner": 7,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918187_theRebbe_312__p004",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918187_theRebbe_312__p004",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518918187_theRebbe_312",
  "title": "מאמר החודש הזה לכם תשל\"א",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "אמנם עדיין צריך להבין מ\"ש ראשון הוא לכם לחדשי השנה,"
        },
        {
          "s": 2,
          "text": "שענין החודש"
        },
        {
          "s": 3,
          "text": "(ר\"ח של גאולה)"
        },
        {
          "s": 4,
          "text": "שמורה על החידוש"
        },
        {
          "s": 5,
          "text": "(הנהגה ניסית שבאה ע\"י החידוש דעבודה בכח עצמו)"
        },
        {
          "s": 6,
          "text": "שייך גם לשנה שמורה על התמידיות והעדר השינוי והחידוש"
        },
        {
          "s": 7,
          "text": "(הנהגה טבעית שנקבעה בתחילת הבריאה)."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "והענין בזה,"
        },
        {
          "s": 1,
          "text": "דהנה,"
        },
        {
          "s": 2,
          "text": "סוף סוף הרי כל הענינים שבהשתלשלות תלויים בעבודתם של ישראל והם בשביל ישראל,"
        },
        {
          "s": 3,
          "text": "היינו,"
        },
        {
          "s": 4,
          "text": "שגם ההנהגה טבעית כפי שנקבעה בתחילת הבריאה היא בשביל ישראל,"
        },
        {
          "s": 5,
          "text": "וכדאיתא בפירש\"י עה\"פ48"
        },
        {
          "s": 6,
          "text": "בראשית ברא וגו',"
        },
        {
          "s": 7,
          "text": "בשביל ישראל שנקראו ראשית וכו'."
        },
        {
          "s": 8,
          "text": "וזהו מ\"ש49"
        },
        {
          "s": 9,
          "text": "עם המלך במלאכתו ישבו שם,"
        },
        {
          "s": 10,
          "text": "וארז\"ל50"
        },
        {
          "s": 11,
          "text": "במי נמלך בנשמותיהם של צדיקים,"
        },
        {
          "s": 12,
          "text": "והיינו שהתבונן בנש\"י"
        },
        {
          "s": 13,
          "text": "(כפי שיהיו בעתיד)"
        },
        {
          "s": 14,
          "text": "וברא את העולם."
        },
        {
          "s": 15,
          "text": "וכמ\"ש הה\"מ באור תורה51"
        },
        {
          "s": 16,
          "text": "שקדימת הרצון הי' בשביל שיהיו ישראל צדיקים בכל דור ודור וצמצם כביכול בהירותו,"
        },
        {
          "s": 17,
          "text": "כמשל אב מצמצם את שכלו ומדבר דברי קטנות בשביל בנו הקטן,"
        },
        {
          "s": 18,
          "text": "וגם כל המדות מעשה נערות נולדים בהאב."
        },
        {
          "s": 19,
          "text": "אלא שלמטה צריך להיות הבן במציאות תחילה,"
        },
        {
          "s": 20,
          "text": "ואח\"כ יכול האב להתבונן בו וכו',"
        },
        {
          "s": 21,
          "text": "אבל לגבי הקב\"ה העבר והעתיד שוים לפניו,"
        },
        {
          "s": 22,
          "text": "והי' הוא ית' מתענג ממעשה הצדיקים"
        },
        {
          "s": 23,
          "text": "(שיהי' בעתיד)"
        },
        {
          "s": 24,
          "text": "וצמצם א\"ע כו'."
        },
        {
          "s": 25,
          "text": "אלא שקודם הבריאה הי' התענוג ממעשה הצדיקים בכח,"
        },
        {
          "s": 26,
          "text": "ואח\"כ"
        },
        {
          "s": 27,
          "text": "(כשבחר ביעקב ובניו ונתן להם התורה)"
        },
        {
          "s": 28,
          "text": "צ\"ל מעשה הצדיקים"
        },
        {
          "s": 29,
          "text": "(עבודה בכח עצמו)"
        },
        {
          "s": 30,
          "text": "בפועל,"
        },
        {
          "s": 31,
          "text": "ובשביל זה היתה כוונת הבריאה."
        },
        {
          "s": 32,
          "text": "ונמצא,"
        },
        {
          "s": 33,
          "text": "שגם הסדר דהנהגה טבעית"
        },
        {
          "s": 34,
          "text": "(שנה)"
        },
        {
          "s": 35,
          "text": "תלוי בעבודתם של ישראל,"
        },
        {
          "s": 36,
          "text": "שזהו\"ע דהחודש הזה לכם,"
        },
        {
          "s": 37,
          "text": "משבחר ביעקב ובניו כו' ר\"ח של גאולה,"
        },
        {
          "s": 38,
          "text": "שזהו החידוש דמ\"ת,"
        },
        {
          "s": 39,
          "text": "שהתורה ירדה למטה בעוה\"ז,"
        },
        {
          "s": 40,
          "text": "היינו שחדרה גם לתוך הענינים שלמטה בעוה\"ז,"
        },
        {
          "s": 41,
          "text": "שגם בחינת ההנהגה טבעית תלוי' בעבודתם של ישראל דוקא."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "אלא שמ\"מ יש הפרש בין העבודה שבשביל ההנהגה טבעית,"
        },
        {
          "s": 1,
          "text": "והעבודה שבה תלוי' ההנהגה ניסית."
        },
        {
          "s": 2,
          "text": "והענין הוא,"
        },
        {
          "s": 3,
          "text": "דכתיב52"
        },
        {
          "s": 4,
          "text": "אם בחוקותי תלכו ואת מצותי תשמרו ועשיתם אותם ונתתי גשמיכם וגו'."
        },
        {
          "s": 5,
          "text": "והפירוש הפשוט כפי שהוא בתושב\"כ"
        },
        {
          "s": 6,
          "text": "(אין מקרא יוצא מידי פשוטו53)"
        },
        {
          "s": 7,
          "text": "הוא שבחוקותי תלכו קאי על לימוד התורה כפשוטו,"
        },
        {
          "s": 8,
          "text": "ומצותי תשמרו קאי על קיום המצות סתם,"
        },
        {
          "s": 9,
          "text": "ואז גם השכר ונתתי גשמיכם בעתם גו' ועץ השדה יתן פריו הוא כפשוטו,"
        },
        {
          "s": 10,
          "text": "היינו,"
        },
        {
          "s": 11,
          "text": "שכר טבעי."
        },
        {
          "s": 12,
          "text": "ולמעלה מזה,"
        },
        {
          "s": 13,
          "text": "ע\"פ הפירוש בתושבע\"פ שבה מתגלה אמיתית רצון העליון54,"
        },
        {
          "s": 14,
          "text": "כמ\"ש בתו\"כ"
        },
        {
          "s": 15,
          "text": "(והובא בפרש\"י52)"
        },
        {
          "s": 16,
          "text": "שהפירוש דבחוקותי תלכו הוא"
        },
        {
          "s": 17,
          "text": "(לא רק לימוד התורה סתם,"
        },
        {
          "s": 18,
          "text": "אלא)"
        },
        {
          "s": 19,
          "text": "שתהיו עמלים בתורה,"
        },
        {
          "s": 20,
          "text": "שהו\"ע היגיעה בתורה יותר מכפי טבעו ורגילותו."
        },
        {
          "s": 21,
          "text": "וכיון שגדול תלמוד שמביא לידי מעשה55,"
        },
        {
          "s": 22,
          "text": "היינו,"
        },
        {
          "s": 23,
          "text": "שהעמל בתורה הוא על מנת לשמור ולקיים,"
        },
        {
          "s": 24,
          "text": "אזי גם מצותי תשמרו הוא"
        },
        {
          "s": 25,
          "text": "(לא רק קיום המצות סתם,"
        },
        {
          "s": 26,
          "text": "אלא)"
        },
        {
          "s": 27,
          "text": "קיום המצות בהידור וכו'."
        },
        {
          "s": 28,
          "text": "ואז גם השכר הוא באופן ניסי שלמעלה מהטבע,"
        },
        {
          "s": 29,
          "text": "ונתתי גשמיכם בעתם,"
        },
        {
          "s": 30,
          "text": "בלילי רביעית ובלילי שבתות דוקא,"
        },
        {
          "s": 31,
          "text": "ועץ השדה יתן פריו,"
        },
        {
          "s": 32,
          "text": "שגם אילני סרק עתידין להוציא פירות56."
        }
      ]
    }
  ]
}