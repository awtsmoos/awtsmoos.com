  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915545_theRebbe_780__p004",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915545_theRebbe_780",
  "title": "מאמר פדה בשלום תשמ\"א",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ויהי רצון שכאו\"א יעסוק בזה,"
        },
        {
          "s": 1,
          "text": "וכדבעי36"
        },
        {
          "s": 2,
          "text": "ויתירה מזו,"
        },
        {
          "s": 3,
          "text": "בימים האחרונים שעוד נשארו מימי הגלות,"
        },
        {
          "s": 4,
          "text": "וזה יביא בקרוב ממש,"
        },
        {
          "s": 5,
          "text": "ומתוך שמחה וטוב לבב,"
        },
        {
          "s": 6,
          "text": "שנלך בנערינו ובזקנינו בבנינו ובבנותינו37"
        },
        {
          "s": 7,
          "text": "לקבל פני משיח צדקנו."
        },
        {
          "s": 8,
          "text": "ונלך יחד עם משיח צדקנו,"
        },
        {
          "s": 9,
          "text": "ועם כל ספרי התורה שבחו\"ל,"
        },
        {
          "s": 10,
          "text": "ובכלל עם הבתי כנסיות ובתי מדרשות שבבבל"
        },
        {
          "s": 11,
          "text": "(שבחו\"ל),"
        },
        {
          "s": 12,
          "text": "אל ארץ ישראל,"
        },
        {
          "s": 13,
          "text": "ארץ הקודש38,"
        },
        {
          "s": 14,
          "text": "במהרה בימינו ממש בשמחה ובטוב לבב."
        }
      ]
    }
  ]
}