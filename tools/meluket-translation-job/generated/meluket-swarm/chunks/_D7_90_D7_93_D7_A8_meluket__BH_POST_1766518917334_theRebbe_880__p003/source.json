{
  "globalIndex": 614,
  "owner": 14,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917334_theRebbe_880__p003",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917334_theRebbe_880__p003",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917334_theRebbe_880",
  "title": "מאמר ואתה תצוה תשמ\"א",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ויש לבאר זה ע\"פ הידוע31"
        },
        {
          "s": 2,
          "text": "דזה שישראל מאמינים באלקות באמונה פשוטה ואין צריכים ראיות על זה הוא מצד שני טעמים."
        },
        {
          "s": 3,
          "text": "לפי שמזלייהו חזי32."
        },
        {
          "s": 4,
          "text": "דהנשמה שלמעלה רואה אלקות"
        },
        {
          "s": 5,
          "text": "(ראי' שלמעלה משכל),"
        },
        {
          "s": 6,
          "text": "וזה פועל בהנשמה שבגוף האמונה באלקות."
        },
        {
          "s": 7,
          "text": "ועוד ביאור,"
        },
        {
          "s": 8,
          "text": "דשורש האמונה הוא מעצם הנשמה"
        },
        {
          "s": 9,
          "text": "(שלמעלה ממזלי' חזי)."
        },
        {
          "s": 10,
          "text": "דזה שעצם הנשמה מקושרת באלקות היא התקשרות עצמית"
        },
        {
          "s": 11,
          "text": "(שאינה תלוי' בסיבה,"
        },
        {
          "s": 12,
          "text": "גם לא בענין הראי' שלמעלה משכל)."
        },
        {
          "s": 13,
          "text": "ויש לומר,"
        },
        {
          "s": 14,
          "text": "דמהחילוקים שבין שני הביאורים"
        },
        {
          "s": 15,
          "text": "(הענינים)"
        },
        {
          "s": 16,
          "text": "הוא,"
        },
        {
          "s": 17,
          "text": "דהאמונה בהנשמה המלובשת בגוף הבאה מראיית הנשמה שלמעלה היא בבחינת מקיף."
        },
        {
          "s": 18,
          "text": "דכיון שהנשמה שלמעלה היא למעלה מהתלבשות לכן פעולתה בהנשמה המלובשת בגוף היא בבחינת מקיף."
        },
        {
          "s": 19,
          "text": "ובכדי שהאמונה"
        },
        {
          "s": 20,
          "text": "(בהנשמה המלובשת בגוף)"
        },
        {
          "s": 21,
          "text": "תהי' בפנימיות,"
        },
        {
          "s": 22,
          "text": "הוא ע\"י גילוי ההתקשרות עצמית דעצם הנשמה."
        },
        {
          "s": 23,
          "text": "כי עצם הנשמה היא העצם של הנשמה המלובשת בהגוף,"
        },
        {
          "s": 24,
          "text": "ולכן,"
        },
        {
          "s": 25,
          "text": "האמונה דהנשמה המלובשת בהגוף שמצד עצם הנשמה היא בפנימיותה."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש לבאר קשר הענינים שבהמאמר,"
        },
        {
          "s": 1,
          "text": "שהענין ד"
        },
        {
          "s": 2,
          "text": "(כתית)"
        },
        {
          "s": 3,
          "text": "למאור בא בהמשך לביאור הענין דרעיא מהימנא,"
        },
        {
          "s": 4,
          "text": "כי זה שמשה זן ומפרנס את האמונה שתהי' בפנימיות הוא ע\"י שהוא מגלה את עצם הנשמה"
        },
        {
          "s": 5,
          "text": "(שלמעלה ממזלי' חזי),"
        },
        {
          "s": 6,
          "text": "מָאור שלמעלה מאור."
        },
        {
          "s": 7,
          "text": "ומ\"ש כתית למאור,"
        },
        {
          "s": 8,
          "text": "ומבאר בהמאמר שבכדי להגיע להמאור הוא ע\"י הענין דכתית שבזמן הגלות,"
        },
        {
          "s": 9,
          "text": "הוא,"
        },
        {
          "s": 10,
          "text": "כי עיקר הגילוי דעצם הנשמה"
        },
        {
          "s": 11,
          "text": "(מאור)"
        },
        {
          "s": 12,
          "text": "הוא בענין המס\"נ"
        },
        {
          "s": 13,
          "text": "(שעיקרו הוא בזמן הגלות),"
        },
        {
          "s": 14,
          "text": "כדלקמן."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והענין הוא,"
        },
        {
          "s": 2,
          "text": "דזה שהאמונה דישראל היא באופן שהוא מוסר נפשו על זה,"
        },
        {
          "s": 3,
          "text": "הוא"
        },
        {
          "s": 4,
          "text": "(בעיקר)"
        },
        {
          "s": 5,
          "text": "בהאמונה שמצד עצם הנשמה."
        },
        {
          "s": 6,
          "text": "דהאמונה מצד זה שהוא רואה"
        },
        {
          "s": 7,
          "text": "(מזלי' חזי),"
        },
        {
          "s": 8,
          "text": "הגם שהיא בתוקף גדול"
        },
        {
          "s": 9,
          "text": "[כידוע דההתאמתות שמצד הראי' היא התאמתות גדולה ביותר33],"
        },
        {
          "s": 10,
          "text": "מ\"מ,"
        },
        {
          "s": 11,
          "text": "כיון שהאמונה שלו היא מצד סיבה"
        },
        {
          "s": 12,
          "text": "(מצד זה שרואה)"
        },
        {
          "s": 13,
          "text": "ואינה קשורה עם עצם מציאותו,"
        },
        {
          "s": 14,
          "text": "אינו מוכרח שימסור נפשו על זה,"
        },
        {
          "s": 15,
          "text": "וזה שהאמונה דישראל היא באופן שהוא מוסר נפשו על זה הוא מפני שהאמונה באלקות היא העצם שלו,"
        },
        {
          "s": 16,
          "text": "ולכן אי אפשר כלל שיכפור ח\"ו."
        }
      ]
    }
  ]
}