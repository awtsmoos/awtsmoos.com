{
  "globalIndex": 922,
  "owner": 22,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919223_theRebbe_96__p007",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919223_theRebbe_96__p007",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919223_theRebbe_96",
  "title": "מאמר תפלה למשה תשכ\"ט",
  "part": 7,
  "sections": [
    {
      "v": 18,
      "items": [
        {
          "s": 0,
          "text": "וע\"פ המבואר לעיל סעיף ד דשלילת העניות"
        },
        {
          "s": 1,
          "text": "(חסרון)"
        },
        {
          "s": 2,
          "text": "היא דוקא ע\"י העשירות שלמעלה ממילוי החסרון,"
        },
        {
          "s": 3,
          "text": "משא\"כ כשהשפע הוא רק די מחסורו"
        },
        {
          "s": 4,
          "text": "[כולל גם הענין דאשר יחסר לו."
        },
        {
          "s": 5,
          "text": ","
        },
        {
          "s": 6,
          "text": "אפילו סוס לרכוב עליו ועבד לרוץ לפניו]"
        },
        {
          "s": 7,
          "text": "נשאר"
        },
        {
          "s": 8,
          "text": "(בפנימיות)"
        },
        {
          "s": 9,
          "text": "חסרון גם בנוגע לשפע המצומצם,"
        },
        {
          "s": 10,
          "text": "צריך לומר,"
        },
        {
          "s": 11,
          "text": "דגם כשהעבודה היא מצד הדעת,"
        },
        {
          "s": 12,
          "text": "הכרה והרגשה,"
        },
        {
          "s": 13,
          "text": "אבל רק דעת תחתון שמקבל מאריך,"
        },
        {
          "s": 14,
          "text": "העבודה היא כמו דבר נוסף עליו,"
        },
        {
          "s": 15,
          "text": "והאדם עצמו"
        },
        {
          "s": 16,
          "text": "(בפנימיותו)"
        },
        {
          "s": 17,
          "text": "חסר העבודה,"
        },
        {
          "s": 18,
          "text": "היינו שנשאר מקום בהאדם ששם אין מאיר גילוי אלקות."
        },
        {
          "s": 19,
          "text": "דהגם שענין ההכרה וההרגשה"
        },
        {
          "s": 20,
          "text": "(גם דדעת תחתון)"
        },
        {
          "s": 21,
          "text": "הוא שהאדם עצמו מכיר ומרגיש"
        },
        {
          "s": 22,
          "text": "(כנ\"ל סעיף ג),"
        },
        {
          "s": 23,
          "text": "מ\"מ,"
        },
        {
          "s": 24,
          "text": "כיון שענינו של האדם הוא מציאות"
        },
        {
          "s": 25,
          "text": "(ולא שענינו הוא הרגשת אלקות),"
        },
        {
          "s": 26,
          "text": "הרי ההכרה וההרגשה שלו באלקות היא כמו דבר נוסף עליו."
        }
      ]
    },
    {
      "v": 19,
      "items": [
        {
          "s": 0,
          "text": "ובעומק יותר יש לומר,"
        },
        {
          "s": 1,
          "text": "דזה שבהעבודה דדעת תחתון נשאר עדיין חסרון,"
        },
        {
          "s": 2,
          "text": "הוא לא רק מפני שהאדם וההכרה שלו באלקות הם שני דברים,"
        },
        {
          "s": 3,
          "text": "אלא שגם מצד ההכרה עצמה"
        },
        {
          "s": 4,
          "text": "(ההכרה דדעת תחתון)"
        },
        {
          "s": 5,
          "text": "יש נתינת מקום למציאות שמחוץ לאלקות93."
        },
        {
          "s": 6,
          "text": "דכיון שדעת תחתון מקבל מחיצוניות הכתר,"
        },
        {
          "s": 7,
          "text": "אריך,"
        },
        {
          "s": 8,
          "text": "דבכללות הוא בחינת סובב שהוא כמו מקור לעולמות,"
        },
        {
          "s": 9,
          "text": "לכן,"
        },
        {
          "s": 10,
          "text": "גם מצד הדעת עצמו יש נתינת מקום למציאות."
        },
        {
          "s": 11,
          "text": "וזה גופא הוא הסיבה לזה שע\"י הגילוי דדרגא זו בהאדם נשאר הוא במציאותו,"
        },
        {
          "s": 12,
          "text": "מציאות שמחוץ לאלקות."
        },
        {
          "s": 13,
          "text": "ובכדי שיתמלא החסרון לגמרי,"
        },
        {
          "s": 14,
          "text": "היינו שלא יהי' שום מקום שאין מאיר בו גילוי אלקות,"
        },
        {
          "s": 15,
          "text": "הוא ע\"י העבודה דדעת עליון שמקבל מפנימיות הכתר,"
        },
        {
          "s": 16,
          "text": "עתיק,"
        },
        {
          "s": 17,
          "text": "דבכללות הוא עצמות אוא\"ס."
        },
        {
          "s": 18,
          "text": "דלגבי עצמות אוא\"ס אין שום מציאות שחוץ ממנו,"
        },
        {
          "s": 19,
          "text": "ואדרבה,"
        },
        {
          "s": 20,
          "text": "אמיתית המצאו ית' היא היא אמיתית המציאות של כל הנמצאים94."
        },
        {
          "s": 21,
          "text": "ולכן ע\"י הגילוי דדעת עליון,"
        },
        {
          "s": 22,
          "text": "הכרת האדם באלקות היא באופן שזה"
        },
        {
          "s": 23,
          "text": "(הכרת אלקות)"
        },
        {
          "s": 24,
          "text": "היא כל מציאותו."
        }
      ]
    },
    {
      "v": 20,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש לבאר מה שתפלת משה למלאות החסרון דכנסת ישראל נקראת בשם תפלת עשיר,"
        },
        {
          "s": 1,
          "text": "אף שהחסרון דכנס\"י הי' בודאי נוגע לו במאד,"
        },
        {
          "s": 2,
          "text": "כי משה הוא בחינת דעת עליון"
        },
        {
          "s": 3,
          "text": "(כנ\"ל),"
        },
        {
          "s": 4,
          "text": "ומצד דעת עליון,"
        },
        {
          "s": 5,
          "text": "ענין העשירות,"
        },
        {
          "s": 6,
          "text": "אין שייך ענין החסרון."
        },
        {
          "s": 7,
          "text": "היינו,"
        },
        {
          "s": 8,
          "text": "דנוסף לזה שבמשה עצמו אין שייך שום חסרון ח\"ו,"
        },
        {
          "s": 9,
          "text": "אלא שלגבי משה,"
        },
        {
          "s": 10,
          "text": "גם החסרון דכנס\"י שהתפלל עליהם אינו חסרון,"
        },
        {
          "s": 11,
          "text": "כי דעת עליון מקבל מעתיק,"
        },
        {
          "s": 12,
          "text": "ולכן נרגש בו שאמיתית המצאו ית' הוא אמיתית המציאות של כל הנמצאים ואינם חסרים מאומה."
        },
        {
          "s": 13,
          "text": "והגם שמשה התפלל עליהם,"
        },
        {
          "s": 14,
          "text": "דענין התפלה הוא למלאות החסרון – יש לומר,"
        },
        {
          "s": 15,
          "text": "שהתפלה שלו היתה שענין זה"
        },
        {
          "s": 16,
          "text": "(שהאמת היא שאינם חסרים מאומה)"
        },
        {
          "s": 17,
          "text": "יהי' נרגש בגילוי גם אצלם."
        },
        {
          "s": 18,
          "text": "אבל במשה הי' נרגש זה"
        },
        {
          "s": 19,
          "text": "(שאינם חסרים מאומה)"
        },
        {
          "s": 20,
          "text": "בגילוי גם כשהיו במצב שהוצרך להתפלל עליהם,"
        },
        {
          "s": 21,
          "text": "ולכן,"
        },
        {
          "s": 22,
          "text": "התפלה שלו היא תפלת עשיר."
        },
        {
          "s": 23,
          "text": "ולהוסיף,"
        },
        {
          "s": 24,
          "text": "דזה שתפלת משה נקראת תפלת עשיר הוא לא רק מפני שגם אז"
        },
        {
          "s": 25,
          "text": "(בעת התפלה)"
        },
        {
          "s": 26,
          "text": "הי' עשיר,"
        },
        {
          "s": 27,
          "text": "אלא יתירה מזה,"
        },
        {
          "s": 28,
          "text": "שהתפלה שלו היתה מפני שהוא עשיר."
        },
        {
          "s": 29,
          "text": "כי תפלת משה שיתמלא החסרון דכנס\"י"
        },
        {
          "s": 30,
          "text": "[דכנס\"י כפשוטו,"
        },
        {
          "s": 31,
          "text": "ועי\"ז – החסרון דמלכות,"
        },
        {
          "s": 32,
          "text": "ודהעולם]"
        },
        {
          "s": 33,
          "text": "הוא שיתמלא החסרון לגמרי,"
        },
        {
          "s": 34,
          "text": "שלא יהי' שום מקום שאין מאיר בו גילוי אלקות,"
        },
        {
          "s": 35,
          "text": "ובכדי שיתמלא החסרון לגמרי הוא דוקא ע\"י הגילוי דדעת עליון,"
        },
        {
          "s": 36,
          "text": "כנ\"ל."
        }
      ]
    }
  ]
}