{
  "globalIndex": 301,
  "owner": 1,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915493_theRebbe_561__p003",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915493_theRebbe_561__p003",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915493_theRebbe_561",
  "title": "מאמר וכל בניך תשמ\"א",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וצריך להבין,"
        },
        {
          "s": 2,
          "text": "הרי התורה היא נצחית36,"
        },
        {
          "s": 3,
          "text": "וכל הסיפורים וההוראות שבתורה הם הוראות נצחיות,"
        },
        {
          "s": 4,
          "text": "ומכיון שהעבודה עכשיו היא בדרך מלמטה למעלה,"
        },
        {
          "s": 5,
          "text": "למה נכתב בתורה,"
        },
        {
          "s": 6,
          "text": "ובאריכות,"
        },
        {
          "s": 7,
          "text": "הסיפור דוישלח יעקב גו' אל עשו,"
        },
        {
          "s": 8,
          "text": "שתוכנו הוא בירור מלמעלה למטה."
        },
        {
          "s": 9,
          "text": "וביותר צריך ביאור מה שמסופר בתורה"
        },
        {
          "s": 10,
          "text": "(שהיא נצחית)"
        },
        {
          "s": 11,
          "text": "גם סדר הבירור דיעקב,"
        },
        {
          "s": 12,
          "text": "הבירור דג\"ר"
        },
        {
          "s": 13,
          "text": "(לבן)"
        },
        {
          "s": 14,
          "text": "לפני הבירור דז\"ת"
        },
        {
          "s": 15,
          "text": "(עשו)."
        },
        {
          "s": 16,
          "text": "ויש לומר הביאור,"
        },
        {
          "s": 17,
          "text": "דזה שאצל יעקב אבינו הי' הבירור בדרך מלמעלמ\"ט הוא"
        },
        {
          "s": 18,
          "text": "(ככל מעשה אבות37"
        },
        {
          "s": 19,
          "text": "שהם)"
        },
        {
          "s": 20,
          "text": "סימן ונתינת כח לבנים38"
        },
        {
          "s": 21,
          "text": "על עבודה זו גופא."
        },
        {
          "s": 22,
          "text": "והיינו,"
        },
        {
          "s": 23,
          "text": "דנוסף על זה שהבירור דיעקב בדרך מלמעלה למטה הוא נתינת כח על הבירור בדרך מלמטה למעלה"
        },
        {
          "s": 24,
          "text": "(עיקר הבירור דעכשיו),"
        },
        {
          "s": 25,
          "text": "הוא נתינת כח גם על ענין הבירור בדרך מלמעלה למטה דבנים,"
        },
        {
          "s": 26,
          "text": "הבירור שע\"י תורה."
        },
        {
          "s": 27,
          "text": "ובתורה גופא – הבירור שע\"י פנימיות התורה,"
        },
        {
          "s": 28,
          "text": "דעיקר ענין הבירור בדרך מלמעלה למטה הוא בפנימיות התורה."
        },
        {
          "s": 29,
          "text": "וכמשנת\"ל"
        },
        {
          "s": 30,
          "text": "(בד\"ה פדה בשלום39)"
        },
        {
          "s": 31,
          "text": "בארוכה,"
        },
        {
          "s": 32,
          "text": "דהבירור שע\"י נגלה דתורה,"
        },
        {
          "s": 33,
          "text": "מכיון שנתלבשה בעה\"ד טו\"ר בכדי לברר בירורים,"
        },
        {
          "s": 34,
          "text": "הוא דוגמת הבירור בדרך מלמטה למעלה,"
        },
        {
          "s": 35,
          "text": "בהתלבשות"
        },
        {
          "s": 36,
          "text": "(בדרך מלחמה),"
        },
        {
          "s": 37,
          "text": "משא\"כ הבירור שע\"י פנימיות התורה,"
        },
        {
          "s": 38,
          "text": "אילנא דחיי"
        },
        {
          "s": 39,
          "text": "(שאינה מלובשת בטו\"ר)40,"
        },
        {
          "s": 40,
          "text": "הוא שלא בדרך התלבשות,"
        },
        {
          "s": 41,
          "text": "מלמעלה למטה."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "והנה חילוק הנ\"ל שבין נגלה דתורה לפנימיות התורה הוא בכללות,"
        },
        {
          "s": 2,
          "text": "אבל בפרטיות,"
        },
        {
          "s": 3,
          "text": "יש בכל א' מהם שני הענינים"
        },
        {
          "s": 4,
          "text": "(כי תורה כללות ופרטות נאמרה41)."
        },
        {
          "s": 5,
          "text": "והענין הוא,"
        },
        {
          "s": 6,
          "text": "כמ\"ש אדה\"ז,"
        },
        {
          "s": 7,
          "text": "בעל הגאולה די\"ט כסלו"
        },
        {
          "s": 8,
          "text": "[דשבת זה מיני' מתברכין כולהו יומין שלאחריו42,"
        },
        {
          "s": 9,
          "text": "כולל יום הגאולה י\"ט כסלו]"
        },
        {
          "s": 10,
          "text": "בתניא43"
        },
        {
          "s": 11,
          "text": "דלימוד פנימיות התורה היא \"מצוה רמה44"
        },
        {
          "s": 12,
          "text": "ונשאה כו' ומביאה ללב שלם\","
        },
        {
          "s": 13,
          "text": "היינו,"
        },
        {
          "s": 14,
          "text": "דבלימוד פנימיות התורה שני ענינים."
        },
        {
          "s": 15,
          "text": "הא',"
        },
        {
          "s": 16,
          "text": "שמביאה ללב שלם,"
        },
        {
          "s": 17,
          "text": "דענין זה שבפנימיות התורה שייך לבירור המדות,"
        },
        {
          "s": 18,
          "text": "והב',"
        },
        {
          "s": 19,
          "text": "שהלימוד והידיעה דפנימיות התורה"
        },
        {
          "s": 20,
          "text": "(מצד עצמו)"
        },
        {
          "s": 21,
          "text": "הוא \"מצוה רמה ונשאה\" – ענין פנימיות התורה שלמעלה מבירורים45."
        },
        {
          "s": 22,
          "text": "ועד\"ז לאידך גיסא,"
        },
        {
          "s": 23,
          "text": "שגם בנגלה דתורה ישנם ענינים שלמעלה מענין הבירורים."
        },
        {
          "s": 24,
          "text": "וכמו הלימוד באופן ד\"דרוש וקבל שכר\"46"
        },
        {
          "s": 25,
          "text": "שאינו נוגע למעשה,"
        },
        {
          "s": 26,
          "text": "שהוא"
        },
        {
          "s": 27,
          "text": "(בנגלה דתורה גופא)"
        },
        {
          "s": 28,
          "text": "למעלה מענין הבירורים."
        },
        {
          "s": 29,
          "text": "וענין זה"
        },
        {
          "s": 30,
          "text": "(שגם בנגלה דתורה יש ענין שלמעלה מבירורים)"
        },
        {
          "s": 31,
          "text": "מודגש יותר בתורה שבכתב."
        },
        {
          "s": 32,
          "text": "דלימוד התושב\"כ בהבנה והשגה,"
        },
        {
          "s": 33,
          "text": "ובפרט לימוד ההוראות שבה"
        },
        {
          "s": 34,
          "text": "(הן בההלכות דתושב\"כ והן בהסיפורים שבה)"
        },
        {
          "s": 35,
          "text": "בנוגע למעשה,"
        },
        {
          "s": 36,
          "text": "שייך לענין הבירורים,"
        },
        {
          "s": 37,
          "text": "משא\"כ לימוד הסיפורים דתושב\"כ כמו שהם מצד עצמם47,"
        },
        {
          "s": 38,
          "text": "ומכ\"ש הקריאה בתושב\"כ שלמעלה מהשגה לגמרי"
        },
        {
          "s": 39,
          "text": "(שגם זה שאינו מבין אפילו פירוש המלות מקיים מצות ת\"ת48),"
        },
        {
          "s": 40,
          "text": "הוא כמו פנימיות התורה שלמעלה מבירורים."
        },
        {
          "s": 41,
          "text": "וכמבואר בלקו\"ת49"
        },
        {
          "s": 42,
          "text": "דפנימיות התורה היא בכלל שליש50"
        },
        {
          "s": 43,
          "text": "במקרא."
        },
        {
          "s": 44,
          "text": "ועד\"ז הוא גם לאידך גיסא,"
        },
        {
          "s": 45,
          "text": "שגם בספר התניא,"
        },
        {
          "s": 46,
          "text": "התושב\"כ דחסידות51"
        },
        {
          "s": 47,
          "text": "(פנימיות התורה),"
        },
        {
          "s": 48,
          "text": "יש גם ענין ששייך לבירורים,"
        },
        {
          "s": 49,
          "text": "כמ\"ש אדה\"ז בההקדמה וגם בהשער"
        },
        {
          "s": 50,
          "text": "(של התניא)"
        },
        {
          "s": 51,
          "text": "שהוא מיוסד על פסוק52"
        },
        {
          "s": 52,
          "text": "כי קרוב אליך הדבר מאד בפיך ובלבבך לעשותו לבאר היטב איך הוא קרוב מאד כו',"
        },
        {
          "s": 53,
          "text": "היינו שהכוונה והתכלית דספר התניא הוא לבאר איך לעשותו53."
        },
        {
          "s": 54,
          "text": "אלא שענין זה"
        },
        {
          "s": 55,
          "text": "[שהן בנגלה דתורה והן בפנימיות התורה ישנם שני הענינים]"
        },
        {
          "s": 56,
          "text": "הוא בפרטיות,"
        },
        {
          "s": 57,
          "text": "אבל בכללות,"
        },
        {
          "s": 58,
          "text": "נגלה דתורה שייכת לבירורים"
        },
        {
          "s": 59,
          "text": "(ובאופן דהתלבשות),"
        },
        {
          "s": 60,
          "text": "ופנימיות התורה היא אילנא דחיי שלמעלה מענין הבירורים,"
        },
        {
          "s": 61,
          "text": "והבירור שנעשה ע\"י לימוד פנימיות התורה הוא שלא בדרך התלבשות."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "דכמו שהבירור דיעקב,"
        },
        {
          "s": 3,
          "text": "להיותו באופן דמלמעלמ\"ט"
        },
        {
          "s": 4,
          "text": "(ע\"י גילוי אור עליון),"
        },
        {
          "s": 5,
          "text": "הי' גם בהסדר דמלמעלה למטה,"
        },
        {
          "s": 6,
          "text": "שבירר הג\"ר לפני שבירר המדות,"
        },
        {
          "s": 7,
          "text": "עד\"ז הוא גם בפנימיות התורה,"
        },
        {
          "s": 8,
          "text": "דע\"י לימוד החסידות בהבנה והשגה,"
        },
        {
          "s": 9,
          "text": "נעשה בירור המוחין וגם דנפש הבהמית,"
        },
        {
          "s": 10,
          "text": "כולל גם המוחין שלמעלה משייכות למדות."
        },
        {
          "s": 11,
          "text": "דהבירור שע\"י נגלה דתורה הוא"
        },
        {
          "s": 12,
          "text": "(בעיקר)"
        },
        {
          "s": 13,
          "text": "בהמדות ובהמוחין השייכים למדות,"
        },
        {
          "s": 14,
          "text": "משא\"כ ע\"י לימוד פנימיות התורה,"
        },
        {
          "s": 15,
          "text": "מכיון שהיא \"מצוה רמה ונשאה\" מצד עצמה"
        },
        {
          "s": 16,
          "text": "(למעלה מזה ש\"מביאה ללב שלם\"),"
        },
        {
          "s": 17,
          "text": "נעשה הבירור גם בעצם המוחין."
        },
        {
          "s": 18,
          "text": "והגם שהכיבוש דקיני קניזי וקדמוני"
        },
        {
          "s": 19,
          "text": "(עצם המוחין שלמעלה ממדות)"
        },
        {
          "s": 20,
          "text": "יהי' רק לעת\"ל"
        },
        {
          "s": 21,
          "text": "(לאחרי השלימות דבירור המדות והמוחין השייכים למדות),"
        },
        {
          "s": 22,
          "text": "מ\"מ,"
        },
        {
          "s": 23,
          "text": "מעין זה הוא גם עכשיו ע\"י לימוד פנימיות התורה."
        },
        {
          "s": 24,
          "text": "וזהו מה שמסופר בתורה אופן הבירור דיעקב"
        },
        {
          "s": 25,
          "text": "(ע\"י גילוי אור עליון)"
        },
        {
          "s": 26,
          "text": "וגם סדר הבירור"
        },
        {
          "s": 27,
          "text": "(שהתחיל בהבירור דג\"ר),"
        },
        {
          "s": 28,
          "text": "דשני ענינים אלו הם"
        },
        {
          "s": 29,
          "text": "(ככל הענינים שבתורה)"
        },
        {
          "s": 30,
          "text": "הוראות נצחיות גם עכשיו,"
        },
        {
          "s": 31,
          "text": "כנ\"ל."
        }
      ]
    }
  ]
}