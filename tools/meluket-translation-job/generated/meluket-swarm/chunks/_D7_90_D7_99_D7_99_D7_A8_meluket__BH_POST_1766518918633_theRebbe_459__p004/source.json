{
  "globalIndex": 814,
  "owner": 14,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918633_theRebbe_459__p004",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918633_theRebbe_459__p004",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918633_theRebbe_459",
  "title": "מאמר בחודש השלישי תשכ\"ט",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ויובן זה ע\"פ מה שאמרו רז\"ל39"
        },
        {
          "s": 2,
          "text": "בשעה שהקדימו ישראל נעשה לנשמע באו מלאכי השרת וקשרו לכל אחד מישראל שני כתרים אחד כנגד נעשה ואחד כנגד נשמע."
        },
        {
          "s": 3,
          "text": "וידוע הדיוק בזה40,"
        },
        {
          "s": 4,
          "text": "דבתחלת המאמר בשעה שהקדימו כו' משמע דזה שקשרו להם שני כתרים הוא מפני שהקדימו נעשה לנשמע,"
        },
        {
          "s": 5,
          "text": "ובסיום המאמר אומר אחד כנגד נעשה ואחד כנגד נשמע,"
        },
        {
          "s": 6,
          "text": "דשני הכתרים הם עבור נעשה ונשמע עצמם."
        },
        {
          "s": 7,
          "text": "ומבאר אדמו\"ר מהר\"ש במאמרו ד\"ה בשעה שהקדימו שנאמר בש\"פ במדבר לפני מאה שנה41,"
        },
        {
          "s": 8,
          "text": "דנעשה הוא קבלת עול מלכות שמים ונשמע הוא קבלת עול מצוות."
        },
        {
          "s": 9,
          "text": "וענין הקדמת נעשה לנשמע הוא כמאמר רז\"ל42"
        },
        {
          "s": 10,
          "text": "למה קדמה פרשת שמע לוהי' אם שמוע כדי שיקבל עליו עול מלכות שמים תחלה ואח\"כ יקבל עליו עול מצוות."
        },
        {
          "s": 11,
          "text": "ומבאר שם,"
        },
        {
          "s": 12,
          "text": "דפרשה ראשונה היא רצוא ומסירת נפש ופרשה שני' היא שוב."
        },
        {
          "s": 13,
          "text": "וכמו שברצוא ושוב,"
        },
        {
          "s": 14,
          "text": "בתחלה צ\"ל רצוא ואח\"כ שוב,"
        },
        {
          "s": 15,
          "text": "עד\"ז הוא בקבלת עומ\"ש וקבלת עול מצוות,"
        },
        {
          "s": 16,
          "text": "שלפני קבלת עול מצוות צ\"ל קבלת עומ\"ש."
        },
        {
          "s": 17,
          "text": "ועפ\"ז מבאר שם43"
        },
        {
          "s": 18,
          "text": "מה שארז\"ל בשעה שהקדימו כו',"
        },
        {
          "s": 19,
          "text": "אף ששני הכתרים הם כנגד נעשה ונשמע עצמם"
        },
        {
          "s": 20,
          "text": "[אחד כנגד נעשה ואחד כנגד נשמע],"
        },
        {
          "s": 21,
          "text": "כי בכדי שיהי' השוב"
        },
        {
          "s": 22,
          "text": "(נשמע)"
        },
        {
          "s": 23,
          "text": "צ\"ל קדימת הרצוא"
        },
        {
          "s": 24,
          "text": "(נעשה)."
        },
        {
          "s": 25,
          "text": "וממשיך בהמאמר שם,"
        },
        {
          "s": 26,
          "text": "דזה שקשרו להם שני כתרים"
        },
        {
          "s": 27,
          "text": "(כתרים דוקא),"
        },
        {
          "s": 28,
          "text": "הוא,"
        },
        {
          "s": 29,
          "text": "כי כתר הוא מקיף,"
        },
        {
          "s": 30,
          "text": "סובב,"
        },
        {
          "s": 31,
          "text": "ויש בזה ב' ענינים,"
        },
        {
          "s": 32,
          "text": "עליית ממלא בסובב והמשכת סובב בממלא."
        },
        {
          "s": 33,
          "text": "ולכאורה הכוונה,"
        },
        {
          "s": 34,
          "text": "דכתר שכנגד נעשה"
        },
        {
          "s": 35,
          "text": "(רצוא)"
        },
        {
          "s": 36,
          "text": "הוא עליית ממלא בסובב וכתר שכנגד נשמע"
        },
        {
          "s": 37,
          "text": "(שוב)"
        },
        {
          "s": 38,
          "text": "הוא המשכת סובב בממלא."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דזה שמוסיף בהמאמר שזה שקשרו להם שני כתרים הוא כי כתר הוא מקיף,"
        },
        {
          "s": 2,
          "text": "הוא,"
        },
        {
          "s": 3,
          "text": "כי מלשון רז\"ל בשעה שהקדימו כו' קשרו להם שני כתרים משמע שהדיוק דהקדימו נעשה לנשמע שייך לשני הכתרים שכנגד נעשה ונשמע"
        },
        {
          "s": 4,
          "text": "(ולא לנעשה ונשמע עצמם),"
        },
        {
          "s": 5,
          "text": "ולכן מבאר דכתר הוא מקיף וסובב ושני הכתרים הם שני ענינים בסובב,"
        },
        {
          "s": 6,
          "text": "כי זהו ביאור על זה שקשירת שני הכתרים היתה דוקא ע\"י שהקדימו נעשה לנשמע"
        },
        {
          "s": 7,
          "text": "(כדלקמן)."
        },
        {
          "s": 8,
          "text": "וזה שמבאר לפנ\"ז דזה שצריך להקדים נעשה לנשמע הוא כי נעשה ונשמע הם כמו רצוא ושוב,"
        },
        {
          "s": 9,
          "text": "הוא ביאור על זה שהכתר שכנגד נשמע"
        },
        {
          "s": 10,
          "text": "(מקיף וסובב)"
        },
        {
          "s": 11,
          "text": "הוא דוקא כשהנשמע הוא לאחרי הקדימה דנעשה."
        },
        {
          "s": 12,
          "text": "כי מקיף וסובב הוא למעלה משייכות לעולמות,"
        },
        {
          "s": 13,
          "text": "וכיון שנשמע הוא שוב והמשכה למטה,"
        },
        {
          "s": 14,
          "text": "לכן,"
        },
        {
          "s": 15,
          "text": "זה שקשרו כתר"
        },
        {
          "s": 16,
          "text": "(מקיף וסובב שלמעלה מעולם)"
        },
        {
          "s": 17,
          "text": "כנגד נשמע"
        },
        {
          "s": 18,
          "text": "(המשכה למטה)"
        },
        {
          "s": 19,
          "text": "הוא דוקא מפני שהנשמע הי' לאחרי ההקדמה דנעשה44,"
        },
        {
          "s": 20,
          "text": "רצוא ועלי' למעלה."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "וצריך ביאור,"
        },
        {
          "s": 2,
          "text": "הרי כללות הענין דקבלת עול,"
        },
        {
          "s": 3,
          "text": "גם קבלת עול מצוות"
        },
        {
          "s": 4,
          "text": "(נשמע),"
        },
        {
          "s": 5,
          "text": "הוא ביטול,"
        },
        {
          "s": 6,
          "text": "דענין הביטול הוא שהאדם יוצא ממציאותו,"
        },
        {
          "s": 7,
          "text": "וקשירת הכתר שכנגד נשמע הוא דוקא כשהנשמע הוא לאחרי הקדימה דנעשה."
        },
        {
          "s": 8,
          "text": "וי\"ל הביאור בזה ע\"פ הידוע45"
        },
        {
          "s": 9,
          "text": "שהמקיף דכתר הוא אמיתית המקיף שלמעלה מהמקיף השייך לפנימי."
        },
        {
          "s": 10,
          "text": "דזהו החילוק בין כתר לגלגלתא,"
        },
        {
          "s": 11,
          "text": "דגלגלתא הוא מקיף השייך לפנימי,"
        },
        {
          "s": 12,
          "text": "בדוגמת הגולגולת שבאדם שמקיף את המוח אבל שייך אליו,"
        },
        {
          "s": 13,
          "text": "שהרי הגולגולת היא מגופו כמו המוח."
        },
        {
          "s": 14,
          "text": "והמקיף דכתר הוא מקיף שלמעלה משייכות לפנימי,"
        },
        {
          "s": 15,
          "text": "בדוגמת כתר כפשוטו שהוא עטרה על המוח והגולגולת ואין לו קשר אליהם"
        },
        {
          "s": 16,
          "text": "(שהרי הכתר הוא מאבנים טובות ולא מגוף האדם)."
        },
        {
          "s": 17,
          "text": "והגם שגם גלגלתא נק' בשם כתר,"
        },
        {
          "s": 18,
          "text": "זהו בכללות,"
        },
        {
          "s": 19,
          "text": "אבל עיקר הכתר הוא המקיף שאינו שייך לפנימי"
        },
        {
          "s": 20,
          "text": "(שלמעלה מהמקיף דגלגלתא)."
        },
        {
          "s": 21,
          "text": "וע\"ד הרצון שבאדם,"
        },
        {
          "s": 22,
          "text": "דרצון הוא מקיף על כל הכחות והאברים,"
        },
        {
          "s": 23,
          "text": "שיש בו שתי מדריגות46."
        },
        {
          "s": 24,
          "text": "הרצון לעשות איזה דבר ע\"י הכחות שלו,"
        },
        {
          "s": 25,
          "text": "דרצון זה עם היותו שולט על כל הכחות לפי שהוא מקיף עליהם,"
        },
        {
          "s": 26,
          "text": "מ\"מ,"
        },
        {
          "s": 27,
          "text": "זה עצמו שהוא רוצה בפעולת הכחות,"
        },
        {
          "s": 28,
          "text": "הוא הוכחה שיש לו שייכות אליהם – מקיף דגלגלתא."
        },
        {
          "s": 29,
          "text": "והוא ירידה לגבי הרצון עצמו כמו שהוא למעלה מהרצון לעשות – מקיף דכתר."
        }
      ]
    }
  ]
}