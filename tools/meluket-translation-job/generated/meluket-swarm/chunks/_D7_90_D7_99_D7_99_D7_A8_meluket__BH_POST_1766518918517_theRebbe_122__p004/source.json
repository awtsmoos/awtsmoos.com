{
  "globalIndex": 792,
  "owner": 42,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918517_theRebbe_122__p004",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918517_theRebbe_122__p004",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918517_theRebbe_122",
  "title": "מאמר שיר המעלות תשכ\"ב",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה ענין זה שבתפלה"
        },
        {
          "s": 2,
          "text": "(שעל ידה נמשכת השפעה חדשה)"
        },
        {
          "s": 3,
          "text": "הוא בכללות גם בתורה."
        },
        {
          "s": 4,
          "text": "דזה שע\"י הפסק דין שבתורה נעשה שינוי בעולם22"
        },
        {
          "s": 5,
          "text": "[שנעשה דבר חדש שלא הי' גם בשרש ומקור העולם],"
        },
        {
          "s": 6,
          "text": "הוא,"
        },
        {
          "s": 7,
          "text": "כי התורה היא למעלה משרש העולם"
        },
        {
          "s": 8,
          "text": "(כי התורה היא חכמתו ית' שלמעלה מהחכמה דמעשה בראשית),"
        },
        {
          "s": 9,
          "text": "ולכן,"
        },
        {
          "s": 10,
          "text": "ע\"י הפס\"ד דתורה נעשה שינוי וחידוש בהעולם."
        },
        {
          "s": 11,
          "text": "ונמצא,"
        },
        {
          "s": 12,
          "text": "שבתורה ישנם ב' המעלות,"
        },
        {
          "s": 13,
          "text": "המעלה דתפלה – המשכת ענין חדש,"
        },
        {
          "s": 14,
          "text": "והמעלה דברכה23."
        },
        {
          "s": 15,
          "text": "דהשינוי והחידוש שנעשה בעולם ע\"י הפס\"ד דהת\"ח העוסק בתורה הוא"
        },
        {
          "s": 16,
          "text": "(לא בדרך בקשה כבתפלה,"
        },
        {
          "s": 17,
          "text": "אלא)"
        },
        {
          "s": 18,
          "text": "בדרך ממילא."
        },
        {
          "s": 19,
          "text": "וכידוע24"
        },
        {
          "s": 20,
          "text": "בענין מאן מלכי רבנן25,"
        },
        {
          "s": 21,
          "text": "דלהיות שלימוד התורה שלהם הוא בביטול,"
        },
        {
          "s": 22,
          "text": "הרי הפסקי דינים שלהם הוא שהמלך עצמו"
        },
        {
          "s": 23,
          "text": "(מלך מלכי המלכים הקב\"ה)"
        },
        {
          "s": 24,
          "text": "גוזר ואומר את הפסק דין,"
        },
        {
          "s": 25,
          "text": "וכיון שזהו גזירת המלך,"
        },
        {
          "s": 26,
          "text": "נעשה כן ממילא."
        },
        {
          "s": 27,
          "text": "ועד\"ז הוא בנוגע להמופתים שעשו התנאים ואמוראים ע\"י עסק התורה שלהם26,"
        },
        {
          "s": 28,
          "text": "כמו רפב\"י שאמר גינאי נהרא חלוק לי מימיך27,"
        },
        {
          "s": 29,
          "text": "שישנם בזה שתי המעלות."
        },
        {
          "s": 30,
          "text": "שינוי וחידוש בהנהר"
        },
        {
          "s": 31,
          "text": "(שאינו גם בשרשו ומקורו28)"
        },
        {
          "s": 32,
          "text": "– המעלה דתפלה,"
        },
        {
          "s": 33,
          "text": "ושהשינוי בהנהר נעשה ע\"י הציווי של רפב\"י – המעלה דברכה."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "אלא שאעפ\"כ מעלה בתפלה לגבי תורה,"
        },
        {
          "s": 2,
          "text": "כי תורה היא חכמה,"
        },
        {
          "s": 3,
          "text": "וחכמה"
        },
        {
          "s": 4,
          "text": "(גם החכמה דתורה שלמעלה מהחכמה דמעשה בראשית)"
        },
        {
          "s": 5,
          "text": "היא באין ערוך לגבי אוא\"ס,"
        },
        {
          "s": 6,
          "text": "וע\"י התפלה ממשיכים רצון חדש מאוא\"ס שלמעלה גם מהחכמה דתורה29."
        },
        {
          "s": 7,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 8,
          "text": "דהחידוש בזה שרשב\"י המשיך ירידת גשמים ע\"י אמירת תורה לגבי המופתים העצומים30"
        },
        {
          "s": 9,
          "text": "שעשו כמה תנאים ואמוראים ע\"י עסק התורה שלהם,"
        },
        {
          "s": 10,
          "text": "הוא,"
        },
        {
          "s": 11,
          "text": "שהשינוי בעולם שעשו כל התנאים והאמוראים הוא ע\"י שהמשיכו וגילו שכן הוא ע\"פ חכמת התורה31,"
        },
        {
          "s": 12,
          "text": "והחידוש דירידת מטר ע\"י שרשב\"י אמר דרוש בפסוק הנה מה טוב ומה נעים שבת אחים גם יחד,"
        },
        {
          "s": 13,
          "text": "הוא,"
        },
        {
          "s": 14,
          "text": "דהגם שהדרוש שאמר שייך רק לענין המטר32"
        },
        {
          "s": 15,
          "text": "בכלל אבל לא הי' בו רמז שהעולם הי' ראוי אז למטר,"
        },
        {
          "s": 16,
          "text": "ונמצא שגם ע\"פ חכמת התורה"
        },
        {
          "s": 17,
          "text": "(שלמעלה משרש העולם)"
        },
        {
          "s": 18,
          "text": "לא הי' העולם ראוי למטר,"
        },
        {
          "s": 19,
          "text": "וזה שירד אז מטר ע\"י אמירת הדרוש הוא לפי שע\"י אמירת הדרוש המשיך מאוא\"ס שלמעלה מהחכמה דתורה,"
        },
        {
          "s": 20,
          "text": "בדוגמת ההמשכה שע\"י תפלה."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דזה שע\"י אמירת תורה דהרשב\"י נמשך מאוא\"ס שלמעלה מהחכמה דתורה,"
        },
        {
          "s": 2,
          "text": "הוא,"
        },
        {
          "s": 3,
          "text": "כי בפנימיות התורה מאיר בגילוי אוא\"ס33,"
        },
        {
          "s": 4,
          "text": "ולהיות שרשב\"י הי' מקור פנימיות התורה"
        },
        {
          "s": 5,
          "text": "[וגם בלימוד הנגלה שלו האיר הפנימיות34],"
        },
        {
          "s": 6,
          "text": "לכן ע\"י אמירת תורה שלו המשיך בגילוי אוא\"ס שלמעלה מהתורה."
        }
      ]
    }
  ]
}