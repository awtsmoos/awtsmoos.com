{
  "globalIndex": 679,
  "owner": 29,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917769_theRebbe_254__p004",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917769_theRebbe_254__p004",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917769_theRebbe_254",
  "title": "מאמר ביום עשתי עשר תשל\"א",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "שענין זה הוא האהבה דמי לי בשמים ועמך לא חפצתי65,"
        },
        {
          "s": 3,
          "text": "וכלשון אדמו\"ר הזקן66"
        },
        {
          "s": 4,
          "text": "\"איך וויל זע גאָר ניסט איך וויל ניט דאיין ג\"ע איך וויל ניט דאיין עוה\"ב כו' איך וויל מער ניט אַז דיך אַליין\"."
        },
        {
          "s": 5,
          "text": "דהגם שהגילויים שבג\"ע ומכ\"ש הגילויים דעוה\"ב הם גילויים נעלים ביותר,"
        },
        {
          "s": 6,
          "text": "ואדמו\"ר הזקן היתה לו השגה בזה,"
        },
        {
          "s": 7,
          "text": "השגה אמיתית באופן שהשכל נתאחד עם המושכל67,"
        },
        {
          "s": 8,
          "text": "אעפ\"כ אינו רוצה לא בהגילויים דג\"ע ולא בהגילויים דעוה\"ב,"
        },
        {
          "s": 9,
          "text": "וכל רצונו הוא רק בהעצמות,"
        },
        {
          "s": 10,
          "text": "דיך אַליין."
        },
        {
          "s": 11,
          "text": "ויש להוסיף,"
        },
        {
          "s": 12,
          "text": "דעיקר הפקחות בזה שאינו רוצה בהדוכסין וכו'"
        },
        {
          "s": 13,
          "text": "(המדריגות שבסדר ההשתלשלות,"
        },
        {
          "s": 14,
          "text": "וגם שלמעלה מהשתלשלות)"
        },
        {
          "s": 15,
          "text": "הוא,"
        },
        {
          "s": 16,
          "text": "דהגם שהספירות"
        },
        {
          "s": 17,
          "text": "(מלשון ספירות ובהירות68)"
        },
        {
          "s": 18,
          "text": "אין מסתירים על אוא\"ס,"
        },
        {
          "s": 19,
          "text": "דבההשפעה שנמשכת ע\"י הספירות"
        },
        {
          "s": 20,
          "text": "(הכלים)"
        },
        {
          "s": 21,
          "text": "נראה בגילוי שההשפעה היא לא מהספירות עצמם ח\"ו אלא שאוא\"ס משפיע על ידם69,"
        },
        {
          "s": 22,
          "text": "וביותר הוא בהאורות דהספירות,"
        },
        {
          "s": 23,
          "text": "שעל ידם מתגלה האור שלמעלה מהם70,"
        },
        {
          "s": 24,
          "text": "ומכ\"ש בהמדריגות שלמעלה מאצילות71,"
        },
        {
          "s": 25,
          "text": "שע\"י האור מתגלה כל מה שאפשר להתגלות מהמאור,"
        },
        {
          "s": 26,
          "text": "מ\"מ,"
        },
        {
          "s": 27,
          "text": "אינו רוצה בהם אלא בהמלך,"
        },
        {
          "s": 28,
          "text": "אנא נסיב מלכא."
        },
        {
          "s": 29,
          "text": "ויש לומר,"
        },
        {
          "s": 30,
          "text": "שזהו גם דיוק לשון אדמו\"ר הזקן \"איך וויל ניט דאיין ג\"ע איך וויל ניט דאיין עוה\"ב\","
        },
        {
          "s": 31,
          "text": "דהגם שהג\"ע והעוה\"ב הם \"דאיין ג\"ע\","
        },
        {
          "s": 32,
          "text": "\"דאיין עוה\"ב\","
        },
        {
          "s": 33,
          "text": "דנוסף לזה שהגילויים דג\"ע ודעוה\"ב עצמם הם גילויים נעלים ביותר מתגלה על ידם כל מה שאפשר להתגלות מהמאור,"
        },
        {
          "s": 34,
          "text": "מ\"מ אינו רוצה בהם,"
        },
        {
          "s": 35,
          "text": "וכל רצונו הוא רק בהעצמות,"
        },
        {
          "s": 36,
          "text": "דיך אַליין."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "דפירוש זה באנא נסיב מלכא שאינו רוצה בהדרגות"
        },
        {
          "s": 3,
          "text": "(דקדושה)"
        },
        {
          "s": 4,
          "text": "שלמעלה אלא בהעצמות,"
        },
        {
          "s": 5,
          "text": "והפירוש דאנא נסיב מלכא כפשוטו"
        },
        {
          "s": 6,
          "text": "(שאינו עובד להכו\"מ),"
        },
        {
          "s": 7,
          "text": "שייכים זה לזה."
        },
        {
          "s": 8,
          "text": "ויובן זה ע\"פ הידוע72"
        },
        {
          "s": 9,
          "text": "שהאהבה דמי לי בשמים שאינו רוצה בהגילויים דג\"ע אלא בעצמות אוא\"ס,"
        },
        {
          "s": 10,
          "text": "אף שבג\"ע ישאר במציאותו ויהי' לו השגה ותענוג באלקות"
        },
        {
          "s": 11,
          "text": "(נהנים מזיו השכינה73)"
        },
        {
          "s": 12,
          "text": "משא\"כ מצד הגילוי דעצמות אוא\"ס יתבטל ממדריגתו,"
        },
        {
          "s": 13,
          "text": "מ\"מ,"
        },
        {
          "s": 14,
          "text": "מכיון שהגילוי דג\"ע הוא רק הארה בלבד"
        },
        {
          "s": 15,
          "text": "(זיו השכינה),"
        },
        {
          "s": 16,
          "text": "שבאין ערוך לגבי עצמות אוא\"ס,"
        },
        {
          "s": 17,
          "text": "הוא בוחר בהעיקר ולא בהטפל."
        },
        {
          "s": 18,
          "text": "ומזה מובן,"
        },
        {
          "s": 19,
          "text": "דכאשר הוא בוחר בהגילויים דג\"ע"
        },
        {
          "s": 20,
          "text": "(שהם כלא חשיב לגבי עצמות אוא\"ס)"
        },
        {
          "s": 21,
          "text": "בשביל הלגרמי' שלו74,"
        },
        {
          "s": 22,
          "text": "בכדי שישאר במציאותו ויהנה מזיו השכינה,"
        },
        {
          "s": 23,
          "text": "אפשר שיבוא מזה"
        },
        {
          "s": 24,
          "text": "(ע\"י ריבוי השתלשלות וכו')"
        },
        {
          "s": 25,
          "text": "דהגם שיודע שההשפעה שע\"י הע' שרים היא נמשכת ממקום המות"
        },
        {
          "s": 26,
          "text": "(כנ\"ל סוף סעיף ה),"
        },
        {
          "s": 27,
          "text": "מ\"מ ירצה בהשפעה זו יותר מבההשפעה שמהקדושה,"
        },
        {
          "s": 28,
          "text": "בכדי שיהי' לו שפע בריבוי."
        },
        {
          "s": 29,
          "text": "ועד\"ז הוא גם בנוגע להטעות של העובדים לכו\"מ שמחשבים אותם למציאות"
        },
        {
          "s": 30,
          "text": "(שההשפעה באה מהכו\"מ עצמם,"
        },
        {
          "s": 31,
          "text": "או שיש להם בחירה עכ\"פ להשפיע)."
        },
        {
          "s": 32,
          "text": "דמזה שרוצה בהגילויים דג\"ע ולא בעצמות אוא\"ס,"
        },
        {
          "s": 33,
          "text": "היינו שהוא נותן חשיבות לענין שמחוץ להעצמות,"
        },
        {
          "s": 34,
          "text": "אפשר שיבוא מזה"
        },
        {
          "s": 35,
          "text": "(ע\"י ריבוי השתלשלות וכו')"
        },
        {
          "s": 36,
          "text": "שיתן חשיבות להכו\"מ,"
        },
        {
          "s": 37,
          "text": "שיש להם בחירה בהשפעתם,"
        },
        {
          "s": 38,
          "text": "ויתירה מזו שההשפעה היא מהם עצמם ח\"ו."
        },
        {
          "s": 39,
          "text": "ויש להוסיף,"
        },
        {
          "s": 40,
          "text": "דגם כשרצונו בג\"ע הוא מפני שהוא ג\"ע של הקב\"ה"
        },
        {
          "s": 41,
          "text": "(\"דאיין ג\"ע\"),"
        },
        {
          "s": 42,
          "text": "גם אז אפשר שיבוא מזה הטעות שיש להם"
        },
        {
          "s": 43,
          "text": "(להכו\"מ)"
        },
        {
          "s": 44,
          "text": "בחירה להשפיע ועד להטעות שההשפעה היא מהם עצמם,"
        },
        {
          "s": 45,
          "text": "מכיון שגם לפי טעות זו הכח שיש להם להשפיע הוא"
        },
        {
          "s": 46,
          "text": "(לא מצד עצמם אלא)"
        },
        {
          "s": 47,
          "text": "מפני שהקב\"ה מינה אותם על זה כנ\"ל ס\"ג"
        },
        {
          "s": 48,
          "text": "(בדוגמת \"דאיין ג\"ע\")."
        },
        {
          "s": 49,
          "text": "ובכדי שלא יהי' שום נתינת מקום לאנא נסיב דוכסין וכו' הוא ע\"י שיעורר אצלו"
        },
        {
          "s": 50,
          "text": "(מעין ושמץ עכ\"פ,"
        },
        {
          "s": 51,
          "text": "שזהו בכחו של כאו\"א מישראל,"
        },
        {
          "s": 52,
          "text": "כדלקמן)"
        },
        {
          "s": 53,
          "text": "שלא לרצות אפילו \"דאיין ג\"ע\","
        },
        {
          "s": 54,
          "text": "כ\"א \"מער ניט אַז דיך אַליין\"."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "ויש להוסיף ביאור בהשייכות דאנא נסיב מלכא להאהבה דמי לי בשמים שרוצה באוא\"ס,"
        },
        {
          "s": 3,
          "text": "בהקדים שעיקר הענין דעבודת כו\"מ הוא שחושבים דבר שהוא רק אמצעי לעיקר."
        },
        {
          "s": 4,
          "text": "הן בנוגע להכו\"מ,"
        },
        {
          "s": 5,
          "text": "דהאמת הוא שאינם אלא אמצעי"
        },
        {
          "s": 6,
          "text": "(גרזן)"
        },
        {
          "s": 7,
          "text": "שעל ידם נמשכת ההשפעה,"
        },
        {
          "s": 8,
          "text": "והעובדים לכו\"מ חושבים שהם עיקר,"
        },
        {
          "s": 9,
          "text": "והן בנוגע להשפעות הגשמיות הנשפעות על ידם,"
        },
        {
          "s": 10,
          "text": "שהשפעת הגשמיות היא בכדי שישתמשו בהם לעבודת ה',"
        },
        {
          "s": 11,
          "text": "והעובדים לכו\"מ מחשבים את הגשמיות לעיקר"
        },
        {
          "s": 12,
          "text": "(שלכן הם רוצים בההשפעה מהלעו\"ז,"
        },
        {
          "s": 13,
          "text": "בכדי שיהי' להם ריבוי שפע גשמי,"
        },
        {
          "s": 14,
          "text": "כנ\"ל סעיף ד)."
        },
        {
          "s": 15,
          "text": "והנה הגילויים,"
        },
        {
          "s": 16,
          "text": "גם הגילויים הכי נעלים,"
        },
        {
          "s": 17,
          "text": "התכלית הוא לא בהם עצמם,"
        },
        {
          "s": 18,
          "text": "והם רק אמצעי שעל ידם תושלם הכוונה הפנימית דדירה בתחתונים."
        },
        {
          "s": 19,
          "text": "ולכן,"
        },
        {
          "s": 20,
          "text": "כשרוצה בהגילויים"
        },
        {
          "s": 21,
          "text": "(ולא באוא\"ס),"
        },
        {
          "s": 22,
          "text": "היינו שמחשיב אותם לעיקר,"
        },
        {
          "s": 23,
          "text": "אפשר להיות נתינת מקום שיחשיב גם האמצעים"
        },
        {
          "s": 24,
          "text": "(הכו\"מ והשפע הגשמי)"
        },
        {
          "s": 25,
          "text": "לעיקר."
        },
        {
          "s": 26,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 27,
          "text": "דזה שאוה\"ע מהן עובדין לחמה ומהן ללבנה וישראל אינן עובדין אלא להקב\"ה,"
        },
        {
          "s": 28,
          "text": "הוא,"
        },
        {
          "s": 29,
          "text": "כי השרש דאוה\"ע הוא מחיצוניות הרצון"
        },
        {
          "s": 30,
          "text": "(שרוצה באיזה דבר בשביל ענין אחר),"
        },
        {
          "s": 31,
          "text": "והבחינה דחיצוניות הרצון"
        },
        {
          "s": 32,
          "text": "(כמו שהיא מקור לאוה\"ע)"
        },
        {
          "s": 33,
          "text": "היא באופן שאין נרגש בה שהרצון הוא בשביל ענין אחר אלא שזה גופא הוא התכלית,"
        },
        {
          "s": 34,
          "text": "ולכן מסתעף מזה שאוה\"ע מחשבים את הממוצעים דכו\"מ לעיקר75."
        },
        {
          "s": 35,
          "text": "והשרש דישראל הוא מפנימיות הרצון,"
        },
        {
          "s": 36,
          "text": "שמצד פנימיות הרצון אין נתינת מקום לאיזה ענין אחר,"
        },
        {
          "s": 37,
          "text": "ולכן יש לישראל ההכרה שהכו\"מ הם רק אמצעי כגרזן ביד החוצב"
        },
        {
          "s": 38,
          "text": "(וכן השפע הגשמי הוא רק בשביל עבודת ה'),"
        },
        {
          "s": 39,
          "text": "ולכן אינן עובדין אלא להקב\"ה,"
        },
        {
          "s": 40,
          "text": "אנא נסיב מלכא."
        }
      ]
    }
  ]
}