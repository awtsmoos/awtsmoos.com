{
  "globalIndex": 536,
  "owner": 36,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916846_theRebbe_939__p007",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916846_theRebbe_939__p007",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916846_theRebbe_939",
  "title": "מאמר באתי לגני תשל\"א",
  "part": 7,
  "sections": [
    {
      "v": 18,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ועד\"ז הוא בעבודת האדם,"
        },
        {
          "s": 2,
          "text": "דזה שהאדם יכול לעשות היפך רצון העליון"
        },
        {
          "s": 3,
          "text": "[שזה נעשה ע\"י הצמצום,"
        },
        {
          "s": 4,
          "text": "כנ\"ל]"
        },
        {
          "s": 5,
          "text": "הוא מפני שהעצמות אינו מוכרח בשום דבר."
        },
        {
          "s": 6,
          "text": "אלא שבענין זה"
        },
        {
          "s": 7,
          "text": "[הכח שניתן לאדם לעשות היפך הרצון],"
        },
        {
          "s": 8,
          "text": "הענין דיכולת העצמות הוא בתכלית ההעלם והסתר."
        },
        {
          "s": 9,
          "text": "וע\"י שהאדם עובד את ה' והעבודה היא בכח עצמו ובבחירתו62"
        },
        {
          "s": 10,
          "text": "[דהגם שאוא\"ס הוא בכל מקום ואין דבר חוץ ממנו מ\"מ כיון שהוא ית' הוא כל יכול ברא את האדם באופן שיוכל לעבוד בכח עצמו],"
        },
        {
          "s": 11,
          "text": "עי\"ז מתגלה שכח הבחירה דהאדם"
        },
        {
          "s": 12,
          "text": "(גם זה שיכול לבחור ח\"ו בהיפך הרצון)"
        },
        {
          "s": 13,
          "text": "הוא מצד יכולת העצמות."
        }
      ]
    },
    {
      "v": 19,
      "items": [
        {
          "s": 0,
          "text": "ויש לקשר זה עם תורת הבעש\"ט63"
        },
        {
          "s": 1,
          "text": "עה\"פ64"
        },
        {
          "s": 2,
          "text": "ויהי ערב ויהי בוקר גו',"
        },
        {
          "s": 3,
          "text": "דאיתא במדרש65"
        },
        {
          "s": 4,
          "text": "ויהי ערב אלו מעשיהן של רשעים ויהי בוקר אלו מעשיהן של צדיקים,"
        },
        {
          "s": 5,
          "text": "ואיני יודע באיזה מהן חפץ,"
        },
        {
          "s": 6,
          "text": "כיון דכתיב66"
        },
        {
          "s": 7,
          "text": "וירא אלקים את האור כי טוב,"
        },
        {
          "s": 8,
          "text": "הוי במעשיהן של צדיקים הוא חפץ."
        },
        {
          "s": 9,
          "text": "ותמוה,"
        },
        {
          "s": 10,
          "text": "איך שייך קס\"ד שהוא חפץ במעשה רשעים."
        },
        {
          "s": 11,
          "text": "ומבאר הבעש\"ט,"
        },
        {
          "s": 12,
          "text": "דיש תועלת ויתרון לאור מן החושך67,"
        },
        {
          "s": 13,
          "text": "היינו שמעלת יתרון האור ניכרת68"
        },
        {
          "s": 14,
          "text": "מצד החשך,"
        },
        {
          "s": 15,
          "text": "וכן מעלת החכם ניכרת68"
        },
        {
          "s": 16,
          "text": "מצד הטיפש67,"
        },
        {
          "s": 17,
          "text": "מעלת הצדיק מצד הרשע וכו'."
        },
        {
          "s": 18,
          "text": "וזהו ואיני יודע באיזה מהן חפץ,"
        },
        {
          "s": 19,
          "text": "דכיון שגם מעשה הרשעים הוא כסא למעשה צדיקים,"
        },
        {
          "s": 20,
          "text": "יש מקום לומר שהכל נכנס באחדות אחד ח\"ו,"
        },
        {
          "s": 21,
          "text": "לכך נאמר וירא אלקים את האור כי טוב אלו מעשיהן של צדיקים,"
        },
        {
          "s": 22,
          "text": "כי במעשה הרשעים צריך הבדלה"
        },
        {
          "s": 23,
          "text": "[ועפ\"ז מבאר שם הכתוב69"
        },
        {
          "s": 24,
          "text": "חשבתי דרכי ואשיבה רגלי אל עדותיך,"
        },
        {
          "s": 25,
          "text": "כדלקמן סעיף יג]."
        }
      ]
    },
    {
      "v": 20,
      "items": [
        {
          "s": 0,
          "text": "וצריך להבין,"
        },
        {
          "s": 1,
          "text": "דזה שיתרון האור ניכר מהחושך הוא"
        },
        {
          "s": 2,
          "text": "(לכאורה)"
        },
        {
          "s": 3,
          "text": "שע\"י הפחיתות דהחושך ניכר יתרון האור,"
        },
        {
          "s": 4,
          "text": "ואיך שייך לומר שמפני זה גם מעשה הרשעים"
        },
        {
          "s": 5,
          "text": "(חושך)"
        },
        {
          "s": 6,
          "text": "נכנס באחדות אחד70."
        },
        {
          "s": 7,
          "text": "ויש לומר,"
        },
        {
          "s": 8,
          "text": "דהכוונה בזה שיתרון האור ניכר ע\"י החושך היא שע\"י האפשרות לבחור במעשה הרשעים ניכר שמעשה הצדיקים הוא בבחירתם החפשית,"
        },
        {
          "s": 9,
          "text": "עבודה בכח עצמם."
        },
        {
          "s": 10,
          "text": "וכיון שע\"י העבודה בכח עצמו מתגלה שגם האפשרות לבחור במעשה הרשעים הוא מצד יכולת העצמות,"
        },
        {
          "s": 11,
          "text": "לכן מקום לומר שהוא חפץ במעשה הרשעים,"
        },
        {
          "s": 12,
          "text": "היינו שהתענוג דלמעלה"
        },
        {
          "s": 13,
          "text": "[וכן גילוי אחדותו ית' – נכנס באחדות אחד]"
        },
        {
          "s": 14,
          "text": "הוא גם בהאפשרות לבחור במעשה הרשעים."
        },
        {
          "s": 15,
          "text": "ולכך נאמר וירא אלקים את האור כי טוב,"
        },
        {
          "s": 16,
          "text": "שהוא חפץ במעשיהן של צדיקים דוקא."
        }
      ]
    }
  ]
}