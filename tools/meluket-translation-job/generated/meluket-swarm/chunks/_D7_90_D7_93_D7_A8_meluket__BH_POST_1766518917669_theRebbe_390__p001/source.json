{
  "globalIndex": 663,
  "owner": 13,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917669_theRebbe_390__p001",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917669_theRebbe_390__p001",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917669_theRebbe_390",
  "title": "מאמר החודש הזה לכם תשמ\"ז",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ ויקהל-פקודי,"
        },
        {
          "s": 2,
          "text": "פ' החודש,"
        },
        {
          "s": 3,
          "text": "ה'תשמ\"ז*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "החודש הזה לכם ראש חדשים ראשון הוא לכם לחדשי השנה1,"
        },
        {
          "s": 1,
          "text": "ומדייק אדמו\"ר"
        },
        {
          "s": 2,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 3,
          "text": "נ\"ע"
        },
        {
          "s": 4,
          "text": "(בעל ההילולא דב' ניסן2)"
        },
        {
          "s": 5,
          "text": "במאמרו ד\"ה זה דשנת אעת\"ר3"
        },
        {
          "s": 6,
          "text": "מ\"ש ראש חדשים,"
        },
        {
          "s": 7,
          "text": "הרי אומר"
        },
        {
          "s": 8,
          "text": "(אח\"כ)"
        },
        {
          "s": 9,
          "text": "ראשון גו' לחדשי השנה,"
        },
        {
          "s": 10,
          "text": "ומה צ\"ל ראש חדשים4."
        },
        {
          "s": 11,
          "text": "ומביא בהמאמר דרשת רז\"ל עה\"פ,"
        },
        {
          "s": 12,
          "text": "החודש הזה לכם ראש חדשים זה ניסן ואין אחר ניסן5,"
        },
        {
          "s": 13,
          "text": "שכשהגיע יום שראוי להיות ר\"ח ניסן אין מעברין את השנה."
        },
        {
          "s": 14,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 15,
          "text": "דמפסוק זה למידים גם שאין מעברין את החודש,"
        },
        {
          "s": 16,
          "text": "דמעברין את השנה לצורך ואין מעברין את החודש לצורך6."
        },
        {
          "s": 17,
          "text": "וכשהגיע יום שראוי להיות ר\"ח ניסן,"
        },
        {
          "s": 18,
          "text": "אין מעברין"
        },
        {
          "s": 19,
          "text": "(גם)"
        },
        {
          "s": 20,
          "text": "את השנה."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ולהבין זה מקדים בהמאמר,"
        },
        {
          "s": 1,
          "text": "דצריך להבין מפני מה נאמרה פרשת החודש דוקא מיד אחרי יציאת מצרים7."
        },
        {
          "s": 2,
          "text": "ומבאר,"
        },
        {
          "s": 3,
          "text": "דפרשת החודש היא עיקר התחלת התורה כמ\"ש רש\"י8"
        },
        {
          "s": 4,
          "text": "דלא הי' צריך להתחיל את התורה אלא מהחודש הזה לכם"
        },
        {
          "s": 5,
          "text": "(ומה שפתח בבראשית הוא משום כח9"
        },
        {
          "s": 6,
          "text": "מעשיו הגיד לעמו גו')."
        },
        {
          "s": 7,
          "text": "היינו,"
        },
        {
          "s": 8,
          "text": "דבהפרשיות שלפני פרשת החודש מדובר בהגילויים שבעולמות,"
        },
        {
          "s": 9,
          "text": "ומפרשת החודש ואילך מתחיל בענין הגילויים דתורה"
        },
        {
          "s": 10,
          "text": "(שלמעלה מהגילויים שבעולמות)."
        },
        {
          "s": 11,
          "text": "ובכדי שיוכל להיות הגילוי דתורה הוצרך להיות תחילה ההכנה דגלות מצרים ויציאת מצרים."
        },
        {
          "s": 12,
          "text": "וזהו מה שמיד לאחרי יצי\"מ,"
        },
        {
          "s": 13,
          "text": "ההכנה למ\"ת,"
        },
        {
          "s": 14,
          "text": "נאמרה פרשת החודש,"
        },
        {
          "s": 15,
          "text": "התחלת הגילויים דתורה."
        }
      ]
    }
  ]
}