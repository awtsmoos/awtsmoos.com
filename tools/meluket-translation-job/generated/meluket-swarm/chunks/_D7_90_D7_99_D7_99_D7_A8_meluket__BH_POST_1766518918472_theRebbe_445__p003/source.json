{
  "globalIndex": 787,
  "owner": 37,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918472_theRebbe_445__p003",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918472_theRebbe_445__p003",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918472_theRebbe_445",
  "title": "מאמר לה\"ע פסח שני תשל\"ח",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ומכל זה מובן,"
        },
        {
          "s": 2,
          "text": "דבחודש אייר,"
        },
        {
          "s": 3,
          "text": "חודש השני,"
        },
        {
          "s": 4,
          "text": "שני ענינים."
        },
        {
          "s": 5,
          "text": "העבודה דאתהפכא,"
        },
        {
          "s": 6,
          "text": "תכלית השלימות דסור מרע30,"
        },
        {
          "s": 7,
          "text": "והעבודה דילכו מחיל אל חיל31"
        },
        {
          "s": 8,
          "text": "בקדושה עצמה,"
        },
        {
          "s": 9,
          "text": "ועשה טוב32."
        },
        {
          "s": 10,
          "text": "ויש לומר,"
        },
        {
          "s": 11,
          "text": "דזהו שהמנין דבנ\"י בחודש השני בשנה השנית לצאתם מארץ מצרים הי' ע\"י משה ואהרן33,"
        },
        {
          "s": 12,
          "text": "כי הענין דסור מרע"
        },
        {
          "s": 13,
          "text": "(שבחודש השני)"
        },
        {
          "s": 14,
          "text": "שייך לאהרן שענינו הוא אוהב שלום ורודף שלום כו'34,"
        },
        {
          "s": 15,
          "text": "דענין השלום הוא לשלול המחלוקת והפירוד,"
        },
        {
          "s": 16,
          "text": "והענין דועשה טוב"
        },
        {
          "s": 17,
          "text": "(שבחודש אייר)"
        },
        {
          "s": 18,
          "text": "שייך למשה שענינו הוא תורה35,"
        },
        {
          "s": 19,
          "text": "שמלכתחילה אין שייך בה נתינת מקום לענין הפכי ח\"ו36,"
        },
        {
          "s": 20,
          "text": "דזהו גם מ\"ש37"
        },
        {
          "s": 21,
          "text": "ותרא אותו כי טוב הוא שמיד כשנולד נתמלא הבית כולו אורה38."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דזה שיציאת מצרים היתה ע\"י אהרן ומשה39,"
        },
        {
          "s": 2,
          "text": "אף שהעבודה דיציאת מצרים היא סור מרע,"
        },
        {
          "s": 3,
          "text": "ובסור מרע גופא באופן דאתכפיא,"
        },
        {
          "s": 4,
          "text": "הוא,"
        },
        {
          "s": 5,
          "text": "כי גם העבודה דאתכפיא צריכה להיות באופן שתביא לא רק לאתהפכא,"
        },
        {
          "s": 6,
          "text": "אלא גם להעבודה בהקו דועשה טוב שלמעלה מענין הבירורים."
        },
        {
          "s": 7,
          "text": "וי\"ל שהוא ע\"ד המבואר בתניא40"
        },
        {
          "s": 8,
          "text": "שגם אלו שעיקר עבודתם הוא אל תהי רשע41,"
        },
        {
          "s": 9,
          "text": "צריכים להשתדל לקיים את השבועה41"
        },
        {
          "s": 10,
          "text": "תהי צדיק,"
        },
        {
          "s": 11,
          "text": "הן בנוגע להיות מואס ברע"
        },
        {
          "s": 12,
          "text": "(הענין דאתהפכא)"
        },
        {
          "s": 13,
          "text": "והן בנוגע להתענג ולשמוח בה' ע\"י התבוננות בגדולת א\"ס ב\"ה"
        },
        {
          "s": 14,
          "text": "(העבודה דקדושה שלמעלה מענין הבירורים)."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה עד\"ז הוא לאידך גיסא,"
        },
        {
          "s": 2,
          "text": "שגם כשנמצאים בהעבודה דחודש אייר"
        },
        {
          "s": 3,
          "text": "(העבודה דאתהפכא,"
        },
        {
          "s": 4,
          "text": "ולמעלה יותר העבודה דמרכבה)"
        },
        {
          "s": 5,
          "text": "צריך להיות רושם מהחיות וההתפעלות של העבודה דאתכפיא,"
        },
        {
          "s": 6,
          "text": "שלכן מזכירין42"
        },
        {
          "s": 7,
          "text": "יציאת מצרים גם לימות המשיח43."
        },
        {
          "s": 8,
          "text": "והענין הוא,"
        },
        {
          "s": 9,
          "text": "דכשהרע הוא בתקפו,"
        },
        {
          "s": 10,
          "text": "הנה היראה מהרע גורמת הבריחה ממנו באופן דחפזון44."
        },
        {
          "s": 11,
          "text": "וע\"י החפזון דישראל נעשה גם חפזון השכינה45"
        },
        {
          "s": 12,
          "text": "כביכול,"
        },
        {
          "s": 13,
          "text": "מדלג על ההרים מקפץ על הגבעות46."
        },
        {
          "s": 14,
          "text": "דחפזון מביא לדילוג שלמעלה מסדר והדרגה."
        },
        {
          "s": 15,
          "text": "משא\"כ העבודה דאתהפכא לאחרי שיצא כבר מהרע,"
        },
        {
          "s": 16,
          "text": "ומכ\"ש העבודה דועשה טוב,"
        },
        {
          "s": 17,
          "text": "היא בסדר והדרגה."
        },
        {
          "s": 18,
          "text": "ולכן צריך להמשיך בה ענין הדילוג דיציאת מצרים."
        },
        {
          "s": 19,
          "text": "וזהו\"ע פסח שני,"
        },
        {
          "s": 20,
          "text": "המשכת הדילוג בהעבודה דועשה טוב,"
        },
        {
          "s": 21,
          "text": "העבודה דחודש השני."
        },
        {
          "s": 22,
          "text": "שלאחרי הדילוג שהי' בהעבודה דסור מרע"
        },
        {
          "s": 23,
          "text": "(פסח ראשון),"
        },
        {
          "s": 24,
          "text": "נמשך הדילוג גם בהעבודה דועשה טוב"
        },
        {
          "s": 25,
          "text": "(פסח שני)."
        },
        {
          "s": 26,
          "text": "וע\"ד מ\"ש47"
        },
        {
          "s": 27,
          "text": "משכני אחריך נרוצה,"
        },
        {
          "s": 28,
          "text": "דע\"י שנפש האלקית פועלת שנפש הבהמית יהי' לה אהבת ה',"
        },
        {
          "s": 29,
          "text": "שהאהבה דנפש הבהמית היא בדרך מרוצה,"
        },
        {
          "s": 30,
          "text": "עי\"ז נעשה מרוצה גם בנפש האלקית48,"
        },
        {
          "s": 31,
          "text": "נרוצה לשון רבים49."
        },
        {
          "s": 32,
          "text": "אבל,"
        },
        {
          "s": 33,
          "text": "לאחרי שנמשך הדילוג בהעבודה דועשה טוב,"
        },
        {
          "s": 34,
          "text": "דילוג זה הוא נעלה יותר מהדילוג דפסח."
        },
        {
          "s": 35,
          "text": "כי הוא מחמת היראה מהרע"
        },
        {
          "s": 36,
          "text": "(ענין בפ\"ע),"
        },
        {
          "s": 37,
          "text": "משא\"כ הדילוג שבתומ\"צ"
        },
        {
          "s": 38,
          "text": "(העבודה דועשה טוב)"
        },
        {
          "s": 39,
          "text": "הוא מפני שהם חכמתו ורצונו של הקב\"ה,"
        },
        {
          "s": 40,
          "text": "בלי גבול האמיתי."
        },
        {
          "s": 41,
          "text": "ולכן,"
        },
        {
          "s": 42,
          "text": "לאחרי שמתגלה הבל\"ג שבהם ע\"י הדילוג דסור מרע,"
        },
        {
          "s": 43,
          "text": "הדילוג"
        },
        {
          "s": 44,
          "text": "(ענין הבל\"ג שלמעלה מהדרגה)"
        },
        {
          "s": 45,
          "text": "דהעבודה דועשה טוב הוא דילוג גדול יותר50."
        }
      ]
    }
  ]
}