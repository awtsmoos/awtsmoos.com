{
  "globalIndex": 94,
  "owner": 44,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914213_theRebbe_9__p007",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914213_theRebbe_9__p007",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914213_theRebbe_9",
  "title": "מאמר בסוכות תשבו תשל\"ח",
  "part": 7,
  "sections": [
    {
      "v": 18,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ז)"
        },
        {
          "s": 2,
          "text": "וזהו מ\"ש בסוכות תשבו שבעת ימים כל האזרח בישראל ישבו בסוכות,"
        },
        {
          "s": 3,
          "text": "שלאחרי העבודה דתקעו בחודש שופר בראש השנה,"
        },
        {
          "s": 4,
          "text": "שאז ההמשכה היא עדיין באופן דבכסה,"
        },
        {
          "s": 5,
          "text": "הנה אח\"ז באים העשרה ימים שבין ראש השנה ליום הכפורים שעליהם נאמר90"
        },
        {
          "s": 6,
          "text": "דרשו הוי' בהמצאו קראוהו בהיותו קרוב,"
        },
        {
          "s": 7,
          "text": "ואמירתו של הקב\"ה חשיב מעשה91,"
        },
        {
          "s": 8,
          "text": "ונעשה מעשה בפועל,"
        },
        {
          "s": 9,
          "text": "שנעשה דרשו וקראוהו בפועל."
        },
        {
          "s": 10,
          "text": "וזה פועל אח\"ז הד' ימים שבין יום הכפורים לסוכות,"
        },
        {
          "s": 11,
          "text": "שאז תורת אמת מעידה שכל ישראל וכל א' מישראל עסוקים במצוות92,"
        },
        {
          "s": 12,
          "text": "ולאחרי ההכנה"
        },
        {
          "s": 13,
          "text": "(בד' ימים אלו)"
        },
        {
          "s": 14,
          "text": "דחג הסוכות תעשה לך וגו'93"
        },
        {
          "s": 15,
          "text": "(עם כל הפירושים שבזה)"
        },
        {
          "s": 16,
          "text": "[שגם עשיית הסוכה הוא בכלל המצוה,"
        },
        {
          "s": 17,
          "text": "כמ\"ש אדמו\"ר הזקן בשו\"ע שלו94"
        },
        {
          "s": 18,
          "text": "לפסק הלכה בטעם הפס\"ד שאין מברכין על עשייתה מפני שאינה גמר המצוה,"
        },
        {
          "s": 19,
          "text": "וברכת שהחיינו קאי גם על העשי']"
        },
        {
          "s": 20,
          "text": "הנה באים אח\"כ בחג הסוכות לקיום המצוה עצמה,"
        },
        {
          "s": 21,
          "text": "בסוכות תשבו שבעת ימים."
        },
        {
          "s": 22,
          "text": "ומיד למחרת בבקר"
        },
        {
          "s": 23,
          "text": "(בעלות השחר ובנץ החמה)"
        },
        {
          "s": 24,
          "text": "באה מצות ד\"מ,"
        },
        {
          "s": 25,
          "text": "ולקחתם לכם ביום הראשון פרי עץ הדר כפות תמרים וענף עץ אבות וערבי נחל ושמחתם לפני הוי' אלקיכם."
        },
        {
          "s": 26,
          "text": "עד שבאים לשמחת בית השואבה,"
        },
        {
          "s": 27,
          "text": "שנעשה גודל השמחה דושמחתם באופן דמי שלא ראה שמחת בית השואבה לא ראה שמחה מימיו."
        },
        {
          "s": 28,
          "text": "ואז זוכים שבקרוב ממש יהי' כל האזרח בישראל ישבו בסוכות בפועל"
        },
        {
          "s": 29,
          "text": "(ולא רק ראוים לישב),"
        },
        {
          "s": 30,
          "text": "כי באה הגאולה האמיתית והשלימה ע\"י משיח צדקנו."
        },
        {
          "s": 31,
          "text": "ואז יהי' קיום המצוה דושמחתם לפני ה\"א בשלימות ומה\"ת,"
        },
        {
          "s": 32,
          "text": "שיהי' קיומה בביהמ\"ק,"
        },
        {
          "s": 33,
          "text": "ביהמ\"ק השלישי,"
        },
        {
          "s": 34,
          "text": "מקדש אדנ\"י כוננו ידיך95,"
        },
        {
          "s": 35,
          "text": "בקרוב ממש."
        },
        {
          "s": 36,
          "text": "יבא ויגאלנו ויוליכנו קוממיות לארצנו,"
        },
        {
          "s": 37,
          "text": "ויבנה ביהמ\"ק במקומו,"
        },
        {
          "s": 38,
          "text": "ויקבץ נדחי ישראל והיתה לה' המלוכה96."
        },
        {
          "s": 39,
          "text": "ובהקדמה לזה יהי' כמ\"ש97"
        },
        {
          "s": 40,
          "text": "אז אהפוך אל עמים שפה ברורה גו' ולעבדו שכם אחד98,"
        },
        {
          "s": 41,
          "text": "שזה נמשך בגלוי ע\"י הקרבת השבעים פרים בחג הסוכות."
        },
        {
          "s": 42,
          "text": "כן תהי' לנו,"
        },
        {
          "s": 43,
          "text": "ובקרוב ממש."
        }
      ]
    }
  ]
}