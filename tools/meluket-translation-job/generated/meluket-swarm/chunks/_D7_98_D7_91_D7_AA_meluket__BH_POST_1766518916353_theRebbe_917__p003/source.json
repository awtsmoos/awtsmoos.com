{
  "globalIndex": 455,
  "owner": 5,
  "jobId": "_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916353_theRebbe_917__p003",
  "batchId": "meluket-_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916353_theRebbe_917__p003",
  "seriesId": "טבת_meluket",
  "postId": "BH_POST_1766518916353_theRebbe_917",
  "title": "מאמר ואלה שמות תשל\"ז",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה כל הגילויים דלעתיד תלויים במעשינו ועבודתינו במשך השית אלפי שנין דהוה עלמא32,"
        },
        {
          "s": 2,
          "text": "וזהו הענין דוימררו את חייהם כמו שהוא ברוחניות,"
        },
        {
          "s": 3,
          "text": "דבעבודה קשה דא קושיא,"
        },
        {
          "s": 4,
          "text": "בחומר דא ק\"ו,"
        },
        {
          "s": 5,
          "text": "ובלבנים דא ליבון הלכתא33,"
        },
        {
          "s": 6,
          "text": "וואָס ער מאַטערט זיך אין לימוד התורה להוציא הלכה ברורה ע\"י ריבוי שקו\"ט,"
        },
        {
          "s": 7,
          "text": "ובמצב דבמחשכים הושיבני34"
        },
        {
          "s": 8,
          "text": "זה תלמוד בבלי35,"
        },
        {
          "s": 9,
          "text": "עד שמלבן"
        },
        {
          "s": 10,
          "text": "(ער וואַשט אויס)"
        },
        {
          "s": 11,
          "text": "את הקושיות ורמינהו וכו' עד שההלכה מאירה ומזהירה."
        },
        {
          "s": 12,
          "text": "דזהו עיקר ענין התורה,"
        },
        {
          "s": 13,
          "text": "הלכה פסוקה וברורה,"
        },
        {
          "s": 14,
          "text": "דזהו מעלת המשניות שהם הלכה פסוקה וכו'36,"
        },
        {
          "s": 15,
          "text": "ולכן ארז\"ל37"
        },
        {
          "s": 16,
          "text": "אין הגלויות מתכנסות אלא בזכות משניות שנאמר38"
        },
        {
          "s": 17,
          "text": "גם כי יתנו בגוים עתה אקבצם39."
        },
        {
          "s": 18,
          "text": "ועד\"ז ענין הליבון גם בעבודת התפלה,"
        },
        {
          "s": 19,
          "text": "וכמבואר בתורת חיים40."
        },
        {
          "s": 20,
          "text": "וע\"י הענין דוימררו וגו' בתורה ותפלה כנ\"ל,"
        },
        {
          "s": 21,
          "text": "הנה מחליפים"
        },
        {
          "s": 22,
          "text": "(מ'פאַרבייט)"
        },
        {
          "s": 23,
          "text": "יסורי גלות זה האחרון."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "וזהו מ\"ש ואלה שמות בני ישראל וגו',"
        },
        {
          "s": 2,
          "text": "שע\"י הענין דשמות בנ\"י פועלים הגאולה שלאח\"ז."
        },
        {
          "s": 3,
          "text": "דענין שמות בנ\"י הוא,"
        },
        {
          "s": 4,
          "text": "כדאיתא במדרש41"
        },
        {
          "s": 5,
          "text": "דראובן שמעון נחתין ראובן שמעון סלקין,"
        },
        {
          "s": 6,
          "text": "שלא שינו את שמם,"
        },
        {
          "s": 7,
          "text": "והיינו דלא רק שעמדו בתוקף על עיקרי התומ\"צ,"
        },
        {
          "s": 8,
          "text": "ואפילו לא על תומ\"צ סתם,"
        },
        {
          "s": 9,
          "text": "כ\"א גם על עניני זהירות וכו' עד שאפילו לא שינו את שמם."
        },
        {
          "s": 10,
          "text": "ועאכו\"כ שהי' אצלם עניני התומ\"צ עצמם כדבעי."
        },
        {
          "s": 11,
          "text": "ועד\"ז עכשיו בגלות זה שעומדים בתוקף אפילו על ענינים פשוטים כמו שלא לשנות השם וכו',"
        },
        {
          "s": 12,
          "text": "ועאכו\"כ כו'."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "וכן הוא בתורה,"
        },
        {
          "s": 1,
          "text": "שענינה הוא ג\"כ הענין דשמות,"
        },
        {
          "s": 2,
          "text": "דכל התורה היא שמותיו של הקב\"ה42,"
        },
        {
          "s": 3,
          "text": "הנה פועלים המשכה דבחינת ואלה שמות,"
        },
        {
          "s": 4,
          "text": "וכנ\"ל דכל התורה היא שמותיו של הקב\"ה."
        },
        {
          "s": 5,
          "text": "ויש ס\"ר אותיות לתורה43,"
        },
        {
          "s": 6,
          "text": "שמות דהקב\"ה,"
        },
        {
          "s": 7,
          "text": "ומבין צירופים אלו – הקדוש יותר השבע שמות שאינם נמחקים44,"
        },
        {
          "s": 8,
          "text": "ומהם גופא – בחינת שמו הגדול45,"
        },
        {
          "s": 9,
          "text": "שזהו בחינת הגילוי דלעתיד שפועלים ע\"י העבודה דעכשיו"
        },
        {
          "s": 10,
          "text": "(כנ\"ל)."
        },
        {
          "s": 11,
          "text": "וההמשכה דבחינת שמו הגדול היתה כבר בימי חנוכה שאז הי' כמ\"ש"
        },
        {
          "s": 12,
          "text": "(בועל הנסים)"
        },
        {
          "s": 13,
          "text": "להודות ולהלל לשמך הגדול,"
        },
        {
          "s": 14,
          "text": "ובאופן נצחי,"
        },
        {
          "s": 15,
          "text": "דהנרות הללו אינן בטלין לעולם46,"
        },
        {
          "s": 16,
          "text": "אבל המשכה זו היא בהעלם,"
        },
        {
          "s": 17,
          "text": "וגילוי בחינת שמו הגדול יהי' לעתיד."
        }
      ]
    }
  ]
}