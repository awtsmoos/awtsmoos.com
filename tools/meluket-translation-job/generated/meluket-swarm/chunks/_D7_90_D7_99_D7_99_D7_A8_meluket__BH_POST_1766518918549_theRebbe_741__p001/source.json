{
  "globalIndex": 795,
  "owner": 45,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918549_theRebbe_741__p001",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918549_theRebbe_741__p001",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918549_theRebbe_741",
  "title": "מאמר לה\"ע רשב\"י תשמ\"ה",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ל\"ג בעומר ה'תשמ\"ה*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "להבין ענין רשב\"י,"
        },
        {
          "s": 1,
          "text": "הנה ידוע המאמר דל\"ג בעומר של אדמו\"ר מהר\"ש1"
        },
        {
          "s": 2,
          "text": "(בעל ההוראה דלכתחילה אַריבער2),"
        },
        {
          "s": 3,
          "text": "דזה שמצינו בזהר3"
        },
        {
          "s": 4,
          "text": "ששיבחו את רשב\"י בשבחים נוראים4,"
        },
        {
          "s": 5,
          "text": "כמו ר' יהודה הוה קרי לי' שבת5,"
        },
        {
          "s": 6,
          "text": "ומאן פני6"
        },
        {
          "s": 7,
          "text": "האדון ה' דא רשב\"י7,"
        },
        {
          "s": 8,
          "text": "יובן זה מענין השבחים שמשבחים את הבורא ית',"
        },
        {
          "s": 9,
          "text": "דלכאורה תמוה,"
        },
        {
          "s": 10,
          "text": "וכי הוא ית' צריך לשבחים שלנו8,"
        },
        {
          "s": 11,
          "text": "וידוע הביאור בזה9,"
        },
        {
          "s": 12,
          "text": "דלהיות שכל העולמות הם באין ערוך אליו ית',"
        },
        {
          "s": 13,
          "text": "וההשפעה לעולמות היא ירידה לגבי' ית',"
        },
        {
          "s": 14,
          "text": "לכן בכדי לעורר אצלו ית' הרצון להשפיע בעולמות הוא ע\"י השבחים."
        },
        {
          "s": 15,
          "text": "וזהו מה שארז\"ל10"
        },
        {
          "s": 16,
          "text": "לעולם יסדר אדם שבחו של מקום ואח\"כ יתפלל,"
        },
        {
          "s": 17,
          "text": "דהגם שתפלה היא מצות עשה מן התורה לבקש צרכיו מהקב\"ה11,"
        },
        {
          "s": 18,
          "text": "וציווי התורה הוא נתינת כח,"
        },
        {
          "s": 19,
          "text": "מ\"מ,"
        },
        {
          "s": 20,
          "text": "צריך להיות תחילה סידור שבחו של מקום,"
        },
        {
          "s": 21,
          "text": "שעי\"ז מעוררים אצלו ית' הרצון להשפיע צרכי המשבח."
        },
        {
          "s": 22,
          "text": "ועד\"ז הוא גם בנוגע לרשב\"י,"
        },
        {
          "s": 23,
          "text": "שמצד עוצם מעלתו של רשב\"י לגבי שאר התנאים,"
        },
        {
          "s": 24,
          "text": "שהי' מובדל מהם באופן דאין ערוך,"
        },
        {
          "s": 25,
          "text": "לכן,"
        },
        {
          "s": 26,
          "text": "בכדי לעורר השפע שלו,"
        },
        {
          "s": 27,
          "text": "הוצרכו לשבחו."
        },
        {
          "s": 28,
          "text": "ויש לומר,"
        },
        {
          "s": 29,
          "text": "דמ\"ש בהמאמר דענין שבחי רשב\"י יובן מענין שבחו של מקום,"
        },
        {
          "s": 30,
          "text": "הוא בנוסף על הבאת ראי' שבכדי לעורר השפעה שבאין ערוך צריך לשבחים,"
        },
        {
          "s": 31,
          "text": "אלא גם,"
        },
        {
          "s": 32,
          "text": "שהאין ערוך דשאר התנאים לגבי רשב\"י הוא בדוגמת האין ערוך דנברא לבורא."
        },
        {
          "s": 33,
          "text": "וזהו גם מ\"ש בהמאמר שהיו משבחים אותו בשבחים נוראים,"
        },
        {
          "s": 34,
          "text": "דלשון נורא מורה על ענין שמובדל בערך לגמרי,"
        },
        {
          "s": 35,
          "text": "עד שמטיל אימה."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והענין הוא,"
        },
        {
          "s": 2,
          "text": "דהנה כתיב12"
        },
        {
          "s": 3,
          "text": "והאיתנים מוסדי ארץ,"
        },
        {
          "s": 4,
          "text": "איתנים אותיות תנאים13,"
        },
        {
          "s": 5,
          "text": "והם המייסדים14"
        },
        {
          "s": 6,
          "text": "את התושבע\"פ שנקראת בשם ארץ15,"
        },
        {
          "s": 7,
          "text": "היינו שממשיכים בחינת איתן בתושבע\"פ."
        },
        {
          "s": 8,
          "text": "וי\"ל שהמשכת איתן להתנאים הוא ע\"י רשב\"י,"
        },
        {
          "s": 9,
          "text": "שהוא הי' הממוצע בין בחינת איתן להתנאים,"
        },
        {
          "s": 10,
          "text": "כמבואר בארוכה בהמאמר16."
        }
      ]
    }
  ]
}