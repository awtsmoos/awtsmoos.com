{
  "globalIndex": 708,
  "owner": 8,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917921_theRebbe_748__p003",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917921_theRebbe_748__p003",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917921_theRebbe_748",
  "title": "מאמר ונחה עליו רוח ה' תשי\"ד",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וזהו אור א\"ס למעלה מעלה עד אין קץ ולמטה מטה עד אין תכלית,"
        },
        {
          "s": 2,
          "text": "מעלה ומטה הם אצילות ובי\"ע,"
        },
        {
          "s": 3,
          "text": "ושרש התהוותם היא משני הענינים דאור וכח שבא\"ס,"
        },
        {
          "s": 4,
          "text": "שגם הם בדוגמת מעלה ומטה."
        },
        {
          "s": 5,
          "text": "דענין הכח שבא\"ס הו\"ע הירידה למטה,"
        },
        {
          "s": 6,
          "text": "מה שבכח הא\"ס להתפשט ולירד למטה להיות בבחי' כח נבדל להוות יש ודבר נפרד37,"
        },
        {
          "s": 7,
          "text": "וענין האור שבו"
        },
        {
          "s": 8,
          "text": "(ההרגש שכל הענינים הם כלא חשיב)"
        },
        {
          "s": 9,
          "text": "הו\"ע העלי' למעלה."
        },
        {
          "s": 10,
          "text": "וזהו אור א\"ס למעלה מעלה עד אין קץ ולמטה מטה עד אין תכלית38,"
        },
        {
          "s": 11,
          "text": "שהעילוי והשלימות דאור א\"ס הוא בשני הענינים."
        },
        {
          "s": 12,
          "text": "א',"
        },
        {
          "s": 13,
          "text": "שהוא נמשך למטה להוות ולהחיות הנבראים דבי\"ע,"
        },
        {
          "s": 14,
          "text": "ובזה גופא – למטה מטה עד אין תכלית,"
        },
        {
          "s": 15,
          "text": "שהוא נמשך לא רק בבריאה ויצירה אלא גם בעשי',"
        },
        {
          "s": 16,
          "text": "ובעשי' גופא – בעולם הזה הגשמי שאין תחתון למטה ממנו."
        },
        {
          "s": 17,
          "text": "וב',"
        },
        {
          "s": 18,
          "text": "שגם עולמות העליונים,"
        },
        {
          "s": 19,
          "text": "אצילות ולמעלה מאצילות,"
        },
        {
          "s": 20,
          "text": "למעלה מעלה עד אין קץ,"
        },
        {
          "s": 21,
          "text": "הם באין ערוך וכלא חשיב לגבי' ית'."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ויש להוסיף,"
        },
        {
          "s": 2,
          "text": "דזה שנת\"ל שמעלה ומטה הם אצילות ובי\"ע הוא בכללות,"
        },
        {
          "s": 3,
          "text": "אבל בפרטיות,"
        },
        {
          "s": 4,
          "text": "הענין דמעלה ומטה הוא הן באצילות והן בבי\"ע."
        },
        {
          "s": 5,
          "text": "דגם באצילות ולמעלה מאצילות יש הענין דמטה,"
        },
        {
          "s": 6,
          "text": "וכן לאידך,"
        },
        {
          "s": 7,
          "text": "שגם בבי\"ע יש הענין דמעלה."
        },
        {
          "s": 8,
          "text": "והענין הוא,"
        },
        {
          "s": 9,
          "text": "דאמיתית הענין דאין ערוך"
        },
        {
          "s": 10,
          "text": "(שכל העולמות הם באין ערוך לגבי' ית')"
        },
        {
          "s": 11,
          "text": "הוא שאצילות"
        },
        {
          "s": 12,
          "text": "(וגם למעלה מאצילות)"
        },
        {
          "s": 13,
          "text": "ועשי' הם בשוה ממש."
        },
        {
          "s": 14,
          "text": "וענין זה הוא דוקא לגבי אוא\"ס שלפני הצמצום."
        },
        {
          "s": 15,
          "text": "דבהמדריגות שלאחרי הצמצום,"
        },
        {
          "s": 16,
          "text": "מכיון שכל המדריגות הם בדרך השתלשלות עילה ועלול,"
        },
        {
          "s": 17,
          "text": "הרי בהכרח שהעילה היא למעלה מהעלול."
        },
        {
          "s": 18,
          "text": "וגם לגבי אור הקו,"
        },
        {
          "s": 19,
          "text": "יש להעולמות איזה ערך."
        },
        {
          "s": 20,
          "text": "דמכיון שהתהוות העולמות מהקו היא ע\"י גילוי הקו"
        },
        {
          "s": 21,
          "text": "(דכל פעולה היא ע\"י התגלות הפועל),"
        },
        {
          "s": 22,
          "text": "בהכרח שיש להם איזה ערך לגבי הקו39."
        },
        {
          "s": 23,
          "text": "משא\"כ לגבי אוא\"ס שלפני הצמצום,"
        },
        {
          "s": 24,
          "text": "מכיון שמצד הגילוי דאוא\"ס לא הי' אפשר להיות התהוות העולמות,"
        },
        {
          "s": 25,
          "text": "שלכן הוצרך להיות סילוק האור שעי\"ז דוקא נעשה חלל ומקום פנוי לעמידת העולמות40,"
        },
        {
          "s": 26,
          "text": "ולכן,"
        },
        {
          "s": 27,
          "text": "לגבי אוא\"ס שלפני הצמצום,"
        },
        {
          "s": 28,
          "text": "העולמות הם באין ערוך לגמרי39,"
        },
        {
          "s": 29,
          "text": "באופן שאצילות ועשי' הם בשוה ממש41."
        },
        {
          "s": 30,
          "text": "ומכיון שאור הסובב שמאיר בהעולמות בבחי' מקיף עכ\"פ הוא הגילוי דאוא\"ס שלפני הצמצום42,"
        },
        {
          "s": 31,
          "text": "לכן,"
        },
        {
          "s": 32,
          "text": "ע\"י אור הסובב,"
        },
        {
          "s": 33,
          "text": "נרגש בהם"
        },
        {
          "s": 34,
          "text": "(בבחי' מקיף עכ\"פ)"
        },
        {
          "s": 35,
          "text": "שהם באין ערוך."
        },
        {
          "s": 36,
          "text": "וזהו שגם באצילות ולמעלה מאצילות יש מעלה ומטה,"
        },
        {
          "s": 37,
          "text": "דזה שהם בסדר והדרגה דעילה ועלול"
        },
        {
          "s": 38,
          "text": "(היינו שיש להם ערך,"
        },
        {
          "s": 39,
          "text": "כנ\"ל),"
        },
        {
          "s": 40,
          "text": "הוא המטה שבהם,"
        },
        {
          "s": 41,
          "text": "וזה שנרגש בהם"
        },
        {
          "s": 42,
          "text": "(ע\"י אור הסובב)"
        },
        {
          "s": 43,
          "text": "שהם באין ערוך וכלא חשיב,"
        },
        {
          "s": 44,
          "text": "הוא המעלה שבהם."
        },
        {
          "s": 45,
          "text": "ועד\"ז לאידך,"
        },
        {
          "s": 46,
          "text": "שגם בבי\"ע יש הענין דמעלה."
        },
        {
          "s": 47,
          "text": "כי אור הסובב,"
        },
        {
          "s": 48,
          "text": "הוא סובב ומקיף את כל העולמות,"
        },
        {
          "s": 49,
          "text": "גם עולמות בי\"ע,"
        },
        {
          "s": 50,
          "text": "ולכן"
        },
        {
          "s": 51,
          "text": "(מצד אור הסובב שישנו בהם במקיף ובהעלם),"
        },
        {
          "s": 52,
          "text": "גם בנבראים יש הרצוא והביטול במציאות,"
        },
        {
          "s": 53,
          "text": "שהוא המעלה שבהם."
        },
        {
          "s": 54,
          "text": "ועפ\"ז יובן כפל הלשון למעלה מעלה כו' ולמטה מטה כו',"
        },
        {
          "s": 55,
          "text": "כי המעלה ומטה שבעולמות הוא בשתים."
        },
        {
          "s": 56,
          "text": "א' – שאצילות הוא מעלה ובי\"ע הם מטה,"
        },
        {
          "s": 57,
          "text": "וב' – הביטול והרצוא"
        },
        {
          "s": 58,
          "text": "(מעלה)"
        },
        {
          "s": 59,
          "text": "שישנו גם בבי\"ע,"
        },
        {
          "s": 60,
          "text": "והמציאות"
        },
        {
          "s": 61,
          "text": "(מטה)"
        },
        {
          "s": 62,
          "text": "שישנו גם באצילות ולמעלה מאצילות."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "והנה ידוע43"
        },
        {
          "s": 2,
          "text": "דאור הקו יש לו שרש גם בהאור שלפני הצמצום."
        },
        {
          "s": 3,
          "text": "דבאור שלפני הצמצום יש"
        },
        {
          "s": 4,
          "text": "(בכללות)"
        },
        {
          "s": 5,
          "text": "ב' מדריגות."
        },
        {
          "s": 6,
          "text": "כמו שהוא קודם שעלה ברצונו להאציל ולברוא,"
        },
        {
          "s": 7,
          "text": "דאז הי' למעלה משייכות לעולמות,"
        },
        {
          "s": 8,
          "text": "וכמו שהוא לאחרי שעלה ברצונו להאציל ולברוא,"
        },
        {
          "s": 9,
          "text": "שעי\"ז נעשה בגדר שייכות לעולמות."
        },
        {
          "s": 10,
          "text": "וב' מדריגות אלו הם השרש דאור הסובב ודאור הממלא שלאחרי הצמצום."
        },
        {
          "s": 11,
          "text": "דאור הסובב שרשו הוא באור שקודם עלות הרצון,"
        },
        {
          "s": 12,
          "text": "ואור הממלא"
        },
        {
          "s": 13,
          "text": "(אור הקו)"
        },
        {
          "s": 14,
          "text": "שרשו הוא בהאור דעלות הרצון."
        },
        {
          "s": 15,
          "text": "וזהו אור א\"ס למעלה מעלה עד אין קץ ולמטה מטה עד אין תכלית,"
        },
        {
          "s": 16,
          "text": "דשני הענינים"
        },
        {
          "s": 17,
          "text": "(דלמעלה מעלה כו' ולמטה מטה כו')"
        },
        {
          "s": 18,
          "text": "הם באור א\"ס עצמו."
        }
      ]
    }
  ]
}