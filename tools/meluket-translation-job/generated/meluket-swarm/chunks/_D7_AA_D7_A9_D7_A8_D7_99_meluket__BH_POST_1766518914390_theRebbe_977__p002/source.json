{
  "globalIndex": 116,
  "owner": 16,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914390_theRebbe_977__p002",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914390_theRebbe_977__p002",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914390_theRebbe_977",
  "title": "מאמר בסוכות תשבו תשכ\"ג",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה גם בהישיבה בסוכות דישראל בכח עצמם,"
        },
        {
          "s": 2,
          "text": "שני ענינים."
        },
        {
          "s": 3,
          "text": "בסוכות תשבו גו',"
        },
        {
          "s": 4,
          "text": "וכל האזרח בישראל ישבו בסוכות."
        },
        {
          "s": 5,
          "text": "ומהחילוקים דשני הענינים,"
        },
        {
          "s": 6,
          "text": "שבסוכות תשבו הוא בלשון ציווי,"
        },
        {
          "s": 7,
          "text": "וישבו בסוכות הוא בלשון דסיפור והודעה."
        },
        {
          "s": 8,
          "text": "ועוד חילוק,"
        },
        {
          "s": 9,
          "text": "שהציווי בסוכות תשבו הוא לכל ישראל,"
        },
        {
          "s": 10,
          "text": "ואלו שישבו בסוכות"
        },
        {
          "s": 11,
          "text": "(מעצמם,"
        },
        {
          "s": 12,
          "text": "ואין צריכים לציווי על זה)"
        },
        {
          "s": 13,
          "text": "הם"
        },
        {
          "s": 14,
          "text": "(רק)"
        },
        {
          "s": 15,
          "text": "האזרח בישראל."
        },
        {
          "s": 16,
          "text": "ומבאר בהמאמר6,"
        },
        {
          "s": 17,
          "text": "דבמקיפים יש ב' מדריגות,"
        },
        {
          "s": 18,
          "text": "מקיף הקרוב ומקיף הרחוק."
        },
        {
          "s": 19,
          "text": "ושני הענינים דבסוכות תשבו וישבו בסוכות הם בשתי מדריגות אלו."
        },
        {
          "s": 20,
          "text": "בסוכות תשבו הוא במקיף הקרוב וישבו בסוכות הוא במקיף הרחוק."
        },
        {
          "s": 21,
          "text": "וזהו שגבי ישבו בסוכות אומר כל האזרח בישראל,"
        },
        {
          "s": 22,
          "text": "דאזרח בישראל הוא עצם הנשמה שמושרשת בהעצמות8,"
        },
        {
          "s": 23,
          "text": "והישיבה במקיף הרחוק היא בהדרגא דעצם הנשמה."
        },
        {
          "s": 24,
          "text": "ויש לומר,"
        },
        {
          "s": 25,
          "text": "דזהו שישבו בסוכות הוא לא בלשון דציווי אלא בלשון דסיפור והודעה,"
        },
        {
          "s": 26,
          "text": "כי ענין הציווי שייך רק בדרגת הנשמה המלובשת בגוף,"
        },
        {
          "s": 27,
          "text": "משא\"כ בהנשמה שלמעלה,"
        },
        {
          "s": 28,
          "text": "ובפרט בעצם הנשמה,"
        },
        {
          "s": 29,
          "text": "אין ציווי."
        },
        {
          "s": 30,
          "text": "והענין דישבו בסוכות,"
        },
        {
          "s": 31,
          "text": "שעצם הנשמה יושבת במקיף הרחוק,"
        },
        {
          "s": 32,
          "text": "הוא"
        },
        {
          "s": 33,
          "text": "(לא מפני הציווי,"
        },
        {
          "s": 34,
          "text": "אלא)"
        },
        {
          "s": 35,
          "text": "מצד עצמה9,"
        },
        {
          "s": 36,
          "text": "לפי ששרשה הוא בהעצמות."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ומבאר בהמאמר,"
        },
        {
          "s": 1,
          "text": "דכל האזרח בישראל ישבו בסוכות הוא טעם על בסוכות תשבו."
        },
        {
          "s": 2,
          "text": "היינו דהכח על בסוכות תשבו,"
        },
        {
          "s": 3,
          "text": "להמשיך מקיף הקרוב,"
        },
        {
          "s": 4,
          "text": "הוא מפני שעצם הנשמה"
        },
        {
          "s": 5,
          "text": "(האזרח בישראל)"
        },
        {
          "s": 6,
          "text": "מושרשת בהעצמות"
        },
        {
          "s": 7,
          "text": "(מקיף הרחוק)."
        },
        {
          "s": 8,
          "text": "וצריך להבין,"
        },
        {
          "s": 9,
          "text": "דהטעם"
        },
        {
          "s": 10,
          "text": "(והכח)"
        },
        {
          "s": 11,
          "text": "על בסוכות תשבו הוא"
        },
        {
          "s": 12,
          "text": "(כמפורש בכתוב)"
        },
        {
          "s": 13,
          "text": "כי בסוכות הושבתי,"
        },
        {
          "s": 14,
          "text": "ולמה צריך גם להטעם דכל האזרח בישראל ישבו בסוכות."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים,"
        },
        {
          "s": 2,
          "text": "דכיון שאורות המקיפים"
        },
        {
          "s": 3,
          "text": "(כמו שהם מצד עצמם)"
        },
        {
          "s": 4,
          "text": "אינם באים בהתיישבות,"
        },
        {
          "s": 5,
          "text": "הרי זה שע\"י שישראל יושבים בסוכה נמשכים הם בפנימיות ובהתיישבות,"
        },
        {
          "s": 6,
          "text": "הוא כמו שינוי באורות המקיפים."
        },
        {
          "s": 7,
          "text": "ויתירה מזו,"
        },
        {
          "s": 8,
          "text": "דמלשון המאמר שע\"י הישיבה בסוכה ממשיכים אורות המקיפים בפנימיות ונעשים אורות מתיישבים"
        },
        {
          "s": 9,
          "text": "(ולא ממשיכים אורות המקיפים בפנימיות ובהתיישבות)"
        },
        {
          "s": 10,
          "text": "משמע,"
        },
        {
          "s": 11,
          "text": "שהשינוי שנעשה ע\"י שישראל יושבים בסוכה הוא גם באורות המקיפים עצמם."
        },
        {
          "s": 12,
          "text": "דנוסף לזה שע\"י הישיבה בסוכה הם נמשכים בפנימיות ובהתיישבות,"
        },
        {
          "s": 13,
          "text": "גם אורות המקיפים עצמם משתנים להיות אורות מתיישבים."
        },
        {
          "s": 14,
          "text": "וצריך להבין,"
        },
        {
          "s": 15,
          "text": "איך שייך שעל ידי עבודת האדם"
        },
        {
          "s": 16,
          "text": "(ישיבה בסוכה)"
        },
        {
          "s": 17,
          "text": "יהי' שינוי בהאורות דלמעלה."
        }
      ]
    }
  ]
}