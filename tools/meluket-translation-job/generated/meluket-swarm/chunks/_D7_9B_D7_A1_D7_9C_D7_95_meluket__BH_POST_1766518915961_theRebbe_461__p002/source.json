{
  "globalIndex": 386,
  "owner": 36,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915961_theRebbe_461__p002",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915961_theRebbe_461__p002",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915961_theRebbe_461",
  "title": "מאמר ביום השמיני תשמ\"ו",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ולכאורה צריך לומר,"
        },
        {
          "s": 1,
          "text": "שעד\"ז הוא בנוגע ליום השמיני דחנוכה,"
        },
        {
          "s": 2,
          "text": "שיש בו שני הפירושים."
        },
        {
          "s": 3,
          "text": "דזה שביום הח' ההמשכה היא במלכות"
        },
        {
          "s": 4,
          "text": "(שלכן נקרא זאת חנוכה),"
        },
        {
          "s": 5,
          "text": "שמיני שלמטה משבעה,"
        },
        {
          "s": 6,
          "text": "הוא לפי ששרשו הוא בשמיני שלמעלה משבעה."
        },
        {
          "s": 7,
          "text": "אבל מזה שבמאמר הנ\"ל"
        },
        {
          "s": 8,
          "text": "(שמבאר ענין יום השמיני דחנוכה)"
        },
        {
          "s": 9,
          "text": "מובא"
        },
        {
          "s": 10,
          "text": "(בתחלת הענין16)"
        },
        {
          "s": 11,
          "text": "רק הפירוש ששמיני הוא מלכות,"
        },
        {
          "s": 12,
          "text": "ודלא כבהדרושים שמבארים ענין שמונת ימי המילואים שמובא בהם שני הפירושים דשמיני,"
        },
        {
          "s": 13,
          "text": "משמע,"
        },
        {
          "s": 14,
          "text": "שעיקר ענינו של יום השמיני דחנוכה הוא ההמשכה למטה."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ויובן זה ע\"פ הידוע,"
        },
        {
          "s": 2,
          "text": "דבמעלת המעשה"
        },
        {
          "s": 3,
          "text": "[דכח המעשה שבאדם,"
        },
        {
          "s": 4,
          "text": "כח הכי תחתון,"
        },
        {
          "s": 5,
          "text": "הוא דוגמת ספירת המלכות]"
        },
        {
          "s": 6,
          "text": "כמה ענינים."
        },
        {
          "s": 7,
          "text": "זה שע\"י המעשה דוקא נעשה עלי' בכל כחות הנפש."
        },
        {
          "s": 8,
          "text": "וכידוע המשל על זה מכלי ההגבהה הנקרא ליווער,"
        },
        {
          "s": 9,
          "text": "שע\"י שמעמידים אותו תחת כל הדבר שרוצים להגבי',"
        },
        {
          "s": 10,
          "text": "אז דוקא יוגבה כל הדבר."
        },
        {
          "s": 11,
          "text": "דכאשר מגביהים את הדבר מאמצעיתו,"
        },
        {
          "s": 12,
          "text": "אזי החלק התחתון שבו ישאר למטה."
        },
        {
          "s": 13,
          "text": "וכמו הגבהת בית,"
        },
        {
          "s": 14,
          "text": "שבכדי שכל הבית יוגבה למעלה הוא דוקא על ידי שמגביהים הקורה התחתונה של הבית,"
        },
        {
          "s": 15,
          "text": "וכשמגביהים את הכתלים מאמצעיתם,"
        },
        {
          "s": 16,
          "text": "הקורות התחתונות נשארות למטה17."
        },
        {
          "s": 17,
          "text": "ויש לומר,"
        },
        {
          "s": 18,
          "text": "דכיון שכל הקורות הם של בית אחד,"
        },
        {
          "s": 19,
          "text": "לכן,"
        },
        {
          "s": 20,
          "text": "כשקורה התחתונה נשארת למטה,"
        },
        {
          "s": 21,
          "text": "גם ההגבהה והעלי' של קורות העליונות אינה בשלימות."
        },
        {
          "s": 22,
          "text": "ועאכו\"כ בהנמשל דכחות הנפש,"
        },
        {
          "s": 23,
          "text": "שכל כח משפיע על שאר הכחות18,"
        },
        {
          "s": 24,
          "text": "שבכדי שהעלי' דכחות הנעלים"
        },
        {
          "s": 25,
          "text": "(שכל וכו')"
        },
        {
          "s": 26,
          "text": "תהי' בשלימות,"
        },
        {
          "s": 27,
          "text": "הוא דוקא ע\"י העלי' דכח המעשה,"
        },
        {
          "s": 28,
          "text": "כח הכי תחתון."
        },
        {
          "s": 29,
          "text": "ועוד ענין בזה,"
        },
        {
          "s": 30,
          "text": "שע\"י המעשה,"
        },
        {
          "s": 31,
          "text": "העלי' וההגבהה של כחות העליונים היא למקום גבוה יותר."
        },
        {
          "s": 32,
          "text": "וכהמשל דכף מאזנים ששוקלין בכף אחת ונותנים משא בכף השני',"
        },
        {
          "s": 33,
          "text": "שכל שהכף שבה שוקלין יורדת למטה יותר,"
        },
        {
          "s": 34,
          "text": "הגבהת המשא שבכף השני' היא למעלה יותר19."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה זה שע\"י המעשה דוקא נעשה שלימות העלי' דכל הכחות הוא לפי ששרש המעשה הוא למעלה מכל הכחות."
        },
        {
          "s": 2,
          "text": "ושני ענינים בזה20."
        },
        {
          "s": 3,
          "text": "שההמשכה במעשה"
        },
        {
          "s": 4,
          "text": "(זה שהשכל ומדות נמשכים במעשה),"
        },
        {
          "s": 5,
          "text": "שרשה הוא בהנפש שלמעלה מהכחות."
        },
        {
          "s": 6,
          "text": "שהשכל ומדות מצד עצמם הם מוגבלים ואין ביכלתם לירד למטה כ\"כ ולהתלבש במעשה,"
        },
        {
          "s": 7,
          "text": "וזה שאפשרי להם לירד ולהתלבש במעשה הוא ע\"י שנמשך בהם מהנפש,"
        },
        {
          "s": 8,
          "text": "שהיא נמצאת בכל הכחות והאיברים בשוה."
        },
        {
          "s": 9,
          "text": "ושהשרש דכח המעשה עצמו הוא למעלה מהשרש דכל הכחות."
        },
        {
          "s": 10,
          "text": "דזה שכל הכחות הם בבחי' קירוב להנפש וכח המעשה הוא כח נבדל,"
        },
        {
          "s": 11,
          "text": "הוא לפי שהשרש דכל הכחות הוא בהגילויים דהנפש,"
        },
        {
          "s": 12,
          "text": "והשרש דכח המעשה הוא בעצם הנפש21."
        }
      ]
    }
  ]
}