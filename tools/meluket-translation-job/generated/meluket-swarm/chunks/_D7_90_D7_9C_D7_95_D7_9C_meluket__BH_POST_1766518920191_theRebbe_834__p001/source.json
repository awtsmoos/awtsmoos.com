{
  "globalIndex": 1077,
  "owner": 27,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920191_theRebbe_834__p001",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920191_theRebbe_834__p001",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920191_theRebbe_834",
  "title": "מאמר אני לדודי תשל\"ב",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "יום ד' פ' שופטים,"
        },
        {
          "s": 2,
          "text": "אור לאדר\"ח אלול ה'תשל\"ב"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "אני לדודי ודודי לי1"
        },
        {
          "s": 1,
          "text": "ר\"ת אלול2,"
        },
        {
          "s": 2,
          "text": "ומבואר בלקו\"ת בהמאמר ד\"ה זה3,"
        },
        {
          "s": 3,
          "text": "שבאלול הוא אתערותא דלתתא,"
        },
        {
          "s": 4,
          "text": "אני לדודי,"
        },
        {
          "s": 5,
          "text": "ובראש השנה ויום הכיפורים היא ההמשכה מלמעלה למטה"
        },
        {
          "s": 6,
          "text": "(אתערותא דלעילא),"
        },
        {
          "s": 7,
          "text": "ודודי לי."
        },
        {
          "s": 8,
          "text": "וצריך להבין,"
        },
        {
          "s": 9,
          "text": "דבתחלת המאמר אומר שאלול הוא ר\"ת אני לדודי ודודי לי,"
        },
        {
          "s": 10,
          "text": "ומיד לאח\"ז מבאר שבאלול הוא"
        },
        {
          "s": 11,
          "text": "(רק)"
        },
        {
          "s": 12,
          "text": "אני לדודי,"
        },
        {
          "s": 13,
          "text": "וודודי לי הוא בראש השנה ויום הכיפורים."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 1,
          "text": "שבאלול הוא זמן התגלות י\"ג מדות הרחמים4."
        },
        {
          "s": 2,
          "text": "ומבאר שהגילוי די\"ג מדה\"ר באלול הוא לכאו\"א,"
        },
        {
          "s": 3,
          "text": "גם להרחוקים ביותר5."
        },
        {
          "s": 4,
          "text": "וכמו מלך שקודם בואו לעיר יוצאין אנשי העיר לקראתו ומקבלים פניו בשדה,"
        },
        {
          "s": 5,
          "text": "ואז רשאים"
        },
        {
          "s": 6,
          "text": "[ויכולים6]"
        },
        {
          "s": 7,
          "text": "כל מי שרוצה להקביל פניו,"
        },
        {
          "s": 8,
          "text": "והוא מקבל את כולם בסבר פנים יפות ומראה פנים שוחקות לכולם."
        },
        {
          "s": 9,
          "text": "וצריך להבין,"
        },
        {
          "s": 10,
          "text": "איך זה מתאים עם מ\"ש הטור7,"
        },
        {
          "s": 11,
          "text": "שמר\"ח אלול ואילך תוקעין בשופר בכל יום כדי להזהיר את העם שיעשו תשובה,"
        },
        {
          "s": 12,
          "text": "שנאמר8"
        },
        {
          "s": 13,
          "text": "אם יתקע שופר בעיר ועם לא יחרדו,"
        },
        {
          "s": 14,
          "text": "דלכאורה מכיון שבאלול המלך מקבל את כולם בסבר פנים יפות ומראה פנים שוחקות לכולם,"
        },
        {
          "s": 15,
          "text": "הרי עיקר העבודה דאלול היא"
        },
        {
          "s": 16,
          "text": "(לכאורה)"
        },
        {
          "s": 17,
          "text": "אהבה,"
        },
        {
          "s": 18,
          "text": "וגם התשובה דאלול צריכה להיות"
        },
        {
          "s": 19,
          "text": "(לכאורה)"
        },
        {
          "s": 20,
          "text": "תשובה מאהבה,"
        },
        {
          "s": 21,
          "text": "וא\"כ למה תוקעין אז בשופר בכדי לעורר יראה וחרדה."
        }
      ]
    }
  ]
}