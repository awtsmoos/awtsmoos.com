{
  "globalIndex": 341,
  "owner": 41,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915689_theRebbe_467__p003",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915689_theRebbe_467__p003",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915689_theRebbe_467",
  "title": "הוספה משיחות ש\"פ וישב-מקץ תשכ\"ו",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ועפי\"ז יובן מה שמחלק ג' ענינים אלו לשתי חלוקות ומה שמקדים תורה וגמ\"ח לתפלה,"
        },
        {
          "s": 1,
          "text": "שבתחילה מדבר בענין הכוונה ותכלית המכוון,"
        },
        {
          "s": 2,
          "text": "שהיא ההמשכה שע\"י תורה וגמ\"ח,"
        },
        {
          "s": 3,
          "text": "ואח\"כ – בענין ההכנה לזה,"
        },
        {
          "s": 4,
          "text": "והיא ההעלאה דתפלה."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ובכל זה בתורה וגמ\"ח עצמם מקדים תורה לגמ\"ח,"
        },
        {
          "s": 1,
          "text": "אף שדירה בתחתונים נעשה יותר ע\"י גמ\"ח מאשר ע\"י תורה"
        },
        {
          "s": 2,
          "text": "(וכמשנ\"ת בתניא8"
        },
        {
          "s": 3,
          "text": "במעלת הצדקה)"
        },
        {
          "s": 4,
          "text": "– נוסף על שכן סדרן במשך היום מביהמ\"ד לעסקיו כו' כנ\"ל,"
        },
        {
          "s": 5,
          "text": "הרי בתורה וגמ\"ח עצמם,"
        },
        {
          "s": 6,
          "text": "אמרז\"ל9"
        },
        {
          "s": 7,
          "text": "ת\"ת כנגד כולם."
        },
        {
          "s": 8,
          "text": "ואף שמבואר באגה\"ק10"
        },
        {
          "s": 9,
          "text": "אשר עכשיו עיקר העבודה הוא בצדקה,"
        },
        {
          "s": 10,
          "text": "הרי זהו עכשיו דוקא,"
        },
        {
          "s": 11,
          "text": "בעקבות משיחא שנפלה סוכת דוד עד בחי' רגלים ועקביים שהיא בחי' עשי',"
        },
        {
          "s": 12,
          "text": "אבל בימי רז\"ל"
        },
        {
          "s": 13,
          "text": "(שהם אמרו כל העוסק כו')"
        },
        {
          "s": 14,
          "text": "עיקר העבודה הי' תלמוד תורה,"
        },
        {
          "s": 15,
          "text": "כמבואר באגה\"ק שם."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"י כל זה יובן סדרן של ג' ענינים אלו: תורה,"
        },
        {
          "s": 1,
          "text": "גמ\"ח ותפלה"
        },
        {
          "s": 2,
          "text": "(בצבור),"
        },
        {
          "s": 3,
          "text": "שסדר זה הוא מלמעלמ\"ט,"
        },
        {
          "s": 4,
          "text": "לפי חשיבות הענינים: תורה,"
        },
        {
          "s": 5,
          "text": "אשר"
        },
        {
          "s": 6,
          "text": "(בימיהם)"
        },
        {
          "s": 7,
          "text": "היא עיקר המעלה,"
        },
        {
          "s": 8,
          "text": "אח\"כ גמ\"ח,"
        },
        {
          "s": 9,
          "text": "שהיא למטה מתורה כנ\"ל,"
        },
        {
          "s": 10,
          "text": "ואח\"כ תפלה,"
        },
        {
          "s": 11,
          "text": "שהיא הכנה לההמשכה דתורה וגמ\"ח."
        }
      ]
    }
  ]
}