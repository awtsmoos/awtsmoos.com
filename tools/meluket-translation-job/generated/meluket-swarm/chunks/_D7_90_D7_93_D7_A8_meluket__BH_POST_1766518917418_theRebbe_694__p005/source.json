{
  "globalIndex": 630,
  "owner": 30,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917418_theRebbe_694__p005",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917418_theRebbe_694__p005",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917418_theRebbe_694",
  "title": "מאמר וקבל היהודים תשי\"א",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "וע\"פ כל הנ\"ל יש לומר הטעם על זה שגמר קבלת התורה"
        },
        {
          "s": 3,
          "text": "(וקבל היהודים)"
        },
        {
          "s": 4,
          "text": "תלוי במס\"נ,"
        },
        {
          "s": 5,
          "text": "כי החיבור דעליונים ותחתונים הוא ע\"י ביטול הגדרים והמציאות דעליון ותחתון"
        },
        {
          "s": 6,
          "text": "(כנ\"ל),"
        },
        {
          "s": 7,
          "text": "ולכן,"
        },
        {
          "s": 8,
          "text": "בכדי שתהי' השלימות דקבלת התורה,"
        },
        {
          "s": 9,
          "text": "הוצרך להיות הביטול דמס\"נ."
        },
        {
          "s": 10,
          "text": "ואף שגם בשעת מתן תורה כשאמרו נעשה ונשמע קיבלו עליהם לעשות כל מה שיצטוו גם באם יהי' צריך למס\"נ על זה,"
        },
        {
          "s": 11,
          "text": "הרי כל זמן שהמס\"נ היא בכח הוא מצד הנשמה ואינו בהגוף,"
        },
        {
          "s": 12,
          "text": "וכיון שהביטול"
        },
        {
          "s": 13,
          "text": "(שעל ידו נעשה החיבור דעליונים ותחתונים)"
        },
        {
          "s": 14,
          "text": "צריך להיות הן בהעליון והן בהתחתון,"
        },
        {
          "s": 15,
          "text": "לכן השלימות דקבלת התורה תלוי' במס\"נ בפועל,"
        },
        {
          "s": 16,
          "text": "כי המס\"נ בפועל היא77"
        },
        {
          "s": 17,
          "text": "בהגוף ונפש הטבעית."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יובן גם המעלה במס\"נ דפורים על המס\"נ דחנוכה,"
        },
        {
          "s": 1,
          "text": "כי גם המס\"נ בפועל היא בעיקר מצד הנשמה,"
        },
        {
          "s": 2,
          "text": "אלא שהמס\"נ דהנשמה פועלת גם בהגוף ובנפש הטבעית,"
        },
        {
          "s": 3,
          "text": "ומכיון שהגוף ונפש הטבעית"
        },
        {
          "s": 4,
          "text": "(מצד ענינם)"
        },
        {
          "s": 5,
          "text": "הם מציאות,"
        },
        {
          "s": 6,
          "text": "לכן הגילוי דמתן תורה"
        },
        {
          "s": 7,
          "text": "(החיבור דעליונים ותחתונים)"
        },
        {
          "s": 8,
          "text": "שנמשך בהם ע\"י הביטול דמס\"נ שמצד הנשמה הוא דבר נוסף עליהם."
        },
        {
          "s": 9,
          "text": "וזוהי המעלה דהמס\"נ דפורים על המס\"נ דחנוכה,"
        },
        {
          "s": 10,
          "text": "שבפורים היו בתכלית הביטול"
        },
        {
          "s": 11,
          "text": "(והשפלות)"
        },
        {
          "s": 12,
          "text": "גם מצד הגוף78,"
        },
        {
          "s": 13,
          "text": "שהרי היו הפקר גמור להריגה לכל מי שירצה,"
        },
        {
          "s": 14,
          "text": "ובדרך הטבע לא הי' דרך להנצל מזה."
        },
        {
          "s": 15,
          "text": "[ואף שהגזירה היתה רק על היהודים ובאם היו כופרים ח\"ו לא היו עושים להם כלום"
        },
        {
          "s": 16,
          "text": "(כמובא לעיל סעיף א מתו\"א),"
        },
        {
          "s": 17,
          "text": "מ\"מ,"
        },
        {
          "s": 18,
          "text": "מכיון שהגזירה אז היתה לא על קיום התומ\"צ אלא על הגוף,"
        },
        {
          "s": 19,
          "text": "להרוג ולאבד ח\"ו,"
        },
        {
          "s": 20,
          "text": "נמצא,"
        },
        {
          "s": 21,
          "text": "שהגופים שלהם היו אז בתכלית השפלות."
        },
        {
          "s": 22,
          "text": "דכאשר הגזירה היא על התומ\"צ"
        },
        {
          "s": 23,
          "text": "(כמו בחנוכה79"
        },
        {
          "s": 24,
          "text": "שהגזירה היתה להשכיחם תורתיך ולהעבירם מחוקי רצונך80)"
        },
        {
          "s": 25,
          "text": "שבאם יקיים תומ\"צ יהרגו אותו,"
        },
        {
          "s": 26,
          "text": "אזי,"
        },
        {
          "s": 27,
          "text": "הגוף"
        },
        {
          "s": 28,
          "text": "(מצד ענינו)"
        },
        {
          "s": 29,
          "text": "אינו כהפקר."
        },
        {
          "s": 30,
          "text": "משא\"כ כשהגזירה היא להרוג ולאבד ח\"ו אלא שיש לו אפשרות להנצל מהגזירה ע\"י שיכפור ח\"ו,"
        },
        {
          "s": 31,
          "text": "מכיון שהגזירה להרוג אותו היא"
        },
        {
          "s": 32,
          "text": "(לא מפני שאינו רוצה לכפור,"
        },
        {
          "s": 33,
          "text": "אלא)"
        },
        {
          "s": 34,
          "text": "על הגוף,"
        },
        {
          "s": 35,
          "text": "נמצא שהגוף"
        },
        {
          "s": 36,
          "text": "(מצד ענינו)"
        },
        {
          "s": 37,
          "text": "הוא כהפקר81]."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "וזהו מה שע\"י המס\"נ דפורים דוקא הי' הגמר והשלימות דקבלת התורה,"
        },
        {
          "s": 1,
          "text": "כי ע\"י שהביטול שלהם אז הי' גם מצד הגוף,"
        },
        {
          "s": 2,
          "text": "לכן היו כלים להגילוי דמתן תורה הן מצד הנשמה והן מצד הגוף."
        },
        {
          "s": 3,
          "text": "ויש לומר דזהו גם מ\"ש בהמאמר שבזמן הגזירה היו ישראל בתכלית השפלות גם בגשמיות,"
        },
        {
          "s": 4,
          "text": "כי בזה מרמז הטעם על זה שהיו אז כלים להגילוי דמתן תורה גם מצד הגוף."
        }
      ]
    }
  ]
}