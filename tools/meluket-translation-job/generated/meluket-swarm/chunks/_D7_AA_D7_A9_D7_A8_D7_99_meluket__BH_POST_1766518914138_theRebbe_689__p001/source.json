{
  "globalIndex": 78,
  "owner": 28,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914138_theRebbe_689__p001",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914138_theRebbe_689__p001",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914138_theRebbe_689",
  "title": "מאמר שיר המעלות ממעמקים תשמ\"ח",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ האזינו,"
        },
        {
          "s": 2,
          "text": "שבת שובה ה'תשמ\"ח*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "– התוועדות ב' – המשך להתוועדות יום ב' דראש השנה –"
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "שיר המעלות ממעמקים קראתיך הוי'1,"
        },
        {
          "s": 1,
          "text": "הנה מזמור זה נתקן לאומרו בכל יום מעשרת ימי תשובה,"
        },
        {
          "s": 2,
          "text": "מתחיל מראש השנה2"
        },
        {
          "s": 3,
          "text": "(שהוא היום הראשון דעשי\"ת),"
        },
        {
          "s": 4,
          "text": "וכמה דרושי ראש השנה מתחילים בפסוק זה."
        },
        {
          "s": 5,
          "text": "ומובא ע\"ז בהדרושים3,"
        },
        {
          "s": 6,
          "text": "דבפירוש ממעמקים יש שתי דיעות בזהר4"
        },
        {
          "s": 7,
          "text": "ר' יצחק ור' אבא,"
        },
        {
          "s": 8,
          "text": "דר\"י מפרש ממעמקים של האדם,"
        },
        {
          "s": 9,
          "text": "שהתפלה הנ\"ל היא ממעמקי נפשו של האדם5,"
        },
        {
          "s": 10,
          "text": "ממעמקי הנפש של דוד המלך5"
        },
        {
          "s": 11,
          "text": "וכן של כאו\"א מישראל האומר מזמור זה,"
        },
        {
          "s": 12,
          "text": "ור\"א מפרש ממעמקים של למעלה אתר גנוז הוא לעילא כו'."
        },
        {
          "s": 13,
          "text": "וממשיך בהמאמרים6,"
        },
        {
          "s": 14,
          "text": "והנה פירוש ממעמקים הוא ב' עומקים,"
        },
        {
          "s": 15,
          "text": "דזהו לפי שתי הדיעות הנ\"ל,"
        },
        {
          "s": 16,
          "text": "וע\"פ זה מבאר דלדעת ר\"י הנה העומק לפנים מעומק הוא עומקא דליבא5"
        },
        {
          "s": 17,
          "text": "ולדעת ר\"א הרי זה עמיקא דעמיקתא בהמדריגות שלמעלה."
        },
        {
          "s": 18,
          "text": "וממשיך דעיקר הפירוש הוא דקאי על המדריגות שלמעלה,"
        },
        {
          "s": 19,
          "text": "דהיינו שע\"י קראתיך מגיעים בבחי' עומק לפנים מעומק,"
        },
        {
          "s": 20,
          "text": "עד שעולים לבחי' עומק כזה שהוא למעלה מהתחלקות של דרגות,"
        },
        {
          "s": 21,
          "text": "ומשם קראתיך – נמשך – הוי'."
        },
        {
          "s": 22,
          "text": "והקשר דב' הפירושים"
        },
        {
          "s": 23,
          "text": "(דמר אמר חדא ומר אמר חדא ולא פליגי)"
        },
        {
          "s": 24,
          "text": "הוא,"
        },
        {
          "s": 25,
          "text": "כי היכולת להמשיך מבחי' עומק זה שהוא למעלה מכל גדר התחלקות הוא ע\"י בחי' עומקא דליבא,"
        },
        {
          "s": 26,
          "text": "שבא ע\"י עבודת התשובה,"
        },
        {
          "s": 27,
          "text": "כמבואר בהמאמרים,"
        },
        {
          "s": 28,
          "text": "וכמובן בפשטות שזהו תוכן מזמור זה"
        },
        {
          "s": 29,
          "text": "(שיר המעלות ממעמקים),"
        },
        {
          "s": 30,
          "text": "תפלת התשובה."
        }
      ]
    }
  ]
}