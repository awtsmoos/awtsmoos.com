{
  "globalIndex": 733,
  "owner": 33,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918060_theRebbe_524__p002",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918060_theRebbe_524__p002",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518918060_theRebbe_524",
  "title": "מאמר ועבדי דוד תשמ\"ו",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה ב' ענינים אלה בכללות עבודת האדם הם ב' הענינים"
        },
        {
          "s": 2,
          "text": "(ב' אופני העבודה)"
        },
        {
          "s": 3,
          "text": "דלימוד התורה וקיום המצוות."
        },
        {
          "s": 4,
          "text": "דענינה של תורה הוא דאורייתא וקוב\"ה כולא חד14,"
        },
        {
          "s": 5,
          "text": "וכדאיתא בתניא15"
        },
        {
          "s": 6,
          "text": "שע\"י לימוד התורה האדם הלומד מתאחד עם נותן התורה ביחוד נפלא שאין יחוד כמוהו ולא כערכו נמצא כלל,"
        },
        {
          "s": 7,
          "text": "ובכל עולם שלומד את התורה,"
        },
        {
          "s": 8,
          "text": "הנה ע\"י הלימוד מגיע אל התורה כפי שהיא לאמיתתה ופנימיותה בעולם זה."
        },
        {
          "s": 9,
          "text": "ומובן,"
        },
        {
          "s": 10,
          "text": "שכיון שע\"י לימוד התורה מגיעים לעילוי זה,"
        },
        {
          "s": 11,
          "text": "הרי יש לאדם הלומד תענוג"
        },
        {
          "s": 12,
          "text": "(געשמאַק)"
        },
        {
          "s": 13,
          "text": "בדבר."
        },
        {
          "s": 14,
          "text": "אמנם ענין קיום המצוות הוא בכח העשי' דוקא,"
        },
        {
          "s": 15,
          "text": "שהרי קיום המצוות הוא בדברים גשמיים16,"
        },
        {
          "s": 16,
          "text": "דברים שהם מחוץ לאדם עצמו"
        },
        {
          "s": 17,
          "text": "(ס'איז ניט ער),"
        },
        {
          "s": 18,
          "text": "ובשביל זה צ\"ל עשי' מלשון כפי'"
        },
        {
          "s": 19,
          "text": "(והודאה),"
        },
        {
          "s": 20,
          "text": "שירד ממדריגתו,"
        },
        {
          "s": 21,
          "text": "מאיגרא11"
        },
        {
          "s": 22,
          "text": "רמה לבירא עמיקתא,"
        },
        {
          "s": 23,
          "text": "היינו מכח השכל והמוחין שבו אל כח העשי' שבאדם עצמו אין תחתון למטה ממנה."
        },
        {
          "s": 24,
          "text": "וכמובא בכמה דרושים17,"
        },
        {
          "s": 25,
          "text": "שכח העשי' ישנו גם בבהמה"
        },
        {
          "s": 26,
          "text": "(סוג החי),"
        },
        {
          "s": 27,
          "text": "ובכח זה משתווה סוג המדבר עם סוג החי."
        },
        {
          "s": 28,
          "text": "דירידה זו היא ע\"י כפי' והודאה."
        },
        {
          "s": 29,
          "text": "וזהו גם מה שבמצות לימוד התורה,"
        },
        {
          "s": 30,
          "text": "הנה ע\"פ תורה צריך להיות חיות ותענוג"
        },
        {
          "s": 31,
          "text": "(געשמאַק)"
        },
        {
          "s": 32,
          "text": "בלימוד התורה,"
        },
        {
          "s": 33,
          "text": "וקיום המצוות עיקרו הוא ע\"י קבלת עול דוקא,"
        },
        {
          "s": 34,
          "text": "ועול עיקרו שייך בבהמה."
        },
        {
          "s": 35,
          "text": "והם ב' הענינים דיוסף"
        },
        {
          "s": 36,
          "text": "(תורה)"
        },
        {
          "s": 37,
          "text": "ויהודה"
        },
        {
          "s": 38,
          "text": "(מצוות)."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה בב' אופני עבודה אלה דתורה ומצוות"
        },
        {
          "s": 2,
          "text": "(תלמוד ומעשה)"
        },
        {
          "s": 3,
          "text": "יש שקו\"ט בגמרא18"
        },
        {
          "s": 4,
          "text": "מי מהם גדול."
        },
        {
          "s": 5,
          "text": "וכמובא בהמאמר שם19,"
        },
        {
          "s": 6,
          "text": "דאיפליגו בזה,"
        },
        {
          "s": 7,
          "text": "חד אמר תלמוד גדול וחד אמר מעשה גדול."
        },
        {
          "s": 8,
          "text": "ומלשון הגמרא מובן,"
        },
        {
          "s": 9,
          "text": "שכשהשוו המעלות דתלמוד ומעשה כשלעצמן,"
        },
        {
          "s": 10,
          "text": "לא הכריעו איזה מהן גדול."
        },
        {
          "s": 11,
          "text": "דמעלת התלמוד הוא ענין התענוג שבו"
        },
        {
          "s": 12,
          "text": "(כנ\"ל),"
        },
        {
          "s": 13,
          "text": "ויש מעלה במעשה שאין בתלמוד,"
        },
        {
          "s": 14,
          "text": "ענין האתכפיא20,"
        },
        {
          "s": 15,
          "text": "שזהו חידוש שעושה דבר שהוא היפך טבעו ועונג שלו."
        },
        {
          "s": 16,
          "text": "והיינו,"
        },
        {
          "s": 17,
          "text": "שגם לולא הענין דקבלת עול מלכות שמים"
        },
        {
          "s": 18,
          "text": "(שלמעלה),"
        },
        {
          "s": 19,
          "text": "הרי יש חידוש בעצם הענין מה שהאדם יכול לעשות גם דבר שהוא היפך טבעו ועונג שלו."
        },
        {
          "s": 20,
          "text": "ולבסוף נמנו וגמרו תלמוד גדול שהתלמוד מביא לידי מעשה,"
        },
        {
          "s": 21,
          "text": "הרי אין זה משום שתלמוד"
        },
        {
          "s": 22,
          "text": "(תענוג)"
        },
        {
          "s": 23,
          "text": "מצ\"ע הוא למעלה ממעשה"
        },
        {
          "s": 24,
          "text": "(כפי'),"
        },
        {
          "s": 25,
          "text": "אלא משום שיש בתלמוד גם מעלת המעשה,"
        },
        {
          "s": 26,
          "text": "שמביא לידי מעשה."
        },
        {
          "s": 27,
          "text": "שכדי לידע את המעשה אשר יעשה צ\"ל תלמוד לפנ\"ז."
        },
        {
          "s": 28,
          "text": "ויש להוסיף בזה,"
        },
        {
          "s": 29,
          "text": "שבתלמוד עצמו ישנה גם המעלה שבמעשה שהיא הכפי'."
        },
        {
          "s": 30,
          "text": "כי לאחרי שלומד תורה בתכלית השלימות מצד התענוג שלו ורחובות הנהר שלו והשמחה שלו,"
        },
        {
          "s": 31,
          "text": "הנה אח\"כ מגיע לדרגא נעלית יותר,"
        },
        {
          "s": 32,
          "text": "שלומד מצד כפי' והודאה,"
        },
        {
          "s": 33,
          "text": "שמבטל כל מציאותו ולומד מחמת קבלת עול."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "אמנם כ\"ז הוא רק בזמן הזה,"
        },
        {
          "s": 2,
          "text": "אבל לע\"ל יהי' מעשה גדול21."
        },
        {
          "s": 3,
          "text": "והענין הוא,"
        },
        {
          "s": 4,
          "text": "דהנה לע\"ל כתיב22"
        },
        {
          "s": 5,
          "text": "ואת רוח הטומאה אעביר מן הארץ,"
        },
        {
          "s": 6,
          "text": "ולכן תהי' אז העבודה רק בעליות מחיל אל חיל בטוב עצמו ובקדושה גופא23,"
        },
        {
          "s": 7,
          "text": "ושלימות העילוי הוא שהעבודה תהי' למעלה גם מבחי' התענוג,"
        },
        {
          "s": 8,
          "text": "כ\"א עבודת ה' מתוך קבלת עול,"
        },
        {
          "s": 9,
          "text": "למלא רצונו של הקב\"ה."
        },
        {
          "s": 10,
          "text": "ועוד,"
        },
        {
          "s": 11,
          "text": "כי בזמן הזה עדיין נמצאים במיצרים וגבולים דקדושה,"
        },
        {
          "s": 12,
          "text": "וישנם גדרים של מעלות וכו',"
        },
        {
          "s": 13,
          "text": "ואומרים דיש מעלה במעשה ויש מעלה בתלמוד,"
        },
        {
          "s": 14,
          "text": "אבל לע\"ל שתהי' יציאה מכל המיצרים וגבולים,"
        },
        {
          "s": 15,
          "text": "הנה אז אין שייך לומר מעלות,"
        },
        {
          "s": 16,
          "text": "אלא רק אמיתית העבודה,"
        },
        {
          "s": 17,
          "text": "שעובדים את ה' בקבלת עול בלי שום פניות,"
        },
        {
          "s": 18,
          "text": "גם לא פניות דקדושה."
        },
        {
          "s": 19,
          "text": "וי\"ל הביאור בזה בנגלה ע\"פ מ\"ש הרמב\"ם24"
        },
        {
          "s": 20,
          "text": "ששלימות עבודת האדם היא העבודה מאהבה והיא מעלת אברהם אבינו שקראו הקב\"ה אוהבו25,"
        },
        {
          "s": 21,
          "text": "והיינו העבודה בלי שום פניות,"
        },
        {
          "s": 22,
          "text": "וכמ\"ש הרמב\"ם שם26"
        },
        {
          "s": 23,
          "text": "שהעבודה צ\"ל אפילו לא בשביל הפני' שאזכה לחיי עוה\"ב."
        },
        {
          "s": 24,
          "text": "ושלימות זו תהי' לע\"ל"
        },
        {
          "s": 25,
          "text": "(בימות המשיח)."
        },
        {
          "s": 26,
          "text": "וזהו שלע\"ל מעשה גדול,"
        },
        {
          "s": 27,
          "text": "מעלת הכפי' וקבלת עול שלמעלה מכל כוחות האדם."
        },
        {
          "s": 28,
          "text": "וי\"ל דזה נרמז במ\"ש הרמב\"ם שצ\"ל העבודה גם לא ע\"מ שיזכה לחיי עוה\"ב דענין עולם הבא הוא ענין התורה"
        },
        {
          "s": 29,
          "text": "(כמבואר בכ\"מ27),"
        },
        {
          "s": 30,
          "text": "והעבודה בשלימות היא למעלה מזה."
        }
      ]
    }
  ]
}