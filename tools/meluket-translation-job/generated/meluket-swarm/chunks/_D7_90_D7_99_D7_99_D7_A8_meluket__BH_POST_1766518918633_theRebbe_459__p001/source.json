{
  "globalIndex": 811,
  "owner": 11,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918633_theRebbe_459__p001",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918633_theRebbe_459__p001",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918633_theRebbe_459",
  "title": "מאמר בחודש השלישי תשכ\"ט",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ במדבר,"
        },
        {
          "s": 2,
          "text": "מבה\"ח וער\"ח סיון,"
        },
        {
          "s": 3,
          "text": "ה'תשכ\"ט"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "בחודש השלישי לצאת בני ישראל מארץ מצרים ביום הזה באו מדבר סיני1,"
        },
        {
          "s": 1,
          "text": "ואיתא בגמרא2,"
        },
        {
          "s": 2,
          "text": "כתיב הכא ביום הזה באו מדבר סיני וכתיב התם3"
        },
        {
          "s": 3,
          "text": "החודש הזה לכם ראש חדשים,"
        },
        {
          "s": 4,
          "text": "מה להלן ראש חודש אף כאן ראש חודש."
        },
        {
          "s": 5,
          "text": "והקשו בתוספות4,"
        },
        {
          "s": 6,
          "text": "דבמס' פסחים5"
        },
        {
          "s": 7,
          "text": "איתא"
        },
        {
          "s": 8,
          "text": "(עה\"פ6"
        },
        {
          "s": 9,
          "text": "וידבר ה' אל משה במדבר סיני בשנה השנית גו' בחודש הראשון),"
        },
        {
          "s": 10,
          "text": "אתיא מדבר ממדבר,"
        },
        {
          "s": 11,
          "text": "כתיב הכא במדבר סיני וכתיב התם7"
        },
        {
          "s": 12,
          "text": "וידבר ה' אל משה במדבר סיני באוהל מועד באחד לחודש השני,"
        },
        {
          "s": 13,
          "text": "מה להלן בר\"ח אף כאן בר\"ח,"
        },
        {
          "s": 14,
          "text": "וכיון שגם בפסוק בחודש השלישי כתיב מדבר,"
        },
        {
          "s": 15,
          "text": "אמאי לא יליף הכא מדבר ממדבר."
        },
        {
          "s": 16,
          "text": "וצריך להבין,"
        },
        {
          "s": 17,
          "text": "דלכאורה,"
        },
        {
          "s": 18,
          "text": "הילפותא מהגז\"ש הזה הזה מגלה שפירוש ביום הזה הוא בר\"ח,"
        },
        {
          "s": 19,
          "text": "משא\"כ באם היו למדין מהגז\"ש מדבר מדבר"
        },
        {
          "s": 20,
          "text": "[שהלימוד הוא רק שהענין שנאמר בכתוב"
        },
        {
          "s": 21,
          "text": "(באו מדבר סיני)"
        },
        {
          "s": 22,
          "text": "הי' בר\"ח]"
        },
        {
          "s": 23,
          "text": "לא הי' מובן הפירוש דביום הזה"
        },
        {
          "s": 24,
          "text": "[ועוד יתרון בהגז\"ש הזה הזה על הגז\"ש מדבר מדבר,"
        },
        {
          "s": 25,
          "text": "כי החודש הזה פירושו הוא ר\"ח8,"
        },
        {
          "s": 26,
          "text": "משא\"כ מדבר סיני ואחד לחודש"
        },
        {
          "s": 27,
          "text": "(ר\"ח)"
        },
        {
          "s": 28,
          "text": "הם שני ענינים]9,"
        },
        {
          "s": 29,
          "text": "ומהי סברת התוספות דהוה לי' למילף מדבר ממדבר10."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויובן זה ע\"פ המבואר בתו\"א ד\"ה זה11,"
        },
        {
          "s": 2,
          "text": "דעיקר12"
        },
        {
          "s": 3,
          "text": "קבלת התורה הוא כמ\"ש"
        },
        {
          "s": 4,
          "text": "(בהתחלת הענין דמ\"ת13)"
        },
        {
          "s": 5,
          "text": "וידבר אלקים את כל הדברים האלה לאמר,"
        },
        {
          "s": 6,
          "text": "דפירוש תיבת לאמר בפסוק זה הוא שבשעת מתן תורה ניתן הכח לכל אחד מישראל,"
        },
        {
          "s": 7,
          "text": "שלימוד התורה שלו"
        },
        {
          "s": 8,
          "text": "[כל הדברים האלה,"
        },
        {
          "s": 9,
          "text": "שקאי גם על כל התורה כולה14]"
        },
        {
          "s": 10,
          "text": "יהי' באופן דלאמר,"
        },
        {
          "s": 11,
          "text": "לחזור הדברים שהקב\"ה אומר,"
        },
        {
          "s": 12,
          "text": "כמ\"ש15"
        },
        {
          "s": 13,
          "text": "תען לשוני אמרתך,"
        },
        {
          "s": 14,
          "text": "שהתורה היא אמרתך,"
        },
        {
          "s": 15,
          "text": "שלשוני תען כעונה אחר האומר."
        },
        {
          "s": 16,
          "text": "וזוהי השייכות דמתן תורה לחג השבועות,"
        },
        {
          "s": 17,
          "text": "דבחג השבועות הוא המשכת הכתר"
        },
        {
          "s": 18,
          "text": "[וכידוע16"
        },
        {
          "s": 19,
          "text": "בפירוש הכתוב17"
        },
        {
          "s": 20,
          "text": "תספרו חמישים יום,"
        },
        {
          "s": 21,
          "text": "שבחג השבועות נמשך שער הנו\"ן דבינה,"
        },
        {
          "s": 22,
          "text": "ושער הנו\"ן הוא הכתר18],"
        },
        {
          "s": 23,
          "text": "וזה שבמ\"ת ניתן הכח שלימוד התורה דישראל יהי' בתכלית הביטול,"
        },
        {
          "s": 24,
          "text": "שאינו מציאות לעצמו כלל והוא רק כעונה אחר הקורא,"
        },
        {
          "s": 25,
          "text": "הוא לפי שבמ\"ת נמשך גילוי הכתר."
        }
      ]
    }
  ]
}