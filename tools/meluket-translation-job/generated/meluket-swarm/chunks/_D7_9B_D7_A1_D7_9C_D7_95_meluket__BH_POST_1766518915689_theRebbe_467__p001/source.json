{
  "globalIndex": 339,
  "owner": 39,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915689_theRebbe_467__p001",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915689_theRebbe_467__p001",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915689_theRebbe_467",
  "title": "הוספה משיחות ש\"פ וישב-מקץ תשכ\"ו",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "– הוספה –"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": ".."
        },
        {
          "s": 1,
          "text": "בהמאמר ד\"ה פדה בשלום"
        },
        {
          "s": 2,
          "text": "(שנאמר בהתוועדות די\"ט כסלו תשכ\"ו1)"
        },
        {
          "s": 3,
          "text": "ישנם שני דיוקים שלא נתבארו בהמאמר."
        },
        {
          "s": 4,
          "text": "והם:"
        },
        {
          "s": 5,
          "text": "(א)"
        },
        {
          "s": 6,
          "text": "מה שמחלק תורה גמ\"ח ותפלה בצבור – לשתי חלוקות."
        },
        {
          "s": 7,
          "text": "(ב)"
        },
        {
          "s": 8,
          "text": "דיוק הלשון \"כל העוסק כו'\","
        },
        {
          "s": 9,
          "text": "היינו שמדבר כאן באדם העוסק בתורה כו' ולא בענין התורה גמ\"ח ותפלה בצבור עצמם"
        },
        {
          "s": 10,
          "text": "(כלשון המשנה באבות: על שלשה דברים העולם עומד על התורה ועל העבודה ועל גמ\"ח)."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "א."
        },
        {
          "s": 1,
          "text": "והנה הביאור בדיוק הראשון יובן בהקדם טעם הסדר של ג' ענינים אלו: תורה,"
        },
        {
          "s": 2,
          "text": "גמ\"ח ותפלה."
        },
        {
          "s": 3,
          "text": "דלכאורה הוצרך להקדים תפלה"
        },
        {
          "s": 4,
          "text": "(בצבור)"
        },
        {
          "s": 5,
          "text": "לתורה וגמ\"ח,"
        },
        {
          "s": 6,
          "text": "שהרי עיקר זמן ת\"ת2"
        },
        {
          "s": 7,
          "text": "ומעלת לימוד התורה הוא כשהיא באה לאחרי התפלה דוקא,"
        },
        {
          "s": 8,
          "text": "וכידוע בענין שתהא תפלתי סמוכה למטתי3."
        },
        {
          "s": 9,
          "text": "וכן גמ\"ח היא לאחרי התפלה ולימוד התורה,"
        },
        {
          "s": 10,
          "text": "וכהפס\"ד4"
        },
        {
          "s": 11,
          "text": "– מביהכנ\"ס"
        },
        {
          "s": 12,
          "text": "(תפלה)"
        },
        {
          "s": 13,
          "text": "לביהמ\"ד"
        },
        {
          "s": 14,
          "text": "(תורה)"
        },
        {
          "s": 15,
          "text": "ואח\"כ ילך לעסקיו – ינהג בהם דרך ארץ"
        },
        {
          "s": 16,
          "text": "(שאז היא העבודה דגמ\"ח)."
        }
      ]
    }
  ]
}