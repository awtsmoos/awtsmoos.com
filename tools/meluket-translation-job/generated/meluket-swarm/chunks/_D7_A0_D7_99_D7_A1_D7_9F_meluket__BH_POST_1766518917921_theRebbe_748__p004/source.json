{
  "globalIndex": 709,
  "owner": 9,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917921_theRebbe_748__p004",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917921_theRebbe_748__p004",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917921_theRebbe_748",
  "title": "מאמר ונחה עליו רוח ה' תשי\"ד",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "והנה ידוע44"
        },
        {
          "s": 2,
          "text": "דהאור"
        },
        {
          "s": 3,
          "text": "(קודם שנתגלה)"
        },
        {
          "s": 4,
          "text": "הי' כלול בעצמות המאור ממש."
        },
        {
          "s": 5,
          "text": "אלא שבהיותו כלול בהמאור,"
        },
        {
          "s": 6,
          "text": "אינו בבחי' אור כלל ורק מה שביכלתו להאיר."
        },
        {
          "s": 7,
          "text": "ועפ\"ז צריך לומר,"
        },
        {
          "s": 8,
          "text": "דשתי המדריגות הנ\"ל בהאור שבבחי' גילוי"
        },
        {
          "s": 9,
          "text": "(שלפני הצמצום),"
        },
        {
          "s": 10,
          "text": "יש להם שרש גם באור הכלול."
        },
        {
          "s": 11,
          "text": "ונקודת הביאור בזה,"
        },
        {
          "s": 12,
          "text": "דזה שהעצמות ביכלתו להאיר,"
        },
        {
          "s": 13,
          "text": "אין זה ענין פרטי ח\"ו"
        },
        {
          "s": 14,
          "text": "(מקור לאור),"
        },
        {
          "s": 15,
          "text": "כי אם,"
        },
        {
          "s": 16,
          "text": "זה שהוא ית' כל יכול,"
        },
        {
          "s": 17,
          "text": "דמזה מובן,"
        },
        {
          "s": 18,
          "text": "דבהיכולת להאיר"
        },
        {
          "s": 19,
          "text": "(כמו שהוא בהעצמות)"
        },
        {
          "s": 20,
          "text": "יש גם היכולת שלא להאיר."
        },
        {
          "s": 21,
          "text": "ושניהם"
        },
        {
          "s": 22,
          "text": "(זה שביכלתו להאיר וזה שביכלתו שלא להאיר)"
        },
        {
          "s": 23,
          "text": "הם ענין אחד45."
        },
        {
          "s": 24,
          "text": "ומכיון שהאור הכלול בעצמותו הוא זה שהעצמות ביכלתו להאיר"
        },
        {
          "s": 25,
          "text": "(כנ\"ל),"
        },
        {
          "s": 26,
          "text": "דביכולת זו יש גם היכולת שלא להאיר,"
        },
        {
          "s": 27,
          "text": "לכן,"
        },
        {
          "s": 28,
          "text": "גם כמו שהאור נמשך בגילוי,"
        },
        {
          "s": 29,
          "text": "יש בו שני הענינים דהעלם וגילוי,"
        },
        {
          "s": 30,
          "text": "למעלה משייכות לעולמות ושייכות לעולמות,"
        },
        {
          "s": 31,
          "text": "שהם השרש דסובב וממלא שלאחרי הצמצום,"
        },
        {
          "s": 32,
          "text": "שמהם נעשה המעלה ומטה שבעולמות."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "וזהו ונחה עליו רוח הוי' גו',"
        },
        {
          "s": 3,
          "text": "דהנה ידוע שהחידוש דמשיח הוא שעל ידו יתאחדו ב' הענינים דמעלה ומטה."
        },
        {
          "s": 4,
          "text": "והתחלת החיבור דמעלה ומטה הי' בעת קריעת ים סוף,"
        },
        {
          "s": 5,
          "text": "אלא שאז הי' זה רק לפי שעה,"
        },
        {
          "s": 6,
          "text": "וזה הי' הכנה למתן תורה,"
        },
        {
          "s": 7,
          "text": "עליונים ירדו למטה ותחתונים יעלו למעלה46."
        },
        {
          "s": 8,
          "text": "ואמיתית החיבור דמעלה ומטה יהי' בימות המשיח."
        },
        {
          "s": 9,
          "text": "וכדאיתא במדרש תהלים עה\"פ47"
        },
        {
          "s": 10,
          "text": "מי יתן מציון גו',"
        },
        {
          "s": 11,
          "text": "את מוצא שני פעמים כתוב בספר תהלים מי יתן מציון,"
        },
        {
          "s": 12,
          "text": "אחד בספר ראשון47"
        },
        {
          "s": 13,
          "text": "ואחד בספר שני48,"
        },
        {
          "s": 14,
          "text": "הרב אמר אחד והתלמיד אמר אחד,"
        },
        {
          "s": 15,
          "text": "הרב אמר מי יתן והי' לבבם זה להם49"
        },
        {
          "s": 16,
          "text": "והתלמיד אמר ומי יתן כל עם ה' נביאים50,"
        },
        {
          "s": 17,
          "text": "לא דברי הרב ולא דברי התלמיד מתקיימין בעולם הזה,"
        },
        {
          "s": 18,
          "text": "אבל לעולם הבא שניהם מתקיימין,"
        },
        {
          "s": 19,
          "text": "דברי הרב מנין שנאמר51"
        },
        {
          "s": 20,
          "text": "ונתתי לכם לב חדש,"
        },
        {
          "s": 21,
          "text": "דברי התלמיד מנין שנאמר52"
        },
        {
          "s": 22,
          "text": "והי' אחרי כן אשפוך את רוחי על כל בשר."
        },
        {
          "s": 23,
          "text": "דזה שלב האדם הגשמי יהי' ליראה אותי גו' כל הימים49"
        },
        {
          "s": 24,
          "text": "הוא שהמטה יתחבר עם המעלה,"
        },
        {
          "s": 25,
          "text": "וזה שאשפוך את רוחי על כל בשר הוא שהמעלה יתחבר עם המטה."
        },
        {
          "s": 26,
          "text": "וזה שלע\"ל יהי' החיבור דמעלה ומטה"
        },
        {
          "s": 27,
          "text": "[בשני האופנים,"
        },
        {
          "s": 28,
          "text": "שהמטה יתעלה למעלה ושהמעלה יומשך למטה]"
        },
        {
          "s": 29,
          "text": "הוא כי אז יהיו שניהם"
        },
        {
          "s": 30,
          "text": "(המעלה והמטה)"
        },
        {
          "s": 31,
          "text": "כמו שהם מצד יכולת העצמות,"
        },
        {
          "s": 32,
          "text": "שביכלתו להאיר וביכלתו שלא להאיר."
        },
        {
          "s": 33,
          "text": "ומכיון שהיכולת להאיר והיכולת שלא להאיר הם ענין אחד"
        },
        {
          "s": 34,
          "text": "(כנ\"ל סעיף ט),"
        },
        {
          "s": 35,
          "text": "לכן,"
        },
        {
          "s": 36,
          "text": "גם המעלה ומטה"
        },
        {
          "s": 37,
          "text": "(כשיתגלה בהם שרשם הראשון,"
        },
        {
          "s": 38,
          "text": "כמו שהם בהיכולת),"
        },
        {
          "s": 39,
          "text": "יתחברו ויתאחדו כאחד."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "וזהו ונחה עליו רוח הוי',"
        },
        {
          "s": 1,
          "text": "רוח הוא אור א\"ס כמו שהוא כלול בעצמות המאור,"
        },
        {
          "s": 2,
          "text": "שהוא יכולת העצמות."
        },
        {
          "s": 3,
          "text": "וע\"י הגילוי דרוח הוי' שיהי' במשיח,"
        },
        {
          "s": 4,
          "text": "תהי' התאחדות גם בהענינים הפרטיים."
        },
        {
          "s": 5,
          "text": "וזהו שממשיך בכתוב רוח חכמה ובינה רוח עצה וגבורה רוח דעת ויראת הוי',"
        },
        {
          "s": 6,
          "text": "דחכמה ובינה הם שני ענינים הפכיים,"
        },
        {
          "s": 7,
          "text": "ואעפ\"כ יתאחדו כאחד"
        },
        {
          "s": 8,
          "text": "[שלכן נכללים ברוח אחד,"
        },
        {
          "s": 9,
          "text": "רוח חכמה ובינה],"
        },
        {
          "s": 10,
          "text": "כי בהחכמה ובינה דמשיח יהי' ניכר בגילוי שהם נמשכים משרשם רוח הוי'"
        },
        {
          "s": 11,
          "text": "(רוח חכמה ובינה),"
        },
        {
          "s": 12,
          "text": "ולכן יתאחדו כאחד53."
        },
        {
          "s": 13,
          "text": "[ועד\"ז הוא בנוגע לעצה וגבורה,"
        },
        {
          "s": 14,
          "text": "דעת ויראה,"
        },
        {
          "s": 15,
          "text": "שעם היותם הפכיים,"
        },
        {
          "s": 16,
          "text": "יתאחדו כאחד54]."
        },
        {
          "s": 17,
          "text": "וזהו גם הקשר דרוח חכמה ובינה עם ושפט בצדק דלים,"
        },
        {
          "s": 18,
          "text": "אף שהמשפט דמשיח יהי' ע\"פ הריח,"
        },
        {
          "s": 19,
          "text": "דריח הוא מקיף55,"
        },
        {
          "s": 20,
          "text": "כי במשיח,"
        },
        {
          "s": 21,
          "text": "המקיף"
        },
        {
          "s": 22,
          "text": "(ריח)"
        },
        {
          "s": 23,
          "text": "והפנימי"
        },
        {
          "s": 24,
          "text": "(חכמה ובינה)"
        },
        {
          "s": 25,
          "text": "יתאחדו כאחד."
        },
        {
          "s": 26,
          "text": "וזהו גם מה שממשיך56"
        },
        {
          "s": 27,
          "text": "וגר זאב עם כבש וגו',"
        },
        {
          "s": 28,
          "text": "שהחיבור דמעלה ומטה יהי' לא רק במשיח עצמו,"
        },
        {
          "s": 29,
          "text": "אלא שע\"י משיח יהי'"
        },
        {
          "s": 30,
          "text": "(דוגמת)"
        },
        {
          "s": 31,
          "text": "ענין זה גם בכל העולם,"
        },
        {
          "s": 32,
          "text": "עד וגר זאב עם כבש וגו',"
        },
        {
          "s": 33,
          "text": "ועד בסוג הדומם,"
        },
        {
          "s": 34,
          "text": "וכמו שממשיך בכתוב57"
        },
        {
          "s": 35,
          "text": "כי מלאה הארץ דיעה את הוי',"
        },
        {
          "s": 36,
          "text": "שגם הארץ הגשמיית"
        },
        {
          "s": 37,
          "text": "(דומם)"
        },
        {
          "s": 38,
          "text": "תהי' מלאה דיעה את הוי',"
        },
        {
          "s": 39,
          "text": "בביאת משיח צדקנו בקרוב ממש."
        }
      ]
    }
  ]
}