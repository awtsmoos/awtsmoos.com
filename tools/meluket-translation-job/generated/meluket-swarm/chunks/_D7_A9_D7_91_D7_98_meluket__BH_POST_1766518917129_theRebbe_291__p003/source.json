{
  "globalIndex": 590,
  "owner": 40,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917129_theRebbe_291__p003",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917129_theRebbe_291__p003",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518917129_theRebbe_291",
  "title": "מאמר כי תשא תשל\"א",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יש לומר דבאמירת הקב\"ה למשה כי תשא את ראש בני ישראל,"
        },
        {
          "s": 2,
          "text": "שני ענינים."
        },
        {
          "s": 3,
          "text": "שישא ויגבי' את ראש בני ישראל,"
        },
        {
          "s": 4,
          "text": "כמפורש בקרא."
        },
        {
          "s": 5,
          "text": "ועוד ענין"
        },
        {
          "s": 6,
          "text": "(שאינו מפורש בתושב\"כ אלא נתגלה בתושבע\"פ),"
        },
        {
          "s": 7,
          "text": "שע\"י כי תשא את ראש בני ישראל תהי' גם הרמת קרן ישראל"
        },
        {
          "s": 8,
          "text": "[וכלשון הגמרא אמר לו ב."
        },
        {
          "s": 9,
          "text": "כי תשא,"
        },
        {
          "s": 10,
          "text": "שע\"י כי תשא יהי' עוד ענין]."
        },
        {
          "s": 11,
          "text": "ועפ\"ז יש לבאר מ\"ש רש\"י אם באת לשאת ראשם בהגבהה קח מהם כופר לצדקה,"
        },
        {
          "s": 12,
          "text": "ולא יתנו כופר לצדקה,"
        },
        {
          "s": 13,
          "text": "כלשון הכתוב ונתנו איש כופר נפשו,"
        },
        {
          "s": 14,
          "text": "כי נשיאת והגבהת ראש בני ישראל הוא ע\"י נתינת כופר – ונתנו איש כופר נפשו."
        },
        {
          "s": 15,
          "text": "ובכדי שהנשיאת ראש תביא להרמת קרן ישראל הוא כשהנשיאת והגבהת הראש היא ע\"י שמשה יקח מהם כופר – אם באת לשאת ראשם בהגבהה קח מהם כופר לצדקה."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים מ\"ש"
        },
        {
          "s": 2,
          "text": "(בפרשתנו16)"
        },
        {
          "s": 3,
          "text": "אם כסף תלוה את עמי,"
        },
        {
          "s": 4,
          "text": "ואיתא במדרש17"
        },
        {
          "s": 5,
          "text": "אמר הקב\"ה אם כסף תלוה את עמי"
        },
        {
          "s": 6,
          "text": "(עמי בחירי\"ק תחת העי\"ן),"
        },
        {
          "s": 7,
          "text": "ומבואר בהדרושים18,"
        },
        {
          "s": 8,
          "text": "דזה שמעלת הגמ\"ח היא גדולה כ\"כ עד שעי\"ז אתה עמי,"
        },
        {
          "s": 9,
          "text": "עמי במחיצתי19,"
        },
        {
          "s": 10,
          "text": "הוא כמ\"ש20"
        },
        {
          "s": 11,
          "text": "כי חסד חפצתי ולא זבח,"
        },
        {
          "s": 12,
          "text": "דהגם שגם הקרבנות"
        },
        {
          "s": 13,
          "text": "(זבח)"
        },
        {
          "s": 14,
          "text": "הם רצונו ית'"
        },
        {
          "s": 15,
          "text": "[כמובן גם מזה שישנם כו\"כ ציוויים להקריב קרבנות],"
        },
        {
          "s": 16,
          "text": "מ\"מ,"
        },
        {
          "s": 17,
          "text": "כיון שענין הקרבנות הוא העלאה מלמטה למעלה,"
        },
        {
          "s": 18,
          "text": "ותכלית הכוונה הוא שיהי' המשכת גילוי אלקות למטה,"
        },
        {
          "s": 19,
          "text": "דנתאוה הקב\"ה להיות לו ית' דירה בתחתונים21,"
        },
        {
          "s": 20,
          "text": "לכן,"
        },
        {
          "s": 21,
          "text": "הרצון בקרבנות הוא"
        },
        {
          "s": 22,
          "text": "(לא בהקרבנות מצד עצמם,"
        },
        {
          "s": 23,
          "text": "אלא)"
        },
        {
          "s": 24,
          "text": "בשביל ההמשכה שתהי' אח\"כ ע\"י הנסכים"
        },
        {
          "s": 25,
          "text": "[כדאיתא בגמרא22"
        },
        {
          "s": 26,
          "text": "כל הקורא ק\"ש בלא תפילין כאילו הקריב עולה בלא מנחה וזבח בלא נסכים23,"
        },
        {
          "s": 27,
          "text": "דמזה משמע שכשהקריב זבח בלא נסכים אין קרבנו כלום24,"
        },
        {
          "s": 28,
          "text": "ומבואר בלקו\"ת25"
        },
        {
          "s": 29,
          "text": "שזהו לפי שההעלאה דקרבנות היא בשביל ההמשכה שאח\"כ ע\"י הנסכים],"
        },
        {
          "s": 30,
          "text": "ולכן,"
        },
        {
          "s": 31,
          "text": "הרצון בקרבנות הוא"
        },
        {
          "s": 32,
          "text": "(כמו26)"
        },
        {
          "s": 33,
          "text": "חיצוניות הרצון"
        },
        {
          "s": 34,
          "text": "[ע\"ד27"
        },
        {
          "s": 35,
          "text": "אדם שרוצה לנסוע לאיזה מקום לקנות סחורה,"
        },
        {
          "s": 36,
          "text": "שהרצון שלו בהנסיעה הוא רק בשביל הריוח שיהי' לו עי\"ז],"
        },
        {
          "s": 37,
          "text": "ופנימיות הרצון הוא בהמשכה למטה."
        },
        {
          "s": 38,
          "text": "וזהו כי חסד חפצתי ולא זבח,"
        },
        {
          "s": 39,
          "text": "שהחפץ,"
        },
        {
          "s": 40,
          "text": "פנימיות הרצון,"
        },
        {
          "s": 41,
          "text": "הוא שיהי' חסד,"
        },
        {
          "s": 42,
          "text": "המשכה למטה."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ולהוסיף,"
        },
        {
          "s": 1,
          "text": "דמפשטות לשון הכתוב כי חסד חפצתי ולא זבח משמע שמדבר גם בזבח עם נסכים,"
        },
        {
          "s": 2,
          "text": "ואעפ\"כ אומר חסד חפצתי ולא זבח,"
        },
        {
          "s": 3,
          "text": "כי כיון שהנסכים הם טפלים להזבח,"
        },
        {
          "s": 4,
          "text": "גם ההמשכה שע\"י הנסכים אינה כההמשכה שע\"י חסד."
        },
        {
          "s": 5,
          "text": "וכמוכח גם ממארז\"ל28"
        },
        {
          "s": 6,
          "text": "(המובא בהדרושים29)"
        },
        {
          "s": 7,
          "text": "עה\"פ30"
        },
        {
          "s": 8,
          "text": "אם יתכפר עון בית עלי בזבח ובמנחה,"
        },
        {
          "s": 9,
          "text": "בזבח ובמנחה אינו מתכפר אבל מתכפר בתורה ובגמילות חסדים,"
        },
        {
          "s": 10,
          "text": "שגם הכפרה דמנחה"
        },
        {
          "s": 11,
          "text": "(ועד\"ז נסכים)"
        },
        {
          "s": 12,
          "text": "אינה כהכפרה שע\"י תורה וגמ\"ח,"
        },
        {
          "s": 13,
          "text": "לפי שכללות ענין הקרבנות הוא העלאה,"
        },
        {
          "s": 14,
          "text": "אלא שבקרבנות עצמם – מנחה ונסכים הם המשכה למטה,"
        },
        {
          "s": 15,
          "text": "אבל ההמשכה שעל ידם אינה כההמשכה שע\"י תורה וגמ\"ח."
        },
        {
          "s": 16,
          "text": "ויתירה מזה,"
        },
        {
          "s": 17,
          "text": "שגם ההמשכה דתורה,"
        },
        {
          "s": 18,
          "text": "שנקראת תורת חסד31"
        },
        {
          "s": 19,
          "text": "לפי שענינה הוא המשכה למטה,"
        },
        {
          "s": 20,
          "text": "אינה כההמשכה שע\"י חסד."
        },
        {
          "s": 21,
          "text": "וכסיום מארז\"ל הנ\"ל28"
        },
        {
          "s": 22,
          "text": "רבה דעסיק בתורה חי מ' שנין אביי דעסיק בתורה ובגמילות חסדים חי ס' שנין."
        },
        {
          "s": 23,
          "text": "ולהעיר,"
        },
        {
          "s": 24,
          "text": "דענין זה שההמשכה שע\"י גמ\"ח היא המשכה למטה יותר"
        },
        {
          "s": 25,
          "text": "(מההמשכה שע\"י מנחה ונסכים וגם)"
        },
        {
          "s": 26,
          "text": "מההמשכה שע\"י תורה,"
        },
        {
          "s": 27,
          "text": "הוא בכללות בכל המצוות32,"
        },
        {
          "s": 28,
          "text": "דגמ\"ח היא כללות כל המצוות33."
        },
        {
          "s": 29,
          "text": "אבל אעפ\"כ,"
        },
        {
          "s": 30,
          "text": "עיקר המעלה דהמשכה למטה ביותר היא בגמ\"ח כפשוטה."
        },
        {
          "s": 31,
          "text": "וכמובן גם מהמשך הענינים בהדרושים הנ\"ל,"
        },
        {
          "s": 32,
          "text": "דענין חסד חפצתי ולא זבח הוא ביאור על המעלה דאם כסף תלוה,"
        },
        {
          "s": 33,
          "text": "גמ\"ח כפשוטה."
        },
        {
          "s": 34,
          "text": "וכן מובן מהמבואר בדרושים הנ\"ל34"
        },
        {
          "s": 35,
          "text": "הטעם על זה שגמ\"ח היא מהדברים שאדם אוכל פירותיהם בעולם הזה35,"
        },
        {
          "s": 36,
          "text": "כי ההמשכה שע\"י גמ\"ח היא נמשכת עד למטה מטה,"
        },
        {
          "s": 37,
          "text": "גם בעולם הזה."
        }
      ]
    }
  ]
}