{
  "globalIndex": 869,
  "owner": 19,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918894_theRebbe_986__p004",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918894_theRebbe_986__p004",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918894_theRebbe_986",
  "title": "מאמר בהעלותך את הנרות תשל\"ד",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה כמו שלהפירוש דבהעלותך את הנרות קאי על הנשמות,"
        },
        {
          "s": 2,
          "text": "עיקר העלי' שלהם הוא גילוי שרשם כמו שהם מושרשות בהעצמות,"
        },
        {
          "s": 3,
          "text": "עד\"ז הוא גם להפירוש דבהעלותך את הנרות קאי על המצוות,"
        },
        {
          "s": 4,
          "text": "שהעלי' שלהם היא שנמשך בהם מהעצמות."
        },
        {
          "s": 5,
          "text": "דע\"י שישראל מקיימים את המצוות,"
        },
        {
          "s": 6,
          "text": "שהשרש דנש\"י הוא בהעצמות,"
        },
        {
          "s": 7,
          "text": "ממשיכים זה גם בהמצוות."
        },
        {
          "s": 8,
          "text": "דזה שנת\"ל שע\"י קיום המצוות באים לאהוי\"ר,"
        },
        {
          "s": 9,
          "text": "היינו שהמצוות הם למעלה מהאדם המקיימם והם משפיעים בו שיבוא לאהוי\"ר,"
        },
        {
          "s": 10,
          "text": "אהוי\"ר שלמעלה מטעם ודעת שאין ביכלתו להגיע אליהם ע\"י עבודה"
        },
        {
          "s": 11,
          "text": "(התבוננות)"
        },
        {
          "s": 12,
          "text": "ונמשכים מלמעלה ע\"י המצוות,"
        },
        {
          "s": 13,
          "text": "הוא בתחלת העבודה."
        },
        {
          "s": 14,
          "text": "אבל לאחרי שמגיע לאהוי\"ר אלו,"
        },
        {
          "s": 15,
          "text": "דרגא הראשונה דפני"
        },
        {
          "s": 16,
          "text": "(פנימיות)"
        },
        {
          "s": 17,
          "text": "המנורה,"
        },
        {
          "s": 18,
          "text": "מתגלה בו שרש הנשמה כמו שמושרשת בהעצמות,"
        },
        {
          "s": 19,
          "text": "דרגא השני' דפני המנורה,"
        },
        {
          "s": 20,
          "text": "בחי' על פני,"
        },
        {
          "s": 21,
          "text": "הקב\"ה,"
        },
        {
          "s": 22,
          "text": "וענין זה הוא ממשיך גם בהמצוות41,"
        },
        {
          "s": 23,
          "text": "כמאמר רז\"ל42"
        },
        {
          "s": 24,
          "text": "עה\"פ43"
        },
        {
          "s": 25,
          "text": "מגיד דבריו ליעקב חוקיו ומשפטיו לישראל,"
        },
        {
          "s": 26,
          "text": "מה שהוא עושה הוא אומר לישראל לעשות,"
        },
        {
          "s": 27,
          "text": "וידוע הפירוש בזה44,"
        },
        {
          "s": 28,
          "text": "דע\"י שישראל עושים ומקיימים את המצוות,"
        },
        {
          "s": 29,
          "text": "עי\"ז גורמים שהקב\"ה יעשה מצוות אלו45."
        },
        {
          "s": 30,
          "text": "[וע\"ד הידוע46"
        },
        {
          "s": 31,
          "text": "בנוגע לתורה,"
        },
        {
          "s": 32,
          "text": "דלאחרי שישראל מתקשרין באורייתא ועל ידה בקוב\"ה,"
        },
        {
          "s": 33,
          "text": "מתגלה השרש דישראל שלמעלה מהשרש דתורה,"
        },
        {
          "s": 34,
          "text": "ולאחרי שמתגלה השרש דישראל בעצמותו ית',"
        },
        {
          "s": 35,
          "text": "הם ממשיכים זה גם בתורה,"
        },
        {
          "s": 36,
          "text": "ע\"ד דוד הי' מחבר תורה שלמעלה בקוב\"ה47]."
        },
        {
          "s": 37,
          "text": "ויש לומר,"
        },
        {
          "s": 38,
          "text": "דזהו מ\"ש הה\"מ"
        },
        {
          "s": 39,
          "text": "(הובא לעיל)"
        },
        {
          "s": 40,
          "text": "דפירוש בהעלותך את הנרות הוא עם הנרות,"
        },
        {
          "s": 41,
          "text": "בהעלותך את עצמך עם המצוות,"
        },
        {
          "s": 42,
          "text": "שהכוונה בזה היא,"
        },
        {
          "s": 43,
          "text": "שהאדם מעלה את המצוות להמקום שהוא עצמו עולה לשם,"
        },
        {
          "s": 44,
          "text": "דרגא השני' דפני המנורה,"
        },
        {
          "s": 45,
          "text": "בחינת על פני."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ויש להוסיף,"
        },
        {
          "s": 2,
          "text": "דכמו שלפי פשטות הכתוב,"
        },
        {
          "s": 3,
          "text": "אל מול פני המנורה נמשך ליאירו שבעת הנרות,"
        },
        {
          "s": 4,
          "text": "עד\"ז הוא בפנימיות הענינים,"
        },
        {
          "s": 5,
          "text": "דאל מול פני המנורה שקאי על בחינת על פני,"
        },
        {
          "s": 6,
          "text": "בא בהמשך נוסף על בהעלותך את הנרות שקאי על הנשמות,"
        },
        {
          "s": 7,
          "text": "גם ליאירו שבעת הנרות."
        },
        {
          "s": 8,
          "text": "דזה שע\"י העבודה דישראל ניתוסף אור בהמאורות"
        },
        {
          "s": 9,
          "text": "(ע\"ד שרה הוסיפה על המאורות)"
        },
        {
          "s": 10,
          "text": "הוא נוסף על שנתמלא החסרון שנעשה ע\"י מיעוט הירח,"
        },
        {
          "s": 11,
          "text": "גם נעשה בהם תוספות עילוי לגבי דרגתם כמו שהיו שני המאורות הגדולים."
        },
        {
          "s": 12,
          "text": "דהגם שעולם על מילואו נברא48,"
        },
        {
          "s": 13,
          "text": "מ\"מ,"
        },
        {
          "s": 14,
          "text": "ע\"י עבודת האדם נעשה עלי' בהעולם למעלה יותר גם מכמו שהי' בתחלת בריאתו"
        },
        {
          "s": 15,
          "text": "[במכ\"ש מזה שע\"י העבודה נעשית עלי' בהמצוות ואפילו בהנשמות],"
        },
        {
          "s": 16,
          "text": "שהעולם נעשה דירה לו ית'49,"
        },
        {
          "s": 17,
          "text": "לו לעצמותו50."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וע\"י העבודה דבהעלותך את הנרות גו' יאירו שבעת הנרות בכל הענינים דלעיל,"
        },
        {
          "s": 2,
          "text": "מקרבים וממהרים את היעוד51"
        },
        {
          "s": 3,
          "text": "דלילה כיום יאיר,"
        },
        {
          "s": 4,
          "text": "בגאולה האמיתית והשלימה ע\"י משיח צדקנו."
        },
        {
          "s": 5,
          "text": "וגם לפני זה,"
        },
        {
          "s": 6,
          "text": "בימים האחרונים דחושך הגלות,"
        },
        {
          "s": 7,
          "text": "יהי' לכל בני ישראל אור במושבותם52,"
        },
        {
          "s": 8,
          "text": "ע\"י שכל אחד יוסיף אור וחיות בעבודתו,"
        },
        {
          "s": 9,
          "text": "וזה ימהר עוד יותר קיום היעוד דולילה כיום יאיר,"
        },
        {
          "s": 10,
          "text": "בביאת משיח צדקנו,"
        },
        {
          "s": 11,
          "text": "יבוא ויגאלנו ויוליכנו קוממיות לארצנו,"
        },
        {
          "s": 12,
          "text": "שאז תהי' העלי'"
        },
        {
          "s": 13,
          "text": "(בהעלותך)"
        },
        {
          "s": 14,
          "text": "בכל הענינים בתכלית השלימות,"
        },
        {
          "s": 15,
          "text": "בפנימיות ובחיצוניות גם יחד."
        }
      ]
    }
  ]
}