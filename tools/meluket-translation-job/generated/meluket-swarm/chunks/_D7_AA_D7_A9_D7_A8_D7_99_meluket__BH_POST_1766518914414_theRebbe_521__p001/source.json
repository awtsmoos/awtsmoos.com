{
  "globalIndex": 122,
  "owner": 22,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914414_theRebbe_521__p001",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914414_theRebbe_521__p001",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914414_theRebbe_521",
  "title": "מאמר הללו את ה' כל גוים תשל\"א",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "יום ב' דחג הסוכות,"
        },
        {
          "s": 2,
          "text": "תשל\"א"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "(הנחה)"
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "הללו את הוי' כל גוים שבחוהו כל האומים כי גבר עלינו חסדו ואמת הוי' לעולם הללוי'1."
        },
        {
          "s": 1,
          "text": "וצריך להבין,"
        },
        {
          "s": 2,
          "text": "מהו הטעם דכי גבר עלינו חסדו שבשביל זה יהללו וישבחו אותו הגוים והאומים,"
        },
        {
          "s": 3,
          "text": "וכמו שמקשה בגמרא פסחים2"
        },
        {
          "s": 4,
          "text": "אומות העולם מאי עבידתייהו."
        },
        {
          "s": 5,
          "text": "והנה רש\"י מפרש"
        },
        {
          "s": 6,
          "text": "(בתירוץ הגמרא שם),"
        },
        {
          "s": 7,
          "text": "דאף שגבר עלינו חסדו,"
        },
        {
          "s": 8,
          "text": "מ\"מ,"
        },
        {
          "s": 9,
          "text": "מכיון שזהו בגילוי שגם הם רואים זאת"
        },
        {
          "s": 10,
          "text": "(\"דחזיתו שעשה לי\"),"
        },
        {
          "s": 11,
          "text": "לכן עליהם להלל ולשבח."
        },
        {
          "s": 12,
          "text": "אמנם אין זה מספיק וכמש\"כ במאמר ד\"ה הללו את הוי' לרבינו הזקן3"
        },
        {
          "s": 13,
          "text": "ש\"אין זה טעם מספיק\"."
        },
        {
          "s": 14,
          "text": "שמלשון זה משמע ש\"כי גבר עלינו חסדו\" הוא טעם להללו את הוי' כל גוים גו'"
        },
        {
          "s": 15,
          "text": "(שמזה משמע שמפרש כפירוש רש\"י הנ\"ל),"
        },
        {
          "s": 16,
          "text": "אלא שאי\"ז טעם מספיק4."
        },
        {
          "s": 17,
          "text": "ולכן מפרש הרשב\"ם שם שכי גבר עלינו חסדו הו\"ע בפ\"ע,"
        },
        {
          "s": 18,
          "text": "וכי כאן פי' כש\"כ שהגוים והאומים עליהם להלל ולשבח על הגבורות ונפלאות שעשה בעולם,"
        },
        {
          "s": 19,
          "text": "וכ\"ש אנו שגבר עלינו חסדו יותר מכל אומה ולשון."
        }
      ]
    }
  ]
}