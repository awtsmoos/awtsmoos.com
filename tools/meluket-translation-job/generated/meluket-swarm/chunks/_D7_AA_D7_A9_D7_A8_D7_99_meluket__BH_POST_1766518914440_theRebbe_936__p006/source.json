{
  "globalIndex": 131,
  "owner": 31,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914440_theRebbe_936__p006",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914440_theRebbe_936__p006",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914440_theRebbe_936",
  "title": "מאמר תורה צוה תשכ\"ג",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "וצריך להבין,"
        },
        {
          "s": 1,
          "text": "דהענין דעצם הנשמה שמצד זה כל ישראל הם בשוה,"
        },
        {
          "s": 2,
          "text": "מודגש יותר"
        },
        {
          "s": 3,
          "text": "(לכאורה)"
        },
        {
          "s": 4,
          "text": "בהשם ישורון,"
        },
        {
          "s": 5,
          "text": "דישורון הוא מלשון שיר שאין בו ראש וסוף,"
        },
        {
          "s": 6,
          "text": "ואעפ\"כ השם ישורון שייך לענין מתנה"
        },
        {
          "s": 7,
          "text": "(דתורה)"
        },
        {
          "s": 8,
          "text": "ששייכת לרצון הנותן,"
        },
        {
          "s": 9,
          "text": "וגבי ירושה ששייכת להמוריש עצמו נאמר מורשה קהלת יעקב."
        },
        {
          "s": 10,
          "text": "ויובן זה בהקדים מ\"ש52"
        },
        {
          "s": 11,
          "text": "יבחר לנו את נחלתינו את גאון יעקב גו',"
        },
        {
          "s": 12,
          "text": "שאומר כאן שני ענינים."
        },
        {
          "s": 13,
          "text": "יבחר לנו,"
        },
        {
          "s": 14,
          "text": "ענין הבחירה,"
        },
        {
          "s": 15,
          "text": "ואת נחלתינו,"
        },
        {
          "s": 16,
          "text": "ענין הירושה."
        },
        {
          "s": 17,
          "text": "ויש לומר,"
        },
        {
          "s": 18,
          "text": "דענין הבחירה שהקב\"ה בחר בישראל הוא שבחר לרצות בהם."
        },
        {
          "s": 19,
          "text": "וענין הירושה שהיורש עומד במקום המוריש,"
        },
        {
          "s": 20,
          "text": "הוא,"
        },
        {
          "s": 21,
          "text": "שישראל מושרשים בהעצמות עצמו."
        },
        {
          "s": 22,
          "text": "והגם דענין הבחירה הוא מצד העצמות שאינו מוכרח בשום דבר ויכול לרצות ולא לרצות53,"
        },
        {
          "s": 23,
          "text": "מ\"מ,"
        },
        {
          "s": 24,
          "text": "ענין הבחירה הוא"
        },
        {
          "s": 25,
          "text": "(לא בנוגע לעצמות עצמו,"
        },
        {
          "s": 26,
          "text": "אלא)"
        },
        {
          "s": 27,
          "text": "בנוגע להרצון שלו,"
        },
        {
          "s": 28,
          "text": "דזה שבחר בישראל הוא שבחר לרצות בהם"
        },
        {
          "s": 29,
          "text": "[ועוד ענין בזה,"
        },
        {
          "s": 30,
          "text": "שגם הבחירה עצמה"
        },
        {
          "s": 31,
          "text": "(שהיא הסיבה להרצון)"
        },
        {
          "s": 32,
          "text": "היא הפלאת העצמות"
        },
        {
          "s": 33,
          "text": "(שאינו מוכרח בשום דבר ויכול לרצות ולא לרצות),"
        },
        {
          "s": 34,
          "text": "ולא העצמות עצמו54]."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש לבאר שבענין מתנה נאמר השם ישורון ובענין ירושה השם יעקב,"
        },
        {
          "s": 1,
          "text": "דמתנה היא שהיא מצד רצון הנותן"
        },
        {
          "s": 2,
          "text": "(כנ\"ל),"
        },
        {
          "s": 3,
          "text": "באה מצד הבחירה"
        },
        {
          "s": 4,
          "text": "(שבחר לרצות)."
        },
        {
          "s": 5,
          "text": "כמ\"ש בברכת התורה אשר בחר בנו מכל העמים"
        },
        {
          "s": 6,
          "text": "(ולכן)"
        },
        {
          "s": 7,
          "text": "ונתן לנו את תורתו."
        },
        {
          "s": 8,
          "text": "וכיון שענין הבחירה הוא הפלאת העצמות שאינו מוכרח בשום דבר,"
        },
        {
          "s": 9,
          "text": "לכן,"
        },
        {
          "s": 10,
          "text": "הכלי לזה הוא הענין דישורון מלשון שיר,"
        },
        {
          "s": 11,
          "text": "עיגול שאין בו ראש וסוף,"
        },
        {
          "s": 12,
          "text": "העילוי וההפלאה דעצם הנשמה שהיא למעלה מהתחלקות דראש וסוף."
        },
        {
          "s": 13,
          "text": "וענין הירושה,"
        },
        {
          "s": 14,
          "text": "שישראל מושרשים בהעצמות עצמו,"
        },
        {
          "s": 15,
          "text": "מתגלה בהשם יעקב,"
        },
        {
          "s": 16,
          "text": "שם העצם דישראל עצמם."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "דזה שבפסוק יבחר לנו את נחלתינו נאמר את גאון יעקב,"
        },
        {
          "s": 3,
          "text": "הוא מצד הענין דנחלתינו,"
        },
        {
          "s": 4,
          "text": "דענין הירושה שייך ליעקב."
        },
        {
          "s": 5,
          "text": "והבקשה יבחר לנו את נחלתינו,"
        },
        {
          "s": 6,
          "text": "היא,"
        },
        {
          "s": 7,
          "text": "שהענין דנחלתינו,"
        },
        {
          "s": 8,
          "text": "עצם הנשמה שמושרשת בהעצמות עצמו,"
        },
        {
          "s": 9,
          "text": "יומשך בגילוי55."
        },
        {
          "s": 10,
          "text": "וכמו שבראש השנה עיקר ההדגשה הוא נחלתינו את גאון יעקב אלא שמבקשים שענין זה יומשך בגילוי,"
        },
        {
          "s": 11,
          "text": "עד\"ז הוא בשמחת תורה,"
        },
        {
          "s": 12,
          "text": "שעיקר ההדגשה היא מורשה קהלת יעקב."
        },
        {
          "s": 13,
          "text": "ואומר קהלת יעקב,"
        },
        {
          "s": 14,
          "text": "שמצד הענין דיעקב,"
        },
        {
          "s": 15,
          "text": "כל ישראל הם מציאות אחת"
        },
        {
          "s": 16,
          "text": "(קהל),"
        },
        {
          "s": 17,
          "text": "ע\"ד שבראש השנה אתם נצבים גו' כולכם,"
        },
        {
          "s": 18,
          "text": "לאחדים כאחד56."
        },
        {
          "s": 19,
          "text": "וזהו שמצות היום"
        },
        {
          "s": 20,
          "text": "(דשמח\"ת)"
        },
        {
          "s": 21,
          "text": "הוא בריקודים,"
        },
        {
          "s": 22,
          "text": "דריקוד הוא ברגליים,"
        },
        {
          "s": 23,
          "text": "וברגליים עצמם – בהעקב שבהם"
        },
        {
          "s": 24,
          "text": "(יעקב מלשון עקב),"
        },
        {
          "s": 25,
          "text": "שכל ישראל שוים בזה."
        }
      ]
    }
  ]
}