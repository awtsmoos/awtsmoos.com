{
  "globalIndex": 141,
  "owner": 41,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914519_theRebbe_363__p001",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914519_theRebbe_363__p001",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914519_theRebbe_363",
  "title": "מאמר ביום השמיני עצרת תש\"מ",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "יום שמחת תורה ה'תש\"מ"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "ביום השמיני עצרת תהי' לכם1,"
        },
        {
          "s": 1,
          "text": "וידועים דיוקי רבותינו נשיאינו בזה,"
        },
        {
          "s": 2,
          "text": "הרי שמיני עצרת הוא רגל בפני עצמו לענין פז\"ר קש\"ב2,"
        },
        {
          "s": 3,
          "text": "וא\"כ הול\"ל בעשרים ושנים יום לחודש השביעי כמו בשאר המועדים שנאמר בהם ימי החודש"
        },
        {
          "s": 4,
          "text": "(ובחודש השביעי באחד לחודש,"
        },
        {
          "s": 5,
          "text": "ובעשור לחודש השביעי,"
        },
        {
          "s": 6,
          "text": "ובחמשה עשר יום לחודש השביעי3),"
        },
        {
          "s": 7,
          "text": "ולמה אומר ביום השמיני4."
        },
        {
          "s": 8,
          "text": "והגם ששמיני עצרת בא בהמשך לז' ימי הסוכות,"
        },
        {
          "s": 9,
          "text": "וידוע5"
        },
        {
          "s": 10,
          "text": "שבשמיני עצרת נעצרים ונקלטים הענינים דז' ימי הסוכות,"
        },
        {
          "s": 11,
          "text": "הרי בשמיני עצרת נעצרים ונקלטים גם הענינים דראש השנה ויום הכפורים6,"
        },
        {
          "s": 12,
          "text": "ואעפ\"כ אינו נקרא בשם כזה שיורה על שייכותו"
        },
        {
          "s": 13,
          "text": "(ושבא בהמשך)"
        },
        {
          "s": 14,
          "text": "לראש השנה ויום הכפורים,"
        },
        {
          "s": 15,
          "text": "ולמה נקרא השם שמיני"
        },
        {
          "s": 16,
          "text": "(עצרת)."
        },
        {
          "s": 17,
          "text": "ובפרט ע\"פ תורת הבעש\"ט7"
        },
        {
          "s": 18,
          "text": "דזה שמו אשר יקראו לו בלה\"ק מורה על תוכן הדבר,"
        },
        {
          "s": 19,
          "text": "ועד שמורה על חיותו וקיומו,"
        },
        {
          "s": 20,
          "text": "שמזה מובן,"
        },
        {
          "s": 21,
          "text": "שעיקר ענינו דשמיני עצרת"
        },
        {
          "s": 22,
          "text": "(שנקרא בשם שמיני עצרת)"
        },
        {
          "s": 23,
          "text": "הוא מה שבא בהמשך לז' ימי הסוכות."
        },
        {
          "s": 24,
          "text": "גם צריך להבין מ\"ש עצרת תהי' לכם,"
        },
        {
          "s": 25,
          "text": "ואיתא במדרש8"
        },
        {
          "s": 26,
          "text": "הה\"ד9"
        },
        {
          "s": 27,
          "text": "יהיו לך לבדך ואין לזרים אתך,"
        },
        {
          "s": 28,
          "text": "שיש בזה ב' ענינים."
        },
        {
          "s": 29,
          "text": "ענין דלך לבדך,"
        },
        {
          "s": 30,
          "text": "ישראל ומלכא בלחודוהי10,"
        },
        {
          "s": 31,
          "text": "אבל אעפ\"כ מזה גופא שצריך לשלול שאין לזרים אתך מובן שיש מקום לקס\"ד ששמיני עצרת הוא גם לזרים ולכן צריך לשלול ולומר שהוא רק לכם."
        },
        {
          "s": 32,
          "text": "גם צריך להבין מה ששמיני עצרת כולל גם שמחת תורה,"
        },
        {
          "s": 33,
          "text": "ועד שבארץ ישראל,"
        },
        {
          "s": 34,
          "text": "ארץ אשר גו' תמיד עיני ה' אלקיך בה מרשית השנה ועד אחרית שנה11,"
        },
        {
          "s": 35,
          "text": "שמיני עצרת ושמחת תורה הם ביום אחד,"
        },
        {
          "s": 36,
          "text": "וגם בחו\"ל שהם ב' ימים הרי שמחת תורה הוא ביו\"ט שני דשמיני עצרת,"
        },
        {
          "s": 37,
          "text": "וידוע הדיוק בזה מה שקבעו שמחת תורה בשמיני עצרת,"
        },
        {
          "s": 38,
          "text": "דלכאורה הוצרכו לעשות שמחת תורה בחג השבועות זמן מתן תורתנו12."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה בכ\"מ13"
        },
        {
          "s": 2,
          "text": "מבואר דזה שעושים שמחת תורה בשמיני עצרת הוא על לוחות האחרונות שניתנו ביום הכפורים14,"
        },
        {
          "s": 3,
          "text": "אבל זה גופא"
        },
        {
          "s": 4,
          "text": "(מה שהשמחה דשמחת תורה היא על לוחות האחרונות דוקא ולא על לוחות הראשונות)"
        },
        {
          "s": 5,
          "text": "צריך ביאור,"
        },
        {
          "s": 6,
          "text": "הרי עיקר הגילוי והשלימות דמ\"ת הי' בנתינת לוחות הראשונות דוקא,"
        },
        {
          "s": 7,
          "text": "הן בנוגע לישראל שהיו אז בתכלית השלימות,"
        },
        {
          "s": 8,
          "text": "דבמעמד הר סיני פסקה זוהמתן15,"
        },
        {
          "s": 9,
          "text": "והן בנוגע להעולם שהי' אז גילוי אוא\"ס ממש למטה כמ\"ש16"
        },
        {
          "s": 10,
          "text": "וירד ה' על הר סיני ותרגם ואתגלי,"
        },
        {
          "s": 11,
          "text": "וגילוי זה פעל בכל העולם17"
        },
        {
          "s": 12,
          "text": "כמרז\"ל18"
        },
        {
          "s": 13,
          "text": "צפור לא צווח עוף לא פרח שור לא געה,"
        },
        {
          "s": 14,
          "text": "ועד שהקול דעשרת הדברות הי' נשמע מכל ד' הרוחות ומלמעלה ומלמטה19,"
        },
        {
          "s": 15,
          "text": "אַז די וועלט"
        },
        {
          "s": 16,
          "text": "(וכל הו\"ק שבה)"
        },
        {
          "s": 17,
          "text": "האָט אויסגעשריען אנכי20"
        },
        {
          "s": 18,
          "text": "ה' אלקיך גו',"
        },
        {
          "s": 19,
          "text": "לא יהי' לך גו'."
        },
        {
          "s": 20,
          "text": "דכל זה הי' בלוחות הראשונות דוקא,"
        },
        {
          "s": 21,
          "text": "ולמה קבעו שמחת תורה בשמיני עצרת על לוחות האחרונות דוקא."
        },
        {
          "s": 22,
          "text": "ומה שמבואר בכ\"מ21"
        },
        {
          "s": 23,
          "text": "דזה שעושים שמחת תורה על לוחות האחרונות דוקא הוא מפני שבלוחות האחרונות כתיב ויגד לך תעלומות חכמה כי כפלים לתושי'22,"
        },
        {
          "s": 24,
          "text": "צריך ביאור,"
        },
        {
          "s": 25,
          "text": "דמכיון שענין הגילוי"
        },
        {
          "s": 26,
          "text": "(דמ\"ת)"
        },
        {
          "s": 27,
          "text": "בישראל ובעולם הי' בלוחות הראשונות דוקא כנ\"ל,"
        },
        {
          "s": 28,
          "text": "לכאורה צ\"ל השמחה דשמחת תורה שהיא בניגונים וריקודים"
        },
        {
          "s": 29,
          "text": "(ענין הגילוי)"
        },
        {
          "s": 30,
          "text": "בחג השבועות שבו ניתנו לוחות הראשונות בגילוי ובפרסום."
        },
        {
          "s": 31,
          "text": "ובפרט לפי המבואר23"
        },
        {
          "s": 32,
          "text": "בענין הריקודים"
        },
        {
          "s": 33,
          "text": "(דשמחת תורה)"
        },
        {
          "s": 34,
          "text": "שענין הריקודים הוא בעיקר בהרגלים,"
        },
        {
          "s": 35,
          "text": "ובהם גופא בהעקב שבהם,"
        },
        {
          "s": 36,
          "text": "חלק הכי תחתון שבאדם24"
        },
        {
          "s": 37,
          "text": "(אלא שעי\"ז מתנשא ורוקד גם הראש)."
        },
        {
          "s": 38,
          "text": "שמזה מובן שהשמחה דשמחת תורה היא בעיקר לא מצד פעולת התורה בישראל לי ראש25,"
        },
        {
          "s": 39,
          "text": "כי אם,"
        },
        {
          "s": 40,
          "text": "מצד פעולת התורה בעולם שהוא טפל26"
        },
        {
          "s": 41,
          "text": "לישראל,"
        },
        {
          "s": 42,
          "text": "בדוגמת הרגלים שטפלים להראש,"
        },
        {
          "s": 43,
          "text": "ובעולם גופא בענינים התחתונים שבו"
        },
        {
          "s": 44,
          "text": "(בחי' עקב)."
        },
        {
          "s": 45,
          "text": "ועפ\"ז אינו מובן יותר מה שקבעו שמחת תורה על לוחות האחרונות דוקא,"
        },
        {
          "s": 46,
          "text": "שהעילוי דכפלים לתושי' שבלוחות האחרונות הוא בישראל."
        },
        {
          "s": 47,
          "text": "גם אינו מובן,"
        },
        {
          "s": 48,
          "text": "דלפי זה"
        },
        {
          "s": 49,
          "text": "(שהשמחה דשמחת תורה היא על לוחות האחרונות שניתנו ביום הכפורים)"
        },
        {
          "s": 50,
          "text": "היו צריכים לעשות שמחת תורה למחרת יום הכפורים27."
        },
        {
          "s": 51,
          "text": "דמה שלא קבעו שמחת תורה ביום הכפורים גופא י\"ל דזהו לפי שאין שמחה בלא אכילה ושתי'28,"
        },
        {
          "s": 52,
          "text": "אבל הי' צ\"ל מיד אחרי יום הכפורים."
        },
        {
          "s": 53,
          "text": "ואולי י\"ל יתירה מזו,"
        },
        {
          "s": 54,
          "text": "הרי מצינו שבאותה שנה"
        },
        {
          "s": 55,
          "text": "(דחנוכת ביהמ\"ק)"
        },
        {
          "s": 56,
          "text": "לא עשו ישראל את יום הכפורים,"
        },
        {
          "s": 57,
          "text": "ויצתה ב\"ק ואמרה להם כולכם מוזמנים לחיי העוה\"ב28,"
        },
        {
          "s": 58,
          "text": "כי השמחה דחנוכת ביהמ\"ק היא נעלית יותר מהעינוי דיום הכפורים."
        },
        {
          "s": 59,
          "text": "ומכיון שהשמחה דשמחת תורה היא שמחה גדולה ביותר,"
        },
        {
          "s": 60,
          "text": "ועד שהיא גדולה יותר גם מהשמחה דשמחת בית השואבה29,"
        },
        {
          "s": 61,
          "text": "דמי שלא ראה שמחת בית השואבה לא ראה שמחה מימיו30,"
        },
        {
          "s": 62,
          "text": "א\"כ הי' ראוי לקבוע שמחת תורה ביום הכפורים גופא."
        }
      ]
    }
  ]
}