{
  "globalIndex": 818,
  "owner": 18,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918633_theRebbe_459__p008",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918633_theRebbe_459__p008",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918633_theRebbe_459",
  "title": "מאמר בחודש השלישי תשכ\"ט",
  "part": 8,
  "sections": [
    {
      "v": 21,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ב)"
        },
        {
          "s": 2,
          "text": "וזהו בחודש השלישי גו' ביום הזה גו',"
        },
        {
          "s": 3,
          "text": "דהגם שהענין דיום הזה הוא בכל ר\"ח,"
        },
        {
          "s": 4,
          "text": "עיקר הענין דיום הזה הוא ב"
        },
        {
          "s": 5,
          "text": "(ראש)"
        },
        {
          "s": 6,
          "text": "חודש השלישי."
        },
        {
          "s": 7,
          "text": "והענין הוא"
        },
        {
          "s": 8,
          "text": "(כמבואר בדרושי הצ\"צ73),"
        },
        {
          "s": 9,
          "text": "דחודש הראשון הוא בחינת סיהרא,"
        },
        {
          "s": 10,
          "text": "מלכות."
        },
        {
          "s": 11,
          "text": "דהגם שגם בר\"ח ניסן יש היחוד דשמשא וסיהרא"
        },
        {
          "s": 12,
          "text": "(ז\"א ומלכות),"
        },
        {
          "s": 13,
          "text": "מ\"מ,"
        },
        {
          "s": 14,
          "text": "בר\"ח ניסן,"
        },
        {
          "s": 15,
          "text": "העיקר הוא המלכות."
        },
        {
          "s": 16,
          "text": "וחודש אייר נק' זיו74,"
        },
        {
          "s": 17,
          "text": "הוא היסוד שמאיר במלכות75."
        },
        {
          "s": 18,
          "text": "וזה שהיסוד נקרא זיו הוא לפי שהוא זיו והארה בלבד."
        },
        {
          "s": 19,
          "text": "ובחודש השלישי מקבלת המלכות מת\"ת,"
        },
        {
          "s": 20,
          "text": "דבת\"ת הוא הגילוי דהוי' שהוא שם העצם76."
        },
        {
          "s": 21,
          "text": "היינו שהגילוי דחודש השלישי הוא לא זיו"
        },
        {
          "s": 22,
          "text": "(כהגילוי דחודש אייר),"
        },
        {
          "s": 23,
          "text": "אלא גילוי העצם."
        },
        {
          "s": 24,
          "text": "ולכן,"
        },
        {
          "s": 25,
          "text": "עיקר הענין דיום הזה הוא בר\"ח סיון,"
        },
        {
          "s": 26,
          "text": "בחודש השלישי."
        }
      ]
    },
    {
      "v": 22,
      "items": [
        {
          "s": 0,
          "text": "וע\"י ההכנה לקבלת התורה בחודש השלישי ביום הזה"
        },
        {
          "s": 1,
          "text": "(ר\"ח סיון)"
        },
        {
          "s": 2,
          "text": "– הן בבירור המדות דנפש הבהמית"
        },
        {
          "s": 3,
          "text": "(סיני),"
        },
        {
          "s": 4,
          "text": "והן בהביטול"
        },
        {
          "s": 5,
          "text": "(מדבר)"
        },
        {
          "s": 6,
          "text": "דנפש האלקית,"
        },
        {
          "s": 7,
          "text": "ובפרט בהענין דכאיש אחד בלב אחד"
        },
        {
          "s": 8,
          "text": "[שזו"
        },
        {
          "s": 9,
          "text": "(אהבת ישראל)"
        },
        {
          "s": 10,
          "text": "היא כל התורה כולה ואידך פירושה הוא77]"
        },
        {
          "s": 11,
          "text": "– זוכים לקבלת התורה בשמחה ובפנימיות,"
        },
        {
          "s": 12,
          "text": "וממשיכים זה על כל השנה כולה."
        }
      ]
    }
  ]
}