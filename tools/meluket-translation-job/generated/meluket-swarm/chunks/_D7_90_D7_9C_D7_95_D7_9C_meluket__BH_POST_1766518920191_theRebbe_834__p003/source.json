{
  "globalIndex": 1079,
  "owner": 29,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920191_theRebbe_834__p003",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920191_theRebbe_834__p003",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920191_theRebbe_834",
  "title": "מאמר אני לדודי תשל\"ב",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים הביאור בזה שהיראה דאלול היא יראה תתאה והיראה דראש השנה היא יראה עילאה."
        },
        {
          "s": 2,
          "text": "דהנה החילוק בין יראה תתאה ויראה עילאה הוא,"
        },
        {
          "s": 3,
          "text": "כמבואר בתניא18"
        },
        {
          "s": 4,
          "text": "ובכ\"מ19"
        },
        {
          "s": 5,
          "text": "דיראה תתאה היא מגדולתו ית' בבריאת והתהוות העולמות."
        },
        {
          "s": 6,
          "text": "דהביטול שביראה זו הוא ביטול היש."
        },
        {
          "s": 7,
          "text": "ויראה עילאה היא מגדולתו ורוממותו ית' שלמעלה מעולמות,"
        },
        {
          "s": 8,
          "text": "דכולא קמי' כלא חשיב."
        },
        {
          "s": 9,
          "text": "דהביטול שביראה זו הוא ביטול במציאות."
        },
        {
          "s": 10,
          "text": "וזהו שבכדי לבוא ליראה עילאה,"
        },
        {
          "s": 11,
          "text": "הוא דוקא ע\"י גילוי מלמעלה,"
        },
        {
          "s": 12,
          "text": "כי זה שביכולת האדם להשיג ע\"י התבוננות הוא האלקות שבערך העולמות,"
        },
        {
          "s": 13,
          "text": "ובכדי שיורגש אצלו הרוממות דאוא\"ס שלמעלה מעולמות הוא דוקא ע\"י גילוי מלמעלה."
        },
        {
          "s": 14,
          "text": "וזהו מ\"ש20"
        },
        {
          "s": 15,
          "text": "ויצונו ה' לעשות את כל החוקים האלה ליראה את הוי',"
        },
        {
          "s": 16,
          "text": "שבכדי לבוא ליראה את הוי',"
        },
        {
          "s": 17,
          "text": "יראה עילאה21,"
        },
        {
          "s": 18,
          "text": "א\"א לבוא לזה ע\"י התבוננות ורק ע\"י גילוי מלמעלה שנמשך ע\"י המצוות22."
        },
        {
          "s": 19,
          "text": "וזהו שהיראה דאלול היא יראה תתאה והיראה דר\"ה היא יראה עילאה,"
        },
        {
          "s": 20,
          "text": "כי באלול,"
        },
        {
          "s": 21,
          "text": "שהמלך הוא בשדה,"
        },
        {
          "s": 22,
          "text": "שבהיותו בשדה לא נרגש הגדלות והרוממות שלו23,"
        },
        {
          "s": 23,
          "text": "והיראה אז היא"
        },
        {
          "s": 24,
          "text": "(לא מצד הגילוי מלמעלה,"
        },
        {
          "s": 25,
          "text": "אלא)"
        },
        {
          "s": 26,
          "text": "ע\"י עבודת האדם,"
        },
        {
          "s": 27,
          "text": "לכן,"
        },
        {
          "s": 28,
          "text": "היראה אז היא יראה תתאה."
        },
        {
          "s": 29,
          "text": "ובר\"ה,"
        },
        {
          "s": 30,
          "text": "כשהמלך הוא בהיכל מלכותו,"
        },
        {
          "s": 31,
          "text": "שאז נרגש הרוממות שלו,"
        },
        {
          "s": 32,
          "text": "שהוא מרומם ומובדל מהעם24,"
        },
        {
          "s": 33,
          "text": "דבנמשל הוא גילוי הרוממות דאוא\"ס שלמעלה מעולמות,"
        },
        {
          "s": 34,
          "text": "היראה שבר\"ה יראה עילאה."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דזה שצריך לתקוע בשופר בר\"ה בכדי לבוא ליראה עילאה,"
        },
        {
          "s": 2,
          "text": "אף שאז הוא זמן התגלות מלכותו ית',"
        },
        {
          "s": 3,
          "text": "היינו שבהזמן דר\"ה מצד עצמו מאיר בגילוי הרוממות דאוא\"ס שלמעלה מעולמות,"
        },
        {
          "s": 4,
          "text": "הוא,"
        },
        {
          "s": 5,
          "text": "כי זמן הוא מגדרי העולם25,"
        },
        {
          "s": 6,
          "text": "ולכן,"
        },
        {
          "s": 7,
          "text": "הרוממות דאוא\"ס שמתגלה בר\"ה מצד הזמן דר\"ה הוא שייך לעולמות,"
        },
        {
          "s": 8,
          "text": "והגילוי דאוא\"ס כמו שהוא קדוש ומובדל מעולמות הוא בעיקר ע\"י המצוות,"
        },
        {
          "s": 9,
          "text": "אשר קדשנו במצוותיו26."
        },
        {
          "s": 10,
          "text": "וכיון שתקיעת שופר בר\"ה היא מצוה,"
        },
        {
          "s": 11,
          "text": "היראה והחרדה מקול השופר דר\"ה היא יראה וביטול בתכלית,"
        },
        {
          "s": 12,
          "text": "יראה עילאה."
        },
        {
          "s": 13,
          "text": "ועפ\"ז יש להוסיף עוד ביאור בזה שהיראה הבאה מקול השופר דאלול היא"
        },
        {
          "s": 14,
          "text": "(רק)"
        },
        {
          "s": 15,
          "text": "יראה תתאה,"
        },
        {
          "s": 16,
          "text": "כי זה שקול השופר דר\"ה מביא ליראה עצומה כזו,"
        },
        {
          "s": 17,
          "text": "ביטול במציאות"
        },
        {
          "s": 18,
          "text": "(יראה עילאה),"
        },
        {
          "s": 19,
          "text": "הוא מצד המצוה דתק\"ש,"
        },
        {
          "s": 20,
          "text": "וכיון שתק\"ש באלול אינה מצוה"
        },
        {
          "s": 21,
          "text": "(ואין מברכים על זה אשר קדשנו במצוותיו),"
        },
        {
          "s": 22,
          "text": "לכן,"
        },
        {
          "s": 23,
          "text": "היראה"
        },
        {
          "s": 24,
          "text": "(והביטול)"
        },
        {
          "s": 25,
          "text": "הבאה מקול השופר דאלול היא"
        },
        {
          "s": 26,
          "text": "(רק)"
        },
        {
          "s": 27,
          "text": "ביטול היש,"
        },
        {
          "s": 28,
          "text": "יראה תתאה."
        },
        {
          "s": 29,
          "text": "אלא שאעפ\"כ,"
        },
        {
          "s": 30,
          "text": "יראה זו היא הקדמה והכנה ליראה עילאה דר\"ה,"
        },
        {
          "s": 31,
          "text": "כי בכדי לבוא ליראה עילאה צ\"ל תחלה יראה תתאה"
        },
        {
          "s": 32,
          "text": "(כנ\"ל בהמאמר)."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה ידוע27"
        },
        {
          "s": 2,
          "text": "שבכדי לבוא מיראה תתאה ליראה עילאה צ\"ל תחלה אהבה."
        },
        {
          "s": 3,
          "text": "דסדר העבודה הוא דחילו רחימו רחימו ודחילו."
        },
        {
          "s": 4,
          "text": "דחילו"
        },
        {
          "s": 5,
          "text": "(הראשון)"
        },
        {
          "s": 6,
          "text": "הוא יראה תתאה,"
        },
        {
          "s": 7,
          "text": "ולאח\"ז ב' דרגות ברחימו,"
        },
        {
          "s": 8,
          "text": "אהבה זוטא ואהבה רבה,"
        },
        {
          "s": 9,
          "text": "ולאח\"ז דחילו,"
        },
        {
          "s": 10,
          "text": "יראה עילאה."
        },
        {
          "s": 11,
          "text": "ומזה מובן,"
        },
        {
          "s": 12,
          "text": "דזה שמהיראה תתאה דאלול באים ליראה עילאה בר\"ה הוא ע\"י הקדמת האהבה."
        },
        {
          "s": 13,
          "text": "ויש לבאר זה ע\"פ מ\"ש בלקו\"ת דכשהמלך הוא בשדה הוא מקבל את כולם בסבר פנים יפות ומראה פנים שוחקות לכולם,"
        },
        {
          "s": 14,
          "text": "דפנים יפות ופנים שוחקות הו\"ע האהבה,"
        },
        {
          "s": 15,
          "text": "וע\"י שהמלך מקבל את כולם בסבר פנים יפות,"
        },
        {
          "s": 16,
          "text": "ובפרט ע\"י שמראה פנים שוחקות לכולם,"
        },
        {
          "s": 17,
          "text": "זה מעורר אצלם"
        },
        {
          "s": 18,
          "text": "(כמים הפנים לפנים28)"
        },
        {
          "s": 19,
          "text": "אהבה להמלך."
        },
        {
          "s": 20,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 21,
          "text": "שבפרטי המשל שבלקו\"ת מרומזים ד' ענינים הנ\"ל."
        },
        {
          "s": 22,
          "text": "דזה שיוצאים לקראת המלך לקבל פניו,"
        },
        {
          "s": 23,
          "text": "שייך ליראה תתאה."
        },
        {
          "s": 24,
          "text": "ולאח\"ז,"
        },
        {
          "s": 25,
          "text": "המלך מקבלם בסבר פנים יפות ומראה להם פנים שוחקות – שתי הדרגות דרחימו"
        },
        {
          "s": 26,
          "text": "(פנים יפות – אהבה זוטא,"
        },
        {
          "s": 27,
          "text": "ופנים שוחקות – אהבה רבה),"
        },
        {
          "s": 28,
          "text": "ולאח\"ז בא הענין דבבואו להיכל מלכותו – יראה עילאה."
        }
      ]
    }
  ]
}