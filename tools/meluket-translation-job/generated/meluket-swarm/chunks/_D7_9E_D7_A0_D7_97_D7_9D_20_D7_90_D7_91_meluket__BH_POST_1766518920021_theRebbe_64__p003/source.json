{
  "globalIndex": 1059,
  "owner": 9,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518920021_theRebbe_64__p003",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518920021_theRebbe_64__p003",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518920021_theRebbe_64",
  "title": "מאמר ושננתם לבניך תשל\"ח",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "וזהו גם הדיוק במארז\"ל לא היו ימים טובים לישראל כחמשה עשר באב וכיום הכפורים,"
        },
        {
          "s": 1,
          "text": "שבתחילה נזכר חמשה עשר באב ואח\"כ יום הכפורים,"
        },
        {
          "s": 2,
          "text": "להורות שמעלת חמשה עשר באב גדולה יותר ממעלת יום הכפורים,"
        },
        {
          "s": 3,
          "text": "כי,"
        },
        {
          "s": 4,
          "text": "אע\"פ שבנוגע ליוהכ\"פ נתפרש בגמרא52"
        },
        {
          "s": 5,
          "text": "שמעלתו היא \"משום דאית בי' סליחה ומחילה\","
        },
        {
          "s": 6,
          "text": "שהו\"ע עבודת התשובה"
        },
        {
          "s": 7,
          "text": "[ומזה למדים שגם ענינו של חמשה עשר באב הו\"ע התשובה],"
        },
        {
          "s": 8,
          "text": "מ\"מ,"
        },
        {
          "s": 9,
          "text": "גדלה מעלת חמשה עשר באב יותר ממעלת יוהכ\"פ,"
        },
        {
          "s": 10,
          "text": "לפי שבו מודגשת עבודת התשובה בשעתא חדא וברגע חדא,"
        },
        {
          "s": 11,
          "text": "מן הקצה אל הקצה,"
        },
        {
          "s": 12,
          "text": "משא\"כ ביוהכ\"פ שעבודת התשובה שבו באה לאחרי עבודה ארוכה עם כמה פרטים ופרטי פרטים,"
        },
        {
          "s": 13,
          "text": "החל מר\"ח אלול,"
        },
        {
          "s": 14,
          "text": "כנ\"ל."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וביאור כללות הענין,"
        },
        {
          "s": 2,
          "text": "כמובא בהדרושים15"
        },
        {
          "s": 3,
          "text": "הכלל שהעלי' היא בערך הירידה,"
        },
        {
          "s": 4,
          "text": "ולכן,"
        },
        {
          "s": 5,
          "text": "כאשר הירידה היא עד למטה מטה ביותר,"
        },
        {
          "s": 6,
          "text": "הנה לפום צערא אגרא53,"
        },
        {
          "s": 7,
          "text": "שדוקא אז נעשית העלי' למעלה מעלה ביותר."
        },
        {
          "s": 8,
          "text": "וע\"ד המבואר בכ\"מ54,"
        },
        {
          "s": 9,
          "text": "שכאשר ניצוץ קדושה נמצא למטה מטה,"
        },
        {
          "s": 10,
          "text": "הרי זה גופא מורה ששרשו גבוה גבוה ביותר,"
        },
        {
          "s": 11,
          "text": "כי,"
        },
        {
          "s": 12,
          "text": "כל הגבוה ביותר יורד ונמצא למטה ביותר."
        },
        {
          "s": 13,
          "text": "וכדאיתא בכתבי האריז\"ל55"
        },
        {
          "s": 14,
          "text": "והובא בדרושי רבותינו נשיאינו בכ\"מ56"
        },
        {
          "s": 15,
          "text": "בפירוש הכתוב57"
        },
        {
          "s": 16,
          "text": "כי לא על הלחם לבדו יחי' האדם כי על כל מוצא פי הוי' יחי' האדם,"
        },
        {
          "s": 17,
          "text": "דאע\"פ שגם באדם ישנו מוצא פי הוי',"
        },
        {
          "s": 18,
          "text": "מ\"מ,"
        },
        {
          "s": 19,
          "text": "דוקא ע\"י מוצא פי הוי' שבלחם שלמטה מן האדם,"
        },
        {
          "s": 20,
          "text": "יחי' האדם עם המוצא פי הוי' שבו,"
        },
        {
          "s": 21,
          "text": "והיינו,"
        },
        {
          "s": 22,
          "text": "לפי שמוצא פי הוי' שבחי"
        },
        {
          "s": 23,
          "text": "(ולמטה מזה)"
        },
        {
          "s": 24,
          "text": "בצומח ודומם,"
        },
        {
          "s": 25,
          "text": "שלמטה מהאדם,"
        },
        {
          "s": 26,
          "text": "שרשו ממקום גבוה יותר,"
        },
        {
          "s": 27,
          "text": "ולכן דוקא ע\"י עבודת האדם בהמוצא פי הוי' שבדצ\"ח להעלותו לשרשו ומקורו"
        },
        {
          "s": 28,
          "text": "(שלמעלה משרש האדם),"
        },
        {
          "s": 29,
          "text": "נעשה עילוי גם בהאדם,"
        },
        {
          "s": 30,
          "text": "\"יחי' האדם\","
        },
        {
          "s": 31,
          "text": "ע\"ד מרז\"ל58"
        },
        {
          "s": 32,
          "text": "ארון נושאיו נשא."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ועד\"ז הוא בכללות ענין הירידות,"
        },
        {
          "s": 1,
          "text": "החל מהירידה דסדר השתלשלות,"
        },
        {
          "s": 2,
          "text": "ועד לירידת הגלות"
        },
        {
          "s": 3,
          "text": "(כמבואר באגה\"ת59),"
        },
        {
          "s": 4,
          "text": "שזהו ענינו של חודש אב ותשעה באב,"
        },
        {
          "s": 5,
          "text": "שאז נעשה ענין הגלות כפשוטו באופן הכי תחתון – שע\"י כל זה באים לעלי' גדולה ביותר,"
        },
        {
          "s": 6,
          "text": "וזהו התכלית דכללות ענין הגלות,"
        },
        {
          "s": 7,
          "text": "שאין זה בשביל ענין של עונש ח\"ו,"
        },
        {
          "s": 8,
          "text": "אלא כדי שיבואו לטהרה,"
        },
        {
          "s": 9,
          "text": "וטהרה מביאה לידי קדושהג,"
        },
        {
          "s": 10,
          "text": "ומקדושה כו' עד לתכלית העלי'"
        },
        {
          "s": 11,
          "text": "(כהסיום בברייתא הידועה62)"
        },
        {
          "s": 12,
          "text": "– ביאת אליהו הנביא ותחיית המתים,"
        },
        {
          "s": 13,
          "text": "החל מהענין דתחה\"מ כפי שזוטרא דבכו מחי' מתים63,"
        },
        {
          "s": 14,
          "text": "שבכללות הו\"ע עבודת הבירורים,"
        },
        {
          "s": 15,
          "text": "לברר הניצוצי קדושה שנפלו למטה,"
        },
        {
          "s": 16,
          "text": "דמאן דנפיל מדרגי' אקרי מת64,"
        },
        {
          "s": 17,
          "text": "וע\"י שמבררם ה\"ה מחי' אותם,"
        },
        {
          "s": 18,
          "text": "ואח\"כ מזכך ומעלה אותם עד לתכלית השלימות,"
        },
        {
          "s": 19,
          "text": "כמצות רצונך65."
        },
        {
          "s": 20,
          "text": "וכאמור לעיל שעילוי זה"
        },
        {
          "s": 21,
          "text": "(שלאחרי הירידה דגלות)"
        },
        {
          "s": 22,
          "text": "נעשה בגלוי כבר בת\"ב בתחלת זמן"
        },
        {
          "s": 23,
          "text": "(ותפלת)"
        },
        {
          "s": 24,
          "text": "מנחה,"
        },
        {
          "s": 25,
          "text": "שאז כילה חמתו כביכול על העצים ועל האבנים36,"
        },
        {
          "s": 26,
          "text": "שזה הראה בגלוי גודל האהבה דהקב\"ה,"
        },
        {
          "s": 27,
          "text": "שכל חמתו כילה – לגמרי,"
        },
        {
          "s": 28,
          "text": "שלא נשאר ממנה כלום,"
        },
        {
          "s": 29,
          "text": "ומיד נולד משיח מושיען של ישראל."
        },
        {
          "s": 30,
          "text": "וכאמור,"
        },
        {
          "s": 31,
          "text": "שענין זה בא לידי גילוי באופן ההנהגה דתשעה באב לאחרי חצות היום."
        },
        {
          "s": 32,
          "text": "אך עדיין אין זה תכלית שלימות הגילוי,"
        },
        {
          "s": 33,
          "text": "והולך ומתגלה מיום ליום,"
        },
        {
          "s": 34,
          "text": "ככל שהלבנה מתקרבת להמצב דקיימא סיהרא באשלמותא,"
        },
        {
          "s": 35,
          "text": "עד לשלימות הגילוי בחמשה עשר באב,"
        },
        {
          "s": 36,
          "text": "שנעשה יו\"ט גדול ביותר,"
        },
        {
          "s": 37,
          "text": "ועד שלא היו ימים טובים לישראל כחמשה עשר באב."
        }
      ]
    }
  ]
}