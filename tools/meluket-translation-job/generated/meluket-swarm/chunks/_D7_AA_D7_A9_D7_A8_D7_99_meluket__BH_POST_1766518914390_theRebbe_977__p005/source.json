{
  "globalIndex": 119,
  "owner": 19,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914390_theRebbe_977__p005",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914390_theRebbe_977__p005",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914390_theRebbe_977",
  "title": "מאמר בסוכות תשבו תשכ\"ג",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "והחילוק דשני הענינים הוא,"
        },
        {
          "s": 1,
          "text": "שהגילוי דעצם הנשמה בזה שגם לאחרי החטאים הוא שב להוי',"
        },
        {
          "s": 2,
          "text": "הוא שעל ידי החטאים נעשה נפרד מאלקות"
        },
        {
          "s": 3,
          "text": "(שלכן צריך לעשות תשובה עליהם),"
        },
        {
          "s": 4,
          "text": "אלא שכיון ששורש הנשמה הוא בעצמות אוא\"ס שלמעלה מהענין דבמי נמלך,"
        },
        {
          "s": 5,
          "text": "הפירוד שע\"י החטאים הוא רק בחיצוניות,"
        },
        {
          "s": 6,
          "text": "ולכן ביכלתו לעשות תשובה"
        },
        {
          "s": 7,
          "text": "(ע\"י גילוי הפנימיות)."
        },
        {
          "s": 8,
          "text": "והגילוי דעצם הנשמה בהסיבה שמביאה אותו לחזור בתשובה,"
        },
        {
          "s": 9,
          "text": "הוא,"
        },
        {
          "s": 10,
          "text": "שע\"י החטאים לא נעשה מלכתחילה גרעון ח\"ו בההתקשרות העצמית דעצם הנשמה באלקות,"
        },
        {
          "s": 11,
          "text": "וגם בשעת החטא היא באמנה אתו ית'."
        },
        {
          "s": 12,
          "text": "והוא ע\"ד שנתבאר לעיל"
        },
        {
          "s": 13,
          "text": "(בהמאמר ד\"ה וכל אדם לא יהי'26),"
        },
        {
          "s": 14,
          "text": "דהכפרה שע\"י ההמשכה מעצמות אוא\"ס בעל הרצון היא באופן שע\"י החטאים נעשה פגם,"
        },
        {
          "s": 15,
          "text": "וע\"י ההמשכה מעצמות אוא\"ס בעל הרצון שאינו מוכרח בהרצון,"
        },
        {
          "s": 16,
          "text": "מתכפרים הפגמים."
        },
        {
          "s": 17,
          "text": "והכפרה שמצד עיצומו של יום הכפורים היא"
        },
        {
          "s": 18,
          "text": "(לא באופן של פעולה,"
        },
        {
          "s": 19,
          "text": "אלא)"
        },
        {
          "s": 20,
          "text": "שביום זה מתגלה ההתקשרות של עצם הנשמה עם העצמות"
        },
        {
          "s": 21,
          "text": "(שלמעלה מבעל הרצון),"
        },
        {
          "s": 22,
          "text": "שבדרגא זו אין פגם מלכתחילה."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש להוסיף ביאור27"
        },
        {
          "s": 1,
          "text": "בזה שעיצומו של יום הכיפורים מכפר"
        },
        {
          "s": 2,
          "text": "(דוקא)"
        },
        {
          "s": 3,
          "text": "לשבים28,"
        },
        {
          "s": 4,
          "text": "כי בכדי שתהי' המשכת הענין דעיצומו של יום,"
        },
        {
          "s": 5,
          "text": "גילוי ההתקשרות העצמית דעצם הנשמה עם העצמות,"
        },
        {
          "s": 6,
          "text": "צריכה להיות איזו עשי' דהאדם"
        },
        {
          "s": 7,
          "text": "[וע\"ד גילוי עצם הנשמה בראש השנה,"
        },
        {
          "s": 8,
          "text": "שהיא על ידי העבודה דתמליכוני עליכם29],"
        },
        {
          "s": 9,
          "text": "וכיון שהסיבה המביאה לעשות תשובה היא התקשרות העצמית,"
        },
        {
          "s": 10,
          "text": "לכן,"
        },
        {
          "s": 11,
          "text": "על ידי התשובה היא המשכת הענין דעיצומו של יום."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וביאור הענין בפרטיות יותר,"
        },
        {
          "s": 2,
          "text": "יובן בהקדים מה שנתבאר לעיל"
        },
        {
          "s": 3,
          "text": "(בהמאמר ד\"ה יבחר לנו30),"
        },
        {
          "s": 4,
          "text": "שבתקיעת שופר דראש השנה שעי\"ז נעשה תמליכוני עליכם,"
        },
        {
          "s": 5,
          "text": "ג' ענינים."
        },
        {
          "s": 6,
          "text": "קיום המצוה דתקיעת שופר,"
        },
        {
          "s": 7,
          "text": "שהיא האתערותא דלתתא המעוררת את הרצון הגלוי."
        },
        {
          "s": 8,
          "text": "והתשובה דתקיעת שופר,"
        },
        {
          "s": 9,
          "text": "שעל ידה נמשך ההחלט שברצון הנעלם"
        },
        {
          "s": 10,
          "text": "(מחשבה ורצון המוחלט)"
        },
        {
          "s": 11,
          "text": "ולמעלה יותר ברצון המוחלט בעצמותו שע\"י האתעדל\"ת יתעורר הרצון גלוי."
        },
        {
          "s": 12,
          "text": "והביטול הפנימי שמצד עצם הנשמה,"
        },
        {
          "s": 13,
          "text": "שעי\"ז נמשך רצון המוחלט עצמו."
        },
        {
          "s": 14,
          "text": "וע\"פ הידוע31"
        },
        {
          "s": 15,
          "text": "שהענין דבנין המלכות הוא במשך כל עשרת ימי תשובה,"
        },
        {
          "s": 16,
          "text": "יש לומר,"
        },
        {
          "s": 17,
          "text": "שגם בעשרת ימי תשובה צריכה להיות"
        },
        {
          "s": 18,
          "text": "(נוסף על עבודת התשובה)"
        },
        {
          "s": 19,
          "text": "גם עבודה שמצד עצם הנשמה32."
        },
        {
          "s": 20,
          "text": "וזהו שבעשרת ימי תשובה אומרים שיר המעלות ממעמקים33,"
        },
        {
          "s": 21,
          "text": "ואיתא בזהר34"
        },
        {
          "s": 22,
          "text": "וההוא עמיקא דעמיקתא"
        },
        {
          "s": 23,
          "text": "(מעמקים לשון רבים)"
        },
        {
          "s": 24,
          "text": "אקרי תשובה."
        },
        {
          "s": 25,
          "text": "ומבאר כ\"ק מו\"ח אדמו\"ר בהמשך הנ\"ל35"
        },
        {
          "s": 26,
          "text": "שהם ב' העומקים דרצון הנעלם ורצון המוחלט בעצמותו."
        },
        {
          "s": 27,
          "text": "דההמשכה מהעומק דרצון הנעלם היא ע\"י צעקת הקול הבאה מהמקיף דחי',"
        },
        {
          "s": 28,
          "text": "וההמשכה מהעומק דרצון המוחלט היא ע\"י צעקת הלב הבאה מהמקיף דיחידה."
        },
        {
          "s": 29,
          "text": "ובמקום אחר איתא בזהר36"
        },
        {
          "s": 30,
          "text": "שיר המעלות סתם ולא פירש מאן אמרו,"
        },
        {
          "s": 31,
          "text": "אלא שיר המעלות דזמינין כל בני עלמא למימר."
        },
        {
          "s": 32,
          "text": "ובהמשך הענין שם וכי אמר דוד הכי והא כתיב37"
        },
        {
          "s": 33,
          "text": "בכל לבי דרשתיך כו' מאי בעי ממעמקים אלא הכי תאנא כל ב\"נ כו' מעיקרא דכל עיקרין."
        },
        {
          "s": 34,
          "text": "ומבואר בחסידות38,"
        },
        {
          "s": 35,
          "text": "שהדיוק בזהר וכי אמר דוד הכי כו' הוא,"
        },
        {
          "s": 36,
          "text": "דכיון שכבר אמר בכל לבי דרשתיך,"
        },
        {
          "s": 37,
          "text": "שבכל לבי הוא פנימיות הלב,"
        },
        {
          "s": 38,
          "text": "מה צריך לומר ממעמקים."
        },
        {
          "s": 39,
          "text": "ומבאר,"
        },
        {
          "s": 40,
          "text": "שצריך להמשיך מעיקרא דכל עיקרין,"
        },
        {
          "s": 41,
          "text": "מפנימיות ועצמות א\"ס,"
        },
        {
          "s": 42,
          "text": "ובכדי להמשיך משם הוא ע\"י העבודה שמפנימיות ועצמות הנפש,"
        },
        {
          "s": 43,
          "text": "ממעמקים,"
        },
        {
          "s": 44,
          "text": "שלמעלה מהעבודה דפנימיות הלב"
        },
        {
          "s": 45,
          "text": "(בכל לבי)."
        }
      ]
    }
  ]
}