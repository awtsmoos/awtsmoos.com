{
  "globalIndex": 931,
  "owner": 31,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919272_theRebbe_883__p007",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919272_theRebbe_883__p007",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919272_theRebbe_883",
  "title": "מאמר נתת ליראיך תשל\"ו",
  "part": 7,
  "sections": [
    {
      "v": 18,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ז)"
        },
        {
          "s": 2,
          "text": "ויש לקשר זה עם מ\"ש במזמור תהלים174"
        },
        {
          "s": 3,
          "text": "שמתחילים לומר בי\"ב תמוז שנה זו"
        },
        {
          "s": 4,
          "text": "(תשל\"ו)175,"
        },
        {
          "s": 5,
          "text": "אור זרוע לצדיק ולישרי לב שמחה."
        },
        {
          "s": 6,
          "text": "ומביא כ\"ק אדמו\"ר הצ\"צ ברשימותיו לתהלים176"
        },
        {
          "s": 7,
          "text": "מה שארז\"ל במדרש177,"
        },
        {
          "s": 8,
          "text": "דאור זרוע לצדיק הוא האור שנברא ביום ראשון וגנזו לצדיקים לעת\"ל"
        },
        {
          "s": 9,
          "text": "(ועי\"ז ולישרי לב שמחה,"
        },
        {
          "s": 10,
          "text": "שהם הצדיקים שלבם ברשותם178)."
        },
        {
          "s": 11,
          "text": "ומדייק אור זרוע גו',"
        },
        {
          "s": 12,
          "text": "זריעה דוקא."
        },
        {
          "s": 13,
          "text": "וע\"ד זריעה גשמית,"
        },
        {
          "s": 14,
          "text": "שצ\"ל רקבון הגרעין,"
        },
        {
          "s": 15,
          "text": "שזה דוקא מעורר כח הצמיחה שבארץ."
        },
        {
          "s": 16,
          "text": "שכח הצמיחה שבארץ הוא כח הא\"ס,"
        },
        {
          "s": 17,
          "text": "וע\"י הצמיחה הוא גילוי כח הא\"ס"
        },
        {
          "s": 18,
          "text": "(כמובן מאגה\"ק ס\"כ)."
        },
        {
          "s": 19,
          "text": "ועד\"ז הוא ברוחניות,"
        },
        {
          "s": 20,
          "text": "שע\"י העבודה דביטול ומס\"נ מגיעים לא\"ס שלמעלה מהשתלשלות."
        },
        {
          "s": 21,
          "text": "וכמבואר במאמרים179"
        },
        {
          "s": 22,
          "text": "על הכתוב180"
        },
        {
          "s": 23,
          "text": "הבאים ישרש יעקב יציץ ופרח ישראל ומלאו פני תבל תנובה,"
        },
        {
          "s": 24,
          "text": "שהיא העבודה דתומ\"צ בביטול"
        },
        {
          "s": 25,
          "text": "(כענין הזריעה),"
        },
        {
          "s": 26,
          "text": "הנה עי\"ז דוקא ומלאו פני תבל תנובה גילוי כח הא\"ס,"
        },
        {
          "s": 27,
          "text": "וכמבואר ג\"כ בהמשך כל הנהנה תרנ\"ב181."
        },
        {
          "s": 28,
          "text": "וע\"ד משנת\"ל שדוקא ע\"י העבודה דנסיונות מגיעים לבחי' נס בתוך נס,"
        },
        {
          "s": 29,
          "text": "עצמותו ומהותו ית'."
        }
      ]
    },
    {
      "v": 19,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ז)"
        },
        {
          "s": 2,
          "text": "וזהו ג\"כ מש\"נ182"
        },
        {
          "s": 3,
          "text": "וכל קרני רשעים אגדע תרוממנה קרנות צדיק,"
        },
        {
          "s": 4,
          "text": "ואיתא במדרש183"
        },
        {
          "s": 5,
          "text": "עשר קרנות הן שנתן הקב\"ה לישראל כו' כיון שחטאו ישראל ניטלו מהן וניתנו לעכו\"ם כו'."
        },
        {
          "s": 6,
          "text": "דענין של קרן והגבהה שייך רק בישראל."
        },
        {
          "s": 7,
          "text": "אלא שמפני חטאינו"
        },
        {
          "s": 8,
          "text": "(עכ\"פ הענין דחטא ענין חסרון כמש\"נ184"
        },
        {
          "s": 9,
          "text": "אני ושלמה בני חטאים)"
        },
        {
          "s": 10,
          "text": "גלינו מארצנו,"
        },
        {
          "s": 11,
          "text": "וכשזה קם זה נופל185,"
        },
        {
          "s": 12,
          "text": "ואז קרני העכו\"ם קיימות וקרני ישראל גדועים186"
        },
        {
          "s": 13,
          "text": "ר\"ל."
        },
        {
          "s": 14,
          "text": "אבל ע\"י לימוד התורה וקיום מ\"ע ושמירת מל\"ת,"
        },
        {
          "s": 15,
          "text": "ובעיקר ע\"י העבודה דמס\"נ בענין הנסיונות,"
        },
        {
          "s": 16,
          "text": "ובמיוחד בדרא דעקבתא דמשיחא שאז העבודה קשה ביותר כנ\"ל,"
        },
        {
          "s": 17,
          "text": "שעבודה זו היא מצד בחי' נס שבתוך נס שבנפש כנ\"ל,"
        },
        {
          "s": 18,
          "text": "הנה עי\"ז נעשה תרוממנה קרנות צדיק,"
        },
        {
          "s": 19,
          "text": "דלא רק שישנם הקרנות"
        },
        {
          "s": 20,
          "text": "(שעי\"ז כל קרני רשעים אגדע),"
        },
        {
          "s": 21,
          "text": "כ\"א שהם באופן של תרוממנה,"
        },
        {
          "s": 22,
          "text": "נס בתוך נס,"
        },
        {
          "s": 23,
          "text": "בחי' קץ הימין שלמעלה מימין דא\"א."
        },
        {
          "s": 24,
          "text": "שזהו החידוש דגאולה העתידה על הגאולה דיצי\"מ,"
        },
        {
          "s": 25,
          "text": "דיציאת מצרים היתה ע\"י זרועות דא\"א187,"
        },
        {
          "s": 26,
          "text": "שהן ב' בחי',"
        },
        {
          "s": 27,
          "text": "זרוע ימין וזרוע שמאל,"
        },
        {
          "s": 28,
          "text": "אבל תרוממנה קרנות צדיק הוא ימין דעתיק."
        },
        {
          "s": 29,
          "text": "ודוגמתו במצוות הן המצוות שאינם תלויין ברצונו של האדם,"
        },
        {
          "s": 30,
          "text": "כנ\"ל,"
        },
        {
          "s": 31,
          "text": "ואדרבה,"
        },
        {
          "s": 32,
          "text": "הרצון לנשיאות וכו' כנ\"ל מבלבל לקיום מצוות אלו."
        },
        {
          "s": 33,
          "text": "ובעבודה הו\"ע העבודה שלמעלה ממדוה\"ג,"
        },
        {
          "s": 34,
          "text": "שעומד בתוקף נגד ההעלמות וההסתרים ואינו משים לב אליהם,"
        },
        {
          "s": 35,
          "text": "בחי' הגורל הנ\"ל."
        }
      ]
    },
    {
      "v": 20,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "י)"
        },
        {
          "s": 2,
          "text": "והנה ע\"י העבודה דגורל הנ\"ל יחלק הארץ,"
        },
        {
          "s": 3,
          "text": "היינו שנעשה נוסף על כיבוש הארץ,"
        },
        {
          "s": 4,
          "text": "יחלק הארץ,"
        },
        {
          "s": 5,
          "text": "שהו\"ע ההתישבות."
        },
        {
          "s": 6,
          "text": "וכמו שאמרו רז\"ל188"
        },
        {
          "s": 7,
          "text": "דוירשתה וישבת בה189"
        },
        {
          "s": 8,
          "text": "דהיינו לאחרי שבע שכבשו ושבע שחלקו,"
        },
        {
          "s": 9,
          "text": "ואז הותחל עיקר ענין קיום המצוות התלויות בארץ."
        },
        {
          "s": 10,
          "text": "ועד\"ז בענין ארץ שלמעלה,"
        },
        {
          "s": 11,
          "text": "עוה\"ב,"
        },
        {
          "s": 12,
          "text": "שהוא שכר המצוות,"
        },
        {
          "s": 13,
          "text": "דזה שכל ישראל יש להם חלק לעולם הבא הוא מצד זה שישנה בחינת הגורל דאתה תומיך גורלי אצל כאו\"א מישראל."
        },
        {
          "s": 14,
          "text": "וגם מי שבגלוי אין ניכר אצלו ענין של טוב וקדושה,"
        },
        {
          "s": 15,
          "text": "יש לו בחי' גורל בנפשו,"
        },
        {
          "s": 16,
          "text": "ואדרבה יכול להיות שדוקא אצלו ישנה נשמה קדושה ביותר."
        },
        {
          "s": 17,
          "text": "ומשו\"ז יכול להפוך את עצמו בשעתא חדא וברגעא חדא שיהי' בתכלית השלימות דקדושה."
        },
        {
          "s": 18,
          "text": "ויובן זה עפ\"י המבואר בכ\"מ190"
        },
        {
          "s": 19,
          "text": "בענין מה שאמר ריב\"ז191"
        },
        {
          "s": 20,
          "text": "איני יודע באיזו דרך מוליכין אותי,"
        },
        {
          "s": 21,
          "text": "דאף שעבודתו היתה באופן נעלה ביותר כמבואר בכ\"מ192,"
        },
        {
          "s": 22,
          "text": "בכ\"ז אמר איני יודע כו',"
        },
        {
          "s": 23,
          "text": "כי הי' מסופק אם עבודתו מצד עצם נפשו"
        },
        {
          "s": 24,
          "text": "(בחי' הגורל הנ\"ל)"
        },
        {
          "s": 25,
          "text": "היא כדבעי,"
        },
        {
          "s": 26,
          "text": "כי אין ראי' מעבודתו בכחות הגלויים להבחי' שלמעלה מטו\"ד."
        },
        {
          "s": 27,
          "text": "ומרובה מדה טובה כו'193,"
        },
        {
          "s": 28,
          "text": "דגם אצל מי שבכחות הגלויים שלו אין נראה שום ענין טוב,"
        },
        {
          "s": 29,
          "text": "הנה אין מזה ראי' כלל על הבחי' שלמעלה מזה,"
        },
        {
          "s": 30,
          "text": "ובמיוחד שעל כאו\"א מישראל נאמר156"
        },
        {
          "s": 31,
          "text": "אשרנו כו' מה נעים גורלנו,"
        },
        {
          "s": 32,
          "text": "הרי ברור שישנה בו נשמה גדולה ביותר,"
        },
        {
          "s": 33,
          "text": "ויש לו הכח לאתהפכא ולהתגבר וכו' אפילו באם הי' אצלו ח\"ו העלם והסתר של שכלו ומחדו\"מ שלו במשך ימי חייו,"
        },
        {
          "s": 34,
          "text": "וע\"ד ראב\"ד שקנה עולמו בשעה אחת194."
        },
        {
          "s": 35,
          "text": "וכמו שהוא בענין חלוקת ארץ שלמעלה,"
        },
        {
          "s": 36,
          "text": "עוה\"ב,"
        },
        {
          "s": 37,
          "text": "שהיא מצד בחי' הגורל שישנה אצל כאו\"א מישראל,"
        },
        {
          "s": 38,
          "text": "עד\"ז הוא בענין כיבוש וחלוקת הארץ כפשוטה,"
        },
        {
          "s": 39,
          "text": "שהיא מצד בחי' הגורל שישנה אצל כאו\"א מישראל,"
        },
        {
          "s": 40,
          "text": "שלכן א\"י שייכת לבנ\"י בברית עולם לזרעך אחריך לאחוזת עולם195,"
        },
        {
          "s": 41,
          "text": "שהיא ירושה לנו מאברהם"
        },
        {
          "s": 42,
          "text": "(מפני קשט סלה),"
        },
        {
          "s": 43,
          "text": "מברית בין הבתרים."
        },
        {
          "s": 44,
          "text": "ארץ שבעה אומות,"
        },
        {
          "s": 45,
          "text": "ונוסף ע\"ז ירחיב ה\"א את גבולך196,"
        },
        {
          "s": 46,
          "text": "שהיא ארץ הקני קניזי וקדמוני197,"
        },
        {
          "s": 47,
          "text": "כמפורש בברית בין הבתרים ועוד יותר,"
        },
        {
          "s": 48,
          "text": "כמבואר במדרשי רז\"ל198"
        },
        {
          "s": 49,
          "text": "שירחיב ה\"א את גבולך היא עד להרחבה שלא בערך."
        }
      ]
    }
  ]
}