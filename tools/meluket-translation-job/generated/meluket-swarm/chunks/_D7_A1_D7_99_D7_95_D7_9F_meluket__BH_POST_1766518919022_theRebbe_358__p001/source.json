{
  "globalIndex": 886,
  "owner": 36,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518919022_theRebbe_358__p001",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518919022_theRebbe_358__p001",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518919022_theRebbe_358",
  "title": "מאמר ואהי אצלו אמון תשכ\"א",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "יום ב' דחג השבועות,"
        },
        {
          "s": 2,
          "text": "ה'תשכ\"א*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "(הנחה)"
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ואהי' אצלו אמון ואהי' שעשועים יום יום משחקת לפניו בכל עת גו' ושעשועי את בני אדם1."
        },
        {
          "s": 1,
          "text": "הנה מ\"ש ואהי' אצלו קאי גם על שעשועים,"
        },
        {
          "s": 2,
          "text": "היינו ואהי' אצלו שעשועים."
        },
        {
          "s": 3,
          "text": "והיינו,"
        },
        {
          "s": 4,
          "text": "דהגם שנאמר ושעשועי את בני אדם,"
        },
        {
          "s": 5,
          "text": "מ\"מ היא שעשועים גם אצלו,"
        },
        {
          "s": 6,
          "text": "כמבואר בקונטרס אחרון2"
        },
        {
          "s": 7,
          "text": "בענין דוד זמירות קרית להו3"
        },
        {
          "s": 8,
          "text": "שאמר זמירות היו לי חוקיך4,"
        },
        {
          "s": 9,
          "text": "שכל העולמות תלויים בדקדוק קל של תורה,"
        },
        {
          "s": 10,
          "text": "ונענש על זה,"
        },
        {
          "s": 11,
          "text": "לפי שאין זה עיקר ענין התורה שבה תלוי כל חיות העולמות,"
        },
        {
          "s": 12,
          "text": "כי אם עיקר ענין התורה הוא שהיא שמחת לב ושעשוע המלך הקב\"ה שמשתעשע בה,"
        },
        {
          "s": 13,
          "text": "וזש\"ה ואהי' אצלו שעשועים,"
        },
        {
          "s": 14,
          "text": "אצלו דוקא,"
        },
        {
          "s": 15,
          "text": "משחקת לפניו,"
        },
        {
          "s": 16,
          "text": "לפניו דוקא,"
        },
        {
          "s": 17,
          "text": "בפנימיות אין סוף."
        },
        {
          "s": 18,
          "text": "אלא שיש בזה כמה מדריגות,"
        },
        {
          "s": 19,
          "text": "ואהי' אצלו אמון,"
        },
        {
          "s": 20,
          "text": "שעשועים,"
        },
        {
          "s": 21,
          "text": "משחקת לפניו וגו',"
        },
        {
          "s": 22,
          "text": "עד ושעשועי את בני אדם,"
        },
        {
          "s": 23,
          "text": "כמבואר במק\"א5."
        },
        {
          "s": 24,
          "text": "וענין זה שהתורה היא ושעשועי את בני אדם הוא באין ערוך לבחינת שעשועים עצמיים דתורה,"
        },
        {
          "s": 25,
          "text": "שזהו עיקר התורה."
        },
        {
          "s": 26,
          "text": "ויש לומר בדרך אפשר,"
        },
        {
          "s": 27,
          "text": "שזהו ג\"כ מה שאמר הבעש\"ט6,"
        },
        {
          "s": 28,
          "text": "דכשם שכללות התורה כלולה בעשרת הדברות"
        },
        {
          "s": 29,
          "text": "(כמבואר באזהרות הרס\"ג7),"
        },
        {
          "s": 30,
          "text": "כמו\"כ כלולה כללות התורה בתיבת אנכי8,"
        },
        {
          "s": 31,
          "text": "דלכאורה,"
        },
        {
          "s": 32,
          "text": "הרי אנכי הוא אנכי מי שאנכי דלא אתרמיז לא בשום אות ולא בשום קוץ,"
        },
        {
          "s": 33,
          "text": "כמ\"ש בזהר9,"
        },
        {
          "s": 34,
          "text": "והתורה נמשכה למטה עד לשעשועי את בני אדם,"
        },
        {
          "s": 35,
          "text": "ומהו\"ע שכל התורה כלולה באנכי."
        },
        {
          "s": 36,
          "text": "וי\"ל הביאור בזה,"
        },
        {
          "s": 37,
          "text": "כי כל התורה היא שעשועים עצמיים של הקב\"ה,"
        },
        {
          "s": 38,
          "text": "ואהי' אצלו שעשועים,"
        },
        {
          "s": 39,
          "text": "אנכי."
        },
        {
          "s": 40,
          "text": "וזהו שאנכי הוא ראשי תיבות אנא נפשי כתבית יהבית10,"
        },
        {
          "s": 41,
          "text": "דאנכי מי שאנכי נתן עצמו בכל התורה כולה11."
        },
        {
          "s": 42,
          "text": "וע\"פ הידוע12"
        },
        {
          "s": 43,
          "text": "שההכנה למתן תורה הו\"ע יציאת מצרים וספירת העומר,"
        },
        {
          "s": 44,
          "text": "הרי מובן,"
        },
        {
          "s": 45,
          "text": "שבחי' ואהי' אצלו שעשועים שבתורה,"
        },
        {
          "s": 46,
          "text": "ישנו גם ביציאת מצרים ובספירת העומר."
        },
        {
          "s": 47,
          "text": "וזהו שכל ג' ענינים אלו נקראים בשם שבת13,"
        },
        {
          "s": 48,
          "text": "וכמ\"ש14"
        },
        {
          "s": 49,
          "text": "וספרתם לכם ממחרת השבת,"
        },
        {
          "s": 50,
          "text": "שלא נאמר ממחרת הפסח,"
        },
        {
          "s": 51,
          "text": "כי אם ממחרת השבת,"
        },
        {
          "s": 52,
          "text": "היינו שפסח שהו\"ע יציאת מצרים נקרא בשם שבת15."
        },
        {
          "s": 53,
          "text": "וכן כתיב16"
        },
        {
          "s": 54,
          "text": "שבע שבתות תמימות תהיינה,"
        },
        {
          "s": 55,
          "text": "שלא נאמר שבעה שבועות,"
        },
        {
          "s": 56,
          "text": "וכמ\"ש17"
        },
        {
          "s": 57,
          "text": "שבעה שבועות תספר לך,"
        },
        {
          "s": 58,
          "text": "כי אם שבע שבתות דוקא,"
        },
        {
          "s": 59,
          "text": "לפי שספירת העומר הוא ג\"כ בחינת שבת."
        },
        {
          "s": 60,
          "text": "וכן כתיב14"
        },
        {
          "s": 61,
          "text": "עד ממחרת השבת השביעית תספרו חמישים יום,"
        },
        {
          "s": 62,
          "text": "שלא נאמר עד ממחרת השבוע השביעית,"
        },
        {
          "s": 63,
          "text": "כי אם ממחרת השבת השביעית,"
        },
        {
          "s": 64,
          "text": "שקאי על חג השבועות,"
        },
        {
          "s": 65,
          "text": "זמן מתן תורה,"
        },
        {
          "s": 66,
          "text": "שנקרא בשם שבת,"
        },
        {
          "s": 67,
          "text": "והכל מודים דבשבת ניתנה תורה18."
        },
        {
          "s": 68,
          "text": "והיינו לפי שבכל ג' ענינים אלו ישנו המשכת בחינת ואהי' אצלו שעשועים,"
        },
        {
          "s": 69,
          "text": "ולכן נקראים כולם בשם שבת,"
        },
        {
          "s": 70,
          "text": "כמו שיתבאר להלן."
        }
      ]
    }
  ]
}