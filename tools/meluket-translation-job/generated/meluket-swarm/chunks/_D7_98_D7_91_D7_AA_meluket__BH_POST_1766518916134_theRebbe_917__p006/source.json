{
  "globalIndex": 417,
  "owner": 17,
  "jobId": "_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916134_theRebbe_917__p006",
  "batchId": "meluket-_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916134_theRebbe_917__p006",
  "seriesId": "טבת_meluket",
  "postId": "BH_POST_1766518916134_theRebbe_917",
  "title": "מאמר ויגש אליו יהודה תשכ\"ה",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 1,
          "text": "שע\"י שרבי העמיד אותם לפני התיבה ועשה אותם לשלוחי ציבור דכל ישראל,"
        },
        {
          "s": 2,
          "text": "פעל זה על כל ישראל"
        },
        {
          "s": 3,
          "text": "(גם על אלו שלא ידעו כלל מכל הענין)52"
        },
        {
          "s": 4,
          "text": "שיהיו נגררים אחרי הציבור שהיו בשעת תפלת ר\"ח ובניו,"
        },
        {
          "s": 5,
          "text": "ומכש\"כ אחרי ר\"ח ובניו עצמם"
        },
        {
          "s": 6,
          "text": "(השלוחי ציבור),"
        },
        {
          "s": 7,
          "text": "ולכן,"
        },
        {
          "s": 8,
          "text": "ההתעוררות דהציבור שהיו בשעת התפלה,"
        },
        {
          "s": 9,
          "text": "ותפלתם של ר\"ח ובניו,"
        },
        {
          "s": 10,
          "text": "פעלו בפנימיות על כל ישראל,"
        },
        {
          "s": 11,
          "text": "ועי\"ז בטלו המסכים."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "והנה זה שנתבאר לעיל"
        },
        {
          "s": 2,
          "text": "(סעיף ד)"
        },
        {
          "s": 3,
          "text": "דהמשכת האור שלמעלה מהשתלשלות שע\"י תפלה היא שעל ידו נעשה שינוי בעניני העולם"
        },
        {
          "s": 4,
          "text": "(ולא שהאור עצמו נמשך למטה),"
        },
        {
          "s": 5,
          "text": "הוא בתפלה כמו שהיא מצד עצמה."
        },
        {
          "s": 6,
          "text": "אבל כשהתפלה היא באופן שיש בה גם ענין התורה,"
        },
        {
          "s": 7,
          "text": "יש לומר,"
        },
        {
          "s": 8,
          "text": "שבההמשכה שע\"י תפלה זו,"
        },
        {
          "s": 9,
          "text": "ישנם שתי המעלות."
        },
        {
          "s": 10,
          "text": "ששרש ההמשכה הוא למעלה מעלה עד אין קץ,"
        },
        {
          "s": 11,
          "text": "ושהאור עצמו נמשך למטה."
        },
        {
          "s": 12,
          "text": "היינו,"
        },
        {
          "s": 13,
          "text": "דבהשינוי שנעשה בהעולם"
        },
        {
          "s": 14,
          "text": "(שהחולה מתרפא וכיו\"ב)"
        },
        {
          "s": 15,
          "text": "נרגש בגילוי לא רק השינוי בעולם"
        },
        {
          "s": 16,
          "text": "(התוצאה מההמשכה)"
        },
        {
          "s": 17,
          "text": "אלא גם האור האלקי שעל ידו נעשה השינוי."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "ויש לקשר זה עם המבואר לעיל"
        },
        {
          "s": 1,
          "text": "(סעיף ג)"
        },
        {
          "s": 2,
          "text": "שהבקשה אד' שפתי תפתח ופי יגיד תהלתך שבתחלת תפלת שמו\"ע היא שתפלת האדם תהי' באופן שעל ידה תומשך תהלתך,"
        },
        {
          "s": 3,
          "text": "תפלתו של הקב\"ה,"
        },
        {
          "s": 4,
          "text": "דכשהתפלה היא באופן זה ישנם בה שתי המעלות."
        },
        {
          "s": 5,
          "text": "המעלה דתפלה – עבודת המטה"
        },
        {
          "s": 6,
          "text": "[שמגעת למעלה מעלה עד אין קץ,"
        },
        {
          "s": 7,
          "text": "למעשה ידיך תכסוף],"
        },
        {
          "s": 8,
          "text": "והמעלה דתורה – המשכה מלמעלה."
        },
        {
          "s": 9,
          "text": "וע\"י החיבור דשני הענינים בעבודת התפלה,"
        },
        {
          "s": 10,
          "text": "שגם בקשת האדם היא באופן דפי יגיד תהלתך,"
        },
        {
          "s": 11,
          "text": "עי\"ז,"
        },
        {
          "s": 12,
          "text": "גם בההמשכה שע\"י התפלה ישנם"
        },
        {
          "s": 13,
          "text": "(דוגמת)"
        },
        {
          "s": 14,
          "text": "שני הענינים."
        },
        {
          "s": 15,
          "text": "שעל ידה נעשה שינוי בהמטה,"
        },
        {
          "s": 16,
          "text": "ושהשינוי בהמטה הוא באופן שנרגש בו האור האלקי שעל ידו נעשה השינוי."
        }
      ]
    }
  ]
}