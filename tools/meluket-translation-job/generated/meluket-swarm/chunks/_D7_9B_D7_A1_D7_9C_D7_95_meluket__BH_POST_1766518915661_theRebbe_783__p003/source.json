{
  "globalIndex": 333,
  "owner": 33,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915661_theRebbe_783__p003",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915661_theRebbe_783__p003",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915661_theRebbe_783",
  "title": "מאמר פדה בשלום תשכ\"ו",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 2,
          "text": "שההמשכה שע\"י הברכה דחסידיך היא ע\"ד ההמשכה שע\"י תורה."
        },
        {
          "s": 3,
          "text": "דע\"י התורה נעשה שינוי וחידוש בעולם"
        },
        {
          "s": 4,
          "text": "[היינו שנעשה דבר חדש שלא הי' גם בשורש ומקור העולם],"
        },
        {
          "s": 5,
          "text": "והשינוי והחידוש הוא"
        },
        {
          "s": 6,
          "text": "(לא בדרך בקשה,"
        },
        {
          "s": 7,
          "text": "כבתפלה אלא)"
        },
        {
          "s": 8,
          "text": "בדרך ממילא."
        },
        {
          "s": 9,
          "text": "וכמו רשב\"י שהמשיך ירידת גשמים ע\"י אמירת תורה19,"
        },
        {
          "s": 10,
          "text": "דבכדי שתהי' ירידת גשמים לאחרי שנגזר שתהי' עצירת גשמים,"
        },
        {
          "s": 11,
          "text": "הוא ע\"י המשכת רצון חדש,"
        },
        {
          "s": 12,
          "text": "ואעפ\"כ ע\"י אמירת תורה,"
        },
        {
          "s": 13,
          "text": "היתה ההמשכה בדרך ממילא,"
        },
        {
          "s": 14,
          "text": "בלי עבודה ויגיעה."
        },
        {
          "s": 15,
          "text": "ויש לומר,"
        },
        {
          "s": 16,
          "text": "דמ\"ש בהמאמר שההמשכה שע\"י הברכה דחסידיך היא כמו ההמשכה שע\"י תורה,"
        },
        {
          "s": 17,
          "text": "הוא לא רק בכדי להביא דוגמא מהמשכה שיש בה שתי המעלות"
        },
        {
          "s": 18,
          "text": "(דתפלה ודברכה)"
        },
        {
          "s": 19,
          "text": "אלא גם לפי שע\"י דוגמא זו מיתוסף ביאור בהעילוי דחסידיך יברכוכה."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "והענין הוא,"
        },
        {
          "s": 1,
          "text": "דמבואר בלקו\"ת20"
        },
        {
          "s": 2,
          "text": "בענין המופתים העצומים שעשו כמה תנאים ואמוראים,"
        },
        {
          "s": 3,
          "text": "כמו רפב\"י שאמר גינאי נהרא חלוק לי מימיך21,"
        },
        {
          "s": 4,
          "text": "כי ע\"י עסק התורה שלהם המשיכו גילוי אוא\"ס שלמעלה מהשתלשלות."
        },
        {
          "s": 5,
          "text": "ועפ\"ז,"
        },
        {
          "s": 6,
          "text": "גם בההמשכה שע\"י עסק התורה דכל התנאים ואמוראים היו שני ענינים"
        },
        {
          "s": 7,
          "text": "(מעלות)"
        },
        {
          "s": 8,
          "text": "הנ\"ל."
        },
        {
          "s": 9,
          "text": "שע\"י עסק התורה שלהם נעשה שינוי וחידוש בהעולם"
        },
        {
          "s": 10,
          "text": "[חידוש אמיתי שלא הי' גם בשורש ומקור העולם22],"
        },
        {
          "s": 11,
          "text": "וכמו חלוקת הנהר,"
        },
        {
          "s": 12,
          "text": "שהוא שינוי וחידוש גם לגבי שרשו ומקורו דהנהר23"
        },
        {
          "s": 13,
          "text": "– המעלה דתפלה,"
        },
        {
          "s": 14,
          "text": "ושהשינוי נעשה"
        },
        {
          "s": 15,
          "text": "(לא ע\"י בקשה,"
        },
        {
          "s": 16,
          "text": "אלא)"
        },
        {
          "s": 17,
          "text": "ע\"י הציווי של רפב\"י – המעלה דברכה שהיא בדרך ציווי."
        },
        {
          "s": 18,
          "text": "ויש לומר,"
        },
        {
          "s": 19,
          "text": "שהחידוש בזה שרשב\"י המשיך ירידת גשמים ע\"י אמירת תורה לגבי המופתים העצומים שעשו כמה תנאים ואמוראים ע\"י עסק התורה שלהם הוא24,"
        },
        {
          "s": 20,
          "text": "שהשינוי בעולם שעשו כל התנאים ואמוראים הוא ע\"י הציווי והגזירה שלהם,"
        },
        {
          "s": 21,
          "text": "וכמו רפב\"י שציוה וגזר על הנהר שיחלוק את מימיו,"
        },
        {
          "s": 22,
          "text": "והחידוש דירידת מטר ע\"י אמירת תורה דרשב\"י הוא,"
        },
        {
          "s": 23,
          "text": "דהגם שבהדרוש שאמר לא הי' ציווי כלל"
        },
        {
          "s": 24,
          "text": "(גם לא ברמז),"
        },
        {
          "s": 25,
          "text": "מ\"מ,"
        },
        {
          "s": 26,
          "text": "ע\"י אמירת תורה שלו נעשה ירידת גשמים."
        },
        {
          "s": 27,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 28,
          "text": "דזה שמביא בהמאמר הדוגמא דירידת גשמים ע\"י אמירת תורה הוא בכדי לרמז שעד\"ז הוא ההמשכה שע\"י הברכה דחסידיך יברכוכה"
        },
        {
          "s": 29,
          "text": "(כדלקמן סעיף יב)."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ומבאר בהמאמר השייכות דיברכו כה"
        },
        {
          "s": 2,
          "text": "[ההמשכה במלכות"
        },
        {
          "s": 3,
          "text": "(כה)"
        },
        {
          "s": 4,
          "text": "מאוא\"ס שלמעלה מהשתלשלות]"
        },
        {
          "s": 5,
          "text": "לחסידיך,"
        },
        {
          "s": 6,
          "text": "ע\"פ מ\"ש הרמב\"ם25"
        },
        {
          "s": 7,
          "text": "החילוק שבין חסד לצדקה,"
        },
        {
          "s": 8,
          "text": "דצדקה הו\"ע היושר"
        },
        {
          "s": 9,
          "text": "(צדקה מלשון צדק ויושר)"
        },
        {
          "s": 10,
          "text": "לתת לכל אחד כפי הראוי לו,"
        },
        {
          "s": 11,
          "text": "וחסד הוא הפלגת הטוב להטיב יותר ממה שהוא ראוי."
        },
        {
          "s": 12,
          "text": "ומביא בהמאמר,"
        },
        {
          "s": 13,
          "text": "דמ\"ש הרמב\"ם שצדקה הוא ההשפעה לכל אחד כפי הראוי לו הוא כמ\"ש"
        },
        {
          "s": 14,
          "text": "(גבי מצות צדקה26)"
        },
        {
          "s": 15,
          "text": "די מחסורו אשר יחסר לו,"
        },
        {
          "s": 16,
          "text": "ואמרו רז\"ל27"
        },
        {
          "s": 17,
          "text": "די מחסורו ואי אתה מצווה לעשרו."
        },
        {
          "s": 18,
          "text": "והחסד"
        },
        {
          "s": 19,
          "text": "[שהוא הפלגת הטוב להטיב יותר ממה שהוא ראוי]"
        },
        {
          "s": 20,
          "text": "הוא השפעה בריבוי"
        },
        {
          "s": 21,
          "text": "(למעלה ממילוי החסרון),"
        },
        {
          "s": 22,
          "text": "עשירות."
        },
        {
          "s": 23,
          "text": "ועד\"ז הוא למעלה בההמשכה בספירת המלכות,"
        },
        {
          "s": 24,
          "text": "דענין הצדקה הוא המשכת הגילוי ששייך למלכות,"
        },
        {
          "s": 25,
          "text": "שעי\"ז נתמלא החסרון שלה."
        },
        {
          "s": 26,
          "text": "[וכידוע28"
        },
        {
          "s": 27,
          "text": "בענין את עשית את השמים גו'29,"
        },
        {
          "s": 28,
          "text": "את חסר ה',"
        },
        {
          "s": 29,
          "text": "דזה שהמלכות נעשית מקור להוות את העולמות"
        },
        {
          "s": 30,
          "text": "(עשית את השמים גו')"
        },
        {
          "s": 31,
          "text": "הוא ע\"י שנחסרו ממנה ה' פרצופים"
        },
        {
          "s": 32,
          "text": "(כתר,"
        },
        {
          "s": 33,
          "text": "חכמה,"
        },
        {
          "s": 34,
          "text": "בינה,"
        },
        {
          "s": 35,
          "text": "ז\"א ומלכות,"
        },
        {
          "s": 36,
          "text": "וזה שנשאר הוא רק חיצוניות המלכות,"
        },
        {
          "s": 37,
          "text": "מלכות דמלכות)]."
        },
        {
          "s": 38,
          "text": "וענין החסד הוא המשכת גילוי אור שלמעלה משייכות למלכות שנמשך במלכות."
        },
        {
          "s": 39,
          "text": "וזהו שאמרו רז\"ל30"
        },
        {
          "s": 40,
          "text": "איזהו חסיד המתחסד עם קונו,"
        },
        {
          "s": 41,
          "text": "ומפרש בתקו\"ז31,"
        },
        {
          "s": 42,
          "text": "עם קונו – עם קן דילי',"
        },
        {
          "s": 43,
          "text": "קונו הוא ז\"א"
        },
        {
          "s": 44,
          "text": "(כי אצילות נק' קנין32,"
        },
        {
          "s": 45,
          "text": "וז\"א הוא סוף האצילות33),"
        },
        {
          "s": 46,
          "text": "וקן דילי' הוא המלכות"
        },
        {
          "s": 47,
          "text": "(כמ\"ש בפרדס34"
        },
        {
          "s": 48,
          "text": "שהמלכות נקראת קן),"
        },
        {
          "s": 49,
          "text": "וענין המתחסד עם קן דילי' הוא שממשיך במלכות גילוי אור חדש"
        },
        {
          "s": 50,
          "text": "(שלמעלה מהאור שנסתלק ממנה),"
        },
        {
          "s": 51,
          "text": "עשירות."
        },
        {
          "s": 52,
          "text": "ובענין הספירות הוא פנימיות הכתר,"
        },
        {
          "s": 53,
          "text": "עתיק."
        },
        {
          "s": 54,
          "text": "שההמשכה דחיצוניות הכתר,"
        },
        {
          "s": 55,
          "text": "אריך,"
        },
        {
          "s": 56,
          "text": "הוא בכלל מילוי החסרון35."
        },
        {
          "s": 57,
          "text": "דכיון שאריך הוא שורש ומקור הנאצלים אלא שהוא מקיף עליהם"
        },
        {
          "s": 58,
          "text": "(סובב),"
        },
        {
          "s": 59,
          "text": "הוא בכלל האור השייך לעולמות"
        },
        {
          "s": 60,
          "text": "(מלכות),"
        },
        {
          "s": 61,
          "text": "ולכן,"
        },
        {
          "s": 62,
          "text": "כשאור זה אינו מתגלה במלכות,"
        },
        {
          "s": 63,
          "text": "המלכות היא חסירה,"
        },
        {
          "s": 64,
          "text": "וע\"י שנמשך ומתגלה,"
        },
        {
          "s": 65,
          "text": "נתמלא החסרון36."
        },
        {
          "s": 66,
          "text": "ועתיק הוא בחינה תחתונה שבמאציל,"
        },
        {
          "s": 67,
          "text": "אוא\"ס שלמעלה משייכות לעולמות"
        },
        {
          "s": 68,
          "text": "(למעלה גם משייכות באופן דסובב ומקיף),"
        },
        {
          "s": 69,
          "text": "עשירות36."
        }
      ]
    }
  ]
}