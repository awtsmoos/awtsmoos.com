{
  "globalIndex": 32,
  "owner": 32,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913852_theRebbe_463__p004",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913852_theRebbe_463__p004",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518913852_theRebbe_463",
  "title": "מאמר זה היום תחילת מעשיך תשמ\"ב",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה זה שישראל ע\"י עבודתם"
        },
        {
          "s": 2,
          "text": "(שמזכירים אופן ההתהוות שהיתה ביום הראשון)"
        },
        {
          "s": 3,
          "text": "ממשיכים הגילוי הנ\"ל מגיע בשרשו עד בחפץ חסד מצד עצמו ואין אתעדל\"ת מגעת לשם,"
        },
        {
          "s": 4,
          "text": "כי השרש דישראל הוא למעלה יותר גם מהענין דחפץ חסד."
        },
        {
          "s": 5,
          "text": "וכידוע בענין במי נמלך בנשמותיהן של צדיקים36"
        },
        {
          "s": 6,
          "text": "(ועמך כולם צדיקים37),"
        },
        {
          "s": 7,
          "text": "דזה שנתעורר כביכול להיות חפץ חסד הוא מצד זה שעלה במחשבה38"
        },
        {
          "s": 8,
          "text": "(מחשבה עצמית,"
        },
        {
          "s": 9,
          "text": "שלמעלה מהגילוי דחפץ חסד)"
        },
        {
          "s": 10,
          "text": "שעתידין ישראל לקיים תומ\"צ ולעשות דירה לו ית' בתחתונים39."
        },
        {
          "s": 11,
          "text": "ולכן,"
        },
        {
          "s": 12,
          "text": "ע\"י העבודה דישראל נמשך"
        },
        {
          "s": 13,
          "text": "[ונעשה40]"
        },
        {
          "s": 14,
          "text": "גם הגילוי דחפץ חסד."
        },
        {
          "s": 15,
          "text": "ומזה מובן,"
        },
        {
          "s": 16,
          "text": "שהגילוי דחפץ חסד שנעשה עכשיו ע\"י מעשינו ועבודתינו,"
        },
        {
          "s": 17,
          "text": "הוא נעלה יותר מכמו שהי' גילוי זה בתחלת הבריאה,"
        },
        {
          "s": 18,
          "text": "כי ע\"י מעשינו ועבודתינו נעשה נחת רוח למעלה,"
        },
        {
          "s": 19,
          "text": "נח\"ר לפני שאמרתי ונעשה רצוני41,"
        },
        {
          "s": 20,
          "text": "דנח\"ר ותענוג זה"
        },
        {
          "s": 21,
          "text": "(שנעשה רצוני,"
        },
        {
          "s": 22,
          "text": "ע\"י ישראל)"
        },
        {
          "s": 23,
          "text": "הוא בעצמותו ית'"
        },
        {
          "s": 24,
          "text": "(נח\"ר לפני)"
        },
        {
          "s": 25,
          "text": "שלמעלה מהתענוג דחפץ חסד,"
        },
        {
          "s": 26,
          "text": "וע\"י שהגילוי דחפץ חסד נתעורר ונמשך ע\"י עבודת האדם,"
        },
        {
          "s": 27,
          "text": "נמשך בו הנח\"ר והתענוג דנעשה רצוני42."
        },
        {
          "s": 28,
          "text": "וזהו גם הטעם"
        },
        {
          "s": 29,
          "text": "(הפנימי)"
        },
        {
          "s": 30,
          "text": "על זה שלפני שאומרים שראש השנה הוא זכרון ליום ראשון אומרים שהוא תחלת מעשיך,"
        },
        {
          "s": 31,
          "text": "דזכרון ליום ראשון שלאחרי קדימת הענין דתחלת מעשיך"
        },
        {
          "s": 32,
          "text": "(המשכת הגילוי דחפץ חסד שלאחרי קדימת העבודה)"
        },
        {
          "s": 33,
          "text": "הוא נעלה יותר מכמו שהוא מצד עצמו,"
        },
        {
          "s": 34,
          "text": "כמו שהי' בתחלת הבריאה."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והגם שגם הגילוי דחפץ חסד שהי' תחלה,"
        },
        {
          "s": 2,
          "text": "שרש המשכתו הוא מהתענוג עצמי בעבודתם של ישראל"
        },
        {
          "s": 3,
          "text": "[וכנ\"ל,"
        },
        {
          "s": 4,
          "text": "שזהו הסיבה לזה שנתעורר להיות חפץ חסד],"
        },
        {
          "s": 5,
          "text": "מ\"מ,"
        },
        {
          "s": 6,
          "text": "ע\"י עבודתם של ישראל בפועל,"
        },
        {
          "s": 7,
          "text": "ניתוסף עילוי נעלה יותר,"
        },
        {
          "s": 8,
          "text": "וכמובן מזה שבכדי שתושלם הכוונה דנתאוה הקב\"ה להיות לו ית' דירה בתחתונים43"
        },
        {
          "s": 9,
          "text": "הוצרך להיות בריאת העולמות בפועל,"
        },
        {
          "s": 10,
          "text": "עד לעולם הזה התחתון44,"
        },
        {
          "s": 11,
          "text": "ואח\"כ הוצרך להיות מתן תורה שאז דוקא נעשה התוקף דקיום העולם כמארז\"ל45"
        },
        {
          "s": 12,
          "text": "עה\"פ46"
        },
        {
          "s": 13,
          "text": "ארץ יראה ושקטה,"
        },
        {
          "s": 14,
          "text": "ואח\"כ צ\"ל עבודת האדם"
        },
        {
          "s": 15,
          "text": "(שלאחרי מ\"ת)"
        },
        {
          "s": 16,
          "text": "בפועל,"
        },
        {
          "s": 17,
          "text": "לימוד התורה,"
        },
        {
          "s": 18,
          "text": "ובאופן דגדול לימוד שמביא לידי מעשה47"
        },
        {
          "s": 19,
          "text": "בקיום המצוות בפועל – אף שכל זה הי' בידיעתו ובמחשבתו ית' גם מקודם"
        },
        {
          "s": 20,
          "text": "(ומחשבה זו היא הסיבה לזה שנתעורר להיות חפץ חסד)"
        },
        {
          "s": 21,
          "text": "– כי המחשבה שהיתה מקודם היא מחשבה עצמית שבעצמותו ית' שלמעלה מגילוי,"
        },
        {
          "s": 22,
          "text": "וזה שמצד מחשבה זו נעשה ההתעוררות דחפץ חסד הוא רק באופן דהבדלה"
        },
        {
          "s": 23,
          "text": "[היינו,"
        },
        {
          "s": 24,
          "text": "שהמחשבה נשארה בעצמותה ולא נמשכה בהענין דחפץ חסד48,"
        },
        {
          "s": 25,
          "text": "והענין דחפץ חסד שנעשה עי\"ז הוא רק החפץ והתענוג בחסד,"
        },
        {
          "s": 26,
          "text": "גילויים],"
        },
        {
          "s": 27,
          "text": "וע\"י עבודת האדם בפועל,"
        },
        {
          "s": 28,
          "text": "נעשה גילוי העצמות49,"
        },
        {
          "s": 29,
          "text": "דירה לו ית',"
        },
        {
          "s": 30,
          "text": "לו לעצמותו50."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וזהו51 שהשלימות דעולם שתהי' לע\"ל,"
        },
        {
          "s": 2,
          "text": "אלה תולדות פרץ52"
        },
        {
          "s": 3,
          "text": "תולדות מלא53,"
        },
        {
          "s": 4,
          "text": "תהי' נעלית יותר מהשלימות שהיתה בתחלת הבריאה,"
        },
        {
          "s": 5,
          "text": "אלה תולדות השמים והארץ בהבראם54"
        },
        {
          "s": 6,
          "text": "תולדות מלא53,"
        },
        {
          "s": 7,
          "text": "עולם על מילואו נברא55,"
        },
        {
          "s": 8,
          "text": "שהשלימות דעולם כמו שהוא מצד הבריאה"
        },
        {
          "s": 9,
          "text": "[אלה תולדות"
        },
        {
          "s": 10,
          "text": "(מלא)"
        },
        {
          "s": 11,
          "text": "גו' בהבראם,"
        },
        {
          "s": 12,
          "text": "עולם על מילואו נברא]"
        },
        {
          "s": 13,
          "text": "היא במדידה והגבלה."
        },
        {
          "s": 14,
          "text": "דכיון שהגדר דעולם הוא מדידה והגבלה,"
        },
        {
          "s": 15,
          "text": "הרי מובן,"
        },
        {
          "s": 16,
          "text": "שגם השלימות שלו היא במדידה והגבלה."
        },
        {
          "s": 17,
          "text": "והגם שהבריאה היתה מצד זה שחפץ חסד הוא,"
        },
        {
          "s": 18,
          "text": "שהוא למעלה מהגבלה"
        },
        {
          "s": 19,
          "text": "(כנ\"ל סעיף ד),"
        },
        {
          "s": 20,
          "text": "הרי הענין דחפץ חסד הוא רק הסיבה להבריאה,"
        },
        {
          "s": 21,
          "text": "אבל הבריאה עצמה היתה באופן דהשתלשלות מעלה ומטה42."
        },
        {
          "s": 22,
          "text": "משא\"כ השלימות שתהי' לע\"ל,"
        },
        {
          "s": 23,
          "text": "מכיון שנעשית ע\"י עבודת האדם שעי\"ז נמשך גילוי התענוג העצמי שבעצמותו ית'"
        },
        {
          "s": 24,
          "text": "(שאין שייך בו שום גדר),"
        },
        {
          "s": 25,
          "text": "לכן56"
        },
        {
          "s": 26,
          "text": "השלימות דעולם לע\"ל תהי' למעלה ממדידה והגבלה,"
        },
        {
          "s": 27,
          "text": "אלה תולדות פרץ,"
        },
        {
          "s": 28,
          "text": "דענין פרץ"
        },
        {
          "s": 29,
          "text": "[שנקרא כן על שם מה פרצת עליך פרץ57]"
        },
        {
          "s": 30,
          "text": "הוא שפורץ כל המדידות וההגבלות."
        }
      ]
    }
  ]
}