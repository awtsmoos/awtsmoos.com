{
  "globalIndex": 367,
  "owner": 17,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915857_theRebbe_394__p002",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915857_theRebbe_394__p002",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915857_theRebbe_394",
  "title": "מאמר ת\"ר מצות נר חנוכה תשל\"ח",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "וביאור הענין בעבודת האדם יובן בהקדים המבואר בדרושי כ\"ק מו\"ח אדמו\"ר29,"
        },
        {
          "s": 2,
          "text": "דזה שהיונים טימאו את השמנים שבהיכל הוא מפני שכל מלחמתם היתה מלחמה רוחנית,"
        },
        {
          "s": 3,
          "text": "שלא רצו לפגוע בגופם של ישראל30"
        },
        {
          "s": 4,
          "text": "אלא עיקר רצונם הי' להשכיחם תורתך ולהעבירם מחוקי רצונך21."
        },
        {
          "s": 5,
          "text": "וגם בזה גופא"
        },
        {
          "s": 6,
          "text": "(בזה שלחמו נגד התומ\"צ),"
        },
        {
          "s": 7,
          "text": "עיקר מלחמתם היתה נגד הרוחניות"
        },
        {
          "s": 8,
          "text": "(והאלקות)31"
        },
        {
          "s": 9,
          "text": "דתומ\"צ32."
        },
        {
          "s": 10,
          "text": "דזהו להשכיחם תורתך"
        },
        {
          "s": 11,
          "text": "(תורתך דוקא),"
        },
        {
          "s": 12,
          "text": "שגם להיונים לא הי' איכפת"
        },
        {
          "s": 13,
          "text": "(כ\"כ)"
        },
        {
          "s": 14,
          "text": "שישראל ילמדו תורה,"
        },
        {
          "s": 15,
          "text": "אלא שרצו שלימוד התורה יהי' רק מצד השכל שבתורה,"
        },
        {
          "s": 16,
          "text": "כי היא חכמתכם ובינתכם לעיני העמים33,"
        },
        {
          "s": 17,
          "text": "וכל עיקר מלחמתם היתה שביקשו להשכיחם תורתך,"
        },
        {
          "s": 18,
          "text": "להשכיח ח\"ו את ישראל שהתורה היא תורת הוי'."
        },
        {
          "s": 19,
          "text": "ועד\"ז במצוות,"
        },
        {
          "s": 20,
          "text": "שמלחמת היונים היתה נגד האלקות שבמצוות,"
        },
        {
          "s": 21,
          "text": "מה שהמצוות הם רצונו ית' דזהו להעבירם מחוקי רצונך"
        },
        {
          "s": 22,
          "text": "(חוקי דוקא ורצונך דוקא),"
        },
        {
          "s": 23,
          "text": "דשני פירושים בזה."
        },
        {
          "s": 24,
          "text": "שעל המצוות דעדות ומשפטים,"
        },
        {
          "s": 25,
          "text": "להיותם מצוות שכליות,"
        },
        {
          "s": 26,
          "text": "הסכימו גם היונים,"
        },
        {
          "s": 27,
          "text": "וכל מלחמתם היתה כנגד המצוות דחוקים,"
        },
        {
          "s": 28,
          "text": "מכיון שאופן קיומם הוא רק מפני שהם רצון הוי'."
        },
        {
          "s": 29,
          "text": "ופירוש ב'"
        },
        {
          "s": 30,
          "text": "(בעומק יותר),"
        },
        {
          "s": 31,
          "text": "דזה מה שביקשו להעבירם מחוקי רצונך הוא בכל המצוות,"
        },
        {
          "s": 32,
          "text": "גם בהמצוות דעדות ומשפטים34."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ויובן זה ע\"פ הידוע35,"
        },
        {
          "s": 2,
          "text": "שגם המצוות דעדות ומשפטים צריך לקיים"
        },
        {
          "s": 3,
          "text": "(בעיקר)"
        },
        {
          "s": 4,
          "text": "מפני שהם רצון ה',"
        },
        {
          "s": 5,
          "text": "כמו החוקים."
        },
        {
          "s": 6,
          "text": "וענין זה"
        },
        {
          "s": 7,
          "text": "(שגם המצוות שיש עליהם טעם צריך לקיימם מפני שהם רצון ה')"
        },
        {
          "s": 8,
          "text": "הוא לא רק מצד האדם המקיים,"
        },
        {
          "s": 9,
          "text": "שקיום המצוות שלו צריך להיות בדרך עבודת עבד36,"
        },
        {
          "s": 10,
          "text": "שזהו דוקא כשמקיים את המצוות"
        },
        {
          "s": 11,
          "text": "(לא מצד הטעם והשכל,"
        },
        {
          "s": 12,
          "text": "כי אם)"
        },
        {
          "s": 13,
          "text": "מצד ציווי האדון37,"
        },
        {
          "s": 14,
          "text": "אלא גם מצד המצוות,"
        },
        {
          "s": 15,
          "text": "כי כל המצוות"
        },
        {
          "s": 16,
          "text": "(גם המצוות שיש עליהם טעם)"
        },
        {
          "s": 17,
          "text": "הם רצונו ית',"
        },
        {
          "s": 18,
          "text": "רצון שלמעלה מהטעם38,"
        },
        {
          "s": 19,
          "text": "ורק שכך גזר הקב\"ה שהרצון דמצוות אלו יתלבש גם בטעם39."
        },
        {
          "s": 20,
          "text": "ולא עוד,"
        },
        {
          "s": 21,
          "text": "אלא שגם טעמי המצוות"
        },
        {
          "s": 22,
          "text": "(כמו שהם לאמיתתם)"
        },
        {
          "s": 23,
          "text": "הם למעלה מההבנה דשכל אנושי,"
        },
        {
          "s": 24,
          "text": "דאמיתית טעמי המצוות הוא כמו שהם בחכמתו ית',"
        },
        {
          "s": 25,
          "text": "ומכיון שגם חכמתו ית' היא אין סוף"
        },
        {
          "s": 26,
          "text": "(ובפרט שהוא ית' וחכמתו אחד40),"
        },
        {
          "s": 27,
          "text": "הרי אין שייך ששכל מוגבל דהנבראים יוכל להשיג אמיתית הטעם דהמצוות,"
        },
        {
          "s": 28,
          "text": "וכמ\"ש באגה\"ק41"
        },
        {
          "s": 29,
          "text": "שטעמי מצוות לא נתגלו והם למעלה מהשכל וההבנה,"
        },
        {
          "s": 30,
          "text": "וגם באיזהו מקומן שנתגלה ונתפרש איזה טעם המובן לנו לכאורה,"
        },
        {
          "s": 31,
          "text": "הנה טעם זה המובן לנו אינו תכלית הטעם כו'."
        },
        {
          "s": 32,
          "text": "וענין זה"
        },
        {
          "s": 33,
          "text": "(שהטעם המובן לנו אינו תכלית הטעם)"
        },
        {
          "s": 34,
          "text": "מובן גם בשכל אנושי."
        },
        {
          "s": 35,
          "text": "שהרי גם שכל אנושי מבין בפשטות,"
        },
        {
          "s": 36,
          "text": "ששכל מוגבל אין ביכלתו להשיג חכמתו ית' הבלתי מוגבלת."
        },
        {
          "s": 37,
          "text": "ואדרבא,"
        },
        {
          "s": 38,
          "text": "זה שבאיזהו מקומן נתגלה ונתפרש איזה טעם המובן לנו הוא פלא גדול,"
        },
        {
          "s": 39,
          "text": "והוא רק חסד ה' שגם שכל האדם יהי' לו איזו השגה בזה."
        },
        {
          "s": 40,
          "text": "וגם לאחרי שבחסד ה' נתגלה ונתפרש טעם המובן לנו,"
        },
        {
          "s": 41,
          "text": "הרי ידוע42"
        },
        {
          "s": 42,
          "text": "שהטעם הוא רק על כללות המצוה ולא על הפרטים."
        },
        {
          "s": 43,
          "text": "שמכל זה מובן,"
        },
        {
          "s": 44,
          "text": "שגם המצוות דעדות ומשפטים הם"
        },
        {
          "s": 45,
          "text": "(כמו)"
        },
        {
          "s": 46,
          "text": "חוקים לגבינו"
        },
        {
          "s": 47,
          "text": "(מכיון שגם טעמי המצוות שמצד חכמתו ית' הם למעלה משכל הנבראים),"
        },
        {
          "s": 48,
          "text": "ויתירה מזו שהם רצונך"
        },
        {
          "s": 49,
          "text": "(רצונו ית' שלמעלה גם מחכמתו ית')."
        },
        {
          "s": 50,
          "text": "וזהו דמה שהיונים ביקשו להעבירם מחוקי רצונך הוא גם בהמצוות דעדות ומשפטים43,"
        },
        {
          "s": 51,
          "text": "כי היונים ביקשו לעקור ח\"ו מישראל את ההרגש האלקי שבמצוות,"
        },
        {
          "s": 52,
          "text": "שכל המצוות הם חכמתו ית' שלמעלה משכל אנושי"
        },
        {
          "s": 53,
          "text": "(להעבירם מחוקי),"
        },
        {
          "s": 54,
          "text": "וביקשו לעקור ח\"ו את ההרגש שהמצוות הם רצונו ית'"
        },
        {
          "s": 55,
          "text": "(רצונך)."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ובזה יובן לשון הגמרא כשנכנסו יונים להיכל טימאו כל השמנים שבהיכל,"
        },
        {
          "s": 2,
          "text": "דמשמעות הלשון הוא44,"
        },
        {
          "s": 3,
          "text": "שכשנכנסו להיכל הנה השתדלו ונתאמצו לטמא את השמנים"
        },
        {
          "s": 4,
          "text": "(בכדי לנצח ח\"ו את ישראל),"
        },
        {
          "s": 5,
          "text": "כי היכל הוא בינה ושמן הוא חכמה שלמעלה מהשכל דבינה45"
        },
        {
          "s": 6,
          "text": "(כנ\"ל ס\"ב ששמן הוא בחינת קודש),"
        },
        {
          "s": 7,
          "text": "ולכן טימאו כל השמנים שבהיכל דבינה,"
        },
        {
          "s": 8,
          "text": "בכדי להפיק ח\"ו את מזימתם להשכיחם תורתך ולהעבירם מחוקי רצונך,"
        },
        {
          "s": 9,
          "text": "אלא שלימוד התורה וקיום המצוות יהיו רק מצד השכל."
        }
      ]
    }
  ]
}