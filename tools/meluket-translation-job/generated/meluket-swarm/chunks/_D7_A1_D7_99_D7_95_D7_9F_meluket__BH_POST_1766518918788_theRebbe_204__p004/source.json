{
  "globalIndex": 849,
  "owner": 49,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918788_theRebbe_204__p004",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918788_theRebbe_204__p004",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918788_theRebbe_204",
  "title": "מאמר אתה הראת לדעת תשמ\"ו",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "וזהו אתה הראת לדעת כי ה' הוא האלקים אין עוד מלבדו,"
        },
        {
          "s": 2,
          "text": "שענין זה ניתן בשעת מ\"ת,"
        },
        {
          "s": 3,
          "text": "ועד\"ז נמשך בכל שנה ושנה בזמן מתן תורתנו,"
        },
        {
          "s": 4,
          "text": "כי בשעת מ\"ת הי' גילוי בחי' טל תורה,"
        },
        {
          "s": 5,
          "text": "בחי' טלא דבדולחא דנטיף מע\"ק,"
        },
        {
          "s": 6,
          "text": "שהוא חד עם עצמות א\"ס ב\"ה,"
        },
        {
          "s": 7,
          "text": "אתה דו עצמות א\"ס ב\"ה."
        },
        {
          "s": 8,
          "text": "ויש לומר דזהו גם מה שידוע71"
        },
        {
          "s": 9,
          "text": "שחג השבועות קשור עם משה רבינו,"
        },
        {
          "s": 10,
          "text": "שקיבל אז התורה מסיני,"
        },
        {
          "s": 11,
          "text": "ודוד המלך והבעש\"ט,"
        },
        {
          "s": 12,
          "text": "דבעצרת הוא יום ההילולא דדוד המלך"
        },
        {
          "s": 13,
          "text": "[וענין זה הוא בהדגשה יתירה בשנה זו,"
        },
        {
          "s": 14,
          "text": "שהרי דוד מת בשבת72,"
        },
        {
          "s": 15,
          "text": "ובשנה זו חל יו\"ט שני של עצרת בשבת]"
        },
        {
          "s": 16,
          "text": "וגם יום ההילולא דהבעש\"ט"
        },
        {
          "s": 17,
          "text": "(כנ\"ל)."
        },
        {
          "s": 18,
          "text": "[ויש לומר עוד,"
        },
        {
          "s": 19,
          "text": "דחג השבועות הוא גם יום ההילולא73"
        },
        {
          "s": 20,
          "text": "דמשה רבינו."
        },
        {
          "s": 21,
          "text": "שהרי בשעת מ\"ת פרחה נשמתן של כל ישראל והחזירה בטל כו',"
        },
        {
          "s": 22,
          "text": "ובהכרח לומר שענין זה הי' בכל ישראל,"
        },
        {
          "s": 23,
          "text": "למקטנם ועד גדולם74,"
        },
        {
          "s": 24,
          "text": "שהרי בטח נמשך ענין טל תחי'"
        },
        {
          "s": 25,
          "text": "(טל תורה)"
        },
        {
          "s": 26,
          "text": "לכאו\"א מישראל,"
        },
        {
          "s": 27,
          "text": "כולל משה רבינו75."
        },
        {
          "s": 28,
          "text": "ונמצא שביום זה הי' גם ענין יציאת הנשמה"
        },
        {
          "s": 29,
          "text": "(פרחה נשמתן)"
        },
        {
          "s": 30,
          "text": "במשה רבינו,"
        },
        {
          "s": 31,
          "text": "ענין הילולא]."
        },
        {
          "s": 32,
          "text": "ושלשה אלה"
        },
        {
          "s": 33,
          "text": "(משה רבינו דוד המלך והבעש\"ט)"
        },
        {
          "s": 34,
          "text": "קשורים עם ענין המשכת בחי' טל תורה"
        },
        {
          "s": 35,
          "text": "(פנימיות התורה)"
        },
        {
          "s": 36,
          "text": "בישראל באופן דהבנה והשגה."
        },
        {
          "s": 37,
          "text": "דבמשה כתיב תורה צוה לנו משה מורשה קהלת יעקב76,"
        },
        {
          "s": 38,
          "text": "שנתן ומסר את כל התורה כולה"
        },
        {
          "s": 39,
          "text": "(כולל בחי' טל תורה)"
        },
        {
          "s": 40,
          "text": "לכל ישראל באופן דירושה,"
        },
        {
          "s": 41,
          "text": "דאמיתית ענין הירושה היא כשנמצאת בבעלותו של היורש לגמרי,"
        },
        {
          "s": 42,
          "text": "והיינו שיש בזה הבנה והשגה וכו'."
        },
        {
          "s": 43,
          "text": "ועד\"ז הי' זה ענינו של דוד,"
        },
        {
          "s": 44,
          "text": "דוד מלכא משיחא,"
        },
        {
          "s": 45,
          "text": "שענינו של משיח הוא גילוי פנימיות התורה דלעתיד."
        },
        {
          "s": 46,
          "text": "[וענין זה הוא בהדגשה בזמן זה,"
        },
        {
          "s": 47,
          "text": "סמוך למוצאי שבת,"
        },
        {
          "s": 48,
          "text": "זמן סעודתא דדוד מלכא משיחא77]."
        },
        {
          "s": 49,
          "text": "ועד\"ז הוא גם ענינו של הבעש\"ט,"
        },
        {
          "s": 50,
          "text": "שגילה פנימיות התורה באופן דהפצת המעיינות חוצה."
        },
        {
          "s": 51,
          "text": "דבזמן מתן תורה הי' ענין זה"
        },
        {
          "s": 52,
          "text": "(בחי' טל תורה)"
        },
        {
          "s": 53,
          "text": "בהעלם"
        },
        {
          "s": 54,
          "text": "(לפי ערך),"
        },
        {
          "s": 55,
          "text": "ואח\"כ נתגלה יותר ע\"י דוד,"
        },
        {
          "s": 56,
          "text": "ואח\"כ נתגלה ביותר ע\"י הבעש\"ט ותלמידיו ותלמידי תלמידיו,"
        },
        {
          "s": 57,
          "text": "עד לכ\"ק מו\"ח אדמו\"ר נשיא דורנו,"
        },
        {
          "s": 58,
          "text": "שחידושם הי' הפצת המעיינות דפנימיות התורה"
        },
        {
          "s": 59,
          "text": "(טל תורה)"
        },
        {
          "s": 60,
          "text": "חוצה."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "והנה התורה היא נצחית78,"
        },
        {
          "s": 2,
          "text": "והיינו שהיא הוראה נצחית לכל ישראל,"
        },
        {
          "s": 3,
          "text": "ואינו מבקש אלא לפי כוחן79,"
        },
        {
          "s": 4,
          "text": "שלכל אחד ואחת"
        },
        {
          "s": 5,
          "text": "[שהרי גם לנשים היתה נתינת התורה וקבלת התורה,"
        },
        {
          "s": 6,
          "text": "ואדרבה,"
        },
        {
          "s": 7,
          "text": "כתיב בתחלה80"
        },
        {
          "s": 8,
          "text": "כה תאמר לבית יעקב אלו הנשים,"
        },
        {
          "s": 9,
          "text": "ובאופן דאמירה רכה]"
        },
        {
          "s": 10,
          "text": "ניתן הכח שיהי' לימוד בחי' טל שבתורה,"
        },
        {
          "s": 11,
          "text": "ובאופן דהבנה והשגה."
        },
        {
          "s": 12,
          "text": "וכמו שבכל הלכה שבתורה העיקר הוא המעשה בפשטות,"
        },
        {
          "s": 13,
          "text": "עד\"ז הוא גם בענין זה דגילוי בחי' טל תורה דלע\"ל,"
        },
        {
          "s": 14,
          "text": "שהעיקר הוא שיהי' בפשטות,"
        },
        {
          "s": 15,
          "text": "שמדבר הוי' זו הלכה נבוא לדבר הוי' זה הקץ81,"
        },
        {
          "s": 16,
          "text": "בגאולה האמיתית והשלימה ע\"י משיח צדקנו,"
        },
        {
          "s": 17,
          "text": "במהרה בימינו,"
        },
        {
          "s": 18,
          "text": "בעגלא דידן ממש."
        }
      ]
    }
  ]
}