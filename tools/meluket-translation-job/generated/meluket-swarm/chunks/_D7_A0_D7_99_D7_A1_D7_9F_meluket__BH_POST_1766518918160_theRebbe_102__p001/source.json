{
  "globalIndex": 746,
  "owner": 46,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918160_theRebbe_102__p001",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918160_theRebbe_102__p001",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518918160_theRebbe_102",
  "title": "מאמר ויאמר לו יהונתן תשכ\"ח",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ שמיני,"
        },
        {
          "s": 2,
          "text": "מבה\"ח וער\"ח אייר ה'תשכ\"ח"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "ויאמר לו יהונתן מחר חודש ונפקדת כי יפקד מושבך1,"
        },
        {
          "s": 1,
          "text": "ומביא אדמו\"ר מהר\"ש"
        },
        {
          "s": 2,
          "text": "[בעל יום ההולדת דב' אייר]"
        },
        {
          "s": 3,
          "text": "במאמרו ע\"פ זה2"
        },
        {
          "s": 4,
          "text": "מה שפירש רש\"י עה\"פ שונפקדת הוא לשון זכרון ויפקד הוא לשון חסרון,"
        },
        {
          "s": 5,
          "text": "ופירוש ונפקדת כי יפקד מושבך הוא,"
        },
        {
          "s": 6,
          "text": "דע\"י שיפקד מקום מושבו של דוד,"
        },
        {
          "s": 7,
          "text": "עי\"ז יזכור שאול עליו."
        },
        {
          "s": 8,
          "text": "וממשיך בהמאמר3,"
        },
        {
          "s": 9,
          "text": "דהטעם שנאמר ונפקדת"
        },
        {
          "s": 10,
          "text": "(ולא ונזכרת וכיו\"ב),"
        },
        {
          "s": 11,
          "text": "שונפקדת הוא"
        },
        {
          "s": 12,
          "text": "(גם)"
        },
        {
          "s": 13,
          "text": "לשון יחוד4"
        },
        {
          "s": 14,
          "text": "[כלשון רז\"ל5"
        },
        {
          "s": 15,
          "text": "חייב אדם לפקוד את אשתו כו'],"
        },
        {
          "s": 16,
          "text": "כי שאול הוא בינה"
        },
        {
          "s": 17,
          "text": "(כמ\"ש6"
        },
        {
          "s": 18,
          "text": "שאול מרחובות הנהר),"
        },
        {
          "s": 19,
          "text": "שורש המדות דז\"א"
        },
        {
          "s": 20,
          "text": "[כמ\"ש7"
        },
        {
          "s": 21,
          "text": "מי ברא אלה,"
        },
        {
          "s": 22,
          "text": "דמי,"
        },
        {
          "s": 23,
          "text": "בינה,"
        },
        {
          "s": 24,
          "text": "הוא השורש דאלה,"
        },
        {
          "s": 25,
          "text": "מדות8],"
        },
        {
          "s": 26,
          "text": "ודוד הוא מלכות,"
        },
        {
          "s": 27,
          "text": "ולכן נאמר ונפקדת,"
        },
        {
          "s": 28,
          "text": "ששאול יפקוד את דוד,"
        },
        {
          "s": 29,
          "text": "היינו שיהי' יחוד ז\"א"
        },
        {
          "s": 30,
          "text": "[ששרשו מבינה,"
        },
        {
          "s": 31,
          "text": "שאול]"
        },
        {
          "s": 32,
          "text": "ומלכות"
        },
        {
          "s": 33,
          "text": "[דוד]."
        },
        {
          "s": 34,
          "text": "וזהו הקשר דונפקדת כי יפקד מושבך עם מחר חודש,"
        },
        {
          "s": 35,
          "text": "כי בערב ר\"ח הוא העלם והסתר הלבנה,"
        },
        {
          "s": 36,
          "text": "ועד שברגע שלפני המולד לא נשאר ממנה גם נקודה,"
        },
        {
          "s": 37,
          "text": "ועי\"ז9"
        },
        {
          "s": 38,
          "text": "נעשה אח\"כ"
        },
        {
          "s": 39,
          "text": "(מחר)"
        },
        {
          "s": 40,
          "text": "חודש,"
        },
        {
          "s": 41,
          "text": "מולד הלבנה מחדש,"
        },
        {
          "s": 42,
          "text": "יחוד שמשא וסיהרא."
        },
        {
          "s": 43,
          "text": "וכמו\"כ הוא במלכות"
        },
        {
          "s": 44,
          "text": "(שורש הלבנה),"
        },
        {
          "s": 45,
          "text": "דע\"י שיפקד מושבך"
        },
        {
          "s": 46,
          "text": "(של דוד,"
        },
        {
          "s": 47,
          "text": "מלכות),"
        },
        {
          "s": 48,
          "text": "עי\"ז דוקא ונפקדת,"
        },
        {
          "s": 49,
          "text": "יחוד מלכות עם ז\"א."
        },
        {
          "s": 50,
          "text": "ולכאורה יש להוסיף,"
        },
        {
          "s": 51,
          "text": "דזה שבר\"ח נעשה יחוד שמשא"
        },
        {
          "s": 52,
          "text": "(ז\"א)"
        },
        {
          "s": 53,
          "text": "וסיהרא"
        },
        {
          "s": 54,
          "text": "(מלכות)"
        },
        {
          "s": 55,
          "text": "הוא10"
        },
        {
          "s": 56,
          "text": "שנמשך בהשמש"
        },
        {
          "s": 57,
          "text": "(ז\"א)"
        },
        {
          "s": 58,
          "text": "מבחינת לעילא מן שמשא11,"
        },
        {
          "s": 59,
          "text": "כתר שלמעלה מהשתלשלות."
        },
        {
          "s": 60,
          "text": "כמ\"ש12"
        },
        {
          "s": 61,
          "text": "בעטרה שעטרה לו אמו ביום חתונתו,"
        },
        {
          "s": 62,
          "text": "שבכדי שיהי' יחוד ז\"א עם המלכות"
        },
        {
          "s": 63,
          "text": "(יום חתונתו)"
        },
        {
          "s": 64,
          "text": "הוא ע\"י שנמשך בו עטרה,"
        },
        {
          "s": 65,
          "text": "כתר."
        },
        {
          "s": 66,
          "text": "והמשכת הכתר לז\"א"
        },
        {
          "s": 67,
          "text": "(ביום חתונתו)"
        },
        {
          "s": 68,
          "text": "הוא ע\"י הבינה,"
        },
        {
          "s": 69,
          "text": "עטרה שעטרה לו אמו13."
        },
        {
          "s": 70,
          "text": "ועפ\"ז מובן עוד יותר הקשר דמחר חודש עם ונפקדת כי יפקד מושבך,"
        },
        {
          "s": 71,
          "text": "כי ענין מחר חודש"
        },
        {
          "s": 72,
          "text": "[מה שע\"י העלם והסתר הלבנה"
        },
        {
          "s": 73,
          "text": "(שבערב ר\"ח)"
        },
        {
          "s": 74,
          "text": "נעשה"
        },
        {
          "s": 75,
          "text": "(בר\"ח)"
        },
        {
          "s": 76,
          "text": "יחוד שמשא וסיהרא],"
        },
        {
          "s": 77,
          "text": "הוא,"
        },
        {
          "s": 78,
          "text": "לפי שהביטול דהלבנה"
        },
        {
          "s": 79,
          "text": "(מה שמתעלמת ומסתתרת עד שלא נשאר בה אפילו נקודה)"
        },
        {
          "s": 80,
          "text": "מגיע לבחינת הכתר שלמעלה מהשתלשלות10"
        },
        {
          "s": 81,
          "text": "שממנו נמשך"
        },
        {
          "s": 82,
          "text": "(ע\"י הבינה)"
        },
        {
          "s": 83,
          "text": "הכח על יחוד שמשא וסיהרא."
        },
        {
          "s": 84,
          "text": "וכמו\"כ הו\"ע ונפקדת כי יפקד מושבך,"
        },
        {
          "s": 85,
          "text": "שע\"י שיפקד מקום מושבו של דוד"
        },
        {
          "s": 86,
          "text": "(מלכות),"
        },
        {
          "s": 87,
          "text": "עי\"ז יהי' ונפקדת דדוד ע\"י שאול,"
        },
        {
          "s": 88,
          "text": "המשכת הבינה"
        },
        {
          "s": 89,
          "text": "(שאול מרחובות הנהר),"
        },
        {
          "s": 90,
          "text": "ועי\"ז – המשכת הכתר"
        },
        {
          "s": 91,
          "text": "(בעטרה שעטרה לו אמו)."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "וצריך להבין,"
        },
        {
          "s": 1,
          "text": "דונפקדת לשון זכרון ולשון פקידה"
        },
        {
          "s": 2,
          "text": "(יחוד)"
        },
        {
          "s": 3,
          "text": "ויפקד לשון חסרון הם לכאורה שני הפכים,"
        },
        {
          "s": 4,
          "text": "ואיך אפשר שע\"י יפקד יהי' ונפקדת."
        },
        {
          "s": 5,
          "text": "ואף שיפקד מושבך"
        },
        {
          "s": 6,
          "text": "(זה שנחסר מקום מושבו)"
        },
        {
          "s": 7,
          "text": "קשור עם ענין הביטול,"
        },
        {
          "s": 8,
          "text": "והביטול מגיע בכתר"
        },
        {
          "s": 9,
          "text": "(כנ\"ל)"
        },
        {
          "s": 10,
          "text": "שממנו נמשך הכח על היחוד,"
        },
        {
          "s": 11,
          "text": "מ\"מ,"
        },
        {
          "s": 12,
          "text": "מזה שפירוש יפקד מושבך הוא שיהי' מושבך חסר,"
        },
        {
          "s": 13,
          "text": "משמע,"
        },
        {
          "s": 14,
          "text": "דזה שיפקד מושבך הוא טעם על ונפקדת"
        },
        {
          "s": 15,
          "text": "(ונפקדת כי יפקד מושבך)"
        },
        {
          "s": 16,
          "text": "הוא"
        },
        {
          "s": 17,
          "text": "(לא רק לפי שיפקד מושבך קשור עם ענין הביטול,"
        },
        {
          "s": 18,
          "text": "אלא גם)"
        },
        {
          "s": 19,
          "text": "שיפקד מושבך עצמו"
        },
        {
          "s": 20,
          "text": "(שיהי' מושבך חסר)"
        },
        {
          "s": 21,
          "text": "הוא טעם על ונפקדת,"
        },
        {
          "s": 22,
          "text": "וצריך להבין,"
        },
        {
          "s": 23,
          "text": "איך שייך שיפקד לשון חסרון מביא לונפקדת."
        },
        {
          "s": 24,
          "text": "וכן אינו מובן,"
        },
        {
          "s": 25,
          "text": "דמזה שנאמר יפקד מושבך"
        },
        {
          "s": 26,
          "text": "(ולא יחסר מושבך),"
        },
        {
          "s": 27,
          "text": "לשון פקידה,"
        },
        {
          "s": 28,
          "text": "משמע,"
        },
        {
          "s": 29,
          "text": "שהשייכות דיפקד לונפקדת הוא"
        },
        {
          "s": 30,
          "text": "(לא רק שיפקד מביא לונפקדת,"
        },
        {
          "s": 31,
          "text": "אלא)"
        },
        {
          "s": 32,
          "text": "שביפקד עצמו יש"
        },
        {
          "s": 33,
          "text": "(בהעלם)"
        },
        {
          "s": 34,
          "text": "ענין ונפקדת."
        }
      ]
    }
  ]
}