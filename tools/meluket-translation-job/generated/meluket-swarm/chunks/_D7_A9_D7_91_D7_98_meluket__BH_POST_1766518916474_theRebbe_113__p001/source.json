{
  "globalIndex": 476,
  "owner": 26,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916474_theRebbe_113__p001",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916474_theRebbe_113__p001",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916474_theRebbe_113",
  "title": "מאמר באתי לגני תשי\"א",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד,"
        },
        {
          "s": 1,
          "text": "יו\"ד שבט,"
        },
        {
          "s": 2,
          "text": "תשי\"א*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "כותב כ\"ק מו\"ח אדמו\"ר1,"
        },
        {
          "s": 1,
          "text": "במאמרו ליום הסתלקותו,"
        },
        {
          "s": 2,
          "text": "יו\"ד שבט השי\"ת:"
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "באתי לגני אחותי כלה2,"
        },
        {
          "s": 1,
          "text": "ואיתא במד\"ר"
        },
        {
          "s": 2,
          "text": "(במקומו3)"
        },
        {
          "s": 3,
          "text": "לגן אין כתיב כאן אלא לגני,"
        },
        {
          "s": 4,
          "text": "לגנוני,"
        },
        {
          "s": 5,
          "text": "למקום שהי' עיקרי בתחילה,"
        },
        {
          "s": 6,
          "text": "דעיקר שכינה בתחתונים היתה."
        },
        {
          "s": 7,
          "text": "עכ\"ל."
        },
        {
          "s": 8,
          "text": "ולהבין דיוק הלשון עיקר שכינה,"
        },
        {
          "s": 9,
          "text": "הנה בפי' שכינה מבאר כ\"ק אדמו\"ר הזקןא"
        },
        {
          "s": 10,
          "text": "שנק' שכינה ע\"ש ששוכנת ומתלבשת,"
        },
        {
          "s": 11,
          "text": "מלשון ושכנתי בתוכם4,"
        },
        {
          "s": 12,
          "text": "שהוא ראשית התגלות אוא\"ס."
        },
        {
          "s": 13,
          "text": "והנה ממה שכותב5"
        },
        {
          "s": 14,
          "text": "שראשית התגלות אוא\"ס נק' בשם שכינה,"
        },
        {
          "s": 15,
          "text": "מובן מזה שענין שכינה הוא למעלה מעלה מאצי' ג\"כ,"
        },
        {
          "s": 16,
          "text": "גם בבחי' האור שלפני הצמצום,"
        },
        {
          "s": 17,
          "text": "שהרי ראשית ההתגלות הוא באור א\"ס שלפני הצמצום,"
        },
        {
          "s": 18,
          "text": "וכמוש\"כ כ\"ק אדמו\"ר האמצעיב"
        },
        {
          "s": 19,
          "text": "כי הארת הקו וחוט לגבי עצמיות אוא\"ס נק' בשם שכינה."
        },
        {
          "s": 20,
          "text": "כי ענין שכינה הוא בכל מקום לפי ענינו."
        },
        {
          "s": 21,
          "text": "לגבי אצי' הנה המל' נק' בשם שכינה."
        },
        {
          "s": 22,
          "text": "וגם בזה מה שמל' דאצי' נק' שכינה מבאר כ\"ק אדמו\"ר הצמח צדקג"
        },
        {
          "s": 23,
          "text": "שזהו דוקא כמו שנעשית בחי' עתיק לעולם הבריאה,"
        },
        {
          "s": 24,
          "text": "אבל בהיותה באצי' היא מיוחדת עמהם"
        },
        {
          "s": 25,
          "text": "(עם הספירות דאצי')"
        },
        {
          "s": 26,
          "text": "ולא שייך לשון שכינה."
        },
        {
          "s": 27,
          "text": "ומ\"מ אי\"ז סותר למ\"ש לעיל שהקו נק' בשם שכינה,"
        },
        {
          "s": 28,
          "text": "כי שכינה שנאמר בדרז\"ל היינו מל' דאצי',"
        },
        {
          "s": 29,
          "text": "ואף גם זאת רק כשנעשית בחי' עתיק לבריאה דוקא,"
        },
        {
          "s": 30,
          "text": "אבל בשרשה,"
        },
        {
          "s": 31,
          "text": "היינו כמו שהוא לגבי אוא\"ס,"
        },
        {
          "s": 32,
          "text": "הנה גם הקו נק' בשם שכינה."
        },
        {
          "s": 33,
          "text": "ואחד הטעמים מה שהקו נק' בשם שכינה לגבי אוא\"ס,"
        },
        {
          "s": 34,
          "text": "כתב כ\"ק אדמו\"ר מהר\"ש ד"
        },
        {
          "s": 35,
          "text": "לפי שהקו כוונת המשכתו בשביל שיתלבש בעולמות ונש\"י,"
        },
        {
          "s": 36,
          "text": "ולכן הנה גם בראשיתו נק' בשם שכינה."
        },
        {
          "s": 37,
          "text": "ולמעלה יותר שכינה בשרשו הראשון למעלה מהצמצום,"
        },
        {
          "s": 38,
          "text": "מבאר כ\"ק אדמו\"ר נ\"ע ה"
        },
        {
          "s": 39,
          "text": "שגילוי האור כמו שהוא לפה\"צ,"
        },
        {
          "s": 40,
          "text": "נק' בשם שכינה."
        },
        {
          "s": 41,
          "text": "שבכללות האור שלפני הצמצום יש בו ג' מדריגות,"
        },
        {
          "s": 42,
          "text": "עצם האור והתפשטות האור,"
        },
        {
          "s": 43,
          "text": "ובהתפשטות האור ב' מדרגות גילוי האור כמו שהוא לעצמו שזהו מקור אור הסובב,"
        },
        {
          "s": 44,
          "text": "וגילוי האור לעצמו השייך להעולמות שזהו מקור אור הממלא,"
        },
        {
          "s": 45,
          "text": "וגילוי האור הזה נק' בשם שכינה."
        },
        {
          "s": 46,
          "text": "ואף שהוא לפני הצמצום וא\"א שיהי' מקור לעולמות,"
        },
        {
          "s": 47,
          "text": "שלכן הוצרך להיות הצמצום,"
        },
        {
          "s": 48,
          "text": "וצמצום הראשון שהוא בבחי' סילוק דוקא,"
        },
        {
          "s": 49,
          "text": "מ\"מ נק' בשם שכינה."
        },
        {
          "s": 50,
          "text": "וזהו דיוק הלשון עיקר שכינה בתחתונים היתה,"
        },
        {
          "s": 51,
          "text": "היינו שגילוי השכינה בתחתונים,"
        },
        {
          "s": 52,
          "text": "הוא לא השכינה כמו שהוא לגבי אצי',"
        },
        {
          "s": 53,
          "text": "היינו מל',"
        },
        {
          "s": 54,
          "text": "גם לא כמו שהוא לגבי אוא\"ס,"
        },
        {
          "s": 55,
          "text": "היינו הקו,"
        },
        {
          "s": 56,
          "text": "כ\"א עיקר ופנימיות השכינה היתה בתחתונים דוקא,"
        },
        {
          "s": 57,
          "text": "כי האורו"
        },
        {
          "s": 58,
          "text": "שנתלבש בעולמות ה\"ה בא בסדר והדרגה."
        },
        {
          "s": 59,
          "text": "ולמעלה מאיר בגילוי יותר,"
        },
        {
          "s": 60,
          "text": "וכל מה שנמשך ומשתלשל מתמעט האור."
        },
        {
          "s": 61,
          "text": "וכן הוא בכלל באור דסדר השתלשלות."
        },
        {
          "s": 62,
          "text": "ואף שקודם החטא הי' גם למטה האור בגילוי,"
        },
        {
          "s": 63,
          "text": "מ\"מ הי' גם אז גילוי האור יותר למעלה."
        },
        {
          "s": 64,
          "text": "וכמארז\"ל*ו"
        },
        {
          "s": 65,
          "text": "נטה ימינו וברא שמים נטה שמאלו וברא ארץ."
        },
        {
          "s": 66,
          "text": "אלא הכוונה על האור שלמעלה מעולמות,"
        },
        {
          "s": 67,
          "text": "עיקר שכינה."
        }
      ]
    }
  ]
}