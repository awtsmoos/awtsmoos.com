{
  "globalIndex": 169,
  "owner": 19,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914734_theRebbe_896__p004",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914734_theRebbe_896__p004",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914734_theRebbe_896",
  "title": "מאמר בורא ניב שפתיים תשמ\"ח",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 2,
          "text": "דמ\"ש אמר הוי' ורפאתיו לאחרי שאומר שלום לרחוק,"
        },
        {
          "s": 3,
          "text": "הוא,"
        },
        {
          "s": 4,
          "text": "דכיון שבתחלה הי' מרוחק מאלקות,"
        },
        {
          "s": 5,
          "text": "לכן,"
        },
        {
          "s": 6,
          "text": "גם לאחרי שנעשה קרוב לאלקות"
        },
        {
          "s": 7,
          "text": "(ע\"י התשובה,"
        },
        {
          "s": 8,
          "text": "עבודת האדם),"
        },
        {
          "s": 9,
          "text": "וגם לאחרי שנעשה שלום לרחוק"
        },
        {
          "s": 10,
          "text": "(ע\"י המשכה מלמעלה),"
        },
        {
          "s": 11,
          "text": "צריך עדיין לרפואה."
        },
        {
          "s": 12,
          "text": "והרפואה היא ע\"י לימוד התורה."
        },
        {
          "s": 13,
          "text": "וזהו אמר הוי' ורפאתיו,"
        },
        {
          "s": 14,
          "text": "דהרפואה היא אמר הוי',"
        },
        {
          "s": 15,
          "text": "שחוקק בכח זכרונו אותיות שבתורה."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ולהעיר,"
        },
        {
          "s": 1,
          "text": "דמ\"ש בהמאמר שרפאתיו הוא ע\"י לימוד התורה,"
        },
        {
          "s": 2,
          "text": "הוא גם בנוגע לרפואה בגשמיות,"
        },
        {
          "s": 3,
          "text": "כמ\"ש30"
        },
        {
          "s": 4,
          "text": "ולכל בשרו מרפא."
        },
        {
          "s": 5,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 6,
          "text": "דמ\"ש לעיל"
        },
        {
          "s": 7,
          "text": "(סעיף ה)"
        },
        {
          "s": 8,
          "text": "שהרפואה דאמר הוי' ורפאתיו היא באופן שלא נשאר שום רושם ועד שנעקר מתחילתו,"
        },
        {
          "s": 9,
          "text": "הוא גם כשהרפואה מהקב\"ה נמשכת ע\"י רופא בו\"ד וע\"י סממני רפואה."
        },
        {
          "s": 10,
          "text": "דכיון שהתורה היא בעה\"ב על כל המציאות,"
        },
        {
          "s": 11,
          "text": "כולל גם מציאות הרפואה"
        },
        {
          "s": 12,
          "text": "(חכמת הרפואה וכו' ועד לעצם מציאות הרפואה),"
        },
        {
          "s": 13,
          "text": "הרי מובן,"
        },
        {
          "s": 14,
          "text": "שבכח התורה,"
        },
        {
          "s": 15,
          "text": "שגם הרפואה שע\"י בו\"ד וע\"י סממנים וכיו\"ב תהי' באופן שלא ישאר שום רושם ועד שיהי' נעקר מתחילתו."
        },
        {
          "s": 16,
          "text": "ולהעיר,"
        },
        {
          "s": 17,
          "text": "שגם ברפואה שע\"פ טבע ישנה רפואה שעוקרת את החולי31."
        },
        {
          "s": 18,
          "text": "אלא שרפואה זו אינה מצוי' והרפואות המצויות הם באופן שנשאר רושם."
        },
        {
          "s": 19,
          "text": "ועפ\"ז מובן עוד יותר זה שבכח התורה לפעול שגם הרפואה שע\"י רפואות המצויות תהי' באופן שלא יהי' נשאר שום רושם,"
        },
        {
          "s": 20,
          "text": "מכיון שענין זה ישנו כבר בעולם."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר בפירוש הכתוב בורא ניב שפתים שלום גו' לרחוק,"
        },
        {
          "s": 2,
          "text": "שהעצה והתיקון להרחוק,"
        },
        {
          "s": 3,
          "text": "בעל תשובה,"
        },
        {
          "s": 4,
          "text": "הוא ניב שפתים,"
        },
        {
          "s": 5,
          "text": "וידוי דברים."
        },
        {
          "s": 6,
          "text": "ונקרא ניב שפתים,"
        },
        {
          "s": 7,
          "text": "דיבור הבא ממילא,"
        },
        {
          "s": 8,
          "text": "כי הוידוי דהבע\"ת בא בדרך ממילא,"
        },
        {
          "s": 9,
          "text": "מצער עומק לבבו."
        },
        {
          "s": 10,
          "text": "והנה פירוש זה שניב שפתים הוא וידוי,"
        },
        {
          "s": 11,
          "text": "הוא ע\"פ פירוש הגמרא דשלום לרחוק קאי על בעל תשובה."
        },
        {
          "s": 12,
          "text": "ולפירוש הרד\"ק דשלום לרחוק קאי על הרחוקים מירושלים,"
        },
        {
          "s": 13,
          "text": "מבאר בהמאמר,"
        },
        {
          "s": 14,
          "text": "דירושלים הו\"ע יראת שמים32,"
        },
        {
          "s": 15,
          "text": "ורחוק מירושלים הוא זה שבטבע אינו ירא שמים,"
        },
        {
          "s": 16,
          "text": "והעצה לזה הוא ניב שפתים,"
        },
        {
          "s": 17,
          "text": "דיבור בדברי תורה."
        },
        {
          "s": 18,
          "text": "ויש לומר,"
        },
        {
          "s": 19,
          "text": "דזה שהדיבור בתורה נקרא בכתוב זה בשם ניב שפתים,"
        },
        {
          "s": 20,
          "text": "דיבור הבא ממילא,"
        },
        {
          "s": 21,
          "text": "הוא,"
        },
        {
          "s": 22,
          "text": "לרמז שהאדם צריך להיות שקוע כ\"כ בתורה,"
        },
        {
          "s": 23,
          "text": "עד שהדיבור בתורה יהי' באופן דממילא33"
        },
        {
          "s": 24,
          "text": "(ע\"ד מארז\"ל34"
        },
        {
          "s": 25,
          "text": "מנפשי' כרע)."
        },
        {
          "s": 26,
          "text": "ויש לקשר זה עם המובא לעיל מהמאמר דענין אמר הוי' ורפאתיו הוא שדברי תורה יהיו חקוקים בכח זכרונו,"
        },
        {
          "s": 27,
          "text": "דענין החקיקה הוא שהדבר הנחקק הוא חד עם הדבר שחוקקים בו35,"
        },
        {
          "s": 28,
          "text": "וע\"י שנעשה חד עם התורה,"
        },
        {
          "s": 29,
          "text": "שמציאותו היא תורה,"
        },
        {
          "s": 30,
          "text": "כל הדיבורים שלו,"
        },
        {
          "s": 31,
          "text": "גם כשאינו מכוון לדבר דברי תורה,"
        },
        {
          "s": 32,
          "text": "הם דברי תורה."
        },
        {
          "s": 33,
          "text": "וזהו בורא ניב שפתים,"
        },
        {
          "s": 34,
          "text": "דזה שניב שפתים של האדם"
        },
        {
          "s": 35,
          "text": "(הדיבור שבא מעצמו,"
        },
        {
          "s": 36,
          "text": "בלי כוונה)"
        },
        {
          "s": 37,
          "text": "הוא דברי תורה,"
        },
        {
          "s": 38,
          "text": "הוא ע\"י שנעשה מציאות חדשה,"
        },
        {
          "s": 39,
          "text": "מציאות דתורה."
        }
      ]
    }
  ]
}