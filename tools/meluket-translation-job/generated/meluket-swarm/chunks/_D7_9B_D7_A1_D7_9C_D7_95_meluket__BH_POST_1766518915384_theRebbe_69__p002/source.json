{
  "globalIndex": 278,
  "owner": 28,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915384_theRebbe_69__p002",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915384_theRebbe_69__p002",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915384_theRebbe_69",
  "title": "מאמר אתה אחד תשמ\"ב",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר13,"
        },
        {
          "s": 2,
          "text": "דמ\"ש מנוחה שלימה שאתה רוצה בה"
        },
        {
          "s": 3,
          "text": "(לאחרי שמפרט ג' הקוין חג\"ת בכל ד' מדריגות הנ\"ל)"
        },
        {
          "s": 4,
          "text": "הוא בחי' שלימותא דכולא,"
        },
        {
          "s": 5,
          "text": "אחדות הפשוטה,"
        },
        {
          "s": 6,
          "text": "שלמעלה מג' הקוין,"
        },
        {
          "s": 7,
          "text": "גם ממקור הג' קוין כמו שהם לפני הצמצום."
        },
        {
          "s": 8,
          "text": "ועל זה אומר יכירו בניך וידעו,"
        },
        {
          "s": 9,
          "text": "דבניך"
        },
        {
          "s": 10,
          "text": "(נשמות שבגופים דוקא)"
        },
        {
          "s": 11,
          "text": "יכירו וידעו גם בחינה זו."
        },
        {
          "s": 12,
          "text": "והטעם לזה הוא,"
        },
        {
          "s": 13,
          "text": "כי מאתך היא מנוחתם,"
        },
        {
          "s": 14,
          "text": "שמנוחתם"
        },
        {
          "s": 15,
          "text": "(דשבת)"
        },
        {
          "s": 16,
          "text": "היא מאתך,"
        },
        {
          "s": 17,
          "text": "מאתך ממש."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ויש לקשר זה עם הידוע14"
        },
        {
          "s": 1,
          "text": "בפירוש כי מאתך היא מנוחתם,"
        },
        {
          "s": 2,
          "text": "(מאתך הוא אותיות)"
        },
        {
          "s": 3,
          "text": "מאת ך' שהיא הכתר,"
        },
        {
          "s": 4,
          "text": "משם מנוחתם."
        },
        {
          "s": 5,
          "text": "דכמו שבהשתלשלות ד' העולמות אבי\"ע,"
        },
        {
          "s": 6,
          "text": "התחלת ההשתלשלות היא מאצילות והכתר הוא למעלה מהשתלשלות,"
        },
        {
          "s": 7,
          "text": "עד\"ז הוא בההשתלשלות דד' מדריגות הנ\"ל"
        },
        {
          "s": 8,
          "text": "(שהם בדוגמת אבי\"ע),"
        },
        {
          "s": 9,
          "text": "שהתחלת ההשתלשלות היא מ"
        },
        {
          "s": 10,
          "text": "(בחינת חג\"ת ש)"
        },
        {
          "s": 11,
          "text": "לפני הצמצום"
        },
        {
          "s": 12,
          "text": "(בחינת אצילות דכללות),"
        },
        {
          "s": 13,
          "text": "ובחינת הכתר"
        },
        {
          "s": 14,
          "text": "(שם)"
        },
        {
          "s": 15,
          "text": "היא בחינת הא\"ס עצמו"
        },
        {
          "s": 16,
          "text": "(שלמעלה גם מחג\"ת שבא\"ס),"
        },
        {
          "s": 17,
          "text": "מאתך ממש."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וביאור הענין"
        },
        {
          "s": 2,
          "text": "(שהמנוחה דשבת היא מאתך ממש)15,"
        },
        {
          "s": 3,
          "text": "הנה המנוחה דשבת היא מצד עצם הנפש,"
        },
        {
          "s": 4,
          "text": "בחינת יחידה."
        },
        {
          "s": 5,
          "text": "וכמו שמבאר בהמאמר16,"
        },
        {
          "s": 6,
          "text": "דזהו הטעם על זה שהמנוחה דשבת היא בכל ישראל בשוה,"
        },
        {
          "s": 7,
          "text": "ואין בה חילוק בין גדולי עולם לקטני ההמון ממש"
        },
        {
          "s": 8,
          "text": "(ודלא כהתפלה דשבת,"
        },
        {
          "s": 9,
          "text": "וכן אכילת שבת,"
        },
        {
          "s": 10,
          "text": "שבצדיקים גדולים הם באופן נעלה הרבה יותר מאשר באנשים פשוטים),"
        },
        {
          "s": 11,
          "text": "כי בבחינת היחידה כל ישראל הם בשוה,"
        },
        {
          "s": 12,
          "text": "והיא נמצאת בשלימותה בכל נפש מישראל אפילו בפחותים וקלים."
        }
      ]
    }
  ]
}