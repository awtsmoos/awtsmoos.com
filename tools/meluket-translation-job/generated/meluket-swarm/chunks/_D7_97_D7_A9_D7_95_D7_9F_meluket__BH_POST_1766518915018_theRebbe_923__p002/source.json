{
  "globalIndex": 209,
  "owner": 9,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915018_theRebbe_923__p002",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915018_theRebbe_923__p002",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518915018_theRebbe_923",
  "title": "מאמר ואברהם זקן תשל\"ז",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והגם שגם זקן בא בימים הוא בחינת עתיק יומין,"
        },
        {
          "s": 2,
          "text": "כדאיתא במדרש15"
        },
        {
          "s": 3,
          "text": "שאמר הקב\"ה לאברהם בא ולבוש לבושי שנאמר ואברהם זקן בא בימים,"
        },
        {
          "s": 4,
          "text": "ופירש במתנות כהונה דזה שבא בימים הוא לבושו של הקב\"ה הוא כי הקב\"ה נק'16"
        },
        {
          "s": 5,
          "text": "עתיק יומין"
        },
        {
          "s": 6,
          "text": "[והצ\"צ17"
        },
        {
          "s": 7,
          "text": "מוסיף שגם זקן"
        },
        {
          "s": 8,
          "text": "(דיקנא18)"
        },
        {
          "s": 9,
          "text": "הוא לבושו דהקב\"ה,"
        },
        {
          "s": 10,
          "text": "כי בעתיק יומין כתיב16"
        },
        {
          "s": 11,
          "text": "לבושי' כתלג חיוור19"
        },
        {
          "s": 12,
          "text": "שהוא20"
        },
        {
          "s": 13,
          "text": "בחינת י\"ג תיקוני דיקנא],"
        },
        {
          "s": 14,
          "text": "יש לומר,"
        },
        {
          "s": 15,
          "text": "שהכוונה בזה היא"
        },
        {
          "s": 16,
          "text": "(לא לעתיק ממש,"
        },
        {
          "s": 17,
          "text": "אלא21)"
        },
        {
          "s": 18,
          "text": "לאריך שנקרא ג\"כ בשם עתיק יומין22"
        },
        {
          "s": 19,
          "text": "[ויש לומר דזה שאריך נקרא בשם עתיק יומין הוא לפי שבו מלובשים ז\"ת דעתיק23],"
        },
        {
          "s": 20,
          "text": "משא\"כ כל הוא עתיק עצמו."
        },
        {
          "s": 21,
          "text": "ויתירה מזו,"
        },
        {
          "s": 22,
          "text": "שבעתיק גופא הוא בחינת ג\"ר דעתיק שאינם מלובשים באריך24,"
        },
        {
          "s": 23,
          "text": "ועד לבחינת פנימיות עתיק ולמעלה יותר,"
        },
        {
          "s": 24,
          "text": "וכנ\"ל"
        },
        {
          "s": 25,
          "text": "(סעיף א)"
        },
        {
          "s": 26,
          "text": "מהמאמר שכל הוא בחינת העלם העצמי."
        },
        {
          "s": 27,
          "text": "וזהו שהענין דזקן בא בימים מייחס הכתוב לאברהם"
        },
        {
          "s": 28,
          "text": "(ואברהם זקן בא בימים)"
        },
        {
          "s": 29,
          "text": "משא\"כ בנוגע כל אומר שהוי' ברך את אברהם בכל,"
        },
        {
          "s": 30,
          "text": "כי זה שהי' לאברהם בחינת זקן בא בימים,"
        },
        {
          "s": 31,
          "text": "שהוא בחיצוניות הכתר,"
        },
        {
          "s": 32,
          "text": "המשיך זה ע\"י עבודתו."
        },
        {
          "s": 33,
          "text": "ויש לומר,"
        },
        {
          "s": 34,
          "text": "דזוהי גם השייכות דהפירוש שזקן בא בימים הוא לבושו דהקב\"ה עם הפירוש25"
        },
        {
          "s": 35,
          "text": "שזקן הוא זה שקנה חכמה26"
        },
        {
          "s": 36,
          "text": "(תורה)"
        },
        {
          "s": 37,
          "text": "ובא בימים הוא לבושי המצוות27,"
        },
        {
          "s": 38,
          "text": "כי זה שהי' לאברהם לבושו של הקב\"ה,"
        },
        {
          "s": 39,
          "text": "המשיך זה ע\"י התורה והמצוות שלו."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ויש לבאר זה בפרטיות יותר,"
        },
        {
          "s": 1,
          "text": "דזקן ובא בימים הם שתי מדריגות."
        },
        {
          "s": 2,
          "text": "זקן שהוא י\"ג תיקוני דיקנא,"
        },
        {
          "s": 3,
          "text": "הוא במוחא סתימאה דאריך,"
        },
        {
          "s": 4,
          "text": "ובא בימים הוא אריך עצמו"
        },
        {
          "s": 5,
          "text": "[דזה שאריך נקרא בשם עתיק יומין28"
        },
        {
          "s": 6,
          "text": "הוא בעיקר בעצמיות אריך],"
        },
        {
          "s": 7,
          "text": "גלגלתא דאריך."
        },
        {
          "s": 8,
          "text": "וזוהי השייכות דשני ענינים אלו"
        },
        {
          "s": 9,
          "text": "(זקן ובא בימים)"
        },
        {
          "s": 10,
          "text": "שלמעלה"
        },
        {
          "s": 11,
          "text": "(לבושו של הקב\"ה)"
        },
        {
          "s": 12,
          "text": "עם שני ענינים אלו בעבודת האדם,"
        },
        {
          "s": 13,
          "text": "כי מוחא סתימאה דאריך הוא פנימי,"
        },
        {
          "s": 14,
          "text": "השרש דתורה29,"
        },
        {
          "s": 15,
          "text": "וגלגלתא דאריך הוא מקיף,"
        },
        {
          "s": 16,
          "text": "השרש דמצוות29."
        },
        {
          "s": 17,
          "text": "וע\"י עסק התורה דאברהם,"
        },
        {
          "s": 18,
          "text": "זקן שקנה חכמה,"
        },
        {
          "s": 19,
          "text": "המשיך בחינת הדיקנא ומוחא סתימאה דאריך"
        },
        {
          "s": 20,
          "text": "(זקן),"
        },
        {
          "s": 21,
          "text": "וע\"י שהי' בא בימים,"
        },
        {
          "s": 22,
          "text": "לבושי המצוות,"
        },
        {
          "s": 23,
          "text": "המשיך בחינת גלגלתא30"
        },
        {
          "s": 24,
          "text": "דאריך"
        },
        {
          "s": 25,
          "text": "(בא בימים)."
        },
        {
          "s": 26,
          "text": "משא\"כ כל שהוא בחינת עתיק,"
        },
        {
          "s": 27,
          "text": "אין אתעדל\"ת מגעת לשם,"
        },
        {
          "s": 28,
          "text": "ולכן כתיב וה' ברך את אברהם בכל,"
        },
        {
          "s": 29,
          "text": "אתערותא דלעילא הבאה מלמעלה."
        },
        {
          "s": 30,
          "text": "אלא שאתערותא דלעילא זו31"
        },
        {
          "s": 31,
          "text": "שורה ומתגלה דוקא לאחרי שלימות העבודה"
        },
        {
          "s": 32,
          "text": "(והאתערותא דלעילא שע\"י האתערותא דלתתא),"
        },
        {
          "s": 33,
          "text": "לכן,"
        },
        {
          "s": 34,
          "text": "מה שברך ה' את אברהם בכל הי' זה דוקא לאחרי שעמד בעשר נסיונות,"
        },
        {
          "s": 35,
          "text": "כנ\"ל"
        },
        {
          "s": 36,
          "text": "(סעיף ב בתחלתו)."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה גם בבחינת כל"
        },
        {
          "s": 2,
          "text": "(עתיק)"
        },
        {
          "s": 3,
          "text": "שלמעלה מבא בימים"
        },
        {
          "s": 4,
          "text": "(אריך)"
        },
        {
          "s": 5,
          "text": "יש כמה מדריגות."
        },
        {
          "s": 6,
          "text": "וכמובן מהמבואר בהמאמר"
        },
        {
          "s": 7,
          "text": "(ד\"ה ואברהם זקן)"
        },
        {
          "s": 8,
          "text": "דהצ\"צ32,"
        },
        {
          "s": 9,
          "text": "שבתחלה אומר,"
        },
        {
          "s": 10,
          "text": "שאברהם זכה לבחינת כל ע\"י קיום מל\"ת וגם בבחינה זו דכל אומר שהוא פנימיות עתיק"
        },
        {
          "s": 11,
          "text": "[כמבואר שם,"
        },
        {
          "s": 12,
          "text": "דזה שוהוי' ברך את אברהם בכל הוא לאחרי שנאמר בא בימים,"
        },
        {
          "s": 13,
          "text": "כי ימים הם מ\"ע,"
        },
        {
          "s": 14,
          "text": "וע\"י העבודה דבא בימים קיום מ\"ע זכה לבחינת אריך"
        },
        {
          "s": 15,
          "text": "(בחינת בא בימים דלמעלה),"
        },
        {
          "s": 16,
          "text": "משא\"כ זה שזכה לבחינת כל שזכה לזה ע\"י קיום מל\"ת הוא פנימיות עתיק שלמעלה מאריך33],"
        },
        {
          "s": 17,
          "text": "ולאח\"ז אומר שאברהם זכה לזה ע\"י העשרה נסיונות"
        },
        {
          "s": 18,
          "text": "(כנ\"ל סעיף ב מהמדרש),"
        },
        {
          "s": 19,
          "text": "דיש לומר,"
        },
        {
          "s": 20,
          "text": "שבחינת כל שזכה ע\"י הנסיונות הוא נעלה יותר מבחינת כל שזכה ע\"י קיום מל\"ת."
        },
        {
          "s": 21,
          "text": "וי\"ל הביאור בזה,"
        },
        {
          "s": 22,
          "text": "דבחינת עתיק"
        },
        {
          "s": 23,
          "text": "(כל)"
        },
        {
          "s": 24,
          "text": "שזכה ע\"י קיום מל\"ת,"
        },
        {
          "s": 25,
          "text": "יש לו שייכות להשתלשלות,"
        },
        {
          "s": 26,
          "text": "ולכן,"
        },
        {
          "s": 27,
          "text": "עבודת האדם שעל ידה זוכה לזה היא עבודה שתלוי' ברצונו"
        },
        {
          "s": 28,
          "text": "(היינו עבודה שבסדר והדרגה),"
        },
        {
          "s": 29,
          "text": "אלא שבזה גופא,"
        },
        {
          "s": 30,
          "text": "מכיון שעתיק הוא למעלה מהשתלשלות,"
        },
        {
          "s": 31,
          "text": "לכן העבודה היא לא בעשי' אלא בשב ואל תעשה,"
        },
        {
          "s": 32,
          "text": "שלילה34."
        },
        {
          "s": 33,
          "text": "משא\"כ בחינת עתיק"
        },
        {
          "s": 34,
          "text": "(כל)"
        },
        {
          "s": 35,
          "text": "שזכה ע\"י הנסיונות,"
        },
        {
          "s": 36,
          "text": "הוא נעתק ונבדל לגמרי,"
        },
        {
          "s": 37,
          "text": "וכנ\"ל"
        },
        {
          "s": 38,
          "text": "(סעיף א)"
        },
        {
          "s": 39,
          "text": "מהמאמר שהוא העלם העצמי."
        },
        {
          "s": 40,
          "text": "ולכן,"
        },
        {
          "s": 41,
          "text": "כשעבודת האדם היא תלוי' ברצונו,"
        },
        {
          "s": 42,
          "text": "אין לה שום דמיון35"
        },
        {
          "s": 43,
          "text": "לבחינה זו דעתיק שנעתק ומובדל לגמרי."
        },
        {
          "s": 44,
          "text": "ורק ע\"י העבודה דנסיונות שאינה תלוי' ברצון האדם"
        },
        {
          "s": 45,
          "text": "[שהרי אסור לאדם להעמיד עצמו בנסיון,"
        },
        {
          "s": 46,
          "text": "ולא עוד אלא שנצטווינו לבקש אל תביאנו לידי נסיון36],"
        },
        {
          "s": 47,
          "text": "עי\"ז דוקא זוכים לגילוי בחינה זו."
        }
      ]
    }
  ]
}