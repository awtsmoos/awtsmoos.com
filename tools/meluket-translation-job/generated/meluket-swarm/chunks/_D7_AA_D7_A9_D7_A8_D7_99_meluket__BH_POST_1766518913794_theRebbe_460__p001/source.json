{
  "globalIndex": 19,
  "owner": 19,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913794_theRebbe_460__p001",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913794_theRebbe_460__p001",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518913794_theRebbe_460",
  "title": "מאמר וביום שמחתכם תש\"מ",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "יום ב' דראש השנה ה'תש\"מ*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "– הנחה –"
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "וביום שמחתכם ובמועדיכם ובראשי חדשיכם ותקעתם בחצוצרות גו' והיו לכם לזכרון לפני אלקיכם1,"
        },
        {
          "s": 1,
          "text": "אני ה' אלקיכם."
        },
        {
          "s": 2,
          "text": "ואיתא בגמרא2"
        },
        {
          "s": 3,
          "text": "ומה תלמוד לומר אני ה' אלקיכם זה בנה אב לכל מקום שנאמר בו זכרונות יהיו מלכיות עמהן"
        },
        {
          "s": 4,
          "text": "(דאני ה' אלקיכם הוא מלכיות3"
        },
        {
          "s": 5,
          "text": "ומזה שאומר אני ה' אלקיכם גבי והיו לכם לזכרון גו' למדים שבכ\"מ שנאמר בו זכרונות צ\"ל גם מלכיות)."
        },
        {
          "s": 6,
          "text": "ומזה למדים4"
        },
        {
          "s": 7,
          "text": "שבר\"ה צ\"ל מלכיות זכרונות ושופרות,"
        },
        {
          "s": 8,
          "text": "ותקעתם גו' שופרות,"
        },
        {
          "s": 9,
          "text": "והיו לכם לזכרון גו' זכרונות,"
        },
        {
          "s": 10,
          "text": "אני ה' אלקיכם מלכיות."
        },
        {
          "s": 11,
          "text": "והנה ג' ענינים אלו"
        },
        {
          "s": 12,
          "text": "(מלכיות זכרונות ושופרות)"
        },
        {
          "s": 13,
          "text": "הם לא רק בדיבור,"
        },
        {
          "s": 14,
          "text": "אמירת פסוקי מלכיות זכרונות ושופרות,"
        },
        {
          "s": 15,
          "text": "וכמרז\"ל5"
        },
        {
          "s": 16,
          "text": "אמרו לפני בר\"ה מלכיות זכרונות ושופרות,"
        },
        {
          "s": 17,
          "text": "אלא גם במעשה בפועל,"
        },
        {
          "s": 18,
          "text": "וכמו שמבאר במרז\"ל הנ\"ל מלכיות כדי שתמליכוני כו'"
        },
        {
          "s": 19,
          "text": "(שתמליכוני בפועל)"
        },
        {
          "s": 20,
          "text": "זכרונות כדי שיעלה זכרוניכם"
        },
        {
          "s": 21,
          "text": "(שיעלה זכרוניכם בפועל)"
        },
        {
          "s": 22,
          "text": "ובמה בשופר ע\"י תקיעת שופר במעשה בפועל6."
        },
        {
          "s": 23,
          "text": "והנה ברכות"
        },
        {
          "s": 24,
          "text": "(ברכות מלכיות זכרונות ושופרות)"
        },
        {
          "s": 25,
          "text": "מעכבות זו את זו7,"
        },
        {
          "s": 26,
          "text": "משא\"כ ברכות ותקיעות אינן מעכבות זו את זו8."
        },
        {
          "s": 27,
          "text": "ומבואר בדרושי רבותינו נשיאינו ד\"ה זה"
        },
        {
          "s": 28,
          "text": "(וביום שמחתכם)9"
        },
        {
          "s": 29,
          "text": "לפי שברכות ותקיעות הם שני ענינים שונים,"
        },
        {
          "s": 30,
          "text": "ברכות דיבור ותקיעות מעשה."
        },
        {
          "s": 31,
          "text": "וצריך להבין למה צריך בר\"ה לב' הענינים10."
        },
        {
          "s": 32,
          "text": "ובפרט שפשטות לשון רז\"ל ובמה בשופר פירושה היא תקיעת שופר11,"
        },
        {
          "s": 33,
          "text": "שענין תמליכוני עליכם ויעלה זכרוניכם לפני לטובה נעשה ע\"י תק\"ש שהוא העיקר."
        },
        {
          "s": 34,
          "text": "וכדמוכח גם ממרז\"ל12"
        },
        {
          "s": 35,
          "text": "שמצות היום בשופר היינו שכל הענינים דיום זה"
        },
        {
          "s": 36,
          "text": "(ר\"ה)"
        },
        {
          "s": 37,
          "text": "נמשכים ע\"י תק\"ש."
        },
        {
          "s": 38,
          "text": "וכמובן גם ממ\"ש הרמב\"ם13"
        },
        {
          "s": 39,
          "text": "אע\"פ שתקיעת שופר בר\"ה גזירת הכתוב רמז יש בו כלומר עורו כו' ומבואר בדרושי רבותינו נשיאינו14"
        },
        {
          "s": 40,
          "text": "שבאריכות לשונו של הרמב\"ם מרומזים ג' הענינים דמלכיות זכרונות ושופרות,"
        },
        {
          "s": 41,
          "text": "שמזה מובן,"
        },
        {
          "s": 42,
          "text": "שכל ג' ענינים אלו נמשכים ע\"י תק\"ש,"
        },
        {
          "s": 43,
          "text": "והרמז"
        },
        {
          "s": 44,
          "text": "(הכללי)"
        },
        {
          "s": 45,
          "text": "בשופר עורו כו' הו\"ע התשובה"
        },
        {
          "s": 46,
          "text": "(כמבואר ברמב\"ם שם),"
        },
        {
          "s": 47,
          "text": "היינו דהמצוה דתק\"ש שייכת לכללות הענין דר\"ה"
        },
        {
          "s": 48,
          "text": "(מצות היום בשופר),"
        },
        {
          "s": 49,
          "text": "כי בר\"ה חוזרים כל הדברים לקדמותם וצריך לעורר המשכה חדשה מעצמותו ומהותו,"
        },
        {
          "s": 50,
          "text": "ולהמשיך זה בכל סדר ההשתלשלות עד בעשי'."
        },
        {
          "s": 51,
          "text": "והמשכה זו היא ע\"י שופר,"
        },
        {
          "s": 52,
          "text": "כי שופר רומז לענין התשובה כנ\"ל שעיקר התשובה הוא התאחדות עם המקור,"
        },
        {
          "s": 53,
          "text": "קדמותם,"
        },
        {
          "s": 54,
          "text": "וישנו באופן מלמטלמ\"ע ומלמעלמ\"ט כמ\"ש15"
        },
        {
          "s": 55,
          "text": "והרוח תשוב אל האלקים אשר נתנה,"
        },
        {
          "s": 56,
          "text": "כמבואר בלקו\"ת ריש פרשה זו"
        },
        {
          "s": 57,
          "text": "(פרשת האזינו),"
        },
        {
          "s": 58,
          "text": "ולכן עי\"ז מעוררים המשכה חדשה מעצמותו ומהותו,"
        },
        {
          "s": 59,
          "text": "וע\"י העשי'"
        },
        {
          "s": 60,
          "text": "(תקיעת שופר במעשה)"
        },
        {
          "s": 61,
          "text": "ממשיכים16"
        },
        {
          "s": 62,
          "text": "זה עד בעשי'17."
        }
      ]
    }
  ]
}