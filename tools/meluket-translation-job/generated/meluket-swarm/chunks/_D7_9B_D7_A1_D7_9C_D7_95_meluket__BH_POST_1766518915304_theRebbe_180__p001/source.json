{
  "globalIndex": 255,
  "owner": 5,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915304_theRebbe_180__p001",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915304_theRebbe_180__p001",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915304_theRebbe_180",
  "title": "מאמר ושבתי בשלום תשל\"ח",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "מוצאי ש\"פ ויצא,"
        },
        {
          "s": 2,
          "text": "ט' כסלו,"
        },
        {
          "s": 3,
          "text": "אור ליו\"ד כסלו – בחדרו – ה'תשל\"ח*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "ושבתי בשלום אל בית אבי גו'1"
        },
        {
          "s": 1,
          "text": "[שפסוק זה הוא התחלת דרוש הראשון דפרשתנו בתורה אור מאדמו\"ר הזקן ובתורת חיים מאדמו\"ר האמצעי בעל הגאולה"
        },
        {
          "s": 2,
          "text": "(דיו\"ד כסלו)2"
        },
        {
          "s": 3,
          "text": "וההילולא"
        },
        {
          "s": 4,
          "text": "(דט' כסלו)."
        },
        {
          "s": 5,
          "text": "אלא שבתורת חיים מקדים"
        },
        {
          "s": 6,
          "text": "(בתחילת הדרוש)"
        },
        {
          "s": 7,
          "text": "הפסוק3"
        },
        {
          "s": 8,
          "text": "וידר יעקב נדר גו' שלפני הפסוק ושבתי בשלום גו'],"
        },
        {
          "s": 9,
          "text": "וידועים הדיוקים בזה,"
        },
        {
          "s": 10,
          "text": "מהו אומרו ושבתי בשלום אל בית אבי,"
        },
        {
          "s": 11,
          "text": "בשלום דוקא4."
        },
        {
          "s": 12,
          "text": "ובפרט שלפנ\"ז3"
        },
        {
          "s": 13,
          "text": "אומר אם יהי' אלקים עמדי גו' ונתן לי לחם לאכול ובגד ללבוש,"
        },
        {
          "s": 14,
          "text": "שהכוונה בזה היא גם ללחם ובגד ברוחניות5,"
        },
        {
          "s": 15,
          "text": "בכל הפירושים שבזה,"
        },
        {
          "s": 16,
          "text": "ואעפ\"כ אינו מסתפק בזה ומדגיש שחזרתו אל בית אביו תהי' בשלום דוקא."
        },
        {
          "s": 17,
          "text": "וגם צריך להבין מה שלאחרי ושבתי בשלום אל בית אבי מוסיף והי' הוי' לי לאלקים,"
        },
        {
          "s": 18,
          "text": "הרי ענין זה דהוי' הוא האלקים הוא ענין אמיתי ותמידי"
        },
        {
          "s": 19,
          "text": "(כמבואר בכ\"מ6),"
        },
        {
          "s": 20,
          "text": "ומהו החידוש בהנ\"ל"
        },
        {
          "s": 21,
          "text": "(והעילוי)"
        },
        {
          "s": 22,
          "text": "בוהי' הוי' לי לאלקים7,"
        },
        {
          "s": 23,
          "text": "ובפרט לאחרי ושבתי בשלום אל בית אבי."
        },
        {
          "s": 24,
          "text": "וגם צריך להבין מ\"ש לאח\"ז8"
        },
        {
          "s": 25,
          "text": "והאבן הזאת אשר שמתי מצבה יהי' בית אלקים,"
        },
        {
          "s": 26,
          "text": "איך שייך שאבן שהיא דומם"
        },
        {
          "s": 27,
          "text": "[דגם לאחרי כל העילויים שבה"
        },
        {
          "s": 28,
          "text": "(ע\"י אשר שמתי מצבה)"
        },
        {
          "s": 29,
          "text": "נקראת היא בשם אבן,"
        },
        {
          "s": 30,
          "text": "בחי' דומם]"
        },
        {
          "s": 31,
          "text": "תהי' במדריגה נעלית כ\"כ שתהי' בית אלקים9."
        },
        {
          "s": 32,
          "text": "והנה מבואר בהדרושים10"
        },
        {
          "s": 33,
          "text": "דפירוש והי' הוי' לי לאלקים הוא שיומשך אור נעלה יותר,"
        },
        {
          "s": 34,
          "text": "שלגבי אור זה,"
        },
        {
          "s": 35,
          "text": "הוי'"
        },
        {
          "s": 36,
          "text": "(דעכשיו)"
        },
        {
          "s": 37,
          "text": "יהי'"
        },
        {
          "s": 38,
          "text": "(רק)"
        },
        {
          "s": 39,
          "text": "בחי' אלקים."
        },
        {
          "s": 40,
          "text": "ופירוש והאבן הזאת גו' יהי' בית אלקים"
        },
        {
          "s": 41,
          "text": "(שבא לאחרי ובהמשך לוהי' הוי' לי לאלקים)"
        },
        {
          "s": 42,
          "text": "הוא שהאבן יהי' בית לאלקים שיהי' אז,"
        },
        {
          "s": 43,
          "text": "להוי' שיהי' לאלקים."
        },
        {
          "s": 44,
          "text": "ועפ\"ז צריך ביאור יותר איך שייך שהאבן,"
        },
        {
          "s": 45,
          "text": "דומם,"
        },
        {
          "s": 46,
          "text": "יהי' בית לאלקים זה."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה מכיון שהתורה היא נצחית11,"
        },
        {
          "s": 2,
          "text": "הרי מובן,"
        },
        {
          "s": 3,
          "text": "שענין וידר יעקב נדר גו' הוא הוראה לכאו\"א מישראל בכל המקומות ובכל הזמנים."
        },
        {
          "s": 4,
          "text": "ויתירה מזו,"
        },
        {
          "s": 5,
          "text": "מכיון שמעשה אבות סימן לבנים12,"
        },
        {
          "s": 6,
          "text": "הרי ההוראה מענין וידר יעקב נדר גו' היא"
        },
        {
          "s": 7,
          "text": "(ככל הענינים דמעשה אבות)"
        },
        {
          "s": 8,
          "text": "ביתר שאת וביתר עוז."
        },
        {
          "s": 9,
          "text": "[ומזה מובן,"
        },
        {
          "s": 10,
          "text": "שגם הנתינת כח שבהוראה זו היא לא רק נתינת כח סתם,"
        },
        {
          "s": 11,
          "text": "ככל הוראות התורה"
        },
        {
          "s": 12,
          "text": "(שהן גם נתינת כח13),"
        },
        {
          "s": 13,
          "text": "אלא נתינת כח מיוחדת,"
        },
        {
          "s": 14,
          "text": "מכיון שהוראה זו היא ממעשה אבות,"
        },
        {
          "s": 15,
          "text": "ומעשה אבות הוא"
        },
        {
          "s": 16,
          "text": "(לא רק סימן,"
        },
        {
          "s": 17,
          "text": "אלא גם)"
        },
        {
          "s": 18,
          "text": "נתינת כח14"
        },
        {
          "s": 19,
          "text": "לבנים]."
        },
        {
          "s": 20,
          "text": "ומכיון שוידר יעקב נדר גו' בא בהמשך לויצא15"
        },
        {
          "s": 21,
          "text": "יעקב מבאר שבע גו'"
        },
        {
          "s": 22,
          "text": "[כמובן גם בפשטות,"
        },
        {
          "s": 23,
          "text": "שהבקשה ושבתי בשלום אל בית אבי שייכת לויצא גו'."
        },
        {
          "s": 24,
          "text": "דלהיות שיצא מבאר שבע"
        },
        {
          "s": 25,
          "text": "(ובית אביו)"
        },
        {
          "s": 26,
          "text": "לכן ביקש שישוב ויחזור לשם,"
        },
        {
          "s": 27,
          "text": "ושחזרתו תהי' בשלום],"
        },
        {
          "s": 28,
          "text": "מובן מזה,"
        },
        {
          "s": 29,
          "text": "שכ\"ה גם בנוגע לההוראה לכאו\"א מישראל מוידר יעקב נדר גו'"
        },
        {
          "s": 30,
          "text": "[ומהבקשה ושבתי בשלום אל בית אבי גו'],"
        },
        {
          "s": 31,
          "text": "שזה שייך לענין ויצא גו' מבאר שבע כמו שהוא בכאו\"א מישראל."
        }
      ]
    }
  ]
}