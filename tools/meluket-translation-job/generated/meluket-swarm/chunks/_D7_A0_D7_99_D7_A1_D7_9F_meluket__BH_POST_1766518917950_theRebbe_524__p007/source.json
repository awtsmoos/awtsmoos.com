  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917950_theRebbe_524__p007",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917950_theRebbe_524",
  "title": "מאמר על שלושה דברים תשי\"ד",
  "part": 7,
  "sections": [
    {
      "v": 18,
      "items": [
        {
          "s": 0,
          "text": "והמשכה זו היא ע\"י העבודה בג' הדברים עכשיו."
        },
        {
          "s": 1,
          "text": "אלא שעכשיו הוא בהעלם,"
        },
        {
          "s": 2,
          "text": "ולע\"ל יהי' זה בגילוי,"
        },
        {
          "s": 3,
          "text": "וכמשנת\"ל"
        },
        {
          "s": 4,
          "text": "(במאמר הקודם63)"
        },
        {
          "s": 5,
          "text": "שבמשיח יהי' החיבור דמעלה ומטה,"
        },
        {
          "s": 6,
          "text": "ועל ידו יומשך זה גם בכל העולם,"
        },
        {
          "s": 7,
          "text": "שיהי' מלאה הארץ דיעה את הוי'64,"
        },
        {
          "s": 8,
          "text": "שגם הארץ הגשמיית"
        },
        {
          "s": 9,
          "text": "(דומם,"
        },
        {
          "s": 10,
          "text": "מטה מטה)"
        },
        {
          "s": 11,
          "text": "תהי' מלאה דיעה את הוי'"
        },
        {
          "s": 12,
          "text": "(מעלה מעלה),"
        },
        {
          "s": 13,
          "text": "בביאת משיח צדקנו בקרוב ממש."
        }
      ]
    }
  ]
}