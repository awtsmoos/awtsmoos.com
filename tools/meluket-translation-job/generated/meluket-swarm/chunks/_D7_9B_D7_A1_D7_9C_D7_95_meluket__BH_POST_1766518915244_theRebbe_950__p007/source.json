  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915244_theRebbe_950__p007",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915244_theRebbe_950__p007",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915244_theRebbe_950",
  "title": "מאמר פדה בשלום תשכ\"ב",
  "part": 7,
  "sections": [
    {
      "v": 18,
      "items": [
        {
          "s": 0,
          "text": "והנה ידוע דשכינה היא בחינת מלכות62,"
        },
        {
          "s": 1,
          "text": "הכוללת את כל נשמות ישראל,"
        },
        {
          "s": 2,
          "text": "כמארז\"ל63"
        },
        {
          "s": 3,
          "text": "כל ישראל בני מלכים הם64."
        },
        {
          "s": 4,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 5,
          "text": "דביחוד קוב\"ה ושכינתי' נכלל גם היחוד דהקב\"ה וישראל."
        },
        {
          "s": 6,
          "text": "דשלימות היחוד הוא כשהוא בשני האופנים,"
        },
        {
          "s": 7,
          "text": "המשכה והעלאה."
        },
        {
          "s": 8,
          "text": "ויש לומר,"
        },
        {
          "s": 9,
          "text": "דמהטעמים על זה שענין הנישואין דהקב\"ה וישראל יהי' לעתיד לבוא65,"
        },
        {
          "s": 10,
          "text": "כי אז יהי' גילוי היחידה ע\"י משיח שהוא בחי' יחידה הכללית66,"
        },
        {
          "s": 11,
          "text": "אמיתת הענין דופרצת,"
        },
        {
          "s": 12,
          "text": "ע\"י שיעלה הפורץ לפנינו67,"
        },
        {
          "s": 13,
          "text": "בקרוב ממש."
        }
      ]
    }
  ]
}