{
  "globalIndex": 710,
  "owner": 10,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917950_theRebbe_524__p001",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917950_theRebbe_524__p001",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917950_theRebbe_524",
  "title": "מאמר על שלושה דברים תשי\"ד",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ קדושים,"
        },
        {
          "s": 2,
          "text": "מבה\"ח אייר ה'תשי\"ד*."
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "על שלשה דברים העולם עומד על התורה ועל העבודה ועל גמילות חסדים1,"
        },
        {
          "s": 1,
          "text": "ומביא כ\"ק מו\"ח אדמו\"ר במאמרו ד\"ה זה2"
        },
        {
          "s": 2,
          "text": "פירוש רבינו הזקן,"
        },
        {
          "s": 3,
          "text": "על שלשה דברים העולם עומד – על3"
        },
        {
          "s": 4,
          "text": "שלשה דברים ההעלם עומד."
        },
        {
          "s": 5,
          "text": "ומבאר בהמאמר הקשר דפירוש אדמו\"ר הזקן"
        },
        {
          "s": 6,
          "text": "(ההעלם עומד)"
        },
        {
          "s": 7,
          "text": "עם פירוש הפשוט"
        },
        {
          "s": 8,
          "text": "(העולם עומד),"
        },
        {
          "s": 9,
          "text": "כי ענין העולם הוא העלם4."
        },
        {
          "s": 10,
          "text": "ומוסיף בהמאמר,"
        },
        {
          "s": 11,
          "text": "דההעלם שבעולם הוא לפי שבריאת העולם הוא ע\"י העלם האור."
        },
        {
          "s": 12,
          "text": "וכדאיתא בע\"ח5,"
        },
        {
          "s": 13,
          "text": "דכשהי' אור א\"ס ממלא כל המציאות,"
        },
        {
          "s": 14,
          "text": "לא הי' מקום לעמידת העולם,"
        },
        {
          "s": 15,
          "text": "ובכדי שיהי' מקום לעולמות הוצרך להיות סילוק האור."
        },
        {
          "s": 16,
          "text": "ויש לומר,"
        },
        {
          "s": 17,
          "text": "דבהוספה זו מודגש יותר ענין ההעלם דעולם."
        },
        {
          "s": 18,
          "text": "שההעלם שבו הוא לא כמו דבר נוסף עליו,"
        },
        {
          "s": 19,
          "text": "אלא שבריאת העולם הוא ע\"י העלם האור."
        },
        {
          "s": 20,
          "text": "ויתירה מזו,"
        },
        {
          "s": 21,
          "text": "שמצד ענין הגילוי לא הי' אפילו מקום לעולמות"
        },
        {
          "s": 22,
          "text": "(ולא רק שלא היו מתהוים בפועל)."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "וממשיך בהמאמר6,"
        },
        {
          "s": 1,
          "text": "דכוונת ההעלם הוא בשביל הגילוי."
        },
        {
          "s": 2,
          "text": "וע\"י הסרת ההעלם,"
        },
        {
          "s": 3,
          "text": "מתגלה אור הפנימי שצפון בההעלם."
        },
        {
          "s": 4,
          "text": "וזהו על שלשה דברים העולם עומד,"
        },
        {
          "s": 5,
          "text": "שע\"י העבודה בתורה עבודה וגמ\"ח,"
        },
        {
          "s": 6,
          "text": "מסירים את ההעלם ומתגלה אור הפנימי."
        },
        {
          "s": 7,
          "text": "ויש לומר,"
        },
        {
          "s": 8,
          "text": "דמ\"ש בהמאמר שכוונת ההעלם הוא בשביל הגילוי,"
        },
        {
          "s": 9,
          "text": "הוא בכדי לבאר המשנה על שלשה דברים העולם עומד."
        },
        {
          "s": 10,
          "text": "דהגם שע\"י תורה עבודה וגמ\"ח נמשך גילוי אלקות,"
        },
        {
          "s": 11,
          "text": "מ\"מ אומר על שלשה דברים העולם עומד"
        },
        {
          "s": 12,
          "text": "(ההעלם עומד),"
        },
        {
          "s": 13,
          "text": "כי כוונת ההעלם הוא בשביל הגילוי,"
        },
        {
          "s": 14,
          "text": "דהכוונה של כל דבר הוא ענינו הפנימי."
        },
        {
          "s": 15,
          "text": "ולכן אומר על שלשה דברים העולם"
        },
        {
          "s": 16,
          "text": "(ההעלם)"
        },
        {
          "s": 17,
          "text": "עומד,"
        },
        {
          "s": 18,
          "text": "כי ענינו הפנימי דעולם"
        },
        {
          "s": 19,
          "text": "(העלם)"
        },
        {
          "s": 20,
          "text": "הוא זה שנמשך בו גילוי אלקות."
        }
      ]
    }
  ]
}