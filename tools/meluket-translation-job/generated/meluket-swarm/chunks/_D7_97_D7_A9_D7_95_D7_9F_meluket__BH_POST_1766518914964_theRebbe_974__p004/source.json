{
  "globalIndex": 202,
  "owner": 2,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914964_theRebbe_974__p004",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914964_theRebbe_974__p004",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518914964_theRebbe_974",
  "title": "מאמר ויהיו חיי שרה תשמ\"ה",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ויש לבאר זה ע\"פ מ\"ש בהמאמר39,"
        },
        {
          "s": 2,
          "text": "דבמלכות ישנם שני ענינים הפכיים."
        },
        {
          "s": 3,
          "text": "דענין המלוכה הוא הגבהה והתנשאות"
        },
        {
          "s": 4,
          "text": "(בחינת יש),"
        },
        {
          "s": 5,
          "text": "ואעפ\"כ המלכות היא בתכלית הביטול."
        },
        {
          "s": 6,
          "text": "ומבאר,"
        },
        {
          "s": 7,
          "text": "שהביטול דהמלכות הוא מצד שרשה ברדל\"א,"
        },
        {
          "s": 8,
          "text": "שלכן הביטול שלה הוא ביטול בעצם,"
        },
        {
          "s": 9,
          "text": "ובביטול בעצם,"
        },
        {
          "s": 10,
          "text": "גם היש הוא בביטול."
        },
        {
          "s": 11,
          "text": "והענין בעבודה הוא"
        },
        {
          "s": 12,
          "text": "(כמבואר בהמאמר40)"
        },
        {
          "s": 13,
          "text": "דעבודת ה' צריכה להיות בשמחה דוקא כמ\"ש41"
        },
        {
          "s": 14,
          "text": "עבדו את ה' בשמחה."
        },
        {
          "s": 15,
          "text": "ועד שהשמחה בעבודת ה' היא עיקר גדול,"
        },
        {
          "s": 16,
          "text": "וכידוע פירוש האריז\"ל42"
        },
        {
          "s": 17,
          "text": "והובא בתניא43"
        },
        {
          "s": 18,
          "text": "עה\"פ44"
        },
        {
          "s": 19,
          "text": "תחת אשר לא עבדת את ה' אלקיך בשמחה וגו',"
        },
        {
          "s": 20,
          "text": "ואיתא בתו\"א45"
        },
        {
          "s": 21,
          "text": "דזה שהאריז\"ל זכה לרוה\"ק הוא ע\"י שמחה של מצוה"
        },
        {
          "s": 22,
          "text": "[וכיון שזהו סיפור בתורה"
        },
        {
          "s": 23,
          "text": "(שבעל פה)"
        },
        {
          "s": 24,
          "text": "מלשון הוראה,"
        },
        {
          "s": 25,
          "text": "הרי זה הוראה לכאו\"א מישראל]."
        },
        {
          "s": 26,
          "text": "אלא שאעפ\"כ יש זמנים46"
        },
        {
          "s": 27,
          "text": "שהשמחה צריכה להיות בהעלם,"
        },
        {
          "s": 28,
          "text": "כמ\"ש47"
        },
        {
          "s": 29,
          "text": "עבדו את ה' ביראה וגילו ברעדה,"
        },
        {
          "s": 30,
          "text": "דבגילוי הוא היראה והרעדה,"
        },
        {
          "s": 31,
          "text": "והשמחה"
        },
        {
          "s": 32,
          "text": "(גילה)"
        },
        {
          "s": 33,
          "text": "היא בהעלם48."
        },
        {
          "s": 34,
          "text": "כי כאשר השמחה היא בהתגלות ובמורגש,"
        },
        {
          "s": 35,
          "text": "אפשר שמזה יבוא להרגשת הישות,"
        },
        {
          "s": 36,
          "text": "ועי\"ז אפשר שדברים בלתי רצויים יבואו עי\"ז,"
        },
        {
          "s": 37,
          "text": "ולכן צ\"ל עבדו את ה' ביראה וגילו ברעדה."
        },
        {
          "s": 38,
          "text": "ובכדי שהשמחה תהי' בהתגלות ואעפ\"כ לא יבוא מזה להרגשת הישות,"
        },
        {
          "s": 39,
          "text": "הוא ע\"י שהוא בטל בעצם,"
        },
        {
          "s": 40,
          "text": "שאז,"
        },
        {
          "s": 41,
          "text": "גם המורגש שלו הוא בביטול."
        },
        {
          "s": 42,
          "text": "וע\"ד המבואר לעיל בענין הביטול דמלכות,"
        },
        {
          "s": 43,
          "text": "שגם היש"
        },
        {
          "s": 44,
          "text": "(הגבהה והתנשאות)"
        },
        {
          "s": 45,
          "text": "הוא בביטול."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "וזהו49 ההוספה והחידוש דדילה הוו חיין על זה שזכתה לחיין עילאין,"
        },
        {
          "s": 1,
          "text": "כי זה ששרה נחתת וסלקת"
        },
        {
          "s": 2,
          "text": "(שעי\"ז זכתה לחיין עילאין)"
        },
        {
          "s": 3,
          "text": "הוא ע\"י היראה וביטול"
        },
        {
          "s": 4,
          "text": "(ולא ע\"י השמחה)50,"
        },
        {
          "s": 5,
          "text": "ולכן המשכת החיין עילאין"
        },
        {
          "s": 6,
          "text": "[שע\"י נחתת וסלקת]"
        },
        {
          "s": 7,
          "text": "בהמלכות הוא בהמלכות כמו שהיא בבחינת עלי' וביטול לז\"א"
        },
        {
          "s": 8,
          "text": "[ובעבודת האדם הוא שהגילוי שמאיר לו ע\"י עבודתו הוא כמו שהוא במצב דיראה וביטול,"
        },
        {
          "s": 9,
          "text": "ולא בהמציאות שלו]."
        },
        {
          "s": 10,
          "text": "וענין דילה הוו חיין הוא שההמשכה והגילוי הוא גם בהמציאות דמלכות,"
        },
        {
          "s": 11,
          "text": "כי כיון שהביטול דמלכות הוא ביטול בעצם,"
        },
        {
          "s": 12,
          "text": "לכן גם המורגש דמלכות הוא בביטול,"
        },
        {
          "s": 13,
          "text": "כנ\"ל."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש לבאר מעלת האחדות שלמעלה מהתחלקות דשני חיי שרה שלא נאמר בהם מספר על האחדות דמאה שנה לשון יחיד,"
        },
        {
          "s": 1,
          "text": "דענין האחדות"
        },
        {
          "s": 2,
          "text": "(שנה לשון יחיד)"
        },
        {
          "s": 3,
          "text": "בהספירות שבכתר"
        },
        {
          "s": 4,
          "text": "(מאה),"
        },
        {
          "s": 5,
          "text": "הוא,"
        },
        {
          "s": 6,
          "text": "ע\"י שבהיותם כלולים בשרשם אינם במציאות."
        },
        {
          "s": 7,
          "text": "והחידוש שבשני חיי שרה הוא,"
        },
        {
          "s": 8,
          "text": "דהגם שבמלכות הוא התחלקות פרטים"
        },
        {
          "s": 9,
          "text": "[וכידוע51"
        },
        {
          "s": 10,
          "text": "שעיקר ההתחלקות הוא במלכות],"
        },
        {
          "s": 11,
          "text": "שלכן,"
        },
        {
          "s": 12,
          "text": "גם החיין עילאין הנמשכים במלכות באופן שהם דילה הם בהתחלקות,"
        },
        {
          "s": 13,
          "text": "שני חיי שרה"
        },
        {
          "s": 14,
          "text": "(שני לשון רבים),"
        },
        {
          "s": 15,
          "text": "מ\"מ הם בהתכללות ובהתאחדות כמו דבר אחד ממש"
        },
        {
          "s": 16,
          "text": "(שלכן לא נאמר בהם מספר)."
        },
        {
          "s": 17,
          "text": "ועי\"ז מתגלה אמיתית ענין האחדות52,"
        },
        {
          "s": 18,
          "text": "שגם הריבוי"
        },
        {
          "s": 19,
          "text": "(פרטים מחולקים)"
        },
        {
          "s": 20,
          "text": "אינו סותר לאחדות."
        }
      ]
    }
  ]
}