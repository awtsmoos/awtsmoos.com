{
  "globalIndex": 901,
  "owner": 1,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919159_theRebbe_441__p001",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919159_theRebbe_441__p001",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919159_theRebbe_441",
  "title": "מאמר ה' לי בעוזרי תשי\"ז",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "י\"ב תמוז ה'תשי\"ז*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "הוי' לי בעוזרי ואני אראה בשונאי1,"
        },
        {
          "s": 1,
          "text": "ומדייק כ\"ק מו\"ח אדמו\"ר בעל השמחה והגאולה במאמרו ד\"ה זה"
        },
        {
          "s": 2,
          "text": "(שאמרו בי\"ב תמוז הראשון,"
        },
        {
          "s": 3,
          "text": "תרפ\"ז)2,"
        },
        {
          "s": 4,
          "text": "דמשמעות הלשון הוי' לי בעוזרי הוא שישנם עוזרים אחרים,"
        },
        {
          "s": 5,
          "text": "והבקשה היא שגם הקב\"ה יהי' בין העוזרים,"
        },
        {
          "s": 6,
          "text": "ואינו מובן3,"
        },
        {
          "s": 7,
          "text": "הרי כל ישראל מאמינים באמונה פשוטה שהוא ית' לבדו הוא העוזר והמושיע להאדם בכל עניניו,"
        },
        {
          "s": 8,
          "text": "והיאך אומר הוי' לי בעוזרי,"
        },
        {
          "s": 9,
          "text": "דמשמעות הלשון הוא שישנם עוזרים אחרים,"
        },
        {
          "s": 10,
          "text": "שהם העוזרים האמיתים,"
        },
        {
          "s": 11,
          "text": "והקב\"ה מצטרף עמהם."
        },
        {
          "s": 12,
          "text": "וגם צ\"ל מהו הבקשה ואני אראה בשונאי"
        },
        {
          "s": 13,
          "text": "(שיראה נקמה בשונאיו),"
        },
        {
          "s": 14,
          "text": "דלכאורה הוי לי' לבקש שהאויבים והשונאים יהפכו לאוהבים."
        },
        {
          "s": 15,
          "text": "והגם דשנאתו של דוד היתה רק לשונאי הוי' כמ\"ש4"
        },
        {
          "s": 16,
          "text": "הלא משנאיך הוי' אשנא ובתקוממיך אתקוטט,"
        },
        {
          "s": 17,
          "text": "מ\"מ,"
        },
        {
          "s": 18,
          "text": "הרי כתיב5"
        },
        {
          "s": 19,
          "text": "יתמו חטאים ולא חוטאים"
        },
        {
          "s": 20,
          "text": "[דענין זה הוא גם בשונאי הוי',"
        },
        {
          "s": 21,
          "text": "וכמו שראינו בהנהגת רבותינו נשיאינו,"
        },
        {
          "s": 22,
          "text": "ובמיוחד בבעל הגאולה,"
        },
        {
          "s": 23,
          "text": "שקירבו גם את אלו שנכללים בהסוג המדובר בתניא פרק לב בסופו,"
        },
        {
          "s": 24,
          "text": "והחזירו אותם למוטב6],"
        },
        {
          "s": 25,
          "text": "והוה לי' לבקש שיעשו תשובה,"
        },
        {
          "s": 26,
          "text": "ומהי הבקשה ואני אראה בשונאי."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ולהבין זה מקדים בהמאמר7"
        },
        {
          "s": 2,
          "text": "מה שאמר דוד8"
        },
        {
          "s": 3,
          "text": "זמירות היו לי חוקיך בבית מגורי,"
        },
        {
          "s": 4,
          "text": "שבעת היותו נע ונד מטולטל בגירות"
        },
        {
          "s": 5,
          "text": "(מגורי מלשון גירות9)"
        },
        {
          "s": 6,
          "text": "ומלא פחדים"
        },
        {
          "s": 7,
          "text": "(מגורי מלשון מגור ופחד10)"
        },
        {
          "s": 8,
          "text": "משונאיו ומרודפיו,"
        },
        {
          "s": 9,
          "text": "הי' מתענג ושמח בדברי תורה"
        },
        {
          "s": 10,
          "text": "(חוקיך),"
        },
        {
          "s": 11,
          "text": "שהיו ערבים ומתוקים לו כמו זמירות וניגונים."
        },
        {
          "s": 12,
          "text": "וצריך להבין,"
        },
        {
          "s": 13,
          "text": "הרי יש ריבוי מיני תענוגים,"
        },
        {
          "s": 14,
          "text": "ומדוע מדמה דוד התענוג שהי' לו בדברי תורה להתענוג שבזמירות דוקא."
        },
        {
          "s": 15,
          "text": "וגם צריך להבין,"
        },
        {
          "s": 16,
          "text": "הרי במצוות יש ג' סוגים,"
        },
        {
          "s": 17,
          "text": "משפטים עדות וחוקים11,"
        },
        {
          "s": 18,
          "text": "משפטים הם המצוות שמחוייבים גם מצד השכל"
        },
        {
          "s": 19,
          "text": "(כמו גזל גניבה אונאה כיבוד אב ואם)."
        },
        {
          "s": 20,
          "text": "עדות הם המצוות שהם אות וזכרון"
        },
        {
          "s": 21,
          "text": "(כמו שבת פסח סוכה ותפילין),"
        },
        {
          "s": 22,
          "text": "דגם מצוות אלו יש להם מקום בשכל."
        },
        {
          "s": 23,
          "text": "דהגם שהשכל מצד עצמו"
        },
        {
          "s": 24,
          "text": "(לולי ציווי התורה)"
        },
        {
          "s": 25,
          "text": "לא הי' מחייבם"
        },
        {
          "s": 26,
          "text": "[ודלא כהמצוות דמשפטים שגם אלמלא ניתנה תורה היינו למידין צניעות מחתול וגזל מנמלה12],"
        },
        {
          "s": 27,
          "text": "מ\"מ,"
        },
        {
          "s": 28,
          "text": "לאחרי שהתורה ציוותה עליהם,"
        },
        {
          "s": 29,
          "text": "גם השכל מסכים לזה."
        },
        {
          "s": 30,
          "text": "משא\"כ חוקים,"
        },
        {
          "s": 31,
          "text": "הם המצוות שאינם ע\"פ טעם,"
        },
        {
          "s": 32,
          "text": "ורק בדרך חוקה חקקתי גזירה גזרתי13."
        },
        {
          "s": 33,
          "text": "וצריך להבין מ\"ש זמירות היו לי חוקיך,"
        },
        {
          "s": 34,
          "text": "הרי פשוט שהתענוג והשמחה של דוד המלך בעסק התורה הי' בכל דיני התורה"
        },
        {
          "s": 35,
          "text": "(גם בהדינים דעדות ומשפטים),"
        },
        {
          "s": 36,
          "text": "ומהו אומרו זמירות היו לי חוקיך,"
        },
        {
          "s": 37,
          "text": "חוקיך דוקא."
        }
      ]
    }
  ]
}