{
  "globalIndex": 28,
  "owner": 28,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913820_theRebbe_687__p007",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913820_theRebbe_687__p007",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518913820_theRebbe_687",
  "title": "מאמר זה היום תחילת מעשיך תשמ\"א",
  "part": 7,
  "sections": [
    {
      "v": 18,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ג)"
        },
        {
          "s": 2,
          "text": "וכל זה נעשה ע\"י כל פעולה טובה של כאו\"א מישראל,"
        },
        {
          "s": 3,
          "text": "וכהפס\"ד116"
        },
        {
          "s": 4,
          "text": "שע\"י מצוה אחת"
        },
        {
          "s": 5,
          "text": "(במחשבה,"
        },
        {
          "s": 6,
          "text": "ומכ\"ש בדיבור ומכ\"ש במעשה)"
        },
        {
          "s": 7,
          "text": "מכריע את כל העולם כולו לכף זכות."
        },
        {
          "s": 8,
          "text": "דפס\"ד זה הוא במשך כל השנה."
        },
        {
          "s": 9,
          "text": "ועאכו\"כ בראש השנה שאז אין שייך כלל לומר שהעולם הוא שקול ח\"ו,"
        },
        {
          "s": 10,
          "text": "שהרי כבר בערב ראש השנה יודעים בבירור גמור שיזכו בדין117,"
        },
        {
          "s": 11,
          "text": "ועאכו\"כ בראש השנה גופא,"
        },
        {
          "s": 12,
          "text": "ובפרט לאחרי תקיעת שופר,"
        },
        {
          "s": 13,
          "text": "דכל שנה שהיא רשה בתחלתה מתעשרת בסופה118"
        },
        {
          "s": 14,
          "text": "וידוע דרשה בתחלתה קאי על"
        },
        {
          "s": 15,
          "text": "(קודם)"
        },
        {
          "s": 16,
          "text": "תקיעת שופר כי שופר הוא בחי' מיצר ומן119"
        },
        {
          "s": 17,
          "text": "המיצר קראתי י\"ה120,"
        },
        {
          "s": 18,
          "text": "ומיד לאחרי זה מתעשרת,"
        },
        {
          "s": 19,
          "text": "ענני119"
        },
        {
          "s": 20,
          "text": "במרחב י\"ה,"
        },
        {
          "s": 21,
          "text": "באור פניך יהלכון121,"
        },
        {
          "s": 22,
          "text": "בכתיבה וחתימה טובה122"
        },
        {
          "s": 23,
          "text": "בטוב הנראה והנגלה בכל המצטרך,"
        },
        {
          "s": 24,
          "text": "ועאכו\"כ בענין העיקרי123"
        },
        {
          "s": 25,
          "text": "– ביאת משיח צדקנו במהרה בימינו בעגלא דידן,"
        },
        {
          "s": 26,
          "text": "ממש."
        }
      ]
    }
  ]
}