{
  "globalIndex": 318,
  "owner": 18,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915585_theRebbe_828__p005",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915585_theRebbe_828__p005",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915585_theRebbe_828",
  "title": "מאמר פתח אליהו תשט\"ו",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "לומר,"
        },
        {
          "s": 1,
          "text": "דהטעם על זה שהענין דטבע מלשון טביעה בהתהוות הנבראים מובא בהדרושים בסגנון של חידוש"
        },
        {
          "s": 2,
          "text": "[שגם בזה י\"ל טבע מלשון טביעה30],"
        },
        {
          "s": 3,
          "text": "כי מהחילוקים בין חיות הנבראים להתהוות הנבראים הוא,"
        },
        {
          "s": 4,
          "text": "דהחיות האלקי שמחי' את הנבראים הוא בגילוי בהנבראים,"
        },
        {
          "s": 5,
          "text": "שנרגש בהם שיש בהם חיות,"
        },
        {
          "s": 6,
          "text": "וענין ההעלם הוא רק שאינו נרגש שהחיות שבהם הוא חיות אלקי31,"
        },
        {
          "s": 7,
          "text": "וההתהוות דהנבראים"
        },
        {
          "s": 8,
          "text": "(שנבראו מאין ליש)"
        },
        {
          "s": 9,
          "text": "אינה נרגשת בהם."
        },
        {
          "s": 10,
          "text": "דלא רק שלא נרגש בהם שההתהוות היא מאלקות,"
        },
        {
          "s": 11,
          "text": "אלא שעצם ענין ההתהוות שלהם אינה נרגשת בהם32."
        },
        {
          "s": 12,
          "text": "והטעם לזה הוא,"
        },
        {
          "s": 13,
          "text": "כי החיות האלקי הוא מתלבש בהנבראים ע\"י לבושים המעלימים33."
        },
        {
          "s": 14,
          "text": "[וכיון שהוא מלובש בהנבראים לכן הוא נרגש בהם,"
        },
        {
          "s": 15,
          "text": "אלא שמצד לבושים המעלימים אין נרגש בהם שהוא חיות אלקי]."
        },
        {
          "s": 16,
          "text": "והכח האלקי שמהווה את הנבראים הוא מובדל מהנבראים ואינו מלובש בהם33."
        },
        {
          "s": 17,
          "text": "[ולכן אין נרגש בהנבראים ההתהוות שלהם]."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש לבאר,"
        },
        {
          "s": 1,
          "text": "שהענין דטבע מלשון טביעה הוא בעיקר בחיות הנבראים,"
        },
        {
          "s": 2,
          "text": "כי ענין הטביעה הוא שהדבר הנטבע נמצא בהמים ועי\"ז המים מכסים עליו,"
        },
        {
          "s": 3,
          "text": "דבהנמשל הוא,"
        },
        {
          "s": 4,
          "text": "שהחיות האלקי הוא מלובש בהנבראים ועי\"ז הם מעלימים עליו."
        },
        {
          "s": 5,
          "text": "משא\"כ ההעלם שבענין ההתהוות הוא מפני שהכח האלקי שמהווה את הנבראים הוא מובדל מהם ואינו מלובש בהם."
        },
        {
          "s": 6,
          "text": "וענין טבע מלשון טביעה בנוגע לכח המהווה הוא"
        },
        {
          "s": 7,
          "text": "(בעיקר)"
        },
        {
          "s": 8,
          "text": "בענין ההעלם"
        },
        {
          "s": 9,
          "text": "(ולא באופן ההעלם)34."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "והנה מבואר במק\"א35,"
        },
        {
          "s": 2,
          "text": "דבצורה שני ענינים."
        },
        {
          "s": 3,
          "text": "צורה האמיתית,"
        },
        {
          "s": 4,
          "text": "שהיא הנפש,"
        },
        {
          "s": 5,
          "text": "וחומר הגוף,"
        },
        {
          "s": 6,
          "text": "שנקרא ג\"כ בשם צורה,"
        },
        {
          "s": 7,
          "text": "צורת החומר."
        },
        {
          "s": 8,
          "text": "ושני הענינים שייכים זה לזה,"
        },
        {
          "s": 9,
          "text": "דצורת הגוף הוא כלי להנפש."
        },
        {
          "s": 10,
          "text": "ועפ\"ז,"
        },
        {
          "s": 11,
          "text": "הגם שעיקר הענין דחותמו של אדה\"ר"
        },
        {
          "s": 12,
          "text": "(צורת מין האדם)"
        },
        {
          "s": 13,
          "text": "היא צורה הנפשית"
        },
        {
          "s": 14,
          "text": "(כמובא לעיל סעיף ה מהדרושים),"
        },
        {
          "s": 15,
          "text": "שייך זה גם לצורת גוף האדם36."
        },
        {
          "s": 16,
          "text": "ומזה מובן גם בנוגע לטבע,"
        },
        {
          "s": 17,
          "text": "שעיקר הענין דטבע"
        },
        {
          "s": 18,
          "text": "(להפירוש שטבע הוא מלשון שטבע הקב\"ה כל אדם בחותמו של אדה\"ר)"
        },
        {
          "s": 19,
          "text": "הוא החיות האלקי דהעולם שהוא נפש העולם,"
        },
        {
          "s": 20,
          "text": "וגם שייך זה לצורת הנבראים,"
        },
        {
          "s": 21,
          "text": "צורת החומר."
        },
        {
          "s": 22,
          "text": "דצורת הנבראים היא הכלי להחיות והנפש שבהם."
        }
      ]
    }
  ]
}