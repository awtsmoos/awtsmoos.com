{
  "globalIndex": 511,
  "owner": 11,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916782_theRebbe_480__p001",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916782_theRebbe_480__p001",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916782_theRebbe_480",
  "title": "מאמר באתי לגני תשכ\"ט",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "יו\"ד שבט,"
        },
        {
          "s": 2,
          "text": "ה'תשכ\"ט"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "באתי לגני אחותי כלה1,"
        },
        {
          "s": 1,
          "text": "ומביא כ\"ק מו\"ח אדמו\"ר בעל ההילולא בהמאמר דיום ההסתלקות יום ההילולא שלו2,"
        },
        {
          "s": 2,
          "text": "דאיתא במדרש רבה"
        },
        {
          "s": 3,
          "text": "(במקומו)"
        },
        {
          "s": 4,
          "text": "לגני לגנוני,"
        },
        {
          "s": 5,
          "text": "למקום שהי' עיקרי בתחלה,"
        },
        {
          "s": 6,
          "text": "דעיקר שכינה בתחתונים היתה,"
        },
        {
          "s": 7,
          "text": "אלא שע\"י ענינים בלתי רצויים נסתלקה השכינה מלמטה למעלה עד לרקיע השביעי,"
        },
        {
          "s": 8,
          "text": "ואח\"כ עמדו שבעה צדיקים והורידו את השכינה מלמעלה למטה,"
        },
        {
          "s": 9,
          "text": "עד שבא משה שהוא השביעי,"
        },
        {
          "s": 10,
          "text": "וכל השביעין חביבין3,"
        },
        {
          "s": 11,
          "text": "והורידה למטה בארץ."
        },
        {
          "s": 12,
          "text": "דענין זה"
        },
        {
          "s": 13,
          "text": "(המשכת וירידת השכינה למטה בארץ)"
        },
        {
          "s": 14,
          "text": "נעשה בעיקר4"
        },
        {
          "s": 15,
          "text": "ע\"י המשכן שעשה משה כמ\"ש5"
        },
        {
          "s": 16,
          "text": "ועשו לי מקדש ושכנתי בתוכם."
        },
        {
          "s": 17,
          "text": "וזהו צדיקים יירשו ארץ וישכנו לעד עלי'6,"
        },
        {
          "s": 18,
          "text": "דזה שצדיקים"
        },
        {
          "s": 19,
          "text": "(ועמך7"
        },
        {
          "s": 20,
          "text": "כולם צדיקים8)"
        },
        {
          "s": 21,
          "text": "יירשו ארץ שהוא ג\"ע הוא מפני שהם משכינים"
        },
        {
          "s": 22,
          "text": "(ממשיכים9)"
        },
        {
          "s": 23,
          "text": "בחי' שוכן עד מרום וקדוש10"
        },
        {
          "s": 24,
          "text": "שיהי' בגילוי למטה."
        },
        {
          "s": 25,
          "text": "ויש לומר,"
        },
        {
          "s": 26,
          "text": "דע\"פ מ\"ש בהמאמר שפירוש וישכנו לעד עלי' הוא שהצדיקים ממשיכים בחי' עד שתהי' בגילוי למטה,"
        },
        {
          "s": 27,
          "text": "בהכרח לומר שארץ שבפסוק זה הוא ארץ כפשוטו"
        },
        {
          "s": 28,
          "text": "[שהרי עלי' קאי על ארץ דכאן],"
        },
        {
          "s": 29,
          "text": "ומ\"ש בהמאמר שצדיקים יירשו ארץ הוא ג\"ע,"
        },
        {
          "s": 30,
          "text": "הכוונה בזה היא לא לעולם הנשמות כמו שהם בלא גופים,"
        },
        {
          "s": 31,
          "text": "אלא להג\"ע כמו שהוא בארץ הגשמי,"
        },
        {
          "s": 32,
          "text": "שהי' בו אדה\"ר"
        },
        {
          "s": 33,
          "text": "(בגופו הגשמי)"
        },
        {
          "s": 34,
          "text": "קודם החטא,"
        },
        {
          "s": 35,
          "text": "שאז היתה עיקר שכינה בתחתונים."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 2,
          "text": "שהעבודה שעל ידה נעשתה המשכת עיקר שכינה למטה"
        },
        {
          "s": 3,
          "text": "(לאחרי שנסתלקה על ידי ז' הענינים הבלתי רצויים)"
        },
        {
          "s": 4,
          "text": "היא העבודה דאתכפיא ואתהפכא."
        },
        {
          "s": 5,
          "text": "כמאמר11"
        },
        {
          "s": 6,
          "text": "כד אתכפיא סט\"א אסתלק יקרא דקוב\"ה בכולהו עלמין,"
        },
        {
          "s": 7,
          "text": "המשכת וגילוי עצמות אוא\"ס שלמעלה משייכות לעולמות"
        },
        {
          "s": 8,
          "text": "[שלכן נקראת המשכה זו בשם אסתלק,"
        },
        {
          "s": 9,
          "text": "לפי שהוא גילוי האור שבבחינת רוממות12],"
        },
        {
          "s": 10,
          "text": "שהוא בכולהו עלמין בשוה."
        },
        {
          "s": 11,
          "text": "דבעולמות יש ריבוי מדריגות עד אין קץ13."
        },
        {
          "s": 12,
          "text": "דזה שמבואר בכ\"מ שישנם ב' עולמות,"
        },
        {
          "s": 13,
          "text": "כמ\"ש14"
        },
        {
          "s": 14,
          "text": "מן העולם ועד העולם,"
        },
        {
          "s": 15,
          "text": "שהם עלמא דאתכסיא ועלמא דאתגליא15,"
        },
        {
          "s": 16,
          "text": "הוא בכללות16,"
        },
        {
          "s": 17,
          "text": "אבל בפרטיות הם מתחלקים לד' עולמות אבי\"ע"
        },
        {
          "s": 18,
          "text": "[וי\"ל דזהו מה שמביא בהמאמר בתחלת הענין מאמר המדרש17"
        },
        {
          "s": 19,
          "text": "נטה ימינו וברא שמים נטה שמאלו וברא ארץ,"
        },
        {
          "s": 20,
          "text": "ולאח\"ז מבאר \"ההפרש בד' עולמות\","
        },
        {
          "s": 21,
          "text": "דכללות כל העולמות נחלקות לשני דרגות כלליות,"
        },
        {
          "s": 22,
          "text": "עולמות עליונים"
        },
        {
          "s": 23,
          "text": "(שמים)"
        },
        {
          "s": 24,
          "text": "ועולמות תחתונים"
        },
        {
          "s": 25,
          "text": "(ארץ),"
        },
        {
          "s": 26,
          "text": "ע\"ד עלמא דאתכסיא ועלמא דאתגליא,"
        },
        {
          "s": 27,
          "text": "אבל בפרטיות הן ד' עולמות אבי\"ע],"
        },
        {
          "s": 28,
          "text": "ובפרטיות יותר לריבוי עולמות עד אין קץ."
        },
        {
          "s": 29,
          "text": "וזהו החידוש והעילוי דאור זה שהוא \"בכולהו עלמין\","
        },
        {
          "s": 30,
          "text": "דהגם שיש ריבוי התחלקות בעולמות מראש כל דרגין עד סוף כל דרגין,"
        },
        {
          "s": 31,
          "text": "מ\"מ הוא בכולהו עלמין בשוה,"
        },
        {
          "s": 32,
          "text": "לפי שהוא למעלה משייכות לעולמות."
        },
        {
          "s": 33,
          "text": "והמשכת אור זה שבכולהו עלמין בשוה היא על ידי העבודה דאתכפיא ואתהפכא."
        }
      ]
    }
  ]
}