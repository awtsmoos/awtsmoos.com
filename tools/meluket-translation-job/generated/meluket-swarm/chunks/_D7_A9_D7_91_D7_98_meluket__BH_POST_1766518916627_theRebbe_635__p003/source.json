  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916627_theRebbe_635__p003",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916627_theRebbe_635",
  "title": "רשימה באתי לגני תשי\"ג",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "נפה\"ב22"
        },
        {
          "s": 1,
          "text": "בהמה23,"
        },
        {
          "s": 2,
          "text": "(וככה פנ\"א)"
        },
        {
          "s": 3,
          "text": "כי זהו שטות להפך ולהחליף על עונג גשמי,"
        },
        {
          "s": 4,
          "text": "כיון שנמשך רק מפסולת דלמע',"
        },
        {
          "s": 5,
          "text": "שזהו ענין המלאכים שנק' קרבים,"
        },
        {
          "s": 6,
          "text": "ובפרט כאשר זה מאבד העונג הרוחני מקורם24."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "(הוספה ס' התולדות25)"
        },
        {
          "s": 1,
          "text": "שאין להם דעת26,"
        },
        {
          "s": 2,
          "text": "אף שמבינים,"
        },
        {
          "s": 3,
          "text": "אבל אין זה בהכרה והרגשה"
        },
        {
          "s": 4,
          "text": "(בקצור בקונ' התפלה,"
        },
        {
          "s": 5,
          "text": "ובארוכה בהמשך עת\"ר27),"
        },
        {
          "s": 6,
          "text": "היפך הכוונה."
        },
        {
          "s": 7,
          "text": "אבל ע\"י שטות דקדושה,"
        },
        {
          "s": 8,
          "text": "משכן מעצי שטים,"
        },
        {
          "s": 9,
          "text": "ואז ושכנתי בתוכם28."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "כמו שבמשכן השראת השכינה בפועל ע\"י משה ואהרן,"
        },
        {
          "s": 1,
          "text": "שוד\"מ ושודמ\"ט29,"
        },
        {
          "s": 2,
          "text": "ע\"י אהב\"י30,"
        },
        {
          "s": 3,
          "text": "כמו\"כ אתפש' דמשה ואהרן ע\"י אהב\"י31."
        }
      ]
    }
  ]
}