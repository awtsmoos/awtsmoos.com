{
  "globalIndex": 672,
  "owner": 22,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917720_theRebbe_340__p006",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917720_theRebbe_340__p006",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917720_theRebbe_340",
  "title": "מאמר ויקרא אל משה תשל\"ב",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "וזהו ויקרא אל משה וידבר הוי' גו' אדם כי יקריב גו',"
        },
        {
          "s": 2,
          "text": "דזה שלכל דיברות וכו' קדמה קריאה לשון חיבה הוא גם קדימה במעלה,"
        },
        {
          "s": 3,
          "text": "שהקריאה היא למעלה מהדיבור62."
        },
        {
          "s": 4,
          "text": "ועד שנאמר ויקרא סתם ולא נאמר מי הוא הקורא,"
        },
        {
          "s": 5,
          "text": "כי הקריאה היא מעצמות אוא\"ס שלמעלה מהוי'63."
        },
        {
          "s": 6,
          "text": "אלא שאעפ\"כ,"
        },
        {
          "s": 7,
          "text": "מזה שהקריאה היתה לפני דיבור דוקא"
        },
        {
          "s": 8,
          "text": "(אף שקריאה לשון חיבה הו\"ע בפ\"ע,"
        },
        {
          "s": 9,
          "text": "ולא הכנה להדיבור),"
        },
        {
          "s": 10,
          "text": "מובן,"
        },
        {
          "s": 11,
          "text": "שהקריאה שייכת גם להדיבור."
        },
        {
          "s": 12,
          "text": "ויש לומר,"
        },
        {
          "s": 13,
          "text": "שהדיברות והאמירות והציוויים דתורה הם מהוי',"
        },
        {
          "s": 14,
          "text": "וכמ\"ש בכל הדיברות כו' דתורה"
        },
        {
          "s": 15,
          "text": "(וגם בהדיבור שבפסוק זה)"
        },
        {
          "s": 16,
          "text": "וידבר הוי',"
        },
        {
          "s": 17,
          "text": "והקריאה היא מהעצמות כנ\"ל,"
        },
        {
          "s": 18,
          "text": "וענין ויקרא וידבר הוא המשכת וגילוי העצמות"
        },
        {
          "s": 19,
          "text": "(שלמעלה מהתורה)"
        },
        {
          "s": 20,
          "text": "בהדיבור דתורה."
        },
        {
          "s": 21,
          "text": "ובכללות הוא המשכת התורה כמו שהיא מושרשת בהעצמות."
        },
        {
          "s": 22,
          "text": "ויש לקשר זה עם מ\"ש ויקרא באל\"ף זעירא,"
        },
        {
          "s": 23,
          "text": "וכתורת אדמו\"ר הזקן"
        },
        {
          "s": 24,
          "text": "(שאמר להצ\"צ בהיותו בן ג' שנים)64"
        },
        {
          "s": 25,
          "text": "שהאל\"ף זעירא דויקרא מורה על הענוה והביטול דמשה,"
        },
        {
          "s": 26,
          "text": "דהגם שידע מעלות עצמו,"
        },
        {
          "s": 27,
          "text": "מ\"מ לא החשיב את עצמו,"
        },
        {
          "s": 28,
          "text": "ואדרבא ידיעה זו הביאה אותו להיות שפל בעיני עצמו עוד יותר"
        },
        {
          "s": 29,
          "text": "(כמבואר שם בארוכה)."
        },
        {
          "s": 30,
          "text": "ויש לומר שמהטעמים על זה שהאל\"ף זעירא הרומזת על הביטול דמשה היא בתיבת ויקרא,"
        },
        {
          "s": 31,
          "text": "הוא,"
        },
        {
          "s": 32,
          "text": "כי ע\"י הביטול שלו נעשה כלי להגילוי דויקרא,"
        },
        {
          "s": 33,
          "text": "המשכת וגילוי התורה כמו שהיא מושרשת בהעצמות"
        },
        {
          "s": 34,
          "text": "(וע\"ד שנת\"ל בענין יששכר)."
        },
        {
          "s": 35,
          "text": "ועפ\"ז יובן מה שנאמר ויקרא בפרשת הקרבנות,"
        },
        {
          "s": 36,
          "text": "אף שלכל הדיברות כו' קדמה קריאה,"
        },
        {
          "s": 37,
          "text": "כי ענין זה דתורה שהיא מושרשת בהעצמות מתגלה בעיקר בזה שהתורה עוסקת בדיני הקרבנות,"
        },
        {
          "s": 38,
          "text": "לברר את העולם ולעשותו דירה לו ית'."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "והנה ידוע,"
        },
        {
          "s": 1,
          "text": "דבכאו\"א מישראל יש מבחינת משה65,"
        },
        {
          "s": 2,
          "text": "כולל הביטול דמשה66."
        },
        {
          "s": 3,
          "text": "ומזה מובן,"
        },
        {
          "s": 4,
          "text": "שענין ויקרא אל משה הוא גם לכאו\"א מישראל67."
        },
        {
          "s": 5,
          "text": "ובפרט כשלומד פסוק זה."
        },
        {
          "s": 6,
          "text": "ועי\"ז גם נמשכת לו נתינת כח על עבודת הקרבנות ברוחניות,"
        },
        {
          "s": 7,
          "text": "וזה נעשה הכנה קרובה לעבודת הקרבנות כפשוטה,"
        },
        {
          "s": 8,
          "text": "ושם נעשה לפניך כמצות רצונך68,"
        },
        {
          "s": 9,
          "text": "בבית המקדש השלישי שיבנה במהרה בימינו,"
        },
        {
          "s": 10,
          "text": "ובקרוב ממש."
        }
      ]
    }
  ]
}