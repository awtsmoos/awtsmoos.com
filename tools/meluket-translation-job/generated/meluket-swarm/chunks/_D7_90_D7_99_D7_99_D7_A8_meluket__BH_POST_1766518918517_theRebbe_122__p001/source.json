  "globalIndex": 789,
  "owner": 39,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918517_theRebbe_122__p001",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918517_theRebbe_122__p001",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918517_theRebbe_122",
  "title": "מאמר שיר המעלות תשכ\"ב",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ל\"ג בעומר,"
        },
        {
          "s": 2,
          "text": "ה'תשכ\"ב*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "שיר המעלות לדוד הנה מה טוב ומה נעים שבת אחים גם יחד1,"
        },
        {
          "s": 1,
          "text": "ומדייק כ\"ק מו\"ח אדמו\"ר במאמרו ד\"ה זה2,"
        },
        {
          "s": 2,
          "text": "הרי שבת אחים הוא שיושבים יחד באחוה ובאהבה,"
        },
        {
          "s": 3,
          "text": "ומה מוסיף גם יחד."
        },
        {
          "s": 4,
          "text": "ומבאר,"
        },
        {
          "s": 5,
          "text": "דאחים הם הנשמות דדכר ונוקבא השייכים זל\"ז3"
        },
        {
          "s": 6,
          "text": "(חתן וכלה),"
        },
        {
          "s": 7,
          "text": "ושבת אחים הוא הקירוב וההתקשרות שלהם בקישורי תנאים,"
        },
        {
          "s": 8,
          "text": "וזהו הכנה להנשואין,"
        },
        {
          "s": 9,
          "text": "שאז נעשה"
        },
        {
          "s": 10,
          "text": "(גם)"
        },
        {
          "s": 11,
          "text": "יחד,"
        },
        {
          "s": 12,
          "text": "נוסף על התקשרות גם יחוד."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 1,
          "text": "דאיתא בזהר4"
        },
        {
          "s": 2,
          "text": "שבת אחים גם יחד,"
        },
        {
          "s": 3,
          "text": "קוב\"ה וכנסת ישראל,"
        },
        {
          "s": 4,
          "text": "גם לרבות ישראל דלתתא."
        },
        {
          "s": 5,
          "text": "ויש לומר,"
        },
        {
          "s": 6,
          "text": "שהשייכות דהפירוש שאחים הם חתן וכלה עם מאמר הזהר דקאי על קוב\"ה וכנס\"י,"
        },
        {
          "s": 7,
          "text": "הוא,"
        },
        {
          "s": 8,
          "text": "כי חתן וכלה שלמטה משתלשלים מחתן וכלה שלמעלה5,"
        },
        {
          "s": 9,
          "text": "הקב\"ה וכנסת ישראל6,"
        },
        {
          "s": 10,
          "text": "ולכן מביא בהמאמר מ\"ש בזהר"
        },
        {
          "s": 11,
          "text": "(שבת)"
        },
        {
          "s": 12,
          "text": "אחים הם הקב\"ה וכנס\"י,"
        },
        {
          "s": 13,
          "text": "כי זהו היסוד להפירוש שאחים הם חתן וכלה."
        }
      ]
    }
  ]
}