{
  "globalIndex": 696,
  "owner": 46,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917870_theRebbe_730__p003",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917870_theRebbe_730__p003",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917870_theRebbe_730",
  "title": "מאמר אשרי תבחר ותקרב תשט\"ז",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה כיון שהשכל דנפש השכלית מצד עצמו הוא בחינת יש,"
        },
        {
          "s": 2,
          "text": "ויתירה מזה שהוא מקליפת נוגה,"
        },
        {
          "s": 3,
          "text": "לכן,"
        },
        {
          "s": 4,
          "text": "גם לאחרי שהשכל דנפש השכלית משיג ריחוק הערך שלו לגבי אלקות"
        },
        {
          "s": 5,
          "text": "[שההשגה שלו בהענינים דאלקות היא בהגבלה ובהגשמה ואינו משיג את הענינים כמו שהם לאמיתתם],"
        },
        {
          "s": 6,
          "text": "שעי\"ז היא באה לידי ביטול,"
        },
        {
          "s": 7,
          "text": "הביטול שלה אינו בערך כלל להביטול דנפש האלקית."
        },
        {
          "s": 8,
          "text": "דבנפש האלקית,"
        },
        {
          "s": 9,
          "text": "הביטול שלה היא בעצם מציאותה,"
        },
        {
          "s": 10,
          "text": "ובנפש השכלית,"
        },
        {
          "s": 11,
          "text": "הביטול שלה היא דבר נוסף על מציאותה,"
        },
        {
          "s": 12,
          "text": "ובעצם היא בחינת יש."
        },
        {
          "s": 13,
          "text": "וזהו שגם חצר המקורה בגג הוא חצר שהוא מקום שבו נמצאים בעלי חיים"
        },
        {
          "s": 14,
          "text": "(כנ\"ל סעיף ב)"
        },
        {
          "s": 15,
          "text": "ולא דירת אדם,"
        },
        {
          "s": 16,
          "text": "כי אדם בגימטריא מ\"ה24"
        },
        {
          "s": 17,
          "text": "הוא הביטול דנפש האלקית שנקראת אדם על שם אדמה לעליון25,"
        },
        {
          "s": 18,
          "text": "משא\"כ הביטול דנפש הבהמית ודנפש השכלית שהוא ביטול היש,"
        },
        {
          "s": 19,
          "text": "הוא בחינת חי שלמטה מאדם."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "והנה גם בהביטול דנפש האלקית,"
        },
        {
          "s": 1,
          "text": "שתי מדריגות בכללות."
        },
        {
          "s": 2,
          "text": "דהנה ידוע26"
        },
        {
          "s": 3,
          "text": "שבכדי שנפש האלקית תפעול בנפש הבהמית ובנפש השכלית הוא ע\"י שהשכל והמדות דנפש האלקית באים במדידה והגבלה באופן שיהיו שייכים לנפש השכלית וגם לנפש הבהמית,"
        },
        {
          "s": 4,
          "text": "ועד שמתלבשים בהשכל והמדות דנפש השכלית ונפש הבהמית."
        },
        {
          "s": 5,
          "text": "ונמצא,"
        },
        {
          "s": 6,
          "text": "שבהשכל ומדות דנה\"א,"
        },
        {
          "s": 7,
          "text": "שתי מדריגות."
        },
        {
          "s": 8,
          "text": "כמו שהם מצד עצמם וכמו שנתלבשו בנפש השכלית והבהמית."
        },
        {
          "s": 9,
          "text": "וע\"פ המבואר במק\"א27"
        },
        {
          "s": 10,
          "text": "דהכח שיש בנה\"א לפעול בירור וזיכוך נה\"ב הוא לפי שנה\"א היא אלקות בעצם מהותה,"
        },
        {
          "s": 11,
          "text": "יש לומר,"
        },
        {
          "s": 12,
          "text": "שגם בהשכל ומדות דנה\"א כמו שנתלבשו בנה\"ב שני הענינים."
        },
        {
          "s": 13,
          "text": "דבגילוי"
        },
        {
          "s": 14,
          "text": "(כמו שהן לגבי נפש השכלית והבהמית)"
        },
        {
          "s": 15,
          "text": "הם במדידה והגבלה,"
        },
        {
          "s": 16,
          "text": "והביטול שלהם הוא דוגמת ביטול היש28"
        },
        {
          "s": 17,
          "text": "(שלכן הם פועלים בנפש השכלית והבהמית),"
        },
        {
          "s": 18,
          "text": "ובפנימיות הם אלקות29,"
        },
        {
          "s": 19,
          "text": "והביטול שלהם הוא ביטול במציאות."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "שד' ענינים הנ\"ל – שתי הדרגות דחצר שהם הבירור דנפש הבהמית והשכלית,"
        },
        {
          "s": 3,
          "text": "ושני הענינים בהכחות דנפש האלקית כמו שהם בגילוי וכמו שהם בעצם מהותם – הם דוגמת ד' העולמות אבי\"ע."
        },
        {
          "s": 4,
          "text": "והענין הוא,"
        },
        {
          "s": 5,
          "text": "דעשי' ויצירה הם מציאות,"
        },
        {
          "s": 6,
          "text": "ובריאה היא רק אפשרות המציאות,"
        },
        {
          "s": 7,
          "text": "ואצילות היא אפיסת המציאות30."
        },
        {
          "s": 8,
          "text": "ומהחילוקים שבין עשי' ויצירה"
        },
        {
          "s": 9,
          "text": "(מציאות)"
        },
        {
          "s": 10,
          "text": "לבריאה"
        },
        {
          "s": 11,
          "text": "(אפשרות המציאות)"
        },
        {
          "s": 12,
          "text": "הוא,"
        },
        {
          "s": 13,
          "text": "שהביטול שבעשי' ויצירה הוא ביטול היש31,"
        },
        {
          "s": 14,
          "text": "דכיון שעשי' ויצירה הם מציאות,"
        },
        {
          "s": 15,
          "text": "הביטול שבהם הוא דבר נוסף על מציאותם."
        },
        {
          "s": 16,
          "text": "והביטול שבבריאה,"
        },
        {
          "s": 17,
          "text": "שהיא רק אפשרות המציאות,"
        },
        {
          "s": 18,
          "text": "הוא ביטול במציאות31,"
        },
        {
          "s": 19,
          "text": "היינו שכל מציאותו הוא ביטול32."
        },
        {
          "s": 20,
          "text": "וזהו33"
        },
        {
          "s": 21,
          "text": "שיצירה הוא מדור המלאכים שעבודתם בדחילו ורחימו טבעיים,"
        },
        {
          "s": 22,
          "text": "ובריאה הוא מדור נשמות הצדיקים שעבודתם היתה בדו\"ר שכליים"
        },
        {
          "s": 23,
          "text": "(וגם המלאכים שעבודתם בדו\"ר שכליים מקומם הוא בבריאה)34,"
        },
        {
          "s": 24,
          "text": "כי דו\"ר טבעיים הם הטבע"
        },
        {
          "s": 25,
          "text": "(המציאות)"
        },
        {
          "s": 26,
          "text": "של הנברא,"
        },
        {
          "s": 27,
          "text": "ודו\"ר שכליים הוא שהאהוי\"ר הם לא מצד טבעו ומציאותו אלא לפי שהענין האלקי שהשיג מחייב שצריך לאהוב את ה' ולירא ממנו."
        },
        {
          "s": 28,
          "text": "אלא33"
        },
        {
          "s": 29,
          "text": "שאעפ\"כ,"
        },
        {
          "s": 30,
          "text": "כיון שבבריאה הו\"ע ההשגה,"
        },
        {
          "s": 31,
          "text": "והביטול שבבריאה הוא מפני שהשכל מחייב שלגבי אלקות אין מקום למציאות,"
        },
        {
          "s": 32,
          "text": "הרי גם הביטול הוא מציאות,"
        },
        {
          "s": 33,
          "text": "ואמיתית הענין דביטול במציאות הוא באצילות,"
        },
        {
          "s": 34,
          "text": "שהביטול באצילות הוא לא מצד השגת השכל אלא מצד האלקות,"
        },
        {
          "s": 35,
          "text": "שהוא לבדו הוא ואין זולתו."
        },
        {
          "s": 36,
          "text": "ולכן בעולם האצילות אין שייך המציאות דמלאכים35"
        },
        {
          "s": 37,
          "text": "(גם לא מלאכים שכליים),"
        },
        {
          "s": 38,
          "text": "ועולם האצילות הוא מדור לצדיקים הגדולים שהיו בבחינת מרכבה שלמעלה מהשכל36,"
        },
        {
          "s": 39,
          "text": "ביטול במציאות."
        },
        {
          "s": 40,
          "text": "והגם שגם באצילות יש עשר ספירות"
        },
        {
          "s": 41,
          "text": "(שכל ומדות),"
        },
        {
          "s": 42,
          "text": "הרי הספירות דאצילות אינם מציאות"
        },
        {
          "s": 43,
          "text": "(לעצמם)"
        },
        {
          "s": 44,
          "text": "כלל,"
        },
        {
          "s": 45,
          "text": "דאיהו וחיוהי חד איהו וגרמוהי חד37."
        }
      ]
    }
  ]
}