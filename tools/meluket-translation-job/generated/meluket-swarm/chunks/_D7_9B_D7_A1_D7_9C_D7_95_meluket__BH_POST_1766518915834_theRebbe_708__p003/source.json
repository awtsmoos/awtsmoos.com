{
  "globalIndex": 362,
  "owner": 12,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915834_theRebbe_708__p003",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915834_theRebbe_708__p003",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915834_theRebbe_708",
  "title": "מאמר שלום רב לאוהבי תורתך תשל\"ח",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "אך עדיין צריך להבין מה שפסוק זה"
        },
        {
          "s": 2,
          "text": "(שלום רב לאוהבי תורתך)"
        },
        {
          "s": 3,
          "text": "בא43"
        },
        {
          "s": 4,
          "text": "בהמשך ובהוספה למ\"ש44"
        },
        {
          "s": 5,
          "text": "וכל בניך לימודי הוי' ורב שלום בניך,"
        },
        {
          "s": 6,
          "text": "דלכאורה גם לימוד התורה דבניך לימודי הוי' וגו' בניך הוא לאחרי הקדמת עבודת התפלה,"
        },
        {
          "s": 7,
          "text": "שהרי כתוב בהם ורב שלום,"
        },
        {
          "s": 8,
          "text": "ומבואר בהמאמר דשלום רב"
        },
        {
          "s": 9,
          "text": "(רב שלום)"
        },
        {
          "s": 10,
          "text": "הוא דוקא לאוהבי תורתך"
        },
        {
          "s": 11,
          "text": "(שאוהבים את התורה מצד זה שהיא תורתך),"
        },
        {
          "s": 12,
          "text": "דאהבה זו היא ע\"י הקדמת עבודת התפלה"
        },
        {
          "s": 13,
          "text": "(כנ\"ל סעיף א וב'),"
        },
        {
          "s": 14,
          "text": "ומהי ההוספה בשלום רב לאוהבי תורתך על ורב שלום בניך."
        },
        {
          "s": 15,
          "text": "אך הענין הוא,"
        },
        {
          "s": 16,
          "text": "דהנה ארז\"ל43"
        },
        {
          "s": 17,
          "text": "(עה\"פ ורב שלום בניך)"
        },
        {
          "s": 18,
          "text": "א\"ת בניך אלא בוניך,"
        },
        {
          "s": 19,
          "text": "ופירוש בוניך הוא כמרז\"ל45"
        },
        {
          "s": 20,
          "text": "מאי בנאין אלו תלמידי חכמים שעוסקין בבנינו של עולם46."
        },
        {
          "s": 21,
          "text": "וזהו החילוק שבין ב' הפסוקים,"
        },
        {
          "s": 22,
          "text": "דבפסוק ורב שלום בניך שמדבר בענין פעולת התורה בעולם"
        },
        {
          "s": 23,
          "text": "(מה שתלמידי חכמים בונים את העולם ע\"י עסק התורה שלהם),"
        },
        {
          "s": 24,
          "text": "גם הכוונה בורב שלום בניך היא"
        },
        {
          "s": 25,
          "text": "(בעיקר)"
        },
        {
          "s": 26,
          "text": "לענין השלום שנעשה בעולם47"
        },
        {
          "s": 27,
          "text": "ע\"י עסק התורה,"
        },
        {
          "s": 28,
          "text": "שהתורה ניתנה48"
        },
        {
          "s": 29,
          "text": "לעשות שלום בעולם."
        },
        {
          "s": 30,
          "text": "ובפסוק שלום רב לאוהבי תורתך מוסיף שהשלום רב נמשך גם להתלמידי חכמים עצמם"
        },
        {
          "s": 31,
          "text": "(לאוהבי תורתך)."
        },
        {
          "s": 32,
          "text": "וזהו שדוקא בפסוק זה אומר לאוהבי תורתך"
        },
        {
          "s": 33,
          "text": "(שהאהבה לתורה היא מצד נותן התורה,"
        },
        {
          "s": 34,
          "text": "שזה נעשה ע\"י הקדמת עבודת התפלה),"
        },
        {
          "s": 35,
          "text": "כי בכדי להמשיך ריבוי שלום בעולם אינו מוכרח להקדמת עבודת התפלה,"
        },
        {
          "s": 36,
          "text": "משא\"כ בכדי שיומשך שלום רב להתלמידי חכמים עצמם המשכה זו היא דוקא ע\"י עבודת התפלה."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים המבואר בהמאמר"
        },
        {
          "s": 2,
          "text": "(ד\"ה שלום רב תש\"ד49)"
        },
        {
          "s": 3,
          "text": "בענין עבודת הצדיקים שמקיימים את העולם שנברא בעשרה מאמרות50"
        },
        {
          "s": 4,
          "text": "[שזהו ג\"כ ענין תלמידי חכמים שעוסקים בבנינו של עולם51],"
        },
        {
          "s": 5,
          "text": "שעשרה מאמרות שבהם נברא העולם מכוונים כנגד עשרת הדברות52,"
        },
        {
          "s": 6,
          "text": "וכמ\"ש53"
        },
        {
          "s": 7,
          "text": "עשרה עשרה הכף בשקל הקודש,"
        },
        {
          "s": 8,
          "text": "ומה שתלמידי חכמים בונים את העולם הוא שממשיכים את עשרת הדברות"
        },
        {
          "s": 9,
          "text": "[שבהם כלולה כל התורה כולה54,"
        },
        {
          "s": 10,
          "text": "כולל גם מה שתלמיד ותיק עתיד לחדש55]"
        },
        {
          "s": 11,
          "text": "בעשרה מאמרות שבהם נברא העולם."
        },
        {
          "s": 12,
          "text": "והגם שגם בתחילת הבריאה עולם על מילואו נברא56"
        },
        {
          "s": 13,
          "text": "(היינו שע\"י העשרה מאמרות יש גילוי אלקות בעולם),"
        },
        {
          "s": 14,
          "text": "הרי כוונת הבריאה היא שהאדם ע\"י עבודתו ימשיך תוספת אור בעולם57,"
        },
        {
          "s": 15,
          "text": "ועד לאור שלמעלה משרש הנבראים,"
        },
        {
          "s": 16,
          "text": "והמשכה זו היא ע\"י התורה"
        },
        {
          "s": 17,
          "text": "(עשרת הדברות)"
        },
        {
          "s": 18,
          "text": "דוקא."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "וזהו תלמידי חכמים מרבים שלום בעולם"
        },
        {
          "s": 1,
          "text": "(מרבים דוקא),"
        },
        {
          "s": 2,
          "text": "דהשלום בעולם שנעשה ע\"י התלמידי חכמים הוא לא רק שלילת ענינים בלתי רצויים"
        },
        {
          "s": 3,
          "text": "(היפך השלום)"
        },
        {
          "s": 4,
          "text": "שנעשה ע\"י החטאים,"
        },
        {
          "s": 5,
          "text": "היינו שיהי' העולם על מילואו כמו שהי' בתחילת הבריאה"
        },
        {
          "s": 6,
          "text": "[ועד שמצד גודל העילוי שלהם"
        },
        {
          "s": 7,
          "text": "(מה שהם בניך לימודי הוי')"
        },
        {
          "s": 8,
          "text": "אין צריכים לזה עבודה מיוחדת,"
        },
        {
          "s": 9,
          "text": "כי חטא והעלם דעולם שנעשה ע\"י החטא אינו אצלם"
        },
        {
          "s": 10,
          "text": "(לגבם),"
        },
        {
          "s": 11,
          "text": "ורואים את העולם כמו שהוא על מילואו כמו שהי' קודם החטא],"
        },
        {
          "s": 12,
          "text": "אלא יתירה מזו,"
        },
        {
          "s": 13,
          "text": "שמרבים שלום בעולם,"
        },
        {
          "s": 14,
          "text": "ורב שלום בניך,"
        },
        {
          "s": 15,
          "text": "(בדוגמת)"
        },
        {
          "s": 16,
          "text": "ריבוי השלום שיהי' לעתיד לבוא58,"
        },
        {
          "s": 17,
          "text": "לפי שע\"י עסק התורה שלהם ממשיכים מעצמות אוא\"ס שלמעלה משרש העולמות,"
        },
        {
          "s": 18,
          "text": "ועי\"ז משלימים הכוונה דנתאוה59"
        },
        {
          "s": 19,
          "text": "הקב\"ה להיות לו ית' דירה בתחתונים."
        }
      ]
    }
  ]
}