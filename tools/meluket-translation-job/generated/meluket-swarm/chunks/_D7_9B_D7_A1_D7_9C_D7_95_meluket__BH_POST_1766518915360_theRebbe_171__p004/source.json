{
  "globalIndex": 275,
  "owner": 25,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915360_theRebbe_171__p004",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915360_theRebbe_171__p004",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915360_theRebbe_171",
  "title": "מאמר פדה בשלום תשמ\"א",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ואולי יש לומר בעומק יותר,"
        },
        {
          "s": 2,
          "text": "שגם הדרגא דפדי' שבדרך מלחמה,"
        },
        {
          "s": 3,
          "text": "כיון שנקראת בשם פדי',"
        },
        {
          "s": 4,
          "text": "היא שייכת לפדי' בשלום"
        },
        {
          "s": 5,
          "text": "(עד לדרגא הכי נעלית שתהי' בימות המשיח בתקופה השני')."
        },
        {
          "s": 6,
          "text": "ובלשון חז\"ל45"
        },
        {
          "s": 7,
          "text": "מלחמה נמי אתחלתא דגאולה היא,"
        },
        {
          "s": 8,
          "text": "כיון46"
        },
        {
          "s": 9,
          "text": "דשם גאולה עלה."
        },
        {
          "s": 10,
          "text": "ועפ\"ז יש לבאר יותר הקשר של הגאולה דיו\"ד כסלו וי\"ט כסלו עם הפסוק פדה בשלום נפשי47,"
        },
        {
          "s": 11,
          "text": "דלכאורה,"
        },
        {
          "s": 12,
          "text": "הרי ידוע מהלך הענינים בגאולת אדמו\"ר הזקן,"
        },
        {
          "s": 13,
          "text": "ועד\"ז בגאולת אדמו\"ר האמצעי,"
        },
        {
          "s": 14,
          "text": "שהיו ענינים של אתכפיא,"
        },
        {
          "s": 15,
          "text": "השתדלות וכיו\"ב,"
        },
        {
          "s": 16,
          "text": "היינו ענינים של מלחמה,"
        },
        {
          "s": 17,
          "text": "ומקשרים זה עם הפסוק פדה בשלום נפשי שקאי"
        },
        {
          "s": 18,
          "text": "(כמו שמבאר אדמו\"ר האמצעי בדרוש הנ\"ל)"
        },
        {
          "s": 19,
          "text": "על פדי' בשלום כמו שהיא בתכלית השלימות."
        },
        {
          "s": 20,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 21,
          "text": "דכל הדרגות שבפדי' קשורות עם הפדי' בשלום בתכלית השלימות שתהי' לע\"ל."
        },
        {
          "s": 22,
          "text": "ויובן זה ע\"פ מה שמבאר בעל הגאולה בהמאמר48"
        },
        {
          "s": 23,
          "text": "דענין פדה בשלום נפשי בעבודת האדם"
        },
        {
          "s": 24,
          "text": "[שהפדי' דנפש האלקית מהגלות דנפש הבהמית היא באופן דשלום,"
        },
        {
          "s": 25,
          "text": "שנה\"ב אינה מנגדת כלל]"
        },
        {
          "s": 26,
          "text": "הוא כשהעבודה היא במס\"נ,"
        },
        {
          "s": 27,
          "text": "ובמס\"נ גופא – מס\"נ דיחידה."
        },
        {
          "s": 28,
          "text": "דע\"י המס\"נ שמצד חי',"
        },
        {
          "s": 29,
          "text": "נעשה רק אתכפיא נה\"ב,"
        },
        {
          "s": 30,
          "text": "וע\"י המס\"נ שמצד יחידה דוקא,"
        },
        {
          "s": 31,
          "text": "היא מתבטלת לגמרי."
        },
        {
          "s": 32,
          "text": "ועפ\"ז יובן הקשר דפדי' שבדרך מלחמה"
        },
        {
          "s": 33,
          "text": "[העבודה שמצד חי',"
        },
        {
          "s": 34,
          "text": "ולמטה יותר העבודה שמצד נר\"נ]"
        },
        {
          "s": 35,
          "text": "לפדה בשלום נפשי"
        },
        {
          "s": 36,
          "text": "(יחידה),"
        },
        {
          "s": 37,
          "text": "כי בכל עבודה ועבודה יש בה"
        },
        {
          "s": 38,
          "text": "(בהעלם)"
        },
        {
          "s": 39,
          "text": "המס\"נ שמצד יחידה."
        },
        {
          "s": 40,
          "text": "וכדאיתא בתניא49"
        },
        {
          "s": 41,
          "text": "דעסק התורה והמצוות והתפלה הוא ענין מס\"נ ממש."
        },
        {
          "s": 42,
          "text": "דכיון שאמיתית הענין דמס\"נ"
        },
        {
          "s": 43,
          "text": "(מס\"נ ממש)"
        },
        {
          "s": 44,
          "text": "הוא המס\"נ שמצד יחידה,"
        },
        {
          "s": 45,
          "text": "הרי נמצא,"
        },
        {
          "s": 46,
          "text": "שבכל ענין דתורה ומצוות"
        },
        {
          "s": 47,
          "text": "[אפילו הענינים הפשוטים דתומ\"צ שאלמלא ניתנה תורה"
        },
        {
          "s": 48,
          "text": "(ח\"ו)"
        },
        {
          "s": 49,
          "text": "היו למדים אותם מבהמת הארץ50]"
        },
        {
          "s": 50,
          "text": "יש כח המס\"נ דיחידה."
        },
        {
          "s": 51,
          "text": "ויתירה מזו,"
        },
        {
          "s": 52,
          "text": "שגם ההבנה והשגה דתורה היא ע\"י הענין דהקדמת נעשה לנשמע כמ\"ש51"
        },
        {
          "s": 53,
          "text": "תומת ישרים תנחם52,"
        },
        {
          "s": 54,
          "text": "דענין הקדמת נעשה לנשמע הוא הביטול לבעל הרצון"
        },
        {
          "s": 55,
          "text": "(שלמעלה מהביטול להרצון)53,"
        },
        {
          "s": 56,
          "text": "דביטול זה בא מעצם הנשמה"
        },
        {
          "s": 57,
          "text": "(שלמעלה מהגילויים דהנשמה),"
        },
        {
          "s": 58,
          "text": "בחינת יחידה."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "והגם דענין המס\"נ המבואר במאמר הנ\"ל דבעל הגאולה הוא שנתבטלו כל רצונותיו"
        },
        {
          "s": 1,
          "text": "(ועד שכל הענינים הם בהשתוות)54,"
        },
        {
          "s": 2,
          "text": "יש לומר,"
        },
        {
          "s": 3,
          "text": "שכל הדרגות דמס\"נ הם ענין אחד."
        },
        {
          "s": 4,
          "text": "וע\"ד הידוע55"
        },
        {
          "s": 5,
          "text": "בענין היראה,"
        },
        {
          "s": 6,
          "text": "דכיון שיראה היא ביטול"
        },
        {
          "s": 7,
          "text": "(שלילת המציאות),"
        },
        {
          "s": 8,
          "text": "לכן כל הדרגות שביראה הן יראה אחת,"
        },
        {
          "s": 9,
          "text": "עד\"ז י\"ל בענין הביטול דמס\"נ."
        },
        {
          "s": 10,
          "text": "ואדרבא,"
        },
        {
          "s": 11,
          "text": "כיון שהביטול דמס\"נ הוא מצד כללות ועצם הנפש,"
        },
        {
          "s": 12,
          "text": "ודלא כהביטול דיראה שהיא רק מדה אחת,"
        },
        {
          "s": 13,
          "text": "הרי ענין זה"
        },
        {
          "s": 14,
          "text": "[שכל הדרגות הם ענין אחד]"
        },
        {
          "s": 15,
          "text": "במס\"נ הוא עוד יותר מאשר ביראה."
        },
        {
          "s": 16,
          "text": "ויובן זה ע\"פ משל ממלכותא דארעא56,"
        },
        {
          "s": 17,
          "text": "שכשאדם נכנס לצבא"
        },
        {
          "s": 18,
          "text": "(אף שעדיין לא שירת בהצבא,"
        },
        {
          "s": 19,
          "text": "ועאכו\"כ שלא הי' במלחמה)"
        },
        {
          "s": 20,
          "text": "הוא מוסר את עצמו לגמרי און ווערט אויס בעה\"ב אויף זיך."
        },
        {
          "s": 21,
          "text": "דכמו\"כ הוא בצבא הרוחני,"
        },
        {
          "s": 22,
          "text": "שישראל הם צבאות הוי'57,"
        },
        {
          "s": 23,
          "text": "דזה שכל אחד מישראל יש לו קבלת עול"
        },
        {
          "s": 24,
          "text": "[כפתגם הידוע58"
        },
        {
          "s": 25,
          "text": "אַ איד איז אַ קבלת-עול'ניק],"
        },
        {
          "s": 26,
          "text": "שבזה הוא נכנס לצבאות השם,"
        },
        {
          "s": 27,
          "text": "הרי עי\"ז הוא מוסר את עצמו לגמרי לאלקות,"
        },
        {
          "s": 28,
          "text": "ומסירה זו היא קשורה ומאיר בה המס\"נ שמצד יחידה בדרגא הכי נעלית."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "וע\"פ הנ\"ל יש לבאר גם הא דאיתא בירושלמי59"
        },
        {
          "s": 2,
          "text": "עה\"פ פדה בשלום נפשי גו' כי ברבים היו עמדי,"
        },
        {
          "s": 3,
          "text": "דקאי על אנשי אבשלום שהתפללו לשלומו של דוד."
        },
        {
          "s": 4,
          "text": "דלכאורה,"
        },
        {
          "s": 5,
          "text": "הרי מבואר לעיל דפדי' בשלום הוא בתורה דוקא משא\"כ תפלה היא בדרך מלחמה,"
        },
        {
          "s": 6,
          "text": "ותפלתם של אנשי אבשלום היתה בנוגע למלחמת אבשלום."
        },
        {
          "s": 7,
          "text": "ועד\"ז צריך להבין בהקשר של הגאולה די\"ט כסלו עם הפסוק פדה בשלום,"
        },
        {
          "s": 8,
          "text": "הרי הגאולה דאדמו\"ר הזקן היתה"
        },
        {
          "s": 9,
          "text": "(כפי שכותב באגה\"ק שלו60)"
        },
        {
          "s": 10,
          "text": "כשקריתי בספר תהלים,"
        },
        {
          "s": 11,
          "text": "דענינה של אמירת תהלים"
        },
        {
          "s": 12,
          "text": "(אע\"פ שספר תהלים הוא מכ\"ד ספרים דתנ\"ך,"
        },
        {
          "s": 13,
          "text": "תורה)"
        },
        {
          "s": 14,
          "text": "הוא תפלה,"
        },
        {
          "s": 15,
          "text": "ובלשון הכתוב61"
        },
        {
          "s": 16,
          "text": "נעים זמירות ישראל"
        },
        {
          "s": 17,
          "text": "(דזמירות שייכים לתפלה62),"
        },
        {
          "s": 18,
          "text": "ובפרט ע\"פ הידוע מסיפורי רבותינו נשיאינו שגאולת אדמו\"ר הזקן באה ע\"י התפלות דתלמידיו וחסידיו וכל ההולכים בעקבותיו,"
        },
        {
          "s": 19,
          "text": "וגאולה זו שבאה ע\"י תפלה,"
        },
        {
          "s": 20,
          "text": "שעת צלותא שעת קרבא,"
        },
        {
          "s": 21,
          "text": "באה באמירת הפסוק פדה בשלום."
        },
        {
          "s": 22,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 23,
          "text": "דכיון שעסק התורה ומצוות הו\"ע מס\"נ ממש"
        },
        {
          "s": 24,
          "text": "(כמובא לעיל מתניא),"
        },
        {
          "s": 25,
          "text": "לכן,"
        },
        {
          "s": 26,
          "text": "גם תפלה63"
        },
        {
          "s": 27,
          "text": "קשורה עם פדה בשלום."
        },
        {
          "s": 28,
          "text": "ויש לומר,"
        },
        {
          "s": 29,
          "text": "שאדרבה,"
        },
        {
          "s": 30,
          "text": "ענין המס\"נ הוא בתפלה יותר מבתורה."
        },
        {
          "s": 31,
          "text": "כי זה שעסק התורה הוא מס\"נ ממש,"
        },
        {
          "s": 32,
          "text": "הרי הרגש זה דמס\"נ צריך להיות \"קודם שיתחיל ללמוד\""
        },
        {
          "s": 33,
          "text": "[וכשלומד הרבה שעות רצופות יש לו להתבונן בזה בכל שעה ושעה]64,"
        },
        {
          "s": 34,
          "text": "אבל בעת הלימוד,"
        },
        {
          "s": 35,
          "text": "כשהוא עוסק בהבנת והשגת הענין שלומד,"
        },
        {
          "s": 36,
          "text": "אינו מרגיש הביטול דמס\"נ."
        },
        {
          "s": 37,
          "text": "ואדרבא מאן מלכא רבנן65"
        },
        {
          "s": 38,
          "text": "ואורייתא הוא דקא מרתחא לי'66,"
        },
        {
          "s": 39,
          "text": "משא\"כ בתפלה,"
        },
        {
          "s": 40,
          "text": "צריך להיות כעבדא קמי מרי'67,"
        },
        {
          "s": 41,
          "text": "תכלית הביטול68"
        },
        {
          "s": 42,
          "text": "(ביטול דמס\"נ)."
        }
      ]
    }
  ]
}