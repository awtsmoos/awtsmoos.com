{
  "globalIndex": 750,
  "owner": 0,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918160_theRebbe_102__p005",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918160_theRebbe_102__p005",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518918160_theRebbe_102",
  "title": "מאמר ויאמר לו יהונתן תשכ\"ח",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "והענין הוא,"
        },
        {
          "s": 2,
          "text": "דבהיתרון שבעבודת הנשמה בהיותה מלובשת בגוף לגבי עבודת הנשמה למעלה קודם שירדה למטה,"
        },
        {
          "s": 3,
          "text": "שני ביאורים בכללות."
        },
        {
          "s": 4,
          "text": "שע\"י54"
        },
        {
          "s": 5,
          "text": "שהנשמה עובדת את ה' גם בהיותה מלובשת בגוף גשמי מתגלה תוקף ההתקשרות שלה עם הקב\"ה,"
        },
        {
          "s": 6,
          "text": "שגם ההעלם וההסתר דהגוף ונה\"ב אינו יכול לבטל ח\"ו ואפילו לא לעשות גרעון בההתקשרות שלה."
        },
        {
          "s": 7,
          "text": "ועאכו\"כ,"
        },
        {
          "s": 8,
          "text": "כשעבודת הנשמה למטה היא באהבה רבה שלמעלה מטעם ודעת,"
        },
        {
          "s": 9,
          "text": "כמו אהבת הבן לאביו,"
        },
        {
          "s": 10,
          "text": "שעי\"ז מתגלה תוקף ההתקשרות שלה עם הקב\"ה כמו שהוא מצד עצם הנשמה כמו שהיא מושרשת בעצמות אוא\"ס,"
        },
        {
          "s": 11,
          "text": "בדוגמת הבן כמו שהוא במוח האב עצמו."
        },
        {
          "s": 12,
          "text": "כי לגבי דרגת הנשמה כמו שהיא באצילות,"
        },
        {
          "s": 13,
          "text": "שהיא דוגמת הבן"
        },
        {
          "s": 14,
          "text": "(כמו)"
        },
        {
          "s": 15,
          "text": "שנמשך ממוח האב,"
        },
        {
          "s": 16,
          "text": "הירידה לבי\"ע"
        },
        {
          "s": 17,
          "text": "(ומכ\"ש הירידה למטה בעוה\"ז הגשמי)"
        },
        {
          "s": 18,
          "text": "מעלמת ומסתרת על זה"
        },
        {
          "s": 19,
          "text": "[וכידוע55"
        },
        {
          "s": 20,
          "text": "שרק נשמות דאצילות נק' בשם בנים],"
        },
        {
          "s": 21,
          "text": "וזה שגם בירידתה למטה היא בבחינת בן בגילוי,"
        },
        {
          "s": 22,
          "text": "שהאהבה שלה היא אהבה עצמית שלמעלה מטעם ודעת כאהבת בן לאביו,"
        },
        {
          "s": 23,
          "text": "הוא ע\"י גילוי עצם הנשמה כמו שהיא במוח האב"
        },
        {
          "s": 24,
          "text": "(טרם שנמשך),"
        },
        {
          "s": 25,
          "text": "שלגבי דרגא זו"
        },
        {
          "s": 26,
          "text": "(עצם הנשמה כמו שמושרשת בהעצמות),"
        },
        {
          "s": 27,
          "text": "אצילות ובי\"ע הם בשוה."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ולהוסיף,"
        },
        {
          "s": 1,
          "text": "דעיקר גילוי דרגא זו"
        },
        {
          "s": 2,
          "text": "(עצם הנשמה כמו שמושרשת בהעצמות)"
        },
        {
          "s": 3,
          "text": "הוא ע\"י העבודה דבירור וזיכוך הגוף ונה\"ב וחלקו בעולם."
        },
        {
          "s": 4,
          "text": "כי זה שהגוף ונה\"ב אינם יכולים להסתיר על האהבה דהנשמה שלמעלה מטו\"ד הוא לפי שעצמות אוא\"ס"
        },
        {
          "s": 5,
          "text": "(שבו מושרשת הנשמה)"
        },
        {
          "s": 6,
          "text": "הוא בכל מקום"
        },
        {
          "s": 7,
          "text": "(ולכן אין שייך שיהי' דבר שיוכל להעלים עליו),"
        },
        {
          "s": 8,
          "text": "והכח דהנשמה לברר ולזכך את הגוף והנה\"ב עצמם ולעשות אותם כלים לאלקות הוא מפני שעצמות אוא\"ס"
        },
        {
          "s": 9,
          "text": "(שבו מושרשת הנשמה)"
        },
        {
          "s": 10,
          "text": "אינו מוגדר בשום גדר56,"
        },
        {
          "s": 11,
          "text": "שלכן,"
        },
        {
          "s": 12,
          "text": "גם הגוף ונה\"ב שמצד ענינם"
        },
        {
          "s": 13,
          "text": "(מצד הגדר שלהם)"
        },
        {
          "s": 14,
          "text": "אינם כלים לאלקות,"
        },
        {
          "s": 15,
          "text": "הרי ע\"י גילוי כח העצמות,"
        },
        {
          "s": 16,
          "text": "נעשים הם כלים לאלקות."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ועוד ביאור בהיתרון שבעבודת הנשמה בהיותה מלובשת בגוף,"
        },
        {
          "s": 2,
          "text": "דשורש הגוף הוא למעלה משורש הנשמה."
        },
        {
          "s": 3,
          "text": "דבנשמות כתיב57"
        },
        {
          "s": 4,
          "text": "בנים אתם להוי' אלקיכם,"
        },
        {
          "s": 5,
          "text": "ולכן,"
        },
        {
          "s": 6,
          "text": "האהבה וההתקשרות דהקב\"ה לישראל מצד נשמתם היא ע\"ד אהבת אב לבנו,"
        },
        {
          "s": 7,
          "text": "היינו,"
        },
        {
          "s": 8,
          "text": "ששורש אהבה זו היא ממדריגה ששייכת שם תפיסת מקום דהנאהב,"
        },
        {
          "s": 9,
          "text": "ואינה מעצמותו ממש."
        },
        {
          "s": 10,
          "text": "משא\"כ האהבה וההתקשרות דהקב\"ה לישראל מצד הגוף שלהם,"
        },
        {
          "s": 11,
          "text": "היא"
        },
        {
          "s": 12,
          "text": "(לא מצד מעלת הגוף,"
        },
        {
          "s": 13,
          "text": "גם לא המעלה ד\"בן\","
        },
        {
          "s": 14,
          "text": "מעלה עצמית,"
        },
        {
          "s": 15,
          "text": "אלא)"
        },
        {
          "s": 16,
          "text": "מצד זה שהקב\"ה בחר בהגוף דישראל58,"
        },
        {
          "s": 17,
          "text": "בבחירתו החפשית,"
        },
        {
          "s": 18,
          "text": "שבחירה זו היא מעצמותו ממש."
        },
        {
          "s": 19,
          "text": "וע\"י עבודת הנשמה בהגוף,"
        },
        {
          "s": 20,
          "text": "נמשך גם בהנשמה הענין דבחירת העצמות."
        },
        {
          "s": 21,
          "text": "והיינו,"
        },
        {
          "s": 22,
          "text": "דלביאור הראשון,"
        },
        {
          "s": 23,
          "text": "העלי' שנעשית בהנשמה ע\"י עבודתה בהגוף הוא גילוי השורש שלה בעצמות אוא\"ס,"
        },
        {
          "s": 24,
          "text": "בדוגמת הבן כמו שהוא במוח האב עצמו"
        },
        {
          "s": 25,
          "text": "(טרם שנמשך),"
        },
        {
          "s": 26,
          "text": "ולביאור השני,"
        },
        {
          "s": 27,
          "text": "ע\"י עבודת הנשמה בהגוף נעשה בה ענין חדש – המשכת העצמות"
        },
        {
          "s": 28,
          "text": "(שלמעלה גם משורש הנשמה כמו שהיא במוח האב עצמו)."
        }
      ]
    }
  ]
}