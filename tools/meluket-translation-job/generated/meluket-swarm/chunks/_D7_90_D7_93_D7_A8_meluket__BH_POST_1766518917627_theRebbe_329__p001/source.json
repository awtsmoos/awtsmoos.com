{
  "globalIndex": 653,
  "owner": 3,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917627_theRebbe_329__p001",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917627_theRebbe_329__p001",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917627_theRebbe_329",
  "title": "מאמר החודש הזה לכם תשל\"ה",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ ויקהל-פקודי,"
        },
        {
          "s": 2,
          "text": "פ' החודש,"
        },
        {
          "s": 3,
          "text": "כ\"ה אדר ה'תשל\"ה*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "החודש הזה לכם ראש חדשים גו'1,"
        },
        {
          "s": 1,
          "text": "ואיתא במדרש2"
        },
        {
          "s": 2,
          "text": "(הובא בפירוש רש\"י ר\"פ בראשית)"
        },
        {
          "s": 3,
          "text": "אמר ר' יצחק לא הי' צריך להתחיל את התורה אלא מהחודש הזה לכם כו' ומה טעם פתח בבראשית משום כח מעשיו הגיד לעמו לתת להם נחלת גוים3."
        },
        {
          "s": 4,
          "text": "וע\"פ הידוע4"
        },
        {
          "s": 5,
          "text": "שגם שאלה בתורה היא תורה,"
        },
        {
          "s": 6,
          "text": "תורת אמת,"
        },
        {
          "s": 7,
          "text": "יש לומר,"
        },
        {
          "s": 8,
          "text": "דזה שאיתא במדרש"
        },
        {
          "s": 9,
          "text": "(תורת אמת)"
        },
        {
          "s": 10,
          "text": "שההתחלה בתורה הי' צ\"ל בהחודש הזה לכם"
        },
        {
          "s": 11,
          "text": "[ובפרט שלשון המדרש הוא לא הי' צריך להתחיל את התורה אלא מהחודש הזה לכם,"
        },
        {
          "s": 12,
          "text": "דלשון לא כו' אלא מורה שהוא לעיכובא5]"
        },
        {
          "s": 13,
          "text": "הוא גם אליבא דאמת,"
        },
        {
          "s": 14,
          "text": "שהתורה מתחלת בהחודש הזה לכם6."
        },
        {
          "s": 15,
          "text": "וכמ\"ש אדמו\"ר"
        },
        {
          "s": 16,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 17,
          "text": "נ\"ע במאמרו ד\"ה זה7"
        },
        {
          "s": 18,
          "text": "שפרשת החודש היא עיקר התחלת התורה."
        },
        {
          "s": 19,
          "text": "אלא שענין זה"
        },
        {
          "s": 20,
          "text": "(שהתורה מתחלת בהחודש הזה לכם)"
        },
        {
          "s": 21,
          "text": "הוא בפנימיות,"
        },
        {
          "s": 22,
          "text": "ובגילוי,"
        },
        {
          "s": 23,
          "text": "התחלת התורה היא בבראשית ברא."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ויש לקשר זה ע\"פ הידוע8"
        },
        {
          "s": 1,
          "text": "בתיווך ב' הדיעות בזמן הבריאה9,"
        },
        {
          "s": 2,
          "text": "דעת ר' אליעזר שבתשרי"
        },
        {
          "s": 3,
          "text": "(כ\"ה אלול10)"
        },
        {
          "s": 4,
          "text": "נברא העולם ודעת ר' יהושע שבניסן"
        },
        {
          "s": 5,
          "text": "(כ\"ה אדר11)"
        },
        {
          "s": 6,
          "text": "נברא העולם,"
        },
        {
          "s": 7,
          "text": "שהבריאה בפועל היתה בתשרי,"
        },
        {
          "s": 8,
          "text": "והמחשבה לברוא את העולם היתה בניסן12."
        },
        {
          "s": 9,
          "text": "ועל פי הידוע שהמחשבה היא הפנימיות"
        },
        {
          "s": 10,
          "text": "(הכוונה והתכלית)"
        },
        {
          "s": 11,
          "text": "של העשי' שלאחרי המחשבה,"
        },
        {
          "s": 12,
          "text": "נמצא שהבריאה בפועל שהיתה בתשרי היא החיצוניות דהבריאה,"
        },
        {
          "s": 13,
          "text": "ופנימיות הבריאה היתה בניסן13."
        },
        {
          "s": 14,
          "text": "ועד\"ז הוא בנוגע להתחלת התורה,"
        },
        {
          "s": 15,
          "text": "דזה שהתורה מתחלת בבראשית ברא גו'"
        },
        {
          "s": 16,
          "text": "(הבריאה בפועל שהיתה בתשרי),"
        },
        {
          "s": 17,
          "text": "הוא בחיצוניות,"
        },
        {
          "s": 18,
          "text": "אבל בפנימיות,"
        },
        {
          "s": 19,
          "text": "התחלת התורה היא החודש הזה לכם"
        },
        {
          "s": 20,
          "text": "(שקאי על ר\"ח ניסן)."
        }
      ]
    }
  ]
}