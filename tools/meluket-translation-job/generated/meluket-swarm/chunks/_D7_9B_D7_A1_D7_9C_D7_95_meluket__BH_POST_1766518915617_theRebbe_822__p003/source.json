{
  "globalIndex": 324,
  "owner": 24,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915617_theRebbe_822__p003",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915617_theRebbe_822__p003",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915617_theRebbe_822",
  "title": "מאמר ברוך שעשה ניסים תשט\"ו",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "והנה זה שבבינה נמשך רק השכל דחכמה"
        },
        {
          "s": 1,
          "text": "[שלכן הבינה היא דעת תחתון],"
        },
        {
          "s": 2,
          "text": "הוא בחיצוניות בינה."
        },
        {
          "s": 3,
          "text": "אבל בפנימיות בינה מאיר"
        },
        {
          "s": 4,
          "text": "(גם)"
        },
        {
          "s": 5,
          "text": "עצם החכמה,"
        },
        {
          "s": 6,
          "text": "ועי\"ז,"
        },
        {
          "s": 7,
          "text": "גם הבינה היא בבחינת דעת עליון,"
        },
        {
          "s": 8,
          "text": "כי ההרגש דכלא חשיב שבחכמה מאיר גם בבינה18."
        },
        {
          "s": 9,
          "text": "ועפ\"ז יש לבאר הטעם שמזיווג פנימי דחו\"ב נמשכים הנסים,"
        },
        {
          "s": 10,
          "text": "כי הנהגה נסית היא בבחינת דעת עליון,"
        },
        {
          "s": 11,
          "text": "וכיון שבזיווג פנימי דחו\"ב"
        },
        {
          "s": 12,
          "text": "(ההמשכה דחכמה בפנימיות בינה)"
        },
        {
          "s": 13,
          "text": "נרגש גם בבינה הדיעה העליונה שלמטה אין דכולא קמי' כלא חשיב,"
        },
        {
          "s": 14,
          "text": "לכן,"
        },
        {
          "s": 15,
          "text": "ההנהגה הנמשכת מזיווג פנימי דחו\"ב היא הנהגה נסית."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וצריך להבין,"
        },
        {
          "s": 2,
          "text": "דלפי הנ\"ל עיקר המעלה שבזיווג פנימי דחו\"ב"
        },
        {
          "s": 3,
          "text": "(השרש דהנהגה נסית)"
        },
        {
          "s": 4,
          "text": "על זיווג חיצוני דחו\"ב"
        },
        {
          "s": 5,
          "text": "(השרש דהנהגה טבעית)"
        },
        {
          "s": 6,
          "text": "הוא בבינה,"
        },
        {
          "s": 7,
          "text": "שבזיווג פנימי דחו\"ב,"
        },
        {
          "s": 8,
          "text": "ההרגש דכלא חשיב"
        },
        {
          "s": 9,
          "text": "(שבחכמה)"
        },
        {
          "s": 10,
          "text": "מאיר גם בבינה."
        },
        {
          "s": 11,
          "text": "ומזה שאומרים בנוגע לנסים"
        },
        {
          "s": 12,
          "text": "(כפשוטם)"
        },
        {
          "s": 13,
          "text": "ברוך שעשה נסים לאבותינו,"
        },
        {
          "s": 14,
          "text": "דאבותינו הם חכמה ובינה,"
        },
        {
          "s": 15,
          "text": "מובן,"
        },
        {
          "s": 16,
          "text": "שבכדי שיהיו נסים כפשוטם צריך להיות הרמה ועלי' גם בחכמה."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 1,
          "text": "דהמעלה שבזיווג פנימי דחו\"ב על זיווג חיצוני דחו\"ב היא בשני ענינים."
        },
        {
          "s": 2,
          "text": "בענין הגילוי,"
        },
        {
          "s": 3,
          "text": "דבחיצוניות בינה החכמה היא בהעלם,"
        },
        {
          "s": 4,
          "text": "אין שאינו מושג,"
        },
        {
          "s": 5,
          "text": "ובפנימיות בינה,"
        },
        {
          "s": 6,
          "text": "היא בגילוי"
        },
        {
          "s": 7,
          "text": "(כנ\"ל סעיף ג)."
        },
        {
          "s": 8,
          "text": "ועוד מעלה בזיווג פנימי דחו\"ב,"
        },
        {
          "s": 9,
          "text": "שההמשכה דחכמה"
        },
        {
          "s": 10,
          "text": "(שבזיווג זה)"
        },
        {
          "s": 11,
          "text": "היא מבחינה נעלית יותר,"
        },
        {
          "s": 12,
          "text": "פנימיות החכמה,"
        },
        {
          "s": 13,
          "text": "שלמעלה מזה שהחכמה נקראת אין."
        }
      ]
    }
  ]
}