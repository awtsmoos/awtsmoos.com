{
  "globalIndex": 815,
  "owner": 15,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918633_theRebbe_459__p005",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918633_theRebbe_459__p005",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918633_theRebbe_459",
  "title": "מאמר בחודש השלישי תשכ\"ט",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "והנה זה שבחג השבועות הוא המשכת הכתר,"
        },
        {
          "s": 1,
          "text": "הוא אמיתית הכתר שלמעלה מגלגלתא47."
        },
        {
          "s": 2,
          "text": "ועד\"ז הוא בנוגע לשני הכתרים שכנגד נעשה ונשמע שנמשכו בערב חג השבועות48,"
        },
        {
          "s": 3,
          "text": "שהם מקיפים שלמעלה משייכות לפנימי49."
        },
        {
          "s": 4,
          "text": "ועפ\"ז יש לבאר שקשירת הכתר שכנגד נשמע היתה דוקא ע\"י שהקדימו נעשה לנשמע,"
        },
        {
          "s": 5,
          "text": "כי הביטול דקבלת עול מצוות הוא ביטול להרצון,"
        },
        {
          "s": 6,
          "text": "וכיון שהמצוות הם ציוויים להאדם,"
        },
        {
          "s": 7,
          "text": "הרי הרצון דמצוות הוא ע\"ד הרצון"
        },
        {
          "s": 8,
          "text": "(דהאדם)"
        },
        {
          "s": 9,
          "text": "שרוצה לעשות ע\"י הכחות שלו,"
        },
        {
          "s": 10,
          "text": "מקיף דגלגלתא."
        },
        {
          "s": 11,
          "text": "והמשכת המקיף דכתר"
        },
        {
          "s": 12,
          "text": "(מקיף שלמעלה משייכות לפנימי)"
        },
        {
          "s": 13,
          "text": "הוא ע\"י הביטול דקבלת עול מלכות שמים,"
        },
        {
          "s": 14,
          "text": "ביטול לבעל הרצון."
        },
        {
          "s": 15,
          "text": "וע\"י שהקדימו נעשה לנשמע,"
        },
        {
          "s": 16,
          "text": "קשרו להם שני כתרים אחד כנגד נעשה ואחד כנגד נשמע,"
        },
        {
          "s": 17,
          "text": "כי ע\"י הקדמת נעשה לנשמע,"
        },
        {
          "s": 18,
          "text": "גם הביטול דקבלת עול מצוות הוא באופן שנרגש בו בגילוי50"
        },
        {
          "s": 19,
          "text": "שהוא בא מהביטול דקבלת עול מלכות שמים,"
        },
        {
          "s": 20,
          "text": "ביטול לבעל הרצון."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "וביאור העילוי שנעשה בהביטול דנשמע ע\"י הקדמת הביטול דנעשה,"
        },
        {
          "s": 1,
          "text": "יובן בהקדים,"
        },
        {
          "s": 2,
          "text": "דכמו שלמעלה,"
        },
        {
          "s": 3,
          "text": "הביטול דקבלת עול מצוות הוא להרצון"
        },
        {
          "s": 4,
          "text": "(גילוי)"
        },
        {
          "s": 5,
          "text": "והביטול דקבלת עומ\"ש הוא לבעל הרצון,"
        },
        {
          "s": 6,
          "text": "עד\"ז הוא בנוגע להאדם,"
        },
        {
          "s": 7,
          "text": "שהביטול דקבלת עול מצוות הוא בהגילויים דהאדם,"
        },
        {
          "s": 8,
          "text": "שיעשה כל מה שיצטווה ויתירה מזו שזה"
        },
        {
          "s": 9,
          "text": "(לעשות מה שנצטווה)"
        },
        {
          "s": 10,
          "text": "יהי' הרצון שלו,"
        },
        {
          "s": 11,
          "text": "והביטול דקבלת עומ\"ש הוא בהאדם עצמו,"
        },
        {
          "s": 12,
          "text": "שכל מציאותו הוא זה שהוא עבדו של המלך,"
        },
        {
          "s": 13,
          "text": "מלך מלכי המלכים הקב\"ה."
        },
        {
          "s": 14,
          "text": "ומזה מובן,"
        },
        {
          "s": 15,
          "text": "שהמעלה דקבלת עומ\"ש לגבי קבלת עול מצוות היא גם בענין הביטול."
        },
        {
          "s": 16,
          "text": "דבקבלת עול מצוות,"
        },
        {
          "s": 17,
          "text": "נשאר אצלו ובו מציאות שאינה בטילה51,"
        },
        {
          "s": 18,
          "text": "ואמיתית הביטול הוא בקבלת עומ\"ש,"
        },
        {
          "s": 19,
          "text": "שכל מציאותו הוא זה שהוא עבד המלך."
        },
        {
          "s": 20,
          "text": "[וזה שצ\"ל"
        },
        {
          "s": 21,
          "text": "(גם)"
        },
        {
          "s": 22,
          "text": "קבלת עול מצוות הוא בכדי שהביטול יהי'"
        },
        {
          "s": 23,
          "text": "(גם)"
        },
        {
          "s": 24,
          "text": "בנוגע לקיום התומ\"צ בפועל52]."
        },
        {
          "s": 25,
          "text": "וכאשר הביטול דנשמע"
        },
        {
          "s": 26,
          "text": "(קבלת עול מצוות)"
        },
        {
          "s": 27,
          "text": "הוא לאחרי וע\"י הקדמת הביטול דנעשה"
        },
        {
          "s": 28,
          "text": "(קבלת עומ\"ש),"
        },
        {
          "s": 29,
          "text": "שנרגש בגילוי דזה שמקבל עליו לעשות כל מה שיצטווה הוא מפני שהוא עצמו עבדו של המלך,"
        },
        {
          "s": 30,
          "text": "אזי,"
        },
        {
          "s": 31,
          "text": "גם הביטול דנשמע הוא בכל מציאותו"
        },
        {
          "s": 32,
          "text": "(בנוגע לכחות הגלויים שלו),"
        },
        {
          "s": 33,
          "text": "ואין שייך כלל שלא יקיים הציווי."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ויש להוסיף,"
        },
        {
          "s": 2,
          "text": "דכמו שברצוא ושוב,"
        },
        {
          "s": 3,
          "text": "תכלית הכוונה דהרצוא הוא בשביל השוב שלאחרי הרצוא53,"
        },
        {
          "s": 4,
          "text": "עד\"ז הוא בנעשה"
        },
        {
          "s": 5,
          "text": "(קבלת עומ\"ש)"
        },
        {
          "s": 6,
          "text": "ונשמע"
        },
        {
          "s": 7,
          "text": "(קבלת עול מצוות)"
        },
        {
          "s": 8,
          "text": "שהם כמו רצוא ושוב,"
        },
        {
          "s": 9,
          "text": "שתכלית הכוונה דנעשה הוא שיביא לנשמע."
        },
        {
          "s": 10,
          "text": "וע\"י הקדמת נעשה לנשמע,"
        },
        {
          "s": 11,
          "text": "שנעשה הוא הקדמה לנשמע,"
        },
        {
          "s": 12,
          "text": "מיתוסף עילוי בנעשה."
        },
        {
          "s": 13,
          "text": "כי הביטול דנעשה"
        },
        {
          "s": 14,
          "text": "(מצד עצמו),"
        },
        {
          "s": 15,
          "text": "עם היותו ביטול דמס\"נ שהוא ביטול הכי נעלה,"
        },
        {
          "s": 16,
          "text": "הוא הביטול של האדם54,"
        },
        {
          "s": 17,
          "text": "וע\"י שהנעשה הוא הקדמה לנשמע לקבל עליו עול מצוות"
        },
        {
          "s": 18,
          "text": "(שוב והמשכה למטה),"
        },
        {
          "s": 19,
          "text": "עי\"ז נשלמת הכוונה דנתאוה הקב\"ה להיות לו ית' דירה בתחתונים55,"
        },
        {
          "s": 20,
          "text": "כוונת העצמות56."
        },
        {
          "s": 21,
          "text": "ויש להוסיף,"
        },
        {
          "s": 22,
          "text": "שהמעלה דנשמע שע\"י הקדימה דנעשה על הענין דנעשה עצמו הוא גם בהביטול."
        },
        {
          "s": 23,
          "text": "כי הביטול דנעשה"
        },
        {
          "s": 24,
          "text": "(מצד עצמו)"
        },
        {
          "s": 25,
          "text": "הוא שאינו מציאות לעצמו"
        },
        {
          "s": 26,
          "text": "(והוא רק עבדו של המלך),"
        },
        {
          "s": 27,
          "text": "וע\"י הקדמת נעשה לנשמע,"
        },
        {
          "s": 28,
          "text": "שהביטול דנשמע הוא דוגמת הביטול דנעשה,"
        },
        {
          "s": 29,
          "text": "הביטול הוא גם בהמציאות דהאדם."
        }
      ]
    }
  ]
}