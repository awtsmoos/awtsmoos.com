{
  "globalIndex": 1017,
  "owner": 17,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919814_theRebbe_260__p002",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919814_theRebbe_260__p002",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919814_theRebbe_260",
  "title": "מאמר לא היו ימים טובים לישראל תשל\"ה",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "אך עדיין צריך להבין,"
        },
        {
          "s": 2,
          "text": "הרי היו\"ט דפסח וסוכות"
        },
        {
          "s": 3,
          "text": "(ודחג השבועות)"
        },
        {
          "s": 4,
          "text": "הוא מן התורה,"
        },
        {
          "s": 5,
          "text": "ואיך אפשר שהיו\"ט דחמשה עשר באב יהי' גדול יותר מהיו\"ט דשלש רגלים."
        },
        {
          "s": 6,
          "text": "גם צריך להבין,"
        },
        {
          "s": 7,
          "text": "דמזה שאומר לא היו ימים טובים לישראל כחמשה עשר באב וכיום הכפורים,"
        },
        {
          "s": 8,
          "text": "שמקדים חמשה עשר באב ליום הכפורים"
        },
        {
          "s": 9,
          "text": "[אף שהיו\"ט דחמשה עשר באב נתחדש"
        },
        {
          "s": 10,
          "text": "(לפי כל הטעמים שבגמרא)"
        },
        {
          "s": 11,
          "text": "כמה שנים לאחרי היו\"ט דיוהכ\"פ],"
        },
        {
          "s": 12,
          "text": "משמע,"
        },
        {
          "s": 13,
          "text": "דהיו\"ט דחמשה עשר באב הוא נעלה יותר גם מהיו\"ט דיוהכ\"פ,"
        },
        {
          "s": 14,
          "text": "וצריך ביאור,"
        },
        {
          "s": 15,
          "text": "הרי גם ביוהכ\"פ עלי' ממצב בלתי רצוי,"
        },
        {
          "s": 16,
          "text": "ומהי המעלה דחמשה עשר באב לגבי יוהכ\"פ."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ויובן זה ע\"פ המבואר בהמאמר פירוש הכתוב18"
        },
        {
          "s": 2,
          "text": "יתרון ארץ בכל היא מלך לשדה נעבד19,"
        },
        {
          "s": 3,
          "text": "דארץ הוא כללות העולם,"
        },
        {
          "s": 4,
          "text": "ושדה"
        },
        {
          "s": 5,
          "text": "(המובחר שבארץ)"
        },
        {
          "s": 6,
          "text": "הוא ג\"ע."
        },
        {
          "s": 7,
          "text": "וחילוק זה שבין כללות העולם לג\"ע"
        },
        {
          "s": 8,
          "text": "(שכללות העולם נק' ארץ וג\"ע שדה)"
        },
        {
          "s": 9,
          "text": "הוא בשרשם."
        },
        {
          "s": 10,
          "text": "דהתהוות העולם היא מבחינת הדיבור דמלכות"
        },
        {
          "s": 11,
          "text": "(חיצוניות המלכות20)"
        },
        {
          "s": 12,
          "text": "שנק' ארץ,"
        },
        {
          "s": 13,
          "text": "והג\"ע הוא מבחי' ג' ראשונות דמלכות"
        },
        {
          "s": 14,
          "text": "(פנימיות המלכות20)"
        },
        {
          "s": 15,
          "text": "שנק' שדה,"
        },
        {
          "s": 16,
          "text": "כמבואר בהמאמר."
        },
        {
          "s": 17,
          "text": "שהדיבור דמלכות"
        },
        {
          "s": 18,
          "text": "(העשרה מאמרות שבהם נברא העולם21)"
        },
        {
          "s": 19,
          "text": "ענינו הוא להוות את הנבראים,"
        },
        {
          "s": 20,
          "text": "בדוגמת הדיבור שבאדם שהוא בשביל הזולת,"
        },
        {
          "s": 21,
          "text": "והג\"ר דמלכות הוא פנימיות המלכות שמקבלת מיסוד,"
        },
        {
          "s": 22,
          "text": "שהוא22"
        },
        {
          "s": 23,
          "text": "סיום האצילות"
        },
        {
          "s": 24,
          "text": "(סיומא דגופא23),"
        },
        {
          "s": 25,
          "text": "בדוגמת המדות שבאדם,"
        },
        {
          "s": 26,
          "text": "דהגם שהם שייכים להזולת,"
        },
        {
          "s": 27,
          "text": "הרי ענינם הוא24"
        },
        {
          "s": 28,
          "text": "שהאדם מתעורר ומתפעל."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ומוסיף בהמאמר שיש עוד יתרון בג\"ע על כללות העולם,"
        },
        {
          "s": 1,
          "text": "דההמשכה בעולם היא מהמדות,"
        },
        {
          "s": 2,
          "text": "כי הדיבור דמלכות מקבל מהמדות25,"
        },
        {
          "s": 3,
          "text": "וההמשכה בג\"ע היא מהמוחין,"
        },
        {
          "s": 4,
          "text": "וכמבואר שם,"
        },
        {
          "s": 5,
          "text": "דזה שהיסוד נקרא בשם כל26"
        },
        {
          "s": 6,
          "text": "הוא על שם נו\"ן שערי בינה שנמשכים בו"
        },
        {
          "s": 7,
          "text": "(כל בגימטריא נו\"ן27),"
        },
        {
          "s": 8,
          "text": "ולכן,"
        },
        {
          "s": 9,
          "text": "כיון שהג\"ע הוא מפנימיות המלכות שמקבלת מהיסוד,"
        },
        {
          "s": 10,
          "text": "הרי ע\"י היסוד נמשכים בג\"ע גם המוחין."
        },
        {
          "s": 11,
          "text": "וזהו יתרון ארץ בכל היא מלך לשדה נעבד,"
        },
        {
          "s": 12,
          "text": "שהיתרון דארץ"
        },
        {
          "s": 13,
          "text": "(כללות העולם,"
        },
        {
          "s": 14,
          "text": "שהתהוותה היא מהדיבור דמלכות)"
        },
        {
          "s": 15,
          "text": "היא בכל,"
        },
        {
          "s": 16,
          "text": "המשכת היסוד,"
        },
        {
          "s": 17,
          "text": "ועי\"ז – המשכת המוחין,"
        },
        {
          "s": 18,
          "text": "ואז נמשך גילוי אלקות גם בכללות העולם,"
        },
        {
          "s": 19,
          "text": "כמו בג\"ע."
        },
        {
          "s": 20,
          "text": "ומלך לשדה נעבד הוא כמ\"ש בזהר28"
        },
        {
          "s": 21,
          "text": "מאן מלך דא מלך עילאה דאתחבר לשדה כד איהו נעבד,"
        },
        {
          "s": 22,
          "text": "שע\"י העבודה בג\"ע"
        },
        {
          "s": 23,
          "text": "(שדה נעבד)"
        },
        {
          "s": 24,
          "text": "נעשה המשכת הכתר"
        },
        {
          "s": 25,
          "text": "(מלך עילאה)"
        },
        {
          "s": 26,
          "text": "שלמעלה מהשתלשלות."
        }
      ]
    }
  ]
}