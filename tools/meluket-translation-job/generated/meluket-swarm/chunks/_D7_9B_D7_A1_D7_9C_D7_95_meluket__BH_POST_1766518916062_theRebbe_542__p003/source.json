{
  "globalIndex": 404,
  "owner": 4,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518916062_theRebbe_542__p003",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518916062_theRebbe_542__p003",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518916062_theRebbe_542",
  "title": "מאמר פדה בשלום תשל\"א",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "וכשם שהוא בכחות האדם,"
        },
        {
          "s": 1,
          "text": "כמו\"כ ישנו גם למעלה הענין דהעלם וגילוי,"
        },
        {
          "s": 2,
          "text": "שהו\"ע דאורות וכלים,"
        },
        {
          "s": 3,
          "text": "והחילוק הוא,"
        },
        {
          "s": 4,
          "text": "שמצד ההעלם"
        },
        {
          "s": 5,
          "text": "(ענין האור),"
        },
        {
          "s": 6,
          "text": "הרי זה באופן דאני הוי' לא שניתי,"
        },
        {
          "s": 7,
          "text": "אבל כפי שנמשך אח\"כ בגלוי,"
        },
        {
          "s": 8,
          "text": "אזי ישנם השמות דעשר ספירות,"
        },
        {
          "s": 9,
          "text": "עשר ולא תשע עשר ולא אחד עשר20,"
        },
        {
          "s": 10,
          "text": "ועד שאפשר להיות ענין השינוי,"
        },
        {
          "s": 11,
          "text": "שכל זה הוא מצד הגילוי,"
        },
        {
          "s": 12,
          "text": "שבו פועל ענין הכלי."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר21,"
        },
        {
          "s": 2,
          "text": "שעפ\"ז יובן גם איך נמשך שכל האדם מלמעלה הימנו."
        },
        {
          "s": 3,
          "text": "ובהקדם שענין גילוי השכל הוא ע\"י האותיות,"
        },
        {
          "s": 4,
          "text": "כידוע22"
        },
        {
          "s": 5,
          "text": "שאותיות הם מלשון אתא בוקר23,"
        },
        {
          "s": 6,
          "text": "שעל ידם נמשך ומתגלה הבוקר דאור השכל."
        },
        {
          "s": 7,
          "text": "דהנה,"
        },
        {
          "s": 8,
          "text": "בכדי שאור השכל יבוא בהתגלות אפילו לעצמו,"
        },
        {
          "s": 9,
          "text": "היינו,"
        },
        {
          "s": 10,
          "text": "שהשכל כפי שהוא בעצם הנפש,"
        },
        {
          "s": 11,
          "text": "יומשך ממנו כח המשכיל,"
        },
        {
          "s": 12,
          "text": "וממנו יומשך אח\"כ שכל וחכמה הגלוי',"
        },
        {
          "s": 13,
          "text": "אזי צ\"ל ענין האותיות שבשכל,"
        },
        {
          "s": 14,
          "text": "אותיות המחשבה."
        },
        {
          "s": 15,
          "text": "וכדי שיומשך ויתגלה גם אל הזולת,"
        },
        {
          "s": 16,
          "text": "הרי זה צריך לבוא גם באותיות הדיבור,"
        },
        {
          "s": 17,
          "text": "או למטה יותר באותיות הכתב."
        },
        {
          "s": 18,
          "text": "וכמו שרואים ברב ותלמיד,"
        },
        {
          "s": 19,
          "text": "שהרב אומר דבר שכל באותיות הדיבור או שכותבו באותיות הכתב,"
        },
        {
          "s": 20,
          "text": "והתלמיד שומע את אותיות הדיבור או לומד מתוך הכתב,"
        },
        {
          "s": 21,
          "text": "והיינו,"
        },
        {
          "s": 22,
          "text": "שהמשכת השכל מהרב אל התלמיד היא דוקא ע\"י האותיות,"
        },
        {
          "s": 23,
          "text": "שעל ידם נמשך השכל בגלוי,"
        },
        {
          "s": 24,
          "text": "שאז יכולים לקרותו בשם חכמה בינה ודעת,"
        },
        {
          "s": 25,
          "text": "חכמה מסויימת,"
        },
        {
          "s": 26,
          "text": "ואז שייך בו שינויים,"
        },
        {
          "s": 27,
          "text": "קטנות וגדלות וכו'."
        },
        {
          "s": 28,
          "text": "ואח\"כ כאשר התלמיד לומד הענין מתוך האותיות שבהם נתגלה השכל אליו,"
        },
        {
          "s": 29,
          "text": "אזי מגיע להבנת השכל באופן שאינו צריך עוד להאותיות,"
        },
        {
          "s": 30,
          "text": "והיינו,"
        },
        {
          "s": 31,
          "text": "שמגיע להשכל כפי שהוא למעלה מאותיות,"
        },
        {
          "s": 32,
          "text": "ששם בטלים האותיות לגבי אור השכל,"
        },
        {
          "s": 33,
          "text": "ועד שיש לזה השפעה גם בהבחי' שלמעלה מהכחות הפנימיים והגלויים שבאדם."
        },
        {
          "s": 34,
          "text": "והנה,"
        },
        {
          "s": 35,
          "text": "כשם שהתגלות שכל האדם היא ע\"י האותיות,"
        },
        {
          "s": 36,
          "text": "כמו\"כ גם בנוגע להמשכת שכל האדם שנשתלשל מכח החכמה שבע\"ס דעשי',"
        },
        {
          "s": 37,
          "text": "שענין זה נעשה ע\"י האותיות שהם הכלים שבע\"ס דעשי'."
        },
        {
          "s": 38,
          "text": "ועד\"ז בנוגע לע\"ס דעשי' שנמשך להם מע\"ס דיצירה,"
        },
        {
          "s": 39,
          "text": "וע\"ס דיצירה מע\"ס דבריאה,"
        },
        {
          "s": 40,
          "text": "וע\"ס דבריאה מע\"ס דאצילות,"
        },
        {
          "s": 41,
          "text": "שגם בהם ישנו הענין דאורות וכלים,"
        },
        {
          "s": 42,
          "text": "שעי\"ז מקבלים מהאותיות והכלים שלמעלה מהם"
        },
        {
          "s": 43,
          "text": "(כפי שיתבאר לקמן)"
        },
        {
          "s": 44,
          "text": "נעשה בהם ענין האורות ואח\"כ גם ענין הכלים."
        },
        {
          "s": 45,
          "text": "ואז שייך הענין דעשר ספירות,"
        },
        {
          "s": 46,
          "text": "עשר ולא תשע כו',"
        },
        {
          "s": 47,
          "text": "וכן הענין דמהות חכמה ובינה וכו',"
        },
        {
          "s": 48,
          "text": "וכן ענין הרצון שיש בו ענין של שינוי,"
        },
        {
          "s": 49,
          "text": "שיומשך רצון חדש כו'"
        },
        {
          "s": 50,
          "text": "[כמו שהוא באדם,"
        },
        {
          "s": 51,
          "text": "שרק כאשר הכחות הם בהתגלות"
        },
        {
          "s": 52,
          "text": "(לאחרי שנמשכים מעצם הנפש ששם נמצאים כל הענינים באופן שאינם בגלוי),"
        },
        {
          "s": 53,
          "text": "אזי יש בהם אורך רוחב ועומק,"
        },
        {
          "s": 54,
          "text": "ועד שמתחלקים למספר עשר,"
        },
        {
          "s": 55,
          "text": "כמבואר בפרדס בתחלתו24"
        },
        {
          "s": 56,
          "text": "שכל עניני העולם הם במספר עשר]."
        },
        {
          "s": 57,
          "text": "אלא שבעולם האצילות הרי הם באופן של נקודה,"
        },
        {
          "s": 58,
          "text": "שזהו כללות הענין דעולם הנקודים,"
        },
        {
          "s": 59,
          "text": "שהם עשר אורות בעשר כלים,"
        },
        {
          "s": 60,
          "text": "אבל הם בציור של נקודה,"
        },
        {
          "s": 61,
          "text": "וכנ\"ל שענין זה נמשך מלמעלה הימנו,"
        },
        {
          "s": 62,
          "text": "ע\"ד המשכת שכל האדם מע\"ס דעשי',"
        },
        {
          "s": 63,
          "text": "עשי' מיצירה,"
        },
        {
          "s": 64,
          "text": "יצירה מבריאה ובריאה מאצילות."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "אמנם כל האמור לעיל הוא בנוגע להעלם וגילוי,"
        },
        {
          "s": 2,
          "text": "היינו,"
        },
        {
          "s": 3,
          "text": "שהענינים שהם תחילה בהעלם,"
        },
        {
          "s": 4,
          "text": "עם כל העילויים והמעלות שבהם,"
        },
        {
          "s": 5,
          "text": "נמשכים ובאים בגילוי."
        },
        {
          "s": 6,
          "text": "אך עדיין צריך להבין,"
        },
        {
          "s": 7,
          "text": "איך יוכל להיות התהוות בעל גבול מאור א\"ס שהוא בלתי בעל גבול."
        },
        {
          "s": 8,
          "text": "ועל זה ממשיך בהמאמר25,"
        },
        {
          "s": 9,
          "text": "שענין זה אינו יכול להיות באופן של השתלשלות מן ההעלם אל הגילוי,"
        },
        {
          "s": 10,
          "text": "אפילו לא ע\"י השתלשלות כו\"כ מדריגות,"
        },
        {
          "s": 11,
          "text": "כי אם,"
        },
        {
          "s": 12,
          "text": "כמ\"ש בע\"ח בתחלתו שהוצרך להיות ענין הצמצום הנקרא מקום פנוי,"
        },
        {
          "s": 13,
          "text": "שסילק אורו על הצד,"
        },
        {
          "s": 14,
          "text": "והו\"ע צמצום הראשון שהוא בדרך סילוק לגמרי,"
        },
        {
          "s": 15,
          "text": "ואח\"כ נמשך קו קצר,"
        },
        {
          "s": 16,
          "text": "ועי\"ז יכול להיות ענין הגבול,"
        },
        {
          "s": 17,
          "text": "והיינו,"
        },
        {
          "s": 18,
          "text": "שאף שלפנ\"ז היו ספירות אין קץ26,"
        },
        {
          "s": 19,
          "text": "או למעלה לגמרי מגדר ספירות,"
        },
        {
          "s": 20,
          "text": "הנה ע\"י הצמצום נעשה עכ\"פ מקור לענין הגבול,"
        },
        {
          "s": 21,
          "text": "וכמבואר בכמה דרושים27,"
        },
        {
          "s": 22,
          "text": "שגם עולם האצילות עצמו הו\"ע של בל\"ג,"
        },
        {
          "s": 23,
          "text": "אלא שנעשה בו ענין שמחוץ לאצילות הו\"ע הגבול."
        }
      ]
    }
  ]
}