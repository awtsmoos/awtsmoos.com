{
  "globalIndex": 354,
  "owner": 4,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915808_theRebbe_726__p002",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915808_theRebbe_726__p002",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915808_theRebbe_726",
  "title": "מאמר פדה בשלום תשל\"ח",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה בפסוק זה שני פירושים."
        },
        {
          "s": 2,
          "text": "פירוש הפשוט בפדה בשלום נפשי הוא שהקב\"ה פודה את הצדיקים"
        },
        {
          "s": 3,
          "text": "[הן לפי פשטות הענין שקאי על פדיית דוד,"
        },
        {
          "s": 4,
          "text": "שהקב\"ה פדה אותו מהמלחמות שבאו עליו14,"
        },
        {
          "s": 5,
          "text": "וכדאיתא בירושלמי15"
        },
        {
          "s": 6,
          "text": "שפדה בשלום נפשי קאי על פדיית דוד ממלחמת אבשלום,"
        },
        {
          "s": 7,
          "text": "וכ\"ה גם בנוגע לפדה בשלום נפשי דהגאולות די\"ט כסלו יו\"ד כסלו וי\"ב תמוז,"
        },
        {
          "s": 8,
          "text": "שהקב\"ה פדה את הצדיקים],"
        },
        {
          "s": 9,
          "text": "ופירוש הב' הוא כמרז\"ל16"
        },
        {
          "s": 10,
          "text": "אמר הקב\"ה כל העוסק בתורה ובגמ\"ח ומתפלל עם הצבור כו' כאילו פדאני כו',"
        },
        {
          "s": 11,
          "text": "שהאדם"
        },
        {
          "s": 12,
          "text": "(העוסק בתורה וכו')"
        },
        {
          "s": 13,
          "text": "הוא פודה את הקב\"ה כביכול."
        },
        {
          "s": 14,
          "text": "וצריך להבין השייכות דשני הפירושים,"
        },
        {
          "s": 15,
          "text": "דנוסף על הידוע שכל הפירושים שבאותו פסוק שייכים זה לזה17,"
        },
        {
          "s": 16,
          "text": "הנה זה שבהדרושים די\"ט כסלו18"
        },
        {
          "s": 17,
          "text": "ודי\"ב תמוז7"
        },
        {
          "s": 18,
          "text": "(שאז הי' הענין דפדה בשלום נפשי כפשוטו,"
        },
        {
          "s": 19,
          "text": "כנ\"ל)"
        },
        {
          "s": 20,
          "text": "מובא"
        },
        {
          "s": 21,
          "text": "(בכו\"כ מהם)"
        },
        {
          "s": 22,
          "text": "בתחילתם וראשיתם דרשת חז\"ל הנ\"ל,"
        },
        {
          "s": 23,
          "text": "הרי זה מדגיש עוד יותר דשני פירושים אלה שייכים זל\"ז."
        },
        {
          "s": 24,
          "text": "וצריך להבין השייכות דשני הפירושים."
        },
        {
          "s": 25,
          "text": "ואף שגם לפי מרז\"ל הנ\"ל מדבר הכתוב"
        },
        {
          "s": 26,
          "text": "(גם)"
        },
        {
          "s": 27,
          "text": "בענין פדיית ישראל,"
        },
        {
          "s": 28,
          "text": "פדאני לי ולבני"
        },
        {
          "s": 29,
          "text": "[ובחדא\"ג מהרש\"א19"
        },
        {
          "s": 30,
          "text": "שם שהשכינה אמרה פדה בשלום נפשי עם מקרב לי מלשון קרובים דהיינו בני],"
        },
        {
          "s": 31,
          "text": "הרי זהו בנוגע להנפדה,"
        },
        {
          "s": 32,
          "text": "אבל בנוגע להפודה,"
        },
        {
          "s": 33,
          "text": "הרי לפי פירוש הפשוט,"
        },
        {
          "s": 34,
          "text": "פדה גו' קאי על הקב\"ה,"
        },
        {
          "s": 35,
          "text": "ולפי מרז\"ל הנ\"ל,"
        },
        {
          "s": 36,
          "text": "פדה גו' קאי על האדם העוסק בתורה וכו'."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים שג' הענינים דתורה וגמ\"ח ותפלה"
        },
        {
          "s": 2,
          "text": "(בצבור),"
        },
        {
          "s": 3,
          "text": "שעל ידם פדאני לי ולבני,"
        },
        {
          "s": 4,
          "text": "הם ג' העמודים שעליהם העולם עומד20"
        },
        {
          "s": 5,
          "text": "(כמ\"ש בחדא\"ג מהרש\"א שם21"
        },
        {
          "s": 6,
          "text": "ועד\"ז ברשב\"א שם22)."
        },
        {
          "s": 7,
          "text": "ומכיון שקיום ועמידת העולם הוא על ג' עמודים אלה,"
        },
        {
          "s": 8,
          "text": "צריך לומר,"
        },
        {
          "s": 9,
          "text": "דג' ענינים אלה היו גם בתחילת הבריאה."
        },
        {
          "s": 10,
          "text": "ואף שידוע שבריאת העולם היתה מצד כי23"
        },
        {
          "s": 11,
          "text": "חפץ חסד הוא"
        },
        {
          "s": 12,
          "text": "(ורק עכשיו באתעדל\"ת תליא מילתא)24,"
        },
        {
          "s": 13,
          "text": "אעפ\"כ,"
        },
        {
          "s": 14,
          "text": "מכיון שכוונת הבריאה מלכתחילה היא בשביל ישראל ובשביל התורה25,"
        },
        {
          "s": 15,
          "text": "צריך לומר,"
        },
        {
          "s": 16,
          "text": "שג' ענינים אלה הם עמודי העולם גם בתחילת התהוותו."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "והענין הוא,"
        },
        {
          "s": 1,
          "text": "דהנה ידועה תורת הרב המגיד26"
        },
        {
          "s": 2,
          "text": "ותורת כ\"ק אדמו\"ר הזקן27"
        },
        {
          "s": 3,
          "text": "[שנקראת"
        },
        {
          "s": 4,
          "text": "(גם)"
        },
        {
          "s": 5,
          "text": "על שמו28]"
        },
        {
          "s": 6,
          "text": "על מאמר רז\"ל29"
        },
        {
          "s": 7,
          "text": "דע מה למעלה ממך,"
        },
        {
          "s": 8,
          "text": "דכל מה שלמעלה הכל הוא ממך."
        },
        {
          "s": 9,
          "text": "ומהמשך הענין שם מובן,"
        },
        {
          "s": 10,
          "text": "שע\"י עבודת האדם נעשה הענין למעלה גם קודם העבודה30."
        },
        {
          "s": 11,
          "text": "וכמ\"ש הרב המגיד31"
        },
        {
          "s": 12,
          "text": "עה\"פ32"
        },
        {
          "s": 13,
          "text": "נעשה אדם בצלמנו גו',"
        },
        {
          "s": 14,
          "text": "שהוא כמשל אדם שיש לו בן,"
        },
        {
          "s": 15,
          "text": "שמצד גודל אהבתו אליו,"
        },
        {
          "s": 16,
          "text": "נחקקה צורת הבן במחשבתו."
        },
        {
          "s": 17,
          "text": "ומכיון שאצלו ית' העבר והעתיד אחד,"
        },
        {
          "s": 18,
          "text": "לכן נחקקה צורתם של ישראל"
        },
        {
          "s": 19,
          "text": "(כמו שנש\"י הן בבחי' נברא,"
        },
        {
          "s": 20,
          "text": "ויתירה מזה כמו שהן יורדות למטה33)"
        },
        {
          "s": 21,
          "text": "במחשבתו ית' גם קודם שנבראו."
        },
        {
          "s": 22,
          "text": "דזהו גם ענין במי נמלך בנשמותיהן של צדיקים34,"
        },
        {
          "s": 23,
          "text": "דזה מה שהי' ידוע לפניו ית' שיתענג כביכול בעבודת הצדיקים,"
        },
        {
          "s": 24,
          "text": "הנה תענוג זה עלה לפניו ית' גם לפני הבריאה"
        },
        {
          "s": 25,
          "text": "(ועי\"ז היתה הבריאה)35."
        },
        {
          "s": 26,
          "text": "וזהו מה שג' העמודים"
        },
        {
          "s": 27,
          "text": "(תורה עבודה וגמ\"ח)"
        },
        {
          "s": 28,
          "text": "היו גם בתחילת הבריאה,"
        },
        {
          "s": 29,
          "text": "דמכיון שהקב\"ה צמצם את עצמו בצלם של ישראל"
        },
        {
          "s": 30,
          "text": "(עוד לפני שנבראו),"
        },
        {
          "s": 31,
          "text": "הנה על ידי העבודה דישראל דתורה עבודה וגמ\"ח,"
        },
        {
          "s": 32,
          "text": "שהם ג' הקוין חג\"ת36"
        },
        {
          "s": 33,
          "text": "(וג' הענינים דמחשבה דיבור ומעשה37),"
        },
        {
          "s": 34,
          "text": "נעשה למעלה"
        },
        {
          "s": 35,
          "text": "(עוד לפני הבריאה)"
        },
        {
          "s": 36,
          "text": "הציור דחג\"ת"
        },
        {
          "s": 37,
          "text": "(ודמחדו\"מ),"
        },
        {
          "s": 38,
          "text": "ונתהוו כל העולמות38."
        }
      ]
    }
  ]
}