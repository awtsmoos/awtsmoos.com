{
  "globalIndex": 434,
  "owner": 34,
  "jobId": "_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916230_theRebbe_919__p001",
  "batchId": "meluket-_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916230_theRebbe_919__p001",
  "seriesId": "טבת_meluket",
  "postId": "BH_POST_1766518916230_theRebbe_919",
  "title": "מאמר הבאים ישרש יעקב תשמ\"ח",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ שמות,"
        },
        {
          "s": 2,
          "text": "י\"ט טבת,"
        },
        {
          "s": 3,
          "text": "ה'תשמ\"ח*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "הבאים ישרש יעקב גו'1,"
        },
        {
          "s": 1,
          "text": "ומביא הצמח צדק במאמרו ד\"ה זה2"
        },
        {
          "s": 2,
          "text": "פירוש התיב\"ע עה\"פ שזה קאי על הגאולה."
        },
        {
          "s": 3,
          "text": "שהתרגום דהבאים הוא יתכנשון מביני גלוותהון ויתובון לארעהון"
        },
        {
          "s": 4,
          "text": "[דהבאים קאי על הביאה לארץ שתהי' בגאולה העתידה,"
        },
        {
          "s": 5,
          "text": "והביאך3"
        },
        {
          "s": 6,
          "text": "ה' אלקיך אל הארץ4],"
        },
        {
          "s": 7,
          "text": "ואז יהי' ישרש יעקב,"
        },
        {
          "s": 8,
          "text": "תמן יתילידון דבית יעקב."
        },
        {
          "s": 9,
          "text": "ומבאר בהמאמר,"
        },
        {
          "s": 10,
          "text": "דהשרשה"
        },
        {
          "s": 11,
          "text": "(ישרש)"
        },
        {
          "s": 12,
          "text": "הוא העלם"
        },
        {
          "s": 13,
          "text": "(כמו השרשת אילן,"
        },
        {
          "s": 14,
          "text": "ששרשי האילן שבארץ הם בהעלם)"
        },
        {
          "s": 15,
          "text": "ולידה הוא גילוי"
        },
        {
          "s": 16,
          "text": "(דקודם הלידה בהיותו בבטן אמו,"
        },
        {
          "s": 17,
          "text": "הוא בהעלם,"
        },
        {
          "s": 18,
          "text": "וכשנולד בא לגילוי),"
        },
        {
          "s": 19,
          "text": "וזה שהתרגום דישרש הוא יתילידון,"
        },
        {
          "s": 20,
          "text": "הוא,"
        },
        {
          "s": 21,
          "text": "ששרש הנשמה"
        },
        {
          "s": 22,
          "text": "(ישרש יעקב)"
        },
        {
          "s": 23,
          "text": "יהי' בגילוי"
        },
        {
          "s": 24,
          "text": "(יתילידון)."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "וממשיך בהמאמר5"
        },
        {
          "s": 1,
          "text": "עוד פירוש בישרש יעקב,"
        },
        {
          "s": 2,
          "text": "שזה קאי על קיום המצוות."
        },
        {
          "s": 3,
          "text": "דכמו שהשרשה כפשוטה היא בארץ דוקא,"
        },
        {
          "s": 4,
          "text": "עד\"ז הוא בנשמה"
        },
        {
          "s": 5,
          "text": "(יעקב),"
        },
        {
          "s": 6,
          "text": "שההשרשה היא בקיום מצוות מעשיות."
        },
        {
          "s": 7,
          "text": "והקשר דשני הפירושים בישרש יעקב6"
        },
        {
          "s": 8,
          "text": "(גילוי שרש הנשמה וקיום המצוות)"
        },
        {
          "s": 9,
          "text": "הוא,"
        },
        {
          "s": 10,
          "text": "כי הגילוי דשרש הנשמה שיהי' לע\"ל הוא ע\"י קיום המצוות עכשיו."
        },
        {
          "s": 11,
          "text": "והענין הוא7,"
        },
        {
          "s": 12,
          "text": "דבשרש הנשמה כמה דרגות."
        },
        {
          "s": 13,
          "text": "ועיקר שרש הנשמה הוא כמו שהיא מושרשת בהאור שלמעלה מהשתלשלות,"
        },
        {
          "s": 14,
          "text": "ואור זה נמשך ע\"י קיום המצוות."
        },
        {
          "s": 15,
          "text": "דההמשכה שע\"י לימוד התורה היא מבחינת חכמה,"
        },
        {
          "s": 16,
          "text": "ראשית ההשתלשלות,"
        },
        {
          "s": 17,
          "text": "והמשכת האור שלמעלה מהשתלשלות,"
        },
        {
          "s": 18,
          "text": "הוא ע\"י מעשה המצוות8."
        },
        {
          "s": 19,
          "text": "וזהו שארז\"ל9"
        },
        {
          "s": 20,
          "text": "כל שמעשיו מרובין מחכמתו כו' דומה לאילן שענפיו מועטין ושרשיו מרובין,"
        },
        {
          "s": 21,
          "text": "כי המשכת שרש הנשמה היא ע\"י מעשה המצוות."
        },
        {
          "s": 22,
          "text": "וזהו הקשר דשני הפירושים בישרש יעקב,"
        },
        {
          "s": 23,
          "text": "שע\"י קיום המצוות עכשיו"
        },
        {
          "s": 24,
          "text": "(פירוש השני בישרש יעקב)"
        },
        {
          "s": 25,
          "text": "נמשך שרש הנשמה,"
        },
        {
          "s": 26,
          "text": "והגילוי דהמשכה זו יהי' לע\"ל,"
        },
        {
          "s": 27,
          "text": "יתילידון דבית יעקב,"
        },
        {
          "s": 28,
          "text": "ששרש הנשמה יאיר בגילוי"
        },
        {
          "s": 29,
          "text": "(פירוש הראשון בישרש יעקב)."
        }
      ]
    }
  ]
}