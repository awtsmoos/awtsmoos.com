{
  "globalIndex": 837,
  "owner": 37,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918734_theRebbe_176__p005",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518918734_theRebbe_176__p005",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518918734_theRebbe_176",
  "title": "מאמר וידבר אלוקים את כל הדברים האלה תשכ\"ח",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "והענין הוא,"
        },
        {
          "s": 1,
          "text": "דשורש הפרט הוא למעלה מהכלל40."
        },
        {
          "s": 2,
          "text": "וכמו חכמה ובינה,"
        },
        {
          "s": 3,
          "text": "דהגם שחכמה היא הכלל שממנה נמשכים כל הפרטים דבינה,"
        },
        {
          "s": 4,
          "text": "מ\"מ מצד זה גופא,"
        },
        {
          "s": 5,
          "text": "שורש הבינה הוא למעלה משורש החכמה."
        },
        {
          "s": 6,
          "text": "שלכן,"
        },
        {
          "s": 7,
          "text": "על ידי העיון בהפרטים דבינה ניתוספים"
        },
        {
          "s": 8,
          "text": "(לפעמים)"
        },
        {
          "s": 9,
          "text": "ענינים חדשים שלא היו בנקודת החכמה."
        },
        {
          "s": 10,
          "text": "ועד\"ז הוא בדיבור,"
        },
        {
          "s": 11,
          "text": "דכשנמשך השכל בדיבור נעשים בו ריבוי פרטים יותר גם מהפרטים דבינה"
        },
        {
          "s": 12,
          "text": "(אפילו לאחרי שהבינה מתלבשת במחשבה,"
        },
        {
          "s": 13,
          "text": "דמה שחושבים במחשבה אחת הנה בדיבור הוא משך זמן),"
        },
        {
          "s": 14,
          "text": "דשורש הדיבור הוא למעלה יותר גם מהשורש דבינה,"
        },
        {
          "s": 15,
          "text": "שלכן כשלומד את השכל בדיבור,"
        },
        {
          "s": 16,
          "text": "מתחדשים אצלו ענינים שלא היו תחילה במחשבה,"
        },
        {
          "s": 17,
          "text": "גם בההשגה דבינה."
        },
        {
          "s": 18,
          "text": "ועד\"ז הוא בהשפעת שכל מרב לתלמיד,"
        },
        {
          "s": 19,
          "text": "דעל ידי שהשכל מתפרט לריבוי פרטים"
        },
        {
          "s": 20,
          "text": "[ובפרט על ידי ההשפעה לתלמיד קטן,"
        },
        {
          "s": 21,
          "text": "דכל מה שההשפעה היא לתלמיד קטן יותר,"
        },
        {
          "s": 22,
          "text": "צריך לפרט את השכל בריבוי פרטים יותר41],"
        },
        {
          "s": 23,
          "text": "הנה עי\"ז מיתוסף אצל הרב עומק חדש שלא הי' אצלו לפני ההשפעה,"
        },
        {
          "s": 24,
          "text": "כמאמר42"
        },
        {
          "s": 25,
          "text": "ומתלמידי יותר מכולן."
        },
        {
          "s": 26,
          "text": "ובפרט כשהתלמיד מקשה קושיות על השכל,"
        },
        {
          "s": 27,
          "text": "שבכדי לתרץ ולהסיר את הקושיא,"
        },
        {
          "s": 28,
          "text": "מתעורר אצלו עומק חדש."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "והנמשל מזה יובן למעלה בענין העשרה מאמרות,"
        },
        {
          "s": 1,
          "text": "דהגם שהעשרה מאמרות הם הפרטים דהמאמר אחד,"
        },
        {
          "s": 2,
          "text": "מ\"מ,"
        },
        {
          "s": 3,
          "text": "מצד זה גופא,"
        },
        {
          "s": 4,
          "text": "מכיון ששורש הפרט הוא למעלה מהכלל,"
        },
        {
          "s": 5,
          "text": "לכן על ידי העבודה בהעולם שנברא בעשרה מאמרות"
        },
        {
          "s": 6,
          "text": "[ובפרט שמצד זה שהעולם נברא בעשרה מאמרות יש אפשרות לבחור גם בהיפך"
        },
        {
          "s": 7,
          "text": "(כנ\"ל סעיף ו),"
        },
        {
          "s": 8,
          "text": "בדוגמת הקושיות שסותרים את השכל],"
        },
        {
          "s": 9,
          "text": "מגיעים למעלה יותר מבחינת הכלל דעולם דמאמר אחד,"
        },
        {
          "s": 10,
          "text": "ויתירה מזו,"
        },
        {
          "s": 11,
          "text": "שמגיעים גם לעצם האור,"
        },
        {
          "s": 12,
          "text": "שלמעלה גם מהאור"
        },
        {
          "s": 13,
          "text": "(התפשטות האור)"
        },
        {
          "s": 14,
          "text": "שבו הי' העלאת הרצון לעולמות."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "והנה עד\"ז הוא גם בההמשכה דתורה,"
        },
        {
          "s": 2,
          "text": "דע\"י שנמשכה תחילה בבחינת כלל ואח\"כ נפרטה לפרטים,"
        },
        {
          "s": 3,
          "text": "הנה גם הפרטים הם"
        },
        {
          "s": 4,
          "text": "(לא ענין בפני עצמו,"
        },
        {
          "s": 5,
          "text": "כי אם)"
        },
        {
          "s": 6,
          "text": "פרטים שנובעים מהכלל,"
        },
        {
          "s": 7,
          "text": "ועי\"ז ישנו הכח שגם בהפרטים דתורה שבעל פה,"
        },
        {
          "s": 8,
          "text": "ועד לכל מה שתלמיד ותיק עתיד לחדש,"
        },
        {
          "s": 9,
          "text": "יהי' בגילוי האור דהכלל דתורה שבכתב,"
        },
        {
          "s": 10,
          "text": "ועד להכלל דעשרת הדברות"
        },
        {
          "s": 11,
          "text": "(שלימוד כל פרט שבתורה יהי' באימה וביראה וברתת ובזיע כמו שהי' בעת אמירת עשרת הדברות43),"
        },
        {
          "s": 12,
          "text": "ועד להכלל דדיבור אחד שבו נכללו כל עשרת הדברות."
        }
      ]
    }
  ]
}