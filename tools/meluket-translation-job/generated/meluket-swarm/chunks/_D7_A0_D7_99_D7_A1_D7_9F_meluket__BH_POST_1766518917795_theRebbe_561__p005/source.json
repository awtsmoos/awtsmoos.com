{
  "globalIndex": 685,
  "owner": 35,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917795_theRebbe_561__p005",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917795_theRebbe_561__p005",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917795_theRebbe_561",
  "title": "מאמר כי ישאלך בנך תשל\"ח",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה כמו שלמעלה החילוק שבין עדות לחוקים ומשפטים הוא,"
        },
        {
          "s": 2,
          "text": "דחוקים ומשפטים הם באור השייך לעולמות"
        },
        {
          "s": 3,
          "text": "[אלא שמשפטים הם באור המתלבש בעולמות"
        },
        {
          "s": 4,
          "text": "(ממלא)"
        },
        {
          "s": 5,
          "text": "וחוקים הם בהאור שלמעלה מהתלבשות"
        },
        {
          "s": 6,
          "text": "(סובב)]"
        },
        {
          "s": 7,
          "text": "ועדות הם בעצמות אוא\"ס שלמעלה משייכות לעולמות,"
        },
        {
          "s": 8,
          "text": "עד\"ז הוא גם בעבודת האדם,"
        },
        {
          "s": 9,
          "text": "דחוקים ומשפטים הם בהשכל שבאדם"
        },
        {
          "s": 10,
          "text": "(או עכ\"פ בדרגת הנשמה ששייכת לשכל),"
        },
        {
          "s": 11,
          "text": "התבוננות."
        },
        {
          "s": 12,
          "text": "[אלא שבמשפטים ההתבוננות היא בטעמי המצוות,"
        },
        {
          "s": 13,
          "text": "כולל גם ההתבוננות בזה שגם המצוות דחוקים יש להם טעם43,"
        },
        {
          "s": 14,
          "text": "אלא שהטעם דמצוות אלו הוא בחכמתו ית' ולא נמשך בשכל הנבראים."
        },
        {
          "s": 15,
          "text": "וההתבוננות דחוקים היא שכל המצוות"
        },
        {
          "s": 16,
          "text": "(גם המצוות דמשפטים)"
        },
        {
          "s": 17,
          "text": "הם רצונו ית',"
        },
        {
          "s": 18,
          "text": "רצון שלמעלה מטעם,"
        },
        {
          "s": 19,
          "text": "למעלה גם מהטעמים שבחכמתו ית']."
        },
        {
          "s": 20,
          "text": "וענין עדות הוא בהאדם עצמו."
        },
        {
          "s": 21,
          "text": "כמ\"ש44"
        },
        {
          "s": 22,
          "text": "אתם עדי,"
        },
        {
          "s": 23,
          "text": "דפירוש אתם הוא אתם בעצמכם."
        },
        {
          "s": 24,
          "text": "דכיון שכל אחד מישראל נשמתו היא חלק אלוקה ממעל ממש45,"
        },
        {
          "s": 25,
          "text": "ושרש הנשמות הוא בהעצמות"
        },
        {
          "s": 26,
          "text": "(ולמעלה יותר מהשרש דתומ\"צ),"
        },
        {
          "s": 27,
          "text": "לכן,"
        },
        {
          "s": 28,
          "text": "עצם מציאותם דישראל מעידה על העצמות."
        },
        {
          "s": 29,
          "text": "אלא שהגילוי דשרש הנשמה הוא ע\"י העדות דהמצוות."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "דעיקר ענינם של המצוות הוא שהם עדות,"
        },
        {
          "s": 3,
          "text": "המשכת עצמות אוא\"ס."
        },
        {
          "s": 4,
          "text": "וענין החוקים והמשפטים דמצוות"
        },
        {
          "s": 5,
          "text": "(המשכת אור הסובב ואור הממלא)"
        },
        {
          "s": 6,
          "text": "הוא,"
        },
        {
          "s": 7,
          "text": "כי הכוונה בהמשכת העצמות שע\"י המצוות היא שההמשכה תהי' בגילוי,"
        },
        {
          "s": 8,
          "text": "וכיון שהעצמות הוא למעלה מגילוי,"
        },
        {
          "s": 9,
          "text": "לכן הגילוי דהמשכת העצמות"
        },
        {
          "s": 10,
          "text": "(עדות)"
        },
        {
          "s": 11,
          "text": "הוא ע\"י אור הסובב ואור הממלא"
        },
        {
          "s": 12,
          "text": "(חוקים ומשפטים),"
        },
        {
          "s": 13,
          "text": "גילויים46."
        },
        {
          "s": 14,
          "text": "וזהו שהסדר דג' ענינים אלה הוא עדות חוקים ומשפטים,"
        },
        {
          "s": 15,
          "text": "דבתחילה הו\"ע העדות – המשכת העצמות,"
        },
        {
          "s": 16,
          "text": "ואח\"כ,"
        },
        {
          "s": 17,
          "text": "בכדי שההמשכה תהי' בגילוי,"
        },
        {
          "s": 18,
          "text": "הוא ע\"י הגילוי דאור הסובב שנמשך ע\"י ענין החוקים שבמצוות,"
        },
        {
          "s": 19,
          "text": "ואח\"כ,"
        },
        {
          "s": 20,
          "text": "בכדי שהגילוי יהי' בפנימיות,"
        },
        {
          "s": 21,
          "text": "הוא ע\"י הגילוי דאור הממלא שנמשך ע\"י ענין המשפטים שבמצוות46."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 1,
          "text": "דזה שמשמע בתחילת המאמר ששאלת הבן חכם מה העדות והחוקים והמשפטים גו' היא דכיון שכל המצוות הם ציוויי השם למה הן נחלקות בעדות חוקים ומשפטים"
        },
        {
          "s": 2,
          "text": "(כנ\"ל סעיף ג),"
        },
        {
          "s": 3,
          "text": "הוא גם להביאור"
        },
        {
          "s": 4,
          "text": "(שבהמשך המאמר)"
        },
        {
          "s": 5,
          "text": "דשאלת הבן חכם היא איך נמשך גילוי אלקות ע\"י המצוות שלאחרי מתן תורה שעיקרם הוא עשי' בפועל."
        },
        {
          "s": 6,
          "text": "והענין הוא,"
        },
        {
          "s": 7,
          "text": "דזה שעל ידי מעשה המצוות נעשה המשכת אלקות אין זה פלא,"
        },
        {
          "s": 8,
          "text": "מכיון שהמצוות הם רצון הקב\"ה."
        },
        {
          "s": 9,
          "text": "ושאלת הבן חכם היא על זה שע\"י מעשה המצוות נמשך גילוי אלקות."
        },
        {
          "s": 10,
          "text": "דענין הגילוי שייך לכאורה לעבודה רוחנית ולא לעשי' גשמית."
        },
        {
          "s": 11,
          "text": "ולכן אומר מה העדות והחוקים והמשפטים גו',"
        },
        {
          "s": 12,
          "text": "ולא מה המצוות"
        },
        {
          "s": 13,
          "text": "(וכיו\"ב),"
        },
        {
          "s": 14,
          "text": "כי זה שע\"י המצוות נעשה המשכת אלקות הוא מצד הנקודה המשותפת שבכל המצוות בשוה,"
        },
        {
          "s": 15,
          "text": "שהם ציווי ורצון הקב\"ה,"
        },
        {
          "s": 16,
          "text": "וזה שהמצוות נחלקות בהסוגים עדות חוקים ומשפטים הוא בנוגע לגילוי ההמשכה"
        },
        {
          "s": 17,
          "text": "[שבעדות ההמשכה היא בהעלם,"
        },
        {
          "s": 18,
          "text": "ובחוקים ההמשכה היא בגילוי באופן דמקיף,"
        },
        {
          "s": 19,
          "text": "והגילוי דמשפטים הוא גילוי בפנימיות],"
        },
        {
          "s": 20,
          "text": "ושאלת הבן חכם מה העדות והחוקים והמשפטים אשר צוה הוי' אלקינו אתכם היא,"
        },
        {
          "s": 21,
          "text": "דהמצוות אשר צוה הוי' אלקינו אתכם לאחרי מתן תורה שעיקרם הוא עשי' בפועל,"
        },
        {
          "s": 22,
          "text": "ענינם הוא המשכת אלקות,"
        },
        {
          "s": 23,
          "text": "וא\"כ מה העדות והחוקים והמשפטים,"
        },
        {
          "s": 24,
          "text": "שהחילוק דעדות חוקים ומשפטים הוא בענין הגילוי."
        }
      ]
    }
  ]
}