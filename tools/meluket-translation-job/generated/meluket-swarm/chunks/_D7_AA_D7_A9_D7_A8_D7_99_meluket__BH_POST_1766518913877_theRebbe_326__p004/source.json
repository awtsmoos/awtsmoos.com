{
  "globalIndex": 38,
  "owner": 38,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913877_theRebbe_326__p004",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913877_theRebbe_326__p004",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518913877_theRebbe_326",
  "title": "מאמר יו\"ט של ר\"ה תשמ\"ג",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ועד\"ז הוא גם בענין תקיעת שופר דראש השנה,"
        },
        {
          "s": 2,
          "text": "שהיא ההמשכה מבחינת מקור התענוגים"
        },
        {
          "s": 3,
          "text": "(שלמעלה מבחי' גילוי התענוג)."
        },
        {
          "s": 4,
          "text": "שהרי בראש השנה חוזרים כל הדברים לקדמותם וצריך לחדש כל ענין ממקורו ושרשו הראשון,"
        },
        {
          "s": 5,
          "text": "עד מעצמות ומהות59."
        },
        {
          "s": 6,
          "text": "וכמו\"כ הוא גם בענין הברית וההתקשרות דהקב\"ה עם ישראל,"
        },
        {
          "s": 7,
          "text": "דבכל ראש השנה נעשה הברית וההתקשרות מחדש,"
        },
        {
          "s": 8,
          "text": "כמ\"ש60"
        },
        {
          "s": 9,
          "text": "אתם נצבים היום"
        },
        {
          "s": 10,
          "text": "(ראש השנה61)"
        },
        {
          "s": 11,
          "text": "גו' לעברך בברית ה' אלקיך,"
        },
        {
          "s": 12,
          "text": "דהמשכת הברית"
        },
        {
          "s": 13,
          "text": "(בראש השנה)"
        },
        {
          "s": 14,
          "text": "היא מהעצמות שלמעלה מכל הגילויים."
        },
        {
          "s": 15,
          "text": "וכמובן גם משני המשלים על תקיעת שופר שהובאו בהמשך וככה לאדמו\"ר מהר\"ש62,"
        },
        {
          "s": 16,
          "text": "משל אחד בשם הבעש\"ט מבן מלך שע\"י שצעק בקול פשוט הכיר המלך שהוא קול בנו יחידו,"
        },
        {
          "s": 17,
          "text": "ואף שאין בזה תיבות בלשון מדינת המלך,"
        },
        {
          "s": 18,
          "text": "מ\"מ,"
        },
        {
          "s": 19,
          "text": "הנה דוקא זה פעל חידוש הקשר בין המלך ובנו,"
        },
        {
          "s": 20,
          "text": "ומשל ב' מהרה\"ג החסיד מהרלי\"צ ז\"ל מבאַרדיטשוב63"
        },
        {
          "s": 21,
          "text": "(אוהב ישראל הידוע ומפורסם64)"
        },
        {
          "s": 22,
          "text": "מענין לבושים פשוטים"
        },
        {
          "s": 23,
          "text": "(דלבושים הם למטה מקול פשוט),"
        },
        {
          "s": 24,
          "text": "דע\"י שלבש הבגדים הפשוטים דוקא,"
        },
        {
          "s": 25,
          "text": "נתחדש הקשר שבין המלך לידידו."
        },
        {
          "s": 26,
          "text": "דנקודת הענין המובנת משני משלים אלו הוא,"
        },
        {
          "s": 27,
          "text": "דחידוש הברית וההתקשרות שנעשה בראש השנה ע\"י תקיעת שופר אינו מצד בחי' הגילויים"
        },
        {
          "s": 28,
          "text": "[שהרי בקול פשוט אין בו אפילו מלשון מדינת המלך,"
        },
        {
          "s": 29,
          "text": "וכש\"כ לבושים פשוטים שהם למטה מקול],"
        },
        {
          "s": 30,
          "text": "כי אם,"
        },
        {
          "s": 31,
          "text": "באופן חדש שלא הי' עדיין מעולם65."
        },
        {
          "s": 32,
          "text": "וזהו ג\"כ הקשר והשייכות דתקיעת שופר בראש השנה עם קול שופר שהי' במ\"ת"
        },
        {
          "s": 33,
          "text": "[כמובא באבודרהם בשם הרס\"ג בטעמי התקיעות"
        },
        {
          "s": 34,
          "text": "(הענין השלישי),"
        },
        {
          "s": 35,
          "text": "וכמבואר גם בהמשך הנ\"ל בהמשל דהרלי\"צ ז\"ל מבאַרדיטשוב דתקיעת שופר דראש השנה הוא אותו הלבוש שהי' במ\"ת,"
        },
        {
          "s": 36,
          "text": "ויהי66"
        },
        {
          "s": 37,
          "text": "קול השופר],"
        },
        {
          "s": 38,
          "text": "דכשם שקול השופר דמ\"ת הוא המשכת בחי' מקור התענוגים ועד להמשכת העצמות כנ\"ל,"
        },
        {
          "s": 39,
          "text": "עד\"ז הוא גם בענין תקיעת שופר דראש השנה,"
        },
        {
          "s": 40,
          "text": "דענין הברית שמתחדש בראש השנה הוא מהעצמות,"
        },
        {
          "s": 41,
          "text": "וכן התחדשות הרצון לקיום העולמות ולבחינת מלוכה שע\"י תקיעת שופר"
        },
        {
          "s": 42,
          "text": "(ענין תמליכוני עליכם),"
        },
        {
          "s": 43,
          "text": "מכיון שכל הדברים חוזרים לקדמותם,"
        },
        {
          "s": 44,
          "text": "הוא מהעצמות."
        },
        {
          "s": 45,
          "text": "וזהו גם מה שהתחלת ברכת שופרות היא בענין מ\"ת,"
        },
        {
          "s": 46,
          "text": "אתה נגלית כו' על הר סיני ללמד לעמך תורה ומצוות,"
        },
        {
          "s": 47,
          "text": "ומסיימים וחותמים שומע קול תרועת עמו ישראל ברחמים,"
        },
        {
          "s": 48,
          "text": "ולפנ\"ז בברכת זכרונות חותמים זוכר הברית שקאי"
        },
        {
          "s": 49,
          "text": "(בעיקר)"
        },
        {
          "s": 50,
          "text": "על הברית דהקב\"ה וישראל,"
        },
        {
          "s": 51,
          "text": "אתם נצבים היום גו' לעברך בברית ה' אלקיך,"
        },
        {
          "s": 52,
          "text": "ולפנ\"ז בברכת מלכיות מסיימים מלך על כל הארץ,"
        },
        {
          "s": 53,
          "text": "שזה נעשה ע\"י שתמליכוני עליכם,"
        },
        {
          "s": 54,
          "text": "וכמו שאומרים לפנ\"ז"
        },
        {
          "s": 55,
          "text": "(בהפסוקים)"
        },
        {
          "s": 56,
          "text": "מלך67"
        },
        {
          "s": 57,
          "text": "ישראל וגואלו."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "וזהו68 מה שבמקדש היו תוקעין גם בראש השנה שחל בשבת,"
        },
        {
          "s": 1,
          "text": "דמכיון דענין תקיעת שופר בראש השנה הוא המשכת בחינת מקור התענוגים שלמעלה מבחינת גילוי"
        },
        {
          "s": 2,
          "text": "(כמו קול השופר שהי' במ\"ת),"
        },
        {
          "s": 3,
          "text": "דבחינה זו היא נעלית מבחינת התענוג דשבת"
        },
        {
          "s": 4,
          "text": "(גם מבחינה הכי נעלית דשבת),"
        },
        {
          "s": 5,
          "text": "לכן צריך לתקוע גם בראש השנה שחל בשבת."
        },
        {
          "s": 6,
          "text": "ומה שהיו תוקעין רק במקדש ולא במדינה הוא לפי שהמשכת בחינה זו"
        },
        {
          "s": 7,
          "text": "(מקור התענוגים)"
        },
        {
          "s": 8,
          "text": "תלוי' בתנאי המקום,"
        },
        {
          "s": 9,
          "text": "ולכן דוקא בבית המקדש שהי' בו אלקות בגילוי,"
        },
        {
          "s": 10,
          "text": "ועד שהגילוי שבביהמ\"ק הי' בהתלבשות69"
        },
        {
          "s": 11,
          "text": "באבנים של הבית"
        },
        {
          "s": 12,
          "text": "(ועד\"ז במשכן),"
        },
        {
          "s": 13,
          "text": "הי' אפשר להמשיך בחינה זו."
        },
        {
          "s": 14,
          "text": "ולכן במקדש היו תוקעין גם בראש השנה שחל בשבת,"
        },
        {
          "s": 15,
          "text": "כי בחינה זו"
        },
        {
          "s": 16,
          "text": "(מקור התענוגים)"
        },
        {
          "s": 17,
          "text": "היא נעלית יותר מבחינת שבת,"
        },
        {
          "s": 18,
          "text": "ואפילו מבחינת שבת כמו שהי' במקדש ובראש השנה."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וכמו שהי' בבית המקדש,"
        },
        {
          "s": 2,
          "text": "עד\"ז הוא גם בתורה."
        },
        {
          "s": 3,
          "text": "דמיום שחרב ביהמ\"ק אין לו להקב\"ה בעולמו אלא ארבע אמות של הלכה בלבד70."
        },
        {
          "s": 4,
          "text": "ולכן אומרים פסוקי שופרות גם בראש השנה שחל בשבת גם בחו\"ל,"
        },
        {
          "s": 5,
          "text": "דכיון שתורה היא בחינת מקדש"
        },
        {
          "s": 6,
          "text": "(ואדם התוקע והשומע71"
        },
        {
          "s": 7,
          "text": "הרי אין לך בן חורין אלא מי שעוסק בתורה72"
        },
        {
          "s": 8,
          "text": "(דע\"י עסק התורה כדבעי נעשה ענין החירות בדוגמת שהי' בזמן שביהמ\"ק הי' קיים)),"
        },
        {
          "s": 9,
          "text": "לכן ע\"י אמירת פסוקי שופרות דתורה עושים"
        },
        {
          "s": 10,
          "text": "(דוגמת)"
        },
        {
          "s": 11,
          "text": "אותו הענין שהי' נעשה ע\"י תקיעת שופר במקדש."
        },
        {
          "s": 12,
          "text": "וזה נעשה בשמחה גדולה,"
        },
        {
          "s": 13,
          "text": "כמבואר בהמשך יו\"ט של ראש השנה שחל להיות בשבת לכ\"ק מו\"ח אדמו\"ר73"
        },
        {
          "s": 14,
          "text": "שהכתרת המלך היא בשמחה גדולה."
        },
        {
          "s": 15,
          "text": "ובחינת התענוג שממשיכים ע\"י תקיעת שופר במקדש,"
        },
        {
          "s": 16,
          "text": "ועד\"ז ע\"י פסוקי שופרות"
        },
        {
          "s": 17,
          "text": "(גם בחו\"ל),"
        },
        {
          "s": 18,
          "text": "היא בחינת תענוג הפשוט,"
        },
        {
          "s": 19,
          "text": "ע\"ד המבואר בארוכה בהמשך יו\"ט של ראש השנה שחל להיות בשבת לכ\"ק אדמו\"ר"
        },
        {
          "s": 20,
          "text": "(מהורש\"ב)74"
        },
        {
          "s": 21,
          "text": "בענין התענוג שהוא דוגמת בחינת יום שכולו שבת ומנוחה לחיי העולמים75."
        },
        {
          "s": 22,
          "text": "ומכיון דכל מה שלמעלה הכל הוא ממך"
        },
        {
          "s": 23,
          "text": "(כנ\"ל מתורת הה\"מ),"
        },
        {
          "s": 24,
          "text": "לכן בכחו של כל אחד מישראל לעשות לא רק כל הענינים דהשתלשלות"
        },
        {
          "s": 25,
          "text": "(גם ענינים הכי נעלים),"
        },
        {
          "s": 26,
          "text": "אלא שבכחו לעשות גם התענוג הפשוט,"
        },
        {
          "s": 27,
          "text": "ושזה יומשך גם למטה,"
        },
        {
          "s": 28,
          "text": "מלוך על העולם כולו בכבודך כו' ועד שידע כל פעול כי אתה פעלתו,"
        },
        {
          "s": 29,
          "text": "ועאכו\"כ שיהי' מלך ישראל"
        },
        {
          "s": 30,
          "text": "(כולל)"
        },
        {
          "s": 31,
          "text": "וגואלו,"
        },
        {
          "s": 32,
          "text": "בגאולה האמיתית והשלימה ע\"י משיח צדקנו,"
        },
        {
          "s": 33,
          "text": "שאז יתקעו גם ביו\"ט של ראש השנה שחל להיות בשבת בביהמ\"ק וביבנה76"
        },
        {
          "s": 34,
          "text": "וי\"ל דגם בכל מקום ומקום"
        },
        {
          "s": 35,
          "text": "(כי אז יתבטלו כל הענינים דגזירות),"
        },
        {
          "s": 36,
          "text": "במהרה בימינו ממש ובשמחה גדולה."
        }
      ]
    }
  ]
}