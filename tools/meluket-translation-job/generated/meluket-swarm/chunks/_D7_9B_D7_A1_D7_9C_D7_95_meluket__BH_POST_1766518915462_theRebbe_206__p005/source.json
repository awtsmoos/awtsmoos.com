  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915462_theRebbe_206__p005",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915462_theRebbe_206",
  "title": "מאמר א\"ר אושעיא תשל\"ט",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "וזהו צדקה כו' שפיזרן לבין האומות,"
        },
        {
          "s": 1,
          "text": "שע\"י מעשינו ועבודתנו בזמן הגלות"
        },
        {
          "s": 2,
          "text": "(בג' הקוין דתורה עבודה וגמ\"ח ובפרט בהפצת המעינות חוצה)"
        },
        {
          "s": 3,
          "text": "שבכל יום ויום,"
        },
        {
          "s": 4,
          "text": "הנה נוסף על זה שבכל יום ויום"
        },
        {
          "s": 5,
          "text": "(כשנמצאים עדיין בגלות)"
        },
        {
          "s": 6,
          "text": "נעשה הפדי' ברוחניות"
        },
        {
          "s": 7,
          "text": "(כאילו פדאני),"
        },
        {
          "s": 8,
          "text": "הנה כל פעולה ופעולה בהנ\"ל מצטרפת לחשבון גדול של הצדקה64"
        },
        {
          "s": 9,
          "text": "שמקרבת את הגאולה65"
        },
        {
          "s": 10,
          "text": "כפשוטה בגשמיות,"
        },
        {
          "s": 11,
          "text": "שאז יהי' פרזות תשב ירושלים גם בגשמיות,"
        },
        {
          "s": 12,
          "text": "בביאת משיח צדקנו,"
        },
        {
          "s": 13,
          "text": "בקרוב ממש."
        }
      ]
    }
  ]
}