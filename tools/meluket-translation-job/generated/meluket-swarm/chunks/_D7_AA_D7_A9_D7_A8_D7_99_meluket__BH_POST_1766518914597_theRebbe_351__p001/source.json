{
  "globalIndex": 154,
  "owner": 4,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914597_theRebbe_351__p001",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914597_theRebbe_351__p001",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914597_theRebbe_351",
  "title": "מאמר אלה תולדות נח תנש\"א",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ בראשית"
        },
        {
          "s": 2,
          "text": "(התוועדות ב'),"
        },
        {
          "s": 3,
          "text": "ה'תנש\"א"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "אלה תולדות נח נח גו'1,"
        },
        {
          "s": 1,
          "text": "ומבאר הצמח צדק במאמרו ד\"ה זה2,"
        },
        {
          "s": 2,
          "text": "דמ\"ש נח נח שתי פעמים הוא,"
        },
        {
          "s": 3,
          "text": "כי נח הוא בחינת שבת"
        },
        {
          "s": 4,
          "text": "(כדלקמן),"
        },
        {
          "s": 5,
          "text": "ובשבת יש שתי בחינות,"
        },
        {
          "s": 6,
          "text": "כמאמר רז\"ל3"
        },
        {
          "s": 7,
          "text": "אלמלי משמרין ישראל שתי שבתות כהלכתן מיד נגאלים,"
        },
        {
          "s": 8,
          "text": "וידוע4,"
        },
        {
          "s": 9,
          "text": "דפירוש שתי שבתות הוא5"
        },
        {
          "s": 10,
          "text": "שתי השבתות שישנם בכל שבת6,"
        },
        {
          "s": 11,
          "text": "מעלי דשבתא ויומא דשבתא."
        },
        {
          "s": 12,
          "text": "ולכן נאמר נח נח ב' פעמים,"
        },
        {
          "s": 13,
          "text": "כנגד7"
        },
        {
          "s": 14,
          "text": "שתי השבתות שבכל שבת,"
        },
        {
          "s": 15,
          "text": "מעלי דשבתא ויומא דשבתא."
        },
        {
          "s": 16,
          "text": "ומוסיף בהמאמר2,"
        },
        {
          "s": 17,
          "text": "דפירוש זה שנח הוא שבת הוא ע\"פ דאיתא במדרש8"
        },
        {
          "s": 18,
          "text": "דנח נח שתי פעמים הוא נייחא לו ונייחא לעולם,"
        },
        {
          "s": 19,
          "text": "נייחא לאבות ונייחא לבנים,"
        },
        {
          "s": 20,
          "text": "נייחא לעליונים ונייחא לתחתונים,"
        },
        {
          "s": 21,
          "text": "נייחא בעוה\"ז ונייחא לעוה\"ב."
        },
        {
          "s": 22,
          "text": "ומאמר זה"
        },
        {
          "s": 23,
          "text": "(דהמדרש)"
        },
        {
          "s": 24,
          "text": "שנח הוא לשון נייחא כולל גם הפירוש שנח הוא בחינת שבת,"
        },
        {
          "s": 25,
          "text": "כי בשבת כתיב9"
        },
        {
          "s": 26,
          "text": "וינח ביום השביעי."
        },
        {
          "s": 27,
          "text": "ונח נח שתי פעמים הם שבת תתאה ושבת עילאה,"
        },
        {
          "s": 28,
          "text": "שהם6"
        },
        {
          "s": 29,
          "text": "מעלי דשבתא ויומא דשבתא."
        },
        {
          "s": 30,
          "text": "ויש לומר,"
        },
        {
          "s": 31,
          "text": "דמהטעמים על זה שמבאר עוד פעם"
        },
        {
          "s": 32,
          "text": "(לאחרי שמביא ראי' מהמדרש שנח הוא בחינת שבת)"
        },
        {
          "s": 33,
          "text": "שנח נח הם מעלי דשבתא ויומא דשבתא,"
        },
        {
          "s": 34,
          "text": "הוא,"
        },
        {
          "s": 35,
          "text": "בכדי לרמז,"
        },
        {
          "s": 36,
          "text": "שהשייכות דהפירוש שבהמאמר עם הפירוש שבמדרש הוא בנוגע לנח"
        },
        {
          "s": 37,
          "text": "[דמזה שנח הוא לשון נייחא מוכח שנח הוא בחינת שבת]"
        },
        {
          "s": 38,
          "text": "ובנוגע לנח נח שתי פעמים."
        },
        {
          "s": 39,
          "text": "דהפירוש"
        },
        {
          "s": 40,
          "text": "(שבהמאמר)"
        },
        {
          "s": 41,
          "text": "שנח נח הם שבת תתאה"
        },
        {
          "s": 42,
          "text": "[מעלי דשבתא]"
        },
        {
          "s": 43,
          "text": "ושבת עילאה"
        },
        {
          "s": 44,
          "text": "[יומא דשבתא]"
        },
        {
          "s": 45,
          "text": "הוא ע\"ד פירוש המדרש שנח נח הם נייחא לעליונים ונייחא לתחתונים10."
        },
        {
          "s": 46,
          "text": "והענין הוא,"
        },
        {
          "s": 47,
          "text": "שמעלי דשבתא"
        },
        {
          "s": 48,
          "text": "(עלית המלכות)"
        },
        {
          "s": 49,
          "text": "בעבודת האדם הוא בירור והעלאת הגוף ונה\"ב11,"
        },
        {
          "s": 50,
          "text": "תחתון שבאדם12,"
        },
        {
          "s": 51,
          "text": "ויומא דשבתא"
        },
        {
          "s": 52,
          "text": "(המשכת ז\"א)"
        },
        {
          "s": 53,
          "text": "הוא המשכת הגילוי דנפש האלקית11,"
        },
        {
          "s": 54,
          "text": "עליון שבאדם12."
        },
        {
          "s": 55,
          "text": "ועל ידי שישראל שומרים שתי השבתות,"
        },
        {
          "s": 56,
          "text": "שעי\"ז נעשה המנוחה"
        },
        {
          "s": 57,
          "text": "(מהענינים המבלבלים מעבודת ה')"
        },
        {
          "s": 58,
          "text": "הן בהתחתון שבאדם והן בהעליון שבאדם,"
        },
        {
          "s": 59,
          "text": "עי\"ז נמשך גילוי המנוחה מלמעלה בכל העולמות,"
        },
        {
          "s": 60,
          "text": "בעליונים ובתחתונים,"
        },
        {
          "s": 61,
          "text": "נייחא לעליונים ונייחא לתחתונים13."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "וביאור הענין בפרטיות יותר,"
        },
        {
          "s": 2,
          "text": "יובן בהקדים המבואר בכ\"מ14"
        },
        {
          "s": 3,
          "text": "[וגם במאמר הנ\"ל דהצ\"צ15]"
        },
        {
          "s": 4,
          "text": "דשתי השבתות שישנם בכל שבת שייך לזה שכל עיסקא דשבתא כפול16."
        },
        {
          "s": 5,
          "text": "וזהו אלמלי משמרין ישראל שתי שבתות כהלכתן מיד נגאלים,"
        },
        {
          "s": 6,
          "text": "כי כפל שייך לגאולה17."
        },
        {
          "s": 7,
          "text": "ויש לומר,"
        },
        {
          "s": 8,
          "text": "דבדרז\"ל כל עיסקא דשבתא כפול נכלל גם שכל אחד משתי השבתות הוא כפול,"
        },
        {
          "s": 9,
          "text": "היינו שכל אחד מהם כלול משניהם."
        },
        {
          "s": 10,
          "text": "והענין הוא,"
        },
        {
          "s": 11,
          "text": "דאהבה ויראה הם"
        },
        {
          "s": 12,
          "text": "(בכללות)"
        },
        {
          "s": 13,
          "text": "העבודה שמצד הנשמה"
        },
        {
          "s": 14,
          "text": "(יומא דשבתא)"
        },
        {
          "s": 15,
          "text": "וקיום מצוות מעשיות היא העבודה שמצד הגוף"
        },
        {
          "s": 16,
          "text": "(מעלי דשבתא)."
        },
        {
          "s": 17,
          "text": "וענין עיסקא דשבתא כפול הוא,"
        },
        {
          "s": 18,
          "text": "שאהבת ה' שמצד הנשמה"
        },
        {
          "s": 19,
          "text": "(עליון שבאדם)"
        },
        {
          "s": 20,
          "text": "תומשך בנפש הבהמית ובהגוף"
        },
        {
          "s": 21,
          "text": "(תחתון שבאדם),"
        },
        {
          "s": 22,
          "text": "וכמ\"ש18"
        },
        {
          "s": 23,
          "text": "ואהבת את הוי' אלקיך בכל לבבך"
        },
        {
          "s": 24,
          "text": "(בשני ביתי\"ן),"
        },
        {
          "s": 25,
          "text": "שהאהבה תהי' בחלל הימני מקום משכן נפש האלקית ובחלל השמאלי מקום משכן נפש הבהמית,"
        },
        {
          "s": 26,
          "text": "כמארז\"ל19"
        },
        {
          "s": 27,
          "text": "בכל לבבך בשני יצריך20."
        },
        {
          "s": 28,
          "text": "ויתירה מזו – בכל נפשך,"
        },
        {
          "s": 29,
          "text": "שהאהבה מתפשטת בכל הכחות והאברים"
        },
        {
          "s": 30,
          "text": "(וי\"ל שהוא כמו הרץ21"
        },
        {
          "s": 31,
          "text": "לדבר מצוה)22,"
        },
        {
          "s": 32,
          "text": "ויתירה מזו – בכל מאדך,"
        },
        {
          "s": 33,
          "text": "שאהבתו את הוי' נמשכת וניכרת גם בחלקו בעולם"
        },
        {
          "s": 34,
          "text": "(בכל מאדך בכל ממונך23),"
        },
        {
          "s": 35,
          "text": "וסיום הפרשה הוא24"
        },
        {
          "s": 36,
          "text": "וכתבתם על מזוזות ביתך ובשעריך,"
        },
        {
          "s": 37,
          "text": "שע\"י המזוזה שקובע בפתח ביתו ניכר25"
        },
        {
          "s": 38,
          "text": "שה' אחד הוא המושל והוא השומר את הבית ואת כל אשר בתוכו26,"
        },
        {
          "s": 39,
          "text": "ושומר את האדם גם בצאתו מביתו,"
        },
        {
          "s": 40,
          "text": "ה' ישמר צאתך ובואך מעתה ועד עולם27."
        },
        {
          "s": 41,
          "text": "ועד\"ז הוא לאידך,"
        },
        {
          "s": 42,
          "text": "שקיום המצוות מעשיות"
        },
        {
          "s": 43,
          "text": "(עבודה שמצד הגוף)"
        },
        {
          "s": 44,
          "text": "צ\"ל באהבה ויראה"
        },
        {
          "s": 45,
          "text": "(עבודה שמצד הנשמה)."
        }
      ]
    }
  ]
}