{
  "globalIndex": 802,
  "owner": 2,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918574_theRebbe_925__p003",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918574_theRebbe_925__p003",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918574_theRebbe_925",
  "title": "מאמר פתח רבי שמעון תשל\"ד",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "וע\"פ הידוע44"
        },
        {
          "s": 1,
          "text": "דתורה ומצוות הם"
        },
        {
          "s": 2,
          "text": "(דוגמת)"
        },
        {
          "s": 3,
          "text": "אורות וכלים,"
        },
        {
          "s": 4,
          "text": "יש לומר,"
        },
        {
          "s": 5,
          "text": "שגם החיבור שע\"י עסק התורה"
        },
        {
          "s": 6,
          "text": "(כמו שהתורה היא בבחינת התפשטות וגילוי45)"
        },
        {
          "s": 7,
          "text": "הוא בכלל ענין הדביקות46,"
        },
        {
          "s": 8,
          "text": "וענין ההתקשרות שע\"י עסק התורה"
        },
        {
          "s": 9,
          "text": "[דישראל מתקשרין באורייתא ואורייתא בקוב\"ה],"
        },
        {
          "s": 10,
          "text": "הוא מצד עצם התורה שלמעלה מהתפשטות וגילוי."
        },
        {
          "s": 11,
          "text": "ויובן זה ע\"פ הידוע47"
        },
        {
          "s": 12,
          "text": "שבההתקשרות דישראל אורייתא וקוב\"ה שני אופנים."
        },
        {
          "s": 13,
          "text": "שמצד התורה כמו שנמשכה בהשתלשלות,"
        },
        {
          "s": 14,
          "text": "מכיון שהסדר דהשתלשלות הוא שהחיצוניות שבעליון נעשה פנימיות להתחתון,"
        },
        {
          "s": 15,
          "text": "אופן ההתקשרות דישראל באורייתא הוא שהסתים"
        },
        {
          "s": 16,
          "text": "(הפנימיות)"
        },
        {
          "s": 17,
          "text": "דישראל מתקשר בגליא"
        },
        {
          "s": 18,
          "text": "(חיצוניות)"
        },
        {
          "s": 19,
          "text": "דאורייתא,"
        },
        {
          "s": 20,
          "text": "וכמו\"כ הוא בההתקשרות דאורייתא בקוב\"ה,"
        },
        {
          "s": 21,
          "text": "שהסתים והפנימיות דאורייתא מתקשר בגליא דקוב\"ה."
        },
        {
          "s": 22,
          "text": "ובאופן זה,"
        },
        {
          "s": 23,
          "text": "ההתקשרות של גליא דישראל עם סתים דקוב\"ה היא ע\"י כמה ממוצעים"
        },
        {
          "s": 24,
          "text": "(סתים דישראל,"
        },
        {
          "s": 25,
          "text": "גליא דאורייתא,"
        },
        {
          "s": 26,
          "text": "סתים דאורייתא וגליא דקוב\"ה)."
        },
        {
          "s": 27,
          "text": "אבל מצד עצם התורה,"
        },
        {
          "s": 28,
          "text": "כמו שהיא למעלה מהשתלשלות,"
        },
        {
          "s": 29,
          "text": "ההתקשרות דישראל בקוב\"ה היא שגם הגליא דישראל מתקשר בהסתים דקוב\"ה בלי ממוצעים."
        },
        {
          "s": 30,
          "text": "וגם כשלומד גליא דתורה בהבנה והשגה שלו הוא מקושר"
        },
        {
          "s": 31,
          "text": "(גם הגליא דנשמתו,"
        },
        {
          "s": 32,
          "text": "עד לההבנה וההשגה שלו)"
        },
        {
          "s": 33,
          "text": "גם עם סתים דאורייתא,"
        },
        {
          "s": 34,
          "text": "ועל ידה – עם סתים דקוב\"ה."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "שההתקשרות דישראל ואורייתא שמצד דרגת התורה כמו שנמשכה בהשתלשלות,"
        },
        {
          "s": 2,
          "text": "נכללת בענין הדביקות שהיא בחיצוניות."
        },
        {
          "s": 3,
          "text": "כי ההתקשרות דישראל באורייתא"
        },
        {
          "s": 4,
          "text": "(שמצד דרגא זו)"
        },
        {
          "s": 5,
          "text": "היא בהחיצוניות"
        },
        {
          "s": 6,
          "text": "(גליא)"
        },
        {
          "s": 7,
          "text": "דאורייתא,"
        },
        {
          "s": 8,
          "text": "ויתירה מזו,"
        },
        {
          "s": 9,
          "text": "גם הפנימיות שבבחינה זו היא כמו שנמשכה בהשתלשלות להיות ממוצע."
        },
        {
          "s": 10,
          "text": "והלשון תלת קשרין אינון מתקשרן דא בדא הוא"
        },
        {
          "s": 11,
          "text": "(בעיקר48)"
        },
        {
          "s": 12,
          "text": "בההתקשרות שמצד עצם התורה שלמעלה מהשתלשלות49,"
        },
        {
          "s": 13,
          "text": "דהתקשרות זו היא בסתים דאורייתא ובסתים דקוב\"ה,"
        },
        {
          "s": 14,
          "text": "פנימיות."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה גם בההתקשרות שמצד עצם התורה,"
        },
        {
          "s": 2,
          "text": "ישראל ואורייתא וכן אורייתא וקוב\"ה הם כמו שני דברים אלא שמתקשרים זה בזה."
        },
        {
          "s": 3,
          "text": "משא\"כ זה שישראל אורייתא וקוב\"ה כולא חד,"
        },
        {
          "s": 4,
          "text": "הוא למעלה מההתקשרות דישראל אורייתא וקוב\"ה כמו שהיא מצד עצם התורה שלמעלה מהשתלשלות."
        },
        {
          "s": 5,
          "text": "ויובן זה בהקדים הדיוק במה שאמרו תלת קשרין אינון מתקשרן דא בדא,"
        },
        {
          "s": 6,
          "text": "דלכאורה ישנם רק ב' קשרין,"
        },
        {
          "s": 7,
          "text": "שישראל מתקשרין באורייתא ואורייתא בקוב\"ה."
        },
        {
          "s": 8,
          "text": "ואחד הביאורים בזה50,"
        },
        {
          "s": 9,
          "text": "דקשר השלישי הוא הקשר דישראל וקוב\"ה שלא ע\"י אמצעות התורה,"
        },
        {
          "s": 10,
          "text": "מצד שהשרש דישראל הוא בהעצמות,"
        },
        {
          "s": 11,
          "text": "שלמעלה51"
        },
        {
          "s": 12,
          "text": "מהשרש דתורה."
        },
        {
          "s": 13,
          "text": "והסדר דג' קשרים אלו הם כמו טבעת"
        },
        {
          "s": 14,
          "text": "(עיגול)"
        },
        {
          "s": 15,
          "text": "שאין בו ראש וסוף."
        },
        {
          "s": 16,
          "text": "שבתחלה ישראל מתקשרין באורייתא ואורייתא בקוב\"ה ולאח\"ז הקשר דקוב\"ה וישראל,"
        },
        {
          "s": 17,
          "text": "דיש לומר שלאחרי שישראל מתקשרין באורייתא ועל ידה בקוב\"ה,"
        },
        {
          "s": 18,
          "text": "מתגלה השרש דישראל שלמעלה מהשרש דתורה,"
        },
        {
          "s": 19,
          "text": "הקשר דישראל וקוב\"ה."
        },
        {
          "s": 20,
          "text": "ולאחרי שנעשה קשר זה"
        },
        {
          "s": 21,
          "text": "(דישראל וקוב\"ה),"
        },
        {
          "s": 22,
          "text": "אזי בתחלה הוא הקשר דישראל וקוב\"ה,"
        },
        {
          "s": 23,
          "text": "ולאחרי שנתגלה השרש דישראל בעצמותו ית',"
        },
        {
          "s": 24,
          "text": "הם ממשיכים זה גם בתורה,"
        },
        {
          "s": 25,
          "text": "ע\"ד דוד הי' מחבר תורה שלמעלה בקוב\"ה52."
        },
        {
          "s": 26,
          "text": "דנוסף לזה שהתורה היא חכמתו של הקב\"ה,"
        },
        {
          "s": 27,
          "text": "דהחכמה היא באין ערוך לגבי עצמות אוא\"ס וישראל ממשיכים בה עצמות אוא\"ס53,"
        },
        {
          "s": 28,
          "text": "הנה כיון שגם בהשרש דתורה וישראל כמו שהם בהעצמות,"
        },
        {
          "s": 29,
          "text": "השרש דישראל הוא למעלה מהשרש דתורה,"
        },
        {
          "s": 30,
          "text": "לכן על ידי עסק התורה דישראל נמשך בה מהעצמות ממש."
        }
      ]
    }
  ]
}