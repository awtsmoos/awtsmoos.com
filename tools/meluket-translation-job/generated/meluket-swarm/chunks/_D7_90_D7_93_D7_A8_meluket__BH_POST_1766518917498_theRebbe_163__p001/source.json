{
  "globalIndex": 643,
  "owner": 43,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917498_theRebbe_163__p001",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917498_theRebbe_163__p001",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917498_theRebbe_163",
  "title": "מאמר בלילה ההוא תשד\"מ",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "פורים ה'תשד\"מ*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "בלילה ההוא נדדה שנת המלך1,"
        },
        {
          "s": 1,
          "text": "ומביא כ\"ק מו\"ח אדמו\"ר במאמרו ד\"ה זה2,"
        },
        {
          "s": 2,
          "text": "דאיתא במנהגי מהרי\"ל3"
        },
        {
          "s": 3,
          "text": "דמבלילה ההוא צריכים להגבי' את קולו בקריאתו לפי שזהו עיקר הנס"
        },
        {
          "s": 4,
          "text": "[דמבלילה ההוא הוא התחלת תוקפו של נס4]."
        },
        {
          "s": 5,
          "text": "ומדייק בזה,"
        },
        {
          "s": 6,
          "text": "דלכאורה עיקר הנס הוא בקשת אסתר ותחנוני' כי נמכרנו אני ועמי גו'5"
        },
        {
          "s": 7,
          "text": "[וכן ההכנות שעשתה לפנ\"ז,"
        },
        {
          "s": 8,
          "text": "לך כנוס את כל היהודים גו' וצומו עלי גו'6],"
        },
        {
          "s": 9,
          "text": "וכאן אומר דעיקר ותוקף הנס הוא מה שנדדה שנת המלך."
        },
        {
          "s": 10,
          "text": "ומביא על זה,"
        },
        {
          "s": 11,
          "text": "דאיתא בילקוט7,"
        },
        {
          "s": 12,
          "text": "בלילה ההוא נדדה שנת המלך זה מלכו של עולם,"
        },
        {
          "s": 13,
          "text": "וכי שינה יש לפניו,"
        },
        {
          "s": 14,
          "text": "אלא כשישראל חוטאין עושה עצמו כישן8"
        },
        {
          "s": 15,
          "text": "וכשעושים רצונו לא9"
        },
        {
          "s": 16,
          "text": "ינום ולא יישן."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "והענין הוא,"
        },
        {
          "s": 1,
          "text": "דהנה אדם הוא אדמה לעליון10,"
        },
        {
          "s": 2,
          "text": "ולכן כל הענינים שלמעלה הם באותו האופן כפי שהם באדם"
        },
        {
          "s": 3,
          "text": "(אתם קרויים אדם11),"
        },
        {
          "s": 4,
          "text": "לעילא כגוונא דלתתא12,"
        },
        {
          "s": 5,
          "text": "ובלשון הכתוב13"
        },
        {
          "s": 6,
          "text": "כמים הפנים לפנים כן לב האדם לאדם,"
        },
        {
          "s": 7,
          "text": "ולכן,"
        },
        {
          "s": 8,
          "text": "כאשר ישראל הם במצב של שינה,"
        },
        {
          "s": 9,
          "text": "היינו שהענינים דתומ\"צ"
        },
        {
          "s": 10,
          "text": "(שעי\"ז הם אדמה לעליון)"
        },
        {
          "s": 11,
          "text": "הם אצלם במצב של שינה,"
        },
        {
          "s": 12,
          "text": "עי\"ז נעשה שינה כביכול גם במלכו של עולם."
        },
        {
          "s": 13,
          "text": "וכמ\"ש14"
        },
        {
          "s": 14,
          "text": "אני ישנה ואיתא בזהר15"
        },
        {
          "s": 15,
          "text": "בגלותא,"
        },
        {
          "s": 16,
          "text": "שמצד השינה דישראל בזמן הגלות,"
        },
        {
          "s": 17,
          "text": "נעשה עי\"ז שינה כביכול גם למעלה."
        },
        {
          "s": 18,
          "text": "וזהו שבלילה ההוא נדדה שנת המלך הוא תוקפו של נס,"
        },
        {
          "s": 19,
          "text": "כי ע\"פ סדר ההשתלשלות,"
        },
        {
          "s": 20,
          "text": "זמן הגלות הוא זמן של שינה"
        },
        {
          "s": 21,
          "text": "(למעלה),"
        },
        {
          "s": 22,
          "text": "וזה שבלילה ההוא"
        },
        {
          "s": 23,
          "text": "(גלות16)"
        },
        {
          "s": 24,
          "text": "נדדה שנת המלך מלכו של עולם הוא תוקפו של נס17."
        },
        {
          "s": 25,
          "text": "וזהו גם דיוק הלשון נדדה שנת המלך"
        },
        {
          "s": 26,
          "text": "(נדדה דייקא),"
        },
        {
          "s": 27,
          "text": "דלשון נדדה שנת המלך"
        },
        {
          "s": 28,
          "text": "(שהשינה נדדה מהמלך)"
        },
        {
          "s": 29,
          "text": "מורה שהי' ראוי שהשינה תהי' בהמלך"
        },
        {
          "s": 30,
          "text": "[בדוגמת שאומרים על אדם שנדד ממקומו],"
        },
        {
          "s": 31,
          "text": "כי זמן הגלות הוא זמן של שינה"
        },
        {
          "s": 32,
          "text": "(כנ\"ל),"
        },
        {
          "s": 33,
          "text": "אלא שהי' נס שהשינה נדדה ממנו."
        }
      ]
    }
  ]
}