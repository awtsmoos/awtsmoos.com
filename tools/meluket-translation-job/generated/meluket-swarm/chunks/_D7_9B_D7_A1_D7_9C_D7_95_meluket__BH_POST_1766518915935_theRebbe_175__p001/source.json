{
  "globalIndex": 381,
  "owner": 31,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915935_theRebbe_175__p001",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915935_theRebbe_175__p001",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915935_theRebbe_175",
  "title": "מאמר ואתה ברחמיך הרבים תשמ\"ח",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ מקץ,"
        },
        {
          "s": 2,
          "text": "שבת חנוכה ה'תשמ\"ח*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "ואתה ברחמיך הרבים עמדת להם בעת צרתם כו' מסרת גבורים ביד חלשים ורבים ביד מעטים כו'1,"
        },
        {
          "s": 1,
          "text": "ומדייק כ\"ק מו\"ח אדמו\"ר במאמרו ד\"ה זה"
        },
        {
          "s": 2,
          "text": "(שנאמר לפני חמישים שנה2),"
        },
        {
          "s": 3,
          "text": "הרי עיקר הנס"
        },
        {
          "s": 4,
          "text": "(דחנוכה)"
        },
        {
          "s": 5,
          "text": "הוא הנס דנצחון המלחמה שהי' בכ\"ד בכסלו3,"
        },
        {
          "s": 6,
          "text": "ועד שזה הי' גם הסיבה להנס דפך השמן שהי' בכ\"ה בכסלו,"
        },
        {
          "s": 7,
          "text": "[כדאיתא בגמרא4"
        },
        {
          "s": 8,
          "text": "וכשגברו בית חשמונאי ונצחום"
        },
        {
          "s": 9,
          "text": "(אז דוקא)"
        },
        {
          "s": 10,
          "text": "מצאו פך אחד של שמן כו' נעשה בו נס והדליקו ממנו שמונה ימים],"
        },
        {
          "s": 11,
          "text": "ולמה קבעו התחלת ימי חנוכה בכ\"ה בכסלו שבו הי' נס הנרות ולא בכ\"ד בכסלו."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דזה שמדייק בהמאמר הטעם על שקבעו חנוכה בכ\"ה בכסלו ולא בכ\"ד בכסלו,"
        },
        {
          "s": 2,
          "text": "ודלא כהדיוק בכמה דרושים5"
        },
        {
          "s": 3,
          "text": "(כולל גם דרושים שהתחלתם היא בד\"ה זה)"
        },
        {
          "s": 4,
          "text": "מדוע קבעו חנוכה על הנס דפך השמן ולא על הנס דנצחון המלחמה,"
        },
        {
          "s": 5,
          "text": "הוא,"
        },
        {
          "s": 6,
          "text": "כי בדרושים הנ\"ל קאי להשיטה6"
        },
        {
          "s": 7,
          "text": "שהיו\"ט דחנוכה נקבע"
        },
        {
          "s": 8,
          "text": "(רק)"
        },
        {
          "s": 9,
          "text": "על נס הנרות7,"
        },
        {
          "s": 10,
          "text": "ולכן מדייק שלכאורה העיקר הוא נצחון המלחמה,"
        },
        {
          "s": 11,
          "text": "ולמה עשו מהטפל עיקר ומהעיקר טפל8."
        },
        {
          "s": 12,
          "text": "ובמאמר זה קאי להשיטה6"
        },
        {
          "s": 13,
          "text": "שקביעת היו\"ט דחנוכה היא גם מצד הנס דנצחון המלחמה9,"
        },
        {
          "s": 14,
          "text": "ועד שההודאה דועל הנסים היא"
        },
        {
          "s": 15,
          "text": "(בעיקר10)"
        },
        {
          "s": 16,
          "text": "על נס זה"
        },
        {
          "s": 17,
          "text": "[וההודאה על הנס דפך השמן היא על ידי הדלקת נר חנוכה],"
        },
        {
          "s": 18,
          "text": "ולכן הדיוק במאמר זה הוא זה שימי חנוכה"
        },
        {
          "s": 19,
          "text": "[שנקבעו גם על הנס דנצחון המלחמה,"
        },
        {
          "s": 20,
          "text": "ואדרבא,"
        },
        {
          "s": 21,
          "text": "ענין זה הוא"
        },
        {
          "s": 22,
          "text": "(לכאורה)"
        },
        {
          "s": 23,
          "text": "עיקר הנס,"
        },
        {
          "s": 24,
          "text": "ועד שזה הי' גם הסיבה להנס דפך השמן]"
        },
        {
          "s": 25,
          "text": "מתחילים בכ\"ה בכסלו שבו הי' נס הנרות ולא בכ\"ד בכסלו11."
        }
      ]
    }
  ]
}