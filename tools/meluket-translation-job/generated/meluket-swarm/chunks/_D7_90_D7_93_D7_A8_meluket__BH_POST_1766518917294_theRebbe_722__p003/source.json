{
  "globalIndex": 611,
  "owner": 11,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917294_theRebbe_722__p003",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917294_theRebbe_722__p003",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917294_theRebbe_722",
  "title": "מאמר כי תשא תשכ\"ח",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "וע\"ז ממשיך בהפסוק,"
        },
        {
          "s": 1,
          "text": "דודי שלח ידו מן החור,"
        },
        {
          "s": 2,
          "text": "והיינו שהגם דרוה\"ק משיבה בשם הקב\"ה רחצתי את רגלי איככה גו',"
        },
        {
          "s": 3,
          "text": "אבל מצד הענין דדודי שלח ידו,"
        },
        {
          "s": 4,
          "text": "אשר דודי הו\"ע האהבה עצמית של הקב\"ה לנשמות ישראל"
        },
        {
          "s": 5,
          "text": "(וכמו שמבאר אדמו\"ר הזקן בהמאמר על הפסוק קמתי אני לפתוח לדודי,"
        },
        {
          "s": 6,
          "text": "ונתבאר בשיחת כ\"ק אדמו\"ר"
        },
        {
          "s": 7,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 8,
          "text": "נ\"ע27),"
        },
        {
          "s": 9,
          "text": "ומצד האהבה עצמית,"
        },
        {
          "s": 10,
          "text": "הנה שלח ידו מן החור,"
        },
        {
          "s": 11,
          "text": "דחור הוא גם מל' חור כרפס וכן מל' חרות28"
        },
        {
          "s": 12,
          "text": "ועי\"ז נעשה הפתחי לי,"
        },
        {
          "s": 13,
          "text": "ולאחר הפתחי לי הד' דרגות דאחותי רעיתי יונתי תמתי,"
        },
        {
          "s": 14,
          "text": "שאלו הן ד' מדריגות בין בהעבודה בענין האהבה,"
        },
        {
          "s": 15,
          "text": "דלית פולחנא כפולחנא דרחימותא29,"
        },
        {
          "s": 16,
          "text": "ובין בעבודה דקיום המצוות,"
        },
        {
          "s": 17,
          "text": "דד' מדריגות אלו הן כנגד ד' אותיות דשם הוי'30,"
        },
        {
          "s": 18,
          "text": "ועי\"ז הנה ליהודים היתה אורה ושמחה וששון ויקר31,"
        },
        {
          "s": 19,
          "text": "אשר בד\"א י\"ל שהד' ענינים דאורה ושמחה וגו' הם כנגד הד' אותיות דשם הוי',"
        },
        {
          "s": 20,
          "text": "דאורה זו תורה32"
        },
        {
          "s": 21,
          "text": "וכמ\"ש33"
        },
        {
          "s": 22,
          "text": "כי נר מצוה ותורה אור,"
        },
        {
          "s": 23,
          "text": "שזהו\"ע ספירת החכמה,"
        },
        {
          "s": 24,
          "text": "שמחה הו\"ע מועדים32"
        },
        {
          "s": 25,
          "text": "לשמחה,"
        },
        {
          "s": 26,
          "text": "שהו\"ע ספירת הבינה,"
        },
        {
          "s": 27,
          "text": "וששון זו מילה32"
        },
        {
          "s": 28,
          "text": "שזהו\"ע ספירת היסוד שהוא עיקר הז\"א,"
        },
        {
          "s": 29,
          "text": "ויקר אלו תפלין32"
        },
        {
          "s": 30,
          "text": "שהם בחי' המלכות וכמבואר בסוף דשערי אורה34"
        },
        {
          "s": 31,
          "text": "וכמו שהיא בשרשה בעצמות א\"ס ב\"ה,"
        },
        {
          "s": 32,
          "text": "שזהו מש\"כ בזהר חדש35"
        },
        {
          "s": 33,
          "text": "שתפלין הם דיוקנאה דחותמי' דמלכא עילאה,"
        },
        {
          "s": 34,
          "text": "דדיוקנא וחותם הו\"ע ספירת המלכות,"
        },
        {
          "s": 35,
          "text": "והיינו שע\"י הפתחי לי נמשך הד' אותיות דשם הוי' בעבודה,"
        },
        {
          "s": 36,
          "text": "וכן בהאורה ושמחה וגו'."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "וזהו ג\"כ מש\"כ ליהודים היתה אורה וגו' וכמ\"ש בגמרא36"
        },
        {
          "s": 1,
          "text": "דכל הכופר בע\"ז נק' יהודי,"
        },
        {
          "s": 2,
          "text": "והיינו שקודם ישנו ענין המס\"נ שבזה עמדו אז בימי הפורים,"
        },
        {
          "s": 3,
          "text": "וזהו\"ע הפתחו לי כחודה של מחט שהו\"ע המס\"נ,"
        },
        {
          "s": 4,
          "text": "ואח\"כ הן הד' מדרי' דאורה ושמחה וששון ויקר,"
        },
        {
          "s": 5,
          "text": "וזהו ג\"כ מש\"כ37"
        },
        {
          "s": 6,
          "text": "איש יהודי הי' בשושן הבירה ושמו מרדכי,"
        },
        {
          "s": 7,
          "text": "דמרדכי מן התורה מנין שנאמר38"
        },
        {
          "s": 8,
          "text": "מר דרור,"
        },
        {
          "s": 9,
          "text": "ומתרגמינן מירא דכיא39,"
        },
        {
          "s": 10,
          "text": "וכמבואר בתו\"א40,"
        },
        {
          "s": 11,
          "text": "ויהודי הו\"ע המס\"נ כנ\"ל,"
        },
        {
          "s": 12,
          "text": "דיהודי הוא מל' הודאה שלמעלה מטו\"ד,"
        },
        {
          "s": 13,
          "text": "וזה פעל בכולם את ענין המס\"נ שכולם נק' יהודיים דוקא וכבמרז\"ל שזהו היפך מצבם הקודם שהשתחוו לאנדרטי' כמסופר בגמרא41,"
        },
        {
          "s": 14,
          "text": "ואח\"כ נמשך ממס\"נ זה בהד' אותיות דשם הוי',"
        },
        {
          "s": 15,
          "text": "אורה ושמחה וששון וגו' ועד לאורה ושמחה וששון ויקר למטה מעשרה טפחים,"
        },
        {
          "s": 16,
          "text": "כפשוטו של מקרא."
        }
      ]
    }
  ]
}