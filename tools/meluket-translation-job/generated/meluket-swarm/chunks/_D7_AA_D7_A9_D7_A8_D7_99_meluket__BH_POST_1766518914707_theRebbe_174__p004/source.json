{
  "globalIndex": 165,
  "owner": 15,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914707_theRebbe_174__p004",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914707_theRebbe_174__p004",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914707_theRebbe_174",
  "title": "מאמר להבין ענין שמח\"ת תשמ\"ב",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וזהו מה שבשמע\"צ דוקא נאמר עצרת תהי' לכם"
        },
        {
          "s": 2,
          "text": "(אף שכל החגים ומועדים ניתנו לישראל דוקא),"
        },
        {
          "s": 3,
          "text": "דמכיון שבשמע\"צ היא הקליטה של כל ההמשכות דחודש תשרי,"
        },
        {
          "s": 4,
          "text": "ר\"ה יוהכ\"פ וכו',"
        },
        {
          "s": 5,
          "text": "ענין התשובה שמגיע"
        },
        {
          "s": 6,
          "text": "(כנ\"ל)"
        },
        {
          "s": 7,
          "text": "בבחינת העלם שאינו במציאות,"
        },
        {
          "s": 8,
          "text": "עד לבחינת העלם העצמי,"
        },
        {
          "s": 9,
          "text": "הנה ענין זה הוא לכם דוקא יהיו לך לבדך ואין לזרים אתך62,"
        },
        {
          "s": 10,
          "text": "ישראל ומלכא בלחודוהי63."
        },
        {
          "s": 11,
          "text": "וזהו גם הטעם לזה שקבעו שמח\"ת בשמע\"צ דוקא,"
        },
        {
          "s": 12,
          "text": "כי בשמע\"צ היא הקליטה של כל ההמשכות דחודש תשרי שנמשכים ע\"י התשובה,"
        },
        {
          "s": 13,
          "text": "כולל גם הענין דלוחות האחרונות שניתנו ביוהכ\"פ,"
        },
        {
          "s": 14,
          "text": "והשמחה דשמח\"ת היא על לוחות השניות כנ\"ל"
        },
        {
          "s": 15,
          "text": "(סעיף ה)."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "וזהו שהשמחה דשמח\"ת היא באותיות התורה"
        },
        {
          "s": 1,
          "text": "[וכנ\"ל"
        },
        {
          "s": 2,
          "text": "(בתחלת המאמר),"
        },
        {
          "s": 3,
          "text": "דאופן השמחה היא שמקיפים עם הס\"ת את שולחן הקריאה אשר שם קוראים"
        },
        {
          "s": 4,
          "text": "(בכל השנה)"
        },
        {
          "s": 5,
          "text": "באותיות התורה],"
        },
        {
          "s": 6,
          "text": "כי הגילוי שע\"י אותיות התורה"
        },
        {
          "s": 7,
          "text": "[אותיות מלשון אתא בוקר64]"
        },
        {
          "s": 8,
          "text": "הוא למעלה מהבנה והשגה,"
        },
        {
          "s": 9,
          "text": "וכמבואר במ\"א בענין אנכי ר\"ת אנא נפשי כתבית יהבית65,"
        },
        {
          "s": 10,
          "text": "דזה שהקב\"ה הכתיב ונתן את עצמותו ית'"
        },
        {
          "s": 11,
          "text": "(אנא נפשי)"
        },
        {
          "s": 12,
          "text": "בתורה66,"
        },
        {
          "s": 13,
          "text": "הוא בעיקר באותיות התורה,"
        },
        {
          "s": 14,
          "text": "ולהיות שבעצרת של חג היא הקליטה של הענינים שנמשכים ע\"י התשובה,"
        },
        {
          "s": 15,
          "text": "רחוק שנעשה קרוב,"
        },
        {
          "s": 16,
          "text": "שעי\"ז נמשך מבחינת מקום רחוק העלם שאינו במציאות עד להעלם העצמי דעצמותו ית',"
        },
        {
          "s": 17,
          "text": "וההמשכה היא באופן שישראל נעשים חד עם עצמותו ית',"
        },
        {
          "s": 18,
          "text": "ישראל ומלכא בלחודוהי,"
        },
        {
          "s": 19,
          "text": "לכן השמחה אז היא דוקא באותיות התורה,"
        },
        {
          "s": 20,
          "text": "כי המשכת העצמות היא בעיקר באותיות התורה"
        },
        {
          "s": 21,
          "text": "(כנ\"ל),"
        },
        {
          "s": 22,
          "text": "ועל ידם נעשים ישראל חד עם העצמות."
        },
        {
          "s": 23,
          "text": "וכמבואר בהמאמר67,"
        },
        {
          "s": 24,
          "text": "שכל אחד ואחד מישראל יש לו אות בתורה,"
        },
        {
          "s": 25,
          "text": "דאות זו נותנת לו חיות,"
        },
        {
          "s": 26,
          "text": "וגם היא מגינה עליו מכל הענינים הבלתי רצויים,"
        },
        {
          "s": 27,
          "text": "והיא גם צנור וכלי לברכת הוי' בכל המצטרך לו,"
        },
        {
          "s": 28,
          "text": "מתחיל מענין הקליטה"
        },
        {
          "s": 29,
          "text": "(שבשמע\"צ)"
        },
        {
          "s": 30,
          "text": "דכל ההמשכות שנמשכו לו בחודש תשרי,"
        },
        {
          "s": 31,
          "text": "אותיות רשית68,"
        },
        {
          "s": 32,
          "text": "על כל השנה כולה."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ומהשמחה דשמח\"ת,"
        },
        {
          "s": 1,
          "text": "נעבד כולן חד יו\"ט ונחדי,"
        },
        {
          "s": 2,
          "text": "נמשך נתינת כח על ההליכה דויעקב הלך לדרכו69,"
        },
        {
          "s": 3,
          "text": "גם בההליכה דימי החורף שהיא הליכה קשה כנ\"ל,"
        },
        {
          "s": 4,
          "text": "שמקיימים בפועל כל ההחלטות שמחליטים בשמח\"ת,"
        },
        {
          "s": 5,
          "text": "דמכיון שההחלטות הן בשמחה הרי שמחה היא למעלה מכל מדוה\"ג ופורצת כל הגדרים70,"
        },
        {
          "s": 6,
          "text": "שאין מתחשבים עם שום מניעות ועיכובים ומקיימים כל ההחלטות בתוקף."
        },
        {
          "s": 7,
          "text": "וכיון שהשמחה היא באותיות התורה שהם הצנור וכלי לברכת הוי' בכל המצטרך"
        },
        {
          "s": 8,
          "text": "(כנ\"ל),"
        },
        {
          "s": 9,
          "text": "הנה עי\"ז נמשך תוספת ברכה והצלחה הכי גדולה בכל הענינים במשך כל השנה,"
        },
        {
          "s": 10,
          "text": "ובפרט בענין העיקרי,"
        },
        {
          "s": 11,
          "text": "שתהי' שנת גאולה,"
        },
        {
          "s": 12,
          "text": "גאולה האמיתית והשלימה ע\"י משיח צדקנו,"
        },
        {
          "s": 13,
          "text": "במהרה בימינו ממש."
        }
      ]
    }
  ]
}