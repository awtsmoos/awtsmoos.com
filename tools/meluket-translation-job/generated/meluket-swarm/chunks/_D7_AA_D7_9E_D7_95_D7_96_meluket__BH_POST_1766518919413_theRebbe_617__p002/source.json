{
  "globalIndex": 956,
  "owner": 6,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919413_theRebbe_617__p002",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919413_theRebbe_617__p002",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919413_theRebbe_617",
  "title": "מאמר אך בגורל תשל\"ה",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "וביאור השייכות של ג' הדברים"
        },
        {
          "s": 2,
          "text": "(הגורל בנפש ובעבודת האדם ובחלוקת הארץ),"
        },
        {
          "s": 3,
          "text": "הנה כל הדברים שבעולם ישנם בישראל18."
        },
        {
          "s": 4,
          "text": "ובפרט החלק שבעולם השייך בפרט לישראל,"
        },
        {
          "s": 5,
          "text": "וכמאמר חז\"ל19"
        },
        {
          "s": 6,
          "text": "כשברא העולם חלק הארצות כו' ובחר בארץ ישראל כו' ובחר לחלקו ישראל כו' יבואו ישראל שבאו לחלקי וינחלו את הארץ שבאה לחלקי,"
        },
        {
          "s": 7,
          "text": "שלכן נתן הקב\"ה את כל ארץ כנען לאברהם אבינו לו ולזרעו אחריו לאחוזת עולם20."
        },
        {
          "s": 8,
          "text": "ומזה מובן שהדברים שבארץ ישראל הם בהתאם להדברים שבישראל,"
        },
        {
          "s": 9,
          "text": "וכן לאידך גיסא שהדברים שבישראל הם בהתאם להדברים שבארץ ישראל."
        },
        {
          "s": 10,
          "text": "ומכיון שבנוגע לא\"י,"
        },
        {
          "s": 11,
          "text": "בכיבוש ארץ כנען לעשות אותה ארץ ישראל,"
        },
        {
          "s": 12,
          "text": "היו בה ג' הדברים דגורל רוה\"ק ושכל"
        },
        {
          "s": 13,
          "text": "(שהו\"ע לרב תרבה גו' ולמעט תמעיט גו'),"
        },
        {
          "s": 14,
          "text": "הרי מובן שג' דברים אלו ישנם בישראל,"
        },
        {
          "s": 15,
          "text": "היינו ברוחניות דישראל"
        },
        {
          "s": 16,
          "text": "[וגם זה דרב ומעט,"
        },
        {
          "s": 17,
          "text": "מכיון שישנו"
        },
        {
          "s": 18,
          "text": "(בחלוקת א\"י)"
        },
        {
          "s": 19,
          "text": "בנוגע להגוף"
        },
        {
          "s": 20,
          "text": "(שהוא טפל),"
        },
        {
          "s": 21,
          "text": "הרי עאכו\"כ שישנו בנוגע להרוחני,"
        },
        {
          "s": 22,
          "text": "הנשמה,"
        },
        {
          "s": 23,
          "text": "שזה העיקר]."
        },
        {
          "s": 24,
          "text": "ומכיון שהתכלית דישראל הוא כמרז\"ל21"
        },
        {
          "s": 25,
          "text": "אני נבראתי לשמש את קוני,"
        },
        {
          "s": 26,
          "text": "הרי מובן,"
        },
        {
          "s": 27,
          "text": "שכל ג' דברים הנ\"ל ישנם גם בהענין דלשמש את קוני,"
        },
        {
          "s": 28,
          "text": "בעבודת ה'."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והענין הוא,"
        },
        {
          "s": 2,
          "text": "דהנה נתבאר בהמאמרים דימי הגאולה י\"ב וי\"ג תמוז22"
        },
        {
          "s": 3,
          "text": "(אשר הימים האלה באים בהמשך לימי הגאולה),"
        },
        {
          "s": 4,
          "text": "שבישראל יש ג' דרגות."
        },
        {
          "s": 5,
          "text": "כמו שהם בבחי' מעין גנים,"
        },
        {
          "s": 6,
          "text": "כמו שהם בבחי' באר מים חיים,"
        },
        {
          "s": 7,
          "text": "וכמו שהם באים"
        },
        {
          "s": 8,
          "text": "(ע\"י עלי באר ענו לה)"
        },
        {
          "s": 9,
          "text": "לבחי' ונוזלים מן לבנון,"
        },
        {
          "s": 10,
          "text": "ונוזלים הוא מלשון מזל,"
        },
        {
          "s": 11,
          "text": "דמזל שענינו למעלה מחו\"ב הו\"ע הגורל כמבואר בכ\"מ23."
        },
        {
          "s": 12,
          "text": "ונתבאר בזה שמעין גנים קאי על הנשמות כמו שהם למעלה קודם שירדו למטה."
        },
        {
          "s": 13,
          "text": "ואז הם נק' בשם בנות ירושלים,"
        },
        {
          "s": 14,
          "text": "שירושלים מורה על שלימות היראה,"
        },
        {
          "s": 15,
          "text": "וכדאיתא בתוספות24"
        },
        {
          "s": 16,
          "text": "שירושלים נקרא על שם יראה ועל שם שלם ולכך אין אנו נותנין יו\"ד בירושלים"
        },
        {
          "s": 17,
          "text": "(בין למ\"ד למ\"ם)."
        },
        {
          "s": 18,
          "text": "ולכן הנשמות כמו שהם למעלה נק' בשם בנות ירושלים לפי שאז הם בשלימות היראה."
        },
        {
          "s": 19,
          "text": "ובאר"
        },
        {
          "s": 20,
          "text": "(מים חיים)"
        },
        {
          "s": 21,
          "text": "קאי על הנשמות כמו שירדו למטה ומלובשות בגופים גשמיים,"
        },
        {
          "s": 22,
          "text": "בדוגמת הבאר שנמצא בעומק הארץ כו'."
        },
        {
          "s": 23,
          "text": "אמנם ירידה זו היא צורך עלי',"
        },
        {
          "s": 24,
          "text": "שע\"י עבודת הנשמה למטה דוקא היא מתעלית בבחי' נעלית יותר מכמו שהייתה קודם ירידתה."
        },
        {
          "s": 25,
          "text": "וזהו שחורה אני ונאוה בנות ירושלים25,"
        },
        {
          "s": 26,
          "text": "שהנשמות שירדו למטה להתלבש בגוף ונה\"ב אומרות להנשמות שלמעלה שנקראות בנות ירושלים,"
        },
        {
          "s": 27,
          "text": "הגם ששחורה אני,"
        },
        {
          "s": 28,
          "text": "כי ע\"י ירידתה לעוה\"ז התחתון שאין תחתון למטה ממנו בענין הסתר אורו ית'26"
        },
        {
          "s": 29,
          "text": "היא נעשית בבחי' שחרות שהוא העדר האור לגמרי,"
        },
        {
          "s": 30,
          "text": "מ\"מ ע\"י ששחורה אני הנה דוקא עי\"ז ונאוה,"
        },
        {
          "s": 31,
          "text": "שהיא מתעלית יותר מכמו שהייתה למעלה בהיותה נקראת בנות ירושלים."
        },
        {
          "s": 32,
          "text": "דכמו שהבאר ע\"י שמימיו עוברים את גידי האדמה המעלימים ומסתירים על המים נעשה בהם זיכוך וכו' עד שנעשים מים חיים,"
        },
        {
          "s": 33,
          "text": "שהוא עילוי נעלה יותר מבחי' מעין,"
        },
        {
          "s": 34,
          "text": "וכדאיתא במשנה27"
        },
        {
          "s": 35,
          "text": "שדוקא מים חיים"
        },
        {
          "s": 36,
          "text": "(משא\"כ מעין)"
        },
        {
          "s": 37,
          "text": "מטהרים את ג' טומאות החמורות עד לטומאת מת שהיא אבי אבות הטומאה,"
        },
        {
          "s": 38,
          "text": "עד\"ז הוא גם בנוגע להנשמה,"
        },
        {
          "s": 39,
          "text": "שע\"י ירידתה למטה והתלבשותה בגוף ונה\"ב המעלימים ומסתירים על אור הנשמה כשהיא מתגלית מהכיסוי וההסתר ע\"י העבודה דחפרוה שרים כרוה נדיבי העם,"
        },
        {
          "s": 40,
          "text": "שענין החפירה והכרי' הוא הסרת ההעלם והסתר של הגוף ונה\"ב המעלימים ומסתירים על אור הנשמה"
        },
        {
          "s": 41,
          "text": "(בדוגמת חפירת וכריית הבאר שהיא הסרת העפר וכו' המעלים ומסתיר על המים),"
        },
        {
          "s": 42,
          "text": "שבעבודה זו שני ענינים."
        },
        {
          "s": 43,
          "text": "א' ענין ההתבוננות הנק' שרים28,"
        },
        {
          "s": 44,
          "text": "ב' ענין המדות שבלב הנק' נדיבי העם28,"
        },
        {
          "s": 45,
          "text": "שעל ידם בא לסור מרע ועשה טוב בפועל,"
        },
        {
          "s": 46,
          "text": "הנה עי\"ז דוקא מתעלית הנשמה למעלה יותר מכמו שהייתה קודם ירידתה,"
        },
        {
          "s": 47,
          "text": "שנעשים בחי' מים חיים"
        },
        {
          "s": 48,
          "text": "(שלמעלה יותר מבחי' מעין גנים),"
        },
        {
          "s": 49,
          "text": "ועד שעי\"ז דוקא באה לבחי' ונוזלים מן לבנון."
        },
        {
          "s": 50,
          "text": "דזהו שחורה אני ונאוה,"
        },
        {
          "s": 51,
          "text": "שדוקא ע\"י שחורה אני נעשה ונאוה."
        },
        {
          "s": 52,
          "text": "אלא שהכח שיש להנשמה שבגוף לעבודה זו נמשך לה משרשה שלמעלה."
        },
        {
          "s": 53,
          "text": "דזהו האמירה לבנו\"י29"
        },
        {
          "s": 54,
          "text": "שחורה אני ונאוה בנות ירושלים,"
        },
        {
          "s": 55,
          "text": "שהכח להנשמה שבגוף לברר את השחרות וכו' ולהיות ונאוה הוא ע\"י הסיוע שנמשך"
        },
        {
          "s": 56,
          "text": "(להנשמה שבגוף)"
        },
        {
          "s": 57,
          "text": "משרשה שלמעלה הנק' בנות ירושלים."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ובזה מובן30"
        },
        {
          "s": 2,
          "text": "שהשירה עלי באר ענו לה אמרו ישראל לסוף מ' שנה,"
        },
        {
          "s": 3,
          "text": "אף שהבאר ניתנה להם מתחילת ארבעים"
        },
        {
          "s": 4,
          "text": "(כמובא בפירש\"י עה\"ת31),"
        },
        {
          "s": 5,
          "text": "כי ישראל שהיו במדבר,"
        },
        {
          "s": 6,
          "text": "אף שהיו דור דיעה וכמבואר בארוכה בקבלה32"
        },
        {
          "s": 7,
          "text": "גודל העילוי שלהם,"
        },
        {
          "s": 8,
          "text": "שהיו נשמות דעולם המחשבה,"
        },
        {
          "s": 9,
          "text": "היינו שגם בהיותם למטה היו בבחי' עולם המחשבה,"
        },
        {
          "s": 10,
          "text": "מ\"מ"
        },
        {
          "s": 11,
          "text": "(מצד זה גופא)"
        },
        {
          "s": 12,
          "text": "לא הי' בהם העילוי דבחי' באר מים חיים ונוזלים מן לבנון,"
        },
        {
          "s": 13,
          "text": "כי עילוי זה נעשה ע\"י בירור דברים הגשמיים דוקא."
        },
        {
          "s": 14,
          "text": "וזהו מה שהשירה עלי באר ענו לה אמרו הדור שנכנסו לארץ דוקא"
        },
        {
          "s": 15,
          "text": "(בסוף ארבעים,"
        },
        {
          "s": 16,
          "text": "לפני הכניסה לארץ),"
        },
        {
          "s": 17,
          "text": "כי הענין דא\"י הו\"ע בירור דברים הגשמיים דוקא שעי\"ז נעשה עילוי הנ\"ל,"
        },
        {
          "s": 18,
          "text": "טובה הארץ מאד מאד33."
        },
        {
          "s": 19,
          "text": "ומכיון שדור שנכנסו לארץ עמדו במסירת הנפש והרצון ליכנס לארץ טובה ורחבה,"
        },
        {
          "s": 20,
          "text": "ובפרט בסוף ארבעים שנה שאז כבר הי' להם כל ההכנה שצריכים לזה,"
        },
        {
          "s": 21,
          "text": "ועד שכבר הי' גם כיבוש34"
        },
        {
          "s": 22,
          "text": "ארץ סיחון ועוג שהיא התחלת ענין הכניסה לא\"י"
        },
        {
          "s": 23,
          "text": "(לא רק הכנה והקדמה להכניסה אלא גם התחלת הכניסה."
        },
        {
          "s": 24,
          "text": "שהרי ארץ סיחון ועוג היא שוה לא\"י בנוגע לכמה דינים35),"
        },
        {
          "s": 25,
          "text": "לכן הנה בסוף ארבעים שנה דוקא היו ניסים אלו שפעלו בישראל שיאמרו השירה עלי באר גו'."
        }
      ]
    }
  ]
}