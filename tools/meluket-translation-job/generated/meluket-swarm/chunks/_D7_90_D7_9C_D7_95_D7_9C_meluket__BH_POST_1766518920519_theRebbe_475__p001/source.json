  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920519_theRebbe_475__p001",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920519_theRebbe_475__p001",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920519_theRebbe_475",
  "title": "מאמר אתם נצבים תשט\"ז",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד,"
        },
        {
          "s": 1,
          "text": "ש\"פ נצבים-וילך,"
        },
        {
          "s": 2,
          "text": "כ\"ה אלול*,"
        },
        {
          "s": 3,
          "text": "ה'תשט\"ז"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "(הנחה בלתי מוגה)"
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "אתם נצבים היום כולכם לפני הוי' אלקיכם ראשיכם שבטיכם גו' מחוטב עציך עד שואב מימיך1,"
        },
        {
          "s": 1,
          "text": "הנה פרשה2"
        },
        {
          "s": 2,
          "text": "זו קורין לעולם קודם ראש השנה."
        },
        {
          "s": 3,
          "text": "ומרומז במלת היום דקאי על ר\"ה,"
        },
        {
          "s": 4,
          "text": "כמ\"ש3"
        },
        {
          "s": 5,
          "text": "רבינו שקיבל מרבו המגיד ורבו מרבו הבעש\"ט דהיום קאי על ר\"ה4"
        },
        {
          "s": 6,
          "text": "שהוא יום הדין,"
        },
        {
          "s": 7,
          "text": "וכמ\"ש5"
        },
        {
          "s": 8,
          "text": "ויהי היום,"
        },
        {
          "s": 9,
          "text": "ותרגם והוה יומא דדינא רבא,"
        },
        {
          "s": 10,
          "text": "דר\"ה הוא יום הדין ומשפט,"
        },
        {
          "s": 11,
          "text": "וזוהי הברכה אתם נצבים היום כולכם,"
        },
        {
          "s": 12,
          "text": "שאתם כולכם מראשיכם שבטיכם עד חוטב עציך ושואב מימיך,"
        },
        {
          "s": 13,
          "text": "נצבים קיימים ועומדים6"
        },
        {
          "s": 14,
          "text": "והיינו שזוכים בדין."
        }
      ]
    }
  ]
}