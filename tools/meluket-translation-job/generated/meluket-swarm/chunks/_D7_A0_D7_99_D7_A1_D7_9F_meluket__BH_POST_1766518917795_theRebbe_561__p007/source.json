{
  "globalIndex": 687,
  "owner": 37,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917795_theRebbe_561__p007",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917795_theRebbe_561__p007",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917795_theRebbe_561",
  "title": "מאמר כי ישאלך בנך תשל\"ח",
  "part": 7,
  "sections": [
    {
      "v": 18,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "והתשובה עבדים היינו לפרעה במצרים ויוציאנו הוי' ממצרים ביד חזקה היא,"
        },
        {
          "s": 3,
          "text": "שגם מי שהוא בדרגת תינוק ברגע שנולד"
        },
        {
          "s": 4,
          "text": "(כולל זה שהוא בדרגא זו בפשטות,"
        },
        {
          "s": 5,
          "text": "ולא כהבן חכם דזה שהוא בדרגא זו הוא מצד העליות שלו),"
        },
        {
          "s": 6,
          "text": "ויתירה מזו,"
        },
        {
          "s": 7,
          "text": "גם מי שהוא במצב דעבד לפרעה במצרים"
        },
        {
          "s": 8,
          "text": "(לפני הלידה דיציאת מצרים),"
        },
        {
          "s": 9,
          "text": "מוציא הוי' אותו ממצרים ביד חזקה,"
        },
        {
          "s": 10,
          "text": "דביד57"
        },
        {
          "s": 11,
          "text": "חזקה הוא תוקף ההתגלות ועד שנגלה58"
        },
        {
          "s": 12,
          "text": "עליהם מלך מלכי המלכים הקב\"ה בכבודו ובעצמו וגאלם,"
        },
        {
          "s": 13,
          "text": "שהוא דילוג59"
        },
        {
          "s": 14,
          "text": "מן הקצה אל הקצה,"
        },
        {
          "s": 15,
          "text": "מהמטה ביותר"
        },
        {
          "s": 16,
          "text": "(עבדים לפרעה במצרים)"
        },
        {
          "s": 17,
          "text": "להמעלה ביותר – הגילוי דבכבודו ובעצמו60."
        }
      ]
    },
    {
      "v": 19,
      "items": [
        {
          "s": 0,
          "text": "וכן תהי' לנו,"
        },
        {
          "s": 1,
          "text": "אשר כימי צאתך מארץ מצרים אראנו נפלאות61,"
        },
        {
          "s": 2,
          "text": "גאולה בדרך דילוג מן הקצה אל הקצה,"
        },
        {
          "s": 3,
          "text": "שמחושך הכפול ומכופל דגלות,"
        },
        {
          "s": 4,
          "text": "ובפרט בדרא דעקבתא דמשיחא שהחושך גדול עוד יותר62,"
        },
        {
          "s": 5,
          "text": "באים מיד להגילוי דונגלה כבוד הוי' וראו כל בשר גו'63,"
        },
        {
          "s": 6,
          "text": "והיתה להוי' המלוכה64,"
        },
        {
          "s": 7,
          "text": "בביאת משיח צדקנו,"
        },
        {
          "s": 8,
          "text": "במהרה בימינו ממש."
        }
      ]
    }
  ]
}