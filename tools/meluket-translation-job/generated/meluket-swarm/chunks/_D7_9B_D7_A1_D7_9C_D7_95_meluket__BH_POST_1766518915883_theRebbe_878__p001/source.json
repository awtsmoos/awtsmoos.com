{
  "globalIndex": 371,
  "owner": 21,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915883_theRebbe_878__p001",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915883_theRebbe_878__p001",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915883_theRebbe_878",
  "title": "מאמר מצותה משתשקע החמה תשל\"ח",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "זאת חנוכה,"
        },
        {
          "s": 2,
          "text": "ה'תשל\"ח*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "מצותה"
        },
        {
          "s": 1,
          "text": "(של נ\"ח)"
        },
        {
          "s": 2,
          "text": "משתשקע החמה עד שתכלה רגל מן השוק כו' עד דכליא ריגלא דתרמודאי1,"
        },
        {
          "s": 3,
          "text": "ומבואר בדרושי רבותינו נשיאינו2"
        },
        {
          "s": 4,
          "text": "החילוק שבין נרות חנוכה לנרות המקדש ונרות שבת,"
        },
        {
          "s": 5,
          "text": "דנרות המקדש ונרות שבת זמן הדלקתם הוא מבעוד יום"
        },
        {
          "s": 6,
          "text": "[דנרות המקדש הדליקו מפלג המנחה,"
        },
        {
          "s": 7,
          "text": "שהוא הרבה"
        },
        {
          "s": 8,
          "text": "(שעה ורביע3)"
        },
        {
          "s": 9,
          "text": "קודם שקיעת החמה."
        },
        {
          "s": 10,
          "text": "וגם נרות שבת צריך להדליקן קודם שקיעת החמה,"
        },
        {
          "s": 11,
          "text": "מצד שמירת שבת4],"
        },
        {
          "s": 12,
          "text": "משא\"כ נר חנוכה מצותה היא משתשקע החמה5."
        },
        {
          "s": 13,
          "text": "דהגם דזה שתקנו נ\"ח הוא מפני הנס שהי' בנרות המקדש,"
        },
        {
          "s": 14,
          "text": "וא\"כ הי' ראוי שתהי' זמן הדלקתה כנרות המקדש,"
        },
        {
          "s": 15,
          "text": "ובפרט דכל דתקון רבנן כעין דאורייתא תקון6,"
        },
        {
          "s": 16,
          "text": "ומ\"מ מצותה היא דוקא משתשקע החמה."
        },
        {
          "s": 17,
          "text": "וידוע הביאור בזה,"
        },
        {
          "s": 18,
          "text": "שענין משתשקע החמה קאי על זמן הגלות7"
        },
        {
          "s": 19,
          "text": "שנקרא בשם חושך."
        },
        {
          "s": 20,
          "text": "והסיבה לחושך הגלות היא החושך הרוחני – ענין החטאים שהם היפך נר8"
        },
        {
          "s": 21,
          "text": "מצוה ותורה אור,"
        },
        {
          "s": 22,
          "text": "כמו שאומרים9"
        },
        {
          "s": 23,
          "text": "ומפני חטאינו גלינו."
        },
        {
          "s": 24,
          "text": "וזהו מה שנ\"ח מצותה משתשקע החמה,"
        },
        {
          "s": 25,
          "text": "כי ענין נ\"ח הוא להאיר את חושך הגלות"
        },
        {
          "s": 26,
          "text": "[שהרי הזמן דנס חנוכה"
        },
        {
          "s": 27,
          "text": "(אף שאז הי' ביהמ\"ק קיים)"
        },
        {
          "s": 28,
          "text": "נקרא ג\"כ בשם גלות,"
        },
        {
          "s": 29,
          "text": "גלות יון10,"
        },
        {
          "s": 30,
          "text": "ובפרט בימים ההם"
        },
        {
          "s": 31,
          "text": "(שלפני הנס)"
        },
        {
          "s": 32,
          "text": "שהי' התגברות החושך11,"
        },
        {
          "s": 33,
          "text": "וכמובן מנוסח ועל הנסים12"
        },
        {
          "s": 34,
          "text": "גודל הצרות וכו' שהיו אז]."
        },
        {
          "s": 35,
          "text": "וזהו ג\"כ מה שזמנה של נ\"ח הוא עד שתכלה רגל מן השוק עד דכליא ריגלא דתרמודאי,"
        },
        {
          "s": 36,
          "text": "תרמודאי הם המורדים במלכות שמים"
        },
        {
          "s": 37,
          "text": "(תרמוד אותיות מורדת13)"
        },
        {
          "s": 38,
          "text": "והם מתעכבים בשוק14"
        },
        {
          "s": 39,
          "text": "בחי' רה\"ר טורי דפרודא15."
        },
        {
          "s": 40,
          "text": "ועד דכליא ריגלא דתרמודאי בב' הפירושים."
        },
        {
          "s": 41,
          "text": "שהאור דנ\"ח מכלה ומבטל את ריגלא דתרמודאי16,"
        },
        {
          "s": 42,
          "text": "ושהאור דנ\"ח פועל ענין הכליון גם בריגלא דתרמודאי,"
        },
        {
          "s": 43,
          "text": "שגם המורדים יתבטלו ויתהפכו ויבואו לכלות הנפש17,"
        },
        {
          "s": 44,
          "text": "ועד שהצמאון והכליון שלהם הוא ביתר עז"
        },
        {
          "s": 45,
          "text": "[וכידוע18"
        },
        {
          "s": 46,
          "text": "שהצמאון של בע\"ת הוא ביתר עז מצמאון הצדיקים],"
        },
        {
          "s": 47,
          "text": "כי יתרון האור הוא מן החושך דוקא19."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה ידוע שכל מציאות שבעולם,"
        },
        {
          "s": 2,
          "text": "גם הלעו\"ז,"
        },
        {
          "s": 3,
          "text": "יש לה התחלה ושרש בקדושה"
        },
        {
          "s": 4,
          "text": "(ויתירה מזה ארז\"ל20"
        },
        {
          "s": 5,
          "text": "אין עוד מלבדו21"
        },
        {
          "s": 6,
          "text": "ואפילו כשפים שמכחישין פמליא של מעלה)."
        },
        {
          "s": 7,
          "text": "אלא שיש דברים שאי אפשר שיומשכו ממקורם ע\"י השתלשלות"
        },
        {
          "s": 8,
          "text": "(גם השתלשלות של ריבוי דרגות ביותר),"
        },
        {
          "s": 9,
          "text": "כי אם צ\"ל גם הפסק או צמצום או מסך או שבירה וכו'."
        },
        {
          "s": 10,
          "text": "ומזה מובן בנוגע לענינים הנ\"ל"
        },
        {
          "s": 11,
          "text": "[משתשקע החמה,"
        },
        {
          "s": 12,
          "text": "שוק ותרמודאי]"
        },
        {
          "s": 13,
          "text": "שהתחלתם ומקורם בקדושה,"
        },
        {
          "s": 14,
          "text": "אלא שבאים ע\"י צמצום והפסק וכו' ושבירה וכו'."
        },
        {
          "s": 15,
          "text": "[ובדוגמת ענין פרעה"
        },
        {
          "s": 16,
          "text": "(שבפרשתנו22),"
        },
        {
          "s": 17,
          "text": "שבשרשו הו\"ע הכי נעלה בקדושה,"
        },
        {
          "s": 18,
          "text": "כידוע23"
        },
        {
          "s": 19,
          "text": "שפרעה הוא דאתפריעו ואתגליין מיני' כל נהורין,"
        },
        {
          "s": 20,
          "text": "וע\"י ריבוי השתלשלות ושבירה וכו' בא מזה פרעה מלך מצרים,"
        },
        {
          "s": 21,
          "text": "התנים הגדול הרובץ בתוך יאוריו ואומר לי יאורי ואני עשיתיני24]."
        },
        {
          "s": 22,
          "text": "ומזה גופא שנפלו למטה כ\"כ מוכח ששרשם היא בחינה נעלית ביותר,"
        },
        {
          "s": 23,
          "text": "דכל הגבוה גבוה יותר יורד למטה מטה יותר25."
        },
        {
          "s": 24,
          "text": "ולכן ע\"י שמבררים הענינים שנפלו למטה ביותר"
        },
        {
          "s": 25,
          "text": "[וכמו הבירור דפרעה שהוא דוקא ע\"י משה רבינו26,"
        },
        {
          "s": 26,
          "text": "וע\"י שניתן לו על זה כח מיוחד,"
        },
        {
          "s": 27,
          "text": "בא אל פרעה27]"
        },
        {
          "s": 28,
          "text": "מתעלים הם לשרשם שהוא גבוה גבוה ביותר."
        },
        {
          "s": 29,
          "text": "ויתירה מזו,"
        },
        {
          "s": 30,
          "text": "מכיון שכל ירידה היא צורך עלי',"
        },
        {
          "s": 31,
          "text": "הרי עלייתם לאחרי הבירור היא למעלה יותר מכמו שהיו בשרשם קודם הירידה והנפילה."
        }
      ]
    }
  ]
}