{
  "globalIndex": 916,
  "owner": 16,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919223_theRebbe_96__p001",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919223_theRebbe_96__p001",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919223_theRebbe_96",
  "title": "מאמר תפלה למשה תשכ\"ט",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "י\"ג תמוז,"
        },
        {
          "s": 2,
          "text": "ה'תשכ\"ט"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "תפלה למשה איש האלקים גו'1,"
        },
        {
          "s": 1,
          "text": "ומבאר כ\"ק מו\"ח אדמו\"ר בשיחתו הידועה2"
        },
        {
          "s": 2,
          "text": "דמזמור זה שייך להגאולה די\"ט כסלו"
        },
        {
          "s": 3,
          "text": "[כידוע שאדמו\"ר הזקן הי' אומר בכל יום שיעור תהלים כמו שנחלק לימי החודש3,"
        },
        {
          "s": 4,
          "text": "וכיון שהמזמור תפלה למשה הוא התחלת שיעור תהלים החדשי דיום הי\"ט לחודש,"
        },
        {
          "s": 5,
          "text": "הרי אמר ביום גאולתו"
        },
        {
          "s": 6,
          "text": "(י\"ט כסלו)"
        },
        {
          "s": 7,
          "text": "מזמור זה]."
        },
        {
          "s": 8,
          "text": "וממשיך בהשיחה,"
        },
        {
          "s": 9,
          "text": "שדוד מלך ישראל הי' לו בקבלה4"
        },
        {
          "s": 10,
          "text": "שמזמור זה חיברו משה,"
        },
        {
          "s": 11,
          "text": "כדאיתא במדרש5"
        },
        {
          "s": 12,
          "text": "אחד עשר מזמורים אמר משה כנגד אחד עשר שבטים."
        },
        {
          "s": 13,
          "text": "וממשיך בהשיחה,"
        },
        {
          "s": 14,
          "text": "דהתחלת המזמור הוא אד' מעון אתה גו' וסיום המזמור6"
        },
        {
          "s": 15,
          "text": "הוא ויהי נועם אד' גו',"
        },
        {
          "s": 16,
          "text": "מעון ונועם הם אותם האותיות."
        },
        {
          "s": 17,
          "text": "וצריך להבין הקשר דג' הענינים"
        },
        {
          "s": 18,
          "text": "(השייכות דהמזמור להגאולה די\"ט כסלו,"
        },
        {
          "s": 19,
          "text": "שמזמור זה חיברו משה והשייכות דמעון ונועם)."
        },
        {
          "s": 20,
          "text": "גם צריך להבין מה שמביא ראי' מהמדרש שמזמור זה חיברו משה,"
        },
        {
          "s": 21,
          "text": "והרי בהמזמור עצמו נאמר שהוא תפלה למשה."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויש לבאר ע\"פ הידוע7"
        },
        {
          "s": 2,
          "text": "שבהגאולה די\"ט כסלו הותחל הענין דיפוצו מעינותיך חוצה,"
        },
        {
          "s": 3,
          "text": "שהוא הכנה וכלי לאתי מר דא מלכא משיחא8."
        },
        {
          "s": 4,
          "text": "ועפ\"ז,"
        },
        {
          "s": 5,
          "text": "השייכות דמזמור זה להגאולה די\"ט כסלו מורה"
        },
        {
          "s": 6,
          "text": "(גם)"
        },
        {
          "s": 7,
          "text": "על שייכותו לגאולה העתידה."
        },
        {
          "s": 8,
          "text": "וזהו שלאחרי שאומר בהשיחה שמזמור זה שייך להגאולה די\"ט כסלו ממשיך שמזמור זה חיברו משה,"
        },
        {
          "s": 9,
          "text": "דמשה הוא גואל ראשון הוא גואל אחרון9."
        },
        {
          "s": 10,
          "text": "[ומדייק שדוד מלך ישראל הי' לו בקבלה שמזמור זה חיברו משה,"
        },
        {
          "s": 11,
          "text": "שבזה מרמז,"
        },
        {
          "s": 12,
          "text": "דענין משה שנוגע כאן הוא זה שמשה גאל את ישראל מגלות מצרים,"
        },
        {
          "s": 13,
          "text": "שהגאולה ממצרים היא הקדמה להגאולה העתידה10"
        },
        {
          "s": 14,
          "text": "ע\"י דוד מלכא משיחא,"
        },
        {
          "s": 15,
          "text": "כימי צאתך מארץ מצרים אראנו נפלאות11]."
        },
        {
          "s": 16,
          "text": "ומביא את מאמר המדרש אחד עשר מזמורים אמר משה,"
        },
        {
          "s": 17,
          "text": "דבאחד עשר שני ענינים."
        },
        {
          "s": 18,
          "text": "אחד שלפני"
        },
        {
          "s": 19,
          "text": "(ולמעלה מ)"
        },
        {
          "s": 20,
          "text": "עשר הוא אוא\"ס שלמעלה מעשר ספירות,"
        },
        {
          "s": 21,
          "text": "אנת12"
        },
        {
          "s": 22,
          "text": "הוא חד ולא בחושבן13,"
        },
        {
          "s": 23,
          "text": "ואחד עשר הוא המשכת אחד"
        },
        {
          "s": 24,
          "text": "(חד ולא בחושבן)"
        },
        {
          "s": 25,
          "text": "בעשר,"
        },
        {
          "s": 26,
          "text": "בכל העשר ספירות14"
        },
        {
          "s": 27,
          "text": "ועד בספירת המלכות."
        },
        {
          "s": 28,
          "text": "ואדרבה,"
        },
        {
          "s": 29,
          "text": "עיקר המשכת בחינת חד ולא בחושבן הוא במלכות,"
        },
        {
          "s": 30,
          "text": "כי שורש המלכות הוא בפנימיות הכתר."
        },
        {
          "s": 31,
          "text": "דכל הספירות שרשם בחיצוניות הכתר שנמנה במנין עשר ספירות15,"
        },
        {
          "s": 32,
          "text": "ושורש המלכות הוא בפנימיות הכתר שאינו נמנה במנין הספירות15,"
        },
        {
          "s": 33,
          "text": "חד ולא בחושבן."
        },
        {
          "s": 34,
          "text": "אלא שבגילוי,"
        },
        {
          "s": 35,
          "text": "המלכות היא למטה מכל הספירות,"
        },
        {
          "s": 36,
          "text": "ועד שירדה להיות מקור להוות עולמות בי\"ע16,"
        },
        {
          "s": 37,
          "text": "עד לעוה\"ז הגשמי."
        },
        {
          "s": 38,
          "text": "ולע\"ל יהי' גילוי שורש המלכות"
        },
        {
          "s": 39,
          "text": "(חד ולא בחושבן)"
        },
        {
          "s": 40,
          "text": "במלכות"
        },
        {
          "s": 41,
          "text": "[ובפרט כמו שירדה בבי\"ע16]"
        },
        {
          "s": 42,
          "text": "ועי\"ז – בעולמות בי\"ע עד בעוה\"ז הגשמי,"
        },
        {
          "s": 43,
          "text": "ואדרבה,"
        },
        {
          "s": 44,
          "text": "עיקר הגילוי יהי' בעוה\"ז הגשמי,"
        },
        {
          "s": 45,
          "text": "ועי\"ז תושלם הכוונה דדירה בתחתונים17,"
        },
        {
          "s": 46,
          "text": "שעוה\"ז התחתון שאין תחתון למטה ממנו18"
        },
        {
          "s": 47,
          "text": "יהי' דירה לו ית',"
        },
        {
          "s": 48,
          "text": "לו לעצמותו19."
        }
      ]
    }
  ]
}