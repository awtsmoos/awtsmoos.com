{
  "globalIndex": 1024,
  "owner": 24,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919837_theRebbe_328__p002",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919837_theRebbe_328__p002",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919837_theRebbe_328",
  "title": "מאמר לא היו ימים טובים לישראל תשמ\"ז",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר17"
        },
        {
          "s": 2,
          "text": "ביאור השייכות דט\"ו"
        },
        {
          "s": 3,
          "text": "[באב]"
        },
        {
          "s": 4,
          "text": "לביהמ\"ק השלישי,"
        },
        {
          "s": 5,
          "text": "שלע\"ל יהיו גם ו\"ה בבחינת י\"ה,"
        },
        {
          "s": 6,
          "text": "כמ\"ש18"
        },
        {
          "s": 7,
          "text": "ביום ההוא יהי'"
        },
        {
          "s": 8,
          "text": "(יהי' הוא ב' פעמים י\"ה)19."
        },
        {
          "s": 9,
          "text": "וכיון שיניקת החיצונים היא מבחינת ו\"ה"
        },
        {
          "s": 10,
          "text": "(זו\"ן),"
        },
        {
          "s": 11,
          "text": "משא\"כ מבחינת י\"ה"
        },
        {
          "s": 12,
          "text": "(או\"א)"
        },
        {
          "s": 13,
          "text": "א\"א להיות יניקה,"
        },
        {
          "s": 14,
          "text": "לכן,"
        },
        {
          "s": 15,
          "text": "לע\"ל שגם ו\"ה יהיו כמו י\"ה,"
        },
        {
          "s": 16,
          "text": "לא יהי' שייך אז חורבן וגלות."
        },
        {
          "s": 17,
          "text": "ומוסיף בהמאמר,"
        },
        {
          "s": 18,
          "text": "שמהחילוקים בין י\"ה"
        },
        {
          "s": 19,
          "text": "(או\"א)"
        },
        {
          "s": 20,
          "text": "לו\"ה"
        },
        {
          "s": 21,
          "text": "(זו\"ן)"
        },
        {
          "s": 22,
          "text": "הוא,"
        },
        {
          "s": 23,
          "text": "דאו\"א הן תרין רעין דלא מתפרשין וזו\"ן זיווגם הוא רק לפרקים20."
        },
        {
          "s": 24,
          "text": "ולע\"ל שאז יהיו ו\"ה כמו י\"ה,"
        },
        {
          "s": 25,
          "text": "גם ו\"ה יהי' זיווגם בתמידות."
        },
        {
          "s": 26,
          "text": "ולכן,"
        },
        {
          "s": 27,
          "text": "ביהמ\"ק דלעתיד יהי' נצחי21."
        },
        {
          "s": 28,
          "text": "[דנוסף לזה שבביהמ\"ק דלעתיד לא יהי' שייך חורבן לפי שלא יהי' שייך אז יניקת החיצונים,"
        },
        {
          "s": 29,
          "text": "הנה גם הביהמ\"ק עצמו יהי' באופן שאין שייך בו הפסק,"
        },
        {
          "s": 30,
          "text": "אהל22"
        },
        {
          "s": 31,
          "text": "בל יצען בל יסע יתדותיו לנצח]."
        },
        {
          "s": 32,
          "text": "וזוהי השייכות די\"ה"
        },
        {
          "s": 33,
          "text": "[באב]"
        },
        {
          "s": 34,
          "text": "לביהמ\"ק השלישי,"
        },
        {
          "s": 35,
          "text": "כי המעלה דביהמ\"ק השלישי שאין שייך בו הפסק הוא לפי שיהי' בבחינת י\"ה."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "וממשיך בהמאמר23"
        },
        {
          "s": 1,
          "text": "בביאור הענין דב' פעמים י\"ה בהקדים הידוע24"
        },
        {
          "s": 2,
          "text": "בענין ואתחנן בגימטריא תקט\"ו25,"
        },
        {
          "s": 3,
          "text": "ת\"ק עם ט\"ו,"
        },
        {
          "s": 4,
          "text": "דת\"ק הוא ה' חסדים דאריך"
        },
        {
          "s": 5,
          "text": "[שכל אחד מהם כלול ממאה]"
        },
        {
          "s": 6,
          "text": "ולמעלה יותר ה' חסדים דעתיק,"
        },
        {
          "s": 7,
          "text": "וענין תקט\"ו הוא שה\"ח דאריך ודעתיק מאירים בי\"ה."
        },
        {
          "s": 8,
          "text": "וזהו גם חמש עשרה אמה קלעים לכתף26,"
        },
        {
          "s": 9,
          "text": "חמש עשרה"
        },
        {
          "s": 10,
          "text": "(אמה)"
        },
        {
          "s": 11,
          "text": "הוא י\"ה וכתף בגימטריא ת\"ק27,"
        },
        {
          "s": 12,
          "text": "וענין חמש עשרה אמה קלעים לכתף הוא המשכת עתיק בי\"ה."
        },
        {
          "s": 13,
          "text": "וזהו גם ענין ב' פעמים י\"ה,"
        },
        {
          "s": 14,
          "text": "כי בחצר המשכן היו שני כתפים ובכל אחד מהם חמש עשרה קלעים28,"
        },
        {
          "s": 15,
          "text": "ושני פעמים חמש עשרה הוא ב' פעמים י\"ה."
        },
        {
          "s": 16,
          "text": "ויש לומר,"
        },
        {
          "s": 17,
          "text": "שהשייכות דחמש עשרה קלעים לכתף"
        },
        {
          "s": 18,
          "text": "(המשכת עתיק בי\"ה)"
        },
        {
          "s": 19,
          "text": "עם ב' פעמים י\"ה"
        },
        {
          "s": 20,
          "text": "(שזו\"ן הם כמו או\"א)"
        },
        {
          "s": 21,
          "text": "היא,"
        },
        {
          "s": 22,
          "text": "כי מצד סדר ההשתלשלות,"
        },
        {
          "s": 23,
          "text": "זו\"ן הם למטה מאו\"א,"
        },
        {
          "s": 24,
          "text": "ובכדי שזו\"ן יהיו כמו או\"א הוא ע\"י המשכת הכתר שלמעלה מהשתלשלות,"
        },
        {
          "s": 25,
          "text": "ובכתר עצמו – עתיק."
        },
        {
          "s": 26,
          "text": "והחילוק דשני הביאורים"
        },
        {
          "s": 27,
          "text": "(בהמאמר)"
        },
        {
          "s": 28,
          "text": "הוא,"
        },
        {
          "s": 29,
          "text": "שבביאור הראשון מדבר בענין העלי' דזו\"ן,"
        },
        {
          "s": 30,
          "text": "ובביאור השני מדבר בענין המשכת עתיק"
        },
        {
          "s": 31,
          "text": "(השורש והסיבה להעלי' דזו\"ן)."
        },
        {
          "s": 32,
          "text": "וממשיך בהמאמר דט\"ו באב שייך גם לביאור השני דשני פעמים י\"ה,"
        },
        {
          "s": 33,
          "text": "כי בט\"ו באב הוא גילוי ה\"ח דעתיק באו\"א29,"
        },
        {
          "s": 34,
          "text": "ועי\"ז נמשך גילוי עתיק גם במלכות30."
        },
        {
          "s": 35,
          "text": "ועיקר גילוי זה יהי' לע\"ל,"
        },
        {
          "s": 36,
          "text": "אלא שמעין זה מאיר גם עכשיו בט\"ו באב,"
        },
        {
          "s": 37,
          "text": "כנ\"ל"
        },
        {
          "s": 38,
          "text": "(סעיף ב)"
        },
        {
          "s": 39,
          "text": "שבט\"ו באב הוא מעין הגילוי דלעתיד."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה הטעם לזה שבט\"ו באב מאיר גילוי זה הוא לפי שבט\"ו באב הוא השלימות דהלבנה שלאחרי הירידה דתשעה באב"
        },
        {
          "s": 2,
          "text": "(כנ\"ל סעיף א)."
        },
        {
          "s": 3,
          "text": "וצריך להבין,"
        },
        {
          "s": 4,
          "text": "דעיקר קיימא סיהרא באשלמותא"
        },
        {
          "s": 5,
          "text": "(בחמשה עשר בחודש)"
        },
        {
          "s": 6,
          "text": "הוא רק בנוגע להגילוי שלה."
        },
        {
          "s": 7,
          "text": "דהלבנה עצמה היא בשלימות בכל ימי החודש,"
        },
        {
          "s": 8,
          "text": "והמעלה דחמשה עשר היא שהשלימות דהלבנה היא בגילוי."
        },
        {
          "s": 9,
          "text": "וכיון שכל הענינים שבתורה הם בתכלית הדיוק,"
        },
        {
          "s": 10,
          "text": "צריך לומר,"
        },
        {
          "s": 11,
          "text": "שהמעלה דחמשה עשר באב היא בענין הגילוי."
        },
        {
          "s": 12,
          "text": "וצריך ביאור,"
        },
        {
          "s": 13,
          "text": "הרי בט\"ו באב הוא מעין הגילוי דביהמ\"ק דלעתיד,"
        },
        {
          "s": 14,
          "text": "שיהי'"
        },
        {
          "s": 15,
          "text": "(נוסף על הגילוי דבית ראשון ובית שני31)"
        },
        {
          "s": 16,
          "text": "גדול מבית ראשון ושני32,"
        },
        {
          "s": 17,
          "text": "והגדלות דבית השלישי על בית ראשון ושני היא גדלות באין ערוך,"
        },
        {
          "s": 18,
          "text": "וכמובן גם מהמבואר לעיל"
        },
        {
          "s": 19,
          "text": "(סעיף ג)"
        },
        {
          "s": 20,
          "text": "שביהמ\"ק השלישי קשור עם ענין ב' פעמים י\"ה שזו\"ן יהי' כמו או\"א ושבאו\"א יהי' גילוי עתיק,"
        },
        {
          "s": 21,
          "text": "ואעפ\"כ,"
        },
        {
          "s": 22,
          "text": "מקשרים המעלה דחמשה עשר באב עם זה שבחמשה עשר הוא שלימות הלבנה,"
        },
        {
          "s": 23,
          "text": "שלימות בענין הגילוי33."
        }
      ]
    }
  ]
}