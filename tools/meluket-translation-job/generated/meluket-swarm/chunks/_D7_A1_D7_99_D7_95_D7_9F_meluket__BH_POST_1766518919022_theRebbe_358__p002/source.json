{
  "globalIndex": 887,
  "owner": 37,
  "jobId": "_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518919022_theRebbe_358__p002",
  "batchId": "meluket-_D7_A1_D7_99_D7_95_D7_9F_meluket__BH_POST_1766518919022_theRebbe_358__p002",
  "seriesId": "סיון_meluket",
  "postId": "BH_POST_1766518919022_theRebbe_358",
  "title": "מאמר ואהי אצלו אמון תשכ\"א",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והענין בזה,"
        },
        {
          "s": 2,
          "text": "דהנה,"
        },
        {
          "s": 3,
          "text": "כללות הגילוי שהי' בשעת מתן תורה,"
        },
        {
          "s": 4,
          "text": "אינו מבחינת אור שבגדר גילוי,"
        },
        {
          "s": 5,
          "text": "כי אם מבחינת עצם האור שהוא למעלה מגדר גילוי לגמרי,"
        },
        {
          "s": 6,
          "text": "העלם בעצם,"
        },
        {
          "s": 7,
          "text": "ועד להעצמות,"
        },
        {
          "s": 8,
          "text": "אנכי מי שאנכי,"
        },
        {
          "s": 9,
          "text": "דלא אתרמיז לא בשום אות ולא בשום קוץ."
        },
        {
          "s": 10,
          "text": "ואין זה סותר למשנת\"ל שהגילוי דמתן תורה בא אחרי ההכנה דיציאת מצרים וספירת העומר,"
        },
        {
          "s": 11,
          "text": "כי,"
        },
        {
          "s": 12,
          "text": "נוסף על זה שגם בבחי' שלמעלה מהשתלשלות,"
        },
        {
          "s": 13,
          "text": "וגם בבחינת עצם האור שלמעלה מגדר גילוי,"
        },
        {
          "s": 14,
          "text": "יש סדר והדרגה,"
        },
        {
          "s": 15,
          "text": "וכמבואר במק\"א19"
        },
        {
          "s": 16,
          "text": "הדוגמא על זה מענין הניסים,"
        },
        {
          "s": 17,
          "text": "שעם היותם למעלה מסדר ההשתלשלות,"
        },
        {
          "s": 18,
          "text": "מ\"מ יש בהם סדר והדרגה,"
        },
        {
          "s": 19,
          "text": "הנה עוד זאת,"
        },
        {
          "s": 20,
          "text": "בכדי שבחי' שעשועים העצמיים יומשכו למטה עד לבחינת ושעשועי את בני אדם,"
        },
        {
          "s": 21,
          "text": "הוצרך להיות בזה סדר והדרגה."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "וזהו מ\"ש20"
        },
        {
          "s": 1,
          "text": "קול דודי גו' מדלג על ההרים מקפץ על הגבעות."
        },
        {
          "s": 2,
          "text": "קול דודי קאי על בחינת קלא דלא אשתמע,"
        },
        {
          "s": 3,
          "text": "דהנה כתיב21"
        },
        {
          "s": 4,
          "text": "הקל קול,"
        },
        {
          "s": 5,
          "text": "קל חסר ו' וקול מלא ו',"
        },
        {
          "s": 6,
          "text": "שב' בחינות אלו הם קלא דאשתמע וקלא דלא אשתמע22."
        },
        {
          "s": 7,
          "text": "קלא דאשתמע הוא הקול הנמשך מהשכל,"
        },
        {
          "s": 8,
          "text": "או מהמדות,"
        },
        {
          "s": 9,
          "text": "או מהשכל כמו שמתגלה ע\"י המדות."
        },
        {
          "s": 10,
          "text": "וקול זה הוא קלא דפסיק,"
        },
        {
          "s": 11,
          "text": "דמאחר שענינו הוא גילוי השכל והמדות שהם מדודים ומוגבלים,"
        },
        {
          "s": 12,
          "text": "לכן כשמסתיימים הדברים שנמשכים ומתגלים על ידו,"
        },
        {
          "s": 13,
          "text": "נפסק במילא גם הקול."
        },
        {
          "s": 14,
          "text": "משא\"כ קלא דלא אשתמע הוא קול שלמעלה מהשכל,"
        },
        {
          "s": 15,
          "text": "שענינו בעבודת האדם הוא צעקת הלב שלמעלה מטעם ודעת,"
        },
        {
          "s": 16,
          "text": "ולמעלה הוא ענין המשכת בחינת עצם האור שמצד עצמו הוא למעלה מגדר גילוי."
        },
        {
          "s": 17,
          "text": "וקול זה הוא קלא דלא פסיק,"
        },
        {
          "s": 18,
          "text": "לפי שאין שייך בו הגבלה והפסק כלל."
        },
        {
          "s": 19,
          "text": "וזהו שבהקול דמתן תורה כתיב23"
        },
        {
          "s": 20,
          "text": "קול גדול ולא יסף24,"
        },
        {
          "s": 21,
          "text": "כי הגילוי דמ\"ת הוא המשכת העצם שלמעלה מגדר גילוי,"
        },
        {
          "s": 22,
          "text": "קלא דלא פסיק."
        },
        {
          "s": 23,
          "text": "ועוד זאת,"
        },
        {
          "s": 24,
          "text": "שכיון שהקול עצמו הוא קלא דלא פסיק שאין שייך בו הפסק ושינוי,"
        },
        {
          "s": 25,
          "text": "לכן גם הענינים שנמשכו על ידו,"
        },
        {
          "s": 26,
          "text": "דהיינו התורה שניתנה בקול זה,"
        },
        {
          "s": 27,
          "text": "אין שייך בה שינוי ח\"ו,"
        },
        {
          "s": 28,
          "text": "שזהו שהתורה לא תהי' מוחלפת לעולם25."
        },
        {
          "s": 29,
          "text": "והנה,"
        },
        {
          "s": 30,
          "text": "אף שקול זה הוא המשכה שלמעלה מגדר השתלשלות ולמעלה מגדר גילוי,"
        },
        {
          "s": 31,
          "text": "מ\"מ כתיב מדלג גו' מקפץ,"
        },
        {
          "s": 32,
          "text": "שהדילוג וקפיצה הוא ברגלים,"
        },
        {
          "s": 33,
          "text": "לפי שכל המשכה הוא ע\"י בחינת רגל,"
        },
        {
          "s": 34,
          "text": "בחינה התחתונה."
        },
        {
          "s": 35,
          "text": "והיינו,"
        },
        {
          "s": 36,
          "text": "שכלל זה שכל המשכה היא ע\"י בחינת רגל,"
        },
        {
          "s": 37,
          "text": "אינו רק בההמשכות שבסדר השתלשלות,"
        },
        {
          "s": 38,
          "text": "דפנימיות שבעליון נעשה מקיף לתחתון,"
        },
        {
          "s": 39,
          "text": "ונה\"י שבעליון נעשים מוחין לתחתון,"
        },
        {
          "s": 40,
          "text": "אלא כן הוא גם בהמשכות שלמעלה מהשתלשלות."
        },
        {
          "s": 41,
          "text": "וכמו ההמשכה שמבחינת עתיק,"
        },
        {
          "s": 42,
          "text": "שהיא רק מאות תי\"ו,"
        },
        {
          "s": 43,
          "text": "וכן גם ההמשכה מהאור שקודם הצמצום,"
        },
        {
          "s": 44,
          "text": "שהיא רק מבחינת מלכות שבמלכות,"
        },
        {
          "s": 45,
          "text": "וכן גם בביאת המשיח כתיב26"
        },
        {
          "s": 46,
          "text": "ועמדו רגליו."
        },
        {
          "s": 47,
          "text": "ובהמשכה זו עצמה ישנם ב' בחינות,"
        },
        {
          "s": 48,
          "text": "מדלג ומקפץ,"
        },
        {
          "s": 49,
          "text": "כדאיתא במשנה27"
        },
        {
          "s": 50,
          "text": "מדלג ברגלו אחת ומקפץ בב' רגלים."
        },
        {
          "s": 51,
          "text": "וההפרש ביניהם,"
        },
        {
          "s": 52,
          "text": "שכאשר מדלג ברגלו אחת,"
        },
        {
          "s": 53,
          "text": "הרי לבד זאת שהגוף נשאר במקומו וכל ההמשכה היא רק בבחינת רגל לבד,"
        },
        {
          "s": 54,
          "text": "הנה גם בבחינת רגל עצמו הרי רגלו אחת על הארץ,"
        },
        {
          "s": 55,
          "text": "ומה שנמשך הוא רק רגל אחת בלבד,"
        },
        {
          "s": 56,
          "text": "משא\"כ כשמקפץ בב' רגליים,"
        },
        {
          "s": 57,
          "text": "הנה אף שההמשכה היא ע\"י הרגלים,"
        },
        {
          "s": 58,
          "text": "מ\"מ,"
        },
        {
          "s": 59,
          "text": "הרי ע\"י רגליו נעתק כל גופו,"
        },
        {
          "s": 60,
          "text": "היינו שנמשך בכל עצמותו."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "וביאור החילוק בין שני הענינים דמדלג ומקפץ"
        },
        {
          "s": 2,
          "text": "(אף ששניהם הם המשכה מלמעלה מהשתלשלות)"
        },
        {
          "s": 3,
          "text": "יובן ע\"פ הידוע שגם במקיף שלמעלה מהשתלשלות ישנם ב' בחינות,"
        },
        {
          "s": 4,
          "text": "מקיף הקרוב ומקיף הרחוק."
        },
        {
          "s": 5,
          "text": "מקיף הקרוב היינו שיש לו שייכות אל הפנימי,"
        },
        {
          "s": 6,
          "text": "דהגם שהוא מקיף,"
        },
        {
          "s": 7,
          "text": "מ\"מ יש לו שייכות אל הפנימי,"
        },
        {
          "s": 8,
          "text": "ויתירה מזו,"
        },
        {
          "s": 9,
          "text": "שבהעלם כולל המקיף את הפנימי,"
        },
        {
          "s": 10,
          "text": "ואח\"כ כשנמשך ממנו הפנימי,"
        },
        {
          "s": 11,
          "text": "הרי המקיף שומר עליו."
        },
        {
          "s": 12,
          "text": "משא\"כ מקיף הרחוק אינו שייך אל הפנימי כלל."
        },
        {
          "s": 13,
          "text": "וביאור ענינם בנפש האדם,"
        },
        {
          "s": 14,
          "text": "הנה אמרו רז\"ל28"
        },
        {
          "s": 15,
          "text": "חמשה שמות נקראו לה נפש רוח נשמה חי' יחידה,"
        },
        {
          "s": 16,
          "text": "נפש רוח נשמה הם פנימיים,"
        },
        {
          "s": 17,
          "text": "וחי' יחידה הם מקיפים,"
        },
        {
          "s": 18,
          "text": "אלא שיחידה הוא מקיף הרחוק,"
        },
        {
          "s": 19,
          "text": "וחי' הוא מקיף הקרוב,"
        },
        {
          "s": 20,
          "text": "והיינו,"
        },
        {
          "s": 21,
          "text": "שהמקיף דחי' נרגש בהכחות פנימיים."
        },
        {
          "s": 22,
          "text": "וכמ\"ש גבי דניאל וראיתי אני לבדי את המראה והאנשים אשר היו עמי לא ראו את המראה אבל חרדה גדולה נפלה עליהם29,"
        },
        {
          "s": 23,
          "text": "ומקשה בגמרא30,"
        },
        {
          "s": 24,
          "text": "וכי מאחר דלא חזו מ\"ט איבעיתו,"
        },
        {
          "s": 25,
          "text": "ומשני,"
        },
        {
          "s": 26,
          "text": "אע\"ג דאינהו לא חזו מזלייהו חזו,"
        },
        {
          "s": 27,
          "text": "והיינו,"
        },
        {
          "s": 28,
          "text": "שאצל דניאל הי' זה בבחינת פנימיות,"
        },
        {
          "s": 29,
          "text": "בבחינת ראי',"
        },
        {
          "s": 30,
          "text": "כמ\"ש וראיתי,"
        },
        {
          "s": 31,
          "text": "אבל האנשים אשר עמי לא ראו את המראה,"
        },
        {
          "s": 32,
          "text": "אבל מ\"מ הורגש בהם המקיף,"
        },
        {
          "s": 33,
          "text": "שלכן חרדה גדולה נפלה עליהם."
        },
        {
          "s": 34,
          "text": "ולכן נקרא המקיף בשם מזל,"
        },
        {
          "s": 35,
          "text": "מלשון נוזל,"
        },
        {
          "s": 36,
          "text": "לפי שממנו נוזל ונוטף להכחות פנימיים."
        },
        {
          "s": 37,
          "text": "והנה,"
        },
        {
          "s": 38,
          "text": "הפעולה שהיתה מהרגש המקיף הוא ענין החרדה,"
        },
        {
          "s": 39,
          "text": "דחרדה מסלקת את הדמים31,"
        },
        {
          "s": 40,
          "text": "שהוא ענין הכיווץ וההעלם,"
        },
        {
          "s": 41,
          "text": "והיינו,"
        },
        {
          "s": 42,
          "text": "שמצד גילוי המקיף נעשה כיווץ והעלם בכל הכחות."
        },
        {
          "s": 43,
          "text": "והענין הוא,"
        },
        {
          "s": 44,
          "text": "דגם בכחות פנימיים אנו רואים שכאשר מתגלה כח עליון,"
        },
        {
          "s": 45,
          "text": "אזי כח התחתון הוא בהעלם."
        },
        {
          "s": 46,
          "text": "וכמו בהכחות חכמה ובינה,"
        },
        {
          "s": 47,
          "text": "הנה חכמה הוא ענין ראיית המהות,"
        },
        {
          "s": 48,
          "text": "וכאשר ישנו ראיית המהות,"
        },
        {
          "s": 49,
          "text": "אזי אין שייך ענין ההבנה והשגה כלל,"
        },
        {
          "s": 50,
          "text": "ורק כאשר נתעלם בחינת הראי' ונשאר רק הנחה שכלית"
        },
        {
          "s": 51,
          "text": "[והיינו,"
        },
        {
          "s": 52,
          "text": "שלהיותה בבחינת החכמה,"
        },
        {
          "s": 53,
          "text": "אין זה באופן של הבנה,"
        },
        {
          "s": 54,
          "text": "כי אם באופן של הנחה,"
        },
        {
          "s": 55,
          "text": "ומ\"מ הרי זו הנחה שכלית,"
        },
        {
          "s": 56,
          "text": "ששייכת כבר לשכל],"
        },
        {
          "s": 57,
          "text": "אזי אפשר שתהי' הבנה שכלית."
        },
        {
          "s": 58,
          "text": "ונמצא,"
        },
        {
          "s": 59,
          "text": "שגילוי כח הבינה הוא דוקא אחרי התעלמות החכמה,"
        },
        {
          "s": 60,
          "text": "אבל בגילוי החכמה,"
        },
        {
          "s": 61,
          "text": "הבינה היא בהעלם."
        },
        {
          "s": 62,
          "text": "וכן הוא גם בענין המוחין ומדות,"
        },
        {
          "s": 63,
          "text": "שגילוי המדות הוא דוקא אחרי שמתעלמים המוחין במיצר הגרון."
        },
        {
          "s": 64,
          "text": "ואם בכחות פנימיים כן הוא,"
        },
        {
          "s": 65,
          "text": "שכאשר מתגלה כח עליון,"
        },
        {
          "s": 66,
          "text": "אזי כח התחתון הוא בהעלם,"
        },
        {
          "s": 67,
          "text": "הרי מכ\"ש שכן הוא בגילוי המקיף,"
        },
        {
          "s": 68,
          "text": "שאז כל הכחות פנימיים הם בכיווץ והעלם."
        },
        {
          "s": 69,
          "text": "וכמו בכח הרצון,"
        },
        {
          "s": 70,
          "text": "שכאשר הרצון הוא בגילוי,"
        },
        {
          "s": 71,
          "text": "אזי אי אפשר שיהי' גילוי הכחות פנימיים,"
        },
        {
          "s": 72,
          "text": "כמו גילוי השכל."
        },
        {
          "s": 73,
          "text": "ויתירה מזה,"
        },
        {
          "s": 74,
          "text": "גם כאשר הרצון שייך לשכל,"
        },
        {
          "s": 75,
          "text": "והיינו שרוצה להתחכם,"
        },
        {
          "s": 76,
          "text": "מ\"מ,"
        },
        {
          "s": 77,
          "text": "כאשר הרצון מאיר בתוקף,"
        },
        {
          "s": 78,
          "text": "אי אפשר שיהי' אז גילוי השכל."
        },
        {
          "s": 79,
          "text": "וזהו שהפעולה שנעשית מזה שמזלייהו חזו הו\"ע חרדה גדולה נפלה עליהם,"
        },
        {
          "s": 80,
          "text": "כי,"
        },
        {
          "s": 81,
          "text": "מזל הוא מקיף דחי',"
        },
        {
          "s": 82,
          "text": "וע\"י גילוי המקיף מתעלמים כל כחות הפנימיים,"
        },
        {
          "s": 83,
          "text": "ולכן נפלה עליהם חרדה,"
        },
        {
          "s": 84,
          "text": "דענין החרדה שמסלקת את הדמים הוא התעלמות כל הכחות,"
        },
        {
          "s": 85,
          "text": "דכיון שהחיות מלובש בדם32,"
        },
        {
          "s": 86,
          "text": "הרי ע\"י סילוק הדם מתעלם כל החיות."
        },
        {
          "s": 87,
          "text": "ובפרטיות יותר,"
        },
        {
          "s": 88,
          "text": "הנה ההעלם שנעשה ע\"י סילוק הדם הוא בכל ג' הבחינות נפש רוח ונשמה המתלבשים בגוף."
        },
        {
          "s": 89,
          "text": "והענין הוא,"
        },
        {
          "s": 90,
          "text": "דבגוף האדם ישנם ג' אברים כלליים,"
        },
        {
          "s": 91,
          "text": "כמאמר33"
        },
        {
          "s": 92,
          "text": "תלת שליטין אינון מוחא לבא וכבדא,"
        },
        {
          "s": 93,
          "text": "שבהם מתלבשים ג' הבחינות נר\"ן,"
        },
        {
          "s": 94,
          "text": "נשמה במוח,"
        },
        {
          "s": 95,
          "text": "רוח בלב,"
        },
        {
          "s": 96,
          "text": "ונפש בכבד34."
        },
        {
          "s": 97,
          "text": "והנה,"
        },
        {
          "s": 98,
          "text": "התלבשות הנפש היא בהדם שבהכבד,"
        },
        {
          "s": 99,
          "text": "ופשיטא שע\"י סילוק הדמים מתעלמים כל הכחות השייכים לבחינת נפש."
        },
        {
          "s": 100,
          "text": "וגם רוח שבלב,"
        },
        {
          "s": 101,
          "text": "הנה הרוח שבחלל הימני35"
        },
        {
          "s": 102,
          "text": "קשור עם הרוח שבחלל השמאלי המלא דם35."
        },
        {
          "s": 103,
          "text": "וגם נשמה שבמוח,"
        },
        {
          "s": 104,
          "text": "הרי אנו רואים שבשעת התענית שאז הוא מיעוט הדמים,"
        },
        {
          "s": 105,
          "text": "אזי אינו יכול להבין ולהשכיל כדבעי."
        },
        {
          "s": 106,
          "text": "וכל זה הוא בבחי' מקיף הקרוב,"
        },
        {
          "s": 107,
          "text": "שנרגש בכחות הפנימיים,"
        },
        {
          "s": 108,
          "text": "משא\"כ מקיף הרחוק,"
        },
        {
          "s": 109,
          "text": "מקיף דיחידה,"
        },
        {
          "s": 110,
          "text": "הוא בריחוק מהכחות הפנימיים ואינו נרגש בהם."
        }
      ]
    }
  ]
}