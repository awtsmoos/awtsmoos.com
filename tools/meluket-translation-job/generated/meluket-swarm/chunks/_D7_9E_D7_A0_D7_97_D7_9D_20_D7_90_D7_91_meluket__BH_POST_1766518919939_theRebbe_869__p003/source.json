{
  "globalIndex": 1044,
  "owner": 44,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919939_theRebbe_869__p003",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919939_theRebbe_869__p003",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919939_theRebbe_869",
  "title": "מאמר ועתה ישראל תשכ\"ח",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ועד\"ז הוא בעבודת האדם,"
        },
        {
          "s": 1,
          "text": "שבכדי שיהי' חיבור דבחינת חי'"
        },
        {
          "s": 2,
          "text": "(מקיף)"
        },
        {
          "s": 3,
          "text": "עם בחינת נר\"נ"
        },
        {
          "s": 4,
          "text": "(פנימי),"
        },
        {
          "s": 5,
          "text": "שהאהבה דבכל נפשך תהי' נרגשת גם בכחות הפנימיים"
        },
        {
          "s": 6,
          "text": "[ועד\"ז חיבור דמוחין ומדות26],"
        },
        {
          "s": 7,
          "text": "הוא ע\"י העבודה דמס\"נ,"
        },
        {
          "s": 8,
          "text": "שמצד בחינת יחידה27."
        },
        {
          "s": 9,
          "text": "ויש לומר מהביאורים בזה,"
        },
        {
          "s": 10,
          "text": "דע\"י שמוסר את עצמו לאלקות,"
        },
        {
          "s": 11,
          "text": "ענינם של כל הכחות שלו הוא למלאות רצון הקב\"ה."
        },
        {
          "s": 12,
          "text": "וכיון שהמקיף והפנימי"
        },
        {
          "s": 13,
          "text": "[וכן המוחין והמדות]"
        },
        {
          "s": 14,
          "text": "ענינם הוא לא המציאות שלהם אלא למלאות רצון הקב\"ה,"
        },
        {
          "s": 15,
          "text": "לכן אינם סותרים זל\"ז ואדרבא מתחברים יחד."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וזהו שהתקנה לברך מאה ברכות בכל יום היתה דוקא כשמתו בכל יום מאה נפשות,"
        },
        {
          "s": 2,
          "text": "כי גילוי כח המס\"נ הוא ע\"י ההעלמות וההסתרים."
        },
        {
          "s": 3,
          "text": "[וע\"פ הידוע28"
        },
        {
          "s": 4,
          "text": "שבזמן הגלות,"
        },
        {
          "s": 5,
          "text": "ובפרט בדרא דעקבתא דמשיחא,"
        },
        {
          "s": 6,
          "text": "כח המס\"נ הוא בגילוי יותר מבזמן הבית]."
        },
        {
          "s": 7,
          "text": "ולכן,"
        },
        {
          "s": 8,
          "text": "התקנה לברך מאה ברכות היתה דוקא לאחרי שמתו ק' נפשות בכל יום,"
        },
        {
          "s": 9,
          "text": "כי זה שבכל יום מתו מאה נפשות"
        },
        {
          "s": 10,
          "text": "(דמאה נפשות הוא שלימות המספר)"
        },
        {
          "s": 11,
          "text": "הוא מפני שהיו אז במצב דהיפך החירות ממלאך המות29,"
        },
        {
          "s": 12,
          "text": "הוא היצה\"ר30,"
        },
        {
          "s": 13,
          "text": "ועי\"ז נתעורר אז כח המס\"נ שלהם."
        },
        {
          "s": 14,
          "text": "ולכן תיקנו אז לברך מאה ברכות,"
        },
        {
          "s": 15,
          "text": "שעל ידם נעשה החיבור דסובב וממלא,"
        },
        {
          "s": 16,
          "text": "כי ע\"י גילוי"
        },
        {
          "s": 17,
          "text": "(כח המס\"נ שמצד)"
        },
        {
          "s": 18,
          "text": "היחידה נעשה המשכת עתיק,"
        },
        {
          "s": 19,
          "text": "האל\"ף דמאה,"
        },
        {
          "s": 20,
          "text": "בחינת חד ולא בחושבן,"
        },
        {
          "s": 21,
          "text": "ועי\"ז נעשה החיבור דמה"
        },
        {
          "s": 22,
          "text": "(ממלא)"
        },
        {
          "s": 23,
          "text": "ומאה"
        },
        {
          "s": 24,
          "text": "(סובב),"
        },
        {
          "s": 25,
          "text": "אל תקרי מה אלא מאה."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש לבאר גם מאמר המדרש31"
        },
        {
          "s": 1,
          "text": "אין ועתה אלא לשון תשובה שנאמר ועתה ישראל מה ה' אלקיך שואל מעמך."
        },
        {
          "s": 2,
          "text": "וע\"פ הידוע32"
        },
        {
          "s": 3,
          "text": "שכל הפירושים שבאותו הפסוק שייכים זל\"ז,"
        },
        {
          "s": 4,
          "text": "מובן,"
        },
        {
          "s": 5,
          "text": "דזה שה' אלקיך שואל מעמך מה,"
        },
        {
          "s": 6,
          "text": "מאה ברכות,"
        },
        {
          "s": 7,
          "text": "שייך לענין התשובה,"
        },
        {
          "s": 8,
          "text": "ועתה."
        },
        {
          "s": 9,
          "text": "דכיון שהבעלי תשובה כובשים את יצרם יותר מהצדיקים33,"
        },
        {
          "s": 10,
          "text": "ובכדי שהאדם יוכל לעמוד נגד יצרו הוא ע\"י זכירת ענין המס\"נ34,"
        },
        {
          "s": 11,
          "text": "לכן,"
        },
        {
          "s": 12,
          "text": "עיקר גילוי כח המס\"נ הוא בבעלי תשובה."
        },
        {
          "s": 13,
          "text": "וזהו ועתה גו' מה ה' אלקיך שואל מעמך,"
        },
        {
          "s": 14,
          "text": "דע\"י גילוי המס\"נ שע\"י תשובה,"
        },
        {
          "s": 15,
          "text": "ועתה,"
        },
        {
          "s": 16,
          "text": "אפשר להיות הענין דמאה ברכות,"
        },
        {
          "s": 17,
          "text": "מה ה' אלקיך שואל מעמך."
        }
      ]
    }
  ]
}