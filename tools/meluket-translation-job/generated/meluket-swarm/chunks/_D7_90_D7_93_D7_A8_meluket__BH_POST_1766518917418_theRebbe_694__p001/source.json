{
  "globalIndex": 626,
  "owner": 26,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917418_theRebbe_694__p001",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917418_theRebbe_694__p001",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917418_theRebbe_694",
  "title": "מאמר וקבל היהודים תשי\"א",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "פורים ה'תשי\"א*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "וקבל היהודים את אשר החלו לעשות1,"
        },
        {
          "s": 1,
          "text": "ומבאר כ\"ק מו\"ח אדמו\"ר במאמרו ד\"ה זה2"
        },
        {
          "s": 2,
          "text": "(שיצא לאור עכשיו3)"
        },
        {
          "s": 3,
          "text": "שקבלו מה שהחלו בהזמן דמתן תורה."
        },
        {
          "s": 4,
          "text": "דזה שאמרו נעשה ונשמע היתה רק התחלה"
        },
        {
          "s": 5,
          "text": "(החלו לעשות),"
        },
        {
          "s": 6,
          "text": "ובימי אחשורוש"
        },
        {
          "s": 7,
          "text": "(בזמן גזירת המן)"
        },
        {
          "s": 8,
          "text": "היתה הקבלה,"
        },
        {
          "s": 9,
          "text": "וקבל היהודים4."
        },
        {
          "s": 10,
          "text": "ומדייק בזה,"
        },
        {
          "s": 11,
          "text": "שלכאורה הוא דבר פלא5,"
        },
        {
          "s": 12,
          "text": "שהרי במתן תורה היו ישראל בתכלית העילוי,"
        },
        {
          "s": 13,
          "text": "הן בגשמיות שהיו אז במעמד ומצב משובח ביותר בענין החירות6,"
        },
        {
          "s": 14,
          "text": "והן ברוחניות שהי' אז אצלם גילוי אלקות בדרגא הכי נעלית7,"
        },
        {
          "s": 15,
          "text": "ובימי אחשורוש היו ישראל בתכלית הירידה,"
        },
        {
          "s": 16,
          "text": "דנוסף לההעלם והסתר שבכל גלות אשר החושך יכסה ארץ8"
        },
        {
          "s": 17,
          "text": "בריבוי צמצומים והעלמות והסתרים,"
        },
        {
          "s": 18,
          "text": "הנה אז"
        },
        {
          "s": 19,
          "text": "(בזמן גזירת המן)"
        },
        {
          "s": 20,
          "text": "הי' ההעלם וההסתר עוד יותר9,"
        },
        {
          "s": 21,
          "text": "וגם בגשמיות היו אז בשפל המצב בתכלית,"
        },
        {
          "s": 22,
          "text": "שהיתה הגזירה להשמיד להרוג ולאבד ח\"ו את כל היהודים מנער ועד זקן טף ונשים ביום אחד10,"
        },
        {
          "s": 23,
          "text": "ואעפ\"כ,"
        },
        {
          "s": 24,
          "text": "בזמן מתן תורה,"
        },
        {
          "s": 25,
          "text": "כשהיו ישראל בתכלית העילוי,"
        },
        {
          "s": 26,
          "text": "היתה רק ההתחלה"
        },
        {
          "s": 27,
          "text": "(החלו לעשות),"
        },
        {
          "s": 28,
          "text": "ובזמן גזירת המן,"
        },
        {
          "s": 29,
          "text": "כשהיו בתכלית השפלות,"
        },
        {
          "s": 30,
          "text": "אז דוקא קבלו מה שהחלו במתן תורה."
        },
        {
          "s": 31,
          "text": "ומבאר בזה11,"
        },
        {
          "s": 32,
          "text": "שבזמן הגזירה,"
        },
        {
          "s": 33,
          "text": "הי' קיום התומ\"צ שלהם במס\"נ."
        },
        {
          "s": 34,
          "text": "[ולהעיר,"
        },
        {
          "s": 35,
          "text": "דבתו\"א12"
        },
        {
          "s": 36,
          "text": "מבואר,"
        },
        {
          "s": 37,
          "text": "דהמס\"נ שלהם שהיתה אז היא שבאם היו ממירים דתם ח\"ו לא היו עושים להם כלום,"
        },
        {
          "s": 38,
          "text": "כי הגזירה היתה רק על היהודים,"
        },
        {
          "s": 39,
          "text": "ואעפ\"כ לא עלתה על דעתם מחשבת חוץ ח\"ו."
        },
        {
          "s": 40,
          "text": "ומבאר,"
        },
        {
          "s": 41,
          "text": "שהמס\"נ שלהם היתה"
        },
        {
          "s": 42,
          "text": "(לא רק שלא לכפור ח\"ו,"
        },
        {
          "s": 43,
          "text": "אלא שמסרו נפשם גם)"
        },
        {
          "s": 44,
          "text": "על קיום התומ\"צ13,"
        },
        {
          "s": 45,
          "text": "ועד שהקהילו קהלות ברבים ללמוד תורה במס\"נ]."
        },
        {
          "s": 46,
          "text": "והתעוררות המס\"נ שלהם היתה ע\"י מרדכי היהודי,"
        },
        {
          "s": 47,
          "text": "משה שבדורו14,"
        },
        {
          "s": 48,
          "text": "שהקהיל קהלות ברבים לחזק את אמונתם."
        },
        {
          "s": 49,
          "text": "ועיקר15"
        },
        {
          "s": 50,
          "text": "עבודתו של מרדכי היתה בלימוד התורה עם תינוקות של בית רבן,"
        },
        {
          "s": 51,
          "text": "שהם היסוד של כל ישראל"
        },
        {
          "s": 52,
          "text": "[כמבואר בארוכה בהמאמר16"
        },
        {
          "s": 53,
          "text": "בגודל מעלת הבל תינוקות של בית רבן],"
        },
        {
          "s": 54,
          "text": "כדאיתא במדרש17"
        },
        {
          "s": 55,
          "text": "שקיבץ מרדכי היהודי כ\"ב אלף תלמידים18"
        },
        {
          "s": 56,
          "text": "ולימדם תורה במס\"נ,"
        },
        {
          "s": 57,
          "text": "עד שכשבא המן הרשע ומרדכי אמר להם ברחו לכם שלא תכוו בגחלתי אמרו אתך אנחנו בין לחיים ובין למות,"
        },
        {
          "s": 58,
          "text": "שקבלו עליהם כל עונש שיהי' אך ורק שלא להפרד מהתורה."
        },
        {
          "s": 59,
          "text": "וזהו וקבל היהודים את אשר החלו לעשות,"
        },
        {
          "s": 60,
          "text": "שבמתן תורה היתה רק ההתחלה ובזמן גזירת המן היתה הקבלה,"
        },
        {
          "s": 61,
          "text": "כי ע\"י שהי' להם אז מס\"נ בפועל על תומ\"צ נתעלו"
        },
        {
          "s": 62,
          "text": "(בענין אחד)"
        },
        {
          "s": 63,
          "text": "למדריגה נעלית יותר מכמו שהיו בזמן מתן תורה,"
        },
        {
          "s": 64,
          "text": "ולכן19"
        },
        {
          "s": 65,
          "text": "אז דוקא היתה הקבלה,"
        },
        {
          "s": 66,
          "text": "וקבל היהודים."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "וצריך להבין,"
        },
        {
          "s": 2,
          "text": "הרי נקודת הביאור בהמאמר היא דזה שדוקא בזמן הגזירה היתה הקבלה הוא מצד המס\"נ שלהם,"
        },
        {
          "s": 3,
          "text": "ומה נוגע כאן שהתעוררות המס\"נ שלהם היתה ע\"י מרדכי ושעיקר עבודתו של מרדכי היתה לימוד התורה עם תינוקות של בית רבן."
        },
        {
          "s": 4,
          "text": "וגם צריך ביאור במ\"ש בהדיוק"
        },
        {
          "s": 5,
          "text": "(בהתחלת המאמר)"
        },
        {
          "s": 6,
          "text": "דזה שבזמן מתן תורה היו ישראל בתכלית העילוי ובזמן הגזירה היו בתכלית השפלות,"
        },
        {
          "s": 7,
          "text": "הוא הן ברוחניות והן בגשמיות."
        },
        {
          "s": 8,
          "text": "דלכאורה,"
        },
        {
          "s": 9,
          "text": "להדיוק שבהמאמר,"
        },
        {
          "s": 10,
          "text": "דהאיך יתכן שבזמן שהיו בתכלית העילוי היתה רק ההתחלה ובעת שהיו בתכלית השפלות אז דוקא היתה הקבלה,"
        },
        {
          "s": 11,
          "text": "נוגע העילוי והשפלות במצב הרוחני שלהם,"
        },
        {
          "s": 12,
          "text": "ולמה מביא בהמאמר שהעילוי שבזמן מתן תורה והשפלות שבזמן הגזירה היו גם בגשמיות."
        }
      ]
    }
  ]
}