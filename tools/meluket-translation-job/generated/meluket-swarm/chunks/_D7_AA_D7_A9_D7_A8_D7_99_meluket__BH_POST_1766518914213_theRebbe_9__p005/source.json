{
  "globalIndex": 92,
  "owner": 42,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914213_theRebbe_9__p005",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914213_theRebbe_9__p005",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914213_theRebbe_9",
  "title": "מאמר בסוכות תשבו תשל\"ח",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "והנה,"
        },
        {
          "s": 2,
          "text": "כיון שהיא התחלת השנה וצריכים להמשיך את כל סדר ההשתלשלות מחדש וגם באופן גלוי,"
        },
        {
          "s": 3,
          "text": "לכן צריך להמשיך מבחי' אחת."
        },
        {
          "s": 4,
          "text": "והמשכה זו"
        },
        {
          "s": 5,
          "text": "(בבחי' גילוי)"
        },
        {
          "s": 6,
          "text": "נעשית ביום חגינו"
        },
        {
          "s": 7,
          "text": "(בחג הסוכות)"
        },
        {
          "s": 8,
          "text": "כנ\"ל,"
        },
        {
          "s": 9,
          "text": "ולכן גם התחלת העבודה דסוכות צ\"ל בהענין דסוכה אחת"
        },
        {
          "s": 10,
          "text": "(שהסוכה אחת שייכת לעבודת יום הכפורים בג' בחינות אחת שבעש\"ן,"
        },
        {
          "s": 11,
          "text": "כנ\"ל),"
        },
        {
          "s": 12,
          "text": "כי ע\"י העבודה דסוכה אחת הנה מגיעים לבחי' אחת שלמעלה לגמרי אפי' מכל גדר ענין המספר"
        },
        {
          "s": 13,
          "text": "(אלא שכיון שאין לנו שם אחר לקרותו משו\"ז קורין אותו אחת),"
        },
        {
          "s": 14,
          "text": "לעצומ\"ה ית'."
        },
        {
          "s": 15,
          "text": "דאחת פי' יחידה כדאיתא בתוס'51,"
        },
        {
          "s": 16,
          "text": "והשם יחידה הוא ע\"ש שמקבלת מיחיד."
        },
        {
          "s": 17,
          "text": "וכמו\"כ הוא בבחי' סוכה אחת שענינה הו\"ע היחידה,"
        },
        {
          "s": 18,
          "text": "כנ\"ל."
        },
        {
          "s": 19,
          "text": "וכיון שענין הסוכה שרשה מבחי' אחת,"
        },
        {
          "s": 20,
          "text": "לכן נמשך למטה שראוים כל ישראל לישב בסוכה אחת,"
        },
        {
          "s": 21,
          "text": "שהסוכה היא למעלה מכל התחלקות היות ששרשה הוא בבחי' שלמעלה מהתחלקות."
        },
        {
          "s": 22,
          "text": "ומצד טעם זה גופא נמשך בחי' הסוכה אחת גם בעוה\"ז התחתון שאין תחתון למטה ממנו,"
        },
        {
          "s": 23,
          "text": "כיון שבערך עצומ\"ה ית' אין שייך לחלק בין עליון לתחתון."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "והנה,"
        },
        {
          "s": 3,
          "text": "המשכת העצמות בגלוי"
        },
        {
          "s": 4,
          "text": "(בחי' סוכה אחת)"
        },
        {
          "s": 5,
          "text": "יהי' רק לע\"ל,"
        },
        {
          "s": 6,
          "text": "שהרי אז יהי' ונגלה כבוד הוי' וראו כל בשר יחדיו52,"
        },
        {
          "s": 7,
          "text": "ולמעלה מזה יהי' גם ולא יכנף עוד מוריך והיו עיניך רואות את מוריך53,"
        },
        {
          "s": 8,
          "text": "כדאיתא בתניא54."
        },
        {
          "s": 9,
          "text": "אמנם למעלה מזה הוא בחי' אחת,"
        },
        {
          "s": 10,
          "text": "שענינה הוא המשכת העצמות למטה בגלוי,"
        },
        {
          "s": 11,
          "text": "ומזה מובן שגם הגילוי דסוכה אחת יהי' רק לע\"ל."
        },
        {
          "s": 12,
          "text": "ועפי\"ז מובן למה דרשו רז\"ל שראוים כל ישראל לישב בסוכה אחת ממ\"ש בסיום הכתוב כל האזרח בישראל גו' דוקא,"
        },
        {
          "s": 13,
          "text": "ולא דרשו כן מההתחלה דבסוכות תשבו שבעת ימים,"
        },
        {
          "s": 14,
          "text": "כי בסוכות תשבו שבעת ימים קאי על העבודה בזמן הזה בהשיתא אלפי שני דהוה עלמא,"
        },
        {
          "s": 15,
          "text": "ובזמן הזה הרי עדיין לא נמשך בחי' אחת בגלוי."
        },
        {
          "s": 16,
          "text": "וגילוי זה יהי' רק לע\"ל ומשו\"ז דרשו זה ממ\"ש כל האזרח בישראל גו',"
        },
        {
          "s": 17,
          "text": "כי אזרח הוא ל' עתיד,"
        },
        {
          "s": 18,
          "text": "דהיינו מה שיזרח לע\"ל,"
        },
        {
          "s": 19,
          "text": "כמבואר בכמה דרושים55."
        },
        {
          "s": 20,
          "text": "וכן הוא גם ע\"פ כללי הדקדוק שאותיות איתן מורים על העתיד56."
        },
        {
          "s": 21,
          "text": "וזהו כל האזרח בישראל גו',"
        },
        {
          "s": 22,
          "text": "שלע\"ל תהי' זריחה דבחי' אחת,"
        },
        {
          "s": 23,
          "text": "ולכן ישבו אז כל ישראל בסוכה אחת."
        },
        {
          "s": 24,
          "text": "אמנם,"
        },
        {
          "s": 25,
          "text": "אעפ\"כ גם עכשיו,"
        },
        {
          "s": 26,
          "text": "בהשית אלפי שני דהוה עלמא,"
        },
        {
          "s": 27,
          "text": "מאירה הארה וזריחה מבחי' אחת שתהי' בגילוי לע\"ל."
        },
        {
          "s": 28,
          "text": "ועוד זאת,"
        },
        {
          "s": 29,
          "text": "גילוי בחי' אחת שלעתיד נמשך"
        },
        {
          "s": 30,
          "text": "(כשאר הגילויים דלעתיד57)"
        },
        {
          "s": 31,
          "text": "ע\"י מעשינו ועבודתינו דעתה דוקא."
        },
        {
          "s": 32,
          "text": "ומזה מובן שגם עתה ישנו מעין והארה מבחי' אחת58."
        },
        {
          "s": 33,
          "text": "וזהו משארז\"ל שראוים כל ישראל לישב בסוכה אחת,"
        },
        {
          "s": 34,
          "text": "שקאי על זמן הזה,"
        },
        {
          "s": 35,
          "text": "שגם בזמן הזה ישנו הענין שראוים כל ישראל לישב בסוכה אחת"
        },
        {
          "s": 36,
          "text": "(מעין דהישיבה בפועל לע\"ל)."
        },
        {
          "s": 37,
          "text": "אלא שזה גופא שבזמן הזה ראוים כו' לישב נלמד ממ\"ש כל האזרח גו'"
        },
        {
          "s": 38,
          "text": "(ל' עתיד),"
        },
        {
          "s": 39,
          "text": "היינו שלוקח הכח ונמשך מהזריחה שתהי' לע\"ל,"
        },
        {
          "s": 40,
          "text": "שיהי' גילוי העצמות,"
        },
        {
          "s": 41,
          "text": "כמ\"ש לא יכנף עוד מוריך."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ב)"
        },
        {
          "s": 2,
          "text": "והנה ע\"פ הנ\"ל יובן גם הסדר בהעבודות דראש השנה יום הכפורים וסוכות."
        },
        {
          "s": 3,
          "text": "והענין הוא,"
        },
        {
          "s": 4,
          "text": "ע\"ד הסדר בתומ\"צ דכללות ופרטות נאמרו,"
        },
        {
          "s": 5,
          "text": "דתחלה הענינים הם באופן של כלל ואח\"כ נמשכים לפרטים,"
        },
        {
          "s": 6,
          "text": "הנה כמו\"כ הוא בסדר העבודה דראש השנה יום הכפורים וסוכות."
        },
        {
          "s": 7,
          "text": "דהנה התורה בשלימותה היא בריבוי פרטים,"
        },
        {
          "s": 8,
          "text": "כמ\"ש59"
        },
        {
          "s": 9,
          "text": "ששים המה מלכות ושמנים פלגשים ועלמות אין מספר,"
        },
        {
          "s": 10,
          "text": "ודרז\"ל60"
        },
        {
          "s": 11,
          "text": "דששים המה מלכות אלו המשניות,"
        },
        {
          "s": 12,
          "text": "ושמנים פלגשים אלו הברייתות ועלמות אין מספר אלו דרשות חז\"ל ומימרות ה"
        },
        {
          "s": 13,
          "text": "(תנאים ו)"
        },
        {
          "s": 14,
          "text": "אמוראים."
        },
        {
          "s": 15,
          "text": "ולפנ\"ז ישנה התורה כמו שהיא בתושב\"כ,"
        },
        {
          "s": 16,
          "text": "כל' הרגיל בש\"ס מנא הני מילי דאמר קרא."
        },
        {
          "s": 17,
          "text": "דכ\"ז הו\"ע התורה כמו שהיא באופן של פרטים ופרטי פרטים."
        },
        {
          "s": 18,
          "text": "אמנם ישנו גם כמו שהתורה היא באופן של כלל,"
        },
        {
          "s": 19,
          "text": "דכללותי' ודקדוקי' כולם נאמרו מסיני61."
        },
        {
          "s": 20,
          "text": "ובאמירת הכללים והפרטים עצמם,"
        },
        {
          "s": 21,
          "text": "הנה תחלה נאמרו הכללים,"
        },
        {
          "s": 22,
          "text": "ואח\"כ הפרטים."
        },
        {
          "s": 23,
          "text": "דתחלה נאמרו עשה\"ד שבהם נכללו כל פרטי התורה."
        },
        {
          "s": 24,
          "text": "ועשה\"ד עצמן כלולים בהדברות אנכי ולא יהי' לך,"
        },
        {
          "s": 25,
          "text": "כדאיתא בתניא62."
        },
        {
          "s": 26,
          "text": "וב' דברות אלו כלולות63"
        },
        {
          "s": 27,
          "text": "באנכי שהיא תיבה הראשונה שבדיבור הראשון."
        },
        {
          "s": 28,
          "text": "ובאנכי גופא אות אל\"ף הוא הר\"ת שלה."
        },
        {
          "s": 29,
          "text": "ובאל\"ף זו כלולים כל כללי התורה."
        },
        {
          "s": 30,
          "text": "דאות אל\"ף מורה על ענין של כלל,"
        },
        {
          "s": 31,
          "text": "דהנה איתא בירושלמי64"
        },
        {
          "s": 32,
          "text": "שהדיבור דאנכי נרמז במ\"ש65"
        },
        {
          "s": 33,
          "text": "שמע ישראל ה' אלקינו,"
        },
        {
          "s": 34,
          "text": "וידוע בביאור תיבת אחד שהח' מרמזת לז' רקיעים וארץ והד' לד' רוחות העולם,"
        },
        {
          "s": 35,
          "text": "והא' שלפניהם היא כנגד הקב\"ה אלופו של עולם,"
        },
        {
          "s": 36,
          "text": "כמובא בב\"י66"
        },
        {
          "s": 37,
          "text": "מהסמ\"ק,"
        },
        {
          "s": 38,
          "text": "כמובא ומבואר בכ\"מ67."
        },
        {
          "s": 39,
          "text": "ומזה מובן שהאל\"ף דאנכי"
        },
        {
          "s": 40,
          "text": "(השייך לאחד דשמע ישראל)"
        },
        {
          "s": 41,
          "text": "הוא כלל הכולל את כל התורה כולה."
        }
      ]
    }
  ]
}