{
  "globalIndex": 984,
  "owner": 34,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919577_theRebbe_550__p005",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919577_theRebbe_550__p005",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919577_theRebbe_550",
  "title": "מאמר הללויה שירו להוי' גו' תשט\"ז",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יובן ההפרש בין גאולת מצרים לגאולה העתידה,"
        },
        {
          "s": 1,
          "text": "דעם היות שבגאולה העתידה כתיב וכתתו חרבותם לאתים,"
        },
        {
          "s": 2,
          "text": "מ\"מ,"
        },
        {
          "s": 3,
          "text": "בגאולת מצרים כתיב וחמושים עלו,"
        },
        {
          "s": 4,
          "text": "והיינו לפי שלעתיד כתיב53"
        },
        {
          "s": 5,
          "text": "ואת רוח הטומאה אעביר מן הארץ,"
        },
        {
          "s": 6,
          "text": "משא\"כ בגאולת מצרים הי' הרע בתקפו עדיין,"
        },
        {
          "s": 7,
          "text": "כמבואר בתניא54"
        },
        {
          "s": 8,
          "text": "בענין כי ברח העם55"
        },
        {
          "s": 9,
          "text": "שזהו לפי שהרע הי' בתקפו,"
        },
        {
          "s": 10,
          "text": "אלא שכיון שהגאולה היתה צריכה להיות כהרף עין56,"
        },
        {
          "s": 11,
          "text": "לא רצו להתעסק"
        },
        {
          "s": 12,
          "text": "(טשעפען זיך)"
        },
        {
          "s": 13,
          "text": "עם זה,"
        },
        {
          "s": 14,
          "text": "וכיון שהי' עדיין רע לכן הצטרכו לכלי זיין,"
        },
        {
          "s": 15,
          "text": "משא\"כ לעתיד שאת רוח הטומאה אעביר מן הארץ,"
        },
        {
          "s": 16,
          "text": "אזי וכתתו חרבותם לאתים."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "והנה57 בגאולה העתידה יהי',"
        },
        {
          "s": 1,
          "text": "בכללות,"
        },
        {
          "s": 2,
          "text": "ב' מדריגות,"
        },
        {
          "s": 3,
          "text": "בזמן וגם בנפש."
        },
        {
          "s": 4,
          "text": "דלעמי הארץ או כמ\"ש באגה\"ק לערב רב58,"
        },
        {
          "s": 5,
          "text": "ובהתחלת זמן הגאולה יהי' כן בכל ישראל,"
        },
        {
          "s": 6,
          "text": "ע\"ד מרז\"ל59"
        },
        {
          "s": 7,
          "text": "אין בין העוה\"ז לימות המשיח אלא שעבוד מלכיות בלבד ויהי' צורך בחרב כו',"
        },
        {
          "s": 8,
          "text": "אמנם ת\"ח וכמ\"ש באגה\"ק לישראל שאינם מערב רב,"
        },
        {
          "s": 9,
          "text": "ואח\"כ יהי' כן בכלל,"
        },
        {
          "s": 10,
          "text": "אשר את רוח הטומאה אעביר מן הארץ לא יצטרכו לחרב,"
        },
        {
          "s": 11,
          "text": "ועז\"נ וכתתו חרבותם לאתים גו'."
        },
        {
          "s": 12,
          "text": "וזהו אומרו רוממות אל בגרונם וחרב פיפיות בידם,"
        },
        {
          "s": 13,
          "text": "דאף אשר מדבר בלעתיד לבוא,"
        },
        {
          "s": 14,
          "text": "כמ\"ש בפתיחת המזמור שירו להוי' שיר חדש תהלתו בקהל חסידים וכנ\"ל,"
        },
        {
          "s": 15,
          "text": "מ\"מ הנה בתחילת זמן הגאולה יהי' צורך בכלי זיין."
        },
        {
          "s": 16,
          "text": "וע\"ז אומר שיהי' רוממות א-ל בגרונם וחרב פיפיות בידם,"
        },
        {
          "s": 17,
          "text": "לעשות נקמה בגוים,"
        },
        {
          "s": 18,
          "text": "שיהיו עוד הגוים קודם שיתבררו לעבדו שכם אחד,"
        },
        {
          "s": 19,
          "text": "וגם ע\"ד המבואר בלקו\"ת60"
        },
        {
          "s": 20,
          "text": "ע\"פ כל גוים סבבוני61"
        },
        {
          "s": 21,
          "text": "שהוא גוי אשר בקרבך62"
        },
        {
          "s": 22,
          "text": "הגוף ונה\"ב,"
        },
        {
          "s": 23,
          "text": "ויצטרכו לחרב פיפיות בידם."
        },
        {
          "s": 24,
          "text": "ואח\"כ בשלימות הגאולה וכתתו חרבותם לאתים גו' ולא ישא גוי אל גוי חרב,"
        },
        {
          "s": 25,
          "text": "כי את רוח הטומאה אעביר מן הארץ,"
        },
        {
          "s": 26,
          "text": "ונתתי שלום בארץ63"
        },
        {
          "s": 27,
          "text": "ע\"י שר שלום64"
        },
        {
          "s": 28,
          "text": "דוד65"
        },
        {
          "s": 29,
          "text": "מלך המשיח,"
        },
        {
          "s": 30,
          "text": "בהגאולה העתידה,"
        },
        {
          "s": 31,
          "text": "במהרה בימינו."
        }
      ]
    }
  ]
}