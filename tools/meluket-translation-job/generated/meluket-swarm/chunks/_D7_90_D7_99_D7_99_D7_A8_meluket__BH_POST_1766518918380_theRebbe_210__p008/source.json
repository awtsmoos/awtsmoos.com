  "owner": 31,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918380_theRebbe_210__p008",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918380_theRebbe_210__p008",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918380_theRebbe_210",
  "title": "מאמר דבר אל..קדושים תהיו תשכ\"א",
  "part": 8,
  "sections": [
    {
      "v": 21,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ג)"
        },
        {
          "s": 2,
          "text": "וזהו קדושים תהיו כי קדוש אני,"
        },
        {
          "s": 3,
          "text": "קדושתי למעלה מקדושתכם,"
        },
        {
          "s": 4,
          "text": "ומבאר בלקו\"ת דקדושתי שלמעלה מקדושתכם נמשכת שלא על ידי אתערותא דלתתא,"
        },
        {
          "s": 5,
          "text": "הגם שהיא נמשכת על ידי עבודת התשובה,"
        },
        {
          "s": 6,
          "text": "כי ענין עבודת התשובה הוא שאינו מציאות,"
        },
        {
          "s": 7,
          "text": "ובמילא אין זה ענין של אתערותא דלתתא."
        },
        {
          "s": 8,
          "text": "וזהו מה שמקדים במדרש הענין דגדולתי שלמעלה מגדולתכם"
        },
        {
          "s": 9,
          "text": "(אף שאין זה שייך לכאורה לפסוק זה),"
        },
        {
          "s": 10,
          "text": "דכמו שגדולתי,"
        },
        {
          "s": 11,
          "text": "אף שהיא למעלה מגדולתכם,"
        },
        {
          "s": 12,
          "text": "היא ענין הגילוי"
        },
        {
          "s": 13,
          "text": "(ושייכת להמטה),"
        },
        {
          "s": 14,
          "text": "עד\"ז יהי' גם בההמשכה דבחינת קדושתי,"
        },
        {
          "s": 15,
          "text": "שתהי' בגילוי בהעולם"
        },
        {
          "s": 16,
          "text": "(ושיהי' בזה גם המעלה דאתערותא דלתתא),"
        },
        {
          "s": 17,
          "text": "שעי\"ז תושלם הכוונה דדירה בתחתונים."
        }
      ]
    }
  ]
}