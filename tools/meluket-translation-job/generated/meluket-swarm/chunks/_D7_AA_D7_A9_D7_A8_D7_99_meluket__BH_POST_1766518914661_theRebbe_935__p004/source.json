{
  "globalIndex": 161,
  "owner": 11,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914661_theRebbe_935__p004",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914661_theRebbe_935__p004",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914661_theRebbe_935",
  "title": "מאמר כנשר יעיר קנו תשכ\"ב",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ויובן בהקדם ביאור ההפרש בין שרפים לחיות ואופנים65,"
        },
        {
          "s": 1,
          "text": "דהנה,"
        },
        {
          "s": 2,
          "text": "השרפים עומדים ממעל לו66,"
        },
        {
          "s": 3,
          "text": "ואומרים קדוש גו'67,"
        },
        {
          "s": 4,
          "text": "לפי שמעמדם בעולם הבריאה,"
        },
        {
          "s": 5,
          "text": "דאימא עילאה"
        },
        {
          "s": 6,
          "text": "(בינה)"
        },
        {
          "s": 7,
          "text": "מקננא בכורסייא68,"
        },
        {
          "s": 8,
          "text": "ולכן משיגים הם איך שאוא\"ס קדוש ומובדל כו',"
        },
        {
          "s": 9,
          "text": "ולכן אין אצלם ענין הרעש,"
        },
        {
          "s": 10,
          "text": "כיון שבא בהשגתם כו'."
        },
        {
          "s": 11,
          "text": "משא\"כ חיות הקודש שמעמדם בעולם היצירה,"
        },
        {
          "s": 12,
          "text": "שאין מאיר שם בחי' הבינה עצמה"
        },
        {
          "s": 13,
          "text": "(כבעולם הבריאה),"
        },
        {
          "s": 14,
          "text": "אלא ע\"י התלבשותה בשית ספירן שמקננן ביצירה68,"
        },
        {
          "s": 15,
          "text": "אינם משיגים כו',"
        },
        {
          "s": 16,
          "text": "ומצד העדר ההשגה בגלל ההעלם והסתר שבעולם היצירה לגבי עולם הבריאה,"
        },
        {
          "s": 17,
          "text": "נעשה אצלם ענין הרעש."
        },
        {
          "s": 18,
          "text": "ובפרט האופנים שהם למטה יותר,"
        },
        {
          "s": 19,
          "text": "כמ\"ש69"
        },
        {
          "s": 20,
          "text": "אופן אחד בארץ,"
        },
        {
          "s": 21,
          "text": "ותרגומו מלרע,"
        },
        {
          "s": 22,
          "text": "ומבואר בלקו\"ת"
        },
        {
          "s": 23,
          "text": "(בפרשת השבוע70)"
        },
        {
          "s": 24,
          "text": "שזהו שורש ומקור שע\"י ריבוי השתלשלות יתהוה ממנו בחינת רע,"
        },
        {
          "s": 25,
          "text": "הרי אצלם הרעש הוא גדול עוד יותר."
        },
        {
          "s": 26,
          "text": "והנה,"
        },
        {
          "s": 27,
          "text": "רעש אותיות שֵׂער"
        },
        {
          "s": 28,
          "text": "(בשי\"ן שמאלית),"
        },
        {
          "s": 29,
          "text": "ואותיות שַׁער"
        },
        {
          "s": 30,
          "text": "(בשי\"ן ימנית)."
        },
        {
          "s": 31,
          "text": "שׂער"
        },
        {
          "s": 32,
          "text": "(בשמאל)"
        },
        {
          "s": 33,
          "text": "הו\"ע השערות,"
        },
        {
          "s": 34,
          "text": "שמורה על מיעוט החיות ע\"י ריבוי הצמצומים,"
        },
        {
          "s": 35,
          "text": "עד כדי כך,"
        },
        {
          "s": 36,
          "text": "שגם כאשר חותכים את השערות אינו מרגיש כאב."
        },
        {
          "s": 37,
          "text": "דהנה,"
        },
        {
          "s": 38,
          "text": "ידוע71"
        },
        {
          "s": 39,
          "text": "שהיפך התענוג נרגש יותר מענין התענוג72,"
        },
        {
          "s": 40,
          "text": "ולכן,"
        },
        {
          "s": 41,
          "text": "מזה שאינו מרגיש כאב כשחותכים השערות מוכח ביותר גודל צמצום החיות שבשערות."
        },
        {
          "s": 42,
          "text": "ושׁער"
        },
        {
          "s": 43,
          "text": "(בימין)"
        },
        {
          "s": 44,
          "text": "הוא כמ\"ש73"
        },
        {
          "s": 45,
          "text": "זה השער לה',"
        },
        {
          "s": 46,
          "text": "כמשל שער רחב"
        },
        {
          "s": 47,
          "text": "(לא רק נתיב קצר)"
        },
        {
          "s": 48,
          "text": "המשמש לכניסה וליציאה."
        },
        {
          "s": 49,
          "text": "וזהו הענין דרעש אותיות שׂער ואותיות שׁער בעבודת האדם,"
        },
        {
          "s": 50,
          "text": "שכאשר האדם מתבונן שכללות האור האלקי המלובש בעולמות הוא אור מצומצם ביותר"
        },
        {
          "s": 51,
          "text": "(עד\"מ השערות),"
        },
        {
          "s": 52,
          "text": "ובבחי' האור המלובש בעולמות גופא ישנם ריבוי צמצומים עד לבחי' אופן אחד בארץ,"
        },
        {
          "s": 53,
          "text": "שזהו שורש מציאות הרע"
        },
        {
          "s": 54,
          "text": "(כנ\"ל),"
        },
        {
          "s": 55,
          "text": "ועד לריבוי הצמצומים שיומשך החיות למטה ביותר,"
        },
        {
          "s": 56,
          "text": "למטה גם מהגילוי שבבחי' האופנים,"
        },
        {
          "s": 57,
          "text": "הנה ע\"י התבוננות זו נעשה רעש גדול"
        },
        {
          "s": 58,
          "text": "(עוד יותר מהרעש שבבחי' האופנים),"
        },
        {
          "s": 59,
          "text": "ועי\"ז נעשה שׁער רחב לכל ההעלאות וההמשכות."
        },
        {
          "s": 60,
          "text": "וזהו גם ענין התורה שירדה למטה ונתלבשה בשכל אנושי,"
        },
        {
          "s": 61,
          "text": "שענין זה נעשה ע\"י ריבוי הצמצומים,"
        },
        {
          "s": 62,
          "text": "שהו\"ע השערות"
        },
        {
          "s": 63,
          "text": "(שׂער בשמאל),"
        },
        {
          "s": 64,
          "text": "ועז\"נ74"
        },
        {
          "s": 65,
          "text": "קוצותיו תלתלים,"
        },
        {
          "s": 66,
          "text": "תילי תילים של הלכות75,"
        },
        {
          "s": 67,
          "text": "שקאי על הלכות התורה דכתיב בהם76"
        },
        {
          "s": 68,
          "text": "סלסלה ותרוממך,"
        },
        {
          "s": 69,
          "text": "שע\"י בירור וסלסול השערות להפריד ההלכות שלא יהי' שום קושיא מזה לזה,"
        },
        {
          "s": 70,
          "text": "עי\"ז מתרומם הנפש,"
        },
        {
          "s": 71,
          "text": "והיינו,"
        },
        {
          "s": 72,
          "text": "שדוקא ע\"י לימוד הלכות התורה כפי שירדו ונתלבשו בגשמיות ע\"י ריבוי הצמצומים שהו\"ע השערות"
        },
        {
          "s": 73,
          "text": "(שער בשמאל),"
        },
        {
          "s": 74,
          "text": "נעשה שער"
        },
        {
          "s": 75,
          "text": "(בימין)"
        },
        {
          "s": 76,
          "text": "רחב לכל ההעלאות וההמשכות כו'."
        },
        {
          "s": 77,
          "text": "אמנם,"
        },
        {
          "s": 78,
          "text": "עיקר הענין דשער רחב נעשה ע\"י עבודת התשובה."
        },
        {
          "s": 79,
          "text": "דהנה,"
        },
        {
          "s": 80,
          "text": "העבודה דקיום התומ\"צ שנתלבשו בדברים גשמיים,"
        },
        {
          "s": 81,
          "text": "הרי זה באופן שהדברים הגשמיים הם רק שרש למציאות הרע"
        },
        {
          "s": 82,
          "text": "(כנ\"ל בפירוש אופן אחד בארץ,"
        },
        {
          "s": 83,
          "text": "שתרגומו מלרע,"
        },
        {
          "s": 84,
          "text": "שזהו רק שרש מציאות הרע),"
        },
        {
          "s": 85,
          "text": "משא\"כ העבודה דתשובה שהיא לאחרי שחטא ופגם ועבר את הדרך כו',"
        },
        {
          "s": 86,
          "text": "שזהו מציאות של רע ממש שנפל בשבירת הכלים כו',"
        },
        {
          "s": 87,
          "text": "הרי כיון שהצמצום"
        },
        {
          "s": 88,
          "text": "(ענין השערות,"
        },
        {
          "s": 89,
          "text": "שער בשמאל)"
        },
        {
          "s": 90,
          "text": "הוא ביותר,"
        },
        {
          "s": 91,
          "text": "הרי גם הרעש שנעשה עי\"ז הוא גדול יותר,"
        },
        {
          "s": 92,
          "text": "ובמילא נעשה עי\"ז שער"
        },
        {
          "s": 93,
          "text": "(בימין)"
        },
        {
          "s": 94,
          "text": "רחב עוד יותר."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יובן מ\"ש ראו עתה גו',"
        },
        {
          "s": 1,
          "text": "דהנה,"
        },
        {
          "s": 2,
          "text": "אע\"פ שגילוי הסובב שהוא אור הבלי גבול"
        },
        {
          "s": 3,
          "text": "(שעל ידו נעשה אמיתית ענין האחדות,"
        },
        {
          "s": 4,
          "text": "אני אני הוא)"
        },
        {
          "s": 5,
          "text": "יהי' לעתיד לבוא בתחיית המתים,"
        },
        {
          "s": 6,
          "text": "מ\"מ,"
        },
        {
          "s": 7,
          "text": "גילוי זה נעשה ע\"י העבודה בזמן הזה דוקא,"
        },
        {
          "s": 8,
          "text": "כמ\"ש רבינו הזקן77"
        },
        {
          "s": 9,
          "text": "שכל הגילויים דימות המשיח ותחיית המתים תלויים במעשינו ועבודתינו כל זמן משך הגלות78."
        },
        {
          "s": 10,
          "text": "ולכן נאמר ראו עתה גו',"
        },
        {
          "s": 11,
          "text": "כי,"
        },
        {
          "s": 12,
          "text": "מצד העבודה דתומ\"צ שנתלבשו בדברים גשמיים,"
        },
        {
          "s": 13,
          "text": "ובפרט מצד עבודת התשובה,"
        },
        {
          "s": 14,
          "text": "ישנו גם עכשיו מעין הגילוי דלעתיד לבוא."
        },
        {
          "s": 15,
          "text": "ובזה יובן ג\"כ מ\"ש את הוי' האמרת היום גו' והוי' האמירך היום גו' לשמור כל מצותיו79."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "וזהו80 מ\"ש כנשר יעיר קנו שהוא התעוררות81"
        },
        {
          "s": 2,
          "text": "רחמים רבים דבחי' נשר,"
        },
        {
          "s": 3,
          "text": "שבא אחרי הקדמת העבודה דחודש אלול שהוא עבודה מלמטה למעלה,"
        },
        {
          "s": 4,
          "text": "כהר\"ת דאלול אני82"
        },
        {
          "s": 5,
          "text": "לדודי ודודי לי83,"
        },
        {
          "s": 6,
          "text": "אלא שיש על זה נתינת כח מלמעלה84"
        },
        {
          "s": 7,
          "text": "אבל העבודה עצמה היא בדרך מלמטלמ\"ע,"
        },
        {
          "s": 8,
          "text": "דבכללות הו\"ע עבודת התשובה שהיא עבודה שמלמטלמ\"ע."
        },
        {
          "s": 9,
          "text": "שזהו יצרנהו כאישון עינו,"
        },
        {
          "s": 10,
          "text": "אישון עינו הוא השחור שבעין ומ\"מ הנה עצם כח הראי' הוא דוקא ע\"י האישון,"
        },
        {
          "s": 11,
          "text": "דכמו\"כ יובן בעבודת האדם,"
        },
        {
          "s": 12,
          "text": "שדוקא ע\"י עבודת התשובה בדרך מלמטלמ\"ע שהו\"ע שחרות והעלם,"
        },
        {
          "s": 13,
          "text": "הנה מצד השער"
        },
        {
          "s": 14,
          "text": "(בשין שמאלית)"
        },
        {
          "s": 15,
          "text": "נעשה המשכה רחבה לעורר רחמים רבים מבחי' אב הרחמן ואב הרחמים,"
        },
        {
          "s": 16,
          "text": "להמשיך ולתקן את כל הפגמים שפגם במ\"ע ובמל\"ת."
        },
        {
          "s": 17,
          "text": "וזהו המשך הפסוקים יצרנהו כאישון עינו כנשר יעיר קנו ישאהו על אברתו הוי' בדד ינחנו,"
        },
        {
          "s": 18,
          "text": "שע\"י העבודה דאישון עינו הוא עבודת התשובה כנ\"ל,"
        },
        {
          "s": 19,
          "text": "עי\"ז כנשר יעיר קנו הו\"ע המשכת הרחמים למלאות את כל הפגמים,"
        },
        {
          "s": 20,
          "text": "בין במ\"ע שהו\"ע ישאהו על אברתו שקאי על רמ\"ח פיקודין רמ\"ח אברין דמלכא,"
        },
        {
          "s": 21,
          "text": "ובין במל\"ת שהו\"ע הוי' בדד ינחנו"
        },
        {
          "s": 22,
          "text": "(גם הנה הוי' עצמו כולל מ\"ע ומל\"ת,"
        },
        {
          "s": 23,
          "text": "ו\"ה הוא מ\"ע וי\"ה הוא מל\"ת85),"
        },
        {
          "s": 24,
          "text": "שכל ענינים אלו מתקנים ע\"י המשכת הרחמים הבאים ע\"י עבודת התשובה שהו\"ע אישון עינו."
        },
        {
          "s": 25,
          "text": "ובאמת,"
        },
        {
          "s": 26,
          "text": "הנה לפי משנ\"ת לעיל בענין השער רחב שנעשה ע\"י השערות דוקא,"
        },
        {
          "s": 27,
          "text": "הרי ע\"י העבודה דאישון עינו הנה לא זו בלבד שנתמלאים כל הפגמים,"
        },
        {
          "s": 28,
          "text": "אלא שע\"י עבודת התשובה נמשך אור עליון יותר מהאור שנמשך ע\"י העבודה דתומ\"צ,"
        },
        {
          "s": 29,
          "text": "שלכן גם צדיקים צריכים לעבודת התשובה."
        },
        {
          "s": 30,
          "text": "וזהו כללות ענין העבודה דחודש אלול בדרך מלמטלמ\"ע,"
        },
        {
          "s": 31,
          "text": "שעי\"ז נעשה המשכת י\"ג מדות הרחמים ביו\"כ בסליחה ומחילה על כל הפגמים,"
        },
        {
          "s": 32,
          "text": "ולא רק שמתמלאים הפגמים אלא שנמשך אור עליון יותר,"
        },
        {
          "s": 33,
          "text": "שזהו מה שבסיום תפלת נעילה אומרים שמע ישראל כו' ומסיימים לשנה הבאה בירושלים,"
        },
        {
          "s": 34,
          "text": "בגאולה האמיתית והשלימה ע\"י משיח צדקנו,"
        },
        {
          "s": 35,
          "text": "שמשיח אתא לאתבא צדיקייא בתיובתא86,"
        },
        {
          "s": 36,
          "text": "שהוא המשכת בחי' השער רחב גם בצדיקים."
        }
      ]
    }
  ]
}