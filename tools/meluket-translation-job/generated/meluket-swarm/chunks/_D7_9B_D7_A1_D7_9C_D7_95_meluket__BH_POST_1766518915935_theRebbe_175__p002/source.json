{
  "globalIndex": 382,
  "owner": 32,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915935_theRebbe_175__p002",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915935_theRebbe_175__p002",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915935_theRebbe_175",
  "title": "מאמר ואתה ברחמיך הרבים תשמ\"ח",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 2,
          "text": "שבנס השמן גופא היו שני נסים."
        },
        {
          "s": 3,
          "text": "הנס12"
        },
        {
          "s": 4,
          "text": "שמצאו פך אחד שמן טהור חתום בחותמו של כהן גדול13,"
        },
        {
          "s": 5,
          "text": "שנס זה"
        },
        {
          "s": 6,
          "text": "(דמציאת פך השמן)"
        },
        {
          "s": 7,
          "text": "הי' בכ\"ה בכסלו,"
        },
        {
          "s": 8,
          "text": "והנס שלא הי' בו אלא להדליק יום אחד והדליקו ממנו שמונה ימים4,"
        },
        {
          "s": 9,
          "text": "דנס זה הותחל בכ\"ו בכסלו14."
        },
        {
          "s": 10,
          "text": "ומדייק בהמאמר,"
        },
        {
          "s": 11,
          "text": "מפני מה לא הוקבע איזה תוספות דבר ביום כ\"ו בכסלו שבו הותחל נס הספקת השמן לשמונה ימים."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ונקודת הביאור בזה בהמאמר,"
        },
        {
          "s": 2,
          "text": "שהנס דנצחון המלחמה הוא יחודא תתאה,"
        },
        {
          "s": 3,
          "text": "והנס דמציאת פך שמן טהור הוא יחודא עילאה."
        },
        {
          "s": 4,
          "text": "וזהו שהנס דנצחון המלחמה הי' בכ\"ד כסלו והנס דמציאת פך השמן הי' בכ\"ה כסלו,"
        },
        {
          "s": 5,
          "text": "כי מספר כ\"ד רומז על יחו\"ת כנגד כ\"ד האותיות15"
        },
        {
          "s": 6,
          "text": "שבברוך שם כבוד מלכותו לעולם ועד16,"
        },
        {
          "s": 7,
          "text": "ומספר כ\"ה רומז על יחו\"ע כנגד כ\"ה האותיות15"
        },
        {
          "s": 8,
          "text": "שבפסוק17"
        },
        {
          "s": 9,
          "text": "שמע ישראל גו' הוי' אחד."
        },
        {
          "s": 10,
          "text": "והנס דהספקת השמן לשמונה ימים שהתחיל בכ\"ו בכסלו,"
        },
        {
          "s": 11,
          "text": "כ\"ו בגימטריא הוי',"
        },
        {
          "s": 12,
          "text": "הוא למעלה גם מיחו\"ע."
        },
        {
          "s": 13,
          "text": "דהגם שגם יחו\"ע הוא בשם הוי'"
        },
        {
          "s": 14,
          "text": "(הוי' אחד),"
        },
        {
          "s": 15,
          "text": "כמבואר בכ\"מ18"
        },
        {
          "s": 16,
          "text": "שהביטול שמצד שם אלקים הוא ביטול היש"
        },
        {
          "s": 17,
          "text": "(יחו\"ת),"
        },
        {
          "s": 18,
          "text": "והביטול דיחו\"ע"
        },
        {
          "s": 19,
          "text": "(ביטול במציאות)"
        },
        {
          "s": 20,
          "text": "הוא דוקא מצד שם הוי',"
        },
        {
          "s": 21,
          "text": "מ\"מ,"
        },
        {
          "s": 22,
          "text": "זה דכתיב בי' הוי' אחד"
        },
        {
          "s": 23,
          "text": "(ולא יחיד)"
        },
        {
          "s": 24,
          "text": "שישנם ז' רקיעים וארץ וד' רוחות העולם אלא שהם בטלים ומיוחדים עם אוא\"ס אלופו של עולם19,"
        },
        {
          "s": 25,
          "text": "הוא לפי שהוי' זה הוא הוי' דהשתלשלות,"
        },
        {
          "s": 26,
          "text": "הוי' דלתתא."
        },
        {
          "s": 27,
          "text": "דזהו מ\"ש17"
        },
        {
          "s": 28,
          "text": "הוי' אלקינו הוי' אחד,"
        },
        {
          "s": 29,
          "text": "דהוי' הראשון הוא הוי' דלעילא20"
        },
        {
          "s": 30,
          "text": "שלמעלה מהשתלשלות,"
        },
        {
          "s": 31,
          "text": "ובהוי' זה לא שייך לומר שהוא אחד בז' רקיעים וארץ ובד' רוחות העולם,"
        },
        {
          "s": 32,
          "text": "שהרי הוא יחיד ואפס זולתו,"
        },
        {
          "s": 33,
          "text": "והוי' הב' הוא הוי' דלתתא20,"
        },
        {
          "s": 34,
          "text": "הוי' דהשתלשלות,"
        },
        {
          "s": 35,
          "text": "ולכן שייך בו לשון אחד21."
        },
        {
          "s": 36,
          "text": "וזוהי מעלת הנס דהספקת השמן לשמונה ימים שהתחיל בכ\"ו בכסלו"
        },
        {
          "s": 37,
          "text": "(כ\"ו בגימטריא הוי')"
        },
        {
          "s": 38,
          "text": "על הנס דמציאת פך שמן טהור,"
        },
        {
          "s": 39,
          "text": "שהנס דמציאת פך השמן שהי' בכ\"ה"
        },
        {
          "s": 40,
          "text": "(בכסלו)"
        },
        {
          "s": 41,
          "text": "כנגד כ\"ה האותיות שבשמע ישראל"
        },
        {
          "s": 42,
          "text": "(יחודא עילאה),"
        },
        {
          "s": 43,
          "text": "המשכתו הוא מהוי' דלתתא,"
        },
        {
          "s": 44,
          "text": "הוי' אחד,"
        },
        {
          "s": 45,
          "text": "והנס דהספקת פך השמן לשמונה ימים,"
        },
        {
          "s": 46,
          "text": "דמספר שמונה מורה על בחינה שלמעלה מהשתלשלות22,"
        },
        {
          "s": 47,
          "text": "המשכתו היא מהוי' דלעילא שלמעלה מהשתלשלות."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דזהו גם שבשמע ישראל יש כ\"ה אתוון15"
        },
        {
          "s": 2,
          "text": "בחינת כה,"
        },
        {
          "s": 3,
          "text": "אף שיחו\"ע"
        },
        {
          "s": 4,
          "text": "(בכלל)"
        },
        {
          "s": 5,
          "text": "היא בחינת זה23,"
        },
        {
          "s": 6,
          "text": "כי הוי' דלתתא לגבי הוי' דלעילא נחשב כמו אלקים"
        },
        {
          "s": 7,
          "text": "(צמצום)24,"
        },
        {
          "s": 8,
          "text": "והביטול דיחו\"ע שמצד הוי' דלתתא"
        },
        {
          "s": 9,
          "text": "(לגבי הוי' דלעילא)"
        },
        {
          "s": 10,
          "text": "הוא כמו יחו\"ת25,"
        },
        {
          "s": 11,
          "text": "כה."
        },
        {
          "s": 12,
          "text": "ועד\"ז הוא גם הנס דמציאת פך השמן שהי' בכ\"ה בכסלו,"
        },
        {
          "s": 13,
          "text": "שהוא בחי' כה26"
        },
        {
          "s": 14,
          "text": "לגבי הוי' דלעילא,"
        },
        {
          "s": 15,
          "text": "ואמיתית ענין בחי' זה הוא בהנס דהספקת השמן לשמונה ימים שהתחיל בכ\"ו בכסלו,"
        },
        {
          "s": 16,
          "text": "שהמשכתו הוא מהוי' דלעילא שלמעלה מהשתלשלות."
        }
      ]
    }
  ]
}