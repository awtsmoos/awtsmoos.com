{
  "globalIndex": 238,
  "owner": 38,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915193_theRebbe_723__p003",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915193_theRebbe_723__p003",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518915193_theRebbe_723",
  "title": "מאמר ויאמר לו יהונתן תשמ\"ה",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ויובן זה ע\"פ המבואר בהדרושים17"
        },
        {
          "s": 2,
          "text": "השייכות דויאמר לו יהונתן"
        },
        {
          "s": 3,
          "text": "(אמירת יהונתן לדוד)"
        },
        {
          "s": 4,
          "text": "למחר חודש,"
        },
        {
          "s": 5,
          "text": "כי ענין חודש"
        },
        {
          "s": 6,
          "text": "(מולד הלבנה)"
        },
        {
          "s": 7,
          "text": "הוא המשכת אור"
        },
        {
          "s": 8,
          "text": "(חדש)"
        },
        {
          "s": 9,
          "text": "מהשמש בהלבנה,"
        },
        {
          "s": 10,
          "text": "וידוע ששמש וירח בשרשם הם ז\"א ומלכות."
        },
        {
          "s": 11,
          "text": "דז\"א ומלכות הם משפיע ומקבל,"
        },
        {
          "s": 12,
          "text": "בדוגמת שמש וירח."
        },
        {
          "s": 13,
          "text": "וזוהי השייכות ד"
        },
        {
          "s": 14,
          "text": "(מחר)"
        },
        {
          "s": 15,
          "text": "חודש לויאמר לו יהונתן,"
        },
        {
          "s": 16,
          "text": "כי דוד הוא בחינת מלכות,"
        },
        {
          "s": 17,
          "text": "לבנה."
        },
        {
          "s": 18,
          "text": "כמ\"ש18"
        },
        {
          "s": 19,
          "text": "ודוד הוא הקטן וארז\"ל19"
        },
        {
          "s": 20,
          "text": "שנקרא כן על שם המאור הקטן,"
        },
        {
          "s": 21,
          "text": "לבנה."
        },
        {
          "s": 22,
          "text": "ויהונתן הוא ז\"א,"
        },
        {
          "s": 23,
          "text": "בחינת שמש הוי',"
        },
        {
          "s": 24,
          "text": "שממשיך ומשפיע במלכות."
        },
        {
          "s": 25,
          "text": "דזהו שיהונתן הוא יה\"ו נתן,"
        },
        {
          "s": 26,
          "text": "נתינת והשפעת בחינת יה\"ו למלכות."
        },
        {
          "s": 27,
          "text": "וזהו הקשר דויאמר לו יהונתן"
        },
        {
          "s": 28,
          "text": "(ההמשכה מיהונתן לדוד)"
        },
        {
          "s": 29,
          "text": "עם מחר חודש,"
        },
        {
          "s": 30,
          "text": "כי ענין חודש הוא ההמשכה מז\"א"
        },
        {
          "s": 31,
          "text": "(שמש)"
        },
        {
          "s": 32,
          "text": "למלכות"
        },
        {
          "s": 33,
          "text": "(לבנה)."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ולהעיר,"
        },
        {
          "s": 1,
          "text": "שע\"פ הנ\"ל,"
        },
        {
          "s": 2,
          "text": "ענין ויאמר לו יהונתן שייך לר\"ח,"
        },
        {
          "s": 3,
          "text": "שאז הוא ההמשכה מז\"א למלכות,"
        },
        {
          "s": 4,
          "text": "ונפקדת."
        },
        {
          "s": 5,
          "text": "ומזה שנאמר ויאמר לו יהונתן מחר חודש,"
        },
        {
          "s": 6,
          "text": "משמע,"
        },
        {
          "s": 7,
          "text": "שויאמר לו יהונתן שייך"
        },
        {
          "s": 8,
          "text": "(גם)"
        },
        {
          "s": 9,
          "text": "להענין דיפקד מושבך,"
        },
        {
          "s": 10,
          "text": "שבערב ר\"ח."
        },
        {
          "s": 11,
          "text": "ויש לומר הביאור בזה20,"
        },
        {
          "s": 12,
          "text": "שבכדי שיהי' הענין דיפקד מושבך,"
        },
        {
          "s": 13,
          "text": "ושעי\"ז יהי' ונפקדת,"
        },
        {
          "s": 14,
          "text": "הוא ע\"י נתינת כח מלמעלה."
        },
        {
          "s": 15,
          "text": "וזהו ויאמר לו יהונתן מחר חודש,"
        },
        {
          "s": 16,
          "text": "דיש לומר,"
        },
        {
          "s": 17,
          "text": "דזה שנאמר ויאמר לו יהונתן לפני התיבות מחר חודש,"
        },
        {
          "s": 18,
          "text": "הוא,"
        },
        {
          "s": 19,
          "text": "כי ויאמר לו יהונתן הוא המשכת הנתינת כח מז\"א למלכות על הענין דיפקד מושבך"
        },
        {
          "s": 20,
          "text": "(שבערב ר\"ח)"
        },
        {
          "s": 21,
          "text": "ושעי\"ז יהי' ונפקדת"
        },
        {
          "s": 22,
          "text": "(בר\"ח)."
        },
        {
          "s": 23,
          "text": "ולכן נאמר ויאמר לו יהונתן לפני מחר חודש,"
        },
        {
          "s": 24,
          "text": "כי ויאמר לו יהונתן הוא הנתינת כח על ענין מחר חודש."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ויש לקשר זה עם המבואר בהדרושים21"
        },
        {
          "s": 2,
          "text": "עה\"פ22"
        },
        {
          "s": 3,
          "text": "ואלה תולדות יצחק בן אברהם אברהם הוליד את יצחק,"
        },
        {
          "s": 4,
          "text": "דצריך להבין,"
        },
        {
          "s": 5,
          "text": "הרי כבר נאמר יצחק בן אברהם ולמה נכפל עוד פעם אברהם הוליד את יצחק."
        },
        {
          "s": 6,
          "text": "והביאור בזה,"
        },
        {
          "s": 7,
          "text": "דאברהם הוא המשכה מלמעלה למטה ויצחק הוא העלאה מלמטה למעלה23."
        },
        {
          "s": 8,
          "text": "והנה ההעלאה מלמטה למעלה מגעת למקום נעלה יותר מהמקום שמשם הוא ההמשכה מלמעלה למטה."
        },
        {
          "s": 9,
          "text": "וע\"ד שארז\"ל24"
        },
        {
          "s": 10,
          "text": "איש מזריע תחלה יולדת נקבה,"
        },
        {
          "s": 11,
          "text": "אשה מזרעת תחלה יולדת זכר."
        },
        {
          "s": 12,
          "text": "שההולדה שע\"י העלאת מ\"ן"
        },
        {
          "s": 13,
          "text": "(העלאה מלמטה למעלה)"
        },
        {
          "s": 14,
          "text": "היא נעלית יותר מההולדה שע\"י המשכת מ\"ד"
        },
        {
          "s": 15,
          "text": "(המשכה מלמעלה למטה)."
        },
        {
          "s": 16,
          "text": "אלא שבתחלה צ\"ל ההמשכה מלמעלה למטה ואח\"כ היא ההעלאה מלמטה למעלה."
        },
        {
          "s": 17,
          "text": "ושני טעמים לזה25."
        },
        {
          "s": 18,
          "text": "כי א\"א להיות העלאה בלי קדימת ההמשכה"
        },
        {
          "s": 19,
          "text": "[וע\"ד אשה מזרעת,"
        },
        {
          "s": 20,
          "text": "דגם כשאשה מזרעת תחלה הוא ע\"י שהאיש מעורר אותה]."
        },
        {
          "s": 21,
          "text": "וגם הכח שישנו בהעלאה מלמטה למעלה להגיע למקום נעלה מאד"
        },
        {
          "s": 22,
          "text": "(אשה מזרעת תחלה יולדת זכר),"
        },
        {
          "s": 23,
          "text": "המשכתו"
        },
        {
          "s": 24,
          "text": "(התגלותו)"
        },
        {
          "s": 25,
          "text": "הוא ע\"י ההמשכה מלמעלה למטה שלפני ההעלאה"
        },
        {
          "s": 26,
          "text": "[וע\"ד אשה כי תזריע וילדה,"
        },
        {
          "s": 27,
          "text": "דזה שנעשה הולדה מזרע האשה,"
        },
        {
          "s": 28,
          "text": "הוא ע\"י האיש]."
        },
        {
          "s": 29,
          "text": "ויש לומר,"
        },
        {
          "s": 30,
          "text": "דזה שהכח שבהעלאה מלמטה למעלה להגיע למקום נעלה מאד הוא ע\"י ההמשכה מלמעלה למטה"
        },
        {
          "s": 31,
          "text": "[אף שההעלאה מגעת למקום נעלה יותר מהמקום שמשם היא ההמשכה"
        },
        {
          "s": 32,
          "text": "(שלפני ההעלאה)],"
        },
        {
          "s": 33,
          "text": "הוא,"
        },
        {
          "s": 34,
          "text": "כי ענין העלאה הוא העלאת התחתון,"
        },
        {
          "s": 35,
          "text": "ולכן,"
        },
        {
          "s": 36,
          "text": "הכח שבהעלאה להגיע למעלה מעלה הוא בהעלם,"
        },
        {
          "s": 37,
          "text": "וע\"י ההמשכה מלמעלה"
        },
        {
          "s": 38,
          "text": "(המשכת העליון)"
        },
        {
          "s": 39,
          "text": "מתגלה הכח שבהעלאת התחתון26"
        },
        {
          "s": 40,
          "text": "(ומגיע למעלה יותר מהמקום שמשם היא ההמשכה מלמעלה)."
        }
      ]
    }
  ]
}