{
  "globalIndex": 634,
  "owner": 34,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917442_theRebbe_735__p002",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917442_theRebbe_735__p002",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917442_theRebbe_735",
  "title": "מאמר על כן קראו תשי\"ג",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "וביאור השייכות דשני הענינים בההשוואה דיוהכ\"פ ופורים"
        },
        {
          "s": 1,
          "text": "[שבשניהם הו\"ע הגורל,"
        },
        {
          "s": 2,
          "text": "וששניהם הם למעלה משם הוי'17],"
        },
        {
          "s": 3,
          "text": "יובן בהקדים דענין הגורל הוא למעלה מהשכל18."
        },
        {
          "s": 4,
          "text": "שהרי גורל הוא"
        },
        {
          "s": 5,
          "text": "(בכלל19)"
        },
        {
          "s": 6,
          "text": "בשני דברים שוים"
        },
        {
          "s": 7,
          "text": "[וכמו שני השעירים דיוהכ\"פ שהיו שוים במראה ובקומה ובדמים20],"
        },
        {
          "s": 8,
          "text": "דכאשר אחד מהם הוא טוב יותר,"
        },
        {
          "s": 9,
          "text": "אין מקום לגורל,"
        },
        {
          "s": 10,
          "text": "ודוקא כששני הדברים הם שוים,"
        },
        {
          "s": 11,
          "text": "כיון שמצד השכל א\"א להכריע באיזה מהם לבחור,"
        },
        {
          "s": 12,
          "text": "סומכים אז על הגורל שלמעלה מהשכל."
        },
        {
          "s": 13,
          "text": "ועד\"ז הוא למעלה,"
        },
        {
          "s": 14,
          "text": "דגורל הוא למעלה מהשתלשלות"
        },
        {
          "s": 15,
          "text": "[דחכמה היא ראשית ההשתלשלות,"
        },
        {
          "s": 16,
          "text": "וגורל שהוא למעלה מהחכמה הוא למעלה מהשתלשלות]."
        },
        {
          "s": 17,
          "text": "ועפ\"ז,"
        },
        {
          "s": 18,
          "text": "ההשוואה דפורים ויוהכ\"פ,"
        },
        {
          "s": 19,
          "text": "שבשניהם הו\"ע הגורל,"
        },
        {
          "s": 20,
          "text": "הוא – גילוי אוא\"ס שלמעלה מהשתלשלות."
        },
        {
          "s": 21,
          "text": "וזהו הקשר דשני הענינים בההשוואה דיוהכ\"פ ופורים,"
        },
        {
          "s": 22,
          "text": "שבשניהם הו\"ע הגורל וששניהם הם למעלה מהוי',"
        },
        {
          "s": 23,
          "text": "כי הוי' הוא השתלשלות"
        },
        {
          "s": 24,
          "text": "(יו\"ד חכמה ה' בינה וכו'),"
        },
        {
          "s": 25,
          "text": "וזה שיוהכ\"פ ופורים הם למעלה מהוי' הוא שהגילוי דיוהכ\"פ ודפורים הוא למעלה מהשתלשלות21,"
        },
        {
          "s": 26,
          "text": "ענין הגורל."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה ידוע22"
        },
        {
          "s": 2,
          "text": "במעלת הגורל,"
        },
        {
          "s": 3,
          "text": "שהוא למעלה"
        },
        {
          "s": 4,
          "text": "(לא רק מהשכל,"
        },
        {
          "s": 5,
          "text": "אלא)"
        },
        {
          "s": 6,
          "text": "גם מהרצון שלמעלה מהשכל."
        },
        {
          "s": 7,
          "text": "שהרי כשאדם מטיל גורל הוא מחליט דכמו שיפול הגורל כן יהי' רצונו."
        },
        {
          "s": 8,
          "text": "דמזה מוכח שהגורל מגיע בדרגא שלמעלה גם מהרצון,"
        },
        {
          "s": 9,
          "text": "שלכן הרצון הוא כפי הגורל."
        },
        {
          "s": 10,
          "text": "ועד\"ז הוא למעלה,"
        },
        {
          "s": 11,
          "text": "דענין הגורל הוא בבעל הרצון שלמעלה מרצון."
        },
        {
          "s": 12,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 13,
          "text": "שהקשר דשני הענינים בההשוואה דיוהכ\"פ ופורים"
        },
        {
          "s": 14,
          "text": "(שבשניהם הו\"ע הגורל וששניהם הם למעלה מהוי')"
        },
        {
          "s": 15,
          "text": "הוא,"
        },
        {
          "s": 16,
          "text": "כי ההתחלה דשם הוי' היא הקוץ שעל היו\"ד,"
        },
        {
          "s": 17,
          "text": "שרומז על הרצון שלמעלה מחכמה23,"
        },
        {
          "s": 18,
          "text": "וזה שיוהכ\"פ ופורים הם למעלה מהוי'"
        },
        {
          "s": 19,
          "text": "(למעלה גם מהקוץ שעל היו\"ד)"
        },
        {
          "s": 20,
          "text": "הוא שביוהכ\"פ ובפורים הוא המשכת וגילוי בחינת בעל הרצון"
        },
        {
          "s": 21,
          "text": "(שלמעלה מרצון)24,"
        },
        {
          "s": 22,
          "text": "ענין גורל."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יש לבאר הקשר דשני הפירושים ביום הכפורים – שביום זה מתכפרים כל הענינים הבלתי רצויים"
        },
        {
          "s": 2,
          "text": "(כפורים כפשוטו),"
        },
        {
          "s": 3,
          "text": "ושיום זה הוא כמו פורים"
        },
        {
          "s": 4,
          "text": "(שהדמיון דיוהכ\"פ לפורים הוא שביוהכ\"פ הפילו גורל,"
        },
        {
          "s": 5,
          "text": "כמו פורים על שם הפור הוא הגורל)"
        },
        {
          "s": 6,
          "text": "– כי שלימות הכפרה על הענינים שעשו היפך הרצון דתומ\"צ הוא כשהמשכת הכפרה היא מאוא\"ס בעל הרצון"
        },
        {
          "s": 7,
          "text": "(שלמעלה מהרצון דתומ\"צ)25."
        },
        {
          "s": 8,
          "text": "וזהו הקשר דשני הפירושים ביום כפורים,"
        },
        {
          "s": 9,
          "text": "דזה שיוהכ\"פ הוא כמו פורים על שם הפור הוא הגורל,"
        },
        {
          "s": 10,
          "text": "היינו שגם ביוהכ\"פ הוא ההמשכה מבעל הרצון"
        },
        {
          "s": 11,
          "text": "(דוגמת ההמשכה דפורים),"
        },
        {
          "s": 12,
          "text": "הוא טעם וביאור על זה שהוא יום כפורים כפשוטו,"
        },
        {
          "s": 13,
          "text": "שבו מתכפרים הענינים הבלתי רצויים."
        },
        {
          "s": 14,
          "text": "וזהו מה שהכפרה דפורים היא נעלית יותר מהכפרה דיוהכ\"פ26,"
        },
        {
          "s": 15,
          "text": "דיוהכ\"פ אינו מכפר אלא עם התשובה27"
        },
        {
          "s": 16,
          "text": "והכפרה שהיתה לכל היהודים בימי הפורים ה\"ז יום שמחה28,"
        },
        {
          "s": 17,
          "text": "כי עיקר ענין הגורל"
        },
        {
          "s": 18,
          "text": "(המשכת בחינת בעל הרצון)"
        },
        {
          "s": 19,
          "text": "הוא בימי הפורים,"
        },
        {
          "s": 20,
          "text": "דהימים עצמם נקראים בשם פורים על שם הפור,"
        },
        {
          "s": 21,
          "text": "ולכן,"
        },
        {
          "s": 22,
          "text": "הכפרה שהיתה בימי הפורים אין בה הגבלות29,"
        },
        {
          "s": 23,
          "text": "ויום הכפורים הוא כ."
        },
        {
          "s": 24,
          "text": "פורים30"
        },
        {
          "s": 25,
          "text": "בכ\"ף הדמיון בלבד,"
        },
        {
          "s": 26,
          "text": "ואין יוהכ\"פ מכפר אלא עם התשובה."
        }
      ]
    }
  ]
}