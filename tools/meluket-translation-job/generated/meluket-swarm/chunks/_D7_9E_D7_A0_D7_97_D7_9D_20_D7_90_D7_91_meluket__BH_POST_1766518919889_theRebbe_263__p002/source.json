{
  "globalIndex": 1033,
  "owner": 33,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919889_theRebbe_263__p002",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919889_theRebbe_263__p002",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919889_theRebbe_263",
  "title": "מאמר והי' עקב תשמעון תשכ\"ז",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים מ\"ש בתניא19"
        },
        {
          "s": 2,
          "text": "דתכלית השלימות של ימות המשיח ותחיית המתים תלוי במעשינו ועבודתינו כל זמן משך הגלות,"
        },
        {
          "s": 3,
          "text": "וכתב אאמו\"ר בעל ההילולא בהערותיו על הגליון של ספר התניא שלו20"
        },
        {
          "s": 4,
          "text": "(שמשך כמה שנים הי' בשבי' ובזמן האחרון נפדו"
        },
        {
          "s": 5,
          "text": "(ספר התניא שלו עם עוד ספרים שלו)"
        },
        {
          "s": 6,
          "text": "מהשבי' והגיעו לכאן)"
        },
        {
          "s": 7,
          "text": "דענין ב' הלשונות,"
        },
        {
          "s": 8,
          "text": "במעשינו ועבודתינו,"
        },
        {
          "s": 9,
          "text": "יובן ממ\"ש לקמן באגה\"ק סי\"ב ד\"ה והי' מעשה הצדקה גו' ע\"ש."
        },
        {
          "s": 10,
          "text": "ולאח\"ז ממשיך,"
        },
        {
          "s": 11,
          "text": "דיש לומר,"
        },
        {
          "s": 12,
          "text": "שמעשינו קאי על ימות המשיח ועבודתינו קאי על תחה\"מ21."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "והנה כוונתו של בעל ההילולא במה שמציין לאגה\"ק סי\"ב ד\"ה והי' מעשה הצדקה גו' היא לכאורה להמבואר באגה\"ק שם22"
        },
        {
          "s": 1,
          "text": "ההפרש בין מעשה לעבודה,"
        },
        {
          "s": 2,
          "text": "\"כי שם מעשה נופל על דבר שכבר נעשה או שנעשה תמיד ממילא והוא דבר ההווה ורגיל תמיד כו',"
        },
        {
          "s": 3,
          "text": "(משא\"כ)"
        },
        {
          "s": 4,
          "text": "לשון עבודה אינו נופל אלא על דבר שהאדם עושה ביגיעה עצומה נגד טבע נפשו רק שמבטל טבעו ורצונו מפני רצון העליון ב\"ה\"."
        },
        {
          "s": 5,
          "text": "דמזה מובן,"
        },
        {
          "s": 6,
          "text": "שכ\"ה גם הפירוש דב' הלשונות מעשינו ועבודתינו שבתניא כאן,"
        },
        {
          "s": 7,
          "text": "דמעשינו קאי על קיום התומ\"צ כפי הטבע וההרגל,"
        },
        {
          "s": 8,
          "text": "ועבודתינו קאי על היגיעה בתומ\"צ יותר מהטבע והרגילות."
        },
        {
          "s": 9,
          "text": "אבל,"
        },
        {
          "s": 10,
          "text": "מזה שכותב דב' הלשונות"
        },
        {
          "s": 11,
          "text": "(מעשינו ועבודתינו)"
        },
        {
          "s": 12,
          "text": "יובן ממ\"ש באגה\"ק סי\"ב,"
        },
        {
          "s": 13,
          "text": "ומסיים"
        },
        {
          "s": 14,
          "text": "(לאחרי שמציין לאגה\"ק הנ\"ל)"
        },
        {
          "s": 15,
          "text": "\"עיין שם\","
        },
        {
          "s": 16,
          "text": "משמע דכוונתו במה שמציין לאגה\"ק הנ\"ל היא"
        },
        {
          "s": 17,
          "text": "(נוסף על ההפרש שבין מעשה לעבודה סתם)"
        },
        {
          "s": 18,
          "text": "גם להמבואר שם בענין מעשה הצדקה23,"
        },
        {
          "s": 19,
          "text": "דע\"י העיון בזה"
        },
        {
          "s": 20,
          "text": "(\"עיין שם\")"
        },
        {
          "s": 21,
          "text": "יובן בעומק יותר החילוק שבין מעשינו לעבודתינו,"
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "דהנה מבואר באגה\"ק שם בענין מעשה הצדקה דזה \"שישראל בטבעם הם רחמנים24"
        },
        {
          "s": 1,
          "text": "וגומלי חסדים25"
        },
        {
          "s": 2,
          "text": "(הוא)"
        },
        {
          "s": 3,
          "text": "מפני היות נפשותיהם נמשכות ממדותיו ית' אשר החסד גובר בהן על מדת הדין כו' שלכן נקראת הנשמה בת כהן\"26"
        },
        {
          "s": 4,
          "text": "(כהן איש החסד27)."
        },
        {
          "s": 5,
          "text": "ומבאר שם,"
        },
        {
          "s": 6,
          "text": "ד\"הצדקה הנמשכת מבחי' זו נק' בשם מעשה הצדקה כי שם מעשה נופל על דבר הווה ורגיל תמיד,"
        },
        {
          "s": 7,
          "text": "(מפני ש)"
        },
        {
          "s": 8,
          "text": "מדת החסד והרחמנות הוטבעה בנפשות כל בית ישראל מכבר מעת בריאותן28"
        },
        {
          "s": 9,
          "text": "והשתלשלותן ממדותיו ית'\"."
        },
        {
          "s": 10,
          "text": "והיינו,"
        },
        {
          "s": 11,
          "text": "דהגם שטבע החסד שבו הוא"
        },
        {
          "s": 12,
          "text": "(לא מצד נפשו הבהמית,"
        },
        {
          "s": 13,
          "text": "אלא)"
        },
        {
          "s": 14,
          "text": "מצד נפשו האלקית,"
        },
        {
          "s": 15,
          "text": "מ\"מ,"
        },
        {
          "s": 16,
          "text": "הצדקה שעושה מפני טבע זה,"
        },
        {
          "s": 17,
          "text": "נק' בשם מעשה הצדקה29."
        },
        {
          "s": 18,
          "text": "ועבודת הצדקה היא שנתינת הצדקה שלו היא יותר גם מהטבע דנפשו האלקית."
        },
        {
          "s": 19,
          "text": "ומזה מובן,"
        },
        {
          "s": 20,
          "text": "דהחילוק שבין מעשינו לעבודתינו"
        },
        {
          "s": 21,
          "text": "(בכללות התורה ומצוות)"
        },
        {
          "s": 22,
          "text": "הוא,"
        },
        {
          "s": 23,
          "text": "דגם כשנפש הבהמית שלו מסתרת על הטבע דנפש האלקית,"
        },
        {
          "s": 24,
          "text": "וצריך להתייגע להסיר את הכיסוי וההסתר דנפש הבהמית ולגלות הטבע דנפש האלקית,"
        },
        {
          "s": 25,
          "text": "מ\"מ הוא בכלל מעשינו,"
        },
        {
          "s": 26,
          "text": "מכיון שהיגיעה שלו היא רק לגלות הטבע דנפשו האלקית,"
        },
        {
          "s": 27,
          "text": "ועבודתינו הוא שהיגיעה שלו היא יותר גם מהטבע דנפשו האלקית."
        }
      ]
    }
  ]
}