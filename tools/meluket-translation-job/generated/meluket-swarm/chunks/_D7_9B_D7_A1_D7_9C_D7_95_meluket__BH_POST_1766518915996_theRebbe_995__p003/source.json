{
  "globalIndex": 391,
  "owner": 41,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915996_theRebbe_995__p003",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915996_theRebbe_995__p003",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915996_theRebbe_995",
  "title": "מאמר אתה אחד תשל\"ב",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז מובנת גם השייכות דפדה בשלום נפשי למ\"ש והאבן הזאת גו',"
        },
        {
          "s": 1,
          "text": "כי זה שמאבני המקום לשון רבים נעשית אבן אחת הוא כענין ברבים היו עמדי."
        },
        {
          "s": 2,
          "text": "ועד\"ז הוא גם הענין דאתה אחד כו' ומי כעמך כישראל גוי אחד בארץ,"
        },
        {
          "s": 3,
          "text": "כי החידוש דגוי אחד בארץ הוא כמ\"ש אדמו\"ר הזקן25"
        },
        {
          "s": 4,
          "text": "שישראל ממשיכים בחי' אחד גם בעניני ארץ."
        },
        {
          "s": 5,
          "text": "דאף שעניני ארץ הם בחי' רבים,"
        },
        {
          "s": 6,
          "text": "ועד אפילו בבריאת אדה\"ר אמרז\"ל26"
        },
        {
          "s": 7,
          "text": "עה\"פ27"
        },
        {
          "s": 8,
          "text": "נעשה"
        },
        {
          "s": 9,
          "text": "(לשון רבים)"
        },
        {
          "s": 10,
          "text": "אדם,"
        },
        {
          "s": 11,
          "text": "מה אתה נותן פתחון פה כו' והרוצה לטעות כו',"
        },
        {
          "s": 12,
          "text": "והיינו שהוא העלם כזה שאפילו משה רבינו חכמה דקדושה אמר מה אתה נותן כו',"
        },
        {
          "s": 13,
          "text": "הנה גם בבחי' ריבוי זה נעשה בחי' אחד."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ויובן כל זה בהקדים המאמר"
        },
        {
          "s": 2,
          "text": "(נמצא בביכל שנגאל לאחרונה מהשבי')"
        },
        {
          "s": 3,
          "text": "של בעל ההילולא ד\"ה אתם נצבים28,"
        },
        {
          "s": 4,
          "text": "שמבאר29"
        },
        {
          "s": 5,
          "text": "שם שמנין הסוגים שבישראל נחלק לב' מדריגות"
        },
        {
          "s": 6,
          "text": "(כדלקמן)."
        },
        {
          "s": 7,
          "text": "ובהקדמה,"
        },
        {
          "s": 8,
          "text": "שבתחלה נאמר בפסוק30"
        },
        {
          "s": 9,
          "text": "ראשיכם שבטיכם גו' כל איש ישראל,"
        },
        {
          "s": 10,
          "text": "ואח\"כ נאמר בפסוק בפ\"ע31"
        },
        {
          "s": 11,
          "text": "טפכם נשיכם גו',"
        },
        {
          "s": 12,
          "text": "והרי חלוקת הפסוקים מורה גם על חלוקת הענינים32,"
        },
        {
          "s": 13,
          "text": "ולכאורה צריך להבין,"
        },
        {
          "s": 14,
          "text": "למה מחלקם לב' פסוקים נפרדים."
        },
        {
          "s": 15,
          "text": "גם צריך להבין,"
        },
        {
          "s": 16,
          "text": "דכיון שנאמר אתם נצבים היום כולכם,"
        },
        {
          "s": 17,
          "text": "למה מונה את כל עשר הדרגות והסוגים שבישראל,"
        },
        {
          "s": 18,
          "text": "ואינו מסתפק במ\"ש כולכם."
        },
        {
          "s": 19,
          "text": "גם צריך ביאור במ\"ש וגרך אשר בקרב מחניך,"
        },
        {
          "s": 20,
          "text": "למה מוסיף בגר דוקא שהוא בקרב מחניך."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ומבאר שם,"
        },
        {
          "s": 2,
          "text": "שעשר הסוגים שבישראל הם כנגד ע\"ס דאצילות,"
        },
        {
          "s": 3,
          "text": "ולכן מחלקם לב' מדריגות כלליות,"
        },
        {
          "s": 4,
          "text": "כשם שבספירות יש ב' מדריגות כלליות,"
        },
        {
          "s": 5,
          "text": "הספירות הראשונות שבבחינת הגדלות,"
        },
        {
          "s": 6,
          "text": "והספירות האחרונות שבבחינת הקטנות."
        },
        {
          "s": 7,
          "text": "ויש להוסיף,"
        },
        {
          "s": 8,
          "text": "שעפ\"ז יל\"פ מה שמדריגה הראשונה שבחלוקה הראשונה היא ראשיכם,"
        },
        {
          "s": 9,
          "text": "והמדריגה הראשונה בחלוקה השני' היא טפכם,"
        },
        {
          "s": 10,
          "text": "כי,"
        },
        {
          "s": 11,
          "text": "מדריגה הראשונה שבכל חלוקה מורה על כללות כל הבחינות שבחלוקה זו"
        },
        {
          "s": 12,
          "text": "(וע\"ד האות הראשונה שבתיבה שהיא כוללת כל האותיות של התיבה,"
        },
        {
          "s": 13,
          "text": "כמבואר בשער היחוד והאמונה33),"
        },
        {
          "s": 14,
          "text": "והרי ראשיכם הוא כללות ענין הגדלות,"
        },
        {
          "s": 15,
          "text": "וטפכם הוא כללות ענין הקטנות"
        },
        {
          "s": 16,
          "text": "(כדלקמן)."
        },
        {
          "s": 17,
          "text": "ומבאר שם,"
        },
        {
          "s": 18,
          "text": "שראשיכם הוא בחי' כתר שבכתר,"
        },
        {
          "s": 19,
          "text": "שכולל כל הראשים הפרטיים,"
        },
        {
          "s": 20,
          "text": "והוא בחינת רצון הפשוט ועצמי שבכנסת ישראל בכלל ובכל ניצוץ אלקי בפרט,"
        },
        {
          "s": 21,
          "text": "שאין טעם כלל לרצון,"
        },
        {
          "s": 22,
          "text": "אפילו טעם כמוס כו',"
        },
        {
          "s": 23,
          "text": "כמו במ\"ת דכתיב34"
        },
        {
          "s": 24,
          "text": "ויחן שם ישראל גו'."
        },
        {
          "s": 25,
          "text": "[ויש להוסיף,"
        },
        {
          "s": 26,
          "text": "שגם ענין המשכת בחי' הרצון העליון בכל ישראל,"
        },
        {
          "s": 27,
          "text": "מובן ע\"פ מ\"ש במתן תורה אנכי הוי' אלקיך35,"
        },
        {
          "s": 28,
          "text": "כמבואר בכ\"מ36"
        },
        {
          "s": 29,
          "text": "שאז נעשה בחי' אנכי הוי' כוחו וחיותו של כאו\"א מישראל]."
        },
        {
          "s": 30,
          "text": "ואח\"כ אמר שבטיכם,"
        },
        {
          "s": 31,
          "text": "שנקראו שבטי י\"ה,"
        },
        {
          "s": 32,
          "text": "כמ\"ש37"
        },
        {
          "s": 33,
          "text": "ששם עלו שבטים שבטי י\"ה,"
        },
        {
          "s": 34,
          "text": "והוא בחי' אור הכתר שמתפשט בחו\"ב שבכתר עצמו ונק' חו\"ב שבכתר כו',"
        },
        {
          "s": 35,
          "text": "והוא גילוי הרצון העצמי המאיר בהעלם השכל שנקרא טעם כמוס לרצון."
        },
        {
          "s": 36,
          "text": "[ולהעיר,"
        },
        {
          "s": 37,
          "text": "שהמבואר כאן הוא דלא כמבואר במ\"א38"
        },
        {
          "s": 38,
          "text": "דמ\"ש ששם עלו שבטים שבטי י\"ה קאי על חו\"ב כפי שהם במקומם]."
        },
        {
          "s": 39,
          "text": "ואח\"כ אמר זקניכם,"
        },
        {
          "s": 40,
          "text": "זקן שקנה חכמה39"
        },
        {
          "s": 41,
          "text": "ממקורה להביאה מן ההעלם כו' לבוא בהתפשטות בבינה,"
        },
        {
          "s": 42,
          "text": "והן הסנהדרין שהן השופטים ודיינים כו'."
        },
        {
          "s": 43,
          "text": "ואח\"כ אמר שוטריכם,"
        },
        {
          "s": 44,
          "text": "שהוא בחי' נצח והוד דחו\"ב"
        },
        {
          "s": 45,
          "text": "(שזהו\"ע כליות40"
        },
        {
          "s": 46,
          "text": "יועצות41),"
        },
        {
          "s": 47,
          "text": "שהן תוקף וחוזק אור השכל להיות המוח שליט על הלב42"
        },
        {
          "s": 48,
          "text": "כו',"
        },
        {
          "s": 49,
          "text": "והן כמו שלוחי הדיינין שרודים את העם במקל להכניעם שלא יטו ממשפט התורה ימין ושמאל,"
        },
        {
          "s": 50,
          "text": "כמ\"ש43"
        },
        {
          "s": 51,
          "text": "שופטים ושוטרים כו'."
        },
        {
          "s": 52,
          "text": "ואח\"כ אמר כל איש ישראל,"
        },
        {
          "s": 53,
          "text": "שהוא בחי' הדעת המתפשט במדות שמתחלק לס\"ר דעות,"
        },
        {
          "s": 54,
          "text": "וכידוע בענין ברכת חכם הרזים על ס\"ר מישראל שאין דעתם דומה זה לזה44,"
        },
        {
          "s": 55,
          "text": "ועד שהדעת מתפשט במדות חג\"ת,"
        },
        {
          "s": 56,
          "text": "כמבואר בתניא45"
        },
        {
          "s": 57,
          "text": "שע\"י ענין הדעת באים לאהבה וענפי' ויראה וענפי',"
        },
        {
          "s": 58,
          "text": "שהאהבה היא שורש כל רמ\"ח מ\"ע,"
        },
        {
          "s": 59,
          "text": "והיראה היא שורש כל שס\"ה מל\"ת46."
        }
      ]
    }
  ]
}