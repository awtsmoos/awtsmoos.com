{
  "globalIndex": 1054,
  "owner": 4,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919986_theRebbe_397__p003",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919986_theRebbe_397__p003",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919986_theRebbe_397",
  "title": "מאמר לא היו ימים טובים לישראל תשל\"ה",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "והנה מכיון שבחינת הכתר"
        },
        {
          "s": 1,
          "text": "(מלך עילאה)"
        },
        {
          "s": 2,
          "text": "היא למעלה מהשתלשלות,"
        },
        {
          "s": 3,
          "text": "לכן גם העבודה שבאדם הממשכת בחינה זו,"
        },
        {
          "s": 4,
          "text": "צריכה להיות למעלה מהשתלשלות הכחות שבו,"
        },
        {
          "s": 5,
          "text": "בבחינת בכל מאדך."
        },
        {
          "s": 6,
          "text": "כי ע\"י העבודה דתומ\"צ כמו שהיא בבחינת מדידה והגבלה"
        },
        {
          "s": 7,
          "text": "(השתלשלות שבאדם),"
        },
        {
          "s": 8,
          "text": "נמשך האור שבבחינת השתלשלות."
        },
        {
          "s": 9,
          "text": "והגם שע\"י העבודה דתומ\"צ"
        },
        {
          "s": 10,
          "text": "(גם כשהעבודה היא במדידה והגבלה)"
        },
        {
          "s": 11,
          "text": "נמשך אור נעלה יותר מהבחי' דג\"ע,"
        },
        {
          "s": 12,
          "text": "וכדמוכח ממ\"ש40"
        },
        {
          "s": 13,
          "text": "ויניחהו בג\"ע לעבדה ולשמרה,"
        },
        {
          "s": 14,
          "text": "לעבדה זה רמ\"ח מ\"ע ולשמרה זה שס\"ה מל\"ת41,"
        },
        {
          "s": 15,
          "text": "והיינו שהג\"ע אצל אדה\"ר לא הי' בחינת קבלת שכר כ\"א שהג\"ע הי' מקום עבודתו,"
        },
        {
          "s": 16,
          "text": "וע\"י עבודתו בג\"ע המשיך אורות נעלים יותר מהבחי' דג\"ע42,"
        },
        {
          "s": 17,
          "text": "מ\"מ,"
        },
        {
          "s": 18,
          "text": "זה מה שנמשך ע\"י העבודה כמו שהיא במדידה ע\"פ תורה הוא רק מה ששייך לעולם,"
        },
        {
          "s": 19,
          "text": "והוא מה שע\"י התורה נעשה קיום העולם,"
        },
        {
          "s": 20,
          "text": "כדאיתא בגמרא43"
        },
        {
          "s": 21,
          "text": "אם ישראל מקבלים התורה אתם מתקיימין."
        },
        {
          "s": 22,
          "text": "אבל המשכת האור שלמעלה מהשתלשלות היא ע\"י העבודה דבכל מאדך דוקא."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "וע\"פ הנ\"ל יובן מה שמקדים בהמאמר הפירוש דבמלך לשדה נעבד להביאור בהמעלה דט\"ו באב על ט\"ו בניסן וט\"ו בתשרי,"
        },
        {
          "s": 1,
          "text": "כי מעלת ט\"ו באב על ט\"ו בניסן וט\"ו בתשרי הוא דוגמת המעלה דמלך לשדה נעבד על בחינת שדה כמו שהיא מצד עצמה."
        },
        {
          "s": 2,
          "text": "דהנה מעלת הג\"ע"
        },
        {
          "s": 3,
          "text": "(שדה)"
        },
        {
          "s": 4,
          "text": "שהוא בחינת יתרון ארץ,"
        },
        {
          "s": 5,
          "text": "היינו מה שהעולם הוא בשלימות"
        },
        {
          "s": 6,
          "text": "(כנ\"ל),"
        },
        {
          "s": 7,
          "text": "הוא דוגמת קיימא סיהרא באשלמותא."
        },
        {
          "s": 8,
          "text": "אמנם,"
        },
        {
          "s": 9,
          "text": "שלימות זו היא רק השלימות דעולם,"
        },
        {
          "s": 10,
          "text": "וגם מה שמיתוסף בג\"ע ע\"י העבודה דלעבדה ולשמרה"
        },
        {
          "s": 11,
          "text": "(כמו שהיא במדידה דתורה)"
        },
        {
          "s": 12,
          "text": "הוא רק מה ששייך לעולם,"
        },
        {
          "s": 13,
          "text": "ועד\"ז הוא גם בנוגע לשלימות הלבנה דט\"ו בניסן וט\"ו בתשרי,"
        },
        {
          "s": 14,
          "text": "שמצד ענין התורה."
        },
        {
          "s": 15,
          "text": "משא\"כ שלימות הלבנה דט\"ו באב,"
        },
        {
          "s": 16,
          "text": "מכיון שהיא באה לאחרי הירידה דט\"ב שירידה זו מעוררת העבודה דבכל מאדך"
        },
        {
          "s": 17,
          "text": "(כמשי\"ת לקמן),"
        },
        {
          "s": 18,
          "text": "היא דוגמת מלך לשדה נעבד,"
        },
        {
          "s": 19,
          "text": "אור שלמעלה מהשתלשלות."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "והנה בכדי לבוא להעבודה דבכל מאדך שלמעלה ממדידה והגבלה,"
        },
        {
          "s": 1,
          "text": "הוא ע\"י התבוננות בהמצרים וגבולים דעולם."
        },
        {
          "s": 2,
          "text": "כי ע\"י שהוא מרגיש את המצרים וגבולים דעולם,"
        },
        {
          "s": 3,
          "text": "הנה זה גופא מעורר אותו שיצא מהמצרים וגבולים,"
        },
        {
          "s": 4,
          "text": "ושעבודתו תהי' למעלה ממדידה והגבלה."
        },
        {
          "s": 5,
          "text": "וכל מה שמרגיש יותר את המצרים וגבולים,"
        },
        {
          "s": 6,
          "text": "שנוסף להמצרים והגבלות דעולם בכלל ישנם גם דברים המונעים ומבלבלים לעבודת ה',"
        },
        {
          "s": 7,
          "text": "כמו הרעבון והחולי"
        },
        {
          "s": 8,
          "text": "[דכשהאדם הוא רעב וחולה א\"א שיבין וישתכל כו' ולא יוכל לעבוד את ה'44"
        },
        {
          "s": 9,
          "text": "(היינו45"
        },
        {
          "s": 10,
          "text": "שבכדי לעבוד את ה' כשהוא חולה צריך להשתדלות מיוחדת)],"
        },
        {
          "s": 11,
          "text": "ועאכו\"כ ההעלמות וההסתרים שבזמן הגלות,"
        },
        {
          "s": 12,
          "text": "הנה כל מה שמרגיש יותר את המצרים וגבולים,"
        },
        {
          "s": 13,
          "text": "זה מביא אותו יותר להעבודה דבכל מאדך,"
        },
        {
          "s": 14,
          "text": "היציאה ממיצר וגבול."
        },
        {
          "s": 15,
          "text": "ובזה יובן מה שמביא בדרוש הנ\"ל את פירוש השני שבזהר,"
        },
        {
          "s": 16,
          "text": "שמלך לשדה נעבד הוא לגריעותא,"
        },
        {
          "s": 17,
          "text": "ששדה הוא בחינת שדה דלעו\"ז"
        },
        {
          "s": 18,
          "text": "(בשדה מצאה46),"
        },
        {
          "s": 19,
          "text": "ומלך לשדה נעבד הוא מה שספירת המלכות רגלי' יורדות כו' ומתעלמת בשדה דלעו\"ז,"
        },
        {
          "s": 20,
          "text": "כי ההתבוננות בהענין דמלך לשדה נעבד כמו שהוא לגריעותא,"
        },
        {
          "s": 21,
          "text": "שהו\"ע גלות השכינה"
        },
        {
          "s": 22,
          "text": "[שהסיבה לזה ששכינתא בגלותא הוא הגלות דישראל,"
        },
        {
          "s": 23,
          "text": "מה שגלינו מפני חטאינו],"
        },
        {
          "s": 24,
          "text": "הנה התבוננות זו מעוררת אותו שעבודתו תהי' למעלה ממדידה והגבלה,"
        },
        {
          "s": 25,
          "text": "ועי\"ז נמשך אור שלמעלה מהשתלשלות,"
        },
        {
          "s": 26,
          "text": "מלך לשדה נעבד למעליותא."
        }
      ]
    }
  ]
}