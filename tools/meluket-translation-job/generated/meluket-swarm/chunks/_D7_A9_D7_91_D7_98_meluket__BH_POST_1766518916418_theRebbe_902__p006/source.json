{
  "globalIndex": 465,
  "owner": 15,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916418_theRebbe_902__p006",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916418_theRebbe_902__p006",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916418_theRebbe_902",
  "title": "מאמר לה\"ע כתיבת ספר תורה תש\"ל",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "וזהו ענין מצות כתיבת ספר תורה,"
        },
        {
          "s": 2,
          "text": "שע\"ז כותב כ\"ק אדמו\"ר הצ\"צ שהוא כענין ויכתוב משה גו',"
        },
        {
          "s": 3,
          "text": "כנ\"ל,"
        },
        {
          "s": 4,
          "text": "כי בכל אחד ואחד מישראל ישנה בחינת משה שבו84"
        },
        {
          "s": 5,
          "text": "[וכמ\"ש85"
        },
        {
          "s": 6,
          "text": "ועתה ישראל מה ה' אלקיך שואל מעמך כי אם ליראה,"
        },
        {
          "s": 7,
          "text": "והקשה על זה בגמרא86,"
        },
        {
          "s": 8,
          "text": "אטו יראת שמים מילתא זוטרתא היא"
        },
        {
          "s": 9,
          "text": "(ובפרט שאח\"כ מפרט בכתוב כו\"כ פרטים87,"
        },
        {
          "s": 10,
          "text": "ועד לדרשת חז\"ל88"
        },
        {
          "s": 11,
          "text": "אל תקרי מה אלא מאה,"
        },
        {
          "s": 12,
          "text": "שהוא תכלית השלימות89,"
        },
        {
          "s": 13,
          "text": "עשר כלול מעשר90,"
        },
        {
          "s": 14,
          "text": "וגם כמבואר בכ\"מ91"
        },
        {
          "s": 15,
          "text": "שיש מאה אותיות בפסוק זה),"
        },
        {
          "s": 16,
          "text": "ומתרץ,"
        },
        {
          "s": 17,
          "text": "אין לגבי משה מילתא זוטרתא היא,"
        },
        {
          "s": 18,
          "text": "דמכיון שבכאו\"א מישראל ישנה בחינת משה,"
        },
        {
          "s": 19,
          "text": "לכן יראה היא מילתא זוטרתא אצל כאו\"א92]."
        },
        {
          "s": 20,
          "text": "ומכיון שבכאו\"א מישראל ישנה בחינת משה שבו,"
        },
        {
          "s": 21,
          "text": "לכן,"
        },
        {
          "s": 22,
          "text": "ביכלתו להמשיך ע\"י כתיבת ס\"ת בחינת ואמת כמו שהוא באמיתית המציאות"
        },
        {
          "s": 23,
          "text": "[כמ\"ש ברמב\"ם93"
        },
        {
          "s": 24,
          "text": "שהוא לבדו האמת ואין לאחר אמת כאמיתתו],"
        },
        {
          "s": 25,
          "text": "ולהמשיכה עד למטה מטה,"
        },
        {
          "s": 26,
          "text": "ובאופן דחכמת אדם תאיר פניו,"
        },
        {
          "s": 27,
          "text": "שכל העולם כולו יכיר בו שמצא תוספתא חדתא."
        },
        {
          "s": 28,
          "text": "ונמשך גם בכתיבה,"
        },
        {
          "s": 29,
          "text": "בדיו על הקלף,"
        },
        {
          "s": 30,
          "text": "שהקלף הוא קלף של בהמה"
        },
        {
          "s": 31,
          "text": "(ובע\"ח)"
        },
        {
          "s": 32,
          "text": "והדיו נעשה מצומח ודומם,"
        },
        {
          "s": 33,
          "text": "ומכל זה נעשה ספר תורה שלימה,"
        },
        {
          "s": 34,
          "text": "ועד לעיני כל ישראל94."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר בדרך אפשר,"
        },
        {
          "s": 1,
          "text": "דזהו מה שכ\"ק מו\"ח אדמו\"ר נשיא דורינו התחיל בכתיבת הספר תורה"
        },
        {
          "s": 2,
          "text": "(ואנחנו זכינו לסיימה),"
        },
        {
          "s": 3,
          "text": "כי ארז\"ל95"
        },
        {
          "s": 4,
          "text": "משה הוא גואל ראשון הוא גואל אחרון,"
        },
        {
          "s": 5,
          "text": "שלכן שילה,"
        },
        {
          "s": 6,
          "text": "שקאי על משיח96,"
        },
        {
          "s": 7,
          "text": "הוא בגימטריא משה97,"
        },
        {
          "s": 8,
          "text": "וכשמצרפים אחד98"
        },
        {
          "s": 9,
          "text": "לשילה ה\"ז בגימטריא משיח,"
        },
        {
          "s": 10,
          "text": "כמבואר בשיחה הידועה מכ\"ק מו\"ח אדמו\"ר99."
        },
        {
          "s": 11,
          "text": "דהיינו,"
        },
        {
          "s": 12,
          "text": "שכאשר ממשיכים בחינת אחד,"
        },
        {
          "s": 13,
          "text": "שיאיר הא',"
        },
        {
          "s": 14,
          "text": "אלופו של עולם,"
        },
        {
          "s": 15,
          "text": "בהח' והד',"
        },
        {
          "s": 16,
          "text": "שהם ז' רקיעים וארץ וד' רוחות העולם100,"
        },
        {
          "s": 17,
          "text": "ובאופן גלוי"
        },
        {
          "s": 18,
          "text": "(דכמו שאני נכתב כך אני נקרא101),"
        },
        {
          "s": 19,
          "text": "ה\"ז גילוי המשיח."
        },
        {
          "s": 20,
          "text": "ולכן כמו שענינו של משה הו\"ע כתיבת ס\"ת,"
        },
        {
          "s": 21,
          "text": "כנ\"ל בארוכה,"
        },
        {
          "s": 22,
          "text": "י\"ל שעד\"ז הוא גם ענינו של משיח."
        },
        {
          "s": 23,
          "text": "ויש להוסיף בזה,"
        },
        {
          "s": 24,
          "text": "דהנה משיח צדקנו נקרא מלך המשיח102,"
        },
        {
          "s": 25,
          "text": "כמ\"ש103"
        },
        {
          "s": 26,
          "text": "ועבדי דוד מלך עליהם,"
        },
        {
          "s": 27,
          "text": "ובס\"ת של מלך נאמר והיתה עמו וקרא בו כל ימי חייו,"
        },
        {
          "s": 28,
          "text": "והרי דרשו רז\"ל104"
        },
        {
          "s": 29,
          "text": "עה\"פ105"
        },
        {
          "s": 30,
          "text": "למען תזכור את יום צאתך מארץ מצרים כל ימי חייך,"
        },
        {
          "s": 31,
          "text": "ימי חייך הימים כל ימי חייך להביא הלילות106,"
        },
        {
          "s": 32,
          "text": "וחכמים אומרים ימי חייך העולם הזה כל ימי חייך להביא לימות המשיח,"
        },
        {
          "s": 33,
          "text": "עוה\"ז ועוה\"ב,"
        },
        {
          "s": 34,
          "text": "שמזה מובן גם בנוגע למה שנאמר בו וקרא בו כל ימי חייו,"
        },
        {
          "s": 35,
          "text": "שקאי גם על ימות המשיח."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "והנה במעשה הרי כבר סיימנו את הספר תורה,"
        },
        {
          "s": 2,
          "text": "שכ\"ק מו\"ח אדמו\"ר קרא לו ס\"ת של משיח,"
        },
        {
          "s": 3,
          "text": "ואינו רק מחוסר זמן,"
        },
        {
          "s": 4,
          "text": "ובקרוב ממש נזכה לביאת משיח צדקנו,"
        },
        {
          "s": 5,
          "text": "יבוא ויגאלנו ויוליכנו קוממיות לארצנו,"
        },
        {
          "s": 6,
          "text": "ואז יהי' גילוי תורתו של משיח."
        },
        {
          "s": 7,
          "text": "דאע\"פ שג\"ז כבר ניתן למשה מסיני בעת מתן תורה,"
        },
        {
          "s": 8,
          "text": "כי מתן תורה לא יהי' עוד הפעם,"
        },
        {
          "s": 9,
          "text": "כמבואר בכ\"מ107,"
        },
        {
          "s": 10,
          "text": "הרי במ\"ת הי' זה בהעלם,"
        },
        {
          "s": 11,
          "text": "ולעתיד לבוא יהי' גילוי תורתו של משיח,"
        },
        {
          "s": 12,
          "text": "ישקני מנשיקות פיהו108."
        },
        {
          "s": 13,
          "text": "וההכנה לזה היא,"
        },
        {
          "s": 14,
          "text": "טועמי' חיים זכו בערב שבת קודש אחר חצות דהשיתא109"
        },
        {
          "s": 15,
          "text": "אלפי שני דהוה עלמא110,"
        },
        {
          "s": 16,
          "text": "שאז הי' כ\"ק מו\"ח אדמו\"ר,"
        },
        {
          "s": 17,
          "text": "לאחרי גילוי האריז\"ל,"
        },
        {
          "s": 18,
          "text": "ואח\"כ גילוי הבעש\"ט והה\"מ,"
        },
        {
          "s": 19,
          "text": "ואח\"כ גילוי כ\"ק אדמו\"ר הזקן וממלאי מקומו עד לכ\"ק מו\"ח אדמו\"ר,"
        },
        {
          "s": 20,
          "text": "שכל זה הוא ההכנה וההקדמה והכלי אשר,"
        },
        {
          "s": 21,
          "text": "בקרוב ממש,"
        },
        {
          "s": 22,
          "text": "כשכאו\"א ישלים את עניניו,"
        },
        {
          "s": 23,
          "text": "נזכה שתתגלה בפועל הנתינת כח של כ\"ק מו\"ח אדמו\"ר נשיא דורינו,"
        },
        {
          "s": 24,
          "text": "ויקויים תקותו ורצונו,"
        },
        {
          "s": 25,
          "text": "שעם ספר תורה זה נצא לקבל פני משיח צדקנו,"
        },
        {
          "s": 26,
          "text": "ובשמחה ובטוב לבב,"
        },
        {
          "s": 27,
          "text": "ושמחת עולם על ראשם111,"
        },
        {
          "s": 28,
          "text": "ובאופן דבנערינו ובזקנינו גו' בבנינו ובבנותינו112,"
        },
        {
          "s": 29,
          "text": "בקרוב ממש,"
        },
        {
          "s": 30,
          "text": "וגם בלשון תרגום,"
        },
        {
          "s": 31,
          "text": "בעגלא דידן113."
        }
      ]
    }
  ]
}