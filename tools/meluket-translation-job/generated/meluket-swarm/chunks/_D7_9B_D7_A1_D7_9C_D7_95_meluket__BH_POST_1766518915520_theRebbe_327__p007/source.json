{
  "globalIndex": 309,
  "owner": 9,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915520_theRebbe_327__p007",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915520_theRebbe_327__p007",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915520_theRebbe_327",
  "title": "מאמר מרגלא בפומיה דרבא תש\"מ",
  "part": 7,
  "sections": [
    {
      "v": 18,
      "items": [
        {
          "s": 0,
          "text": "ולהוסיף,"
        },
        {
          "s": 1,
          "text": "שע\"י גילוי היחידה דכללות ההשתלשלות שיהי' לעתיד לבוא,"
        },
        {
          "s": 2,
          "text": "יתוסף עילוי בכל ג' הענינים"
        },
        {
          "s": 3,
          "text": "(חכמה,"
        },
        {
          "s": 4,
          "text": "תשובה ומעשים טובים),"
        },
        {
          "s": 5,
          "text": "ועד לעילוי שבאין ערוך."
        },
        {
          "s": 6,
          "text": "דבנוגע לתורה"
        },
        {
          "s": 7,
          "text": "(חכמה)"
        },
        {
          "s": 8,
          "text": "ארז\"ל62"
        },
        {
          "s": 9,
          "text": "שהתורה דעכשיו היא הבל לגבי תורתו של משיח,"
        },
        {
          "s": 10,
          "text": "ובנוגע לתשובה ידוע63"
        },
        {
          "s": 11,
          "text": "שמשיח אתא לאתבא צדיקייא בתיובתא,"
        },
        {
          "s": 12,
          "text": "שהתשובה דצדיקים נעלית יותר מתשובה כפשוטה,"
        },
        {
          "s": 13,
          "text": "ובנוגע למעשים טובים ידוע64"
        },
        {
          "s": 14,
          "text": "שבביאת המשיח יהי' קיום המצוות בתכלית השלימות."
        },
        {
          "s": 15,
          "text": "ויש לומר,"
        },
        {
          "s": 16,
          "text": "שבהשלימות דמעשים טובים ומאירים שיהי' אז נכלל גם שכל הענינים דעולם העשי' יהיו מאירים,"
        },
        {
          "s": 17,
          "text": "ועד שגם לילה כיום יאיר65,"
        },
        {
          "s": 18,
          "text": "בגאולה האמיתית והשלימה ע\"י משיח צדקנו,"
        },
        {
          "s": 19,
          "text": "ובאופן דמיד הן נגאלין66."
        }
      ]
    }
  ]
}