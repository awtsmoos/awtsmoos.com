{
  "globalIndex": 170,
  "owner": 20,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914734_theRebbe_896__p005",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914734_theRebbe_896__p005",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914734_theRebbe_896",
  "title": "מאמר בורא ניב שפתיים תשמ\"ח",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש לבאר מה שמובא בהמאמר פירוש הרד\"ק לפני פירוש הגמרא,"
        },
        {
          "s": 1,
          "text": "כי בהמעלה דניב שפתים"
        },
        {
          "s": 2,
          "text": "(דיוק הראשון שבהמאמר)"
        },
        {
          "s": 3,
          "text": "נוגע יותר פירוש הרד\"ק."
        },
        {
          "s": 4,
          "text": "דלפירוש הגמרא שלרחוק הוא בעלי תשובה,"
        },
        {
          "s": 5,
          "text": "ניב שפתים הוא וידוי דברים."
        },
        {
          "s": 6,
          "text": "וזה שניב שפתים הוא הדיבור דתורה הוא לפירוש הרד\"ק שלרחוק הוא רחוק מירושלים."
        },
        {
          "s": 7,
          "text": "ועיקר המעלה דניב שפתים"
        },
        {
          "s": 8,
          "text": "(דיבור הבא ממילא)"
        },
        {
          "s": 9,
          "text": "הוא כשהדיבור דתורה הוא בדרך ממילא,"
        },
        {
          "s": 10,
          "text": "שזה מורה על זה שהאדם נעשה מציאות חדשה,"
        },
        {
          "s": 11,
          "text": "מציאות דתורה."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ולהוסיף,"
        },
        {
          "s": 2,
          "text": "דע\"י שכ\"ק מו\"ח אדמו\"ר נשיא דורנו אמר את המאמר ד\"ה בורא ניב שפתים,"
        },
        {
          "s": 3,
          "text": "ובפרט שלאחרי זה פירסם את המאמר,"
        },
        {
          "s": 4,
          "text": "ניתן הכח לכאו\"א מישראל,"
        },
        {
          "s": 5,
          "text": "ובפרט לההולכים בעקבותיו,"
        },
        {
          "s": 6,
          "text": "שעסק התורה שלהם,"
        },
        {
          "s": 7,
          "text": "ועד\"ז ההתעסקות בכל עניני כ\"ק מו\"ח אדמו\"ר נשיא דורנו,"
        },
        {
          "s": 8,
          "text": "תהי' באופן דניב שפתים."
        },
        {
          "s": 9,
          "text": "היינו שיהי' שקוע לגמרי בענינים דנשיא דורנו,"
        },
        {
          "s": 10,
          "text": "עד שכל פעולותיו"
        },
        {
          "s": 11,
          "text": "(גם הבאים ממילא בלי כוונה)"
        },
        {
          "s": 12,
          "text": "יהיו בהענינים של נשיא דורנו."
        },
        {
          "s": 13,
          "text": "ובאופן דמעלין בקודש36,"
        },
        {
          "s": 14,
          "text": "שבכל יום תהי' ההתעסקות בהענינים של הנשיא בחיות חדש ובאופן מחודש,"
        },
        {
          "s": 15,
          "text": "ועד לחידוש גמור בדוגמת החידוש דיש מאין,"
        },
        {
          "s": 16,
          "text": "בורא ניב שפתים."
        },
        {
          "s": 17,
          "text": "ובפרט בנוגע ללימוד התורה,"
        },
        {
          "s": 18,
          "text": "דניב שפתים קאי על הדיבור דתורה"
        },
        {
          "s": 19,
          "text": "(כנ\"ל),"
        },
        {
          "s": 20,
          "text": "שההוספה בלימוד התורה תהי' באין ערוך."
        },
        {
          "s": 21,
          "text": "ובפרט לאחרי שעברו חמישים שנה מאמירת מאמר הנ\"ל,"
        },
        {
          "s": 22,
          "text": "דאין עולם אלא חמישים שנה37"
        },
        {
          "s": 23,
          "text": "ולאחרי זה מתחיל עולם חדש."
        },
        {
          "s": 24,
          "text": "ולהעיר,"
        },
        {
          "s": 25,
          "text": "שהעילוי דחמישים שנה הוא בנוגע לעניני חכמה ושכל כמארז\"ל38"
        },
        {
          "s": 26,
          "text": "בן חמשים לעצה,"
        },
        {
          "s": 27,
          "text": "ומזה מובן,"
        },
        {
          "s": 28,
          "text": "דזה שלאחרי חמישים שנה מאמירת מאמר הנ\"ל מתחיל עולם חדש הוא בעיקר בנוגע ללימוד התורה בהבנה והשגה."
        },
        {
          "s": 29,
          "text": "שההוספה והעלי' בהבנת והשגת התורה תהי' באופן דאין ערוך."
        },
        {
          "s": 30,
          "text": "וע\"ד העלי' דר' זירא מתלמוד בבלי לתלמוד ירושלמי39."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ולהוסיף,"
        },
        {
          "s": 1,
          "text": "דהגם שבכדי שכל הענינים יהיו באופן דעולם חדש הוא ע\"י עבודה ויגיעה,"
        },
        {
          "s": 2,
          "text": "וישנם כאלה שחושבים ומדמים שאינם רוצים להתייגע להיות מציאות חדשה והנהגתם מכאן ולהבא תהי' כמו שהיתה מקודם,"
        },
        {
          "s": 3,
          "text": "צריכים הם לדעת,"
        },
        {
          "s": 4,
          "text": "שהאַיינרעדעניש שלהם"
        },
        {
          "s": 5,
          "text": "(שישארו במצב הקודם)"
        },
        {
          "s": 6,
          "text": "לא יועיל מאומה,"
        },
        {
          "s": 7,
          "text": "כי דבר אלקינו יקום לעולם40."
        },
        {
          "s": 8,
          "text": "וגם מה שחושבים בנוגע להרצון שלהם"
        },
        {
          "s": 9,
          "text": "(שאינם רוצים להתייגע להיות מציאות חדשה)"
        },
        {
          "s": 10,
          "text": "הוא רק דמיון,"
        },
        {
          "s": 11,
          "text": "כי רצונו האמיתי של כל אחד מישראל הוא לקיים רצון ה',"
        },
        {
          "s": 12,
          "text": "כפס\"ד הידוע דהרמב\"ם41."
        },
        {
          "s": 13,
          "text": "וכשיסבירו לעצמם מהו רצונם האמיתי,"
        },
        {
          "s": 14,
          "text": "יבוא הרצון בגילוי ותהי' עבודתם בהנ\"ל מתוך רצון ותענוג."
        }
      ]
    }
  ]
}