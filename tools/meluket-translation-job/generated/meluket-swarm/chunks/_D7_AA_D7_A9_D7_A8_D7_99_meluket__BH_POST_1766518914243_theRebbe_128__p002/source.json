{
  "globalIndex": 96,
  "owner": 46,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914243_theRebbe_128__p002",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914243_theRebbe_128__p002",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914243_theRebbe_128",
  "title": "מאמר ולקחתם לכם תשל\"ט",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים החילוק שבין סוכה לד' מינים."
        },
        {
          "s": 2,
          "text": "דעם היות ששניהם מורים על ענין האחדות"
        },
        {
          "s": 3,
          "text": "(כדלקמן),"
        },
        {
          "s": 4,
          "text": "אעפ\"כ חילוק ביניהם."
        },
        {
          "s": 5,
          "text": "שהאחדות דסוכה היא אחדות בעצם,"
        },
        {
          "s": 6,
          "text": "שאין בה"
        },
        {
          "s": 7,
          "text": "(מלכתחילה)"
        },
        {
          "s": 8,
          "text": "התחלקות פרטים9."
        },
        {
          "s": 9,
          "text": "שלכן כל ישראל ראויים לישב בסוכה אחת10,"
        },
        {
          "s": 10,
          "text": "לפי שסוכה היא למעלה מהתחלקות,"
        },
        {
          "s": 11,
          "text": "משא\"כ ענין מצות נטילת ד' מינים הוא שמריבוי נעשה אחדות."
        },
        {
          "s": 12,
          "text": "דהגם שהם ד' מינים שונים ומן הקצה אל הקצה,"
        },
        {
          "s": 13,
          "text": "כדאיתא במדרש11"
        },
        {
          "s": 14,
          "text": "דד' מינים שבלולב הם כנגד ד' סוגים שבישראל,"
        },
        {
          "s": 15,
          "text": "מהסוג שכנגד אתרוג שיש בו טעם וריח"
        },
        {
          "s": 16,
          "text": "(תורה ומעשים טובים)"
        },
        {
          "s": 17,
          "text": "עד להסוג שכנגד ערבה שאין בה לא טעם ולא ריח,"
        },
        {
          "s": 18,
          "text": "והם נעשים כולם אגודה אחת12."
        },
        {
          "s": 19,
          "text": "וגם להפירוש13"
        },
        {
          "s": 20,
          "text": "שד' המינים רומזים על הקב\"ה,"
        },
        {
          "s": 21,
          "text": "הנה מזה שהענינים דלמעלה"
        },
        {
          "s": 22,
          "text": "(הקב\"ה)"
        },
        {
          "s": 23,
          "text": "מרומזים בד' מינים,"
        },
        {
          "s": 24,
          "text": "מובן,"
        },
        {
          "s": 25,
          "text": "שהם ד' מדריגות שונות"
        },
        {
          "s": 26,
          "text": "[ועל פי הידוע שכל הפירושים שבאותו הפסוק שייכים זה לזה14,"
        },
        {
          "s": 27,
          "text": "יש לומר,"
        },
        {
          "s": 28,
          "text": "שהחילוק בד' המדריגות דלמעלה המרומזים בד' המינים הוא מן הקצה אל הקצה,"
        },
        {
          "s": 29,
          "text": "בדוגמת החילוק שבין ד' סוגים הנ\"ל דישראל],"
        },
        {
          "s": 30,
          "text": "ועל ידי מצות נטילת ד' מינים"
        },
        {
          "s": 31,
          "text": "[שכל ד' המינים הם מצוה אחת15]"
        },
        {
          "s": 32,
          "text": "הם מתאחדים."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה לאחרי מצות ישיבה בסוכה ומצות נטילת ד' מינים באה המצוה דהקרבת קרבנות החג16"
        },
        {
          "s": 2,
          "text": "שעיקרם הם הע' פרים"
        },
        {
          "s": 3,
          "text": "[כיון שפר"
        },
        {
          "s": 4,
          "text": "(שור)"
        },
        {
          "s": 5,
          "text": "הוא המלך שבבהמות17]"
        },
        {
          "s": 6,
          "text": "כנגד שבעים אומות18."
        },
        {
          "s": 7,
          "text": "דע\"י הקרבת הע' פרים"
        },
        {
          "s": 8,
          "text": "[ועד\"ז עכשיו ע\"י אמירת פסוקי הקרבנות דע' פרים,"
        },
        {
          "s": 9,
          "text": "ונשלמה פרים שפתינו19]"
        },
        {
          "s": 10,
          "text": "נעשה בירור האומות20."
        },
        {
          "s": 11,
          "text": "ויש לומר,"
        },
        {
          "s": 12,
          "text": "שהשייכות דבירור האומות ע\"י הקרבת הע' פרים למצות נטילת ד' מינים היא,"
        },
        {
          "s": 13,
          "text": "כי תכלית שלימות הנצחון דישראל שמתגלה ע\"י נטילת ד' מינים"
        },
        {
          "s": 14,
          "text": "[דעל ידי שישראל לולביהן ואתרוגיהן בידן יודעים דישראל אינון ניצוחייא,"
        },
        {
          "s": 15,
          "text": "כנ\"ל ממדרש]"
        },
        {
          "s": 16,
          "text": "הוא,"
        },
        {
          "s": 17,
          "text": "שגם האומות יסכימו לזה,"
        },
        {
          "s": 18,
          "text": "וע\"י הקרבת הע' פרים כנגד ע' אומות הם מתבררים ומזדככים ועד שהם מסכימים להנצחון דישראל."
        },
        {
          "s": 19,
          "text": "וזוהי גם השייכות דאמירת הלל בז' ימי הסוכות להקרבת הע' פרים"
        },
        {
          "s": 20,
          "text": "[דזה שגומרין את ההלל בכל ימי החג הוא לפי שהם חלוקים בקרבנותיהם21],"
        },
        {
          "s": 21,
          "text": "כי ע\"י הבירור והזיכוך שנעשה בהאומות ע\"י הקרבת הע' פרים,"
        },
        {
          "s": 22,
          "text": "נעשה הללו את הוי' כל גוים שבחוהו כל האומים כי גבר עלינו חסדו גו'22,"
        },
        {
          "s": 23,
          "text": "שהגוים והאומים משבחים את הוי' על זה שגבר עלינו חסדו."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה זה שהגוים והאומים מהללים ומשבחים את ה' על זה שגבר עלינו חסדו הוא ענין נעלה ביותר23."
        },
        {
          "s": 2,
          "text": "ועד אשר"
        },
        {
          "s": 3,
          "text": "(בפרט אחד)"
        },
        {
          "s": 4,
          "text": "הוא נעלה יותר מהענין דגבר עלינו חסדו כמו שהוא מצד עצמו."
        },
        {
          "s": 5,
          "text": "כי עי\"ז"
        },
        {
          "s": 6,
          "text": "(שהגוים מהללים כו')"
        },
        {
          "s": 7,
          "text": "נשלמת הכוונה דנתאוה הקב\"ה להיות לו ית' דירה בתחתונים24,"
        },
        {
          "s": 8,
          "text": "בתחתון שאין תחתון למטה ממנו25."
        },
        {
          "s": 9,
          "text": "וכמובן גם מהמאמר ד\"ה ברוך תהי' מכל העמים של בעל ההילולא26,"
        },
        {
          "s": 10,
          "text": "דאיתא בירושלמי27"
        },
        {
          "s": 11,
          "text": "אם ברכך גוי ענה אחריו אמן שנאמר28"
        },
        {
          "s": 12,
          "text": "ברוך תהי' מכל העמים,"
        },
        {
          "s": 13,
          "text": "ומביא בהמאמר דאיתא בכתבי האריז\"ל29"
        },
        {
          "s": 14,
          "text": "שאמן הו\"ע יחוד הוי' ואד'"
        },
        {
          "s": 15,
          "text": "[דזהו שאמן בגימטריא הוי' אד'30]."
        },
        {
          "s": 16,
          "text": "והענין הוא31,"
        },
        {
          "s": 17,
          "text": "דהוי' הוא שם העצם32"
        },
        {
          "s": 18,
          "text": "(עצמות אוא\"ס שלמעלה מעולמות33),"
        },
        {
          "s": 19,
          "text": "ושם אד' הוא כמרז\"ל34"
        },
        {
          "s": 20,
          "text": "לך נאה לקרות אדנ' שאתה אדון לכל בריותיך."
        },
        {
          "s": 21,
          "text": "דנוסף לזה ששם אד' הוא בספירת המלכות35,"
        },
        {
          "s": 22,
          "text": "דמלכות היא שרש הנבראים,"
        },
        {
          "s": 23,
          "text": "הנה מלשון רז\"ל שאתה אדון לכל בריותיך"
        },
        {
          "s": 24,
          "text": "(בריותיך דוקא)"
        },
        {
          "s": 25,
          "text": "משמע שהשם אד' הוא על נבראים אלו שהם בריות בעלמא36."
        },
        {
          "s": 26,
          "text": "ועל ידי היחוד דהוי' ואד',"
        },
        {
          "s": 27,
          "text": "שבאד' מאיר הוי',"
        },
        {
          "s": 28,
          "text": "נעשה כן גם בהנבראים שנתהוו משם אד'"
        },
        {
          "s": 29,
          "text": "[כולל גם נבראים אלה שהם בריות בעלמא],"
        },
        {
          "s": 30,
          "text": "שמאיר בהם גילוי עצמות אוא\"ס שלמעלה מעולמות,"
        },
        {
          "s": 31,
          "text": "ועד שנעשים דירה לו ית',"
        },
        {
          "s": 32,
          "text": "לו לעצמותו37."
        },
        {
          "s": 33,
          "text": "וזהו אם ברכך גוי ענה אחריו אמן,"
        },
        {
          "s": 34,
          "text": "דישראל הם למעלה מעולמות,"
        },
        {
          "s": 35,
          "text": "וע\"י שגוי מכיר מעלתו של ישראל ועד שמברך אותו,"
        },
        {
          "s": 36,
          "text": "נעשה זה הכנה והקדמה38"
        },
        {
          "s": 37,
          "text": "ליחוד הוי' ואד',"
        },
        {
          "s": 38,
          "text": "ולדירה לו ית' בתחתונים."
        }
      ]
    }
  ]
}