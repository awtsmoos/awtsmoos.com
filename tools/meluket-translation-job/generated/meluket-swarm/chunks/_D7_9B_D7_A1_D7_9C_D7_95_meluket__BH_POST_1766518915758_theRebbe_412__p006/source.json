{
  "globalIndex": 350,
  "owner": 0,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915758_theRebbe_412__p006",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915758_theRebbe_412__p006",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915758_theRebbe_412",
  "title": "מאמר להבין ענין נרות חנוכה תשכ\"ו",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "ועוד חילוק בין הבירור שהי' בימי שלמה להבירור שיהי' לע\"ל,"
        },
        {
          "s": 1,
          "text": "דבירור הנצוצות שבהעמים הי' ע\"י שבאו אליו."
        },
        {
          "s": 2,
          "text": "אבל קודם שבאו אליו לא נתבררו עדיין."
        },
        {
          "s": 3,
          "text": "דהגם שהגילוי שהאיר ע\"י שלמה האיר גם בהנצוצות שבמקומות הרחוקים ומשך אותם לבוא אליו,"
        },
        {
          "s": 4,
          "text": "מ\"מ,"
        },
        {
          "s": 5,
          "text": "הבירור שלהם בפועל הי' דוקא לאחרי שבאו אליו."
        },
        {
          "s": 6,
          "text": "כמובן מזה שגם לאחרי שמלכת שבא שמעה את שמע שלמה,"
        },
        {
          "s": 7,
          "text": "הוצרך להיות ותבוא ירושלמה64,"
        },
        {
          "s": 8,
          "text": "ורק אז נעשה הבירור65."
        },
        {
          "s": 9,
          "text": "דכיון שהבירור שלהם הי' לא מצד עצמם אלא מצד הגילוי שהאיר בהם,"
        },
        {
          "s": 10,
          "text": "לכן,"
        },
        {
          "s": 11,
          "text": "הבירור שלהם הי' כשבאו להמקום ששם הוא הגילוי."
        },
        {
          "s": 12,
          "text": "והבירור דלע\"ל,"
        },
        {
          "s": 13,
          "text": "כיון שהבירור אז יהי' ע\"י שיתגלה אמיתית המציאות של הדברים המתבררים עצמם,"
        },
        {
          "s": 14,
          "text": "לכן,"
        },
        {
          "s": 15,
          "text": "אז66"
        },
        {
          "s": 16,
          "text": "אהפוך אל עמים"
        },
        {
          "s": 17,
          "text": "(כמו שהם במציאותם ובמקומם)"
        },
        {
          "s": 18,
          "text": "גו' לעבדו שכם אחד."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "ועד\"ז הוא בענין הפצת המעינות חוצה"
        },
        {
          "s": 3,
          "text": "(שהוא הכנה וכלי לאתי מר דא מלכא משיחא67),"
        },
        {
          "s": 4,
          "text": "דתורת החסידות היא בחי' פנימיות עתיק."
        },
        {
          "s": 5,
          "text": "וזהו שע\"י לימוד תורת החסידות וההליכה בדרכי החסידות,"
        },
        {
          "s": 6,
          "text": "כחות הטבעיים"
        },
        {
          "s": 7,
          "text": "(של העוסק בחסידות)"
        },
        {
          "s": 8,
          "text": "נעשים כחות אלקיים68,"
        },
        {
          "s": 9,
          "text": "כי ע\"י המשכת הגילוי דפנימיות עתיק,"
        },
        {
          "s": 10,
          "text": "נרגש בו"
        },
        {
          "s": 11,
          "text": "(בהעלם עכ\"פ)"
        },
        {
          "s": 12,
          "text": "שאמיתת המצאו היא המציאות שלו."
        },
        {
          "s": 13,
          "text": "וענין יפוצו מעינותיך חוצה הוא,"
        },
        {
          "s": 14,
          "text": "שגם בבחי' חוצה יהיו"
        },
        {
          "s": 15,
          "text": "(ובאופן דהפצה)"
        },
        {
          "s": 16,
          "text": "לא רק המים חיים שנמשכים מהמעינות"
        },
        {
          "s": 17,
          "text": "[ע\"ד הגילוי דחיצוניות עתיק שהי' בימי שלמה,"
        },
        {
          "s": 18,
          "text": "שעיקר הגילוי הי' בירושלים אלא שהארה ממנו נמשכה גם למקומות הרחוקים],"
        },
        {
          "s": 19,
          "text": "אלא המעינות עצמם."
        },
        {
          "s": 20,
          "text": "ועי\"ז נתגלה המציאות דהחוצה עצמו,"
        },
        {
          "s": 21,
          "text": "שאמיתת מציאותו הם המעינות."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש לבאר פתגם אדמו\"ר"
        },
        {
          "s": 1,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 2,
          "text": "נ\"ע69"
        },
        {
          "s": 3,
          "text": "בענין הגילוי דתורת החסידות שנמשך ע\"י אדמו\"ר הזקן לאחרי פּעטערבורג שהוא ע\"ד הזית שכשכותשין אותו הוא מוציא את שמנו70,"
        },
        {
          "s": 4,
          "text": "דמהטעמים על זה שהגילוי שלאחרי י\"ט כסלו נמשל לשמן הוא,"
        },
        {
          "s": 5,
          "text": "כי שמן71,"
        },
        {
          "s": 6,
          "text": "עם היותו מובדל מכל דבר"
        },
        {
          "s": 7,
          "text": "(שלכן אינו מתערב בשום משקין72),"
        },
        {
          "s": 8,
          "text": "מ\"מ הוא מפעפע בכל דבר73"
        },
        {
          "s": 9,
          "text": "(היינו,"
        },
        {
          "s": 10,
          "text": "שהשמן עצמו מפעפע בכל דבר,"
        },
        {
          "s": 11,
          "text": "ולא רק שפועל בו)."
        },
        {
          "s": 12,
          "text": "ועד\"ז הוא בנוגע להגילוי די\"ט כסלו,"
        },
        {
          "s": 13,
          "text": "דזה שאז הותחל עיקר הענין דיפוצו מעינותיך חוצה74,"
        },
        {
          "s": 14,
          "text": "הוא מפני שאז נמשך הגילוי דפנימיות עתיק,"
        },
        {
          "s": 15,
          "text": "דפנימיות עתיק הוא מובדל מכל ההשתלשלות"
        },
        {
          "s": 16,
          "text": "(ועאכו\"כ מחוצה)"
        },
        {
          "s": 17,
          "text": "עוד יותר מחיצוניות עתיק"
        },
        {
          "s": 18,
          "text": "(דוגמת השמן שאינו מתערב בשאר משקין),"
        },
        {
          "s": 19,
          "text": "ואעפ\"כ,"
        },
        {
          "s": 20,
          "text": "ומטעם זה גופא,"
        },
        {
          "s": 21,
          "text": "דוקא לאחרי י\"ט כסלו הותחל הענין דיפוצו מעינותיך חוצה,"
        },
        {
          "s": 22,
          "text": "שבהחוצה ישנם המעינות עצמם"
        },
        {
          "s": 23,
          "text": "(דוגמת שמן שהוא עצמו מפעפע בכל דבר)."
        }
      ]
    }
  ]
}