{
  "globalIndex": 280,
  "owner": 30,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915384_theRebbe_69__p004",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915384_theRebbe_69__p004",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915384_theRebbe_69",
  "title": "מאמר אתה אחד תשמ\"ב",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ויש לומר דזהו גם הקשר דאמירת דרוש זה לש\"ק האחרון של המאסר,"
        },
        {
          "s": 2,
          "text": "ערב יום הגאולה,"
        },
        {
          "s": 3,
          "text": "דהנה ידוע שע\"י המאסר נעשה"
        },
        {
          "s": 4,
          "text": "(איז אויפגעטאָן געוואָרן)"
        },
        {
          "s": 5,
          "text": "עילוי גדול יותר כו'."
        },
        {
          "s": 6,
          "text": "וע\"ד מאמר רז\"ל30"
        },
        {
          "s": 7,
          "text": "הזית כשכותשין אותו"
        },
        {
          "s": 8,
          "text": "(דוקא)"
        },
        {
          "s": 9,
          "text": "הוא נותן שמנו31."
        },
        {
          "s": 10,
          "text": "והגם שהענין דיפוצו מעינותיך חוצה הי' גם לפני המאסר"
        },
        {
          "s": 11,
          "text": "(דאדמו\"ר האמצעי),"
        },
        {
          "s": 12,
          "text": "מ\"מ,"
        },
        {
          "s": 13,
          "text": "ע\"י המאסר ניתוסף בזה,"
        },
        {
          "s": 14,
          "text": "וי\"ל שעד להוספה באין ערוך,"
        },
        {
          "s": 15,
          "text": "וכדיוק לשון רז\"ל שע\"י הכתישה הוא נותן שמנו"
        },
        {
          "s": 16,
          "text": "(נותן דוקא)32,"
        },
        {
          "s": 17,
          "text": "דכל הנותן בעין יפה הוא נותן33."
        },
        {
          "s": 18,
          "text": "וגודל העילוי שנתחדש ע\"י המאסר דוקא מובן מהמבואר בשיחת כ\"ק מו\"ח אדמו\"ר34"
        },
        {
          "s": 19,
          "text": "(בנוגע להמאסר דאדמו\"ר הזקן,"
        },
        {
          "s": 20,
          "text": "דמזה מובן גם בנוגע להמאסר דאדמו\"ר האמצעי),"
        },
        {
          "s": 21,
          "text": "שהמאסר הי' בהסכמתו,"
        },
        {
          "s": 22,
          "text": "כי כל צדיק וצדיק הוא מושל ושולט על כל הענינים הגשמיים שלו,"
        },
        {
          "s": 23,
          "text": "וכל מאורע עמו הוא בהסכמתו."
        },
        {
          "s": 24,
          "text": "ומזה שהסכים על המאסר אף שזה הי' קשור עם יסורים וכו' ועם מניעת הפצת תורת החסידות"
        },
        {
          "s": 25,
          "text": "(בעת שבתו במאסר),"
        },
        {
          "s": 26,
          "text": "מובן מזה גודל העילוי דהפצת המעינות שנתחדש לאחרי גאולתו דוקא,"
        },
        {
          "s": 27,
          "text": "עד שבשביל זה הי' כדאי כל המאסר."
        },
        {
          "s": 28,
          "text": "וזהו הקשר דאמירת דרוש זה ל"
        },
        {
          "s": 29,
          "text": "(ערב יום)"
        },
        {
          "s": 30,
          "text": "הגאולה35,"
        },
        {
          "s": 31,
          "text": "כי אז נתחדש עילוי גדול יותר בגילוי פנימיות התורה"
        },
        {
          "s": 32,
          "text": "[בחינת יחידה דתורה],"
        },
        {
          "s": 33,
          "text": "גילוי בהבנה והשגה,"
        },
        {
          "s": 34,
          "text": "ועד שהגילוי הוא לא רק בחו\"ב אלא גם בבחינת הדעת,"
        },
        {
          "s": 35,
          "text": "דשרש הדעת הוא בפנימיות הכתר"
        },
        {
          "s": 36,
          "text": "[וכמבואר בארוכה בהמשך עת\"ר36"
        },
        {
          "s": 37,
          "text": "מעלת ענין הדעת],"
        },
        {
          "s": 38,
          "text": "בחינת יחידה."
        },
        {
          "s": 39,
          "text": "דזהו יכירו בניך וידעו כי מאתך היא מנוחתם,"
        },
        {
          "s": 40,
          "text": "דגילוי בחינת יחידה"
        },
        {
          "s": 41,
          "text": "(מאתך היא מנוחתם)"
        },
        {
          "s": 42,
          "text": "הוא בענין הדעת דוקא,"
        },
        {
          "s": 43,
          "text": "יכירו כו' וידעו."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "וזהו ג\"כ מה שמשיח ילמד דעת לכל העם בהשגת פנימיות התורה37,"
        },
        {
          "s": 2,
          "text": "דעת דוקא,"
        },
        {
          "s": 3,
          "text": "דעיקר הענין שיתחדש בימות המשיח הוא"
        },
        {
          "s": 4,
          "text": "[כמ\"ש הרמב\"ם בסיום וחותם ספרו]"
        },
        {
          "s": 5,
          "text": "כי מלאה הארץ דעה את הוי'38,"
        },
        {
          "s": 6,
          "text": "דעה דוקא."
        },
        {
          "s": 7,
          "text": "וגילוי זה יהי' באופן דכמים לים מכסים,"
        },
        {
          "s": 8,
          "text": "היינו שזה יהי'"
        },
        {
          "s": 9,
          "text": "(נוסף על דעת והכרת השכל,"
        },
        {
          "s": 10,
          "text": "גם)"
        },
        {
          "s": 11,
          "text": "בראי' מוחשית,"
        },
        {
          "s": 12,
          "text": "כמו מי הים שנראים בראי' מוחשית."
        },
        {
          "s": 13,
          "text": "דהנה מבואר בכ\"מ39"
        },
        {
          "s": 14,
          "text": "בענין הנבראים שבעלמא דאתכסיא שהם בדוגמת דגים שבים שהם בטלים להמים,"
        },
        {
          "s": 15,
          "text": "עד שמציאותם של הדגים אינה נראית כלל ומה שנראה הם רק מי הים שמכסים עליהם40."
        },
        {
          "s": 16,
          "text": "ומזה מובן שפירוש כמים לים מכסים הוא שהגילוי דאלקות יהי' אז בראי' מוחשית,"
        },
        {
          "s": 17,
          "text": "כמו מי הים"
        },
        {
          "s": 18,
          "text": "(שמכסים על הנבראים שבתוכם)"
        },
        {
          "s": 19,
          "text": "שהם נראים בראי' מוחשית."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ויהי רצון שמלימוד ענינים אלו בתורה יבואו בקרוב לקיום היעוד"
        },
        {
          "s": 1,
          "text": "(דענינים אלה)"
        },
        {
          "s": 2,
          "text": "בפועל,"
        },
        {
          "s": 3,
          "text": "שמתוך מנוחה אמיתית ומתוך שמחה וטוב לבב נלך לקראת הגאולה האמיתית והשלימה ע\"י משיח צדקנו,"
        },
        {
          "s": 4,
          "text": "שאז יהי' מלאה הארץ דעה את הוי' כמים לים מכסים."
        }
      ]
    }
  ]
}