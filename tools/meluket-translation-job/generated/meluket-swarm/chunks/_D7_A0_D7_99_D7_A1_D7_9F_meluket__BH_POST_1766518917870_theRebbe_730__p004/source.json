{
  "globalIndex": 697,
  "owner": 47,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917870_theRebbe_730__p004",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917870_theRebbe_730__p004",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917870_theRebbe_730",
  "title": "מאמר אשרי תבחר ותקרב תשט\"ז",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "וזהו שד' ענינים הנ\"ל שבעבודת האדם הם דוגמת ד' העולמות אבי\"ע,"
        },
        {
          "s": 1,
          "text": "דהביטול בנפש הבהמית ובנפש השכלית,"
        },
        {
          "s": 2,
          "text": "שהביטול הוא דבר נוסף על מציאותם,"
        },
        {
          "s": 3,
          "text": "הוא ע\"ד הביטול דעשי' ויצירה."
        },
        {
          "s": 4,
          "text": "[ולהוסיף,"
        },
        {
          "s": 5,
          "text": "דזה שחצר צריך שמירה הוא לפי שעשי' ויצירה הם מציאות,"
        },
        {
          "s": 6,
          "text": "ולכן הדברים שנשתלשלו מהם צריכים שמירה."
        },
        {
          "s": 7,
          "text": "וענין חצריך לשון רבים הוא,"
        },
        {
          "s": 8,
          "text": "כי העבודה שמצד עולם העשי',"
        },
        {
          "s": 9,
          "text": "עיקרה הוא מעשה בפועל,"
        },
        {
          "s": 10,
          "text": "שלזה מספיק השמירה שע\"י מחיצות – חצר שאינו מקורה,"
        },
        {
          "s": 11,
          "text": "והעבודה שמצד יצירה עיקרה הוא מדות,"
        },
        {
          "s": 12,
          "text": "שלזה צריך השמירה דגג – חצר מקורה]."
        },
        {
          "s": 13,
          "text": "והשכל והמדות דנפש האלקית שמתלבשים בנה\"ב,"
        },
        {
          "s": 14,
          "text": "שהביטול שבהם אינו דבר נוסף על מציאותם אבל הוא דוגמת ביטול היש – הוא ע\"ד הביטול דבריאה,"
        },
        {
          "s": 15,
          "text": "והביטול דנה\"א עצמה"
        },
        {
          "s": 16,
          "text": "(כולל גם הביטול דדרגת הנשמה המלובשת בנה\"ב כמו שהיא בפנימיותה)"
        },
        {
          "s": 17,
          "text": "שהוא ביטול במציאות – הוא ע\"ד הביטול דאצילות."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וזהו בקדמיתא חצריך לבתר ביתך ולבתר היכלך,"
        },
        {
          "s": 2,
          "text": "בקדמיתא חצריך"
        },
        {
          "s": 3,
          "text": "(לשון רבים,"
        },
        {
          "s": 4,
          "text": "חצר שאינו מקורה וחצר מקורה)"
        },
        {
          "s": 5,
          "text": "הוא הבירור והזיכוך דנה\"ב ונפש השכלית,"
        },
        {
          "s": 6,
          "text": "שגם לאחרי הבירור והזיכוך שלהם הם בדרגת בעלי חיים."
        },
        {
          "s": 7,
          "text": "לבתר ביתך הוא גילוי נפש האלקית כמו שמתלבשת בנפש השכלית והבהמית,"
        },
        {
          "s": 8,
          "text": "שהביטול שלה הוא דוגמת הביטול שבבריאה."
        },
        {
          "s": 9,
          "text": "ונק' בית,"
        },
        {
          "s": 10,
          "text": "כי כמו שבית הוא מקום מושב האדם כמ\"ש38"
        },
        {
          "s": 11,
          "text": "כתפארת אדם לשבת בית,"
        },
        {
          "s": 12,
          "text": "כך עולם הבריאה"
        },
        {
          "s": 13,
          "text": "(עולם הכסא39)"
        },
        {
          "s": 14,
          "text": "הוא מקום מושב אדם העליון,"
        },
        {
          "s": 15,
          "text": "שעיקר דירתו של אדם העליון בנבראים40"
        },
        {
          "s": 16,
          "text": "הוא כשהביטול שלהם לאלקות הוא באופן שזה"
        },
        {
          "s": 17,
          "text": "(הביטול)"
        },
        {
          "s": 18,
          "text": "הוא כל מציאותם."
        },
        {
          "s": 19,
          "text": "ולבתר היכלך הוא גילוי הנשמה שלמעלה מהתלבשות בנה\"ב"
        },
        {
          "s": 20,
          "text": "(כולל גם הפנימיות דדרגת הנשמה המלובשת בנה\"ב),"
        },
        {
          "s": 21,
          "text": "שהביטול שלה הוא ביטול במציאות כהביטול דאצילות41."
        },
        {
          "s": 22,
          "text": "ונק' היכלך,"
        },
        {
          "s": 23,
          "text": "דענין היכלך הוא כמ\"ש42"
        },
        {
          "s": 24,
          "text": "והוי' בהיכל קדשו הס מפניו כל הארץ,"
        },
        {
          "s": 25,
          "text": "שלגבי הוי' בהיכל קדשו מתבטל"
        },
        {
          "s": 26,
          "text": "(הס)"
        },
        {
          "s": 27,
          "text": "כל ענין המציאות"
        },
        {
          "s": 28,
          "text": "(כל הארץ),"
        },
        {
          "s": 29,
          "text": "ועד שאין שייך גם אפשרות המציאות."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וזהו שקודם ברית מילה אומרים הפסוק אשרי תבחר ותקרב גו',"
        },
        {
          "s": 2,
          "text": "כי ד' העולמות אבי\"ע הם בכלל סדר ההשתלשלות,"
        },
        {
          "s": 3,
          "text": "ומילה היא למעלה מהשתלשלות."
        },
        {
          "s": 4,
          "text": "וכמרז\"ל43"
        },
        {
          "s": 5,
          "text": "עה\"פ44"
        },
        {
          "s": 6,
          "text": "למנצח על השמינית על מילה שניתנה בשמיני,"
        },
        {
          "s": 7,
          "text": "ומבואר בלקו\"ת"
        },
        {
          "s": 8,
          "text": "(ד\"ה למנצח על השמינית45)"
        },
        {
          "s": 9,
          "text": "דזה שהשירה של דוד היתה על זה שמילה ניתנה בשמיני,"
        },
        {
          "s": 10,
          "text": "הוא,"
        },
        {
          "s": 11,
          "text": "כי שמיני הוא בחינת א\"ק שלמעלה מאצילות46."
        },
        {
          "s": 12,
          "text": "ולכאורה יש להוסיף,"
        },
        {
          "s": 13,
          "text": "דמילה היא למעלה לא רק מד' העולמות אלא גם מד' האותיות דשם הוי'"
        },
        {
          "s": 14,
          "text": "(לשון מהווה47)"
        },
        {
          "s": 15,
          "text": "שמהם מתהווים ד' העולמות48."
        },
        {
          "s": 16,
          "text": "וכמ\"ש בתו\"א49"
        },
        {
          "s": 17,
          "text": "ע\"פ50"
        },
        {
          "s": 18,
          "text": "מי יעלה לנו השמימה,"
        },
        {
          "s": 19,
          "text": "שהוא ראשי תיבות מילה וסופי תיבות הוי'51,"
        },
        {
          "s": 20,
          "text": "דזה שמילה הוא ראשי תיבות והוי' הוא סופי תיבות הוא לפי שמילה היא למעלה מהוי'."
        },
        {
          "s": 21,
          "text": "אבל בכדי שתהי' המשכת הגילוי שלמעלה מהשתלשלות ע\"י המילה,"
        },
        {
          "s": 22,
          "text": "צריך להיות תחלה השלימות דהשתלשלות,"
        },
        {
          "s": 23,
          "text": "כמארז\"ל52"
        },
        {
          "s": 24,
          "text": "כדי שיעבור עליו שבת אחת,"
        },
        {
          "s": 25,
          "text": "דשבת הוא השלימות דהשתלשלות ועי\"ז אפשר להגיע להגילוי שלמעלה מהשתלשלות"
        },
        {
          "s": 26,
          "text": "(מילה בשמיני)."
        },
        {
          "s": 27,
          "text": "ויש לומר,"
        },
        {
          "s": 28,
          "text": "דזהו מ\"ש53"
        },
        {
          "s": 29,
          "text": "התהלך לפני והי' תמים,"
        },
        {
          "s": 30,
          "text": "שבתחלה צריך להיות והי' אותיות הוי' ועי\"ז באים אח\"כ לבחינת תמים,"
        },
        {
          "s": 31,
          "text": "הגילוי שע\"י מילה."
        },
        {
          "s": 32,
          "text": "ולכן אומרים קודם הברית הפסוק אשרי תבחר ותקרב ישכון חצריך נשבעה בטוב ביתך קדוש היכלך"
        },
        {
          "s": 33,
          "text": "[וגם בלילה שלפני הברית"
        },
        {
          "s": 34,
          "text": "(שאז הוא התחלת ההכנה להברית)"
        },
        {
          "s": 35,
          "text": "נוהגים ללמוד מאמר הזהר ע\"פ זה54],"
        },
        {
          "s": 36,
          "text": "כי העבודה בד' הענינים שבפסוק זה שהם כנגד ד' העולמות וד' אותיות שם הוי' היא ההכנה והכלי להגילוי שלמעלה מהשתלשלות."
        }
      ]
    }
  ]
}