{
  "globalIndex": 1053,
  "owner": 3,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919986_theRebbe_397__p002",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919986_theRebbe_397__p002",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919986_theRebbe_397",
  "title": "מאמר לא היו ימים טובים לישראל תשל\"ה",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ונקודת הביאור בהמעלה דט\"ו באב,"
        },
        {
          "s": 1,
          "text": "הגם שבכל ט\"ו בחודש הוא מילוי הלבנה,"
        },
        {
          "s": 2,
          "text": "מבואר בהדרושים14,"
        },
        {
          "s": 3,
          "text": "שזהו לפי שהעלי' דט\"ו באב באה לאחרי הירידה דט\"ב."
        },
        {
          "s": 4,
          "text": "והענין הוא,"
        },
        {
          "s": 5,
          "text": "הנה איתא בילקוט15,"
        },
        {
          "s": 6,
          "text": "עלה ארי' במזל ארי' והחריב אריאל כו' על מנת שיבוא ארי'"
        },
        {
          "s": 7,
          "text": "[זה הקב\"ה דכתיב בי'16"
        },
        {
          "s": 8,
          "text": "ארי' שאג מי לא יירא],"
        },
        {
          "s": 9,
          "text": "במזל ארי'"
        },
        {
          "s": 10,
          "text": "[והפכתי אבלם לששון17],"
        },
        {
          "s": 11,
          "text": "ויבנה אריאל כו'."
        },
        {
          "s": 12,
          "text": "והיינו18,"
        },
        {
          "s": 13,
          "text": "שהגלות והחורבן שהי' במזל ארי'"
        },
        {
          "s": 14,
          "text": "(בחודש החמישי)"
        },
        {
          "s": 15,
          "text": "הוא אך ורק בכדי"
        },
        {
          "s": 16,
          "text": "(על מנת)"
        },
        {
          "s": 17,
          "text": "שיבוא ארי' כו' ויבנה אריאל,"
        },
        {
          "s": 18,
          "text": "ביהמ\"ק השלישי,"
        },
        {
          "s": 19,
          "text": "שהוא נעלה יותר מבית ראשון ושני."
        },
        {
          "s": 20,
          "text": "כי העילוי דביהמ\"ק השלישי"
        },
        {
          "s": 21,
          "text": "(שהוא נעלה יותר מבית ראשון ומבית שני)"
        },
        {
          "s": 22,
          "text": "בא דוקא ע\"י קדימת הגלות וכו'."
        },
        {
          "s": 23,
          "text": "וזהו14"
        },
        {
          "s": 24,
          "text": "המעלה דט\"ו באב על ט\"ו שבכל חודש,"
        },
        {
          "s": 25,
          "text": "גם על ט\"ו בניסן"
        },
        {
          "s": 26,
          "text": "(פסח)"
        },
        {
          "s": 27,
          "text": "וט\"ו בתשרי"
        },
        {
          "s": 28,
          "text": "(סוכות),"
        },
        {
          "s": 29,
          "text": "כי מכיון שהעלי' דט\"ו באב באה לאחרי הירידה הגדולה דט\"ב"
        },
        {
          "s": 30,
          "text": "(עלה ארי' כו' והחריב אריאל),"
        },
        {
          "s": 31,
          "text": "לכן היא עלי' גדולה ביותר."
        },
        {
          "s": 32,
          "text": "וכידוע19"
        },
        {
          "s": 33,
          "text": "הכלל בעליות וירידות,"
        },
        {
          "s": 34,
          "text": "שלפי\"ע הירידה כן היא העלי'."
        },
        {
          "s": 35,
          "text": "והגם שגם העלי' דט\"ו בניסן"
        },
        {
          "s": 36,
          "text": "(פסח)"
        },
        {
          "s": 37,
          "text": "באה לאחרי הירידה דגלות מצרים,"
        },
        {
          "s": 38,
          "text": "הרי אז היו ישראל במעמד ומצב של צדיקים."
        },
        {
          "s": 39,
          "text": "וגם העלי' דט\"ו בתשרי"
        },
        {
          "s": 40,
          "text": "(סוכות),"
        },
        {
          "s": 41,
          "text": "הגם שהיא באה בהמשך להתשובה דיוהכ\"פ,"
        },
        {
          "s": 42,
          "text": "מ\"מ,"
        },
        {
          "s": 43,
          "text": "מכיון שכללות העבודה דתומ\"צ היא עבודה רוחנית"
        },
        {
          "s": 44,
          "text": "[דהגם שהמצוות נתלבשו בדברים גשמיים,"
        },
        {
          "s": 45,
          "text": "ציצית בצמר גשמי ותפילין בקלף גשמי,"
        },
        {
          "s": 46,
          "text": "מ\"מ הרי ענין המצוות הוא להכניס רוחניות בהגשמיות20],"
        },
        {
          "s": 47,
          "text": "הרי הירידה שע\"י החטאים ועוונות"
        },
        {
          "s": 48,
          "text": "(היפך ענין המצוות)"
        },
        {
          "s": 49,
          "text": "היא בנוגע להגשמיות כמו ששייך לרוחניות21,"
        },
        {
          "s": 50,
          "text": "ובמילא אין זה עדיין תכלית הירידה,"
        },
        {
          "s": 51,
          "text": "ולכן גם העלי' דסוכות שע\"י התשובה אינה תכלית העלי'."
        },
        {
          "s": 52,
          "text": "משא\"כ הירידה דט\"ב,"
        },
        {
          "s": 53,
          "text": "ששפך חמתו על העצים ועל האבנים22"
        },
        {
          "s": 54,
          "text": "(עצים ואבנים גשמיים),"
        },
        {
          "s": 55,
          "text": "היינו שהירידה"
        },
        {
          "s": 56,
          "text": "(שמצד החטאים)"
        },
        {
          "s": 57,
          "text": "פעלה בהגשמיות דעולם שאין תחתון למטה ממנו,"
        },
        {
          "s": 58,
          "text": "הנה מכיון שהירידה דט\"ב היא ירידה שאין למטה ממנה,"
        },
        {
          "s": 59,
          "text": "לכן גם העלי' דט\"ו באב שלאחרי ירידה זו היא עלי' גדולה ביותר,"
        },
        {
          "s": 60,
          "text": "לפי\"ע עוצם הירידה."
        },
        {
          "s": 61,
          "text": "וזהו\"ע נחמה בכפליים23,"
        },
        {
          "s": 62,
          "text": "ואנכי אנכי הוא מנחמכם24,"
        },
        {
          "s": 63,
          "text": "ב\"פ אנכי25."
        },
        {
          "s": 64,
          "text": "ועפ\"ז מובן שהיו\"ט דט\"ו באב הוא נעלה יותר גם מהיו\"ט דיוהכ\"פ."
        },
        {
          "s": 65,
          "text": "וזהו מה שאמרו לא היו יו\"ט לישראל כט\"ו באב וכיום הכפורים,"
        },
        {
          "s": 66,
          "text": "שמקדים ט\"ו באב ליוהכ\"פ,"
        },
        {
          "s": 67,
          "text": "אע\"פ שהענין דט\"ו באב"
        },
        {
          "s": 68,
          "text": "(לפי כל הטעמים שבגמרא)"
        },
        {
          "s": 69,
          "text": "נתחדש משך כמה שנים לאחרי יוהכ\"פ,"
        },
        {
          "s": 70,
          "text": "וגם בזמני השנה"
        },
        {
          "s": 71,
          "text": "(בכל שנה)"
        },
        {
          "s": 72,
          "text": "יוהכ\"פ"
        },
        {
          "s": 73,
          "text": "(שבחודש תשרי)"
        },
        {
          "s": 74,
          "text": "הוא קודם לט\"ו באב,"
        },
        {
          "s": 75,
          "text": "לפי שהיו\"ט דט\"ו באב הוא נעלה יותר"
        },
        {
          "s": 76,
          "text": "(קודם במעלה)"
        },
        {
          "s": 77,
          "text": "מהיו\"ט דיוהכ\"פ."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "אך עדיין צריך להבין,"
        },
        {
          "s": 1,
          "text": "הרי ושמחת בחגיך הוא מ\"ע מה\"ת,"
        },
        {
          "s": 2,
          "text": "משא\"כ היו\"ט"
        },
        {
          "s": 3,
          "text": "(והשמחה)"
        },
        {
          "s": 4,
          "text": "דט\"ו באב."
        },
        {
          "s": 5,
          "text": "וגם היו\"ט דיוהכ\"פ אינו מה\"ת"
        },
        {
          "s": 6,
          "text": "[שהרי אין חיוב לשמוח ביוהכ\"פ,"
        },
        {
          "s": 7,
          "text": "ואדרבה26,"
        },
        {
          "s": 8,
          "text": "המצוה דיוהכ\"פ היא ועניתם את נפשותיכם27."
        },
        {
          "s": 9,
          "text": "ורק שמכיון שהוא יום סליחה וכפרה,"
        },
        {
          "s": 10,
          "text": "הנה בדרך ממילא מסתעף מזה ענין השמחה],"
        },
        {
          "s": 11,
          "text": "וא\"כ איך אפשר שהיו\"ט"
        },
        {
          "s": 12,
          "text": "(והשמחה)"
        },
        {
          "s": 13,
          "text": "דט\"ו באב ויוהכ\"פ יהי' גדול יותר מהימים טובים שמצוה מן התורה לשמוח בהם."
        },
        {
          "s": 14,
          "text": "אך הענין הוא,"
        },
        {
          "s": 15,
          "text": "שבהעילוי דקיימא סיהרא באשלמותא ישנם שתי בחינות בכללות."
        },
        {
          "s": 16,
          "text": "הבחינה דקיימא סיהרא באשלמותא כמו שהיא מצד הסדר ודין התורה"
        },
        {
          "s": 17,
          "text": "[ומזה נשתלשל הסדר דשינויי הלבנה ע\"פ טבע],"
        },
        {
          "s": 18,
          "text": "והבחינה דקיימא סיהרא באשלמותא כמו שהיא מצד עבודת האדם,"
        },
        {
          "s": 19,
          "text": "כמו שהיא למעלה מכמו שהוא ע\"פ דין התורה."
        },
        {
          "s": 20,
          "text": "כי ישראל הם למעלה מהתורה,"
        },
        {
          "s": 21,
          "text": "שלכן נקראים ישראל בשם חתן והתורה בשם כלה28,"
        },
        {
          "s": 22,
          "text": "לפי שישראל הם משפיעים בתורה."
        },
        {
          "s": 23,
          "text": "דזהו\"ע ברכו בתורה תחילה29,"
        },
        {
          "s": 24,
          "text": "שישראל מברכים וממשיכים בתורה מבחינת נותן התורה30,"
        },
        {
          "s": 25,
          "text": "וע\"ד דוד הי' מחבר אורייתא בקוב\"ה31."
        },
        {
          "s": 26,
          "text": "וזהו העילוי דט\"ו באב על ט\"ו בניסן וט\"ו בתשרי,"
        },
        {
          "s": 27,
          "text": "כי שלימות הלבנה שבט\"ו בניסן וט\"ו בתשרי הו\"ע קיימא סיהרא באשלמותא שמצד הסדר דתורה,"
        },
        {
          "s": 28,
          "text": "היינו מצד עבודת האדם כמו שהיא במדידה ע\"פ תורה."
        },
        {
          "s": 29,
          "text": "דהגם שע\"י עבודה זו נעשה עילוי בהעולם,"
        },
        {
          "s": 30,
          "text": "מ\"מ העילוי הוא במדידה ובהגבלה."
        },
        {
          "s": 31,
          "text": "משא\"כ שלימות הלבנה שבט\"ו באב הו\"ע קיימא סיהרא באשלמותא כמו שהוא מצד העבודה דנש\"י שלמעלה מהתורה,"
        },
        {
          "s": 32,
          "text": "עבודה דבכל מאדך."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ובכדי לבאר ג' ענינים אלו"
        },
        {
          "s": 1,
          "text": "[העולם כמו שהוא מצד עצמו,"
        },
        {
          "s": 2,
          "text": "דעולם על מילואו נברא32."
        },
        {
          "s": 3,
          "text": "מה שמיתוסף בהעולם ע\"י עבודת האדם כמו שהיא מצד המדידה דתורה."
        },
        {
          "s": 4,
          "text": "והחידוש שנעשה ע\"י העבודה דבכל מאדך שלמעלה ממדידה"
        },
        {
          "s": 5,
          "text": "(גם מהמדידה דתורה)],"
        },
        {
          "s": 6,
          "text": "מביא בהדרושים33"
        },
        {
          "s": 7,
          "text": "פירוש הכתוב34"
        },
        {
          "s": 8,
          "text": "ויתרון ארץ בכל היא מלך לשדה נעבד,"
        },
        {
          "s": 9,
          "text": "שיש בזה ג' בחינות."
        },
        {
          "s": 10,
          "text": "בחינת ארץ כמו שהיא מצד עצמה,"
        },
        {
          "s": 11,
          "text": "היתרון דארץ ע\"י בחינת כל,"
        },
        {
          "s": 12,
          "text": "ובחינת מלך לשדה נעבד שנעלה גם מיתרון ארץ."
        },
        {
          "s": 13,
          "text": "דהנה יתרון ארץ הוא בחינת שדה"
        },
        {
          "s": 14,
          "text": "(כמו שהיא מצד עצמה)"
        },
        {
          "s": 15,
          "text": "[כי שדה היא בכלל ארץ אלא שלהיותה מהמובחר שבארץ,"
        },
        {
          "s": 16,
          "text": "מה שראוי לזריעה ולצמיחה,"
        },
        {
          "s": 17,
          "text": "לכן היא יתרון ארץ],"
        },
        {
          "s": 18,
          "text": "אמנם מה שמלך לשדה נעבד"
        },
        {
          "s": 19,
          "text": "(העילוי שנעשה בשדה ע\"י עבודה)"
        },
        {
          "s": 20,
          "text": "הוא למעלה מיתרון ארץ."
        },
        {
          "s": 21,
          "text": "והענין הוא,"
        },
        {
          "s": 22,
          "text": "הנה שדה קאי על ג\"ע,"
        },
        {
          "s": 23,
          "text": "דכמו ששדה היא מהמובחר שבארץ מה שראוי לזריעה וצמיחה"
        },
        {
          "s": 24,
          "text": "(כנ\"ל),"
        },
        {
          "s": 25,
          "text": "כן ג\"ע הוא מהמובחר שבעולם מה שראוי לגילוי אור,"
        },
        {
          "s": 26,
          "text": "היינו לבחינת אור שלמעלה מהאור שמאיר בכללות העולם."
        },
        {
          "s": 27,
          "text": "דהאור שמאיר בכללות העולם הוא מבחינת המדות,"
        },
        {
          "s": 28,
          "text": "דזהו מה שההתהוות הוא מבחינת ששת ימי הבנין או שבעת ימי הבנין."
        },
        {
          "s": 29,
          "text": "והגם שבעשרה מאמרות נברא העולם35"
        },
        {
          "s": 30,
          "text": "(שבעשרה נכלל גם ג' מוחין),"
        },
        {
          "s": 31,
          "text": "הרי זהו המוחין כמו שהם בהמדות."
        },
        {
          "s": 32,
          "text": "אבל האור שמאיר בג\"ע הוא"
        },
        {
          "s": 33,
          "text": "(גם)"
        },
        {
          "s": 34,
          "text": "מבחינת ג\"ר."
        },
        {
          "s": 35,
          "text": "ומטעם זה יש עוד מעלה בג\"ע לגבי כללות העולם,"
        },
        {
          "s": 36,
          "text": "שהגילוי שבעולם הוא בבחינת ידיעת המציאות,"
        },
        {
          "s": 37,
          "text": "ובג\"ע הוא גילוי המהות36."
        },
        {
          "s": 38,
          "text": "וזהו מה שויתרון ארץ גו' הוא בחינת ג\"ע"
        },
        {
          "s": 39,
          "text": "(וכנ\"ל שיתרון ארץ הוא בחינת שדה),"
        },
        {
          "s": 40,
          "text": "כי ג\"ע הוא בחינת העולם כמו שהוא בנין שלם בכל הע\"ס,"
        },
        {
          "s": 41,
          "text": "ז\"ת וג\"ר,"
        },
        {
          "s": 42,
          "text": "בחינת עולם על מילואו נברא."
        },
        {
          "s": 43,
          "text": "וזהו ג\"כ מ\"ש ויתרון ארץ בכל היא,"
        },
        {
          "s": 44,
          "text": "שהיתרון"
        },
        {
          "s": 45,
          "text": "(והמעלה)"
        },
        {
          "s": 46,
          "text": "בג\"ע לגבי כללות העולם הוא ע\"י כל,"
        },
        {
          "s": 47,
          "text": "כל קאי על ספירת היסוד37"
        },
        {
          "s": 48,
          "text": "שנקרא כל על שם חמשים שערי בינה"
        },
        {
          "s": 49,
          "text": "(כל בגימטריא חמשים38)"
        },
        {
          "s": 50,
          "text": "הנמשכים בו,"
        },
        {
          "s": 51,
          "text": "ועי\"ז נמשך בו גם מבחינת החכמה,"
        },
        {
          "s": 52,
          "text": "דחו\"ב הן כללות המוחין."
        },
        {
          "s": 53,
          "text": "ועילוי הנ\"ל שבג\"ע מה שהוא יתרון ארץ"
        },
        {
          "s": 54,
          "text": "[מה שמאיר בו הבחי' דג\"ר,"
        },
        {
          "s": 55,
          "text": "ושמצד זה יש בו גם גילוי המהות]"
        },
        {
          "s": 56,
          "text": "הוא בחינת שדה מצד עצמה."
        },
        {
          "s": 57,
          "text": "אמנם ע\"י העבודה,"
        },
        {
          "s": 58,
          "text": "מלך לשדה נעבד,"
        },
        {
          "s": 59,
          "text": "נעשה עילוי שלמעלה מבחינת יתרון ארץ."
        },
        {
          "s": 60,
          "text": "וכדאיתא בזהר39"
        },
        {
          "s": 61,
          "text": "מלך לשדה נעבד מאן מלך דא מלך עילאה,"
        },
        {
          "s": 62,
          "text": "שבחינה זו היא למעלה מעולם"
        },
        {
          "s": 63,
          "text": "(גם כמו שהוא בשלימות,"
        },
        {
          "s": 64,
          "text": "יתרון ארץ)."
        },
        {
          "s": 65,
          "text": "כי כל ענין התהוות העולם הוא רק מעשרה מאמרות שראשיתם היא חכמה,"
        },
        {
          "s": 66,
          "text": "ומלך עילאה הוא בחינת הכתר שלמעלה מהשתלשלות."
        }
      ]
    }
  ]
}