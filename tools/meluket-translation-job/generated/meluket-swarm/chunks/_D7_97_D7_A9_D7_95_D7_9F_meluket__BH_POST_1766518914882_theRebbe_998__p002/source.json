{
  "globalIndex": 188,
  "owner": 38,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914882_theRebbe_998__p002",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914882_theRebbe_998__p002",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518914882_theRebbe_998",
  "title": "מאמר ויהיו חיי שרה תש\"ל",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "וביאור ג' מדריגות הנ\"ל"
        },
        {
          "s": 2,
          "text": "[המלכות כמו שהיא מצד עצמה,"
        },
        {
          "s": 3,
          "text": "המשכת הגילוי דבחינת כל"
        },
        {
          "s": 4,
          "text": "(יסוד),"
        },
        {
          "s": 5,
          "text": "והמשכת הגילוי דבחינת מלך עילאה ע\"י קיום המצוות],"
        },
        {
          "s": 6,
          "text": "הנה החילוק בין יסוד ומלכות הוא14,"
        },
        {
          "s": 7,
          "text": "שמלכות היא שרש הנבראים."
        },
        {
          "s": 8,
          "text": "שלכן נקראת המלכות בשם דיבור"
        },
        {
          "s": 9,
          "text": "(מלכות פה15),"
        },
        {
          "s": 10,
          "text": "דכמו שהדיבור הוא בשביל הזולת."
        },
        {
          "s": 11,
          "text": "דנוסף לזה שהדיבור שמדבר בפועל הוא נשמע לזולתו"
        },
        {
          "s": 12,
          "text": "(דזה שהוא נשמע לזולתו הוא ע\"י שיוצא לחוץ ונעשה נפרד מהאדם המדבר),"
        },
        {
          "s": 13,
          "text": "הנה גם כח."
        },
        {
          "s": 14,
          "text": "הדיבור שבהאדם עצמו,"
        },
        {
          "s": 15,
          "text": "ענינו הוא זה שבכחו לדבר לזולתו."
        },
        {
          "s": 16,
          "text": "ועד\"ז הוא במלכות,"
        },
        {
          "s": 17,
          "text": "שגם בהיותה באצילות"
        },
        {
          "s": 18,
          "text": "(לפני שיורדת להחיות הנבראים)"
        },
        {
          "s": 19,
          "text": "היא שורש ומקור הנבראים."
        },
        {
          "s": 20,
          "text": "ויסוד הוא סיום האצילות"
        },
        {
          "s": 21,
          "text": "(סיומא דגופא15),"
        },
        {
          "s": 22,
          "text": "בדוגמת המדות שבאדם,"
        },
        {
          "s": 23,
          "text": "דהגם שהם שייכים להזולת,"
        },
        {
          "s": 24,
          "text": "הרי ענינם הוא16"
        },
        {
          "s": 25,
          "text": "שהאדם מתעורר ומתפעל."
        },
        {
          "s": 26,
          "text": "וזהו ויתרון ארץ בכל היא,"
        },
        {
          "s": 27,
          "text": "שהיתרון דארץ"
        },
        {
          "s": 28,
          "text": "(מלכות,"
        },
        {
          "s": 29,
          "text": "שרש הנבראים)"
        },
        {
          "s": 30,
          "text": "הוא שנמשך בה בחינת כל,"
        },
        {
          "s": 31,
          "text": "יסוד"
        },
        {
          "s": 32,
          "text": "(סיום האצילות)."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דזה שהמשכה זו נקראת יתרון ארץ,"
        },
        {
          "s": 2,
          "text": "הגם שהמלכות מקבלת תמיד מז\"א"
        },
        {
          "s": 3,
          "text": "(מדות),"
        },
        {
          "s": 4,
          "text": "הוא,"
        },
        {
          "s": 5,
          "text": "כי ההמשכה מז\"א למלכות היא"
        },
        {
          "s": 6,
          "text": "(בדרך כלל)"
        },
        {
          "s": 7,
          "text": "באופן שע\"י שהמלכות מקבלת בתוכה את האורות דז\"א היא משתנית17"
        },
        {
          "s": 8,
          "text": "[וע\"ד כשאדם מדבר דברי אהבה,"
        },
        {
          "s": 9,
          "text": "דכיון דזה שהוא מדבר דברי אהבה הוא כדי לגלות האהבה לזולתו,"
        },
        {
          "s": 10,
          "text": "הרי האהבה שנמשכת בהדיבור היא ירידה ושינוי לגבי האהבה עצמה],"
        },
        {
          "s": 11,
          "text": "והיתרון דארץ"
        },
        {
          "s": 12,
          "text": "(מלכות)"
        },
        {
          "s": 13,
          "text": "הוא בכל"
        },
        {
          "s": 14,
          "text": "(יסוד ז\"א),"
        },
        {
          "s": 15,
          "text": "שהמלכות מקבלת בחינת היסוד"
        },
        {
          "s": 16,
          "text": "(כמו שהוא בעצמותו18)"
        },
        {
          "s": 17,
          "text": "– סיום האצילות."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה זה שהמשכת הגילוי דבחינת כל הוא יתרון בהמלכות,"
        },
        {
          "s": 2,
          "text": "הוא דוקא בנוגע לחיצוניות המלכות,"
        },
        {
          "s": 3,
          "text": "ארץ."
        },
        {
          "s": 4,
          "text": "דכיון שחיצוניות המלכות"
        },
        {
          "s": 5,
          "text": "(הדיבור דמלכות)"
        },
        {
          "s": 6,
          "text": "ענינה הוא שהיא שרש הנבראים,"
        },
        {
          "s": 7,
          "text": "לכן,"
        },
        {
          "s": 8,
          "text": "זה שנמשך בה הגילוי דבחינת כל,"
        },
        {
          "s": 9,
          "text": "(סיום ה)"
        },
        {
          "s": 10,
          "text": "אצילות שלמעלה משרש הנבראים,"
        },
        {
          "s": 11,
          "text": "הוא יתרון"
        },
        {
          "s": 12,
          "text": "(חידוש)."
        },
        {
          "s": 13,
          "text": "אבל בנוגע לפנימיות המלכות,"
        },
        {
          "s": 14,
          "text": "הרי אדרבה,"
        },
        {
          "s": 15,
          "text": "ענינה של פנימיות המלכות"
        },
        {
          "s": 16,
          "text": "(ג\"ר דמלכות)"
        },
        {
          "s": 17,
          "text": "הוא שהיא מקבלת מהיסוד."
        },
        {
          "s": 18,
          "text": "וזהו שהג\"ע נקרא בשם כל"
        },
        {
          "s": 19,
          "text": "[כמארז\"ל19"
        },
        {
          "s": 20,
          "text": "שלשה הטעימן הקב\"ה בעולם הזה מעין עולם הבא,"
        },
        {
          "s": 21,
          "text": "אלו הן,"
        },
        {
          "s": 22,
          "text": "אברהם יצחק ויעקב,"
        },
        {
          "s": 23,
          "text": "אברהם דכתיב בי'20"
        },
        {
          "s": 24,
          "text": "בכל,"
        },
        {
          "s": 25,
          "text": "יצחק דכתיב בי'21"
        },
        {
          "s": 26,
          "text": "מכל,"
        },
        {
          "s": 27,
          "text": "יעקב דכתיב בי'22"
        },
        {
          "s": 28,
          "text": "כל],"
        },
        {
          "s": 29,
          "text": "כי כל הוא ספירת היסוד"
        },
        {
          "s": 30,
          "text": "(כנ\"ל),"
        },
        {
          "s": 31,
          "text": "והג\"ע הוא מבחינת פנימיות המלכות שמקבלת מהיסוד."
        }
      ]
    }
  ]
}