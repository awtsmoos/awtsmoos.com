{
  "globalIndex": 70,
  "owner": 20,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914091_theRebbe_428__p002",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914091_theRebbe_428__p002",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914091_theRebbe_428",
  "title": "מאמר שובה ישראל תש\"מ",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והענין הוא,"
        },
        {
          "s": 2,
          "text": "הנה בהוי' הוא האלקים יש ב' פירושים וענינים23."
        },
        {
          "s": 3,
          "text": "הא' שגם הצמצום דאלקים הוא הוי'."
        },
        {
          "s": 4,
          "text": "דהנה הוי' הוא לשון מהוה24,"
        },
        {
          "s": 5,
          "text": "דכל ההתהוות היא משם הוי',"
        },
        {
          "s": 6,
          "text": "אלא שבכדי שתהי' ההתהוות בפועל בבחי' יש ודבר נפרד,"
        },
        {
          "s": 7,
          "text": "הנה זהו ע\"י שם אלקים שהוא מעלים ומסתיר על שם הוי',"
        },
        {
          "s": 8,
          "text": "כמ\"ש25"
        },
        {
          "s": 9,
          "text": "כי שמש ומגן הוי' אלקים."
        },
        {
          "s": 10,
          "text": "וזהו הוי' הוא האלקים,"
        },
        {
          "s": 11,
          "text": "דהגם שההתהוות בפועל ובגילוי היא משם אלקים כמ\"ש26"
        },
        {
          "s": 12,
          "text": "בראשית ברא אלקים את השמים ואת הארץ,"
        },
        {
          "s": 13,
          "text": "ול\"ב פעמים אלקים נאמר במעשה בראשית27,"
        },
        {
          "s": 14,
          "text": "שמצד זה נעשה העולם ליש ודבר נפרד,"
        },
        {
          "s": 15,
          "text": "הנה ע\"ז בא הציווי וידעת גו' כי הוי' הוא האלקים,"
        },
        {
          "s": 16,
          "text": "שגם שם אלקים המצמצם ומעלים הוא הוי',"
        },
        {
          "s": 17,
          "text": "דהוי' ואלקים כולא חד,"
        },
        {
          "s": 18,
          "text": "ולכן באמת"
        },
        {
          "s": 19,
          "text": "(כמו שהוא לגבי הקב\"ה)"
        },
        {
          "s": 20,
          "text": "אינו מסתיר כלל28,"
        },
        {
          "s": 21,
          "text": "וע\"י העבודה דתומ\"צ ממשיכים גילוי שם הוי' בעולם."
        },
        {
          "s": 22,
          "text": "דזהו מ\"ש אשר ברא אלקים לעשות29,"
        },
        {
          "s": 23,
          "text": "לעשות לתקן30,"
        },
        {
          "s": 24,
          "text": "שצריך לתקן את ההסתר דשם אלקים ולהמשיך גילוי שם הוי' בעולם,"
        },
        {
          "s": 25,
          "text": "כמ\"ש"
        },
        {
          "s": 26,
          "text": "(לאח\"ז31)"
        },
        {
          "s": 27,
          "text": "ביום עשות הוי' אלקים ארץ ושמים,"
        },
        {
          "s": 28,
          "text": "שנזכר כאן גם שם הוי'."
        },
        {
          "s": 29,
          "text": "כי ע\"י עבודת האדם,"
        },
        {
          "s": 30,
          "text": "לעבדה ולשמרה"
        },
        {
          "s": 31,
          "text": "(תורה ומצוות32)"
        },
        {
          "s": 32,
          "text": "נמשך גילוי שם הוי' בעולם,"
        },
        {
          "s": 33,
          "text": "ונעשה אלה תולדות השמים והארץ גו'31,"
        },
        {
          "s": 34,
          "text": "תולדות מלא33,"
        },
        {
          "s": 35,
          "text": "ועד לאלה תולדות פרץ,"
        },
        {
          "s": 36,
          "text": "תולדות מלא34,"
        },
        {
          "s": 37,
          "text": "שהוא למעלה יותר גם מאלה תולדות השמים והארץ,"
        },
        {
          "s": 38,
          "text": "כי ע\"י העבודה דתומ\"צ פורצים את כל ההעלמות וההסתרים דשם אלקים,"
        },
        {
          "s": 39,
          "text": "ועושים דירה לו ית' בתחתונים."
        },
        {
          "s": 40,
          "text": "וענין הב' בהוי' הוא האלקים הוא,"
        },
        {
          "s": 41,
          "text": "שגם שם הוי'"
        },
        {
          "s": 42,
          "text": "(כמו שהוא למעלה מהתלבשות בשם אלקים)"
        },
        {
          "s": 43,
          "text": "הוא רק בחי' אלקים וצמצום לגבי עצמותו ומהותו ית' כביכול,"
        },
        {
          "s": 44,
          "text": "וכמ\"ש35"
        },
        {
          "s": 45,
          "text": "אני הוי' הוא שמי שבחינת הוי' אינו אלא שם,"
        },
        {
          "s": 46,
          "text": "זיו והארה בלבד,"
        },
        {
          "s": 47,
          "text": "שהוא צמצום רב ועצום לגבי אור א\"ס ב\"ה עצמו כביכול."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה שני ענינים אלו נמשכים ע\"י ב' העבודות דצדיקים ובעלי תשובה."
        },
        {
          "s": 2,
          "text": "דכאשר האדם הוא באופן דהאלקים עשה את האדם ישר36"
        },
        {
          "s": 3,
          "text": "הנה ע\"י עבודתו בתורה ומצוות הוא ממשיך הגילוי דשם הוי' בשם אלקים"
        },
        {
          "s": 4,
          "text": "(ענין הא' בהוי' הוא האלקים),"
        },
        {
          "s": 5,
          "text": "כנ\"ל"
        },
        {
          "s": 6,
          "text": "(ס\"ג)."
        },
        {
          "s": 7,
          "text": "אבל כשחטא ופגם והעביר את הדרך א\"א לו להמשיך מבחי' הוי'"
        },
        {
          "s": 8,
          "text": "(מאחר שפגם בשם הוי'),"
        },
        {
          "s": 9,
          "text": "וצריך להמשיך מבחי' שלמעלה משם הוי'37."
        },
        {
          "s": 10,
          "text": "והמשכה זו היא ע\"י עבודת התשובה."
        },
        {
          "s": 11,
          "text": "כי כל הענינים שלמעלה נמשכים ע\"י עבודה דוקא."
        },
        {
          "s": 12,
          "text": "וגם המשכת אוא\"ס שלמעלה מהשתלשלות שאין אתערותא דלתתא מגעת שם,"
        },
        {
          "s": 13,
          "text": "אינה שורה ומתגלה"
        },
        {
          "s": 14,
          "text": "(בבחי' פנימיות)"
        },
        {
          "s": 15,
          "text": "אלא כשיש שלימות במעשה התחתונים38,"
        },
        {
          "s": 16,
          "text": "דקוב\"ה לא שריא אלא באתר שלים39."
        },
        {
          "s": 17,
          "text": "והמשכה זו"
        },
        {
          "s": 18,
          "text": "(דאוא\"ס שלמעלה מהשתלשלות)"
        },
        {
          "s": 19,
          "text": "היא ע\"י העבודה דלמעלה מהשתלשלות"
        },
        {
          "s": 20,
          "text": "(שבאדם),"
        },
        {
          "s": 21,
          "text": "עבודת התשובה."
        },
        {
          "s": 22,
          "text": "דכאשר עושה תשובה ובפרט כזו שזדונות נעשו לו כזכיות40,"
        },
        {
          "s": 23,
          "text": "שהיא תשובה מאהבה מעומקא דלבא באהבה רבה כמבואר בתניא41,"
        },
        {
          "s": 24,
          "text": "הנה עי\"ז הוא מעורר מבחי' שלמעלה משם הוי',"
        },
        {
          "s": 25,
          "text": "שלגבי' גם הוי' כאלקים יחשב,"
        },
        {
          "s": 26,
          "text": "ענין הב' בהוי' הוא האלקים."
        },
        {
          "s": 27,
          "text": "[וזוהי המעלה שבתשובה כפשוטה על התשובה דשבת אותיות תשב,"
        },
        {
          "s": 28,
          "text": "כי התשובה"
        },
        {
          "s": 29,
          "text": "(והעלי')"
        },
        {
          "s": 30,
          "text": "דשבת אותיות תשב היא רק ענין ויכל אלקים42,"
        },
        {
          "s": 31,
          "text": "שכלתה מדת הצמצום וההסתר דשם אלקים ונמשך התגלות שם הוי'43,"
        },
        {
          "s": 32,
          "text": "אבל בכדי לעורר מבחי' שלמעלה משם הוי',"
        },
        {
          "s": 33,
          "text": "הנה זה נעשה ע\"י תשובה כפשוטה,"
        },
        {
          "s": 34,
          "text": "ובפרט ע\"י תשובה כזו שזדונות נעשו לו כזכיות,"
        },
        {
          "s": 35,
          "text": "כי ע\"י בירור והפיכת הזדונות נעשה יתרון האור."
        },
        {
          "s": 36,
          "text": "ובמכ\"ש ממה דאיתא בזהר44"
        },
        {
          "s": 37,
          "text": "שענין מ\"ת נעשה דוקא ע\"י הודאת יתרו עתה ידעתי כי גדול הוי' מכל האלקים45,"
        },
        {
          "s": 38,
          "text": "אף שבמ\"ת נאמר אנכי"
        },
        {
          "s": 39,
          "text": "(רק)"
        },
        {
          "s": 40,
          "text": "פעם אחת,"
        },
        {
          "s": 41,
          "text": "עאכו\"כ ענין אנכי אנכי ב' פעמים,"
        },
        {
          "s": 42,
          "text": "שהמשכתו היא ע\"י בירור והפיכת החושך דוקא."
        },
        {
          "s": 43,
          "text": "וע\"ד המבואר בתניא46"
        },
        {
          "s": 44,
          "text": "שתכלית השלימות שיהי' בימות המשיח,"
        },
        {
          "s": 45,
          "text": "דירה לו ית' בתחתונים,"
        },
        {
          "s": 46,
          "text": "תלוי"
        },
        {
          "s": 47,
          "text": "(בעיקר)"
        },
        {
          "s": 48,
          "text": "במעשינו ועבודתינו במשך זמן הגלות דוקא]."
        },
        {
          "s": 49,
          "text": "ולאחרי ההתעוררות שלמעלה מהוי'"
        },
        {
          "s": 50,
          "text": "(ע\"י התשובה)"
        },
        {
          "s": 51,
          "text": "צריך להמשיך47"
        },
        {
          "s": 52,
          "text": "מלמעלה למטה בבחי' הוי' לשון מהוה,"
        },
        {
          "s": 53,
          "text": "ועד לבחי' הוי' כמו שהוא מתלבש בשם אלקים,"
        },
        {
          "s": 54,
          "text": "ענין הא' בהוי' הוא האלקים."
        },
        {
          "s": 55,
          "text": "וזהו מה שבתשובה נאמר ב' פעמים הוי' הוא האלקים,"
        },
        {
          "s": 56,
          "text": "שבתחלה הוא ענין העלי' מלמטה למעלה עד שלגבי' הוי' כאלקים יחשב"
        },
        {
          "s": 57,
          "text": "(פירוש הב' בהוי' הוא האלקים),"
        },
        {
          "s": 58,
          "text": "ואח\"כ ההמשכה מלמעלה למטה בהוי' לשון מהוה,"
        },
        {
          "s": 59,
          "text": "וכמו שמתלבש בשם אלקים"
        },
        {
          "s": 60,
          "text": "(פירוש הא' בהוי' הוא האלקים)"
        },
        {
          "s": 61,
          "text": "שמזה נעשה ההתהוות בפועל,"
        },
        {
          "s": 62,
          "text": "בראשית ברא אלקים את השמים ואת הארץ26,"
        },
        {
          "s": 63,
          "text": "ולא רק ההמשכה בע\"ס"
        },
        {
          "s": 64,
          "text": "(כפירוש הזהר48"
        },
        {
          "s": 65,
          "text": "שבראשית גו' קאי על הע\"ס),"
        },
        {
          "s": 66,
          "text": "אלא גם בהשמים והארץ וכל צבאיהם כפשוטם."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "וזהו ג\"כ ב' הענינים49"
        },
        {
          "s": 2,
          "text": "שבתקיעת שופר"
        },
        {
          "s": 3,
          "text": "(שרומז לענין התשובה50),"
        },
        {
          "s": 4,
          "text": "מה שקול השופר הוא קלא פנימאה"
        },
        {
          "s": 5,
          "text": "(בחי' פנימיות הלב)"
        },
        {
          "s": 6,
          "text": "וביחד עם זה צריך לתקוע בשופר גשמי דוקא,"
        },
        {
          "s": 7,
          "text": "כי בראש השנה חוזרים כל הדברים לקדמותם,"
        },
        {
          "s": 8,
          "text": "וע\"י השופר מעוררים המשכה חדשה מהעצמות."
        },
        {
          "s": 9,
          "text": "ששופר הוא בחינת בינה שהיא למעלה מהשתלשלות,"
        },
        {
          "s": 10,
          "text": "בחינת רצון שלמעלה גם מבחינת בינה,"
        },
        {
          "s": 11,
          "text": "ולמעלה יותר המשכה חדשה מפנימיות ועצמות ב\"ה,"
        },
        {
          "s": 12,
          "text": "ומשם נמשך בבחי' פנימיות הרצון,"
        },
        {
          "s": 13,
          "text": "בפנימיות בינה וכו' עד בבחי' פנימיות העולמות,"
        },
        {
          "s": 14,
          "text": "ומזה נמשך אח\"כ גם בחיצוניות העולמות,"
        },
        {
          "s": 15,
          "text": "כמבואר בסידור51"
        },
        {
          "s": 16,
          "text": "בד\"ה להבין ענין תק\"ש ע\"פ כוונת הבעש\"ט ז\"ל."
        },
        {
          "s": 17,
          "text": "ולכן יש בשופר ב' ענינים הנ\"ל,"
        },
        {
          "s": 18,
          "text": "ע\"י קלא פנימאה שבשופר,"
        },
        {
          "s": 19,
          "text": "בחי' פנימיות הלב,"
        },
        {
          "s": 20,
          "text": "מעוררים בעצמות,"
        },
        {
          "s": 21,
          "text": "וע\"י התקיעה בשופר גשמי,"
        },
        {
          "s": 22,
          "text": "ובשופר של בהמה דוקא,"
        },
        {
          "s": 23,
          "text": "ויתירה מזו שקרן השופר צריך להיות תלוש"
        },
        {
          "s": 24,
          "text": "(ולא מחובר להבהמה),"
        },
        {
          "s": 25,
          "text": "בחי' דומם,"
        },
        {
          "s": 26,
          "text": "עי\"ז ממשיכים למטה בעשי' עד לבחי' דומם."
        },
        {
          "s": 27,
          "text": "וכמו שאומרים בתפלת ראש השנה וידע כל פעול כי אתה פעלתו,"
        },
        {
          "s": 28,
          "text": "שגם בעשי'"
        },
        {
          "s": 29,
          "text": "(כדאיתא בכתבי האריז\"ל52"
        },
        {
          "s": 30,
          "text": "שכל פעול קאי על עולם העשי'),"
        },
        {
          "s": 31,
          "text": "וגם הדומם שבעשי',"
        },
        {
          "s": 32,
          "text": "ידע כי אתה פעלתו."
        }
      ]
    }
  ]
}