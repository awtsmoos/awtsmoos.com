{
  "globalIndex": 920,
  "owner": 20,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919223_theRebbe_96__p005",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919223_theRebbe_96__p005",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919223_theRebbe_96",
  "title": "מאמר תפלה למשה תשכ\"ט",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ויש להוסיף ביאור בזה,"
        },
        {
          "s": 2,
          "text": "ע\"פ מ\"ש בהמאמר71"
        },
        {
          "s": 3,
          "text": "דשני הענינים דסובב וממלא הם שני השמות דהוי' ואלקים."
        },
        {
          "s": 4,
          "text": "וכמבואר בכ\"מ72"
        },
        {
          "s": 5,
          "text": "דשם אלקים הוא לא רק המגן ונרתק שמעלים ומסתיר על האור דשם הוי'73,"
        },
        {
          "s": 6,
          "text": "אלא שגם האור דשם הוי' כמו שנמשך ומתצמצם ע\"י שם אלקים להיות מקור לנבראים,"
        },
        {
          "s": 7,
          "text": "שבכללות הוא אור הממלא,"
        },
        {
          "s": 8,
          "text": "נקרא אלקים."
        },
        {
          "s": 9,
          "text": "וע\"פ מ\"ש בתניא74"
        },
        {
          "s": 10,
          "text": "שהתהוות העולם היא משם הוי'"
        },
        {
          "s": 11,
          "text": "(הוי' לשון מהווה75),"
        },
        {
          "s": 12,
          "text": "אלא שבאם ההתהוות היתה משם הוי' עצמו הי' העולם בטל במציאות,"
        },
        {
          "s": 13,
          "text": "ולכן ההתהוות בפועל היתה ע\"י שם אלקים,"
        },
        {
          "s": 14,
          "text": "יש לומר,"
        },
        {
          "s": 15,
          "text": "שעד\"ז הוא גם בהענין דסובב וממלא,"
        },
        {
          "s": 16,
          "text": "שעיקר חיות העולם הוא מאור הסובב"
        },
        {
          "s": 17,
          "text": "(הוי'),"
        },
        {
          "s": 18,
          "text": "אלא שבכדי שהעולם יהי' מוגבל,"
        },
        {
          "s": 19,
          "text": "המשכת החיות בעולם היא ע\"י ממלא"
        },
        {
          "s": 20,
          "text": "(אלקים)."
        },
        {
          "s": 21,
          "text": "ושני ענינים בזה."
        },
        {
          "s": 22,
          "text": "שעצם חיות העולם הוא מסובב,"
        },
        {
          "s": 23,
          "text": "אלא שבאם הי' נמשך בו החיות מהסובב עצמו לא הי' העולם מוגבל"
        },
        {
          "s": 24,
          "text": "(כ\"כ)"
        },
        {
          "s": 25,
          "text": "וכל הנבראים היו בשוה"
        },
        {
          "s": 26,
          "text": "[וע\"ד המבואר בתניא76,"
        },
        {
          "s": 27,
          "text": "דבאם התהוות העולם היתה משם הוי' עצמו לא הי' בו ההתחלקות דזמן ומקום],"
        },
        {
          "s": 28,
          "text": "וע\"י שהחיות"
        },
        {
          "s": 29,
          "text": "(שמהסובב)"
        },
        {
          "s": 30,
          "text": "נמשך ע\"י הממלא"
        },
        {
          "s": 31,
          "text": "(שמתלבש בכל נברא לפי ערכו),"
        },
        {
          "s": 32,
          "text": "נעשה בהם התחלקות."
        },
        {
          "s": 33,
          "text": "ועוד ענין בזה,"
        },
        {
          "s": 34,
          "text": "שגם החיות דעולם"
        },
        {
          "s": 35,
          "text": "(שבהגבלה ובהתחלקות)"
        },
        {
          "s": 36,
          "text": "שנמשך מאור הממלא הוא"
        },
        {
          "s": 37,
          "text": "(לא מצד עצמו,"
        },
        {
          "s": 38,
          "text": "אלא)"
        },
        {
          "s": 39,
          "text": "מצד הסובב."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "והענין הוא,"
        },
        {
          "s": 1,
          "text": "דמבואר בהמאמר"
        },
        {
          "s": 2,
          "text": "(הובא לעיל סעיף ד),"
        },
        {
          "s": 3,
          "text": "דממלא הוא דוגמת חיות הנפש המתפשט בהגוף וסובב הוא דוגמת חיות הנפש עצמה,"
        },
        {
          "s": 4,
          "text": "חי בעצם."
        },
        {
          "s": 5,
          "text": "וע\"פ המבואר במק\"א77"
        },
        {
          "s": 6,
          "text": "דזה שהחיות המתפשט מהנפש מחי' את הגוף הוא לפי שהוא דבוק בהנפש עצמה שהוא חי בעצם"
        },
        {
          "s": 7,
          "text": "[כי הדרגא דהתפשטות החיות"
        },
        {
          "s": 8,
          "text": "(מצד עצמו)"
        },
        {
          "s": 9,
          "text": "אין בכחה להחיות דבר,"
        },
        {
          "s": 10,
          "text": "וזה שהחיות המתפשט מהנפש מחי' את הגוף הוא לפי שהוא דבוק בהנפש שהיא חי בעצם],"
        },
        {
          "s": 11,
          "text": "יש לומר,"
        },
        {
          "s": 12,
          "text": "דכמו\"כ הוא בהענין דממלא וסובב,"
        },
        {
          "s": 13,
          "text": "דהכח שבאור הממלא"
        },
        {
          "s": 14,
          "text": "(התפשטות החיות)"
        },
        {
          "s": 15,
          "text": "להחיות את הנבראים הוא"
        },
        {
          "s": 16,
          "text": "(לא מצד עצמו,"
        },
        {
          "s": 17,
          "text": "אלא)"
        },
        {
          "s": 18,
          "text": "מפני שהוא דבוק בהסובב,"
        },
        {
          "s": 19,
          "text": "חי בעצם."
        },
        {
          "s": 20,
          "text": "[ועפ\"ז יש לבאר מ\"ש בהמאמר"
        },
        {
          "s": 21,
          "text": "(הובא לעיל סעיף ד)"
        },
        {
          "s": 22,
          "text": "דבחינת הסובב נק' חיי החיים או חַי עולמים"
        },
        {
          "s": 23,
          "text": "(חַי בפתח),"
        },
        {
          "s": 24,
          "text": "דיש לומר,"
        },
        {
          "s": 25,
          "text": "דשני השמות חיי החיים וחי עולמים מורים על שני ענינים."
        },
        {
          "s": 26,
          "text": "דזה שנק' חיי החיים הוא לפי שממנו נמשך החיות דממלא,"
        },
        {
          "s": 27,
          "text": "וזה שנק' חי עולמים הוא לפי שממנו נמשך הכח בהחיות דממלא להחיות את העולמות]."
        },
        {
          "s": 28,
          "text": "ויש להוסיף,"
        },
        {
          "s": 29,
          "text": "דזה שבהחיות המתפשט להחיות את הגוף מתגלה הענין דחי בעצם"
        },
        {
          "s": 30,
          "text": "(בזה שביכלתו להחיות את הגוף),"
        },
        {
          "s": 31,
          "text": "אף שעצם הוא למעלה מהתפשטות78,"
        },
        {
          "s": 32,
          "text": "הוא,"
        },
        {
          "s": 33,
          "text": "לפי שהענין דחי בעצם הוא"
        },
        {
          "s": 34,
          "text": "(גם)"
        },
        {
          "s": 35,
          "text": "העצם של החיות המתפשט79."
        },
        {
          "s": 36,
          "text": "[ועפ\"ז י\"ל הכוונה בזה שהסובב נק' חיי החיים,"
        },
        {
          "s": 37,
          "text": "דהחיות"
        },
        {
          "s": 38,
          "text": "(המהות80"
        },
        {
          "s": 39,
          "text": "והעצם)"
        },
        {
          "s": 40,
          "text": "של החיים"
        },
        {
          "s": 41,
          "text": "(ממלא)"
        },
        {
          "s": 42,
          "text": "הוא הסובב]."
        },
        {
          "s": 43,
          "text": "ויש לומר,"
        },
        {
          "s": 44,
          "text": "דע\"י שני הענינים שבהחיות המלובש בהעולם – שבגילוי הוא חיות מוגבל,"
        },
        {
          "s": 45,
          "text": "ושבפנימיות הוא בלתי מוגבל"
        },
        {
          "s": 46,
          "text": "(שלכן ביכלתו להוות את הנבראים,"
        },
        {
          "s": 47,
          "text": "כנ\"ל)"
        },
        {
          "s": 48,
          "text": "– ישנם דוגמת שני ענינים אלה בהעולם."
        },
        {
          "s": 49,
          "text": "דבחיצוניות,"
        },
        {
          "s": 50,
          "text": "החיות שהעולם צריך אליו הוא רק חיות מצומצם ומועט"
        },
        {
          "s": 51,
          "text": "[וגילוי הסובב הוא בכלל עשירות]."
        },
        {
          "s": 52,
          "text": "ובפנימיות העולם,"
        },
        {
          "s": 53,
          "text": "נרגש הפנימיות של החיות שבו,"
        },
        {
          "s": 54,
          "text": "דזה שיש בו הכח להחיות הוא לפי שהוא דבוק בהדרגא דחי בעצם."
        },
        {
          "s": 55,
          "text": "וע\"י הדרגא דבכל נפשך דהנשמות מתגלה הפנימיות דהעולם."
        },
        {
          "s": 56,
          "text": "ועי\"ז,"
        },
        {
          "s": 57,
          "text": "גם העולם חסר הגילוי דסובב,"
        },
        {
          "s": 58,
          "text": "וע\"י גילוי הסובב נתמלא החסרון דהעולם."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ועד\"ז הוא בענין העשירות,"
        },
        {
          "s": 2,
          "text": "גילוי עצמות אוא\"ס שלמעלה מסובב,"
        },
        {
          "s": 3,
          "text": "שע\"י גילוי ענין זה בנש\"י,"
        },
        {
          "s": 4,
          "text": "יהי' לע\"ל מעין גילוי זה גם בעולם81."
        },
        {
          "s": 5,
          "text": "ועפ\"ז יש לבאר מ\"ש בהמאמר82"
        },
        {
          "s": 6,
          "text": "בביאור מאמר המדרש שתפלת משה היתה לא בשביל עצמו אלא בשביל ישראל,"
        },
        {
          "s": 7,
          "text": "שכנסת ישראל היא בחינת מלכות,"
        },
        {
          "s": 8,
          "text": "ובקשת משה"
        },
        {
          "s": 9,
          "text": "(תפלת עשיר)"
        },
        {
          "s": 10,
          "text": "בשביל כנס\"י היתה שיומשך במלכות גילוי עצמות אוא\"ס"
        },
        {
          "s": 11,
          "text": "(עשירות)"
        },
        {
          "s": 12,
          "text": "[ועפ\"ז מבאר שם מ\"ש במדרש דבקשת משה עבור ישראל היא ע\"ד הבקשה מדינה פלונית כו' גזור שתיבנה,"
        },
        {
          "s": 13,
          "text": "דמדינה הוא מלכות והבקשה גזור שתיבנה היא שיומשך גילוי עצמות אוא\"ס במלכות שעי\"ז תיבנה בבחינת בנין עדי עד]."
        },
        {
          "s": 14,
          "text": "וצריך ביאור,"
        },
        {
          "s": 15,
          "text": "דבקשת משה בשביל ישראל היתה בשביל ישראל כפשוטם כמבואר במדרש,"
        },
        {
          "s": 16,
          "text": "ובהמאמר מבאר שבקשת משה בשביל כנס\"י היא בשביל המלכות."
        },
        {
          "s": 17,
          "text": "ויש לומר,"
        },
        {
          "s": 18,
          "text": "דע\"י המשכת גילוי עצמות אוא\"ס בישראל,"
        },
        {
          "s": 19,
          "text": "עי\"ז יהי' גילוי זה במלכות,"
        },
        {
          "s": 20,
          "text": "השורש דעולם,"
        },
        {
          "s": 21,
          "text": "ועי\"ז – בהעולם."
        },
        {
          "s": 22,
          "text": "ולהוסיף,"
        },
        {
          "s": 23,
          "text": "דכמו שנת\"ל"
        },
        {
          "s": 24,
          "text": "(סעיף ז)"
        },
        {
          "s": 25,
          "text": "בענין גילוי הסובב שנמשך בעולם ע\"י ישראל,"
        },
        {
          "s": 26,
          "text": "שזהו ע\"י שמגלים הפנימיות דהחיות של העולם,"
        },
        {
          "s": 27,
          "text": "עד\"ז הוא בנוגע להגילוי דאוא\"ס שלמעלה מסובב שנמשך ע\"י ישראל בעולם,"
        },
        {
          "s": 28,
          "text": "שזהו ע\"י שמגלים פנימיות ושורש המלכות."
        },
        {
          "s": 29,
          "text": "וכמבואר בהמאמר83"
        },
        {
          "s": 30,
          "text": "בפירוש מדינה פלונית היא שלך,"
        },
        {
          "s": 31,
          "text": "דשורש המלכות הוא בהעצמות."
        }
      ]
    }
  ]
}