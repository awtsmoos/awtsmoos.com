{
  "globalIndex": 1028,
  "owner": 28,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919866_theRebbe_58__p001",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919866_theRebbe_58__p001",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919866_theRebbe_58",
  "title": "מאמר ויענך וירעיבך ויאכילך תשכ\"ג",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ עקב,"
        },
        {
          "s": 2,
          "text": "כ\"ף מנחם-אב ה'תשכ\"ג*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "ויענך וירעיבך ויאכילך את המן גו'1,"
        },
        {
          "s": 1,
          "text": "ומדייק אדמו\"ר"
        },
        {
          "s": 2,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 3,
          "text": "נ\"ע במאמרו ד\"ה זה2,"
        },
        {
          "s": 4,
          "text": "דבכ\"מ בתורה מדבר במעלת המן,"
        },
        {
          "s": 5,
          "text": "וכאן אומר ויענך וירעיבך גו' שהוא לכאורה היפך המעלה."
        },
        {
          "s": 6,
          "text": "גם צריך להבין דאיתא בגמרא3"
        },
        {
          "s": 7,
          "text": "משה תיקן לישראל ברכת הזן בשעה שירד להם מן,"
        },
        {
          "s": 8,
          "text": "יהושע תיקן להם ברכת הארץ כיון שנכנסו לארץ."
        },
        {
          "s": 9,
          "text": "וכתב הרשב\"א4"
        },
        {
          "s": 10,
          "text": "דפירוש משה תיקן כו' יהושע תיקן כו'5"
        },
        {
          "s": 11,
          "text": "הוא שתיקנו להם מטבע הברכות,"
        },
        {
          "s": 12,
          "text": "דהברכות עצמם הם מן התורה"
        },
        {
          "s": 13,
          "text": "[כדאיתא בגמרא3,"
        },
        {
          "s": 14,
          "text": "ואכלת ושבעת וברכת6"
        },
        {
          "s": 15,
          "text": "זו ברכת הזן כו' על הארץ זו ברכת הארץ]."
        },
        {
          "s": 16,
          "text": "ואיתא בלקו\"ת7,"
        },
        {
          "s": 17,
          "text": "דהטעם על שגם בברכת הארץ מזכירין ועל אכילת מזון ובחתימת הברכה חותמין על הארץ ועל המזון"
        },
        {
          "s": 18,
          "text": "(אע\"פ שבירכו כבר ברכת הזן),"
        },
        {
          "s": 19,
          "text": "הוא,"
        },
        {
          "s": 20,
          "text": "כי הנוסח והמטבע דברכת הזן הוא על המן,"
        },
        {
          "s": 21,
          "text": "לחם מן השמים,"
        },
        {
          "s": 22,
          "text": "ומזון שבברכת הארץ הוא לחם מן הארץ8."
        },
        {
          "s": 23,
          "text": "וצריך ביאור,"
        },
        {
          "s": 24,
          "text": "דברכת הזן הוא על אכילה המשבעת"
        },
        {
          "s": 25,
          "text": "(ואכלת ושבעת),"
        },
        {
          "s": 26,
          "text": "דאכילה המשבעת היא"
        },
        {
          "s": 27,
          "text": "(בעיקר)"
        },
        {
          "s": 28,
          "text": "בלחם מן הארץ,"
        },
        {
          "s": 29,
          "text": "ואעפ\"כ,"
        },
        {
          "s": 30,
          "text": "הברכה על המזון דלחם מן הארץ היא בברכת הארץ"
        },
        {
          "s": 31,
          "text": "(שלא נאמר בה ואכלת ושבעת9),"
        },
        {
          "s": 32,
          "text": "והנוסח דברכת הזן"
        },
        {
          "s": 33,
          "text": "(דכתיב בה ואכלת ושבעת)"
        },
        {
          "s": 34,
          "text": "הוא על המן דכתיב בי' ויענך וירעיבך10."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "גם צריך להבין מה שהעינוי דיום הכיפורים למדין11"
        },
        {
          "s": 1,
          "text": "מעינוי הנאמר גבי מן,"
        },
        {
          "s": 2,
          "text": "נאמר כאן עינוי"
        },
        {
          "s": 3,
          "text": "(ועניתם את נפשותיכם12)"
        },
        {
          "s": 4,
          "text": "ונאמר להלן עינוי"
        },
        {
          "s": 5,
          "text": "(ויענך וירעיבך)"
        },
        {
          "s": 6,
          "text": "מה להלן עינוי רעבון אף כאן עינוי רעבון."
        },
        {
          "s": 7,
          "text": "וצריך ביאור,"
        },
        {
          "s": 8,
          "text": "שעינוי רעבון דמן הוא שאכילת המן לא השביעה אותם ככל הדרוש"
        },
        {
          "s": 9,
          "text": "[כי אינו דומה מי שיש לו פת בסלו למי שאין לו פת בסלו11"
        },
        {
          "s": 10,
          "text": "(והמן הי' דבר13"
        },
        {
          "s": 11,
          "text": "יום ביומו14)"
        },
        {
          "s": 12,
          "text": "ואינו דומה מי שרואה ואוכל למי שאינו רואה ואוכל11"
        },
        {
          "s": 13,
          "text": "(ובהמן היו טועמים כל המינים ולא ראו אלא מן14)],"
        },
        {
          "s": 14,
          "text": "ומזה שמדמין עינוי רעבון דמן לעינוי רעבון דיוהכ\"פ,"
        },
        {
          "s": 15,
          "text": "משמע,"
        },
        {
          "s": 16,
          "text": "שעינוי רעבון דמן הוא"
        },
        {
          "s": 17,
          "text": "(לא שאכילת המן לא השביעה כאכילה ע\"ד הרגיל,"
        },
        {
          "s": 18,
          "text": "אלא)"
        },
        {
          "s": 19,
          "text": "כמו שלא אכל15."
        },
        {
          "s": 20,
          "text": "ולהעיר,"
        },
        {
          "s": 21,
          "text": "שעפ\"ז צריך להבין עוד יותר שהנוסח דברכת הזן הוא על המן."
        },
        {
          "s": 22,
          "text": "גם צריך להבין16,"
        },
        {
          "s": 23,
          "text": "דעכשיו"
        },
        {
          "s": 24,
          "text": "(לאחרי שנפסק המן),"
        },
        {
          "s": 25,
          "text": "כל הברכות דברכת המזון הם לכאורה על לחם מן הארץ,"
        },
        {
          "s": 26,
          "text": "ואעפ\"כ הנוסח דברכת הזן הוא הנוסח שתיקן משה על המן."
        }
      ]
    }
  ]
}