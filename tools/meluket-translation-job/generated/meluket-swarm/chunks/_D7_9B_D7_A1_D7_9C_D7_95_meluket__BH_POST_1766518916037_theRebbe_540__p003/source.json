{
  "globalIndex": 396,
  "owner": 46,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518916037_theRebbe_540__p003",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518916037_theRebbe_540__p003",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518916037_theRebbe_540",
  "title": "מאמר וישב יעקב תשכ\"ז",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה חטא עה\"ד פעל ירידה בכל סדר ההשתלשלות,"
        },
        {
          "s": 2,
          "text": "כשם שבאדם הראשון פעל החטא ירידה לא רק ברגליו בעשי',"
        },
        {
          "s": 3,
          "text": "שהרגיש טעם גשמי,"
        },
        {
          "s": 4,
          "text": "אלא גם בגופו שביצירה,"
        },
        {
          "s": 5,
          "text": "דעולם היצירה הו\"ע המדות,"
        },
        {
          "s": 6,
          "text": "דז\"א מקננא ביצירה38,"
        },
        {
          "s": 7,
          "text": "והיינו,"
        },
        {
          "s": 8,
          "text": "שהחטא פעל ירידה גם בהמדות שביצירה,"
        },
        {
          "s": 9,
          "text": "שהמדות כפי שהם לאחרי החטא אינם דומים להמדות כפי שהיו לפני החטא."
        },
        {
          "s": 10,
          "text": "וכשם שהירידה ברגליו שבעשי' היתה ע\"י הדעת וההרגש,"
        },
        {
          "s": 11,
          "text": "כמו\"כ גם הירידה במדות באה ע\"י ההרגש."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "וביאור הענין הוא,"
        },
        {
          "s": 1,
          "text": "דהנה התחלת המדות הו\"ע חסד,"
        },
        {
          "s": 2,
          "text": "ובחסד יש חסדים המכוסים וחסדים המגולים39."
        },
        {
          "s": 3,
          "text": "חסדים מגולים הו\"ע החסד כפי שבא בגילוי,"
        },
        {
          "s": 4,
          "text": "וחסדים המכוסים היינו כפי שהחסד הוא בהעלם מצד השכל."
        },
        {
          "s": 5,
          "text": "ואין הכוונה בחסדים המכוסים להמדות הכלולים בשכל,"
        },
        {
          "s": 6,
          "text": "כי,"
        },
        {
          "s": 7,
          "text": "בהיותם כלולים בשכל אינם מדות שבלב אלא מדות שבשכל,"
        },
        {
          "s": 8,
          "text": "ואז לא שייך לחלק בין חסדים המכוסים לחסדים המגולים,"
        },
        {
          "s": 9,
          "text": "וא\"כ,"
        },
        {
          "s": 10,
          "text": "הכוונה בחסדים המכוסים היא להמדות כפי שהם במקומם בלב,"
        },
        {
          "s": 11,
          "text": "אלא שהם בטלים מצד השכל שמאיר בלב."
        },
        {
          "s": 12,
          "text": "והענין בזה,"
        },
        {
          "s": 13,
          "text": "דהנה,"
        },
        {
          "s": 14,
          "text": "עם היות שהמדות נמצאים מהשכל,"
        },
        {
          "s": 15,
          "text": "וכמ\"ש בתניא40"
        },
        {
          "s": 16,
          "text": "שחב\"ד נקרא אמות ומקור למדות,"
        },
        {
          "s": 17,
          "text": "שע\"י שמתבונן במה רבו מעשיך הוי'41"
        },
        {
          "s": 18,
          "text": "ומה גדלו מעשיך הוי'42"
        },
        {
          "s": 19,
          "text": "מתגלים המדות,"
        },
        {
          "s": 20,
          "text": "אהבת הוי' ופחדו ויראתו ולפארו כו',"
        },
        {
          "s": 21,
          "text": "וכמ\"ש הרמב\"ם43"
        },
        {
          "s": 22,
          "text": "והיאך היא הדרך לאהבתו ויראתו בשעה שיתבונן כו',"
        },
        {
          "s": 23,
          "text": "שע\"י ההתבוננות המתאימה לאהבה נולד מדת האהבה,"
        },
        {
          "s": 24,
          "text": "וע\"י ההתבוננות המתאימה ליראה נולד מדת היראה,"
        },
        {
          "s": 25,
          "text": "מ\"מ,"
        },
        {
          "s": 26,
          "text": "בשעה שמאיר תוקף השכל,"
        },
        {
          "s": 27,
          "text": "אי אפשר להיות מציאות המדות בהתגלות,"
        },
        {
          "s": 28,
          "text": "ורק בשעה שמסתלקים המוחין,"
        },
        {
          "s": 29,
          "text": "שאינו מאיר כלום,"
        },
        {
          "s": 30,
          "text": "או שהשכל מאיר בדרך מקיף עכ\"פ,"
        },
        {
          "s": 31,
          "text": "אזי יכול להיות מציאות המדה בהתגלות."
        },
        {
          "s": 32,
          "text": "אמנם,"
        },
        {
          "s": 33,
          "text": "יש דרגה במדות שאפילו בשעה שהשכל הוא בגלוי,"
        },
        {
          "s": 34,
          "text": "ופועל ביטול בהמדות,"
        },
        {
          "s": 35,
          "text": "מ\"מ ישנם המדות במציאותם בלב."
        },
        {
          "s": 36,
          "text": "וענין זה הוא כאשר מתבונן בעומק ופנימיות השכל ומבין את השכל שלא ע\"י כלי ההבנה והשגה,"
        },
        {
          "s": 37,
          "text": "שהם כלי המוח,"
        },
        {
          "s": 38,
          "text": "אזי יכול אור השכל להאיר גם בלב."
        },
        {
          "s": 39,
          "text": "והיינו,"
        },
        {
          "s": 40,
          "text": "שכאשר ההתבוננות היא ע\"י כלי המוח בלבד,"
        },
        {
          "s": 41,
          "text": "הרי זה מאיר רק במוח ולא בלב,"
        },
        {
          "s": 42,
          "text": "משא\"כ כאשר ההתבוננות היא בפנימיות ובעומק השכל למעלה מכלי המוח,"
        },
        {
          "s": 43,
          "text": "אזי אין שם הגבלות המוח,"
        },
        {
          "s": 44,
          "text": "ויכול להאיר גם בלב"
        },
        {
          "s": 45,
          "text": "(ואדרבה,"
        },
        {
          "s": 46,
          "text": "עיקר מציאותן הוא בלב),"
        },
        {
          "s": 47,
          "text": "ובשעה שהשכל מאיר בלב הרי זה פועל ביטול בהמדות,"
        },
        {
          "s": 48,
          "text": "והיינו שהעיקר הוא השכל,"
        },
        {
          "s": 49,
          "text": "ואדרבה,"
        },
        {
          "s": 50,
          "text": "פנימיות השכל,"
        },
        {
          "s": 51,
          "text": "ומ\"מ יש מציאות של מדה בלב,"
        },
        {
          "s": 52,
          "text": "אלא שהמדה אינה מורגשת,"
        },
        {
          "s": 53,
          "text": "להיותה בטלה אל השכל שמאיר בלב,"
        },
        {
          "s": 54,
          "text": "והו\"ע פנימיות המדות."
        },
        {
          "s": 55,
          "text": "והנה,"
        },
        {
          "s": 56,
          "text": "מצד פנימיות המדות שבהם מאירים פנימיות המוחין,"
        },
        {
          "s": 57,
          "text": "לא יכול להיות יניקה לחיצונים,"
        },
        {
          "s": 58,
          "text": "כיון שהמדות אינם ניכרים ונרגשים,"
        },
        {
          "s": 59,
          "text": "משא\"כ מצד חיצוניות המוחין שמהם נעשים חיצוניות המדות,"
        },
        {
          "s": 60,
          "text": "יכול להיות יניקה לחיצונים."
        },
        {
          "s": 61,
          "text": "וזהו ענין חטא עה\"ד,"
        },
        {
          "s": 62,
          "text": "שנעשה ענין ההרגשה בהמדות שהם ניכרים ונרגשים,"
        },
        {
          "s": 63,
          "text": "והו\"ע חסדים המגולים."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "והענין בזה בעבודת הוי'44,"
        },
        {
          "s": 1,
          "text": "דהנה,"
        },
        {
          "s": 2,
          "text": "ישנו הענין דקרבת אלקים טוב,"
        },
        {
          "s": 3,
          "text": "וישנו הענין דקרבת אלקים לי טוב45."
        },
        {
          "s": 4,
          "text": "קרבת אלקים טוב היינו שאלקות הוא טוב מצד עצמו,"
        },
        {
          "s": 5,
          "text": "ומזה אין יניקה ללעו\"ז."
        },
        {
          "s": 6,
          "text": "והו\"ע עץ החיים,"
        },
        {
          "s": 7,
          "text": "שעז\"נ46"
        },
        {
          "s": 8,
          "text": "ואכל וחי לעולם,"
        },
        {
          "s": 9,
          "text": "שאין מזה יניקה ללעו\"ז."
        },
        {
          "s": 10,
          "text": "משא\"כ קרבת אלקים לי טוב הוא באופן שנעשה מורגש,"
        },
        {
          "s": 11,
          "text": "שמערב בזה מציאותו,"
        },
        {
          "s": 12,
          "text": "עד שיכול להיות שהעיקר הוא מה שמרגיש את עצמו,"
        },
        {
          "s": 13,
          "text": "והאלקות הוא רק בדרך טפל,"
        },
        {
          "s": 14,
          "text": "ולכן אם אינו מרגיש את עצמו,"
        },
        {
          "s": 15,
          "text": "היינו שאינו מרגיש איך שאלקות לי טוב,"
        },
        {
          "s": 16,
          "text": "אזי יכול להיות שתתבטל האהבה,"
        },
        {
          "s": 17,
          "text": "וזהו\"ע חסדים המגולים,"
        },
        {
          "s": 18,
          "text": "שהוא בבחי' הרגש עצמו."
        },
        {
          "s": 19,
          "text": "ומזה יכול להיות יניקה ללעו\"ז,"
        },
        {
          "s": 20,
          "text": "והיינו,"
        },
        {
          "s": 21,
          "text": "דעם היות שגם ההרגש דקרבת אלקים לי טוב הו\"ע של קדושה,"
        },
        {
          "s": 22,
          "text": "מ\"מ,"
        },
        {
          "s": 23,
          "text": "יכול להיות מזה יניקה ללעו\"ז,"
        },
        {
          "s": 24,
          "text": "כידוע שמחסד דאברהם יכול להיות אהבה דפלשתים"
        },
        {
          "s": 25,
          "text": "(כמבואר בענין קליפת פלשתים47)."
        },
        {
          "s": 26,
          "text": "ואע\"פ שגם בבחי' חיצוניות המוחין"
        },
        {
          "s": 27,
          "text": "(שמהם נמשכים חיצוניות המדות,"
        },
        {
          "s": 28,
          "text": "חסדים המגולים)"
        },
        {
          "s": 29,
          "text": "יכולה להיות שמירה מהיניקה ללעו\"ז,"
        },
        {
          "s": 30,
          "text": "עי\"ז שהשכל מאיר בבחי' מקיף,"
        },
        {
          "s": 31,
          "text": "מ\"מ,"
        },
        {
          "s": 32,
          "text": "הרי יש צורך בזהירות ועצה כו'"
        },
        {
          "s": 33,
          "text": "(אַ באַוואָרעניש),"
        },
        {
          "s": 34,
          "text": "משא\"כ בפנימיות המוחין,"
        },
        {
          "s": 35,
          "text": "ששם אין צריך על זה זהירות כלל."
        }
      ]
    }
  ]
}