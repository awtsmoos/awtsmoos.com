{
  "globalIndex": 615,
  "owner": 15,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917334_theRebbe_880__p004",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917334_theRebbe_880__p004",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917334_theRebbe_880",
  "title": "מאמר ואתה תצוה תשמ\"א",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש לבאר מ\"ש בהמאמר דזה שמשה הוא רעיא מהימנא"
        },
        {
          "s": 1,
          "text": "(שהוא זן ומפרנס את האמונה)"
        },
        {
          "s": 2,
          "text": "הוא גם בנוגע לרועי ישראל שבכל דור"
        },
        {
          "s": 3,
          "text": "(אתפשטותא דמשה שבכל דרא)"
        },
        {
          "s": 4,
          "text": "שהם מחזקים את האמונה דישראל שיעמדו במס\"נ בקיום התומ\"צ."
        },
        {
          "s": 5,
          "text": "דלכאורה,"
        },
        {
          "s": 6,
          "text": "זה שמשה זן ומפרנס את האמונה הוא"
        },
        {
          "s": 7,
          "text": "(כמבואר בכ\"מ34"
        },
        {
          "s": 8,
          "text": "וגם במאמר זה עצמו35)"
        },
        {
          "s": 9,
          "text": "ע\"י שמשפיע לישראל דעת באלקות שעי\"ז באה האמונה בפנימיות,"
        },
        {
          "s": 10,
          "text": "וזה שרועי ישראל שבכל דור מחזקים האמונה"
        },
        {
          "s": 11,
          "text": "(המבואר במאמר זה36)"
        },
        {
          "s": 12,
          "text": "הוא שהאמונה דישראל תהי' באופן דמס\"נ."
        },
        {
          "s": 13,
          "text": "וע\"פ הנ\"ל יש לומר,"
        },
        {
          "s": 14,
          "text": "שעיקר הענין דרעיא מהימנא הוא זה שהוא זן ומפרנס את האמונה עצמה,"
        },
        {
          "s": 15,
          "text": "שהאמונה תהי' לא רק כמו שהיא מצד הגילויים"
        },
        {
          "s": 16,
          "text": "(מצד זה שהנשמה שלמעלה רואה אלקות)"
        },
        {
          "s": 17,
          "text": "אלא מצד עצם הנשמה."
        },
        {
          "s": 18,
          "text": "וזה שמשה ממשיך את האמונה בפנימיות"
        },
        {
          "s": 19,
          "text": "(בדעת והשגה)"
        },
        {
          "s": 20,
          "text": "הוא תוצאה מזה שהוא זן ומפרנס את האמונה עצמה"
        },
        {
          "s": 21,
          "text": "(המשכת וגילוי האמונה כמו שהיא מצד עצם הנשמה)."
        },
        {
          "s": 22,
          "text": "וכנ\"ל"
        },
        {
          "s": 23,
          "text": "(סעיף ה),"
        },
        {
          "s": 24,
          "text": "דהמשכת האמונה בפנימיות"
        },
        {
          "s": 25,
          "text": "(בדעת)"
        },
        {
          "s": 26,
          "text": "הוא ע\"י גילוי ההתקשרות עצמית דעצם הנשמה."
        },
        {
          "s": 27,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 28,
          "text": "דבזה שבהדורות שהוצרכו למס\"נ בפועל חיזקו רועי ישראל"
        },
        {
          "s": 29,
          "text": "(אתפשטותא דמשה)"
        },
        {
          "s": 30,
          "text": "את האמונה דישראל שתהי' במס\"נ,"
        },
        {
          "s": 31,
          "text": "נתגלה הענין דרעיא מהימנא"
        },
        {
          "s": 32,
          "text": "(בענין זה37)"
        },
        {
          "s": 33,
          "text": "עוד יותר מבמשה עצמו."
        },
        {
          "s": 34,
          "text": "כי המשכת וגילוי האמונה כמו שהיא מצד עצם הנשמה"
        },
        {
          "s": 35,
          "text": "[שע\"י משה ואתפשטותא דילי' שבכל דרא],"
        },
        {
          "s": 36,
          "text": "עיקר התגלותה הוא מס\"נ בפועל."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "והנה ידוע שהמס\"נ בפועל על תומ\"צ של כל ישראל היתה בפורים"
        },
        {
          "s": 2,
          "text": "(בזמן גזירת המן)."
        },
        {
          "s": 3,
          "text": "שהמס\"נ דחנוכה"
        },
        {
          "s": 4,
          "text": "(בזמן גזירת יון)"
        },
        {
          "s": 5,
          "text": "היתה"
        },
        {
          "s": 6,
          "text": "(בעיקר)"
        },
        {
          "s": 7,
          "text": "במתתיהו ובניו,"
        },
        {
          "s": 8,
          "text": "והמס\"נ בזמן גזירת המן היתה בכל ישראל."
        },
        {
          "s": 9,
          "text": "ועפ\"ז יש לבאר מה שמובא בהמאמר38"
        },
        {
          "s": 10,
          "text": "ממדרש16"
        },
        {
          "s": 11,
          "text": "שמרדכי הי' שקול בדורו כמשה בדורו,"
        },
        {
          "s": 12,
          "text": "דהגם שאתפשטותא דמשה הוא בכל דור מ\"מ איתא במדרש שמרדכי"
        },
        {
          "s": 13,
          "text": "(דוקא)"
        },
        {
          "s": 14,
          "text": "הי' שקול בדורו כמשה בדורו."
        },
        {
          "s": 15,
          "text": "ויש לומר,"
        },
        {
          "s": 16,
          "text": "שמהמעלות דמרדכי היהודי הוא שהוא הי' הרעיא מהימנא"
        },
        {
          "s": 17,
          "text": "(בגילוי)"
        },
        {
          "s": 18,
          "text": "של כל ישראל שבדורו."
        },
        {
          "s": 19,
          "text": "בדוגמת משה רעיא מהימנא שהמשיך דעת לכל ישראל שבדורו,"
        },
        {
          "s": 20,
          "text": "כמובן גם מזה שדורו של משה"
        },
        {
          "s": 21,
          "text": "(כל אנשי דורו)"
        },
        {
          "s": 22,
          "text": "נק' דור דעה39."
        },
        {
          "s": 23,
          "text": "[אלא שבמשה הי' גילוי ענין זה"
        },
        {
          "s": 24,
          "text": "(שהוא רעיא מהימנא דכל ישראל)"
        },
        {
          "s": 25,
          "text": "ע\"י שהמשיך דעת לכל אנשי דורו,"
        },
        {
          "s": 26,
          "text": "ובמרדכי הי' גילוי ענין זה ע\"י שגילה כח המס\"נ שבכל אנשי דורו]."
        },
        {
          "s": 27,
          "text": "ויש לומר,"
        },
        {
          "s": 28,
          "text": "דע\"י שמביא בהמאמר מ\"ש במדרש שמרדכי בדורו הי' שקול כמשה בדורו,"
        },
        {
          "s": 29,
          "text": "עי\"ז פסק בעל המאמר את הדין על עצמו40,"
        },
        {
          "s": 30,
          "text": "שהוא הרעיא מהימנא"
        },
        {
          "s": 31,
          "text": "(בגילוי)"
        },
        {
          "s": 32,
          "text": "של כל אנשי הדור."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יש לבאר קשר"
        },
        {
          "s": 2,
          "text": "(וסדר)"
        },
        {
          "s": 3,
          "text": "הענינים"
        },
        {
          "s": 4,
          "text": "(בהמאמר)"
        },
        {
          "s": 5,
          "text": "בביאור הפסוק ואתה תצוה גו',"
        },
        {
          "s": 6,
          "text": "שבתחלה מבאר את הפירוש דואתה תצוה את בני ישראל,"
        },
        {
          "s": 7,
          "text": "שמשה הוא מקשר ומחבר את בני ישראל"
        },
        {
          "s": 8,
          "text": "(עם אוא\"ס)"
        },
        {
          "s": 9,
          "text": "ע\"י שהוא זן ומפרנס את האמונה,"
        },
        {
          "s": 10,
          "text": "ולאח\"ז מבאר שגם רועי ישראל שבכל דור"
        },
        {
          "s": 11,
          "text": "(אתפשטותא דמשה)"
        },
        {
          "s": 12,
          "text": "מחזקים את האמונה דישראל וכמו מרדכי"
        },
        {
          "s": 13,
          "text": "(משה שבדורו)"
        },
        {
          "s": 14,
          "text": "שחיזק את אמונתם של ישראל לעמוד חזק בלימוד התורה וקיום המצוות,"
        },
        {
          "s": 15,
          "text": "ולאח\"ז מבאר הפירוש בכתית למאור"
        },
        {
          "s": 16,
          "text": "(שבפסוק ואתה תצוה שמדבר לכאורה במשה עצמו),"
        },
        {
          "s": 17,
          "text": "כי זה שמשה מגלה בחינת המאור דישראל"
        },
        {
          "s": 18,
          "text": "(עצם הנשמה),"
        },
        {
          "s": 19,
          "text": "הוא בעיקר ע\"י אתפשטותא דילי' שבזמן הגלות"
        },
        {
          "s": 20,
          "text": "(כתית)"
        },
        {
          "s": 21,
          "text": "שעוררו בישראל כח המס\"נ שלהם,"
        },
        {
          "s": 22,
          "text": "שעי\"ז הוא עיקר גילוי עצם הנשמה,"
        },
        {
          "s": 23,
          "text": "מאור."
        }
      ]
    }
  ]
}