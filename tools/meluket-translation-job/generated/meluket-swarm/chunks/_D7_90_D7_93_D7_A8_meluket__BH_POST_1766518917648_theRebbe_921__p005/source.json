  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917648_theRebbe_921__p005",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917648_theRebbe_921",
  "title": "מאמר החודש הזה לכם תשל\"ט",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ויהי רצון,"
        },
        {
          "s": 1,
          "text": "דהגם שנמצאים עדיין בחודש אדר,"
        },
        {
          "s": 2,
          "text": "שהגאולה דפורים היא באופן שאכתי עבדי אחשורוש אנן47"
        },
        {
          "s": 3,
          "text": "(ובדוגמת שבר\"ה בטלה עבודה מאבותינו,"
        },
        {
          "s": 4,
          "text": "שגם לאחרי זה היו עדיין בגלות מצרים),"
        },
        {
          "s": 5,
          "text": "אעפ\"כ,"
        },
        {
          "s": 6,
          "text": "כיון שנמצאים כבר בכ\"ה אדר,"
        },
        {
          "s": 7,
          "text": "התחלת הגילוי דניסן,"
        },
        {
          "s": 8,
          "text": "הרי ראוי ונכון וכו' שהגאולה תהי' בחודש אדר,"
        },
        {
          "s": 9,
          "text": "ובבוא חודש ניסן נהי' כבר המעמד ומצב דגאולה אמיתית"
        },
        {
          "s": 10,
          "text": "[וכפתגם הידוע של כ\"ק מו\"ח אדמו\"ר48"
        },
        {
          "s": 11,
          "text": "בזה שאומרים לשנה הבאה בירושלים,"
        },
        {
          "s": 12,
          "text": "דכמו\"כ הוא בנוגע להמארז\"ל בניסן עתידין ליגאל],"
        },
        {
          "s": 13,
          "text": "ונאכל שם מן הזבחים ומן הפסחים49."
        }
      ]
    }
  ]
}