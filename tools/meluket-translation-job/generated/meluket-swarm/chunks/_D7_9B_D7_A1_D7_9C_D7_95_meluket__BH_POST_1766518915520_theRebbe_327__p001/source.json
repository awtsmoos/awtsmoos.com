{
  "globalIndex": 303,
  "owner": 3,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915520_theRebbe_327__p001",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915520_theRebbe_327__p001",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915520_theRebbe_327",
  "title": "מאמר מרגלא בפומיה דרבא תש\"מ",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ וישלח,"
        },
        {
          "s": 2,
          "text": "ח\"י כסלו ה'תש\"מ*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "מרגלא בפומי' דרבא תכלית חכמה תשובה ומעשים טובים כו' שנאמר1"
        },
        {
          "s": 1,
          "text": "ראשית חכמה יראת הוי' שכל טוב לכל עושיהם,"
        },
        {
          "s": 2,
          "text": "ללומדיהם לא נאמר אלא לעושיהם2."
        },
        {
          "s": 3,
          "text": "ומביא כ\"ק מו\"ח אדמו\"ר במאמרו ד\"ה זה שאמר בש\"פ וישלח תרפ\"ט3"
        },
        {
          "s": 4,
          "text": "(נדפס בקונטרס דרושי חתונה תרפ\"ט4)"
        },
        {
          "s": 5,
          "text": "פירוש רש\"י,"
        },
        {
          "s": 6,
          "text": "דחכמה היא תורה,"
        },
        {
          "s": 7,
          "text": "ותכלית חכמה,"
        },
        {
          "s": 8,
          "text": "עיקרה של תורה,"
        },
        {
          "s": 9,
          "text": "הוא שיהא עמה תשובה ומעשים טובים."
        },
        {
          "s": 10,
          "text": "ומדייק בהמאמר,"
        },
        {
          "s": 11,
          "text": "דעיקרה של תורה הוא הבנה והשגה,"
        },
        {
          "s": 12,
          "text": "שיבין וישיג מה שלומד"
        },
        {
          "s": 13,
          "text": "[ובפרט בתורה שבע\"פ,"
        },
        {
          "s": 14,
          "text": "דכשאינו מבין מה שלומד אין זה נחשב לימוד כלל5],"
        },
        {
          "s": 15,
          "text": "ובמאמר רז\"ל זה אומר שעיקרה של תורה הוא תשובה ומעשים טובים."
        },
        {
          "s": 16,
          "text": "ויש לומר,"
        },
        {
          "s": 17,
          "text": "דהטעם שמביא בהמאמר פירוש רש\"י בתכלית חכמה,"
        },
        {
          "s": 18,
          "text": "הוא,"
        },
        {
          "s": 19,
          "text": "כי הפירוש דתכלית ברוב המקומות הוא תכלית הכוונה,"
        },
        {
          "s": 20,
          "text": "וכיו\"ב."
        },
        {
          "s": 21,
          "text": "ועפ\"ז,"
        },
        {
          "s": 22,
          "text": "פירוש תכלית חכמה תשובה ומעשים טובים הוא,"
        },
        {
          "s": 23,
          "text": "שתכלית הכוונה בלימוד התורה"
        },
        {
          "s": 24,
          "text": "(חכמה)"
        },
        {
          "s": 25,
          "text": "הוא שתביא לתשובה ומעשים טובים6."
        },
        {
          "s": 26,
          "text": "ולכן מביא בהמאמר פירוש רש\"י דתכלית חכמה הוא עיקרה של תורה7."
        },
        {
          "s": 27,
          "text": "דנוסף לזה שהכוונה דלימוד התורה היא שתביא לתשובה ומעשים טובים,"
        },
        {
          "s": 28,
          "text": "גם ענין התורה עצמה"
        },
        {
          "s": 29,
          "text": "[ואדרבה עיקר ענינה]"
        },
        {
          "s": 30,
          "text": "הוא תשובה ומעשים טובים."
        },
        {
          "s": 31,
          "text": "ולכן מדייק,"
        },
        {
          "s": 32,
          "text": "דחכמה"
        },
        {
          "s": 33,
          "text": "(תורה)"
        },
        {
          "s": 34,
          "text": "ותשובה ומעשים טובים הם לכאורה שני ענינים שונים."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ואולי יש להוסיף,"
        },
        {
          "s": 2,
          "text": "דחכמה"
        },
        {
          "s": 3,
          "text": "(תורה)"
        },
        {
          "s": 4,
          "text": "ותשובה ומעשים טובים,"
        },
        {
          "s": 5,
          "text": "נוסף לזה שהם ענינים שונים,"
        },
        {
          "s": 6,
          "text": "הם גם כמו הפכים."
        },
        {
          "s": 7,
          "text": "דבלימוד התורה מודגשת מציאותו של האדם העוסק בתורה,"
        },
        {
          "s": 8,
          "text": "דמצות לימוד התורה היא שיבין וישיג"
        },
        {
          "s": 9,
          "text": "(הענין שלומד)"
        },
        {
          "s": 10,
          "text": "בהשכל שלו."
        },
        {
          "s": 11,
          "text": "ועד שגם בנוגע לפסק דין צריך לפסוק כפי הבנתו דוקא."
        },
        {
          "s": 12,
          "text": "וכמו שארז\"ל8"
        },
        {
          "s": 13,
          "text": "קא מיפלגי במתיבתא דרקיעא כו' הקב\"ה אומר כו' וכולהו מתיבתא דרקיעא אמרי כו',"
        },
        {
          "s": 14,
          "text": "דהטעם על זה שמתיבתא דרקיעא פסקו הדין באופן אחר מהקב\"ה,"
        },
        {
          "s": 15,
          "text": "הוא,"
        },
        {
          "s": 16,
          "text": "כי ע\"פ כללי התורה צריכים הם לפסוק הדין כפי הבנתם."
        },
        {
          "s": 17,
          "text": "דענין זה הוא אפילו בלימוד התורה שבמתיבתא דרקיעא."
        },
        {
          "s": 18,
          "text": "ומכש\"כ בלימוד התורה דהאדם למטה,"
        },
        {
          "s": 19,
          "text": "דתורה לא בשמים היא9"
        },
        {
          "s": 20,
          "text": "וקוב\"ה קא חייך ואמר נצחוני בני נצחוני9."
        },
        {
          "s": 21,
          "text": "ובתשובה ומעשים טובים מודגש הביטול דהאדם."
        },
        {
          "s": 22,
          "text": "דענין התשובה הוא שהאדם יוצא ומתבטל ממציאותו,"
        },
        {
          "s": 23,
          "text": "אסורה מכאן10,"
        },
        {
          "s": 24,
          "text": "וכ\"ה בנוגע למצוות"
        },
        {
          "s": 25,
          "text": "(מעשים טובים),"
        },
        {
          "s": 26,
          "text": "דנוסף לזה שקיום המצוות צ\"ל"
        },
        {
          "s": 27,
          "text": "(לא מצד השכל,"
        },
        {
          "s": 28,
          "text": "אלא)"
        },
        {
          "s": 29,
          "text": "בדרך עבודת עבד11,"
        },
        {
          "s": 30,
          "text": "הנה גם הפעולה שנעשית ע\"י קיום המצוות הוא שאברי גוף האדם המקיים את המצוה נעשים מרכבה לרצון העליון12,"
        },
        {
          "s": 31,
          "text": "דמרכבה הו\"ע הביטול."
        },
        {
          "s": 32,
          "text": "ואעפ\"כ,"
        },
        {
          "s": 33,
          "text": "עיקרה של תורה"
        },
        {
          "s": 34,
          "text": "(תכלית חכמה)"
        },
        {
          "s": 35,
          "text": "(מציאות)"
        },
        {
          "s": 36,
          "text": "הוא תשובה ומעשים טובים"
        },
        {
          "s": 37,
          "text": "(ביטול)."
        }
      ]
    }
  ]
}