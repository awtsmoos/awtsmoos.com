{
  "globalIndex": 1088,
  "owner": 38,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920245_theRebbe_641__p003",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920245_theRebbe_641__p003",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920245_theRebbe_641",
  "title": "מאמר לכה דודי תשי\"ד",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ויש לומר שזהו ג\"כ הביאור בזה שמביא"
        },
        {
          "s": 2,
          "text": "(בתחילת המאמר)"
        },
        {
          "s": 3,
          "text": "ב' קצוות בענין השבת,"
        },
        {
          "s": 4,
          "text": "דהשבת נק' מלכה שהיא ספירת המלכות שלמטה מכל הספירות ומקבלת מהן,"
        },
        {
          "s": 5,
          "text": "כמאמר37"
        },
        {
          "s": 6,
          "text": "סיהרא לית לה מגרמה כלום"
        },
        {
          "s": 7,
          "text": "[וכמאמר רז\"ל38"
        },
        {
          "s": 8,
          "text": "(גבי שבת)"
        },
        {
          "s": 9,
          "text": "דדוקא מי שטרח בערב שבת יאכל בשבת],"
        },
        {
          "s": 10,
          "text": "ולאידך הרי כולהו יומין מתברכין מהשבת39,"
        },
        {
          "s": 11,
          "text": "היינו דלא זו בלבד ששבת מקודש מכל הימים,"
        },
        {
          "s": 12,
          "text": "אלא עוד זאת,"
        },
        {
          "s": 13,
          "text": "שהיא משפיעה בהם."
        },
        {
          "s": 14,
          "text": "אך הענין הוא,"
        },
        {
          "s": 15,
          "text": "דז' ימי השבוע הם שבעת ימי הבנין,"
        },
        {
          "s": 16,
          "text": "דששת ימי החול הם בז\"א כמ\"ש40"
        },
        {
          "s": 17,
          "text": "ששת ימים עשה הוי' את השמים ואת הארץ ואיתא בזהר41"
        },
        {
          "s": 18,
          "text": "כל יומא ויומא עביד עבידתי',"
        },
        {
          "s": 19,
          "text": "ושבת היא מלכות"
        },
        {
          "s": 20,
          "text": "(כנ\"ל)."
        },
        {
          "s": 21,
          "text": "ולכן,"
        },
        {
          "s": 22,
          "text": "מצד זה שהמלכות ירדה למטה,"
        },
        {
          "s": 23,
          "text": "ובפרט מצד ירידתה לבי\"ע דרגלי' יורדות כו',"
        },
        {
          "s": 24,
          "text": "השבת"
        },
        {
          "s": 25,
          "text": "(מלכות)"
        },
        {
          "s": 26,
          "text": "מקבלת מששת ימי החול"
        },
        {
          "s": 27,
          "text": "(ז\"א),"
        },
        {
          "s": 28,
          "text": "שהו\"ע עבודת הבירורים"
        },
        {
          "s": 29,
          "text": "(בירור הנה\"ב וכל הדברים הגשמיים)"
        },
        {
          "s": 30,
          "text": "דששת ימי החול."
        },
        {
          "s": 31,
          "text": "אמנם לאחרי"
        },
        {
          "s": 32,
          "text": "(וע\"י)"
        },
        {
          "s": 33,
          "text": "עבודה זו נעשה"
        },
        {
          "s": 34,
          "text": "(בשבת)"
        },
        {
          "s": 35,
          "text": "עליית המלכות מבי\"ע עד עלי' לשרשה ומקורה,"
        },
        {
          "s": 36,
          "text": "ואז מתעלית למעלה מז\"א עד שמשפעת גם לכל ששת ימי החול"
        },
        {
          "s": 37,
          "text": "(ז\"א),"
        },
        {
          "s": 38,
          "text": "דמיני' מתברכין כולהו יומין."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וזהו לכה דודי לקראת כלה פני שבת נקבלה,"
        },
        {
          "s": 2,
          "text": "שהוא בקשת נש\"י שתהי' המשכת הז\"א במלכות."
        },
        {
          "s": 3,
          "text": "דתחילת ההמשכה היא לכה דודי לקראת כלה,"
        },
        {
          "s": 4,
          "text": "הליכה בלבד,"
        },
        {
          "s": 5,
          "text": "ועי\"ז פני שבת נקבלה,"
        },
        {
          "s": 6,
          "text": "שהוא ההמשכה פנימית,"
        },
        {
          "s": 7,
          "text": "פני שבת42,"
        },
        {
          "s": 8,
          "text": "שמתגלה בחי' פנימיות המלכות ועד כמו שהיא מושרשת בעתיק."
        },
        {
          "s": 9,
          "text": "ולכן נקבלה לשון רבים,"
        },
        {
          "s": 10,
          "text": "שגם ז\"א מקבל מ"
        },
        {
          "s": 11,
          "text": "(שרש ה)"
        },
        {
          "s": 12,
          "text": "מלכות43,"
        },
        {
          "s": 13,
          "text": "אשת חיל עטרת בעלה."
        },
        {
          "s": 14,
          "text": "וכמו שהוא למעלה בז\"א ומלכות,"
        },
        {
          "s": 15,
          "text": "עד\"ז הוא בכל משפיע ומקבל,"
        },
        {
          "s": 16,
          "text": "שע\"י המקבל נתוסף בהמשפיע,"
        },
        {
          "s": 17,
          "text": "ומתלמידי יותר מכולם."
        },
        {
          "s": 18,
          "text": "ובפרט בחתן וכלה למטה,"
        },
        {
          "s": 19,
          "text": "שדוקא ע\"י ההמשכה פנימית,"
        },
        {
          "s": 20,
          "text": "הנה אשת חיל עטרת בעלה,"
        },
        {
          "s": 21,
          "text": "והכל הי' מן העפר44."
        },
        {
          "s": 22,
          "text": "שעי\"ז נמשך כח הא\"ס בדור ישרים יבורך בבנים ובני בנים עוסקים בתורה ומצוות."
        }
      ]
    }
  ]
}