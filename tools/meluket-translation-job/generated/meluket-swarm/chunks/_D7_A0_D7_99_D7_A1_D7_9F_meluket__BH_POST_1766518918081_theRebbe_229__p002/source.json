{
  "globalIndex": 736,
  "owner": 36,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918081_theRebbe_229__p002",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918081_theRebbe_229__p002",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518918081_theRebbe_229",
  "title": "מאמר והחרים ה' תשמ\"ט",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ואין הדבר תלוי אלא במעשינו ועבודתינו10,"
        },
        {
          "s": 2,
          "text": "דעל ידי עשיית מצוה כדבעי,"
        },
        {
          "s": 3,
          "text": "נעשה גאולה,"
        },
        {
          "s": 4,
          "text": "גאולה הפרטית של מקיים המצוה,"
        },
        {
          "s": 5,
          "text": "שהוא נמצא במצב של חירות אמיתית,"
        },
        {
          "s": 6,
          "text": "כמובן מהמבואר באגה\"ק11"
        },
        {
          "s": 7,
          "text": "בפירוש הכתוב12"
        },
        {
          "s": 8,
          "text": "פדה בשלום נפשי."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ויש להוסיף,"
        },
        {
          "s": 1,
          "text": "שהגאולה הפרטית"
        },
        {
          "s": 2,
          "text": "(פדה בשלום נפשי)"
        },
        {
          "s": 3,
          "text": "שנעשית ע\"י קיום מצוה כדבעי היא לא רק בעת קיום המצוה אלא שזה נמשך גם אח\"כ."
        },
        {
          "s": 4,
          "text": "וע\"ד המבואר בתניא13"
        },
        {
          "s": 5,
          "text": "בענין היחוד שנעשה ע\"י קיום מצוה,"
        },
        {
          "s": 6,
          "text": "שיחוד זה למעלה הוא נצחי לעולם ועד,"
        },
        {
          "s": 7,
          "text": "שזה"
        },
        {
          "s": 8,
          "text": "(היחוד למעלה)"
        },
        {
          "s": 9,
          "text": "פועל גם על האדם למטה,"
        },
        {
          "s": 10,
          "text": "עד\"ז הוא גם בהענין דפדה בשלום נפשי שנעשה ע\"י קיום מצוה,"
        },
        {
          "s": 11,
          "text": "שהוא ענין נצחי למעלה וגם למטה"
        },
        {
          "s": 12,
          "text": "[וע\"ד מרז\"ל14"
        },
        {
          "s": 13,
          "text": "כל העוסק בתורה משים שלום בפמליא של מעלה ובפמליא של מטה],"
        },
        {
          "s": 14,
          "text": "שהגאולה הפרטית שע\"י קיום המצוה היא נמשכת ופועלת במשך כל ימי חייו,"
        },
        {
          "s": 15,
          "text": "בחיי היום יומיים."
        },
        {
          "s": 16,
          "text": "ומזה באים גם לגאולה הכללית,"
        },
        {
          "s": 17,
          "text": "והיתה לה' המלוכה15"
        },
        {
          "s": 18,
          "text": "בכל המציאות כולה,"
        },
        {
          "s": 19,
          "text": "הן למעלה והן למטה."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה נוסף על זה שכל הענינים דתומ\"צ"
        },
        {
          "s": 2,
          "text": "(מעשינו ועבודתינו)"
        },
        {
          "s": 3,
          "text": "מקרבים ומביאים גאולה העתידה,"
        },
        {
          "s": 4,
          "text": "יש סגולה מיוחדת בענינים אלה השייכים בגלוי יותר למשיח."
        },
        {
          "s": 5,
          "text": "ומהם,"
        },
        {
          "s": 6,
          "text": "אכילת סעודת משיח באחרון של פסח ושתיית ד' כוסות בסעודה זו."
        },
        {
          "s": 7,
          "text": "דכמו שד' הכוסות שבלילות הראשונים דפסח הם כנגד ד' לשונות של גאולה16"
        },
        {
          "s": 8,
          "text": "(הגאולה דיציאת מצרים),"
        },
        {
          "s": 9,
          "text": "עד\"ז הוא גם בד' הכוסות דסעודת משיח באחרון של פסח שהם שייכים לגאולה העתידה."
        },
        {
          "s": 10,
          "text": "ויש לומר הביאור בזה ע\"פ הביאורים בהשייכות דגאולה העתידה לד' כוסות,"
        },
        {
          "s": 11,
          "text": "לד' לשונות של הגאולה דלעת\"ל17,"
        },
        {
          "s": 12,
          "text": "והגאולה העתידה הרי תהי' מארבע כנפות הארץ18."
        },
        {
          "s": 13,
          "text": "ואולי יש להוסיף,"
        },
        {
          "s": 14,
          "text": "דזה שבסעודת משיח הוא אותו מספר הכוסות שבלילות הראשונים דפסח הוא לרמז שבכח כ\"א מישראל לבוא מיד מהגאולה דיציאת מצרים"
        },
        {
          "s": 15,
          "text": "(ד' הכוסות דלילות הראשונים דפסח)"
        },
        {
          "s": 16,
          "text": "לגאולה העתידה"
        },
        {
          "s": 17,
          "text": "(ד' הכוסות דאחרון של פסח),"
        },
        {
          "s": 18,
          "text": "גאולה בפשטות19"
        },
        {
          "s": 19,
          "text": "למטה מעשרה טפחים."
        },
        {
          "s": 20,
          "text": "ובפרט שמעשינו ועבודתינו עכשיו הם כננס על גבי ענק,"
        },
        {
          "s": 21,
          "text": "כיון שהם באים לאחרי ובהמשך למעשי ועבודת רבותינו נשיאינו,"
        },
        {
          "s": 22,
          "text": "אדמו\"ר הזקן אדמו\"ר האמצעי אדמו\"ר הצ\"צ אדמו\"ר המהר\"ש אדמו\"ר נ\"ע וכ\"ק מו\"ח אדמו\"ר,"
        },
        {
          "s": 23,
          "text": "הרי בודאי ובודאי שבכח של מעשינו ועבודתינו,"
        },
        {
          "s": 24,
          "text": "כולל אכילת סעודת משיח ושתיית ד' כוסות באחרון של פסח,"
        },
        {
          "s": 25,
          "text": "להביא את הגאולה מיד,"
        },
        {
          "s": 26,
          "text": "כהרף עין ממש20."
        }
      ]
    }
  ]
}