{
  "globalIndex": 11,
  "owner": 11,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913746_theRebbe_550__p004",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913746_theRebbe_550__p004",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518913746_theRebbe_550",
  "title": "מאמר והיה ביום ההוא תשכ\"ח",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "דעל ידי התקיעה בשופר גדול בכדי לעורר את האובדים בארץ אשור והנדחים בארץ מצרים נעשה עילוי גם בארץ אשור וארץ מצרים."
        },
        {
          "s": 3,
          "text": "כי הכוונה בזה שישראל גלו לארץ אשור ולארץ מצרים,"
        },
        {
          "s": 4,
          "text": "ועד שעי\"ז נעשו אובדים ונדחים,"
        },
        {
          "s": 5,
          "text": "היא,"
        },
        {
          "s": 6,
          "text": "בכדי שע\"י מיצר הגלות,"
        },
        {
          "s": 7,
          "text": "ובפרט מיצר הגלות של אלה שע\"י הגלות נעשו במצב דאובדים ונדחים,"
        },
        {
          "s": 8,
          "text": "יתעורר ויומשך השופר גדול,"
        },
        {
          "s": 9,
          "text": "שעי\"ז יתעלו ישראל למדריגה נעלית יותר מהמדריגה שהיו קודם שגלו."
        },
        {
          "s": 10,
          "text": "ולכן,"
        },
        {
          "s": 11,
          "text": "כשיתקע בשופר גדול ותושלם הכוונה שבשבילה נבראה ארץ אשור וארץ מצרים,"
        },
        {
          "s": 12,
          "text": "תהי' עלי' גם בהם."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש להוסיף עוד ענין בהשייכות דיתקע בשופר גדול לראש השנה,"
        },
        {
          "s": 1,
          "text": "כי בראש השנה שני ענינים."
        },
        {
          "s": 2,
          "text": "שהוא יום בריאת האדם,"
        },
        {
          "s": 3,
          "text": "ושעי\"ז נעשה עילוי גם בכללות הבריאה"
        },
        {
          "s": 4,
          "text": "(כדלקמן)."
        },
        {
          "s": 5,
          "text": "והענין הוא כמ\"ש אדמו\"ר"
        },
        {
          "s": 6,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 7,
          "text": "נ\"ע בהמאמר ד\"ה זה היום תחלת מעשיך זכרון ליום ראשון47,"
        },
        {
          "s": 8,
          "text": "דצריך להבין,"
        },
        {
          "s": 9,
          "text": "הרי ראש השנה"
        },
        {
          "s": 10,
          "text": "(זה היום)"
        },
        {
          "s": 11,
          "text": "הוא באחד בתשרי שהוא יום הששי למעשה בראשית,"
        },
        {
          "s": 12,
          "text": "ואיך הוא זכרון ליום ראשון."
        },
        {
          "s": 13,
          "text": "ומבאר48,"
        },
        {
          "s": 14,
          "text": "דהרצון לבריאת העולם הוא חיצוניות הרצון,"
        },
        {
          "s": 15,
          "text": "ופנימיות הרצון הוא בישראל."
        },
        {
          "s": 16,
          "text": "ושני ענינים אלה בזמני השנה הם בכ\"ה אלול ובראש השנה."
        },
        {
          "s": 17,
          "text": "דבכ\"ה אלול שבו נברא העולם הוא חיצוניות הרצון,"
        },
        {
          "s": 18,
          "text": "ובראש השנה"
        },
        {
          "s": 19,
          "text": "(אחד בתשרי)"
        },
        {
          "s": 20,
          "text": "שבו נברא האדם,"
        },
        {
          "s": 21,
          "text": "אתם קרויין אדם49,"
        },
        {
          "s": 22,
          "text": "הוא פנימיות הרצון."
        },
        {
          "s": 23,
          "text": "וזהו זה היום תחלת מעשיך זכרון ליום ראשון,"
        },
        {
          "s": 24,
          "text": "דבראש השנה שני ענינים50."
        },
        {
          "s": 25,
          "text": "ענין העיקרי דראש השנה הוא שהוא תחלת מעשיך,"
        },
        {
          "s": 26,
          "text": "המשכת עצמות אוא\"ס"
        },
        {
          "s": 27,
          "text": "(שלמעלה מרצון לעולמות)"
        },
        {
          "s": 28,
          "text": "ע\"י עבודת האדם,"
        },
        {
          "s": 29,
          "text": "ועוד ענין בראש השנה שהוא זכרון ליום ראשון,"
        },
        {
          "s": 30,
          "text": "שההמשכה דעצמות אוא\"ס נמשכת גם בהרצון לבריאת העולמות,"
        },
        {
          "s": 31,
          "text": "ועי\"ז בהעולמות51."
        },
        {
          "s": 32,
          "text": "ועפ\"ז,"
        },
        {
          "s": 33,
          "text": "השייכות דיתקע בשופר גדול לראש השנה היא בשני הענינים שבו,"
        },
        {
          "s": 34,
          "text": "המשכת הגילוי דשופר גדול לישראל שייכת לתחילת מעשיך,"
        },
        {
          "s": 35,
          "text": "והעילוי שיהי' עי\"ז בארץ אשור וארץ מצרים שייך לזכרון ליום ראשון."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "והנה ע\"פ המובא לעיל"
        },
        {
          "s": 2,
          "text": "(ס\"ה)"
        },
        {
          "s": 3,
          "text": "מהדרוש דאדמו\"ר מהר\"ש שהמיצר דשופר הו\"ע שנה שרשה בתחלתה,"
        },
        {
          "s": 4,
          "text": "דענין רשה בתחלתה הוא זה שישראל עושין עצמן רשין בראש השנה,"
        },
        {
          "s": 5,
          "text": "מובן,"
        },
        {
          "s": 6,
          "text": "דענין המיצר שעל ידו הוא המשכת המרחב הוא גם כשהמיצר הוא מצד הביטול,"
        },
        {
          "s": 7,
          "text": "שעבודתו היא בשלימות אלא שמצד הביטול שלו הוא מרגיש שהוא נמצא במיצר,"
        },
        {
          "s": 8,
          "text": "גם ע\"י מיצר זה הוא המשכת המרחב."
        },
        {
          "s": 9,
          "text": "ועד\"ז הוא בנוגע הגילוי דשופר גדול שמתעורר ונמשך ע\"י המיצר דהאובדים והנדחים,"
        },
        {
          "s": 10,
          "text": "דגם כשעבודתו היא בשלימות אלא שמתבונן שלגבי הרוממות דאוא\"ס גם העבודה האמיתית לחטא יחשב52"
        },
        {
          "s": 11,
          "text": "ולכן הוא מרגיש את עצמו לאובד ונדח,"
        },
        {
          "s": 12,
          "text": "שעי\"ז נתעורר ונמשך הגילוי דשופר גדול."
        },
        {
          "s": 13,
          "text": "ויש לומר שגם אז"
        },
        {
          "s": 14,
          "text": "(כשהמשכת הגילוי דשופר גדול היא ע\"י הביטול שלו)"
        },
        {
          "s": 15,
          "text": "שייך לשון יתקע"
        },
        {
          "s": 16,
          "text": "(תי\"ו בקמ\"ץ),"
        },
        {
          "s": 17,
          "text": "יתקע מעצמו,"
        },
        {
          "s": 18,
          "text": "כי כשעושה עצמו עני ורש,"
        },
        {
          "s": 19,
          "text": "דענין העני הוא שאין לו משל עצמו כלום והוא רק מקבל זה שנותנים לו בדרך צדקה,"
        },
        {
          "s": 20,
          "text": "הוא מכיר ומרגיש דזה שע\"י עבודתו נמשך הגילוי הוא לא מצד העילוי שלו"
        },
        {
          "s": 21,
          "text": "(שבכחו להמשיך),"
        },
        {
          "s": 22,
          "text": "אלא מצד חסד הקב\"ה53,"
        },
        {
          "s": 23,
          "text": "יתקע מעצמו,"
        },
        {
          "s": 24,
          "text": "וכאילו שההמשכה היא בלי אתערותא דלתתא כלל."
        }
      ]
    }
  ]
}