{
  "globalIndex": 895,
  "owner": 45,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919103_theRebbe_196__p005",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919103_theRebbe_196__p005",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919103_theRebbe_196",
  "title": "מאמר השם נפשנו בחיים תשח\"י",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ויש לומר שזהו הקשר דהשם נפשנו בחיים גו' עם הגאולה די\"ב תמוז,"
        },
        {
          "s": 2,
          "text": "דהנה ידוע50"
        },
        {
          "s": 3,
          "text": "שע\"י הנהגת הטבע,"
        },
        {
          "s": 4,
          "text": "שהיא תמיד באופן א',"
        },
        {
          "s": 5,
          "text": "מתגלה הענין דלא שניתי51"
        },
        {
          "s": 6,
          "text": "(אלא שהענין דלא שניתי כמו שמתגלה בהנהגה הטבעית הוא מלובש בהגבלת הטבע),"
        },
        {
          "s": 7,
          "text": "וע\"י הנסים נמשך גילוי אור א\"ס הבלי גבול שלמעלה מהתלבשות בעולמות."
        },
        {
          "s": 8,
          "text": "והשרש דב' ענינים אלו הוא חסדים וגבורות."
        },
        {
          "s": 9,
          "text": "דהנהגת הטבע"
        },
        {
          "s": 10,
          "text": "(צמצום והגבלה)"
        },
        {
          "s": 11,
          "text": "היא מהגבורות"
        },
        {
          "s": 12,
          "text": "[וי\"ל דזה שבהנהגה הטבעית דוקא מתגלה הענין דלא שניתי הוא מפני ששרש הגבורות הוא למעלה משרש החסדים],"
        },
        {
          "s": 13,
          "text": "והנסים"
        },
        {
          "s": 14,
          "text": "(גילוי שלמעלה מהגבלת הטבע)"
        },
        {
          "s": 15,
          "text": "הם מהחסדים."
        },
        {
          "s": 16,
          "text": "וענין לאכללא שמאלא בימינא הוא,"
        },
        {
          "s": 17,
          "text": "שהגילוי דאור א\"ס הבל\"ג שע\"י הנסים הוא לא באופן דשידוד הטבע,"
        },
        {
          "s": 18,
          "text": "אלא דהגם שהטבע נשאר במציאותו,"
        },
        {
          "s": 19,
          "text": "רואים בגילוי שהוא נס שלמעלה מהטבע."
        },
        {
          "s": 20,
          "text": "ואולי יש לומר,"
        },
        {
          "s": 21,
          "text": "דמ\"ש בתניא52"
        },
        {
          "s": 22,
          "text": "דענין שיתף בו מדת רחמים53"
        },
        {
          "s": 23,
          "text": "הוא התגלות אלקות ע\"י צדיקים ואותות ומופתים,"
        },
        {
          "s": 24,
          "text": "הכוונה בזה היא"
        },
        {
          "s": 25,
          "text": "(בעיקר)"
        },
        {
          "s": 26,
          "text": "להאותות ומופתים"
        },
        {
          "s": 27,
          "text": "[שע\"י הצדיקים]"
        },
        {
          "s": 28,
          "text": "המלובשים בטבע"
        },
        {
          "s": 29,
          "text": "(שיתף בו),"
        },
        {
          "s": 30,
          "text": "שהאותות והמופתים שלמעלה מהטבע הם מהחסדים,"
        },
        {
          "s": 31,
          "text": "והטבע"
        },
        {
          "s": 32,
          "text": "(שבו מלובשים המופתים)"
        },
        {
          "s": 33,
          "text": "הוא מהגבורות,"
        },
        {
          "s": 34,
          "text": "ולכן אותות ומופתים אלו הם ממדת הרחמים,"
        },
        {
          "s": 35,
          "text": "ת\"ת,"
        },
        {
          "s": 36,
          "text": "שמחברת שני ההפכים דחו\"ג."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "וזוהי השייכות דהשם נפשנו בחיים גו' להגאולה די\"ב תמוז,"
        },
        {
          "s": 1,
          "text": "כי הגאולה די\"ב תמוז"
        },
        {
          "s": 2,
          "text": "(כולל גם התחלת הגאולה שהיתה בג' תמוז)"
        },
        {
          "s": 3,
          "text": "היתה נס גלוי שלמעלה מהטבע,"
        },
        {
          "s": 4,
          "text": "ואעפ\"כ לא הי' זה באופן דשידוד וביטול הטבע,"
        },
        {
          "s": 5,
          "text": "אלא שהטבע נשאר במציאותו,"
        },
        {
          "s": 6,
          "text": "ויתירה מזו שגם המנגדים נשארו אז בתקפם,"
        },
        {
          "s": 7,
          "text": "ומ\"מ הוכרחו לסייע"
        },
        {
          "s": 8,
          "text": "(וע\"י התוקף שלהם)"
        },
        {
          "s": 9,
          "text": "בהשחרור והגאולה54."
        },
        {
          "s": 10,
          "text": "ועי\"ז נתבטלה המחיצה בין התחתונים לעליונים,"
        },
        {
          "s": 11,
          "text": "לאכללא שמאלא בימינא."
        },
        {
          "s": 12,
          "text": "ועי\"ז ניתן לאח\"ז הכח לכאו\"א מישראל לבטל המחיצה בין עסק בדברי הרשות לקיום התומ\"צ,"
        },
        {
          "s": 13,
          "text": "שגם בעניני הרשות יאיר אור התורה והמצוות,"
        },
        {
          "s": 14,
          "text": "וזה נעשה הכנה קרובה לקיום היעוד55"
        },
        {
          "s": 15,
          "text": "ונגלה כבוד הוי' וראו כל בשר יחדיו כי פי הוי' דיבר,"
        },
        {
          "s": 16,
          "text": "שגם הבשר הגשמי יראה אלקות56."
        },
        {
          "s": 17,
          "text": "וכל זה נעשה ע\"י האותות ומופתים שע\"י הצדיקים,"
        },
        {
          "s": 18,
          "text": "שממשיכים בהטבע גילוי אלקות שלמעלה מהטבע,"
        },
        {
          "s": 19,
          "text": "כמו שהי' בימים ההם בזמן הזה."
        }
      ]
    }
  ]
}