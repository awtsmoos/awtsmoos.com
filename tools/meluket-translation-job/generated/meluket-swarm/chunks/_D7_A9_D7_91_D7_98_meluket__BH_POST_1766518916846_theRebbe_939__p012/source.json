{
  "globalIndex": 541,
  "owner": 41,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916846_theRebbe_939__p012",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916846_theRebbe_939__p012",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916846_theRebbe_939",
  "title": "מאמר באתי לגני תשל\"א",
  "part": 12,
  "sections": [
    {
      "v": 33,
      "items": [
        {
          "s": 0,
          "text": "וזהו שהמשכת עיקר שכינה למטה לאחר הסילוק היא נעלית יותר מכמו שהיתה בתחלת הבריאה,"
        },
        {
          "s": 1,
          "text": "כי ההמשכה לאחרי הסילוק שע\"י חטא עה\"ד והחטאים שלאחריו היא דוגמת ענין התשובה."
        },
        {
          "s": 2,
          "text": "והיתרון שנתחדש בההמשכה שלאחרי הסילוק הוא בשני הענינים"
        },
        {
          "s": 3,
          "text": "(כנ\"ל סוף סעיף ה),"
        },
        {
          "s": 4,
          "text": "הן בהמשכת הגילוי דלמעלה – כי המשכת הגילוי עכשיו היא ע\"י העבודה דאתכפיא"
        },
        {
          "s": 5,
          "text": "[ואתהפכא],"
        },
        {
          "s": 6,
          "text": "והן בנוגע להתחתונים – כי העבודה עכשיו היא עבודה בכח עצמו"
        },
        {
          "s": 7,
          "text": "[דזה שע\"י הצמצום נתחדש ענין העבודה בכח עצמו הוא בעיקר לאחרי חטא עה\"ד],"
        },
        {
          "s": 8,
          "text": "וע\"י העבודה בכח עצמו שהיא דוגמת הענין דאתהפכא,"
        },
        {
          "s": 9,
          "text": "ובפרט ע\"י העבודה דאתהפכא ממש,"
        },
        {
          "s": 10,
          "text": "נעשה העולם כלי להגילוי."
        }
      ]
    },
    {
      "v": 34,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ד)"
        },
        {
          "s": 2,
          "text": "וע\"י מעשינו ועבודתינו120"
        },
        {
          "s": 3,
          "text": "[דמעשינו הוא קיום התומ\"צ כפי הטבע,"
        },
        {
          "s": 4,
          "text": "ועבודתינו היא היגיעה בתומ\"צ נגד הטבע"
        },
        {
          "s": 5,
          "text": "(אתכפיא)121."
        },
        {
          "s": 6,
          "text": "ויש לומר,"
        },
        {
          "s": 7,
          "text": "שבמעשינו נכלל גם שע\"י היגיעה נעשה זה הטבע שלו"
        },
        {
          "s": 8,
          "text": "(אתהפכא)],"
        },
        {
          "s": 9,
          "text": "ובפרט בזמן הגלות120,"
        },
        {
          "s": 10,
          "text": "מתקנים הירידה שהיתה ע\"י חטא עה\"ד,"
        },
        {
          "s": 11,
          "text": "ועד שיהי' נרגש בגילוי שהירידה היא רק בשביל העלי',"
        },
        {
          "s": 12,
          "text": "ועד\"ז הוא בכל החטאים"
        },
        {
          "s": 13,
          "text": "[שנשתלשלו מחטא עה\"ד],"
        },
        {
          "s": 14,
          "text": "שע\"י התשובה נהפכים לזכיות."
        },
        {
          "s": 15,
          "text": "ויש לומר שעד\"ז הוא בנוגע למיתה שבאה ע\"י חטא עה\"ד,"
        },
        {
          "s": 16,
          "text": "שלע\"ל יתהפך לחיים."
        },
        {
          "s": 17,
          "text": "וכמבואר בכ\"מ122"
        },
        {
          "s": 18,
          "text": "דענין תחיית המתים הוא שהמת יהי' חי."
        },
        {
          "s": 19,
          "text": "ועד\"ז הוא בנוגע להתיקון דמיעוט הירח ודשבירת הכלים ועד לצמצום הראשון,"
        },
        {
          "s": 20,
          "text": "שהצמצום לא יסתיר,"
        },
        {
          "s": 21,
          "text": "ויתירה מזה,"
        },
        {
          "s": 22,
          "text": "שהצמצום עצמו יאיר."
        },
        {
          "s": 23,
          "text": "ועי\"ז יהי' עוה\"ז הגשמי כלי לגילוי אלקות,"
        },
        {
          "s": 24,
          "text": "כמ\"ש123"
        },
        {
          "s": 25,
          "text": "ונגלה כבוד הוי' וראו כל בשר יחדיו כי פי הוי' דיבר,"
        },
        {
          "s": 26,
          "text": "שגם בשר הגשמי יהי' כלי להגילוי,"
        },
        {
          "s": 27,
          "text": "הן להגילוי דכבוד הוי'"
        },
        {
          "s": 28,
          "text": "(מקיף)"
        },
        {
          "s": 29,
          "text": "והן להגילוי דפי הוי'"
        },
        {
          "s": 30,
          "text": "(פנימי)124."
        },
        {
          "s": 31,
          "text": "וזהו שארז\"ל125"
        },
        {
          "s": 32,
          "text": "העולם הבא אין בו לא אכילה ולא שתי',"
        },
        {
          "s": 33,
          "text": "דהגם שעולם הבא קאי על זמן התחי' שאז יהיו נשמות בגופים126"
        },
        {
          "s": 34,
          "text": "ומ\"מ לא יצטרכו לאכילה ושתי',"
        },
        {
          "s": 35,
          "text": "כי גוף הגשמי יהי' ניזון מזיו השכינה127."
        },
        {
          "s": 36,
          "text": "ויתירה מזה,"
        },
        {
          "s": 37,
          "text": "שלע\"ל יהי' הגוף למעלה גם מהנשמה,"
        },
        {
          "s": 38,
          "text": "שלכן תהי' הנשמה ניזונית מן הגוף128."
        }
      ]
    },
    {
      "v": 35,
      "items": [
        {
          "s": 0,
          "text": "וכל זה נעשה ע\"י מעשינו ועבודתינו עכשיו"
        },
        {
          "s": 1,
          "text": "(כנ\"ל),"
        },
        {
          "s": 2,
          "text": "ובפרט ע\"י עבודת התשובה,"
        },
        {
          "s": 3,
          "text": "והבטיחה תורה שסוף ישראל לעשות תשובה בסוף גלותן ומיד הן נגאלין129,"
        },
        {
          "s": 4,
          "text": "בגאולה האמיתית והשלימה ע\"י משיח צדקנו,"
        },
        {
          "s": 5,
          "text": "דמהענינים שיתחדשו בביאת המשיח הוא שמשיח אתא לאתבא צדיקייא בתיובתא130,"
        },
        {
          "s": 6,
          "text": "והקיצו ורננו שוכני עפר131"
        },
        {
          "s": 7,
          "text": "ובעל ההילולא בתוכם,"
        },
        {
          "s": 8,
          "text": "ויוליכנו קוממיות לארצנו בקרוב ממש."
        }
      ]
    }
  ]
}