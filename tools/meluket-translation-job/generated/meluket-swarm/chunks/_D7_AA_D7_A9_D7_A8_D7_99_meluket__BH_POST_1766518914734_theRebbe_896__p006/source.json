  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914734_theRebbe_896__p006",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914734_theRebbe_896",
  "title": "מאמר בורא ניב שפתיים תשמ\"ח",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "וע\"י היגיעה בכל הנ\"ל,"
        },
        {
          "s": 1,
          "text": "תהי' ההצלחה בזה באופן דמציאה,"
        },
        {
          "s": 2,
          "text": "יגעתי ומצאתי42,"
        },
        {
          "s": 3,
          "text": "עד שיבואו למציאה העיקרית,"
        },
        {
          "s": 4,
          "text": "מצאתי דוד עבדי43,"
        },
        {
          "s": 5,
          "text": "שקאי על משיח צדקנו הבא בהיסח הדעת44."
        },
        {
          "s": 6,
          "text": "וביאר כ\"ק מו\"ח אדמו\"ר נשיא דורנו,"
        },
        {
          "s": 7,
          "text": "שאין זה סתירה לזה שצריך לתבוע את ביאת משיח צדקנו,"
        },
        {
          "s": 8,
          "text": "לדבר בענין ביאת המשיח לכתוב בענין זה ולהרעיש בזה,"
        },
        {
          "s": 9,
          "text": "ואדרבה,"
        },
        {
          "s": 10,
          "text": "זהו היסח הדעת האמיתי45"
        },
        {
          "s": 11,
          "text": "שמקרב את ביאת המשיח למטה מעשרה טפחים,"
        },
        {
          "s": 12,
          "text": "ובאופן דלא עיכבן אפילו כהרף עין46,"
        },
        {
          "s": 13,
          "text": "תיכף ומיד ממש."
        }
      ]
    }
  ]
}