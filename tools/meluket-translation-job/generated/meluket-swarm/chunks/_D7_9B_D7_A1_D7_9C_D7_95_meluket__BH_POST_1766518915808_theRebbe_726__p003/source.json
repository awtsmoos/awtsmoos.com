{
  "globalIndex": 355,
  "owner": 5,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915808_theRebbe_726__p003",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915808_theRebbe_726__p003",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915808_theRebbe_726",
  "title": "מאמר פדה בשלום תשל\"ח",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "אלא שאעפ\"כ,"
        },
        {
          "s": 2,
          "text": "הענינים שנעשים למעלה"
        },
        {
          "s": 3,
          "text": "(ע\"י העבודה דישראל)"
        },
        {
          "s": 4,
          "text": "לפני העבודה,"
        },
        {
          "s": 5,
          "text": "אינם באותו העילוי כמו שהם לאחרי העבודה."
        },
        {
          "s": 6,
          "text": "וע\"ד הידוע בענין מגיד דבריו ליעקב חוקיו ומשפטיו לישראל39"
        },
        {
          "s": 7,
          "text": "[שפירוש דבריו חוקיו ומשפטיו הוא שהקב\"ה מקיים את המצוות40],"
        },
        {
          "s": 8,
          "text": "שיש בזה ב' ענינים41."
        },
        {
          "s": 9,
          "text": "ענין הא' הוא,"
        },
        {
          "s": 10,
          "text": "כדרשת רז\"ל עה\"פ מה שהוא עושה הוא אומר לישראל לעשות,"
        },
        {
          "s": 11,
          "text": "היינו שבתחילה הקב\"ה מקיים את המצוות וזה נותן כח לישראל שיקיימו את המצוות,"
        },
        {
          "s": 12,
          "text": "אתעדל\"ע שקודם לאתעדל\"ת."
        },
        {
          "s": 13,
          "text": "וענין הב' הוא,"
        },
        {
          "s": 14,
          "text": "דע\"י שישראל מקיימים את המצוות הנה מזה נמשך כן למעלה שיהי' הקב\"ה מקיים את המצוות42,"
        },
        {
          "s": 15,
          "text": "אתעדל\"ע שע\"י אתעדל\"ת."
        },
        {
          "s": 16,
          "text": "וענין זה שבמצוות הקב\"ה שנעשה ע\"י קיום המצוות דישראל,"
        },
        {
          "s": 17,
          "text": "הוא נעלה יותר מקיום המצוות דהקב\"ה כמו שהוא מצד עצמו43."
        },
        {
          "s": 18,
          "text": "וע\"ד אתעדל\"ע שע\"י אתעדל\"ת שהיא נעלית יותר מהאתעדל\"ע שלפני האתעדל\"ת44."
        },
        {
          "s": 19,
          "text": "וכמו שהמצוות דהקב\"ה שנעשים ע\"י שישראל מקיימים את המצוות הם נעלים יותר מהמצוות דהקב\"ה כמו שהם מצד עצמם,"
        },
        {
          "s": 20,
          "text": "עד\"ז יש לומר בהמצוות דהקב\"ה שנעשים ע\"י קיום המצוות דישראל גופא,"
        },
        {
          "s": 21,
          "text": "שהמצוות דהקב\"ה שלאחרי קיום המצוות דישראל בפו\"מ,"
        },
        {
          "s": 22,
          "text": "הם נעלים יותר מהמצוות דהקב\"ה"
        },
        {
          "s": 23,
          "text": "(שנעשו ע\"י קיום המצוות דישראל)"
        },
        {
          "s": 24,
          "text": "לפני קיום המצוות דישראל בפו\"מ."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ובזה יובן מה שארז\"ל45"
        },
        {
          "s": 2,
          "text": "עה\"פ46"
        },
        {
          "s": 3,
          "text": "ויהי ערב ויהי בוקר יום הששי,"
        },
        {
          "s": 4,
          "text": "שיום הששי דמעשה בראשית"
        },
        {
          "s": 5,
          "text": "[שעיקר ענין מע\"ב הוא ביום הששי,"
        },
        {
          "s": 6,
          "text": "יום ברוא אדה\"ר,"
        },
        {
          "s": 7,
          "text": "כמו שאומרים בר\"ה47"
        },
        {
          "s": 8,
          "text": "זה היום תחילת מעשיך48."
        },
        {
          "s": 9,
          "text": "ועד\"ז הוא גם בנוגע לי\"ט כסלו,"
        },
        {
          "s": 10,
          "text": "ר\"ה לתורת החסידות ודרכי החסידות,"
        },
        {
          "s": 11,
          "text": "שזה היום תחילת מעשיך שלימות הכוונה האמיתית בבריאת האדם49]"
        },
        {
          "s": 12,
          "text": "תלוי ביום הששי דסיון שבו ניתנה תורה50,"
        },
        {
          "s": 13,
          "text": "כי התנה51"
        },
        {
          "s": 14,
          "text": "הקב\"ה עם מעשה בראשית כו' אם ישראל מקבלים התורה"
        },
        {
          "s": 15,
          "text": "(אז דוקא)"
        },
        {
          "s": 16,
          "text": "אתם מתקיימין כו'."
        },
        {
          "s": 17,
          "text": "דמזה שתלה הכתוב את יום הששי דמע\"ב ביום הששי דסיון,"
        },
        {
          "s": 18,
          "text": "משמע,"
        },
        {
          "s": 19,
          "text": "דזה שתוקף הקיום דמעשה בראשית נעשה ביום הששי דסיון הוא"
        },
        {
          "s": 20,
          "text": "(לא רק מפני הספק שהי' בארץ שמא לא יקבלוה52,"
        },
        {
          "s": 21,
          "text": "אלא)"
        },
        {
          "s": 22,
          "text": "גם לפי האמת,"
        },
        {
          "s": 23,
          "text": "כפי שכלפי שמיא גליא"
        },
        {
          "s": 24,
          "text": "(גם מקודם)"
        },
        {
          "s": 25,
          "text": "שישראל יקבלו את התורה."
        },
        {
          "s": 26,
          "text": "[ויש להוסיף,"
        },
        {
          "s": 27,
          "text": "דמכיון שאם ישראל מקבלים את התורה הוא תנאי במעשה בראשית,"
        },
        {
          "s": 28,
          "text": "הרי"
        },
        {
          "s": 29,
          "text": "(גם כשידוע מקודם שיתקיים התנאי)"
        },
        {
          "s": 30,
          "text": "התוקף דהמעשה הוא כשיתקיים התנאי בפועל53]."
        },
        {
          "s": 31,
          "text": "ואף שגם ענין זה"
        },
        {
          "s": 32,
          "text": "(מה שישראל קבלו את התורה בפועל)"
        },
        {
          "s": 33,
          "text": "נעשה אצלו ית' גם בתחילה,"
        },
        {
          "s": 34,
          "text": "הרי נוסף לזה שענין זה הוא רק מצד למעלה"
        },
        {
          "s": 35,
          "text": "(מכיון שאצלו ית' העבר והעתיד אחד),"
        },
        {
          "s": 36,
          "text": "משא\"כ בהעולם54"
        },
        {
          "s": 37,
          "text": "לא הי' ענין זה55,"
        },
        {
          "s": 38,
          "text": "שלכן לא הי' תוקף לקיום העולם עד יום הששי בסיון,"
        },
        {
          "s": 39,
          "text": "הנה ע\"י שישראל קבלו את התורה בפועל בעוה\"ז הגשמי"
        },
        {
          "s": 40,
          "text": "(בששי בסיון),"
        },
        {
          "s": 41,
          "text": "נעשה עילוי נעלה יותר גם בהענין דקבלת התורה כמו שהיא במחשבתו ית' לפני הבריאה56."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והענין הוא,"
        },
        {
          "s": 2,
          "text": "כמו שנתבאר לעיל"
        },
        {
          "s": 3,
          "text": "(בד\"ה מים רבים57)"
        },
        {
          "s": 4,
          "text": "בענין העלי' הנעשית בהנשמות ע\"י ירידתן למטה דוקא,"
        },
        {
          "s": 5,
          "text": "אף שגם לפני זה היו מושרשות בעצמותו ית' ובהם נמלך כו',"
        },
        {
          "s": 6,
          "text": "שבהיותן בבחינת ההמלכה הן בבחינת צדיקים"
        },
        {
          "s": 7,
          "text": "(כדיוק הלשון במי נמלך בנשמותיהן של צדיקים58),"
        },
        {
          "s": 8,
          "text": "וע\"י העבודה דתומ\"צ"
        },
        {
          "s": 9,
          "text": "(בפועל)"
        },
        {
          "s": 10,
          "text": "בירידתן למטה נעשים בדרגת בעלי תשובה,"
        },
        {
          "s": 11,
          "text": "ענין והרוח תשוב אל האלקים אשר נתנה59."
        },
        {
          "s": 12,
          "text": "כמשנ\"ת בארוכה בד\"ה הנ\"ל."
        },
        {
          "s": 13,
          "text": "וע\"פ הידוע60"
        },
        {
          "s": 14,
          "text": "שתכלית הכוונה בירידת הנשמה למטה הוא בכדי לתקן את הגוף ונפש הבהמית וחלקו בעולם,"
        },
        {
          "s": 15,
          "text": "יש לומר,"
        },
        {
          "s": 16,
          "text": "שגם הפעולה בעולם"
        },
        {
          "s": 17,
          "text": "(בהגוף בנה\"ב ובחלקו בעולם,"
        },
        {
          "s": 18,
          "text": "ועד בכללות העולם)"
        },
        {
          "s": 19,
          "text": "שנעשה ע\"י עבודת הנשמה,"
        },
        {
          "s": 20,
          "text": "הוא ענין התשובה,"
        },
        {
          "s": 21,
          "text": "עליית כל הבירורים בבחינת אור חוזר דתשובה61."
        },
        {
          "s": 22,
          "text": "ואדרבה,"
        },
        {
          "s": 23,
          "text": "תכלית הכוונה בירידת הנשמה למטה הוא"
        },
        {
          "s": 24,
          "text": "(לא בשביל העילוי דתשובה שנעשה בהנשמה,"
        },
        {
          "s": 25,
          "text": "כי אם)"
        },
        {
          "s": 26,
          "text": "בכדי לפעול בירור והעלאת הניצוצות שבעולם"
        },
        {
          "s": 27,
          "text": "(ענין התשובה דעולם,"
        },
        {
          "s": 28,
          "text": "והוא למעלה יותר מהתשובה דהנשמה62)."
        }
      ]
    }
  ]
}