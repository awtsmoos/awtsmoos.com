{
  "globalIndex": 800,
  "owner": 0,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918574_theRebbe_925__p001",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918574_theRebbe_925__p001",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918574_theRebbe_925",
  "title": "מאמר פתח רבי שמעון תשל\"ד",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ אמור,"
        },
        {
          "s": 2,
          "text": "י\"ט אייר,"
        },
        {
          "s": 3,
          "text": "ה'תשל\"ד*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "פתח רבי שמעון ואמר אני לדודי ועלי תשוקתו1,"
        },
        {
          "s": 1,
          "text": "כל יומין דאתקטרנא בהאי עלמא בחד קטירא אתקטרנא בי' בקוב\"ה ובגין כך השתא ועלי תשוקתו2."
        },
        {
          "s": 2,
          "text": "ובהמשך הענין שם3,"
        },
        {
          "s": 3,
          "text": "מסתכל הוינא כל יומא בהאי קרא דכתיב4"
        },
        {
          "s": 4,
          "text": "בה' תתהלל נפשי כו' והאידנא אתקיים קרא כולא כו' דהא נשמתי בי' אחידא בי' להיטא בי' אתדבקת כו'."
        },
        {
          "s": 5,
          "text": "שבמשך כל ימי חייו"
        },
        {
          "s": 6,
          "text": "(כל יומין דאתקטרנא בהאי עלמא)"
        },
        {
          "s": 7,
          "text": "הי' רשב\"י מקושר בהקב\"ה"
        },
        {
          "s": 8,
          "text": "(אתקטרנא הוא לשון קשר,"
        },
        {
          "s": 9,
          "text": "כמו ותקשור על ידו שני וגו'5"
        },
        {
          "s": 10,
          "text": "ותרגם וקטרת על ידיה זהוריתא6),"
        },
        {
          "s": 11,
          "text": "דהתקשרות היא דוקא בשני דברים,"
        },
        {
          "s": 12,
          "text": "והאידנא,"
        },
        {
          "s": 13,
          "text": "ביום הסתלקותו7,"
        },
        {
          "s": 14,
          "text": "הגיע לדרגא נעלית יותר,"
        },
        {
          "s": 15,
          "text": "שנעשה חד עם הקב\"ה,"
        },
        {
          "s": 16,
          "text": "בי' אחידא."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "והנה אף שלהדרגא דבי' אחידא הגיע רשב\"י"
        },
        {
          "s": 1,
          "text": "(רק)"
        },
        {
          "s": 2,
          "text": "ביום הסתלקותו,"
        },
        {
          "s": 3,
          "text": "הרי מכיון שכל ימיו השתדל להגיע לדרגא זו"
        },
        {
          "s": 4,
          "text": "(מסתכל הוינא כל יומא בהאי קרא),"
        },
        {
          "s": 5,
          "text": "מובן,"
        },
        {
          "s": 6,
          "text": "שבכללות שייך לזה והגיע לזה8"
        },
        {
          "s": 7,
          "text": "גם בחייו9,"
        },
        {
          "s": 8,
          "text": "אלא שהשלימות בזה"
        },
        {
          "s": 9,
          "text": "(קרא כולא)"
        },
        {
          "s": 10,
          "text": "נתקיים בו האידנא,"
        },
        {
          "s": 11,
          "text": "ביום הסתלקותו."
        },
        {
          "s": 12,
          "text": "וכמובן גם מהמבואר בהמשך תרס\"ו10"
        },
        {
          "s": 13,
          "text": "דזה שעסק התורה דרשב\"י הי' באופן דתורתו אומנתו11,"
        },
        {
          "s": 14,
          "text": "היינו שעסק התורה שלו היתה באופן דהמשכת מ\"ד12"
        },
        {
          "s": 15,
          "text": "(ודלא כשאר התנאים שהלימוד שלהם הי' באופן דהעלאת מ\"ן),"
        },
        {
          "s": 16,
          "text": "הוא הענין ד"
        },
        {
          "s": 17,
          "text": "(בי' אחידא)"
        },
        {
          "s": 18,
          "text": "בי' להיטא,"
        },
        {
          "s": 19,
          "text": "והרי זה שרשב\"י היתה תורתו אומנתו,"
        },
        {
          "s": 20,
          "text": "הי' זה במשך כל ימי חייו."
        },
        {
          "s": 21,
          "text": "ויש להוסיף,"
        },
        {
          "s": 22,
          "text": "דזה שבכמה דרושים13"
        },
        {
          "s": 23,
          "text": "מובא הענין דנשמתי בי' אחידא כו' בהמשך אחד עם בחד קטירא אתקטרנא,"
        },
        {
          "s": 24,
          "text": "הוא,"
        },
        {
          "s": 25,
          "text": "כי גם בהענין דבחד קטירא אתקטרנא יש בפנימיות בי' אחידא כו',"
        },
        {
          "s": 26,
          "text": "אלא שבמשך כל ימי חייו לא הי' זה"
        },
        {
          "s": 27,
          "text": "(בי' אחידא כו')"
        },
        {
          "s": 28,
          "text": "בגילוי,"
        },
        {
          "s": 29,
          "text": "וביום ההסתלקות שלו,"
        },
        {
          "s": 30,
          "text": "שאז מתגלה הפנימיות"
        },
        {
          "s": 31,
          "text": "(השרש והמקור)"
        },
        {
          "s": 32,
          "text": "של כל עניני עבודת האדם שעבד במשך כל ימי חייו14,"
        },
        {
          "s": 33,
          "text": "אז מתגלה הפנימיות דבחד קטירא אתקטרנא15,"
        },
        {
          "s": 34,
          "text": "שהוא"
        },
        {
          "s": 35,
          "text": "(לא רק התקשרות,"
        },
        {
          "s": 36,
          "text": "אלא גם)"
        },
        {
          "s": 37,
          "text": "בי' אחידא."
        }
      ]
    }
  ]
}