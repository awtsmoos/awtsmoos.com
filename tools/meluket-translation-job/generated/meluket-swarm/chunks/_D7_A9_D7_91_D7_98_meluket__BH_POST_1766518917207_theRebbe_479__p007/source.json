  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518917207_theRebbe_479",
  "title": "מאמר ואלה המשפטים תשמ\"א",
  "part": 7,
  "sections": [
    {
      "v": 18,
      "items": [
        {
          "s": 0,
          "text": "וע\"י לימוד התורה באופן דאשר תשים לפניהם,"
        },
        {
          "s": 1,
          "text": "כי תקנה עבד,"
        },
        {
          "s": 2,
          "text": "שהלימוד הוא בהבנה והסברה וביחד עם זה בביטול דעבד"
        },
        {
          "s": 3,
          "text": "[שבכדי שלימוד הנגלה יהי' באופן זה הוא ע\"י לימוד פנימיות התורה,"
        },
        {
          "s": 4,
          "text": "תשים לשון סימה,"
        },
        {
          "s": 5,
          "text": "אוצר],"
        },
        {
          "s": 6,
          "text": "עי\"ז יזכו לגילוי תורתו של משיח,"
        },
        {
          "s": 7,
          "text": "תורה חדשה מאתי תצא75,"
        },
        {
          "s": 8,
          "text": "בגאולה האמיתית והשלימה ע\"י משיח צדקנו,"
        },
        {
          "s": 9,
          "text": "במהרה בימינו ממש."
        }
      ]
    }
  ]
}