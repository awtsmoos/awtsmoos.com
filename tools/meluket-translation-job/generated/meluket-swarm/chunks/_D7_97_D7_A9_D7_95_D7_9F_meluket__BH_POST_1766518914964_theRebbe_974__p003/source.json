{
  "globalIndex": 201,
  "owner": 1,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914964_theRebbe_974__p003",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914964_theRebbe_974__p003",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518914964_theRebbe_974",
  "title": "מאמר ויהיו חיי שרה תשמ\"ה",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "והענין הוא,"
        },
        {
          "s": 1,
          "text": "דמבואר בהמאמר26,"
        },
        {
          "s": 2,
          "text": "דשרה היא בחינת מלכות27"
        },
        {
          "s": 3,
          "text": "[שלכן נקראת שרה מלשון שררה28]"
        },
        {
          "s": 4,
          "text": "וחיין עילאין הם הספירות שלמעלה ממלכות."
        },
        {
          "s": 5,
          "text": "וע\"פ הידוע29"
        },
        {
          "s": 6,
          "text": "(ומבואר גם במאמר הנ\"ל30)"
        },
        {
          "s": 7,
          "text": "ששרש המלכות הוא למעלה משרש כל הספירות,"
        },
        {
          "s": 8,
          "text": "דשרש כל הספירות הוא באריך ושרש המלכות הוא ברדל\"א,"
        },
        {
          "s": 9,
          "text": "יש לומר,"
        },
        {
          "s": 10,
          "text": "שע\"י המשכת הספירות במלכות,"
        },
        {
          "s": 11,
          "text": "ובאופן שהם מתאחדים עם המלכות ועד שדילה הוו חיין,"
        },
        {
          "s": 12,
          "text": "נעשה עלי' בהספירות,"
        },
        {
          "s": 13,
          "text": "שנמשך בהם מעין הגילוי דרדל\"א"
        },
        {
          "s": 14,
          "text": "(שרש המלכות)31."
        },
        {
          "s": 15,
          "text": "ועי\"ז,"
        },
        {
          "s": 16,
          "text": "הם מתכללים ומתאחדים כולם כאחד,"
        },
        {
          "s": 17,
          "text": "כולן שוין."
        },
        {
          "s": 18,
          "text": "וזהו שבויהיו חיי שרה נאמר מאה שנה ועשרים שנה ושבע שנים,"
        },
        {
          "s": 19,
          "text": "ובשני חיי שרה אינו מפרט המספרים דמאה עשרים ושבע,"
        },
        {
          "s": 20,
          "text": "כי החיין עילאין"
        },
        {
          "s": 21,
          "text": "(ספירות)"
        },
        {
          "s": 22,
          "text": "כמו שהם מצד עצמם,"
        },
        {
          "s": 23,
          "text": "כולל גם כמו שנמשכים במלכות אבל באופן שהחיין עילאין והמלכות הם שני ענינים"
        },
        {
          "s": 24,
          "text": "(זכתה לחיין עילאין),"
        },
        {
          "s": 25,
          "text": "הם בהתחלקות,"
        },
        {
          "s": 26,
          "text": "ובכללות נחלקים לג' בחינות"
        },
        {
          "s": 27,
          "text": "(מאה,"
        },
        {
          "s": 28,
          "text": "עשרים ושבע)32,"
        },
        {
          "s": 29,
          "text": "וע\"י שנעשים ענינם של המלכות"
        },
        {
          "s": 30,
          "text": "[שני חיי שרה,"
        },
        {
          "s": 31,
          "text": "דילה הוו],"
        },
        {
          "s": 32,
          "text": "מאיר בהם הגילוי דשרש המלכות שלמעלה מהתחלקות."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ויש להוסיף,"
        },
        {
          "s": 2,
          "text": "דשלילת ההתחלקות שבשני חיי שרה הוא בשני ענינים."
        },
        {
          "s": 3,
          "text": "שאינם נחלקים לג' חלוקות דמאה עשרים ושבע,"
        },
        {
          "s": 4,
          "text": "כנ\"ל סעיף ד."
        },
        {
          "s": 5,
          "text": "ויתירה מזו,"
        },
        {
          "s": 6,
          "text": "דבג' החלוקות דמאה ועשרים ושבע,"
        },
        {
          "s": 7,
          "text": "אף שכל אחד מהם הו\"ע כללי,"
        },
        {
          "s": 8,
          "text": "מ\"מ,"
        },
        {
          "s": 9,
          "text": "כיון שהכלל הוא במספר מסויים"
        },
        {
          "s": 10,
          "text": "(מאה,"
        },
        {
          "s": 11,
          "text": "עשרים,"
        },
        {
          "s": 12,
          "text": "שבע)"
        },
        {
          "s": 13,
          "text": "הרי יש בו"
        },
        {
          "s": 14,
          "text": "(בהעלם עכ\"פ)"
        },
        {
          "s": 15,
          "text": "פרטים מחולקים."
        },
        {
          "s": 16,
          "text": "והטעם שבשני חיי שרה לא נאמר מספר"
        },
        {
          "s": 17,
          "text": "(גם לא המספר מאה ועשרים ושבע,"
        },
        {
          "s": 18,
          "text": "שאינו נחלק לג' חלוקות)"
        },
        {
          "s": 19,
          "text": "הוא,"
        },
        {
          "s": 20,
          "text": "לפי שהם למעלה גם מענין דהתחלקות פרטים כמו שהם כלולים בהכלל."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "וביאור הענין בפרטיות יותר,"
        },
        {
          "s": 1,
          "text": "יובן בהקדים המבואר בכ\"מ33,"
        },
        {
          "s": 2,
          "text": "דמאה שנה הוא כתר"
        },
        {
          "s": 3,
          "text": "(אריך)"
        },
        {
          "s": 4,
          "text": "שכולל את כל העשר ספירות כמו שהם בשלימות היותר משובחת34,"
        },
        {
          "s": 5,
          "text": "שכל אחד מהם כלול מעשר,"
        },
        {
          "s": 6,
          "text": "מאה."
        },
        {
          "s": 7,
          "text": "ובהטעם שנאמר"
        },
        {
          "s": 8,
          "text": "(מאה)"
        },
        {
          "s": 9,
          "text": "שנה לשון יחיד,"
        },
        {
          "s": 10,
          "text": "שני ביאורים."
        },
        {
          "s": 11,
          "text": "כי ההתחלקות דהספירות"
        },
        {
          "s": 12,
          "text": "(חכמה,"
        },
        {
          "s": 13,
          "text": "בינה וכו')"
        },
        {
          "s": 14,
          "text": "הוא בספירות הגלויות משא\"כ בהיותם כלולים בשרשם"
        },
        {
          "s": 15,
          "text": "(אריך)"
        },
        {
          "s": 16,
          "text": "הם כלולים כולם כאחד35."
        },
        {
          "s": 17,
          "text": "ויתירה מזו,"
        },
        {
          "s": 18,
          "text": "דבחינת עתיק אינה בגדר עשר ספירות"
        },
        {
          "s": 19,
          "text": "(היינו שאינה גם מקור לעשר ספירות),"
        },
        {
          "s": 20,
          "text": "וע\"י הגילוי דעתיק שמאיר באריך,"
        },
        {
          "s": 21,
          "text": "גם הספירות הכלולות באריך,"
        },
        {
          "s": 22,
          "text": "מאה,"
        },
        {
          "s": 23,
          "text": "הם בבחינת שנה לשון יחיד36."
        },
        {
          "s": 24,
          "text": "עשרים שנה הם חכמה ובינה שכל אחד מהם כלול מיו\"ד."
        },
        {
          "s": 25,
          "text": "וגם בהם נאמר שנה לשון יחיד,"
        },
        {
          "s": 26,
          "text": "כי חו\"ב הם37"
        },
        {
          "s": 27,
          "text": "תרין ריעין דלא מתפרשין."
        },
        {
          "s": 28,
          "text": "ושבע שנים הם שבעת המדות."
        },
        {
          "s": 29,
          "text": "ונאמר שבע שנים לשון רבים,"
        },
        {
          "s": 30,
          "text": "כי המדות הם בהתחלקות."
        },
        {
          "s": 31,
          "text": "ועפ\"ז יובן עוד יותר העילוי דשני חיי שרה שלא נאמר בהם מספר,"
        },
        {
          "s": 32,
          "text": "שהם למעלה יותר גם ממאה שנה לשון יחיד,"
        },
        {
          "s": 33,
          "text": "גם להביאור דמאה שנה לשון יחיד הוא מצד הגילוי דעתיק38."
        }
      ]
    }
  ]
}