{
  "globalIndex": 27,
  "owner": 27,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913820_theRebbe_687__p006",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913820_theRebbe_687__p006",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518913820_theRebbe_687",
  "title": "מאמר זה היום תחילת מעשיך תשמ\"א",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "אמנם עדיין צריך להבין,"
        },
        {
          "s": 3,
          "text": "שהרי כל הספירות שרשם הראשון הוא ברדל\"א,"
        },
        {
          "s": 4,
          "text": "דזה שכל הספירות"
        },
        {
          "s": 5,
          "text": "(חוץ מספירת המלכות)"
        },
        {
          "s": 6,
          "text": "כלולים באריך הוא מה שהם נמשכים אח\"כ באריך,"
        },
        {
          "s": 7,
          "text": "אבל שרשם הראשון"
        },
        {
          "s": 8,
          "text": "(גם דספירות אלו)"
        },
        {
          "s": 9,
          "text": "הוא ברדל\"א,"
        },
        {
          "s": 10,
          "text": "ולמעלה יותר עד מעצמותו ית',"
        },
        {
          "s": 11,
          "text": "כמ\"ש89"
        },
        {
          "s": 12,
          "text": "כי ממך הכל."
        },
        {
          "s": 13,
          "text": "ומכיון שבראש השנה חוזרים כל הדברים לקדמותם104,"
        },
        {
          "s": 14,
          "text": "הרי גם כל המדות והספירות נמשכים אז מעצמותו ית',"
        },
        {
          "s": 15,
          "text": "וא\"כ הרי החידוש דראש השנה הוא גם בכל המדות והספירות,"
        },
        {
          "s": 16,
          "text": "ולמה מדגישים ענין המלכות דוקא."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 1,
          "text": "דההפרש בין ספירת המלכות לשאר הספירות"
        },
        {
          "s": 2,
          "text": "(מה שנוגע כאן)"
        },
        {
          "s": 3,
          "text": "הוא בהתכלית שלהם."
        },
        {
          "s": 4,
          "text": "דהנה ידוע105"
        },
        {
          "s": 5,
          "text": "שהאצלת כל הספירות דאצילות היא בכדי שיהי' על ידם גילוי אלקות בבי\"ע עד למטה בעוה\"ז הגשמי"
        },
        {
          "s": 6,
          "text": "(שנשמות ישראל כמו שהן מלובשות בגוף גשמי יהיו חד עם העצמות)."
        },
        {
          "s": 7,
          "text": "שמבחינת החכמה דאצילות"
        },
        {
          "s": 8,
          "text": "[שהיא עיקר האצילות]"
        },
        {
          "s": 9,
          "text": "נמשך למטה ענין החכמה,"
        },
        {
          "s": 10,
          "text": "ידיעת והשגת אלקות,"
        },
        {
          "s": 11,
          "text": "ועד\"ז הוא בכל הספירות."
        },
        {
          "s": 12,
          "text": "ובזה הוא העילוי דספירת המלכות על שאר כל הספירות,"
        },
        {
          "s": 13,
          "text": "שגם בהמשכתה למטה היא באותו האופן כפי שהיא בשרשה הראשון בבחי' רדל\"א,"
        },
        {
          "s": 14,
          "text": "דכל שאר הספירות,"
        },
        {
          "s": 15,
          "text": "מכיון שענינם הוא שהם נהורין,"
        },
        {
          "s": 16,
          "text": "גילוי"
        },
        {
          "s": 17,
          "text": "[דהגם ששרשם הראשון הוא ברדל\"א,"
        },
        {
          "s": 18,
          "text": "הרי לאחרי המשכתם בבחי' אריך הם נהורין וזהו ענינם],"
        },
        {
          "s": 19,
          "text": "לכן,"
        },
        {
          "s": 20,
          "text": "גם המשכתם למטה בבי\"ע היא בבחי' נהורין,"
        },
        {
          "s": 21,
          "text": "גילוי."
        },
        {
          "s": 22,
          "text": "משא\"כ ספירת המלכות ענינה הוא בחי' נקודה ובחי' לא מציאות,"
        },
        {
          "s": 23,
          "text": "וגם בהמשכתה בהדרגות שלמטה מרדל\"א"
        },
        {
          "s": 24,
          "text": "[בבחי' מהותה ובבחי' מציאות מהותה ובבחי' התעוררותה ובבחי' אופן התעוררותה ובבחי' התגלותה ובבחי' אופן התגלותה,"
        },
        {
          "s": 25,
          "text": "כנ\"ל]"
        },
        {
          "s": 26,
          "text": "היא ע\"ד אותו האופן כמו שהיא בשרשה בבחי' רדל\"א,"
        },
        {
          "s": 27,
          "text": "וגם בהמשכתה למטה מטה,"
        },
        {
          "s": 28,
          "text": "בבי\"ע,"
        },
        {
          "s": 29,
          "text": "היא באופן זה שנרגש בה שרשה"
        },
        {
          "s": 30,
          "text": "(העצמות)."
        },
        {
          "s": 31,
          "text": "דהגם שהמלכות"
        },
        {
          "s": 32,
          "text": "(כמו שהיא בגילוי)"
        },
        {
          "s": 33,
          "text": "היא בבחי' התנשאות על עם,"
        },
        {
          "s": 34,
          "text": "הרי גם ענין ההתנשאות על עם הוא"
        },
        {
          "s": 35,
          "text": "(כנ\"ל)"
        },
        {
          "s": 36,
          "text": "מצד התנשאות העצמות."
        },
        {
          "s": 37,
          "text": "וזהו גם שההדגשה בראש השנה היא בענין המלכות דוקא ולא בענין הדיבור,"
        },
        {
          "s": 38,
          "text": "כי הדיבור הוא בבחי' מציאות ובבחי' התחלקות"
        },
        {
          "s": 39,
          "text": "(וכמבואר בסידור שער התקיעות שם106"
        },
        {
          "s": 40,
          "text": "בענין ההפרש שבין קול לדיבור),"
        },
        {
          "s": 41,
          "text": "משא\"כ המלכות היא בבחי' לא מציאות,"
        },
        {
          "s": 42,
          "text": "והרוממות וההתנשאות"
        },
        {
          "s": 43,
          "text": "(על עם)"
        },
        {
          "s": 44,
          "text": "דמלכות היא מצד רוממות והתנשאות העצמות."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ב)"
        },
        {
          "s": 2,
          "text": "וזהו זה היום תחלת מעשיך,"
        },
        {
          "s": 3,
          "text": "דהגם שבכ\"ה באלול נברא העולם וראש השנה הוא יום ו' למע\"ב,"
        },
        {
          "s": 4,
          "text": "הרי כיון שתכלית כוונת הבריאה הוא כמארז\"ל107"
        },
        {
          "s": 5,
          "text": "נתאוה הקב\"ה להיות לו ית' דירה בתחתונים,"
        },
        {
          "s": 6,
          "text": "דירה לעצמותו ית'"
        },
        {
          "s": 7,
          "text": "[וכידוע108"
        },
        {
          "s": 8,
          "text": "דענין הדירה הוא מה שהעצם נמצא בהדירה],"
        },
        {
          "s": 9,
          "text": "ושדירה זו תהי' בתחתונים,"
        },
        {
          "s": 10,
          "text": "בעוה\"ז הגשמי שאין תחתון למטה ממנו109,"
        },
        {
          "s": 11,
          "text": "לכן אומרים על היום דראש השנה,"
        },
        {
          "s": 12,
          "text": "יום בריאת האדם,"
        },
        {
          "s": 13,
          "text": "זה היום תחלת מעשיך,"
        },
        {
          "s": 14,
          "text": "לפי שכוונה זו נשלמת ע\"י עבודתו של כאו\"א מישראל,"
        },
        {
          "s": 15,
          "text": "אתם קרויים אדם32."
        },
        {
          "s": 16,
          "text": "דע\"י העבודה בלימוד התורה ובקיום המצוות"
        },
        {
          "s": 17,
          "text": "(חק לישראל ומשפט לאלקי יעקב)"
        },
        {
          "s": 18,
          "text": "עושים ופועלים בעולם שישוב ויהי' כמו שהי' בתחלת הבריאה"
        },
        {
          "s": 19,
          "text": "(לפני הירידה שע\"י חטא עה\"ד),"
        },
        {
          "s": 20,
          "text": "ויתירה מזה שיהי' בדרגא נעלית יותר מכמו שהי' קודם הבריאה,"
        },
        {
          "s": 21,
          "text": "ועד שיהי' דירה לעצמותו."
        },
        {
          "s": 22,
          "text": "דע\"י העבודה דישראל,"
        },
        {
          "s": 23,
          "text": "נעשה דירה לעצמותו ית' בתחתונים,"
        },
        {
          "s": 24,
          "text": "בעוה\"ז הגשמי שאין תחתון למטה ממנו,"
        },
        {
          "s": 25,
          "text": "בזה גופא גם בדרגות הכי תחתונות שבו,"
        },
        {
          "s": 26,
          "text": "וידע כל פעול כי אתה פעלתו."
        },
        {
          "s": 27,
          "text": "דע\"י העבודה בקיום המצוות בכח המעשה של האדם,"
        },
        {
          "s": 28,
          "text": "נמשך גילוי אלקות בהתחתון"
        },
        {
          "s": 29,
          "text": "(כח המעשה)"
        },
        {
          "s": 30,
          "text": "שבאדם,"
        },
        {
          "s": 31,
          "text": "וע\"י פעולת כח המעשה של האדם בדבר הגשמי שחוץ ממנו נמשך הכח גם בדבר הגשמי,"
        },
        {
          "s": 32,
          "text": "וכידוע110"
        },
        {
          "s": 33,
          "text": "שהה\"מ הכיר בכלי את כח האומן,"
        },
        {
          "s": 34,
          "text": "כח הפועל בנפעל"
        },
        {
          "s": 35,
          "text": "(אף שעשיית הכלי היא יש מיש),"
        },
        {
          "s": 36,
          "text": "ועי\"ז נעשה גם הדבר הגשמי"
        },
        {
          "s": 37,
          "text": "(תחתון שבעולם)"
        },
        {
          "s": 38,
          "text": "דירה לו ית',"
        },
        {
          "s": 39,
          "text": "ועי\"ז נשלמת הכוונה דנתאוה הקב\"ה להיות לו ית' דירה בתחתונים,"
        },
        {
          "s": 40,
          "text": "דזה שנתאוה הוא למעלה מטו\"ד,"
        },
        {
          "s": 41,
          "text": "וכידוע מאמר רבינו הזקן111"
        },
        {
          "s": 42,
          "text": "אויף אַ תאוה איז קיין קשיא."
        },
        {
          "s": 43,
          "text": "ועי\"ז נעשה היש הגשמי מציאות אמיתית,"
        },
        {
          "s": 44,
          "text": "וכמו שמבאר כ\"ק אדמו\"ר מהר\"ש"
        },
        {
          "s": 45,
          "text": "[במאמרו112"
        },
        {
          "s": 46,
          "text": "שהי' אומר מזמן לזמן כדי לטהר את אויר העולם113],"
        },
        {
          "s": 47,
          "text": "שמציאות העולם וכל מה שנברא בו הוא לא דמיון ואחיזת עינים כ\"א הוא מציאות באמת."
        },
        {
          "s": 48,
          "text": "ומביא ראי' על זה מפסק הלכה."
        },
        {
          "s": 49,
          "text": "והיינו,"
        },
        {
          "s": 50,
          "text": "דהגם שהיש מתהווה תמיד מהאין ובטל אליו,"
        },
        {
          "s": 51,
          "text": "מ\"מ הוא מציאות באמת,"
        },
        {
          "s": 52,
          "text": "דמכיון שמאמיתת המצאו נמצאו כל הנמצאים114,"
        },
        {
          "s": 53,
          "text": "הרי מציאותם של כל הנמצאים היא אמיתית המצאו ית',"
        },
        {
          "s": 54,
          "text": "וכמו שמבאר כ\"ק אדמו\"ר האמצעי בביאורי הזהר115"
        },
        {
          "s": 55,
          "text": "דאמיתית מציאותו של היש הגשמי הוא היש האמיתי."
        }
      ]
    }
  ]
}