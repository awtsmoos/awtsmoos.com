{
  "globalIndex": 979,
  "owner": 29,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919556_theRebbe_605__p005",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919556_theRebbe_605__p005",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919556_theRebbe_605",
  "title": "מאמר אלה מסעי תשי\"ג",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וזהו79 מש\"נ ואלה מסעי בני ישראל אשר יצאו מארץ מצרים,"
        },
        {
          "s": 2,
          "text": "דהנה,"
        },
        {
          "s": 3,
          "text": "כל הגליות80"
        },
        {
          "s": 4,
          "text": "נקראו מצרים,"
        },
        {
          "s": 5,
          "text": "מצרים לשון מיצר וגבול,"
        },
        {
          "s": 6,
          "text": "ועד שבאים81"
        },
        {
          "s": 7,
          "text": "לירדן ירחו,"
        },
        {
          "s": 8,
          "text": "ירחו לשון ריח,"
        },
        {
          "s": 9,
          "text": "עבודה שלמעלה מטעם ודעת,"
        },
        {
          "s": 10,
          "text": "ה\"ז עדיין בחי' מיצר וגבול,"
        },
        {
          "s": 11,
          "text": "ובגאולה העתידה ע\"י משיח צדקנו יתגלה בחי' זו,"
        },
        {
          "s": 12,
          "text": "וכדכתיב82"
        },
        {
          "s": 13,
          "text": "עליו אשר לא למשמע אזניו יוכיח ואפילו לא למראה עיניו כ\"א והריחו ביראת הוי' דמורח ודאין83,"
        },
        {
          "s": 14,
          "text": "מקיפים שלמעלה מחו\"ב,"
        },
        {
          "s": 15,
          "text": "ועד שבאין לזה הוא ענין המסעות."
        },
        {
          "s": 16,
          "text": "והעבודה שבהמסעות היינו בירידת הנשמה והתלבשותה במיצר הגוף בכלל,"
        },
        {
          "s": 17,
          "text": "ובפרט בזמן המצרים ההעלמות וההסתרים שבהגליות,"
        },
        {
          "s": 18,
          "text": "הנה הנתינת כח על זה הוא מבחי' מוצאיהם,"
        },
        {
          "s": 19,
          "text": "לשון וכמוצא מים אשר לא יכזבו מימיו84,"
        },
        {
          "s": 20,
          "text": "שרש ועצם הנשמה,"
        },
        {
          "s": 21,
          "text": "מ\"ה שבנשמה,"
        },
        {
          "s": 22,
          "text": "וע\"י המשכה ממוצאיהם למסעיהם,"
        },
        {
          "s": 23,
          "text": "שנעשה זה ע\"י בחי' משה שבכאו\"א מישראל,"
        },
        {
          "s": 24,
          "text": "ויכתוב משה,"
        },
        {
          "s": 25,
          "text": "נתגלה בחי' מ\"ה גם בהנשמה שבגוף ועי\"ז עובד עבודתו."
        },
        {
          "s": 26,
          "text": "והעבודה היא הנסיעה והעלאה ממטה למעלה,"
        },
        {
          "s": 27,
          "text": "מסעיהם למוצאיהם."
        },
        {
          "s": 28,
          "text": "ואין מקרא יוצא מידי פשוטו85,"
        },
        {
          "s": 29,
          "text": "המסעות של דור המדבר במדבר העמים,"
        },
        {
          "s": 30,
          "text": "כי מה שיש יכולת לאדם להמשיך מ\"ה דבנשמה בגילוי ולהתגבר על גופו ונפשו הבהמית,"
        },
        {
          "s": 31,
          "text": "ובפרט בזמן הגלות ודרא דעקבתא דמשיחא,"
        },
        {
          "s": 32,
          "text": "חשך כפול ומכופל,"
        },
        {
          "s": 33,
          "text": "זמן הנסיונות וכו' כנ\"ל,"
        },
        {
          "s": 34,
          "text": "הוא ע\"י מעשה אבות שהכניעו מקור הקליפות ע\"י שנסעו וחנו במדבר העמים נחש שרף ועקרב,"
        },
        {
          "s": 35,
          "text": "ויהי בנסוע גו' ויאמר משה גו' ויפצו אויביך וינוסו משנאיך גו'86,"
        },
        {
          "s": 36,
          "text": "לכן גם הענפים יהיו נכנעים אח\"כ ע\"י האדם במשך כל הדורות,"
        },
        {
          "s": 37,
          "text": "ע\"י אשר ויכתוב משה שבכאו\"א את מוצאיהם למסעיהם ואלה מסעיהם למוצאיהם,"
        },
        {
          "s": 38,
          "text": "והיינו ע\"ד כלל ופרט,"
        },
        {
          "s": 39,
          "text": "עד אשר יבואו לירדן ירחו,"
        },
        {
          "s": 40,
          "text": "מורח ודאין בעבודתו בפרט87,"
        },
        {
          "s": 41,
          "text": "ואח\"כ לגאולה הכללית ביאת משיח צדקנו אשר לא למשמע אזניו יוכיח ולא למראה עיניו ישפוט כי אם והריחו ביראת הוי' דמורח ודאין,"
        },
        {
          "s": 42,
          "text": "בגאולה העתידה לבוא במהרה בימינו."
        }
      ]
    }
  ]
}