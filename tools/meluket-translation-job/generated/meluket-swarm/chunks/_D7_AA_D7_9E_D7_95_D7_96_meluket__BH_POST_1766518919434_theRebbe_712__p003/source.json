{
  "globalIndex": 961,
  "owner": 11,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919434_theRebbe_712__p003",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919434_theRebbe_712__p003",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919434_theRebbe_712",
  "title": "מאמר וחזקת והיית לאיש תשכ\"ח",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "וזהו מ\"ש ואתה מחי' את כולם,"
        },
        {
          "s": 1,
          "text": "ואתה בתוס' וא\"ו,"
        },
        {
          "s": 2,
          "text": "שמורה על הגילוי דעצמות אוא\"ס שבקו האמצעי"
        },
        {
          "s": 3,
          "text": "(ת\"ת)"
        },
        {
          "s": 4,
          "text": "שמחבר שני ההפכים דחסד וגבורה."
        },
        {
          "s": 5,
          "text": "וכידוע29"
        },
        {
          "s": 6,
          "text": "בענין הגדול הגבור והנורא30"
        },
        {
          "s": 7,
          "text": "שהם בג' הקוין חג\"ת,"
        },
        {
          "s": 8,
          "text": "דמ\"ש והנורא בתוס' וא\"ו הוא כי בת\"ת ישנו הגילוי דעצמות אוא\"ס שלמעלה מהתחלקות קוין"
        },
        {
          "s": 9,
          "text": "(א-ל עליון31),"
        },
        {
          "s": 10,
          "text": "ועי\"ז הוא מחבר שני ההפכים דחו\"ג."
        },
        {
          "s": 11,
          "text": "וזהו גם מהביאורים בזה שיעקב"
        },
        {
          "s": 12,
          "text": "(ת\"ת)"
        },
        {
          "s": 13,
          "text": "הוא אותיות יבקע32,"
        },
        {
          "s": 14,
          "text": "אז יבקע כשחר אורך33,"
        },
        {
          "s": 15,
          "text": "כי זה שהאור"
        },
        {
          "s": 16,
          "text": "(אור הקו)"
        },
        {
          "s": 17,
          "text": "בוקע את חושך הצמצום"
        },
        {
          "s": 18,
          "text": "(ונמשך גם בעולמות שנתהוו מהצמצום)"
        },
        {
          "s": 19,
          "text": "הוא מפני ששרש המשכתו הוא מת\"ת"
        },
        {
          "s": 20,
          "text": "(הנעלם),"
        },
        {
          "s": 21,
          "text": "מדתו של יעקב."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה ידוע שהמשכת הקו מסתיימת באצילות34,"
        },
        {
          "s": 2,
          "text": "וכמבואר בהמאמר35,"
        },
        {
          "s": 3,
          "text": "דזה שיעקב"
        },
        {
          "s": 4,
          "text": "(אותיות יבקע,"
        },
        {
          "s": 5,
          "text": "בקיעת הקו)"
        },
        {
          "s": 6,
          "text": "הוא בריח התיכון המבריח מן הקצה אל הקצה36,"
        },
        {
          "s": 7,
          "text": "הוא מקצה השמים דלעילא עד קצה השמים דלתתא."
        },
        {
          "s": 8,
          "text": "דקצה השמים דלתתא הוא סוף האצילות."
        },
        {
          "s": 9,
          "text": "ובכדי שיהי' הגילוי גם בבי\"ע,"
        },
        {
          "s": 10,
          "text": "הוא ע\"י יוסף,"
        },
        {
          "s": 11,
          "text": "כמ\"ש37"
        },
        {
          "s": 12,
          "text": "ויוסף הוא השליט על הארץ,"
        },
        {
          "s": 13,
          "text": "שע\"י יוסף נמשך הגילוי בארץ,"
        },
        {
          "s": 14,
          "text": "בי\"ע."
        },
        {
          "s": 15,
          "text": "וזהו אלה תולדות יעקב יוסף38,"
        },
        {
          "s": 16,
          "text": "דיוסף ממשיך הגילויים דיעקב שיאירו בבי\"ע."
        },
        {
          "s": 17,
          "text": "וע\"ד ההפרש בין האבות ומתן תורה"
        },
        {
          "s": 18,
          "text": "(דיוסף שייך למתן תורה,"
        },
        {
          "s": 19,
          "text": "כי מתן תורה הי' ע\"י משה שמשה ויקח משה את עצמות יוסף עמו39),"
        },
        {
          "s": 20,
          "text": "דההמשכה שע\"י קיום המצוות דהאבות היתה באצילות,"
        },
        {
          "s": 21,
          "text": "ובמ\"ת נתחדש שיומשך הגילוי גם בבי\"ע40."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "והנה מזה שאומר בהמאמר שיוסף ממשיך הגילויים דיעקב שיאירו בבי\"ע,"
        },
        {
          "s": 1,
          "text": "משמע,"
        },
        {
          "s": 2,
          "text": "דזה שיוסף ממשיך הגילוי בבי\"ע הוא לפי שיוסף הוא תולדות יעקב,"
        },
        {
          "s": 3,
          "text": "היינו שעל ידו מתגלה הפנימיות דיעקב אותיות יבקע."
        },
        {
          "s": 4,
          "text": "כי מצד ענין הבקיעה"
        },
        {
          "s": 5,
          "text": "(דאמיתית ענין הבקיעה הוא שאין בה מדידות והגבלות)"
        },
        {
          "s": 6,
          "text": "אפשר להיות ההמשכה גם בבי\"ע,"
        },
        {
          "s": 7,
          "text": "אלא שענין זה דיעקב"
        },
        {
          "s": 8,
          "text": "(יבקע)"
        },
        {
          "s": 9,
          "text": "נתגלה ע\"י יוסף."
        }
      ]
    }
  ]
}