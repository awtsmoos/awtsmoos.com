{
  "globalIndex": 156,
  "owner": 6,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914597_theRebbe_351__p003",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914597_theRebbe_351__p003",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914597_theRebbe_351",
  "title": "מאמר אלה תולדות נח תנש\"א",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וע\"פ הידוע40"
        },
        {
          "s": 2,
          "text": "בפירוש כי מאתך היא מנוחתם"
        },
        {
          "s": 3,
          "text": "(שאומרים במנחת שבת),"
        },
        {
          "s": 4,
          "text": "שמנוחתם הבאה מאתך,"
        },
        {
          "s": 5,
          "text": "מאתך ממש,"
        },
        {
          "s": 6,
          "text": "היא המנוחה"
        },
        {
          "s": 7,
          "text": "(דשבת)"
        },
        {
          "s": 8,
          "text": "שבעשי' בפועל"
        },
        {
          "s": 9,
          "text": "(שביתה ממלאכה בגשמיות),"
        },
        {
          "s": 10,
          "text": "שבה כל ישראל שוים,"
        },
        {
          "s": 11,
          "text": "יש לומר,"
        },
        {
          "s": 12,
          "text": "שעד\"ז הוא בהענין דקיום המצוה מצד המצוה עצמה,"
        },
        {
          "s": 13,
          "text": "צוותא וחיבור עם אוא\"ס מצַוה המצוה,"
        },
        {
          "s": 14,
          "text": "דענין זה מתגלה בעיקר בקיום המצוות בעשי' בפועל,"
        },
        {
          "s": 15,
          "text": "שכל ישראל שוים בזה."
        },
        {
          "s": 16,
          "text": "והענין הוא,"
        },
        {
          "s": 17,
          "text": "דהטעם האמיתי לזה שישראל מקיים מצוה"
        },
        {
          "s": 18,
          "text": "(גם כשאין לו חיות בזה)"
        },
        {
          "s": 19,
          "text": "הוא,"
        },
        {
          "s": 20,
          "text": "מפני שכל אחד מישראל בעצם מהותו הוא רוצה לעשות כל מה שהוא רצון ה'41."
        },
        {
          "s": 21,
          "text": "דרצון זה שמצד עצם הנשמה הוא הסיבה האמיתית לזה שרוצה בגילוי לעשות את המצוה"
        },
        {
          "s": 22,
          "text": "[אלא שברצון הגלוי שלו אינו נרגש שסיבתו הוא הרצון שמצד עצם הנשמה,"
        },
        {
          "s": 23,
          "text": "ולכן נדמה לו שקיום המצוה שלו הוא מפני ההרגל,"
        },
        {
          "s": 24,
          "text": "או בשביל איזו פני']."
        },
        {
          "s": 25,
          "text": "ויתירה מזו יש לומר,"
        },
        {
          "s": 26,
          "text": "דגם כשעושה שלא במתכוין"
        },
        {
          "s": 27,
          "text": "(נפלה סלע מידו ומצאה עני42),"
        },
        {
          "s": 28,
          "text": "הסיבה האמיתית לזה הוא הרצון דעצם הנשמה לעשות את רצון ה'43."
        },
        {
          "s": 29,
          "text": "כי עצם הנשמה היא למעלה מידיעה,"
        },
        {
          "s": 30,
          "text": "ולכן פעולת הרצון דעצם הנשמה על כח המעשה הוא גם כשאינו יודע מזה."
        },
        {
          "s": 31,
          "text": "וזהו שהענין דקיום המצוה באופן דצוותא וחיבור עם עצמות אוא\"ס מצַוה המצוה מתגלה בעיקר במעשה המצוה,"
        },
        {
          "s": 32,
          "text": "כי הסיבה האמיתית לזה שעושה את המצוה הוא לפי שנתגלה בו הרצון שמצד עצם הנשמה שקשורה עם עצמות אוא\"ס."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ויש להוסיף,"
        },
        {
          "s": 1,
          "text": "שגם בקיום המצוות באופן זה ישנו הענין דזכור ושמור בדיבור אחד."
        },
        {
          "s": 2,
          "text": "דכיון שהסיבה האמיתית לזה שעושה את המצוה הוא לפי שמתגלה בו הרצון דעצם הנשמה,"
        },
        {
          "s": 3,
          "text": "הרי המצוה שנעשית היא מצוה בשלימות,"
        },
        {
          "s": 4,
          "text": "שיש בה גוף"
        },
        {
          "s": 5,
          "text": "(מעשה המצוה44)"
        },
        {
          "s": 6,
          "text": "ונשמה"
        },
        {
          "s": 7,
          "text": "(כוונת המצוה44,"
        },
        {
          "s": 8,
          "text": "שמצד הרצון דעצם הנשמה)."
        },
        {
          "s": 9,
          "text": "[אלא שהגוף דהמצוה הוא בגילוי והנשמה דהמצוה היא בהעלם]."
        },
        {
          "s": 10,
          "text": "וכיון ששני הענינים"
        },
        {
          "s": 11,
          "text": "[הכוונה והמעשה]"
        },
        {
          "s": 12,
          "text": "הם מצד עצם הנשמה שלמעלה מהתחלקות,"
        },
        {
          "s": 13,
          "text": "לכן הם כולא חד,"
        },
        {
          "s": 14,
          "text": "זכור ושמור בדיבור אחד."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "וזהו אלה תולדות נח נח,"
        },
        {
          "s": 2,
          "text": "דהטעם לזה שאומר נח נח שתי פעמים גבי תולדות נח,"
        },
        {
          "s": 3,
          "text": "הוא,"
        },
        {
          "s": 4,
          "text": "כי אמיתית הענין דנח נח שתי פעמים הוא,"
        },
        {
          "s": 5,
          "text": "ששני הענינים דנייחא לעליונים ונייחא לתחתונים הם נקודה אחת שכוללת שניהם45,"
        },
        {
          "s": 6,
          "text": "וגילוי ענין זה הוא בעיקר בתולדות נח,"
        },
        {
          "s": 7,
          "text": "דתולדותיהם של צדיקים הם מעשים טובים46,"
        },
        {
          "s": 8,
          "text": "כנ\"ל"
        },
        {
          "s": 9,
          "text": "(סעיף ד)"
        },
        {
          "s": 10,
          "text": "שאמיתית הענין דזכור ושמור בדיבור אחד הוא במעשה המצוות."
        }
      ]
    }
  ]
}