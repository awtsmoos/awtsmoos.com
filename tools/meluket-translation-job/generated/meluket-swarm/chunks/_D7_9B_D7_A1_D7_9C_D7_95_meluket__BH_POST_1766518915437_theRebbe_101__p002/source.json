{
  "globalIndex": 290,
  "owner": 40,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915437_theRebbe_101__p002",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915437_theRebbe_101__p002",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915437_theRebbe_101",
  "title": "מאמר אשר ברא תשל\"ט",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "והנה ע\"י עסק התורה פועלים גם בהעולם שיהי' כלי לאלקות."
        },
        {
          "s": 1,
          "text": "דע\"י שהתורה נסעה וירדה כו' עד שנתלבשה בדברים גשמיים בכדי שיוכל האדם לתפוס אותה במחשבה דיבור ומעשה שלו19,"
        },
        {
          "s": 2,
          "text": "הנה עי\"ז ממשיכים גם בהעולם."
        },
        {
          "s": 3,
          "text": "דהנה ידוע20"
        },
        {
          "s": 4,
          "text": "שעשרה מאמרות שבהם נברא העולם21"
        },
        {
          "s": 5,
          "text": "הם מכוונים כנגד עשרת הדברות,"
        },
        {
          "s": 6,
          "text": "כדאיתא בזהר22"
        },
        {
          "s": 7,
          "text": "עה\"פ23"
        },
        {
          "s": 8,
          "text": "עשרה עשרה הכף בשקל הקודש,"
        },
        {
          "s": 9,
          "text": "ולכן ע\"י עסק התורה"
        },
        {
          "s": 10,
          "text": "(עשרת הדברות)"
        },
        {
          "s": 11,
          "text": "פועלים בהעשרה מאמרות,"
        },
        {
          "s": 12,
          "text": "שגם הם יהיו בשקל הקודש24."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דזה שעשרה מאמרות ועשרת הדברות שקולים זה כנגד זה,"
        },
        {
          "s": 2,
          "text": "הכוונה בזה היא גם שכל אחד פועל בהשני."
        },
        {
          "s": 3,
          "text": "דכמו שעשרת הדברות פועלים"
        },
        {
          "s": 4,
          "text": "(כנ\"ל)"
        },
        {
          "s": 5,
          "text": "בהעשרה מאמרות,"
        },
        {
          "s": 6,
          "text": "וכמאמר25"
        },
        {
          "s": 7,
          "text": "אסתכל באורייתא וברא עלמא,"
        },
        {
          "s": 8,
          "text": "שבריאת העולם היא ע\"י העשרה מאמרות כמו שהם בתורה26,"
        },
        {
          "s": 9,
          "text": "שירדו אח\"כ בבחי' מילין דהדיוטא27"
        },
        {
          "s": 10,
          "text": "להוות את העולם,"
        },
        {
          "s": 11,
          "text": "עד\"ז הוא לאידך,"
        },
        {
          "s": 12,
          "text": "שעבודת האדם בעניני העולם שנברא בהעשרה מאמרות מילין דהדיוטא פועלת בעשרת הדברות"
        },
        {
          "s": 13,
          "text": "[שלכן יש פירוש28"
        },
        {
          "s": 14,
          "text": "במאמר הזהר עה\"פ עשרה עשרה גו',"
        },
        {
          "s": 15,
          "text": "שעשרה מאמרות הם גבוהים מעשרת הדברות]."
        },
        {
          "s": 16,
          "text": "וי\"ל שהוא ע\"פ המבואר באגה\"ק29"
        },
        {
          "s": 17,
          "text": "שבירור הלכה בתורה הוא ע\"י נשמה בגוף דוקא,"
        },
        {
          "s": 18,
          "text": "ולכן באים העליונים לשמוע חידושי תורה מהתחתונים"
        },
        {
          "s": 19,
          "text": "(וכמרז\"ל30"
        },
        {
          "s": 20,
          "text": "עה\"פ31"
        },
        {
          "s": 21,
          "text": "חברים מקשיבים לקולך)."
        },
        {
          "s": 22,
          "text": "ועד שהקב\"ה אומר למלאכי השרת לי מה אתם שואלים אני ואתם נלך אצל ב\"ד של מטה32."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ועד\"ז הוא גם בחתן וכלה,"
        },
        {
          "s": 1,
          "text": "דעם היות שהחתן וכלה שלמטה משתלשלים מבחי' חתן וכלה שלמעלה,"
        },
        {
          "s": 2,
          "text": "שענינם בספירות הוא ז\"א ומלכות33,"
        },
        {
          "s": 3,
          "text": "ולמעלה יותר קוב\"ה ושכינתי'"
        },
        {
          "s": 4,
          "text": "(חתן וכלה)"
        },
        {
          "s": 5,
          "text": "הו\"ע אוא\"ס שלפני הצמצום והקו כמבואר בארוכה בדרושי כ\"ק אדמו\"ר מהר\"ש34,"
        },
        {
          "s": 6,
          "text": "ועד שהענין דקוב\"ה ושכינתי' הוא גם לפני הצמצום35,"
        },
        {
          "s": 7,
          "text": "מ\"מ,"
        },
        {
          "s": 8,
          "text": "ע\"י העבודה למטה דוקא"
        },
        {
          "s": 9,
          "text": "(ובפרטיות ע\"י שמחת חתן וכלה שלמטה)"
        },
        {
          "s": 10,
          "text": "ממשיכים תוספת אור בחתן וכלה שלמעלה גם כמו שהם בשרשם הראשון לפני הצמצום."
        },
        {
          "s": 11,
          "text": "וע\"ד שע\"י עסק התורה והמצוות שלמטה דוקא נעשה יחוד קוב\"ה ושכינתי'36"
        },
        {
          "s": 12,
          "text": "כמבואר בתניא37,"
        },
        {
          "s": 13,
          "text": "גם כמו שהם למעלה מעלה."
        }
      ]
    }
  ]
}