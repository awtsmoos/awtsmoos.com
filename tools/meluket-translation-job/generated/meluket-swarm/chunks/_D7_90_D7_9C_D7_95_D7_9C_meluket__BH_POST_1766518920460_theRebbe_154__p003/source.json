  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920460_theRebbe_154__p003",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920460_theRebbe_154__p003",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920460_theRebbe_154",
  "title": "מאמר אתם נצבים תשל\"ט",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "וזהו אתם נצבים היום כולכם גו',"
        },
        {
          "s": 2,
          "text": "שכל ניצוצי נשמות"
        },
        {
          "s": 3,
          "text": "(מראשיכם שבטיכם עד חוטב עציך ושואב מימיך)"
        },
        {
          "s": 4,
          "text": "נצבים ומתעלים במקורם הראשון עד לפני הוי'11"
        },
        {
          "s": 5,
          "text": "ועד שהם נעשים חד ממש עם"
        },
        {
          "s": 6,
          "text": "(בחינת)"
        },
        {
          "s": 7,
          "text": "לפני הוי'"
        },
        {
          "s": 8,
          "text": "(כנ\"ל בענין לעברך בברית),"
        },
        {
          "s": 9,
          "text": "ישראל ומלכא בלחודוהי42,"
        },
        {
          "s": 10,
          "text": "ועי\"ז הם גם נצבים"
        },
        {
          "s": 11,
          "text": "(כפירוש הבעש\"ט43)"
        },
        {
          "s": 12,
          "text": "קיימים ועומדים היינו שזוכים בדין,"
        },
        {
          "s": 13,
          "text": "ולא רק בנוגע לענינים רוחניים"
        },
        {
          "s": 14,
          "text": "(משפט לאלקי יעקב44)"
        },
        {
          "s": 15,
          "text": "אלא גם בנוגע לענינים גשמיים"
        },
        {
          "s": 16,
          "text": "(חק לישראל44),"
        },
        {
          "s": 17,
          "text": "ואדרבה עיקר הדין בר\"ה"
        },
        {
          "s": 18,
          "text": "(ומה שזוכים בדין)"
        },
        {
          "s": 19,
          "text": "הוא בנוגע לענינים גשמיים45,"
        },
        {
          "s": 20,
          "text": "שלכאו\"א מישראל יהי' כתיבה וחתימה טובה לשנה טובה ומתוקה בטוב הנראה והנגלה,"
        },
        {
          "s": 21,
          "text": "בבני חיי ומזוני,"
        },
        {
          "s": 22,
          "text": "ובכולם רויחי."
        }
      ]
    }
  ]
}