{
  "globalIndex": 322,
  "owner": 22,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915617_theRebbe_822__p001",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915617_theRebbe_822__p001",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915617_theRebbe_822",
  "title": "מאמר ברוך שעשה ניסים תשט\"ו",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ וישב,"
        },
        {
          "s": 2,
          "text": "מבה\"ח טבת ה'תשט\"ו*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "ברוך שעשה נסים לאבותינו בימים ההם בזמן הזה1,"
        },
        {
          "s": 1,
          "text": "ומבאר אדמו\"ר"
        },
        {
          "s": 2,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 3,
          "text": "נ\"ע במאמרו ד\"ה זה2,"
        },
        {
          "s": 4,
          "text": "דנסים לשון רבים הם"
        },
        {
          "s": 5,
          "text": "(נוסף על נסים רבים,"
        },
        {
          "s": 6,
          "text": "גם)"
        },
        {
          "s": 7,
          "text": "ריבוי סוגי נסים."
        },
        {
          "s": 8,
          "text": "וצריך להבין,"
        },
        {
          "s": 9,
          "text": "דענין הריבוי"
        },
        {
          "s": 10,
          "text": "(התחלקות)"
        },
        {
          "s": 11,
          "text": "הוא בהשתלשלות,"
        },
        {
          "s": 12,
          "text": "וכיון ששרש הנסים הוא למעלה מהשתלשלות,"
        },
        {
          "s": 13,
          "text": "כמו שנתבאר לעיל בד\"ה פתח אלי'3"
        },
        {
          "s": 14,
          "text": "שהשרש דהנהגה טבעית היא מבחינת השתלשלות ושרש הנסים הוא מלמעלה מהשתלשלות,"
        },
        {
          "s": 15,
          "text": "מהו ענין הריבוי"
        },
        {
          "s": 16,
          "text": "(התחלקות מדריגות)"
        },
        {
          "s": 17,
          "text": "בנסים."
        },
        {
          "s": 18,
          "text": "גם צריך להבין מה שמבאר במאמר הנ\"ל בסיומו בפירוש נסים לאבותינו,"
        },
        {
          "s": 19,
          "text": "דאבותינו הם חכמה ובינה4"
        },
        {
          "s": 20,
          "text": "ונס הוא מלשון הרמה כמו ארים נסי5,"
        },
        {
          "s": 21,
          "text": "וענין נסים לאבותינו הוא הרמה ועלי' בחו\"ב."
        },
        {
          "s": 22,
          "text": "וצריך ביאור,"
        },
        {
          "s": 23,
          "text": "מהו ענין העלי' בחו\"ב."
        },
        {
          "s": 24,
          "text": "וגם,"
        },
        {
          "s": 25,
          "text": "מהי השייכות דההרמה ועלי' בחו\"ב לנסים כפשוטם."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ונקודת הביאור בזה,"
        },
        {
          "s": 2,
          "text": "דשרש שתי ההנהגות"
        },
        {
          "s": 3,
          "text": "(הנהגה טבעית והנהגה נסית)"
        },
        {
          "s": 4,
          "text": "הוא מיחוד חו\"ב,"
        },
        {
          "s": 5,
          "text": "שביחוד חו\"ב שני ענינים6."
        },
        {
          "s": 6,
          "text": "זיווג חיצוני דחו\"ב,"
        },
        {
          "s": 7,
          "text": "דזיווג זה הוא תדיר7"
        },
        {
          "s": 8,
          "text": "לצורך קיום העולמות,"
        },
        {
          "s": 9,
          "text": "והוא שרש הנהגת הטבע8."
        },
        {
          "s": 10,
          "text": "דכיון שזיווג זה הוא לצורך"
        },
        {
          "s": 11,
          "text": "(קיום)"
        },
        {
          "s": 12,
          "text": "העולמות,"
        },
        {
          "s": 13,
          "text": "לכן הנהגת העולם הנמשכת מבחינה זו היא שהקב\"ה מנהיג את הנבראים שבעולם לפי ענינם,"
        },
        {
          "s": 14,
          "text": "כל נברא לפי תכונתו וטבעו."
        },
        {
          "s": 15,
          "text": "והשרש דהנהגה נסית"
        },
        {
          "s": 16,
          "text": "[שהקב\"ה מנהיג את העולם כפי רצונו ולא כפי תכונת וטבע העולם]"
        },
        {
          "s": 17,
          "text": "הוא מזיווג פנימי דחו\"ב8."
        },
        {
          "s": 18,
          "text": "וזהו הקשר דנסים לאבותינו להפירוש שקאי על הרמת ועליית חו\"ב עם נסים כפשוטם"
        },
        {
          "s": 19,
          "text": "(שינוי הטבע),"
        },
        {
          "s": 20,
          "text": "כי הנהגת העולם שנמשכת מחו\"ב כמו שהם מצד עצמם"
        },
        {
          "s": 21,
          "text": "(כולל גם כמו שהם מזדווגים בזיווג חיצוני)"
        },
        {
          "s": 22,
          "text": "היא הנהגה טבעית,"
        },
        {
          "s": 23,
          "text": "והמשכת הנסים"
        },
        {
          "s": 24,
          "text": "(שינוי הטבע)"
        },
        {
          "s": 25,
          "text": "היא ע\"י שנעשה הרמה ועלי' בחו\"ב,"
        },
        {
          "s": 26,
          "text": "שמזדווגים בזיווג פנימי."
        }
      ]
    }
  ]
}