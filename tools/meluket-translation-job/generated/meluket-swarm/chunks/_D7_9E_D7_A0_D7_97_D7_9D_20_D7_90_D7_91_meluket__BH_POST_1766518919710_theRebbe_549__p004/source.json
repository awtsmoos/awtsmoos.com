{
  "globalIndex": 999,
  "owner": 49,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919710_theRebbe_549__p004",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919710_theRebbe_549__p004",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919710_theRebbe_549",
  "title": "מאמר ציון במשפט תפדה תשל\"ו",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ויש לקשר זה עם מ\"ש בהפטרה דשבת חזון43"
        },
        {
          "s": 2,
          "text": "ידע שור קונהו גו' ישראל לא ידע עמי לא התבונן,"
        },
        {
          "s": 3,
          "text": "ופירש האריז\"ל44"
        },
        {
          "s": 4,
          "text": "[שהיום הוא ערב יום ההילולא שלו45],"
        },
        {
          "s": 5,
          "text": "דשור קאי על העגל שעשו הערב רב במדבר,"
        },
        {
          "s": 6,
          "text": "ע\"י שהשליכו הטס שכתב בו משה עלה שור בכדי להעלות ארונו של יוסף46."
        },
        {
          "s": 7,
          "text": "ומבאר,"
        },
        {
          "s": 8,
          "text": "דבטס זה הי' כתוב השם יל\"י"
        },
        {
          "s": 9,
          "text": "(שם השני של השם בן ע\"ב שמות),"
        },
        {
          "s": 10,
          "text": "שהוא הממונה על כח השור העליון."
        },
        {
          "s": 11,
          "text": "וזהו ידע שור קונהו גו' ישראל לא ידע גו',"
        },
        {
          "s": 12,
          "text": "שהשור עצמו ידע שהוא משם קדוש,"
        },
        {
          "s": 13,
          "text": "וישראל לא ידע עמי לא התבונן,"
        },
        {
          "s": 14,
          "text": "לא ידעו ולא התבוננו בזה,"
        },
        {
          "s": 15,
          "text": "ואמרו שהעגל עלה מעצמו ולכן טעו אחריו."
        },
        {
          "s": 16,
          "text": "וזהו שהר\"ת של ישראל לא ידע עמי לא התבונן הוא יל\"י על\"ה,"
        },
        {
          "s": 17,
          "text": "שלא ידעו ולא התבוננו דזה שעל\"ה"
        },
        {
          "s": 18,
          "text": "(השור)"
        },
        {
          "s": 19,
          "text": "הוא ע\"י שם יל\"י,"
        },
        {
          "s": 20,
          "text": "ולכן אמרו שעלה מעצמו."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דפירוש זה בישראל לא ידע עמי לא התבונן הוא לימוד זכות על ישראל."
        },
        {
          "s": 2,
          "text": "שהסיבה לזה שטעו אחרי העגל,"
        },
        {
          "s": 3,
          "text": "היתה מפני שלא התבוננו בהענינים"
        },
        {
          "s": 4,
          "text": "(השם יל\"י)"
        },
        {
          "s": 5,
          "text": "שלמעלה מהעולם,"
        },
        {
          "s": 6,
          "text": "היינו שגם אז עבדו את הוי',"
        },
        {
          "s": 7,
          "text": "אלא שכיון שאז הי' לפני הציווי דבכל יום יהיו בעיניך כחדשים47,"
        },
        {
          "s": 8,
          "text": "לכן היתה עבודתם בהגבלה,"
        },
        {
          "s": 9,
          "text": "שלכן,"
        },
        {
          "s": 10,
          "text": "הגילוי שהאיר להם אז הוא רק האור שמלובש בהעולם."
        },
        {
          "s": 11,
          "text": "ומזה נשתלשל שטעו אחרי העגל48."
        },
        {
          "s": 12,
          "text": "וזהו גם שחטא העגל גרם לשבירת הלוחות שעי\"ז נעשה האפשרות דשכחת התורה49,"
        },
        {
          "s": 13,
          "text": "היינו שגם לאחרי החטא נשאר הקשר שלהם עם התורה,"
        },
        {
          "s": 14,
          "text": "ורק שלימוד התורה שלאחרי שבירת הלוחות הוא בהגבלה שלכן שייך בזה הפסק"
        },
        {
          "s": 15,
          "text": "(שכחה)."
        },
        {
          "s": 16,
          "text": "ועי\"ז נעשה אפשרות שתהי' אומה ולשון שולטת בהם50,"
        },
        {
          "s": 17,
          "text": "כי כשהגילוי הוא רק מבחינת המלכות,"
        },
        {
          "s": 18,
          "text": "יש נתינת מקום לגלות,"
        },
        {
          "s": 19,
          "text": "כנ\"ל."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "וזהו מ\"ש51"
        },
        {
          "s": 2,
          "text": "זכור הוי' מה הי' לנו,"
        },
        {
          "s": 3,
          "text": "ומבאר הצ\"צ52"
        },
        {
          "s": 4,
          "text": "דמה הוא שם הוי'"
        },
        {
          "s": 5,
          "text": "(במילוי אלפי\"ן בגימטריא מ\"ה)"
        },
        {
          "s": 6,
          "text": "ולנו הוא בגימטריא אלקים,"
        },
        {
          "s": 7,
          "text": "ופירוש מה הי' לנו הוא,"
        },
        {
          "s": 8,
          "text": "שהוי' נעשה בבחינת אלקים."
        },
        {
          "s": 9,
          "text": "ויש לומר,"
        },
        {
          "s": 10,
          "text": "דענין מה הי' לנו בעבודת האדם הוא,"
        },
        {
          "s": 11,
          "text": "דהוי' הוא למעלה מהטבע ואלקים בגימטריא הטבע53,"
        },
        {
          "s": 12,
          "text": "שגם כשישנה לאדם הצלחה שלמעלה מהטבע הוא חושב שזה טבע."
        },
        {
          "s": 13,
          "text": "ויתירה מזו,"
        },
        {
          "s": 14,
          "text": "שלפעמים,"
        },
        {
          "s": 15,
          "text": "ההצלחה שלמעלה מהטבע גורמת לו לחשוב שכחו ועוצם ידו עשה לו את החיל הזה54"
        },
        {
          "s": 16,
          "text": "[וע\"ד שהי' בעגל,"
        },
        {
          "s": 17,
          "text": "דזה שע\"י השם יל\"י נעשה עליית השור"
        },
        {
          "s": 18,
          "text": "(ענין שלמעלה מהטבע)"
        },
        {
          "s": 19,
          "text": "הביא אותם לחשוב שעלה מעצמו]."
        }
      ]
    }
  ]
}