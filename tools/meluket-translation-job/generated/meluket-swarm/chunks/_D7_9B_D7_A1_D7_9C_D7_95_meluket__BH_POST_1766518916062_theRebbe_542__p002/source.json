{
  "globalIndex": 403,
  "owner": 3,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518916062_theRebbe_542__p002",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518916062_theRebbe_542__p002",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518916062_theRebbe_542",
  "title": "מאמר פדה בשלום תשל\"א",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים המאמר של בעל השמחה והגאולה8"
        },
        {
          "s": 2,
          "text": "ד\"ה להבין9"
        },
        {
          "s": 3,
          "text": "ענין מ\"ש בע\"ח בתחלתו דבחי'10"
        },
        {
          "s": 4,
          "text": "הנקודים המה יו\"ד אורות ביו\"ד כלים,"
        },
        {
          "s": 5,
          "text": "ובחי' העקודים כל"
        },
        {
          "s": 6,
          "text": "(עשר)"
        },
        {
          "s": 7,
          "text": "האורות עקודים בכלי א',"
        },
        {
          "s": 8,
          "text": "ומבאר,"
        },
        {
          "s": 9,
          "text": "שלהבין זה יש להקדים תחלה להבין איך שייך למעלה באוא\"ס ענין של עשר ספירות,"
        },
        {
          "s": 10,
          "text": "חכמה ובינה כו',"
        },
        {
          "s": 11,
          "text": "הרי השם חכמה ובינה כו' מורה שהוא בחי' מציאות דבר מה באיזה מהות,"
        },
        {
          "s": 12,
          "text": "ואילו אוא\"ס הוא אור פשוט,"
        },
        {
          "s": 13,
          "text": "ועד שגם עולם האצילות הוא בבחי' בלי מה11."
        },
        {
          "s": 14,
          "text": "וכמו\"כ בנוגע לבחי' הכתר שנקרא רצון,"
        },
        {
          "s": 15,
          "text": "שהוא למעלה מעשר ספירות,"
        },
        {
          "s": 16,
          "text": "וכמו בכחות הנפש,"
        },
        {
          "s": 17,
          "text": "שכח הרצון הוא למעלה מכל הכחות פנימיים,"
        },
        {
          "s": 18,
          "text": "ועד שמבואר בכ\"מ12"
        },
        {
          "s": 19,
          "text": "שהרצון אינו ענין נפרד מהנפש כמו חכמה ומה שלמטה הימנה,"
        },
        {
          "s": 20,
          "text": "הרי כל ענין הרצון הוא שפועל ענין של שינוי,"
        },
        {
          "s": 21,
          "text": "וכמו שאומרים יהי רצון,"
        },
        {
          "s": 22,
          "text": "שפירושו רצון חדש,"
        },
        {
          "s": 23,
          "text": "היינו שישתנה מכמו שהי' לפנ\"ז,"
        },
        {
          "s": 24,
          "text": "ונמצא,"
        },
        {
          "s": 25,
          "text": "שיש שינוי בין קודם שירצה,"
        },
        {
          "s": 26,
          "text": "בעת שירצה,"
        },
        {
          "s": 27,
          "text": "ולאחר שירצה,"
        },
        {
          "s": 28,
          "text": "והרי אי אפשר לומר בשום אופן שימצא בחי' שינוי למעלה,"
        },
        {
          "s": 29,
          "text": "שהרי נאמר בו13"
        },
        {
          "s": 30,
          "text": "אני הוי' לא שניתי."
        },
        {
          "s": 31,
          "text": "ונקודת הביאור בזה הוא החילוק שבין אורות וכלים,"
        },
        {
          "s": 32,
          "text": "שמצד הכלים ישנו הענין דעשר ספירות,"
        },
        {
          "s": 33,
          "text": "עד שנקראים בשם חכמה ובינה כו',"
        },
        {
          "s": 34,
          "text": "וכן ענין הרצון שלמעלה מזה,"
        },
        {
          "s": 35,
          "text": "משא\"כ מצד האורות הרי זה באופן של פשיטות דאחדות הפשוטה שלמעלה מכל ענינים אלו,"
        },
        {
          "s": 36,
          "text": "ועז\"נ אני הוי' לא שניתי."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ויובן ממה שרואים באדם למטה,"
        },
        {
          "s": 2,
          "text": "מבשרי אחזה אלוקה14,"
        },
        {
          "s": 3,
          "text": "שישנו חילוק בין העלם וגילוי."
        },
        {
          "s": 4,
          "text": "דהנה,"
        },
        {
          "s": 5,
          "text": "כל הענינים שישנם באדם בגילוי,"
        },
        {
          "s": 6,
          "text": "הרי האפשרות להתגלות שלהם היא מפני שישנם לפנ\"ז בהעלם בנפשו."
        },
        {
          "s": 7,
          "text": "וכמו החכמה שהיא ראשית הכחות הפנימיים,"
        },
        {
          "s": 8,
          "text": "הנה התגלותה באדם היא עי\"ז שישנה לפנ\"ז בעצם נפשו,"
        },
        {
          "s": 9,
          "text": "אלא שבעצם נפשו אין זה באופן של חכמה גלוי' עד שאפשר לתפסה בכלי ההבנה וההשגה דבינה,"
        },
        {
          "s": 10,
          "text": "אלא שם הוא כח היולי בלבד,"
        },
        {
          "s": 11,
          "text": "שממנו יכול לבוא אח\"כ ענין החכמה והשכל."
        },
        {
          "s": 12,
          "text": "ואפילו כפי שבא אח\"כ לידי גילוי,"
        },
        {
          "s": 13,
          "text": "הרי זה באופן שנמשך תחילה כח המשכיל,"
        },
        {
          "s": 14,
          "text": "שבו לא שייך עדיין ענין ההשגה ותפיסא ע\"י כלי הבינה,"
        },
        {
          "s": 15,
          "text": "להיותו כח המשכיל על כל מיני שכל וחכמה,"
        },
        {
          "s": 16,
          "text": "ואח\"כ נמשך מכח המשכיל גם ענין של חכמה גלוי',"
        },
        {
          "s": 17,
          "text": "חכמה מסויימת,"
        },
        {
          "s": 18,
          "text": "שיכולה לבוא אח\"כ בהיכל הבינה,"
        },
        {
          "s": 19,
          "text": "נקודה בהיכלא15."
        },
        {
          "s": 20,
          "text": "והנה,"
        },
        {
          "s": 21,
          "text": "כפי שהכחות הם בעצם הנפש אזי לא שייך לחלק בין כח א' לזולתו,"
        },
        {
          "s": 22,
          "text": "שהרי הנפש היא פשוטה,"
        },
        {
          "s": 23,
          "text": "וכמו\"כ לא שייך שם ענין של שינויים,"
        },
        {
          "s": 24,
          "text": "להיותם שם בפשיטות,"
        },
        {
          "s": 25,
          "text": "ואינם אלא מקור שמהם יוכל אח\"כ להיות נמשך"
        },
        {
          "s": 26,
          "text": "(בנוגע לענין השכל)"
        },
        {
          "s": 27,
          "text": "כח המשכיל ואח\"כ שכל וחכמה גלוי',"
        },
        {
          "s": 28,
          "text": "ולכן נקרא בשם חכמה,"
        },
        {
          "s": 29,
          "text": "ע\"ש היותו מקור לחכמה,"
        },
        {
          "s": 30,
          "text": "אבל כל ענין החכמה והשכל נמצא שם באופן של העלם,"
        },
        {
          "s": 31,
          "text": "ונקרא גם בשם אור."
        },
        {
          "s": 32,
          "text": "אמנם,"
        },
        {
          "s": 33,
          "text": "כאשר נמשך אח\"כ בגלוי,"
        },
        {
          "s": 34,
          "text": "הרי זה ע\"י ענין הכלים,"
        },
        {
          "s": 35,
          "text": "ומצד ענין הכלים נעשה ענין של שינוי,"
        },
        {
          "s": 36,
          "text": "שיש מי שאצלו משפיע כח המשכיל כו\"כ עניני חכמה ובריבוי הן בכמות והן באיכות,"
        },
        {
          "s": 37,
          "text": "ויש מי שאצלו לא בא הגילוי בריבוי כ\"כ ולא בחכמות אלו,"
        },
        {
          "s": 38,
          "text": "בכמה שינויים בין אחד לחבירו."
        },
        {
          "s": 39,
          "text": "ועאכו\"כ כשנמשך בחכמה הגלוי',"
        },
        {
          "s": 40,
          "text": "אזי יש חילוק גדול יותר בין אחד לחבירו,"
        },
        {
          "s": 41,
          "text": "ועד שאפילו באדם זה עצמו יש שינויים מזמן לזמן,"
        },
        {
          "s": 42,
          "text": "והיינו,"
        },
        {
          "s": 43,
          "text": "שנוסף על השינוי הכללי דרוב שנים יודיעו חכמה16,"
        },
        {
          "s": 44,
          "text": "יש גם שינוי מזמן לזמן בשנה זו עצמה וביום זה עצמו,"
        },
        {
          "s": 45,
          "text": "אם שכלו הוא בצלילות ובזכות ובבהירות,"
        },
        {
          "s": 46,
          "text": "אם לאו,"
        },
        {
          "s": 47,
          "text": "ששינויים אלה יכולים להיות ביום אחד,"
        },
        {
          "s": 48,
          "text": "מזמן אחד ביום לזמן שני ביום."
        },
        {
          "s": 49,
          "text": "וכל זה הוא מצד ענין הכלים,"
        },
        {
          "s": 50,
          "text": "דכיון שיש שינוי בין הכלים"
        },
        {
          "s": 51,
          "text": "(כלי המוח ועד\"ז הכלים דשאר הכחות)"
        },
        {
          "s": 52,
          "text": "של אדם זה לכלים של אדם שני,"
        },
        {
          "s": 53,
          "text": "הרי זה פועל גם על הגילוי,"
        },
        {
          "s": 54,
          "text": "היינו,"
        },
        {
          "s": 55,
          "text": "כפי שאור השכל נמשך ומתגלה מעצם הנפש בכח המשכיל ואח\"כ בגילוי יותר בשכל גלוי,"
        },
        {
          "s": 56,
          "text": "שאז נעשים בו שינויים."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "וממשיך לבאר17"
        },
        {
          "s": 1,
          "text": "שהשינוי שנעשה בהתגלות הכחות אינו אלא מצד הכלים,"
        },
        {
          "s": 2,
          "text": "שההוכחה בזה היא ממה שרואים בענין הגלגולים,"
        },
        {
          "s": 3,
          "text": "שנפש האדם בעל שכל,"
        },
        {
          "s": 4,
          "text": "בחי' המדבר,"
        },
        {
          "s": 5,
          "text": "מתגלגלת בבהמה או אפילו בדומם,"
        },
        {
          "s": 6,
          "text": "היינו,"
        },
        {
          "s": 7,
          "text": "שמתגלגל ונמצא שם עצם הנפש עם כל הכחות שלה,"
        },
        {
          "s": 8,
          "text": "ואעפ\"כ,"
        },
        {
          "s": 9,
          "text": "לא נעשה שינוי בהחי ועאכו\"כ בהדומם שיהי' בהם ענין השכל ששייך למין המדבר."
        },
        {
          "s": 10,
          "text": "והביאור בזה,"
        },
        {
          "s": 11,
          "text": "דכיון שאין שם כלי המתאימה לקבל את אור השכל,"
        },
        {
          "s": 12,
          "text": "לכן נשאר האור בהעלם,"
        },
        {
          "s": 13,
          "text": "והיינו,"
        },
        {
          "s": 14,
          "text": "שאף שנמצא שם,"
        },
        {
          "s": 15,
          "text": "מ\"מ,"
        },
        {
          "s": 16,
          "text": "נשאר הוא באותו אופן כמו שנמצא בעצם הנפש,"
        },
        {
          "s": 17,
          "text": "ואינו בא בגילוי."
        },
        {
          "s": 18,
          "text": "והנה,"
        },
        {
          "s": 19,
          "text": "ענין הנ\"ל הוא כפי שהאור הוא בהעלם כ\"כ שאינו פועל מאומה."
        },
        {
          "s": 20,
          "text": "ויש עוד דוגמא לזה,"
        },
        {
          "s": 21,
          "text": "מכתיבת דבר שכל ע\"י אצבעות היד."
        },
        {
          "s": 22,
          "text": "דהנה,"
        },
        {
          "s": 23,
          "text": "אף שהכלי להשכל הוא המוח שבראש,"
        },
        {
          "s": 24,
          "text": "הרי רואים שכאשר האדם כותב דבר שכל בידו,"
        },
        {
          "s": 25,
          "text": "צ\"ל תנועת האצבעות באופן מסויים כדי שיתגלה בהכתב דבר חכמה ושכל,"
        },
        {
          "s": 26,
          "text": "ולא ענין שאין בו חכמה ושכל או ענין הפכי."
        },
        {
          "s": 27,
          "text": "ונמצא,"
        },
        {
          "s": 28,
          "text": "שאע\"פ שהיד והאצבעות אינם כלים כלל לכח השכל,"
        },
        {
          "s": 29,
          "text": "והראי',"
        },
        {
          "s": 30,
          "text": "שתיכף כשפוסק לכתוב לא ניכר ענין של שכל באצבעות היד,"
        },
        {
          "s": 31,
          "text": "ולא נשאר בהם אלא כח התנועה בלבד,"
        },
        {
          "s": 32,
          "text": "מ\"מ,"
        },
        {
          "s": 33,
          "text": "בשעת הכתיבה רואים כיצד נמשך ענין השכל ע\"י אצבעות היד."
        },
        {
          "s": 34,
          "text": "וכדאיתא בכמה מאמרים18"
        },
        {
          "s": 35,
          "text": "דוגמא לזה אפילו בהרגל,"
        },
        {
          "s": 36,
          "text": "כפי שרואים בענין הריקוד באופן שתנועת הרגלים היא מכוונת לטעמי הניגון,"
        },
        {
          "s": 37,
          "text": "שיוכל לכוין הטאק"
        },
        {
          "s": 38,
          "text": "(כהלשון במאמר19),"
        },
        {
          "s": 39,
          "text": "שענין זה נמשך מהשכל שבראש."
        },
        {
          "s": 40,
          "text": "ומ\"מ אין זה באופן שהיד או הרגל הם כלים להשכל,"
        },
        {
          "s": 41,
          "text": "שהרי ענין זה שייך רק בכלי המוח,"
        },
        {
          "s": 42,
          "text": "שבו הוא משכן השכל,"
        },
        {
          "s": 43,
          "text": "אבל בשאר אברי הגוף נמצא השכל בהעלם,"
        },
        {
          "s": 44,
          "text": "ע\"י גידי המוח שמתפשטים בכל אברי הגוף,"
        },
        {
          "s": 45,
          "text": "ועל ידם יכול העלם השכל לפעול גם ביד או ברגל שתהי' הכתיבה באופן שיתגלה הענין השכלי באותיות הכתב,"
        },
        {
          "s": 46,
          "text": "ועד\"ז בנוגע להריקוד שברגל."
        }
      ]
    }
  ]
}