{
  "globalIndex": 375,
  "owner": 25,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915911_theRebbe_364__p001",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915911_theRebbe_364__p001",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915911_theRebbe_364",
  "title": "מאמר ברוך שעשה נסים תשמ\"ג",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ מקץ,"
        },
        {
          "s": 2,
          "text": "זאת חנוכה ה'תשמ\"ג*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "ברוך שעשה נסים לאבותינו בימים ההם בזמן הזה,"
        },
        {
          "s": 1,
          "text": "הנה ברכה זו קאי"
        },
        {
          "s": 2,
          "text": "(לא על הנס דנצחון המלחמה,"
        },
        {
          "s": 3,
          "text": "מסרת גבורים ביד חלשים וכו'1,"
        },
        {
          "s": 4,
          "text": "אלא)"
        },
        {
          "s": 5,
          "text": "על הנס שהי' בפך השמן."
        },
        {
          "s": 6,
          "text": "ולכן מברכים אותה כשמדליקין נרות חנוכה"
        },
        {
          "s": 7,
          "text": "(או כשרואים את הנרות)2"
        },
        {
          "s": 8,
          "text": "שתקנום לזכר הנס שהי' בפך השמן."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "והנה מבואר בד\"ה ברוך שעשה נסים לאדמו\"ר הזקן"
        },
        {
          "s": 1,
          "text": "(עם הגהות והערות כו' דהצמח צדק3)4,"
        },
        {
          "s": 2,
          "text": "שבכדי להבין מה שנס דחנוכה קבעו בנרות,"
        },
        {
          "s": 3,
          "text": "צריך להקדים תחלה ביאור ענין השמן."
        },
        {
          "s": 4,
          "text": "ומבאר שם בארוכה,"
        },
        {
          "s": 5,
          "text": "דזה ששמן צף על גבי"
        },
        {
          "s": 6,
          "text": "(יין ומים)"
        },
        {
          "s": 7,
          "text": "כל המשקין5"
        },
        {
          "s": 8,
          "text": "הוא"
        },
        {
          "s": 9,
          "text": "[ככל הענינים שבגשמיות שהם משתלשלים מענינם ברוחניות6]"
        },
        {
          "s": 10,
          "text": "מפני ששמן הוא למעלה מיין ומים."
        },
        {
          "s": 11,
          "text": "דיין ומים הם בינה וחכמה"
        },
        {
          "s": 12,
          "text": "(יין בינה ומים חכמה),"
        },
        {
          "s": 13,
          "text": "ושמן הוא חכמה סתימאה,"
        },
        {
          "s": 14,
          "text": "חכמה שבכתר."
        },
        {
          "s": 15,
          "text": "ועפ\"ז מבאר שם זה שחנוכת המזבח היתה ע\"י שמשחו אותו בשמן המשחה7."
        },
        {
          "s": 16,
          "text": "כי חינוך המזבח"
        },
        {
          "s": 17,
          "text": "(חנוכת מלשון חינוך)"
        },
        {
          "s": 18,
          "text": "הי' ע\"י המשכת אורות נעלים שלמעלה מההמשכות שעל ידי הקרבנות וכו' שהיו אח\"כ."
        },
        {
          "s": 19,
          "text": "[וכמבואר במק\"א8,"
        },
        {
          "s": 20,
          "text": "דזה שהנשיאים התנדבו לחנוכת המזבח ריבוי מתנות,"
        },
        {
          "s": 21,
          "text": "וגם הקריבו קטורת ע\"ג המזבח החיצון9,"
        },
        {
          "s": 22,
          "text": "הוא,"
        },
        {
          "s": 23,
          "text": "כי בכדי לחנך את המזבח שיהי' ראוי להקריב עליו קרבנות,"
        },
        {
          "s": 24,
          "text": "הי' צריך להמשיך בו המשכות נעלות ביותר,"
        },
        {
          "s": 25,
          "text": "שלמעלה מההמשכות שע\"י הקרבנות וכו' שהיו אח\"כ]."
        },
        {
          "s": 26,
          "text": "ולכן הי' החינוך דהמזבח ע\"י שמשחו אותו בשמן,"
        },
        {
          "s": 27,
          "text": "בחינת חכמה סתימאה,"
        },
        {
          "s": 28,
          "text": "שלמעלה מההמשכות שנמשכו אח\"כ ע\"י הקרבנות והנסכים."
        },
        {
          "s": 29,
          "text": "ולאחרי שמבאר ענין שמן המשחה,"
        },
        {
          "s": 30,
          "text": "הוא מבאר10,"
        },
        {
          "s": 31,
          "text": "דשמן למאור"
        },
        {
          "s": 32,
          "text": "[שבו הי' הנס דחנוכה]"
        },
        {
          "s": 33,
          "text": "הוא נעלה יותר גם משמן המשחה11."
        }
      ]
    }
  ]
}