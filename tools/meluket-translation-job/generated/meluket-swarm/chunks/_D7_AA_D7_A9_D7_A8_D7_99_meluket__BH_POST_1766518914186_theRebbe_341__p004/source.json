{
  "globalIndex": 86,
  "owner": 36,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914186_theRebbe_341__p004",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914186_theRebbe_341__p004",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914186_theRebbe_341",
  "title": "מאמר בסוכות תשבו תשל\"ו",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "והנה בהמשך48"
        },
        {
          "s": 2,
          "text": "למצות ישיבה בסוכה ונטילת ד' מינים באה המצוה דהקרבת ע' פרים כנגד שבעים אומות,"
        },
        {
          "s": 3,
          "text": "היינו שע\"י הקרבת ע' פרים מגינים על הע' אומות49"
        },
        {
          "s": 4,
          "text": "ומגלים את תכלית הבריאה שלהם,"
        },
        {
          "s": 5,
          "text": "דכל העולם לא נברא אלא לצוות לזה50"
        },
        {
          "s": 6,
          "text": "ואני נבראתי לשמש את קוני51."
        },
        {
          "s": 7,
          "text": "דאמיתית ענינם"
        },
        {
          "s": 8,
          "text": "(של אוה\"ע)"
        },
        {
          "s": 9,
          "text": "הוא כמו שיהי' לע\"ל לצוות לישראל כו',"
        },
        {
          "s": 10,
          "text": "וכמ\"ש52"
        },
        {
          "s": 11,
          "text": "והיו מלכים אומניך ושרותיהם מיניקותיך,"
        },
        {
          "s": 12,
          "text": "ועאכו\"כ אלו שלמטה ממלכים ושרותיהם."
        },
        {
          "s": 13,
          "text": "ומכיון שכל הענינים והגילויים דלעתיד תלויים במעשינו ועבודתנו במשך שיתא אלפי שנין"
        },
        {
          "s": 14,
          "text": "(כולל משך זמן הגלות,"
        },
        {
          "s": 15,
          "text": "ואדרבה הם תלויים בעיקר בהעבודה שבזמן הגלות53),"
        },
        {
          "s": 16,
          "text": "הנה הענין דוהיו מלכים אומניך וגו' שיהי' לע\"ל הוא נעשה ע\"י הקרבת ע' פרים בזמן הבית54"
        },
        {
          "s": 17,
          "text": "וע\"י ונשלמה פרים שפתינו משחרב ביהמ\"ק כו' בזמן הגלות."
        },
        {
          "s": 18,
          "text": "דהנה ידוע שעבודת הקרבנות"
        },
        {
          "s": 19,
          "text": "(ועד\"ז העבודה דונשלמה פרים שפתינו)"
        },
        {
          "s": 20,
          "text": "היא פועלת בכל העולם,"
        },
        {
          "s": 21,
          "text": "דע\"י הקרבת בהמה אחת נעשית עלי' בכל מין החי וכו'55,"
        },
        {
          "s": 22,
          "text": "(שע\"י העלאת הדם והחלב שהם החיות והתענוג של בהמה הנקרבת נעשית עלי' בכל מין החי),"
        },
        {
          "s": 23,
          "text": "וע\"י ההמשכה שעי\"ז מלמעלה למטה נעשה המשכה בכל מין החי וכו'."
        },
        {
          "s": 24,
          "text": "ועד\"ז הוא בהקרבת הע' פרים שהם כנגד הע' אומות,"
        },
        {
          "s": 25,
          "text": "שהעלי' וההמשכה שע\"י קרבנות אלו פועלות בכל ע' האומות,"
        },
        {
          "s": 26,
          "text": "וכמו\"כ הוא באמירת הפסוקים שעקימת שפתיו הוי מעשה,"
        },
        {
          "s": 27,
          "text": "שע\"י אמירת פסוקי הקרבנות דע' פרים שכנגד ע' אומות נעשית בהם המשכה והכנעה,"
        },
        {
          "s": 28,
          "text": "ומתגלית בהם תכלית בריאתם,"
        },
        {
          "s": 29,
          "text": "שלא נבראו אלא לצוות לזה כו',"
        },
        {
          "s": 30,
          "text": "ונתגלה שאתה בחרתנו מכל העמים."
        },
        {
          "s": 31,
          "text": "וזהו מ\"ש56"
        },
        {
          "s": 32,
          "text": "הללו את הוי' כל גוים שבחוהו כל האומים כי גבר עלינו חסדו גו',"
        },
        {
          "s": 33,
          "text": "דלכאורה מהי השייכות דגבר עלינו חסדו שלכן יהללוהו וישבחוהו גוים ואומים57."
        },
        {
          "s": 34,
          "text": "וידוע הביאור בזה58,"
        },
        {
          "s": 35,
          "text": "שע\"י שגבר עלינו חסדו נעשה בירור זיכוך ועלי' גם בגוים ואומים,"
        },
        {
          "s": 36,
          "text": "ועד שזה ניכר בהם בגילוי59,"
        },
        {
          "s": 37,
          "text": "ולכן הם מהללים ומשבחים את הוי'."
        },
        {
          "s": 38,
          "text": "וענין זה נעשה ע\"י הקרבת ע' פרים60,"
        },
        {
          "s": 39,
          "text": "ועד\"ז ע\"י העבודה דונשלמה פרים שפתינו,"
        },
        {
          "s": 40,
          "text": "דמכיון שעקימת שפתיו הוי מעשה לכן הפעולה שע\"י שפתינו הוא גם בעולם העשי'."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "וזהו61 השייכות והקשר של הקרבת ע' פרים לבסוכות תשבו,"
        },
        {
          "s": 2,
          "text": "כי בכדי לפעול בגוים ואומים צריכה להיות תחילה המשכת המקיף שע\"י סוכה,"
        },
        {
          "s": 3,
          "text": "דאור מקיף מסמא עיני החיצונים."
        },
        {
          "s": 4,
          "text": "ואף שבירור הגוים והאומים הוא ע\"י עבודה פנימית דוקא"
        },
        {
          "s": 5,
          "text": "[שלכן הבירור דע' אומות נעשה ע\"י הקרבת הקרבנות דע' פרים,"
        },
        {
          "s": 6,
          "text": "דקרבנות הו\"ע פנימיות,"
        },
        {
          "s": 7,
          "text": "לחמי לאשי],"
        },
        {
          "s": 8,
          "text": "ובדוגמת כללות ענין הבירורים שהוא ע\"י עבודה פנימית כמאמר62"
        },
        {
          "s": 9,
          "text": "נהמא אפום חרבא ליכול"
        },
        {
          "s": 10,
          "text": "[דאכילה הו\"ע בירור פנימי],"
        },
        {
          "s": 11,
          "text": "אעפ\"כ בתחילה צריכה להיות המשכת המקיף דסוכה,"
        },
        {
          "s": 12,
          "text": "שעי\"ז נעשה בהם ביטול והכנעה כללית,"
        },
        {
          "s": 13,
          "text": "וביטול זה הוא הקדמה והכנה והכשרה להבירור שלהם אח\"כ ע\"י הקרבת הע' פרים,"
        },
        {
          "s": 14,
          "text": "ועד\"ז ע\"י ונשלמה פרים שפתינו בזמן הגלות,"
        },
        {
          "s": 15,
          "text": "והיא ג\"כ הכנה קרובה להקרבת שבעים פרים כפשוטה."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "וזהו בסוכות תשבו גו' למען ידעו דורותיכם גו'."
        },
        {
          "s": 2,
          "text": "שע\"י בסוכות תשבו,"
        },
        {
          "s": 3,
          "text": "מה שהמקיף דסוכה הוא באופן דתשבו,"
        },
        {
          "s": 4,
          "text": "ואדרבה,"
        },
        {
          "s": 5,
          "text": "כל הענין דמצות סוכה הוא תשבו"
        },
        {
          "s": 6,
          "text": "[תשבו כעין תדורו,"
        },
        {
          "s": 7,
          "text": "שהאכילה ושתי' וכל עניניו שעושה בביתו יהיו בסוכה63],"
        },
        {
          "s": 8,
          "text": "הנה זה פועל שהמקיפים יומשכו גם בדורותיכם,"
        },
        {
          "s": 9,
          "text": "היינו בכחות הגלויים"
        },
        {
          "s": 10,
          "text": "(חב\"ד וז' מדות),"
        },
        {
          "s": 11,
          "text": "ועד אשר ידעו דורותיכם,"
        },
        {
          "s": 12,
          "text": "דעת מלשון התקשרות64,"
        },
        {
          "s": 13,
          "text": "שפעולת המקיפים בכחות הגלויים היא באופן של דעת והתקשרות."
        },
        {
          "s": 14,
          "text": "והטעם"
        },
        {
          "s": 15,
          "text": "(והנתינת כח)"
        },
        {
          "s": 16,
          "text": "לזה הוא,"
        },
        {
          "s": 17,
          "text": "כי בסוכות הושבתי את בנ\"י בהוציאי אותם מארץ מצרים."
        },
        {
          "s": 18,
          "text": "דמכיון שאני"
        },
        {
          "s": 19,
          "text": "(הקב\"ה)"
        },
        {
          "s": 20,
          "text": "המתחיל,"
        },
        {
          "s": 21,
          "text": "בסוכות הושבתי,"
        },
        {
          "s": 22,
          "text": "זה נותן כח לכאו\"א מישראל,"
        },
        {
          "s": 23,
          "text": "אתם קרויין אדם65"
        },
        {
          "s": 24,
          "text": "על שם אדמה לעליון66,"
        },
        {
          "s": 25,
          "text": "שגם הוא יפעול דוגמת הפעולה של הקב\"ה,"
        },
        {
          "s": 26,
          "text": "שימשיך השלום דסוכת שלומך בכל עניני עבודתו ובכל הציור שלו"
        },
        {
          "s": 27,
          "text": "(עד שידעו דורותיכם כחות הגלויים שלו),"
        },
        {
          "s": 28,
          "text": "ועד שהמשכת המקיף דסוכה תורגש אצלו גם בהתפלה שלו,"
        },
        {
          "s": 29,
          "text": "כולל גם תפלת מוסף ואמירת פסוקי הקרבנות דע' פרים,"
        },
        {
          "s": 30,
          "text": "שעי\"ז פועל גם בע' אומות כפשוטם,"
        },
        {
          "s": 31,
          "text": "וכמו שאומרים בהלל"
        },
        {
          "s": 32,
          "text": "[שבכל ז' ימי הסוכות אומרים הלל שלם]"
        },
        {
          "s": 33,
          "text": "הללו את הוי' כל גוים שבחוהו כל האומים,"
        },
        {
          "s": 34,
          "text": "שקאי על גוים ואומים כפשוטם."
        },
        {
          "s": 35,
          "text": "וזה גם נעשה הכנה קרובה לכל האזרח בישראל,"
        },
        {
          "s": 36,
          "text": "שיזרח לע\"ל,"
        },
        {
          "s": 37,
          "text": "ישבו."
        },
        {
          "s": 38,
          "text": "דהנה ידוע מ\"ש הרמב\"ם67"
        },
        {
          "s": 39,
          "text": "בפירוש עולם הבא,"
        },
        {
          "s": 40,
          "text": "שעוה\"ב הוא מצוי ועומד"
        },
        {
          "s": 41,
          "text": "(גם עכשיו)"
        },
        {
          "s": 42,
          "text": "ומה שנקרא עולם הבא הוא לפי שבא לאחרי"
        },
        {
          "s": 43,
          "text": "(ובהמשך ל)"
        },
        {
          "s": 44,
          "text": "העבודה בעוה\"ז."
        },
        {
          "s": 45,
          "text": "דכמו\"כ הוא גם בנוגע להענינים דלע\"ל,"
        },
        {
          "s": 46,
          "text": "שהענינים"
        },
        {
          "s": 47,
          "text": "(נעשים ו)"
        },
        {
          "s": 48,
          "text": "ישנם גם עכשיו,"
        },
        {
          "s": 49,
          "text": "ומה שנק' לעתיד לבוא הוא לפי שהמשכתם והתגלותם היא לאחרי וע\"י קדימת העבודה בעוה\"ז."
        },
        {
          "s": 50,
          "text": "וזהו בסוכות תשבו גו' כל האזרח בישראל גו',"
        },
        {
          "s": 51,
          "text": "שע\"י קיום מצות בסוכות תשבו ממשיכים גם עכשיו בחי' כל האזרח בישראל,"
        },
        {
          "s": 52,
          "text": "וזה נעשה הכנה קרובה לגילוי בחינה זו לע\"ל,"
        },
        {
          "s": 53,
          "text": "שאז תתגלה בכל התוקף שלה."
        }
      ]
    }
  ]
}