{
  "globalIndex": 1104,
  "owner": 4,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920390_theRebbe_690__p004",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920390_theRebbe_690__p004",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920390_theRebbe_690",
  "title": "מאמר את הוי' האמרת תש\"ל",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ויש לקשר זה עם הגילוי דתורת החסידות,"
        },
        {
          "s": 2,
          "text": "דח\"י אלול הוא יום הולדת דהבעש\"ט מייסד תורת החסידות הכללית ודאדמו\"ר הזקן מייסד תורת חסידות חב\"ד,"
        },
        {
          "s": 3,
          "text": "שמההדגשות העיקריות בתורת החסידות היא שכל הענינים יומשכו למטה בגילוי."
        },
        {
          "s": 4,
          "text": "וכמ\"ש אדמו\"ר הזקן בשער היחוד והאמונה בתחילתו \"כתיב79"
        },
        {
          "s": 5,
          "text": "לעולם הוי' דברך נצב בשמים,"
        },
        {
          "s": 6,
          "text": "ופירש הבעש\"ט ז\"ל כי דברך שאמרת יהי רקיע בתוך המים וגו' תיבות ואותיות אלו הן נצבות ועומדות לעולם בתוך רקיע השמים וכו'\","
        },
        {
          "s": 7,
          "text": "דאף שפירוש זה איתא במדרש תהלים על הפסוק"
        },
        {
          "s": 8,
          "text": "(כמובא בלקוטי תורה80),"
        },
        {
          "s": 9,
          "text": "מ\"מ כותב אדמו\"ר הזקן \"ופירש הבעש\"ט ז\"ל\","
        },
        {
          "s": 10,
          "text": "דאחד הביאורים בזה81,"
        },
        {
          "s": 11,
          "text": "שהבעל שם טוב פירש"
        },
        {
          "s": 12,
          "text": "(פאַנאַנדערגעשפּרייט)"
        },
        {
          "s": 13,
          "text": "וגילה זה שיהי' ידוע לכל."
        },
        {
          "s": 14,
          "text": "ואדמו\"ר הזקן המשיך זה בשכל,"
        },
        {
          "s": 15,
          "text": "שיהי' לתהלה ולשם ולתפארת82,"
        },
        {
          "s": 16,
          "text": "דקאי על חב\"ד83,"
        },
        {
          "s": 17,
          "text": "ועד שזה יהי' מושג גם בשכל דנפש הבהמית,"
        },
        {
          "s": 18,
          "text": "ואפילו בשכלם של אלה שהיו"
        },
        {
          "s": 19,
          "text": "(לפני שלמדו ענין זה)"
        },
        {
          "s": 20,
          "text": "מינים84,"
        },
        {
          "s": 21,
          "text": "לתתך עליון על כל הגוים85."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "וזהו את הוי' האמרת אתם עשיתוני חטיבה אחת בעולם שנאמר שמע ישראל הוי' אלקינו הוי' אחד,"
        },
        {
          "s": 2,
          "text": "שע\"י שישראל אומרים הוי' אחד בק\"ש,"
        },
        {
          "s": 3,
          "text": "ובפרט בתפילין86"
        },
        {
          "s": 4,
          "text": "שממשיכים הוי' אחד גם בקלף הגשמי,"
        },
        {
          "s": 5,
          "text": "עי\"ז הקב\"ה מניח תפילין,"
        },
        {
          "s": 6,
          "text": "שהם"
        },
        {
          "s": 7,
          "text": "(התפילין)"
        },
        {
          "s": 8,
          "text": "הפאר והשבח שלו"
        },
        {
          "s": 9,
          "text": "(כנ\"ל),"
        },
        {
          "s": 10,
          "text": "האמרת לשון חשיבות ושבח."
        },
        {
          "s": 11,
          "text": "והטעם על זה שבכחם של ישראל שע\"י קיום המצוות שלהם יהי' קיום המצוות דהקב\"ה,"
        },
        {
          "s": 12,
          "text": "ממשיך בכתוב,"
        },
        {
          "s": 13,
          "text": "והוי' האמירך גו' להיות לו לעם סגולה87."
        },
        {
          "s": 14,
          "text": "וזהו שמסיים"
        },
        {
          "s": 15,
          "text": "(בפסוק והוי' האמירך)"
        },
        {
          "s": 16,
          "text": "ולשמור כל מצותיו"
        },
        {
          "s": 17,
          "text": "(אף שלכאורה שייך זה בפסוק את ה' האמרת,"
        },
        {
          "s": 18,
          "text": "דהשבח שישראל משבחים את הקב\"ה הוא זה שקיבלו עליהם להיות לך לאלקים גו' ולשמור חוקיו ומצותיו גו')88,"
        },
        {
          "s": 19,
          "text": "כי לשמור כל מצותיו דישראל מביאה את מצותיו,"
        },
        {
          "s": 20,
          "text": "שהקב\"ה יעשה המצוות."
        },
        {
          "s": 21,
          "text": "ולכן נאמר זה בפסוק והוי' האמירך"
        },
        {
          "s": 22,
          "text": "(בהשבח שהקב\"ה משבח את ישראל),"
        },
        {
          "s": 23,
          "text": "כי זה שבכחם של ישראל לעשות"
        },
        {
          "s": 24,
          "text": "(ע\"י קיום המצוות שלהם)"
        },
        {
          "s": 25,
          "text": "שיהי' מצותיו דהקב\"ה,"
        },
        {
          "s": 26,
          "text": "הוא שבח גדול לישראל89."
        },
        {
          "s": 27,
          "text": "ויש לומר,"
        },
        {
          "s": 28,
          "text": "דזהו מ\"ש הרשב\"א דענין האמרת והאמירך הוא ע\"ד דודי לי ואני לו"
        },
        {
          "s": 29,
          "text": "(בתחילה דודי לי ואח\"כ ואני לו),"
        },
        {
          "s": 30,
          "text": "כי הכח בישראל להיות את ה' האמרת,"
        },
        {
          "s": 31,
          "text": "להוסיף"
        },
        {
          "s": 32,
          "text": "(כביכול)"
        },
        {
          "s": 33,
          "text": "חשיבות ושבח בהקב\"ה,"
        },
        {
          "s": 34,
          "text": "הוא ע\"י זה שהוי' האמירך."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "והנה זה דהוי' האמירך להיות לו לעם סגולה,"
        },
        {
          "s": 3,
          "text": "הוא לא מצד הטעם,"
        },
        {
          "s": 4,
          "text": "מצד המעלה דישראל,"
        },
        {
          "s": 5,
          "text": "קיום התומ\"צ שלהם וכיו\"ב,"
        },
        {
          "s": 6,
          "text": "כי אם,"
        },
        {
          "s": 7,
          "text": "שכך בחר הקב\"ה בבחירתו"
        },
        {
          "s": 8,
          "text": "(החפשית),"
        },
        {
          "s": 9,
          "text": "כמ\"ש90"
        },
        {
          "s": 10,
          "text": "כי יעקב בחר לו י\"ה ישראל לסגולתו88."
        },
        {
          "s": 11,
          "text": "דזה שישראל הם סגולתו ית' הוא מצד בחירתו,"
        },
        {
          "s": 12,
          "text": "ולכן,"
        },
        {
          "s": 13,
          "text": "זהו בהעצם דישראל."
        },
        {
          "s": 14,
          "text": "דכאו\"א מישראל"
        },
        {
          "s": 15,
          "text": "(גם לפני שמקיים תומ\"צ91)"
        },
        {
          "s": 16,
          "text": "הוא סגולתו ית'."
        },
        {
          "s": 17,
          "text": "ועי\"ז נעשה בהם גם מעלה"
        },
        {
          "s": 18,
          "text": "(בענין הגילויים),"
        },
        {
          "s": 19,
          "text": "דע\"י קיום המצוות שלהם נעשה מצותיו דהקב\"ה."
        },
        {
          "s": 20,
          "text": "וזהו מה שבתפילין דמארי עלמא כתיב"
        },
        {
          "s": 21,
          "text": "(לא הפסוק שמע ישראל גו' הוי' אחד,"
        },
        {
          "s": 22,
          "text": "כי אם)"
        },
        {
          "s": 23,
          "text": "ומי כעמך ישראל גו',"
        },
        {
          "s": 24,
          "text": "כי עיקר תפארתו ושבחו של הקב\"ה הוא לא התוספת אור שנעשה למעלה"
        },
        {
          "s": 25,
          "text": "(קיום המצוות דהקב\"ה)"
        },
        {
          "s": 26,
          "text": "שנעשה ע\"י קיום המצוות דישראל,"
        },
        {
          "s": 27,
          "text": "כי אם,"
        },
        {
          "s": 28,
          "text": "השבח דישראל גופא,"
        },
        {
          "s": 29,
          "text": "שזה דוקא מגיע ב"
        },
        {
          "s": 30,
          "text": "(בחירת)"
        },
        {
          "s": 31,
          "text": "העצמות92."
        }
      ]
    }
  ]
}