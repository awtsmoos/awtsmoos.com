{
  "globalIndex": 524,
  "owner": 24,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916815_theRebbe_81__p007",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916815_theRebbe_81__p007",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916815_theRebbe_81",
  "title": "מאמר באתי לגני תש\"ל",
  "part": 7,
  "sections": [
    {
      "v": 18,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 1,
          "text": "דזה שמאריך בהמאמר בענין גודל העילוי דהנשמה בהיותה למעלה עד להעילוי דאין זר אתו"
        },
        {
          "s": 2,
          "text": "[הגם שהתוכן דפרק זה הוא שעיקר העבודה דהנשמה הוא למטה דוקא],"
        },
        {
          "s": 3,
          "text": "הוא"
        },
        {
          "s": 4,
          "text": "(גם)"
        },
        {
          "s": 5,
          "text": "בכדי לרמז הכח שיש בהנשמה בירידתה למטה להתגבר על כל המניעות ועיכובים."
        },
        {
          "s": 6,
          "text": "והענין הוא,"
        },
        {
          "s": 7,
          "text": "דזה שהנשמה היתה ברצון אחד להוי' לבדו ואין זר אתו,"
        },
        {
          "s": 8,
          "text": "הוא"
        },
        {
          "s": 9,
          "text": "(בעיקר)"
        },
        {
          "s": 10,
          "text": "מצד שרשה בעצמות אוא\"ס שלמעלה מהרצון להאציל ולברוא."
        },
        {
          "s": 11,
          "text": "[כי בהרצון להאציל ולברוא,"
        },
        {
          "s": 12,
          "text": "כיון שהרצון הוא שיהיו עולמות,"
        },
        {
          "s": 13,
          "text": "יש שם שרש ונתינת מקום לרצון זר"
        },
        {
          "s": 14,
          "text": "(ולא רק להדרגא דרצון זר הנ\"ל,"
        },
        {
          "s": 15,
          "text": "מציאות שבטילה בתכלית,"
        },
        {
          "s": 16,
          "text": "אלא גם לרצון זר כפשוטו,"
        },
        {
          "s": 17,
          "text": "כי הרצון שיהיו עולמות הוא שיהיו גם עולמות בי\"ע עד לעוה\"ז הגשמי)."
        },
        {
          "s": 18,
          "text": "וזה שהנשמה היתה ברצון אחד להוי' לבדו ואין זר אתו,"
        },
        {
          "s": 19,
          "text": "יש לומר הכוונה בזה,"
        },
        {
          "s": 20,
          "text": "שאין גם נתינת מקום על רצון זר"
        },
        {
          "s": 21,
          "text": "(גם לא למציאות שבטילה בתכלית),"
        },
        {
          "s": 22,
          "text": "דענין זה שבנשמה הוא מצד זה שהיא מושרשת בעצמות אוא\"ס שלמעלה מהרצון על עולמות,"
        },
        {
          "s": 23,
          "text": "שאין שם שום נתינת מקום למציאות שחוץ ממנו]."
        },
        {
          "s": 24,
          "text": "וכיון שמצד שרשה בעצמות אוא\"ס,"
        },
        {
          "s": 25,
          "text": "הענין דאלא אחד שביעקב"
        },
        {
          "s": 26,
          "text": "(נשמה שלמעלה)"
        },
        {
          "s": 27,
          "text": "נמשך בגילוי גם בהשבטים"
        },
        {
          "s": 28,
          "text": "(נשמה שלמטה),"
        },
        {
          "s": 29,
          "text": "לכן,"
        },
        {
          "s": 30,
          "text": "גם בהיותה בגוף מלא רצונות זרות"
        },
        {
          "s": 31,
          "text": "(זרות כפשוטם)"
        },
        {
          "s": 32,
          "text": "ותאוות גשמיים וחומריים שמונעים את הנשמה מעבודה האלקית86,"
        },
        {
          "s": 33,
          "text": "יש לה הכח להתגבר עליהם."
        }
      ]
    },
    {
      "v": 19,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "והנה לאחרי שמבאר בהמאמר שירידת הנשמה למטה הוא בכדי לברר ולזכך את הגוף ונה\"ט ולהאיר חלקו בעולם,"
        },
        {
          "s": 3,
          "text": "מוסיף,"
        },
        {
          "s": 4,
          "text": "שעיקר העבודה"
        },
        {
          "s": 5,
          "text": "(דהנשמה)"
        },
        {
          "s": 6,
          "text": "הוא למטה דוקא."
        },
        {
          "s": 7,
          "text": "דכיון שהגוף הוא מלא רצונות זרות ותאוות גשמיים וחומריים שמונעים את הנשמה מעבודה האלקית,"
        },
        {
          "s": 8,
          "text": "לכן היא צריכה לעבודה ויגיעה עצומה במלחמה כבדה ביותר."
        },
        {
          "s": 9,
          "text": "ויש לומר,"
        },
        {
          "s": 10,
          "text": "דזה שמוסיף שעיקר העבודה הוא למטה דוקא הוא לבאר עוד ענין שנעשה בהנשמה ע\"י ירידתה למטה – המעלה דאתכפיא."
        },
        {
          "s": 11,
          "text": "דזה שאומר מקודם שירידת הנשמה למטה הוא בכדי לברר ולזכך את הגוף ונה\"ט כו' הוא שע\"י ירידתה למטה היא באה להעילוי דאתהפכא,"
        },
        {
          "s": 12,
          "text": "וזה שלמטה הוא עיקר העבודה"
        },
        {
          "s": 13,
          "text": "(עבודה ויגיעה עצומה במלחמה כבדה ביותר)"
        },
        {
          "s": 14,
          "text": "הוא שע\"י ירידתה למטה היא באה להעילוי דאתכפיא."
        },
        {
          "s": 15,
          "text": "וע\"פ המבואר לעיל"
        },
        {
          "s": 16,
          "text": "(סעיף ז),"
        },
        {
          "s": 17,
          "text": "דבפרק העשרים מבאר הנקודה הפנימית דכל הענינים שבההמשך,"
        },
        {
          "s": 18,
          "text": "שהנקודה הפנימית דכל הענינים שבעולם הוא ענינים אלה כמו שהם באדם,"
        },
        {
          "s": 19,
          "text": "יש להוסיף,"
        },
        {
          "s": 20,
          "text": "שבפרקים הקודמים מבאר"
        },
        {
          "s": 21,
          "text": "(בעיקר)"
        },
        {
          "s": 22,
          "text": "הענין דאתכפיא ואתהפכא שבעולם שנעשה ע\"י עבודת האדם,"
        },
        {
          "s": 23,
          "text": "ובפרק העשרים מבאר הענין דאתכפיא ואתהפכא שבעבודת האדם עצמה."
        }
      ]
    },
    {
      "v": 20,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "והנה בעבודת האדם ישנם ג' קוין,"
        },
        {
          "s": 3,
          "text": "תורה עבודה וגמ\"ח87."
        },
        {
          "s": 4,
          "text": "ויש לומר,"
        },
        {
          "s": 5,
          "text": "דמהטעמים על זה שקו העבודה דוקא נק' בשם עבודה,"
        },
        {
          "s": 6,
          "text": "הוא,"
        },
        {
          "s": 7,
          "text": "כי הנתינת כח על ענין העבודה שבכל ג' הקוין"
        },
        {
          "s": 8,
          "text": "(עבודה ויגיעה עצומה במלחמה כבדה ביותר),"
        },
        {
          "s": 9,
          "text": "הוא ע\"י קו העבודה,"
        },
        {
          "s": 10,
          "text": "עבודת הקרבנות88,"
        },
        {
          "s": 11,
          "text": "ובזמן הגלות – עבודת התפלה89."
        },
        {
          "s": 12,
          "text": "ויובן זה ע\"פ מה שמבאר הצ\"צ בהמאמר ד\"ה ועבדתם את הוי' אלקיכם90"
        },
        {
          "s": 13,
          "text": "שזה קאי על עבודת התפלה91,"
        },
        {
          "s": 14,
          "text": "דענין התפלה"
        },
        {
          "s": 15,
          "text": "(תפלה מלשון חיבור92)"
        },
        {
          "s": 16,
          "text": "הוא לחבר את המלכות,"
        },
        {
          "s": 17,
          "text": "בחינת ממלא כל עלמין,"
        },
        {
          "s": 18,
          "text": "עם בחינת הסובב."
        },
        {
          "s": 19,
          "text": "ושני ענינים בזה."
        },
        {
          "s": 20,
          "text": "דהתפלה עצמה"
        },
        {
          "s": 21,
          "text": "(עבודת התפלה של האדם)"
        },
        {
          "s": 22,
          "text": "היא להעלות את המלכות לאור הסובב,"
        },
        {
          "s": 23,
          "text": "ארוממך אלקי המלך93,"
        },
        {
          "s": 24,
          "text": "חיבור ממלא וסובב בדרך מלמטה למעלה,"
        },
        {
          "s": 25,
          "text": "וההמשכה מלמעלה שע\"י התפלה הוא החיבור דסובב וממלא בדרך מלמעלה למטה,"
        },
        {
          "s": 26,
          "text": "שאור הסובב שלמעלה מהשתלשלות נמשך בגילוי בהמלכות."
        },
        {
          "s": 27,
          "text": "ויש לומר,"
        },
        {
          "s": 28,
          "text": "דזהו ועבדתם את הוי' אלקיכם,"
        },
        {
          "s": 29,
          "text": "דהוי' הוא סובב ואלקים הוא ממלא94,"
        },
        {
          "s": 30,
          "text": "ופירוש ועבדתם את הוי' אלקיכם הוא,"
        },
        {
          "s": 31,
          "text": "דענין ועבדתם"
        },
        {
          "s": 32,
          "text": "(עבודת התפלה)"
        },
        {
          "s": 33,
          "text": "הוא שהוי'"
        },
        {
          "s": 34,
          "text": "(סובב)"
        },
        {
          "s": 35,
          "text": "יהי' אלקיכם,"
        },
        {
          "s": 36,
          "text": "כוחכם וחיותיכם95."
        },
        {
          "s": 37,
          "text": "וזה שע\"י התפלה נעשה יחוד סובב וממלא,"
        },
        {
          "s": 38,
          "text": "מבאר הצ\"צ שם,"
        },
        {
          "s": 39,
          "text": "כי תפלה היא סולם מוצב ארצה וראשו מגיע השמימה96,"
        },
        {
          "s": 40,
          "text": "החיבור דנשמה שבגוף"
        },
        {
          "s": 41,
          "text": "(ארצה)"
        },
        {
          "s": 42,
          "text": "עם הנשמה שלמעלה"
        },
        {
          "s": 43,
          "text": "(שמימה),"
        },
        {
          "s": 44,
          "text": "דהנשמה בגוף היא דוגמת ממלא והנשמה שלמעלה"
        },
        {
          "s": 45,
          "text": "[שהיא בחינת מקיף להנשמה שבגוף]"
        },
        {
          "s": 46,
          "text": "היא דוגמת סובב97,"
        },
        {
          "s": 47,
          "text": "וע\"י היחוד דממלא וסובב שבאדם נעשה יחוד ממלא וסובב."
        },
        {
          "s": 48,
          "text": "ויש לקשר זה עם ענין התפלה כפשוטה,"
        },
        {
          "s": 49,
          "text": "שהאדם מבקש את צרכיו,"
        },
        {
          "s": 50,
          "text": "כי מילוי הבקשות שבתפלה הוא ע\"י יחוד דסובב וממלא."
        },
        {
          "s": 51,
          "text": "דזה שנעשה שינוי בהנבראים שלמטה98"
        },
        {
          "s": 52,
          "text": "(שמתרפא החולה וכו')"
        },
        {
          "s": 53,
          "text": "הוא ע\"י המשכת אוא\"ס שלמעלה מהשתלשלות"
        },
        {
          "s": 54,
          "text": "(כי מצד ההשתלשלות הרי נגזר עליו שיהי' חולה),"
        },
        {
          "s": 55,
          "text": "וזה שע\"י המשכת האור שלמעלה מהשתלשלות נשפעות השפעות פרטיות"
        },
        {
          "s": 56,
          "text": "(ריפוי החולים,"
        },
        {
          "s": 57,
          "text": "ברכת השנים וכיו\"ב)"
        },
        {
          "s": 58,
          "text": "הוא על ידי שהאור שלמעלה מהשתלשלות נמשך בהשתלשלות."
        }
      ]
    }
  ]
}