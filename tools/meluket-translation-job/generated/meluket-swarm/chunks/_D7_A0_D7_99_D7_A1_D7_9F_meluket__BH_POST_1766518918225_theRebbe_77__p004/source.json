{
  "globalIndex": 762,
  "owner": 12,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918225_theRebbe_77__p004",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918225_theRebbe_77__p004",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518918225_theRebbe_77",
  "title": "מאמר הפך ים ליבשה תשכ\"ז",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "וזהו גם מ\"ש49"
        },
        {
          "s": 1,
          "text": "ברוך הוי' אלקי ישראל מן העולם ועד העולם,"
        },
        {
          "s": 2,
          "text": "שעבודתם של נש\"י בירידתן למטה לעסוק בקיום התומ\"צ שנתלבשו בעניני העולם,"
        },
        {
          "s": 3,
          "text": "היא,"
        },
        {
          "s": 4,
          "text": "להמשיך"
        },
        {
          "s": 5,
          "text": "(ברוך מלשון המשכה50)"
        },
        {
          "s": 6,
          "text": "אלקות"
        },
        {
          "s": 7,
          "text": "(הוי')"
        },
        {
          "s": 8,
          "text": "מעלמא דאתכסייא"
        },
        {
          "s": 9,
          "text": "(מן העולם)"
        },
        {
          "s": 10,
          "text": "לעלמא דאתגלייא"
        },
        {
          "s": 11,
          "text": "(עד העולם),"
        },
        {
          "s": 12,
          "text": "שגם בעלמא דאתגלייא יהי' הביטול לאלקות ע\"ד ובדוגמת הביטול שבעלמא דאתכסייא,"
        },
        {
          "s": 13,
          "text": "שזוהי תכלית הכוונה דבריאת העולם,"
        },
        {
          "s": 14,
          "text": "שנתאווה הקב\"ה להיות לו ית' דירה בתחתונים51."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "אמנם עדיין צריך להבין,"
        },
        {
          "s": 2,
          "text": "דלכאורה,"
        },
        {
          "s": 3,
          "text": "כאשר ההתבוננות בהענין דיחו\"ע,"
        },
        {
          "s": 4,
          "text": "שמע ישראל גו' הוי' אחד,"
        },
        {
          "s": 5,
          "text": "היא התבוננות אמיתית,"
        },
        {
          "s": 6,
          "text": "צריך להיות מזה ענין של כלות הנפש,"
        },
        {
          "s": 7,
          "text": "ע\"ד מ\"ש52"
        },
        {
          "s": 8,
          "text": "בבני אהרן בקרבתם לפני ה' וימותו,"
        },
        {
          "s": 9,
          "text": "שכלתה נפשם מגודל הקירוב וכו'53."
        },
        {
          "s": 10,
          "text": "ועד\"ז בנוגע לההמשכה מן העולם ועד העולם,"
        },
        {
          "s": 11,
          "text": "מעלמא דאתכסייא לעלמא דאתגלייא,"
        },
        {
          "s": 12,
          "text": "שהמשכה כזו צריכה לפעול ביטול מציאותם של הנבראים שבעלמא דאתגלייא,"
        },
        {
          "s": 13,
          "text": "בדוגמת הברואים שביבשה שאינם יכולים לבוא בים,"
        },
        {
          "s": 14,
          "text": "לפי שטובעים בו ובטלים ממציאותם."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "אך הענין הוא,"
        },
        {
          "s": 1,
          "text": "שיש נתינת כח ממקום עליון יותר,"
        },
        {
          "s": 2,
          "text": "שמצד זה הנה גם כאשר מתבונן בהענין דיחו\"ע בהתבוננות אמיתית לא יבוא לידי כלות הנפש אלא ישאר נשמה בגוף,"
        },
        {
          "s": 3,
          "text": "וגם כאשר יומשך מעלמא דאתכסייא לעלמא דאתגלייא תשאר מציאותם של הברואים שביבשה ולא יבטלו ממציאותם."
        },
        {
          "s": 4,
          "text": "דהנה,"
        },
        {
          "s": 5,
          "text": "ידוע54"
        },
        {
          "s": 6,
          "text": "שהענין דנתאווה הקב\"ה להיות לו ית' דירה בתחתונים הוא בעצמותו ית',"
        },
        {
          "s": 7,
          "text": "שהוא למעלה מעלמין סתימין ועלמין דאתגליין שהם ים ויבשה,"
        },
        {
          "s": 8,
          "text": "למעלה ממקורם בבחי' המלכות גם כמו שהיא בעלייתה לבחי' חו\"ב,"
        },
        {
          "s": 9,
          "text": "שזהו\"ע ים"
        },
        {
          "s": 10,
          "text": "(כנ\"ל ס\"ב),"
        },
        {
          "s": 11,
          "text": "ולמעלה מב' הדעות,"
        },
        {
          "s": 12,
          "text": "שהרי גם דעת עליון שלמעלה הוא יש להיותו מקור החיות דכל הנבראים שלמטה,"
        },
        {
          "s": 13,
          "text": "ה\"ז רק הארה לבד שנחשבת לאין לגבי עצמותו ית',"
        },
        {
          "s": 14,
          "text": "וכמ\"ש55"
        },
        {
          "s": 15,
          "text": "כי עמך מקור חיים,"
        },
        {
          "s": 16,
          "text": "היינו,"
        },
        {
          "s": 17,
          "text": "שמקור החיים של כל העולמות,"
        },
        {
          "s": 18,
          "text": "הן עלמין דאתגליין והן עלמין סתימין,"
        },
        {
          "s": 19,
          "text": "אינו אלא עמך,"
        },
        {
          "s": 20,
          "text": "שטפל ובטל לך,"
        },
        {
          "s": 21,
          "text": "שאינו בערך כלל לעצמותו ית'."
        },
        {
          "s": 22,
          "text": "וכיון שעצמותו ית' נתאווה להיות לו דירה בתחתונים דוקא,"
        },
        {
          "s": 23,
          "text": "בעוה\"ז הגשמי דוקא,"
        },
        {
          "s": 24,
          "text": "ע\"י עבודת בנ\"י נשמות בגופים דוקא,"
        },
        {
          "s": 25,
          "text": "ולא תוהו בראה"
        },
        {
          "s": 26,
          "text": "(אלא)"
        },
        {
          "s": 27,
          "text": "לשבת יצרה56,"
        },
        {
          "s": 28,
          "text": "ה\"ז פועל אצל בנ\"י שההתבוננות בהענין דיחו\"ע לא תהי' באופן של כלות הנפש"
        },
        {
          "s": 29,
          "text": "(כמו אצל שני בני אהרן),"
        },
        {
          "s": 30,
          "text": "אלא באופן שישארו במציאותם נשמות בגופים דוקא,"
        },
        {
          "s": 31,
          "text": "גוף גשמי דוקא,"
        },
        {
          "s": 32,
          "text": "ששרשו מיש האמיתי57"
        },
        {
          "s": 33,
          "text": "שלמעלה גם מבחי' כי עמך מקור חיים."
        },
        {
          "s": 34,
          "text": "וזוהי גם הנתינת כח שתהי' ההמשכה מעלמא דאתכסייא לעלמא דאתגלייא באופן שלא תתבטל מציאותם של הברואים שביבשה,"
        },
        {
          "s": 35,
          "text": "שענין זה הוא בכח העצמות,"
        },
        {
          "s": 36,
          "text": "שאצלו עלמא דאתכסייא ועלמא דאתגלייא,"
        },
        {
          "s": 37,
          "text": "ים ויבשה,"
        },
        {
          "s": 38,
          "text": "הם בהשוואה ממש,"
        },
        {
          "s": 39,
          "text": "ולכן בכחו לפעול שתהי' ההמשכה מעלמא דאתכסייא בעלמא דאתגלייא שהברואים שבו הם בדוגמת ברואים שביבשה שנראים ליש ומציאות בפ\"ע,"
        },
        {
          "s": 40,
          "text": "שענין זה נעשה ע\"י ההעלם וההסתר שמצד מדת הגבורה"
        },
        {
          "s": 41,
          "text": "(כנ\"ל ס\"ג),"
        },
        {
          "s": 42,
          "text": "שבה מתגלה שלימותו ית',"
        },
        {
          "s": 43,
          "text": "שלימותא דכולא58,"
        },
        {
          "s": 44,
          "text": "יותר מאשר במדת הגדולה,"
        },
        {
          "s": 45,
          "text": "לפי שעל ידה נעשה בנבראים הרגש היש,"
        },
        {
          "s": 46,
          "text": "מצד שרשם ביש האמיתי כו'59."
        }
      ]
    }
  ]
}