{
  "globalIndex": 20,
  "owner": 20,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913794_theRebbe_460__p002",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913794_theRebbe_460__p002",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518913794_theRebbe_460",
  "title": "מאמר וביום שמחתכם תש\"מ",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה לא זו בלבד שצריך לעשי' גשמית"
        },
        {
          "s": 2,
          "text": "(ואין מספיק ענין התשובה ברוחניות וגם לא אמירת הפסוקים),"
        },
        {
          "s": 3,
          "text": "אלא שבזה גופא אין מספיק שיהי' קלא פנימאה של האדם וצריך לתקוע בקול שופר של בהמה דוקא18,"
        },
        {
          "s": 4,
          "text": "ביעל פשוט או בזכרים כפופים,"
        },
        {
          "s": 5,
          "text": "כב' הדיעות שבזה דאלו ואלו דברי אלקים חיים19."
        },
        {
          "s": 6,
          "text": "וגם עכשיו,"
        },
        {
          "s": 7,
          "text": "שתוקעין"
        },
        {
          "s": 8,
          "text": "(בר\"ה)"
        },
        {
          "s": 9,
          "text": "בזכרים כפופים,"
        },
        {
          "s": 10,
          "text": "יש ב' ענינים אלו בעבודה הרוחנית."
        },
        {
          "s": 11,
          "text": "של יעל פשוט כי כמה דפשיט איניש דעתי' טפי מעלי20"
        },
        {
          "s": 12,
          "text": "ומבואר בחסידות21"
        },
        {
          "s": 13,
          "text": "שהוא מה שהאדם צריך להפשיט את עצמו מכל רצונותיו."
        },
        {
          "s": 14,
          "text": "ואין הכוונה לרצונות הבלתי רצויים,"
        },
        {
          "s": 15,
          "text": "כי מאי קמ\"ל,"
        },
        {
          "s": 16,
          "text": "וענין זה"
        },
        {
          "s": 17,
          "text": "(שלא יהיו אצלו רצונות בלתי רצויים)"
        },
        {
          "s": 18,
          "text": "כבר נעשה ע\"י העבודה בחודש אלול לפני ר\"ה."
        },
        {
          "s": 19,
          "text": "וענין דפשיט איניש דעתי' שבר\"ה הוא שיפשוט את עצמו מכל ציור גם מציור דקדושה."
        },
        {
          "s": 20,
          "text": "כי ההמשכה דר\"ה היא ממה שלמעלה מגדר מקום ומגדר ציור,"
        },
        {
          "s": 21,
          "text": "ולכן צריך להיות העבודה דפשיט,"
        },
        {
          "s": 22,
          "text": "וע\"י הפשטות שבאדם הוא ממשיך הפשטות שלמעלה,"
        },
        {
          "s": 23,
          "text": "ועד מבחי' תכלית הפשיטות."
        },
        {
          "s": 24,
          "text": "ותוקעין בשל זכרים כפופים כי כמה דכייף איניש דעתי' טפי מעלי20"
        },
        {
          "s": 25,
          "text": "ומבואר בחסידות21"
        },
        {
          "s": 26,
          "text": "שהוא העבודה דאתכפיא"
        },
        {
          "s": 27,
          "text": "(שיש בזה מעלה גם על העבודה דהפשטת הרצונות22),"
        },
        {
          "s": 28,
          "text": "שעבודה זו היא ע\"י בחי' זכר"
        },
        {
          "s": 29,
          "text": "(זכרים כפופים),"
        },
        {
          "s": 30,
          "text": "איש דרכו לכבוש23."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "וזהו מצות היום בשופר,"
        },
        {
          "s": 2,
          "text": "שע\"י העבודה דשופר בב' האופנים דפשיט ודכייף"
        },
        {
          "s": 3,
          "text": "[שבכל אחד מהם יש מעלה מיוחדת]"
        },
        {
          "s": 4,
          "text": "ממשיכים אור חדש,"
        },
        {
          "s": 5,
          "text": "וכמבואר באגה\"ק24"
        },
        {
          "s": 6,
          "text": "שבכל ר\"ה נמשך אור חדש שלא הי' מעולם,"
        },
        {
          "s": 7,
          "text": "ועי\"ז נעשה חידוש בכל סדר ההשתלשלות,"
        },
        {
          "s": 8,
          "text": "ועד שנעשה חידוש גם בחיצוניות העולמות."
        },
        {
          "s": 9,
          "text": "ועם היות שעיקר החידוש שבר\"ה הוא בפנימיות העולמות,"
        },
        {
          "s": 10,
          "text": "הנה עי\"ז נעשה חידוש גם בחיצוניות העולמות,"
        },
        {
          "s": 11,
          "text": "כמבואר בסידור25"
        },
        {
          "s": 12,
          "text": "בד\"ה להבין ענין תק\"ש ע\"פ כוונת הבעש\"ט ז\"ל."
        },
        {
          "s": 13,
          "text": "וכל זה נעשה ע\"י ישראל עם קרובו,"
        },
        {
          "s": 14,
          "text": "בנים אתם לה' אלקיכם26,"
        },
        {
          "s": 15,
          "text": "כמו שמבאר הרב המגיד בלקו\"א ואו\"ת בתחלתם בענין במי נמלך בנשמותיהן של צדיקים27,"
        },
        {
          "s": 16,
          "text": "שעלה לפניו ית' התענוג שיתענג בעבודתם של ישראל,"
        },
        {
          "s": 17,
          "text": "וזה החליט את הרצון,"
        },
        {
          "s": 18,
          "text": "ומבחי' רצון המוחלט נמשך לרצון הגלוי,"
        },
        {
          "s": 19,
          "text": "ואח\"כ נמשך בכל סדר ההשתלשלות עד בעוה\"ז התחתון שאין תחתון למטה ממנו,"
        },
        {
          "s": 20,
          "text": "שעי\"ז דוקא נשלמה הכוונה דדירה לו ית' בתחתונים28."
        },
        {
          "s": 21,
          "text": "וזהו אמרו לפני מלכיות כדי שתמליכוני עליכם כו' ובמה בשופר,"
        },
        {
          "s": 22,
          "text": "שפירושו תקיעת שופר במעשה,"
        },
        {
          "s": 23,
          "text": "דמצות היום בשופר,"
        },
        {
          "s": 24,
          "text": "אלא שנכלל בזה"
        },
        {
          "s": 25,
          "text": "(בהמשך להתחלת המאמר אמרו לפני כו' ושופרות)"
        },
        {
          "s": 26,
          "text": "גם אמירת פסוקי שופרות11"
        },
        {
          "s": 27,
          "text": "[ובפרט שעפ\"ז יש להתאים גירסתנו בגמרא להגירסא29"
        },
        {
          "s": 28,
          "text": "אמרו לפני מלכיות כדי כו' זכרונות כדי כו' שופרות כדי כו' וי\"ג לאח\"ז30"
        },
        {
          "s": 29,
          "text": "ובמה בשופר]."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והנה פסוק זה"
        },
        {
          "s": 2,
          "text": "(וביום שמחתכם גו' ותקעתם בחצוצרות גו')"
        },
        {
          "s": 3,
          "text": "הוא המשך וסיום הענין דלפנ\"ז31"
        },
        {
          "s": 4,
          "text": "עשה לך שתי חצוצרות גו',"
        },
        {
          "s": 5,
          "text": "וידועה תורת הרב המגיד32"
        },
        {
          "s": 6,
          "text": "שתי חצוצרות שתי חצאי צורות,"
        },
        {
          "s": 7,
          "text": "היינו שהקב\"ה וכנס\"י הם"
        },
        {
          "s": 8,
          "text": "[כביכול,"
        },
        {
          "s": 9,
          "text": "ואולי גם בלי כביכול]"
        },
        {
          "s": 10,
          "text": "שתי חצאי צורות."
        },
        {
          "s": 11,
          "text": "ומזה מובן פירוש הכתוב ותקעתם בחצוצרות גו' והיו לכם לזכרון לפני אלקיכם אני ה' אלקיכם,"
        },
        {
          "s": 12,
          "text": "שענין מלכיות"
        },
        {
          "s": 13,
          "text": "(אני ה' אלקיכם)"
        },
        {
          "s": 14,
          "text": "וזכרונות"
        },
        {
          "s": 15,
          "text": "(והיו לכם לזכרון)"
        },
        {
          "s": 16,
          "text": "שנעשה ע\"י ותקעתם בחצוצרות,"
        },
        {
          "s": 17,
          "text": "בחצוצרות וקול שופר הריעו לפני המלך הוי'33"
        },
        {
          "s": 18,
          "text": "[שבמקדש"
        },
        {
          "s": 19,
          "text": "(לפני אלקיכם,"
        },
        {
          "s": 20,
          "text": "לפני המלך הוי')"
        },
        {
          "s": 21,
          "text": "היו שניהם"
        },
        {
          "s": 22,
          "text": "(אלא שמצות היום בשופר,"
        },
        {
          "s": 23,
          "text": "כמבואר במשנה12),"
        },
        {
          "s": 24,
          "text": "וע\"י החלונות שקופים אטומים שהיו בביהמ\"ק34,"
        },
        {
          "s": 25,
          "text": "נמשך זה"
        },
        {
          "s": 26,
          "text": "(ככל הענינים שבביהמ\"ק)"
        },
        {
          "s": 27,
          "text": "גם בגבולין ועד בכל העולם כולו."
        },
        {
          "s": 28,
          "text": "ואפילו בזמן הגלות],"
        },
        {
          "s": 29,
          "text": "הוא מפני שהקב\"ה וישראל הם שתי חצאי צורות35."
        },
        {
          "s": 30,
          "text": "והענין הוא,"
        },
        {
          "s": 31,
          "text": "דנפש השנית בישראל היא חלק אלוקה ממעל ממש36,"
        },
        {
          "s": 32,
          "text": "וידוע37"
        },
        {
          "s": 33,
          "text": "שיש בזה ב' קצוות."
        },
        {
          "s": 34,
          "text": "כי ממש קאי על חלק אלוקה ממעל,"
        },
        {
          "s": 35,
          "text": "היינו שנפש השנית שבישראל היא חלק ממש מעצומ\"ה,"
        },
        {
          "s": 36,
          "text": "וידוע מאמר הבעש\"ט38"
        },
        {
          "s": 37,
          "text": "העצם כשאתה תופס בחלקו אתה תופס בכולו,"
        },
        {
          "s": 38,
          "text": "ותיבת ממש מורה גם על קצה הכי תחתון,"
        },
        {
          "s": 39,
          "text": "ממש מה שנתפס בחוש המישוש."
        },
        {
          "s": 40,
          "text": "וזהו מה שנפש השנית שבישראל היא חלק אלוקה ממעל ממש,"
        },
        {
          "s": 41,
          "text": "שגם כשהיא מלובשת בגוף ממש מלשון מישוש,"
        },
        {
          "s": 42,
          "text": "גם אז היא חלק ממש ממהו\"ע ית',"
        },
        {
          "s": 43,
          "text": "חד ממש עם עצומ\"ה,"
        },
        {
          "s": 44,
          "text": "וכתורת הרב המגיד"
        },
        {
          "s": 45,
          "text": "(שהובא לעיל)"
        },
        {
          "s": 46,
          "text": "שהם שתי חצאי צורות."
        },
        {
          "s": 47,
          "text": "והנה מכיון שאתם קרויין אדם39"
        },
        {
          "s": 48,
          "text": "על שם אדמה לעליון40,"
        },
        {
          "s": 49,
          "text": "מובן שענין שתי חצאי צורות הוא גם בהנשמה עצמה."
        },
        {
          "s": 50,
          "text": "דהנה ידוע41"
        },
        {
          "s": 51,
          "text": "שבכל נשמה יש ב' דרגות כלליות,"
        },
        {
          "s": 52,
          "text": "חלק הנשמה שלמעלה"
        },
        {
          "s": 53,
          "text": "(בחי' מזל)"
        },
        {
          "s": 54,
          "text": "ראש שבנשמה,"
        },
        {
          "s": 55,
          "text": "וחלק הנשמה שבגוף"
        },
        {
          "s": 56,
          "text": "(כחות הגלויים)"
        },
        {
          "s": 57,
          "text": "רגל שבנשמה."
        },
        {
          "s": 58,
          "text": "וב' בחי' אלו הם השתי חצאי צורות שבכל נשמה פרטית42."
        },
        {
          "s": 59,
          "text": "וענין ותקעתם בחצוצרות גו' והיו לכם לזכרון לפני אלקיכם גו' הוא שצריך לחבר ב' חצאי צורות שלו43"
        },
        {
          "s": 60,
          "text": "ולהעמידם"
        },
        {
          "s": 61,
          "text": "(אַוועקשטעלן זיי)"
        },
        {
          "s": 62,
          "text": "לפני ה' אלקיכם,"
        },
        {
          "s": 63,
          "text": "וע\"י החיבור דב' חצאי צורות אלו"
        },
        {
          "s": 64,
          "text": "(ראש ורגל)"
        },
        {
          "s": 65,
          "text": "שבכל נשמה פרטית,"
        },
        {
          "s": 66,
          "text": "עי\"ז נעשה גם החיבור דראש ורגל שבכללות ישראל והעלאתם לפני ה' אלקיכם,"
        },
        {
          "s": 67,
          "text": "אתם נצבים היום"
        },
        {
          "s": 68,
          "text": "(ר\"ה44)"
        },
        {
          "s": 69,
          "text": "כולכם לפני ה' אלקיכם ראשיכם גו' עד חוטב עציך ושואב מימיך,"
        },
        {
          "s": 70,
          "text": "שכל ישראל"
        },
        {
          "s": 71,
          "text": "[הראש דישראל"
        },
        {
          "s": 72,
          "text": "(ראשיכם)"
        },
        {
          "s": 73,
          "text": "והרגל דישראל"
        },
        {
          "s": 74,
          "text": "(חוטב עציך ושואב מימיך)]"
        },
        {
          "s": 75,
          "text": "מתחברים יחד והם נצבים ומתעלים לפני ה' אלקיכם45,"
        },
        {
          "s": 76,
          "text": "והם נעשים עמו דבר אחד כמו שממשיך בכתוב46"
        },
        {
          "s": 77,
          "text": "לעברך בברית גו' שענין הברית הוא שהם נעשים לדבר אחד47."
        }
      ]
    }
  ]
}