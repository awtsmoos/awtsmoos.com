{
  "globalIndex": 241,
  "owner": 41,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915193_theRebbe_723__p006",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915193_theRebbe_723__p006",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518915193_theRebbe_723",
  "title": "מאמר ויאמר לו יהונתן תשמ\"ה",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "והנה נתבאר לעיל"
        },
        {
          "s": 2,
          "text": "(בתחילת המאמר)"
        },
        {
          "s": 3,
          "text": "דענין מחר חודש הוא43"
        },
        {
          "s": 4,
          "text": "המשכת אור חדש."
        },
        {
          "s": 5,
          "text": "ויש לקשר זה עם מ\"ש בדרושי הצ\"צ דמחר"
        },
        {
          "s": 6,
          "text": "(חודש)"
        },
        {
          "s": 7,
          "text": "קאי אלע\"ל,"
        },
        {
          "s": 8,
          "text": "ע\"ד מארז\"ל44"
        },
        {
          "s": 9,
          "text": "למחר לקבל שכרם,"
        },
        {
          "s": 10,
          "text": "כי לע\"ל יהי' גילוי אור חדש שלא האיר גם קודם הצמצום."
        },
        {
          "s": 11,
          "text": "ועי\"ז יהי' אז חידוש הכי עליון בכל הענינים,"
        },
        {
          "s": 12,
          "text": "בישראל – שהם עתידים להתחדש כמותה45,"
        },
        {
          "s": 13,
          "text": "בתורה – תורה חדשה מאתי תצא46,"
        },
        {
          "s": 14,
          "text": "וע\"י ישראל ותורה יהי' חידוש גם בהבריאה – שמים חדשים וארץ חדשה47."
        },
        {
          "s": 15,
          "text": "וממשיך הכתוב,"
        },
        {
          "s": 16,
          "text": "כן יעמוד זרעכם ושמכם,"
        },
        {
          "s": 17,
          "text": "שגם לע\"ל,"
        },
        {
          "s": 18,
          "text": "כשיהי' שמים וארץ חדשים יהי' עומד וניכר העבודה דישראל48"
        },
        {
          "s": 19,
          "text": "עכשיו,"
        },
        {
          "s": 20,
          "text": "שעל ידה נעשה החידוש."
        },
        {
          "s": 21,
          "text": "והקב\"ה ישתעשע"
        },
        {
          "s": 22,
          "text": "(וועט זיך צאַצקען)"
        },
        {
          "s": 23,
          "text": "עם ישראל,"
        },
        {
          "s": 24,
          "text": "שעל ידם נתמלא הכוסף והתשוקה שלו להיות לו דירה בתחתונים."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "ויהי רצון,"
        },
        {
          "s": 1,
          "text": "שהדיבור בענינים אלה,"
        },
        {
          "s": 2,
          "text": "ובפרט בשבת מברכים החודש,"
        },
        {
          "s": 3,
          "text": "ויתירה מזה בערב ר\"ח"
        },
        {
          "s": 4,
          "text": "[מחר חודש],"
        },
        {
          "s": 5,
          "text": "ימהר ויזרז הגילוי דדוד מלכא משיחא,"
        },
        {
          "s": 6,
          "text": "דוד מלך ישראל חי וקיים49,"
        },
        {
          "s": 7,
          "text": "יבוא ויגאלנו ויוליכנו קוממיות לארצנו,"
        },
        {
          "s": 8,
          "text": "בגאולה האמיתית והשלימה."
        },
        {
          "s": 9,
          "text": "וכל זה באופן דמיד,"
        },
        {
          "s": 10,
          "text": "ע\"ד מולד הלבנה שהוא ברגע כמימרא,"
        },
        {
          "s": 11,
          "text": "מיד הן נגאלין50."
        }
      ]
    }
  ]
}