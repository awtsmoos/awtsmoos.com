{
  "globalIndex": 518,
  "owner": 18,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916815_theRebbe_81__p001",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916815_theRebbe_81__p001",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916815_theRebbe_81",
  "title": "מאמר באתי לגני תש\"ל",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "מוצש\"ק פ' בא,"
        },
        {
          "s": 2,
          "text": "יו\"ד שבט ה'תש\"ל"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "באתי לגני אחותי כלה1,"
        },
        {
          "s": 1,
          "text": "ומביא כ\"ק מו\"ח אדמו\"ר בעל ההילולא בהמאמר דיום ההסתלקות ויום ההילולא שלו2,"
        },
        {
          "s": 2,
          "text": "דאיתא במדרש רבה"
        },
        {
          "s": 3,
          "text": "(במקומו)"
        },
        {
          "s": 4,
          "text": "לגני לגנוני,"
        },
        {
          "s": 5,
          "text": "למקום שהי' עיקרי בתחלה,"
        },
        {
          "s": 6,
          "text": "דעיקר שכינה בתחתונים היתה,"
        },
        {
          "s": 7,
          "text": "אלא שע\"י הענינים הבלתי רצויים"
        },
        {
          "s": 8,
          "text": "(מתחיל מחטא עץ הדעת)"
        },
        {
          "s": 9,
          "text": "נסתלקה השכינה מלמטה למעלה עד לרקיע השביעי,"
        },
        {
          "s": 10,
          "text": "ואח\"כ עמדו צדיקים"
        },
        {
          "s": 11,
          "text": "(מתחיל מאברהם אבינו,"
        },
        {
          "s": 12,
          "text": "אחד הי' אברהם3)"
        },
        {
          "s": 13,
          "text": "והורידו את השכינה מלמעלה למטה,"
        },
        {
          "s": 14,
          "text": "עד שבא משה שהוא השביעי,"
        },
        {
          "s": 15,
          "text": "וכל השביעין חביבין4,"
        },
        {
          "s": 16,
          "text": "והורידה למטה בארץ."
        },
        {
          "s": 17,
          "text": "דענין זה"
        },
        {
          "s": 18,
          "text": "(המשכת וירידת השכינה למטה בארץ)"
        },
        {
          "s": 19,
          "text": "נעשה בעיקר5"
        },
        {
          "s": 20,
          "text": "ע\"י המשכן שעשה משה כמ\"ש6"
        },
        {
          "s": 21,
          "text": "ועשו לי מקדש ושכנתי בתוכם."
        },
        {
          "s": 22,
          "text": "ומבאר בהמאמר,"
        },
        {
          "s": 23,
          "text": "דזה שעיקר שכינה בתחתונים היתה,"
        },
        {
          "s": 24,
          "text": "הוא,"
        },
        {
          "s": 25,
          "text": "כי תכלית הכוונה בבריאת והתהוות העולמות הוא שנתאוה הקב\"ה להיות לו ית' דירה בתחתונים7."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דכמו שהירידה"
        },
        {
          "s": 2,
          "text": "(וההשתלשלות)"
        },
        {
          "s": 3,
          "text": "בכללות העולמות היא לצורך עלי',"
        },
        {
          "s": 4,
          "text": "שירידת האור האלקי להוות ולהחיות הנבראים דבי\"ע ועד להנבראים דעוה\"ז התחתון הוא בשביל העלי' שנעשית עי\"ז8,"
        },
        {
          "s": 5,
          "text": "עד\"ז הוא בנוגע להירידה שבעוה\"ז עצמו,"
        },
        {
          "s": 6,
          "text": "שהירידה שנעשתה בו ע\"י חטא עה\"ד והענינים הבלתי רצויים שלאח\"ז הוא צורך עלי'9,"
        },
        {
          "s": 7,
          "text": "בכדי שהמשכת עיקר שכינה למטה עכשיו"
        },
        {
          "s": 8,
          "text": "(לאחרי שנסתלקה)"
        },
        {
          "s": 9,
          "text": "תהי' נעלית יותר מהמשכת עיקר שכינה בתחתונים שהיתה בתחלת הבריאה."
        }
      ]
    }
  ]
}