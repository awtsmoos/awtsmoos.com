{
  "globalIndex": 40,
  "owner": 40,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913912_theRebbe_602__p002",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913912_theRebbe_602__p002",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518913912_theRebbe_602",
  "title": "מאמר אדון עולם תשמ\"ג",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ומבאר בהמאמר"
        },
        {
          "s": 2,
          "text": "(ד\"ה אדון עולם13),"
        },
        {
          "s": 3,
          "text": "דע\"י מעשה המצוות נעשה בנין הכלים דז\"א,"
        },
        {
          "s": 4,
          "text": "וגם המשכת האור בהכלים דז\"א."
        },
        {
          "s": 5,
          "text": "וענין זה שייך גם ל"
        },
        {
          "s": 6,
          "text": "(התחלת ההמשך)"
        },
        {
          "s": 7,
          "text": "יו\"ט של ראש השנה שחל להיות בשבת במקדש היו תוקעין אבל לא במדינה14,"
        },
        {
          "s": 8,
          "text": "כמ\"ש בהמאמר דאדמו\"ר הצ\"צ15"
        },
        {
          "s": 9,
          "text": "(שעליו מיוסד המאמר שנאמר בערב ראש השנה)"
        },
        {
          "s": 10,
          "text": "הטעם על מה שבראש השנה שחל להיות בשבת אין תוקעין במדינה,"
        },
        {
          "s": 11,
          "text": "כי המצוות שלנו הוא"
        },
        {
          "s": 12,
          "text": "(בכדי)"
        },
        {
          "s": 13,
          "text": "שע\"י אתעדל\"ת אתעדל\"ע,"
        },
        {
          "s": 14,
          "text": "שע\"י עשיית המצוות דהאדם נעשים המצוות שלמעלה"
        },
        {
          "s": 15,
          "text": "(רמ\"ח פיקודין אינון רמ\"ח אברין דמלכא16)."
        },
        {
          "s": 16,
          "text": "דכמו\"כ הוא גם במצות תקיעת שופר שענינה הוא בכדי לעשות עי\"ז בחינת השופר שלמעלה,"
        },
        {
          "s": 17,
          "text": "ולכן בראש השנה שחל בשבת אין תוקעין"
        },
        {
          "s": 18,
          "text": "(במדינה),"
        },
        {
          "s": 19,
          "text": "כי בשבת יש בחינת השופר שלמעלה"
        },
        {
          "s": 20,
          "text": "(בחינת התענוג)"
        },
        {
          "s": 21,
          "text": "גם בלי עבודת האדם,"
        },
        {
          "s": 22,
          "text": "מצד השבת,"
        },
        {
          "s": 23,
          "text": "ושבת הרי מקדשא וקיימא17."
        },
        {
          "s": 24,
          "text": "ומה שבמקדש היו תוקעין גם בראש השנה שחל בשבת הוא לפי שבמקדש,"
        },
        {
          "s": 25,
          "text": "שזה שער השמים18,"
        },
        {
          "s": 26,
          "text": "הי' נתינת כח לעשות בחינה נעלית יותר בתענוג"
        },
        {
          "s": 27,
          "text": "(כמשנ\"ת בארוכה בהמאמר דערב ראש השנה)."
        },
        {
          "s": 28,
          "text": "וענין זה,"
        },
        {
          "s": 29,
          "text": "דהמצוות"
        },
        {
          "s": 30,
          "text": "(הענינים)"
        },
        {
          "s": 31,
          "text": "שלמעלה נעשים דוקא ע\"י קיום המצוות דהאדם,"
        },
        {
          "s": 32,
          "text": "הוא בכל הבחינות וכל הפרצופים דכל סדר ההשתלשלות,"
        },
        {
          "s": 33,
          "text": "כתורת הרב המגיד19"
        },
        {
          "s": 34,
          "text": "בפירוש המשנה20"
        },
        {
          "s": 35,
          "text": "דע מה למעלה ממך דכל מה שלמעלה הוא ממך."
        },
        {
          "s": 36,
          "text": "דבחינת התענוג"
        },
        {
          "s": 37,
          "text": "(שופר)"
        },
        {
          "s": 38,
          "text": "שלמעלה נעשית"
        },
        {
          "s": 39,
          "text": "(כנ\"ל)"
        },
        {
          "s": 40,
          "text": "על ידי קיום מצות תקיעת שופר,"
        },
        {
          "s": 41,
          "text": "ובחינת המוחין שלמעלה"
        },
        {
          "s": 42,
          "text": "(שהו\"ע התפילין,"
        },
        {
          "s": 43,
          "text": "כידוע21"
        },
        {
          "s": 44,
          "text": "דד' הפרשיות הם בחינת ד' מוחין)"
        },
        {
          "s": 45,
          "text": "נעשית ע\"י קיום מצות תפילין,"
        },
        {
          "s": 46,
          "text": "דעל ידי שהאדם מניח תפילין עושה שהקב\"ה מניח תפילין22,"
        },
        {
          "s": 47,
          "text": "וכן הוא גם בהמדות"
        },
        {
          "s": 48,
          "text": "(דז\"א),"
        },
        {
          "s": 49,
          "text": "דעל ידי שהאדם שלמטה מקיים מצות ואהבת את הוי' אלקיך ומצות את הוי' אלקיך תירא23"
        },
        {
          "s": 50,
          "text": "(דאהוי\"ר הם השרש לכל המצוות24)"
        },
        {
          "s": 51,
          "text": "נעשה עי\"ז הבנין דז\"א,"
        },
        {
          "s": 52,
          "text": "וכן הוא גם בבחינת המלכות,"
        },
        {
          "s": 53,
          "text": "דבנין עולם הדיבור"
        },
        {
          "s": 54,
          "text": "(מלכות)"
        },
        {
          "s": 55,
          "text": "נעשה ע\"י הדיבור של אדם התחתון בדברי תורה ודברי תפלה."
        },
        {
          "s": 56,
          "text": "וזהו תוכן הענין דקיום המצוות"
        },
        {
          "s": 57,
          "text": "(לפי המבואר במאמרים אלו),"
        },
        {
          "s": 58,
          "text": "כי הבחינות שלמעלה הם"
        },
        {
          "s": 59,
          "text": "(בכלל)"
        },
        {
          "s": 60,
          "text": "במספר רמ\"ח"
        },
        {
          "s": 61,
          "text": "(רמ\"ח אברין דמלכא),"
        },
        {
          "s": 62,
          "text": "ובנין כל הבחינות שלמעלה הוא על ידי קיום רמ\"ח מצוות עשה"
        },
        {
          "s": 63,
          "text": "(דהאדם),"
        },
        {
          "s": 64,
          "text": "וכמ\"ש25"
        },
        {
          "s": 65,
          "text": "ועשיתם אותם,"
        },
        {
          "s": 66,
          "text": "אתם כתיב,"
        },
        {
          "s": 67,
          "text": "מעלה אני עליכם כאילו עשאוני26."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וצריך להבין,"
        },
        {
          "s": 2,
          "text": "הרי ידוע27"
        },
        {
          "s": 3,
          "text": "שהעילוי בקיום המצוות הוא כשהקיום הוא מפני שזהו ציווי הקב\"ה"
        },
        {
          "s": 4,
          "text": "(וכנוסח ברכת המצוות אשר קדשנו במצותיו וצונו)"
        },
        {
          "s": 5,
          "text": "ולא מצד הטעם28"
        },
        {
          "s": 6,
          "text": "והסגולה שבהם,"
        },
        {
          "s": 7,
          "text": "כולל גם הטעם שע\"י קיום המצוות נעשים המצוות שלמעלה."
        },
        {
          "s": 8,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 9,
          "text": "דבמצוות"
        },
        {
          "s": 10,
          "text": "(הרצון והציווי דלמעלה שבנ\"י יקיימו מצוות)"
        },
        {
          "s": 11,
          "text": "יש שני ענינים."
        },
        {
          "s": 12,
          "text": "הסיבה והטעם על הציווי,"
        },
        {
          "s": 13,
          "text": "ומזה נעשה מציאות המצוה"
        },
        {
          "s": 14,
          "text": "(הציווי),"
        },
        {
          "s": 15,
          "text": "שהוא מסובב מהטעם."
        },
        {
          "s": 16,
          "text": "ואח\"כ"
        },
        {
          "s": 17,
          "text": "(לאחרי הציווי דלמעלה)"
        },
        {
          "s": 18,
          "text": "באה עשיית המצוה ע\"י האדם שמקיים אותם."
        },
        {
          "s": 19,
          "text": "ובזה שני אופנים כלליים."
        },
        {
          "s": 20,
          "text": "אופן הא' שמקיימה לתכלית הציווי"
        },
        {
          "s": 21,
          "text": "(שיושלם הטעם דהציווי),"
        },
        {
          "s": 22,
          "text": "ואופן הב' הוא שמקיימה באופן נעלה יותר,"
        },
        {
          "s": 23,
          "text": "דקיום המצוה שלו הוא באופן שעי\"ז הוא עושה כביכול רצון חדש,"
        },
        {
          "s": 24,
          "text": "שלמעלה באין ערוך מהרצון המסובב מהטעם."
        },
        {
          "s": 25,
          "text": "דלהיות שישראל מושרשים בעצמות"
        },
        {
          "s": 26,
          "text": "(בעל הרצון),"
        },
        {
          "s": 27,
          "text": "ישראל ומלכא בלחודוהי29,"
        },
        {
          "s": 28,
          "text": "לכן כשישראל מקיים מצוה,"
        },
        {
          "s": 29,
          "text": "ביכלתו לעשות רצון חדש שלא הי' לפני זה."
        },
        {
          "s": 30,
          "text": "ויש לומר דעד\"ז הם שני הפירושים במאמר רז\"ל30"
        },
        {
          "s": 31,
          "text": "נחת רוח לפני שאמרתי ונעשה רצוני31."
        },
        {
          "s": 32,
          "text": "פירוש הא' הוא,"
        },
        {
          "s": 33,
          "text": "שע\"י קיום המצוה נתקיים הרצון"
        },
        {
          "s": 34,
          "text": "(הציווי)"
        },
        {
          "s": 35,
          "text": "שהי' בתחילה."
        },
        {
          "s": 36,
          "text": "ופירוש הב' בנעשה רצוני הוא,"
        },
        {
          "s": 37,
          "text": "דע\"י קיום המצוה דישראל"
        },
        {
          "s": 38,
          "text": "(כאופן הב')"
        },
        {
          "s": 39,
          "text": "נעשה"
        },
        {
          "s": 40,
          "text": "(נתחדש)"
        },
        {
          "s": 41,
          "text": "רצון חדש שלא הי' לפנ\"ז"
        },
        {
          "s": 42,
          "text": "(ע\"ד המבואר בכ\"מ32"
        },
        {
          "s": 43,
          "text": "בפירוש עושין רצונו של מקום33,"
        },
        {
          "s": 44,
          "text": "דפירוש עושין הוא שעושים רצון חדש)."
        },
        {
          "s": 45,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 46,
          "text": "דמ\"ש בדרושים הנ\"ל דענין המצוות הוא בכדי לעשות עי\"ז המצוות דלמעלה,"
        },
        {
          "s": 47,
          "text": "זהו באופן הא' דקיום המצוות,"
        },
        {
          "s": 48,
          "text": "בבחי' מקיימים הרצון המסובב מהטעם,"
        },
        {
          "s": 49,
          "text": "שיהי' הבנין דכל סדר ההשתלשלות,"
        },
        {
          "s": 50,
          "text": "רמ\"ח אברין דמלכא"
        },
        {
          "s": 51,
          "text": "[ובזה גופא שני ענינים,"
        },
        {
          "s": 52,
          "text": "א',"
        },
        {
          "s": 53,
          "text": "הטעם והסיבה"
        },
        {
          "s": 54,
          "text": "(דהרצון)"
        },
        {
          "s": 55,
          "text": "– שיתהוו המצוות"
        },
        {
          "s": 56,
          "text": "(הבחינות)"
        },
        {
          "s": 57,
          "text": "למעלה."
        },
        {
          "s": 58,
          "text": "ב',"
        },
        {
          "s": 59,
          "text": "המסובב – הרצון שישראל יקיימו המצוות למטה]."
        },
        {
          "s": 60,
          "text": "אבל עשיית המצוות מצד שישראל מושרשים בעצמות הוא לעשות רצון חדש."
        },
        {
          "s": 61,
          "text": "וזהו מה שמבואר בריבוי דרושים27"
        },
        {
          "s": 62,
          "text": "שהעילוי בקיום המצוות הוא כשהקיום הוא מפני שזהו רצון"
        },
        {
          "s": 63,
          "text": "(ציווי)"
        },
        {
          "s": 64,
          "text": "הקב\"ה,"
        },
        {
          "s": 65,
          "text": "ולא מצד הטעם"
        },
        {
          "s": 66,
          "text": "(כולל גם הטעם מה שע\"י קיום המצוות נעשים המצוות שלמעלה),"
        },
        {
          "s": 67,
          "text": "כי רצון זה הוא רצון שלמעלה מהטעם."
        },
        {
          "s": 68,
          "text": "ועשיית המצוות"
        },
        {
          "s": 69,
          "text": "(מצד רצון זה)"
        },
        {
          "s": 70,
          "text": "הוא לא בכדי לפעול ענינים למעלה,"
        },
        {
          "s": 71,
          "text": "כי אם,"
        },
        {
          "s": 72,
          "text": "מצוה מלשון צוותא וחיבור34,"
        },
        {
          "s": 73,
          "text": "היחוד דישראל עם בעל הרצון,"
        },
        {
          "s": 74,
          "text": "ועד להיחוד עם העצמות."
        },
        {
          "s": 75,
          "text": "וע\"ד מאמר אדמו\"ר הזקן35"
        },
        {
          "s": 76,
          "text": "איך וויל זע גאָר ניסט איך וויל ניט דיין ג\"ע איך וויל ניט דיין עוה\"ב כו' איך וויל מער ניט אז דיך אַליין."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יובן גם מה שמבואר בדרוש הנ\"ל דאדמו\"ר הצ\"צ36,"
        },
        {
          "s": 2,
          "text": "דהתענוג הפרטי שבכל מצוה,"
        },
        {
          "s": 3,
          "text": "מה שבכל מצוה יש תענוג מיוחד,"
        },
        {
          "s": 4,
          "text": "הוא נעלה יותר מהתענוג והרצון הכללי שבכל המצוות בשוה,"
        },
        {
          "s": 5,
          "text": "ושרשו הוא מבחי' מקור התענוגים"
        },
        {
          "s": 6,
          "text": "(שלמעלה מבחינת גילוי התענוג),"
        },
        {
          "s": 7,
          "text": "דלכאורה אינו מובן איך זה מתאים עם המבואר בריבוי דרושים27"
        },
        {
          "s": 8,
          "text": "שהכוונה הכללית שבכל המצוות בשוה"
        },
        {
          "s": 9,
          "text": "(וצונו)"
        },
        {
          "s": 10,
          "text": "היא נעלית יותר מהכוונה הפרטית דכל מצוה בפרט."
        },
        {
          "s": 11,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 12,
          "text": "דבדרוש הנ\"ל דאדמו\"ר הצ\"צ מדובר בענין הרצון במצוות כמו שהוא מסובב מהטעם,"
        },
        {
          "s": 13,
          "text": "בכדי שיתהוו המצוות שלמעלה."
        },
        {
          "s": 14,
          "text": "ומה שמבואר שם דבמצוות יש שתי בחינות,"
        },
        {
          "s": 15,
          "text": "ענין הכללי שבכל המצוות בשוה,"
        },
        {
          "s": 16,
          "text": "וענין הפרטי שבכל מצוה בפרט,"
        },
        {
          "s": 17,
          "text": "הנה שתי הבחינות הן בהרצון שמצד הטעם."
        },
        {
          "s": 18,
          "text": "שבתחלת המשכתו הוא רצון כללי שייעשו הענינים למעלה ע\"י קיום המצוות דהאדם,"
        },
        {
          "s": 19,
          "text": "ומזה נמשך אח\"כ"
        },
        {
          "s": 20,
          "text": "(למטה יותר)"
        },
        {
          "s": 21,
          "text": "רצון פרטי לכל מצוה ומצוה בפרט,"
        },
        {
          "s": 22,
          "text": "בכדי שע\"י קיומה תיעשה אותה המצוה דלמעלה שבדוגמתה"
        },
        {
          "s": 23,
          "text": "(ע\"י שופר דלמטה,"
        },
        {
          "s": 24,
          "text": "שופר שלמעלה."
        },
        {
          "s": 25,
          "text": "וכן בשאר המצוות)."
        },
        {
          "s": 26,
          "text": "ולכן אומר שם דיש מעלה בתענוג וכוונה הפרטית"
        },
        {
          "s": 27,
          "text": "(ועד דשרש התענוג הפרטי דוקא הוא בבחינת מקור התענוגים),"
        },
        {
          "s": 28,
          "text": "כי הכוונה ברצון זה היא לעשות המצוות"
        },
        {
          "s": 29,
          "text": "(פרטי ענינים)"
        },
        {
          "s": 30,
          "text": "שלמעלה,"
        },
        {
          "s": 31,
          "text": "וזה נעשה דוקא ע\"י הפעולה הפרטית דכל מצוה."
        },
        {
          "s": 32,
          "text": "ומה שמבואר בריבוי דרושים דהכוונה הכללית שבכל המצוות בשוה היא נעלית יותר,"
        },
        {
          "s": 33,
          "text": "הוא,"
        },
        {
          "s": 34,
          "text": "כי שם מדובר בהרצון שישראל מחדשים ועושים ע\"י עבודתם,"
        },
        {
          "s": 35,
          "text": "ומצד רצון זה,"
        },
        {
          "s": 36,
          "text": "אופן קיום המצוות הוא לעשות רצון,"
        },
        {
          "s": 37,
          "text": "כוונה כללית."
        }
      ]
    }
  ]
}