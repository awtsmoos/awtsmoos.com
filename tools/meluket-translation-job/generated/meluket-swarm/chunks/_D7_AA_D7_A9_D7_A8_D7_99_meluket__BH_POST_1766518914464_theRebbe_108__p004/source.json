{
  "globalIndex": 136,
  "owner": 36,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914464_theRebbe_108__p004",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914464_theRebbe_108__p004",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914464_theRebbe_108",
  "title": "מאמר אתה הראת לדעת תשל\"ז",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יש לבאר גם השייכות דשני הפירושים"
        },
        {
          "s": 2,
          "text": "(דלעיל סעיף ד)"
        },
        {
          "s": 3,
          "text": "באתה הראת לדעת,"
        },
        {
          "s": 4,
          "text": "שאתה הראת לדעת היא הידיעה בממלא כל עלמין ושאתה הראת לדעת היא הידיעה בהעצמות"
        },
        {
          "s": 5,
          "text": "(מען זאָל דיך וויסן),"
        },
        {
          "s": 6,
          "text": "כי הידיעה וההתבוננות באור המתלבש בעולמות"
        },
        {
          "s": 7,
          "text": "(אור הממלא)"
        },
        {
          "s": 8,
          "text": "הוא בעיקר בכדי שגם השכל דנפש הבהמית ידע אלקות48,"
        },
        {
          "s": 9,
          "text": "וזה שגם השכל דנה\"ב יכול להבין אלקות"
        },
        {
          "s": 10,
          "text": "(ובאופן שעי\"ז יבוא לביטול היש,"
        },
        {
          "s": 11,
          "text": "היפך הטבע שלו),"
        },
        {
          "s": 12,
          "text": "הוא ע\"י גילוי יכולת העצמות,"
        },
        {
          "s": 13,
          "text": "שעי\"ז גם החושך נהפך לאור."
        },
        {
          "s": 14,
          "text": "שידיעה זו היא בכח העצמות,"
        },
        {
          "s": 15,
          "text": "אבל הידיעה עצמה היא רק באור הממלא."
        },
        {
          "s": 16,
          "text": "ולאחרי ידיעה זו,"
        },
        {
          "s": 17,
          "text": "צריכה להיות הידיעה וההתבוננות באור הסובב"
        },
        {
          "s": 18,
          "text": "[שזהו הציווי וידעת גו',"
        },
        {
          "s": 19,
          "text": "כנ\"ל סעיף ד],"
        },
        {
          "s": 20,
          "text": "ושאור הממלא המתלבש בעולמות הוא רק הארה בלבד שבאין ערוך לגבי אוא\"ס שלמעלה מעולמות"
        },
        {
          "s": 21,
          "text": "(אור הסובב),"
        },
        {
          "s": 22,
          "text": "ואז דוקא הוא שייך להתבונן ולידע היתרון בהידיעה דאור הממלא שמובן גם בהשכל דנה\"ב,"
        },
        {
          "s": 23,
          "text": "שידיעה זו היא מצד יכולת העצמות,"
        },
        {
          "s": 24,
          "text": "כנ\"ל."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יש לבאר גם זה שמובא לעיל"
        },
        {
          "s": 2,
          "text": "(סעיף ה)"
        },
        {
          "s": 3,
          "text": "מהדרושים,"
        },
        {
          "s": 4,
          "text": "דזה שהוא ית' האציל ענין הידיעה בעצמותו הוא בכדי שעי\"ז יוכל להיות בנבראים ידיעה באלקות,"
        },
        {
          "s": 5,
          "text": "דמזה שהכוונה בהאצלת הידיעה בעצמותו היא בכדי שהנבראים ידעו אלקות,"
        },
        {
          "s": 6,
          "text": "מובן,"
        },
        {
          "s": 7,
          "text": "שיש יתרון בידיעה זו"
        },
        {
          "s": 8,
          "text": "(שהנבראים יודעים אלקות)"
        },
        {
          "s": 9,
          "text": "לגבי הידיעה שבעצמותו."
        },
        {
          "s": 10,
          "text": "וע\"ד המבואר בתניא49"
        },
        {
          "s": 11,
          "text": "שהתכלית בהשתלשלות העולמות הוא לא בשביל עולמות העליונים,"
        },
        {
          "s": 12,
          "text": "הואיל ולהם ירידה מאור פניו ית',"
        },
        {
          "s": 13,
          "text": "והתכלית דעולמות העליונים הוא זה שעל ידם נתהווה עולם הזה התחתון,"
        },
        {
          "s": 14,
          "text": "שעי\"ז נשלמת הכוונה דדירה בתחתונים50,"
        },
        {
          "s": 15,
          "text": "דירה לעצמותו51."
        },
        {
          "s": 16,
          "text": "ונמצא,"
        },
        {
          "s": 17,
          "text": "דענין זה שבעולמות העליונים,"
        },
        {
          "s": 18,
          "text": "שעל ידם מתהווה עוה\"ז התחתון,"
        },
        {
          "s": 19,
          "text": "הוא נעלה יותר מעולמות העליונים עצמם."
        },
        {
          "s": 20,
          "text": "דעולמות העליונים עצמם הם בבחינת ירידה,"
        },
        {
          "s": 21,
          "text": "וזה שעל ידם נתהווה עוה\"ז התחתון,"
        },
        {
          "s": 22,
          "text": "הוא העלי' שלהם."
        },
        {
          "s": 23,
          "text": "ועד\"ז הוא גם בנוגע להאצלת הידיעה בעצמותו,"
        },
        {
          "s": 24,
          "text": "שהידיעה היא כמו ירידה מאור פניו"
        },
        {
          "s": 25,
          "text": "[דעם היות שהאצלת ידיעה זו היא בעצמותו,"
        },
        {
          "s": 26,
          "text": "מ\"מ,"
        },
        {
          "s": 27,
          "text": "לגבי העצמות כמו שהוא מצד עצמו"
        },
        {
          "s": 28,
          "text": "(לפני שהאציל הידיעה),"
        },
        {
          "s": 29,
          "text": "הידיעה היא ירידה],"
        },
        {
          "s": 30,
          "text": "והתכלית דהאצלת הידיעה הוא שעל ידה יהי' ידיעת אלקות בהנבראים,"
        },
        {
          "s": 31,
          "text": "עד בהשכל דנפש הבהמית,"
        },
        {
          "s": 32,
          "text": "שעי\"ז מתגלה יכולת העצמות52,"
        },
        {
          "s": 33,
          "text": "וע\"י ההמשכה מידיעת עצמו ידיעת אלקות בהנבראים,"
        },
        {
          "s": 34,
          "text": "נעשה עלי' כביכול בידיעת עצמו."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "שהעלי' שנעשית בידיעת עצמו על ידי ידיעת אלקות בהנבראים הוא ע\"ד ההשפעה מהרגל להראש,"
        },
        {
          "s": 3,
          "text": "מצד זה ששרש הרגל הוא למעלה מהראש,"
        },
        {
          "s": 4,
          "text": "נעוץ סופן בתחילתן53."
        },
        {
          "s": 5,
          "text": "דענין זה שייך עדיין לסדר השתלשלות."
        },
        {
          "s": 6,
          "text": "ועוד ענין באתה הראת לדעת,"
        },
        {
          "s": 7,
          "text": "שע\"י ידיעת אלקות דהנבראים נמשך"
        },
        {
          "s": 8,
          "text": "(אח\"כ)"
        },
        {
          "s": 9,
          "text": "הגילוי דאין עוד מלבדו,"
        },
        {
          "s": 10,
          "text": "יכולת העצמות."
        },
        {
          "s": 11,
          "text": "וזהו שקודם הקפות אומרים אתה הראת לדעת גו' אין עוד מלבדו,"
        },
        {
          "s": 12,
          "text": "שהוא ביאור בגודל העילוי של השמחה דהקפות."
        },
        {
          "s": 13,
          "text": "דזה שהשמחה היא באופן שהרגלים מגביהים ומנשאים את הראש,"
        },
        {
          "s": 14,
          "text": "הכוונה בזה היא לראש האדם ולהראש שבכל דרגא ודרגא,"
        },
        {
          "s": 15,
          "text": "עד לדרגת ידיעת עצמו."
        },
        {
          "s": 16,
          "text": "ויתירה מזו,"
        },
        {
          "s": 17,
          "text": "שע\"י הריקודים דשמח\"ת נמשך בחינת המקיף שלמעלה מהגדרים דראש ורגל,"
        },
        {
          "s": 18,
          "text": "ועד להגילוי דאין עוד מלבדו,"
        },
        {
          "s": 19,
          "text": "יכולת העצמות."
        }
      ]
    }
  ]
}