{
  "globalIndex": 44,
  "owner": 44,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913940_theRebbe_399__p001",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913940_theRebbe_399__p001",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518913940_theRebbe_399",
  "title": "מאמר תקעו בחודש שופר תשמ\"ז",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "יום ב' דראש השנה,"
        },
        {
          "s": 2,
          "text": "ה'תשמ\"ז*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "– הנחה –"
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "תקעו בחודש שופר בכסה ליום חגינו גו'1,"
        },
        {
          "s": 1,
          "text": "ומבאר בזה כ\"ק מו\"ח אדמו\"ר נשיא דורנו"
        },
        {
          "s": 2,
          "text": "[במאמרו ד\"ה תקעו תש\"ז2,"
        },
        {
          "s": 3,
          "text": "לפני ארבעים שנה,"
        },
        {
          "s": 4,
          "text": "דאחרי ארבעים שנה קאי אינש אדעתי' דרבי'3],"
        },
        {
          "s": 5,
          "text": "דארז\"ל4"
        },
        {
          "s": 6,
          "text": "על הפסוק איזהו חג שהחדש מתכסה בו הוי אומר זה ראש השנה,"
        },
        {
          "s": 7,
          "text": "דבכסה הוא כס ה' דה' קאי על ספירת המלכות וכס ענינו כיסוי וראש השנה נק' כסה לפי שבראש השנה ספירת המלכות מתכסית ומתעלמת בהעלם העצמי כו'"
        },
        {
          "s": 8,
          "text": "(ואולי יש להוסיף הקשר לענין חג שהחדש מתכסה בו בפשטות,"
        },
        {
          "s": 9,
          "text": "דחדש בפשטות היא הלבנה,"
        },
        {
          "s": 10,
          "text": "ונודע שהלבנה היא ספירת המלכות),"
        },
        {
          "s": 11,
          "text": "ולכן הנה עיקר עבודת ראש השנה הוא בנין ספירת המלכות כמארז\"ל5"
        },
        {
          "s": 12,
          "text": "אמרו לפני מלכיות כדי שתמליכוני עליכם כו',"
        },
        {
          "s": 13,
          "text": "וכדי להמשיך בחי' המלכות הוא ע\"י תקיעת שופר וכמ\"ש תקעו כו'."
        }
      ]
    }
  ]
}