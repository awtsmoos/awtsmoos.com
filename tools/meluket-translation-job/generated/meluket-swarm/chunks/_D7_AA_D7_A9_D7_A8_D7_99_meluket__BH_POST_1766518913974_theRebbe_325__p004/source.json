{
  "globalIndex": 51,
  "owner": 1,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913974_theRebbe_325__p004",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518913974_theRebbe_325__p004",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518913974_theRebbe_325",
  "title": "מאמר וכל אדם תשכ\"ג",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "דזה שגם מענה הקב\"ה שלמעלה מהתורה נתגלה ע\"י התורה הוא,"
        },
        {
          "s": 3,
          "text": "כי זה שהתורה היא בקו האמצעי הוא לפי ששרשה הוא בעצמות אוא\"ס שלמעלה מקוין,"
        },
        {
          "s": 4,
          "text": "אלא שאח\"כ נמשכה בקו האמצעי."
        },
        {
          "s": 5,
          "text": "ולכן,"
        },
        {
          "s": 6,
          "text": "נוסף על שיש בה האור שלמעלה מהשתלשלות כמו שנמשך בקו האמצעי"
        },
        {
          "s": 7,
          "text": "(שלכן גם מצד מענה התורה מועלת תשובה שזדונות יהיו כשגגות),"
        },
        {
          "s": 8,
          "text": "מתגלה על ידה גם עצמות אוא\"ס שלמעלה מקוין,"
        },
        {
          "s": 9,
          "text": "מענה הקב\"ה יעשה תשובה ויתכפר לו."
        },
        {
          "s": 10,
          "text": "היינו,"
        },
        {
          "s": 11,
          "text": "דזה שאמרה תורה יביא אשם ויתכפר לו"
        },
        {
          "s": 12,
          "text": "(שע\"י תשובה נעשים זדונות רק כשגגות)"
        },
        {
          "s": 13,
          "text": "הוא בדרגת התורה כמו שנמשכה בקו האמצעי,"
        },
        {
          "s": 14,
          "text": "וזה שגם מענה הקב\"ה יעשה תשובה ויתכפר לו הוא חלק בתורה"
        },
        {
          "s": 15,
          "text": "(שבעל פה)"
        },
        {
          "s": 16,
          "text": "הוא מצד שרש התורה בעצמות אוא\"ס שלמעלה מקוין45."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש לבאר מה שאמרו רז\"ל46"
        },
        {
          "s": 1,
          "text": "יבוא טוב זה משה כו' ויקבל טוב זה תורה כו' מטוב זה הקב\"ה דכתיב47"
        },
        {
          "s": 2,
          "text": "טוב הוי' לכל,"
        },
        {
          "s": 3,
          "text": "לטובים אלו ישראל דכתיב48"
        },
        {
          "s": 4,
          "text": "הטיבה ה' לטובים."
        },
        {
          "s": 5,
          "text": "וצריך להבין,"
        },
        {
          "s": 6,
          "text": "דאיתא בגמ' סנהדרין49"
        },
        {
          "s": 7,
          "text": "כתיב47"
        },
        {
          "s": 8,
          "text": "טוב ה' לכל וכתיב50"
        },
        {
          "s": 9,
          "text": "טוב ה' לקוויו משל לאדם שיש לו פרדס כשהוא משקה משקה את כולו כשהוא עודר אינו עודר אלא טובים שבהם."
        },
        {
          "s": 10,
          "text": "וכיון שנתינת התורה היא"
        },
        {
          "s": 11,
          "text": "(רק)"
        },
        {
          "s": 12,
          "text": "לטובים אלו ישראל,"
        },
        {
          "s": 13,
          "text": "הי' צריך לכאורה להביא הפסוק טוב הוי' לקוויו."
        },
        {
          "s": 14,
          "text": "[וע\"פ הידוע51"
        },
        {
          "s": 15,
          "text": "דטוב הוי' לכל הוא השפעה חיצונית וטוב הוי' לקוויו הוא השפעה פנימית,"
        },
        {
          "s": 16,
          "text": "צריך ביאור עוד יותר מה שמביא בענין נתינת התורה שהוא השפעה פנימית את הפסוק טוב הוי' לכל ולא טוב הוי' לקוויו]."
        },
        {
          "s": 17,
          "text": "ויש לומר הביאור בזה52,"
        },
        {
          "s": 18,
          "text": "דזה שבתשובה כתיב טוב וישר הוי',"
        },
        {
          "s": 19,
          "text": "הכוונה היא לבחי' טוב הוי' לכל53,"
        },
        {
          "s": 20,
          "text": "שהרי תשובה מכפרת גם על הזדונות."
        },
        {
          "s": 21,
          "text": "ולכן אומר ויקבל טוב זו תורה כו' מטוב זה הקב\"ה דכתיב טוב הוי' לכל,"
        },
        {
          "s": 22,
          "text": "כי הטוב דתורה מצד שרשה הוא בחי' טוב וישר הוי'54,"
        },
        {
          "s": 23,
          "text": "טוב הוי' לכל."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה הגם דזה שתשובה מכפרת הוא לפי שהמענה שע\"י התשובה הוא מלמעלה מהשתלשלות,"
        },
        {
          "s": 2,
          "text": "הכפרה שע\"י תשובה היא"
        },
        {
          "s": 3,
          "text": "(לא באופן של ויתור,"
        },
        {
          "s": 4,
          "text": "שמוותרים על החטאים,"
        },
        {
          "s": 5,
          "text": "אלא)"
        },
        {
          "s": 6,
          "text": "פעולה פנימית בהאדם השב,"
        },
        {
          "s": 7,
          "text": "שמתתקנים הפגמים שלו."
        },
        {
          "s": 8,
          "text": "וזהו טוב וישר הוי' על כן יורה חטאים בדרך,"
        },
        {
          "s": 9,
          "text": "דטוב הוא שמשפיע לכל."
        },
        {
          "s": 10,
          "text": "וכמבואר במק\"א55"
        },
        {
          "s": 11,
          "text": "החילוק בין טוב לחסד,"
        },
        {
          "s": 12,
          "text": "דחסד שייך להמקבל ולכן השפעת החסד היא דוקא למי שראוי"
        },
        {
          "s": 13,
          "text": "[אלא שמצד מדת החסד אינו מדקדק,"
        },
        {
          "s": 14,
          "text": "וכשיש להמקבל איזו מעלה הוא כבר ראוי שישפיעו לו],"
        },
        {
          "s": 15,
          "text": "וטוב הוא מצד המשפיע ולכן ההשפעה היא לכולם"
        },
        {
          "s": 16,
          "text": "(גם לשאינם ראויים)."
        },
        {
          "s": 17,
          "text": "וישר הוא שלמטה הוא כמו למעלה56."
        },
        {
          "s": 18,
          "text": "וזהו שההמשכה שע\"י התשובה היא מבחינת טוב וישר,"
        },
        {
          "s": 19,
          "text": "דזה שתשובה מכפרת על הזדונות הוא לא מפני שהאדם ראוי לזה אלא מפני הטוב דהקב\"ה,"
        },
        {
          "s": 20,
          "text": "המשכת אוא\"ס שלמעלה מהשתלשלות."
        },
        {
          "s": 21,
          "text": "וזה שע\"י המשכה זו מתתקנים הפגמים שלו,"
        },
        {
          "s": 22,
          "text": "והתיקון הוא בפנימיות,"
        },
        {
          "s": 23,
          "text": "הוא לפי שהמשכת הטוב היא באופן דחסד,"
        },
        {
          "s": 24,
          "text": "שהאדם השב הוא כמו כלי לההמשכה."
        }
      ]
    }
  ]
}