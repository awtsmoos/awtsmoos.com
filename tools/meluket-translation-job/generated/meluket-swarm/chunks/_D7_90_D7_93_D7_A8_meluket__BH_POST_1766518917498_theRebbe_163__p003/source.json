{
  "globalIndex": 645,
  "owner": 45,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917498_theRebbe_163__p003",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917498_theRebbe_163__p003",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917498_theRebbe_163",
  "title": "מאמר בלילה ההוא תשד\"מ",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "אמנם,"
        },
        {
          "s": 2,
          "text": "כמו שבאדם התחתון ענין ההתעלמות שבעת השינה הוא שהכחות מתעלים ומסתלקים למקורם בנפש,"
        },
        {
          "s": 3,
          "text": "והחסרון וגרעון שבשינה הוא רק בכחות הגלויים"
        },
        {
          "s": 4,
          "text": "(שהכחות הם באופן בלתי מסודר),"
        },
        {
          "s": 5,
          "text": "משא\"כ כחות הכלולים בנפש,"
        },
        {
          "s": 6,
          "text": "עם היותם שם בהשוואה,"
        },
        {
          "s": 7,
          "text": "אין זה חסרון,"
        },
        {
          "s": 8,
          "text": "ואדרבא,"
        },
        {
          "s": 9,
          "text": "בהיותם כלולים בנפש הם בשלימות"
        },
        {
          "s": 10,
          "text": "(יותר מכפי שהם כשנמשכים בגילוי),"
        },
        {
          "s": 11,
          "text": "עד\"ז הוא גם בהנמשל,"
        },
        {
          "s": 12,
          "text": "דענין ההתעלמות בזמן הגלות"
        },
        {
          "s": 13,
          "text": "(שינה)"
        },
        {
          "s": 14,
          "text": "הוא שהגילויים מתעלים למקורם,"
        },
        {
          "s": 15,
          "text": "ושם,"
        },
        {
          "s": 16,
          "text": "המקור דישראל,"
        },
        {
          "s": 17,
          "text": "עם המעלה דישראל,"
        },
        {
          "s": 18,
          "text": "הוא מיטן גאַנצן שטורעם"
        },
        {
          "s": 19,
          "text": "(בדוגמת כחות הכלולים בנפש,"
        },
        {
          "s": 20,
          "text": "שהם בשלימות),"
        },
        {
          "s": 21,
          "text": "אלא שזהו למעלה"
        },
        {
          "s": 22,
          "text": "(בהמקור),"
        },
        {
          "s": 23,
          "text": "ובסדר ההשתלשלות אין זה ניכר,"
        },
        {
          "s": 24,
          "text": "ולכן נעשה מזה ענין הגלות."
        },
        {
          "s": 25,
          "text": "וכשנדדה השינה ונמשך מהמקור בפנימיות"
        },
        {
          "s": 26,
          "text": "(בסדר ההשתלשלות)"
        },
        {
          "s": 27,
          "text": "אז מתגלה מעלת ישראל מיט אַ שטורעם."
        },
        {
          "s": 28,
          "text": "ועפ\"ז מודגש עוד יותר חיבור ההפכים שבגלות,"
        },
        {
          "s": 29,
          "text": "דהגם שבזמן הגלות העילוי דישראל הוא עוד יותר מבזמן הבית,"
        },
        {
          "s": 30,
          "text": "מכיון שבזה\"ג הגילויים מתעלים למקורם ששם הוא המקור דישראל,"
        },
        {
          "s": 31,
          "text": "אעפ\"כ,"
        },
        {
          "s": 32,
          "text": "הנה לא זו בלבד שלמטה אין ניכרת המעלה דישראל,"
        },
        {
          "s": 33,
          "text": "אלא שהם מקבלים השפעתם ע\"י שרי האומות שהם בגלות אצלם40."
        },
        {
          "s": 34,
          "text": "וי\"ל שזהו מהטעמים שגלות נמשל לעיבור41,"
        },
        {
          "s": 35,
          "text": "כי בעיבור בבטן אמו הוא דבר והיפוכו."
        },
        {
          "s": 36,
          "text": "דאע\"פ שנר דלוק על ראשו כו' ומלמדין אותו כל התורה כולה וכו'42"
        },
        {
          "s": 37,
          "text": "(שזהו דוקא בהיותו בבטן אמו,"
        },
        {
          "s": 38,
          "text": "משא\"כ כשנולד43),"
        },
        {
          "s": 39,
          "text": "אעפ\"כ,"
        },
        {
          "s": 40,
          "text": "בהיותו בבטן אמו ראשו בין ברכיו,"
        },
        {
          "s": 41,
          "text": "שאין ניכר מעלת הראש על הרגלים,"
        },
        {
          "s": 42,
          "text": "ויתירה מזו,"
        },
        {
          "s": 43,
          "text": "שראשו הוא בין ברכיו42,"
        },
        {
          "s": 44,
          "text": "ועד שגם המאכל שלו"
        },
        {
          "s": 45,
          "text": "(שאוכל ממה שאמו אוכלת42)"
        },
        {
          "s": 46,
          "text": "אינו דרך הפה אלא דרך הטבור,"
        },
        {
          "s": 47,
          "text": "כמבואר בארוכה פרטי הענינים בזה בתו\"א לרבינו הזקן44"
        },
        {
          "s": 48,
          "text": "ובדרושי רבותינו נשיאינו שלאח\"ז45."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז י\"ל מה שארז\"ל46"
        },
        {
          "s": 2,
          "text": "בשעה שנכנסו נכרים להיכל ראו כרובים המעורין זה בזה,"
        },
        {
          "s": 3,
          "text": "דלכאורה תמוה47,"
        },
        {
          "s": 4,
          "text": "הרי כרובים מעורין זה בזה מורה על גודל החיבה דהקב\"ה וישראל כחיבת איש ואשה48,"
        },
        {
          "s": 5,
          "text": "ובשעה שנכנסו נכרים להיכל הרי הי' לכאורה היפך החיבה."
        },
        {
          "s": 6,
          "text": "אך הענין הוא49,"
        },
        {
          "s": 7,
          "text": "שדוקא אז הי' אור נעלה ביותר,"
        },
        {
          "s": 8,
          "text": "אור שלמעלה מהשתלשלות,"
        },
        {
          "s": 9,
          "text": "ורק שאור זה הי' במקומו"
        },
        {
          "s": 10,
          "text": "(למעלה מהשתלשלות)"
        },
        {
          "s": 11,
          "text": "ולא האיר למטה"
        },
        {
          "s": 12,
          "text": "(בהשתלשלות)."
        },
        {
          "s": 13,
          "text": "ויש להוסיף בזה ע\"פ מאמר רז\"ל50"
        },
        {
          "s": 14,
          "text": "חייב אדם לפקוד את אשתו בשעה שהוא יוצא לדרך,"
        },
        {
          "s": 15,
          "text": "דמכיון שבזמן הגלות כנסת ישראל היא כאשה שהלך בעלה למדינת הים51,"
        },
        {
          "s": 16,
          "text": "לכן,"
        },
        {
          "s": 17,
          "text": "לפני יציאתו של הבעל"
        },
        {
          "s": 18,
          "text": "(הקב\"ה)"
        },
        {
          "s": 19,
          "text": "לדרך,"
        },
        {
          "s": 20,
          "text": "היתה הפקידה,"
        },
        {
          "s": 21,
          "text": "ולכן היו אז הכרובים כמער52"
        },
        {
          "s": 22,
          "text": "איש ולויות."
        },
        {
          "s": 23,
          "text": "ועפ\"ז יובן בעומק יותר מה שהגלות נמשל לעיבור"
        },
        {
          "s": 24,
          "text": "(והגאולה ללידה),"
        },
        {
          "s": 25,
          "text": "דכמו שלמטה,"
        },
        {
          "s": 26,
          "text": "כשאדם פוקד את אשתו נעשה יצירת הולד,"
        },
        {
          "s": 27,
          "text": "אלא שבתחילה הוא בעיבור בבטן אמו"
        },
        {
          "s": 28,
          "text": "(בהעלם לגמרי,"
        },
        {
          "s": 29,
          "text": "ולאח\"ז באופן דראשו בין ברכיו וכו'),"
        },
        {
          "s": 30,
          "text": "ובמשך כל זמן העיבור הוא הולך וגדל עד שמגיע זמן הלידה שאז הוא יוצא לאויר העולם"
        },
        {
          "s": 31,
          "text": "(בגילוי),"
        },
        {
          "s": 32,
          "text": "עד\"ז הוא למעלה,"
        },
        {
          "s": 33,
          "text": "שמהפקידה שהיתה ברגע שלפני הגלות נעשה מיד המשכת האור"
        },
        {
          "s": 34,
          "text": "(יצירת הולד)"
        },
        {
          "s": 35,
          "text": "גם למטה,"
        },
        {
          "s": 36,
          "text": "אלא שהמשכתו הוא בהעלם,"
        },
        {
          "s": 37,
          "text": "באופן דגלות"
        },
        {
          "s": 38,
          "text": "(עיבור),"
        },
        {
          "s": 39,
          "text": "ובמשך זמן הגלות הוא הולך וגדל מיום ליום עד שבקרוב ממש תהי' הלידה והגילוי בגאולה העתידה."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר53,"
        },
        {
          "s": 2,
          "text": "דזה שבלילה ההוא נדדה שנת המלך מלכו של עולם"
        },
        {
          "s": 3,
          "text": "(עיקר הנס דפורים)"
        },
        {
          "s": 4,
          "text": "נעשה ע\"י המס\"נ דישראל במשך כל השנה."
        },
        {
          "s": 5,
          "text": "והענין הוא,"
        },
        {
          "s": 6,
          "text": "דענין המס\"נ הוא מצד נקודת הנפש שלמעלה מכחות פרטיים,"
        },
        {
          "s": 7,
          "text": "בחינת יחידה."
        },
        {
          "s": 8,
          "text": "והיינו דענין המס\"נ"
        },
        {
          "s": 9,
          "text": "(מה שאינו מתחשב עם חשבונות דשכל ושאר כחות)"
        },
        {
          "s": 10,
          "text": "הוא שמעלה את הכחות שלו למקורם בנפש,"
        },
        {
          "s": 11,
          "text": "בדוגמת העלאת הכחות למקורם בעת השינה."
        },
        {
          "s": 12,
          "text": "אלא שבשינה,"
        },
        {
          "s": 13,
          "text": "העלאת הכחות להנפש היא באופן שהכחות מסתלקים מאברי הגוף ועולים להנפש כמו שהיא בהעלם"
        },
        {
          "s": 14,
          "text": "(בעצמותה),"
        },
        {
          "s": 15,
          "text": "משא\"כ במס\"נ,"
        },
        {
          "s": 16,
          "text": "הרי אדרבא,"
        },
        {
          "s": 17,
          "text": "העלם הנפש היא בהתעוררות ובהתגלות,"
        },
        {
          "s": 18,
          "text": "וזה פועל על הכחות כמו שהם נמצאים במקומם באברי הגוף שיהיו בטלים להנפש"
        },
        {
          "s": 19,
          "text": "(שלא יתחשב עמהם,"
        },
        {
          "s": 20,
          "text": "כנ\"ל)."
        },
        {
          "s": 21,
          "text": "וזהו מה שע\"י המס\"נ נדדה שנת המלך מלכו של עולם,"
        },
        {
          "s": 22,
          "text": "דע\"י שנקודת הנפש"
        },
        {
          "s": 23,
          "text": "(שלמעלה מהשתלשלות שבאדם)"
        },
        {
          "s": 24,
          "text": "האירה בגילוי,"
        },
        {
          "s": 25,
          "text": "עי\"ז נעשה כן גם למעלה,"
        },
        {
          "s": 26,
          "text": "שאור העצמי שלמעלה מהשתלשלות"
        },
        {
          "s": 27,
          "text": "(שבו עולים הבחינות דהשתלשלות בעת השינה והגלות)"
        },
        {
          "s": 28,
          "text": "האיר בגילוי."
        }
      ]
    }
  ]
}