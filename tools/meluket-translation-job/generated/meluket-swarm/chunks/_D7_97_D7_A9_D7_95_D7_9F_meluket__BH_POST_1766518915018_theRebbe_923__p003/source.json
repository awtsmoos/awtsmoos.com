{
  "globalIndex": 210,
  "owner": 10,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915018_theRebbe_923__p003",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518915018_theRebbe_923__p003",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518915018_theRebbe_923",
  "title": "מאמר ואברהם זקן תשל\"ז",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "דזה שהוי' ברך את אברהם בכל דוקא לאחרי שעמד בנסיון העשירי הוא,"
        },
        {
          "s": 3,
          "text": "כי עשרה הנסיונות הם כנגד ע\"ס"
        },
        {
          "s": 4,
          "text": "(כנ\"ל סעיף ב),"
        },
        {
          "s": 5,
          "text": "והשלימות דכל ענין הוא כשהוא כלול מכל הע\"ס."
        },
        {
          "s": 6,
          "text": "ובעומק יותר יש לומר,"
        },
        {
          "s": 7,
          "text": "שבכדי לזכות לבחינת כל שנעתק ומובדל לגמרי מהשתלשלות,"
        },
        {
          "s": 8,
          "text": "הוא דוקא ע\"י עבודה שלמעלה ממדידה והגבלה לגמרי."
        },
        {
          "s": 9,
          "text": "וכיון שעשר הנסיונות הם כנגד ע\"ס"
        },
        {
          "s": 10,
          "text": "(השתלשלות),"
        },
        {
          "s": 11,
          "text": "ועד שהם כנגד עשרה מאמרות37"
        },
        {
          "s": 12,
          "text": "(שהם למטה מהספירות עצמם38),"
        },
        {
          "s": 13,
          "text": "הרי זה שעמד בנסיונות אלו קשור עדיין עם מדידה והגבלה,"
        },
        {
          "s": 14,
          "text": "ולכן הי' צריך להיות נסיון העשירי,"
        },
        {
          "s": 15,
          "text": "הוא נסיון העקידה39,"
        },
        {
          "s": 16,
          "text": "המיוחד דכל הנסיונות,"
        },
        {
          "s": 17,
          "text": "שלמעלה ממדידה והגבלה."
        },
        {
          "s": 18,
          "text": "דהגם שגם נסיון זה הוא בכלל עשר הנסיונות,"
        },
        {
          "s": 19,
          "text": "יש לומר,"
        },
        {
          "s": 20,
          "text": "שבנסיון זה יש"
        },
        {
          "s": 21,
          "text": "(גם)"
        },
        {
          "s": 22,
          "text": "ענין שלמעלה מע\"ס."
        },
        {
          "s": 23,
          "text": "וע\"ד דאיתא במדרש40"
        },
        {
          "s": 24,
          "text": "עה\"פ41"
        },
        {
          "s": 25,
          "text": "אחד עשר יום מחורב שקאי על הדבור אנכי"
        },
        {
          "s": 26,
          "text": "(דבור הראשון דעשרת הדברות),"
        },
        {
          "s": 27,
          "text": "המיוחד שבעשרה."
        },
        {
          "s": 28,
          "text": "ומבואר בחסידות42,"
        },
        {
          "s": 29,
          "text": "דזה שהדבור אנכי נקרא בשם אחד עשר,"
        },
        {
          "s": 30,
          "text": "הגם שהוא ממנין עשרת הדברות,"
        },
        {
          "s": 31,
          "text": "הוא,"
        },
        {
          "s": 32,
          "text": "כי הדבור אנכי הוא בכתר."
        },
        {
          "s": 33,
          "text": "וכיון שבכתר יש ב' מדריגות,"
        },
        {
          "s": 34,
          "text": "חיצוניות הכתר שנמנה במנין הע\"ס ופנימיות הכתר שאינו נמנה עמהם43,"
        },
        {
          "s": 35,
          "text": "לכן,"
        },
        {
          "s": 36,
          "text": "זה שהדבור אנכי הוא ממנין עשרת הדברות הוא מצד חיצוניות הכתר שבו,"
        },
        {
          "s": 37,
          "text": "אבל מצד פנימיות הכתר שבו הוא אחד עשר שאינו במנין עשרת הדברות44,"
        },
        {
          "s": 38,
          "text": "חד ולא בחושבן45."
        },
        {
          "s": 39,
          "text": "ויש לומר,"
        },
        {
          "s": 40,
          "text": "שעד\"ז הוא בנסיון העקידה,"
        },
        {
          "s": 41,
          "text": "שהי' נסיון גדול יותר מהנסיונות שלפניו"
        },
        {
          "s": 42,
          "text": "(בדוגמת הכתר שלמעלה מכל הספירות),"
        },
        {
          "s": 43,
          "text": "שיש בזה שני ענינים."
        },
        {
          "s": 44,
          "text": "זה שהגם שאברהם בטבעו הי' איש החסד"
        },
        {
          "s": 45,
          "text": "(וטבע החסד שלו הי' מצד שרשו),"
        },
        {
          "s": 46,
          "text": "מ\"מ עקד את יצחק בנו ולקח את המאכלת לשחוט את בנו,"
        },
        {
          "s": 47,
          "text": "היפך הטבע שלו"
        },
        {
          "s": 48,
          "text": "(שמצד שרשו)46."
        },
        {
          "s": 49,
          "text": "וז\"ש47"
        },
        {
          "s": 50,
          "text": "עתה ידעתי כי ירא אלקים אתה,"
        },
        {
          "s": 51,
          "text": "עתה דוקא,"
        },
        {
          "s": 52,
          "text": "כי הנסיונות שלפני נסיון העקידה לא היו היפך הטבע דחסד,"
        },
        {
          "s": 53,
          "text": "ועתה"
        },
        {
          "s": 54,
          "text": "(לאחרי הנסיון דעקידה)"
        },
        {
          "s": 55,
          "text": "ידעתי כי ירא אלקים אתה,"
        },
        {
          "s": 56,
          "text": "מדת היראה והגבורה."
        },
        {
          "s": 57,
          "text": "וזה שכל הנסיונות היו בנוגע לעצמו,"
        },
        {
          "s": 58,
          "text": "ונסיון העקידה הי' בנוגע לבנו יחידו."
        },
        {
          "s": 59,
          "text": "דאהבת אדם לבנו,"
        },
        {
          "s": 60,
          "text": "ובפרט לבנו יחידו,"
        },
        {
          "s": 61,
          "text": "היא גדולה יותר מהאהבה לעצמו,"
        },
        {
          "s": 62,
          "text": "וכל אשר לאיש יתן בעד בנו."
        },
        {
          "s": 63,
          "text": "ולכן,"
        },
        {
          "s": 64,
          "text": "נסיון העקידה הוא למעלה מהנסיונות שלפני העקידה."
        },
        {
          "s": 65,
          "text": "ויש לומר,"
        },
        {
          "s": 66,
          "text": "דענין הראשון בנסיון העקידה,"
        },
        {
          "s": 67,
          "text": "שזה הי' היפך טבע החסד דאברהם,"
        },
        {
          "s": 68,
          "text": "מכיון שגם ענין זה הוא בנוגע לעצמו,"
        },
        {
          "s": 69,
          "text": "יש לו איזה ערך לנסיונות שלפניו,"
        },
        {
          "s": 70,
          "text": "אלא שהוא נעלה מהם."
        },
        {
          "s": 71,
          "text": "[ויש לומר,"
        },
        {
          "s": 72,
          "text": "דזה שנסיון העקידה הוכיח שגם נסיונות הקודמים יש בהם ממש48,"
        },
        {
          "s": 73,
          "text": "הוא מפני שיש ערך ביניהם."
        },
        {
          "s": 74,
          "text": "דבדברים שאין שום ערך ביניהם,"
        },
        {
          "s": 75,
          "text": "אין שייך להביא הוכחה מזה על זה]."
        },
        {
          "s": 76,
          "text": "בדוגמת חיצוניות הכתר"
        },
        {
          "s": 77,
          "text": "(אריך),"
        },
        {
          "s": 78,
          "text": "שעם היותו למעלה משאר הספירות,"
        },
        {
          "s": 79,
          "text": "מ\"מ הוא שרש ומקור להם,"
        },
        {
          "s": 80,
          "text": "ועד שהוא נמנה במנין הספירות."
        },
        {
          "s": 81,
          "text": "וענין השני שבנסיון העקידה,"
        },
        {
          "s": 82,
          "text": "שנסיון זה הי' בנוגע לבנו יחידו,"
        },
        {
          "s": 83,
          "text": "הוא ענין חדש לגמרי שלא הי' דוגמתו בהנסיונות שלפניו."
        },
        {
          "s": 84,
          "text": "ובדוגמת עתיק"
        },
        {
          "s": 85,
          "text": "(פנימיות הכתר)"
        },
        {
          "s": 86,
          "text": "שהוא נעתק ומובדל."
        },
        {
          "s": 87,
          "text": "וז\"ש49"
        },
        {
          "s": 88,
          "text": "בי נשבעתי גו',"
        },
        {
          "s": 89,
          "text": "בי ממש בחינת עתיק50,"
        },
        {
          "s": 90,
          "text": "והטעם לזה הוא כי יען גו' ולא חשכת את בנך את יחידך49."
        },
        {
          "s": 91,
          "text": "וע\"פ כל הנ\"ל מובן שלאחרי שעמד אברהם בנסיון העקידה,"
        },
        {
          "s": 92,
          "text": "אז דוקא ברך ה' את אברהם בכל,"
        },
        {
          "s": 93,
          "text": "כי זה שעקד גם את בנו יחידו היא עבודה שלמעלה ממדידה והגבלה לגמרי,"
        },
        {
          "s": 94,
          "text": "ולכן אז דוקא ברך ה' את אברהם בכל,"
        },
        {
          "s": 95,
          "text": "פנימית עתיק,"
        },
        {
          "s": 96,
          "text": "העלם העצמי."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה הכוונה בהמשכת העלם העצמי שנמשך לאברהם היא,"
        },
        {
          "s": 2,
          "text": "שהעלם זה יהי' לא רק כמו שהוא במקומו,"
        },
        {
          "s": 3,
          "text": "בעצמותו,"
        },
        {
          "s": 4,
          "text": "אלא שיומשך ממנו השפעה בלי גבול."
        },
        {
          "s": 5,
          "text": "וכדאיתא בזהר51,"
        },
        {
          "s": 6,
          "text": "מאי בכל,"
        },
        {
          "s": 7,
          "text": "אתר דנהרא דלא פסיק מימוי לעלמין."
        },
        {
          "s": 8,
          "text": "וזוהי השייכות דפירוש הזהר שבכל הוא העלם העצמי עם פירוש רש\"י שבכל קאי על יצחק"
        },
        {
          "s": 9,
          "text": "(בכל בגימטריא בן),"
        },
        {
          "s": 10,
          "text": "כי אברהם הוא חסד דעתיק ויצחק גבורה דעתיק52,"
        },
        {
          "s": 11,
          "text": "וזהו שביצחק כתיב53"
        },
        {
          "s": 12,
          "text": "וארבה את זרעו ואתן לו את יצחק,"
        },
        {
          "s": 13,
          "text": "דריבוי ההשפעה"
        },
        {
          "s": 14,
          "text": "(וארבה את זרעו)"
        },
        {
          "s": 15,
          "text": "הוא מהגבורות דוקא,"
        },
        {
          "s": 16,
          "text": "תגבורת ההשפעה,"
        },
        {
          "s": 17,
          "text": "כמבואר בארוכה בסידור"
        },
        {
          "s": 18,
          "text": "(עם דא\"ח)"
        },
        {
          "s": 19,
          "text": "ד\"ה להבין ענין תק\"ש ע\"פ כוונת הבעש\"ט54."
        },
        {
          "s": 20,
          "text": "והגם שריבוי הוא התחלקות פרטים,"
        },
        {
          "s": 21,
          "text": "הנה הריבוי שנמשך מהגבורות דיצחק,"
        },
        {
          "s": 22,
          "text": "הוא באופן שגם בהפרטים נרגש בגילוי ששרש המשכתם הוא מהפשיטות דהעלם העצמי דלא פסיק מימוי לעלמין."
        },
        {
          "s": 23,
          "text": "וע\"י שגם בהפרטים ניכר הפשיטות,"
        },
        {
          "s": 24,
          "text": "עי\"ז מתגלה הפנימיות והעצמיות שלו,"
        },
        {
          "s": 25,
          "text": "שאינו מוגדר בשום גדר וביכלתו לבוא"
        },
        {
          "s": 26,
          "text": "(בגילוי)"
        },
        {
          "s": 27,
          "text": "גם בפרטים."
        },
        {
          "s": 28,
          "text": "וזהו שלע\"ל יאמרו ליצחק כי אתה אבינו כי אברהם לא ידענו55,"
        },
        {
          "s": 29,
          "text": "כי לע\"ל יהי' גילוי פנימיות עתיק56,"
        },
        {
          "s": 30,
          "text": "והגילוי דפנימיות עתיק הוא דוקא ע\"י הגבורות דיצחק57."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "וזהו שוהוי' ברך את אברהם בכל הוא הקדמה לנשואי יצחק ורבקה,"
        },
        {
          "s": 1,
          "text": "כי תכלית הכוונה הוא שפנימיות הכתר יומשך בגילוי עד למטה מטה,"
        },
        {
          "s": 2,
          "text": "וזה נעשה ע\"י יחוד יצחק ורבקה,"
        },
        {
          "s": 3,
          "text": "כי יצחק ורבקה,"
        },
        {
          "s": 4,
          "text": "השרש דשניהם הוא בגבורה דעתיק,"
        },
        {
          "s": 5,
          "text": "אלא שיצחק הוא בחינת מ\"ה ורבקה היא בחינת ב\"ן,"
        },
        {
          "s": 6,
          "text": "והגילוי למטה הוא ע\"י שם ב\"ן58."
        },
        {
          "s": 7,
          "text": "וזהו שוהוי' ברך את אברהם בכל הוא רק הקדמה לנשואי יצחק ורבקה,"
        },
        {
          "s": 8,
          "text": "כי תכלית הכוונה דברכה זו הוא שבחינת כל יומשך גם בבי\"ע,"
        },
        {
          "s": 9,
          "text": "בעוה\"ז התחתון,"
        },
        {
          "s": 10,
          "text": "ועד בהמקום שבו היתה רבקה,"
        },
        {
          "s": 11,
          "text": "שושנה בין החוחים59,"
        },
        {
          "s": 12,
          "text": "שגם שם יומשך הגילוי דפנימיות עתיק."
        }
      ]
    }
  ]
}