{
  "globalIndex": 793,
  "owner": 43,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918517_theRebbe_122__p005",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918517_theRebbe_122__p005",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918517_theRebbe_122",
  "title": "מאמר שיר המעלות תשכ\"ב",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה זה שבכדי לפעול שינוי בהנבראים הוא"
        },
        {
          "s": 2,
          "text": "(בדרך כלל)"
        },
        {
          "s": 3,
          "text": "ע\"י תפלה"
        },
        {
          "s": 4,
          "text": "(כמובא לעיל סעיף ב מתניא),"
        },
        {
          "s": 5,
          "text": "הוא מצד שני טעמים."
        },
        {
          "s": 6,
          "text": "דזה שנעשה שינוי בהנבראים הוא ע\"י המשכת אוא\"ס שלמעלה מהשתלשלות,"
        },
        {
          "s": 7,
          "text": "והמשכה זו היא ע\"י העלאת מ\"ן דתפלה"
        },
        {
          "s": 8,
          "text": "(כנ\"ל סוף סעיף ג),"
        },
        {
          "s": 9,
          "text": "וגם כי בכדי שיהי' שינוי בהנבראים שלמטה ע\"י האור שלמעלה מהשתלשלות שנמשך בהם צריכים הם להיות כלים להאור,"
        },
        {
          "s": 10,
          "text": "וע\"י העלאת מ\"ן מלמטה נעשה המטה כלי להאור35."
        },
        {
          "s": 11,
          "text": "ועפ\"ז צריך לומר,"
        },
        {
          "s": 12,
          "text": "דזה שרשב\"י המשיך ירידת גשמים ע\"י אמירת תורה הוא מפני שבאמירת תורה שלו היו שני הענינים,"
        },
        {
          "s": 13,
          "text": "המשכת אוא\"ס שלמעלה מהשתלשלות,"
        },
        {
          "s": 14,
          "text": "וגם הזיכוך דהמטה36"
        },
        {
          "s": 15,
          "text": "(כדלקמן)."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דזהו גם מה דאיתא בזהר שההשפעה שהמשיך רשב\"י ע\"י אמירת תורה היתה ירידת גשמים,"
        },
        {
          "s": 2,
          "text": "כי בזה מודגש דזה שבתורתו של רשב\"י היתה גם המעלה דתפלה הוא לא רק המעלה דהמשכה מלמעלה מהשתלשלות אלא גם המעלה דזיכוך המטה."
        },
        {
          "s": 3,
          "text": "והענין הוא,"
        },
        {
          "s": 4,
          "text": "דזה שהשפעת הגשמים באה ע\"י אתערותא דלתתא שייך להגשם עצמו."
        },
        {
          "s": 5,
          "text": "דכמו שבגשמיות הגשם בא מהעננים שנעשים מלחות הארץ,"
        },
        {
          "s": 6,
          "text": "ואד יעלה מן הארץ והשקה את פני האדמה37,"
        },
        {
          "s": 7,
          "text": "כמו\"כ הוא ברוחניות,"
        },
        {
          "s": 8,
          "text": "דגשם הוא ענין שנעשה38"
        },
        {
          "s": 9,
          "text": "(נמשך)"
        },
        {
          "s": 10,
          "text": "ע\"י אתערותא דלתתא39."
        },
        {
          "s": 11,
          "text": "וכיון שענין הגשם הוא המשכה שע\"י אתערותא דלתתא,"
        },
        {
          "s": 12,
          "text": "מובן,"
        },
        {
          "s": 13,
          "text": "דזה שע\"י אמירת תורה דרשב\"י ירד גשם,"
        },
        {
          "s": 14,
          "text": "הוא,"
        },
        {
          "s": 15,
          "text": "מפני שבתורתו של רשב\"י ישנה נוסף על המעלה הבאה ע\"י אתערותא דלתתא"
        },
        {
          "s": 16,
          "text": "(המשכה מלמעלה מהשתלשלות)"
        },
        {
          "s": 17,
          "text": "גם המעלה דאתערותא דלתתא עצמה,"
        },
        {
          "s": 18,
          "text": "זיכוך המטה."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 1,
          "text": "דזה שתורה"
        },
        {
          "s": 2,
          "text": "[המשכה מלמעלה]"
        },
        {
          "s": 3,
          "text": "ותפלה"
        },
        {
          "s": 4,
          "text": "[עבודת האדם]"
        },
        {
          "s": 5,
          "text": "הם שני ענינים"
        },
        {
          "s": 6,
          "text": "[ובכל אחד מהם יש מעלה]"
        },
        {
          "s": 7,
          "text": "הוא בדרגת הנשמות כמו שנעשות מציאות,"
        },
        {
          "s": 8,
          "text": "אבל מצד שרש הנשמות כמו שמושרשות בהעצמות אין לחלק בין המשכה מלמעלה ובין עבודת האדם40,"
        },
        {
          "s": 9,
          "text": "דישראל וקוב\"ה כולא חד41."
        },
        {
          "s": 10,
          "text": "דגילוי ענין זה"
        },
        {
          "s": 11,
          "text": "(שישראל וקוב\"ה הם חד ממש)"
        },
        {
          "s": 12,
          "text": "הוא בפנימיות התורה,"
        },
        {
          "s": 13,
          "text": "תורתו של רשב\"י,"
        },
        {
          "s": 14,
          "text": "ולכן בתורתו של רשב\"י יש גם ענין התפלה"
        },
        {
          "s": 15,
          "text": "(זיכוך המטה)."
        }
      ]
    }
  ]
}