{
  "globalIndex": 515,
  "owner": 15,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916782_theRebbe_480__p005",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916782_theRebbe_480__p005",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916782_theRebbe_480",
  "title": "מאמר באתי לגני תשכ\"ט",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "ועפ\"ז יש לבאר גם מ\"ש בהמאמר דהתגלות והמשכת אוצר העליון הוא במדת הנצח,"
        },
        {
          "s": 3,
          "text": "שבכדי שהגילוי דאוצר העליון יפעול במדת הנצח שבאדם,"
        },
        {
          "s": 4,
          "text": "שיהי' בכחה לנצח את המנגדים,"
        },
        {
          "s": 5,
          "text": "הוא ע\"י שהתגלות והמשכת האוצר תהי'"
        },
        {
          "s": 6,
          "text": "(בדוגמת התלבשות)"
        },
        {
          "s": 7,
          "text": "במדת הנצח."
        },
        {
          "s": 8,
          "text": "וע\"פ מה שנת\"ל בענין ואתה קדוש יושב תהלות ישראל,"
        },
        {
          "s": 9,
          "text": "שבכדי שההמשכה תהי' באופן דוגמת התלבשות"
        },
        {
          "s": 10,
          "text": "(יושב מענין פרנסה)"
        },
        {
          "s": 11,
          "text": "בענינים פרטים,"
        },
        {
          "s": 12,
          "text": "הוא ע\"י עבודה ששייכת לאותו הענין שבו היא ההמשכה"
        },
        {
          "s": 13,
          "text": "[הגם שבנוגע לההמשכה עצמה"
        },
        {
          "s": 14,
          "text": "(המשכת העצמות)"
        },
        {
          "s": 15,
          "text": "אין שייך לומר שהיא נמשכת ע\"י עבודה שבדוגמתה],"
        },
        {
          "s": 16,
          "text": "יש לומר,"
        },
        {
          "s": 17,
          "text": "שעד\"ז הוא בהענין דהתגלות והמשכת אוצר העליון,"
        },
        {
          "s": 18,
          "text": "שבכדי שההתגלות וההמשכה תהי' במדת הנצח שבאדם באופן שהגילוי יפעול בה,"
        },
        {
          "s": 19,
          "text": "הוא ע\"י העבודה דנצח."
        },
        {
          "s": 20,
          "text": "ויש לומר,"
        },
        {
          "s": 21,
          "text": "דזהו מ\"ש בהמאמר \"במדת הנצח יכולים להגיע לאוצר העליון פירוש דהתגלות והמשכת אוצר העליון היא במדת הנצח\","
        },
        {
          "s": 22,
          "text": "שהכוונה ב\"פירוש כו'\" היא,"
        },
        {
          "s": 23,
          "text": "דזה שהנצח מגיע באוצר העליון הוא לא שהנצח מגיע בהאוצר באופן שמעורר המשכת וגילוי האוצר"
        },
        {
          "s": 24,
          "text": "[בדוגמת אתעדל\"ת שמעוררת האתעדל\"ע],"
        },
        {
          "s": 25,
          "text": "כי בבחינת האוצר אין אתעדל\"ת מגעת לשם"
        },
        {
          "s": 26,
          "text": "[וגם עבודה הבאה מעצם הנפש שמגעת בפנימיות א\"ס הוא רק באופן דהעלאה,"
        },
        {
          "s": 27,
          "text": "וההמשכה היא רק שנמשך גילוי מבחינת הפנימיות ולא הפנימיות עצמו],"
        },
        {
          "s": 28,
          "text": "ולכן מפרש דזה שהנצח מגיע באוצר העליון הוא"
        },
        {
          "s": 29,
          "text": "(לא שמעורר את ההתגלות וההמשכה עצמה,"
        },
        {
          "s": 30,
          "text": "אלא)"
        },
        {
          "s": 31,
          "text": "שההתגלות וההמשכה תהי' במדת הנצח."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 3,
          "text": "שהטעם על פתיחת האוצרות בעת המלחמה הוא,"
        },
        {
          "s": 4,
          "text": "כי עיקר ענין המלחמה הוא הנצוח."
        },
        {
          "s": 5,
          "text": "ויובן זה ע\"פ מה שמבאר אדמו\"ר האמצעי בארוכה70"
        },
        {
          "s": 6,
          "text": "בענין גודל העילוי והיוקר של האוצרות"
        },
        {
          "s": 7,
          "text": "(ושאעפ\"כ,"
        },
        {
          "s": 8,
          "text": "בכדי לנצח מלחמה מבזבז המלך את כל האוצרות),"
        },
        {
          "s": 9,
          "text": "דגם כשלפעמים חפץ המלך להראות לשר גדול אוהבו וריעו כנפשו הכלי יקר וכיו\"ב שנמצאים אצלו,"
        },
        {
          "s": 10,
          "text": "לא יקח מהאוצרות הטמונים מכבר כמה מאות שנים."
        },
        {
          "s": 11,
          "text": "ורק לפרקים רחוקים מאד,"
        },
        {
          "s": 12,
          "text": "כשעושה משתה ושמחה ביום חתונתו או חתונת בנו וכיו\"ב,"
        },
        {
          "s": 13,
          "text": "אז יצווה להוציא גם הכלים היקרים הטמונים מכבר,"
        },
        {
          "s": 14,
          "text": "להראות את יקר תפארת גדולתו ועושר כבוד מלכותו."
        },
        {
          "s": 15,
          "text": "אבל גם אז,"
        },
        {
          "s": 16,
          "text": "אינו מראה כל הכלי יקר שנמצאים בהאוצרות ורק חלק מהם"
        },
        {
          "s": 17,
          "text": "(שאינו טמון כ\"כ),"
        },
        {
          "s": 18,
          "text": "וגם מכלים אלו הוא רק מראה להיושבים במשתה"
        },
        {
          "s": 19,
          "text": "(ואינו נותן להם)."
        },
        {
          "s": 20,
          "text": "משא\"כ בכדי לנצח מלחמה,"
        },
        {
          "s": 21,
          "text": "הוא מוציא"
        },
        {
          "s": 22,
          "text": "(מוכר)"
        },
        {
          "s": 23,
          "text": "כל הכלי יקר וכו' על הוצאות המלחמה,"
        },
        {
          "s": 24,
          "text": "ואין בזה שום הגבלה,"
        },
        {
          "s": 25,
          "text": "דכאשר לא מספיק ההון דאוצר שלו יקח גם מהאוצרות שאצרו אבותיו ואבות אבותיו."
        },
        {
          "s": 26,
          "text": "ומבאר שם,"
        },
        {
          "s": 27,
          "text": "דזה שבכדי לנצח המלחמה הוא מבזבז את כל אוצרותיו,"
        },
        {
          "s": 28,
          "text": "אין זה מפני שרוצה להרחיב גבול ארצו ע\"י שכובש עוד מדינה או להרבות רכושו ע\"י השלל"
        },
        {
          "s": 29,
          "text": "[כי אז הי' משער כמה הון כדאי להשקיע בשביל זה,"
        },
        {
          "s": 30,
          "text": "ולא הי' מוציא את כל אוצרותיו,"
        },
        {
          "s": 31,
          "text": "ומכ\"ש שלא הי' מבזבזם],"
        },
        {
          "s": 32,
          "text": "אלא בכדי לנצח את זה שלוחם כנגדו ומנגד אליו."
        },
        {
          "s": 33,
          "text": "כי הנצחון לנצח את המנגד נוגע לפנימיות הנפש,"
        },
        {
          "s": 34,
          "text": "כמבואר שם בארוכה."
        },
        {
          "s": 35,
          "text": "ויש לומר,"
        },
        {
          "s": 36,
          "text": "דמ\"ש בהמאמר שהטעם על פתיחת האוצרות בעת המלחמה הוא כי עיקר ענין המלחמה הוא הנצח,"
        },
        {
          "s": 37,
          "text": "הכוונה בזה היא,"
        },
        {
          "s": 38,
          "text": "שפתיחת האוצרות בעת המלחמה הוא לא בשביל ענין הכיבוש שיכבוש עוד מדינה וירחיב גבול ארצו,"
        },
        {
          "s": 39,
          "text": "אלא בשביל הנצוח,"
        },
        {
          "s": 40,
          "text": "שזה"
        },
        {
          "s": 41,
          "text": "(נצוח)"
        },
        {
          "s": 42,
          "text": "הוא עיקר ענין המלחמה."
        },
        {
          "s": 43,
          "text": "ועד\"ז הוא גם בהנמשל,"
        },
        {
          "s": 44,
          "text": "דזה שנותנים לישראל"
        },
        {
          "s": 45,
          "text": "(ובאופן דבזבוז71)"
        },
        {
          "s": 46,
          "text": "האוצר שלמעלה בכדי לנצח את המלחמה הוא לא בכדי לכבוש את העולם ולעשותו דירה לו ית',"
        },
        {
          "s": 47,
          "text": "שעי\"ז תושלם הכוונה שנתאוה הקב\"ה להיות לו ית' דירה בתחתונים,"
        },
        {
          "s": 48,
          "text": "כי אם,"
        },
        {
          "s": 49,
          "text": "בשביל הנצחון,"
        },
        {
          "s": 50,
          "text": "לנצח את המנגד."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ב)"
        },
        {
          "s": 2,
          "text": "ובזה יובן מה שמביא בהמאמר,"
        },
        {
          "s": 3,
          "text": "דאיתא במדרש תהלים עה\"פ72"
        },
        {
          "s": 4,
          "text": "תודיעני אורח חיים גו',"
        },
        {
          "s": 5,
          "text": "אמר דוד לפני הקב\"ה תודיעני אורח חיים כו',"
        },
        {
          "s": 6,
          "text": "אמר הקב\"ה לדוד חיים את בעי צפה לתורה כו'."
        },
        {
          "s": 7,
          "text": "ובמדרש רבה73"
        },
        {
          "s": 8,
          "text": "איתא,"
        },
        {
          "s": 9,
          "text": "שובע שמחות את פניך72"
        },
        {
          "s": 10,
          "text": "(אל תקרי שובע אלא שבע74)"
        },
        {
          "s": 11,
          "text": "אלו ז' כתות צדיקים שעתידין להקביל75"
        },
        {
          "s": 12,
          "text": "פני שכינה כו',"
        },
        {
          "s": 13,
          "text": "מי מודיענו איזו כת החביבה והנעימה שבהן כו'"
        },
        {
          "s": 14,
          "text": "(אלו)"
        },
        {
          "s": 15,
          "text": "שהן עתידין לעמוד בימינו של הקב\"ה,"
        },
        {
          "s": 16,
          "text": "הה\"ד72"
        },
        {
          "s": 17,
          "text": "נעימות בימינך נצח."
        },
        {
          "s": 18,
          "text": "וצריך ביאור,"
        },
        {
          "s": 19,
          "text": "דלכאורה,"
        },
        {
          "s": 20,
          "text": "ההוכחה על השייכות דנצח לישראל היא מסיום הכתוב נעימות בימינך נצח,"
        },
        {
          "s": 21,
          "text": "דלפי פירוש המדרש קאי זה על ישראל,"
        },
        {
          "s": 22,
          "text": "ולמה מביא בהמאמר גם פירוש המדרש על הכתוב תודיעני אורח חיים שובע שמחות את פניך76."
        },
        {
          "s": 23,
          "text": "וע\"פ הנ\"ל יש לומר הביאור בזה,"
        },
        {
          "s": 24,
          "text": "דג' הענינים שבהפסוק"
        },
        {
          "s": 25,
          "text": "(תודיעני אורח חיים,"
        },
        {
          "s": 26,
          "text": "שובע שמחות את פניך,"
        },
        {
          "s": 27,
          "text": "נעימות בימינך נצח)"
        },
        {
          "s": 28,
          "text": "הם ג' ענינים בעבודתם של ישראל,"
        },
        {
          "s": 29,
          "text": "שעל ידם מתגלים האוצרות שלמעלה."
        },
        {
          "s": 30,
          "text": "ותודיעני אורח חיים הו\"ע עסק התורה"
        },
        {
          "s": 31,
          "text": "(חיים את בעי צפה לתורה),"
        },
        {
          "s": 32,
          "text": "שהוא דוגמת מתן תורה"
        },
        {
          "s": 33,
          "text": "(מה להלן באימה וביראה כו' אף כאן כו'77),"
        },
        {
          "s": 34,
          "text": "שבשעת מתן תורה,"
        },
        {
          "s": 35,
          "text": "יום חתונתו זה מתן תורה78,"
        },
        {
          "s": 36,
          "text": "נתגלו מהאוצרות שלמעלה,"
        },
        {
          "s": 37,
          "text": "בדוגמת מלך בו\"ד שביום חתונתו מגלה מאוצרותיו79."
        },
        {
          "s": 38,
          "text": "שובע שמחות אלו ז' כתות צדיקים כו' הוא העבודה דישראל לעשות את העולם לדירה לו ית'."
        },
        {
          "s": 39,
          "text": "דזהו ז' כתות צדיקים"
        },
        {
          "s": 40,
          "text": "(ז' דוקא),"
        },
        {
          "s": 41,
          "text": "כי מכיון שכל עניני העולם הם במספר שבע,"
        },
        {
          "s": 42,
          "text": "לכן גם עבודת הצדיקים"
        },
        {
          "s": 43,
          "text": "(ועמך כולם צדיקים)"
        },
        {
          "s": 44,
          "text": "לעשות את העולם לדירה לו ית' נחלקת לז',"
        },
        {
          "s": 45,
          "text": "שבע כתות צדיקים80."
        },
        {
          "s": 46,
          "text": "ויש לומר,"
        },
        {
          "s": 47,
          "text": "דזהו גם מה שהצ\"צ ברשימותיו לתהלים עה\"פ81"
        },
        {
          "s": 48,
          "text": "מביא מרז\"ל זה"
        },
        {
          "s": 49,
          "text": "(דשובע שמחות הוא שבע כתות של צדיקים)"
        },
        {
          "s": 50,
          "text": "בהמשך לדרשת רז\"ל82"
        },
        {
          "s": 51,
          "text": "דשובע שמחות הם ז' הנימין שהיו בכנור של בית המקדש,"
        },
        {
          "s": 52,
          "text": "כי הכוונה דהעולם הוא שישראל יעשו אותו למקדש לו ית'"
        },
        {
          "s": 53,
          "text": "(כמובן גם מההמשך דההילולא בפירוש הכתוב ועשו לי מקדש),"
        },
        {
          "s": 54,
          "text": "וז' הנימין דהכנור שבבית המקדש הם השלימות דז' הענינים של כללות העולם83."
        },
        {
          "s": 55,
          "text": "וזהו שהענין דז' כתות של צדיקים בא בהמשך לענין דז' הנימין של הכנור דבית המקדש,"
        },
        {
          "s": 56,
          "text": "כי העבודה דז' כתות צדיקים היא לעשות את העולם למקדש לו ית'."
        },
        {
          "s": 57,
          "text": "וענין זה"
        },
        {
          "s": 58,
          "text": "(שהעולם נעשה למקדש ודירה לו ית')"
        },
        {
          "s": 59,
          "text": "הוא בדוגמת המלחמה בכדי להרחיב גבול ארצו,"
        },
        {
          "s": 60,
          "text": "שגם בשביל זה מוציא מאוצרותיו84,"
        },
        {
          "s": 61,
          "text": "אבל לא באופן דבזבוז."
        },
        {
          "s": 62,
          "text": "נעימות בימינך נצח הו\"ע הנצחון דישראל שמנצחים את המנגד,"
        },
        {
          "s": 63,
          "text": "שעבודה זו היא החביבה והנעימה"
        },
        {
          "s": 64,
          "text": "(נעימות)"
        },
        {
          "s": 65,
          "text": "של כל ז' העבודות,"
        },
        {
          "s": 66,
          "text": "שבשביל זה נותנים את כל האוצרות,"
        },
        {
          "s": 67,
          "text": "ובאופן דבזבוז"
        },
        {
          "s": 68,
          "text": "(למעלה מחשבון)."
        }
      ]
    }
  ]
}