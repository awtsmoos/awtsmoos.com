{
  "globalIndex": 935,
  "owner": 35,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919310_theRebbe_548__p003",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919310_theRebbe_548__p003",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919310_theRebbe_548",
  "title": "מאמר זה היום עשה ה' תשל\"ח",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה ידוע21,"
        },
        {
          "s": 2,
          "text": "דשרש הטבע הוא משם אלקים"
        },
        {
          "s": 3,
          "text": "(אלקים בגימטריא הטבע22),"
        },
        {
          "s": 4,
          "text": "דבכללות הוא אור הממלא שמתלבש בעולמות לפי ערכם,"
        },
        {
          "s": 5,
          "text": "ושרש הנסים הוא משם הוי',"
        },
        {
          "s": 6,
          "text": "דבכללות הוא אור הסובב שלמעלה מעולמות."
        },
        {
          "s": 7,
          "text": "ומזה מובן,"
        },
        {
          "s": 8,
          "text": "דהנסים שאינם מלובשים בטבע,"
        },
        {
          "s": 9,
          "text": "שרש המשכתם הוא מהגילוי דהוי' עצמו,"
        },
        {
          "s": 10,
          "text": "שלמעלה מהתלבשות בשם אלקים,"
        },
        {
          "s": 11,
          "text": "והנסים המלובשים בטבע שרש המשכתם הוא23"
        },
        {
          "s": 12,
          "text": "מהגילוי דשם הוי' כמו שמתלבש בשם אלקים24."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ויובן זה עד\"מ בכח הרצון שבאדם"
        },
        {
          "s": 1,
          "text": "(דרצון הוא משל על אור הסובב),"
        },
        {
          "s": 2,
          "text": "שיש בו ב' מדריגות."
        },
        {
          "s": 3,
          "text": "רצון שלמעלה מטעם,"
        },
        {
          "s": 4,
          "text": "ורצון שמתלבש בטעם."
        },
        {
          "s": 5,
          "text": "ובזה גופא"
        },
        {
          "s": 6,
          "text": "(ברצון המלובש בטעם)"
        },
        {
          "s": 7,
          "text": "שני אופנים25."
        },
        {
          "s": 8,
          "text": "דעם היותו מלובש בטעם,"
        },
        {
          "s": 9,
          "text": "ניכר בו בגילוי שבעיקרו הוא רצון"
        },
        {
          "s": 10,
          "text": "(שלמעלה מטעם)."
        },
        {
          "s": 11,
          "text": "ושהרצון מטה את השכל באופן שהשכל עצמו נעשה כפי הרצון,"
        },
        {
          "s": 12,
          "text": "ונרגש בו דזה שהוא סובר כן הוא"
        },
        {
          "s": 13,
          "text": "(לא מצד הטיית הרצון אלא)"
        },
        {
          "s": 14,
          "text": "מצד השכל26."
        },
        {
          "s": 15,
          "text": "ועד\"ז הוא בנמשל,"
        },
        {
          "s": 16,
          "text": "בגילוי אור הסובב,"
        },
        {
          "s": 17,
          "text": "שיש בו דוגמת ג' דרגות הנ\"ל,"
        },
        {
          "s": 18,
          "text": "שהם שרש ג' הסוגים בנסים,"
        },
        {
          "s": 19,
          "text": "נס שלמעלה מהטבע לגמרי,"
        },
        {
          "s": 20,
          "text": "נס המלובש בטבע באופן שניכר הנס שבו,"
        },
        {
          "s": 21,
          "text": "ונס המלובש בטבע באופן שהטבע מסתיר הנס שבו."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה זה שנס הוא מלשון הרמה,"
        },
        {
          "s": 2,
          "text": "שע\"י הנס נעשה הרמה ועלי' בהטבע,"
        },
        {
          "s": 3,
          "text": "הוא בעיקר בהנסים המלובשים בטבע27."
        },
        {
          "s": 4,
          "text": "שבהנסים שלמעלה מהטבע,"
        },
        {
          "s": 5,
          "text": "הגילוי דשם הוי' שלמעלה מהטבע הוא באופן שהטבע"
        },
        {
          "s": 6,
          "text": "(הנמשך משם אלקים)"
        },
        {
          "s": 7,
          "text": "בטל ע\"י הגילוי,"
        },
        {
          "s": 8,
          "text": "שידוד מערכות הטבע,"
        },
        {
          "s": 9,
          "text": "וענין נס מלשון הרמה שהגילוי דשם הוי' הוא באופן שהטבע"
        },
        {
          "s": 10,
          "text": "(שנמשך משם אלקים)"
        },
        {
          "s": 11,
          "text": "מתעלה בהאור דשם הוי',"
        },
        {
          "s": 12,
          "text": "הוא"
        },
        {
          "s": 13,
          "text": "(בעיקר)"
        },
        {
          "s": 14,
          "text": "בהנסים המלובשים בטבע."
        },
        {
          "s": 15,
          "text": "אלא שאעפ\"כ,"
        },
        {
          "s": 16,
          "text": "מזה שגם הנסים שאינם מלובשים בטבע נקראים בשם נס מלשון הרמה,"
        },
        {
          "s": 17,
          "text": "מובן,"
        },
        {
          "s": 18,
          "text": "שגם ע\"י נסים אלו נעשה הרמה ועלי' בהטבע."
        },
        {
          "s": 19,
          "text": "דכיון28"
        },
        {
          "s": 20,
          "text": "ששידוד הטבע שע\"י הנס הוא רק בפרט אחד ולא בכללות הדבר"
        },
        {
          "s": 21,
          "text": "[כהנס דקריעת ים סוף,"
        },
        {
          "s": 22,
          "text": "שהשינוי"
        },
        {
          "s": 23,
          "text": "(שידוד הטבע)"
        },
        {
          "s": 24,
          "text": "הי' רק בזה שהמים נצבו כמו נד וכחומה29,"
        },
        {
          "s": 25,
          "text": "אבל עצם חומר המים נשאר כמו שהי' מקודם30],"
        },
        {
          "s": 26,
          "text": "נמצא,"
        },
        {
          "s": 27,
          "text": "שגם בנסים אלה,"
        },
        {
          "s": 28,
          "text": "הגילוי דשם הוי' הוא בהתלבשות בהטבע של כללות הדבר שנעשה בו הנס,"
        },
        {
          "s": 29,
          "text": "ועי\"ז נעשה בו הרמה ועלי'31."
        }
      ]
    }
  ]
}