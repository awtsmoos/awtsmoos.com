{
  "globalIndex": 95,
  "owner": 45,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914243_theRebbe_128__p001",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914243_theRebbe_128__p001",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914243_theRebbe_128",
  "title": "מאמר ולקחתם לכם תשל\"ט",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "מוצאי ש\"פ האזינו,"
        },
        {
          "s": 2,
          "text": "י\"ג תשרי,"
        },
        {
          "s": 3,
          "text": "הילולא דאדמו\"ר מהר\"ש נ\"ע"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "אור לערב חג הסוכות ה'תשל\"ט*"
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ולקחתם לכם ביום הראשון וגו'1,"
        },
        {
          "s": 1,
          "text": "ואיתא במדרש2"
        },
        {
          "s": 2,
          "text": "וכי ראשון הוא והלא ט\"ו"
        },
        {
          "s": 3,
          "text": "[יום3]"
        },
        {
          "s": 4,
          "text": "הוא,"
        },
        {
          "s": 5,
          "text": "אלא ראשון"
        },
        {
          "s": 6,
          "text": "[הוא3]"
        },
        {
          "s": 7,
          "text": "לחשבון עונות."
        },
        {
          "s": 8,
          "text": "דביום הכיפורים הקב\"ה מוותר לישראל את הכל4,"
        },
        {
          "s": 9,
          "text": "ומיום הכיפורים5"
        },
        {
          "s": 10,
          "text": "עד החג כל ישראל עסוקין במצוות,"
        },
        {
          "s": 11,
          "text": "זה עוסק בסוכתו וזה בלולבו,"
        },
        {
          "s": 12,
          "text": "וביום הראשון של חג אומר להם הקב\"ה מאן דאזל אזל ומן הכא ולהלאה6"
        },
        {
          "s": 13,
          "text": "חושבנא."
        },
        {
          "s": 14,
          "text": "ומזה מובן7,"
        },
        {
          "s": 15,
          "text": "דמצות נטילת ד' מינים בט\"ו תשרי הוא מפני שהוא ראשון לחשבון."
        },
        {
          "s": 16,
          "text": "וצריך להבין השייכות דראשון לחשבון לנטילת ד' מינים."
        },
        {
          "s": 17,
          "text": "וביותר צריך ביאור ע\"פ מה דאיתא במדרש8,"
        },
        {
          "s": 18,
          "text": "ישראל ואוה\"ע באין לפני הקב\"ה בראש השנה ולית אנן ידעין מאן נצח,"
        },
        {
          "s": 19,
          "text": "אלא במה שישראל יוצאין מלפני הקב\"ה ולולביהן ואתרוגיהן בידן אנו יודעים דישראל אינון ניצוחייא,"
        },
        {
          "s": 20,
          "text": "לפיכך משה מזהיר להם לישראל ואומר להם ולקחתם לכם כו'."
        },
        {
          "s": 21,
          "text": "היינו,"
        },
        {
          "s": 22,
          "text": "דמצות נטילת ד' מינים בחג הסוכות באה בהמשך להדין דר\"ה,"
        },
        {
          "s": 23,
          "text": "ולמה אומר ולקחתם לכם ביום הראשון,"
        },
        {
          "s": 24,
          "text": "שמצות נטילת ד' מינים ביום זה הוא"
        },
        {
          "s": 25,
          "text": "(לא מפני שהוא יום הט\"ו לר\"ה,"
        },
        {
          "s": 26,
          "text": "אלא)"
        },
        {
          "s": 27,
          "text": "מפני שבו מתחיל ענין חדש,"
        },
        {
          "s": 28,
          "text": "ראשון לחשבון."
        }
      ]
    }
  ]
}