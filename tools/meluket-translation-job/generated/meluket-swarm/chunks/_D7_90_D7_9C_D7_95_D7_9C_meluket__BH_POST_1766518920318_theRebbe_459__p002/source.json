{
  "globalIndex": 1090,
  "owner": 40,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920318_theRebbe_459__p002",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920318_theRebbe_459__p002",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920318_theRebbe_459",
  "title": "מאמר שמח תשמח תשמ\"א",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ויש להוסיף,"
        },
        {
          "s": 2,
          "text": "שהקשר דשני הפירושים ברעים האהובים"
        },
        {
          "s": 3,
          "text": "[דפירוש העיקרי הוא שרעים האהובים קאי על חו\"ב כמבואר בארוכה בהמאמר,"
        },
        {
          "s": 4,
          "text": "אלא שיש בזה עוד פירוש שקאי"
        },
        {
          "s": 5,
          "text": "(גם)"
        },
        {
          "s": 6,
          "text": "על זו\"ן],"
        },
        {
          "s": 7,
          "text": "הוא גם בענין שמח תשמח כו'."
        },
        {
          "s": 8,
          "text": "כי זה שמבקשים שתומשך השמחה בחו\"ב"
        },
        {
          "s": 9,
          "text": "(פירוש העיקרי ברעים האהובים),"
        },
        {
          "s": 10,
          "text": "אף שגם בלאו הכי יש בהם שמחה ועונג,"
        },
        {
          "s": 11,
          "text": "היא שתומשך בהם שמחה נעלית יותר מהשמחה שיש בהם מצד עצמם"
        },
        {
          "s": 12,
          "text": "(כדלקמן בארוכה)."
        },
        {
          "s": 13,
          "text": "והטעם על זה שצריך להמשיך בהם שמחה יתירה הוא בכדי שעי\"ז יהי' הגילוי בזו\"ן"
        },
        {
          "s": 14,
          "text": "(פירוש השני ברעים האהובים)20."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והענין הוא,"
        },
        {
          "s": 2,
          "text": "דהנה עבודת ה' צ\"ל בשמחה כמ\"ש21"
        },
        {
          "s": 3,
          "text": "עבדו את ה' בשמחה וכתיב22"
        },
        {
          "s": 4,
          "text": "תחת אשר לא עבדת את ה' אלקיך בשמחה ובטוב לבב."
        },
        {
          "s": 5,
          "text": "ומכיון שהאדם צריך לעבוד את ה' בכל עניניו,"
        },
        {
          "s": 6,
          "text": "וכל מעשיך יהיו לשם שמים23"
        },
        {
          "s": 7,
          "text": "ו"
        },
        {
          "s": 8,
          "text": "(יתירה מזו24)"
        },
        {
          "s": 9,
          "text": "בכל דרכיך דעהו25,"
        },
        {
          "s": 10,
          "text": "ועד שזהו"
        },
        {
          "s": 11,
          "text": "(עבודת ה')"
        },
        {
          "s": 12,
          "text": "תכלית כל בריאתו כמארז\"ל26"
        },
        {
          "s": 13,
          "text": "אני לא נבראתי אלא לשמש את קוני,"
        },
        {
          "s": 14,
          "text": "הרי נמצא שצ\"ל תמיד בשמחה."
        },
        {
          "s": 15,
          "text": "אלא שבשמחה יש חילוקי דרגות."
        },
        {
          "s": 16,
          "text": "דיש מקומות מיוחדים שהם מקומות של שמחה,"
        },
        {
          "s": 17,
          "text": "וכמו בנין של שמחה27."
        },
        {
          "s": 18,
          "text": "וכ\"ה בנוגע לזמן,"
        },
        {
          "s": 19,
          "text": "דיש זמנים מיוחדים"
        },
        {
          "s": 20,
          "text": "(ימים טובים)"
        },
        {
          "s": 21,
          "text": "שהם מועדים לשמחה28."
        },
        {
          "s": 22,
          "text": "וגם בהם גופא יש חילוקי דרגות,"
        },
        {
          "s": 23,
          "text": "וכמו חג הסוכות שהוא"
        },
        {
          "s": 24,
          "text": "(גם)"
        },
        {
          "s": 25,
          "text": "זמן שמחתנו29."
        },
        {
          "s": 26,
          "text": "ובפרט בשמחת בית השואבה דמי שלא ראה שמחת בית השואבה לא ראה שמחה מימיו30,"
        },
        {
          "s": 27,
          "text": "שהיו מרקדין באבוקות של אור31,"
        },
        {
          "s": 28,
          "text": "דאבוקות של אור הם בחי' חכמה וענין הריקוד"
        },
        {
          "s": 29,
          "text": "(באבוקות)"
        },
        {
          "s": 30,
          "text": "היא ההמשכה"
        },
        {
          "s": 31,
          "text": "(דבחי' חכמה)"
        },
        {
          "s": 32,
          "text": "בבינה"
        },
        {
          "s": 33,
          "text": "[וגם בשמחה זו גופא יש חילוקי דרגות,"
        },
        {
          "s": 34,
          "text": "שהרי לא היו עושין אותה כו' אלא גדולי חכמי ישראל כו' וכל העם כו' באין לראות ולשמוע32]."
        },
        {
          "s": 35,
          "text": "ובפרט בשמח\"ת שהשמחה דשמח\"ת היא נעלית יותר גם מהשמחה דשמחת בית השואבה כדאיתא בלקו\"ת33,"
        },
        {
          "s": 36,
          "text": "ועד ששמו של יום זה"
        },
        {
          "s": 37,
          "text": "(דשמו של כל דבר מורה על ענינו וחיותו34)"
        },
        {
          "s": 38,
          "text": "הוא שמחת תורה35."
        },
        {
          "s": 39,
          "text": "דמכל זה מובן שיש כמה וכמה דרגות בשמחה."
        },
        {
          "s": 40,
          "text": "ונחלקות בכללות לשתי בחינות36."
        },
        {
          "s": 41,
          "text": "שמחה שמורכבת באיזה דבר"
        },
        {
          "s": 42,
          "text": "(וכמו שמחה שמצד השגת שכל וכיו\"ב),"
        },
        {
          "s": 43,
          "text": "דשמחה זו היא בכחות הגלויים והיא בגדר הגבלה,"
        },
        {
          "s": 44,
          "text": "ושמחה עצמית שהיא ועיקרה בעצם הנפש,"
        },
        {
          "s": 45,
          "text": "שלמעלה מגדר הגבלה."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ויובן זה ע\"פ המבואר בהמאמר שם37"
        },
        {
          "s": 2,
          "text": "שטבע השמחה היא לפרוץ גדר,"
        },
        {
          "s": 3,
          "text": "דהיינו כל הגדרה והגבלה שבנפש."
        },
        {
          "s": 4,
          "text": "ומבאר שם שני אופנים בזה."
        },
        {
          "s": 5,
          "text": "אופן הא',"
        },
        {
          "s": 6,
          "text": "שהשמחה פורצת הגדרים שנעשו באדם מצד שהורגל כן,"
        },
        {
          "s": 7,
          "text": "הגם שגדרים אלו נעשו אצלו כטבע"
        },
        {
          "s": 8,
          "text": "(כי הרגל נעשה טבע שני38),"
        },
        {
          "s": 9,
          "text": "ואופן הב',"
        },
        {
          "s": 10,
          "text": "שהשמחה בכחה לפרוץ גם הגדרים שבטבע תולדתו,"
        },
        {
          "s": 11,
          "text": "ועד שבכח השמחה להפוך אותם ולשנותם מן הקצה אל הקצה,"
        },
        {
          "s": 12,
          "text": "והיינו,"
        },
        {
          "s": 13,
          "text": "דמה ששמחה פורצת הגדרים שבטבע תולדתו הוא לא רק שאותם המדות שהוטבעו בהאדם הם בריבוי והתגברות ביותר מכפי מדתם,"
        },
        {
          "s": 14,
          "text": "אלא שע\"י השמחה נעשה גם שינוי בטבע מדותיו ומן הקצה אל הקצה."
        },
        {
          "s": 15,
          "text": "וכמו עד\"מ מי שהוא קמצן וכילי ביותר בטבע תולדתו,"
        },
        {
          "s": 16,
          "text": "הנה בעת השמחה,"
        },
        {
          "s": 17,
          "text": "כשהוא שמח בשמחה גדולה ביותר,"
        },
        {
          "s": 18,
          "text": "יתהפך לבבו לגמרי מטבעו הקודם ונעשה פזרן וחסדן גדול,"
        },
        {
          "s": 19,
          "text": "כמו מי שהוא פזרן וחסדן בטבעו,"
        },
        {
          "s": 20,
          "text": "ועד שמתחסד גם עם שונאו,"
        },
        {
          "s": 21,
          "text": "וי\"ל אפילו לשונאו ע\"פ תורה39."
        },
        {
          "s": 22,
          "text": "והנה גם באופן הא' ששמחה פורצת גדר שמצד ההרגל,"
        },
        {
          "s": 23,
          "text": "צריך ביאור,"
        },
        {
          "s": 24,
          "text": "דמכיון שכל הרגל נעשה טבע,"
        },
        {
          "s": 25,
          "text": "אף שהוא רק טבע שני,"
        },
        {
          "s": 26,
          "text": "הרי לכאורה צריך ריבוי זמן ועבודה לשנות טבע זה לאט לאט,"
        },
        {
          "s": 27,
          "text": "ואיך בכח השמחה לשנותו בשעתא חדא."
        },
        {
          "s": 28,
          "text": "ועאכו\"כ באופן הב',"
        },
        {
          "s": 29,
          "text": "שצריך להבין,"
        },
        {
          "s": 30,
          "text": "איך בכח השמחה לפרוץ הגדרים שבטבע תולדתו,"
        },
        {
          "s": 31,
          "text": "ועד שבכחה לשנות ולהפוך טבעו מן הקצה אל הקצה."
        },
        {
          "s": 32,
          "text": "והענין הוא"
        },
        {
          "s": 33,
          "text": "(כמבואר בהמאמר שם40),"
        },
        {
          "s": 34,
          "text": "דמה ששמחה פורצת גדר"
        },
        {
          "s": 35,
          "text": "(אפילו באופן הא',"
        },
        {
          "s": 36,
          "text": "ומכ\"ש באופן הב')"
        },
        {
          "s": 37,
          "text": "הוא דוקא בשמחה כזו שמגעת בעצם הנפש,"
        },
        {
          "s": 38,
          "text": "שלמעלה מכחות הגלויים."
        },
        {
          "s": 39,
          "text": "דלהיות שעצם הנפש הוא למעלה מגדר הגבלה"
        },
        {
          "s": 40,
          "text": "(להיותו קשור עם העצמות),"
        },
        {
          "s": 41,
          "text": "לכן,"
        },
        {
          "s": 42,
          "text": "השמחה שמצד עצם הנפש,"
        },
        {
          "s": 43,
          "text": "פורצת כל ההגדרות וההגבלות."
        }
      ]
    }
  ]
}