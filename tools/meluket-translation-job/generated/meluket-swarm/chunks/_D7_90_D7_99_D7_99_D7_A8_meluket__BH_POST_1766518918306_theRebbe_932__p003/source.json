{
  "globalIndex": 767,
  "owner": 17,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918306_theRebbe_932__p003",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918306_theRebbe_932__p003",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918306_theRebbe_932",
  "title": "מאמר השמים כסאי תשל\"ו",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דזה שכתוב ואל זה אביט אל עני ונכה רוח לאחרי השמים כסאי גו',"
        },
        {
          "s": 2,
          "text": "אף שגם האמונה שלמטה מהדעת היא בהעצמות"
        },
        {
          "s": 3,
          "text": "[וכמובן מהידוע32"
        },
        {
          "s": 4,
          "text": "דזה ששם שמים שגור בפי כל הוא מפני שהמאור הוא בהתגלות],"
        },
        {
          "s": 5,
          "text": "הוא,"
        },
        {
          "s": 6,
          "text": "כי הבטה"
        },
        {
          "s": 7,
          "text": "(ואל זה אביט)"
        },
        {
          "s": 8,
          "text": "הוא גילוי"
        },
        {
          "s": 9,
          "text": "(כמו דבר שרואה בעיניו),"
        },
        {
          "s": 10,
          "text": "וגילוי העצמות הוא33"
        },
        {
          "s": 11,
          "text": "בהאמונה שלמעלה מהדעת."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "שג' ענינים אלה"
        },
        {
          "s": 3,
          "text": "[עניות שבתחילת העבודה,"
        },
        {
          "s": 4,
          "text": "העבודה דהשמים כסאי גו',"
        },
        {
          "s": 5,
          "text": "והעניות שלאחרי העבודה דהשמים כסאי]"
        },
        {
          "s": 6,
          "text": "הם ע\"ד ג' החלוקות שבפירות האילן"
        },
        {
          "s": 7,
          "text": "(שבפרשתנו34),"
        },
        {
          "s": 8,
          "text": "ג' שני ערלה,"
        },
        {
          "s": 9,
          "text": "שנה הרביעית ושנה החמישית."
        },
        {
          "s": 10,
          "text": "והענין הוא35,"
        },
        {
          "s": 11,
          "text": "דארץ היא מלכות ואילן הוא ז\"א,"
        },
        {
          "s": 12,
          "text": "ונטיעת אילן בארץ"
        },
        {
          "s": 13,
          "text": "(כי תבואו אל הארץ ונטעתם כל עץ מאכל36)"
        },
        {
          "s": 14,
          "text": "הוא המשכת ז\"א במלכות."
        },
        {
          "s": 15,
          "text": "דבהמשכה זו ישנם ג' דרגות."
        },
        {
          "s": 16,
          "text": "דבג' שנים הראשונות,"
        },
        {
          "s": 17,
          "text": "מקבלת המלכות רק מג' ספירות האחרונות דז\"א,"
        },
        {
          "s": 18,
          "text": "נצח הוד ויסוד."
        },
        {
          "s": 19,
          "text": "ומכיון שעיקר ענינם של מדות אלו הוא שעל ידם באה ההשפעה בפועל37,"
        },
        {
          "s": 20,
          "text": "לכן,"
        },
        {
          "s": 21,
          "text": "גם המדות נה\"י הם דוגמת המלכות38"
        },
        {
          "s": 22,
          "text": "שהיא שרש ומקור הנבראים,"
        },
        {
          "s": 23,
          "text": "שנותנים מקום ליש,"
        },
        {
          "s": 24,
          "text": "ואפשר להיות מהם יניקה לחיצונים."
        },
        {
          "s": 25,
          "text": "דזהו הקשר של הפירוש"
        },
        {
          "s": 26,
          "text": "(הנ\"ל)"
        },
        {
          "s": 27,
          "text": "שג' שנים הראשונות הם כנגד ג' המדות נה\"י,"
        },
        {
          "s": 28,
          "text": "עם הפירוש39"
        },
        {
          "s": 29,
          "text": "שג' שנים הראשונות הם כנגד ג' קליפות הטמאות,"
        },
        {
          "s": 30,
          "text": "כי כשהמלכות מקבלת רק מנה\"י אפשר להיות יניקה לג' קליפות הטמאות."
        },
        {
          "s": 31,
          "text": "ולכן הפירות דג' שנים אלו הם ערלה ואסורים בהנאה."
        },
        {
          "s": 32,
          "text": "ובשנה הרביעית מקבלת המלכות מת\"ת"
        },
        {
          "s": 33,
          "text": "(משליש התחתון שבו או משני שלישים שבו)."
        },
        {
          "s": 34,
          "text": "ולכן הפירות דשנה הרביעית הם קודש הילולים להוי'40,"
        },
        {
          "s": 35,
          "text": "דהילול הוא בת\"ת כמ\"ש41"
        },
        {
          "s": 36,
          "text": "ומהללים לשם תפארתך."
        },
        {
          "s": 37,
          "text": "ובשנה החמישית מקבלת המלכות גם משליש העליון דת\"ת."
        },
        {
          "s": 38,
          "text": "וזהו ובשנה החמישית גו' להוסיף לכם תבואתו42,"
        },
        {
          "s": 39,
          "text": "דד' הבחינות תנה\"י"
        },
        {
          "s": 40,
          "text": "(שבשנה הרביעית)"
        },
        {
          "s": 41,
          "text": "שייכים לד' אותיות הוי',"
        },
        {
          "s": 42,
          "text": "ובשנה החמישית,"
        },
        {
          "s": 43,
          "text": "נמשך תוספות אור מקוצו של יו\"ד,"
        },
        {
          "s": 44,
          "text": "כתר."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וביאור הענין דג' חלוקות אלו בעבודת האדם,"
        },
        {
          "s": 2,
          "text": "יש לומר,"
        },
        {
          "s": 3,
          "text": "דענין המלכות הוא קיום התומ\"צ בפועל ממש,"
        },
        {
          "s": 4,
          "text": "במחשבה דיבור ומעשה."
        },
        {
          "s": 5,
          "text": "וזה שמקיים תומ\"צ בפועל ממש הוא ע\"י המשכת וגילוי המדות בהמחשבה דיבור ומעשה."
        },
        {
          "s": 6,
          "text": "ויש בזה ג' אופנים."
        },
        {
          "s": 7,
          "text": "דכשההמשכה היא רק מנה\"י"
        },
        {
          "s": 8,
          "text": "(דמדות אלו הם רק בנוגע לפועל),"
        },
        {
          "s": 9,
          "text": "הנה אף שנה\"י הם שוקיים43"
        },
        {
          "s": 10,
          "text": "ורגלים שמוליכים אותו למקום הראוי,"
        },
        {
          "s": 11,
          "text": "ללכת בדרך הוי',"
        },
        {
          "s": 12,
          "text": "מ\"מ,"
        },
        {
          "s": 13,
          "text": "כיון שאין לו חיות בקיום התומ\"צ"
        },
        {
          "s": 14,
          "text": "(דהחיות בתומ\"צ הוא ע\"י אהבה ויראה דוקא),"
        },
        {
          "s": 15,
          "text": "לכן אפשר שבמשך הזמן תהי' חלישות בעבודתו,"
        },
        {
          "s": 16,
          "text": "ובפרט בקדש עצמך במותר לך44,"
        },
        {
          "s": 17,
          "text": "ועד שיבוא מזה לדברים האסורים"
        },
        {
          "s": 18,
          "text": "(כולל גם דברים האסורים בהנאה45)."
        },
        {
          "s": 19,
          "text": "ולכן העבודה שלו צריכה להיות באופן של אתכפיא."
        },
        {
          "s": 20,
          "text": "ויש לומר,"
        },
        {
          "s": 21,
          "text": "שהוא ע\"ד האמונה שלמטה מהדעת"
        },
        {
          "s": 22,
          "text": "(העניות שלפני העבודה דהשמים כסאי),"
        },
        {
          "s": 23,
          "text": "שגם אמונה זו היא בעצמות אלא שאין בזה גילוי העצמות"
        },
        {
          "s": 24,
          "text": "(כנ\"ל סוף סעיף ד)."
        },
        {
          "s": 25,
          "text": "וע\"ד המבואר בלקו\"ת46"
        },
        {
          "s": 26,
          "text": "(בענין ג' שני ערלה כפשוטם),"
        },
        {
          "s": 27,
          "text": "דזה ששובר תאוותו וממתין ג' שנים ומקיים מל\"ת דשלש שנים יהי' לכם ערלים36"
        },
        {
          "s": 28,
          "text": "הוא כענין מודים אנחנו לך41,"
        },
        {
          "s": 29,
          "text": "שההודאה היא לך,"
        },
        {
          "s": 30,
          "text": "למהותו ועצמותו ית',"
        },
        {
          "s": 31,
          "text": "אלא שאין זה באופן של הילול,"
        },
        {
          "s": 32,
          "text": "דהילול הוא גילוי"
        },
        {
          "s": 33,
          "text": "[כמובא בלקו\"ת47"
        },
        {
          "s": 34,
          "text": "שהילול הוא לשון הארה כמו בהלו נרו48],"
        },
        {
          "s": 35,
          "text": "ורק באופן של הודאה,"
        },
        {
          "s": 36,
          "text": "העלם."
        }
      ]
    }
  ]
}