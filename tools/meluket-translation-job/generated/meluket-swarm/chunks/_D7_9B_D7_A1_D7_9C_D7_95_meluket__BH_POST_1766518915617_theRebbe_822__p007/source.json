{
  "globalIndex": 328,
  "owner": 28,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915617_theRebbe_822__p007",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915617_theRebbe_822__p007",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915617_theRebbe_822",
  "title": "מאמר ברוך שעשה ניסים תשט\"ו",
  "part": 7,
  "sections": [
    {
      "v": 18,
      "items": [
        {
          "s": 0,
          "text": "וזהו שבנסים יש שני אופנים,"
        },
        {
          "s": 1,
          "text": "שינוי בצורת ותכונת הנבראים"
        },
        {
          "s": 2,
          "text": "(כמו קריעת ים סוף שהמים נצבו כמו נד)"
        },
        {
          "s": 3,
          "text": "ושינוי בעצם מציאותם בהחומר שלהם"
        },
        {
          "s": 4,
          "text": "(כהנס שהמים נהפכו לדם ושהמטה נהפך לנחש),"
        },
        {
          "s": 5,
          "text": "דע\"י הביטול שבצורת הנבראים"
        },
        {
          "s": 6,
          "text": "(שהתהוות הצורה היא מהרצון)"
        },
        {
          "s": 7,
          "text": "הם כמו כלים להנס דשינוי הצורה והטבע,"
        },
        {
          "s": 8,
          "text": "וע\"י הביטול שבעצם מציאותם"
        },
        {
          "s": 9,
          "text": "(שהתהוות מציאותם אין לה מקום בשכל)"
        },
        {
          "s": 10,
          "text": "הם כמו כלים להנס דשינוי עצם מציאותם."
        }
      ]
    },
    {
      "v": 19,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "שעד\"ז הוא לאידך,"
        },
        {
          "s": 3,
          "text": "שבכדי שהלמעלה מהטבע יומשך בטבע העולם,"
        },
        {
          "s": 4,
          "text": "הוא ע\"י שבהלמעלה מהטבע יש דוגמת טבע."
        },
        {
          "s": 5,
          "text": "וזהו ברוך שעשה נסים לשון רבים,"
        },
        {
          "s": 6,
          "text": "ריבוי סוגי נסים,"
        },
        {
          "s": 7,
          "text": "דיש לומר דמהטעמים שישנם ריבוי נסים,"
        },
        {
          "s": 8,
          "text": "אף שענין הריבוי"
        },
        {
          "s": 9,
          "text": "(התחלקות)"
        },
        {
          "s": 10,
          "text": "הוא בהשתלשלות והשרש דלמעלה מהטבע הוא למעלה מהשתלשלות,"
        },
        {
          "s": 11,
          "text": "הוא בכדי שעי\"ז יהי' אפשר להיות ההמשכה דלמעלה מהטבע בהטבע דעולם."
        }
      ]
    },
    {
      "v": 20,
      "items": [
        {
          "s": 0,
          "text": "וענין ריבוי הסוגים שבנסים מבאר אדמו\"ר"
        },
        {
          "s": 1,
          "text": "(מוהרש\"ב)"
        },
        {
          "s": 2,
          "text": "נ\"ע בהמאמר,"
        },
        {
          "s": 3,
          "text": "שבכללות נחלקים הם לב' סוגים33."
        },
        {
          "s": 4,
          "text": "נסים שלמעלה מהטבע,"
        },
        {
          "s": 5,
          "text": "ונסים המלובשים בדרכי הטבע."
        },
        {
          "s": 6,
          "text": "ובפרטיות,"
        },
        {
          "s": 7,
          "text": "גם בנסים המלובשים בטבע גופא ישנם שני סוגים."
        },
        {
          "s": 8,
          "text": "שלבושי הטבע הם באופן שניכר בהם שהם רק לבוש להנס שמתלבש בהם,"
        },
        {
          "s": 9,
          "text": "כהנסים דחנוכה ופורים"
        },
        {
          "s": 10,
          "text": "(ועד\"ז הנסים של הגאולה די\"ט כסלו ודי\"ב תמוז)"
        },
        {
          "s": 11,
          "text": "דעם היותן מלובשים בדרכי הטבע,"
        },
        {
          "s": 12,
          "text": "מ\"מ הי' ניכר בגילוי"
        },
        {
          "s": 13,
          "text": "(ועד שראו כל אפסי ארץ)"
        },
        {
          "s": 14,
          "text": "הנס שבהם."
        },
        {
          "s": 15,
          "text": "ושלבושי הטבע מעלימים ומסתירים על הנס שמלובש בהם."
        },
        {
          "s": 16,
          "text": "ועד שלפעמים הם מעלימים ומסתירים לגמרי,"
        },
        {
          "s": 17,
          "text": "שאין ניכר כלל שהוא נס,"
        },
        {
          "s": 18,
          "text": "אין בעל הנס מכיר בנסו34."
        }
      ]
    }
  ]
}