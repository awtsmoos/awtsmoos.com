{
  "globalIndex": 1085,
  "owner": 35,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920213_theRebbe_982__p003",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920213_theRebbe_982__p003",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920213_theRebbe_982",
  "title": "מאמר אני לדודי תשמ\"ו",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה שלימות עבודת הקרבנות"
        },
        {
          "s": 2,
          "text": "(לחמי לאישי)"
        },
        {
          "s": 3,
          "text": "תהי' לע\"ל דוקא."
        },
        {
          "s": 4,
          "text": "כי אף שגם בזמן הגלות ישנו ענין הקרבנות ע\"י העסק בתורת קרבנות36"
        },
        {
          "s": 5,
          "text": "כמ\"ש37"
        },
        {
          "s": 6,
          "text": "ונשלמה פרים שפתנו,"
        },
        {
          "s": 7,
          "text": "שזה כולל גם ענין ונשלמה מלשון שלימות38,"
        },
        {
          "s": 8,
          "text": "מ\"מ עיקר הענין בזה יהי' לע\"ל,"
        },
        {
          "s": 9,
          "text": "ובלשון התפלה39"
        },
        {
          "s": 10,
          "text": "ושם נעשה לפניך כמצות רצונך,"
        },
        {
          "s": 11,
          "text": "שדוקא לע\"ל יהי' קיום כל המצוות,"
        },
        {
          "s": 12,
          "text": "ובפרט מצות הקרבת הקרבנות שהיא עיקר העבודה40,"
        },
        {
          "s": 13,
          "text": "בתכלית השלימות."
        },
        {
          "s": 14,
          "text": "וי\"ל דמפורש בקראי41"
        },
        {
          "s": 15,
          "text": "דלע\"ל יהיו ג\"כ שדות"
        },
        {
          "s": 16,
          "text": "(ואולי י\"ל דירושלים לגבי ביהמ\"ק הוא דוגמת שדה42,"
        },
        {
          "s": 17,
          "text": "נוסף על השדות בפשטות שמחוץ לירושלים)."
        },
        {
          "s": 18,
          "text": "אלא שאז יתבטלו המחיצות דעתה שבין עיר לשדה,"
        },
        {
          "s": 19,
          "text": "דהגילוי שבביהמ\"ק"
        },
        {
          "s": 20,
          "text": "(עיר)"
        },
        {
          "s": 21,
          "text": "יתפשט גם בירושלים עיר הקודש וגם בשדות ומגרשים שמחוץ לירושלים,"
        },
        {
          "s": 22,
          "text": "ע\"ד מארז\"ל43"
        },
        {
          "s": 23,
          "text": "עתידה ירושלים שתתפשט44"
        },
        {
          "s": 24,
          "text": "בכל ארץ ישראל ועתידה ארץ ישראל שתתפשט בכל הארצות,"
        },
        {
          "s": 25,
          "text": "וכמ\"ש45"
        },
        {
          "s": 26,
          "text": "ונגלה כבוד הוי' וראו כל בשר יחדיו גו'."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יש לתרץ ולבאר גם הרמז בהקשר דתוכן דרוש זה"
        },
        {
          "s": 2,
          "text": "(ענין ביטול המחיצות,"
        },
        {
          "s": 3,
          "text": "כולם בשוה)"
        },
        {
          "s": 4,
          "text": "עם פ' שופטים,"
        },
        {
          "s": 5,
          "text": "שהוא בגלוי עם סיום הפרשה."
        },
        {
          "s": 6,
          "text": "דהנה ענין שופטים ושוטרים גו'24"
        },
        {
          "s": 7,
          "text": "הוא"
        },
        {
          "s": 8,
          "text": "(כנ\"ל)"
        },
        {
          "s": 9,
          "text": "לברר החילוק"
        },
        {
          "s": 10,
          "text": "(והמחיצות)"
        },
        {
          "s": 11,
          "text": "שבין זל\"ז,"
        },
        {
          "s": 12,
          "text": "בין דין לדין כו',"
        },
        {
          "s": 13,
          "text": "אבל כשפעולת השופטים נסתיימה ונמשכת לאח\"ז בהנהגה \"ללכת בדרכיו כל הימים\"46,"
        },
        {
          "s": 14,
          "text": "אזי נעשה ביטול המחיצות וכו' ועד אשר לאח\"ז ירחיב ה\"א את גבולך47"
        },
        {
          "s": 15,
          "text": "(ע\"י אשר לפנ\"ז תשמור גו' ללכת בדרכיו כל הימים46),"
        },
        {
          "s": 16,
          "text": "דענין ירחיב ה\"א את גבולך יש לומר אשר ברוחניות זהו\"ע מה שעתידה ארץ ישראל שתתפשט בכל הארצות48."
        },
        {
          "s": 17,
          "text": "ועד שיהי' גם הגילוי דבחי' חב\"ד,"
        },
        {
          "s": 18,
          "text": "כמארז\"ל49"
        },
        {
          "s": 19,
          "text": "עה\"פ ירחיב ה\"א את גבולך דקאי על קיני קניזי וקדמוני,"
        },
        {
          "s": 20,
          "text": "ומבואר בד\"ה אל תצר את מואב לאדמו\"ר האמצעי50"
        },
        {
          "s": 21,
          "text": "שהם בחי' חב\"ד."
        },
        {
          "s": 22,
          "text": "דההמשכה עכשיו היא רק בחי' ז\"ת,"
        },
        {
          "s": 23,
          "text": "ותתרחב לע\"ל,"
        },
        {
          "s": 24,
          "text": "וי\"ל אשר זהו בפרט ע\"י הקדמת העבודה דיפוצו מעינותיך חוצה באופן דהבנה והשגה"
        },
        {
          "s": 25,
          "text": "(יתפרנסון מיני'51),"
        },
        {
          "s": 26,
          "text": "חב\"ד,"
        },
        {
          "s": 27,
          "text": "ולא עוד אלא שגם ג' הארצות"
        },
        {
          "s": 28,
          "text": "(חב\"ד)"
        },
        {
          "s": 29,
          "text": "יהיו באופן דכיבוש,"
        },
        {
          "s": 30,
          "text": "שנעשה \"בעל הבית\" גם עליהם ועד שגם חלק תורה זה ה\"ז \"תורתו\" שנקראת על שמו52."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ויהי רצון שכן תהי' לנו,"
        },
        {
          "s": 2,
          "text": "שע\"י הקדמת העבודה דהפצת המעיינות חוצה וכיבוש חב\"ד שבנפש,"
        },
        {
          "s": 3,
          "text": "נבוא בקרוב ממש לכיבוש חב\"ד שבעולם,"
        },
        {
          "s": 4,
          "text": "עד לכיבוש בתכלית באופן שנקראת על שמו."
        },
        {
          "s": 5,
          "text": "ויקויים זה באופן דאחישנה ובזריזות,"
        },
        {
          "s": 6,
          "text": "שתיכף ומיד"
        },
        {
          "s": 7,
          "text": "(בלשון הרמב\"ם53)"
        },
        {
          "s": 8,
          "text": "מסתיים הגלות,"
        },
        {
          "s": 9,
          "text": "וכובשים בשלימות את ארץ שבעה עממין,"
        },
        {
          "s": 10,
          "text": "ותיכף לאח\"ז גם את ארץ ג' האומות,"
        },
        {
          "s": 11,
          "text": "וביחד ארץ עשר עממין54,"
        },
        {
          "s": 12,
          "text": "דמספר עשר מורה על השלימות דלעתיד,"
        },
        {
          "s": 13,
          "text": "וכמרז\"ל שכינור דלע\"ל הוא בן עשר נימין55,"
        },
        {
          "s": 14,
          "text": "ולע\"ל תהי' השירה העשירית56"
        },
        {
          "s": 15,
          "text": "והפרה העשירית57"
        },
        {
          "s": 16,
          "text": "והמנין העשירי58,"
        },
        {
          "s": 17,
          "text": "שהקב\"ה מונה את ישראל מפני רוב חיבתם59."
        },
        {
          "s": 18,
          "text": "וכ\"ז במהרה בימינו ממש בפשטות,"
        },
        {
          "s": 19,
          "text": "בזמן ומקום שלנו,"
        },
        {
          "s": 20,
          "text": "נשמות בגופים,"
        },
        {
          "s": 21,
          "text": "ובשמחה ובטוב לבב."
        }
      ]
    }
  ]
}