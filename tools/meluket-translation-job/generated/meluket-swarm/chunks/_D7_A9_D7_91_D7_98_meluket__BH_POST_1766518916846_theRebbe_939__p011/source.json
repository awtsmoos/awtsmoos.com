{
  "globalIndex": 540,
  "owner": 40,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916846_theRebbe_939__p011",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916846_theRebbe_939__p011",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916846_theRebbe_939",
  "title": "מאמר באתי לגני תשל\"א",
  "part": 11,
  "sections": [
    {
      "v": 30,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ב)"
        },
        {
          "s": 2,
          "text": "ועפ\"ז יש לבאר מ\"ש בהמאמר שעשיית הדירה בתחתונים היא ע\"י אתכפיא ואתהפכא כמאמר כד אתכפיא סט\"א אסתלק יקרא דקוב\"ה בכולהו עלמין,"
        },
        {
          "s": 3,
          "text": "דבמאמר הזהר שמביא נאמר כד אתכפיא סט\"א ובהמאמר אומר אתכפיא ואתהפכא."
        },
        {
          "s": 4,
          "text": "וי\"ל הביאור בזה,"
        },
        {
          "s": 5,
          "text": "דבמאמר הזהר מדבר בהמשכת הגילוי דלמעלה"
        },
        {
          "s": 6,
          "text": "(אסתלק יקרא דקוב\"ה בכולהו עלמין,"
        },
        {
          "s": 7,
          "text": "המשכת אור הסובב),"
        },
        {
          "s": 8,
          "text": "וזה נעשה ע\"י אתכפיא,"
        },
        {
          "s": 9,
          "text": "ע\"י שהאדם עושה נגד טבעו ורצונו"
        },
        {
          "s": 10,
          "text": "(כנ\"ל סעיף יו\"ד),"
        },
        {
          "s": 11,
          "text": "אבל בכדי שיהי' דירה בתחתונים,"
        },
        {
          "s": 12,
          "text": "דענין דירה בתחתונים הוא שהגילוי שנמשך בתחתונים יהי' גם מצד ענינם דהתחתונים,"
        },
        {
          "s": 13,
          "text": "שיהיו כלים לזה"
        },
        {
          "s": 14,
          "text": "(כנ\"ל סעיף ב),"
        },
        {
          "s": 15,
          "text": "זה נעשה ע\"י אתכפיא ואתהפכא."
        }
      ]
    },
    {
      "v": 31,
      "items": [
        {
          "s": 0,
          "text": "וצריך להבין,"
        },
        {
          "s": 1,
          "text": "דמבואר בהמאמר בענין המעלה דאתהפכא,"
        },
        {
          "s": 2,
          "text": "שיתרון האור הוא מן החושך דוקא,"
        },
        {
          "s": 3,
          "text": "דע\"י שהחושך נהפך לאור נעשה יתרון האור."
        },
        {
          "s": 4,
          "text": "דמזה מובן,"
        },
        {
          "s": 5,
          "text": "שהמעלה דאתהפכא היא לא רק בנוגע להתחתון"
        },
        {
          "s": 6,
          "text": "(שע\"י העבודה דאתהפכא נעשה כלי),"
        },
        {
          "s": 7,
          "text": "אלא שע\"י אתהפכא נעשה גם יתרון בההמשכה"
        },
        {
          "s": 8,
          "text": "(יתרון האור)."
        },
        {
          "s": 9,
          "text": "ובמאמר הזהר שמביא נאמר כד אתכפיא סט\"א כו'."
        },
        {
          "s": 10,
          "text": "ויש לומר,"
        },
        {
          "s": 11,
          "text": "דההמשכה שע\"י אתכפיא היא גילוי,"
        },
        {
          "s": 12,
          "text": "אלא שהגילוי הוא למעלה משייכות לעולמות."
        },
        {
          "s": 13,
          "text": "[דע\"י שהאדם עושה כנגד טבעו,"
        },
        {
          "s": 14,
          "text": "המשכת הגילוי היא לא כפי הטבע שלו,"
        },
        {
          "s": 15,
          "text": "וגם האור שלמעלה משייכות לעולמות"
        },
        {
          "s": 16,
          "text": "(אסתלק)"
        },
        {
          "s": 17,
          "text": "נמשך בגילוי בעולם]."
        },
        {
          "s": 18,
          "text": "והעבודה דאתהפכא מגעת במקום שלמעלה מגילוי"
        },
        {
          "s": 19,
          "text": "[כי זה שהחושך נהפך לאור הוא מצד העצמות שאור וחושך שוים לגבי'."
        },
        {
          "s": 20,
          "text": "וגם,"
        },
        {
          "s": 21,
          "text": "לפי שע\"י אתהפכא נעשה התחתון כלי"
        },
        {
          "s": 22,
          "text": "(כנ\"ל),"
        },
        {
          "s": 23,
          "text": "שעי\"ז נשלמת הכוונה דדירה בתחתונים,"
        },
        {
          "s": 24,
          "text": "כוונת העצמות],"
        },
        {
          "s": 25,
          "text": "ועי\"ז נעשה יתרון גם בהאור והגילוי שנמשך משם."
        },
        {
          "s": 26,
          "text": "ולכן צריכים להיות שני הענינים,"
        },
        {
          "s": 27,
          "text": "אתכפיא ואתהפכא,"
        },
        {
          "s": 28,
          "text": "כי בתחלה צ\"ל המשכת הגילויים ע\"י אתכפיא,"
        },
        {
          "s": 29,
          "text": "וע\"י אתהפכא שלאחרי אתכפיא,"
        },
        {
          "s": 30,
          "text": "נעשה התחתון כלי להגילוי,"
        },
        {
          "s": 31,
          "text": "ונעשה יתרון גם בהגילוי שהמשכתו היא ממקום שלמעלה מגילוי."
        }
      ]
    },
    {
      "v": 32,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ג)"
        },
        {
          "s": 2,
          "text": "והנה שני ענינים הנ\"ל הם בעיקר בבעל תשובה."
        },
        {
          "s": 3,
          "text": "דנוסף לזה שהבעל תשובה קורא ושונה יותר מטבעו ורגילותו כמובא לעיל"
        },
        {
          "s": 4,
          "text": "(סעיף יו\"ד)"
        },
        {
          "s": 5,
          "text": "מדרושי אדמו\"ר מהר\"ש,"
        },
        {
          "s": 6,
          "text": "הבעלי תשובה כובשים את יצרם יותר מצדיקים115."
        },
        {
          "s": 7,
          "text": "ועד\"ז הוא בהעבודה דאתהפכא116."
        },
        {
          "s": 8,
          "text": "כי עיקר המעלה דאתהפכא חשוכא לנהורא היא כשהפיכת החושך לאור היא לא מצד האור אלא שהחושך מצד עצמו נהפך לאור117,"
        },
        {
          "s": 9,
          "text": "וענין זה הוא בעיקר בבעל תשובה."
        },
        {
          "s": 10,
          "text": "דבצדיקים,"
        },
        {
          "s": 11,
          "text": "גם העבודה דאתהפכא שלהם היא ע\"י שמרגישים אלקות,"
        },
        {
          "s": 12,
          "text": "גילוי מלמעלה,"
        },
        {
          "s": 13,
          "text": "והאתהפכא דבעל תשובה,"
        },
        {
          "s": 14,
          "text": "שמשתנה ונהפך מן הקצה אל הקצה,"
        },
        {
          "s": 15,
          "text": "היא מצד עצמו118."
        },
        {
          "s": 16,
          "text": "ויש לומר,"
        },
        {
          "s": 17,
          "text": "דענין זה מרומז בתורת הבעש\"ט עה\"פ ויהי ערב ויהי בוקר גו'"
        },
        {
          "s": 18,
          "text": "(שהובאה לעיל סעיף ז),"
        },
        {
          "s": 19,
          "text": "שמבאר שם"
        },
        {
          "s": 20,
          "text": "[בהמשך להביאור בענין איני יודע באיזה מהן חפץ]"
        },
        {
          "s": 21,
          "text": "מה שאמר דוד המלך69"
        },
        {
          "s": 22,
          "text": "חשבתי דרכי ואשיבה רגלי אל עדותיך,"
        },
        {
          "s": 23,
          "text": "חשבתי דרכי הוא שדוד הי' חושב בדרכיו הגשמיים"
        },
        {
          "s": 24,
          "text": "(כמבואר שם הטעם על זה),"
        },
        {
          "s": 25,
          "text": "ואשיבה רגלי גו' – אשובה להרגיל"
        },
        {
          "s": 26,
          "text": "(רגלי מלשון הרגל)"
        },
        {
          "s": 27,
          "text": "אל עדותיך."
        },
        {
          "s": 28,
          "text": "ויש לומר,"
        },
        {
          "s": 29,
          "text": "דענינו של דוד הוא שהקים עולה של תשובה119."
        },
        {
          "s": 30,
          "text": "ובתורה הנ\"ל דהבעש\"ט מרמז שתי המעלות שבבע\"ת."
        },
        {
          "s": 31,
          "text": "אשובה להרגיל – שינוי הרגילות,"
        },
        {
          "s": 32,
          "text": "אתכפיא,"
        },
        {
          "s": 33,
          "text": "וביאור הענין דאיני יודע באיזה מהן חפץ – ענין הבחירה והעבודה בכח עצמו"
        },
        {
          "s": 34,
          "text": "(כנ\"ל סעיף ז),"
        },
        {
          "s": 35,
          "text": "אתהפכא."
        }
      ]
    }
  ]
}