  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518916037_theRebbe_540__p008",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518916037_theRebbe_540__p008",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518916037_theRebbe_540",
  "title": "מאמר וישב יעקב תשכ\"ז",
  "part": 8,
  "sections": [
    {
      "v": 21,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ג)"
        },
        {
          "s": 2,
          "text": "והנה102 ענין המסחר,"
        },
        {
          "s": 3,
          "text": "כנען הנ\"ל,"
        },
        {
          "s": 4,
          "text": "הוא ע\"י וישב יעקב,"
        },
        {
          "s": 5,
          "text": "השפלה103"
        },
        {
          "s": 6,
          "text": "וירידת הנשמה למטה לברר הגוף ונה\"ב וחלקו בעולם,"
        },
        {
          "s": 7,
          "text": "בירור וזיכוך והעלאת ניצוצות דקדושה שנפלו בשבה\"כ דתוהו,"
        },
        {
          "s": 8,
          "text": "וזהו שישובי יעקב באו ע\"י ישובי עשו ותולדותיו לפני מלך מלך לבנ\"י וישובי עשו הם בדרך קצרה דוקא,"
        },
        {
          "s": 9,
          "text": "ע\"ד מחז\"ל104"
        },
        {
          "s": 10,
          "text": "(בקדושה)"
        },
        {
          "s": 11,
          "text": "ישנה אדם לתלמידו דרך קצרה,"
        },
        {
          "s": 12,
          "text": "כלים מועטין דתוהו,"
        },
        {
          "s": 13,
          "text": "והם לא היו ספונים"
        },
        {
          "s": 14,
          "text": "(וטמונים),"
        },
        {
          "s": 15,
          "text": "כי בשרשם יעקב קדם,"
        },
        {
          "s": 16,
          "text": "ולא היו חשובים,"
        },
        {
          "s": 17,
          "text": "כי דין לא הניין לי'90,"
        },
        {
          "s": 18,
          "text": "והבירור הנרצה הוא באופן דקרב,"
        },
        {
          "s": 19,
          "text": "קירוב והרגשה דוקא"
        },
        {
          "s": 20,
          "text": "(וכמשי\"ת לקמן בארוכה),"
        },
        {
          "s": 21,
          "text": "שאז ברבים,"
        },
        {
          "s": 22,
          "text": "נפשות עשו ל' רבים,"
        },
        {
          "s": 23,
          "text": "היו עמדי,"
        },
        {
          "s": 24,
          "text": "שלא יודחה כל ניצוץ דקדושה כנ\"ל,"
        },
        {
          "s": 25,
          "text": "ועד אשר גם אויביו ישלים עמו זה הנחש,"
        },
        {
          "s": 26,
          "text": "חויא דגרים מיתה בעלמא,"
        },
        {
          "s": 27,
          "text": "בחי' רב,"
        },
        {
          "s": 28,
          "text": "יהי' שלום,"
        },
        {
          "s": 29,
          "text": "ורב שלום בניך105,"
        },
        {
          "s": 30,
          "text": "פדה בשלום."
        }
      ]
    }
  ]
}