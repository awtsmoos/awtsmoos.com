{
  "globalIndex": 1099,
  "owner": 49,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920368_theRebbe_469__p007",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920368_theRebbe_469__p007",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920368_theRebbe_469",
  "title": "מאמר השקיפה ממעון קדשך תשכ\"ז",
  "part": 7,
  "sections": [
    {
      "v": 18,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "ויש להוסיף,"
        },
        {
          "s": 3,
          "text": "דענין הנותן שלג כצמר שייך גם להענין דירושלים וציון שבתחלת המאמר."
        },
        {
          "s": 4,
          "text": "דירושלים וציון"
        },
        {
          "s": 5,
          "text": "(יראה תתאה ויראה עילאה)"
        },
        {
          "s": 6,
          "text": "הם בדוגמת שלג וצמר."
        },
        {
          "s": 7,
          "text": "דיראה תתאה,"
        },
        {
          "s": 8,
          "text": "כיון שהיראה היא מגדולתו ית' שבבריאת העולם,"
        },
        {
          "s": 9,
          "text": "שייכת היא גם לנפש הבהמית – ע\"ד הדרגא דשלג שפועלת בכחות הגלויים,"
        },
        {
          "s": 10,
          "text": "ויראה עילאה,"
        },
        {
          "s": 11,
          "text": "כיון שהיא מהרוממות דאוא\"ס שלמעלה מעולמות,"
        },
        {
          "s": 12,
          "text": "לכן,"
        },
        {
          "s": 13,
          "text": "אף שבנוגע לנפש האלקית היא יראה גדולה יותר,"
        },
        {
          "s": 14,
          "text": "היא באופן שהיראה דהנשמה אינה פועלת על נפש הבהמית66"
        },
        {
          "s": 15,
          "text": "– ע\"ד הדרגא דצמר,"
        },
        {
          "s": 16,
          "text": "שאינה פועלת בכחות הגלויים."
        },
        {
          "s": 17,
          "text": "וכמו שבחינת צמר,"
        },
        {
          "s": 18,
          "text": "עם היותה למעלה מבחינת שלג,"
        },
        {
          "s": 19,
          "text": "מ\"מ,"
        },
        {
          "s": 20,
          "text": "ע\"י המשכתה לבחינת שלג,"
        },
        {
          "s": 21,
          "text": "נעשה בה עילוי,"
        },
        {
          "s": 22,
          "text": "עד\"ז הוא ביראה עילאה"
        },
        {
          "s": 23,
          "text": "(ציון),"
        },
        {
          "s": 24,
          "text": "שע\"י שנמשך ממנה נתינת כח ביראה תתאה"
        },
        {
          "s": 25,
          "text": "(ירושלים),"
        },
        {
          "s": 26,
          "text": "לפעול בירור הגוף ונה\"ב וחלקו בעולם,"
        },
        {
          "s": 27,
          "text": "נעשה בה עילוי"
        },
        {
          "s": 28,
          "text": "[וע\"ד גדול תלמוד שמביא לידי מעשה,"
        },
        {
          "s": 29,
          "text": "דע\"י שהתלמוד מביא לידי מעשה,"
        },
        {
          "s": 30,
          "text": "נעשה גדלות בהתלמוד]."
        },
        {
          "s": 31,
          "text": "אלא שבציון וירושלים,"
        },
        {
          "s": 32,
          "text": "ההמשכה דציון וירושלים היא רק שמציון נמשך נתינת כח לירושלים"
        },
        {
          "s": 33,
          "text": "[וע\"ד תלמוד שמביא לידי מעשה],"
        },
        {
          "s": 34,
          "text": "ובצמר ושלג,"
        },
        {
          "s": 35,
          "text": "בחינת צמר עצמה נמשכת בבחינת שלג,"
        },
        {
          "s": 36,
          "text": "כמשנת\"ל"
        },
        {
          "s": 37,
          "text": "(סעיף יו\"ד)"
        },
        {
          "s": 38,
          "text": "בענין הנותן שלג כצמר."
        },
        {
          "s": 39,
          "text": "ולכן העילוי שנעשה בצמר ע\"י המשכתו בשלג הוא עילוי גדול יותר מהעילוי שנעשה בציון ע\"י המשכתו בירושלים,"
        },
        {
          "s": 40,
          "text": "וכנ\"ל"
        },
        {
          "s": 41,
          "text": "(שם)"
        },
        {
          "s": 42,
          "text": "שע\"י החיבור דצמר ושלג מתגלה שורש הנשמה כמו שהיא מושרשת בהעצמות."
        }
      ]
    },
    {
      "v": 19,
      "items": [
        {
          "s": 0,
          "text": "ויש להוסיף,"
        },
        {
          "s": 1,
          "text": "דהעילוי שנעשה בהעליון ע\"י המשכתו למטה הוא גם בההמשכה דבחינת שלג ודבחינת צמר בכחות הגלויים."
        },
        {
          "s": 2,
          "text": "שע\"י המשכת הנשמה שלמעלה מכחות הפנימיים"
        },
        {
          "s": 3,
          "text": "(בחינת שלג או בחינת צמר)"
        },
        {
          "s": 4,
          "text": "בכחות הפנימיים לתקן ולמלאות הפגמים,"
        },
        {
          "s": 5,
          "text": "נעשה בה עילוי."
        },
        {
          "s": 6,
          "text": "ועד\"ז הוא בכחות הפנימיים,"
        },
        {
          "s": 7,
          "text": "(שכל ומדות),"
        },
        {
          "s": 8,
          "text": "שע\"י המשכתם במחשבה דיבור ומעשה,"
        },
        {
          "s": 9,
          "text": "נעשה בהם עילוי."
        },
        {
          "s": 10,
          "text": "אלא שעיקר ענין זה"
        },
        {
          "s": 11,
          "text": "(העילוי שנעשה בהעליון ע\"י ירידתו למטה)"
        },
        {
          "s": 12,
          "text": "הוא כשהעליון פועל שינוי בהתחתון,"
        },
        {
          "s": 13,
          "text": "שעי\"ז גם הפעולה דהתחתון בהעליון הוא באופן דשינוי,"
        },
        {
          "s": 14,
          "text": "שהעלי' שנעשית בו ע\"י ירידתו למטה היא עלי' שבאין ערוך."
        },
        {
          "s": 15,
          "text": "ולכן עיקר הענין דמעלת התחתון והעלי' שנעשית על ידו בהעליון,"
        },
        {
          "s": 16,
          "text": "הוא בעבודת התשובה,"
        },
        {
          "s": 17,
          "text": "שע\"י ההמשכה דעצם הנשמה"
        },
        {
          "s": 18,
          "text": "(בחינת שלג או בחינת צמר)"
        },
        {
          "s": 19,
          "text": "בכחות הפנימיים נעשה בהם שינוי,"
        },
        {
          "s": 20,
          "text": "ועד להפיכת זדונות לזכיות."
        },
        {
          "s": 21,
          "text": "ולכן,"
        },
        {
          "s": 22,
          "text": "גם העלי' שנעשית עי\"ז בעצם הנשמה,"
        },
        {
          "s": 23,
          "text": "היא עלי' שבאין ערוך."
        }
      ]
    },
    {
      "v": 20,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ב)"
        },
        {
          "s": 2,
          "text": "וזהו השקיפה ממעון קדשך מן השמים וברך את עמך את ישראל,"
        },
        {
          "s": 3,
          "text": "ומבואר בהמאמר דהטעם שמקדים עמך לישראל הוא כי עיקר הגילוי הוא במעשה,"
        },
        {
          "s": 4,
          "text": "דגדול תלמוד שמביא לידי מעשה ועושי מצוה מהפכים את הקללה לברכה,"
        },
        {
          "s": 5,
          "text": "דעיקר המעלה דמעשה הוא בעבודת התשובה שמהפכת זדונות"
        },
        {
          "s": 6,
          "text": "(קללה)"
        },
        {
          "s": 7,
          "text": "לזכיות"
        },
        {
          "s": 8,
          "text": "(ברכה)."
        },
        {
          "s": 9,
          "text": "ויש לומר,"
        },
        {
          "s": 10,
          "text": "שג' הענינים דהוי' אלקיך שבפסוק ולא אבה גו' המבוארים בהמאמר הם עבודת הצדיקים"
        },
        {
          "s": 11,
          "text": "(העבודה דתומ\"צ),"
        },
        {
          "s": 12,
          "text": "עבודת התשובה דבחינת שלג ועבודת התשובה דבחינת צמר."
        },
        {
          "s": 13,
          "text": "דענין ולא אבה הוי' אלקיך לשמוע אל בלעם שאינו רוצה מלכתחילה לשמוע למקטרגים הוא ע\"ד עבודת הצדיקים."
        },
        {
          "s": 14,
          "text": "וענין ויהפוך הוי' אלקיך לך את הקללה לברכה,"
        },
        {
          "s": 15,
          "text": "הפיכת זדונות לזכיות ע\"י גילוי הוי' דלעילא שלמעלה מהשתלשלות הוא ע\"ד עבודת התשובה דבחינת שלג – למעלה מהשתלשלות שבאדם."
        },
        {
          "s": 16,
          "text": "וענין כי אהבך הוי' אלקיך,"
        },
        {
          "s": 17,
          "text": "אהבה עצמית דהקב\"ה לישראל דגם במקום שאח עשו ליעקב מ\"מ ואוהב את יעקב דוקא,"
        },
        {
          "s": 18,
          "text": "הוא ע\"ד התשובה דבחינת צמר – תיקון הפגמים ע\"י גילוי עצם הנשמה שגם בשעת החטא"
        },
        {
          "s": 19,
          "text": "(כשהוא דומה לעשו)"
        },
        {
          "s": 20,
          "text": "היא באמנה אתו ית'."
        }
      ]
    }
  ]
}