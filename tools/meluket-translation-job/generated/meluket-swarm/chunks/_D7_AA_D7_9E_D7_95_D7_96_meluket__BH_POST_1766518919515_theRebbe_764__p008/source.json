{
  "globalIndex": 972,
  "owner": 22,
  "jobId": "_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919515_theRebbe_764__p008",
  "batchId": "meluket-_D7_AA_D7_9E_D7_95_D7_96_meluket__BH_POST_1766518919515_theRebbe_764__p008",
  "seriesId": "תמוז_meluket",
  "postId": "BH_POST_1766518919515_theRebbe_764",
  "title": "מאמר גדול יהי' תשכ\"ב",
  "part": 8,
  "sections": [
    {
      "v": 21,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ויש לומר,"
        },
        {
          "s": 2,
          "text": "שגילוי ענין זה דלית דין אתר הדיוט יהי' בבית השלישי."
        },
        {
          "s": 3,
          "text": "והענין הוא,"
        },
        {
          "s": 4,
          "text": "דבית ראשון ושני הם בד' האותיות דשם הוי' שרומזים על עשר ספירות"
        },
        {
          "s": 5,
          "text": "[בית ראשון הוא ה' עילאה"
        },
        {
          "s": 6,
          "text": "(בינה)"
        },
        {
          "s": 7,
          "text": "שעל ידה הוא גילוי היו\"ד"
        },
        {
          "s": 8,
          "text": "(חכמה),"
        },
        {
          "s": 9,
          "text": "ובית שני הוא ה' תתאה"
        },
        {
          "s": 10,
          "text": "(מלכות)"
        },
        {
          "s": 11,
          "text": "שעל ידה הוא גילוי הוא\"ו"
        },
        {
          "s": 12,
          "text": "(ז\"א)]67,"
        },
        {
          "s": 13,
          "text": "ובית שלישי הוא כתר כמובא לעיל"
        },
        {
          "s": 14,
          "text": "(סעיף ג)"
        },
        {
          "s": 15,
          "text": "דיבוא ארי' הוא גילוי הכתר שלמעלה מהשתלשלות."
        }
      ]
    },
    {
      "v": 22,
      "items": [
        {
          "s": 0,
          "text": "והנה בעשר ספירות הגילוי וההעלם שבהם"
        },
        {
          "s": 1,
          "text": "(אורות וכלים)"
        },
        {
          "s": 2,
          "text": "הם שני ענינים,"
        },
        {
          "s": 3,
          "text": "וזה ששני הענינים דגילוי והעלם הם שמותיו של הקב\"ה שלמעלה משניהם הוא ע\"י גילוי הכתר שלמעלה מהשתלשלות."
        },
        {
          "s": 4,
          "text": "דכמו שענין ההתחלקות דספירות"
        },
        {
          "s": 5,
          "text": "(חכמה,"
        },
        {
          "s": 6,
          "text": "בינה וכו')"
        },
        {
          "s": 7,
          "text": "הוא"
        },
        {
          "s": 8,
          "text": "(בעיקר)"
        },
        {
          "s": 9,
          "text": "בספירות הגלויות דאצילות משא\"כ ע\"ס הגנוזות שבכתר הם כלולים כאחד,"
        },
        {
          "s": 10,
          "text": "עד\"ז הוא גם בענין ההתחלקות דאורות וכלים"
        },
        {
          "s": 11,
          "text": "(גילוי והעלם),"
        },
        {
          "s": 12,
          "text": "שבע\"ס הגנוזות הם"
        },
        {
          "s": 13,
          "text": "(האורות והכלים)"
        },
        {
          "s": 14,
          "text": "בהתאחדות."
        },
        {
          "s": 15,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 16,
          "text": "שאמיתית הענין דלית דין אתר הדיוט שגם המקום עצמו יהי' כמו כלי להגילוי דלמעלה מהמקום יהי' בגילוי בבית השלישי."
        },
        {
          "s": 17,
          "text": "כי אז יומשך בגילוי גם בהשמות הוי' ואלקים כמו שהם בהשתלשלות"
        },
        {
          "s": 18,
          "text": "[ועי\"ז,"
        },
        {
          "s": 19,
          "text": "גם בשני הענינים דלמעלה ממקום ומקום,"
        },
        {
          "s": 20,
          "text": "גם כמו שהם למטה בעוה\"ז הגשמי]"
        },
        {
          "s": 21,
          "text": "ששניהם הם שמותיו של הקב\"ה שלמעלה משניהם,"
        },
        {
          "s": 22,
          "text": "וכולא חד."
        }
      ]
    },
    {
      "v": 23,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יובן מ\"ש בכ\"מ"
        },
        {
          "s": 1,
          "text": "(הובא לעיל סעיף א)"
        },
        {
          "s": 2,
          "text": "דמעלת בית השלישי הוא שיהי' קיים בקיום נצחי,"
        },
        {
          "s": 3,
          "text": "דלכאורה,"
        },
        {
          "s": 4,
          "text": "כיון שענין הנצחיות הי' אפשר להיות גם בבית הראשון"
        },
        {
          "s": 5,
          "text": "(כמובא לעיל סעיף ג)"
        },
        {
          "s": 6,
          "text": "איך אומרים שזוהי המעלה דבית השלישי."
        },
        {
          "s": 7,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 8,
          "text": "דהנצחיות שהיתה יכולה להיות בבית ראשון היא"
        },
        {
          "s": 9,
          "text": "(בעיקר)"
        },
        {
          "s": 10,
          "text": "מצד הגילוי דלמעלה מהזמן,"
        },
        {
          "s": 11,
          "text": "והחידוש בהנצחיות שתהי' בבית השלישי הוא שגם הזמן יהי' כלי לזה68."
        },
        {
          "s": 12,
          "text": "וזהו שמעלת בית השלישי היא שיהי' קיים בקיום נצחי,"
        },
        {
          "s": 13,
          "text": "כי אמיתית ענין הבלי גבול"
        },
        {
          "s": 14,
          "text": "(נצחיות)"
        },
        {
          "s": 15,
          "text": "הוא,"
        },
        {
          "s": 16,
          "text": "שהנצחיות היא לא רק מצד ההמשכה מלמעלה אלא שהמטה הוא כלי לזה,"
        },
        {
          "s": 17,
          "text": "ו\"נצחיות\" זו היא רק בבית השלישי."
        }
      ]
    }
  ]
}