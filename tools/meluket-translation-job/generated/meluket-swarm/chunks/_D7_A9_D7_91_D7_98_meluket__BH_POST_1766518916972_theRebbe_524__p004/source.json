{
  "globalIndex": 563,
  "owner": 13,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916972_theRebbe_524__p004",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916972_theRebbe_524__p004",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916972_theRebbe_524",
  "title": "מאמר באתי לגני תשמ\"ח",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ויש להוסיף,"
        },
        {
          "s": 2,
          "text": "דעי\"ז שהנשיאים ועד כ\"ק מו\"ח אדמו\"ר בעל ההילולא כתבו וביארו ענינים הנ\"ל שיהי' מובן שהענין דעתיק שייך לאדם התחתון,"
        },
        {
          "s": 3,
          "text": "הנה עי\"ז ניתוסף עוד יותר בהנתינת כח לכאו\"א שיהי' לו שייכות להענין דעתיק,"
        },
        {
          "s": 4,
          "text": "ובכל הדרגות שבו,"
        },
        {
          "s": 5,
          "text": "עד לפנימיות עתיק."
        },
        {
          "s": 6,
          "text": "ובפרט ע\"פ הידוע בנוגע לאדמו\"ר הזקן47,"
        },
        {
          "s": 7,
          "text": "דמזה מובן שכן הוא בהנשיאים שלאחריו,"
        },
        {
          "s": 8,
          "text": "ממלאי מקומו,"
        },
        {
          "s": 9,
          "text": "דבעת שאמר או כתב ע\"ד איזה ענין ומדריגה,"
        },
        {
          "s": 10,
          "text": "הנה לא זו בלבד שהוא עצמו הי' אז במצב זה,"
        },
        {
          "s": 11,
          "text": "אלא שגם פעל גם על החסידים."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "ויובן זה"
        },
        {
          "s": 3,
          "text": "(השייכות דעתיק לאדם התחתון)"
        },
        {
          "s": 4,
          "text": "ע\"פ תורת הרב המגיד48"
        },
        {
          "s": 5,
          "text": "על מרז\"ל49"
        },
        {
          "s": 6,
          "text": "דע מה למעלה ממך,"
        },
        {
          "s": 7,
          "text": "דכל מה שלמעלה הכל הוא ממך."
        },
        {
          "s": 8,
          "text": "ופירש אדמו\"ר הזקן50,"
        },
        {
          "s": 9,
          "text": "דזה מה שכל מה שלמעלה הכל הוא ממך,"
        },
        {
          "s": 10,
          "text": "הוא"
        },
        {
          "s": 11,
          "text": "(לא רק שע\"י עבודת האדם נעשה תוספות אור,"
        },
        {
          "s": 12,
          "text": "וכיו\"ב,"
        },
        {
          "s": 13,
          "text": "אלא)"
        },
        {
          "s": 14,
          "text": "שהמציאות שלמעלה נעשית ע\"י עבודת האדם."
        },
        {
          "s": 15,
          "text": "והנה מלשון הרב המגיד \"שכל מה שלמעלה הכל הוא ממך\" מובן שזהו לא רק בנוגע לספירות אלא גם בנוגע לעתיק"
        },
        {
          "s": 16,
          "text": "[ואדרבה,"
        },
        {
          "s": 17,
          "text": "מכיון שעתיק הו\"ע עיקרי,"
        },
        {
          "s": 18,
          "text": "הרי בנוגע לעתיק זהו ביותר],"
        },
        {
          "s": 19,
          "text": "וגם בנוגע הענינים שלמעלה מעתיק."
        },
        {
          "s": 20,
          "text": "והענין הוא,"
        },
        {
          "s": 21,
          "text": "דכל הענינים שלמעלה,"
        },
        {
          "s": 22,
          "text": "התהוותם היא יש מאין."
        },
        {
          "s": 23,
          "text": "ולא רק הענינים שאחרי הצמצום,"
        },
        {
          "s": 24,
          "text": "שנתהוו ע\"י הצמצום,"
        },
        {
          "s": 25,
          "text": "אלא גם הענינים שלפני הצמצום,"
        },
        {
          "s": 26,
          "text": "גם האורות הכי נעלים,"
        },
        {
          "s": 27,
          "text": "מכיון שהם ענין שאינו עצמות,"
        },
        {
          "s": 28,
          "text": "הרי נתהוו מהעצמות."
        },
        {
          "s": 29,
          "text": "ובלשון הרמב\"ם51,"
        },
        {
          "s": 30,
          "text": "שכל הנמצאים"
        },
        {
          "s": 31,
          "text": "[דבכל הנמצאים נכללו גם אורות הכי נעלים]"
        },
        {
          "s": 32,
          "text": "לא נמצאו אלא מאמתת המצאו."
        },
        {
          "s": 33,
          "text": "דאמיתת המצאו הוא העצמות,"
        },
        {
          "s": 34,
          "text": "שמציאותו מעצמותו ואינו עלול מאיזה עילה שקדמה לו ח\"ו52,"
        },
        {
          "s": 35,
          "text": "וממנו נמצאו"
        },
        {
          "s": 36,
          "text": "(נתהוו)"
        },
        {
          "s": 37,
          "text": "כל הנמצאים."
        },
        {
          "s": 38,
          "text": "ואופן התהוותם מהעצמות הוא ע\"י עבודת האדם."
        },
        {
          "s": 39,
          "text": "והטעם לזה הוא,"
        },
        {
          "s": 40,
          "text": "כי כל הענינים שלמעלה,"
        },
        {
          "s": 41,
          "text": "הם בבחי' ירידה מאור פניו ית'53"
        },
        {
          "s": 42,
          "text": "(ואין בהם עלי' מצד עצמם),"
        },
        {
          "s": 43,
          "text": "וכוונת הירידה היא בכדי שיהי' התהוות עוה\"ז התחתון,"
        },
        {
          "s": 44,
          "text": "שאין תחתון למטה ממנו,"
        },
        {
          "s": 45,
          "text": "שבו דוקא"
        },
        {
          "s": 46,
          "text": "(בעוה\"ז),"
        },
        {
          "s": 47,
          "text": "ע\"י עבודת האדם,"
        },
        {
          "s": 48,
          "text": "מתחיל ענין העלי'."
        },
        {
          "s": 49,
          "text": "ועי\"ז נשלמה הכוונה דהתהוות הענינים שלמעלה,"
        },
        {
          "s": 50,
          "text": "שגם בהם נעשה עלי'54."
        },
        {
          "s": 51,
          "text": "ולכן,"
        },
        {
          "s": 52,
          "text": "ההתהוות דכל הענינים שלמעלה,"
        },
        {
          "s": 53,
          "text": "מה שהם מתהווים תמיד מאין ליש,"
        },
        {
          "s": 54,
          "text": "כתורת הבעש\"ט הידועה55"
        },
        {
          "s": 55,
          "text": "שההתהוות היא תמיד בכל רגע ורגע,"
        },
        {
          "s": 56,
          "text": "היא ממך,"
        },
        {
          "s": 57,
          "text": "ע\"י עבודת האדם."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "ועפ\"ז יובן גם מה שמבאר הצ\"צ56"
        },
        {
          "s": 3,
          "text": "עה\"פ57"
        },
        {
          "s": 4,
          "text": "כי א-ל דעות הוי' ולא נתכנו עלילות,"
        },
        {
          "s": 5,
          "text": "דהקרי הוא ולו בוא\"ו,"
        },
        {
          "s": 6,
          "text": "והכתיב הוא ולא באל\"ף,"
        },
        {
          "s": 7,
          "text": "דדעות לשון רבים הם דעת עליון ודעת תחתון,"
        },
        {
          "s": 8,
          "text": "דדעת תחתון יש בו התחלקות חו\"ג משא\"כ דעת עליון הוא למעלה מהתחלקות,"
        },
        {
          "s": 9,
          "text": "כי ד\"ע הוא בעתיק שאין שם דין."
        },
        {
          "s": 10,
          "text": "וענין ולא באל\"ף ולא בוא\"ו הוא בשתי דיעות אלו."
        },
        {
          "s": 11,
          "text": "ולו בוא\"ו הוא בדעת תחתון,"
        },
        {
          "s": 12,
          "text": "ששם נתכנו עלילות,"
        },
        {
          "s": 13,
          "text": "ולא באל\"ף הוא בדעת עליון,"
        },
        {
          "s": 14,
          "text": "דשם לא נתכנו עלילות,"
        },
        {
          "s": 15,
          "text": "שאין מעשה בנ\"א"
        },
        {
          "s": 16,
          "text": "(עלילות)"
        },
        {
          "s": 17,
          "text": "נוגע שם."
        },
        {
          "s": 18,
          "text": "ומבאר שם58,"
        },
        {
          "s": 19,
          "text": "דבאמת הקרי והכתיב הכל אחד."
        },
        {
          "s": 20,
          "text": "ויש לומר הכוונה בזה,"
        },
        {
          "s": 21,
          "text": "שמכיון שגם עתיק שלמעלה מקוין נעשה ע\"י עבודת האדם"
        },
        {
          "s": 22,
          "text": "(כנ\"ל),"
        },
        {
          "s": 23,
          "text": "לכן גם הענין דולא נתכנו"
        },
        {
          "s": 24,
          "text": "(ולא באל\"ף)"
        },
        {
          "s": 25,
          "text": "שייך לאדם,"
        },
        {
          "s": 26,
          "text": "גם לאדם התחתון,"
        },
        {
          "s": 27,
          "text": "ולו נתכנו"
        },
        {
          "s": 28,
          "text": "(ולא בוא\"ו)."
        },
        {
          "s": 29,
          "text": "ויש לקשר ענין זה"
        },
        {
          "s": 30,
          "text": "(החיבור דדעת עליון שבבחי' לא אדם עם דעת תחתון שבבחי' אדם)"
        },
        {
          "s": 31,
          "text": "עם זה שמבאר הצ\"צ שם59"
        },
        {
          "s": 32,
          "text": "בפירוש א-ל דעות הוי',"
        },
        {
          "s": 33,
          "text": "דא-ל הוי' מחבר שתי הדיעות."
        },
        {
          "s": 34,
          "text": "ויש לומר,"
        },
        {
          "s": 35,
          "text": "דזהו גם מה שעבודת האדם היא בכלל בג' הענינים דסור60"
        },
        {
          "s": 36,
          "text": "מרע ועשה טוב בקש שלום61"
        },
        {
          "s": 37,
          "text": "[דמכיון שאדם הוא בציור ג' קוין,"
        },
        {
          "s": 38,
          "text": "לכן גם עבודתו היא בג' קוין],"
        },
        {
          "s": 39,
          "text": "דב' הקוין דסור מרע ועשה טוב שייכים לשתי הדיעות62,"
        },
        {
          "s": 40,
          "text": "והעבודה דבקש שלום"
        },
        {
          "s": 41,
          "text": "[דשלום הוא תורה63,"
        },
        {
          "s": 42,
          "text": "קו האמצעי]"
        },
        {
          "s": 43,
          "text": "הוא החיבור דשתי הדיעות,"
        },
        {
          "s": 44,
          "text": "החיבור דלא אדם עם אדם."
        },
        {
          "s": 45,
          "text": "וגם ענין זה שייך להאדם,"
        },
        {
          "s": 46,
          "text": "מכיון שזה נעשה ע\"י עבודתו."
        }
      ]
    }
  ]
}