{
  "globalIndex": 628,
  "owner": 28,
  "jobId": "_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917418_theRebbe_694__p003",
  "batchId": "meluket-_D7_90_D7_93_D7_A8_meluket__BH_POST_1766518917418_theRebbe_694__p003",
  "seriesId": "אדר_meluket",
  "postId": "BH_POST_1766518917418_theRebbe_694",
  "title": "מאמר וקבל היהודים תשי\"א",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ויש להוסיף,"
        },
        {
          "s": 2,
          "text": "שהשרש דג' אופנים אלו בקיום המצוות,"
        },
        {
          "s": 3,
          "text": "הוא,"
        },
        {
          "s": 4,
          "text": "כי גם במצוות עצמם יש ג' ענינים"
        },
        {
          "s": 5,
          "text": "(בדוגמת ג' האופנים שבקיום המצוות)."
        },
        {
          "s": 6,
          "text": "והענין הוא,"
        },
        {
          "s": 7,
          "text": "דנתינת המצוות"
        },
        {
          "s": 8,
          "text": "(למטה)"
        },
        {
          "s": 9,
          "text": "היא כמרז\"ל40"
        },
        {
          "s": 10,
          "text": "לא ניתנו המצוות אלא לצרף בהן את הבריות."
        },
        {
          "s": 11,
          "text": "היינו,"
        },
        {
          "s": 12,
          "text": "שהכוונה בנתינת המצוות היא"
        },
        {
          "s": 13,
          "text": "(לא בשביל המצוות עצמם,"
        },
        {
          "s": 14,
          "text": "אלא)"
        },
        {
          "s": 15,
          "text": "בשביל הבירור והזיכוך של כחות ואברי האדם שמקיים את המצוה ובשביל הבירור והזיכוך של הדברים שבעולם שבהם מקיימים את המצוה41."
        },
        {
          "s": 16,
          "text": "ויש ענין נעלה יותר במצוות,"
        },
        {
          "s": 17,
          "text": "שהם מצוותיו של הקב\"ה,"
        },
        {
          "s": 18,
          "text": "כדרשת רז\"ל42"
        },
        {
          "s": 19,
          "text": "עה\"פ43"
        },
        {
          "s": 20,
          "text": "מגיד דבריו ליעקב חוקיו ומשפטיו לישראל,"
        },
        {
          "s": 21,
          "text": "מה שהוא עושה הוא אומר לישראל לעשות,"
        },
        {
          "s": 22,
          "text": "דזה שהקב\"ה מקיים את המצוות"
        },
        {
          "s": 23,
          "text": "(קודם44"
        },
        {
          "s": 24,
          "text": "שאומר לישראל לעשות)"
        },
        {
          "s": 25,
          "text": "הוא מצד עצמו"
        },
        {
          "s": 26,
          "text": "(מצד למעלה)."
        },
        {
          "s": 27,
          "text": "[וכמובן גם מזה שרמ\"ח פיקודין הם רמ\"ח אברין דמלכא45,"
        },
        {
          "s": 28,
          "text": "דזה שהמצוות הם האברים שלו כביכול הוא מצד למעלה]."
        },
        {
          "s": 29,
          "text": "וע\"י שישראל עושים את המצוות שהוא עושה,"
        },
        {
          "s": 30,
          "text": "הם הולכים בדרכיו של הקב\"ה46"
        },
        {
          "s": 31,
          "text": "ודבוקים בו47,"
        },
        {
          "s": 32,
          "text": "ועי\"ז נמשך חיות להאדם שמקיים המצוות,"
        },
        {
          "s": 33,
          "text": "כמ\"ש48"
        },
        {
          "s": 34,
          "text": "אשר יעשה אותם האדם וחי בהם,"
        },
        {
          "s": 35,
          "text": "כי ע\"י עשיית המצוות הוא מתדבק בהקב\"ה"
        },
        {
          "s": 36,
          "text": "(כנ\"ל),"
        },
        {
          "s": 37,
          "text": "וע\"י ואתם הדבקים בהוי' אלקיכם"
        },
        {
          "s": 38,
          "text": "(עי\"ז)"
        },
        {
          "s": 39,
          "text": "חיים כולכם היום 49."
        },
        {
          "s": 40,
          "text": "וכיון שענין זה שבמצוות"
        },
        {
          "s": 41,
          "text": "(שהם דרכיו של הקב\"ה,"
        },
        {
          "s": 42,
          "text": "עי\"ז שהקב\"ה עושה את המצוות)"
        },
        {
          "s": 43,
          "text": "הוא למעלה משייכות לעולמות,"
        },
        {
          "s": 44,
          "text": "לכן,"
        },
        {
          "s": 45,
          "text": "גם החיות שנמשך להאדם שמקיים את המצוות הוא החיות דבחי' סובב,"
        },
        {
          "s": 46,
          "text": "שמצד עצמו הוא קדוש ומובדל מעולמות ואעפ\"כ ע\"י קיום המצוות הוא חי בהם בחיות פנימי50."
        },
        {
          "s": 47,
          "text": "אמנם גם ענין זה שבמצוות,"
        },
        {
          "s": 48,
          "text": "הוא בדרגא שיש בה ציור."
        },
        {
          "s": 49,
          "text": "ולכן המצוות שבדרגא זו הם בהתחלקות,"
        },
        {
          "s": 50,
          "text": "דרכי הוי'"
        },
        {
          "s": 51,
          "text": "(לשון רבים)51,"
        },
        {
          "s": 52,
          "text": "רמ\"ח אברים דמלכא,"
        },
        {
          "s": 53,
          "text": "דההמשכה שע\"י כל מצוה היא המשכה פרטית"
        },
        {
          "s": 54,
          "text": "(דוגמת כח הראי' בעין וכח השמיעה באוזן)."
        },
        {
          "s": 55,
          "text": "ולכן שייך שהאדם יעשה את המצוות שהקב\"ה עושה,"
        },
        {
          "s": 56,
          "text": "כי רמ\"ח האברים שבאדם התחתון הם כביכול בדוגמת רמ\"ח אברים דמלכא,"
        },
        {
          "s": 57,
          "text": "נעשה אדם בצלמנו כדמותנו52."
        },
        {
          "s": 58,
          "text": "ויש ענין נעלה יותר במצוות,"
        },
        {
          "s": 59,
          "text": "זה שהמצוות הם רצון העליון"
        },
        {
          "s": 60,
          "text": "(רצון שלמעלה מהטעם),"
        },
        {
          "s": 61,
          "text": "דהרצון שבמצוות הוא בכל תרי\"ג המצוות בשוה"
        },
        {
          "s": 62,
          "text": "(למעלה מרמ\"ח אברים)."
        },
        {
          "s": 63,
          "text": "וכיון שהרצון שבמצוות הוא למעלה באין ערוך מהאדם התחתון שמקיים את המצוה"
        },
        {
          "s": 64,
          "text": "(במכ\"ש מזה שהוא למעלה מהציור דאדם העליון),"
        },
        {
          "s": 65,
          "text": "לכן,"
        },
        {
          "s": 66,
          "text": "לגבי53"
        },
        {
          "s": 67,
          "text": "דרגא זו"
        },
        {
          "s": 68,
          "text": "(כמו שהיא מצד עצמה)"
        },
        {
          "s": 69,
          "text": "אין האדם תופס מקום,"
        },
        {
          "s": 70,
          "text": "דהביטול דהעדר תפיסת מקום הוא ביטול במציאות54."
        },
        {
          "s": 71,
          "text": "וגם לאחרי שישנו הציווי להאדם שעי\"ז הוא נעשה מציאות,"
        },
        {
          "s": 72,
          "text": "כל מציאותו היא רק למלאות את הציווי,"
        },
        {
          "s": 73,
          "text": "וע\"י שהוא ממלא את הציווי הוא מתחבר"
        },
        {
          "s": 74,
          "text": "(מצוה מלשון צוותא וחיבור55)"
        },
        {
          "s": 75,
          "text": "עם המצווה"
        },
        {
          "s": 76,
          "text": "(שהוא למעלה ממנו באין ערוך)."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ועד\"ז הוא בלימוד התורה,"
        },
        {
          "s": 2,
          "text": "שיש בזה ג' אופנים אלו."
        },
        {
          "s": 3,
          "text": "דנוסף לג' האופנים שישנם במצות תלמוד תורה"
        },
        {
          "s": 4,
          "text": "(כבכל המצוות),"
        },
        {
          "s": 5,
          "text": "הנה גם בהענין דלימוד התורה עצמו ישנם"
        },
        {
          "s": 6,
          "text": "(דוגמת)"
        },
        {
          "s": 7,
          "text": "ג' אופנים אלו."
        },
        {
          "s": 8,
          "text": "דכשלומד תורה מצד החכמה והשכל שבה,"
        },
        {
          "s": 9,
          "text": "שהתורה היא חכמתכם ובינתכם"
        },
        {
          "s": 10,
          "text": "(אפילו)"
        },
        {
          "s": 11,
          "text": "לעיני העמים56,"
        },
        {
          "s": 12,
          "text": "לימוד התורה שלו הוא מצד טבע גופו ונפשו הטבעית,"
        },
        {
          "s": 13,
          "text": "שבטבעו הוא אוהב מושכלות."
        },
        {
          "s": 14,
          "text": "וכשלימוד התורה שלו הוא מצד זה שהתורה היא ממוצע המקשר ישראל וקוב\"ה,"
        },
        {
          "s": 15,
          "text": "כמאמר הזהר57"
        },
        {
          "s": 16,
          "text": "תלת קשרין מתקשראן דא בדא ישראל אורייתא וקוב\"ה,"
        },
        {
          "s": 17,
          "text": "דע\"י שישראל מתקשראן באורייתא הם מתקשרים בהקב\"ה,"
        },
        {
          "s": 18,
          "text": "לימוד התורה שלו הוא מצד הנשמה שבו."
        },
        {
          "s": 19,
          "text": "היינו,"
        },
        {
          "s": 20,
          "text": "שגם אופן זה בלימוד התורה הוא מצד מציאותו"
        },
        {
          "s": 21,
          "text": "(שיהי' קשור בהקב\"ה)"
        },
        {
          "s": 22,
          "text": "אלא שהוא המציאות דהנשמה."
        },
        {
          "s": 23,
          "text": "ויש אופן נעלה יותר בלימוד התורה,"
        },
        {
          "s": 24,
          "text": "דזה שלומד תורה הוא"
        },
        {
          "s": 25,
          "text": "(לא מפני העילוי שיהי' לו עי\"ז,"
        },
        {
          "s": 26,
          "text": "אלא)"
        },
        {
          "s": 27,
          "text": "מצד התורה עצמה."
        },
        {
          "s": 28,
          "text": "דמכיון שאורייתא וקוב\"ה כולא חד58,"
        },
        {
          "s": 29,
          "text": "ויתירה מזו שהיא חד עם העצמות,"
        },
        {
          "s": 30,
          "text": "כמארז\"ל59"
        },
        {
          "s": 31,
          "text": "שאנכי הוא ר\"ת אנא נפשי כתבית יהבית,"
        },
        {
          "s": 32,
          "text": "דאנא"
        },
        {
          "s": 33,
          "text": "(נפשי)"
        },
        {
          "s": 34,
          "text": "הוא עצמותו ית',"
        },
        {
          "s": 35,
          "text": "ופירוש אנא נפשי כתבית יהבית הוא60"
        },
        {
          "s": 36,
          "text": "אַז ער האָט אַריינגעשריבן און אַריינגעגעבן זיך אַליין,"
        },
        {
          "s": 37,
          "text": "אנא נפשי,"
        },
        {
          "s": 38,
          "text": "שע\"י התורה אותי אתם לוקחים61,"
        },
        {
          "s": 39,
          "text": "לכן כמו שהקב\"ה אינו ח\"ו אמצעי לאיזה ענין אחר וה\"תכלית\" הוא בו בעצמו,"
        },
        {
          "s": 40,
          "text": "עד\"ז62"
        },
        {
          "s": 41,
          "text": "הוא גם בלימוד התורה דהאדם,"
        },
        {
          "s": 42,
          "text": "שנרגש אצלו שהתכלית דלימוד התורה שלו היא התורה עצמה."
        },
        {
          "s": 43,
          "text": "דזה שיודע שאורייתא וקוב\"ה כולא חד,"
        },
        {
          "s": 44,
          "text": "פועל עליו שמוסר ונותן את עצמו ללימוד התורה בלי כל חשבונות"
        },
        {
          "s": 45,
          "text": "(גם לא החשבון שעי\"ז יתקשר בהקב\"ה),"
        },
        {
          "s": 46,
          "text": "ולימוד התורה שלו הוא בתכלית הביטול."
        },
        {
          "s": 47,
          "text": "וג' אופנים אלו שבלימוד התורה נמשכים מג' הענינים שבתורה עצמה,"
        },
        {
          "s": 48,
          "text": "שהתורה היא חכמה ושכל"
        },
        {
          "s": 49,
          "text": "(היינו שהיא חכמתו של הקב\"ה ואח\"כ ירדה ונתלבשה בשכל האדם63),"
        },
        {
          "s": 50,
          "text": "שהתורה היא ממוצע המקשר ישראל בקוב\"ה,"
        },
        {
          "s": 51,
          "text": "ושאורייתא וקוב\"ה כולא חד."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "והנה ג' ענינים הנ\"ל יש דוגמתם גם בדיני והלכות תלמוד תורה."
        },
        {
          "s": 2,
          "text": "דהחיוב ללמוד ההלכות הצריכות למעשה64"
        },
        {
          "s": 3,
          "text": "בכדי לידע את המעשה אשר יעשה,"
        },
        {
          "s": 4,
          "text": "הוא ע\"ד לימוד התורה שמצד"
        },
        {
          "s": 5,
          "text": "(טבע)"
        },
        {
          "s": 6,
          "text": "הגוף ונפש הטבעית,"
        },
        {
          "s": 7,
          "text": "מכיון שעשיית המצוות"
        },
        {
          "s": 8,
          "text": "(כולל המצוות התלויות בדיבור65)"
        },
        {
          "s": 9,
          "text": "הוא ע\"י הגוף ונפש החיונית66."
        },
        {
          "s": 10,
          "text": "והחיוב דמצות ידיעת התורה,"
        },
        {
          "s": 11,
          "text": "לידע כל התורה כולה"
        },
        {
          "s": 12,
          "text": "(גם הענינים שאינם צריכים למעשה),"
        },
        {
          "s": 13,
          "text": "כיון שענינה של מצוה זו הוא שהאדם ידע את התורה,"
        },
        {
          "s": 14,
          "text": "הוא ע\"ד לימוד התורה בשביל הנשמה."
        },
        {
          "s": 15,
          "text": "ויש לומר,"
        },
        {
          "s": 16,
          "text": "שזהו הטעם על זה שיש שיעור וקצבה להמצוה דידיעת התורה"
        },
        {
          "s": 17,
          "text": "[דמ\"ש67"
        },
        {
          "s": 18,
          "text": "ארוכה מארץ מדה הוא שאין קץ לעומק טעמי ההלכות,"
        },
        {
          "s": 19,
          "text": "אבל ההלכות עצמם וכן המדרשים וכו' יש להם קץ ומספר68"
        },
        {
          "s": 20,
          "text": "והיו כמה וכמה שלמדו וידעו כל התורה כולה69],"
        },
        {
          "s": 21,
          "text": "כי מכיון שהמצוה דידיעת התורה היא שהאדם ידע את התורה,"
        },
        {
          "s": 22,
          "text": "והאדם הוא מוגבל,"
        },
        {
          "s": 23,
          "text": "לכן גם התורה"
        },
        {
          "s": 24,
          "text": "(ששייכת למצוה זו)"
        },
        {
          "s": 25,
          "text": "היא במדידה והגבלה."
        },
        {
          "s": 26,
          "text": "והחיוב דוהגית בו יומם ולילה70"
        },
        {
          "s": 27,
          "text": "[גם לאחרי שלמד כל התורה,"
        },
        {
          "s": 28,
          "text": "ועד\"ז בנוגע לאלה שדעתם קצרה ולא יגיעו לידיעת כל התורה71]"
        },
        {
          "s": 29,
          "text": "הוא החיוב דלימוד התורה מצד התורה עצמה."
        },
        {
          "s": 30,
          "text": "וכיון שהתורה"
        },
        {
          "s": 31,
          "text": "(כמו שהיא מצד עצמה)"
        },
        {
          "s": 32,
          "text": "היא למעלה ממדידה והגבלה"
        },
        {
          "s": 33,
          "text": "(ארוכה מארץ מדה),"
        },
        {
          "s": 34,
          "text": "לכן,"
        },
        {
          "s": 35,
          "text": "גם המצוה דתלמוד תורה"
        },
        {
          "s": 36,
          "text": "(כמו שהיא מצד התורה עצמה)"
        },
        {
          "s": 37,
