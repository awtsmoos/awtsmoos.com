{
  "globalIndex": 263,
  "owner": 13,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915304_theRebbe_180__p009",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915304_theRebbe_180__p009",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915304_theRebbe_180",
  "title": "מאמר ושבתי בשלום תשל\"ח",
  "part": 9,
  "sections": [
    {
      "v": 24,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ז)"
        },
        {
          "s": 2,
          "text": "ועפ\"ז יובן היתרון שבהעבודה בכל מעשיך לשם שמים ובכל דרכיך דעהו"
        },
        {
          "s": 3,
          "text": "(לא רק בנוגע להפעולה בעולם,"
        },
        {
          "s": 4,
          "text": "אלא)"
        },
        {
          "s": 5,
          "text": "גם בנוגע להאדם"
        },
        {
          "s": 6,
          "text": "(הנשמה),"
        },
        {
          "s": 7,
          "text": "כי זה שהנשמה ע\"י עבודתה בירידתה למטה נעשית בחי' בעל תשובה הוא בעיקר ע\"י העבודה בעשיית דברי הרשות לשם שמים154."
        },
        {
          "s": 8,
          "text": "והענין הוא,"
        },
        {
          "s": 9,
          "text": "הנה כתיב155"
        },
        {
          "s": 10,
          "text": "ועמך כולם צדיקים,"
        },
        {
          "s": 11,
          "text": "והטעם לזה הוא לפי שאמיתית מהותו של כ\"א מישראל הוא"
        },
        {
          "s": 12,
          "text": "(כנ\"ל סעיף יב)"
        },
        {
          "s": 13,
          "text": "נפשו האלקית."
        },
        {
          "s": 14,
          "text": "וכפס\"ד הרמב\"ם"
        },
        {
          "s": 15,
          "text": "(הובא לעיל שם)"
        },
        {
          "s": 16,
          "text": "שרצונו האמיתי של כאו\"א מישראל הוא לעשות כל מה שהוא רצון ה',"
        },
        {
          "s": 17,
          "text": "וכאשר כופין אותו"
        },
        {
          "s": 18,
          "text": "(ומכ\"ש כאשר הוא עצמו כופה את עצמו)"
        },
        {
          "s": 19,
          "text": "לעשות איזו מצוה,"
        },
        {
          "s": 20,
          "text": "תשש יצרו הרע ומתגלה בו רצונו האמיתי שלו."
        },
        {
          "s": 21,
          "text": "ומכיון שבשעה זו שהוא עוסק בתומ\"צ מתגלה בו רצונו האמיתי דנפשו האלקית,"
        },
        {
          "s": 22,
          "text": "הרי בשעה זו הוא בבחי' צדיק."
        },
        {
          "s": 23,
          "text": "דהגם שגם בשעה זו גופא אפשר שיהי' בו ענינים דהיפך הקדושה,"
        },
        {
          "s": 24,
          "text": "מ\"מ,"
        },
        {
          "s": 25,
          "text": "מכיון שהטעם האמיתי לזה שמקיים המצוה הוא לפי שנתגלה בו רצונו הפנימי,"
        },
        {
          "s": 26,
          "text": "הרי בנוגע להמצוה שעושה הוא בבחי' צדיק."
        },
        {
          "s": 27,
          "text": "[וזהו מה שבהבקשה דונתן לי לחם לאכול ובגד ללבוש לא נזכר שזה יהי' באופן של שלום,"
        },
        {
          "s": 28,
          "text": "כי ענין השלום שייך כשיש מנגד"
        },
        {
          "s": 29,
          "text": "[וכענין פדה בשלום נפשי156"
        },
        {
          "s": 30,
          "text": "(השייך להגאולה דיו\"ד כסלו157)"
        },
        {
          "s": 31,
          "text": "שזהו מצד"
        },
        {
          "s": 32,
          "text": "(כמו שממשיך בכתוב156)"
        },
        {
          "s": 33,
          "text": "מקרב לי],"
        },
        {
          "s": 34,
          "text": "ולכן כמו שבצדיק אין שייך לומר שעבודתו היא בשלום,"
        },
        {
          "s": 35,
          "text": "מכיון שאין158"
        },
        {
          "s": 36,
          "text": "לו יצה\"ר כלל,"
        },
        {
          "s": 37,
          "text": "עד\"ז הוא גם בהתומ\"צ"
        },
        {
          "s": 38,
          "text": "(לחם ובגד)"
        },
        {
          "s": 39,
          "text": "דכ\"א מישראל,"
        },
        {
          "s": 40,
          "text": "מכיון שבשעה זו עומד בגילוי הרצון דנפה\"א,"
        },
        {
          "s": 41,
          "text": "והתומ\"צ שעושה הוא מצד רצון הנשמה,"
        },
        {
          "s": 42,
          "text": "בחי' צדיק שבו]."
        },
        {
          "s": 43,
          "text": "משא\"כ כשעוסק בעניני הרשות,"
        },
        {
          "s": 44,
          "text": "מכיון שעשייתו ענינים אלו היא מצד שהם צורך הגוף וקיומו וחיותו159"
        },
        {
          "s": 45,
          "text": "או גם מצד נפשו הבהמית"
        },
        {
          "s": 46,
          "text": "(שמתאוה בטבעה לעניני עוה\"ז160)"
        },
        {
          "s": 47,
          "text": "המעלמת ומסתרת על נפשו האלקית,"
        },
        {
          "s": 48,
          "text": "לכן,"
        },
        {
          "s": 49,
          "text": "זה שעסקו בעניני הרשות הוא לש\"ש ובאופן דדעהו,"
        },
        {
          "s": 50,
          "text": "הוא דוגמת עבודת התשובה."
        }
      ]
    },
    {
      "v": 25,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "י)"
        },
        {
          "s": 2,
          "text": "והנה בכללות יותר,"
        },
        {
          "s": 3,
          "text": "גם העבודה דתומ\"צ כאשר היא באופן כזה שהאדם צריך לכבוש את יצרו,"
        },
        {
          "s": 4,
          "text": "ובפרט בזמן הגלות שישנם כמה מניעות ועיכובים על עסק התומ\"צ וצריך להתגבר עליהם,"
        },
        {
          "s": 5,
          "text": "הוא בכלל עבודת התשובה."
        },
        {
          "s": 6,
          "text": "ובזה יובן מ\"ש בזהר161"
        },
        {
          "s": 7,
          "text": "שכשראה יעקב העניות והצער שיהי' בזמן גלות אדום,"
        },
        {
          "s": 8,
          "text": "(ובפרט)"
        },
        {
          "s": 9,
          "text": "בסוף זמן הגלות,"
        },
        {
          "s": 10,
          "text": "אמר ושבתי בשלום אל בית אבי ואמר ונתן לי לחם לאכול ובגד ללבוש,"
        },
        {
          "s": 11,
          "text": "ואינו מובן,"
        },
        {
          "s": 12,
          "text": "הרי בפסוק נאמר ונתן לי לחם גו' ואח\"כ ושבתי בשלום גו' ומדוע מקדים בזהר ושבתי בשלום לפני ונתן לי לחם גו'162."
        },
        {
          "s": 13,
          "text": "וי\"ל הביאור בזה,"
        },
        {
          "s": 14,
          "text": "דמכיון שבזהר שם מדבר בענין העניות והצער דזמן הגלות"
        },
        {
          "s": 15,
          "text": "[שהוא פירוש שלישי בענין ויצא גו' וילך חרנה,"
        },
        {
          "s": 16,
          "text": "שיציאה והליכה זו היא"
        },
        {
          "s": 17,
          "text": "[לא מבחי' בינה למלכות וגם לא מבחי' מלכות לבי\"ע"
        },
        {
          "s": 18,
          "text": "(כב' הפירושים שהובאו לעיל סעיף ג),"
        },
        {
          "s": 19,
          "text": "כי אם]"
        },
        {
          "s": 20,
          "text": "לזמן הגלות163."
        },
        {
          "s": 21,
          "text": "דזהו ג\"כ משארז\"ל39"
        },
        {
          "s": 22,
          "text": "שחרן הו\"ע חרון אף של מקום בעולם,"
        },
        {
          "s": 23,
          "text": "דענין זה הוא"
        },
        {
          "s": 24,
          "text": "(בעיקר)"
        },
        {
          "s": 25,
          "text": "בזמן הגלות],"
        },
        {
          "s": 26,
          "text": "לכן מקדים ושבתי בשלום גו' לפני ונתן לי לחם גו' ובגד גו',"
        },
        {
          "s": 27,
          "text": "כי מצד ההעלמות וההסתרים דזמן הגלות,"
        },
        {
          "s": 28,
          "text": "גם העבודה דתומ\"צ"
        },
        {
          "s": 29,
          "text": "(לחם ובגד)"
        },
        {
          "s": 30,
          "text": "היא ע\"י הקדמת ענין התשובה"
        },
        {
          "s": 31,
          "text": "(ושבתי בשלום)"
        },
        {
          "s": 32,
          "text": "שכולל"
        },
        {
          "s": 33,
          "text": "(כנ\"ל)"
        },
        {
          "s": 34,
          "text": "ההתגברות על המניעות ועיכובים."
        },
        {
          "s": 35,
          "text": "ובכתוב נאמר ונתן לי לחם גו' ובגד גו' לפני ושבתי בשלום גו',"
        },
        {
          "s": 36,
          "text": "כי הענין דויצא יעקב מבאר שבע וילך חרנה כמו שהוא בכל דור ודור"
        },
        {
          "s": 37,
          "text": "(גם לפני הגלות)"
        },
        {
          "s": 38,
          "text": "הוא ירידת הנשמה למטה"
        },
        {
          "s": 39,
          "text": "(בכלל,"
        },
        {
          "s": 40,
          "text": "ולא הירידה דגלות),"
        },
        {
          "s": 41,
          "text": "ומכיון שבזמן הבית העבודה דתשובה היא הבירור דעניני הרשות משא\"כ העבודה דתומ\"צ היא"
        },
        {
          "s": 42,
          "text": "(בכללות)"
        },
        {
          "s": 43,
          "text": "עבודת הצדיקים,"
        },
        {
          "s": 44,
          "text": "לכן אומר מיד \"ונתן לי לחם לאכול ובגד ללבוש\","
        },
        {
          "s": 45,
          "text": "ואינו מקדים תחילה \"ושבתי בשלום\"."
        },
        {
          "s": 46,
          "text": "ואדרבה,"
        },
        {
          "s": 47,
          "text": "ונתן לי לחם גו' הוא לפני ושבתי בשלום,"
        },
        {
          "s": 48,
          "text": "שלאחרי העבודה דתומ\"צ השייכת לנפש האלקית,"
        },
        {
          "s": 49,
          "text": "אז דוקא אפשר להיות הבירור דעניני הרשות"
        },
        {
          "s": 50,
          "text": "(\"ושבתי בשלום\")."
        },
        {
          "s": 51,
          "text": "וע\"ד מארז\"ל164"
        },
        {
          "s": 52,
          "text": "קשוט עצמך ואח\"כ קשוט אחרים."
        }
      ]
    },
    {
      "v": 26,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ט)"
        },
        {
          "s": 2,
          "text": "ויש לומר,"
        },
        {
          "s": 3,
          "text": "דהתשובה דהעבודה דכל מעשיך לשם שמים היא נעלית יותר מהתשובה דקיום התומ\"צ בזמן הגלות,"
        },
        {
          "s": 4,
          "text": "וגם מתשובה כפשוטה על עבירות."
        },
        {
          "s": 5,
          "text": "כי ענין התשובה דקיום התומ\"צ שבזמן הגלות הוא"
        },
        {
          "s": 6,
          "text": "(כנ\"ל סעיף חי)"
        },
        {
          "s": 7,
          "text": "מה שמתגבר על המניעות והעיכובים דהגלות ואינו מתחשב עמהם."
        },
        {
          "s": 8,
          "text": "ועד\"ז הוא בתשובה כפשוטה,"
        },
        {
          "s": 9,
          "text": "דענין התשובה הוא שהוא יוצא ממצבו הקודם."
        },
        {
          "s": 10,
          "text": "ובלשון הרמב\"ם"
        },
        {
          "s": 11,
          "text": "(שהובא לעיל סעיף טו)"
        },
        {
          "s": 12,
          "text": "אמש הי' זה מובדל מה' אלקי ישראל כו' והיום הוא מודבק בשכינה."
        },
        {
          "s": 13,
          "text": "משא\"כ התשובה דכל מעשיך לשם שמים,"
        },
        {
          "s": 14,
          "text": "מכיון דזה שהוא עוסק בדברי הרשות"
        },
        {
          "s": 15,
          "text": "(מעשיך)"
        },
        {
          "s": 16,
          "text": "הוא מצד גופו ונפשו הבהמית"
        },
        {
          "s": 17,
          "text": "(כנ\"ל),"
        },
        {
          "s": 18,
          "text": "וזה שהוא עושה אותם לשם שמים,"
        },
        {
          "s": 19,
          "text": "עם היות שזהו מצד הנשמה,"
        },
        {
          "s": 20,
          "text": "הרי אין זה שהנשמה מתגברת על הגוף ונה\"ב"
        },
        {
          "s": 21,
          "text": "(ויוצאת מהם),"
        },
        {
          "s": 22,
          "text": "כי אם,"
        },
        {
          "s": 23,
          "text": "שבעשי' זו גופא שמצד הגוף ונפש הבהמית ישנה הכוונה דלשם שמים שמצד הנשמה."
        },
        {
          "s": 24,
          "text": "וענין זה"
        },
        {
          "s": 25,
          "text": "(הגילוי דנפש האלקית בעניני הגוף ונה\"ב גופא)"
        },
        {
          "s": 26,
          "text": "הוא חידוש גדול יותר מזה שהנשמה מתגברת על ההעלמות וההסתרים ויוצאת מהם."
        },
        {
          "s": 27,
          "text": "ומכיון שהעילוי שבתשובה על עבודת הצדיקים הוא מצד החידוש שבה"
        },
        {
          "s": 28,
          "text": "(כנ\"ל סעיף טו),"
        },
        {
          "s": 29,
          "text": "נמצא שעיקר העילוי דתשובה הוא בהתשובה דכל מעשיך לשם שמים."
        }
      ]
    }
  ]
}