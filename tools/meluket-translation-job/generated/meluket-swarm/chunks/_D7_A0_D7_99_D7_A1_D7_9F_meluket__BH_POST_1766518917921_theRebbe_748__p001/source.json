{
  "globalIndex": 706,
  "owner": 6,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917921_theRebbe_748__p001",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917921_theRebbe_748__p001",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917921_theRebbe_748",
  "title": "מאמר ונחה עליו רוח ה' תשי\"ד",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "אחרון של פסח ה'תשי\"ד*."
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "ונחה עליו רוח הוי' רוח חכמה ובינה רוח עצה וגבורה רוח דעת ויראת הוי' גו' ושפט בצדק דלים גו'1,"
        },
        {
          "s": 1,
          "text": "דע\"י שישרו עליו כל ענינים אלו"
        },
        {
          "s": 2,
          "text": "(רוח הוי',"
        },
        {
          "s": 3,
          "text": "רוח חכמה ובינה רוח עצה וגבורה וגו'),"
        },
        {
          "s": 4,
          "text": "עי\"ז יהי' המשפט שלו משפט צדק2."
        },
        {
          "s": 5,
          "text": "וצריך להבין,"
        },
        {
          "s": 6,
          "text": "דלכאורה,"
        },
        {
          "s": 7,
          "text": "השייכות דמשפט צדק לחכמה ובינה הוא דוקא במשפט ע\"פ שכל,"
        },
        {
          "s": 8,
          "text": "ומכיון שבמשיח כתיב3"
        },
        {
          "s": 9,
          "text": "והריחו ביראת הוי' דמורח ודאין,"
        },
        {
          "s": 10,
          "text": "מה נוגע למשפט זה"
        },
        {
          "s": 11,
          "text": "(שע\"פ ריח)"
        },
        {
          "s": 12,
          "text": "רוח חכמה ובינה."
        },
        {
          "s": 13,
          "text": "והענין הוא,"
        },
        {
          "s": 14,
          "text": "דרוח הוי' הוא ענין כללי,"
        },
        {
          "s": 15,
          "text": "המשכת אלקות,"
        },
        {
          "s": 16,
          "text": "ורוח חכמה ובינה וגו' הם הפרטים הנמשכים מהכלל דרוח הוי'4."
        },
        {
          "s": 17,
          "text": "וזוהי השייכות דרוח חכמה ובינה לושפט בצדק גו',"
        },
        {
          "s": 18,
          "text": "כי החכמה והבינה,"
        },
        {
          "s": 19,
          "text": "כשהם נמשכים מהכלל דרוח הוי',"
        },
        {
          "s": 20,
          "text": "הם באופן נעלה יותר,"
        },
        {
          "s": 21,
          "text": "ושייכים"
        },
        {
          "s": 22,
          "text": "(לא רק למשפט שע\"פ שכל אלא)"
        },
        {
          "s": 23,
          "text": "גם למשפט שע\"פ ריח,"
        },
        {
          "s": 24,
          "text": "מורח ודאין."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים מה שארז\"ל5"
        },
        {
          "s": 2,
          "text": "אור א\"ס למעלה מעלה עד אין קץ ולמטה מטה עד אין תכלית."
        },
        {
          "s": 3,
          "text": "וידוע הדיוק בזה6,"
        },
        {
          "s": 4,
          "text": "הרי הענין דמעלה ומטה"
        },
        {
          "s": 5,
          "text": "(גם מעלה ומטה ברוחניות7)"
        },
        {
          "s": 6,
          "text": "הוא גבול,"
        },
        {
          "s": 7,
          "text": "ואיך שייך לומר בא\"ס"
        },
        {
          "s": 8,
          "text": "(בל\"ג)"
        },
        {
          "s": 9,
          "text": "שהוא למעלה כו' ולמטה כו'."
        },
        {
          "s": 10,
          "text": "ולכאורה הי' אפ\"ל שענין מעלה ומטה הוא בעולמות"
        },
        {
          "s": 11,
          "text": "(ולא בא\"ס)"
        },
        {
          "s": 12,
          "text": "והפירוש דאוא\"ס למעלה כו' ולמטה כו' הוא שהוא נמצא"
        },
        {
          "s": 13,
          "text": "(ומתפשט)"
        },
        {
          "s": 14,
          "text": "בכל הדרגות שבכל העולמות,"
        },
        {
          "s": 15,
          "text": "למעלה מעלה עד אין קץ ולמטה מטה עד אין תכלית."
        },
        {
          "s": 16,
          "text": "אבל עפ\"ז הול\"ל לית אתר פנוי מיני'8"
        },
        {
          "s": 17,
          "text": "(וכיו\"ב),"
        },
        {
          "s": 18,
          "text": "ולא למעלה כו' ולמטה כו'9,"
        },
        {
          "s": 19,
          "text": "שמחלק לשני ענינים וכו'."
        },
        {
          "s": 20,
          "text": "והנה אדמו\"ר מהר\"ש מבאר10,"
        },
        {
          "s": 21,
          "text": "שבכדי להבין ענין זה"
        },
        {
          "s": 22,
          "text": "(דאוא\"ס למעלה עד אין קץ ולמטה עד אין תכלית)"
        },
        {
          "s": 23,
          "text": "יש להקדים תחלה ענין אצילות ובי\"ע11."
        },
        {
          "s": 24,
          "text": "דהחילוק בין אצילות לבי\"ע הוא כדאיתא בתקו\"ז בהמאמר פתח אליהו12"
        },
        {
          "s": 25,
          "text": "וכמה גופין תקינת לון דאתקריאו גופין לגבי לבושין דמכסיין עליהון,"
        },
        {
          "s": 26,
          "text": "שע\"ס דאצילות הם גופין,"
        },
        {
          "s": 27,
          "text": "ובי\"ע"
        },
        {
          "s": 28,
          "text": "(גם הע\"ס דבי\"ע13)"
        },
        {
          "s": 29,
          "text": "הם לבושים להע\"ס דאצילות שמתלבשות ומתכסות בהם."
        },
        {
          "s": 30,
          "text": "ומבאר אדמו\"ר הזקן בד\"ה פתח אליהו14,"
        },
        {
          "s": 31,
          "text": "דהחילוק בין גופין ולבושין"
        },
        {
          "s": 32,
          "text": "(אצילות ובי\"ע)"
        },
        {
          "s": 33,
          "text": "יובן מהחילוק שבין גוף ללבוש כמו שהוא באדם,"
        },
        {
          "s": 34,
          "text": "מבשרי אחזה אלוקה15."
        },
        {
          "s": 35,
          "text": "דגוף האדם,"
        },
        {
          "s": 36,
          "text": "עם היותו רק לבוש לנפש"
        },
        {
          "s": 37,
          "text": "(כמ\"ש16"
        },
        {
          "s": 38,
          "text": "עור ובשר תלבישני),"
        },
        {
          "s": 39,
          "text": "הוא מיוחד עם הנפש,"
        },
        {
          "s": 40,
          "text": "משא\"כ הלבושים הם נפרדים מהאדם"
        },
        {
          "s": 41,
          "text": "(גם מגוף האדם)."
        },
        {
          "s": 42,
          "text": "והנה הענין דגוף ולבושים הוא גם בכחות הרוחניים שנמשכים מהנפש."
        },
        {
          "s": 43,
          "text": "דשכל ומדות הם ה\"גוף\" של נפש האדם,"
        },
        {
          "s": 44,
          "text": "ומחשבה דיבור ומעשה הם הלבושים של הנפש."
        },
        {
          "s": 45,
          "text": "והיינו,"
        },
        {
          "s": 46,
          "text": "דהנפש עצמה היא למעלה גם משכל ומדות,"
        },
        {
          "s": 47,
          "text": "והשכל והמדות הם רק לבושים להנפש,"
        },
        {
          "s": 48,
          "text": "שע\"י התלבשותה בהם היא פועלת פעולות פרטיות"
        },
        {
          "s": 49,
          "text": "(להשכיל,"
        },
        {
          "s": 50,
          "text": "לאהוב וכו'),"
        },
        {
          "s": 51,
          "text": "אלא שהשכל והמדות הם מיוחדים עם הנפש,"
        },
        {
          "s": 52,
          "text": "משא\"כ המחשבה דיבור ומעשה הם לבושים נפרדים."
        },
        {
          "s": 53,
          "text": "והביאור בזה"
        },
        {
          "s": 54,
          "text": "(ששכל ומדות הם מיוחדים עם הנפש,"
        },
        {
          "s": 55,
          "text": "ומחשבה דיבור ומעשה הם נפרדים),"
        },
        {
          "s": 56,
          "text": "דהחילוק בין לבוש המיוחד ללבוש הנפרד הוא,"
        },
        {
          "s": 57,
          "text": "דלבוש הנפרד אפשר לפושטו,"
        },
        {
          "s": 58,
          "text": "משא\"כ לבוש המיוחד"
        },
        {
          "s": 59,
          "text": "(כמו הגוף)"
        },
        {
          "s": 60,
          "text": "א\"א לפושטו."
        },
        {
          "s": 61,
          "text": "וזהו שמחשבה דיבור ומעשה הם לבושים נפרדים והשכל והמדות הם לבושים מיוחדים,"
        },
        {
          "s": 62,
          "text": "כי הדיבור והמעשה אפשר לפושטם,"
        },
        {
          "s": 63,
          "text": "עת לדבר ועת לחשות מלדבר17,"
        },
        {
          "s": 64,
          "text": "וגם המחשבה שהיא בתמידות,"
        },
        {
          "s": 65,
          "text": "הרי אפשר להחליף המחשבה במחשבה אחרת בלי שום יגיעה."
        },
        {
          "s": 66,
          "text": "משא\"כ השכל והמדות,"
        },
        {
          "s": 67,
          "text": "להיותם מיוחדים עם הנפש,"
        },
        {
          "s": 68,
          "text": "בכדי לשנות אותם,"
        },
        {
          "s": 69,
          "text": "צריך ליגיעה18."
        },
        {
          "s": 70,
          "text": "ויתירה מזו,"
        },
        {
          "s": 71,
          "text": "דישנם ענינים בשכל ומדות שא\"א לשנותם"
        },
        {
          "s": 72,
          "text": "(גם ע\"י יגיעה),"
        },
        {
          "s": 73,
          "text": "כי הם כפי טבע נפשו19."
        },
        {
          "s": 74,
          "text": "וזהו מה שע\"ס דאצילות נק' גופין ובי\"ע לבושים,"
        },
        {
          "s": 75,
          "text": "כי ג' עולמות בי\"ע הם דוגמת מחשבה דיבור ומעשה"
        },
        {
          "s": 76,
          "text": "[בריאה מחשבה,"
        },
        {
          "s": 77,
          "text": "יצירה דיבור,"
        },
        {
          "s": 78,
          "text": "ועשי' מעשה]"
        },
        {
          "s": 79,
          "text": "שהם לבושים נפרדים,"
        },
        {
          "s": 80,
          "text": "משא\"כ ע\"ס דאצילות,"
        },
        {
          "s": 81,
          "text": "עם היות שהם באין ערוך לגבי אוא\"ס ב\"ה,"
        },
        {
          "s": 82,
          "text": "הם מיוחדים עם אוא\"ס שמתלבש בהם,"
        },
        {
          "s": 83,
          "text": "איהו וגרמוהי חד20,"
        },
        {
          "s": 84,
          "text": "ולכן נק' בשם גופין,"
        },
        {
          "s": 85,
          "text": "להיותם כמו הגוף שעם היותו באין ערוך לגבי הנפש מ\"מ הוא מיוחד עם הנפש."
        }
      ]
    }
  ]
}