{
  "globalIndex": 105,
  "owner": 5,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914293_theRebbe_757__p002",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914293_theRebbe_757__p002",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914293_theRebbe_757",
  "title": "מאמר בסוכות תשבו תש\"מ",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ועד\"ז הוא בעבודת האדם בכל יום ויום,"
        },
        {
          "s": 2,
          "text": "יצא אדם לפעלו ולעבודתו עדי ערב22,"
        },
        {
          "s": 3,
          "text": "שהעבודה בתחלת היום היא בבחי' אמונה,"
        },
        {
          "s": 4,
          "text": "מודה אני כו' רבה אמונתך,"
        },
        {
          "s": 5,
          "text": "וגם בהתחלת התפלה אומרים הודו לה',"
        },
        {
          "s": 6,
          "text": "הודאה בלבד."
        },
        {
          "s": 7,
          "text": "ואח\"כ היא העבודה דהתבוננות והשגה בפסוד\"ז,"
        },
        {
          "s": 8,
          "text": "ובפרט בברכות ק\"ש וק\"ש."
        },
        {
          "s": 9,
          "text": "ולאחרי זה הוא הביטול דשמו\"ע,"
        },
        {
          "s": 10,
          "text": "שהוא ביטול בתכלית,"
        },
        {
          "s": 11,
          "text": "כמו הביטול דאמונה"
        },
        {
          "s": 12,
          "text": "(אלא שאמונה זו היא האמונה שלאחרי ההשגה)."
        },
        {
          "s": 13,
          "text": "ובכח כ\"ז יצא גו' ולעבודתו עדי ערב,"
        },
        {
          "s": 14,
          "text": "שעושה עבודתו במשך כל היום עדי ערב כפירוש הפשוט דעדי ערב,"
        },
        {
          "s": 15,
          "text": "וגם הפירוש בעדי ערב מלשון ערבות ומתיקות23,"
        },
        {
          "s": 16,
          "text": "דע\"י שעוסק"
        },
        {
          "s": 17,
          "text": "(במשך כל היום)"
        },
        {
          "s": 18,
          "text": "בעניני העוה\"ז הגשמי שאין תחתון למטה ממנו24,"
        },
        {
          "s": 19,
          "text": "שמצד עצמם הם בבחי' ערב וחושך,"
        },
        {
          "s": 20,
          "text": "ומהפכם לקדושה,"
        },
        {
          "s": 21,
          "text": "הנה עי\"ז נעשה אמיתית הערבות ומתיקות,"
        },
        {
          "s": 22,
          "text": "כי כאשר מהפכים דבר מר למתוק היא מתיקות גדולה יותר מכמו שהוא בדבר מתוק מתחלתו25."
        },
        {
          "s": 23,
          "text": "ועי\"ז יצא אדם לפעלו ולעבודתו עדי ערב"
        },
        {
          "s": 24,
          "text": "(גם כפשוטו),"
        },
        {
          "s": 25,
          "text": "שפעולתו ועבודתו במשך כל היום עדי ערב היא בשלימות,"
        },
        {
          "s": 26,
          "text": "כי יש לו סייעתא דשמיא,"
        },
        {
          "s": 27,
          "text": "וסיוע בשלימות,"
        },
        {
          "s": 28,
          "text": "בכל פרטי עבודתו."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וזהו בסוכות תשבו,"
        },
        {
          "s": 2,
          "text": "דבתחלה צ\"ל ענין הסוכה,"
        },
        {
          "s": 3,
          "text": "בחי' מקיף."
        },
        {
          "s": 4,
          "text": "וזה עצמו"
        },
        {
          "s": 5,
          "text": "(עשיית המקיף דסוכה),"
        },
        {
          "s": 6,
          "text": "גם לפני קיום מצות בסוכות תשבו"
        },
        {
          "s": 7,
          "text": "(ובפרט קודם שנמשך בהתיישבות),"
        },
        {
          "s": 8,
          "text": "הוא ענין נעלה ביותר"
        },
        {
          "s": 9,
          "text": "[כדמוכח גם ממ\"ש26"
        },
        {
          "s": 10,
          "text": "חג הסוכות תעשה לך,"
        },
        {
          "s": 11,
          "text": "שיש מצוה גם בעשיית הסוכה27]."
        },
        {
          "s": 12,
          "text": "ובפרט לפי המבואר בדרושי בעל ההילולא28"
        },
        {
          "s": 13,
          "text": "שסכך הסוכה"
        },
        {
          "s": 14,
          "text": "[שהוא עיקר הסוכה,"
        },
        {
          "s": 15,
          "text": "והסוכה נקראת ע\"ש הסכך29]"
        },
        {
          "s": 16,
          "text": "נעשה מענן הקטורת דיום הכפורים,"
        },
        {
          "s": 17,
          "text": "וידוע30"
        },
        {
          "s": 18,
          "text": "גם דסכך בגימטריא מאה כנגד מאה קולות דשופר שנהגו31"
        },
        {
          "s": 19,
          "text": "ישראל"
        },
        {
          "s": 20,
          "text": "(דמנהג ישראל תורה היא32)"
        },
        {
          "s": 21,
          "text": "לתקוע בראש השנה."
        },
        {
          "s": 22,
          "text": "וגם פרטי הקולות מרומזים בהאותיות דסכך,"
        },
        {
          "s": 23,
          "text": "ס' קולות דתקיעה,"
        },
        {
          "s": 24,
          "text": "כ' קולות דשברים וכ' דתרועה30."
        },
        {
          "s": 25,
          "text": "והיינו שההמשכה בראש השנה"
        },
        {
          "s": 26,
          "text": "(מה שממשיכים ע\"י המאה קולות)"
        },
        {
          "s": 27,
          "text": "היא באופן דבכסא"
        },
        {
          "s": 28,
          "text": "(בהעלם),"
        },
        {
          "s": 29,
          "text": "ואח\"כ באה לידי גילוי"
        },
        {
          "s": 30,
          "text": "(ליום חגינו)"
        },
        {
          "s": 31,
          "text": "בחג הסוכות33"
        },
        {
          "s": 32,
          "text": "בסכך הסוכה."
        },
        {
          "s": 33,
          "text": "דכל זה הוא מעלת המקיף דסוכה כמו שהוא מצ\"ע."
        },
        {
          "s": 34,
          "text": "ואח\"כ צ\"ל בסוכות תשבו,"
        },
        {
          "s": 35,
          "text": "להמשיך המקיף דסוכה בהתיישבות ובפנימיות,"
        },
        {
          "s": 36,
          "text": "והמשכה זו צ\"ל שבעת ימים שכוללים כל ימי ההיקף,"
        },
        {
          "s": 37,
          "text": "ועי\"ז נמשך אח\"כ בשמע\"צ"
        },
        {
          "s": 38,
          "text": "(שהמקיף נכנס בפנימיות ועצרת,"
        },
        {
          "s": 39,
          "text": "ונמשך)"
        },
        {
          "s": 40,
          "text": "מקיף עליון יותר,"
        },
        {
          "s": 41,
          "text": "בחי' יום השמיני ששומר את ההיקף34,"
        },
        {
          "s": 42,
          "text": "שעכ\"ז נאמר35"
        },
        {
          "s": 43,
          "text": "ביום השמיני עצרת תהי' לכם,"
        },
        {
          "s": 44,
          "text": "יהיו לך לבדך ואין לזרים אתך36."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "וזהו גם השייכות דנטילת ד' מינים לסוכה,"
        },
        {
          "s": 2,
          "text": "וכנ\"ל שמצות נטילת ד' מינים בסוכה היא מצוה מן המובחר,"
        },
        {
          "s": 3,
          "text": "כי המשכת המקיף דסוכה בבחי' פנימיות והתיישבות נעשה בעיקר ע\"י נטילת ד' מינים."
        },
        {
          "s": 4,
          "text": "ויובן זה ע\"פ המבואר בסידור37"
        },
        {
          "s": 5,
          "text": "ובדרושי בעל ההילולא38"
        },
        {
          "s": 6,
          "text": "שד' מינים אלו רומזים על ענין האחדות."
        },
        {
          "s": 7,
          "text": "דבלולב כתיב כפות תמרים,"
        },
        {
          "s": 8,
          "text": "ודרשו רז\"ל39"
        },
        {
          "s": 9,
          "text": "שצ\"ל כפות,"
        },
        {
          "s": 10,
          "text": "שכל העלים"
        },
        {
          "s": 11,
          "text": "(עם היות שבעצם הם נפרדים זה מזה)"
        },
        {
          "s": 12,
          "text": "צריכים להיות דבוקים ואחוזים זה בזה כאילו הם אחד,"
        },
        {
          "s": 13,
          "text": "וגם כל עלה כפול מב',"
        },
        {
          "s": 14,
          "text": "היינו דב' העלים שבו מתחברים ומתאחדים לעלה אחד."
        },
        {
          "s": 15,
          "text": "וכן הוא בההדסים שנק' ענף עץ עבות,"
        },
        {
          "s": 16,
          "text": "עבות דוקא,"
        },
        {
          "s": 17,
          "text": "תלתא בחד קינא40."
        },
        {
          "s": 18,
          "text": "וכן הוא בערבי נחל שגדלים באחוה41."
        },
        {
          "s": 19,
          "text": "ומכ\"ש באתרוג שדר באילנו משנה לשנה42,"
        },
        {
          "s": 20,
          "text": "דלא רק שסובל את כל שינויי האוירים דד' תקופות השנה"
        },
        {
          "s": 21,
          "text": "(קיץ וחורף קור וחום),"
        },
        {
          "s": 22,
          "text": "אלא שהוא גם גדל מכל ד' אוירים אלו43."
        },
        {
          "s": 23,
          "text": "ויתירה מזו שגידולו בשלימות"
        },
        {
          "s": 24,
          "text": "(של האתרוג)"
        },
        {
          "s": 25,
          "text": "הוא במשך ג' שנים,"
        },
        {
          "s": 26,
          "text": "היינו דענין הנ\"ל"
        },
        {
          "s": 27,
          "text": "(מה שהוא סובל את כל שינויי האוירים וגם גדל מהם)"
        },
        {
          "s": 28,
          "text": "מתחדש בו ג' פעמים43,"
        },
        {
          "s": 29,
          "text": "דבג' פעמים הוי חזקה44."
        },
        {
          "s": 30,
          "text": "ועפ\"ז יובן מה שהמשכת המקיף"
        },
        {
          "s": 31,
          "text": "(דסוכה)"
        },
        {
          "s": 32,
          "text": "בפנימיות נעשה בעיקר ע\"י נטילת ד' מינים,"
        },
        {
          "s": 33,
          "text": "כי ענין האחדות שבד' המינים מורה על בחי' הדעת45"
        },
        {
          "s": 34,
          "text": "(שלכן נמשך על ידם בחי' הדעת,"
        },
        {
          "s": 35,
          "text": "כנ\"ל מכתבי האריז\"ל)."
        },
        {
          "s": 36,
          "text": "וע\"ד כמו שהוא באדם,"
        },
        {
          "s": 37,
          "text": "דמי שיש לו מוחין דגדלות ודעתו רחבה יכול לסבול גם היפוכו46."
        },
        {
          "s": 38,
          "text": "ובפרט שהאחדות שבד' מינים,"
        },
        {
          "s": 39,
          "text": "ובפרט באתרוג,"
        },
        {
          "s": 40,
          "text": "הוא לא רק שהוא סובל הפכים,"
        },
        {
          "s": 41,
          "text": "אלא שההפכים נעשים למציאות אחת,"
        },
        {
          "s": 42,
          "text": "שזה מורה על ריבוי הדעת."
        },
        {
          "s": 43,
          "text": "ולכן המשכת המקיף דסוכה בפנימיות נעשה בעיקר ע\"י נטילת ד' מינים,"
        },
        {
          "s": 44,
          "text": "כי דעת הוא ענין הפנימיות,"
        },
        {
          "s": 45,
          "text": "כמבואר בתניא בסיום וחותם פרק שלישי47"
        },
        {
          "s": 46,
          "text": "בענין המעלה שבדעת על חכמה ובינה שדעת הוא מלשון התקשרות כו'."
        }
      ]
    }
  ]
}