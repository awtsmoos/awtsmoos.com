{
  "globalIndex": 289,
  "owner": 39,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915437_theRebbe_101__p001",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915437_theRebbe_101__p001",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915437_theRebbe_101",
  "title": "מאמר אשר ברא תשל\"ט",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "אור לי\"ד כסלו ה'תשל\"ט*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "אשר ברא ששון ושמחה חתן וכלה גילה רינה דיצה וחדוה אהבה ואחוה שלום וריעות1,"
        },
        {
          "s": 1,
          "text": "ומביא כ\"ק מו\"ח אדמו\"ר במאמרו ד\"ה זה2"
        },
        {
          "s": 2,
          "text": "(שבקונטרס דרושי חתונה תרפ\"ט3)"
        },
        {
          "s": 3,
          "text": "את מאמר הזהר בפרשת תרומה4"
        },
        {
          "s": 4,
          "text": "שמבאר שם כל השבע ברכות בפרטיות,"
        },
        {
          "s": 5,
          "text": "ואומר שם בנוגע לברכה השביעית"
        },
        {
          "s": 6,
          "text": "[שהיא כוללת את כל הברכות],"
        },
        {
          "s": 7,
          "text": "שביעאה איהו מקיים כולא,"
        },
        {
          "s": 8,
          "text": "ומהאי שביעאה מתברכאן כולא ודאי כללא דעשר אמירן,"
        },
        {
          "s": 9,
          "text": "בגין דדא כליל עילא ותתא ועל דא כליל בהאי י' זיני דחדוה כו'."
        },
        {
          "s": 10,
          "text": "ומבאר בהמאמר,"
        },
        {
          "s": 11,
          "text": "שכללא דעשר אמירן כולל עשרת הדברות"
        },
        {
          "s": 12,
          "text": "(עילא)"
        },
        {
          "s": 13,
          "text": "ועשרה מאמרות"
        },
        {
          "s": 14,
          "text": "(תתא),"
        },
        {
          "s": 15,
          "text": "ולהיות שברכה זו היא כללא דעשר אמירן לכן יש בה עשרה לשונות של שמחה"
        },
        {
          "s": 16,
          "text": "(מלבד התיבות חתן וכלה)"
        },
        {
          "s": 17,
          "text": "שהו\"ע השמחה בכל ספירה בפרט"
        },
        {
          "s": 18,
          "text": "[שעי\"ז דוקא הספירות הן בשלימותן,"
        },
        {
          "s": 19,
          "text": "כמובן מהמבואר בכ\"מ5"
        },
        {
          "s": 20,
          "text": "עה\"פ6"
        },
        {
          "s": 21,
          "text": "אם הבנים שמחה]."
        },
        {
          "s": 22,
          "text": "וממשיך בזהר שם"
        },
        {
          "s": 23,
          "text": "(הובא בהמאמר שם)"
        },
        {
          "s": 24,
          "text": "בענין ברכה השביעית,"
        },
        {
          "s": 25,
          "text": "זכאין אינון ישראל דאינון זכו לתתא כגוונא דלעילא."
        },
        {
          "s": 26,
          "text": "והיינו7"
        },
        {
          "s": 27,
          "text": "שברכה זו היא"
        },
        {
          "s": 28,
          "text": "(גם)"
        },
        {
          "s": 29,
          "text": "שבח והודאה להקב\"ה על זה שישראל ע\"י עבודתם מבררים ומזככים את המטה"
        },
        {
          "s": 30,
          "text": "(לתתא)"
        },
        {
          "s": 31,
          "text": "שיהי' כגוונא דלעילא,"
        },
        {
          "s": 32,
          "text": "ועי\"ז ממשיכים גילוי אוא\"ס ב\"ה גם בעולמות העליונים"
        },
        {
          "s": 33,
          "text": "(לעילא)."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "וביאור הענין"
        },
        {
          "s": 2,
          "text": "(וגם השייכות דענין זכו לתתא כגוונא דלעילא לענין חתן וכלה),"
        },
        {
          "s": 3,
          "text": "הוא,"
        },
        {
          "s": 4,
          "text": "דכל הענינים שלמטה משתלשלים מענינם למעלה,"
        },
        {
          "s": 5,
          "text": "ובלשון התניא8"
        },
        {
          "s": 6,
          "text": "שנשתלשלו מהן,"
        },
        {
          "s": 7,
          "text": "וכן הוא בחתן וכלה"
        },
        {
          "s": 8,
          "text": "(שלמטה),"
        },
        {
          "s": 9,
          "text": "שהם משתלשלים מחתן וכלה שלמעלה9,"
        },
        {
          "s": 10,
          "text": "הקב\"ה וכנסת ישראל."
        },
        {
          "s": 11,
          "text": "וכמבואר במדרשי חז\"ל שחתן וכלה האמורים בשה\"ש קאי על הקב\"ה וכנסת ישראל."
        },
        {
          "s": 12,
          "text": "וכמרז\"ל10"
        },
        {
          "s": 13,
          "text": "ביום חתונתו11"
        },
        {
          "s": 14,
          "text": "זה מתן תורה,"
        },
        {
          "s": 15,
          "text": "דמתן תורה הו\"ע הנישואין דהקב\"ה וכנסת ישראל."
        },
        {
          "s": 16,
          "text": "וי\"ל שזהו\"ע וטוב לב משתה תמיד12,"
        },
        {
          "s": 17,
          "text": "כי בכל יום ויום יש הענין דמתן תורה,"
        },
        {
          "s": 18,
          "text": "כמו שאומרים בברכת התורה"
        },
        {
          "s": 19,
          "text": "(שמברכים בכל יום)"
        },
        {
          "s": 20,
          "text": "נותן התורה לשון הוה13,"
        },
        {
          "s": 21,
          "text": "ועד שבכל יום כל הקורא ושונה הקב\"ה קורא ושונה כנגדו14,"
        },
        {
          "s": 22,
          "text": "ומבאר אדמו\"ר הזקן15"
        },
        {
          "s": 23,
          "text": "דזה שהקב\"ה קורא ושונה כנגדו הוא ממש כמו שהי' בשעת מתן תורה בפעם הראשונה."
        },
        {
          "s": 24,
          "text": "שלכן אמרו16"
        },
        {
          "s": 25,
          "text": "(בנוגע להלכה בפועל)"
        },
        {
          "s": 26,
          "text": "מה להלן באימה וביראה וברתת ובזיע אף כאן באימה וביראה וברתת ובזיע."
        },
        {
          "s": 27,
          "text": "ובפרט לפי המבואר17"
        },
        {
          "s": 28,
          "text": "שד' לשונות אלו"
        },
        {
          "s": 29,
          "text": "(אימה יראה רתת וזיע)"
        },
        {
          "s": 30,
          "text": "הם כנגד ד' האותיות דשם הוי',"
        },
        {
          "s": 31,
          "text": "שבמתן תורה הי' הגילוי דשם הוי' לכ\"א מישראל18,"
        },
        {
          "s": 32,
          "text": "וגילוי זה הוא גם בעסק התורה עכשיו."
        }
      ]
    }
  ]
}