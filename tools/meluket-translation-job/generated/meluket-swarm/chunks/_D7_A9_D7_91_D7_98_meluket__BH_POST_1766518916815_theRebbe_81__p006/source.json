{
  "globalIndex": 523,
  "owner": 23,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916815_theRebbe_81__p006",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916815_theRebbe_81__p006",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916815_theRebbe_81",
  "title": "מאמר באתי לגני תש\"ל",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "ומבאר זה אדמו\"ר האמצעי בשערי תשובה73"
        },
        {
          "s": 1,
          "text": "בהקדים החילוק בין הביטול דדיבור למחשבה להביטול דמחשבה לשכל."
        },
        {
          "s": 2,
          "text": "שהביטול דדיבור למחשבה אינו ביטול בתכלית."
        },
        {
          "s": 3,
          "text": "דהגם שבכדי שיהי' הדיבור מסודר הוא ע\"י שהדיבור מקבל ממחשבה,"
        },
        {
          "s": 4,
          "text": "דנוסף לזה שקודם הדיבור צריך לסדר במחשבתו איך לדבר"
        },
        {
          "s": 5,
          "text": "[כידוע74"
        },
        {
          "s": 6,
          "text": "בענין אמרה ד' פעמים בינו לבין עצמו75]"
        },
        {
          "s": 7,
          "text": "הנה גם בעת הדיבור גופא צריך שהמחשבה תאיר בהדיבור שתהי' כפי הוראת המחשבה76,"
        },
        {
          "s": 8,
          "text": "מ\"מ,"
        },
        {
          "s": 9,
          "text": "הדיבור בעצם מהותו הוא נפרד מהמחשבה,"
        },
        {
          "s": 10,
          "text": "והביטול שלו להמחשבה הוא רק בנוגע לזה שהסדר דאותיות הדיבור יהי' כפי הוראת המחשבה."
        },
        {
          "s": 11,
          "text": "והוא כמו ביטול המרכבה להרוכב שהמרכבה היא מציאות בפני עצמה והביטול של הסוסים"
        },
        {
          "s": 12,
          "text": "(מרכבה)"
        },
        {
          "s": 13,
          "text": "להרוכב הוא רק בנוגע לזה שהליכתם תהי' כפי רצון הרוכב."
        },
        {
          "s": 14,
          "text": "משא\"כ הביטול דאותיות המחשבה להשכל הוא"
        },
        {
          "s": 15,
          "text": "(לא רק בנוגע לסדר האותיות אלא גם)"
        },
        {
          "s": 16,
          "text": "בעצם מציאותם,"
        },
        {
          "s": 17,
          "text": "שבכדי שיהיו אותיות המחשבה הוא דוקא ע\"י השכל"
        },
        {
          "s": 18,
          "text": "(או המדות)"
        },
        {
          "s": 19,
          "text": "שמלובש בהם"
        },
        {
          "s": 20,
          "text": "[וזה שהמחשבה משוטטת תמיד הוא לפי שהשכל והמדות נרגשים תמיד בהאדם77]."
        },
        {
          "s": 21,
          "text": "ויתירה מזו,"
        },
        {
          "s": 22,
          "text": "שענינם של אותיות המחשבה הוא שהן מקבלות מהשכל או המדות שמתלבשים בהם."
        },
        {
          "s": 23,
          "text": "והענין הוא,"
        },
        {
          "s": 24,
          "text": "דהחילוק בין מחשבה לדיבור הוא גם באופן שייכותם להשכל והמדות המתלבשות בהם."
        },
        {
          "s": 25,
          "text": "דמחשבה הוא לבוש המיוחד ודיבור הוא לבוש הנפרד."
        },
        {
          "s": 26,
          "text": "דענין הדיבור הוא שהאדם מלביש שכלו ומדותיו במציאות"
        },
        {
          "s": 27,
          "text": "(אותיות)"
        },
        {
          "s": 28,
          "text": "שחוץ ממנו,"
        },
        {
          "s": 29,
          "text": "ולכן,"
        },
        {
          "s": 30,
          "text": "הגם שבכדי שיהי' הדיבור"
        },
        {
          "s": 31,
          "text": "(מצד האדם המדבר)"
        },
        {
          "s": 32,
          "text": "הוא דוקא כשהדיבור מקבל מהשכל ומהמדות שלו,"
        },
        {
          "s": 33,
          "text": "מ\"מ,"
        },
        {
          "s": 34,
          "text": "לאחרי שישנו כבר הדיבור,"
        },
        {
          "s": 35,
          "text": "הוא נשמע גם לזולתו ונפרד מהאדם המדבר."
        },
        {
          "s": 36,
          "text": "וענינם של אותיות המחשבה הוא זה שהשכל והמדות של האדם החושב מתגלים על ידם,"
        },
        {
          "s": 37,
          "text": "ולכן,"
        },
        {
          "s": 38,
          "text": "גם לאחרי שישנם אותיות המחשבה,"
        },
        {
          "s": 39,
          "text": "אינם יוצאים חוץ ממנו78."
        },
        {
          "s": 40,
          "text": "והנה בהביטול דאותיות המחשבה להשכל יש שתי דרגות בכללות."
        },
        {
          "s": 41,
          "text": "כאשר חושב את השכל באותיותיו"
        },
        {
          "s": 42,
          "text": "[ועאכו\"כ כשחושב איך להשפיע השכל לזולתו,"
        },
        {
          "s": 43,
          "text": "וכנ\"ל שקודם הדיבור צריך לסדר במחשבתו איך לדבר],"
        },
        {
          "s": 44,
          "text": "דבמחשבה זו,"
        },
        {
          "s": 45,
          "text": "נרגשים האותיות,"
        },
        {
          "s": 46,
          "text": "אלא שהן מיוחדות עם השכל,"
        },
        {
          "s": 47,
          "text": "כנ\"ל."
        },
        {
          "s": 48,
          "text": "וכאשר חושב את השכל עצמו"
        },
        {
          "s": 49,
          "text": "[מחשבה שבמחשבה79],"
        },
        {
          "s": 50,
          "text": "במחשבה זו אין האותיות נרגשים,"
        },
        {
          "s": 51,
          "text": "כי הם כלולים ובטלים בהשכל80."
        },
        {
          "s": 52,
          "text": "וזהו שאמרו השבטים ליעקב שאין בלבך אלא אחד"
        },
        {
          "s": 53,
          "text": "(בלבך דוקא),"
        },
        {
          "s": 54,
          "text": "כי ענין אלא אחד הוא שאין שום מציאות מבלעדו,"
        },
        {
          "s": 55,
          "text": "גם לא מציאות שבטל אליו."
        },
        {
          "s": 56,
          "text": "ולכן אמרו אין בלבך אלא אחד"
        },
        {
          "s": 57,
          "text": "(אף שהאבות הן הן המרכבה והביטול דמרכבה הוא בכל האברים),"
        },
        {
          "s": 58,
          "text": "כי ענין זה דאלא אחד הוא דוקא בלבו."
        },
        {
          "s": 59,
          "text": "ובלבו גופא – בפנימיות הלב"
        },
        {
          "s": 60,
          "text": "[וכנ\"ל דפירוש ב."
        },
        {
          "s": 61,
          "text": "לבך הוא בתוך הלב],"
        },
        {
          "s": 62,
          "text": "כי בהדרגא דלב,"
        },
        {
          "s": 63,
          "text": "גם בלב אדם העליון,"
        },
        {
          "s": 64,
          "text": "כיון שיש שם ענין המדות,"
        },
        {
          "s": 65,
          "text": "הגם שאיהו וחיוהי81"
        },
        {
          "s": 66,
          "text": "חד ממש,"
        },
        {
          "s": 67,
          "text": "אין זה אמיתית הענין דאלא אחד,"
        },
        {
          "s": 68,
          "text": "ולכן אמרו ב."
        },
        {
          "s": 69,
          "text": "לבך,"
        },
        {
          "s": 70,
          "text": "בתוך לבך,"
        },
        {
          "s": 71,
          "text": "שבנקודת הלב מאיר אחדות הפשוטה,"
        },
        {
          "s": 72,
          "text": "אלא אחד."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש לבאר זה שלאחרי שאומר בהמאמר שהנשמה בהיותה למעלה הוה קיימא בדיוקנאה קמי מלכא קדישא ו"
        },
        {
          "s": 1,
          "text": "(יתירה מזו)"
        },
        {
          "s": 2,
          "text": "שהיתה בתכלית הדביקות וכו' מוסיף שהיתה ברצון אחד להוי' לבדו ואין זר אתו,"
        },
        {
          "s": 3,
          "text": "כי הכוונה ב\"זר\""
        },
        {
          "s": 4,
          "text": "(כאן)"
        },
        {
          "s": 5,
          "text": "היא גם למציאות שבטילה בתכלית"
        },
        {
          "s": 6,
          "text": "(כהביטול דאותיות המחשבה הכלולים בהשכל),"
        },
        {
          "s": 7,
          "text": "וזהו שאומר ואין זר אתו,"
        },
        {
          "s": 8,
          "text": "שהנשמה בהיותה למעלה,"
        },
        {
          "s": 9,
          "text": "האיר בה הגילוי דנקודת הלב,"
        },
        {
          "s": 10,
          "text": "שמצד גילוי זה אין זר אתו,"
        },
        {
          "s": 11,
          "text": "אין בלבך אלא אחד."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "והנה ע\"פ הנ\"ל צריך להבין מה שאמרו השבטים כך אין בלבנו אלא אחד,"
        },
        {
          "s": 2,
          "text": "הרי השבטים הם בבי\"ע"
        },
        {
          "s": 3,
          "text": "[כמבואר בכ\"מ82"
        },
        {
          "s": 4,
          "text": "החילוק בין האבות להשבטים,"
        },
        {
          "s": 5,
          "text": "שהאבות הם באצילות והשבטים הם בבי\"ע],"
        },
        {
          "s": 6,
          "text": "שהביטול שבבי\"ע הוא הביטול דיחודא תתאה"
        },
        {
          "s": 7,
          "text": "(למטה גם מהביטול דמרכבה דאצילות),"
        },
        {
          "s": 8,
          "text": "ואעפ\"כ אמרו אין בלבנו אלא אחד,"
        },
        {
          "s": 9,
          "text": "דענין אלא אחד הוא שאין שום מציאות מבלעדו"
        },
        {
          "s": 10,
          "text": "(למעלה גם ממרכבה דאצילות)."
        },
        {
          "s": 11,
          "text": "ויתירה מזו שאמרו כשם שאין בלבך אלא אחד כך אין בלבנו אלא אחד,"
        },
        {
          "s": 12,
          "text": "שהענין דאלא אחד שבהם והענין דאלא אחד שביעקב,"
        },
        {
          "s": 13,
          "text": "שניהם הם בשוה."
        },
        {
          "s": 14,
          "text": "ומבאר אדמו\"ר האמצעי בשערי תשובה שם83,"
        },
        {
          "s": 15,
          "text": "שהשרש לכל החילוקים שבסדר ההשתלשלות"
        },
        {
          "s": 16,
          "text": "[כולל החילוק שבין יחו\"ת דבי\"ע ליחו\"ע דאצילות,"
        },
        {
          "s": 17,
          "text": "ולמעלה יותר הביטול ד\"אלא אחד\"]"
        },
        {
          "s": 18,
          "text": "הוא בהרצון על עולמות,"
        },
        {
          "s": 19,
          "text": "שעלה ברצונו הפשוט להאציל ולברוא,"
        },
        {
          "s": 20,
          "text": "ושרש הנשמות הוא בעצמות אוא\"ס ממש למעלה מרצון הפשוט"
        },
        {
          "s": 21,
          "text": "[במי84"
        },
        {
          "s": 22,
          "text": "נמלך בנשמותיהן של צדיקים85],"
        },
        {
          "s": 23,
          "text": "וכיון שלגבי עצמות אוא\"ס"
        },
        {
          "s": 24,
          "text": "(שרש הנשמות)"
        },
        {
          "s": 25,
          "text": "כל הענינים הם בשוה,"
        },
        {
          "s": 26,
          "text": "לכן גם הענין דאלא אחד שביעקב נמשך גם בהשבטים,"
        },
        {
          "s": 27,
          "text": "נשמות דבי\"ע."
        }
      ]
    }
  ]
}