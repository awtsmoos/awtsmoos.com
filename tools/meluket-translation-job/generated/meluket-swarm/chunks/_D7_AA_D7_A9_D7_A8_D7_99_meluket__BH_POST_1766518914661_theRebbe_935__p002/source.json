{
  "globalIndex": 159,
  "owner": 9,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914661_theRebbe_935__p002",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914661_theRebbe_935__p002",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914661_theRebbe_935",
  "title": "מאמר כנשר יעיר קנו תשכ\"ב",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ולהבין זה,"
        },
        {
          "s": 2,
          "text": "וגם להבין שייכות הענינים שעי\"ז שיצרנהו כאישון עינו עי\"ז כנשר יעיר קנו,"
        },
        {
          "s": 3,
          "text": "ועי\"ז ישאהו על אברתו הוי' בדד ינחנו,"
        },
        {
          "s": 4,
          "text": "יובן זה בהקדים מאמר בעל ההילולא5"
        },
        {
          "s": 5,
          "text": "ע\"פ6"
        },
        {
          "s": 6,
          "text": "את הוי' האמרת היום גו' והוי' האמירך היום גו'7,"
        },
        {
          "s": 7,
          "text": "ומביא מ\"ש בהמשך הפסוק והוי' האמירך היום גו' לשמור כל מצותיו,"
        },
        {
          "s": 8,
          "text": "שעל זה הקשה באוה\"ח הקדוש הלא דבר זה הוא מתנאי הכבוד שרשם במעשה ישראל לה',"
        },
        {
          "s": 9,
          "text": "כמו שכתוב בפסוק את הוי' האמרת היום גו' ולשמור חוקיו ומצוותיו גו',"
        },
        {
          "s": 10,
          "text": "ומה מקום להזכירו בדברים שמה' לישראל."
        },
        {
          "s": 11,
          "text": "אך הענין יובן בהקדים הפירוש דהאמרת והאמירך מלשון שבח,"
        },
        {
          "s": 12,
          "text": "כדרשת חז\"ל8"
        },
        {
          "s": 13,
          "text": "ע\"פ זה,"
        },
        {
          "s": 14,
          "text": "אמר להם הקב\"ה לישראל אתם עשיתוני חטיבה אחת בעולם ואני אעשה אתכם חטיבה אחת בעולם,"
        },
        {
          "s": 15,
          "text": "אתם עשיתוני חטיבה אחת בעולם שנאמר9"
        },
        {
          "s": 16,
          "text": "שמע ישראל ה' אלקינו ה' אחד,"
        },
        {
          "s": 17,
          "text": "ואני אעשה אתכם חטיבה אחת בעולם שנאמר10"
        },
        {
          "s": 18,
          "text": "ומי כעמך ישראל גוי אחד בארץ."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ויש להוסיף המבואר במק\"א11"
        },
        {
          "s": 1,
          "text": "שהאמרת יש בו ג' פירושים,"
        },
        {
          "s": 2,
          "text": "פירוש הא',"
        },
        {
          "s": 3,
          "text": "לשון שבח,"
        },
        {
          "s": 4,
          "text": "כנ\"ל,"
        },
        {
          "s": 5,
          "text": "פירוש הב',"
        },
        {
          "s": 6,
          "text": "לשון לבוש,"
        },
        {
          "s": 7,
          "text": "פורפירא,"
        },
        {
          "s": 8,
          "text": "כמ\"ש במדרש12"
        },
        {
          "s": 9,
          "text": "ע\"פ13"
        },
        {
          "s": 10,
          "text": "בצע אמרתו,"
        },
        {
          "s": 11,
          "text": "בזע פורפירא"
        },
        {
          "s": 12,
          "text": "(לבוש)"
        },
        {
          "s": 13,
          "text": "דילי',"
        },
        {
          "s": 14,
          "text": "ופירוש הג',"
        },
        {
          "s": 15,
          "text": "מלשון אמירה ודיבור."
        },
        {
          "s": 16,
          "text": "וזוהי שייכות הפסוק את הוי' האמרת היום גו' לראש השנה,"
        },
        {
          "s": 17,
          "text": "כי,"
        },
        {
          "s": 18,
          "text": "מבואר בלקו\"ת14"
        },
        {
          "s": 19,
          "text": "שהיום סתם קאי על ראש השנה,"
        },
        {
          "s": 20,
          "text": "ובראש השנה נעשה הענין דאת הוי' האמרת היום,"
        },
        {
          "s": 21,
          "text": "בכל ג' הפירושים הנ\"ל."
        },
        {
          "s": 22,
          "text": "דהנה,"
        },
        {
          "s": 23,
          "text": "העבודה דר\"ה היא כמארז\"ל15"
        },
        {
          "s": 24,
          "text": "אמר הקב\"ה"
        },
        {
          "s": 25,
          "text": "(לישראל)"
        },
        {
          "s": 26,
          "text": "אמרו לפני בר\"ה מלכיות כו' כדי שתמליכוני עליכם,"
        },
        {
          "s": 27,
          "text": "שזהו תוכן פירוש הא' דהאמרת,"
        },
        {
          "s": 28,
          "text": "לשון שבח,"
        },
        {
          "s": 29,
          "text": "שהו\"ע אתם עשיתוני חטיבה אחת בעולם שנאמר שמע ישראל ה' אלקינו ה' אחד,"
        },
        {
          "s": 30,
          "text": "כמארז\"ל16"
        },
        {
          "s": 31,
          "text": "שמע ישראל הוי' אלקינו הוי' אחד זהו מלכות."
        },
        {
          "s": 32,
          "text": "ופירוש הב',"
        },
        {
          "s": 33,
          "text": "לשון לבוש,"
        },
        {
          "s": 34,
          "text": "כי כאשר נברא אדה\"ר בר\"ה אמר הוי' מלך גאות לבש17,"
        },
        {
          "s": 35,
          "text": "שנתלבש בלבוש מלכות."
        },
        {
          "s": 36,
          "text": "ופירוש הג' מלשון אמירה ודיבור,"
        },
        {
          "s": 37,
          "text": "כידוע18"
        },
        {
          "s": 38,
          "text": "שבר\"ה הוא בנין עולם הדיבור."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "וממשיך בהמאמר5"
        },
        {
          "s": 1,
          "text": "בביאור הפירוש דהאמרת והאמירך מלשון שבח,"
        },
        {
          "s": 2,
          "text": "שבשניהם נאמר אחד"
        },
        {
          "s": 3,
          "text": "(הוי' אחד,"
        },
        {
          "s": 4,
          "text": "גוי אחד),"
        },
        {
          "s": 5,
          "text": "שיש בו ג' פירושים."
        },
        {
          "s": 6,
          "text": "פי' הא',"
        },
        {
          "s": 7,
          "text": "כמארז\"ל19"
        },
        {
          "s": 8,
          "text": "אחד אין כיוצא בו."
        },
        {
          "s": 9,
          "text": "וצריך להבין מהו השבח שאין כיוצא בו,"
        },
        {
          "s": 10,
          "text": "איך יעלה על לב איש קס\"ד שיש כיוצא בו ח\"ו,"
        },
        {
          "s": 11,
          "text": "והרי אפילו אומות העולם קרו לי' אלקא דאלקייא20,"
        },
        {
          "s": 12,
          "text": "וא\"כ למה צריך לומר שאין כיוצא בו."
        },
        {
          "s": 13,
          "text": "ופירוש הב',"
        },
        {
          "s": 14,
          "text": "שאחד שולל הענין דע\"ז,"
        },
        {
          "s": 15,
          "text": "כמארז\"ל21"
        },
        {
          "s": 16,
          "text": "מהיכן זכו ישראל לק\"ש ממ\"ת,"
        },
        {
          "s": 17,
          "text": "אמר הקב\"ה שמע ישראל אנכי ה' אלקיך השיבו ישראל ה' אלקינו,"
        },
        {
          "s": 18,
          "text": "לא יהי' לך כו' השיבו ישראל ה' אחד,"
        },
        {
          "s": 19,
          "text": "ונמצא,"
        },
        {
          "s": 20,
          "text": "שהוי' אלקינו הוי' אחד הוא קיבול על ב' דברות דאנכי ולא יהי' לך,"
        },
        {
          "s": 21,
          "text": "והיינו,"
        },
        {
          "s": 22,
          "text": "שאחד שולל הענין דע\"ז."
        },
        {
          "s": 23,
          "text": "ופי' הג',"
        },
        {
          "s": 24,
          "text": "שהוי' אחד היא מצוה בפ\"ע,"
        },
        {
          "s": 25,
          "text": "מצות לייחדו,"
        },
        {
          "s": 26,
          "text": "שהרי אפשר להיות קיום הציווי אנכי ולא יהי' לך,"
        },
        {
          "s": 27,
          "text": "ומ\"מ,"
        },
        {
          "s": 28,
          "text": "אין זה עדיין ענין היחוד,"
        },
        {
          "s": 29,
          "text": "ועל זה ניתוסף הענין דהוי' אחד,"
        },
        {
          "s": 30,
          "text": "שהוא הציווי ליחדו,"
        },
        {
          "s": 31,
          "text": "והוא שלילת ענין השיתוף,"
        },
        {
          "s": 32,
          "text": "שעל זה נצטוו בנ\"י בפסוק שמע ישראל גו' ה' אחד22,"
        },
        {
          "s": 33,
          "text": "משא\"כ אומות העולם,"
        },
        {
          "s": 34,
          "text": "אף שנצטוו על ע\"ז,"
        },
        {
          "s": 35,
          "text": "כמ\"ש באדה\"ר ויצו23,"
        },
        {
          "s": 36,
          "text": "ואמרו רז\"ל24"
        },
        {
          "s": 37,
          "text": "אין צו אלא ע\"ז,"
        },
        {
          "s": 38,
          "text": "מ\"מ,"
        },
        {
          "s": 39,
          "text": "לא נצטוו על השיתוף"
        },
        {
          "s": 40,
          "text": "(כמ\"ש הרמ\"א25"
        },
        {
          "s": 41,
          "text": "שנמשך אחר הר\"ן והתוס'26)."
        },
        {
          "s": 42,
          "text": "והיינו,"
        },
        {
          "s": 43,
          "text": "שאצל אומות העולם,"
        },
        {
          "s": 44,
          "text": "כולל גם חסידי אומות העולם,"
        },
        {
          "s": 45,
          "text": "אין הענין דהאמנת היחוד,"
        },
        {
          "s": 46,
          "text": "כי אם בישראל דוקא."
        }
      ]
    }
  ]
}