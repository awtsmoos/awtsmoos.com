{
  "globalIndex": 780,
  "owner": 30,
  "jobId": "_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918380_theRebbe_210__p007",
  "batchId": "meluket-_D7_90_D7_99_D7_99_D7_A8_meluket__BH_POST_1766518918380_theRebbe_210__p007",
  "seriesId": "אייר_meluket",
  "postId": "BH_POST_1766518918380_theRebbe_210",
  "title": "מאמר דבר אל..קדושים תהיו תשכ\"א",
  "part": 7,
  "sections": [
    {
      "v": 18,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "והנה כמו שהוא בנוגע להגילוי שמביא לאתכפיא ולאתהפכא,"
        },
        {
          "s": 3,
          "text": "שהמעלה בהגילוי שמביא לאתכפיא היא שהוא גילוי נעלה יותר והמעלה בהגילוי שמביא לאתהפכא היא שנמשך בפנימיות בהאדם"
        },
        {
          "s": 4,
          "text": "[שלכן הוא דבר המתקיים85],"
        },
        {
          "s": 5,
          "text": "עד\"ז הוא בהגילוי שנמשך ע\"י העבודה דאתכפיא ואתהפכא,"
        },
        {
          "s": 6,
          "text": "דמעלת הגילוי שנמשך ע\"י העבודה דאתכפיא היא גילוי נעלה ביותר"
        },
        {
          "s": 7,
          "text": "[וכנ\"ל סעיף ח שהאור שנמשך ע\"י אתכפיא הוא בכולהו עלמין בשוה,"
        },
        {
          "s": 8,
          "text": "אור שלמעלה משייכות לעולמות],"
        },
        {
          "s": 9,
          "text": "ומעלת הגילוי שנמשך ע\"י העבודה דאתהפכא היא שהמשכתו בהאדם ובהעולם הוא בבחינת פנימיות."
        },
        {
          "s": 10,
          "text": "ועפ\"ז יש לבאר מ\"ש רש\"י86"
        },
        {
          "s": 11,
          "text": "דזה שחודש אייר נקרא בשם זיו לפי שבו נולדו זיותני עולם"
        },
        {
          "s": 12,
          "text": "(אף שהאבות נולדו בניסן87)"
        },
        {
          "s": 13,
          "text": "הוא כי כשנתחדש אייר נולדו כבר בניסן,"
        },
        {
          "s": 14,
          "text": "דצריך להבין,"
        },
        {
          "s": 15,
          "text": "הרי זה שבחודש אייר היו זיותני עולם הוא רק תוצאה מזה שנולדו בחודש ניסן,"
        },
        {
          "s": 16,
          "text": "ולמה נקרא אייר בשם זיו88."
        },
        {
          "s": 17,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 18,
          "text": "דענינו של הזיו,"
        },
        {
          "s": 19,
          "text": "הגילוי שנמשך ע\"י עבודה,"
        },
        {
          "s": 20,
          "text": "הוא שיאיר בעולם בפנימיות ובהתיישבות,"
        },
        {
          "s": 21,
          "text": "והגילוי דהאבות"
        },
        {
          "s": 22,
          "text": "(זיותני עולם)"
        },
        {
          "s": 23,
          "text": "בפנימיות ובהתיישבות בהעולם הי' בהחודש לאחרי שנולדו,"
        },
        {
          "s": 24,
          "text": "כשנתחדש אייר נולדו כבר."
        }
      ]
    },
    {
      "v": 19,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "ועד\"ז הוא החילוק בין הגילוי שנמשך ע\"י עבודת הצדיקים להגילוי שנמשך על ידי עבודת התשובה,"
        },
        {
          "s": 3,
          "text": "דבנוגע לדרגת הגילוי – הגילוי שנמשך ע\"י עבודת התשובה הוא נעלה יותר,"
        },
        {
          "s": 4,
          "text": "אבל ההמשכה למטה בעולם"
        },
        {
          "s": 5,
          "text": "(בפנימיות ובהתיישבות)"
        },
        {
          "s": 6,
          "text": "היא ע\"י עבודת הצדיקים."
        },
        {
          "s": 7,
          "text": "והענין הוא,"
        },
        {
          "s": 8,
          "text": "דכיון שענין התשובה הוא שהאדם יוצא מהמציאות שלו,"
        },
        {
          "s": 9,
          "text": "לכן,"
        },
        {
          "s": 10,
          "text": "ע\"י התשובה הוא המשכת עצמות אוא\"ס שלמעלה מגדר מציאות."
        },
        {
          "s": 11,
          "text": "דהאור שנמשך ע\"י עבודת הצדיקים הוא אור שבגדר גילוי."
        },
        {
          "s": 12,
          "text": "וגם כשהעבודה שלהם היא בביטול,"
        },
        {
          "s": 13,
          "text": "דההמשכה שע\"י עבודה זו היא המשכה נעלית יותר,"
        },
        {
          "s": 14,
          "text": "מ\"מ,"
        },
        {
          "s": 15,
          "text": "היא בגדר גילוי."
        },
        {
          "s": 16,
          "text": "וזהו ויספו ענוים בהוי',"
        },
        {
          "s": 17,
          "text": "דע\"י הענוה והביטול של הצדיקים נמשך תוספת אור בהוי' לפי שההמשכה היא מאוא\"ס שלמעלה מהוי',"
        },
        {
          "s": 18,
          "text": "אבל מ\"מ גם המשכה זו היא בגדר גילוי"
        },
        {
          "s": 19,
          "text": "[וכנ\"ל סעיף ג דיש לומר שענין ויספו ענוים בהוי' הוא המשכת בחינת גדולתי שלמעלה מגדולתכם,"
        },
        {
          "s": 20,
          "text": "דענין הגדולה"
        },
        {
          "s": 21,
          "text": "(גם בחינת גדולתי)"
        },
        {
          "s": 22,
          "text": "שייך להתפשטות וגילוי],"
        },
        {
          "s": 23,
          "text": "וענינה של ההמשכה הוא שעל ידה יתוסף בהגילוי דהוי'"
        },
        {
          "s": 24,
          "text": "(ויספו גו' בהוי')."
        },
        {
          "s": 25,
          "text": "והמשכת בחינת קדוש ישראל,"
        },
        {
          "s": 26,
          "text": "העצם שמובדל מגילוי,"
        },
        {
          "s": 27,
          "text": "הוא ע\"י עבודת התשובה."
        },
        {
          "s": 28,
          "text": "ויש לבאר זה ע\"פ הידוע89"
        },
        {
          "s": 29,
          "text": "דענין הענוה הוא"
        },
        {
          "s": 30,
          "text": "(לא שאינו יודע את המעלות שלו אלא)"
        },
        {
          "s": 31,
          "text": "שהגם שיודע את המעלות שלו מ\"מ אינו מחזיק טובה לעצמו מפני שיודע שהמעלות שיש לו ניתנו לו מלמעלה."
        },
        {
          "s": 32,
          "text": "וכיון שהביטול דענוה אינה שוללת את מציאותו"
        },
        {
          "s": 33,
          "text": "(שהרי הוא יודע את המעלות שלו)"
        },
        {
          "s": 34,
          "text": "אלא שמציאותו היא לא מצד עצמו ורק מצד האלקות,"
        },
        {
          "s": 35,
          "text": "לכן גם ההמשכה שע\"י הביטול דענוה היא גילוי בעולם"
        },
        {
          "s": 36,
          "text": "(מציאות),"
        },
        {
          "s": 37,
          "text": "אלא שהגילוי בעולם הוא כמו שהוא מצד שרשו,"
        },
        {
          "s": 38,
          "text": "בחינת גדולתי."
        },
        {
          "s": 39,
          "text": "ובכדי להמשיך בחינת קדוש ישראל שמובדל מגילוי,"
        },
        {
          "s": 40,
          "text": "הוא ע\"י הביטול דאביוני אדם,"
        },
        {
          "s": 41,
          "text": "דע\"י ההרגש שהוא אביון,"
        },
        {
          "s": 42,
          "text": "שאין בו שום מעלה90,"
        },
        {
          "s": 43,
          "text": "הוא בטל ממציאותו,"
        },
        {
          "s": 44,
          "text": "ועי\"ז נמשך בחינת קדוש ישראל."
        }
      ]
    },
    {
      "v": 20,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ב)"
        },
        {
          "s": 2,
          "text": "והנה כל זה הוא בנוגע לההמשכה עצמה."
        },
        {
          "s": 3,
          "text": "אבל בכדי שיהי' הגילוי בעולם,"
        },
        {
          "s": 4,
          "text": "דירה בתחתונים,"
        },
        {
          "s": 5,
          "text": "הוא ע\"י עבודת הצדיקים91."
        },
        {
          "s": 6,
          "text": "כי ענין דירה בתחתונים הוא שיהי' גילוי אלקות כמו שהוא במציאותו,"
        },
        {
          "s": 7,
          "text": "וכיון שענין התשובה הוא שיוצא ממציאותו"
        },
        {
          "s": 8,
          "text": "[נוסף לביטול המציאות שלו,"
        },
        {
          "s": 9,
          "text": "כנ\"ל],"
        },
        {
          "s": 10,
          "text": "לכן הענין דדירה בתחתונים הוא ע\"י עבודת הצדיקים."
        },
        {
          "s": 11,
          "text": "וזהו מי יתנך כאח לי כיוסף לבנימין,"
        },
        {
          "s": 12,
          "text": "דהגם שהבקשה היא שהקב\"ה יהי' לנו כאח אף שהנהגתינו היתה שלא כראוי,"
        },
        {
          "s": 13,
          "text": "מ\"מ מבקשים שיהי' כיוסף לבנימין,"
        },
        {
          "s": 14,
          "text": "דיש לומר,"
        },
        {
          "s": 15,
          "text": "שבזה מרמז,"
        },
        {
          "s": 16,
          "text": "שגם עבודת התשובה תהי' באופן שהגילוי שע\"י התשובה"
        },
        {
          "s": 17,
          "text": "(שלמעלה מגדר מציאות)"
        },
        {
          "s": 18,
          "text": "יומשך בעולם בהתיישבות,"
        },
        {
          "s": 19,
          "text": "מעלת הצדיקים,"
        },
        {
          "s": 20,
          "text": "כיוסף לבנימין."
        },
        {
          "s": 21,
          "text": "וזהו גם הקשר דשני הפירושים במי יתנך כאח לי שקאי על צדיקים ושקאי על בעלי תשובה"
        },
        {
          "s": 22,
          "text": "(כנ\"ל סעיף ד),"
        },
        {
          "s": 23,
          "text": "שיהי' החיבור וההתכללות דשני הענינים."
        }
      ]
    }
  ]
}