{
  "globalIndex": 572,
  "owner": 22,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917024_theRebbe_166__p003",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917024_theRebbe_166__p003",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518917024_theRebbe_166",
  "title": "מאמר בחודש השלישי תשל\"ד",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ועפ\"ז יש לבאר ההוספה והחידוש של הדיבור דהקב\"ה"
        },
        {
          "s": 2,
          "text": "(אמרתך)"
        },
        {
          "s": 3,
          "text": "בעת לימוד האדם על הדיבור שהי' במתן תורה,"
        },
        {
          "s": 4,
          "text": "כי זה שהדיבור דמ\"ת ישנו בכל זמן הוא מצד הלימוד של האדם,"
        },
        {
          "s": 5,
          "text": "וכמשנת\"ל"
        },
        {
          "s": 6,
          "text": "(סעיף ה)"
        },
        {
          "s": 7,
          "text": "דזה שהגילוי דמ\"ת פעל בהזמן שבו ניתנה תורה שיהי' כלול בו כל המשך הזמן הוא בכדי שהגילוי דמ\"ת יהי' ההתחלה והנתינת כח על עליית התחתונים,"
        },
        {
          "s": 8,
          "text": "עבודת האדם."
        },
        {
          "s": 9,
          "text": "ולכן הדיבור דהקב\"ה שבא ע\"י לימוד האדם הוא נעלה יותר."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ויש להוסיף,"
        },
        {
          "s": 1,
          "text": "דכמו שביום הזה כפשוטו שקאי על ראש חודש,"
        },
        {
          "s": 2,
          "text": "הוא רק מולד הלבנה,"
        },
        {
          "s": 3,
          "text": "נקודה בלבד,"
        },
        {
          "s": 4,
          "text": "ואח\"כ היא הולכת ומתגדלת עד ליום הט\"ו שבו קיימא סיהרא באשלימותא35,"
        },
        {
          "s": 5,
          "text": "עד\"ז הוא בישראל,"
        },
        {
          "s": 6,
          "text": "שבעת מתן תורה שהי' במדבר סיני,"
        },
        {
          "s": 7,
          "text": "הי' ההתחלה,"
        },
        {
          "s": 8,
          "text": "וע\"י העבודה דישראל לאח\"ז ולאחרי מתן תורה הם הולכים ומתגדלים,"
        },
        {
          "s": 9,
          "text": "ועד שבימי דוד36"
        },
        {
          "s": 10,
          "text": "ובימי שלמה הי' קיימא סיהרא באשלימותא35."
        },
        {
          "s": 11,
          "text": "ועיקר המילוי והשלימות יהי' בדרא דמלכא משיחא,"
        },
        {
          "s": 12,
          "text": "שאז יהי' וירד מים עד ים ומנהר עד אפסי ארץ37,"
        },
        {
          "s": 13,
          "text": "בכל מקום בשוה,"
        },
        {
          "s": 14,
          "text": "ועד לוימלא כבודו את כל הארץ38,"
        },
        {
          "s": 15,
          "text": "מילוי בתכלית השלימות בכל הארץ בשוה."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "והנה מבואר בהדרושים39,"
        },
        {
          "s": 2,
          "text": "שהתורה נקראת עוז40"
        },
        {
          "s": 3,
          "text": "ותושי'41,"
        },
        {
          "s": 4,
          "text": "עוז לנפש האלקית ותושי' לנפש הבהמית."
        },
        {
          "s": 5,
          "text": "וזה שיש בתורה שני ענינים אלה"
        },
        {
          "s": 6,
          "text": "(אף שנתלבשה בענינים גשמיים)"
        },
        {
          "s": 7,
          "text": "הוא,"
        },
        {
          "s": 8,
          "text": "כי מקור התורה ויסודה הוא באוא\"ס ב\"ה בעצמו ובכבודו"
        },
        {
          "s": 9,
          "text": "[וגילוי בחינה זו דתורה הוא כשלימוד התורה של האדם הוא בביטול,"
        },
        {
          "s": 10,
          "text": "כעונה אחר הקורא]."
        },
        {
          "s": 11,
          "text": "ויש לומר,"
        },
        {
          "s": 12,
          "text": "דשני הענינים דעוז ותושי' הם גם דוגמת שני הענינים דלעיל"
        },
        {
          "s": 13,
          "text": "(סעיף ד)"
        },
        {
          "s": 14,
          "text": "בהחיבור דמעלה ומטה."
        },
        {
          "s": 15,
          "text": "דזה שהתורה נותנת כח ועוז לנה\"א הוא ע\"ד ירידת והמשכת התורה למטה,"
        },
        {
          "s": 16,
          "text": "וזה שהתורה מתשת כח הנה\"ב הוא ע\"ד הנתינת כח דמ\"ת על עליית התחתונים."
        },
        {
          "s": 17,
          "text": "וזה שמקור התורה הוא מאוא\"ס ב\"ה,"
        },
        {
          "s": 18,
          "text": "שלכן יש בה שני הענינים דעוז ותושי',"
        },
        {
          "s": 19,
          "text": "הוא ע\"ד המבואר במק\"א42,"
        },
        {
          "s": 20,
          "text": "דזה שהתורה"
        },
        {
          "s": 21,
          "text": "(שהיא למעלה מהעולם)"
        },
        {
          "s": 22,
          "text": "ירדה למטה ופועלת בהמטה,"
        },
        {
          "s": 23,
          "text": "הוא ע\"י שנמשך בה מהעצמות,"
        },
        {
          "s": 24,
          "text": "שהוא נושא הפכים."
        }
      ]
    }
  ]
}