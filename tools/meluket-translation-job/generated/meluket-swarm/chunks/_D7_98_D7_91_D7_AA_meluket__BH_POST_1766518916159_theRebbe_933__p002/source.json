{
  "globalIndex": 420,
  "owner": 20,
  "jobId": "_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916159_theRebbe_933__p002",
  "batchId": "meluket-_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916159_theRebbe_933__p002",
  "seriesId": "טבת_meluket",
  "postId": "BH_POST_1766518916159_theRebbe_933",
  "title": "מאמר ודוד עבדי תשל\"ב",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ועד\"ז הוא בנוגע ליוסף ויהודה,"
        },
        {
          "s": 1,
          "text": "שיוסף הוא"
        },
        {
          "s": 2,
          "text": "(יסוד)"
        },
        {
          "s": 3,
          "text": "ז\"א ויהודה הוא מלכות,"
        },
        {
          "s": 4,
          "text": "דזה שעכשיו יוסף הוא למעלה מיהודה,"
        },
        {
          "s": 5,
          "text": "הוא,"
        },
        {
          "s": 6,
          "text": "כי בסדר ההשתלשלות,"
        },
        {
          "s": 7,
          "text": "ז\"א הוא למעלה ממלכות."
        },
        {
          "s": 8,
          "text": "[וזהו ויגש אליו יהודה ויאמר בי אדוני,"
        },
        {
          "s": 9,
          "text": "דפירוש בי אדוני הוא שביהודה"
        },
        {
          "s": 10,
          "text": "(בי)"
        },
        {
          "s": 11,
          "text": "יומשך השפע מיוסף הצדיק"
        },
        {
          "s": 12,
          "text": "(אדוני),"
        },
        {
          "s": 13,
          "text": "כי המלכות מקבלת שפע מז\"א]."
        },
        {
          "s": 14,
          "text": "ולעתיד לבוא,"
        },
        {
          "s": 15,
          "text": "שאז יתגלה שורש המלכות,"
        },
        {
          "s": 16,
          "text": "שהוא למעלה משורש ז\"א,"
        },
        {
          "s": 17,
          "text": "יהי' ועבדי דוד מלך עליהם."
        },
        {
          "s": 18,
          "text": "וצריך ביאור,"
        },
        {
          "s": 19,
          "text": "דכיון שענין ויגש אליו יהודה הוא שיוסף"
        },
        {
          "s": 20,
          "text": "(ז\"א,"
        },
        {
          "s": 21,
          "text": "צומח)"
        },
        {
          "s": 22,
          "text": "הוא למעלה מיהודה"
        },
        {
          "s": 23,
          "text": "(מלכות,"
        },
        {
          "s": 24,
          "text": "דומם),"
        },
        {
          "s": 25,
          "text": "הרי במאמר שהתחלתו הוא ויגש אליו יהודה,"
        },
        {
          "s": 26,
          "text": "אין ענינו"
        },
        {
          "s": 27,
          "text": "(לכאורה)"
        },
        {
          "s": 28,
          "text": "לבאר הטעם על זה שביהמ\"ק הי' מדומם."
        },
        {
          "s": 29,
          "text": "ומזה שבהמאמר ד\"ה ויגש אליו יהודה מבאר דזה שביהמ\"ק הי' מדומם הוא לפי שביהמ\"ק הי' מעין עולם הבא11"
        },
        {
          "s": 30,
          "text": "שאז תהי' המלכות"
        },
        {
          "s": 31,
          "text": "(דומם)"
        },
        {
          "s": 32,
          "text": "למעלה מכל הספירות,"
        },
        {
          "s": 33,
          "text": "מוכח,"
        },
        {
          "s": 34,
          "text": "דהגם שבגילוי ענין ויגש אליו יהודה הוא שז\"א הוא למעלה ממלכות,"
        },
        {
          "s": 35,
          "text": "יש בו"
        },
        {
          "s": 36,
          "text": "(בויגש אליו יהודה),"
        },
        {
          "s": 37,
          "text": "בפנימיות ובהעלם,"
        },
        {
          "s": 38,
          "text": "המעלה דמלכות לגבי ז\"א,"
        },
        {
          "s": 39,
          "text": "ע\"ד הגילוי דלע\"ל12."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים דכשרצה יהודה לעורר את יוסף שימשיך לו השפע,"
        },
        {
          "s": 2,
          "text": "אמר לו4,"
        },
        {
          "s": 3,
          "text": "כי כמוך כפרעה."
        },
        {
          "s": 4,
          "text": "והביאור בזה13,"
        },
        {
          "s": 5,
          "text": "דלהיות שההמשכה מז\"א"
        },
        {
          "s": 6,
          "text": "(יוסף)"
        },
        {
          "s": 7,
          "text": "למלכות"
        },
        {
          "s": 8,
          "text": "(יהודה)"
        },
        {
          "s": 9,
          "text": "היא ירידה,"
        },
        {
          "s": 10,
          "text": "לכן ביאר יהודה ליוסף,"
        },
        {
          "s": 11,
          "text": "שאדרבה,"
        },
        {
          "s": 12,
          "text": "עי\"ז תהי' עלי' בז\"א,"
        },
        {
          "s": 13,
          "text": "שיהי' כמוך כפרעה."
        },
        {
          "s": 14,
          "text": "והענין הוא14,"
        },
        {
          "s": 15,
          "text": "דפרעה הוא בחינת הכתר שלמעלה מהשתלשלות."
        },
        {
          "s": 16,
          "text": "וזהו מ\"ש15"
        },
        {
          "s": 17,
          "text": "ונתתם חמישית לפרעה וארבע הידות יהי' לכם,"
        },
        {
          "s": 18,
          "text": "דארבע הידות הם חו\"ב וזו\"ן,"
        },
        {
          "s": 19,
          "text": "והחמישית הוא הכתר שלמעלה מהשתלשלות16."
        },
        {
          "s": 20,
          "text": "ויש לומר,"
        },
        {
          "s": 21,
          "text": "דזה שארבע הידות יהי' לכם בא בהמשך לחמישית לפרעה,"
        },
        {
          "s": 22,
          "text": "הוא,"
        },
        {
          "s": 23,
          "text": "דע\"י החמישית לפרעה,"
        },
        {
          "s": 24,
          "text": "המשכת הכתר שלמעלה מהשתלשלות,"
        },
        {
          "s": 25,
          "text": "גם ארבע הידות"
        },
        {
          "s": 26,
          "text": "[שיהי' לכם,"
        },
        {
          "s": 27,
          "text": "בהשתלשלות]"
        },
        {
          "s": 28,
          "text": "הם באופן נעלה יותר17."
        },
        {
          "s": 29,
          "text": "וכדאיתא בזהר18"
        },
        {
          "s": 30,
          "text": "דפרעה הוא דאתפריעו ואתגליין מיני' כל נהורין,"
        },
        {
          "s": 31,
          "text": "דיש לומר,"
        },
        {
          "s": 32,
          "text": "שפירוש אתפריעו כל נהורין הוא,"
        },
        {
          "s": 33,
          "text": "שע\"י המשכת הכתר"
        },
        {
          "s": 34,
          "text": "(פרעה),"
        },
        {
          "s": 35,
          "text": "גם הגילויים"
        },
        {
          "s": 36,
          "text": "(נהורין)"
        },
        {
          "s": 37,
          "text": "דהשתלשלות הם באופן דאתפריעו,"
        },
        {
          "s": 38,
          "text": "למעלה מהגבלה."
        },
        {
          "s": 39,
          "text": "והגם שהענינים שבהשתלשלות"
        },
        {
          "s": 40,
          "text": "(ארבע הידות)"
        },
        {
          "s": 41,
          "text": "הם נמשכים תמיד מהכתר שלמעלה מהשתלשלות,"
        },
        {
          "s": 42,
          "text": "מ\"מ,"
        },
        {
          "s": 43,
          "text": "המשכתם מהכתר"
        },
        {
          "s": 44,
          "text": "(ע\"ד הרגיל)"
        },
        {
          "s": 45,
          "text": "היא באופן שהכתר הוא מובדל מהם ולכן הם בהגבלה,"
        },
        {
          "s": 46,
          "text": "וענין חמישית לפרעה וארבע הידות יהי' לכם הוא,"
        },
        {
          "s": 47,
          "text": "שגם כמו שהם נמשכים בגילוי"
        },
        {
          "s": 48,
          "text": "(בהשתלשלות),"
        },
        {
          "s": 49,
          "text": "נרגש בהם שהמשכתם היא מהכתר שלמעלה מהשתלשלות,"
        },
        {
          "s": 50,
          "text": "ואז הם באופן דאתפריעו."
        },
        {
          "s": 51,
          "text": "וההמשכה באופן זה היא ע\"י ספירת היסוד19."
        },
        {
          "s": 52,
          "text": "כי ענינו של יסוד הוא שהוא משפיע למלכות,"
        },
        {
          "s": 53,
          "text": "ובכדי שתהי' ההשפעה למטה הוא ע\"י ההמשכה מהכתר."
        },
        {
          "s": 54,
          "text": "וזהו שאמר20"
        },
        {
          "s": 55,
          "text": "פרעה"
        },
        {
          "s": 56,
          "text": "(כתר)"
        },
        {
          "s": 57,
          "text": "ליוסף"
        },
        {
          "s": 58,
          "text": "(יסוד)"
        },
        {
          "s": 59,
          "text": "אתה תהי' על ביתי ועל פיך ישק כל עמי גו',"
        },
        {
          "s": 60,
          "text": "ובלעדיך לא ירים איש את ידו ואת רגלו,"
        },
        {
          "s": 61,
          "text": "דההמשכה מהכתר"
        },
        {
          "s": 62,
          "text": "(היינו התוספות אור שנמשך מהכתר)"
        },
        {
          "s": 63,
          "text": "בכל הדרגות דההשתלשלות"
        },
        {
          "s": 64,
          "text": "(כל עמי)"
        },
        {
          "s": 65,
          "text": "היא ע\"י ספירת היסוד,"
        },
        {
          "s": 66,
          "text": "על פיך"
        },
        {
          "s": 67,
          "text": "(דיוסף)."
        },
        {
          "s": 68,
          "text": "ואעפ\"כ"
        },
        {
          "s": 69,
          "text": "(רק)"
        },
        {
          "s": 70,
          "text": "הכסא אגדל ממך,"
        },
        {
          "s": 71,
          "text": "דזה שהיסוד ממשיך מהכתר הוא מבחינת הכתר כמו ששייכת להשתלשלות"
        },
        {
          "s": 72,
          "text": "[שלכן,"
        },
        {
          "s": 73,
          "text": "הגילוי דהמשכה זו הוא שהענינים דהשתלשלות הם באופן דאתפריעו],"
        },
        {
          "s": 74,
          "text": "אבל הכסא,"
        },
        {
          "s": 75,
          "text": "הרוממות וההתנשאות,"
        },
        {
          "s": 76,
          "text": "היינו הכתר עצמו שמרומם ומובדל מההשתלשלות,"
        },
        {
          "s": 77,
          "text": "אינו נמשך ע\"י היסוד."
        },
        {
          "s": 78,
          "text": "וזוהי המעלה דמלכות לגבי יסוד,"
        },
        {
          "s": 79,
          "text": "דשורש המלכות הוא בהכתר עצמו21."
        },
        {
          "s": 80,
          "text": "אלא שבמלכות,"
        },
        {
          "s": 81,
          "text": "השורש שלה הוא בהעלם,"
        },
        {
          "s": 82,
          "text": "והגילוי שלו הוא ע\"י ז\"א."
        },
        {
          "s": 83,
          "text": "וע\"י שז\"א מגלה בהמלכות השורש שלה"
        },
        {
          "s": 84,
          "text": "(עצם הכתר),"
        },
        {
          "s": 85,
          "text": "גם ז\"א מתעלה לדרגא זו22."
        },
        {
          "s": 86,
          "text": "וזהו שאמר יהודה ליוסף בי אדוני גו' כי כמוך כפרעה,"
        },
        {
          "s": 87,
          "text": "דע\"י שיומשך במלכות"
        },
        {
          "s": 88,
          "text": "(בי,"
        },
        {
          "s": 89,
          "text": "ביהודה)"
        },
        {
          "s": 90,
          "text": "השפע מיסוד"
        },
        {
          "s": 91,
          "text": "(אדוני,"
        },
        {
          "s": 92,
          "text": "יוסף),"
        },
        {
          "s": 93,
          "text": "שעי\"ז יתגלה במלכות השורש שלה,"
        },
        {
          "s": 94,
          "text": "עצם הכתר,"
        },
        {
          "s": 95,
          "text": "עי\"ז יהי'"
        },
        {
          "s": 96,
          "text": "(כמוך)"
        },
        {
          "s": 97,
          "text": "כפרעה,"
        },
        {
          "s": 98,
          "text": "שיומשך בו עצם הכתר."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וצריך ביאור,"
        },
        {
          "s": 2,
          "text": "הרי גם זה שהיסוד ממשיך מהכתר הוא לפי שענינו של היסוד הוא שהוא משפיע למלכות"
        },
        {
          "s": 3,
          "text": "(כנ\"ל סעיף ג),"
        },
        {
          "s": 4,
          "text": "ואעפ\"כ זה שהיסוד ממשיך מהכתר הוא רק מבחינת הכתר כמו ששייכת להשתלשלות,"
        },
        {
          "s": 5,
          "text": "ומה מיתוסף ע\"י הענין דבי אדוני"
        },
        {
          "s": 6,
          "text": "[שבמלכות נמשך השפע מהיסוד]"
        },
        {
          "s": 7,
          "text": "שעי\"ז דוקא הוא המשכת עצם הכתר."
        },
        {
          "s": 8,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 9,
          "text": "דענין בי אדוני הוא"
        },
        {
          "s": 10,
          "text": "(לא שהיסוד משפיע למלכות,"
        },
        {
          "s": 11,
          "text": "אלא),"
        },
        {
          "s": 12,
          "text": "שבהמלכות נמשך השפע מהיסוד,"
        },
        {
          "s": 13,
          "text": "בי אדוני."
        },
        {
          "s": 14,
          "text": "והגילוי דכתר שנמשך ע\"י שהמלכות מקבלת השפע מהיסוד הוא גילוי נעלה יותר מהגילוי דכתר שנמשך ע\"י שהיסוד משפיע במלכות23."
        },
        {
          "s": 15,
          "text": "והענין הוא,"
        },
        {
          "s": 16,
          "text": "דהמשל על ספירת המלכות בכחות הנפש הוא כח הדיבור"
        },
        {
          "s": 17,
          "text": "(מלכות פה24)."
        },
        {
          "s": 18,
          "text": "ומהטעמים על זה הוא,"
        },
        {
          "s": 19,
          "text": "כי החילוק בין כח הדיבור לכל הכחות הוא,"
        },
        {
          "s": 20,
          "text": "דכל הכחות שבאדם הם לצורך עצמו,"
        },
        {
          "s": 21,
          "text": "וכח הדיבור הוא"
        },
        {
          "s": 22,
          "text": "(לא לצורך עצמו אלא)"
        },
        {
          "s": 23,
          "text": "בשביל הזולת."
        },
        {
          "s": 24,
          "text": "ויתירה מזה,"
        },
        {
          "s": 25,
          "text": "דזה שהדיבור נשמע לזולתו הוא ע\"י שהוא יוצא לחוץ ונעשה נפרד מהאדם המדבר,"
        },
        {
          "s": 26,
          "text": "דמזה מובן גם בנוגע לכח הדיבור"
        },
        {
          "s": 27,
          "text": "(לפני שמדבר בפועל),"
        },
        {
          "s": 28,
          "text": "דהגם שכח הדיבור הוא בהאדם עצמו,"
        },
        {
          "s": 29,
          "text": "ענינו הוא זה שבכחו לצאת ממציאותו ולדבר לזולתו."
        },
        {
          "s": 30,
          "text": "ועד\"ז הוא במלכות,"
        },
        {
          "s": 31,
          "text": "שגם בהיותה באצילות"
        },
        {
          "s": 32,
          "text": "(לפני שיורדת להחיות ולהוות את הנבראים)"
        },
        {
          "s": 33,
          "text": "היא שורש ומקור הנבראים."
        },
        {
          "s": 34,
          "text": "ויש לומר,"
        },
        {
          "s": 35,
          "text": "דמהביאורים על זה שהשורש דכח הדיבור הוא בעצם הנפש"
        },
        {
          "s": 36,
          "text": "(למעלה מהשורש דכל הכחות),"
        },
        {
          "s": 37,
          "text": "הוא,"
        },
        {
          "s": 38,
          "text": "כי הכחות שמצד הגילויים דהנפש,"
        },
        {
          "s": 39,
          "text": "ענינם הוא שהם גילוי הנפש"
        },
        {
          "s": 40,
          "text": "(דגילוי הוא בקירוב להענין שהוא מגלה25),"
        },
        {
          "s": 41,
          "text": "וכיון שענינו של כח הדיבור הוא זה שבכחו לצאת ממציאותו"
        },
        {
          "s": 42,
          "text": "(היפך ענין הקירוב,"
        },
        {
          "s": 43,
          "text": "גילוי)"
        },
        {
          "s": 44,
          "text": "הוא מפני ששרשו הוא בעצם הנפש,"
        },
        {
          "s": 45,
          "text": "שאינה מוגבלת בענין הגילוי,"
        },
        {
          "s": 46,
          "text": "וביכלתה להיות גם בהעלם,"
        },
        {
          "s": 47,
          "text": "ועד להעלם בתכלית,"
        },
        {
          "s": 48,
          "text": "יציאה ממציאותו."
        }
      ]
    }
  ]
}