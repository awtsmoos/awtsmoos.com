{
  "globalIndex": 507,
  "owner": 7,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916754_theRebbe_640__p006",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916754_theRebbe_640__p006",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916754_theRebbe_640",
  "title": "מאמר באתי לגני תשכ\"ח",
  "part": 6,
  "sections": [
    {
      "v": 15,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 2,
          "text": "דגם בשכל שייך ניחומין."
        },
        {
          "s": 3,
          "text": "ומביא דוגמא לזה מזה שבתחילה76"
        },
        {
          "s": 4,
          "text": "כתיב וכל יצר מחשבות לבו רק רע גו'"
        },
        {
          "s": 5,
          "text": "(ולכן)"
        },
        {
          "s": 6,
          "text": "אמחה גו',"
        },
        {
          "s": 7,
          "text": "ואח\"כ77"
        },
        {
          "s": 8,
          "text": "כתיב כי יצר לב האדם רע מנעוריו ו"
        },
        {
          "s": 9,
          "text": "(לכן)"
        },
        {
          "s": 10,
          "text": "לא אוסיף עוד להכות גו'."
        },
        {
          "s": 11,
          "text": "דאותה הסברא שהיתה בתחילה טעם המחייב נעשית טעם המזכה."
        },
        {
          "s": 12,
          "text": "ומבאר,"
        },
        {
          "s": 13,
          "text": "דהשינוי שבשכל בא מצד הרצון."
        },
        {
          "s": 14,
          "text": "דכשנעשה שינוי בהרצון,"
        },
        {
          "s": 15,
          "text": "משתנה גם השכל."
        }
      ]
    },
    {
      "v": 16,
      "items": [
        {
          "s": 0,
          "text": "והנה הטעם על זה"
        },
        {
          "s": 1,
          "text": "(שע\"י הרצון משתנה השכל)"
        },
        {
          "s": 2,
          "text": "הוא,"
        },
        {
          "s": 3,
          "text": "לפי שהשכל שייך תמיד"
        },
        {
          "s": 4,
          "text": "(גם לאחרי שנמשך כבר מהרצון)"
        },
        {
          "s": 5,
          "text": "להרצון,"
        },
        {
          "s": 6,
          "text": "ולכן,"
        },
        {
          "s": 7,
          "text": "כשנעשה השינוי בהרצון משתנה גם השכל."
        },
        {
          "s": 8,
          "text": "וע\"ד שנת\"ל בענין שכל ומדות."
        },
        {
          "s": 9,
          "text": "וצריך להבין,"
        },
        {
          "s": 10,
          "text": "הרי הרצון והשכל הם שני ענינים שונים,"
        },
        {
          "s": 11,
          "text": "דשכל הוא פנימי"
        },
        {
          "s": 12,
          "text": "[דזה שמבואר לפעמים ששכל הוא בחי' מקיף,"
        },
        {
          "s": 13,
          "text": "הכוונה בזה היא שאינו בבחי' הרגש פנימי כ\"כ כמו המדות78],"
        },
        {
          "s": 14,
          "text": "ופעולתו בהמוח היא בדרך התלבשות,"
        },
        {
          "s": 15,
          "text": "ועד שע\"י ריבוי ההתעסקות במושכלות נעשה שינוי בהמוח שמתוספים בו חריצים79,"
        },
        {
          "s": 16,
          "text": "ועד\"ז הוא בנוגע לפעולת השכל בהמדות שבלב,"
        },
        {
          "s": 17,
          "text": "דזה שפועל בהמדות הוא ע\"י שמתלבש בהם."
        },
        {
          "s": 18,
          "text": "משא\"כ הרצון הוא מקיף שאינו בהתלבשות."
        },
        {
          "s": 19,
          "text": "דכמו\"כ הוא גם בנוגע לפעולת הרצון על השכל"
        },
        {
          "s": 20,
          "text": "[שע\"י הרצון נעשה שינוי בשכל,"
        },
        {
          "s": 21,
          "text": "שלכן אמרו80"
        },
        {
          "s": 22,
          "text": "לעולם ילמוד אדם במקום שלבו חפץ]"
        },
        {
          "s": 23,
          "text": "שאין זה בדרך התלבשות אלא בדרך סיבה."
        },
        {
          "s": 24,
          "text": "ועפ\"ז צריך ביאור,"
        },
        {
          "s": 25,
          "text": "דלכאורה בשכל ומדות,"
        },
        {
          "s": 26,
          "text": "מכיון שבהמדות מלובש השכל,"
        },
        {
          "s": 27,
          "text": "לכן גם לאחרי שנמשכו המדות מהשכל הן תלויות בהשכל,"
        },
        {
          "s": 28,
          "text": "וכשנעשה שינוי בהשכל משתנים גם המדות."
        },
        {
          "s": 29,
          "text": "משא\"כ ברצון ושכל,"
        },
        {
          "s": 30,
          "text": "מכיון שהרצון הוא רק סיבה להמשכת וגילוי השכל,"
        },
        {
          "s": 31,
          "text": "מהו הקשר דהשכל"
        },
        {
          "s": 32,
          "text": "(לאחרי שנמשך כבר)"
        },
        {
          "s": 33,
          "text": "עם הרצון,"
        },
        {
          "s": 34,
          "text": "ועד שע\"י שינוי הרצון ישתנה גם השכל."
        }
      ]
    },
    {
      "v": 17,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "ויובן זה בהקדים מה שמבאר הצ\"צ בארוכה באוה\"ת פ' נשא81"
        },
        {
          "s": 3,
          "text": "ובקיצור בספר המצוות שלו מצות בנין מקדש82"
        },
        {
          "s": 4,
          "text": "עה\"פ83"
        },
        {
          "s": 5,
          "text": "כל אשר חפץ הוי' עשה,"
        },
        {
          "s": 6,
          "text": "דצריך להבין,"
        },
        {
          "s": 7,
          "text": "הרי הנבראים נתהוו מעשר הספירות שלמטה מהכתר,"
        },
        {
          "s": 8,
          "text": "ובפרטיות יותר מז' המדות,"
        },
        {
          "s": 9,
          "text": "ולמה מיחס כל המעשים להרצון שהוא הכתר."
        },
        {
          "s": 10,
          "text": "ולכאורה יש להוסיף,"
        },
        {
          "s": 11,
          "text": "דאין לומר דזה שנתהוה מהע\"ס הוא פרטי הנבראים ומ\"ש כל אשר חפץ הוי' עשה"
        },
        {
          "s": 12,
          "text": "(כל דוקא)"
        },
        {
          "s": 13,
          "text": "קאי על כללות הבריאה,"
        },
        {
          "s": 14,
          "text": "שהרי גם כללות הבריאה התהוותה היא מהחכמה,"
        },
        {
          "s": 15,
          "text": "כמבואר בכ\"מ84"
        },
        {
          "s": 16,
          "text": "עה\"פ85"
        },
        {
          "s": 17,
          "text": "כולם בחכמה עשית,"
        },
        {
          "s": 18,
          "text": "דההתחלקות שבנבראים היא מצד הבינה,"
        },
        {
          "s": 19,
          "text": "משא\"כ ההתהוות שמצד החכמה היא בכללות"
        },
        {
          "s": 20,
          "text": "(כולם בחכמה),"
        },
        {
          "s": 21,
          "text": "ומהו אומרו כל אשר חפץ הוי' עשה דהבריאה היא מהרצון."
        },
        {
          "s": 22,
          "text": "ומבאר זה ע\"פ משל מפעולת האדם86,"
        },
        {
          "s": 23,
          "text": "דהגם שכל פעולה באה מכח פרטי,"
        },
        {
          "s": 24,
          "text": "הרי זה שהכחות פועלים הוא ע\"י הרצון,"
        },
        {
          "s": 25,
          "text": "ובלי רצון,"
        },
        {
          "s": 26,
          "text": "לא תהי' שום פעולה."
        },
        {
          "s": 27,
          "text": "וכמו תנועת היד והרגל,"
        },
        {
          "s": 28,
          "text": "דהגם שהתנועה גופא באה מכח התנועה שביד,"
        },
        {
          "s": 29,
          "text": "מ\"מ,"
        },
        {
          "s": 30,
          "text": "בכדי שתהי' התנועה,"
        },
        {
          "s": 31,
          "text": "הוא ע\"י הרצון דוקא,"
        },
        {
          "s": 32,
          "text": "ובלי הרצון תנוח היד כמו אבן דומם"
        },
        {
          "s": 33,
          "text": "(אף שיש בה כח התנועה)."
        },
        {
          "s": 34,
          "text": "ועד\"ז הוא באדם העליון,"
        },
        {
          "s": 35,
          "text": "דזה שנמשך מע\"ס שפע להחיות העולמות הוא מצד הרצון,"
        },
        {
          "s": 36,
          "text": "ולכן מתייחסים כל המעשים להרצון,"
        },
        {
          "s": 37,
          "text": "כל אשר חפץ הוי' עשה."
        },
        {
          "s": 38,
          "text": "ויש לומר,"
        },
        {
          "s": 39,
          "text": "דזה שכל המעשים מתייחסים להרצון,"
        },
        {
          "s": 40,
          "text": "אף שהמעשים עצמם נמשכים מהע\"ס והרצון הוא רק בכדי שהספירות ישפיעו,"
        },
        {
          "s": 41,
          "text": "הוא"
        },
        {
          "s": 42,
          "text": "(כדמשמע באוה\"ת שם)"
        },
        {
          "s": 43,
          "text": "מפני דזה שפעולת כחות הפנימיים היא ע\"י הרצון הוא מפני שכחות הפנימיים הם רק זיו והארה מהנפש והרצון הוא מעצמות הנפש."
        },
        {
          "s": 44,
          "text": "ולכן מתייחסים המעשים להרצון,"
        },
        {
          "s": 45,
          "text": "אף שהם נמשכים מכחות הפנימיים,"
        },
        {
          "s": 46,
          "text": "כי הרצון הוא"
        },
        {
          "s": 47,
          "text": "(כמו)"
        },
        {
          "s": 48,
          "text": "העצם שלהם."
        }
      ]
    }
  ]
}