{
  "globalIndex": 732,
  "owner": 32,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918060_theRebbe_524__p001",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918060_theRebbe_524__p001",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518918060_theRebbe_524",
  "title": "מאמר ועבדי דוד תשמ\"ו",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "אחרון של פסח ה'תשמ\"ו*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "ועבדי דוד מלך עליהם ורועה אחד יהי' לכולם וגו'1,"
        },
        {
          "s": 1,
          "text": "וידוע מאמר כ\"ק מו\"ח אדמו\"ר נשיא דורנו על הפסוק2,"
        },
        {
          "s": 2,
          "text": "שמבאר שם,"
        },
        {
          "s": 3,
          "text": "דפסוק זה קאי על מלך המשיח הנק' בשם דוד,"
        },
        {
          "s": 4,
          "text": "דוד מלכא משיחא."
        },
        {
          "s": 5,
          "text": "ותוכן הענין הוא,"
        },
        {
          "s": 6,
          "text": "דלע\"ל יהי' משיח"
        },
        {
          "s": 7,
          "text": "(דוד)"
        },
        {
          "s": 8,
          "text": "רועה אחד לכולם,"
        },
        {
          "s": 9,
          "text": "שלא יחצו עוד לשתי ממלכות3."
        },
        {
          "s": 10,
          "text": "דבישראל היו ב' ממלכות,"
        },
        {
          "s": 11,
          "text": "מלכות בית דוד ומלכות בית יוסף"
        },
        {
          "s": 12,
          "text": "(אפרים),"
        },
        {
          "s": 13,
          "text": "שמלכי בית דוד היו משבט יהודה ומלכי בית יוסף היו משבט יוסף,"
        },
        {
          "s": 14,
          "text": "אבל לע\"ל לא יהיו עוד שתי ממלכות,"
        },
        {
          "s": 15,
          "text": "אלא רועה אחד יהי' לכולם ורועה זה יהי' דוד,"
        },
        {
          "s": 16,
          "text": "משבט יהודה."
        },
        {
          "s": 17,
          "text": "וצריך להבין,"
        },
        {
          "s": 18,
          "text": "דהנה מזה שלע\"ל צ\"ל הבטחה מיוחדת שרועה אחד יהי' לכולם ולא יחצו עוד לשתי ממלכות,"
        },
        {
          "s": 19,
          "text": "מובן שגם אז יש מקום שיהיו ב' ממלכות,"
        },
        {
          "s": 20,
          "text": "מהי הסברא שלע\"ל יהיו ב' ממלכות."
        },
        {
          "s": 21,
          "text": "גם צריך להבין,"
        },
        {
          "s": 22,
          "text": "מהו ודאות העילוי בזה שדוד"
        },
        {
          "s": 23,
          "text": "(משבט יהודה)"
        },
        {
          "s": 24,
          "text": "יהי' מלך עליהם ורועה אחד לכולם,"
        },
        {
          "s": 25,
          "text": "ולכאורה מצינו מעלה ביוסף לגבי יהודה."
        },
        {
          "s": 26,
          "text": "דהנה ביוסף ויהודה עצמם הרי יוסף הי' מלך על כל אחיו,"
        },
        {
          "s": 27,
          "text": "כולל יהודה4,"
        },
        {
          "s": 28,
          "text": "כמפורש בחלומות יוסף."
        },
        {
          "s": 29,
          "text": "וגם הרי יש מעלה במלכות יוסף שהיתה על עשרה שבטים משא\"כ מלכות יהודה היתה על ב' שבטים בלבד."
        },
        {
          "s": 30,
          "text": "גם צריך להבין תוכן ענינים אלה בעבודת האדם בזמן הזה."
        },
        {
          "s": 31,
          "text": "ובפרט ע\"פ הידוע5"
        },
        {
          "s": 32,
          "text": "שכל הגילויים דלע\"ל תלויים במעשינו ועבודתינו כל זמן משך הגלות,"
        },
        {
          "s": 33,
          "text": "ואמרז\"ל6"
        },
        {
          "s": 34,
          "text": "היום לעשותם ולמחר לקבל שכרם."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והענין הוא7,"
        },
        {
          "s": 2,
          "text": "דהנה החילוק בין יוסף ויהודה יובן מהשמות"
        },
        {
          "s": 3,
          "text": "(יוסף ויהודה)"
        },
        {
          "s": 4,
          "text": "עצמם,"
        },
        {
          "s": 5,
          "text": "דיהודה הוא מלשון הודאה ויוסף הוא מלשון הוספה כמפורש בקרא."
        },
        {
          "s": 6,
          "text": "ובכחות הנפש הוא החילוק בין כח העשי' שבאדם לכח השכל שבו."
        },
        {
          "s": 7,
          "text": "דהנה הכח הקשור עם הודאה"
        },
        {
          "s": 8,
          "text": "[בבני אדם בכלל"
        },
        {
          "s": 9,
          "text": "(מין המדבר),"
        },
        {
          "s": 10,
          "text": "ועאכו\"כ בבני ישראל"
        },
        {
          "s": 11,
          "text": "(חלק אלוקה ממעל ממש8)]"
        },
        {
          "s": 12,
          "text": "הוא כח המעשה,"
        },
        {
          "s": 13,
          "text": "דכדי שתהי' פעולה בכח העשי',"
        },
        {
          "s": 14,
          "text": "צ\"ל הודאה וכפי'."
        },
        {
          "s": 15,
          "text": "שהרי ענין ההודאה בפשטות הוא שמודה לדבר מסויים אף שאינו מובן בשכלו או יתר על כן שהוא היפך שכלו9."
        },
        {
          "s": 16,
          "text": "דענין זה הוא בכח העשי' בפועל,"
        },
        {
          "s": 17,
          "text": "כי כאשר האדם עושה מעשה הרי הוא מוריד רצונו ושכלו כו' עד שבא למעשה זה,"
        },
        {
          "s": 18,
          "text": "וירידה זו"
        },
        {
          "s": 19,
          "text": "(בכל אדם,"
        },
        {
          "s": 20,
          "text": "ובפרט בישראל כנ\"ל)"
        },
        {
          "s": 21,
          "text": "היא ירידה לבירא עמיקתא,"
        },
        {
          "s": 22,
          "text": "ולכן צ\"ל אצלו הודאה וכפי' וכו'10"
        },
        {
          "s": 23,
          "text": "(וע\"ד ירידת הנשמה למטה מאיגרא11"
        },
        {
          "s": 24,
          "text": "רמה לבירא עמיקתא,"
        },
        {
          "s": 25,
          "text": "שירידה זו היא בדרך כפי' וכמאמר12"
        },
        {
          "s": 26,
          "text": "על כרחך אתה חי)."
        },
        {
          "s": 27,
          "text": "אמנם ענין ההוספה הוא היפך זה."
        },
        {
          "s": 28,
          "text": "כי הוספה מורה שהענין לא רק מתקבל"
        },
        {
          "s": 29,
          "text": "(לייגט זיך אָפּ)"
        },
        {
          "s": 30,
          "text": "בשכלו,"
        },
        {
          "s": 31,
          "text": "אלא עוד זאת שמוסיף עי\"ז בחכמה ושכל,"
        },
        {
          "s": 32,
          "text": "ובפרט כשישנה הוספה אחר הוספה."
        },
        {
          "s": 33,
          "text": "דזהו ענין חכמה ושכל אמיתיים."
        },
        {
          "s": 34,
          "text": "ובכחות האדם הוא כח הבינה שבו,"
        },
        {
          "s": 35,
          "text": "הנק' רחובות הנהר13,"
        },
        {
          "s": 36,
          "text": "שהוא באופן דמוסיף והולך ומוסיף,"
        },
        {
          "s": 37,
          "text": "מוליד עוד עניני שכל והסברה,"
        },
        {
          "s": 38,
          "text": "דזהו אמיתית כוונת הפלפול והשקו\"ט וכו'."
        },
        {
          "s": 39,
          "text": "ומובן,"
        },
        {
          "s": 40,
          "text": "שזה הוא ההיפך מענין דכפי' והודאה"
        },
        {
          "s": 41,
          "text": "(על כרחך),"
        },
        {
          "s": 42,
          "text": "כי במין המדבר בכלל ובפרט בישראל,"
        },
        {
          "s": 43,
          "text": "השכל הוא דבר המתקבל"
        },
        {
          "s": 44,
          "text": "(לייגט זיך אָפּ),"
        },
        {
          "s": 45,
          "text": "עד שמוסיף בזה וכו'."
        }
      ]
    }
  ]
}