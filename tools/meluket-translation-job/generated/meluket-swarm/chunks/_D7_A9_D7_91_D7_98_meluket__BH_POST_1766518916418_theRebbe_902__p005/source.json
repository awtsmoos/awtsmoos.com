{
  "globalIndex": 464,
  "owner": 14,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916418_theRebbe_902__p005",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916418_theRebbe_902__p005",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916418_theRebbe_902",
  "title": "מאמר לה\"ע כתיבת ספר תורה תש\"ל",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "והנה המשכת בחינת ואמת,"
        },
        {
          "s": 2,
          "text": "תיקון הז',"
        },
        {
          "s": 3,
          "text": "ע\"י התיקוני דיקנא,"
        },
        {
          "s": 4,
          "text": "ואח\"כ ע\"י העשר ספירות דאצילות וכל סדר ההשתלשלות עד לעולם הזה התחתון שאין תחתון למטה ממנו69,"
        },
        {
          "s": 5,
          "text": "הוא ע\"י התורה,"
        },
        {
          "s": 6,
          "text": "וכמארז\"ל70"
        },
        {
          "s": 7,
          "text": "אין אמת אלא תורה."
        },
        {
          "s": 8,
          "text": "והנה על התורה נאמר71"
        },
        {
          "s": 9,
          "text": "הלא כה דברי כאש,"
        },
        {
          "s": 10,
          "text": "ודרשו רז\"ל72"
        },
        {
          "s": 11,
          "text": "מה אש אינו מקבל טומאה אף דברי תורה אינן מקבלין טומאה,"
        },
        {
          "s": 12,
          "text": "היינו,"
        },
        {
          "s": 13,
          "text": "שהתורה נמשכת בכל מקום,"
        },
        {
          "s": 14,
          "text": "גם למטה מטה."
        },
        {
          "s": 15,
          "text": "ולא זו בלבד שהתורה נמשכת גם למטה מטה,"
        },
        {
          "s": 16,
          "text": "אלא עוד זאת,"
        },
        {
          "s": 17,
          "text": "שגם בהיותה למטה הרי היא כמו שהיא למעלה,"
        },
        {
          "s": 18,
          "text": "באופן דכה דברי כאש."
        },
        {
          "s": 19,
          "text": "שזהו בחינת אמת,"
        },
        {
          "s": 20,
          "text": "שענינה הוא כדאיתא בירושלמי73"
        },
        {
          "s": 21,
          "text": "[בפי' חותמו של הקב\"ה אמת],"
        },
        {
          "s": 22,
          "text": "שאל\"ף הוא תחילת כל האותיות,"
        },
        {
          "s": 23,
          "text": "ותי\"ו סוף כל האותיות,"
        },
        {
          "s": 24,
          "text": "ומ\"ם אמצעיתם,"
        },
        {
          "s": 25,
          "text": "ואין בזה שינויים כלל,"
        },
        {
          "s": 26,
          "text": "שזהו\"ע אני ראשון ואני אחרון ומבלעדי"
        },
        {
          "s": 27,
          "text": "(גם באמצעיתא)"
        },
        {
          "s": 28,
          "text": "אין אלקים74."
        },
        {
          "s": 29,
          "text": "ולכן ע\"י התורה"
        },
        {
          "s": 30,
          "text": "(שהיא אמת)"
        },
        {
          "s": 31,
          "text": "נמשכת בחי' ואמת,"
        },
        {
          "s": 32,
          "text": "תיקון הז',"
        },
        {
          "s": 33,
          "text": "לעוה\"ז התחתון שאין תחתון למטה ממנו."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "וזהו ויכתוב משה גו',"
        },
        {
          "s": 2,
          "text": "שקאי על ענין התורה,"
        },
        {
          "s": 3,
          "text": "דענינו של משה הוא"
        },
        {
          "s": 4,
          "text": "(כמבואר בלקוטי תורה)"
        },
        {
          "s": 5,
          "text": "ענין התורה,"
        },
        {
          "s": 6,
          "text": "משה קיבל תורה כו'75,"
        },
        {
          "s": 7,
          "text": "ונקראת על שמו,"
        },
        {
          "s": 8,
          "text": "כמ\"ש76"
        },
        {
          "s": 9,
          "text": "זכרו תורת משה עבדי,"
        },
        {
          "s": 10,
          "text": "הנה ע\"י התורה המשיך בחינה זו,"
        },
        {
          "s": 11,
          "text": "ואמת,"
        },
        {
          "s": 12,
          "text": "מי\"ג תיקוני דיקנא"
        },
        {
          "s": 13,
          "text": "(י\"ג מדות הרחמים),"
        },
        {
          "s": 14,
          "text": "מרצון העליון ב\"ה,"
        },
        {
          "s": 15,
          "text": "עד למטה מטה,"
        },
        {
          "s": 16,
          "text": "ועד לאופן דכתיבה"
        },
        {
          "s": 17,
          "text": "(ויכתוב)"
        },
        {
          "s": 18,
          "text": "בדיו על הקלף."
        },
        {
          "s": 19,
          "text": "והיינו,"
        },
        {
          "s": 20,
          "text": "דאף שכתיבת דבר שכל בכלל,"
        },
        {
          "s": 21,
          "text": "ועאכו\"כ חכמתו של הקב\"ה,"
        },
        {
          "s": 22,
          "text": "היא ירידה גדולה77,"
        },
        {
          "s": 23,
          "text": "וצריך להיות כו\"כ צמצומים עד שיומשך בדיו על הספר כ\"ב אותיות התורה,"
        },
        {
          "s": 24,
          "text": "כמבואר בתניא78,"
        },
        {
          "s": 25,
          "text": "בכ\"ז לא נשתנה כאן ע\"י המשכתה,"
        },
        {
          "s": 26,
          "text": "ונמשכת בחינה זו עד לעולם הזה התחתון שאין תחתון למטה ממנו."
        },
        {
          "s": 27,
          "text": "וזהו גם שבויכתוב"
        },
        {
          "s": 28,
          "text": "(משה)"
        },
        {
          "s": 29,
          "text": "נכלל"
        },
        {
          "s": 30,
          "text": "(לדעת ר' מאיר)"
        },
        {
          "s": 31,
          "text": "גם ענין החתימה,"
        },
        {
          "s": 32,
          "text": "כנ\"ל."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ובענין החותם ישנם ב' ענינים."
        },
        {
          "s": 1,
          "text": "ענין הא',"
        },
        {
          "s": 2,
          "text": "שהוא נחתם על הדבר לבל ישונה79,"
        },
        {
          "s": 3,
          "text": "בחינת אני הוי' לא שניתי"
        },
        {
          "s": 4,
          "text": "[וענין זה ישנו גם בכאו\"א מישראל,"
        },
        {
          "s": 5,
          "text": "דזהו מ\"ש80"
        },
        {
          "s": 6,
          "text": "אני הוי' לא שניתי ואתם בני יעקב לא כליתם,"
        },
        {
          "s": 7,
          "text": "שאחד הפירושים בזה הוא81,"
        },
        {
          "s": 8,
          "text": "דמכיון שאני הוי' לא שניתי לכן גם אתם בני יעקב לא כליתם]."
        },
        {
          "s": 9,
          "text": "וענין הב' שבחותם הוא82,"
        },
        {
          "s": 10,
          "text": "דלא זו בלבד שאינו עצם האדם,"
        },
        {
          "s": 11,
          "text": "כ\"א שם וסימן בלבד להאדם"
        },
        {
          "s": 12,
          "text": "(שהשם אין לו ערך לגבי עצמיות דבעל השם),"
        },
        {
          "s": 13,
          "text": "הנה עוד זאת שכשחותמין בחותם על השעוה,"
        },
        {
          "s": 14,
          "text": "הרי הוא נפרד ונבדל ממנו."
        },
        {
          "s": 15,
          "text": "שהנמשל מזה בעולמות הם עולמות בי\"ע,"
        },
        {
          "s": 16,
          "text": "דלאו איהו וחיוהי וגרמוהי חד בהון83,"
        },
        {
          "s": 17,
          "text": "ובפרט עולם העשי' שאין למטה ממנו."
        },
        {
          "s": 18,
          "text": "והיינו,"
        },
        {
          "s": 19,
          "text": "שבחינת אני הוי' לא שניתי"
        },
        {
          "s": 20,
          "text": "(מוצאיהם),"
        },
        {
          "s": 21,
          "text": "ענין הא' דחותם,"
        },
        {
          "s": 22,
          "text": "נמשך ונחתם למטה מטה"
        },
        {
          "s": 23,
          "text": "(מסעיהם),"
        },
        {
          "s": 24,
          "text": "וכן ענין הב' שבחותם."
        },
        {
          "s": 25,
          "text": "וכ\"ז נעשה ע\"י ויכתוב משה,"
        },
        {
          "s": 26,
          "text": "ע\"י משה רבינו רעיא מהימנא."
        }
      ]
    }
  ]
}