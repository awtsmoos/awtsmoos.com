{
  "globalIndex": 528,
  "owner": 28,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916815_theRebbe_81__p011",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916815_theRebbe_81__p011",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916815_theRebbe_81",
  "title": "מאמר באתי לגני תש\"ל",
  "part": 11,
  "sections": [
    {
      "v": 30,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ט)"
        },
        {
          "s": 2,
          "text": "והנה ענין זה שהעצה ליפטר מבלבולים בתפלה הוא ע\"י ההתבוננות שהכוונה בהבלבולים היא בכדי לעורר את האדם להתפלל יותר בכוונה,"
        },
        {
          "s": 3,
          "text": "הוא כשהבלבולים הם ע\"י דיבורו של אדם אחר המבלבלו."
        },
        {
          "s": 4,
          "text": "משא\"כ כשהבלבולים הם ממחשבות זרות שנופלות לו מנפשו הבהמית בכדי לבלבלו"
        },
        {
          "s": 5,
          "text": "(אף שזה שנפשו הבהמית מבלבלת אותו בהמחשבות זרות הוא כמשל ערל רשע שמבלבל אותו ע\"י דיבורו,"
        },
        {
          "s": 6,
          "text": "כמובא לעיל מתניא),"
        },
        {
          "s": 7,
          "text": "מ\"מ,"
        },
        {
          "s": 8,
          "text": "בעת נפילת המחשבות זרות אין מקום להתבונן בהכוונה דירידת השכינה והתלבשות ניצוץ מהארתה בהמחשבות זרות,"
        },
        {
          "s": 9,
          "text": "וכמ\"ש בתניא שם שלא ישיב שום טענה ומענה נגד המחשבה זרה"
        },
        {
          "s": 10,
          "text": "[ויש לומר,"
        },
        {
          "s": 11,
          "text": "שגם ההתבוננות בסיבת המחשבה זרה היא בכלל טענה ומענה],"
        },
        {
          "s": 12,
          "text": "והעצה היא שיעשה עצמו כלא יודע ולא שומע ההרהורים שנפלו לו ויסירם מדעתו."
        },
        {
          "s": 13,
          "text": "[דכאשר מתבונן בהכוונה דהמחשבות זרות בזמן אחר,"
        },
        {
          "s": 14,
          "text": "ההתבוננות יכולה להועיל שבעת התפלה לא יהיו לו מחשבות זרות."
        },
        {
          "s": 15,
          "text": "אבל בעת נפילת המחשבות עצמם,"
        },
        {
          "s": 16,
          "text": "העצה היא לעשות עצמו כלא יודע ולא שומע ההרהורים שנפלו לו]."
        },
        {
          "s": 17,
          "text": "ולכן אומר בהמאמר שהעצה ליפטר מהמחשבות שנופלות בשעת התורה והתפלה היא לעורר מדת הנצח,"
        },
        {
          "s": 18,
          "text": "כי בעת נפילת המחשבות זרות אין מקום להתבוננות,"
        },
        {
          "s": 19,
          "text": "כנ\"ל."
        }
      ]
    },
    {
      "v": 31,
      "items": [
        {
          "s": 0,
          "text": "כ)"
        },
        {
          "s": 1,
          "text": "\"ף)"
        },
        {
          "s": 2,
          "text": "והנה ע\"י ההתבוננות בסיבת הבלבולים"
        },
        {
          "s": 3,
          "text": "[הבאים ע\"י דיבורו של אדם אחר המבלבלו,"
        },
        {
          "s": 4,
          "text": "ועד\"ז ההתבוננות בסיבת הבלבולים דמחשבות זרות הבאות מנפש הבהמית,"
        },
        {
          "s": 5,
          "text": "שמתבונן בזה בזמן אחר]"
        },
        {
          "s": 6,
          "text": "דירידת השכינה והתלבשות ניצוץ מהארתה בהדיבורים ובהמחשבות המבלבלים הוא בכדי שעי\"ז יתעורר בכוונה יתירה,"
        },
        {
          "s": 7,
          "text": "ירידה צורך עלי',"
        },
        {
          "s": 8,
          "text": "עי\"ז הוא מעלה את הניצוצות שנפלו בהדיבור,"
        },
        {
          "s": 9,
          "text": "אתהפכא."
        },
        {
          "s": 10,
          "text": "וכאשר מעורר את מדת הנצח שבו ומתגבר על הבלבולים ומדחה אותם,"
        },
        {
          "s": 11,
          "text": "ועושה עצמו שלא שומע ההרהורים,"
        },
        {
          "s": 12,
          "text": "הוא אתכפיא."
        },
        {
          "s": 13,
          "text": "וע\"פ המבואר לעיל"
        },
        {
          "s": 14,
          "text": "(סעיף ה)"
        },
        {
          "s": 15,
          "text": "שההמשכה שע\"י העבודה דאתכפיא היא נעלית יותר מההמשכה שע\"י העבודה דאתהפכא,"
        },
        {
          "s": 16,
          "text": "יש לומר,"
        },
        {
          "s": 17,
          "text": "שע\"י שמדחה את ההרהורים באופן דאתכפיא,"
        },
        {
          "s": 18,
          "text": "מיתוסף אומץ בכוונתו בתפלה עוד יותר מההוספה בכוונה שנעשית ע\"י ההתבוננות הנ\"ל."
        }
      ]
    },
    {
      "v": 32,
      "items": [
        {
          "s": 0,
          "text": "כ)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "והנה בכדי שיוכל האדם להתגבר על הבלבולים ולדחותם,"
        },
        {
          "s": 3,
          "text": "שזוהי עבודה גדולה וקשה ביותר,"
        },
        {
          "s": 4,
          "text": "נותנים לו מלמעלה,"
        },
        {
          "s": 5,
          "text": "ובאופן דבזבוז,"
        },
        {
          "s": 6,
          "text": "האוצר העליון."
        },
        {
          "s": 7,
          "text": "ויש לבאר השייכות דשני הענינים,"
        },
        {
          "s": 8,
          "text": "דכיון שאוצר הוא ענין הנעלם,"
        },
        {
          "s": 9,
          "text": "עין לא ראתה125,"
        },
        {
          "s": 10,
          "text": "הרי זה שנותנים ומגלים את האוצר,"
        },
        {
          "s": 11,
          "text": "ובפרט באופן דבזבוז,"
        },
        {
          "s": 12,
          "text": "הוא קשה כביכול לפני הקב\"ה,"
        },
        {
          "s": 13,
          "text": "ומ\"מ עושים זה בשביל האדם,"
        },
        {
          "s": 14,
          "text": "בכדי שיוכל לעבוד עבודה קשה הנ\"ל."
        },
        {
          "s": 15,
          "text": "ויש להוסיף,"
        },
        {
          "s": 16,
          "text": "שע\"פ הידוע126"
        },
        {
          "s": 17,
          "text": "שההמשכה מלמעלה הבאה ע\"י עבודת האדם היא נעלית יותר מההמשכה מלמעלה שהיא נתינת כח להאדם לעבוד עבודתו,"
        },
        {
          "s": 18,
          "text": "יש לומר,"
        },
        {
          "s": 19,
          "text": "שע\"י שהאדם מתגבר על הבלבולים ומדחה אותם"
        },
        {
          "s": 20,
          "text": "(ע\"י הנתינת כח דהמשכת אוצר העליון),"
        },
        {
          "s": 21,
          "text": "המשכת האוצר הבאה ע\"י עבודתו,"
        },
        {
          "s": 22,
          "text": "היא נעלית עוד יותר."
        },
        {
          "s": 23,
          "text": "ויש לומר,"
        },
        {
          "s": 24,
          "text": "דזהו שאומר בהמאמר"
        },
        {
          "s": 25,
          "text": "(בהסיום והחותם דפרק העשרים,"
        },
        {
          "s": 26,
          "text": "שהוא גם הסיום והחותם דכל ההמשך),"
        },
        {
          "s": 27,
          "text": "דע\"י הנצחון שאדם מנצח את הנה\"ב שלו הוא גורם127"
        },
        {
          "s": 28,
          "text": "המשכת אוצר העליון,"
        },
        {
          "s": 29,
          "text": "שהוא גילוי פנימיות ועצמות אין סוף ב\"ה."
        },
        {
          "s": 30,
          "text": "דבפרקים הקודמים כשמבאר ענין האוצר,"
        },
        {
          "s": 31,
          "text": "אינו אומר לשון זה"
        },
        {
          "s": 32,
          "text": "(פנימיות ועצמות א\"ס ב\"ה)128,"
        },
        {
          "s": 33,
          "text": "כי שם מדבר בענין המשכת וגילוי האוצר שבשביל הנצחון,"
        },
        {
          "s": 34,
          "text": "ובסיום וחותם ההמשך שמדבר בענין המשכת האוצר הבא ע\"י הנצחון דהאדם,"
        },
        {
          "s": 35,
          "text": "אומר,"
        },
        {
          "s": 36,
          "text": "שהוא גילוי פנימיות ועצמות אין סוף ב\"ה."
        }
      ]
    }
  ]
}