{
  "globalIndex": 1050,
  "owner": 0,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919961_theRebbe_975__p004",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919961_theRebbe_975__p004",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919961_theRebbe_975",
  "title": "מאמר ועתה ישראל תשל\"ז",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "והנה מכיון שהכוונה בירידת הנשמה למטה היא לעשות את העולם דירה לו ית',"
        },
        {
          "s": 2,
          "text": "הרי מובן,"
        },
        {
          "s": 3,
          "text": "שענין זה"
        },
        {
          "s": 4,
          "text": "(עשיית הדירה לו ית')"
        },
        {
          "s": 5,
          "text": "הוא ענין עיקרי במעמדה ומצבה."
        },
        {
          "s": 6,
          "text": "דכאשר אינה ממלאה ח\"ו את שליחותה ותפקידה,"
        },
        {
          "s": 7,
          "text": "גם כשיש לה גילויים הכי נעלים,"
        },
        {
          "s": 8,
          "text": "חסר העיקר,"
        },
        {
          "s": 9,
          "text": "ולאידך,"
        },
        {
          "s": 10,
          "text": "ע\"י שמשלמת הכוונה דדירה בתחתונים,"
        },
        {
          "s": 11,
          "text": "נעשה בה עלי' גדולה ונפלאה לאין קץ64."
        },
        {
          "s": 12,
          "text": "ועפ\"ז יובן שהעבודה דמאה שעל ידה נעשה הגילוי דמ\"ה היא מאה ברכות השייכים לבירור וזיכוך העולם"
        },
        {
          "s": 13,
          "text": "(כדלקמן),"
        },
        {
          "s": 14,
          "text": "אף שהגילוי יכול להיות לכאורה גם ע\"י העבודה בפרטי הכחות דהנשמה,"
        },
        {
          "s": 15,
          "text": "ללכת בכל דרכיו וגו',"
        },
        {
          "s": 16,
          "text": "כי השלימות דהנשמה,"
        },
        {
          "s": 17,
          "text": "גם המ\"ה שבה,"
        },
        {
          "s": 18,
          "text": "היא דוקא ע\"י שממלאה את תפקידה ושליחותה."
        },
        {
          "s": 19,
          "text": "וזהו ועתה ישראל מה,"
        },
        {
          "s": 20,
          "text": "דע\"י שע\"י המ\"ה דהנשמה הוא עובד העבודה דישראל"
        },
        {
          "s": 21,
          "text": "(אתכפיא סט\"א ואתהפכא סט\"א)"
        },
        {
          "s": 22,
          "text": "עתה,"
        },
        {
          "s": 23,
          "text": "שעי\"ז הוא ממלא את הכוונה שבשבילה נברא,"
        },
        {
          "s": 24,
          "text": "עי\"ז דוקא,"
        },
        {
          "s": 25,
          "text": "הוא תכלית העילוי"
        },
        {
          "s": 26,
          "text": "(גם)"
        },
        {
          "s": 27,
          "text": "של המ\"ה שבו."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "וזהו חייב אדם לברך מאה ברכות בכל יום,"
        },
        {
          "s": 2,
          "text": "דענין הברכות הוא שיהי' המשכת גילוי אלקות לא רק בישראל אלא שעל ידם יומשך גילוי אלקות בעולם."
        },
        {
          "s": 3,
          "text": "וכמו שאומרים בנוסח הברכות ברוך אתה הוי' אלקינו מלך העולם,"
        },
        {
          "s": 4,
          "text": "שיומשך"
        },
        {
          "s": 5,
          "text": "(ברוך)"
        },
        {
          "s": 6,
          "text": "הגילוי דהוי' בישראל,"
        },
        {
          "s": 7,
          "text": "אלקינו,"
        },
        {
          "s": 8,
          "text": "ועי\"ז יומשך הגילוי בעולם,"
        },
        {
          "s": 9,
          "text": "מלך העולם65."
        },
        {
          "s": 10,
          "text": "ובעולמות גופא,"
        },
        {
          "s": 11,
          "text": "ההמשכה שע\"י הברכות היא"
        },
        {
          "s": 12,
          "text": "(בעיקר)"
        },
        {
          "s": 13,
          "text": "בעולמות התחתונים."
        },
        {
          "s": 14,
          "text": "וכמ\"ש66"
        },
        {
          "s": 15,
          "text": "ברוך הוי' אלקי ישראל מן העולם ועד העולם,"
        },
        {
          "s": 16,
          "text": "שיומשך מעלמא דאתכסיא לעלמא דאתגליא67."
        },
        {
          "s": 17,
          "text": "דעלמא68"
        },
        {
          "s": 18,
          "text": "דאתכסיא הם עולמות העליונים שהם בטלים לאלקות,"
        },
        {
          "s": 19,
          "text": "כמו דגים שבים שמכוסים ובטלים להמים,"
        },
        {
          "s": 20,
          "text": "ועלמא דאתגליא הם עולמות התחתונים,"
        },
        {
          "s": 21,
          "text": "ובפרט עוה\"ז הגשמי,"
        },
        {
          "s": 22,
          "text": "שנראים ליש ודבר נפרד,"
        },
        {
          "s": 23,
          "text": "וענין הברכה הוא שיומשך גילוי אלקות גם בעולמות התחתונים עד בעוה\"ז הגשמי."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "וכיון שכל מה שברא הקב\"ה בעולמו לא ברא דבר אחד לבטלה69,"
        },
        {
          "s": 1,
          "text": "וכל מה שברא הקב\"ה בעולמו לא בראו אלא לכבודו70,"
        },
        {
          "s": 2,
          "text": "צריך להמשיך גילוי אלקות בכל דבר שבעולם,"
        },
        {
          "s": 3,
          "text": "שיהי' נרגש בו בגילוי שנברא לכבודו ית'."
        },
        {
          "s": 4,
          "text": "וזהו\"ע מאה ברכות,"
        },
        {
          "s": 5,
          "text": "דמאה הוא ריבוי הכי גדול"
        },
        {
          "s": 6,
          "text": "[וכידוע71"
        },
        {
          "s": 7,
          "text": "שכללות האותיות הם בג' הסוגים דיחידות עשיריות ומאות],"
        },
        {
          "s": 8,
          "text": "דריבוי הו\"ע הפרטים,"
        },
        {
          "s": 9,
          "text": "וענין מאה ברכות הוא שיומשך גילוי אלקות בכל הפרטים שבעולם."
        },
        {
          "s": 10,
          "text": "ויש להוסיף בזה ע\"פ הידוע72"
        },
        {
          "s": 11,
          "text": "בענין המספרים יחידות עשיריות מאות,"
        },
        {
          "s": 12,
          "text": "דלפעמים מבואר,"
        },
        {
          "s": 13,
          "text": "שמספר המרובה הוא למעלה,"
        },
        {
          "s": 14,
          "text": "וכל שנמשך למטה יותר,"
        },
        {
          "s": 15,
          "text": "מתמעט המספר"
        },
        {
          "s": 16,
          "text": "(מאות בכתר ויחידות במלכות)."
        },
        {
          "s": 17,
          "text": "ולפעמים מבואר,"
        },
        {
          "s": 18,
          "text": "שלמעלה הוא מספר יחידות,"
        },
        {
          "s": 19,
          "text": "וכל שנמשך למטה יותר,"
        },
        {
          "s": 20,
          "text": "מתרבה המספר"
        },
        {
          "s": 21,
          "text": "(יחידות בכתר ומאות במלכות)."
        },
        {
          "s": 22,
          "text": "וידוע הביאור בזה72,"
        },
        {
          "s": 23,
          "text": "דשני אופנים אלו הם באורות וכלים."
        },
        {
          "s": 24,
          "text": "דבאורות,"
        },
        {
          "s": 25,
          "text": "מספר המרובה הוא למעלה,"
        },
        {
          "s": 26,
          "text": "ובכלים מספר המרובה הוא למטה."
        },
        {
          "s": 27,
          "text": "ועפ\"ז יש להוסיף ביאור בהמספר מאה ברכות,"
        },
        {
          "s": 28,
          "text": "כי מהחילוקים שבין עלמא דאתכסיא לעלמא דאתגליא הוא,"
        },
        {
          "s": 29,
          "text": "שבעלמא דאתכסיא העיקר הוא האורות ובעלמא דאתגליא העיקר הוא הכלים,"
        },
        {
          "s": 30,
          "text": "וכיון שענין הברכות היא ההמשכה מעלמא דאתכסיא לעלמא דאתגליא"
        },
        {
          "s": 31,
          "text": "(כנ\"ל),"
        },
        {
          "s": 32,
          "text": "היינו שהענינים דעלמא דאתכסיא"
        },
        {
          "s": 33,
          "text": "(אורות)"
        },
        {
          "s": 34,
          "text": "יהיו בגילוי גם בעלמא דאתגליא"
        },
        {
          "s": 35,
          "text": "(כלים),"
        },
        {
          "s": 36,
          "text": "לכן צריך לברך מאה ברכות,"
        },
        {
          "s": 37,
          "text": "להמשיך ריבוי האורות דעלמא דאתכסיא בהכלים דעלמא דאתגליא."
        },
        {
          "s": 38,
          "text": "ועד שיומשך זה בריבוי הנבראים שבעולם הזה הגשמי,"
        },
        {
          "s": 39,
          "text": "דענין מה רבו מעשיך ה'73"
        },
        {
          "s": 40,
          "text": "(ההתחלקות לריבוי פרטים)"
        },
        {
          "s": 41,
          "text": "הוא בעיקר בעוה\"ז הגשמי דוקא."
        }
      ]
    }
  ]
}