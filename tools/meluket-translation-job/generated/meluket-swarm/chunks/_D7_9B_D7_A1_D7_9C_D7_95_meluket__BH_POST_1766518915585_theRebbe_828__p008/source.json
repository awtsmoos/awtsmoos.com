{
  "globalIndex": 321,
  "owner": 21,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915585_theRebbe_828__p008",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915585_theRebbe_828__p008",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915585_theRebbe_828",
  "title": "מאמר פתח אליהו תשט\"ו",
  "part": 8,
  "sections": [
    {
      "v": 21,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "א)"
        },
        {
          "s": 2,
          "text": "וזהו שגם דעת תחתון הוא אמת ואעפ\"כ צריך להיות החיבור דדעת תחתון עם דעת עליון"
        },
        {
          "s": 3,
          "text": "(ראה לעיל סעיף ד),"
        },
        {
          "s": 4,
          "text": "כי ענין האמת דדעת תחתון הוא מפני שענינו"
        },
        {
          "s": 5,
          "text": "(בפנימיות)"
        },
        {
          "s": 6,
          "text": "הוא הגילוי דלמעלה עד אין קץ,"
        },
        {
          "s": 7,
          "text": "וענין זה שבו מתגלה ע\"י החיבור שלו עם דעת עליון."
        }
      ]
    },
    {
      "v": 22,
      "items": [
        {
          "s": 0,
          "text": "ועד\"ז הוא בענין הנהגת הטבע,"
        },
        {
          "s": 1,
          "text": "דהגם שגם הנהגת הטבע הוא זה שאנת הוא דאפיקת עשר תיקונין כו' לאנהגא בהון עלמין,"
        },
        {
          "s": 2,
          "text": "מ\"מ השלימות דהנהגת הטבע הוא כשנמשך בו הגילוי שלמעלה מהטבע,"
        },
        {
          "s": 3,
          "text": "כי עי\"ז דוקא מתגלה שהענין דלאנהגא בהון עלמין שרשו הוא מבחינת אנת."
        }
      ]
    },
    {
      "v": 23,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ב)"
        },
        {
          "s": 2,
          "text": "והנה זה שנתבאר לעיל"
        },
        {
          "s": 3,
          "text": "(סעיף יו\"ד)"
        },
        {
          "s": 4,
          "text": "דכשנרגש בב' הדיעות"
        },
        {
          "s": 5,
          "text": "(דדעת עליון ודעת תחתון)"
        },
        {
          "s": 6,
          "text": "שענינם הוא לגלות הענינים שבאוא\"ס"
        },
        {
          "s": 7,
          "text": "(שהוא למעלה עד אין קץ ולמטה עד אין תכלית)"
        },
        {
          "s": 8,
          "text": "שתי הדיעות הם ענין אחד,"
        },
        {
          "s": 9,
          "text": "הוא בכללות."
        },
        {
          "s": 10,
          "text": "אבל בפרטיות,"
        },
        {
          "s": 11,
          "text": "גם הענינים דלמעלה עד אין קץ ולמטה עד אין תכלית"
        },
        {
          "s": 12,
          "text": "(כמו שהם באוא\"ס46)"
        },
        {
          "s": 13,
          "text": "הם שני ענינים."
        },
        {
          "s": 14,
          "text": "ועפ\"ז,"
        },
        {
          "s": 15,
          "text": "בכדי שיהי' החיבור דדעת תחתון עם דעת עליון,"
        },
        {
          "s": 16,
          "text": "ועד\"ז החיבור דטבע עם למעלה מהטבע,"
        },
        {
          "s": 17,
          "text": "הוא ע\"י גילוי העצם שלמעלה משניהם."
        },
        {
          "s": 18,
          "text": "ויש לומר,"
        },
        {
          "s": 19,
          "text": "דזהו מ\"ש בהמאמר47"
        },
        {
          "s": 20,
          "text": "שהמשכת הגילוי שלמעלה מהטבע בטבע הוא ע\"י ההמשכה מבחינת אנת הוא חד,"
        },
        {
          "s": 21,
          "text": "אף שהגילוי דלמעלה מהטבע הוא גם ע\"י המשכת בחינת אנת הוא עילאה,"
        },
        {
          "s": 22,
          "text": "כי הענין דלמעלה מהטבע שמצד אנת הוא עילאה,"
        },
        {
          "s": 23,
          "text": "למעלה מהשתלשלות,"
        },
        {
          "s": 24,
          "text": "אינו נמשך בהטבע"
        },
        {
          "s": 25,
          "text": "(השתלשלות),"
        },
        {
          "s": 26,
          "text": "והמשכת הגילוי דלמעלה מהטבע בהטבע הוא ע\"י המשכת בחינת אנת הוא חד."
        },
        {
          "s": 27,
          "text": "וזהו גם הטעם על זה שצריך להיות החיבור דשני הענינים דטבע ולמעלה מהטבע,"
        },
        {
          "s": 28,
          "text": "כי כל אחד משני הענינים שרשו הוא באור א\"ס,"
        },
        {
          "s": 29,
          "text": "וע\"י החיבור דשני הענינים הוא המשכת העצמות."
        },
        {
          "s": 30,
          "text": "היינו,"
        },
        {
          "s": 31,
          "text": "שעי\"ז יש האפשרות"
        },
        {
          "s": 32,
          "text": "(גם מצד העולם)"
        },
        {
          "s": 33,
          "text": "שע\"י עבודה תהי' בעולם המשכת גילוי העצמות,"
        },
        {
          "s": 34,
          "text": "ועי\"ז נשלמת הכוונה דבריאת העולם"
        },
        {
          "s": 35,
          "text": "(הטבע)"
        },
        {
          "s": 36,
          "text": "דנתאוה הקב\"ה להיות לו ית' דירה בתחתונים48."
        }
      ]
    }
  ]
}