{
  "globalIndex": 166,
  "owner": 16,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914734_theRebbe_896__p001",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914734_theRebbe_896__p001",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914734_theRebbe_896",
  "title": "מאמר בורא ניב שפתיים תשמ\"ח",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "אור לי\"ג תשרי,"
        },
        {
          "s": 2,
          "text": "הילולא דכ\"ק אדמו\"ר מהר\"ש,"
        },
        {
          "s": 3,
          "text": "ה'תשמ\"ח"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "בורא ניב שפתים שלום שלום לרחוק ולקרוב אמר הוי' ורפאתיו1,"
        },
        {
          "s": 1,
          "text": "ומדייק כ\"ק מו\"ח אדמו\"ר במאמרו ד\"ה זה שנאמר בי\"ג תשרי לפני חמישים שנה2,"
        },
        {
          "s": 2,
          "text": "דניב שפתים הוא דיבור הבא ממילא"
        },
        {
          "s": 3,
          "text": "[דמשמעות הלשון ניב שפתים הוא שהניב"
        },
        {
          "s": 4,
          "text": "(דיבור3)"
        },
        {
          "s": 5,
          "text": "בא מהשפתים עצמם,"
        },
        {
          "s": 6,
          "text": "היינו שהדיבור הוא לא ע\"י מחשבה וכוונה אלא שבא מעצמו],"
        },
        {
          "s": 7,
          "text": "ומהי המעלה בדיבור הבא ממילא."
        },
        {
          "s": 8,
          "text": "ולהוסיף,"
        },
        {
          "s": 9,
          "text": "דלשון הכתוב הוא בורא ניב שפתים,"
        },
        {
          "s": 10,
          "text": "דפירוש בריאה הוא חידוש,"
        },
        {
          "s": 11,
          "text": "שנעשה דבר חדש שלא הי' מקודם,"
        },
        {
          "s": 12,
          "text": "בדוגמת החידוש דיש מאין4."
        },
        {
          "s": 13,
          "text": "[דהגם שלשון בריאה שייך גם בהתהוות יש מיש,"
        },
        {
          "s": 14,
          "text": "וכמובן גם מזה שכל מה שנתהווה בששת ימי בראשית"
        },
        {
          "s": 15,
          "text": "(גם נבראים הפרטים שנתהוו לאחרי יום הראשון דמע\"ב,"
        },
        {
          "s": 16,
          "text": "הגם שנתהוו מהשמים והארץ שנבראו ביום הראשון דמע\"ב5)"
        },
        {
          "s": 17,
          "text": "נקרא בשם בריאה6,"
        },
        {
          "s": 18,
          "text": "וכמ\"ש7"
        },
        {
          "s": 19,
          "text": "ויברא אלקים את האדם גו',"
        },
        {
          "s": 20,
          "text": "אף שגוף האדם נוצר מעפר8,"
        },
        {
          "s": 21,
          "text": "וגם בנשמת האדם כתיב8"
        },
        {
          "s": 22,
          "text": "ויפח באפיו נשמת חיים,"
        },
        {
          "s": 23,
          "text": "דנפיחה היא לא בריאה יש מאין אלא המשכת ההבל שהי' גם מקודם,"
        },
        {
          "s": 24,
          "text": "יש מיש,"
        },
        {
          "s": 25,
          "text": "[ולהעיר,"
        },
        {
          "s": 26,
          "text": "דהיש שממנו נתהווה הנשמה הוא אמיתית היש,"
        },
        {
          "s": 27,
          "text": "שהרי מאן דנפח מתוכי' נפח9,"
        },
        {
          "s": 28,
          "text": "ותוכי'"
        },
        {
          "s": 29,
          "text": "(תוכיותו ופנימיותו10)"
        },
        {
          "s": 30,
          "text": "הוא אמיתית היש],"
        },
        {
          "s": 31,
          "text": "הרי זה שלשון בריאה הוא בהתהוות יש מיש הוא דוקא בהתהוות שהיא באופן של חידוש ועד להחידוש שבדוגמת החידוש דיש מאין]."
        },
        {
          "s": 32,
          "text": "ומזה שנאמר בורא ניב שפתים,"
        },
        {
          "s": 33,
          "text": "שניב שפתים הוא חידוש11,"
        },
        {
          "s": 34,
          "text": "מוכח,"
        },
        {
          "s": 35,
          "text": "שהעילוי דניב שפתים,"
        },
        {
          "s": 36,
          "text": "דיבור הבא ממילא,"
        },
        {
          "s": 37,
          "text": "לגבי דיבור שע\"י מחשבה וכוונה,"
        },
        {
          "s": 38,
          "text": "הוא עילוי שבאין ערוך"
        },
        {
          "s": 39,
          "text": "(חידוש)."
        },
        {
          "s": 40,
          "text": "וצריך להבין,"
        },
        {
          "s": 41,
          "text": "הרי דיבור שע\"י מחשבה וכוונה הוא"
        },
        {
          "s": 42,
          "text": "(בפשטות)"
        },
        {
          "s": 43,
          "text": "נעלה יותר מדיבור שבא ממילא,"
        },
        {
          "s": 44,
          "text": "וממ\"ש בורא ניב שפתים מוכח שדיבור שבא ממילא הוא נעלה יותר ועד לעילוי שבאין ערוך."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 2,
          "text": "דבפירוש הרד\"ק עה\"פ ישנם שני פירושים בלרחוק ולקרוב."
        },
        {
          "s": 3,
          "text": "הרד\"ק עצמו מפרש לרחוק מירושלים ולקרוב לה,"
        },
        {
          "s": 4,
          "text": "ולאח\"ז מביא שרז\"ל פירשו דלרחוק הם בעלי תשובה ולקרוב הם צדיקים."
        },
        {
          "s": 5,
          "text": "וכדאיתא בגמרא12,"
        },
        {
          "s": 6,
          "text": "מקום שבעלי תשובה עומדין צדיקים גמורים אין עומדין,"
        },
        {
          "s": 7,
          "text": "שנאמר שלום שלום לרחוק ולקרוב,"
        },
        {
          "s": 8,
          "text": "לרחוק ברישא והדר לקרוב."
        },
        {
          "s": 9,
          "text": "וצריך להבין,"
        },
        {
          "s": 10,
          "text": "דמזה שמקדים בהמאמר פירוש הרד\"ק לפני פירוש הגמרא משמע שלהענין המבואר בהמאמר נוגע יותר פירוש הרד\"ק,"
        },
        {
          "s": 11,
          "text": "וצריך ביאור,"
        },
        {
          "s": 12,
          "text": "דבהמאמר מדבר בענין מעלת הבע\"ת על צדיקים"
        },
        {
          "s": 13,
          "text": "(כדלקמן),"
        },
        {
          "s": 14,
          "text": "ולמה מקדים פירוש הרד\"ק שלרחוק הוא רחוק מירושלים לפני פירוש הגמרא שלרחוק הוא בעלי תשובה."
        }
      ]
    }
  ]
}