{
  "globalIndex": 76,
  "owner": 26,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914115_theRebbe_704__p004",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914115_theRebbe_704__p004",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914115_theRebbe_704",
  "title": "מאמר שובה ישראל תשמ\"א",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ויש להוסיף,"
        },
        {
          "s": 1,
          "text": "שענין הישות"
        },
        {
          "s": 2,
          "text": "(דיש מי שאוהב)"
        },
        {
          "s": 3,
          "text": "כפשוטו נתקן כבר ע\"י עבודת התשובה דחודש אלול,"
        },
        {
          "s": 4,
          "text": "ובכתה את אבי' ואת אמה ירח ימים64"
        },
        {
          "s": 5,
          "text": "דקאי על חודש אלול"
        },
        {
          "s": 6,
          "text": "(כדאיתא בכתבי האריז\"ל65),"
        },
        {
          "s": 7,
          "text": "חודש הרחמים,"
        },
        {
          "s": 8,
          "text": "שאז המלך הוא בשדה66,"
        },
        {
          "s": 9,
          "text": "ובפרט בהימים שאחר ח\"י אלול שמכניס חיות בכל הענינים דחודש אלול67,"
        },
        {
          "s": 10,
          "text": "ובפרט בימי הסליחות שאומרים לך68"
        },
        {
          "s": 11,
          "text": "הוי' הצדקה ולנו בושת הפנים,"
        },
        {
          "s": 12,
          "text": "ביטול דיראת בושת שהיא יראת הרוממות בדרגא הכי עליונה69,"
        },
        {
          "s": 13,
          "text": "ובפרט בערב ראש השנה שענינו הוא"
        },
        {
          "s": 14,
          "text": "(כשמו ערב ראש השנה)"
        },
        {
          "s": 15,
          "text": "הכנה לראש השנה,"
        },
        {
          "s": 16,
          "text": "ובפרט בראש השנה גופא שאז היא העבודה דקבלת עול מלכות שמים,"
        },
        {
          "s": 17,
          "text": "שתמליכוני עליכם70."
        },
        {
          "s": 18,
          "text": "והתשובה דשבת תשובה היא על הישות כמו שהוא בתכלית הדקות."
        },
        {
          "s": 19,
          "text": "ולכן מבאר בלקו\"ת דפירוש שובה ישראל עד הוי' אלקיך"
        },
        {
          "s": 20,
          "text": "[שאומרים בשבת תשובה]"
        },
        {
          "s": 21,
          "text": "הוא שהוי' יהי' רק אלקים וצמצום לגבי עצמות אוא\"ס,"
        },
        {
          "s": 22,
          "text": "כי בכדי לשלול הישות בתכלית הדקות הוא דוקא ע\"י גילוי עצמות אוא\"ס שלמעלה מהוי'."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ולאחרי71 אומרו שובה ישראל גו' כי כשלת בעוניך,"
        },
        {
          "s": 2,
          "text": "שהיא התשובה דסור מרע"
        },
        {
          "s": 3,
          "text": "[כמו שהיא בדרגת ישראל],"
        },
        {
          "s": 4,
          "text": "מוסיף קחו עמכם דברים ושובו אל הוי',"
        },
        {
          "s": 5,
          "text": "אמרו אליו כל תשא עון,"
        },
        {
          "s": 6,
          "text": "שב' תשובות אלו הם התשובה דועשה טוב והתשובה דבקש שלום."
        },
        {
          "s": 7,
          "text": "ויובן זה בהקדים המבואר בלקו\"ת72"
        },
        {
          "s": 8,
          "text": "שג' התשובות דסו\"מ דוע\"ט ודבקש שלום הן בג' הבחינות נר\"נ."
        },
        {
          "s": 9,
          "text": "התשובה דסור מרע"
        },
        {
          "s": 10,
          "text": "(שהיא על חטא ועון)"
        },
        {
          "s": 11,
          "text": "היא בבחי' נפש."
        },
        {
          "s": 12,
          "text": "כי ענין החטא ועון שייך רק בבחי' נפש כמ\"ש73"
        },
        {
          "s": 13,
          "text": "הנפש החוטאת74."
        },
        {
          "s": 14,
          "text": "וגם התשובה"
        },
        {
          "s": 15,
          "text": "(דסור מרע)"
        },
        {
          "s": 16,
          "text": "היא בבחי' נפש,"
        },
        {
          "s": 17,
          "text": "כי התשובה דסו\"מ היא שמקבל עליו קבלת עול מלכות שמים ועול מצוות"
        },
        {
          "s": 18,
          "text": "[שלא למרוד במלכותו ית' ולא לעבור על מצות המלך ח\"ו75],"
        },
        {
          "s": 19,
          "text": "וענין הקב\"ע הוא בבחי' נפש."
        },
        {
          "s": 20,
          "text": "התשובה דועשה טוב,"
        },
        {
          "s": 21,
          "text": "שהיא על העדר התעוררות אהבה ויראה"
        },
        {
          "s": 22,
          "text": "[דההמשכה שע\"י קיום המצוות"
        },
        {
          "s": 23,
          "text": "(ועשה טוב)"
        },
        {
          "s": 24,
          "text": "היא ע\"י אהבה ויראה שהם הגדפין שעל ידם פרחא לעילא76,"
        },
        {
          "s": 25,
          "text": "וגם השלימות דקיום המצוות גופא היא ע\"י האהבה דוקא77],"
        },
        {
          "s": 26,
          "text": "היא בבחי' רוח,"
        },
        {
          "s": 27,
          "text": "דמדות שבלב"
        },
        {
          "s": 28,
          "text": "(אהבה ויראה)"
        },
        {
          "s": 29,
          "text": "הם בחי' רוח."
        },
        {
          "s": 30,
          "text": "והתשובה דבקש שלום,"
        },
        {
          "s": 31,
          "text": "שהיא על העדר עסק התורה בהבנה והשגה,"
        },
        {
          "s": 32,
          "text": "ובפרטיות יותר – התשובה על העדר בהשגת אלקות,"
        },
        {
          "s": 33,
          "text": "ובעיקר על זה שהענין האלקי אינו נרגש במוחו"
        },
        {
          "s": 34,
          "text": "(דגם כשמתבונן בענין אלקי אין הענין נרגש במוחו),"
        },
        {
          "s": 35,
          "text": "היא בבחי' נשמה,"
        },
        {
          "s": 36,
          "text": "נשמת שדי תבינם78,"
        },
        {
          "s": 37,
          "text": "וזהו שבהתשובה דועשה טוב כתיב קחו עמכם דברים ובתשובה דבקש שלום כתיב אמרו אליו,"
        },
        {
          "s": 38,
          "text": "כי דיבור"
        },
        {
          "s": 39,
          "text": "(דברים)"
        },
        {
          "s": 40,
          "text": "שייך למדות"
        },
        {
          "s": 41,
          "text": "(דדיבור הוא ההבל היוצא מהלב79),"
        },
        {
          "s": 42,
          "text": "ולכן הוא בחי' רוח,"
        },
        {
          "s": 43,
          "text": "רוח ממללא80,"
        },
        {
          "s": 44,
          "text": "ואמירה שהיא בלב81,"
        },
        {
          "s": 45,
          "text": "מחשבה,"
        },
        {
          "s": 46,
          "text": "היא82"
        },
        {
          "s": 47,
          "text": "בחי' נשמה."
        },
        {
          "s": 48,
          "text": "וזהו גם מ\"ש אמרו אליו כל,"
        },
        {
          "s": 49,
          "text": "כל מלשון התכללות,"
        },
        {
          "s": 50,
          "text": "כי"
        },
        {
          "s": 51,
          "text": "(בקש)"
        },
        {
          "s": 52,
          "text": "שלום הו\"ע ההתכללות."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ומה שאומר בתשובה זו"
        },
        {
          "s": 2,
          "text": "(דבחי' נשמה)"
        },
        {
          "s": 3,
          "text": "תשא עון,"
        },
        {
          "s": 4,
          "text": "יובן על פי מ\"ש בזהר83"
        },
        {
          "s": 5,
          "text": "(שאומרים במענה לשון)"
        },
        {
          "s": 6,
          "text": "נפשא דילהון קדישא רוחא דילהון קדישא נשמתא דילהון קדש קדשים,"
        },
        {
          "s": 7,
          "text": "דזה שנשמה נקראת קדש קדשים הוא לפי שכוללת בתוכה גם קדשים דנפש ורוח."
        },
        {
          "s": 8,
          "text": "ומכיון שנפש ורוח כמו שכלולים בנשמה הם במדריגה נעלית יותר"
        },
        {
          "s": 9,
          "text": "[וע\"ד דצ\"ח שבאדם שהם למעלה מדצ\"ח,"
        },
        {
          "s": 10,
          "text": "וכמו כן הוא בנוגע בי\"ע שבאצילות,"
        },
        {
          "s": 11,
          "text": "ועד\"ז הוא גם בע\"ס דאצילות כמו שהם גנוזות בלמעלה מאצילות],"
        },
        {
          "s": 12,
          "text": "לכן ע\"י התשובה דנשמה נעשה עילוי גם בנפש ורוח,"
        },
        {
          "s": 13,
          "text": "ולא רק כמו שהם כלולים בנשמה אלא גם כמו שהם במקומם."
        },
        {
          "s": 14,
          "text": "ולכן אומר בהתשובה דבחי' נשמה תשא עון,"
        },
        {
          "s": 15,
          "text": "כי ע\"י תשובה זו,"
        },
        {
          "s": 16,
          "text": "נעשה עילוי גם בהתשובה דסור מרע."
        }
      ]
    }
  ]
}