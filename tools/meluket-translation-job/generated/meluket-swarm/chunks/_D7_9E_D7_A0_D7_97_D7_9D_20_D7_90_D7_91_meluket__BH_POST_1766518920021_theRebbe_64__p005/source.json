{
  "globalIndex": 1061,
  "owner": 11,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518920021_theRebbe_64__p005",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518920021_theRebbe_64__p005",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518920021_theRebbe_64",
  "title": "מאמר ושננתם לבניך תשל\"ח",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וזהו גם הביאור"
        },
        {
          "s": 2,
          "text": "(בדא\"פ)"
        },
        {
          "s": 3,
          "text": "בסדר ב' הפרשיות דק\"ש והשינויים ביניהם."
        },
        {
          "s": 4,
          "text": "דהנה אמרו רז\"ל78"
        },
        {
          "s": 5,
          "text": "(למה)"
        },
        {
          "s": 6,
          "text": "קדמה פרשת שמע לפרשת והי' אם שמוע,"
        },
        {
          "s": 7,
          "text": "והקדימה בסדר הכתובים היא לפי שכן הוא סדר העבודה,"
        },
        {
          "s": 8,
          "text": "וכיון שסדר העבודה הוא שתחילה צ\"ל לימוד התורה,"
        },
        {
          "s": 9,
          "text": "ואח\"כ הלימוד מביא לידי מעשה,"
        },
        {
          "s": 10,
          "text": "לכן בפרשה ראשונה הסדר הוא ושננתם ואח\"כ וקשרתם,"
        },
        {
          "s": 11,
          "text": "שע\"י הלימוד"
        },
        {
          "s": 12,
          "text": "(ושננתם)"
        },
        {
          "s": 13,
          "text": "יודע איך לקיים המצוות"
        },
        {
          "s": 14,
          "text": "(וקשרתם)"
        },
        {
          "s": 15,
          "text": "ומקיימן בשלימותן"
        },
        {
          "s": 16,
          "text": "(וזה נעשה הכנה לקיום המצוות לעת\"ל כמצות רצונך79)."
        },
        {
          "s": 17,
          "text": "וזהו ג\"כ דיוק הלשון \"ושננתם\","
        },
        {
          "s": 18,
          "text": "שיהיו מחודדים בפיך שאם ישאלך אדם דבר הלכה כו',"
        },
        {
          "s": 19,
          "text": "כי,"
        },
        {
          "s": 20,
          "text": "בכדי שהלימוד יביא לידי מעשה,"
        },
        {
          "s": 21,
          "text": "הרי זה רק כאשר הלימוד הוא באופן של לאסוקי שמעתא אליבא דהלכתא80."
        },
        {
          "s": 22,
          "text": "אמנם לאחרי שקדמה פרשת שמע,"
        },
        {
          "s": 23,
          "text": "שכבר ישנו הלימוד"
        },
        {
          "s": 24,
          "text": "(ושננתם)"
        },
        {
          "s": 25,
          "text": "והמעשה הבא על ידו"
        },
        {
          "s": 26,
          "text": "(וקשרתם),"
        },
        {
          "s": 27,
          "text": "אזי באה פרשה שני',"
        },
        {
          "s": 28,
          "text": "שבה הסדר הוא בתחלה וקשרתם גו' ולאח\"ז לימוד התורה."
        },
        {
          "s": 29,
          "text": "וכיון שהלימוד לאסוקי שמעתא אליבא דהלכתא ישנו כבר לפנ\"ז"
        },
        {
          "s": 30,
          "text": "(שזהו מש\"נ בפרשה ראשונה ושננתם גו' וקשרתם),"
        },
        {
          "s": 31,
          "text": "לכן נאמר כאן \"ולמדתם\" סתם,"
        },
        {
          "s": 32,
          "text": "שכולל כל אופני הלימוד"
        },
        {
          "s": 33,
          "text": "(אפילו האופן דדרוש וקבל שכר81)."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ועוד ענין בזה72,"
        },
        {
          "s": 1,
          "text": "דהנה ידוע שלעתיד לבוא יהי' מעשה גדול."
        },
        {
          "s": 2,
          "text": "ולכן הסדר וקשרתם ואח\"כ ולמדתם"
        },
        {
          "s": 3,
          "text": "(מעשה גדול)"
        },
        {
          "s": 4,
          "text": "נאמר בפרשה שני' דוקא,"
        },
        {
          "s": 5,
          "text": "כי,"
        },
        {
          "s": 6,
          "text": "מההחילוקים בין פרשה ראשונה ופרשה שני',"
        },
        {
          "s": 7,
          "text": "שפרשה ראשונה היא בלשון ציווי"
        },
        {
          "s": 8,
          "text": "(בעבר ובהווה),"
        },
        {
          "s": 9,
          "text": "ופרשה שני' היא בלשון ציווי וגם בלשון סיפור"
        },
        {
          "s": 10,
          "text": "(בעתיד),"
        },
        {
          "s": 11,
          "text": "והסיפור הוא שיהי' וסרתם ועבדתם גו'82,"
        },
        {
          "s": 12,
          "text": "ואח\"כ יהי' ענין התשובה,"
        },
        {
          "s": 13,
          "text": "שזהו מ\"ש ושמתם את דברי אלה גו'."
        },
        {
          "s": 14,
          "text": "ולכן נאמר לאח\"ז וקשרתם גו' ולמדתם,"
        },
        {
          "s": 15,
          "text": "כיון שלעת\"ל יהי' מעשה גדול."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "וזהו כללות הענין דהאי יומא דקא גרים83"
        },
        {
          "s": 2,
          "text": "– חמשה עשר באב – שהוא שלימות העלי' לאחרי הירידה דת\"ב,"
        },
        {
          "s": 3,
          "text": "כפי שנמשך בגילוי בזמן שביהמ\"ק הי' קיים,"
        },
        {
          "s": 4,
          "text": "ועד שאפילו בזמן הגלות ישנם כמה מנהגים בט\"ו באב לפי שבזמן ביהמ\"ק הי' יו\"ט גדול מהרבה טעמים שנאמרו ע\"ז בגמרא"
        },
        {
          "s": 5,
          "text": "(כדאיתא בהשלמה לשו\"ע רבינו הזקן84),"
        },
        {
          "s": 6,
          "text": "ובפרי עץ חייםד"
        },
        {
          "s": 7,
          "text": "(המובא בדרושי רבותינו נשיאינו ד\"ה נחמו11)"
        },
        {
          "s": 8,
          "text": "מונה ז' מעלות טובות של אותו יום המכונה ליסוד שהוא ז'."
        },
        {
          "s": 9,
          "text": "וע\"י כ\"ז בא ט\"ו באב למעלתו ומדרגתו כמו שיהי' לעת\"ל,"
        },
        {
          "s": 10,
          "text": "שאז יתגלה גודל העילוי שהי' בהירידה בגלות,"
        },
        {
          "s": 11,
          "text": "ואז יהי' גם מעשה גדול."
        }
      ]
    }
  ]
}