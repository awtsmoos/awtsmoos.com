{
  "globalIndex": 1039,
  "owner": 39,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919915_theRebbe_134__p003",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919915_theRebbe_134__p003",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919915_theRebbe_134",
  "title": "מאמר ועתה ישראל תשכ\"ז",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ויובן זה ע\"פ המבואר בהמאמר ד\"ה זה שבהמשך תער\"ב30,"
        },
        {
          "s": 2,
          "text": "שהחילוק בין אור הממלא לאור הסובב הוא גם בשרשם לפני הצמצום."
        },
        {
          "s": 3,
          "text": "דזה שאור הקו"
        },
        {
          "s": 4,
          "text": "(אור הממלא)"
        },
        {
          "s": 5,
          "text": "מתלבש בכלים הוא"
        },
        {
          "s": 6,
          "text": "(לא רק מפני שהמשכתו היא ע\"י הצמצום,"
        },
        {
          "s": 7,
          "text": "אלא)"
        },
        {
          "s": 8,
          "text": "לפי שגם בשרשם לפני הצמצום הוא אור שבבחינת גבול"
        },
        {
          "s": 9,
          "text": "[דזהו שגם לפני הצמצום יש ע\"ס הגנוזות31],"
        },
        {
          "s": 10,
          "text": "אלא שלפני הצמצום,"
        },
        {
          "s": 11,
          "text": "הגבול שבו הוא בהעלם"
        },
        {
          "s": 12,
          "text": "(ע\"ס גנוזות),"
        },
        {
          "s": 13,
          "text": "ולאחרי שהגבול שבו בא בגילוי ע\"י הצמצום32,"
        },
        {
          "s": 14,
          "text": "ביכלתו להתלבש בכלים33."
        },
        {
          "s": 15,
          "text": "והטעם על זה שאור זה הוא בבחי' גבול,"
        },
        {
          "s": 16,
          "text": "אף שגדר האור הוא שהוא דבוק בהעצם ומעין העצם34,"
        },
        {
          "s": 17,
          "text": "הוא,"
        },
        {
          "s": 18,
          "text": "כי ענינו של אור זה הוא להאיר את העולמות35."
        },
        {
          "s": 19,
          "text": "וזהו החילוק בין אור הבל\"ג"
        },
        {
          "s": 20,
          "text": "(השרש דאור הסובב)"
        },
        {
          "s": 21,
          "text": "והאור שבבחינת גבול"
        },
        {
          "s": 22,
          "text": "(השרש דאור הממלא),"
        },
        {
          "s": 23,
          "text": "שאור הבל\"ג,"
        },
        {
          "s": 24,
          "text": "הוא"
        },
        {
          "s": 25,
          "text": "(לא בכדי להאיר,"
        },
        {
          "s": 26,
          "text": "אלא)"
        },
        {
          "s": 27,
          "text": "גילוי העצם."
        },
        {
          "s": 28,
          "text": "והגם שגם גילוי זה הוא בשביל איזו כוונה"
        },
        {
          "s": 29,
          "text": "(שהרי למעלה אין שייך הכרח ח\"ו)"
        },
        {
          "s": 30,
          "text": "– הכוונה בגילוי אור זה היא שיהי' גילוי כזה שענינו הוא"
        },
        {
          "s": 31,
          "text": "(לא להאיר אלא)"
        },
        {
          "s": 32,
          "text": "גילוי העצם36."
        },
        {
          "s": 33,
          "text": "ולכן,"
        },
        {
          "s": 34,
          "text": "באור זה אין שייך שיהי' בו מדידה והגבלה"
        },
        {
          "s": 35,
          "text": "(עשר ספירות)"
        },
        {
          "s": 36,
          "text": "גם בהעלם,"
        },
        {
          "s": 37,
          "text": "וגם לאחרי שמאיר בכלים ובעולמות אינו בא בהם בהתלבשות ורק מקיף עליהם,"
        },
        {
          "s": 38,
          "text": "סובב."
        },
        {
          "s": 39,
          "text": "והאור שלהאיר העולמות,"
        },
        {
          "s": 40,
          "text": "הגם שגם אור זה הוא דבוק בהעצם ומעין העצם,"
        },
        {
          "s": 41,
          "text": "מ\"מ מכיון שאור זה הוא בשביל העולמות,"
        },
        {
          "s": 42,
          "text": "העולמות תופסים מקום לגבי',"
        },
        {
          "s": 43,
          "text": "ולכן גם כמו שהוא לפני הצמצום,"
        },
        {
          "s": 44,
          "text": "שאז אינו שייך שיאיר בעולמות,"
        },
        {
          "s": 45,
          "text": "יש בו בהעלם מדידה והגבלה"
        },
        {
          "s": 46,
          "text": "(ע\"ס הגנוזות),"
        },
        {
          "s": 47,
          "text": "ולאחרי שמאיר בכלים ובעולמות,"
        },
        {
          "s": 48,
          "text": "הוא מתלבש בהם."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "ומבאר בהמאמר37,"
        },
        {
          "s": 2,
          "text": "דהמשל על זה בכחות הנפש שבאדם"
        },
        {
          "s": 3,
          "text": "(מבשרי אחזה אלוקה38)"
        },
        {
          "s": 4,
          "text": "הוא החילוק בין הרצון לשאר הכחות."
        },
        {
          "s": 5,
          "text": "דזה שכל הכחות מתלבשים באברי הגוף"
        },
        {
          "s": 6,
          "text": "(דוגמת אור הממלא שמתלבש בעולמות)"
        },
        {
          "s": 7,
          "text": "והרצון הוא מקיף את כל אברי הגוף בשוה"
        },
        {
          "s": 8,
          "text": "(דוגמת הסובב),"
        },
        {
          "s": 9,
          "text": "הוא,"
        },
        {
          "s": 10,
          "text": "כי כל הכחות,"
        },
        {
          "s": 11,
          "text": "גם לפני שמתלבשים באברי הגוף39,"
        },
        {
          "s": 12,
          "text": "הם מציאות"
        },
        {
          "s": 13,
          "text": "(שמחוץ להנפש),"
        },
        {
          "s": 14,
          "text": "ולכן,"
        },
        {
          "s": 15,
          "text": "כשנמשכים באברי הגוף,"
        },
        {
          "s": 16,
          "text": "הם מתלבשים בהם."
        },
        {
          "s": 17,
          "text": "והרצון,"
        },
        {
          "s": 18,
          "text": "אינו מציאות לעצמו וכל ענינו הוא הטיית והמשכת הנפש,"
        },
        {
          "s": 19,
          "text": "ולכן,"
        },
        {
          "s": 20,
          "text": "גם כשנמשך באברי הגוף אינו מתלבש בהם ורק מקיף עליהם."
        },
        {
          "s": 21,
          "text": "וממשיך בהמאמר40,"
        },
        {
          "s": 22,
          "text": "שעד\"ז הוא בהנמשל למעלה,"
        },
        {
          "s": 23,
          "text": "הוא החילוק שבין תורה למצוות."
        },
        {
          "s": 24,
          "text": "דתורה,"
        },
        {
          "s": 25,
          "text": "שהיא חכמתו של הקב\"ה"
        },
        {
          "s": 26,
          "text": "(מציאות כביכול),"
        },
        {
          "s": 27,
          "text": "המשכתה למטה באדם הלומדה היא בפנימיות,"
        },
        {
          "s": 28,
          "text": "ותורתך בתוך מעי41."
        },
        {
          "s": 29,
          "text": "והמצוות שהם רצון העליון,"
        },
        {
          "s": 30,
          "text": "גילוי העצמות,"
        },
        {
          "s": 31,
          "text": "המשכתם למטה באדם המקיים את המצוות היא באופן דמקיף והעלם,"
        },
        {
          "s": 32,
          "text": "שהאור דהמצוה אינו נרגש בהאדם42."
        },
        {
          "s": 33,
          "text": "דזה שע\"י קיום המצוות נעשה זיכוך בהאדם,"
        },
        {
          "s": 34,
          "text": "שלכן מצוה גוררת מצוה43,"
        },
        {
          "s": 35,
          "text": "הוא רק פעולת האור דהמצוה,"
        },
        {
          "s": 36,
          "text": "אבל האור עצמו אינו נרגש בו44."
        },
        {
          "s": 37,
          "text": "בדוגמת הרצון שבנפש האדם,"
        },
        {
          "s": 38,
          "text": "דהגם שהרצון פועל באברי הגוף,"
        },
        {
          "s": 39,
          "text": "הרצון עצמו אינו מתגלה בהם."
        },
        {
          "s": 40,
          "text": "וממשיך בהמאמר"
        },
        {
          "s": 41,
          "text": "[בסיומו,"
        },
        {
          "s": 42,
          "text": "בהחלק שמבאר הפסוק ועתה ישראל מה הוי' אלקיך שואל מעמך,"
        },
        {
          "s": 43,
          "text": "אל תקרי מה אלא מאה],"
        },
        {
          "s": 44,
          "text": "דבכדי שיתגלה הרצון דהמצוות עצמו,"
        },
        {
          "s": 45,
          "text": "הוא ע\"י ברכת המצוות."
        },
        {
          "s": 46,
          "text": "וזהו\"ע חייב אדם לברך מאה ברכות בכל יום,"
        },
        {
          "s": 47,
          "text": "מאה הוא בכתר"
        },
        {
          "s": 48,
          "text": "(רצון),"
        },
        {
          "s": 49,
          "text": "וע\"י המאה ברכות,"
        },
        {
          "s": 50,
          "text": "ובפרט ע\"י ברכת המצוות,"
        },
        {
          "s": 51,
          "text": "נמשך הרצון בגילוי."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וצריך להבין,"
        },
        {
          "s": 2,
          "text": "דלכאורה,"
        },
        {
          "s": 3,
          "text": "הרי הענין דמקיף ופנימי המבואר בהמאמר,"
        },
        {
          "s": 4,
          "text": "שעל זה בא המשל דרצון ושכל,"
        },
        {
          "s": 5,
          "text": "הוא אור הממלא ואור הסובב,"
        },
        {
          "s": 6,
          "text": "ומה נוגע כאן לבאר החילוק בין תורה ומצוות."
        },
        {
          "s": 7,
          "text": "ויש לומר הביאור בזה בהקדים דזה שהבריאה היא בשביל התורה ובשביל ישראל45,"
        },
        {
          "s": 8,
          "text": "הכוונה בזה היא לא רק לבריאת העולם אלא גם לכל הגילויים,"
        },
        {
          "s": 9,
          "text": "גם להגילויים שלפני הצמצום,"
        },
        {
          "s": 10,
          "text": "ואפילו להגילוי דאור הבל\"ג שהוא גילוי העצם."
        },
        {
          "s": 11,
          "text": "שהרי הכוונה בכל הגילויים היא בכדי שעל ידם יהי' אח\"כ בריאת העולם"
        },
        {
          "s": 12,
          "text": "[וגם הגילוי שאינו להאיר את העולמות אלא גילוי העצם הוא לפי שכך עלה ברצונו ית' שהאור השייך לעולמות יומשך מהאור שלמעלה משייכות לעולמות46],"
        },
        {
          "s": 13,
          "text": "ומכיון שבריאת העולם היא בשביל התורה ובשביל ישראל,"
        },
        {
          "s": 14,
          "text": "נמצא שגם כל הגילויים הם בשביל התורה ובשביל ישראל."
        }
      ]
    }
  ]
}