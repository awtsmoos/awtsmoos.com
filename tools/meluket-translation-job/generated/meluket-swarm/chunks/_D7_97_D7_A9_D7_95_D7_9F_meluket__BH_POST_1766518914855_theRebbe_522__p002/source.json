{
  "globalIndex": 183,
  "owner": 33,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914855_theRebbe_522__p002",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914855_theRebbe_522__p002",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518914855_theRebbe_522",
  "title": "מאמר ואשה אחת תשמ\"ו",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "וביאור הענין בפרטיות יותר,"
        },
        {
          "s": 2,
          "text": "יובן ע\"פ מ\"ש בלקו\"ת22"
        },
        {
          "s": 3,
          "text": "דענין את ובנייך תחיי בנותר הוא ע\"ד מה שארז\"ל23"
        },
        {
          "s": 4,
          "text": "עה\"פ24"
        },
        {
          "s": 5,
          "text": "לשארית נחלתו,"
        },
        {
          "s": 6,
          "text": "למי שמשים עצמו כשיריים."
        },
        {
          "s": 7,
          "text": "ומבאר שם25,"
        },
        {
          "s": 8,
          "text": "דשיריים הם המקיפים שלמעלה מהשתלשלות."
        },
        {
          "s": 9,
          "text": "דהאור שנמשך בעולמות"
        },
        {
          "s": 10,
          "text": "(בפנימיות)"
        },
        {
          "s": 11,
          "text": "הוא הארה בלבד,"
        },
        {
          "s": 12,
          "text": "ועיקר האור"
        },
        {
          "s": 13,
          "text": "(המקיפים)"
        },
        {
          "s": 14,
          "text": "נשאר למעלה,"
        },
        {
          "s": 15,
          "text": "שיריים."
        },
        {
          "s": 16,
          "text": "ובכדי להמשיך המקיפים,"
        },
        {
          "s": 17,
          "text": "הוא ע\"י הביטול."
        },
        {
          "s": 18,
          "text": "וזהו למי שמשים עצמו כשיריים,"
        },
        {
          "s": 19,
          "text": "דע\"י שמשים עצמו כשיריים כפשוטו,"
        },
        {
          "s": 20,
          "text": "ביטול,"
        },
        {
          "s": 21,
          "text": "עי\"ז דוקא הוא ממשיך המקיפים,"
        },
        {
          "s": 22,
          "text": "שיריים."
        },
        {
          "s": 23,
          "text": "דכאשר עבודתו היא בבחינת מציאות,"
        },
        {
          "s": 24,
          "text": "גם כשהעבודה היא בתכלית העילוי,"
        },
        {
          "s": 25,
          "text": "ההמשכה שעל ידה היא אור השייך להשתלשלות"
        },
        {
          "s": 26,
          "text": "(מציאות),"
        },
        {
          "s": 27,
          "text": "ובכדי להמשיך השיריים דלמעלה"
        },
        {
          "s": 28,
          "text": "(שלמעלה מבחינת מציאות)"
        },
        {
          "s": 29,
          "text": "הוא דוקא ע\"י הביטול."
        },
        {
          "s": 30,
          "text": "[וכמבואר גם בתו\"א26"
        },
        {
          "s": 31,
          "text": "עה\"פ27"
        },
        {
          "s": 32,
          "text": "השמים כסאי והארץ הדום רגלי אי זה בית גו' ואל זה אביט אל עני ונכה רוח,"
        },
        {
          "s": 33,
          "text": "דההמשכה שע\"י שמים וארץ שהם תורה"
        },
        {
          "s": 34,
          "text": "(שמים)"
        },
        {
          "s": 35,
          "text": "ומצוות"
        },
        {
          "s": 36,
          "text": "(ארץ)"
        },
        {
          "s": 37,
          "text": "הוא אור פנימי,"
        },
        {
          "s": 38,
          "text": "ובכדי להמשיך המקיפים,"
        },
        {
          "s": 39,
          "text": "אי זה בית גו',"
        },
        {
          "s": 40,
          "text": "דבית הוא מקיף"
        },
        {
          "s": 41,
          "text": "(ובמקיפים עצמם מקיף הרחוק),"
        },
        {
          "s": 42,
          "text": "הוא ע\"י הביטול,"
        },
        {
          "s": 43,
          "text": "עני ונכה רוח]."
        },
        {
          "s": 44,
          "text": "ומבאר בלקו\"ת שם,"
        },
        {
          "s": 45,
          "text": "דזהו מה שארז\"ל28"
        },
        {
          "s": 46,
          "text": "עה\"פ ואת ובנייך תחיי בנותר עד שיחיו המתים,"
        },
        {
          "s": 47,
          "text": "דנותר הוא מה שנשאר למעלה בבחינת מקיף,"
        },
        {
          "s": 48,
          "text": "ובמקיפים עצמם הוא מקיף הרחוק,"
        },
        {
          "s": 49,
          "text": "עתיק"
        },
        {
          "s": 50,
          "text": "(דאריך הוא מקיף הקרוב ועתיק הוא מקיף הרחוק29),"
        },
        {
          "s": 51,
          "text": "וזהו תחיי בנותר עד שיחיו המתים,"
        },
        {
          "s": 52,
          "text": "דתחיית המתים הוא ע\"י טלא דנטיף מעתיקא30."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "וזוהי המעלה דענין תחיי בנותר שבא על ידי המרירות מזה שהוא כלי ריקן"
        },
        {
          "s": 1,
          "text": "(פירוש השני בכלים ריקים אל תמעיטי)"
        },
        {
          "s": 2,
          "text": "על הענין דתחיי בנותר שבא על ידי שעוסק בתורה ומצוות הגם שאין לו אהוי\"ר"
        },
        {
          "s": 3,
          "text": "(פירוש הראשון בכלים ריקים אל תמעיטי),"
        },
        {
          "s": 4,
          "text": "כי היתרון"
        },
        {
          "s": 5,
          "text": "(נותר)"
        },
        {
          "s": 6,
          "text": "בזה שעוסק בתומ\"צ גם כשאין לו אהבה ויראה הוא זה שאז קיום התומ\"צ שלו קשור עם כח המסירת נפש,"
        },
        {
          "s": 7,
          "text": "דענין המסירת נפש הוא מצד עצם הנשמה שלמעלה מכחות הגלויים"
        },
        {
          "s": 8,
          "text": "(אהוי\"ר)."
        },
        {
          "s": 9,
          "text": "אבל מ\"מ,"
        },
        {
          "s": 10,
          "text": "כיון שע\"י עסק התומ\"צ"
        },
        {
          "s": 11,
          "text": "(גם כשקיום התומ\"צ הוא ע\"י שזוכר ענין מסירת נפשו לה')"
        },
        {
          "s": 12,
          "text": "אינו מתבטל ממציאותו"
        },
        {
          "s": 13,
          "text": "[שהרי זה שהוא מקיים תומ\"צ תלוי ברצונו,"
        },
        {
          "s": 14,
          "text": "רצון"
        },
        {
          "s": 15,
          "text": "(מציאות)"
        },
        {
          "s": 16,
          "text": "האדם31],"
        },
        {
          "s": 17,
          "text": "הגילוי דעצם הנשמה שבזה הוא רק כמו ששייכת לכחות הגלויים"
        },
        {
          "s": 18,
          "text": "[דע\"י שזוכר ענין מסירת נפשו לה' שמצד עצם הנשמה,"
        },
        {
          "s": 19,
          "text": "הרצון שלו בתומ\"צ הוא בתוקף גדול]."
        },
        {
          "s": 20,
          "text": "ולכן,"
        },
        {
          "s": 21,
          "text": "גם ההמשכה שנמשכת מלמעלה עי\"ז,"
        },
        {
          "s": 22,
          "text": "הוא האור שלמעלה מהשתלשלות כמו שהוא שייך להשתלשלות,"
        },
        {
          "s": 23,
          "text": "דבכללות הוא מקיף הקרוב,"
        },
        {
          "s": 24,
          "text": "אריך."
        },
        {
          "s": 25,
          "text": "והיתרון שנעשה על ידי ההרגש והמרירות מזה שהוא כלי ריקן,"
        },
        {
          "s": 26,
          "text": "מכיון שעי\"ז הוא מתבטל ממציאותו,"
        },
        {
          "s": 27,
          "text": "נמשך עי\"ז הגילוי דעצם הנשמה כמו שהיא למעלה משייכות לכחות הגלויים."
        },
        {
          "s": 28,
          "text": "ועד\"ז הוא בההמשכה שנמשכת עי\"ז מלמעלה,"
        },
        {
          "s": 29,
          "text": "דע\"י שמרגיש בעצמו שהוא כלי ריקן שאין בו שום מעלה והוא כמו שיריים בעיניו"
        },
        {
          "s": 30,
          "text": "(דבר המיותר,"
        },
        {
          "s": 31,
          "text": "נותר),"
        },
        {
          "s": 32,
          "text": "הענין דתחיי בנותר שעי\"ז הוא המשכת מקיף הרחוק,"
        },
        {
          "s": 33,
          "text": "עתיק32."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וצריך להבין מ\"ש את ובנייך תחיי בנותר,"
        },
        {
          "s": 2,
          "text": "שגם האהבה והיראה דהנשמה"
        },
        {
          "s": 3,
          "text": "(בנייך)"
        },
        {
          "s": 4,
          "text": "יחיו בנותר,"
        },
        {
          "s": 5,
          "text": "דלכאורה,"
        },
        {
          "s": 6,
          "text": "מכיון שנותר הוא מקיף,"
        },
        {
          "s": 7,
          "text": "ובפרט להפירוש שנותר הוא מקיף הרחוק,"
        },
        {
          "s": 8,
          "text": "איך שייך שיומשך ממנו חיות לכחות הפנימיים"
        },
        {
          "s": 9,
          "text": "(אהבה ויראה)."
        },
        {
          "s": 10,
          "text": "ויש לבאר זה ע\"פ מ\"ש אדמו\"ר"
        },
        {
          "s": 11,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 12,
          "text": "נ\"ע בעל יום ההולדת במאמרו ד\"ה כי33"
        },
        {
          "s": 13,
          "text": "המצוה הזאת אשר אנכי מצוך היום לא נפלאת היא ממך ולא רחוקה היא34"
        },
        {
          "s": 14,
          "text": "(בספר המאמרים שלו שמכינים עתה לדפוס35),"
        },
        {
          "s": 15,
          "text": "דשני הלשונות נפלאת ורחוקה הם בעתיק ואריך."
        },
        {
          "s": 16,
          "text": "דפלא"
        },
        {
          "s": 17,
          "text": "[שהוא לשון הפרשה והבדלה]"
        },
        {
          "s": 18,
          "text": "הוא בעתיק,"
        },
        {
          "s": 19,
          "text": "שנעתק ונבדל מהשתלשלות,"
        },
        {
          "s": 20,
          "text": "וריחוק הוא באריך,"
        },
        {
          "s": 21,
          "text": "דלשון ריחוק מורה שיש לו שייכות להדבר שהוא רחוק ממנו,"
        },
        {
          "s": 22,
          "text": "וכמו אמרתי אחכמה והיא רחוקה ממני36,"
        },
        {
          "s": 23,
          "text": "דזה שאמרתי אחכמה הוא לפי שהחכמה שייכת אליו,"
        },
        {
          "s": 24,
          "text": "ורק שהיא רחוקה ממנו37."
        },
        {
          "s": 25,
          "text": "ומבאר שם,"
        },
        {
          "s": 26,
          "text": "דמ\"ש כי המצוה הזאת גו' לא נפלאת היא ממך גו',"
        },
        {
          "s": 27,
          "text": "ממך דוקא,"
        },
        {
          "s": 28,
          "text": "הוא,"
        },
        {
          "s": 29,
          "text": "כי כיון שהמצוות הם רצון העליון,"
        },
        {
          "s": 30,
          "text": "רצון שלמעלה מטעם,"
        },
        {
          "s": 31,
          "text": "הם בבחינת פלא וריחוק38."
        },
        {
          "s": 32,
          "text": "ומכ\"ש מצות התשובה"
        },
        {
          "s": 33,
          "text": "(דהמצוה הזאת קאי על מצות התשובה,"
        },
        {
          "s": 34,
          "text": "כמ\"ש הרמב\"ן וכמה מפרשים39)"
        },
        {
          "s": 35,
          "text": "שהיא למעלה מהרצון דמצוות"
        },
        {
          "s": 36,
          "text": "[וכמבואר בכ\"מ40,"
        },
        {
          "s": 37,
          "text": "דזה שע\"י התשובה מתמלאים כל הפגמים הוא לפי שתשובה מגעת באוא\"ס בעל הרצון"
        },
        {
          "s": 38,
          "text": "(שלמעלה מהרצון דמצוות),"
        },
        {
          "s": 39,
          "text": "ועד שהיא מגעת בהעצמות41,"
        },
        {
          "s": 40,
          "text": "דזהו מ\"ש כי המצוה הזאת אשר אנכי מצוך,"
        },
        {
          "s": 41,
          "text": "אנכי מי שאנכי42]"
        },
        {
          "s": 42,
          "text": "שהיא בודאי בבחינת פלא וריחוק."
        },
        {
          "s": 43,
          "text": "דתשובה תתאה היא בבחינת ריחוק ותשובה עילאה היא בבחינת פלא."
        },
        {
          "s": 44,
          "text": "כי תשובה תתאה היא במקיף דחי',"
        },
        {
          "s": 45,
          "text": "מקיף הקרוב."
        },
        {
          "s": 46,
          "text": "וגם ההמשכה מלמעלה הנמשכת ע\"י תשובה תתאה היא המקיף דאור ישר שיש לו שייכות להפנימי,"
        },
        {
          "s": 47,
          "text": "דבכללות הוא אריך."
        },
        {
          "s": 48,
          "text": "ותשובה עילאה היא במקיף דיחידה,"
        },
        {
          "s": 49,
          "text": "מקיף הרחוק."
        },
        {
          "s": 50,
          "text": "וגם ההמשכה מלמעלה שנמשכת עי\"ז היא המקיף דאור חוזר שלמעלה משייכות לפנימיות,"
        },
        {
          "s": 51,
          "text": "דבכללות הוא עתיק."
        },
        {
          "s": 52,
          "text": "ומ\"ש לא נפלאת היא ממך ולא רחוקה היא,"
        },
        {
          "s": 53,
          "text": "הוא ממך דוקא,"
        },
        {
          "s": 54,
          "text": "מנשמות ישראל."
        },
        {
          "s": 55,
          "text": "דנש\"י יש בהם הכל,"
        },
        {
          "s": 56,
          "text": "וגם מלמעלה נותנים להם הכל,"
        },
        {
          "s": 57,
          "text": "ולכן אין זה נפלא ורחוק מהם."
        }
      ]
    }
  ]
}