{
  "globalIndex": 64,
  "owner": 14,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914059_theRebbe_310__p002",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914059_theRebbe_310__p002",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914059_theRebbe_310",
  "title": "מאמר שובה ישראל תשל\"ז",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש לבאר השייכות דתשובה לבחינת עד"
        },
        {
          "s": 1,
          "text": "(שובה ישראל עד),"
        },
        {
          "s": 2,
          "text": "כי בתשובה שני ענינים."
        },
        {
          "s": 3,
          "text": "זה שע\"י התשובה הוא מתקן וממלא את זה שהי' צריך לעשות,"
        },
        {
          "s": 4,
          "text": "דזה הוא"
        },
        {
          "s": 5,
          "text": "(בעיקר)"
        },
        {
          "s": 6,
          "text": "בהבחינות דהשתלשלות"
        },
        {
          "s": 7,
          "text": "(כי אדם הוא ציור מוחין ומדות),"
        },
        {
          "s": 8,
          "text": "עד ועד בכלל."
        },
        {
          "s": 9,
          "text": "וזה שבכדי שיוכל לתקן ולמלאות ענינים אלו,"
        },
        {
          "s": 10,
          "text": "צריך להגיע לבחי' שלמעלה מהשתלשלות"
        },
        {
          "s": 11,
          "text": "(לא אדם שבאדם9),"
        },
        {
          "s": 12,
          "text": "עד ולא עד בכלל."
        },
        {
          "s": 13,
          "text": "ויש לומר,"
        },
        {
          "s": 14,
          "text": "שזהו גם מה שממשיך בכתוב"
        },
        {
          "s": 15,
          "text": "(לאחרי אמרו שובה ישראל עד)"
        },
        {
          "s": 16,
          "text": "הוי' אלקיך,"
        },
        {
          "s": 17,
          "text": "כי הוי' ואלקים הם סובב וממלא,"
        },
        {
          "s": 18,
          "text": "וע\"י שובה ישראל עד,"
        },
        {
          "s": 19,
          "text": "שהתשובה שלו היא באופן שמעורר בחינת לא אדם שבו"
        },
        {
          "s": 20,
          "text": "(עד ולא עד בכלל)"
        },
        {
          "s": 21,
          "text": "וממשיך זה בגילוי בציור אדם שבו,"
        },
        {
          "s": 22,
          "text": "עי\"ז יהי' הוי' אלקיך כחך וחיותך,"
        },
        {
          "s": 23,
          "text": "שאור הסובב שלמעלה מהשתלשלות יאיר בו בגילוי בפנימיות."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה נתבאר לעיל10,"
        },
        {
          "s": 2,
          "text": "דבפירוש שובה ישראל עד הוי' אלקיך,"
        },
        {
          "s": 3,
          "text": "שהתשובה צריכה להיות עד שהוי' יהי' אלקיך,"
        },
        {
          "s": 4,
          "text": "שני ענינים,"
        },
        {
          "s": 5,
          "text": "שהוי' יהי' אלקיך כחך וחיותך,"
        },
        {
          "s": 6,
          "text": "ושהוי' יהי' רק בחי' אלקים וצמצום לגבי אוא\"ס שלמעלה מהוי'."
        },
        {
          "s": 7,
          "text": "ויש לומר,"
        },
        {
          "s": 8,
          "text": "דשני הענינים שב"
        },
        {
          "s": 9,
          "text": "(שובה ישראל)"
        },
        {
          "s": 10,
          "text": "עד,"
        },
        {
          "s": 11,
          "text": "עד ועד בכלל ועד ולא עד בכלל,"
        },
        {
          "s": 12,
          "text": "הם בהתאם לשני הפירושים"
        },
        {
          "s": 13,
          "text": "(ענינים)"
        },
        {
          "s": 14,
          "text": "בהוי' אלקיך."
        },
        {
          "s": 15,
          "text": "והענין הוא,"
        },
        {
          "s": 16,
          "text": "דזה שנתבאר לעיל ששני הענינים שבעד הם השתלשלות ולמעלה מהשתלשלות,"
        },
        {
          "s": 17,
          "text": "הוא בכללות,"
        },
        {
          "s": 18,
          "text": "אבל בפרטיות,"
        },
        {
          "s": 19,
          "text": "גם בלמעלה מהשתלשלות ישנם שני הענינים שבעד."
        },
        {
          "s": 20,
          "text": "כמ\"ש בלקו\"ת11,"
        },
        {
          "s": 21,
          "text": "דשני הענינים שבעד הם בכתר"
        },
        {
          "s": 22,
          "text": "[דכתר,"
        },
        {
          "s": 23,
          "text": "בכלל,"
        },
        {
          "s": 24,
          "text": "הוא למעלה מהשתלשלות]."
        },
        {
          "s": 25,
          "text": "עד ועד בכלל הוא באריך,"
        },
        {
          "s": 26,
          "text": "שרש הנאצלים."
        },
        {
          "s": 27,
          "text": "ועד ולא עד בכלל הוא בעתיק,"
        },
        {
          "s": 28,
          "text": "בחינה תחתונה שבמאציל."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ויובן זה ע\"פ הידוע12,"
        },
        {
          "s": 1,
          "text": "שע\"י ההשגה באור הממלא שמתלבש בעולמות,"
        },
        {
          "s": 2,
          "text": "שהוא הארה בלבד"
        },
        {
          "s": 3,
          "text": "(כדמוכח מזה גופא שהוא בהתלבשות),"
        },
        {
          "s": 4,
          "text": "באים לידי ידיעה שישנו אור שהוא מופלא מעולמות,"
        },
        {
          "s": 5,
          "text": "שממנו נמשכת ההארה שבהתלבשות,"
        },
        {
          "s": 6,
          "text": "ומכיון שע\"י ההשגה בההארה המתלבשת בעולמות באים להידיעה דאור המופלא מעולמות,"
        },
        {
          "s": 7,
          "text": "אף שהידיעה באור זה היא רק ידיעת השלילה,"
        },
        {
          "s": 8,
          "text": "שיודע שאור זה הוא מופלא מהעולמות ומההארה המתלבשת בהם,"
        },
        {
          "s": 9,
          "text": "מ\"מ,"
        },
        {
          "s": 10,
          "text": "מכיון שגם ידיעת השלילה היא ידיעה והשגה13,"
        },
        {
          "s": 11,
          "text": "לכן גם האור המופלא מעולמות הוא בכלל עד ועד בכלל."
        },
        {
          "s": 12,
          "text": "[ועד\"ז הוא בעבודת האדם,"
        },
        {
          "s": 13,
          "text": "דמכיון שהשכל עצמו מכריח אַז מיט שכל אַליין קען מען ניט דורכגיין,"
        },
        {
          "s": 14,
          "text": "ובכדי שתהי' העבודה כדבעי,"
        },
        {
          "s": 15,
          "text": "הוא דוקא ע\"י קבלת עול שלמעלה מהשכל,"
        },
        {
          "s": 16,
          "text": "לכן,"
        },
        {
          "s": 17,
          "text": "גם הקבלת עול"
        },
        {
          "s": 18,
          "text": "(הבאה מזה שהשכל מכריח)"
        },
        {
          "s": 19,
          "text": "היא בכלל עד ועד בכלל]."
        },
        {
          "s": 20,
          "text": "וענין עד ולא עד בכלל הוא בהאור שאין שייך בו גם ידיעת השלילה14"
        },
        {
          "s": 21,
          "text": "[ובעבודת האדם – בהקבלת עול שמצד הנשמה]."
        }
      ]
    }
  ]
}