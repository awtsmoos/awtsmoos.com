{
  "globalIndex": 548,
  "owner": 48,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916877_theRebbe_274__p007",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916877_theRebbe_274__p007",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916877_theRebbe_274",
  "title": "מאמר באתי לגני תשל\"ב",
  "part": 7,
  "sections": [
    {
      "v": 18,
      "items": [
        {
          "s": 0,
          "text": "וממשיך בהמאמר79,"
        },
        {
          "s": 1,
          "text": "דזה שנאמר ועמך לא חפצתי"
        },
        {
          "s": 2,
          "text": "(חפצתי דייקא),"
        },
        {
          "s": 3,
          "text": "הוא כי לשון רצון הוא"
        },
        {
          "s": 4,
          "text": "(גם)"
        },
        {
          "s": 5,
          "text": "בחיצוניות הרצון,"
        },
        {
          "s": 6,
          "text": "ועד שגם רצון שבא ע\"י כפי' נקרא רצון,"
        },
        {
          "s": 7,
          "text": "כמו כופין80"
        },
        {
          "s": 8,
          "text": "אותו עד שיאמר רוצה אני81,"
        },
        {
          "s": 9,
          "text": "וחפץ הוא פנימיות הרצון."
        },
        {
          "s": 10,
          "text": "וזהו ועמך לא חפצתי,"
        },
        {
          "s": 11,
          "text": "כי רצון"
        },
        {
          "s": 12,
          "text": "(חיצוניות הרצון)"
        },
        {
          "s": 13,
          "text": "יש לו גם בהגילויים דסדר ההשתלשלות,"
        },
        {
          "s": 14,
          "text": "אלא שהחפץ שלו"
        },
        {
          "s": 15,
          "text": "(פנימיות הרצון)"
        },
        {
          "s": 16,
          "text": "הוא בעצמות אוא\"ס."
        },
        {
          "s": 17,
          "text": "ויש לומר,"
        },
        {
          "s": 18,
          "text": "דזה שיש לו רצון בהגילויים דסדר ההשתלשלות הוא,"
        },
        {
          "s": 19,
          "text": "כי כמו שמלמעלה למטה,"
        },
        {
          "s": 20,
          "text": "ההתהוות דעוה\"ז התחתון מהעצמות היא ע\"י אמצעות הגילויים,"
        },
        {
          "s": 21,
          "text": "כולל גם הגילויים דהשתלשלות,"
        },
        {
          "s": 22,
          "text": "עד\"ז הוא בהעלי' מלמטה למעלה,"
        },
        {
          "s": 23,
          "text": "שהעלי' וההתכללות בעצמות אוא\"ס היא ע\"י הגילויים דהשתלשלות,"
        },
        {
          "s": 24,
          "text": "ולכן הוא רוצה בהם."
        },
        {
          "s": 25,
          "text": "אלא שהרצון בהם הוא חיצוניות הרצון,"
        },
        {
          "s": 26,
          "text": "בכדי שעל ידם יגיע לעצמות אוא\"ס."
        },
        {
          "s": 27,
          "text": "ולהעיר,"
        },
        {
          "s": 28,
          "text": "דבכ\"מ82"
        },
        {
          "s": 29,
          "text": "מבואר בפירוש הכתוב83"
        },
        {
          "s": 30,
          "text": "כי חסד חפצתי ולא זבח,"
        },
        {
          "s": 31,
          "text": "שהחפץ,"
        },
        {
          "s": 32,
          "text": "פנימיות הרצון,"
        },
        {
          "s": 33,
          "text": "הוא שיהי' חסד,"
        },
        {
          "s": 34,
          "text": "המשכה למטה,"
        },
        {
          "s": 35,
          "text": "והרצון בזבח"
        },
        {
          "s": 36,
          "text": "(קרבנות),"
        },
        {
          "s": 37,
          "text": "העלאה מלמטה למעלה,"
        },
        {
          "s": 38,
          "text": "הוא רק חיצוניות הרצון בשביל ההמשכה שנעשית ע\"י ההעלאה."
        },
        {
          "s": 39,
          "text": "ובמאמר זה משמע,"
        },
        {
          "s": 40,
          "text": "שהחפץ,"
        },
        {
          "s": 41,
          "text": "פנימיות הרצון"
        },
        {
          "s": 42,
          "text": "[דישראל,"
        },
        {
          "s": 43,
          "text": "ומזה מובן שכ\"ה גם למעלה,"
        },
        {
          "s": 44,
          "text": "כי ישראל הם בניו דהקב\"ה,"
        },
        {
          "s": 45,
          "text": "ורצון הבן הוא רצון האב],"
        },
        {
          "s": 46,
          "text": "הוא גם בההעלאה מלמטה למעלה."
        }
      ]
    },
    {
      "v": 19,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ב)"
        },
        {
          "s": 2,
          "text": "וממשיך בהמאמר79,"
        },
        {
          "s": 3,
          "text": "דהגם שהאהבה דמי לי בשמים ועמך לא חפצתי היא"
        },
        {
          "s": 4,
          "text": "(בעיקר)"
        },
        {
          "s": 5,
          "text": "בנפש האלקית,"
        },
        {
          "s": 6,
          "text": "מ\"מ,"
        },
        {
          "s": 7,
          "text": "ע\"י אריכות ההתבוננות,"
        },
        {
          "s": 8,
          "text": "גם נפש הבהמית תסכים לזה."
        },
        {
          "s": 9,
          "text": "דזהו שלאחרי שמע ישראל גו' אחד נאמר ואהבת את ה' אלקיך בכל לבבך בשני יצריך84,"
        },
        {
          "s": 10,
          "text": "שע\"י ההתבוננות דנפש האלקית"
        },
        {
          "s": 11,
          "text": "(שמע ישראל)"
        },
        {
          "s": 12,
          "text": "בענין אחד,"
        },
        {
          "s": 13,
          "text": "אנת הוא חד ולא בחושבן,"
        },
        {
          "s": 14,
          "text": "גם נפש הבהמית באה לאהבה זו."
        },
        {
          "s": 15,
          "text": "וכמו שמבאר אדמו\"ר"
        },
        {
          "s": 16,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 17,
          "text": "נ\"ע בהמשך תרס\"ו85,"
        },
        {
          "s": 18,
          "text": "דע\"י שנפש האלקית מבינה ומשיגה הענין דהוי' אחד,"
        },
        {
          "s": 19,
          "text": "פועל זה גם על נפש הבהמית שתבין עכ\"פ שבהכרח לומר כן,"
        },
        {
          "s": 20,
          "text": "אף שהענין עצמו אינו מושג אצלה."
        },
        {
          "s": 21,
          "text": "ומוסיף"
        },
        {
          "s": 22,
          "text": "(בהמשך תרס\"ו)"
        },
        {
          "s": 23,
          "text": "עוד ענין,"
        },
        {
          "s": 24,
          "text": "דכיון שנפש האלקית מלובשת בנפש הבהמית,"
        },
        {
          "s": 25,
          "text": "לכן,"
        },
        {
          "s": 26,
          "text": "בהרשפי אש דנפש האלקית נשרף ונכלה גם נפש הבהמית."
        },
        {
          "s": 27,
          "text": "ולהוסיף,"
        },
        {
          "s": 28,
          "text": "דע\"י שנפש הבהמית נכללת בהרשפי אש דנפש האלקית,"
        },
        {
          "s": 29,
          "text": "נמשך גילוי נעלה יותר מהגילוי שנמשך ע\"י האהבה דנפש האלקית."
        },
        {
          "s": 30,
          "text": "וכמבואר בהמשך ההילולא שע\"י העבודה דאתכפיא ואתהפכא נמשך האור שבכולהו עלמין בשוה,"
        },
        {
          "s": 31,
          "text": "אור שלמעלה משייכות לעולמות."
        },
        {
          "s": 32,
          "text": "[ולהעיר,"
        },
        {
          "s": 33,
          "text": "דענין זה מבאר בההמשך גם בסיום וחותם פרק שני,"
        },
        {
          "s": 34,
          "text": "בהמשך להמבואר שם שנה\"ב עולה ונכלל ברשפי אש דנפש האלקית]."
        }
      ]
    },
    {
      "v": 20,
      "items": [
        {
          "s": 0,
          "text": "וע\"י מעשינו ועבודתינו במשך זמן הגלות86,"
        },
        {
          "s": 1,
          "text": "שעיקר הענין דאתכפיא ואתהפכא הוא בזמן הגלות,"
        },
        {
          "s": 2,
          "text": "נעשה המשכת עיקר שכינה בתחתונים עוד יותר מכמו שהי' בביהמ\"ק,"
        },
        {
          "s": 3,
          "text": "אלא שעכשיו הוא בהעלם והגילוי דהמשכה זו יהי' לע\"ל."
        },
        {
          "s": 4,
          "text": "ויהי רצון שבקרוב ממש יקויים מ\"ש בפרשתינו87"
        },
        {
          "s": 5,
          "text": "ובני ישראל יוצאים ביד רמה ובריש גלי88,"
        },
        {
          "s": 6,
          "text": "ושכל זה יהי' בקרוב ממש."
        }
      ]
    }
  ]
}