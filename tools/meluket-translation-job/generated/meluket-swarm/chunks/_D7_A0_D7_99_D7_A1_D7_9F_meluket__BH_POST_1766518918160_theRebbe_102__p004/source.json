{
  "globalIndex": 749,
  "owner": 49,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918160_theRebbe_102__p004",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518918160_theRebbe_102__p004",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518918160_theRebbe_102",
  "title": "מאמר ויאמר לו יהונתן תשכ\"ח",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ויש לקשר זה עם מ\"ש הצ\"צ ברשימותיו לתהלים44"
        },
        {
          "s": 2,
          "text": "בנוגע המזמור למנצח בנגינות מזמור שיר45"
        },
        {
          "s": 3,
          "text": "(שאומרים אחרי ספירת העומר46),"
        },
        {
          "s": 4,
          "text": "שכתב האלשיך,"
        },
        {
          "s": 5,
          "text": "שמזמור זה מדבר בימות המשיח,"
        },
        {
          "s": 6,
          "text": "שאז יהיו שני דברים."
        },
        {
          "s": 7,
          "text": "שפע ברכות טוב לישראל – אלקים יחננו ויברכנו גו'47,"
        },
        {
          "s": 8,
          "text": "ויתקדש שמו ית' בעולם – כי תשפוט עמים מישור גו'48."
        },
        {
          "s": 9,
          "text": "וזהו שבהתחלת המזמור נאמר מזמור שיר,"
        },
        {
          "s": 10,
          "text": "מזמור על ענין הראשון שיר על ענין השני."
        },
        {
          "s": 11,
          "text": "ולאחרי שהצ\"צ מעתיק את דברי האלשיך,"
        },
        {
          "s": 12,
          "text": "מביא מ\"ש בלקו\"ת סד\"ה מזמור שיר חנוכת הבית49,"
        },
        {
          "s": 13,
          "text": "דמזמור הוא שיר המלאכים ושיר הוא שירת הנשמות."
        },
        {
          "s": 14,
          "text": "ולכאורה הכוונה,"
        },
        {
          "s": 15,
          "text": "דמ\"ש האלשיך שמזמור הוא על ענין הראשון"
        },
        {
          "s": 16,
          "text": "(שפע ברכות לישראל)"
        },
        {
          "s": 17,
          "text": "ושיר הוא על ענין השני"
        },
        {
          "s": 18,
          "text": "(כי תשפוט עמים מישור)"
        },
        {
          "s": 19,
          "text": "הוא ע\"פ דרוש"
        },
        {
          "s": 20,
          "text": "(וכידוע50"
        },
        {
          "s": 21,
          "text": "שהאריז\"ל אמר עליו שנשמתו היא מעולם הדרוש),"
        },
        {
          "s": 22,
          "text": "אבל ע\"פ המבואר בלקו\"ת"
        },
        {
          "s": 23,
          "text": "(מיוסד על קבלה,"
        },
        {
          "s": 24,
          "text": "סוד)"
        },
        {
          "s": 25,
          "text": "שמזמור הוא שירת המלאכים ושיר הוא שירת הנשמות,"
        },
        {
          "s": 26,
          "text": "צריך לומר,"
        },
        {
          "s": 27,
          "text": "שמזמור שייך לכי תשפוט עמים מישור,"
        },
        {
          "s": 28,
          "text": "כי ההשפעה לאומות העולם היא מהמלאכים"
        },
        {
          "s": 29,
          "text": "(ע\"י הע' שרים),"
        },
        {
          "s": 30,
          "text": "ושיר שייך להשפע שיושפע לישראל."
        },
        {
          "s": 31,
          "text": "וממשיך הצ\"צ ברשימותיו,"
        },
        {
          "s": 32,
          "text": "דהטעם שאומרים מזמור זה אחר ספירת העומר,"
        },
        {
          "s": 33,
          "text": "הוא,"
        },
        {
          "s": 34,
          "text": "כי ענין ספה\"ע הוא בירור ז' המדות דנפש הבהמית,"
        },
        {
          "s": 35,
          "text": "דשורש נה\"ב הוא מחיות המרכבה – מלאכים,"
        },
        {
          "s": 36,
          "text": "ענין מזמור,"
        },
        {
          "s": 37,
          "text": "וע\"י הבירור והעלי' דנפש הבהמית נעשה גם העלי' דנפש האלקית,"
        },
        {
          "s": 38,
          "text": "שיר."
        },
        {
          "s": 39,
          "text": "ויש לומר,"
        },
        {
          "s": 40,
          "text": "דזה שאומרים מזמור זה שמדבר בענין בירור עמים"
        },
        {
          "s": 41,
          "text": "(כפשוטם)"
        },
        {
          "s": 42,
          "text": "אחרי ספירת העומר שענינה הוא בירור המדות דנפש הבהמית"
        },
        {
          "s": 43,
          "text": "(שבישראל)"
        },
        {
          "s": 44,
          "text": "הוא,"
        },
        {
          "s": 45,
          "text": "כי ע\"י בירור המדות דנפש הבהמית נמשך גם בירור העמים,"
        },
        {
          "s": 46,
          "text": "כי תשפוט עמים מישור."
        },
        {
          "s": 47,
          "text": "ועפ\"ז מובן עוד יותר שבערב ר\"ח אייר"
        },
        {
          "s": 48,
          "text": "(החודש דספה\"ע)"
        },
        {
          "s": 49,
          "text": "מודגש ענין הסגול שבושלשת,"
        },
        {
          "s": 50,
          "text": "הבירור שמבררים \"מכל העמים\" שמביא לוהייתם לי סגולה."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה כמו שבספירת העומר,"
        },
        {
          "s": 2,
          "text": "ע\"י העלי' דנפש הבהמית"
        },
        {
          "s": 3,
          "text": "(מזמור)"
        },
        {
          "s": 4,
          "text": "נעשה העלי' דנפש האלקית"
        },
        {
          "s": 5,
          "text": "(שיר),"
        },
        {
          "s": 6,
          "text": "עד\"ז הוא בימות המשיח"
        },
        {
          "s": 7,
          "text": "[דמזמור זה מדבר בעיקר בימות המשיח],"
        },
        {
          "s": 8,
          "text": "דע\"י שיתקדש שמו ית' בעולם"
        },
        {
          "s": 9,
          "text": "(כי תשפוט עמים מישור),"
        },
        {
          "s": 10,
          "text": "עי\"ז יתוסף בהשפע לישראל."
        },
        {
          "s": 11,
          "text": "דהגם שענין הבירורים"
        },
        {
          "s": 12,
          "text": "(שעי\"ז נמשך הגילוי)"
        },
        {
          "s": 13,
          "text": "הוא עכשיו,"
        },
        {
          "s": 14,
          "text": "וענין ימות המשיח הוא המשכת הגילוי שלאחרי עבודת הבירורים,"
        },
        {
          "s": 15,
          "text": "מ\"מ,"
        },
        {
          "s": 16,
          "text": "ע\"י כי תשפוט עמים מישור ויתקדש שמו ית' בעולם אז,"
        },
        {
          "s": 17,
          "text": "יתוסף עוד יותר בההמשכה והגילוי לישראל לגבי ההמשכה והגילוי שתהי' אז ע\"י עבודת הבירורים עכשיו."
        },
        {
          "s": 18,
          "text": "ולכן נאמר מזמור שיר,"
        },
        {
          "s": 19,
          "text": "מזמור לפני שיר"
        },
        {
          "s": 20,
          "text": "[הגם שמדבר בעיקר בימות המשיח,"
        },
        {
          "s": 21,
          "text": "וענין מזמור הוא כי תשפוט עמים מישור שיהי' אז],"
        },
        {
          "s": 22,
          "text": "כי גם אז יהי' בתחילה מזמור ועל ידו יהי'"
        },
        {
          "s": 23,
          "text": "(הוספה ב)"
        },
        {
          "s": 24,
          "text": "שיר."
        },
        {
          "s": 25,
          "text": "וזה שבהפסוקים"
        },
        {
          "s": 26,
          "text": "(שלאחרי פסוק הראשון)"
        },
        {
          "s": 27,
          "text": "נאמר אלקים יחננו ויברכנו גו' לפני תשפוט עמים מישור גו',"
        },
        {
          "s": 28,
          "text": "יש לומר,"
        },
        {
          "s": 29,
          "text": "דכיון שכוונת הבריאה היא בשביל ישראל51,"
        },
        {
          "s": 30,
          "text": "הרי מובן,"
        },
        {
          "s": 31,
          "text": "שעיקר הענין דימות המשיח הוא שאז יושפע שפע רב"
        },
        {
          "s": 32,
          "text": "(ברוחניות ובגשמיות)"
        },
        {
          "s": 33,
          "text": "לישראל,"
        },
        {
          "s": 34,
          "text": "אלא ששלימות השפע לישראל הוא ע\"י שיתקדש שמו ית' בעולם,"
        },
        {
          "s": 35,
          "text": "ולכן נאמר אלקים יחננו ויברכנו יאר פניו אתנו סלה לפני תשפוט עמים מישור גו'."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "וע\"ד הידוע בענין נשמה וגוף,"
        },
        {
          "s": 1,
          "text": "דנוסף לזה שהגילוי אלקות שנמשך להנשמה ע\"י עבודתה בתומ\"צ בהיותה מלובשת בגוף הוא גילוי נעלה הרבה יותר מהגילוי שהי' לה קודם ירידתה למטה,"
        },
        {
          "s": 2,
          "text": "הנה גם הגילוי שע\"י העבודה דתומ\"צ בגוף גשמי יהי' בעיקר בתחיית המתים,"
        },
        {
          "s": 3,
          "text": "כשהנשמה תהי' מלובשת בגוף גשמי."
        },
        {
          "s": 4,
          "text": "דהגם שגם הגילוי בג\"ע לאחרי יציאת הנשמה מהגוף הוא נעלה הרבה מהגילוי דג\"ע שהי' להנשמה קודם ירידתה,"
        },
        {
          "s": 5,
          "text": "לפי שהגילוי דג\"ע שלאחרי ירידתה בגוף ויציאתה מהגוף הוא ע\"י העבודה דתומ\"צ בגוף גשמי,"
        },
        {
          "s": 6,
          "text": "מ\"מ,"
        },
        {
          "s": 7,
          "text": "עיקר הגילוי שע\"י העבודה דתומ\"צ יהי' בתחיית המתים,"
        },
        {
          "s": 8,
          "text": "כשהנשמה תהי' מלובשת בגוף52."
        },
        {
          "s": 9,
          "text": "וכמובן גם מהענין דתחיית המתים עצמו,"
        },
        {
          "s": 10,
          "text": "דיקומו לתחי' כל ישראל,"
        },
        {
          "s": 11,
          "text": "גם הנשמות שנמצאים בג\"ע כמה אלפים שנה,"
        },
        {
          "s": 12,
          "text": "וג' פעמים בכל יום הם מתעלים לדרגא נעלית יותר,"
        },
        {
          "s": 13,
          "text": "ואעפ\"כ לע\"ל יתלבשו בגופים,"
        },
        {
          "s": 14,
          "text": "כי הגילוי דעולם התחי' הוא נעלה הרבה יותר מהגילוי דג\"ע גם מדרגא הכי נעלית דג\"ע53."
        }
      ]
    }
  ]
}