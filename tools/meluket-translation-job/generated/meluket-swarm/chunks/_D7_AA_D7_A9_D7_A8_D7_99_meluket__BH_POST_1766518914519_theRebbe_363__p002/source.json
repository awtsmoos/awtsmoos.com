{
  "globalIndex": 142,
  "owner": 42,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914519_theRebbe_363__p002",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914519_theRebbe_363__p002",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914519_theRebbe_363",
  "title": "מאמר ביום השמיני עצרת תש\"מ",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים תחלה ענין לוחות הראשונות ולוחות האחרונות בעבודת האדם."
        },
        {
          "s": 2,
          "text": "דהנה עיקר הכוונה דמ\"ת הוא שתהי' קבלת התורה,"
        },
        {
          "s": 3,
          "text": "עבודת האדם."
        },
        {
          "s": 4,
          "text": "דלוחות הראשונות הוא ענין עבודת הצדיקים ולוחות האחרונות הוא ענין עבודת הבע\"ת."
        },
        {
          "s": 5,
          "text": "והמעלה דלוחות האחרונות על לוחות הראשונות הוא מפני שעבודת התשובה נעלית יותר מעבודת הצדיקים31."
        },
        {
          "s": 6,
          "text": "והענין הוא,"
        },
        {
          "s": 7,
          "text": "דהנה כללות החילוק בין לוחות הראשונות ללוחות האחרונות הוא דנתינת לוחות הראשונות היתה מצד למעלה,"
        },
        {
          "s": 8,
          "text": "וירד הוי' על הר סיני."
        },
        {
          "s": 9,
          "text": "דהגם שהגילוי דמ\"ת פעל גם בעולם וגם בהדומם שבו,"
        },
        {
          "s": 10,
          "text": "ועד שהעולם"
        },
        {
          "s": 11,
          "text": "(גם הדומם שבו)"
        },
        {
          "s": 12,
          "text": "איז געוואָרן דורכגענומען מהגילוי דמ\"ת,"
        },
        {
          "s": 13,
          "text": "אעפ\"כ אין זה שנעשה זיכוך תמידי ועלי' בהעולם,"
        },
        {
          "s": 14,
          "text": "ורק שהאיר בו הגילוי שלמעלה32."
        },
        {
          "s": 15,
          "text": "ועד\"ז גם בישראל,"
        },
        {
          "s": 16,
          "text": "דמה שהגילוי דמ\"ת פעל גם בהגוף"
        },
        {
          "s": 17,
          "text": "(שפסקה זוהמתן)"
        },
        {
          "s": 18,
          "text": "הי' זה מצד הנשמה."
        },
        {
          "s": 19,
          "text": "דבעת מ\"ת הי' אצלם גילוי עצם הנשמה,"
        },
        {
          "s": 20,
          "text": "בחי' יחידה"
        },
        {
          "s": 21,
          "text": "[שאינה מציאות לעצמה וכל מציאותה הוא זה שהיא כלי ומקבלת מבחי' יחיד33],"
        },
        {
          "s": 22,
          "text": "ומכיון שגם בחי' יחידה היא קשורה עם הגוף34,"
        },
        {
          "s": 23,
          "text": "לכן,"
        },
        {
          "s": 24,
          "text": "הגילוי דבחי' יחידה האיר גם בהגוף,"
        },
        {
          "s": 25,
          "text": "עד בבחי' עקב שבו,"
        },
        {
          "s": 26,
          "text": "וע\"ד מ\"ש גבי אברהם35"
        },
        {
          "s": 27,
          "text": "עקב אשר שמע אברהם בקולי גו'36."
        },
        {
          "s": 28,
          "text": "והטעם לזה הוא לפי שהגילוי דמ\"ת הי' בדרך אתערותא דלעילא שלא ע\"י אתערותא דלתתא,"
        },
        {
          "s": 29,
          "text": "דהגם שהיתה העבודה דספירת העומר במשך הז' שבועות שבין יצי\"מ למ\"ת,"
        },
        {
          "s": 30,
          "text": "הרי מובן,"
        },
        {
          "s": 31,
          "text": "שע\"י עבודה זו"
        },
        {
          "s": 32,
          "text": "(שבמשך המ\"ט יום ונ' יום)"
        },
        {
          "s": 33,
          "text": "לא היו בערך להיות בבחי' כלי להגילוי דמ\"ת37,"
        },
        {
          "s": 34,
          "text": "כי אם,"
        },
        {
          "s": 35,
          "text": "שהגילוי דמ\"ת הי' בדרך אתעדל\"ע מצ\"ע,"
        },
        {
          "s": 36,
          "text": "ואני המתחיל38,"
        },
        {
          "s": 37,
          "text": "ומה שהוצרך להיות העבודה לפני מ\"ת הוא רק בדרך הכנה בלבד39."
        },
        {
          "s": 38,
          "text": "ובדוגמת המבואר בכ\"מ40"
        },
        {
          "s": 39,
          "text": "בענין ההפרש שבין האתעדל\"ע שלפי ערך האתעדל\"ת להאתעדל\"ע הבאה בדרך מתנה שאין אתעדל\"ת מגעת לשם כלל,"
        },
        {
          "s": 40,
          "text": "דהגם שגם האתעדל\"ע שבדרך מתנה נמשכת דוקא אחרי קדימת האתעדל\"ת"
        },
        {
          "s": 41,
          "text": "(והאתעדל\"ע שלפ\"ע האתעדל\"ת),"
        },
        {
          "s": 42,
          "text": "מ\"מ אין זה שהאתעדל\"ת ממשיכה אותה,"
        },
        {
          "s": 43,
          "text": "כי המשכת אתעדל\"ע זו היא מבחי' שאין אתעדל\"ת מגעת לשם,"
        },
        {
          "s": 44,
          "text": "ומה שנמשכת אחרי קדימת האתעדל\"ת"
        },
        {
          "s": 45,
          "text": "(והאתעדל\"ע שלפ\"ע האתעדל\"ת)"
        },
        {
          "s": 46,
          "text": "הוא לפי דקוב\"ה לא שריא אלא באתר שלים41."
        },
        {
          "s": 47,
          "text": "שעד\"ז הוא גם בנוגע להעבודה במשך הז' שבועות לפני מ\"ת שהעבודה לא היתה כלי להגילוי דמ\"ת"
        },
        {
          "s": 48,
          "text": "(ואין שייך לומר שהעבודה המשיכה את הגילוי דמ\"ת),"
        },
        {
          "s": 49,
          "text": "ורק בדרך הכנה בלבד,"
        },
        {
          "s": 50,
          "text": "שע\"י עבודתם נעשו מעין כלי"
        },
        {
          "s": 51,
          "text": "(אבל לא כלי ממש)"
        },
        {
          "s": 52,
          "text": "להגילוי דמ\"ת."
        },
        {
          "s": 53,
          "text": "וזה גופא"
        },
        {
          "s": 54,
          "text": "(מה שהיו מעין כלי להגילוי דמ\"ת)"
        },
        {
          "s": 55,
          "text": "הוא מצד שרשם ומקורם,"
        },
        {
          "s": 56,
          "text": "מצד האבות והאמהות עד לאחד הי' אברהם42,"
        },
        {
          "s": 57,
          "text": "שלכן יש"
        },
        {
          "s": 58,
          "text": "(קס\"ד)"
        },
        {
          "s": 59,
          "text": "בכתבי האריז\"ל43"
        },
        {
          "s": 60,
          "text": "שענין מ\"ת הותחל בימי האבות."
        },
        {
          "s": 61,
          "text": "דכ\"ז הי' בלוחות הראשונות."
        },
        {
          "s": 62,
          "text": "משא\"כ נתינת לוחות האחרונות היתה ע\"י אתעדל\"ת."
        },
        {
          "s": 63,
          "text": "דעבודת התשובה דבנ\"י"
        },
        {
          "s": 64,
          "text": "(על חטא העגל)"
        },
        {
          "s": 65,
          "text": "היתה אתעדל\"ת שעוררה והמשיכה הגילוי דלוחות האחרונות."
        },
        {
          "s": 66,
          "text": "וזהו מה שנתינת לוחות האחרונות היתה בחודש תשרי,"
        },
        {
          "s": 67,
          "text": "כי עניני חודש תשרי באים ע\"י העבודה דאלול שהיא כלי ואתעדל\"ת שמעוררת וממשכת את הענינים דתשרי."
        },
        {
          "s": 68,
          "text": "ולכן עי\"ז נעשה זיכוך ועלי' גם בהמטה מצד עצמו"
        },
        {
          "s": 69,
          "text": "(דלא כבלוחות הראשונות)."
        },
        {
          "s": 70,
          "text": "וזהו דלוחות הראשונות ולוחות האחרונות בעבודת האדם הם עבודת הצדיקים ועבודת התשובה,"
        },
        {
          "s": 71,
          "text": "כי עבודת הצדיקים"
        },
        {
          "s": 72,
          "text": "(כולל גם המשכה שע\"י העבודה)"
        },
        {
          "s": 73,
          "text": "היא בבחי' אור ישר,"
        },
        {
          "s": 74,
          "text": "מלמעלה למטה,"
        },
        {
          "s": 75,
          "text": "משא\"כ ע\"י עבודת התשובה נפעל ענין חדש,"
        },
        {
          "s": 76,
          "text": "שגם המטה גופא מזדכך ומתעלה."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "והענין הוא,"
        },
        {
          "s": 2,
          "text": "דעבודת הצדיקים היא כשהאדם הוא באופן דהאלקים עשה את האדם ישר44,"
        },
        {
          "s": 3,
          "text": "דכל אחד מישראל באיזה מצב שהוא רוצה הוא בטבעו למלאות רצון קונו"
        },
        {
          "s": 4,
          "text": "(כפס\"ד הידוע45)"
        },
        {
          "s": 5,
          "text": "בלימוד התורה ובקיום המצוות ובעבודת התפלה,"
        },
        {
          "s": 6,
          "text": "ולכן ע\"י עבודת הצדיקים לא נעשה התחדשות אמיתית,"
        },
        {
          "s": 7,
          "text": "מכיון שהעבודה היא כטבע תולדותם."
        },
        {
          "s": 8,
          "text": "וכמו שעבודת הצדיקים אינה חידוש אמיתי בהאדם מכיון שהעבודה היא כטבע תולדתו,"
        },
        {
          "s": 9,
          "text": "עד\"ז הוא גם בנוגע להענינים שלמעלה,"
        },
        {
          "s": 10,
          "text": "מכיון שכוונת הבריאה"
        },
        {
          "s": 11,
          "text": "(מלכתחלה)"
        },
        {
          "s": 12,
          "text": "היא בכדי להטיב לברואיו כו'46"
        },
        {
          "s": 13,
          "text": "(ע\"י עבודתם בתומ\"צ)"
        },
        {
          "s": 14,
          "text": "מצד טבע47"
        },
        {
          "s": 15,
          "text": "הטוב להטיב48."
        },
        {
          "s": 16,
          "text": "וכן הוא גם למעלה יותר בבחי' שרש הנשמות כמו שמושרשים בעצמותו ית',"
        },
        {
          "s": 17,
          "text": "כתורת הרב המגיד49"
        },
        {
          "s": 18,
          "text": "בענין במי50"
        },
        {
          "s": 19,
          "text": "נמלך בנשמותיהן של צדיקים51,"
        },
        {
          "s": 20,
          "text": "די\"ל שענין זה הוא בעצמותו ית'"
        },
        {
          "s": 21,
          "text": "(למעלה מבחי' טבע הטוב להטיב),"
        },
        {
          "s": 22,
          "text": "דמכיון שגם בתחלה כבר עלה לפניו ית' התענוג שיתענג בעבודת הצדיקים52,"
        },
        {
          "s": 23,
          "text": "הרי ע\"י עבודת הצדיקים"
        },
        {
          "s": 24,
          "text": "(בפועל)"
        },
        {
          "s": 25,
          "text": "אין זה התחדשות אמיתית."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "דכ\"ז הוא בנוגע לעבודת הצדיקים,"
        },
        {
          "s": 1,
          "text": "וכדיוק לשון רז\"ל במי נמלך בנשמותיהן של צדיקים."
        },
        {
          "s": 2,
          "text": "אמנם הכוונה האמיתית"
        },
        {
          "s": 3,
          "text": "(שלמעלה גם מבחי' במי נמלך)"
        },
        {
          "s": 4,
          "text": "היא כמ\"ש53"
        },
        {
          "s": 5,
          "text": "אשר ברא אלקים לעשות,"
        },
        {
          "s": 6,
          "text": "לעשות לתקן54,"
        },
        {
          "s": 7,
          "text": "שהאדם ע\"י עבודתו יעשה חידוש בהבריאה,"
        },
        {
          "s": 8,
          "text": "שיהי'"
        },
        {
          "s": 9,
          "text": "(לא רק אלה תולדות השמים והארץ בהבראם55,"
        },
        {
          "s": 10,
          "text": "תולדות מלא56,"
        },
        {
          "s": 11,
          "text": "עולם על מילואו נברא57,"
        },
        {
          "s": 12,
          "text": "אלא גם)"
        },
        {
          "s": 13,
          "text": "אלה תולדות פרץ58,"
        },
        {
          "s": 14,
          "text": "תולדות מלא56,"
        },
        {
          "s": 15,
          "text": "למעלה מאלה תולדות השמים והארץ,"
        },
        {
          "s": 16,
          "text": "פרץ זה משיח שנאמר בו59"
        },
        {
          "s": 17,
          "text": "עלה הפורץ לפניהם60,"
        },
        {
          "s": 18,
          "text": "שאז יהי' העולם למעלה מכמו שהי' בתחלת הבריאה דעולם על מילואו נברא"
        },
        {
          "s": 19,
          "text": "(כ\"א שמים חדשים וארץ חדשה61)."
        },
        {
          "s": 20,
          "text": "וכן הוא גם בנוגע לנשמות ישראל62"
        },
        {
          "s": 21,
          "text": "שהנשמות דלע\"ל יהיו גבוהות יותר גם מאדה\"ר כמו שהי' קודם החטא,"
        },
        {
          "s": 22,
          "text": "וכמבואר בלקו\"ת בסיומו וחותמו63"
        },
        {
          "s": 23,
          "text": "בענין נשמות החדשות שיהיו לע\"ל שהם יותר גבוהות מכל הנשמות שנכללו באדה\"ר."
        },
        {
          "s": 24,
          "text": "דחידוש זה נעשה ע\"י עבודת התשובה דוקא,"
        },
        {
          "s": 25,
          "text": "דזהו מה שמשיח"
        },
        {
          "s": 26,
          "text": "(דוקא)"
        },
        {
          "s": 27,
          "text": "אתא לאתבא צדיקייא בתיובתא64."
        },
        {
          "s": 28,
          "text": "ועי\"ז נשלמה הכוונה האמיתית,"
        },
        {
          "s": 29,
          "text": "שלמעלה מענין במי נמלך בנשמותיהן של צדיקים."
        }
      ]
    }
  ]
}