{
  "globalIndex": 510,
  "owner": 10,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916754_theRebbe_640__p009",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916754_theRebbe_640__p009",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916754_theRebbe_640",
  "title": "מאמר באתי לגני תשכ\"ח",
  "part": 9,
  "sections": [
    {
      "v": 24,
      "items": [
        {
          "s": 0,
          "text": "ויובן זה בפרטיות יותר ע\"פ המבואר בדרושי אדמו\"ר"
        },
        {
          "s": 1,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 2,
          "text": "נ\"ע104,"
        },
        {
          "s": 3,
          "text": "שהרצון דמצוות הוא רצון עצמי שאין שייך בו שינוי,"
        },
        {
          "s": 4,
          "text": "וגם מה שע\"י תשובה מתמלאים הפגמים שפגם בתומ\"צ,"
        },
        {
          "s": 5,
          "text": "אין זה בבחי' ניחום ושינוי ח\"ו,"
        },
        {
          "s": 6,
          "text": "כי אם,"
        },
        {
          "s": 7,
          "text": "שע\"י התשובה מגיעים בעונג העצמי דפנימיות ועצמות א\"ס,"
        },
        {
          "s": 8,
          "text": "שהוא התענוג בישראל מצד עצמם"
        },
        {
          "s": 9,
          "text": "(נוסף על התענוג שמצד קיום התומ\"צ שלהם),"
        },
        {
          "s": 10,
          "text": "וכשנמשך העונג העצמי,"
        },
        {
          "s": 11,
          "text": "נמשך גם הרצון."
        },
        {
          "s": 12,
          "text": "ועפ\"ז יובן יותר מה שתפילין נק' מוחין,"
        },
        {
          "s": 13,
          "text": "כי זה שישראל הם גוי אחד בארץ"
        },
        {
          "s": 14,
          "text": "(מ\"ש בתפילין דמארי עלמא),"
        },
        {
          "s": 15,
          "text": "שגם בהיותם בארץ הם דבוקים וקשורים עם הוי' אחד105,"
        },
        {
          "s": 16,
          "text": "הוא מצד זה שהשרש דישראל הוא בתענוג העצמי דפנימיות ועצמות א\"ס"
        },
        {
          "s": 17,
          "text": "(שלכן אין שייך שעניני הארץ יעשו שינוי בזה),"
        },
        {
          "s": 18,
          "text": "וע\"י קיום מצות תפילין,"
        },
        {
          "s": 19,
          "text": "נמשך ענין זה בגילוי."
        },
        {
          "s": 20,
          "text": "וזהו גם מה שקרקפתא דלא מנח תפילין,"
        },
        {
          "s": 21,
          "text": "שיש לו דין מיוחד106"
        },
        {
          "s": 22,
          "text": "הוא דוקא כשלא הניח מעולם107,"
        },
        {
          "s": 23,
          "text": "וע\"י שמניח תפילין פעם אחת,"
        },
        {
          "s": 24,
          "text": "הוא יוצא מסוג זה,"
        },
        {
          "s": 25,
          "text": "כי ע\"י שמניח תפילין"
        },
        {
          "s": 26,
          "text": "(אפילו ע\"י פעם אחת)"
        },
        {
          "s": 27,
          "text": "נמשך בו הגילוי דתענוג העצמי."
        },
        {
          "s": 28,
          "text": "ויש לומר,"
        },
        {
          "s": 29,
          "text": "שעי\"ז נמשך גם הרצון דתומ\"צ,"
        },
        {
          "s": 30,
          "text": "ע\"ד משנת\"ל בענין התשובה."
        }
      ]
    },
    {
      "v": 25,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ז)"
        },
        {
          "s": 2,
          "text": "וזהו וגם נצח ישראל לא ישקר ולא ינחם כי לא אדם הוא להנחם,"
        },
        {
          "s": 3,
          "text": "שהשרש דישראל הוא בבחי' לא אדם,"
        },
        {
          "s": 4,
          "text": "שלמעלה גם מטעם כמוס,"
        },
        {
          "s": 5,
          "text": "שאין שייך בזה שינוי ח\"ו."
        },
        {
          "s": 6,
          "text": "[וביחד עם זה,"
        },
        {
          "s": 7,
          "text": "יש בזה גם המעלה דאדם,"
        },
        {
          "s": 8,
          "text": "ענין ה\"טעם\","
        },
        {
          "s": 9,
          "text": "התענוג העצמי]."
        },
        {
          "s": 10,
          "text": "וע\"י שהאדם עובד עבודתו באופן של נצח,"
        },
        {
          "s": 11,
          "text": "ובאופן דנצח סלה ועד שאין לו הפסק108"
        },
        {
          "s": 12,
          "text": "בלי שינויים,"
        },
        {
          "s": 13,
          "text": "ווי עס זאָל זיין און וואָס עס זאָל זיין הוא עומד בתוקף חזק,"
        },
        {
          "s": 14,
          "text": "שגם בארץ יהי' קשור עם הוי' אחד,"
        },
        {
          "s": 15,
          "text": "אזי נותנים לו האוצרות שלמעלה,"
        },
        {
          "s": 16,
          "text": "שגם הם נמשכים ממקום שלמעלה מענין השינויים,"
        },
        {
          "s": 17,
          "text": "לית שמאלא בהאי עתיקא109"
        },
        {
          "s": 18,
          "text": "ובמילא ההמשכה משם היא באופן דנצח סלה ועד שאין לו הפסק."
        },
        {
          "s": 19,
          "text": "ובחינה זו נותנים באופן של בזבוז בלי חשבונות."
        },
        {
          "s": 20,
          "text": "והגם שנתינת האוצרות היא ע\"י השרים ומפקדי המלחמה,"
        },
        {
          "s": 21,
          "text": "נשיאי ישראל שבכל דור,"
        },
        {
          "s": 22,
          "text": "עד לנשיא דורנו בעל ההילולא,"
        },
        {
          "s": 23,
          "text": "הרי עיקר הכוונה בזה היא שהאוצרות יומשכו וינתנו להאנשי חיל,"
        },
        {
          "s": 24,
          "text": "צבאות הוי',"
        },
        {
          "s": 25,
          "text": "שעל ידם נעשה הנצחון בפועל,"
        },
        {
          "s": 26,
          "text": "שיהי' והיתה לה' המלוכה110,"
        },
        {
          "s": 27,
          "text": "והי' ה' למלך על כל הארץ ביום ההוא יהי' ה' אחד ושמו אחד111,"
        },
        {
          "s": 28,
          "text": "בגאולה האמיתית והשלימה בקרוב ממש ע\"י משיח צדקנו."
        }
      ]
    }
  ]
}