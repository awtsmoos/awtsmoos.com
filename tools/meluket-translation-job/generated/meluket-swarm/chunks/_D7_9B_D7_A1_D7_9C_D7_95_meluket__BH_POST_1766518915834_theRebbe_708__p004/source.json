{
  "globalIndex": 363,
  "owner": 13,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915834_theRebbe_708__p004",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915834_theRebbe_708__p004",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915834_theRebbe_708",
  "title": "מאמר שלום רב לאוהבי תורתך תשל\"ח",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וביאור הענין"
        },
        {
          "s": 2,
          "text": "(דמרבים שלום בעולם)"
        },
        {
          "s": 3,
          "text": "בעומק יותר,"
        },
        {
          "s": 4,
          "text": "יובן ממ\"ש בהמאמר60"
        },
        {
          "s": 5,
          "text": "דקיום העולם הוא ע\"י שממשיכים בהעשרה מאמרות"
        },
        {
          "s": 6,
          "text": "(שבהם נברא העולם)"
        },
        {
          "s": 7,
          "text": "את עשרת הדברות,"
        },
        {
          "s": 8,
          "text": "דיש לומר דכוונתו בזה שמדגיש עשרת הדברות דוקא"
        },
        {
          "s": 9,
          "text": "(שניתנו במתן תורה)"
        },
        {
          "s": 10,
          "text": "היא,"
        },
        {
          "s": 11,
          "text": "שקיום העולם הוא ע\"י העבודה דתומ\"צ שלאחרי מתן תורה דוקא."
        },
        {
          "s": 12,
          "text": "דהגם שגם ע\"י עבודת האבות"
        },
        {
          "s": 13,
          "text": "(דהאבות הן הן המרכבה61)"
        },
        {
          "s": 14,
          "text": "נמשך תוספת אור בעולם"
        },
        {
          "s": 15,
          "text": "(שלמעלה מהאור דעשרה מאמרות)62,"
        },
        {
          "s": 16,
          "text": "מ\"מ,"
        },
        {
          "s": 17,
          "text": "מכיון שעבודת האבות היתה בכח עצמם"
        },
        {
          "s": 18,
          "text": "(שהרי לא נצטוו על זה),"
        },
        {
          "s": 19,
          "text": "לכן,"
        },
        {
          "s": 20,
          "text": "האור שנמשך ע\"י עבודתם הוא"
        },
        {
          "s": 21,
          "text": "(בכללות)"
        },
        {
          "s": 22,
          "text": "רק מבחי' שרש הנבראים"
        },
        {
          "s": 23,
          "text": "(כידוע ההוכחה על זה63"
        },
        {
          "s": 24,
          "text": "ממעין עין עיטם64),"
        },
        {
          "s": 25,
          "text": "ואין זה בערך כלל לההמשכה ע\"י קיום המצות שלאחרי מתן תורה65."
        },
        {
          "s": 26,
          "text": "ויתירה מזו,"
        },
        {
          "s": 27,
          "text": "שגם עבודת אדה\"ר,"
        },
        {
          "s": 28,
          "text": "וכמו שהי' בג\"ע"
        },
        {
          "s": 29,
          "text": "(ויניחהו בגן עדן לעבדה ולשמרה66)"
        },
        {
          "s": 30,
          "text": "ולפני החטא,"
        },
        {
          "s": 31,
          "text": "שהיא נעלית יותר מעבודת האבות67,"
        },
        {
          "s": 32,
          "text": "והאור שנמשך ע\"י עבודתו הוא הוספה באין ערוך לגבי העולם כמו שהוא מצד עצמו"
        },
        {
          "s": 33,
          "text": "[ועד שי\"ל שזה בדוגמת ההמשכה ע\"י המצוות שלאחרי מתן תורה,"
        },
        {
          "s": 34,
          "text": "וכמארז\"ל68"
        },
        {
          "s": 35,
          "text": "לעבדה אלו רמ\"ח מ\"ע ולשמרה אלו שס\"ה מל\"ת,"
        },
        {
          "s": 36,
          "text": "שהעבודה דאדה\"ר בג\"ע"
        },
        {
          "s": 37,
          "text": "(לעבדה ולשמרה)"
        },
        {
          "s": 38,
          "text": "היא דוגמת רמ\"ח מ\"ע ושס\"ה מל\"ת שלאחרי מתן תורה],"
        },
        {
          "s": 39,
          "text": "מ\"מ,"
        },
        {
          "s": 40,
          "text": "גם ההמשכה ע\"י עבודת אדה\"ר בג\"ע היתה רק הארה69,"
        },
        {
          "s": 41,
          "text": "מכיון שעד מתן תורה היתה הגזירה70"
        },
        {
          "s": 42,
          "text": "עליונים לא ירדו למטה ותחתונים לא יעלו למעלה."
        },
        {
          "s": 43,
          "text": "משא\"כ ההמשכה ע\"י התומ\"צ שלאחרי מתן תורה"
        },
        {
          "s": 44,
          "text": "(שאז בטלה הגזירה70)"
        },
        {
          "s": 45,
          "text": "היא המשכת העצמות."
        },
        {
          "s": 46,
          "text": "ועפ\"ז יובן בעומק יותר הענין דמרבים שלום בעולם,"
        },
        {
          "s": 47,
          "text": "דהריבוי שלום בעולם הוא לא רק שנמשך בו הגילוי דאוא\"ס שלמעלה משרש העולמות,"
        },
        {
          "s": 48,
          "text": "אלא יתירה מזו,"
        },
        {
          "s": 49,
          "text": "שנמשך בו העצמות,"
        },
        {
          "s": 50,
          "text": "שלימות הענין דדירה בתחתונים,"
        },
        {
          "s": 51,
          "text": "דירה לעצמותו71."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "והנה מכיון שאין הקב\"ה מקפח שכר כל ברי'72,"
        },
        {
          "s": 2,
          "text": "לכן,"
        },
        {
          "s": 3,
          "text": "ריבוי השלום שנעשה בעולם ע\"י התלמידי חכמים נמשך גם להתלמידי חכמים עצמם73."
        },
        {
          "s": 4,
          "text": "והיינו,"
        },
        {
          "s": 5,
          "text": "שהנח\"ר לבורא מזה שנעשה לו ית' דירה בתחתונים,"
        },
        {
          "s": 6,
          "text": "יתגלה להתלמידי חכמים שעשו את הדירה,"
        },
        {
          "s": 7,
          "text": "וגילוי זה הוא למעלה מהשכר דעוה\"ב כמו שהוא מצד עצמו."
        },
        {
          "s": 8,
          "text": "שהשכר דעוה\"ב מצד עצמו הוא בחי' נח\"ר דהנברא שבאין ערוך לגבי הנח\"ר דהבורא,"
        },
        {
          "s": 9,
          "text": "שלכן יפה שעה אחת בתשובה ומעשים טובים בעוה\"ז מכל חיי העוה\"ב74,"
        },
        {
          "s": 10,
          "text": "כי עוה\"ב"
        },
        {
          "s": 11,
          "text": "(שכר מצוה)"
        },
        {
          "s": 12,
          "text": "הוא נח\"ר דהנברא שבאין ערוך לגבי הנח\"ר דהבורא – תשובה ומעשים טובים בעוה\"ז75."
        },
        {
          "s": 13,
          "text": "אלא שכיון שאין הקב\"ה מקפח שכר כל ברי',"
        },
        {
          "s": 14,
          "text": "יומשך להצדיקים"
        },
        {
          "s": 15,
          "text": "(שעשו את הנח\"ר דהבורא)"
        },
        {
          "s": 16,
          "text": "גם בחי' נח\"ר דהבורא76."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "אמנם בכדי שיוכלו לקבל בחי' נח\"ר זה שאינו בערכם כלל"
        },
        {
          "s": 1,
          "text": "[שהרי נח\"ר זה הוא תענוג העצמי דעצמותו ית',"
        },
        {
          "s": 2,
          "text": "שאין שייך בו שום גדר כלל],"
        },
        {
          "s": 3,
          "text": "לזה צריך שיהיו בבחי' ביטול בתכלית,"
        },
        {
          "s": 4,
          "text": "שאינם מציאות לעצמם כלל"
        },
        {
          "s": 5,
          "text": "[וע\"ד מרז\"ל מאן פני האדון ה'77"
        },
        {
          "s": 6,
          "text": "דא רשב\"י78,"
        },
        {
          "s": 7,
          "text": "והוי' בהיכל קדשו79"
        },
        {
          "s": 8,
          "text": "דא ר\"י ב\"ר לעזר בכנישתא מדרשא דקיסרין80],"
        },
        {
          "s": 9,
          "text": "שעי\"ז הם יכולים לקבל הנח\"ר והתענוג דהבורא,"
        },
        {
          "s": 10,
          "text": "כי התענוג דהבורא הוא התענוג שלהם."
        },
        {
          "s": 11,
          "text": "ובדוגמת העבד,"
        },
        {
          "s": 12,
          "text": "שכיון שאינו מציאות לעצמו וכל מציאותו היא מציאות האדון81,"
        },
        {
          "s": 13,
          "text": "תענוג האדון הוא תענוג העבד82."
        }
      ]
    }
  ]
}