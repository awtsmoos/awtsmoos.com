{
  "globalIndex": 106,
  "owner": 6,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914293_theRebbe_757__p003",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914293_theRebbe_757__p003",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914293_theRebbe_757",
  "title": "מאמר בסוכות תשבו תש\"מ",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וזהו גם השייכות של ענין האחדות דכל ישראל לענין הסוכה"
        },
        {
          "s": 2,
          "text": "(כל ישראל ראוים לישב בסוכה אחת),"
        },
        {
          "s": 3,
          "text": "כי המקיף דסוכה הוא סובב ומקיף את כל ישראל כאחד,"
        },
        {
          "s": 4,
          "text": "בדוגמת ענני הכבוד"
        },
        {
          "s": 5,
          "text": "(בסוכות הושבתי גו'48)"
        },
        {
          "s": 6,
          "text": "שהקיפו את כל ישראל כולם כאיש אחד."
        },
        {
          "s": 7,
          "text": "וזהו גם בסוכות תשבו,"
        },
        {
          "s": 8,
          "text": "תשבו כעין תדורו49,"
        },
        {
          "s": 9,
          "text": "דכמו שהסוכה מקיף את כל ישראל כאחד,"
        },
        {
          "s": 10,
          "text": "מראשיכם שבטיכם עד חוטב עציך ושואב מימיך,"
        },
        {
          "s": 11,
          "text": "עד\"ז הוא בכאו\"א מישראל בפרט,"
        },
        {
          "s": 12,
          "text": "שכל עניניו צריכים להיות בהמקיף דסוכה."
        },
        {
          "s": 13,
          "text": "ומדייק בסוכות תשבו שכולל"
        },
        {
          "s": 14,
          "text": "(לא רק הפירוש תשבו כעין תדורו אלא)"
        },
        {
          "s": 15,
          "text": "גם הפירוש דהתיישבות,"
        },
        {
          "s": 16,
          "text": "שצריך להמשיך בחי' המקיף דסוכה בבחי' ההתיישבות."
        },
        {
          "s": 17,
          "text": "ומוסיף למען ידעו גו',"
        },
        {
          "s": 18,
          "text": "שצריך להמשיך זה גם בהשגה,"
        },
        {
          "s": 19,
          "text": "ובהשגה גופא במוח הדעת שבו הוא עיקר ההתיישבות והפנימיות."
        },
        {
          "s": 20,
          "text": "ומדייק למען ידעו דורותיכם גו',"
        },
        {
          "s": 21,
          "text": "שגם הדורות הבאים"
        },
        {
          "s": 22,
          "text": "(לאחרי הדור שיצאו ממצרים)"
        },
        {
          "s": 23,
          "text": "יקיימו מצות סוכה לא רק במעשה בפועל,"
        },
        {
          "s": 24,
          "text": "אלא שקיום מצוה זו זאָל זיי דורכנעמען בפנימיות,"
        },
        {
          "s": 25,
          "text": "עד שגם יורגש במוח הדעת."
        },
        {
          "s": 26,
          "text": "ומוסיף שבעת ימים,"
        },
        {
          "s": 27,
          "text": "שהמשכה זו צריכה להיות בכל ז' ימי ההיקף,"
        },
        {
          "s": 28,
          "text": "היינו בכל הבחי' דהשתלשלות עד לבחי' המלכות,"
        },
        {
          "s": 29,
          "text": "וכנ\"ל שע\"י נטילת הד' מינים נמשך הדעת"
        },
        {
          "s": 30,
          "text": "(גם)"
        },
        {
          "s": 31,
          "text": "בנוק',"
        },
        {
          "s": 32,
          "text": "ועד\"ז הוא באדם שבחי' המקיף דסוכה דאַרף דורכנעמען את כל הכוחות שלו עד לכח המעשה שלו"
        },
        {
          "s": 33,
          "text": "(שהרי קיום מצות סוכה צריכה להיות ועיקרה בעשי' בפועל),"
        },
        {
          "s": 34,
          "text": "ומזה באים אח\"כ לביום השמיני עצרת בחי' שמיני שלמעלה מההיקף דהשתלשלות,"
        },
        {
          "s": 35,
          "text": "וגם בחינה זו נמשכת ע\"י הדעת,"
        },
        {
          "s": 36,
          "text": "כי הדעת מחליף מקום הכתר,"
        },
        {
          "s": 37,
          "text": "בחי' אנת50"
        },
        {
          "s": 38,
          "text": "הוא חד ולא בחושבן,"
        },
        {
          "s": 39,
          "text": "כמבואר בהמשך וככה51."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "וממשיך בכתוב כל האזרח בישראל ישבו בסוכות,"
        },
        {
          "s": 2,
          "text": "שבזה הוא מבאר הטעם והכח על העבודה בסוכות תשבו כו'52."
        },
        {
          "s": 3,
          "text": "והענין הוא,"
        },
        {
          "s": 4,
          "text": "אזרח לשון עתיד קאי על בחי' עצם הנשמה שתזרח ותאיר לע\"ל53."
        },
        {
          "s": 5,
          "text": "בחי' איתן שבנשמה כמ\"ש54"
        },
        {
          "s": 6,
          "text": "משכיל לאיתן האזרחי,"
        },
        {
          "s": 7,
          "text": "איתן מלשון תוקף ומלשון יושן,"
        },
        {
          "s": 8,
          "text": "והוא התוקף דנשמה הבא מבחי' שם ע\"ב שאינו מחודש"
        },
        {
          "s": 9,
          "text": "(יושן),"
        },
        {
          "s": 10,
          "text": "דלהיות ששם ע\"ב הוא למעלה מתוהו שבו הי' השבירה,"
        },
        {
          "s": 11,
          "text": "לכן נמשך מזה התוקף בכאו\"א מישראל בעבודה הנ\"ל55."
        },
        {
          "s": 12,
          "text": "והגם שגילוי בחי' זו יהי' בעיקר לע\"ל,"
        },
        {
          "s": 13,
          "text": "מ\"מ"
        },
        {
          "s": 14,
          "text": "(ומכיון שבחי' זו היא למעלה מהזמן,"
        },
        {
          "s": 15,
          "text": "לכן)"
        },
        {
          "s": 16,
          "text": "היא פועלת פעולתה גם עכשיו,"
        },
        {
          "s": 17,
          "text": "ובפרט בסוכות."
        },
        {
          "s": 18,
          "text": "וזהו בסוכות תשבו גו' כל האזרח בישראל ישבו בסוכות,"
        },
        {
          "s": 19,
          "text": "שע\"י בחי' האזרח בישראל שתהי' לעתיד,"
        },
        {
          "s": 20,
          "text": "יש כח גם עכשיו שיהי' בסוכות תשבו56,"
        },
        {
          "s": 21,
          "text": "וגם ולקחתם לכם גו' פרי עץ הדר כפות תמרים וענף עץ עבות וערבי נחל,"
        },
        {
          "s": 22,
          "text": "כולל גם הפירוש57"
        },
        {
          "s": 23,
          "text": "פרי עץ הדר זה הקב\"ה כו' כפות תמרים זה הקב\"ה כו' וענף עץ עבות זה הקב\"ה כו' וערבי נחל זה הקב\"ה,"
        },
        {
          "s": 24,
          "text": "כל הדרגות כביכול באלקות,"
        },
        {
          "s": 25,
          "text": "ובאופן דולקחתם לכם שלוקחים את הקב\"ה בבחי' פנימיות,"
        },
        {
          "s": 26,
          "text": "מכיון שישראל"
        },
        {
          "s": 27,
          "text": "(ע\"י אורייתא)"
        },
        {
          "s": 28,
          "text": "וקוב\"ה כולא חד58."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "כן תהי' לנו בההכנה למצות סוכה ובקיום מצות סוכה ומצות ד' מינים בשנה זו,"
        },
        {
          "s": 1,
          "text": "ובקרוב ממש בשנה זו נזכה להגילוי בפועל דכל האזרח בישראל ישבו בסוכות,"
        },
        {
          "s": 2,
          "text": "בביאת משיח צדקנו,"
        },
        {
          "s": 3,
          "text": "יבוא ויגאלנו ויוליכנו קוממיות59"
        },
        {
          "s": 4,
          "text": "לארצנו,"
        },
        {
          "s": 5,
          "text": "במהרה בימינו ממש."
        }
      ]
    }
  ]
}