{
  "globalIndex": 514,
  "owner": 14,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916782_theRebbe_480__p004",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916782_theRebbe_480__p004",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916782_theRebbe_480",
  "title": "מאמר באתי לגני תשכ\"ט",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "והנה זה שהמאור הוא בהתגלות בכל מקום,"
        },
        {
          "s": 2,
          "text": "הוא באופן שאינו פועל בהמקום"
        },
        {
          "s": 3,
          "text": "(ורק ידיעה כללית שיש אלוקה),"
        },
        {
          "s": 4,
          "text": "כי כל פעולה היא ע\"י אור וגילוי50,"
        },
        {
          "s": 5,
          "text": "משא\"כ זה שהמאור הוא בהתגלות"
        },
        {
          "s": 6,
          "text": "[דזה שהמאור הוא בהתגלות אינו ענין הגילוי51],"
        },
        {
          "s": 7,
          "text": "אינו פועל בהמקום."
        },
        {
          "s": 8,
          "text": "ובכדי שזה יהי' באופן של גילוי פעולה בעולם,"
        },
        {
          "s": 9,
          "text": "הוא ע\"י שהזכרת שם שמים"
        },
        {
          "s": 10,
          "text": "[הבאה מצד שהמאור הוא בהתגלות]"
        },
        {
          "s": 11,
          "text": "היא בנוגע לעניני העולם."
        },
        {
          "s": 12,
          "text": "ויש לקשר זה עם הסיפור הידוע52"
        },
        {
          "s": 13,
          "text": "של אדמו\"ר הזקן ששמע מרבו הרב המגיד ע\"ד גודל ההשתדלות של הבעש\"ט שישראל"
        },
        {
          "s": 14,
          "text": "(אנשים נשים וטף)"
        },
        {
          "s": 15,
          "text": "יאמרו דברי תהלה להשי\"ת"
        },
        {
          "s": 16,
          "text": "[כמו \"ברוך השם\","
        },
        {
          "s": 17,
          "text": "\"געלויבט השי\"ת\" וכיו\"ב]"
        },
        {
          "s": 18,
          "text": "על זה שמשפיע להם בריאות ופרנסה,"
        },
        {
          "s": 19,
          "text": "באמרו שתהלות ישראל הם פרנסתו של הקב\"ה כביכול,"
        },
        {
          "s": 20,
          "text": "כמ\"ש53"
        },
        {
          "s": 21,
          "text": "ואתה קדוש יושב תהלות ישראל,"
        },
        {
          "s": 22,
          "text": "שפרנסתו של ואתה קדוש"
        },
        {
          "s": 23,
          "text": "(שעלי' הוא יושב כביכול)"
        },
        {
          "s": 24,
          "text": "היא תהלות ישראל,"
        },
        {
          "s": 25,
          "text": "שישראל משבחים ומהללים אותו ית' על זה שמשפיע להם בני חיי ומזוני רויחי."
        },
        {
          "s": 26,
          "text": "וביאר אדמו\"ר הזקן54"
        },
        {
          "s": 27,
          "text": "שהוא ע\"ד דאיתא במדרש עה\"פ55"
        },
        {
          "s": 28,
          "text": "דמיתיך רעייתי,"
        },
        {
          "s": 29,
          "text": "מפרנסתי הן שירעו אותי בשני תמידין בכל יום."
        },
        {
          "s": 30,
          "text": "וע\"פ הידוע56"
        },
        {
          "s": 31,
          "text": "בפירוש מרז\"ל57"
        },
        {
          "s": 32,
          "text": "ישראל מפרנסין לאביהם שבשמים,"
        },
        {
          "s": 33,
          "text": "דכמו שפרנסה כפשוטה היא שעל ידה נעשה חיבור הנשמה עם הגוף עד\"ז הוא גם הפרנסה למעלה שענינה הוא שתהי' המשכת והתלבשות אוא\"ס בהספירות שנק' בשם גוף,"
        },
        {
          "s": 34,
          "text": "מובן,"
        },
        {
          "s": 35,
          "text": "דזה שפרנסתו של ואתה קדוש הוא תהלות ישראל,"
        },
        {
          "s": 36,
          "text": "הוא שע\"י תהלות ישראל נעשה המשכת אוא\"ס בהספירות,"
        },
        {
          "s": 37,
          "text": "ועל ידם – בההשפעות שהקב\"ה משפיע לישראל ע\"י הספירות,"
        },
        {
          "s": 38,
          "text": "ובפרט – באותם ההשפעות שישראל מהללים אותו ית' על זה שהשפיע להם השפעות אלו."
        },
        {
          "s": 39,
          "text": "דההשפעות כמו שהם מצד עצמם"
        },
        {
          "s": 40,
          "text": "(לפני העבודה דתהלות ישראל),"
        },
        {
          "s": 41,
          "text": "נמשכות ע\"י הספירות שהם באין ערוך לגבי אוא\"ס,"
        },
        {
          "s": 42,
          "text": "וע\"י שישראל מהללים אותו ית',"
        },
        {
          "s": 43,
          "text": "את העצמות"
        },
        {
          "s": 44,
          "text": "[שהרי כוונתם בזה שאומרים \"ברוך השם\","
        },
        {
          "s": 45,
          "text": "\"געלויבט השי\"ת\" וכיו\"ב היא לעצמותו ית'],"
        },
        {
          "s": 46,
          "text": "על זה שהשפיע להם ההשפעות,"
        },
        {
          "s": 47,
          "text": "עי\"ז נמשך גילוי עצמות אוא\"ס בהשפעות אלו."
        },
        {
          "s": 48,
          "text": "ועפ\"ז יובן מ\"ש בתורת הבעש\"ט"
        },
        {
          "s": 49,
          "text": "(הנ\"ל)"
        },
        {
          "s": 50,
          "text": "שתהלות ישראל שעליהם הקב\"ה יושב ומתפרנס הם התהלות על זה שמשפיע להם בגשמיות"
        },
        {
          "s": 51,
          "text": "(\"פאַר דעם געזונט און פרנסה וואָס ער ב\"ה גיט זיי\"),"
        },
        {
          "s": 52,
          "text": "כי בכדי שתהי' המשכת עצמות אוא\"ס בענינים הגשמיים צריך להיות גם ההילול בענינים אלו."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "ויובן זה ע\"פ הידוע58"
        },
        {
          "s": 2,
          "text": "בענין אתעדל\"ע הנמשכת ע\"י אתעדל\"ת,"
        },
        {
          "s": 3,
          "text": "דהגם שזה שאתעדל\"ת מעוררת וממשכת האתעדל\"ע אינו מצד מעלת האתעדל\"ת עצמה אלא מפני שכך עלה ברצונו ית',"
        },
        {
          "s": 4,
          "text": "מ\"מ,"
        },
        {
          "s": 5,
          "text": "צ\"ל האתעדל\"ת בדוגמת האתעדל\"ע הנמשכת על ידה."
        },
        {
          "s": 6,
          "text": "וכתורת הרב המגיד59"
        },
        {
          "s": 7,
          "text": "עה\"פ60"
        },
        {
          "s": 8,
          "text": "ועל דמות הכסא דמות כמראה אדם עליו מלמעלה,"
        },
        {
          "s": 9,
          "text": "(דפירוש דמות כמראה אדם הוא)"
        },
        {
          "s": 10,
          "text": "שכפי המדה שהאדם מראה מלמטה כן מראין לו מלמעלה."
        },
        {
          "s": 11,
          "text": "ויש לומר,"
        },
        {
          "s": 12,
          "text": "שמקור ענין זה הוא מאמר הזהר61"
        },
        {
          "s": 13,
          "text": "תא חזי"
        },
        {
          "s": 14,
          "text": "(שאפשר לראות זה בראי' מוחשית)"
        },
        {
          "s": 15,
          "text": "כו',"
        },
        {
          "s": 16,
          "text": "אי איהו קיימא בנהירו דאנפין מתתא כדין הכי נהרין לי' מעילא כו' חדוה דב\"נ משיך לגבי' חדוה אחרא עילאה כו'."
        },
        {
          "s": 17,
          "text": "ויתירה מזו,"
        },
        {
          "s": 18,
          "text": "שגם זה שע\"י עבודת האדם נעשים הענינים למעלה62,"
        },
        {
          "s": 19,
          "text": "כתורת הרב המגיד63"
        },
        {
          "s": 20,
          "text": "על מרז\"ל64"
        },
        {
          "s": 21,
          "text": "דע מה למעלה ממך,"
        },
        {
          "s": 22,
          "text": "דכל מה שלמעלה הכל הוא ממך,"
        },
        {
          "s": 23,
          "text": "צריכה להיות העבודה בדוגמת הענין דלמעלה שנעשה על ידה."
        },
        {
          "s": 24,
          "text": "ויש לומר,"
        },
        {
          "s": 25,
          "text": "שעד\"ז הוא בהמשכת עצמות אוא\"ס שע\"י העבודה דתהלות ישראל,"
        },
        {
          "s": 26,
          "text": "דהגם שבנוגע לההמשכה עצמה אין שייך לומר לכאורה שהיא נמשכת ע\"י העבודה65,"
        },
        {
          "s": 27,
          "text": "מ\"מ,"
        },
        {
          "s": 28,
          "text": "בנוגע להמקום שבו תהי' ההמשכה,"
        },
        {
          "s": 29,
          "text": "צריכה להיות העבודה"
        },
        {
          "s": 30,
          "text": "(ההילול)"
        },
        {
          "s": 31,
          "text": "בענינים אלו שבהם תבוא ההמשכה."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ויש להוסיף,"
        },
        {
          "s": 1,
          "text": "דבההמשכה שעל ידי תהלות ישראל,"
        },
        {
          "s": 2,
          "text": "שני ענינים."
        },
        {
          "s": 3,
          "text": "המשכה כללית,"
        },
        {
          "s": 4,
          "text": "כהפירוש66"
        },
        {
          "s": 5,
          "text": "ביושב תהלות ישראל שעל ידי תהלות ישראל הוא נמשך למטה"
        },
        {
          "s": 6,
          "text": "[שההמשכה נק' בשם ישיבה,"
        },
        {
          "s": 7,
          "text": "כמו היושב שמשפיל קומתו],"
        },
        {
          "s": 8,
          "text": "המשכה וגילוי בכלל67"
        },
        {
          "s": 9,
          "text": "שנעשה ע\"י"
        },
        {
          "s": 10,
          "text": "(כללות ענין)"
        },
        {
          "s": 11,
          "text": "ההילול מלשון בהלו68"
        },
        {
          "s": 12,
          "text": "נרו69,"
        },
        {
          "s": 13,
          "text": "והמשכה שבדוגמת התלבשות בענין פרטי"
        },
        {
          "s": 14,
          "text": "(ע\"י שהתהלות ישראל הם בנוגע לענינים פרטים),"
        },
        {
          "s": 15,
          "text": "כפירוש הבעש\"ט ביושב תהלות ישראל,"
        },
        {
          "s": 16,
          "text": "שתהלות ישראל הם פרנסתו של הקב\"ה כביכול שעליהם הוא יושב."
        },
        {
          "s": 17,
          "text": "דענין הפרנסה הוא דוגמת הפרנסה כפשוטה שעל ידה נעשה חיבור הנפש עם הגוף בפנימיות,"
        },
        {
          "s": 18,
          "text": "שהגוף חי מהנפש."
        }
      ]
    }
  ]
}