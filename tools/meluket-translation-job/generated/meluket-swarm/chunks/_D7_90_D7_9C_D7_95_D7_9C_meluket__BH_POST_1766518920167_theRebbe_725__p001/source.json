{
  "globalIndex": 1072,
  "owner": 22,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920167_theRebbe_725__p001",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920167_theRebbe_725__p001",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920167_theRebbe_725",
  "title": "מאמר אני לדודי תשכ\"ו",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ ראה,"
        },
        {
          "s": 2,
          "text": "מבה\"ח אלול,"
        },
        {
          "s": 3,
          "text": "ה'תשכ\"ו"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "אני לדודי ודודי לי1"
        },
        {
          "s": 1,
          "text": "ר\"ת אלול2,"
        },
        {
          "s": 2,
          "text": "ומבואר בלקו\"ת בהמאמר ד\"ה זה3"
        },
        {
          "s": 3,
          "text": "השייכות דאלול לאני לדודי ודודי לי4,"
        },
        {
          "s": 4,
          "text": "כי באלול הוא אתערותא דלתתא,"
        },
        {
          "s": 5,
          "text": "אני לדודי,"
        },
        {
          "s": 6,
          "text": "ובראש השנה ויום הכיפורים היא ההמשכה מלמעלה למטה"
        },
        {
          "s": 7,
          "text": "(אתערותא דלעילא),"
        },
        {
          "s": 8,
          "text": "ודודי לי."
        },
        {
          "s": 9,
          "text": "וההמשכה שבר\"ה ויוהכ\"פ היא ע\"י האתדל\"ת שבאלול."
        },
        {
          "s": 10,
          "text": "וזהו שאלול הוא ר\"ת אני לדודי ודודי לי"
        },
        {
          "s": 11,
          "text": "[שגם ודודי לי נכלל בר\"ת אלול],"
        },
        {
          "s": 12,
          "text": "כי האתעדל\"ת שבאלול"
        },
        {
          "s": 13,
          "text": "(אני לדודי)"
        },
        {
          "s": 14,
          "text": "היא"
        },
        {
          "s": 15,
          "text": "(גם)"
        },
        {
          "s": 16,
          "text": "הקדמה לההמשכה"
        },
        {
          "s": 17,
          "text": "(ודודי לי)"
        },
        {
          "s": 18,
          "text": "שבר\"ה ויוהכ\"פ5."
        },
        {
          "s": 19,
          "text": "וצריך ביאור,"
        },
        {
          "s": 20,
          "text": "כי מזה שהאותיות ו' ל'"
        },
        {
          "s": 21,
          "text": "(ר\"ת ודודי לי)"
        },
        {
          "s": 22,
          "text": "הם מתיבת אלול עצמה,"
        },
        {
          "s": 23,
          "text": "משמע,"
        },
        {
          "s": 24,
          "text": "שחודש אלול הוא לא רק הקדמה לודודי לי,"
        },
        {
          "s": 25,
          "text": "אלא שבחודש אלול הוא גם הענין דודודי לי."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 2,
          "text": "שבאלול הוא זמן י\"ג מדות הרחמים6."
        },
        {
          "s": 3,
          "text": "דהגם שבאלול הוא אני לדודי,"
        },
        {
          "s": 4,
          "text": "אתערותא דלתתא,"
        },
        {
          "s": 5,
          "text": "מ\"מ,"
        },
        {
          "s": 6,
          "text": "האתערותא דלתתא של האדם,"
        },
        {
          "s": 7,
          "text": "ובפרט כשהוא רחוק מאלקות,"
        },
        {
          "s": 8,
          "text": "הוא ע\"י התעוררות ונתינת כח מלמעלה."
        },
        {
          "s": 9,
          "text": "וגילוי י\"ג מדות הרחמים שבאלול,"
        },
        {
          "s": 10,
          "text": "דגילוי זה הוא לכאו\"א מישראל,"
        },
        {
          "s": 11,
          "text": "גם להרחוקים ביותר7,"
        },
        {
          "s": 12,
          "text": "הוא הנתינת כח מלמעלה על העבודה דאני לדודי."
        },
        {
          "s": 13,
          "text": "אלא שהגילוי שבאלול הוא"
        },
        {
          "s": 14,
          "text": "(בעיקר)"
        },
        {
          "s": 15,
          "text": "רק נתינת כח"
        },
        {
          "s": 16,
          "text": "(ולא שהגילוי מעורר את האדם),"
        },
        {
          "s": 17,
          "text": "והעבודה עצמה באה מהאדם,"
        },
        {
          "s": 18,
          "text": "אני לדודי."
        },
        {
          "s": 19,
          "text": "וזוהי המעלה שבאלול לגבי עשי\"ת,"
        },
        {
          "s": 20,
          "text": "דבעשי\"ת ובפרט בר\"ה ויוהכ\"פ,"
        },
        {
          "s": 21,
          "text": "הגילוי הוא באופן שהגילוי מעורר את האדם ועבודת האדם היא כמו תוצאה מהגילוי מלמעלה."
        },
        {
          "s": 22,
          "text": "ועיקר הענין והמעלה דעבודת האדם"
        },
        {
          "s": 23,
          "text": "(עבודה בכח עצמו)"
        },
        {
          "s": 24,
          "text": "אני לדודי,"
        },
        {
          "s": 25,
          "text": "הוא באלול."
        }
      ]
    }
  ]
}