{
  "globalIndex": 190,
  "owner": 40,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914882_theRebbe_998__p004",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914882_theRebbe_998__p004",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518914882_theRebbe_998",
  "title": "מאמר ויהיו חיי שרה תש\"ל",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "והנה ידוע29"
        },
        {
          "s": 2,
          "text": "ששני הענינים דממלא וסובב שרשם הוא באוא\"ס שלפני הצמצום,"
        },
        {
          "s": 3,
          "text": "דאור הגבול"
        },
        {
          "s": 4,
          "text": "(שלפני הצמצום)"
        },
        {
          "s": 5,
          "text": "הוא השרש דאור הממלא,"
        },
        {
          "s": 6,
          "text": "ואור הבלי גבול הוא השרש דאור הסובב."
        },
        {
          "s": 7,
          "text": "והחילוק בין פעולת הצמצום באור הגבול"
        },
        {
          "s": 8,
          "text": "(שרש הממלא)"
        },
        {
          "s": 9,
          "text": "ופעולת הצמצום באור הבל\"ג"
        },
        {
          "s": 10,
          "text": "(שרש הסובב)"
        },
        {
          "s": 11,
          "text": "הוא,"
        },
        {
          "s": 12,
          "text": "דפעולת הצמצום באור הגבול היא בהאור עצמו,"
        },
        {
          "s": 13,
          "text": "שע\"י הצמצום בא במדה וגבול לפי ערך העולמות,"
        },
        {
          "s": 14,
          "text": "ממלא כל עלמין."
        },
        {
          "s": 15,
          "text": "ופעולת הצמצום באור הבל\"ג היא"
        },
        {
          "s": 16,
          "text": "(לא בהאור עצמו,"
        },
        {
          "s": 17,
          "text": "אלא)"
        },
        {
          "s": 18,
          "text": "שלא יאיר במקום החלל."
        },
        {
          "s": 19,
          "text": "ומזה נעשה הענין דסובב,"
        },
        {
          "s": 20,
          "text": "שהאור אינו מאיר"
        },
        {
          "s": 21,
          "text": "(בעולמות,"
        },
        {
          "s": 22,
          "text": "מקום החלל)"
        },
        {
          "s": 23,
          "text": "בגילוי ובפנימיות אלא בבחינת מקיף והעלם."
        },
        {
          "s": 24,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 25,
          "text": "שב' הענינים שבבחינת כל"
        },
        {
          "s": 26,
          "text": "[שעל ידי היסוד הוא המשכת המדות והמוחין,"
        },
        {
          "s": 27,
          "text": "ושע\"י היסוד הוא המשכת הכתר]"
        },
        {
          "s": 28,
          "text": "בשרשם באוא\"ס שלפני הצמצום הם אור הגבול ואור הבל\"ג,"
        },
        {
          "s": 29,
          "text": "וע\"י קיום המצוות נמשך30"
        },
        {
          "s": 30,
          "text": "אור חדש שלא האיר גם קודם הצמצום."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "וזהו שלע\"ל יהיו שמים חדשים וארץ חדשה31,"
        },
        {
          "s": 1,
          "text": "כי אז יתגלו כל הענינים שנמשכים ע\"י מעשינו ועבודתינו עכשיו32,"
        },
        {
          "s": 2,
          "text": "כולל האור חדש שנמשך ע\"י קיום התומ\"צ עכשיו,"
        },
        {
          "s": 3,
          "text": "ועי\"ז תהי' התחדשות גם בעולם,"
        },
        {
          "s": 4,
          "text": "שמים חדשים וארץ חדשה."
        },
        {
          "s": 5,
          "text": "דזה שלע\"ל יומשך בעולם גילוי אור הבל\"ג שהאיר קודם הצמצום,"
        },
        {
          "s": 6,
          "text": "אין זה חידוש אמיתי."
        },
        {
          "s": 7,
          "text": "דכיון שאור זה הי' כבר בגילוי במקום החלל אלא שע\"י הצמצום נסתלק האור,"
        },
        {
          "s": 8,
          "text": "לכן,"
        },
        {
          "s": 9,
          "text": "כשהאור חוזר ונמשך,"
        },
        {
          "s": 10,
          "text": "אין זה חידוש אמיתי."
        },
        {
          "s": 11,
          "text": "וזה שלע\"ל יהיו שמים חדשים וארץ חדשה הוא,"
        },
        {
          "s": 12,
          "text": "כי אז יהי' גילוי האור חדש"
        },
        {
          "s": 13,
          "text": "(שנמשך ע\"י קיום התומ\"צ עכשיו)"
        },
        {
          "s": 14,
          "text": "שלא הי' גם קודם הצמצום."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "והנה33 ידוע,"
        },
        {
          "s": 2,
          "text": "דזה שהבריאה היא בשביל ישראל34,"
        },
        {
          "s": 3,
          "text": "הכוונה בזה היא לא רק לבריאת העולם אלא גם לכל הגילויים,"
        },
        {
          "s": 4,
          "text": "גם לגילויים הכי נעלים."
        },
        {
          "s": 5,
          "text": "ומזה מובן גם בנוגע לאור הנ\"ל שלא האיר גם קודם הצמצום,"
        },
        {
          "s": 6,
          "text": "דזה שנעשה"
        },
        {
          "s": 7,
          "text": "(כביכול)"
        },
        {
          "s": 8,
          "text": "אור זה"
        },
        {
          "s": 9,
          "text": "(שלמעלה מגדר המשכה וגילוי)"
        },
        {
          "s": 10,
          "text": "הוא בכדי שע\"י עבודתם של ישראל יהי' אח\"כ בהמשכה וגילוי,"
        },
        {
          "s": 11,
          "text": "ושההמשכה והגילוי שלו יהיו בעולם"
        },
        {
          "s": 12,
          "text": "[וכנ\"ל שע\"י האור חדש,"
        },
        {
          "s": 13,
          "text": "השמים והארץ יהיו חדשים],"
        },
        {
          "s": 14,
          "text": "ועי\"ז תושלם הכוונה דדירה בתחתונים."
        },
        {
          "s": 15,
          "text": "ועפ\"ז יש לקשר פירוש הזהר במלך לשדה נעבד"
        },
        {
          "s": 16,
          "text": "(שנעבד קאי על שדה)"
        },
        {
          "s": 17,
          "text": "עם הפירוש"
        },
        {
          "s": 18,
          "text": "(הפשוט)"
        },
        {
          "s": 19,
          "text": "שנעבד קאי על מלך,"
        },
        {
          "s": 20,
          "text": "שגם עצם האור שלמעלה מגדר המשכה וגילוי"
        },
        {
          "s": 21,
          "text": "(מלך עילאה)"
        },
        {
          "s": 22,
          "text": "נעבד כביכול לעבודת השדה"
        },
        {
          "s": 23,
          "text": "(שדה נעבד),"
        },
        {
          "s": 24,
          "text": "קיום המצוות."
        }
      ]
    }
  ]
}