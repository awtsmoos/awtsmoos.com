  "globalIndex": 271,
  "owner": 21,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915336_theRebbe_861__p004",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915336_theRebbe_861__p004",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915336_theRebbe_861",
  "title": "מאמר פדה בשלום תשל\"ט",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ויש לומר שזהו גם הקשר והשייכות של הגאולה דיו\"ד כסלו ודי\"ט כסלו להפסוק פדה בשלום נפשי49,"
        },
        {
          "s": 2,
          "text": "דהגם שהפדי' היתה מקרב,"
        },
        {
          "s": 3,
          "text": "כולל גם זה שהמאסר בא ע\"י המלשינות של אלו שהי' להם יחס של קירוב,"
        },
        {
          "s": 4,
          "text": "דזה"
        },
        {
          "s": 5,
          "text": "(שהמאסר בא על ידם)"
        },
        {
          "s": 6,
          "text": "הוא ירידה וצער גדול,"
        },
        {
          "s": 7,
          "text": "ואעפ\"כ היתה הפדי' בשלום ובשלימות,"
        },
        {
          "s": 8,
          "text": "ועד שזה נעשה הקדמה והכנה לתכלית השלימות שיהי' לע\"ל."
        },
        {
          "s": 9,
          "text": "שע\"י יפוצו מעינותיך חוצה שהותחל בעיקר בי\"ט כסלו50,"
        },
        {
          "s": 10,
          "text": "ובפרט ע\"י העבודה של בעל הגאולה דיו\"ד כסלו שהפצת המעינות שלו היתה באופן של רחובות הנהר51,"
        },
        {
          "s": 11,
          "text": "היינו שהמשיך את המעיין באופן של רחובות הנהר,"
        },
        {
          "s": 12,
          "text": "הנה עי\"ז אתי מר דא מלכא משיחא52,"
        },
        {
          "s": 13,
          "text": "שאז יהיו שלום ושלוה אמיתים בתכלית השלימות."
        },
        {
          "s": 14,
          "text": "וטועמי' חיים זכו53,"
        },
        {
          "s": 15,
          "text": "שמתחילים לטעום מעין זה עוד בימי הגלות האחרונים,"
        },
        {
          "s": 16,
          "text": "שיכולים להתעסק מתוך מנוחה ושמחה וטוב לבב בהעבודה דיפוצו מעינותיך חוצה באופן דמוסיף והולך ואור."
        },
        {
          "s": 17,
          "text": "ובקרוב ממש נזכה ללילה כיום יאיר54,"
        },
        {
          "s": 18,
          "text": "בביאת משיח צדקנו."
        }
      ]
    }
  ]
}