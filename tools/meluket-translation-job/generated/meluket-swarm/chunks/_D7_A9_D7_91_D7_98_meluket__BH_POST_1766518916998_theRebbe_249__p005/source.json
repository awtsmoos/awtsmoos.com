{
  "globalIndex": 569,
  "owner": 19,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916998_theRebbe_249__p005",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916998_theRebbe_249__p005",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916998_theRebbe_249",
  "title": "מאמר ארבעה ראשי שנים תשל\"א",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יובן מה שמובא לעיל"
        },
        {
          "s": 1,
          "text": "(סעיף ז)"
        },
        {
          "s": 2,
          "text": "מהמשך תרס\"ו,"
        },
        {
          "s": 3,
          "text": "דזה שהעבד משתדל שהמלאכה שעושה תהי' לנוי ולתפארת לאדונו הוא לפי שיש לו תענוג בהעבודה והתענוג שלו הוא תענוג האדון."
        },
        {
          "s": 4,
          "text": "דלכאורה אינו מובן,"
        },
        {
          "s": 5,
          "text": "הרי השייכות דהעבד להאדון היא לדרגת האדון ששייכת אליו"
        },
        {
          "s": 6,
          "text": "(שהוא משועבד להאדון),"
        },
        {
          "s": 7,
          "text": "ואיך נרגש בו התענוג דהאדון בהנוי והתפארת דהמלאכה שאינה שייכת"
        },
        {
          "s": 8,
          "text": "(לכאורה)"
        },
        {
          "s": 9,
          "text": "להשעבוד והביטול דהעבד להאדון."
        },
        {
          "s": 10,
          "text": "ויש לומר הביאור בזה בהנמשל"
        },
        {
          "s": 11,
          "text": "(ומזה משתלשל גם בהמשל),"
        },
        {
          "s": 12,
          "text": "דע\"י שהביטול דקב\"ע"
        },
        {
          "s": 13,
          "text": "(כמו שהוא מצד זה שהתורה אמרה ועבדתם גו')"
        },
        {
          "s": 14,
          "text": "הוא להשלים הכוונה בזה שהקב\"ה צמצם עצמו כביכול לצוות להאדם,"
        },
        {
          "s": 15,
          "text": "דכוונה זו היא בהקב\"ה עצמו שלמעלה מענין הציווי,"
        },
        {
          "s": 16,
          "text": "לכן נרגש בו גם ענין התענוג דהאדון עצמו."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "וזהו בחמשה עשר בשבט ר\"ה לאילן,"
        },
        {
          "s": 3,
          "text": "דאילן רומז על תורה"
        },
        {
          "s": 4,
          "text": "(כנ\"ל סעיף ב),"
        },
        {
          "s": 5,
          "text": "שביום זה נמשך נתינת כח על כל השנה בנוגע לעסק התורה,"
        },
        {
          "s": 6,
          "text": "שלימוד התורה יהי' בשקידה ובהתמדה,"
        },
        {
          "s": 7,
          "text": "ושהתורה שלומד תהי' התענוג והחיות שלו"
        },
        {
          "s": 8,
          "text": "(דאילן הו\"ע התענוג,"
        },
        {
          "s": 9,
          "text": "כנ\"ל סעיף ו)."
        },
        {
          "s": 10,
          "text": "וע\"פ הידוע67"
        },
        {
          "s": 11,
          "text": "שכל ארבעה ראשי השנים שייכים זל\"ז,"
        },
        {
          "s": 12,
          "text": "יש לומר,"
        },
        {
          "s": 13,
          "text": "דבר\"ה לאילן נמשך הנתינת כח שגם כל הענינים דעבודת האדם"
        },
        {
          "s": 14,
          "text": "(הנמשכים בג' ראשי שנה הראשונים)"
        },
        {
          "s": 15,
          "text": "יהיו מתוך תענוג,"
        },
        {
          "s": 16,
          "text": "ע\"ד המבואר לעיל סעיף ט שע\"י התורה,"
        },
        {
          "s": 17,
          "text": "גם העבודה דקב\"ע היא בתענוג."
        },
        {
          "s": 18,
          "text": "וזהו שר\"ה לאילן הוא בחמשה עשר שבו הוא שלימות הלבנה,"
        },
        {
          "s": 19,
          "text": "ולא כג' ראשי שנים הראשונים שהם בר\"ח שאז הלבנה היא רק נקודה,"
        },
        {
          "s": 20,
          "text": "כי זה שהלבנה היא רק נקודה מורה על ענין הביטול68,"
        },
        {
          "s": 21,
          "text": "והתענוג שבעבודת ה',"
        },
        {
          "s": 22,
          "text": "ובפרט התענוג דתורה,"
        },
        {
          "s": 23,
          "text": "הו\"ע השלימות."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "וע\"י ההוספה במעשינו ועבודתינו69,"
        },
        {
          "s": 1,
          "text": "ובפרט בעסק התורה ובאופן שהתורה היא התענוג והחיות של האדם העוסק בתורה,"
        },
        {
          "s": 2,
          "text": "ומכש\"כ ע\"י העסק"
        },
        {
          "s": 3,
          "text": "(וההפצה)"
        },
        {
          "s": 4,
          "text": "דפנימיות התורה"
        },
        {
          "s": 5,
          "text": "[דבתורה עצמה בחינת התענוג דתורה היא פנימיות התורה],"
        },
        {
          "s": 6,
          "text": "יהי' גם ר\"ה למלכים בתכלית השלימות,"
        },
        {
          "s": 7,
          "text": "שיראו בגילוי שכל ישראל בני מלכים הם70,"
        },
        {
          "s": 8,
          "text": "ויתירה מזה – מלכים"
        },
        {
          "s": 9,
          "text": "(כמפורש בתקו\"ז71),"
        },
        {
          "s": 10,
          "text": "ובני ישראל יוצאים ביד רמה72,"
        },
        {
          "s": 11,
          "text": "כמתאים למלכים,"
        },
        {
          "s": 12,
          "text": "ע\"י דוד מלכא משיחא,"
        },
        {
          "s": 13,
          "text": "ועבדי דוד מלך עליהם גו'73,"
        },
        {
          "s": 14,
          "text": "בגאולה האמיתית והשלימה,"
        },
        {
          "s": 15,
          "text": "בקרוב ממש."
        }
      ]
    }
  ]
}