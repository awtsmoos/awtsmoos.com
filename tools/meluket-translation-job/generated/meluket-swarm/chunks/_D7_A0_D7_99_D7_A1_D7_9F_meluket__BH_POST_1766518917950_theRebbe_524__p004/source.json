{
  "globalIndex": 713,
  "owner": 13,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917950_theRebbe_524__p004",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917950_theRebbe_524__p004",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917950_theRebbe_524",
  "title": "מאמר על שלושה דברים תשי\"ד",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "והנה כמו שטל"
        },
        {
          "s": 2,
          "text": "(כפשוטו)"
        },
        {
          "s": 3,
          "text": "יורד ונמשך למטה,"
        },
        {
          "s": 4,
          "text": "כמו\"כ הוא גם בטל תורה,"
        },
        {
          "s": 5,
          "text": "שהוא נמשך ומתגלה למטה בתורה שהאדם לומד."
        },
        {
          "s": 6,
          "text": "דנוסף על זה דזה שהקב\"ה יושב ועוסק בתורה"
        },
        {
          "s": 7,
          "text": "(בחינת טל תורה)"
        },
        {
          "s": 8,
          "text": "הוא נתינת כח לאדם שיוכל לעסוק בתורה ושע\"י עסק התורה שלו יהי' הקב\"ה קורא ושונה כנגדו,"
        },
        {
          "s": 9,
          "text": "הנה גם הענין דטל תורה עצמו נמשך ומתגלה למטה בהתורה שהאדם לומד."
        },
        {
          "s": 10,
          "text": "דבהמשכת התורה דלמעלה בהתורה שהאדם לומד,"
        },
        {
          "s": 11,
          "text": "שני ענינים."
        },
        {
          "s": 12,
          "text": "התורה כמו שהיא בז\"ת דעתיק,"
        },
        {
          "s": 13,
          "text": "מטר דתורה."
        },
        {
          "s": 14,
          "text": "והמשכת בחינה זו היא ע\"י עסק התורה דהאדם,"
        },
        {
          "s": 15,
          "text": "דכיון שז\"ת דעתיק מתלבשים באריך שורש ההשתלשלות,"
        },
        {
          "s": 16,
          "text": "לכן עסק התורה דהאדם הוא אתעדל\"ת שמעורר וממשיך בחינה זו."
        },
        {
          "s": 17,
          "text": "והתורה כמו שהיא בג\"ר דעתיק,"
        },
        {
          "s": 18,
          "text": "טל תורה."
        },
        {
          "s": 19,
          "text": "והמשכת בחינה זו היא מלמעלה,"
        },
        {
          "s": 20,
          "text": "ועסק התורה דהאדם הוא רק כמו כלי שבו נמשך ומתגלה הטל דתורה."
        },
        {
          "s": 21,
          "text": "ויש לומר,"
        },
        {
          "s": 22,
          "text": "דזה שלימוד התורה דהאדם הוא כלי לטל תורה הוא בעיקר בהלימוד דפנימיות התורה."
        },
        {
          "s": 23,
          "text": "דכיון שפנימיות התורה"
        },
        {
          "s": 24,
          "text": "(גם כמו שנמשכה למטה)"
        },
        {
          "s": 25,
          "text": "היא אילנא דחיי שלמעלה מענין הבירורים39,"
        },
        {
          "s": 26,
          "text": "לכן היא כמו כלי לעצם התורה שלמעלה משייכות להשתלשלות"
        },
        {
          "s": 27,
          "text": "(ג\"ר דעתיק שאינם מתלבשים באריך),"
        },
        {
          "s": 28,
          "text": "טל תורה."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש לבאר הקשר דשני הגירסאות במארז\"ל40"
        },
        {
          "s": 1,
          "text": "כל המשתמש באור תורה אור תורה מחייהו,"
        },
        {
          "s": 2,
          "text": "שהגירסא בגמרא היא אור תורה והגירסא בילקוט41"
        },
        {
          "s": 3,
          "text": "היא טל תורה,"
        },
        {
          "s": 4,
          "text": "דיש לומר,"
        },
        {
          "s": 5,
          "text": "שאור תורה הוא פנימיות התורה,"
        },
        {
          "s": 6,
          "text": "ולימוד פנימיות התורה הוא כלי לטל תורה42."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ז)"
        },
        {
          "s": 1,
          "text": "ועד\"ז הוא בתפלה,"
        },
        {
          "s": 2,
          "text": "דהגם שבכללות היא העלאה מלמטה למעלה,"
        },
        {
          "s": 3,
          "text": "יש בה גם ענין ההמשכה מלמעלה למטה."
        },
        {
          "s": 4,
          "text": "והענין הוא43,"
        },
        {
          "s": 5,
          "text": "דהתחלת תפלת שמו\"ע"
        },
        {
          "s": 6,
          "text": "[שהיא עיקר התפלה]"
        },
        {
          "s": 7,
          "text": "הוא בפסוק44"
        },
        {
          "s": 8,
          "text": "אד' שפתי תפתח ופי יגיד תהלתך,"
        },
        {
          "s": 9,
          "text": "דאמירת פסוק זה הוא"
        },
        {
          "s": 10,
          "text": "(לא רק הקדמה לתפלה,"
        },
        {
          "s": 11,
          "text": "אלא)"
        },
        {
          "s": 12,
          "text": "התחלת התפלה עצמה,"
        },
        {
          "s": 13,
          "text": "כדאיתא בגמרא45"
        },
        {
          "s": 14,
          "text": "שהוא כתפלה אריכתא."
        },
        {
          "s": 15,
          "text": "והנה בתרגום עה\"פ אד' שפתי תפתח פירש,"
        },
        {
          "s": 16,
          "text": "ספותי פתח באורייתא."
        },
        {
          "s": 17,
          "text": "היינו,"
        },
        {
          "s": 18,
          "text": "דהבקשה שבפסוק זה שבתחלת התפלה היא,"
        },
        {
          "s": 19,
          "text": "שהתפלה"
        },
        {
          "s": 20,
          "text": "(ופי יגיד תהלתך)"
        },
        {
          "s": 21,
          "text": "תהי' כמו תורה"
        },
        {
          "s": 22,
          "text": "(אד' שפתי תפתח באורייתא)."
        },
        {
          "s": 23,
          "text": "דכמו שבתורה,"
        },
        {
          "s": 24,
          "text": "התורה שהאדם לומד הוא דבר ה',"
        },
        {
          "s": 25,
          "text": "דברי אשר שמתי בפיך46,"
        },
        {
          "s": 26,
          "text": "והאדם הוא כעונה אחר הקורא47,"
        },
        {
          "s": 27,
          "text": "כמו\"כ גם התפלה תהי' באופן דופי יגיד תהלתך,"
        },
        {
          "s": 28,
          "text": "שתפלת האדם תהי'"
        },
        {
          "s": 29,
          "text": "(לא התפלה שלו,"
        },
        {
          "s": 30,
          "text": "אלא)"
        },
        {
          "s": 31,
          "text": "רק שעל ידה תומשך"
        },
        {
          "s": 32,
          "text": "(יגיד מלשון המשכה)"
        },
        {
          "s": 33,
          "text": "תהלתך,"
        },
        {
          "s": 34,
          "text": "תפלתו של הקב\"ה."
        }
      ]
    }
  ]
}