{
  "globalIndex": 587,
  "owner": 37,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917104_theRebbe_810__p005",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518917104_theRebbe_810__p005",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518917104_theRebbe_810",
  "title": "מאמר באתי לגני תשל\"ו",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "וביאור השייכות דבחינת יו\"ד לא\"י"
        },
        {
          "s": 1,
          "text": "(מה שבא\"י דוקא הוא רבי ביו\"ד),"
        },
        {
          "s": 2,
          "text": "יובן בהקדם תורת הרב המגיד78"
        },
        {
          "s": 3,
          "text": "עה\"פ79"
        },
        {
          "s": 4,
          "text": "ארץ אשר ה\"א גו' תמיד עיני ה\"א גו',"
        },
        {
          "s": 5,
          "text": "דבספר הזהר80"
        },
        {
          "s": 6,
          "text": "הקשה כתיב81"
        },
        {
          "s": 7,
          "text": "עין ה' אל יראיו לשון יחיד וכתיב82"
        },
        {
          "s": 8,
          "text": "עיני ה' אל צדיקים לשון רבים."
        },
        {
          "s": 9,
          "text": "ולפי פשוטו י\"ל כי הנה חכמים נקראו83"
        },
        {
          "s": 10,
          "text": "עיני העדה."
        },
        {
          "s": 11,
          "text": "וכתיב84"
        },
        {
          "s": 12,
          "text": "חכמות בחוץ תרונה ב' חכמות חכמה עילאה וחכמה תתאה85."
        },
        {
          "s": 13,
          "text": "והנה יש יראה פנימית ויראה חיצונית יראה חיצונית היא היראה שמחמת גדלות86,"
        },
        {
          "s": 14,
          "text": "היינו שאינו מכיר פנימיותו ורק שרואה את גדלו ומחמת זה הוא ירא"
        },
        {
          "s": 15,
          "text": "[וע\"ד המבואר בתניא87,"
        },
        {
          "s": 16,
          "text": "שגם כשלא ראה את המלך מעולם ואינו מכירו כלל ורק רואה ששרים רבים ונכבדים משתחווים לאיש אחד,"
        },
        {
          "s": 17,
          "text": "תפול עליו אימה ופחד],"
        },
        {
          "s": 18,
          "text": "ויראה פנימית היא שמכיר את פנימיותו וחשיבותו ומחמת זה הוא ירא ומתבייש מפניו."
        },
        {
          "s": 19,
          "text": "ויראה זו נקראת יראה בושת86."
        },
        {
          "s": 20,
          "text": "וב' בחינות אלו שביראה הן נגד חכמה עילאה וחכמה תתאה."
        },
        {
          "s": 21,
          "text": "דבחכמה תתאה,"
        },
        {
          "s": 22,
          "text": "שהיא בחינת מלכות,"
        },
        {
          "s": 23,
          "text": "שם היראה היא מחמת גדלות,"
        },
        {
          "s": 24,
          "text": "ובחכמה עילאה"
        },
        {
          "s": 25,
          "text": "(היינו בחינת חכמה)"
        },
        {
          "s": 26,
          "text": "היראה היא מחמת פנימיות."
        },
        {
          "s": 27,
          "text": "והנה כדי להיות ירא בושת צריך להכיר ולהשיג את אלקותו ית',"
        },
        {
          "s": 28,
          "text": "וזה א\"א אלא ע\"י צמצום שמצמצם את עצמו כביכול שיכולים להשיגו,"
        },
        {
          "s": 29,
          "text": "וזה הצמצום בא ע\"י שיקטין האדם את עצמו כי כמים הפנים לפנים."
        },
        {
          "s": 30,
          "text": "וזהו מ\"ש גבי ארץ ישראל עיני ה\"א בה,"
        },
        {
          "s": 31,
          "text": "עיני לשון רבים,"
        },
        {
          "s": 32,
          "text": "שבארץ ישראל יש ב' עיינין,"
        },
        {
          "s": 33,
          "text": "יראה החיצונית ויראה הפנימית."
        },
        {
          "s": 34,
          "text": "דעם היות שארץ היא בחינת מלכות ח\"ת,"
        },
        {
          "s": 35,
          "text": "מ\"מ מצד המעלה דאור חוזר יש בה גם התגלות יראה עליונה."
        },
        {
          "s": 36,
          "text": "ובדוגמת מה שבאויר הסמוך לארץ יש יותר חמימות מבאויר האמצעי,"
        },
        {
          "s": 37,
          "text": "כי השמש שמכה על הארץ חוזרת ממנו הארה למעלה עד שליש החלל."
        },
        {
          "s": 38,
          "text": "וזהו ארץ אשר עיני ה\"א בה,"
        },
        {
          "s": 39,
          "text": "ארץ הוא א\"י,"
        },
        {
          "s": 40,
          "text": "ויש בה ב' עיינין חכמה עילאה וחכמה תתאה."
        },
        {
          "s": 41,
          "text": "מרשית השנה ועד אחרית שנה,"
        },
        {
          "s": 42,
          "text": "ראשית הוא ח\"ע"
        },
        {
          "s": 43,
          "text": "[ורשית חסר כתיב,"
        },
        {
          "s": 44,
          "text": "כי ח\"ע המתגלית בח\"ת"
        },
        {
          "s": 45,
          "text": "(ארץ)"
        },
        {
          "s": 46,
          "text": "אין בה אל\"ף המורה עלי']."
        },
        {
          "s": 47,
          "text": "(ע\"כ תוכן התורה של הה\"מ)."
        },
        {
          "s": 48,
          "text": "ועפ\"ז יובן מה שאמרו כל רב מבבל וכל רבי מא\"י"
        },
        {
          "s": 49,
          "text": "[שבא\"י הוא רב בתוס' יו\"ד המורה על חכמה],"
        },
        {
          "s": 50,
          "text": "דהגם שא\"י היא בחינת מלכות ח\"ת ויר\"ת,"
        },
        {
          "s": 51,
          "text": "מ\"מ,"
        },
        {
          "s": 52,
          "text": "מכיון שביראה התחתונה יש גם התגלות יראה עליונה,"
        },
        {
          "s": 53,
          "text": "לכן בא\"י הוא רבי ביו\"ד."
        },
        {
          "s": 54,
          "text": "וזהו ג\"כ מה שהיו\"ד המתוסף ברבי"
        },
        {
          "s": 55,
          "text": "(מא\"י)"
        },
        {
          "s": 56,
          "text": "הוא בחינת פנימיות החכמה כנ\"ל,"
        },
        {
          "s": 57,
          "text": "כי בחינת יראה בושת הבאה מהכרת הפנימיות היא בחינת פנימיות ח\"ע,"
        },
        {
          "s": 58,
          "text": "ולכן הי' ברבי"
        },
        {
          "s": 59,
          "text": "(שמא\"י)"
        },
        {
          "s": 60,
          "text": "בחינת פנימיות החכמה,"
        },
        {
          "s": 61,
          "text": "ועד לבחינת נביע מא\"ס,"
        },
        {
          "s": 62,
          "text": "כנ\"ל מהבעש\"ט."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "וזהו מ\"ש כ\"ק מו\"ח אדמו\"ר בהמאמר בענין היו\"ד שבאחורי הד',"
        },
        {
          "s": 2,
          "text": "שאות יו\"ד מורה על הביטול ואזעירת גרמה והיינו מלכות דאצילות דלית לה מגרמה כלום,"
        },
        {
          "s": 3,
          "text": "שהביטול דבחינת מלכות הוא"
        },
        {
          "s": 4,
          "text": "[לא רק הביטול דאזעירת גרמה,"
        },
        {
          "s": 5,
          "text": "כ\"א]"
        },
        {
          "s": 6,
          "text": "בחינת הביטול דלית לה מגרמה כלום,"
        },
        {
          "s": 7,
          "text": "שהוא תכלית הביטול."
        },
        {
          "s": 8,
          "text": "וכנ\"ל שדוקא במלכות,"
        },
        {
          "s": 9,
          "text": "בחינת ח\"ת,"
        },
        {
          "s": 10,
          "text": "נתגלה בחינת ביטול הכי עליון."
        },
        {
          "s": 11,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 12,
          "text": "שביטול זה צ\"ל בכל ג' הקוין דתורה עבודה וגמ\"ח,"
        },
        {
          "s": 13,
          "text": "שבלימוד התורה אינו מספיק ביטול סתם"
        },
        {
          "s": 14,
          "text": "(השלילה דגסי הרוח)"
        },
        {
          "s": 15,
          "text": "כ\"א צ\"ל \"בבחינת ביטול במציאות לגמרי\","
        },
        {
          "s": 16,
          "text": "וכן בקו העבודה"
        },
        {
          "s": 17,
          "text": "(תפלה)"
        },
        {
          "s": 18,
          "text": "צ\"ל הביטול דעני ואביון אני שהוא בחינת הביטול דבחינת מלכות,"
        },
        {
          "s": 19,
          "text": "וכן בקו הגמ\"ח"
        },
        {
          "s": 20,
          "text": "(קיום המצוות)"
        },
        {
          "s": 21,
          "text": "מבאר בהמשל דהגבהת משא כבדה"
        },
        {
          "s": 22,
          "text": "(שהוא משל על ענין דקיום המצוות,"
        },
        {
          "s": 23,
          "text": "כנ\"ל),"
        },
        {
          "s": 24,
          "text": "שבכדי להגבי' משא כבדה ביותר"
        },
        {
          "s": 25,
          "text": "(אינו מספיק שיצמצם עצמו קצת,"
        },
        {
          "s": 26,
          "text": "כ\"א)"
        },
        {
          "s": 27,
          "text": "צריך לצמצם את עצמו ביותר."
        },
        {
          "s": 28,
          "text": "וע\"י הביטול"
        },
        {
          "s": 29,
          "text": "(בכל ג' קוין הנ\"ל)"
        },
        {
          "s": 30,
          "text": "הוא נעשה כלי ריקן ומחזיק,"
        },
        {
          "s": 31,
          "text": "שמקבל את כל הגילויים והכחות שנותנים מלמעלה לעבוד את עבודתו בלימוד התורה וקיום המצוות ועבודת התפלה,"
        },
        {
          "s": 32,
          "text": "ועד שעושה מקשר ושקר העולם שיתהפך לקרשי המשכן,"
        },
        {
          "s": 33,
          "text": "שמהפך את השטות דלעו\"ז לשטות דקדושה."
        },
        {
          "s": 34,
          "text": "דכל זה הוא ע\"י הביטול דכלי ריקן,"
        },
        {
          "s": 35,
          "text": "שאז הוא כלי לקבל הכחות שנותנים מלמעלה שיוכל לנצח את מלחמת היצר,"
        },
        {
          "s": 36,
          "text": "וכמבואר בהמאמר88"
        },
        {
          "s": 37,
          "text": "שבשביל נצוח המלחמה מבזבזים את האוצרות הכמוסים מדור דור"
        },
        {
          "s": 38,
          "text": "(מה שאצר בעצמו וגם מה שאצרו אבותיו)"
        },
        {
          "s": 39,
          "text": "ומוסרים אותם ע\"י פקידי החיל,"
        },
        {
          "s": 40,
          "text": "בשביל אנשי החיל שהם דוקא"
        },
        {
          "s": 41,
          "text": "(אנשי החיל)"
        },
        {
          "s": 42,
          "text": "מביאים את הנצחון בפועל,"
        },
        {
          "s": 43,
          "text": "הצבאות הוי',"
        },
        {
          "s": 44,
          "text": "בכל ג' הפירושים שבזה,"
        },
        {
          "s": 45,
          "text": "כמבואר בהמאמר89."
        },
        {
          "s": 46,
          "text": "והנה התואר צבאות הוי' לישראל התחיל מזמן יצי\"מ,"
        },
        {
          "s": 47,
          "text": "וכמ\"ש90"
        },
        {
          "s": 48,
          "text": "בעצם היום הזהד"
        },
        {
          "s": 49,
          "text": "יצאו כל צבאות הוי' מארץ מצרים,"
        },
        {
          "s": 50,
          "text": "ומזה מובן גם בנוגע לגאולה העתידה,"
        },
        {
          "s": 51,
          "text": "שתהי' בדוגמת הגאולה דיציאת מצרים וכמ\"ש91"
        },
        {
          "s": 52,
          "text": "כימי צאתך מארץ מצרים אראנו נפלאות,"
        },
        {
          "s": 53,
          "text": "שעי\"ז יהי' הגילוי דגאולה העתידה שאז יהיו נפלאות אפילו לגבי הענינים שהיו ביציאת מצרים92,"
        },
        {
          "s": 54,
          "text": "ולאח\"ז יהי' הקיצו ורננו שוכני עפר93"
        },
        {
          "s": 55,
          "text": "והוא בתוכם."
        }
      ]
    }
  ]
}