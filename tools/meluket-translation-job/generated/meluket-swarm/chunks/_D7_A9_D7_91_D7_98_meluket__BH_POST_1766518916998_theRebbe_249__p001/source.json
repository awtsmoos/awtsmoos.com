{
  "globalIndex": 565,
  "owner": 15,
  "jobId": "_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916998_theRebbe_249__p001",
  "batchId": "meluket-_D7_A9_D7_91_D7_98_meluket__BH_POST_1766518916998_theRebbe_249__p001",
  "seriesId": "שבט_meluket",
  "postId": "BH_POST_1766518916998_theRebbe_249",
  "title": "מאמר ארבעה ראשי שנים תשל\"א",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "יום ד' חמשה עשר בשבט ה'תשל\"א"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "ארבעה ראשי שנים הם באחד בניסן כו' באחד באלול כו' באחד בתשרי כו' באחד בשבט ראש השנה לאילן כדברי בית שמאי,"
        },
        {
          "s": 1,
          "text": "בית הלל אומרים בחמשה עשר בו1,"
        },
        {
          "s": 2,
          "text": "והלכה כבית הלל2."
        },
        {
          "s": 3,
          "text": "וצריך להבין טעם השינוי דר\"ה לאילן מג' ראשי שנים הראשונים,"
        },
        {
          "s": 4,
          "text": "שג' ראשי שנים הראשונים הם בראש חודש ור\"ה לאילן הוא בחמשה עשר."
        },
        {
          "s": 5,
          "text": "ולהוסיף,"
        },
        {
          "s": 6,
          "text": "דע\"פ המבואר במק\"א3"
        },
        {
          "s": 7,
          "text": "שהשייכות דג' הרגלים4"
        },
        {
          "s": 8,
          "text": "ליום הט\"ו בחודש הוא כי ביום הט\"ו הוא שלימות הלבנה,"
        },
        {
          "s": 9,
          "text": "שזה מורה גם על השלימות דישראל שמונין ללבנה ודומין ללבנה5,"
        },
        {
          "s": 10,
          "text": "צריך לומר,"
        },
        {
          "s": 11,
          "text": "דזה שרובם של הראשי שנים"
        },
        {
          "s": 12,
          "text": "[ולדעת ב\"ש כל ד' הראשי שנים]"
        },
        {
          "s": 13,
          "text": "הם בראש חודש,"
        },
        {
          "s": 14,
          "text": "בעת מולד הלבנה שאז הלבנה היא רק נקודה,"
        },
        {
          "s": 15,
          "text": "הוא לפי שענין ראש השנה הוא שבו נמשך הענין שהוא ר\"ה אליו,"
        },
        {
          "s": 16,
          "text": "והענינים כמו שהם בתחלת המשכתם הם רק נקודה,"
        },
        {
          "s": 17,
          "text": "ועפ\"ז צריך להבין עוד יותר מה שר\"ה לאילן הוא בחמשה עשר6."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויובן זה בהקדים המבואר בכמה דרושים7,"
        },
        {
          "s": 2,
          "text": "דזה שהרגלים נקבעו בזמני גמר ואסיפת התבואות"
        },
        {
          "s": 3,
          "text": "[דחג הפסח צריך להיות בזמן האביב"
        },
        {
          "s": 4,
          "text": "(זמן גמר שעורים)8"
        },
        {
          "s": 5,
          "text": "ויתרה מזה בחג השבועות שנקרא בשם9"
        },
        {
          "s": 6,
          "text": "חג הקציר10"
        },
        {
          "s": 7,
          "text": "על שם בכורי קציר חטים11,"
        },
        {
          "s": 8,
          "text": "וכן חג הסוכות שנקרא בשם חג האסיף12],"
        },
        {
          "s": 9,
          "text": "המכוון הוא"
        },
        {
          "s": 10,
          "text": "(בעיקר)"
        },
        {
          "s": 11,
          "text": "לתבואה הרוחניית,"
        },
        {
          "s": 12,
          "text": "הם ישראל,"
        },
        {
          "s": 13,
          "text": "דכתיב בהו13"
        },
        {
          "s": 14,
          "text": "קודש ישראל להוי' ראשית תבואתה גו'."
        },
        {
          "s": 15,
          "text": "וזה שהרגלים צריכים להיות בזמני גמר ואסיפת התבואות בגשמיות"
        },
        {
          "s": 16,
          "text": "[ועד שבשביל זה מעברים את השנה14],"
        },
        {
          "s": 17,
          "text": "הוא,"
        },
        {
          "s": 18,
          "text": "כי כל הענינים שבגשמיות משתלשלים מענינם ברוחניות15."
        },
        {
          "s": 19,
          "text": "ועפ\"ז יש לומר גם בנוגע ר\"ה לאילן,"
        },
        {
          "s": 20,
          "text": "שעיקר ענינו הוא שהוא ר\"ה להאדם"
        },
        {
          "s": 21,
          "text": "(אתם קרויין אדם16)"
        },
        {
          "s": 22,
          "text": "שנמשל לאילן,"
        },
        {
          "s": 23,
          "text": "כמ\"ש17"
        },
        {
          "s": 24,
          "text": "כי האדם עץ השדה,"
        },
        {
          "s": 25,
          "text": "ומזה נשתלשל שהוא ר\"ה לאילן כפשוטו בגשמיות."
        },
        {
          "s": 26,
          "text": "וע\"פ מארז\"ל18"
        },
        {
          "s": 27,
          "text": "עה\"פ17"
        },
        {
          "s": 28,
          "text": "כי האדם עץ השדה אם תלמיד חכם כו',"
        },
        {
          "s": 29,
          "text": "יש לומר,"
        },
        {
          "s": 30,
          "text": "דזה שישראל נקראים בשם תבואה"
        },
        {
          "s": 31,
          "text": "(חטים שעורים וכו'19)"
        },
        {
          "s": 32,
          "text": "הוא מצד העבודה שלהם בקיום המצוות"
        },
        {
          "s": 33,
          "text": "(כדלקמן),"
        },
        {
          "s": 34,
          "text": "וזה שנקראים בשם אילן"
        },
        {
          "s": 35,
          "text": "(עץ השדה)"
        },
        {
          "s": 36,
          "text": "הוא ע\"י עסק התורה."
        },
        {
          "s": 37,
          "text": "ויש לומר דזהו מ\"ש כי האדם עץ השדה"
        },
        {
          "s": 38,
          "text": "(אדם דייקא),"
        },
        {
          "s": 39,
          "text": "דשם אדם הוא על שם השכל"
        },
        {
          "s": 40,
          "text": "(כמבואר בכ\"מ החילוק בין אדם לאיש20)."
        }
      ]
    }
  ]
}