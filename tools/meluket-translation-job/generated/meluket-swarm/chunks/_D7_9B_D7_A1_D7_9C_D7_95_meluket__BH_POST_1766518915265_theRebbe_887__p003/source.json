{
  "globalIndex": 251,
  "owner": 1,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915265_theRebbe_887__p003",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915265_theRebbe_887__p003",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915265_theRebbe_887",
  "title": "מאמר אתה אחד תשכ\"ט",
  "part": 3,
  "sections": [
    {
      "v": 6,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה עד\"ז הוא בישראל,"
        },
        {
          "s": 2,
          "text": "שיש בהם דוגמת שני ענינים אלה."
        },
        {
          "s": 3,
          "text": "שמצד שרש הנשמות כמו שהם מושרשים בעצמות,"
        },
        {
          "s": 4,
          "text": "אין נתינת מקום למציאות אחרת,"
        },
        {
          "s": 5,
          "text": "כ\"א ישראל ומלכא בלחודוהי17."
        },
        {
          "s": 6,
          "text": "ויש לומר,"
        },
        {
          "s": 7,
          "text": "שבדרגא זו,"
        },
        {
          "s": 8,
          "text": "אין שייך לומר גם שישראל קדמו לעולם18."
        },
        {
          "s": 9,
          "text": "אבל לאחרי שירדו הנשמות למטה בכדי לברר ולזכך את העולם19,"
        },
        {
          "s": 10,
          "text": "הנה לגבי דרגא זו דישראל ישנו מציאות העולם,"
        },
        {
          "s": 11,
          "text": "אלא שישראל הם למעלה מהעולם,"
        },
        {
          "s": 12,
          "text": "ובריאת העולם היא בשביל ישראל20."
        },
        {
          "s": 13,
          "text": "ועפ\"ז הי' אפשר לומר,"
        },
        {
          "s": 14,
          "text": "דזה שישראל נק' גוי אחד"
        },
        {
          "s": 15,
          "text": "(ולא יחיד)"
        },
        {
          "s": 16,
          "text": "הוא מצד ירידתם למטה,"
        },
        {
          "s": 17,
          "text": "וכהלשון גוי אחד בארץ."
        },
        {
          "s": 18,
          "text": "דמכיון שירידת הנשמה למטה הוא בכדי לברר את העולם,"
        },
        {
          "s": 19,
          "text": "מתחיל מסוג המדבר שבעולם21,"
        },
        {
          "s": 20,
          "text": "הרי לגבי דרגא זו דישראל"
        },
        {
          "s": 21,
          "text": "(כמו שהם בארץ)"
        },
        {
          "s": 22,
          "text": "ישנה המציאות דאומות העולם"
        },
        {
          "s": 23,
          "text": "[ועד שע\"י שישראל פועלים בירור בהאומות נעשה בהם עילוי],"
        },
        {
          "s": 24,
          "text": "לכן נאמר גוי אחד,"
        },
        {
          "s": 25,
          "text": "אחד המנוי,"
        },
        {
          "s": 26,
          "text": "שמונים גם את אומות העולם22"
        },
        {
          "s": 27,
          "text": "[מכיון שעל ידם דוקא נעשה עילוי זה בישראל],"
        },
        {
          "s": 28,
          "text": "אלא שישראל הם גוי אחד,"
        },
        {
          "s": 29,
          "text": "שאינו מתערב עם שאר העמים"
        },
        {
          "s": 30,
          "text": "[וע\"ד יום אחד,"
        },
        {
          "s": 31,
          "text": "שיום הראשון דששת ימי בראשית נמנה עם שאר הימים,"
        },
        {
          "s": 32,
          "text": "אחד המנוי,"
        },
        {
          "s": 33,
          "text": "אבל הוא נעלה מהם]."
        },
        {
          "s": 34,
          "text": "ובכדי לשלול פירוש זה מביא בהמאמר המשל דבן יחיד,"
        },
        {
          "s": 35,
          "text": "דענינו של בן יחיד הוא"
        },
        {
          "s": 36,
          "text": "(לא רק זה שבפועל הוא בן אחד בלבד,"
        },
        {
          "s": 37,
          "text": "אלא)"
        },
        {
          "s": 38,
          "text": "גם"
        },
        {
          "s": 39,
          "text": "(ובעיקר)"
        },
        {
          "s": 40,
          "text": "שאהבתו לאביו ואהבת אביו אליו היא אהבה מיוחדת"
        },
        {
          "s": 41,
          "text": "(שאינה דומה לאהבה דאב ובן כשישנם יותר מבן אחד)."
        },
        {
          "s": 42,
          "text": "וכמו\"כ הוא בזה שישראל הם בן יחיד ליחידו של עולם,"
        },
        {
          "s": 43,
          "text": "שהאהבה דהקב\"ה לישראל והאהבה דישראל להקב\"ה היא אהבה מיוחדת שאין דוגמתה בכל העמים."
        },
        {
          "s": 44,
          "text": "וכיון שגם בארץ האהבה דהקב\"ה לישראל ודישראל להקב\"ה היא אהבה מיוחדת,"
        },
        {
          "s": 45,
          "text": "אין שייך לכאורה למנותם עם שאר העמים,"
        },
        {
          "s": 46,
          "text": "והול\"ל גוי יחיד."
        }
      ]
    },
    {
      "v": 7,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ויובן זה בעומק יותר,"
        },
        {
          "s": 2,
          "text": "בהקדים הביאור בזה שאהבת ההורים לבניהם כשיש להם יותר מבן אחד אינה אהבה גדולה כ\"כ כאהבתם לבן יחיד,"
        },
        {
          "s": 3,
          "text": "וכן אהבת הבן יחיד להוריו היא גדולה יותר מאהבת בנים להוריהם כשיש יותר מבן אחד."
        },
        {
          "s": 4,
          "text": "דלכאורה23,"
        },
        {
          "s": 5,
          "text": "גם בנוגע לאהבת ההורים לבניהם,"
        },
        {
          "s": 6,
          "text": "אין שייך לומר שע\"י שיש להם הרבה בנים מתמעטת אהבתם,"
        },
        {
          "s": 7,
          "text": "כי כלום תחומי אית במעוהי דבר נש24."
        },
        {
          "s": 8,
          "text": "ועאכו\"כ בנוגע לאהבת הבן להורים,"
        },
        {
          "s": 9,
          "text": "דכיון שכל אחד"
        },
        {
          "s": 10,
          "text": "(גם כשיש לו אחים)"
        },
        {
          "s": 11,
          "text": "הוא יחידי בהרגש עצמו,"
        },
        {
          "s": 12,
          "text": "הרי זה שיש לו אחים שגם הם אוהבים את הוריו אינה סיבה"
        },
        {
          "s": 13,
          "text": "(לכאורה)"
        },
        {
          "s": 14,
          "text": "שעי\"ז תתמעט האהבה שלו"
        },
        {
          "s": 15,
          "text": "(כיון שבהרגש עצמו הוא יחידי)."
        },
        {
          "s": 16,
          "text": "ויש לומר הביאור בזה,"
        },
        {
          "s": 17,
          "text": "ע\"פ הידוע25"
        },
        {
          "s": 18,
          "text": "שכל הענינים שלמטה יש להם שרש למעלה."
        },
        {
          "s": 19,
          "text": "ועפ\"ז יש לומר,"
        },
        {
          "s": 20,
          "text": "שהשרש דאהבת הורים לבניהם הוא אהבת הקב\"ה לישראל שהם בנים להקב\"ה,"
        },
        {
          "s": 21,
          "text": "והשרש דאהבת בן להוריו הוא אהבת ישראל לאבינו שבשמים."
        },
        {
          "s": 22,
          "text": "וכיון שישראל הם בן יחיד ליחידו של עולם,"
        },
        {
          "s": 23,
          "text": "לכן,"
        },
        {
          "s": 24,
          "text": "האהבה עצמית דאב ובן למטה"
        },
        {
          "s": 25,
          "text": "(אהבת האב לבנו ואהבת הבן לאביו),"
        },
        {
          "s": 26,
          "text": "שנמשכת מאהבה העצמית דהקב\"ה וישראל"
        },
        {
          "s": 27,
          "text": "(אהבת הקב\"ה לישראל ואהבת ישראל להקב\"ה),"
        },
        {
          "s": 28,
          "text": "היא בעיקר בבן יחיד"
        },
        {
          "s": 29,
          "text": "(ומטעם זה,"
        },
        {
          "s": 30,
          "text": "כללות האהבה עצמית של הורים לבנם ושל בן להוריו הוא בישראל יותר מבאומות העולם,"
        },
        {
          "s": 31,
          "text": "לפי ששרש אהבה זו היא אהבת הקב\"ה לישראל ואהבת ישראל להקב\"ה)."
        }
      ]
    },
    {
      "v": 8,
      "items": [
        {
          "s": 0,
          "text": "ועפ\"ז יש להוסיף ביאור בהשייכות דהמשל דבן יחיד להדיוק דהול\"ל גוי יחיד,"
        },
        {
          "s": 1,
          "text": "כי זה שישראל הם בנו יחידו דהקב\"ה הוא"
        },
        {
          "s": 2,
          "text": "(לא כבן יחיד למטה שגם כשיש לאדם רק בן יחיד אפשר ושייך שיהיו לו עוד בנים,"
        },
        {
          "s": 3,
          "text": "אלא)"
        },
        {
          "s": 4,
          "text": "שאין שייך כביכול שיהיו לו עוד בנים,"
        },
        {
          "s": 5,
          "text": "כי זה שישראל הם בניו דהקב\"ה הוא שהם מושרשים בעצמות"
        },
        {
          "s": 6,
          "text": "(בדוגמת הבן למטה שהוא מושרש בעצמות האב),"
        },
        {
          "s": 7,
          "text": "ושם אין נתינת מקום למציאות אחרת,"
        },
        {
          "s": 8,
          "text": "ישראל ומלכא בלחודוהי"
        },
        {
          "s": 9,
          "text": "(כנ\"ל סעיף ג)."
        },
        {
          "s": 10,
          "text": "וכיון שגם בהיותם למטה בארץ,"
        },
        {
          "s": 11,
          "text": "אהבת הקב\"ה לישראל היא כאהבת האב לבן יחיד,"
        },
        {
          "s": 12,
          "text": "ואהבת ישראל להקב\"ה היא כאהבת בן יחיד לאביו,"
        },
        {
          "s": 13,
          "text": "שעי\"ז ניכר בהם בגילוי26"
        },
        {
          "s": 14,
          "text": "שגם בהיותם למטה בארץ הם קשורים עם שרשם בהעצמות,"
        },
        {
          "s": 15,
          "text": "שאין שם נתינת מקום למציאות אחרת"
        },
        {
          "s": 16,
          "text": "(אפילו לא למציאות דמלאכים וכיו\"ב,"
        },
        {
          "s": 17,
          "text": "ומכ\"ש שאין שם נתינת מקום לאומות העולם),"
        },
        {
          "s": 18,
          "text": "אין שייך לכאורה למנותם עם האומות ולומר עליהם שהם גוי אחד"
        },
        {
          "s": 19,
          "text": "(אחד המנוי)"
        },
        {
          "s": 20,
          "text": "והול\"ל גוי יחיד."
        }
      ]
    }
  ]
}