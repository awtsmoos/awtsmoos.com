{
  "globalIndex": 252,
  "owner": 2,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915265_theRebbe_887__p004",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915265_theRebbe_887__p004",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915265_theRebbe_887",
  "title": "מאמר אתה אחד תשכ\"ט",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה הטעם על זה שבכל ג' הענינים"
        },
        {
          "s": 2,
          "text": "(אתה,"
        },
        {
          "s": 3,
          "text": "שמך,"
        },
        {
          "s": 4,
          "text": "כעמך כישראל)"
        },
        {
          "s": 5,
          "text": "נאמר אחד ולא יחיד,"
        },
        {
          "s": 6,
          "text": "מבאר בהמאמר בהקדם החילוק בין אור לשם,"
        },
        {
          "s": 7,
          "text": "שבכל אחד מהם יש מעלה27."
        },
        {
          "s": 8,
          "text": "דמעלת האור היא בענין הגילוי,"
        },
        {
          "s": 9,
          "text": "שהאור מגלה את המאור."
        },
        {
          "s": 10,
          "text": "דשם אינו מגלה את הנקרא בשם,"
        },
        {
          "s": 11,
          "text": "וכמו שם האדם,"
        },
        {
          "s": 12,
          "text": "דמזה שיודעים את שמו אין יודעים את מהותו,"
        },
        {
          "s": 13,
          "text": "והרי כמה אנשים נקראים באותו השם אף שאין דומים זל\"ז,"
        },
        {
          "s": 14,
          "text": "לא בשכלם ולא במדותיהם,"
        },
        {
          "s": 15,
          "text": "וע\"י האור יודעים את המאור."
        },
        {
          "s": 16,
          "text": "והמעלה דשם היא,"
        },
        {
          "s": 17,
          "text": "שהוא ממשיך את העצם."
        },
        {
          "s": 18,
          "text": "דכשקורין לאדם בשמו,"
        },
        {
          "s": 19,
          "text": "הוא פונה לקוראו בכל עצמותו."
        },
        {
          "s": 20,
          "text": "ויתירה מזו,"
        },
        {
          "s": 21,
          "text": "דגם כשהאדם מתעלף,"
        },
        {
          "s": 22,
          "text": "ע\"י שקוראים אותו בשמו הוא מתעורר מההתעלפות,"
        },
        {
          "s": 23,
          "text": "כי ע\"י הקריאה בשמו ממשיכים את עצם החיות שלמעלה מהתפשטות החיות."
        },
        {
          "s": 24,
          "text": "וזוהי המעלה דשם לגבי אור,"
        },
        {
          "s": 25,
          "text": "שהאור אינו ממשיך את העצם היינו המאור,"
        },
        {
          "s": 26,
          "text": "ושם ממשיך את העצם."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ויש לומר,"
        },
        {
          "s": 1,
          "text": "דמ\"ש בהמאמר שהאור אינו ממשיך את העצם היינו המאור,"
        },
        {
          "s": 2,
          "text": "הכוונה בזה היא,"
        },
        {
          "s": 3,
          "text": "כי בהעצם שממנו נמשך האור,"
        },
        {
          "s": 4,
          "text": "שני ענינים."
        },
        {
          "s": 5,
          "text": "המאור שבו והעצם ממש שלמעלה ממאור28."
        },
        {
          "s": 6,
          "text": "דזה שנקרא בשם מאור הוא מפני שהוא מאיר,"
        },
        {
          "s": 7,
          "text": "היינו שנמשך ממנו אור,"
        },
        {
          "s": 8,
          "text": "אבל העצם ממש הוא מובדל מענין האור"
        },
        {
          "s": 9,
          "text": "(גם מזה שהוא מאור,"
        },
        {
          "s": 10,
          "text": "שממנו נמשך האור)."
        },
        {
          "s": 11,
          "text": "ויש לומר,"
        },
        {
          "s": 12,
          "text": "דהחילוק בין שרש האור לשרש השם הוא,"
        },
        {
          "s": 13,
          "text": "דשרש האור הוא בהמאור ושרש השם הוא בהעצם."
        },
        {
          "s": 14,
          "text": "וזהו שאור הוא גילוי ושם הוא העלם,"
        },
        {
          "s": 15,
          "text": "כי ענין המאור הוא שהוא מאיר"
        },
        {
          "s": 16,
          "text": "(מתפשט ומתגלה),"
        },
        {
          "s": 17,
          "text": "והעצם"
        },
        {
          "s": 18,
          "text": "(השרש דשם)"
        },
        {
          "s": 19,
          "text": "הוא מובדל מענין האור"
        },
        {
          "s": 20,
          "text": "(התפשטות וגילוי)."
        },
        {
          "s": 21,
          "text": "ועפ\"ז יש לבאר מ\"ש בהמאמר שהאור אינו ממשיך את העצם היינו המאור,"
        },
        {
          "s": 22,
          "text": "שהכוונה בזה שמוסיף \"היינו המאור\" היא,"
        },
        {
          "s": 23,
          "text": "שהעצם ששייך לאור הוא לא העצם ממש ורק המאור,"
        },
        {
          "s": 24,
          "text": "ואעפ\"כ האור אינו ממשיך גם ענין זה."
        },
        {
          "s": 25,
          "text": "ולאח\"ז אומר שהשם ממשיך את העצם"
        },
        {
          "s": 26,
          "text": "(העצם סתם),"
        },
        {
          "s": 27,
          "text": "שהעצם ששייך לשם הוא העצם ממש שמובדל מענין הגילוי,"
        },
        {
          "s": 28,
          "text": "ואעפ\"כ,"
        },
        {
          "s": 29,
          "text": "השם ממשיך את העצם."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ו)"
        },
        {
          "s": 1,
          "text": "וממשיך בהמאמר,"
        },
        {
          "s": 2,
          "text": "דזהו מה שאמרו רז\"ל29"
        },
        {
          "s": 3,
          "text": "שהלך הקב\"ה מהלך ת\"ק שנה לקנות לו שם,"
        },
        {
          "s": 4,
          "text": "דשרש השם הוא למעלה משרש האור"
        },
        {
          "s": 5,
          "text": "(כנ\"ל)"
        },
        {
          "s": 6,
          "text": "אלא שהוא בהעלם,"
        },
        {
          "s": 7,
          "text": "וענין לקנות לו שם הוא שהשם יהי' בגילוי30"
        },
        {
          "s": 8,
          "text": "כמו אור,"
        },
        {
          "s": 9,
          "text": "שאז יהיו שתי המעלות,"
        },
        {
          "s": 10,
          "text": "המשכת העצם – המעלה דשם,"
        },
        {
          "s": 11,
          "text": "ושהמשכה זו תהי' בגילוי – מעלת האור."
        },
        {
          "s": 12,
          "text": "ועפ\"ז מבאר מ\"ש אתה אחד ושמך אחד,"
        },
        {
          "s": 13,
          "text": "כי יחיד ואחד הוא גילוי והעלם,"
        },
        {
          "s": 14,
          "text": "שמצד הגילוי דאוא\"ס אין מקום לעולמות"
        },
        {
          "s": 15,
          "text": "(– יחיד),"
        },
        {
          "s": 16,
          "text": "וזה שישנם עולמות"
        },
        {
          "s": 17,
          "text": "(עולם לשון העלם31)"
        },
        {
          "s": 18,
          "text": "אלא שהם מיוחדים"
        },
        {
          "s": 19,
          "text": "(אחד)"
        },
        {
          "s": 20,
          "text": "הוא ע\"י הצמצום וההעלם."
        },
        {
          "s": 21,
          "text": "ולכן יש מעלה באחד לגבי יחיד,"
        },
        {
          "s": 22,
          "text": "ע\"ד המעלה דשם"
        },
        {
          "s": 23,
          "text": "(העלם)"
        },
        {
          "s": 24,
          "text": "לגבי אור"
        },
        {
          "s": 25,
          "text": "(גילוי)."
        },
        {
          "s": 26,
          "text": "וזה נעשה ע\"י ישראל גוי אחד בארץ,"
        },
        {
          "s": 27,
          "text": "שע\"י עבודתם בתומ\"צ נמשך האל\"ף שמורה על אתה32,"
        },
        {
          "s": 28,
          "text": "עצמות,"
        },
        {
          "s": 29,
          "text": "בהח' והד',"
        },
        {
          "s": 30,
          "text": "ז' רקיעים וארץ וד' רוחות העולם."
        }
      ]
    }
  ]
}