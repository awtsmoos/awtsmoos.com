{
  "globalIndex": 1081,
  "owner": 31,
  "jobId": "_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920191_theRebbe_834__p005",
  "batchId": "meluket-_D7_90_D7_9C_D7_95_D7_9C_meluket__BH_POST_1766518920191_theRebbe_834__p005",
  "seriesId": "אלול_meluket",
  "postId": "BH_POST_1766518920191_theRebbe_834",
  "title": "מאמר אני לדודי תשל\"ב",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "והנה עד\"ז הוא גם בענין התשובה דאלול,"
        },
        {
          "s": 2,
          "text": "דזה שבאלול תוקעין בשופר הוא"
        },
        {
          "s": 3,
          "text": "(כמובא לעיל מהטור)"
        },
        {
          "s": 4,
          "text": "כדי להזהיר ישראל שיעשו תשובה,"
        },
        {
          "s": 5,
          "text": "שיש בזה יתרון על התשובה דר\"ה."
        },
        {
          "s": 6,
          "text": "דהגם שהתשובה דאלול היא על ענינים בלתי רצויים,"
        },
        {
          "s": 7,
          "text": "כמובן ממ\"ש בכתבי האריז\"ל38"
        },
        {
          "s": 8,
          "text": "דאלול הוא ר\"ת א."
        },
        {
          "s": 9,
          "text": "נה ל."
        },
        {
          "s": 10,
          "text": "ידו ו."
        },
        {
          "s": 11,
          "text": "שמתי ל."
        },
        {
          "s": 12,
          "text": "ך39,"
        },
        {
          "s": 13,
          "text": "דערי מקלט הוא תיקון על ענינים בלתי רצויים"
        },
        {
          "s": 14,
          "text": "[ויש לומר,"
        },
        {
          "s": 15,
          "text": "דזה שהתשובה דאלול נרמזת בא."
        },
        {
          "s": 16,
          "text": "נה ל."
        },
        {
          "s": 17,
          "text": "ידו ו."
        },
        {
          "s": 18,
          "text": "שמתי ל."
        },
        {
          "s": 19,
          "text": "ך שהכפרה דערי מקלט היא על מכה נפש בשגגה40,"
        },
        {
          "s": 20,
          "text": "הוא כי ע\"י התשובה דר\"ח אלול נעשו זדונות כשגגות והתשובה דאלול היא לתקן השגגות],"
        },
        {
          "s": 21,
          "text": "והתשובה דר\"ה שבאה לאחרי שנתקנו כבר הענינים הבלתי רצויים"
        },
        {
          "s": 22,
          "text": "(גם השגגות)41"
        },
        {
          "s": 23,
          "text": "ע\"י התשובה דאלול היא"
        },
        {
          "s": 24,
          "text": "(בעיקר)"
        },
        {
          "s": 25,
          "text": "תשובה עילאה42,"
        },
        {
          "s": 26,
          "text": "מ\"מ,"
        },
        {
          "s": 27,
          "text": "יש יתרון בהתשובה דאלול על התשובה דר\"ה."
        },
        {
          "s": 28,
          "text": "כי התשובה דר\"ה,"
        },
        {
          "s": 29,
          "text": "הוא רמז בהמצוה דתק\"ש,"
        },
        {
          "s": 30,
          "text": "כמ\"ש הרמב\"ם43"
        },
        {
          "s": 31,
          "text": "אע\"פ שתקיעת שופר בראש השנה גזירת הכתוב,"
        },
        {
          "s": 32,
          "text": "רמז יש בו,"
        },
        {
          "s": 33,
          "text": "כלומר עורו ישינים משנתכם כו' וחזרו בתשובה."
        },
        {
          "s": 34,
          "text": "והגם שענין התשובה המרומז בשופר הוא למעלה מהמצוה דתק\"ש44,"
        },
        {
          "s": 35,
          "text": "וכידוע בענין הרמז,"
        },
        {
          "s": 36,
          "text": "שהענין המרומז הוא למעלה מהדבר שמרמז עליו ועד שאינו מתלבש בהדבר והוא רק רמז בלבד45,"
        },
        {
          "s": 37,
          "text": "מ\"מ זה שהענין מרומז עכ\"פ בהדבר,"
        },
        {
          "s": 38,
          "text": "הוא מפני שיש ביניהם דמיון."
        },
        {
          "s": 39,
          "text": "וכיון שתק\"ש בר\"ה היא מצוה,"
        },
        {
          "s": 40,
          "text": "לכן,"
        },
        {
          "s": 41,
          "text": "גם התשובה הנרמזת בה יש לה שייכות להעבודה דתומ\"צ."
        },
        {
          "s": 42,
          "text": "ועיקר המעלה דתשובה,"
        },
        {
          "s": 43,
          "text": "שהיא מגיעה בבעל הרצון"
        },
        {
          "s": 44,
          "text": "(למעלה מהרצון דמצוות)46,"
        },
        {
          "s": 45,
          "text": "היא התשובה דאלול."
        },
        {
          "s": 46,
          "text": "כי זה שתשובה מגיעה למעלה מהרצון דמצוות הוא47"
        },
        {
          "s": 47,
          "text": "מפני שישראל קדמו לתורה48,"
        },
        {
          "s": 48,
          "text": "ולכן,"
        },
        {
          "s": 49,
          "text": "המעלה דתשובה היא בעיקר כשהתשובה באה מהאדם"
        },
        {
          "s": 50,
          "text": "(ישראל)"
        },
        {
          "s": 51,
          "text": "עצמו,"
        },
        {
          "s": 52,
          "text": "תשובה דאלול,"
        },
        {
          "s": 53,
          "text": "אני לדודי."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "וזהו אני לדודי ודודי לי ר\"ת אלול,"
        },
        {
          "s": 2,
          "text": "דזה שודודי לי נכלל בר\"ת אלול,"
        },
        {
          "s": 3,
          "text": "הוא,"
        },
        {
          "s": 4,
          "text": "כי זה שע\"י העבודה דאני לדודי"
        },
        {
          "s": 5,
          "text": "(באלול)"
        },
        {
          "s": 6,
          "text": "נעשה ההמשכה דודודי לי בר\"ה וביוהכ\"פ הוא כי העבודה דאני לדודי מגיעה בהעצמות שמשם נמשכים כל הגילויים"
        },
        {
          "s": 7,
          "text": "(כנ\"ל סוס\"ז),"
        },
        {
          "s": 8,
          "text": "ונמצא שבאני לדודי דאלול כלולה גם ההמשכה דודודי לי."
        },
        {
          "s": 9,
          "text": "ויש לומר,"
        },
        {
          "s": 10,
          "text": "דזהו מה שהתקיעות דחודש אלול"
        },
        {
          "s": 11,
          "text": "(ע\"פ מנהג חב\"ד49)"
        },
        {
          "s": 12,
          "text": "הם תשר\"ת תש\"ת תר\"ת,"
        },
        {
          "s": 13,
          "text": "כל הקולות שתוקעים בר\"ה,"
        },
        {
          "s": 14,
          "text": "כי בהתקיעות דאלול ישנם כל הענינים שבהתקיעות דראש השנה."
        },
        {
          "s": 15,
          "text": "וזה שבאלול תוקעין עשר קולות ולא מאה קולות,"
        },
        {
          "s": 16,
          "text": "אולי יש לומר,"
        },
        {
          "s": 17,
          "text": "שזהו לפי שהתקיעות דאלול"
        },
        {
          "s": 18,
          "text": "(כיון שהם השרש של הענינים שנמשכים בר\"ה)"
        },
        {
          "s": 19,
          "text": "הם למעלה מהתחלקות."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ו\"ד)"
        },
        {
          "s": 2,
          "text": "ויהי רצון שעל ידי מעשינו ועבודתינו50,"
        },
        {
          "s": 3,
          "text": "ובפרט על ידי העבודה דאלול,"
        },
        {
          "s": 4,
          "text": "יקרבו ויזרזו עוד יותר את הגאולה,"
        },
        {
          "s": 5,
          "text": "וכמרומז בזה שאלול הוא ר\"ת להוי' ויאמרו לאמר אשירה51,"
        },
        {
          "s": 6,
          "text": "כי אז יצאו כל ניצוצין מהגלות52."
        }
      ]
    }
  ]
}