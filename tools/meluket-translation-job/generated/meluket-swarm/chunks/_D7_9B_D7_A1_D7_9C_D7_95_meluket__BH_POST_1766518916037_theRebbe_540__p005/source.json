{
  "globalIndex": 398,
  "owner": 48,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518916037_theRebbe_540__p005",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518916037_theRebbe_540__p005",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518916037_theRebbe_540",
  "title": "מאמר וישב יעקב תשכ\"ז",
  "part": 5,
  "sections": [
    {
      "v": 12,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ועיקר ענין הדעת הוא שעל ידו נעשה החלטת הדבר,"
        },
        {
          "s": 2,
          "text": "והיינו,"
        },
        {
          "s": 3,
          "text": "שההבחנה בין טוב לרע,"
        },
        {
          "s": 4,
          "text": "חכימין בין טב לביש,"
        },
        {
          "s": 5,
          "text": "יכולה להיות גם מצד חו\"ב,"
        },
        {
          "s": 6,
          "text": "אבל מ\"מ,"
        },
        {
          "s": 7,
          "text": "לא יהי' אצלו ההחלט מה לעשות,"
        },
        {
          "s": 8,
          "text": "שהרי מצד השכל יכול להיות סברות לכאן ולכאן."
        },
        {
          "s": 9,
          "text": "וכידוע59"
        },
        {
          "s": 10,
          "text": "הראי' מדור המבול,"
        },
        {
          "s": 11,
          "text": "שמצד אותה סברה עצמה שחייבה שיהי' מבול,"
        },
        {
          "s": 12,
          "text": "כי יצר לב האדם רע מנעוריו60,"
        },
        {
          "s": 13,
          "text": "היתה אח\"כ המסקנא שלא אוסיף עוד להכות גו',"
        },
        {
          "s": 14,
          "text": "ולא יהי' עוד מבול לשחת הארץ."
        },
        {
          "s": 15,
          "text": "והיינו,"
        },
        {
          "s": 16,
          "text": "שמצד השכל עצמו לא יכול לבוא לידי החלט,"
        },
        {
          "s": 17,
          "text": "ורק ע\"י הדעת שנכנס בעומק הדבר,"
        },
        {
          "s": 18,
          "text": "אזי יכול לבוא לידי החלט איך לעשות."
        },
        {
          "s": 19,
          "text": "וזהו מ\"ש61"
        },
        {
          "s": 20,
          "text": "ובחרת בחיים,"
        },
        {
          "s": 21,
          "text": "והיינו,"
        },
        {
          "s": 22,
          "text": "דאף שכבר נאמר62"
        },
        {
          "s": 23,
          "text": "ראה נתתי לפניך גו' את החיים ואת הטוב ואת ההיפך,"
        },
        {
          "s": 24,
          "text": "מ\"מ,"
        },
        {
          "s": 25,
          "text": "אינו מסתפק בזה,"
        },
        {
          "s": 26,
          "text": "ואומר ובחרת בחיים,"
        },
        {
          "s": 27,
          "text": "ובפרט עפמ\"ש אדה\"ז63"
        },
        {
          "s": 28,
          "text": "שהאותיות של ובחרת בחיים הם נתינת כח שיוכל להיות הבחירה בחיים,"
        },
        {
          "s": 29,
          "text": "שמזה מובן שלא מספיק מה שיודעים שיש החיים וההיפך,"
        },
        {
          "s": 30,
          "text": "כיון שמצד זה גופא יכול להיות שיבחור בההיפך ח\"ו,"
        },
        {
          "s": 31,
          "text": "ולכן צ\"ל הציווי ובחרת בחיים,"
        },
        {
          "s": 32,
          "text": "שזהו ע\"י ענין הדעת כנ\"ל."
        },
        {
          "s": 33,
          "text": "אך עדיין צריך להבין,"
        },
        {
          "s": 34,
          "text": "איך זה שע\"י הדעת יכול לבחור בהטוב,"
        },
        {
          "s": 35,
          "text": "דכיון שמצד השכל,"
        },
        {
          "s": 36,
          "text": "הנה אף שחכימין בין טב לביש,"
        },
        {
          "s": 37,
          "text": "מ\"מ יכול להיות שאעפ\"כ יבחור בההיפך,"
        },
        {
          "s": 38,
          "text": "וכמ\"ש64"
        },
        {
          "s": 39,
          "text": "חכמים המה להרע,"
        },
        {
          "s": 40,
          "text": "א\"כ,"
        },
        {
          "s": 41,
          "text": "איך יהי' ובחרת בחיים ע\"י הדעת."
        },
        {
          "s": 42,
          "text": "והענין בזה,"
        },
        {
          "s": 43,
          "text": "דהנה דעת מחבר חו\"ב,"
        },
        {
          "s": 44,
          "text": "וא\"כ הדעת עצמו הוא למעלה מחו\"ב,"
        },
        {
          "s": 45,
          "text": "והיינו,"
        },
        {
          "s": 46,
          "text": "שדעת מקבל מבחי' הכתר,"
        },
        {
          "s": 47,
          "text": "כידוע שבמקום שהדעת נמנה אין הכתר נמנה65,"
        },
        {
          "s": 48,
          "text": "היינו,"
        },
        {
          "s": 49,
          "text": "שדעת הוא במקום הכתר,"
        },
        {
          "s": 50,
          "text": "ולכן מצד בחי' זו יכול להיות ובחרת בחיים."
        }
      ]
    },
    {
      "v": 13,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "וביאור הענין,"
        },
        {
          "s": 2,
          "text": "דהנה ידוע שתכלית הידיעה שלא נדעך66,"
        },
        {
          "s": 3,
          "text": "והפירוש הפשוט בזה הוא,"
        },
        {
          "s": 4,
          "text": "שמתחלה צריכים להבין כל מה שאפשר ואח\"כ באים אל תכלית הידיעה,"
        },
        {
          "s": 5,
          "text": "שמבינים שבאמת אין יודעים כו'."
        },
        {
          "s": 6,
          "text": "אבל הפירוש הפנימי בזה הוא,"
        },
        {
          "s": 7,
          "text": "שתכלית הידיעה היא שתהי' הידיעה במה שלא נדע,"
        },
        {
          "s": 8,
          "text": "היינו,"
        },
        {
          "s": 9,
          "text": "שגם הבחי' דלא נדעך תהי' בבחי' ידיעה."
        },
        {
          "s": 10,
          "text": "והענין בזה,"
        },
        {
          "s": 11,
          "text": "דהנה,"
        },
        {
          "s": 12,
          "text": "יש ידיעת החיוב וידיעת השלילה."
        },
        {
          "s": 13,
          "text": "ידיעת החיוב היא בבינה,"
        },
        {
          "s": 14,
          "text": "שבאה באופן של השגה,"
        },
        {
          "s": 15,
          "text": "שמשיג את השכל ע\"י תפיסא והתלבשות בהו' קצוות כו'."
        },
        {
          "s": 16,
          "text": "וידיעת השלילה היא בחכמה,"
        },
        {
          "s": 17,
          "text": "דהיינו שמבין את השכל ע\"י ששולל ממנו הענינים שמנגדים וסותרים אותו."
        },
        {
          "s": 18,
          "text": "ומ\"מ מובן,"
        },
        {
          "s": 19,
          "text": "שגם הדבר המושג בידיעת השלילה יש לו שייכות אל הענינים שהוא מושלל מהם,"
        },
        {
          "s": 20,
          "text": "שהם בגדרו עכ\"פ,"
        },
        {
          "s": 21,
          "text": "ולכן אפשר לשלול אותו מהם."
        },
        {
          "s": 22,
          "text": "אך יש עוד בחי' בידיעה שאינה באה גם ע\"י שלילה,"
        },
        {
          "s": 23,
          "text": "מפני שאין הענין בגדר ידיעה כלל שנוכל לתופסו ע\"י שלילה,"
        },
        {
          "s": 24,
          "text": "וזהו\"ע שלא נדעך."
        },
        {
          "s": 25,
          "text": "והענין בזה בהשגת אלקות,"
        },
        {
          "s": 26,
          "text": "דהנה,"
        },
        {
          "s": 27,
          "text": "יש בחי' ממכ\"ע ובחי' סוכ\"ע,"
        },
        {
          "s": 28,
          "text": "בחי' ממכ\"ע שייך בה ידיעת החיוב,"
        },
        {
          "s": 29,
          "text": "משא\"כ בבחי' סוכ\"ע שייך רק ידיעת השלילה,"
        },
        {
          "s": 30,
          "text": "אבל מ\"מ הרי זה בגדר עלמין,"
        },
        {
          "s": 31,
          "text": "שהרי נקרא סובב כל עלמין."
        },
        {
          "s": 32,
          "text": "אך יש בחי' שלמעלה מסוכ\"ע,"
        },
        {
          "s": 33,
          "text": "גם מסובב הכללי,"
        },
        {
          "s": 34,
          "text": "ואפילו מאמיתית ענין הסובב,"
        },
        {
          "s": 35,
          "text": "ששם לא שייך אפילו ידיעת השלילה."
        },
        {
          "s": 36,
          "text": "וע\"ד מ\"ש בשער היחוד והאמונה67"
        },
        {
          "s": 37,
          "text": "שזהו כמי שאומר על איזה חכמה רמה ועמוקה שאי אפשר למששה בידים מפני עומק המושג,"
        },
        {
          "s": 38,
          "text": "שכל השומע יצחק לו,"
        },
        {
          "s": 39,
          "text": "לפי שענין החכמה אינו בגדר מישוש כלל,"
        },
        {
          "s": 40,
          "text": "אפילו לא בדרך שלילה."
        },
        {
          "s": 41,
          "text": "ועז\"נ תכלית הידיעה שלא נדעך,"
        },
        {
          "s": 42,
          "text": "שגם בהבחי' דלא נדעך צ\"ל ענין הידיעה,"
        },
        {
          "s": 43,
          "text": "והוא מה שעצם הנפש מכיר בעצם א\"ס"
        },
        {
          "s": 44,
          "text": "(עצם נעמט עצם)."
        },
        {
          "s": 45,
          "text": "וכמו עד\"מ68"
        },
        {
          "s": 46,
          "text": "תינוק קטן שיש לו עדיין קטנות הדעת או שאין לו דעת כלל,"
        },
        {
          "s": 47,
          "text": "ומ\"מ נמשך לאביו,"
        },
        {
          "s": 48,
          "text": "שאין זה מצד איזה טעם שמבין איך הוא אביו וכו',"
        },
        {
          "s": 49,
          "text": "והוא רק בהכרה עצמית מפני שממנו נולד."
        },
        {
          "s": 50,
          "text": "וענין זה נמשך גם בכחות הגלוים,"
        },
        {
          "s": 51,
          "text": "והו\"ע דעת אלקי שהוא למעלה מחו\"ב,"
        },
        {
          "s": 52,
          "text": "ומצד דעת אלקי יכול להיות ההחלט לבחור בטוב,"
        },
        {
          "s": 53,
          "text": "אף שמצד השכל יכול להיות באופן דחכמים המה להרע."
        },
        {
          "s": 54,
          "text": "וכיון שהציווי ובחרת בחיים הוא לכאו\"א מישראל,"
        },
        {
          "s": 55,
          "text": "הרי מובן שהכח על זה ניתן לכאו\"א מישראל,"
        },
        {
          "s": 56,
          "text": "גם לאנשים פשוטים שאין להם הבנה והשגה,"
        },
        {
          "s": 57,
          "text": "והיינו,"
        },
        {
          "s": 58,
          "text": "שהדעת אלקי שמצד העצם נמשך למטה מטה לכאו\"א מישראל,"
        },
        {
          "s": 59,
          "text": "גם לאנשים פשוטים,"
        },
        {
          "s": 60,
          "text": "שגם להם יש הנתינת כח שיהי' ובחרת בחיים."
        }
      ]
    },
    {
      "v": 14,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "והנה כל זה הוא מצד פנימיות הדעת,"
        },
        {
          "s": 2,
          "text": "משא\"כ מצד חיצוניות הדעת יכול להיות תערובות טו\"ר,"
        },
        {
          "s": 3,
          "text": "וזהו שהתחלת השבירה הי' בבחי' הדעת,"
        },
        {
          "s": 4,
          "text": "כי כל סיבת ההתערבות דטו\"ר הוא מצד הדעת,"
        },
        {
          "s": 5,
          "text": "כנ\"ל."
        },
        {
          "s": 6,
          "text": "אמנם,"
        },
        {
          "s": 7,
          "text": "גם ענין ההבדלה בין טו\"ר והבירור שבוחר בטוב ומפריד הרע הוא ע\"י הדעת,"
        },
        {
          "s": 8,
          "text": "אלא שזהו מבחי' העליונה שבדעת,"
        },
        {
          "s": 9,
          "text": "שהו\"ע ההכרה העצמית בעצמות אוא\"ס,"
        },
        {
          "s": 10,
          "text": "שבחי' ומדריגה זו היא רק בקדושה."
        },
        {
          "s": 11,
          "text": "וזהו ענין מלך השמיני,"
        },
        {
          "s": 12,
          "text": "הדר,"
        },
        {
          "s": 13,
          "text": "שלא נאמר בו וימת,"
        },
        {
          "s": 14,
          "text": "לפי שלא הי' בו ענין השבירה,"
        },
        {
          "s": 15,
          "text": "והוא שרש ומקור התיקון."
        },
        {
          "s": 16,
          "text": "והענין הוא,"
        },
        {
          "s": 17,
          "text": "דהנה מלך השמיני הוא יסוד,"
        },
        {
          "s": 18,
          "text": "ויסוד הוא מקו האמצעי שנמשך מהדעת,"
        },
        {
          "s": 19,
          "text": "וכמאמר אין קישוי אלא לדעת69,"
        },
        {
          "s": 20,
          "text": "ולמעלה יותר,"
        },
        {
          "s": 21,
          "text": "שממשיך מבחי' הכתר,"
        },
        {
          "s": 22,
          "text": "שהרי הכתר נמשך עד סיום הקו,"
        },
        {
          "s": 23,
          "text": "ולכן אנו רואים שבהשפעת הטפה נמשך העצם יותר מאשר בהשפעת דעת ושכל,"
        },
        {
          "s": 24,
          "text": "וכמבואר הראי' מזה שסומא מוליד שלם וכו'70."
        },
        {
          "s": 25,
          "text": "ומשו\"ז לא נאמר בהדר וימת,"
        },
        {
          "s": 26,
          "text": "מפני שביסוד לא הי' ענין השבירה,"
        },
        {
          "s": 27,
          "text": "ואדרבה הוא שרש ומקור התיקון,"
        },
        {
          "s": 28,
          "text": "שזהו\"ע הבירור."
        },
        {
          "s": 29,
          "text": "ובפרטיות יותר,"
        },
        {
          "s": 30,
          "text": "הנה בענין הבירור גופא יש ב' אופנים,"
        },
        {
          "s": 31,
          "text": "בירור מלמעלה למטה,"
        },
        {
          "s": 32,
          "text": "ובירור מלמטה למעלה."
        },
        {
          "s": 33,
          "text": "והנה,"
        },
        {
          "s": 34,
          "text": "כשהבירור הוא בדרך גילוי אור מלמעלה,"
        },
        {
          "s": 35,
          "text": "יכול להיות שניצוצות דקדושה שנכבו יודחו ולא יתבררו,"
        },
        {
          "s": 36,
          "text": "ועוד זאת,"
        },
        {
          "s": 37,
          "text": "דכיון שהבירור אינו מכח התחתון,"
        },
        {
          "s": 38,
          "text": "יכול להיות שלאחרי שיסתלק האור ישאר התחתון במדריגתו ולא יתברר."
        },
        {
          "s": 39,
          "text": "ולכן צריך להיות הבירור בדרך עבודה מלמטה למעלה."
        },
        {
          "s": 40,
          "text": "וזהו שיצחק רצה לברך את עשו,"
        },
        {
          "s": 41,
          "text": "והיינו שרצה להמשיך עליו אור עליון שעי\"ז יתברר בדרך ממילא,"
        },
        {
          "s": 42,
          "text": "וטעה בזה,"
        },
        {
          "s": 43,
          "text": "כי הי' מתבטל לגמרי,"
        },
        {
          "s": 44,
          "text": "וצריך להיות התיקון שלו ע\"י יעקב,"
        },
        {
          "s": 45,
          "text": "שאז הוא בדרך בירור."
        },
        {
          "s": 46,
          "text": "ואף שביעקב כתיב ויתן גו'71,"
        },
        {
          "s": 47,
          "text": "יתן ויחזור ויתן72,"
        },
        {
          "s": 48,
          "text": "הרי אין הכוונה שהבירור הוא ע\"י גילוי אור מלמעלה,"
        },
        {
          "s": 49,
          "text": "אלא שזה הי' רק בדרך נתינת כח,"
        },
        {
          "s": 50,
          "text": "ואח\"כ צ\"ל הבירור בדרך של עבודה מלמטה למעלה."
        },
        {
          "s": 51,
          "text": "וענין זה נעשה ע\"י הדעת דוקא."
        }
      ]
    }
  ]
}