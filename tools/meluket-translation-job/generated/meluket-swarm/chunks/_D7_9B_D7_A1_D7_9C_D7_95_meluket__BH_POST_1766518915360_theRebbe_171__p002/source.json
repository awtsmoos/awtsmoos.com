{
  "globalIndex": 273,
  "owner": 23,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915360_theRebbe_171__p002",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915360_theRebbe_171__p002",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915360_theRebbe_171",
  "title": "מאמר פדה בשלום תשמ\"א",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה בהבירור דתורה יש חילוק בין הבירור שע\"י גליא דתורה להבירור שע\"י פנימיות התורה21."
        },
        {
          "s": 2,
          "text": "דבהבירור שע\"י לימוד גליא דתורה צריך להיות הלימוד בענינים אלו שצריכים לבררם,"
        },
        {
          "s": 3,
          "text": "ומהטעמים על זה שהתורה נתלבשה בדברים גשמיים וגם בדברים האסורים ועד לטענות של שקר22,"
        },
        {
          "s": 4,
          "text": "הוא,"
        },
        {
          "s": 5,
          "text": "בכדי לפעול הבירור גם בענינים אלו23."
        },
        {
          "s": 6,
          "text": "וזה שגם הבירור שע\"י גליא דתורה נק' בשם בירור בדרך מנוחה24"
        },
        {
          "s": 7,
          "text": "הוא מפני שגם ענינים אלו"
        },
        {
          "s": 8,
          "text": "(דברים האסורים וגם טענות של שקר)"
        },
        {
          "s": 9,
          "text": "כמו שהם בתורה25,"
        },
        {
          "s": 10,
          "text": "הם תורה,"
        },
        {
          "s": 11,
          "text": "תורת אמת,"
        },
        {
          "s": 12,
          "text": "ומכיון שגם דברים אלה שבתורה הם דבר ה'26,"
        },
        {
          "s": 13,
          "text": "הלא כה דברי כאש27"
        },
        {
          "s": 14,
          "text": "מה אש כו' אף דברי תורה אינן מקבלין טומאה28,"
        },
        {
          "s": 15,
          "text": "הרי שהתורה היא תמיד במקומה ומדריגתה"
        },
        {
          "s": 16,
          "text": "(דבר ה'),"
        },
        {
          "s": 17,
          "text": "והבירור הוא בדרך ממילא."
        },
        {
          "s": 18,
          "text": "אלא שאעפ\"כ אין זה דומה להבירור שע\"י פנימיות התורה,"
        },
        {
          "s": 19,
          "text": "דבהבירור שע\"י גליא דתורה הרי זה גופא שהתורה מדברת בנוגע לדברים גשמיים וכו',"
        },
        {
          "s": 20,
          "text": "הרי זה ענין של ירידה29"
        },
        {
          "s": 21,
          "text": "כביכול,"
        },
        {
          "s": 22,
          "text": "אלא שגם לאחרי ירידתה והמשכתה למטה היא תורה,"
        },
        {
          "s": 23,
          "text": "דבר ה'"
        },
        {
          "s": 24,
          "text": "(ולא שיורדת ומתלבשת בענין אחר)."
        },
        {
          "s": 25,
          "text": "משא\"כ הבירור שע\"י פנימיות התורה,"
        },
        {
          "s": 26,
          "text": "מכיון שפנימיות התורה היא אילנא דחיי"
        },
        {
          "s": 27,
          "text": "(שאינה מלובשת בטו\"ר)30,"
        },
        {
          "s": 28,
          "text": "הרי הבירור שנעשה עי\"ז הוא שלא בדרך התלבשות כלל."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ואולי יש להוסיף בהחילוק שבין גליא דתורה לפנימיות התורה,"
        },
        {
          "s": 2,
          "text": "דאמיתית הענין דמנוחה ושלום הוא דוקא בפנימיות התורה,"
        },
        {
          "s": 3,
          "text": "הוא לא רק בענין הבירורים שע\"י לימוד התורה,"
        },
        {
          "s": 4,
          "text": "אלא גם בלימוד התורה גופא."
        },
        {
          "s": 5,
          "text": "דהלימוד בנגלה דתורה הוא באופן דקושיות ותירוצים,"
        },
        {
          "s": 6,
          "text": "שבתחלה קס\"ד שהסברא היא כך וכך,"
        },
        {
          "s": 7,
          "text": "ואח\"כ מגיעים להבנה עמוקה יותר ושוללים את הסברא הקודמת,"
        },
        {
          "s": 8,
          "text": "ועד שאומרים עלי' בדותא היא31."
        },
        {
          "s": 9,
          "text": "דשלילת סברא הקודמת הו\"ע \"דם לרוב שפכת\""
        },
        {
          "s": 10,
          "text": "(שנאמר גבי דוד32)"
        },
        {
          "s": 11,
          "text": "כמו שהוא בעולם השכל."
        },
        {
          "s": 12,
          "text": "ואמיתית ענין השלום הוא דוקא בפנימיות התורה,"
        },
        {
          "s": 13,
          "text": "דלית תמן לא קושיא ולא מחלוקת33."
        },
        {
          "s": 14,
          "text": "ויש לומר,"
        },
        {
          "s": 15,
          "text": "דחילוק זה שבין גליא דתורה לפנימיות התורה שבאופן הלימוד גופא,"
        },
        {
          "s": 16,
          "text": "היא הסיבה להחילוק שביניהם בענין הבירור שעל ידם,"
        },
        {
          "s": 17,
          "text": "דכל פועל פועל בדוגמתו,"
        },
        {
          "s": 18,
          "text": "ולכן,"
        },
        {
          "s": 19,
          "text": "דוקא פנימיות התורה,"
        },
        {
          "s": 20,
          "text": "שבה עצמה לית תמן לא קושיא ולא מחלוקת,"
        },
        {
          "s": 21,
          "text": "גם הבירור שעל ידה הוא בדרך שלום ומנוחה."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "והנה גם בפנימיות התורה גופא יש שני אופנים בכללות."
        },
        {
          "s": 2,
          "text": "כמו שנתלבשה בהבנת והשגת השכל,"
        },
        {
          "s": 3,
          "text": "דבחינה זו שבפנימיות התורה ישנה גם עכשיו,"
        },
        {
          "s": 4,
          "text": "וכמו שהיא בבחינת ראי'"
        },
        {
          "s": 5,
          "text": "(למעלה מהבנה והשגה),"
        },
        {
          "s": 6,
          "text": "שבחינה זו תהי' לע\"ל,"
        },
        {
          "s": 7,
          "text": "כידוע34"
        },
        {
          "s": 8,
          "text": "שמשיח ילמד"
        },
        {
          "s": 9,
          "text": "(פנימיות)"
        },
        {
          "s": 10,
          "text": "התורה לכל ישראל באופן דראי'."
        },
        {
          "s": 11,
          "text": "וההפרש שבין השגה לראי' הוא,"
        },
        {
          "s": 12,
          "text": "דבהשגה,"
        },
        {
          "s": 13,
          "text": "גם כשהיא בהתאמתות,"
        },
        {
          "s": 14,
          "text": "אפשר שע\"י קושיא יהי' אצלו שינוי או חלישות עכ\"פ."
        },
        {
          "s": 15,
          "text": "משא\"כ בראי',"
        },
        {
          "s": 16,
          "text": "גם כשיקשו לו קושיות הכי חזקות,"
        },
        {
          "s": 17,
          "text": "לא יהי' אצלו שום ספק במה שראה."
        },
        {
          "s": 18,
          "text": "והטעם לזה הוא,"
        },
        {
          "s": 19,
          "text": "כי כשאדם משיג בשכלו איזה דבר,"
        },
        {
          "s": 20,
          "text": "הרי זהו דבר נוסף עליו,"
        },
        {
          "s": 21,
          "text": "משא\"כ כשהוא רואה איזה דבר,"
        },
        {
          "s": 22,
          "text": "הדבר נחקק בפנימיותו וכאילו שנעשה חלק מעצמותו ולכן אין שייך בזה שינוי."
        }
      ]
    }
  ]
}