{
  "globalIndex": 98,
  "owner": 48,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914243_theRebbe_128__p004",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914243_theRebbe_128__p004",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914243_theRebbe_128",
  "title": "מאמר ולקחתם לכם תשל\"ט",
  "part": 4,
  "sections": [
    {
      "v": 9,
      "items": [
        {
          "s": 0,
          "text": "ח)"
        },
        {
          "s": 1,
          "text": "ועד\"ז הוא גם בהענין דבירור הגוים כו'"
        },
        {
          "s": 2,
          "text": "(הללו את ה' כל גוים גו')"
        },
        {
          "s": 3,
          "text": "שבחג הסוכות,"
        },
        {
          "s": 4,
          "text": "שזה בא לאחרי הגילוי דבחינת יחידה."
        },
        {
          "s": 5,
          "text": "והענין הוא,"
        },
        {
          "s": 6,
          "text": "דכללות העבודה דעשי\"ת היא מעומק הלב,"
        },
        {
          "s": 7,
          "text": "ממעמקים קראתיך49."
        },
        {
          "s": 8,
          "text": "ואומר ממעמקים לשון רבים,"
        },
        {
          "s": 9,
          "text": "שני עומקים,"
        },
        {
          "s": 10,
          "text": "חי' ויחידה50."
        },
        {
          "s": 11,
          "text": "ובפרט בר\"ה"
        },
        {
          "s": 12,
          "text": "(התחלת עשי\"ת),"
        },
        {
          "s": 13,
          "text": "ומכ\"ש ביוהכ\"פ שבעשי\"ת עצמם הוא זמן תשובה כו' קץ מחילה וסליחה51,"
        },
        {
          "s": 14,
          "text": "שהעבודה אז היא בבחינת אחת"
        },
        {
          "s": 15,
          "text": "(יחידה52)"
        },
        {
          "s": 16,
          "text": "בכל ג' הענינים דעולם שנה נפש53."
        },
        {
          "s": 17,
          "text": "והגילוי דבחינת אחת"
        },
        {
          "s": 18,
          "text": "(שנמשכה בעשי\"ת ובפרט בר\"ה ויוהכ\"פ)"
        },
        {
          "s": 19,
          "text": "הוא בחג הסוכות"
        },
        {
          "s": 20,
          "text": "[כידוע54"
        },
        {
          "s": 21,
          "text": "בפירוש הכתוב55"
        },
        {
          "s": 22,
          "text": "בכסה ליום חגינו,"
        },
        {
          "s": 23,
          "text": "שכל הענינים שבעשי\"ת הם בכיסוי והעלם"
        },
        {
          "s": 24,
          "text": "(בכסה),"
        },
        {
          "s": 25,
          "text": "מתגלים הם בחג הסוכות."
        },
        {
          "s": 26,
          "text": "וזהו שהעבודה דעשי\"ת קשורה עם בכי',"
        },
        {
          "s": 27,
          "text": "ועד שמי56"
        },
        {
          "s": 28,
          "text": "שאינו בוכה בעשי\"ת57"
        },
        {
          "s": 29,
          "text": "אין נשמתו שלימה,"
        },
        {
          "s": 30,
          "text": "משא\"כ סוכות הוא זמן שמחתינו,"
        },
        {
          "s": 31,
          "text": "כי שמחה היא דוקא מדבר שבגילוי58,"
        },
        {
          "s": 32,
          "text": "וע\"י השמחה ניתוסף עוד יותר בהגילוי,"
        },
        {
          "s": 33,
          "text": "דטבע השמחה היא להוציא מן ההעלם אל הגילוי59,"
        },
        {
          "s": 34,
          "text": "ועד שהיא פורצת כל גדרים60]."
        }
      ]
    },
    {
      "v": 10,
      "items": [
        {
          "s": 0,
          "text": "ובהגילוי דבחינת אחת בחג הסוכות שתי דרגות."
        },
        {
          "s": 1,
          "text": "דתחלת הגילוי הוא ע\"י ישיבה בסוכה,"
        },
        {
          "s": 2,
          "text": "בחינת אחת,"
        },
        {
          "s": 3,
          "text": "כל ישראל ראויים לישב בסוכה אחת61."
        },
        {
          "s": 4,
          "text": "וגילוי זה הוא בבחי' מקיף."
        },
        {
          "s": 5,
          "text": "וע\"י מצות נטילת ד' מינים נמשך הגילוי בפנימיות,"
        },
        {
          "s": 6,
          "text": "וכמבואר בכ\"מ62."
        },
        {
          "s": 7,
          "text": "ויש לקשר זה עם המבואר לעיל"
        },
        {
          "s": 8,
          "text": "(סעיף ב)"
        },
        {
          "s": 9,
          "text": "שהאחדות דסוכה היא אחדות בעצם שמלכתחילה אין בה התחלקות פרטים משא\"כ האחדות שבמצות נטילת ד' מינים היא דהגם שישנם פרטים מחולקים מ\"מ הם באחדות,"
        },
        {
          "s": 10,
          "text": "כי פנימי הוא בבחי' התחלקות63,"
        },
        {
          "s": 11,
          "text": "ולכן,"
        },
        {
          "s": 12,
          "text": "האחדות דסוכה שאין בה התחלקות,"
        },
        {
          "s": 13,
          "text": "היא בבחי' מקיף,"
        },
        {
          "s": 14,
          "text": "וע\"י האחדות בד' המינים,"
        },
        {
          "s": 15,
          "text": "שהם כנגד ד' סוגים שבישראל,"
        },
        {
          "s": 16,
          "text": "ועד\"ז כנגד ד' הדרגות שבכל אחד64,"
        },
        {
          "s": 17,
          "text": "היא נמשכת בפנימיות."
        }
      ]
    },
    {
      "v": 11,
      "items": [
        {
          "s": 0,
          "text": "ט)"
        },
        {
          "s": 1,
          "text": "וע\"י גילוי האחדות בהפרטים שבישראל"
        },
        {
          "s": 2,
          "text": "(ד' הסוגים שבכלל ישראל,"
        },
        {
          "s": 3,
          "text": "וד' הדרגות שבנשמת כל אחד),"
        },
        {
          "s": 4,
          "text": "נמשך ע\"י מצות נטילת ד' מינים עוד ענין,"
        },
        {
          "s": 5,
          "text": "שעל ידם מתגלה שישראל אינון ניצוחייא,"
        },
        {
          "s": 6,
          "text": "ובאופן שגם אומות העולם מסכימים לזה,"
        },
        {
          "s": 7,
          "text": "ועד שהם מהללים ומשבחים את הוי' על זה שגבר עלינו חסדו."
        },
        {
          "s": 8,
          "text": "והענין הוא,"
        },
        {
          "s": 9,
          "text": "דענין הריבוי הוא בעיקר באוה\"ע."
        },
        {
          "s": 10,
          "text": "דנוסף לזה שאתם המעט מכל העמים65"
        },
        {
          "s": 11,
          "text": "וישראל אחד בשבעים באומות66,"
        },
        {
          "s": 12,
          "text": "הנה כל ישראל הם קומה אחת67,"
        },
        {
          "s": 13,
          "text": "וענין הריבוי"
        },
        {
          "s": 14,
          "text": "(דברים נפרדים)"
        },
        {
          "s": 15,
          "text": "הוא בגוים ואומות העולם68."
        },
        {
          "s": 16,
          "text": "והנה הטעם על זה שכל ישראל הם באחדות הוא מפני ששרשם הוא בהוי',"
        },
        {
          "s": 17,
          "text": "הוי' אחד69."
        },
        {
          "s": 18,
          "text": "ומזה מובן,"
        },
        {
          "s": 19,
          "text": "דענין האחדות דישראל הוא נוסף ע\"ז שאינם נפרדים זה מזה"
        },
        {
          "s": 20,
          "text": "(כאוה\"ע),"
        },
        {
          "s": 21,
          "text": "אלא שהם נעלים"
        },
        {
          "s": 22,
          "text": "(בשלילה)"
        },
        {
          "s": 23,
          "text": "גם מהתחלקות דמלאכים70"
        },
        {
          "s": 24,
          "text": "ודעולמות שנתהוו משם אלקים לשון רבים71,"
        },
        {
          "s": 25,
          "text": "ויתירה מזו,"
        },
        {
          "s": 26,
          "text": "שהם למעלה גם מההתחלקות דשם אלקים"
        },
        {
          "s": 27,
          "text": "(לשון רבים),"
        },
        {
          "s": 28,
          "text": "שבכללות הוא אור הממכ\"ע שמחי' כל עולם וכל נברא לפי ערכו."
        },
        {
          "s": 29,
          "text": "אלא שאעפ\"כ,"
        },
        {
          "s": 30,
          "text": "כיון שגם בישראל יש ענין הריבוי"
        },
        {
          "s": 31,
          "text": "(בחיצוניות),"
        },
        {
          "s": 32,
          "text": "הנה ע\"י המשכת האחדות בהריבוי דישראל,"
        },
        {
          "s": 33,
          "text": "עי\"ז היא נמשכת גם בהריבוי דשם אלקים,"
        },
        {
          "s": 34,
          "text": "ועי\"ז גם בהריבוי דעולמות ונבראים,"
        },
        {
          "s": 35,
          "text": "ועד לריבוי הנבראים שבעוה\"ז הגשמי"
        },
        {
          "s": 36,
          "text": "[דענין מה רבו מעשיך ה'72"
        },
        {
          "s": 37,
          "text": "(ההתחלקות לריבוי פרטים)"
        },
        {
          "s": 38,
          "text": "הוא בעיקר בעוה\"ז הגשמי דוקא],"
        },
        {
          "s": 39,
          "text": "כולל גם הריבוי דאומות העולם."
        },
        {
          "s": 40,
          "text": "ויש לומר,"
        },
        {
          "s": 41,
          "text": "דזהו הקשר דשני הפירושים בענינם של ד' מינים,"
        },
        {
          "s": 42,
          "text": "דלפירוש אחד הם כנגד ד' סוגים שבישראל ולפירוש אחד הם כנגד ד' דרגות דלמעלה"
        },
        {
          "s": 43,
          "text": "(כנ\"ל סעיף ב),"
        },
        {
          "s": 44,
          "text": "דענין ד' הדרגות שלמעלה הוא שאור הממכ\"ע מחי' ומהוה את ד' העולמות אבי\"ע,"
        },
        {
          "s": 45,
          "text": "כל עולם לפי ערכו."
        },
        {
          "s": 46,
          "text": "וע\"י המשכת האחדות בהריבוי"
        },
        {
          "s": 47,
          "text": "(ד' סוגים וד' דרגות)"
        },
        {
          "s": 48,
          "text": "דישראל,"
        },
        {
          "s": 49,
          "text": "עי\"ז ממשיכים זה גם בבחינת הריבוי שבאור הממלא"
        },
        {
          "s": 50,
          "text": "(ד' דרגות דלמעלה),"
        },
        {
          "s": 51,
          "text": "ועי\"ז – גם בהריבוי דעולמות וכו' ועד בהריבוי דאוה\"ע."
        }
      ]
    }
  ]
}