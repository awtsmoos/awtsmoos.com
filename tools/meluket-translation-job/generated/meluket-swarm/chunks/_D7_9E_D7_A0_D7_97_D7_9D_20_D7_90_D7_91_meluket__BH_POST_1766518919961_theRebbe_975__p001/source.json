{
  "globalIndex": 1047,
  "owner": 47,
  "jobId": "_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919961_theRebbe_975__p001",
  "batchId": "meluket-_D7_9E_D7_A0_D7_97_D7_9D_20_D7_90_D7_91_meluket__BH_POST_1766518919961_theRebbe_975__p001",
  "seriesId": "מנחם אב_meluket",
  "postId": "BH_POST_1766518919961_theRebbe_975",
  "title": "מאמר ועתה ישראל תשל\"ז",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "כ\"ף מנחם-אב ה'תשל\"ז*"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "ועתה ישראל מה ה' אלקיך שואל מעמך כי אם ליראה גו'1,"
        },
        {
          "s": 1,
          "text": "ואיתא בגמרא2"
        },
        {
          "s": 2,
          "text": "תניא הי' ר' מאיר אומר חייב אדם לברך מאה ברכות בכל יום שנאמר ועתה ישראל מה ה' אלקיך שואל מעמך,"
        },
        {
          "s": 3,
          "text": "אל תקרי מה אלא מאה3."
        },
        {
          "s": 4,
          "text": "ויש לומר,"
        },
        {
          "s": 5,
          "text": "דהטעם על זה שדרשו אל תקרי מה כו' הוא4,"
        },
        {
          "s": 6,
          "text": "כי לפי פירוש הפשוט צריך ביאור,"
        },
        {
          "s": 7,
          "text": "מדוע אומר הכתוב ענין זה"
        },
        {
          "s": 8,
          "text": "(שה' אלקיך שואל מעמך רק ליראה גו')"
        },
        {
          "s": 9,
          "text": "בסגנון של שאלה ותשובה,"
        },
        {
          "s": 10,
          "text": "דלכאורה הוה לי' למימר אין ה' אלקיך שואל מעמך כי אם ליראה גו'."
        },
        {
          "s": 11,
          "text": "ולכן דרשו אל תקרי מה אלא מאה."
        },
        {
          "s": 12,
          "text": "והנה ידוע5"
        },
        {
          "s": 13,
          "text": "בכללי הלימוד אל תקרי,"
        },
        {
          "s": 14,
          "text": "שאינו שולל פירוש הענין כפי שהוא נקרא אלא שמוסיף עוד פירוש,"
        },
        {
          "s": 15,
          "text": "ושני הפירושים שייכים זל\"ז6."
        },
        {
          "s": 16,
          "text": "וצריך להבין הקשר והשייכות דמה ומאה."
        },
        {
          "s": 17,
          "text": "ובפרט שהחילוק דשני הפירושים הוא"
        },
        {
          "s": 18,
          "text": "(לא רק בתיבה זו עצמה,"
        },
        {
          "s": 19,
          "text": "אלא)"
        },
        {
          "s": 20,
          "text": "גם בכללות הכתוב."
        },
        {
          "s": 21,
          "text": "דלפי פשוטו הוא שאינו שואל מאומה כ\"א ליראה,"
        },
        {
          "s": 22,
          "text": "משא\"כ לפירוש הגמרא,"
        },
        {
          "s": 23,
          "text": "מה"
        },
        {
          "s": 24,
          "text": "(מאה ברכות)"
        },
        {
          "s": 25,
          "text": "הוא הדבר שה' אלקיך שואל מעמך."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה מבואר בכ\"מ בענין הלימוד אל תקרי,"
        },
        {
          "s": 2,
          "text": "שהפירוש לפי פשוטו הוא ע\"י תוכן הפירוש שדרשו חז\"ל7."
        },
        {
          "s": 3,
          "text": "ועפ\"ז יובן הלשון אל תקרי דמשמע ששולל הפירוש שבפשטות,"
        },
        {
          "s": 4,
          "text": "דהכוונה בזה,"
        },
        {
          "s": 5,
          "text": "שאי אפשר להיות פירוש זה כי אם ע\"י הפירוש הנדרש."
        },
        {
          "s": 6,
          "text": "ועפ\"ז,"
        },
        {
          "s": 7,
          "text": "בנדו\"ד – אל תקרי מה אלא מאה,"
        },
        {
          "s": 8,
          "text": "שע\"י מאה באים למה."
        },
        {
          "s": 9,
          "text": "וצריך להבין,"
        },
        {
          "s": 10,
          "text": "דלשון מה מורה שהענין"
        },
        {
          "s": 11,
          "text": "(המדובר)"
        },
        {
          "s": 12,
          "text": "הוא דבר קטן,"
        },
        {
          "s": 13,
          "text": "ובלשון הגמרא8"
        },
        {
          "s": 14,
          "text": "מילתא זוטרתי,"
        },
        {
          "s": 15,
          "text": "משא\"כ מאה הוא9"
        },
        {
          "s": 16,
          "text": "מספר גדול ועד לשלימות המספר10,"
        },
        {
          "s": 17,
          "text": "שבכדי להגיע לשלימות צריך לעבודה רבה"
        },
        {
          "s": 18,
          "text": "[וכמו\"כ הוא גם בנוגע למאה ברכות כפשוטם,"
        },
        {
          "s": 19,
          "text": "שבכדי לברך מאה ברכות בכל יום גם בשבת ויו\"ט"
        },
        {
          "s": 20,
          "text": "(ועד\"ז ביום התענית11),"
        },
        {
          "s": 21,
          "text": "צ\"ל השתדלות מיוחדת12],"
        },
        {
          "s": 22,
          "text": "ואיך אומרים שבכדי לבוא למה"
        },
        {
          "s": 23,
          "text": "(מילתא זוטרתי)"
        },
        {
          "s": 24,
          "text": "הוא דוקא ע\"י מאה"
        },
        {
          "s": 25,
          "text": "(ענין השלימות שבא ע\"י עבודה)."
        }
      ]
    }
  ]
}