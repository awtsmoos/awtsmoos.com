{
  "globalIndex": 102,
  "owner": 2,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914265_theRebbe_229__p002",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914265_theRebbe_229__p002",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914265_theRebbe_229",
  "title": "מאמר כנשר יעיר קנו תשמ\"ב",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "והענין הוא,"
        },
        {
          "s": 1,
          "text": "דהנה כתיב9"
        },
        {
          "s": 2,
          "text": "שלשה המה נפלאו ממני גו' דרך הנשר בשמים גו',"
        },
        {
          "s": 3,
          "text": "ומבואר במ\"א10"
        },
        {
          "s": 4,
          "text": "דהפלא הוא איך יש פני נשר שהוא עוף טמא במרכבה העליונה."
        },
        {
          "s": 5,
          "text": "וצריך להבין11,"
        },
        {
          "s": 6,
          "text": "שהרי יש במרכבה גם פני ארי' אל הימין12"
        },
        {
          "s": 7,
          "text": "שהוא חי' טמאה,"
        },
        {
          "s": 8,
          "text": "ומדוע הפליאה היא על הנשר דוקא."
        },
        {
          "s": 9,
          "text": "והביאור בזה,"
        },
        {
          "s": 10,
          "text": "ע\"פ המבואר במ\"א13"
        },
        {
          "s": 11,
          "text": "שדרך הנשר"
        },
        {
          "s": 12,
          "text": "(פני נשר שבמרכבה)"
        },
        {
          "s": 13,
          "text": "הו\"ע קו האמצעי."
        },
        {
          "s": 14,
          "text": "וזהו מה שתמה על פני נשר דוקא14,"
        },
        {
          "s": 15,
          "text": "כי פני ארי' אל הימין,"
        },
        {
          "s": 16,
          "text": "דפני ארי' שבמרכבה הם בקו הימין העולה בחיצוניות הכתר בלבד,"
        },
        {
          "s": 17,
          "text": "ואין זה פלא כ\"כ,"
        },
        {
          "s": 18,
          "text": "משא\"כ פני נשר שהם בקו האמצעי העולה בפנימיות הכתר15,"
        },
        {
          "s": 19,
          "text": "יפלא מאד איך יש פני עוף טמא בפנימיות הכתר."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "וביאור הענין,"
        },
        {
          "s": 1,
          "text": "דהנה דוקא להיות מדת הרחמים מושרשת בפנימיות הכתר,"
        },
        {
          "s": 2,
          "text": "לפיכך נפלה למטה מטה,"
        },
        {
          "s": 3,
          "text": "וזהו שנק' נשר מלשון נשירה ונפילה16,"
        },
        {
          "s": 4,
          "text": "דנפיל מן דרגי',"
        },
        {
          "s": 5,
          "text": "עד לעוף טמא שמחוץ למקום הקדושה."
        },
        {
          "s": 6,
          "text": "ובזה יובן המשך הפסוקים,"
        },
        {
          "s": 7,
          "text": "דכתיב לעיל מיני' ימצאהו בארץ מדבר גו',"
        },
        {
          "s": 8,
          "text": "דמדבר הוא מקום אשר לא ישב אדם שם17,"
        },
        {
          "s": 9,
          "text": "היינו שהוא מחוץ למושב האדם העליון18,"
        },
        {
          "s": 10,
          "text": "ועד\"ז מחוץ למושב בני ישראל הקרויים אדם19"
        },
        {
          "s": 11,
          "text": "אדמה לעליון20,"
        },
        {
          "s": 12,
          "text": "כי בכל ישראל יש נפש הקדושה שהיא חלק אלוקה ממעל ממש21,"
        },
        {
          "s": 13,
          "text": "וכדכתיב לפנ\"ז22"
        },
        {
          "s": 14,
          "text": "כי חלק הוי' עמו גו',"
        },
        {
          "s": 15,
          "text": "ולפיכך אין להם שום שייכות למקום המדבר"
        },
        {
          "s": 16,
          "text": "(שמחוץ לקדושה),"
        },
        {
          "s": 17,
          "text": "ולא זו בלבד שלא ישב אדם"
        },
        {
          "s": 18,
          "text": "(היינו ישראל)"
        },
        {
          "s": 19,
          "text": "שם,"
        },
        {
          "s": 20,
          "text": "אלא שלא עבר שם,"
        },
        {
          "s": 21,
          "text": "היינו שאין לישראל כל שייכות למקום זה."
        },
        {
          "s": 22,
          "text": "וזהו שממשיך כנשר יעיר קנו גו',"
        },
        {
          "s": 23,
          "text": "כי למקום זה נפלה בחי' נשר."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "אמנם23 גם על מקום זה נאמר ימצאהו בארץ מדבר גו',"
        },
        {
          "s": 1,
          "text": "דגם משם יקבצך ה' אלקיך ומשם יקחך24."
        },
        {
          "s": 2,
          "text": "וההעלאה והתשובה ממקום זה היא ע\"י גילוי בחי' כנשר בדרגא הכי עליונה,"
        },
        {
          "s": 3,
          "text": "בחי' פנימיות הכתר,"
        },
        {
          "s": 4,
          "text": "כי מיני' ובי' אבא לשדי' בי' נרגא25,"
        },
        {
          "s": 5,
          "text": "ועי\"ז עולים לפנימיות הכתר."
        },
        {
          "s": 6,
          "text": "דכיון שכל הגבוה יותר יורד למטה ביותר הרי דוקא ע\"י שעולים ממקום רחוק כזה,"
        },
        {
          "s": 7,
          "text": "העלי' היא למעלה ביותר."
        },
        {
          "s": 8,
          "text": "וע\"ד המבואר בכ\"מ26"
        },
        {
          "s": 9,
          "text": "(מל\"ת להאריז\"ל27)"
        },
        {
          "s": 10,
          "text": "בפי' הכתוב28"
        },
        {
          "s": 11,
          "text": "כי לא על הלחם לבדו יחי' האדם כי על כל מוצא פי הוי' יחי' האדם,"
        },
        {
          "s": 12,
          "text": "שהמדבר צריך למוצא פי הוי' שבדצ\"ח,"
        },
        {
          "s": 13,
          "text": "משום שמזה שנפלו הניצוצות למטה ביותר"
        },
        {
          "s": 14,
          "text": "(בדצ\"ח שלמטה ממדבר)"
        },
        {
          "s": 15,
          "text": "מוכח ששרשם למעלה יותר,"
        },
        {
          "s": 16,
          "text": "ולכן בכחם דוקא להחיות את המוצא פי הוי' שבמדבר."
        },
        {
          "s": 17,
          "text": "ועד\"ז יובן למטה מזה,"
        },
        {
          "s": 18,
          "text": "בבחי' נשר שענינה הנפילה מחוץ למקום הקדושה,"
        },
        {
          "s": 19,
          "text": "דדוקא ע\"י העלי' ממקום זה עולים עד לפנימיות הכתר."
        },
        {
          "s": 20,
          "text": "וזהו טעם ירידת הנשמה למטה מאיגרא רמה לבירא עמיקתא29,"
        },
        {
          "s": 21,
          "text": "מבחי' נשמה שנתת בי עד לנפחתה בי30"
        },
        {
          "s": 22,
          "text": "בעוה\"ז התחתון,"
        },
        {
          "s": 23,
          "text": "כדי שבעולם זה תהי' העלי' מלמטה ביותר,"
        },
        {
          "s": 24,
          "text": "בסולם המוצב ארצה31"
        },
        {
          "s": 25,
          "text": "דוקא,"
        },
        {
          "s": 26,
          "text": "ועי\"ז ראשו מגיע השמימה31,"
        },
        {
          "s": 27,
          "text": "למעלה ביותר,"
        },
        {
          "s": 28,
          "text": "עד שהרוח תשוב אל האלקים אשר נתנה32."
        },
        {
          "s": 29,
          "text": "וזהו33"
        },
        {
          "s": 30,
          "text": "מה שממשיך2"
        },
        {
          "s": 31,
          "text": "יצרנו כאישון עינו,"
        },
        {
          "s": 32,
          "text": "דאישון הוא השחור שבעין כמארז\"ל34"
        },
        {
          "s": 33,
          "text": "אין אדם רואה מתוך הלבן שבעין אלא מתוך השחור שבעין,"
        },
        {
          "s": 34,
          "text": "דענין השחור שבעין היינו השחרות וההעלם והריחוק וכו'."
        },
        {
          "s": 35,
          "text": "דע\"י ההתבוננות בזה שנמצא במקום ההעלם,"
        },
        {
          "s": 36,
          "text": "במקום רחוק,"
        },
        {
          "s": 37,
          "text": "ורע ומר עזבך את ה'35,"
        },
        {
          "s": 38,
          "text": "עי\"ז בא לתשובה מעומקא דליבא עד שזדונות נעשו לו כזכיות וזכיות."
        }
      ]
    }
  ]
}