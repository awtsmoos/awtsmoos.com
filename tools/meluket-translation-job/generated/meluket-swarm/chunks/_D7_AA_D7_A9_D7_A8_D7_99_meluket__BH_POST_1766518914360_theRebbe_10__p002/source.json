{
  "globalIndex": 112,
  "owner": 12,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914360_theRebbe_10__p002",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914360_theRebbe_10__p002",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914360_theRebbe_10",
  "title": "מאמר וחג האסיף תשמ\"ג",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ולהבין זה"
        },
        {
          "s": 2,
          "text": "(השייכות דסוכה ונטילת ד' מינים לאסיפת התבואה)"
        },
        {
          "s": 3,
          "text": "יש להקדים מה שארז\"ל18"
        },
        {
          "s": 4,
          "text": "פרי עץ הדר זה הקב\"ה כפות תמרים זה הקב\"ה וענף עץ עבות זה הקב\"ה וערבי נחל זה הקב\"ה"
        },
        {
          "s": 5,
          "text": "(ומביאים ראיות מפסוקים על זה)."
        },
        {
          "s": 6,
          "text": "ומבאר בעל ההילולא19,"
        },
        {
          "s": 7,
          "text": "דמה שכל א' מד' המינים מורה על הקב\"ה הוא מצד ענין האחדות שבהם."
        },
        {
          "s": 8,
          "text": "דפרי20"
        },
        {
          "s": 9,
          "text": "עץ הדר זה אתרוג שדר באילנו משנה לשנה21,"
        },
        {
          "s": 10,
          "text": "דבמשך השנה יש כו\"כ שינויים מן הקצה אל הקצה שלכן נקראת בשם שנה מלשון שינוי22"
        },
        {
          "s": 11,
          "text": "לפי שיש בה כל שינויי האוירים דכל ו' התקופות שנמנות בכתוב23,"
        },
        {
          "s": 12,
          "text": "והאתרוג"
        },
        {
          "s": 13,
          "text": "(שדר באילנו משנה לשנה)"
        },
        {
          "s": 14,
          "text": "הוא סובל את כל השינויים."
        },
        {
          "s": 15,
          "text": "ויתירה מזו,"
        },
        {
          "s": 16,
          "text": "דלא רק שהוא סובל את כל האוירים,"
        },
        {
          "s": 17,
          "text": "אלא שהוא גדל מהם."
        },
        {
          "s": 18,
          "text": "היינו,"
        },
        {
          "s": 19,
          "text": "דלא רק ששינויי האוירים אינם עושים בו גרעון,"
        },
        {
          "s": 20,
          "text": "אלא שהוא מקבל מהם תוספת צמיחה24."
        },
        {
          "s": 21,
          "text": "דזהו"
        },
        {
          "s": 22,
          "text": "(אמיתית)"
        },
        {
          "s": 23,
          "text": "ענין האחדות שבאתרוג,"
        },
        {
          "s": 24,
          "text": "שהוא מאחד את כל שינויי האוירים,"
        },
        {
          "s": 25,
          "text": "שמכולם נעשה דבר אחד"
        },
        {
          "s": 26,
          "text": "(מציאות האתרוג)."
        },
        {
          "s": 27,
          "text": "ועד\"ז הוא גם בלולב,"
        },
        {
          "s": 28,
          "text": "כפות תמרים"
        },
        {
          "s": 29,
          "text": "(כפת,"
        },
        {
          "s": 30,
          "text": "חסר כתיב)"
        },
        {
          "s": 31,
          "text": "ודרשו רז\"ל שצ\"ל כפות,"
        },
        {
          "s": 32,
          "text": "שהעלים צריכים להיות באופן שיהיו ראויים לכפותן ולאגדם יחד עם השדרה כדבר אחד25."
        },
        {
          "s": 33,
          "text": "דהגם שיש עוד אילנות שהענפים קרובים להעץ,"
        },
        {
          "s": 34,
          "text": "אין זה באופן דכפות"
        },
        {
          "s": 35,
          "text": "(אחדות)"
        },
        {
          "s": 36,
          "text": "כבלולב26."
        },
        {
          "s": 37,
          "text": "וכ\"ה גם בההדסים,"
        },
        {
          "s": 38,
          "text": "ענף עץ עבות,"
        },
        {
          "s": 39,
          "text": "עבות דוקא,"
        },
        {
          "s": 40,
          "text": "תלתא בחד קינא27."
        },
        {
          "s": 41,
          "text": "דהגם שהם ג' עלים נפרדים"
        },
        {
          "s": 42,
          "text": "[ריבוי התחלקות,"
        },
        {
          "s": 43,
          "text": "שהרי גם שנים הם רבים,"
        },
        {
          "s": 44,
          "text": "דמיעוט רבים שנים28,"
        },
        {
          "s": 45,
          "text": "ומכ\"ש ג']"
        },
        {
          "s": 46,
          "text": "מ\"מ הן \"עבות\""
        },
        {
          "s": 47,
          "text": "(כמין קליעה29),"
        },
        {
          "s": 48,
          "text": "בחד קינא."
        },
        {
          "s": 49,
          "text": "וכ\"ה גם בערבה"
        },
        {
          "s": 50,
          "text": "(ערבי נחל)"
        },
        {
          "s": 51,
          "text": "שנק' בגמרא בשם אחוונא30,"
        },
        {
          "s": 52,
          "text": "על שם שגדלים באחוה31."
        },
        {
          "s": 53,
          "text": "דאע\"פ שהם ערבי נחל,"
        },
        {
          "s": 54,
          "text": "ערבי לשון רבים,"
        },
        {
          "s": 55,
          "text": "הם באחוה ובאחדות,"
        },
        {
          "s": 56,
          "text": "וכך הוא אופן גידולם"
        },
        {
          "s": 57,
          "text": "(שגדלים באחוה)."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "והנה ענין האחדות שבד' מינים אלו הוא באופן שמריבוי נעשה אחדות."
        },
        {
          "s": 1,
          "text": "וכמו באתרוג,"
        },
        {
          "s": 2,
          "text": "שהאוירים דו' תקופות השנה הם שונים זה מזה"
        },
        {
          "s": 3,
          "text": "(ועד שהם הפכים),"
        },
        {
          "s": 4,
          "text": "ואעפ\"כ הם מתאחדים אח\"כ ונעשים דבר אחד"
        },
        {
          "s": 5,
          "text": "(מציאות האתרוג)."
        },
        {
          "s": 6,
          "text": "וכ\"ה גם בלולב,"
        },
        {
          "s": 7,
          "text": "שמזה גופא שאומרים שצ\"ל כפות מובן שיש בו עלים נפרדים וצריך לכפותם32."
        },
        {
          "s": 8,
          "text": "וכ\"ה גם בהדס שצ\"ל ג' עלים נפרדים ושאעפ\"כ יתאחדו זה עם זה"
        },
        {
          "s": 9,
          "text": "(בחד קינא)."
        },
        {
          "s": 10,
          "text": "וכ\"ה גם בערבי נחל,"
        },
        {
          "s": 11,
          "text": "שהם ריבוי ערבות"
        },
        {
          "s": 12,
          "text": "(ערבי לשון רבים33)"
        },
        {
          "s": 13,
          "text": "ואעפ\"כ הם מתאחדים וגדלים באחוה."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "וזהו הקשר דמצות נטילת ד' מינים עם חג הסוכות,"
        },
        {
          "s": 2,
          "text": "כי ענין הסוכה הוא שלום34,"
        },
        {
          "s": 3,
          "text": "היינו מה שמריבוי נעשה אחדות."
        },
        {
          "s": 4,
          "text": "דמזה מובן גם בנוגע לחג הסוכות,"
        },
        {
          "s": 5,
          "text": "שהוא"
        },
        {
          "s": 6,
          "text": "(כנ\"ל בתחילת המאמר)"
        },
        {
          "s": 7,
          "text": "על שם בסוכות תשבו,"
        },
        {
          "s": 8,
          "text": "שענינו הוא מה שמריבוי נעשה אחדות."
        },
        {
          "s": 9,
          "text": "דזהו חג הסוכות שבעת ימים35,"
        },
        {
          "s": 10,
          "text": "שבעת ימים הו\"ע ההתחלקות,"
        },
        {
          "s": 11,
          "text": "דכל יום הוא משונה מזולתו."
        },
        {
          "s": 12,
          "text": "ועד שהם כוללים התחלקות דכל משך הזמן."
        },
        {
          "s": 13,
          "text": "כי שבעת ימי השבוע הן שבעת ימי ההיקף36."
        },
        {
          "s": 14,
          "text": "דזהו מה שבכל שבוע אומרים היום יום ראשון,"
        },
        {
          "s": 15,
          "text": "היום יום שני וכו',"
        },
        {
          "s": 16,
          "text": "דלכאורה הלא מברה\"ע עד עתה כבר יש אלפים ורבבות ימים ולמה אנו מונין יום ראשון שני ושלישי וכו',"
        },
        {
          "s": 17,
          "text": "וידוע הביאור בזה37,"
        },
        {
          "s": 18,
          "text": "שזהו לפי שהם ימי ההיקף שחוזרין חלילה."
        },
        {
          "s": 19,
          "text": "וענין חג הסוכות שבעת ימים הוא,"
        },
        {
          "s": 20,
          "text": "שכל שבעת הימים נעשים ענין אחד,"
        },
        {
          "s": 21,
          "text": "חג הסוכות."
        }
      ]
    }
  ]
}