{
  "globalIndex": 458,
  "owner": 8,
  "jobId": "_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916371_theRebbe_639__p002",
  "batchId": "meluket-_D7_98_D7_91_D7_AA_meluket__BH_POST_1766518916371_theRebbe_639__p002",
  "seriesId": "טבת_meluket",
  "postId": "BH_POST_1766518916371_theRebbe_639",
  "title": "מאמר וידבר אלוקים אל משה תשל\"א",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויש לקשר זה עם מאמר מבעל ההילולא"
        },
        {
          "s": 2,
          "text": "(שלא נדפס עדיין)"
        },
        {
          "s": 3,
          "text": "ד\"ה אשרי יושבי ביתך7"
        },
        {
          "s": 4,
          "text": "[וכנראה שהמאמר ד\"ה זה שבסידור מאדמו\"ר האמצעי,"
        },
        {
          "s": 5,
          "text": "מיוסד הוא על מאמר הנ\"ל,"
        },
        {
          "s": 6,
          "text": "ובארוכה יותר נתבאר בפירוש המלות מאדמו\"ר האמצעי8,"
        },
        {
          "s": 7,
          "text": "ובפירוש המלות מהצ\"צ9"
        },
        {
          "s": 8,
          "text": "– בתוס' הערות ומ\"מ],"
        },
        {
          "s": 9,
          "text": "שמבאר10"
        },
        {
          "s": 10,
          "text": "שם כל תפלת אשרי עד הפסוק קרוב הוי' לכל קוראיו"
        },
        {
          "s": 11,
          "text": "(והמשך הפסוקים כבר נתבאר במקומות אחרים בדרושי אדמו\"ר הזקן)."
        },
        {
          "s": 12,
          "text": "ותוכן ביאורו הוא,"
        },
        {
          "s": 13,
          "text": "דאשרי הוא בחי' כתר עליון,"
        },
        {
          "s": 14,
          "text": "שנקרא אשרי שהו\"ע התענוג"
        },
        {
          "s": 15,
          "text": "(מלשון באשרי כי אשרוני בנות11)."
        },
        {
          "s": 16,
          "text": "וכן כתר עליון נקרא עתיק שהוא בחי' עונג העליון,"
        },
        {
          "s": 17,
          "text": "וממנו מתלבש באו\"א הנקראים יושבי ביתך,"
        },
        {
          "s": 18,
          "text": "שהם ב' הבתים דחכמה ובינה."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "וממשיך לבאר המזמור12"
        },
        {
          "s": 2,
          "text": "תהלה לדוד ארוממך אלקי המלך גו'"
        },
        {
          "s": 3,
          "text": "(שמזמור זה הוא עיקר תפלת אשרי והוא סיבת אמירתה,"
        },
        {
          "s": 4,
          "text": "כמארז\"ל13"
        },
        {
          "s": 5,
          "text": "האומר תהלה לדוד ג\"פ בכל יום מובטח לו כו')."
        },
        {
          "s": 6,
          "text": "ומבאר בזה,"
        },
        {
          "s": 7,
          "text": "דארוממך הוא ג\"כ בחי' כתר,"
        },
        {
          "s": 8,
          "text": "שנקרא רם מפני שהוא מרומם מכל הי\"ס,"
        },
        {
          "s": 9,
          "text": "כי כל הי\"ס הם בבחי' גילוי,"
        },
        {
          "s": 10,
          "text": "אבל הכתר הוא סתימא דכל סתימין,"
        },
        {
          "s": 11,
          "text": "ולכן אמר על הכתר ארוממך,"
        },
        {
          "s": 12,
          "text": "שהוא מרומם."
        },
        {
          "s": 13,
          "text": "וזהו גם פירוש ארוממך בכ\"ף,"
        },
        {
          "s": 14,
          "text": "כי הכ\"ף רומז ג\"כ על בחי' כתר,"
        },
        {
          "s": 15,
          "text": "הא' מפני שכ' הוא התחלת תיבת כתר,"
        },
        {
          "s": 16,
          "text": "והב' כי כ' הוא ב\"פ יו\"ד,"
        },
        {
          "s": 17,
          "text": "שהוא עשר ספירות באור ישר שמלמעלה למטה,"
        },
        {
          "s": 18,
          "text": "וע\"ס באור חוזר שמלמטה למעלה14,"
        },
        {
          "s": 19,
          "text": "והם נכללים בכתר"
        },
        {
          "s": 20,
          "text": "[משא\"כ כפי שהם בפני עצמם לא שייך שיהיו במספר עשרים,"
        },
        {
          "s": 21,
          "text": "כי הם שני סוגים שונים15,"
        },
        {
          "s": 22,
          "text": "ודוקא בכתר נכללים הם להיות מציאות אחת של עשרים]."
        },
        {
          "s": 23,
          "text": "אמנם,"
        },
        {
          "s": 24,
          "text": "ממש\"נ ארוממך בלשון נוכח,"
        },
        {
          "s": 25,
          "text": "משמע לכאורה שהוא לשון גילוי,"
        },
        {
          "s": 26,
          "text": "והרי הכתר הוא נעלם מהשגת הנבראים."
        },
        {
          "s": 27,
          "text": "אך על זה אמר אח\"כ אלקי המלך,"
        },
        {
          "s": 28,
          "text": "כלומר,"
        },
        {
          "s": 29,
          "text": "עיקר סיבת ההשגה בו הוא מפני שמתלבש במלך,"
        },
        {
          "s": 30,
          "text": "דהיינו מלכות דאצילות,"
        },
        {
          "s": 31,
          "text": "שבה מתלבש הכתר,"
        },
        {
          "s": 32,
          "text": "כי נעוץ סופן בתחלתן כו'16."
        },
        {
          "s": 33,
          "text": "והטעם הוא,"
        },
        {
          "s": 34,
          "text": "כי בהיות מלכות דאצילות יורדת למטה מטה במקום הקליפות לברר בירורים,"
        },
        {
          "s": 35,
          "text": "הנה לסיבה זו יכולים הקליפות לינק ממנה,"
        },
        {
          "s": 36,
          "text": "וע\"כ צריכה שמירה ממקום גבוה,"
        },
        {
          "s": 37,
          "text": "דהיינו מבחי' אור הכתר,"
        },
        {
          "s": 38,
          "text": "ובזה גופא,"
        },
        {
          "s": 39,
          "text": "לא רק חיצוניות הכתר,"
        },
        {
          "s": 40,
          "text": "אלא גם פנימיות הכתר,"
        },
        {
          "s": 41,
          "text": "וכנ\"ל דאשרי קאי על עתיק שהוא תענוג העליון דהיינו פנימיות הכתר"
        },
        {
          "s": 42,
          "text": "(ולא רק רצון שהוא חיצוניות הכתר),"
        },
        {
          "s": 43,
          "text": "ובחי' זו שהיא למעלה ביותר,"
        },
        {
          "s": 44,
          "text": "נמשכת ונעוצה דוקא במלכות שהיא סוף הספירות."
        },
        {
          "s": 45,
          "text": "וי\"ל שזהו ג\"כ מ\"ש ארוממך בכ' ארוכה,"
        },
        {
          "s": 46,
          "text": "כידוע שהמשכת הכ\"ף למטה מן השורה מורה שהיא יורדת למטה מטה ביותר."
        },
        {
          "s": 47,
          "text": "וזהו מה שממשיך ואברכה שמך לעולם ועד,"
        },
        {
          "s": 48,
          "text": "שלאחר שנתגלה הארת הכתר במלכות,"
        },
        {
          "s": 49,
          "text": "אזי יומשך ממנה השפע לעולמות בי\"ע,"
        },
        {
          "s": 50,
          "text": "וזהו ואברכה מלשון המבריך את הגפן17,"
        },
        {
          "s": 51,
          "text": "דהיינו ההמשכה שנמשכת מבחי' המלכות שנקראת שמך,"
        },
        {
          "s": 52,
          "text": "שהיא בחי' שם והארה בלבד"
        },
        {
          "s": 53,
          "text": "(ולא עצם),"
        },
        {
          "s": 54,
          "text": "וההמשכה היא לעולם ועד,"
        },
        {
          "s": 55,
          "text": "היינו שההמשכה לבי\"ע היא לאין קץ,"
        },
        {
          "s": 56,
          "text": "שיוכל להחיות נבראים עד אין קץ,"
        },
        {
          "s": 57,
          "text": "אף שזהו מבחי' שמך בלבד."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ועד\"ז מבואר ג\"כ בהמשך המאמר קרוב לסיומו18,"
        },
        {
          "s": 2,
          "text": "במש\"נ בהמשך המזמור,"
        },
        {
          "s": 3,
          "text": "פותח את ידיך ומשביע לכל חי רצון צדיק הוי' גו' קרוב הוי' גו'."
        },
        {
          "s": 4,
          "text": "ומבאר בזה ע\"פ משארז\"ל19"
        },
        {
          "s": 5,
          "text": "אל תקרי ידיך אלא יודי\"ך,"
        },
        {
          "s": 6,
          "text": "ומפרש דפותח את ידיך היינו פתיחו דיודי\"ן דתיקוני דיקנא,"
        },
        {
          "s": 7,
          "text": "שהת\"ד הם יודי\"ן וווי\"ן שנמשכים ונפתחים בחכמה,"
        },
        {
          "s": 8,
          "text": "והיינו ענין המשכת הכתר."
        },
        {
          "s": 9,
          "text": "והמשכה זו היא באופן דמשביע לכל חי רצון,"
        },
        {
          "s": 10,
          "text": "פירוש,"
        },
        {
          "s": 11,
          "text": "כי יסוד נקרא חי,"
        },
        {
          "s": 12,
          "text": "מפני שעל ידו הם כל ההשפעות,"
        },
        {
          "s": 13,
          "text": "ולכן נמשך הכתר בבחי' היסוד כדי שעל ידו יושפע לכל סדר ההשתלשלות."
        },
        {
          "s": 14,
          "text": "וממשיך לבאר20"
        },
        {
          "s": 15,
          "text": "מ\"ש צדיק הוי' בכל דרכיו,"
        },
        {
          "s": 16,
          "text": "דצדיק הוא ג\"כ יסוד,"
        },
        {
          "s": 17,
          "text": "וההפרש בין כשנקרא חי לכשנקרא צדיק הוא,"
        },
        {
          "s": 18,
          "text": "דכשמשפיע חיות לפנימיות העולמות נקרא חי,"
        },
        {
          "s": 19,
          "text": "וכשמשפיע חיות לחיצוניות העולמות נקרא צדיק,"
        },
        {
          "s": 20,
          "text": "וזהו צדיק הוי' בכל דרכיו,"
        },
        {
          "s": 21,
          "text": "שהמשכה זו נמשכת אח\"כ בבחי' חיצוניות העולמות,"
        },
        {
          "s": 22,
          "text": "עד בכל דרכיו,"
        },
        {
          "s": 23,
          "text": "בכל דרכי סדר ההשתלשלות."
        },
        {
          "s": 24,
          "text": "וממשיך לבאר21"
        },
        {
          "s": 25,
          "text": "מ\"ש קרוב הוי' לכל קוראיו,"
        },
        {
          "s": 26,
          "text": "שזהו משום שאוא\"ס מלובש בעשי' כמו באצילות,"
        },
        {
          "s": 27,
          "text": "ולכן קרוב הוי' לכל קוראיו בשוה."
        }
      ]
    }
  ]
}