{
  "globalIndex": 359,
  "owner": 9,
  "jobId": "_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915808_theRebbe_726__p007",
  "batchId": "meluket-_D7_9B_D7_A1_D7_9C_D7_95_meluket__BH_POST_1766518915808_theRebbe_726__p007",
  "seriesId": "כסלו_meluket",
  "postId": "BH_POST_1766518915808_theRebbe_726",
  "title": "מאמר פדה בשלום תשל\"ח",
  "part": 7,
  "sections": [
    {
      "v": 18,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ב)"
        },
        {
          "s": 2,
          "text": "והנה אמיתית ענין השלום הוא כמרז\"ל98"
        },
        {
          "s": 3,
          "text": "עה\"פ99"
        },
        {
          "s": 4,
          "text": "ונתתי שלום בארץ גו' וחרב לא תעבור בארצכם אפילו חרב של שלום."
        },
        {
          "s": 5,
          "text": "וידוע100"
        },
        {
          "s": 6,
          "text": "שחרב של שלום היא העבודה דתפלה,"
        },
        {
          "s": 7,
          "text": "ושלום"
        },
        {
          "s": 8,
          "text": "(שלא יש אפילו חרב של שלום)"
        },
        {
          "s": 9,
          "text": "היא העבודה דתורה."
        },
        {
          "s": 10,
          "text": "ובזה יובן101"
        },
        {
          "s": 11,
          "text": "הסדר דמרז\"ל הנ\"ל"
        },
        {
          "s": 12,
          "text": "(כל העוסק בתורה ובגמ\"ח ומתפלל עם הצבור),"
        },
        {
          "s": 13,
          "text": "שמקדים תורה לגמ\"ח ותפלה,"
        },
        {
          "s": 14,
          "text": "הגם שבסדר עבודת האדם בכלל לימוד התורה הוא"
        },
        {
          "s": 15,
          "text": "(בעיקר)"
        },
        {
          "s": 16,
          "text": "לאחרי התפלה102"
        },
        {
          "s": 17,
          "text": "[שבאה לאחרי קדימת גמ\"ח,"
        },
        {
          "s": 18,
          "text": "כמרז\"ל103"
        },
        {
          "s": 19,
          "text": "יהיב פרוטה לעני והדר מצלי],"
        },
        {
          "s": 20,
          "text": "כי אמיתית ענין השלום הוא דוקא ע\"י התורה,"
        },
        {
          "s": 21,
          "text": "חיי עולם104,"
        },
        {
          "s": 22,
          "text": "באופן דתורתו אומנתו,"
        },
        {
          "s": 23,
          "text": "שאופן זה בלימוד התורה"
        },
        {
          "s": 24,
          "text": "(בפנימיות הענינים105)"
        },
        {
          "s": 25,
          "text": "שייך לכאו\"א בכל מקום ובכל יום,"
        },
        {
          "s": 26,
          "text": "היינו שבשעה שלומד תורה הלימוד שלו הוא באופן דתורתו אומנותו106,"
        },
        {
          "s": 27,
          "text": "כי בשעה זו אין לו בעולמו אלא התורה בלבד,"
        },
        {
          "s": 28,
          "text": "ואז הלימוד שלו הוא גם באופן דפעולה נצחית,"
        },
        {
          "s": 29,
          "text": "שפועל על כל עניניו במשך כל היום כולו,"
        },
        {
          "s": 30,
          "text": "ועד במשך כל ימי חייו,"
        },
        {
          "s": 31,
          "text": "שנעשים חיים של תורה."
        }
      ]
    },
    {
      "v": 19,
      "items": [
        {
          "s": 0,
          "text": "וזה נעשה הקדמה קרובה להזמן דימות המשיח שלא יהי' עסק כל העולם אלא לדעת את ה' בלבד107,"
        },
        {
          "s": 1,
          "text": "שאמיתית ענין הידיעה בה' היא ע\"ד מאמר כ\"ק אדמו\"ר"
        },
        {
          "s": 2,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 3,
          "text": "נ\"ע108,"
        },
        {
          "s": 4,
          "text": "שכשלומד לקו\"ת \"הערט ער עצמות\","
        },
        {
          "s": 5,
          "text": "ועי\"ז ניתן הכח שיהי' מעין זה לכל ההולכים באורחותיו,"
        },
        {
          "s": 6,
          "text": "וכידוע מה שאמר כ\"ק אדמו\"ר"
        },
        {
          "s": 7,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 8,
          "text": "נ\"ע109"
        },
        {
          "s": 9,
          "text": "בענין ידעתיו הייתיו110,"
        },
        {
          "s": 10,
          "text": "ש\"כאו\"א מאנ\"ש העוסק בלימוד החסידות ובעבודה שבלב .."
        },
        {
          "s": 11,
          "text": "דערהערט יעדערער און דערפילט דעם הייתיו וואָס עס קומט פון דעם ידעתיו שבנשמה\"."
        }
      ]
    },
    {
      "v": 20,
      "items": [
        {
          "s": 0,
          "text": "י)"
        },
        {
          "s": 1,
          "text": "ג)"
        },
        {
          "s": 2,
          "text": "וזהו פדה בשלום נפשי כו' אמר הקב\"ה כל העוסק בתורה ובגמ\"ח ומתפלל עם הצבור כו' כאילו פדאני כו',"
        },
        {
          "s": 3,
          "text": "ואמירתו של הקב\"ה הוי מעשה111,"
        },
        {
          "s": 4,
          "text": "אלא שבתחילה המעשה הוא באופן דכאילו פדאני"
        },
        {
          "s": 5,
          "text": "(בכ\"ף הדמיון),"
        },
        {
          "s": 6,
          "text": "לפי שאין זה נראה עדיין לעיני בשר,"
        },
        {
          "s": 7,
          "text": "אבל אח\"כ נמשך זה גם במעשה דעולם העשי' שאין תחתון למטה ממנו,"
        },
        {
          "s": 8,
          "text": "פדיית הקב\"ה וישראל מבין אומות העולם"
        },
        {
          "s": 9,
          "text": "(פדי' כפשוטה,"
        },
        {
          "s": 10,
          "text": "בלי כ\"ף הדמיון),"
        },
        {
          "s": 11,
          "text": "שאז יהי' העסק בתורה ובגמ\"ח ובתפלה בצבור בתכלית השלימות,"
        },
        {
          "s": 12,
          "text": "כמצות רצונך112,"
        },
        {
          "s": 13,
          "text": "בביאת משיח צדקנו,"
        },
        {
          "s": 14,
          "text": "יבוא ויגאלנו ויוליכנו קוממיות לארצנו,"
        },
        {
          "s": 15,
          "text": "ובקרוב ממש,"
        },
        {
          "s": 16,
          "text": "וגם בלשון תרגום113,"
        },
        {
          "s": 17,
          "text": "בעגלא דידן."
        }
      ]
    }
  ]
}