{
  "globalIndex": 162,
  "owner": 12,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914707_theRebbe_174__p001",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914707_theRebbe_174__p001",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914707_theRebbe_174",
  "title": "מאמר להבין ענין שמח\"ת תשמ\"ב",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "יום שמחת תורה ה'תשמ\"ב"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "להבין ענין שמחת תורה,"
        },
        {
          "s": 1,
          "text": "וידועים הדיוקים בזה"
        },
        {
          "s": 2,
          "text": "(במאמר ד\"ה זה דכ\"ק מו\"ח אדמו\"ר1)"
        },
        {
          "s": 3,
          "text": "מה שאופן השמחה"
        },
        {
          "s": 4,
          "text": "(דשמחת תורה)"
        },
        {
          "s": 5,
          "text": "הוא שלוקחים ספר תורה כמו שהיא כרוכה ומכוסה במפה ומקיפים עמה את שולחן הקריאה,"
        },
        {
          "s": 6,
          "text": "ואחרי שמסבבין את שולחן הקריאה מרקדין עם התורה."
        },
        {
          "s": 7,
          "text": "דעם היות שבתורה כתיב2"
        },
        {
          "s": 8,
          "text": "כי היא חכמתכם ובינתכם גו',"
        },
        {
          "s": 9,
          "text": "מ\"מ,"
        },
        {
          "s": 10,
          "text": "אופן השמחה דשמח\"ת היא לא ע\"י לימוד ועיון,"
        },
        {
          "s": 11,
          "text": "הבנה והשגה שבראש,"
        },
        {
          "s": 12,
          "text": "כ\"א ע\"י ריקוד ברגלים דוקא."
        },
        {
          "s": 13,
          "text": "וענין זה"
        },
        {
          "s": 14,
          "text": "(דשמח\"ת שייכת לרגלים דוקא)"
        },
        {
          "s": 15,
          "text": "הוא לא רק בנוגע להאדם"
        },
        {
          "s": 16,
          "text": "(שהשמחה היא ע\"י ריקוד ברגלים דוקא)"
        },
        {
          "s": 17,
          "text": "אלא גם בנוגע להתורה."
        },
        {
          "s": 18,
          "text": "שהרי השמחה"
        },
        {
          "s": 19,
          "text": "(דשמח\"ת)"
        },
        {
          "s": 20,
          "text": "היא מה שישראל שמחים עם אותיות התורה,"
        },
        {
          "s": 21,
          "text": "כמובן מזה שאופן השמחה היא שמקיפים עם הס\"ת את שולחן הקריאה אשר שם קוראים בכל השנה באותיות התורה,"
        },
        {
          "s": 22,
          "text": "וידוע3"
        },
        {
          "s": 23,
          "text": "בענין ד' הבחינות טנת\"א שבתורה שאותיות התורה הם דרגא הכי תחתונה שבה,"
        },
        {
          "s": 24,
          "text": "בחי' רגלים דתורה."
        },
        {
          "s": 25,
          "text": "וענין זה"
        },
        {
          "s": 26,
          "text": "(שהשמחה היא באותיות התורה)"
        },
        {
          "s": 27,
          "text": "מובן גם מהידוע4"
        },
        {
          "s": 28,
          "text": "דזה שקורין יום זה בשם שמחת תורה הוא לפי שמסיימין בו התורה וראוי לשמוח בסיומה,"
        },
        {
          "s": 29,
          "text": "שהרי זה שמסיימים וגומרים התורה"
        },
        {
          "s": 30,
          "text": "(ביום זה)"
        },
        {
          "s": 31,
          "text": "הוא שאז מסיימים וגומרים הקריאה באותיות התורה."
        },
        {
          "s": 32,
          "text": "דבענין הבנת והשגת התורה אין שייך כלל סיום וגמר,"
        },
        {
          "s": 33,
          "text": "כיון שארוכה מארץ מדה ורחבה מני ים5,"
        },
        {
          "s": 34,
          "text": "וכתיב6"
        },
        {
          "s": 35,
          "text": "ועלמות אין מספר אלו הלכות7."
        },
        {
          "s": 36,
          "text": "דהגם שההלכות שנתגלו כבר הם במספר מסויים,"
        },
        {
          "s": 37,
          "text": "ששים המה מלכות6"
        },
        {
          "s": 38,
          "text": "אלו ששים מסכתות ושמונים פלגשים6"
        },
        {
          "s": 39,
          "text": "אלו שמונים ברייתות8,"
        },
        {
          "s": 40,
          "text": "הרי אין קץ ותכלית כלל לההלכות שמתחדשים9."
        },
        {
          "s": 41,
          "text": "שגם הם ניתנו בסיני,"
        },
        {
          "s": 42,
          "text": "כמאמר10"
        },
        {
          "s": 43,
          "text": "כל מה שתלמיד ותיק עתיד לחדש ניתן למשה מסיני."
        },
        {
          "s": 44,
          "text": "דמזה מובן בפשטות דזה שבשמח\"ת מסיימים וגומרים התורה הוא שמסיימים אז רק את אותיות התורה."
        },
        {
          "s": 45,
          "text": "ויתירה מזו,"
        },
        {
          "s": 46,
          "text": "דבענין קריאת התורה אינו נוגע ההבנה וההשגה,"
        },
        {
          "s": 47,
          "text": "שהרי גם עם הארץ שלא ידע מאי קאמר עולה לתורה ומברך ברכת התורה11."
        },
        {
          "s": 48,
          "text": "שמכל זה מובן,"
        },
        {
          "s": 49,
          "text": "שהשמחה שעושין"
        },
        {
          "s": 50,
          "text": "(בשמח\"ת)"
        },
        {
          "s": 51,
          "text": "לגמרה של תורה היא השמחה באותיות התורה,"
        },
        {
          "s": 52,
          "text": "בחי' רגלים דתורה."
        },
        {
          "s": 53,
          "text": "שלכן גם באדם,"
        },
        {
          "s": 54,
          "text": "השמחה היא בריקוד ברגלים דוקא."
        },
        {
          "s": 55,
          "text": "גם צריך להבין"
        },
        {
          "s": 56,
          "text": "(כמו שמדייק שם במאמר שלפני זה12)"
        },
        {
          "s": 57,
          "text": "מה שקבעו שמח\"ת בשמע\"צ,"
        },
        {
          "s": 58,
          "text": "דלכאורה הי' צריך לעשות שמח\"ת בחג השבועות זמן מתן תורתנו,"
        },
        {
          "s": 59,
          "text": "ולמה עושין שמח\"ת בשמע\"צ."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "והנה דיוק זה"
        },
        {
          "s": 2,
          "text": "(מה שעושין שמח\"ת בשמע\"צ ולא בחגה\"ש)"
        },
        {
          "s": 3,
          "text": "בא במאמר הנ\"ל בהמשך לזה שמדייק שם לפני זה מה שבשמע\"צ כתיב13"
        },
        {
          "s": 4,
          "text": "ביום השמיני עצרת תהי' לכם,"
        },
        {
          "s": 5,
          "text": "והרי כל החגים ומועדים"
        },
        {
          "s": 6,
          "text": "[וכן כל התורה ומצוות]"
        },
        {
          "s": 7,
          "text": "ניתנו לישראל,"
        },
        {
          "s": 8,
          "text": "ולמה בהחג דשמע\"צ דוקא אומר לכם,"
        },
        {
          "s": 9,
          "text": "מהו החידוש דשמע\"צ על כל החגים ומועדים."
        },
        {
          "s": 10,
          "text": "ומביא על זה,"
        },
        {
          "s": 11,
          "text": "דאיתא במדרש14,"
        },
        {
          "s": 12,
          "text": "ראוי' היתה העצרת של חג שתהא רחוקה חמשים יום כנגד העצרת של פסח."
        },
        {
          "s": 13,
          "text": "ויש לומר,"
        },
        {
          "s": 14,
          "text": "דבזה שמביא מדרש זה שראוי' היתה עצרת של חג שתהא רחוקה חמשים יום כמו עצרת של פסח,"
        },
        {
          "s": 15,
          "text": "מתחזק יותר הדיוק"
        },
        {
          "s": 16,
          "text": "(שמביא לאח\"ז)"
        },
        {
          "s": 17,
          "text": "מה שעושין שמח\"ת בשמע\"צ דלכאורה הי' צריך לעשות שמח\"ת בחגה\"ש,"
        },
        {
          "s": 18,
          "text": "כי ממדרש זה מובן שגם שמע\"צ גופא הוא דוגמת חגה\"ש"
        },
        {
          "s": 19,
          "text": "(עצרת של פסח),"
        },
        {
          "s": 20,
          "text": "ועפ\"ז אינו מובן ביותר מה שקבעו שמח\"ת בשמע\"צ דוקא ולא בחגה\"ש."
        },
        {
          "s": 21,
          "text": "ומבאר במדרש15"
        },
        {
          "s": 22,
          "text": "הטעם על זה שעצרת של חג אינה רחוקה חמשים יום,"
        },
        {
          "s": 23,
          "text": "כי ע\"י שהן יוצאין מן הקיץ לחורף לית ביומייהו דייזלון וייתון,"
        },
        {
          "s": 24,
          "text": "משל למה הדבר דומה למלך שהיו לו בנות הרבה,"
        },
        {
          "s": 25,
          "text": "מהן נשואות במקום קרוב ומהן נשואות למקום רחוק,"
        },
        {
          "s": 26,
          "text": "יום אחד באו כולן לשאול שלום המלך אביהם,"
        },
        {
          "s": 27,
          "text": "אמר המלך אלו שנשואות במקום קרוב אית בעונתן למיזל ולמיתי,"
        },
        {
          "s": 28,
          "text": "ואילין שנשואות במקום רחוק לית בעונתן למיזל ולמיתי,"
        },
        {
          "s": 29,
          "text": "עד דאינון כולן אצלי הכא נעבד כולן חד יו\"ט ונחדי עמן,"
        },
        {
          "s": 30,
          "text": "כך עצרת של פסח,"
        },
        {
          "s": 31,
          "text": "עד דאינון נפקין מהחורף לקיץ אמר הקב\"ה אית ביומא למיזל ולמיתי,"
        },
        {
          "s": 32,
          "text": "אבל עצרת של חג ע\"י שהן יוצאין מהקיץ לחורף כו' אמר הקב\"ה לית ביומא למיזל ולמיתי,"
        },
        {
          "s": 33,
          "text": "אלא עד דאינון הכא נעבד כולן חד יו\"ט ונחדי,"
        },
        {
          "s": 34,
          "text": "לפיכך משה מזהיר את ישראל ביום השמיני עצרת תהי' לכם."
        }
      ]
    }
  ]
}