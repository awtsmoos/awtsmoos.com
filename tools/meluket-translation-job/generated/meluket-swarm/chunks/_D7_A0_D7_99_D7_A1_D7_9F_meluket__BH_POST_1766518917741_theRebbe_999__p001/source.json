{
  "globalIndex": 673,
  "owner": 23,
  "jobId": "_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917741_theRebbe_999__p001",
  "batchId": "meluket-_D7_A0_D7_99_D7_A1_D7_9F_meluket__BH_POST_1766518917741_theRebbe_999__p001",
  "seriesId": "ניסן_meluket",
  "postId": "BH_POST_1766518917741_theRebbe_999",
  "title": "מאמר אשה כי תזריע תשכ\"ה",
  "part": 1,
  "sections": [
    {
      "v": 0,
      "items": [
        {
          "s": 0,
          "text": "בס\"ד."
        },
        {
          "s": 1,
          "text": "ש\"פ תזריע,"
        },
        {
          "s": 2,
          "text": "ראש חודש ניסן,"
        },
        {
          "s": 3,
          "text": "ה'תשכ\"ה"
        }
      ]
    },
    {
      "v": 1,
      "items": [
        {
          "s": 0,
          "text": "אשה כי תזריע וילדה זכר1,"
        },
        {
          "s": 1,
          "text": "וארז\"ל2"
        },
        {
          "s": 2,
          "text": "אשה מזרעת תחלה יולדת זכר איש מזריע תחלה יולדת נקבה,"
        },
        {
          "s": 3,
          "text": "ומביא אדמו\"ר הזקן"
        },
        {
          "s": 4,
          "text": "(בלקו\"ת ד\"ה זה3)"
        },
        {
          "s": 5,
          "text": "דהפלסופים פירשו,"
        },
        {
          "s": 6,
          "text": "דהטעם על זה שאשה מזרעת תחלה יולדת זכר הוא כי כשאשה מזרעת תחלה טיפת האיש באה באחרונה ועילאה גבר."
        },
        {
          "s": 7,
          "text": "ואומר אדמו\"ר הזקן שפירושם הוא דוחק גדול."
        },
        {
          "s": 8,
          "text": "ומפרש כדמוכח מפשטות הלשון שלידת הזכר בא מזרע האשה"
        },
        {
          "s": 9,
          "text": "(ולא מזה שזרע האיש בא לבסוף)."
        },
        {
          "s": 10,
          "text": "ויש לומר,"
        },
        {
          "s": 11,
          "text": "דזה שמביא בלקו\"ת גם הפירוש דלידת הזכר הוא מטיפת האיש"
        },
        {
          "s": 12,
          "text": "(הבאה באחרונה,"
        },
        {
          "s": 13,
          "text": "כי עילאה גבר),"
        },
        {
          "s": 14,
          "text": "ויתירה מזו,"
        },
        {
          "s": 15,
          "text": "שמקדים פירוש זה להפירוש שלידת הזכר הוא מזרע האשה,"
        },
        {
          "s": 16,
          "text": "הוא4"
        },
        {
          "s": 17,
          "text": "כי איש ואשה"
        },
        {
          "s": 18,
          "text": "(ברוחניות)"
        },
        {
          "s": 19,
          "text": "הם הקב\"ה וכנסת ישראל,"
        },
        {
          "s": 20,
          "text": "דהקב\"ה נקרא בשם איש וכנסת ישראל בשם אשה5."
        },
        {
          "s": 21,
          "text": "וידוע בענין אתערותא דלעילא ואתערותא דלתתא6,"
        },
        {
          "s": 22,
          "text": "שבכל אחד מהם יש מעלה."
        },
        {
          "s": 23,
          "text": "דהמעלה באתערותא דלתתא היא שההמשכה הבאה על ידה היא מפנימיות האור7,"
        },
        {
          "s": 24,
          "text": "והמעלה באתערותא דלעילא מצד עצמה היא שההמשכה היא ממקום נעלה יותר שאין אתערותא דלתתא מגעת לשם"
        },
        {
          "s": 25,
          "text": "(אלא שההמשכה משם היא מבחינת חיצוניות)."
        },
        {
          "s": 26,
          "text": "ויש לומר,"
        },
        {
          "s": 27,
          "text": "שמזה משתלשלים שני הפירושים באשה כי תזריע וילדה זכר כפשוטו."
        },
        {
          "s": 28,
          "text": "דהפירוש שלידת הזכר הוא מזרע האיש דעילאה גבר,"
        },
        {
          "s": 29,
          "text": "משתלשל מהמעלה שבאתערותא דלעילא8,"
        },
        {
          "s": 30,
          "text": "והפירוש שלידת הזכר הוא מזרע האשה משתלשל מהמעלה שבאתערותא דלתתא."
        },
        {
          "s": 31,
          "text": "ולכן מביא גם הפירוש שלידת הזכר הוא מזרע האיש"
        },
        {
          "s": 32,
          "text": "(אף שבגשמיות,"
        },
        {
          "s": 33,
          "text": "פירוש זה הוא דלא כהמסקנא),"
        },
        {
          "s": 34,
          "text": "בכדי לרמז שיש גם מעלה באתערותא דלעילא."
        }
      ]
    },
    {
      "v": 2,
      "items": [
        {
          "s": 0,
          "text": "ב)"
        },
        {
          "s": 1,
          "text": "ויש להוסיף,"
        },
        {
          "s": 2,
          "text": "דפרשת תזריע קוראין"
        },
        {
          "s": 3,
          "text": "(בכמה שנים)"
        },
        {
          "s": 4,
          "text": "בחודש ניסן9,"
        },
        {
          "s": 5,
          "text": "שענינו הוא אתערותא דלעילא10,"
        },
        {
          "s": 6,
          "text": "ולכן מביא פירוש זה"
        },
        {
          "s": 7,
          "text": "(שלידת הזכר הוא מזרע האיש)"
        },
        {
          "s": 8,
          "text": "לפני הפירוש שלידת הזכר הוא מזרע האשה,"
        },
        {
          "s": 9,
          "text": "כי בחודש ניסן,"
        },
        {
          "s": 10,
          "text": "ההדגשה היא בהמעלה שבאתערותא דלעילא."
        },
        {
          "s": 11,
          "text": "וזה שהמסקנא היא שלידת הזכר הוא מזרע האשה,"
        },
        {
          "s": 12,
          "text": "כי לאחרי מתן תורה,"
        },
        {
          "s": 13,
          "text": "גם בחודש ניסן,"
        },
        {
          "s": 14,
          "text": "ההדגשה היא במעלת עבודת האדם"
        },
        {
          "s": 15,
          "text": "(אתערותא דלתתא)."
        },
        {
          "s": 16,
          "text": "וכמובן גם מהמאמר ד\"ה החודש של אדמו\"ר"
        },
        {
          "s": 17,
          "text": "(מהורש\"ב)"
        },
        {
          "s": 18,
          "text": "נ\"ע11"
        },
        {
          "s": 19,
          "text": "בעל ההילולא דב' ניסן,"
        },
        {
          "s": 20,
          "text": "שמדייק שם"
        },
        {
          "s": 21,
          "text": "(בתחלת המאמר12)"
        },
        {
          "s": 22,
          "text": "\"למה צריכים עבודה בכח עצמו דוקא ומהו המעלה בזה והלא האהוי\"ר הבאים מלמעלה הם גבוהים הרבה יותר\","
        },
        {
          "s": 23,
          "text": "דזה שמדייק"
        },
        {
          "s": 24,
          "text": "(מהי המעלה בעבודה בכח עצמו),"
        },
        {
          "s": 25,
          "text": "אף שבכו\"כ דרושים מבואר"
        },
        {
          "s": 26,
          "text": "(כנ\"ל)"
        },
        {
          "s": 27,
          "text": "המעלה שבאתערותא דלתתא"
        },
        {
          "s": 28,
          "text": "(עבודה בכח עצמו),"
        },
        {
          "s": 29,
          "text": "יש לומר,"
        },
        {
          "s": 30,
          "text": "כי במאמר ד\"ה החודש מודגשת המעלה שבאתערותא דלעילא,"
        },
        {
          "s": 31,
          "text": "ולכן יש מקום לשאלה מהי המעלה בעבודה."
        },
        {
          "s": 32,
          "text": "אבל מזה שענין זה"
        },
        {
          "s": 33,
          "text": "(מהי המעלה בעבודה)"
        },
        {
          "s": 34,
          "text": "הוא רק שאלה,"
        },
        {
          "s": 35,
          "text": "מובן,"
        },
        {
          "s": 36,
          "text": "שגם בחודש ניסן"
        },
        {
          "s": 37,
          "text": "(ד\"ה החודש),"
        },
        {
          "s": 38,
          "text": "שבו מודגשת מעלת ההמשכה הבאה מלמעלה,"
        },
        {
          "s": 39,
          "text": "המסקנא היא שיש"
        },
        {
          "s": 40,
          "text": "(גם)"
        },
        {
          "s": 41,
          "text": "מעלה בעבודה בכח עצמו"
        },
        {
          "s": 42,
          "text": "(אתערותא דלתתא)"
        },
        {
          "s": 43,
          "text": "לגבי האהוי\"ר הבאים מלמעלה"
        },
        {
          "s": 44,
          "text": "(אתערותא דלעילא)."
        },
        {
          "s": 45,
          "text": "ויתירה מזו,"
        },
        {
          "s": 46,
          "text": "דענין זה"
        },
        {
          "s": 47,
          "text": "(המעלה שבאתערותא דלתתא)"
        },
        {
          "s": 48,
          "text": "הוא עיקר המעלה,"
        },
        {
          "s": 49,
          "text": "שלכן,"
        },
        {
          "s": 50,
          "text": "המסקנא"
        },
        {
          "s": 51,
          "text": "(בלקו\"ת)"
        },
        {
          "s": 52,
          "text": "היא שלידת הזכר הוא מזרע האשה,"
        },
        {
          "s": 53,
          "text": "המעלה שבאתערותא דלתתא."
        }
      ]
    }
  ]
}