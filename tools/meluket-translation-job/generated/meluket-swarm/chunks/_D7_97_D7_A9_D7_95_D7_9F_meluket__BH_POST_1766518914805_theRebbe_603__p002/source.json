{
  "globalIndex": 176,
  "owner": 26,
  "jobId": "_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914805_theRebbe_603__p002",
  "batchId": "meluket-_D7_97_D7_A9_D7_95_D7_9F_meluket__BH_POST_1766518914805_theRebbe_603__p002",
  "seriesId": "חשון_meluket",
  "postId": "BH_POST_1766518914805_theRebbe_603",
  "title": "מאמר ויאמר ה' אל אברם תשל\"ח",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "ופירוש הב' בלך לך גו' אל הארץ הוא"
        },
        {
          "s": 2,
          "text": "(כפשטות הכתוב30)"
        },
        {
          "s": 3,
          "text": "שהליכה זו היא מלמטה למעלה,"
        },
        {
          "s": 4,
          "text": "ההליכה מארצך וממולדתך ומבית אביך שהוא"
        },
        {
          "s": 5,
          "text": "(כפשטות הכתוב)"
        },
        {
          "s": 6,
          "text": "ארצו וגו' של תרח"
        },
        {
          "s": 7,
          "text": "[היפך ענין הטהרה31],"
        },
        {
          "s": 8,
          "text": "דרגא הכי תחתונה,"
        },
        {
          "s": 9,
          "text": "ומשם ילך ויעלה מלמטלמ\"ע עד אל הארץ אשר אראך שקאי"
        },
        {
          "s": 10,
          "text": "(כנ\"ל ס\"א)"
        },
        {
          "s": 11,
          "text": "על בחי' המלכות,"
        },
        {
          "s": 12,
          "text": "ועד לבחי' ויבן שם מזבח להוי' הנראה אליו32"
        },
        {
          "s": 13,
          "text": "(שהוא למעלה מבחי' מלכות),"
        },
        {
          "s": 14,
          "text": "ועד אשר ויבן שם מזבח להוי' סתם33,"
        },
        {
          "s": 15,
          "text": "בחי' הוי' דלעילא,"
        },
        {
          "s": 16,
          "text": "הוי' הנעלם,"
        },
        {
          "s": 17,
          "text": "שלמעלה מהוי'"
        },
        {
          "s": 18,
          "text": "(דלתתא)"
        },
        {
          "s": 19,
          "text": "הנראה34."
        },
        {
          "s": 20,
          "text": "ועד\"ז הוא גם בהעבודה ד\"ויעקב הלך לדרכו\" שבכאו\"א שלאחרי חודש תשרי,"
        },
        {
          "s": 21,
          "text": "שהליכה זו היא"
        },
        {
          "s": 22,
          "text": "(לא רק באופן דמלמעלה למטה,"
        },
        {
          "s": 23,
          "text": "שהולך לדרכו מהמועדים דחודש תשרי לדרכו בעניני הרשות ועובדין דחול במשך כל השנה,"
        },
        {
          "s": 24,
          "text": "אלא)"
        },
        {
          "s": 25,
          "text": "גם באופן דמלמטלמ\"ע,"
        },
        {
          "s": 26,
          "text": "מתחיל מכח המעשה שלו,"
        },
        {
          "s": 27,
          "text": "ובכח המעשה גופא כמו שהוא בהעקב שבו,"
        },
        {
          "s": 28,
          "text": "דרגא היותר תחתונה שבגוף האדם"
        },
        {
          "s": 29,
          "text": "[ועד שהוא ענין דהיפך החיים35,"
        },
        {
          "s": 30,
          "text": "בדוגמת המובא לעיל בנוגע לתרח שהוא היפך הטהרה],"
        },
        {
          "s": 31,
          "text": "ומשם מתחיל הליכתו מלמטלמ\"ע,"
        },
        {
          "s": 32,
          "text": "שפועל גם בהעקב שלו ער זאָל דערהערן אלקות"
        },
        {
          "s": 33,
          "text": "[וכמ\"ש באברהם עקב אשר שמע אברהם בקולי36"
        },
        {
          "s": 34,
          "text": "שגם העקב שלו האָט דערהערט37."
        },
        {
          "s": 35,
          "text": "וע\"י שהי' זה אצל אברהם אבינו,"
        },
        {
          "s": 36,
          "text": "ניתן הכח על זה לכאו\"א מישראל"
        },
        {
          "s": 37,
          "text": "(בדוגמת האהבה מסותרת שבכאו\"א מישראל שהיא בירושה לנו מאבותינו38,"
        },
        {
          "s": 38,
          "text": "ובפרט מאברהם אבינו39)],"
        },
        {
          "s": 39,
          "text": "ומזה נמשך"
        },
        {
          "s": 40,
          "text": "(באופן דהילוך מלמטלמ\"ע)"
        },
        {
          "s": 41,
          "text": "השמיעה"
        },
        {
          "s": 42,
          "text": "(דער דערהער)"
        },
        {
          "s": 43,
          "text": "באלקות בכל הכחות,"
        },
        {
          "s": 44,
          "text": "עד לכח השכל שבראש,"
        },
        {
          "s": 45,
          "text": "שתהי' בהם השמיעה למעלה ממדידה והגבלה דשכל."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "וגם ענין זה ד\"ויעקב הלך לדרכו\""
        },
        {
          "s": 1,
          "text": "(הליכה מלמטלמ\"ע)"
        },
        {
          "s": 2,
          "text": "מתחיל לאחרי חודש תשרי."
        },
        {
          "s": 3,
          "text": "דהנה העבודה דשמע\"צ ושמח\"ת"
        },
        {
          "s": 4,
          "text": "(סיום המועדים דחודש תשרי)"
        },
        {
          "s": 5,
          "text": "היא ב"
        },
        {
          "s": 6,
          "text": "(שמחה ו)"
        },
        {
          "s": 7,
          "text": "ריקודים,"
        },
        {
          "s": 8,
          "text": "שענין הריקודים הוא"
        },
        {
          "s": 9,
          "text": "(בעיקר ומתחיל)"
        },
        {
          "s": 10,
          "text": "בהרגלים,"
        },
        {
          "s": 11,
          "text": "ובהם גופא בהעקב שבהם."
        },
        {
          "s": 12,
          "text": "וע\"י שהעקבים מתנשאים"
        },
        {
          "s": 13,
          "text": "(הויבן זיך)"
        },
        {
          "s": 14,
          "text": "ומרקדים,"
        },
        {
          "s": 15,
          "text": "הם מנשאים גם את הראש"
        },
        {
          "s": 16,
          "text": "(וכח השכל שבו)40,"
        },
        {
          "s": 17,
          "text": "שגם הוא מרקד בשמחה גדולה למעלה ממדידה והגבלה."
        },
        {
          "s": 18,
          "text": "ומזה נמשך כח על העבודה דויעקב הלך לדרכו"
        },
        {
          "s": 19,
          "text": "(הליכה מלמטלמ\"ע)"
        },
        {
          "s": 20,
          "text": "במשך כל השנה,"
        },
        {
          "s": 21,
          "text": "מתחיל מכח המעשה כמו שהוא בהעקב"
        },
        {
          "s": 22,
          "text": "[כולל הענינים שאדם דש בעקביו41,"
        },
        {
          "s": 23,
          "text": "היינו ענינים אשר"
        },
        {
          "s": 24,
          "text": "(מצד איזה סיבה שתהי')"
        },
        {
          "s": 25,
          "text": "אין לו חיות בהם"
        },
        {
          "s": 26,
          "text": "(בדוגמת העקב כפשוטו שהו\"ע דהיפך החיים)],"
        },
        {
          "s": 27,
          "text": "ומזה ממשיך"
        },
        {
          "s": 28,
          "text": "(באופן דהילוך מלמטלמ\"ע)"
        },
        {
          "s": 29,
          "text": "גם לכח השכל שבראש,"
        },
        {
          "s": 30,
          "text": "כנ\"ל."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "ושני פירושים הנ\"ל בלך לך מארצך גו' הם בהתאם לשני הפירושים ב\"בעבר הנהר ישבו אבותיכם\"42."
        },
        {
          "s": 2,
          "text": "הפירוש"
        },
        {
          "s": 3,
          "text": "[שבפנימיות התורה43]"
        },
        {
          "s": 4,
          "text": "שעבר הנהר הוא הבחי' שלמעלה"
        },
        {
          "s": 5,
          "text": "(גם)"
        },
        {
          "s": 6,
          "text": "מבחי' ונהר יוצא מעדן44"
        },
        {
          "s": 7,
          "text": "(בינה דאצילות)"
        },
        {
          "s": 8,
          "text": "ופירוש בעבר הנהר ישבו אבותיכם גו' הוא ששרש האבות הוא מעבר הנהר שלמעלה מאצילות ומשם נמשכו למטה"
        },
        {
          "s": 9,
          "text": "(בעבר השני של הנהר,"
        },
        {
          "s": 10,
          "text": "היינו)"
        },
        {
          "s": 11,
          "text": "בז\"א דאצילות,"
        },
        {
          "s": 12,
          "text": "ועד ש\"ואולך אותו בכל ארץ כנען\"45"
        },
        {
          "s": 13,
          "text": "הירידה וההמשכה בבחינת המלכות"
        },
        {
          "s": 14,
          "text": "(כנ\"ל סעיף א' שארץ ישראל קאי על מלכות)"
        },
        {
          "s": 15,
          "text": "– ההליכה מארצך גו',"
        },
        {
          "s": 16,
          "text": "שקאי על עבר הנהר,"
        },
        {
          "s": 17,
          "text": "אל הארץ אשר אראך,"
        },
        {
          "s": 18,
          "text": "הוא הליכה מלמעלה למטה46."
        },
        {
          "s": 19,
          "text": "והפירוש"
        },
        {
          "s": 20,
          "text": "(כמו שהוא בפשטות)"
        },
        {
          "s": 21,
          "text": "שעבר הנהר הוא מקומו של תרח,"
        },
        {
          "s": 22,
          "text": "ומ\"ש בעבר הנהר ישבו אבותיכם גו' הוא לגריעותא"
        },
        {
          "s": 23,
          "text": "[כדמוכח ממרז\"ל47"
        },
        {
          "s": 24,
          "text": "מתחיל בגנות כו' מתחילה עובדי ע\"ז היו אבותינו כו' שנאמר בעבר הנהר ישבו אבותיכם גו']"
        },
        {
          "s": 25,
          "text": "– ההליכה מארצך גו'"
        },
        {
          "s": 26,
          "text": "(עבר הנהר)"
        },
        {
          "s": 27,
          "text": "אל הארץ אשר אראך,"
        },
        {
          "s": 28,
          "text": "הילוך ועלי' מלמטלמ\"ע48"
        },
        {
          "s": 29,
          "text": "(כנ\"ל סעיף ג')."
        }
      ]
    }
  ]
}