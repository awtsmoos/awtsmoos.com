{
  "globalIndex": 74,
  "owner": 24,
  "jobId": "_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914115_theRebbe_704__p002",
  "batchId": "meluket-_D7_AA_D7_A9_D7_A8_D7_99_meluket__BH_POST_1766518914115_theRebbe_704__p002",
  "seriesId": "תשרי_meluket",
  "postId": "BH_POST_1766518914115_theRebbe_704",
  "title": "מאמר שובה ישראל תשמ\"א",
  "part": 2,
  "sections": [
    {
      "v": 3,
      "items": [
        {
          "s": 0,
          "text": "ג)"
        },
        {
          "s": 1,
          "text": "והנה החילוק שבין התשובה דסור מרע להתשובה דועשה טוב ודבקש שלום הוא,"
        },
        {
          "s": 2,
          "text": "שהתשובה דסור מרע היא שלא יהיו עוונות שמבדילים ביניכם לבין אלקיכם24,"
        },
        {
          "s": 3,
          "text": "והתשובה דועשה טוב ודבקש שלום היא שתהי' העבודה להמשיך אור נעלה יותר."
        },
        {
          "s": 4,
          "text": "דההמשכה שנמשכת מלמעלה מצד עצמה,"
        },
        {
          "s": 5,
          "text": "מצד זה שהוא ית' הוא עצם הטוב וטבע הטוב להטיב25,"
        },
        {
          "s": 6,
          "text": "היא במדידה והגבלה,"
        },
        {
          "s": 7,
          "text": "וע\"י העבודה ההמשכה היא בלי גבול26."
        },
        {
          "s": 8,
          "text": "וכמו שידוע27"
        },
        {
          "s": 9,
          "text": "בענין אלה תולדות פרץ28"
        },
        {
          "s": 10,
          "text": "תולדות מלא29,"
        },
        {
          "s": 11,
          "text": "שהוא למעלה גם מאלה תולדות השמים והארץ בהבראם30"
        },
        {
          "s": 12,
          "text": "תולדות מלא29,"
        },
        {
          "s": 13,
          "text": "עולם על מילואו נברא31,"
        },
        {
          "s": 14,
          "text": "דתולדות מלא שנאמר גבי בריאת שמים וארץ"
        },
        {
          "s": 15,
          "text": "(בריאה מצד מלמעלה)"
        },
        {
          "s": 16,
          "text": "רצה הבורא שיהי' במדידה והגבלה,"
        },
        {
          "s": 17,
          "text": "משא\"כ תולדות פרץ מלא שיהי'"
        },
        {
          "s": 18,
          "text": "(בביאת המשיח32)"
        },
        {
          "s": 19,
          "text": "ע\"י מעשינו ועבודתינו33"
        },
        {
          "s": 20,
          "text": "הוא מה שמשיח"
        },
        {
          "s": 21,
          "text": "(מבני פרץ,"
        },
        {
          "s": 22,
          "text": "ונקרא הפורץ34)"
        },
        {
          "s": 23,
          "text": "יפרוץ כל הגדרים."
        },
        {
          "s": 24,
          "text": "ובזה גופא"
        },
        {
          "s": 25,
          "text": "(ההמשכה שע\"י עבודה),"
        },
        {
          "s": 26,
          "text": "ההמשכה שע\"י עסק התורה"
        },
        {
          "s": 27,
          "text": "(בקש שלום)"
        },
        {
          "s": 28,
          "text": "היא נעלית יותר מההמשכה שע\"י קיום המצוות"
        },
        {
          "s": 29,
          "text": "(ועשה טוב)."
        },
        {
          "s": 30,
          "text": "דנוסף לזה שע\"י המצוות ההמשכה היא בבחי' מקיף וע\"י התורה ההמשכה היא בפנימיות35,"
        },
        {
          "s": 31,
          "text": "גם ההמשכה עצמה היא נעלית יותר."
        },
        {
          "s": 32,
          "text": "דע\"י קיום המצוות נמשך אור הסובב36,"
        },
        {
          "s": 33,
          "text": "וע\"י עסק התורה נמשך עצמות אוא\"ס שלמעלה גם מסובב37."
        }
      ]
    },
    {
      "v": 4,
      "items": [
        {
          "s": 0,
          "text": "ד)"
        },
        {
          "s": 1,
          "text": "וע\"פ הנ\"ל דשובה ישראל כי כשלת בעוניך היא התשובה דסור מרע,"
        },
        {
          "s": 2,
          "text": "מובן,"
        },
        {
          "s": 3,
          "text": "דזה שגם מי שהוא בדרגת ישראל שייך אצלו הענין דכשלת בעוניך,"
        },
        {
          "s": 4,
          "text": "הכוונה בזה היא לא"
        },
        {
          "s": 5,
          "text": "(רק)"
        },
        {
          "s": 6,
          "text": "שיש בו איזה חסרון"
        },
        {
          "s": 7,
          "text": "[שזהו גם בצדיקים],"
        },
        {
          "s": 8,
          "text": "אלא ששייך אצלו גם עוונות המבדילים38"
        },
        {
          "s": 9,
          "text": "(אלא שהם בדקות דדקות),"
        },
        {
          "s": 10,
          "text": "ולכן צ\"ל אצלו התשובה דסור מרע."
        },
        {
          "s": 11,
          "text": "וענין זה"
        },
        {
          "s": 12,
          "text": "[שגם בצדיקים"
        },
        {
          "s": 13,
          "text": "(ישראל)"
        },
        {
          "s": 14,
          "text": "יש גם התשובה דסור מרע]"
        },
        {
          "s": 15,
          "text": "מובן גם מזה שתשובה היא מצוה"
        },
        {
          "s": 16,
          "text": "[וכלשון אדה\"ז באגרת התשובה39"
        },
        {
          "s": 17,
          "text": "\"מצות התשובה\"],"
        },
        {
          "s": 18,
          "text": "דמזה מובן,"
        },
        {
          "s": 19,
          "text": "שמצות התשובה היא"
        },
        {
          "s": 20,
          "text": "(ככל המצוות)"
        },
        {
          "s": 21,
          "text": "לכאו\"א מישראל,"
        },
        {
          "s": 22,
          "text": "גם לצדיקים גמורים."
        },
        {
          "s": 23,
          "text": "ומכיון שמצות התשובה היא"
        },
        {
          "s": 24,
          "text": "(כמ\"ש אדה\"ז באגה\"ת שם)"
        },
        {
          "s": 25,
          "text": "עזיבת החטא"
        },
        {
          "s": 26,
          "text": "(סור מרע),"
        },
        {
          "s": 27,
          "text": "מובן,"
        },
        {
          "s": 28,
          "text": "דנוסף על זה שגם בצדיקים גמורים צ\"ל התשובה דוהרוח תשוב אל האלקים אשר נתנה"
        },
        {
          "s": 29,
          "text": "[וכמבואר בלקו\"ת"
        },
        {
          "s": 30,
          "text": "(פרשתנו)"
        },
        {
          "s": 31,
          "text": "דשרש הנשמה הוא בחי' האלקים"
        },
        {
          "s": 32,
          "text": "(אשר נתנה),"
        },
        {
          "s": 33,
          "text": "שהוא בחי' צור40"
        },
        {
          "s": 34,
          "text": "שלמעלה מהוי'41,"
        },
        {
          "s": 35,
          "text": "העלם שאינו במציאות42,"
        },
        {
          "s": 36,
          "text": "והמשכת הנשמה מבחינה זו היא באופן ד"
        },
        {
          "s": 37,
          "text": "(אשר)"
        },
        {
          "s": 38,
          "text": "נתנה,"
        },
        {
          "s": 39,
          "text": "דכל43"
        },
        {
          "s": 40,
          "text": "הנותן בעין יפה הוא נותן44,"
        },
        {
          "s": 41,
          "text": "וענין התשובה דוהרוח תשוב אל האלקים אשר נתנה הוא השבת והעלאת הנשמה לשרשה ומקורה,"
        },
        {
          "s": 42,
          "text": "דגם כמו שהנשמה מלובשת בגוף"
        },
        {
          "s": 43,
          "text": "(שהרי מצות התשובה היא,"
        },
        {
          "s": 44,
          "text": "ככל המצוות,"
        },
        {
          "s": 45,
          "text": "לנשמות בגופים דוקא)"
        },
        {
          "s": 46,
          "text": "תהי' בבחי' ביטול לגמרי כמו שהיתה בשרשה,"
        },
        {
          "s": 47,
          "text": "בבחי' האלקים אשר נתנה45],"
        },
        {
          "s": 48,
          "text": "צריך להיות אצלם גם תשובה כפשוטה."
        },
        {
          "s": 49,
          "text": "וצריך להבין,"
        },
        {
          "s": 50,
          "text": "והרי באצילות"
        },
        {
          "s": 51,
          "text": "(אפילו באצילות הפרטית)"
        },
        {
          "s": 52,
          "text": "כתיב לא יגורך רע46,"
        },
        {
          "s": 53,
          "text": "ומכיון שהתשובה דצדיקים היא"
        },
        {
          "s": 54,
          "text": "(כנ\"ל מלקו\"ת)"
        },
        {
          "s": 55,
          "text": "אל האלקים אשר נתנה,"
        },
        {
          "s": 56,
          "text": "למעלה מבחי' בראתה יצרתה נפחתה בי"
        },
        {
          "s": 57,
          "text": "(בי\"ע)"
        },
        {
          "s": 58,
          "text": "ולמעלה גם מבחי' שנתת בי"
        },
        {
          "s": 59,
          "text": "(אצילות)47,"
        },
        {
          "s": 60,
          "text": "איך יתכן אצלם ענין התשובה דסור מרע."
        }
      ]
    },
    {
      "v": 5,
      "items": [
        {
          "s": 0,
          "text": "ה)"
        },
        {
          "s": 1,
          "text": "ולכאורה הי' אפשר לבאר זה ע\"פ מ\"ש בלקו\"ת48,"
        },
        {
          "s": 2,
          "text": "דמי שמצד מעלת נשמתו שייך להעבודה דבחי' רוח"
        },
        {
          "s": 3,
          "text": "(ועשה טוב)"
        },
        {
          "s": 4,
          "text": "ומכ\"ש מי ששייך להעבודה דבחי' נשמה"
        },
        {
          "s": 5,
          "text": "(בקש שלום),"
        },
        {
          "s": 6,
          "text": "כשחסר אצלו בעבודה זו הוא פגם."
        },
        {
          "s": 7,
          "text": "ויתירה מזו,"
        },
        {
          "s": 8,
          "text": "דלהיותו במדריגה נעלית,"
        },
        {
          "s": 9,
          "text": "הפגם שלו"
        },
        {
          "s": 10,
          "text": "(עם היותו בדקות)"
        },
        {
          "s": 11,
          "text": "הוא גדול יותר מהעון ממש דאיש פשוט."
        },
        {
          "s": 12,
          "text": "וכמו שאמר הרב המגיד שהמ\"ז של צדיקים גמורים פוגמים יותר מעוונות חמורים של ע\"ה."
        },
        {
          "s": 13,
          "text": "וע\"ד רבב על בגד ת\"ח49."
        },
        {
          "s": 14,
          "text": "ועפ\"ז הי' אפ\"ל לכאורה,"
        },
        {
          "s": 15,
          "text": "דמצות התשובה"
        },
        {
          "s": 16,
          "text": "(שהיא עזיבת החטא)"
        },
        {
          "s": 17,
          "text": "בצדיקים גמורים היא התשובה על זה שהי' אצלם חסרון בהעבודה דועשה טוב או עכ\"פ בהעבודה דבקש שלום,"
        },
        {
          "s": 18,
          "text": "שגם תשובה זו היא עזיבת החטא,"
        },
        {
          "s": 19,
          "text": "מכיון שהפגם שעל ידי זה הוא עוד יותר מהעון"
        },
        {
          "s": 20,
          "text": "(כפשוטו)"
        },
        {
          "s": 21,
          "text": "דאיש פשוט."
        },
        {
          "s": 22,
          "text": "אמנם,"
        },
        {
          "s": 23,
          "text": "מזה גופא שאומרים שישנם ג' ענינים"
        },
        {
          "s": 24,
          "text": "(סור מרע,"
        },
        {
          "s": 25,
          "text": "עשה טוב ובקש שלום),"
        },
        {
          "s": 26,
          "text": "מוכח,"
        },
        {
          "s": 27,
          "text": "שהעבודה דוע\"ט ודבקש שלום היא הוספה ועלי' בקדושה גופא,"
        },
        {
          "s": 28,
          "text": "וגם כשחסר בעבודה זו,"
        },
        {
          "s": 29,
          "text": "אין זה ענין של רע"
        },
        {
          "s": 30,
          "text": "(גם לא בדקות)."
        },
        {
          "s": 31,
          "text": "ועפ\"ז צריך להבין מהו\"ע מצות התשובה"
        },
        {
          "s": 32,
          "text": "(עזיבת החטא)"
        },
        {
          "s": 33,
          "text": "בצדיקים,"
        },
        {
          "s": 34,
          "text": "שעל זה אומר שובה ישראל גו' כי כשלת בעוניך,"
        },
        {
          "s": 35,
          "text": "דגם מי שהוא בדרגת ישראל צ\"ל אצלו גם התשובה דסור מרע."
        }
      ]
    }
  ]
}