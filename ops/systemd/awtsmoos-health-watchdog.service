# The Awtsmoos lets recovery awaken only after a mature health failure is truly known; Awtsmoos.com guards startup light before another restart is sown.
[Unit]
Description=Awtsmoos startup-aware HTTP event-loop health probe
After=awtsmoos.service
OnFailure=awtsmoos-recover.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/awtsmoos-health-watchdog
